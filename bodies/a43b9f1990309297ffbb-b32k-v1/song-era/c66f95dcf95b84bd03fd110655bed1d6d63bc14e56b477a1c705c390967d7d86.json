h":"宋_2.csv","pointer":57581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三十","author":"晏殊","text":"狻猊对立香烟度，鸑鷟交飞组绣明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二十","author":"晏殊","text":"茧馆蚕初起，瑶箱燕未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五十一","author":"晏殊","text":"竹醉人还醉，蚕眠我亦眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二十六","author":"晏殊","text":"祭毕崇坛冷玉球，月斜星澹思悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四十三","author":"晏殊","text":"绿树新蝉第一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临蜕遗诗 其一","author":"晏颖","text":"兄也错到底，犹誇将相才。\n世缘何日了，了却早归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临蜕遗诗 其二","author":"晏颖","text":"江外三千里，人间十八年。\n此行谁复见，一鹤上辽天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"跋山谷书范滂传帖","author":"柴中守","text":"小春昼日如春晚，饮罢披图清兴远。\n夜光照屋四座惊，金薤银钩真墨本。\n当年太史谪宜州，肠断梅花栖戍楼。\n拾遗不逢东道主，翰林长作夜郎囚。\n蛮烟瘴雨森鈇钺，更值韩卢搜兔窟。\n老色上面欢去心，惟有忠肝悬日月。\n郡丞嗜好殊世人，投笺乞字传儿孙。\n平生孟博是知己，笔下写出精神骞。\n兴亡万古同一辙，党论到头不堪说。\n刊章下郡汉道微，清流入河唐祚绝。\n先朝白昼狐亦鸣，正气消尽邪气生。\n殿门断碑仆未起，中原戎马来纵横。\n生蛟入手不敢玩，往事凄凉重三叹。\n兰亭瘗鹤徒尔为，好刻此书裨庙算。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敬题濂溪先生书堂 其二","author":"柴中行","text":"出城三四里，矫首惬遐观。\n顿觉市声绝，忻从天宇宽。\n康山书几净，湓浦砚泓寒。\n一诵爱莲说，尘埃百不干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"敬题濂溪先生书堂 其一","author":"柴中行","text":"有生同宇宙，所欠好江山。\n因自舂陵至，留居庐阜间。\n斯文传坠绪，太极妙循环。\n希圣诚何事，怀哉伊与颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送许郎中出知漳州","author":"柴中行","text":"君子重出处，儿女多依违。\n孰知退有义，一辞若发机。\n刑部今其人，识远渺造微。\n时方事疾走，而我心独非。\n老色未上面，健笔駃于飞。\n宛然傲霜菊，灿灿黄金辉。\n勉留鹓鹭行，夫岂少轻肥。\n一麾即得请，众目骇见稀。\n了不露纤芥，舒卷流清■。\n凉风称归棹，灏气浥征衣。\n婆娑慰丘园，咳唾落珠玑。\n因风来锦囊，犹足慰依依。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上中斋相公","author":"柴元彪","text":"年年长是客天涯，几向天涯梦到家。\n归到故家无一字，兔葵莺粟正开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观梅","author":"柴元彪","text":"冷蕊疏花带晓寒，骚翁白首淡相看。\n风饕雪虐天地闭，皦皦孤芳良独难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灌花","author":"柴元彪","text":"小圃辛勤植众芳，年年雨露借恩光。\n近来天意高难问，抱瓮从朝到夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁丑偶成","author":"柴元彪","text":"燕山形势地，从古是京师。\n宇宙人俱换，山川影不移。\n马谙朝北路，梅报向南枝。\n腊尽春来候，荣枯各有时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"及第留吴门访史君黄松冈","author":"柴元彪","text":"西江草木转精神，山谷松冈一样清。\n东海拾遗来汲黯，道州谏议得阳城。\n棠开春雨花千里，角动姑苏月五更。\n笑指齐云天已近，金銮又听玉珂声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别江湖友人","author":"柴元彪","text":"相见还相别，相逢未有期。\n田园归去日，风雨正来时。\n算驿客程远，牵帆峡路危。\n寄书难到处，明月两天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别茶陵士友","author":"柴元彪","text":"自来承檄到云州，恰恰星霜又一周。\n握手心知千里月，满怀诗思一江秋。\n每惭铸错伤完锦，多谢衔杯送别舟。\n未说河阳花满县，夜来风雨打田畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和同年徐清溪韵","author":"柴元彪","text":"深隐柯云第几峰，一庭春草绿丛丛。\n西风白发催人老，少日青袍与子同。\n买犊只因耕荦确，拂龟何必问穷通。\n蔗浆一洗相如渴，赖有新诗送远鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和克家侄谢周凤隐雪中留宿韵","author":"柴元彪","text":"遥指龟峰拟问津，芒鞋踏碎玉嶙峋。\n去程暮雪留行客，回首春风有故人。\n三酌茅柴斟白堕，一炉榾柮当乌薪。\n饶他势利相倾绝，管鲍交情正在贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和姜元哲中秋有感韵","author":"柴元彪","text":"乌飞兔走两悠悠，世事惊心易白头。\n月影空馀圆缺恨，人心不尽古今愁。\n江流东去波涛险，王气南收草树秋。\n回首夕阳亭上望，青山一发渺神州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和僧啸云双插法藏寺韵","author":"柴元彪","text":"我来扣角二峰前，此寺因知五百年。\n草木尚涵唐雨露，钟鱼犹镇宋山川。\n世情苍狗浮云外，客思孤鸿落日边。\n閒拂旧题追往事，我须僧发两皤然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和僧彰无文送兰花韵","author":"柴元彪","text":"脱簪归隐白云深，不逐时芳事枉寻。\n閒向草亭图太极，重盟莲社续东林。\n春风分到灵均种，臭味如同惠远心。\n一卷离骚清彻骨，跫然空谷足徽音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饯吉甫弟之维扬别驾","author":"柴元彪","text":"风樯留燕暮呢喃，行李催程春又三。\n幕府来迎晁别驾，油幢曾识李淮南。\n江都今古英雄会，宇宙中间化育参。\n见说监州簪芍药，早乘华步趣朝骖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"勉制干侄克家归乡","author":"柴元彪","text":"五年不得共团栾，放浪东吴一苇间。\n客路风波如蹈海，人心剑戟甚于山。\n逢春回雁南应北，到海归潮去复还。\n今是昨非浑一梦，庭柯园菊可怡颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"姜林居别业","author":"柴元彪","text":"结庐尘外境，流水绕平田。\n三径故人菊，一池君子莲。\n塔悬当户月，钟翳隔溪烟。\n自得平生趣，渔竿老渭川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日江郎道中","author":"柴元彪","text":"豆花疏雨浥轻埃，野店新凉入酒杯。\n草带淡烟栖古道，树含断霭翳荒台。\n湖光隐见萍分合，山色有无云去来。\n满眼秋光无尽意，三峰万古碧崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刚中兄之官山阴","author":"柴元彪","text":"为爱鹅池可禊兰，朅来松下驻吟鞍。\n一家昆弟皆台宪，两世翁孙此县官。\n风渡潮声来海口，雁将秋色下长安。\n白云凝伫山阴近，笑策潘舆奉母欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱塘怀古","author":"柴元彪","text":"百年朝市旧，登览若为情。\n落日铜驼陌，东风夹马营。\n路随荆刺断，城与黍离平。\n可惜西湖月，烧灯两度晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄括苍李察院","author":"柴元彪","text":"武夷山下棹归舠，九曲萦纡涨碧桃。\n两字功名如草芥，十年身世付蓬蒿。\n广陵古调知音少，柯洞残棋不著高。\n今日孤忠在何许，挑灯自读楚人骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游江郎山","author":"柴元彪","text":"世事无情几变迁，郎峰万古只依然。\n移来渤海三山石，界断银河一字天。\n云捲前川龙挂雨，风生阴洞虎跑泉。\n群仙缥缈来笙鹤，石顶天香堕玉莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游璩源寺和韵","author":"柴元彪","text":"游人剔藓认坚珉，谁是开山第一人。\n知有法諲留虎锡，元来璩叟是龙神。\n云屏翠列悬崖树，雪瀑声飞断壑津。\n又见生公重说法，祖师岩下草长春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登衡山宿上封寺祝融峰","author":"柴元彪","text":"历井扪参上祝融，半空烟霭数声钟。\n地连云汉九千丈，天柱东南七十重。\n石磴悬崖翻瀑布，海门碾日上高峰。\n翛然身世青冥表，俯立雷池看玉龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]