[{"title":"登庾楼 其二","author":"董嗣杲","text":"千年传说庾公游，远戍秋尘障两眸。\n往事未知谁可语，今朝聊复此登楼。\n淮山鸟去冲烟灭，楚泽帆归带日收。\n閒客望穷江北晚，月明无赖几沙洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登庾楼 其一","author":"董嗣杲","text":"重支瘦竹上危楼，凉袭纶巾羽扇秋。\n天地江山风浪起，汀洲芦荻水烟浮。\n谁听调夜琵琶苦，拟泛吟秋舴艋游。\n唤得元规魂梦醒，何妨小作踞床留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"紫荆花","author":"董嗣杲","text":"繁蕊粘条簇茜尘，挨墙傍壁烁荒榛。\n风传兄弟知何乐，雨喷精神老此春。\n眼底叶空枝有艳，根头花盛树无身。\n野芳若省荣枯易，肯厌游蜂来蜜频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"紫微花","author":"董嗣杲","text":"枝干无皮痒有身，朱房翠户演精神。\n星垣光射开花地，纶阁香侵视草臣。\n肘肘紫蕤飞烈日，心心黄粟舞晴尘。\n何从借取麻姑爪，莫厌爬搔此树频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萱草花","author":"董嗣杲","text":"娇含丹粉映池台，忧岂能忘俗谩猜。\n曹植颂传天上去，嵇康种满舍前来。\n鹿葱谁验宜男谶，凤首犹寻别种栽。\n浩有苦怀偏忆母，从今不把北堂开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"葛公双井","author":"董嗣杲","text":"仙翁洗药傍西湖，脉与灵山碧溜俱。\n泉迸一枝源更异，甃分双眼味何殊。\n石函霞涌沉铅汞，井屋风清转辘轳。\n日日汲花朝复暮，当方曾说病人无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"葛岭","author":"董嗣杲","text":"白云几叠翠岚重，往往疏钟出梵宫。\n石骨谁人镌佛像，岭头何处觅仙翁。\n楼台水月丹青地，帘幕莺花锦绣丛。\n游子莫支苍竹去，风雷容易起虚空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢村","author":"董嗣杲","text":"暮役朝行此可停，临平山色入船青。\n烟窑惨淡多逃户，泥井虚圆有废亭。\n贫衲施茶营屋小，老渔曝网绕篱腥。\n客怀久困飘萧里，风撼枯桐不可听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"越上","author":"董嗣杲","text":"海色连云气，登临晚不同。\n越山齐北斗，秦树起西风。\n灯火官桥暗，笙歌店桥空。\n小楼无梦里，谁此种梧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"越城客中","author":"董嗣杲","text":"暑滋衣袖苦逢迎，濡滞连旬梦亦惊。\n奔走泥涂谁送死，浮沉光景自怜生。\n鸦穿晚照栖公馆，龙挟晴云入子城。\n乱试法歌攒碧落，无端新月客窗明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"愁中延客","author":"董嗣杲","text":"染衣尘土厚，览镜雪霜明。\n朱墨增新病，身名失旧清。\n公厅春草盛，野市腊醅轻。\n留客驱寥寞，江光射北楹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慈云岭","author":"董嗣杲","text":"叠叠流云步步苔，九霄紫气限蓬莱。\n后唐刻石初开路，南宋郊天别筑台。\n慰眼江湖空岁月，伤心陵寝堕尘埃。\n桃花争趁春风老，又引游人一度来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新桥遇秋岩","author":"董嗣杲","text":"出郭看山眼便醒，故人相值说云萍。\n了翁屋后晚烟碧，茂叔阡头秋草青。\n绝壑雨过溪水响，高峰月上谷云停。\n乌巾漉酒菊花店，醉拣陶诗书纸屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"楝花","author":"董嗣杲","text":"吹将二十四番愁，锦样群芳逐急流。\n风信到花春自往，霜华著子晚谁收。\n树攒密萼屯阴重，瓣落高枝缀藓稠。\n霞外曾传香醉咏，莺莺未啭舌应柔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"槐花","author":"董嗣杲","text":"此树开花簌簌黄，秋蝉鸣破雨馀凉。\n发回七帙仙人黑，心落三年举子忙。\n肯信植庭能根叶，谁知列树自成行。\n云屯暗掩宫阴老，蜜糁龙池凤沼香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满替在眼即景赋二首 其二","author":"董嗣杲","text":"菊向篱阴老，松连石影交。\n山梨寒脱树，溪鸟晚投巢。\n欲把肩舆卸，先将手版抛。\n是时柴户月，任客带吟敲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满替在眼即景赋二首 其一","author":"董嗣杲","text":"野分霜信薄，溪落雨痕乾。\n僻邑催冬早，遥林积暝寒。\n鸡栖隐坏壁，鹤老恋空关。\n烛下哀筝发，楼头送漏残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞香花","author":"董嗣杲","text":"春沁幽花透骨清，矮窼殊迈百芳馨。\n紫英四出醉娇粉，绿萼千攒簇巧丁。\n自覆熏笼须闭户，谁栽锦伞都当庭。\n昼眠不用熏沈水，梦落庐山九叠屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙叟悟禅人俗舍在湖口县予留江城闻其归省且有书贶因寄二首 其二","author":"董嗣杲","text":"富池归去欲相从，几想苍云碧树东。\n夜月庾楼怀抱在，春风陶径梦魂通。\n前峰路断锄犁少，古渡征苛网罟空。\n难语数年牢落恨，千林如海夕阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙叟悟禅人俗舍在湖口县予留江城闻其归省且有书贶因寄二首 其一","author":"董嗣杲","text":"要识閒栖彼此轻，平江浪远暮帆晴。\n青春晚处羁怀恶，白发生时老眼明。\n花落无心寻笑傲，客乡有日苦逢迎。\n云包尚寄双钟下，若过吾庐祗半程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"跳珠轩","author":"董嗣杲","text":"溪流稳信竹龙驱，声激清虚入耳孤。\n此窍可消诸念妄，一丸长跃半空珠。\n挂瓢舀水应知味，就壁龛碑不用玞。\n谁谓佛灵占有验，殆于儿戏果何殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"锦带花","author":"董嗣杲","text":"忍见柔枝缀彩英，愁围未解又清明。\n茸茸叠萼萦春梦，袅袅长条系别情。\n有样谩传居士制，无香徒滓海仙名。\n文臣服色开时验，次第妖娆织不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鲍家田","author":"董嗣杲","text":"衕转东山忆故钱，钱家曾赐鲍家田。\n地名有自谁能考，相业无闻姓却传。\n种藕户繁招宿鹭，寻花人倦信啼鹃。\n玉泉流荫分西去，并入官塘漾野船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"漫兴二首 其二","author":"董嗣杲","text":"浮名浮利有传讹，薏苡囊疑马伏波。\n镜里鬓毛谙世故，笔头诗句答樵歌。\n风穿树秃寒林浅，月展江空夜浪多。\n脱病欲归归便得，花家鱼港自烟蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"漫兴二首 其一","author":"董嗣杲","text":"倚竹攲巾望远天，脱鞋自在取高眠。\n无情岁月催双鬓，有样文章委少年。\n吟卷乱抛幽枕畔，客床寒对短灯前。\n沈迷谩想华胥乐，还有痴儿鄙孝先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"碧桃花","author":"董嗣杲","text":"何时和露种琼英，素质轻盈骨骼清。\n古观自栽千树艳，重门谁锁一春情。\n绡裳月曳瑶台晚，绿蒂烟凝粉瓣晴。\n几片雪香流出远，涌金池傍涌金城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"碧蝉儿花","author":"董嗣杲","text":"翠蛾遗种吐纤蕤，不逐西风曳别枝。\n翅翅展青无体势，心心埋白有须眉。\n偎篱冷吐根苗处，傍路凉资雨露时。\n分外一般天水色，此方独许染家知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罂粟花","author":"董嗣杲","text":"红白花开委暮尘，野粮能疗野居贫。\n长腰可抵丰年米，苍玉难资食肉人。\n石钵柳槌研乳细，春苗秋实荐香新。\n马前见此羁怀恶，强饭应钟万里身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翠芳园","author":"董嗣杲","text":"翠挹南山树石苍，五花亭外万花芳。\n云芝栱斗晴檐湿，金字屏风水榭凉。\n柳接苏堤无空地，萍侵兰枻有深坊。\n未几移筑仙宫邃，一本红查委路傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"聚八仙花","author":"董嗣杲","text":"密团粉腻翠枝擎，乱碾铢衣降紫冥。\n揉雪谩为春晚殿，御风应负饮中灵。\n蒂占琼瓣轻如蝶，心袅金丛灿若星。\n谁指凌波姑射醉，有人眠月可曾醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"聚景园","author":"董嗣杲","text":"銮铃遗响辇遗踪，万景曾经聚此中。\n寺宇有名基址散，君王无逸宴游空。\n桥昏柳浪龙舟雨，亭冷花光雉扇风。\n台沼已无春又老，万年枝上夕阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蓼花","author":"董嗣杲","text":"瘦叶浮根傍柳矶，水天秋色夕阳时。\n晶晶红染累垂糁，袅袅凉摇软弱枝。\n挼汁自能为酒母，托名谁制作风宜。\n花开只熨溜翁眼，可奈渔翁醉不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蔷薇花","author":"董嗣杲","text":"接夏连春秀可誇，东山云月满谁家。\n浪埋纤刺翻晴锦，绡缀柔条熨暮霞。\n海外有瓶还贮水，亭前无洞可藏花。\n多年不拆黄封酒，莫向樽前说梦华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜡梅花","author":"董嗣杲","text":"刚条簇簇陈蝇封，劲叶将零傲此冬。\n磬口种奇英可嚼，檀心香烈蒂初镕。\n根依阳地春风透，瓶倚晴窗日气浓。\n一样黄昏疏影处，悬知水月不相容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酴醾花","author":"董嗣杲","text":"韵友相送春已遒，剪琼肌骨更娇柔。\n画屏缭绕无风展，酒瓮丰腴有味留。\n云洞悬枝疑雪蛹，雨墙引蔓走烟虬。\n年年压倒看承架，又费山翁斫竹修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韬光庵","author":"董嗣杲","text":"悟得师禅隐此林，谩传难下碧天吟。\n巢沟坞上人无迹，云月堂前梅有阴。\n家弃蜀乡年岁远，身潜洛寺屋庐深。\n死生印得香山去，可遂西来一片心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"德生堂","author":"董嗣杲","text":"瑶台瑞满玉皇家，泽溥山巅与水涯。\n鱼跃鸢飞函德意，天长地久演年华。\n金摇巨扁双龙护，翠掩高碑一字差。\n须信石顽能万古，老龟无语问莺花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"槿花","author":"董嗣杲","text":"髣髴戎葵劲且柔，托名日及叹生浮。\n苦怜相态无多艳，空缀郊原度一秋。\n红澡暮零篱□上，翠深凉过屋山头。\n风英掩映枯茅把，勾引行人觅酒流。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"稻花","author":"董嗣杲","text":"四海张颐望岁丰，此花不与万花同。\n香分天地生成里，气应阴阳子午中。\n顷顷紫芒摇七月，穰穰玉糁杵西风。\n雨晹时若关开落，歌壤谁摅畎亩忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蕙花","author":"董嗣杲","text":"翠叶层敷楚茝苗，谁将绮石养清标。\n幽姿晴待光风转，熏草寒禁艳雪消。\n一干数蕤香不足，重栽百亩魄难招。\n零陵虽是名堪托，无事因花忆晋朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蕲城晚泊值雪","author":"董嗣杲","text":"雁声哀怨极淮天，际晚惊呼雪打船。\n古驿鱼稀谁撒网，虚沙马过自随鞭。\n人烟顽犷空多智，形胜丘墟又几年。\n龙眼矶头风浪恶，今宵归兴此方坚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉后登黄池港舟","author":"董嗣杲","text":"大江胜绝此无俦，不省荒寒醉酒楼。\n秉烛尚嫌杯数窄，换舟便觉橹声柔。\n山连青意为仙冢，池接黄名是逆流。\n僵卧莫知身纪堕，岸南灯火属宣州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题大赛山中人家","author":"董嗣杲","text":"课孙课子业桑麻，最喜无人识故家。\n八口日支资地力，一头雪色感年华。\n甜瓜苦过王戎李，古木枯如博望槎。\n岂得不谙培植性，又思寻客学餐霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题方用卿书屋壁","author":"董嗣杲","text":"野云埋墅晚，城树掩江春。\n门巷人烟古，云山屋宅新。\n悲歌陶此世，尘土污吾身。\n无地堪挑荠，殊乖晚膳真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题江州天庆观","author":"董嗣杲","text":"隘寺鼓钟透，殊庭瑞庆垂。\n上清唐塑像，正一汉遗师。\n经箓青城派，楼台紫极基。\n尧天跻寿域，羽佩有威仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题冷翠谷道者庵","author":"董嗣杲","text":"万计千谋浊世纷，莲花峰下寂无闻。\n丹泉漱冷齿凝雪，翠谷虚凌身入云。\n藤杖卓苔防险峻，石炉炷柏起氤氲。\n独游独宿露寒夜，绝顶想多秋几分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题园堂壁","author":"董嗣杲","text":"廨扉临水掩，世路入山穷。\n暑谢晚尤炽，秋高凉未通。\n莲香霞沼废，竹色月楼空。\n天地机难测，山林志少同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题意香壁","author":"董嗣杲","text":"朱户编帘掩，花颠览镜羞。\n酒多无客过，茶尽有僧留。\n世虑经心久，花时撚指休。\n悦生怜浊骨，愧死混清流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题意香壁","author":"董嗣杲","text":"养生肯羡葛洪砂，醒困还评陆羽茶。\n溪上揽云归酒屋，雨中看瀑忆樵家。\n时时禽鸟呜心曲，岁岁风霜趱鬓华。\n窗户生香还有意，夕阳红皱石榴花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题蔡主簿小园","author":"董嗣杲","text":"聒耳禽声细，澄颜池影浮。\n襟怀犹徼塞，松竹自林丘。\n剪韭疏畦阔，分兰贴石幽。\n吟笺满芸架，闲乐野僧留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题濂溪书院","author":"董嗣杲","text":"远径溪流水自圆，光风霁月渺无边。\n窗前生意休除草，堂上清风独爱莲。\n万古共知归有极，一尘不染见先天。\n未知涵味其中者，谁是元翁得正传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"橘花","author":"董嗣杲","text":"对花怀母望云心，不见围棋隐者寻。\n晚径风清香更醉，小亭月满艳能侵。\n千林翠幄千英雪，一点琼苞一颗金。\n莫问封侯惟问酒，泛杯摘蕊寄情深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠天池寺觉翁圆上人","author":"董嗣杲","text":"单起浯溪寺，禅栖主簿峰。\n收诗入顽石，礼塔趁昏钟。\n好古心何癖，观空语更慵。\n觉翁才觉处，明月出孤松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠归客","author":"董嗣杲","text":"囊橐依然负，烟波豁尔游。\n穷秋多雨水，归棹几汀洲。\n舣月无言坐，听梧不解愁。\n退耕应在念，肯向客途留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠圭上人","author":"董嗣杲","text":"几年参四教，孤影托三衣。\n自识閒机了，谁甘苦行归。\n秋藤溪水活，雨叶寺墙肥。\n觉得真如处，空房不掩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠封禺山翁","author":"董嗣杲","text":"鹁鸪鸣雨鹤吟风，可羡山中白发翁。\n百事不闻天地闭，四窗常见水烟空。\n春时聚社寻屠伯，晴昼科书授学童。\n此外惟知安分去，鹿门真隐略相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辨才塔","author":"董嗣杲","text":"澜翻八十一年空，争讶前身是井龙。\n心静已成无上智，学知今复有谁宗。\n云生遗塔封慈相，雨溅冲泉杂定钟。\n几字碑阴坡老笔，声声想得旧游从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"霍山祠","author":"董嗣杲","text":"霍家山下敞行宫，溜水桥西透鼓钟。\n古迹建平遗烈在，春风广惠历朝封。\n露台献社呈苍马，阴壁飞旌绘赤龙。\n蚁聚乞灵人散后，云街雨陌撼涛松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翻经台","author":"董嗣杲","text":"过门跬步入香林，七叶遗阴地尚灵。\n曾借东山康乐手，共翻北本涅槃经。\n阑腰叶拥空台赤，石罅泉通远笕青。\n云掩莲花峰下座，若人演义若人听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"藤花","author":"董嗣杲","text":"蒙茸紫结秀蕤明，远讶霞铺彩凤轻。\n碎影照溪羞晚悴，烂香蔓壑藉春荣。\n蔓如谀佞依权势，色比空华易死生。\n花落水流儴沈约，至今故宅号馀英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钧天曲","author":"董嗣杲","text":"圆丘崇且高，广汉清且浅。\n元祀播鼓钟，严禘列瑚琏。\n天酒泻琪花，遵此奉常典。\n恩流昭感通，报称示丰腆。\n鹤鸣集霞台，凤曳翔云辇。\n已际天人和，八表清尘卷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九江驿纪梦歌","author":"董嗣杲","text":"西风吹净汀洲明，萧萧雨荻霜芦声。\n江山幻出琉璃屏，谁歌谪傅琵琶行。\n三更月满十二城，梦超弱水登蓬瀛。\n九派水，九叠山，水水山山锦四环。\n绿罴玄猿守朱关，雪鹤舞影石台乾。\n瑶树琪花不可攀，花上结子千岁悭。\n花子错落鱼鳞斑，践幽济胜清肺肝。\n回首空睨双云鬟，萝香点渍衣袂寒。\n不觉罡风吹倒还，琼跳璧溅鸣珊珊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入寓双泉寺","author":"董嗣杲","text":"大江沙岸虚，几寸水痕落。\n萧萧双泉寺，佛像剥丹雘。\n纸轮转晴鼓，灰塔断风铎。\n残僧极荒怠，深得酒中乐。\n西风客子来，栖暂得矮阁。\n开窗望村疃，四下尘漠漠。\n人烟极零星，鸡犬更萧索。\n自罹开庆扰，景况恍如昨。\n周章见世态，彫瘵叹民瘼。\n梵呗忽传声，饱饭且藜藿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又过妙智寺后因赋","author":"董嗣杲","text":"我貌甚癯棘，极爱山林住。\n才说庐山去，不惮葺芒屦。\n郁怀得少解，动脚即健步。\n谁言多岌嶪，堂堂大驿路。\n万景山渺莽，旷游惬心慕。\n荒坊偶小憩，周览入薄暮。\n西隅壁灰净，半堵若缣素。\n方此欲题名，已触野僧怒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]