[{"title":"宫词 其八十二","author":"赵佶","text":"上春精择建溪芽，携向芸窗力斗茶。\n点处未容分品格，捧瓯相近比琼花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6861,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其八十三","author":"赵佶","text":"烟敛林梢挂晚虹，登临吟望兴无穷。\n秦娥越艳新妆饰，小约同来宝苑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6862,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其八十四","author":"赵佶","text":"忘忧清乐在枰棋，仙子精功岁未笄。\n窗下每将图局按，恐防宣召较高低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6863,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其八十五","author":"赵佶","text":"紫云楼曲倚仙韶，传习皆知岁月遥。\n竞好洮州新进谱，和谐逸韵入音调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6864,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其八十六","author":"赵佶","text":"杏绿桃绯一片春，后庭花卉尽坤珍。\n鞦韆峻架临芳径，须信韶光每岁新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6865,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其八十七","author":"赵佶","text":"邃宇宏开巧石丛，擅名还有胜嬴峰。\n巫山未足为珍异，碧玉巑岏叠数重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6866,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其八十八","author":"赵佶","text":"燕馆馀闲玉漏沉，华容芳质尽知音。\n不将箫瑟为贪靡，竞鼓瑶徽数弄琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6867,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其八十九","author":"赵佶","text":"澄澄方沼玉庭前，天产双英并萼莲。\n含秀同芳应有感，故来清禁启妖妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6868,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其九十","author":"赵佶","text":"纹窗几砚日亲临，雅玩娱情务讨寻。\n笔格砚屏皆宝制，镇书惟重马蹄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6869,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其九十一","author":"赵佶","text":"天源一派过严城，宝兽喷香漱玉声。\n分入瑶津来紫禁，杯流曲沼远相萦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6870,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其九十二","author":"赵佶","text":"千步回廊远接连，叠山盈壁状天然。\n重新绘画非尘境，不是高真即列仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6871,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其九十三","author":"赵佶","text":"二浙枇杷得地荣，移来丹宇倍生成。\n天心赋与偏繁盛，珍物由来出太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6872,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其九十四","author":"赵佶","text":"粉杏夭桃出苑墙，堤边杨柳拂波光。\n梭门耸插彤云里，风引花毬丝缕长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6873,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其九十五","author":"赵佶","text":"殿省爰新六尚名，攸司遵职赞隆平。\n屡颁衎宴丰碑立，官属同刊琬琰荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6874,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其九十六","author":"赵佶","text":"綵缔鳌山耸禁街，端门帘捲五云开。\n元宵佳景同民乐，不禁人行近露台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6875,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其九十七","author":"赵佶","text":"三年禋祀敞圜坛，星斗凝辉玉露寒。\n郊外燔柴烟欲断，禁街人已待回銮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6876,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其九十八","author":"赵佶","text":"酒阑人寂暗银缸，淡月轻风透碧窗。\n宫女欲歌初制曲，旋将弦管按新腔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6877,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其九十九","author":"赵佶","text":"禁宫春色最妖妍，桃李扶疏满眼前。\n斗草踏青携伴侣，更寻何处画图仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6878,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其一○○","author":"赵佶","text":"拂面风轻日渐长，玉人初试薄罗裳。\n斜阳楼外抛梭去，两两三三出洞房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6879,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其一","author":"赵佶","text":"殿庭内外锦衣重，彩仗雕舆相映红。\n敌使未尝经便殿，始瞻仪卫慑羌戎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6880,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其二","author":"赵佶","text":"方响新成白玉牌，叩声仍与八音谐。\n高低二八还相映，丝竹陶匏莫可偕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6881,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其三","author":"赵佶","text":"纤眉丹脸小腰肢，宜着时新峭窄衣。\n头上宫花妆翡翠，宝蝉珍蝶势如飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6882,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其四","author":"赵佶","text":"洛阳新进牡丹栽，小字牌分品格来。\n魏紫姚黄知几许，中春相继奏花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6883,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五","author":"赵佶","text":"杭越奇花异果来，未分流品未堪栽。\n苑中别圃根荄润，移入珍亭一夜开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6884,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其六","author":"赵佶","text":"灵犀点点透成花，异域珍奇自可嘉。\n因制芙蓉杯几样，通纹澄彻滟流霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6885,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其七","author":"赵佶","text":"花枝连属胜丹青，叠嶂层峰立翠屏。\n汲引飞泉来玉甃，璇题因缮迸泉亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6886,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其八","author":"赵佶","text":"近密临堤下钓钩，曲池人静不惊鸥。\n锦鳞才得山呼进，银椀重重赐与优。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6887,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其九","author":"赵佶","text":"宝烟遥洞悉乔松，团墨新翻制作功。\n预遣丹青摹巧样，百花云影更盘龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6888,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其十","author":"赵佶","text":"宫人思学寿阳妆，每看庭梅次第芳。\n浅拂胭脂轻傅粉，弯弯纤细黛眉长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6889,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其十一","author":"赵佶","text":"主第循常贺庆来，朱轮隐隐碾晴雷。\n内东门外登车处，帘合方令步障开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6890,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其十二","author":"赵佶","text":"瑞日融和丽玉庭，花枝密处有莺声。\n六宫闲燕多馀乐，索写新诗颂太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6891,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其十三","author":"赵佶","text":"瑞物来呈日不虚，拱禾芝草一何殊。\n有时宣委丹青手，各使团模作画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6892,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其十四","author":"赵佶","text":"万国升平庆有年，九重荣盛百珍全。\n民间财货虽丰富，未识新颁大观钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6893,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其十五","author":"赵佶","text":"洞箫声歇酒初阑，星斗凝辉宇宙宽。\n唯有真仙为侣伴，夜深同倚玉阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6894,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其十六","author":"赵佶","text":"仙韶总角籍严宫，初学吹笙性格聪。\n十指近才能按字，纤纤双捧紫筠丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6895,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其十七","author":"赵佶","text":"春暮纷纷荡柳绵，欲回炎律困人天。\n宫妆永昼多闲宴，惯折珍珠结翠钿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6896,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其十八","author":"赵佶","text":"宫娥相约戏鞦韆，困极盈盈宝髻偏。\n却恐逢人多谑笑，暗寻香径整花钿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6897,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其十九","author":"赵佶","text":"碧墀十二曲阑干，琼态浓醺倚欲弹。\n月上海棠清荫合，罗裳深夜怯轻寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6898,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其二十","author":"赵佶","text":"诘曲回廊入小庭，绿窗朱户照光明。\n宫人昼直多娱乐，阖座諠哗击马声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6899,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其二十一","author":"赵佶","text":"金字红牌逼夜传，指踪韬略静戎边。\n往回曾不逾旬浃，巳见西隅献凯旋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6900,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其二十二","author":"赵佶","text":"殿庭亲策擢群才，杂遝英贤入彀来。\n俊敏各求先御览，禹门春浪鼓风雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6901,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其二十三","author":"赵佶","text":"石榴繁翠渐盈枝，正是新和首夏时。\n宫女日长无一事，双英较胜卜心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6902,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其二十四","author":"赵佶","text":"湘簟凉生暑气微，午天攲枕向纱帏。\n辘轳车扇间关处，双月回廊彩凤飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6903,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其二十五","author":"赵佶","text":"行觞时许按清歌，声巧佳人曲韵和。\n簌簌梁尘飘不住，层空仍遏彩云过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6904,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其二十六","author":"赵佶","text":"洞房春晚惜花残，满地红英织锦端。\n想见惜芳情意切，更收香蕊掌中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6905,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其二十七","author":"赵佶","text":"缓步宫花夜漏清，廓然天宇月华明。\n凝眸望极无纤翳，惟有银河一练横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6906,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其二十八","author":"赵佶","text":"相府元勋次第雄，构成高阁倚层空。\n落成颁燕延台辅，维有珠玑落座中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6907,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其二十九","author":"赵佶","text":"春池蘋藻绿盘跚，群鸭相呼戏碧湍。\n两两轻舠闲倚岸，斜阳清景鉴中观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6908,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其三十","author":"赵佶","text":"太清楼畔柳依依，阑外飘飖绿线齐。\n鱼钥未开铃铎静，一林鶗鴂占春啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6909,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其三十一","author":"赵佶","text":"小院风柔蛱蝶狂，透帘浑是牡丹香。\n主人不向闲庭看，孔雀双眠宝砌旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6910,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其三十二","author":"赵佶","text":"烟静云娇露已晞，昼长人困杏花时。\n鞦韆闲倚楼台看，尽日无风彩索垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6911,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其三十三","author":"赵佶","text":"院宇花深锁洞房，更阑银烛尚荧煌。\n芸窗尽日观前史，入夜乘闲讲谏章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6912,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其三十四","author":"赵佶","text":"平明初起九重关，望处楼台紫翠间。\n蕊绶华绅簪玉笋，裘衣传引太师班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6913,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其三十五","author":"赵佶","text":"金玉来符百宝新，羽仪严肃遍中宸。\n大庭躬授唯祗畏，惠泽遄敷万国均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6914,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其三十六","author":"赵佶","text":"掖庭荣庆诞弥初，包子均分尽乐胥。\n小结金钱银缕胜，红罗端疋代衣裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6915,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其三十七","author":"赵佶","text":"南宫时务策群贤，题目函封进御前。\n敕选左貂齐答问，魁名优与进宫联。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6916,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其三十八","author":"赵佶","text":"押班供奉列官行，沿袭诸司尽女郎。\n殿直恩名才得赐，销金方许制衣裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6917,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其三十九","author":"赵佶","text":"燕馆沉沉夜雨晴，一翻景物更联荣。\n碧纱窗外无人到，两两三三百舌鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6918,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其四十","author":"赵佶","text":"四辅爰修拱近畿，得贤分理奠邦维。\n见为美恶当勤训，每岁皆令近玉墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6919,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其四十一","author":"赵佶","text":"式燕簪裳遍集英，梯航万里庆天宁。\n升平楼上遥瞻望，众里金貂认使星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6920,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其四十二","author":"赵佶","text":"垂杨堤畔彩舟横，凤沼瑶津一望平。\n内苑有时旬按乐，管弦清响到宣明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6921,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其四十三","author":"赵佶","text":"涵曦亭上恣凭栏，共看游鱼跃水间。\n泼剌红鳞才引到，金圈钤口放生还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6922,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其四十四","author":"赵佶","text":"檀槽钩凤绣鞶垂，玉拨乘闲试一挥。\n纵按往来敲捍面，四条弦上彩鸾飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6923,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其四十五","author":"赵佶","text":"御柳规模六鹤图，凤池均锡尽称誉。\n销金标轴精工制，同会文章看御书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6924,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其四十六","author":"赵佶","text":"史女荣当执笔权，事沿毫楮待承宣。\n一回写著推恩字，特地欣愉择素笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6925,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其四十七","author":"赵佶","text":"宝苑珍池霁晓开，满街车毂转春雷。\n锦幖画舫留盈月，惟待皇家宴赏来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6926,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其四十八","author":"赵佶","text":"叠罗枝袅亚朝霞，并产深宫信可嘉。\n携向佑神珍馆里，辅臣方得看霜花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6927,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其四十九","author":"赵佶","text":"明辉严敞寿春前，仪凤翔鸾曲水穿。\n欲就金阶连翠沼，更开花洞远相连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6928,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五十","author":"赵佶","text":"近密登庸大帅才，谋谟一举万全回。\n临洮积石皆恢复，旁午羌酋纳土来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6929,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五十一","author":"赵佶","text":"清晓传邮凤报声，紫宸称贺集簪缨。\n乾崇来上新祥瑞，几夜黄河彻底清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6930,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五十二","author":"赵佶","text":"巧簇罗牌翰苑词，宜春相向贴门楣。\n近来清禁尤珍重，珠蹙金书御制诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6931,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五十三","author":"赵佶","text":"大晟揄扬逸乐音，躬行律度革汪淫。\n长门羽鹤来翔舞，正雅方知上欲歆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6932,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五十四","author":"赵佶","text":"灵宫复道问东西，殿宇凝霜绣栱齐。\n时祀每怀霜露感，祖宗功德勉攀跻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6933,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五十五","author":"赵佶","text":"设科取士不遗贤，诏语先从内治先。\n朱邸遂兴宗子学，振振麟趾副详延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6934,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五十六","author":"赵佶","text":"鸡鸣警戒务相成，奉道忘私燕享宁。\n规矩忽施惟自化，铅妆不饰为看经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6935,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五十七","author":"赵佶","text":"苑西廊畔碧沟长，修竹森森绿影凉。\n戏掷水毬争远近，流星一点耀波光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6936,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五十八","author":"赵佶","text":"午夜登楼户不扃，长廊夹幕内人行。\n蟠龙尾道华灯合，五色云中笑语声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6937,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其五十九","author":"赵佶","text":"左右掷梭伴侣均，玉纤迎接步莲匀。\n飘飘头上宫花颤，蜂蝶惊飞不著人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6938,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其六十","author":"赵佶","text":"清晓轻云锁玉楼，楼前宫柳弄春柔。\n升平宫宇浮佳气，占得风光待宴游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6939,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其六十一","author":"赵佶","text":"韶光三月恰芬芳，禊饮池头泛羽觞。\n画鹢翩翩戏龙虎，一时佳景类江乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6940,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]