[{"title":"和刘汉阳浩然亭","author":"郭祥正","text":"磴道通绝顶，登临怀弊庐。\n山云数峰断，江树一行疏。\n旧史名空在，新亭画不如。\n自迷姑孰钓，深愧汉阳书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中怀倪敦复因以密云团寄之二首 其一","author":"郭祥正","text":"曲巷无人至，幽居觉日长。\n数声猜旧燕，一缕惜残香。\n著雨花枝困，攲风柳带忙。\n梦魂招不得，惟是到君傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中怀倪敦复因以密云团寄之二首 其二","author":"郭祥正","text":"三载久相依，看看叹别离。\n可堪江雨隔，空对野梅悲。\n息迹无人问，因禅与物违。\n密云新样茗，封送习家池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和朱行中龙图游澄惠寺","author":"郭祥正","text":"一水碧漪漪，更逢烟雨微。\n草昏千步障，松挂六铢衣。\n冷翠光争滴，残红湿不飞。\n自怜诗句拙，空伴史君归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏寒","author":"郭祥正","text":"三伏当炎热，翻如九月天。\n晨兴重衣裌，夜宿尽防川。\n船撼江声怒，楼侵雨气缠。\n白头悲世态，何以度残年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元舆待制招饮衣锦亭","author":"郭祥正","text":"宿雨消残暑，嘶蝉引素秋。\n吟悲宋玉赋，醉倚仲宣楼。\n衣锦平时乐，藏舟战国愁。\n蜀山斜照尽，归兴尚迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元舆待制藏舟浦宴集","author":"郭祥正","text":"圣世销兵久，楼船不复藏。\n清澜浮桂楫，红袖荐瑶觞。\n荇菜风牵碧，荷花雨迸香。\n孔融真爱士，宁厌祢生狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"合肥逢清琏上人","author":"郭祥正","text":"闽国衣冠后，羌庐法性师。\n江河倾辨说，冰雪净容仪。\n塔影龙蛇护，松声猿鹤悲。\n门人忽相过，话旧涕空垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"癸酉除夜呈邻舍刘秀才","author":"郭祥正","text":"六十明朝是，今年此夜除。\n劳生一樽酒，陈事数行书。\n腊逐灯缸尽，春回律管初。\n不愁家信断，安稳藉邻居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜泛麻湖","author":"郭祥正","text":"片片冰消后，盈盈月落初。\n舟轻风势急，水阔雁鸣疏。\n生事长飘泊，愁怀自卷舒。\n还凭过江梦，一为省吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"保宁寺静轩","author":"郭祥正","text":"隐几得真乐，此轩深复深。\n众喧从过耳，一法不关心。\n雨止溪添涨，风行竹乱阴。\n谁云非对动，吾欲写瑶琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风","author":"郭祥正","text":"飒飒来何处，空岩虎一声。\n荡摇神女态，飘忽楚王情。\n有力畴能禦，无根长自生。\n扫除天际雾，为放日车明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬夜泊金山","author":"郭祥正","text":"寒野云阴重，新冬客意忙。\n道途无处尽，岁月有时长。\n流落随江海，崩腾避雪霜。\n还投白莲社，清净万缘忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄致政徐丞二首 其一","author":"郭祥正","text":"为问徐夫子，归欤乐几何。\n宦情今日尽，野兴与云多。\n供佛延亲寿，开樽许客过。\n终期卜邻去，松下接长哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄致政徐丞二首 其二","author":"郭祥正","text":"为问徐夫子，身閒心若閒。\n一樽陶令酒，十顷谢家山。\n云外冥鸿去，松颠独鹤还。\n令人起高兴，从此卜追攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送叔父入川","author":"郭祥正","text":"霰雪满江海，破帆风易吹。\n从今孤鸟兴，不及共巢时。\n谗谤宁须辨，神明岂易欺。\n峡山云木老，莫动故园悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人赴巫山尉","author":"郭祥正","text":"薄宦杳何所，令人重别离。\n暮天归鸟尽，湿橹渡江迟。\n神女十分色，襄王万古悲。\n到官无盗贼，览古数题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送许秀才二首 其一","author":"郭祥正","text":"许子来何谓，还家兴未忘。\n青山聊自爱，白路不知长。\n皓雪飘诗句，寒星动剑铓。\n嗟予倦尘俗，无术接翱翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送许秀才二首 其二","author":"郭祥正","text":"西风吹落叶，片片旅人心。\n半夜有归兴，明朝雪满簪。\n浊醪聊惜别，精艺少知音。\n草店青山外，解鞍孤月沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送衡武陵赴阙","author":"郭祥正","text":"夫君老文学，国士尽知音。\n往奏相如赋，休怜阮籍吟。\n一樽江上酒，千里日边心。\n人问武陵事，桃花春水深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采石观","author":"郭祥正","text":"江水流环合，山形到此孤。\n突然楼阁耸，疑有鬼神扶。\n门外桥踪在，沙边王气无。\n我来何所得，石上采菖蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"康王观","author":"郭祥正","text":"路绝苍崖险，桥横大壑飞。\n花残啼鸟去，云重老龙归。\n剑佩尘埃化，冠缨绘塑非。\n客来空怅望，魂断夕阳西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三妓顾予幽独戏作四韵","author":"郭祥正","text":"忤俗遭罗网，何缘即挂冠。\n闭门谁复过，独酌岂成欢。\n客久添衰疾，春馀尚苦寒。\n幽花虽入眼，不似故园看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠临江守范希远龙图","author":"郭祥正","text":"倾盖相逢晚，开樽上小楼。\n感时心尚壮，欲语涕难收。\n神主方思治，英才悉应求。\n邦畿分使节，玉陛迩宸旒。\n温密亲闻诏，精忠屡献谋。\n养兵能足食，行县必宽囚。\n舜日期无尽，尧云遽莫留。\n鼎湖龙化影，银海雁沈秋。\n事毕身先贬，名高众所尤。\n一麾甘去国，千里谩承流。\n兄弟皆朱绂，双亲未白头。\n遭谗虽坎坷，安命亦优游。\n雪意饶冬暖，滩声奈客愁。\n须君作霖雨，终附济川舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮南韩魏公新祠","author":"郭祥正","text":"新祠重见旧风标，仪凤无声立紫霄。\n富贵荣华垂四纪，功名事迹冠三朝。\n月移帘影灯长在，春散庭阴木未乔。\n何独斯民怀惠爱，帝词天篆刻琨瑶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韶州唐张文献公祠堂","author":"郭祥正","text":"文献颀颀学问该，可怜为相遇嫌猜。\n当年致主陈金镜，后世空祠见铁胎。\n武水直疑龙卧久，韶山时想鹤归来。\n我朝继有襄公出，谁道南方乏美材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢发运颖叔宠寄新什","author":"郭祥正","text":"春风冉冉送流年，一望云霄一惨然。\n帝阁辍才闻出使，渔蓑终老不成仙。\n已甘荆棘填灵府，想见蛟龙走蜀笺。\n正是水深波浪阔，忽逢高雁寄华篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈秀才惠示长歌答以四韵","author":"郭祥正","text":"世路飘零久愈羞，诗坛谁许结英游。\n身留海上三年梦，心寄江南一叶秋。\n已分羽毛藏枳棘，尽从谗谤起戈矛。\n真才合比骊珠贵，何事倾怀辄暗投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君仪感时书事","author":"郭祥正","text":"海角逢春仔细看，一番莺燕展轻翰。\n约风柳带金争软，着雨梨花玉斗寒。\n陇笛不知何处咽，秦筝着意为谁弹。\n留郎更赋多情曲，直欲豪华将杜坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阮希圣新轩即席兼呈同会君仪温老三首 其一","author":"郭祥正","text":"阮轩要客暮春时，淡荡晴丝日正迟。\n出屋花光红玛瑙，隔湖山色碧琉璃。\n老榕垂干侵疏箔，新鸭呼雏过短篱。\n我欲高吟还阁笔，坐中留蔡总能诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阮希圣新轩即席兼呈同会君仪温老三首 其二","author":"郭祥正","text":"海边邂逅禁烟时，选胜携壶不可迟。\n日射山光如琥珀，水涵天影似琉璃。\n蝶随柳絮翻罗幕，人并桃花映竹篱。\n却忆绿槐阴下坐，曾寻宫叶为题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阮希圣新轩即席兼呈同会君仪温老三首 其三","author":"郭祥正","text":"谁怜龃龉老明时，把酒寻春已恨迟。\n舟漾绿波飞舴艋，烟笼青瓦湿琉璃。\n狂嗟李白驱鲸海，醉笑陶潜倚菊篱。\n争似隔林闻一曲，与君重赋杜秋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻陈伯育结綵舟行乐游湖戏寄三首 其一","author":"郭祥正","text":"湖波渺渺浸残春，东郭开筵迥不群。\n闻结綵舟撑碧落，更携箫鼓度青春。\n自怜玉海终无敌，却忆琼浆竟未分。\n珠履难陪空怅望，且凭诗句张吾军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻陈伯育结綵舟行乐游湖戏寄三首 其二","author":"郭祥正","text":"东陈风义旧传闻，雕鹗鸾凰果逸群。\n青竹题诗才倚马，画船槌鼓气凌云。\n赏心自向明时得，乐事应容下客分。\n敌饮会须翻玉海，背河决胜看齐军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻陈伯育结綵舟行乐游湖戏寄三首 其三","author":"郭祥正","text":"临漳多士冠南闽，况复高才更出群。\n笔下文章翻锦绣，坐中谈笑领风云。\n美名合预青钱选，邪党今从白眼分。\n闻欲高亭张雅宴，寂寥应悯旧将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵君仪风物可爱之什","author":"郭祥正","text":"二月风光着意看，莫思旅食久艰难。\n林间莺喜绵蛮语，水畔花愁料峭寒。\n游子牵衣拦道饮，美人携瑟上楼弹。\n少陵野老谁能继，君有新诗合筑坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净惠山亭要客致酒","author":"郭祥正","text":"何处要宾入醉乡，窣云亭榭冠南漳。\n城随山阜龙蛇转，花覆园林锦绣香。\n三月风光聊酩酊，百年人世少康强。\n采薇甘饿箪瓢乐，安用须为画省郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感怀寄泉守陈君举大夫","author":"郭祥正","text":"柴门永日泪沾巾，事与心违渐失真。\n家住江南几万里，身留海上已三春。\n明时枉作衔冤客，皓首翻为哭子人。\n多谢泉州贤府主，数将书札问悲辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和阮轩即事","author":"郭祥正","text":"游人随处踏青时，日永天低乐奏迟。\n水上往还多翠碧，盘中光洁尽琉璃。\n重山复岭争侵户，浅杏深桃半出篱。\n正是鲜春堪爱惜，劝君莫作送春诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君仪高明轩","author":"郭祥正","text":"一轩华榜揭高明，檐角昭昭挂日星。\n鸥鹭翩翻下空渚，云烟时复起中庭。\n长萝却覆鲛绡帐，远岫争开翡翠屏。\n香篆半销尘念息，始知天地一浮萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"携茶访徐彦醇助教","author":"郭祥正","text":"蓬荜萧然一亩宫，生涯四壁有清风。\n乡闾高行终无玷，场屋遗才误至公。\n书卷五车心尽记，年华八十耳犹聪。\n满杯雪液聊分酌，别后音尘岂易通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送饶守李泽民承议","author":"郭祥正","text":"倾盖论心古亦难，词源向我泻潺潺。\n番川共惜颜公去，汉室谁憎贾傅还。\n莫遣尘埃侵鬓发，且张图画对云山。\n何时樽酒重相遇，魏北江东落照间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南楼有怀元舆","author":"郭祥正","text":"且欲临高遣百忧，故携筇杖立城头。\n田家隔水犬吠犬，天气新晴鸠唤鸠。\n靡迤物华春又尽，纷霏尘事老何求。\n史君閒暇须游乐，莫为愁人罢乐游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵元舆言怀","author":"郭祥正","text":"与君交臂每忘忧，用即三公尚黑头。\n美化流行非乳虎，新诗老重似雎鸠。\n箧中玑贝方论价，江上田园未足求。\n信道斲轮真妙手，只惭缧绁玷英游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江春晚","author":"郭祥正","text":"黯淡阴晴阁雨天，清明将近见鞦韆。\n风高乔木莺初啭，水暖平沙鹭斗眠。\n身计只知忧陷阱，年华岂解老神仙。\n迢迢归路三千里，始信家书直万钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵元舆临汀书事三首 其一","author":"郭祥正","text":"福抚开山罢戍兵，我朝仁泽始流行。\n岚烟蒸湿同梅岭，地脉逶迤接赣城。\n花木藏春先腊拆，儿童要寿半岩名。\n如今太守真黄霸，里巷歌谣善治声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵元舆临汀书事三首 其二","author":"郭祥正","text":"碧瓦参差几万间，重楼复阁更回环。\n城池影浸水边水，鼓角声传山外山。\n凿落斗倾元弛禁，鞦韆争蹴未容閒。\n史君得意同民乐，日拥笙歌倒醉颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵元舆临汀书事三首 其三","author":"郭祥正","text":"近郭溪山最可游，雨晴天气返如秋。\n人携羽扇防浓雾，马惜鞯泥涉浅流。\n竹叶要翻金盏底，梨花偏称玉钗头。\n卧龙胜事堪图画，迥压闽南七八州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中南楼望西方僧舍要元舆同赋","author":"郭祥正","text":"残春丝雨洗氛埃，一日重城望数回。\n熟色浅深添草树，轻绡高下覆楼台。\n溪声远与钟声杂，山影分从电影开。\n不得画工如立本，史君吟写最多才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东郊","author":"郭祥正","text":"东郊怅望惜春归，颇觉年来万事非。\n不奈离愁须觅酒，得闻歌响却沾衣。\n蜜蜂捕蕊穿花去，巢燕寻泥拍水飞。\n物态风光能几许，老无忧患世人稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨霁","author":"郭祥正","text":"今朝晴日照柴扉，即看轻云捲翠微。\n燕子有情归旧栋，柳条牵恨拂征衣。\n故乡书信何时到，瘴地烟岚此处稀。\n白酒一杯聊强饮，物情人事恐相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白莲院观蔡君谟要师遗迹","author":"郭祥正","text":"盘屈龙蛇未奋身，老禅当日亦知人。\n来趋莲幕文章客，去作金銮侍从臣。\n物外论交终不泯，壁间题字尚如新。\n年年杨柳春先绿，谁复多情与望春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"开元客馆","author":"郭祥正","text":"裂瓦攲椽五六间，地形高下颇依山。\n黄鹂相应雨初过，绿树成阴春已还。\n土灶有烟营饭饱，柴门无客任苔斑。\n却思一钓沧浪去，蘋叶蓼花相伴閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"开元禅寺","author":"郭祥正","text":"三寺参差见刹竿，开元形胜据龙蟠。\n楼台影落青霄险，钟磬声传碧涧寒。\n物物有缘香供盛，尘尘无碍法筵宽。\n欲随大士披华藏，北斗容身不亦难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵元与雨中见怀二首 其一","author":"郭祥正","text":"屋漏沿窗玉篆斜，索居蒸湿度年华。\n衔冤欲诉中都狱，抱义难酬漂母家。\n地隔五湖秋雁绝，草荒三径晓猿嗟。\n幸君数送琼瑶句，枯蘖蒙春亦吐花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵元与雨中见怀二首 其二","author":"郭祥正","text":"雨锁柴门一径斜，诗筒时复觇英华。\n自怜白发非商叟，却对青山忆谢家。\n卞玉逢知终荐达，隋珠投暗只惊嗟。\n悲歌半夜弹雄剑，恨血千年变土花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小阁夜眺","author":"郭祥正","text":"白日尘寰忧思深，夜登危阁解烦襟。\n空江云尽月涵璧，绝壑风生松奏琴。\n佳客不来分坐赏，浊醪谁为此时斟。\n疏钟辄莫催清晓，吾欲凭栏更一吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南山晚步简自宣长老","author":"郭祥正","text":"雨过南山紫翠深，团团仙露洒衣襟。\n碧云影里寒猿啸，玉涧声中怨鹤吟。\n期赴前林同茗酌，倦投盘石拣萝阴。\n凭谁寄语谢康乐，安用披榛故远寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵元舆题王祖圣南涧楼清斯亭二首 其一","author":"郭祥正","text":"平昔朱衣驾两轓，高楼归隐卧云泉。\n文章未许矜盘谷，水墨无劳画辋川。\n春日半晴花照地，秋风入夜雁连天。\n烧丹辟谷非吾事，能远尘寰即是仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵元舆题王祖圣南涧楼清斯亭二首 其二","author":"郭祥正","text":"松径沿溪溪水深，水光澄碧倒松阴。\n浮杯可酌刘伶酒，坐石仍弹靖节琴。\n无数轻鸥随出处，几番佳客伴登临。\n自嗟罗网何时脱，往濯尘缨为一吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠武平许令","author":"郭祥正","text":"昔拜先翁汇水滨，存亡回首几经春。\n凤毛今喜为花县，鹤发谁嗟困客尘。\n箧有赠篇长取读，心藏遗德尚如新。\n源源世泽来无尽，桂籍传家已四人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"迁居西湖普贤院寄自省上人","author":"郭祥正","text":"十亩方塘四岸榕，夕阳初尽月生东。\n不嫌瘴地无家别，犹喜山房有路通。\n宁使五尘长我缚，得超三界与师同。\n迁居却作安居计，病入残年两耳聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦游金山作四韵既觉止记一联因足成之","author":"郭祥正","text":"珠帘高卷倚危栏，望尽方知出世间。\n江海交流云缥缈，楼台相映月回环。\n薰成香界浑无地，化作天宫别有山。\n京口瓜洲竟安在，梦醒却欲泛舟还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵无逸长老秋居见寄","author":"郭祥正","text":"榕树萧萧一径深，门庭秋静紫苔侵。\n能依幻质循元觉，默运真悲拔众沈。\n有想愿分香界饭，忘言求出世间心。\n旃檀谩把炉中爇，无尽无边结宝阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]