[{"title":"赋雪梨寄二孙","author":"苏简","text":"梨乃北方来，东阳有遗种。\n开花如雪洁，结实论斤重。\n似闻风霜来，采摘不旋踵。\n肤瑩玉在手，剖之醴泉涌。\n甘凉宜解酲，席上贾馀勇。\n甚美非耐久，糜溃失前宠。\n长安疑父祖，压沙岂伯仲。\n时方禁苞苴，林下喜得共。\n老人齿颊寒，食指难为动。\n邻墙有酒仙，双苞可持送。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望太湖","author":"蒋堂","text":"杳杳波涛阅古今，四边无际莫知深。\n润通晓月为清露，气入霜天作暝阴。\n笠泽鲈肥人鲙玉，洞庭柑熟客分金。\n风烟触目相招引，聊为停桡一楚吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠南岳宣义大师英公","author":"苏德祥","text":"学就书闻在道林，几年辛苦用身心。\n九霄雨露酬知早，百首风骚立意深。\n青白野云闲里卧，古今碑碣醉中寻。\n因何负此多般艺，可惜教师鬓雪侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大涤洞天留题","author":"苏遹","text":"生平未识洞霄宫，幸与东君访赤松。\n丹井千年犹好在，青山九锁不曾封。\n入门快睹云根石，矫首遐观天柱峰。\n凡骨变成仙骨了，此躯何患弗为龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月望日雪二绝 其一","author":"苏辙","text":"玄冥留雪恼中春，损麦伤花病老人。\n已典布裘捐衲袜，朝来酒尽乞比邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月望日雪二绝 其二","author":"苏辙","text":"老翁衰病不忧花，百口唯须麦养家。\n闻道田中犹要雪，兼收凝白试山茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万蝶花","author":"苏辙","text":"谁唱残春蝶恋花，一团粉翅压枝斜。\n美人欲向钗头插，又恐惊飞鬓似鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三日上辛祈谷除日宿斋户部右曹元日赋三绝句寄呈子瞻兄 其三","author":"苏辙","text":"北客南来岁欲除，灯山火急万人扶。\n欲观翠辇巡游盛，深怯南宫锁钥拘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元前雪三绝句 其一","author":"苏辙","text":"腊中平地雪盈尺，嵩隗山田麦尚乾。\n不管上元灯火夜，飞花处处作春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元前雪三绝句 其二","author":"苏辙","text":"闭门不问门前事，灯火薰天自不知。\n闻道朝来雪又下，老人今岁未应饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元前雪三绝句 其三","author":"苏辙","text":"天公似管人间事，近事传闻半是非。\n但使麦田饶雨雪，饥人得饱未相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大雨后咏南轩竹二绝句 其一","author":"苏辙","text":"苦寒坏我千竿绿，好雨还催众笋长。\n痛饮虽无嵇阮客，瓢尊一试午阴凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大雨后咏南轩竹二绝句 其二","author":"苏辙","text":"叶开翡翠才通日，节竦琅玕不怕风。\n稍放西边深二丈，端如幽谷茂林中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大雪三绝句 其二","author":"苏辙","text":"玄冥留雪付勾芒，桃李虽忧麦未伤。\n膏泽较迟三十日，问天此意亦茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大雪三绝句 其一","author":"苏辙","text":"闰岁穷冬已是春，当寒却暖未宜人。\n阴风半夜催飞霰，稍净天街一尺尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大雪三绝句 其三","author":"苏辙","text":"连岁金明不见冰，上春风雪气棱棱。\n台中曾奏五行传，到此施行愧未曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子瞻与长老择师相遇于竹西石塔之间屡以绝句赠之又留书邀辙同作遂以一绝继之","author":"苏辙","text":"远老陶翁好弟兄，虎溪庐阜久逢迎。\n何须更要经平子，清议从来贵士衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子瞻赠岭上老人次韵代老人答","author":"苏辙","text":"岭头卢老一炉灰，长短根茎各自栽。\n轻贱已消先世业，知君海上去仍回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山橙花口号","author":"苏辙","text":"故乡寒食荼蘼发，百和香浓村巷深。\n漂泊江南春欲尽，山橙仿佛慰人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五月园夫献红菊二绝句 其二","author":"苏辙","text":"南阳白菊有奇功，潭上居人多老翁。\n叶似皤蒿茎似棘，未宜放入酒杯中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五月园夫献红菊二绝句 其一","author":"苏辙","text":"黄花九月傲清霜，百草满园无此香。\n红紫无端盗名字，试寻本草细商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以蜜酒送柳真公","author":"苏辙","text":"床头酿酒一年馀，气味全非卓氏垆。\n送与幽人试尝看，不应知是百花须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元老见访留坐具而去戏作一绝调之","author":"苏辙","text":"石霜旧夺裴休笏，坐具只今君自留。\n留放书房还会否，受降曾不费戈矛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元老和示小诗自谓非战之罪复作一绝并坐具还之","author":"苏辙","text":"请君却领弥天具，不欲终收陷虎名。\n莫道昏沉非战罪，何如不战屈人兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东西京二绝 其二","author":"苏辙","text":"犀箸金槃不暇尝，更须石上捣黄粱。\n数钱未免河东旧，不识前朝大练光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东西京二绝 其一","author":"苏辙","text":"亲祀甘泉岁一终，属车徐动不惊风。\n宓妃何预词臣事，指点讥呵豹尾中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东轩长老二绝 其二","author":"苏辙","text":"担头挑得黄州笼，行过圆通一笑开。\n却到山前人已寂，亦无一物可担回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东轩长老二绝 其一","author":"苏辙","text":"东轩正似虚空样，何处人家笼解盛。\n纵使盛来无处著，雪堂自有老师兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"去年冬辙以起居郎入侍迩英讲不逾时迁中书舍人虽忝冒愈深而瞻望清光与日俱远追记当时所见作四绝句呈同省诸公 其二","author":"苏辙","text":"铜瓶洒遍不胜寒，雨点匀圆冻未乾。\n回首曈眬朝日上，槐龙对舞覆衣冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"去年秋扇二绝句 其一","author":"苏辙","text":"箧中秋扇委尘埃，春晚炎风拂面来。\n旧物不辞为世用，故人相见莫心猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"去年秋扇二绝句 其二","author":"苏辙","text":"扇中秦女旧乘鸾，拂去浮尘色尚鲜。\n未尽炎风早归去，不堪秋后乞哀怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"记梦","author":"苏辙","text":"长鱼三尺困横盆，送入清流喜欲奔。\n报我金匙仅盈寸，掷还聊喜不贪存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再赋葺居三绝 其一","author":"苏辙","text":"谁将修竹寄邻家，秋斫长竿春食芽。\n旋筑高墙护鸡犬，稍容嵇阮醉喧哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再赋葺居三绝 其三","author":"苏辙","text":"南北高堂本富家，百年梁柱半攲斜。\n略教扶起犹堪住，西望吾庐已自奢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再赋葺居三绝 其二","author":"苏辙","text":"短垣疏户略藏遮，翠竹长松夹径斜。\n游宦归来四十载，粗成好事一田家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同外孙文九新春五绝句 其三","author":"苏辙","text":"菊叶萱芽初出土，冻齑冷面欲宜人。\n老人脾病难随汝，洗釜磨刀待晚春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同外孙文九新春五绝句