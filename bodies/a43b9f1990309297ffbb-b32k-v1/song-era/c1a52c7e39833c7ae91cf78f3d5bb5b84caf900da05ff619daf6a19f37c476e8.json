9689","path":"宋_1.csv","pointer":78188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵毛君山房即事十首 其九","author":"苏辙","text":"庵中独宿雨垂垂，永夜无人款竹扉。\n灰冷铜炉香欲灭，床头一点葛灯微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵毛君见督和诗","author":"苏辙","text":"新诗落纸一城传，顾我疏芜岂足编。\n他日杜陵诗集里，韦迢略见两三篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王适春雪二首 其二","author":"苏辙","text":"春雪飘摇旋不成，依稀履迹散空庭。\n山藏复阁犹残白，日照南峰已半青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵冯弋同年","author":"苏辙","text":"细雨濛濛江雾昏，坐曹聊且免泥奔。\n卖盐酤酒知同病，一笑何劳赋北门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵刘贡父题文潞公草书","author":"苏辙","text":"鹰扬不减少年时，墨作龙蛇纸上飞。\n应笑学书心力尽，临池写遍未裁衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵孙推官朴见寄二首 其一","author":"苏辙","text":"蒙愠未能忧悄悄，得闲时复醉昏昏。\n知君亦学无言语，岂悟维摩不二门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张恕戏王巩","author":"苏辙","text":"二君豪俊并侯家，歌舞争妍不受誇。\n闻道肌肤如素练，更堪鬓发似飞鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李逵见赠","author":"苏辙","text":"太学群游经最明，青衫憔悴竟何成。\n齑盐仍作当年味，名誉飞蝇过耳声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵贡父子开直宿","author":"苏辙","text":"掷简摇毫气吐虹，兴馀庭药咏残红。\n今宵文字知无几，鼾睡帘中笑二公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵黄庭坚学士猩毛笔","author":"苏辙","text":"不悟身边一斗红，圣贤随世亦时中。\n何人知有中书巧，缚送能书陈孟公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答人幽兰","author":"苏辙","text":"幽花耿耿意羞春，纫佩何人香满身。\n一寸芳心须自保，长松百尺有为薪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵题画卷四首 其一 山阴陈迹","author":"苏辙","text":"卧对郗人气已真，晚依丘壑更无伦。\n不须复预清言侣，自是江东第一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵题画卷四首 其二 雪溪乘兴","author":"苏辙","text":"亟往遄归真旷哉，聋人不信有惊雷。\n虽云不必见安道，已误扁舟犯雪来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵题画卷四首 其三 四明狂客","author":"苏辙","text":"失脚来游九陌尘，故溪何日定抽身。\n便同贺老扁舟去，已笑西山郑子真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵题画卷四首 其四 西塞风雨","author":"苏辙","text":"雨细风斜欲暝时，淩波一叶去安归。\n遥知夜宿蛟人室，浪卷波分不著衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":78203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]