[{"title":"丹青阁","author":"王迈","text":"盛年忧国鬓毛苍，谏疏端堪铭豆觞。\n行或使之苗膏雨，心乎爱矣藿倾阳。\n荣华不与群儿竞，名节须留千载长。\n试看丹青阁中句，吾宗有此好元方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"为余君肃曰严母夫人寿","author":"王迈","text":"曾向瑶池稳泛槎，眼看西母佩飞霞。\n定分天地冲和气，来匹公侯富贵家。\n熊胆课儿心苦淡，鱼轩锡命世荣华。\n樽前何物堪为寿，笑指蟠桃几度花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元旦次日立春","author":"王迈","text":"年从爆火暗中移，椒柏迎欢上酒卮。\n今日天晴宜麦熟，明朝春到报花知。\n好奇漫说鸡千蹠，行乐都来黍一炊。\n但得新年诗有料，不妨贫似去年时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兰花","author":"王迈","text":"见山堂里小春寒，觞政诗囊甚有欢。\n重客分明知小李，美人自在写猗兰。\n直须博去纫为佩，只欠香来劣可餐。\n菊涧一枝尤洒落，不妨人作易芳看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兰亭故居","author":"王迈","text":"弭节稽山乐事多，旧闻一一入搜罗。\n卧薪伯业今何在，乔木家声久不磨。\n可笑儿曹怜野鹜，却输道士辨笼鹅。\n不因禊帖风流远，千载人谁数永和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬孟驾出亲享太庙连日雨是朝大霁都人云凡四次如此矣 其一","author":"王迈","text":"玉宇曈眬晓，琼京略绰寒。\n紫衣千骑从，黄伞万人看。\n日景新开霁，天颜剩有欢。\n驾回春满殿，圣母喜加餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"生朝止客","author":"王迈","text":"白发苍颜五十三，北风不竞又来南。\n宦情于我蜡来淡，世味从渠蜜样甘。\n乌哺劬劳恩未报，雁行凄断痛何堪。\n记生纵有一樽酒，忍与妻孥共醉酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用徐编修德夫韵贺其开藩旴江二首 其二","author":"王迈","text":"君侯心事即苍冥，谔谔曾同唯唯争。\n医国奇方留后用，字民好事及今行。\n悬知夔卨班难继，且入龚黄传亦荣。\n天诱圣衷差易耳，正人得路致隆平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用徐编修德夫韵贺其开藩旴江二首 其一","author":"王迈","text":"几年泉谷养灵根，一立朝班敢尽言。\n锁掣玉麟辞绀殿，符分金虎坐辕门。\n郡条上日新施设，民瘼微时预讨论。\n勿鄙向来工珥笔，只将清净镇嚣喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用韵简黄元辅二首 其二","author":"王迈","text":"发今如此不重青，醉后长歌折槛行。\n老去一寒甘忍死，古来几士得全名。\n稻畦蔬圃閒中乐，药禁薇阶膜外荣。\n所见略同君与我，不妨官小得人轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用韵简黄元辅二首 其一","author":"王迈","text":"不爱螭头一点青，片言枘凿拂衣行。\n但忧负我平生学，岂愿争渠竖子名。\n天骏出闲驽饱秣，国兰却佩艾敷荣。\n想君记得西山语，佳士从来去就轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用韵和张仁仲史君","author":"王迈","text":"五花入手眼增明，合主黉宫善类盟。\n善教牖民师帅责，婉辞玉女父兄情。\n马经定价增神骏，鸮亦怀音避恶名。\n从此心田去稂莠，沐侯化雨及时耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再呈赵倅","author":"王迈","text":"委斋坐我以春风，不事拘挛边幅中。\n俗子语言藏攫阱，丈夫胸腹等崆峒。\n虚舟相触何心在，怒火虽炎一饷空。\n到底不如归去好，扶犁戴笠作村翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和二首 其二","author":"王迈","text":"壮岁清源曾倦游，今朝大郡又封侯。\n身安不用扶鸠杖，骨贵从知应虎头。\n望阙承恩颜有喜，即家问政礼宜优。\n济时事业需元老，莫遣空横野渡舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和二首 其一","author":"王迈","text":"笔飞鸾凤墨翻鸦，白玉堂中懒草麻。\n得句批风仍抹月，怡神饮露更餐霞。\n公于轩冕浮名薄，帝念耆英宠礼加。\n丕衍修龄全晚节，洋洋一札圣言嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和王君保定通判韵","author":"王迈","text":"覆雨翻云市道交，公持正论息群嘲。\n风高莫送翎毛短，春煖难生土脉硗。\n攻过每蒙奇药赐，卫生更借好方抄。\n一阳来复骎骎泰，善类倾心望拔茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和陈侍郎子知丞寄桂香酒新到又令孙司户出柑为劝","author":"王迈","text":"柏叶椒花未报春，阳和先到四筵宾。\n传观秀句堪呈佛，谛听清谈太迫人。\n子舍香醪浮瓮碧，孙枝名果荐盘新。\n却将甘旨分寒陋，尤见先生爱士真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和陈起予二首 其一","author":"王迈","text":"龙蛰藏身来者伸，不妨抱道且安贫。\n昼眠经笥誇群弟，夜拥绨袍忆故人。\n富贵未来招鬼笑，文章太好恐天嗔。\n安排礼乐三千字，寓目他年许得臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"多病","author":"王迈","text":"客问新来况，新来病更多。\n忧时添老色，愠小损天和。\n不梦荣华境，祇寻安乐窝。\n年丰米犹贱，加饭笑廉颇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晚","author":"王安石","text":"月映林塘澹，风含笑语凉。\n俯窥怜绿净，小立伫幽香。\n携幼寻新的，扶衰坐野航。\n延缘久未已，岁晚惜流光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晚偶题","author":"王迈","text":"饮冰食檗坐穷阎，旋觉星星上鬓髯。\n百尺楼中从偃卧，五侯门下任暄炎。\n寒花最爱香来晚，倒蔗须教末见甜。\n寿相谁知三甲异，新年愿得一丁添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"师心主人作飞锡岩","author":"王迈","text":"岩头古佛留心印，岩下高人新受持。\n佛亦本来无隐现，人于悟处领希夷。\n莫嫌梦里还谈梦，且看奇中更有奇。\n他日證成罗汉果，相逢不必问伊谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵调甘内掾","author":"王迈","text":"韩掾才情妙，吟成苦夜长。\n歌残如意铁，梦断合欢床。\n鼓瑟湘云暖，吹笙岭月凉。\n旧时双燕子，飞入谢家堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池上归道间即事二首 其二","author":"王迈","text":"寒食清明近，知春不久归。\n眼惊红作阵，心爱绿成围。\n宿鹭立晴濑，栖鸦掀夕晖。\n狂游付年少，我已省前非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池上归道间即事二首 其一","author":"王迈","text":"一雨恼春思，今朝得快晴。\n水波随日动，麦浪受风平。\n野意来无极，篮舆稳更轻。\n抵家何事好，稚子亦驩迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西征延平道中偶成","author":"王迈","text":"群羽斜飞欲刺空，谁能剪翼向笼中。\n客程跋涉二千里，年纪侵寻五十翁。\n酒有神通排磊块，书无灵圣困英雄。\n相逢且说穷愁话，才入修门莫说穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别刘孟容峸提干二首 其二","author":"王迈","text":"吾莆诸寿隽，习静鲁灵光。\n有子麒麟种，群孙鸳鹭行。\n此行青眼众，见谓白眉良。\n通籍何愁晚，庭椿乐未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别刘孟容峸提干二首 其一","author":"王迈","text":"孟容吾畏友，春日去朝京。\n蔗境诗多好，莲池官最清。\n坐诬缘举将，取忌为时名。\n诸老端平岁，同词为辨明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听儿德胙读书呈邱景实知一教授","author":"王迈","text":"我被儒官误，如今又教渠。\n但令识数字，不要读多书。\n帝惮汲生戆，人嫌贾谊疏。\n君看朱紫贵，不害腹空虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈竹轩张史君二首 其二","author":"王迈","text":"日晡斋閤响铃绦，鞅掌文书尚坐曹。\n吏困行移愁脱腕，侯勤剖决快挥毫。\n维摩正为众生病，太守胜如从事劳。\n愿养精神需大用，款陪齐客醉醇醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈竹轩张史君二首 其一","author":"王迈","text":"竹轩治郡政成时，却值王孙庆玉墀。\n无吏下乡民点塔，捐田入学士砻碑。\n平反阴德堪娱母，清白家风更课儿。\n见说元宵灯不放，为他百姓惜膏脂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿太守","author":"王迈","text":"生申维岳咏崧高，孕秀储精岁月多。\n盛旦上元开甲子，前朝令节纪中和。\n铜符暂剖雄藩印，宝鸭行鸣禁路歌。\n天祐名臣锡难老，好将铜狄屡摩挲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿丘曹","author":"王迈","text":"三分辰月一分过，天产真仙积庆多。\n西国玉枝家世袭，霸陵铜狄手长摩。\n功名本自归谈笑，寿考何劳着咏歌。\n行直紫宸清夜宿，共惊莲炬认鸣珂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿仙游许宰","author":"王迈","text":"南极秋来光烛天，琴堂此夕寿诗仙。\n庞公戊子孰小大，寇相中元相后先。\n制锦从容才有刃，嚼丹赋咏笔如椽。\n交梨火枣君家物，从此蓬莱不计年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿丞相","author":"王迈","text":"翼戴三朝冕有蝉，归来今作地行仙。\n且看宫阙萧何第，未泛江湖范蠡船。\n老境已怜周尚父，庆门方似汉韦贤。\n一杯仰祝椿松寿，岁岁流觞八日前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿陈贡元","author":"王迈","text":"潘胸万卷富文章，天产英贤生玉皇。\n后日岳神逢诞节，今朝昴宿出呈祥。\n秋风鹗表声名远，春浪龙门姓字香。\n来岁寿觞何处饮，西湖三月正韶光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿郑青山","author":"王迈","text":"苍龙拂晓挂高寒，飞鞚翩然出帝关。\n九酿黄封中圣酒，一杯红入上台颜。\n阉雏生怕韩公召，宫妾尤惊富相还。\n独有帝心怀旧弼，未应霖雨阁青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿南宗东岩四首 其三","author":"王迈","text":"新阳一信迸黄钟，春到分枝若木丛。\n天为万人生李晟，朋来三寿颂僖公。\n松林古佛烧香报，粟洞群仙注福同。\n欲识东岩长寿相，只看台背更方瞳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿南宗东岩四首 其二","author":"王迈","text":"杉风萝月读书楼，藜杖分光夜校雠。\n双璧连科天启齿，一珠照座客回头。\n金闺通籍传芳信，綵袖称觥衬雅讴。\n浪说锦屏家庆好，银潢元有此风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿南宗东岩四首 其一","author":"王迈","text":"公是昆台紫府仙，中间一念堕尘缘。\n小猿驿口霜生甑，白鹤岩前月满船。\n诗太迫人清似水，琴真知我直如弦。\n年来族老晨星少，独鲁灵光尚岿然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"良月朔郊行问讯梅菊","author":"王迈","text":"夜半渐惊风作恶，朝来剩喜月为良。\n知梅有意商量雪，问菊何谋准备霜。\n和靖未吟先得趣，渊明欲断已无肠。\n物情荣悴胡关我，独酌悠然寓醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈方大弟宏父将省侍潮阳以诗约别","author":"王迈","text":"逆旅频连风雨床，归来踪迹两参商。\n谁知才隔路三舍，不似相从天一方。\n壶山白认梅将雪，潮水黄知菊已霜。\n便去也须留驿道，欲携斗酒话彷徨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘编修潜夫读近报蒋岘被逐二首 其二","author":"王迈","text":"两载相依笑陆沉，鹑衣不羡锦为衾。\n渠侬眩耀麒麟楦，我辈翻腾驽骥吟。\n朝去一凶忧稍歇，边留五大祸尤深。\n栋梁培植谁之责，莫遣斧斤终日寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘编修潜夫读近报蒋岘被逐二首 其一","author":"王迈","text":"读报欣然共赋诗，古来忠佞各殊岐。\n彼犹愧见蒋颖叔，君盍自期刘器之。\n恶草剪除虽一快，芳兰销歇已多时。\n怀哉康节先生语，作事莫教人绉眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和京教李景平 其二","author":"王迈","text":"美人清晓梦催班，老子心清只爱山。\n晚岁松筠留素节，艳春桃李付红颜。\n官粗鹤料犹堪活，援寡龙门莫浪攀。\n满眼飞腾霄汉上，谁知倦翼已思还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和京教李景平 其一","author":"王迈","text":"父子才名压二班，儒官咫尺近家山。\n官閒人羡清华选，诗好天开笑粲颜。\n雌甲一生甘守拙，雄飞千里莫渠攀。\n骨凡自分仙难做，懒去从人学九还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和宗侄朝望公辅贺生朝韵","author":"王迈","text":"投閒久矣息心兵，台上饥乌又一声。\n湖海正须招隐士，朝廷终不赦狂生。\n剖开胸腹犹馀赤，削尽头衔越样清。\n坐看吾宗后来俊，西风再举上鹏程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵倅二首 其二","author":"王迈","text":"二车人物汉三明，来主壶山寿永盟。\n众口是碑均咏德，片言如秤不容情。\n斯文阴有扶持力，循吏何求烜赫名。\n早晚政成天上去，旧廛还忆老农耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵倅二首 其一","author":"王迈","text":"一样风清共月明，平分那得外斯盟。\n合将长与贰同传，正恐君嫌誉过情。\n碑断文昌须改制，台高马援却逃名。\n色丝黄绢侬无分，悔不文园着力耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄遇卿二白韵","author":"王迈","text":"晚来云色半浓淡，云外青山知有无。\n才出六花誇舞女，又飞一白慰农夫。\n久无人说平淮事，空有天生访戴图。\n忧国寸心同皎洁，诗肩如鹭更清臞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"枕上复用道间乡字韵呈同人","author":"王迈","text":"爆竹声中度岁忙，椒花杯上换春阳。\n欠书元日神荼帖，又看新年傀儡场。\n客枕方酣千里梦，朝靴正踏五更霜。\n主翁须要惺惺在，富贵何如归故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴戒珠寺读右军祠堂碑","author":"王迈","text":"先祠石刻摩挲久，华胄遥遥企慕劳。\n字古似观秦急就，词幽如读楚离骚。\n不誇绝艺临池学，只羡清风誓墓高。\n更有山居须问讯，拟携方士鍊金膏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贤牧堂","author":"王迈","text":"贤牧存遗爱，邦人重此祠。\n典刑前辈几，德政后来谁。\n来日清泉濯，归时只鹤随。\n不须看石碣，人口是丰碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚山行问酒主媪以瓶罄告","author":"王迈","text":"霜晓寒于腊，日中方有春。\n云头才作暮，风力又欺人。\n老犊眠方稳，雏莺语未真。\n停骖谋一醉，不酌酒家贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜对客","author":"王迈","text":"旋烧香鸭剔银缸，风捲银蟾上矮窗。\n诗癖苦无奇药疗，睡魔赖有建茶降。\n回环蛙部疑成两，接续蝉笙不计双。\n好友相看宁惜夜，满怀秋思浩如江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋榜已揭不寐","author":"王迈","text":"寒重难为坐，宵长可奈眠。\n老天不解事，特地闰今年。\n风助蛩声苦，霜和月色妍。\n抱衾成百感，嚼句忆坡仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺陈思表兄西上","author":"王迈","text":"谁言场屋似樗蒲，好手居然不解输。\n叠采三巡皆得注，结场一掷定成卢。\n月评须应状元谶，风义新添家庆图。\n科第假途馀事耳，方来宇宙要人扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺同年林簿同卿龟从新婚 其二","author":"王迈","text":"知君雅志厌奢豪，富贵相寻可得逃。\n云母屏间穿雀目，销金帐下醉羊羔。\n养生早悟眉为斧，侍立须惊手有刀。\n老我诗成还失笑，膏粱未必胜糠糟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺同年林簿同卿龟从新婚 其一","author":"王迈","text":"金华门外浥京尘，乌石山前结帨巾。\n翁婿相看冰映玉，庭闱一笑颊生春。\n昔言尔尔嫌随俗，今唤卿卿喜有人。\n来岁梦兰叶佳兆，犀钱玉果出娱宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺宋兄令子县尉之望擢第荣还","author":"王迈","text":"自从西笑便安排，果有佳音天上来。\n纵靶少年亲得隽，跨鞍老将几衔枚。\n欢驰帝里泥金帖，喜溢亲庭药玉杯。\n造物与君良不薄，好将阴德厚栽培。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺陈讲书谋仲诹璋庆","author":"王迈","text":"好是橙黄橘绿时，津津黄色上双眉。\n十为良月阳将长，一索成男喜可知。\n南外□房开宅相，西清荷橐长孙枝。\n青春拾芥收科第，须记麟庠客有诗。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺陈侍郎该宗祀告成加封清源郡侯二首告词有缅怀耆德养老乞言等语 其二","author":"王迈","text":"辞封来伴赤松游，判作山中万户侯。\n一片葵心天北阙，十行芝检殿西头。\n渊洪端静恩言厚，拊藉温存眷礼优。\n国事多艰耆旧少，须公与作济川舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺陈侍郎该宗祀告成加封清源郡侯二首告词有缅怀耆德养老乞言等语 其一","author":"王迈","text":"锦书飞下字如鸦，从橐词头似相麻。\n竣事明禋均雨露，缅怀耆德傲烟霞。\n鸡窠佚老精神健，燕颔宜侯爵邑加。\n愿体乞言珍重意，星驰驿骑奏忠嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方栻赴铨","author":"王迈","text":"笑提虹管试春闱，大手何妨小出奇。\n龙种嘶鸣喑万马，鹿麑辟易避孤罴。\n京城纸贵争传赋，便驿书来剩寄诗。\n老友生平识英物，要看修竹拂云枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]