[{"title":"九日置酒","author":"宋祁","text":"秋晚佳辰重物华，高台复帐驻鸣笳。\n邀欢任落风前帽，促饮争吹酒上花。\n溪态澄明初毕雨，日痕清澹不成霞。\n白头太守真愚甚，满插茱萸望辟邪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"了净归天竺寺","author":"宋祁","text":"晓原霜重俊鹰肥，一席归风路不迷。\n林下会徒从雾合，海边停梵见潮低。\n霜篮烹茗寻前圃，雨屐粘苔认故蹊。\n知有诗魔未降伏，汤休日在碧云西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月十八日席上忆季长未还不同斯乐欲作诗寄之会使者来已有新章今牵连成篇拜呈上","author":"宋祁","text":"烟压西郊雨压津，满城歌吹为芳辰。\n江形左右衣留带，柳色高低曲与尘。\n暖逼园花迎望密，晓催林鸟每啼新。\n知君贪拥光华节，未有尊前共惜春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"入壬辰新岁","author":"宋祁","text":"五十为衰始，仍馀五岁衰。\n双眸不明鉴，残鬓已纷丝。\n铜虎虽频剖，荷囊信滥持。\n何须依老格，先作故山期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八月十四日夜东轩饯赵同州志元吴陕州冲卿徐润州君章","author":"宋祁","text":"明月不常值，中秋能暂新。\n谁言一堂上，相与异州人。\n适意苦难得，举杯宁厌频。\n清光定千里，他日远相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜居","author":"宋祁","text":"自乐颜居陋，非论晏市嚣。\n西山宜托疾，东路便归樵。\n穴邃狐情乐，巢完鸟意遥。\n居然深隐去，宁待左生招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又寄王都官","author":"宋祁","text":"倦把菱花照病容，萧萧斑鬓作衰翁。\n虞翻到骨终无媚，阮籍逢途但有穷。\n敢望君恩收坠屦，决须私计付冥鸿。\n衔杯后会何能定，万里惊飙一转蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万州齐都官","author":"宋祁","text":"熛阙归心恋九关，凭高郡阁见南山。\n彤轓冒雨春畴阔，紫闼焚香夜帐閒。\n宴弁侧星陪卜昼，妍歌抽雪送酡颜。\n西京地大民风厚，蜀秭沈波月蚌还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万秀才园斋","author":"宋祁","text":"仁里乐丘园，茨茅构回轩。\n槛风丛筱密，畦雨晚菘繁。\n列岫非他境，疏流即故源。\n彦伦回驾日，于此愧惊猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月晦日","author":"宋祁","text":"静弹尘帻照溪流，落泊春芳向尽头。\n早叶乍浓留客坐，晚花犹在索人愁。\n最怜幽草能萦带，已觉浮云解映楼。\n玉发未多须剧饮，赢输宁属阿戎筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三司晏尚书西园玩菊","author":"宋祁","text":"涉园求胜赏，时菊艳秋光。\n散漫仙潭饵，缡褷瑞鹄裳。\n酒熏吹晚蕊，蜂冷抱残香。\n公意周盈感，留杯尽夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三封田墅 其一","author":"宋祁","text":"驱马三封下，还家值日西。\n林间寻路隘，露里入山迷。\n僮倦仍依樾，鸡閒已上栖。\n暂来翻似客，邻酒夜过携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三封田墅 其二","author":"宋祁","text":"清和迁首序，岑寂此凭栏。\n涧雨虹前罢，林樱鸟后残。\n野姿连草向，天影入池宽。\n日暮严城阻，裴回惜据鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下直","author":"宋祁","text":"殿楼传鼓报归鞍，槐道逶迤出九关。\n雨罢浮云留北阙，朝来爽气遍西山。\n倏逢行幰排辀度，稍见晴鸦接翅还。\n痴计未容官事了，只惊潘鬓飒然斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夕坐","author":"宋祁","text":"岸帻坐前楹，天围极望青。\n日华开岭雾，风影碎池星。\n重露惊栖鹤，幽丛带暗萤。\n尘机心久息，宁待据梧瞑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小酌感春邀坐客并赋","author":"宋祁","text":"林下复池边，其如春暮天。\n花仍无数落，柳亦第三眠。\n强饮非能剧，狂歌不取妍。\n流芳何预事，只是自怡然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中晚春","author":"宋祁","text":"新火暮春天，穷山寄一廛。\n畹兰催酒熟，溪草作茵眠。\n落絮轻无定，残花浅自怜。\n缁帷谈久倦，江上问挐船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中清明","author":"宋祁","text":"一雨东郊捲夕云，山中坐对寂寥春。\n高低桃锦红相倚，轻重榆钱绿不匀。\n杯冷罗门抛午案，簺残犀槊晦流尘。\n汉鳊渐美开鱼禁，已约溪公下钓缗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"马上见残月","author":"宋祁","text":"娟娟天外月，正见上朝人。\n老桂欹藏树，纤钩侧抱轮。\n气清仍泛露，光淡即迎晨。\n尚作裴回意，西楼对结邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"马上遇雨","author":"宋祁","text":"万瓦凉声挫暑威，轻风斜湿看茸题。\n禁沟花咽先闻溜，驰道沙平久未泥。\n拂水有纹飞燕下，翻珠不定紫荷低。\n城阴雾密千门掩，更恐归骖五里迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"马比部赴两浙提刑","author":"宋祁","text":"两汉为郎选，南方奉使材。\n书随星火落，帆拂斗牛开。\n月破涛收鹭，天低雨暗梅。\n却缘持节重，无客对衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不言","author":"宋祁","text":"不言非巧宦，要是乏高符。\n托社天教散，为公谷与愚。\n桂枝怀隐树，荆叶恋欢株。\n荣路多高足，争传八列呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中山公损疾二首 其二","author":"宋祁","text":"恳避严庐十拜章，一麾重许出东方。\n批成诏凤多焚草，戏入仙禽不乱行。\n丽正书编争授简，荆州象笏别持囊。\n绛帷有客悲秋早，预怯临流奉祖觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中山公损疾二首 其一","author":"宋祁","text":"自有西京七发才，蠲疴不待更延枚。\n摐金广乐迷魂寤，蔽月飞云病膜开。\n宫鼠晦须抛赐琯，蓬鱼霏缕强晨杯。\n何人过问维摩室，定有文殊作礼来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中山公镇淝上","author":"宋祁","text":"长鬣生氂满帐前，甘棠载憩示优贤。\n簜函握节中军府，奎字成钩宝阁天。\n丹匕去寻鸿苑录，佛花来供净名禅。\n朝家入有三公拜，未信东山得久眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中山立秋","author":"宋祁","text":"峰云晓影破孱颜，万里风生结早寒。\n人在兜零烟外走，岁从鶗鴂口中残。\n槽花并滴添新酎，笥月兼轮掩故纨。\n白发光阴诚可惜，五年搔首望长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋新霁壕水初满自城东隅泛舟回谢公命赋","author":"宋祁","text":"斋舫谈经后，官池载酒行。\n斜阳鸟外落，新月树端生。\n清漾思江浦，夷犹绕郡城。\n东辕有遗恨，日日物华清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书怀 其二","author":"宋祁","text":"功成有意避斋坛，睨柱无瑕玉更寒。\n万里长风收戍旆，三年零雨拂归鞍。\n樽中酒美催高会，圯上书閒得细看。\n岁晏雪园宾盖少，要须枚叟奉馀欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书怀 其一","author":"宋祁","text":"颜徒陋巷不堪忧，日晏南荣拥敝裘。\n已识交情一贵贱，宁论书置自沈浮。\n争名在昔闻探穴，嗅饵何人肯直钩。\n强欲诛茆启三径，邑中无客继羊求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"予既到郡有诏仍修唐书寄局中诸僚","author":"宋祁","text":"一章通奏领州麾，诏许残书得自随。\n吾党成章真小子，官中了事是痴儿。\n昏眸病入花争乱，倦首搔馀雪半垂。\n所赖韦吴皆杰笔，刘生当见汗青期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云梦李使者","author":"宋祁","text":"关征盘错带南州，三见丹枫坠楚秋。\n列侍百重围虎戟，酣歌丈八忆蛇矛。\n草生宵梦传诗笔，梅析春酲托使邮。\n矍铄据鞍休自叹，壁门初日待鸣驺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元处宗安化簿","author":"宋祁","text":"军府沈千奏，边城佐一同。\n乡书黄耳远，客爨扊扅空。\n怨曙羌笳月，嘶寒代马风。\n未应期会急，平日废谈丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元会诗","author":"宋祁","text":"宝典丛三朔，中闱辟九阍。\n群臣深拱宁，列仗俨屯门。\n辇出东房秘，辰居北极尊。\n熊罴连案负，日月傍旗翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元会诗五首 其四","author":"宋祁","text":"阳秋履端月，象魏布和辰。\n解辫穹庐使，吹笙萍野宾。\n帝晖仍接昼，皇泽共成春。\n盛礼年年睹，祥祺日日新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元会诗五首 其二","author":"宋祁","text":"惟新兹首祚，倾祝乃祈年。\n光华无辍旦，先后不违天。\n贺牍纷陈几，祥图霭奏篇。\n南金照庑丽，涂玉截肪鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元夜观正阳锡宴","author":"宋祁","text":"云端峣阙下呼鞭，綵树遥分坐狄前。\n山戏百层平乐地，佛轮千影瑞陁天。\n祥风入助银花丽，宝月来供雉扇圆。\n献岁承平多乐事，击靴谁美唱唐年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"公会亭 其二","author":"宋祁","text":"吏罢得休沐，襟怀萧散中。\n静时飞蝶梦，閒处上皇风。\n稚筱因依碧，疏花磔索红。\n素餐无所事，天幸一衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"公会亭 其一","author":"宋祁","text":"日下炎氛歇，风生凉意添。\n树花閒纂纂，楼月静纤纤。\n倦绠仍垂缶，昏钩半上帘。\n畦瓜已堪摘，纳履自无嫌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"公园","author":"宋祁","text":"幽兴足端倪，危桥便见溪。\n浪轻鱼喜掷，山近鸟工啼。\n弱苇披风溆，凉蔬甲雨畦。\n使君来已屡，林下自成蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"友人书斋","author":"宋祁","text":"雩上鲜风拂袂过，讼庭谈树自婆娑。\n东家屋壁韦经绝，左氏门庭赋笔多。\n岫幌蟾蜍生夕露，墨池科斗动圆波。\n学诗梦草丰馀暇，万寿称觞醉弁俄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天街纵辔晚望","author":"宋祁","text":"夹道宫槐鼠耳长，碧檐千步对飞廊。\n虹桥不碍天河水，虎落遥遮禁苑墙。\n柳密试应胜暖吹，楼高都拟为残阳。\n尘轻雾重黄昏恨，半属翩翩马上郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太学建讲殿割王第西偏营置","author":"宋祁","text":"王家赐第曾开府，天子营宫此向儒。\n坏壁有经还阙里，废台无鹿叹姑苏。\n泉疑自涌供池溜，柱欲飞来荷栋桴。\n献岁成工观盛礼，愿陪希瑟趁风雩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太庙侍祠雪霁有作","author":"宋祁","text":"喜雪静氛埃，繁云即日回。\n清光动冠剑，馀素著楼台。\n树杂琼枝竦，途平玉辙开。\n惟应馀两骑，知是海神来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"少年","author":"宋祁","text":"关外车徒籍籍归，章街柳色绿如丝。\n薰衣别馆香三日，卜夜重楼烛九枝。\n雪市云回翻秘曲，蘅皋波暖寄微辞。\n十年酒美俄星弁，肯信尚书对有期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆上苑锡宴","author":"宋祁","text":"长怀禁籞宴嬉年，帐殿深沉望碧莲。\n秦地河流疑象汉，上林宫缭欲扪天。\n恩杯兰末流霞溢，跸道梧阴綷羽鲜。\n紫陌暮归人籍籍，汗帷挥雨杏粘鞯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遣吏视诸公茔树回有感 其四 文惠陈丞相","author":"宋祁","text":"岩廊号元老，礼数盛中台。\n万石父子贵，八元兄弟才。\n新诗玉可扣，奇隶鹊争回。\n今日看碑字，真缘洒泪来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月","author":"宋祁","text":"西颢凉飙度，金枢宿霭收。\n映波休混璧，入幔且迷钩。\n蚌冷侵珠润，罗疏逼帐秋。\n风流知不浅，庾令在江楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水声","author":"宋祁","text":"淙波声可爱，最与静相宜。\n激射不平处，潺湲无罢时。\n拥花含骤咽，碍石溅空危。\n便作山林趣，宁妨吏隐师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水亭","author":"宋祁","text":"地渍蚌衣接，天澄縠雾开。\n微风发琴籁，残月减珠胎。\n鸟散纤条动，鱼游细浪来。\n坐堂兼伏槛，恨乏楚人才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王君瑞秘丞同理青社","author":"宋祁","text":"诏押平明出未央，便随公府汎牙樯。\n即时趋坐多留帻，几夕登楼共踞床。\n胜国遗官沉雪雾，从军旧沼认莲房。\n翘材宴隙还家早，紫叶丛萱映寿觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王沂公挽词三首 其三","author":"宋祁","text":"翣路风号野，松阡水溢荥。\n滕君今见日，傅魄上骑星。\n诒训金籯满，图功籀史青。\n空嗟令君坐，千古掩馀馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王沂公挽词三首 其二","author":"宋祁","text":"下阁成忧疢，飞邮走诏医。\n遵鸿徒望渚，浴凤不归池。\n宣室君朝罢，翘车客涕垂。\n正应廊庙上，画一奉萧规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王沂公挽词三首 其一","author":"宋祁","text":"尽瘁辞当国，均劳得偃藩。\n幄中留秘画，天下满危言。\n日企还三事，宁图閟九原。\n谁将河海泪，一洒问乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王秀才贽赋乞诗为别归毗陵","author":"宋祁","text":"矩步敝长裾，清漳访病夫。\n得交欣凤举，赏赋怯霓呼。\n道胜稽论秀，人遐亟去都。\n一篷江上雨，归思满菰芦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见寄","author":"宋祁","text":"云梯叱马赋西征，满岁无功答盛明。\n收得桑榆真晚计，倚为箕斗是空名。\n瘢逢美玉终能治，曲诉幺弦久未平。\n壮思虽衰犹得在，一篇申甫为公成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长兄冬夕递宿偶成长句上寄","author":"宋祁","text":"绛帻鸡人唱夜筹，宿庐遥忖道山头。\n梦思园吏成羁寝，书掩冤家倦对雠。\n雨阁气昏莲蒂并，烛帘光动蒜条钩。\n孤吟一夕怀康乐，广陌黎明望紫骝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长安道中怅然作三首 其三","author":"宋祁","text":"城阙今安在，关河昔所凭。\n种祠秦故畤，抔土汉诸陵。\n花树圆排荠，楼云淡引缯。\n南山不改色，千古恨相仍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长安道中怅然作三首 其二","author":"宋祁","text":"兴亡作今古，事往始堪悲。\n宫破黄山在，城空北斗移。\n走冈寒兔急，啼戍暮鸦饥。\n灞岸重回首，惟馀王粲诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长安道中怅然作三首 其一","author":"宋祁","text":"三辅古风烟，征骖怅未前。\n山园蓬颗外，宫室黍离边。\n树老经唐日，碑残刻汉年。\n便须真陨涕，不待雍门弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东亭","author":"宋祁","text":"左圃鱼鳞阔，前轩翚翅开。\n虹将一雨罢，潮送万艘来。\n山净秋妍露，林虚晚籁回。\n此时萧散乐，谁奉醉言杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东晋","author":"宋祁","text":"仓卒浮江日，声名建号初。\n群臣让禁脔，上宰制单綀。\n气锐开桁战，心欢折屐书。\n纤儿竞撞坏，不念好家居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东湖禅院","author":"宋祁","text":"像阁缘云一水东，鹿园珍树蔽青葱。\n漂残劫烬神池浪，吹去菱花讲坐风。\n仙石拂衣寒起雾，层沙聚塔远凌空。\n赤髭净侣移谈久，牛首青烟匝篆红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兄长莒公赴镇道出西苑作诗有长杨猎近寒熊吼太液歌馀瑞鹄飞语警迈予辄拟作一篇","author":"宋祁","text":"宝楼斜倚阙西天，北转楼阴压素涟。\n白雪久残梁复道，黄头閒守汉楼船。\n尘轻未损朝来雾，树暖才容腊外烟。\n弭节不妨饶怅恋，待歌鱼藻记他年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兰轩初成公退独坐因念若得一怪石立于梅竹间以临兰上隔轩望之当差胜也然未尝以语人沈吟之际适髯生历阶而上抱一石至规制虽不大而巉岩可喜欲得一书籍易之时予几上适有二书乃插架之重者即遣持去寻命小童置石轩南花木之精彩顿增数倍因作长句书以遗髯生聊志一时之偶然也","author":"宋祁","text":"竹石梅兰号四清，艺兰栽竹种梅成。\n一峰久矣思湖玉，三物居然阙友生。\n赖得髯参令我喜，飞来灵鹫遣人惊。\n小轩从此完无恨，急扫新诗为发明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬夕酌酒","author":"宋祁","text":"艾夜更壶几沸残，尚持杯酒禦轻寒。\n半分沈令伤多瘦，数刻刘郎惜暂欢。\n天外月痕迷倦鹊，庭中霜气伴衰兰。\n接䍦不倒糟难藉，坐见丹煤委烛盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日呈应之","author":"宋祁","text":"宾席满浮埃，劳歌倦抚怀。\n囊风寒薄木，鹍雪夜平阶。\n庄室虚仍白，颜心静已斋。\n北山如借问，矫首谢丹崖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]