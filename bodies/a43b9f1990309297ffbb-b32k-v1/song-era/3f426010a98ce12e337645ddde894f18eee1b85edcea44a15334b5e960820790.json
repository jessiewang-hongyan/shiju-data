[{"title":"非雪","author":"何坦","text":"邹子当年吹玉律，解令寒谷暖生春。\n岂知此有冯夷宅，六月飞花冷扑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜂儿榧 其一","author":"何坦","text":"味甘宣郡蜂雏蜜，韵胜雍城骆乳酥。\n一点生春流齿颊，十年飞梦绕江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜂儿榧 其二","author":"何坦","text":"银甲弹开香粉坠，金盘堆起乳花圆。\n乞君东阁长生供，寿我北堂难老仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乞酿于郭伯瞻","author":"何坦","text":"洗盏试邀从事醵，卧罍忽报步兵厨。\n良辰不与清樽共，今夜傥羞明日无。\n未论一缸分雪乳，已拚千日醉云腴。\n宜黄漫尉今狂甚，听我酣歌入五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次张友使吴令君游石洞韵","author":"何坦","text":"二隽行阡得胜游，清诗传播气横秋。\n定知馀子漫千首，竟使老夫低一头。\n山是玉壶天里到，水从银汉罅中流。\n被渠吟作惊人句，压倒乾坤日夜浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题钓台","author":"何宗斗","text":"贫赋渔蓑却耐交，故人牵率政徒劳。\n十分拂袖归来是，何似当时莫去高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文昭园闻提壶有感","author":"何承矩","text":"马家公子好楼台，凿破青山碧沼开。\n啼鸟不知人事变，数声犹傍水边来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿公禅老游宴","author":"何昌弼","text":"不学参禅不学文，百年知乐任天真。\n曾闻神定踰三日，疑是今生再世人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题寿师塔南轩","author":"何执中","text":"焚修六七龄，内外已圆成。\n教相论因果，冥心契死生。\n纸窗应自白，花砌本无情。\n燕坐观浮世，谁非走利名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横塘道中","author":"何昌弼","text":"一舸凌风去，萦纡几度村。\n水清鱼引子，田美稻生孙。\n山近尘埃远，秋晴枕席温。\n悠悠迷处所，疑是武陵源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大涤洞天留题","author":"何林","text":"仙窟访龙君，开奁炷室薰。\n洞中天地别，物外圣凡分。\n古井流金水，空山锁白云。\n步虚声杳杳，疑向碧霄闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病鹤","author":"何若","text":"仙骨珊珊瘦怯风，缡褷晴晒石桥东。\n丹砂灵圃何缘觅，华表荒城半已空。\n羽化定教随子晋，舞衣久不悦羊公。\n听他盍旦鸣相乐，自此朝阳凤在桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"顶山寺","author":"何若谷","text":"百尺寒崖一径分，攀萝步步陟青云。\n江山好景吟新句，猿鹤欢声识旧群。\n壁为题诗尘不染，池因供砚水犹薰。\n旁人莫讶登科久，二十年前此论文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"何英","text":"羊肠有路地多险，马脊无人天一隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日田园杂兴二首 其一","author":"何鸣凤","text":"东风转瞩又东皋，久赋将芜力未薅。\n古木阴深巢燕弱，荒陂水浅怒蛙豪。\n儿痴方拟半栽秫，身隐尚嫌全种桃。\n何许蕨薇君欲采，饥眠堪羡华山高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大蓬山天宝碑","author":"何彦国","text":"谁向山阴谩刻镌，雨淋日炙隶文全。\n依稀记得升平事，天宝犹题十二年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"景福寺","author":"何彦国","text":"山留灌木冬长茂，岩抱阴云冻不开。\n沧海未乾徐福死，更于何处觅蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"何彦国","text":"暗量无限人间事，难概不平天下心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登第后作","author":"何拯","text":"自古■城继踵希，吾门多幸盛昌时。\n姮娥不惜蟾宫桂，从此何家第二枝。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大涤洞天留题","author":"何洞清","text":"落魄人间成谩老，足茧胼胝要闻道。\n掉头不向声利场，飘飘迥出风尘表。\n嗟嗟事事不惬怀，却喜因缘饱幽讨。\n登太华兮濯沧浪，云梦湫隘鲁邾小。\n既不责人求诸己，自信玄门穷妙理。\n虚室生白悟名言，坐见吉祥来止止。\n个中端的合乾坤，几道致柔若诸水。\n要须万里可参同，坐断孤峰空弃鄙。\n潜山霍山大涤山，天柱插云人莫企。\n痴狂取笑谁氏子，不以生生而死死。\n自知踪迹类闾丘，君家可是留前轨。\n枯藤拟待挂休休，莫使风雷暗催徙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪居夜月","author":"何洪","text":"茅屋濒溪只数椽，护篱黄犬枕莎眠。\n柴扉不掩松梢月，恐有山阴访雪船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千年古石","author":"何炳然","text":"怪底黄石公，乃是赤松子。\n蒲柳不自强，一见颡应泚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大涤洞","author":"何炳然","text":"杳默閟虚旷，森爽离人寰。\n玉室非所诣，回首烟中山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"右凤洞","author":"何炳然","text":"上作千仞翔，下作千岩栖。\n箫韶在何处，苍梧云气迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云根峰","author":"何炳然","text":"十洲仙子骑龙鹤，路阔云深贪舞跃。\n不知缥缈已无心，一朵飞来坠山脚。\n几度天风吹不开，数回山雨误飘来。\n直恐老龙招得去，千顷万顷游蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天柱峰","author":"何炳然","text":"终古郁岧峣，东南此撑柱。\n当时若更高，恐碍日月路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙洞","author":"何炳然","text":"胡髯抱嵌岩，白云拥万里。\n若弄华阳珠，我欲割左耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"何绛","text":"一江分两界，二寺对双蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吾庐","author":"何凉窗","text":"禹山山下是吾庐，坐处常安数卷书。\n族近弟兄相聚密，家贫朋友欲来疏。\n临窗种竹堪延鹤，向水开门可钓鱼。\n莫羡贵人连甲第，一生能得几时居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"双溪驿","author":"何恭直","text":"唐山山下双溪上，城堞参差图不成。\n已许开帘见山色，何妨攲枕听溪声。\n疏泉尚想前贤意，美俗犹存太古情。\n试向丹楼望原野，青青菖叶正催耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"籍桂堂","author":"何称","text":"清溪一百曲，洗我心无尘。\n日影上汀渚，桂香袭衣巾。\n露零芳更润，山沃叶长春。\n种德长如昔，他年更几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"臞庵 其五","author":"何称","text":"沙暖鸳鸯困，江寒翡翠愁。\n红莲秋的历，短棹晚夷犹。\n处世长无累，端居百不忧。\n时时明月下，横笛倒骑牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"臞庵 其四","author":"何称","text":"霜落川原淡，风高木叶丹。\n云垂千顷白，月堕一江寒。\n礼佛因成塔，焚香旋筑坛。\n竹声过小院，杂佩响珊珊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"臞庵 其三","author":"何称","text":"柳外长虹卧，江边小市圆。\n水摇千嶂影，窗纳五湖天。\n隔岸谁家圃，开帆何处船。\n非关台榭好，此地最堪怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"臞庵 其二","author":"何称","text":"地占松江胜，为园不种瓜。\n幽深清磬响，高下石栏斜。\n花密蜂随蝶，林深雀啅蛇。\n胜如摩诘画，不是季鹰家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"臞庵 其一","author":"何称","text":"多羡王居士，心閒事事幽。\n山从天末见，江近枕边流。\n春圃千葩秀，霜林百果收。\n更能穷物理，濠上看鱼游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兰坡","author":"何耕","text":"兰与高人臭味同，含薰聊复待清风。\n纷纷萧艾无相笑，尔辈敷荣转眼空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙华大像盖冀国夫人所作因成二绝 其一","author":"何耕","text":"慧性元从戒定薰，百花潭水洗僧裙。\n个中力量真超绝，故老尚传娘子军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙华大像盖冀国夫人所作因成二绝 其二","author":"何耕","text":"生男个个欲如狼，妇女军中气不扬。\n试问争功嗔目士，几人能敌浣花娘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论俗诗四首 其四","author":"何耕","text":"伤人利己事多端，唆讼尤为第一般。\n二竞力疲俱愿息，中人未了又经官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论俗诗四首 其三","author":"何耕","text":"写状唆人去入官，入时容易出时难。\n引人平地破家产，他在傍边冷眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论俗诗四首 其二","author":"何耕","text":"他侵我界是无良，我与他争未是长。\n布施与他三尺地，休誇谁弱又谁强。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"论俗诗四首 其一","author":"何耕","text":"时间忿怒便行拳，招引官司在眼前。\n下狱戴枷遭责罚，更须枉费几多钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学射山相传蜀后主刘禅习射于此因以得名有感二作 其二","author":"何耕","text":"修明国政保关山，岂在驰驱纵送间。\n空使流人登剑阁，向风长喟笑庸孱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学射山相传蜀后主刘禅习射于此因以得名有感二作 其一","author":"何耕","text":"苦无雄略但儿嬉，尚想山头学射时。\n忽报阴平鱼贯入，可怜一镞不能施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"段文昌读书台 其一","author":"何耕","text":"段公曾此读群书，读破应须万卷馀。\n家礼一传为杂俎，稗官收拾附虞初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"段文昌读书台 其二","author":"何耕","text":"陇麦渐渐满意青，只忧春旱起蟊螟。\n当年人诵祷而雨，合向兹山试乞灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莲塘","author":"何耕","text":"色香无比出西方，何物妖狐号六郎。\n手折一枝聊供佛，前身定是老柴桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"假山","author":"何耕","text":"空庭幻出小嶙峋，假外应须别有真。\n只恐话头成两橛，若为融摄主和宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题长松二首 其一","author":"何耕","text":"老桧摇风万壑声，梨花著雨四山明。\n龛中大士好看客，排遣云阴作晚晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"成都即事","author":"何耕","text":"零落红成阵，扶疏绿结帏。\n简书留客住，风雨卷春归。\n是处羁怀恶，浮生乐事希。\n锦江拚尽醉，欲典却无衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自合江亭过渡观赵穆仲园亭","author":"何耕","text":"唤舟芳草渡，系马绿杨阴。\n步入莓苔径，门开花竹林。\n王孙随牒远，婺女隐云深。\n想见西南望，悠悠空赏心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"远色阁","author":"何耕","text":"小小楼居著散仙，渊明真趣本幽然。\n招呼云月栏干曲，顾揖江山拄杖前。\n独鸟倦归翻落日，谁家晨爨起炊烟。\n根尘应接无留碍，笑杀胡僧面壁禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日 其五","author":"何耕","text":"唇齿辅车势，坤维井络方。\n只宜花柳盛，莫遣鸟鱼忙。\n陇麦无由食，边筹是可防。\n出言还有禁，忍泪下成行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日 其二","author":"何耕","text":"寂寞城南寺，三年寄索居。\n折花修佛供，持钵乞僧馀。\n竟日无车骑，依时认鼓鱼。\n九衢尘一尺，吾自有华胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日 其四","author":"何耕","text":"万里桥边水，朝宗去入吴。\n衮衣新历数，神算旧规模。\n四澥从心正，诸公著力无。\n际天东望眼，淼淼但平芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日 其一","author":"何耕","text":"闻道西楼下，香风飏绮罗。\n无钱沽酒得，不醉奈愁何。\n老去春缘薄，慵来睡兴多。\n闭门终一枕，亦不梦南柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浮翠桥","author":"何耕","text":"隔溪苍翠各西东，架竹为梁路始通。\n缺月罅林凝净绿，断霞明水抹残红。\n芒鞋步步幽深处，藜杖声声屈曲中。\n回首忽惊桥已远，泠然身御圃田风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒碧亭","author":"何耕","text":"凭栏日日俯清湍，洗竹年年斩恶竿。\n十顷玻璃秋色静，一林竿籁晓声寒。\n凉风有意生天末，明月无边照水端。\n谁谓过清难久处，愚溪元自不相安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题长松二首 其二","author":"何耕","text":"路穷山百转，云拥木千章。\n蕞尔人间世，萧然古道场。\n龙神森拱卫，旱魃走祈禳。\n地远斋厨薄，重来剩裹粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题龙华山寺","author":"何耕","text":"杰阁山为佛，精庐地布金。\n水涵空阔净，路绕翠微深。\n鸟下窥斋钵，龙归识梵音。\n城中尘眯目，那得此幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月二十七日侍二老人出万里桥游宝历寺谒五丈天王至合江亭登小舟往来江中日晚出舟憩卧柳亭以归记所见","author":"何耕","text":"城中少乐事，日日走尘土。\n因循嘉节过，春物遽如许。\n驾言游近郊，及此新过雨。\n梨花雪飘零，麦脚浪掀舞。\n伤心梅已叶，慰眼杏初吐。\n荒凉入古寺，迢递行两庑。\n耽耽巨入阁，擐甲硕且武。\n出门诣支径，信马踏江浒。\n小舟呼未至，危亭憩方午。\n长江渺无际，远岫明可数。\n舟中更奇绝，一视隘天宇。\n深流风浩荡，浅岸石龃龉。\n水凫贞自适，修竹不知主。\n摇摇打鱼艇，丁丁造船斧。\n林疏见官道，路转失前浦。\n奇观非一状，四面皆可取。\n斗酒不妄倾，佳处辄自举。\n杯盘渐狼藉，野蔌旋烧煮。\n夷犹兴未尽，落日挂村坞。\n归涂绕城隈，醉眼迷处所。\n卧柳久知名，败屋费撑拄。\n轻盈楚宫样，何事腰伛偻。\n临风发浩叹，空响答人语。\n吾亲俱老矣，君羹未尝睹。\n聊为半日乐，少慰一生苦。\n馀年愿长健，綵服看儿女。\n此外吾何求，穷通任天与。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙渊","author":"何耕","text":"门前大江河渺漫，昔人饮牛水为乾。\n水乾龙逝亦其理，近在咫尺聊泥蟠。\n鱼暇玩侮妩獭笑，纵有灵怪谁当看。\n德人问舍压我境，便尔筑室相遮栏。\n坐令异类皆屏伏，恃有此耳差少安。\n却纡朱绂去监郡，遣我守舍良独难。\n昨来过门恍如梦，龙致此语催归鞍。\n先生不信反不笑，谓我饶舌狂丰干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忘机台","author":"何耕","text":"太虚生微云，机事日夕繁。\n兼忘岂不佳，尚有忘者存。\n稽首老庞翁，妙处布一言。\n请观台上月，万古无昭昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵溪赋双流郭信可隐居","author":"何耕","text":"幽居定何如，颇恨未见之。\n主人向我言，喜色融双眉。\n修篁流翠阴，寒溪漾清漪。\n领略非一状，幽妍发馀姿。\n空濛雨亦佳，潋滟晴更奇。\n岂惟二江独，意恐两蜀稀。\n主人信妙士，得此固所宜。\n天公閟好景，授受各有时。\n岂无多田翁，偃蹇逝莫随。\n素交怀老蒲，秀句纷珠玑。\n安得招归来，为君赋清诗。\n往者不可作，后生欲何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和光亭","author":"何耕","text":"枯木倚寒岩，三冬无暖气。\n达人定汝笑，胸中太泾渭。\n不妨声色海，径造佛祖地。\n所以亦乐翁，花前时一醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青羊宫","author":"何耕","text":"一再官锦城，咫尺望琳宫。\n未始得得来，正望役役中。\n今朝弄晴雨，策蹇随春风。\n颇爱意象古，停骖小从容。\n缥缈百尺台，突起凌半空。\n凭栏俯修竹，决眦明孤鸿。\n信哉神仙宅，不受尘垢蒙。\n稽首五千言，众妙一以通。\n静观万物复，岂假九转功。\n区区立训诂，亦哂河上公。\n痴人慕羽化，心外求鸿濛。\n要附白鹤背，往访青羊踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日 其三","author":"何耕","text":"门前无俗物，城上亦奇观。\n花浪东流稳，云山西望寒。\n身凌尘外远，目极意中宽。\n最爱风标客，晴沙理青纨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留隐庵老住碧芦轩","author":"何耕","text":"庵中之人不见形，两脚不住以隐名。\n此行有似风过海，摸索不著闻其声。\n浣花江头万僧市，抵掌笑谈儿辈惊。\n一轩碧芦佛手种，霜叶戚戚如诗鸣。\n此间谓是留凤处，但恐还作冥鸿征。\n卷衣我亦逐师去，分取半庵栖月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]