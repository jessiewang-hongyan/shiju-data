256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吕兴元 其二","author":"李新","text":"梯天悬阁马行空，旌旆悠悠照谷红。\n灵凤阴寒春过晚，万山犹有牡丹风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吕兴元 其三","author":"李新","text":"冰壶旧映蓝溪玉，璧乘曾依白帝城。\n明日武林山下路，过桥唯有杜鹃声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吕兴元 其一","author":"李新","text":"身离梁苑初蚕月，脚蹈秦云已麦秋。\n要见使君恩惠久，滔滔长伴汉江流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吕兴元 其六","author":"李新","text":"行入云衢路未通，主人明日复观风。\n几声寒鹊江村暮，烟雨潇潇失去鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吕兴元 其五","author":"李新","text":"雾豹平时岂一班，定将清对领威颜。\n东南民病知多少，莫把皇华误出关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吕兴元 其四","author":"李新","text":"太平天子事东封，洛苑回銮访侍中。\n自古相门终出相，试持圭璧近重瞳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张少卿赴召十首 其十","author":"李新","text":"倾倒怜才出至公，吹嘘牙颊自春风。\n宽和肯问车裀吐，涵养须知内史聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张少卿赴召十首 其九","author":"李新","text":"龙蛇飞动从椽笔，昔看公孙舞剑来。\n何得却知颠草妙，为随宾客到金台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张少卿赴召十首 其八","author":"李新","text":"谁将蜀柳赠行人，曾伴灵和殿下春。\n笑煞后来门下客，风流不似乃翁身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张少卿赴召十首 其七","author":"李新","text":"光芒先已动台躔，子舍修书正妙年。\n奏对八砖看白日，文章万选敌青钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张少卿赴召十首 其六","author":"李新","text":"燕子楼成月满栏，缕金衣就酒翻澜。\n从前乐府知多少，再到东山记谢安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张少卿赴召十首 其五","author":"李新","text":"天子清閒问侍臣，当年张姓复其名。\n金瓯已洒银钩字，庭下宣麻不用惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张少卿赴召十首 其四","author":"李新","text":"公子诗成轻万户，将军诺重过千金。\n不烦县令前驱去，回采坚珉刻醉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张少卿赴召十首 其三","author":"李新","text":"张公论事力回天，明日延英席自前。\n秦甸江西劳马策，此回不计地流钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张少卿赴召十首 其二","author":"李新","text":"四海倾瞻调鼎手，朝廷侧席待伊周。\n江城父老休遮道，可是星车肯少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张少卿赴召十首 其一","author":"李新","text":"初排阊阖欲朝天，流电追锋急召贤。\n延阁凤池风月好，不须回首望筹边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送牡丹与赵元思","author":"李新","text":"祇许青松约岁寒，姚黄魏紫偶盈盘。\n晨妆休插无盐鬓，送与文君卷帐看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]