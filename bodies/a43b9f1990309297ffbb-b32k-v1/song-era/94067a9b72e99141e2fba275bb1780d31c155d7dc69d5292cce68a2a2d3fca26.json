[{"title":"次韵池上暮雨","author":"朱继芳","text":"湿遍栏干欲倚休，手中团扇渐知秋。\n细声合作檐间溜，大点漂成水面沤。\n小小竹窗醒倦鹤，疏疏荷屋冷栖鸥。\n渔翁蓑笠随身在，立到黄昏钓未收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李黄州江淮伟观","author":"朱继芳","text":"槛前卷箔见晴峰，夏口武昌西复东。\n三国六朝襟带地，孤城四水鼓鼙中。\n女墙夜送淮山月，老树秋生梦泽风。\n君作此堂心万里，应怜世上少英雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵桥亭禊事","author":"朱继芳","text":"圯上还成集禊亭，杉松自古草仍新。\n彩虹卧饮流杯水，白鹭飞迎入座宾。\n俛仰已成今昔事，东西更看往来人。\n聚蚊金谷皆安在，若见吾徒合主臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵野水花朝之集","author":"朱继芳","text":"睡起名园百舌娇，一年春事说今朝。\n鞦韆庭院红三径，舴艋池塘绿半腰。\n苔色染青吟屐蜡，花风吹暖弊裘貂。\n主人自欠西湖债，管领风光是客邀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江湖伟观","author":"朱继芳","text":"吴山表里水为池，百有馀年壮帝畿。\n天目旧将双凤下，海门新拱六龙飞。\n胥涛白雪生秋思，太乙红云驻夕晖。\n江上沙鸥湖上舫，柳丝风里两依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老将","author":"朱继芳","text":"不把雕刀卖，曾随夜斫营。\n老年犹善饭，壮日想能兵。\n上马身仍健，看鸿眼更明。\n战多人不信，枉指箭瘢呈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟到梅雨暴涨","author":"朱继芳","text":"夜月离于毕，篙师可奈何。\n帆穿风减半，江阔雨添多。\n侧岸无牵路，中流有旋涡。\n平生柂楼底，得在柳梢过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖别业","author":"朱继芳","text":"寥寥湖上趣，大似水云僧。\n故国经年梦，寒窗独夜灯。\n鞭声争辇道，月色淡觚棱。\n一觉平明睡，都人却未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"严衢道中","author":"朱继芳","text":"草白三丫路，苔青五里牌。\n长年车马客，几两利名鞋。\n斗籴随时贵，方言到处乖。\n近山樵有主，童稚拾松钗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听白云寺清师琴","author":"朱继芳","text":"古寺沉沉昼日长，泠然清响发僧房。\n昭君别去颜如玉，苏武归来鬓已霜。\n山水无端言尔志，炭冰何事置吾肠。\n老来却爱虚檐外，雨滴梧桐一味凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿尚书意一先生","author":"朱继芳","text":"天上麒麟地上行，当年孔释送徐卿。\n重来司马儿童喜，初见欧阳老婢惊。\n黄道日开经幄霁，紫垣星近履絇明。\n本朝宝筴千千岁，惟读书人共太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵芝寺","author":"朱继芳","text":"黄金匝地小桥通，四面清平纳远空。\n云气长扶天子座，日光浮动梵王宫。\n残碑几字莓苔雨，清磬一声杨柳风。\n沙鸟不知行乐事，背人飞过夕阳东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈令君增诚斋三三径为十二径次韵","author":"朱继芳","text":"四家三径各风流，今古悠悠貉一丘。\n拍瓮新篘浮腊腻，绕堤老柳弄春柔。\n日边黄纸催人去，霞外青山听鹤留。\n若问西畴蓑笠事，合还陶令一孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刺桐","author":"朱继芳","text":"刺桐依客舍，晴绿上窗纱。\n昨夜还飞叶，来时未作花。\n鸦寒惊月色，人老惜年华。\n今度逢摇落，归心一倍加。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和政和颜令君韵","author":"朱继芳","text":"恰百年馀得县名，从前官长是谁清。\n鱼鲑市小通蛮远，鸡犬村深见吏生。\n过客莫嗔厨传冷，家人方喜俸钱轻。\n却愁明日朝天去，不得黄紬饱五更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和秋房题半湖楼二首 其二","author":"朱继芳","text":"四明仙客此楼居，毕竟西湖压鉴湖。\n曾谓家童欺贺老，不如沙鹤认林逋。\n蒲根钓水知深浅，柳外行人乍有无。\n此景天公厌多取，只分一半与吾徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和秋房题半湖楼二首 其一","author":"朱继芳","text":"天目飞来第几峰，峰前著屋贮虚空。\n湿云低亚钩栏角，缺月斜窥户牖中。\n一水东西添柳岸，两山南北欠樵风。\n住家欲作千年计，顷刻阴晴便不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚戌寿意一先生","author":"朱继芳","text":"江涵秋色碧潭潭，饮马胡儿不敢南。\n宥密老臣功第一，缉熙天子岁登三。\n身扶紫极星辰正，手拆黄封雨露甘。\n见说年来淮尾涨，汉庭可要百曹参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"松泽西亭","author":"朱继芳","text":"高人太多事，寒夜本无鱼。\n船子今何许，泾流只似初。\n白蘋秋浩荡，黄叶晚萧疏。\n更有斯亭在，乾坤一草庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苕溪","author":"朱继芳","text":"维舟古祠下，野饭就鱼羹。\n坐听篙人说，行逢牵路平。\n居民难问姓，溪鸭自呼名。\n天目无由到，沿洄更几程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客路","author":"朱继芳","text":"闺閤空相忆，那知客路艰。\n背人前去鸟，迎面远来山。\n夜泊孤灯悄，晨装片月弯。\n猿声不知处，杳杳白云间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚有感","author":"朱继芳","text":"坐对吴山酒，闲同越客吟。\n月明人渡浅，花暗鸟啼深。\n往事空流水，还丹未化金。\n不堪春又晚，惆怅百年心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春游","author":"朱继芳","text":"雨过青青草，湖边信马蹄。\n夕阳沙路远，春水板桥低。\n柳暗渔人屋，花香燕子泥。\n摩挲酒家壁，留著醉时题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昭庆寺","author":"朱继芳","text":"幽寻得胜趣，城市几人能。\n古柳深中磬，长廊尽处灯。\n画龙听说法，塑佛看斋僧。\n别寺经行遍，兹游昔未曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋风","author":"朱继芳","text":"秋风欺病客，力气复何如。\n发短丝无数，衣宽带有馀。\n见人慵作礼，闻雁强裁书。\n门外生秋草，呼童不要除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送人之武昌","author":"朱继芳","text":"秋风吹落叶，君作武昌游。\n只道从军乐，那知别路愁。\n寒暄楚岫色，日夜汉江流。\n大阃多珠履，无为弹蒯缑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李敬则之升扬","author":"朱继芳","text":"江北江南一叶舟，凭将往事问东流。\n锦帆月冷琼花夜，绮阁风高玉树秋。\n杜牧三生开笑口，刘郎五绝掉吟头。\n淮山眼见诗人惯，高筑诗坛汗漫游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧蘋洲游醉李","author":"朱继芳","text":"师今游醉李，自刺钓船篙。\n地说三吴胜，人夸二陆豪。\n草黄工女绩，波白课丁熬。\n近海寒应早，霜毛怯剃刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽芸居","author":"朱继芳","text":"不得来书久，那知是古人。\n近吟丞相喜，往事谏官嗔。\n身死留名在，堂空著影新。\n平生闻笛感，为此一沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽周伯弜","author":"朱继芳","text":"今日忽不乐，散行湖水滨。\n有怀天下士，遽作梦中人。\n醉语惊天地，狂歌哭鬼神。\n九原如可赎，那不百其身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旅馆","author":"朱继芳","text":"仆行方请息，旅馆复相招。\n小市三家聚，前村五里遥。\n茅柴侵熟饮，松叶带生烧。\n犹有斜阳在，行吟忽断桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桐江舟夜","author":"朱继芳","text":"荡桨入虚碧，星河俱动摇。\n前村渔火近，别浦雁声遥。\n对景知明月，回头得暗潮。\n桐庐在何许，江路夜迢迢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"航海","author":"朱继芳","text":"地角与天倪，茫茫何处期。\n星回析木次，日挂扶桑枝。\n沉石寻孤屿，浮针辨四维。\n飘然一桴意，持此欲安之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钱塘江","author":"朱继芳","text":"极浦无高树，苍茫只远空。\n潮来江水黑，日出海门红。\n两岸东西浙，千帆来去风。\n中原山色外，残梦逐归鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜花","author":"朱继芳","text":"留春春不住，春去落花随。\n枉自收残片，何堪缀旧枝。\n轮蹄前日约，蜂蝶一年期。\n代谢由来事，谁能作许悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梨山庙","author":"朱继芳","text":"无处著诗名，梨山万古青。\n人间留此像，天上作何星。\n祝史祠神醉，骚人谒梦醒。\n当时青紫楦，曾有许精灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明","author":"朱继芳","text":"饧面留寒不肯浓，一年春事看成空。\n人歌人哭清明日，花落花开昨夜风。\n薄薄絮泥行燕子，深深茭荡出凫翁。\n西泠桥上多车马，有底狂驰百岁中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖荡","author":"朱继芳","text":"双桡入天影，野葑绿全交。\n鱼唼垂丝柳，鸥眠折叶茭。\n行人沿岸曲，落日挂林梢。\n归去严城隔，僧门尚可敲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登眺","author":"朱继芳","text":"破帽任风吹，天知发已丝。\n大江流禹迹，老树见秦时。\n北际山如砺，南溟水似池。\n夜凉无梦到，久矣叹吾衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新秋杂兴","author":"朱继芳","text":"晚烟起处是孤村，漠漠郊原白道分。\n菰叶池塘疏雨过，豆花篱落夕阳曛。\n远山空阔围天在，邻杵丁东带雁闻。\n独自寻诗风满袖，不知身入白鸥群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪寺","author":"朱继芳","text":"背人沙鸟一行斜，唤客桐鱼几叠挝。\n误向山中参白足，不知头上著乌纱。\n煮茶烟暖浮新竹，洗钵泉香带落花。\n过夏功劳眠与食，谁能展卷看楞伽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春","author":"朱继芳","text":"姚黄魏紫恼人看，罗袜成尘俛仰间。\n蜀魄声乾花有血，湘灵泪尽竹无斑。\n年光冉冉趋双鬓，暮雨霏霏失四山。\n老里情怀天地窄，莫教一日酒杯闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题飞来峰","author":"朱继芳","text":"元是西天住，飞来莫去休。\n未凭仙佛国，好似帝王州。\n彼树亦如寄，吾生应更浮。\n白猿呼不应，松露滴猕猴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题丘芳仲月林","author":"朱继芳","text":"阿姊种婆娑，秋风奈若何。\n人间千树少，天上一枝多。\n安得仙槎客，携将玉斧柯。\n和根都斫却，还我旧山河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠日者","author":"朱继芳","text":"乌兔走双丸，谁将手控抟。\n短长三万日，好丑百千般。\n数远谈何易，天高问却难。\n送君寻富贵，我命不中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠西蜀冯道士","author":"朱继芳","text":"峨眉山月照清溪，中有方瞳一羽衣。\n拄杖经行天下半，丹砂乞与世人希。\n千年城郭空归鹤，万里山河自落晖。\n安得与君游汗漫，乘槎一问女星机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠续芸","author":"朱继芳","text":"谁谓芸居死，馀香解返魂。\n六丁将不去，孤子续犹存。\n科斗三生债，蟫鱼再世冤。\n向来诗作祟，挥涕对人言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天竺分韵得芳字","author":"朱继芳","text":"缥渺白云乡，天风吹晓凉。\n人寻水源至，路入树阴长。\n昼静闻晴哢，春馀拾涧芳。\n余心忽有得，欲语又还忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行路难赠萧坦翁","author":"朱继芳","text":"行路难，居不易，旋买生柴煮一字。\n三千风月不直一杯水，何用狂吟动天地。\n君不见陆天随，忍穷读书白眼屠沽儿。\n又不见孟东野，载少于车车是借。\n丈夫吐气摩星斗，六印黄金真唾手。\n莫吟诗，诗能穷人君不知。\n古人坐诗穷到骨，今人方笑古人痴。\n又闻夜半舟移壑，却叹东门黄犬华亭鹤。\n人生短长无百年，富贵未必如贱贫。\n富贵贱贫何足据，出门总是亡羊路。\n居不易，行又难，况是长安十二门。\n相逢一笑岂易得，莫惜床头沽酒钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冷泉亭","author":"朱继芳","text":"白猿弄清泚，秋入山骨冷。\n老僧怯凭栏，忽失袈裟影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沧浪风月","author":"朱继芳","text":"我登沧浪亭，复歌沧浪曲。\n歌竟复长歌，杳杳山水绿。\n天风吹散发，山月照濯足。\n为谢独醒人，渔家酒初熟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其一 边庭","author":"朱继芳","text":"年年塞草欲秋时，左右红旗说战机。\n介胄粗官应有语，而今宰相好吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其二 边庭","author":"朱继芳","text":"角声吹裂肺肝愁，说与将军莫逗留。\n男子生当侯万里，死判马革海西头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其三 农桑","author":"朱继芳","text":"淡黄竹纸说蠲逋，白纸仍科不稼租。\n努力经营犹恨晚，官司那问有钱无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其五 负薪","author":"朱继芳","text":"有薪可卖未须悲，满百青铜况有奇。\n十指束枯从秃尽，不堪棘刺罥人衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其六 负薪","author":"朱继芳","text":"天寒气入鼻中辛，竹檐弯弯却恋身。\n卖得钱来回首望，蜡烟起处属何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其二 城市","author":"朱继芳","text":"雀罗门巷昔趋荣，味似饧甜忽变辛。\n说与侯门休谢客，朝朝暮暮看人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颜长官百咏 其五 城市","author":"朱继芳","text":"紫陌寻春日日过，杨花无主奈春何。\n倾城压酒娇无力，醉里相扶踏踏歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李秋堂赴京口酒人","author":"朱继芳","text":"客怀正赖春相与，苦欲留春天不许。\n送君一舸下南徐，落花起舞流莺语。\n鲛人浴出扶桑茧，天女染作红云段。\n君从何处得锦机，借与人间为样看。\n青杏园深暖漏长，柳绵如雪扑酒缸。\n吴姬道字未端正，当垆学唱新番腔。\n貔貅百万张颐仰，都将铁瓮盛春酿。\n有客高谈四座倾，主人合序诸侯上。\n日边此别各南北，君颐始髭我衰白。\n何以赠之折柳条，千丝万丝心摇摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"栽松道者像","author":"朱继芳","text":"手便筇杖冷，脚厌芒鞋紧。\n两袖吹松风，东冈复西岭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃源官罢芸居以唐诗拙作赠别","author":"朱继芳","text":"自作还相送，唐诗结伴来。\n归装携此重，笑口为君开。\n莲上巢难稳，桃边艇却回。\n空馀吟卷在，沙鸟莫惊猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读黄玉溪汤婆传","author":"朱继芳","text":"君不见汤家阿泉骊山阴，出入宫掖承恩深。\n只流妃子脂粉气，不暖少陵如铁衾。\n又不见汤家阿池紫塞上，沉香雾拥将军帐。\n天寒十指堕弓刀，底用空言如挟纩。\n何如韩时老汤婆，冬则饮汤惟腹皤。\n形模混沌妇女笑，闭塞其兑藏天和。\n老生门前十日雪，两脚冻皴眠不得。\n断无蛮素构心兵，赖有婆兮相暖热。\n夫人竹氏青玲珑，炎炎几时奈秋风。\n婆耻居下常热中，毋弃憔悴以御冬。\n得黄太史五字诗，厥孙传之尤滑稽。\n霜风萧萧岁年晚，吾喜汤婆有完传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮客","author":"朱继芳","text":"长淮万里秋风客，独上高楼望秋色。\n说与南人未必听，神州只在阑干北。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中僧虚舟来","author":"朱继芳","text":"雪中闻犬吠，清卧起来迟。\n开户千山白，逢僧一个缁。\n言从风絮里，忆得雨花时。\n寒舍无祗待，煎茶且说诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸿","author":"朱继芳","text":"鸿飞九天上，人在平地望。\n尘土与青云，其间能几丈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"意行桥","author":"朱继芳","text":"我行且奚适，兴尽忽自返。\n倒影射清漪，回光在桥板。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋五嫂鱼羹","author":"朱继芳","text":"柳下白头钓叟，不知生长何年。\n前度君王游幸，卖鱼收得金钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔翁","author":"朱继芳","text":"渔翁家在何许，惯宿芦花不归。\n昨夜江村欲雪，百钱买得蓑衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]