[{"title":"次韵寺丞叔都城喜雪","author":"李洪","text":"东郊初未布阳和，湖上祥霙点渌波。\n重璧台遥黄竹作，孤山园近落梅多。\n表仪共仰丰年玉，赋咏宜陪赓载歌。\n谁忆渔舟向西塞，千山径绝独披蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陆子望欲假家集","author":"李洪","text":"先子词科蚤擅场，中兴首擢紫微郎。\n涌泉制册留纶阁，砭世膏肓有皂囊。\n北斗仰之千古事，泰山所集一毫芒。\n楹书拂拭增悲恸，追诵龙蛇感卒章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵陆元量见寄","author":"李洪","text":"醉别壶中太乙天，寥寥云海已经年。\n倦游复索长安米，壮志宁求负郭田。\n一岁九迁看布武，千岩万壑莫留连。\n同时僚旧重相遇，幸有蓬瀛列二仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵林子长岩桂","author":"李洪","text":"凉入千岩趣更幽，广寒月府恍神游。\n断崖流水韵清古，冷雨凄风声凛秋。\n要补离骚衙宋玉，岂期仙袂挹浮邱。\n却思胜集湖边寺，搴取芳枝镇日留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵施少路春日","author":"李洪","text":"拂面和风喜及辰，宫幡未赐岸乌巾。\n冰消水泺箫韶韵，雪过湖漘茝若春。\n诗律自怜心尚在，宦情难与世趋新。\n从兹排比寻芳计，况是湖山旧主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵秋日遣兴","author":"李洪","text":"西风暑退喜清秋，倦客漂流沧海头。\n用舍行藏知有命，山林钟鼎岂能谋。\n汗青漫志三馀乐，养素宁忘一溉收。\n鹏鴳逍遥天壤内，何劳八极赋神游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵曾仲躬初入雁荡","author":"李洪","text":"阡陌经行早布春，承明天语耳亲闻。\n诗情本自凌康乐，墨妙何劳法右军。\n雪后西岑山竞秀，潮来孤屿浪中分。\n萱堂扁榜名仁寿，雁序娱亲羡使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵德孚咏梅","author":"李洪","text":"徙倚名园锁绿苔，亭亭冰艳为谁开。\n乍疑奔月常娥去，忽见寻梅僧孺来。\n浅笑故应窥水镜，片飞看复落深杯。\n王孙家有雪儿唱，莫待霜天晓角催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵薛士昭琴室","author":"李洪","text":"抗志青霞上，高情复见今。\n五言冠诗眼，三叠玩琴心。\n世业含香地，传衣翰墨林。\n朝端方吁俊，正始有遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至日宿蓝田驿感旧","author":"李洪","text":"至日天涯感慨同，曾陪鸳鹭大明宫。\n催班别殿春雷绕，驻辇蓬莱晓日红。\n耸听鸣鞘驰魏阙，欢传放仗醉新丰。\n谁知独木荒村里，扇影炉烟入梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至东林谒回仙人像","author":"李洪","text":"罨画溪山杳霭中，为寻遗事访禅宫。\n回嵓故迹依然在，渭水非熊恍似空。\n绿薜侵衣馀手泽，遗榴辉壁想仙风。\n溪边东老家何处，尚有孙礽话乃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至后二日至东禅","author":"李洪","text":"至后阳和已发生，野梅官柳动诗情。\n偶为寻壑经邱计，故作穿云渡水行。\n近郭好山皆可隐，隔林疏磬有馀清。\n他时粗免微官缚，归去深谋谷口耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过东里","author":"李洪","text":"林迥苍烟古，篱疏橘柚黄。\n天高风落木，岁晏稻登场。\n无复老盆饮，空馀邻笛伤。\n征鸿摩晓月，铩翮犯严霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过瑞林院","author":"李洪","text":"薄暮丹洋宿，嵌岩下百层。\n饥鸢鸣独木，鼯鼠抱寒藤。\n坏屋惟馀佛，空廊不见僧。\n古人经世志，客寝每宵兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯封书中叙去岁七夕之乐因寄","author":"李洪","text":"去年此夜对芳樽，今日栖栖叹失群。\n茅屋只馀灯伴我，酒炉应有月寻君。\n愁将从事青州去，风共禅师白足分。\n料想紫梅溪上客，也应回首一看云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伯封同游霅上事毕遽索别次韵","author":"李洪","text":"同来我复似邹游，新咏君应胜杜秋。\n已饫蒸葫汝南馔，盍为粗粝浣花留。\n残樽且醉菖蒲酒，去棹聊停杜若洲。\n不厌村居能少驻，兰香万斛顿销愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余寓王园适当春残尚有小桃临水追想昔时繁丽无复存者借仲信桃花韵","author":"李洪","text":"兔葵摇曳雨濛濛，尚有夭桃出旧丛。\n轻簿不禁三月浪，飘零常恨五更风。\n燕泥乱啄粘香蕊，渔艇犹疑趁落红。\n惆怅眼前兴废事，灵云今已悟真空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初冬见雪","author":"李洪","text":"颇怪寒威一倍添，天花回旋落层檐。\n慵赓险韵偏工絮，自哂微官独带盐。\n问讯梅梢半封萼，争看蝶舞不钩帘。\n小儿学诵封胡句，羔袖烘炉任附炎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初陪扈从","author":"李洪","text":"紫禁晨曦拂晓开，南山秀色郁崔嵬。\n立班驰道苍龙阙，逼耳嵩呼绕殿雷。\n清跸一声黄伞动，屯云万骑景舆回。\n端门缓辔哦诗罢，误入钩陈豹尾来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别吴兴从游","author":"李洪","text":"五亭四水盛游从，閒客閒行兴每同。\n暂舍玄真渔隐计，却寻康乐旧诗中。\n振衣濯足沧浪水，快意迎人舶?风。\n傥有任公投巨犗，割鲜共饱浙河东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别姚江","author":"李洪","text":"古埭潮迎楫，苍山翠募耕。\n人烟半渔钓，方物杂蛮荆。\n宿雨迷梅坞，过云望四明。\n匆匆理归柂，未暇脍长鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"医僧慧昌小轩","author":"李洪","text":"小池绿净数游鱼，高柳蝉嘶暑气虚。\n露脸清真双菡萏，风标閒雅一舂锄。\n囊中时晒君臣药，肘后新抄和扁书。\n只此便为安稳处，何须林下与山居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿老饷笋","author":"李洪","text":"陋巷晨炊乐一箪，慕膻逐臭两知难。\n自甘香积伊蒲馔，宁叹栏干苜蓿盘。\n禅老竹萌资净供，诗人菜把诮园官。\n喜参玉版宗风在，何待丛林一击看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拟和御制郊祀诗 其二","author":"李洪","text":"圣代弥文考九丘，寅威郊见故迟留。\n黄琮苍玉神娭燕，月璧星珠瑞应浮。\n礼洽汉山呼万岁，事殊唐鉴献千秋。\n侍臣谁荐扬雄赋，岂使甘泉播令猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拟和御制郊祀诗 其一","author":"李洪","text":"郊禋飨帝就圜丘，诚格苍穹灵既留。\n夜陟紫坛飙驭下，天临黄道矞云浮。\n槐林双阙恩方涣，禾黍三登岁有秋。\n幸睹赓歌千载遇，惭无银笔赞洪猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"步过仙霞岭","author":"李洪","text":"迢递南询过百城，五浆先馈不须惊。\n侵寻老境凋双鬓，耿介孤忠有寸诚。\n入眼越山多秀色，背人闽水大无情。\n扶筇趼步仙霞岭，自笑媻跚勃窣行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沈氏小玲珑二首 其二","author":"李洪","text":"十载经行旧，松扉静不关。\n岩空觑天巧，心达觉身閒。\n古洞无扃锁，飞泉杂佩环。\n何须采芝去，此地似商颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沈氏小玲珑二首 其一","author":"李洪","text":"试蹑登山屐，来寻云外峰。\n题诗喜脩竹，长啸倚孤松。\n怪石疑蹲虎，深湫有蛰龙。\n惭无济胜具，樽酒且从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泛舟之龙坞","author":"李洪","text":"苕花如雪忽秋残，翠老溪头几曲山。\n心逐浮云朝独出，家临清霅暮能还。\n世情大似醉翁醉，景物偏偷閒客閒。\n早晚诛茆继三径，招呼明月弄潺湲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈丞相诞日 其二","author":"李洪","text":"壶山和气俪神崧，间世钟贤应尹躬。\n小试经纶安鼎鼐，更恢韬略靖华戎。\n力陈致主千秋鉴，梦协遐年八十公。\n不用安期觅瓜枣，蓬莱清浅照方瞳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈丞相诞日 其四","author":"李洪","text":"两两台符逼斗魁，就盈弥月早春回。\n细斟静治曹参酒，重放和羹傅说梅。\n山立时行锡难老，鸾停鹄峙喜多才。\n千钟未足为公寿，尽挹沧江入寿杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62289,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈丞相诞日 其三","author":"李洪","text":"蝉冕金貂侍帝廷，格天勋业不谭兵。\n曾闻杨绾无荣利，果见周公致太平。\n昼锦归来安绿野，宣麻重起系苍生。\n民歌有衮岩瞻切，要使舆图复两京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62290,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈丞相诞日 其五","author":"李洪","text":"衮绣于蕃镇九仙，香凝森戟霭非烟。\n愿同吉甫倾申伯，请继东坡寿乐全。\n铜狄摩挲五百岁，蟠桃花实一千年。\n蚤窥东阁观奇士，再入陶镕岂偶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62291,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈伯和和经字韵复以为报","author":"李洪","text":"说诗夜对老弥明，韦氏传家自一经。\n盛德于今推鼎甲，闻孙何事亦飘零。\n囊贫桂玉人逾瘦，袖有珠玑耳暂醒。\n桃李春残归未得，愁看烟草五门青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62292,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叔赐迎侍以诗饯之且趣其来","author":"李洪","text":"折槛云孙擅后声，暂栖莲幕不谈兵。\n论诗更欲压竞病，痛饮何须分浊清。\n东阁梅残萦旅梦，北堂萱茂动归情。\n重来肯放韶光晚，叱驭加鞭莫计程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和人松江","author":"李洪","text":"来往吴松二十春，五湖烟月旧知津。\n高秋枫落哦佳句，斜日江边脍细鳞。\n谁解扁舟载西子，独怜茶灶老诗人。\n自惭遮日长安道，深愧渔蓑浪漫身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子召见寄","author":"李洪","text":"独泛沧浪一钓舟，未偿寻壑与经邱。\n霜清叵怯吴江冷，酒贱难从越女留。\n游鹿台荒人既往，采香径远宿须投。\n客游空羡齐云胜，辜负韦黄诗酒州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子都兄修佩鱼","author":"李洪","text":"恩假银鱼阅四年，新元瓜戍尚悠然。\n滞袍自昔多屯蹇，英衮当时误轸怜。\n司马青衫佐湓浦，参谋朱绂向西川。\n玉堂伴直如相念，安敢沉酣不上船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王侍郎中春即事","author":"李洪","text":"溪头飞絮白毡铺，五马班春计不疏。\n泛宅浮家行乐胜，浪花云叶赋诗馀。\n竞传画戟凝香什，莫望高轩织翠裾。\n碧落承明公厌直，水晶宫阙更谁如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和玉泉达老饷笋","author":"胡寅","text":"箨龙孤介亦骈阗，不比花嫣与柳眠。\n雪里顿超千佛地，风来应上四禅天。\n饱参玉版头头是，秀出芗林个个圆。\n知我远庖薇蕨少，倒笼登俎共便娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲信留别韵","author":"李洪","text":"岁首相逢四序迁，风饕雪虐忽凋年。\n少而慕蔺心何壮，老矣依刘谁复怜。\n邂逅难陪十日饮，分携却上五湖船。\n雪梅可折还相送，目断离云思黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和叔赐对榴花","author":"李洪","text":"安石榴开夏已深，动人绛萼绿成阴。\n色空喻火宜知戒，伐性如斤莫浪侵。\n半吐蹙巾传丽曲，同寻双叶寓欢心。\n老来体物辜诗兴，种种霜颠愧玳簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尚善西禅寺冲虚宫诗 其一","author":"李洪","text":"学道尤须惜寸阴，漫劳饭袋走丛林。\n沩山自昔提宗印，闽峤于今绝赏音。\n得髓得皮无著相，非心非佛见机深。\n丰干未免成饶舌，月在碧潭空指心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尚善西禅寺冲虚宫诗 其二","author":"李洪","text":"飙驭临风香霭间，支筇款步访星坛。\n羽人莫问升真事，古像空瞻玉佩寒。\n井冽不逢龟曳尾，鼎存犹想汞新乾。\n徘徊遐想来仙骥，皂荚成阴荔子丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尚善韵","author":"李洪","text":"出郭寻幽兴自长，丛林梅子未全黄。\n问禅欲契风幡话，宴坐聊参知见香。\n触念未通成系橛，安心无法是还乡。\n却怜石岊送迎处，潮落潮生有底忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郑康道春日三首 其三","author":"李洪","text":"弱柳低垂户，小桃初著花。\n春风无管束，贫巷亦矜誇。\n老觉桑榆迫，悲伤棠棣华。\n劳生皆有役，常苦思无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郑康道春日三首 其二","author":"李洪","text":"内乐同颜子，高楼慕隐居。\n紫苔沿砌合，红糁缀条疏。\n谩听平戎操，閒寻种树书。\n吾曹清净业，所好在三馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郑康道春日三首 其一","author":"李洪","text":"寄兴沧洲上，平芜绿又春。\n忘机时傲睨，燕坐默存真。\n铁砚心逾壮，金楼铸自新。\n年来孤节物，懒惰复谁伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵德孚春日","author":"李洪","text":"南国春回早，梅残已换年。\n郊原青入眼，老境雪侵颠。\n欲和归田赋，仍吟止酒篇。\n苦无游宦乐，此兴寄林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"垂虹亭","author":"李洪","text":"十年沧海惯骑■，秋入垂虹豁眼明。\n云气蓬莱底难到，洞天林屋没多程。\n渔歌三唱客愁破，雁字一行秋影横。\n他日若能追鲁望，钓车鱼具送馀生。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜宿护国寺","author":"李洪","text":"积雨长涂淖，禅房卧枕书。\n松风醒耳目，梅雨上衣裾。\n误著谢公屐，宁宜仲举舆。\n前山聊细数，何事拥犀渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉寄子济兄","author":"李洪","text":"一纸平安附驿筒，打门三印启斜封。\n谗言勿辩萋兮菲，旧隐犹存菊与松。\n岂有文章传李汉，当今人物少南容。\n扁舟远践龙池约，共听潺湲绕碧峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉简潘师原澄江使君","author":"李洪","text":"话别都门岁再除，归田犹复带经锄。\n春朝结佩同迎驾，夜雪寒窗并直庐。\n东阁何堪薛宣吏，长安久绝子公书。\n故人江上新开府，一笑樽前气少舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"尚善再用韵访梅","author":"李洪","text":"不惮诗催白发生，年年梅绽酷留情。\n寒枝幻出横斜影，旧曲犹堪一再行。\n越峤云霾春最早，西湖烟水梦尤清。\n他年相望千山阻，公在銮坡我退耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"尚善喜雨用元夕韵","author":"李洪","text":"软红尘土没东华，未若为农乐叵涯。\n耕陇一犁欣已足，生春六夜喜非赊。\n顿回茧馆柔桑绿，渐落峒山细麦花。\n惟觉空阶听更爽，斋居无睡转河车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"廨舍乃潘阆巷而俗讹为潘堂其地亦俞氏青士园也作诗记之","author":"李洪","text":"寓屋诗人巷，携锄青士园。\n琴书能自足，车马绝无喧。\n松顶凌云秀，蕉心听雨繁。\n幸无官长骂，稚子且应门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊石壁值雨","author":"李洪","text":"江头骤雨壮滩声，汹涌琮琤乱石鸣。\n咫尺烟林展图画，二三村落隔阴晴。\n方贪暍暑逡巡退，坐觉风霜指顾生。\n试倚篷窗临石壁，哦诗心迹得双清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中过幽居寺","author":"李洪","text":"柳眼青葱桃萼红，东皇试手放春功。\n峰峦矗矗孤云耸，涧壑涓涓细水通。\n出谷抗尘身已去，登高能赋思无穷。\n驱车更过幽居寺，暂听猿吟杳霭中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中慈感寺泛舟","author":"李洪","text":"渺渺汀舟雨满川，楼台烟霭羃愁边。\n春风邀勒梅都谢，夜雨淋浪柳尚妍。\n僧钵偶分蒲塞供，佛香时送水沉烟。\n佳时更拟携筇出，拾翠人归唤渡船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨寒","author":"李洪","text":"昏昏海气助朝寒，风雨萧萧尽日间。\n室似陈蕃尘不扫，门如陶令昼常关。\n惟凭茗盌消磨睡，更把诗筒断送閒。\n悄悄绝无车马至，方知颜巷似深山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南台点集海舰","author":"李洪","text":"粤国无诸故垒摧，吐吞江海亦雄哉。\n峰峦叠叠青螺髻，翠幄重重锦绣堆。\n破浪乘风浮战舰，荒烟落日傍龙台。\n倦游已喜瓜期近，立马沙边更几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚疾后临眺","author":"李洪","text":"游丝横路网春晖，落絮飘扬未肯归。\n绿满郊园梅子熟，昼长庭院燕雏飞。\n登临供赋山分绣，扶病经时带减围。\n更向江天买鱼具，轻蓑绝胜芰荷衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雪呈通判叔","author":"李洪","text":"无奈春来节物催，东君更遣玉花开。\n寒轻才湿新池草，势密重飘静院梅。\n麦陇润滋丰饼饵，秫田膏泽足醪醅。\n疲民尽说丰年瑞，独恨千山阻雁回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晴","author":"李洪","text":"佳晴游侣赏秾华，免使纶巾雨垫纱。\n苒苒芳塘遍春草，溶溶流水蘸桃花。\n閒官尚许亲黄卷，学道安能佩紫霞。\n多病无心与春竞，窗前静听晚蜂衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日遣兴二首 其二","author":"李洪","text":"倦憎秋暑炽，閒喜雨馀清。\n个个萤相照，娟娟月独明。\n湿蜗粘壁死，寒草上阶生。\n吟咏徒愁思，呜咽不得平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]