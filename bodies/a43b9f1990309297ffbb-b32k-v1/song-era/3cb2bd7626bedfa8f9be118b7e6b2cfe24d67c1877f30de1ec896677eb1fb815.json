[{"title":"绍定三年寿明仁福慈睿皇太后册宝九首 其九","author":"郊庙朝会歌辞","text":"皇文既举，庆礼告虔。\n肇自宫闱，格于幅员。\n子称母寿，母谓子贤。\n陟降在兹，隆名际天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙四年加上寿圣皇太后尊号八首 其八","author":"郊庙朝会歌辞","text":"宝册既奉，祗诵乃言。\n仁深庆衍，益显益尊。\n和声协气，充溢乾坤。\n并受伊嘏，圣子神孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙四年加上寿圣皇太后尊号八首 其七","author":"郊庙朝会歌辞","text":"懿典大册，陈仪邃深。\n怡怡愉愉，宝坐是临。\n重綵俨侍，罙展肃心。\n三宫协庆，永播徽音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙四年加上寿圣皇太后尊号八首 其六","author":"郊庙朝会歌辞","text":"雕舆彩仗，祗诣慈宫。\n宝册前奉，龙挟云从。\n言备兹礼，于宫之中。\n惟天子孝，于昭祲容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙四年加上寿圣皇太后尊号八首 其四","author":"郊庙朝会歌辞","text":"熙辰礼备，济济雍雍。\n言奉斯册，重亲之宫。\n宫帷既敞，协气感通。\n皇仪亲展，寿祉无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙四年加上寿圣皇太后尊号八首 其三","author":"郊庙朝会歌辞","text":"煌煌册宝，天子受之。\n言徐其行，肃展乃仪。\n其仪维何，剑佩黄麾。\n鸾驾清跸，耸瞻九逵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙四年加上寿圣皇太后尊号八首 其二","author":"郊庙朝会歌辞","text":"于皇帝室，休运贻孙。\n重熙叠庆，祗进号荣。\n爰授兹册，必躬必亲。\n天子圣孝，万邦仪刑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙四年加上寿圣皇太后尊号八首 其一","author":"郊庙朝会歌辞","text":"德厚重闱，冲澹粹穆。\n何以名之，惟慈惟福。\n宝镂精镠，册镌华玉。\n物盛礼崇，丕昭群目。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方丘乐歌 其一","author":"郊庙朝会歌辞","text":"至哉坤仪，万汇资生。\n称物平施，流谦变盈。\n礼修泰折，祭极精诚。\n皇皇灵眷，永奠寰瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方丘乐歌 其二","author":"郊庙朝会歌辞","text":"礼有五经，无先祭礼。\n即时伸虔，惟时盥洗。\n品物吉蠲，威仪济济。\n锡之纯嘏，来歆恺悌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方丘乐歌 其五","author":"郊庙朝会歌辞","text":"四阶秩仪，坛于方泽。\n昭事皇祇，即阴以墌。\n洁肆于祊，孔嘉且硕。\n神其福之，如几如式。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方丘乐歌 其九","author":"郊庙朝会歌辞","text":"因地方丘，济济多仪。\n乐成八变，灵祇格思。\n荐馀彻豆，神贶昭垂。\n亿万斯年，永祐丕基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方丘乐歌 其四","author":"郊庙朝会歌辞","text":"礼行方泽，文物备举。\n惟皇地祇，昭格来下。\n奠瘗玉帛，纯诚内著。\n神保是享，陟降斯祐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方丘乐歌 其三","author":"郊庙朝会歌辞","text":"无疆之德，至哉坤元。\n沉潜刚克，资生实蕃。\n方丘之仪，惟敬无文。\n神其来思，时歆荐殷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方丘乐歌 其六","author":"郊庙朝会歌辞","text":"荡荡坤德，物无不载。\n柔顺利贞，含弘光大。\n笾豆既陈，金石斯在。\n四海永宁，福禄攸介。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"方丘乐歌 其七","author":"郊庙朝会歌辞","text":"卓彼嘉坛，奠玉方泽。\n百辟祗肃，八音纯绎。\n祀事承明，柔祗感格。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆乾德朝会乐章二十八首 第五盏用《玉兔》。","author":"郊庙朝会歌辞","text":"盛德好生，网开三面。\n明视标奇，昌辰乃见。\n育质雪园，沦精月殿。\n著于乐章，色含江练。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆乾德朝会乐章二十八首 第四盏用《嘉禾》。","author":"郊庙朝会歌辞","text":"嘉彼合颖，致贡升平。\n异标南亩，瑞应西成。\n德至于地，皇祇效灵。\n和同之象，焕发祥经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆乾德朝会乐章二十八首 第三盏用《紫芝》。","author":"郊庙朝会歌辞","text":"煌煌茂英，不根而生。\n蒲茸夺色，铜池著名。\n晨敷表异，三秀分荣。\n书于瑞典，光我文明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆乾德朝会乐章二十八首 第二盏用《甘露》。","author":"郊庙朝会歌辞","text":"天德冥应，仁泽载濡。\n其甘如醴，其凝若珠。\n云表潜结，颢英允敷。\n降于竹柏，永昭瑞图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆乾德朝会乐章二十八首 皇帝举酒第一盏用《白龟》。","author":"郊庙朝会歌辞","text":"圣德昭宣，神龟出焉。\n载白其色，或游于川。\n名符在沼，瑞应巢莲。\n登歌丹陛，纪异灵篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆乾德朝会乐章二十八首 其二 上寿用《禧安》。","author":"郊庙朝会歌辞","text":"舜韶更奏，尧酒浮觞。\n皇情载怿，洪算无疆。\n基隆郏鄏，德茂陶唐。\n山巍日焕，地久天长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆乾德朝会乐章二十八首 其一 上寿用《禧安》。","author":"郊庙朝会歌辞","text":"乾健为君，坤柔曰臣。\n惟其臣子，克奉君亲。\n永御皇极，以绥兆民。\n称觞献寿，山岳嶙峋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆乾德朝会乐章二十八首 公卿入门用《正安》。","author":"郊庙朝会歌辞","text":"尧天协纪，舜日扬光。\n淑慎尔止，率由旧章。\n佩环济济，金石锵锵。\n威仪炳焕，至德昭彰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建隆乾德朝会乐章二十八首 皇帝升座用《隆安》。","author":"郊庙朝会歌辞","text":"天临有赫，上法乾元。\n铿锵六乐，俨恪千官。\n皇仪允肃，玉坐居尊。\n文明在御，礼备诚存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其十四","author":"郊庙朝会歌辞","text":"仰瞻慈闱，登进宝册。\n惟时?御，祗率厥职。\n曰寿曰名，母兮兼得。\n俪我尊父，亿载无极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其十三","author":"郊庙朝会歌辞","text":"鞠育保护，母道备矣。\n密赞亲传，德其至矣。\n綵服来朝，慈容有喜。\n既受鸿名，又多受祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其十二","author":"郊庙朝会歌辞","text":"坤德益崇，天寿平格。\n庆流万世，子孙千亿。\n刻玉范金，铺张赫奕。\n惟昔姜任，则莫我匹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其十一","author":"郊庙朝会歌辞","text":"丕赫有宋，三圣授受。\n谁其助之，繄我太母。\n东朝受册，饮此春酒。\n圣子神孙，密侍左右。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其十","author":"郊庙朝会歌辞","text":"涓辰协吉，时维春元。\n上册三殿，旷古无前。\n思齐重闱，积庆有源。\n是尊是崇，帝心载虔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其九","author":"郊庙朝会歌辞","text":"大哉乾元，既极形容。\n坤元德至，实与比隆。\n宝册并登，勒崇垂鸿。\n相我缛仪，肃肃雍雍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其八","author":"郊庙朝会歌辞","text":"天祐皇家，庆集重闱。\n宝兮扬名，册兮流徽。\n金支秀华，盛容祲威。\n诏我近弼，相礼不违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其七","author":"郊庙朝会歌辞","text":"瑟彼华玉，篆鱼钮龙。\n与册并登，咨尔上公。\n咏以歌诗，协之鼓钟。\n是陟是降，靡有弗恭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其六","author":"郊庙朝会歌辞","text":"慈皇天临，睟表怡怡。\n钦哉圣子，亲奉玉卮。\n鳌抃嵩呼，欢浃华夷。\n迩臣捧册，是恪是祗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其五","author":"郊庙朝会歌辞","text":"玉玺瑶编，礼容毕具。\n穆穆至尊，华殿是御。\n德配有虞，绍唐授禹。\n于万斯年，受天之祜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其四","author":"郊庙朝会歌辞","text":"仰止皇居，九门载辟。\n丽日重光，非烟五色。\n雷动万乘，云从百辟。\n咫尺重霄，鞠躬屏息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其三","author":"郊庙朝会歌辞","text":"巍巍天宫，洞开阊阖。\n旗常葳蕤，剑佩杂沓。\n宝册启行，法驾继发。\n铄哉盛典，快睹胥悦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其二","author":"郊庙朝会歌辞","text":"钟鼓交作，文物咸备。\n彤庭玉阶，天子是莅。\n咨尔辅臣，展采错事。\n辅臣稽首，敢不率礼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍熙元年恭上寿圣皇太后至尊寿皇圣帝寿成皇后尊号册宝十四首 其一","author":"郊庙朝会歌辞","text":"帝受内禅，纪元绍熙。\n钦崇慈亲，孝心肃祗。\n乃建显号，乃蒇丕仪。\n发册广庭，声歌侑之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨师五首 其五 送神用《欣安》。","author":"郊庙朝会歌辞","text":"牲俎告彻，嘉乐休成。\n卒事有严，燕虞高灵。\n蕃我民人，育我稷黍。\n万有千祀，承神之祜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨师五首 其四 酌献，亚、终献用《雍安》。","author":"郊庙朝会歌辞","text":"寅恭我神，惟上之使。\n俾成康年，民徯休祉。\n折俎既登，?酒既盈。\n匪荐是专，配以明诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨师五首 其三 奠币用《容安》。","author":"郊庙朝会歌辞","text":"崇崇坛阶，灵既降止。\n有严执奠，承祀兹始。\n明灵在天，式顾庶察。\n泽润以时，永拂荒札。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨师五首 其二 升降用《钦安》。","author":"郊庙朝会歌辞","text":"佩玉璆如，黼黻襜如。\n承神不懈，讫获嘉虞。\n圣皇命祀，臣敢弗恭。\n凡尔在位，翼翼雍雍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨师五首 其一 迎神用《欣安》。","author":"郊庙朝会歌辞","text":"神之无象，亦可思索。\n维云阴阴，维风莫莫。\n降止坛宇，来顾芳馨。\n侑以鼓歌，荐此明诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨师雷神七首 其七 送神。曲同迎神。","author":"郊庙朝会歌辞","text":"阴旄载旋，鼓车其鞭。\n问神安归，冥然而天。\n皇有正命，祀事孔蠲。\n其临其归，亿万斯年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨师雷神七首 其六 亚、终献。曲同初献。","author":"郊庙朝会歌辞","text":"作解之德，形声一兮。\n爰展献侑，酌则三兮。\n我兴有假，云胡有私。\n下土是冒，庶其远而。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨师雷神七首 其五 雷神位酌献。曲同雨师。","author":"郊庙朝会歌辞","text":"瞻彼南山，有虺其出。\n维蛰之奋，维疠之息。\n眷焉顾飨，在夏之日。\n觞豆匪报，皇忍忘德。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨师雷神七首 其四 雨师位酌献用《雍安》。","author":"郊庙朝会歌辞","text":"山川出云，裔裔而缕。\n载霪载濛，其德乃溥。\n自古有年，胡然莫祖。\n无简我觞，无怠我俎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨师雷神七首 其三 奠币用《容安》。","author":"郊庙朝会歌辞","text":"霈兮隐兮，蹶其阴威。\n相我有终，胡宁不知。\n我币有陈，我邸斯圭。\n岂维有陈，于以奠之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨师雷神七首 其二 初献盥洗、升降用《钦安》。","author":"郊庙朝会歌辞","text":"言言祠宫，爰考我礼。\n维西有罍，维东有洗。\n爰洁爰涤，载荐其醴。\n神在何斯，匪远具迩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨师雷神七首 其一 迎神用《欣安》。","author":"郊庙朝会歌辞","text":"众万之托，动之润之。\n昭格孔时，维神之依。\n泠然后先，肆我肯顾。\n是耶非耶，纷其来下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"亲耕藉田七首 其七 归大次。","author":"郊庙朝会歌辞","text":"教民稼穑，不令而行。\n进退有度，琚瑀锵鸣。\n言还熉幄，礼则告成。\n帝命率育，明德惟馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"亲耕藉田七首 其六 降坛。","author":"郊庙朝会歌辞","text":"肇新帝藉，率我农人。\n三推终亩，祗事咸均。\n陟降孔时，粲然有文。\n受天之祜，多稼如云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"亲耕藉田七首 其五 群官耕藉。","author":"郊庙朝会歌辞","text":"畟畟良耜，我田既臧。\n土膏其动，春日载阳。\n执事有恪，于此中邦。\n农夫之庆，栖亩馀粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"亲耕藉田七首 其四 公卿耕藉。","author":"郊庙朝会歌辞","text":"群公显相，奉事斋庄。\n率时农夫，举耜载扬。\n播厥百谷，以佑我皇。\n多黍多稌，丕应农祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"亲耕藉田七首 其三 升坛。","author":"郊庙朝会歌辞","text":"方坛屹立，陛级而登。\n玉色下照，临观耦耕。\n万目咸睹，如日之升。\n成规成矩，百禄是膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"亲耕藉田七首 其二 亲耕。","author":"郊庙朝会歌辞","text":"元辰既择，礼备乐成。\n洪縻在手，祗饰专精。\n三推一垡，端冕朱纮。\n靡辞染屦，以示黎氓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"亲耕藉田七首 其一 皇帝出大次用《乾安》。","author":"郊庙朝会歌辞","text":"勤劳稼穑，必躬必亲。\n为藉千亩，以教导民。\n帝出乎震，时惟上春。\n天颜咫尺，望之如云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咸平藉田回仗御楼二首 其二 升坐用《隆安》。","author":"郊庙朝会歌辞","text":"应门斯御，雉扇爰开。\n人瞻日月，泽动云雷。\n同风三代，均禧九垓。\n欢心允洽，时咏康哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咸平藉田回仗御楼二首 其一 《采茨》。","author":"郊庙朝会歌辞","text":"农皇既祀，礼毕躬耕。\n商辂旋轸，周颂腾声。\n观魏将陟，服御爰更。\n舆人瞻仰，如日之明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"政和鹿鸣宴五首 其五","author":"郊庙朝会歌辞","text":"遐不作人，天下喜乐。\n何以况之，鸢飞鱼跃。\n既劝之驾，献酬交错。\n利用宾王，縻以好爵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"政和鹿鸣宴五首 其四","author":"郊庙朝会歌辞","text":"首善京师，灼于四方。\n烝我髦士，金玉其相。\n饮酒乐曲，吹笙鼓簧。\n勉戒徒御，观国之光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"政和鹿鸣宴五首 其三","author":"郊庙朝会歌辞","text":"鸣鹿呦呦，载弁俅俅。\n烝然来思，旨酒思柔。\n之子言迈，泮涣尔游。\n于彼西雍，对扬王休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"政和鹿鸣宴五首 其二","author":"郊庙朝会歌辞","text":"钟鼓皇皇，磬筦锵锵。\n登降维时，利用宾王。\n髦士攸宜，邦家之光。\n媚于天子，事举言扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"政和鹿鸣宴五首 其一","author":"郊庙朝会歌辞","text":"思乐泮水，承流辟雍。\n思皇多士，贲然来从。\n雍雍济济，四方攸同。\n登于天府，维王是崇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"皇帝上尊号一首 册宝入门用《正安》。","author":"郊庙朝会歌辞","text":"于穆元后，天临紫宸。\n飞緌星拱，建羽林芬。\n徽册是奉，鸿名愈新。\n荷兹介祉，永永无垠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"皇祐亲享明堂六首 其六 送神用《诚安》。","author":"郊庙朝会歌辞","text":"我将我享，辟公显助。\n献终豆彻，礼成乐具。\n饰驾上游，升烟高骛。\n神保聿归，介兹景祚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]