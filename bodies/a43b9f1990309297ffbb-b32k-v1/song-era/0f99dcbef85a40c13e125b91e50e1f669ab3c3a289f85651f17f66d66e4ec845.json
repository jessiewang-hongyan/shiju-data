[{"title":"待不愚入山未至","author":"饶节","text":"天寒岁暮山骨冷，一枝两枝梅半开。\n酌泉煮茗汤欲竭，弥天道人犹未来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢扶上人装毗卢像","author":"饶节","text":"道人散步过茅堂，怜我毗卢尘覆藏。\n戏出当年三昧手，一弹指顷放毫光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上","author":"饶节","text":"秋江渺渺秋风急，芦花不飞露犹湿。\n江头倚杖不逢人，鹭鹚飞上渔舟立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送化士","author":"饶节","text":"白云深处白崖山，松下岩边自往还。\n折得一枝岩上草，赠渠分卫到人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张师哲秀才出山","author":"饶节","text":"已向尘笼透此身，来寻击竹悟心人。\n眠云未暖出山去，溪月松风可负君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张师哲求袜样","author":"饶节","text":"赠子倚松真袜样，不须裁减不须增。\n青山自有白云衬，莫向红尘取次行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荣大师昔从余出应天宁后为洞山古羊副庄往来称之因作小颂为寄","author":"饶节","text":"年来落莫卧岩谷，故人来会岩中宿。\n夜深灯火话西来，重悟当年庵畔竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送璞和尚出应双泉之命","author":"饶节","text":"汉东诸国随为大，兄出何妨应有缘。\n想见梁家庵畔景，白云流水旧风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"檀越许分一株素馨见赠作小诗速之","author":"饶节","text":"顺阳春色元无数，只有秋芳恐未闻。\n好事霍侯人不及，许将秋色为中分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠颍昌府化士","author":"饶节","text":"异时得交天下士，触目琳琅珠玉间。\n年来林下龟藏六，一见道人聊解颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"应上人作法华佛事过余求颂为作短偈","author":"饶节","text":"未明心地法华转，心地明时转法华。\n老子年来浑不会，野梅开过竹横斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢徐通叔","author":"饶节","text":"麝香朱李小而香，白杏流沙昔未尝。\n好事北园高隐者，筠笼剪露寄禅房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄冯大辩二首 其一","author":"饶节","text":"阅礼敦诗数范公，威名千古在羌戎。\n范公远矣偏裨老，犹挟仙方可疗穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄冯大辩二首 其二","author":"饶节","text":"须髯如戟老将军，未试平生剑有神。\n圣世清明疑不用，且将方术济时人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送双泉祥毡头","author":"饶节","text":"自古丛林建立迟，说人无数作人稀。\n阿师卷角三冬暖，恰趁开炉作供时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送古上人化漆金州","author":"饶节","text":"松外寒梅已破春，道人持钵是行人。\n停舟山畔功成后，早晚归来细问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再送古上人","author":"饶节","text":"危径湍溪六月寒，阿师分卫入云端。\n有人不辨师真伪，举似山僧短偈看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠相师","author":"饶节","text":"枯木岩中一病夫，问生何处著荣枯。\n却须自把轩辕镜，还见从来面目无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"常上人还乡省视其师","author":"饶节","text":"道人行脚半天下，忽打轻包歌式微。\n莫作赵州中夜遁，古灵且度出家师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵周提刑出邓鄙五首 其一","author":"饶节","text":"旌旗肃肃卷秋风，赤脚儿童挽乃翁。\n使者回看为农喜，年来衣履不穿空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵周提刑出邓鄙五首 其二 过厉山驿","author":"饶节","text":"古木参天枝欲倾，秋风时发半岩声。\n厉山拟作故园梦，山雨萧萧梦不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵周提刑出邓鄙五首 其三 过汉东","author":"饶节","text":"野菊秋深满意黄，一川禾黍拥人香。\n悬知岁乐农无事，已见茅檐压酒尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵周提刑出邓鄙五首 其四 枣阳值雨","author":"饶节","text":"莫雨凄凄鸦著林，绿苔随意上墙阴。\n问侬此雨妨农否，漠漠无言念更深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵周提刑出邓鄙五首 其五 普照寺观竹","author":"饶节","text":"招提夜宿竹连村，似对诸郎孤竹君。\n独倚胡床人静后，总将尘事付浮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答周提刑二首 其一","author":"饶节","text":"负弩先驰入翠蓝，溪光山绿拥征骖。\n夜堂数刻谈名理，却胜平生四海参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答周提刑二首 其二","author":"饶节","text":"神游曾已遍岩峦，占吉当知便赐环。\n值遇贵人真有意，伫看腾跃起鲵桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵春日寄山中故友二首 其一","author":"饶节","text":"世人纷纷有底急，利欲著身如束湿。\n道人摆去邻虚尘，拄杖芒鞋当收拾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵春日寄山中故友二首 其二","author":"饶节","text":"雨过残春一扫空，哦诗自绕菊兰丛。\n诗成封寄山中旧，风静莺啼日破中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别草庵","author":"饶节","text":"非利非名非有求，浩然乘兴亦南游。\n白云出洞初无累，绿水逢坳本暂留。\n石径不移松雨晓，茅檐长付竹风秋。\n客来欲问庵中主，楖栗横挑四百州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈道人世缘不顺隐于术糊其口于四方云将复如京师乞怜于轻财重义之士冀或有怜之者因其求颂为作短句","author":"饶节","text":"雨后蜂忙燕啄泥，野蔷薇过柳华飞。\n道人抱艺行天下，好语春鹃似见几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄襄阳求天麻圆","author":"饶节","text":"老僧卧病四告朔，苦无灵药与携扶。\n闻道天麻能肉骨，襄阳耆旧见怜无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洞山宗禅师欲刻五百大阿罗汉又建大阁居之其门人钦上人实领其化缘事为作小偈送之","author":"饶节","text":"老师略展摩天手，便有儿孙建大功。\n五百大士安栖日，汉江千古起清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠皇甫道人","author":"饶节","text":"三界从来不易安，那堪家火更烹煎。\n吾家幸有清凉地，枕上从头子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蔷薇","author":"饶节","text":"蔷薇作架高一丈，准拟春风如许长。\n可怜条间一寸叶，中有嫩色三月香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠熊正臣","author":"饶节","text":"浑金璞玉世甚鲜，衣冠有识共因之。\n年来访道倚松室，泥牛斗入醴泉池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘仲高过虎溪绝句","author":"饶节","text":"先生自得游山体，竹杖芒鞋手自提。\n莫问山僧山里路，曹侯溪是旧时溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和愚和尚梅颂","author":"饶节","text":"年年春色总输梅，长向百花头上开。\n却恨今年春独晚，正须乘月为公来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曲留仲高","author":"饶节","text":"倚松卧病林下寺，想望朋友如天人。\n况公座有千里骏，为我少留君勿嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏邀道人观残花","author":"饶节","text":"尚有残春已可怜，那堪宿雨夜溅溅。\n道人若有惜春意，赤脚来看也直钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"趣舒以明主簿入山二首 其一","author":"饶节","text":"官人许过一年馀，官行有律不可虚。\n此来偶有山中便，愿公叱驭莫徐徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"趣舒以明主簿入山二首 其二","author":"饶节","text":"春色过人速如电，及此花时天意深。\n残春转觉春可惜，愿公作意来追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠徐道人","author":"饶节","text":"茂林脩竹阴阴地，昔日曾为烂漫游。\n道人况有人伦鉴，为煮新芽更一瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩承务过余求颂","author":"饶节","text":"官人骑马松门外，下马敲门眉目清。\n休问西来他日意，绕篱无数竹鸡鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祝大夫解房州印过山有颂次韵","author":"饶节","text":"年来养病卧岩阿，多谢庞公尽室过。\n若询击竹家风事，休把虚空更撮摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠祝大夫令人","author":"饶节","text":"三十年来访道场，骊珠夺得是寻常。\n今日倚松重借问，摩尼从此转晶光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早起作颂访愚禅师","author":"饶节","text":"晓日珑璁竹入门，石鱼吼处恰翻身。\n老夫遽起无馀事，收拾儿童访道人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"范机宜磨头昼眠有作次其韵","author":"饶节","text":"散发临流性所便，不携裀褥借云眠。\n山童抱杖立户外，不索仙陀未敢前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送春","author":"饶节","text":"谁知春事妙无穷，费尽东君多少工。\n朝来再绕朱栏看，独有淮阳一朵红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芍药花开招大众看","author":"饶节","text":"年来春色妙无穷，芍药今朝又破红。\n寄语满堂枯木众，野花香径好携筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲高留题转物堂亦次其韵","author":"饶节","text":"转物堂前春烂漫，杨花断送今无馀。\n故人过我勿厌数，免寄寒温一束书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感新荷","author":"饶节","text":"新荷贴贴铺水面，要渠起立良独难。\n一朝时至鹤鹭立，清凉月下飞翻翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄蝶","author":"饶节","text":"黄栗留鸣日正长，酴醾开尽一川香。\n南园表里皆浓绿，黄蝶无稽辊地狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薝卜","author":"饶节","text":"浩荡园林风雨声，鹁鸠撩乱亦悲鸣。\n作毬刺芥风吹尽，薝卜林中特地清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"百舌","author":"饶节","text":"多能百舌弄春晴，解作春风百鸟声。\n独立高林千尺上，黄鹂无数不能鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘲杜鹃","author":"饶节","text":"杜鹃终日苦言归，只解言归不见机。\n青山本是渠归处，犹向风前怨落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归鸿","author":"饶节","text":"爱夏堂前风卷帘，归鸿无数过前檐。\n杜鹃只解催渠去，应为南方六月炎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山间","author":"饶节","text":"杏子黄时麦已收，槐阴重叠柳条柔。\n山中活计无疆界，却鄙人间万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石竹","author":"饶节","text":"桃李浓时恰退藏，甘随萧艾隐风光。\n转物堂前春欲绝，稍依宫样试严妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻故人来","author":"饶节","text":"鸣鸠逐妇喧不休，浮云作雨方西流。\n倚松卧病无佳处，闻道故人疾乃瘳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻杜鹃","author":"饶节","text":"落月过山风露清，鸡声未作天欲明。\n杜鹃不管人残梦，南枝飞过北枝鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示众看花","author":"饶节","text":"尚有馀春可尽欢，何须终日绕阑干。\n倚松庵畔见春后，人间春色不须看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访韬光庵主不遇","author":"饶节","text":"紫蕨伸拳笋破梢，柳光飞尽绿阴交。\n道人闭口不知处，黄栗留鸣鹊在巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄吕善叔主簿","author":"饶节","text":"倚松卧病山林下，每荷明公特见怜。\n但得此身常受供，不妨明月在秋天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠善公华严法师","author":"饶节","text":"京国驰名四十年，华严说罢复谈禅。\n夜来一昔真忏悔，果然明月在秋天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠吕无求县丞约游嵩少","author":"饶节","text":"白葛乌纱松径遥，溪声激激雨萧萧。\n乐山乐水自仁智，争利争名渠市朝。\n今日不须沽酒引，他年岂待作诗招。\n悬知三十六峰下，祗么相寻共寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠毛雍玉县丞谢到山中","author":"饶节","text":"何事凌寒带晓暾，高才不肯簿书昏。\n别峰小寺已鸣磬，夹道短篱犹闭门。\n雨后松枝浑黛绿，冻馀泉窦尚春温。\n聊将二物方君德，富贵功名不足论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答吕居士寄诗","author":"饶节","text":"长忆吟诗对短檠，诗成重改又鸡鸣。\n如今老矣无心力，口诵君诗绕竹行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题骨观画","author":"饶节","text":"白骨纤纤巧画眉，髑髅楚楚被罗衣。\n手持纨扇空相对，笑杀傍观自不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春","author":"饶节","text":"尽道春多雨，伤摧花鸟空。\n不知春态度，尤在绿荫中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"红梅","author":"饶节","text":"娇朱浅浅透冰光，瘦倚疏篁半出墙。\n雅有风情胜桃杏，巧含春思避冰霜。\n融明醉脸笼轻晕，敛掩仙裙蹙嫩黄。\n日暮风英堕行袂，依稀如著领巾香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"饶节","text":"剥剥剥，里面有虫外面啄。\n多少茫茫瞌睡人，顶后一锥犹未觉。\n若不觉，更听山僧剥剥剥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠陈成季","author":"饶节","text":"两公待我以国士，是时公亦同在门。\n今日江头看使节，令人泪湿汉江云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"佛米赞","author":"饶节","text":"时平主圣，万国自靖。\n不杀而成，不征而正。\n矫矫虎臣，无所用命。\n移将东南，介我佛会。\n久闻吾曹，念佛三昧。\n喑呜叱咤，化为佛声。\n三令五申，易为佛名。\n一佛一米，为米三升。\n自升而斗，自斗而斛。\n念之无穷，太仓不足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"饶节","text":"閒携经卷倚松立，试问客从何处来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂","author":"詹荣","text":"木鱼原来无肚肠，声声唤我出镬汤。\n佛法原来无多子，王婆头上戴丁香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岐王宫侍儿落发为尼","author":"张叔夜","text":"六尺轻罗染曲尘，金莲步稳衬湘裙。\n从今不入襄王梦，剪尽巫山一朵云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题靖安吕延平钓台","author":"张叔夜","text":"豫章富人物，历数烦偻指。\n先生钓璜孙，盛德邈相似。\n却顾徐洪辈，琐琐讵足记。\n修竹照清漪，邂逅聊复尔。\n吾君迈周文，未省猎渭水。\n矧此江之湄，相距数千里。\n会遇偶有时，必为苍生起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":58968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]