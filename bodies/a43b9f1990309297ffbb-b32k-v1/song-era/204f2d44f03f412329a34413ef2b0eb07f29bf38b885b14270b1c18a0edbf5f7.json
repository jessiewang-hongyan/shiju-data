[{"title":"日月吟","author":"邵雍","text":"月明星自稀，日出月亦微。\n既有少正卯，岂无孔仲尼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月到梧桐上吟","author":"邵雍","text":"月到梧桐上，风来杨柳边。\n院深人复静，此景共谁言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"毛头吟 其一","author":"邵雍","text":"谁剪毛头谢陆沉，生灵肌骨不胜侵。\n人间自有回天力，林下空多忧国心。\n日过中时忧未艾，月几望处患仍深。\n军中儒服吾家事，诸葛武侯何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水火吟","author":"邵雍","text":"水火得其御，交而成既济。\n水火失其御，焚溺可立至。\n不止水与火，万事尽如此。\n只知用水火，不知水火义。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王胜之谏议见惠文房四宝内有巨砚尤佳因以谢之","author":"邵雍","text":"铜雀或常闻，未尝闻金雀。\n始愧林下人，识物不甚博。\n金雀出何所，必出自灵岳。\n剪断白云根，分破苍岑角。\n既为之巨砚，遂登于纶阁。\n水贮见温润，墨发知瀺濯。\n窗下喜鉴开，案前惊月落。\n见赠何慇勤，欲报须和璞。\n胡为不且留，洪化用斟酌。\n胡为不且留，贤人用选擢。\n胡为不且留，奸人用诛削。\n胡为不且留，生灵用安泊。\n则予何人哉，拜贶徒惊矍。\n须是笔如椽，方能无厚怍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东轩前添色牡丹一株开二十四枝成二绝呈诸公 其一","author":"邵雍","text":"牡丹一株开绝伦，二十四枝娇娥颦。\n天下唯洛十分春，邵家独得七八分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东轩前添色牡丹一株开二十四枝成二绝呈诸公 其二","author":"邵雍","text":"牡丹一株开绝奇，二十四枝娇娥围。\n满洛城人都不知，邵家独占春风时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长安道中作","author":"邵雍","text":"长安道上何沾巾，古时道行今时人。\n不知寒暑与朝暮，车轮马迹常辚辚。\n自是此土亦辛苦，雨作泥兮风为尘。\n泥尘返复不知数，大雨大风无出门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长短吟","author":"邵雍","text":"君子喜淳诚，小人喜欺罔。\n淳诚岁时长，欺罔日月短。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风月吟","author":"邵雍","text":"凉风无限清，良月无限明。\n清明不我舍，长能成欢情。\n终朝三褫辱，昼日三接荣。\n荣辱不我预，何复能有惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤州郡楼上书所见","author":"邵雍","text":"杨柳垂青带，风动如飞盖。\n危楼思不穷，尽日闲相对。\n鸟去林自空，云移山不碍。\n情随双燕还，意与孤鸿会。\n晚角时断续，层崖递明晦。\n残阳挂疏红，远水生微濑。\n塞目烟岑密，都城若天外。\n如何久客心，东望凭栏杀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风吹木叶吟","author":"邵雍","text":"风吹木叶不吹根，慎勿将根苦自陈。\n天子旧都闲好住，圣人馀事冗休论。\n长年国里神仙侣，安乐窝中富贵人。\n万水千山行已遍，归来认得自家身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风霜吟","author":"邵雍","text":"见风而靡者草也，见霜而殒者亦草也。\n见风而鸣者松也，见霜而凌者亦松也。\n见风而靡，见霜而伤，焉能为有，焉能为亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东海有大鱼","author":"邵雍","text":"东海有大鱼，罔罟无能近。\n砀然一失水，蝼蚁得而困。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐乐吟","author":"邵雍","text":"吾常好乐乐，所乐无害义。\n乐天四时好，乐地百物备。\n乐人有美行，乐己能乐事。\n此数乐之外，更乐微微醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐物吟","author":"邵雍","text":"日月星辰天之明，耳目口鼻人之灵。\n皇王帝伯由之生，天意不远人之情。\n飞走草木类既别，士农工商品自成。\n安得岁丰时长平，乐与万物同其荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐春吟","author":"邵雍","text":"四时唯爱春，春更爱春分。\n有暖温存物，无寒著莫人。\n好花方蓓蕾，美酒正轻醇。\n安乐窝中客，如何不半醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乐毅吟","author":"邵雍","text":"乐毅事燕时，其心有深旨。\n破齐七十城，迎刃不遗矢。\n岂留即墨莒，却与燕有二。\n欲使燕遂王，天下自齐始。\n岂意志未申，昭王一旦死。\n惠王固不知，使人代其位。\n强燕自此衰，何复能振起。\n自古君与臣，济会非容易。\n重惜千万年，英雄为流涕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书戏祖龙图","author":"邵雍","text":"祖兄同甲申，二十七日长。\n无怨可低眉，有欢能抵掌。\n交情日更深，道义久相尚。\n但欠书丹人，黄金八百两。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书吟","author":"邵雍","text":"金须百鍊始知精，水鉴何如人鉴明。\n不弃既能存故旧，久要焉敢忘平生。\n经纶事体当言用，道义襟怀只论诚。\n草木面前何止万，岁寒松桂独青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书吟","author":"邵雍","text":"见别一年馀，岁残相忆初。\n重烦君款密，远寄我空疏。\n衰朽百端有，忧愁一点无。\n闲吟四十字，聊用答来书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄友人","author":"邵雍","text":"一别光阴二纪馀，岁华如箭止堪吁。\n东西契阔久经难，前后慇勤两得书。\n故国山川皆梦寐，旧家人物半丘墟。\n何时重讲当时事，笑对西风坼酒壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄长安幕张文通","author":"邵雍","text":"无学又无谋，胸中一向虚。\n枯肠欢饮酒，病眼怕看书。\n洛浦轻风里，天津小雨馀。\n故人千里隔，相望意何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄华山云台观武道士","author":"邵雍","text":"太华中峰五千仞，下有大道人往还。\n当时马上一回首，十载梦魂犹过关。\n生平爱山山未足，由此看尽天下山。\n求如华山是难得，使人消得一生闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄张司封吟","author":"邵雍","text":"天机时事不相差，老后□□□□□。\n□□□□去□□，□□□□□□□。\n□□□□□□□，□□□□□可嗟。\n唯有□风一杯酒，忆君□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄陈章屯田","author":"邵雍","text":"执别而来二十春，忽飞书意一何勤。\n四方岂是少贤士，千里犹能思故人。\n世态见多知可否，物情谙久识疏亲。\n我今老去甘衰朽，无补明时卧洛滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄剑州普安令周士彦屯田 其二","author":"邵雍","text":"二蜀至三吴，中间万里馀。\n去年方北望，今岁复西驱。\n剑阁离天日，秦川限帝都。\n临风相忆处，能饮一杯无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书寄南阳太守吕献可谏议","author":"邵雍","text":"一别星霜二纪中，升沉音问不相通。\n林间谈笑须归我，天下安危宜系公。\n万乘几前常蹇谔，百花洲上略从容。\n不知月白风清夜，能忆伊川旧钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书答淮南宪张司封","author":"邵雍","text":"缘木求鱼固不能，缘鱼求炙恐能行。\n与其病后求良药，不若醉时辞大觥。\n芝草无根休用种，蟠桃有实岂难生。\n荷君见爱情非浅，一芥还同一芥荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"代书谢王胜之学士寄莱石茶酒器","author":"邵雍","text":"东山有石若琼玖，匠者追琢可盛酒。\n君子得之惜不用，慇勤远寄林下叟。\n林叟从来用瓦盏，惊惶不敢擎上手。\n重诫儿童无损伤，缄藏复以待贤友。\n未知贤友何时归，男子功名未成就。\n朝廷先从忧者言，方今莫如二虏丑。\n汉之六郡限辽西，唐之八州隔山后。\n自馀瓜沙甘与凉，中原久而不能有。\n奈何更饵以金帛，重困吾民犹掣肘。\n若非堂上出奇兵，安得阃外拉馀朽。\n直可逐去此曹辈，西出玉门北逾口。\n城下狐狸既不存，路上豺狼自无走。\n太阳烜赫耀天衢，氛妖接变匿尘垢。\n功成不肯受上赏，印解黄金大于斗。\n乞洛辞君出国门，归鞍暖拂天街柳。\n千官如壁遮道留，仰面弄鞭不回首。\n乡人夹路迎大尹，醉拥旌幢锦光溜。\n下车拜墓还政馀，不访公门访亲旧。\n始知此器用有时，吾当为君献眉寿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬不出吟","author":"邵雍","text":"冬非不欲出，欲出苦日短。\n年老恐话长，天寒怕归晚。\n山翁头有风，乡友情非浅。\n必欲相招延，春光况不远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬至吟","author":"邵雍","text":"何者谓之几，天根理极微。\n今年初尽处，明日未来时。\n此际易得意，其间难下辞。\n人能知此意，何事不能知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬至吟","author":"邵雍","text":"冬至子之半，天心无改移。\n一阳初起处，万物未生时。\n玄酒味方淡，大音声正希。\n此言如不信，更请问庖羲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"半醉吟 其一","author":"邵雍","text":"半醉上车儿，车儿稳碾归。\n轻风迎面处，翠柳拂头时。\n意若兼三事，情如拥九麾。\n这般闲富贵，料得没人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古琴吟","author":"邵雍","text":"长随书与棋，贫亦久藏之。\n碧玉琢为轸，黄金拍作徽。\n典多因待客，弹少为求知。\n近日僮奴恶，须防煮鹤时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"史画吟","author":"邵雍","text":"史笔善记事，画笔善状物。\n状物与记事，二者各得一。\n诗史善记意，诗画善状情。\n状情与记意，二者皆能精。\n状情不状物，记意不记事。\n形容出造化，想像成天地。\n体用自此分，鬼神无敢异。\n诗者岂于此，史画而已矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四者吟","author":"邵雍","text":"目时然后视，耳时然后听。\n口时然后言，身时然后行。\n前不见厚禄，后不见重兵。\n惟其义所在，安知利与名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四贤吟","author":"邵雍","text":"彦国之言铺陈，晦叔之言简当。\n君实之言优游，伯淳之言调畅。\n四贤洛阳之名望，是以在人之上。\n有宋熙宁之间，大为一时之壮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四喜","author":"邵雍","text":"一喜长年为寿域，二喜丰年为乐国。\n三喜清闲为福德，四喜安康为福力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四道吟","author":"邵雍","text":"天道有消长，地道有险夷。\n人道有兴废，物道有盛衰。\n兴废不同世，盛衰不同时。\n奈何人当之，许多喜与悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失诗吟","author":"邵雍","text":"胸中风雨吼，笔下龙蛇走。\n前后落人间，三千有馀首。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"头白吟","author":"邵雍","text":"头白已多时，况能垂白髭。\n不如犹甚幸，窃比未全衰。\n润屋虽无镪，承家却有儿。\n敢言贫净洁，似我亦应稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对花吟","author":"邵雍","text":"春在花争好，春归花遂残。\n好花留不住，好客会亦难。\n酒既对花饮，花宜把酒看。\n如何更斟满，乃尽此时欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对花吟","author":"邵雍","text":"今年花似昔年开，今日人开昔日怀。\n烦恼全无半搯子，喜欢长有百来车。\n光阴已过意未过，齿发虽颓志未颓。\n人问尧夫曾出否，答云方自洞天回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戊申自贻","author":"邵雍","text":"虽老仍思鼓缶歌，庶几都未丧天和。\n明夷用晦止于是，无妄生灾终奈何。\n似箭光阴头上去，如麻人事眼前过。\n中间若不自为计，所损其来又更多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"未有吟 其一","author":"邵雍","text":"未有一分功，先立十分敌。\n所得无分毫，所丧无纪极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生日吟","author":"邵雍","text":"辛亥年，辛丑月，甲子日，甲戌辰。\n日辰同甲，年月同辛。\n吾于此际，生而为人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生日吟","author":"邵雍","text":"三万五千日，伊予享此身。\n当时才作物，此际始为人。\n久负阴阳力，终亏父母恩。\n一杯为寿酒，床下列儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生平与人交","author":"邵雍","text":"生平与人交，未始有甘坏。\n己亦无负人，人亦无我害。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"生男吟","author":"邵雍","text":"我本行年四十五，生男方始为人父。\n鞠育教诲诚在我，寿夭贤愚系于汝。\n我若寿命七十岁，眼前见汝二十五。\n我欲愿汝成大贤，未知天意肯从否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"训世孝弟诗十首 其七","author":"邵雍","text":"子孝亲兮弟敬哥，光阴掷过疾如梭。\n庭闱乐处儿孙乐，兄弟和时妯娌和。\n孝弟传家名不朽，金银满匮富如何。\n要知美誉传今古，子孝亲兮弟敬哥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"训世孝弟诗十首 其八","author":"邵雍","text":"子孝亲兮弟敬哥，晨昏定省莫蹉跎。\n一门孝友真难得，百岁光阴最易过。\n和乐且耽宜自翕，彝伦攸叙在谦和。\n斑衣舞罢埙篪奏，子孝亲兮弟敬哥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"训世孝弟诗十首 其九","author":"邵雍","text":"子孝亲兮弟敬哥，吁嗟分拆听搬唉。\n囊中财物他嫌少，祖上田园你要多。\n夫妇眼前虽快乐，儿孙日后恐消磨。\n何如孝弟亲乡党，子孝亲兮弟敬哥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"训世孝弟诗十首 其十","author":"邵雍","text":"子孝亲兮弟敬哥，丈夫休听室人唉。\n眼前金帛毋嫌少，膝下儿孙不厌多。\n但得家和贫也好，若教不义富如何。\n王韩孝友垂青史，子孝亲兮弟敬哥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"议论吟","author":"邵雍","text":"事苟非，自有异。\n事苟是，安有二。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"争让吟","author":"邵雍","text":"有让岂无争，无沿安有革。\n争让起于心，沿革生于迹。\n羲轩让以道，尧舜让以德。\n汤武争以功，桓文争以力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"先几吟","author":"邵雍","text":"先几能识是吾侪，慎勿轻为世俗咍。\n把似众中呈丑拙，争如静里且谈谐。\n奇花万状皆输眼，明月一轮长入怀。\n似此光阴岂虚过，也知快活作人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"先天吟","author":"邵雍","text":"先天天弗违，后天奉天时。\n弗违无时亏，奉时有时疲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"先天吟","author":"邵雍","text":"先天事业有谁为，为者如何告者谁。\n若谓先天言可告，君臣父子外何归。\n眼前伎俩人皆晓，心上功夫世莫知。\n天地与身皆易地，己身殊不异庖羲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"先天吟示邢和叔","author":"邵雍","text":"一片先天号太虚，当其无事见真腴。\n胸中美物肯自衒，天下英才敢厚诬。\n理顺是言皆可放，义安何地不能居。\n直从宇泰收功后，始信人间有丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"共城十吟 其一 春郊閒居","author":"邵雍","text":"居处虽近郭，不欲登城市。\n尽日客不来，至夜门犹闭。\n院静春正浓，窗閒昼复寐。\n谁知藜藿中，自有诗书味。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"共城十吟 其三 春郊芳草","author":"邵雍","text":"春风必有刀，离肠被君断。\n春风既无刀，芳草何人剪。\n肠断不复接，草剪益还生。\n谁人有芳酒，为我高歌倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"共城十吟 其五 春郊寒食","author":"邵雍","text":"郭外花亦繁，不谓繁华失。\n幸非在郭中，不见繁华物。\n不寒不暖天，半阴半晴日。\n花外鞦韆鸣，月隔鞦韆出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兴亡吟 其一","author":"邵雍","text":"孙陈李三人，亡国体相似。\n虽然少有文，何复语英气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"兴亡吟 其二","author":"邵雍","text":"曹刘孙三人，兴国体相似。\n虽然小有才，何复语命世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刑名吟","author":"邵雍","text":"君子多近名，小人多近刑。\n善恶有异同，一归与任情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同府尹李给事游上清宫","author":"邵雍","text":"洛城二月春摇荡，桃李盛开如步障。\n高花下花红相连，垂杨更出高花上。\n闲陪大尹出都门，邙阜真宫共寻访。\n不见翠华西幸时，临风尽日独惆怅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]