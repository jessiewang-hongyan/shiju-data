[{"title":"题余氏攀鳞轩","author":"朱淑真","text":"潇洒新轩傍翠岑，攀鳞勃勃此潜心。\n易惊谁羡叶公室，入梦当为傅说霖。\n变化一身雷霹远，腾凌千里海波深。\n卧庐曾比崇高志，肯忆当时梁父吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送人赴试礼部","author":"朱淑真","text":"春闱报罢已三年，又向西风促去鞭。\n屡鼓莫嫌非作气，一飞当自卜冲天。\n贾生少达终何遇，马援才高老更坚。\n大抵功名无早晚，平津今见起菑川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题四并楼","author":"朱淑真","text":"华榜危楼岂浪名，人间四者此环并。\n日知光景无虚度，时觉清风满座生。\n庾亮据床谈兴逸，仲宣倚槛客愁轻。\n眼前此乐难兼得，许我登临载酒行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题斗野亭","author":"朱淑真","text":"高亭忽登览，豁尔思无穷。\n访古多遣迹，留题有钜公。\n地分吴楚界，人在斗牛中。\n不是乘槎客，那知此路通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟行即事七首 其二","author":"朱淑真","text":"扁舟欲发意何如，回望乡关万里馀。\n谁识此情肠断处，白云遥处有亲庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟行即事七首 其七","author":"朱淑真","text":"岁节将残恼闷怀，庭闱献寿阻传杯。\n此愁此恨人谁见，镇日柔肠自九回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卧龙","author":"朱淑真","text":"角瑩纤琼鳞粲金，拥珠闲卧紫渊深。\n时来天地云雷举，起作人间救旱霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"惜花","author":"朱淑真","text":"病眼看花似梦中，一番次第又飞空。\n朝来不忍倚树立，倚树恐摇枝上红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹 其一","author":"朱淑真","text":"一径浓阴影覆墙，含烟敲雨暑天凉。\n猗猗肯羡夭桃艳，凛凛终同劲柏刚。\n风籁入时添细韵，月华临处送清光。\n凌冬不改青坚节，冒雪何伤色转苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江上阻风","author":"朱淑真","text":"正阻行程江岸间，江头三日系归船。\n水光激浪高翻雪，风力推沙远涨烟。\n拔闷喜陪尊有酒，供厨不虑食无钱。\n雕章见及唯虚辱，勉强赓酬愧斐然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"笔","author":"朱淑真","text":"双毫五彩兔狸锋，珍与欧阳象管同。\n多谢寄来情意重，从今敢废墨池工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"莺","author":"朱淑真","text":"野花啼鸟喜新晴，湖上波光漾日明。\n底事伤春心绪懒，不堪愁里听莺声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三月三日","author":"朱淑真","text":"林花落尽草初齐，客里萧条思欲迷。\n又是春光去时节，满城飞絮乱莺啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清明游饮少湖庄","author":"朱淑真","text":"清明玩赏正繁华，今日林梢落尽花。\n人散酒阑春已去，一泓初涨满池蛙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏柳二首 其一","author":"朱淑真","text":"长丝袅娜拂溪垂，乳絮风吹漠漠飞。\n全惜东风与为主，年年先占得韶晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏柳二首 其二","author":"朱淑真","text":"风牵袅袅摇无定，翠影侵阶已午天。\n花发鸟歌春景媚，好看柔软吐香绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桃花","author":"朱淑真","text":"每对春风竞吐芳，胭脂颜色更浓妆。\n含羞自是不言者，从此成蹊入醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李花二首 其一","author":"朱淑真","text":"满园花发白于梅，又与红桃并候开。\n可口直须成实后，莫将苦种路旁栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李花二首 其二","author":"朱淑真","text":"小小琼英舒嫩白，未饶深紫与轻红。\n无言路侧谁知味，惟有寻芳蝶与蜂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅","author":"朱淑真","text":"雪格冰姿蜡蒂红，水边山畔淡烟笼。\n江风也似知人意，密递清香到室中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏夜弹琴","author":"朱淑真","text":"夜久万籁息，琴声愈幽寂。\n接引到清江，岩泉溜寒滴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蜡梅","author":"朱淑真","text":"天然金蕊冠群英，谁信鹅黄染得成。\n昨夜南枝报春信，摘来香露月中清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏萤","author":"朱淑真","text":"熠熠迎宵上，林间点点光。\n初疑星错落，浑讶火荧煌。\n著雨藏花坞，随风入画堂。\n儿童竞追扑，照字集书囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观燕","author":"朱淑真","text":"深闺寂寞带斜晖，又是黄昏半掩扉。\n燕子不知人意思，檐前故作一双飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送燕","author":"朱淑真","text":"见尔来齐去亦齐，空巢零落屋庐低。\n更无心记衔泥处，花絮春风小院西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游旷写亭有作","author":"朱淑真","text":"旷写亭高四望中，楼台城郭正春风。\n笙歌富庶千门乐，市井喧哗百货通。\n叠叠民居还瓦屋，纷纷游蝶乱花丛。\n凭栏忽念非吾土，目断白云心莫穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈","author":"释祖觉","text":"一尘起，大地收。\n一叶落，天下秋。\n悬须弥于诸人鼻孔上，著大海于诸人眼睛中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"打马赋诗","author":"李清照","text":"佛狸定见卯年死，贵贱纷纷尚流徙。\n满眼骅骝杂騄駬，时危安得真致此。\n老矣谁能致千里，但愿相将过淮水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上韩公枢密 其二","author":"李清照","text":"想见皇华过二京，壶浆夹道万人迎。\n连昌宫里桃应在，华萼楼头鹊定惊。\n但说帝心怜赤子，须知天意念苍生。\n圣君大信明如日，长乱何须在屡盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午帖子 皇帝阁","author":"李清照","text":"日月尧天大，璿玑舜历长。\n侧闻行殿帐，多集上书囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午帖子 皇后阁","author":"李清照","text":"意帖初宜夏，金驹已过蚕。\n至尊千万寿，行见百斯男。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午帖子 夫人阁","author":"李清照","text":"三宫催解粽，妆罢未天明。\n便面天题字，歌头御赐名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春帖子 皇帝阁","author":"李清照","text":"莫进黄金簟，新除玉局床。\n春风送庭燎，不复用沈香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春帖子 贵妃阁","author":"李清照","text":"金环半后礼，钩弋比昭阳。\n春生百子帐，喜入万年觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"分得知字韵","author":"李清照","text":"学诗三十年，缄口不求知。\n谁遣好奇士，相逢说项斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春残","author":"李清照","text":"春残何事苦思乡，病里梳头恨最长。\n梁燕语多终日在，蔷薇风细一帘香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感怀","author":"李清照","text":"寒窗败几无书史，公路可怜竟至此。\n青州从事孔方君，终日纷纷喜生事。\n作诗谢绝聊闭门，燕寝凝香有佳思。\n静中我乃得知交，乌有先生子虚子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钓台","author":"李清照","text":"巨舰只缘因利往，扁舟亦是为名来。\n往来有愧先生德，特地通宵过钓台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"李清照","text":"南渡衣冠欠王导，北来消息少刘琨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"李清照","text":"南游尚怯吴江冷，北狩应悲易水寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其四","author":"李清照","text":"炙手可热心可寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其五","author":"李清照","text":"露花倒影柳三变，桂子飘香张九成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其六","author":"李清照","text":"两汉本继绍，新室如赘疣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其七","author":"李清照","text":"所以嵇中散，至死薄殷周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其八","author":"李清照","text":"诗情如夜鹊，三绕未能安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其九","author":"李清照","text":"少陵也自可怜人，更待来年试春草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十一","author":"李清照","text":"水晶山枕象牙床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十二","author":"李清照","text":"彩云易散月长亏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十三","author":"李清照","text":"几多深恨断人肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十四","author":"李清照","text":"罗衣消尽恁时香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十五","author":"李清照","text":"闲愁也似月明多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十六","author":"李清照","text":"直送凄凉到画屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余旧供观音比得蒋颖叔所传香山成道因缘叹仰灵异因为赞于后","author":"张守","text":"大哉观世音，愿力不思议。\n化身千百亿，于一刹那顷。\n香山大因缘，悯念苦海众。\n慈悲示修證，欲同到彼岸。\n受辱不退转，是乃忍辱仙。\n抉眼断两手，不啻弃涕唾。\n欻然千手眼，照用无边际。\n至人见与执，不在千手眼。\n向来弃去时，初无一毫欠。\n乃至以千记，我亦无赢馀。\n是故将示寂，还复本来相。\n犹如大虚空，云电或风霾。\n须臾各霁止，太虚自寥廓。\n我今仰灵踪，欢喜发洪愿。\n今生未丧世，誓愿永归依。\n更与见闻者，同登无上法。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方时敏倅浚归浙江待次送行","author":"张守","text":"嶷嶷玄英孙，闻风自鄞川。\n朅来苕霅间，王事亦复联。\n相遇一倾盖，论交即忘年。\n开口见城府，落笔生云烟。\n寻春五亭岸，钓月双溪船。\n杯行各酣适，箕踞忘拘牵。\n放辞发奇伟，搜句穷镵镌。\n我时怯欲降，退壁常自坚。\n俯首试外台，一矢双雕连。\n联镳仲与季，三秀来差肩。\n群隽为辟易，拱手不敢前。\n折箠破大敌，未足烦戈鋋。\n风低忽垂翅，信命付诸天。\n公飞东阳舄，我访兰亭贤。\n双鱼数流问，五马方荐延。\n摄事古山阴，晤语复粲然。\n禅心扣空寂，蔬饭捐荤膻。\n一洗尽玷缺，皎皎尺璧圆。\n继从甘陵游，假道仍周旋。\n飘零我蓬转，渠敢自意全。\n邂逅凤凰阙，公亦仍迍邅。\n宦学旧辈行，金狨覆文鞯。\n以及后来秀，青云各联翩。\n公方驾别车，去即三山巅。\n俟期下吴越，寄迹无一廛。\n尚及秋风残，饱脍鲈鱼鲜。\n我陋不足数，生理亦可怜。\n尔来犯不韪，策足英俊躔。\n文羞白羽扇，中岂青铜钱。\n家风故不恶，蹇步徒加鞭。\n迷途得蹭蹬，奄奄如寒蝉。\n别公起归思，端欲驱其先。\n经营一囊粟，攀附嗟无缘。\n擿耳听知音，拂拭朱丝弦。\n一札行亦驰，两桨定复还。\n阔步白玉堂，一挥笔如椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贵溪道中寄信州夏蒙夫使君","author":"张守","text":"薄晚雪逾密，助寒风更颠。\n长涂客衣薄，仆马僵不前。\n绿林轸玉食，渠敢叹独贤。\n行喜见故人，羁怀得披宣。\n冰花散渺莽，玉树争清妍。\n遥知坐啸馀，铃斋耸吟肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和","author":"张守","text":"六花照老眼，令我喜欲颠。\n顷刻万株玉，巧趁春风前。\n伫立听风谣，诵言使君贤。\n不事厨传饰，皇化忧不宣。\n相见虽苍颜，妙语加韶妍。\n小邦犹射鼠，安用弯黄肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"来诗过有称誉再和","author":"张守","text":"任重非所胜，位高忧疾颠。\n归耕半顷秫，荣枯付樽前。\n来作江南牧，衰谢愧五贤。\n喜闻复故境，中兴颂周宣。\n贤能不复遗，纡馀定为妍。\n勿笑百僚尾，三署会须肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢孙仲益察院借示诗卷","author":"张守","text":"客游跨两春，胸次饱尘滓。\n无人抉河汉，为我一浣洗。\n故人富清制，放笔如翻水。\n此间渺无津，滂沛到笔底。\n长须遣大轴，光彩照窗几。\n我时食对案，惊喜失箸匕。\n风雅间何阔，稍复闻正始。\n涤除尘想灭，肝肺挹清泚。\n早年上金闺，气劘诸彦垒。\n风斤运无旁，四座羞血指。\n骎骎跨骢马，奔轮不容柅。\n负大难为力，得坎聊复止。\n熙辰崇盛典，润色待东里。\n风云吐愤郁，事业振奇伟。\n馀暇赋天台，金声追祖祢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"洪庆善提刑罢官过建康惠诗和答","author":"张守","text":"若人儒林秀，俊声自孩提。\n振鬣日千里，众眼惊月题。\n盍登要路津，献纳苏黔黎。\n聊乘使者车，枳棘非鸾栖。\n戢翼下吴会，客路秋风凄。\n弭帆江之滨，归梦先苕溪。\n寄傲水南北，忘怀玉东西。\n况乃味禅悦，已知昔途迷。\n坐笑老婆禅，杖拂劳提撕。\n祗应浩然气，中宵吐虹霓。\n功名傥来遇，未免云衢跻。\n秖今宠辱际，渊澄看旋鲵。\n龙钟秣陵守，短发那胜篦。\n邂逅见亹亹，野鹤羞凡鸡。\n言句谢筌筏，未易穷端倪。\n归来见詹尹，宁复问突梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题王岩起乐斋","author":"张守","text":"静者悦山林，夸者慕钟鼎。\n人生各有适，所乐滞一境。\n王郎超世姿，名教得深省。\n穷通付风雨，一笑万累屏。\n闲居秖蔬水，开卷味自永。\n从事虽贤劳，游刃失綮肯。\n此心故休休，阅世徒耿耿。\n开轩理松菊，留客办果茗。\n得趣地自偏，无尘句尤警。\n他年观出处，廊庙即箕颍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"澄怀庵","author":"张守","text":"忆昨避寇乱，与君连一墙。\n别来几寒暑，杳如参与商。\n君与丧乱际，徜徉水云乡。\n十年林下梦，不到声利场。\n结庵劣容膝，不为大盗藏。\n此怀那须澄，已作冰雪凉。\n花竹供四时，饮水乐未央。\n何当谢尘鞅，解缨濯沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岚光台","author":"张守","text":"云山屹长空，烟水湛深渌。\n筑台万象表，领略在吾目。\n凝岚翠欲流，烟光炯堪掬。\n尽洗缨上尘，长照杯中醁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四达亭","author":"张守","text":"胸中浩无旁，吞纳九云梦。\n高怀有所寄，亭中亦空洞。\n凉月侵风棂，寒烟逼晓栋。\n达人意有馀，未许俗子共。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题闾丘氏巢凤亭以其子登科胡茂老名之","author":"张守","text":"令君命卿家，一经世遗子。\n煌煌丹桂枝，寂寞踰五纪。\n朅来山水县，辟馆贮书史。\n竹梧森翠碧，鸾鹄自停峙。\n翩翩丹穴雏，一鸣惊众耳。\n綷羽览辉翔，百鸟各披靡。\n英姿凌云气，玉颊编贝齿。\n唾手取青毡，父老为惊喜。\n宁无英妙年，亦或拾青紫。\n上堂拜重庆，此事世无比。\n勉哉尊所闻，烟霄千万里。\n五斗暂折腰，百鍊无绕指。\n矫翼仪舜韶，作瑞明光里。\n来者玩兹亭，甘棠同勿毁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和曾宏父告别兼简幕属","author":"张守","text":"奉诏辞北阙，把麾到南州。\n向来政已拙，老去语更偷。\n条教虽屡下，疮痍何时瘳。\n犹喜豺虎息，稍解圣主忧。\n英英幕中彦，红蕖汎清流。\n袖手听婉画，药石兼珍羞。\n衰迟樗栎姿，万一桑榆收。\n吾人南丰秀，未应仄席求。\n飘泊乘别车，惠然肯来游。\n周旋见家规，会合非人谋。\n清诗日砻琢，不厌枯肠搜。\n束书赴嘉招，掉臂不我留。\n我无青玉案，何以报所投。\n从兹谢泪洳，龙门看吞舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秦楚材和六一先生秋怀因次韵送别","author":"张守","text":"抱衅久羸瘠，兀若槁木枝。\n别离故作恶，未别意已悽。\n况此清商时，木落水潦归。\n舣舟话心曲，未了舟欲移。\n借问何匆匆，直恐违官期。\n念此登临意，何止骚人悲。\n子行不可留，子鬓殊未衰。\n痛饮置人事，江上鲈鱼肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客居闻雁有感","author":"张守","text":"涎涎社燕尾，嗈嗈霜雁声。\n两物巧相避，寸阴不得停。\n我来燕未归，倏见雁南征。\n客游何当还，节物凛可惊。\n哀歌抚长铗，独夜羞短檠。\n念营堂上巢，愧尔飞冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]