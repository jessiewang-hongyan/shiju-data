[{"title":"冬至夜斋中不寐遥想郊丘盛礼二首 其一","author":"宋庠","text":"阳郊陪礼忽三年，目想坛觚切绛烟。\n今夕纤萝还不动，百神应到紫宫前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月十日作 其一","author":"宋庠","text":"万里春晖荡晓空，芳心何处不融融。\n惟馀两鬓无情雪，最耐人间解冻风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月十日作 其二","author":"宋庠","text":"偶随和气上层台，河里风烟已暗开。\n空说虎牢天地险，不知春色过关来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春","author":"宋庠","text":"曾见青旂上苑回，瑞幡仙萼剪刀催。\n朝来独曝茅檐日，且暖蓬心一寸灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙兴题额","author":"宋庠","text":"八法神毫焕宝题，至今鸾鹊欲惊飞。\n临空莫遣流尘晦，幸有仙人拂石衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再到小园见落花有感 其一","author":"宋庠","text":"雨馀春色太匆匆，已有残英满地红。\n先落后开应定分，一般迟日一般风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再到小园见落花有感 其二","author":"宋庠","text":"急雨前旬滞客筵，群葩何事亦翩翩。\n风长日暖东君醉，无限宫娃失翠钿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再葺流杯亭兼得今翰林胡学士旧记石刻移置坐隅郡人以为宠","author":"宋庠","text":"重凿琼波弄酒船，翠珉英藻更相鲜。\n从兹春意无销歇，长似山阴癸丑年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同吴侍郎小园池上送杨端明归马上口占","author":"宋庠","text":"偶作河梁饯，翻为池上宾。\n归骖不忍驾，新月共留人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"因览子京西州诗藁感知音之难遇偶成短章","author":"宋庠","text":"小集曾因善叙传，西州馀藻复盈编。\n中郎久已成枯骨，争奈柯亭十六椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"因游东园奉寄交代张龙图","author":"宋庠","text":"修篁绿水已成阴，秀柏凌霜尽直寻。\n今日思人还爱树，岁寒颜色岁寒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夙兴","author":"宋庠","text":"梦惊单枕拂霜毛，月影初低烛影高。\n枝上万禽犹寂寂，寒鸡何事独三号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮北楼晚景","author":"宋庠","text":"楼上人惊岁律残，鲁郊齐垒有无间。\n夕阳高鸟知何意，飞尽青冥不肯还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早谒","author":"宋庠","text":"匹马中衢类断蓬，疏星残月共寒空。\n汉家未给千门钥，弛镫墙阴避宪骢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早渡洛水见流澌尽解春意感人马上偶成戏咏二首 其二","author":"宋庠","text":"洛浦冰消润袜尘，野禽何处不呼春。\n柳梢弄色花条软，已似遥嗤白首人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早渡洛水见流澌尽解春意感人马上偶成戏咏二首 其一","author":"宋庠","text":"春色东来不待招，烟光已过洛阳桥。\n如何解尽人间冻，鬓畔霜华转不消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂感 其二","author":"宋庠","text":"枉尺由来贱直寻，巧机愁杀汉川阴。\n莫将三四为朝暮，虚搅群狙喜怒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂感 其一","author":"宋庠","text":"从古忠贤困佞邪，区区尘册费长嗟。\n谗人肉味知何似，豺虎刚嫌污齿牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和丁右丞因赠致政张少卿二首 其二","author":"宋庠","text":"芝朮新园御陌东，飘然云鹤此相从。\n贵交亦有功成约，林下他年或见容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和丁右丞因赠致政张少卿二首 其一","author":"宋庠","text":"几年辞宠解华绅，佛忍庄恬共啬神。\n岁晏始知松柏茂，凌云高节不关春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和石学士见寄十首 其十","author":"宋庠","text":"老去勤勤念一丘，已将身世上虚舟。\n济川善谑情虽厚，似倚清才恼白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和石学士见寄十首 其九","author":"宋庠","text":"亲见仙科唱第时，宠均宣室对神釐。\n汉台诏令方深厚，好取名郎作训辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和石学士见寄十首 其八","author":"宋庠","text":"久厕鸾鸿刷羽翰，大都飞意倦须还。\n周南日夕归心动，笙月飘风尽有山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和石学士见寄十首 其七","author":"宋庠","text":"荣路徘徊力已疲，保全恩惠剧春熙。\n须知散栎无庸日，方到群材搆厦时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":48483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和石学士见寄十首 其六","author":"宋庠","text":"掉臂论交俗久讹，夫君高意遏颓波。\n蕣华暮落松凌雪，借问凋芳校几何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","com