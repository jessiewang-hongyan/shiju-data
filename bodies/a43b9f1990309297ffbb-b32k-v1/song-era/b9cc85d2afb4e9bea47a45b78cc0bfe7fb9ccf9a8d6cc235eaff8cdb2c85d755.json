[{"title":"偈颂一百零九首 其十","author":"释可湘","text":"拨尘见佛，佛亦是尘。\n山僧脚布作炊巾，眼不见为净。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其五","author":"释可湘","text":"黄檗打临济，义出丰年。\n兴化赶克宾，虾为子屈。\n其功盖代，只要重论。\n一火铸成金弹子，棒头敲出玉麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其十二","author":"释可湘","text":"悉达出头来，卖弄丑举止。\n云门打不杀，德山呵不起。\n晓间园里听莺啼，昔日毗岚今宛尔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其二十三","author":"释可湘","text":"冬节前后，砂飞石走。\n忽忆沩山两凤毛，进前退后扬家丑。\n毕竟九岩作么生，面南看北斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其二十七","author":"释可湘","text":"黄面老，初成道，誇诧一场相鼓倒。\n雪岭峨峨雪未消，星河湛湛星犹皎。\n诸人冷地眼开时，莫似贫儿拾得宝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其七十八","author":"释可湘","text":"十方国土中，惟有一乘法。\n如何是一乘法，梅雨过，芰荷香，薰风殿阁生微凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其六十五","author":"释可湘","text":"今朝五月五，及时道一句。\n无山可采药，有水堪竞渡。\n江心如许大龙舟，聚集梢郎同驾御。\n彼岸不著，此岸不居。\n只个中流，住无所住。\n机先夺得锦标归，石女木人争起舞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其五十","author":"释可湘","text":"吴山青，越山青。\n揖让分宾主，低昂见弟兄。\n中间一句，风静潮平。\n满堂皆顾陆，捉笔画难成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其八十二","author":"释可湘","text":"金乌飞，玉兔驰。\n归来重会面，动是隔年期。\n鼻头垂下元如旧，三昧依前各不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其一○三","author":"释可湘","text":"娑罗双树间，瞿昙展脚睡。\n一睡二千年，而今醒也未。\n醒了也，足观瞻。\n山花开似锦，涧水湛如蓝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其八十六","author":"释可湘","text":"清明前，寒食后，处处扫松，家家插柳。\n祖意甚分明，茫然不知有。\n三皇冢上绝人游，芳草连天髑髅吼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其九十八","author":"释可湘","text":"前时向者里抽钉拔楔，而今却要添钉著楔。\n前时向者里解粘去缚，而今却要添绳加索。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其七十","author":"释可湘","text":"无门之门须得门而入，无意之意须得意而通。\n一扇西兮一扇东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其五十九","author":"释可湘","text":"衲子奔相看，相看莫相负。\n饮水须贵脉，入门富弁主。\n问讯时，揖茶处，总为诸人开活路。\n若是谢三郎，扬眉便归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其七十四","author":"释可湘","text":"太白峰头月，寒泉水底灯。\n清光分上下，千里恰同明。\n一点不来翻夜雨，难谩迦叶老师兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其六十四","author":"释可湘","text":"江上山，山上寺。\n门对斗城开，东西分两序，总不得动著。\n是法住法位，世间相常住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其七十六","author":"释可湘","text":"今朝三月十五，眨眼又见春暮。\n尺璧难酬寸阴，白日岂宜虚度。\n可怜杜宇一声声，啼得血流无用处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其八十五","author":"释可湘","text":"三声鼎盖普门开，苦海劳生唤不回。\n九十春光今又半，空飞花片点莓苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其六十九","author":"释可湘","text":"建法幢，立宗旨。\n既承师训，合听官差。\n且宗旨法幢作么生建立。\n行船同一命，方屯飞虎于江心。\n打鼓召三军，又布长蛇于雪岭。\n海宇顿清犹带甲，心王亲睹始休兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其四十八","author":"释可湘","text":"凌霄队里，昔曾合火分赃。\n小朵峰前，善贾不停死货。\n横身那畔，鹘眼迷踪。\n归根深得旨，落叶舞西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其三十一","author":"释可湘","text":"祖翁活业，无减无增。\n纵不挨究，亦自分明。\n古田蓄水重重绿，野烧迎春渐渐青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其六十","author":"释可湘","text":"东家点灯，西家暗坐。\n一样元宵，生涯各做。\n暗坐底默默提撕，点灯者明明照破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其九十三","author":"释可湘","text":"重阳节，何可说。\n篱菊新开剪剪金，霜柑微露团团月。\n元亮攒眉回去见境生情，闽王特地缄来弄巧成拙。\n处处登高看不彻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其一○七","author":"释可湘","text":"药山久不上堂，石中蕴玉。\n院主率先启请，眼里无珠。\n昧一己而且从，误三军尤可悯。\n大似??鸟守空池，鱼从脚下过，??总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其五十四","author":"释可湘","text":"不是心，亦非佛。\n玉兔东升，金乌西没。\n循环不暂停，究竟知何物。\n那个男儿腕力强，一槌击碎精灵窟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其八","author":"释可湘","text":"风不来，树不动。\n沩仰父子，互呈体用。\n三十乌藤话已行，万牛回首丘山重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其九十四","author":"释可湘","text":"两肩担不起，压倒世间人。\n觌体常现前，知他是什么。\n纵使六阴塞户，无欠亦无馀。\n假饶一气转钧，同明复同暗。\n瞿昙广说，达磨直指。\n诘其端由，全没巴鼻。\n蓦见阳生第一爻，九九元来八十二。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其四","author":"释可湘","text":"触目未尝无，临机道什么。\n钱是足陌，物是定价。\n坐破七个蒲团，卷帘方见天下。\n千里追风非骏马。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其七十一","author":"释可湘","text":"顽钝以此销镕，偏小以此弹击。\n直中曲，曲中直。\n老卢不会，达磨不识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其一","author":"释可湘","text":"祖翁阃域，扑地掀天。\n亲切一回打透，不妨垂手入廛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其五十五","author":"释可湘","text":"雪山高几何，矗矗在天表。\n咄哉竺土仙，六年登不到。\n登得到，绝之绕，背手摘南辰，下视众峰小。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其三十","author":"释可湘","text":"道道，非常道。\n踏不嗔，闹浩浩。\n莫管自家知不知，但看大熟秋成早。\n今日无端入荒草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其六十八","author":"释可湘","text":"摩胸告，展脚示。\n有来由，没巴鼻。\n佛灭二千年，比丘少惭愧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其二十六","author":"释可湘","text":"十方同聚会，瞎驴趁大队。\n个个学无为，眉上更安眉。\n此是选佛场，屎窖立封疆，心空及第归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其七十七","author":"释可湘","text":"仰天湾下，喝石岭头。\n昔年落赚，覆水难收。\n当堂称父子，背面是冤仇。\n影也不愿再见，岂料界随相逐同到福州。\n莫莫莫，休休休。\n粗香强撮土，说破不为雠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其四十七","author":"释可湘","text":"日月如梭，光阴似箭。\n目前一机，万化千变。\n甚处见得，西风一阵来，落叶两三片。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其一○一","author":"释可湘","text":"沩仰两爷儿，采茶机对机。\n只知呈体用，不觉露枪旗。\n正值风和日暖，何妨把手同归，子规啼破已多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其九十九","author":"释可湘","text":"朱行军威掩万众，特露太阿。\n济上座气盖诸方，不顾性命。\n选佛若无如是眼，宗风争得到于今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其四十","author":"释可湘","text":"古佛以慈悲为室，山僧以怒骂为室。\n且要活捉生蛇，逼教角出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其三十五","author":"释可湘","text":"多处添，少处减。\n家常用度，文不加点。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其三十七","author":"释可湘","text":"心不是佛，智不是道。\n唯此一事，如何寻讨。\n赤水得之非珍，昆岗拾来非宝。\n寒山子，曾了了。\n微风吹幽松，近听声愈好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其四十五","author":"释可湘","text":"春日迟迟，春花烂烂。\n般若灵光，显然无间。\n捏不聚兮拨不散。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其八十","author":"释可湘","text":"九日正当期，登高报众知。\n黄花到处有，岂独在东篱。\n难逢美景，采出一枝。\n触目无人明此意，何妨自插满头归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其十一","author":"释可湘","text":"薄福住常云，生涯只任真。\n灯笼悬露柱，北斗对南辰。\n法法皆依位，机机合见人。\n大家齐努力，扶起破沙盆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其四十三","author":"释可湘","text":"身不离座，座不离身。\n须弥灯王，又是何人。\n老来抬脚重千斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其三十四","author":"释可湘","text":"咬定牙关，全提杀活。\n刳文殊胫，拔维摩舌。\n更有一机，不说不说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其四十二","author":"释可湘","text":"劄住智者颊舌，剖出达磨骨髓。\n长剑倚天，寒光焰焰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其十七","author":"释可湘","text":"每怜纸撚揾无油，将底光辉古荡湫。\n今日元宵时节至，也还水上挂灯毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其五十二","author":"释可湘","text":"春山叠乱青，春水湛虚碧。\n豁开楼阁门，分身千百亿。\n一念差，云羃羃，善财无路寻知识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其二十一","author":"释可湘","text":"佛祖眼睛，衲僧命脉。\n触境遇缘，单重交拆。\n桃花红，李花白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其一○二","author":"释可湘","text":"始见桃花李花，又见榴花藕花。\n金色头陀，已归鸡足，灵云老子，杳隔天涯。\n安得风流出当家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其三十三","author":"释可湘","text":"几次淘澄，半生熬炼。\n直教气息全无，脱体精明自现。\n粗细短长，突出难辨。\n不是心，不是佛，不是物，分晓一团银绣线。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其二十二","author":"释可湘","text":"拶透大圆觉，平地沉山岳。\n翻笑刻舟人，无绳徒自缚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其五十一","author":"释可湘","text":"灌顶云收，峨眉月昼。\n父翁一片肝肠，宛如生铁铸就。\n弟应兄呼，全机漏逗。\n苏州菱，邵伯藕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其三","author":"释可湘","text":"一释迦，二元和，三佛陀。\n阿呵呵，团栾且唱太平歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其四十一","author":"释可湘","text":"开天门，辟地户。\n震法雷，击法鼓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其六十六","author":"释可湘","text":"巾子峰头云开云合，龙翔江上潮落潮平。\n师承底事，的的分明。\n风前不必兄呼弟，见后毋劳弟应兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其一○四","author":"释可湘","text":"象骨飞冰片，鳌山吃雪团。\n家风严冷甚，觑著骨毛寒。\n声价腾今耀古，馨香炙地薰天。\n年年不断一炉烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其六十三","author":"释可湘","text":"追忆仙游辇未还，特输忠赤举风幡。\n掣开玉殿黄金锁，最忌当头触圣颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其三十六","author":"释可湘","text":"乾纸燃，漏灯盏，茫茫蹉过人何限。\n当头点出许谁看，三世如来同个眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其一○九","author":"释可湘","text":"药山索盐，云岩奉马。\n父子一家，风流儒雅。\n我也有个木毬，亦要辊上辊下。\n沙弥在么，出手不来，还成滞货。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其五十七","author":"释可湘","text":"瞿昙出母胎，胆志大如斗。\n方学小儿行，便作狮子吼。\n水在湖，杓在手，乘时荡向无何有。\n也胜云门老古锥，药囊空掉丧车后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其九十二","author":"释可湘","text":"世事悠悠，美景难留。\n不可寝于长夜，须来共赏中秋。\n天宇净，桂花浮。\n一片月生海，几家人上楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其四十九","author":"释可湘","text":"一脚跨西天，只履驻东土。\n缺齿老臊胡，自来行阔步。\n儿孙遍地觅踪由，长忆年年十月五。\n嗈嗈兮寒雁鸣云，凛凛兮霜风袭户。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其二十","author":"释可湘","text":"老瞿昙，没碑记。\n占慈氏机先，埋通天界至。\n也须还我坐具地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其七十九","author":"释可湘","text":"平明始立秋，冷已到山头。\n谈风说露兮蜩蝉嘒急，咏砌吟墙兮蟋蟀声浮。\n不作佛法商量，不作时景话会。\n观世音菩萨将钱买胡饼，放下手却是生铁一块。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其八十九","author":"释可湘","text":"心王宁，六国清。\n百川潮落，四海浪平。\n其如轇轕情尘，当遵古佛制，若也沉昏道眼，还待腊八冰。\n心王辽邈，孰睹其形。\n记得柏岩问洞山，观察使姓什么，不委他姓。\n名什么，不委他名。\n殆传尊贵语，举目隔神京。\n相留过夏，曲徇人情。\n往往都来欠一程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其一○○","author":"释可湘","text":"大藏小藏，尽从者里流出。\n放去千灯万焰，收来一月当天。\n只如不收不放一句作么生判断，上元定是正月半。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其八十一","author":"释可湘","text":"洞山首座吃果子，开口落空亡。\n雪峤两堂吞栗蓬，分头张意气。\n衲僧家，手是秤，眼是秤，轻也知，重也知。\n半斤八两，毫发无亏。\n争奈未明三八九，难辨力叻希。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其十八","author":"释可湘","text":"胸摩卐字，弄假像真。\n椁示双趺，弄真像假。\n柳垂金线舞春风，演说涅槃犹未罢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零九首 其九","author":"释可湘","text":"未举念，周游华藏。\n未下足，超越毗卢。\n若道一法在门外，笑倒文殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]