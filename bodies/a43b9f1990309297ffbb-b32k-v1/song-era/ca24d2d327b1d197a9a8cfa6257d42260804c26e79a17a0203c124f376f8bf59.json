[{"title":"送太守舒郎中赴阙 其二","author":"彭汝砺","text":"陋迹迟回寂寞滨，欲闻高谊叹无津。\n声华未及膺门客，揖让犹皆蜀守民。\n白日忽收千里诏，清风长挟万家春。\n穷途倾眷陶钧力，吟尽肝肠一惨神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送太守舒郎中赴阙 其三","author":"彭汝砺","text":"解郡西南促去程，扁舟西下照江明。\n旌麾益近青云路，剑佩行朝白玉京。\n势位久淹犹郡国，光华此去即公卿。\n山林愿听功名起，野拙犹能颂治声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过陶太尉庙","author":"彭汝砺","text":"刘石纷纭正忧戈，尽心收得晋山河。\n巍巍功业能如此，藉藉浮言意若何。\n风雨旧祠藏石壁，丹青遗像落江波。\n黄昏欲作溪头钓，愿丐当时壁上梭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伯兄归自桐江未至因有作示诸弟","author":"彭汝砺","text":"遥思徒驭去江干，道路谁何共险艰。\n长使庭闱终日望，不知车马几时还。\n伫期笑乐同尘席，应有文章慰病颜。\n酒瓮半空为收拾，筮言当见立谈间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将归寄润之弟","author":"彭汝砺","text":"纷纷穷绪不能禁，一缕俄惊百万寻。\n风月正牵相望眼，山川难系欲归心。\n萧条又作新秋意，牢落谁同永夜吟。\n车马鼎来吾即起，梦魂先傍竹亭阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉别张伯逢先生","author":"彭汝砺","text":"强鞭驽蹇逐尘踪，百驾方成跬步功。\n天地有心成草木，蚊蝇无力负衡嵩。\n纷然又见瓜期及，晚矣犹思吾道东。\n一寸古心长自歉，依依馀恨满西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"断编","author":"彭汝砺","text":"断编尘简即吾师，万里徘徊得路迟。\n览照忽惊颜色古，临空叹息羽毛衰。\n迂愚未尽田瞿学，庸贱空收鲍叔知。\n安有微波增海曲，愿因穷腊看松枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"高议","author":"彭汝砺","text":"高议轩昂破丽淫，清风遗散落尘襟。\n倚山渐识浮云意，临水方思太古音。\n无状欲随仁义老，未完犹怯是非侵。\n西归须念津涂惑，愿丐中庸镂腹心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牢落","author":"彭汝砺","text":"牢落归来水一隅，卧思天阙自烦纡。\n祇知今夕又明日，不觉少年成壮夫。\n祸去不虞堪太息，势临无备独长吁。\n忧时未有如君老，愿听丹囊上禁涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王太博自浮梁移蒙州作送之","author":"彭汝砺","text":"平时沉伏草莱间，见说昌江治政贤。\n爱浃羽毛人自畏，诗成金玉俗争传。\n一麾出守今行矣，万室倾思正惨然。\n祇恐又膺明诏去，蒙山无计重留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送周掾赴阙","author":"彭汝砺","text":"白驹一掷起尘埃，紫凤高鶱出草莱。\n盛德日随流水远，清声时逐好风来。\n百年正属文明际，万事犹须干济才。\n荐牍几多闻九极，宠章何日下三台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄伯兄兼问子文 其一","author":"彭汝砺","text":"富贵浪图虽汩汩，诗书馀力尚桓桓。\n圣门一室相从易，世路多岐欲合难。\n仪凤稳依深阁宿，老蛟寒即碧溪蟠。\n青云有侣歌鱼藻，空谷无朋唱考槃。\n缘木退藏冲汉翼，扁舟归整钓鳌竿。\n临风愿听王阳仕，洗手思弹贡禹冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄伯兄兼问子文 其二","author":"彭汝砺","text":"壮志当年欲请缨，孤踪今日尚飘萍。\n尘埃易染羁容黑，气义难邀俗眼青。\n冯客剑寒长自击，伯牙弦古欲谁听。\n风云勇胆驰燕塞，社稷丹心望汉庭。\n思入鹡原愁四散，梦驰莺谷涕双零。\n客悰愿托诗情见，吟尽清宵卒未醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送子文赴阙","author":"彭汝砺","text":"槿花时态甘相失，金玉交情喜独亲。\n慷慨有心探虎穴，邅回无计附龙鳞。\n君方奋翼青冥上，我即潜舟寂寞滨。\n从事功名有馀力，勉为书寄考槃人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄润之弟兼附呈伯兄 其一","author":"彭汝砺","text":"一棹孤舟接杳冥，无聊长恨别离轻。\n利名汩汩乱人意，南北悠悠分我情。\n风触鹡鸰寒影散，日蒙棠棣绿阴成。\n莫令泽国频回首，时倩江鳞寄一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄润之弟兼附呈伯兄 其二","author":"彭汝砺","text":"江外如今独转蓬，思君不敢望飞鸿。\n寸心引逐征云北，孤梦争先落叶东。\n卧病此时千里隔，微吟何日一樽同。\n却嗟逐客为羁客，还见春风换朔风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄润之弟兼附呈伯兄 其三","author":"彭汝砺","text":"风规落落已非俗，气宇堂堂知有才。\n安得骅骝归道路，不甘楩梓滞蒿莱。\n青阳路径新萌柳，白雪林亭欲放梅。\n愿逐羽翰归故国，相从歌酒趁春来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东流道遇伯兄西归寄二篇 其一","author":"彭汝砺","text":"君栖京国我天涯，病眼相望泪满衣。\n邂逅得为千里会，仓皇不及一言归。\n穷通固属时之遇，取舍犹惭议者非。\n未得宠光荣里落，久行犹足慰庭闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东流道遇伯兄西归寄二篇 其二","author":"彭汝砺","text":"久雨泥涂恶，春风草木花。\n相逢一笑乐，欲去百咨嗟。\n何日定行役，此时应到家。\n平居倾望意，汗漫正无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜文渊登第因寄二篇 其一","author":"彭汝砺","text":"春风吹诏落天涯，喜听君荣及盛时。\n桂籍功名知自取，云台事业旧相期。\n骐驎有力争千里，燕雀无才寄一枝。\n士稚果能先越石，苏秦应欲愤张仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜文渊登第因寄二篇 其二","author":"彭汝砺","text":"十年共力诗书学，万里相期将相科。\n白屋自知难掩抑，青山聊得慰蹉跎。\n宠荣未有如君早，衰病争加若我何。\n灯下无人知此意，独鸣寒剑一悲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜择之子文至桐江次伯兄韵","author":"彭汝砺","text":"病夫憔悴浙江边，谁恻穷途旧橐单。\n尺素不闻倾塞雁，扁舟未至望沙滩。\n羁栖久客情无赖，邂逅相逢意倍欢。\n幽夜冥冥思取火，与君同取白榆钻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻庭佐不安因驰归","author":"彭汝砺","text":"山居倾眷旧朋俦，日落原头望不收。\n奴仆忽来传汝病，信音不寄使人愁。\n羁怀缕缕无穷尽，归意飞飞可滞留。\n一舍道途千里远，那堪风雨重衣裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自东流归","author":"彭汝砺","text":"久郁圭蓬困不胜，狂游天地眼双明。\n行逢梅浦不能去，步接松林无限清。\n风雨寂寥知物意，山川崎曲见人情。\n愁悰触物纷无寄，喜听村垆卖酒声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东流道中作","author":"彭汝砺","text":"轻快飞舆出古城，蟠迂行径转沙汀。\n鸬鹚映日露纁翅，鸿鹄斗风开雪翎。\n水瘦不藏寒石绿，云归才见远峰青。\n苦怜野色溪光好，倍觉诗魂酒魄醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜徐景宗秀才至","author":"彭汝砺","text":"久客羁栖正无赖，故人邂逅一相逢。\n红泥绿酒方沈醉，白雪清吟未款从。\n昏翳忽收尘耳目，欢欣争入病颜容。\n秋风且醉江山碧，莫纵离愁到客悰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元祐三年同深之学士子开侍郎在初考今复承乏有怀旧游因作此诗并幕次唱酬二章寄呈深之学士子开侍郎 其一","author":"彭汝砺","text":"集英今日事，全似戊辰春。\n文彩窥多士，游从忆故人。\n抗旌浮海角，舣棹即河漘。\n试作诗相寄，诗成更损神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元祐三年同深之学士子开侍郎在初考今复承乏有怀旧游因作此诗并幕次唱酬二章寄呈深之学士子开侍郎 其二","author":"彭汝砺","text":"数烛知归日，思家似老人。\n此凡三锁宿，今复一经旬。\n猛着棋销日，深凭酒送春。\n萧条双短鬓，半夜总如银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和致远学士韵","author":"彭汝砺","text":"落笔千人畏，挥谈一坐倾。\n竹林冬更好，星斗夜深明。\n爱古情何远，忧时气未平。\n老人无见解，祇愿酒频行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十四弟得书承已次东流赴省试因寄小诗呈推官承务弟","author":"彭汝砺","text":"恰见蜘蛛喜，便知鸿雁来。\n大波窥汹涌，遥岫见崔嵬。\n怀土欲心折，拆书先眼开。\n系舟龙化处，亭子旧名雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云盖老僧八十二","author":"彭汝砺","text":"邂逅还相见，慇勤复自陈。\n三千大千界，八十二年人。\n衲衣云水旧，头鬓雪霜新。\n手种庭前柏，如今大似身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云居相送至下杉庄","author":"彭汝砺","text":"莫宿昏初黑，晨装晓已分。\n鸡啼江上月，犬吠岭边云。\n好去庞居士，善来洪上人。\n临行须一勘，腊后几时春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昨日陪深之学士饭净因登罗汉阁期致远不至忆山阴弟各赋一首遂寄二君","author":"彭汝砺","text":"丹凤禁城近，青鸳宝阁开。\n九天瞻佛日，万国在春台。\n东观人何处，山阴弟未来。\n飞云来自在，相望兴悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿金钩","author":"彭汝砺","text":"绝域三千里，穷村五七家。\n云深无去雁，日暮有栖鸦。\n雾拥云垂野，霜连月在沙。\n夜长无复寐，寂寞听寒笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惠州 其一","author":"彭汝砺","text":"城垒四五尺，闾阎千百家。\n朝尘疑作雨，暮雪欲飞花。\n旧寺僧何在，空堂鬼自邪。\n三更愁不寐，相笑是皇华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惠州 其二","author":"彭汝砺","text":"雾暗山千叠，冰寒水一涯。\n风高天作雪，日晚露迷沙。\n居士身如梦，行人驿是家。\n青灯无意绪，点点自成花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惠州 其三","author":"彭汝砺","text":"绝域冬犹暖，孤村日易斜。\n浮云点晴汉，幽鸟篆平沙。\n白草单于垒，青灯渤海家。\n夜蟾无定处，流转共天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"途中见接伴曰三得家书因作是诗寄候","author":"彭汝砺","text":"谁似老胡喜，一朝三得书。\n去家长念汝，触事独愁予。\n水冻鱼全少，天寒雁更疏。\n三冬多壅热，安否比何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长垣路中 其一","author":"彭汝砺","text":"欲作图南翼，却乘之北辕。\n百年随所值，万事拟无言。\n短发霜如白，孤心叶似丹。\n夜深何许梦，双阙九重阍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长垣路中 其二","author":"彭汝砺","text":"身似水中木，险夷惟所遭。\n不堪誇拙速，可复叹贤劳。\n雨脚三冬少，尘头一丈高。\n故乡何处是，南望首重搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天保弟被荐继得子因寄是诗","author":"彭汝砺","text":"雁足书何速，灯花喜更频。\n桂攀天上近，珠入掌中新。\n骥种仍多子，龙标又得人。\n贺觞俱见在，留待禁城春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和瑛师","author":"彭汝砺","text":"泽国春初好，江城雨易昏。\n系舟林下寺，步屧水边村。\n法悦长如此，诗情剩欲论。\n归心师莫问，一旆正翻翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和通判承议","author":"彭汝砺","text":"水边人不到，吾与子同行。\n始见游鱼乐，时闻幽鸟声。\n山如仁者静，风是圣之清。\n拟买扁舟去，江湖老此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南安道中","author":"彭汝砺","text":"南安穷且僻，况复阻凶饥。\n破屋人何在，空山鸟自归。\n儿童多素韠，妇女祇青衣。\n好雨兆丰岁，斯民其庶几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"癸未偕子仲都官文渊节推游东湖分题和子仲湖字韵","author":"彭汝砺","text":"泛泛林边晚，扁舟忆五湖。\n丹青难作赋，水墨好为图。\n龙蛰云长在，霜寒草自枯。\n诗翁足幽兴，潇洒在蓬壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和文渊同字韵","author":"彭汝砺","text":"湖上多佳致，清樽况不空。\n乐游今日并，幽思几人同。\n苒苒芰荷雨，萧萧芦苇风。\n南州人不见，流水自无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送宁和仲","author":"彭汝砺","text":"玉粒稻初熟，霜螯蟹正肥。\n薄言酌我酒，聊以送君归。\n叠翠屏疑画，淩空凤欲飞。\n山前猿与鹤，最识旧征衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和君宜弟诗韵蕲州所寄","author":"彭汝砺","text":"棠棣花开处，衡阳雁去时。\n封题开远信，涕泪裛新诗。\n知道频嗟晚，谋田更恨迟。\n去留君莫问，方寸正如丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有感","author":"彭汝砺","text":"往复何为者，功名安在哉。\n茅心迷簿领，蓬鬓老尘埃。\n鱼蠹生书帙，蛛丝在酒杯。\n渊明缘底事，苦死赋归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪上","author":"彭汝砺","text":"濯发溪头水，披衣林际风。\n低枝折杨柳，高叶荫梧桐。\n鱼跃浮萍上，鸟啼幽谷中。\n清凉仍各有，彼此一无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"君宜得种茶诗予和韵","author":"彭汝砺","text":"始傍东园种，初从北苑移。\n本根原自好，造化总无私。\n紫笋时名误，乌程旧种卑。\n酪奴吾不问，酒圣尔何为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中","author":"彭汝砺","text":"富贵来何晚，穷愁固有馀。\n病多皇甫谧，贫甚马相如。\n思乱诗魂散，忧深酒兴疏。\n此心无可奈，徒尔重欷歔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病起","author":"彭汝砺","text":"失意忧多病，予今喜少痊。\n寝兴今泰矣，容质尚苍然。\n郁抑丹心塞，纷纭万虑阗。\n此情无可奈，整顿赖诗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉极有感","author":"彭汝砺","text":"饮极人之乐，余心反自伤。\n气因人愤激，情与酒飞飏。\n泪落侵双鬓，愁多郁寸肠。\n空赢山简醉，不似乐天狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小径","author":"彭汝砺","text":"南北通官道，东西隘乱山。\n无时轮迹道，经雨藓痕斑。\n世路同攲侧，人心共险艰。\n亟由平易去，宁苦险巇间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日暮","author":"彭汝砺","text":"人去红尘息，林幽晚意清。\n秋阳红旆乱，夕霭翠绅横。\n新月淡无色，微风寒有声。\n此吟犹未竟，城吏已严更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叹交","author":"彭汝砺","text":"儿童不可近，况复与之亲。\n薤露不终刻，松风知几春。\n嚬嚬徒满目，切切竟何人。\n诵罢莺鸣咏，空馀涕满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈秀才扩因旬休不至以诗呼之","author":"彭汝砺","text":"寂寂碧窗下，业同诗酒欢。\n暌违才一日，恨怅已千端。\n无忽离群异，须矜会友难。\n相望正展转，行矣莫盘桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题扬州因大师小池","author":"彭汝砺","text":"阒寂黄金宇，清泠碧玉池。\n轩楹收冷淡，松竹让幽奇。\n岸蹙源流浅，山阴月到迟。\n未能活鱼鳖，安可卧蛟螭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题袁州紫翠轩","author":"彭汝砺","text":"黯淡襟横野，迢遥面古城。\n丹青难尽意，紫翠漫为名。\n山石开新雨，溪枫照晚晴。\n杖藜饶纵目，谈笑不无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄庭佐弟 其一","author":"彭汝砺","text":"愿我今黄发，嗟君亦白头。\n读书少不竞，从士老堪羞。\n陋巷曷其乐，首阳何所求。\n一廛如好在，聊欲与君谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄庭佐弟 其二","author":"彭汝砺","text":"幸免葬鱼腹，更难骑虎头。\n少狂真忍耻，老退似包羞。\n蓬苇径非远，桑麻田可求。\n浮生一箭速，火急为兄谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上","author":"彭汝砺","text":"柳翠芦尤碧，枫殷蓼更红。\n金波连夕照，玉浪起秋风。\n霄汉双飞鸟，波澜一钓篷。\n江湖如许景，总合付诗翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伏承宠示滕王阁佳句因用原韵","author":"彭汝砺","text":"滕王帝子阁，徐孺聘君亭。\n南浦水秋涨，东湖云昼冥。\n江山晴更碧，松桧雪逾青。\n安得泛舟去，与君同醉醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送和仲","author":"彭汝砺","text":"心因行已老，事更与心违。\n恶景多离合，浮生半是非。\n愁闻南浦雁，梦采北山薇。\n昨日见之子，问予胡不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗示庭佐弟","author":"彭汝砺","text":"世味祇如此，消忧奚所娱。\n心烦多恶酒，眼病顿捐书。\n倦倚筇枝竹，寒围木火炉。\n公宁机械废，我拙笑公愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":49823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]