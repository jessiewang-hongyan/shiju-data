[{"title":"南阳诸僚和留别诗再和二首 其二","author":"葛胜仲","text":"十连名郡近天畿，负重悬知困力微。\n閒客已知无啸诺，邻邦聊得看芳菲。\n谋身旧似齐优拙，罹咎今同鲁酒围。\n回首隽游难恋嫪，索居独学果畴依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还乡有作二首 其一","author":"葛胜仲","text":"菊潭才到便归休，年大何心泣楚囚。\n南岳献讥无反覆，东皋舒啸有朋俦。\n龟灵自古称怀浦，狐老从来只首丘。\n便觉讴吟罢庄舄，翛然随俗且沈浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还乡有作二首 其二","author":"葛胜仲","text":"孑孑携家反故园，尚沾荣禄愧空飧。\n官閒未办夸腰组，车过常先下里门。\n涂巷依然榆社旧，屋庐犹喜枳篱存。\n浮生孰似还乡乐，謦欬吾前尽弟昆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"里中无居寓丹阳县书怀呈邑宰张子蒙","author":"葛胜仲","text":"假守秦头两月彊，往来遵路一年忙。\n幸逢庇邑人惟旧，暂脱浮家计亦良。\n退食井腴如就国，遥寻祖系似还乡。\n南风未便轻蓬荜，也与虚窗拂衽凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏书","author":"葛胜仲","text":"木彊与世异酸咸，扫洒真祠屡入衔。\n新格似闻惟半俸，旧官那计是常参。\n茶炉僧钵随时用，手板朝衫竟月缄。\n赖有班书贫可贴，且谋蒲笋慰饥馋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和工部兄寻由里山泉眼","author":"葛胜仲","text":"葛帔练裙一散仙，亲携畚锸道蒙泉。\n滥觞初见开微溜，中准终能作止渊。\n栖亩稻秧滋菶菶，入池藕叶泛田田。\n道人跬步不知处，未遇高贤名孰传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和工部兄雪五首 其一","author":"葛胜仲","text":"风撼柴门夜不关，黎明琼玉遍人寰。\n举头寒掩东隅日，纵目高疑西域山。\n朝路昔宁飘袂上，禅房今喜点炉间。\n亦知尘雾难撄拂，万径行踪绝往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和工部兄雪五首 其二","author":"葛胜仲","text":"排寒聊与酒交关，呈瑞应先自帝寰。\n初见同云迷六幕，渐惊飞鸟绝千山。\n知酬素景风尘外，坐隔清游咫尺间。\n飞洒却羞来傍鬓，安仁年少不重还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和工部兄雪五首 其三","author":"葛胜仲","text":"从此何忧家事关，明年粒米厌区寰。\n腰青不见飞花女，头白先看对面山。\n弦冻未应停绿绮，胶彊仍喜彀黄间。\n平铺万顷茅檐冷，欲问城居几日还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和工部兄雪五首 其四","author":"葛胜仲","text":"门似柴桑画亦关，歘惊阊阖堕人寰。\n郊原那异熬波海，垄阜浑疑聚米山。\n望远恨无楼百尺，逃寒阻共屋三间。\n阿兄诗句清奇甚，格律都高汉以还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和工部兄雪五首 其五","author":"葛胜仲","text":"偶兹穷腊憩乡关，无蒂花飞遍海寰。\n粉饰门闱疑省户，云屯观阙想神山。\n飘狂不绝三冬里，积厚遥追二纪间。\n闻说旗亭增酒价，沈酣准拟典衣还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菁山梅花盛开予独未之知十一月二十二日周元举察院饷数枝以诗三首为谢 其一","author":"葛胜仲","text":"香雪常开小雪天，孤芳今占六花前。\n欲从玉女互争秀，不分青腰誇擅权。\n见事自知秦相缓，著鞭甘被祖生先。\n左轓不要宜春郡，应恋南枝映水鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菁山梅花盛开予独未之知十一月二十二日周元举察院饷数枝以诗三首为谢 其二","author":"葛胜仲","text":"冬早寒轻测测天，疏枝明秀忽来前。\n土酥结色神仙种，冰麝分香造化权。\n三白共惊千树发，一年都占百花先。\n巡檐索与冰姿笑，准拟携壶更击鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菁山梅花盛开予独未之知十一月二十二日周元举察院饷数枝以诗三首为谢 其三","author":"葛胜仲","text":"山头云物冻吴天，几树寒英唤我前。\n老不禁愁聊索笑，病方止酒暂从权。\n松篁傲雪堪为伴，桃李酣春未敢先。\n习隐菁山真不恶，吟鞍十里看芳鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵耿守咏雪","author":"葛胜仲","text":"低云晻暧与天同，剪水飞空候应冬。\n沴气潜消烦燮理，欢谣蔼布荷明农。\n漾舟访友乘清兴，授简延宾继旧踪。\n岁好定知丰五稼，仓箱行庆亩收钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"景山寺居大风步月","author":"葛胜仲","text":"溪边空谷偶来逃，散步虚廊破郁陶。\n庭户月华封玉雪，林峦风响汹波涛。\n气寒秋尽衣裳薄，夜静山深殿阁高。\n欲识羁怀愁几许，明朝揽镜看霜毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十二月十日泛舟以北风寒回棹","author":"葛胜仲","text":"云山冬瘦露精神，整棹溪边试问津。\n悬坎带坻冰积厚，缘甍冒栋雪飞频。\n出乘舴艋为龟手，归卧蜗牛分曲身。\n已觉乌蟾不能活，阳熙早晚定回春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月二十六日雪后登子亭示道祖","author":"葛胜仲","text":"淑景因阴苦未韶，峭寒于老不相饶。\n窃香风韵归梅萼，刻楮工夫到柳条。\n万瓦雪消疑夜雨，一溪波涨误春潮。\n连枝别后儿曹远，赖有吾人慰寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠讲华严惠照大师","author":"葛胜仲","text":"松陵讲舌看澜翻，滞论冰消瞬息间。\n觉性已明华藏海，退身聊遁莫釐山。\n识真久认鱼筌假，处静因求麈尾閒。\n我是殊庭仙隐吏，二年云水共跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠深老","author":"葛胜仲","text":"折床学子厌如云，卷席归栖震泽滨。\n识了大千俱是幻，理穷馀二即非真。\n已辞白社拘方侣，更笑红楼应制人。\n弟子安心安已竟，不知若个是迷津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠福胜院老僧有宣","author":"葛胜仲","text":"诸方行尽已忘筌，宴坐归来水石边。\n五叶承来真的嗣，七朝阅过到耆年。\n鸾音衮衮閒犹振，鹤骨昂昂高更坚。\n我特叩门来问道，投针相值恐前缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日野步二首 其一","author":"葛胜仲","text":"一年春好是清明，万事都归笑矣行。\n卵色天容供远兴，縠纹波面惬閒情。\n门生陪从无参佐，野服徜徉束佩缨。\n午困乞浆先馈少，已无形梦不须惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日野步二首 其二","author":"葛胜仲","text":"一春连雨少晴明，曳杖郊坰偶意行。\n妩媚花枝空溅泪，风流柳色但牵情。\n长饥频觉带移眼，大笑何宁冠绝缨。\n北极朝廷今咫尺，穰穰寇盗莫相惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二月十五日游谢村福田院观涅盘会寺乃灵运故宅呈道祖","author":"葛胜仲","text":"年来生计一轻舠，晨出晡归岂惮劳。\n谢客儿山存胜致，佛泥涅日往游遨。\n波间星斗沈光冷，月里山河结影高。\n何日菁山山上寺，与君痛饮读离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天宁节感事示宝华鉴老","author":"葛胜仲","text":"诏语从天下九围，并严法会保宸闱。\n山称万岁诚尤切，鉴奉千秋事已非。\n已听鸾音勤请祝，故应龙辂庆遄归。\n孤臣拭血怀君处，小坌峰前泪满衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和西郊春事招元方同游韵","author":"葛胜仲","text":"仙桥水殿照清流，攘攘游人聚九州。\n光景从来夸辇毂，风标况是富阳秋。\n天开卵色春方好，月上弓形夜更留。\n勉作新篇书盛丽，莫令少味似韩休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和元方用韵见寄次韵奉谢兼呈元东诗二首 其一","author":"葛胜仲","text":"人与严徐是一流，英英儒雅冠吾州。\n白虹吐烛呈文夜，红杏飘筵得意秋。\n禄薄未应腰为折，语多共叹舌无留。\n令君举善搜寒俊，不进清华谅不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和元方用韵见寄次韵奉谢兼呈元东诗二首 其二","author":"葛胜仲","text":"文律高峰与激流，五言佳处似苏州。\n宁甘鬲县中漓酒，不羡宣城赏弈秋。\n白首同归相器重，青云一蹙岂淹留。\n外家门阀期君大，作德虽休更勿休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"追贤院食已度岭历宋胡诸庵转山夜归","author":"葛胜仲","text":"击缶那能似漆园，销魂来访小桑门。\n仰冲云阵寻峰顶，细步泉流觅水源。\n九里环观山向背，两舆归趁月黄昏。\n春风不识愁人意，柳暗花明自逐村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"定山寺","author":"葛胜仲","text":"入门松桂拂天长，遣化谁来自众香。\n初剪蕨嶶丰菜把，半残桃杏露花房。\n不辞峻极犹登践，免使幽寻堕渺茫。\n闻有山人宅岩顶，试从度世觅神方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"章申公坟寺","author":"葛胜仲","text":"千章宰木荫长城，申枉行颁宠数新。\n金薤文华才冠世，银钩字画品称神。\n佳城此日看驯鹿，文保当年想梦麟。\n定有玉璜传后裔，投竿端自渭城滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读史二首 其一","author":"葛胜仲","text":"祖尚浮虚事漆园，生平圜府不曾言。\n神峰峻若瑶林茂，手色全如玉柄温。\n翊辅但求三兔窟，风流空擅一龙门。\n季年丧国排墙祸，绮靡谀言可得存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读史二首 其二","author":"葛胜仲","text":"曾侍东皇采紫芝，朅来西土宴瑶池。\n藻翁梁上休繁役，灰劫池中认远期。\n数木故应烦鬼子，窃桃那免号偷儿。\n蒿庐不爱深山卧，避世金门世孰知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与工部兄迩岁离多会少又乐少苦多述怀","author":"葛胜仲","text":"并寓僧蓝得几时，薄游苕霅遽暌离。\n一麾为郡乖同济，百谪还乡独后期。\n第隔东西希聚首，忧连宗戚罕伸眉。\n何时解组俱林下，松菊园宽日共窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和工部兄迁中散述怀韵","author":"葛胜仲","text":"一岁连膺四命书，衣冠庆美近时无。\n绵长本自天资厚，凭藉由来地势孤。\n襆被昔高兰省去，彯缨今喜棘班趋。\n立言制行俱忠孝，岂愧堂堂七尺躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄献中散兄生辰","author":"葛胜仲","text":"吉月迎秋万宝成，充闾瑞气降耆英。\n枌榆社里藏身稳，桐柏宫中庀职清。\n黄发定应惊再少，绛田端自保长生。\n寿觞亲荐犹弥月，归梦驰诚栩栩轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵大资节使薛公见贻二首 其一","author":"葛胜仲","text":"黑头自致已三旌，暂寄江湖适性情。\n五总龟游钦学富，九皋鹤立见神清。\n西雍宁累飞章荐，东閤频蒙倒屣迎。\n方幸台躔照苕霅，以兹投劾未能轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵大资节使薛公见贻二首 其二","author":"葛胜仲","text":"剧谈世事迩来慵，时向烟波掉雪篷。\n德业未尝矜久大，光尘惟曲示和同。\n十年辅政裨元化，万国宾贤振士风。\n敢请中兴重作颂，衮衣不日见归公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵和薛大资将往仙潭","author":"葛胜仲","text":"久向岩廊侍禹汤，归身丘壑兴尤长。\n东阡方幸陪游乐，南浦难轻送别伤。\n欲以中经咨诂训，更将奇字问偏旁。\n勉留衮舄辉山郡，不日天书下宠光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵林茂南祀喜雪二首 其一","author":"葛胜仲","text":"膜拜同祈海岸仙，风云奔走会诸天。\n山岩恍若龙衔曜，墀庑频惊鹤夺鲜。\n莫讶瑶英来有信，都缘玉烛气无偏。\n化工应念催科拙，乞与穰穰大有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵林茂南祀喜雪二首 其二","author":"葛胜仲","text":"吾僚斋祷极精诚，俄见联翩舞玉霙。\n逞巧封条危不堕，弄閒飘幌细无声。\n倾都奇货归王老，侵户寒威赖曲生。\n天念春回惟七日，故教连夜趁嘉平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僚佐再和复作二首 其一","author":"葛胜仲","text":"雅步谁追鹤氅仙，峭寒真是酒家天。\n谢庭最爱因风起，桓扇宁书遇象鲜。\n远觉归巢禽翅重，静看当槛竹枝偏。\n三吴此景宜增赏，飘瞥郊原似昔年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僚佐再和复作二首 其二","author":"葛胜仲","text":"从来爱雪是真诚，又见祥飞六出霙。\n材薄敢招能赋客，庭閒聊作咏诗声。\n瑶阶误向凡间见，春蘤翻惊腊里生。\n贺板并来无答语，自惭词笔太平平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵中散兄及诸弟寄顾渚茶二首 其一","author":"葛胜仲","text":"苕溪溪上一茶神，三表遗经品藻亲。\n轻拂竞看云态度，初尝应惬舌根尘。\n草堂遥忆金沙水，花濑聊分紫气春。\n尤物从来常贵少，彭城园外即非真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵中散兄及诸弟寄顾渚茶二首 其二","author":"葛胜仲","text":"健步苍头捷若神，露芽三日到情亲。\n轻瓯延喜凝珍玉，小硙邻虚堕细尘。\n便好相招十日饮，莫教虚负一年春。\n慇勤后讯当重饷，月六斋时供应真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭卫卿弟三首 其一","author":"葛胜仲","text":"摇毫射策逐群裾，独以高名唱玉除。\n五斗抛来为诗酒，三馀收得向樵渔。\n固存夙悟无生理，永诀亲裁忍死书。\n晚岁异乡成一恸，大红亲破茂红綀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭卫卿弟三首 其二","author":"葛胜仲","text":"远业相期未易量，那知百岁似风狂。\n鵩来有恨催新赋，鹊往无医识禁方。\n邻笛他年那忍听，人琴此日遂俱亡。\n长空后夜西风急，吹断惊鸿不作行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭卫卿弟三首 其三","author":"葛胜仲","text":"高材磊落气峥嵘，命薄难将智力争。\n赤米白盐生理窄，红莲绿水宦情轻。\n曾期虚阁凭栏醉，不遂扁舟适野迎。\n汝已反真归大化，山城空恸十年兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾梦良惠然见存出口字诗十有七篇偶摭所遗成三篇纪谢 其一","author":"葛胜仲","text":"未有归资可买山，一封程奏便求闲。\n睢睢去后容争席，碌碌羞来肯抱关。\n幻界已知都是梦，真心自要识无还。\n尊前衮衮听名理，坐遣穷愁一破颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾梦良惠然见存出口字诗十有七篇偶摭所遗成三篇纪谢 其二","author":"葛胜仲","text":"清明时节访溪山，消尽机心大智闲。\n元亮孤舟聊自棹，尚平家事不相关。\n叩门虽幸千金顾，恋德翻嗟半日还。\n并水幽亭同历览，应怜瓢饮政希颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾梦良惠然见存出口字诗十有七篇偶摭所遗成三篇纪谢 其三","author":"葛胜仲","text":"居然埋照向穷山，谁识龙媒伏帝闲。\n意气虽吞云梦泽，功名未羡玉门关。\n身常静退缘知止，心不倾邪畏好还。\n但恐搢绅公论在，招延行见觐威颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中散兄喜罢郡有诗次韵却寄","author":"葛胜仲","text":"上印归来卧荜门，此心炯炯向谁论。\n平生疏拙真天赋，此去安閒尽主恩。\n旧识愧真为我累，近知凡百丧吾存。\n好来同习菁山隐，白发仙臞两弟昆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵中散兄见寄","author":"葛胜仲","text":"晦迹才须一亩间，浮家暂寄五湖边。\n官抛印绶轻千里，禄隐渔樵已十年。\n眼对云山偏烂烂，腹藏篇牍自便便。\n政缘欲遂幽栖乐，岂是清时独弃捐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵钱伸仲见贻兼送别二首 其一","author":"葛胜仲","text":"四年五度访郊村，苜蓿羹稀不厌贫。\n清韵喜逢须展戟，奥篇仍睹笔书银。\n一筇岩壑幽栖地，五两江湖自在身。\n他日愿陪鸡黍社，贵邻应不买增珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵钱伸仲见贻兼送别二首 其二","author":"葛胜仲","text":"郊居牢落似东屯，剥啄欣闻客叩门。\n笔下波涛文贯道，胸中瑜瑾学逢源。\n西余未遂谐清赏，南浦俄惊黯别魂。\n金菊万株秋露重，此时重复望来辕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题寄伸仲先茔瞻云亭","author":"葛胜仲","text":"衔哀负土记当年，白首来临涕泫然。\n宰树成行无鹿触，佳城卜吉自牛眠。\n已乖綵服亲尝膳，犹幸纶封数漏泉。\n反顾云飞频怅望，孝诚宁愧斗南贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜中散兄将至","author":"葛胜仲","text":"两年侨寓为知音，百指仍携就泛金。\n蝇集树榛曾掣肘，鱼传尺素喜回心。\n无边红芰邀同醉，不尽青山得共寻。\n白首居诸良会少，对床免被别愁侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵中散兄将到先示诗","author":"葛胜仲","text":"云山佳处复跻攀，景物依然得破颜。\n春事阑珊三月尾，时光荏苒七年间。\n重来怀绂成何事，归去抽簪幸有山。\n且尽一杯今日乐，投林飞鸟会知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵中散兄喜雪二首 其一","author":"葛胜仲","text":"林薄风号两日先，俄惊剪水堕遥天。\n坐看山路禽飞绝，聊胜泥涂马不前。\n轻点红炉呈妙意，斜飘素发映衰年。\n寒霙与我官同冷，莫笑柴扉日晏眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵中散兄喜雪二首 其二","author":"葛胜仲","text":"缥缈山头白最先，模糊云物变吴天。\n陆机玉圃无精粗，王衍瑶林满后前。\n酒涨微澜宜永夜，麦翻翠浪看明年。\n晓晴便是春消息，梅萼包香柳欲眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵中散兄二首 其一","author":"葛胜仲","text":"泉石清游一月间，风轻气爽未惊寒。\n唱经云岫频清梵，佞佛炉烟费紫檀。\n震泽鱼肥聊独酌，包山橘熟阻同看。\n归来顿识南宗髓，宁见弥天释道安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":64474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]