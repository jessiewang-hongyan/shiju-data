[{"title":"林可山荐毛监场写梅","author":"叶茵","text":"汉庭延寿丹青名，解使蛾眉休甲兵。\n之子懒作乃翁画，直向梅花苦用情。\n笔端不复污脂粉，临成天地无边清。\n更将此意语君复，岁寒应与孤山盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊然亭","author":"叶茵","text":"举世正营营，閒中意味深。\n无忧伸足梦，自乐曲肱吟。\n火软香凝穗，檐虚树长阴。\n客来难举似，指水印禅心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦雨","author":"叶茵","text":"农事正纷纷，天时异所闻。\n举头方见日，翻手又为云。\n茅舍蛙分部，槐庭蚁失群。\n裁成忧国疏，斋沐告吾君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虎丘","author":"叶茵","text":"心境空时喜地偏，杖藜来勘点头禅。\n重门锁住海心石，一剑截开冰底天。\n谁记珣珉曾院宇，尚传吴越共山川。\n阑风剩月知人意，塔影松声落坐边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虎柙","author":"叶茵","text":"生长古林丘，擒来铁系囚。\n休怜文变豹，尚觉气吞牛。\n槛阱终难脱，咆哮亦可休。\n山中藜藿少，君合早为谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗僧归儒","author":"叶茵","text":"厌作人间粥饭僧，等閒来续义铦灯。\n近吟气味无蔬笋，旧学工夫尚葛藤。\n花下飞鞭身洒落，风前扶帽发鬅鬙。\n浪仙素不修书问，有愧昌黎诧可朋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"勋业","author":"叶茵","text":"勋业占渔蓑，因閒学种荷。\n春秋几燕垒，人世一鸡窠。\n雨急溪声壮，堂宽野趣多。\n狂歌狂且醉，还感醉时歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南明楼","author":"叶茵","text":"重檐敞处受槐薰，扫尽江村雨后云。\n佛法本无南北异，世情强有晦明分。\n个中苟住元无住，此外无闻却是闻。\n谁道结楼入已去，床头诗版几朝曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南塘偶成","author":"叶茵","text":"静向南塘验物情，东风又绿柳边汀。\n梅花密点残棋局，蜗篆斜题小砚屏。\n浮世虚无春后雪，故人零落晓来星。\n逢时且进杯中醁，休学怀沙赋独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"城下小庵","author":"叶茵","text":"水缘城诘曲，水际暗桑麻。\n篱落深村路，闾阎处士家。\n烟篁黏半箨，风柳飏轻花。\n随喜跏趺坐，香寒月影斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"室人墓下","author":"叶茵","text":"楚怆埋香地，卿须念藁砧。\n齐眉中道诀，同穴百年心。\n刀尺凝馀泽，松梧带老阴。\n可能如馌妇，相对白头吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春事","author":"叶茵","text":"春事又如此，犹人欲老时。\n绿稠烟外树，白紧鬓边丝。\n天道有还日，吾年无返期。\n从今安适境，莫放酒杯迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚二首 其一","author":"叶茵","text":"红紫雨离披，风光别壮时。\n世情杨絮觉，心事杜鹃知。\n屋角溪连井，林梢菊障篱。\n幸无尘役役，倚槛数晴丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚二首 其二","author":"叶茵","text":"春色渐昏昏，那逢日带曛。\n落花红一尺，新笋绿三分。\n忆友盟留石，寻诗思入云。\n风光到田舍，瘦策看耕耘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳","author":"叶茵","text":"态度脂韦不自持，对人无柰小腰肢。\n好于彭泽归来日，瘦似章台别去时。\n隐隐轮蹄端不恶，深深亭榭最相宜。\n流莺百啭春光老，拟折柔条寄所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":22999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洪都宗人则明盛年择宗子之秀名之曰绍弟书来欲求语则明上侍重亲承志笃学恤贫乐善绳绳蛰蛰未可涯也因书昔所赋广平同系诗一章载赓以庆之","author":"叶茵","text":"善积端如水涤源，源深自可羡来昆。\n岁当有室讵为老，意者重闱思弄孙。\n和乐定知江有渚，硕蕃伫见叶流根。\n河南心印元同自，秋干虷中细讨论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"相逢","author":"叶茵","text":"相逢疑旧识，敲火自煎茶。\n盛欲为留计，其如未是家。\n东西分地脉，南北两天涯。\n别后思君处，空斋谶烛花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋至","author":"叶茵","text":"节序暗推移，清商渐戒期。\n旅怀?早计，凉信柳先知。\n万事到双鬓，馀生消几诗。\n最怜梁上燕，巢稳又归时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜","author":"叶茵","text":"秋满读书林，篝灯报夜深。\n肯閒诗有趣，为拙仕无心。\n惊鹊择枝宿，幽蝉抱叶吟。\n未能游梦境，何处捣衣砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜立春","author":"叶茵","text":"别岁传佳话，论文忆旧盟。\n黄柑凝腊酿，爆竹带春声。\n节序有终始，儿童争送迎。\n此身强健在，列炬到天明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旅中","author":"叶茵","text":"节序几循环，重来秋又残。\n霜晴生酒熟，风冷夹衣单。\n未羡千钟禄，宁求一枕安。\n白头逢岁稔，忧国素心宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旅况","author":"叶茵","text":"未惯秋情绪，客中方觉难。\n酒悭疏旧识，衣薄怯新寒。\n雨过浮云湿，风来病叶乾。\n倚楼搔短鬓，一雁掠阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旅邸","author":"叶茵","text":"湫隘嚣尘不可居，卜诸清旷亦蘧庐。\n虽无傍水梅依竹，喜有对楼人读书。\n工雀一枝聊尔耳，战蜗两角竟何如。\n西风渐劲未归去，空说张翰忆脍鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晋子生日","author":"叶茵","text":"今朝阿晋纪桑弧，郎罢持杯勉读书。\n断莫绕家觅梨栗，更须为国习耘锄。\n义方授汝心还愧，阴德于予计肯疏。\n学取老莱如许寿，年年綵袖拜庭除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂谢","author":"叶茵","text":"广寒世界放新晴，景物萧疏八月深。\n窗外方疑天雨粟，风前已见地流金。\n举留清致为诗助，收拾馀香付酒斟。\n但得仙根耐霜雪，不妨携囝步繁阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舫斋","author":"叶茵","text":"居家巧作浮家样，此即人生不系舟。\n政恐风波起平地，直教砥柱屹中流。\n浪花影动重帘月，潮汛声喧万叶秋。\n梦里不知容膝计，翻身栩栩逐轻鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读梅雪村诗","author":"叶茵","text":"雪村吟有稿，名峻斗牛低。\n声调唐之上，精神江以西。\n爱君忧国意，临水傍山题。\n何代无风雅，人心自鹜鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酒边次赵东阁韵","author":"叶茵","text":"竹褪粉痕新，销磨九十春。\n中年真率性，上古太平人。\n有梦诗将圣，无愁酒不神。\n静看红紫路，翻覆几回尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酒边次徐灵渊韵","author":"叶茵","text":"柳外绿阴重，绿阴生远风。\n温凉三月后，醒醉百年中。\n桑秃吴蚕熟，林幽蜀鸟空。\n不祈朝市梦，高卧太湖东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酒边次韵","author":"叶茵","text":"天末星流小似萤，因将时事语家庭。\n久晴未厌田多雨，众醉难教我独醒。\n梅下有人编野史，竹间犹子课羲经。\n晚年喜不为身累，闭户何求阮眼青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"叶茵","text":"醉敲牛角过前村，此世应无利禄昏。\n有水可渔田可稼，即松而径竹而门。\n宾朋连属琴书乐，亭榭参差鸟雀喧。\n不假山灵回俗驾，会心同是一乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"叶茵","text":"江湖千万顷，小艇熟烟波。\n无梦世情薄，有吟春思多。\n百年空反覆，两鬓暗消磨。\n钓叟同吾志，鸣榔柳外过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"叶茵","text":"世事如今不可知，相逢茶罢且吟诗。\n无风古鼎香烟直，未午空庭树影迟。\n袖手好看棋胜败，论心休问酒醇醨。\n谋居恰与松江近，斫脍羹莼渐及时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"叶茵","text":"春阴晴复阴，因物悟浮生。\n杜宇乡心重，杨花世事轻。\n知非蘧伯玉，觉是晋渊明。\n此意谁人会，骑牛访偶耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"叶茵","text":"人间总利名，此地此心清。\n雨架笔多润，风棂琴自声。\n虚堂回古味，逆境见真情。\n脱帽寻蕲簟，酣眠小太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶题","author":"叶茵","text":"曲肱玩味圣贤书，识破人间总畏途。\n盛欲对君言所以，又应诮我爱之乎。\n百年役役雁来去，一梦昏昏鹿有无。\n堪笑季鹰犹左计，求归何必待莼鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄台守","author":"叶茵","text":"半世困尘埃，烟霞入梦来。\n谁能缩地脉，我已思天台。\n城古清云气，山灵秀药材。\n春时穿径去，郡守莫惊猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"崇道叔庆七十","author":"叶茵","text":"寄意南丰一瓣香，愿公耆艾炽而昌。\n历经七甲鬓浮绿，带锡万钉眉映黄。\n疑是函关逢老子，岿然鲁国有灵光。\n阴功更说燕山桂，留与时人作义方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春","author":"叶茵","text":"年少逢春不惜春，惜春还是白头人。\n飞花入坐儿曹舞，细草蒙阶醉后裀。\n未羡食前罗五鼎，静看檐隙走双轮。\n此心已与尧夫似，同为清时作幸民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曹娥庙","author":"叶茵","text":"孝本当为事，时人或不然。\n娥兮知此理，命也委之天。\n五日抱尸出，千年作史传。\n英灵犹耿耿，有慊莫登船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅","author":"叶茵","text":"溪桥一树玉精神，香色中间集大成。\n疏影逼真前处士，群花推重老先生。\n春回陇首人千里，月到窗前梦五更。\n甚欲折来还不忍，岁寒留取看峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅","author":"叶茵","text":"疏影几黄昏，明明野水滨。\n未风先信息，无雪更精神。\n一白见真色，万红随后尘。\n自来花下饮，肺腑尽生春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清晖亭","author":"叶茵","text":"半点嚣尘不敢留，晴光野色自浮游。\n一泉走石夜多雨，万竹围松风似秋。\n剩喜有诗堪献佛，从教无骨可封侯。\n上人回施清閒供，兰芷香中著茗瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琉璃炮灯","author":"叶茵","text":"体制先天太极图，灯笼真是水晶无。\n远看玉兔光中魄，近得骊龙颔下珠。\n一焰空明疑火燧，寸波静定即冰壶。\n游鱼且作沈潜计，鳞甲成时入五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琉璃炮灯中鱼","author":"叶茵","text":"头角未峥嵘，潜宫号水晶。\n游时虽逼窄，乐处在圆明。\n有火疑烧尾，无波可动情。\n一朝开混沌，变化趁雷轰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野堂即事","author":"叶茵","text":"纤尘不到芰荷边，好向阑干系小船。\n得句未工吟竞病，有书可读笑便眠。\n老于胶扰宁中圣，暂尔萧閒即半仙。\n人境两忘天地寂，一声柳外咽新蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪","author":"叶茵","text":"春意满庭除，红尘半点无。\n山川同变化，天地一模糊。\n石友耸冰骨，松公掀寿须。\n相望王子宅，不见夜篷孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游西洞庭山","author":"叶茵","text":"漫游三十载，屐齿晕苍苔。\n两地无多里，一生能几回。\n洞深龙未蛰，丹熟灶无灰。\n已觉忘身世，松梢有鹤来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢朱宜中隶字","author":"叶茵","text":"隶法如公有典刑，拙中藏巧混天成。\n因观体制超前辈，旋辟轩窗乞扁名。\n气象晋人遒且劲，源流汉刻古而清。\n得来喜对儿曹语，一字千金胜满籯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢韩菊山道院诗","author":"叶茵","text":"正传国子先生印，远访松陵隐士庐。\n二十四篇风月句，几千万卷圣贤书。\n地偏自觉因人重，日涉从教与世疏。\n已戒园丁多种菊，重来对菊脍鲈鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋顺适堂","author":"叶茵","text":"暗触少陵机，茅居峙竹扉。\n安时贫亦乐，闻道咏而归。\n凫鹤从长短，鸢鱼自跃飞。\n吾犹臧谷耳，夷蹠是耶非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道院","author":"叶茵","text":"菰蒲卫竹居，适意在江湖。\n富贵诸公有，清閒举世无。\n四时盘谷序，一景辋川图。\n何处无芳草，堪嗟楚大夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道院","author":"叶茵","text":"园林悭十亩，天赐老生涯。\n雪境吟终夜，春时醉一家。\n篱疏簪菊种，石古络藤花。\n莫有同盟者，多煎谷雨茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道院偶成","author":"叶茵","text":"把茅为屋竹为城，柏子香销道气生。\n九十春光花一片，万千心事雨三更。\n连村鼍鼓相高下，断浦渔灯半灭明。\n闭户和衣寻小榻，梦回犹听读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道院偶成二首 其二","author":"叶茵","text":"柳长柔丝草长芽，随时委化答年华。\n呼来便了能酤酒，抱去添丁共看花。\n忧世中宵心耿耿，题春半壁字斜斜。\n江湖风月今犹昔，能学龟蒙有几家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道院偶成二首 其一","author":"叶茵","text":"水生远岸拍蒲芽，春色骎骎染物华。\n伎?一诗安老草，眵昏两眼眩空花。\n楼分古柳烟光薄，桥倚青帘日影斜。\n此乐未知谁可共，隔篱独许钓鱼家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新春","author":"叶茵","text":"老来分外喜新春，春事关心世事轻。\n棋肯输时方是著，路疑险处不须行。\n雨催农业鸠夫妇，风带边声雁弟兄。\n办得斗园邻屋角，剩栽芝朮了馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪上偶成二首 其二","author":"叶茵","text":"新月试新晴，扁舟夜奔程。\n咿哑千万意，暧乃两三声。\n熟识旅中事，生嫌世上情。\n愿为山简醉，休问伯夷清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪上偶成二首 其一","author":"叶茵","text":"霜冷信冬晴，苕溪半日程。\n正篷辞月色，攲枕受松声。\n渔隐前时约，山讴古样情。\n料应朝市客，笑我独为清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简閒云","author":"叶茵","text":"咫尺不相见，隔江应见难。\n有孤今雨约，转觉暮云寒。\n是处莲堪社，何时芋共餐。\n相思正无赖，鹊喜近阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鲈乡道院","author":"叶茵","text":"田可耕兮圃可蔬，几年梦不到亨衢。\n山林受用琴书鹤，天地交游风月吾。\n事变无涯人老矣，死生有命汝知乎。\n客来时复一杯酒，画作鲈乡醉隐图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"僧房夜坐","author":"叶茵","text":"四十二间廊底客，不知春向柳边深。\n三旬禁足持僧戒，终日看书养道心。\n露草带云眠野鹿，风枝摇月唳幽禽。\n一尘不到炉烟静，自向空寮续近吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"僧舍小泊","author":"叶茵","text":"屏息小胡床，心魔已受降。\n香留烟出户，云过雨来窗。\n自许参禅观，谁能折慢幢。\n山童求说偈，竹影落寒江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"僧舍偶成","author":"叶茵","text":"枝头红白乱飘零，又是风光入柳汀。\n自笑半生成草草，不知双鬓已星星。\n贪吟为有诗磨勘，戒饮从教酒勒停。\n旋学禅床诸衲子，蒙头相对一函经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酷暑","author":"叶茵","text":"动息汗流珠，无风可涤除。\n炎威狱下吏，生意鼎中鱼。\n席地抔冰水，扃门谢客车。\n因思游宦者，曾未忆家居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霉后","author":"叶茵","text":"半日断梅雨，两山生火云。\n窗明书少蠹，壁润帐多蚊。\n无计清时暑，何心解世纷。\n追思河朔辈，倚箑对炉熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题水竹弟寿山觉庵","author":"叶茵","text":"照邻营墓牧之铭，一理融明古亦今。\n政为后先同此觉，不将生死动其心。\n天教棠棣分春色，地接松楸合昼阴。\n自谓老身强健在，时时来和寿藏吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题顺适堂","author":"叶茵","text":"甫里相望江尽头，得邻而隐了浮休。\n落花流水元无碍，野鹤孤云尽自由。\n顺里委心彭泽赋，适时乘兴剡溪舟。\n区区世上分蛮触，对客忘言茗一瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]