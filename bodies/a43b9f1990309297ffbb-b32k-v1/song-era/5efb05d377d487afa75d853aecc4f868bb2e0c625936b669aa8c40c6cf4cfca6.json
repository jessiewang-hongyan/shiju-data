[{"title":"与赵五话别","author":"释斯植","text":"送君无计路漫漫，玉笛声悲远戍间。\n自是行人多有恨，离情吹不到阳关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山行","author":"释斯植","text":"岩边结屋与樵邻，流水桃花几度春。\n行到碧云无尽处，深山怪木老如人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居","author":"释斯植","text":"晚策登临日欲斜，小溪流水是生涯。\n道人睡起鹤飞去，闲尽青松一树花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山家","author":"释斯植","text":"一溪流水绕烟霞，路入青松第几家。\n胡蝶傍人飞不去，隔墙开尽碧桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"门柳","author":"释斯植","text":"看尽门前柳，愁多白发新。\n灞桥风雨夜，离别是何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元夕","author":"释斯植","text":"满眼春光万物华，小桥杨柳近人家。\n谁将上下楼台月，化作金莲一夜花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长安晓发","author":"释斯植","text":"雨过楼台已禁烟，野风吹絮满长安。\n夜来寂寞沙汀下，楚水吴云一样看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"世事","author":"释斯植","text":"世事皆浮云，人间几朝暮。\n不知溪上山，犹有桃源路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丙辰元夜","author":"释斯植","text":"淡河斜浸月光浮，看尽青山更倚楼。\n残烛怕寒元夕夜，小栏花影伴人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叶","author":"释斯植","text":"天涯谁与寄相思，残片疏疏尚恋枝。\n一自西风寒勒后，凋零能得几多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石城秋夜","author":"释斯植","text":"漠漠青山水自流，西风烟树几经秋。\n旧时歌舞人游地，月满江城十二楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"边上","author":"释斯植","text":"边风斜日下长关，春到年年草自生。\n万里战场兵甲静，近来应少北人行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江淮伤感","author":"释斯植","text":"水流花片湿轻红，多少英雄逐晓风。\n三百馀年歌管地，数声欢怨不相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老去","author":"释斯植","text":"老去厌芳菲，思归未得归。\n夕阳溪上树，花作去年飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过吴","author":"释斯植","text":"柳桥槐市暂经过，飘泊汀洲得意多。\n夜月已忘吴主恨，画船空有采莲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和路字","author":"释斯植","text":"青山何人家，芳草满樵路。\n猿鹤未归来，残月照烟树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏古","author":"释斯植","text":"欲寻仙阙觅仙丹，仙在瀛洲缥缈间。\n一自祖龙东去后，更无人到会稽山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林间","author":"释斯植","text":"猿鹤忘机不计年，芭蕉晴绿半平檐。\n青山似与身相入，尽日无人自下帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苕溪舟次","author":"王谌","text":"扁舟烟重冷渔蓑，两岸人家浸小河。\n芳草自生春自老，落花随雨晚风多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金陵道上","author":"释斯植","text":"一望江山去不回，断碑荒草旧宫台。\n六朝陈迹皆如梦，夜夜寒潮送月来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客怀","author":"释斯植","text":"杜宇声残客兴频，柳花飞絮满江滨。\n可怜波底蛾眉月，犹照他乡梦里人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"故宫怀古","author":"释斯植","text":"暮天云尽远山空，夜夜西风入汉宫。\n铁笛一声千古恨，月明人在女墙中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日湖上五首 其五","author":"释斯植","text":"今朝才得是闲身，来往琳宫不厌频。\n燕葺旧巢春又暮，风光一半属游人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日湖上五首 其四","author":"释斯植","text":"雨馀蛙吹歇池塘，庭院人闲日正长。\n独倚画栏看不尽，海棠无处是山光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日湖上五首 其三","author":"释斯植","text":"乐天遗迹暂徘徊，路入深云满径苔。\n花影上栏吟未稳，东风空倩蝶飞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日湖上五首 其二","author":"释斯植","text":"晓山漠漠尽烟霏，四面楼台白鸟稀。\n芳草年年湖上路，柳花风送钓船归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日湖上五首 其一","author":"释斯植","text":"绕堤莎草绿纤纤，老里吟情觉未厌。\n应是踏青天气近，柳条多插野人檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春阴书事呈正甫先生 其一","author":"释斯植","text":"二月花阴已觉迟，黄昏帘幕燕归时。\n小栏独立无人处，春雨春寒总欠诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春阴书事呈正甫先生 其二","author":"释斯植","text":"江湖寥落转飘蓬，归梦年年逐去鸿。\n吟鬓一番春又半，杏花无语立东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春夜","author":"释斯植","text":"玉楼台畔柳生烟，况是春风杜宇天。\n一片月光凉似水，半扶花影上鞦韆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昨夜","author":"释斯植","text":"草堂云去后，人境两茫茫。\n忽见青松老，翻疑昨夜霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋思","author":"释斯植","text":"雨过山城日又西，西风一阵木犀开。\n莫将心事凭秋雁，恐带边愁入梦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张十二秀才至维扬","author":"释斯植","text":"江山迢递水东流，芳草无情管别愁。\n若听春风商女曲，天涯人在古扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"首夏","author":"释斯植","text":"新篁摇绿雨初晴，彩簟风生一枕清。\n昨日小亭幽梦觉，隔帘花影弄莺声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏夕雨中","author":"释斯植","text":"满林钟磬夜偏长，古鼎闲焚柏子香。\n石榻未成芳草梦，西风吹雨过池塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"莫恨","author":"释斯植","text":"寂寞云深地，山空叶落时。\n自怜为隐僻，莫恨月来迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成","author":"释斯植","text":"东风玉勒马蹄轻，多少游人上凤城。\n燕子不来春寂寞，海棠花发近清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成","author":"释斯植","text":"渔歌听尽欲狂吟，一径人家柳影深。\n天意似嫌花信早，东风吹雨又成阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄勿斋提举","author":"释斯植","text":"满林烟树已纷纷，溪上猿声不共闻。\n唯有青山半庭月，夜深应与故人分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄静佳朱明府","author":"释斯植","text":"伤心独立旧池台，日日西风送雨来。\n别后思君无限事，一封书发两番开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚来","author":"释斯植","text":"晚来无语立东风，一片闲情在碧空。\n人老杜鹃浑不管，柳花飞尽夕阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚春偶题呈正甫先生","author":"释斯植","text":"老来春去怯凭栏，今古兴亡一笑间。\n满径落红人不到，杜鹃啼雨入空山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮边柳","author":"释斯植","text":"寂寞淮边柳，春来自舞腰。\n恨生争战地，不得近官桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清华夜坐","author":"释斯植","text":"开尽黄花满短篱，静听邻屋夜敲棋。\n清华池上三更月，僧在松边未有诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明","author":"释斯植","text":"堤上寻春步较迟，马嘶芳草燕差池。\n南楼烟雨清明日，正是佳人堕泪时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中寄岩泉","author":"释斯植","text":"吟罢新诗祇自看，晓风吹恨上阑干。\n夜来雪满前山路，谁对梅花说岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"堤上","author":"释斯植","text":"杨柳垂丝拂画船，杏花零落断桥边。\n半山烟雨东风恶，更向西亭听杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食","author":"释斯植","text":"江南江北纸钱飞，处处人家拜冢时。\n杜宇不禁寒食雨，五更啼血上花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖上晚望","author":"释斯植","text":"绕堤杨柳暗渔舟，二月风光淡似秋。\n几度笙歌人散后，夕阳依旧满红楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湘竹词","author":"释斯植","text":"湘魂何自怨，千古尚名存。\n不种庭边竹，那知有泪痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"落叶词","author":"释斯植","text":"片片飞来总是秋，更于何处复添愁。\n自怜枝上无收管，却带慇勤出御沟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"照影","author":"释斯植","text":"性与儿童异，飘蓬二十年。\n照来池上影，恰似未生前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丁巳灯夕前六日观抱拙寄敏斋韵因事有感走笔以赋","author":"释斯植","text":"萍迹倚春风，春光苦未浓。\n人间连日事，尘外一宵钟。\n远雁书难寄，残碑字已封。\n幽人住城市，清梦两三重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上竺寺","author":"释斯植","text":"古寺寒桥路，钟声静忽闻。\n数峰平处合，一水众溪分。\n老树烟萝雨，残灯石塔云。\n闲心寄幽寂，似觉远尘纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子规","author":"释斯植","text":"游魂如可见，况复雨霏霏。\n隔水栖无地，经春叫不归。\n影随芳树没，声入野花飞。\n那忍东风里，凄凉上客衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中即事","author":"释斯植","text":"千峰当此境，谁可共登临。\n月过秋池静，云归古木深。\n懒观前去事，已悟未来心。\n更欲寻诗伴，相携向石林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居怀旧隐","author":"释斯植","text":"静地独登临，虚闲称此心。\n猿声过木少，花影入池深。\n春殿依残日，晴烟散远林。\n因思南岳寺，长起石床吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居遣兴","author":"释斯植","text":"山寺闭脩竹，偏宜静者居。\n观空心已悟，集理事常虚。\n日月供吟笔，乾坤入草庐。\n何如钓台叟，得计在樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天竺山居","author":"释斯植","text":"对雨吟方稳，西风忽晚晴。\n野花沿涧白，秋意入帘清。\n浅水藏鱼影，重林隔磬声。\n是非尘外事，谁可继高名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水石山居","author":"释斯植","text":"静极青山里，松花满石床。\n春风思华岳，夜雨梦潇湘。\n人影归林薄，猿声出涧长。\n心如无别事，同此闭闲房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长洲夜泊","author":"释斯植","text":"吴楚昔曾游，凄凉满客舟。\n因思千古事，空起十年愁。\n目尽他山少，江流远地秋。\n今宵犹有月，不似庾公楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东斋书事","author":"释斯植","text":"客里吟情懒，天涯望欲昏。\n断云流涧水，残月照衡门。\n猿啸它山树，砧声何处村。\n浮名身外事，于此不须论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兰谷","author":"释斯植","text":"空谷寄深云，灵根自不群。\n地闲平草长，香远隔溪闻。\n静与骚人佩，清同楚客分。\n唯应千载后，馀韵在湘濆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对梅寄人","author":"释斯植","text":"欲问江梅信，吟筇带晚霞。\n笑看今日树，开遍几年花。\n疏影生来瘦，寒枝折处斜。\n要教人寄远，何地是君家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"边城客思","author":"释斯植","text":"客里厌芳尘，凄凉又问津。\n向南人去远，归北马嘶频。\n野水荒城暮，孤舟海树春。\n故乡非久别，已觉鬓毛新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"多福寺","author":"释斯植","text":"野鹿自成群，山中少隐君。\n钟声两寺合，人语一溪分。\n泉响松间雨，苔生石上纹。\n多年僧住此，半榻锁闲云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江寺晚眺","author":"释斯植","text":"尽日无多事，闲行一径阴。\n人归秋寺晚，月满夜堂深。\n海阔频生雾，城荒远见林。\n青山与华发，空愧百年心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自谓","author":"释斯植","text":"自谓清贫苦，那知即是安。\n路从平去好，事到口开难。\n松老心长在，花红色易残。\n浮生既如许，浑作梦中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访故人","author":"释斯植","text":"石榻相期久，闲寻到野房。\n春归芳草暗，云入楚山长。\n人影分孤驿，鸡声落曙桑。\n凄凉千古事，回首两茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过故城","author":"释斯植","text":"故城深巷长苍苔，一度经过一度哀。\n尚有楼台搀雨出，岂无花柳向春开。\n十年心事今宵梦，千里家书昨日回。\n莫上灞陵桥上望，楚天云尽蜀波来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过桃源","author":"释斯植","text":"□□□□□□□，生涯心在凤凰台。\n桃花晓落水流去，山鸟晚啼风送来。\n古树影摇霜月满，冷猿声裂碧云开。\n长关春有愁人分，驿马相逢去不回。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过越","author":"释斯植","text":"渺渺天涯路，扁舟去不穷。\n水花随岸尽，山影落江空。\n往事千年梦，渔歌一夜风。\n诗成唯有月，清致与谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴中即事","author":"释斯植","text":"世事交情浅，伤心独倚栏。\n海云经雨重，秦树入秋残。\n潮落吴天远，风生梦泽寒。\n英雄千古地，回首是长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀芳林处士","author":"释斯植","text":"相思不可见，江路正迢迢。\n烟树同吟远，关河入望遥。\n昼长花影转，风定篆香销。\n遥忆君居处，钟声隔暮潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐有感","author":"释斯植","text":"角送重城月，微风入夜凉。\n身轻长是寄，吟苦未应忘。\n坐久灯成烬，愁多鬓欲霜。\n百年还老去，谁可继馀芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岩栖分韵得深字","author":"释斯植","text":"寂寞空斋里，闲情起暮吟。\n路长沙鸟尽，人在翠微深。\n远树烟中没，寒花竹外寻。\n自嫌名与利，谁识此生心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金陵怀古","author":"释斯植","text":"天津桥上望，如在玉门关。\n月过东西浦，江分远近山。\n凄凉三尺墓，兴废六朝间。\n千古登临地，寒潮自往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]