[{"title":"好事近 其二","author":"仲并","text":"今古满胸中，韬略一时人杰。\n高卧溪山好处，迟十年斋钺。\n朱轓休傍武陵溪，梅花记曾别。\n早晚殿前归侍，总周庐千列。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"好事近 宴客七首。时留平江，俾侍儿歌以侑觞 其一","author":"仲并","text":"二陆起云间，千载风流人物。\n未似一门三凤，向层霄联翼。\n贞元朝士苦无多，公今未华发。\n重向紫宸朝路，立鹓鸾前列。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"好事近 其五","author":"仲并","text":"分手又三秋，犹记花时歌别。\n每念征帆归晚，误五湖风月。\n清江休望使君来，指日趋天阙。\n婿玉翁冰相映，看紫薇花发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"好事近 其三","author":"仲并","text":"淮上五分符，名在图书东壁。\n坐对书成多暇，写青箱千帙。\n一杯先为祝东风，丹诏来朝夕。\n何处称公挥翰，定北扉西掖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"好事近 其七","author":"仲并","text":"今雨几人来，冰霰更凝寒色。\n门外车多长者，顿光生蓬筚。\n缤纷飞雪更初梅，特特为留客。\n惟恨坐无华馔，只平时真率。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芰荷香 中秋在毗陵，不见月，作数语未成。后一日来澄江，途中先寄赵智夫","author":"仲并","text":"醉凝眸。\n正行云遮断，澄练江头。\n皓月今宵何处，不管中秋。\n朱阑倚遍，又微雨、催下危楼。\n秋风空响更筹。\n不将好梦，吹过南州。\n浮远轩窗异日到，山空云净，江远天浮。\n别去客怀，无赖准拟开愁。\n冰轮好在，解随我、天际归舟。\n何须舞袂歌喉。\n一觞一咏，谈笑风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 其一 冬至夜作","author":"仲并","text":"灰飞嶰竹。\n庆群阴消尽，新阳来复。\n云物呈祥连瑞霭，烟气纷纷馥馥。\n紫陌香衢，朱檐影里，罗绮花成簇。\n岭梅惊暖，数枝争绽寒玉。\n有人袅袅盈盈，今朝特地，为我新妆束。\n娇倚银床添绣线，长喜修眉舒绿。\n不道多情，锦屏罗幌，难得欢生足。\n谁知今夜，玉壶银漏催促。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 其二 和耿时举赋雪韵","author":"仲并","text":"江南春早，尚馀寒门巷，杨花飘逐。\n一色初梅开尽也，不数芳园红绿。\n珍重骚人，幽怀分寄，高韵歌黄竹。\n六花羞避，满笺凌乱琼玉。\n应念有客长安，履穿东郭，无与怜穷独。\n鼓棹前溪非兴尽，寒怯水栖岩宿。\n咫尺君家，瑶田无径，冰柱排银屋。\n瓮头春到，唤回晚梦清熟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 其三 王守生辰","author":"仲并","text":"金縢事业。\n庆丹青千载，勋在王室。\n圣主英明平万国，天产非常人物。\n岳渎分灵，熊罴符梦，五百年方出。\n致君尧舜，要须纯用经术。\n须信凤阁仙人，风流文采，蔼家声如昔。\n献纳司存持禁橐，合历三台清秩。\n倦宿承明，乞麾临郡，暂辍金闺直。\n五云深处，一星今在南极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 其二 同上","author":"仲并","text":"练江风静，卧冰奁百尺，朱阑飞入。\n江远浮天天在水，水满半天云湿。\n白鸟明边，青山断处，眼冷江头立。\n月明潮上，苇间渔唱声急。\n几度吹老蘋花，野香无数，欲寄应难及。\n天借诗人供醉眼，尊俎一时收拾。\n竹里行厨，花间步障，风雨生呼吸。\n酒阑歌罢，钓船先具蓑笠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武陵春 元若虚总管席上","author":"仲并","text":"门巷乌衣应好在，风韵尚依然。\n知是蓬瀛第几仙。\n秀色粲当筵。\n索句濡毫云阁里，清坐袅炉烟。\n谁赋回文第二篇。\n除是见娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"画堂春 即席","author":"仲并","text":"溪边风物已春分。\n画堂烟雨黄昏。\n水沈一缕袅炉薰。\n尽醉芳尊。\n舞袖飘摇回雪，歌喉宛转留云。\n人间能得几回闻。\n丞相休嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"画堂春 和秦少游韵","author":"仲并","text":"春波浅碧涨方池。\n池台深锁烟霏。\n缓歌争胜早莺啼。\n客忍轻归。\n合坐香凝宿雾，垫巾梅插寒枝。\n渐西蟾影漾馀辉。\n醉倒谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 赠外孙猷","author":"仲并","text":"秀出群儿，柳眉濯濯春庭院。\n不亲歌扇。\n弄笔勤书篆。\n翁已无能，老退惭赪面。\n欣同宴。\n坐来喜见。\n痛饮惊无算。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其三 和李达才韵","author":"仲并","text":"说似当年老季伦。\n君家虽富客常贫。\n何曾一笑任吾真。\n酒满罢留天下士，词新空赋坐中春。\n谁能绝笔更书麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一 示孟氏女","author":"仲并","text":"举案家风未肯低。\n清心端自秀深闺。\n芝兰玉树宁馨儿。\n早岁安禅灵照女，静中经卷手常携。\n声名要与断机齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 即席","author":"仲并","text":"清远湖山佳丽人。\n柳边花下复清晨。\n向前犹有几多春。\n祓禊秋千时节近，管弦歌舞一回新。\n未嗔狂客污车茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二","author":"仲并","text":"雅称诗人美孟都。\n清新幽韵比来无。\n新来学得绣工夫。\n经卷但知从阿母，醉来翁已要人扶。\n尚能把盏劝屠苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令 其二","author":"仲并","text":"倾国与倾城。\n袅袅盈盈。\n歌喉巧作断肠声。\n看尽风光花不语，却是多情。\n家近董双成。\n三妙齐名。\n谁教蜂蝶漫经营。\n留取无双风味在，真是琼英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令 其三 即事","author":"仲并","text":"草圣与诗馀。\n清韵谁如。\n生绡团扇倩谁书。\n月湛素华天似水，深院凉初。\n人散晚钟疏。\n后约还虚。\n良宵忍放枕鸾孤。\n要得相逢除是梦，有梦来无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令 其一 赠妓","author":"仲并","text":"趁拍舞初筵。\n柳袅春烟。\n街头桃李莫争妍。\n家本凤楼高处住，锦瑟华年。\n不用抹繁弦。\n歌韵天然。\n天教独立百花前。\n但愿人如天上月，三五团圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"眼儿媚 同孙尚书赴孟信安平江郡燕席上","author":"仲并","text":"铃阁寻盟未肯寒。\n鹢首驻江干。\n云烟翰墨，风流尊俎，不放更残。\n金声掷地西清老，天未许终闲。\n知音素赏，当筵一曲，流水高山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 和赵有逸坐上韵","author":"仲并","text":"宛如姑射人冰雪。\n知公不负佳风月。\n莫放漏声残。\n清风生坐间。\n赏春心未足。\n剪尽尊前烛。\n此乐自难忘。\n一觞还一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞鹤仙 春日咏怀","author":"仲并","text":"试六花院落。\n正柳绵飘坠，因风无著。\n吴王旧城郭。\n记乌衣门巷，小桥帘幕。\n他州寥索。\n漫等闲、桃英杏萼。\n认幽香来处，群芳尽掩，蕙心先觉。\n行乐。\n燕雏莺友，浪语狂歌，休休莫莫。\n兰房绣幄。\n添新恨，念前约。\n殢十分芳景，十分春意，休惜十分共酌。\n任十分、吹老寒梅，戍楼画角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓦山溪 有赠","author":"仲并","text":"冰清玉映，自是闺房秀。\n十里卷朱帘，好紫陌、家家未有。\n天然情素，高压一城春，花艳丽，月精神，梅韵腰肢瘦。\n曲屏虚幌，枉著鸳鸯绣。\n不是不相逢，泪空滴、年年别袖。\n从他兰菊，秋露与春风，终不似，玉人人，一片心长久。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其二 赠外孙夔","author":"仲并","text":"间世麒麟降自天。\n光辉列宿灿初躔。\n他年身致夔龙列，少日心存翰墨边。\n簪彩笔，照金莲。\n词华当使思如泉。\n未论耸壑昂霄事，且与衰翁慰暮年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其一 为饱子山侍妾燕燕作","author":"仲并","text":"小泊横塘日欲斜。\n一枝犹有未残花。\n几年燕子无消息，今日飞来王谢家。\n歌水调，韵琵琶。\n声声都是怨年华。\n钗头杏子今如许，剪烛裁诗莫问他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"仲并","text":"政恐崖州如有北，却应未肯受谗夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"负暄闲眠","author":"仲讷","text":"茅檐晴日暖于春，一枕钧天乐事新。\n满眼繁花皆得意，午眠安稳却无人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送唐御史","author":"仲讷","text":"力犯雷霆众共危，远投魑魅独为宜。\n忠州学业真无负，高庙神灵固有知。\n自倚圣明容直道，未甘憔悴死荒陲。\n满朝卿相多公议，莫把文章作楚辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题西门外笮桥下观音院","author":"仲昂","text":"雨砌风亭长绿苔，壁间题字半尘埃。\n城南萧寺无人迹，几度曾因送客来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"仲昂","text":"平生不识巴南路，梦到孤云两角西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"仲昂","text":"虑澹常高枕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名","author":"仲殊","text":"柏觞敛滟银幡小。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名 其一","author":"仲殊","text":"椒觞献寿瑶觞满。\n彩幡儿、轻轻剪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名 其四","author":"仲殊","text":"疏雨洗云轺，望极银河影里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名","author":"仲殊","text":"潇潇暮雨，梨花寒食。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名 其三","author":"仲殊","text":"遥想天孙离别后，一宵欢会，暂停机杼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名 其五","author":"仲殊","text":"玉线金针，千般声笑，月下人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名 其六","author":"仲殊","text":"戏马风流，佩茱萸时节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永同欢","author":"仲殊","text":"绣帘卷，沉烟细。\n燕堂深，玳筵初启。\n庭下芝兰，劝金卮，有多少雍容和气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉楼春","author":"仲殊","text":"飞香漠漠帘帷暖。\n一线水沈烟未断。\n红楼西畔小阑干，尽日倚阑人已远。\n黄梅雨入芭蕉晚。\n凤尾翠摇双叶短。\n旧年颜色旧年心，留到如今春不管。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其一","author":"仲殊","text":"耐老花间的子，长生海里明珠。\n南天星象降真符。\n五福同行同住。\n秀骨养成犀顶，被人唤作龙驹。\n传家事业有诗书。\n富贵功名看取。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 其二","author":"仲殊","text":"乙未河清九曲，神霄瑞降群仙。\n唯公殊宠最华年。\n高侍玉皇香案。\n富贵鹏程九万，康宁鹤算三千。\n功成拔宅上青天，愿厕庭中鸡犬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 柿","author":"仲殊","text":"味过华林芳蒂，色兼阳井沈朱。\n轻匀绛蜡裹团酥。\n不比人间甘露。\n神鼎十分火枣，龙盘三寸红珠。\n清含冰蜜洗云腴。\n只恐身轻飞去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"步蟾宫 其三","author":"仲殊","text":"凤帘舞带花铺绣。\n水沉暖、祥烟迷昼。\n凤衔灯照蕊珠筵，韵双琯、钧声已奏。\n绮罗人劝千秋寿。\n吉祥满、十分芳酒。\n愿人间、嘉庆一千年，共南极、东华长久。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"步蟾宫","author":"仲殊","text":"长庚星驭重来日，结灵秀、东阳清骨。\n过中秋，两夜月犹圆，五福降、先宫第一。\n鹤书新自金门出。\n乍受得、王宫缨绂。\n更登仙、箓上与长年，倩东斗、真人按笔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"步蟾宫 其二","author":"仲殊","text":"笙歌喜庆争催晓。\n篆烟舞、龙鸾缥缈。\n香罗上、不尽寿仙人，献一段、长生寿草。\n一心一意同欢笑。\n两心事、卒难得了。\n教传语、天上太白星，剩借取、几千年好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"步蟾宫 其一","author":"仲殊","text":"仙郎心似长江阔。\n妾意如、波间明月。\n相随定、一带向东流，共宴乐、无时暂歇。\n长生只在长欢悦。\n除此外、总应虚设。\n笙歌里、身住几何年，十字儿、头边下撇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其五 寒食","author":"仲殊","text":"涌金门外小瀛洲。\n寒食更风流。\n红船满湖歌吹，花外有高楼。\n晴日暖，淡烟浮。\n恣嬉游。\n三千粉黛，十二阑干，一片云头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其二 建康","author":"仲殊","text":"钟山影里看楼台。\n江烟晚翠开。\n六朝旧时明月，清夜满秦淮。\n寂寞处，两潮回。\n黯愁怀。\n汀花雨细，水树风闲，又是秋来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其四 春词","author":"仲殊","text":"长桥春水拍堤沙。\n疏雨带残霞。\n几声脆管何处，桥下有人家。\n宫树绿，晚烟斜。\n噪闲鸦。\n山光无尽，水风长在，满面杨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其一 春情","author":"仲殊","text":"楚江南岸小青楼。\n楼前人舣舟。\n别来后庭花晚，花上梦悠悠。\n山不断，水空流，漫凝眸。\n建康宫殿，燕子来时，多少闲愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其三 宝月山作","author":"仲殊","text":"清波门外拥轻衣。\n杨花相送飞。\n西湖又还春晚，水树乱莺啼。\n闲院宇，小帘帏。\n晚初归。\n钟声已过，篆香才点，月到门时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"定风波 独登多景楼","author":"仲殊","text":"花戟云幡拥上方。\n画帘风细度春香。\n银色界前多远景。\n人静。\n铁城西面又斜阳。\n山色入江流不尽，古今一梦莫思量。\n故里无家归去懒。\n伤远。\n年华满眼多凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 寿吴书监","author":"仲殊","text":"延陵福绪，蔼遗芳馀庆，直至如今。\n帝锡朋龟曾献策。\n早揖丹桂华簪。\n一代荣名，三州遗爱，留入歌吟。\n归来湖山付得，依旧闲心。\n延赏报德推封。\n名迁书监，喜天恩垂临。\n拜舞龙香还注想，丹阙拖紫垂金。\n酒满霞觞，期君眉寿，千岁与披衿。\n年年风月，两行门外桐阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 夏日避暑","author":"仲殊","text":"故园避暑，爱繁阴翳日，流霞供酌。\n竹影筛金泉漱玉，红映薇花帘箔。\n素质生风，香肌无汗，绣扇长闲却。\n双鸾栖处，绿筠时下风箨。\n吹断舞影歌声，阳台人去，有当年池阁。\n佩结兰英凝念久，言语精神依约。\n燕别雕梁，鸿归紫塞，音信凭谁托。\n争知好景，为君长是萧索。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇","author":"仲殊","text":"水枫叶下，乍湖光清浅。\n凉生商素。\n西帝宸游罗翠盖，拥出三千宫女。\n绛采娇春，铅华掩昼，占断鸳鸯浦。\n歌声摇曳，浣纱人在何处。\n别岸孤袅一枝，广寒宫殿，冷落栖愁苦。\n雪艳冰肌羞淡泊，偷把胭脂匀注。\n媚脸笼霞，芳心泣露，不肯为云雨。\n金波影里，为谁长恁凝伫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金蕉叶","author":"仲殊","text":"丛霄逸韵祥烟渺。\n摇金翠、玲珑三岛。\n地控全吴，山横旧楚春来早。\n千里断云芳草。\n六朝遗恨连江表。\n都分付、倚楼吟啸。\n铁瓮城头，一声画角吹残照。\n带夜潮来到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南柯子/南歌子 六和塔","author":"仲殊","text":"金甃蟠龙尾，莲开舞凤头。\n凉生宫殿不因秋。\n门外莫寻尘世，卷地江流。\n霁色澄千里，潮声带两洲。\n月华清泛浪花浮。\n今夜蓬莱归梦，十二琼楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆江南 其一 瓮城","author":"仲殊","text":"南徐好，鼓角乱云中。\n金地浮山星两点，铁城横锁瓮三重。\n开国旧夸雄。\n春过后，佳气荡晴空。\n渌水画桥沽酒市，清江晚渡落花风。\n千古夕阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子","author":"仲殊","text":"解舞清平乐，如今说向谁。\n红炉片雪上钳锤。\n打就金毛狮子、也堪疑。\n木女明开眼，泥人暗皱眉。\n蟠桃已是著花迟。\n不向春风一笑、待何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 忆旧","author":"仲殊","text":"十里青山远，潮平陆带沙。\n数声啼鸟怨年华。\n又是凄凉时候、在天涯。\n白露收残暑，清风衬晚霞。\n绿杨堤畔闹荷花。\n记得年时沽酒、那人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳垂金","author":"仲殊","text":"中春天气禁烟暖。\n馀七叶，丹蓂未卷。\n海岳灵辉储庆远。\n降非熊，运符亨旦。\n宝雾香凝，非锦筵红荐。\n永算金尊屡满，酒里千年春烂熳。\n共朱颜，镇长相见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳梢青 吴中","author":"仲殊","text":"岸草平沙。\n吴王故苑，柳袅烟斜。\n雨后寒轻，风前香软，春在梨花。\n行人一棹天涯。\n酒醒处，残阳乱鸦。\n门外秋千，墙头红粉，深院谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]