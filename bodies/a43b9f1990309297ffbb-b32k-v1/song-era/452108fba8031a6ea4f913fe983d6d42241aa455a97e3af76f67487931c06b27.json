[{"title":"送陈学士知常州","author":"胡宿","text":"金斗城高二浙西，使君初拜武都泥。\n射堂五色开云的，齐队千兵衣水犀。\n仙阁旧香芸辟蠹，使轩新荫李成蹊。\n下车定有中和曲，索米州民日倚輗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览朱表臣卷","author":"胡宿","text":"乌巷名生卓不群，阶庭相伴玉枝薰。\n天边禁树开龙凤，笔下清才坠鸟云。\n三级火雷何日化，一堂金竹此时闻。\n牛心割炙探来嚼，争得英瑶去报君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览孙祐甫卷","author":"胡宿","text":"君家先正隐瑰材，岩石清声动汉台。\n地底何年埋玉树，蚌中今幸产珠胎。\n毡书未挂千名榜，豆咏争传八斗才。\n荆璧夜来烦抵鹊，宝编三复翳瞳开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南至之日辇下书事呈正卿子高二同年","author":"胡宿","text":"岁暮繁云结夕阴，长安客舍费黄金。\n烛窗明暗翻归梦，雪屋清寒著旅衾。\n宝骑传呼三陌广，铜龙飘点九门深。\n万年寿酒无因上，阳藿空倾向日心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芙蓉湖泛舟","author":"胡宿","text":"小湖香艳战芙蓉，碧叶田田拥钓蓬。\n岚气欲飞山隔岸，秋光不定水摇空。\n翩翻雪鸟争投浦，拨剌霜鳞斗掷风。\n正是沧浪濯缨日，一竿多谢紫溪翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过李白坟","author":"胡宿","text":"平昔驰名蜀道难，旅魂流落古苔斑。\n土中宝树埋何在，泽畔灵魂些不还。\n醉后烟霞仍物外，吟馀风月尚人间。\n一哀吊罢颓阳暮，江北江南尽是山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送致政秘丞","author":"胡宿","text":"二纪青衫拂洛尘，桂香消尽故时春。\n径为天上乘槎客，厌作河滨托乘人。\n老笔工诗殊觉丽，清谈倾座几相亲。\n临沧送别多瑰藻，三径归资莫叹贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送致政吴宾客","author":"胡宿","text":"挂冕高辞九列荣，年如园绮尚康宁。\n水苍乍解趋朝佩，云母初閒隔署屏。\n商岭紫芝歌几曲，武夷毛竹梦频惊。\n门前已见施行马，更待沙堤接鲤庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄致政蒋侍郎","author":"胡宿","text":"八十磻溪用钓翁，丈人冰雪在颜容。\n乞身未及调缘鹄，济世何当起卧龙。\n先觉令名侔大蔡，后彫遐福集寒松。\n怜才好客还依旧，终日清谈绿酒醲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和承旨给事寄酬南京致政杜相公","author":"胡宿","text":"贤相辞荣鬓未斑，济川舟楫一朝閒。\n苍生犹望安车起，使者空持拱璧还。\n郢曲传来都辇下，萧规留在庙堂间。\n壮猷全德知难尚，后世高名重太山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凉思","author":"胡宿","text":"昨夜南星破暑威，月波浮动杵天垂。\n露华冷向三危滴，秋色新从一叶知。\n越水旧歌迷桂楫，楚江秋思绕兰旗。\n桃笙碧滑人无寐，欲借鲛盘寄所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凉州","author":"胡宿","text":"一从天宝陷凉州，路绝阳关数百秋。\n谁念弓裘侵紫塞，空馀歌舞在红楼。\n将兵古有龙韬略，仗节今无燕颔侯。\n五鼎元戎方肉食，腐儒何者预军谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送姚秘校归霅","author":"胡宿","text":"苕溪曾是忝朱轮，鸣鹿当年预送宾。\n楚国频嗟三献璞，汉廷裁得半通纶。\n劳歌未免吟梁甫，作赋还应问大钧。\n下泽乘车知道在，折腰那久滞风尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄芜湖吴殿丞","author":"胡宿","text":"大花滩外忆琴堂，西北山长水更长。\n缩地何曾人有术，摩天不及鸟能翔。\n寒梅弄脸英英态，腊瓮蒸醅满满香。\n怅望未休还怅望，夜来庭下月如霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄临淮蒋使君","author":"胡宿","text":"汉台分刺辍名臣，隼旆还临磬水滨。\n殿石乍辞龙尾远，印鞶初结兽头新。\n贯花佛会连香刹，种杏仙阴接宝邻。\n荆府依刘心未获，却怜驯鹿伴行春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吴春卿早春即事","author":"胡宿","text":"腊过春云尚带阴，故山迢递忆青岑。\n芸斋旧帙书签冷，桂瓮新香酒蚁深。\n复道风烟殊可眺，曲江花柳试偷寻。\n芳樽一笑真难得，永埒何曾有剩金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄龙图李谏议","author":"胡宿","text":"虎符兼绾铁林兵，安辑南方十二城。\n昏晓星文通翼轸，阴晴云气接巫衡。\n江飘画角蛟龙思，风猎干旟鸟隼鸣。\n谁伴使君红烛宴，漆堂深夜促银筝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送林学士赴明州","author":"胡宿","text":"绿绨膺检出神州，又保东吴最上游。\n腰下金符分半虎，手中庖刃欠全牛。\n金尊酌月吴歈席，锦缆牵风越鄂舟。\n正是金华隆旧业，群仙相望在瀛州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送施屯田守姑熟","author":"胡宿","text":"台城南畔拥油韬，四十名郎此梦刀。\n文陛入辞交戟密，太微回望积星高。\n醉罗定费斋中酎，吟管应催石上毫。\n莫恋江东佳丽地，归来开院接金鳌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄江淮太守表臣职方","author":"胡宿","text":"画省高才滞两轓，秋来依旧对淮山。\n一函星斗龙渊在，万里风云骥足閒。\n赋咏且裁红烛下，卷怀聊寄绿樽间。\n次公治行闻当牖，二节如今即召还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送宗兄郎中守三衢","author":"胡宿","text":"新旧鞶囊两兽头，东南乡郡得龙丘。\n朱丹侯毂聊行县，紫翠家山更满楼。\n高第郎官犹应宿，中材裨将辄封侯。\n浩然能养浮云志，风月樽前且献酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送谭寺丞守郁平","author":"胡宿","text":"金契为州复侍亲，却从湖际访仙村。\n花垂晚席倾家酿，柳拂春车过里门。\n关内已誇新组去，浦中仍见旧珠存。\n名园日涉庭无讼，丝管时时荐寿樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"集贤石学士出守符离","author":"胡宿","text":"日边新拥两朱轓，亦以斜飞试羽翰。\n巴郡词人才藻壮，汉家循吏教条宽。\n明光奏事衣香在，丽正修书砚滴残。\n岁晚政成丹诏下，归来天上作仙官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"残花","author":"胡宿","text":"雨压残红一夜凋，晓来帘外正飘飖。\n数枝翠叶空相对，万片香魂不可招。\n长乐梦回春寂寂，武陵人去水迢迢。\n忍将玉笛传遗恨，苦被芳风透绮寮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和承旨宋尚书告中之作","author":"胡宿","text":"鹊声频绕大槐枝，鳌禁欢闻旧老归。\n哆舌人间无翕訾，奎钩天上有晶晖。\n西山五色分灵药，南极三光接太微。\n只待延英朝只日，便应调鼎向黄扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"橘","author":"胡宿","text":"龙阳洲上密于星，红实累累照日明。\n露濯晓枝金色重，霜封秋蒂粉衣轻。\n楚江未分萍如蜜，汉殿何曾蔗析酲。\n谁道相如能作赋，诏园先熟是虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送次道学士倅洛中","author":"胡宿","text":"留籥初均相府劳，辟书先下得虔刀。\n黄图气象占龙阙，丹穴精神识凤毛。\n一代策书承世学，三川风月属诗豪。\n山公更有通家旧，应许论文醉醁醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送周屯田倅南徐","author":"胡宿","text":"浙河分镇压东西，铁瓮由来重会稽。\n地势顿惊江海近，天文全觉斗牛低。\n鸣秋鼓角翻朱鹭，映日楼台拂彩霓。\n绿发名郎才韵秀，政成看奉紫芝泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送子思学士倅河内","author":"胡宿","text":"左符通掌日边城，几荫华榱奉刺经。\n直舍十年苔已紫，吟鞭一路柳初青。\n禁中夜阁抛行月，郊外春车驾屏星。\n河里旧游从古盛，好寻烟幌吊遗灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送薛监丞倅绛台","author":"胡宿","text":"故绛山川宰树存，屏星分守出宸恩。\n官荣此去夸乡组，家法从来式里门。\n别斝正怜黄菊绽，征鞍犹怯黑貂温。\n守居旧号园池美，应伴山翁把翠樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠梅圣俞试馆职得赐进士出身","author":"胡宿","text":"赋就甘泉客荐雄，独攀仙桂向秋风。\n抽毫同列三英座，换骨才争第一功。\n瞥看灵鳌居水下，恍闻仙犬吠云中。\n嫦娥应有怜才意，惟许诗人到月宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮南王","author":"胡宿","text":"贪铸金钱盗写符，何曾七国戒前车。\n长生不待炉中药，鸿宝谁收箧里书。\n碧井床空天影在，小山人去桂丛疏。\n云中鸡犬无消息，秀麦渐渐遍故墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘观察赴襄阳","author":"胡宿","text":"甲队霜秋瑩武蜂，万兵都府去临戎。\n习池岘首风流远，汉水方城气象雄。\n宴榭鸣鼍飘画鼓，射堂栖鹊试雕弓。\n平时公子推能政，爱日遥知遍境中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题徐都官吴下园亭","author":"胡宿","text":"吴下新居树石中，绿岩香叶一重重。\n潺湲枕上闻流水，缥缈檐间见好峰。\n山客对棋閒觅劫，野僧留话几侵钟。\n由来止足前贤事，他日何惭邴曼容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洞灵观纳凉","author":"胡宿","text":"秋波不动簟纹融，松月愔愔透绮栊。\n霜重井梧翻瘦碧，雨回阶药堕嫣红。\n彩鸳静占银塘水，乳燕凉飞玉宇风。\n秫酒易销残梦断，却疑身在广寒宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天街晓望","author":"胡宿","text":"长乐才闻一叩钟，百官初谒未央宫。\n金波穆穆沙堤月，玉树琤琤上苑风。\n香重椒兰横结雾，气寒龙虎远浮空。\n嗟余索米无人问，行避霜台御史骢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄昭潭王中立","author":"胡宿","text":"高弦一弄武陵深，六幕天空万里心。\n吴苑歌骊成久别，楚峰回雁好归音。\n十千美酒花期隔，三百枯棋弈思沈。\n莫上孤城频送目，浮云西北是家林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵徐爽见寄","author":"胡宿","text":"五两青丝帝渥深，平时可敢叹英沈。\n侏儒自是长三尺，澼絖都来直数金。\n寂寞死灰人丧偶，婆娑生意树交阴。\n年来想见琼枝色，久梦蘧蘧到竹林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪","author":"韩维","text":"屏翳驱云结夜阴，素华飘堕恶氛沈。\n色欺曹国麻衣浅，寒入荆王翠被深。\n天上明河银作水，海中仙树玉成林。\n日高独拥鹴裘卧，谁乞长安取酒金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城南","author":"胡宿","text":"昨夜轻阴结夕霏，城南十里有香泥。\n初闻山鸟惊新哢，遥见林花识旧蹊。\n荡桨远从芳草渡，垫巾还傍缘杨堤。\n罗敷正苦桑蚕事，惆怅南来五马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早夏","author":"胡宿","text":"井辖投多思不禁，密垂珠箔昼沈沈。\n睡惊燕语频移枕，病起蛛丝半在琴。\n雨径乱花埋宿艳，月轩脩竹转凉阴。\n一春酒费知多少，探尽囊中换赋金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿秀峰寺","author":"胡宿","text":"夕钟初断海鲸音，投宿香园半翠岑。\n冰簟浸床消客梦，水帘澄月伴僧吟。\n雄风拂衽清凉极，珍树交柯翠翳深。\n一夜汉阴机事息，草堂虚论破烦襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太湖石","author":"胡宿","text":"海岱铅松妄得名，洞庭山脚失寒琼。\n漱成一朵孤云势，费尽千年白浪声。\n谁向机边逢织女，直疑岩下见初平。\n年来赏物多成病，日绕苍苔几遍行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过桐庐","author":"胡宿","text":"两岸山花中有溪，山花红白遍高低。\n灵源忽若乘槎到，仙洞还同采药迷。\n二月辛夷犹未落，五更鸦臼最先啼。\n茶烟渔火遥堪画，一片人家在水西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆荐福寺牡丹","author":"胡宿","text":"十日春风隔翠岑，祇应繁朵自成阴。\n樽前可要人颓玉，树底遥知地侧金。\n花界三千春渺渺，铜槃十二夜沈沈。\n雕盘分篸何由得，空作西州拥鼻吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和朱况雨中之什","author":"胡宿","text":"苍野迷云黯不归，远风吹雨入岩扉。\n石床润极琴丝缓，水阁寒多酒力微。\n夕梦将成还滴滴，春心欲断正霏霏。\n忧花惜月长如此，争得东阳病骨肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冲虚观","author":"胡宿","text":"五粒青松护翠苔，石门岑寂断纤埃。\n水浮花片知仙路，风递鸾声认啸台。\n桐井晓寒千乳敛，茗园春嫩一旗开。\n驰烟未勒山亭字，可是英灵许再来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮南发运赵邢州被诏归阙","author":"胡宿","text":"天台封诏紫泥馨，马首前瞻北斗城。\n人在函关先望气，帝于京兆最知名。\n一区东第趋晨近，数刻西厢接昼荣。\n正是两宫裁化日，百金双璧拜虞卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪后登秘阁","author":"胡宿","text":"消尽层阴上尽梯，雪馀宫瓦弄晴晖。\n碧檐交照虬争耸，朱阙相联凤欲飞。\n日向金沟春溜动，风来珠树晓寒微。\n帝家池籞饶芳物，白鸟翩翩接翼归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和前人","author":"胡宿","text":"作者傍边好见闻，速来就汝作比邻。\n诗中活法无多子，眼里知音有几人。\n尔许精奇花粲笔，岂容尘俗海翻银。\n老夫幸有千机锦，尚欠江头一浣新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"侯家","author":"胡宿","text":"洞户春迟漏箭长，短辕初返洛城傍。\n彩云按曲青岑醴，沈水薰衣白璧堂。\n前槛兰苕依玉树，后园桐叶护银床。\n宴残红烛长庚烂，还促朝珂谒未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋风","author":"胡宿","text":"瑟瑟新声脱绿槐，半寒天气日相催。\n西楼夜色吟偏好，南国朝云梦未回。\n翠影暗牵蘋叶动，清香遥猎桂枝来。\n重阳渐近松醪熟，白菊如何为放开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送马少卿赴襄阳","author":"胡宿","text":"冰操从来畏四知，汉江南畔拥藩麾。\n地经谢守开油幕，人忆山公倒接䍦。\n风入射堂飘鼓吹，雨随行县湿旌旗。\n前朝叔子流遗爱，拂藓应看岘首碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送宝应李尉","author":"胡宿","text":"曾飞丽藻清尧问，犹屈长才尉楚城。\n官是神仙标秀领，县因灵宝纪嘉名。\n西昆已挟凌云誉，外户全消击柝声。\n早晚声名来谒帝，会看双璧赐虞卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹","author":"胡宿","text":"修篁百个静无埃，忆共山僧竞日栽。\n夭矫翠虬身欲化，婆娑青凤尾全开。\n风含爽籁依朱槛，月镂青阴覆翠苔。\n曾为檀栾冲雪看，玉枝相亚晓皑皑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送周学士归永嘉","author":"胡宿","text":"三最初承予告恩，一双青翰出都门。\n关繻旧弃人多识，桥柱前题墨未昏。\n南国归云聊送目，河梁新月暂消魂。\n玉山丹府重来日，好拾风谣奏帝阍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送聂学士赴阙","author":"胡宿","text":"台召西来二节荣，清江浮舸鸭头平。\n十行受诏龙纶重，五两占风鸟羽轻。\n目送华林春雨色，梦随长乐晓钟声。\n伫看只日延英对，丸墨宫毫属长卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张学士赴邵武兼过吴中别墅","author":"胡宿","text":"青藜香灺掩残书，越绝东南驾隼旟。\n紫陌花期经祓禊，清淮潮信待蟾蜍。\n鸟声百啭春芳际，蚕候三眠夏叶初。\n吴地吟朋如见问，为言江令忆鳀鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄张唐公学士","author":"胡宿","text":"朱航东下忽经春，藏室离居作恶频。\n简上蠹蟫终日在，树间灵鹊至今驯。\n北宫自有咿嚘客，天禄谁同寂寞人。\n昨夜西窗有佳月，此心迢递思冰轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"千叶瑞荷花","author":"胡宿","text":"绛蕊层层吐翠罗，水妃冠重晓峨峨。\n应嫌菖本开花少，却斗榴房著子多。\n含露自知芳意在，偃风无奈落英何。\n更怜玉骨藏深怨，暗结千丝在绿波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题涟漪亭","author":"胡宿","text":"槛底凝漪碧漫天，角巾东路主人贤。\n汀花照席供春醉，沙鸟窥帘伴昼眠。\n何必驭风追汗漫，不妨乘月弄潺湲。\n流杯若仿山阴事，兼有蛙声当管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"津亭","author":"胡宿","text":"津亭歌阕戒棠舟，五两风轻不少留。\n西北浮云来魏阙，东南初日背秦楼。\n层城渺渺人伤别，芳草萋萋客倦游。\n平乐旧欢收未得，更凭飞梦到瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀松江","author":"胡宿","text":"多年襆被玉山岑，鬓雪欺人忽满簪。\n驽马虽然贪短豆，野麋终是忆长林。\n鲈鱼未得乘归兴，鸥鸟惟应信此心。\n见说新桥好风景，会须乘月濯烦襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题齐氏山斋","author":"胡宿","text":"有客稽山岸角巾，宝书盈笈日怡神。\n云衔别岭支筇久，月上前峰隐几频。\n窗上萝阴猿警旦，坞中茶候鸟啼春。\n一经邹谚能传世，子舍于今两绶新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]