[{"title":"浣溪沙 试香罗","author":"韩淲","text":"风软湖光远荡磨。\n春衫初试薄香罗。\n踏青无计奈君何。\n莫笑老来多岁月，肯教闲去少诗歌。\n长安陌上有铜驼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其一 涧上昌甫有词","author":"韩淲","text":"闲里相看两鬓秋。\n酒能沾醉雨能幽。\n吾庐何幸得翁留。\n世路尽教终易与，山林佳话恐难酬。\n人来人去亦知不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 十四日","author":"韩淲","text":"百花丛里试新妆。\n不许巫山枉断肠。\n牡丹风扬曲声长。\n寒食清明间节序，绮窗朱户少年场。\n燕泥香润落空梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其三 生朝和昌甫韵","author":"韩淲","text":"老觉空生易得年。\n闲居那复问旌旃。\n一丘春静自回旋。\n翁善于人知美矣，我行于世转乖然。\n清词俾寿喜言传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其二 次韵伊一","author":"韩淲","text":"水绕孤村客路赊。\n一楼风雨角巾斜。\n举觞无复问煎茶。\n夜静曲声初喷竹，酒深烛影细吹花。\n明朝飞鹭起圆沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 怨啼鹃","author":"韩淲","text":"锦瑟瑶琴续断弦。\n璧堂初过牡丹天。\n玉钩斜压小珠帘。\n睡鸭炉温吟散后，双鸳屏掩酒醒前。\n一番春事怨啼鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其一 又","author":"韩淲","text":"系得船儿柳岸头。\n夹江灯火雨飕飕。\n寻诗家醉更绸缪。\n待腊未教寒事少，小春搀取暗香浮。\n夜长飞梦失清愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其三 次韵昌甫","author":"韩淲","text":"莫问星星鬓染霜。\n一杯同看月昏黄。\n放歌渔父濯沧浪。\n却忆手栽双柳句，真成云汉抉天章。\n苏仙何在立苍茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 又","author":"韩淲","text":"忆把兰桡系柳堤。\n斜风细雨一蓑衣。\n夕阳回照断霞飞。\n洛浦佩寒如隔日，高唐梦到又何时。\n背人挑□独心知。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 又","author":"韩淲","text":"春入疏弦调外声。\n雪云初霁带湖清。\n屏温香软绮窗深。\n山倚虚窗情淡淡，水流清浅韵泠泠。\n断魂醒处梦难凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其一 沙溪小饮","author":"韩淲","text":"一抹青山拍岸溪。\n麦云将过笋初齐。\n不知何处水流西。\n小阁路头吾欲醉，短蓬船尾客同携。\n酒边华发更题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其二 元夕","author":"韩淲","text":"分付心情作上元。\n不知投老在林泉。\n谁将村酒劝觥船。\n月影静摇风柳外，霜华寒浸雪梅边。\n醉敧乌帽忽醒然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其一 同昌甫饮南池","author":"韩淲","text":"屋上青山列晚云。\n水边红袂映斜曛。\n柳阴荷气簟湘纹。\n酒以歌长谁乐事，诗成杯滟我离群。\n香消凉意有南薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 次韵昌甫","author":"韩淲","text":"作意如何和好歌。\n细翻重看得长哦。\n晓梧吹雨露明荷。\n老我从他琴下爨，故人元自笛亭柯。\n北山烟岫郁嵯峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 其二 至日带湖","author":"韩淲","text":"爱日回春一线长。\n氛氲谁忆御炉香。\n孤城岁晚卧沧江。\n花底千官迎淑气，湖阴十里写晴光。\n剩拼华发醉为乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 满院春","author":"韩淲","text":"芍药酴醾满院春。\n门前杨柳媚晴曛。\n重帘双燕语沈沈。\n花映绿娇初日嫩，叶栖红小晚烟昏。\n轻雷不觉送微阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海月谣 送赵永兴宰","author":"韩淲","text":"晚秋烟渚。\n更舟倚、萧萧雨。\n水痕清汜，迤逦渐整，云帆西去。\n三叠阳关，留下别离情绪。\n溪南一坞。\n对风月、谁为主。\n酒徒诗社，自此冷落，胸怀尘土。\n目送鸿飞，莫听数声柔橹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 梅词","author":"韩淲","text":"菊花开了。\n待得梅梢来索笑。\n雪色江波。\n看尽千林未觉多。\n一丘缓步。\n只恐朝来有新句。\n岁岁年年。\n白发催人到酒边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 昌甫以嵇叔夜语作曲，戏用杜子美诗和韵","author":"韩淲","text":"一杯易足。\n自断此生犹杜曲。\n词客哀时，不敢愁来赋别离。\n孤城麦秀。\n常愧葛洪丹未就。\n诗罢长吟。\n衰晚迟回违寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 次昌甫韵","author":"韩淲","text":"年光虚度。\n能得几多消散处。\n莫恨归迟。\n得见新词不自持。\n山中酒里。\n笑语喧哗知有弟。\n此意谁如。\n世事纷纷一任渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花 初五日昌甫生朝，因庆七十","author":"韩淲","text":"从心所欲。\n高蹈祠官惟见独。\n其寿伊何。\n古井章泉水不波。\n腊前梅好。\n玉洁日光香耐老。\n才大三千。\n首首清诗得自编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"探春令 景龙灯","author":"韩淲","text":"暗尘明月小桃枝，旧家时情味。\n问而今、风转蛾儿底。\n有谁把、春衫试。\n景龙灯火升平世。\n动长安歌吹。\n这山城、不道人能记。\n甚村酒、偏教醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平乐 次韵","author":"韩淲","text":"萧然在涧。\n景色秋来冠。\n几缕明霞红未断。\n矫首时时遐观。\n回思五马清游。\n分明前辈风流。\n留作山间佳话，更谁愁上眉头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平乐 七月十三日潘令生朝","author":"韩淲","text":"鸣琴单父。\n凫舄宜飞去。\n不比河阳花满树。\n此意直高千古。\n清秋诞日相逢。\n乃同涧上村侬。\n笑指壶山为寿，仁心静处加功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平乐 寿潘文叔","author":"韩淲","text":"常思高致。\n又见凉风起。\n欢喜年时为寿意。\n快写山歌重寄。\n愿公好德康宁。\n青云收取功名。\n莫道而今官小，吾儒正要仁民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"眼儿媚 社日","author":"韩淲","text":"风回香雪到梨花。\n山影是谁家。\n小窗未晚，重檐初霁，玉倚蒹葭。\n社寒不管人如此，依旧在天涯。\n碧云暮合，芳心撩乱，醉眼横斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"眼儿媚 下郭赵园","author":"韩淲","text":"西溪回合小青苍。\n梅雨弄残阳。\n意行陇亩，景分庭院，乳燕春长。\n酒深不用人歌啸，锄圃试商量。\n细晞菜甲，旋寻蔬笋，一梦黄粱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"眼儿媚","author":"韩淲","text":"东风拂槛露犹寒。\n花重湿阑干。\n淡云殢日，晨光微透，帘幕香残。\n阴晴不定瑶阶润，新恨觉心阑。\n凭高望断，绿杨南陌，无限关山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 张饶县以一枝梅来，和韵","author":"韩淲","text":"的皪南枝横县宇。\n空山无此新花吐。\n手种几多梅。\n迎霜今已开。\n簪屏聊隐几。\n诗与君应喜。\n更报晏斋翁。\n相将索笑同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 梅花句","author":"韩淲","text":"风前觅得梅花句。\n香来自是相分付。\n片月动黄昏。\n一枝横酒尊。\n人间何处有。\n又到春时候。\n莫负此诗家。\n将心吟好花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 晚云烘日","author":"韩淲","text":"晚云烘日枝南北。\n一杯未尽梅花曲。\n城郭小春回。\n暗香开未开。\n留连吾欲醉。\n醉眼红尘外。\n多少老心情。\n景清人亦清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 次韵","author":"韩淲","text":"人间多少闲风度。\n薄情失记相逢处。\n绿鬓画鸦儿。\n旧巢双燕栖。\n舞衫回素玉。\n檀板声何蹙。\n一抹晚霞飞。\n泪痕无脸啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 同仲明饮山隐","author":"韩淲","text":"雪云收尽晴风软。\n小山春浪晴波远。\n梅片已飞香。\n海棠红试妆。\n人言诗易与。\n酒盏谁分付。\n不是没心情。\n夕阳啼鸟声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 花溪碧","author":"韩淲","text":"丝丝柳色清愁织。\n山城望断花溪碧。\n回首仲宣楼。\n登临无计愁。\n雨声吹海立。\n流转韶光急。\n九万有鹏程。\n沈香天上亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 野趣观梅","author":"韩淲","text":"平生常为梅花醉。\n数枝滴滴香沾袂。\n雪后月华明。\n胆瓶无限清。\n夜深灯影瘦。\n饮尽杯中酒。\n明日景尤新。\n人间都是春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其一 寿昌甫生朝","author":"韩淲","text":"今年是处梅花早。\n分明开到章泉好。\n兄弟寿杯同。\n暗香明月风。\n风流文物旧。\n春意枝枝透。\n儿侄定飞轩。\n衣冠与世传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 胡教生朝","author":"韩淲","text":"南枝已见春消息。\n今年为寿方知得。\n俾尔炽而昌。\n流霞浮暗香。\n蓬壶清浅水。\n笑指云阶喜。\n高论有规模。\n平戎赋两都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 花间意","author":"韩淲","text":"小园红入春无际。\n新声休写花间意。\n一笑唤真真。\n香腮酒未醒。\n惜芳追胜事。\n畅饮馀诗思。\n无处说衷情。\n暗尘罗帐生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 酒半戏成","author":"韩淲","text":"秋林只共秋风老。\n秋山却笑秋吟少。\n恰恨有秋香。\n青岩秋夜凉。\n清秋须是酒。\n结客秋知否。\n醉笔写成秋。\n一秋无复愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 小词","author":"韩淲","text":"海棠欲谢绵飞柳。\n柳丝自拂行人首。\n上巳是清明。\n新烟带粥饧。\n轻阴帘幕冷。\n闲却秋千影。\n曲水兴无涯。\n丽人花半遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 其二 十五夜，昌甫约赋，寄刘簿","author":"韩淲","text":"聚星亭下书堂水。\n冬来欲问梅花使。\n圭撮是何官。\n人间有底难。\n章泉词和去。\n交道元如故。\n转眼岁将穷。\n溪头鹤发翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 次韵昌甫见贻生朝","author":"韩淲","text":"春来晴雨常相半。\n水光风力花撩乱。\n山北与山南。\n行歌或再三。\n诵君诗过日。\n才大真盘屈。\n寿我敢言酬。\n相望亦饮不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 和昌甫见招","author":"韩淲","text":"归来又喜山中约。\n菊枝桂树真宜酌。\n兴尽只观山。\n秋深方闭关。\n会须追雅步。\n策蹇或肩舆。\n少待必能治。\n膏肓泉石医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"菩萨蛮 赵昌甫折黄岩梅来，且寄菩萨蛮，次韵赋之","author":"韩淲","text":"陇头无驿奚为朵。\n岩前有折宜来堕。\n风急雪云溪。\n诗清满意携。\n竹炉良夜饮。\n饮竟煎僧茗。\n梅以句深长。\n得花情未忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 其二 又","author":"韩淲","text":"幽意熟。\n吟啸春风自足。\n爽气初生晴未燠。\n相逢休问卜。\n画出高山盘谷。\n岩上飞云相逐。\n他日江东思渭北。\n断弦谁为续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 不怕醉","author":"韩淲","text":"不怕醉。\n记取吟边滋味。\n幽草绿阴花絮里。\n莺啼双燕起。\n老去是何乡里。\n漠漠吴头楚尾。\n一曲荒山清照水。\n殢渠杯酒旨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 次韵郑婺源","author":"韩淲","text":"行又住。\n水远山遥村路。\n把酒问春春几许。\n老年花似雾。\n坐上风流张绪。\n留我我还难去。\n却忆章台飞柳絮。\n只愁萦暮雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 方斋小集，有琴者，昌甫作词，和韵","author":"韩淲","text":"闲度日。\n愁里费人辞辟。\n榆火新烟还熟食。\n小墙花槛直。\n锦字玉徽清集。\n何用主人留客。\n相赏暂时谁画得。\n庞公非浪出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 带湖新月","author":"韩淲","text":"云外月。\n画出一痕清绝。\n梅已飘零桃未发。\n带湖烟水阔。\n汀渚尚留微雪。\n不恨酒融歌歇。\n老我多情胶漫结。\n半醒空自说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 东风吹酒面","author":"韩淲","text":"花影半。\n晴色乍开云卷。\n择胜寻春愁日短。\n雨馀山路晚。\n涧底桃深红满。\n人意不禁闲远。\n胡蝶绕枝啼鸟怨。\n东风吹酒面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 春早湖山","author":"韩淲","text":"春尚早。\n春入湖山渐好。\n人去人来虽未老。\n酒徒犹恨少。\n梅落桃开烟岛。\n日日更吹香草。\n一片芳心拚醉倒。\n冷云藏落照。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 其一 和昌甫","author":"韩淲","text":"花肃肃。\n杨柳三眠未足。\n一棹溪山新涨绿。\n旧欢无梦续。\n莫问杜鹃啼蜀。\n只有江南水竹。\n北客凄凉无伴独。\n春山生草木。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 醉花春","author":"韩淲","text":"人已醉。\n溪北溪南春意。\n击鼓吹箫花落未。\n杏梅桃共李。\n水底鱼龙惊起。\n推枕月明千里。\n伊吕衰翁徒尔耳。\n我怀犹未是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 昌甫作长短句呈朱卿、余倅，因和韵","author":"韩淲","text":"水南何事兴偏浓。\n花草小园中。\n山气静分馀霭，泉声幽转流淙。\n午桥坐上英豪客，今昔为谁容。\n不是倚楼人在，登临无复携筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 赵倅约玉楼溪小集，不及往，因寄一曲","author":"韩淲","text":"一番风月已平分。\n留得玉溪云。\n蔼蔼宾僚如故，东楼北海清尊。\n荷香凉透，柳阴深锁，翠袂珠裙。\n□到九重城里，才华好觐吾君。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 述旧曲","author":"韩淲","text":"霓裳霞佩淡丰容。\n云冷露华浓。\n唤起石丁归去，冥冥仙仗崆峒。\n人间秋老花饶笑，清映小帘栊。\n记取五城深处，凤箫吹下天风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 戏赠郑干","author":"韩淲","text":"扁舟撑月转江湖。\n烟水湛金铺。\n篷底晓凉歌罢，肌肤冰雪初扶。\n诗人自是风尘表，佳处句能摹。\n属玉一双飞去，荷花香动菰蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 次韵昌甫见寄","author":"韩淲","text":"谁翻新曲玉溪滨。\n何日得为邻。\n醉里行歌相答，步随泉石松云。\n如今又是梅时候，只有眼中人。\n魂断幽香孤影，花前闲整衣巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 和吴子似","author":"韩淲","text":"春浓人静倦游嬉。\n烟雨战棠梨。\n翠径乱红无数，频啼枝上黄鹂。\n小园流水溅溅处，绿遍谢家池。\n怨月恨花滋味，泪痕犹染罗衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 约和卿、敬之持醪为文叔生朝","author":"韩淲","text":"山林钟鼎似无同。\n舒卷有穷通。\n洗出壶中三峡，帝城赢得从容。\n黄流乱注，狂澜既倒，砥柱能东。\n此际诞弥杯酒，宜歌风虎云龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 平江施倅生朝","author":"韩淲","text":"五湖烟水百花洲。\n别乘最风流。\n人道紫枢家世，清时衮衮公侯。\n名园绿水春无价，蜀锦舞缠头。\n眉寿年年今日，宝杯香霭飞浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 梅月圆","author":"韩淲","text":"为兹春酒寿诗翁。\n我辈一尊同。\n香动梅梢圆月，年年先得东风。\n冰溪清浅流环玉，莲幕漫从容。\n但愿人生长久，挥弦目送飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 寄元立","author":"韩淲","text":"熏风两节照稽山。\n三百里湖间。\n镜上谁为贺老，棹船能伴官闲。\n今年寿日，不妨吟啸，还上清班。\n为寄长生新曲，齐眉想见酡颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 赵伊一哥回侍","author":"韩淲","text":"君之竹隐是章泉。\n只要世家传。\n莫道闲诗浪句，风花雪月云烟。\n一杯我醉，百年人事，乾转坤旋。\n直与唤回兴替，羲皇留下遗编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 九日周国正席间赋长短句","author":"韩淲","text":"年年羞插菊花游。\n华发不禁秋。\n此日遨头寻胜，消除万斛清愁。\n湿云凉雨南台上，歌动玉溪流。\n俯仰人间今古，多情破帽飕飕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝中措 次韵","author":"韩淲","text":"池塘春草燕飞飞。\n人醉牡丹时。\n多少姚黄魏紫，搦成腻粉燕支。\n谪仙醉把平章看，晴影度帘迟。\n花外一声鶗鴂，柳边几个黄鹂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]