[{"title":"宿柳池松风亭","author":"李曾伯","text":"轧轧肩舆上剑门，春和身健快于奔。\n风翻红雨摧芳信，山带青烟入烧痕。\n领略物华无好句，破除旅思有清樽。\n高人喜与松风接，莫遣梨花到梦魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿梅下","author":"李曾伯","text":"春事已十一，梅花才两三。\n青烟回野烧，翠霭护晴岚。\n风暖雁将北，日迟人渐南。\n病馀宜缓辔，勿用客程贪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿深桥驿","author":"李曾伯","text":"湘浦才春已著鞭，依稀渐近劝耕天。\n山樱花落红飘雨，野草烧残青入烟。\n云接岭头阴漠漠，泉流涧底响涓涓。\n严关两入知非偶，重扣宝坊占宿缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿新政县登鲜于氏离堆拜颜鲁公遗像公曾赴蓬州作鲜于氏碑","author":"李曾伯","text":"屹屹金城唐砥柱，如何流落向蓬州。\n一时名节犹山重，千古忠魂与水流。\n不待遗文垂纪录，自存生气沮奸谋。\n当时谁挽浯溪水，为洗离堆一段愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚宿大塘市","author":"李曾伯","text":"仆仆征鞍日向西，相将山色界湘漓。\n农多火种春犹烧，客每露行朝未炊。\n燕傍人家犹细认，马行官道似曾知。\n眼前风物纪无尽，剩费吟鞭几首诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望富池卷雪楼作","author":"李曾伯","text":"忠贯羲娥勇冠军，虎臣勋烈在三分。\n江东父老犹王我，天下英雄有使君。\n万顷怒涛翻白雪，一楼晴霭插红云。\n我来多谢神鸦力，风送牙樯意许勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淡沧陈校勘以诗稿求序答之 其一","author":"李曾伯","text":"挺秀古灵基，来为学子师。\n壮心存远业，馀力付新诗。\n阔步云霄了，细吟风月宜。\n老来无软语，敢以此相期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淡沧陈校勘以诗稿求序答之 其二","author":"李曾伯","text":"先生杖屦所，童子钓游曾。\n遗我奇哉作，非吾耄矣能。\n柳凋怀故老，梅小类新朋。\n唤醒黄粱梦，书帏二尺灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮西幕自皂口入颍道间作","author":"李曾伯","text":"竟日百馀里，相逢三数家。\n平岗尽茅苇，沃壤旧桑麻。\n短树巢归燕，荒城宿乱鸦。\n兴亡谁与问，马首夕阳斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮淝忆幼度","author":"李曾伯","text":"世未闻风鹤，香囊一少年。\n秦非无敌者，晋固有人焉。\n社稷一枰上，山河孤注然。\n江东正朔在，或者诿诸天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"累日脾疾自歌","author":"李曾伯","text":"壮年筋力惯驱驰，堪叹新来数问医。\n生老病催无怪者，寸关亦可自知之。\n养痾抗疏吾谋是，论證投方某剂宜。\n识破幻躯天赋命，儿曹昵昵复何疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"维扬再赠林相士用前韵","author":"李曾伯","text":"三数年来已倦游，祗缘心迹不相谋。\n深知我类虞翻相，莫怪人惊雍齿侯。\n江国旧怀诗一解，吴乡新思酒双投。\n一番公案重拈出，挑却行包归去休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄州上巳和王子方雪堂韵","author":"李曾伯","text":"五年安出处，斯道系污隆。\n血指笑馀子，头颅老此公。\n屋梁悬落月，花卉带香风。\n生气镇长在，大江流不穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"傅山父携示曾玉堂和余韵答之","author":"李曾伯","text":"谁传新语到边州，来自銮坡最紧头。\n句法自成台阁样，交盟犹为友朋谋。\n忆征西府劳清梦，望上东门想贵游。\n何似天风轻借助，放教归老钓鱼舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"善权奇观","author":"李曾伯","text":"粤从融结此山川，便作人间小洞天。\n香火丛林千古盛，神仙窟宅自今传。\n品分三洞中犹宇，脉贯两岩下出泉。\n我自有缘聊乞取，万松阴里一牛眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曾总干以乃尊侍郎二诗见示和韵 其一","author":"李曾伯","text":"别公知阅几桑阴，玉笋山中旧隐寻。\n郾暮联镳来自旧，泾舟共楫继由今。\n一门翁季芝兰味，四海弟兄金石心。\n塞上西风渐萧瑟，书来毋惜寄规箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曾总干以乃尊侍郎二诗见示和韵 其二","author":"李曾伯","text":"畴昔风云共壮游，笑吴夏口蜀江油。\n我犹乘险凛孤注，君早得闲先几筹。\n目底阿蒙元龌龊，膝间文度尽风流。\n个中妙理谁能会，且向平原唤督邮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游千山观","author":"李曾伯","text":"自重来岭峤，岂暇访湖山。\n缇骑行边了，戎旗护戍閒。\n相看群玉外，一笑六郎间。\n回首西风静，何愁老汉关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游张公祠 其二","author":"李曾伯","text":"十年重过石桥行，松下清流载濯缨。\n洞隔烟霞知地远，坛连仙佛信天成。\n人如云意俱闲适，山带霜容似瘦生。\n步出亭皋便归去，它时林壑又寒盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游张公祠 其一","author":"李曾伯","text":"坤灵阑迹汉何时，木石深山圣得知。\n大块凿开真境秘，太虚蕴出众峰奇。\n攀萝揽秀俯可即，秉烛穷幽远莫窥。\n盍遣神龙谨封护，勿容俗子亦游嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琼筦顾守示和愚溪诗用韵饯之","author":"李曾伯","text":"鲸浪中间一岛居，往时千虑笑狂愚。\n伏波方略今堪拟，渤海声名断与俱。\n小丑当从而靡矣，吾民其庶有瘳乎。\n双旌整顿双泉了，归佐清朝泽广区。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登尘表","author":"李曾伯","text":"领略东风一倚阑，凭高便觉小尘寰。\n目穷千古关河外，身在半空烟霭间。\n二水护城青映带，四山连野翠回环。\n英雄易老愁无极，境是人非鹤自还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登江陵沙市楚楼","author":"李曾伯","text":"徙倚阑干日未斜，四围不著一山遮。\n浪花滚滚翻春雪，烟树霏霏夹暮霞。\n壮丽中居荆楚会，风流元向蜀吴誇。\n楼头恰称元龙卧，切勿轻嗤作酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登西楼题柱","author":"李曾伯","text":"分弓来戍岭南州，勋镜尘生雪满头。\n愿进愚言宜简易，颇哀老子得遨游。\n青山落处钟闻寺，白鹭明边人倚楼。\n衙散吏归冰样静，一庭落叶和晴鸠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登妙高台","author":"李曾伯","text":"占得湘中地最高，山川端欲助人豪。\n萍蓬江海通吴会，兰芷汀洲带楚骚。\n人住翠微藏夕霭，水连碧落见秋毫。\n阑干立尽家何许，徒赋归心折大刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登岘山用刘清叔韵","author":"李曾伯","text":"向来碑在所，今见下牛羊。\n魂逐江山老，名流史传香。\n吴谋千载伟，晋事一丘荒。\n不用凭高看，中原尚鹿场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登定王台 其二","author":"李曾伯","text":"羽旄钟鼓旧曾游，沟叶宫花迹尚留。\n耆老遗开秦雍土，登临伟观楚湘州。\n月明故国存千祀，木落空山又一秋。\n极目长天诗不尽，西风吹雁使人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登定王台 其一","author":"李曾伯","text":"汉恩列土育如春，留得芳名远到今。\n几换人民此城郭，四围阛阓有山林。\n见长安日存吾敬，望大行云契彼心。\n忠孝永贻千载后，绝胜易水筑黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登果州金泉山和韵","author":"李曾伯","text":"故迹存栖鹤，高风扫镜鸾。\n烟霞扃地邃，冰雪照人寒。\n妙句挥浓墨，仙颜焕渥丹。\n虽云归棹晚，犹及附飞翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登河山万里楼","author":"李曾伯","text":"收揽河山入此楼，几年鼢冒古荆州。\n目穷夕照西沉队，心到寒江东尽头。\n历历雄图史南北，纷纷遗恨晋春秋。\n酒边感慨凭阑久，衰柳行间数白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登郢州白雪楼","author":"李曾伯","text":"野迥乾坤阔，楼高岁月深。\n江山不今古，人物几登临。\n云影埋荆树，风声快楚襟。\n何须唤商女，白雪想遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登逍遥楼和方孚若韵","author":"李曾伯","text":"尧山举目见于墙，群玉森森拱巨梁。\n一幅画屏罗伟观，两诗银笔冠当场。\n沙平鹭立秋无尽，月冷乌啼夜未央。\n有客凭阑共清话，逍遥何异白云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登阆州锦屏","author":"李曾伯","text":"久识屏山面，今朝得胜游。\n桥梁横古渡，树影倒中流。\n风定春樯度，烟轻晚市收。\n凭栏谁领解，一鹭点沙洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登湘南楼和方孚若韵","author":"李曾伯","text":"天教管领众山来，笋立平章翠作堆。\n上马休怜翁矍铄，酌罍聊赋彼崔嵬。\n楼高苍桂奇观列，人对黄花逸兴催。\n公退呼儿同徙倚，卷舒风月等浮埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋庐山","author":"李曾伯","text":"地据九江汇，天教五老看。\n孤标横碧落，百里见青峦。\n星斗光堪摘，烟霞秀可餐。\n何时谢人事，膏秣以从盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋家山夕秀 其二","author":"李曾伯","text":"小亭八尺石为台，占绿围中作翠堆。\n一片闲云难画去，四时野色入诗来。\n气凌月观身曾到，梦托云根手自栽。\n更出城楼一头地，夕阴含雨肯低徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"跋衡山曾尉持示秀溪翰墨","author":"李曾伯","text":"故人木已拱，妙墨尚春温。\n三复家庭语，一如樽酒论。\n竹林毋负籍，兰砌要追元。\n宝此犹圭璧，流芳在后昆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道间见梅","author":"李曾伯","text":"虚檐索笑几逡巡，不得春风不肯春。\n忽睹冰肌傍官道，相逢霜鬓在征尘。\n怜渠孤迥犹寒畯，慰我漂摇类故人。\n犹赖东君不捐弃，枝无南北一番新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道间纪事","author":"李曾伯","text":"渐远零陵道，前瞻驿尚赊。\n路傍多古木，村外少人家。\n碍眼云遮岫，薄情风落花。\n堪怜艳阳月，汩汩走尘沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道间怀益昌总所海棠","author":"李曾伯","text":"点点红妆缀绿枝，睡犹未足已相宜。\n欠呼杜老供吟笔，仅约杨妃倒酒卮。\n数日以来应烂漫，一风之后想离披。\n凭谁警戒司花女，密遣轻阴谨护持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道间苦热","author":"李曾伯","text":"火伞漾中流，炎风撼叶舟。\n热几堪炙手，矮莫可抬头。\n昼困杯为却，宵蚊扇不休。\n清凉一榻地，得此足优游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"禁烟日登嵯峨阁和方孚若韵","author":"李曾伯","text":"漠漠风烟著野棠，一春多恨雨浪浪。\n古榕阴里作寒食，芳草城头过艳阳。\n不断山光通百粤，无边春思渺三湘。\n伊祁不放花飞尽，露湿蔷薇几阵香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"禁烟前一日招幕属小集林提干有诗和韵","author":"李曾伯","text":"草草登楼适，英流迈昔贤。\n诗篇长庆集，人物永和年。\n访古宜联社，伤春又禁烟。\n青帘家酒贱，剩饮莫论钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简项仲宗游亭皋","author":"李曾伯","text":"试从沙渚入荆城，十里金堤掌样平。\n晓露香留红芰湿，午风清逐白蘋生。\n柳边系马频酤酒，沙际呼鱼旋作羹。\n所欠直惟佳客耳，明朝能辍暇偕行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蜀江和周炳仲百丈韵","author":"李曾伯","text":"欲知峡路打滩涡，千尺苍筠用力多。\n进退不烦篙影动，东西惟听柁师呵。\n命垂一缕惟天耳，力挽千钧如水何。\n争似钱塘江上路，夜深柔橹听吴歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霁后登水云阁凭栏偶成","author":"李曾伯","text":"雨过云烟幕，天成水墨屏。\n江添半篙绿，山失数峰青。\n某寺藏松坞，谁舟系柳汀。\n杜鹃声正急，那对夕阳听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题二水光华驿","author":"李曾伯","text":"历历湖南道，骎骎岭右州。\n感时僧解夏，触事客惊秋。\n雨洗流金虐，风生落木愁。\n一萍如寄耳，往梦付悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题千山观","author":"李曾伯","text":"玉笋环星拱，青螺带雾披。\n山为天下胜，境占岭南奇。\n援笔难穷者，凭阑尽有之。\n不因身世累，筑室老于斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题双庙镇峡楼","author":"李曾伯","text":"峰巍鳌柱疑娲立，地峻龙门自禹开。\n山色半昏朝欲雨，滩声不蛰夜何雷。\n云屏烟障相迎送，沙鸟风樯几去来。\n徙倚阑干不知倦，一诗弹压愧非材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题孔明白帝二祠","author":"李曾伯","text":"安刘事固异危刘，相去英雄二百秋。\n火德方中徒僣帝，星营何陨遽亡侯。\n草庐龙去存吴恨，陛戟蛙狂遗汉羞。\n成败不同俱庙食，宁非霸业结偏州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汉中嶓冢观高祖庙试剑石","author":"李曾伯","text":"手袖干将射斗牛，当时天意在兴刘。\n不劳游刃烹秦鹿，直以馀锋剪楚猴。\n将相岂烦加越砥，宽仁自足淬吴钩。\n断蛇断石都休问，遗恨平城雨雪羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题怀远楼","author":"李曾伯","text":"心远目难尽，境须诗与论。\n风樯谁客艇，烟树某家村。\n野草春千古，江天月一痕。\n旧时方册事，一笑付方樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题林路钤诗轴","author":"李曾伯","text":"过眼多陈迹，论心只旧时。\n艰难几年事，感慨数公诗。\n觅句新尤健，谈兵老不衰。\n效颦聊尔耳，莫说姓名谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题剑门寺贺费伯矩韵","author":"李曾伯","text":"不见台城事，君毋说苦空。\n佛随千劫尽，人与万山雄。\n吊古春酤绿，谈兵夜烛红。\n终宵皎无寐，万壑响松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题宣公祠","author":"李曾伯","text":"凛凛清规百世师，功名仅见奉天时。\n忠谋任起奸谀忌，感涕宁无士卒思。\n落日桑榆存旧迹，西风芦苇护荒祠。\n忠南流落何遗恨，留得良方遗后医。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题荆门蒙泉","author":"李曾伯","text":"向来亭上醉流杯，千朵莲花一树梅。\n金炬依然霜不管，琼琚犹待雪相催。\n凌波仙子欣无恙，姑射真人唤不来。\n风景则同怀抱异，倚栏欲去更徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题越观和方孚若韵","author":"李曾伯","text":"檐阴寂寂转西迟，检点春工倍费诗。\n烟树郁苍何处洞，雨苔斑驳旧人碑。\n清泉白石仙游地，芳草绿阴晴昼时。\n目送水云谁领会，沙鸥点点柳丝丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题黎榷院诗轴","author":"李曾伯","text":"别二十三年，来呼溯峡船。\n昨游春梦尔，故友晓星然。\n廉誉盈诗卷，忠谋在奏编。\n阿蒙顽自若，应笑老穷边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题衡阳临湘驿","author":"李曾伯","text":"暑涂挈挈问持装，过眼蘋风倏转商。\n岂为南鱼来丙穴，且先北雁过衡阳。\n童乌已矣肠空断，老马疲哉汗欲僵。\n身大块中犹大疟，铁心禁得几炎凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题醴泉驿 其二","author":"李曾伯","text":"路遥须到日，官满有归时。\n一点终身痛，中途孺子悲。\n老难堪此境，咎必有其基。\n扶惫随缘去，空馀泪雨垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题醴泉驿 其一","author":"李曾伯","text":"远役三才二，忧端万有斯。\n君恩知欲报，子难痛何追。\n我马方瘏矣，秋阳更暴之。\n愿言行役者，当暑戒驱驰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"衡阳道间即事","author":"李曾伯","text":"衡山九十里衡阳，风物熙然冠楚乡。\n古木千章屯翠幄，小溪数曲卧虹梁。\n雨蔬旋摘充庖美，社酒新篘透瓮香。\n村舍春长无一事，门前车马任渠忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠杨户曹","author":"李曾伯","text":"壮年游戏宝峰傍，梦觉黄粱鬓尽霜。\n旧俗几家罹变故，远人千里叹清扬。\n酆南松槚烦君访，剑北榛芜动客伤。\n赖有柳州诗唤起，莫言安顿便思乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠郑通庵","author":"李曾伯","text":"与子前言戏，惊人昨梦然。\n办心求学道，绝口戒谈天。\n适我烟霞外，任渠牛斗边。\n明年茅屋下，共玩养生篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠相士陈林过金陵","author":"李曾伯","text":"疲于吏事老于兵，不特头方命亦屯。\n成败固非予逆睹，穷通何用子前陈。\n登朝不是鸢肩相，守塞尤惭燕颔人。\n见说江东多福德，亟须洗眼望堂麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠闻人松庵","author":"李曾伯","text":"官术犹能手不龟，子之为术亦如之。\n价增三倍玉麟顾，言订千金木石诗。\n鸥鹭寻盟吾自计，鴳鹏付分尔何为。\n异时蓬荜来相验，直说太平卿相谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":64074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]