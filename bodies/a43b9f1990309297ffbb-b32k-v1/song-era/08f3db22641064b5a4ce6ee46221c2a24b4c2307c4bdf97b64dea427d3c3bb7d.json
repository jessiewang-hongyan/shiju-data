[{"title":"过明田寺会杨李二生于碧玉三首 其三","author":"胡寅","text":"浆酒香浮桂与椒，此间谁惜马蹄遥。\n爱君涧壑沉吟树，笑我江湖濩落瓢。\n前日好风犹泛座，只今零露已盈条。\n东山妓女诚何算，颇羡周郎得小桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过明田寺会杨李二生于碧玉三首 其二","author":"胡寅","text":"骚人空自怨兰椒，更遣招辞叹远遥。\n争似夷齐饱薇蕨，每同嵇阮醉觚瓢。\n清歌窈眇成珠贯，仙步虚徐按玉条。\n最忆向来携手处，云平溪树水平桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过明田寺会杨李二生于碧玉三首 其一","author":"胡寅","text":"已宅连延紫盖椒，寻山依旧不辞遥。\n借床未暇桑三宿，解饭还须水一瓢。\n风外野云俱淡荡，雨馀秋气亦萧条。\n故人适有登高约，又拄枯藤过野桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过益阳","author":"胡寅","text":"侨寄家连楚，归游岳背衡。\n川原渐旧国，鲑菜惬平生。\n淮海风难定，江湖浪岂平。\n春融一杯酒，下马且同倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过疏山题一览亭梁溪公所书也二首 其二","author":"胡寅","text":"林梢斜月堕金盆，接影苍茫白雾翻。\n欲倚小栏收遁景，试凭长啸卷遐昏。\n寒山濯濯空堆皱，野水瀰瀰不待源。\n莫道此亭观览富，未如宾日上天门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过疏山题一览亭梁溪公所书也二首 其一","author":"胡寅","text":"手遮西日到疏山，忽得昏鸦敛翅间。\n未暇拈香参佛祖，且须襆被扣禅关。\n月林散影参差静，风磬传音窈渺閒。\n拟买一廛通水竹，杖藜他日寄疏顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过鼎澧","author":"胡寅","text":"沅澧春风拂马鞭，客愁何事四无边。\n于今榛棘三州地，自昔坻京百姓天。\n安得鸣鸡连比屋，空馀归雁落平川。\n一觞莫酹怀沙魄，且对桃红李白传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初归范伯达弟相会夜归有成","author":"胡寅","text":"乱后风尘稍破昏，归来骨肉喜全存。\n饮君竹叶醉不惜，映我梅花香正繁。\n问学据今宜了了，唱酬从此定源源。\n夜寒踏碎滩头浪，为笃平生友弟恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初至青湘闻安仁帅司为曹成所袭四首 其一","author":"胡寅","text":"风急滩声乱，云红雪意酣。\n空庭初霰集，寒砚忽冰涵。\n天造推移密，人情冷煖谙。\n江头聊问信，春到一枝南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事","author":"胡寅","text":"梧叶经冬不识霜，杞茅蒙润已宜汤。\n夜除爱日太和境，衣袂轻风单薄装。\n盘绾翠丝春意近，盏浮清艳腊容光。\n东君又试芳菲手，行乐宁嗟鬓转苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴守生朝","author":"胡寅","text":"梅信初传冬未深，高门熊梦庆相寻。\n三朝耆旧人皆仰，一德纯全众所钦。\n难老椿龄方演迤，后凋松色正阴森。\n愿公常记茱萸酿，每岁兹辰细细斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴守祈雨有应","author":"胡寅","text":"延陵宿望冠三吴，又见熙朝老大夫。\n善政旧闻风偃草，清规今信浦还珠。\n山川每应精神祷，禾稼全凭润泽苏。\n可但邦人歌五裤，也知还客慰焦枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李簿携具用前韵和之","author":"胡寅","text":"春禽遭冻息交交，不及风筝迭递敲。\n睡起依然开白屋，客来仍是俯青郊。\n方兄无势宁能热，穷鬼多羞祗自苞。\n载酒刲羊烦厚意，当年莘野尚烹庖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨尉见招朱推单令与焉月色甚佳","author":"胡寅","text":"南郭无缘到北城，却因招唤得同行。\n四郊禾黍未全熟，满眼云山何限情。\n幸有好风能洒袂，况无閒事称挥觥。\n篮舆欲去留还住，爱此月凉河汉明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迓黄守再来二首 其二","author":"胡寅","text":"柴扉虽设悄无邻，听说君来气又振。\n鸥鹭点开愁意思，诗书吟起病精神。\n也知憔悴嫌杯酒，可尚谈谐对席珍。\n旌旆悠悠将入眼，争除三径待朱轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迓黄守再来二首 其一","author":"胡寅","text":"旧治重临宠渥新，圣朝因任慰斯民。\n芾棠不拜阴如幄，骑竹争迎气似春。\n金重百斤兼赐爵，车高一丈更施茵。\n能名籍甚宜蒙此，颍水卢溪共演深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周尉丹砂次其韵","author":"胡寅","text":"日镊苍浪鬓，还童意未赊。\n易衰如下阪，难熟似烝砂。\n不信三峰妄，曾闻九转誇。\n刀圭何太少，薏苡旧盈车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和上封洪辩用明察院韵","author":"胡寅","text":"绣衣御史有前闻，衲子禅师亦好文。\n出禀圣谟苏瘵俗，坐持诗律战魔军。\n访寻水石閒招隐，际会风云偶策勋。\n喧寂两忘归一致，此心何处不超群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仁仲","author":"胡寅","text":"岩壑风烟可写忧，千竿筠玉净脩脩。\n弟兄无故兼三乐，杯斝相欢第一秋。\n岂似墨卿夸楚泽，最宜从事到青州。\n胸中固自春风在，小试安能学太丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仁仲至荆门","author":"胡寅","text":"虞帝当年辟四门，三苗那更蠢迷昏。\n茫茫旧楚祗芳草，处处朱楼空断垣。\n不愿耦耕招素隐，要看良耜接深村。\n韩公守戒谁能用，虎豹难凭折柳樊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仁仲过五溪","author":"胡寅","text":"沅水千年非旧波，英风元自振关河。\n本怀国士知心早，岂念柽函挟恨多。\n龟固有神宁豫罔，鸿虽高举畏虞罗。\n椒兰从古能如此，何有沉湘作九歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仁仲治圃三首 其三","author":"胡寅","text":"愦瞀年来药渐须，喜君犹自手抄书。\n尘冠固合悬圬壁，羽扇何当出草庐。\n胜景但逢诗发遣，壮怀聊用酒驱除。\n寄身扰扰胶胶者，奇货从来不可居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仁仲治圃三首 其二","author":"胡寅","text":"不遣身心同槁灰，化工随手自量裁。\n一栏仙蘤端倪露，九畹崇兰次第栽。\n生意可观那画得，暗香难觅偶吹来。\n柴门漫说何曾闭，俗驾经过也未猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仁仲治圃三首 其一","author":"胡寅","text":"扶持嘉树起条枚，未觉风前齿发颓。\n深凿坐邀千涧水，纵观如步九层台。\n云间秀巘浓还淡，案上陈编阖又开。\n莫似昔贤誇独乐，与人同处首应回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和毛生瑞香","author":"胡寅","text":"久雨妨园涉，奇芬待客吹。\n今朝搴翠幄，晴日丽繁枝。\n一一花相簇，翩翩蝶未知。\n薰篝蒙紫锦，香过每轻披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和仲固","author":"胡寅","text":"多谢春风吹雨晴，出遨今日计初程。\n去随碧涧䙰褷上，归与閒云澹沱行。\n顺理以观皆有趣，会心之乐最难名。\n山间桃柳宁知此，敛笑舒颦亦自情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和任大夫赠别","author":"胡寅","text":"未老先衰负疾忧，敢贪荣禄尚为州。\n已惭骚客能招隐，更愧疲民欲借留。\n斤斧且应存夜气，江湖那得献辰猷。\n新诗满把珠玑重，归艇全胜载石舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孙奇父","author":"胡寅","text":"揽辔丹青久更恬，挂冠高处静尤厌。\n情田不是年年熟，世味安能种种廉。\n虎鼠乘时争用舍，鸢鱼适意自飞潜。\n也应及取仙舟下，同向南山看水帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和朱成伯 其二","author":"胡寅","text":"澜翻笔墨浩难收，妙处端能浣客愁。\n落笔千章轻万户，思君一日胜三秋。\n持身贵比琥璜爵，得句精如狐白裘。\n应有二南风骨在，令人辗转更优悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和朱成伯 其一","author":"胡寅","text":"劫劫官身未许收，江山到处发诗愁。\n弃繻西上今将老，襆被东来又欲秋。\n安得紫箫横鹤背，漫从清钓觅羊裘。\n黄梅正作冥冥雨，每咏新篇兴转悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和次山赠别","author":"胡寅","text":"牧养惟闻政失中，茇棠深愧召南风。\n却归旧隐三家市，回望耆儒一亩宫。\n蕙帐我今寻怨鹤，蘋洲君复送惊鸿。\n别怀不得同杯酒，西柄居然挹大东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和汝霖三首 其三","author":"胡寅","text":"桃李无言春事深，便看园树欲交阴。\n永怀北固吹长笛，一醉春风典破衾。\n金羽喜从幽谷出，锦鳞贪引翠竿沉。\n好传消息睎曾点，莫把平生问李寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和汝霖三首 其二","author":"胡寅","text":"圣门功业海同深，大禹犹曾惜寸阴。\n知有诗书消永日，不将狐貉愧寒衾。\n定心应已观川逝，阔步何须叹陆沉。\n闻道北山兰正好，果堪纫佩即幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和汝霖三首 其一","author":"胡寅","text":"客思如春日日深，莫令鶗鴂损芳阴。\n忽逢佳士能倾盖，那用高眠有抱衾。\n陌上正歌归缓缓，尊前聊酌夜沉沉。\n君诗也得池塘梦，沈谢风流尚可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和邢子友","author":"胡寅","text":"可怜牒讼汩华年，赖有神交肯惠然。\n万石同登高柳外，一尊相属晚花前。\n浮云空解遮人境，止水何曾染世缘。\n安得小舟衔尾去，风樯激箭不须鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和坚伯碧泉留题","author":"胡寅","text":"欲濯冠缨尘垢侵，梁亭横占一源深。\n碧纱演漾苍鱼色，黛白因依翠木阴。\n疏沼岂惟三凤饮，买山初听一龙吟。\n请君莫惜来游屡，耆旧风流尚可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李生九日二首 其二","author":"胡寅","text":"骚客悲秋心易催，主人醪醴正时哉。\n登高何必仙家术，酬节聊凭笑口开。\n凤岭胜游诗自好，龙山高宴首空回。\n独馀眇莽梁园念，想见黄花满吹台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李生九日二首 其一","author":"胡寅","text":"节物休惊木叶催，相逢佳节兴悠哉。\n尊如北海聊同醉，菊傍东篱也自开。\n乌帽任教吹脱落，紫萸仍得看徘徊。\n诸君合有登高赋，为继当年戏马台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李靖","author":"胡寅","text":"三间茅屋陋无人，聊著投荒罪垢身。\n此地相逢应有数，他年重见复何因。\n雅骚我岂堪嘉赠，逸足君宜据要津。\n更把一尊当雨霁，坐看冰鉴拓秋旻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和杨秀才二首 其二","author":"胡寅","text":"林下何所乐，游心书史中。\n时窥言语外，默想圣贤同。\n沂水有馀咏，舞雩多好风。\n区区守一介，未肯易三公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和杨秀才二首 其一","author":"胡寅","text":"林下何所乐，放怀天地中。\n青山供客眼，明月与君同。\n静听蕉窗雨，閒披芰沼风。\n未忘蒿目意，时一梦周公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陈生三首 其三","author":"胡寅","text":"挂却衣冠把钓纶，那知藏拙未全真。\n馀生意态无相顾，未死工夫有自新。\n弦绝谁传流水曲，瑟希曾对舞雩春。\n晚交况得陈丘子，不但波澜子建亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陈生三首 其二","author":"胡寅","text":"车尘马足两纷纶，谈叟浑如谷口真。\n闹里光阴渠不驻，静中滋味我尝新。\n高眠展转三竿日，熟饮频烦一瓮春。\n请看夏畦劳瘁者，岁寒当与子相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陈生三首 其一","author":"胡寅","text":"此道存亡仁不仁，遗编所载岂其真。\n若非象外冥心契，宁向环中得意新。\n玉麈有文堪悟道，锦囊无句不藏春。\n箪瓢倘可分留客，更欲闻君一语亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和单令","author":"胡寅","text":"炎州暑令比烝炊，茅屋深更未掩扉。\n倦鹊绕林飞又上，流萤照水乱还稀。\n寡尤正尔三缄口，新浴又思一振衣。\n独怯诗坛把麾将，欲摩坚垒费攻围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和单令","author":"胡寅","text":"曾步雩风咏晚春，肯教清镜受纤尘。\n诗书渐与心为一，文字终惭笔有神。\n弈局不争先后手，醉乡常值圣贤人。\n得时花卉千千状，须倩能诗为写真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和单令自龙山迎月而归","author":"胡寅","text":"招提炉上宝香氲，问信浮屠作祖人。\n想得妙心同水镜，故应归路见冰轮。\n清辉万里无穷雪，净观千山不隔尘。\n欲识新诗惟累句，颇惭曹植与君亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和单令春日","author":"胡寅","text":"新历自披展，故交谁与欢。\n颜容羞把镜，菘韭强登盘。\n袖手笼东老，侵肌料峭寒。\n大钧方播物，吾道岂艰难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和单令除夕二首 其二","author":"胡寅","text":"坐阅流年同掷梭，未曾闻道合如何。\n击壶安用铁如意，爱酒犹须金叵罗。\n重读豳诗赓节物，还师鲁圣对乡傩。\n东风渐次开桃李，之子宁能不我过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和单令除夕二首 其一","author":"胡寅","text":"又闻幽谷有莺迁，况复山晴花向然。\n泥犊戒耕呈岁岁，户灵呵鬼换年年。\n茅檐剩有三竿日，秫地曾无二顷田。\n且买东江百花酒，与君同棹十分船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和单普二首 其二","author":"胡寅","text":"弃捐孤陋与谁邻，插棘诛茅漫隐沦。\n乱思诗书随手揭，慰怀风月逐时新。\n惭无用舍行藏道，有愧东西南北人。\n久矣笔端尘土暗，因君聊复拟心神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和单普二首 其一","author":"胡寅","text":"能向词江挹彼清，爱君诗句早知名。\n百家悬镜知妍丑，一字提衡有重轻。\n画话岂淹三友益，简才方廓四聪明。\n肯临蔀屋相辉映，自愧常谈只老生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏岁除","author":"胡寅","text":"新年节物推排有，旧岁光阴扫荡无。\n白发任教装鬓换，青春元自与心符。\n茹芝休慕商山老，舍瑟当睎鲁国儒。\n三益况逢天下士，夷途从此得归愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏视穫三首 其三","author":"胡寅","text":"天赐丰年岂不时，闵公荒度效徂岐。\n经丘烈日能焦扇，独夜秋风已泛帷。\n岂愧石兄推竹弟，聊斟杜酒破张梨。\n过门若有樊迟问，老子于中正遍知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏视穫三首 其二","author":"胡寅","text":"莫嗤公子务农时，后稷生民亦嶷岐。\n稻割黄金镰似月，汗挥白雨袂连帷。\n愿趋座上鸡和黍，未种胸中枣与梨。\n此乐若嫌儿辈觉，后知何以赖先知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏视穫三首 其一","author":"胡寅","text":"閒客何如乐圣时，欣闻威凤再鸣岐。\n且将诗笔耕尧壤，宁记书囊集汉帷。\n日错碎金归野菊，风欺危绿战棠梨。\n殷勤云将丰年问，无奈鸿蒙谢不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏游双峰二首 其二","author":"胡寅","text":"山拥交加翠，风传琐碎音。\n想闻尊有酒，待得月穿林。\n真乐难陪席，芜词漫写心。\n要须专一壑，散策每相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和叔夏游双峰二首 其一","author":"胡寅","text":"有佛留深境，无僧阐大音。\n殷勤五字句，摇荡众香林。\n自适登临兴，谁窥隐显心。\n从来多暇日，悔不早追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和周尉立春二首 其二","author":"胡寅","text":"新年仍复得诗交，和气排门不待敲。\n藏谷寒冰犹北陆，应时甘雨背西郊。\n松筠挺挺浮烟色，桃杏纷纷拆绣苞。\n准拟寻春多酒肆，芳膻何必费良庖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和周尉立春二首 其一","author":"胡寅","text":"筮易欣逢天地交，送残寒晷石光敲。\n化工造物初施手，天仗迎春已在郊。\n一饭及辰堆细菜，千花从此放香苞。\n欲赓妙句无馀味，久矣庖人不治庖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和周尉游简园","author":"胡寅","text":"敝屣稀行故不穿，荒陬何处赏芳妍。\n诗人邂逅能乘兴，野客勤劬便肆筵。\n满壁画图俱俨若，一川风物更萧然。\n攀翻百树梨花雪，醉拟春风二月天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和奇父二首 其二","author":"胡寅","text":"丈室虚明了不扃，寸田芜废正须耕。\n容颜半叹年华改，品目犹烦月旦评。\n洗砺子荆真可慕，中庸伯始竟何成。\n且将礼节规儿辈，不止文书记姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和奇父二首 其一","author":"胡寅","text":"示病维摩体暂癯，习閒中散礼诚疏。\n已知道义能相与，故使情交得自如。\n前日又欣挥麈尾，何时重见命巾车。\n栖迟甘就衡门下，不见龙章卧草庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和奇父再寄首韵奇父易用","author":"胡寅","text":"酒影何时有画蛇，灯光不必罩红纱。\n幸能真率时添菜，未忆柔纤笑捧茶。\n世路风波常起伏，醉乡田地绝隆洼。\n爱公诗句如清瑟，自比流鱼感瓠巴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":42145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]