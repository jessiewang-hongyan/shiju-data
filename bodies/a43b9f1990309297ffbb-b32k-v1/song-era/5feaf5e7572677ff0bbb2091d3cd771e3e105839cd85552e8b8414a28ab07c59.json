[{"title":"足疾","author":"陆游","text":"足疾惟妨拜，登临故自如。\n深知造物意，遣遂此心初。\n东坞闲看竹，西溪独钓鱼。\n暮归犹未倦，把卷绕前除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"身世","author":"陆游","text":"身世飘然似断云，时人误许与斯文。\n旋偿碑债动千里，强理诗情无一分。\n子美旧悲残酒炙，幼安今老白襦裙。\n馀生自喜浑无事，清夜铜炉炷宝熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"身世","author":"陆游","text":"身世浮沉等一沤，卧看校尉例封侯。\n青灯微火药铛夜，淡月凄风衣杵秋。\n醉里不辞嘲兀兀，吟边时得寄悠悠。\n即今老眼无开处，又向城南倚寺楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辛丑十月诸公馈酒偶及百榼戏题长句","author":"陆游","text":"喜事诸公尚见存，尺书时到爵罗门。\n已邀风月成三友，聊对湖山倒百尊。\n醉墨淋漓动高壁，狂歌悲壮落前村。\n悠然睡起西窗黑，一点青灯又断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辛酉冬至","author":"陆游","text":"今日日南至，吾门方寂然。\n家贫轻过节，身老怯增年。\n毕祭皆扶拜，分盘独早眠。\n惟应探春梦，已绕镜湖边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"近村","author":"陆游","text":"去去柴车十里中，竹林密处路才通。\n渐闻水硙知村近，遥望禾囷喜岁丰。\n渔艇往来春浪碧，人家高下夕阳红。\n百钱又向旗亭醉，自笑吾生亦未穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"近村暮归","author":"陆游","text":"莫笑山翁雪鬓繁，归休幸出上恩宽。\n鲎樽恰受三升酝，龟屋新裁二寸冠。\n僧阁煮茶同淡话，渔舟投钓卜清欢。\n还家欲作诸孙赠，村路累累柿未丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迓使客出郊夜归过市楼","author":"陆游","text":"山川惨澹作秋霖，云物徘徊结夕阴。\n手版向人惭老大，肩舆出郭当登临。\n二年雪濑饶羁思，万里冰河歇壮心。\n却羡喧呼楼上客，隔帘红烛醉更深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还东","author":"陆游","text":"还东寒暑几推移，渐近黄梅细雨时。\n窗下兴阑初掩卷，花前技痒又成诗。\n囊钱不贮还成癖，官事都捐未免痴。\n赖是病躯差胜旧，一杯藜粥且扶衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还县","author":"陆游","text":"霁色清和日已长，纶巾萧散意差强。\n飞飞鸥鹭陂塘绿，郁郁桑麻风露香。\n南陌东村初过社，轻装小队似还乡。\n哦诗忘却登车去，枉是人言作吏忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还家二首 其一","author":"陆游","text":"富贵元须早致身，白头岂复市朝人。\n数声鹎鵊呼残梦，一架酴醾送晚春。\n叠嶂出云明客眼，澄江涨雨濯京尘。\n逢人枉道哦诗瘦，下语今年尚未亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还家二首 其二","author":"陆游","text":"天津桥上醉骑驴，一锦囊诗一束书。\n作客况当多病后，还家已过暮春初。\n泥深村巷人谁顾，草满园畦手自锄。\n不为衰迟思屏迹，此心元向利名疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"进德","author":"陆游","text":"进德工夫在日新，正如更历自知津。\n迷时误认毒为药，定后始知天胜人。\n四壁不妨身落魄，万夫谁敌胆轮囷。\n遗经在椟君毋厌，灯火青荧渐可亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远兴","author":"陆游","text":"莫言人世足悲伤，只为诗情合断肠。\n窗槛雨晴湖滟滟，郊墟烟重月茫茫。\n梅花调苦愁三弄，竹叶香清泥一觞。\n闭户终年嗟局促，不如新雁到衡湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远游","author":"陆游","text":"少年游宦日，肮脏耻沉浮。\n见虎犹攘臂，逢狐肯叩头。\n力行虽自许，早退岂人谋。\n小艇烟波上，飘然得远游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远游","author":"陆游","text":"姓字不须通，从来号放翁。\n月明登暑雪，木落过秋风。\n处处题僧壁，时时卧钓篷。\n始知侯万里，未必是英雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远游","author":"陆游","text":"壮年不作故山归，老去方知浪走非。\n挂日片帆吴赤壁，嘶风疋马蜀青衣。\n交游虽广知心少，香火徒勤愿力微。\n堪笑只今成底事，青灯无恙且相依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远游","author":"陆游","text":"远游行复岁华新，懒学刘郎问大钧。\n一点不蒙稽古力，十分合作卧云身。\n苦寒与酒渐增价，小雨为梅先辟尘。\n拟佩一壶江路去，花边醉堕白纶巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连夕熟睡戏书","author":"陆游","text":"投帻尘机息，捐书困味长。\n早眠犹有日，晚起已无霜。\n蝶入三更枕，龟支八尺床。\n昏昏君莫笑，差胜醉为乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连日大雨门外湖水渺然","author":"陆游","text":"趁朝把笏著乌靴，不似归来买短蓑。\n尚鄙朱公养鱼术，肯为宁戚饭牛歌。\n逢时有命求何益，触事无心得最多。\n乐处却嫌儿辈觉，出门十步即烟波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连日有雪意戏书","author":"陆游","text":"壮岁羁游半九州，即今憔悴老菟裘。\n狂心那复缴鸿鹄，世事已如风马牛。\n雪作未成增惨澹，叶飞欲尽更飕飗。\n聊将袖里平戎事，判断千岩万壑秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连日至梅仙坞及花泾观桃花抵暮乃归二首 其一","author":"陆游","text":"千载桃源信不通，镜湖西坞擅春风。\n舟行十里画屏上，身在西山红雨中。\n俗事挽人常故故，夕阳归棹莫匆匆。\n豪华无复当年乐，烂醉狂歌亦足雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连日作阴颇有雨雪意","author":"陆游","text":"十分历日过八九，徂岁迫人殊可惊。\n霜木萧萧临古道，雪云惨惨冒高城。\n山头噤雀无生意，水面饥鸢有堕声。\n剩压新醅供旨蓄，从今次第问春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连日扶病领客殆不能支枕上怀故山偶成","author":"陆游","text":"已强迂疏假印章，更扶衰病主杯觞。\n功名已判初心负，豪侠都无故态狂。\n静觉此身犹外物，懒思与世永相忘。\n清泉白石生来事，曲几明窗味最长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连日往来湖山间颇乐即席有作","author":"陆游","text":"晚春光景亦佳哉，野老苍颜一笑开。\n莫问此生犹几屐，但知相遇且衔杯。\n偶携儿女祈蚕去，又逐乡邻赛麦回。\n不信年华如转毂，城头君听角声哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连日治圃至山亭又作五字四首 其二","author":"陆游","text":"富贵寻常事，天奚独汝悭。\n十分教懒拙，百倍与清闲。\n放鹤云千顷，钓鱼溪一湾。\n此诗虽信笔，它日不须删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连日治圃至山亭又作五字四首 其一","author":"陆游","text":"薙圃课僮奴，争前不待呼。\n水泉经雨壮，蓁莽得霜枯。\n高树鸣双鹊，清池下两凫。\n暮年惟乐此，馀念一毫无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连日治圃至山亭又作五字四首 其三","author":"陆游","text":"好竹千竿翠，新泉一勺冰。\n残芜衬落日，老木上寒藤。\n细磴攲难过，危栏曲可凭。\n归时忽已暮，点点数渔灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连日治圃至山亭又作五字四首 其四","author":"陆游","text":"门开度略彴，路尽上坡陁。\n农隙闲耕犊，樵归起醉歌。\n青烟舞鸾凤，白石伏鼋鼍。\n剩有筇枝兴，穷冬气已和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连日得雨凉甚有作","author":"陆游","text":"九渊龙起跨苍茫，聊为西州洗亢阳。\n晓看空濛知岁稔，夜闻点滴觉心凉。\n纱幮不下蚊蝇静，焙火微温书画香。\n睡足何须云梦泽，如雷鼻息撼邻墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邻山县道上作","author":"陆游","text":"微雨晴时出驿门，乱莺啼处过江村。\n挽花醉袖沾馀馥，迎日征鞍借小温。\n客路一身真吊影，故园万里欲招魂。\n鬓毛无色心犹壮，藉草悲歌对酒尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邻水延福寺早行","author":"陆游","text":"化蝶方酣枕，闻鸡又著鞭。\n乱山徐吐日，积水远生烟。\n淹泊真衰矣，登临独惘然。\n桃花应笑客，无酒到愁边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邻曲","author":"陆游","text":"浊酒聚邻曲，偶来非宿期。\n拭盘堆连展，洗釜煮黎祁。\n乌㹀将新犊，青桑长嫩枝。\n丰年多乐事，相劝且伸眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邻曲小饮","author":"陆游","text":"早稻喜登场，相呼集野堂。\n迎霜新兔美，近社浊醪香。\n茆屋滴残雨，竹篱围夕阳。\n新丰不须作，真个是吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邻曲相过","author":"陆游","text":"邻曲集山家，相看一笑哗。\n扶行足踸踔，半落齿槎牙。\n农圃乖生理，风霜感岁华。\n老来情话少，更尽此瓯茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月辛酉壬戌连日风雨癸亥早晴","author":"陆游","text":"残雨在檐犹点滴，断云衔日正苍凉。\n清愁偏向暮年觉，少睡不禁秋夜长。\n帘影渐生禽语乐，杵声初动药尘香。\n诸儿作吏俱安否，那得乘风至汝傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中","author":"陆游","text":"闲中高趣傲羲皇，身卧维摩示病床。\n活眼砚凹宜墨色，长毫瓯小聚茶香。\n门无客至惟风月，案有书存但老庄。\n问我东归今几日，坐看庭树六番黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中书事二首 其一","author":"陆游","text":"病过新年逐日添，清愁残醉两厌厌。\n惜花萎去常遮日，待燕归来始下帘。\n堂上清风生玉麈，涧中寒溜注铜蟾。\n一生留滞君休叹，意望天公本自廉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中书事二首 其二","author":"陆游","text":"一亩山园半亩池，流年忽逮挂冠期。\n卖花醉叟剥红桂，种药高僧寄玉芝。\n午枕为儿哦旧句，晚窗留客算残棋。\n登庸策免多新报，老子痴顽总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中书适二首 其一","author":"陆游","text":"棋废机心息，书捐美睡多。\n客来时淡话，酒后亦高歌。\n甚欲江湖去，无如老病何。\n平羌半轮月，依旧照渔蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中乐事二首 其二","author":"陆游","text":"得丧略相当，幽居气味长。\n五穷虽偃蹇，二竖已奔忙。\n出甑桃花软，倾瓢竹叶香。\n语君真富贵，不是傲羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中乐事二首 其一","author":"陆游","text":"转老转迂疏，胸中一物无。\n放言誇酒圣，著论笑钱愚。\n扫地收松粉，全巢买鹤雏。\n登临未应倦，天给短筇扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中戏书三首 其二","author":"陆游","text":"少年拜舞缀庭绅，曾见中天日月新。\n金印终归妄校尉，白头仍是斥仙人。\n修营香火三生愿，收拾风波九死身。\n岂但渔樵与争席，海边沤鸟亦相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中戏书三首 其一","author":"陆游","text":"粝饭从来不愿馀，还山喜遂此心初。\n挽河尽洗弹冠念，闭户闲雠插架书。\n一榼不妨从客饮，数椽也复是吾庐。\n少游细看犹多事，安用人间下泽车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中自咏","author":"陆游","text":"鹤羡清癯鸥羡闲，衡门正在水云间。\n无求尚恨时赊酒，有癖应缘酷爱山。\n细绕坡头行荦确，别分泉脉听淙潺。\n三更不睡看江月，恐有高人夜叩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中自嘲","author":"陆游","text":"镜湖西畔有渔扉，窃比玄英似庶几。\n风月定交殊耐久，烟波得意可忘归。\n曾行万里求微禄，亦伴诸公践骇机。\n试问即今成底事，晨餐依旧北山薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中作","author":"陆游","text":"呼童按摩罢，倚壁欠伸馀。\n棋局可忘老，鸟声能起予。\n扫檐怜罥蝶，投饵出潜鱼。\n向晚明窗下，还来读旧书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中偶咏二首 其二","author":"陆游","text":"举世纷纷名利间，天公偏赋此身闲。\n尘衣濯罢沧浪水，茅舍归来会计山。\n邻舍擎盘分麦饭，野人曳杖叩柴关。\n酒逋诗债何时了，未死何妨且旋还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中偶咏二首 其一","author":"陆游","text":"断编残稿本徒劳，横得虚名亦已叨。\n不识狐书那是博，尚分鹤料敢言高。\n巢山且欲营丹灶，跨海何当看雪涛。\n与世不谐终自许，笑人苦劝学餔糟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中偶题二首 其一","author":"陆游","text":"楚泽巴山岁岁忙，今年睡足向禅房。\n只知闲味如茶永，不放羁愁似草长。\n架上汉书那复看，床头周易亦相忘。\n客来拈起清谈麈，且破西窗半篆香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中偶题二首 其二","author":"陆游","text":"久矣云衢敛羽翰，退飞更觉一枝安。\n七千里外新闲客，十五年前旧史官。\n花底清歌春载酒，江边明月夜投竿。\n痴顽直为多更事，莫怪胸怀抵死宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中颇有四方之志偶得长句","author":"陆游","text":"世论纷纷枉见仇，吾身自计本悠悠。\n读书渐懒惟思睡，压酒初成不怕愁。\n蜀栈冷云侵瘦马，楚江笼月系孤舟。\n兴来会作飘然去，更续骚人赋远游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中颇自适戏书示客","author":"陆游","text":"发犹半黑脸常红，老健应无似放翁。\n烹野八珍邀父老，烧穷四和伴儿童。\n剪纱新制簪花帽，乞竹宽编养鹤笼。\n巢许夔龙竟谁是，请君下语勿匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲中富贵二首 其一","author":"陆游","text":"要信人生各有缘，闲中富贵亦关天。\n绿窗静对千梢竹，翠窦新疏一脉泉。\n爱百衲琴常锁匣，买双钩帖不论钱。\n个中得意君知否，不换金貂与玉蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲记老境二首 其一","author":"陆游","text":"谢事久悬车，为农懒荷锄。\n破裘寒旋补，残发短犹梳。\n槁木忘荣谢，闲云任卷舒。\n心知老当逸，先罢夜观书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲记老境二首 其二","author":"陆游","text":"嫌闹不入市，怕寒稀出门。\n拥炉愁兀兀，投枕睡昏昏。\n柳色新如染，梅花香满村。\n犹嗟未免俗，薄酒诳空樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲行","author":"陆游","text":"出户莽悠悠，东西本不谋。\n阻溪因小涉，逢店得中休。\n鸟没千山暝，蝉吟一院秋。\n诗成还自笑，信笔愧冥搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲步至鞠场值小雪","author":"陆游","text":"倒尽床头酒半罂，笑呼筇杖共闲行。\n梅花照水为谁瘦，雪片倚风如许轻。\n孟德遇冬思射猎，广文垂老谢才名。\n归来跨火西窗下，独数城楼长短更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲身","author":"陆游","text":"炊烟漠漠闭柴荆，聊用闲身答太平。\n重碧飞觞心未老，硬黄临帖眼犹明。\n吴蚕满箔含桃熟，垄麦登车抟黍鸣。\n补劓息黥今有地，问君何处用虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲咏五首 其二","author":"陆游","text":"事业无闻负圣时，沧波自照角巾攲。\n养成林下无穷懒，占尽人间彻底痴。\n小麦绕村苗郁郁，柔桑满陌椹累累。\n医翁筮叟真堪友，搜索残尊与共持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲咏五首 其一","author":"陆游","text":"萧萧华发映乌巾，五十年前故史臣。\n正使老来无老伴，未妨闲处作闲人。\n按行池水知增耗，点检庭花见故新。\n更有庵中策勋事，投床鼻息聒比邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲咏二首 其一","author":"陆游","text":"身似地行仙，心非欲界天。\n舆竿声轧轧，巾角影翩翩。\n买菊穿苔种，怀茶就井煎。\n归来书绕坐，随处一欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲咏","author":"陆游","text":"本志常思退，前缘剩得闲。\n听猿来剡县，采药上稽山。\n超绝风尘表，瑩然冰雪颜。\n向来香火地，五缀羽衣班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲咏二首 其二","author":"陆游","text":"久入春农社，新腰老衲包。\n纸裁微放矮，砚斲正须䫜。\n髯簿能为祟，方兄任绝交。\n吾诗无杰句，聊复当谈嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲咏五首 其五","author":"陆游","text":"危途九折浩无津，晚幸收身作散人。\n俸禄既空忧患少，酒殽虽薄笑歌频。\n多添布褐方知老，净扫茆衡不觉贫。\n南陌东阡元在望，柴车懒驾动经旬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲咏","author":"陆游","text":"莫笑结庐鱼稻乡，风流殊未减华堂。\n茶分正焙新开箬，水挹中?自候汤。\n小几研朱晨点易，重帘扫地昼焚香。\n个中富贵君知否，不必金貂侍紫皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]