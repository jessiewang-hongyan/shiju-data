[{"title":"和郁簿问讯梅花","author":"虞俦","text":"三径萧萧一冷官，菊残荷尽扰愁端。\n思君一夜梅花瘦，旋觉新来带眼宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23026,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和郁簿出郭","author":"虞俦","text":"青衫莫厌缚微官，过眼荣枯几万端。\n得意邯郸归一枕，从今须放酒肠宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23027,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和郁簿","author":"虞俦","text":"长笑刘郎赋大钧，强将神理质诸人。\n泛观万物皆刍狗，天地谁知本不仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23028,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"姜邦杰以四绝见寄因和之 其一","author":"虞俦","text":"当年宝婺我为州，锦里先生得唱酬。\n一自江头分袂后，至今空想暮云愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23029,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"姜邦杰以四绝见寄因和之 其二","author":"虞俦","text":"州县丰登公事少，凝香燕寝只吟哦。\n乐天长短三千首，争似斯民击壤歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23030,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"姜邦杰以四绝见寄因和之 其三","author":"虞俦","text":"梅山诗集到中都，囊括三江带五湖。\n却许严诗编杜集，傍观应作丈人乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23031,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"姜邦杰以四绝见寄因和之 其四","author":"虞俦","text":"少日清文结主知，斋坛授钺及耆颐。\n人生得意今如许，须信穷人不是诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23032,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和王宰见戏二绝 其一","author":"虞俦","text":"南浦晴来涨绿波，他乡春事已无多。\n禅心总作空花观，孤负尊前一曲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23033,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和王宰见戏二绝 其二","author":"虞俦","text":"风来瑟瑟暮生波，雨后阶前榆荚多。\n隔叶黄鹂漫愁思，定应春晚不能歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23034,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和林正甫韵 其一","author":"虞俦","text":"门外东风自在狂，雨晴深院日偏长。\n鸣鸠唤妇声声切，赖是年来已沐肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23035,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和林正甫韵 其二","author":"虞俦","text":"间关得侣情尤重，冷淡论交味更长。\n纵使出门还有碍，几多世路险羊肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23036,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和遇太学三友","author":"虞俦","text":"师门泰华一高峰，天遣云龙处处逢。\n肯赠明珠须及早，蛾眉端不浪为容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23037,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和汉老弟留衢","author":"虞俦","text":"眼中犀角无馀子，膝下荆兰总一般。\n纵有家声报消息，未如一见始心安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23038,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠耘老弟韵","author":"虞俦","text":"夜永青缸一点明，雨声著瓦似荷声。\n何人高卧西窗下，先觉凉从枕簟生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23039,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汉老弟寄和花发多风雨人生足别离韵十绝因和之 其一","author":"虞俦","text":"自笑为容非白璧，从渠入耳有黄华。\n一行作吏浑无况，两眼新来病有花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23040,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汉老弟寄和花发多风雨人生足别离韵十绝因和之 其二","author":"虞俦","text":"风前无赖花飞急，少待须臾莫仓卒。\n不堪姚魏遽飘零，尚有酴醾能秀发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23041,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汉老弟寄和花发多风雨人生足别离韵十绝因和之 其三","author":"虞俦","text":"春尽园林莺懒唤，日长官舍雀堪罗。\n二毛老去浑无用，一掬愁来不奈多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23042,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汉老弟寄和花发多风雨人生足别离韵十绝因和之 其四","author":"虞俦","text":"几多白白与红红，争似淮山小桂丛。\n簿领沈迷春又过，枉教二十四番风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23043,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汉老弟寄和花发多风雨人生足别离韵十绝因和之 其五","author":"虞俦","text":"有酒不浇坟上土，浮花浪蕊何须数。\n营巢燕子恰迎风，逐妇鹁鸪还唤雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23044,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汉老弟寄和花发多风雨人生足别离韵十绝因和之 其六","author":"虞俦","text":"割鸡自叹非初意，有底徘徊绊此身。\n官事未知何日了，溪边谁识望云人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23045,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汉老弟寄和花发多风雨人生足别离韵十绝因和之 其七","author":"虞俦","text":"三春已过二春了，十日那无一日晴。\n已是飘零成老丑，更怜行乐负平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23046,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汉老弟寄和花发多风雨人生足别离韵十绝因和之 其八","author":"虞俦","text":"照坐彫盘花一簇，满瓮葡萄酒新绿。\n那知身后更浮名，若论眼前不翅足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23047,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汉老弟寄和花发多风雨人生足别离韵十绝因和之 其九","author":"虞俦","text":"莫将杨柳轻攀折，人生会少多离别。\n芍药留残十日春，杜鹃啼破千山月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23048,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汉老弟寄和花发多风雨人生足别离韵十绝因和之 其十","author":"虞俦","text":"十首新诗逼黄绢，数行妙墨写乌丝。\n摩挲老眼还惊顾，文采珊瑚斗陆离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23049,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和人二绝 其一","author":"虞俦","text":"眼底群山入望来，搀天苍弁独崔嵬。\n年来怀抱谁关锁，祇傍登临醉里开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23050,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和人二绝 其二","author":"虞俦","text":"广文官冷复谁堪，心事无人可共谈。\n好雨忽来诗兴动，苦无才调却怀惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23051,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蚊虫 其一","author":"虞俦","text":"嗟予意广与才疏，天下何当贮一幮。\n尽把饥蚊羁海外，却驱一世入华胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23052,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蚊虫 其二","author":"虞俦","text":"赋形微细在污渠，终日营营为腹虚。\n贪吏贪民膏血尽，不知何计与驱除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23053,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过南京","author":"虞俦","text":"三苏当日振英华，下榻相看意已佳。\n太息乐全无复见，旧庐闻属女真家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23054,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"回至南京闻杜鹃","author":"虞俦","text":"夏木阴阴四月天，伤心满目旧山川。\n还辕已落春归后，始到南京闻杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23055,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将至泗州闻杜鹃声甚急","author":"虞俦","text":"长淮准拟濯尘埃，汉节何妨一往回。\n杜宇不知归路近，树头声急更相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23056,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢杨仲才惠芍药 其一","author":"虞俦","text":"何人金印漫垂腰，赤脚怜浓不解娇。\n老去不因花妄想，沾泥柳絮似参寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23057,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢杨仲才惠芍药 其二","author":"虞俦","text":"白玉盘盂自一家，春工雕琢蚤萌芽。\n品题况有坡翁句，除却姚黄说此花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23058,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢杨仲才惠芍药 其三","author":"虞俦","text":"回首龙山忆孟嘉，诗成醉墨带烟霞。\n风流多谢佳公子，遣赠扬州几度花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23059,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南坡种芍药 其一","author":"虞俦","text":"错盘根垡似苞桑，细细分来巧作行。\n且趁秋灰浮季琯，更教冬线受微阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23060,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南坡种芍药 其二","author":"虞俦","text":"卵石周围也自佳，茅亭稳著不须奢。\n何心更作扬州梦，十里春风万本花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23061,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南坡种芍药 其三","author":"虞俦","text":"南坡地脉生来瘦，根垡移栽却要肥。\n说与园翁须早计，莫教春事与心违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23062,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"图南学长有咏梅十五诗各指名其处所且书以见寄因赋二绝句谢之 其一","author":"虞俦","text":"咏梅谁复擅诗名，梅与诗人自有情。\n说尽梅花随处好，喜君诗句似梅清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23063,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"图南学长有咏梅十五诗各指名其处所且书以见寄因赋二绝句谢之 其二","author":"虞俦","text":"梅格孤高不待誇，暗香浮动影横斜。\n个中风味谁相称，只有西湖处士家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23064,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和广文俞同年贺太守 其一","author":"虞俦","text":"休咏诗人大小东，丰年雨意十分浓。\n使君自是为霖手，不遣昌黎苦讼风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23065,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和广文俞同年贺太守 其二","author":"虞俦","text":"三登从此数淳熙，一雨炎官遂霁威。\n绿润田畴今已遍，凉生殿阁故应微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23066,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和广文俞同年贺太守 其三","author":"虞俦","text":"人言岁稔催科易，我念民贫积欠多。\n政拙不归嗟已老，空馀一饭愧廉颇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23067,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和广文俞同年贺太守 其四","author":"虞俦","text":"绛帐才华溢彩笺，谁嘲昼寝腹便便。\n侧闻已上中和颂，试请重歌相府莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23068,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余帅淮西下车才十日移东漕二绝 其一","author":"虞俦","text":"安得丝毫补吏民，下车才度十朝曛。\n却惭父老相留恋，卮酒争持寿使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23069,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余帅淮西下车才十日移东漕二绝 其二","author":"虞俦","text":"多少邦人意惨悽，出郊云淡楚天低。\n马头渐指淮东去，回望孤城落照西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23070,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和万舍人分惠鲎鱼 其一","author":"虞俦","text":"昌黎集里知名久，山海经中取喻何。\n柱后惠文渠勿恃，只今散地亦投戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23071,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和万舍人分惠鲎鱼 其二","author":"虞俦","text":"怪形未免遭支解，香甲还应即鼎烹。\n便与庚桑登俎豆，何如郭索自泥行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23072,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舒州清明二首 其一","author":"虞俦","text":"架竹编茅数百家，柴门随分映桃花。\n春风不办舒州杓，习惯淮乡木杵茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23073,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舒州清明二首 其二","author":"虞俦","text":"试著轻衫问晓晴，野棠花下有清明。\n不如独上江楼去，坐听春潮送橹声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23074,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以双梅二枝送郁簿小诗见意","author":"虞俦","text":"连枝并蒂更同根，结实双双向小园。\n调鼎异时知有伴，相期携手上天门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23075,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六月二十一日戊寅率同寮诣登源祖庙中迎英济祷雨是日也雨随车至越翼日己卯继之至中宵方霁自辛巳至于乙酉遂沛然沾足丙戌敬送神因书二小诗以纪灵异 其一","author":"虞俦","text":"蓱号起雨风头好，禾稼如云水面肥。\n从此丰年无一事，前歌后舞送神归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23076,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"六月二十一日戊寅率同寮诣登源祖庙中迎英济祷雨是日也雨随车至越翼日己卯继之至中宵方霁自辛巳至于乙酉遂沛然沾足丙戌敬送神因书二小诗以纪灵异 其二","author":"虞俦","text":"催科太拙愧无功，抚字徒劳技已穷。\n正直却应神误听，祇凭香火报年丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23077,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午日被旨祷雨天目山次日至临安县道中 其一","author":"虞俦","text":"伊轧篮舆度翠微，萧疏甲队小红旂。\n杜鹃强欲知人事，苦苦声声劝我归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23078,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"端午日被旨祷雨天目山次日至临安县道中 其二","author":"虞俦","text":"绿林深处啭黄鹂，光景浑如初夏时。\n尚觉风头能瑟瑟，却忧雨脚反迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23079,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偕簿尉过石照山祷雨 其一","author":"虞俦","text":"紫金岩电间闪烁，宝网香云时吐吞。\n况有降魔大圆镜，岂因旱魃更游魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23080,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偕簿尉过石照山祷雨 其二","author":"虞俦","text":"怪生斗水蓄风雷，唤取龙神睡觉来。\n火急共为诗准备，却愁头上雨相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23081,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偕簿尉过石照山祷雨 其三","author":"虞俦","text":"野火烧渠经几秋，却将光彩閟深幽。\n尘中纵有人磨镜，俗状年来我亦羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23082,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偕簿尉过石照山祷雨 其四","author":"虞俦","text":"向来赤地增愁叹，更遣蜚蝗恣噬吞。\n稽首愿天怜一雨，只今未定有惊魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23083,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偕簿尉过石照山祷雨 其五","author":"虞俦","text":"一声破柱走惊雷，割得乖龙左耳来。\n海水荡云疑欲立，电光摇帜更烦催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23084,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偕簿尉过石照山祷雨 其六","author":"虞俦","text":"石应皮里有阳秋，千载潜光待发幽。\n说与山灵呈伎俩，试令回顾合包羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23085,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偕簿尉过石照山祷雨 其七","author":"虞俦","text":"白虹贯日怜精爽，黑蜧拿云怪吐吞。\n急雨翻盆天借润，摩挲粳稻与招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23086,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偕簿尉过石照山祷雨 其八","author":"虞俦","text":"墨云沃日度轻雷，满载随车白雨来。\n更好夜凉工杼轴，篱根蚤有候虫催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23087,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偕簿尉过石照山祷雨 其九","author":"虞俦","text":"百箔蚕丝麦有秋，田家此乐最閒幽。\n蓱号莫败西成好，里社溪毛或可羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23088,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二绝句 其一","author":"虞俦","text":"问龙乞水龙何惜，纵令一雨才涓滴。\n但愿群公坐庙堂，且与庆元调玉历。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23089,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二绝句 其二","author":"虞俦","text":"山石崎岖路觉遥，望中天目得能高。\n洞霄双径无缘到，从事何妨我独劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23090,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十五日看梅花上雪销已尽 其一","author":"虞俦","text":"问讯春风笑语温，轩眉花柳自村村。\n月娥不肯空归去，先为梅花洗睡昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23091,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十五日看梅花上雪销已尽 其二","author":"虞俦","text":"素面青娥月里回，舞阑香汗粉融腮。\n洗妆懒趁霜钟早，直待扶桑金镜开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23092,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和人紫笑花","author":"虞俦","text":"绀苞紫晕别家春，不属东君自宠珍。\n丈室维摩元不病，何妨时有散花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23093,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和汉老弟夜雨诗 其一","author":"虞俦","text":"蜡纸灯笼云母轻，近来勾我睡魂生。\n醒来骤听空阶雨，疑是糟床压酒声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23094,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和汉老弟夜雨诗 其二","author":"虞俦","text":"眼看世事一毫轻，莫把浮名绊此身。\n却笑彭城风雨夜，枉教松竹作离声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23095,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和汉老弟夜雨诗 其三","author":"虞俦","text":"掩卷支颐万虑轻，家风元是鲁儒生。\n短檠已入秋堂露，对榻犹便夜雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23096,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和汉老弟夜雨诗 其四","author":"虞俦","text":"雨催诗兴笔头轻，饭颗休嘲太瘦生。\n华动淋漓清夜酌，竹分潇洒暮檐声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23097,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和汉老弟夜雨诗 其五","author":"虞俦","text":"纷纷万事醉中轻，金石论交仗曲生。\n鼓吹纵无蛙两部，欢呼时和隔墙声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23098,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次日出山又雨","author":"虞俦","text":"一夜龙池霹雳飞，万山连雨出重围。\n莫愁随步冲泥滑，且得馀凉送我归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23099,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和汉老弟雪中对梅 其一","author":"虞俦","text":"雪样清虚玉样温，桃花粗丑杏花村。\n可能腊月头开尽，却恐春风眼见昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23100,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和汉老弟雪中对梅 其二","author":"虞俦","text":"雀抱寒柯窗弄影，鸾窥清沼粉匀腮。\n年来怀抱浑关锁，为尔眉头得好开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":23101,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]