[{"title":"酬友人见寄","author":"释文珦","text":"山房一事无，开箧理残书。\n习气嗟难断，閒情为折除。\n菊篱秋烂熳，枫径意萧疏。\n忽枉瑶华赠，知君又起予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬李筼房元日见寄韵","author":"释文珦","text":"五年懒踏上京尘，真是乾坤散诞身。\n正向山中閒卧雪，忽闻户外报迎春。\n且倾竹叶屠苏酒，休画桃符郁垒神。\n底事诗筒来往密，结交多是苦吟人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬李筼房见寄","author":"释文珦","text":"修筼古君子，溪上有清风。\n直节应难并，高标自不同。\n婵娟消俗虑，培养见深功。\n爱此黄钟管，传声到谷中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬源上人见寄","author":"释文珦","text":"自从相别后，闻过海邦居。\n不得陪乡话，空烦寄远书。\n林声随雨散，溪影度云虚。\n若遂东游计，终朝到子庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬筼房秋崖昆仲见寄韵","author":"释文珦","text":"岁月骎骎苦易过，凝霜还见委庭莎。\n从来桑下不三宿，此去榆光尚几何。\n旧社久荒谁复记，远公难觅恨空多。\n诸贤赖有刘雷在，时寄新诗到薜萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鉴上人所居金竹青琅玕一茎","author":"释文珦","text":"潇洒非凡种，虚空是本心。\n才生一青玉，不数万黄金。\n月写孤鸾影，风传丹凤音。\n从兹护根本，会见别成林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雷峰","author":"释文珦","text":"不定似飞蓬，还来宿此峰。\n霜欺孤客枕，风乱四山钟。\n好梦如冰薄，归心与酒浓。\n旧房谁占住，门有最长松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉禾舟中","author":"释文珦","text":"舟次寒城外，人家已闭门。\n蜃眠春浪息，鸟入暮烟昏。\n泽广疑无地，车鸣忽有村。\n兹游虽适兴，终不似丘园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉况","author":"释文珦","text":"嘉况日因仍，山翁乐岂胜。\n自知梅已熟，人报麦初登。\n外患忘饥渴，中心散滞凝。\n超然出天地，不止似壶冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮春书怀","author":"释文珦","text":"青春还又暮，草树各相高。\n细雨啼姑恶，微风飞伯劳。\n壮怀消白发，隐迹寄玄袍。\n万事何须计，人生各有遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泽国幽居夏日杂题 其二","author":"释文珦","text":"为得近樵渔，来寻此地居。\n省交长闭户，耽静欲焚书。\n自爱心清淡，人嫌礼貌疏。\n径荒从草没，衰懒不能除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"静中","author":"释文珦","text":"静中观世道，一一总非真。\n龃龉英贤诎，依冯鄙贱伸。\n狂澜乘飓势，枯木借藤春。\n何似都忘著，沈潜自养神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"静地","author":"释文珦","text":"适时非所长，静地阅流光。\n旧燕无留影，新鸿有断行。\n交朋皆谢往，老大足悲伤。\n彊咏多羞涩，追思亦易忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"樗栎","author":"释文珦","text":"樗栎非时用，悠悠任散材。\n自归孤嶂下，已是十年来。\n世虑消除尽，閒门少得开。\n相过但清话，懒不置茶杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潜山风土","author":"释文珦","text":"潜为杭古邑，汉郡属丹阳。\n俗本崇勤俭，民终不寇攘。\n屋头犹种木，田岸亦栽桑。\n颇与豳风类，吾心爱此乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"稻熟而遭巨浸以诗伤之","author":"释文珦","text":"九秋禾正熟，三日雨滂沱。\n畎亩黄云失，沟塍白水多。\n岂知民已病，犹苦赋重科。\n父子难相保，流离可奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"霅城重会修蘋州","author":"释文珦","text":"江湖身不定，十载别年兄。\n忽尔重逢面，翻疑是隔生。\n湿云行有路，细雨落无声。\n惆怅还分手，扁舟出郡城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题江湖伟观","author":"释文珦","text":"左右江湖仙圣宅，龙飞凤舞帝王家。\n楼台高下随山势，渤澥微茫涌日华。\n渔浦风和翻柳影，官河春尽落桐花。\n钱唐佳丽今无比，回首中原望眼赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题竹房","author":"释文珦","text":"野水连苔径，山云掩竹房。\n人闲清昼永，鸟语绿阴凉。\n断刻排签古，新茶入焙香。\n眼前清事足，不道在殊方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题杲东轩阇维齿不坏轮珠变金色","author":"释文珦","text":"全德寡知音，浮沤亦易沉。\n终因三昧火，始验一生心。\n讲齿犹存玉，轮珠自化金。\n几多空掩胾，遗臭在山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题规无范云深室","author":"释文珦","text":"物外清虚境，由来远众纷。\n灵踪几年说，梵放或时闻。\n似有似无路，漫山漫谷云。\n自难容俗驾，曾不待移文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题逆贾","author":"释文珦","text":"逆贾猖狂秉国钧，民彝帝业总成尘。\n虔刘几似刀兵劫，全活幸蒙天地仁。\n众醉有谁知甲子，独醒还自记庚申。\n鼎湖龙驭重回首，应悔当年错用人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题暇亭","author":"释文珦","text":"人与山同静，亭安紫翠间。\n无时临镜水，终日见南山。\n子敬心犹杂，渊明意自閒。\n坐来轻世事，薄暮鸟飞还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"衡门 其二","author":"释文珦","text":"铁锡已高悬，残山剩水边。\n算年齐易卦，写梦入诗篇。\n介癖游从少，幽深景物偏。\n衡门终日掩，吾自守吾玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"衡门 其一","author":"释文珦","text":"衡门随我分，可是贱儒冠。\n任性中肠乐，无营梦境安。\n涧声暗后响，山气夜深寒。\n活计何劳问，薇生采不难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"衡茅","author":"释文珦","text":"衡茅隐翠层，聊以尽残形。\n得性非常道，忘言是此经。\n孤标松落落，晚节竹青青。\n此外非吾事，来言总不听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠山友","author":"释文珦","text":"此地长依止，人间境亦偏。\n壁萝斜引蔓，崖竹倒垂鞭。\n野鹤通秋梦，妖狐恐夜禅。\n愿来相伴住，解脱世间缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠山中琴友","author":"释文珦","text":"云影昼沉沉，云边草径深。\n树为幽鸟宅，山是隐人心。\n静室无他物，清风寄一琴。\n调高唯自识，不问有知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠牛羊司范月溪","author":"释文珦","text":"莫嫌司职小，先圣亦曾为。\n蕃息更何事，萧閒且赋诗。\n尔牲诚具止，尔牧自来思。\n考牧宣王雅，应拈短笛吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠王门老宾客","author":"释文珦","text":"薄俗谩纷纷，焉知赝与真。\n空馀千里马，难觅九方歅。\n古道何当复，时风未易陈。\n王门旧宾客，怀旧重悲辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠同志","author":"释文珦","text":"忘情三十载，曾不厌顽疏。\n白石能同煮，青山亦共居。\n猿声依树乐，鸟影入云虚。\n闻道黄精熟，相呼又荷锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠孤山道士","author":"释文珦","text":"多年于此住，卖药但资身。\n窗冷梅花月，门閒柳树春。\n水妖愁使术，山鹤伴朝真。\n果欲求仙道，惟应自养神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠苦行僧","author":"释文珦","text":"泯然诸念尽，木食貌常羸。\n林下身虽老，人间事不知。\n持经被艾衲，礼像爇枫脂。\n不是忘形者，终难学尔为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠隐人","author":"释文珦","text":"换却青云志，高眠旧隐庐。\n閒门谁践草，隙地自栽蔬。\n交道贫尤密，吟情老不疏。\n囊中何所有，一卷养生书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠隐僧","author":"释文珦","text":"高僧成独往，古路少人过。\n切柏贞心在，看山静意多。\n清钟生响答，空翠与云和。\n不解相随住，其如白发何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠隐僧","author":"释文珦","text":"禅居既高静，道气尤凄清。\n不识市朝路，深谙猿鸟情。\n田衣联槲叶，山火燎松明。\n自说归栖后，柴门罢送迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邃谷","author":"释文珦","text":"邃谷居来久，寥寥绝众喧。\n云深通药径，草长失柴门。\n静爱寒山色，閒寻野水源。\n清虚乃吾事，不与俗人言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曝背","author":"释文珦","text":"老知身是患，万事不关心。\n曝背茅檐下，孤猿时一吟。\n白云同去住，青壁共幽深。\n小岭尤堪隐，难寻支道林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冯深居挽词","author":"释文珦","text":"天地一深翁，匡庐气所钟。\n亲传厚斋业，优得考亭宗。\n劲节霜崖竹，高标雪峤松。\n沧溟含雅量，干莫避辞锋。\n元老皆知敬，憸夫独不容。\n畏涂尝跌足，道院暂潜纵。\n冤白州麾晚，身亡奠斝重。\n魂应归帝所，人尽哭堂封。\n有道存方册，无名上景钟。\n死生今隔异，湖海昔过从。\n刍束无繇致，愁凝五老峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同诸友寻幽登飞来峰","author":"释文珦","text":"湖际山何限，飞来独著名。\n玲珑疑鬼凿，崷崒自天成。\n猿去犹存洞，龙归尚有泓。\n树因含玉润，泉为炼丹清。\n桂子排空落，莲花浥露擎。\n鹫形传佛国，灵应动神京。\n翻译贤人迹，稽留隐者情。\n脩藤垂万岁，孤石记三生。\n夜讲台偏古，春风桧重荣。\n宾王辞可讯，慧理塔难平。\n客至心多恋，僧居虑自轻。\n跻攀虽诘屈，临眺独高明。\n观阙雄三岛，衣冠迈百城。\n东南且行在，西北待经营。\n溟涨无涯涘，江流但注倾。\n一时归眼界，终古播诗声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"閒兴","author":"释文珦","text":"分得此生閒，于今老更顽。\n心终如白水，身不离青山。\n拙性从人诮，前诗或自删。\n衡门深草色，坏衲上苔斑。\n虽有贫居乐，犹闻世道艰。\n皇天如有意，会见古风还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和卢推官中秋遇雨","author":"释文珦","text":"秋中唯此夕，雨蔽月圆时。\n握管沉幽思，临轩失旧期。\n孤灯花谩落，良会信成亏。\n宋玉悲潜长，安仁鬓亦衰。\n檐声愁里滴，星度暗中移。\n到晓休临鉴，霜髯只自欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"星诸兄挽词","author":"释文珦","text":"吾宗老兄弟，夫子最高明。\n问学穷根柢，公忠出性情。\n夙能全至孝，元不念脩程。\n道自成均重，身由射策荣。\n把麾闻列郡，持橐贰春卿。\n得请还山早，居家旧疾平。\n正安琳馆乐，忽报玉楼成。\n死后名逾盛，生前志未行。\n他年如定谥，谥号决当清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剡源山房","author":"释文珦","text":"茅屋小于船，寒宵此会偏。\n苦吟因静得，幽思与閒便。\n断壁栖云气，虚窗闭篆烟。\n帖残重补画，琴老不胜弦。\n画轴尘为古，茶炉火自然。\n细泉胶苋腹，冻鹤堕松巅。\n石鼓鸣如磬，瓷瓶色类铅。\n雪明灯焰减，风远漏声传。\n鼠黠窥人走，僮顽背客眠。\n骨清神欲脱，兴逸语犹颠。\n野性终应在，浮名岂足缠。\n欲从支遁隐，未有买山钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱塘晚渡别友","author":"释文珦","text":"寒月照沙头，轻风引客舟。\n挂帆重旷望，举棹复夷犹。\n地势连吴越，星躔次斗牛。\n雁烟萦别思，渔火点乡愁。\n双鬓谁怜白，单衣自怯秋。\n明朝定相忆，独上水边楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚步","author":"释文珦","text":"晚策信所往，幽怀那可穷。\n孤村流水外，古木乱山中。\n雨过天容净，风收地籁空。\n淡烟归独鸟，深涧饮长虹。\n日下青峰表，潮生沧海东。\n光吞群象没，气混百川雄。\n㭬杙知樵子，乘舟识钓翁。\n閒身天与健，萧散复谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一身","author":"释文珦","text":"一身谁与偕，病骨老穷崖。\n春雨苔封径，秋风叶满阶。\n剪云成隐服，煮石当清斋。\n樵客时相过，言予有好怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九仙山中瀑","author":"释文珦","text":"一水从天下，源深不可知。\n千寻垂缟练，馀沫散珠玑。\n响激雷霆合，风生草木攲。\n老僧来灌顶，溅湿薜萝衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二疏","author":"释文珦","text":"汉朝诸公卿，鲜有能自全。\n广受信明哲，独悟于机先。\n托之老氏训，辞禄偕归田。\n祖帐东都门，万口称其贤。\n于今阅千龄，高风犹凛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"人生几何行 其一","author":"释文珦","text":"人生能几何，百年三万日。\n一半睡中消，馀寿或难必。\n钟鼎与轩裳，总是牢笼物。\n贪夫所甘心，宛转无由出。\n富贵者常劳，贫贱者常逸。\n所以箕山人，不为唐尧屈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"人生几何行 其二","author":"释文珦","text":"人生百年间，何殊旅亭客。\n少壮不可留，渐觉衰老迫。\n纵使功业成，谁能免形役。\n长歌归去来，山中煮白石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又言交","author":"释文珦","text":"道交淡如水，世交甘如醴。\n结交当以真，审交当以理。\n道交似无情，曾不异生死。\n世称刎颈交，未必能终始。\n君不见昔者，陈馀与张耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与云耕重会复别","author":"释文珦","text":"久别思见面，重逢反成悲。\n相持问年纪，各在桑榆时。\n道途筋力残，玄发成素丝。\n时命苟不遭，有才亦奚为。\n荣华既非愿，但愿亡寒饥。\n眼前且相慰，老别难再期。\n此语亦良苦，君心还自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大水后作","author":"释文珦","text":"田家望西成，弥月雨霖霔。\n流潦迷川泽，粳稻尽漂淤。\n牛犬奔崇丘，鸡亦栖高树。\n室庐毕沈没，野老无归处。\n大家还急租，官中未蠲赋。\n妻子多转徙，天高不可吁。\n但愿吾皇知，圣恩加咻喔。\n下诏发仓廪，赈恤散红腐。\n不唯赤子活，亦使根本固。\n八表皆归仁，万岁永终誉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山人居涧上号涧居因涧作池名鉴止为赋是诗","author":"释文珦","text":"幽人临涧居，为爱涧中水。\n泠泠出云窦，决决漱石齿。\n流行本无意，遇坎还自止。\n坎深遂成池，寒光映窗几。\n于以鉴禅心，清净绝尘滓。\n唯供种白莲，不洗闻尧耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中 其二","author":"释文珦","text":"每说远公栖隐处，乱云□歌石难通。\n不是樵夫相指引，无云得到此山中。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中吟 其六","author":"释文珦","text":"受性不分拿，处身常落魄。\n难以事王侯，唯堪友猿鹤。\n遂尔辞国都，终然住林壑。\n渴则饮涧溪，饥则茹薇藿。\n烟霞水石间，自得无穷乐。\n所归在一死，天地为棺椁。\n弃埋任从他，曾不加计度。\n乌鸢与蝼蚁，于吾无厚薄。\n清泰藕华池，深知可栖托。\n念兹常在兹，但观西日落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中吟 其二","author":"释文珦","text":"自为山中人，不厌山中居。\n云西最高峰，秀出如芙蕖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中吟 其四","author":"释文珦","text":"适俗岂吾志，归山存杖藜。\n渔樵日来往，岩崖恣攀跻。\n惜竹改新术，滋兰因故畦。\n忘机旧猿鹤，偏近座边栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中吟 其一","author":"释文珦","text":"偶为山中游，遂作山中住。\n猿鹤尽相忘，不记山前路。\n架有古仙书，立言谈信去。\n往往赜其玄，颇有会心处。\n乃知筌蹄作，意本在鱼兔。\n观象既得之，自可略章句。\n童竖难与言，趺坐入禅度。\n万事静中忘，不省白日莫。\n野云忽飞来，宿我檐间树。\n知我无所著，飘然又飞去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中吟 其五","author":"释文珦","text":"自为山中归，屡见岁华易。\n不问眉间黄，唯观鼻端白。\n水石尽成趣，渔樵或争席。\n尘世未归人，营营复何益。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中吟 其三","author":"释文珦","text":"山房更近仙翁井，汲水僧归秋夜永。\n石上行吟万境空，白猿叫在青松顶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中雪","author":"释文珦","text":"中宵霰雪零，寒气晓来凝。\n崖树当中折，山池到底冰。\n芎糜强食肉，松火胜添缯。\n篱户牢关上，何人唤得应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山乐官","author":"释文珦","text":"呜呼有鸟山乐官，鸣声宛转空林间。\n恐是执簧秉翟者，遗形变化之游魂。\n生兮不遇圣明世，千载而下犹烦冤。\n遗之好音不尔听，何如卷舌且勿言。\n箫韶九成集嘉瑞，当与威凤同飞鶱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山园丛桂新檗将抽陈叶皆陨感而成咏","author":"释文珦","text":"草木随时变，由来不少停。\n新萌将欲吐，陈叶已先零。\n便可知浮世，无由固此形。\n保常同醉梦，曾有几人醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]