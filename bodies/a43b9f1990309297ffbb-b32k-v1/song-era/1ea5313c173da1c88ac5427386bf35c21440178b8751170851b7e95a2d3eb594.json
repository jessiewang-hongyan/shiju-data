[{"title":"楚州阻水涨怀汪信民吕居仁二士四言","author":"洪炎","text":"大江北理，长淮西逝。\n厥隩射阳，城邑岳峙。\n凿渠而漕，首淮江尾。\n舳舻岢峨，连樯千里。\n青雀翩翩，彩虹嶷嶷。\n梁局舟蹐，限兹潢水。\n昔我至止，得二国士。\n箪瓢相乐，汪吕氏子。\n于今几年，乖隔生死。\n梗泛萍飘，乃复于此。\n菱花净吐，鹭羽徐起。\n如欲我留，盼睐以喜。\n俯仰山川，感念成毁。\n一瞬千古，寓非予耻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉送驹父师川二郎中赴召四言","author":"洪炎","text":"火中暑退，庚伏在娄。\n赫炽方炎，金石欲流。\n之二大夫，服章紑紑。\n文昌台郎，祗命是忧。\n中江有舳，中涂有辀。\n风樯雨毂，长夏为秋。\n白云在天，崒如岩丘。\n倏忽西东，不我告谋。\n翩翩者鹄，俯瞩鱼游。\n将逝复止，矫影河洲。\n嗟予去国，三葛于休。\n止车生耳，永谢鸣驺。\n挥袂江干，长啸林幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"迁居","author":"洪炎","text":"从宦三十载，故山凡几归。\n昔归尚有屋，再归已倾攲。\n今归但乔木，竹落荆薪扉。\n上为鹳鸟都，下为鸡犬栖。\n相彼东北隅，三亩以为基。\n积块与运甓，实洼而培庳。\n成兹道傍舍，空我橐中赀。\n堂室敢即安，牖户适所宜。\n嘉树三四株，当窗发华滋。\n馨香入怀袖，似与迁徙期。\n我今六十老，岂不知前非。\n咨谋愚见拾，就列筋力微。\n窃食奉祠禄，永负伐檀诗。\n松楸幸在望，邻曲不见遗。\n葛巾随里社，庶以保期颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵公实与用中夜话","author":"洪炎","text":"贤哉郑圃客，去为五浆惊。\n解榻栖云表，开窗纳水声。\n忽逢京国旧，相对夜灯明。\n叹息胡证老，犹思摘铁檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉女峰","author":"洪炎","text":"玉女何时见，兹峰独挺群。\n古容馀佛座，虚室但炉薰。\n林隐投壶电，山藏出岫云。\n自惭非屈宋，欲赋不成文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再任秘书少监","author":"洪炎","text":"再入兰台逢旧史，重游东观阅新书。\n家徒四壁今无屋，谁为君王奏子虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句","author":"洪炎","text":"桃花浪打散花楼，南浦西山送客愁。\n为理伊州十二叠，缓歌声里看洪州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"逍遥阁","author":"洪炎","text":"杰阁龙楼依翠微，中秋午夜望清辉。\n桂枝委地三千尺，柏影垂坛四十围。\n箫鼓或疑风雨下，云霞犹想锦帆飞。\n只今井臼依然在，不见归来丁令威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉女峰","author":"洪炎","text":"曾折山花献阿魔，茫茫仙意果如何。\n千年旧迹今芜没，惟有长松挂茑萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久阴初晴奉陪宫使枢密观梅","author":"范冲","text":"扫尽阴氛尽见春，荒山风物一时新。\n谪仙自是和羹手，聊与梅花作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石桥 其一","author":"范冲","text":"石梁杰出望南州，登览从公破旅愁。\n棋罢未应消一日，人归无奈已千秋。\n尘缨自喜临流濯，车辖仍逢好事投。\n莫怪神仙近如许，当年此地绝深幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石桥 其二","author":"范冲","text":"秋风吹上景华天，醉梦醒来一洒然。\n万古林泉招我老，百年风雨复谁怜。\n顿除热恼初无病，剩买安闲不用钱。\n寻得青霞是归处，漫修岩穴小乘禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠永平寺僧了空","author":"范冲","text":"几回飞锡入红尘，一任随缘自在身。\n琢句不妨明日用，援琴谁与听阳春。\n扬眉瞬目如相委，捧腹狂歌即是真。\n汤饼藜羹奉朝夕，自怜担板小乘人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建宁丹青阁","author":"赵岍","text":"跨壑飞檐屋数楹，上横山色下溪声。\n等闲题作丹青阁，未必丹青画得成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"赵岍","text":"美景天湖呈六六。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自舂陵还题驿舍壁","author":"朱辂","text":"邵陵北望几劳魂，白首慈亲日倚门。\n云外归鸿如可托，平安先为慰晨昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"任桂阳监使挂冠养母述怀","author":"朱辂","text":"勇退无心恋一麾，叩阍乞得侍庭闱。\n二千石禄人皆羡，九十慈亲古亦稀。\n东阁虽无文举酒，北堂幸有老莱衣。\n黄粱未熟浑閒事，且卧南山饱蕨薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仁寿楼","author":"徐庚","text":"拨置南荒果是非，性真全取未生时。\n前溪流水日夜逝，楼上主人浑不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄谢无逸","author":"汪革","text":"问讯江南谢康乐，溪堂春木想扶疏。\n高谈何日看挥麈，安步从来可当车。\n但得丹霞访庞老，何须狗监荐相如。\n新年更励于陵节，妻子同锄五亩蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吕居仁春日","author":"汪革","text":"晏坐黉堂一事无，居官萧散似相如。\n偶违浊酒风前约，不见繁英雨后疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代荥阳公作张先生哀词","author":"汪革","text":"惟古制行，必中庸兮。\n降及末世，戾不通兮。\n首阳柱下，更拙工兮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贤女浦 其一","author":"汪革","text":"贤女标名几度秋，行人抚事至今愁。\n湘云楚雨知何处，月冷风悲江自流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贤女浦 其二","author":"汪革","text":"女子能留身后名，包羞忍耻漫公卿。\n可怜呜咽滩头水，浑似曹娥江上声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁暮书堂","author":"汪革","text":"霜重阶铺纨，风凛肌生粟。\n心庄耳目清，思虑无由俗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"汪革","text":"富贵空中花，文章木上瘿。\n要知真实地，惟有华严境。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"汪革","text":"釜星晚杂出，雨脚晨可歇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠翠微主僧冲邈","author":"姚舜明","text":"僧腊俗年俱老大，儒书佛教旧精勤。\n姑苏一万披缁客，四事无如彼上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三江亭","author":"蒋璿","text":"安仁不放二毛侵，爽气凌虚玉万寻。\n谈笑薄施三昧手，登临谁会五湖心。\n倦游方戢冲天翼，高赋难赓掷地金。\n怪得朝云飞画栋，夜来曾听老龙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"林虙","text":"我公道德祖东丘，志小全吴见此游。\n远意最称包万里，佳名直欲付千秋。\n眷怜今日踰文献，友爱终身负道州。\n扶病强随都骑去，回肠百折伴江流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"胡伸","text":"谁能分梦觉，真妄两悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与刘邦直","author":"胡直孺","text":"梦魂南北昧平生，邂逅相逢意已倾。\n楚国山川千叠远，隋堤烟雨一帆轻。\n我无健笔翻三峡，君有长才肃五兵。\n同是行人更分首，不堪风树作秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送春","author":"胡直孺","text":"含酸梅子渐生仁，莺老花飞迹已陈。\n一夜南风摇斗柄，明朝烟柳不关春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日","author":"胡直孺","text":"风云吹絮柳飞花，睡起钩帘日半斜。\n四海随人双燕子，相逢处处作生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"讥章持","author":"绍圣时人","text":"何处难忘酒，南宫放榜时。\n有才如杜牧，无势似章持。\n不取通经士，先收执政儿。\n此时无一盏，何以展愁眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纪梦八诗 其一","author":"刘允","text":"银筑层台玉砌成，五云深映百花明。\n兽环响彻重门启，无限青娥喜笑迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纪梦八诗 其二","author":"刘允","text":"青鬟前引度回廊，帘捲云间旧院堂。\n松桂满庭龟鹤在，俨然丰观道家装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纪梦八诗 其三","author":"刘允","text":"徐入东堂百步馀，虚堂犹记旧来居。\n窗纱掩映琼签轴，尽是当时读遍书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纪梦八诗 其四","author":"刘允","text":"曈眬瑞日照觚棱，溶曳祥烟远栋甍。\n松桧雅知人趣尚，风来偏作步虚声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纪梦八诗 其五","author":"刘允","text":"侧金坛畔虬松老，甃玉池边绶虉长。\n吟折紫芝香满手，数声鸣凤在修篁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纪梦八诗 其六","author":"刘允","text":"兽炉烟和百花香，玉叶琼枝倚两旁。\n一曲云和鸾鹤舞，劝人争捧九霞觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纪梦八诗 其七","author":"刘允","text":"云母屏间看旧题，醉吟阿母碧桃枝。\n群仙指点未题处，更乞凌虚白鹤词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纪梦八诗 其八","author":"刘允","text":"步出朱宫日渐移，青鬟罗拜问归期。\n尘缘若断人间世，看取蟠桃正熟时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦中作 其一","author":"刘允","text":"刘郎平昔志烟霞，时到云山隐士家。\n除却松篁芝朮外，川源远近遍桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦中作 其二","author":"刘允","text":"尽日看山不厌山，白云飞去又飞还。\n傍人莫指云相似，云自无心我自闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又五言绝句一首","author":"刘允","text":"武陵源上雪，片片杂云霞。\n惟有雪中桃，长开三尺花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"皇恩寺","author":"陈之邵","text":"老桧乔松路屈盘，翚飞金碧照岩端。\n僧寻翠巘曾挥锡，客厌红尘屡解鞍。\n望断四天春野阔，梦回一枕夜涛寒。\n阳休况是多佳句，吟罢碧云时倚阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿时相","author":"陈汝锡","text":"五百年间瑞气钟，堂堂皎月众星中。\n甄陶四海规模大，心膂三朝体貌隆。\n寿杖终扶黄发老，衮衣今拜黑头公。\n彭聃岂足延遐算，愿助升平到不穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿周侍讲","author":"陈汝锡","text":"我闻仙翁山，秀色媚岗岭。\n昔人已仙去，飞步凌绝顶。\n世缘磨不尽，一念堕尘境。\n先生岂其人，骨相倍清整。\n神钟金茎秀，气与霜月冷。\n词源倒三峡，笔力扛九鼎。\n书林知几年，文字浩千顷。\n谈经动旒纩，屡被前席请。\n当随凤阁班，径步花砖影。\n胡为罢劝讲，禁幄出扬秉。\n一麾眇淮甸，素发欲随领。\n先生谪仙人，寿与龟鹤等。\n富贵要长年，功名看晚景。\n未须叹淹回，住世日月永。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿刘漕二首 其一","author":"陈汝锡","text":"清薰应候贡微凉，瑞霭蟠空报吉祥。\n仙籍挂名书富贵，彩毫叶梦送文章。\n眉间已有阴功色，肘后何须不老方。\n节物也随人意好，荷花争入寿樽香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿刘漕二首 其二","author":"陈汝锡","text":"碧槐风细篆烟清，绿芰香浓寿酒倾。\n眉上嵩衡元秀整，胸中泾渭太分明。\n巨材阅世三千岁，修翮抟风九万程。\n积粟流钱皆细事，异时钟鼎看功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石门山","author":"陈汝锡","text":"落帆倚芳洲，冷日衔翠壁。\n沙平野步稳，不费支筇力。\n邂逅到幽洞，云水已昏夕。\n阴崖上苍穹，杳不见辙迹。\n岩前月色薄，细路稍有觅。\n瀑泉号秋声，飞练不计尺。\n僧房得少憩，坐久耳方寂。\n河梁谪仙人，握手见胸臆。\n囊无一钱看，志有万里适。\n拄颊望西山，琢句愈工绩。\n同游得二妙，笔障亦劲敌。\n笑谈颇倾坐，酬唱屡即席。\n顾予舌本强，咀嚼觉清液。\n林泉信幽奇，岁月尤迅亟。\n兹游莫辞频，能著几两屐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"陈汝锡","text":"闲愁莫浪遣，留为痛饮资。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"流花亭","author":"陈与京","text":"丹雘依岩腹，翚飞枕碧闉。\n应教临水客，频问种桃人。\n野色低笼日，溪光长占春。\n仙槎消息便，咫尺到龙津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞莲桥即九曲池和王肱原韵","author":"周公弼","text":"石门双峙耸前蹊，溪白疑藏照水犀。\n古木万株清露染，晓风千叠瑞烟迷。\n虚岩伏虎和风啸，峻壁闻猿向晚啼。\n更有淡轩轩上趣，妙缘真觉證菩提。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观临淮双头白莲图","author":"周知微","text":"君不学叔隗季隗南归晋，又不学大乔小乔东入吴。\n一种桃根与桃叶，若为化作双芙渠。\n临淮政成有馀暇，坐令华屋生潇洒。\n鹅溪一幅万里宽，移得浙川入图画。\n天空水阔江茫茫，想见女英与娥皇。\n九疑云深苍梧远，冰姿玉泣不成妆。\n苦心抱恨何时了，香骨应甘没秋草。\n不如回首谢秋风，分作尹邢来汉宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浮萍","author":"周知微","text":"小靥浮青水拍堤，堤边草色更相宜。\n一番谷雨晚晴后，万点杨花春尽时。\n解与曲池藏宝鉴，不教新月妒蛾眉。\n怪来别岸波光阔，知是渔郎艇子移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题龟山","author":"周知微","text":"迢迢绿树淮天晓，霭霭红霞海日晴。\n遥望四山云接水，碧峰千点数帆轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"周知微","text":"疾风暴雨悲游子，峻岭崇山非故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"周知微","text":"后车莺燕春声早，前骑熊罴夜气遒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"周知微","text":"暮天斜去空成字，远地频来不寄书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟梅轩三首 其一","author":"吴幵","text":"阴阴绿叶不胜垂，著子全多欲压枝。\n自得君王一留顾，故应雨露亦饶滋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟梅轩三首 其二","author":"吴幵","text":"五月霏霏雨不开，若耶溪畔摘楞梅。\n朱丸忽向云窗见，疑是灵根越岭来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟梅轩三首 其三","author":"吴幵","text":"谁将蜜渍借微酸，小摘曾闻脩玉盘。\n争似江南风致在，瓶红初向绿阴看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"吴幵","text":"木落千山瘦，天高一雁横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"吴幵","text":"鸣玉不妨风细细，琐窗时借月娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"吴幵","text":"星斗垂光烛紫坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"吴幵","text":"欲识欢心从四海，钧天一曲引回銮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"吴幵","text":"纷纶委贶知旁达，渗漉流恩亦下蟠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感梦口占二绝 其一","author":"倪昱","text":"谁谓仙家隔一方，神游原不闭毫芒。\n归来谩话长年事，老不饶人白鬓苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感梦口占二绝 其二","author":"倪昱","text":"死生常事不须愁，我亦无心任去留。\n人事重来聊尔尔，浊醪脱粟外何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登华顶峰","author":"鲍朝宾","text":"篮舆直上八重峰，千里秋蟾咫尺中。\n寄语尘寰高会者，清光不与世间同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登南山","author":"赵伯纯","text":"少陵云间诗，重岩班菊蕊。\n二章刻岩腹，千载今可视。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":59837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]