[{"title":"燕新第乡人致语口号","author":"史浩","text":"鄮山鄞水百祥开，壮士昂头谢草莱。\n戛玉锵金俱杰出，纡青拖紫正朋来。\n未饶卫国多君子，何独山东有相材。\n富贵功名随步武，清时钟鼓且衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16646,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"复诸亲庆会致语口号","author":"史浩","text":"潭府今朝雅宴开，郁纷佳气霭蓬莱。\n笙歌丛里环珠履，衮绣光中荐玉杯。\n已喜群仙来阆苑，更须三熟见瑶台。\n料应太史占乾象，星斗森罗拥上台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16647,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄居庆汪中嘉尚书年登七秩会致语口号","author":"史浩","text":"鄮山鄞水百祥开，天祐神仙间世来。\n剩喜千龄才七秩，更祈八座上三台。\n箫韶声里翻红袖，衮绣光中釂玉杯。\n每阅十期成再会，方瞳丹脸永如孩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16648,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宴明守林郎中致语口号","author":"史浩","text":"春融绿野日迟迟，五马相从燕喜时。\n湿翠峰前挥玉麈，香梅影底引瑶卮。\n适闻圣主询黄发，将趣文翁上赤墀。\n且趁好天同一醉，陶陶莫问夜何其。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16649,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宴奉使杨御药致语口号","author":"史浩","text":"神圣相承乐太平，尊贤贵老有真情。\n煌煌凤翮飞丹检，赫赫轺车下紫清。\n觞豆交酬当美景，笙竽合乐起新声。\n客星今喜使星聚，乾象森罗彻晓明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16650,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄居庆汪中嘉尚书致语口号","author":"史浩","text":"剩喜群仙集四明，年踰七秩庆耆英。\n三章快遂归田志，八座争看衣锦荣。\n笑捧一卮龟鹤寿，欢腾六乐凤鸾鸣。\n举头莫道长安远，会见临廱拜老更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16651,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饯明守林郎中致语口号","author":"史浩","text":"圣主留神惠兆民，循良奉诏莫辞频。\n才闻五裤喧三辅，又拥双旗镇七闽。\n操袂不须成作恶，举觞方喜上通津。\n日边正拟登黄霸，会见槐庭衮绣新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16652,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"待明州权府提刑虞察院致语口号","author":"史浩","text":"小春才过气纡徐，门外旌麾正塞途。\n剩喜二天临制阃，却来三径访耆儒。\n酒浮沆瀣杯中液，茗瀹枪旗碗面腴。\n且趁良宵拚一醉，赐环行即上亨衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16653,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宴明守高大卿致语口号","author":"史浩","text":"东风昨夜到林塘，千骑初临绿野堂。\n乐里何烦丝竹韵，座间自有雪梅芳。\n民安竟夜户不闭，海静无波帆稳张。\n趁此清平同一醉，金瓯已覆颍川黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16654,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻家中被盗作三颂勉之 其一","author":"史浩","text":"年饶谷拥困群耕，盗贼多从此辈生。\n料得欲偷偷既得，从今改恶不宵行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16655,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻家中被盗作三颂勉之 其二","author":"史浩","text":"几年补破得遮寒，今日空馀赤肉团。\n从此便知元不有，细书词理枉经官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16656,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻家中被盗作三颂勉之 其三","author":"史浩","text":"孟光衣服合山居，烟褐明青休著渠。\n欲得此曹心不动，只将荆布在冠裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16657,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"羽客熊叶二师言归铁柱以五十六言饯之","author":"史浩","text":"喜见洪都二散人，直疑吴许是前身。\n看梅始识林和靖，载酒还寻贺季真。\n铁柱擎天龙已蛰，星坛近斗月为邻。\n思归却有他年约，来庆吾登九十春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16658,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"适过宝奎寿居仁师出示王判院偈真隐老子走笔次韵","author":"史浩","text":"见了黄梅留一宿，此风久矣无人续。\n相逢谁许问寒暄，个中且自龟藏六。\n寿师严冷面如铁，背负真乘腰不折。\n有时禅定出尘表，兀坐蒲团头满雪。\n平生俗物不挂目，终日翻经聊自足。\n不离当处常湛然，波澄倒影千山绿。\n迩来邂逅文中虎，一幅水藤为下语。\n我今欲赞没因由，只把茶瓯对赵州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16659,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次韵胡中方赏丹桂之什","author":"史浩","text":"鄮峰老子双瞳碧，已悟人间空是色。\n群花四季作芳菲，一笑观之如不识。\n有时斗酒沽十千，狂歌烂醉群花前。\n红红白白自妖艳，谁曾着口论媸妍。\n惟闻丹桂藏青茜，清芬正满姮娥殿。\n却思一见无由缘，但写奇标在团扇。\n忽闻移本下吾乡，此愿端知合得偿。\n园工玉斧与换骨，坐使凡种皆天香。\n先皇得之植禁地，饫赏钧天动仙吹。\n高烧凤蜡类星繁，正恐夜深花欲睡。\n于今哀戚遍幽明，鼎湖仙驾超尘氛。\n遗髯注想文王囿，玉阑佳气徒氤氲。\n胡君真材一二数，他日补天慕娲女。\n正欲攀枝效郗诜，会看声名飞海宇。\n雄篇拂地如锵金，俊逸清新洗我心。\n怪底斯人掉头不肯住，明年射策君门去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16660,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访混朴吴尊师","author":"史浩","text":"何年隐四明，与世绝逢迎。\n圣主方虚席，先生不入城。\n风雷随地起，宫殿自天成。\n近喜篮舆稳，宁忧白发生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16661,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠傅得一 其一","author":"史浩","text":"试问此行何所止，乌有乡中无住里。\n醉时不觉醒时痴，世人谁识颠道士。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16662,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠傅得一 其二","author":"史浩","text":"相识三十年，身颠心不颠。\n有人还会得，即是地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16663,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"严光墓","author":"史浩","text":"玉匣蛟龙已草莱，一丘马鬣尚封培。\n云台若也表名姓，千古谁知有钓台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16664,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"东钱湖","author":"史浩","text":"行李萧萧一担秋，浪头始得见渔舟。\n晚烟笼树鸦还集，碧水连天鸥自浮。\n十字港通霞屿寺，二灵山到月波楼。\n于今幸遂归湖愿，长忆当年贺监游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16665,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喻弥陀偈","author":"史浩","text":"搅翻十里西湖水，化作四方八德池。\n净洗众生烦恼垢，人人见自性阿弥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16666,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"唐文若","text":"秋风髣髴吴江渡，鸥鹭参差夕阳影。\n垂虹纳纳卧谯门，雉堞耽耽俯渔艇。\n阳安小儿拍手笑，使君幻出江南景。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16667,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题马麟画","author":"赵构","text":"南望青山满禁闱，晓陪鸳鹭正差池。\n共爱朝来何处雪，蓬莱宫里拂松枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16668,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"幸天长赐僧广宝","author":"赵构","text":"大界宜春赏，禅门不掩关。\n宸游双阙外，僧引百花间。\n车马喧长路，烟云净远山。\n观空复观俗，皇鉴此中閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16669,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题刘松年竹楼说听图","author":"赵构","text":"小书楼下千竿竹，深火炉前一盏灯。\n此处与谁相伴宿，烧丹道士坐禅僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16670,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"赵构","text":"秋江烟暝泊孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16671,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"胡汾","text":"轮中如有物，光外更无空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16672,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"御苑采茶歌十首 其三","author":"熊蕃","text":"共抽灵草报天恩，贡令分明使指尊。\n逻卒日循云堑绕，山灵亦守御园门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16673,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题鹿头关石乡祠","author":"李石","text":"古戍经秋暮，危梯迸野泉。\n鹿头关上庙，骥足县中仙。\n山叠疑无地，江宽欲放天。\n英雄今已矣，自喜惯风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16674,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"一飞居忧题扇赠之","author":"李石","text":"南山雪色老于菟，镜里功名镊鬓须。\n袖裹白巾渠信否，樽前一掷看呼卢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16675,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"唤鱼亭","author":"李石","text":"湖水涵空雪浸崖，老龙以下听差排。\n从今分钵供鱼饼，日与随钟具一斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16676,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古十四首 其六","author":"释师体","text":"早朝心闷三杯酒，午后头昏一椀茶。\n入夜脱衣伸脚睡，五更走起眼眯?。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16677,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自赞","author":"释师体","text":"岁寒节操，水月精神。\n随所住处，无过任真。\n咦，今古江山今古意，一番雨过一番新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16678,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题涪江石鱼","author":"何宪","text":"何年天匠巧磨砻，巨尾横梁了莫穷。\n不是江鱼时隐见，要知田稼岁凶丰。\n四灵效瑞非臣力，一水安行属帝功。\n职课农桑表勤惰，信传三十六鳞中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16679,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松峰庵即席示同年","author":"黄公度","text":"才子连镳俯近坰，霜风散逐马蹄轻。\n芳樽屡约同年会，要路行看异日情。\n境僻却嫌丝管沸，坐阑转觉笑谈清。\n松峰自此宣高价，不使慈恩独擅名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16680,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游虎丘岩偶题壁韵叶因分字联句","author":"余子侯","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16681,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十五","author":"李缜","text":"鶗鴂一声春事空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16682,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其十六","author":"李缜","text":"几回梦作花间蝶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16683,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二十一","author":"李缜","text":"几回醉嚼春风骨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16684,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二十八","author":"李缜","text":"芒鞋远觅香来处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16685,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋兴","author":"员兴宗","text":"商君宁暂驻，日毂不停翻。\n白鸟归何处，黄花又一番。\n异乡曾蝶梦，今日伴鳌山。\n幽事仍关目，岩云相对还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16686,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽喻朝奉","author":"员兴宗","text":"九十老生涯，绯衣落照斜。\n长安三度客，蜀县半庭花。\n饭素匙抄雪，麻头袜带沙。\n秋风空色相，飞入梵王家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16687,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽夔路帅韩徽猷 其一","author":"员兴宗","text":"先声一鹗天，万点蜀山悬。\n天子留英阁，君王问进贤。\n玉书遗二册，金马独三年。\n胄子文书活，花间愧管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16688,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽夔路帅韩徽猷 其二","author":"员兴宗","text":"敌舫浪花翻，瞿塘动暗关。\n君因汉戈甲，守固蜀江山。\n轸域澧渝接，楼船滟滪閒。\n如何宁邑事，不属迩臣删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16689,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽夔路帅韩徽猷 其三","author":"员兴宗","text":"若试迁都策，山东自不灰。\n政刑仍玉雪，议论亦风雷。\n瑞竹双光断，灵襟一梦摧。\n而今夔子国，庙貌日悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16690,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽待制许先生 其一","author":"员兴宗","text":"尚忆西方守，输忠北斗边。\n疲氓千里裕，破灶万家烟。\n桃李不言处，虎狼今满廛。\n传闻澈泉泪，半在蜀南偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16691,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽待制许先生 其二","author":"员兴宗","text":"宣室来何暮，都门价已喧。\n皂囊说二六，白发任三千。\n国老躬为地，群飞哭刺天。\n门扃许见否，真气閟元泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16692,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽待制许先生 其三","author":"员兴宗","text":"卫幕昔年开，西英续续来。\n诸公参牧政，愧我忝书台。\n往事风流尽，于今志念灰。\n侯芭万感集，空抱报恩腮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16693,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭刘夷叔 其一","author":"员兴宗","text":"迥迥江湖兴，乾坤堕渺茫。\n近传行在信，为报故人亡。\n莲社今谁继，诗坛竟不昌。\n无家成句法，伫立泣斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16694,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭刘夷叔 其二","author":"员兴宗","text":"何人言旷远，吾子了希微。\n幸有青云志，如何白骨归。\n空江流蜀恨，哀雁帖云飞。\n若个情亲者，沧洲有愿违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16695,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭黄省元贡 其一","author":"员兴宗","text":"故国地灵处，人文天意深。\n公从扪膝子，句亦掉头吟。\n白雪双歌断，归云无路寻。\n祈招浑简远，我念正愔愔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16696,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哭黄省元贡 其二","author":"员兴宗","text":"惜昔豺狼路，喧卑燕雀群。\n谁欤非楚咻，何者避秦人。\n黄卷中如律，青云断后尘。\n幼安湖海趣，百世不荆榛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16697,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽范通直","author":"员兴宗","text":"羁游不记春，书剑老风尘。\n为问长头事，无踰四乳人。\n青衫经济念，白发苦吟身。\n尚想忠文旧，天涯泪满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16698,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿虞丞相 其一","author":"员兴宗","text":"今年辅相得真儒，和气融融庆历初。\n一柱擎天隆庙社，三边无地著兵车。\n功名入手归谈笑，操略随时自卷舒。\n万岁千秋臣主愿，未饶两纪说中书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16699,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿虞丞相 其二","author":"员兴宗","text":"敬捧仙家九酝觞，试将窥管述铅黄。\n功名采石乾坤大，议论襄城日月长。\n收拾元勋归鼎鼐，扶持公道起膏粱。\n敌人正尔咨年貌，莫放青青鬓染霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16700,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿虞丞相 其三","author":"员兴宗","text":"海上三神绝地维，巨鳌移著剑峰西。\n山高自昔翔鸾凤，人杰于今拔象犀。\n梦说已知箕尾近，生申还与岳嵩齐。\n他年要作封留地，便觉峨眉气象低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16701,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿虞丞相 其四","author":"员兴宗","text":"命圭相印锡元勋，天子龙飞第八春。\n昨夜老人推甲子，明朝宝牒换庚寅。\n壶中日月胚胎久，掌上乾坤把握新。\n二十四年黄閤样，坐看霜雪到松筠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16702,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿虞丞相 其五","author":"员兴宗","text":"中使传声出禁闱，晓庭乌鹊绕檐飞。\n天香暗度金虬暖，诏墨遥迎彩凤归。\n四海每年歌咏满，两宫传贺古今稀。\n殷勤更有南星极，长伴文昌拱太微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16703,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿虞丞相 其六","author":"员兴宗","text":"三边骑火照桃林，髀骨浑惊岁月深。\n衮绣东征非有意，衣冠南渡不甘心。\n人皆稳步金悬印，公为捐躯雪满簪。\n将相勋名千古事，试将全传细推寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16704,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿虞丞相 其七","author":"员兴宗","text":"吐握勤劳只自卑，人希宾退欲归时。\n一编灯火重帘静，万里关河梦枕攲。\n周召成名须保义，萧曹何事尽规随。\n维新造化今将始，鱼跃鸢飞物物宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16705,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿虞丞相 其八","author":"员兴宗","text":"千龄期运到如今，古佛更生愿力深。\n鼎铸万方陶冶地，灯传一点圣贤心。\n全机径度曹溪水，大地同沾傅野霖。\n从此不须忧岁旱，桑麻处处树阴阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16706,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿虞丞相 其九","author":"员兴宗","text":"黄道初开御幄新，山呼动地听丝纶。\n人间喜见新丞相，江上犹呼旧舍人。\n此事十年争屈指，于今四海在洪钧。\n调元别有无边手，付与江山自在春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16707,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿虞丞相 其十","author":"员兴宗","text":"冠裳初集大明宫，祗倚堂堂庙柱雄。\n门外问年惊潞国，阵前克敌记莱公。\n肯穿豹尾趋南极，群向螭头拜下风。\n转物工夫浑不动，折冲端在笑谈中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16708,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿虞丞相 其十一","author":"员兴宗","text":"凌烟漫说古丹青，玉立堂堂耸大庭。\n仗内留班隆体貌，端门扈从看仪形。\n槐阴匝地中书静，榆塞无忧外户扃。\n乞与八荒安稳地，河沙一一是修龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16709,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿虞丞相 其十二","author":"员兴宗","text":"此生恩地更何之，教育偏深未第时。\n举世尽知牛马走，从公看到凤凰池。\n应怜弱质含春浅，岂是阳和变杏迟。\n愿上君臣千万寿，白头东阁赋新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16710,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵送邓祭酒 其一","author":"员兴宗","text":"雪态垂垂鬓两边，官身底事厌蓬旋。\n秋风莼鲙归张子，春草池塘赋惠连。\n诗卷清思出冰玉，扁舟活计任湖天。\n南山得去初心遂，冷笑襄阳孟浩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16711,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵送邓祭酒 其二","author":"员兴宗","text":"欲去未去重湖边，赠公一言公即旋。\n念无三径作陶令，好继七人追少连。\n官路行持荷叶橐，清樽且趁菊花天。\n悬知投老护四印，到处南綦心嗒然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16712,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵送邓祭酒 其三","author":"员兴宗","text":"我家西土官南边，学省愁卧思言旋。\n羡公散吏一龙小，去卜真隐三龟连。\n贤哉复有大夫叹，倦矣羞题刺史天。\n作恼岷峨限牛斗，梦魂相值意翛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]