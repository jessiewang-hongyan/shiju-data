[{"title":"俯江楼","author":"虞俦","text":"异乡王粲懒登楼，肠断淮山落木秋。\n塞上阴云空漠漠，江边艇子故悠悠。\n悲凉只怕闻孤雁，浩荡那堪没白鸥。\n莫怪楚囚频下泪，何人谈话到神州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剧暑出局径归打睡踰月不奉正甫谈绪且顿寒诗盟有诗见问辄次韵谢不敏","author":"虞俦","text":"早归伏日莫踌躇，昼寝从教笑宰予。\n奠枕清风招我老，揽衣阅月向人疏。\n宁无酒共公荣饮，亦有诗成阿买书。\n须待雨凉寻旧约，只今旱火况焚如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自和二首 其二","author":"刘克庄","text":"老子而今两鬓霜，未应痴绝泥禨祥。\n不能木末搴朝露，未免篱边嗅晚香。\n便合折来书卷畔，讵宜簪向宝钗傍。\n漫山千树方芽甲，肯信人间有早芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奚通直挽诗","author":"虞俦","text":"自昔高阳里，尝推月旦评。\n华簪先德齿，朱绂羡恩荣。\n奴岂谋千树，金方笑满籯。\n有孙看鼎贵，钟庆验佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"家书送白额因赋","author":"虞俦","text":"虎踞南山孰敢樵，盗渠名字却深逃。\n谁能雪里穷三窟，缚送尊前慰老饕。\n试唤玉纤揎碧袖，笑看霜片落金刀。\n族庖堪恨无风味，红晕蒸花更藉糟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽水东吴主簿诗","author":"虞俦","text":"当年投笔过淮山，油幕谈兵故不凡。\n老去功名空白发，向来簿领愧青衫。\n龙龛内典超金界，鸿宝遗编付玉函。\n况有诸孙振门户，不须留恨黯松杉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽主簿杨仲远诗","author":"虞俦","text":"居士胸怀壑与丘，琴山怀抱枕清流。\n一区宅好真扬子，万卷书多似邺侯。\n好客亦尝陪俎豆，诸郎殊不废箕裘。\n人间俯仰成千古，痛念吾乡马少游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽仙尉黄公诗","author":"虞俦","text":"平生怀抱欲凌云，元祐名家盖有君。\n况是生儿胜武子，何须不第叹刘蕡。\n伤哉未作河西尉，已矣还空冀北群。\n从此太湖风月夜，一声渔笛不堪闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽吏部石似之 其二","author":"虞俦","text":"忧国囊封岂是疏，有才无命信何如。\n风回册府三山远，星殒郎墙一位虚。\n贾谊自伤终太傅，薛收若在必中书。\n哀哉埋玉今何地，却返当年处士庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽吏部石似之 其一","author":"虞俦","text":"四海声名桂一枝，流年仅及手中蓍。\n康成未免龙蛇厄，翁子宁酬富贵期。\n天上玉楼须好记，人间金谷漫遗诗。\n宦途落寞知音绝，三抚朱弦只自悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽吏部石似之 其三","author":"虞俦","text":"期公簪橐侍甘泉，底是上天不假年。\n才大难为当世用，文高犹有后人传。\n魂销闽檄千山路，泪挽银河七月天。\n会葬谁欤铭郭泰，固应无愧翠珉镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽余丞相 其二","author":"虞俦","text":"暑路驱红旆，天书趣紫泥。\n长沙元忌鵩，太岁又逢鸡。\n挽铎春风咽，铭旌夕照低。\n冠车纷会葬，桃李自成蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽余丞相 其一","author":"虞俦","text":"淑气含公鼎，明时预政机。\n仲山维补衮，文子不胜衣。\n南国恩偏厚，东山志偶违。\n一为天下恸，无以我公归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽吴公祥承事诗 其二","author":"虞俦","text":"昔过高阳里，尝登通德门。\n敢违乡党敬，尚想典刑存。\n乔木萦心曲，空花浥泪痕。\n定应归净土，何必赋招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽吴公祥承事诗 其一","author":"虞俦","text":"故国衣冠后，传家礼法尊。\n击鲜更下舍，容驷闶高门。\n河润金挥橐，风流酒满樽。\n平生阴德事，五世眼中孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽承事汤公诗","author":"虞俦","text":"屋底千金润，尊前一笑真。\n名蓝寻入社，家事岂关身。\n丈室空天女，凌波悼洛神。\n鹿门携手后，还有姓庞人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽范承事诗","author":"虞俦","text":"贝叶神怡处，南柯梦觉时。\n月评依旧好，露挽不堪悲。\n分米谁怀惠，兼金肯拾遗。\n绀莲华发后，见佛想舒眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽俞君任通判诗","author":"虞俦","text":"乡评月旦尚依然，旁郡人称别驾贤。\n邂逅宦途同晚岁，游从太学记当年。\n谁怜冷落堪为地，我欲吹嘘送上天。\n荐墨未乾君已矣，漫凭楚挽慰重泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽奚公彦章承奉诗 其二","author":"虞俦","text":"已识嵇中散，谁惭王浚冲。\n鸿飞嗟目断，鹤化骇群空。\n懒作金门客，宁为铁面翁。\n后园花木在，回首又春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽奚公彦章承奉诗 其一","author":"虞俦","text":"上国曾倾盖，文闱昔盍簪。\n科名终在子，章服果何心。\n朝露悲蒿里，遗风上竹林。\n人琴俱不见，哀挽为沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽都运徽猷陈君诗 其一","author":"虞俦","text":"煮海摅忠论，潢池詟武威。\n分符留惠爱，持节借光辉。\n阀阅伊谁似，功名与愿违。\n未前宣室问，遽作九原归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽都运徽猷陈君诗 其二","author":"虞俦","text":"玉节稽严召，琳宫暂列仙。\n月华方喜见，薤露忽悲缠。\n回首长安日，伤心蜀道天。\n初无封禅议，遗藁总堪传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽崇宪靖王诗 其一","author":"虞俦","text":"袭庆安僖八十春，绵绵仙李更蟠根。\n王封一品身尤贵，位冠三师德愈尊。\n华萼楼边空堕泪，白蘋洲上重销魂。\n哀荣终始公何憾，节钺貂蝉萃一门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽崇宪靖王诗 其二","author":"虞俦","text":"诏书催唤衮衣归，富贵谁知已息机。\n北阙恩荣宁久恋，东山雅志肯相违。\n伤心水月人安在，回首湖山事亦非。\n他日苏公堤畔路，祇愁老泪不胜挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽新安恭荣王诗 其一","author":"虞俦","text":"安僖折派庆源长，宪靖猗兰奕叶芳。\n可但词章誇华白，更馀政事说龚黄。\n两宫密侍清閒燕，三事荣分衮绣光。\n生死哀荣难得似，宸纶一品赠真王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽新安恭荣王诗 其二","author":"虞俦","text":"弁峰苕水挽将归，北第南园自一时。\n过眼浮名真是梦，回头乐事总成悲。\n荆兰膝下同黄壤，鸿雁行中失白眉。\n曾是汝阳门下客，凄凉空咏八哀诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅怀上石似之郎中 其二","author":"虞俦","text":"骚人先自不禁秋，风雨相将作许愁。\n尚有壮怀因酒到，苦无佳思慕诗休。\n故乡音信新来雁，尽日笙歌谁氏楼。\n满目黄花笑憔悴，未应回首没江鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅怀上石似之郎中 其三","author":"虞俦","text":"暮鹊投林意自深，向来一诺抵千金。\n面看逆旆有归色，足望穷途无好音。\n岁晚更怜霜点鬓，夜寒除是月知心。\n政应老死何须惜，或有遗书备访寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅怀上石似之郎中 其一","author":"虞俦","text":"妄意弹冠不作疏，向来曾是曳长裾。\n倚门慈母须微禄，当路群公亦荐书。\n杜曲诗成还蹭蹬，河东赋在有吹嘘。\n上林不敢栖高树，斗水何妨置腐鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓晴","author":"虞俦","text":"屋角勃姑时自唤，篱根络纬竞先鸣。\n刈禾政想赪肩重，扬秕那愁眯目轻。\n考满我应书下下，赈荒人谓策平平。\n回思旧岁民情恶，不但中山有啜羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"真情","author":"虞俦","text":"魏紫姚黄次第荣，政须亲戚话真情。\n楼台是处增诗兴，罗绮丛中放酒行。\n下榻能留黄叔度，高斋端有谢宣城。\n却怜老令卑栖甚，目送归鸿意自倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离都下","author":"虞俦","text":"经年不踏软红尘，偶入修门事事新。\n本为湖山寻旧约，却愁风雨送行人。\n多情黄菊空搔首，无伴芳醪可入唇。\n今岁重阳殊草草，南坡归梦夜来频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"耘老弟五月十三日亲往新亭种竹喜而赋诗","author":"虞俦","text":"移竹应须竹醉时，不妨带笋一时移。\n清阴且障东西日，碧色还分上下池。\n岁晚雪霜成老伴，夜凉风月得新知。\n朅来便有亲亲意，玉立无言似索诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蚊 其二","author":"虞俦","text":"青奴良夜偶相依，斑扇团团亦倦挥。\n我自蒙头还引睡，渠应皤腹不能飞。\n多愁白发三千丈，无分红绡十幅围。\n安得西风来一扫，固知么么未胜威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诸公和诗而菊开主簿沃同年乃有褒拂之语用韵谢之","author":"虞俦","text":"怪底花心转，知从笔力回。\n不嫌嘲我瘦，良是为君开。\n白雪词何有，黄鸡曲漫催。\n待牵重九兴，篱下醉徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读汉老弟中秋前一夕之诗似太凄切辄次韵勉释之","author":"虞俦","text":"秋与诗人著意清，不平宁作候虫鸣。\n閒愁有底能千斛，久雨终当快一晴。\n富贵时来何足道，英雄天亦不徒生。\n来宵径就姮娥约，丹桂当年种已成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读白乐天诗集","author":"虞俦","text":"详观白傅一篇诗，长日何须一局棋。\n字细纵然劳眼力，理长尤是契心期。\n誇张歌酒浑相似，消遣穷愁亦自知。\n大节更思公出处，寥寥千载是吾师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"途中述怀","author":"虞俦","text":"悠然旅酌夜沉沉，漫想歌眉带浅颦。\n兴寄鳞鸿宁有限，诗成珠玉未羞贫。\n尚烦潇洒登山屐，聊慰崎岖穷谷民。\n已笑割鸡非我事，颇尝栖棘有斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"途中得姜总管诗因和韵","author":"虞俦","text":"相知何必旧，我辈正钟情。\n老去难为别，诗来愈觉清。\n舟虚和雪载，水浅过滩平。\n一路俱佳境，收归五字城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成二诗 其一","author":"虞俦","text":"閒处田园好，愁边岁月催。\n事多违壮志，吾亦愧无材。\n有底金千锊，无何酒一杯。\n漫凭诗遣兴，情至却生哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成二诗 其二","author":"虞俦","text":"今夕知何夕，吾年且暮年。\n劳生斫桂斧，游宦逆风船。\n幸不愁婚嫁，何须问计然。\n男儿有门户，温饱故随缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶和万舍人中秋有月无客有酒无殽韵","author":"虞俦","text":"积阴成久雨，浃日掩三辰。\n吏已疲祈祷，天方杀怒嗔。\n但愁云似墨，那顾月如银。\n辜负中秋约，姮娥莫妒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"堂前东偏松棚清荫可爱为赋五言八句","author":"虞俦","text":"问讯苍官旧，掀髯肯见临。\n笑谈驱酷暑，朝夕托清阴。\n便引夷风至，宁容盾日侵。\n北窗高卧处，靖节是知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿临安童县尉庵童尉送酒","author":"虞俦","text":"深深松竹隐禅房，更渡溪桥暂解装。\n但喜还家无数日，不知行路过重阳。\n白衣送酒劳相问，黄菊依人未肯芳。\n珍重山僧能会意，殷勤扫榻为烧香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿祠山报恩寺枕上闻杜鹃有感","author":"虞俦","text":"此去家山仅两程，不烦鸟语苦丁宁。\n烟花三月忙中过，风雨连宵梦里听。\n问雁呼卿情大薄，闻鸡起舞意还醒。\n年来纵迹浑无定，渠亦相怜水上萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿巢县地藏寺枕上偶成","author":"虞俦","text":"年来踪迹漫奔波，其奈功名有命何。\n画虎向人无好手，饭牛怜我有悲歌。\n丹心永夜灯前苦，白发明朝镜里多。\n却谢前村鸡唱好，呼儿起舞肯蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄同年林子长郎中","author":"虞俦","text":"功名虽结少年场，看镜空惊两鬓苍。\n我已青冥甘蹭蹬，君今列宿倍辉光。\n寸心祇自怀三径，尺素何妨枉一行。\n多谢南宫故人报，日边消息想能详。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得旨与郡归自浙东余成卿王贯之叶德远追送至于震泽舟中款语数日而后别","author":"虞俦","text":"怀抱连宵得好开，莫愁波浪与尘埃。\n中年已是难离别，此地何妨数往来。\n送我扁舟宁作远，唤人归鸟苦相催。\n邈然后会知何处，更欲临分把一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"据案偶得数语录呈簿尉","author":"虞俦","text":"昔年官冷欲无毡，制锦如今又不然。\n老去几遭官长骂，书来却有故人怜。\n敢期翠羽还池上，渐喜黄衣减目前。\n欲学催科无奈拙，直须天假一丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚花","author":"虞俦","text":"花开春已去，春在此中藏。\n可恨芳菲晚，翻令气味长。\n繁阴供翠幄，轻暑绚红妆。\n莫起后时叹，时来未遽央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮西赵漕子固挽诗 其二","author":"虞俦","text":"西帅予曾忝，无何马首东。\n计台初不远，交篆竟成空。\n夜壑移舟半，淮山落木中。\n堂堂宁复见，丹旐猎霜风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮西赵漕子固挽诗 其一","author":"虞俦","text":"疏抗廷臣右，经传弟子行。\n江淮归德政，蛮貊诵文章。\n世路风波恶，仙家日月长。\n西林曾有约，楚挽莫凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清平阁","author":"虞俦","text":"律身端合励冰清，莅政尤须称物平。\n知是夫君深寓意，雅宜斯阁遂安名。\n池幽自足龟鱼乐，林静休教虫鸟鸣。\n况复官閒州似斗，不妨时此濯尘缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明","author":"虞俦","text":"江南三月暮春天，上巳清明五日前。\n红杏园林初过雨，绿杨庭院欲生烟。\n无花无酒伤今日，宜麦宜蚕胜去年。\n却怪山中时候早，树林深处有鸣蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"移守吴门酌别姜总管","author":"虞俦","text":"宦游踪迹一浮萍，末路从公盖已倾。\n方喜溪山来入社，忽惊弦管作离声。\n河梁恋恋看云别，剡棹看看载雪行。\n从此江东还渭北，莫因契阔负诗盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"章枢密挽诗 其一","author":"虞俦","text":"当年抗疏动宸旒，骑省乌台许遍游。\n稳稳枢庭方缓步，骎骎揆路却回头。\n空馀荣锦开三径，犹有甘棠蔽两州。\n浮世功名俱一梦，不须夜壑怪移舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"章枢密挽诗 其二","author":"虞俦","text":"引年归老十星霜，养素遗荣道愈光。\n可但苍生思谢傅，未应白首愧冯唐。\n龙光方庆千龄遇，凤诰俄嗟一鉴亡。\n前辈风流磨灭尽，后生无复见堂堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"章解元挽诗","author":"虞俦","text":"诗礼传家旧，田园晚岁丰。\n月评犹未改，露挽遽成空。\n曲巷连桑荫，幽岩长桂丛。\n南坡吾独往，无复访邻翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"脚婆子 其一","author":"虞俦","text":"百沸催汤沃，孤灯迫睡昏。\n复皤馀豕涨，足蹜但鸱蹲。\n一衲包缠密，重衾底里温。\n穷冬为老伴，永夜得深论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"脚婆子 其二","author":"虞俦","text":"著瓦霜威重，侵窗月色昏。\n相依纸帐梦，犹胜火炉蹲。\n伸脚三更稳，回头一笑温。\n温柔非老事，付与少年论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"脚婆子","author":"虞俦","text":"此姥原无妒与嗔，平生气类竹夫人。\n蛾眉渐遣温柔梦，鸱腹犹疑见在身。\n包裹形模才一衲，薰蒸汤沸稳相亲。\n承恩脚底非由貌，启沃怜侬夜夜新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪后过南坡 其一","author":"虞俦","text":"南坡千树总琼瑶，走马来看及未消。\n短鬓风前愁素领，衰颜酒后借红潮。\n松饶苍鬣犹能奋，梅耿香魔苦费招。\n此景此时无我共，新诗吟罢独长谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪后过南坡 其二","author":"虞俦","text":"扶桑暖翅接金乌，韝上饥鹰待一呼。\n悬滴梅梢珠璀璨，堕花桧顶粉模糊。\n明年翠浪麦须好，何处青帘酒可酤。\n万里江山谁画得，天开新样雪晴图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪晴后书怀 其一","author":"虞俦","text":"烂银白璧遣谁收，米尽家家典破裘。\n应为溪桥添晓溜，岂怜野渡有横舟。\n侵凌蓬鬓霜千丈，浮动梅梢月一钩。\n岁晚风光天必相，未甘亭上话三休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪晴后书怀 其二","author":"虞俦","text":"明堂杞梓必兼收，未信英雄老一裘。\n彭泽不妨聊束带，巴东何事叹孤舟。\n会须取印大如斗，宁羡封侯曲似钩。\n咄咄那庸如许事，尊前且食蛤蜊休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":26654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]