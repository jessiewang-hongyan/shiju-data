[{"title":"闲居 其一","author":"吕本中","text":"湿云一片傍门垂，秋草盈庭绿未辞。\n剥啄无声诗思懒，竹床方枕梦回迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲居 其二","author":"吕本中","text":"绵绵风雨雨鸠催，衰柳朦胧玉作堆。\n不道陶公秫未熟，烟波一片欲飞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲居 其三","author":"吕本中","text":"新添涨非碧天空，拄杖斜衣红蓼中。\n角瓮何须犹倔强，桔槔南陌正秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲居 其四","author":"吕本中","text":"荆扉寂寞锁花枝，攲枕闲追方外知。\n一缕茶烟新水足，半帘宿雨燕飞迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲居 其五","author":"吕本中","text":"阴晴未定两相催，夜半蛩声送晚雷。\n可怜野人无底事，阶前新看绣莓苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲居 其六","author":"吕本中","text":"秋原尽好放游筇，何事山斋任懒慵。\n屋漏有痕留作字，梧桐带雨听笙镛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13219,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲居 其七","author":"吕本中","text":"西风岑寂子云居，未放秋阳晒腹书。\n却笑问字谁载酒，雨烟仍是老樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13220,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜晴","author":"吕本中","text":"经旬阴雨水沧浪，烟锁岩扉游骑荒。\n赤日才来异宿昔，青山看去倍寻常。\n秋林腰斧歌共醉，春市担鱼粟满囊。\n野老新新兴未艾，风云役使不胜狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13221,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏郭西鱼池","author":"吕本中","text":"烟艇江湖网罟疏，石矶风雨钓纶虚。\n碧池漫凿方通径，鳞沼聊巡供别储。\n诗客兴来堪佐酒，野人梦去却多鱼。\n鸱夷闻道曾兴越，经济还馀千倍渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13222,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"采菱词","author":"吕本中","text":"浩瀚湖光淹北皋，柳弯翠满敢辞劳。\n青菰出水犹佳蔌，紫芰循溪作沚毛。\n楚水嗜奇闻辨论，辋川灯火正风骚。\n何当采掇秋光里，游嬉吴姬荡小舠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13223,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古意","author":"吕本中","text":"茂陵消渴远山眉，那得闲情到绿丝。\n一曲白头吟未了，回文字字起新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13224,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒梅","author":"吕本中","text":"一树寒梅曲槛东，含葩未吐蕊头红。\n霜枝不许游人看，蓦地吹来栗烈风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13225,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渡莺湖至溪上即事 其一","author":"吕本中","text":"宿雾重阴傍晚桴，日斜风定渡莺湖。\n陂塘浩淼水光阔，烟寺中流岛屿孤。\n满眼波涛迷客泛，一行雁影带云徂。\n到来荒舍未岑寂，寒树依依闹晚乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13226,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渡莺湖至溪上即事 其二","author":"吕本中","text":"络绎萧萧遍里门，支机嘉事自天孙。\n七襄晓织怜花谱，百室春梭餍夕餐。\n谁检吴绫俭岁月，犹飞楚縠照军屯。\n掺掺女手还持作，佳丽江南第一论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13227,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渡莺湖至溪上即事 其三","author":"吕本中","text":"湖水安澜似镜明，昔年曾向镜中行。\n侵晨浥露来花市，落日流风倚醉楹。\n俯仰繁华馀暮色，萧条高寄但秋声。\n应知节序犹迁转，抚剑如何教未平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13228,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄远曲","author":"吕本中","text":"相送江边远客船，孤帆一道寸心悬。\n日南珠价知多少，不及闺中珠泪圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13229,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"觐竺闺女","author":"吕本中","text":"澹妆素抹旧罗衣，雅致天姿觐竺归。\n始信若耶溪畔女，何须珠翠馆娃妃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13230,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏夜宿乳窦峰","author":"吕本中","text":"峭壁凌空霭气浮，山泉滴茗暗香流。\n炎云不到冰心静，好向峰前一簟秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13231,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游石笋庵","author":"吕本中","text":"石笋殊峰精舍幽，瘦筇踏向碧云游。\n天然青茁层崖里，玉版参来点石头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13232,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"望远","author":"吕本中","text":"上林燕不飞，朔云无消息。\n天山应云霏，吴苑草碧色。\n断肠人不知，耿耿多思忆。\n当年惜繁华，绿琴悔不理。\n于今霜露归，徘徊明月里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13233,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月夜闲步闻笛","author":"吕本中","text":"挑灯读易后，乘月到溪前。\n野犬声如豹，秋虫吟似禅。\n光寒人意静，影澹物情妍。\n更闻村笛远，幽意曲中传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13234,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"长啸夜泊","author":"吕本中","text":"春烟失晚树，柔橹翠峰湄。\n野径寻山暗，舣舟问路岐。\n敲诗吟人瓮，点字墨池前。\n把酒怀前哲，萧条一夕思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13235,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金丝桃","author":"吕本中","text":"菲菲红紫送春去，独自黄葩夏日闲。\n那得文仙归故园，黄冠相向到邱山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13236,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昭君怨","author":"吕本中","text":"延寿无金翠钿销，铜丸擿鼓晚来朝。\n宁为龙塞青青草，不作昭阳细细腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13237,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"采莲曲","author":"吕本中","text":"芳时并采曾莲舟，一段相思水缓流。\n憎杀回风无意绪，解侬锦缆转船头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13238,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山园即事","author":"吕本中","text":"翠峰窝里挂青黄，水市逡巡到野航。\n带雨锄耘碧萼浅，临风采摘绿枝长。\n分甘送客怜秋实，辟谷仙家嗜果香。\n闻道龙阳千匹绢，何如山圃四时芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13239,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜雨分中韵","author":"吕本中","text":"风凄漏永暗银河，滴响空阶碎玉壶。\n无那骚心思纷坠，且教高咏和寒梧。\n闲心欲寄云中鹤，逸兴旋怀江上鲈。\n莫使扶摇不可即，他年惆怅旧时粗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13240,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"华林书堂漫兴","author":"吕本中","text":"两树疏梅草阁前，一池晴日画桥穿。\n论文欲饮先民笔，读史常期循吏贤。\n携酒闲望野陌间，吟柳外来采桑篇。\n应怜百里平芜寂，漫使寒山片石传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13241,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晨兴","author":"吕本中","text":"书闱静若隐，钟到揽衣迟。\n花睡犹含露，莺歌方踏枝。\n耘苔开曲径，考古韵新诗。\n谁识晨兴意，西山爽气时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13242,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏咏庭前萱草","author":"吕本中","text":"传说亡忧树后屏，谁教却种在前亭。\n想因白发愁千斛，故遣芳阶绿一庭。\n青柎几时将碧草，丹心有日恐飘萍。\n更怜共道慈亲号，绕砌还须雨露荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13243,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立冬日赠张直夫","author":"吕本中","text":"参差寒叶树，林鸟独依栖。\n发变心同素，年迟日向西。\n一水通晨夕，三山隔海溪。\n尚忆鲁儒席，南楼携手齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13244,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清明游震泽即事","author":"吕本中","text":"挈伴提壶桃柳芳，东风暂醉少年场。\n波浮十里飞舸疾，衣影千重夹道光。\n使气可如燕赵士，轻兵原是楚吴乡。\n应知万事同棋局，鼓角春江一日狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13245,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"吕本中","text":"昔者同升夫子堂，如今俱是鬓苍浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13246,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"吕本中","text":"山中露冷草木瘦，江上月寒蒲柳秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13247,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其五","author":"吕本中","text":"不用君王羯鼓敲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13248,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其六","author":"吕本中","text":"老大多材，十年坚坐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13249,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和陆元钧颂四首 其一","author":"释惟照","text":"芙蓉已入双林寂，挂角羚羊无气息。\n立关拔转异中来，借问时人何处觅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13250,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和陆元钧颂四首 其二","author":"释惟照","text":"山谷今传佛祖衣，一回拈起一回疑。\n丰干饶舌可知也，引得寒山不肯归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13251,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和陆元钧颂四首 其三","author":"释惟照","text":"千里客来何所遇，一念超然无去住。\n全身放下火中莲，谁能更为无生路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13252,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和陆元钧颂四首 其四","author":"释惟照","text":"夜堂人静雨霏霏，润泽焦枯总不知。\n堪笑当年净名老，对文殊语恰如痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13253,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古五首 其一","author":"释惟照","text":"缩水酒越浓，负心人越穷。\n铁刚刀自利，不用苦磨砻。\n草鞋头戴今何在，我见牵来劈面舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13254,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古五首 其二","author":"释惟照","text":"小树子，傍山栽，华从叶里开。\n枝高攀不得，和树折将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13255,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古五首 其三","author":"释惟照","text":"梨华一枝春带雨，金色头陀笑不语。\n龙宫海藏月明前，织女姮娥相对舞。\n笑者笑，舞者舞。\n十方无虚空，大地无寸土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13256,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古五首 其四","author":"释惟照","text":"千尺丝轮直下垂，一波才动万波随。\n江上晚来堪画处，渔人披得一蓑归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13257,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古五首 其五","author":"释惟照","text":"斋时一钵饭，饭后一觉睡。\n睡起去放尿，洗手成变异。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13258,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自赞","author":"释惟照","text":"自小来打硬，佛祖不奈何。\n放藞苴住院，殃害杀禅和。\n道行阐提道，歌唱阐提歌。\n欢喜入地狱，谁管你阎罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13259,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和陆德先尚书歌","author":"释惟照","text":"大道坦然兮殊不用功，殊不用功兮何必研穷。\n豁虚离碍兮从空背空，不守自性兮虽同不同。\n百无所依兮自西自东，照体独立兮满目清风。\n廓落大度兮无不包容，全身异类兮触处皆通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13260,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"劝徒铭","author":"释惟照","text":"身心无拘，动寂无知。\n如大死人，无倚无依。\n无拘者宽，无知者安。\n无内无外，无定无观。\n无适无莫，无造无作。\n无去无来，无好无恶。\n一道清虚，万法如如。\n愚极成智，智极成愚。\n超诸数量，孰云比况。\n净尽不留，无法可尚。\n识不可识，智不可知。\n谁家之子，兀然巍巍。\n巍巍不存，根尘颖脱。\n如憨如痴，落落魄魄。\n不惜口业，为了说破。\n笑杀阇梨，山僧罪过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13261,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古六首 其一","author":"释惟照","text":"拂拭瑶琴月下弹，调高雪曲和还难。\n五侯费尽平生志，从此诗书懒更看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13262,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古六首 其二","author":"释惟照","text":"一口吸尽西江水，鹧鸪啼在深花里。\n自有知音笑点头，其来不入聋人耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13263,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古六首 其三","author":"释惟照","text":"甜瓜彻蒂甜，苦瓠连根苦。\n拈起枕子时，新罗夜打鼓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13264,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古六首 其四","author":"释惟照","text":"烟尘扫荡将军令，正敕流行宣德音。\n公子只知歌既醉，夜深还被活生擒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13265,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古六首 其五","author":"释惟照","text":"枯木堂中第一人，坐观成败枉精神。\n可怜明一色边事，直至而今没眼筋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13266,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古六首 其六","author":"释惟照","text":"黯黯云攒覆雪峰，青青赵老一双瞳。\n从前汗马无人识，只要重论盖代功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13267,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登齐云楼","author":"章宪","text":"飞楼缥缈瞰吴邦，表里江湖自一方。\n曲槛高窗云细薄，落霞孤鹜水苍茫。\n固知兴废因时有，独觉江山共古长。\n回首中原正愁思，不堪残日半规黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13268,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漫庄","author":"章宪","text":"何许明人眼，松间见古堂。\n泉声到棐几几，山影覆绳床。\n爱酒陶元亮，听蛙孔德璋。\n纷战蛮触，丘壑信难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13269,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"复轩歌","author":"章宪","text":"洞视兮八荒，了无物兮往无旁。\n往古来今兮无际，起复代谢兮不失吾常。\n复乎，复乎。\n吾所寓兮广莫之野，而无何有之乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13270,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清旷堂","author":"章宪","text":"吾慕仲公理，卜居乐清旷。\n兹焉惬吾愿，名堂以自况。\n我无适俗韵，且乏肉食相。\n何许寄吾生，栖迟翳穷巷。\n境幽有经行，心远无得丧。\n从容大化中，信是羲皇上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13271,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"永归亭","author":"章宪","text":"吾慕曾夫子，舍瑟言所志。\n所志则非邦，独契圣者意。\n暮春春服成，从我才一二。\n风乎林岫间，所乐有馀味。\n邈兮千载上，神交得冥契。\n当知结驷非，不易穷阎是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13272,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清閟亭","author":"章宪","text":"吾慕韩昌黎，文章妙百世。\n体物语尤工，赋竹誇清閟。\n唯我独好之，则亦有深意。\n虚中可受道，贯时无险易。\n复苦魏文贞，直节而妩媚。\n伊馀清閟中，赏玩有遗味。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13273,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遐观亭","author":"章宪","text":"吾慕陶靖节，处约而平宽。\n涉园自成趣，矫首复遐观。\n我亦散游目，俛仰天地间。\n云烟自舒卷，湖岭相回环。\n永与形役谢，岂有俗虑干。\n想像斜川游，千载乃相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13274,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松江谒王文孺令宰","author":"章宪","text":"暑退凉生过雨天，凫飞鹭浴暮江前。\n秋风小浪鸭头水，斜日轻帆燕尾船。\n青眼却欣逢地主，白头相对耸诗肩。\n林塘胜处开樽俎，只欠冰轮特地圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13275,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚泊松江","author":"章宪","text":"长堤牵百丈，舴艋溯清漪。\n山与残霞暝，水将秋色宜。\n江寒征雁度，天远暮帆迟。\n剩欲浮家去，烟波学子皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13276,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽著作王先生蘋 其一","author":"章宪","text":"伊洛流风在，丘轲道德尊。\n遗经启幽眇，后学有渊源。\n钻仰知由户，衰迟阻及门。\n三年思晬面，一旦绝微言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13277,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽著作王先生蘋 其二","author":"章宪","text":"行义时逢可，泽民事却睽。\n斯文犹有寄，俗学岂终迷。\n不复等三鳣，空闻见白鸡。\n诛茅方槜李，卜葬已苕溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13278,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽著作王先生蘋 其三","author":"章宪","text":"西观才黔突，题舆却佐州。\n济时卑管晏，赍志在春秋。\n暧暧孤云没，沈沈厚夜幽。\n升堂闻礼乐，终觉愧程仇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13279,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"赵相","text":"夕阳绿涧明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13280,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春晚","author":"李怤","text":"花瘦烟羸可奈何，不关渠事鸟声和。\n无人扫地惊残梦，分付轻红上碧莎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13281,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"李怤","text":"去国春城桃李花，枫林叶病尚天涯。\n今年九日风前帽，北客南舟雨后沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13282,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"李怤","text":"苍黄避地小儿女，漂泊连床老弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13283,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渔父","author":"方丰之","text":"已携巨鲤换新粳，尚有鲦鯈得自烹。\n闻道烹鲜易烦碎，呼儿勿用苦为羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13284,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"历崎道中","author":"方丰之","text":"漠漠春阳接海低，濛濛晚雨傍山飞。\n半敧古埭无人过，时有村童护鸭归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13285,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绝句","author":"方丰之","text":"舍人早定江西派，句法须将活处参。\n参取陵阳正法眼，寒花承露落毵毵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13286,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"方丰之","text":"天女终降大居士，登伽惟挠小乘禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13287,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]