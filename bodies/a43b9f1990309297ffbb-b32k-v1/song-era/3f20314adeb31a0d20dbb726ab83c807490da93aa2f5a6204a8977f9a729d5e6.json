[{"title":"次韵济道见寄 其二","author":"吕南公","text":"追送城东但立谈，当时惜别恨騑骖。\n一封消息难频到，千里倾思只坐谙。\n知有才谋当奋发，岂于州县却悲惭。\n为文尚喜多馀暇，寄我新诗似渭南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过庄子祠堂","author":"吕南公","text":"客过蒙城日欲曛，更寻祠馆拜遗真。\n文章昔已悲衰世，香火今谁望俗人。\n诸子异端争土苴，千秋馀乱见缘因。\n祗应叔夜轻狂辈，未是先生入室宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉寄芜湖征局都曹","author":"吕南公","text":"不见铜陵唱和翁，相望三度叹秋风。\n商量难得樽罍共，存问空烦简札通。\n驴上阆仙邀苦思，草中田子建微功。\n明年官满当携手，未定韩郎耳便聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梳头见白发","author":"吕南公","text":"未老先斑岂自由，可怜蒲柳易惊秋。\n不缘迁染应非俗，若有梯媒必是愁。\n老虱纵嫌相间别，素丝何害共风流。\n尘劳兴味吾谙尽，肯似豪人讳白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄九游河州","author":"吕南公","text":"黄河东背贺兰山，回望尘沙万里宽。\n土地久传戎种姓，人民还笑汉衣冠。\n军中意气谁先得，史上功名我惯看。\n何日归来谈将略，转吾愁面入忻欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六月二十七日醉书普安院壁","author":"吕南公","text":"酉寻行甫戌已见，夜候显翁朝乃来。\n隔树鸣蝉休聒耳，满樽浮蚁且衔杯。\n多忧莫道无由解，一醉从初不用催。\n传语群书未乖间，只今相忆尚须回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题河源诸兄壁","author":"吕南公","text":"不见诸兄十载稀，重来问事只伤悲。\n一家未有中兴地，两地皆成永感时。\n道在莫亏清白业，力微空赋鹡鸰诗。\n吾门旧庆天如报，会向层霄得桂枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将离东洲书社留题屋壁","author":"吕南公","text":"偶向林间寄病躯，七看圆缺印蟾蜍。\n何言雾隐南山豹，只得人怜涸辙鱼。\n衮衮光阴添一梦，劳劳精干落群书。\n扬雄若有閒名在，此地曾经寂寞居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将归南城书内乐堂壁","author":"吕南公","text":"野客辞乡道转孤，祗于愁上进工夫。\n乞衣借食亏豪气，弄笔翻书滞壮图。\n三径未成真隐约，五穷争现主人迂。\n南归漫过庚桑国，不得留参鞅掌徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"己酉岁归省松楸过武陵翁所居留书屋壁","author":"吕南公","text":"千里归来尽苦辛，见君依旧自由身。\n始知绝学无文者，胜却翻书弄笔人。\n案上方经閒白日，门前车马漫红尘。\n半轩风竹一樽酒，冷笑世途争富贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆西村","author":"吕南公","text":"东冈西下古墩头，草木风烟事事幽。\n畦垄弯环延果菜，笭箵参互献鱼鳅。\n常开夜户誇无寇，竞拨香醅贺有秋。\n愿定此居犹未得，岂堪侥倖望公侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钟南平祠像","author":"吕南公","text":"天禄空虚土运崩，匹夫徒手起欃枪。\n还将有限骁雄力，换得无穷跋扈名。\n已是用心贪祸乱，尚何颜面见升平。\n丹青此日凝埃色，尚似忧惭问罪兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄黄梦授机宜","author":"吕南公","text":"少年秋赋险横飞，晚去从军脱布衣。\n只见乡评推孝行，岂知俗效在兵机。\n黄云古渭边烽断，春草临洮战马肥。\n了取功名上麟阁，莫因昼锦苦思归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得唐彦回篇再寄","author":"吕南公","text":"手把封题又惨然，坐惊新句俊翩翩。\n穷通可是俱关命，聚散由来亦系天。\n此日未逃衰俗口，几时真及古人肩。\n一樽酩酊难频共，况望青绫被底眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻唐彦君益作计相过先以此寄用前韵","author":"吕南公","text":"见说东征计决然，梦魂迎马去翩翩。\n遥怜迢递荒村路，幸对温和此日天。\n意厚但青贫友眼，装轻肯赤仆夫肩。\n书编酒盏蒲团坐，预拟中宵未放眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"缄题道先诗句尚多未和酬者因书短律奉寄","author":"吕南公","text":"已作醉乡贫户限，更逢诗匠恶穿裁。\n王弘一酎何曾送，崔立千篇不住来。\n枕上精神难托梦，床头卷轴易成堆。\n贺兰溪上如归去，省得衰翁合勺才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄邓师厚二首 其一","author":"吕南公","text":"茅屋分携但偶然，蟾光今已十回圆。\n自存交分长长在，不用音书叠叠传。\n无术入时犹是命，有身多病岂非天。\n倦游已作南归计，只待槐梢沸早蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄邓师厚二首 其二","author":"吕南公","text":"庾岭前头梅散漫，灊山东下水漼溰。\n二年时节俱为客，千里家山各未归。\n俛睫游从真丑谬，方头言论易乖违。\n人间胜事知多少，专把凄凉属布衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金陵寄示亨父","author":"吕南公","text":"东游西上但差参，寒饿催躯失本心。\n多难有言悲运命，厌贫无意惜光阴。\n穷通未定功名主，疾病能将少壮侵。\n故国渔樵应可入，寄声先为问云林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄亨父","author":"吕南公","text":"当年勇慕古人风，坎壈无由到泽宫。\n力命不容相斗竞，光阴从此便和同。\n身如孟氏兼三乐，家似昌黎厌五穷。\n莫为明时颇惆怅，著书亦是济时功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再寄亨父","author":"吕南公","text":"匹马辞家腊雪初，二年名姓入铨书。\n熊罴帅府招韩愈，邑里经筵失仲舒。\n稳把声荣收雨露，冷看交旧厌沟渠。\n蓝衣定有誇乡日，为到耕村问溺沮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉寄子发 其一","author":"吕南公","text":"春雷动地竹牙生，社雨淋冈蕨臂擎。\n田野杯盘容我饱，牛羊鼎俎为谁荣。\n能无智虑随天转，未有工夫与俗争。\n苦忆南园江健令，解于忙处用閒情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉寄子发 其二","author":"吕南公","text":"解于忙处用閒情，绝口多财与美名。\n剥啄至门方就枕，毕逋归树却催耕。\n烧香事佛人俱佞，曳屣歌诗我亦清。\n笋蕨又芳春酒冽，相思何计可同倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏题白鹤观","author":"吕南公","text":"辽海沈沈信息稀，苍松枯尽草侵扉。\n楼台有字知年岁，城郭无人辨是非。\n像座风轻蛛作网，醮坛春老藓成围。\n道翁久蓄瑶琴意，莫为閒名取次挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南丰道中口占","author":"吕南公","text":"冷雨迷濛懒举头，望中恐得故乡愁。\n梅经旧腊香犹在，水被东风冻已收。\n鸟喜春和纷格磔，马嫌泥滑转夷犹。\n人生祇有安居好，可奈安居不易求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野菜","author":"吕南公","text":"采采新英出远冈，生香不断冷垂浆。\n地神手老皮先紫，山鬼肠饥色更苍。\n野馔自宜清品味，世情谁识淡馨香。\n旧林春草盘飧惯，忆共邻翁踞坐尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋堂","author":"吕南公","text":"秋堂灯烛夜辉辉，照我书边泪湿衣。\n何术更堪图惬快，平生已是足乖违。\n悠悠客路和愁往，杳杳青山借梦归。\n虫响风鸣俱有恨，惊残二十七年非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过列岫轩辄题小诗","author":"吕南公","text":"槛前清沼一奁披，墙外横山百马肥。\n长使座中知爽气，岂烦天际问脩眉。\n留宾出酒人皆喜，不语看云众未知。\n饶借俗儒谭尔雅，主公偏重谢家诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠叔宪","author":"吕南公","text":"轩昂不肯事雕锼，放却名缰已十秋。\n举世有为皆负累，百年无闷更何求。\n长驱好意归吟笔，笑领真风贮酒瓯。\n嫌我生涯非濩落，纸编寒夜困灯油。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠王九","author":"吕南公","text":"李杜是非张相国，曹刘忌惮吕将军。\n异时各有凌人气，此日何妨负我文。\n议谕当如山顶石，光荣会似雨馀云。\n恨君不悔邯郸步，希世功夫枉十分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尘土","author":"吕南公","text":"尘土营营自满城，此间赏望四时清。\n朝看云树吟天末，夜对溪光醉月明。\n只见渔樵真气象，岂知廛市细纷争。\n座中更挂庸儿榻，未识冰壶有旧名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道卿上人新作塔亭准拟寿终乞余题诗","author":"吕南公","text":"道人八十转康宁，却效浮屠起竁亭。\n日月无穷终系数，乾坤有坏亦因形。\n未张云鹤萧萧影，先养松楸郁郁青。\n究竟会应逢逸少，为师重勒雁门铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄观上人","author":"吕南公","text":"袈裟初带帝城尘，便咏南陔望白云。\n贾岛未为穷主簿，汤休何事小参军。\n古书似我閒千卷，山酒从谁尽十分。\n正是诸生薄韩柳，劝师绝口莫言文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄上山阳太守屯田","author":"吕南公","text":"故国无田只一瓢，儒冠相误感萍漂。\n虞翻骨相终迍滞，许劭题评漫借饶。\n已养道心忘贵贱，故应荣分任渔樵。\n文章解颂贤人业，更坐看君立九霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"献翰林太守","author":"吕南公","text":"欲辞铃阁重徘徊，世路无人计实材。\n宾榻少因高士下，醴樽多向俗儒开。\n孤踪此日叨馀论，直笔他年倚上台。\n召节不迟天陛远，辍耕朝夕为公来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和酬道先高秋见寄之句","author":"吕南公","text":"眼看金菊木芙蓉，想见严城此景同。\n儒术凋零归故纸，岁华催趁入衰翁。\n千秋治乱三钟酒，万里关河一亩宫。\n南鹞北鹰方得志，更谁迂阔问哀鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚出寿春","author":"吕南公","text":"马足迟迟破晓霜，朔风迎袖过川梁。\n帘栊几处迷醒魄，烟霭满空含曙光。\n已是途程规进取，可能怀抱似鸿荒。\n平沙莽莽兵戈地，却为千秋起吊伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书斋春日","author":"吕南公","text":"花困蜂莺柳困风，年年春恨渺无穷。\n已添病格忧诗债，未破愁城忆酒功。\n日月正居劳苦上，山川长在梦魂中。\n游鞍赏席今多少，想见浓阴替乱红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和酬李宣德二首 其一","author":"吕南公","text":"销閒堂上日何思，或弄鸣琴或赋诗。\n声正只传心静处，篇成不待烛残时。\n隆中有客吟梁甫，洛下无人说克儿。\n此日馀音到逋客，定如医药蓄青芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和酬李宣德二首 其二","author":"吕南公","text":"临邛大邑少鸿生，初敬多辞马长卿。\n几许分财来涤器，不如收迹去躬耕。\n生前遇主无高位，死后遗文有盛名。\n毕竟负他贤令意，被人传说是闲情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵辉卿感春 其一","author":"吕南公","text":"日日春阴共惨然，愁怀不称艳阳天。\n已从鲁酒迷醒枕，更向瑶琴怯武弦。\n往事自惊千里梦，胜游谁犯五更烟。\n因君解道花如锦，始为芳菲忆去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵辉卿感春 其二","author":"吕南公","text":"欲写春愁上粉笺，只凝幽思恨遥天。\n尘埃漫蠹霞书字，日月终亏锦瑟弦。\n夜听子规攲醉枕，晓看新燕立疏烟。\n冷灰残烛相遭惯，触拨东风不记年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵辉卿感春 其三","author":"吕南公","text":"闻说群芳初满园，未能寻赏恨参天。\n风豪雨横伤莺蝶，酒冷诗荒负管弦。\n屐齿有时临藓径，马头何日破晴烟。\n谁何赠我宽怀语，每道新年似旧年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熙宁六年再至邓氏北轩感而书壁","author":"吕南公","text":"窗扉暮阖晓还开，乞食寒儒去复来。\n土木不妨人冷落，诗书能使客低徊。\n言如鹦鹉今徒尔，宿似夫不亦得哉。\n但识浮生皆寄托，莫从河汉论涓埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄从义法曹教授","author":"吕南公","text":"军学先生骨气清，每嫌杯酒乱襟灵。\n讥排只是攻三雅，熟烂除非是六经。\n榴榼日虚尘拂拂，兔毫宵运烛荧荧。\n俸钱添得真何用，好赠荥阳买绿醽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉酬范十七见寄二首 其一","author":"吕南公","text":"接人坐语送人行，两饭逡巡晚鼓鸣。\n遇社有何欢次第，过春多是病心情。\n消磨白日无云补，计算流年但暗惊。\n苦雨寂寥还一醉，梦魂依旧背严城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉酬范十七见寄二首 其二","author":"吕南公","text":"一纸新诗入北城，起予聊复醉魂惊。\n低心苦淡吾徒事，转眼炎凉此世情。\n六月未须论止息，三年方看大飞鸣。\n锱铢社肉休过问，幸有鳅蔬且烂羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和 其一","author":"吕南公","text":"浮桁门外树如城，归路迢迢梦易惊。\n嗟我衰迟从旅食，感君存问有诗情。\n牡丹不在儒宫种，杜宇偏当静夜鸣。\n劳费主公怜苦淡，驼蹄时劝一杯羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和 其二","author":"吕南公","text":"几欲相寻出郭行，念君家雁不能鸣。\n逢杯得醉常常事，渐老多慈种种情。\n荏苒又闻寒食近，牵缠空作暮春惊。\n祇应已入东风笑，愁思长于万里城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬亨父见寄","author":"吕南公","text":"醉墨淋漓诗屡酬，浮蛆上下酒新篘。\n人生有此自可乐，世事无穷何足忧。\n端是览辉同鸑鷟，不应专宿效夫不。\n嗟予久负思山兴，空得公诗展复讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和酬天休","author":"吕南公","text":"故人邂逅早莺时，一别经秋燕尽归。\n已是苦贫看客懒，更堪长病出门稀。\n何曾富贵来如梦，但觉光阴去似飞。\n欲酌清樽相解释，莫嫌穷巷瓦杯微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬何威中","author":"吕南公","text":"十年经画凿坏逃，只为乖违不为高。\n尽力未能成饱煖，致身那解立勋劳。\n已从酒盏忘千虑，羞看贪人校一毛。\n游旧惟君尚相记，每将新句访耕皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和酬伯华","author":"吕南公","text":"襄阳耆旧足高风，不识州城有德公。\n器业我应居众后，姓名今耻达宸聪。\n文章末技知何用，衣食残年叹屡空。\n朋友赠言当儆戒，恨君虚美一篇中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道先贤良以其到郡未及相见遽寄四韵谨以酬之","author":"吕南公","text":"山人还是入闉阇，自笑穷心失本初。\n郑相旧怜穷禦寇，秦王新伏勇相如。\n衣裘破敝身谋拙，齿发凋残世味疏。\n人正弃捐吾独取，似君风谊更谁欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬次道京还见寄诗二首 其一","author":"吕南公","text":"会得吾生只汎浮，莫将耕钓异公侯。\n文章高去乃青史，富贵极来皆白头。\n至乐如今惟强饮，最贤从古是无求。\n荷源砌上枫林叶，又过元丰第六秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬次道京还见寄诗二首 其二","author":"吕南公","text":"平昔贤他马少游，有官何必至封侯。\n天如大雨当挥手，命合高眠亦到头。\n幽涧鱼肥堪煮炙，丰年酒贱易追求。\n恨君门馆无酣伴，枉共痴儿对一秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬西阁书事","author":"吕南公","text":"西山阁上綵衣人，过得三冬似九春。\n长恨作诗无客和，更缘中酒被妻嗔。\n有官未入功名境，多暇仍思寂寞滨。\n文雅一时传万世，却应能此是荣亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝曦阁诗为李道正赋","author":"吕南公","text":"道人开阁破东厢，惯看朝曦亦坐忘。\n但见长时似车盖，不知何处是扶桑。\n云归后崦阴无迹，水过前渠响自忙。\n雨露纵然能恶作，未妨微白到书床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至凌云山却寄平仲","author":"吕南公","text":"建业归来路二千，一舟轻借死梯缘。\n贵池亭下风如鼓，采石江头浪拍天。\n险与阳侯成愤友，幸从鱼腹脱腥涎。\n只今亲旧知怜否，尚有馀生亦偶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月七日偶书","author":"吕南公","text":"愁里光阴不觉忙，忽闻时节近重阳。\n绝无閒药拟衰疾，才检旧衣防早霜。\n未必此生专冷落，漫因往事巧思量。\n呼僮閒赏篱边菊，并括忧端付一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伏睹教场后庭新移梅树辄赋小诗呈献内翰太中","author":"吕南公","text":"中庭移植气萧萧，无数芳华压翠条。\n田地纵然非旧壤，冰霜犹可见孤标。\n人间岁月何曾老，物外馨香猝未销。\n故有明年佳实在，铏羹滋味看和调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻仙都李道士下世 其一","author":"吕南公","text":"布褐毛冠七十秋，为谁浮汎为谁休。\n但曾计日防三鬼，不惯携琴谒五侯。\n诗卷在前聊养目，酒尊从此罢销忧。\n七星杉下朝曦阁，香火应教弟子修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻仙都李道士下世 其二","author":"吕南公","text":"长忆初能戴幅巾，仙都门外学游人。\n科场未数金门赋，襟袖空馀紫陌尘。\n平世选贤终法令，暮年如我但寒贫。\n惟师不信文章误，只道遭逢有屈伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":54464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]