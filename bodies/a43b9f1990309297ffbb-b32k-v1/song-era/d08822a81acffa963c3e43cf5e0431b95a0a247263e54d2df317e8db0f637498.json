[{"title":"初夏 其一","author":"赵葵","text":"院宇沈沈雨四垂，博山香断未多时。\n驱除春事风姨怨，贴水新荷又满池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊野","author":"赵葵","text":"白鸟冲烟去，山僧渡水来。\n竹篱茅舍外，忽见野梅开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春寒","author":"赵葵","text":"春草平芜烟雨迷，鞦韆寂寞旧园池。\n江南也是东风恶，花骨经寒瘦不支。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春游","author":"赵葵","text":"载酒寻春二月天，子规啼破绿杨烟。\n日斜醉倚鞦韆柱，石上桃花红欲然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳花","author":"赵葵","text":"三月名园草色青，梦回犹听卖花声。\n春光不管人憔悴，飞絮纷纷弄晚晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荒城","author":"赵葵","text":"城荒叶落风飕飕，淮水茫茫古渡头。\n回首不堪行乐地，黄花点点是离愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花","author":"赵葵","text":"夜深梅印横窗月，纸帐魂清梦亦香。\n莫谓道人无一事，也随疏影伴寒光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菊花","author":"赵葵","text":"黄花照眼又经秋，山自青青江自流。\n多谢龙头鳌禁客，年年把酒到江楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪夜","author":"赵葵","text":"酒力欺寒浅，心清睡较迟。\n梅花擎雪影，和月度疏篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"塞曲","author":"赵葵","text":"鸿传霜信入边州，目障烟尘昏戍楼。\n多少征夫南北恨，玉关人老玉关秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落花","author":"赵葵","text":"他乡桃李为谁栽，逗晓轻红带露开。\n一夜风姨妒颜色，落花无数点苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赏花 其二","author":"赵葵","text":"昨日新园去看花，路边郎女阿谁家。\n香车宝马相追逐，笑语归来日未斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赏花 其一","author":"赵葵","text":"人乐清明三月天，也随人赏万花园。\n偷闲把酒簪花去，不似儿童笑语喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"墨梅","author":"赵葵","text":"须知造物元无物，刚被花光强造端。\n认得色空都是幻，南枝非暖北枝寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠石牛上人","author":"赵葵","text":"万里江山万里天，疏钟半夜落渔船。\n老来羡杀禅关客，一枕江声抱月眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春 其一","author":"赵葵","text":"檀板且教停，花娇不耐惊。\n日融莺语滑，风软蝶身轻。\n缕篆销春昼，游丝弄晚晴。\n谁家杨柳院，笑语杂棋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"楼","author":"赵葵","text":"等闲携酒上南楼，楼占东州古渡头。\n翼瓦拂天翔碧凤，危栏隐雾锁苍虬。\n湖山环据三吴会，江汉雄吞四蜀流。\n醉里浩歌天地阔，橹声摇月上汀洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月见桃","author":"赵葵","text":"匼匝新园一径通，荷经霜尽野塘空。\n桃花错认东风暖，却与芙蓉斗小红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丰年","author":"赵葵","text":"一犁春雨足生涯，黍稷桑麻已满略。\n只愿今年风景好，村村社酒乐农家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹 其二","author":"赵葵","text":"风竹萧萧梧叶黄，相思寸寸断人肠。\n一声塞管来何处，雁带秋声入故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贞义女咏","author":"赵葵","text":"白首辞廊庙，投閒濑水隈。\n因观贞女传，深仰谪仙才。\n击漂名犹在，沉渊事可哀。\n清魂招不得，偷俗挽教回。\n直笔遗青史，□矶锁绿苔。\n凭将一杯酒，浇向浪花堆。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏 其二","author":"赵葵","text":"梅子留酸溅齿牙，芭蕉分绿映窗纱。\n日高睡起无情思，闲看儿童捉柳花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祝融峰","author":"赵葵","text":"祝融万仞拔地起，欲见不见青霄里。\n山翁爱山不肯去，为山醉卧松根底。\n家童寻著不敢惊，沉吟恐怕山翁嗔。\n梦回抖擞下山去，一径萝月松风清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋浦楼","author":"赵葵","text":"丽谯岧峣壮城关，万里关河归目睫。\n雨馀渔钓玉奁开，烟生芙蓉翠屏列。\n吴头楚尾二十秋，满耳弦歌声未绝。\n不才滥缀鸳鹭行，夜梦时还许归谒。\n萧晨振策来翠微，母怜吾儿倍怡悦。\n昔偕汝父居是邦，旧事辛苦为儿话。\n星星鹤发簪霞冠，笑者朱衣拥金节。\n一门和气皆君恩，恩与天同酬未得。\n生平区区忠孝心，岁晚愿为松与柏。\n可怜清赏属登临，风景不殊人事别。\n徘徊徙倚十二阑，啸声吹上梅梢月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荒城 其二","author":"赵葵","text":"乌桓城下雨初晴，紫菊金莲漫地生。\n最爱多情白翎雀，一双飞近马边鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃木","author":"赵葵","text":"谁家有女腰如束，双眸剪水肌凝玉。\n褪红香汗湿鲛绡，低压娇花鬓云绿。\n春光潋滟春昼长，春风扑面春花香。\n一声环佩鸣丁当，自临鸾镜匀新妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题金山","author":"赵葵","text":"紫金千仞郁崔嵬，四面惊涛捲雪堆。\n屹立中流天柱壮，高标双阙海门开。\n江流今古几分合，日月东西自往来。\n一览象山皆㟝嵝，不知身世是蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"避暑水亭作","author":"赵葵","text":"水亭四面朱阑绕，簇簇游鱼戏萍藻。\n六龙畏热不敢行，海波煎彻蓬莱岛。\n身眠七尺白虾须，头枕一枚红玛瑙。\n公子犹嫌扇力微，行人多在红尘道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子","author":"赵葵","text":"束发领西藩。\n百万雄兵掌握间，召到庙堂无一事，遭弹。\n昨日公卿今日闲。\n拂晓出长安。\n莫待西风割面寒。\n羞见钱塘江上柳，何颜。\n瘦仆牵驴过远山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"赵葵","text":"不问春归自放花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"赵葵","text":"多谢君恩好归去，夜来小泊小孤山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"赵葵姬","text":"柝声默报早朝回，满院春风绣户开。\n怪得无人理丝竹，绿阴深处摘青梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"赵雄","text":"三十六峰如不到，青山还似不曾游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"人月圆 中秋","author":"赵鼎","text":"连环宝瑟深深愿，结尽一生愁。\n人间天上，佳期胜赏，今夜中秋。\n雅歌妍态，嫦娥见了，应羡风流。\n芳尊美酒，年年岁岁，月满高楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小重山","author":"赵鼎","text":"漠漠晴霓和雨收。\n长波千万里，拍天流。\n云帆烟棹去悠悠。\n西风里，归兴满沧州。\n谩道醉忘忧。\n荡高怀远恨，更悲秋。\n一眉山色为谁愁。\n黄昏也，独自倚危楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌夜啼 中秋","author":"赵鼎","text":"雨馀风露凄然。\n月流天。\n还是年时今夜、照关山。\n收别泪。\n持杯起。\n问婵娟。\n问我扁舟流荡、几时还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乌夜啼","author":"赵鼎","text":"檐花点滴秋清。\n寸心惊。\n香断一炉沈水、一灯青。\n凉宵永。\n孤衾冷。\n梦难成。\n叶叶高梧敲恨、送残更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双翠羽 三月十三日夜饮南园作。旧名念奴娇","author":"赵鼎","text":"小园曲径，度疏林深处，幽兰微馥。\n竹坞无人双翠羽，飞触珊珊寒玉。\n更欲题诗，晚来孤兴，却恐伤幽独。\n不如花下，一尊芳酒相属。\n慨念故国风流，杨花春梦短，黄粱初熟。\n卷白千觞须劝我，洗此胸中荣辱。\n醉揖南山，一声清啸，休把离骚读。\n迟留归去，月明犹挂乔木。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 甲辰九月十五日夜饮独乐见山台坐中作","author":"赵鼎","text":"屋下疏流水，屋上列青山。\n先生跨鹤何处，窈窕白云间。\n采药当年三径，只有长松绿竹，霜吹晚萧然。\n举酒高台上，彷佛揖群仙。\n转银汉，飞宝鉴，溢清寒。\n金波万顷不动，人在玉壶宽。\n我唱君须起舞，要把嫦娥留住，相送一杯残。\n醉矣拂衣去，一笑渺人寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其四 再和","author":"赵鼎","text":"烟雾锁青冥，直上九关一息。\n姑射有人相挽，莹肌肤冰雪。\n骑鲸却下大荒来，天风乱吹发。\n慨念故人非是，漫尘埃城阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其一 雪中携酒过元长","author":"赵鼎","text":"春色遍天涯，寒谷未知消息。\n且共一尊芳酒，看东风飞雪。\n太平遗老洞霄翁，相对两华发。\n一任醉魂飞去，访琼瑶宫阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 杭州作","author":"赵鼎","text":"杨柳曲江头，曾记彩舟良夕。\n一枕楚台残梦，似行云无迹。\n青山迢递水悠悠，何处问消息。\n还是一年春暮，倚东风独立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 倅车还阙，分得茶词","author":"赵鼎","text":"兰烛画堂深，歌吹已终瑶席。\n碾破密云金缕，送蓬莱归客。\n看看宣诏未央宫，草诏侍宸极。\n拜赐一杯甘露，泛天边春色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其二 再和","author":"赵鼎","text":"羁旅转飞蓬，投老未知休息。\n却念故园春事，舞残红飞雪。\n危楼高处望天涯，云海寄穷发。\n只有旧时凉月，照清伊双阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其三 再和","author":"赵鼎","text":"一炷鼻端香，方寸浪平风息。\n汲取玉池春水，点红炉微雪。\n年来都以酒相妨，进退只毫发。\n却道醉乡深处，是三山神阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"如梦令 建康作","author":"赵鼎","text":"烟雨满江风细。\n江上危楼独倚。\n歌罢楚云空，楼下依前流水。\n迢递。\n迢递。\n目送孤鸿千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行香子","author":"赵鼎","text":"草色芊绵。\n雨点阑斑。\n糁飞花、还是春残。\n天涯万里，海上三年。\n试倚危楼，将远恨，卷帘看。\n举头见日，不见长安。\n谩凝眸、老泪凄然。\n山禽飞去，榕叶生寒。\n到黄昏也，独自个，尚凭阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 过福唐留别故人","author":"赵鼎","text":"世态浮云易变，时光飞箭难留。\n五年重见海东头。\n只有交情似旧。\n未尽别来深意，难堪老去离愁。\n青山迢递水悠悠。\n明日扁舟病酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花心动 偶居杭州七宝山国清寺冬夜作","author":"赵鼎","text":"江月初升，听悲风、萧瑟满山零叶。\n夜久酒阑，火冷灯青，奈此愁怀千结。\n绿琴三叹朱弦绝，与谁唱、阳春白雪。\n但遐想、穷年坐对，断编遗册。\n西北搀枪未灭。\n千万乡关，梦遥吴越。\n慨念少年，横槊风流，醉瞻海涵天阔。\n老来身世疏篷底，忍憔悴、看人颜色。\n更何似、归欤枕流漱石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"河传 以石曼卿诗为之","author":"赵鼎","text":"年年桃李。\n渺关河一梦，飞花空委。\n鸿去燕来，锦字参差难寄。\n敛双眉、山对起。\n娇波泪落妆如洗。\n独倚高楼，日日春风里。\n江水际。\n天色无情，似送离怀千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"河传 秋夜旅怀","author":"赵鼎","text":"秋光向晚。\n叹羁游坐见。\n年华将换。\n一纸素书，拟托南来征雁。\n奈雪深、天更远。\n东窗皓月今宵满。\n浅酌芳尊，暂倩嫦娥伴。\n应念夜长，旅枕孤衾不暖。\n便莫教、清影转。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"画堂春 春日","author":"赵鼎","text":"空笼帘影隔垂杨。\n梦回芳草池塘。\n杏花枝上蝶双双。\n春昼初长。\n强理云鬟临照，暗弹粉泪沾裳。\n自怜容艳惜流光。\n无限思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怨春风/一斛珠 闺怨","author":"赵鼎","text":"宝鉴菱花莹。\n孤鸾慵照影。\n鱼书蝶梦两浮沉，恨恨恨。\n结尽丁香，瘦如杨柳，雨疏云冷。\n宿醉厌厌病。\n罗巾空泪粉。\n欲将远意托湘弦，闷闷闷。\n香絮悠悠，画帘悄悄，日长春困。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞仙歌","author":"赵鼎","text":"空山雨过，月色浮新酿。\n把盏无人共心赏。\n漫悲吟、独自捻断霜须，还就寝、秋入孤衾渐爽。\n可怜窗外竹，不怕西风，一夜潇潇弄疏响。\n奈此九回肠，万斛清愁，人何处、邈如天样。\n纵陇水、秦云阻归音，便不许时闲，梦中寻访。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇 惜别","author":"赵鼎","text":"惜别伤离，此生此念无重数。\n故人何处。\n还送春归去。\n美酒一杯，谁解歌金缕。\n无情绪。\n淡烟疏雨。\n花落空庭暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇 春愁","author":"赵鼎","text":"香冷金猊，梦回鸳帐馀香嫩。\n更无人问。\n一枕江南恨。\n消瘦休文，顿觉春衫褪。\n清明近。\n杏花吹尽。\n薄暮东风紧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺圣朝 锁试府学夜坐作","author":"赵鼎","text":"断霞收尽黄昏雨。\n滴梧桐疏树。\n帘栊不卷夜沈沈，锁一庭风露。\n天涯人远，心期梦悄，苦长宵难度。\n知他窗外促织儿，有许多言语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺圣朝 其一 两辰岁生日作","author":"赵鼎","text":"花光烛影春容媚。\n香生和气。\n纷纷儿女拜翁前，劝犀尊金醴。\n凌烟图画，王侯富贵，非翁雅意。\n愿翁早早乞身归，对青山沈醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺圣朝 其二 道中闻子规","author":"赵鼎","text":"征鞍南去天涯路。\n青山无数。\n更堪月下子规啼，向深山深处。\n凄然推枕，难寻新梦，忍听伊言语。\n更阑人静一声声，道不如归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 美人","author":"赵鼎","text":"艳艳春娇入眼波。\n劝人金盏缓声歌。\n不禁粉泪揾香罗。\n暮雨朝云相见少，落花流水别离多。\n寸肠争奈此情何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 建康次韵范元长送邢子方","author":"赵鼎","text":"惜别怀归老不禁。\n一年春事柳阴阴。\n日下长安何处是，碧云深。\n已恨梅花疏远信，休传桃叶怨遗音。\n一醉东风分首去，两惊心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其二","author":"赵鼎","text":"玉宇洗秋晴。\n凉月亭亭。\n梦回孤枕琐窗明。\n何处飞来三弄笛，风露凄清。\n曾看玉纤横。\n苦爱新声。\n由来百虑为愁生。\n此夜曲中闻折柳，都是离情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 次韵史东美洛中作","author":"赵鼎","text":"归计信悠悠。\n归去谁留。\n梦随江水绕沙洲。\n沙上孤鸿犹笑我，萍梗飘流。\n与世且沈浮。\n要便归休。\n一杯消尽一生愁。\n傥有人来闲论事，我会摇头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令 其一 九日会饮分得雁字","author":"赵鼎","text":"霜露日凄凉。\n北雁南翔。\n惊风吹起不成行。\n吊影苍波何限恨，日暮天长。\n为尔惜流光。\n还是重阳。\n故人何处舣危樯。\n寄我相思千点泪，直过潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 和倅车韵。倅将还阙，因以送之","author":"赵鼎","text":"笔端红翠。\n造化工夫春有意。\n云梦涵胸。\n好去蓬山十二重。\n天街追骑。\n催唤谪仙泥样醉。\n电扫云空。\n百斛明珠咳唾中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜雨 梅","author":"赵鼎","text":"度陇信音谁与寄。\n肠断江南千里。\n深雪前村里，一枝昨夜传芳意。\n冷蕊暗香空旖旎，也应是、春来憔悴。\n风度将谁比。\n忆曾插向香罗□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望海潮 八月十五日钱塘观潮","author":"赵鼎","text":"双峰遥促，回波奔注，茫茫溅雨飞沙。\n霜凛剑戈，风生阵马，如闻万鼓齐挝。\n儿戏笑夫差。\n漫水犀强弩，一战鱼虾。\n依旧群龙，怒卷银汉下天涯。\n雷驱电炽雄夸。\n似云垂鹏背，雪喷鲸牙。\n须臾变灭，天容水色，琼田万顷无瑕。\n俗眼但惊嗟。\n试望中彷佛，三岛烟霞。\n旧隐依然，几时归去泛灵槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":46943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]