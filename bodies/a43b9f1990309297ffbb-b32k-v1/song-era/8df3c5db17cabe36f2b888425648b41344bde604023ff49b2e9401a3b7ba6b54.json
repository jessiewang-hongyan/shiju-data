[{"title":"依韵和图南五首 其五 大桃途次见菊","author":"文同","text":"英英寒菊犯清霜，来伴山中草木黄。\n不趁盛时随众卉，自甘深处作孤芳。\n其他烂漫非真色，惟此氤氲是正香。\n却念白衣谁送酒，满篱高兴忆吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和图南五首 其一 平阿马上","author":"文同","text":"江山相引转平皋，满马诗情拥敝袍。\n鸣鹤不知谁使怨，飞鸢何谓尔能高。\n岩头乱木森如戟，涧下繁云涌似涛。\n才到邮亭便沈思，向来佳景待吾曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和图南五首 其二 过朝天岭","author":"文同","text":"双壁相参万木深，马前猿鸟亦难寻。\n云容杳杳断鸿意，风色萧萧行客心。\n山若画屏随峡势，水如衣带转岩阴。\n生平来往成何事，且倚钩栏拥鼻吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和图南五首 其四 金牛相别呈诚之","author":"文同","text":"出门相与望横参，露浥幧头冷逼簪。\n驿在金堆随涧远，路经铜冶入烟深。\n过桥住马应回首，上岭闻猿想动心。\n胜事莫过文酒乐，此时销得各沉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和图南五首 其三 晚泊金牛","author":"文同","text":"一襟初觉晚霜清，短鞚垂头任马行。\n斜日敛回疏木影，急风收断落泉声。\n望穷好景番番别，题遍新诗阕阕精。\n终是教人伏潘令，许多才调赋西征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和蒲诚之春日即事","author":"文同","text":"轻烟漠漠雨斜斜，无事常教放两衙。\n问客江边求好石，倩人山里觅奇花。\n新蔬宛宛生晴圃，浅溜涓涓出暖沙。\n入夏杯盘须准备，绕畦亲灌邵平瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"周思道如诏亭","author":"文同","text":"繁上先生教子时，义方题榜贴亭楣。\n当年此地开师席，今日其言入制词。\n乡里共传为盛事，鬼神相助使前知。\n后人若续成都记，第一详书不可遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子山春日雨中书事见寄 其一","author":"文同","text":"菀菀冥冥雨气沉，一春长是咏春阴。\n燕归画栋帘栊静，莺下雕栏院宇深。\n斗草玉钗应复约，看花金勒误重寻。\n谢郎风调将谁奈，独倚书床拥鼻吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲蒙夜坐","author":"文同","text":"宿鸟惊飞断雁号，独凭幽几静尘劳。\n风鸣北户霜威重，云压南山雪意高。\n少睡始知茶效力，大寒须遣酒争豪。\n砚冰已合灯花老，犹对群书拥敝袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲蒙夏日即事","author":"文同","text":"簿领初休几案清，西轩移枕卧前楹。\n香从菡萏红苞发，粉入筼筜翠节生。\n不分便衰闻蚁斗，可嗟俱妄见蜗争。\n日长景静官曹冷，莫厌频来对一枰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴龙图韵五首 其一 二色芙蓉","author":"文同","text":"蜀国芙蓉名二色，重阳前后始盈枝。\n画调粉笔分妆处，绣引红针间刺时。\n落晚自怜窥露沼，忍寒谁念倚霜篱。\n主人日有西园客，得尔方于劝酒宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴龙图韵五首 其五 有怀致政景仁侍郎","author":"文同","text":"一生名籍占风流，为识庄环可自由。\n几杖未销容早退，庙堂将近肯中休。\n有人把酒思高节，何处挥毫咏素秋。\n故国岷峨最佳绝，几时归伴赤松游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴龙图韵五首 其三 明堂肆赦不得预观感而成诗","author":"文同","text":"季秋阳馆事严禋，能飨洪惟上至仁。\n游庙衣冠参帝坐，侍祠簪佩俨星辰。\n欢声被宇和于律，协气流天蔼若春。\n即见陪銮千万祀，岂长如此在遐垠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴龙图韵五首 其四 经史阁","author":"文同","text":"自持金节此为州，小善何尝不见收。\n更起丽谯连石室，盛藏缣帙拟蓬丘。\n师延旧德皆高谊，士集他邦尽久留。\n当念河南向儒意，莫教弦诵少时休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴龙图韵五首 其二 洗竹","author":"文同","text":"斤斧从来到此稀，为撩疏密绕藩篱。\n已繁不用饶新笋，纵碍何妨惜旧枝。\n风外清音闻曲阁，月中寒影下方池。\n想公日在琅玕径，正是棠阴讼少时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张屯田秋晚灵峰东阁闲望","author":"文同","text":"直栏横绝紫微阴，凭久秋光照客襟。\n一道山川寒色远，万家烟火夕阳深。\n泾滩水落群鸦集，秦岭云高断雁沉。\n此兴浩然须把酒，可怜难醉异乡心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张推官荔枝","author":"文同","text":"长嗟珍果滞遐方，好种华林奉帝王。\n夏簟满风罗秀色，晓梯乘露摘新香。\n泼霞乍染愁将变，烹玉才凝忍更尝。\n正在临邛病痟甚，忽蒙佳惠敢相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和邵兴宗棋声","author":"文同","text":"二客与棋酬，寒声满侧楸。\n急因随行发，断为见迟休。\n花下莺翻翼，林间鹤转头。\n丁丁竹楼下，不独在黄州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和陈基载大雨","author":"文同","text":"黕黕云如涌，淙淙雨若倾。\n骤翻银汉浊，匀洒玉绳明。\n雷怒无停势，风豪有遏声。\n危楼已初伏，犹谓裌衣轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和寄白圣均","author":"文同","text":"年来双鬓已丝丝，头角低摧羽翼垂。\n无命不穷常自笑，有谋皆拙敢求知。\n荣途谩说居三馆，僻郡还甘守一麾。\n赖是山城好风物，不能逢子共吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和梨花","author":"文同","text":"素质静相依，清香暖更飞。\n笑从风外歇，啼向雨中归。\n江令歌琼树，甄妃梦玉衣。\n画堂明月地，常此惜芳菲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和提刑郎中阅兵之什","author":"文同","text":"晓营金革列周遭，大纛长牙拥帐高。\n虎豹用韬传妙略，龙蛇供阵役群豪。\n言初抚处如萧纩，恩尽均时若楚醪。\n敢谓施行剪诸盗，亡之才比一牛毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏凫","author":"文同","text":"双双纹羽弄清漪，全得天真似尔稀。\n万顷沧波供口腹，一梁寒日晒毛衣。\n雨归别岛呕唲语，风度前滩翕呷飞。\n好向中流最深处，等闲休要上渔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜思寄苏子平秘丞","author":"文同","text":"乱竹敲风远，高松过雨凉。\n检书防落烬，下幕恐遗香。\n好月娟娟上，轻云苒苒长。\n端令阻佳客，不得共清觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜静独登小阁有所见因书","author":"文同","text":"危阁横空蔽野扉，夜深来上久忘归。\n水光潋滟和烟动，云色缡褷夹月飞。\n隔岸苇村闻笛远，背湾松坞见灯微。\n此间自得吟中乐，不觉霜华满尽衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官舍春日书怀 其二","author":"文同","text":"琵琶泉水碧溶溶，又见春归玉柱峰。\n欢绪已阑羞老大，交期将近懒游从。\n杏开暖萼融红蜡，柳放晴花拆白茸。\n赋得上林佳景尽，不知谁为荐临邛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"官舍春日书怀 其一","author":"文同","text":"自趋戎幕佐鞬櫜，四见新阴发旧柯。\n学饮不成欢意少，好吟无倦苦心多。\n舞伤池柳风图甚，泣破庭兰雨奈何。\n敢对青春叹留滞，且须开口更狂歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宜禄昭仁寺后轩","author":"文同","text":"危栏凭绝壑，欲奈此时何。\n但有夕阳处，就中秋色多。\n与谁同徙倚，空自发吟哦。\n便觉成羁旅，归心逐雁过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"房公湖","author":"文同","text":"一顷清波四面平，宛然唐相旧经营。\n高秋林木形容老，落日楼台綵绘明。\n有景可寻兰棹远，无幽不入竹桥横。\n二年所得官居乐，肯厌频来缓带行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明教院","author":"文同","text":"野径攲危入谷斜，曲岗回岭共交加。\n经年不到为隔水，此日独游因看花。\n两岸烟云闲景物，一轩泉石静生涯。\n自怜冠佩婴身者，直入樊笼老岁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杳杳堂","author":"文同","text":"杳杳堂何者，余常此养愚。\n放身依曲几，忘虑若枯株。\n庄老题书册，乔松列画图。\n客来休见问，非尔识于于。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苗子居运判归宿州同赴武康西县道中奉寄 其一","author":"文同","text":"霜风舞征袂，有客去符离。\n斜谷雪晴后，曲滩水满时。\n乱山谁对酒，孤驿独吟诗。\n不得陪清绝，怅然空所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郊外","author":"文同","text":"城市压尘土，高原聊振衣。\n晚云多浅碧，秋树半深绯。\n江气杂轻霭，山光明落晖。\n因成求好景，更就野桥归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金桃","author":"文同","text":"雨染烟蒸万实垂，丹朱为骨菊为衣。\n客疑丽水新淘得，人向瑶池旧带归。\n只恐压枝星欲落，最怜和叶露初晞。\n银瓜玉李君休并，此品仙家亦自稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临阛阁","author":"文同","text":"绝壑迎朱槛，高林拂画楹。\n卷帘千嶂远，入座一川平。\n蜺綵缘云断，霞光射水明。\n不须誇旷望，为语谢宣城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"前溪独游","author":"文同","text":"溪水碧溶溶，纡馀短彴通。\n小滩晴霭外，独鹤夕阳中。\n倚杖对清濑，披襟当好风。\n几时归住此，长下钓鱼筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"剑州东园","author":"文同","text":"群峰高拥碧嶙峋，亭宇清华气象新。\n两岸烟云先向日，一林花木暗藏春。\n溪明夜阁轩窗月，风断晴桥井邑尘。\n好酒满樽诗满轴，主人曾不倦行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咸阳道上晚晴有作","author":"文同","text":"积霭晚尽散，南山明夕阳。\n秋容遍丰镐，古恨入隋唐。\n草木咸摇落，风烟自渺茫。\n客亭须下马，把酒慰殊乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"幽沼","author":"文同","text":"促促开幽沼，涓涓引细渠。\n无由安岛屿，才可活龟鱼。\n秀荇新宜食，圆荷净好书。\n时来坐高柳，濯足荫扶疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"弭盖亭","author":"文同","text":"弭盖长亭下，轩窗慰客心。\n田塍交远日，水堋泻清襟。\n北道云千里，西山雪万寻。\n尘衣无奈拂，去骑复骎骎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春庭","author":"文同","text":"春院阴阴翠霭低，春庭寂寂晓光迷。\n花间蜂去抱黄粉，苔上燕来衔绿泥。\n两行高梧初荫合，一番新草恰生齐。\n微禽已识幽人意，飞下栏干向里啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春闺","author":"文同","text":"枕带萦春思，窗纱漏晓光。\n蟏蛸伤远别，鶗鴂感流芳。\n妆匣蒸残粉，薰炉试旧香。\n洞房灯烛外，只有梦悠扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雪呈知府龙图","author":"文同","text":"胧胧玉魄沉霄彩，蔌蔌瑶花破晓阴。\n和气所蒸缘异政，丰年之兆慰群心。\n画楼卷白欢声洽，游骑障泥乐意深。\n太守安闲民讼息，锦城无限好园林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"残秋郊外","author":"文同","text":"萧萧风色弄寒威，见尽郊原向晚晖。\n昨夜星霜和月落，满林红叶隔烟飞。\n已嗟北渚莲初老，更惜东篱菊渐稀。\n休感岁华伤节物，眼前樽酒重相违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"炭泉险道","author":"文同","text":"一涧呀然截乱峰，更于何处问途穷。\n高深出井又入井，曲直上弓还下弓。\n绝底乍临浑偪仄，危颠才彻似飞冲。\n我来行县须经此，正在炎炎三伏中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋子","author":"文同","text":"袅袅复翻翻，封条压树繁。\n群芳非姊妹，乱实见儿孙。\n荫日临虚槛，披风拂短垣。\n主人无奈尔，常为醉幽轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日寄吕永寿微中","author":"文同","text":"落日照容谷，寥然官署秋。\n开帘临绝巘，凭几对寒流。\n古意深中得，诗心静外游。\n三年多少景，满箧是冥搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺陈基载重阳日","author":"文同","text":"文酒寻常不厌求，坐中须得贾长头。\n幸逢九日称佳节，宜对三嵎赏素秋。\n岁月但看随叶落，利名当信与云浮。\n凭君且学龙山饮，一醉能令万事休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送文铸师游襄阳鹿门","author":"文同","text":"师今鹿门去，正此冒炎曦。\n野店乞晨馔，乱山吟古诗。\n问程行几日，览景立多时。\n我有怀贤意，凭看堕泪碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王晦叔","author":"文同","text":"岂无旧德为清望，亦有彊亲在要流。\n班簿至今才博士，郡书犹自许诸侯。\n贫甘远宦冰盈腹，老忆高堂雪满头。\n不恃交期便求去，趁归春圃奉兰羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘立之著作归长安因赴安定知县","author":"文同","text":"西郊晴雾晓霏霏，回首京尘一拂衣。\n上国莫嗟为客久，高堂初喜改官归。\n洛城气候花才动，灞水风光絮恰飞。\n恨不同游曲江岸，与将歌酒䛏春晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送尧夫二章 其二","author":"文同","text":"欲与民为利，先求正所妨。\n纷更初下议，旁午遂交章。\n不尔毛安傅，其如体自伤。\n西南馀弊在，归为对明光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送尧夫二章 其一","author":"文同","text":"有志深沉定，无心出处同。\n庙堂应为国，台省复还公。\n肖似家声重，端方士论雄。\n上如留左右，风采壮朝中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送坚甫同年 其二","author":"文同","text":"得数常奇懒下筹，肯来荒徼治累囚。\n三年笑别浙江远，万里吟归岷岭秋。\n赵壹囊空常肮脏，虞卿书就愈穷愁。\n蹠香回臭都休问，未有林泉且宦游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送坚甫同年 其三","author":"文同","text":"春深行剑栈，羡子此时归。\n照日江浮马，迎风花聚衣。\n下程家累省，对景俗题稀。\n若遇西来客，书言不可违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张正夫监簿归汉州","author":"文同","text":"知己非不遇，其如才命违。\n宦名疑在梦，亲禄只徒归。\n道路盘危栈，家山指落晖。\n好将绵竹颂，重拂入关衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张朴翁归盩厔 其二","author":"文同","text":"山曲水曲处，其间皆美田。\n夫君别桑梓，此地卜林泉。\n壮岁可立事，明时方尚贤。\n何当再就诏，便忍说终焉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张朴翁归盩厔 其一","author":"文同","text":"一觉落天梦，遂吟招隐诗。\n携家异乡去，变服散人为。\n郿坞云开后，圭峰月上时。\n清秋此高兴，琴酒问同谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张宗益工部知相州","author":"文同","text":"学术深沉久未施，晚登台省世方知。\n诗章好奏周文庙，字法宜磨魏武碑。\n禁掖便当提大笔，名藩犹自拥高麾。\n应怜共试金坡者，答飒浑如郑鲜之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张郭二秀才赴举","author":"文同","text":"二子共赍刀，翩翩去意豪。\n负才皆万选，入守定双高。\n上道梅薰袖，还家草映袍。\n须知本鸿鹄，终不在蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李坚甫中舍奉使还阙","author":"文同","text":"曾歌出塞愁，又遣使西州。\n去国星辰动，还家岁月流。\n褒斜新路晚，鄠杜故园秋。\n归对延和殿，从容问讲求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李野夫兼简公择学士同年","author":"文同","text":"吾友野夫官满归，峡中风物正春时。\n莫因道路起长叹，且对江山吟好诗。\n异日滑台君若到，寄言别乘我相思。\n声名已重更论底，但引冰堂金屈卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送夏殿直","author":"文同","text":"霜树东门晓，清寒满客衣。\n一樽从此别，百两几时归。\n漆水鱼初荐，梁园雪正飞。\n高堂今远郡，须念报春晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郭方叔南充簿","author":"文同","text":"六月东山道，炎风满去鞍。\n谯周之旧里，仇览此初官。\n簿领无烦壅，图书好燕安。\n清朝名路阔，慎勿学长叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送郭经知县","author":"文同","text":"促促送归客，短亭垂柳风。\n离樽掩残日，去骑若轻蓬。\n百里讴歌内，三年畏谨中。\n乡人问蜀物，笑指一囊空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送黄梦得","author":"文同","text":"去年轻舳过巫山，今日羸骖度剑关。\n孤客每嗟随断梗，慈亲常把梦连环。\n兰陔岁晚虽堪采，桂窟春深正好攀。\n决取荣科归旧里，板舆迎侍且承颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":6826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]