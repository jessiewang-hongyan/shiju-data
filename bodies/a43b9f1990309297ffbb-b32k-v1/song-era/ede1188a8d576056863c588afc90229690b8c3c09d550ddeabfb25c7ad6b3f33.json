[{"title":"咏龙","author":"舒岳祥","text":"曾见老人潭上坐，忽然不见石泓深。\n至今月白风清夜，潭底时闻似笛吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏豆蔻花 其二","author":"舒岳祥","text":"舌吐梅仁颗，心含豆角花。\n折来无处著，留取爱名嘉。\n脆紫深愁雨，轻红落软沙。\n虞兮成恨草，姊娣共成家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"枫树","author":"舒岳祥","text":"屈原庙外千株碧，高帝祠前万叶红。\n楚尾吴头风景在，片帆不复更西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"齿酬唇赠","author":"舒岳祥","text":"刚柔君不吐，冷热我须当。\n铁石还销毁，吾今已久长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春叹","author":"舒岳祥","text":"春色三分二，人生七十稀。\n蝶魂归蚁冢，花瓣泊鱼衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春闺","author":"舒岳祥","text":"有恨无人可话心，闲吹柳絮度青林。\n偶然省著前年事，仰面听莺堕玉簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柘溪道中有感","author":"舒岳祥","text":"得势茅欺蕙，安居爵笑鸿。\n吾年已如此，役役又西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柳市晚风","author":"舒岳祥","text":"手栽杨柳恰成堤，招引清风障日西。\n热客岂能知此味，请君来此听莺啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神鳌","author":"舒岳祥","text":"清声端是磬浮泗，黑质浑然玉剖荆。\n应是任公垂钓得，灵鳌入手出沧瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夜","author":"舒岳祥","text":"院静泉声合，夜深虫语多。\n近窗移素榻，攲枕见星河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋晚过北渡","author":"舒岳祥","text":"凄凉客路趁长川，荷叶无衣柳不绵。\n日暮正愁无宿处，乱鸦飞下有人烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闺怨 其二","author":"舒岳祥","text":"回廊曲径入荷花，斜隐珠帘半面遮。\n欲绣鸳鸯嫌未似，且抛针线理琵琶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闺怨 其四","author":"舒岳祥","text":"贮雪成酥饤玉盘，劝郎抄取一匙餐。\n金针指冷愁花冻，侍婢添香却夜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闺怨 其三","author":"舒岳祥","text":"能把玉箫传远意，难将彩笔写秋光。\n翠屏金鸭芙蓉冷，梦短却嫌秋夜长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闺怨 其一","author":"舒岳祥","text":"一春心事许谁同，金钥无声柳絮风。\n怪得枕中黄鸟唤，不知窗外海棠红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻禽献咏","author":"舒岳祥","text":"郭公莓熟郭公语，谢豹花开谢豹啼。\n万斛愁消一樽酒，庄生物理底须齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻霰","author":"舒岳祥","text":"卷幔江湖二十年，青山兀坐学枯禅。\n夜来雪急敲窗纸，忽忆吴江听此眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"除夕","author":"舒岳祥","text":"软煖炉星火，新香甑雪糕。\n老人消一睡，守岁为徒劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"借居夜闻水声","author":"舒岳祥","text":"寒水泠泠出洞来，月明静听转清哀。\n无人与入琴丝写，流下前溪漾落梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"家藏画鹊二轴其一棠梨结子青黄叶亦虫蚀尚带晚花有鹊眠枝上枝若垂垂不胜者其一作攲竹一茎有鹊把竹磔螳螂而食之叶若振振而动摇者笔意精妙非黄筌不能也 其一","author":"舒岳祥","text":"棠子青黄带晚妍，忘机好鹊压枝偏。\n从来报喜无憎恶，借汝庭柯取次眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"家藏画鹊二轴其一棠梨结子青黄叶亦虫蚀尚带晚花有鹊眠枝上枝若垂垂不胜者其一作攲竹一茎有鹊把竹磔螳螂而食之叶若振振而动摇者笔意精妙非黄筌不能也 其二","author":"舒岳祥","text":"粉节娟娟碧玉枝，螳螂得意更谁疑。\n旁人只与危黄雀，不道中林有鹊知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桂台","author":"舒岳祥","text":"苍苔踏碎吟初就，绿荫看成老又来。\n世事悠悠吾已矣，人生扰扰亦何哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桐","author":"舒岳祥","text":"峄阳浑璞凯风心，此是姚虞膝上琴。\n我有全琴元不斲，时携枕簟卧清阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桐乳","author":"舒岳祥","text":"桐乳深藏鸟，苔花暗语虫。\n谁能借修竹，为我宿清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荷亭","author":"舒岳祥","text":"影浸苍凉月，香随澹荡风。\n露华初汎汎，秋思莫匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读方元善落花诗有感 其二","author":"舒岳祥","text":"次第花开次第飞，总堪饮酒与吟诗。\n绝怜新绿光如沃，何必繁英尽在枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿龟石寺","author":"舒岳祥","text":"山深无横吏，客至气和平。\n野寺鸣钟罢，安眠到五更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄少白诗后因问讯小潘","author":"舒岳祥","text":"诗翁山膊鬓飕飕，只向岩幽了白头。\n欲共君家阿戎语，蝉联书笥吐难收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得正仲书相勉归乡作一绝复之","author":"舒岳祥","text":"老去无家天一方，安贫乐土羡刘郎。\n夜来一阵西风起，闻得山亭酒味香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚出","author":"舒岳祥","text":"数树远烟藏枣栗，半村疏雨下牛羊。\n诗人过眼助成句，吟罢不知归路长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晨起嚼雪老齿生冰亦一快事","author":"舒岳祥","text":"布衾温燠似春晴，睡足窗前一鸟鸣。\n起挽梅梢拈雪嚼，五行谁带许多清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦中作","author":"舒岳祥","text":"桃李成蹊春不言，有人扶瘦倚栏干。\n柔柔软软愁如困，燕子初归带薄寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦归","author":"舒岳祥","text":"独行东阪茅茨屋，回望西墙竹树坡。\n愁杀曛黄归路远，兵残人少髑髅多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦成","author":"舒岳祥","text":"山棠红白间青林，上有和鸣百啭禽。\n一阵晚风吹曀去，又寻桃杏说春心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦觉见雪","author":"舒岳祥","text":"青山白发最宜看，点缀斓斑著意难。\n巧付小园浑未了，东风急处又吹残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明感旧","author":"舒岳祥","text":"杨柳家家去下湖，有歌有哭其闉阇。\n新孀少妇深深拜，却引新夫拜故夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清绝","author":"舒岳祥","text":"道人清绝在中宵，清绝因何生寂寥。\n最爱读书窗外雨，数声残剩过芭蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔父词","author":"舒岳祥","text":"占断江鸥万里天，不贪城市卖鱼钱。\n前村酒熟不归舍，枫叶芦花相伴眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔翁","author":"舒岳祥","text":"大男举网锦鳞红，稚子轻摇一榜风。\n微雨斜阳身半湿，瓦瓯醉酌主船翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"移苇","author":"舒岳祥","text":"洗箨移来栗玉乾，翠禽相顾自依然。\n从今风雨西窗外，更忆吴江泊钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绿阴","author":"舒岳祥","text":"絮尽花空碧涨浔，幅巾藜杖度前林。\n提壶爱我烦三请，拚与长瓶卧绿阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萤","author":"舒岳祥","text":"老来不用映书帷，草上流光数点微。\n却忆江村无月夜，篮舆一路照人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"铜雀瓦砚","author":"舒岳祥","text":"摩挲岁久马肝死，洗涤尘开鸲眼鲜。\n铜雀何人收废瓦，铭文犹记建安年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪村闻鹃","author":"舒岳祥","text":"故国亡来身已非，千年犹诉不如归。\n参天古木魂迷路，谁与黎侯赋式微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"啼乌词","author":"舒岳祥","text":"月明双影带霜栖，长忆青梧玉井西。\n前度碧窗惊晓梦，女奴驱遣莫教啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食题山庵","author":"舒岳祥","text":"门插垂杨不是家，自怜飘泊似杨花。\n一樽和泪浇坟土，馀馂分张及野鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游永庆寺","author":"舒岳祥","text":"惨澹芜城暮，萧疏野树寒。\n登山不惮远，反恐下山难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"短檠","author":"舒岳祥","text":"昔年曾读退之诗，墙角短檠吁可悲。\n我有短檠元不弃，自悲双眼早昏眵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"紫木笔花","author":"舒岳祥","text":"簪笔侍臣辉荷橐，丝纶郎省照薇花。\n管城不任中书职，咄咄书空蘸晚霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋庭前落桂","author":"舒岳祥","text":"去岁花开三日事，今秋陆续两番开。\n渥丹如雨香犹好，乞与幽人护绿苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雁","author":"舒岳祥","text":"老雁移屯百万回，黄埃极目碛沙飞。\n春风万里梅花路，淼淼江南人未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新成小斋曰剡雪舟以此兴有所思也","author":"舒岳祥","text":"银河枕上客星来，残梦西窗水鸟啼。\n身入布衾如卧雪，当年曾泛戴公溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪鱼","author":"舒岳祥","text":"红白溪鱼也可怜，夜凉沙静枕流眠。\n澄潭百尺无机事，自古何人作钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人草","author":"舒岳祥","text":"楚妆不入汉王宫，宠爱如花悟色空。\n世上女儿休笑我，当年曾伴拔山雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣兴三绝 其三","author":"舒岳祥","text":"老怀忽忽如中酒，短发萧萧不受簪。\n四壁应闻长叹息，何人知我此时心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣兴三绝 其二","author":"舒岳祥","text":"读书未尽老骎骎，更把残编往复寻。\n六籍精微心已耗，只将韩杜了光阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣兴三绝 其一","author":"舒岳祥","text":"小小茅斋傍茂林，朝朝暮暮有鸣禽。\n道人心事无憎爱，终夜闻枭也好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"槠树","author":"舒岳祥","text":"凌轹风霜四十围，白猿不上最高枝。\n明堂未构材何用，抛掷玄珠满地皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"静坐偶成 其二","author":"舒岳祥","text":"作意投床寐不熟，嗒然隐几睡偏安。\n从来万事无心好，心到无心自是难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"静坐偶成 其一","author":"舒岳祥","text":"日午风休树不哗，蚀残香篆伴南华。\n忽闻霜鸟如春鸟，闲想芦花作柳花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"墨","author":"舒岳祥","text":"谁传易水廷圭制，缫藉珍藏二百年。\n进御近闻翁与叶，琴形带?逐时妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"樟树","author":"舒岳祥","text":"樛枝平地虬龙走，高干半空风雨寒。\n春来片片流红叶，谁与题诗放下滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蕉径小立","author":"舒岳祥","text":"昼夜中分凉燠平，裁新熨故体轻清。\n无端挠乱成多事，刚种芭蕉作雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题王任所藏林逋索句图 其四","author":"舒岳祥","text":"身后不遗封禅藁，吟梅全是自题真。\n画工岂识凌云意，童子趋炎鹤附人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题王任所藏林逋索句图 其一","author":"舒岳祥","text":"清新半树横枝句，冷淡暗香疏影诗。\n谁见当时苦吟态，只应童鹤在旁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题王任所藏林逋索句图 其三","author":"舒岳祥","text":"千秋万古梅花树，直到咸平始受知。\n若道此图真此老，何人觌面敢题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题王任所藏林逋索句图 其二","author":"舒岳祥","text":"隐几何思此意微，鹤眠未熟觑吟机。\n踞炉炙脚童全野，应是前村踏雪归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题杏花翠羽","author":"舒岳祥","text":"物色春来多入画，赵昌片幅落吾家。\n翠禽欲起还休去，可是多情为杏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题周梅所藏小景画卷","author":"舒岳祥","text":"小鸭鸦乌烟柳坡，鵁鶄属玉满晴莎。\n惠崇不作大年死，惆怅江湖春水多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题萧照山水 其二 前峰小隐","author":"舒岳祥","text":"林穷涧绝石崖倾，临水幽朋更欲登。\n拟共前峰成小隐，晓来云尽见高棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题萧照山水 其四 野渡横舟","author":"舒岳祥","text":"翩翩凉树小茅堂，揖客柴门去栈长。\n山外横舟篷不启，谁知世有送迎忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题萧照山水 其三 清溪一舸","author":"舒岳祥","text":"何人一舸下清溪，列壑攒峰想旧栖。\n不雨石林元自湿，无云山路只长迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题萧照山水 其一 隔涧语樵","author":"舒岳祥","text":"烟雨峰峦无古今，断崖迷径静愔愔。\n隔溪樵子遥相语，昨夜春流尔许深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"懒出","author":"舒岳祥","text":"飞雾不成雨，幽人懒出溪。\n落红双雉过，新绿一鹃啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"燕嬉舟","author":"舒岳祥","text":"西湖锦舫帘垂额，越上乌篷铁簇头。\n江堰不通人已老，竹深荷净且迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠渔者 其一","author":"舒岳祥","text":"本是浮生江海客，持螯斫鲙酒家村。\n一瓶说与长年道，三日提鱼一到门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠渔者 其二","author":"舒岳祥","text":"红蓼青芦媚一川，夕阳偏丽晚秋天。\n吹沙已老松鲈上，日日江头望钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一叶","author":"舒岳祥","text":"欲排江渚千鸿阵，先舞庭皋一叶秋。\n细路桑麻高下屋，平湖风雨往来舟。\n人间酒熟花为客，梦觉残灯月上楼。\n故旧凋零我老矣，少年安肯与同游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一春四十日天气未佳花事行复已矣太息成吟","author":"舒岳祥","text":"积翠林塘十亩阴，雨中不觉变流音。\n江山万里登楼眼，宇宙千年隐几心。\n有客不来还日暮，掩书无语自春深。\n倚阑欲数排檐竹，故故飞花点袖襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]