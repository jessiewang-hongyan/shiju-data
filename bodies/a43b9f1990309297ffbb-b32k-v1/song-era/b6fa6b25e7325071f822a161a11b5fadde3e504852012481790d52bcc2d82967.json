[{"title":"山居杂诗九十首 其七十三","author":"曹勋","text":"台山穴三兽，樵者不得薪。\n忽是食人虎，便有射虎人。\n善恶必对待，祸福常相邻。\n深月寝三皮，居山聊一欣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其三十五","author":"曹勋","text":"画工作江梅，粉绘良自誇。\n吾侪晕澹墨，一枝才数花。\n风情意自足，横斜不可加。\n须知自古来，画家须诗家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其六十八","author":"曹勋","text":"万花烘天容，粉色腾云气。\n花云覆台榭，疑若天亦醉。\n杯盘多欢赏，供帐亦明丽。\n游人侵宵归，风雨恐踵至。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其六十九","author":"曹勋","text":"秋暑正炎酷，人不得以息。\n向晚注大雨，剧暑遂扫迹。\n萧然物气平，暂止火御职。\n上天常好生，一凉诚大德。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七","author":"曹勋","text":"除地台山麓，稍葺五亩宅。\n松竹互偃亚，云山若阡陌。\n子舍念我老，文馀躬干役。\n欣欣归来乐，乐岂一朝夕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其十六","author":"曹勋","text":"七月正流火，晚饭净刹中。\n稍脱蒸郁苦，顿觉心境空。\n放意览翠岫，徐行迎好风。\n得来喜不彻，此赐皆天公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其三十五","author":"曹勋","text":"幽居岁屡换，豪举欲谁作。\n闲情寡赋咏，旧句漫笔削。\n草茅晦小隐，笋蕨供大嚼。\n不时有佳处，悠然动春酌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其二十一","author":"曹勋","text":"凄风入林薄，旵日升山迟。\n槿花落因雨，菊英开映篱。\n身老每倦客，目昏犹喜诗。\n所欣水云念，得赴猿鹤期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其五十八","author":"曹勋","text":"不持月三长，不奉八关戒。\n久素则生疾，多肉亦思菜。\n齿决今莫遂，啜汁老所快。\n终当屏去荤，居山得自在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其八十五","author":"曹勋","text":"休退居远邑，顿喜人事疏。\n饭箩自不足，日记无可书。\n惟对楮先生，复接松大夫。\n溪友留白鱼，鼾睡惊长须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其四十","author":"曹勋","text":"偶读禅门礼，老赜存清规。\n鱼鼓钟磬间，细行兼威仪。\n能居三板头，可当一住持。\n破衲受用薄，后来有不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其六十二","author":"曹勋","text":"道人有相访，不求养生诀。\n或问琴棋妙，或笑汗漫说。\n何州有隐逸，何山富薇蕨。\n饭了且分携，日课所不屑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其十八","author":"曹勋","text":"今年已断梅，七月雨益大。\n苗虽不厌雨，灌恐有馀溉。\n禾梗正柔嫩，水满舞澎湃。\n其间田高低，于焉有畏爱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其十二","author":"曹勋","text":"吾年踰七十，真欲愿春迟。\n岂谓上元过，适丁多雨时。\n韶华荏苒半，清明旦夕期。\n流莺与蜂蝶，冷落殊未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其十三","author":"曹勋","text":"客寄辇毂下，驰心田亩间。\n君恩重山岳，臣节殊安闲。\n虽幸米盐足，其如尘土颜。\n终负告归罪，判然诚独难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其十五","author":"曹勋","text":"三伏暑可畏，贫富方共之。\n雨忽兼飘风，凉与清气随。\n一饷涤炎暍，万里失蒸炊。\n大哉天地德，好生常所施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其二十一","author":"曹勋","text":"晚家台山下，云水同一乡。\n人事讲邻曲，鸡黍期相当。\n秋风起木杪，凉气吹衣裳。\n东家喜见招，社瓮开新尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其三十七","author":"曹勋","text":"小庵筑桐柏，宛在艮山位。\n数峰直远目，一水绕右地。\n门径连主山，松篁接空翠。\n贵客下北阙，喜话卜邻计。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其六十三","author":"曹勋","text":"造化致有生，旋亦致凋瘁。\n草木方薿薿，枝叶忽靡靡。\n初发白雨涤，接以赤日炽。\n末为飙风吹，从是即委翳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其三十","author":"曹勋","text":"平生文字饮，真积力已久。\n温故忽若醉，卯饮不待酒。\n昏然亟步武，快哉绕衡陋。\n水阔夕阳红，雨馀群山秀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其十三","author":"曹勋","text":"朅去天台居，邑有万户酒。\n一出尝十家，已觉醉屡肘。\n留连多好事，方圆烦饤斗。\n约趁黄昏归，不知月挂柳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其五十九","author":"曹勋","text":"台山无牡丹，单叶已最贵。\n斗槛数花尔，便欲发光气。\n珍重莫肯折，如天藏地秘。\n西都每兴怀，此赏殆梦寐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七十一","author":"曹勋","text":"云山环所临，烟景日日异。\n山作故人接，云为久处计。\n酒酣一声笛，梅风四山起。\n清香剩披拂，参横伴村醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其六","author":"曹勋","text":"伏日更酷暑，当午剧炎烈。\n火云凝不动，势欲终岁热。\n天公苏赤子，雨随震霆发。\n一扫回清凉，庭筠助骚屑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其二十","author":"曹勋","text":"白日忽若暮，北风天正寒。\n浓阴欲酿雪，云侣商量间。\n群儿竞喜跃，婢子争仰看。\n命席拨瓮碧，取醉期尽欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其二十八","author":"曹勋","text":"堂堂春将去，好花如款留。\n荼蘼蔓层雪，芍药攲重楼。\n金沙插架富，蕙香转林幽。\n我欲助送之，飞絮漫天愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其十七","author":"曹勋","text":"弃官了无事，饭馀心境空。\n清琴或数弄，浊酒时一中。\n人生苦不闲，得闲须从容。\n闭门适吾乐，三籁皆同功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其五十一","author":"曹勋","text":"范仙最所长，画牛诚绝笔。\n围模大小定，毛孔不少失。\n膊腕与腹胯，一牛动数日。\n惟我颇得之，卧起尽纤悉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其十一","author":"曹勋","text":"松色荫人居，松力治人病。\n丹砂含其滋，复可延性命。\n幽居绕苍髯，不畏夏日盛。\n风来听笙竽，便有华胥兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其六十四","author":"曹勋","text":"早年困胡虏，惊痛失方寸。\n居常虽勉勉，临事辄闷闷。\n作字每误墨，裁诗或失韵。\n老来疾益侵，薾然谁可论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其五十四","author":"曹勋","text":"闲居必家酿，不以空乏废。\n小槽压春碧，浑含揖和气。\n三杯禦客寒，一卮款仆意。\n宁论有贤圣，且复供村醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其四十","author":"曹勋","text":"秋色不胜悲，浓霜寒入衣。\n蔬畦倦小摘，茅檐曝晴晖。\n人去歌酒歇，雁来音信稀。\n好客招不来，枫叶伴愁飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其五十七","author":"曹勋","text":"平生不能棋，遇棋亦辄喜。\n从来号万户，知生不救死。\n多见国手说，得先乃妙理。\n更有末后著，此著知者几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其五十五","author":"曹勋","text":"小圃养春色，乘时不可缓。\n翌锄常于于，成趣须旦旦。\n花摘去年种，喜供一时玩。\n举杯付歌儿，野服更萧散。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其二","author":"曹勋","text":"隔岁种成麦，起麦秧稻田。\n晚禾亦云竟，冬菜碧相连。\n收割不闲手，垄亩无空阡。\n家蓄千指客，始知常有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其三","author":"曹勋","text":"地水与火风，四大各一性。\n和合乃养形，损增则成病。\n圆觉著于品，岐伯峻其證。\n君子知其言，穷理宜至命。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其四十五","author":"曹勋","text":"调羹商相业，粉额汉宫妆。\n寄远与却月，六朝用弥彰。\n犯寒清而洁，骚经何独忘。\n抚卷怀灵均，灵均亦沉湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其三十四","author":"曹勋","text":"闲中每自得，闲意非陆沉。\n蚁穴漫说梦，鸥盟谁更寻。\n一年记好处，万缘随夙心。\n即以洗其劳，清月升层林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其四十三","author":"曹勋","text":"顷职古器事，三代考纤悉。\n闳异必夏商，形模且朴质。\n其间盛款识，鼓文俨周室。\n固知文武隆，牧敦当第一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其五十","author":"曹勋","text":"闲居养僮仆，衣食必鲜美。\n小则爱睡眠，大者趋博戏。\n不然言疾病，莫能承付委。\n长须与赤脚，昔人诚有理。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其三十三","author":"曹勋","text":"人惠九皋禽，应节每对舞。\n絷彼云汉心，成我闲静趣。\n六翮不忍剪，深径任翔翥。\n一举遨天风，应到逍遥处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其二十九","author":"曹勋","text":"晓来浩露出，细履欣悠然。\n垄麦漾轻浪，芳草迷平川。\n无边绿成幄，团飞柳皆绵。\n老翁指谓我，渐熟高低田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七十九","author":"曹勋","text":"门前露草嫩，极目遨青龙。\n策杖不知远，看山兼别峰。\n晓厨寻晚笋，客供摘新菘。\n舌下清肥足，何劳细肋供。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其五十六","author":"曹勋","text":"前村有经社，香火讯屡通。\n携朋闲步往，老人颜有童。\n一杯苦涩茗，满塘蒲稗风。\n笑顾纸上佛，何时供渠侬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其二十六","author":"曹勋","text":"高原收菽麦，下田插禾秧。\n田头与地尾，一一意所量。\n躬耕辨好怯，择种均丰荒。\n所以终岁间，食米不及糠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其八十三","author":"曹勋","text":"陈梨甘若饴，雪梨脆而水。\n二物浙左右，大颗擅甘脆。\n秋热兼宿酒，啖之手不置。\n虽非凤浊鹅，惠予亦多矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七十六","author":"曹勋","text":"八月河汉近，凉蟾辉太清。\n窗户纱已薄，草木风有声。\n所喜暑云退，不惮岁徂征。\n招客对晚色，酒与月同倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七十二","author":"曹勋","text":"我生苟无祸，放怀在诗酒。\n诗酒得自在，功名亦何有。\n正欲醉坠车，岂问柳生肘。\n写我平生适，笑寄方外友。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其五十二","author":"曹勋","text":"寒毬格虽下，春事亦可寻。\n故园少见之，花叶均来禽。\n芳蓓暖苞玉，半腮红浅深。\n与客屡清赏，只恐风雨侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其八十四","author":"曹勋","text":"山色侵衣冷，异气作心赏。\n岭月闻凤笙，松风吹鹤氅。\n碧池绉澄绿，群山发清响。\n以此助萧闲，欣然同击壤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其六十八","author":"曹勋","text":"商飙忽在序，候虫凄以鸣。\n岁律念向晚，崦嵫逼于征。\n已叹日月疾，但觉须鬓狞。\n搔首欲何为，松篁助秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其八十九","author":"曹勋","text":"岁华念将晚，寒色惨中抱。\n昔年困齑盐，拨灰吟苦调。\n老来适其适，所乐在燕笑。\n招宾共一醉，围炉不妨小。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其二十六","author":"曹勋","text":"真隐古招提，长林如磔猬。\n虽有群山峰，所欠一支水。\n草木乏秀润，岩窦燥肌理。\n安能借僧锡，卓处泉涌沸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其三十六","author":"曹勋","text":"尘境得闲适，尘事从如麻。\n且发蟹眼汤，一试鹰爪芽。\n萧萧衲帔冷，泠泠心境嘉。\n坐久若为侣，清月上梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七十","author":"曹勋","text":"人生不如意，十固常八九。\n吾辈穷物理，挺特惟所守。\n东风暖入律，客意浓胜酒。\n游鞍纵所如，宁能困圭窦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其十九","author":"曹勋","text":"北风忽捲热，山顶云已驰。\n日影未容敛，雨脚俄骤垂。\n一向得凉吹，四山横脩眉。\n暄寒本两陆，莫能测密移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其四十七","author":"曹勋","text":"海棠盛西蜀，豪压春风涂。\n三月浣花溪，游人鄙金珠。\n少陵时居瀼，诗史切太虚。\n独不被品藻，此理端何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其六十七","author":"曹勋","text":"台山邑万户，户以酒为天。\n不惮甑生尘，所愿酒如泉。\n多疾自曲糵，致夭非天年。\n因思禁酒法，积粟民沛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其五十三","author":"曹勋","text":"随春动草木，微和入池阁。\n群芳争妍媸，红翠媚寥廓。\n一枝姑到眼，万态便如昨。\n春深风雨来，固已任开落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其二十九","author":"曹勋","text":"朝来天无风，秋旸剧炎锐。\n当年屏翳动，松竹发清吹。\n风岂怜我老，飘萧翔异气。\n泠然濯烦襟，苏息殆天意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七十二","author":"曹勋","text":"山间气候晚，初冬菊英回。\n定俟开炉集，始送泛菊杯。\n渐列众色异，不殊东篱栽。\n冷雨与寒烟，深惜易尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其五十五","author":"曹勋","text":"从昔漫浪心，家居意不适。\n晨朝香火馀，饭了办游历。\n或访僧掇斋，或隐者对奕。\n归来任侵灯，龙吟喷霜笛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其六十五","author":"曹勋","text":"半夜秋风高，便觉残暑退。\n一凉精神醒，终夕枕簟愧。\n我老念病役，生病为形赘。\n永怀忘形友，寒暑孰能累。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其二十四","author":"曹勋","text":"客惠双井芽，千里冒寒暍。\n品格自高胜，香味两奇绝。\n小小猷溪磨，团团掌中月。\n挥肘喜旋之，纷泊看落雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七十四","author":"曹勋","text":"春雨要如膏，发生物已拆。\n霢霂则易耨，浸渍乃损麦。\n连旬不见日，过社麻亦阨。\n再拜祈开晴，民食庶可得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其二十三","author":"曹勋","text":"前岩有兰若，委径宜细履。\n未能望窣堵，屡复涉清泚。\n路纡疲脚力，僧老识茶味。\n策杖趁栖鸦，斜阳在林际。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其七十","author":"曹勋","text":"先生羲皇上，与物同逶迤。\n道伴杂然至，闲情示之希。\n蒲团茶味足，明窗情话迟。\n一室多入静，相见亦何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其三十三","author":"曹勋","text":"冰壶冻欲裂，霜风凌雪屋。\n牛斗搅夕眠，瓶笙不成曲。\n平生湖海心，弗受车辕促。\n晨兴且探梅，不惮肌生粟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居杂诗九十首 其四十六","author":"曹勋","text":"盖屋不在华，所欲庇风雨。\n种花品无繁，四时看开处。\n指喻多非约，日涉乃成趣。\n吾年能几日，景物亦漫与。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]