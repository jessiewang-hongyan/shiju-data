[{"title":"宿广教寺","author":"韩淲","text":"平生萧散喜登临，秋入溪山处处清。\n访古人传裴相国，寻诗我忆谢宣城。\n风回万木新霜净，云薄长空夕照明。\n更向僧窗閒徙倚，一樽谈笑为君倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26455,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广修寺","author":"韩淲","text":"石磴阴阴长薜萝，断崖飞练泻鸣波。\n雨收林麓翠光合，云净峰峦爽气多。\n万事身心毋固必，此时诗句欲如何。\n萧然便合归林去，已办犁锄著钓蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26456,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舜山寺","author":"韩淲","text":"风沙跋马度平原，眼底光阴几换年。\n霜气挟寒涵落日，云容薄暮带孤烟。\n经行野寺寻诗和，邂逅残僧把茗煎。\n束缚一官真自笑，可无清兴解鞍眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26457,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水西寺","author":"韩淲","text":"水西佳处为停车，不待丹青写作图。\n高下是山非甚远，回还随路未嫌迂。\n留连把盏欢才洽，迤逦支筇句不无。\n天地之间是閒客，也须容我醉歌呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26458,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访古寺","author":"韩淲","text":"一代文鸣能几人，要须终古景长新。\n我来盘礴古洲晚，君亦为开三径春。\n山远地平知得句，林疏花近有閒身。\n兹游颇快生双眼，相赏暂时情转亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26459,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四月旦小池新荷","author":"韩淲","text":"轻圆初泛水池荷，承露翻风不厌多。\n平旦气清舞蝶叶，午天人静戏鱼波。\n采莲他日当寻曲，梦草前时亦可歌。\n安得镜湖三百里，酒船回棹谪仙过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26460,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郑一长塘摘莲","author":"韩淲","text":"驱驴拽马趁初凉，棹了南齐上近庄。\n稚子偶携宁有谓，经生相谑最难量。\n酒因莲藕醉言泻，鸡配黄籼馌彼忙。\n多少壮心收不起，又撑小艇入长塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26461,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岩桂盛开因游步久之","author":"韩淲","text":"行到东家岩桂乡，花房浓密树身长。\n风行黄落留云影，雨出青空漏日光。\n已分角巾攲处折，未饶藜杖静中忙。\n山林寂寂归高隐，水石迢迢出远荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26462,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏海棠","author":"韩淲","text":"撩乱蒙笼黯淡中，海棠收叶尚藏红。\n燕支肯负匀妆浅，翡翠何贪剪刻工。\n酒病未苏还懊恼，春愁才解易怔忡。\n流芳催得年华老，又见啼莺转小丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26463,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春山看红梅","author":"韩淲","text":"年年常得醉君家，今日红梅正著花。\n点注初非桃有艳，横斜宁与李争华。\n依然竹外并林下，况复山颠与水涯。\n步绕孤根香更在，高怀无惜共流霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26464,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵红梅","author":"韩淲","text":"暗香疏影入深杯，人怪新妆不是梅。\n祇恐冰清惊俗眼，故移酒晕入花腮。\n兰生林处元同臭，杏满园时肯乱陪。\n迟日艳阳天气里，有欢赢得倒金罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26465,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"涧东临水饮梅花尚未全放一树独佳","author":"韩淲","text":"残雪馀寒二月来，涧东犹是欲开梅。\n夕阳影澹初寻句，流水声清更把杯。\n取友唤邻相领略，破荒择胜独徘徊。\n谁能折向南枝醉，一阵繁香扑麝煤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26466,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅下","author":"韩淲","text":"虽只霜浓春自浓，野梅无处不为容。\n半依古渡迷芳草，独与荒山对老松。\n绰约花房宜戏蝶，崔嵬枝干若游龙。\n角巾一幅支筇久，不觉烟中有寺钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26467,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅 其一","author":"韩淲","text":"雨边烟际总凄凄，已对灵山更玉溪。\n尽日凝情临野渡，几回乘兴步荒蹊。\n点红嫩蕊休攀折，带白新花费品题。\n多少岁寒孤绝处，空斋终夜听猿啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26468,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅 其二","author":"韩淲","text":"今年全未作梅诗，与向花边浪品题。\n不分雪霜摧剥尽，尚须天日照临之。\n静看冷蕊无人会，閒绕孤根只自知。\n犹有幽禽解鸣舞，为予酬酢殆移时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26469,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅 其三","author":"韩淲","text":"肯同桃李强搀春，自占空山野水滨。\n老气却因高树得，清姿不待数花新。\n本来澹泊难从俗，纵入纷华亦绝尘。\n最爱夜深霜重处，冷风吹起月精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26470,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅 其四","author":"韩淲","text":"山间梅已十分开，只欠襟怀与酒杯。\n细玩芳条珠错落，远迷高树雪培堆。\n喧迎晓日艳争发，寒度晚风香自来。\n安得幽人同一醉，长吟花底重徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26471,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅 其五","author":"韩淲","text":"繁花高树最宜晴，细雨横枝亦奈阴。\n色薄半开都有态，香浓初谢转伤情。\n水边却恨无多子，山嘴尤怜太瘦生。\n驿使折来春信早，单于吹罢角声清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26472,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅 其六","author":"韩淲","text":"腊后春归草木初，谁知芳树绕吾庐。\n风前有恨香仍远，月下无人影自虚。\n可是酒杯能慰藉，尚须诗句与消除。\n西湖东阁今何似，愁绝飞花过眼疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26473,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀山中梅花","author":"韩淲","text":"踏雪寻梅浅浅山，酒醺诗恼肯从还。\n推敲忽在人烟外，酬酢更逢篱落间。\n迫晚昏寒乘野逸，爱香凌乱任宽閒。\n素衣尘土今如许，花底空窥豹一斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26474,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"看梅","author":"韩淲","text":"小园春早喜梅开，烟敛风回月色来。\n香细静知宜竹树，影孤清与散莓苔。\n幽幽山嘴疏钟韵，耿耿楼头画角哀。\n自笑年年被花恼，十分情味为衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26475,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中看梅一二家小酌","author":"韩淲","text":"春雨梅花湿小园，断桥流影动黄昏。\n人家节近多留话，故旧閒中或置樽。\n落落雁飞知隔浦，荒荒犬吠是前村。\n市廛只在烟林外，但恐溪添野水浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26476,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十七日朱上饶招看梅王干吴推不至","author":"韩淲","text":"涧谷閒人与探梅，小楼红蕊万枝开。\n临风便合寻吟笔，尽夜翻劳置酒杯。\n郡将倅车将欲至，治台莲幕不能来。\n官忙自是无穷事，且对弦歌言偃哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26477,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"禅月台看梅","author":"韩淲","text":"晴日禅台一树梅，似愁非怨向人开。\n地销腊雪扶疏起，天近春云婀娜来。\n立尽竹根空浩荡，坐移山顶更徘徊。\n凌风却月诗何在，全藉清香发酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26478,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"探梅 其一","author":"韩淲","text":"探梅山路一杯亭，日澹风微远霭生。\n莫问古来寻古话，只知春近赏春情。\n几枝冷蕊吟方见，一点疏花画不成。\n我挟两儿同二友，老年酒外更何营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26479,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"探梅 其二","author":"韩淲","text":"点检山前梅蕊痕，花虽未放已销魂。\n纵饶老干摧幽谷，也胜繁华倚市门。\n冷落不成欺岁晚，阳和且可待春温。\n清香一喷红梢满，却月凌风未易论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26480,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"探梅天气极思山中之时也","author":"韩淲","text":"霜馀晴后探梅天，村岸山蹊接野田。\n时见樵夫能指点，旋寻僧子或留连。\n所携酒榼无多尔，其就诗篇亦偶然。\n一两枝横三四蕊，最风情处带轻烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26481,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"涧上蜡梅香甚","author":"韩淲","text":"照眼花枝是蜡梅，香传小树为谁开。\n弄阴欲雪山长暝，破晓终风水漫洄。\n鸟语春声喧复静，鸿飞寒影去还来。\n数间败屋浮桥外，何故无吟不举杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26482,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"木樨有怀赵十","author":"韩淲","text":"桂树丛生花发时，雨垂风约更相宜。\n休将睡眼寻常看，漫说吟情未易知。\n我岂东西思领会，君应彼此较襟期。\n冠秋轩与山堂近，红玉香消翡翠卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26483,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野趣轩夜坐煮茶栗瓶中木樨香甚","author":"韩淲","text":"窗静明灯看木樨，秋声吹雨欲凄凄。\n馀凉倍觉花撩乱，尽夜尤宜叶整齐。\n瓶浸冷香书案小，座围幽艳屋山低。\n从容茶果归来处，桥踏涧云迷断蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26484,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十八日野趣轩","author":"韩淲","text":"雨湿芙蓉绿映红，池塘秋净晚濛濛。\n水痕已下归蘋浅，岚气初寒入树空。\n僧寺半依山路外，人家多在郡城中。\n一桥隔断溪南景，天以闲窗付秃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26485,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瑞香","author":"韩淲","text":"花如素馨微较密，叶似杨梅团且长。\n石竹染成鱼尾色，辛夷吹得麝脐香。\n移根雅入芝兰室，得种迥非桃李场。\n小槛平林暗芳草，一轩轻露湿朝阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26486,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬日玉色木芍药","author":"韩淲","text":"便觉风和满县新，一枝欺雪长精神。\n东皇不肯群芳谢，南国先回百里春。\n檐外早梅犹隐约，篱边残菊已纷纶。\n河阳善政催花发，如见霓裳舞太真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26487,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舒彦升运管以诗送来禽次韵","author":"韩淲","text":"老眼相望肯作疏，来禽仍与好诗俱。\n清新更觉珠玑满，甘脆还知草木区。\n此道在公谁复有，一官希世我如无。\n两峰赵叟尤堪笑，绝口轻肥只自癯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26488,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金来禽","author":"韩淲","text":"手种来禽已可嘉，纷然凡木正芳华。\n人间那有黄金蕊，天上生成红玉花。\n却怪风流迷野路，也如富贵在山家。\n病馀杯酒浑无绪，空撚吟髭到日斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26489,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹院摘橘","author":"韩淲","text":"郴阳犹记苏耽井，书后空题应物诗。\n屋角数枝垂熟日，人家同饮过来时。\n清霜尤美还经眼，噀雾微酸不上眉。\n竹院未饶仙老胜，洞庭何似玉溪湄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26490,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"笋出可爱","author":"韩淲","text":"雨收馀润散晴皋，岸曲篱前首重搔。\n不恨孤花春后少，最怜疏笋夜来高。\n市声隔水销尘滓，鸟影空山落羽毛。\n物外幽人元未减，自量閒品颇清豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26491,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪天窗前寒鸦","author":"韩淲","text":"寒窗曙色听鸣鸦，檐外梅梢苦未花。\n冉冉青山风落木，凄凄碧涧水流沙。\n相逢客子两三辈，指点比邻四五家。\n自是幽栖有馀味，又凭浊酒兴无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26492,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赵农丞","author":"韩淲","text":"祝融紫盖潇湘水，已是离骚更著秋。\n仕宦有时还潦倒，人生何地不周游。\n久持庾节身长健，才乏奚囊意必遒。\n我老重加交旧少，望馀风叶冷啾啾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26493,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵簿留饮望城里海棠因思履道且寄民瞻","author":"韩淲","text":"相望海棠思故人，最高台是北城闉。\n看来先自花饶笑，兴到从他酒入唇。\n语燕既归惊作社，盟鸥何在且行春。\n妙年秀发如君少，桃李纷纷只世尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26494,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再寄吴推官","author":"韩淲","text":"中秋天气桂花发，正尔商量一首诗。\n忽喜得书开复看，相思如梦见还疑。\n偶然写句封题去，何用成篇和答为。\n佳处因君又重赋，月明叶落满庭垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26495,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄彦升九日前一日饮其家","author":"韩淲","text":"稻田陂水菊花天，新筑轩窗醉酒边。\n情味故人如昨日，襟期閒客又今年。\n沉思节序俱同梦，剩赏风光甚欲仙。\n屋上青山展图画，雁翻秋影下平川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26496,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵履常湖北仓经过因话昔惘然久之","author":"韩淲","text":"俛仰之间又一年，旧游新话两茫然。\n惊心会聚初何所，满意飞腾不在边。\n眇眇桃宫聊记取，峨峨芸阁久回旋。\n岁寒玉雪清冰地，才著纤尘是市廛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26497,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄周正字","author":"韩淲","text":"长洲茂苑关门睡，忘却蓬山梦里游。\n尔雅一生无浊见，离骚千古有清愁。\n涝田检放难终岁，寒事经营易得秋。\n欲寄潜鳞寻过翼，望穷云海复悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26498,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时子其泊城外姚寺因问讯之","author":"韩淲","text":"隔河城里扑京尘，占得僧窗景自新。\n酒泛椒花知逼岁，瓶簪梅蕊欲争春。\n乾坤可是无閒客，湖海元非有旅人。\n老去壮心空不已，雪花垂地雨尤真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26499,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄张饶县","author":"韩淲","text":"涟漪清浸碧崔嵬，玉水灵山夕照开。\n陶令风流非偶尔，孟嘉嘲笑亦何哉。\n偶因别乘闲吹帽，想复同僚正举杯。\n去岁相从最为乐，黄花明日又徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26500,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十三日宿舒料院家因以寄料院","author":"韩淲","text":"书林猿鹤依然好，风月飞翔正啸啼。\n下榻留连又家塾，舆篮来往几芳蹊。\n但知旧隐依清樾，想见新班照紫泥。\n小醉微吟因一寄，斯民寿域待公跻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26501,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄林秘书","author":"韩淲","text":"瓮篘初熟二螯肥，空水生寒脱叶稀。\n北阙既尝縻爵服，西畴但且理牛衣。\n由来意气多忘老，到底功名却欠归。\n冰玉故人真耐久，湖山相望翠烟霏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26502,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"骏仲小三哥调选言还并寄巽伯上舍","author":"韩淲","text":"丽泽之风又一传，可堪诸老久沉泉。\n逢人尽道能尊事，逐物那知不变迁。\n邦邑祠堂应自若，朝家恤典为谁然。\n相思相见还相别，难弟难兄更著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26503,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵仲至雪句兼寄朴翁","author":"韩淲","text":"长安一片雪冬深，胜士骚人只苦吟。\n可是顿忘它日志，也非深惜此时心。\n细看北阙吴山下，暗想西湖葛岭阴。\n搜到诗家难到处，掉头应不管寒侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26504,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赵十监试","author":"韩淲","text":"夜凉月里话东征，倾耳呼猿洞水声。\n玉室金堂元避世，鲈鱼莼菜岂惩羹。\n举围个个三年试，云路家家万里程。\n在我能为古之制，裕陵图治重宗盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26505,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赵成父鄱阳就养","author":"韩淲","text":"荐福碑前水满湖，芝山携酒看来无。\n老閒就养身须逸，岁晚逢时兴不辜。\n岸帻以来谁在座，课经而后自开炉。\n春稍迤逦梅须好，安得相从一笑呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26506,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赵正字秀倅员外置","author":"韩淲","text":"仅得相从又隔州，梅边花信尚悠悠。\n苍茫有句虽能寄，黯淡无觞可奈搜。\n须信山林愁不密，岂云江海要横流。\n邴丹仕宦应聊尔，岁月空催人白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26507,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄刘小山武子老丈 其一","author":"韩淲","text":"秦淮东畔得诗人，踏尽前朝陌上尘。\n寺外残阳见光宅，苑迷芳草忆临春。\n空馀王气金陵古，犹带歌声玉树新。\n羸马倦童应独往，旧时明月恐伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄刘小山武子老丈 其二","author":"韩淲","text":"翠微秋影浪吟时，一片才情杜牧之。\n不望上天容此老，只忧无地著群儿。\n岁华荏苒疏音信，人事凄凉有别离。\n日暮江东云合处，小山丛桂是吾师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄巩仲至","author":"韩淲","text":"清言犹可诵君诗，落在人间一任之。\n霜后钱塘寒自觉，腊前闽粤煖还宜。\n坐搔秃发苏残困，俯援长毫写旧思。\n二雅以还情义短，陇梅欲寄未开枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄斯远","author":"韩淲","text":"夜深踏月过章邱，树影吹凉满地流。\n不觉身从城市到，以为人共广寒游。\n数家小屋全然静，一点浮云也自收。\n天下中秋谁有比，归来清梦尚悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄永嘉叶丈以昌甫韵","author":"韩淲","text":"谁云遣兴莫过诗，诗到清愁只自知。\n老去山林能几许，近来香火复奚为。\n随身作务何须较，脱手成文不费辞。\n宿觉庵高飞梦到，一春花柳更无私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵路分寄昌甫","author":"韩淲","text":"金仙寺下章泉水，幽讨荒寻梦亦清。\n半世奉祠非禄隐，穷年稽古只书生。\n深居肯以它人重，懒出应于外物轻。\n好是二徐来问学，更欣同姓得诗声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄昌甫斯远","author":"韩淲","text":"重阳未见黄花发，满眼青山如故人。\n且把长言索佳句，应搔短发任閒身。\n篱边千载陶元亮，谷口今时郑子真。\n屈指交游久零落，勿云情异与心亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄李半村商叟老丈","author":"韩淲","text":"不到前村五六年，春帆便合上溪船。\n桃花浪暖鱼初出，燕子风轻柳欲眠。\n海内知名今有几，古来是事总如然。\n茶山衣钵分明在，相望閒吟寄谪仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄王干","author":"韩淲","text":"闽粤榕青蕉子红，年光当付酒杯中。\n推愁顾此欢无策，作兴从渠醉有功。\n犴狱赞台居上幕，藩方连帅近元戎。\n雨岩风雪应回首，我老穷山更忆公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"数年不与李商叟书忽书来一诗寄之","author":"韩淲","text":"正始之风固寂寥，茶山犹有半村高。\n静观世变慵招隐，闲赋诗章定广骚。\n深信老怀能自适，遥知好事不常遭。\n秋来醉拥残书卧，鼻鼾吹红气转豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26517,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄昌甫","author":"韩淲","text":"章丘死矣章泉老，经月何为不寄诗。\n世事易教闲里过，古心难以众人知。\n莫因开径思来往，只合深居叹别离。\n矗矗灵山终不变，芜城吹角暮云垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26518,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]