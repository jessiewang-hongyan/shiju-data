[{"title":"卜算子 其三","author":"徐俯","text":"清池过雨凉，暗有清香度。\n缥缈娉婷绝代歌，翠袖风中举。\n忽敛双眉去。\n总是关情处。\n一段江山一片云，又下阳台雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子","author":"徐俯","text":"胸月千种愁，插在斜阳树。\n绿叶阴阴自得春，草满莺啼处。\n不见凌波步，空想如簧语。\n柳外重重叠叠山，遮不断愁来路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子 其二","author":"徐俯","text":"天生百种愁，挂在斜阳树。\n绿叶阴阴占得春，草满莺啼处。\n不见生尘步。\n空忆如簧语。\n柳外重重叠叠山，遮不断、愁来路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇","author":"徐俯","text":"素光练静，照青山隐隐，修眉横绿。\n鳷鹊楼高天似水，碧瓦寒生银粟。\n万丈辉光，奔云涌雾，飞过卢鸿屋。\n更无尘翳，皓然冷浸梧竹。\n因念鹤发仙翁，当时曾共赏，紫岩飞瀑。\n对影三人聊痛饮，一洗闲愁千斛。\n斗转参移，翻然归去，万里骑黄鹄。\n一川霜晓，叫云吹断横玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南歌子 山樊","author":"徐俯","text":"细蕊黄金嫩，繁花白雪香。\n共谁连璧向河阳。\n自是不须汤饼、试何郎。\n婀娜松髻，轻盈淡薄妆。\n莫令韩寿在伊傍。\n便逐游蜂惊蝶、过东墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙","author":"徐俯","text":"章水何如颍水清。\n江山明秀发诗情。\n七言还我是长城。\n小小钿花开宝靥，纤纤玉笋见云英。\n十千名酒十分倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其二","author":"徐俯","text":"新妇矶边秋月明。\n女儿浦口晚潮平。\n沙头鹭宿戏鱼惊。\n青箬笠前明此事，绿蓑衣底度平生。\n斜风细雨小舟轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其一","author":"徐俯","text":"西塞山前白鹭飞。\n桃花流水鳜鱼肥。\n一波才动万波随。\n黄帽岂如青箬笠，羊裘何似绿蓑衣。\n斜风细雨不须归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人","author":"徐俯","text":"梅花元自江南得。\n还醉江南客。\n雪中雨里为谁香。\n闻道数枝清笑、出东墙。\n多情宋玉还知否。\n梁苑无寻处。\n胭脂为萼玉为肌。\n却恨恼人桃杏、不同时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其三","author":"徐俯","text":"玉露团花，金风破雾。\n高台与上晴空去。\n举杯相属看前山，烟中乱叠青无数。\n皓齿明眸，肌香体素。\n恼人正在秋波注。\n因何欲雨又还晴，歌声遏得行云住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其一","author":"徐俯","text":"素景将阑，黄花初笑。\n登高一望秋天杳。\n邀宾携妓数能来，醉中赢得闲多少。\n佳气氤氲，飞云缥缈。\n竹林更着清江绕。\n高歌屡舞莫催人，华筵直待华灯照。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其二","author":"徐俯","text":"画栋风生，绣筵花绕。\n层台胜日频高眺。\n清辉爽气自娱人，何妨称意开颜笑。\n水碧无穷，山青未了。\n斜阳浦口归帆少。\n云鬟烟鬓只供愁，琵琶更作相思调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"徐俯","text":"宜笑宜颦掌上身。\n能歌能舞恶精神。\n脸边红入桃花嫩，眉上青归柳叶新。\n娇不语，易生嗔。\n尊前还是一番春。\n深杯百罚重拚却，只为妖饶醉得人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"徐俯","text":"西塞山前白鹭飞。\n桃花流水鳜鱼肥。\n朝廷若觅元真子，晴在长江理钓丝。\n青箬笠，绿蓑衣。\n斜风细雨不须归。\n浮云万里烟波客，惟有沧浪孺子知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"徐俯","text":"七泽三湘碧草连。\n洞庭江汉水如天。\n朝廷若觅元真子，不在云边则酒边。\n明月棹，夕阳船。\n鲈鱼恰似镜中悬。\n丝纶钓饵都收却，八字山前听雨眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"徐俯","text":"满眼纷纷恰似花。\n飘飘泊泊自天涯。\n雨中添得无穷湿，风里吹成一道斜。\n银作屋，玉为车。\n姮娥青女过人家。\n应嫌素面微微露，故着轻云薄薄遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天","author":"徐俯","text":"绿水名园不是村。\n淡妆浓笑两生春。\n笛中已自多愁怨，雨里因谁有泪痕。\n香旖旎，酒氤氲。\n多情生怕落纷纷。\n旧来好事浑如梦，年少风流付与君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仙人石","author":"徐圆老","text":"花开炫红霞，景接长春壑。\n终古斯石存，苍苔涴双脚。\n安得洞仙来，重游跨白鹤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠梅山顾先生","author":"徐容斋","text":"钱塘诗老顾梅山，乡校孤吟乐一箪。\n修翼分甘栖宿下，短章功到寂寥间。\n呕心长吉奚奴锦，染指昌黎白玉丹。\n好句真能换凡骨，觉君春色上苍颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冷泉亭","author":"徐涓","text":"畏日炎炎烁太虚，倚栏冰雪冷生肤。\n百川万壑非无水，洗得人间热恼无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠閤门潘舍人","author":"徐珩","text":"清跸声中玉笋班，五云光里侍天颜。\n至尊端拱通明殿，上閤来从饭颗山。\n旄节行将千骑去，鬓须全未一根斑。\n朝回两袖香烟满，应有诗留雉扇间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以水石菖蒲赠谷堂孙漕","author":"徐珩","text":"菖蒲体柔弱，孤生幽涧傍。\n涧深水不滋，短叶疏而黄。\n物亦有不幸，仁者为悲伤。\n愿因水石间，移植近窗光。\n探丸起九死，焦捲复翠长。\n草木固无知，此心未能忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉歌","author":"徐珩","text":"得谁酿法乃尔佳，连引数杯极口誇。\n须臾忘物亦忘我，是非荣辱不可加。\n儿童相随拍手笑，阿翁醉也扶归家。\n平生故人赵半刺，遣骑折送园中花。\n插花饮酒不待劝，夜如何其月欲斜。\n倒著接䍦自起舞，笛声趁拍鼓三挝。\n陶陶兀兀意有得，小姬在傍双髻丫。\n驱令磨墨具纸笔，满幅大草飞龙蛇。\n妇云汝醉当止矣，明日酒醒不愧耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠黄鲁直","author":"徐积","text":"不见故人弥有情，一见故人心眼明。\n忘却问君船住处，夜来清梦绕西城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花下饮","author":"徐积","text":"我向桃花下，立饮一杯酒。\n杯酒先濡须，花香随入口。\n花为酒家媪，春作诗翁友。\n此时酒量开，酒量添一斗。\n君看陌上春，令人笑拍手。\n半青篱畔草，半绿畦中韭。\n闲乌下牛背，奔豚穿狗窦。\n潜身猫相雀，引喙禽呼偶。\n包麻邻乞火，穿桑儿饷糗。\n物类虽各殊，所乐亦同有。\n谁知花下情，犹能忆杨柳。\n中心卒无累，外物任相揉。\n余方寓之乐，自号閒人叟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭张六","author":"徐积","text":"欲视目已瞑，欲语口已噤。\n欲动肉已寒，欲书手已硬。\n惟有心上热，惟存心中悲。\n此热须臾閒，此悲无休时。\n所悲孤儿寒，所悲孤儿饥。\n苦苦复苦苦，此悲遂入土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中咏牡丹","author":"徐积","text":"此花未开时，美子藏深闺。\n香心若无有，深浅何由知。\n前日花忽开，美人放出深闺来。\n春风尽日不相管，莺是郎兮蝶是媒。\n谁将金钱掷西子，笑中不掩燕脂腮。\n君王亲执紫金盏，太真又醉白瑶台。\n此花万态不可说，莫教容易为尘埃。\n我心虽然淡如水，为花一醉何辞哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔父乐 其三 堪画看","author":"徐积","text":"讨得渔竿买得船，归休何必待高年。\n深浪里，乱云边，只有逍遥是水仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔父乐 其一","author":"徐积","text":"水曲山隈四五家，夕阳烟火隔芦花。\n渔唱歇，醉眠斜，纶竿蓑笠是生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔父乐 其四 谁学得","author":"徐积","text":"饱则高歌醉即眠，只知头白不知年。\n江绕屋，水随船，买得风光不著钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔父乐 其六 君不悟","author":"徐积","text":"一酌村醪一曲歌，回看尘世足风波。\n忧患大，是非多，纵得荣华有几何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔父乐 其二 无一事","author":"徐积","text":"见说红尘罩九衢，贪名逐利各区区。\n论得失，问荣枯，争似侬家占五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔父乐 其五 君看取","author":"徐积","text":"管得江湖占得山，白云同散学云閒。\n清旦出，夕阳还，不知身在画屏閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石井泉 其三","author":"徐谊","text":"发挥有待天须靳，隐显人间未得知。\n翰林主人工墨客，它年稚子亦能诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石井泉 其二","author":"徐谊","text":"川原膴膴小曾峦，千古英雄剑气寒。\n渗漉仁风并义泽，只今光燄在毫端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石井泉 其一","author":"徐谊","text":"布谷催春又一年，使君风旆为翩然。\n清冷彻处真无际，果见灵源发漏泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谪官南康军","author":"徐谊","text":"花飞片片上衣襟，拾得飞花寘柳阴。\n莫遣便随流水去，东君应有惜花心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游沩山","author":"徐谊","text":"我行之宜阳，便作大仰游。\n上有参天松，下有漱石流。\n群峰拱梵宇，层层閟清幽。\n老禅雅爱客，要作数日留。\n泉石疗我饥，竹风销我忧。\n征尘积经年，可以少涤不。\n绝胜秋江上，独钓沧浪舟。\n所恨招不来，莫我更唱酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴越王庙","author":"徐起滨","text":"天晴四塞霭苍苍，古殿秋阴下夕阳。\n急管向传流水咽，残碑空覆落花香。\n绵坳钱库遗千载，涧藻溪毛祀一乡。\n玉辇不游芳草合，屯云翠盖寄寒螀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"徐逢年","text":"贤侯作意苏民瘼，常念比邻有馁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张淡道人","author":"徐逢原","text":"铁笛爱吹风月夜，夹衣能御雪霜天。\n伊予试问行年看，笑指松筠未是坚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"殢人娇","author":"徐都尉","text":"小苑藏春，信道游人未见。\n花脸嫩、柳腰娇软。\n停觞缓引，正夕阳将晚。\n莺误入，蹴损海棠花片。\n只怅春心，当时露见，小楼外、曾劳目断。\n灯前料想。\n也饥心饱眼。\n从此去，萦心有人可惯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"徐庾","text":"程旼当年一匹夫，不操三尺正群愚。\n片言能使争心息，万里江山姓与俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"双井图","author":"徐得之","text":"异时生出鬼门关，及去宜州竟不还。\n意者早知名是累，持锄应只在家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉笥山","author":"徐得之","text":"江作挼蓝绕髻鬟，令君心事每相关。\n要令白叟黄童辈，如在清江碧嶂间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试双井茶","author":"徐得之","text":"先生老作宜州鬼，谁与一瓯注深汤。\n至今捧看双井碗，犹带是翁书传香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题双井堂","author":"徐得之","text":"凤凰山畔永思堂，山谷先生有旧乡。\n修水年年流不尽，斯文长与日争光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"明妃曲","author":"徐得之","text":"妾生岂愿为胡妇，失信宁当累明主。\n已伤画史忍欺君，莫使君王更欺虏。\n琵琶却解将心语，一曲才终恨何数。\n朦胧胡雾染宫花，泪眼横波时自雨。\n专房莫倚黄金赂，多少专房弃如土。\n宁从别去得深嚬，一步思君一回顾。\n胡山不隔思归路，只把琵琶写辛苦。\n君不见有言不食古高辛，生女无嫌嫁盘瓠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"徐得之","text":"乃翁画灰教儿书，娇儿赤骭玉雪肤。\n厥妻曝日补破襦，弊筐何有金十奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荐痴绝禅师","author":"徐敏","text":"痴绝有庵不肯住，弄月挑云径山去。\n地水火风分裂时，亲书赠予黄葛布。\n蜕封读罢咽无语，会得龙须能避暑。\n岂知玉骨本清凉，书则珍藏布不取。\n源老忽踏幽深路，道在隔山遥望处。\n巨帙已载烂葛藤，何堪又送閒家具。\n开眼一看笑呵呵，犹有这个可奈何。\n来而不往非世法，聊效芹忱愧不多。\n两角茶，十袋面，宝瓶飞钱五十万。\n虔心献此一瓣香，奉为禅师作清荐。\n且问先师来不来，玉山庵顶白云开。\n更烦大众打圆相，拨取青莲火里灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤山禅寺","author":"徐梦发","text":"百役红尘吏，过门一解鞍。\n频来无事干，孤坐有山看。\n留月不掩户，招风长倚栏。\n马嘶催去路，吾道尚盘桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"支提禅寺","author":"徐梦发","text":"来谒支提古道场，几年袍锦韵犹香。\n芙蓉梦里僧趺坐，薝卜林中佛放光。\n禅语了参一宿觉，尘缘顿悟半生忙。\n若分座下龙王水，免使春田待插秧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龟山祷雨","author":"徐梦发","text":"久困焦熬里，持香谒二禅。\n会留一宿觉，了得寸心缘。\n鹤识小溪路，钟闻上界天。\n龙湫分勺水，法海遍三千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"超览亭","author":"徐梦发","text":"壬子岁二月，亭成始宴宾。\n扁题原用旧，轮奂喜更新。\n远眺江逾碧，静观山自春。\n亭边山更好，一洗簿书尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉太平","author":"徐梦龙","text":"冰肌玉容。\n情真意浓。\n小楼几度春风。\n醉琉璃酒钟。\n关山万重。\n何时又逢。\n思量雨迹云踪。\n似襄王梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和高庙净明院梅岩御制韵二首 其二","author":"徐清叟","text":"偶因祀事访丹霞，寺古山深石径斜。\n冲冻细寻梅信息，枝头喜见状元花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和高庙净明院梅岩御制韵二首 其一","author":"徐清叟","text":"千年奎画照苍霞，酬唱官梅竹外斜。\n恭想皇灵天阙上，归疆犹惜洛阳花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠建宁妓唐玉","author":"徐清叟","text":"上国新行巧样花，一枝聊插鬓云斜。\n娇羞未肯从郎意，故把芳容半面遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"癸丑十月二日上天竺寺祈晴","author":"徐清叟","text":"金泥滑滑溅雕鞍，虔走禋祠谒宰官。\n积雨水添湖面阔，久阴云护岭头寒。\n妨收是处田家苦，开霁何时后土乾。\n现出日光须佛力，少令忧国寸心宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄贾平章","author":"徐清叟","text":"扑面京尘鬓影华，杜鹃声底客思家。\n久陪宰相堂中食，五拜夫人庙里花。\n和气薰蒸由地主，孤根容易发天葩。\n双壶走迸悭琼报，聊寄头纲六饼茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题会江驿","author":"徐清叟","text":"高阁盈千尺，征人借一栖。\n水连天上下，山会浙东西。\n炊甑荣枯幻，浮云出处齐。\n感时心欲醉，风雨更凄迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠常庵江羽士","author":"徐清叟","text":"九曲溪头活计，三生石上精魂。\n沓沓閒云何处，空山明月啼猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞鹤仙","author":"徐理","text":"暮霞红映沼。\n恨柳枝疏瘦，不禁风搅。\n投林数归鸟。\n更枯茎敲荻，糁红堆蓼。\n江寒浪小。\n雁来多、音书苦少。\n试看尽，水边红叶，不见有诗流到。\n烦恼。\n凭阑人去，枕水亭空，路遥天杳。\n情深恨渺。\n无计诉与伊道。\n漏声催，门外霜清风细，月色今宵最好。\n怎割舍，美景良时，等闲睡了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"村居","author":"徐逸","text":"酸甜半熟山头果，红白争开屋角花。\n柴户不关春睡足，太平多在野人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花","author":"徐逸","text":"咸平处士风流远，招得梅花枝上魂。\n疏影暗香如昨日，不知人世几黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶题","author":"徐逸","text":"病身郁屋等惊蛇，埃?何堪举手遮。\n四海知心是明月，一生结客得梅花。\n风摇酒浪红鳞小，香暖歌云翠葆斜。\n休问画桥西去路，要凭消遣旧生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昼眠治平寺","author":"徐逸","text":"频年游览不暂寘，野艇往来无水程。\n雨休最好是鸥浴，风静更清闻鹤声。\n酒家新熟欠前账，僧榻借眠馀宿酲。\n崧高泰华未挂眼，鬓影萧飒难为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":53933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]