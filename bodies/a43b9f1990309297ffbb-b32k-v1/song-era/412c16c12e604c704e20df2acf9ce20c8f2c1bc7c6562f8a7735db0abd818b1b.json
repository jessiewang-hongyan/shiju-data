[{"title":"春雨不止二首 其二","author":"杨万里","text":"春雨如毛又似埃，云开还合合还开。\n怪来春晚寒如许，无赖桐花领取来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雨不止二首 其一","author":"杨万里","text":"无计奈何春日长，宰予介绍谒羲皇。\n蚁才问阵天又雨，蜂欲舂粮花政香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春草二首 其二","author":"杨万里","text":"年年春色属垂杨，金撚千丝翠万行。\n今岁草芽先得计，搀它浓翠夺它黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春草二首 其一","author":"杨万里","text":"天欲游人不踏尘，一年一换翠茸茵。\n东风犹自嫌萧索，更遣飞花绣好春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晓三首 其三","author":"杨万里","text":"一年生活是三春，二月春光尽十分。\n不必开窗索花笑，隔窗花影也欣欣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晓三首 其二","author":"杨万里","text":"风光明淑奈渠何，非暖非寒直是和。\n春到千花俱有分，海棠独自得春多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晓三首 其一","author":"杨万里","text":"拂花红露溅春衣，柳外春禽睡未知。\n天借晴光与桃李，更将剩彩弄游丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春望二首 其二","author":"杨万里","text":"掠削娇云放嫩晴，三朝五日即清明。\n垂杨幸自风流杀，莫著啼乌只著莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春望二首 其一","author":"杨万里","text":"春光放尽百花房，开到林檎与海棠。\n青却子城千树柳，高枝犹有一梢黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春梦纷纭","author":"杨万里","text":"烛花半作紫芝开，诗兴频遭白雨催。\n只有睡时愁可遣，春愁又向梦中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春寒","author":"杨万里","text":"风日晴暄一并来，桃花告报李花开。\n待君减尽衣裘了，夜半春寒特地回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春寒","author":"杨万里","text":"春寒尽解粟人肤，敢傍吾侪酒盏无。\n雨里杏花如半醉，抬头不起索人扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春寒","author":"杨万里","text":"阵阵风寒树树斜，不容老子出檐牙。\n绣帘半捲门偏启，深倚胡床远看花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春寒初晴","author":"杨万里","text":"峭寒穿屋透衣裘，欺得诗人两鬓秋。\n从此莫教三日暖，花开花落却成愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春寒绝句","author":"杨万里","text":"几丝微雨噀前山，半点轻寒健牡丹。\n只道一春晴较少，到它晴了是春残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中送客有感","author":"杨万里","text":"不知春向雨中回，只道春光未苦来。\n老子今晨偶然出，李花全落郑花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春暖郡圃散策三首 其三","author":"杨万里","text":"春禽处处讲新声，细草欣欣贺嫩晴。\n曲折遍穿花底路，莫令一步作虚行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春暖郡圃散策三首 其二","author":"杨万里","text":"萱草行间过履絇，杏花影里散文书。\n秋风遣我疏团扇，又被春风遣唤渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春暖郡圃散策三首 其一","author":"杨万里","text":"已觉朝来退裌衣，日光风力软如痴。\n倩谁留许春寒著，更放梅花住少时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昼倦","author":"杨万里","text":"爱日曛人欲睡昏，自匀嫩火炷炉薰。\n蜘蛛已去惟存网，犹罥窗间一只蚊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昼倦","author":"杨万里","text":"睡眼䰒松倦日长，却抛诗卷步回廊。\n狸奴幸自双双戏，忽见人来走似獐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳色","author":"杨万里","text":"春到四经旬，元来未见春。\n柳条将软碧，争献上番新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"残菊","author":"杨万里","text":"肠断黄花霜后枝，花乾叶悴两离披。\n一花忽秀枯丛里，更胜初开乍见时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"毗陵郡斋冬至晴寒","author":"杨万里","text":"竹屋消残半瓦霜，冰河冻裂一渔航。\n不须宫线量曦影，化日今年特地长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"毗陵辞满出舍添倅厅","author":"杨万里","text":"小住丞厅更一旬，客魂先入故乡春。\n未离鼓角声中梦，已是谯门外面人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泉石轩初秋乘凉小荷池上","author":"杨万里","text":"芙蕖落片自成船，吹泊高荷伞柄边。\n泊了又离离又泊，看它走遍水中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洗面绝句","author":"杨万里","text":"浙山两岸送归艎，新捣春蓝浅染苍。\n自汲江波供盥漱，清晨满面落花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"济翁弟赠白团扇子一面作百竹图有诗和以谢之","author":"杨万里","text":"月波初上涌寒金，桂树风来细有音。\n特地此君偏作恼，为侬隔却半轮阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牵牛花三首 其三","author":"杨万里","text":"晓思欢欣晚思愁，绕篱萦架太娇柔。\n木犀未发芙蓉落，买断西风恣意秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸丑正月新开东园","author":"杨万里","text":"长恨无钱买好园，好园还在屋东边。\n周遭旋辟三三径，只怕芒鞋却费钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"皇恐滩三首 其三","author":"杨万里","text":"小烦溪友语阳侯，好遣漂沙盖石头。\n能费奔流多少力，前头幸有一沙洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"皇恐滩三首 其二","author":"杨万里","text":"只愁江水去无还，石打银涛倒上滩。\n道是此滩天下恶，古今放过几樯竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"皇恐滩三首 其一","author":"杨万里","text":"两山夹岸走苍龙，未放中间过玉虹。\n只爱当头一峰好，一峰外面更三峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"省中见树上啄木鸟戏题","author":"杨万里","text":"一啄高高一啄低，一声声急一声迟。\n可怜去蠹劳心口，蚁入枯梨自不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"省中直舍因敲新竹怀周元吉三首 其三","author":"杨万里","text":"老竹坚刚幼竹柔，此君年少也风流。\n锦衣脱体未全瘦，雪粉围腰犹半愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"省中直舍因敲新竹怀周元吉三首 其二","author":"杨万里","text":"尚有周郎手种痕，怀人将竹当人看。\n寄言黄鹤楼前客，今岁新添十五竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"省中直舍因敲新竹怀周元吉三首 其一","author":"杨万里","text":"老眼逢书怯细看，抄书一事更应难。\n昨携如意敲新箨，右臂朝来作许酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"省中新柳","author":"杨万里","text":"元日新春已早归，却缘春雪勒春迟。\n一年柳色今何似，政是犹黄未绿时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"看小舟除萍二首 其二","author":"杨万里","text":"岁岁荷花苦未多，绿萍盖水碍新荷。\n请君六月重来看，云锦千机不犯梭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"看小舟除萍二首 其一","author":"杨万里","text":"花伴吟哦柳伴行，生憎庭外晚衙声。\n独携便面巡荷沼，自课兰舟掠水萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"看画常州图迎新太守","author":"杨万里","text":"画工吮笔画常州，老子来看却自羞。\n若遣此图还解语，道侬调戏几君侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"看雪","author":"杨万里","text":"揉云剪水作风毬，夜落连明肯便休。\n旧说六花元未试，偶看一片上驼裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"神堂铺前桃花","author":"杨万里","text":"北江二月政春寒，初见桃花喜未残。\n腊月潮州见桃李，元来不作好春看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夕不寐二首 其一","author":"杨万里","text":"每到炎天只愿秋，如何秋到却成愁。\n官居也有寒蛩语，不似山间听得幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夕不寐二首 其二","author":"杨万里","text":"夏热通宵睡不成，秋凉老眼又偏醒。\n窗虚月白清无梦，却为西风数漏声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋山二首 其二","author":"杨万里","text":"乌臼平生老染工，错将铁皂作猩红。\n小枫一夜偷天酒，却倩孤松掩醉容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋山二首 其一","author":"杨万里","text":"休道秋山索莫人，四时各自一番新。\n西风尽有东风手，柿叶枫林别样春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋虫","author":"杨万里","text":"蝉哀落日恰才收，蛩怨黄昏正未休。\n催得世人头总白，不知替得二虫愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋花","author":"杨万里","text":"憔悴牵牛病雨些，凋零木槿怯风斜。\n道边篱落聊遮眼，白白红红匾豆花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜不寐","author":"杨万里","text":"秋气侵人冷欲冰，不由老境不愁生。\n雨声已遣侬无睡，更著寒蛩泣到明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜极热三首 其三","author":"杨万里","text":"葵扇频挥手已麻，竹床偏热冷无些。\n面凉却感须根汗，省得开门汲井花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜极热三首 其二","author":"杨万里","text":"秋神今岁也痴呆，行李如何草草回。\n白帝羽衣浑不带，炎官火伞却将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜极热三首 其一","author":"杨万里","text":"只怨西风不早归，早归何似且归迟。\n姮娥一夜摇团扇，更说明朝日午时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨叹十解 其十","author":"杨万里","text":"不是檐声不放眠，只将愁思压衰年。\n道他滴沥浑无赖，不到侯门舞袖边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨叹十解 其六","author":"杨万里","text":"老子愁来只苦吟，一吟一叹为秋霖。\n居人只道秋霖苦，不道行人泥更深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨叹十解 其八","author":"杨万里","text":"晓起穷忙作么生，雨中安否问秋英。\n枯荷倒尽饶渠著，滴损兰花太薄情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨叹十解 其一","author":"杨万里","text":"雨入秋宵滴到明，不知有意复无情。\n若言不搅愁人梦，为许千千万万声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨叹十解 其七","author":"杨万里","text":"昼落无声夜有声，只堪醉听不堪醒。\n檐牙半点能多少，滴入苔阶一寸青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨叹十解 其四","author":"杨万里","text":"厌听点滴井边桐，起看空濛一望中。\n横著东山三十里，真珠帘外翠屏风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨叹十解 其二","author":"杨万里","text":"霖霖滴滴未休休，不解教侬不白头。\n却把穷愁比秋雨，犹应秋雨少于愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨叹十解 其五","author":"杨万里","text":"篱下黄花最恨它，金钿香少泪痕多。\n仙人解补银河漏，天上无泥奈许何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨叹十解 其三","author":"杨万里","text":"湿侵团扇不能轻，冷逼孤灯分外明。\n蕉叶半黄荷叶碧，两家秋雨一家声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨叹十解 其九","author":"杨万里","text":"似雾如尘有却无，须臾密密复疏疏。\n忽忘九月清霜晓，唤作濛濛二月初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋凉晚步","author":"杨万里","text":"秋气堪悲未必然，轻寒政是可人天。\n绿池落尽红蕖却，荷叶犹开最小钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晓出郊二绝句 其一","author":"杨万里","text":"初日新寒政晓霞，残山剩水稍人家。\n霜红半脸金罂子，雪白一川荞麦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晓出郊二绝句 其二","author":"杨万里","text":"野菊相依露下丛，冷香自送水边风。\n丰年气象无多子，只在鸡鸣犬吠中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋热","author":"杨万里","text":"今年秋热倍常年，更住西峰落照村。\n最是樱桃梢上日，裴回不落等黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋热二首 其二","author":"杨万里","text":"年年极暑与秋期，日日秋阳在暮时。\n我自愁吟无意思，蝉声移近入檐枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋热二首 其一","author":"杨万里","text":"多难幽怀惨不舒，秋风残暑扫难除。\n一生最怕西窗日，长是酴醾架子疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋暑二首 其二","author":"杨万里","text":"追凉能到竹溪无，隔水斜阳未肯晡。\n剩暑不蒙蕉扇扇，细云聊倩月梳梳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋暑二首 其一","author":"杨万里","text":"一年强半走尘埃，触热还山亦快哉。\n幸自西风归较早，却教秋暑伴将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋暑三首 其三","author":"杨万里","text":"半柳斜阳半柳阴，一蝉飞去一蝉吟。\n岸巾亭子钩栏角，送眼江村松树林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋暑三首 其二","author":"杨万里","text":"汗如雨点涌人肤，一一须根一一珠。\n不道去年秋不热，今年秋热去年无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋暑三首 其一","author":"杨万里","text":"不教老子略眉开，夏热未除秋热来。\n一夜凉风吹欲尽，半轮晓日唤将回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋暑午睡起汲泉洗面","author":"杨万里","text":"大桶双担新井花，松盆满泻莫留些。\n刺头蘸入松盆底，不是清凉第二家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋蝇","author":"杨万里","text":"秋蝇知我政哦诗，得得缘眉复入髭。\n欲打群飞还歇去，风光乞与几多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句","author":"杨万里","text":"枫老颜方少，山晴气反昏。\n旧贫今更甚，已冷幸犹暄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荔枝堂夕眺三首 其三","author":"杨万里","text":"闰年秋浅似秋深，蟋蟀将愁傍砌吟。\n今夕初三元未觉，西楼西角一钩金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荔枝堂夕眺三首 其二","author":"杨万里","text":"病骨秋臞怯暮清，凉风偷带北风轻。\n迎寒窗隔重糊遍，只放书边数眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]