[{"title":"左原诗三十二首 其二十一 左湖","author":"王十朋","text":"渔樵欸乃日相呼，舟楫生涯在画图。\n我与渔樵同隐逸，不须乞作自家湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"左原诗三十二首 其二十二 莼湖","author":"王十朋","text":"水晶银线满湖中，遥与吴江气象同。\n我辈他年厌游宦，思归应不待秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"左原诗三十二首 其二十三 南瀑布","author":"王十朋","text":"飞瀑来从小雁荡，灵源颇类大龙湫。\n矩罗尊者不须占，乞与山翁取次游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"左原诗三十二首 其二十四 北瀑布","author":"王十朋","text":"兹潭谁主复谁宾，清世宁容有隐沦。\n独我山林养衰病，不妨来作主潭人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"左原诗三十二首 其二十五 嘶水涧","author":"王十朋","text":"岭头寒涧远无声，夜静风恬忽自鸣。\n山水有灵人不识，老农常用卜阴晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"左原诗三十二首 其二十六 雁潭","author":"王十朋","text":"九日登临涧水滨，荡中征雁亦来宾。\n如今雁至应相感，不见名潭旧主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"左原诗三十二首 其二十七 三井","author":"王十朋","text":"源泉高似银河落，石井泓然鼎足分。\n闻说井中鱼已化，定从三级上青云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"左原诗三十二首 其二十八 孝感井","author":"王十朋","text":"纶竿临井重欷歔，诚感幽潜遂获鱼。\n解道随钩得玄鲫，秘书好句实堪书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"左原诗三十二首 其二十九 白岩庵","author":"王十朋","text":"飞凤吹归思竹实，蟠龙高卧恋山泉。\n吾家松槚今三世，僧舍钟鱼已百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"左原诗三十二首 其三十 贾公庵","author":"王十朋","text":"贾公名德重吾乡，慈母难兄窆此岗。\n手种松楸及因果，青山流水共高长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"左原诗三十二首 其三十一 如在亭","author":"王十朋","text":"东山一到一沾巾，记得先人昔念亲。\n强把兹亭号如在，松悲柏惨见无因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"左原诗三十二首 其三十二 如存亭","author":"王十朋","text":"北堂犹绿旧时萱，寒暑无繇复凊温。\n戏綵岩边白云下，慈颜彷佛尚如存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小小园纳凉","author":"王十朋","text":"屏迹丘园世事轻，澹然滋味似孤僧。\n平生愿学昌黎伯，宰相三书独不能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠甥万膺","author":"王十朋","text":"诗书为田笔砚耕，著意治此清白生。\n它年门户大可必，东平有孙吾有甥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"万孝杰用韵见寄酬之","author":"王十朋","text":"堂有慈亲养且耕，游从毛颖楮先生。\n新诗寄我尤清绝，深喜牢之有外甥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题从侄慎庄","author":"王十朋","text":"风雨漂我庐，无地寄食宿。\n小阮知所敦，舍我道旁屋。\n震凌得帡幪，幸免泥涂辱。\n明白归旧巢，鹪鹩一枝足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"万孝全惠小龙团","author":"王十朋","text":"贡馀龙饼非常品，绝胜卢仝得月团。\n岂有诗情可尝此，荷君分贶及粗官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赴召","author":"王十朋","text":"圣主龙飞才十日，微臣得郡古严陵。\n诏书又趣归天阙，愿竭孤忠赞中兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曹梦良赠炭戏成一绝","author":"王十朋","text":"乌龙书至送乌薪，郎舍严冬觉有春。\n未暇吞为哑口汉，旦须暖作直身人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿学呈同官","author":"王十朋","text":"不听梧桐雨，回头已六年。\n齑盐谙旧味，灯火结前缘。\n进学思韩愈，同襟有郑虔。\n诸生不待劝，忠孝素惓惓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"某去五月罢馆职还乡涂中以诗寄同舍云去国怀明主离群念旧游翻令到家梦中夜绕瀛洲今以史职复至道山访旧或迁或去惟后园脩竹乃故人也感叹良久因成短篇","author":"王十朋","text":"蓬莱隔弱水，三年两来游。\n群仙各何之，翩然蜕神洲。\n园中旧箨龙，劲节含清幽。\n手摘岁寒叶，恍惚乘归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冯员仲赴阙奏事士君子咸欲其留闻为魏公所辟势不可夺遂成鄙语兼简查元章","author":"王十朋","text":"名德重夷夏，皇朝两魏公。\n平淮已得愈，论将更资冯。\n报主男儿志，知恩国士风。\n尽收良马去，冀北遂群空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17815,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"程泰之郎中以诗三绝觅省中梅花因次其韵 其一","author":"王十朋","text":"长记蓬山旧赏梅，芳樽一笑共君开。\n重游未见梅花面，应误君诗得得来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17816,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"程泰之郎中以诗三绝觅省中梅花因次其韵 其二","author":"王十朋","text":"诗似西湖处士诗，十篇三绝斗清奇。\n更将正味森严句，压倒屋檐斜入枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17817,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"程泰之郎中以诗三绝觅省中梅花因次其韵 其三","author":"王十朋","text":"竹亭不到几经时，来往逢梅似退之。\n遥想吾庐溪上好，十分乡思又关眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17818,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"依韵奉酬胡秘监","author":"王十朋","text":"平生恨未识刚者，今日岂期亲见之。\n欲把江梅比孤洁，江梅无此岁寒枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17819,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵胡秘监酴醾","author":"王十朋","text":"红紫纷争先，酴醾分甘晚。\n谁栽群玉府，童童翠张幰。\n华共芸芬香，韵随官逸远。\n奚用燃青藜，端能照书苑。\n先生海上归，平步到蓬巘。\n招邀饮醇酎，刚肠出清婉。\n遥思吴宫魂，故作楚辞挽。\n勿为花所留，兴尽要知返。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17820,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"馆中三月晦日闻莺胡邦衡有诗用东坡酴醾韵有君侧无谗人发口不须婉句某次韵","author":"王十朋","text":"久伤伐木废，每叹吾生晚。\n黄鸟从何来，乔林绿垂幰。\n忽作相呼声，朋来无近远。\n高翥凌云烟，斜飞集池苑。\n中有幽谷姿，迟迟下遥巘。\n群音巧相和，出语独不婉。\n哑哑如老乌，闻者弓欲挽。\n知心有杜鹃，劝尔故园返。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17821,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上赐讲读官建茶某以说书与焉以十饼分赠太学同舍苪太博有诗次韵","author":"王十朋","text":"天表初容咫尺亲，云龙重拜太官珍。\n赐从明主恩尤渥，分及清流事更新。\n搜卷要须尝七椀，乘风便合到三神。\n诸公异日沾君贶，愿寄江湖老散人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17822,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"四月从驾诣德寿宫与诸公会食于和乐楼是日借洪景严承旨马戏云从驾滥骑承旨马朝天叨缀舍人班异日再集胡舍人邦衡云不可不成篇也遂于楼中足之","author":"王十朋","text":"殿坳经幄侍清閒，学术空疏愧在颜。\n从驾滥骑承旨马，朝天叨缀舍人班。\n登楼虽喜民和乐，论事还惊世险艰。\n圣主英姿同艺柤，诸君何苦恋湖山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用登和乐楼韵酬胡邦衡送别兼简刘韶美秘监","author":"王十朋","text":"未访鄱阳范与颜，雁山深处且投閒。\n紫泥长记曾同召，丹陛何繇更对班。\n我愧未行平日志，公应不创昔时艰。\n笔端能制人生死，兼有刘郎在道山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"去国","author":"王十朋","text":"去国常忧国，还家未有家。\n君恩报无所，含愧出京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重游钓台 其一","author":"王十朋","text":"三年两溯钓滩涛，来往何曾补一毫。\n圣主雅恢光武量，微臣当遂子陵高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重游钓台 其二","author":"王十朋","text":"弭棹祠堂下，一天星斗明。\n客星寻不见，影浸钓滩清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17827,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过婺女同年王节推黄教授乡人华主簿会饮双溪楼","author":"王十朋","text":"年时尝泛婺溪舟，未上清风八咏楼。\n天为故人偿夙愿，水知吾辈喜清流。\n沈郎不为吟诗瘦，王粲长怀去国忧。\n明日山川共人远，乡情年契两悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17828,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游仙都","author":"王十朋","text":"皇都归客过仙都，厌看西湖看鼎湖。\n洞接龙泓片云近，山分雁荡一峰孤。\n香清天上碧华落，音好林间青鸟呼。\n天遣林泉慰吾辈，不容身世老迷涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17829,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游洞溪","author":"王十朋","text":"段公不到溪岂好，李守已亡诗更奇。\n偶向思贤亭上坐，爱溪兼爱昔人诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17830,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重游石门洞 其一","author":"王十朋","text":"石洞几时辟，石门长不扃。\n贪看一派水，三载两回经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17831,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"重游石门洞 其二","author":"王十朋","text":"谁把银河水，直从天半倾。\n好流人世去，一洗四维清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17832,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题喻叔奇亦好园","author":"王十朋","text":"喻子有园堪养亲，栽花种竹清且新。\n堂中戏罢即策杖，在家有此何忧贫。\n弟兄既好园亦好，大胜吾家园小小。\n两园松竹怀主人，他日归来各须早。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"种蔬","author":"王十朋","text":"归来日弹铗，食无肉与鱼。\n却将种花地，町畦毓嘉蔬。\n骄阳每抱瓮，时雨亲荷锄。\n青青有生意，令我颜色舒。\n宁忧馑与饥，亦有瓶中储。\n前身老阇梨，蔬气端未除。\n文字亦宿业，复生鱼蠹书。\n蠹书仍食蔬，苦淡味有馀。\n况兹清净根，分来自僧居。\n端能纳须弥，聊尔秀郊墟。\n洗我腥膻肠，襟宇生清虚。\n岂惟陶渊明，吾亦爱吾庐。\n荒园涉成趣，枯藤当安舆。\n困枕案头卷，饥著盘中菹。\n孔门陈蔡色，借问何如予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予素不善棋孙先觉万大年林大和见访戏与对垒偶皆胜之因作数语","author":"王十朋","text":"予手不善谈，临局气先怯。\n偶逢孙万林，三战辄三捷。\n都缘敌不勍，非以台威胁。\n孺子滥成名，凯奏意殊惬。\n三君皆壮士，小挫未肯厌。\n予今务持胜，坚壁不容劫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17835,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大年和棋诗复次前韵","author":"王十朋","text":"君棋如龙且，初笑韩信怯。\n我棋似公瑾，赤壁真横捷。\n但知贪旁角，不觉攻背胁。\n主人本无竞，胜负两俱惬。\n嘉宾傥再集，鏖战定谁厌。\n新篇尤逼人，我辈徒劫劫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17836,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太白昼见","author":"王十朋","text":"煌煌太白生东方，追逐残月生光芒。\n太阳中天不肯藏，过午一点犹微茫。\n太史占之此何祥，咸忧兵起人流亡。\n金行用事多灾伤，大风地震水旱蝗。\n有一于此宜预防，杂然并见何以当。\n臣言天意未可量，滔天赤地兴尧汤，偃禾拔木悟成王。\n宋景一言国乃昌，灾异不作忧楚庄。\n吾皇修德应彼苍，去谗远佞任忠良。\n推诚纳谏正纪纲，内修政事仍外攘。\n誓雪国耻还封疆，强虏当弱吾当强。\n天戒为福非为殃，愿勿徒以虚文禳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17837,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"荆妇夜绩","author":"王十朋","text":"凉飙堕黄叶，促织催女工。\n鬓丝不堪织，细君哀我穷。\n青灯绩深夜，绩成寒素风。\n愿为隐者衣，德耀随梁鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17838,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"术者谓予命犯元辰故每仕辄已予笑曰有是哉戏作问答语","author":"王十朋","text":"问君胡为入台省，问君胡为官辄冷。\n宣尼犹且畏元辰，羊鼠龙猪作君梗。\n退之宿直斗牛箕，声名谤毁常相随。\n死生穷达端有命，予知之矣当安之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17839,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再至双植堂呈表兄李克明","author":"王十朋","text":"此日一樽酒，再游双植堂。\n湖山浮野色，草木带秋光。\n东道德已熟，西风花更香。\n相看俱老矣，会合意尤长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17840,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日寄表叔贾司理","author":"王十朋","text":"忆昔从师学弦诵，年与贾生相伯仲。\n九日登高鹿岩脊，感物题诗笔初弄。\n旧游回首半零落，三十六年真一梦。\n当时唱和三四老，尚有残篇可吟讽。\n今年节物身在家，行乐山间谩随众。\n弟兄劝我登高山，身似驽骀不容鞚。\n河东先生今靖节，有酒宁须白衣送。\n朋尊聊献菲蒙泉，赐茗仍分小团凤。\n愿公一饮寿千龄，三物年年敢驰贡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17841,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日不登高与兄弟邻里就敝舍饮菊","author":"王十朋","text":"中秋对明月，九日逢黄花。\n节物岂不好，而况身在家。\n樽酒醵邻里，盘餐饤鱼虾。\n何必登高山，清欢自无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17842,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仙居陈少曾寄锦石杯书至乃九日也方与坐客把菊遂用以劝酒","author":"王十朋","text":"九日登临有雁来，书传坐上手亲开。\n呼儿满酌黄花酒，为子深倾锦石杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17843,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仆夫浚井得双鲫一鳗未及烹也藏之泥水间予见而放之因作数语","author":"王十朋","text":"三秋不雨泉脉枯，仆夫浚井欣得鱼。\n刀砧已具未及杀，我偶见之鱼再活。\n亲投不敢使校人，圉圉洋洋生意新。\n莫嫌井小思沧海，尺水相忘聊自在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17844,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得张大猷尚书书云比每进对屡以待御为言而邦衡舍人言尤数切云云某为群邪所疾独见知二公因读邦衡和和乐楼诗复用前韵","author":"王十朋","text":"一月霜台屡犯颜，未回天听已身閒。\n爱君忧国寸心赤，感物伤时双鬓班。\n文举才疏意徒广，子云思苦语尤艰。\n尚书左史虽知我，超海应难挟太山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17845,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵题宝印叔兰若堂","author":"王十朋","text":"何处名兰若，依山结草堂。\n花枝法雨润，心地佛灯光。\n浮世嚣尘隔，空门岁月长。\n林间有啼鸟，听法亦来翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17846,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"藤杖","author":"王十朋","text":"头角槎牙万岁藤，遍身节目更棱棱。\n山僧赠我非无意，要我清闲亦似僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17847,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予还自武林葺先人弊庐净扫一室晨起焚香读书于其间兴至赋诗客来饮酒啜茶或弈棋为戏藏书数百卷手自暴之有小园时策杖以游，时遇秋旱驱家僮浚井汲水浇花良天佳月与兄弟邻里把酒杯同赏过重九方见菊以泛觞有足乐者每览镜见苍颜白发亦聊自叹也作小诗十五首 其一 扫室","author":"王十朋","text":"洒扫学者事，陈蕃胡不然。\n要令天下净，端自室中先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17848,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予还自武林葺先人弊庐净扫一室晨起焚香读书于其间兴至赋诗客来饮酒啜茶或弈棋为戏藏书数百卷手自暴之有小园时策杖以游，时遇秋旱驱家僮浚井汲水浇花良天佳月与兄弟邻里把酒杯同赏过重九方见菊以泛觞有足乐者每览镜见苍颜白发亦聊自叹也作小诗十五首 其二 焚香","author":"王十朋","text":"扫地眼尘净，焚香心境清。\n案头时一炷，邪虑不应生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17849,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予还自武林葺先人弊庐净扫一室晨起焚香读书于其间兴至赋诗客来饮酒啜茶或弈棋为戏藏书数百卷手自暴之有小园时策杖以游，时遇秋旱驱家僮浚井汲水浇花良天佳月与兄弟邻里把酒杯同赏过重九方见菊以泛觞有足乐者每览镜见苍颜白发亦聊自叹也作小诗十五首 其三 读书","author":"王十朋","text":"入政惭无学，还家更读书。\n翻同小儿辈，相共惜居诸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17850,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予还自武林葺先人弊庐净扫一室晨起焚香读书于其间兴至赋诗客来饮酒啜茶或弈棋为戏藏书数百卷手自暴之有小园时策杖以游，时遇秋旱驱家僮浚井汲水浇花良天佳月与兄弟邻里把酒杯同赏过重九方见菊以泛觞有足乐者每览镜见苍颜白发亦聊自叹也作小诗十五首 其四 赋诗","author":"王十朋","text":"秋兴最难遣，诗怀如乱云。\n虽无少陵笔，一饭不忘君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17851,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予还自武林葺先人弊庐净扫一室晨起焚香读书于其间兴至赋诗客来饮酒啜茶或弈棋为戏藏书数百卷手自暴之有小园时策杖以游，时遇秋旱驱家僮浚井汲水浇花良天佳月与兄弟邻里把酒杯同赏过重九方见菊以泛觞有足乐者每览镜见苍颜白发亦聊自叹也作小诗十五首 其五 饮酒","author":"王十朋","text":"我意岂在酒，衔杯聊乐天。\n客来同一醉，客去独高眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17852,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予还自武林葺先人弊庐净扫一室晨起焚香读书于其间兴至赋诗客来饮酒啜茶或弈棋为戏藏书数百卷手自暴之有小园时策杖以游，时遇秋旱驱家僮浚井汲水浇花良天佳月与兄弟邻里把酒杯同赏过重九方见菊以泛觞有足乐者每览镜见苍颜白发亦聊自叹也作小诗十五首 其六 啜茶","author":"王十朋","text":"滥与金华讲，赐沾龙凤团。\n却归林下饮，更愧是粗官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17853,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予还自武林葺先人弊庐净扫一室晨起焚香读书于其间兴至赋诗客来饮酒啜茶或弈棋为戏藏书数百卷手自暴之有小园时策杖以游，时遇秋旱驱家僮浚井汲水浇花良天佳月与兄弟邻里把酒杯同赏过重九方见菊以泛觞有足乐者每览镜见苍颜白发亦聊自叹也作小诗十五首 其七 弈棋","author":"王十朋","text":"光景老尤惜，忍销枰弈间。\n娱宾欠丝竹，一局战清闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17854,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予还自武林葺先人弊庐净扫一室晨起焚香读书于其间兴至赋诗客来饮酒啜茶或弈棋为戏藏书数百卷手自暴之有小园时策杖以游，时遇秋旱驱家僮浚井汲水浇花良天佳月与兄弟邻里把酒杯同赏过重九方见菊以泛觞有足乐者每览镜见苍颜白发亦聊自叹也作小诗十五首 其八 暴书","author":"王十朋","text":"秋日更可畏，所宜惟暴书。\n反身还自笑，均是蠹书鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":17855,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]