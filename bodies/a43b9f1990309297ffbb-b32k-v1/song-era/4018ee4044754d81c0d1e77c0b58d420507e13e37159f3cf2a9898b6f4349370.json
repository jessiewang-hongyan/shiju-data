[{"title":"送项使君季约二首 其二","author":"刘克庄","text":"但见两眉颦，何曾一馔珍。\n节如僧更苦，家比郡尤贫。\n琴鹤均为赘，莼鲈颇切身。\n荡山有来雁，莫惜寄声频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送项使君季约二首 其一","author":"刘克庄","text":"世有凝香乐，君侯总未知。\n清斋灯火夕，闭閤荔支时。\n郡小留难住，民愚去始思。\n两年案头笔，一字不容私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送饶司理端学","author":"刘克庄","text":"一郡夸饶掾，才名果不虚。\n忽闻归去勇，极恨往还疏。\n囚戴公平德，奴担性理书。\n京华逢友旧，为说闭门居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送徐平父往水南","author":"刘克庄","text":"东汉高士后，晚唐先辈家。\n聚萤十年读，中鹄一毫差。\n昔有人还贽，今无佛雨花。\n水南士渊薮，弹铗不须嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送徐守寺正二首 其二","author":"刘克庄","text":"闻道君侯欲解麾，士农攀卧共依依。\n野人恨作滕民晚，州牧能如结辈稀。\n虽有荔枝懒包贡，亦无薏苡可囊归。\n诸公万一询衰朽，为说羊裘坐钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送徐守寺正二首 其一","author":"刘克庄","text":"梅野先生子象贤，向来心印得单传。\n谚云蜡烛真明矣，罚止蒲鞭亦肃然。\n执贽客多樽有酒，诟租吏少箧无钱。\n玺书底事催归急，不许邦人借一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送徐夏叔","author":"刘克庄","text":"昔与长君亲，今方识少君。\n极知皆造理，何止并能文。\n读照湘中雪，吟开岳顶云。\n老余才思竭，搔首念离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送真西山再镇温陵","author":"刘克庄","text":"父老香花夹路催，朱幡那忍更徘徊。\n弓张至此尤宜弛，珠去安知不复回。\n海上有艘堪致粟，洛中无篚胜生财。\n泉人毕竟修何福，消得西山两度来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陶仁父","author":"刘克庄","text":"自古送行情味恶，君行快似泛仙槎。\n新班人少先投卷，下水船轻易到家。\n南浦不堪看草色，西湖尚可及荷花。\n诸公若问栖栖者，为说吟诗两鬓华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送曹守司直二首 其二","author":"刘克庄","text":"已满葵丘戍，民犹借一年。\n何曾拔薤本，亦不用蒲鞭。\n羡帑留修泮，公厨少起烟。\n今无采诗者，付与后人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送曹守司直二首 其一","author":"刘克庄","text":"莫作封君看，慈祥若父兄。\n化教虞芮逊，和了触蛮争。\n列戟犹森卫，曹装忽趣行。\n要知莆俗厚，冠盖送倾城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送淮士陈文席见四川陈制参","author":"刘克庄","text":"汉家募击匈奴者，此士如何未见收。\n闻说将军能揖客，安知定远不封侯。\n羊肠九折谁云险，骏骨千金岂易酬。\n自古荐扬繇幕府，送君去谒大参谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送章通判","author":"刘克庄","text":"半刺已官尊，常时读鲁论。\n身居恭叔里，心在晦翁门。\n贫士来遮路，诗人送出村。\n君能齐得丧，何必恋华轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送舶使王监丞","author":"刘克庄","text":"一琴不鼓携归浙，六辔如丝送入闽。\n魁杰西州今有汝，典司南库岂无人。\n牙筹何足烦名胜，釐席方将问鬼神。\n公干仲宣从此别，远书莫惜寄漳滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送黄户曹","author":"刘克庄","text":"拂榻迟居久，今才问戍瓜。\n海乡真佛国，府主似包家。\n友喜吟添稿，胥惊判有花。\n笋柑妙天下，长铗不须嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送黄舒文赴钦教","author":"刘克庄","text":"博士文中虎，垂髫已定交。\n雅宜对红药，胡乃涉黄茅。\n薄有先生饭，全无弟子嘲。\n犹胜迂阔者，荷锸垦荒郊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送黄□赴补","author":"刘克庄","text":"泽宫选新俊，鼓箧者云从。\n此士堪穿札，同人学避锋。\n朝家方教胄，天子必临雍。\n去去飞潜异，云山隔几重。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送婺教林伯良兼柬直卿山长","author":"刘克庄","text":"郑虔别去已离群，迟暮何堪又别君。\n弟子皆知师□季，上官应不吏朱云。\n才多未给尚方札，饭少聊羹泮水芹。\n定与朋招及门者，共寻坠绪访遗文。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送强甫赴漳倅二首 其二","author":"刘克庄","text":"平生受用语，祖道试重拈。\n御下慈亲恕，持身处女严。\n民歌齐相静，守说许丞廉。\n宽作期年别，吾衰勿久淹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送强甫赴漳倅二首 其一","author":"刘克庄","text":"囝罢各华颠，临分倍黯然。\n吾惛如隔雾，汝孝可通天。\n郡古多文献，厅寒少事权。\n东冈今召父，犹在乃翁前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送强浦注籍","author":"刘克庄","text":"老别亲朋已动情，可堪玉树离阶庭。\n新吟不数苍蝇窍，多病真成碧鹤形。\n翁迫崦嵫迟暮景，儿看风雪短长亭。\n早归共举屠苏酒，莫爱西湖柳色青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送惠州弟","author":"刘克庄","text":"半竹分来岂不荣，三荆拆散若为情。\n莫云炎峤非吾土，直为丰湖作此行。\n交趾珠能令绶去，郁林石可压舟轻。\n悬知解印无南物，留面归看白发兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送游潮州二首 其二","author":"刘克庄","text":"虽森画戟惟清啸，因讨红巾有雪髯。\n孟子曾称伯夷隘，汉人亦议弱翁严。\n交游皆叹遗公误，仇怨犹言太守廉。\n可惜遒人官久废，此诗湮郁在闾阎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送游潮州二首 其一","author":"刘克庄","text":"霜简刚言璧有瑕，清朝耳目不应差。\n醉翁绝少环滁饮，范老何心庆朔花。\n省库钱皆留享士，高斋琴却带还家。\n邵平旧圃元无恙，未必封侯胜种瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谢眸之温陵","author":"刘克庄","text":"纵未肩康乐，犹堪跨惠连。\n生涯悬罄尽，诗句弹丸圆。\n古有王官采，今无海贾传。\n不知谁著价，携去访心泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送雷司法于发秤提结局一首","author":"刘克庄","text":"吏奉新书多刻峭，君于此事极忠勤。\n告缗鲜有丽三尺，投劾不如宽一分。\n重币稍权周旧法，大搜安用汉深文。\n先民最善言阴德，莫要人知耳自闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送雷宜叔右司追录","author":"刘克庄","text":"老恋明时未拂衣，留行无勇惜君归。\n和于朝喜群芳聚，减却春因一片飞。\n坝岸柳禁频折否，玄都桃恐再来非。\n东皇太乙方行令，寄语封姨且霁威。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送熊主簿","author":"刘克庄","text":"邑事多商榷，惟诗未暇论。\n母慈催扇枕，父老谩攀辕。\n新戍谋何地，初程宿某村。\n西风有来雁，书札傥相存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送德甫侄省试","author":"刘克庄","text":"绝出雕虫辈，相期竹马年。\n二魁家有样，四世里兴贤。\n雪鬓吾还笏，霜蹄汝著鞭。\n微痾真换骨，骨换不难仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送潮阳方主学","author":"刘克庄","text":"芹泮人人陶圣化，花封处处置师儒。\n遥知避席来听讲，犹胜开门自授徒。\n官比郑虔尤冷甚，士如赵德岂今无。\n朝家调守方刓印，且可相依县大夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送薛明府","author":"刘克庄","text":"长官三载内，屡被督邮嗔。\n镇静笞刑少，公清县库贫。\n减租沾野老，扫榻待诗人。\n祇恐凫飞后，民间事事新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送戴复古谒陈延平","author":"刘克庄","text":"仓部当今第一流，艰难有诏起分忧。\n城危如卵支群盗，胆大于身蔽上游。\n应是孔明亲治事，岂无子美可参谋。\n君行必上辕门谒，为说披蓑弄钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送魏录事","author":"刘克庄","text":"君去民称颂，吾州录事廉。\n平心决蛮触，恕笔谳髡钳。\n守法仁人勇，持身处女严。\n城中旗榜盛，不欠恶诗拈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重次林守韵并柬臞轩二首 其二","author":"刘克庄","text":"禁中前欲唤公归，读轼文章每叹奇。\n玉节不烦熬雪海，金芝元合产铜池。\n愈郊各洗饥寒语，甫白曾为汗漫期。\n上尽青云记回首，某丘某水钓游时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重次林守韵并柬臞轩二首 其一","author":"刘克庄","text":"晨坐黄堂夕未归，偶然闭阁句尤奇。\n颇知韦守临苏郡，不省山公到习池。\n烧尾且陪攀桂集，遨头别有探梅期。\n自惭属和悭才思，尤甚春船上水时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重次臞轩韵二首 其二","author":"刘克庄","text":"潦倒常惭室弗堂，君恩特地与开荒。\n灵津误作乘槎客，华发羞陪射策郎。\n金菊歌新赓下鹄，碧梧枝老许栖皇。\n退臣无路酬天奖，旦旦炉熏祝宝坊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重次臞轩韵二首 其一","author":"刘克庄","text":"忆昔抽毫白玉堂，奏篇字字谷年荒。\n内人久已呼才子，明主今方记寝郎。\n驽豆未应堪秣骥，鹑笼谁道可容皇。\n何当雅奏登郊庙，一洗梨园与教坊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻东轩讣 其一","author":"刘克庄","text":"君给相如札，吾方长道山。\n燕犹栖旧垒，驹已养天闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻竹溪得玉局祠二首 其二","author":"刘克庄","text":"诸将时时送捷书，未知西事近何如。\n剑关昔有豺狼守，焦穫今无猃狁居。\n全盛海棠多剪伐，久枯庙柏再扶疏。\n汉家似欠相如檄，岂特殊廷要扫除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻竹溪得玉局祠二首 其一","author":"刘克庄","text":"溪上人来暮叩关，殷勤一纸报平安。\n甘泉宿老求闲局，苦县仙人有废坛。\n拜敕定披新紫氅，榜斋应许旧黄冠。\n冰衔怪得缄题异，自起呼童剪烛看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻何立可李茂钦讣二首 其二","author":"刘克庄","text":"何老长身李白须，传闻死尚握州符。\n战场便合营双庙，太学今方出二儒。\n史馆何人徵逸事，羽林无日访遗孤。\n病夫畴昔曾同幕，西望关山涕自濡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻何立可李茂钦讣二首 其一","author":"刘克庄","text":"初闻边报暗吞声，想见登谯与虏争。\n世俗今犹疑许远，君王元未识真卿。\n伤心百口同临穴，极目孤城绝救兵。\n多少虎臣提将印，谁知战死是书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻居厚得祠复次韵二首 其二","author":"刘克庄","text":"稍欣公议白，又报啧言行。\n上漫招东马，人方毁李程。\n迎来新观主，伴取老师兄。\n汉士方云合，何须鲁两生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻居厚得祠复次韵二首 其一","author":"刘克庄","text":"诸贤谈稷下，孤士卧漳滨。\n母亦为投杼，儿宜勿斲轮。\n无书留逐客，有些吊累臣。\n一室才容榻，奚烦问疾人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋柳池寺护国灵泉","author":"程公许","text":"忍泪淋泠过上亭，柳池泂酌重消魂。\n脱身蜀道千山险，屈指开元几叶孙。\n鸩毒由来藏衽席，疮痍未易补乾坤。\n行人但赏三泉冷，兴替相寻可复论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻城中募兵有感 其一","author":"项安世","text":"调发年多籍半空，虎符招补至闽中。\n庄农戎服来操戟，太守儒装学拍弓。\n去日初辞乡树绿，到时愁见戍旗红。\n募金莫作缠头费，留制衣袍禦北风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻祥应庙优戏甚盛二首 其二","author":"刘克庄","text":"巫祝欢言岁事详，丛祠十里鼓箫忙。\n衣冠优孟名孙□，□□□□□□□。\n□□阏氏成妒妇，幻教穆满作□□。\n□□□□□□□，何必区区笑郭郎。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻祥应庙优戏甚盛二首 其一","author":"刘克庄","text":"空巷无人尽出嬉，烛光过似放灯时。\n山中一老眠初觉，棚上诸君闹未知。\n游女归来寻坠珥，邻翁看罢感牵丝。\n可怜朴散非渠罪，薄俗如今几偃师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻黄德常除德安倅","author":"刘克庄","text":"幕下相从若弟兄，当年曾悔误谈兵。\n足行江北生重趼，发为山东白几茎。\n病拥琴书专一壑，老携檄笔赴孤城。\n暮云不见关山路，空有天涯故旧情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻喜宴李教君瑞不赴小诗赞美","author":"刘克庄","text":"脍人肝与采山薇，举世营营为饱饥。\n始信洋洋而逝矣，已烹鹢鹢复哇之。\n伏雌雉亦防身害，畴昔羊能兆祸基。\n独有广文君卓识，残杯冷炙也牢辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕","author":"刘克庄","text":"除夕阴寒怕卷帘，雨声断续下疏檐。\n壁穿自和乾泥补，窗损教寻废纸粘。\n祇有青灯相守定，纵无白发亦生添。\n更残自算明年事，不就君平卦肆占。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕","author":"王迈","text":"忆昔都门值岁除，高楼张烛戏呼卢。\n久依净社参尊宿，难向新丰认酒徒。\n天子未知工草赋，邻人或倩写桃符。\n寒宵别有穷生活，点勘离骚拥地炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"香山寺","author":"刘克庄","text":"佛废何关儒者事，要知开创亦辛勤。\n居人公拆纯椤柱，巨室深藏旧记文。\n钟已毁楼移出寺，石犹镌字徙为坟。\n吾诗句句通阴骘，安得檀那子细闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"健忘一首","author":"刘克庄","text":"昏昏健忘废专精，默坐空斋忽自惊。\n少作回看如两手，旧书重读似前生。\n却疑安世知三箧，不晓睢阳记一城。\n莫怪诗成呼烛写，晓窗追忆欠分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭丰宅之吏部二首 其二","author":"刘克庄","text":"康时才业未全伸，晚建油幢白发新。\n畚土为城尘满面，握拳犹战胆通身。\n一生偏任公家怨，四海皆知后事贫。\n多少贵交方厚禄，恤孤吊墓属何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭丰宅之吏部二首 其一","author":"刘克庄","text":"江表依公稍自强，讣闻朝野共凄凉。\n纛移北府兵皆散，笳返西州宅已荒。\n旧戍交锋淮水赤，新坟埋剑越山苍。\n此身虚作田横客，血泪无因滴垄旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭五一弟先辈二首 其二","author":"刘克庄","text":"自小即相依，天涯影伴飞。\n共灯抄细字，分俸赎寒衣。\n已痛身长诀，犹疑客未归。\n素帏惟幼女，断续哭声稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭五一弟先辈二首 其一","author":"刘克庄","text":"未冠辞家出，麻衣不肯回。\n瘦因身久客，贫为性疏财。\n精力书中去，科名病里来。\n空传场屋义，留与铺家开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭方主簿伋","author":"刘克庄","text":"鹑衣不似拥千金，用破灯窗一世心。\n太学空闻能赋久，春官未察读书深。\n柴车巾出身犹健，槐简拈归病已侵。\n寂寞殡宫来客少，故人野外独沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭日老二首 其二","author":"刘克庄","text":"竹湖畴昔叹兼通，孔墨何曾是别宗。\n唐代儒先重颠老，晋朝名胜赏林公。\n颂辞大众存遗札，塔与寒斋共一峰。\n闻说结跏挥手际，亦留半偈别樗翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭日老二首 其一","author":"刘克庄","text":"初闻灭度指三弹，俄报荼毗鼻一酸。\n始悟杖头挑布袋，不如龛里坐蒲团。\n故交相与归函骨，弟子谁来会涅槃。\n犹喜喝衣无一物，洞开方丈与人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭毛易甫","author":"刘克庄","text":"至尊殿上主文衡，谁料台中有异评。\n垂二十年犹入幕，后三四榜尽登瀛。\n白头亲痛终天诀，丹穴雏方隔岁生。\n策比诸儒无愧色，自缘命不到公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭王宗可","author":"刘克庄","text":"昨现官身往，今迎影子回。\n总云凫入觐，谁料鵩为灾。\n巷静公人去，门荒吊客来。\n故园花满架，犹似去年开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭叶孝锡教授","author":"刘克庄","text":"瘴云深处死，太息柰君何。\n诗友俱来吊，埋铭久未磨。\n箕裘无子继，书画落人多。\n旧宅今移主，斜阳掩涕过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭左次魏二首 其二","author":"刘克庄","text":"甫痛何郎夭，丘明亦复然。\n因思题墓上，不若斗樽前。\n剑马为谁得，琴书有女传。\n惟应千载下，配食雪堂仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]