[{"title":"四月一日寿阳楼遇雨","author":"刘安上","text":"黑云滃蔚自西来，伫立危楼亦壮哉。\n远壑烟生千里雨，寒潭龙起数声雷。\n田畴坐看还丰岁，里巷遥欣弭旱灾。\n惭愧外官逃吏责，归鞍何惮踏泥回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和冯中丞中秋夜月","author":"刘安上","text":"捲尽浮云见碧虚，初传更漏滴铜壶。\n入秋爽气迥然别，此地冰轮何处无。\n共想姮娥依桂魄，独怜飞鹊绕庭梧。\n西园饮散归来早，不用红纱照路隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和十六夜月","author":"刘安上","text":"云头依旧尚团圆，未觉清光有两般。\n自是人心重佳节，故将今夕不同看。\n望中银汉祇如昨，坐久园亭又更寒。\n莫把盈亏妄分别，一杯到手且须乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天柱峰","author":"刘安上","text":"天柱峰头星斗红，月明秋殿玉玲珑。\n仙人夜半来吹笛，骑著吴江小赤龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释应端","text":"六合倾翻劈面来，暂披麻缕混尘埃。\n因风吹火浑闲事，引得游人不肯回。\n坏不坏，随不随，徒将闻见强针锥。\n太湖三万六千顷，月在波心说向谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其一","author":"释知炳","text":"此事最希奇，不碍当头说。\n东邻田舍翁，随例得一橛。\n非唯贯声色，亦乃应时节。\n若问是何宗，八字不著丿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其二","author":"释知炳","text":"日日说，时时举，似地擎山争几许。\n陇西鹦鹉得人怜，大都祇为能言语。\n休思惟，带伴侣，智者聊闻猛提取。\n更有一般也大奇，猫儿偏解捉老鼠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其三","author":"释知炳","text":"春光烂熳华争发，子规啼落西山月。\n憍梵钵提长吐舌，底事分明向谁说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈四首 其四","author":"释知炳","text":"迷不自迷，对悟立迷。\n悟不自悟，因迷说悟。\n所以悟为迷之体，迷为悟之用。\n迷悟两无从，个中无别共。\n无别共，拨不动。\n祖师不将来，鼻孔千斤重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二首 其一 僧问清平有漏无漏。","author":"释知炳","text":"笊篱木杓，钱买井索。\n打瓦钻龟，徒劳卜度。\n休卜度，麒麟只有一只角。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二首 其二 僧问雪窦明觉如何是佛，曰四山围绕。","author":"释知炳","text":"狂狗逐块，瞎驴趁队。\n只许我知，不许你会。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"陈淬","text":"数奇不是登坛将，竹杖芒鞋归去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂诗 其一","author":"汪伯彦","text":"尚父重来国有瘳，再移双袖揖浮丘。\n进为初迫人閒世，退老仍怀天下忧。\n娱戏烟霞资辟谷，栽培松菊助吟秋。\n天心此欲中兴去，蕙帐山猿恐莫留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂诗 其二","author":"汪伯彦","text":"脱冕遗轩息万缘，归来閒地作神仙。\n涉园靖节初成趣，得志庄周正乐全。\n物外情随云鹄举，尊前身傍海鸥眠。\n功成者去天之道，知退如公法自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂诗 其三","author":"汪伯彦","text":"燕南三世识非罴，谋策江淮见吐奇。\n千载五龙扶日毂，十年两袂各天涯。\n知公卜筑聊如此，嗟我求田昧所之。\n遥想园亭宾客会，梦飞胡蝶到芳帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东松庵","author":"汪伯彦","text":"万夫屹立若临冲，四十年来谒上峰。\n名遂归来人物改，青青惟有岁寒松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"汪伯彦","text":"两两泰阶星一色，亭亭华表鹤双归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过曹娥庙","author":"释觉先","text":"纵步青萝嶂，吟边景更宽。\n沙纹潮落见，山色雨馀看。\n汀草含清韵，江猿啼暮寒。\n娥祠重致敬，忍读汉碑残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题禊帖诗","author":"米友仁","text":"图契朴雕推圣智，万古奔沈馀末伎。\n兰亭醉墨更无加，始信功名皆傥尔。\n庾翼儿郎岂不黠，自是家鸡惭野雉。\n退之彊聒六艺疏，见处才能到姿媚。\n相公有官那得取，不与官家深自秘。\n却因同好露心胸，谩使萧翼誇末计。\n摸金不必曹阿瞒，温韬家有昭陵器。\n披沙只恐取黄金，剔轴谁能收故纸。\n天章宝塔高嵯峨，永表文皇好文艺。\n至今油蜡传未休，善本何辞万金弃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秀轩","author":"米友仁","text":"山气与湖光，四时足殊秀。\n我识轩中人，是为益三友。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题大姚山图三首 其一","author":"米友仁","text":"广文当日官虽冷，可奈才名振世何。\n他日君家须炙手，而今聊复雀堪罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题大姚山图三首 其二","author":"米友仁","text":"老年尚喜管城子，更爱好山江上青。\n武林秋高晓欲雨，正若此画云冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题大姚山图三首 其三","author":"米友仁","text":"三茅别有洞中天，我欲山居屏世缘。\n累行积功多蜕举，玉宸欣有地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为蒋仲友题画","author":"米友仁","text":"乱山深处是烟霞，雨暗晴晖日夕佳。\n至识先生曾到此，故留戏笔在君家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自题山水","author":"米友仁","text":"霄壤千千万万山，东南胜地熟跻攀。\n古人作语咏不得，我寓无声缣楮间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题董源夏山图","author":"米友仁","text":"崇山过新雨，苍翠浓欲滴。\n林深不通人，溪回有吟客。\n日落古道空，天青暮云碧。\n何处一声蝉，幽栖仍自得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题自画横披与翟伯寿","author":"米友仁","text":"山中宰相有仙骨，独爱岭头生白云。\n壁张此画定惊倒，先请唤人扶著君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"米友仁","text":"山气最佳处，卷舒晴晦云。\n心潜帝乡者，愿作乘彼君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"米友仁","text":"密密万山重，一派哀湍泻。\n此志入瑶琴，当有知音者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题杜甫诗意图","author":"司马槐","text":"峰迥石路转，足可娱瞻听。\n其中如有屋，便是醉翁亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题清芬阁","author":"鲁君贶","text":"先生遁世有高才，越国风烟入手来。\n直以五言□治乱，何须一命寄尘埃。\n放怀想觉乾坤小，□物能驱造化回。\n贤矣远孙今善继，出入头角□云雷。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题白崖","author":"庞其章","text":"金地枕岩壑，登临荡郁怀。\n林泉围翠幄，仙洞锁阴霾。\n秋练澄江静，云屏叠嶂排。\n坐凉风入竹，殿古藓侵阶。\n潇洒来僧舍，嚣烦厌县斋。\n白崖今得到，无处问洪崖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"齐山","author":"狄咸","text":"秋浦分光来郡阁，清溪送影落征船。\n翠微亭冠烟霞外，又遇携壶太守贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"狄咸","text":"旃檀归象魏，窣堵卧烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和张赛赛","author":"崔木","text":"琴书相伴到神州，幸际朋俦过遇沟。\n主礼殷勤排燕会，佳人宛转动莺喉。\n自惭馀子无才学，却使当年与唱酬。\n尤幸期时再相见，从今应不作花羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢崔子高","author":"张赛赛","text":"春光骀荡满皇州，袅袅垂杨夹御沟。\n新燕梁间调好语，雏莺林内啭歌喉。\n当筵幸与多才遇，好景须还雅韵酬。\n多谢东君多顾盼，免教重罚一生羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答天宁长老","author":"释禅惠","text":"文殊驾狮子，普贤跨象王。\n新来一个佛，骑马也何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释禅惠","text":"锦府岂从天上织，剑门宁自匣中开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"信阳道人","text":"日坐竹马桥，夜宿牧牛轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"李迥","text":"揖客将军重，扬名御史尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏洗心堂得鸟鸣山更幽 其一","author":"吕天策","text":"吾庐一甑大，暑气日焚燎。\n肉山渐欲摧，性命那可保。\n华堂纳虚明，结屋上林杪。\n扳联此间来，乍喜脱袢扰。\n断虹锦连卷，惊沤玉颠倒。\n晴沙四十里，一日坐可了。\n将归复班荆，更迟江月皎。\n何当制芙蓉，唱棹入鱼鸟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏洗心堂得鸟鸣山更幽 其二","author":"吕天策","text":"惮暑废百嗜，飘然念遐征。\n顾欲控溟渤，与世湔烦蒸。\n并舍松桂合，翠光浮栋楹。\n时时厉清响，管磬琵琶筝。\n敷床荫其下，蕲竹瑩寒冰。\n自足当两部，妙处讵难名。\n候汤瀹葵月，欲赴松风鸣。\n诗成定清切，已作寒蜩声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏洗心堂得鸟鸣山更幽 其三","author":"吕天策","text":"携手日不足，暂聧心已悭。\n况复共理策，相从山水间。\n晴江照远岫，晓镜堆烟鬟。\n玄蛟忽汹涌，大浪堆银山。\n吾郎气吞纳，为之发冲冠。\n诗材入意底，妙斲寄毫端。\n我衰如病骥，蹩躠那容攀。\n且乞置是事，不语循刀镮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏洗心堂得鸟鸣山更幽 其四","author":"吕天策","text":"登山午未饭，已觉疲发胫。\n饥肠转空雷，圆顶已三请。\n为享玉龙雏，咄嗟办汤饼。\n顾非大檀越，劝劳久逾敬。\n晚觞玉色醪，蘸甲黎花瑩。\n浩歌不知疲，木杪挂飞镜。\n人生行乐耳，所能与时竞。\n试与芙蓉子，后会约君更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏洗心堂得鸟鸣山更幽 其五","author":"吕天策","text":"环沙饶沃壤，农工敏锄耰。\n青秧拥翠被，大堤蔽吴牛。\n渔商蛮獠杂，结屋桑柘幽。\n翁妇顾相喜，占风知有秋。\n吾侪拙生事，腹果即无求。\n年丰预有托，一饱不难谋。\n钟鼎固乐矣，其乐如是不。\n未可议鹏鴳，各尽逍遥游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乾明院让道人房与朱仲潜探梅","author":"吕天策","text":"春工未仲闲桃李，偏向梅花先著意。\n铅华不御见真色，香密染衣冰琢蕊。\n旧游颇念秦郎中，梦里五年如历指。\n叫呼连索酒浇春，尚想横瓶枕花底。\n今年梅侣更何人，我狂骂坐初不嗔。\n风流端的美无度，携手错疑君姓秦。\n往来百匝将重趼，鸟道萦盘封碧藓。\n团枝冻蕊未全苏，已见横斜照清浅。\n晓来霁色酿春风，金须渐吐香蒙茸。\n开迟政恐有遗恨，未破君家宫锦红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"秦湛","text":"大胜商山老，同居一木奴。\n杌■危中垒，高耸垛中雏。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罗浮即景","author":"孙钦臣","text":"巨鳌掀钓去，何代泛蓬瀛。\n百里风光积，崇朝香气横。\n盘根争耸拔，峻岭共峥嵘。\n伞盖千重出，笙竽万籁声。\n望高南镇越，势远北归溟。\n涧险难穷路，花多不记名。\n寒流飞白练，怪石叠苍琼。\n雨向山腰下，云从洞口生。\n乔松随岁古，异卉逐时荣。\n近逼天风冷，遥瞻海日明。\n淡烟轻纠素，修蔓密垂缨。\n泉涌知无尽，崖危讶欲倾。\n深沈宜造化，顷刻变阴晴。\n游客逢岩住，归僧带月行。\n更寻应有分，再到已忘情。\n但恐看难遍，须知画不成。\n惜哉居绝域，不得视公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题宗室永年画犬图","author":"夏倪","text":"公子朝回玉宸里，戏弄丹青歌扇底。\n兴来貌写到浓氂，拳尾如摇欲投胔。\n丰颅阔腋伟骨相，纵逸未饶卢鹊驶。\n庭除夜閒春尚寒，屈藏短喙眠朝暾。\n其一狺狺口若吠，欲前却立客在门。\n俗言犬马最难画，众所共识谁面谩。\n非如鬼物隐幽眇，反覆丑好悬毫端。\n纷纷众史坐叹息，笔仗突兀不可扳。\n乃知心匠本神授，以心运手不作难。\n我家败屋依破垣，偷儿踏瓦惊夜眠。\n四壁虽如长卿第，旧物犹存子敬毡。\n就君乞取挂墙壁，端能警我窥窬客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"跋聚蚁图","author":"夏倪","text":"纷然虫臂蚁争环，付与高人一解颜。\n不待南柯婚宦毕，始知身寄大槐间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王子飞题李伯时画列子御风图","author":"夏倪","text":"道师形气合于无，八极超摇得自如。\n知我御风风御我，长袪猎猎自乘虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵题归去来图","author":"夏倪","text":"阶亭午景负槐阴，空斋初罢戏五禽。\n沔州太守致音问，启读乃有归来吟。\n先生抱道肯乞怜，凛凛有面方如田。\n何能为此五斗粟，折腰乡里小儿前。\n顾视铜章等涕吐，赋归唾词如涌泉。\n龙眠居士叹豪逸，想像明窗戏拈笔。\n翕忽英姿来笔下，如恐超起将羽化。\n吁嗟能事讵可畴，一见公诗如见画。\n惜哉道远莫可致，强欲赓酬抽鄙思。\n韵绝难追神易倦，使我空然汗颜面。\n他日从公会借观，锦囊捧出春笋寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵汉阳蔡守题阳关图","author":"夏倪","text":"君不见季子敝尽黑貂裘，一生车辙环九州。\n使之负郭有二顷，未必肯相六国侯。\n此郎亦复何为者，浪自出入不肯休。\n东风夹道罗供帐，倚马欲行那得上。\n绿尊翠勺浩纵横，四坐哀歌互酬倡。\n阴云漠漠天四垂，行子多著短后衣。\n金羁滴沥鸣翠弭，负屩蹶倒从卢儿。\n渔舟微茫出浦溆，远山无数迎修眉。\n倾曦驮醉出关去，纵有离愁渠得知。\n长安春色浓如酒，乃向斯时别亲友。\n可怜儿女浪苦辛，奔走功名逮华首。\n浊醪百榼胸崔嵬，暮色惨惨羁鸿哀。\n羊肠鸟道天尺五，尔独胡为来此哉。\n水有蛟龙狞口眼，陆有兕虎潜岩隈。\n嗟尔游子不顾返，富贵有时终自来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和黄鲁直游百花洲盘礴范文正公祠下以生存华屋处零落归山丘为韵赋十诗 其一","author":"夏倪","text":"神文秉周礼，庙乐奏九成。\n当时夔一足，不待鲁诸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和黄鲁直游百花洲盘礴范文正公祠下以生存华屋处零落归山丘为韵赋十诗 其二","author":"夏倪","text":"啧啧鹊噪屋，愔愔蛛网门。\n我来九顿首，生气凛如存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和黄鲁直游百花洲盘礴范文正公祠下以生存华屋处零落归山丘为韵赋十诗 其三","author":"夏倪","text":"堂堂古遗直，心严貌无华。\n人见不妩媚，何以娱大家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和黄鲁直游百花洲盘礴范文正公祠下以生存华屋处零落归山丘为韵赋十诗 其四","author":"夏倪","text":"朴蔌复朴蔌，何以栋我屋。\n风雨莫轻摇，南山无老木。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和黄鲁直游百花洲盘礴范文正公祠下以生存华屋处零落归山丘为韵赋十诗 其五","author":"夏倪","text":"有酒当自醑，有室莫共处。\n古今一丘貉，何能坐飞语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和黄鲁直游百花洲盘礴范文正公祠下以生存华屋处零落归山丘为韵赋十诗 其六","author":"夏倪","text":"梦回四贤篇，长风吹人醒。\n嗟哉不我见，泪与秋露零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和黄鲁直游百花洲盘礴范文正公祠下以生存华屋处零落归山丘为韵赋十诗 其七","author":"夏倪","text":"百代无几人，九原何可作。\n不必温御史，解令君胆落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和黄鲁直游百花洲盘礴范文正公祠下以生存华屋处零落归山丘为韵赋十诗 其八","author":"夏倪","text":"宝元乃多故，公时总戎机。\n胸中百万兵，要取横山归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和黄鲁直游百花洲盘礴范文正公祠下以生存华屋处零落归山丘为韵赋十诗 其九","author":"夏倪","text":"公归今几时，遗懿何斑斑。\n公议要难没，言波可怀山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和黄鲁直游百花洲盘礴范文正公祠下以生存华屋处零落归山丘为韵赋十诗 其十","author":"夏倪","text":"我心不可规，滔滔谁与游。\n向来秉大雅，今复成一丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿蒲宪","author":"夏倪","text":"君不见相如题桥出蜀都，归来驷马驾赤车。\n王孙喟叹分金珠，遽喜文君得此夫。\n又不见扬雄玄经垂日月，承明昼日见三接。\n当年戏为赋甘泉，炯炯至今光不灭。\n山川炳灵四载英，两君千载悬盛名。\n后来继者谁其人，蒲公使君早飞声。\n先皇侧席搜殊杰，明公凛凛来射策。\n合沓英词动一时，紫燕飞黄行莫测。\n文明天子脩前烈，赤轭班输公建节。\n二年和气满西川，父老欢娱丰两颊。\n锦瑟高张箫鼓集，还见公膺诞弥日。\n玉露金风丽早秋，绿樽翠杓明相射。\n有酒如渑肉如陵，再拜寿公千百年。\n愿公早早树高勋，快插貂蝉据鼎茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]