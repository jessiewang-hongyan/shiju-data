[{"title":"再用前韵 其五","author":"袁甫","text":"蒲卢喻政意何如，此语源流亦自洙。\n若愿小民皆类我，须知类我始生徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵 其三","author":"袁甫","text":"百首诗成遇赏音，云何容易动归心。\n少陵不肯为轻薄，笑杀王杨井底沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵 其一","author":"袁甫","text":"山未烟云水未波，试参妙处定如何。\n黄花未见应难会，见了黄花会意多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵 其二","author":"袁甫","text":"本是尘中诗兴微，秋风偶折最高枝。\n诗坛方筑那言去，为我留连百首诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵 其三","author":"袁甫","text":"诚心谕俗淑斯人，莫宝金珠宝此身。\n昨日偶拈乡记看，几家孝养渐兴仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵 其一","author":"袁甫","text":"瑚琏区区只小成，休言果艺与忠清。\n圣师忘食兼忘老，地久天长日月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵 其二","author":"袁甫","text":"心事如何忍负初，官居每忆过庭趋。\n勤勤抚字今微验，雨足春畴不待雩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵 其四","author":"袁甫","text":"吾儒政事话头长，步步诗书可暂忘。\n齐相未知真不扰，无端逊与盖公堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59439,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵 其四","author":"袁甫","text":"逝者如斯昼夜长，会心能使百忧忘。\n生前身后浑如此，丝竹之音孔子堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59440,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵 其二","author":"袁甫","text":"修慝之馀德复初，更须辨白舍并趋。\n善哉三语当年问，直到于今想从雩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59441,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵 其三","author":"袁甫","text":"两地参天命曰人，灵龟端合取诸身。\n笑渠到处閒寻觅，直信人言井有仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59442,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵 其五","author":"袁甫","text":"小时所学老何如，自诧西河不记洙。\n曾子斯言讥背本，祇今犹足警吾徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59443,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和时习五章章取礼记一句 其三 月令鹰乃学习","author":"袁甫","text":"鹰犹知学况于人，羽翮冲霄具此身。\n须信数飞方解熟，熟之又熟即为仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59444,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和时习五章章取礼记一句 其一 王制习乡上齿","author":"袁甫","text":"复礼工夫本易成，此心对越只寅清。\n居乡上齿家常饭，此道于今晦不明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59445,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和时习五章章取礼记一句 其四 玉藻习容观玉声","author":"袁甫","text":"佩玉之声清越长，此身无故讵容忘。\n挈渠方屦圜冠士，登我光风霁月堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59446,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和时习五章章取礼记一句 其二 射义习射于泽","author":"袁甫","text":"蓬矢桑弧男子初，泽宫试事翼如趋。\n采蘩盈耳皆音节，盛乐何消待大雩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59447,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿冯德厚三首 其三","author":"袁甫","text":"朱弦疏越澹徽音，身在尘中只古心。\n祝子长年仍健饭，好书读到夜沈沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59448,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿冯德厚三首 其二","author":"袁甫","text":"麟经咀嚼造深微，攀取秋风第一枝。\n便把斯言为子寿，崧高不用更吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59449,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿冯德厚三首 其一","author":"袁甫","text":"人生汩汩逐风波，祝子长年要若何。\n一日洞然无障碍，元来佛法也无多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59450,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿张亨之祖母夫人","author":"袁甫","text":"为问蟠桃熟几番，见儿发白著衣斑。\n孙枝又作红蕖客，更愿云礽捧寿山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59451,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿赵处仁母夫人","author":"袁甫","text":"有子见知真西山，有孙又把桂枝攀。\n堂前萱草年年绿，庆事天公定不悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59452,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"时习堂记言五典也载赓前韵以歌之 其四","author":"袁甫","text":"徐行后长味深长，此道谁能笃不忘。\n我欲讲行乡饮酒，大明上齿习斯堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59453,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"时习堂记言五典也载赓前韵以歌之 其一","author":"袁甫","text":"事亲尽孝自天成，鉴本无尘水本清。\n相彼禽兮犹学习，灵乌反哺更分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59454,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"时习堂记言五典也载赓前韵以歌之 其三","author":"袁甫","text":"齐家断勿责他人，须信仪型只在身。\n习习谷风讥义薄，交相爱也是为仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"时习堂记言五典也载赓前韵以歌之 其二","author":"袁甫","text":"习容斋戒适朝初，佩玉锵鸣谨进趋。\n大分凛然冠屦判，一诚不散若郊雩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵克家三洞天二首 其二","author":"袁甫","text":"自昔尧汤水旱年，祇缘先备国无捐。\n我今皭火区区甚，惭见容光照洞天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵克家三洞天二首 其一","author":"袁甫","text":"洞外老天非不大，洞中天小却奇哉。\n此奇端的由天造，不枉携朋得得来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和晋斋兄韵三首 其三","author":"袁甫","text":"家塾提纲属晋斋，絜斋气脉远乎哉。\n何时升讲开聋聩，衿佩跄跄济济来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和晋斋兄韵三首 其二","author":"袁甫","text":"不羡勋名逐日新，课孙种绩及青春。\n试将圆镜当空照，始识庐山面目真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和晋斋兄韵三首 其一","author":"袁甫","text":"不爱金章紫绶纡，欣然玉局自安居。\n近来作计谁云拙，六六之年创一庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和魏都大牡丹二首 其二","author":"袁甫","text":"费尽工夫始盛开，一时赏玩四时培。\n东君摧折飘零后，犹带天香溪上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和魏都大牡丹二首 其一","author":"袁甫","text":"初放姚黄一两枝，旋看魏紫格尤奇。\n天公似欲留连住，伴我酴醾满架时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送别再用前韵 其一","author":"袁甫","text":"歙江归艇棹晴波，同去同来日几何。\n不怕黄花负人约，只愁人意负花多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送别再用前韵 其二","author":"袁甫","text":"凤凰翔集肯卑微，独向梧桐拣一枝。\n乍别故栖知未忍，临行更赋白圭诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留无邪字","author":"袁甫","text":"此骏产渥洼，神奇莫浪誇。\n相期千里志，赠子字无邪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"索新进诗","author":"袁甫","text":"君传秘诀解观人，瞥见双眸识破真。\n收拾后生知几许，为予唤取傥相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"耕乐诗四首 其四","author":"袁甫","text":"少时操笔代躬耕，老鹤如今太瘦生。\n已识个中真乐地，谁云骨相费生成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"耕乐诗四首 其三","author":"袁甫","text":"一片灵明自有田，当仁那肯逊儒先。\n归来不说溪山好，只说癯仙气浩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"耕乐诗四首 其二","author":"袁甫","text":"一犁春雨趁农耕，歌咏康衢了此生。\n若有可忧方有乐，本无亏处亦无成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"耕乐诗四首 其一","author":"袁甫","text":"优游无事只耕田，顾我归耕子已先。\n可但千仓良足乐，不收一粒亦欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莫能名庵二首 其二","author":"袁甫","text":"青山突兀倚长空，不作人间儿女容。\n几载无名茅处士，一朝识破有林宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莫能名庵二首 其一","author":"袁甫","text":"说道空空元不空，太空何物不能容。\n世人枉被虚名幻，到底还须识正宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崇圣寺瀑布泉二首 其二","author":"袁甫","text":"半山飞瀑元如雪，况是今朝雪里来。\n界破青山休谩诧，神光妙用亦奇哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崇圣寺瀑布泉二首 其一","author":"袁甫","text":"古来翠瀑仅涓涓，戛玉新亭却沛然。\n世事废兴皆若此，醉眠何用问青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游敬亭山用谪仙韵二首 其二","author":"袁甫","text":"事从尘世去，心共白云閒。\n不作游山计，朝朝饱看山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游敬亭山用谪仙韵二首 其一","author":"袁甫","text":"黄檗道场古，裴公心事閒。\n白诗三绝并，那似敬亭山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赓周纯甫求归三首 其一","author":"袁甫","text":"秋风一夜簸清波，我自思亲奈客何。\n远地少书消息好，书多愁闷转添多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题半霄亭","author":"袁甫","text":"今朝带月上山头，面面晴岚翠欲流。\n此处青霄才是半，半霄以上许登不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题象山先生帖","author":"袁甫","text":"谊重姻联语甚真，典型满纸墨犹新。\n中间多少箴规意，须信亲亲即是仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题慈云阁","author":"袁甫","text":"不见慈湖二十年，忧心如醉复如颠。\n我来忽见慈云阁，恍若慈湖现我前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蟠梅二首 其二","author":"袁甫","text":"幸自尘埃不许侵，千盘万结戏相寻。\n只缘漏泄春消息，惹动旁人机巧心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蟠梅二首 其一","author":"袁甫","text":"篱外横斜只任真，无端束缚损花神。\n孤标自是为人妒，一笑春风不用嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衢学讲堂更名时习和贰车韵五首 其五","author":"袁甫","text":"莫道今人不古如，分明气象鲁之洙。\n坤爻六二知何义，试叩胶庠学易徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衢学讲堂更名时习和贰车韵五首 其四","author":"袁甫","text":"缅怀周道意悠长，事业姬公念不忘。\n宗庙百官谁识者，仲由也只许升堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衢学讲堂更名时习和贰车韵五首 其三","author":"袁甫","text":"终身不察是凡人，一日三回省此身。\n参也亲传端的处，品题宜亚不违仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衢学讲堂更名时习和贰车韵五首 其二","author":"袁甫","text":"意味澄然未动初，纲常大道本同趋。\n直须丽泽工夫熟，便是当年咏舞雩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"衢学讲堂更名时习和贰车韵五首 其一","author":"袁甫","text":"道心无坏亦无成，只怕微云点太清。\n重坎之亨人不识，一轮素月本来明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和毛中书劝农韵三首 其三","author":"袁甫","text":"劳农因得步河桥，仰视前贤隔九霄。\n凡骨难仙安素履，腐儒学吏守邦条。\n荷公美意鞭驽质，惠我名篇胜翠翘。\n痛饮春醪那可强，胸中磊块把诗浇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和毛中书劝农韵三首 其二","author":"袁甫","text":"历遍田畴问我农，都言杼柚久虚空。\n吏胥祇是工椎剥，仓廪何曾识腐红。\n愿得家家歌乐岁，直须日日扇和风。\n如今拙手徒餐粟，惭见天民四者穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和毛中书劝农韵三首 其一","author":"袁甫","text":"曲奏梅花促晓更，更声方断又鸣钲。\n篮舆咿轧亲巡野，枥马喧填看勉耕。\n酒酌田翁添醉色，泽均牧叟助欢声。\n天公也欲催佳句，特放晴光分外明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王伯友韵","author":"袁甫","text":"三春强半麦青青，是处田家只望晴。\n雪压霜欺愁正极，日融云净眼增明。\n纷纷民瘼关吾念，得得天公相此行。\n更问老农官与吏，几人贪浊几人清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和令君岁寒亭韵","author":"袁甫","text":"老干森森当翠屏，壁间诗句有留名。\n昔逢利口挤之死，今伴苍髯凛若生。\n雪压枝擎犹有力，月高林静更双清。\n抚松似共黄门语，况听萧萧枕上声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和越帅汪仲宗韵","author":"袁甫","text":"稽山窟宅尽神仙，多少棠阴属钜贤。\n万壑千岩长似旧，一翁二季美无前。\n风流自昔遗芳在，衣钵于今盛事传。\n行见直声追轨躅，岂徒庆礼侈宾筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏丹桂赠周纯甫冯德厚 其一","author":"袁甫","text":"一种自然色，如吾方寸丹。\n天教传信到，人莫作花看。\n骨气超凡俗，声名彻广寒。\n留君良为此，忆别鼻休酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏丹桂赠周纯甫冯德厚 其二","author":"袁甫","text":"孤却团圆月，今朝桂子丹。\n莫教疏雨打，留向晚秋看。\n色借幽岩秀，香通古壑寒。\n痴儿被花笑，世味只辛酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏东松庵","author":"袁甫","text":"作意东松访旧闻，山岩窟里梵宫存。\n矮楼蛙井身如蛰，峭壁鱼鳞手可扪。\n草草反成多景致，悭悭别是一乾坤。\n输他饱饭安眠处，朝暮烟霞看吐吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岳忠武祠三首 其三","author":"袁甫","text":"背嵬军马战无俦，压尽当年几列侯。\n先辈有闻多散轶，后生谁识发潜幽。\n伤心咄咄权臣事，满眼滔滔债帅流。\n槌剥到今浑似鬼，向人休说是貔貅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岳忠武祠三首 其二","author":"袁甫","text":"儿时曾住练江头，长老频频说岳侯。\n手握天戈能决胜，心轻人爵祇寻幽。\n堪嗟爝火当时灭，谁信长川万古流。\n机会莫言今到手，却愁无饭饱貔貅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岳忠武祠三首 其一","author":"袁甫","text":"当年老桧肆欺谩，忠武哀哉抱寸丹。\n赖有皇天为吐气，岂无青史更诛奸。\n字留陈迹何年泯，烟锁空山尽日閒。\n世事关心眠不得，今朝下涕为潸潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钓台","author":"袁甫","text":"朔风吹我到严滩，拥被掀篷一破颜。\n寒色侵凌欺白发，雪花撩乱失青山。\n未消据案千尘积，且爱哦诗一饷閒。\n惭愧钓台风韵在，他年归隐许跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送池阳张倅奉祠归清江二首 其二","author":"袁甫","text":"自怜凡骨未能仙，每对仙都辄爽然。\n序齿十年兄弟行，论交一日友朋缘。\n干戈满地心忧国，事业弥天世急贤。\n已把封章排紫闼，未容问舍与求田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送池阳张倅奉祠归清江二首 其一","author":"袁甫","text":"题舆名满大江东，忽忆家山閤皂中。\n孤棹赋归犹带雪，深衣养浩直摩空。\n从教风月分多少，独抱春秋究始终。\n籍湜近来知叛否，只君不负紫阳翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读朱冠之诗有作三首 其三","author":"袁甫","text":"多言外好中何有，有德之言春意融。\n惟一性天真洞彻，许多事理尽流通。\n句新悦耳源先涸，思苦雕肝味易穷。\n自古才人皆患此，就中崛强是扬雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读朱冠之诗有作三首 其二","author":"袁甫","text":"浮云擘破月华明，怎得浮云不再生。\n几度月明云几擘，全无云翳月全清。\n后生欲解凭谁问，先觉虽知肯尽明。\n苦硬工夫须彻底，秋云漠漠一轮横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":59505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]