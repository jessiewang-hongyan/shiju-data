[{"title":"西园风雨杂花谢","author":"张耒","text":"楚泽春残雨又风，啼莺芳草思无穷。\n芜菁满地黄金烂，不及蔷薇一点红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西轩","author":"张耒","text":"出架蔷薇秀晚枝，雨馀屋角理蛛丝。\n可怜一曲秋风地，万思千情斗入诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖三首 其二","author":"张耒","text":"水上亭台凉气多，扣舷倚棹唱吴歌。\n何人为放青莲出，剪却翻翻一万荷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西窗杂咏三首 其三","author":"张耒","text":"稻畦新插绿云齐，雨过沟塍水接溪。\n到舍妻儿劳勤苦，白醪缸畔醉如泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观苏仲南诗卷","author":"张耒","text":"苏子诗如刃发硎，十章入耳韵泠泠。\n文章三昧无多子，祇守君家旧典刑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观鱼亭呈陈公度二首 其二","author":"张耒","text":"猎猎微风波面开，近人鸥鹭不相猜。\n樽前忽起扁舟兴，新管江南山水来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观鱼亭呈陈公度二首 其一","author":"张耒","text":"千古濠梁庄惠词，不须反覆辨真知。\n直应人意逍遥处，便是游鱼自乐时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观音泉","author":"张耒","text":"岩松偃盖不知年，寂寂秋灯宝供前。\n清彻一源传万古，空山长伴白衣仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"许同尘示张八侍郎避暑览馆中旧题绝句俾之同作次韵","author":"张耒","text":"聚散人生集渚鸿，飞鸣邂逅一宵同。\n是非荣辱何劳问，共在邯郸一枕中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过涟水","author":"张耒","text":"城头落日在旗竿，城外长淮水浸天。\n左海门前灯火尽，橹声呕轧夜深船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过蕲泽","author":"张耒","text":"雄吞六国弱秦强，壮士逡巡野水傍。\n耕叟不知鸿鹄志，笑观宫室忤陈王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐安春谣五绝 其四","author":"张耒","text":"赤壁矶前江急流，周郎功业莽悠悠。\n惆怅沙边雨中树，无言供作古今愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐安春谣五绝 其二","author":"张耒","text":"莫笑江城大如斗，桃花如烧酒如油。\n人生无病即为乐，莫诵离骚泽畔愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初见嵩山","author":"张耒","text":"年来鞍马困尘埃，赖有青山豁我怀。\n日暮北风吹雨去，数峰清瘦出云来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏谒告家居值风雨偶作二绝 其一","author":"张耒","text":"春愁已逐莺花尽，野果垂檐绿叶稠。\n天上几回飞破镜，端居未折大刀头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初离山阳寄城中友人二首 其二","author":"张耒","text":"野岸萧萧落叶风，秋光离思两相攻。\n殷勤临水挥双泪，凭寄清流却向东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初离山阳寄城中友人二首 其一","author":"张耒","text":"落月昏昏向水低，五更残烛一声鸡。\n祇应魂梦犹东去，从此扁舟日向西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初离陈寄孙户曹兄弟","author":"张耒","text":"三年流落寓于陈，一命青衫淮水滨。\n城北桥边长送别，扁丹今自作行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别齐安税务窗竹二绝 其一","author":"张耒","text":"何独王郎与尔欢，一年惭愧碧琅玕。\n葛陂一别知何处，见尽人间行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c