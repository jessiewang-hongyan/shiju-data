037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴江道中怀陆鲁望","author":"张耒","text":"我亦扁舟一散人，江湖为洗十年尘。\n笔床茶灶经过地，风月相望亦有神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吹角","author":"张耒","text":"断霞归鸟隔山钟，日过西山转海空。\n长恨南城催晓急，五更吹角怨秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈宜君","author":"张耒","text":"江城风雨作朝昏，愁杀垆边卖酒人。\n祇有醉时差可喜，不应醒坐过新春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋玉","author":"张耒","text":"云雨朝朝峡里兴，可能无复梦中情。\n巫娥若问谁为赋，敢乞君王道宋生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋景平命赋隔窗花影","author":"张耒","text":"午睡帘栊春日长，半消金鸭水沉香。\n隔窗花影时来去，疑有东邻觇宋郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"局中听雨","author":"张耒","text":"秋庭听雨断人声，凉入衣裾秋意生。\n临水登山送归语，怜君解有许多情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"巫臣二首 其二","author":"张耒","text":"咫尺山河不易知，无言莫谓即无思。\n人间只见枝头茧，不悟春蚕暗理丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"巫臣二首 其一","author":"张耒","text":"万古风情不易禁，多言未似不言深。\n楚王只听巫臣谏，不道逃吴已有心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀陆羽井","author":"张耒","text":"寒泉背石老松根，禅室幽人古像存。\n长恨千年无屈宋，楚招难与此遗魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀金陵三首 其三","author":"张耒","text":"曾作金陵烂漫游，北归尘土变衣裘。\n芰荷声里孤舟雨，卧入江南第一州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀金陵三首 其二","author":"张耒","text":"璧月琼枝不复论，秦淮半已掠荒榛。\n清溪天水相澄映，便是临春阁上魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀金陵三首 其一","author":"张耒","text":"此君堂后青苍玉，别后何曾寄一声。\n想见秦淮月堂下，西风吹浪拍堤平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀竟陵莲花","author":"张耒","text":"景湖门外有汀洲，灼灼红莲照碧流