r/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和晁十七落花二首 其二","author":"张耒","text":"飞随风雨落随流，更有馀红亦已休。\n杳杳天涯春物尽，可怜莺蝶不知愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和晁十七落花二首 其一","author":"张耒","text":"投老殷勤向物华，风前犹欲拾馀花。\n更将梦逐残红去，遍入长安百万家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卧病昼眠秋风作恶","author":"张耒","text":"东堂岑寂似僧居，年老身閒不读书。\n病卧空床鸡唱晓，窗前饥雀啄寒蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和人二首 其二","author":"张耒","text":"曈眬晓日漏春光，栏下萱丛尚卧霜。\n认得君家门上雪，易知何事却难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和人二首 其一","author":"张耒","text":"腊残春近独消魂，残雪长安千万门。\n青鸟何曾寄音信，碧云刚解报黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":51061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和天启惠橘诗","author":"张耒","text":"十年不摘洞庭霜，喜见新苞照眼黄。\n但对典刑休嗜味，虎贲犹得作中郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f7