[{"title":"送灵谷山人","author":"余靖","text":"万树秋风一路蝉，渡头重舣木兰船。\n自惭蹙頞非奇骨，拟问清朝跃马年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重游英州碧落峒","author":"余靖","text":"幽景前贤恨到难，泉声清浅出岩间。\n区区宦路重来此，尘世难逢特地闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄袭长老","author":"余靖","text":"三径荆榛尽力开，千株桃李手新栽。\n慇勤莫怪寻嘉树，又喜春风过岭来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄韶石长老求柏栽","author":"余靖","text":"森然桃李阴，当春皆手植。\n更求青青枝，要见岁寒色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒山","author":"余靖","text":"空翠纷纷冷不流，风云常是护灵湫。\n山神鞭起龙行雨，散作炎州六月秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答伯恭招棋","author":"余靖","text":"谁知坐隐妙通仙，国手那能得万全。\n对面机关难测度，临危一著谩争先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答祖太博借山居要术","author":"余靖","text":"经济谅周当世务，收藏敢秘老农书。\n相逢莫羡山居好，归去蓬山有直庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢伯恭重阳惠酒","author":"余靖","text":"早霜新菊谩葳蕤，寇过人家空酒卮。\n多谢使君怜病废，免教寂寞倚东篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢伯恭篆屏蟾砚","author":"余靖","text":"古砚蟾蜍滴，文屏薤叶书。\n世间多倚伏，休叹橐中虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢送篆文屏风因次来韵","author":"余靖","text":"一局聊将万境袪，非同得兔守枯株。\n北窗枕畔添奇物，却想渊明旧日无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢邕倅王寺丞惠韩柳碑文","author":"余靖","text":"南方异产足珠珍，薏苡兴谗不忍闻。\n一见知君清白节，箧中惟贮色丝文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感旧","author":"余靖","text":"醉吟曾共倚江楼，秾艳清香万柄秋。\n荡子再归时已暮，暮鸿惊散水悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午日事","author":"余靖","text":"江上何人吊屈平，但闻风俗彩舟轻。\n空斋无事同儿戏，学系朱丝辟五兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午日寄酒庶回都官","author":"余靖","text":"龙舟争快楚江滨，吊屈谁知特怆神。\n家酿寄君须酩酊，古今嫌见独醒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日赏池会上酬王职方","author":"余靖","text":"雅集高谈思豁然，齐山依约对疏烟。\n江城泛菊逢佳节，禁苑闻韶忆去年。\n久厌风波惊世路，且同樽酒醉凉天。\n今来古往情何异，弄水亭边舣画船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和寄提刑太保","author":"余靖","text":"常记临岐把酒杯，芳心应得见归来。\n不从去日丁宁约，已向东风取次开。\n清燕固难停烛待，雕鞍须是著鞭催。\n栏边残艳犹堪赏，莫使韶光过了回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子规","author":"余靖","text":"一叫一声残，声声万古冤。\n疏烟明月树，微雨落花村。\n易堕将乾泪，能伤欲断魂。\n名缰惭自束，为尔忆家园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山馆","author":"余靖","text":"野馆萧条晚，凭轩对竹扉。\n树藏秋色老，禽带夕阳归。\n远岫穿云翠，畬田得雨肥。\n渊明谁送酒，残菊绕墙飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仁宗皇帝挽诗二首 其二","author":"余靖","text":"四十载居尊，勤劳涤化源。\n精禋敦舜孝，至治布尧言。\n武尚包戈节，刑宽解网恩。\n遗弓初奉讳，雨泪遍乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仁宗皇帝挽诗二首 其一","author":"余靖","text":"丕承三后绩，盛烈古难陪。\n纳谏书囊集，谈经殿阁开。\n御弧圆月满，宸翰舞鸾回。\n冠剑虽归葬，英风万祀恢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"双松","author":"余靖","text":"自古咏连理，多为艳阳吟。\n谁知抱高节，生处亦同心。\n风至应交响，禽栖得并阴。\n岁寒当共守，霜雪莫相侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"先赏牡丹寄提刑考功","author":"余靖","text":"花期何事早追陪，莺未迁乔燕未来。\n曲槛为逢春日暖，香苞先逐晓风开。\n旋邀歌舞同侪乐，却叹光阴急景催。\n可惜韶妍莫虚掷，馀芳留待使车回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同李秘校谭员外月华长老谒慈济禅师会宿宝林道场","author":"余靖","text":"祖堂留胜迹，再宿此登临。\n云月自明暗，山川无古今。\n谷声猿啸远，泉脉虎跑深。\n共到忘言处，休论佛与心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同李秘校谭员外宿月华上方","author":"余靖","text":"上方逢夏夕，月色遍千山。\n但觉星河近，偶同江海闲。\n事抛兴废外，谈极有无间。\n却笑明朝俗，红尘随马还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同黄宰游宝林精舍书祐长老壁","author":"余靖","text":"浮生万虑日营营，同访禅居耳目醒。\n寻胜已穷烟霭外，谈空应有鬼神听。\n松筠不变春长在，风雨无时地本灵。\n便拟搆庵来结社，莫嫌频此扣岩扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回雁","author":"余靖","text":"暗随春力起冥冥，微物宁知造化情。\n律变惭逢冰雪解，风和应助羽毛轻。\n塞云空阔归犹远，鱼网稀疏意尚惊。\n不学鹰鹯因肉饱，背人飏去恣飞鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵奉和到塞下有怀青社之作","author":"余靖","text":"十二山河壮东夏，黄扉当日建行台。\n封陲自此赭衣尽，黉校于今绛帐开。\n负海遂成安堵俗，济川元是代天才。\n耆明虽乐归閒趣，睿眷岩廊徯再来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬孙明复见寄","author":"余靖","text":"门外车尘绝，樽前俗虑无。\n轻身脱羁绊，曳尾得泥涂。\n出处天真在，炎凉物性殊。\n寄言钦雅意，相望隔江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西山","author":"余靖","text":"万壑千岩斗物华，支筇閒访道生涯。\n一坛星斗修真馆，数里云烟斸药家。\n鱼戏竹溪寒影碎，路穿松坞翠阴斜。\n桃源自有神仙宅，未信明河八月槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"许申工部招九华许亮山人因有和赠","author":"余靖","text":"闻说方平镇往来，碧衣曾见立徘徊。\n中真久待茅君会，密信频教鹤使催。\n玉斧祖风应共继，琼酥宾宴更谁陪。\n西山五色从兹得，脱略浮名薄似埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵树喜长老属疾见寄次韵酬之","author":"余靖","text":"鸣韶山下客，多病似吾身。\n每想弥天辩，谁为问疾人。\n泉清偏照月，松瘦不知春。\n未遂寻高论，相遥一水滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵泉山上晚望","author":"余靖","text":"野旷树还乱，林深烟更微。\n天随残日尽，云掣断山飞。\n玉垒风烟阔，秦城草木腓。\n凭高无限事，今夜客沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王子元同归曲江有感","author":"余靖","text":"年少登科今白头，不才多病分归休。\n深恩未报云天施，弱质易惊蒲柳秋。\n进退无机常蹭蹬，穷通知命自夷犹。\n相逢莫问市朝事，绿水青山是胜游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王子元重阳日千善寺会饮","author":"余靖","text":"人生聚散苦难期，且喜清游酒满卮。\n秋径却逢黄菊日，春风休惜落花时。\n仙翁有谶应须避，楚客多悲亦强为。\n好景莫教容易过，醉吟何必绕疏篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和伯恭殿丞登武江门楼怀杨叔武太保","author":"余靖","text":"徙倚江边槛，旌旗望处遥。\n交情深慕蔺，风韵渴闻韶。\n寄远缄灵药，迎归舣画桡。\n伏波新荡寇，气入岭云飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和运使张学士惠诗","author":"余靖","text":"澄清数路拥轻轩，列郡钦瞻已历年。\n谈剧乍欣倾盖日，酒深因惜落花天。\n偶回风鉴怜孤拙，能聚星文愧昔贤。\n明旦吏迎山驿去，不须容易到樽前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和胡学士馆中庭树","author":"余靖","text":"仙材封植九重深，苒苒何年别故林。\n晓色半笼青琐闼，春光长在玉山岑。\n静临高阁翻清吹，坐见羁禽息密阴。\n休羡井梧能待凤，凌霜坚守岁寒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和钱学士见谢新栽竹","author":"余靖","text":"碧池深院斸莓苔，鼓吹山前共得来。\n高节最宜和雪看，虚心莫把夹桃栽。\n肤清似玉休移石，骨瘦成龙不待雷。\n若使菁莪逢此地，也应同喜育良材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和董职方见示初到番禺诗","author":"余靖","text":"五方殊俗古难并，千载犹存古越城。\n客听潮鸡迷早夜，人瞻飓母识阴晴。\n波涛汹涌天边阔，犀象斓斑徼外生。\n太守不才当远寄，惟忧南亩废农耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和董职方见贺诞子诗","author":"余靖","text":"天幸依仁守列藩，佳篇为贶荷谦尊。\n固惭彝鼎无勋阀，且喜桑弧有子孙。\n岂比芳兰庭下秀，预知苦李道傍繁。\n日临庶狱虞阴谴，敢望高开纳驷门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和邃卿张学士暑夕","author":"余靖","text":"危坐空斋暝色低，三金才伏火将西。\n烟蒙细草流萤度，月上疏林倦鹊栖。\n荃葛野裳交羽扇，桔槔邻圃响蔬畦。\n中宵爽气夺炎热，却笑班姬谩惨悽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思寿阳寓居高氏园亭","author":"余靖","text":"尝借芳园石友家，幽栖无复羡纷华。\n敞扉气爽云生栋，卷箔香微露泫花。\n桂向淮山分月魄，桃从秦洞得仙葩。\n别来追想清闲境，悔褫方中走栈车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荔香亭","author":"余靖","text":"虚亭何所赏，为爱果中奇。\n气禀南方秀，生当火王时。\n渡淮嫌橘变，经庾笑梅衰。\n不共花争艳，残莺莫傍枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺孙抗员外春昼端居","author":"余靖","text":"万事皆从适意休，何须快马骋长楸。\n高人鼓吹鸣蛙地，当世神仙笑躄楼。\n燕到捲帘如旧分，花开逢雨最闲愁。\n僧来更学尝茶诀，白乳枪旗带露收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺运使学士分散徭人","author":"余靖","text":"狂徭数载扰湘东，多谢招降息战攻。\n千里山川还汉界，万人戈甲卷秋风。\n牛羊野放狼心伏，鹰犬閒眠兔穴空。\n不独事宁论爵赏，须知全活有阴功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送邓秘丞知德安县","author":"余靖","text":"里闬俊游心久降，越台成政俗敦庞。\n香炉山下重为县，阊阖风高还渡江。\n且喜恩威长及物，莫嫌功业未经邦。\n公斋更近渊明宅，寄傲情应卧北窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送任秘丞知长兴县","author":"余靖","text":"懿文通籍气飘飘，二十年来困下僚。\n吾道本将忠许国，世途休叹老登朝。\n囊装冷落堆青简，衙署幽深枕画桥。\n预想吴人蒙美化，海鸥桑雉共逍遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘学士知衡州","author":"余靖","text":"朱轓新命汉诸侯，地扼荆湘占上游。\n醽渌水声侵古堞，祝融峰色入晴楼。\n昼垂三组乡枌过，春拥双旌岳寺游。\n番直星垣归缓步，谪仙通籍著瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送江秀才归庐陵","author":"余靖","text":"感君千里远相过，晤语经旬接粹和。\n上客杯盘祗炊黍，主人门巷正张罗。\n海山雾暗红尘少，岭路梅黄细雨多。\n日暮津亭送归恨，唯知极目望烟波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张如京知安肃军","author":"余靖","text":"赐戟衔恩出斗城，塞门迢递草初青。\n新提司马临戎节，旧应衣乌近极星。\n叔子戍吴长缓带，单于归汉已空庭。\n圯桥自得家传策，不问人间太白经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李廷评知福清县","author":"余靖","text":"世阀茂儒绅，瓯闽宠命新。\n县图遥尽海，乡树密藏春。\n供帐莺将老，登车雉已驯。\n行闻趋召节，旧美政如神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨学士益州路转运","author":"余靖","text":"芝函新命直仙蓬，又见岷山叱驭忠。\n玉佩晓班辞日下，水牛秋粟转褒中。\n花时井邑蚕丛富，徼外人家栈道通。\n奇技刺文频诏约，此行应更变民风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送苏祠部通判洪州","author":"余靖","text":"天家顿网极详延，果见鸿风颂得贤。\n庭拜外官聊试治，史分新策入编年。\n江淹赋笔虽伤别，郭泰归舟只恐仙。\n南国勿思终计最，蓬丘番直即和铅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送岳师归赣川","author":"余靖","text":"千里起归思，翛然物外身。\n海山经处雾，梅岭到时春。\n药更开新楮，庭应长旧筠。\n年衰重方术，聊此送行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送峡州推官","author":"余靖","text":"决科雠汉策，佐郡得荆关。\n地胜诗锋锐，兵销檄笔闲。\n路岐高鸟外，城郭白云间。\n婉画应馀刃，何人荐祢还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送施屯田知太平州","author":"余靖","text":"天阁汉郎居，新荣刻兔符。\n趋曹兰在握，到境弩先驱。\n地望遥分楚，州封半入吴。\n仙科存俊望，归路约蓬壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送凌屯田知和州","author":"余靖","text":"粉署仙郎守一麾，都门别岸柳依依。\n定知春雨随车至，且喜秋风破浪归。\n仁政便当闻虎渡，治声犹在隔牛矶。\n侬今亦恳怀章请，假道尚应鲈正肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送容州杜秘丞","author":"余靖","text":"官满一舟归，高怀俗背驰。\n家藏唯翰墨，民政在声诗。\n气劲秋霜并，吟多夜月知。\n知贤无路荐，何以报明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送海琳游南海","author":"余靖","text":"触目尽尘累，如师真不群。\n圆明水中月，去住岭头云。\n意为乘风快，名应过海闻。\n翛然此高迹，世网慢纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送盖太博通判定州","author":"余靖","text":"墨诏殷勤擢俊贤，精求毗佐四方翰。\n封疆谨守卢奴塞，旌旆仍亲上将坛。\n衰草带霜秋马健，黄云遮日暮城寒。\n燕南赵北边之要，旅拒凭君一策安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送黄秘校南剑州司法","author":"余靖","text":"早年援笔气飘飘，尚屈区区补郡寮。\n苦掾去平三尺法，急贤期赴一封轺。\n舟冲柳市吟春昼，帆卷江风宿暮潮。\n及著莱衣过乡梓，循陔多羡撷兰苕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送温陵庄君崇班赴长乐都尉","author":"余靖","text":"新命升鹓序，办严辞浚都。\n去乘关吏传，归握戍兵符。\n云阔逢乡树，风和见海桴。\n南枝羡君乐，遣我忆莼鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送舒太博通判眉州","author":"余靖","text":"通守方忻再命新，东风疏雨拂行尘。\n封疆远入鱼凫国，岐路正逢蚕市春。\n彭岫晓岚迎画隼，锦江晴绿照朱轮。\n归期不待更书至，旧有清名在缙绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧惠勤归乡","author":"余靖","text":"旧国起归兴，三江一棹轻。\n夜吟逢月白，晓渡趁潮平。\n楚岸云藏寺，吴宫水绕城。\n羡师尘外去，何日濯吾缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送薛秀才归乡","author":"余靖","text":"半岁接高论，一朝归故关。\n道存惭设醴，别易忍登山。\n进即龟龙瑞，退当江海闲。\n无为牵俗趣，碌碌利名间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻栾驾部度岭见寄","author":"余靖","text":"久接贤规见准绳，还朝犹听颂声腾。\n安民虑远疆封静，富国材高帑藏增。\n野老赓歌除横敛，侍臣交表荐殊能。\n岭头若著关官籍，可察孤清节似冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭王子野待制","author":"余靖","text":"赤墀趋步近相陪，邸吏俄传远讣来。\n方冀君心辨忠义，岂知天意夺贤材。\n堪伤棣萼同时葬，空想铭旌此日回。\n谪宦无缘亲渍酒，江边长恸独徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恩守赣上谢和叔见寄次韵","author":"余靖","text":"六载心闲类死灰，岂期朝奖念粗材。\n凤衔君命从天降，鹊喜邮音度岭来。\n恩重乍惊三采绶，使专仍咏一枝梅。\n切磋甫得依贤检，疾恶刚肠愈不回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":41858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]