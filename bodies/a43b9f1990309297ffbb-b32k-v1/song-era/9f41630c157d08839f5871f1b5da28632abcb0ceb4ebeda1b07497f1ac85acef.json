[{"title":"禅人并化主写真求赞 其一三一","author":"释正觉","text":"节棱棱而老松之孤，心空空兮脩竹之癯。\n雪霜之气，丘壑之躯。\n云水之去就，丛林之典模。\n放开来底，相识也无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四十四","author":"释正觉","text":"这个仪形，丛林饭丁。\n春山有雪发衰白，秋水无风眼冷青。\n妙明田地，净洁门庭。\n万缘不倚活卓卓，一事不著空灵灵。\n把手与药兮谁寻本草，问津指源兮自得图经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一二九","author":"释正觉","text":"江湖之秋，清入双眸。\n草木之春，温生两唇。\n髑髅眉底自照眼，赤肉团上无位人。\n门门得用，薄艺随身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二八五","author":"释正觉","text":"默默无思，閒閒不羁。\n秋濯星河色，风吹月荡漪。\n二仪前是我，万像里名谁。\n似难去取，决定相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三四七","author":"释正觉","text":"其离而入，其微而出。\n一弹指响楼阁开，身现门门千百亿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四○六","author":"释正觉","text":"兀兀默耕，天成地平。\n一心无住住，万像不生生。\n起家空劫壶中句，借伴今时路上行。\n搅丛林人七八处，令行而据。\n握拄杖子四十年，师坐而横。\n用之不敝，虚而不盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二九一","author":"释正觉","text":"性空无根，性水无垠。\n应所知量，成其梦身。\n閒閒对万像，飘飘出诸尘。\n物外有此不名物，人间有此没事人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三○五","author":"释正觉","text":"本无今有，觉空幻受。\n真相俨然兮威音之前，妙触出碍兮影响之后。\n功极而转身，说禅而借口。\n把住也洞水逆流，放行也曹山颠酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一五七","author":"释正觉","text":"眼深眉长，口阔面黄。\n秋月破夜色，古涧含秋光。\n念萌自得出没像，功转不落偏正方。\n拈起能来应机用，者回触处露堂堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三十九","author":"释正觉","text":"眉下眼深，额上骨隆。\n说禅口窄，受道心空。\n闲闲无伎俩，默默有家风。\n片月濯磨秋更白，百华点染春能工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二二九","author":"释正觉","text":"无言而言，默彻其源。\n无用而用，虚含其动。\n理窟之穷通，智机之变弄。\n夕阳洲渚白鸥盟，韶昼园林蝴蝶梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一四八","author":"释正觉","text":"山寒露风棱，水瘦褪沙痕。\n劫空须到底，用妙不循根。\n宗派谁传衣钵，他家自有儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一一七","author":"释正觉","text":"本体无生，诸尘幻成。\n白发雪漫顶，青瞳秋在泓。\n妙触出碍，机用超情。\n珠走不留影，谷虚还应声。\n默默坐寒唯自照，天无四壁月三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三八二","author":"释正觉","text":"太行之雪春不消，黄河之月夜更饶。\n家风许清白，身世自超摇。\n离微器重，出没机调。\n光燄波澜俱满净，珊瑚林树涨高潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其九十一","author":"释正觉","text":"情谓之外兮言路那通，形壳之外兮模画那同。\n一方明有月，万簌啸而风。\n其应而妙，其用而冲。\n图星之拱兮周罗而北，流水之向兮曲折而东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二二八","author":"释正觉","text":"眼横鼻直，气清骨寒。\n手眼外应金篦快，身心内照玉壶宽。\n机丝交织兮春华蔟蔟，与物齐平兮梦蝶团团。\n性习林泉，身心信缘。\n长虹敛雨，照雪倚天。\n头头物物随宜说，刹刹尘尘各住禅。\n妙触出碍，幻成自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三二七","author":"释正觉","text":"垂老之姿，须发如丝。\n渊默之味，耳口无疵。\n秋高河影阔，露冷月行迟。\n答呼若谷神之应，对事得珠色之随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三七四","author":"释正觉","text":"默默灵光，堆堆坐忘。\n衲僧事业，宗印文章。\n应物空三世，随缘遍十方。\n分身不用相回互，到处谁能作覆藏。\n巍巍堂堂，炜炜煌煌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三三○","author":"释正觉","text":"法法平齐，随高就低。\n南日蜀葵向，北风胡马嘶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二八一","author":"释正觉","text":"是真非相，是相非真。\n拈转四大，不立一尘。\n体合虚空有自己，用周法界无别人。\n一叶落兮天下秋，一华开兮天下春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三五○","author":"释正觉","text":"野鹤骨癯，涧松皮粗。\n一身闲而云行林壑，两眼冷而秋入江湖。\n智到无而有，理极有而无。\n齐物蝶翻昼梦，随机蜂理华须。\n开口也著合也著，风铃发响谷随呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三三三","author":"释正觉","text":"学绝与邻，名生实宾。\n少年行脚事，老倒住山人。\n拄杖虽无二升米，虚空自有十方身。\n一机历历兮，三昧尘尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三五二","author":"释正觉","text":"妙存象先，圆成自然。\n佛灯燄续，祖华芳联。\n野况烟霞老，秋痕天水连。\n生无生性，住无住缘。\n随分雪分斋一钵，不嫌云寄屋三椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一六二","author":"释正觉","text":"默默而游，如如而说。\n鱼行涧底秋，鹤梦松头月。\n大智而愚兮，大巧而拙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三一四","author":"释正觉","text":"至微至精，无像无名。\n其传也默而成，其得也虚而盈。\n夜永斗柄转，秋高河汉横。\n人来借问正因字，鼠粪无将污我羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三一五","author":"释正觉","text":"心空自灵，性了非情。\n玉马寒泉饮，泥牛夜月耕。\n尘尘智起，物物幻成。\n二仪万像纵横说，相与今时作證明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三四六","author":"释正觉","text":"默学少林，静全本心。\n幽灵绝待，虚明自任。\n玉线金针世家事，鸾胶凤弦山水音。\n随方善应，不用相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一○四","author":"释正觉","text":"教示无辙迹，赞之绝涯岸。\n才发名言，便成形段。\n月芦混处鸣鸥，天水连时没雁。\n而今对现十成，向道只得一半。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一六六","author":"释正觉","text":"面目风霜，身心春阳。\n用杀活之手段，整宗祖之纪纲。\n秋生野水鱼潜稳，月在寒松鹤梦长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三十七","author":"释正觉","text":"身心山野，面目草灰。\n默说一句，明暗全该。\n机流电天上之火，动发阳地中之雷。\n变化穷通有许事，向道俱从恁么来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四○五","author":"释正觉","text":"本来无物，当处出生。\n白毵毵之头发，乌律律之眼睛。\n谁敢居尊宿，僧相奉老成。\n现威仪，住灭定。\n随影响，放光明。\n玳瑁海深难寻含月之蚌，珊瑚林没谁见?潮之鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三七○","author":"释正觉","text":"空劫默游，灵然破幽。\n潮扬光燄珊瑚月，海缩波澜翡翠秋。\n于世无求，随缘自由。\n百千三昧门门事，潦倒俱胝一指头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三七三","author":"释正觉","text":"天地含光，阴阳化章。\n蔬肠清白，枣齿淡黄。\n丛林閒去就，云水老行藏。\n百鍊之金柔兮绕指，九试之玉温兮截肪。\n随身干木，作戏逢场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二七三","author":"释正觉","text":"雪洗寒岩兮山林气清，秋生烟水兮江湖色明。\n犹净镜兮对诸像，似空谷兮随诸声。\n游戏因缘三昧用，自然转处不留情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三五五","author":"释正觉","text":"无心之心，妙超古今。\n无相之相，不存情量。\n叶落木而秋开，月度山而潮上。\n柳絮之风随，葵华之日向。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三七五","author":"释正觉","text":"云水老身，丛林陈人。\n发毛已雪，鼻气犹春。\n平等应缘也心心佛佛，自然说法也刹刹尘尘。\n回途复妙，弄假像真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三四一","author":"释正觉","text":"说通齿豁，宗通句活。\n师座心空，劫壶步阔。\n就位了无机，烂柯曾有著。\n招手相随恁么来，百草头边活卓卓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三一○","author":"释正觉","text":"老抱孤踪，岁寒之松。\n静含远韵，霜晓之钟。\n黄氏之羊起石，陶家之梭化龙。\n刹刹尘尘见身相，门门何处不相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其六十","author":"释正觉","text":"面孔何如，雪发霜须。\n秋明月窟，春发冰壶。\n妙尽还移步，功忘聊放锄。\n拈来随处成宗要，向道斯人德不孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三九二","author":"释正觉","text":"默默亡言，灵灵见根。\n鼓挝涂毒，香烧返魂。\n物物无心影受镜，尘尘出碍声踰垣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一二六","author":"释正觉","text":"孤节老全，丛林岁寒。\n机用千变，时事百难。\n玉经火而愈润，莲秀水而常乾。\n牛头之懒口挂壁，麈尾之辩舌翻澜。\n触事出碍兮虚空挥剑，众影不黏兮明珠走盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三九四","author":"释正觉","text":"发白齿豁，鼻垂口阔。\n坐冷月依依，气清秋漠漠。\n离微出入门开，正偏往来机活。\n双碧耆婆眼有神，分明百草头边药。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其十七","author":"释正觉","text":"老发衰髭，顶雪颔丝。\n方头似凿，钝口如椎。\n相逢閒受用，惯吃落便宜。\n蒲鞋价贱陈尊宿，浆水钱还王老师。\n法不当情兮平等得定慧之学，心无所住兮自然见离微之时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其八十五","author":"释正觉","text":"默默家风，如如规矩。\n妙不可以言传，真不可以相取。\n明白月壶，廓清天宇。\n物我情忘兮谁分尔汝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二六二","author":"释正觉","text":"非思量处，无住而住。\n离名象时，不为而为。\n香象定中渡，寒蟾照复移。\n世间了了虚空相，人事丛丛混沌眉。\n饱参底句如何举，饭罢摩挲篾肚皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三○九","author":"释正觉","text":"瘦骨岩岩，残毳毵毵。\n坐寒云巘，心空月潭。\n虚应亡机而若谷，深禅有口而如钳。\n槃珠勿遗其色，囊锥不露其尖。\n皇道大平没棱角，自然雨五而风三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一四三","author":"释正觉","text":"性不疏通，机不捷敏。\n颓慵陋见闻，急快失容忍。\n一默清秋兮芙蓉华开，万态浩春兮葛藤蔓引。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三九七","author":"释正觉","text":"妙了常存，幽灵不昏。\n偏正旋枢臼，离微见道根。\n微尘破处大经出，冷口开时诸佛吞。\n随缘历历，得用门门。\n成褫家事，分付儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三五八","author":"释正觉","text":"南台之静，中邑之应。\n圆明之知，平等之性。\n烂柯棋局樵，钓雪华亭艇。\n披丛林明白之襟，握云水清凉之柄。\n动自风流，閒宜月定。\n心闻况是赏音，相廗何妨打令。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一一○","author":"释正觉","text":"貌古而孤，气清而癯。\n秋生林壑，月在江湖。\n见道之体盈而虚，随世之用有而无。\n佛佛祖祖，只个规模。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三四○","author":"释正觉","text":"烟苍苍兮白鸟飞，水茫茫兮金鳞嬉。\n空杳杳兮智不知，觉冥冥兮性所宜。\n包万像而括二仪，彻三际而周四维。\n影象累累，品类差差。\n发挥元自我，点化更由谁。\n方之则矩，圆之则规。\n不须特地，且么过时。\n兀兀腾腾，憨憨痴痴，跛跛挈挈而萎萎羸羸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其五十一","author":"释正觉","text":"依样画胡卢，相逢识也无。\n蹉过了丰城埋剑，觑得破合浦还珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三七八","author":"释正觉","text":"曲木坐床，乌藤倚旁。\n孤禅一句，三世十方。\n青灯含华夜耿耿，白鸟欲没天苍苍。\n却来有应，出碍无当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一一二","author":"释正觉","text":"寒林气清，晚浦潮平。\n自由之像，相随而名。\n孤藤拳脱略，三篾肚膨亨。\n闹市谁嫌机用熟，丛林人道饱参生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10676,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三七七","author":"释正觉","text":"形虽老苍，事不穷忙。\n味真嚼蜡，面冷刮霜。\n撒手行空劫，全身入帝乡。\n回头游戏成三昧，春上百华蜂采香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二一三","author":"释正觉","text":"额颅高，眼孔深。\n画工不识，谁是知音。\n江湖烂烂兮月还有魄，丘壑闲闲兮云自无心。\n几处相逢不会唤，蓑衣箬笠卖黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二三八","author":"释正觉","text":"劫外游神，环中契真。\n幽灵自照，绝学为邻。\n碧琉璃海半夜月，赤珊瑚树长年春。\n专柔一气，和光同尘。\n心心不触衲僧事，物物无私国土身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其四十三","author":"释正觉","text":"鼻筒直，眼眶深。\n默时自觉失却口，妙处谁会相传心。\n便与么，只如今，影中辨取兮户挂凋林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一一一","author":"释正觉","text":"静而纯，湛而存。\n海日珊瑚树，岩松琥珀根。\n家风传父祖，事业付儿孙。\n回途妙触了机用，个是百千三昧门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一九六","author":"释正觉","text":"智极而藏，静极而光。\n蕉雷之展，葵日之芳。\n占宝器而蛮眼碧，理华须而蜂股黄。\n中规中矩兮乍圆乍方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二九四","author":"释正觉","text":"皮苍老松，色暗焦桐。\n微尘尘破，一印印空。\n大千经卷钟出碍，三世佛口谷吞风。\n六门了用，双眉有功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其八十八","author":"释正觉","text":"山之寒兮带雪，水之清兮含月。\n默而灵兮卓卓妙存，静而应兮尘尘光发，彻见离微兮任出任没。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其二三三","author":"释正觉","text":"性得渊源，穷通自然。\n潭寒龙蜕骨，松老鹤成仙。\n无心白云出岫，有应明月浮川。\n相逢借伴人间世，游戏尘尘三昧缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其一七八","author":"释正觉","text":"阿侬家风，至穷而通。\n豹变文而雾重，龙退骨而潭空。\n指南画北，说西道东。\n点头摇手，佯狂诈聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人并化主写真求赞 其三十一","author":"释正觉","text":"山寒带雪痕，春信入华根。\n造化岂无柄，区分自有门。\n出出没没也，俱承此恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]