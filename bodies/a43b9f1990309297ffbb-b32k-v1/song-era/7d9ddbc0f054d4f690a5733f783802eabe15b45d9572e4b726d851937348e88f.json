[{"title":"夏日十二首 其一","author":"陆游","text":"暑雨初晴昼漏迟，江乡乐事有谁知。\n村村垄麦登场后，户户吴蚕坼簇时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日十二首 其十","author":"陆游","text":"侧卧横眠百不知，轩窗寂寂雨丝丝。\n岂无布袜青鞋兴，过却梅天出未迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日十二首 其九","author":"陆游","text":"蘋生洲渚微风起，梅熟园林细雨来。\n咫尺柴门常懒出，不教拄杖损苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日十二首 其五","author":"陆游","text":"闷欲远游身苦懒，病思闲话客谁过。\n北窗一枕差堪乐，无奈茶杯作祟何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日十二首 其八","author":"陆游","text":"谢客捐书日日闲，行穿密竹卧看山。\n岩前恨欠煎茶地，安得茆茨一小间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日十二首 其三","author":"陆游","text":"竹根断作眠云枕，木瘿刳成贮酒尊。\n怪怪奇奇非著意，自无俗物到山村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日十二首 其二","author":"陆游","text":"齿发凋零奈尔何，年光暗里易消磨。\n街槐正喜清阴密，巷柳还惊蠹叶多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日四首 其三","author":"陆游","text":"平明一浴汗无馀，坐觉胸中合太虚。\n舂玉作糜天所赐，不妨数箸进山蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日四首 其一","author":"陆游","text":"飕飕风露发根凉，月落菱歌尽意长。\n分得镜湖才一曲，吃亏堪笑贺知章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"负日戏作","author":"陆游","text":"困来两眦似胶黏，底怪吴人号黑甜。\n安得他生不识字，朝朝就日卧茅檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日杂题六首 其三","author":"陆游","text":"新缝细葛作蚊裯，簟展风漪凛欲秋。\n啼鸟一声呼梦断，依然书卷在床头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日杂题六首 其二","author":"陆游","text":"午梦初回理旧琴，竹炉重炷海南沉。\n茅檐三日萧萧雨，又展芭蕉数尺阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日杂题八首 其三","author":"陆游","text":"情怀万里长征客，身世连床旦过僧。\n熟计书空成咄咄，不如任运去腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日杂题六首 其一","author":"陆游","text":"东吴五月黄梅雨，南浦孤舟白发翁。\n貂插朝冠金络马，多年不入梦魂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日杂题六首 其五","author":"陆游","text":"渚蒲经雨送微馨，野鹤凌风有堕翎。\n归入衡门天薄暮，清沟浅浸两三星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日杂题八首 其六","author":"陆游","text":"身闲欲出无如懒，酒薄虽倾不敌愁。\n残暑从今无一月，剩储诗思待新秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日杂题八首 其七","author":"陆游","text":"憔悴衡门一秃翁，回头无事不成空。\n可怜万里平戎志，尽付萧萧暮雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日杂题八首 其五","author":"陆游","text":"天随手不去朱黄，辟蠹芸编细细香。\n今夕短檠须暂设，北窗风雨送微凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日杂题八首 其一","author":"陆游","text":"疏疏窗似秋蛩室，叠叠书如春鹊巢。\n大耋何妨尚弦诵，小诗时亦杂谈嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日杂题八首 其二","author":"陆游","text":"耽耽丑石罴当道，矫矫长松龙上天。\n满地凌霄花不扫，我来六月听鸣蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日杂题六首 其四","author":"陆游","text":"檐前桐影偏宜夏，叶底蝉声渐报秋。\n莫道衰翁怯风露，也能觅醉水边楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日杂题八首 其四","author":"陆游","text":"一枝黎峒桄榔杖，二寸羊城蝳蝐冠。\n万里来为老人寿，始知天地不胜宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏初湖村杂题八首 其六","author":"陆游","text":"从来抵死爱湖山，敢料天教半世闲。\n杜曲桑麻虽苦薄，灞桥风雪如相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏初湖村杂题八首 其一","author":"陆游","text":"市远村深客到稀，草堂终日掩柴扉。\n酿成新蜜蜂儿静，分尽残泥燕子归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏初湖村杂题八首 其五","author":"陆游","text":"胎发茸茸漆不如，夏初安健胜春初。\n双瞳懒看公卿面，却解灯前读细书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏初湖村杂题八首 其二","author":"陆游","text":"嫩日轻风夏未深，曲廊倚杖得闲吟。\n地偏草茂无人迹，一对茭鸡下绿阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏初湖村杂题八首 其七","author":"陆游","text":"幽禽两两已成巢，新竹森森渐放梢。\n稻垄作陂先蓄水，野堂防漏却添茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏初湖村杂题八首 其四","author":"陆游","text":"日落溪南生暮烟，幅巾萧散立桥边。\n听残赛庙鼕鼕鼓，数尽归村只只船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏初湖村杂题八首 其三","author":"陆游","text":"寒泉自换菖蒲水，活火闲煎橄榄茶。\n自是闲人足闲趣，本无心学野僧家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏初湖村杂题八首 其八","author":"陆游","text":"门巷萧条长绿苔，经旬清坐罢传杯。\n曲生风味那忘得，少待吾家芍药开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜枕上","author":"陆游","text":"卧听残更下丽谯，虽非遥夜亦迢迢。\n正令展转无安枕，犹胜龙钟趋早朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜暑毒不少解起坐庭中二首 其二","author":"陆游","text":"风从高树下，虫抱短莎鸣。\n小据胡床坐，还扶拄杖行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜暑毒不少解起坐庭中二首 其一","author":"陆游","text":"窗间有萤过，枕上见星流。\n欲睡不堪热，长歌起饭牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙丑夏秋之交小舟早夜往来湖中戏成绝句十二首 其六","author":"陆游","text":"城南天镜三百里，缭以重重翡翠屏。\n最好长桥明月夜，寄船策蹇上兰亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙丑夏秋之交小舟早夜往来湖中戏成绝句十二首 其九","author":"陆游","text":"恰听残蝉禹寺门，又看新月石帆村。\n后来复有龟堂老，千载犹应此意存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙丑夏秋之交小舟早夜往来湖中戏成绝句十二首 其二","author":"陆游","text":"河汉横斜斗柄低，啼鸦掠水未成栖。\n怪生凄爽侵肌骨，船系秦皇酒瓮西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙丑夏秋之交小舟早夜往来湖中戏成绝句十二首 其五","author":"陆游","text":"鸡头累累如大珠，红草绿荷风味殊。\n天与杨梅成二绝，吾乡独有异乡无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙丑夏秋之交小舟早夜往来湖中戏成绝句十二首 其十一","author":"陆游","text":"秋来湖阔渺无津，旋结渔舟作四邻。\n满眼是诗渠不领，可怜虚作水云身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙丑夏秋之交小舟早夜往来湖中戏成绝句十二首 其十","author":"陆游","text":"娥江道上欲三更，垣屋参差闭月明。\n倚柁赋诗无杰思，断肠分付棹歌声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙丑夏秋之交小舟早夜往来湖中戏成绝句十二首 其三","author":"陆游","text":"谯门鼓角寺楼钟，一一风传到短篷。\n唤得放翁残酒醒，锦囊诗草不教空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙丑夏秋之交小舟早夜往来湖中戏成绝句十二首 其一","author":"陆游","text":"横林渺渺夜生烟，野水茫茫远拍天。\n菱唱一声惊梦断，始知身在钓鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙丑夏秋之交小舟早夜往来湖中戏成绝句十二首 其十二","author":"陆游","text":"梦笔桥东夜系船，残灯耿耿不成眠。\n千年未息灵胥怒，卷地潮声到枕边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙丑夏秋之交小舟早夜往来湖中戏成绝句十二首 其八","author":"陆游","text":"七月湖中风露新，临流闲照白纶巾。\n荷花折尽浑闲事，老却莼丝最恼人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乙丑夏秋之交小舟早夜往来湖中戏成绝句十二首 其七","author":"陆游","text":"酒旆摇摇出竹篱，扁舟远赴野人期。\n一天风雨晚来恶，落尽白莲浑不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴坐","author":"陆游","text":"鼓乐弦歌万二千，天魔剩欲破幽禅。\n道人袖手心如水，一点纱灯夜悄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家山","author":"陆游","text":"鹿食苹时犹命侣，鹤冲霄后尚思归。\n家山不忍何山隐，稽首虚空忏昨非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恩赐龟紫二首 其二","author":"陆游","text":"已挂朝衣神武门，暂纡紫绶拜君恩。\n儿孙贺罢还无事，雨笠烟蓑自灌园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"捣药鸟","author":"陆游","text":"白发无情日日生，散愁聊复作山行。\n幽禽似欲嘲衰病，故学禅房杵药声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斋中杂题四首 其四","author":"陆游","text":"幽居厌见凡花草，红紫纷纷不复栽。\n自斸苍苔换黄土，南山移得玉芝来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斋中杂题四首 其二","author":"陆游","text":"小醉微吟过一春，人间侬是最闲人。\n龟毛拂子长三尺，拈起风光处处新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斋中杂题四首 其一","author":"陆游","text":"列屋蛾眉不足誇，可斋别自是生涯。\n闲将西蜀团窠锦，自背南唐落墨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斋中杂题四首 其三","author":"陆游","text":"棐几砚涵鸲鹆眼，古奁香斮鹧鸪斑。\n绝知造物殷勤意，成就衰翁到死闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斋中闻急雨","author":"陆游","text":"一味疏慵养不才，饭蔬亦已罢衔杯。\n衡茆终日人声绝，卧听芭蕉报雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓枕","author":"陆游","text":"晓枕莺声带梦听，忽看淡日满窗棂。\n闲愁谁遣浓如酒，醉过残春不解酲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓雨二首 其二","author":"陆游","text":"东风吹雨送残春，冉冉年光次第新。\n君看枝头如许绿，争教桃李不成尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓雨二首 其一","author":"陆游","text":"平明小雨压香尘，绕舍扶疏绿渐匀。\n睡过花时慵著句，老来春事不关身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓雨初霁","author":"陆游","text":"晓来一雨洗尘痕，浓绿阴阴可一园。\n燕子声中寂无事，独穿苔径出篱门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓起折梅","author":"陆游","text":"织女斜河漏已残，长庚配月夜将阑。\n小桥幽径无人见，折得梅花伴晓寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓雪二首 其二","author":"陆游","text":"观雪剡溪天下胜，题诗常恨不能奇。\n未应便许凝之语，此兴何曾有尽时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓雪二首 其一","author":"陆游","text":"绕湖谁琢玉为屏，换却南堂万叠青。\n老子醉狂还自笑，持竿画字满中庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海上作","author":"陆游","text":"厌逐纷纷儿女曹，挂帆江海寄吾豪。\n鲸吞鼍作浑闲事，要看秋涛天际高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海山","author":"陆游","text":"补落迦山访旧游，庵摩勒果隘中州。\n秋涛无际明人眼，更作津亭半日留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠二首 其二","author":"陆游","text":"蜀地名花擅古今，一枝气可压千林。\n讥弹更到无香处，常恨人言太刻深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠二首 其一","author":"陆游","text":"十里迢迢望碧鸡，一城晴雨不曾齐。\n今朝未得平安报，便恐飞红已作泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涉溪","author":"陆游","text":"挥汗欲成雨，聚蚊真若雷。\n山翁在何许，赤脚步溪来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涧松","author":"陆游","text":"药出山来为小草，楸成树后困长藤。\n涧松郁郁何劳叹，却是人间奈废兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烟波即事十首 其九","author":"陆游","text":"归老何须乞镜湖，秋来日日饱莼鲈。\n正令霖雨称贤佐，未及烟波号钓徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烟波即事十首 其七","author":"陆游","text":"浪迹人间数十年，年年散发醉江天。\n岳阳楼上留三日，聊与潇湘结后缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烟波即事十首 其十","author":"陆游","text":"父子团栾到死时，渔家可乐更何疑。\n高文大策人皆有，且听烟波十绝诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烟波即事十首 其四","author":"陆游","text":"落雁沙边艇子斜，分明清梦上三巴。\n眼明一点炊烟起，不是渔家即酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烟波即事十首 其二","author":"陆游","text":"烟波深处卧孤篷，宿酒醒时闻断鸿。\n最是平生会心事，芦花千顷月明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烟波即事十首 其三","author":"陆游","text":"家浮野艇无常处，身是闲人不属官。\n但有浊醪吾事足，浮名不作一钱看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烟波即事十首 其八","author":"陆游","text":"烟水苍茫绝四邻，幽栖无地著纤尘。\n萧条鸡犬枫林下，似是无怀太古民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烟波即事十首 其六","author":"陆游","text":"梦笔桥边听午钟，无穷烟水似吴松。\n前年送客曾来此，惟有山僧认得侬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烟波即事十首 其一","author":"陆游","text":"短发垂肩不裹巾，世人谁识此翁真。\n阻风江浦诗成束，卖药山城醉过春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烟波即事十首 其五","author":"陆游","text":"雕胡炊饭芰荷衣，水退浮萍尚半扉。\n莫为风波羡平地，人间处处是危机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留樊亭三日王觉民检详日携酒来饮海棠下比去花亦衰矣二首 其二","author":"陆游","text":"石卫尉家锦步障，移在樊家园馆中。\n醉到花残呼马去，聊将侠气压春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留樊亭三日王觉民检详日携酒来饮海棠下比去花亦衰矣二首 其一","author":"陆游","text":"留落犹能领物华，名园又作醉生涯。\n何妨海内功名士，共赏人间富贵花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":5865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]