[{"title":"邑宰惠花木","author":"胡宿","text":"晓圃分花品，烟锄手自携。\n未贪桃结实，且映李成蹊。\n瞥见香蜂集，仍闻好鸟啼。\n河阳春色晚，流过短墙西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行次淮上寄何毖秀才","author":"胡宿","text":"南浦伤离数，西州作恶频。\n吟亭蝉送柳，宿枕鸟惊晨。\n邺会疏沈李，吴怀豫忆莼。\n此心何用慰，前有杏园春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦淮","author":"胡宿","text":"厌胜逾千载，祖龙安在哉。\n寒潮平复落，幽鸟去还来。\n龙凿功全异，牛山事可哀。\n不知终古恨，谁见劫成灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重阳日东园","author":"胡宿","text":"沆瀣催时律，幽阴结夕霏。\n楼台侵日上，山水送秋归。\n海燕辞巢尽，霜鸿避弋飞。\n一杯元亮酒，聊以浣尘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿白佛寺","author":"胡宿","text":"下马憩禅关，春苔一径斑。\n归云寻谷口，倦鸟泊林间。\n山客收棋罢，龛僧数息閒。\n月高人不寐，隔岭水潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甘露寺","author":"胡宿","text":"宝势穷吴地，寒流对楚邦。\n一峰惊佛刹，万象入僧窗。\n落日衔遥树，晴虹画半江。\n海门秋色近，翠朵自成双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自咏 其一","author":"胡宿","text":"索米年来甚，伶俜祇自知。\n黑貂随日敝，葆发豫秋衰。\n旧产思重理，先贤耻逆施。\n吕虔刀未解，骨法谩多奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"华阳逋客","author":"胡宿","text":"小隐华阳客，山中不记年。\n酒中长有圣，棋下更无仙。\n授得广陵散，注成秋水篇。\n吾缨今未濯，惭愧旧林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瓦官寺","author":"胡宿","text":"紫色尝开国，金辉此界绳。\n火轮经坏劫，雪顶见残僧。\n狂薜缘秋壁，深松映晚灯。\n哀猿不可听，一一在岩藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题刘奉礼书斋","author":"胡宿","text":"人尚西斋学，家承北第荣。\n锦囊添句重，蟾滴试毫轻。\n底法成新构，开书泣旧楹。\n丹山消息断，喜见凤雏声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吉老学士召赴崇政殿试举人","author":"胡宿","text":"需宴经芳巳，严趋奉禁宸。\n子亭参覆试，止辇奉周询。\n玉取三烧粹，金求百汰真。\n自惭诸老意，多赖洛阳人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明日谢人送酒","author":"胡宿","text":"寂寞扬雄宅，鸱夷载酒来。\n钻榆试春火，切桂暖晨杯。\n芳蕊何须菊，香梢尚有梅。\n自惭非叔夜，聊学玉山颓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"齐国大长公主挽词","author":"胡宿","text":"旧筑王姬馆，新开贵主阡。\n山林经驻跸，烟雾隔飞軿。\n天属尊惟孝，邦风穆以贤。\n鸾龙摛翰藻，昭德万斯年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太尉文肃郑公挽词三首 其一","author":"胡宿","text":"西北谋元帅，东南出隽儒。\n上前曾借箸，阃外复投壶。\n见器同安国，忧边得亚夫。\n如何溯黄壤，不及播洪炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太尉文肃郑公挽词三首 其二","author":"胡宿","text":"公业关东望，夷吾天下才。\n辞锋横剑戟，诗笔走风雷。\n帅节行边去，氐酋献地来。\n荣华一朝尽，埋玉使人哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太尉文肃郑公挽词三首 其三","author":"胡宿","text":"将钺徽联重，公槐贲典加。\n哀荣班襚衮，亏痛轸投瓜。\n朝露沾崇旆，秋风咽迥笳。\n英灵不可问，宰树有栖鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太尉侍中郑国宋公挽词三首 其一","author":"胡宿","text":"第一平津策，同时入洛名。\n配台升上相，宰汉得元精。\n国念灵龟丧，人嗟厚栋倾。\n睿篇伤俊老，殊礼极哀荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太尉侍中郑国宋公挽词三首 其二","author":"胡宿","text":"盛业元根古，高文早变风。\n堕鳣遗馆在，浴凤旧池空。\n卓马辞丹陛，骑箕向碧穹。\n琴竽三月罢，郑国怆贤公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太尉侍中郑国宋公挽词三首 其三","author":"胡宿","text":"天上三台坼，人间一鉴亡。\n宁神韩土内，结冢騩山傍。\n槐鼎廞仪物，貂蝉襚密章。\n高贤同委化，兹理昧苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"座主赠司徒侍中宣献公挽词五首 其一","author":"胡宿","text":"天下中庸德，人伦正始风。\n立朝周鼎重，当代禹门崇。\n注意深黄阁，收神杳碧崧。\n苍生终古恨，尺璧在丘中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"座主赠司徒侍中宣献公挽词五首 其二","author":"胡宿","text":"三陟赞枢钧，歼良昧上旻。\n几传分相史，终未立家臣。\n卫武徒虚语，巫咸不可询。\n空馀山甫德，流咏在烝民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"座主赠司徒侍中宣献公挽词五首 其三","author":"胡宿","text":"门盛三鳣讲，书追两马修。\n朝评尊月旦，王法正春秋。\n革履声长绝，缁衣咏独留。\n从今非大醉，不复过西州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"座主赠司徒侍中宣献公挽词五首 其四","author":"胡宿","text":"凤德衰何早，蛇年谶有开。\n敛衣班上衮，悯册贲中台。\n缘鹄空存饰，骑箕不下来。\n栋隆今已折，侨压可胜哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"座主赠司徒侍中宣献公挽词五首 其五","author":"胡宿","text":"卤簿指西州，都人助绋讴。\n白鸡亡谢傅，黄石葬留侯。\n雾薄旌铭惨，风长骑吹愁。\n神华何处所，流恨满山丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"礼部蒋侍郎挽词五首 其一","author":"胡宿","text":"大雅时之老，高阳世有才。\n英名知四海，公议许三台。\n华皓辞归去，苍黔望起来。\n一朝嵩构毁，悯册感馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"礼部蒋侍郎挽词五首 其二","author":"胡宿","text":"香案经为吏，甘泉预侍晨。\n衣冠亲雉尾，章疏动龙鳞。\n当世高人物，诸公满搢绅。\n忽闻捐几杖，万恨只酸辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"礼部蒋侍郎挽词五首 其三","author":"胡宿","text":"颍水重临久，桐乡见爱深。\n岘碑偏堕泪，郑瑟尽停音。\n蜀士知邹学，吴儿喜洛吟。\n生前祠影在，寒雾碧山岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"礼部蒋侍郎挽词五首 其四","author":"胡宿","text":"尺璧丘中恨，人间第一流。\n九原迷白日，万壑怨清秋。\n风月高情尽，烟霞丽思休。\n故时芝馆在，迢递使人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"礼部蒋侍郎挽词五首 其五","author":"胡宿","text":"茂苑来书迹，蓝桥别泪痕。\n如何一交臂，不觉九招魂。\n东里嗟遗爱，西州哭旧恩。\n二孤犹在丱，未免怼乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翰林南阳叶公挽词三首 其一","author":"胡宿","text":"方丈仙山地，承明帝所人。\n辞源长万里，笔力重千钧。\n草诏风雷暮，赓歌律吕春。\n如何岩雨望，奄忽弃生民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翰林南阳叶公挽词三首 其二","author":"胡宿","text":"献替依明主，周旋奉至公。\n直寻无枉道，方寸有孤忠。\n耻在瓶罍罄，嗟深杼轴空。\n苍生犹未泰，夫子已先穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"翰林南阳叶公挽词三首 其三","author":"胡宿","text":"远策思开济，孤飞易中伤。\n中途舍骐骥，少日铩鸾凰。\n干镆仍双折，皋夔遂两亡。\n吾生知已矣，魂断武丘傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题饮光亭","author":"胡宿","text":"居易能藏气，探幽复治亭。\n泉华聊自挹，涧响与谁听。\n圆桧行依盖，前峰坐对屏。\n一瓢吾道在，凉月此忘形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月十五夜北楼望太湖","author":"胡宿","text":"云影消空阔，霜华拂杳冥。\n秋光不隐雁，夜色欲迷萤。\n爽气横苍卞，凉波接洞庭。\n水仙当此夕，应化白龙形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登润州城","author":"胡宿","text":"城壁起山根，楼梯易黯魂。\n雄风摇碧浸，画角吊黄昏。\n一带分江纪，双峰点海门。\n东方瞻宰树，秋色暝前村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀宣城会胜院二首 其一","author":"胡宿","text":"净刹枕城隅，溪光清且虚。\n僧閒对驯鸽，客至数游鱼。\n岩气浮川上，林香生雨馀。\n南云虽可望，长与沃洲疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀宣城会胜院二首 其二","author":"胡宿","text":"城外寻僧远，居常信马蹄。\n移时取香饭，半日濯灵溪。\n白马迎人下，清猿对客啼。\n亭前有封殖，试为问红梨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲春三衢道中","author":"胡宿","text":"隔闰年芳早，天风泛暖晖。\n酒香迎社重，村语向蚕稀。\n林际新莺出，楹间故燕归。\n湖头春在否，人去柳花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠少室王山人","author":"胡宿","text":"九籥秘仙经，岩岩玉骨灵。\n内书天上见，仙乐帝前听。\n壶小藏仙界，槎高拂斗星。\n华阳陪夜话，多是说金庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送钱比部守盛山","author":"胡宿","text":"家世楹书在，山河庙券存。\n乌衣出才子，朱毂滞王孙。\n过峡朝云举，辞梁腊霰翻。\n遥知巴子国，爱日有馀温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻莺","author":"胡宿","text":"双翎何睍睆，百啭更绵蛮。\n独向芳林宿，多冲细雨还。\n低迷穿柳外，调笑入花间。\n肯比青鹦鹉，雕笼受闭关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送显忠上人归吴郡","author":"胡宿","text":"秋风随处起，振锡不留行。\n却背嵩云去，迎看淮月生。\n禅通少林默，诗得杼山清。\n几夕岩窗下，忘眠听瀑声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芳茂山","author":"胡宿","text":"此地横青嶂，当年耸紫氛。\n碧花岩下柰，玉叶岭边云。\n宝势三神秀，灵风百草薰。\n将军精爽在，可解勒移文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浮石寺","author":"胡宿","text":"溪碧照浮航，仁祠紫界墙。\n窗扉衔远色，树石纳馀凉。\n升讲林花落，抛生水鸟翔。\n逢僧谈止观，数刻尽牛香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张著作任柘城","author":"胡宿","text":"出宰分寰邑，修书得秘丘。\n青云莫厌晚，翠柏最宜秋。\n旧学缁林散，前欢醉墨留。\n弦歌聊自慰，不足论全牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送曹生归临江别墅","author":"胡宿","text":"气入商中劲，人思渎上劳。\n沧江萦故国，凉月伴归舠。\n丽赋凭乌有，清篇托畔牢。\n竹林温绪业，天彀伫时髦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄善慧大师禅斋","author":"胡宿","text":"金策巡方罢，斋轩俯斗城。\n池閒鱼听法，台静鸟窥生。\n社影香蕖白，禅阴碧柰清。\n昆灰多妙辨，平日集朝缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小阁","author":"胡宿","text":"小阁闭春风，疏帘隔几重。\n柳绵收未住，酒病太无悰。\n带眼偏知瘦，棋图最信慵。\n隆中一觉睡，日影过高舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼往","author":"胡宿","text":"昨夜西楼月，团圆似去年。\n凤屏非复旧，虎枕未成眠。\n破恨凭湘酎，流哀寄蜀弦。\n葛华与参宿，此见恐无缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江楼","author":"胡宿","text":"亭亭紫桂楼，渺渺白蘋洲。\n易断伤春目，难销假日忧。\n双凫仙子贵，两桨美人愁。\n欲寄青泥讯，云峰隔旧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初赴扬子任","author":"胡宿","text":"补吏承人乏，安贫得士常。\n半纶朝受命，数舍宿舂粮。\n楚地元三户，驺奴亦一囊。\n空裁宣德颂，何路奏明光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐偃王庙","author":"胡宿","text":"天下慢朝周，君王瑶水流。\n一朝规问鼎，千里御还骝。\n故国无归日，丛祠几换秋。\n诜诜耳孙庆，惟烈在仁柔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清溪泛舟","author":"胡宿","text":"家在清溪上，乘閒一棹歌。\n夕凉天有月，秋迥水无波。\n鸥鸟机心断，鲮鱼香味多。\n吾缨犹未濯，终是负渔蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一年好景","author":"胡宿","text":"樽俎真无奈，风骚亦被魔。\n酒龙春力健，诗将夜谋多。\n未羡封侯印，偏怜却日戈。\n寄言嵇叔夜，休惜玉嵯峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早雁","author":"胡宿","text":"关树来时紫，江枫到日丹。\n惊弦初月上，避弋太虚宽。\n野水涵秋色，霜云结夜寒。\n终年南北路，未可笑离鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄怀尊师","author":"胡宿","text":"多年疏法集，长夏忆斋房。\n桐雨生苔净，杉风坐石凉。\n真茶烹涧溜，满饭取天香。\n何日挥冠冕，相期作道场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"华阳道士朱尊师","author":"胡宿","text":"阆苑花边醉，知君是谪仙。\n姓名金简上，官职玉台前。\n碧海三奇药，青梯尺五天。\n祇愁腾踏去，相望隔芝田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"紫蔷薇","author":"胡宿","text":"天上星垣贵，人间花品高。\n偷模烦象管，学剪费金刀。\n西母停云辇，东卿驻节旄。\n晓轩无限思，香架近蒲桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又陪公素舍人晨入西阁见紫薇初开","author":"胡宿","text":"疏雨休前槛，新英艳小丛。\n且欣当夏日，不用忆春风。\n便可携欢伯，相从作醉翁。\n回头问阶药，何处觅蔫红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题撷芳亭","author":"胡宿","text":"有客隐东冈，珍亭号撷芳。\n仙壶分气象，木帝借风光。\n渌水穿林远，朱桥跨岸长。\n宝邻曾折桂，今是状元坊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初秋","author":"胡宿","text":"九夏困烦冤，逢秋似得仙。\n短床便月下，长簟怯风前。\n露气清群木，云棱澹一天。\n西江无限水，长啸忆楼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大庆殿元会","author":"胡宿","text":"殿里炉香散彩云，殿前旌仗从朝暾。\n后夔六乐调时律，太皞千春入御樽。\n神化还随苍震始，天颜却映少阳温。\n新年喜气知多少，郁郁葱葱覆九门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"燕洞宫","author":"胡宿","text":"洞里青娥赤玉箫，香童迎过百花桥。\n身轻不待泠风驭，天隔难逢翠羽翘。\n仙醴四升谁酩酊，使乌三足自飘飖。\n座中若话金庭事，记取真人是子乔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张侍读笺注太玄经义","author":"胡宿","text":"陈书覆瓿久无憀，天幸名儒释旧爻。\n准易一时遭客难，赏心千载获神交。\n高情要在崇孤学，馀力犹能解众嘲。\n谁道凤凰难得髓，续弦今日见灵胶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赏花钓鱼应制","author":"胡宿","text":"球槛灵芳濯露开，瑶津朱鲔复新来。\n三竿御水承垂钓，万蕊晨葩奉赐杯。\n春暖仙蓂初靃靡，日斜芝盖尚徘徊。\n柏梁圣作星躔丽，累气芜音愧仰陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏蝉","author":"胡宿","text":"柳条高处不须吟，正是螳螂负异心。\n已断清肠悲玉露，更流哀响入瑶琴。\n长洲苑下风声急，宣曲宫中暮色深。\n莫道齐姬无伴侣，海边精卫亦冤禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登雄州视远亭","author":"胡宿","text":"谁将粉水扫天衢，万里全开晦景图。\n百尺冻云飞未起，一筝寒雁远相呼。\n由来封略非三代，大抵渔樵似五湖。\n欲望繁台何处是，繁台不见见平芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送钱子文著作宰福阳","author":"胡宿","text":"三政平反有惠心，民歌遥望邑中黔。\n桃翻浪影吴艎急，芸掩书香汉阁深。\n行访名山须著屐，坐清嚣俗且横琴。\n西州有客偏伤别，无密瑶华寄好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题承诏亭","author":"胡宿","text":"开径临江有旧居，野亭于此狎禽鱼。\n八才素擅高阳里，五返曾迂使者车。\n圯上早传黄石略，隆中难恋武侯庐。\n主人今醉葡萄酒，篱下秋风菊自疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]