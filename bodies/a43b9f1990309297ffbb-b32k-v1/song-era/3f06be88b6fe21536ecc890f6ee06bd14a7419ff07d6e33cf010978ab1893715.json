[{"title":"凌翠阁 其二","author":"韦骧","text":"凌翠阁，突兀撑寥廓。\n满眼苍烟万里春，忍负十分金凿落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凌翠阁 其三","author":"韦骧","text":"凌翠阁，四面祛棂箔。\n千里无云看月明，何必庾家楼上乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凌翠阁 其四","author":"韦骧","text":"凌翠阁，山绕如城郭。\n风味都侔陶令居，所惭犹被青纶缚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"木芙蓉词","author":"韦骧","text":"木芙蓉，墙头浅浅红。\n秋林枝叶十九空，独此蓶扈当秋风。\n秋风无意开俗眼，俗眼不开须在侬。\n接䍦斜攲勿嫌重，满篸何恤惊儿童。\n岂必黄金菊，难辜白玉钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"国哀","author":"韦骧","text":"天地有大故，朝庭凶讣来。\n五年再罹苦，臣民若为哀。\n钜贤荷遗托，梦泽滂九垓。\n衣冠又新命，收泪心悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离乡","author":"韦骧","text":"奔走京尘已十年，治任西去兴悠然。\n功名欲立非人致，才宦未伸还自怜。\n路柳得春多意思，野禽批水共连翩。\n孤舟独载无人语，唯把空书考圣贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过千金怀陆刚叔许顾道","author":"韦骧","text":"记得当年泛小舟，相将随计冒残秋。\n故人笑语无缘合，今日烟波独此由。\n老木战风春尚浅，断云笼日雨方收。\n自惟我辈襟期在，碌碌谁甘便白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平望阻风","author":"韦骧","text":"大风嗥空声烈烈，小舸逆牵饶卼臲。\n交跗拥鼻坐其中，蚤暮恍然难以别。\n利名无绳人自萦，山林无扃人自绝。\n区区冷官何足赖，奔走勤劳可嗟咄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题周开祖丛翠轩","author":"韦骧","text":"所居知所向，种竹接前檐。\n翠色无时减，清风引日添。\n萧疏共谈麈，辉映祗书签。\n碌碌夏畦病，输君此养恬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汴上遇孙楚材","author":"韦骧","text":"春阴蔽日多飘风，二月凛冽犹穷冬。\n驭夫凌兢踏泥冻，旅况索莫填心胸。\n淑人邂逅获交马，语言浃洽欣相从。\n夜投孤驿共清饮，安得复诉琉璃钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和所酬","author":"韦骧","text":"苌弘灭迹已绵久，谁于二月为隆冬。\n相逢诗酒得贤侣，遽使炎燠生吾胸。\n饮酣真趣不可坏，诗狂险韵皆能从。\n殷勤鄙句复叩激，自喜牙琴还遇钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早行","author":"韦骧","text":"晓鸡三唱已，戒驭复长郊。\n残雪笼河岸，初阳射柳梢。\n野人犹闭户，宿鸟或依巢。\n而我何为者，区区足自嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿零壁驿","author":"韦骧","text":"凄寒动春夕，覆被益重袍。\n乡梦惊还远，征途久觉劳。\n破窗留月影，古木任风号。\n闻戒无兵馈，刚肠独佩刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"予枕屏书叔夜养生论而孙楚材观之有诗相示遂次来韵以答","author":"韦骧","text":"枕外霜屏手自书，数千微指慰焦枯。\n乘时岂羡鹏飞海，悖理须讥马守闾。\n治气养心予所慕，长生久视古非无。\n喜君与我同兹好，免蠹当终学户枢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和黄彦文示诗","author":"韦骧","text":"执经今日再相从，快若鸿毛翼疾风。\n持己已怜仍旧好，力文还喜后来充。\n平蹊安肯容茅塞，美玉宁辞以石砻。\n顾我空空当考击，愧无术学似河东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岩斋晓起","author":"韦骧","text":"晓起郊原寂，清风盥栉傍。\n松梢泫微露，岩顶泛初阳。\n彷佛山禽语，飘零古殿香。\n携书寓疏拙，三伏化寒凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄陈安道","author":"韦骧","text":"同年同第复同门，计治同为待次人。\n一纪清时共濡滞，两身孤宦各艰辛。\n不要钟鼎须耕道，未遂山林为食贫。\n吾党襟期当自信，且随天意养轮囷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和所示","author":"韦骧","text":"布鼓微声强自信，两篇响答语惊人。\n连城自我忻怀宝，八字凭谁叹受辛。\n岂为傥来轻有动，但能恬守即安贫。\n相期厚养忘多欲，莫似豚蹄祝满囷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七夕","author":"韦骧","text":"此夕流传久不磨，相逢樽酒且酣歌。\n竿垂阮服终成强，腹晒隆书顾几何。\n漫道银潢能限隔，未闻河鼓畏风波。\n楼间安用穿针乞，世上纷纷巧已多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七夕寄安道","author":"韦骧","text":"去年此夕我拘官，君挟鱼轩到此安。\n自尔分驰数千里，岂图今日一交欢。\n风萍离合光阴速，月桂交游契分完。\n不倒玉壶终未已，待将河汉夜深看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"附郭照邻舟还乡一首","author":"韦骧","text":"国门回首气葱葱，拜了君恩去意浓。\n故里华舟幸同载，邻邦嘉士喜相从。\n高谈浃洽情无畛，新句纵横笔有锋。\n往往旁人多羡慕，主人况是郭林宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郭照邻赴南雄签幕","author":"韦骧","text":"浅汴萦回减迅流，绿榆疏薄弄残秋。\n兰舟去指三千里，梅岭前头第一州。\n幕府久须贤者画，朝廷最重远民忧。\n近来选擢多超迈，伫听君才不次酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汴舟早行二首 其一","author":"韦骧","text":"隐约短窗明，呕哑两橹声。\n晓寒衾外觉，乡梦枕中惊。\n心喜亲闱近，身从宦路轻。\n男儿棺未盖，安可叹虚生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汴舟早行二首 其二","author":"韦骧","text":"容足岂无处，浮名浪自牵。\n通宵不安寝，湍水正鸣船。\n旅况情何赖，家音远未传。\n凌晨飞棹急，聊以慰迁延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"延和引对","author":"韦骧","text":"昔年便殿拜恩光，今日重来惨肺肠。\n螭陛载瞻新侍从，龙颜如仰旧君王。\n星霜一纪逡巡过，膏泽三朝次第当。\n埃壒尚能禆泰岳，岂无忠谊报明昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至泗即天长独归叙别照邻","author":"韦骧","text":"长淮十月北风高，判袂临津首屡搔。\n草草旅装方揽辔，勤勤别酒更持螯。\n扁舟君去良多况，间道子归岂惮劳。\n行矣馀杭期会在，早来江上看寒涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再回前韵","author":"韦骧","text":"画船东下橹声高，闪见旁舟堕玉搔。\n张翰归心鲈满箸，毕公狂兴蟹双螯。\n朝餐饾饤唯论饱，夜语诙谐岂厌劳。\n乍聚乍离当不怪，夫君多可似山涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无脚桥","author":"韦骧","text":"枘凿关连壮，横空不可摇。\n激波无雁齿，跨岸只虹腰。\n改制千年取，倾舟众患消。\n乘舆济人者，为惠固相辽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离泗上","author":"韦骧","text":"晓雾锁长淮，初阳熨未开。\n造舟行险滑，舁竹势迟徊。\n回野苍茫合，严风浩荡来。\n归耕如有地，劳苦曷为哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"避雨大明寺","author":"韦骧","text":"去时骤雨忽兼风，歇马曾留此寺中。\n今日来归复如此，始知事有偶然同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和简夫游鼓山","author":"韦骧","text":"气肃乾坤万物秋，久违真概喜重游。\n高閒况奉挂冠乐，旷逸惭非蜡屐流。\n狂饮何羞吹帽落，时鲜岂必置船头。\n鹏抟鴳集逍遥等，醉眼冥冥百事休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"申园席上口占","author":"韦骧","text":"凉秋池馆燕閒身，密席荣驩主与宾。\n白日神仙分两榜，青云兄弟占三人。\n东篱潇洒黄花好，北海风流渌酒醇。\n投辖更须防壤坐，夜深共醉月精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李信臣游南岩","author":"韦骧","text":"秋云沓沓锁秋岩，怪木森森荫碧潭。\n游骑去时平野晓，老僧迎处满衣岚。\n何人自塑临泓水，近古遗棺撼石龛。\n我忆昔年曾此醉，却嗟今日辍陪参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答信臣遗诗以失南岩约","author":"韦骧","text":"閒里萦仍不自由，驰心空想碧岩秋。\n连镳独远朱蹄骏，酾酒还辜绿蚁浮。\n嗟我数年遗览历，属君一尺更迟留。\n定知清兴难穷尽，莫便轻回访戴舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和南岩回","author":"韦骧","text":"心舒还爱日，境胜欲忘归。\n茶战弱一水，棋兵尚十围。\n秋山终易冷，暮坐祇添衣。\n上马回首数，霜蟾逐盖飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"简夫丈约游南岩时以妇翁室会遂渝爽依韵和其来篇","author":"韦骧","text":"巨源常少怪，第五岂无私。\n酒食先为困，溪山辄负期。\n七年思旧赏，隔日诵新诗。\n康乐清游在，随轩别有时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和信臣游简夫太丞申园","author":"韦骧","text":"洞门流水地仙家，弃禄归来饵晓霞。\n不比钟山多怨语，未饶金谷足名花。\n风弦静舞千龄鹤，夜枕閒听一部蛙。\n此乐人间无觅处，只应天畔有灵槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和","author":"韦骧","text":"一门清训黄金贱，三叶荣名翠琰题。\n扬雀语言先世得，荀龙头角后来齐。\n联姻君喜重交好，高闬予惭早独跻。\n试听野人歌盛事，满床牙笏当公圭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和简夫送信臣同年","author":"韦骧","text":"龙凤当年共力攀，参辰异迹十年间。\n相逢邂逅身为客，叙别踌躇色动颜。\n北冀马群先骏逸，南山豹隐旧文斑。\n而今百里还淹止，行听佳声似鲁山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庐陵待试士呈伯升郎中","author":"韦骧","text":"重门昼锁碧梧阴，秋气凌虚日向深。\n耳目暂清抛吏局，情怀终乐近书林。\n安排一月拘挛计，酬酢千人进取心。\n未榜试期饶暇逸，倚樽尤喜听高吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋夜","author":"韦骧","text":"人间此节号佳辰，锁宿文场意自伸。\n雨脚洒开秋气象，云头放出月精神。\n坐无红袖何妨乐，盏有芳醪不计巡。\n数句愿歌今夕事，主人才力似阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠别伯升","author":"韦骧","text":"士林佳誉久飞扬，脱迹初筵本异常。\n尽道清朝隐方朔，不知白发困冯唐。\n古今议论千端胜，南北风情万里长。\n乍会乍离劳景向，萍江楼上独相望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和来篇","author":"韦骧","text":"贡闱将毕意扬扬，日夕炎凉亦未尝。\n几听秋声废高枕，屡乘月色坐中唐。\n云笺写句惭非敌，玉麈挥谈服所长。\n款段匪朝归冷僻，未知何以慰邻望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪吉守范淳元观玉虚观灵芝席上口占","author":"韦骧","text":"庐陵盛事照明昌，浩荡西风八月凉。\n宾履共随红旆去，仙宫新报紫芝芳。\n成非雨露宁无感，出近星辰别有祥。\n谁谓古书难尽信，眼看珍异答龚黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题吉州三瑞堂","author":"韦骧","text":"珍祥叠叠遗庐陵，芝秀莲双瑞露清。\n天意独偏三物应，人心胥庆一堂成。\n壁间篇咏辞多实，席上樽罍势自荣。\n早晚玺书褒治行，颍川遗美为销声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送章少卿赴阙","author":"韦骧","text":"老成风迹蔼中朝，威惠南边久已劳。\n三节召归方汲汲，列城怀恋尚嗷嗷。\n郊原雨止车尘少，霄汉云空旆影高。\n太上定嗟相见晚，伫闻秋觐拜恩褒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和龚簿同辨金剑源","author":"韦骧","text":"两源溪水弄清音，百丈山峰削翠琳。\n不顾衣冠当赤日，共看沙砾辨黄金。\n自缘世态嫌遗利，岂是吾侪枉用心。\n却忆去年并会乐，相逢又得叙离襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘仲诚以武夷记见借","author":"韦骧","text":"自从见借武夷编，每一开编思渺然。\n使我胸怀厌尘滓，羡君家世乐神仙。\n幔亭曾会千馀客，石洞元居十六天。\n何日访灵寻翠壁，待将名字谩同镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄上高宰孙世则","author":"韦骧","text":"乡间游处景醇全，忽忽光阴二十年。\n官局旧嗟踪迹远，封人今喜信音传。\n才驱繁剧君应易，事夺清閒我独然。\n畏简未能成会合，且持诗句写拳拳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道中寄景升仲诚二同官","author":"韦骧","text":"两道几千里，残炎七月天。\n累囚念濡滞，匹马重迁延。\n夜宿荆榛际，朝行虎豹前。\n幡思竹轩好，拥事亦神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"巴陵讯囚所居附岳阳楼前 其一","author":"韦骧","text":"双扉昼锁夜传呼，讯鞫劳心迹也拘。\n祗有清虚慰怀抱，开轩即是洞庭湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"巴陵讯囚所居附岳阳楼前 其二","author":"韦骧","text":"洞庭湖上岳阳楼，旧走声名遍九州。\n今日偶来犹吏事，幸当风月近中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洞庭秋四首 其一","author":"韦骧","text":"洞庭秋旦好，馀雾尚怀山。\n日色一竿际，波光万顷间。\n宿商鸣橹去，夜网得鱼还。\n佳趣知多少，濡毫恨思悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洞庭秋四首 其二","author":"韦骧","text":"洞庭秋昼永，气象坐中分。\n浩荡三江水，苍茫万里云。\n君山压波面，民舍傍城根。\n自昔看图画，今焉过所闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洞庭秋四首 其三","author":"韦骧","text":"洞庭秋薄暮，日脚返沧溟。\n云气天涯赤，峰峦水上青。\n归舟来隐隐，夕鸟去冥冥。\n鼓瑟音何在，空闻帝子灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洞庭秋四首 其四","author":"韦骧","text":"洞庭秋夕爽，皎月瑩长空。\n颢气重湖接，清光四望通。\n楼开云母扇，人在水晶宫。\n胜绝无穷景，萧条万古同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄示二小子","author":"韦骧","text":"学自辛勤富，名从旷怠休。\n痴慵回尔意，捍格慰吾忧。\n股刺难须著，邻光岂用偷。\n当知汉唐世，家绪有公侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洞庭即事 其一","author":"韦骧","text":"日车闪闪下山椒，风阵萧萧掠柳条。\n湖上晚秋天气爽，楼间极目客魂销。\n湘妃哀怨冯谁听，楚屈英灵何处招。\n窃禄无田归未得，浪吟当此愧渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洞庭即事 其二","author":"韦骧","text":"浪头卷白去无垠，山面铺青一色匀。\n气象清雄无处比，情怀局促此中伸。\n攲危钓艇唯堪望，仓猝商帆不用嗔。\n顾我遽来非自任，也知牵制为官身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"君山","author":"韦骧","text":"洞庭波上崒高峰，翠色难将别岫同。\n真籍从来标福地，大钧于此费神功。\n蛟龙拗怒深深避，星月流光面面通。\n尘迹未能乘兴往，据鞍回首正秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岳阳楼","author":"韦骧","text":"岳阳楼句旧空传，今日登临一慨然。\n不是洪钧有偏党，岂容胜概独完全。\n山川形势三千里，基构声华五百年。\n襟带西南太平世，收罗风月属私权。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓起","author":"韦骧","text":"落月光微暝霭收，一轩潇洒旅怀幽。\n湘君山外波涛晓，麋子城边草木秋。\n俗吏区区易情倦，古人皦皦志空求。\n且希月廪从官给，仰事孤亲洁膳羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅金科","author":"韦骧","text":"得情犹勿喜，圣训所宜钦。\n取正存三尺，持平在一心。\n摭文唯恨密，丽罪莫求深。\n岂必于虞辈，源流定可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和朱伯英新州诗见寄二首 其一","author":"韦骧","text":"武川当日一分襟，会合乖期向武林。\n从此参辰不相比，由来岁月渐加深。\n书邮远道烦新寄，诗社前盟约再寻。\n何以报君双白璧，南楼高处独萦心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和朱伯英新州诗见寄二首 其二","author":"韦骧","text":"吏冗拘人好思悭，怜君远远发昏顽。\n梅花岭外题诗寄，萍实江边继韵还。\n数幅密缄迢递去，寸诚都写别离间。\n翻思旧日赓酬乐，鼓噪当时更有颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送潘簿还侍下","author":"韦骧","text":"四见霜花始解官，綵衣还侍肯盘桓。\n胸中事业仍加益，箧里经书不废看。\n立马仙山风帽侧，移舟秀水露帆寒。\n铨衡论奏恩辉近，早寄佳声遗我欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送周广之令桂阳","author":"韦骧","text":"犹馀残雪凝山椒，已见新春上柳条。\n引领不能成面别，寄诗空欲减魂消。\n为言民社迁官重，莫叹湖湘去路遥。\n早向县廷舒所欲，如君风迹定翘翘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":46204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]