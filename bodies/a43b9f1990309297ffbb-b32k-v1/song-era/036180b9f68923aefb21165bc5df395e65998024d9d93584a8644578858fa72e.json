[{"title":"次韵严上舍","author":"陈造","text":"待月尚思前度月，中天圆璧不留分。\n即今霜气挟灵籁，如许金波乘坏云。\n念我吴牛终喘夜，忆君冀北忽空群。\n睡魂作魔病作祟，犹赖清诗来解纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵严文炳兼简张守二首 其二","author":"陈造","text":"梅梅柳柳护深行，倦客重游眼更明。\n谷鸟自应寻旧约，渚兰潜欲换新萌。\n诗工已可醒人醉，赋就当须冰坐清。\n老我客渠真得计，梦魂无复凤凰城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵严文炳兼简张守二首 其一","author":"陈造","text":"嬉游有愿自今偿，回首春容已浩茫。\n霁景偏迟张锦地，小园秀出卧云庄。\n梅林破玉香沾袂，池水摇漪渌泛堂。\n茶具笔床陪语笑，未妨日饮慰还乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵何学谕送行二首 其二","author":"陈造","text":"湖山迎客棹，触目总宜诗。\n回首蓬莱近，平生汗漫期。\n衰年得奇观，往事属怀思。\n何日鸱夷去，扁舟共翠眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵何学谕送行二首 其一","author":"陈造","text":"新诗念报答，呫嗫未能书。\n落笔群英右，惟君一敌如。\n穷愁疏翰墨，客路费羲舒。\n延閤青冥上，摩研正望渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵何符山人二首 其二","author":"陈造","text":"晓看明玑下网丝，物华俱属喜晴诗。\n一词不措重呈拙，七字鼎来当更奇。\n喜鹊啅人真作意，蜗牛屏迹似知时。\n湖山好处长谣去，拟赴苏堤胜日期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵何符山人二首 其一","author":"陈造","text":"门下轩裳不转头，何人皮底著阳秋。\n独烦客子冲泥屐，屡到衰翁听雨楼。\n从昔诗声追正始，即今宾友验宣州。\n清篇快读彊人意，未觉京尘厌薄游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吴江陈学长送行二首 其二","author":"陈造","text":"白首诗书未亢宗，还纡墨绶揖王公。\n玉堂金马拌身外，法护僧弥且眼中。\n自诡嘘枯酬雅志，肯从束湿就奇功。\n垂虹高士知心客，定信襟期出处同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吴江陈学长送行二首 其一","author":"陈造","text":"诗人六十合恩袍，平日周庠重誉髦。\n旧学堪重汉儒席，新文欲仆楚人骚。\n等观得丧心无累，饱阅豪英眼更高。\n闻道青箱富嘉颂，诏音早晚召王褒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张司户 其二","author":"陈造","text":"他日犹能说宦游，老禁多病厌漂流。\n近临西蜀窥鲛室，旧傍东溟看蜃楼。\n归计已嗟霜蟹晚，吟声闲伴候虫秋。\n尘冠径欲留神武，万顷苍茫漾白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张司户 其一","author":"陈造","text":"橘颂精灵杂远游，如君信是古诗流。\n吴门肯问鲈鱼鲙，东武当营燕子楼。\n有底挥毫挟风雨，定知贮腹尽阳秋。\n即看珥笔鸳鸾右，莫漫江城诧狎鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张丞","author":"陈造","text":"邦人邑吏总堪怜，茶供炉熏共吁天。\n占雨几孤霞粲晓，望霓何啻日为年。\n翻黄已熟村村麦，平渌行看处处田。\n拟倩龙公作霖手，更烦终惠息头燃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张丞 其一","author":"陈造","text":"县人灯夕旧尝看，夜敞窗扉晓不关。\n胜赏继应追俗尚，晴晖巧与破天悭。\n招邀便拟日复日，容易遽吟山上山。\n更乞紫姑丰乐语，为添喜色到颜间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张丞 其二","author":"陈造","text":"长日官曹迄未闲，佳辰一笑颇相关。\n万情同乐那容失，四者来并每坐悭。\n歌酒恐孤灯市月，烟霏犹曀海门山。\n龙公可复会事发，汛扫阴霾弹指间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张丞二首 其二","author":"陈造","text":"槁梧闲据自沈吟，投老真成负此心。\n酒沃渴鲸悲事往，官随跛鳖笑吾今。\n进为终愧周人朴，归去曾无陆子金。\n尚赖君诗慰牢落，时清聋聩发纯音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张丞二首 其一","author":"陈造","text":"夫君腹笥尽奇谋，每叩谈锋听不休。\n诵赋久嗟无此作，荐贤端合拔其尤。\n小迟荣路观掀趠，聊为同寮盖谬悠。\n政恐诸公有推挽，平时果艺仰由求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张丞月试士人","author":"陈造","text":"居有斋庖教有官，诸生肯复计安闲。\n充庭数贡知非远，造物于人本不悭。\n思苦得无金注拙，眼明终眩锦花斑。\n自怜惯秉雌黄笔，案牍如今拄屋山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守与润守总卿诗四首 其四","author":"陈造","text":"向我能忘势，张侯却甚真。\n频分代舍饭，遣濯客裾尘。\n长日无知己，因君爱此身。\n可须砭剂力，振臂起漳滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守与润守总卿诗四首 其三","author":"陈造","text":"残年仍旧学，平日亦新书。\n酒渴今司马，岩栖昔幼舆。\n梦无三字拜，家有五车储。\n但谂催诗烛，吾衰冀少徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守与润守总卿诗四首 其二","author":"陈造","text":"渔樵送晚景，天地著陈人。\n涧底离奇干，人间浩荡春。\n峨冠才识字，何策可资身。\n不拟千言赋，忉忉慁大钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守与润守总卿诗四首 其一","author":"陈造","text":"天阶玉作笋，此地合垂绅。\n尚戒专城驭，虚逢吁俊辰。\n公方阅竹马，名已荐枫宸。\n政恐经纶去，诸公拱后尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守劝农 其二","author":"陈造","text":"眼向囊书老不明，合遵宽教事农耕。\n雨馀骤变菖条绿，晓起欣聆布谷声。\n谭笑俾民无死徙，丰凶转手有虚盈。\n衰翁倍荷殷勤意，缄致无非翠织成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守劝农二首 其二","author":"陈造","text":"竞簉行轩亲色笑，教条初不作风霜。\n为公醉德仍醇酎，惠我温言亦报章。\n重见桐乡敬朱邑，不须畏垒诧庚桑。\n受廛定许休吾老，已戒诸雏计裹粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守劝农二首 其一","author":"陈造","text":"传闻载酒西郊晓，迎候前旌拥老农。\n贤守承宣先劝课，太平风俗见声容。\n官堤烟树纡红缬，沙岸风蒲袅紫茸。\n想憩凝香倒囊锦，银钩侧理叠千重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守劝耕二首 其二","author":"陈造","text":"三揖清扬岁两更，烦公倒屣费逢迎。\n抽簪仕籍心弥厉，撰屦词坛计欲成。\n西洛况闻高纸价，苏州从昔擅诗声。\n拙衰枉作登龙客，领略玄谭自阿平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守劝耕二首 其一","author":"陈造","text":"吾徒一笑似关天，离合胡宁付偶然。\n梦境萍蓬渺云水，旧游花柳更风烟。\n交情缱绻今犹昔，妙句传抄喜欲颠。\n廷尉归须结袜客，为公饱饭计留年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守王勉夫二首 其二","author":"陈造","text":"世味平时虫臂轻，独留意气与君倾。\n向来缱绻资磨玷，拟话分携已怆情。\n盛际功名方策足，他年车笠肯渝盟。\n汉廷取重张廷尉，可待区区结袜生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守王勉夫二首 其一","author":"陈造","text":"两隽诗声敢重轻，苍山对峙大川倾。\n形为幼眇无遗恨，有入题评莫遁情。\n未许曹刘夸独步，不应邾莒合逃盟。\n清篇读罢重看镜，似觉青丝鬓脚生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守泛春亭","author":"陈造","text":"小退铃斋复此亭，自公喜色更津津。\n再纡皇眷分忧寄，坐镇江城与物春。\n长日雍容少公事，共谁谈笑作诗人。\n撚髭惯厕分题客，元亮柴车已命巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守妻闵忌","author":"陈造","text":"莱妻魂逝不容招，敢问何方处寂寥。\n老去更堪听薤露，病来久不近金蕉。\n声摇夜梦蛩相吊，垢翳篝衣雨辄潮。\n细读君诗重悽惋，隐侯肤骨不胜销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守赴真州辞家","author":"陈造","text":"争引依风领，须公布惠慈。\n深恩手摩拊，数计月盈亏。\n岁事方援溺，情亲更语离。\n来时雁天阔，触目总宜诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守晓起","author":"陈造","text":"客亭移枕待残更，起趁邻鸡第二声。\n了了每添新悟解，营营无复旧心情。\n兴来命酒禁诗瘦，老去衰容怯镜明。\n况是杏花浓露晓，不应蒙被问春晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守涂中逢节二首 其二","author":"陈造","text":"赏心仍令节，十事九相违。\n老境家犹远，愁城日合围。\n客涂君尚叹，世路我知非。\n羡杀乡居子，耕梁木叶衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守涂中逢节二首 其一","author":"陈造","text":"涂中岁遒尽，江影暮澄凝。\n柏酒惟宗武，河梁似李陵。\n问津田叟傲，捩柂长年能。\n系缆才沙觜，人家已上灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守涂中生日","author":"陈造","text":"诸雏称寿纪桑蓬，此会频年客路逢。\n抚事祗令伤急景，持杯随分发衰容。\n心缘羁旅长多遌，情为思亲政复钟。\n更惜齐眉旧兰友，今春觞咏断相从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张守惠山","author":"陈造","text":"诗伯心如水，熊轓再护边。\n教条父老舞，姓字裔夷传。\n客到牵铃索，诗成仰屋椽。\n平吞云梦泽，聊酌隐之泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张秀才雪","author":"陈造","text":"可是春皇吝物华，群仙剪水作奇葩。\n壶中天地浑糜玉，风处园林尽勒花。\n宿火煖寒聊榾柮，夜光落手忽惊嗟。\n忍饥遽拟搜诗谢，何异空肠更饮茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张直閤避暑","author":"陈造","text":"红榴照眼笋穿阶，峭閤登临快此来。\n净境祛烦仍客共，醉乡逃暑更书催。\n庭阴碎喜风头动，虹影明看雨脚回。\n万事屏除诗债迫，此心抖擞未容灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张德恭主簿二首 其二","author":"陈造","text":"汉南独步有登楼，肯为衰翁吟掉头。\n价比连城容品裁，句专八米见风流。\n生涯枯泽鸣饥鹤，老去惊波荡白鸥。\n当念饭山人似削，撩人更遣耐新愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张德恭主簿二首 其一","author":"陈造","text":"一日乘闲燕画楼，连宵飞梦只楼头。\n掾郎谈麈惊飞雹，公子吟毫涨怒流。\n归去定谁扶下马，重来有约属驯鸥。\n可堪风雨妨人乐，却向卢家访莫愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李寿卿明府忆梅 其二","author":"陈造","text":"炯若横陈耐冻枝，清篇细读更重披。\n即令扶病揩尘砚，痛忆寻芳载酒时。\n政使雪霙来眼底，却愁霜鬓被花欺。\n暗香疏影君能事，何处羁人敢语诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李寿卿明府忆梅 其一","author":"陈造","text":"不分无花空折枝，探梅要趁未纷披。\n忆常月地携筇去，似许风裳倚竹时。\n庄蝶认香怜梦短，墨君写影竟谁欺。\n故人底事江南北，驿使来时仅好诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨帅留客赏雪二首 其二","author":"陈造","text":"园林花絮忽冥冥，水墨工夫忆李成。\n琼树挽春争炫昼，玉龙转野寂无声。\n绮罗樽俎诸宾醉，箫鼓楼台九陌晴。\n不比游仙向来梦，真陪仙伯燕曾城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨帅留客赏雪二首 其一","author":"陈造","text":"锡羡端知自杳冥，更资和气与烘成。\n餍观搅海翻云势，旋听摧檐泻竹声。\n狎坐鸳鸯方荐笑，窥檐乌鹊已熹晴。\n从公草赋梁园罢，未羡将军下蔡城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨枢视圩游隐静","author":"陈造","text":"劝相江糜畚锸忙，却回小队访山房。\n松风不约炉烟直，昼晷潜随僧话长。\n政外辍闲知有味，区中得醉浪名乡。\n铜丸好句长哦罢，坐听惊猿堕莽苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨枢喜雨","author":"陈造","text":"神护天关色正庄，挽回帝眷一丝香。\n人间雨信先鸣鹳，仙界雷翁叱卧羊。\n剡剡青秧迷迥野，浮浮白水溜方塘。\n丰年信出为霖手，恳悃忧民意叵忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰","author":"陈造","text":"我方獭髓疗蜂腰，渠自才华盖代豪。\n州掾聊容养文豹，玉音催去踏金鳌。\n联芳君亦花封最，双峙人推玉笋高。\n看即提衡霄汉上，得无交口话啼号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰","author":"陈造","text":"君方总辔冒尘沙，我亦青灯未著花。\n县宰忧民暇黔突，道人有饭即为家。\n倦温村酿萁火暗，笑撚吟髭风帽斜。\n等有灞陵桥上兴，不妨频著小诗誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰二首 其二","author":"陈造","text":"五斗宁辞小折腰，簿书那久困才豪。\n得无狸豹惊雕虎，妙有钩丝掣巨鳌。\n诗就鼎来宫锦肠，闲中眼与楚云高。\n横陈景物无央数，付子秋崖万窍号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰二首 其一","author":"陈造","text":"早缘官事坐儿痴，晚悟骚人赋汩泥。\n耐病久闲金騕袅，扶衰时近玉东西。\n词场尚友心终在，诗力逢君价自低。\n欲试成风须妙质，莫怀章甫问雕题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰公田道上","author":"陈造","text":"人有褰裳去，时闲野渡舟。\n知君问彫瘵，随处访深幽。\n岁事方关念，村醪不破忧。\n贳租仍己责，或可继前脩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰次郎裴","author":"陈造","text":"信次尚村落，食眠随晓晡。\n山瓶馀濩倒，僧宇谒伊蒲。\n笑挟兔园策，问收鱼澳租。\n前滩起鸥鹭，为我作前驱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰述怀","author":"陈造","text":"为儒如此尔，粮食第晨晡。\n诗漫南山杞，愁连董泽蒲。\n宾筵阙鹅炙，券负有牛租。\n久要惟穷鬼，文成不受驱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰秋尾雪","author":"陈造","text":"密雪界秋冬，悲欢可得同。\n祥如关岁事，时合奏场功。\n政要肉骨手，民方霜叶风。\n强吟盐絮句，面不盖羞红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰食莲戏作 其二","author":"陈造","text":"诗到衰翁耐病时，辟渠三舍更何疑。\n才高王俭幕中隽，气慑孙郎帐下儿。\n向我论交得无意，他时怀旧更长思。\n莲茎把玩不为腹，羡杀逢人饮上池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰食莲戏作 其一","author":"陈造","text":"平时莲实吾羊枣，日饫甘寒不自疑。\n病恐伤生严食事，居多节口甚婴儿。\n舌融沆瀣诗能说，手掬珠玑我属思。\n对酒移风劳想像，静看千柄泛前池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰宿北阿","author":"陈造","text":"寒事峥嵘念解携，芳樽忆共拆红泥。\n邮筒空有诗相续，夫子东归我复西。\n剌剌掀林朔风驶，沈沈閤雪晚云低。\n巴歌拟报阳春赠，未敢从人索品题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰野步","author":"陈造","text":"筇杖陪随去，漂然不系舟。\n云低山影暝，风定竹林幽。\n病减柳臂感，老无蒿目忧。\n吟诗如蚀月，玉斧傥能脩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰野步","author":"陈造","text":"眼边室迩叹人遐，再见惊飙衮雪花。\n岁歉民劳真诿子，泥行草宿又谁家。\n题诗山寺神应助，问俗村区日易斜。\n随处棠阴诵遗爱，他年剩著翠珉誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰雪","author":"陈造","text":"对雪动遐想，此情今古同。\n饶为灞桥句，会奏蔡城功。\n耻卧袁安屋，思乘列子风。\n高翔广乐地，眩旋九霞红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰游神居","author":"陈造","text":"峰顶留云一鹫骞，山腰涵碧老蛟蟠。\n鹍鹏翻海十洲近，江汉分流三楚宽。\n曾是乘闲上埃霭，小留舒啸倚高寒。\n想君缓憩双凫舄，不羡冲霄吴綵鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵杨宰樊汊","author":"陈造","text":"龙岂分勤惰，司存想异方。\n禜雩均此意，丰歉竟殊疆。\n惠戒憎漏网，君宁专击强。\n东南有偏熟，鄙语未应忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵言怀","author":"陈造","text":"房陵回首望淮东，物土人情未易同。\n比屋蜂悬人带瘿，乱山戟立势凌空。\n污鲰共餍川人食，简朴仍存太古风。\n破我残年七百日，尽抛诗卷酒杯中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈秀才二首 其二","author":"陈造","text":"七字开缄粲陆离，元非剑气烛圜扉。\n夜光信出老蚌壳，锦段遽分邻女机。\n庭赋继今行北阙，市娼过眼忽南威。\n蜚腾可但荣亲计，我亦他年得俊归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵陈秀才二首 其一","author":"陈造","text":"吏治因循俗已疵，可无柱后济宽慈。\n顾惭德化一何取，敢意古人三不欺。\n剔蠹方图洗熏染，放麑端复惎衰迟。\n成君今段莱衣笑，莫更风前赋百罹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]