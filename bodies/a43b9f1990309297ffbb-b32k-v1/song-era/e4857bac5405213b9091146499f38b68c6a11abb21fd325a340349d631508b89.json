[{"title":"钱塘江潮 其二","author":"徐积","text":"沧溟几道入江淮，此独奇哉复怪哉。\n风雨初随霜练起，雷霆俄送雪山来。\n岂无海物齐驱过，亦似神兵合阵回。\n君向西湖亭上看，杭州不信有尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋水","author":"徐积","text":"水与秋月色，清无一点瑕。\n有情山共远，无限日初斜。\n鹭下沈寒苇，雁空遗暖沙。\n旋将堤畔木，学泛斗边槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题东轩 其一","author":"徐积","text":"我有东轩景，喜君为此行。\n一如旷野外，四面好风生。\n但见云连树，不知山是城。\n重来如有约，秋水夕阳明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题东轩 其二","author":"徐积","text":"我家东轩好凭栏，柳一林边水一湾。\n城下人烟都似野，城头云树恰如山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋月 其一","author":"徐积","text":"青女霜华夜不收，一天如扫月如流。\n素娥奔去已千古，狡兔隐来还几秋。\n冷逼蚊雷声陡息，光摧萤火色何幽。\n尘埃两眼洗不净，安得淩云万丈楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋月 其二","author":"徐积","text":"珠箔珊珊挂玉钩，金梯轧轧倚红楼。\n桂摇团影上层汉，桐坠疏阴才半秋。\n万顷玉田和露白，一环瑶水带霜流。\n何人独向绣帏泣，烛泪淋漓香篆幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月九 其一","author":"徐积","text":"九日诸公欲上山，淮东病叟正閒閒。\n如从酒伴无惭色，傥论贤才即汗颜。\n适载巨疱寻陋巷，仍封大轴委樵关。\n不知我是扶犁手，玉树成林尽许攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月九 其二","author":"徐积","text":"何必南山与北山，此心非独此时閒。\n手持白酒为常事，头带黄华是强颜。\n醉后浩歌来就榻，醒时清啸起抽关。\n谁人遗我明霞曲，声在赤霄无处攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月九 其三","author":"徐积","text":"有人才思耸如山，已燕淮亭未肯閒。\n亲载绿醽温病骨，更歌白雪慰苍颜。\n老凭书几犹操笔，暮等吟筒正启关。\n两手尘泥俱涤尽，金茎玉露我须攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月九 其四","author":"徐积","text":"桓家宾客正寻山，刘子藏身尽日閒。\n忽为著书惊晚节，更因把菊觉衰颜。\n白衣来缓思沽酒，绣岭登高梦入关。\n最好莲华峰上路，藤条葛蔓手齐攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月九 其五","author":"徐积","text":"堂堂兵阵列如山，羽檄交飞势未閒。\n敌国正强无备处，我师潜遁若为颜。\n已张火炬严刁斗，更使辕门置铁关。\n欲就将军送降款，金城万雉莫能攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月九 其六","author":"徐积","text":"不是妻孥须入山，著书未得片时閒。\n琴逢嵇叔难施手，啸比孙登合腼颜。\n几日偃旗兼卧鼓，今朝延敌又开关。\n我师欲遁无归路，严垒如云试一攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"除夜 其一","author":"徐积","text":"春意匆匆又欲还，一年都似片时閒。\n青云有路终须到，白日无情不暂閒。\n任老岂妨修古道，更贫未肯忆深山。\n明朝献寿何为祝，长著斑衣奉母颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"除夜 其二","author":"徐积","text":"但得文章与道深，年来年去不关心。\n几时上得青云后，两鬓从教白发侵。\n匣内深藏三尺剑，樽前独抱一张琴。\n辞高调古弹将晓，待倩春风听此音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"除夜 其三","author":"徐积","text":"一灯高照草堂中，大笑高歌送岁穷。\n柳色花光将属我，雪寒霜凛任相攻。\n铜壶漏促三更尽，白玉樽深一釂空。\n待到平明无别事，只将诗句赠春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"除夜 其四","author":"徐积","text":"前日慈闱献寿觥，为亲歌咏祝长生。\n被君翻作阳春曲，却使巴人和不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜雨上山阳守","author":"徐积","text":"山阳太守奉更书，尽束行装载轴舻。\n已有仁风为惠爱，更留甘雨活焦枯。\n粳塍带溜苍苗奋，麦陇藏烟绀颖敷。\n看取北郊临去日，争先献酒是农夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏雪","author":"徐积","text":"雪者阴之类，大寒之所为。\n于人无暖意，著物有消时。\n万草若相畏，孤松亦自持。\n閒阶不须扫，日照与风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答雪","author":"徐积","text":"一夜寒声梦不成，读书灯暗雪窗明。\n起来待唱巴人曲，閒得阳春第一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春雪 其一","author":"徐积","text":"天上星榆一夜彫，晓风吹紧下层霄。\n溪头岸狭流应涨，帘外春寒到不消。\n数骑急投村墅宿，几人忙奔酒家谣。\n登高望遍东城路，又领诗兵战寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春雪 其二","author":"徐积","text":"雪满东风只到关，西飞还不到长安。\n鹭翘孤白精神健，莺敛黄金羽翼寒。\n远岭玉迷樵木径，晚溪冰压钓鱼竿。\n陇头鼓腹讴吟者，但向深秋前后看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中书事","author":"徐积","text":"闻道西家高捲帘，昂头吟笑雪花天。\n东家正泛一杯酒，北望孀亲夜不眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋风","author":"徐积","text":"万物已衰歇，乾坤正泬寥。\n数声何处起，万窍一时号。\n好木望君惜，残蓬任汝飘。\n霜空静如扫，努力助飞雕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋云","author":"徐积","text":"淡似秋河水，浓于春坞烟。\n陇头寒塞雁，峡外晚江天。\n忽断月华坠，乍明虹影连。\n西风休强管，飞势自翩翩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"樵家","author":"徐积","text":"邻叟是耕渔，怡然只自如。\n草迷春径狭，雀噪晚篱疏。\n自向林泉惯，翻嫌市井居。\n儿童尽樵采，斗粟亦无馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"村家","author":"徐积","text":"阶前生蔓草，门外是多歧。\n老叟行无伴，儿童饱自嬉。\n鸱群巢众树，狐迹过疏篱。\n不肯勤耕耨，丰凶为有时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔者 其一","author":"徐积","text":"枯笠摇风雪满衣，年年辛苦事渔矶。\n有时钓得鳣鲸上，又被行人买得归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渔者 其二","author":"徐积","text":"家住前村芦苇中，一生无事是渔翁。\n眼看波浪如平地，身向江湖若断蓬。\n小艇醉眠寒夜雨，短帆閒挂夕阳风。\n营营市井应相笑，不道锥刀尽是空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"织女","author":"徐积","text":"此身非不爱罗衣，月晓霜寒不下机。\n织得罗成还不著，卖钱买得素丝归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪 其一","author":"徐积","text":"淮上飞花正皓然，日车月御欲停鞭。\n千形凛凛如无地，一片苍苍忽露天。\n洞口似迷山路处，斗閒疑泛海槎年。\n长瓢酒挹云泉酿，大轴诗题锦水笺。\n僧舍手抔留煮茗，渔庵瓶贮借烹鲜。\n喜馀稻糁投饥喙，惭乏绨袍赠冻肩。\n白里好张红步障，猛中宜摆绛戎旃。\n扫开寥廓凭风帚，抉去纷纭忆剑仙。\n猎火正燃云有焰，旅庖何在突无烟。\n未应门外同袁子，曾买污莱数亩田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪 其二","author":"徐积","text":"君看飞雪竞翩翩，云将争驱正著鞭。\n人望已酬残腊后，物华兼值早梅天。\n招沽北掾输平日，走马西州忆少年。\n漏屋旋消濡弊褐，破窗穿过湿馀笺。\n蹄涔易见真洼满，粪土难辞伪色鲜。\n席户冷灰人削迹，朱门热炙客摩肩。\n纷纷万事还如此，寂寂幽怀尽舍旃。\n流水明中争趁月，断鸿深处独藏仙。\n谁家渔棹空闻笛，何处樵村只见烟。\n最好耕农相贺了，牛衣醉卧夕阳田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪 其三","author":"徐积","text":"侯款诸祠方彻奠，车回五骏既投鞭。\n云如大练生淮浦，雪似繁星落楚天。\n有客弄花知乐岁，何人感物惜流年。\n南城病仆惟沽酒，西郭诗章但买笺。\n隐伏急因明处见，垢污多自夜来鲜。\n佣将粺谷才糊口，拾去濡薪未息肩。\n白面韝鹰红锦臂，乌山围兽赤缯旃。\n却燃灯坐疑为梦，欲上楼看恐有仙。\n玉镜台前侵皓月，碧纱窗外弄青烟。\n树头还有鸿栖否，船是寒沙水畔田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪 其四","author":"徐积","text":"诸少逸驾追无前，我乘驽马持短鞭。\n更添一老爱白雪，但开两眼寻青天。\n诗中戈矛欲挥我，君家伯仲空忘年。\n摇笔吟哦有裂管，倒囊抖擞无遗笺。\n谁知群形消即露，却还本质污与鲜。\n田庐有蓬尚塞户，樵衣无布堪补肩。\n群儿上垄刍且牧，孤戍曝日旗与旃。\n人閒安得真洞府，空中失脚飞神仙。\n明月随来会星弁，白云迎去升紫烟。\n溪湾留下断虹卧，山阴亦有玲珑田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪 其五","author":"徐积","text":"一夜五宫星茫然，投壶笑电挥赤鞭。\n何物变为淮上雪，馀花散入江南天。\n东家乞火温稚子，西邻赊酒娱高年。\n樵翁头上笠戴月，渔父手中帆卷笺。\n庾子贞家但寻菜，鲍通直辈弥矜鲜。\n卞郎方弄瓠杯杓，浙帅已亡羊髀肩。\n当门正好张敝席，隔篱可笑窥华旃。\n最是珊珊上楼佩，恰如冉冉升空仙。\n牵牛童儿饮河汉，扶犁老子耕云烟。\n漫翁何处拾瑶草，自有梅花大庾田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪 其六","author":"徐积","text":"江西词客休刺船，马上俊郎休弄鞭。\n且看满城花落地，恰如穷谷晓时天。\n松林独干凌坚操，麦垄疏毛白少年。\n犬信宜将筒护纸，鸿书须用帛为笺。\n月中两艳非投暗，物里千形不较鲜。\n最好一环围井口，有时数点露山肩。\n纷来上相挥长麈，侧去诸卿蔽曲旃。\n水畔谁为佩珠女，车中人是行云仙。\n吟裁笛竹清梅瘦，忽爨琴桐湿更烟。\n近日无钱酬酒媪，且教借卖漫翁田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪 其七","author":"徐积","text":"昨霄梦看六龙渊，鹤御惊回坠晓鞭。\n万顷落花春晚后，一床清水月明天。\n门无黄雀张罗地，室有玄熊应梦年。\n入竹好鸣寒玉佩，寄梅兼附白云笺。\n杨妃绣段披方稳，李逸乌纱裹更鲜。\n避色莫投妆妇指，弄香须扑舞蛾肩。\n群乌噪过巢无树，一兔奔归猎有旃。\n溪叟正如翘苇鹭，山翁弥似出尘仙。\n僧檐鸟伺斋馀饭，客灶猫栖爨后烟。\n且报漫翁来掘壁，墙閒便是我家田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪 其八","author":"徐积","text":"吟怀忽共雪纷然，罪逆馀骸自可鞭。\n罔极之恩无报日，难平所感欲呼天。\n身骑騕袅成童岁，手握狻猊未丱年。\n三釂冷醅将及斗，一挥醉笔恰盈笺。\n当时饰束头毛绿，今日衣濡眦血鲜。\n楚泮师儒新腼目，秦关父老旧随肩。\n中心但比孤青桧，外物无庸大赤旃。\n每指多图为酖毒，自言寡欲即神仙。\n房中得子眠温席，突外从人笑冷烟。\n以此终身慰泉壤，不须问舍与求田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪 其九","author":"徐积","text":"荀翁犹慕李膺贤，漫叟当车我执鞭。\n辕下两骖将逐骥，墙閒一穴欲窥天。\n兵锋甚锐逢今日，铁阵横行记昔年。\n将钺挥金何用剑，檄书插羽不须笺。\n勇骑龙子神弥俊，笑扼犀吭血正鲜。\n一鼓已输元帅手，双矛将解敌人肩。\n我徒北首思投甲，子使西来约卷旃。\n自是见羸谋饵虏，却云养气欲希仙。\n已严军令除添灶，但恐师期忽举烟。\n设若渝盟相掩袭，冲车突骑占平田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪 其十","author":"徐积","text":"团团藓晕埋青钱，稍稍竹树藏绀鞭。\n鸬鹚覆水鱼沉渊，罞罿蔽地禽冲天。\n梅房处女莺坐禅，草头稚子松耆年。\n浮光飞沫人游川，斜行大字鸿书笺。\n壮士可论持守坚，美人休说容华鲜。\n乞馀之夫尤慕膻，附炎之子弥胁肩。\n穿花走马锦藏鞯，垂云阅武车张旃。\n虢姨满路空遗钿，陈妃倚阁真神仙。\n有人情似山中泉，其情浓如春深烟。\n留下断芦云蓑篇，长令雪满淮之田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶述","author":"徐积","text":"寂然閒地好弦歌，胸中森森万仞戈。\n自道壮图终有用，未知时事竟如何。\n千金似粪无心愿，一剑如霜为国磨。\n吟辄废眠诗骨瘦，酒能消思醉颜酡。\n起登夜阁乘明月，笑倚寒山望太阿。\n谁道吾儒无壮士，蔺生功烈胜廉颇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"催妆 其一","author":"徐积","text":"鲁巷予方乐，秦楼子幸俱。\n所期为列女，应不讪庸夫。\n野叟田无璧，仙娥佩有珠。\n鸾歌迎弄玉，麟脯宴麻姑。\n自是闺中秀，何烦脸上朱。\n君看阆风客，亲驾五云车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"催妆 其二","author":"徐积","text":"行事从来号阔迂，酒閒诗兴便豪觕。\n卢公误妾平生事，嫁得东皋卧草夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"锦被堆","author":"徐积","text":"春风萧索为谁张，日暖仍熏百和香。\n遮处好将罗作帐，衬来堪用玉为床。\n风吹乱展文君宅，月下还铺宋玉墙。\n好向谢家池上种，绿波深夜盖鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽词 其一","author":"徐积","text":"顾托艰难后，宫城昼闭关。\n师屯五校肃，日驭六龙閒。\n易贮金茎露，难寻玉府山。\n裕陵人散后，犹望白云閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽词 其二","author":"徐积","text":"启殡龙輴动，森森凤翣移。\n迎神帐殿远，背阙梓宫迟。\n日惨河山路，草枯霜霰时。\n綵庭觉潇洒，应诵廖莪诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代人进太皇挽词 其一","author":"徐积","text":"九载忧勤事，倾心为继明。\n手扶天柱起，身御日车行。\n大业真无负，全功定有成。\n生民正歌舞，万丈玉山倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代人进太皇挽词 其二","author":"徐积","text":"绛节排山仗，珠襦换玉衣。\n不乘黄鹄去，即御赤鸾飞。\n受谥心无愧，朝真德有辉。\n太元庭上客，闻义亦歔欷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代人进太皇挽词 其三","author":"徐积","text":"一自姬周后，难乎有此才。\n明将照幽隐，泽欲被蒿莱。\n外属私恩绝，本朝公道开。\n勒铭何处好，嵩岳郁崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代人进太皇挽词 其四","author":"徐积","text":"玉殿菆宫启，龙輴叩陛初。\n严兵犹惊夜，列仗已当车。\n路指新陵阙，窗留旧简书。\n移班近东处，风月一帘虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代人进太皇挽词 其五","author":"徐积","text":"导骑鸣鞭去，魂车恋阙迟。\n梓宫何处宿，幄殿夕阳时。\n天上有名姓，人閒无路歧。\n三泉深百尺，神御复何之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阎博士挽词 其一","author":"徐积","text":"可惜方刚士，平生气貌严。\n有朋搔白首，无路吊苍髯。\n地下新潜德，人閒故养恬。\n儒林与孝友，二传子须添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阎博士挽词 其二","author":"徐积","text":"一梦龙蛇后，难寻博士星。\n所居城见月，仍用柏为庭。\n白马车齐送，黄宫户永扃。\n松陵今夜客，恸哭入冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苗户部挽词 其一","author":"徐积","text":"虽负文场志，何惭国士风。\n王廷曾抗论，庙鼎合铭功。\n玉树摧平地，朱霞落半空。\n故人遗叹在，秋后有惊鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苗户部挽词 其二","author":"徐积","text":"已矣公归矣，哀哉将奈何。\n黄宫无处乐，玄冕有谁歌。\n南越生祠久，东川画像多。\n孤穷亲党在，共立碣嵯峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林漕挽词 其一","author":"徐积","text":"国士青云器，儒林合抱松。\n羽仪丹穴凤，头角剑津龙。\n玉笋班虽贵，皇华使愈恭。\n人亡其政在，尚可访遗踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林漕挽词 其二","author":"徐积","text":"一梦无回处，庞眉坐柏庭。\n几时逢白日，万事付哀铃。\n画翣行须缓，黄宫到便扃。\n松陵诗莫和，恸哭不堪听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蔡学士挽词 其一","author":"徐积","text":"斗分星孤陨，虞庭凤不还。\n金龙抛使节，玉笋误朝班。\n世德元明后，家声王谢閒。\n国功图未卒，归老负江山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蔡学士挽词 其二","author":"徐积","text":"命也虽亡矣，但须铭此坟。\n朝中寻故事，江外访遗文。\n远思归流水，高风寄白云。\n忠魂在斯否，义亦不忘君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蔡学士挽词 其三","author":"徐积","text":"旧业儒编富，新装使橐空。\n洁身辞白日，随柩载清风。\n义与人心在，名须江水穷。\n诸山同岘首，有子胜羊公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蔡学士挽词 其四","author":"徐积","text":"且止明旌住，玄堂即闭关。\n素丝蒙柩往，白垩洗车还。\n身后千诗在，生前万事閒。\n松陵哀怨客，来吊自湖山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苏子瞻挽词 其一","author":"徐积","text":"起起公终矣，斯文将奈何。\n新书传异域，旧隐寄东坡。\n直道谋身少，孤忠为国多。\n死生公论在，高义山峨峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苏子瞻挽词 其二","author":"徐积","text":"白玉棺无价，青囊葬有书。\n奔星来启路，走电去随车。\n官是修文号，人同上行居。\n峨嵋山下客，谁是跨鲸鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":43244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]