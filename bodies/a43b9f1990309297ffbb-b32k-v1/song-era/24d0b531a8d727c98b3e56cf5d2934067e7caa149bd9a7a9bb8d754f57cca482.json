[{"title":"题义节夫人传 其二","author":"吴说","text":"丈夫效死以成人，何事临危反爱身。\n有腼闺门全节义，伤今思古泪沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题梁王寺清辩大师房","author":"吴说","text":"云收雾落天围净，乞与游人眼界宽。\n独恨不当新雪霁，月明来此倚阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中元夕","author":"吴说","text":"忆昔观灯夜，维舟天汉湾。\n千官环凤辇，万炬转鳌山。\n异县方营窟，佳辰独掩关。\n悲凉追往事，华发坐来斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙都山","author":"吴说","text":"佳住从来说鼎湖，兹游直欲到清都。\n参天玉笋千寻许，堕地金莲十丈无。\n江观便思眠一柱，海山今喜识方壶。\n直须买取鹅溪绢，要画沧洲水墨图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次廉布书事三首呈郎中机宜诗韵 其三","author":"吴说","text":"栖遁云岩下，无人到此边。\n阶庭穿蚓穴，窗户蠹蜗涎。\n寂寞春将老，淹留月再弦。\n羁愁知几许，素发挽华巅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次廉布书事三首呈郎中机宜诗韵 其一","author":"吴说","text":"当代青云士，皆言子独贤。\n异时犹未遇，多难更堪怜。\n妙契环中趣，饱参方外禅。\n海涯孤绝处，谁识孝廉船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次廉布书事三首呈郎中机宜诗韵 其二","author":"吴说","text":"区宇半荆棘，干戈犹未休。\n屡空无计奈，多病不禁愁。\n农具应须办，朝簪便合投。\n全家耕谷口，一饱更何忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬次李辰甫所寄三首 其三","author":"吴说","text":"扁舟东下初乘兴，明月南飞竟失群。\n田父语言时近道，世人嘲笑尚论文。\n九山敛气横寒野，一坞朝阳聚暖云。\n胜处借人教暂看，后来何必问灵氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题清芬阁","author":"吴说","text":"乃祖飞英标万古，后来奕叶盛三吴。\n传家孙达吾何慊，配食子陵德不孤。\n秀句至今辉简表，故山从昔锁松梧。\n他年我欲修清供，一盏寒泉一束刍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"避地白岩山中书怀","author":"吴说","text":"胡虏凭陵甚，长驱青海边。\n携家遭困顿，忧国愤迍邅。\n不省岁月换，徒惊花草鲜。\n到头苏息否，洒泪问苍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬次李辰甫所寄三首 其二","author":"吴说","text":"桐花竹实几时生，桑野秋枯茧未成。\n肯信饥寒能累道，唯馀寂寞许寻盟。\n年颜已愧神仙事，江海难忘故旧情。\n何日往来同井陉，清谈清坐到天明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬次李辰甫所寄三首 其一","author":"吴说","text":"近知尽室入烟霞，儿女甘贫惯食鲑。\n方外何人差可友，岁阑底处定为家。\n江城潮盛漫秋卤，驿道风高捲霁沙。\n子拾堕樵归未得，能无借地种桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吴说","text":"山峡名标第一楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题万寿圆觉院 其二","author":"吴钢","text":"地偏境静人无事，雨后风柔物可情。\n山鸟定知琴意好，倚花浑不作春声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题万寿圆觉院 其一","author":"吴钢","text":"梵室香飘隔竹闻，壁间肆笔烂奎文。\n山深翠辇经行处，犹卧从龙数点云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题褒亲崇寿寺","author":"吴钢","text":"坳径石?牙，梅枝碍竹斜。\n旧封妃子墓，残照觉王家。\n亭砌旋风叶，岩流出洞花。\n饱参尘世味，得似野僧茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏暑","author":"吴倧","text":"旧闻有西山，松风六月寒。\n明当整襟屦，舒笑青云端。\n招手尘外人，瀹泉采芳荪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"吴倧","text":"杨柳池深鱼乍出，桑麻土润燕初归。\n一年春草风前绿，万点桃花雨后红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题招提院静照堂","author":"吴振","text":"古刹深沉一水边，清虚疑是翠微间。\n门前滚滚红尘闹，堂上翛翛白日閒。\n燕坐不知增夏腊，冥心安在更云山。\n静中别有真消息，于此谁何合往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行","author":"吴浚","text":"溪水泠泠清见沙，镜中历历走鱼虾。\n树红霜后无多叶，梅入冬来第一花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"采莲曲","author":"吴浚","text":"见莲知菂实，寻藕□丝长。\n六月天边路，何时结得霜。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客中","author":"吴浚","text":"断雁啸云天试霜，客中何事不凄凉。\n玉梅约住春风信，更让黄花半月香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日","author":"吴浚","text":"画堂帘箔碧笼葱，午梦模糊燕语中。\n微雨嫩晴天似醉，闹红吹上海棠风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词","author":"吴浚","text":"是处箫声破碧云，翠梅依旧锁闲春。\n东风不负庭前柳，只负年年看柳人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中即事 其二","author":"吴浚","text":"林叶声乾山影瘦，斩新霜气欲无秋。\n菊花犹护西风局，自在篱根梦蓐收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中即事 其一","author":"吴浚","text":"露白霜清晓气浮，菊花满意为谁秋。\n西风毕竟真廉吏，狼藉金钱散不收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一雨","author":"吴浚","text":"一雨千红尽，春风奈老何。\n暝云含楚思，新涨动吴波。\n天地端倪出，朝廷俊杰多。\n马蹄江上路，吾意独蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早发","author":"吴浚","text":"颢气澄初晓，清江百丈秋。\n桨摇山势动，船带日光流。\n禽噪应知曙，鱼沉若避钩。\n闲身非复昔，征棹莫迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重过瑞金江","author":"吴浚","text":"水瘦滩声健，天寒霜意新。\n犬牙舟过石，鱼贯路行人。\n到眼心应识，回头迹易陈。\n时平刀剑息，失喜问遗民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄萧冰崖练橘里黄立轩","author":"吴浚","text":"破梦金川月，回头玉树风。\n烟村涵暮紫，霜叶颤晴红。\n谋国诸侯在，忘年古道同。\n乾坤云一片，吾意未终穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"越王台","author":"吴浚","text":"越王歌舞地，南国古繁雄。\n水阔山光迥，天低海气通。\n千舠民蛋雨，一塔贾胡风。\n欲问兴亡事，松声自半空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋联句","author":"吴浚","text":"棘闱受得树凉多，耿耿孤灯奈夜何。\n后夜中秋可无月，雨工先为洗银河。\n中秋此去日无多，笑问青天雨若何。\n旧日仙槎应好在，西风吹送上天河。\n雨到中秋易得多，素娥争奈漏天何。\n青天四壁漫漫夜，星魁谁人见渡河。\n雨声酿得客愁多，欲赏清秋作计何。\n莫唱刘郎黄鹤句，西风举目异江河。\n三台高处五云多，如此好天良夜何。\n曾记长淮看月否，玉人何处唱西河。\n月下敲诗得句多，诗成句句敌阴何。\n夜凉不禁诗肠渴，欲作长鲸吸九河。\n风捲玄云已不多，倚栏试问夜如何。\n玉轮拟把长绳系，生怕孤蟾没入河。\n月魄分它日影多，有盈有阙却缘何。\n世人错认娑罗树，半是青山半是河。\n孤蟾老矣阅人多，玉斧如霜不敢何。\n何似长圆如此夜，放教全影看山河。\n白凤威迟舞态多，三郎此际意如何。\n霓裳一曲君休听，曾引胡尘暗两河。\n月中桂子种来多，知得天香定属何。\n袍色明年沾柳汁，好寻年少到三河。\n乾坤清气在梅多，梅属能诗水部何。\n惜不移来月中种，却教疏影入秋河。\n东隅西极往来多，玉免如今奈老何。\n瑶鉴一奁尘不染，祗应夜夜浴明河。\n栏槛前山夜景多，一声长啸入亡何。\n露花点点明秋叶，坐到楼西斗插河。\n琼楼玉宇更寒多，天上不知今夕何。\n谁遣银潢倾作酒，一时浇我舌悬河。\n梯上秋旻路不多，刚风奈此浩然何。\n瑶光冷逼萧萧发，一叶莲舟稳泛河。\n桂香多处月明多，如此中秋有几何。\n堂上文奎炯如月，修廊灯火粲星河。\n夕佳朝爽入诗多，待不吟诗可奈何。\n过却中秋有公事，莫将风月付谈河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太乙真人画像","author":"吴浚","text":"真人读何书，一叶凌浩溔。\n不见此舟轻，但觉天地小。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安期生","author":"吴浚","text":"安期耸身坐，挥斥游太极。\n若遇谪仙人，鲸背分半席。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六言","author":"吴浚","text":"草间路六七里，溪上梅三四花。\n日落鸟声何处，山空犬吠谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"璜源宗人珏寿庆楼","author":"吴浩","text":"吾宗培世德，盛事褒一门。\n仰颜有寿母，俛目见子孙。\n平生青云器，威凤宜孤鶱。\n脱然舍荣爵，回车息深村。\n服勤养堂中，身已大父尊。\n戏綵时趋庭，奉舆日涉园。\n所至畴接武，顾见贻厥繁。\n今年结高楼，长少数凭轩。\n群星环婺女，列象如可扪。\n云傍檐楹飞，山邻窗几蹲。\n往来乌鹊喜，回互竹木蕃。\n良辰风日佳，容与同芳樽。\n循陔度雅乐，清响闻天阍。\n男儿贵恢豁，楼记聆绪言。\n谷共里人饱，书从寒士翻。\n善源深复深，河流出昆崙。\n吾颂殊未艾，玄来更瑶琨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居","author":"吴涛","text":"村翁习性不浮华，只种桑麻不种花。\n闻道野梅开欲遍，好分春色过山家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲春","author":"吴涛","text":"雨馀寒气浅，园林作春媚。\n不知海棠花，新来著花未。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"在杭日作","author":"吴涛","text":"时乖事转拙，端居徒含情。\n不似阶前草，春来随意生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春","author":"吴涛","text":"游子春衫已试单，桃花飞尽野梅酸。\n怪来一夜蛙声歇，又作东风十日寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"吴涛","text":"文书堆里形骸苦，竹木阴中日月閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"吴涛","text":"窗间常作三独坐，琴上时弹一再行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"吴涛","text":"心缘黄纸红旗动，气为青云白石降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青溪晚霁","author":"吴涟","text":"天晚雨初霁，隔溪闻碓舂。\n山僧归夜月，幽鸟落长松。\n风静砧声急，花攲露气重。\n良宵思沅芷，尊酒话从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过盘山","author":"吴涧所","text":"盘回六七里，天色冷飕飕。\n石壁无平地，山云隔远洲。\n清笳悲送日，老卒病眠秋。\n行望酒家出，青山映碧流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵宰别业","author":"吴涧所","text":"几树柳阴合，空阶一半遮。\n破琴长在壁，老鹤不离家。\n客至时供茗，官閒吏管花。\n有时成独步，门外看蜂衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千顷山 其二","author":"吴珩","text":"千顷山中月，三黄顶上云。\n相看无一语，今日喜逢君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千顷山 其一","author":"吴珩","text":"松桧阴中六月清，异花灵草不知名。\n路从琼液山前过，人在水晶宫上行。\n千尺翠岚分月色，一轩寒籁动潮声。\n登临不厌跻攀峻，贪看云从舄下生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"法会院","author":"吴珩","text":"地占金山胜，泉分银汉流。\n杉篁能护翠，猿鹤似惊秋。\n祗恨登临晚，宁辞取次游。\n列峰饶远秀，不惜上层楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梵安院","author":"吴珩","text":"山腰小径细于绳，山鸟关关喜弄晴。\n黄菊有情留客醉，白云无事伴人行。\n野流合处堪分字，草药拈来欲问名。\n回首渡头诗思逸，渔舟一笛晚风清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉楼春 寿尊长","author":"吴益","text":"玉楼春信梅传早。\n三八芳辰阳复后。\n称觞喜对一椿高，莱庭双桂森兰茂。\n惭无好语为公寿。\n富贵荣华公自有，请歌诗雅祝遐龄，永如松柏如山阜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒林庙","author":"吴秘","text":"高天之有文，星辰艳穷碧。\n厚地之有文，草木秀野色。\n草木既无辞，星辰亦难测。\n岂侔人之文，五经为艺极。\n五经主者何，岂非至圣力。\n三才久虚位，待我先师宅。\n秘亦穷经者，自谓入阃阈。\n天地无逃数，世人犹自惑。\n代移文不移，宜在弟子职。\n薰香达诚悃，滴酒沥胸臆。\n瞿然见威容，长林耸坟侧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吴耕","text":"钓龙台古临沧海，浴凤池高入紫烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"合肥怀古三首 其二","author":"吴资","text":"曹公教弩台，今为比丘寺。\n东门小河桥，曾飞吴主骑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"合肥怀古三首 其三","author":"吴资","text":"幼度提晋师，胡卒惊鹤唳。\n城外军屯垒，可数不可计。\n至今风雨夜，鬼哭杂异类。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44825,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"合肥怀古三首 其一","author":"吴资","text":"合肥一都会，世号征战地。\n我来值明时，不识兵革事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44826,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"炼丹台","author":"吴通","text":"我寻陶隐居，山中多古迹。\n青障抚清泉，白云抱苍壁。\n入经碎玉桥，便是幽人宅。\n仙人昔炼丹，嶙嶒一卷石。\n俯视直千寻，凌空高百尺。\n两水落沧洲，滔滔渺无极。\n拂石坐片时，万籁俱寥寂。\n但听松风声，耳边生淅淅。\n长啸白云飞，山雨催诗亟。\n诗成寄阿谁，赏识惟贞白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44827,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吴逢道","text":"乱时曾作将军寨，平世今为佛氏宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44828,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名 其二","author":"吴康","text":"凌空蜂翼递香来，惊破蜜房幽梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名 其一","author":"吴康","text":"试问海棠健否，海棠虽似，减清香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岩岭憩亭","author":"吴敏","text":"蝉声满秋树，云影护晴雷。\n独坐西风久，半空飞雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题山光寺壁上墨竹","author":"吴敏","text":"绿发青衫旧竹君，墨卿挥拂更清新。\n断枝活叶风萧瑟，想见凌云百尺身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题古寺","author":"吴敏","text":"古木霜根重，残僧雪顶深。\n栋梁元剥落，香火半消沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"射鹗山","author":"吴敏","text":"东山空阔原野平，吴王养鸡筑高城。\n秋天饥鹗未饱食，侧翅下攫殊无情。\n守城壮士心孔恶，旦夕窥兹捕鸡鹗。\n雕弓一展羽箭发，鹗也时从半空落。\n山人学射艺渐精，遂使山无鹗鸟鸣。\n却思勾践侵吴日，何不令之射越兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠吴正仲","author":"吴敏","text":"先生古人风，文字祖西汉。\n不令万钱食，亦合五花判。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"吴敏","text":"人事少陵诗外见，人烟子厚记中行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"吴敏","text":"万里西来客，溪山先有名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"吴敏","text":"回首风光横万里，他年应记柳侯城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"吴敏","text":"醉中掷笔金銮殿，睡起鸣笳铁瓮城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名 其四","author":"吴敏德","text":"御符争带，更有天师神咒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山庵睡起","author":"吴晦之","text":"策蹇寻幽过草堂，困来攲枕卧禅床。\n鸟啼花落东风里，睡起不知春昼长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]