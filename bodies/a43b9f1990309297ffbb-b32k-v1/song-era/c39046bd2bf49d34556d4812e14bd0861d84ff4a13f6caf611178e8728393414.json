[{"title":"踏莎行 跋伯时弟抚松寄傲诗集","author":"张炎","text":"水落槎枯，田荒玉碎。\n夜阑秉烛惊相对。\n故家人物已无传，一灯却照清江外。\n色展天机，光摇海贝。\n锦囊日月奚童背。\n重逢何处抚孤松，共吟风月西湖醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏莎行 郊行，值游女以花掷水，余得之，戏作此解","author":"张炎","text":"花引春来，手擎春住。\n芳心一点谁分付。\n微歌微笑蓦思量，瞥然抛与东流去。\n带润偷拈，和香密护。\n归时自有留连处。\n不随烟水不随风，不教轻把刘郎误。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏莎行","author":"张炎","text":"柳未三眠，风才一讯。\n催人步屧吹笙径。\n可曾中酒似当时，如今却是看花病。\n老愿春迟，愁嫌昼静。\n秋千院落寒犹剩。\n卷帘休问海棠开，相传燕子归来近。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉落魄/一斛珠 题赵霞谷所藏吴梦窗亲书词卷","author":"张炎","text":"镂花镌叶。\n满枝风露和香撷。\n引将芳思归吟箧。\n梦与魂同，闲了弄香蝶。\n小楼帘卷歌声歇。\n幽篁独处泉呜咽。\n短笺空在愁难说。\n霜角寒梅，吹碎半江月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉落魄/一斛珠","author":"张炎","text":"柳侵阑角。\n画帘风软红香泊。\n引人蝴蝶翻轻薄。\n已自关情，和梦近来恶。\n眉梢轻把闲愁著。\n如今愁重眉梢弱。\n双眉不画愁消却。\n不道愁痕，来傍眼边觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"张炎","text":"楼上谁将玉笛吹。\n山前水阔暝云低。\n劳劳燕子人千里，落落梨花雨一枝。\n修禊近，卖饧时。\n故乡惟有梦相随。\n夜来折得江头柳，不是苏堤也皱眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜叶飞 悼澄江吴立斋南塘、不碍、云山，皆 其亭名","author":"张炎","text":"故园空杳。\n霜风劲、南塘吹断瑶草。\n已无清气碍云山，奈此时怀抱。\n尚记得、修门赋晓。\n杜陵花竹归来早。\n傍雅亭幽榭，惯款语英游，好怀无限欢笑。\n不见换羽移商，杏梁尘远，可怜都付残照。\n坐中泣下最谁多，叹赏音人少。\n怅一夜、梅花顿老。\n今年因甚无诗到。\n待唤起清魂□，说与凄凉，定应愁了。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜叶飞 毗陵客中闻老妓歌","author":"张炎","text":"绣屏开了。\n惊诗梦、娇莺啼破春悄。\n隐将谱字转清圆，正杏梁声绕。\n看帖帖、蛾眉淡扫。\n不知能聚愁多少。\n叹客里凄凉，尚记得当年雅音，低唱还好。\n同是流落殊乡，相逢何晚，坐对真被花恼。\n贞元朝士已无多，但暮烟衰草。\n未忘得春风窈窕。\n却怜张绪如今老。\n且慰我留连意，莫说西湖，那时苏小。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"露华 碧桃","author":"张炎","text":"乱红自雨，正翠蹊误晓，玉洞明春。\n蛾眉淡扫，背风不语盈盈。\n莫恨小溪流水，引刘郎、不是飞琼。\n罗扇底，从教净冶，远障歌尘。\n一掬莹然生意，伴压架酴醾，相恼芳吟。\n玄都观里，几回错认梨云。\n花下可怜仙子，醉东风、犹自吹笙。\n残照晚，渔翁正迷武陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小池","author":"张炜","text":"恰恰方池款竹斋，风摇窗扇掩还开。\n无端半夜疏荷雨，更带秋声入梦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"马塍","author":"张炜","text":"水拍田塍路半斜，悄无人迹过农家。\n春风自谓专桃李，也有工夫到菜花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书云萍录 其二","author":"张炜","text":"杰阁峥嵘据柳湾，段侯江令梦魂间。\n我来不问兴亡事，傲立薰风看蒋山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书云萍录 其一","author":"张炜","text":"聚若浮萍散若云，江湖姓氏总相闻。\n何烦爵里重铺叙，只倩梅花举似君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书向耐轩","author":"张炜","text":"芗林一谱传清白，以耐名轩更出奇。\n修竹护窗梅夹路，岁寒消息独君知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书和靖故居","author":"张炜","text":"童鹤饥癯古屋低，孤山犹忆数联诗。\n先生更有清高处，未必梅花尽得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹所","author":"张炜","text":"数干当櫩眼便青，翠阴千亩况为邻。\n休贪冷地闲风月，好作清朝劲节人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观王氏山亭旧基","author":"张炜","text":"山亭碍月不容留，拆去危基立故丘。\n落日倚筇舒望眼，片帆钩破一江秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀玉山人过越江","author":"张炜","text":"玉石纷纷叹混淆，君今怀璞在吟袍。\n快帆闻指西陵去，识眼相逢价自高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"花飞","author":"张炜","text":"花飞梁苑春消后，月落秦楼夜断时。\n一点不如归去恨，阿谁说与杜鹃知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岩桂","author":"张炜","text":"天街清晓似香林，压担秋花塞市心。\n总被时人低价得，苇帘茅屋尽黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"知果寺参寥泉","author":"张炜","text":"破屋伶俜断碣横，剥苔彷佛见题名。\n自从人去西湖后，一掬寒泉便不清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试翁寿乡贡馀墨","author":"张炜","text":"万杵炼麋摇夜月，一圭分剂割晴云。\n雪腴半展陶泓净，改罢新诗写赠君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试童岩野墨","author":"张炜","text":"杵麋烘麝样新翻，蟾玉轻磨漆未乾。\n合走春风供化笔，肯随清誉到诗坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鞦韆 其二","author":"张炜","text":"綵索高悬锦柱头，女郎花下竞风流。\n垂杨影里曾窥见，飞起娇红一点愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荐菊泉","author":"张炜","text":"近来湖上风光改，古迹三贤亦就迁。\n独有菊泉能定力，岁寒坚守此山前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸥鹭世界","author":"张炜","text":"閒飞芦苇疑成序，独立菰蒲似不群。\n愁思无边烟水阔，画家诗境合平分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿洞霄虚白房","author":"张炜","text":"列岫宗奇观，藤萝结翠门。\n隔岩龙唤雨，云走半窗昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄简崇禧司徒高士","author":"张炜","text":"袖惹天香隐故庐，一山猿鹤伴清虚。\n有人来叩神仙诀，就剪晴云问起居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪窗惠海棠","author":"张炜","text":"驱奴分送海棠花，袅娜枝头剪碎霞。\n插向铜壶当爱惜，且留春色在吾家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"窗底","author":"张炜","text":"日炙虚窗暖欲春，窗前椒蕾破梅英。\n朦胧困眼看书倦，蓦听蜂儿扑纸声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋竹宫羽人芸谷","author":"张炜","text":"昔年摘叶更寻枝，踏遍山巅与水涯。\n今日华阳亲荐得，玉苗仙草映灵芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简赵真休","author":"张炜","text":"曾向诗坛夺锦袍，至今湖海诵风骚。\n何如放下浑无事，句不惊人意更高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翠微亭","author":"张炜","text":"万木轮囷卧岁寒，一声啼鸟应空山。\n兴来小立危栏畔，身在碧云霄汉间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题问坐主梅隐","author":"张炜","text":"万点春风吐白云，孤芳绕屋占云根。\n幽闲中得幽闲处，暗水流香紧闭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题村居 其一","author":"张炜","text":"村居何识见时节，春去春来自一年。\n谁与儿童话寒食，也将杨柳插门前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题村居 其二","author":"张炜","text":"数舍茅茨簇水涯，傍檐一树早梅花。\n年丰便觉村居好，竹里新添卖酒家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题适安隐居","author":"张炜","text":"萝蔓纫岩竹翳闾，天然幻出隐人居。\n客来欲问山中趣，挂壁丝桐插架书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缴回友人转示诗卷","author":"张炜","text":"拾得骊珠不秘藏，来寻识眼共平章。\n临风一盼留书架，夜夜豪光射竹房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠制墨羽人葛太玉","author":"张炜","text":"回公胶法不轻传，太玉知机合伴仙。\n安得翠云蜚象管，书邀风月上蛮笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠梁弥仙","author":"张炜","text":"笑侧华阳一幅巾，碧眸苍鬓貌如春。\n罗浮洞里通勾曲，疑怪相逢似故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"为徐叔刚赋达斋","author":"张炜","text":"男儿劲正气，期欲展经纶。\n场屋求程艺，山林多隐人。\n学优宜必仕，道在不妨贫。\n快举摩霄翮，联翩立要津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至","author":"张炜","text":"冷笑书云上鲁台，乖祥俱向眼中猜。\n阴逢剥处自阳复，否到极时须泰来。\n霜剪草茸寒欲断，日烘梅粉暖全开。\n吾侬唤作寻常事，坐看儿童拜节回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归耕","author":"张炜","text":"纡青拖紫信天缘，才说归耕自乐然。\n二顷良田供活计，一锄风雨饱丰年。\n妻条桑叶催蚕起，儿脱莎衣傍犊眠。\n不是此心甘隐退，为贪农隙理残编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再游玉泉观金鱼","author":"张炜","text":"曾见金鳞已十年，重来鬐鬣尚凄然。\n忍从虾蟹常为侣，好作蛟龙飞上天。\n古木耸云尊梵宇，灵源疏滴润农阡。\n商霖已得真贤佐，旱暵何劳吁玉泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟离和州别史君","author":"张炜","text":"眷客留连久，分携各惘情。\n橹摇江水碧，城凸晓烟明。\n衣薄寒先觉，心平浪不惊。\n钟山青在睫，归兴逐云生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观集芳园","author":"张炜","text":"千步入修廊，犹闻碧雾香。\n风翻宫襭紫，菊染御枹黄。\n亭宇丹青老，笙歌岁月长。\n上皇临幸少，书圃自翱翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访刘山人隐居","author":"张炜","text":"步入山回处，茅櫩隐士家。\n远峰奔渴骥，曲径袅修蛇。\n纯翠千茎竹，交红一架花。\n客来费清供，汲水自煎茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纸阁","author":"张炜","text":"纸阁新装褫，青毡喜尚存。\n翠圆垂彩络，红朵粲陶盆。\n藏密寒无著，融真体自温。\n夜深谁晤语，花缀短檠昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛丑长至","author":"张炜","text":"物意通人事，阳生一脉天。\n梅虽搀腊破，柳已得春先。\n袜颂趋时献，台云取巧传。\n所须惟饱耳，延颈看丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辛丑长至后九日其夕大风","author":"张炜","text":"朝家祷琼瑞，天忽赐雄风。\n静听耳轰鼓，冻眠身屈弓。\n把茅吹卷后，矮柱兀摇中。\n拶晓怪威息，太阳升海东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学吟","author":"张炜","text":"骚豪矢口便成诗，全异推敲鍊句迟。\n一字下平摇不动，数联生就稳难移。\n池塘春草英灵处，水月梅花颖悟时。\n我亦学吟功未进，每将此理扣心师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚郊行有怀","author":"张炜","text":"行春车马渐无多，閒步郊原玩物华。\n已角未腴阴径笋，似香非韵别篱花。\n子规饶舌空催客，蛱蝶贪游不恋家。\n常记湖边同咏赏，归鞍扶醉月笼纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂","author":"张炜","text":"痴儿总向月中求，不信人间剩有秋。\n万点尽垂金粟颗，一枝宜上玉搔头。\n清香已压龙涎倒，堕萼宜将蚁醑浮。\n吟得诗成对花举，不须招客费赓酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯友人赴靖州通道尉","author":"张炜","text":"竹风荷气约朱明，路入渠阳暑尚清。\n马耳萧萧悬堕月，鸡声喔喔勉修程。\n何拘梅政誇年少，即泛莲漪赞老成。\n莫把西湖浪吟笔，楚山空阔更关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄任居士","author":"张炜","text":"师默修禅观，龙升虎自閒。\n眼开俱是道，心定亦无山。\n瘿木床三尺，蓬茅屋半间。\n鍊成真积力，策景到瑶关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄武冈宰宋雪岩","author":"张炜","text":"柳下分携须影苍，好风吹梦过都梁。\n诸蛮帖化花阴静，一骑飞尘荐墨香。\n书就几曾逢驿使，公馀应不冷奚囊。\n云情鹤态元如旧，应倚株梅忆锦乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪窗自西陵以新诗并水仙见惠","author":"张炜","text":"洛浦风流几隔年，江南重见色依然。\n根从野卉同分品，香与梅花可并肩。\n葩白中黄饶蕴藉，腊梅春暖肆芳妍。\n殷勤并挟新诗送，领略丰姿夜不眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"骑马","author":"张炜","text":"陌上骑骢马，朱缨耀日丹。\n袖欺鞭竹瘦，靴入?金寒。\n毳帽兜貂鼠，茸裘织雁团。\n戎装吾亦可，初不碍儒冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒月郊居","author":"张炜","text":"心远郊居閒亦胜，砖炉纸阁类僧房。\n倦抽乐府翻吴韵，独对骚经味楚羌。\n句到夺将袍锦赤，功成消得带金黄。\n相逢每惜芝兰种，犹在潇潇水竹傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"援藤","author":"张炜","text":"援藤穿藓扣云扉，清足高标显翠楣。\n风月任随时事改，江山不被世情移。\n虽无白酒留君醉，却有青编可自怡。\n朱紫纷纷徒说贵，隐居真乐几曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游洞霄栖真洞","author":"张炜","text":"笋舆摇兀到山前，就宿栖真古洞天。\n老木倚风清鹤唳，湿云拖雨护龙眠。\n尘凡夐出几千仞，足迹经由已半仙。\n到此岂容闲咏笔，重来知复是何年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游蒋山","author":"张炜","text":"家世帝王州，钟山耻未游。\n卷书趍幕府，散步入林丘。\n泉湃悬崖丑，云闲古树愁。\n草堂今在否，更欲展诗眸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上次韵","author":"张炜","text":"湖边旧好即潘杨，惜不同舟舣岸傍。\n竹叶肯陪三揖醉，荷花分受一襟凉。\n雪壶色净冰心爽，金缕歌停玉骨香。\n客散楼台收晚照，独看西子学吴妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢友人惠笔","author":"张炜","text":"翰墨场中浪得名，近来研席愧尘侵。\n紫怀心素锋铓健，红束腰身管套深。\n珍重故交分数种，胜于野老获千金。\n便当拂茧晴窗下，剩写新诗倩鹤吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢朱高邮惠湛卢诗集","author":"张炜","text":"门掩飞花欲曙时，起来忽接湛卢诗。\n清新尽夺冰霜气，婉丽浑无脂腻辞。\n题品江山今已了，登庸廊庙不宜迟。\n高沙父老休专惠，宣室今兴夜半思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谦斋席间赠苔矶","author":"张炜","text":"因合谦斋饮，新编得细哦。\n髯掀天地阔，足历水云多。\n才敏逢青眼，家成隐翠萝。\n近闻诗债盛，老退欲停戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简任新恩","author":"张炜","text":"自别梧姿二十年，情亲何暇雁传笺。\n深疑楚泽蟠胸次，不放吴霜点鬓边。\n我忆花间听乐府，君嗟柳下度吟鞭。\n于今又遂衔杯乐，湖海相逢岂偶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简耕月","author":"张炜","text":"一犁将暝色，月下自耕耘。\n为适能吟趣，非干力穑勤。\n草芟心地阔，苗揠世情分。\n莘野如膺诏，新诗就献君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题六和塔秀江亭","author":"张炜","text":"秀江亭上驻吟怀，苔藓轩窗四面开。\n潮怒挟风吹海立，橹声摇月下天来。\n浮沤世事等出没，泛梗羁人几去回。\n待写篇诗纪游迹，路迢不奈马频催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题友人自方家峪迁居北山栖霞岭","author":"张炜","text":"素喜华居逼禁闉，北山何事又移文。\n来依岳麓千章翠，閒却南屏一片云。\n招月咏梅君自乐，煮泉瀹茗客同分。\n未随燕雀伸忱贺，先剪溪藤述寸芹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":54501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]