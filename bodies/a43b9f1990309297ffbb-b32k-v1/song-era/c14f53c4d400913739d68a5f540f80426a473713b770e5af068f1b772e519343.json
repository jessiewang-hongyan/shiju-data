[{"title":"夏日简王尉","author":"方岳","text":"松萝为屋芰荷衣，只与凫鸥共钓矶。\n雌霓横溪遮雨断，雄风吹雨作尘飞。\n山林谁可閒来往，世俗难论真是非。\n颇喜雪舟王逸少，夜凉吾欲扣斋扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"息轩","author":"方岳","text":"种田尽办瓮头春，倦矣风波谩损神。\n万事不偿双短鬓，百年等是一微尘。\n祇今蜗战谁知误，凡我同盟人认真。\n梦亦妄生颠倒想，何如明月自由人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽曹侍郎 其三","author":"方岳","text":"笔橐上严宸，真为侍从臣。\n袖中周礼在，言外孔堂春。\n亟草閒居赋，宁惭勇退人。\n空馀文作冢，书带已成尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽曹侍郎 其一","author":"方岳","text":"诸老各凋零，公乎独典刑。\n草堂春得句，雪户夜谈经。\n岁月头从白，江山眼共青。\n斯文今已矣，天亦自冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽曹侍郎 其四","author":"方岳","text":"我昔识平川，初鸣偃室弦。\n议题春雨夜，探榜晚秋天。\n两柳今安在，枯梅画不传。\n向来诗酒地，独立意茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽曹侍郎 其二","author":"方岳","text":"一角玉麟寒，何心獬豸冠。\n满腔秋沆瀣，披腹玉琅玕。\n讲入经三昧，书成义不刊。\n阳城遗碣在，老泪不胜弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽彭制机 其二","author":"方岳","text":"山中亦云乐，蔬甲手耘芟。\n面熟鸟窥户，眼生云穴岩。\n树蟠根可坐，路碍石休劖。\n每笑陶弘景，犹将隐结衔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽彭制机 其一","author":"方岳","text":"场屋峥嵘气，虽平岂易干。\n江湖双鬓古，师友一灯寒。\n戍柝犹传檄，渔烟自钓竿。\n极知书有种，吾道未凋残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽谢公王","author":"方岳","text":"白鹿遗书山泽癯，归来花木尽堪娱。\n功名之梦晦庵晦，礼乐其家迂叟迂。\n雪屋一灯春夜半，竹山千古暮云孤。\n雨寒愁绝兰亭禊，灵寿空馀九老图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽懒庵处士","author":"方岳","text":"万事从吾懒，庵居隐者家。\n酒深牵率月，诗办事治花。\n健犊閒耕具，轻鸥忆钓槎。\n归来谁晤语，野艇渡寒沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"效茶山咏杨梅","author":"方岳","text":"五月梅晴暑正袢，杨家亦有果堪攀。\n雪融火齐骊珠冷，粟起丹砂鹤顶殷。\n并与文园消午渴，不禁越女蹙春山。\n略如荔子仍同姓，直恐前身是阿环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"斋宿学宫","author":"方岳","text":"竹外一灯青，残书伴古厅。\n叶乾闻雨急，山近觉岚腥。\n多病身为累，无心梦亦灵。\n明朝有痴事，须到采芹亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旅思","author":"方岳","text":"索米长安鬓易丝，向来书剑亦奚为。\n无诗传与鸡林去，有赋羞令狗监知。\n两戒山河饶虎落，五湖烟水欠鸱夷。\n喜无光范三书草，此段差强韩退之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠 其一","author":"方岳","text":"半吐柔芳暖正妍，趁晴何不试笼鞭。\n玉环醉矣春无赖，金屋贮之人孰贤。\n花比红儿谁作谱，诗传娇客已成编。\n湘帘燕子人家月，一笑春风不计年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠 其二","author":"方岳","text":"黄州不识春风面，哙伍漫山桃李枝。\n银烛夜深妆额褪，锦屏睡足鬓丝垂。\n半醒半醉凌晨酒，几雨几晴寒食时。\n莫怨家人多命薄，缘愁却入老坡诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠盛开而雨 其一","author":"方岳","text":"闭门十日雨淋漓，洗尽红香了未知。\n才一霎晴齐睡去，几何人见半开时。\n世无解语玉超脱，春欲负予金屈卮。\n自是晦明天不定，非干工部欠渠诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠盛开而雨 其二","author":"方岳","text":"醉红睡去不胜扶，遮尽丹荑盖绿芜。\n四立壁成花世界，一年春在锦屠苏。\n山中富贵遽如许，诗外豪奢有是夫。\n已与妇谋须斗酒，不知明日定晴无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"热 其一","author":"方岳","text":"脱巾无计避炎熇，安得长风上泬寥。\n自浴寒泉眉子砚，时浇苍石胆瓶蕉。\n老来转觉身为累，贫甚岂为山可樵。\n坐想草亭新竹上，一林碎月玉翛翛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"热 其二","author":"方岳","text":"借使长空插羽翰，人间无地著高寒。\n一丘自作清凉国，两曜谁司赤白丸。\n老去诗犹堪杖屦，快哉风亦懒衣冠。\n贵人要与常人别，宝带围腰大耐官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"热甚有怀山间","author":"方岳","text":"终是山间别，寒泉在脚边。\n戏鱼争美荫，啼鸟破佳眠。\n山寂夜如水，僧閒日抵年。\n欲来来未得，戽斗救枯田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留别","author":"方岳","text":"唤得篷船载幅巾，岛烟画出渭城春。\n匆匆笑语情何限，草草杯盘意甚真。\n经岁别家千里梦，浮生寄我一鸥身。\n舟人报道潮平早，举白浮君莫厌频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病目","author":"方岳","text":"病眸未老已昏眵，近废秋堂几卷书。\n世事难看宁闭却，人生自扰正纷如。\n棋声久避灯前雨，菜本犹堪月下锄。\n面壁且容趺足坐，此心雅与俗人疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起木犀已谢","author":"方岳","text":"一年秋是桂花开，谁道今年负酒杯。\n造物小儿真恶剧，痴顽老子久摧颓。\n清风明月不常有，溪友山翁试与来。\n夜寂尚怜诗骨在，时能引手作敲推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"被盗","author":"方岳","text":"鼠辈真成误，吾墉底用穿。\n近诗贫有藁，旧物冷无毡。\n辇路沈秋柝，干掫老禁堧。\n故应萑苇外，薄暮不堪船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪吴总侍集研山用赵端明送行韵","author":"方岳","text":"烟波画出暮江天，著我芦花明月船。\n官满只称前进士，路贫休问小行年。\n一归已后陶元亮，众论宁无班孟坚。\n不负登临重九约，过江犹及菊花前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪汪少卿游紫阳次梁倅韵","author":"方岳","text":"此行许老亦津津，连夜催将雪树春。\n溪隔更无尘土事，山矜便识谪仙人。\n云依栏过香仍湿，墨带冰磨句转新。\n丘壑自容吾入社，不论五马两朱轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶阅夷坚志见梁郑公有九月梅花诗因复次韵","author":"方岳","text":"秋容正待满林雪，春色因何到草堂。\n地脉顿回消息早，天葩不作等閒香。\n丹枫欲老已如许，黄菊同时未敢芳。\n不等岁寒催鼎实，角声自与月平章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶题","author":"方岳","text":"空烦社友问何如，筋力犹堪月下锄。\n为米折腰长乞米，缘书损目苦观书。\n山翁迂阔每如此，吾道寂寥谁与居。\n独立西风人自老，枉悲宋玉不关渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿多景楼奉简吴总侍","author":"方岳","text":"客怀孤倚夕阳楼，烟老平芜岸岸秋。\n往事六朝南北史，晴江一片古今愁。\n嘅其叹矣山吞吐，何以酬之酒拍浮。\n此意政须诸老共，容分芦雨寄渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿芙蓉驿","author":"方岳","text":"凤皇山下芙蓉驿，零落残碑半蚀苔。\n黄鸟有时穿户过，青山无数摺溪回。\n麦秋天气半明暗，蚕月人家忌往来。\n俯仰十年如梦耳，旧题剥落已尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿奉圣寺下","author":"方岳","text":"幽事随人撰，兹行亦屡逢。\n饭多依钓艇，宿喜近僧钟。\n野水连秋暝，溪烟急晚舂。\n诚斋题石老，细读得从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿耕舍","author":"方岳","text":"题诗藓壁墨花新，俛仰之间迹已陈。\n检点不同今老大，受持只是旧清贫。\n蓬蔂笠渍班班雨，荷叶衫枯蔌蔌尘。\n枉废春锄成底事，重来惭见耦耕人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄友人","author":"方岳","text":"面熟青山亦故人，霜逢肯负月粼粼。\n如闻行李且家住，未必梅花知路贫。\n荠老自堪供野饭，罾寒谁与鲙溪鳞。\n商量只有归耕是，不料归耕也误身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄吕宗卿","author":"方岳","text":"昔我林皋麋鹿姿，云胡今我复来思。\n舟行严濑多逢雨，山识吾宗少有诗。\n风月厌谈当世事，乾坤独与古人期。\n西湖烟水春无恙，坐想梅花圣得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄汤卿","author":"方岳","text":"书册依官屋，何如自在身。\n且无山得看，犹有竹相邻。\n性野回书懒，诗痴易藁频。\n便归吾已俗，往往白鸥嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄至能","author":"方岳","text":"江上归来即定巢，墙阴野竹破新梢。\n有人问字时相过，无事观书手自抄。\n世态十年多客梦，月明千里少朋交。\n茅斋亦有秋崖藁，留与青山作解嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄别参政","author":"方岳","text":"一见臞仙眼为清，寒温未了与谈经。\n有书欲问文中子，无策重窥傅说星。\n马瘦不妨吟下泽，鹤归宁复唳华亭。\n独于知己难忘在，投老残编傥乞灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄别季桐庐","author":"方岳","text":"一湖寒渌记传杯，三见孤山雪底梅。\n脱我素冠惟骨在，听君清话得眉开。\n底须政事喧京辇，例合诗人管钓台。\n债县近来那可向，江山虽美盍归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄侄","author":"方岳","text":"尔亦为贫驱，窗间砚欲枯。\n自从村墅别，曾到陕山无。\n寒圃应肥菜，秋霖怕损租。\n有书供夜读，时一唤吾雏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄范参政","author":"方岳","text":"逐客无书入帝城，灵光今阙几公卿。\n当时何敢书三宿，诸老谁招鲁两生。\n双碧崔嵬容雪卧，一黄觳觫了春耕。\n极知穷薄难为力，犹幸林间识太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄曹云台 其二","author":"方岳","text":"难得宜春便，经时不报书。\n雨多花较损，雪尽草频锄。\n灯火贫如故，山林拙未除。\n有诗无话处，一向闭门居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄鲁山兄","author":"方岳","text":"摇落山城暮，行人返照边。\n乱蝉鸣古柳，独鹤下遥川。\n秋事无多日，寒花又一年。\n故应深夜雨，重忆对床眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题盐城方令君摇碧阁","author":"方岳","text":"有山无水山枯槁，有阁无书阁未清。\n作计者谁三太息，美君于此四难并。\n宰官身落秋城柝，处士星寒雪墅耕。\n蚤晚樯竿插苍石，重拈秃笔与逢迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得归","author":"方岳","text":"日日言归始得归，归欤好在旧牛衣。\n青山未害欠诗屋，白鸟倘能看钓矶。\n欲问古人今在否，不知吾道是耶非。\n里中父老如相过，应叹艰难带解围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得家信","author":"方岳","text":"云冻窗棂香未残，月攲沙渚角声乾。\n相思千里梦初断，又是五更霜正寒。\n客路不知花代谢，家书只报竹平安。\n诗情却与山如旧，但做吾乡一等看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼祭酒徐仁伯 其一","author":"方岳","text":"皇天老眼定何居，祸酷如公古亦稀。\n酖毒不令猜叔子，药家谁实死颜畿。\n人心纵崄难清白，世变不磨真是非。\n毕竟若为书史册，暮江倚徙泪沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼祭酒徐仁伯 其二","author":"方岳","text":"同谒翘材话直前，别才信宿讣惊传。\n等之百世无今日，杀我三良不半年。\n公与朝端清到底，人言次相直如弦。\n奏篇共上寥阳殿，未必精忠隔九泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"接花","author":"方岳","text":"楚箨并刀社雨前，掇红接紫自年年。\n颠风稗子僧成佛，白日烂柯人诈仙。\n半霎时移愚智性，一丸泥夺化工权。\n可怜人自生荆棘，却变初心失本然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚兴","author":"方岳","text":"山淡长疑雨，看山自撚髭。\n暝云延晚径，秋蔓亚疏篱。\n院静凉于水，人閒瘦似诗。\n移床眠对竹，莫与俗人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚汎草塘有鱼入舟呼童鲙之适见瑞莲骈植与客赋首尾吟 其一","author":"方岳","text":"草塘晚汎亦佳哉，谁为贫谋献鲙才。\n自入船来银泼剌，且留客共月徘徊。\n不须溪友投竿线，径与诗人上酒杯。\n著意出奇殊未也，柳边又报瑞莲开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春","author":"方岳","text":"倦眼忽惊三月暮，杜鹃啼处绿阴多。\n春今且住为佳耳，雨不能晴将奈何。\n红紫只催人老大，苍浪莫怨命蹉跎。\n贫中政自难留客，赖有诗情尚不磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚眺","author":"方岳","text":"晴沙漠漠水沄沄，更倚翠微搔白纷。\n不可以风秋后叶，何伤于月晚来云。\n忧时自有夔龙在，投老政须麛鹿群。\n旋拾枯松浇瀑布，小奚亦足张吾军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚眺","author":"方岳","text":"摩挲倦眼风烟上，万木归根叶已零。\n衰发不知何事白，遥岑只是旧时青。\n功名一梦屈伸肘，身世百年长短亭。\n莫向夕阳多感慨，夜寒重勘相牛经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅边","author":"方岳","text":"野人暖入狼头帽，雪后寒生鹤膝枝。\n杖屦与峰回路转，溪山又物换星移。\n酒能作祟可忘酒，诗不穷人未是诗。\n笔走秋蛇情烂熳，谁知方寸太平时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花","author":"方岳","text":"近看遥见总风标，不拣疏村自断桥。\n大士定中蒙素衲，太真浴起却红绡。\n别修花史为题品，高倡离骚伴寂寥。\n岁晚道人心似铁，爱香怜影尚魂销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦平山","author":"方岳","text":"击楫涛江二十春，平生踪迹已成陈。\n秋城一别芙蓉老，夜柝几番杨柳新。\n社燕欲归仍择木，佛狸不死每惊尘。\n如闻露布今三捷，莫遣天骄返只轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦寻梅","author":"方岳","text":"野径深藏隐者家，岸莎分路带溪斜。\n马蹄残雪六七里，山觜有梅三四花。\n黄叶拥篱埋药草，青灯煨芋话桑麻。\n一生烟雨蓬茅底，不梦金貂侍玉华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦余义夫以剑请铭","author":"方岳","text":"黑水梁州百二关，青天蜀道古云难。\n貔貅夜柝身何在，麋鹿秋风骨未寒。\n宠辱可惊沤起灭，荒凉只有月悲酸。\n蒯缑忽堕空山梦，不道幽人意转阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦陈和仲如平生交有三言觉而记其一曰错后乱梦中了了以为事错之后此心撩乱不如早谋其始也","author":"方岳","text":"睡残寒月海东头，不起斯人孰与游。\n天下事宁堪几错，梦中语亦戒前筹。\n江湖浩浩二三子，风雨寥寥十五秋。\n莫向断云多感慨，孔颜无命不伊周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"检校坞中","author":"方岳","text":"检校平生瓜芋区，锄云荷月尽堪娱。\n山中鹤帐依然在，天下鱼羹何处无。\n古藓苍厓松老大，夕阳黄犊草荒芜。\n纵无田亦归来是，说与秋风不为鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祷晴","author":"方岳","text":"曾几何时屡乞晴，炉烟未断已收声。\n天于老子亦多可，国有丰年方太平。\n风土不堪人佩犊，月明无复夜啼鼪。\n及今便可归田去，牛背斜阳一笛横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"移饮治城楼","author":"方岳","text":"亭皋渺渺叶声乾，更与西风一倚栏。\n鹦鹉杯深遗恨在，麒麟冢没莫烟寒。\n山如有约欲排闼，诗不中书屡免冠。\n采菊东篱偶然耳，有人传作画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野步 其一","author":"方岳","text":"秋风欲下题诗叶，午枕初醒破闷茶。\n六七里行溪诘曲，二三子共酒欢哗。\n乾坤何似一传舍，日月不停双转车。\n富贵政妨人作乐，抵须辛苦问乘槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野步 其二","author":"方岳","text":"云埋莎径閒看竹，瀑煮松风旋作茶。\n山骨未如诗骨瘦，涧声欲乱语声哗。\n相逢杯有友名玉，所恨坐无人姓车。\n到手新诗遣谁写，惊鸦栖壁落枯槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铨琐","author":"方岳","text":"绿渍苔痕蚀断碑，摩挲名字笑衰迟。\n云寒昨夜人何似，雨锁重门春不知。\n莫倚离骚堪仆命，从来造物亦儿痴。\n转头十五年前话，独立东风举似谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄倅饟鲎一徐尉饟蝤蛑十同时至","author":"方岳","text":"谁饟螯如径尺盘，更分鲎似惠文冠。\n曲生醉嚼玉五壳，剑客生劙珠一箪。\n我与尔元同蠢动，冤哉烹亦到蹒跚。\n不知南食诗何似，待问昌黎老子看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":8471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]