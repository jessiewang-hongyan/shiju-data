[{"title":"和孔彦常侍郎癸酉冬雪","author":"韦骧","text":"淳深等彭泽，瑰怪轻玉川。\n读公冬雪吟，爽气何飘然。\n斋祠宿华省，对此同云天。\n坐看积琼瑶，光辉想蓝田。\n泥滓歘藏垢，朽枯顿增妍。\n纷纷布寒空，往往迷飞仙。\n狐裘杀馀温，薰炉凝微烟。\n清冷彻心骨，复谁嘲昼眠。\n雄词笔下驱，若放春水船。\n庆丰仍记岁，讽咏期他年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题忠州丰都景德观","author":"韦骧","text":"丰都县北岷江侧，古观峥嵘耀金碧。\n层峦秀拔异群山，乔木侵云竞千尺。\n二仙去久丹灶冷，空载遗文在碑刻。\n俗士纷纷徒叹嗟，曾有何人继真迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岑公洞","author":"韦骧","text":"耽耽石洞天开镌，岑公之隐来何年。\n一朝仙去名晦然，商人受香忘所传。\n舟抑不进方省愆，奉香入洞舟乃前。\n灵踪自此人拳拳，至今乾溢皆致虔。\n恍忽应祷殊无偏，我来敬谒岁欲迁。\n舣泊沙碛登舁肩，蹴踏锦石行江壖。\n洞门屣步侵云烟，瞻望塑像钦华颠。\n挺之作记誇唐贤，勒珉虽昏辞尚全。\n却恨戾止非炎天，不见百尺悬飞泉。\n唯有岩窦声涓涓，顷之自可遗尘缘。\n况乃投隙图留连，嗟予远宦方拘挛。\n搜奇寻胜姑勉旃，此日得此澄心渊。\n安能摆脱追神仙，临崖浪笔书长篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"追咏西园海棠","author":"韦骧","text":"西园正月月欲残，海棠一株花正繁。\n滂葩滟滟斗朝日，露洗蜀锦红光寒。\n回环桃李竞无色，卓尔独秀当朱栏。\n两春行役不及见，今日偶幸官身閒。\n拟开金樽恣欢赏，酬酢宿恨开衰颜。\n无何职事忽牵制，遽戒舟楫乘波澜。\n却嗟逐物犹带芥，未免回首兴长叹。\n悠悠清夜入寤寐，往往蝶梦曾飞还。\n归来绿叶空满枝，正与老态相追攀。\n须知乐事少如欲，谁谓天意于人悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨内翰读书堂","author":"韦骧","text":"无为山色参天碧，翰林旧隐多遗迹。\n跨鹤凌风去几年，独有文章光翕赩。\n构堂续志广所存，善矣鸰原足馀力。\n清白永随风月久，形容杳与尘埃隔。\n伊尔歘忆四纪前，曾蹑云梯附鹏翼。\n此堂坐想不获登，谩寄长言勒岩石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月十八日观潮","author":"韦骧","text":"浙湍浩溔连溟渤，宵昼潮头卷沙出。\n中秋三日日欲西，一岁之潮盛今日。\n雪山横亘截江来，巨浪翻空生倏忽。\n吴儿当此誇善泅，执炬扬旗徐出没。\n旁观奚止动精爽，壮士为之犹股慄。\n由来习俗竞兹辰，士女欣然勇相率。\n纷纷毕集绕长堤，翠盖成阴何栉密。\n邦侯乐众为开筵，歌管凌虚遏云物。\n玉堂钜公临右席，宾主交辉映簪绂。\n注目应同济川念，赏心仍寓和民术。\n区区下客久不逢，二纪光阴容易失。\n幸陪高会还旧观，聊解叹嗟挥老笔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谗龙","author":"韦骧","text":"退之昔日谗风伯，今日吾友谗应龙。\n应龙闻之两耳卓，急卷海水飞长空。\n阴云曀曀为后先，变化赫日成昏曚。\n田间槁穗有生意，虢子属纩卢医逢。\n望霓万口动一喜，往往备赛求豜豵。\n顷之气象复舒霁，飘洒尚不遭溟濛。\n龙乎奚尔不努力，遽若有禀还收踪。\n天岂虐斯民，不欲为年丰。\n林林未必皆咎戾，必有任责当其凶。\n蕲君勿龙谗，谗龙非无从。\n旱乾水溢各有召，应答不谬如洪钟。\n昭昭之鉴明且威，讵敢旷久而忘功。\n一欲窃弄权，霶霈私群农。\n震怒起旋踵，菹醢灾谁躬。\n慎无凝土像夭矫，昼夜狂舞青衣童。\n精诚修警感毕听，朝暮膏泽盈寰中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪宜春守皮献臣游化成岩","author":"韦骧","text":"城闉北出春江阔，铁锁联舟波浪截。\n驱车度岸得幽岑，半带云阴青欲活。\n何年造化成此岩，谁为高阁依巉巉。\n穿岩登阁意思豁，气象百种相交参。\n双旌远映苍烟色，山鸟江花俱自得。\n使君暇豫真适然，万室鸣弦不知极。\n江南旧美传庾公，浩辈爽逸陪游从。\n风流不减当时盛，独愧非才列座中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上太守陈少卿十韵","author":"韦骧","text":"风流富川盛，善政久濡沾。\n市价童无惑，关讥盗不潜。\n卖刀人向本，让路俗知谦。\n明府精区处，圜扉绝滞淹。\n青纶方调补，内屏幸趋瞻。\n直道爰来遇，孤踪岂自嫌。\n有时申谳议，仰见霁威严。\n志得宁辞贱，公闲倍养恬。\n爰须祈汲引，足以慰清廉。\n静念官居乐，长言孰可钳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"董都官索署中山亭诗","author":"韦骧","text":"突兀灵亭倚翠微，纷然尘境此中遗。\n高明颇惬星郎意，邃密如嫌俗客知。\n吟对青山摇玉麈，醉临华月解银龟。\n襟怀蹇蹇安閒久，偃卧多应梦赤墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答董都官索去年诗债","author":"韦骧","text":"轸下传音旨，胸中长忸怩。\n如何终日暇，犹负隔年诗。\n寡和知声妙，难抽恨思迟。\n殷勤还见趣，荒鄙敢为辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和闻新制间岁贡士","author":"韦骧","text":"五载兴贤日月疏，间关多是老閒居。\n朝廷远虑淹才敝，郡国新颁间岁书。\n士子将期贺空谷，诗人当复兴嘉鱼。\n无能自愧逢辰早，已脱犁锄就栈车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和江亭春半","author":"韦骧","text":"亭压长江气象雄，清明时节夕阳中。\n天边远嶂横深翠，花外馀霞没乱红。\n鸥鹭飞鸣得閒趣，渔樵歌唱有淳风。\n谁能共向春光醉，穷达多忘学塞翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和久雨","author":"韦骧","text":"阴霖继月酷相因，旱魃今年遽丧神。\n膏泽翻忧害东作，芳期那敢爱青春。\n蜼谷虽智能蒙鼻，奈有民咨易动唇。\n天听甚卑群语切，雨师何事未回轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和寒食","author":"韦骧","text":"城关咫尺到春郊，跃马行春固不劳。\n寒食萧疏观物态，楚歌嘲哳聚儿曹。\n平湖漾日扁舟满，芳榭迎风画鼓高。\n薄暮田翁醉归乐，山花倒插挈馀醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂咏五首 其一","author":"韦骧","text":"长林栖息自安如，谩劝閒人挈酒壶。\n世治有谁从醉隐，徒劳健吻汝知无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂咏五首 其二","author":"韦骧","text":"切切声呼泥滑滑，强关人事最无机。\n安知巧舌为身累，锁向雕笼不得飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂咏五首 其三","author":"韦骧","text":"蝈氏官亡种类滋，脰鸣连党欲何为。\n喧然无理令人恶，忆著昌黎吏部诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂咏五首 其四","author":"韦骧","text":"忧乐由来繫所存，强名微草不须论。\n箪瓢悦道颜渊德，陋巷当时岂种萱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂咏五首 其五","author":"韦骧","text":"啼血辛勤尔自贻，百花时节好閒飞。\n行人日日春山过，相劝相呼总不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惜花","author":"韦骧","text":"玉人携酒对花枝，怅息红芳已半稀。\n楚帐歌中别虞氏，马嵬坡里顾杨妃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明闻楚歌","author":"韦骧","text":"彷佛渔阳参鼓挝，依稀江左后庭花。\n清明旧俗无佳尚，唯此喧声杂暮蛙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初晴复雨感事","author":"韦骧","text":"朝晖还复变濛濛，过尽韶华冷落中。\n媚紫妖红如病悴，也应无暇笑东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和董都官登城南楼","author":"韦骧","text":"危楼百尺据城堧，徙倚浑疑到紫烟。\n卑湿岂愁梅雨地，清和尤喜麦秋天。\n一川晚照飞孤鹜，满袖薰风听杜鹃。\n乡思摇摇白云外，官拘唯幸际尧年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对雨怀陶掾","author":"韦骧","text":"雨气侵池馆，清如秋向深。\n遥知修敌具，萧洒不关心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"思养","author":"韦骧","text":"懒登危阁望天东，山外风烟隔几重。\n白发庭闱未归侍，青纶尘土若为悰。\n故乡辽夐踰千里，薄宦拘挛等万钟。\n指数瓜期尚稽远，悠悠斗粟为谁舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和聂充甫水南见寄","author":"韦骧","text":"衮衮孤城里，惟君离俗居。\n车鱼绝嗟叹，诗酒养冲虚。\n掩面羞龙断，澄心对古书。\n天其假幽寂，停滀合何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和","author":"韦骧","text":"诗来盛说溪山好，局事萧萧似隐流。\n閒对文枰销白日，勇持吟笔战清秋。\n城中事逐渔樵得，门外客无车马留。\n而我拘挛但增羡，强酬佳句思难抽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和酬聂充甫新寄","author":"韦骧","text":"霜叶乘风舞，秋云盖野平。\n南溪尘境绝，东道玉壶清。\n佳处怜君得，新篇慰我情。\n无缘一携手，相共濯冠缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李尉解任归庐陵","author":"韦骧","text":"官冷馀才晦，涂清得代还。\n维舟纷扰外，行酒别离间。\n水落蛟鼋伏，沙空雁鹜閒。\n归欤风味好，天末辨家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"摄户纠二曹事因自戏","author":"韦骧","text":"三参军事归权握，贱务区区日倍增。\n却笑近贤衔署贵，时人虚号一条冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贾尉见迫给廪因以诗戏","author":"韦骧","text":"月粟见须何太迫，贱生奔走正无聊。\n蕲君勿虑晨炊绝，吾党而今解折腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送浦大会甫赴榆次","author":"韦骧","text":"平生落落多豪气，万里区区赴冷官。\n今日送君非故闬，一樽为我尽情欢。\n解舟吴浦江云重，策马并门塞雪寒。\n富贵功名行孰禦，古来新沐必弹冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贾庆甫示山中梅诗因继成","author":"韦骧","text":"雪意将成腊欲来，乱山深处见寒梅。\n化工若与人情比，此树多应未及开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答鲁虞部见寄","author":"韦骧","text":"鄙才效职便穷僻，忽忽天星殆二周。\n系狱空虚民讼少，倖门堙塞吏心忧。\n琴书永日清无际，草树逢春绿正柔。\n惊坐高宾如见顾，幽欢何惜贳貂裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又答惠诗并新鳝","author":"韦骧","text":"珠玑盈纸将新味，方丈分甘及贱夫。\n大啜一杯乡思动，却咍张翰只思鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独登临清阁","author":"韦骧","text":"扬扬何处一逍遥，朱阁临清兴味高。\n翠霭相连结春态，澄光下视鉴秋毫。\n绿杨静舞腰初困，白鸟閒栖目不逃。\n独到独归俱有意，暂期尘土落祇裯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得董都官书因为寄四首 其一","author":"韦骧","text":"晚来音驿拜勤渠，咫尺拘挛万里疏。\n却羡浔阳堤上柳，长条往往拂贤车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得董都官书因为寄四首 其二","author":"韦骧","text":"七年恬寞坐江濒，今日登途气象春。\n请剧书成为泽大，马蹄无惜入红尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得董都官书因为寄四首 其三","author":"韦骧","text":"花表危楼远目穷，华轩不见见春浓。\n春山缭绕无重数，还在春山第几重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得董都官书因为寄四首 其四","author":"韦骧","text":"登临何以慰相思，把酒开编读旧诗。\n正是去年酬唱景，春风花草半离披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"棕花","author":"韦骧","text":"叶落不随群，花开亦趁春。\n初包莲蕊白，半折粟文皴。\n蜂蝶遥相笑，儿童冷不亲。\n华丹君勿责，劲直在吾身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和太守临清阁一首","author":"韦骧","text":"朱阁新前构，峥嵘枕水端。\n地饶千顷秀，天付四时寒。\n波蹙龙鳞活，山斜凤翼攒。\n晴光照毛发，翠霭夺华丹。\n贺老空游鉴，严公浪记滩。\n轩窗通浩荡，榱桷变彫残。\n静极尘机丧，清多饵钓难。\n来当思洁白，意不在游盘。\n气爽如开浚，堤环若刈兰。\n绘工忧措手，诗将勇濡翰。\n远目穷层汉，澄心俯曲栏。\n鸢鱼皆自得，宇宙始知宽。\n神物亨中发，贤侯与众欢。\n政声喧盛美，隅泣解辛酸。\n登览临春昼，雍容兀醉冠。\n千龄幸臣宋，五裤正歌潘。\n环佩锵芳席，旌麾揭画竿。\n笳箫音嘒嘒，貔虎势桓桓。\n俗乐芹争采，宾归铗不弹。\n落成今日事，遗爱永江干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"榴花","author":"韦骧","text":"本根树立宜坚厚，韡韡佳花号石榴。\n丹赤终能尽敷吐，馨香何必事飘浮。\n晴光照处火欲烈，雨气凝时血不流。\n莫怨春风施力晚，天教美实冠清秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乾元节口号","author":"韦骧","text":"祥电当年绕斗明，岩廊今日享隆平。\n三朝功业山河固，万国讴歌宇宙清。\n湛露均恩锡华宴，薰风入奏阜群生。\n庶官愿祝无疆寿，葵藿心齐向日倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观棋","author":"韦骧","text":"不卜天时不背山，枯棋遇敌战谈间。\n藏机闇伏三千楯，侵道雄窥百二关。\n群语虽咻难改听，一先偶失若无颜。\n人心勇善能如此，谁谓渊骞未易攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剪金花一首和陶掾","author":"韦骧","text":"花神委曲竞光阴，特向低丛剪寸金。\n买断园林初夏景，竟教蜂蝶慰寒心。\n玲珑圆影风前舞，寂寞红芳雨后深。\n稚子知名不知实，采之掷地听馀音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"枇杷","author":"韦骧","text":"美种盛东南，园林十二三。\n金丸方磊落，琼液正包含。\n采熟鸣禽怨，餐多稚子贪。\n岂须江国重，天下嗜柔甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陶掾同登晓亭","author":"韦骧","text":"芳蹊诘曲上亭南，小树萦纡若舞骖。\n直对苍山班席坐，旋寻幽卉满头篸。\n楮皮裁幅明如玉，竹叶浮杯渌似蓝。\n共酌共谈其乐胜，俗忧应是不能堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆甫借棋子","author":"韦骧","text":"碾玉为棋黑白明，临枰思策且须精。\n莫教败衄空如扫，却出枝辞辄罪兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和贾尉女真花","author":"韦骧","text":"只恐繁云炽碧空，火龙昼跃汗随风。\n飘来翠叶亭亭处，滴出芳葩点点红。\n最美虚心如有待，直饶润色更无浓。\n主人为尔邀宾醉，狼藉杯盘晚照中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昨暮会饮庆甫署观女真花因求一二诺以厥明至期不至遂戏成一首","author":"韦骧","text":"见许黎明和露剪，日高何事尚稽期。\n也知更欲延宾履，次第开时固未迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢太守惠家园瓜","author":"韦骧","text":"种继青门气类嘉，恩传铃阁动光华。\n含滋虽本生成力，采实难胜宠赐加。\n冽若层冰破蒸郁，明如碧玉照玼瑕。\n贱官咀嚼深衔恋，代至明年正及瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萧洒参军宇六首 其一","author":"韦骧","text":"萧洒参军宇，临庭客不过。\n秋花生意渐，夏木昼阴多。\n坦腹群书榥，支藜一径莎。\n尘泥奔走外，得此兴如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萧洒参军宇六首 其二","author":"韦骧","text":"萧洒参军宇，年来讼狱稀。\n凝尘掩丹笔，苍藓半圜扉。\n晚树鸣蝉沸，虚檐斗雀飞。\n何须溪谷隐，即此是忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萧洒参军宇六首 其三","author":"韦骧","text":"萧洒参军宇，郊原咫尺分。\n门前涨溪水，屋角露山云。\n白鸟斜阳见，鸣榔半夜闻。\n安知名利境，驰骋共纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萧洒参军宇六首 其四","author":"韦骧","text":"萧洒参军宇，回环百亩间。\n山光侵户牖，柳色锁门阑。\n尽爱清风满，相仍白日閒。\n祇赢诗思勇，濡笔溅青纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萧洒参军宇六首 其五","author":"韦骧","text":"萧洒参军宇，疏池小圃东。\n风荷朝披靡，月竹夜玲珑。\n樽酒有时满，囊钱计日空。\n养恬真得地，捽茹乐融融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"萧洒参军宇六首 其六","author":"韦骧","text":"萧洒参军宇，幽轩占一隅。\n栟榈双翡翠，薜荔绿氍毹。\n偃息三年计，炎歊六月无。\n跧藏晦疏拙，违俗任卢胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八月泛江送客","author":"韦骧","text":"送客欲逡巡，方舟舣棹频。\n夕阳千嶂外，秋色一江匀。\n酒面红烟惨，歌眉翠黛颦。\n昔年离别恨，今日并如新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送浦倅之阙","author":"韦骧","text":"翘翘别乘出吴关，吏俗随辕不敢攀。\n此日谩淹飞盖住，明时那许壮才閒。\n秋花几处逢孤驿，凉月相迎过暮山。\n请剧书成双阙近，伫闻忠论解天颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酷暑初夜","author":"韦骧","text":"尽日炎炎酷暑蒸，黄昏气象未全清。\n天风难值树浑静，海月不见云空明。\n群蚋得时方伺隙，噪蝉何事懒收声。\n噫予自有安恬趣，岂废林间坦腹行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月","author":"韦骧","text":"风脚无时定，霜花昼亦飞。\n天愁云四合，树冷鸟相依。\n陋室群书满，衡门俗客稀。\n饥肠何以疗，园芋正丰肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]