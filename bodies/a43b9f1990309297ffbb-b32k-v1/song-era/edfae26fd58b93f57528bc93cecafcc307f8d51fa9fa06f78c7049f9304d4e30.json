[{"title":"鹊桥仙 其六 乙丑七夕","author":"郭应祥","text":"薄云笼月，轻飙却暑，天上人间佳节。\n银河自有鹊为桥，又那要、兰舟桂楫。\n后期可准，新欢如昨，选甚轻离易别。\n姮娥休要妒人呵，待更与、留连一霎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹊桥仙 其七 周监旬会上作","author":"郭应祥","text":"六人欢笑，六姬讴唱，六博时分胜负。\n六家盘馔斗芳鲜，恰两月、六番相聚。\n特排整整，华筵楚楚，终是不如草具。\n赏心乐事四时同，又管甚、落花飞絮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹊桥仙 其十二 丙寅除夕立春，骨肉团聚，是夕大雪","author":"郭应祥","text":"立春除夕，并为一日，此事今年创见。\n席间三世共团栾，随分有、笙歌满院。\n一名喜雪，二名饯岁，三则是名春宴。\n从教一岁大家添，但只要、明年强健。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹊桥仙 其一 五月四日仲远浴儿","author":"郭应祥","text":"去年七夕，今年五日，两见浴儿高会。\n乃翁种德已多年，看衮衮、公侯未艾。\n封胡羯末，综维缜绛，堪羡金鱼垂袋。\n丹砂白蜜不须涂，把续命、彩丝与带。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹊桥仙 其十一 丙寅七夕","author":"郭应祥","text":"两情相向，一年厮睚，等得佳期又到。\n休言夜半悄无人，那喜鹊、也须知道。\n来今往古，吟诗度曲，总漫萦牵怀抱。\n不如乞取巧些些，待见了、分明祷告。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹊桥仙 其四 甲子中秋","author":"郭应祥","text":"金飙乍歇，冰轮欲上，万里秋空如扫。\n一年十二度团圆，甚恰限、今宵最好。\n烹麟脍凤，幕天席地，争似杯盘草草。\n明年应更胜今年，但只恐、朱颜暗老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹊桥仙 其九 雨中赏酴醾，次周监税韵","author":"郭应祥","text":"杯盘草草，园亭小小，不用罗帷锦幄。\n酴醾本是殿馀春，更风雨、无端趱却。\n有词可和，有棋可赌，杂以诙谐戏谑。\n闲时日日可遨嬉，又选甚，花开花落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹊桥仙 其八 旬会作","author":"郭应祥","text":"六丁文焰，六韬武略，那更六经心醉。\n六人相对座生风，继六逸、当年旧事。\n六州清唱，六么妙舞，执乐仍呼六妓。\n大家且饮六分觥，看宾主、迭居六位。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹊桥仙 其五 □□立春","author":"郭应祥","text":"泥牛击罢，银幡卸了，又是一番春至。\n有人耳畔语低低，道宜入、新年吉利。\n堆盘红缕，浮杯绿蚁，自有及时风味。\n从今日日是东风，待拚了、偎红倚翠。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹊桥仙 其十三 丁卯七夕","author":"郭应祥","text":"今年七夕，新秋三日，已觉凉生院宇。\n吾乡风物胜他乡，那更著、莱衣起舞。\n泛槎经岁，分钗半夜，往事流传千古。\n独怜词客与诗人，费多少、闲言泼语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹊桥仙 其三 甲子七夕","author":"郭应祥","text":"金风淅淅，银河耿耿，七夕如今又至。\n人间唤作隔年期，但只似、屈伸指臂。\n罗花列果，拈针弄线，等是纷纷儿戏。\n巧人自少拙人多，那牛女、何曾管你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其四","author":"郭应祥","text":"明月清风，绿尊红袖。\n厌厌夜饮胜如昼。\n虽然文字有馀欢，也须闲把笙歌奏。\n十雨如期，三秋届候。\n去年丰稔今年又。\n东阡西陌稼如云，笑他齐量区兼豆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其一","author":"郭应祥","text":"鹗离风尘，燕辞门户。\n翩然举翮轻飞去。\n当初自恨探春迟，而今岂解留春住。\n花不重开，萍难再聚。\n垂杨只管牵离绪。\n直饶云雨梦阳台。\n梦回依旧无寻处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其七 乙巳正月二日雪","author":"郭应祥","text":"春已经旬，历方换岁。\n六花依旧来呈瑞。\n细思残腊与新年，一般清绝元非二。\n宿麦连云，遗蝗入地。\n坡仙有句谁能继。\n元宵此去日无多，会看霁色生和气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其六 七月十六日寿胡季海","author":"郭应祥","text":"自昔中元，多生上相。\n麒麟今又来天上。\n云衢虽未掇勋名，月评先已腾声望。\n宝鼎浓熏，金翘绝唱。\n真珠百斛倾家酿。\n斯辰聊用祝龟龄，他年端合扶鸠杖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其三","author":"郭应祥","text":"露湿冠巾，风生襟袖。\n月华耿耿明如昼。\n主人情意十分浓，阮咸横膝清音奏。\n渐永更筹，新凉气候。\n穿针乞巧看看又。\n却怜相聚日无多，偷闲且可陪觞豆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其五 寄远","author":"郭应祥","text":"一撮精神，百般体态。\n兰心蕙性谁能赛。\n霎时不见早思量，许多日子如何挨。\n我已安排，你须宁耐。\n看看重了鸳鸯债。\n此生永愿不分飞，傍人一任胡瞋怪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"踏莎行 其二 三月二十日元择旬会","author":"郭应祥","text":"骤暖忽寒，送春迎夏。\n金沙过了酴醾谢。\n漏声款款日偏长，奇峰历历云如画。\n幸有杯觞，堪同保社。\n棋如飞雹晴空下。\n六人酬唱已成编，他年遂水留佳话。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉落魄 丙寅中秋","author":"郭应祥","text":"琼楼玉宇。\n分明不受人间暑。\n寻常岂是无三五。\n惟有今宵，皓彩皆同普。\n素娥阅尽今和古。\n何妨小驻听吾语。\n当年弄影婆娑舞。\n妙曲虽传，毕竟人何许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十一 丙寅元夕","author":"郭应祥","text":"动地欢声遍十龙。\n元宵真赏与民同。\n春归莲焰参差里，人在蓬壶快乐中。\n乘皓月，逐和风。\n凉舆归去莫匆匆。\n班春休道无千炬，也有星球数点红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其四","author":"郭应祥","text":"风雨潇潇旧满城。\n今年九日十分晴。\n且同北海邀佳客，共向东篱看落英。\n罗绮队，管弦声。\n银山高处好同登。\n催租岂解妨诗兴，自是潘郎名未成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其五 甲子十一月十四日寿内子","author":"郭应祥","text":"鸾诰双双妇与姑。\n家尊荣宦到中都。\n暂时花县飞凫舄，新看芝庭捧鹤书。\n梅欲放，柳将舒。\n诞辰先占一阳初。\n清心堂下围红处，剩有长生酒满壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其三 甲子重阳","author":"郭应祥","text":"谁道他乡异故乡。\n泉江风物似湄湘。\n钗头缀糁萸偏紫，杯面浮金菊倍黄。\n今共古，几重阳。\n休将往事更平章。\n舞衫歌扇姑随分，又得掀髯笑一场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 乙丑岁寿内子","author":"郭应祥","text":"怪得欢声满十龙。\n诞辰和气敌严冬。\n安书莲幕欣频到，庆事花城喜屡逢。\n琼液泛，宝熏浓。\n华堂交口祝椿松。\n阿姑同健夫偕老，会有重重锦诰封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其六 遁斋自作生日","author":"郭应祥","text":"垂领纷纷已二毛。\n可堪州县尚徒劳。\n催科自笑阳城拙，勇退应惭靖节高。\n来祝寿，笑儿曹。\n说椿说柏说蟠桃。\n世间底事非前定，妙理还须问浊醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其九 中秋后一夕宴修成之、富正甫作","author":"郭应祥","text":"万里澄空没点云。\n素娥依旧驾冰轮。\n自缘人意看承别，未必清辉减一分。\n倾白堕，拥红裙。\n不知谁主复谁宾。\n更筹易促愁分袂，又作东西南北人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其七 宴王园作","author":"郭应祥","text":"休道泉江寂寞滨。\n喧喧歌吹遍城闉。\n莫辞邀赏连三日，且庆开禧第一春。\n呼小队，领嘉宾。\n王园佳处踏芳尘。\n星球不用随归骑，自有山头月逐人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十二 寿徐主簿","author":"郭应祥","text":"前数重阳后小春。\n中间十日是生辰。\n二年稳作栖鸾客，百里谁非贺燕人。\n无一事，扰天真。\n年登八八愈精神。\n句稽宜解淹贤辙，黄发犹须上要津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 己巳生日自作","author":"郭应祥","text":"屈指新年五十三。\n未嫌垂领雪毵毵。\n设弧届旦人交贺，题座无功我自惭。\n荣莫羡，富休贪。\n寿龄也不慕彭聃。\n只思了却痴儿事，一榻香凝晓梦酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其一 次孚先韵，重阳前两日无尽藏作","author":"郭应祥","text":"依约滩声杂橹声。\n波光隐映月华明。\n眼前好景真无尽，身外浮名尽可轻。\n穷胜赏，续欢盟。\n直饶风雨也须晴。\n满头插菊掀髯笑，笑道齐山浪得名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二 癸亥十一月十四日为内子寿","author":"郭应祥","text":"爱日迎长月向圆。\n当年飞堕蕊珠仙。\n相门赫奕人争羡，阃则柔嘉世所贤。\n罗纸贵，彩衣鲜。\n鼎来盛事乐无边。\n妇姑夫妇孙和子，同住人间五百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十九 戊辰生日自作","author":"郭应祥","text":"古遂长沙千里遥。\n三年三处做生朝。\n试拈疏蕊铜瓶插，更把轻沈宝鼎烧。\n杯绿泛，脸红潮。\n抱孙娱膝语声娇。\n官居只似私居样，管取寒松最后雕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十六 戊辰正月十一日寿八兄","author":"郭应祥","text":"瓶里梅花香正浓。\n阶前更著锦熏笼。\n且留幡胜明朝戴，共庆桑蓬此日逢。\n眉正绿，脸常红。\n后堂无日不春风。\n明年定又强今岁，会有明珠入掌中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其二 丁卯岁寿内子","author":"郭应祥","text":"方是闲堂寿宴开。\n今回生日胜前回。\n慈闱斑貌看看到，别驾除书鼎鼎来。\n粉彩服，滟金杯。\n缓歌慢舞不须催。\n明年此际称觞罢，醉向裴亭与定台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十三 季功旬会之次日小醵饯陈巡入乡","author":"郭应祥","text":"点检尊前主与宾。\n今宵依旧昨宵人。\n自缘笑语生和气，不为风光属小春。\n香叆叇，酒清醇。\n山肴野蔌总前陈。\n掀髯抵掌君休怪，镜里星星白发新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十四 丙寅岁寿内子","author":"郭应祥","text":"贺了生辰却贺冬。\n今年乐事又重重。\n寿香喷处芝兰馥，寿酒斟时琥珀浓。\n偕桂隐，到花封。\n迎长介寿恰三逢。\n明年此日称觞罢，稳上肩舆九里松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十五 丁卯岁寿太夫人","author":"郭应祥","text":"诞节初开七秩祥。\n今秋仍喜十分凉。\n称觞堂下孙和息，备福人间寿且康。\n从庾岭，到章江。\n两州元自接封疆。\n儿曹此去分风月，莱彩潘舆乐未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十七 戊辰七夕","author":"郭应祥","text":"令节标名自古闻。\n今宵银汉耿无云。\n难寻海上乘槎客，空诵河东乞巧文。\n罗异果，炷名熏。\n纫针捻线漫纷纷。\n蓬莱底事回车处，暗想当年钿合分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其八 乙丑八月十八日寿太孺人","author":"郭应祥","text":"人道今年秋较迟。\n木樨全未放些儿。\n不因诞节开千岁，争得今辰把一枝。\n呼宝鼎，伴渠伊。\n堂萱喜色正融怡。\n儿前妇后孙曾从，岁岁称觞无尽期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其十八 梦符置酒于野堂，出家姬歌自制词以侑觞，次韵","author":"郭应祥","text":"我离浏川七载强。\n去思那有召公棠。\n方怀旧友归鸿阁，忽枉高轩戏彩堂。\n频举白，剩添香。\n剧谈不觉引杯长。\n官居也有城门禁，未到三更尽不妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天晓角 赵簿席上写目前之景","author":"郭应祥","text":"琉璃十碗。\n兽炭红炉暖。\n花下两枝银烛，和气洽、欢声满。\n从他吹急管。\n杯行须款款。\n尽做更移漏转，也犹胜、春宵短。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白云庐","author":"郭时雍","text":"吾爱白云云爱吾，朝朝暮暮伴吾庐。\n从龙傍鸟随他去，留与幽人作画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春夜宿山家","author":"郭远","text":"嶂插清溪静荜门，数椽茅屋正黄昏。\n主人醉卧松间石，自绕梨花认月痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴崖山赠别陈焘父","author":"郭居安","text":"诗来老气郁沈沈，犹负驿骝万里骎。\n辇路风尘重回首，梅花岁晚独知心。\n张南有死天无远，管邴如生海未深。\n明发阳关底须叠，只哦雅制沈哇淫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木兰花慢 寿贾秋壑母两国胡夫人","author":"郭居安","text":"听都人共语，又还是、岁逢庚。\n记金帖频催，衮衣将至，绣幰先迎。\n笙歌六宫齐奏，到而今、犹唱贺升平。\n千岁人间福本，天公著意看承。\n秋深。\n帘卷空明。\n问西子，最宜晴。\n喜新来多暇，玉醪龙炙，菊院花城。\n明年耳孙头上，更君王、亲点泥金。\n兜率摩耶住世，长看佛度众生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"声声慢 寿贾师宪","author":"郭居安","text":"捷书连昼，甘洒通宵，新来喜沁尧眉。\n许大担当，人间佛力须弥。\n年年八月八日，长记他、三月三时。\n平生事，想祗和天语，不遣人知。\n一片闲心鹤外，被乾坤系定，虹玉腰围。\n阊阖云边，西风万籁吹齐。\n归舟更归何处，是天教、家在苏堤。\n千千岁，比周公、多个彩衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过从叔猥园","author":"郭岩","text":"风流吾大阮，嘉遁狎鸥盟。\n筑得野亭旷，到来云水清。\n斜林收橡实，泾水给茶铛。\n翻笑支公拙，买山空得名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"顾况读书堆","author":"郭岩","text":"昔人何处读书声，此地犹存旧日名。\n衰草闭门黄叶冷，香林藏硖碧云横。\n地连踰李山河壮，江绕吴淞日夜鸣。\n陈迹已怜荒没久，凭栏惆怅有馀情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松径","author":"郭岩","text":"一径深且纡，森森荫松柏。\n清风池上来，幽思与之发。\n逸响谐素琴，凉阴散清帙。\n弘景或可邀，高怀共披豁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"郭建德","text":"烟连草色迷平野，雨趁鸠声过别村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青羊宫","author":"郭忠恕","text":"久知玄牝是根原，谁道长生别有门。\n一自描龙兴叹后，至今师事五千言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘲聂崇义","author":"郭忠恕","text":"近贵全为聩，攀龙即是聋。\n虽然三个耳，其奈不成聪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送田表圣出知陈州","author":"郭忠恕","text":"客里暌离已不堪，何当出守正移骖。\n孔融在汉人应惮，善感鸣唐罪自甘。\n义重不嫌身死万，忧深宁忍口缄三。\n陈州亦是天朝地，好为疮痍雨露覃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再逢英公有感","author":"郭忠恕","text":"伊余行止住飘蓬，与世乖违不可容。\n青眼交知长忆念，白云踪迹又相逢。\n风骚共会名何盛，篆隶同勤法转功。\n□□羡师超彼岸，琉璃钵里看降龙。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"郭忠恕","text":"为逢末劫归依佛，不就新恩叙理官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"溪居","author":"郭忠谟","text":"凿破青山骨，初营数亩丘。\n泉分幽窦乳，峡束大江流。\n渔唱来花径，山光落钓舟。\n沙鸥惊笑语，片片起沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿石壁山馆","author":"郭忠谟","text":"斜阳在山客在船，片帆点破澄江天。\n携筇上踏笼头月，钓篷稳系芦花雪。\n夜深野鹤穿云归，正是山房酒醒时。\n羽衣起舞谩称寿，星斗插椽霜满袖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"坐黄冈广福禅房","author":"郭昂","text":"爱此禅栖静，清凉境自偏。\n诧人拳怪树，留客笑幽莲。\n草暖蛙喧夏，林昏鸟梦烟。\n风尘吾未免，兀坐愧安禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题峡山寺","author":"郭昌","text":"猿岂为妖恪自迷，世间那有倘来妻。\n裂衣心痛从前悔，恪不如猿反噬脐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题仙居南峰寺蓝光轩","author":"郭三益","text":"山光竹影交寒辉，下有碧浸吹涟漪。\n沙痕隐隐白鸟去，石声凿凿扁舟归。\n芝兰发香禅味远，云雾吐秀人家稀。\n须知春事不可挽，杜鹃已绕林中飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题三峡堂","author":"郭明复","text":"三峡堂前五月风，吴樯蜀柁古来通。\n山如肺附重相掩，水似环连去不穷。\n跃马孤城怜倔强，卧龙八阵想英雄。\n凭阑千载兴亡事，何异邯郸一枕中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大人按部过云安下岩留小诗命同赋","author":"郭明复","text":"道人昔日来开山，山鬼悔泣门不关。\n一时梵宇借岩麓，千载绝景归人间。\n松萝郁勃树旌纛，水泉丁东鸣佩环。\n两苏寂寞涪翁死，杖屦谁与同跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":61549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]