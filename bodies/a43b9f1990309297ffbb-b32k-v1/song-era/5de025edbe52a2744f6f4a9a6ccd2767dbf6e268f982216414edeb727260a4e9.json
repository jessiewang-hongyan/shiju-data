[{"title":"绍兴以后祀感生帝十六首 感生帝位酌献用《崇安》。","author":"郊庙朝会歌辞","text":"盛德在火，相我炎祚。\n典祀有常，牲玉维具。\n风马云车，翩翩来顾。\n式蕃帝祉，后昆有裕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀感生帝十六首 奉俎用《咸安》。","author":"郊庙朝会歌辞","text":"笾豆大房，秩秩在列。\n奉牲以告，既全既洁。\n乐均无爽，牲醴攸设。\n神兮燕娭，霓旌孑孑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀感生帝十六首 僖祖位奠币用《皇安》。","author":"郊庙朝会歌辞","text":"于穆文献，景炎发祥。\n启兹皇运，垂庆无疆。\n篚币有陈，式昭肃庄。\n神之格思，如在洋洋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀感生帝十六首 感生帝位奠玉币用《光安》。","author":"郊庙朝会歌辞","text":"肃肃严祀，神幽必闻。\n骋驾临飨，将歆飶芬。\n嘉玉陈币，钦恭无文。\n永绥多祜，国祚何垠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀感生帝十六首 升殿用《保安》。","author":"郊庙朝会歌辞","text":"三阳交泰，日新惟良。\n大建厥祀，兹报兴王。\n礼严陟降，德荐馨香。\n聿怀嘉庆，降福穰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀感生帝十六首 其四 降神用《大安》。","author":"郊庙朝会歌辞","text":"惟神之安，方解羽銮。\n赤旂霞曳，从以炎官。\n居歆嘉荐，肸蚃灵坛。\n神之格矣，民讫多盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀感生帝十六首 其三 降神用《大安》。","author":"郊庙朝会歌辞","text":"于物司火，于方峙南。\n璇霄来下，羽卫毵毵。\n祠官祝釐，联佩合簪。\n本支有衍，则百斯男。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后祀感生帝十六首 其一 降神用《大安》。","author":"郊庙朝会歌辞","text":"炎精之神，飞■碧落。\n驾以浮云，丹书赤雀。\n礼备豆笾，乐谐箫勺。\n神具醉止，佑我景铄。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 后稷位酌献用《穆安》。","author":"郊庙朝会歌辞","text":"维后之功，配天其大。\n祀而稷之，万世如在。\n黄冠野服，骏奔皇皇。\n自古有年，神其降康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 神农位酌献用《穆安》。","author":"郊庙朝会歌辞","text":"肇降生民，有不粒食。\n维时神农，乃为先啬。\n尔耒尔耨，云谁之因。\n酌以污尊，我思古人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 奠币用《吉安》。","author":"郊庙朝会歌辞","text":"百室机杼，衣褐具宜。\n民以卒岁，神实惠之。\n言举祀典，答神之釐。\n有篚斯陈，振古如兹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 初献盥洗、升降用《穆安》。","author":"郊庙朝会歌辞","text":"有帨其新，有匜其洁。\n言念清祀，弗简弗亵。\n诚意既交，品物斯列。\n是用告虔，靡神不说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 南方百神迎神用《简安》。","author":"郊庙朝会歌辞","text":"维物之精，散乎太空。\n维索之飨，合聚而同。\n乃击土鼓，于岁之终。\n格彼幽矣，肸蚃其通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 送神用《宣安》。","author":"郊庙朝会歌辞","text":"礼备乐成，澹然将归。\n其留消摇，象舆已轙。\n偃蹇欲骧，羽毛纷委。\n忽乘杳冥，遗此福祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 亚、终献用《庆安》。","author":"郊庙朝会歌辞","text":"歌磬胪驩，膋萧激香。\n飙御奄留，申以贰觞。\n相与震澹，告灵其醉。\n庶几听之，成我熙事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 后稷位酌献。曲同夜明。","author":"郊庙朝会歌辞","text":"岁十二月，祀有常典。\n祭列司啬，言反其本。\n酌彼泰尊，百末兰生。\n承神嘉虞，繄此德馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 神农位酌献。曲同夜明。","author":"郊庙朝会歌辞","text":"荡荡鸿明，称秩群祀。\n配以昔帝，式重农事。\n洁我圭瓒，黄流在中。\n灵其监兹，肸蚃丰融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 夜明位酌献用《择安》。","author":"郊庙朝会歌辞","text":"除坛西郊，坎其击鼓。\n百灵至止，结璘作主。\n秬鬯湛淡，玉斝觓䚧。\n是谓嘉德，神其安留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 奉俎用《承安》。","author":"郊庙朝会歌辞","text":"时和岁登，物亡疾瘯。\n实俎间膏，报神之福。\n匪神福之，曷成且丰。\n肥腯咸有，惟神之功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 后稷位奠币。曲同夜明。","author":"郊庙朝会歌辞","text":"明明周祖，惟民之恤。\n播种为教，下民乃粒。\n曾是索飨，而匪先公。\n万物难报，阡陌之功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 神农位奠币。曲同夜明。","author":"郊庙朝会歌辞","text":"耒耜肇兴，自神农氏。\n稼穑滋殖，为农者始。\n作配明祀，奠以告虔。\n万世佃渔，帝功卓然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 初献升降用《肃安》。","author":"郊庙朝会歌辞","text":"盥献恭庄，燎烟芬酷。\n载陟载降，礼容可度。\n钦惟尔神，上下肃肃。\n成我稷黍，鉴此牲玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 其四 西方百神降神用《熙安》。","author":"郊庙朝会歌辞","text":"丰年穰穰，美芳职职。\n笾豆方圆，其仪孔硕。\n风马在御，云车载饬。\n来顾来飨，维俟休德。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 其三 西方百神降神用《熙安》。","author":"郊庙朝会歌辞","text":"神罔小大，奠方兹土。\n祭列坊庸，礼迨猫虎。\n有功斯民，祀乃其所。\n非稷馨香，厥福周溥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 其二 西方百神降神用《熙安》。","author":"郊庙朝会歌辞","text":"魄生自西，照望太阳。\n下暨诸神，贶施万方。\n节适风雨，富我囷箱。\n共承嘉祀，惟以迪尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 其一 西方百神降神用《熙安》。","author":"郊庙朝会歌辞","text":"玄冬肇祀，始于伊耆。\n岁事聿成，庸答蕃釐。\n眷言西顾，匪神司之。\n归功尔神，翩其下来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 送神用《宣安》。","author":"郊庙朝会歌辞","text":"礼乐既成，神保聿归。\n言归何所，地纪天维。\n岂惟屡丰，嗣岁所祈。\n亿万斯年，神来燕娭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 亚、终献用《庆安》。","author":"郊庙朝会歌辞","text":"申以贰觞，百味且旨。\n礼告三终，神具醉止。\n旌容骑沓，扬光纷委。\n降福穰穰，被大丰美。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 后稷位酌献。曲同大明。","author":"郊庙朝会歌辞","text":"释之蒸之，为酒为醴。\n推本所由，于焉洽礼。\n周邦开基，邰家是启。\n献兹嘉觞，拜下首稽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 大明位酌献用《择安》。","author":"郊庙朝会歌辞","text":"肇禋备祀，教民美报。\n时和岁丰，奉醴以告。\n惟照临功，等于载焘。\n酌献云初，明神所劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 奉俎用《承安》。","author":"郊庙朝会歌辞","text":"享以精禋，馨非稷黍。\n工祝致告，孔硕为俎。\n执事骏奔，绳绳具举。\n神之嘉虞，介福是与。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 后稷氏位奠币。曲同大明。","author":"郊庙朝会歌辞","text":"播种之功，时惟后稷。\n推以配天，莫匪尔极。\n崇侑清祀，是为司啬。\n陈币奠将，永祚王国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 帝神农位奠币。曲同大明。","author":"郊庙朝会歌辞","text":"农为政本，食乃民天。\n神农氏作，民始力田。\n先啬之配，礼报则然。\n有币将之，维以告虔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 大明位奠玉币用《钦安》。","author":"郊庙朝会歌辞","text":"晨曦未融，天宇澄穆。\n有虔秉诚，将以币玉。\n如在左右，罔不祗肃。\n神兮安留，锡以祉福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"titl