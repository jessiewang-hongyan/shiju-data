"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 亚、终献用《曼安》。","author":"郊庙朝会歌辞","text":"丰年孔多，百礼以洽。\n匪极神欢，何以昭答。\n载酌之酒，用申其勤。\n神具醉止，与物交欣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀九宫贵神十首 送神用《景安》。","author":"郊庙朝会歌辞","text":"荐献有序，降登无违。\n礼乐备举，昭格燕娭。\n云车缥缈，神曰还归。\n报以景贶，翊我昌期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀九宫贵神十首 亚、终献用《文安》。","author":"郊庙朝会歌辞","text":"均调大化，阴骘下民。\n骏功有赫，诞举明禋。\n嘉觞中贰，执事惟寅。\n清明鬯矣，福禄攸臻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀九宫贵神十首 太一位酌献用《嘉安》。","author":"郊庙朝会歌辞","text":"惟天丕冒，彪列九神。\n财成元化，阴骘下民。\n有酒斯旨，登荐苾芬。\n昭哉降鉴，茀禄来臻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀九宫贵神十首 奉俎用《丰安》。","author":"郊庙朝会歌辞","text":"灵鉴匪远，诚心肃祗。\n是烝是享，俎实孔时。\n礼行乐奏，肸蚃是期。\n云车风马，神其燕娭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀九宫贵神十首 太一位奠玉币用《嘉安》。","author":"郊庙朝会歌辞","text":"煌煌九宫，照临下土。\n阴骘庶类，功施周普。\n恪修祀典，礼备乐举。\n嘉玉量币，馨非稷黍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀九宫贵神十首 初献升坛用《正安》。","author":"郊庙朝会歌辞","text":"于昭毖祀，周旋有容。\n历阶将事，趋进鞠躬。\n改步如初，没阶弥恭。\n左墄右平，陟降雍雍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀九宫贵神十首 其四 降神用《景安》。","author":"郊庙朝会歌辞","text":"练时吉良，聿崇明祀。\n粢盛洁丰，牲硕酒旨。\n肃唱和声，来燕来止。\n嘉承天休，赉及含齿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀九宫贵神十首 其三 降神用《景安》。","author":"郊庙朝会歌辞","text":"于赫九宫，天神之贵。\n煌煌彪列，下土是莅。\n幽赞高穹，阴骘万类。\n肃若旧典，有严祗事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀九宫贵神十首 其二 降神用《景安》。","author":"郊庙朝会歌辞","text":"载阳衍德，农祥孔昭。\n赉兹元嘏，穰穰黍苗。\n象舆眇冥，金奏远姚。\n无阏厥灵，丹衷匪恌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀九宫贵神十首 其一 降神用《景安》。","author":"郊庙朝会歌辞","text":"紫阙幽宏，惟神灵尊。\n辅成泰元，赞役乃坤。\n曰雨曰旸，缊豫调纷。\n享荐陨光，蒙祉如屯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀大火十二首 送神用《理安》。","author":"郊庙朝会歌辞","text":"登降上下，奠璧献斝。\n音送粥粥，礼无违者。\n已虞至旦，神其将归。\n顾我国家，遗以繁釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀大火十二首 亚、终献用《文安》。","author":"郊庙朝会歌辞","text":"神既贶施，嗜我饮食。\n申以累献，以承灵亿。\n神方常羊，咸毕我觞。\n于再于三，于诚之将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀大火十二首 宣明王位酌献用《祐安》。","author":"郊庙朝会歌辞","text":"谁其祀神，知神嗜好。\n阏伯祀火，为神所劳。\n眷言配食，既与火俱。\n于乐旨酒，承神嘉虞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀大火十二首 荧惑位酌献用《祐安》。","author":"郊庙朝会歌辞","text":"皇念有神，介我戬谷。\n登时休明，有此美禄。\n酌言献之，有飶其香。\n神兮燕娭，醉此嘉觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀大火十二首 捧俎用《丰安》。","author":"郊庙朝会歌辞","text":"火遵其令，无物不长。\n视此牲牢，务得其养。\n豢以祀神，有腯其肥。\n非神之宜，其将曷归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀大火十二首 商丘宣明王位奠币用《嘉安》。","author":"郊庙朝会歌辞","text":"荧惑在天，惟火与合。\n繄神主火，纯一不杂。\n作配荧惑，祀功则然。\n不腆之币，于以告虔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀大火十二首 荧惑位奠玉币用《嘉安》。","author":"郊庙朝会歌辞","text":"馨香接神，肸蚃恍惚。\n求神以诚，荐诚以物。\n有藉斯玉，有篚斯币。\n是用荐陈，昭兹精意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀大火十二首 升殿用《正安》。","author":"郊庙朝会歌辞","text":"有俨其容，有洁其衷。\n屹屹崇坛，伊神与通。\n神肯降格，嘉神之休。\n虔恭降登，神乎安留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绍兴祀大火十二首 其四 降神用《高安》。","author":"郊庙朝会歌辞","text":"于赫我宋，以火德王。\n永永丕图，繄神之相。\n神之来矣，维其时矣。\n礼备乐奏，神其知矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]