[{"title":"为郑菊山赋斗室","author":"薛嵎","text":"居然真乐地，跬步亦徜徉。\n大器何曾局，脩程未易量。\n中天应躔象，吾道即宫墙。\n万斛泉源在，非徒志秕糠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为槐径弟赋亦爱","author":"薛嵎","text":"无私天地情，物我岂殊形。\n此事关方寸，何人立户庭。\n一琴调舜曲，半壁写西铭。\n万虑境常适，谁能羡独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"友人入京","author":"薛嵎","text":"猿鹤亦悲鸣，家山莫浪轻。\n千峰带秋色，一路独吟情。\n野水冲潮白，孤云趁月行。\n遥怜归梦断，七十二滩声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"友人以修鍊游方或传其以此死者为赋是诗","author":"薛嵎","text":"鹤骨难污世上尘，西风惆怅瘗湖云。\n莫悲生死今朝隔，须信仙凡此路分。\n丹灶空遗鸡犬恨，青山谁吊鹿麋群。\n蓬莱今古知何在，秋草唯添处处坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天育道中","author":"薛嵎","text":"除将吟卷外，琴与鹤相随。\n问寺路犹远，入山僧未知。\n鸟灵巢佛塔，猿饮挂藤枝。\n陵谷几迁变，道傍横古碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天童寺","author":"薛嵎","text":"佛界似仙居，楼台出翠微。\n浙中山水最，海内衲僧归。\n草树有真意，禽鱼尽息机。\n禅房无别事，唯见白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太古元西堂过万寿谒住山肇淮海禅师并简","author":"薛嵎","text":"老子旧知己，江湖独尔思。\n此行逢作者，送别若为辞。\n风雨过春半，诗书滞海涯。\n心心傥相印，亦足慰衰迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太白山观雪","author":"薛嵎","text":"二十里松声，千山雪未晴。\n人当绝顶见，吟到此时清。\n大地球琳满，空林鸟雀惊。\n老僧观物化，无灭亦无生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"开炉节赋","author":"薛嵎","text":"闲身何所似，丈室老维摩。\n茅屋地炉小，荒园树叶多。\n移窗就梅影，晒草补渔蓑。\n似此宁辞苦，边寒尚枕戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方氏墓庐扁曰白云飞处","author":"薛嵎","text":"诸峰互隐蔽，一望一增悲。\n触目易成感，思亲无尽时。\n松扉阴似雨，翁仲立如痴。\n出岫亦何意，悠然自不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月海远上人游方过灵隐","author":"薛嵎","text":"一点灵光在，月生沧海深。\n此中难著语，何处可相寻。\n野寺斋无定，穷冬日易阴。\n听松行九里，却坐冷泉吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王九山挽诗 其二","author":"薛嵎","text":"修行过衲子，蔬饭几昏晨。\n自草休官疏，犹嫌在世身。\n片云先冢近，寒月万松邻。\n为鬼还应别，平生有善因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王九山挽诗 其三","author":"薛嵎","text":"俗论鄙迂儒，公胡独受欺。\n焦桐方入调，夜鹊忽惊枝。\n心事将谁许，身名负己知。\n九原如可作，白首誓为期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王九山挽诗 其一","author":"薛嵎","text":"古史无完傅，清风独可模。\n从谁问出处，举世在泥涂。\n气直于时忤，身荣与道俱。\n士林为重惜，挥泪奠生刍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王九山提刑于子城西旧宅累石作小阜见示五言因次韵奉呈","author":"薛嵎","text":"幽怀随所寓，数石几窗前。\n荆棘傥迷道，山林空浩然。\n云生宁择地，龙处即为渊。\n谁谓达观士，终当违市廛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王民山惠诗","author":"薛嵎","text":"民山名字出，朋辈独推先。\n不奉寒暄问，于今四十年。\n传来诗似锦，倏去步如仙。\n自古山林士，无营貌亦贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬兰","author":"薛嵎","text":"出林讵为晚，知我岁寒心。\n不入离骚怨，来亲冰雪吟。\n众芳归槁壤，独干长穷阴。\n为有幽人致，相看情倍深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古淡师然公游方","author":"薛嵎","text":"野僧携锡别，何处度残春。\n天地无穷事，江湖自在身。\n真心齐得物，道貌异于人。\n昔日安禅地，深山虎亦驯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古淡然老得帖住长芦不受却归松风旧寺次社中韵","author":"薛嵎","text":"拄杖挑云上半肩，寻幽重到旧栖禅。\n浮生多故成南北，白发相惊问岁年。\n房闭松声难辨雨，山连海脉暗通泉。\n自从勇却长芦请，猿鹤终宵亦稳眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湖外别业四咏 其一 归洁庵","author":"薛嵎","text":"行藏自有意，非命亦非时。\n洗耳笑心褊，折腰惭悟迟。\n荣枯花上见，寒暑鬓边知。\n独立衡门下，悠悠千古思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"本无师与槐径弟交游二十年矣古人谓百篇诗尽和一盏酒须分余于二公亦云槐径既殁本无编其往来之诗号曰云林酬唱僭述鄙句奉呈","author":"薛嵎","text":"中年为此别，悲动故交情。\n案上云林卷，山中风木声。\n梦回惊复喜，诗在死如生。\n几番西郊路，逢师独自行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"本无师住甸阳山庵","author":"薛嵎","text":"万松围坐石，大海浴金轮。\n不识入城路，唯脩成佛身。\n出生来虎子，持咒拱山神。\n何必工吟苦，机锋自绝尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石窗通上人南游并谒刘后村","author":"薛嵎","text":"所师郊与岛，知己又应难。\n羽檄边烽急，风霜岁事残。\n出家忘路远，度海识天宽。\n文畅浮屠者，当时亦慕韩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再别徐太古主簿","author":"薛嵎","text":"枌社过从久，新知尽不如。\n素心非必仕，此别遂成疏。\n清苦辞藜藿，寒暄慎起居。\n川途脩复阻，相忆眇愁予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘荆山归自惟扬新营渔屋退居","author":"薛嵎","text":"谩道归来晚，闲中日最长。\n渔翁尊齿序，客子效戎装。\n野水涵秋霁，风荷动夕阳。\n十年毕婚嫁，亦胜为人忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘荆山渔屋","author":"薛嵎","text":"客星沉没钓台空，千载风流独此翁。\n万顷波心歌杜若，九霄云外见冥鸿。\n已将名字编渔户，只有琴书在室中。\n杨柳烟深杖藜出，满头衰白任春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘荆山谒贾秋壑","author":"薛嵎","text":"鬓丝千缕去冲寒，酒放诗豪强自宽。\n天下英雄从古少，人生遇合至今难。\n婚姻债里抛吟屋，雨雪声中起客单。\n造物与君强健在，归囊知有暮年欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁暮书怀","author":"薛嵎","text":"园林春又近，老态更无欢。\n添岁儿童喜，照贫灯火寒。\n直心嗟道丧，多事识才难。\n已种梅千树，从今烂熳看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱氏云壑","author":"薛嵎","text":"舒卷悠悠付太空，居然丘壑具胸中。\n人生知己终难必，世上无心自不同。\n片石若浮龙在水，远峰欲露树吟风。\n羡君隐处有如此，想见诗成字字工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟泊曹娥祠下","author":"薛嵎","text":"身没一朝事，孝名垂至今。\n江空夜涛泣，日落雾天阴。\n社祭陈箫鼓，蛮歌进宝琛。\n予生无愧怍，风浪不惊心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过村翁家","author":"薛嵎","text":"白发茅茨下，耰锄力未衰。\n儿孙收滞穗，鸡犬入寒篱。\n俗朴人家善，山深井税迟。\n能言耆旧事，相问坐移时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初夏过湖外别业","author":"薛嵎","text":"郊原新绿喜初晴，一曲湖光潋滟明。\n几处楼台空锁钥，百年人物尽丘茔。\n好花自分随春去，恶木宁思择地生。\n独念索居闻识寡，夜窗长对读书檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别鹤","author":"薛嵎","text":"见说瀛洲万里程，相思犹觊下青冥。\n已归天上神仙籍，不就人间饮啄腥。\n昨夜月明如失友，故园笼在且休扃。\n邻家亦有雏堪待，丹顶微微振薄翎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"君成弟清溪","author":"薛嵎","text":"孺子歌犹在，沧浪可濯缨。\n流来如玉洁，止处似心平。\n鱼避飞凫影，荷添落雨声。\n诗书源更远，千古媲交情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"君誉病愈相访","author":"薛嵎","text":"有谁怜我老，贤弟独知心。\n月夜空相忆，梅花都未吟。\n愁因失鹤致，贫为买山深。\n连日勤过记，新篘得共斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30493,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈井南刘主簿","author":"薛嵎","text":"何处井南居，青山绕屋庐。\n竹生从碍路，泉响不惊鱼。\n有道貌亦古，淡交情似疏。\n慈亲更弥寿，堂上步徐徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30494,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"园中","author":"薛嵎","text":"莫道趋时拙，书中乐未涯。\n荷锄依树歇，联句笑人迟。\n仙去井犹在，年荒草不衰。\n近来筋力减，累失看花期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30495,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李氏爱山楼","author":"薛嵎","text":"境自吾心会，于焉识所存。\n鸟声喧后寂，树色郭中村。\n静寿备仁理，乾坤悟易门。\n白云同此意，相对亦无言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30496,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近买山范湾自营藏地与亡弟草塘君及外家墓茔悉可跂望感事述情继有是作 其八","author":"薛嵎","text":"赢得青山终老看，闲身受用不须多。\n风霜落木时将暮，功业无心镜懒磨。\n道士共联石鼎句，村童能和草庵歌。\n盖棺一事安排了，肯信光阴去似梭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30497,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近买山范湾自营藏地与亡弟草塘君及外家墓茔悉可跂望感事述情继有是作 其二","author":"薛嵎","text":"外家后事凄凉甚，老妇思亲哭最哀。\n今日青山留我在，他年寒食望甥来。\n极知造物成吾志，可但精灵慰夜台。\n惆怅昔时原上路，独馀宿草见春回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30498,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近买山范湾自营藏地与亡弟草塘君及外家墓茔悉可跂望感事述情继有是作 其六","author":"薛嵎","text":"分明来日已无几，还似参禅未透时。\n吟骨纵清难免死，黄菁多啖亦充饥。\n题诗遣得山精去，近俗偏将古墓夷。\n合眼便为泉下鬼，此身康济莫宜迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30499,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近买山范湾自营藏地与亡弟草塘君及外家墓茔悉可跂望感事述情继有是作 其三","author":"薛嵎","text":"草塘相望隔重云，愧我为兄蚤哭君。\n少日对吟听夜雨，老来无计抚孤坟。\n泉台冥漠唯增感，人事安排已十分。\n莫待他年推吉应，如今友爱最先闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30500,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近买山范湾自营藏地与亡弟草塘君及外家墓茔悉可跂望感事述情继有是作 其一","author":"薛嵎","text":"因缘还是范湾边，乾巽峰高四应全。\n千古青山逢具眼，数茎秋鬓近衰年。\n倒骑黄犊循来路，贪看行龙下远田。\n惭愧邻翁为指说，传闻此地产英贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30501,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近买山范湾自营藏地与亡弟草塘君及外家墓茔悉可跂望感事述情继有是作 其五","author":"薛嵎","text":"十万买山浑可事，放教身死骨犹香。\n不知筋力何年尽，看到杉松几尺长。\n管郭岂能谋富贵，诗书元自著兴亡。\n采薇歌在无人识，千载清风独首阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30502,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近买山范湾自营藏地与亡弟草塘君及外家墓茔悉可跂望感事述情继有是作 其七","author":"薛嵎","text":"大有公卿弗似吾，一枝藤上挂葫芦。\n旋疏苔石通崖溜，自祝山神保鹤雏。\n休羡铭旌题极品，试将槐树植三株。\n依然此事凭阴德，从古幽明理不殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30503,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近买山范湾自营藏地与亡弟草塘君及外家墓茔悉可跂望感事述情继有是作 其九","author":"薛嵎","text":"山中百事且休闻，也莫参禅莫鍊神。\n缠树古藤无了日，随风乱叶岂由身。\n闲来景物吟方到，静处工夫识始真。\n想得大槐宫里梦，日高犹有未醒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30504,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近买山范湾自营藏地与亡弟草塘君及外家墓茔悉可跂望感事述情继有是作 其十","author":"薛嵎","text":"依然且作住庵看，茆屋三间办不难。\n户外莫容千驷马，客床唯置两蒲团。\n深林藏虎风长怒，短木支门睡自安。\n西北干戈犹未已，偶逢乐土度衰残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30505,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近买山范湾自营藏地与亡弟草塘君及外家墓茔悉可跂望感事述情继有是作 其四","author":"薛嵎","text":"敢慕昔贤居旷达，分甘吟骨寄山阿。\n刘伶常备随身锸，陶令曾为自挽歌。\n未必浮生于此悟，算来忙处为人多。\n北邙原上堪回首，莫枉心情用太过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30506,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还甘泉沈氏诗卷","author":"薛嵎","text":"之人吾畏友，相望水东西。\n笔下山林趣，诗中五十题。\n读书长闭户，自奉只羹藜。\n名字他年出，双松应共齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30507,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"还寓乐侄诗卷","author":"薛嵎","text":"吾诗吟未了，今尔亦工吟。\n笔下心思苦，书中理趣深。\n青灯宜远到，白日易西沈。\n多谢怜衰疾，连朝独见临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30508,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邵氏悦心堂","author":"薛嵎","text":"扰扰利名役，鬓髭霜雪侵。\n要知充此性，即是悦吾心。\n有道境常裕，无营味最深。\n纷华安肯羡，出见更酣沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30509,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居杂兴十首 其十","author":"薛嵎","text":"白发天应弃，春风吹不青。\n神仙归恍惚，书传出英灵。\n周粟岂医饿，湘流难活醒。\n迄今名字在，百世仰芳馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30510,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居杂兴十首 其九","author":"薛嵎","text":"近觉吟无趣，权将俗累删。\n莺花老眼倦，风雨半春闲。\n野面便粗褐，柴扉掩暮山。\n片云寻处泊，飞度竹檐间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30511,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居杂兴十首 其八","author":"薛嵎","text":"土木非吾事，支东复拄西。\n雨盈沟壅叶，檐侧础沈泥。\n护壁时编苇，登楼恐折梯。\n若无忧挠至，终岁亦安栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30512,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居杂兴十首 其七","author":"薛嵎","text":"已是中年后，何当绝悔尤。\n渔樵非始志，灯火企前脩。\n叶落秋容见，巢倾鹤貌愁。\n诗穷安敢避，天为拙人谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30513,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居杂兴十首 其六","author":"薛嵎","text":"四时俱橐籥，一气自回旋。\n谁谓春风力，能专万物权。\n荣枯忘晦朔，霜雪抱贞坚。\n赋分有深浅，殊非天道偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30514,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居杂兴十首 其五","author":"薛嵎","text":"闭户谢流俗，青山独自看。\n淡交从古少，冷面对人难。\n农圃元非学，神仙不在丹。\n孤怀无别想，回向此心观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30515,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居杂兴十首 其四","author":"薛嵎","text":"秋虫随响灭，振羽不知疲。\n譬彼附炎士，宁思失势时。\n垂竿动天象，定策茹商芝。\n投分谅非浅，翻然弗可追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30516,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居杂兴十首 其三","author":"薛嵎","text":"铁砚几磨研，依然萤雪边。\n薄才遗圣世，无禄尽亲年。\n多病唯谙药，当寒不识绵。\n素心期淡泊，冰檗誓能坚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30517,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居杂兴十首 其二","author":"薛嵎","text":"昔日黄金屋，十年荆棘林。\n浮生真亦假，世事古犹今。\n电隙无留景，云泉属自心。\n纷纷蜗角里，朝暮几升沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30518,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居杂兴十首 其一","author":"薛嵎","text":"亦有入城路，门前秋草长。\n荷锄书在手，负锸醉为乡。\n霜渡溪流涩，厨烟树叶香。\n为贫从俭约，犹欠半年粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30519,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居言怀","author":"薛嵎","text":"老子从来不为名，放教心地到和平。\n庭前草色知春近，窗外梅花终夜明。\n纸帐梦回移月影，石溪流断失滩声。\n吟边莫问红尘事，只住茅茨亦自清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30520,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐课子侄","author":"薛嵎","text":"微风弄孤烛，蛬响泣将晨。\n欲办男儿事，当为志气人。\n箪瓢非外乐，韦布只身贫。\n慎勿忘科第，务求荣尔亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30521,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松冈过许峰送葬","author":"薛嵎","text":"此行吟更苦，哭舅万山深。\n处士花犹昔，何人诗在今。\n奉亲无旅况，对佛动慈心。\n霜夜增寒思，半床安纸衾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30522,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松风隆首座住云际禅院","author":"薛嵎","text":"山门开望海，钟鼓动鱼龙。\n人具慈悲相，秋生寂寞容。\n随身唯一钵，留偈别双松。\n后夜桥西月，支筇失所从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30523,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林氏梅岩","author":"薛嵎","text":"古意元从澹泊来，云根香雪点矶苔。\n静观造化春长在，不是冰霜冻得开。\n半影落池涵洁白，一峰无路接尘埃。\n逋仙家世君端的，只恐清吟未易陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30524,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]