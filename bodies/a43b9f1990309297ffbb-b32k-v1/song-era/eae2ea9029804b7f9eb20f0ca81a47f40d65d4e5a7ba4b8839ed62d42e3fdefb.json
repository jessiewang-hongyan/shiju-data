[{"title":"剪牡丹 舟中闻双琵琶","author":"张先","text":"野绿连空，天青垂水，素色溶漾都净。\n柔柳摇摇，坠轻絮无影。\n汀洲日落人归，修巾薄袂，撷香拾翠相竞。\n如解凌波，泊烟渚春暝。\n彩绦朱索新整。\n宿绣屏、画船风定。\n金凤响双槽，弹出今古幽思谁省。\n玉盘大小乱珠迸。\n酒上妆面，花艳媚相并。\n重听。\n尽汉妃一曲，江空月静。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜双双 溪桥寄意","author":"张先","text":"城上层楼天边路。\n残照里，平芜绿树。\n伤远更惜春暮。\n有人还在高高处。\n断梦归云经日去。\n无计使，哀弦寄语。\n相望恨不相遇。\n倚桥临水谁家住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惜琼花","author":"张先","text":"汀蘋白。\n苕水碧。\n每逢花驻乐，随处欢席。\n别时携手看春色。\n萤火而今，飞破秋夕。\n旱河流，如带窄。\n任身轻似叶，何计归得。\n断云孤鹜青山极。\n楼上徘徊，无尽相忆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南/忆江南 与龙靓","author":"张先","text":"青楼宴，靓女荐瑶杯。\n一曲白云江月满，际天拖练夜潮来。\n人物误瑶台。\n醺醺酒，拂拂上双腮。\n媚脸已非朱淡粉，香红全胜雪笼梅。\n标格外尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南/忆江南 闺情","author":"张先","text":"香闺内、空自想佳期。\n独步花阴情绪乱，谩将珠泪两行垂。\n胜会在何时。\n厌厌病，此夕最难持。\n一点芳心无托处，荼蘼架上月迟迟。\n惆怅有谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦仙游","author":"张先","text":"江东苏小。\n夭斜窈窕。\n都不胜、彩鸾娇妙。\n春艳上新妆。\n肌肉过人香。\n佳树阴阴池院。\n华灯绣幔。\n花月好、可能长见。\n离聚此生缘。\n无计问天天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐","author":"张先","text":"青袍如草。\n得意还年少。\n马跃绿螭金络脑。\n寒食乍临新晓。\n曲池斜度鸾桥。\n西园一片笙箫。\n自欲胜留春住，风花无奈飘飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其二 李阁使席","author":"张先","text":"清歌逐酒。\n腻脸生红透。\n樱小杏青寒食后。\n衣换缕金轻绣。\n画堂新月朱扉。\n严城夜鼓声迟。\n细看玉人娇面，春光不在花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 其一","author":"张先","text":"屏山斜展。\n帐卷红绡半。\n泥浅曲池飞海燕。\n风度杨花满院。\n云情雨意空深。\n觉来一枕春阴。\n陇上梅花落尽，江南消息沈沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 和程公辟赠别","author":"张先","text":"巴子城头青草暮，巴山重叠相逢处。\n燕子占巢花脱树。\n杯且举，瞿塘水阔舟难渡。\n天外吴门青雪路，君家正在吴门住。\n赠我柳枝情几许。\n春满缕，为君将入江南去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菊花新","author":"张先","text":"堕髻慵妆来日暮。\n家在画桥堤下住。\n衣缓绛绡垂，琼树袅、一枝红雾。\n院深池静娇相妒。\n粉墙低、乐声时度。\n长恐舞筵空，轻化作、彩云飞去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮","author":"张先","text":"闻人语著仙卿字。\n瞋情恨意还须喜。\n何况草长时。\n酒前频共伊。\n娇香堆宝帐。\n月到梨花上。\n心事两人知。\n掩灯罗幕垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮","author":"张先","text":"玉人又是匆匆去。\n马蹄何处垂杨路。\n残日倚楼时。\n断魂郎未知。\n阑干移倚遍。\n薄倖教人怨。\n明月却多情。\n随人处处行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮","author":"张先","text":"藕丝衫剪猩红窄。\n衫轻不碍琼肤白。\n缦鬓小横波。\n花楼东是家。\n上湖闲荡桨。\n粉艳芙蓉样。\n湖水亦多情。\n照妆天底清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮","author":"张先","text":"忆郎还上层楼曲。\n楼前芳草年年绿。\n绿似去时袍。\n回头风袖飘。\n郎袍应已旧。\n颜色非长久。\n惜恐镜中春。\n不如花草新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其四 七夕","author":"张先","text":"双针竞引双丝缕。\n家家尽道迎牛女。\n不见渡河时。\n空闻乌鹊飞。\n西南低片月。\n应恐云梳发。\n寄语问星津。\n谁为得巧人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮","author":"张先","text":"佳人学得平阳曲。\n纤纤玉笋横孤竹。\n一弄入云声。\n海门江月清。\n髻摇金钿落。\n惜恐樱唇薄。\n听罢已依依。\n莫吹杨柳枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其四","author":"张先","text":"簟纹衫色娇黄浅。\n钗头秋叶玲珑剪。\n轻怯瘦腰身。\n纱窗病起人。\n相思魂欲绝。\n莫话新秋别。\n何处断离肠。\n西风昨夜凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其三","author":"张先","text":"夜深不至春蟾见。\n令人更更情飞乱。\n翠幕动风亭。\n时疑响屟声。\n花香闻水榭。\n几误飘衣麝。\n不忍下朱扉。\n绕廊重待伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其三 七夕","author":"张先","text":"牛星织女年年别。\n分明不及人间物。\n匹鸟少孤飞。\n断沙犹并栖。\n洗车昏雨过。\n缺月云中堕。\n斜汉晓依依。\n暗蛩还促机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜朝天/踏莎行 清暑堂赠蔡君谟","author":"张先","text":"晓云开。\n睨仙馆陵虚，步入蓬莱。\n玉宇琼甃，对青林近，归鸟徘徊。\n风月顿消清暑，野色对、江山助诗才。\n箫鼓宴，璇题宝字，浮动持杯。\n人多送目天际，识渡舟帆小，时见潮回。\n故国千里，共十万室，日日春台。\n睢社朝京非远，正和羹、民口渴盐梅。\n佳景在，吴侬还望，分阃重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御街行","author":"张先","text":"夭非花艳轻非雾。\n来夜半、天明去。\n来如春梦不多时，去似朝云何处。\n远鸡栖燕，落星沈月，紞紞城头鼓。\n参差渐辨西池树。\n珠阁斜开户。\n绿苔深径少人行，苔上屐痕无数。\n馀香遗粉，剩衾闲枕，天把多情付。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御街行 送蜀客","author":"张先","text":"画船横倚烟溪半。\n春入吴山遍。\n主人凭客且迟留，程入花溪远远。\n数声芦叶，两行霓袖，几处成离宴。\n纷纷归骑亭皋晚。\n风顺樯乌转。\n古今为别最消魂，因别有情须怨。\n更独自、尽上高台望，望尽飞云断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢池春慢 玉仙观道中逢谢媚卿","author":"张先","text":"缭墙重院，时闻有、啼莺到。\n绣被掩馀寒，画幕明新晓。\n朱槛连空阔，飞絮无多少。\n径莎平，池水渺。\n日长风静，花影闲相照。\n尘香拂马，逢谢女、城南道。\n秀艳过施粉，多媚生轻笑。\n斗色鲜衣薄，碾玉双蝉小。\n欢难偶，春过了。\n琵琶流怨，都入相思调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"塞垣春 寄子山","author":"张先","text":"野树秋声满。\n对雨壁、风灯乱。\n云低翠帐，烟销素被，签动重幔。\n甚客怀、先自无消遣。\n更篱落、秋虫叹。\n叹樊川、风流减。\n旧欢难得重见。\n停酒说扬州，平山月、应照棋观。\n绿绮为谁弹，空传广陵散。\n但光纱短帽，窄袖轻衫，犹记竹西庭院。\n老鹤何时去，认琼花一面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 安东少师访阅道大资同游湖山","author":"张先","text":"廊庙当时共代工。\n睢陵千里远，约过从。\n欲知宾主与谁同。\n宗枝内，黄阁旧，有三公。\n广乐起云中。\n湖山看画轴，两仙翁。\n武林嘉语几时穷。\n元丰际，德星聚，照江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小重山","author":"张先","text":"万乘靴袍御紫宸。\n挥毫敷丽藻，尽经纶。\n第名天陛首平津。\n东堂桂，重占一枝春。\n殊观耸簪绅。\n蓬山仙话重，霈恩新。\n暂时趋府冠谈宾。\n十年外，身是凤池人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小重山 徐铎状元","author":"张先","text":"延寿芸香七世孙。\n华轩承大对，见经纶。\n溟鱼一息化天津。\n袍如草，三百骑，从清尘。\n玉树莹风神。\n同时棠棣萼，一家春。\n十年身是凤池人。\n蓬莱阁，黄阁主，迟谈宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 初春","author":"张先","text":"飘尽寒梅，笑粉蝶、游蜂未觉。\n渐迤逦、水明山秀，暖生帘幕。\n过雨小桃红未透，舞烟新柳青犹弱。\n记画桥，深处水边亭，曾偷约。\n多少恨，今犹昨；愁和闷，都忘却。\n拚从前烂醉，被花迷着。\n晴鸽试铃风力软，雏莺弄舌春寒薄。\n但只愁，锦绣闹妆时，东风恶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人","author":"张先","text":"苕花飞尽汀风定。\n苕水天摇影。\n画船罗绮满溪春。\n一曲石城清响、入高云。\n壶觞昔岁同歌舞。\n今日无欢侣。\n南园花少故人稀。\n月照玉楼依旧、似当时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人 述古移南郡","author":"张先","text":"恩如明月家家到。\n无处无清照。\n一帆秋色共云遥。\n眼力不知人远、上江桥。\n愿君书札来双鲤。\n古汴东流水。\n宋王台畔楚宫西。\n正是节趣归路、近沙堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹊桥仙","author":"张先","text":"星桥火树，长安一夜，开遍红莲万蕊。\n绮罗能借月中春，风露细、天清似水。\n重城闭月，青楼夸乐，人在银潢影里。\n画屏期约近收灯，归步急、双鸳欲起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙州慢 赠述古","author":"张先","text":"武林乡，占第一湖山，咏画争巧。\n鹫石飞来，倚翠楼烟霭，清猿啼晓。\n况值禁垣师帅，惠政流入欢谣。\n朝暮万景，寒潮弄月，乱峰回照。\n天使寻春不早。\n并行乐，免有花愁花笑。\n持酒更听，红儿肉声长调。\n潇湘故人未归，但目送游云孤鸟。\n际天杪。\n离情尽寄芳草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"碧牡丹 晏同叔出姬","author":"张先","text":"步帐摇红绮。\n晓月堕，沈烟砌。\n缓板香檀，唱彻伊家新制。\n怨入眉头，敛黛峰横翠。\n芭蕉寒，雨声碎。\n镜华翳。\n闲照孤鸾戏。\n思量去时容易。\n钿盒瑶钗，至今冷落轻弃。\n望极蓝桥，但暮云千里。\n几重山，几重水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其一","author":"张先","text":"临水人家深宅院。\n阶下残花，门外斜阳岸。\n柳舞曲尘千万线。\n青楼百尺临天半。\n楼上东风春不浅。\n十二阑干，尽日珠帘卷。\n有个离人凝泪眼。\n淡烟芳草连云远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其三","author":"张先","text":"绿水波平花烂漫。\n照影红妆，步转垂杨岸。\n别后深情将为断。\n相逢添得人留恋。\n絮软丝轻无系绊。\n烟惹风迎，并入春心乱。\n和泪语娇声又颤。\n行行尽远犹回面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 其四","author":"张先","text":"移得绿杨栽后院。\n学舞宫腰，二月青犹短。\n不比灞陵多送远。\n残丝乱絮东西岸。\n几叶小眉寒不展。\n莫唱阳关，真个肠先断。\n分付与春休细看。\n条条尽是离人怨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏莎行 其一","author":"张先","text":"衾凤犹温，笼鹦尚睡。\n宿妆稀淡眉成字。\n映花避月上行廊，珠裙摺摺轻垂地。\n翠幕成波，新荷贴水。\n纷纷烟柳低还起。\n重墙绕院更重门，春风无路通深意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏莎行 其二","author":"张先","text":"波湛横眸，霞分腻脸。\n盈盈笑动笼香靥。\n有情未结凤楼欢，无憀爱把歌眉敛。\n密意欲传，娇羞未敢。\n斜偎象板还偷盰。\n轻轻试问借人么，佯佯不觑云鬟点。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉红妆","author":"张先","text":"琼林玉树不相饶。\n薄云衣，细柳腰。\n一般妆样百般娇。\n眉儿秀，总如描。\n东风摇草杂花飘。\n恨无计，上青条。\n更起双歌郎且饮，郎未醉，有金貂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉垂鞭 其一","author":"张先","text":"双蝶绣罗裙，东池宴，初相见。\n朱粉不深匀，闲花淡淡春。\n细看诸处好，人人道，柳腰身。\n昨日乱山昏，来时衣上云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉垂鞭 钱塘送祖择之","author":"张先","text":"酒面滟金鱼。\n吴娃唱。\n吴潮上。\n玉殿白麻书。\n待君归后除。\n勾留风月好。\n平湖晓。\n翠峰孤。\n此景出关无。\n西州空画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉垂鞭 其二 赠琵琶娘，年十二","author":"张先","text":"朱粉不须施。\n花枝小。\n春偏好。\n娇妙近胜衣。\n轻罗红雾垂。\n琵琶金画凤。\n双绦重。\n倦眉低。\n啄木细声迟。\n黄蜂花上飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉桃源 渭州作","author":"张先","text":"双花连袂近香猊。\n歌随镂板齐。\n分明珠索漱烟溪。\n凝云定不飞。\n唇破点，齿编犀。\n春莺莫乱啼。\n阳关更在碧峰西。\n相看翠黛低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉桃源","author":"张先","text":"落花浮水树临池。\n年前心眼期。\n见来无事去还思。\n如今花又飞。\n浅螺黛，淡胭脂。\n开花取次宜。\n隔帘灯影闭门时。\n此情风月知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉落魄/一斛珠","author":"张先","text":"云轻柳弱。\n内家髻要新梳掠。\n生香真色人难学。\n横管孤吹，月淡天垂幕。\n朱唇浅破桃花萼。\n倚楼谁在阑干角。\n夜寒手冷罗衣薄。\n声入霜林，簌簌惊梅落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉落魄 吴兴莘老席上","author":"张先","text":"山围画障。\n风溪弄月清溶漾。\n玉楼苕馆人相望。\n下若醲醅，竞欲金钗当。\n使君劝醉青娥唱。\n分明仙曲云中响。\n南园百卉千家赏。\n和气兼春，不独花枝上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕归梁 其二","author":"张先","text":"夜月啼乌促乱弦。\n江树远无烟。\n缺多圆少奈何天。\n愁只恐、下关山。\n粉香生润，衣珠弄彩，人月两蝉娟。\n留连残夜惜馀欢。\n人月在、又明年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"燕归梁 其一","author":"张先","text":"去岁中秋玩桂轮。\n河汉净无云。\n今年江上共瑶尊。\n都不是、去年人。\n水精宫殿，琉璃台阁，红翠两行分。\n点唇机动秀眉颦。\n清影外、见微尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"张先","text":"湖山隐后家空在，烟雨词亡草自青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"张先","text":"愁似鳏鱼知夜永，懒同蝴蝶为春忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"张先","text":"霓舟忽舣鲈鱼乡，槎阁却凌云汉域。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"张先","text":"但怪鲈乡一旦成，分却松江半秋色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汤公洞","author":"张同甫","text":"万点波光映古丘，林深云锁洞门秋。\n是谁订我重来约，携手相将到白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日忆友","author":"张同甫","text":"阊阖风高白露秋，芦花如雪动边愁。\n故人迢递天南北，明月娟娟独倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题兴龙寺老柏院","author":"张在","text":"南邻北舍牡丹开，年少寻芳日几回。\n惟有君家老柏树，春风来似不曾来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张存","text":"当时不葬曹横墓，千古犹存方茂山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"延福寺","author":"张守质","text":"步入禅关一径赊，摄衣登眺夕阳斜。\n金溪碧落千条练，紫塔光涵五色霞。\n月系扁舟渔火渡，风清古碣隐君家。\n游人亦卧东山麓，醉倚烟萝学种瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题灵龟洞","author":"张安修","text":"何年六丁驱霹雳，苍龙惊起穿崖石。\n拿雷掣电卷波涛，来与真仙分窟宅。\n上崖窅深如侧瓮，下崖谽谺如空洞。\n不知泉脉从何来，百面鼙鼓长汹涌。\n大灵闯首浮中流，背隐八卦开双眸。\n似闻夏潦不能没，疑有神仙司诸幽。\n我曾雁荡观龙鼻，半日才通涓滴水。\n岂如六月散甘霖，灵泉滚滚无穷已。\n惜哉埋没荒烟中，车马来稀三叠重。\n若教遗向飞来峰，龙井冷泉皆下风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐家庄","author":"张尧同","text":"节义穷方见，高名荐玉京。\n一封天子敕，千载故乡荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉禾百咏 其八十 曹使君祠","author":"张尧同","text":"一笑淮兵却，功成未易论。\n岂惭颜刺史，诗酒在平原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉禾百咏 其七十三 三过堂","author":"张尧同","text":"题诗三过此，坡老昔时曾。\n悟得成禅指，来为打睡僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉禾百咏 其六十三 三塔","author":"张尧同","text":"石匮埋神物，灵光照夜多。\n龙归天上后，无复更风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉禾百咏 其九十 卫墓","author":"张尧同","text":"惆怅黎阳客，飘流浙水滨。\n定忘空腹恨，知是赤心人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":50715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]