[{"title":"咏大","author":"孔平仲","text":"观水宣尼志，歌风汉祖篇。\n鹏抟九万里，椿寿八千年。\n老子能谈道，唐尧亦法天。\n旅獒宜自戒，魏瓠不胜坚。\n西域瓜如斛，东山栗比拳。\n周蒿芟作柱，舜竹截为船。\n鲁语讥居蔡，邠诗咏献豜。\n雷声当拟圣，人迹谩疑仙。\n宝训书传百，真乘界说千。\n弓闻阳虎窃，鼎自郜城迁。\n冯异依乔木，刘公受一钱。\n小鲜无挠国，多稼最宜田。\n骨有专车异，珠求径寸圆。\n瘿垂惊瓮盎，雹下骇杯棬。\n船泛银山浪，琴操急雨弦。\n恐时心缦缦，卧处腹便便。\n公罢三名府，官防五在边。\n从容隐朝市，指顾奠山川。\n已识古今体，且知天地全。\n介圭催入觐，夏屋示优贤。\n金印悬如斗，神毫运若椽。\n安荣可长享，儒效照青编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新作西庵将及春景戏成两诗请李思中节推同赋 其一","author":"孔平仲","text":"鄙性常山野，尤甘草舍中。\n钩帘阴卷柏，障壁坐防风。\n客土依云实，流泉架木通。\n行当归老去，已逼白头翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新作西庵将及春景戏成两诗请李思中节推同赋 其二","author":"孔平仲","text":"昨叶何摇落，今逢淑景天。\n山椒红杏火，岩石绿苔烟。\n炉火沉香烬，琴丝续断弦。\n忍冬已彻骨，衰白及长年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再赋 其一","author":"孔平仲","text":"楚泽兰纫佩，廉泉水洗心。\n荷锄通草径，戴笠钩藤阴。\n欲蚤休陈事，须甘遂陆沈。\n谩呈诗藁本，李杜若知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再赋 其二","author":"孔平仲","text":"郁郁金舒柳，青青黛染槐。\n繁阴庭侧柏，碎绿井中苔。\n雨漏芦檐破，风薰草意回。\n陟釐题短句，自洗笔头灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再赋 其一","author":"孔平仲","text":"冻地榆抽笋，寒山药长苗。\n老翁须自白，积雪草方夭。\n折桂心安在，屠龙胆已消。\n花前胡不醉，排闷合欢谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再赋 其二","author":"孔平仲","text":"此地龙舒国，池隍战血馀。\n木香多是橘，石乳最宜鱼。\n古瓦松杉冷，旱天麻麦疏。\n题诗云母纸，笺腻粉难书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再赋 其一","author":"孔平仲","text":"百草霜雪死，半天河汉斜。\n竹含轻紫粉，梅发淡红花。\n蘸甲香醪酽，搔头垢发华。\n北亭欢宴罢，灯烛夜明沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再赋 其二","author":"孔平仲","text":"起自然铜鼎，烹茶滴乳香。\n深冬灰正冷，新腊雪须当。\n我意空青眼，君才贯众长。\n唱酬几百合，衰白荷相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李思中服阕入京","author":"孔平仲","text":"久客乌头白，家无石斛储。\n谙寻小草木，心合大空虚。\n已耐冬寒过，新知母服除。\n铜青即金紫，无患子穷居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬惠诗","author":"孔平仲","text":"屡得真珠玉，天葩兰麝香。\n书灯心最苦，坐石胆应凉。\n松桂枝柯老，蛟龙骨骼长。\n急追无及已，请附子馀光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离合转韵寄常父","author":"孔平仲","text":"舒州寄官舍，舍在潜峰下。\n密迩豫章城，山川无十程。\n音书常络绎，日日通消息。\n况复多唱酬，兄埙弟竽笛。\n秋风鸣竹林，火退避新金。\n怅望南来雁，长年空此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又一首离合转韵寄孙虢州","author":"孔平仲","text":"鳜鲩饮石乳，鱼中最温补。\n字画尚茫然，何由食鲜□。\n漆林自小足，水绕庵前竹。\n君性本清高，伊人又閒熟。\n三堂秋际馀，一枕梦回初。\n斤斧却无事，新诗或起予。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"药名离合四时四首 其一","author":"孔平仲","text":"草满南园绿，青青复间红。\n花开不择地，锦绣径相通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"药名离合四时四首 其二","author":"孔平仲","text":"浆寒饮一石，蜜液和岩桂。\n心渴望天南，星河灿垂地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"药名离合四时四首 其三","author":"孔平仲","text":"参旗挂疏木，通夕凉如水。\n银汉耿半天，河桥暝烟紫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"药名离合四时四首 其四","author":"孔平仲","text":"雪片拥颓垣，衣裘冷于甲。\n香醪不满榼，藤枕攲残腊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"药名离合寄孙虢州 其一","author":"孔平仲","text":"孙八远在虢，丹霞绚崔苍。\n耳目虽清远，志愿多参商。\n陆沉众人中，白首滞铅黄。\n耆英绍前烈，当复佐兴王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"药名离合寄孙虢州 其二","author":"孔平仲","text":"朴也才通贯，众安无吠狗。\n杞菊饭家常，山泉消昼漏。\n芦雁来蔽空，青眼思朋旧。\n历日惊晚景，天涯情更厚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十三日南湖之集宾主六人谨成诗十韵拜呈","author":"孔平仲","text":"律管秋灰动，铢衣暑服轻。\n居官半舜牧，环坐列周卿。\n揽辔湖边集，谈经席上倾。\n逸交希李白，奇策拟陈平。\n博奕休言戏，韬钤且议兵。\n续笺诗义白，重演卦爻成。\n午日停龙驭，西风驻鹢程。\n弓钧寒力壮，天暮霁华明。\n绿野接乡遂，良辰推甲庚。\n浴沂人已散，终日梦魂清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再吟六诗四首拜呈 其一","author":"孔平仲","text":"摩天皆劲翮，对垒尽雄诗。\n汉士增三杰，唐儒益二夔。\n素修同德行，良会展尊彝。\n耻佩苏秦印，閒吟谷永诗。\n郡条颁美政，邦典守新规。\n暗换阴阳气，平分昼夜时。\n南朝馀草树，战国旧城池。\n弱跪霜前蟹，奇眸水底龟。\n风标观画鹤，祸福中灵棋。\n尼父谈诸蔽，尤当谨礼仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再吟六诗四首拜呈 其二","author":"孔平仲","text":"累日欲修礼，今兹清饮陪。\n位分乾卦画，人比晋卿才。\n宗庙精禋近，侯邦舞羽来。\n光华连七璧，符采缀三台。\n仪凤须论德，良弓自有材。\n雄铓皆帝剑，直节倍公槐。\n吏计无先善，人情且去哀。\n箴思丹扆补，彩喜碧油回。\n穆若亲朋会，欣然肺腑开。\n驰蛟参骏轨，朽驭愧驽骀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再吟六诗四首拜呈 其三","author":"孔平仲","text":"侯服安无事，官曹静不哗。\n畴非信善友，俱是孝廉家。\n荀衮传荣耀，温龙竞爪牙。\n尺舆思附凤，角扇笑萦蛇。\n士习贤科论，人趋太守衙。\n庄衢当自骋，陈药更谁誇。\n和露餐荷叶，临流饮雪花。\n草莱依瑞穗，荆布缀明珈。\n且固官庭守，宁忧柄用赊。\n它时摇玉佩，鳌禁定联华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再吟六诗四首拜呈 其四","author":"孔平仲","text":"龙笛霜号窍，熊旗露缀斿。\n追欢品加豆，偷暇日要囚。\n周冕英才集，商瑚瑞气浮。\n金韬书屡讲，蓬矢志须酬。\n草树双仙岛，风烟半玉楼。\n画图观隰驳，果实采沅榴。\n通贵人无恙，承平府孔修。\n官非剑外久，课比茂陵优。\n时变休成论，皇明已照幽。\n责躬无复事，嘉谷谒高秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十画农谣一首","author":"孔平仲","text":"春雨津浃洽，秋苗香苾芬。\n京坻看便是，完固促修囷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惜别一首呈陆亨儒十画","author":"孔平仲","text":"恬和效春律，芳茂若秋松。\n杯毕花枝放，吴伻俳笑空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九画一首","author":"孔平仲","text":"坦直吾所知，良彦君长者。\n村邦柱材美，丞府依炉冶。\n弗忘念夙昔，吟奕同茇舍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"八画一首","author":"孔平仲","text":"牧守有民社，佳言多告余。\n金芝先出谷，奔召戒征车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七画一首","author":"孔平仲","text":"予兮仲尼后，老作外州行。\n丹穴屯戎伍，朱衣走吏兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十画四言","author":"孔平仲","text":"亨倅沉俗，泥虬卧虹。\n星君促面，省座班封。\n修治克茂，果有昌宗。\n耻于便倖，宜效孤忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其一","author":"孔平仲","text":"君不见潇湘之山衡山高，八月秋高风怒号。\n草木黄落龙正蛰，哀鸿独叫求其曹。\n男儿生无所成头皓白，漂零已是沧浪客。\n呼儿觅纸一题诗，此心炯炯君应识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其二","author":"孔平仲","text":"抱病江天白首郎，秋风此日晒衣裳。\n看我形容已枯槁，此岂有意仍腾骧。\n一官羁绊实藏身，富贵于我如浮云。\n致君尧舜付公等，几时高义排金门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其三","author":"孔平仲","text":"呜呼古人已粪土，纷纷轻薄何须数。\n当面输心背面笑，翻手作云覆手雨。\n感君意气无所惜，于我见子真颜色。\n人生会合不可常，昔者相遇今不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其四","author":"孔平仲","text":"不恨我衰子贵时，经济实藉英雄姿。\n君有长材不贫贱，莫令斩断青云梯。\n骅骝作驹已汗血，坐看千里当霜蹄。\n省郎京尹必俯拾，军符侯印取岂迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其五","author":"孔平仲","text":"岁云暮矣多北风，潇湘洞庭虚映空。\n中有云气随飞龙，黄鹄高于五尺童。\n殊方日落玄猿哭，芜没潇岸千株菊。\n少壮几时奈老何，喧呼且覆杯中渌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其六","author":"孔平仲","text":"老去悲秋强自宽，衰颜欲付紫金丹。\n坐卧只多少行立，岂可久在王侯间。\n与君相逢未恨晚，他日更仆语不浅。\n潇湘水国傍鼋鼍，吏情更觉沧洲远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其七","author":"孔平仲","text":"雄姿逸态何崷崒，自是君身有仙骨。\n彩服日向庭帏趋，百年未见欢娱毕。\n拖玉腰金致主身，起居八座太夫人。\n尔家最近魁三象，文采风流今尚存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其八","author":"孔平仲","text":"思君须向古人求，夙昔一逢无此流。\n文章有神交有道，名位岂肯卑微休。\n倜傥权奇难具论，鸷鸟举翮连青云。\n无路从容陪笑语，使人叹恨伤精魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其九","author":"孔平仲","text":"故人情谊晚难似，神倾意豁真佳士。\n可怜怀抱向人尽，再为后会知何地。\n老大徒伤未拂衣，白头吟望苦低垂。\n鱼龙寂寞秋江冷，不见湘妃鼓瑟时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其十","author":"孔平仲","text":"独立缥缈之飞楼，更有澄江销客愁。\n无边落木萧萧下，万里风烟接素秋。\n天青小城捣练急，渔翁暝踏孤舟立。\n嫩蕊浓花满目斑，临风三嗅馨香泣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其十一","author":"孔平仲","text":"玉几由来天北极，云近蓬莱常五色。\n五更三点入鹓行，朝回君是同舍客。\n岂意出守江城居，此身已愧须人扶。\n青眼高歌望吾子，早据要路岂捐躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其十二","author":"孔平仲","text":"秋风欻吸吹南国，天地黤惨忽异色。\n江石决裂青枫摧，波漂菰米沉云黑。\n儒术于我何有哉，口虽吟咏心中哀。\n隐居欲就庐山远，黄帽青鞋归去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其十三","author":"孔平仲","text":"秋水浮阶溜决渠，啼猿僻在楚山隅。\n白沙翠竹江村暮，斗酒新诗终日疏。\n男儿生不成名身已老，但话夙昔伤怀抱。\n客至从嗔不出迎，逢迎少壮非吾道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其十四","author":"孔平仲","text":"自断此生休问天，焉能终日心拳拳。\n人生几何春已夏，况我与子非壮年。\n东流江水西飞燕，可惜刻漏随更箭。\n细推物理须行乐，只愿无事长相见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其十五","author":"孔平仲","text":"小臣鲁钝无所能，况乃疏顽临事拙。\n今幸乐国养微躯，主恩前后三持节。\n未有涓埃答圣朝，却教江汉客魂销。\n云白山青千万里，便应黄发老渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其十六","author":"孔平仲","text":"秋风萧萧露泥泥，美人娟娟隔秋水。\n扬眉结义黄金台，欲向何门趿朱履。\n案头乾死读书萤，遮莫邻鸡下五更。\n老夫卧稳朝慵起，肯信吾兼吏隐名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其十七","author":"孔平仲","text":"注目寒江倚山阁，碧瓦朱甍照城郭。\n云物不殊乡国异，形胜有馀风土恶。\n阶面青苔老更生，况乃秋后转多蝇。\n巫山不见庐山远，怅望秋天虚翠屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其十八","author":"孔平仲","text":"隐几萧条戴鹖冠，强移栖息一枝安。\n重阳独酌杯中酒，醉把茱萸子细看。\n羞见黄花无数新，当令美味入吾唇。\n久拚野鹤如霜鬓，何用浮名绊此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其十九","author":"孔平仲","text":"高栋层轩已自凉，青枫叶赤天雨霜。\n自公多暇迎参伍，行酒赋诗殊未央。\n共指西日不相贷，万事尽付形骸外。\n自笑狂夫老更狂，诗酒尚堪驱使在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其二十","author":"孔平仲","text":"摇落深知宋玉悲，东流之外西日微。\n寒衣处处催刀尺，谁家捣练风凄凄。\n篱边老却陶潜菊，前飞秃鹙后鸿鹄。\n安得送我置汝旁，怅望聊歌紫芝曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其二十一","author":"孔平仲","text":"秋风淅淅吹我衣，日日江楼坐翠微。\n江光隐见鼋鼍窟，水鸟衔鱼来去飞。\n菱叶荷花净如拭，清簟疏帘看奕棋。\n雷声忽送千峰雨，波涛万顷堆琉璃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其二十二","author":"孔平仲","text":"草阁柴扉星散居，远开山岳散江湖。\n苍苔浊酒林中静，丹橘黄柑此地无。\n洞庭扬波江汉回，愿吹野水添金杯。\n巢燕养雏浑去尽，邻鸡还过短墙来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其二十三","author":"孔平仲","text":"秋来相顾尚飘蓬，兼泛沧浪学钓翁。\n钟鼎山林各天性，知君才是济川功。\n万里寒空只一日，会是排风有毛质。\n攀龙附凤势莫当，莫度清秋吟蟋蟀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其二十四","author":"孔平仲","text":"诸公衮衮登台省，后来况接才华盛。\n天涯风俗自相亲，岁暮阴阳催短景。\n江风飒飒乱帆秋，天入沧浪一钓舟。\n愁极本凭诗遣兴，朔云寒菊倍离忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其二十五","author":"孔平仲","text":"秋水才深四五尺，风灯照夜欲三更。\n千崖无人万壑静，新月犹悬双杵鸣。\n衰颜动觅藜床坐，仰看明星当空大。\n请君一来开我愁，南浮早鼓萧湘柂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其二十六","author":"孔平仲","text":"可怜为人好心事，今我能书数字至。\n人生会面难再得，安得如鸟有羽翅。\n日暮聊为梁父吟，非子谁复见幽心。\n入怀本倚昆山玉，许身愧比双南金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其二十七","author":"孔平仲","text":"腐儒衰晚谬通籍，齿牙欲落真可惜。\n沧浪水深青冥阔，山鬼幽忧雪霜逼。\n老去新知见面稀，被褐短窄鬓如丝。\n秋天漠漠向昏黑，独立苍茫自咏诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其二十八","author":"孔平仲","text":"江上形容吾独老，百壶且试开怀抱。\n妙舞逶迤夜未休，多情依旧能潦倒。\n雨裛红蕖冉冉香，玉樽锦席高云凉。\n酒酣耳热忘头白，老儒不用尚书郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其二十九","author":"孔平仲","text":"江上今朝寒雨歇，翛然欲下阴山雪。\n山巅朱凤声嗷嗷，白鹄翅垂眼流血。\n老夫清晨梳白头，杖藜徐步立芳洲。\n使我残年但饱吃，微躯此外更何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其三十","author":"孔平仲","text":"神仙中人不易得，京中旧见君颜色。\n同心不减骨肉亲，我居巷南子巷北。\n佳人屡出董娇娆，秋水为神玉为骨。\n孤城此日堪断肠，既饱欢娱亦萧瑟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孙元忠 其三十一","author":"孔平仲","text":"封书寄与泪潺湲，童稚情亲四十年。\n离别不堪无限意，断肠分首各风烟。\n反锁衡门守环堵，闻道三年未曾语。\n数篇今见古人诗，更觉良工心独苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孙元忠寄示种竹诗戏以二十篇答 其一","author":"孔平仲","text":"青钱买野竹，持答翠琅玕。\n深栽小斋后，幽事颇相关。\n自有烟霞质，能令朱夏寒。\n引溜加灌溉，毋令雪霜残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孙元忠寄示种竹诗戏以二十篇答 其二","author":"孔平仲","text":"冠盖满京华，藩篱带松菊。\n看君用幽意，必种数竿竹。\n婵娟碧鲜静，窈窕一林麓。\n排闷强裁诗，清文动哀玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]