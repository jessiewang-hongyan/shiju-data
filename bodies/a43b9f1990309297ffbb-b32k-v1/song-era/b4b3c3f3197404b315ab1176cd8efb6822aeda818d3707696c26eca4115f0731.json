[{"title":"赐刘能真三首 其三","author":"赵构","text":"忆昔辰江阻飓风，于今神马又成龙。\n炎兴指日中原复，剩是茅君翊翼功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐刘能真三首 其二","author":"赵构","text":"太白巃嵷东南驰，众岭环合青分披。\n烟云厚薄皆可爱，木石疏密自相宜。\n阳春已归鸟语乐，溪水不动鱼行迟。\n生民无不得处所，与兹鱼鸟皆熙熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题马远画册 其三","author":"赵构","text":"月午江空桂花落，华阳道士云衣薄。\n石坛香散步虚声，杉露清泠滴栖鹤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题画册花草四首 其一 蜡梅","author":"赵构","text":"香蜜裁葩分外工，疏枝几点缀雏蜂。\n娇黄染就宫妆样，香煖尤宜爱日烘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其九","author":"赵构","text":"升堂惟光，千乘惟权。\n陵暴知非，委质可贤。\n折狱言简，结缨礼全。\n恶言不耳，仲尼赖焉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其三十三","author":"赵构","text":"纪伯子鲁，圣学是务。\n厉己斯的，好问乃裕。\n周旋中规，容止可度。\n允矣昔贤，后世所慕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其四十三","author":"赵构","text":"惟子挺生，道德之门。\n佩服至论，鲤则弟昆。\n三得三亡，所问殊温。\n君子归宓，义不掩恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其六十一","author":"赵构","text":"君子若人，单父之政。\n引肘寤君，放鱼禀令。\n傅郭勿穫，遂能制命。\n百代理邑，用规观听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其五十三","author":"赵构","text":"兄弟之邦，士有廉庸。\n涵泳素教，表揭儒宗。\n杏坛探赜，洙泗从容。\n作兴一时，莒父其封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其五十四","author":"赵构","text":"瑕丘祚邑，子期是为。\n亲训有日，广业于时。\n四教允隆，五常以持。\n比肩俊杰，闻望斯垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其七","author":"赵构","text":"道义正己，文学擅科。\n为宰武城，联以弦歌。\n割鸡之试，牛刀谓何。\n前言戏尔，博约则多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其四十四","author":"赵构","text":"仰止狄皙，抱负渊通。\n游泳德化，扬厉素风。\n伟识既异，持教乃隆。\n厥志茂焉，毖祀无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其四十五","author":"赵构","text":"子敛受封，爰居武城。\n亹亹其闻，翩翩其英。\n抠衣时习，愿学日明。\n诞敷孔教，爵里疏荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其十四","author":"赵构","text":"惟子有道，天与异容。\n状虽云恶，德则其丰。\n南止江沱，学者云从。\n取士自兹，貌或非公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其十五","author":"赵构","text":"夫孝要道，周训群生。\n以纲百行，以通神明。\n因子侍师，答问成经。\n事亲之实，代为仪刑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其三十四","author":"赵构","text":"贤行颜叔，亲承尼父。\n志锐所期，道尊是辅。\n泥在钧陶，木就规矩。\n终縻好爵，扬名东武。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其四十七","author":"赵构","text":"式是壤伯，昭乎圣徒。\n执经请益，载道若无。\n诗书规矩，学问楷模。\n得时而驾，领袖诸儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其五十五","author":"赵构","text":"易之为书，弥合天地。\n五十乃学，师则有是。\n子能受授，洗心传世。\n知机其神，宜被厥祀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其四十六","author":"赵构","text":"刚毅近仁，志操莫渝。\n性匪祝鮀，面岂子都。\n有一于此，刚名可图。\n云欲则柔，盖生之徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其六十","author":"赵构","text":"仕进之道，要在究习。\n具臣而居，咎欲谁执。\n斯未能信，谦以有立。\n阙里说之，多士莫及。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其三十一","author":"赵构","text":"惟禽之问，从容其鲤。\n求以异闻，诗礼云尔。\n请一得三，诚退而喜。\n且知将圣，不私其子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其三十五","author":"赵构","text":"在昔石邑，能知所尊。\n懋依有德，克述无言。\n鼓箧槐市，扬名里门。\n此道久视，彼美长存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其六十七","author":"赵构","text":"孰封于萧，实惟子柳。\n夙饫格言，克遵善诱。\n明德斯馨，贤业所就。\n以侑于儒，传芳逾茂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其十九","author":"赵构","text":"人禀秀德，气貌或同。\n而子俨然，温温其容。\n两端发问，未答机锋。\n以礼节和，斯言可宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其三十九","author":"赵构","text":"人谁无子，尔嗣标奇。\n行为世范，学为人师。\n请车诚非，顾匪其私。\n千载之下，足以示慈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其二十七","author":"赵构","text":"念昔颛孙，商德与邻。\n学以干禄，问以书绅。\n参前倚衡，忠信是遵。\n色取行违，作戒后人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其四","author":"赵构","text":"懿德贤行，有一则尊。\n子也履之，成性存存。\n骍角有用，犁牛莫论。\n刑政之言，惠施元元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其七十","author":"赵构","text":"温温子里，入闻至圣。\n揽道之华，秉德之柄。\n深造阃域，不乖言行。\n全齐之封，竹素为盛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其五","author":"赵构","text":"德以充性，行以澡身。\n二事在躬，日跻而新。\n并驱贤科，得颜与邻。\n不幸斯疾，命也莫伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其七十二","author":"赵构","text":"彭衙高士，经籍是亲。\n赞成德艺，协于彝伦。\n厎绩圣道，斯肖素臣。\n优哉游哉，学以致身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其四十","author":"赵构","text":"肃肃曹伯，王室之裔。\n积习乐道，切瑳明义。\n惟善则主，尔德是类。\n史笔有焕，令名永纪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其四十二","author":"赵构","text":"褒锡朱虚，在器轮舆。\n儒室振领，圣门曳裾。\n贤业得蕴，美材以摅。\n百世不刊，载观成书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其六十二","author":"赵构","text":"师席高振，大成是集。\n至道克传，贤达斯执。\n善道云袤，儒风可立。\n渔阳之士，得跂而及。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其二十九","author":"赵构","text":"伯兹雩娄，务学实著。\n三千之位，七十是预。\n匪善莫行，惟德乃据。\n纪干前书，式彰厥誉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其三十","author":"赵构","text":"秦有子南，蜚声述作。\n守道之渊，成德之博。\n范若铸金，契犹发药。\n历世明祀，少梁宠爵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其一","author":"赵构","text":"大哉圣宣，斯文在兹。\n帝王之式，古今之师。\n志则春秋，道由忠恕。\n贤于尧舜，日月其誉。\n维时载雍，戢此武功。\n肃昭盛仪，海㝢聿崇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其六","author":"赵构","text":"循良之要，在于有政。\n可使为宰，千室百乘。\n师门育材，治心扶性。\n退则进之，琢磨之柄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其二十四","author":"赵构","text":"天清日明，密雨曷有。\n师命持盖，子亦善扣。\n惟夫子博，三才允究。\n学者之乐，所得遂茂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其三十八","author":"赵构","text":"任城建伯，其表曰选。\n淑问雅驰，才华清远。\n竞辰力行，爱日黾勉。\n孔教崇崇，令绪显显。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其五十七","author":"赵构","text":"有卫伯玉，夫子与居。\n寡过未能，荐赞使乎。\n以尸谏君，友则史鱼。\n果得进贤，烂然简书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其六十五","author":"赵构","text":"孔父秦父，相尚以力。\n俱生贤嗣，相与以德。\n是父是子，致诘畴克。\n会弁儒林，令名无极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其七十一","author":"赵构","text":"伯彼临淄，左行称贤。\n睎踪十哲，秀颖三千。\n心悦诚服，家至户传。\n乐只君子，文声益宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其三十六","author":"赵构","text":"琅邪之伯，其惟子骄。\n微言既彰，德音孔昭。\n已观雩舞，同听齐韶。\n历千百祀，跂想高标。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其五十六","author":"赵构","text":"手足甚亲，志异出处。\n魋将为乱，子乃脱去。\n在污能絜，危而有虑。\n内省若斯，何忧何惧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其二","author":"赵构","text":"德行首科，显冠学徒。\n不迁不贰，乐道以居。\n食埃甚忠，在陋自如。\n宜称贤哉，岂止不愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其六十三","author":"赵构","text":"侁侁申周，四科与俦。\n逸驾文圃，鼓枻儒流。\n冠佩既燕，言动允休。\n邵陵得封，可想清修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其六十九","author":"赵构","text":"东平子产，性著盛时。\n奉师于塾，讲道之微。\n答问其敏，婉妙以思。\n升降陛廉，尚想英姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其二十二","author":"赵构","text":"乐善哲士，伯于汧阳。\n传道克正，垂名久臧。\n执德以洪，用心必刚。\n袤广业履，式赞素王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其三十二","author":"赵构","text":"室家壮年，无子则逐。\n见于信史，全齐之俗。\n原本厥初，师言可复。\n以学则知，揆之宜笃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其二十一","author":"赵构","text":"邈矣子季，睢阳是伯。\n屏息受业，延教登席。\n未践四科，困涉六籍。\n祀典载之，好是正直。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其十六","author":"赵构","text":"子长宏度，高出伦辈。\n虽在缧绁，知非其罪。\n纯德备行，夫子所采。\n以子妻之，尤知英概。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其五十一","author":"赵构","text":"先觉既位，簪履并驰。\n尚德君子，尔乃兼之。\n羿奡可惭，禹稷可师。\n三复此道，载观白圭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其三十七","author":"赵构","text":"彼美邽子，先圣是承。\n墙仞已及，堂陛将升。\n良玉斯琢，寒水必冰。\n锡壤平陆，茂实骞腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其五十九","author":"赵构","text":"人有贤否，道有废兴。\n子如命何，营营震惊。\n季孙虽惑，景伯莫平。\n师资一言，秩祀亦惩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其四十八","author":"赵构","text":"开国乘氏，有德斯彰。\n参稽百行，赞理三纲。\n自拔行閒，荣名甚光。\n在史蔼蔼，历久弥芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其三","author":"赵构","text":"天经地义，孝哉闵骞。\n父母昆弟，莫间其言。\n污君不仕，志气轩轩。\n复我汶上，出处休焉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其五十","author":"赵构","text":"有怀子折，全鲁之彦。\n儒行既名，聊伯乃建。\n兢兢受道，奕奕峨弁。\n懿选嘉访，世享馨荐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其十一","author":"赵构","text":"文学之目，名重一时。\n为君子儒，作魏侯师。\n不可后礼，始可言诗。\n假盖小嫌，圣亦不疵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其十七","author":"赵构","text":"猗尔子上，鲁邦之望。\n以德则贵，惟道是唱。\n师聪师明，友直友谅。\n伯于祝阿，儒风斯畅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其六十六","author":"赵构","text":"勉勉子车，封邑淳于。\n亲炙避席，唯诺趋隅。\n发微既博，雅道是扶。\n抑可尚也，不亦美乎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其八","author":"赵构","text":"辩以饰诈，言以致文。\n苟弗执礼，宜奠释纷。\n朽木粪墙，置不足言。\n言语之科，粗然有闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其十二","author":"赵构","text":"礼之有本，子能启问。\n大哉斯言，光昭明训。\n德辉泰山，诬祭莫奋。\n崇兹祀典，盍永令闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其二十五","author":"赵构","text":"周衰伪隆，政在群公。\n廉耻道微，家臣聿崇。\n不为屈节，撝默自容。\n子于是时，凛然清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其十八","author":"赵构","text":"轼彼穷阎，达士所宾。\n邦无道谷，进退孰伦。\n敝衣非病，无财乃贫。\n赐虽不怿，清节照人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其五十二","author":"赵构","text":"黄伯著祀，公孙是云。\n弥缝中道，协辅斯文。\n藏修方异，渐渍其勤。\n史词不忘，播为清芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其十三","author":"赵构","text":"养才以道，圣人兼济。\n始谓不仁，问鲍良喜。\n寓志农圃，似睽仁义。\n学稼之辞，岂姑舍是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其四十九","author":"赵构","text":"惟彼子之，锡伯期思。\n与贤并进，得圣而师。\n彬彬雅道，翼翼令仪。\n上目至言，庙食不隳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其二十六","author":"赵构","text":"遐想子期，挟策圣帷。\n涉道是嗜，惟士可縻。\n在德既贤，在名乃垂。\n洋洋之风，逮今四驰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其七十三","author":"赵构","text":"乐氏子声，锡爵昌平。\n信道之万，见善乃明。\n引领高节，载惟思诚。\n先贤聿集，出为时英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其四十一","author":"赵构","text":"至圣立教，子祺安雅。\n擅誉鲁邦，启祚钜野。\n炜矣风猷，时哉用舍。\n出伦离类，后学是假。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其十","author":"赵构","text":"谦德知二，器实瑚琏。\n动必几先，孰并其辩。\n一使存鲁，五国有变。\n终相其主，誉处悠远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其六十四","author":"赵构","text":"多能鄙事，圣人曲意。\n惟其知之，是以不试。\n宗鲁虽友，吊必以义。\n尚师嘉言，祀亦罔替。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]