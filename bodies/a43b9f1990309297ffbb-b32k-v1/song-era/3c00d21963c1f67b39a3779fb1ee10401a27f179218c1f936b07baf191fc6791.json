[{"title":"送谯岩赵日休归蜀","author":"赵希㯝","text":"烟尘渺渺暗鱼凫，有客翩然赴上都。\n乞得玉宸新翰墨，要还琳宇旧规模。\n十年蠲赋纶恩重，万里归程剑影孤。\n他日青城公案了，紫云深处勘阴符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄黄溪云","author":"赵希㯝","text":"十年成远别，几度上高楼。\n风递江南信，云消渭北愁。\n春心惊海燕，晓梦入溪鸥。\n何日西窗烛，相看说旧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪","author":"赵希㯝","text":"不是春风柳，因何絮客衫。\n一云同万里，半夜失千岩。\n征马寒踪印，饥鸱冻吻缄。\n江心一片白，知有莫归帆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游临平乾洞水洞","author":"赵希㯝","text":"两洞深如许，神龙此奠居。\n山空仙去久，路崄客来疏。\n风雨千崖暗，云烟四壁虚。\n自揩岩石藓，闲把姓名书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天屋歌为卢洪赋","author":"赵希㯝","text":"霞扃云牖高窿穹，八荒四野垂帘栊。\n羲璘勃窣行西东，茫茫尘世如飞蓬。\n玉川公子乘清风，飘然据作吟诗宫。\n穿心出胁千万语，叫开阊阖惊苍龙。\n银河泻入北斗柄，醉来掷下琉璃钟。\n仙人王乔作邻伍，冯轩共笑嘘长虹。\n旌阳拔宅想亦在，千年万岁都洪濛。\n君不见阿房结绮今何许，劫灰一丈漫秋雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖中曲","author":"赵希㯝","text":"长眉柳叶交青条，玉花娇面垂云髫。\n湖波蓝色春寥寥，大堤新曲干银霄。\n翠丝络马金袅腰，香风随步烟飞飘。\n芳亭深杳传金貂，一笑嫣然轻百绡。\n欢娱未了日晷短，城鼓咿咿续复断。\n鸣鞭夜月入鸡关，碧山皎皎水潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李鹤田德真寄远","author":"赵希㯝","text":"长安日下浮云生，故人久作西南行。\n沤边两载音讯绝，鬓丝应与秋风争。\n苍苔冉冉荒茅屋，愁来忍把离骚读。\n惊鸿刚自堕边声，碧嶂那堪遮远目。\n青云高处期翱翔，去人岁月今堂堂。\n吴钩拂拭霜雪冷，龙光飞跃秋天长。\n思君一夜离心折，东楼又送无情月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春阴曲","author":"赵希㯝","text":"东风吹寒云九有，冻龙迷海乱飞走。\n雨脚斜拖入遥阜，碧草浮烟满堤口。\n春皇妙运造化手，解使江山失妍丑。\n冷色禁持万花柳，红紫未张春国寿。\n愁春织心心怮怮，为花诉冤天听否。\n晴曦赫赫重阴剖，梦里桃源拚载酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道民金氏居","author":"赵希㯝","text":"碧港虽通邑，红尘不到门。\n桑麻唐杜曲，鸡犬晋桃源。\n山远云千点，天宽月一轩。\n居人非隐者，吾欲叫东园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题云间阁","author":"赵希浚","text":"昔年严大夫，偶来怨迁谪。\n我本麋鹿姿，得此已自适。\n乘閒陟上方，□寻唐人石。\n岂期当三伏，一天云四幂。\n快哉风南来，万籁相呼吸。\n雨馀禾麻润，是山皆喜色。\n一杯倾晚饮，绿瓜间未实。\n是非不到耳，休厌山城寂。\n树影抹横烟，角声暗落日。\n长江去不返，况此百年客。\n企首老玉仙，白发何由摘。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子规","author":"赵希逢","text":"莺声日沸笙歌奏，富贵春光别一家。\n惟有不如归去好，夜深和月在梨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和午枕 其二","author":"赵希逢","text":"春酲未析眼慵开，困卧藤床隐腹雷。\n陪笑不容掀幌问，一鸡啼午自惊回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和午枕 其一","author":"赵希逢","text":"遣怀无日不持杯，何事愁肠未肯开。\n堪叹人生真似梦，黄粱不梦又蒿莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和水禽","author":"赵希逢","text":"一水微茫天尽头，淡烟疏雨暗沧洲。\n白鸥远远随潮上，隐映寒芦两岸秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和车制","author":"赵希逢","text":"木牛新意出南阳，万里飞刍不绝粮。\n故智莫能遵此日，却将独辐献岩廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和宁川冷渡","author":"赵希逢","text":"解鞍饱有山林兴，入耳都无市井声。\n一榻萧然谁是伴，琴樽相对太清生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和巧松 其二","author":"赵希逢","text":"何人厦屋诧渠渠，路入松关阴满衢。\n都把万间庇寒士，又分馀荫憩征夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和巧松 其三","author":"赵希逢","text":"秦人无故起阿房，赤立千林赭众冈。\n更觅长生游海上，不将松实作津梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和巧松 其一","author":"赵希逢","text":"肯将生意待春回，尺寸灵根破雪栽。\n爱护成阴十年后，漫山彷佛鲁祖来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和田家 其三","author":"赵希逢","text":"挛耳蓬□色似烧，晚山归负错薪翘。\n逢人犹作娇羞态，无力轻将手托腰。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和田家 其六","author":"赵希逢","text":"豪门方夺吏还催，打户搥门陆续来。\n力弊筋驽不入腹，愁肠料得日千回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和田家 其八","author":"赵希逢","text":"秋深场圃已登禾，窗下寒机暂释梭。\n积贮不教如栉比，索逋门外苦多多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和田家 其五","author":"赵希逢","text":"布衫裁就短平腰，两两三三步小桥。\n粗态撩人在何处，山花鬓畔露村娇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和田家 其二","author":"赵希逢","text":"笠蓑懒把一身包，沾体何曾怕雨浇。\n待得年丰饶一饱，大家买酒醉溪桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和田家 其四","author":"赵希逢","text":"茅舍围围护刺笆，寂寥无处著纷挐。\n斜阳急趁牛羊下，社酒招邀三两家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和田家 其一","author":"赵希逢","text":"门外无人水满池，独□一犬护门帏。\n蓦然踊跃闻声喜，翁媪犁锄带月归。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和田家 其七","author":"赵希逢","text":"赢粮破晓自薪樵，有米无柴著甚烧。\n更有一般欠区处，淡餐粝饭鼎中焦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和买盆池莲","author":"赵希逢","text":"终日欢陪解语莲，浮花欲比价相千。\n不须更买盆池景，寂寞无言涴眼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和再还建上旧店","author":"赵希逢","text":"枉将荆棘满园栽，不放阳和一点回。\n何事成阴种桃李，相逢一笑看春来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和岁寒三友亭","author":"赵希逢","text":"春来到处富群英，浮浪应无实副名。\n独有岁寒三冷友，凌霜傲雪伴诗盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和早春水西","author":"赵希逢","text":"车尘曀曀惯东西，因览江山得胜奇。\n休叹劳生空辙迹，未留勋业也留诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和早春层楼","author":"赵希逢","text":"谁架齐云百尺楼，舞衫歌扇贮风流。\n可怜脚力衰多矣，身未上时心已愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和早春酒家","author":"赵希逢","text":"丰姿越女更吴姬，一笑能令酒力微。\n步月归来浑未醉，家人疑自剡溪归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和早春梅山","author":"赵希逢","text":"昨夜何人雪里归，岭头折得去年枝。\n莫将寒暖分南北，直为春光剖破篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和早春楮衾","author":"赵希逢","text":"楮衾重盖得春多，贵习都忘纨与罗。\n一枕雷声齁鼻息，想应梦不到娇娥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和江涛","author":"赵希逢","text":"奔腾势力作弓䟫，夜半声如万鼓轰。\n因想千人挥笔阵，斫营怒气更峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和巫山","author":"赵希逢","text":"奇峰六六插寒江，作赋何人语悖常。\n誉木从旁犹见斥，楚王应有愧于唐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和华安仁花村二首 其一","author":"赵逢","text":"格是而今老有馀，行行真欠瘦筇扶。\n不将心絮随风起，一恁闲花有似无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和华安仁花村二首 其二","author":"赵逢","text":"路入前村认杏花，门前水积半溪沙。\n风流彷佛朱陈俗，白酒黄鸡姓两家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和苦蚊","author":"赵希逢","text":"入夜声不绝，朝来还迹灭。\n身絮巧粘肤，觜针微点铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和茅亭","author":"赵希逢","text":"独坐茅亭濯晚凉，檐前万影立筼筜。\n数声萧琴浑疑雨，细细吹来却有香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和采石","author":"赵希逢","text":"平生李白几诗歌，传载存亡事不讹。\n捉月浪传何所据，欲将遗恨比湘娥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和青楼赠别","author":"赵希逢","text":"凭高座久渐生寒，远水明楼夜正残。\n月色照人人似月，倚栏一曲为谁弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和南浦水阁","author":"赵希逢","text":"受风蓬鬓三千丈，何日金钗十二行。\n逆旅相逢成白眼，可怜空学捧心妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和幽居 其二","author":"赵希逢","text":"不因搜句不曾忙，尽日柴门闭短墙。\n寄傲北窗闲著眼，任他书卷展风床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和春闺带花","author":"赵希逢","text":"帘捲黄昏月似眉，瘦梅淡月两相宜。\n樽前况有人如玉，鬓畔疑横竹外枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和春闺落花","author":"赵希逢","text":"片片胭脂缬地毛，对花醉脸上红潮。\n樽前笑指人人看，好与香腮一样娇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和桃花 其一","author":"赵希逢","text":"一抹残红散绮霞，因风吹恨落谁家。\n那堪移向瑶池种，留得千年看实花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和桃花 其二","author":"赵希逢","text":"万钟莫动孟轲喜，箪食难生颜子愁。\n醴酒当年如□□，□□□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和流萤","author":"赵希逢","text":"林塘腐草化为萤，星散飞来暗复明。\n拾向书窗辉眼目，当将檠火对南城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和读汉史","author":"赵希逢","text":"丈夫一死谁能惜，直把微躯脱汉王。\n不学贪生求富贵，族夷身戮恨尤长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和读张子房传 其一","author":"赵希逢","text":"三杰留侯不敢名，肯随走狗例鬺烹。\n眼中早已无高粉，子击何尝有吕生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和读苏武李陵司马迁传 其二","author":"赵希逢","text":"携手河梁一别归，衷情尽寄五言诗。\n故人妻子存乎否，因甚诗中无片辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和酒禁","author":"赵希逢","text":"井田未坏军民一，去古堪嗟此意衰。\n守望扶持无复有，一杯也自立藩篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和酒醒","author":"赵希逢","text":"温柔乡里唤春回，低唱樽前肉作台。\n判取明朝都醉杀，解酲一笑有人开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和阅明妃传 其一","author":"赵希逢","text":"安边良将不收功，公主如何嫁犬戎。\n若使外孙知大父，单于不自杀其翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和阅明妃传 其二","author":"赵希逢","text":"青冢今成土一堆，娇容埋玉恨难开。\n无端当日毛延寿，轻把毫端巧作媒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄王五四将仕 其一","author":"赵希逢","text":"书诈谁知诬子孟，奏陈直欲动山涛。\n下机终不疑曾子，二主其明真察毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄王五四将仕 其二","author":"赵希逢","text":"帝业未成三尺剑，老人先授一编书。\n遭时若与留侯异，蓑笠江湖亦可渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄仵判院八首 其八","author":"赵希逢","text":"囷踬真成失水螭，震雷惊起在何时。\n而今且向书窗下，夜对寒灯读楚词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄仵判院八首 其七","author":"赵希逢","text":"好问君王觅镜湖，含丹照白伴潇疏。\n玄中得趣浑闲事，只恐故人难得书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄仵判院八首 其六","author":"赵希逢","text":"琴樽畴昔记追随，富贵休教贫贱离。\n一日相思时十二，无书独可可无诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄仵判院八首 其五","author":"赵希逢","text":"发于事业见于词，君昔相期舍我谁。\n何事至今犹一旅，几回无语发深思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄仵判院八首 其四","author":"赵希逢","text":"古壁伤情忆旧题，连天芳草望空迷。\n沉吟此意向谁说，合尽碧云日又西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄仵判院八首 其三","author":"赵希逢","text":"宝笈琼函世不传，感君重诺订金千。\n相应未值南来雁，谓戏前言断不然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄仵判院八首 其二","author":"赵希逢","text":"便教老眼怎昏花，书债如何也不赊。\n更有一般春枕梦，合眸便到故人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄仵判院八首 其一","author":"赵希逢","text":"望君如在碧云间，逸驾飘飘不可攀。\n何日得陪鸡犬去，仙泉好共饮丹蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄宗上人","author":"赵希逢","text":"早欲投闲林下坐，苦无度牒与袈裟。\n在家傥若谢灵运，薄酒须知也胜茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄赵及父","author":"赵希逢","text":"德裕南征基奉册，淮阴晚节北登坛。\n何如流落长沙后，犹自拳拳策治安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄赵德夫","author":"赵希逢","text":"学行何必过邯郸，匍匐归来指谩弹。\n万事不如安分好，人心何事险于滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和晚醉金楼","author":"赵希逢","text":"少年曾客帝王州，醉倒不知何处楼。\n厌饮清欢成逐夜，时邀明月入帘钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和雪狮儿","author":"赵希逢","text":"雪狮塑出对琼卮，玉笋纤纤露手儿。\n掩口樽前还笑我，指头皴破作霜皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和新市杂咏 其十","author":"赵希逢","text":"弦管楼台十万家，暮云落日映残霞。\n可曾一夜不携酒，占断四时长是花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和新市杂咏 其一","author":"赵希逢","text":"落日看看宿暮鸦，谯楼画角动梅花。\n今宵酒兴知何处，隐隐歌声不一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和新市杂咏 其四","author":"赵希逢","text":"杯行火急正相催，一醉难酬一笑开。\n夜静酒阑清不奈，好风吹月入樽来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":45619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]