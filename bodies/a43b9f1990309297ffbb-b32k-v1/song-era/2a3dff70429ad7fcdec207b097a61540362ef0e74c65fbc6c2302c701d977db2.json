[{"title":"闻金溪陆伯政下世","author":"陆游","text":"久矣望来使，潸然开讣书。\n两家通绝谱，千里泣灵车。\n亦悟古皆死，所悲天祝余。\n泉扃生气在，故不羡曹蜍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻雨","author":"陆游","text":"慷慨心犹壮，蹉跎鬓已秋。\n百年殊鼎鼎，万事秪悠悠。\n不悟鱼千里，终归貉一丘。\n夜阑闻急雨，起坐涕交流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻韩无咎下世","author":"陆游","text":"书剑飘然去国时，南兰陵郡日题诗。\n吴波涨绿迎桃叶，穰烛堆红按柘枝。\n故友去为山下土，衰翁何恨鬓边丝。\n凭高老泪无挥处，神武衣冠挂已迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻猿","author":"陆游","text":"瘦尽腰围不为诗，良辰流落自成衰。\n也知客里偏多感，谁料天涯有许悲。\n汉塞角残人不寐，渭城歌罢客将离。\n故应未抵闻猿恨，况是巫山庙里时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻蜀盗已平献馘庙社喜而有述","author":"陆游","text":"北伐西征尽圣谟，天声万里慰来苏。\n横戈已见吞封豕，徒手何难取短狐。\n学士谁陈平蔡雅，将军方上取燕图。\n老生自悯归耕久，无地能捐六尺躯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夜","author":"陆游","text":"野水枫林屋数椽，寒炉无火坐无毡。\n残灯耿耿愁孤影，小雪霏霏送旧年。\n椒酒辟瘟倾潋滟，蓝袍俘鬼舞跰跹。\n从今供养惟春荠，莫羡愚公日万钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"食荠糁甚美盖蜀人所谓东坡羹也","author":"陆游","text":"荠糁芳甘妙绝伦，啜来恍若在峨岷。\n莼羹下豉知难敌，牛乳抨酥亦未珍。\n异味颇思修净供，秘方常惜授厨人。\n午窗自抚膨脝腹，好住烟村莫厌贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"食野味包子戏作","author":"陆游","text":"珍饷贫居少，寒云万里宽。\n叠双初中鹄，牢九已登盘。\n放箸摩便腹，呼童破小团。\n犹胜瀼西老，菜把仰园官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"食新有感贫居久蔬食至是方稍得肉","author":"陆游","text":"壮游车辙遍天涯，晚得祠官不去家。\n优老每惭千载遇，食新又叹一年加。\n出波鱼美如通印，下栈羊肥抵卧沙。\n扪腹笑歌仍索酒，不嫌邻舍怪欢哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"首夏","author":"陆游","text":"乱山深处著柴荆，岸帻披衣露气清。\n宴坐有书聊作伴，出游无客独题名。\n阴阴密树花初尽，滟滟方池水已平。\n几许人间堪笑事，今朝百舌顿无声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"骨相","author":"陆游","text":"骨相元知薄，功名敢自期。\n病侵彊健日，闲过圣明时。\n形胜轮台地，飞腾瀚海师。\n江湖虽万里，犹拟缀声诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"俶装","author":"陆游","text":"绝物离人恨未能，聊为旦过打包僧。\n蹇驴渺渺秋山雨，孤榻昏昏夜店灯。\n酒量已随诗共退，客愁仍与病相乘。\n颓然衰飒嗟谁识，侠气当年盖五陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倚杖","author":"陆游","text":"倚杖柴门外，踟蹰到日斜。\n儿童拾笋箨，妇女卖茶芽。\n掠岸过渔艇，隔篱闻纬车。\n年来诗料别，满眼是桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倚栏","author":"陆游","text":"闲岸纱巾小倚栏，吴中三月尚春寒。\n蜂脾蜜满花初过，燕觜泥新雨未乾。\n老厌簿书思屏迹，病逢节物强追欢。\n一樽又动流年感，城上斜阳画角残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倚筇","author":"陆游","text":"老翁愈老欲安归，归卧稽山饱蕨薇。\n未免解牛逢肯綮，岂能相马造精微。\n灵山有士拈花笑，阙里何人鼓瑟希。\n我亦倚筇桑竹下，白髯萧飒满斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倚楼","author":"陆游","text":"千里江山入倚楼，高吟聊复写吾忧。\n诗书幸有先人业，贫贱初非学者羞。\n数掩槿篱端可老，一杯藜粥尚何求。\n东陂未插青秧遍，且与邻翁卜雨鸠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倦飞","author":"陆游","text":"倦飞何意闭樊笼，冉冉年光过眼空。\n酒尽不妨沽巷口，诗成多是在车中。\n曾腰白羽心犹壮，不养丹砂颊自红。\n所叹暮年交旧尽，灯前情话与谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭开孙","author":"陆游","text":"学步渐扶床，乘车已驾羊。\n虚称砌台使，不遇玉函方。\n杳杳天难问，茫茫夜正长。\n寂寥谁伴汝，萧寺闭空房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭王季夷","author":"陆游","text":"超遥天马渥洼来，万里修途忍勒回。\n爽气即今犹可想，旧游何处不堪哀。\n梦中有客徵残锦，地下无炉铸横财。\n欲酹一尊身尚病，鬣封春露湿苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭李孟达","author":"陆游","text":"旧交多已谢明时，孟达奇才最所思。\n晚岁立朝虽小试，平生苦学竟谁知。\n尊前一笑终无日，地下相从却有期。\n恸绝寝门霜日暮，短篇聊为写馀悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭季长二首 其一","author":"陆游","text":"岷山剡曲各天涯，死籍前时偶脱遗。\n三径就荒俱已老，一樽相属永无期。\n寝门哀恸今何及，泉壤从游后不疑。\n邂逅子孙能记此，交情应似两翁时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭径山策老","author":"陆游","text":"岌岌龙门万衲倾，翩翩只履又西行。\n尘侵白拂绳床冷，露滴青松卵塔成。\n遥想再来非四入，尚应相见话三生。\n放翁大欠修行力，未免人间怆别情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"唐虞","author":"陆游","text":"唐虞虽远愈巍巍，孔氏如天孰得违。\n大道岂容私学裂，专门常怪世儒非。\n少林尚忌随人转，老氏亦尊知我稀。\n能尽此心方有得，勿持糟粕议精微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏中杂兴六首 其五","author":"陆游","text":"心慕羲农世，躬行黄老言。\n采椽聊筑舍，横木即为门。\n短发冠龟屋，空床枕竹根。\n从来薄世味，染指肯尝鼋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏中杂兴六首 其三","author":"陆游","text":"出赴盟鸥社，归寻梦蝶床。\n愚为度世术，闲是养生方。\n休歇书中癖，消磨酒后狂。\n远游亦已矣，不复解轻装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏中杂兴六首 其一","author":"陆游","text":"梳发高舂后，投床甲夜初。\n语艰愁对客，手倦怕催书。\n美睡那思觉，甘餐不愿馀。\n更应惭造化，无事到幽居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏中杂兴六首 其二","author":"陆游","text":"小响风吹叶，微痕雨点池。\n兴来闲弄笛，客散自收棋。\n忽忽寻残梦，时时足小诗。\n出门俄已暮，忘却野人期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏中杂兴六首 其四","author":"陆游","text":"处世如灰冷，持心似砥平。\n盘餐无宿戒，香火有常程。\n樵父供藜杖，陶人售瓦檠。\n经旬常苦雨，啸傲送馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日","author":"陆游","text":"燕子生雏梅子黄，断云残雨过林塘。\n孤舟正作笭箵梦，九陌难随褦襶忙。\n团扇兴来闲弄笔，寒泉漱罢独焚香。\n太平处处熏风好，不独宫中爱日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日","author":"陆游","text":"赫赫炎威日正中，冰纨笛簟欲无功。\n一心愿伴沙头鹭，百计难呼木杪风。\n纤手削瓜刀似水，小罂分酒盏如空。\n洗心幸有高楼月，少待寒光出海东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日五首 其二","author":"陆游","text":"过眼春光久已空，晒丝捣麦又匆匆。\n新泥满路梅黄雨，古木号山月晕风。\n角黍茭新间樽俎，灵符墨湿照房栊。\n岁华不为衰翁驻，且付馀生一笑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日","author":"陆游","text":"入户桐阴渐覆床，乍敷笛簟北窗凉。\n筇枝倚壁知身健，衣焙残香觉日长。\n雨霁断云时聚散，风来纤草久低昂。\n蝶衣粉湿犹飞懒，小驻阑干就夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日","author":"陆游","text":"赤日黄尘褦襶忙，放翁湖上独相羊。\n竹梢露滴惊残梦，荷盖风翻送早凉。\n暑用酒逃犹有待，热凭静胜更无方。\n空斋一榻翛然卧，闲看衣篝起篆香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日","author":"陆游","text":"柴扉昼掩竹林幽，坐使炎天变素秋。\n扇月团团似初满，簟波细细欲平流。\n朋侪零落关河阻，疾病沉绵岁月遒。\n赖有澄湖常在眼，虎头不用画沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日","author":"陆游","text":"病退身初健，时清吏更休。\n渴蜂窥砚水，慵燕息帘钩。\n棋局每坐隐，屏山时卧游。\n真成爱长日，未用忆新秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日五首 其五","author":"陆游","text":"梅雨初收景气新，太平阡陌乐闲身。\n陂塘漫漫行秧马，门巷阴阴挂艾人。\n白葛乌纱称时节，黄鸡绿酒聚比邻。\n掀髯一笑吾真足，不为无锥更叹贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日五首 其三","author":"陆游","text":"吴中五月暑犹微，竟日南堂坐掩扉。\n绿树露香莺独语，画廊风恶燕双归。\n三千界内人人错，七十年来念念非。\n投老万缘俱扫尽，从今僧亦不须依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日五首 其一","author":"陆游","text":"将雏燕子渐离巢，过母龙孙已放梢。\n日出并湖初晒网，雨馀乘屋旋添茅。\n家贫旧业元知废，身老微官久合抛。\n莫恨门前车马绝，岂无农圃与论交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日五首 其四","author":"陆游","text":"雨断云归旋作晴，尚馀红湿在帘旌。\n燕雏掠地飞无力，梅子临池坠有声。\n米粣解包供午饷，萍齑傍枕析朝酲。\n此翁不负顽躯处，扪腹时时绕舍行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日","author":"陆游","text":"例谢门前客，深藏箧里书。\n衣穿但重补，饭足不求馀。\n山溜鸣庭际，藤阴接屋除。\n何劳厌三伏，俯仰即秋初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日小宴","author":"陆游","text":"横吹铜笛苍龙声，双奏玉笙丹凤鸣。\n已判百年终醉死，要将一笑压愁生。\n旋移画舫破山影，高捲朱帘延月明。\n试问炎歊在何许，夜阑翻怯葛衣轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日北榭赋诗弈棋欣然有作","author":"陆游","text":"异事严州省见稀，幅巾阑角立多时。\n青林白鸟自成画，急雨好风当有诗。\n酷信医方逢酒怯，强驱吏牍坐衙迟。\n悠然笑向山僧说，又得浮生一局棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日杂咏四首 其四","author":"陆游","text":"省事心君静，忘情眼界平。\n食便餐酪美，浴试葛衣轻。\n鹤整千年驾，鸥寻万里盟。\n秋风即在眼，作意上青城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日杂咏四首 其一","author":"陆游","text":"闲居自无客，况复暑如焚。\n百折赴溪水，数峰当户云。\n幽寻穷鹿径，静钓杂鸥群。\n旧爱南华语，今方践所闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日过摩诃池","author":"陆游","text":"乌帽翩翩白纻轻，摩诃池上试闲行。\n淙潺野水鸣空苑，寂历斜阳下废城。\n纵辔迎凉看马影，袖鞭寻句听蝉声。\n白头散吏元无事，却为兴亡一怆情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日独居","author":"陆游","text":"平生本清净，垂老更萧然。\n已罢客载酒，亦无僧说禅。\n空庭朝下鹊，密树晚鸣蝉。\n长日君无厌，新秋近眼边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日晚兴","author":"陆游","text":"高挂虚窗对绿池，鸟啼声歇柳阴移。\n含风珍簟闲眠处，叠雪轻衫新浴时。\n泉冷甘瓜开碧玉，手香素藕罥长丝。\n夕阳四面渔歌起，又赴邻翁把钓期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日晨起","author":"陆游","text":"华胥归路万山青，拈得乌藤绕舍行。\n两眦尚馀残睡美，一襟初受晓凉生。\n阴阴院落新桐影，寂寂房栊乳燕声。\n已罢小餐停卯酒，龟肠蝉腹不胜清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日湖上","author":"陆游","text":"乌帽筇枝散客愁，不妨胥史杂沙鸥。\n迎风枕簟平欺暑，近水帘栊探借秋。\n茶灶远从林下见，钓筒常向月中收。\n江湖四十馀年梦，岂信人间有蜀州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日感旧四首 其二","author":"陆游","text":"五侍仙祠两挂冠，此生略有半生闲。\n啸歌雨笠烟蓑底，来往山村县郭间。\n一粒何当换凡骨，数杯且复驻颓颜。\n胡尘扫尽知何日，不隐箕山即华山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日感旧四首 其三","author":"陆游","text":"吴人那惯粟浆酸，茶碗聊沾舌本乾。\n身病不堪闲客搅，日长惟忆异书看。\n流年冉冉谁能驻，长夏迢迢亦已残。\n步有新船君贺我，西风先梦上严滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日感旧四首 其一","author":"陆游","text":"北窗枕簟卧陶翁，树树鸣蝉叶叶风。\n睡觉残书栖懒架，浴回细葛覆熏笼。\n一藤未遂名山去，半卷还惊旧历空。\n妄想金丹君莫笑，清班曾是长仙蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日感旧四首 其四","author":"陆游","text":"独居无复客嘲边，终日颓然饱即眠。\n护砚小屏山缥缈，摇风团扇月婵娟。\n桐阴忽见翻双鹊，石罅时闻落细泉。\n避暑不须河朔饮，转头即见早秋天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏末野兴二首 其二","author":"陆游","text":"漠漠川云阖复开，天公试手挽秋回。\n参差小市林边出，缥缈疏钟雨外来。\n土塯饭香供晚饷，布帘字大卖新醅。\n归舟自逐轻鸥去，不用城笳抵死催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏末野兴二首 其一","author":"陆游","text":"半世天涯倦远游，还乡不减旅人愁。\n数声相应鸠呼雨，一片初飞叶报秋。\n山坞风烟僧院路，河梁灯火酒家楼。\n绝知雪鬓宜蓑笠，分付貂蝉与黑头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜四首 其三","author":"陆游","text":"展转纱幮睡不成，一藤扶惫绕廊行。\n月升双鹊移枝宿，露下孤萤缀蔓明。\n汲井忽惊人已起，开门堪叹事还生。\n羽衣道帽从吾好，柏子烟中起磬声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜四首 其四","author":"陆游","text":"龟息绵绵破五更，起扶藤杖并南荣。\n择栖孤鹊尚三匝，司旦老鸡俄一鸣。\n移坐徐看山月吐，脱巾聊受水风清。\n不知竟是真仙未，夜夜神游白玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜","author":"陆游","text":"酒力初消睡未厌，卧看香缕绕疏帘。\n月高栖鹊重移树，风劲流萤自入檐。\n长夏迢迢秋尚远，孤愁冉冉病相兼。\n老人本是山中客，扫迹元非畏楚钳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜四首 其二","author":"陆游","text":"山崦风生鵩啸悲，柴门月上树阴移。\n熏衣汗雨初乾后，把卷蚊雷不动时。\n孤闷难禁终岁病，浮生易满百年期。\n钓竿只待清秋近，一棹烟波信所之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜","author":"陆游","text":"六尺筇枝膝上横，中庭岸帻听鼍更。\n露零金掌汉宫晓，月度银河秦塞明。\n菡萏晚花香未减，梧桐病叶堕无声。\n关河又见新秋近，屈指流年一叹惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜","author":"陆游","text":"散发荒池上，秋声满绿蒲。\n磷飞乘月暗，枭语似人呼。\n学问无新得，功名负壮图。\n拾薪炊麦饭，随事且枝梧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜","author":"陆游","text":"乞骸安晚节，养疾卧空村。\n月暗枭鸣树，船归犬吠门。\n藜羹加糁美，黍酒带醅浑。\n稚子能勤学，灯前与细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜四首 其一","author":"陆游","text":"夏夜谁知亦自长，幽居渺在水云乡。\n月侵竹簟清无暑，风度衣篝润有香。\n栖鹊自惊移别树，流萤相逐过横塘。\n放翁尚苦馀酲在，细绠铜瓶落井床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜风雨极凉枕上口占","author":"陆游","text":"北窗八尺卧文藤，夜雨生凉洗郁蒸。\n袅袅清愁萦断角，悠悠孤梦伴残灯。\n羸躯垂老嗟焉往，公论犹存似可凭。\n聊向斯文图不朽，未甘粥饭学山僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜泛舟书所见","author":"陆游","text":"山房犹复畏炎蒸，长掩柴门愧老僧。\n两桨去摇东浦月，一龛回望上方灯。\n惊飞宿鸟时呼侣，腾起长鱼有脱罾。\n夜半归来步松影，真成赤脚踏层冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏夜泛溪至南庄复回湖桑归","author":"陆游","text":"不求奇骨可封侯，但喜枯肠不贮愁。\n数点残灯沽酒市，一声柔橹采菱舟。\n元知泽国偏宜夜，已就天公探借秋。\n归过三更风露重，纱巾剩觉发飕飗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]