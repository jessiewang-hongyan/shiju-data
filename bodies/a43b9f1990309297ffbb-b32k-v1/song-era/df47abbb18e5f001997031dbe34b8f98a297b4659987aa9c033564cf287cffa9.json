[{"title":"观稼二首 其二","author":"韩琦","text":"一夕甘滋起瘁田，斗回灾沴作丰年。\n便晴谁恐禾生耳，将熟偏宜谷捺弮。\n云退不留驱旱迹，气清浑露已秋天。\n衰翁岂独同民乐，更觉诗豪似有权。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观稼回","author":"韩琦","text":"雨过观田出近坰，敝庐还喜及柴刑。\n云平多稼彻天尽，黛拂远山随马行。\n寂寞秋风催晚角，徘徊先陇奈重城。\n乡人莫羡前驱弩，吾意何如负郭耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早赴坟庄","author":"韩琦","text":"叠叠山依皱晓霞，羲轮腾海露天涯。\n一川图画秋方静，万积京坻谷尽槎。\n旧邺馀风含古意，太行高景落诗家。\n讼庭经日如僧舍，又到村居倚将牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再出行田","author":"韩琦","text":"丰岁观农穫，先畴路不遐。\n子多宜晚谷，生柪就新麻。\n荞麦方成龊，蔓菁未入桠。\n乡民愚自诧，太守是吾家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张吉甫寺丞归洛","author":"韩琦","text":"洛中平日是吾家，时节芳菲正可誇。\n权去独思来卫幕，春归谁约醉桃花。\n晴飞县舄瞻仙翼，暖撷新兰荐洁牙。\n更想缑笙闻夜月，翩然高意薄青霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺春卿宣微出帅延安","author":"韩琦","text":"延塞何须辍钜公，西师今复久櫜弓。\n三台班秩名虽重，四海生灵泽未丰。\n莫泥兵韬求策胜，更充贤业俟时通。\n归来谈笑岩廊上，致主唐虞始是功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重阳甲子雨霁","author":"韩琦","text":"猛收宵雨发秋光，甲子朝来甚不伤。\n天意欲教成九谷，人心兼遂乐重阳。\n山开霁碧迎轩秀，菊染新黄助酒香。\n气与民和自无沴，岂须从俗佩萸囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登抱螺台","author":"韩琦","text":"坏圃萧疏有废台，登高留客此徘徊。\n几年埋没荒榛满，今日崔巍宴席开。\n一境山川俱入眼，重阳风物尽宜杯。\n坐中不劝犹当醉，菊蕊浮香似拨醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答滑守梅龙图重阳惠酒二阕 其一","author":"韩琦","text":"芳醇盈榼副风骚，慰我漳滨病拥旄。\n把菊不同陶令喜，白衣人只送香醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答滑守梅龙图重阳惠酒二阕 其二","author":"韩琦","text":"滑醪清满菊花卮，只欠新螯左手持。\n欲报善邻将意厚，苦惭家酿带春醨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答滑州梅龙图惠鼎州甘橘","author":"韩琦","text":"芳讯欣随客鲤开，雅篇并付木奴来。\n病翁逢酒唯忧过，更使湘包下滑杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食会康乐园","author":"韩琦","text":"欲识芳园立意新，康辰聊以乐吾民。\n天收寒食时来雨，人得常年数倍春。\n密密楼台花外好，蚩蚩歌舞醉中真。\n朝来必要升平象，请绘轻绡献紫宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答滑州梅龙图以诗酒见寄二首 其一","author":"韩琦","text":"对敌公如论酒兵，病夫虽劣敢先登。\n如将压境求诗战，即竖降旗示不胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答滑州梅龙图以诗酒见寄二首 其二","author":"韩琦","text":"东郡何能抑上才，召书看即日边来。\n名醪价重诗篇好，㮰泛西园感遇杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拜西坟","author":"韩琦","text":"楼角声喧促晓更，致虔茔域出西坰。\n春山带雨和云重，麦陇如梳破雪青。\n乡树溟濛天水墨，村农淳野古畦丁。\n阴迷俄景催归驭，暂向东风俗眼醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬滑州梅龙图惠诗","author":"韩琦","text":"自昔能诗者，如公敏思稀。\n清风当世耸，大雅一时归。\n京辅方期治，天颜此暂违。\n召棠随有爱，庖刃不劳挥。\n吟笔闲邀战，邻邦动怯围。\n疲神支败北，对景失芳菲。\n无物酬明月，何心衒昼衣。\n惊弦常跕跕，突阵正騑騑。\n溪柳柔金幄，园花烂锦帏。\n嬉游成乐国，佳气俯端闱。\n郢曲高难和，荆栖近莫依。\n流年伤阻阔，好梦接容辉。\n不信降旗竖，犹胜走檄威。\n可惭貂莫续，安敌虎而飞。\n窘蹙图更郡，奔逃始见机。\n吾乡虽甚美，无计恋柴扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和滑州梅龙图寒食溪园","author":"韩琦","text":"溪园高致此非遐，请为公陈众所誇。\n一境熙台跻旧俗，万民和气入新花。\n流芳只有人思召，行乐何须坐有车。\n不独清明资胜会，四时风月惬诗家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答磁州王复都官","author":"韩琦","text":"本邦为守获邻封，民政虽殊道则同。\n浃境欢然君有惠，一乡荣甚我何功。\n渐濡美化规模近，珍重高篇气格雄。\n德薄可能胜尹诵，穆如空自愧清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳会城北新硙","author":"韩琦","text":"谁言智者不兼仁，请看新渠激硙轮。\n本为酒材宽物力，更饶春月乐乡民。\n阴晴天色将寒食，狂醉人心即蜡宾。\n父老他年传故事，可忘修禊起兹辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昼锦堂赏新牡丹","author":"韩琦","text":"欲集珍丛称此堂，春来栽槛首花王。\n连砧不动开犹少，对酒多情格自强。\n白昼已凌乡锦色，清阴宜接讼棠芳。\n娱宾一奉笙歌赏，从此香名岁月长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮春康乐园","author":"韩琦","text":"榆荚纷纷掷乱钱，柳花相扑辊新绵。\n一年寂寞频来地，三月芳菲已过天。\n树密只喧闲鸟雀，台高犹得好山川。\n病夫不饮时如此，徒有诗情益自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庚申相台闵稼","author":"韩琦","text":"淫雨农畴害复收，彼何恩厚此何仇。\n高田谷穗拖牛尾，卑地庄窠没兽头。\n稔社彻宵喧鼓乐，灾居无日苦饥流。\n如云祸福关为政，安得丰凶在一州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苦雨","author":"韩琦","text":"直疑天际裂银潢，大雨连倾特异常。\n数里河声轰阵鼓，万条檐溜卓戎枪。\n雷霆势恶掀人脑，蛟□朋凶碎客航。\n正熟民田多没穗，几时仁恻动苍苍。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬滑州梅龙图惠酒","author":"韩琦","text":"久雨无书致睦邻，坦途非邈尽长津。\n正忧吾里民灾甚，敢觊公斋酒味醇。\n得骋蛟龙方倚浪，未锄稂莠已齐身。\n太阳几日披云见，多少如葵仰望人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬至前一日雪","author":"韩琦","text":"地下阳将复，人间气已和。\n群阴明数极，六出见花多。\n贺称新年曲，欢侔故郢歌。\n同云留纪吉，柔荔借萌科。\n起认灰飞管，堆凝素出波。\n朝盈振鹭集，隙隘白驹过。\n树密轻黏萼，天圆细撼罗。\n洁非容物污，碎不在风搓。\n农亩经年瑞，诗家万古魔。\n平明开庆会，绿蚁荐红螺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"腊日出猎二首 其一","author":"韩琦","text":"笳鼓拥貔貅，韩陵山下头。\n人心忘岱岳，鹰眼快离娄。\n兔逸兹穷虏，孤歼即贵酋。\n乡民谁会我，衣锦乐畋游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"腊日出猎二首 其二","author":"韩琦","text":"习平礼乐存形器，要阅兵须有杀生。\n故备奸戎侔斩伐，唯于畋猎可申明。\n妖狐胆裂逃终戮，老鹘拳高下必精。\n大获未能矜小得，几何人不哂吾行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日雪","author":"韩琦","text":"人正开统发新阳，盈尺稀逢雪载滂。\n不必宫声符善岁，却应和气得嘉祥。\n同云几刻藏春色，利泽经时洽众芳。\n遥想九天排晓仗，六花吹入万年觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新岁拜坟二首 其一","author":"韩琦","text":"先陇比如何，新年重一过。\n风迎人意好，春入鸟声和。\n畎亩因时劝，松楸趁暖科。\n公馀私遂及，吾幸比为多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新岁拜坟二首 其二","author":"韩琦","text":"新岁斋前寂讼铃，不妨诹日展先茔。\n遥知陇树春方到，一见家山眼又明。\n孝弟少期为俗劝，里闾乌足语吾荣。\n此行犹苦圭符累，名遂归来更尽诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄并帅庞公古瓦砚","author":"韩琦","text":"邺瓦搜来颇异常，寄诚安足奉文房。\n早陪神化丹青笔，莫滞边书赤白囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答并帅庞公谢寄古砚","author":"韩琦","text":"谁传石末首青州，邺砚今推第一流。\n更好岂堪濡化笔，报琼终念木瓜投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题滑州梅龙图西溪园","author":"韩琦","text":"陪京高选得名卿，勤葺公园匪自宁。\n政举辅藩无一事，意尊王室有三亭。\n看花篇什烦官课，对酒笙歌易讼铃。\n他日吏民铭惠爱，定随碑刻载图经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题滑州梅龙图西溪","author":"韩琦","text":"四时风物隐天真，咫尺城隅惜示人。\n几岁坏堤埋老木，一朝春色与吾民。\n壶中有景知诚少，堂下无喧到始频。\n我亦治园同众乐，夹河相望称为邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"御制后苑赏花钓鱼奉圣旨次韵","author":"韩琦","text":"花簇香亭万朵开，雕舆高自九关来。\n轻阴阁雨迎天步，寒色留春送寿杯。\n仙吹彻云终缥缈，恩鱼逢饵几徘徊。\n曾参二十年前会，今备台司得再陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"御制天章阁观三圣御书奉圣旨次韵","author":"韩琦","text":"宝阁三休地，琅函列圣文。\n天章横紫极，洛字覆青云。\n花拆惊雷起，龙腾骇浪分。\n宸毫知善断，更嗣禹邦勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"恭谢天地庆成五言六韵","author":"韩琦","text":"世积皇基厚，天扶帝极安。\n宸心思报重，灵答匪诚难。\n蠲洁斋居敞，凝严路寝宽。\n二仪通圣飨，三后接神欢。\n惠泽开秋惨，和声破晓寒。\n南山荐君寿，峣阙耸群观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祫享庆成五言二十韵","author":"韩琦","text":"大飨无先祫，精祠贵必躬。\n历朝疑未讲，旷典属今崇。\n良月稽冬孟，容台访礼中。\n祀期当象闰，位向卒虚东。\n太卜诹元日，斋诚俨法宫。\n雕舆下丹地，琳馆荐清衷。\n雪密人初骇，天高德自通。\n阴云成瑞霭，凛色变和风。\n世室休严卫，宵衣集庶工。\n叙亲昭穆正，合食簋铏丰。\n既祼神斯格，居歆庆已蒙。\n欢欣流禹律，謦欬入尧聪。\n月射千圭白，星辉万燎红。\n茨歌将振作，晴旭渐曈昽。\n回跸升端阙，群瞻耸上穹。\n蕃釐均庙馂，惠泽泰民穷。\n孝著钩钤动，恩疏贯索空。\n致祥书可信，让美意尔冲。\n此协亨嘉会，惭非辅翼功。\n唯知献君寿，巍与二仪同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明堂庆成五言二十韵","author":"韩琦","text":"至矣君严父，其惟祀配天。\n明堂兹有法，路寝复申虔。\n礼简刊前误，图新焕昔传。\n乾坤隆正位，辰火协高躔。\n宗德停参侑，推尊独大圆。\n兼崇太极坐，并享总章筵。\n节物丰秋后，斋精吉玄前。\n既祗真馆驾，遂洁閟宫牷。\n泛洒轻尘失，涵濡惠泽先。\n直由诚意感，卒使祭无愆。\n翌日回清跸，中宵俨邃延。\n一纯通肸蚃，五室敞蟺蜎。\n和必流金石，馨非主豆笾。\n灵光烛窗户，飙驾触旄旃。\n齐酌终三荐，神釐答万年。\n欢声摇海岳，瑞色变云烟。\n馂已均庖贱，恩思被幅员。\n星鸡随敕竖，赦鹤下楼宣。\n教不烦家至，民惟视德迁。\n普天知子道，斯匪化工然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天章阁观御飞白书五言十韵","author":"韩琦","text":"内阁门清晓，中天对迩臣。\n唐虞遗典在，河洛奥书陈。\n二圣勤劳旧，千龄矩法新。\n帝晖方咫尺，宸翰复躬亲。\n鸾拂宫绡舞，花随御笔春。\n奎光连璧府，剑影动龙津。\n今古神功绝，颁宣上意均。\n玉峰罗俎豆，黼坐拱星辰。\n鱼藻符亨会，蓬瀛寄此身。\n流霞仙饮罢，又赐一杯醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"枢廷对竹","author":"韩琦","text":"一纪前曾对此君，依然轩槛喜重亲。\n丹心自觉同高节，青眼相看似故人。\n不杂嚣尘终冷淡，饱经霜雪尚精神。\n枢廷岂是琴樽伴，会约幽居称幅巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩缜太傅之任洋州","author":"韩琦","text":"昔年疆场宠双旌，官寄洋州实治并。\n今喜远民留上意，故求贤守绍家声。\n升云仙迹唐祠古，踏石春游灙水清。\n时阅吏文应笑我，从前衔署只虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答定帅仲仪龙图寄示堂诗刻","author":"韩琦","text":"好胜时多尚己为，前人勤力必随隳。\n所图营葺犹如是，欲树功名即可知。\n昔慕先贤形藻绘，本同来哲作箴规。\n得公诗刻增光燄，定警媮风变俗漓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏景即事","author":"韩琦","text":"槐耳笼前槛，云峰透曲棂。\n凉风即昆阆，烦思入沧溟。\n荷弱翻青盖，榴新倒绿瓶。\n晚来收骤雨，一枕梦魂醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏暑早时朝二首 其一","author":"韩琦","text":"凉风吹暑豁烦歊，上马迎风趁早朝。\n宿雾欲开星月澹，隐然双阙在层霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏暑早时朝二首 其二","author":"韩琦","text":"夺热清风几快襟，禁街岑寂漏声沉。\n东方似动阴氛失，北斗高垂帝阙深。\n忧国远图深入梦，费诗闲景懒成吟。\n平明天外鸣鞘下，万玉颙然拱极心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"召赴天章阁观新柑","author":"韩琦","text":"云阁崇先重，霜柑荐瑞新。\n临观纡法从，趋召独邻臣。\n虹实开天意，重荣浃上人。\n不随淮枳变，自比禹包珍。\n庙献宸心格，亲颁圣宠均。\n从兹魁众果，仙府占长春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祈雪宿斋醴泉观","author":"韩琦","text":"愆阳经腊恻皇情，遍走灵祠达意诚。\n马殆始知仙府迥，露寒如到月宫清。\n甘泉既久蠲民瘼，惠泽非难涤厉萌。\n日待神龙兴热窟，一吁嘉雪满寰瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戊戌元日喜雪","author":"韩琦","text":"新元迎晓朔风凉，零落同云势渐霶。\n气候未春终是腊，祷祈方得合称祥。\n拜章粉絮迷朝佩，献寿琼花入御觞。\n自是三农丰岁兆，人声何必问宫商。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张吉甫殿丞宰资阳","author":"韩琦","text":"去物轻遐邑，宸心与近均。\n宜将宽诏意，善恤远方民。\n寒驿凫先下，春郊雉自驯。\n白云休引望，馨膳有天伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和崔象之寺丞西亭雨下","author":"韩琦","text":"初暑轩窗覆翠阴，更宜飞雨濯尘襟。\n喜花添色自人意，为岁期丰独帝心。\n馀润日随和气浃，好声时逐远风沉。\n郊原遍采农家议，一寸真如一寸金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庚子重九菊未盛开席上偶成","author":"韩琦","text":"重九开樽节未寒，黄花初发叶皆单。\n待看旬日金铃绽，剩得东篱一醉欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日赏菊未开席上次韵答崔象之寺丞","author":"韩琦","text":"谁知九日接宾觞，未放寒花折露房。\n早是生来悲晚节，那堪开不在重阳。\n满头且应良辰插，一夜宁衰浅意香。\n守待金铃披绝艳，共君搴蕊醉馀芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览崔象之寺丞诗编","author":"韩琦","text":"惊人侍句本天成，艳格清奇不易评。\n秋月照空澄万景，洛花无品尽多名。\n珠藏赤水搜求苦，矿出黄金锻鍊精。\n郊庙有歌犹未采，只输高兴写幽情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祫享加恩押班宣制","author":"韩琦","text":"大祫休成庆泽新，广庭宣制宠臣邻。\n非烟荐瑞笼宫殿，出綍敷言耸搢绅。\n风结冰檐骈玉箸，日融霜瓦半鱼鳞。\n移时始放金吾仗，鹓鹭齐飞出禁闉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辛丑中秋不见月","author":"韩琦","text":"懊恼闲云取次生，中秋观月误人情。\n一时虽不充群望，万古终难掩至明。\n疑有阴魔憎好事，更虞淫雨害丰盛。\n须知席上徘徊意，直似葵心向日倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"崔象之中舍宰阳翟","author":"韩琦","text":"君于荣利已恬然，此治韩城属荐贤。\n惠政即随春共煦，道心常与月同圆。\n门疏俗客禅诠远，亭掩修篁定力坚。\n思退几人曾上籍，可容名记托新篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辛丑季秋大飨明堂中书宿斋","author":"韩琦","text":"紫极宸居重，黄扉禁户深。\n斋精严帝配，祗翼达天心。\n百刻延壶箭，千庐肃羽林。\n秋声来易感，仙梦断难寻。\n小雨随云散，疏星伴月沉。\n树鸡先晓唱，菊酒带香斟。\n寂尔潜神化，翛然适道襟。\n惟馨思在德，肸蚃伫灵歆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书东厅十咏 其一 迎春","author":"韩琦","text":"覆栏纤弱绿条长，带雪冲寒拆嫩黄。\n迎得春来非自足，百花千卉任芬芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书东厅十咏 其二 牡丹","author":"韩琦","text":"当栏新植尽珍丛，异格同妍出化工。\n何物众人惊绝艳，一枝花坼瑞云红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书东厅十咏 其三 夜合","author":"韩琦","text":"合昏枝老拂檐牙，红白开成蘸晕花。\n最是清香合蠲忿，累旬风送入窗纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中书东厅十咏 其四 四季","author":"韩琦","text":"牡丹殊绝委春风，露菊萧疏怨晚丛。\n何似此花荣艳足，四时长放浅深红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]