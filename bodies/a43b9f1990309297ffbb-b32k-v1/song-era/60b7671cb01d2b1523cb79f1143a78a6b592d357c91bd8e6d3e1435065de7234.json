[{"title":"和伯承惠笋 其一","author":"张孝祥","text":"锦箨离离乡触藩，怒雷挟雨更追奔。\n绝甘赖有吴公子，菌蠢猫头不足论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和伯承惠笋 其二","author":"张孝祥","text":"楚产惟渠可定交，时时隔壁望烟梢。\n已烦稚子来相过，更有新诗送岛郊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀长沙知识呈钦夫兄弟 其一","author":"张孝祥","text":"顺宁去覆郎官锦，府谷仍监太府钱。\n唯有吾宗老兄弟，闭门依旧绝韦编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀长沙知识呈钦夫兄弟 其二","author":"张孝祥","text":"春风花柳又芳妍，更接髯郎水竹园。\n小阁横桥俱胜绝，只应欠我共开尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀长沙知识呈钦夫兄弟 其三","author":"张孝祥","text":"召公分陕是东邻，天远堂中好主人。\n更喜新来黄太史，剩拚佳句了新春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀长沙知识呈钦夫兄弟 其四","author":"张孝祥","text":"髯郎高卧元无恙，何日湘滨具一舟。\n肯约春风同过我，为公酾酒炙肥牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀长沙知识呈钦夫兄弟 其五","author":"张孝祥","text":"洛阳家世邢郎子，间止逍遥自在身。\n病肺秋来定苏眚，可能乘兴到沙津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题塔子寺","author":"张孝祥","text":"酴醾压架玉交加，深院无人有落花。\n却忆江南田舍乐，旋敲生火煮新茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题断堤寺 其一","author":"张孝祥","text":"柔桑细麦绿油油，云水烘春烂不收。\n马上困来寻歇处，断堤寺里半时留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题断堤寺 其二","author":"张孝祥","text":"堤边杨柳密藏鸦，堤上游人两髻丫。\n可惜行春来较晚，谁家留得碧桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题断堤寺 其三","author":"张孝祥","text":"古寺留春最得多，紫微花畔海棠窠。\n无人岁晚同幽独，古柏阴森著薜萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"德化漪岚堂感二林碑六言","author":"张孝祥","text":"两林文章翰墨，只今尘上墙阴。\n炎凉莫作世态，是非当印吾心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钦夫遣送箭笋日铸甚珍用所寄伯承韵作六言便请过临","author":"张孝祥","text":"君家稚箭宝茗，赐出太官水衡。\n已约髯吴过我，更须君来细评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钦夫和六言再用韵","author":"张孝祥","text":"君诗与物俱妙，鄙夫那敢抗衡。\n芭蕉辟君三舍，笋脯亦须改评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游湖山赠圆禅六言","author":"张孝祥","text":"素香无脂粉气，好语谐韶濩音。\n有人问西来意，门前秋水沉沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送万老六言","author":"张孝祥","text":"桑下不须再宿，囊中莫留一钱。\n打鼓退高台寺，洗脚上五湖船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次东坡先生韵 其一","author":"张孝祥","text":"微凉入船窗，秋水满湘浦。\n过尽前头滩，只得夜来雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次东坡先生韵 其二","author":"张孝祥","text":"人鱼不相及，挂颊以香饵。\n因循十年错，归计觉今是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次东坡先生韵 其三","author":"张孝祥","text":"悠然望江南，日出烟霭微。\n倚门双白发，屈指待儿归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次东坡先生韵 其四","author":"张孝祥","text":"渔师来卖鱼，船小风荡漾。\n得钱瞥波去，不怕江流涨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次东坡先生韵 其五","author":"张孝祥","text":"朝发方良矶，莫宿白水湾。\n宽作一月程，须见江南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次东坡先生韵 其六","author":"张孝祥","text":"我程可默数，中秋过江池。\n趁得江南米，新舂玉满箕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次东坡先生韵 其七","author":"张孝祥","text":"栈羊割肥红，社瓮拨浓绿。\n再拜为亲寿，起舞自作曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次东坡先生韵 其八","author":"张孝祥","text":"闭门静观心，踵息閟天和。\n从渠江头人，尺水一丈波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题福严寺行者堂","author":"张孝祥","text":"挥毫高山巅，馀墨走龙蛇。\n请收今夜雨，为汝洗袈裟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21815,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题梅坞图","author":"张孝祥","text":"我曾到梅坞，正自画不如。\n是处有风月，君无怀故居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21816,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠赵签","author":"张孝祥","text":"赵侯富贵种，自有岩壑姿。\n同姓古所敦，早晚踏天墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21817,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归宗寺","author":"张孝祥","text":"两峰双涧水，万古一篇诗。\n玉局竟仙去，空山无此碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21818,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"烟雨观","author":"张孝祥","text":"七泽阑干外，兹游亦壮哉。\n主人何处去，犹未赋归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21819,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题朱元晦所书凯歌卷后","author":"张孝祥","text":"我词不足录，聊以醒渠醉。\n更参三十年，当与风子对。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21820,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠万上座","author":"张孝祥","text":"过了铁围山，复生金莲台。\n与问万上座，一笑愁容开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21821,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野牧图 其一","author":"张孝祥","text":"吴牛三十角，久与牧相忘。\n忽忆淮南路，春风满柘冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21822,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野牧图 其二","author":"张孝祥","text":"秋晚稻生孙，催科不到门。\n人闲牛亦乐，随意过前村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题画","author":"张孝祥","text":"权郎笔墨禅，往者屡参请。\n斯人骨已朽，妙处一笑领。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宁渊观","author":"张孝祥","text":"极目洪波渺，轰轰浪接天。\n江心分殿宇，敕赐号宁渊。\n日照山如画，云浓小似烟。\n休寻蓬岛地，只此水中仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒光亭","author":"张孝祥","text":"亭依三塔占清幽，松竹环除翠欲流。\n晚色晴开千嶂月，波光冷浸一天秋。\n琼瑶影里诗僧屋，云锦香中钓客舟。\n风送不知何处笛，雁声惊起荻花洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读书堂在乌江即唐张文昌读书处自五代至宋皆世守之渡江后为史氏所有","author":"张孝祥","text":"漫有五车书不读，岂似一编勤过目。\n痴儿鬻肆蠹鱼书，巨富牙签尘满屋。\n市南水竹一亩空，平生腹笥史长公。\n闭户却扫得真乐，冥搜万古窥鸿濛。\n淹留岁时亦何有，策勋兹事要持久。\n吾家文昌读书处，好在溪山落君手。\n上方治定登文儒，东观石渠森宝书，望公起直承明庐。\n从来海内知名士，须读人间未读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21827,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏梅次韵二首 其一","author":"张孝祥","text":"楼上箫声欲断魂，仙官分与一枝春。\n旋摧妆额添新样，细撚香须数玉尘。\n月下精神宜淡贮，雪边肌体更清匀。\n老来花事无消息，只有君诗当写真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21828,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏梅次韵二首 其二","author":"张孝祥","text":"天与孤标不受尘，生憎桃李斗芳新。\n诗成名下无虚士，花在身边当丽人。\n只恐素英欺白发，试烦纤手插乌巾。\n风流今代神仙尉，管得河阳县里春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21829,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上辟廱","author":"张孝祥","text":"金铜隐花古龙涩，朱干大羽纷纭立。\n宝钟玉磬垂丁东，和鸾雍雍八音翕。\n鲸吞虎噬二十年，至尊戎衣不解鞍。\n里中小儿事刀剑，管钥掷去尘漫漫。\n真儒倏兴明典礼，周庠连云斩荆祀。\n银袍如云拱翠华，师儒便坐讲经旨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21830,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"船斋","author":"张孝祥","text":"斋居安稳似乘船，鱼跃池光鹭宿烟。\n还有一生江海客，钓竿闲放日高眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21831,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄方帅 其一","author":"张孝祥","text":"吴楚山河尽付公，君王长策在平戎。\n人才王谢风流似，地望东西节制雄。\n赤手尚能探虎穴，白头空是钓鱼翁。\n将军知我非徐庶，不向江边起卧龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21832,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄方帅 其二","author":"张孝祥","text":"贱子如今休说穷，玉麟铜虎信频通。\n君今持橐甘泉里，我不投书苦海中。\n且愿耕桑依地主，长教温饱荷天公。\n回思三十三年事，一笑相逢两秃翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用前韵送彪德美","author":"张栻","text":"尝嗜贵知味，短绠难汲深。\n读书不能发，但自成书淫。\n况复翻异说，潢流渺难禁。\n岂知言意外，妙此惟微心。\n初无古今异，岁月谩骎骎。\n五峰讲学地，叹息风雨侵。\n前时约同途，旧游怆追寻。\n鸣凤不可见，修竹馀清阴。\n斯文天未丧，千载发韶音。\n春风满天宇，鱼鸟自飞沉。\n河流贯霄极，芥舟胶寸涔。\n神交独吾子，妙处但微吟。\n文会匪易得，未应归故林。\n君无泉石癖，膏肓讵须箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淳熙四年二月既望静江守臣张某奉诏劝农于郊乃作熙熙阳春之诗二十四章章四句以示父老俾告于其乡之人而歌之","author":"张栻","text":"熙熙阳春，既发既舒。\n翼翼南亩，是展是图。\n嗟尔农夫，各敬乃事。\n往利尔器，诫尔妇子。\n惟生在勤，勤则及时。\n惟时之趋，时不尔违。\n祁祁甘雨，膏我下土。\n习习谷风，和泽乃普。\n往即尔耕，惟力之深。\n往莳尔苗，勿倦其耘。\n于日于夕，自遂自达。\n尔心勿忘，彼生孰遏。\n惟天之心，矜我下民。\n民不违天，使尔有成。\n既穟既实，既坚既好。\n尔穫既周，先养尔老。\n保尔家室，抚尔幼稚。\n既迄有年，复思嗣岁。\n嗟尔父老，其训其诫。\n俾务于本，惟土物爱。\n不念其本，则越其思。\n所思既越，害斯百罹。\n嗟尔父老，其告其喻。\n尔之有生，君实覆汝。\n尊君亲上，其笃勿忘。\n小心畏忌，率于宪章。\n嗟尔父老，教之孝悌。\n孰无父母，与其同气。\n反于尔心，孰无爱敬。\n即是而推，乌往不顺。\n嗟尔父老，勿替谆谆。\n其未率从，警厉其身。\n告以祸患，其使知惧。\n无俾蹉跌，以陷罪罟。\n惟国之法，烨烨其垂。\n使尔知避，岂欲尔施。\n尔或自陷，予疚予恫。\n曷使予怀，寘于尔衷。\n于赫圣主，敷德流泽。\n布宣弗勤，时予之责。\n咨尔父老，助予念兹。\n岂予之助，报国是宜。\n粤以今日，劝相于郊。\n乃作此诗，以懋尔劳。\n咨尔父老，尚演厥义。\n其讽其歌，于乡于里。\n俾一其心，服我训言。\n击鼓坎坎，自古有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21835,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿方广寺","author":"张栻","text":"俗尘元迥隔，景物自天成。\n山近四围碧，泉鸣永夜清。\n月华侵户冷，秋气与云横。\n晓起寻归路，题诗寄此情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21836,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送祖七侄西归二首 其二","author":"张栻","text":"故国非乔木，名家重典刑。\n飘零念吾党，寂寞抚遗经。\n菽水知何病，芝兰要满庭。\n汝归应记取，为我话丁宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21837,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题城南书院三十四咏 其二十","author":"张栻","text":"野艇新成寻丈许，柳堤橘浦足周旋。\n添蓬不但为遮日，准拟乘凉听雨眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21838,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昨日与周伯寿别终夕雨小诗追路","author":"张栻","text":"夜雨虚檐响彻明，地蒸衣润欲生云。\n想君渚路频回首，我亦书窗倍忆君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21839,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有叹 其二","author":"陈造","text":"郊原二月天，节物属丹素。\n山风欻雪花，野屋欲冰柱。\n破除酒边兴，截断口前句。\n谁将万玉妃，一一事娇妒。\n东皇不无情，退缩自失据。\n史君文章家，客子旧能赋。\n兹游岂偶然，拟作袖手去。\n江梅孤旧约，桃花怅前度。\n漂忽几何时，林影映沙步。\n层云放皦日，瑩澈等僧悟。\n一笑百虑馀，如世有晚遇。\n预知诗及门，新语谢盐絮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21840,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"招朱法曹赵宰赵予野饮 其二","author":"陈造","text":"自公置簿领，来作一笑适。\n表表三英粲，各各万夫特。\n揆予自侨寓，人诧有此客。\n风烟入挥毫，江山皆动色。\n尚友古所贪，解后归来得。\n今朝乡思动，招邀话暌隔。\n非复向轩豁，但有新凄恻。\n吟诗尚尔工，把酒不能吃。\n县知短长亭，小蓬云月白。\n还应蘧蘧梦，蜚堕清江侧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21841,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自适三首 其一","author":"陈造","text":"自怜老瘦仍痴绝，每强衰颜趁后生。\n疗癖无方了诗课，迷魂有寨对棋枰。\n绕床不著阿堵物，玩世何须身后名。\n倚赖儿曹解人意，典衣长得解馀酲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21842,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自适三首 其二","author":"陈造","text":"渺漭湖天入短篷，心期祇许白鸥同。\n人言火食阆蓬客，自命官身田舍翁。\n酒可销闲时得醉，诗凭写意不求工。\n更那长日温书眼，一送蜚鸿下远空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21843,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自适三首 其三","author":"陈造","text":"云水为家百累无，意行从昔略方隅。\n饮忘醒醉狂常尔，梦到无何午未苏。\n遗俗可辞翻袜错，付渠阴作负舟趋。\n譊譊礼法工相聒，闭户仍防大小儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21844,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵雪诗","author":"陈造","text":"欺梅泻竹透承尘，荧侮东风似妒春。\n匝地闾阎皆种玉，插空楼观忽镕银。\n窗明尚忆耽书夜，身曲谁怜旅食人。\n亲见飞仙下瑶检，诸公居处与天邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21845,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次韵二首 其二","author":"陈造","text":"尘中谁定免营营，鹭渚鸥沙且旧盟。\n夙世林逋漫千首，逢人圆泽悟三生。\n扣门喜共僧窗饭，斲句犹能镜样清。\n身世已抛春梦外，更于文字措讥评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21846,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新晴","author":"许及之","text":"连旬困梅霖，接夏潦乘溽。\n泄云涣新霁，游兴难管束。\n出关便航湖，停篙葑蒲绿。\n渔歌入浦溆，沙禽乱惊浴。\n昏霏送霞落，依稀辨林谷。\n初更电辉摇，轻雷忽相续。\n蛙声杂猛雨，波翻碎鸣玉。\n何能足清睡，快举卮酒沃。\n明朝看晨光，未必非所欲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21847,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵叶德友苦热吟","author":"许及之","text":"避暑本无法，有法心可移。\n达尊迫人事，盛服严天威。\n六月厉戈甲，百鍊亲炉锤。\n前驱上峻坂，后鞭禁长吁。\n正午万灶增，尅晷千夫炊。\n辕门待排结，军令无徐舒。\n陆浑救急燎，栾巴稽噀霏。\n期以片时灭，不许一草萎。\n醲赏激勇往，毕力争忘疲。\n不计挥汗雨，宁思濯风漪。\n当其用力所，岂复知热时。\n万事心地存，百夫火宅驰。\n四时更代谢，二至争愆逾。\n积阴理必复，大夏阳常居。\n及此当歊赩，岂得怀郁纡。\n杜愿踏层冰，几欲投清池。\n韩思坐深甑，为说亦岂疏。\n极知隶元气，孰与逃象滋。\n聊用供嘲咏，且以相戏娱。\n吾侪幸安适，家食饕委蛇。\n念彼方热耘，焉能思逃虚。\n静胜昔人心，屡空斯晏如。\n况予负深谴，省咎阖重扉。\n友朋相急难，往复通有无。\n每怀子叶子，久与期襟期。\n有此苦热吟，句韵两崛奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21848,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜雨次韵翁常之苦热吟","author":"许及之","text":"羲和不弭驭，炎帝方秉机。\n孰不爱赵衰，谁肯触武威。\n岂知铄金石，乃得齐璿玑。\n鹿角甫云解，葵箑无停挥。\n万宝成南讹，一枕安北扉。\n殿閤施馀薰，茅茨溥增辉。\n鼎鼎百年内，咄咄七十稀。\n临流抒我怀，新浴振我衣。\n雷雨急生凉，天恩觉沦肌。\n诗来取静胜，句到不吾欺。\n盛服思客位，重铠念边陲。\n当暑如怀秋，秋至勿兴悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21849,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再酬常之","author":"许及之","text":"理极终必复，孰逃造化机。\n司夏流中气，执衡振严威。\n有怀渴云霓，不愿雨珠玑。\n油然起崚嶒，闪若惊霍挥。\n嘉泽彻中霄，凉飙入重扉。\n良苗固怀新，冶叶亦生辉。\n从欲天匪私，屡丰古实稀。\n垂老藉香火，凌晨肃裳衣。\n百拜屈我躬，万感铭我肌。\n兹生每有逢，末路敢为欺。\n正尔饱丘壑，及此轸疆陲。\n念终抱愧耻，已矣徒伤悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21850,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋见怀","author":"许及之","text":"明月出海底，先照彤庭墀。\n正以合德故，争效朝宗驰。\n须臾散精彩，普率扬明辉。\n常时或显晦，所历随茫瀰。\n及兹秋中气，燎然光满规。\n岂但碧汉澄，无复宿雾披。\n如坐水晶宫，更泛碧琉璃。\n凛凛栗肤发，炯炯析毫釐。\n竟欲乘浮槎，试与穷垠涯。\n或拟斫却桂，或云生桂枝。\n蟾宫到者折，不生岂不稀。\n玉斧修何事，倒即无倒期。\n沉吟自绝倒，痛饮忘倾攲。\n兹辰病因仍，良行觉支离。\n始行浮云多，犹欲一口吹。\n东床念斋夕，妙语寄相思。\n词到律自协，意古趣更奇。\n今虽减冰轮，犹照蘸甲卮。\n寄声巷南翁，斯辰可无诗。\n我欲资隽永，庶以得自颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21851,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"侍南轩先生卷云亭望岳麓积雪分韵得初作二字","author":"许及之","text":"新元既涉九，腊尾春未初。\n司寒励馀职，飞雪来庭除。\n因风稀复密，潜阴惨还舒。\n瑞色入陇麦，祥膏润园蔬。\n未足映书读，已宽带经锄。\n和气融比屋，所积惟林庐。\n怅焉起遐观，未知问所如。\n南轩笑领客，操已敢作疏。\n岂无门下生，不肯升篮舆。\n冲泥按徐辔，秀句生蹇驴。\n卷云毕清集，湖山眇开予。\n蜿蜒翠麓中，万瓦参琼琚。\n急扫供茗事，隔江竟烦渠。\n终日乐未央，不为食有鱼。\n十韵分九人，其一固闰馀。\n并以属汰砾，敢下冯妇车。\n屯云方杂沓，二白难踌躇。\n须公专吟笔，载赓仍屡书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21852,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]