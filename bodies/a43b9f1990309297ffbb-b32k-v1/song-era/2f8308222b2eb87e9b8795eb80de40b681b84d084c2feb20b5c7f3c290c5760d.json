[{"title":"小桥","author":"赵鼎臣","text":"山接青天欲荡摩，秋风骚客独经过。\n怪来诗句无容和，端为烟岚发兴多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饮方池诗","author":"赵鼎臣","text":"闻说髯卿酒屡中，清尊惟与故人空。\n醉穿驰道归家去，十里花枝相映红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜泛剡溪","author":"赵鼎臣","text":"剡溪清浅石棱棱，夜半星稀月欲升。\n独恨此间无可访，不须野雪兴方乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘阮祠","author":"赵鼎臣","text":"采药偶从山里去，寻家却自洞中归。\n朝云暮雨漫愁绝，古往今来果是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双林寺","author":"赵鼎臣","text":"邂逅每携诗卷往，猖狂复带酒樽来。\n逢春须作游山兴，莫待红残吁可哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"犹子弃画盘谷图戏书其后","author":"赵鼎臣","text":"欲买青山未有钱，每逢佳处但垂涎。\n一庵所占无多地，赊我盘中数亩田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"古意堂","author":"赵鼎臣","text":"破鼎如铛价万金，古文科斗费推寻。\n不须更待琴弦足，会有幽人识此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独往亭","author":"赵鼎臣","text":"亭前旧种碧琅玕，别后何人著眼看。\n山下溪流接潮水，时凭双鲤报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏马子约","author":"赵鼎臣","text":"罗敷十六鬓如云，五马徘徊动使君。\n见说黄金难可意，试凭青翼去相闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"歌","author":"赵鼎臣","text":"玎珰响铁未须敲，更听清声彻碧霄。\n最爱六么花十八，索人起舞眼频招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余有鉴其制如书册戏号勋业簿取子美诗所谓勋业频看鉴者马子约题诗其上云勋业簿中频点捡只添白发与苍颜和之","author":"赵鼎臣","text":"人心各自如其面，白首论交尚不情。\n惟有个中真莫逆，时时相对说平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十五日冬至次长垣王强夫置酒雪大作醉中踏雪步行出西城登锦绣亭","author":"赵鼎臣","text":"萧萧冷木噪寒鸦，未有春风发柳芽。\n应为亭边无锦绣，天公散水自成花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏书纸尾寄犹子弃问锦绣亭春色","author":"赵鼎臣","text":"新年桃李渐胚胎，锦绣亭边处处栽。\n寄汝馆陶三尺素，要知春色写将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赤尉苏太原寄半丈红走笔谢之","author":"赵鼎臣","text":"京兆官曹箠楚中，今年春色又成空。\n应怜头里千茎雪，折赠枝间半丈红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游洪福不果入","author":"赵鼎臣","text":"愁风愁雨一春中，无限芳菲转手空。\n不到武陵肠欲断，桃花可惜为谁红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"棠梨","author":"赵鼎臣","text":"晓驱羸马日将中，眼饱何曾念腹空。\n可是爱花狂不彻，棠梨树下觅残红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游石桥遇隐者","author":"赵鼎臣","text":"巨石引飞梁，奔泉泻纤缟。\n行攀石上藤，坐听林间鸟。\n兹游既物外，此地即天表。\n旷然脱尘嚣，率尔慕轻矫。\n道逢餐霞人，邂逅惬幽讨。\n绝粮三十年，颜色长美好。\n云此岩上芝，可得终岁饱。\n盛谈山中趣，似欲容吾老。\n平生苦因循，学道真不早。\n忧患日煎熬，精神岁消槁。\n况为官拘挛，而与事缠绕。\n悲欢相乘除，失多殊得少。\n君言会可思，待我婚嫁了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿天章寺","author":"赵鼎臣","text":"高士已陈迹，青山犹故居。\n地存脩禊水，俗有换鹅书。\n旧像丹青改，诸山楷法疏。\n我来寻坏壁，妄意有遗馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"赵鼎臣","text":"词源江海浩奔忙，句法风骚森出入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"赵鼎臣","text":"古来此景叹经岁，今夜谁家不倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋夜与赵承之杨时可月下联句","author":"狄流","text":"无正文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"赵子栎","text":"夜棋三百子，晓发一千梳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"赵子栎","text":"发为干戈白，心于社稷丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"赵子栎","text":"杜鹃不是蜀天子，前身定是陶渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂 其一","author":"黄叔敖","text":"今代勋名第一人，聊从小筑艺松筠。\n风云天上千龄运，雨露人閒万井春。\n莫倚丘园甘独乐，须知海宇仰洪钧。\n行闻勉为苍生起，衮绣来归耸搢绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂 其二","author":"黄叔敖","text":"望隆江左谢太傅，功冠淮西裴晋公。\n何事东山却高卧，空馀绿野想遗风。\n矫情镇物端谁似，晚节全身与俗同。\n再拜祝公追往辙，中兴周室赖元功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禁苑","author":"韩浩","text":"星斗疏时禁漏残，紫泥封后独凭栏。\n露和玉屑金盘冷，月射珠光贝阙寒。\n天衬楼台笼苑外，风吹歌管下云端。\n长卿祇为长门赋，未识君王际会难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哀隆德守臣张确确浮休张舜民之弟尝为乌延帅幕独不廷谒童贯作诗吊之","author":"滕茂实","text":"睢阳万古一张巡，忠义传家有世臣。\n颜子伏膺当入室，潘郎望拜肯同尘。\n围城已陷天犹晦，仗剑临危气益振。\n馀子邻邦尽曹李，偷生端作九泉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天宁节有感","author":"滕茂实","text":"节临重十庆天宁，古殿焚香祝帝龄。\n身在北方金佛刹，眼看南极老人星。\n千官花覆常陪燕，万里云遥阻在廷。\n松柏满山聊献寿，小臣孤操亦青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后蔬盘可喜偶成","author":"滕茂实","text":"过雨盘蔬日日新，从今休叹庾郎贫。\n寒齑安取咄嗟办，火食不忧生苑邻。\n野苋何施虽可鄙，美芹欲献去无因。\n干戈万里风尘晦，惭愧平生肉食人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五日","author":"滕茂实","text":"节物惊心动远思，薰风又见浴兰时。\n空寻好句书纨扇，无复佳人系綵丝。\n酒注菖蒲唯欲醉，筒包菰黍不胜悲。\n明年此日当何处，风里孤蓬自不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜雨","author":"滕茂实","text":"旱暵雨沾渥，丰穰都不疑。\n商羊应屡舞，布谷强多知。\n龙见宁非数，云行自有时。\n当年班夏令，曾得近丹墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成","author":"滕茂实","text":"纤云卷尽见秋容，古木交阴一埽空。\n雪压群山晓来雨，叶侵缺甃几番风。\n欲归未得人将老，屡送还来鬼亦穷。\n赖得子卿佳传在，整冠时读慰飘蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立春","author":"滕茂实","text":"东皇布政物皆春，山色禽声便可人。\n满谷和风消积雪，半窗晴日动游尘。\n宫花插帽枝枝秀，菜甲堆槃种种新。\n拘窘经时成土俗，聊从一醉适天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临终诗","author":"滕茂实","text":"齑盐老书生，谬列王都官。\n索米了无补，从事敢辞难。\n殊邻复盟好，仗节来榆关。\n城守久不下，川涂望漫漫。\n俭辈果不惜，一往何当还。\n牧羊困苏武，假道拘张骞。\n流离念窘束，坐阅四序迁。\n同来悉言归，我独留塞垣。\n形影自相吊，国破家亦残。\n呼天竟不闻，痛甚伤肺肝。\n相逢老兄弟，悼叹安得欢。\n金人自南归，得志鞍马间。\n波澜卷大厦，一木难求安。\n世事宁有此，聊发我所存。\n爵禄非所慕，金珠敢怀贪。\n就不违我心，渠不汗我颜。\n昔燕破齐王，群臣望风奔。\n王蠋犹守节，燕人有甘言。\n经首自绝脰，感槩今昔闻。\n未尝食齐禄，徒以世为民。\n况我禄数世，一死何足论。\n远或死江海，近或死朝昏。\n敛我不须衣，裹尸以黄幡。\n题作宋臣墓，篆字当深刊。\n我室尚少艾，儿女皆童顽。\n四海无置锥，飘流倍悲酸。\n谁当给衣食，使不厄饥寒。\n岁时一酹我，犹足慰我魂。\n我魂亦悠悠，异乡寄沉冤。\n他时风雨夜，草木号空山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠吴德夫","author":"郭忠孝","text":"云霄拂衣早，幽意满江湖。\n天地英声在，风流何代无。\n属辞还两汉，垂钓合三吴。\n倚棹伤今古，长歌击唾壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与吕微仲范彝叟登福山寺","author":"郭忠孝","text":"夹路东风花欲燃，群仙携傍翠微巅。\n空阶遍撒金莲火，虚殿高烧宝篆烟。\n禅寂静谈支遁后，道源真悟伏羲前。\n寻僧未及鸠莲社，且共清樽石榻连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄张元德秘书","author":"郭忠孝","text":"良觌暌违数载馀，故人踪迹近何如。\n春秋藉子发精义，周易惭余无特书。\n山阁停云愁绝处，屋梁落月梦回初。\n何时共剪西堂烛，尊酒论文剪野蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"潘中","text":"二帝蒙尘事北征，小臣无计泪如倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答问","author":"释思净","text":"平生只解念弥陀，不解参禅可奈何。\n但得五湖风月在，太平不用起干戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过东湖","author":"程迈","text":"枢密中朝杰，常怀物外心。\n碧山高杖履，黄发乐泉林。\n菊酿上尊酒，风传太古琴。\n乌衣佳子弟，玉树正森森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"止戈堂和诸公韵","author":"程迈","text":"天河谁挽洗兵尘，远播皇威到海滨。\n畏垒草封悲战月，乐郊农满际耕春。\n七闽草木无腥气，诸将恩勤有赐珍。\n穆穆清风堪作颂，犹沾湛露及微臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"霭山院","author":"程迈","text":"丙午峰前翠作堆，白云深处现楼台。\n老僧法地有神力，能使凶徒念佛回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"詹默","text":"茅屋不闻雪，纸窗宜读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"詹默","text":"山人误采枪旗信，却怪枝头雪未消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"詹默","text":"下僚窃有随车喜，遥见枝头少女风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"詹默","text":"莫似公家三十五，时来不寄一行书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三门砥柱","author":"张保源","text":"凿开山骨过长河，水土方平叙九歌。\n举世但传神禹力，谁人知是帝功多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夫人城","author":"王宗旦","text":"诗人刺哲妇，老氏戒佳兵。\n何此金汤固，长存粉黛名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石姥山","author":"周兑","text":"石貌苍颜迥不殊，天工偶尔赋形躯。\n顽然本是无情物，应误行人指望夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨涌泉","author":"周兑","text":"杨岐山下出灵泉，与海相通亘古传。\n汹涌便知天欲雨，为言阴石不须鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题毛仙山","author":"周兑","text":"仙翁辟谷绿毛生，假向人间作姓称。\n应与桐君为伴侣，丹成白日共飞升。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罗汉影","author":"周兑","text":"法身无著本来空，应供随缘处处同。\n偶向石间留个影，一轮秋日碧潭中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"葛仙坛","author":"周兑","text":"稚川不恋晋衣冠，勾漏仙成九转丹。\n剩得数行风雨竹，人间珍重扫空坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九房石","author":"周兑","text":"巍巍古殿峙中央，匼匝屏风列九房。\n莫惜冥搜访仙迹，其间恐有紫金床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鄂渚作","author":"杨克一","text":"洞庭无风时，上下皆明月。\n微波不敢兴，甚静蛟蜃穴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遗荥阳公","author":"杨克一","text":"雨绿霜红郭外田，山浓水澹欲寒天。\n参军抱病陪清赏，一檄呼归亦可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄吕本中","author":"杨克一","text":"东平佳公子，好学到此郎。\n别去今几日，结交皆老苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"杨克一","text":"不知更事多，但觉拜人少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端午","author":"黄朝英","text":"孟君此日钟英气，王凤今朝袭庆源。\n五色呈祥文必显，丙时先诞位非尊。\n兰汤备浴传荆俗，水马浮江吊屈魂。\n因笑唐家公主騃，预令驰驿剪祗洹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和运使修升阳观落成","author":"吉康国","text":"被命经营始，鸠工结构初。\n深严开殿奥，高敞称楼居。\n室外飞檐巘，岩隈下屋渠。\n钟声薄霄汉，祠事走邱墟。\n遁世谁能洒，登高迥莫如。\n鹤游三岛驾，人望五云车。\n绮井风光润，疏寮月影舒。\n威仪模紫极，形势巩堪舆。\n池有泉球旧，坛空级石馀。\n霓旌那复下，绛简更谁书。\n童子追前躅，愚生泣太虚。\n烟霞犹赫奕，松竹自扶疏。\n封号方连进，休祥已密储。\n跻兹仁寿域，率土庆于胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"田舍作","author":"薛唐","text":"世业存五亩，家风守二南。\n适情无过睡，幽事不妨贪。\n母老厨增肉，朋来树选柑。\n每惭躬稼穑，未及野农谙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋眠","author":"薛唐","text":"凉色正堪弄，新砧绝可怜。\n况兼梧叶响，槭槭到床边。\n群雁叫远渚，孤云停莫天。\n郊居迎送寡，秋日足高眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书壁","author":"薛唐","text":"自甘藜藿不求鱼，大笑冯生出想车。\n才子座中悲邺下，高篇社里厌黄初。\n不臣未遂忠臣志，生子犹能读父书。\n酒后放言挥秃管，元龙豪气本难除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登州黄县卢山延真观纪异","author":"徐三畏","text":"芝阴旧是神仙宅，驾鹤泠风著前籍。\n青冥倒影不可寻，閒有遗灵表奇迹。\n往时瑞草出西楹，蟠茎引蔓缘屋壁。\n蓊郁青葱净点尘，覆被仙容周幄帟。\n通人备考神农经，无说无名终不识。\n传之于今三十年，目睹耳聆犹历历。\n迩来复见古砌下，冰结池面坚铁石。\n中有锁细百千状，贯玉联珠相倚植。\n炉形塔影最明察，俨如天匠穷彫刻。\n堵观魄动骇且疑，试为求端一推覈。\n有道致祥闻自古，谅由叶气潜薰炙。\n川珍岳贡惟恐后，器车丹甑何由惜。\n舜廊渊默正垂衣，鸿塞清夷方偃伯。\n宜哉殊像发重□，□应兴龙靡差忒。\n至圣谦冲美不居，瑞合图书禁笺册。\n草茅爵跃赋巴□，窃与尧民喧壤击。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月五日从德俭大夫游卢山圣境坐中作以纪一时异事","author":"守亿","text":"明庭事业青云上，暂屈鸣弦非所望。\n闻有灵踪在境中，何从挥鞭时一访。\n石路盘纡入道家，老松偃蹇枝槎枒。\n昔年煮药卢童子，尝闻白日乘云霞。\n红尘不到神仙窟，殿宇荒凉古突兀。\n海近幽深春未来，寒风吹池水生骨。\n厚冰无文印沈冥，一泓斜卧云母屏。\n屏底有物色如玉，隐隐结就浮图形。\n澄澄照眼琉璃瑩，还同倒影落明镜。\n殆非人巧出天工，聋俗安知凡与圣。\n吾皇德泽被四夷，产此正是兴龙时。\n画图难展丹青手，聊作升平瑞应诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江梅","author":"田亘","text":"千林含冻郁苍苍，只有江梅独自芳。\n暗吐幽香穿别院，半敧斜影入寒塘。\n冰肤宛是姑仙女，粉面端疑骑省郎。\n若是蜜奴曾拂掠，肯收红艳贮蜂房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"飞鸢","author":"田亘","text":"涎涎晴空作鹘盘，仰空谁不羡高闲。\n岂知尽日劳心眼，只在尘寰腐鼠间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王晋卿图瀛山笔画精致京师贵游蓄之为希代之宝自图书弃掷于路阳翟张飞卿见而得之过九江以遗友人傅延之延之出以示余余悲而赋诗","author":"田亘","text":"他日缄幐属贵游，讵知迁徙过南州。\n天涯与汝共沦落，泪湿湓江烟雨秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]