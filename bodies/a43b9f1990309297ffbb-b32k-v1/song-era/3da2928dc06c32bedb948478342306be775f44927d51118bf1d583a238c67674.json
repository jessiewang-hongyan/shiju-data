[{"title":"杂兴五首 其三","author":"陆游","text":"家本徙寿春，遭乱建炎初。\n南来避狂寇，乃复遇强胡。\n于时髧两髦，几不保头颅。\n乱定不敢归，三载东阳居。\n人事固难料，今乃八十馀。\n努力未死间，读我先人书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴四首 其二","author":"陆游","text":"东家饭牛月未落，西家打稻鸡初鸣。\n老翁高枕葛幮里，炊饭熟时犹鼾声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴四首 其三","author":"陆游","text":"寿年本偶尔，亦与富贵同。\n一日复一日，遂作八十翁。\n几杖称大耋，貂蝉号三公。\n信手忽成卢，孰为拙与工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴十首 其二","author":"陆游","text":"南山手自斸苍苔，竹阁柴扉次第开。\n二十里间云不断，岂容一点市尘来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴五首 其五","author":"陆游","text":"三吴气候异，开岁固多雨。\n今年已暮春，霁日仅可数。\n寒气薄腠理，沉痛结心膂。\n遣奴买药物，日夜事炮煮。\n端居情怀恶，欲出泥淖阻。\n安得平生欢，驾言问良苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴四首 其二","author":"陆游","text":"兰台遗漆书，汲冢收竹简。\n辛勤万卷读，不负百年眼。\n围座浩纵横，插架高?嵼。\n一笑顾吾儿，银艾何足绾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴四首 其一","author":"陆游","text":"足弱仅能行，齿摇常欲堕。\n扶持赖药物，苟幸一日过。\n事来强酬答，其实惟欲卧。\n平生许文休，岁晚依马磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴四首 其二","author":"陆游","text":"炷香火要深，作墨手当缓。\n浅士务成速，所以多后患。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴四首 其四","author":"陆游","text":"涤砚欲其洁，磨镜欲其明。\n愿君试思之，与己孰重轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴十首 其五","author":"陆游","text":"冰壶冷浸玉芙蕖，三伏炎蒸一点无。\n净洗砚池潴墨沈，乘凉要答故人书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴四首 其三","author":"陆游","text":"硕果坠池响，鱼队散无迹。\n空弦可落雁，此事盖自昔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴四首 其一","author":"陆游","text":"锄草春愈茂，养草秋亦衰。\n不如两置之，荣悴渠有时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴五首 其一","author":"陆游","text":"谋生在衣食，不仕当作农。\n识字读农书，岂不贤雕虫。\n妇当娶农家，养蚕事炊舂。\n晨耕候春扈，夜织惊秋蛩。\n畦蔬胜肉羹，社酒如粥醲。\n毋为慕朝帻，谄笑求见容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴四首 其三","author":"陆游","text":"涨水入我庐，萍叶黏半扉。\n日出水返壑，念汝何由归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴四首 其二","author":"陆游","text":"栖鸡未旦鸣，粒食固宜报。\n林鸟何预人，哓哓欲谁告。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴四首 其二","author":"陆游","text":"万物各有时，蟋蟀以秋鸣。\n我老自少眠，那得憎此声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴四首 其四","author":"陆游","text":"少年岂知酒，借醉以作狂。\n中年狂已歇，始觉酒味长。\n湛湛瘿樽绿，酌以红螺觞。\n醒醉不可名，兀坐万事忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴四首 其一","author":"陆游","text":"风雨鸡喔喔，雪霜柏森森。\n独居虽无友，二物感我深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴五首 其二","author":"陆游","text":"家世本臞儒，自奉至俭薄。\n肉食固难期，间亦阙盐酪。\n宾朋饭芋豆，时节羹藜藿。\n偶然设鸡豚，变色相与作。\n家居常守此，自计岂不乐。\n蔬园畏蹴蹋，切勿思大嚼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴五首 其四","author":"陆游","text":"读诗读七月，治书治无逸。\n王业与农功，事异理则一。\n此外复何为，齐民有遗术。\n一饱不啻足，切勿为利訹。\n大屋起道傍，百鬼阚其室。\n曷不观陆翁，食菜开九秩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴十首以贫坚志士节病长高人情为韵 其九","author":"陆游","text":"鲁山粹而博，韶美旷且真。\n石渠东观中，久矣无若人。\n飞仙骖凤鸾，岂久混世尘。\n空馀文章在，常与日月新。\n我虽不足数，畴昔忝交亲。\n尚想秋灯下，对影攲幅巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴十首以贫坚志士节病长高人情为韵 其四","author":"陆游","text":"少年喜结交，患难谓可倚。\n宁知事大谬，亲友化虎兕。\n出仕五十年，危不以谗死。\n始畏囊中锥，宁取道傍李。\n老来多新知，英彦终可喜。\n岂以二三君，遂疑天下士。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴十首以贫坚志士节病长高人情为韵 其二","author":"陆游","text":"孟子辟杨墨，吾道方粲然。\n韩愈排佛老，不失圣所传。\n伐木当伐根，攻敌当攻坚。\n坐视日月食，孰探天地全。\n一木信难恃，要忧大厦颠。\n安得孟韩辈，出为吾党先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11697,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴十首以贫坚志士节病长高人情为韵 其六","author":"陆游","text":"观人如观玉，拙眼喜讥评。\n得失顾在人，玉固非所病。\n庆历嘉祐间，人才于斯盛。\n王回仅一招，石介弃不聘。\n乃知天下士，成败各有命。\n愿君姑安之，天定岂不胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11698,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴十首以贫坚志士节病长高人情为韵 其七","author":"陆游","text":"两山如蛾眉，一水若车辋。\n吾昔庐其间，百里临莽苍。\n少年手艺木，条干日夜长。\n咿哑驾独辕，迢递摇两桨。\n平生会心地，今乃寄梦想。\n何时唤邻翁，烟水行布网。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11699,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴十首以贫坚志士节病长高人情为韵 其八","author":"陆游","text":"货财不可居，禄位不可饕。\n我尔本一家，何至皋兰鏖。\n小夫谋人国，纷纷日煎熬。\n或谓性本恶，或谓经无褒。\n误人方自此，孰如饮醇醪。\n清言亦自佳，遗事非徒高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11700,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴十首以贫坚志士节病长高人情为韵 其一","author":"陆游","text":"仕宦遍四方，每出归愈贫。\n寒暑更质衣，笑倒邻里人。\n今年作史官，坐糜太仓陈。\n无如思归何，日夜望绝麟。\n区区牛马走，龊龊虮虱臣。\n恩深老不报，肝胆空轮囷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11701,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴十首以贫坚志士节病长高人情为韵 其五","author":"陆游","text":"昔我游庐山，夜遇东林雪。\n灰深火正热，膏减灯半灭。\n童惊林虎过，僧惜涧松折。\n至今每追想，可解肺肝热。\n那知蓬山梦，忽继此清绝。\n殊胜苏子卿，餐毡持汉节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11702,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴十首以贫坚志士节病长高人情为韵 其十","author":"陆游","text":"君子尚大节，又甚恶不情。\n鲁连故可人，用意终近名。\n千载高夷齐，采薇忘其生。\n周公述易象，所以贵幽贞。\n去圣虽已远，江左见渊明。\n我读饮酒诗，朱弦有遗声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11703,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂兴十首以贫坚志士节病长高人情为韵 其三","author":"陆游","text":"圣人固多能，艺乃以不试。\n嗟予少贫贱，日月成坐弃。\n矧今耄已及，甘食而美睡。\n道衰朋友散，斯文凛将坠。\n闭户辄竟日，孰与讲仁智。\n厌厌生意尽，何暇议李志。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11704,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂言示子聿","author":"陆游","text":"福莫大于不材之木，祸莫惨于自跃之金。\n鹤生于野兮何有于轩，桐爨则已兮岂慕为琴。\n古今共戒玉自献，卷舒要似云无心。\n庐室但取蔽风雨，衣食过足岂所钦。\n我今馀年忽八十，归耕幸得安山林。\n逢人虽叹种种发，入塾尚忆青青衿。\n吾儿殆可守孤学，相与竭力穷幽深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11705,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏四首 其二","author":"陆游","text":"得过一日且一日，安知今吾非故吾。\n袖手明窗读周易，不辜香饭一斋盂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11706,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏十首 其七","author":"陆游","text":"家圃菜肥忘肉食，村场酒美胜官壶。\n终年醉饱无忧责，莫怪愚公老不枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11707,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏四首 其三","author":"陆游","text":"微风翻翻芋叶白，落日漠漠稻花香。\n出门纵辔何所诣，万里桥南追晚凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11708,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏四首 其一","author":"陆游","text":"青羊宫中竹暗天，白马庙畔柏如山。\n琴尊处处可消日，车马纷纷自欠闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11709,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂咏四首 其二","author":"陆游","text":"石犀庙壖江已回，陵谷一变吁可哀。\n即今禾黍连云处，当日帆樯隐映来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂赋十二首 其五","author":"陆游","text":"体不佳时看周易，酒痛饮后读离骚。\n骑驴太华三峰雪，鼓棹钱塘八月涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感五首 其三","author":"陆游","text":"肉食养老人，古虽有是说。\n修身以待终，何至陷饕餮。\n晨烹山蔬美，午漱石泉洁。\n岂役七尺躯，事此肤寸舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感十首 其十","author":"陆游","text":"忍穷待死十年间，老子谁知老更顽。\n溪友留鱼供晚酌，邻僧送米续朝餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感五首 其四","author":"陆游","text":"一气不遽变，雨霁皆有符。\n死非一旦至，小疾为前驱。\n人能谨察之，岂有仓卒虞。\n哀哉不知此，虽悔良难图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感五首 其二","author":"陆游","text":"十月可酿酒，六月可作酱。\n儿曹念乃翁，左右日供养。\n比邻有老疾，亦复致一饷。\n老老以及人，此义古所尚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感四首 其四","author":"陆游","text":"羲皇一画开百圣，学者即今谁造微。\n文词害道第一事，子能去之其庶几。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感六首 其五","author":"陆游","text":"吾闻之古方，有病当鲜食。\n如其不能尔，金丹亦无益。\n我老更事多，此语知造极。\n子房从赤松，千载推达识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感五首 其一","author":"陆游","text":"孔欲居九夷，老亦适流沙。\n忠信之所覃，岂间夷与华。\n况我州闾间，相视等一家。\n老稚各自力，勉蹈思无邪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感六首 其三","author":"陆游","text":"雨霁花无几，愁多酒不支。\n凄凉数声笛，零乱一枰棋。\n蹈海言犹在，移山志未衰。\n何人知壮士，击筑有馀悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感六首 其一","author":"陆游","text":"买马当可乘，筑舍当可居。\n快马多覆败，杰屋鬼所狙。\n徒行与露坐，安稳无后虞。\n所以古达人，秋风忆莼鲈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感六首 其六","author":"陆游","text":"梦育小儿女，便有无穷爱。\n谒医问疾恙，对客誇警迈。\n晨鸡忽唤觉，此爱复安在。\n人生困纠缠，一笑脱囚械。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感五首 其五","author":"陆游","text":"养生孰为本，元气不可亏。\n秋毫失固守，金丹亦奚为。\n所以古达人，一意坚自持。\n魔鬼虽百万，敢犯堂堂师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感六首 其二","author":"陆游","text":"士生诵二典，恍若生唐虞。\n升降奉玉帛，可否闻吁俞。\n阙里得其传，功与造化俱。\n孰知千载后，乃尊重译书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感六首 其三","author":"陆游","text":"拥裘南窗下，坚坐试定力。\n炉香亦不散，伴我到曛黑。\n绝交近为我，游世易颠踣。\n默默何所为，且复自休息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感六首 其三","author":"陆游","text":"艰危宁度瘦驴岭，奔走莫随肥马尘。\n困阨终身元自好，可怜痴子恨无津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感六首 其四","author":"陆游","text":"上峡闻竹枝，入秦闻乌乌。\n奏曲未及终，涕泪凄已濡。\n还山风月夕，菱唱起镜湖。\n虽无远游感，白首亦穷途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感十首以野旷沙岸净天高秋月明为韵 其一","author":"陆游","text":"吕钓渭水滨，说筑傅岩野。\n虽曰古盛时，得士盖亦寡。\n天将启治乱，人才有用舍。\n向非万牛力，孰与成大厦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感十首以野旷沙岸净天高秋月明为韵 其五","author":"陆游","text":"磨镜要使明，拭几要使净。\n奈何视吾心，不若几与镜。\n垢污倘未除，秋毫即为病。\n吾曹亦圣徒，可不学颜孟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感十首以野旷沙岸净天高秋月明为韵 其七","author":"陆游","text":"镜湖一何清，稽山一何高。\n浙江百里远，夜枕闻惊涛。\n子胥死吴下，千载无人豪。\n遗魂招不来，我欲续楚骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感十首以野旷沙岸净天高秋月明为韵 其十","author":"陆游","text":"入东多名山，天台连四明。\n路穷寺门出，林阙溪桥横。\n岂无一月闲，结束与子行。\n会拣最幽处，煨芋听雪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感十首以野旷沙岸净天高秋月明为韵 其四","author":"陆游","text":"斗杓运四序，寒暑忽已换。\n人生知几何，去日难把玩。\n凭高望烟海，青山忽中断。\n秋风肺病苏，为子巾一岸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感十首以野旷沙岸净天高秋月明为韵 其三","author":"陆游","text":"我昔下三峡，百丈堆两车。\n初发公安城，已过长风沙。\n早知世路恶，恨不常浮家。\n至今清夜梦，双橹闻讴哑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感十首以野旷沙岸净天高秋月明为韵 其二","author":"陆游","text":"洙泗日已远，儒术日已丧。\n学者称孔墨，为国杂伯王。\n书生幸有闻，力薄不能倡。\n默默世俗间，汝职无乃旷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感十首以野旷沙岸净天高秋月明为韵 其九","author":"陆游","text":"我昔游剑南，烂醉平羌月。\n一杯玻瓈春，万里望吴越。\n岂知有天幸，故山得归骨。\n扁舟小江上，夜半看月没。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感十首以野旷沙岸净天高秋月明为韵 其六","author":"陆游","text":"天人本一理，祸福常昭然。\n人众何足恃，妄谓能胜天。\n适燕当北辕，调瑟当解弦。\n五行未可忽，洪范禹所传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感十首以野旷沙岸净天高秋月明为韵 其八","author":"陆游","text":"归耕无袯襫，出战无兜鍪。\n已失西畴春，空怀北平秋。\n提携一束书，蹭蹬至白头。\n釜中有轑饭，一饱吾何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感五首以不爱入州府为韵 其四","author":"陆游","text":"洚水初平时，草木充九州。\n禽兽孳育繁，与人为敌雠。\n于时圣人作，日夜为民忧。\n思有以胜之，食肉而服裘。\n然后人奠居，禾黍岁有秋。\n岂知千载后，戕杀无时休。\n一食刀几赤，百味供膳羞。\n豪侈方相誇，哀哉非始谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感五首以不爱入州府为韵 其五","author":"陆游","text":"我年甫三十，出身事明主。\n狂愚斥不用，晚辟征西府。\n蹭蹬过锦城，邂逅客严武。\n十年醉郫筒，阳狂颇自许。\n青城访隐翁，西市买幽圃。\n如何复不遂，归听镜湖雨。\n结庐三间茅，泛宅一枝橹。\n天真傥可全，吾其老烟浦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感五首以不爱入州府为韵 其一","author":"陆游","text":"莘渭二老人，耕钓俱白首。\n功烈在人间，如天有北斗。\n方其未遇时，自处固不苟。\n夫岂邀虚名，欲眩千载后。\n降及秦汉王，望古犹培塿。\n犹能守所闻，外物不得诱。\n君看鲁二生，亦岂圣人偶。\n凛然诸儒间，人可我独不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感五首以不爱入州府为韵 其三","author":"陆游","text":"鸴鸠抢榆枋，枯鱼过河泣。\n鹏鲲九万里，此岂汝所及。\n丈夫志古人，绝世而独立。\n远游马蹄穿，高卧剑锋涩。\n其初所抱负，固自高嶪岌。\n安能与儿曹，俯首就维絷。\n君看折腰趋，孰若举手揖。\n芝老尚可餐，修门戒轻入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂感五首以不爱入州府为韵 其二","author":"陆游","text":"山栖天与癖，酒复甚所爱。\n虽云惭黄绮，亦慕嵇阮辈。\n失脚落人间，二事略皆废。\n晚归卧云壑，谓此在券内。\n如何疾屡作，大与初意背。\n好山虽在眼，动步辄有碍。\n酒戒复坚持，如堤忧蚁溃。\n何以遣馀年，闭户淡煮菜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":11741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]