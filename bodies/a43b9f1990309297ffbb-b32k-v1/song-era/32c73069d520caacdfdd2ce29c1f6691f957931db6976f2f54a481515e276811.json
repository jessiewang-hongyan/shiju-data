[{"title":"太清乐 其八","author":"赵佶","text":"渺渺三津绕帝川，川连红雾雾连天。\n玉灵仙母时游息，侍卫森罗日月軿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7101,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太清乐 其九","author":"赵佶","text":"九灵玉馆接昆崙，山融流刚不可亲。\n嘱付紫兰令说与，红尘何苦弊精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7102,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太清乐 其十","author":"赵佶","text":"左右灵飞运甲庚，琳房八景鍊华精。\n常阳宴罢归何处，掷火流金事尅成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7103,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"步虚词 其一","author":"赵佶","text":"太极分高厚，轻清上属天。\n人能修至道，身乃作真仙。\n行溢三千数，时丁四万年。\n丹台开宝笈，金口为流传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7104,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"步虚词 其二","author":"赵佶","text":"太梵三天主，虚皇五老尊。\n尚难窥徼妙，岂复入名言。\n宝座临金殿，霞冠照玉轩。\n万真朝帝所，飞舄蹑云根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7105,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"步虚词 其三","author":"赵佶","text":"濛濛如细雾，冉冉曳铢衣。\n妙逐祥烟上，轻随綵凤飞。\n几陪瑶室宴，忽指洞天归。\n伫立扶桑岸，高奔日帝辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7106,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"步虚词 其四","author":"赵佶","text":"旋步云纲上，天风飒尔吹。\n飘裾凌斗柄，秉笏揖参箕。\n狮子衔丹绶，骐驎导翠辎。\n飞行周八极，几见发椿枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7107,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"步虚词 其五","author":"赵佶","text":"绿鬓颓云髻，青霞络羽衣。\n晨趋阳德馆，夜造月华扉。\n抟弄周天火，韬潜起陆机。\n玉房留不住，却向九霄飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7108,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"步虚词 其六","author":"赵佶","text":"昔在延恩殿，中宵降九皇。\n六真分左右，黄雾绕轩廊。\n广内尊神御，仙兵护道场。\n孝孙今继志，咫尺对灵光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7109,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"步虚词 其七","author":"赵佶","text":"宝箓修真范，丹诚奏上苍。\n冰渊临兆庶，宵旰致平康。\n万物消疵疠，三辰效吉祥。\n步虚声已彻，更咏洞玄章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7110,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"步虚词 其八","author":"赵佶","text":"宛宛神洲地，巍巍众妙坛。\n鹤袍来羽客，凫舄下仙官。\n玉斝斟玄醴，琅函启大丹。\n至诚何以祝，四海永澄澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7111,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"步虚词 其九","author":"赵佶","text":"水噀魔宫慑，灯开夜府明。\n九天风静默，四极气澄清。\n啸咏朱陵曲，翱翔白玉京。\n至诚何以祝，国祚永安荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7112,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"步虚词 其十","author":"赵佶","text":"华夏吟哦远，人声自抑扬。\n冲虚归道德，曲折合宫商。\n殿阁沉檀散，楼台月露凉。\n至诚何以祝，多稼永丰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7113,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"散花词 其一","author":"赵佶","text":"绛节徘徊引，天花散漫飞。\n高真无染著，片片不沾衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7114,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"散花词 其二","author":"赵佶","text":"八陛旋瑶级，千花飏锦英。\n绿渟并紫奈，焕丽不知名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7115,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"散花词 其三","author":"赵佶","text":"浅浅黄金萼，匀匀白玉英。\n天风随御驾，吹满九重城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7116,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"散花词 其四","author":"赵佶","text":"绰约萦空际，缤纷落座隅。\n韶华长不老，何处觅仙都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7117,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"散花词 其五","author":"赵佶","text":"净侣吟仙曲，人人赞善哉。\n万花兴供养，飞舞自天来。\n宝叶开琪圃，珍柯在紫微。\n不教蝴蝶采，长共綵鸾飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7118,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"散花词 其六","author":"赵佶","text":"圣境三千岁，仙花始一开。\n如何金箓会，并奉列真来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7119,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"散花词 其七","author":"赵佶","text":"几席延飙驭，香灯建宝坛。\n丹心无可献，碎锦洒云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7120,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"散花词 其八","author":"赵佶","text":"碧绿相差次，红黄迭浅深。\n化工应自失，雕斲本何心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7121,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"散花词 其九","author":"赵佶","text":"洞案炉烟起，无为道德香。\n同根无异气，喷鼻更芬芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7122,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白鹤词 其一","author":"赵佶","text":"胎化灵禽唳九天，雪毛丹顶两相鲜。\n世人莫认归华表，来瑞升平亿万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7123,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白鹤词 其二","author":"赵佶","text":"瑶台风静夜初分，仰喙惊鸣露气新。\n太液徘徊归未得，曾于往劫作麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7124,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白鹤词 其三","author":"赵佶","text":"灵鹤翩翩下太清，玉楼金殿晓风轻。\n昂昂不与鸡为侣，时作冲天物外声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7125,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白鹤词 其四","author":"赵佶","text":"三山碧海路非遥，来瑞清都下紫霄。\n霜雪羽毛冰玉性，瑶池深处啄灵苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7126,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白鹤词 其五","author":"赵佶","text":"金火纯精见羽仪，长随王母宴瑶池。\n玉坛夜醮神仙降，飞过缑山人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7127,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白鹤词 其六","author":"赵佶","text":"五云宫殿步虚长，斗转旋霄夜未央。\n白鹤飞来通吉信，清音齐逐返魂香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7128,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白鹤词 其七","author":"赵佶","text":"一声嘹唳九皋禽，换骨轻清岁月深。\n辽海等闲人不识，大罗天上有知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7129,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白鹤词 其八","author":"赵佶","text":"白毛鲜洁映霜华，丹顶分明夺绛纱。\n千六百年神气就，飞鸣长伴玉仙家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7130,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白鹤词 其九","author":"赵佶","text":"蓬莱会散列仙归，羽驾飘然白鹤飞。\n明代为祥人惯见，何须乐府咏金衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7131,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白鹤词 其十","author":"赵佶","text":"玉宇沉沉瑞雾开，香风未断鹤徘徊。\n奇姿会与青田别，定是仙人次第来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7132,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"长吟玉音金阙步虚","author":"赵佶","text":"始青黎元盖，金香结朱烟。\n飞晨总翘辔，稽首玉帝前。\n帝心浩以舒，锡吾太灵篇。\n是谓不灭道，万天秉吾权。\n吾行空洞中，下仙昧其渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7133,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"步虚词二首 其一","author":"赵佶","text":"一气化之元，邈在两仪先。\n宝埒驰金马，真香喷玉莲。\n飞空按龙辔，梵响导芝軿。\n绵永长春劫，翱翔无色天。\n初真难晓谕，以此戒中仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7134,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"步虚词二首 其二","author":"赵佶","text":"高真明道德，垂世五千言。\n解释惭凉薄，殚诚测妙元。\n霓旌严教典，羽唱彻云軿。\n瑞鹤仪空际，祥风拂署烦。\n穹窿兹响应，宝祚亿斯年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7135,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题芙蓉锦鸡图","author":"赵佶","text":"秋劲拒霜盛，峨冠锦羽鸡。\n已知全五德，安逸胜凫鹥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7136,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题祥龙石图","author":"赵佶","text":"彼美蜿蜒势若龙，挺然为瑞独称雄。\n云凝好色来相借，水润清辉更不同。\n常带暝烟疑振鬣，每乘宵雨恐凌空。\n故凭彩笔亲模写，融结功深未易穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7137,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题瑞鹤图","author":"赵佶","text":"清晓觚棱拂彩霓，仙禽告瑞忽来仪。\n飘飘元是三山侣，两两还呈千岁姿。\n似拟碧鸾栖宝阁，岂同赤雁集天池。\n徘徊嘹唳当丹阙，故使憧憧庶俗知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7138,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"诗一首","author":"赵佶","text":"秾芳依翠萼，焕烂一庭中。\n零露沾如醉，残霞照似融。\n丹青难下笔，造化独留功。\n舞蝶迷香径，翩翩逐晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7139,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"打毬诗","author":"赵佶","text":"锦袍骏马晓棚分，一点星驰百骑奔。\n夺得头筹须正过，无令绰拨入邪门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7140,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题双桧","author":"赵佶","text":"拔翠琪树林，双桧植灵囿。\n上稍蟠木枝，下拂龙髯茂。\n撑拿天半分，连卷虹南负。\n为栋复为梁，夹辅我皇构。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7141,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题燕山僧寺壁","author":"赵佶","text":"九叶鸿基一旦休，猖狂不听直臣谋。\n甘心万里为降虏，故国悲凉玉殿秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7142,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泰陵挽词 其一","author":"赵佶","text":"武帐初筹夜，云骈忽帝乡。\n百神陪禹葬，三载服尧丧。\n北极联龙衮，西风拆雁行。\n空馀千古事，缵述愧重光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7143,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泰陵挽词 其二","author":"赵佶","text":"姑射仙期早，华胥梦已陈。\n朝廷系圣母，基业付冲人。\n日转铜壶影，天移玉座春。\n九门笳鼓发，悲动属车尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7144,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泰陵挽词 其三","author":"赵佶","text":"睿哲天攸纵，神机智独谋。\n尘流藏宝阁，锁钥受降楼。\n风急鸰原晚，霜寒雁宿秋。\n遗衣今在寝，犹想未明求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7145,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泰陵挽词 其四","author":"赵佶","text":"再御中天坐，犹思玉色温。\n瑶阶花自落，宝扇影空存。\n重感天伦戚，钦承世及恩。\n欲谐追述志，永绍裕陵尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7146,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泰陵挽词 其五","author":"赵佶","text":"忆开王邸日，曾驻六龙飞。\n玉宇春初永，金盘露未晞。\n荆根方并秀，棣萼更交辉。\n今日承基绪，追怀往事非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7147,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"甘露","author":"赵佶","text":"政成天地不相违，瑞应中台赞万几。\n夜浥垂珠濡绿叶，朝凝润玉弄清辉。\n仙盆云表秋难比，丰草宵零日未晞。\n本自君臣俱会合，更嘉报上美能归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7148,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赐和蔡京","author":"赵佶","text":"道德方今喜迭兴，万邦从化本天成。\n定知金帝来为主，不待春风便发生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7149,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"保和殿下荔枝成实赐王安中","author":"赵佶","text":"保和殿下荔枝丹，文武衣冠被百蛮。\n思与近世同此味，红尘飞鞚过燕山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7150,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宣和殿移植荔枝","author":"赵佶","text":"密移造化出闽山，禁御新栽荔子丹。\n山液乍凝仙掌露，绛苞初绽水精丸。\n酒酣国艳非朱粉，风泛天香转蕙兰。\n何必红尘飞无骑，芬芳数本座中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7151,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"己亥十一月十三日南郊祭天斋宫即事赐太师","author":"赵佶","text":"报本精禋自国南，先期清庙宿斋严。\n层霄初扩同云霁，暖吹俄回海日暹。\n十万军容冰作阵，九街鸳瓦玉为檐。\n肃雍显相同元老，行庆均釐四海沾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7152,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清庙斋幄常有诗赐太师已曾和进禋祀礼成以目击之事依前韵再进今亦用元韵复赐太师非特以此相困盖清时君臣赓载亦一时盛事耳","author":"赵佶","text":"灵鼓黄麾道指南，紫坛苍璧示凝严。\n联翩玉羽层霄下，烜赫神光爱景暹。\n为喜鸾舆回凤阙，故留芝盖出虬檐。\n礼天要作斯民福，解雨今当万物沾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7153,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太师以被赐暹字韵诗前后凡三次进和盖欲示其韵愈严而愈工耳复以前韵又赐太师","author":"赵佶","text":"天位迎阳转斗南，千官山立尽恭严。\n共欣奠玉烟初达，争奉回鸾日已暹。\n归问雪中谁咏絮，冥搜花底自巡檐。\n礼成却喜歌盈尺，端为来麰万宇沾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7154,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"神霄玉清万寿宫庆成卿以使事奉安圣像闻有二诗书屏俯同其韵复赐太师 其一","author":"赵佶","text":"碧落金风爽气回，丛霄乍喜瑞霞开。\n经营欲致黎元福，敢谓诗人咏子来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7155,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"神霄玉清万寿宫庆成卿以使事奉安圣像闻有二诗书屏俯同其韵复赐太师 其二","author":"赵佶","text":"曈曚日驭晓光回，金碧相宜玉府开。\n步武烟霞还旧观，百神应喜左元来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7156,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昨日召卿等自卿私第泛舟经景龙江游撷芳园灵沼闻卿有小诗今俯同其韵赐太师 其一","author":"赵佶","text":"景龙江静喜安流，玉色闲看浴翅鸥。\n已觉西风颇无事，何妨稳泛济川舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7157,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昨日召卿等自卿私第泛舟经景龙江游撷芳园灵沼闻卿有小诗今俯同其韵赐太师 其二","author":"赵佶","text":"登山想见留云际，赏日还能傍水涯。\n对此已多重九兴，先输黄发赏黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7158,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昨日召卿等自卿私第泛舟经景龙江游撷芳园灵沼闻卿有小诗今俯同其韵赐太师 其三","author":"赵佶","text":"锦绣烟霄碧玉山，萦纡静练照晴川。\n留连不惜厌厌去，雅兴难忘既醉篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7159,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上清宝箓宫立冬日讲经之次有羽鹤数千飞翔空际公卿士庶众目仰瞻卿时预荣观作诗纪实来上因俯同其韵赐太师以下","author":"赵佶","text":"上清讲席郁萧台，俄有青田万侣来。\n蔽翳晴空疑雪舞，低徊转影类云开。\n翻翰清唳遥相续，应瑞疑时尚不回。\n归美一章歌盛事，喜今重见谪仙才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7160,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上巳日赐太师","author":"赵佶","text":"金明春色正芳妍，修禊佳辰集众贤。\n久矣愆阳罹暵旱，沛然膏雨润农田。\n乘时剩挟花盈帽，胥乐何辞酒满船。\n所赖燮调功有自，伫期高廪报丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7161,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宣和元年九月十二日赐宴联句","author":"赵佶","text":"桂子三秋七里香，麦云九夏两岐秀。\n鸡舌五年千载枣，菊英九日万龄黄。\n君臣燕衎升平际，属句论文乐未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7162,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宣和己巳冬祀大礼卿以执绥侍玉辂回銮礼毕以诗来上俯同元韵赐伸仍宣示俅杰","author":"赵佶","text":"羽卫森严锦绣成，夜寒璧月有馀清。\n皇坛奠玉横参近，柴燎升烟宿雾晴。\n晏粲九天风露迥，雍容群辟佩环声。\n执绥更喜多仪肃，盛事应传伯仲荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7163,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汧州作 其一","author":"赵佶","text":"国破山河在，人非殿宇空。\n中兴何日是，搔首赋车攻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7164,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汧州作 其二","author":"赵佶","text":"国破山河在，宫庭荆棘春。\n衣冠今左衽，忍作北朝臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7165,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汧州作 其三","author":"赵佶","text":"投袂汧城北，西风又是秋。\n中原心耿耿，南泪思悠悠。\n尝胆思贤佐，颙情忆旧游。\n故宫禾黍遍，行役闵宗周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7166,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汧州作 其四","author":"赵佶","text":"杳杳神京路八千，宗祊隔越几经年。\n衰残病渴那能久，茹苦穷荒敢怨天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7167,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清明日作","author":"赵佶","text":"茸母初生忍禁烟，无家对景倍悽然。\n帝城春色谁为主，遥指乡关涕泪涟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7168,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元符万宁宫庆成颂","author":"赵佶","text":"句曲之山，有居其颠。\n谁氏之子，象帝之先。\n启迪后人，淑修其身。\n守静而笃，是为葆真。\n在昔元符，作室其下。\n经始勿亟，以遗来者。\n我应受之，嗣绍厥绪。\n我仪图之，缮此栋宇。\n考彼宫宇，因心而友。\n不日成之，克相其后。\n乃益其名，曰维万宁。\n书以揭之，用妥明灵。\n道大无方，体用有常。\n以德则帝，以业而王。\n坐进此道，与道无极。\n神之听之，洽此万国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7169,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"葆真观妙冲先生归山以诗送之","author":"赵佶","text":"当年问道属高人，曾揽霞衣到紫宸。\n身是三山云外侣，心无一点世间尘。\n征鸿望极幽栖远，驾燕归飞洞府新。\n多谢为传心法妙，此真真外更无真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7170,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题古村图","author":"赵佶","text":"深村竹树不知春，远水残霞接断津。\n野客衣冠浑懒散，相逢疑是避秦人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7171,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题院画册 修竹士女图","author":"赵佶","text":"瑶台无信托青鸾，一寸芳心思万端。\n莫向东风倚修竹，翠衫经得几多寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":7172,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]