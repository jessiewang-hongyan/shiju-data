[{"title":"吴伯承送苦笋消梅用来韵各赋一篇 其二","author":"张孝祥","text":"脆圆供小摘，不待四月雨。\n新诗同咀嚼，学子心独苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏书赠苏待问","author":"张孝祥","text":"从公觅此纸，欲与苏待问。\n醉中墨鸦黑，北风起云阵。\n明朝酒醒看，为子传心印。\n子若不领略，取火烧作烬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠震山主","author":"张孝祥","text":"震公住山年，与我共壬子。\n瓦砾化金碧，愿力一弹指。\n乡来祖师禅，风定月满天。\n语子义第一，饥餐困当眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春尽日送闻人伯卿次家君韵","author":"张孝祥","text":"早年翰墨场，未见心已亲。\n笔底三峡流，胸次万卷春。\n相从未淹时，欲别故恼人。\n敢赓老仙诗，索去不用频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"洗尘赠张立之判官","author":"张孝祥","text":"立之居糟丘，胸有万斛尘。\n归来卧西窗，泾渭自此分。\n污泥生芙蕖，榛墟有白云。\n莫厌吏事烦，愿子清天君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王龟龄赋喜雨诸贤毕和某客行半月未尝晴也故于末章云 其一","author":"张孝祥","text":"久旱一雨足，高低水平分。\n老农尔何知，史君甚艰勤。\n史君家雁山，出作无心云。\n四海方立槁，须君来救焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王龟龄赋喜雨诸贤毕和某客行半月未尝晴也故于末章云 其二","author":"张孝祥","text":"客行苦淫潦，道路渺不分。\n十步九掀淖，眷言仆夫勤。\n昔旱欲讼风，今雨当诛云。\n我已写绿章，拟向清夜焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"八桂堂池上赏莲纳凉","author":"张孝祥","text":"山月半池白，水风终夜凉。\n蛙声作鼓吹，芰制为衣裳。\n万里俱远客，三人同一觞。\n但使岭海丰，此乐未渠央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"前日出城苗犹立槁今日过兴安境上田水灌输郁然弥望有秋可必乃知贤者之政神速如此辄寄呈交代仲钦秘阁","author":"张孝祥","text":"筒车无停轮，木枧著高格。\n粳稌接新润，草木丐馀泽。\n府公为霖手，号令行顷刻。\n愿持一勺水，敬往寿南伯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南台","author":"张孝祥","text":"我游衡岳巅，路半此歇脚。\n风雷驾飞殿，日月隐杰阁。\n阑干十万里，仰视天一握。\n遂访紫虚君，归时骑白鹤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21517,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书怀","author":"张孝祥","text":"七夕在衡阳，九日在蕲州。\n秋风浩如海，我行尚扁舟。\n破帽不堪落，菊花空满头。\n醉眼忽瞠若，悠然过沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21518,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元宵同张钦夫邵怀英分韵得红旗字 其一","author":"张孝祥","text":"佳月妒纤云，微和扇东风。\n聊持一杯渌，共此千灯红。\n吾宗延阁英，圣学与天通。\n且最治郡课，遂收活国功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21519,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元宵同张钦夫邵怀英分韵得红旗字 其二","author":"张孝祥","text":"邵子坐学官，今日有诏追。\n道山萃竹帛，武库森戈旗。\n文武要两有，腐儒不足为。\n明年燕端门，举酒还相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21520,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠卢司法","author":"张孝祥","text":"逃秦卢博士，读书不读律。\n江陵法曹掾，移病满百日。\n燕坐供佛香，青灯照绳床。\n肺热今无恙，门前春草长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21521,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"进芝草 其一","author":"张孝祥","text":"庙锡珍符岂偶然，灵华再见只经年。\n祥开二室昭贻燕，根托同楹自属联。\n上瑞应诚虽绍至，宸衷思孝益增虔。\n微臣愿考皇天意，不献终童效异篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21522,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"进芝草 其二","author":"张孝祥","text":"煌煌瑞彩映金铺，元气回旋即此都。\n太史连年书盛事，近臣更日奏新图。\n璇宫荐祉宁虚应，玉叶流芳已兆符。\n早晚清尘款原庙，临观敢请驻前驱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21523,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"某顷蒙信阳使君教以边字韵佳句伏读降叹病倦答谢甚缓复不能奇仰俟斲削 其一","author":"张孝祥","text":"风流追数建安年，谁遣朱轓并塞边。\n举国向来儒服少，是邦端有大夫贤。\n须公帷幄收长策，著我江湖刺钓船。\n池阁追凉肯临否，红妆翠盖拥三千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21524,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"某顷蒙信阳使君教以边字韵佳句伏读降叹病倦答谢甚缓复不能奇仰俟斲削 其二","author":"张孝祥","text":"百适归来又一年，投身烽火戍楼边。\n私忧自笑愚无策，制胜悬知国有贤。\n北去燕然堪勒石，西来樊口看烧船。\n中州更有王夫子，笔阵犹能独扫千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21525,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子云压境先遣诗次韵","author":"张孝祥","text":"相风日日问长年，鹢首遥知近个边。\n别后情亲难过我，故家人物更谁贤。\n一尊且对荒城酒，六月休牵上水船。\n小此淹留待追诏，公车归奏牍三千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21526,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘伯同侍开府公入觐","author":"张孝祥","text":"相公早勒太常铭，康乐当家更典刑。\n枪急曾看飞鸟过，笔精时作换鹅经。\n极知许国心常赤，趁取封侯鬓尚青。\n若到都城见知旧，为言江汉有浮萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21527,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送子云倅荆州 其一","author":"张孝祥","text":"阅世波流险未涯，爱君悃愊静无华。\n高门自惜联三戟，飞佩何当乞九霞。\n乔木世臣馀故国，采蘋齐女甚宜家。\n君王早晚思前席，会有徵书访贾嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21528,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送子云倅荆州 其二","author":"张孝祥","text":"荆吴相望各天涯，惜别尊前菊未华。\n便放扁舟冲骇浪，要看秋日冠轻霞。\n新诗满路分吾子，盛业康时是故家。\n好去依刘静边琐，策勋行即赐褒嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21529,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖上晚归遇雨","author":"张孝祥","text":"阴云霭霭草萋萋，晚过东湖雨湿衣。\n细柳含烟凝翠色，浮鸥戏水弄晴晖。\n轻舟系缆斜依岸，钓子收纶欲下矶。\n湖上人家未扃户，儿童蓑笠负薪归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21530,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨入庐山","author":"张孝祥","text":"梦想羌庐一段奇，经行那得雨追随。\n晴来见说山逾好，胜处如今我自知。\n虚室真人珠咳唾，卐庵老子白须眉。\n并游三士风流甚，袖手傍观定有诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21531,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和","author":"张孝祥","text":"借雨寻山故自奇，幕中佳客肯相随。\n清游端拜史君赐，此乐讵容儿辈知。\n暗谷水来鸣杂佩，远峰烟断出脩眉。\n庾楼百尺江千里，遥忆凭高政索诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21532,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郡侯遣骑至山中馈名酝辄呈长句用黄宰韵","author":"张孝祥","text":"山南山北雨生寒，竹树风烟苍莽间。\n青壁倚天元未见，白衣送酒故相关。\n共追莲社公应许，稳上篮舆我欲还。\n后日重来拚一月，细扶藜杖觅孱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21533,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"去年正月三日雪霁入昭亭访应庵如庵二老今年在临川追怀昔游用寄卐庵韵","author":"张孝祥","text":"蹇驴冲雪度松林，齧石溪流有令音。\n旋摘白云濡燥吻，更参黄檗印初心。\n岚开复岭云千叠，冻合浮图玉数寻。\n一梦经年归去好，宦情全薄此情深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21534,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卐庵自东林欲还蜀某以报恩招之大人赋诗劝请再次韵","author":"张孝祥","text":"忆携拄杖过东林，掣电奔雷听法音。\n青壁倚天元满眼，白云出岫本无心。\n峨眉江崄公无度，法眼泉清我欲寻。\n手种庭前柏树子，孤根应比乡来深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21535,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用韵简天童应庵","author":"张孝祥","text":"敬亭松竹古丛林，二老风流旧赏音。\n楼阁长开太平象，钟鱼能洗祖师心。\n别来黄鹄还千里，盟在白鸥当再寻。\n却忆西堂大言客，只今高坐海云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21536,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉陪宣守任史君谒昭亭神祠 其一","author":"张孝祥","text":"缓驱千骑出朝京，唤得春回眼界青。\n旗脚灵风来庙步，马蹄山雪过昭亭。\n极知太守怀忠款，端为君王荐德馨。\n惭愧去年冬十月，军书彻夜听鸣铃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21537,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉陪宣守任史君谒昭亭神祠 其二","author":"张孝祥","text":"丰年已卜稻如京，雪尽春从草际青。\n竹里红旗行点点，松间白塔见亭亭。\n暖回宿麦开寒色，风约疏梅度晚馨。\n却忆宣城李太白，也将诗句掣斋铃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21538,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"任守作醮为民祈福先期而雪是日开霁","author":"张孝祥","text":"紫府仙人自列真，绿章封事更通神。\n清尘已作连宵雪，不夜潜回万屋春。\n玉节朱幡来浩荡，云车风马正纷纶。\n步虚声彻朝元路，便挈荷囊款帝闉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21539,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"应庵退席蒋山来寄昭亭万寿三请不得已而去辄赠长句兼简苏州内翰尚书 其一","author":"张孝祥","text":"逍遥丘壑欲忘年，忽作风蝉蜕骨仙。\n钟阜恰从三昧起，灵岩重要一灯传。\n极知扫迹终无策，且与临岐快著鞭。\n莫作山林城市想，从来大隐故居廛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21540,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"应庵退席蒋山来寄昭亭万寿三请不得已而去辄赠长句兼简苏州内翰尚书 其二","author":"张孝祥","text":"不寄音书又隔年，因师问讯玉堂仙。\n碧油早觉儒为贵，青海应无箭可传。\n忆昔丝纶催唤仗，何时沙路听鸣鞭。\n生涯落寞公知否，准拟松江受一廛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21541,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"辛巳冬闻德音 其一","author":"张孝祥","text":"帐殿称觞送喜频，德音借与万方春。\n指挥夷夏无遗策，开阖乾坤有至神。\n南斗夜缠龙虎气，北风朝荡犬羊尘。\n明年玉烛王正月，拟上梁园奉贡珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21542,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"辛巳冬闻德音 其二","author":"张孝祥","text":"鞑靼奚家款附多，王师直到白沟河。\n守江诸将遥分阃，绝漠残胡竞倒戈。\n翠跸春行天动色，牙樯宵济海无波。\n小儒不得参戎事，赋赋新诗续雅歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21543,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和曾裘父韵送老人赴镇九江","author":"张孝祥","text":"边箭收声江不波，庐山高处与天摩。\n向来只作青鞋计，此去无如紫诏何。\n尘满庾楼烦剪拂，经馀莲社更摩挲。\n文成本自筹帷幄，不数黥彭战伐多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21544,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上丁斋宿","author":"张孝祥","text":"青衿陪祀忆初年，老矣斋居重慨然。\n俎豆不知鹅鹳事，牲牢空荐犬羊膻。\n北来被发车连野，东去乘槎浪接天。\n汲汲两宫常旰食，受膰归去泪如川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21545,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和总得居士康乐亭韵","author":"张孝祥","text":"尚忆池塘梦阿连，当时此意惜无传。\n薪车不障洪河决，乔木终随故国颠。\n柳下煅工真得道，竹林酒友谩称贤。\n先生义慨云天薄，千载参渠活句禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21546,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄张真父舍人 其一","author":"张孝祥","text":"玉佩琼琚出近班，仙槎从此到人间。\n聊须海内无双士，往镇坤维百二关。\n御府应留霜简看，乡人休羡锦衣还。\n呜呼国步艰危日，补衮悬知欠仲山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21547,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄张真父舍人 其二","author":"张孝祥","text":"投分平生不数人，忆陪文馆笑谈新。\n资中宰树看成拱，荆府诗筒迹又陈。\n已恨别离空岁月，那知解后亦参辰。\n古来命驾须千里，薄宦区区愧此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21548,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋观月齐云楼用孙昌符韵","author":"张孝祥","text":"玉宇无尘夜气清，银河彻底素波明。\n人应好月同千里，身在高楼近五城。\n丹桂定知怜我老，绿尊何惜为君倾。\n建章鳷鹊当年梦，便欲凭空上玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21549,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题鲁如晦通隐","author":"张孝祥","text":"先生早结社中莲，覆锦凭熊亦偶然。\n不向江湖忘魏阙，故应山泽有儒仙。\n十洲便著登瀛士，三径难留避世贤。\n我亦经营一丘壑，问公先乞小壶天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21550,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同胡邦衡夜直","author":"张孝祥","text":"慕用高名二十年，敢期丹地接周旋。\n先生义与云天薄，老去心如铁石坚。\n梦了琼崖身益壮，烟销金坞臭空传。\n一尊莫惜空相属，宫漏穿花夜色鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21551,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"将如会稽寄曾吉甫","author":"张孝祥","text":"起居一代文章老，阙寄音书恰二年。\n诗债未还缘懒拙，官游如此竟危颠。\n会稽旧有探书穴，贺监应寻载酒船。\n我欲从公留十日，问公乞句手亲编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21552,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过昭亭哭二弟墓","author":"张孝祥","text":"陌上春风久矣归，墓头衰草正迷离。\n白头未抆三年泪，黄壤长埋短世悲。\n忆昔追游常并辔，只今独往更题诗。\n两儿二弟俱冥漠，顾影伶俜欲语谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21553,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠邕州滕史君","author":"张孝祥","text":"千骑东方白玉镳，十眉环坐紫檀槽。\n安南都护来鳌禁，建武将军握豹韬。\n瘴雨蛮烟惊鼓角，朔云边雪满旌旄。\n夕烽不到甘泉殿，尺一徵还近赭袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21554,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"齐山","author":"张孝祥","text":"江山平远三千里，水石嵌空二百岩。\n地辟天开成洞府，峰回路转有精蓝。\n九华却立才堪倚，万井横陈我所监。\n欲赋齐山无杰句，梦中危壁尚巉巉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21555,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜读五公楚东酬唱辄书其后呈龟龄","author":"张孝祥","text":"同是清都紫府仙，帝教弹压楚山川。\n星躔错落珠连纬，岳镇岧峣柱倚天。\n宫羽在县金奏合，骅骝参队宝花鲜。\n平生我亦诗成癖，却悔来迟不与编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21556,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"荐福观何卿壁间诗对之怅然次前韵","author":"张孝祥","text":"金华老子定臞仙，翰墨文章遍两川。\n遗迹已惊风落木，高名依旧日行天。\n人间易得朱颜老，寺壁空悬玉唾鲜。\n欲继三贤歌薤露，严诗杜集傥同编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21557,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用韵作五公诗","author":"张孝祥","text":"公如韩子定飞仙，更喜门人老玉川。\n莫说诗筒频度岭，即看侯弁去朝天。\n飞龙位正云霄近，集凤楼高采色鲜。\n我欲扁舟君记否，但教归去杂民编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21558,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蒙侍御丈再用韵作送行诗走笔和答迫放船不暇工也","author":"张孝祥","text":"忆曾总领道山仙，自挽狂澜制百川。\n廷策万言功盖世，台评三上力回天。\n楚东剩喜诗邮速，天北催颁诏墨鲜。\n老我江湖堪野史，看公勋业手亲编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21559,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龟龄携具同景卢嘉叟饯别于荐福即席再用韵赋四客诗","author":"张孝祥","text":"使君领客访金仙，小队旌旗锦一川。\n我欲采芝非辟世，公当立极要擎天。\n诗声政尔容传稿，僧律何尝禁割鲜。\n一笑番阳逢岁熟，问公钟磬几时编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21560,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登清音堂其下琵琶洲也再用韵","author":"张孝祥","text":"夜横霜竹梦游仙，晓到馀干月满川。\n山绕楼台欲无地，水环洲渚更连天。\n明霞一抹朱弦直，芳草分垂绿绶鲜。\n却忆洞庭张乐地，石钟浮磬定同编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21561,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"馀干赵公頙贤宗室也魏公题其堂曰养正且为作铭取易颐之义刻碑堂上予过之为赋诗","author":"张孝祥","text":"眼里纷纷不要同，从教三径满蒿蓬。\n肯来与子谈周易，此去何人识魏公。\n家近星辰双阙北，身居烟浪五湖东。\n清台有日占云气，一丈丰碑夜贯虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21562,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鸡笼福地在历阳将至丰城望一山宛然感之赋诗","author":"张孝祥","text":"黄茅白苇径才通，忽见晴岚扫翠空。\n从吏只令俱蜑户，仙山何许是鸡笼。\n逢人渐觉交游少，问路仍行盗贼中。\n自是粗才合粗使，瘴乡那得便途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21563,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"午憩道傍人家","author":"张孝祥","text":"一崦人家竹树凉，午阴深处著胡床。\n石泉政似煮茗沸，稻花已作炊粳香。\n梦到家园归自好，起寻官路去何长。\n尘埃满面迎西日，底处青山是故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21564,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入清江界地名九段田沃壤百里黄云际天他处未有也","author":"张孝祥","text":"野水瀰漫欲涨川，稻云烘日更连天。\n定无适粤千金橐，可买临江九段田。\n黄犊眠边高树荫，白鸡啼处远炊烟。\n此中若许投簪绂，便老锄耰卜数椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21565,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题吴城庙","author":"张孝祥","text":"乞得东归一信风，敬持牲酒扣灵宫。\n千寻石甃苍藤合，百岁神仓赤眚空。\n浥浥午阴移岸树，萧萧凉意满船篷。\n杖藜更作僧坊去，借壁题诗却未工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21566,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"呈枢密刘恭父","author":"张孝祥","text":"鼎席方虚望已隆，上游那得更烦公。\n敢言两镇成交契，自是孤根累化工。\n旧弼新开元帅府，闲官且领太平宫。\n归家净洗如椽笔，准拟燕然勒骏功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21567,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子功补之远送海错甚珍","author":"张孝祥","text":"白彘乌羊见未曾，青蛇赤蚁当常珍。\n忽惊海物来登坐，能致南烹有故人。\n万里漂流怜逐食，百年粗粝愧尝新。\n新篘恰趁来时熟，细酌梅花雪片春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21568,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张仲钦朝阳亭","author":"张孝祥","text":"便合朝阳作凤鸣，江亭聊此驻脩程。\n南瞻御路临双阙，东望仙家接五城。\n日上白门兵气静，春归淮浦暗潮平。\n遥怜莫府文书省，时下沧浪自濯缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21569,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵 其一","author":"张孝祥","text":"空岩相望一牛鸣，不要邮签报水程。\n天接海光通外徼，地连江势挟重城。\n丝纶叠至龙恩重，绣斧前驱蜑雾平。\n凤阁鸾台有虚位，请君从此振朝缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21570,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]