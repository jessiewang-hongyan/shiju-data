[{"title":"柬陈寺丞筑城","author":"刘克庄","text":"事变相寻智亦新，烂泥堆起石嶙峋。\n断无馀力谋蒸土，颇有傍观哂寘薪。\n自古虚心容议者，即今枵腹役耕民。\n姑尤聊摄皆齐境，莫遣郊封有诅人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柬惠安同安叶陈二明府并烦安溪林明府寄似","author":"刘克庄","text":"吾友二三子，联翩有国都。\n平平虽县谱，急急奈州符。\n亦既吹齑矣，还能吸醋无。\n高年颇更事，莫哂瞽言迂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泉牧帖请囊山福上人住持承天既至有沮之者兴尽而返戏赠小诗","author":"刘克庄","text":"揖退新龙象，归寻旧鹤猿。\n空令行百里，不遣骂三门。\n易致实封者，难招不动尊。\n辟支放光处，尚有石龛存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洪秘监徐常丞有诗贺余休致次韵四首 其一","author":"刘克庄","text":"还笏何须待拖绅，世间无价是元身。\n为梁父咏常存汉，累太玄经坐美新。\n朝露饶他夸夺子，晓星有几典刑人。\n由来老干禁霜雪，不问东皇探借春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洪秘监徐常丞有诗贺余休致次韵四首 其四","author":"刘克庄","text":"好语嘘枯极主臣，未应公干胜徐陈。\n争三十里敢言智，有百万钱难买邻。\n残烛苛留终断简，瘦筇扶出拜新纶。\n德星若肯过田舍，只脍溪鲜代脯麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洪秘监徐常丞有诗贺余休致次韵四首 其三","author":"刘克庄","text":"既衰戒得久书绅，所得毫毛所失身。\n疏传画图传不朽，胡公粪土谤如新。\n古询黄发非无意，今系苍生尚有人。\n吾老而休君未可，时来遍与物为春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洪秘监徐常丞有诗贺余休致次韵四首 其二","author":"刘克庄","text":"玉座分明念老臣，孤忠何路更前陈。\n无枯树赋如开府，有病梨篇似照邻。\n粥钵不愁餐哽噎，蔬盘何用脍纷纶。\n尽教巷静门罗爵，绝胜山空冢卧麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"疥癣二首 其二","author":"刘克庄","text":"试脱中单肌起粟，俄生点隐状如沙。\n绝怜病叟鸡皮皱，难借灵妃鸟爪爬。\n昔号玉人曾美晰，今成铁汉已顽麻。\n戏衫脱了无羁束，纵见三公手懒叉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"疥癣二首 其一","author":"刘克庄","text":"发肤勿毁斯为孝，疥癣虽微至不仁。\n血气衰无丹换骨，亲朋疏恐癞传人。\n裸裎懒对炎凉客，汤熨犹贪闪电身。\n臭腐神奇同尽耳，全归即可见先亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸丑记颜","author":"刘克庄","text":"放逐归来寂寞滨，颠毛雪色面皮皴。\n怪奇昔有观邕者，老丑今无看玠人。\n一枕唤回将觉梦，三薰惜取已来身。\n绣裳蝉冕丛忧愧，得似先生折角巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸卯上元即席次杨使君韵二首 其二","author":"刘克庄","text":"纵观姑游目，殷忧欲碎心。\n马嘶淮祲恶，鹃叫蜀冤深。\n玉座方停箸，椒涂亦脱簪。\n好为谏臣论，莫作醉翁吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸卯上元即席次杨使君韵二首 其一","author":"刘克庄","text":"初阳收久雨，淳祐第三春。\n聊与众行乐，稍欣农食新。\n俱蒙青帝力，莫问紫姑神。\n座上遨头作，流传遍郡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"皇女周汉国端孝公主挽诗二首 其二","author":"刘克庄","text":"甥馆恩通内，妃茔诏卜邻。\n来应自仙佛，去尚恋君亲。\n望送龙绡湿，封崇鹤表新。\n不能秉彤管，羞愧作词臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"皇女周汉国端孝公主挽诗二首 其一","author":"刘克庄","text":"孝谨亲颜悦，端严妇德修。\n鹊桥犹纪节，鸾扇忽惊秋。\n鲁笔王姬卒，湘弦帝子愁。\n愿言宽圣抱，已返蕊宫游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜有怀傅至叔太博父子","author":"刘克庄","text":"忆昔游君父子间，高才穷力莫追攀。\n读书众壑归沧海，下笔微云起太山。\n幼嗣尚存宗武在，遗文难附所忠还。\n荒丘衰草埋双璧，兀坐空斋涕自潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋思一首","author":"刘克庄","text":"不觉朱明变素商，萤穿户牖燕辞梁。\n牢愁五鼓尤难睡，薄冷单衣未易当。\n谁伴子綦同隐几，亦无法喜共禅房。\n残骸到了犹贪爱，仙圣前头自炷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋热忆旧游二首 其二","author":"刘克庄","text":"塞上秋光冷似冰，当年豪举气凭陵。\n打毬不用炎方马，按猎初调异国鹰。\n山寨凄凉闻戍鼓，水村摇落见渔灯。\n而今病暍茅檐底，追记犹堪洗郁蒸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋热忆旧游二首 其一","author":"刘克庄","text":"忆昔浮江更涉淮，早秋天气最佳哉。\n塞垣榆落蝉初少，泽国芦疏雁已来。\n风露入怀诗笔健，关山满目笛声哀。\n南州九月犹絺绤，纵有清樽底处开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋暑","author":"刘克庄","text":"□□七月热，如焚复似烹。\n炼成女娲石，烈甚祖龙坑。\n月窟难梯上，天河莫挽倾。\n黄昏一阵雨，高枕听韶声。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胜业寺","author":"刘克庄","text":"寺创于何代，问僧皆不知。\n槎牙夏后柏，残缺柳侯碑。\n雪过禅堂冷，冰馀岳路危。\n上封犹未到，太息负心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荔厄一首","author":"刘克庄","text":"怒潦浮槎去，狂飙拔木飞。\n不饶后村荔，如夺首阳薇。\n任土包茅阙，过时硕果稀。\n谁言长卿渴，且咽上池肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"览西斋弟子抄诸家诗一首","author":"刘克庄","text":"小窗几载共吟披，重见残编拊事悲。\n早日才高鹦鹉赋，暮年泪尽鹡鸰诗。\n神交梦尚通康乐，手泽书堪付阿宜。\n若是孔怀因未断，安知来世不吹篪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"览镜","author":"刘克庄","text":"览镜无方染白髭，垂车有疏叩丹墀。\n故将军老班师后，村校书贫散学时。\n百岁电光俄变灭，一场春梦莫寻思。\n篱边尚有开残菊，乱插乌巾策杖嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺王实之得第二子","author":"刘克庄","text":"臞翁活计未全迂，老骥新生汗血驹。\n攀桂肯输郎罢否，分梨还让阿兄无。\n应陈俎豆为嬉戏，想见诗书被抹涂。\n报与厨人多酿酒，王家例合有三珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺岁","author":"刘克庄","text":"遍行海角与天涯，烟阁云台不似家。\n无肉并无子猷竹，失侯不失邵平瓜。\n难藏白发惟菱照，晚悟朱荣若槿花。\n惭愧孙曾来贺岁，劝翁椒酒各斟些。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺秘书弟提举崇禧","author":"刘克庄","text":"句曲除书至，山灵亦喜闻。\n皆云新管辖，还是小茅君。\n无粟可舂惠，有薇堪采分。\n已盟猿鹤了，不怕客移文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺警斋吴侍郎被召","author":"刘克庄","text":"旧人仅有鲁灵光，银信翩翩下帝傍。\n龙去十年闲卧洛，凤来一日再鸣阳。\n玺书下访刍言急，月食回思榄味长。\n善类合离关世道，祈公趣驾勿循墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵礼部和余梅花十绝送林录参微而婉哀而不怨杂之万如诗中殆不可辨老拙不敢当也别课一诗以谢","author":"刘克庄","text":"更无一点涴铅华，状出冰枝糁玉葩。\n十绝顿令侬北面，万如元住子东家。\n自羞贫女钗边朵，难傍宫人额上花。\n纵使朔风如铁劲，未妨雪月照槎牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和南塘韵呈汤伯纪尹子潜","author":"刘克庄","text":"诔南浦了诔馀杭，各掩新丘若斧堂。\n不见天球在东序，竞吹宫笛奏西凉。\n后生谁附青云传，故吏惟馀白首郎。\n浩叹缥缥双凤远，老身如雁漫随阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送丁元晖知南海","author":"刘克庄","text":"不用急符催，先行要看梅。\n岁时亲祭海，休沐必登台。\n鲍井聊供饮，韩碑待拭苔。\n遥知蛮俗喜，令尹带琴来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送人西上 其一","author":"刘克庄","text":"华胄惟莆冠七闽，陈岩所产必闻人。\n穆陵凤阁曾分席，朝道麟台有后身。\n上览四书方唱叹，子行三策好条陈。\n明时独擅将雏曲，未数燕山桂与椿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送人西上 其二","author":"刘克庄","text":"贺白词□□□□，□□□□□□先。\n飞腾海鹘并天马，隔结□□□□□。\n□□□□□点首，剑神紫气夜冲天。\n□□□□□□□，□□□□一券传。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送人赴庐陵尉","author":"刘克庄","text":"闻说江西路，而今不宿师。\n省民来著业，少府去吟诗。\n夜月营门鼓，春风射圃旗。\n虽然溪峒事，闲暇要先知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送三赵","author":"刘克庄","text":"闻说金鸡下帝傍，径从楚泽返虞庠。\n当时只道刍言切，今日徐思榄味长。\n中垒几封知有汉，奉天一诏可存唐。\n却怜依附冰山者，不信云开见太阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送大渊宰安溪七言三首 其三","author":"刘克庄","text":"吾观明府毫端妙，传得尊公肘后方。\n番俗尚歌汉东柳，莆人不剪召南棠。\n威驱未若心怀惠，内荏徒然外抑强。\n想见江乡与闽峤，家家各炷一炉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送大渊宰安溪七言三首 其二","author":"刘克庄","text":"昏昏默默嗟衰朽，白白红红忆盛强。\n自古人惟称单父，至今我尚爱桐乡。\n刈时留取葵根在，拔处无令薤本伤。\n邑有澹台辈流否，不妨迎致向琴堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送大渊宰安溪七言三首 其一","author":"刘克庄","text":"御阶人看放班回，谁记乾淳旧事哉。\n进卷已尝观所主，闻弦上欲老其才。\n割鸡必待民谣著，峨豸多由县谱来。\n莫道胜流俱不屑，艾轩做了到诚斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送子敬赴潮倅七言二首 其二","author":"刘克庄","text":"历监三郡无殊渥，饱阅千帆奈逆风。\n晋尚高谈重方外，汉称半刺曰治中。\n不惟守听廉丞语，所至民歌别驾功。\n他日潮人感遗爱，祠槎溪老又祠公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送子敬赴潮倅七言二首 其一","author":"刘克庄","text":"四十年前忝此除，偶因诗祸免题舆。\n故交反眼炎凉异，岁月惊心露电如。\n衔内条冰疑有欠，镜中须雪摘无馀。\n南州剩有随阳雁，若比江湖易寄书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送山甫赴岭口仓与黄兄来复同载","author":"刘克庄","text":"德远先生学者师，此郎超诣可传衣。\n凌云才子声名早，煮海粗官气力微。\n二尺檠商今与古，三家村有是和非。\n直须满了葵丘戍，策杖溪边待璧归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送山甫铨试二首并寄强甫 其二","author":"刘克庄","text":"家事如今亦尽传，此冠未挂待何年。\n忍抛老汉□□畔，去傍渠侬水镜边。\n逆旅我能几时客，自家□□□人怜。\n归鸿数寄平安字，莫遣衰翁望眼穿。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送山甫铨试二首并寄强甫 其一","author":"刘克庄","text":"二昆南北各驱驰，季复随群试有司。\n蕃衍皆因先世积，荒嬉端为乃翁慈。\n争名古有笞儿语，任运吾无责子诗。\n万一原夫能末缀，采蒲裹粽待归期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送广东宪","author":"刘克庄","text":"疏屡循墙诏屡催，绣衣安得更徘徊。\n直从象窟埋轮去，曾向龙墀折槛来。\n度岭尊尧心未已，登台叫舜首频回。\n遥知行橐无南物，驿使归时且寄梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送五六弟赴四明仓官","author":"刘克庄","text":"子去为仓氏，人应重客卿。\n须怜舂簸苦，勿爱釜钟赢。\n羊贵脾神厄，蔘佳肺气平。\n亲闱最关念，频寄雁传声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方子约赴衢教","author":"刘克庄","text":"博士非如吏，巍然道自居。\n诸生趋避席，太守揖升车。\n朱笔浓批卷，青灯细勘书。\n汉廷重文藻，行矣召严徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方文甫判官","author":"刘克庄","text":"檄笔骚情俱妙绝，它人才少子才多。\n分桐江派从初祖，在孔门中占二科。\n此去潘舆添燕喜，向来韩木尚婆娑。\n传闻仲举高悬榻，应待元寮入礼罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方汝楫客授严陵","author":"刘克庄","text":"昔年尚友先君子，晚见贤郎自策名。\n芹泮佩衿尊郑老，桐江谱牒派玄英。\n誉髦孰不观朝彩，耄齿吾难主夏盟。\n若见监州烦问讯，必分风月照寒檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方至","author":"刘克庄","text":"老去怜才癖转深，爱君笔力擅词林。\n抟扶摇上二虫笑，从渥洼来万马瘖。\n书号醇儒渐者远，弘称曲学到于今。\n汉家旃厦崇经术，莫事推敲枉费心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方君节监丞","author":"刘克庄","text":"世论喧啾众窍鸣，先贤于此极持平。\n坡称淳父文经世，沂惜希文谏近名。\n向去史书将有考，由来公议最无情。\n我衰君壮飞潜判，何日重寻洛社盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方时父","author":"刘克庄","text":"向来羞作绕枝飞，刘表区区不足依。\n索饭儿嗔郎罢出，画眉人约藁砧归。\n食鱼底处容长铗，射虎今方尚短衣。\n老缚一官行未得，羡君去采故山薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方辰孙赴崇安尉","author":"刘克庄","text":"遁翁精舍久荒凉，君去应先炷瓣香。\n畴昔二难贤可并，即今一个弱堪伤。\n时平多有农耕野，官好浑无卒下乡。\n莫作寻常黄绶看，子真向亦尉南昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方郎唐卿漕试","author":"刘克庄","text":"翁已鞭鸾上九霄，此郎虽小亦清标。\n斯文尚有嫡传在，每见能令人意消。\n身退吾难论一鹗，才高君必中双雕。\n汉廷急士将亲策，想见诸儒避董晁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方阜高赴衡州法掾","author":"刘克庄","text":"仕不论高下，丝毫要及民。\n君其守三尺，古有活千人。\n岳树侵云杪，江蓠满水滨。\n楚芳饥可荐，切莫叹清贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方添倅","author":"刘克庄","text":"忠惠横经地，今将五十秋。\n诸生迎谒庙，吾子往监州。\n吏散斋堂静，朋来郑校修。\n勿嫌员外置，风月满鸿沟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方清孙参学","author":"刘克庄","text":"仆负轻装主倚辕，交游握手若为言。\n须求沂水风雩乐，勿爱沙河夜市繁。\n曩日士曾宗郭太，它时我欲传何蕃。\n殷勤待折津亭柳，老怕春寒不出村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方善夫赴鹭洲山长二首 其二","author":"刘克庄","text":"柴门病后少曾开，今日人扶出郭来。\n君奉潘舆贫亦乐，我贪汉橐老犹呆。\n明师不患无高弟，大匠何尝有弃材。\n若见蓬仙烦问讯，掉头一去几时回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方善夫赴鹭洲山长二首 其一","author":"刘克庄","text":"奎画煌煌天上来，遥知系马向堂阶。\n官衔怪得清如许，文馆虽然冷亦佳。\n尚论乡先宜合祀，旧传潮学各分斋。\n未应久作诸侯客，帝有薰琴待汝谐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方寔孙","author":"刘克庄","text":"丹诏求贤切，西行不可徐。\n便乘天厩马，莫跨霸桥驴。\n太白清平调，相如谏猎书。\n定将新述作，一一寄田庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方楷","author":"刘克庄","text":"才子囊书入帝京，鴳飞安敢料鹏程。\n赴南宫缓功夫久，携北碑多嗜好清。\n玉镜台边无别泪，金花笺上有芳名。\n可怜病叟如蜗缩，呵冻题诗当饯行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方楷之官","author":"刘克庄","text":"博雅今萧翼，招延小孟尝。\n虽操牙算子，不废□□□。\n秘箧珍储富，公车荐墨香。\n惟应猿鹤怨，三载□□房。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方蒙中赴辟二首 其二","author":"刘克庄","text":"圣君羔雁远相求，去去榆关迫盛秋。\n应念霜寒履中野，定分月色照鄜州。\n画江谋拙难言智，出塞诗豪不惹愁。\n却笑缚轮观井者，一生过计更私忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方蒙中赴辟二首 其一","author":"刘克庄","text":"谁云逢掖不知兵，一士居然系重轻。\n往昔下愚融铁锁，即今上圣倚金城。\n可怜蒋子开三径，又被乌公夺二生。\n旋作凯歌驰露布，残年犹拟看升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方蒙仲赴省","author":"刘克庄","text":"童年觜距已专场，何况而今益老苍。\n天网恢然罩鸾鹄，朝阳鸣矣革蜩螗。\n士谁与贺争同进，众亦推弘诣太常。\n可惜祠官无气力，不能搢笏诵阿房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送方漳浦","author":"刘克庄","text":"颇闻送者诗盈轴，我有樵歌子试听。\n岩邑虽然人所畏，畬民均是物之灵。\n二升饭了官中事，一字廉真座右铭。\n见说守侯如召杜，断无走吏至公庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":31805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]