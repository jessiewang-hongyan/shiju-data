[{"title":"山行晚归","author":"释善珍","text":"药径入云林，晚晴扶杖吟。\n照泥星复雨，经朔月犹阴。\n树折怜巢覆，泉清见叶沈。\n爱闲自如此，不是学灰心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"门径","author":"释善珍","text":"门径莓苔古意深，闭门懒复事参寻。\n棋图静见孙吴法，樵唱真闻韶濩音。\n米尽有方烹白石，丹灵无意化黄金。\n花飞又是春将莫，小复风前拥鼻吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代赵景贤和林定庵韵","author":"释善珍","text":"闲携竹杖过横塘，碧藕无花叶更香。\n斋后随僧同洗钵，醉中得句旋投囊。\n鱼沈似厌池光静，禽语如欣树影凉。\n更欲招邀鸥鹭伴，菰蒲深处共平章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙泉山中","author":"释善珍","text":"自垦屋头三四畦，得閒时复事锄犁。\n花粘蛛网碍蜂度，树带鹰巢无雀栖。\n啸罢半山闻逸响，诗成绝壁见新题。\n老来定力人难转，菜叶放教流出溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次陈上舍韵","author":"释善珍","text":"壮不封侯老背时，云山得意合忘归。\n思鱼不肯歌长铗，射虎犹堪著短衣。\n椽笔枉将修野史，阵图少试解棋围。\n元龙心事应如许，何日相逢语入微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次徐监簿韵贺吴侍郎新第落成 其二","author":"释善珍","text":"词源本本自欧苏，胸次湖江跨楚吴。\n纵未押班坐鸱閤，亦须开府佩麟符。\n拂衣太华今无放，卜筑中条昔有图。\n久矣笙竽喧众耳，新声待奏凤将雏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次徐监簿韵贺吴侍郎新第落成 其一","author":"释善珍","text":"碧落仙人上界还，手携奎壁下天关。\n百年第宅复金盏，万卷图书围玉山。\n霜压老槐龙卧壑，春催红药凤衔环。\n时危报主诗人志，好爱苍生莫爱闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次曾都仓韵","author":"释善珍","text":"学问渊源汲绠深，逢时肯作子光瘖。\n平泉旧圃多奇石，栗里闲居只素琴。\n终竟封侯凭燕颔，莫誇对客割牛心。\n向来谢傅游山伴，尚有白头支道林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次愚谷游北山韵","author":"释善珍","text":"登山行复歇，脚力钝如蛙。\n宿雨少游客，荒畦多落花。\n公侯归蔓草，池馆破谁家。\n同是伤春者，留连惜物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次蒲心泉韵","author":"释善珍","text":"京华厌尘土，借屋瞰湖边。\n驴蹇驮诗笈，鸥闲傍酒船。\n啼鹃残月晓，细雨落花天。\n何日东林伴，同脩莲社缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江南","author":"释善珍","text":"江南春水荻芽青，江北春风鱼上冰。\n花发正催寒食节，雁归应过永昌陵。\n骑奴玉辔闲调马，公子锦韝行臂鹰。\n曾宿扬州建隆寺，五更吹角鼓腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过南墅怀寒岩 其二","author":"释善珍","text":"草没亭台不见踪，故交掩泪立寒风。\n食鱼客去馀空馆，放鹤童归弃旧笼。\n病悟前书藏夏口，死留好句在江东。\n徐陵元是麒麟种，天上应须见宝公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过南墅怀寒岩 其一","author":"释善珍","text":"年年散粟出朱门，狗盗鸡鸣总受恩。\n空有玉棺归碧落，更无红粉哭黄昏。\n遍行苔藓寻陈迹，拟倩梅花招醉魂。\n常恐丘原千载后，不生荆棘长兰荪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈傅左司","author":"释善珍","text":"左司声价过韦郎，小却宜盛白玉堂。\n龙卧密云还不雨，鴂啼众草自无芳。\n江湖旱地千里赤，淮蜀胡尘十丈黄。\n持节暂閒宁袖手，为君画策射天狼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"投赠张斗野 其二","author":"释善珍","text":"曩岁怀忠扣帝阍，东游未久赦虞翻。\n流芳千载凛生气，拜赐九河湔泪痕。\n钓艇带烟飞鹭渚，辔驴冲雪早梅村。\n虽云冷淡穷生活，刺绣终胜倚市门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"投赠张斗野 其一","author":"释善珍","text":"雪曲从来难赏音，无机古路绿苔深。\n骥寒远放雁为伴，鹤晚未归鸦满林。\n紫领宽袍笼袖醉，乌纱侧帽掉头吟。\n公侯多少身名灭，李杜光芒尚至今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"京口时楚寇侵维扬","author":"释善珍","text":"河淮羽骑召兵频，腊月花开暖似春。\n斗雀倚风将坠地，长鲸吸海欲生尘。\n烧红天半无飞鸟，云白山中有隐人。\n回首南园旧城阙，断烟荒树更伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈宰诸官登罗汉阁看草书经卷韵","author":"释善珍","text":"柳公遗迹留芳扁，一度摩挲一叹嗟。\n佛阁僧居如穴蚁，梵编虫蠹失惊蛇。\n文占天上奎星聚，语到宵中斗柄斜。\n老衲畏寒仍戒酒，不能伴客赋梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤山","author":"释善珍","text":"数树梅花地，先朝处士庐。\n柳凹人系马，萍破鹭窥鱼。\n空冢衣冠蜕，山房水石虚。\n白头旧园吏，曾见幸金舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徂岁","author":"释善珍","text":"徂岁忙如电后雷，新年又下急符催。\n雪将解舞絮誇柳，春遣先锋花付梅。\n窗白看书俄晻霭，炉红炙手倏寒灰。\n凭栏大笑无人会，瞥尔晴空一鸟来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拥炉","author":"释善珍","text":"俗客敲门以病辞，拥炉时复撚吟髭。\n雀栖梅日印孤影，蛛去檐风吹断丝。\n旧友渐稀增感慨，良辰易过莫寻思。\n六年世态看差熟，惟有青山无变姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林节推架轩扁水木清华","author":"释善珍","text":"红满芳波绿满蹊，公馀无事似幽栖。\n临池洗砚看鱼跃，对竹坐衙闻鸟啼。\n胸次九流如镜净，壁间片锦与花齐。\n云霄别有清华地，早晚朝车过竹溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苔径","author":"释善珍","text":"苔径长年断俗踪，亦无交旧可过从。\n闲忧颓堕自锄菜，老尚怪奇惟种松。\n履破背时翻著袜，诗狂见月乱撞钟。\n千年陶谢今谁似，恐有山林不易逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊原","author":"释善珍","text":"郊原春过后，日日长新梢。\n洗竹去蛛网，疏松留鹤巢。\n云衣慵补缀，月户自推敲。\n旧种梅花树，吾今与汝交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采药","author":"释善珍","text":"每共樵翁采药归，晚晴荷锸又相随。\n行逢流水便乘犊，坐到烂柯因看棋。\n鸟踏高枝收坠果，人耕古冢得残碑。\n远公幸自逃名好，何必栽莲诳小儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金陵怀古 其二","author":"释善珍","text":"国号仓皇更几回，昔人事往后人哀。\n相赓璧月词千阕，帝劝长星酒一杯。\n春草不怜同泰废，晓钟犹是景阳来。\n陵荒玉椀无踪迹，寒食梨花依旧开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金陵怀古 其一","author":"释善珍","text":"齐楼梁殿黍离离，王气潜随斗柄移。\n秋雨狐藏宫井树，夕阳鸦立御园枝。\n诗人闲管江家宅，宰相偏嫌蔡允儿。\n青史鬼雄元不死，归来化鹤有谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺刘后村除兵侍兼直院","author":"释善珍","text":"人物依然元祐中，莺边系马亦金狨。\n相君惟忆刘夫子，学士须还儋秃翁。\n翰苑鹤天双鬓雪，玄都燕麦几春风。\n老来始得文章力，前有欧公后益公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城归","author":"释善珍","text":"一宿城闉便忆归，云林长恐与心违。\n真金化得终无药，脱粟空时尚有薇。\n野雀避鹰巢竹栋，樵童背日睡蓑衣。\n近闻谷口梅花发，病拟支筇下翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春寒","author":"释善珍","text":"松间灯夕过，顾影在天涯。\n雪暝迷归鹤，春寒误早花。\n艰难知世味，贫病厌年华。\n故国风尘外，无心更问家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"看书忆北涧","author":"释善珍","text":"无事看书倦即休，心灵远与古人游。\n常尊贾岛呼吟佛，盍请刘伶谥醉侯。\n岁晚庭梅真益友，天寒炉火是重裘。\n两冬京浙无消息，老涧年来安健不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺赵礼部得祠二首 其二","author":"释善珍","text":"帝赐琳宫散吏名，寄声黄閤谢弓旌。\n琴招野客持杯听，棋看痴人覆局争。\n燕颔终当飞食肉，蛾眉最忌美倾城。\n晴空万里君知不，苍狗白云常变更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺赵礼部得祠二首 其一","author":"释善珍","text":"曩岁巍冠接俊髦，玄都又种几番桃。\n山中供奉犹遭谤，泽畔灵均盍赋骚。\n世事万端常倚仗，丈夫百挫见雄豪。\n旁人妄指笼中翮，不识冥鸿天宇高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺曾帅得祠 其二","author":"释善珍","text":"千骑丛中旧拥旄，丹心犹在鬓萧骚。\n汉庭重少冯唐老，晋士趋卑张翰高。\n静看棋枰争胜负，闲驰笔阵寄雄豪。\n抢榆击水公俱乐，却是旁人叹不遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺曾帅得祠 其一","author":"释善珍","text":"台省群飞竞刺天，琳宫散吏管云烟。\n长才十月得霜鹘，拙宦三江上水船。\n身外声名输饮酒，世间屈曲胜巢仙。\n丈夫功业谁能料，起渭征辽尽暮年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送傅提干","author":"释善珍","text":"渡江诸老尽兰荪，当日琳琅照一门。\n龙去难寻神剑迹，鹤归犹记旧巢痕。\n百年阀阅须关念，五里松楸易断魂。\n京浙故人无恙不，相逢记为问寒温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送孚老再游浙","author":"释善珍","text":"楚柁吴樯兴未休，好山谢事要闲游。\n常憎驽马恋栈豆，今见苍鹰掣臂韝。\n岁晚老松无伴侣，天寒落叶正飕飗。\n人间果是风堪御，却欲携君遍九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送杨户部","author":"释善珍","text":"铃斋去岁念民饥，鬓雪凋疏带减围。\n史册千年循吏少，江湖万里散人归。\n儿童不信夷齐溷，党论尝攻韩范非。\n临别祝公坚晚节，受恩何敢望留衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送林节推 其二","author":"释善珍","text":"幕皆资画诺，人最说君贤。\n判好堪呈佛，心清亦近禅。\n著书僧有传，执法吏无权。\n风雨东门路，分携忽黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送林节推 其一","author":"释善珍","text":"魁宿来临幕，不同常郡僚。\n名高饶荐剡，官满合归朝。\n綵旆倾城送，清声载路谣。\n丽谯虽末绩，亦自出云霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送林南恩入京","author":"释善珍","text":"曩赋登楼望故乡，边淮十丈战尘黄。\n已闻淝水返朱序，亦说汉庭怜孝章。\n千载青编如属国，一麾白发出炎荒。\n山林朝市终殊路，只待除书慰别肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵礼部将漕广东","author":"释善珍","text":"玉节畀名流，澄清十四州。\n元公著书处，葛老鍊丹洲。\n星应郎官舍，霜侵使者裘。\n东南箕敛极，宽得一分不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵礼部提举江西","author":"释善珍","text":"玉节来临昔治州，仪曹爽气更横秋。\n未誇判笔摇山岳，且喜仙槎近斗牛。\n童拾棠阴前竹马，纱笼寺壁旧银钩。\n南塘遗稿公新卷，他日人传作话头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送黄凝云归常州","author":"释善珍","text":"一住京华能几日，故山欲去值春寒。\n石坛经雨草生遍，庭果落阶鸟啄残。\n云表鹤声朝返佩，林间虹气夜开丹。\n仙家缩地寻常事，试与思归倦客看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蔡秀才之漳浦","author":"释善珍","text":"夜冷萤窗书倦看，解鞍南去路漫漫。\n霜乾处士梅花圃，日照先生苜蓿盘。\n乞米剩堪供鹤料，钓鳌重怕坏鱼竿。\n何当著意抛妻子，共入深山学养丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蔡察院将漕广东","author":"释善珍","text":"峨冠人避柏台骢，弭节光分泽国龙。\n应似鲜于福京左，还同司马过临邛。\n风生廉按清南峤，冰解将输佐大农。\n拈起瓣香说无极，千年道统继儒宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送颜主簿之怀安","author":"释善珍","text":"古廨大江边，多闲少俸钱。\n凤栖仇览棘，虹贯米家船。\n心静佛三昧，时来官九迁。\n外台兼督府，幕下正须贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送颜倅之江西","author":"释善珍","text":"槛外江流知几霜，烦君著语吊滕王。\n琴中谁识啼乌曲，酒后任称司马狂。\n阁序尚留唐篆刻，剑光何预晋兴亡。\n此行遍览遗踪了，历有徵书出建章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"除夕","author":"释善珍","text":"七十明朝是，年将衰并来。\n顽皮禁冷暖，老气压凶灾。\n铁砚穿何益，金丸跳不回。\n群儿爱伶利，与汝换痴呆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"首夏","author":"释善珍","text":"首夏山中风物和，不妨老子小婆娑。\n竹亭晴坐燕泥少，花径晓行蛛网多。\n云表危峰干北斗，道傍古树识东坡。\n匡庐深处堪归隐，岁月澜翻奈老何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"倚筇","author":"释善珍","text":"枫叶芦花满目秋，倚筇那复少年游。\n眼看桑海梦相似，骨瘗匡庐心始休。\n万里霜天孤唳鹤，五湖烟水一身鸥。\n君看清绝无攀处，著得尘埃半点不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"借甑","author":"释善珍","text":"投老林间借甑炊，心闲自觉乐无时。\n生台抛饭暗持咒，山路负薪高诵诗。\n惜燕常年寻故主，笑人荒冢树穹碑。\n白头寂寞安吾分，何用黄金铸子期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭元双杉","author":"释善珍","text":"哭公非故人，觉苑失龙麟。\n白日有明暗，青天无鬼神。\n戒珠常照夜，锁骨不栖尘。\n老我谁相问，空馀影伴身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭寒岩传权院","author":"释善珍","text":"早岁驱驰翰墨场，快如阵马与风樯。\n自期作佛先灵运，那肯堆钱付窟郎。\n闲日有僧来乞米，死时无妓共分香。\n神仙谪堕年期满，应合乘云在帝旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐教下第归","author":"释善珍","text":"奏赋长安不遇知，丈夫失意肯生悲。\n科名自古与风汉，造物至今犹小儿。\n道在布韦轻将相，时危耕钓隐英奇。\n渡江亦谒青山不，应念曾公为制碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽刘常簿赣州","author":"释善珍","text":"远游少负长卿才，晚亦乘车衣锦回。\n正喜瘴溪鳄移去，又惊辽海鹤归来。\n秘书入社花簪帽，宾客分司酒满杯。\n莫怪一麾不辞远，吟诗要上郁孤台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓登甘露寺楼","author":"释善珍","text":"秦吴相接处，远客独来游。\n秋尽斗移柄，曙分河隐流。\n马嘶残月垒，雁入向阳州。\n北望长江在，悠悠波浪愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"破衲","author":"释善珍","text":"破衲褴襂两鬓霜，耳边谁管俗雌黄。\n自骑驴鍊推敲字，不与人知安乐方。\n五柳传中寻靖节，孤桐声里见嵇康。\n深山敢叹无知己，饥食松花死亦香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"莫春","author":"释善珍","text":"门外柳花过，似予飘泊身。\n吟高妨定衲，客久羡归人。\n无药可医俗，有钱难买春。\n山中旧同伴，招隐寄书频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"逢春","author":"释善珍","text":"衰老逢春能几回，自怜光景赋残梅。\n齿牙落尽舌犹在，年岁阅多心尚孩。\n座上麈閒谈客去，手中书堕睡魔来。\n生平痴绝真堪叹，千古文章水一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成","author":"释善珍","text":"长年狎樵牧，门外即荒郊。\n瘦草牛羊路，高松鹳鹤巢。\n病来勤习定，老去懒寻交。\n常愧逃名者，深山自缚茆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄见首座","author":"释善珍","text":"借得茆斋傍涧泉，新年乐事胜常年。\n诗逢得意犹藏稿，琴畏知音自断弦。\n鲸浪粘天思渡海，狼烽照夜忆游边。\n崄途试尽身犹在，来共看云听雨眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄孚老","author":"释善珍","text":"双眼常时看屋椽，从来不结俗人缘。\n早年曾悟出师表，晚岁始参齐物篇。\n魔垒孤军降百万，诗坛一首当三千。\n清溪结得茆庵未，闲欲寻君共泛船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄朋介石","author":"释善珍","text":"诗卷前年手自携，秋风客路易东西。\n游淮战士看飞锡，渡海神鱼惊照犀。\n故国身归疑化鹤，深山睡稳厌闻鸡。\n一生结友皆奇衲，难得如君无町畦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赵西岩","author":"释善珍","text":"暑退江城又素秋，想因怀土亦登楼。\n兰香盍称骚人佩，萱草难忘志士忧。\n纸上雕虫真害道，山中射虎胜封侯。\n四方弧矢男儿事，慎勿悲伤念少游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]