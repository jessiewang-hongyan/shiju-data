[{"title":"仲一以诗来用韵奉答 其一","author":"陈傅良","text":"陪侍经帏涉岁年，亦尝尚论鞠衣贤。\n如今三嗅馨香泣，惟恐将诗去浪传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仲一以诗来用韵奉答 其三","author":"陈傅良","text":"剩有新诗入递筒，岂无能画作掀篷。\n金钱翠盖相辉映，著我皤然酒借红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵简丁端叔 其一","author":"陈傅良","text":"乞邻亟只报何迟，愁绝饥氓一胜余。\n上有加餐下相忆，莫同泛泛寄双鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵简丁端叔 其二","author":"陈傅良","text":"闭关饶著一丸泥，我亦前扳更后跻。\n四海弟兄君看取，苛风不断雁行齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵简丁端叔 其四","author":"陈傅良","text":"繇吴入楚共悲欢，怀欲班荆竟未班。\n直待还舻愿衔尾，洞庭彭蠡浪如山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再用前韵简丁端叔 其三","author":"陈傅良","text":"事到难时意转佳，声名早已动皇华。\n拨烦自古书生短，只合横经住绛纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其二","author":"陈傅良","text":"浅杯莫到十分酣，但爱齁齁夜梦甘。\n万里桑麻风雨好，一夫尸禄我何惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其一","author":"陈傅良","text":"休将枘凿问方员，且引壶觞对圣贤。\n鸿雁不宾沧海冻，梅花相伴笑年年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"因客说秋秫水伤复用前韵","author":"陈傅良","text":"风鲙不须盐豉好，霜螯须著酒船深。\n无由种秫求旁舍，旁舍秋螟已蠹心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏题止斋丛石","author":"陈傅良","text":"虽无壁立翠琅玕，聊当庭前犊鼻裈。\n我亦闻之方伎者，众山皆大小为尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自仙岩还舍留别诸友","author":"陈傅良","text":"瀑布衡从云一坞，浮图明灭木千章。\n在山终爱离山去，遮莫黄尘涴我裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观南塘四首呈沈守 其二","author":"陈傅良","text":"夹道欢呼百里间，不论扶杖与胜冠。\n公年几许颜何似，迟放牙樯待我看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观南塘四首呈沈守 其四","author":"陈傅良","text":"别乘潘郎伯仲间，朅来公适去弹冠。\n更将未尽公碑意，收入新诗为并看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观南塘四首呈沈守 其三","author":"陈傅良","text":"乐在宜休水竹间，十年黄帕裹朝冠。\n却乘五个花文马，来与江村妇子看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观南塘四首呈沈守 其一","author":"陈傅良","text":"曾不容舠咫尺间，谁知救溺合缨冠。\n今从枕席人行过，最好翻盆雨后看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张端士以诗送兰蕙因和其韵","author":"陈傅良","text":"暮春堂上抱天和，时启柴扉与客过。\n客有可人须语似，新篁来看玉森罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沈仲一送菊自言封殖之劳欲得诗为报为赋三绝 其三","author":"陈傅良","text":"愁乾手自搭连筒，苦雨丁丁杙小篷。\n乞得花开急催客，明朝恐已著霜红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沈仲一送菊自言封殖之劳欲得诗为报为赋三绝 其二","author":"陈傅良","text":"霜螯风味小槽春，新样宫衣试曲尘。\n一段秋光谁领此，芙蓉凡子桂陈人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沈仲一送菊自言封殖之劳欲得诗为报为赋三绝 其一","author":"陈傅良","text":"东篱何在菊年年，菊视陶诗竟孰贤。\n未必缘诗花更好，花将诗与万人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周和叔通判雪寒索酒戏用来韵以将朋尊","author":"陈傅良","text":"持杯虽念故人寒，欲予还不似印刓。\n此债岂应行处有，曲春何日寄云安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和丁端叔竹梅二诗韵 其一","author":"陈傅良","text":"空阶琤若下琅玕，全楚何人巧耐寒。\n谁伴八龙长傲雪，萧然一榻卧袁安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和丁端叔竹梅二诗韵 其二","author":"陈傅良","text":"管领春风别有天，不论水际与山巅。\n祝融玉立湖湘冻，独付寒梢笑粲然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孙伟卿杂言十章 其八","author":"陈傅良","text":"阨穷果何尤，利达竟谁在。\n眷言荷锄人，妻子敬相待。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孙伟卿杂言十章 其五","author":"陈傅良","text":"幽居悟前疲，寡欲得身健。\n筮之此何祥，厥繇无水困。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孙伟卿杂言十章 其四","author":"陈傅良","text":"堕落生死间，大患为有身。\n老子识未破，天地岂不仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孙伟卿杂言十章 其三","author":"陈傅良","text":"一饭腹果然，身外百不须。\n深知饥方朔，不似饱侏儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和沈仲一北湖十咏 其一 北湖","author":"陈傅良","text":"北湖只隔岭头云，谁在湖边问讯人。\n若得小舟通我过，雨晴须破半时辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和沈仲一北湖十咏 其三 仰止亭","author":"陈傅良","text":"可爱南山与北山，北山上有斗芒寒。\n碧云归尽人何在，更捲珠帘到夜阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和沈仲一北湖十咏 其七 迟客台","author":"陈傅良","text":"借无舟楫亦褰裳，目断蒹葭水一方。\n今夜不来同剪韭，隔山明日事茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和沈仲一北湖十咏 其十 宜雨亭","author":"陈傅良","text":"看花只为雨愁人，一片才飞减却春。\n独此得春无尽藏，每于愁外见精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和沈仲一北湖十咏 其四 药房","author":"陈傅良","text":"平平下语及云管，学到诗人岂不难。\n莫似□人大芳洁，湘波千古诉椒兰。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和沈仲一北湖十咏 其八 萱竹堂","author":"陈傅良","text":"萱草须锄莫放深，竹须剪伐待成林。\n一花一叶皆相附，要使儿孙识此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和沈仲一北湖十咏 其九 楚颂亭","author":"陈傅良","text":"纷纷万木尽西风，独立霜林我御冬。\n滓畔无人谁著语，止斋但护紫泥封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和沈仲一北湖十咏 其六 粹白堂","author":"陈傅良","text":"欲来花底竟差池，我有佳名谁与归。\n翌日看花天一色，狐裘犹自织寒机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和沈仲一北湖十咏 其二 豫章阁","author":"陈傅良","text":"人去岷峨水自流，豫章三字竟沈浮。\n怀人好上层楼看，木落山寒不肯秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和沈仲一北湖十咏 其五 穆波亭","author":"陈傅良","text":"一年曾得几番圆，恨不骖鸾上广寒。\n占得波光须细玩，恰闻沧海已狂澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和徐魏叔见寄三绝 其三","author":"陈傅良","text":"独向心源识背趋，岂于身外较精粗。\n凄其下视人间世，朝市区区地一夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和徐魏叔见寄三绝 其二","author":"陈傅良","text":"纨裤何尝不误身，梁园金谷草长春。\n送将重锦齐三十，笑杀生刍一束人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和徐魏叔见寄三绝 其一","author":"陈傅良","text":"蒲团坐阅岁如梭，不管门前雀可罗。\n投赠纻衣才薄物，道人微笑已嫌多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和莘叟兄咏张子房韵","author":"陈傅良","text":"不缘多病遽怀安，阅尽人间万事难。\n谩以笑谈分楚汉，竟将功业付萧韩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和谢倅见赠生日二首 其二","author":"陈傅良","text":"独醒长爱众欢酣，酸苦随人却嗜甘。\n好客不知弹剑铗，闻公风味可无惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和谢倅见赠生日二首 其一","author":"陈傅良","text":"朝天冠佩几千员，熟数东州未乏贤。\n若论中原旧文物，蒲轮应合聘高年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"或以诗送来禽次韵奉酬 其一","author":"陈傅良","text":"连年栽树未成阴，赪实堆盘慰我心。\n手把新诗堪永日，休誇法帖送来禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"或以诗送来禽次韵奉酬 其二","author":"陈傅良","text":"隔水佳人久不逢，祇应我懒或君慵。\n感时相馈情何厚，却说云泥笑杀侬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"招徐居厚","author":"陈傅良","text":"老来却忆少相过，别自何年白发多。\n山叶抱蝉虫吊夜，去看沧海壮秋波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"觅花","author":"陈傅良","text":"背山面水竹周遭，虽乏楼台气已豪。\n更得好花千百本，中间容我诵庄骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送花还宗易","author":"陈傅良","text":"酷爱看花懒种花，知心惟有故人家。\n花开兮送花残取，娱老扶衰度岁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夜用前韵","author":"陈傅良","text":"春来十日垂垂雨，岁尽今朝亦未晴。\n衰老见年殊不觉，卧听穿叶打窗声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠绝句","author":"陈傅良","text":"淡月看花似雾中，遽呼灯烛倚花丛。\n夜来月色明如昼，却向庭芜数落红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莲花","author":"陈傅良","text":"伯仲之间竹与梅，魏姚声价浪崔嵬。\n虽然亦混鱼虾处，风度自从丘壑来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袁起岩会饮湖上出示古刻酒罢各携桂花以归因成一绝","author":"陈傅良","text":"湖光不动见鱼虾，败纸残编数十家。\n岩桂丛中三四客，醉归人得一瓶花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄九江宋居士","author":"陈傅良","text":"箧中每阅所藏书，长忆潇湘九宛馀。\n一别十年身尚健，恨无飞羽过匡庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄林宗大","author":"陈傅良","text":"春已无情雨妒花，病还妒客到花家。\n今当未雨才身健，杖策来看半吐葩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄谢怀英高士","author":"陈傅良","text":"闻君已得归山请，顾我方当绝迹时。\n欲葺止斋犹未就，箧中应有草堂资。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春二首 其二","author":"陈傅良","text":"莫道春归事已非，水边天际绿成围。\n隔篱听得农家语，雨过田田麦含肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚春二首 其一","author":"陈傅良","text":"万枝寂寞待春风，风雨过多春已空。\n未晓啼莺相唤语，海棠飞尽一庭红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"移花","author":"陈傅良","text":"樱柳初无素与蛮，可将何物伴身閒。\n欲栽花木千馀本，但候春风还未还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食早起围炉中戏和林宗易韵二首 其二","author":"陈傅良","text":"春工偏以速为神，谁管沉痾未觉春。\n禁得春寒长恣赏，甘心输与少年人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食早起围炉中戏和林宗易韵二首 其一","author":"陈傅良","text":"叠帐重裘更怯风，绝怜寒食到匆匆。\n一春不见花开落，但说栽花费几工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景元益之诸友考试旁郡余梦与步月联诗得水花初净月如银之句追成一绝","author":"陈傅良","text":"连年波浪与埃尘，谁可论心五六人。\n昨夜梦同天地阔，水花初净月如银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游丁次翁筼筜园期次翁不至","author":"陈傅良","text":"径蹊曲折屋参差，半是天成半自治。\n修竹万竿人独立，我来搔首菊花期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游金岙赵园赋海棠梨花呈留宰","author":"陈傅良","text":"海棠故作十分红，梨更超然与雪同。\n文物英华周盛事，风流玄远晋馀风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游赵园","author":"陈傅良","text":"主人避客竟何之，雨过停桡落日迟。\n赖有畦丁曾识客，来禽花送两三枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落成王朝奉庙以薄恙不获预谢刘宰并诸乡丈五首 其五","author":"陈傅良","text":"抱病荒村望欲迷，骏奔无数独鸡栖。\n瞻言鼕鼓何时歇，好听农郊雨一犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落成王朝奉庙以薄恙不获预谢刘宰并诸乡丈五首 其四","author":"陈傅良","text":"却向平时念后艰，榱题百尺忽如山。\n谁将西上逢人问，令尹何如此一班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落成王朝奉庙以薄恙不获预谢刘宰并诸乡丈五首 其三","author":"陈傅良","text":"操一豚蹄亦可怜，欲将庙食自旌贤。\n坏墙颓壁神台笠，不见干戈六十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落成王朝奉庙以薄恙不获预谢刘宰并诸乡丈五首 其二","author":"陈傅良","text":"横塘一字比南金，满纸书劳属意深。\n太史不知收拾未，邦人父老泪渐襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落成王朝奉庙以薄恙不获预谢刘宰并诸乡丈五首 其一","author":"陈傅良","text":"盗起清溪两浙空，童王亲自帅元戎。\n谁知小邑无亭障，但握空弮有隐功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢司马倅惠东坡竹石","author":"陈傅良","text":"出自坡翁馀百年，传之温国子孙孙。\n两家文物来归我，便盍投簪去杜门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢林默之居士惠酒居士山居方与世绝尚欲友此废人耶小诗举发一笑","author":"陈傅良","text":"不将鹅鸭恼比邻，林下萧然老幅巾。\n乞与青州十从事，添成明月两閒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢倅监试未毕事而出以诗三章来用韵奉酬 其二","author":"陈傅良","text":"归舟莫讶太匆忙，会面何曾累十觞。\n孰与持螯霜月下，拍浮酒浪旧陂塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢倅监试未毕事而出以诗三章来用韵奉酬 其三","author":"陈傅良","text":"极欲从君十日欢，倦飞终羡鸟知还。\n棘围观战缘何事，亦纵骅骝自出关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢倅监试未毕事而出以诗三章来用韵奉酬 其一","author":"陈傅良","text":"殷勤送客蹇谁留，久待江城未解舟。\n我醉欲眠君且去，不妨懒瓒继前猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬王判官和九日韵 其一","author":"陈傅良","text":"皇华六辔按倭迟，博采参差到接余。\n我独内惭无具甚，万家亦免釜生鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬王判官和九日韵 其二","author":"陈傅良","text":"想悬郴桂一云泥，夫子声名正日跻。\n乞与早移河内粟，牙牌归听报班齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬王判官和九日韵 其四","author":"陈傅良","text":"怀自何年晚见欢，匆匆惜已□声班。\n青刍白饭吾何有，风月犹堪倒玉山。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":22131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]