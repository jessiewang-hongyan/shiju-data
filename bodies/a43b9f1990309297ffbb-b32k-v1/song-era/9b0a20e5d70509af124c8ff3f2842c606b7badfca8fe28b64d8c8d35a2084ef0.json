[{"title":"句 其十","author":"王镐","text":"籍通上界神仙府，身现甘泉侍从臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"王镐","text":"发爽带风梳，齿疏和月漱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"王镐","text":"云学催诗黑，风仍作颂清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"王镐","text":"山色两间供步障，松阴半亩当邮亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"王镐","text":"未知真是岳，祇见半为云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"王镐","text":"仁心广大麟难比，寿骨清奇鹤不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王镐","text":"只言弱水蓬莱远，无奈仙风道骨何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"横秋阁","author":"王駜","text":"地僻无车马，新凉入醉乡。\n柳烟颦夕渚，莲露泣秋塘。\n懒听能啼雁，閒披古锦囊。\n物华随处好，何必在潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄葵","author":"王操","text":"昔年南国看黄葵，云鬓金钗向后垂。\n今日林容篱落下，秋风寂寞两三枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上李昉相公 其二","author":"王操","text":"朝苑优游数十春，文章敌手更无人。\n对扬旒冕如僚友，下直门阑似隐沦。\n倚槛白雪供醉望，支筇黄叶落吟身。\n年来得意知难绝，大半门生作侍臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上李昉相公 其一","author":"王操","text":"弱冠登龙入粉闱，少年清贵古来稀。\n袖中诏草朝天去，头上宫花侍宴归。\n卓笔玉堂寒漏迥，捲帘池馆水禽飞。\n三台位近犹多逊，閒听秋霖忆翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"并州道中","author":"王操","text":"从军无住计，近腊塞门行。\n风劈面疑裂，冻粘髭有声。\n太阳过午暗，暮雪照人明。\n马上闻吹角，依依认汉城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村家","author":"王操","text":"野景村家好，柴篱夹树身。\n牧童眠向日，山犬吠随人。\n地僻乡音别，年丰酒味醇。\n风光吟有兴，桑麦暖逢春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洛阳春","author":"王操","text":"帝里山河景莫裁，就中春色似先来。\n暖融残雪当时尽，花得东风一夜开。\n艳日绮罗香上苑，沸天箫鼓动瑶台。\n芳心只恐烟花暮，閒立高楼望几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送人南归","author":"王操","text":"相送当摇落，孤舟泛渺瀰。\n去帆看已远，临水立多时。\n别浦寒鸿下，空山夜鹤移。\n他年重会面，冷鬓共成丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜故人至","author":"王操","text":"地僻无宾侣，柴门昼始开。\n溪山寒叶落，江国故人来。\n话旧惊霜鬓，论诗滞酒杯。\n相留喜同宿，不寐曙光回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游边上","author":"王操","text":"佩剑游边地，悲风捲败莎。\n雕饥窥坏冢，马渴嗅冰河。\n塞阔人烟绝，春深霰雪多。\n蕃戎如画看，散骑立高坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"塞上","author":"王操","text":"无定河边路，风高雪洒春。\n沙平宽似海，雕远立如人。\n绝域居中土，多年息战尘。\n边城吹暮角，久客自悲辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠刘将军","author":"王操","text":"三十悬钩事圣朝，功名常爱霍嫖姚。\n锦衣香重花垂足，玉带光寒雪绕腰。\n秣马暖思秦地草，弦弓秋忆雁门雕。\n清时閒却英雄兴，醉听笙歌掷酒瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"王操","text":"堂亲垂白日，稚子欲行时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"王操","text":"马摇金勒嘶村墅，人抢花毬落野田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"聚景园","author":"王澡","text":"光尧与寿皇，昔者屡游幸。\n缛川骑服鲜，藻野宫妆靓。\n春池冰鉴开，笑对惊鸿影。\n不见两河閒，父老久延颈。\n仰望鸾旂回，呼跸牟尼顶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祝英台近 别词","author":"王澡","text":"玉东西，歌宛转。\n未做苦离调。\n著上征衫，字字是愁抱。\n月寒鬓影刁萧，舵楼开缆，记柳暗、乳鸦啼晓。\n短亭草。\n还是绿与春归，罗屏梦空好。\n燕语难凭，憔悴未渠了。\n可能妒柳羞花，起来浑懒，便瘦也、教春知道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜天晓角 梅","author":"王澡","text":"疏明瘦直。\n不受东皇识。\n留与伴春终肯，千红底、怎著得。\n夜色。\n何处笛。\n晓寒无奈力。\n若在寿阳宫院，一点点、有人惜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司空侍郎故居","author":"王翰","text":"西风策马问王官，松径萦纡上百盘。\n泉响夜潭穿石窦，峰高天柱矗云端。\n一鸣共许才华旧，三诏方知节操寒。\n花落鸟啼人不见，休休亭上倚阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石淙","author":"王赞","text":"磴道山岩下，茅楹竹树中。\n深潭鱼可见，攒石路才通。\n坐听潺湲碧，县思烂熳红。\n平生丘壑志，览此兴何穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和知军毛奎小洞天诗","author":"王赞","text":"使君赋佳什，笔壮过飞泉。\n索远寻幽地，求深访洞天。\n山巍云脚敛，海极日头偏。\n景喜岩瞻石，台虚钓隐船。\n高人贪胜概，清海赖无旋。\n拟把张槎泛，何妨谢屐穿。\n心闲尘不染，客好景成妍。\n去去迎三岛，看看会七贤。\n醉眠思石枕，缓步惜苔钱。\n再约通宵饮，相邀秉烛椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花","author":"王默","text":"知己林和靖，论心何水曹。\n平生怀玉雪，独立占风骚。\n月落香方觉，天寒韵更高。\n冥搜吟未就，清梦满江皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春花叹","author":"王默","text":"春花复春花，红红间白白。\n相看待明发，已不如昨日。\n雨露费濡染，秉芳几何时。\n姚魏殿春事，浓绿已盈枝。\n长安池馆多，新故如转烛。\n所以山中人，但种松与竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"王曙","text":"枣花至小能成实，桑叶惟柔解吐丝。\n堪笑牡丹如斗大，不成一事只空枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"王曙","text":"凿龙苍翠照□川，白鸟平芜暮雨閒。\n一夕尘襟清似水，潺湲声里□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶□","author":"王曙","text":"□倚苍崖次第开，暂停征传一徘徊。\n人间万事皆如此，偶尔□胜特地来。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答子","author":"王曙","text":"疏家子叹挥金后，禦寇妻悲遗粟回。\n争似吾儿知止足，陶庐容膝早归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题回峰寺诗","author":"王安石","text":"山势欲压海，禅扃向此开。\n鱼龙腥不到，日月影先来。\n树色秋擎出，钟声浪答回。\n何期乘吏役，暂此拂尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王曙","text":"千山送客东西路，一树照人南北枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北湖水月","author":"王橚","text":"奁镜平开碧四围，百重山里亦希奇。\n写成万古空明趣，只为中秋一首诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"君山","author":"王濯","text":"无际波光滉太虚，君山一点暮云孤。\n危楼栏槛能多少，展尽江湖万里图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清都观","author":"王濯","text":"天上清都人莫到，山间仙观久荒凉。\n惟余旧浴丹砂井，一酌犹令齿颊香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王濯","text":"绝壁高千丈，清泉应六时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王繁","text":"万山飞不出，守令最相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题隐仙坡","author":"王璹","text":"有一仙翁号隐仙，要知□□又生贤。\n好将隐德无家意，贺□仙坡万古传。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浯溪","author":"王□达","text":"□□游宦过湘山，道阻□□十里闲。\n奎画自今容拂拭，苍崖从昔要跻攀。\n扫除妖孽□□□，□录勋庸信□□。\n自叹此生那从□，是行应得□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句","author":"贝守一","text":"高车驷马谩相誇，竹榻蒲团属自家。\n困睡饥餐何所有，一溪明月照梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬晴晚步","author":"贝守一","text":"浮云初敛夕阳斜，路入江村四望赊。\n木厌霜浓频脱叶，梅嫌春小未开花。\n翩翩过雁摩晴汉，隐隐孤帆趁落霞。\n欲壮吟怀沽斗酒，野田多处少人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自适","author":"贝守一","text":"迹晦心须晦，神清梦亦清。\n一窝如斗大，万事等沤成。\n风月平章易，山林去就轻。\n生生终有累，不若事无生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"适意","author":"贝守一","text":"不效痴禅误此身，安居随分乐天真。\n閒寻草药防医病，广施仙方为济人。\n学道未逢师诀窍，收心且养自精神。\n修持要到无空地，扫却从前碍眼尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有何不可 其二","author":"贝守一","text":"炎炎火伞张空，避暑林亭趺坐。\n有时解带披襟，恁地有何不可。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有何不可 其一","author":"贝守一","text":"园林桃李争妍，我有兰花数朵。\n杯盘笋蕨鲜肥，恁地有何不可。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有何不可 其三","author":"贝守一","text":"桂花香满脩廊，皓月当空照我。\n徐徐三弄瑶琴，恁地有何不可。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有何不可 其四","author":"贝守一","text":"竹坞雪封云锁，地炉温酒添火。\n醉来拥被高眠，恁地有何不可。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逍遥吟","author":"贝守一","text":"饥餐匕箸饭，渴饮瓷罂酒。\n不忺白昼眠，时复绕庭走。\n不结冷淡交，亦无名利友。\n晚借竹风凉，临池坐良久。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与史宰山泉","author":"车若水","text":"十亩山田手自耕，括囊安分是平生。\n西州豪杰无皇甫，懒去虚干向上名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小溪道中时己亥荒甚","author":"车若水","text":"风前有地皆榆叶，秋后何人问菊花。\n客路一杯茅店酒，相逢僧亦话生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庚申","author":"车若水","text":"襄阳耆旧总堪羞，只有庞公已入州。\n自向芭蕉眠夜雨，不堪更鼓在床头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明妃","author":"车若水","text":"万里来朝拜宠归，琵琶下马册阏氏。\n虚传千古和戎话，不道当年虏自衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄瑞岩老煜无取","author":"车若水","text":"凉月空山挂祖衣，猿啼塔树昔人非。\n春风早已青青柳，莫在梅花飞后飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉涧寻梅思先祖隘轩著书处","author":"车若水","text":"涧水流亭北，莓苔片石平。\n寒山几点白，残日一杯清。\n希圣言犹在，斯人天不生。\n当年结深屋，岂为适閒情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江湖伟观","author":"车若水","text":"十年不到一凭阑，景色依然两鬓斑。\n龙蜃吐云天入海，楼台倒影水衔山。\n僧于僻寺难为隐，人在扁舟不是闲。\n孤鹤似寻和靖宅，盘空飞下又飞还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恸立斋先生","author":"车若水","text":"元元含望久，及是事方新。\n四海看更化，皇天忍误人。\n多于閒论议，得听古经纶。\n岂不怀斯世，吾今爱此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不寐","author":"车若水","text":"通夕不能寐，隔户闻钟声。\n野鸡四方啼，披衣天未明。\n萧条六合内，耿耿华发生。\n断鳌何能立四极，杞人忧天自心失。\n黄昏野沽添一盂，孔孟行世非我力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见筼窗先生","author":"车若水","text":"关扃守残经，坐几刓无漆。\n风惊雨劫破窗寒，猛心直矢圣贤室。\n蛰蝇眩光弹夜纸，一膜不透千千里。\n帢帻檠奎照屋明，中津弗截衣带水。\n敦彝久掩生深尘，大启户牖来无人。\n眼中孺子差可语，可语不语悔千古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈立斋先生","author":"车若水","text":"童牙苦呫毕，嚼瓜灯烬烂。\n衡缩高于丘，才作文字看。\n精微隔几尘，健笔抵流湍。\n开眼天地燎，始识用书难。\n千葩惭一实，本根耐岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和立斋先生雁山韵","author":"车若水","text":"洗山出穹石，削空蹲苍城。\n一清屹万古，何物相与形。\n步涉贪深游，往往神所兵。\n立斋立千仞，天地鉴清声。\n平平溯龙准，不见猿鸟惊。\n斯道今泬寥，斯人世重轻。\n擎天只柱健，此嘱谁堪膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思远","author":"车若水","text":"白兔速圩顶，暗壁收遗编。\n握之不盈掬，而能千万年。\n天地可无人，秦火乃可然。\n其粗洒埽间，其精造化先。\n后来读书者，暗引佛与仙。\n之人胡弗灵，所论各有偏。\n嚣祲碍亭毒，三精惨不鲜。\n涂饰为善治，制作埋九渊。\n固有二三子，梯级堪攀缘。\n夜永发孤啑，思远能废眠。\n拔地为五岳，岂其高到天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶书呈雪溪葛守正","author":"车若水","text":"秦埃幻六籍，斯文天地屯。\n詝言嘈万喙，渺不游其津。\n作者能几何，落落星已晨。\n单其千载传，觑斑尤苦辛。\n毫芒忽有会，不能全吾神。\n颇怪十年前，出语辄可人。\n功深道更拙，敝帚聊自珍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄鲍府教宏博","author":"车若水","text":"漆文虫章孔壁冷，秦烟不烬收馀矿。\n人心万古无代谢，六龙当天枢极炯。\n赤帝芟嬴能几年，丛葭乱苇书千千。\n商盘周敦赝今古，魏殿吴宫凿后先。\n汗将九牛牵不上，从容一丝经万象。\n百年文献来典谟，我欲盟君分石渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游灵岩","author":"车若水","text":"一径碧如合，四山危欲堕。\n天低鸟不飞，露湿龙常过。\n岩根小叶下，境净不可唾。\n深杳洞出云，冷钟佛惊卧。\n川僧住八年，有此清福大。\n而我寻盟来，坐借蒲团破。\n灯深眼双青，各话其所课。\n我谷未必实，他华已成果。\n归来宜有馀，吾道岂全懦。\n壁间清献存，当年愧轻和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"儳言","author":"车若水","text":"娲皇识五石，炼之能补天。\n补天有何迹，五石世不传。\n五石岂不传，人心禀灵坚。\n一日彝伦叙，千年造化全。\n此石经几炼，天亦经几补。\n火候吾有之，吾师鲁男子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"车若水","text":"江右文章今四叶，水心气脉近三台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿冲佑观","author":"车柬","text":"才说升真意豁然，此行却喜结仙缘。\n步穿空翠云生脚，仰看飞流雪满肩。\n控鹤不来春寂寂，卧龙无底月娟娟。\n飘然便作乘风想，不待丹成到九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒文公祠","author":"车柬","text":"世间万境一蘧庐，与道俱存是此书。\n千载归来人化鹤，满腔真乐我知鱼。\n要将德业参天运，莫把光阴掷岁馀。\n静里功夫终透澈，一庭明月夜窗虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"马家山","author":"车瑾","text":"山头红日生，山下蚁蛙争。\n朝市谁能问，烟云我自耕。\n胡麻调紫蕨，黄独煮香粳。\n无意随园绮，逃名更得名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":19695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]