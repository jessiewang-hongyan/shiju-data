[{"title":"返魂梅次苏藉韵 其四","author":"陈克","text":"鼻根无奈重烟绕，偏处春随夜色匀。\n眼里狂花开底事，依然看作一枝春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5935,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"返魂梅次苏藉韵 其五","author":"陈克","text":"漫道君家四壁空，衣篝沈水晚朦胧。\n诗情似被花相恼，入我香奁境界中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5936,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"陈克","text":"鸟声妨客梦，花片搅春心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5937,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"陈克","text":"易照水姿容，非复我登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5938,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"陈克","text":"徘徊临北顾，慷慨俯东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5939,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其四","author":"陈克","text":"泪眼生憎好天色，离觞偏触病心情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5940,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其五","author":"陈克","text":"莫向边鸿问消息，断肠书信不如无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5941,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其六","author":"陈克","text":"小楫登鱼蟹，平原聚鸟乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5942,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其七","author":"陈克","text":"俯临铁瓮重城迥，远接金陵胜气来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5943,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其八","author":"陈克","text":"北固天下奇，凭虚倚楼堞。\n大江走天去，控以高崨嶪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5944,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其九","author":"陈克","text":"君今向姑孰，山好江漫漫。\n炯如谪仙人，千载欣复还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5945,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二十七","author":"陈克","text":"角中飘去凄于骨，笛里吹来妙入神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5946,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二十八","author":"陈克","text":"愁眼不供千树雪，醉头犹奈一枝春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5947,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二十九","author":"陈克","text":"濛濛清露濯幽葩，醉质斓斑衬晓霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5948,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三十","author":"陈克","text":"顾我从来贫到骨，经营藜藿亦艰辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5949,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三十一","author":"陈克","text":"楼下旌旗五丈馀，府中贤尹计魁梧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5950,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"德清龟溪亭遇大雨","author":"孙觌","text":"崩云四合千嶂重，奔电一掣十里红。\n土囊叱吸万窍风，江翻石走昏相蒙。\n疾雷破柱鞭老龙，百贾颠沛市井空。\n银河倒倾千丈谼，鱼鳖欲取山为宫。\n洪涛舂天怒相攻，大舸吹簸如飞蓬。\n醉卧掀舞一叶中，洗我云梦芥蒂胸。\n忽然变灭何匆匆，雷公收声电改容。\n霞舒雾卷萦长虹，绀碧万顷磨青铜。\n溪边结网南巷翁，白发黄馘射两瞳。\n赤鳞腾出无留踪，刻舟求剑何时逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5951,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖州天宁寺饮王生二首 其一","author":"孙觌","text":"莫斗蜗两角，且共貉一邱。\n夷踞坐我旁，汝岂河南驺。\n割肉一啖之，徐以大白浮。\n哙伍君勿谯，笑谈起封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5952,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖州天宁寺饮王生二首 其二","author":"孙觌","text":"诸家迹便扫，得此一老兵。\n江东醉司马，酒中尚求名。\n哀哉南山萁，不平自号鸣。\n慎勿歌乌乌，作此老婢声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5953,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿太湖口二首 其一","author":"孙觌","text":"谁令醉尉怒，端是丞相嗔。\n交疏白眼见，愁绝翠眉颦。\n迟暮仍三黜，惊窥有四邻。\n还将万里眼，笑索岭梅春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5954,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿太湖口二首 其二","author":"孙觌","text":"白首对泷吏，骍汗愧逐臣。\n溪山不改色，风雨解留人。\n坎壈知天意，漂浮任此身。\n纷纷小儿女，何必泪沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5955,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿太湖口二首 其三","author":"孙觌","text":"溺灰不辞辱，箕踞未易诃。\n仅免遭田甲，谁能让尉佗。\n舆粮饯吾鬼，分灯遣诸魔。\n酒中有真觉，一梦到无何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5956,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"馀杭闻出师","author":"孙觌","text":"国蹙连群盗，时危仗老臣。\n分忧当北顾，请幸且东巡。\n肘足仪三晋，创痍又一秦。\n不眠听野哭，愁杀路傍人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5957,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"富阳道中二首 其一","author":"孙觌","text":"渺渺行云幔，溶溶曳水衣。\n雷翻巢堕乳，风落网粘飞。\n独拄青藜杖，来推白板扉。\n平生丘壑趣，漂泊寸心违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5958,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"富阳道中二首 其二","author":"孙觌","text":"白帽炎州客，青裙酒姥家。\n微风摇扇浪，细雨落檐花。\n客舍休占鵩，蛮村欲馔蛇。\n会令醒复醉，高枕送生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5959,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桐庐连夕大雨溪涨数十丈徙寓白塔山上方阁","author":"孙觌","text":"苍莽川流会，浑酣海气嘘。\n蛟龙改窟宅，雷电走空虚。\n殷地翻坤轴，黏天浸日车。\n高僧欲杯度，游客且楼居。\n壮观真难值，幽怀亦少摅。\n翩翩一鸟去，何必羡知鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5960,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水退","author":"孙觌","text":"荡沃波澜大，凭陵意气粗。\n射潮鲛鳄怒，鞭石鬼神驱。\n云断千崖立，风行万壑趋。\n樯乌朝共起，水鸟夜仍呼。\n滟滟红升晓，霏霏翠扑肤。\n浮楂卧泥滓，狼藉满街衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5961,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胥口","author":"孙觌","text":"江阔卧人影，山长送马蹄。\n渚莲红尚敛，沙草翠相迷。\n高树藏云直，疏篁压雨低。\n酒醒浑不记，端是武陵溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5962,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钓台二首 其一","author":"孙觌","text":"北塞风尘万鼓鼙，东京社稷一戎衣。\n绿林群盗驱民去，赤伏真人得帝归。\n诸老禅联苍玉佩，将军坐鞚紫金鞿。\n先生此日青霞志，一笑凌空拄杖飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5963,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钓台二首 其二","author":"孙觌","text":"故人遗像丹青落，盖代荣名日月悬。\n万马群空冀北野，一蛇独游原上田。\n晚浦苍波涵落日，秋崖老树立苍烟。\n直从厌代骑星去，千岁光芒夜斗边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5964,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兰溪津亭病起二首 其一","author":"孙觌","text":"离乱纷纷醉尉多，将军独夜灞亭过。\n旅巢对鵩占行役，客俎悬蛇卧宿痾。\n双鬓尽从愁里白，衰颜时向酒中酡。\n云翻雨覆须臾耳，未用区区较唯阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5965,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兰溪津亭病起二首 其二","author":"孙觌","text":"风波涌地千沤发，创痏钻皮百箭攻。\n药裹关心防二竖，谤书盈箧忤三虫。\n剖瓜女隶方求巧，结柳奴星也送穷。\n笑我平生持蟹手，未应咄咄左书空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5966,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三衢闻都督兵溃常润间怀舍弟而下","author":"孙觌","text":"紫荆有信欲开花，黄犬无情不到家。\n偶坐厌闻鸟嚄嚄，杯行喜听鹊查查。\n同看明月人千里，相望孤云海一涯。\n骥子熊儿无恙否，风云惨澹斗龙蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5967,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月岩寺寺有岩石高数十丈一穴中空如半月状号半月岩","author":"孙觌","text":"老蟆蚀月缺，破镜掷道边。\n金枢坏一夕，玉斧斲千年。\n何人挟寸铁，插羽飞上天。\n但令蟆磔死，重看十分圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5968,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立秋饶阳道中三首 其一","author":"孙觌","text":"残夜山月吐，蓐食治野装。\n策策林响变，一叶风陨黄。\n客路感时节，起看雁南翔。\n秋风捩孤影，云路正茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5969,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立秋饶阳道中三首 其二","author":"孙觌","text":"老马倦长道，解鞍聊缓觞。\n小雨濯鬓须，欣然惬初凉。\n奇苞照屋角，橘柚垂青黄。\n感之动中怀，弓刀戒秋防。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5970,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立秋饶阳道中三首 其三","author":"孙觌","text":"窜身楚南极，守隶工遮防。\n投鞭得小愒，孚席纷在旁。\n虎贲起隅坐，悠然见中郎。\n一醉汩其泥，江湖渺相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5971,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"弋阳县古葛陂也县有古刹临大溪相传云佛图澄浣肠故地","author":"孙觌","text":"古道阴森翠柏行，长鞭摇曳紫游缰。\n佩鸣苍玉倾瑶席，地布黄金列宝坊。\n仙客杖飞龙有角，胡僧肠浣水生光。\n两朝人物空冥寞，百代风流竞淼茫。\n松骨倚天增老气，溪毛著水渡微香。\n鸦啼鹊噪秋风外，千丈藤萝挂夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5972,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过安仁县权令主簿同蔡尉见访二首 其一","author":"孙觌","text":"莽莽缠兵气，蓬茅庇一邱。\n尚看蒙赤帻，不复卧黄紬。\n抱牍杭凫鹜，徵租聚沐猴。\n黄昏更萧瑟，风雨啸鸺鹠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5973,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过安仁县权令主簿同蔡尉见访二首 其二","author":"孙觌","text":"投老一浮萍，长亭复短亭。\n谁怜仙客去，自有故人经。\n世乱眉多赤，情高眼独青。\n临分听苦语，令我醉时醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5974,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿临川村舍","author":"孙觌","text":"林壑已秋声，凉蝉又一鸣。\n人间多古意，地僻有微行。\n身老殊方去，愁牵百虑生。\n途人夜相语，豺虎正纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5975,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题临川孝义寺壁二首 其一","author":"孙觌","text":"秋风袅袅转庭梧，客梦初惊一鸟呼。\n拣尽寒枝栖不稳，独行残夜影同孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5976,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题临川孝义寺壁二首 其二","author":"孙觌","text":"孤城吹角五更风，笑语团圞一梦中。\n战格连云家万里，书凭黄犬若为通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5977,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"疏山寺次白文林韵三首 其一","author":"孙觌","text":"翠干轩轩迥出林，夜风吹籁紫箫音。\n老龙头角云霄近，玄豹文章雾雨深。\n末路浮荣炊剑首，半生遗恨寄琴心。\n愁吟独溅花前泪，故国山河百战侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5978,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"疏山寺次白文林韵三首 其二","author":"孙觌","text":"藜杖匆匆集晚林，长廊破壁撼钟音。\n天涯流落相逢地，杯酒殷勤莫厌深。\n万里功名飞燕颔，千金博饮炙牛心。\n更闻好句惊人倒，一洗蛮烟瘴雾侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5979,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"疏山寺次白文林韵三首 其三","author":"孙觌","text":"黄花翠竹小丛林，卧听南山白石音。\n蚁斗已空遗垤在，蜗跧终恋故庐深。\n掀髯一笑追前谬，礼足同参看此心。\n且向疏山结香火，人生莫受二毛侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5980,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"疏山长老善清日诵楞严维摩二经赋小诗二首示之 其一","author":"孙觌","text":"尘涨迷三鹿，桑枯厌八蚕。\n徵心浑不见，问疾有谁堪。\n坐待成风斲，应须立雪参。\n钦闻第一义，细说后三三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5981,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"疏山长老善清日诵楞严维摩二经赋小诗二首示之 其二","author":"孙觌","text":"弹指三生过，伤心一念差。\n试标天上月，为种火中花。\n粗识禅为味，初欣道有牙。\n老师一笑许，千劫误蒸砂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5982,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明水寺五代末危全讽据临川时所建画像至今存焉寺旁最高峰有祠屋一区道士居之二首 其一","author":"孙觌","text":"台殿何年有，千岩紫翠间。\n金仙佛世界，羽客道家山。\n骨朽馀三窟，皮存尚一斑。\n伤心千古泪，相见雨潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5983,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明水寺五代末危全讽据临川时所建画像至今存焉寺旁最高峰有祠屋一区道士居之二首 其二","author":"孙觌","text":"愁坐猿啼里，行吟度鸟间。\n翠凋巾上发，红破镜中颜。\n老去经三折，真游付八还。\n无心自来往，空羡白云闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5984,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"崇仁县","author":"孙觌","text":"万山攒拥天一笠，北风吹雨两鬓湿。\n饥乌绝叫护巢飞，老蛟怒起拿云立。\n孤城短日砧杵急，骑驴渺渺冲泥入。\n桑枝倒折机杼空，道旁废井无人汲。\n遗民到今传旧邑，击水华鲸浪三级。\n故物漂流百战馀，客子起坐万感集。\n小驿香醪如雪汁，一杯快作长虹吸。\n酒醒寂历照短檠，幽咽数声邻妇泣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5985,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余南迁次临川奏庐陵道属闻盗掠高安新淦之间少留仙游山道祠是时庭下木犀花盛开漫山皆大松一峰苍然终日游愒其下各赋诗一篇 其一","author":"孙觌","text":"檐牙啄林杪，华殿浮青红。\n天风吹泬寥，万籁酣笙镛。\n木犀已著花，濯濯秋雨中。\n赪姿出素面，一洗丹粉空。\n幽香袭巾袂，冷艳栖房栊。\n迫此芳岁残，一笑谁当供。\n群仙立通明，矫矫骖鸾龙。\n相随归阆苑，遗恨寄西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5986,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余南迁次临川奏庐陵道属闻盗掠高安新淦之间少留仙游山道祠是时庭下木犀花盛开漫山皆大松一峰苍然终日游愒其下各赋诗一篇 其二","author":"孙觌","text":"历历水中榆，地远连玉京。\n抡材上华屋，袅袅黄金茎。\n苍官表独立，垂胡交缦缨。\n根深崖峤壮，势压山岳倾。\n万牛挽不回，老气空峥嵘。\n夜半风雨会，岁晚龙蛇升。\n我来不忍去，绕树三匝行。\n珍重金石交，待我烹茯苓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5987,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"遣兴","author":"孙觌","text":"乱后煎百虑，老去无一欣。\n故人尺书至，好语中夜闻。\n坐久百虫绝，开帘月纷纷。\n长歌又一醉，酒醒击空尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5988,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题华盖仙亭大松示柳道士","author":"孙觌","text":"系舟古巴江，曳杖真仙亭。\n金舆簇画戟，玉几罗翠屏。\n堂堂十八公，独立霜中英。\n魁然十围大，荫此一盖青。\n翘翘云物外，坐阅秋蒂零。\n道人依茅栋，蕙帐凄芳馨。\n苓龟傥可见，长镵斸青冥。\n一食浣我肠，败履插修翎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5989,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仙游山九日叹逝二首 其一","author":"孙觌","text":"伤心玉案两眉齐，永负黄花九日期。\n万里炎州嗟我老，百年青泪向君垂。\n俱飞蛱蝶愁看汝，醉把茱萸欲对谁。\n独立西风搔短发，一生遗恨一愁悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5990,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仙游山九日叹逝二首 其二","author":"孙觌","text":"割肉早归三伏日，传柑赐饮上元灯。\n那知一恸殊方去，独向高台此日登。\n泪湿西风生眼缬，梦回残夜起衣棱。\n孤鸾别鹄知何处，泉路茫茫唤不应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5991,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"达臣议承饷石耳","author":"孙觌","text":"穷秋客舍风雨凄，破釜生鱼甑有衣。\n故侯未种东陵瓜，饿夫欲采西山薇。\n岁晚黄精可疗饥，故园万里天一涯。\n未辨登山拾瑶草，且复从公茹石芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5992,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山行憩田舍老父出迎以黄柑白酒为饷","author":"孙觌","text":"藜杖扶来雪满簪，谆谆好语意深深。\n酒倾白堕杯行玉，橘破黄苞坐饤金。\n醉起莫辞田父肘，甘馀须识野人心。\n匆匆不尽遮留意，挽袖丁宁更一临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5993,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"两日复往次前韵","author":"孙觌","text":"寒蔬离离银线乱，冻醴滟滟玉井深。\n坐看庭松翘翠盖，行穿野菊布黄金。\n犬迎客入喜见尾，鹊随人语欣会心。\n俗里淹留怕轑釜，驱儿招唤得重临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5994,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曹山寺","author":"孙觌","text":"石栈梯空一线横，路穷台殿两峥嵘。\n日光澹澹鸟飞没，云气茫茫龙随行。\n道人西归馀只履，结茅宴坐千岩底。\n草根沥沥暗泉鸣，树外腾腾青瘴起。\n翠竹掩冉苍云屯，老藤蔽亏白昼昏。\n天低尺五雷雨上，身强丈六祖佛尊。\n我老栖栖厌行旅，逢人欲问前三语。\n不见高僧锡杖飞，山下空留千斛乳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5995,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠曹山长老了如","author":"孙觌","text":"一念挂世网，平生误儒冠。\n笑看蝇穴纸，坐待鲇缘竿。\n薨薨醯酱瓿，岂识天壤宽。\n老如本逢掖，诗肩尚儒酸。\n久缠冠盖蔓，忽作泡影观。\n堂堂人天师，三世一指弹。\n身闲云月出，骨老霜松寒。\n我生饱忧患，将心觅人安。\n目击有妙寄，语乐非世欢。\n坐稳且复留，火芋分懒残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5996,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧妙鉴住广寿寺","author":"孙觌","text":"明月不可呼，清夜时一出。\n孤光挂海涯，皎皎转空碧。\n道人一茅把，坐睨九年壁。\n磨砖破缠缚，骤若老骥逸。\n匆匆林下逢，怅望不暖席。\n锡杖已凌空，阶庭草如积。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5997,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明水逵老以黄甘荔子土芋为饷小诗答谢","author":"孙觌","text":"客居莽牢落，幽绝无四邻。\n岁穷有衣结，日晏犹甑尘。\n偪仄戎马间，敢厌薪水勤。\n故人情义重，采采青泥芹。\n小摘持寄远，分馀为情亲。\n丹荔擘轻圆，黄柑破芳辛。\n蹲鸱劝加餐，风味亦可人。\n渺渺山涧曲，浩浩水云晨。\n踞垆有前诺，两翁对然薪。\n眼缬眩红绿，共此无边春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5998,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王子钦立春二首 其一","author":"孙觌","text":"玉手传丝催岁换，金刀剪綵伴春回。\n兵戈满眼年年在，花鸟惊心日日来。\n芳意渐还三径草，暗香犹认两京梅。\n呼童火急供春事，冻醴生光滟玉醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":5999,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王子钦立春二首 其二","author":"孙觌","text":"岁晚惊呼身已老，天涯流落首空回。\n便将酒力推愁去，且放春光入眼来。\n人语嘻嘻争斗草，宫花闪闪艳妆梅。\n雪消水暖春江动，绿涨葡萄万斛醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":6000,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]