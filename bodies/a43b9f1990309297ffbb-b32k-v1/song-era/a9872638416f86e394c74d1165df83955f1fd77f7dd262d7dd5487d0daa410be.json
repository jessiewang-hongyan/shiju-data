[{"title":"醉落魄/一斛珠 其一","author":"沈瀛","text":"野庵鼓吹。\n翻腾似与寻常异。\n笙箫筝笛皆非是。\n今日头场，看取些儿戏。\n心中无事无萦系。\n村歌数首新来制。\n参禅渐渐知滋味。\n细语粗言，俱是第一义。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉落魄/一斛珠 其三","author":"沈瀛","text":"致知格物。\n初学工夫参圣域。\n天高地远无穷极。\n欲造精微，莫若守惟一。\n纯全天理明如日。\n都缘人欲来相惑。\n且将持敬为先入。\n若能持敬，真个是神力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉落魄/一斛珠 其四","author":"沈瀛","text":"致知格物。\n孔颜学问从兹出。\n圣言句句皆真实。\n涵养功深，将见自家得。\n毋意毋我毋固必。\n视听言动非礼勿。\n胜己之私之谓克。\n克尽私心，天理甚明白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉落魄/一斛珠 其二","author":"沈瀛","text":"时光盛逼。\n杯盘渐渐来收拾。\n主人便欲留连客。\n末后殷勤，一著怎生得。\n来时便有归时刻。\n归时便是来时迹。\n世间万事曾经历。\n只看如今，无不散筵席。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"为向子諲写卦影并题","author":"狄称","text":"水畔幡竿险，分符得异恩。\n潮回波似镜，聊以寄君身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登楼三首 其二","author":"狄遵度","text":"群山南走失所往，百川东逝兹其穷。\n天低水国疑将压，人过月塘愁欲空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和涣之深秋月夜书事","author":"狄遵度","text":"洞庭叶下凉飕飕，冻天顽白凝不流。\n圆月拟缺不忍缺，轻露欲浮终未浮。\n忆吹朱籁凤軿上，更采紫芝云峤陬。\n玉楼天半几千尺，珠树玲珑悬上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"佳城篇","author":"狄遵度","text":"佳城郁郁颓寒烟，孤雏乳兔号荒阡。\n夜卧北斗寒挂枕，木落霜拱雁连天。\n浮云西去伴落日，行客东尽随长川。\n乾坤未死吾尚在，肯与蟪蛄论大年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏芭蕉","author":"狄遵度","text":"植蕉低檐前，双丛对含雨。\n叶间求丹心，一日视百腑。\n胸中数寸赤，不惜为君吐。\n心尽腹亦空，况复霜雪苦。\n非无后凋意，柔脆不足禦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨","author":"狄遵度","text":"高林风怒雨声黑，小阁灯背人语阑。\n谁知云外月高照，定是叶间莺最寒。\n时觉急飘愁未已，似闻徐滴喜初翻。\n骊驹北首榆关路，天晴烟树沙碛宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"看白云爱而成诗","author":"狄遵度","text":"秋风吹白云，触处自何谷。\n初犹半洞门，欻出遍岩腹。\n零落依水湄，片段挂枯木。\n馀影透微白，灭迹混空绿。\n烟萝自蘙密，岛溆徒萦曲。\n安知苍梧野，下覆猿鸟哭。\n谁能久徘徊，返顾视黄鹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒孔先生","author":"韩维","text":"月出高树枝，影动酒樽处。\n树深月色薄，稍以灯火助。\n主人喜我过，斟酌亦云屡。\n于时幸无累，所谈非近务。\n凉风自远生，清景澹吾虑。\n方期西山秋，历览陪杖屦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登楼三首 其三","author":"狄遵度","text":"莎青石细浅见底，天空云淡无一毫。\n波间圆月照不动，海上清风来最高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登楼三首 其一","author":"狄遵度","text":"道之不行乘桴浮，赴河蹈海成今游。\n春归应到岭北树，日出先照天南楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"狄燠","text":"翠色折不尽，离亭生更多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊舟有怀","author":"上官良史","text":"渺渺复迢迢，枫林带柞桥。\n沙寒初上月，浦暗已回潮。\n霜苇多先折，江花或后凋。\n今宵何处雁，相伴宿兰桡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题莺花亭","author":"芮烨","text":"人言多技亦多穷，随意文章要底工。\n淮海秦郎天下士，一生怀抱百忧中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠陈少微","author":"芮烨","text":"原思非病贫何患，回也虽贫乐有加。\n岁晚与谁同此味，梅花深处是君家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东林寺","author":"芮烨","text":"脩竹长林罗水车，梵王家近葛仙宫。\n耳闻清磬是非静，心领菩提名利空。\n啖枣尚知前世事，拈花还遇上机翁。\n抽簪若得烧丹诀，莫负扶桑半夜红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罗浮宝积寺","author":"芮烨","text":"木落天寒山气沈，年华客意共萧森。\n偶于佳处发深省，其实宦游非本心。\n红日坐移钟阁影，白云闲度石楼阴。\n还家莫话神仙事，老不宽人雪满簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"从沈文伯乞娑罗树碑","author":"芮烨","text":"楚州淮阴娑罗树，霜露荣悴今何如。\n能令草木死不朽，当时为有北海书。\n荒碑雨侵涩苔藓，尚想墨本传东吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇","author":"芮烨","text":"化工着意，向柳稍梅萼，偷回春色。\n蓂叶双飞政天上，一点文星初谪。\n发藻儒林，当年荣耀，四海声名白。\n谪仙飞貌，澹然物外踪迹。\n且与笑傲瀛洲，风流词翰，自是西垣客。\n异日功成辞富贵，却与赤松游剧。\n一曲清歌，三千珠履，不愧非潘璧。\n满斟芳醑，仰称遐寿千百。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"芮烨","text":"宁令汉社稷，变作莽乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"芮烨","text":"今日桐城王刺史，异时遗爱在吾州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"芮烨","text":"今作尘埃奔走人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮","author":"芮辉","text":"晴云低蘸湖光湿。\n新凉远带江声入。\n风影逼中秋。\n移樽月在楼。\n蓝田栽竹手。\n借竹为君寿。\n苍翠一年年。\n长承雨露边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"持宪节登戴溪亭赋诗","author":"芮煇","text":"溪山之兴无时尽，兴尽名亭意可知。\n出岫孤云含细雨，投林宿鸟爱深枝。\n风流已是千年事，公案今成七字诗。\n短棹悠然随所适，人生出处要如斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中山即事","author":"芮毓","text":"几年压尘嚣，屡欲返初服。\n鹪鹩安一枝，何必恋微禄。\n潇洒此村居，茅舍带修竹。\n田园薄有收，积书高过屋。\n所以课子孙，利用聚吾族。\n光大不可期，庶几守耕读。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南乡子","author":"花仲胤","text":"顿首起情人。\n即日恭维问好音。\n接得彩笺词一首，堪惊。\n题起词名恨转生。\n展转意多情。\n寄与音书不志诚。\n不写伊川题尹字，无心。\n料想伊家不要人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名 答外","author":"花仲胤妻","text":"奴启情人勿见罪。\n闲将小书作尹字。\n情人不解其中意。\n问伊间别几多时。\n身边少个人儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伊川令/伊州令 寄外","author":"花仲胤妻","text":"西风昨夜穿帘幕。\n闺院添消索。\n最是梧桐零落。\n迤逦秋光过却。\n人情音信难托。\n鱼雁成耽阁。\n教奴独自守空房，泪珠与、灯花共落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南柯子/南歌子","author":"苏十能","text":"江水粼粼碧，云山叠叠奇。\n平生心事一钩丝。\n便是壶中日月、更何疑。\n文叔今方贵，君房素自痴。\n洛阳尘土涴人衣。\n争似归来双足、踏涟漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤翀峰","author":"苏大璋","text":"早起联镳上翠微，瞰虚历级步嵚?。\n昔闻华顶莲生藕，今见南山菊满篱。\n纵眼横看天地阔，壮怀唯有鬼神知。\n安期引我丹霄路，十里云烟特地披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"飞龙宴","author":"苏小娘","text":"炎炎暑气时，流光闪烁，闲扃深院。\n水阁凉亭，半开帘幕遥观。\n灼灼榴花吐艳。\n细雨洒、小荷香浅。\n树影竹影，清凉潇洒，枕簟摇纨扇。\n堪叹浮世忙如箭。\n对良辰欢乐，莫辞频劝。\n遇酒逢歌，恣情遂意迷恋。\n须信人生聚散。\n奈区区、利牵名绊。\n少年未倦。\n良天皓月金尊满。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵院判","author":"苏小娟","text":"君住襄阳妾住吴，无情人寄有情书。\n当年若也来相访，还有于潜官绢无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"邵武作","author":"苏为","text":"爱重八九月，登高上下楼。\n林红云白处，寒濑泊渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泛宛溪至敬亭","author":"苏为","text":"南国初寒候，扁舟远客心。\n归人出断岸，晚翼会疏林。\n渔市临官道，丛祠蔽木阴。\n长年多感慨，况此对分襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张无梦归天台","author":"苏为","text":"彤庭留不住，归忆旧山频。\n世路都无念，心源养得真。\n琼台栖树石，碧落应星辰。\n几话蟠桃熟，樽前醉过春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖州作","author":"苏为","text":"野艇闲撑处，湖天景亦微。\n春波无限绿，白鸟自由飞。\n柳色浓垂岸，山光冷照衣。\n时携一壶酒，恋到晚凉归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"化成圩","author":"苏为","text":"下田怜沮泽，环堤圪成雉。\n尧汤水旱时，蓄泄得专利。\n泥资数斗沃，堨谢千金贵。\n何物代天工，嘉此老农智。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东池诗","author":"苏为","text":"谢塘疏凿时，沧洲聊可拟。\n高有智者情，淡如君子旨。\n秋光夜初永，渔唱幽宜起。\n白鹭闲不惊，圆荷翠相倚。\n宛然江上色，孰为嚣尘里。\n待月泛潺湲，观鱼戏清泚。\n楼阴仰窗岫，阁影明霞绮。\n预想及瓜时，恋恋诚无已。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宛溪","author":"苏为","text":"源分春谷边，来此自溪徼。\n雪冻汎其流，漱玉鸣于沼。\n晴光荡霞影，白浪浮天杪。\n水木助清翠，景物随昏晓。\n汀沙翠荇长，酒市青旗小。\n凭槛立津亭，归心逐飞鸟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣城花","author":"苏为","text":"宣城花叠嶂，楼前簇绮霞。\n若非翠露陶潜柳，即是红藏小谢家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昭亭山","author":"苏为","text":"昭亭载严祠，休祐穰穰布。\n森罗绝涧松，盘屈中阿路。\n凝眸盼平野，彷佛披寒雾。\n水远露微阳，山明照红树。\n数尺渔艇归，几点秋鸿度。\n唯思圜室静，更祷馀粮富。\n天末望白云，帝乡深所慕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"苏为","text":"夜浪珠还浦，春泥象印踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还张德远书币题诗蔬圃壁间","author":"苏云卿","text":"多年别作一番风，谁料声名达帝聪。\n自有时人求富贵，莫将富贵污苏公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游齐山寺","author":"苏元鼎","text":"秋浦齐山寺，峰峦楚楚长。\n岩根堆雁塔，溪角架虹梁。\n雨过闻幽磬，云开见上方。\n苔侵石磴滑，花拥洞门香。\n禅客探玄切，骚人觅句忙。\n汲泉寒井废，观郡古楼荒。\n白鸟巢危树，孤猿叫断冈。\n碑珉黄阁相，诗板紫薇郎。\n踪迹依稀在，文章大半亡。\n登临正吟赏，惆怅见斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚","author":"苏敖","text":"芳草莫寻游处迹，好花空认折残枝。\n啼莺似怨归何速，舞蝶应怜出太迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万年欢","author":"苏氏","text":"日暖霜红，画戟门开，锦筵歌振梁尘。\n正是慈闱熙熙，庆诞佳辰。\n象服鱼轩灿烂，喜高年、福禄长新。\n承颜处，朱紫相将，更兼华胄诜诜。\n家声未论王谢，有禁中颇牧，江左机云。\n雁字鸳行，雍容高步金门。\n况有子孙侍列，拥阶庭、玉洁兰薰。\n持芳醑，满酌瑶觞，竞祝遐寿千春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"更漏子 寄季玉妹","author":"苏氏","text":"小阑干，深院宇。\n依旧当时别处。\n朱户锁，玉楼空。\n一帘霜日红。\n弄珠江，何处是，望断碧云无际。\n凝泪眼，出重城。\n隔溪羌笛声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 立春寄季顺妹","author":"苏氏","text":"一夜东风穿绣户，融融暖应佳时。\n春来何处最先知。\n平明堤上柳。\n染遍郁金枝。\n姊妹嬉游时节近，今朝应怨来迟。\n凭谁说与到家期。\n玉钗头上胜，留待远人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹊桥仙 寄季顺妹","author":"苏氏","text":"星移斗转，玉蟾西下，渐觉东郊向晓。\n马嘶人语隔霜林，望千里、长安古道。\n珠宫姊妹，相逢方信，别后十分瘦了。\n上林归去正花时，争奈向、花前又老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏莎行 寄姊妹","author":"苏氏","text":"孤馆深沈，晓寒天气。\n解鞍独自阑干倚。\n暗香浮动月黄昏，落梅风送沾衣袂。\n待写红笺，凭谁与寄。\n先教觅取嬉游地。\n到家正是早春时，小桃花下拼沈醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题惠山翠麓亭","author":"苏台父","text":"山势丛丛向北盘，高僧平日为开轩。\n莫嫌长有车马到，真爱都无鸟雀喧。\n剩长松篁留日脚，少移桃杏破云根。\n十年往返未曾厌，煮茗尝泉到酒樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇","author":"苏仲及","text":"问梅何事，对岩东微笑，暗中轻馥。\n韵绝姿高直下视，红紫端如童仆。\n绕树千回，临风三嗅，待与论心曲。\n何人还解，为伊特地青目。\n潇洒些个精神，谁怜孤瘦，正无语幽独。\n不许春知应自负，一生风月心足。\n傲雪难陪，欺霜无伴，耿耿横修竹。\n纷纷桃李，□□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"蔡仲昌","text":"高城倒影下无地，秋水涵空长有天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和高斯立见寄","author":"苏竹里","text":"少年浩荡子长游，回首人间道路修。\n纳纳乾坤日西下，悠悠江汉水东流。\n如知往事皤青鬓，应把华年伴白鸥。\n惆怅半生飞动意，看人骑马觅封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"苏迈","text":"叶随流水归何处，牛带寒鸦过晚村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"苏迈","text":"熟颗无风时自落，半腮迎日斗鲜红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书不欺室","author":"王十朋","text":"室明室暗两何疑，方寸长存不可欺。\n勿谓天高鬼神远，要须先畏自家知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题金相寺三首 其三","author":"苏坚","text":"隐约开旸谷，坐看云气升。\n地神如献秀，一色露山棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题金相寺三首 其二","author":"苏坚","text":"已爱观音远俗尘，鹫峰林壑更清新。\n不辞遍历安禅地，要使溪山识主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题金相寺三首 其一","author":"苏坚","text":"丈室十一尺，闽山数百层。\n春风近梅柳，腊水漫沟塍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后清江曲 其一","author":"苏庠","text":"层波渺渺山苍苍，轻霜陨木莲叶黄。\n呼儿极浦下笭箵，社瓮欲熟浮蛆香。\n轻蓑淅沥鸣秋雨，日暮乘流自相语。\n一笛清风万事休，白鸟翩翩落烟渚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重过石井","author":"苏坚","text":"登临萧寺几回头，石怪林深山自秋。\n地布黄金长照日，泉溜碧玉暗通沟。\n浚穿地脉疑无底，静啮崖根更不流。\n多谢老僧勤供佛，井华晓汲注瓷瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"苏寿","text":"戴笠披蓑军十万，饥嗔饱喜客三千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"苏寿","text":"却因贾赞善，来作歙知州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和雷壑先生韵","author":"苏寿元","text":"青紫过如拾芥轻，今吾非辱故非荣。\n海波忽与桑田改，书眼空如秋月明。\n只可一丘容鹤隐，何须万里较鹏程。\n到头更要深山住，不作终南捷径名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水退","author":"苏寿元","text":"转眼江流已昨非，便随鸥鹭省渔矶。\n飞花无复浪千顷，倒影依然山四围。\n不向静中观物理，更于何处觅天机。\n兴来倚杖斜阳外，弄遍潺湲未肯归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]