[{"title":"题延平剑归阁","author":"陈宓","text":"晋代难为用，翻藏此水涯。\n在天犹有赫，镇地永无邪。\n雨过疑留迹，风飞去莫遮。\n谁云寒濑底，折戟伴沈沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题西淙","author":"陈宓","text":"当年巨刃劈崖开，便拥双虬海上来。\n旧迹几年甘隐雾，新名一日怕惊雷。\n池边有地惟生茝，石上无泥更植梅。\n酷似庐山难忘处，卧龙白鹿勘书台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题妙寂寺 其一","author":"陈宓","text":"四绕青峦峻，西东碧浪扬。\n孤忠招宝翰，正色著祠堂。\n孰继功言盛，空嗟草木长。\n蓼莪时一诵，洒泣泪千行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题妙寂寺 其二","author":"陈宓","text":"百代公师墓，千年妙应林。\n香随清昼永，山泣晚秋深。\n列桂团风露，高松耐古今。\n过墙深夜月，触目倍伤心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题妙寂寺 其三","author":"陈宓","text":"寺古静还僻，小窗幽更深。\n观时知句眼，读易见天心。\n霜露宵增感，烟云晓见侵。\n独坐思往昔，愁绝泪盈襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题妙寂僧无碍端砚","author":"陈宓","text":"紫润携来惬性情，蓝田空负价连城。\n挥残老兔犹能健，研尽轻螺未觉声。\n渊底取归龙想睡，岩心凿破地须惊。\n我无才思长怀抱，元气何年结得成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题林氏读书堂","author":"陈宓","text":"四壁无尘坐绛帷，邻家清晓听唔咿。\n圣贤凛凛长相面，爵禄骎骎讵可辞。\n问字有人携酒款，诵经终岁不园窥。\n我来自恨相逢晚，嗣此敲门惬所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题剑滩","author":"陈宓","text":"山在溪中水在山，人生何处鬼门关。\n数声柔橹风雷外，一叶轻舟剑戟间。\n为问片时惊陷溺，何如竟日缓跻攀。\n信知行险非天命，垣道从来绝后艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题南康戏綵堂","author":"陈宓","text":"织女支机石，云根几许深。\n月明偏得照，烟暝杳难寻。\n戏綵留奇迹，重题愧夙心。\n长年过半百，摹刻愧知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题致爽亭","author":"陈宓","text":"山水围中宅一区，小亭花柳足康娱。\n勾牵诗思千篇有，斗擞征尘一点无。\n秉烛风檐费遮逻，闭窗云雾巧窥?。\n凭谁起唤王摩诘，写作渊明归去图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题高将仕墨梅","author":"陈宓","text":"露零难辨蕊，月满祇寻香。\n不受丹青涴，仍当云水乡。\n诗清见和靖，笔妙得高郎。\n当暑开霜素，萧然六月凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题野亭","author":"陈宓","text":"向晚风光分外新，野亭高处最撩人。\n绸缪翠袖分还合，委曲寒波去转亲。\n小艇时过明镜里，危栏独倚画图身。\n公馀对此长怀愧，检点胸中未洗尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题喻景山大飞书房","author":"陈宓","text":"仙溪七十里，半世祇闻名。\n一日见山色，千年怀友情。\n古匏浮美醁，清水照尘缨。\n霜月亭亭白，连床语到明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题新创南楼榜曰宽闲","author":"陈宓","text":"楼高二丈只三间，四面平畴绕海山。\n白水青秧开净练，碧峦苍巘拥妆鬟。\n静中始觉乾坤大，老去唯思岁月悭。\n但愿心田如此阔，一生到了得清閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠丘汉叔","author":"陈宓","text":"自昔经明岱岳间，于今君独得渊源。\n力扶正学人知惧，拨去浮言道自存。\n讲贯一堂常夺席，异同诸子谩专门。\n怀奇莫叹无知己，会见经帏待讨论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠林尹仲","author":"陈宓","text":"八年前会晤，犹忆刺桐乡。\n君眼虽非白，吾颜已过苍。\n有求皆妄想，无欲是良方。\n不学神仙术，他时共一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠翁子西","author":"陈宓","text":"先生道古背今驰，羁丱诗书两鬓丝。\n进取不随馀子后，文章曾作几人师。\n未施天上经纶手，且放胸中玉佩词。\n三复荔台佳句法，千年风雅有谁追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠梁运属","author":"陈宓","text":"萱堂处处尽阳春，二月严霜凛独陈。\n六载侍旁勤奉养，五年居外备艰屯。\n嗟君不愧曾参孝，愧我殊无考叔纯。\n齐与楚咻虽众胜，会看至行感苍旻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邀同社十七人游灵岩天台次前韵呈潘刘","author":"陈宓","text":"凌晨避暑作清游，烈日方中?玉楼。\n石刻俨如元祐日，榜题犹带有唐秋。\n二三弟侄皆同志，十一宾朋尽胜流。\n共侍潘刘两夫子，夕阳归路语难休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寿外舅龚通判","author":"陈宓","text":"毓秀方壶应半千，先春二日秩初筵。\n澄陂万顷难同量，野鹤高标不计年。\n楚国洁清真有继，石君孝谨更光前。\n久期卓令三公秩，尚借陈蕃别驾贤。\n纷若尽随春卉媚，恬然独与雪筠坚。\n鄙人辱眷尤钦佩，拜寿裁诗佐玉船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和柯东海游安溪清水岩韵","author":"陈宓","text":"飞溜无时断，行云一日停。\n半年嗟苦雨，三度扣禅扃。\n岩岫方从认，松篁恰得醒。\n草花多掩敛，岸竹半伶俜。\n舟子应频唤，山农讶屡经。\n溅衣黄土重，侵屦碧泉泠。\n溪合高低白，林迷上下青。\n乍褰绵作障，重展玉为屏。\n古佛灵如在，微官德岂馨。\n心悬炷香案，容肃换衣亭。\n晚照催归骑，清风惜暑棂。\n凭高闲一顾，人世是浮萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁巳调选","author":"陈宓","text":"人生四十方强仕，一调十年能几回。\n蝉冕未加头蚤累，诗成水上见风行。\n笔端万类因陵暴，世态浮云任变更。\n且尽花前一樽酒，何须身后五言声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日登安溪凤山","author":"陈宓","text":"凤凰天上远来翔，好看连天碧玉绦。\n不学无才空老大，逢辰有客尽英豪。\n痴人台峻争驰马，我辈身轻一似猱。\n笑倚西风倾菊酒，醉归稳跨贯山鳌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八三侄借半山诗因以示之","author":"陈宓","text":"我读半山诗，瞠乎不可及。\n风骚融老腹，取次有掇拾。\n清放太白章，悲壮杜陵集。\n争雄而竞秀，鼎峙高嶪岌。\n譬将云作锦，绚烂那得袭。\n又如月长新，纤圿不可入。\n山川谢佳丽，风雷怯呼吸。\n想当下笔时，会见真宰泣。\n惜哉有此奇，孔室未许入。\n当时死翰死，颜孟庶并立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三山送楼干","author":"陈宓","text":"九仙山头二月春，百花璀璀凝芳辰。\n看花未省并骢马，酌酒况复违佳人。\n人人家在赤城里，五百大士疑前身。\n襟怀喜作冰玉相，耳目不染声色尘。\n鲸呿鳌掷擅文杰，撑腹万卷笔有神。\n妙龄卓冠兰宫士，便合褰裳要路津。\n玉堂三事久虚职，宪幕两载留南闽。\n平生避名如避寇，诸公讵肯遗奇珍。\n显亲急欲贲泉壤，襆被路马趋严宸。\n囊中之方久不试，小试疲瘵苏斯民。\n自惭草木非君味，倾盖一见情何亲。\n金篦时为发膜翳，淡交耐久如荀陈。\n悬知后会近可卜，暂时分披仍逡巡。\n丈夫万里耿相望，所要守道全其真。\n准拟千钟浇此恨，却恐烂醉污车茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月游延平溪源","author":"陈宓","text":"溪源数里近，半载始能之。\n鸑鷟一峰耸，相参如有期。\n昔人卓庵地，惜不谭伫尼。\n我与五士游，正值暮春时。\n脩梁四三所，尽得庐阜奇。\n清波映文石，珠玉光陆离。\n贪者反不顾，留为贫窭资。\n飞雪涌千石，宁为寒暑移。\n触热褦襶子，岂知世有斯。\n题名峻壁间，用惬异日思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上巳日游延平脩禊洞","author":"陈宓","text":"延平山水窟，平生涉其粗。\n距城五十里，岩壑难具模。\n崔嵬通上界，突兀动地枢。\n泉石自撞击，钧天恐难如。\n或若轰雷霆，或若唾珠玑。\n飞瀑自天下，循涯作清渠。\n云是鬼神力，巧凿三丈馀。\n羽觞激如飞，聊助文字娱。\n崇山回环合，有洞容入居。\n觌面卓文笔，仰天真可书。\n幽花与脩竹，掩映释氏庐。\n同游皆胜士，适值暮春初。\n山阴未足数，直想风舞雩。\n岂无休沐日，复洗红尘裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与刘学录","author":"陈宓","text":"年来幸得奉仙翁，开口良辰一笑同。\n节物催人双鬓水，人生何必慕登瀛。\n三方翠巘天同色，四面黄云掌样平。\n更著回还如蒂白，殷红时暂惬秋容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丫头岩","author":"陈宓","text":"看尽行人两鬓秋，双鬟犹自结丫头。\n梳风栉雨常如沐，送往迎来不解愁。\n造物胚腪何日始，人间岁月谩川流。\n我行自役真堪笑，有此登临恨莫留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小园","author":"陈宓","text":"小园何事得佳名，环似莆溪一水清。\n帖帖飞鸢迷上下，翩翩游艇探空明。\n杯盘白处松生影，衣袂凉时竹有声。\n更约乘轩卫君子，安舆往来要将迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋前偶题 其三","author":"陈宓","text":"雨过云衣已半除，深渊绚烂剖骊珠。\n阴晴明日犹难料，未必中秋此夜如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋桐城观举子","author":"陈宓","text":"风前散袂能忘扇，月下题诗不用灯。\n万士清宵鏖棘庑，一年秋色满桐城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云台寺梅坡 其一","author":"陈宓","text":"不是骚人亲手栽，如何一一作诗媒。\n世间那用香如许，应有仙真夜往来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月六日雨","author":"陈宓","text":"山云乍展青油幕，檐雨齐神白玉簪。\n多谢天公办丰岁，野人先拟粟盈甔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月水益小园","author":"陈宓","text":"岿然俯溪亭，偃若与舟接。\n日涉有初心，风雨或阔蹑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"介亭","author":"陈宓","text":"春融四泽形如介，著我茅亭跨此间。\n纵使戴星朝玉阙，终输乘月看金澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤池桥成余长泰以诗贺次韵谢之","author":"陈宓","text":"骖鸾翼翼袅清风，眼见云霄有路通。\n自是众贤欣出力，何如小己敢贪功。\n指挥须得千人敌，迟速都申一念中。\n已筑新堤平似掌，登桥人与此橘同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤咮","author":"陈宓","text":"千年寒潭底，饱孕精钢秀。\n何人出黝玉，手触气如馏。\n健笔举龙文，清音鸣凤咮。\n坐使端歙产，瞠乎仞溪后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆饮井","author":"陈宓","text":"一泓渴济万夫焦，去作沧溟蚤暮潮。\n我欲结亭观远景，距城七里不为遥。\n疏泉凿石作洼池，乱石堆中竹最宜。\n风动琅玕和玉佩，个中律吕少人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王主簿右州某日思其归因见黄华动渊明之兴方欲寄诗忽承佳句次韵见意 其一","author":"陈宓","text":"梦魂何日不家山，底事淹留数月间。\n忽见黄华羞泛酒，渊明心事若相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"长夏叹","author":"陈宓","text":"六月不雨旸乌骄，飞蝗更剪深田苗。\n农夫抱衾覆一亩，背裂口焦如火烧。\n农夫农夫莫怨怒，更有无田可耕处。\n昨日长淮禾稻区，白骨成堆今莫数。\n金缯百万去安边，城壁不修唯坏垣。\n人言犬羊盟誓坚，我愿夏日长如年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东湖四咏 其四","author":"陈宓","text":"西山老禅叟，依厂安数椽。\n趺坐看东海，沧溟几桑田。\n前此复谁居，今踰三百年。\n钟鼓如一日，从教岁徂迁。\n人生苦浮脆，乃过金石坚。\n彼人尚能尔，况是古圣贤。\n石床对石室，静坐思悠然。\n相期在晚暮，用以补我愆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东湖四咏 其三","author":"陈宓","text":"我筑屋三间，在湖东南隅。\n上号曰宽閒，观耕风雨馀。\n下作小山房，可以读诗书。\n维南有松竹，轻阴绕室庐。\n维北有芰荷，浓绝涵窗虚。\n四壁何所有，经训揭砭愚。\n食息在耳目，日与圣贤居。\n园蔬尚可饱，老矣复何须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东湖四咏 其二","author":"陈宓","text":"胡公是吾友，千载不改节。\n长作松筠青，烟云任明灭。\n岧峣占南面，硉兀压城阙。\n西来群岫驰，尊敬不敢越。\n馀势抵东海，平夷复奇崛。\n陈岩亦加礼，北坐拱相谒。\n我楼于其中，往往愧时列。\n汲汲企前脩，庶几不见绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东湖四咏 其一","author":"陈宓","text":"我作城东湖，筑堤百馀丈。\n水深才四尺，岸曲八回往。\n中号小沧洲，拿舟径莲荡。\n回环即数里，渌作三江涨。\n集鹭绝惊猜，跳鱼时跌宕。\n栏外一峰奇，意重友人饷。\n月夕命客游，不更蓬莱访。\n秋凉但曝书，未许歌吹上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甘寝","author":"陈宓","text":"甘寝不易得，何人不贪睡。\n所以八尺床，惟贤始无愧。\n万钟固可乐，中夜或兴喟。\n谁谓颜巷贫，至宝赏所萃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白山茶杂花","author":"陈宓","text":"奇葩冬后蕊，羞涩见东风。\n不变冰霜操，从他百卉红。\n芍药包红锦，橘花烂明珠。\n不复忆海棠，飘零烟雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同师道弟奉亲游延平凤山","author":"陈宓","text":"我来一载强，再觌凤山面。\n时当秋末垂，群木尚葱倩。\n卓彼鸾停姿，清流洁于练。\n照影眩其仪，世治乃一见。\n伊予独何人，娄获遇奇盼。\n去年旱少收，田里多流转。\n今年虽得稔，旧恙复枝蔓。\n圣主肩有虞，斯瑞遂可援。\n却笑闽越氏，虽美谁与传。\n山势较奇崛，泉源费洿羡。\n坚松峻壁挂，暗溜阴崖溅。\n莎寒晚不彫，果异红堪恋。\n四围巧逻遮，千级窘攀缘。\n弟兄承板舆，向晚不知倦。\n诗成寄山中，聊用纪缱绻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同郑寺丞登西瀑","author":"陈宓","text":"绍年一联镳，作意到西瀑。\n是时新喜晴，峻壁漱清玉。\n雷霆骇神睹，冰瑩雪胸腹。\n临深足恐堕，坐石膝频促。\n晷长不知永，玩久愈未足。\n下山历斗潭，喧豗尚相逐。\n忽逾十五里，风雨送归躅。\n抵家如梦觉，始觉当暑溽。\n但愿身更强，后游多秉烛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安溪劝农诗 其二 劝贫富相资","author":"陈宓","text":"汗颜为令已三年，二税无因放汝钱。\n但愿人人知务本，他时莫忘劝农篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安溪劝农诗 其一 劝贫富相资","author":"陈宓","text":"举债当知济汝穷，取钱须念利难供。\n富人心要怜贫者，贫者身全仰富翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安溪劝农诗 劝耘苗","author":"陈宓","text":"力勤瘠地亦良田，丰歉由人莫问天。\n曝背耘苗能著力，天公毕竟也相怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安溪送泉倅","author":"陈宓","text":"平生顺天命，渴饮与饥饭。\n不能便利趋，俛首榷商贩。\n随群谒上官，言语但朴愿。\n岂知事迎合，宛转若藤蔓。\n秉心实无它，世俗乃憎怨。\n岂期筮仕初，邂逅适素愿。\n明公行都来，郡政毕已逮。\n不惟辱宽假，时亦蒙诱劝。\n王事有期程，后我念迟钝。\n公今趋天朝，尚我坐尘坌。\n感恩顾未报，送别益增恨。\n伟哉佐此邦，声名不前逊。\n专城亦数月，蒙福数十万。\n清介持一律，冰玉不可溷。\n从来士大夫，德劭才或困。\n岂如明公贤，全美难悉论。\n行看庙堂上，相先以名献。\n斐然作诗歌，聊写意缱绻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮","author":"陈宓","text":"我有数顷田，读书尽岁暮。\n苟无饥渴态，不必羡华富。\n人生苦嗟卑，待日不可度。\n不思羲和车，去去岂反顾。\n闭门十年间，青云半尘土。\n光荣能几时，悔吝已莫数。\n所以五柳公，陶然乐贫窭。\n彼有五男儿，岂不后日虑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平次郑倅答田父词韵","author":"陈宓","text":"儿饥谁与哺，衣破谁与补。\n田家安乐时，尚有饥寒苦。\n况值久旱馀，十须逾缺五。\n加以疟鬼威，空庐倍贫窭。\n我适丁此时，期以报君父。\n人言灾害深，未知嗟近古。\n里闾十家聚，往往半理土。\n伊予忝刍牧，上恐负仁主。\n或妇失其夫，或子失其母。\n累累日就尽，公私窘捐瘠。\n此是政令乖，伊谁所自取。\n尝乞减十算，苍穹未蒙许。\n遂使强惭颜，缪称事摩抚。\n日冀天色寒，旧恙或可瘉。\n如何腊已至，未有雪花舞。\n明当自投劾，待罪听官府。\n赖有贤二车，殚心能活汝。\n万一得归田，终焉与樵侣。\n躬耕可足食，为酒祀考祖。\n庶几樗栎材，没齿远斤斧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平次赵纠曹韵十四首 其六 古香","author":"陈宓","text":"秋根托岩隈，静对意味长。\n春来长柔柯，无风自生香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平次赵纠曹韵十四首 其九 玉井","author":"陈宓","text":"登高摘水花，永怀唐儒宗。\n若识真古意，何须最高峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平次赵纠曹韵十四首 其五 经史阁","author":"陈宓","text":"小阁瞰清池，荷花镇长见。\n吏休苟得暇，只携书一卷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平次赵纠曹韵十四首 其十四 剑归","author":"陈宓","text":"神龙泽一世，岂但三尺用。\n清潭知几许，吞八九云梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平次赵纠曹韵十四首 其一 野亭","author":"陈宓","text":"春来一登眺，快见耕与桑。\n初冬拟丰乐，为酒升此堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延平次赵纠曹韵十四首 其四 尊贤堂","author":"陈宓","text":"山川秀而明，所居必名贤。\n主人虽凡骨，不慕衍客仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":17212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]