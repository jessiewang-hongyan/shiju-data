[{"title":"何参政挽歌三首 其一","author":"叶适","text":"退食勤稽古，当朝动引经。\n人心喜偏侧，国脉要匀亭。\n二府早闻政，三孤晚告灵。\n羔裘惜光彩，不肯到头厅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23261,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"何参政挽歌三首 其二","author":"叶适","text":"晞发沧浪上，滩声近广骚。\n绿围齐长柳，红糁半含桃。\n欲寡堪增寿，闲多更养高。\n佳哉凤皇垄，悲甚付乌号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23262,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余知府挽诗二首 其二","author":"叶适","text":"怜我抱空意，鬓间饶白丝。\n已从真率集，那复少年时。\n柳糁春前叶，松锼雪后枝。\n建炎无故老，难话省方悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23263,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余知府挽诗二首 其一","author":"叶适","text":"寿者福之首，中兼典郡来。\n圣知天上事，磨尽世间材。\n此际灵龟往，何方化鹤回。\n所亲都不恨，有识自兴哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23264,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"县尉林公挽词","author":"叶适","text":"恨取一官晚，公人未展衙。\n空传读书苦，留与后生誇。\n有子联三俊，成名王两家。\n会须酬贵骨，野燎报宣麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23265,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴参议挽歌词","author":"叶适","text":"冉冉试百巧，栖栖终一丘。\n死期甘恸哭，时事不胜忧。\n贫只藏书在，恩将别业酬。\n看君用意绝，身后令名留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23266,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孝宗皇帝挽词二首 其二","author":"叶适","text":"昔年叨上殿，叹息动宸襟。\n岂不人思奋，其如天意深。\n帝王犹遇合，南北限升沈。\n尚有登遐日，诸军特赐金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23267,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孝宗皇帝挽词二首 其一","author":"叶适","text":"俭德加文意，雄才自武宣。\n道终遗万乘，丧制尽三年。\n暂乞狂胡命，常持复汉权。\n全将一孝字，高谥百王前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23268,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宋仲方游吴袖文索诗为别","author":"叶适","text":"九曲弦歌满巷传，儒林声价有谁先。\n昔怜少学随翁久，今喜新文信汝贤。\n删后画前元未圣，南花北叶定谁妍。\n终期猛进一篙力，透过龙门急水船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23269,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张提举挽词","author":"叶适","text":"令祖亲扶日驭升，孙今喜复似翁清。\n恩波再入淮流满，信节初传岭外名。\n夏木千重添野趣，秋风三叠寄幽情。\n长年惯唱渔家曲，难听兹晨薤露声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23270,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李处士挽诗","author":"叶适","text":"忆吟诗句与君儿，曾说高宗涕自挥。\n两地兵休重富乐，百年家活共轻肥。\n多留萤火明书案，閒著渔蓑傍钓矶。\n身内巳无尘土僻，霜阡雪坞送将归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23271,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈侍郎挽词","author":"叶适","text":"生死悲欢地，长嗟付短吟。\n北门晨鹊趁，西甸晚鸦寻。\n三品官名重，千年墓色深。\n广东正思忆，泪激海潮音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23272,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陈益谦挽词","author":"叶适","text":"舍南巷北水同流，稻菽参差各自谋。\n不料多材能转物，更怜无地与伸头。\n蛛丝委架诗书愠，鹭羽空陂菡萏愁。\n好在夜深明月满，人间地下两悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23273,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王宗卿白兔诗","author":"叶适","text":"鸦带初阳照广津，兔随斜月满亏轮。\n瑞登韩笔名尤重，喜动欧吟事转神。\n不道奇毛妒霜雪，应知雅意合松椿。\n龟年鹤岁犹嫌少，献与尊堂别纪春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23274,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉送周知录木叔秘监其舅也","author":"叶适","text":"谢傅怅何远，羊甥良自嘉。\n帝乡沈迹显，囹户众缧誇。\n钓冷客星雪，林疏处士花。\n衰年怕分手，閒发岸头沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23275,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"林处士挽词","author":"叶适","text":"尚平接马弟，髣髴记前身。\n海阔元随浪，山高别领春。\n难招古渡外，空老夕阳滨。\n顺性无生灭，君应了正因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23276,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"林敬之挽词","author":"叶适","text":"杂遝新河市，酸寒处士庐。\n甘辞鲁穆馈，独著孟轲书。\n篱坏从儿补，禾荒付客锄。\n永嘉新有志，莫遣姓名疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23277,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"林签判挽诗","author":"叶适","text":"作邑有何好，利民翻害身。\n怕回湘水月，惊失象台春。\n墓草已多碧，园花空复新。\n更嫌莺自语，幽愤不胜陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23278,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"直院中书莫公殂往哀痛不能成文辄留小诗灵几并致鲈鱼金柑为奠","author":"叶适","text":"阁老今无地上身，黄麻紫诰两沉沦。\n虚悬东岭来时月，难挽西山去后春。\n试割冰鲈犹脆薄，重餐野橘尚甘辛。\n最怜赵子同心事，相看题封泪染茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23279,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"待制中书舍人陈公之亡以山宅须利既迁殡而未葬也后五月乃克葬焉二首 其一","author":"叶适","text":"可怕阴阳恶，还惊日月遒。\n终成埋璧去，不作坐禅留。\n雨洗一箪净，风翻千橘愁。\n门前系船橛，宿鸟漫啁啾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23280,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"施翔公掌教长沙","author":"叶适","text":"蓍蔡羲前识，箫韶舜后音。\n追回贾谊贬，唤起屈原沈。\n湘水汀烟阔，梅花署雪深。\n余行陈迹久，因子一微吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23281,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"看柑","author":"叶适","text":"窈窕随塘曲，酸甜在橘中。\n所欣黄一半，相逐树无穷。\n习啖成真性，悲歌记土风。\n惭非美人赠，采摘恣村童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23282,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺县尉","author":"叶适","text":"端庞还有北人风，大雅元非楚士同。\n此日深探应彻底，他时直上定摩空。\n离家杳杳百滩外，过我昏昏三伏中。\n篱破屋荒无路入，荷花招手席门东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23283,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵尚书挽诗二首 其一","author":"叶适","text":"材业将时偶，声名斗宠新。\n文昌留不住，大尹政通神。\n力说和戎好，从撩相国嗔。\n春花插秋鬓，还得自繇身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23284,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵尚书挽诗二首 其二","author":"叶适","text":"江北江南曲，吟高许和同。\n相迎黄篾浪，失笑白蘋风。\n老病犹贪活，漂零各陨空。\n长怀洞庭橘，买宅傍墙东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23285,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵知县挽词","author":"叶适","text":"僧馆经年学，书签尽日抽。\n空闻割鸡笑，不见化凫留。\n瘴月晓还落，蛮云冷未收。\n西华夜来雨，洗净一生愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23286,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵知府母齐安郡太夫人挽诗","author":"叶适","text":"生死已无憾，杭人休泪倾。\n惟留不尽德，常动故乡情。\n霜净水方落，风高山转清。\n閒思与令子，幕府再同盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23287,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵清叔挽词","author":"叶适","text":"昔我共笔砚，知君贤弟昆。\n门邀百客醉，囊讳一金存。\n忽与钟声近，长悲磬色昏。\n多年赵家府，销减惠王孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23288,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵路分挽词","author":"叶适","text":"平生王孙忌太康，承家孝友更温良。\n鸿冥鹄举须言命，桂死兰摧不断香。\n古有失时堪恨惜，今从亏处取酬偿。\n佳城况遇朱公子，大旆高牙属令郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","poi