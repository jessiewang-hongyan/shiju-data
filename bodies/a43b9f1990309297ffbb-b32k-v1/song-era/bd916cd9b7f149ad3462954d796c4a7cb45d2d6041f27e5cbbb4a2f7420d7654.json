[{"title":"焙经","author":"释绍昙","text":"老胡监本诳人天，开口无非吐黑烟。\n五热炙身甘自受，要翻元款待驴年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"疏山送日兄归玄沙","author":"释绍昙","text":"疏山觅得曹家女，娇舞西风不解羞。\n归与谢郎称万福，免教红烂在渔舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"疏山送道州如矮归湘西","author":"释绍昙","text":"笔头俊逸眼头亲，邈得疏山矮子真。\n落雁图边轻展看，谁云不是道州人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"疏山塔 其二","author":"释绍昙","text":"活被人埋汝水濆，新丰一曲杳无闻。\n可怜娇舞曹家女，不嫁春风嫁白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"缘兄求住不得乞语","author":"释绍昙","text":"磬峰小小陷人坑，始道平夷又险生。\n不是不容轻插脚，要伊别讨路头行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"葛坡","author":"释绍昙","text":"滋蔓年来愈更深，一刀截断了无因。\n不知大道陵迟处，绊倒几多忙走人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢三郎赞","author":"释绍昙","text":"雨笠烟蓑体露风，只传渔业当心宗。\n当时过得飞猿岭，不到通身是烂脓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谦翁","author":"释绍昙","text":"具通方眼放■盲，争肯先人一步行。\n穷四部洲求逊让，看来不出老先生。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"跋北涧和尚自赞灵照颂","author":"释绍昙","text":"丹霞庞老总妖人，不减狞争蛊毒神。\n灵照专行禁邪法，相逢便捋鬼头巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黑山","author":"释绍昙","text":"佛祖仰望不及处，暗昏昏地悄巍巍。\n放开闪电光中路，拶著全身陷铁围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嵩岳圭禅师移树图赞","author":"释绍昙","text":"野树无根作么移，盖头茅免八风吹。\n直饶深入那伽定，弄鬼精魂谁不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"愚翁","author":"释绍昙","text":"聪明点尽若盲聋，没变通时有变通。\n漏得黄梅无底钵，笑开老眼醉春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"照知客求无碍","author":"释绍昙","text":"捉得蓬蒿箭一枝，等闲射透五须弥。\n千重百匝机先路，破的初无抵滞时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"煨芋","author":"释绍昙","text":"粪火香凝午梦初，烂煨黄独替春蔬。\n山童急把柴门掩，只恐闲云引诏书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"矮道者","author":"释绍昙","text":"身如椰子口宏开，看尽诸方鬼戏来。\n放一头低人不识，疏山师叔是同胎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"筠溪","author":"释绍昙","text":"虚心中有箭锋机，妙密谁云立处危。\n大道陵迟全劲节，香严一击未忘知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蓬州如行图僧求偈","author":"释绍昙","text":"懒受神仙不死方，弃蓬莱入野僧房。\n莫教错下风幡语，头被傍人剃得光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蓬维那号鳌山求语","author":"释绍昙","text":"掣断任公子钓轮，波腾岳立几千寻。\n曾郎梦觉方惊险，撒手悬崖死却心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"漩翁","author":"释绍昙","text":"和泥合水几经春，只贵随流转得身。\n白浪堆头深掘窖，老来偏解活埋人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端师子赞","author":"释绍昙","text":"爪牙虽弄未全真，驳绿斑釐著一身。\n彩好不曾哮吼得，听闻将谓嚇村人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鄱阳恭上人求语","author":"释绍昙","text":"鄱阳风鼓浪千寻，彻底探穷不顾身。\n塔主连声呼莫莫，截流机峻恐惊人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧禅人","author":"释绍昙","text":"翠织岷峨锦绣春，堪嗟扑扑蔽胡尘。\n金鸡衔粟馀殃在，谁继神驹踏杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"横江","author":"释绍昙","text":"素练翻花浪拍堤，声前声后截流机。\n清波路险无人透，芦苇风生白鸟飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"磉石","author":"释绍昙","text":"锤凿工夫见十全，润时知雨玉馀温。\n看渠负载擎天柱，个个无非硬脚跟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题四兰 其四 雪","author":"释绍昙","text":"一再荒林雪，全身掩薜萝。\n直饶埋没得，争柰鼻头何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题四兰 其一 风","author":"释绍昙","text":"深藏岩谷里，初不要人知。\n苦是香难掩，春风得意吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题四兰 其二 晴","author":"释绍昙","text":"喜晴弹玉指，林下见幽人。\n楚楚湘灵样，肌肤不染尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题四兰 其三 雨","author":"释绍昙","text":"佩玉半零乱，繄谁吊楚英。\n醉香魂未返，愁听打蓬声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题老融猿","author":"释绍昙","text":"危坐禅枝冷，机含毒果深。\n直饶扪摸著，未必死偷心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题佛迹岩","author":"释绍昙","text":"一度拚身透险崖，石头机路滑如苔。\n脚跟点地不点地，立处何曾踏实来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题拗缰牛","author":"释绍昙","text":"陇树冥冥日向西，苦贪芳草不知归。\n牧童尽力拽得转，在在暝烟深翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题放山堂","author":"释绍昙","text":"一击牢关八字开，石头机路滑如苔。\n危分险布知多少，排闼从渠辊入来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题老融群牛图","author":"释绍昙","text":"三三五五戏平芜，踏裂春风百草枯。\n莫写沩山僧某甲，恐人悟作祖师图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题圆泽图","author":"释绍昙","text":"月下骑寒犊，三生事细论。\n已遭人点检，休弄鬼精魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题荷衣沼","author":"释绍昙","text":"绿荷亲制蔽穷身，池面香风噀古今。\n百万军藏藕丝孔，岂知绵密度金针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"懒翁","author":"释绍昙","text":"口生白醭怕开言，几度抬身又困眠。\n佛法从教陈烂却，权衡不在老夫边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"樵隐","author":"释绍昙","text":"斫得块柴担不起，和云飏下枕头边。\n梦魂不涉人间世，肯把黄梅破钵传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"璞庵","author":"释绍昙","text":"含藏一片玉连城，三度亲曾献楚庭。\n未跨门时琢雕了，春风深锁绿萝扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瓢泉","author":"释绍昙","text":"当阳剖破劫壶来，见彻根源眼有沙。\n临际爷爷得一杓，葛藤浸烂又萌芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞出山相","author":"释绍昙","text":"六年冻得瘦竛竮，走出山来眼未醒。\n白折金轮翻不转，谩言半夜见明星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠净书状","author":"释绍昙","text":"不学寒山落韵诗，翻身来透祖师机。\n碓头舂出非台镜，错受黄梅半夜衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"镜堂","author":"释绍昙","text":"非明非暗亦非台，万像从教影现来。\n刚被老卢书破壁，没尘埃却有尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为惟翁题非画图","author":"释绍昙","text":"误入蓬壶影里游，谕盟白鸟下沧洲。\n吞波岛屿鳌身黑，映日楼台蜃气浮。\n门逆潮开喧海市，网沿堤晒簇渔舟。\n晦明晴雨时时别，难把王维腕力收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仁座主自西山来求语","author":"释绍昙","text":"灯窗苦读觉身癯，暂握筇枝访野夫。\n爱竹劲思持玉节，看梅闲共数银须。\n西山月冷归招隐，南岳风清欲步趋。\n灵利莫教人指去，且教船子老江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"听叫居亲求语","author":"释绍昙","text":"幼把儒冠飏壁根，朅来巾侍乳峰僧。\n吟诗清苦规寒子，舂碓辛勤慕老能。\n锦镜闲看花琐碎，瀑崖戏击玉棱层。\n惜分阴语宜鞭策，望汝来挑暗室灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀樗寮","author":"释绍昙","text":"半生鱼佩解黄金，泉石郊坰得趣深。\n幽兴发时闲副墨，俗尘捐处静观心。\n圣贤炉冶镕声色，妙密工夫铿古今。\n遐想莲居驰梦远，未应轻易到瑶林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺友山新建东皋接待","author":"释绍昙","text":"分袂南湖十数春，近闻华搆策奇勋。\n钵从金粟抟香饭，僧自东皋接水云。\n柔玉新拳春坞蕨，懒黄新缕晓溪芹。\n定应容我分陈榻，曝背晴檐醉夕曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽王知县","author":"释绍昙","text":"东晋风流继令名，家传真本换鹅经。\n廉勤自得官中趣，贫节亲书座右铭。\n民感庥仁忘赴壑，子明诗礼为趋庭。\n疾风谁料摧梁木，猿鹤悲鸣不忍听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽颜伯涯制斡","author":"释绍昙","text":"握手论盟二十年，瘦筇曾约上危巅。\n雪崖未遂同观瀑，玉沼何期促孕莲。\n桐叶成阴愁引月，菊花无酒冷含烟。\n细看新补东林传，十八贤中又一贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十六","author":"释绍昙","text":"百二十日夏，今朝始发头。\n饭抄云子白，羹煮菜香浮。\n未问寒山子，先看水牯牛。\n山前千顷地，信脚踏翻休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零四首 其六十四","author":"释绍昙","text":"共住孤峰顶，霜牙咬菜根。\n一身尘不染，千古道长存。\n石竹闲眠鹿，岩松冷挂猿。\n我行荒草里，汝又入荒村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄梅墟陈提干","author":"释绍昙","text":"齿履登临乏款延，薰风报谒郁蓝天。\n拂尘未下云檐榻，采宝新归海国船。\n乘兴□□迷柳下，搜吟□梦到梅边。\n何时握手东林社，重结三生未尽缘。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"隐秀","author":"释绍昙","text":"触战蛮征总不知，乐羲皇世遁嘉肥。\n馨香静掩芝兰室，文采深藏锦绣机。\n伴野僧眠嵩少石，汲蒙泉煮首阳薇。\n箪瓢饫味□贫趣，争得红尘染著衣。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登金峨峰顶","author":"释绍昙","text":"拨开空翠上危颠，路绕羊肠石齿尖。\n到顶方知天下小，攀高似取世人嫌。\n碧连蓬岛云千叠，冷照东溟镜一奁。\n归去松窗伴禅老，此山佳致话无厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又省师","author":"释绍昙","text":"逴得诸方恶毒些，归寻刻骨旧冤家。\n深深掘窖都埋了，翻铁面皮谁识爷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大川和尚赞","author":"释绍昙","text":"面皮刮得霜，脊梁生铁铸。\n活弄恶机关，真本奉化子。\n据南山白额落却威，锁冷泉清波无透路。\n最无端是不近人情，把断贯索，倒悬佛祖，四海禅流恶见渠。\n任妙手僧繇，画得全真，且无著处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大用","author":"释绍昙","text":"二三四七恶机关，互逞辞锋斗热瞒。\n不必山僧一弹指，尽情贬向铁围山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大慈环峰和尚赞","author":"释绍昙","text":"肚肠深，用白粘贼翳睛药，定沧海舶指南针。\n出智门莲花，换人鼻孔。\n握大慈苕帚，扫世烟尘。\n忘忌讳，绝疏亲。\n病在膏肓加蛊毒，直教石佛汗通身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大慧禅师赞","author":"释绍昙","text":"薰风南来，凉生殿阁。\n诸佛出身，开口即错。\n错错，赢得衡梅十七年，驴前马后无归著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小师写真请赞","author":"释绍昙","text":"眉似帚粗，面如漆墨。\n人道慈悲，谁知恶毒。\n蒿篱关猛虎，宽处有威。\n笔管养苍龙，直中藏曲。\n喜臧仓沮，不遇鲁侯。\n忍伯夷饥，不食周粟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丰干赞","author":"释绍昙","text":"加纱挂头何规矩，眼要看经不识字。\n差般差样掣风颠，硬作斑猫骑作虎。\n道是弥陀，有何本据。\n闾丘太守，似苏州子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丹霞见庞居士灵照敛手而立图赞","author":"释绍昙","text":"放下菜篮，深深敛袂。\n瞒得丹霞，难瞒自己。\n恶机关被老爷知，赤土涂牛奶赏伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为圣俞颂橘岩","author":"释绍昙","text":"洞庭秋晚半青黄，须待霜林熟自香。\n不向悬崖亲撒手，认皮作火错承当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为缘知客求赞","author":"释绍昙","text":"不假闻思修，巨辟圆通路。\n更拟问如何，数珠木槌子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刈茆","author":"释绍昙","text":"百草头边活路通，崄崖机透几千重。\n长长短短删除了，收放全归掌握中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"化冬果","author":"释绍昙","text":"黄檗树头生蜜果，趁书云节要拈提。\n舌头具眼百杂碎，抹过庞翁向上机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"化城山主化田","author":"释绍昙","text":"古柳堤边展化机，要人一饱便忘饥。\n谁将夺食驱耕手，拚却良田种蒺藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四睡赞","author":"释绍昙","text":"人无害虎心，虎无伤人意。\n彼此不关防，何妨打觉睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无见","author":"释绍昙","text":"色尘销尽眼头空，著得须弥山万重。\n不似灵云存鉴觉，被桃花换主人翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无庵","author":"释绍昙","text":"销铄玄微万境空，衔花百鸟谩寻踪。\n莫教顽坐精灵窟，门锁乱云千万重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日本玄志禅人请语","author":"释绍昙","text":"上人幼负凌云志，十五为僧今廿二。\n鲸波不怕崄如崖，远涉要明西祖意。\n老松阴下扣烟扉，未透慈溪劈箭机。\n满口乡谈学唐语，帝都丁唤那斯祁。\n粗拳便欲拦胸?，又恐傍观分背触。\n快归省问老传衣，古涧寒泉休瞪目。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日本国光禅人旋乡求语","author":"释绍昙","text":"大唐国，日本国，临风放出辽天鹘。\n不隔重溟见得亲，依然却被重溟隔。\n光禅拚不顾浑身，咬定牙关力访寻。\n白浪堆头航一苇，普通年远只如今。\n焚香扣我西来旨，三十乌藤敲出髓。\n非佛非物亦非心，拟议白云千万里。\n结成不共戴天冤，怒气蒸云走出门。\n这回必要讨分晓，归问阿爷隆长老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日本慈源禅人归国请偈","author":"释绍昙","text":"牧间今年六十八，湖上掩关期养拙。\n万缘不挂一丝头，对客懒饶三寸舌。\n问吾道，秧田泼绿农誇好。\n问吾禅，烟林噪晚声未闻。\n无端外国人瞒我，插片木头讨甚么。\n吃盏粗茶送出门，海山啼断催归鸟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见湖心老僧暑夜发书因成口占","author":"释绍昙","text":"八十山翁夜发书，援毫气蹙汗流珠。\n自怜一把清闲骨，家火无端炼得枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]