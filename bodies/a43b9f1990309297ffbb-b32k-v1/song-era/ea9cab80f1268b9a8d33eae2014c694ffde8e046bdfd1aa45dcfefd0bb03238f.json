[{"title":"忆江南","author":"王安石","text":"城南城北万株花，池面冰消水见沙。\n回首江南春更好，梦为蝴蝶亦还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出塞","author":"王安石","text":"涿州沙上饮盘桓，看舞《春风小契丹》。\n塞雨巧催燕泪落，濛濛吹湿汉衣冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甘露歌","author":"王安石","text":"折得一枝香在手。\n人间应未有。\n疑是经春雪未消。\n今日是何朝。\n尽日含毫难比兴。\n都无色可并。\n万里晴天何处来。\n真是屑琼瑰。\n天寒日暮山谷里。\n的砾愁成水。\n池上渐多枝上稀。\n唯有故人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伤春怨","author":"王安石","text":"雨打江南树。\n一夜花开无数。\n绿叶渐成阴，下有游人归路。\n与君相逢处。\n不道春将暮。\n把酒祝东风，且莫恁、匆匆去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 红梅","author":"王安石","text":"梅好惟嫌淡伫，天教薄与胭脂。\n真妃初出华清池。\n酒入琼姬半醉。\n东阁诗情易动，高楼玉管休吹。\n北人浑作杏花疑。\n惟有青枝不似。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芳草","author":"王安石","text":"芳草知谁种，缘阶已数丛。\n无心与时竞，何苦绿匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其三 和俞秀老鹤词","author":"王安石","text":"茫然不肯住林间。\n有处即追攀。\n将他死语图度，怎得离真丹。\n浆水价，匹如闲。\n也须还。\n何如直截，踢倒军持，赢取沩山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其四 和俞秀老鹤词","author":"王安石","text":"营巢燕子逞翱翔。\n微志在雕梁。\n碧云举翮千里，其奈有鸾皇。\n临济处，德山行。\n果承当。\n自时降住，一切天魔，扫地焚香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其五 又和秀老","author":"王安石","text":"莫言普化祗颠狂。\n真解作津梁。\n蓦然打个筋斗，直跳过羲皇。\n临济处，德山行。\n果承当。\n将他建立，认作心诚，也是寻香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其一 和俞秀老鹤词","author":"王安石","text":"常时黄色见眉间。\n松桂我同攀。\n每言天上辛苦，不肯饵金丹。\n怜水静，爱云闲。\n便忘还。\n高歌一曲，岩谷迤逦，宛似商山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诉衷情令 其二 和俞秀老鹤词","author":"王安石","text":"练巾藜杖白云间。\n有兴即跻攀。\n追思往昔如梦，华毂也曾丹。\n尘自扰，性长闲。\n更无还。\n达如周召，穷似丘轲，祗个山山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郊行","author":"王安石","text":"柔桑采尽绿阴稀，芦箔蚕成密茧肥。\n聊向村家问风俗，如何勤苦尚凶饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金明池","author":"王安石","text":"宜秋西望碧参差，忆看乡人禊饮时。\n斜倚水开花有思，缓随风转柳如痴。\n青天白日春常好，绿发朱颜老自悲。\n跋马未堪尘满眼，夕阳偷理钓鱼丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨霖铃","author":"王安石","text":"孜孜矻矻。\n向无明里、强作窠窟。\n浮名浮利何济，堪留恋处，轮回仓猝。\n幸有明空妙觉，可弹指超出。\n缘底事、抛了全潮，认一浮沤作瀛渤。\n本源自性天真佛。\n祗些些、妄想中埋没。\n贪他眼花阳艳，谁信道、本来无物。\n一旦茫然，终被阎罗老子相屈。\n便纵有、千种机筹，怎免伊唐突。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南乡子 其一","author":"王安石","text":"嗟见世间人。\n但有纤毫即是尘。\n不住旧时无相貌，沈沦。\n祗为从来认识神。\n作么有疏亲。\n我自降魔转法轮。\n不是摄心除妄想，求真。\n幻化空身即法身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南乡子 其二","author":"王安石","text":"自古帝王州。\n郁郁葱葱佳气浮。\n四百年来成一梦，堪愁。\n晋代衣冠成古丘。\n绕水恣行游。\n上尽层城更上楼。\n往事悠悠君莫问，回头。\n槛外长江空自流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南浦","author":"王安石","text":"南浦东冈二月时，物华撩我有新诗。\n含风鸭绿粼粼起，弄日鹅黄袅袅垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南浦","author":"王安石","text":"南浦随花去，回舟路已迷。\n暗香无觅处，日落画桥西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钟山即事","author":"王安石","text":"涧水无声绕竹流，竹西花草弄春柔。\n茅檐相对坐终日，一鸟不鸣山更幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂枝香","author":"王安石","text":"登临送目。\n正故国晚秋，天气初肃。\n千里澄江似练，翠峰如簇。\n归帆去棹斜阳里，背西风，酒旗斜矗。\n彩舟云淡，星河鹭起，画图难足。\n念往昔、繁华竞逐，叹门外楼头，悲恨相续。\n千古凭高，对此漫嗟荣辱。\n六朝旧事如流水，但寒烟、衰草凝绿。\n至今商女，时时犹唱，《后庭》遗曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"王安石","text":"百亩中庭半是苔。\n门前白道水萦回。\n爱闲能有几人来。\n小院回廊春寂寂，山桃溪杏两三栽。\n为谁零落为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令","author":"王安石","text":"伊吕两衰翁。\n历遍穷通。\n一为钓叟一耕佣。\n若使当时身不遇，老了英雄。\n汤武偶相逢。\n风虎云龙。\n兴王祗在笑谈中。\n直至如今千载后，谁与争功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南 其三 归依三宝赞","author":"王安石","text":"归依佛，弹指越三祗。\n愿我速登无上觉，还如佛坐道场时。\n能智又能悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南/忆江南 其一 归依三宝赞","author":"王安石","text":"归依众，梵行四威仪。\n愿我遍游诸佛土。\n十方贤圣不相离。\n永灭世间痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南/忆江南 其二 归依三宝赞","author":"王安石","text":"归依法，法法不思议。\n愿我六根常寂静，心如宝月映琉璃。\n了法更无疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南 其四 归依三宝赞","author":"王安石","text":"三界里，有取总灾危。\n普愿从生同我愿，能于空有善思惟。\n三宝共住持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐","author":"王安石","text":"云垂平野。\n掩映竹篱茅舍。\n阒寂幽居实潇洒。\n是处绿娇红冶。\n丈夫运用堂堂。\n且莫五角六张。\n若有一卮芳酒，逍遥自在无妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其一","author":"王安石","text":"灯火已收正月半。\n山南山北花撩乱。\n闻说荐亭新水漫。\n骑款段。\n穿云入坞寻游伴。\n却拂僧床褰素幔。\n千岩万壑春风暖。\n一弄松声悲急管。\n吹梦断。\n西看窗日犹嫌短。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其二","author":"王安石","text":"平岸小桥千嶂抱，揉蓝一水萦花草。\n茅屋数间窗窈窕。\n尘不到，时时自有春风扫。\n午枕觉来闻语鸟，攲眠似听朝鸡早。\n忽忆故人今总老。\n贪梦好，茫然忘了邯郸道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆王孙 梦中作","author":"王安石","text":"隔岸桃花红未半。\n枝头已有蜂儿乱。\n惆怅武陵人不管。\n清梦断。\n亭亭伫立春宵短。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 集句","author":"王安石","text":"海棠乱发皆临水。\n君知此处花何似。\n凉月白纷纷。\n香风隔岸闻。\n啭枝黄鸟近。\n隔岸声相应。\n随意坐莓苔。\n飘零酒一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮","author":"王安石","text":"数家茅屋闲临水。\n单衫短帽垂杨里。\n花是去年红，吹开一夜风。\n梢梢新月偃。\n午醉醒来晚。\n何物最关情。\n黄鹂三两声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门","author":"王安石","text":"春又老。\n南陌酒香梅小。\n遍地落花浑不扫。\n梦回情意悄。\n红笺寄与添烦恼。\n细写相思多少。\n醉后几行书字小。\n泪痕都揾了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"棋","author":"王安石","text":"莫将戏事扰真情，且可随缘道我赢。\n战罢两奁分白黑，一枰何处有亏成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人","author":"王安石","text":"虞美人，态浓意远淑且真。\n同辇随君侍君侧，六宫粉黛无颜色。\n楚歌四面起，形势反苍黄。\n夜闻马嘶晓无迹，蛾眉萧飒如秋霜。\n汉家离宫三十六，缓歌慢舞凝丝竹。\n人间举眼尽堪悲，独在阴崖结茅屋。\n美人为黄土，草木皆含愁。\n红房紫莟处处有，听曲低昂如有求。\n青天漫漫覆长路，今人犁田昔人墓。\n虞兮虞兮奈若何，不见玉颜空死处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十一","author":"王安石","text":"萧萧抟黍声中日，漠漠舂锄影外天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王安石","text":"雪底黄精与不疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"王安石","text":"隐几先生未忘物，葛陂犹问化龙身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王安石","text":"大木百围生远籁，朱玄三叹有一音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十","author":"王安石","text":"青山扪虱坐，黄鸟挟书眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"王安石","text":"夕阳到处花偏暖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王安石","text":"哀俗易高名已振，途险难尽学须强。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"王安石","text":"霜筠雪竹钟山寺，投老归欤寄此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"王安石","text":"昔时江令宅，今日段侯家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十五","author":"王安石","text":"乞米助㾕镏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十八","author":"王安石","text":"苑阆仙人何处觅，灵槎使者几时回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王安石","text":"周迥莫有千株叶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万年欢","author":"王安礼","text":"雅出群芳。\n占春前信息，腊后风光。\n野岸邮亭，繁似万点轻霜。\n清浅溪流倒影，更黯淡、月色笼香。\n浑疑是、姑射冰姿，寿阳粉面初妆。\n多情对景易感，况淮天庾岭，迢递相望。\n愁听龙吟凄绝，画角悲凉。\n念昔因谁醉赏，向此际、空恼危肠。\n终须待结实，恁时佳味堪尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇","author":"王安礼","text":"春睡腾腾，觉来鸳被堆香暖。\n起来慵懒。\n触目情何限。\n深院日斜，人静花阴转。\n柔肠断。\n凭高不见。\n芳草连天远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潇湘逢故人慢","author":"王安礼","text":"薰风微动，方樱桃弄色，萱草成窠。\n翠帏敞轻罗。\n试冰簟初展，几尺湘波。\n疏帘广厦，寄潇洒、一枕南柯。\n引多少、梦中归绪，洞庭雨棹烟蓑。\n惊回处，闲昼永，但时时，燕雏莺友相过。\n正绿影婆娑。\n况庭有幽花，池有新荷。\n青梅煮酒，幸随分、赢得高歌。\n功名事、到头终在，岁华忍负清和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纪梦","author":"王安国","text":"万顷波涛木叶飞，笙箫宫殿号灵芝。\n挥毫不似人间世，长乐钟声梦觉时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游庐山宿栖贤寺","author":"王安国","text":"古屋萧萧卧不周，披裘起坐兴绸缪。\n千山月午乾坤昼，一壑泉鸣风雨秋。\n迹入尘中惭有累，心期物外欲何求。\n明朝松路须惆怅，忍更无诗向此游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"滕王阁感怀","author":"王安国","text":"滕王平昔好追游，高阁依然枕碧流。\n胜地几经兴废事，夕阳偏照古今愁。\n城中树碧千家市，天际人归一叶舟。\n极目烟波吟不尽，西山重叠乱云浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇","author":"王安国","text":"秋气微凉，梦回明月穿帘幕。\n井梧萧索。\n正绕南枝鹊。\n宝瑟尘生，金雁空零落。\n情无托。\n鬓云慵掠。\n不似君恩薄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 春情","author":"王安国","text":"画桥流水。\n雨湿落红飞不起。\n月破黄昏。\n帘里馀香马上闻。\n徘徊不语。\n今夜梦魂何处去。\n不似垂杨。\n犹解飞花入洞房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 春晚","author":"王安国","text":"留春不住。\n费尽莺儿语。\n满地残红宫锦污。\n昨夜南园风雨。\n小怜初上琵琶。\n晓来思绕天涯。\n不肯画堂朱户，春风自在梨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀天台隐士","author":"王尧臣","text":"先生高蹈晦岩扉，沐发晞阳远帝晖。\n自是鸾皇终瑞世，莫同鱼鸟便忘机。\n江凫汎汎随波远，朔雁冥冥避弋归。\n他日彤庭如应聘，梦魂休绕故山薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过池阳","author":"王巩","text":"不见当年两翰林，江天为我结层阴。\n九华门外柳三丈，萧相楼前松十寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"欣欣亭","author":"王巩","text":"清湘北郭崇岗路，松竹年来定几围。\n我亦临淮筑新宅，与君万里对柴扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄山谷","author":"王巩","text":"北海未常樽有酒，冯驩何止食无鱼。\n黔州椀脱无蒸饼，自合官称削校书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐山僧舍","author":"王巩","text":"竹密通幽境，横桥逐涧斜。\n阴崖耸圭壁，古蔓引龙蛇。\n寺僻虚僧磬，亭荒足兔罝。\n紫微今不见，著意采黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽苏黄门子由 其三","author":"王巩","text":"静者宜膺寿，胡为忽梦楹。\n伤嗟见行路，优典识皇情。\n徒泣巴山路，终悲蜀道程。\n弟兄仁达意，千古各垂名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽苏黄门子由 其一","author":"王巩","text":"忆昔持风宪，防微意独深。\n一时经国虑，千载爱君心。\n坤道存终始，乾纲正古今。\n当时人物尽，惆怅独知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽苏黄门子由 其二","author":"王巩","text":"已矣东门路，空悲未尽情。\n交亲踰四纪，忧患共平生。\n此去音容隔，徒多涕泪横。\n蜀山千万叠，何处是佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萧相楼","author":"王巩","text":"卢杞奸邪四海忧，相君邦国自同休。\n分符朝去云中阙，开府南来江上州。\n百尺楼高瞻故国，九华山色倚晴眸。\n定知直道传千古，杜牧文章在上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘山","author":"王巩","text":"半岭风吹草木香，落阶花雨送春忙。\n从师远借云庵卧，还我平生午枕凉。\n莲社缁黄常得伴，鹿门妻子亦相将。\n化身欲似河东柳，更向山头望故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题管圣浩蒲川归隐","author":"王巩","text":"卜筑蒲川上，翛然远市廛。\n潮声书屋外，月影钓舟前。\n地僻红尘净，沙平白鸟眠。\n此中幽适趣，不必问斜川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"全州捲烟阁","author":"王巩","text":"长江萦村若练带，晴岫插天如画屏。\n山青水秀两奇绝，道人对此开禅扃。\n红尘一点飞不到，举手高可摩天星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"王钦若","text":"春渍苔纹沿石塔，月含松韵杂琴声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"如梦令","author":"王师锡","text":"竹上一楼岚翠。\n竹下一渠春水。\n中有隐人居，破屋数间而已。\n无事。\n无事。\n静夜月明千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客","author":"王庄","text":"杨花撩乱绕烟村，感触离人更断魂。\n江上归来无好思，满庭风雨易黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":14458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]