[{"title":"再次韵和吉老","author":"黄庭坚","text":"今日仆姑晴自语，愁阴前日雪铺床。\n三冬一雨禾头湿，百斛几痕牛领疮。\n民欲与翁归作腊，公方无事可开场。\n相勤冻坐真成恶，愧我偷閒饱太仓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵奉答子由","author":"黄庭坚","text":"虿尾银钩写珠玉，剡藤蜀茧照松烟。\n似逢海若谈秋水，始觉醯鸡守瓮天。\n何日清扬能觌面，只今黄落又凋年。\n万钱买酒从公醉，一钵行歌听我颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵兼简履中南玉三首 其三","author":"黄庭坚","text":"锁江亭上一樽酒，山自白云江自横。\n李侯短褐有长处，不与俗物同条生。\n经术貂蝉续狗尾，文章瓦釜作雷鸣。\n古来寒士但守节，夜夜抱关听五更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵寄子由","author":"黄庭坚","text":"想见苏耽携手仙，青山桑柘冒寒烟。\n骐驎堕地思千里，虎豹憎人上九天。\n风雨极知鸡自晓，雪霜宁与菌争年。\n何时确论倾樽酒，医得儒生自圣颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和寄蓝六","author":"黄庭坚","text":"南极一星淮上老，承家令子气横秋。\n万端只要称心耳，五鼎何如委吏优。\n海燕催归人作社，江花欲动雨含愁。\n追思二十年前会，棠棣飘零叹鄂不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再赠陈季张拒霜花二首 其一","author":"黄庭坚","text":"鼓盆庄叟赋情浓，天遣霜华慰此公。\n想见尚能迷蝶梦，移栽闻说自蚕丛。\n酒倾玉盏垂莲尽，鲙簇金盘下箸空。\n秉烛栏边连夜饮，全藤折与卖花翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再赠陈季张拒霜花二首 其二","author":"黄庭坚","text":"倒著接䍦吾素风，当时酩酊似山公。\n且看小槛新花蕊，休泥他家晚菊丛。\n顾笑千金延客醉，解酲五斗为君空。\n欢娱尽属少年事，白发欺人作老翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冲雪宿新寨忽忽不乐","author":"黄庭坚","text":"县北县南何日了，又来新寨解征鞍。\n山衔斗柄三星没，雪共月明千里寒。\n小吏有时须束带，故人颇问不休官。\n江南长尽捎云竹，归及春风斩钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吉老受秋租辄成长句","author":"黄庭坚","text":"黄花事了绿丛霜，蟋蟀催寒夜夜床。\n爱日捃收如盗至，失时鞭扑奈民疮。\n田夫田妇肩赪担，江北江南稼涤场。\n少忍飞糠眯君眼，要令私廪上公仓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同子瞻和赵伯充团练","author":"黄庭坚","text":"金玉堂中寂寞人，仙班时得共朝真。\n两宫无事安磐石，万国归心有老臣。\n家酿可供开口笑，侍儿工作捧心颦。\n醉乡乃是安身处，付与升平作幸民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同孙不愚过昆阳","author":"黄庭坚","text":"田园恰恰值春忙，驱马悠悠昆水阳。\n古庙藤萝穿户牖，断碑风雨碎文章。\n真人寂寞神为社，坚垒委蛇女采桑。\n拂帽村帘誇酒好，为君聊解一瓢尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同韵和元明兄知命弟九日相忆二首 其二","author":"黄庭坚","text":"万水千山厌问津，芭蕉林里自观身。\n邻田鸡黍留熊也，风雨关河走阿秦。\n鸿雁池边照双影，脊令原上忆三人。\n年年献寿须欢喜，白发黄花映角巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同韵和元明兄知命弟九日相忆二首 其一","author":"黄庭坚","text":"革囊南渡传诗句，摹写相思意象真。\n九日黄花倾寿酒，几回青眼望归尘。\n蚤为学问文章误，晚作东西南北人。\n安得田园可温饱，长抛簪绂裹头巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孙不愚引开元故事请为移春槛因而赠答","author":"黄庭坚","text":"南陌东城处处春，不须移槛损天真。\n鬓毛欲白休辞饮，风雨无端只误人。\n鸟语提壶元自好，酒狂惊俗未应嗔。\n稍寻绿树为诗社，更藉残红作醉茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孙不愚索饮九日酒已尽戏答一篇","author":"黄庭坚","text":"满眼黄花慰索贫，可怜风物逐时新。\n范丹出后尘生釜，郭泰归来雨垫巾。\n偶有清樽供寿母，遂无馀沥及他人。\n年丰酒价应须贱，为子明年作好春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏书效乐天","author":"黄庭坚","text":"造物生成嵇叔懒，好人容纵接舆狂。\n鸟飞鱼泳随高下，蚁集蜂衙听典常。\n母惜此儿长道路，兄嗟予弟困冰霜。\n酒壶自是华胥国，一醉从他四大忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏咏江南土风","author":"黄庭坚","text":"十月江南未得霜，高林残水下寒塘。\n饭香猎户分熊白，酒熟渔家擘蟹黄。\n橘摘金苞随驿使，禾舂玉粒送官仓。\n踏歌夜结田神社，游女多随陌上郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"假山","author":"苏轼","text":"安石作假山，其中多诡怪。\n虽然知是假，争奈主人爱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏题葆真阁","author":"黄庭坚","text":"真常自在如来性，肯綮修持祗益劳。\n十二因缘无妙果，三千世界起秋毫。\n有心便醉声闻酒，空手须磨般若刀。\n截断众流寻一句，不离兔角与龟毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏赠水牯庵","author":"黄庭坚","text":"水牯从来犯稼苗，著绳只要鼻穿牢。\n行须万里无寸草，卧对十方同一槽。\n租税及时王事了，云山横笛月轮高。\n华亭浪说吹毛剑，不见全牛可下刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏赠南安倅柳朝散","author":"黄庭坚","text":"柳侯风味晚相见，衣袂颇薰荀令香。\n桃李能言妙歌舞，樽前一曲断人肠。\n洞庭归客有佳句，庾岭梅花如小棠。\n乘兴高帆少相待，淮湖秋月要传觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏赠顿二主簿","author":"黄庭坚","text":"桐植客亭欣款曲，歌倾家酿勿徘徊。\n百年中半夜分去，一岁无多春暂来。\n落日园林须秉烛，能言桃李听传杯。\n红疏绿暗明朝是，公事相过得几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏赠惠南禅师","author":"黄庭坚","text":"佛子禅心若苇林，此门无古亦无今。\n庭前柏树祖师意，竿上风幡仁者心。\n草木同沾甘露味，人天倾听海潮音。\n胡床默坐不须说，拨尽寒灰劫数深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杂吟","author":"黄庭坚","text":"城中蛾眉女，珂佩响珊珊。\n鹦鹉花间弄，琵琶月下弹。\n长歌三日绕，短舞万人看。\n未必长如此，芙蓉不耐寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次元明韵寄子由","author":"黄庭坚","text":"半世交亲随逝水，几人图画入凌烟。\n春风春雨花经眼，江北江南水拍天。\n欲解铜章行问道，定知石友许忘年。\n脊令各有思归恨，日月相催雪满颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵几复和答所寄","author":"黄庭坚","text":"海南海北梦不到，会合乃非人力能。\n地褊未堪长袖舞，夜寒空对短檠灯。\n相看鬓发时窥镜，曾共诗书更曲肱。\n作个生涯终未是，故山松长到天藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵几复答予所赠三物三首 其三 石刻","author":"黄庭坚","text":"九原谁复起，糟魄未传心。\n不取丁仪米，疑成校尉金。\n名从高位借，德有下僚沈。\n笔削多瑕点，犹希畏友箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵几复答予所赠三物三首 其一 石灯檠","author":"黄庭坚","text":"谁怜湖海士，白发夜窗檠。\n风雨鸡不已，诗书眼尚明。\n禅枝安宿鸟，僧粥吼华鲸。\n但满五车读，行看一座倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵几复答予所赠三物三首 其二 石博山","author":"黄庭坚","text":"绝域蔷薇露，他山菡萏炉。\n薰衣作家想，伏枕梦闺姝。\n游子官蚁穴，谪仙居瓠壶。\n当时有忧乐，回首亦成无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵十九叔父台源","author":"黄庭坚","text":"闻道台源境，锄荒三径通。\n人曾梦蚁穴，鹤亦怕鸡笼。\n万壑秋声别，千江月体同。\n须知有一路，不在白云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子高即事","author":"黄庭坚","text":"诗礼不忘它日问，文章未觉古人疏。\n青云自致屠龙学，白首同归种树书。\n绿叶青阴啼鸟下，游丝飞絮落花馀。\n无因常得杯中物，愿作鸱夷载属车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵子瞻题无咎所得与可竹二首粥字韵戏嘲无咎人字韵咏竹 其二","author":"黄庭坚","text":"地下文夫子，风流绝此人。\n能和晚烟色，幻出岁寒身。\n马鬣松成拱，鹅溪墨尚新。\n应怀斲泥手，去作主林神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵马荆州","author":"黄庭坚","text":"六年绝域梦刀头，判得南还万事休。\n谁谓石渠刘校尉，来依绛帐马荆州。\n霜髭雪鬓共看镜，茱糁菊英同送秋。\n他日江梅腊前破，还从天际望归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵元日","author":"黄庭坚","text":"会朝四海登图籍，绛阙清都想盛容。\n春色已知回寸草，霜威从此霁寒松。\n饮如嚼蜡初忘味，事与浮云去绝踪。\n四十九年蘧伯玉，圣人门户见重重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵元翁从王夔玉借书","author":"黄庭坚","text":"为吏三年弄文墨，草莱心径失耕锄。\n常思天下无双祖，得读人间未见书。\n公子藏山真富有，小儒扪腹正空虚。\n何时管钥入吾手，为理签题扑蠹鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵公定世弼登北都东楼四首 其四","author":"黄庭坚","text":"汉皇勤远略，晚节相千秋。\n不足中原地，犹思一战收。\n圣朝方北顾，斜日倚东楼。\n庙算知无敌，寒儒浪自愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵公定世弼登北都东楼四首 其三","author":"黄庭坚","text":"都城碍飞鸟，军幕卧貔貅。\n紫葚知蚕老，黄云见麦秋。\n接天双阙起，伏地九河流。\n耆老深望幸，銮舆不好游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵公定世弼登北都东楼四首 其二","author":"黄庭坚","text":"真皇多庙胜，仁祖用功深。\n卜宅迁九鼎，破胡藏万金。\n百年休战士，当日纵前禽。\n欲断匈奴臂，不如留此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵公定世弼登北都东楼四首 其一","author":"黄庭坚","text":"日著阑干角，风吹濯浣衣。\n喜同王季哲，更得谢玄晖。\n清兴俱不浅，长吟无用归。\n月明南北道，犹见驿尘飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王定国怀南都上元","author":"刘挚","text":"九陌无尘夜霁天，两都风物故依然。\n车驰马逐灯方闹，地静人闲月自妍。\n佛馆醉谈怀旧岁，斋宫诗思锁今年。\n传闻公子微行处，门外骅骝立绣鞯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵少激甘露降太守居桃叶上","author":"黄庭坚","text":"金茎甘露荐斋房，润及边城草木香。\n蕡实叶间天与味，成蹊枝上月翻光。\n群心爱戴葵倾日，万事驱除叶陨霜。\n玉烛时和君会否，旧臣重叠起南荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵文少激祈雨有感","author":"黄庭坚","text":"穷儒忧乐与民同，何况朱轮职劝农。\n终日齑盐供一饭，几时肤寸冒千峰。\n未须丘垤占鸣鹳，只要朝廷起卧龙。\n从此滂沱遍枯槁，爱民天子似仁宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵文潜休沐不出二首 其二","author":"黄庭坚","text":"与世自少味，闭关非有心。\n戎葵一笑粲，露井百尺深。\n著书洒风雨，枯笔束如林。\n苏公叹妙墨，逼人太骎骎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵文潜休沐不出二首 其一","author":"黄庭坚","text":"风尘车马逐，得失两关心。\n惟有张仲蔚，门前蓬藋深。\n自公及归沐，毕愿诗书林。\n墙东作瘦马，万里气骎骎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵王定国扬州见寄","author":"黄庭坚","text":"清洛思君昼夜流，北归何日片帆收。\n未生白发犹堪酒，垂上青云却佐州。\n飞雪堆盘鲙鱼腹，明珠论斗煮鸡头。\n平生行乐自不恶，岂有竹西歌吹愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵外舅喜王正仲三丈奉诏祷南岳回至襄阳舍驿马就舟见过三首 其二","author":"黄庭坚","text":"能来问疾好音传，蹇步昏花当日痊。\n烹鲤得书增目力，呼儿扶立候门前。\n游谈取重惭犀首，居物多赢昧计然。\n惟有交亲等金石，白头忘义复忘年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵外舅喜王正仲三丈奉诏祷南岳回至襄阳舍驿马就舟见过三首 其三","author":"黄庭坚","text":"语言少味无阿堵，冰雪相看有此君。\n灯火诗书如梦寐，麒麟图画属浮云。\n平章息女能为妇，欢喜儿曹解缀文。\n忧乐同科惟石友，别离空复数朝曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵汉公招七兄","author":"黄庭坚","text":"白发霏霏雪点斑，朱樱忽忽鸟衔残。\n公庭休吏进汤饼，语燕无人窥井栏。\n诗句多传知有暇，道人相见不应难。\n老郎亲屈延处士，风味依稀如姓桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵任君官舍秋雨","author":"黄庭坚","text":"墙根戢戢数蜗牛，雨长垣衣亭更幽。\n惊起归鸿不成字，辞柯落叶最知秋。\n菊花莫恨开时晚，谷穟犹思晴后收。\n独立搔头人不解，南山用取一樽酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵任道雪中同游东皋之作","author":"黄庭坚","text":"四海方嗷嗷，我奔走独劳。\n停舟近北渚，扶杖步东皋。\n霜落瘦石骨，水涨腐溪毛。\n更有山阴兴，能无秦复陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘景文登邺王台见思五首 其五","author":"黄庭坚","text":"公诗如美色，未嫁已倾城。\n嫁作荡子妇，寒机泣到明。\n绿琴蛛网遍，弦绝不成声。\n想见鸱夷子，江湖万里情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘景文登邺王台见思五首 其四","author":"黄庭坚","text":"茗花浮曾坑，酒泛酌宜城。\n路寻西九曲，人似汉三明。\n千户非无相，五言空有声。\n何时郭池晚，照影写閒情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘景文登邺王台见思五首 其三","author":"黄庭坚","text":"系匏两相忆，极目十馀城。\n积潦干斗极，山河皆夜明。\n白璧按剑起，朱弦流水声。\n乖逢四时尔，木石了无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘景文登邺王台见思五首 其二","author":"黄庭坚","text":"旧时刘子政，憔悴邺王城。\n把笔已头白，见书犹眼明。\n平原秋树色，沙麓暮钟声。\n归雁南飞尽，无因寄此情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵刘景文登邺王台见思五首 其一","author":"黄庭坚","text":"黄浊归大壑，涟漪绕重城。\n西风一横笛，金气与高明。\n归鸦度晚景，落雁带边声。\n平生知音处，别离空复情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吉老知命同游青原二首 其二","author":"黄庭坚","text":"至人来有会，吾道本无家。\n阅世鱼行水，遗书鸟印沙。\n斋盂香佛饭，法席雨天花。\n时有清谈胜，还同叹永嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吉老知命同游青原二首 其一","author":"黄庭坚","text":"洗钵寻思去，论诗匡鼎来。\n鸦窥锡处井，鱼泳钓时台。\n垂足收亲子，存身亘劫灰。\n僧雏手金钥，一为道人开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵吉老寄君庸","author":"黄庭坚","text":"何郎生事四立壁，心地高明百不忧。\n白眼醉来思阮籍，碧云吟罢对汤休。\n诸公著力书交上，尺璧深藏价未酬。\n空使君如巢幕燕，将雏处处度春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵师厚雨中昼寝忆江南饼曲酒","author":"黄庭坚","text":"雨砌无车马，风帘洒静便。\n忽思江外酒，准拟醉时眠。\n隐几惟观化，开书屡绝编。\n遥知烟渚梦，遣骑唤渔船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵师厚萱草","author":"黄庭坚","text":"从来占北堂，雨露借恩光。\n与菊乱佳色，共葵倾太阳。\n人生真苦相，物理忌孤芳。\n不及空庭草，荣衰可两忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵戏答彦和","author":"黄庭坚","text":"本不因循老镜春，江湖归去作閒人。\n天于万物定贫我，智效一官全为亲。\n布袋形骸增碨磊，锦囊诗句愧清新。\n杜门绝俗无行迹，相忆犹当遣化身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵伯氏戏赠韩正翁菊花开时家有美酒","author":"黄庭坚","text":"鬓发斑然潘骑省，腰围瘦尽沈东阳。\n茶瓯屡煮龙山白，酒椀希逢若下黄。\n乌角巾边簪钿朵，红银杯面冻糖霜。\n会须著意怜时物，看取年华不久芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵伯氏寄赠盖郎中喜学老杜诗","author":"黄庭坚","text":"老杜文章擅一家，国风纯正不攲斜。\n帝阍悠邈开关键，虎穴深沈探爪牙。\n千古是非存史笔，百年忠义寄江花。\n潜知有意升堂室，独抱遗编校舛差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵伯氏谢安石塘莲花酒","author":"黄庭坚","text":"花蕊芙蕖拍酒醇，浮蛆相乱菊英新。\n寒光欲涨红螺面，烂醉从歌白鹭巾。\n行乐衔杯常有意，过门问字久无人。\n王孙欲遣双壶到，如入醉乡三月春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]