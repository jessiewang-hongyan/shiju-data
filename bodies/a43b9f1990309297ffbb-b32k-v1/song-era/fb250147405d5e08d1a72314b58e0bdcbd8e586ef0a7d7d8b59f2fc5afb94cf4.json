[{"title":"溺溪流","author":"靓禅师","text":"春天一夜雨霶?，添得溪流意气多。\n刚把山僧推倒却，不知到海后如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"嵊县令","text":"一时分付雪儿歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏悼如禅师","author":"嵩禅师","text":"继祖当吾代，生缘行可规。\n终身常在道，识病懒寻医。\n貌古笔难写，情高世莫知。\n慈云布何处，孤月自相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上堂偈","author":"微禅师","text":"日暖风和柳眼青，冰消鱼跃浪花生。\n当锋妙得空王印，半夜昆崙戴雪行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翠蛟亭","author":"新父","text":"断崖捲银涛，拍岸雪相溅。\n去住本无心，曾向岷峨见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"广胜寺","author":"新若通","text":"吾党登临兴，亭高眼更明。\n云深山断续，川阔路纵横。\n突兀娲皇冢，荒芜简子城。\n古来那可问，林外晚风生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺罗珊","author":"新喻宰","text":"刑部二品尚书郎，匹马萧然返故乡。\n点检庭前亲种柳，于今森列总成行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"市桥柳 送行","author":"蜀中妓","text":"欲寄意、浑无所有。\n折尽市桥官柳。\n看君著上征衫，又相将，放船楚江口。\n后会不知何日又。\n是男儿、休要镇长相守。\n苟富贵、无相忘，若相忘，有如此酒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹊桥仙","author":"蜀妓","text":"说盟说誓，说情说意，动便春愁满纸。\n多应念得脱空经，是那个先生教底？\n不茶不饭，不言不语，一味供他憔悴。\n相思已是不曾闲，又那得功夫咒你。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送熊退斋归武夷","author":"蜀翁","text":"君居建州溪，我住东浙尾。\n邂逅入壶山，于今几寒暑。\n平生谭理道，涉猎颇自喜。\n考击到精玄，我肤君骨髓。\n君学有根源，君文有规矩。\n寸步履平实，不知虚浮语。\n礼废彝伦斁，聋盲数百载。\n紫阳当日心，谁复为鼓舞。\n气运未回天，人力不能起。\n终焉经久功，或慰奔驰苦。\n读书要适用，行过言犹耻。\n架空累万辞，先儒已坐此。\n观君治教篇，农学相资倚。\n以兹行吾志，万物当得所。\n奈何人理缪，痛哉时不与。\n君去将安之，波浪更风雨。\n武夷高且深，棹歌声未已。\n朝夕足夷犹，尚友朱夫子。\n他年见鳌峰，势与此山拟。\n了却未完书，相逢定何许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙坛","author":"蜀僧","text":"万叠峰峦耸太清，麻姑曾此会方平。\n一从宴罢归何处，宝殿瑶台空月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋湖中渔翁","author":"蜀僧","text":"篮里无鱼欠酒钱，酒家门外系渔船。\n几回欲脱蓑衣当，又恐明朝是雨天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"跨犊者","text":"有酒便尝烹笋蕨，无花聊自赏桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其三 秋","author":"鉴堂","text":"砌风鸣叶繁霜坠。\n坠霜繁叶鸣风砌。\n山外水潺潺。\n潺潺水外山。\n冷衾愁夜永。\n永夜愁衾冷。\n砧响更蛩吟。\n吟蛩更响砧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其四 冬","author":"鉴堂","text":"浦南回桨归庭户。\n户庭归桨回南浦。\n帘卷欲晴天。\n天晴欲卷帘。\n月光交映雪。\n雪映交光月。\n残漏怯宵寒。\n寒宵怯漏残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其二 夏","author":"鉴堂","text":"竹枝高映荷池绿。\n绿池荷映高枝竹。\n流水碧浮鸥。\n鸥浮碧水流。\n酒尊陪旧友。\n友旧陪尊酒。\n吟客坐时斟。\n斟时坐客吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其一 春","author":"鉴堂","text":"落花丛外风惊鹊。\n鹊惊风外丛花落。\n乡梦困时长。\n长时困梦乡。\n暮天江口渡。\n渡口江天暮。\n林远度栖禽。\n禽栖度远林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"锡九龄","text":"不会季鹰当日意，归来只说为鲈莼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 和人女试倅","author":"锦溪","text":"华堂庆晬。\n一岁应须千百岁，乐事如何。\n寿酒斟时妹拜哥。\n爹夸利市。\n笑道看看生舍弟。\n同著莱衣。\n玉树森森奉寿卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"壶中天 寿陈碧山十一月十五日","author":"锦溪","text":"骑鲸直上，问姮娥何日，天生英杰。\n笑下琼楼，还报道，甫近迎长佳节。\n万里无云，一天如水，拥出新团月。\n正当此夜，文星飞下天阙。\n蟾苑元有高枝，至今犹待，自是无心折。\n只爱林泉供笑傲，吟出阳春白雪。\n冠玉精神，希夷仙种，秘受长生诀。\n蓬壶不老，待看兰玉英发。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 寿八十老人十一月十六日","author":"锦溪","text":"蓬岛仙翁，元来是、神钟岳渎。\n喜遇生申时节，一阳来复。\n蓂荚合朝曾舞翠，月华昨夜圆如玉。\n展红笺、泚笔染新章，从头录。\n渭川叟，非钩禄。\n鲁公子，非徼福。\n况家传、胡氏长生箓。\n点额婴儿腾好语，殷勤捧献杯中绿。\n更九番、屈指篯铿年，为君祝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠英公大师","author":"颖贽","text":"蛮笺象管少年时，几赋帘前祝寿诗。\n三殿荷恩卿相看，两朝承宠帝王知。\n寻穷太华高低景，念尽长安内外碑。\n可惜篆文今绝笔，李阳冰后只吾师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烛影摇红 五月初三","author":"鼓峰","text":"风入虞弦，麦秋向晚梅天润。\n彩丝长命斗新奇，还是端阳近。\n想见瑶池仙韵。\n对蟠桃、朱颜相映。\n篆飘宝鼎，酒满霞觞，黄堂深静。\n超悟真筌，凤归不作登台恨。\n庆馀有子在河图，详试龚黄政。\n好是棠阴清永。\n且游戏、壶中光景。\n会有飞诏，却奉轻轩，天朝归觐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绝句","author":"潇湘渔父","text":"高枕形骸外，空江何限情。\n落叶不成调，半夜起秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"歌一首","author":"潇湘渔父","text":"乾淳老人气岳岳，破冠穿履行带索。\n撑肠拄肚书万卷，临风欲言牙齿落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题黄连步接官亭壁","author":"鄱阳妇人","text":"故里萧条一望间，此身飘泊叹空还。\n感时有恨无人说，愁敛双蛾对暮山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望海潮","author":"鄱阳护戎女","text":"云收飞脚，日祛怒暑，新蝉高柳鸣时。\n兰佩紫囊，蒲抽碧剑，吴丝两腕双垂。\n闻道五陵儿。\n蛟龙吼波面，冲碎琉璃。\n画鼓声中，锦标争处飐红旗。\n使君冠盖追。\n正霞翻酒浪，翠敛歌眉。\n扇动水风生玉宇，微凉透入单衣。\n日暮楚天低。\n金蛇掣电漾，千顷霜溪。\n宴罢休燃宝蜡，凭月照人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟 送人归江西","author":"静山","text":"片帆天际归舟，好风动、吹来消息。\n浪间双桨，回头春杪，去来几日。\n十八滩头，水飞如舞，石巉如壁。\n把连樯白粲，等闲卸却，更呼取、艅艎入。\n不羡公家事了，羡二难、一番游历。\n江花江水，无边风月，不知行役。\n和郁孤词，倚崆峒剑，唤醒龙蛰。\n试问君，过我青原，听得几声羌笛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"摸鱼儿 黄时中入郡幕","author":"静山","text":"晓峰高、飞泉如瀑，潜虬鞭驾轩翥。\n为他一片韩山石，直到红云天尺五。\n想应道、公皆安在来何暮。\n金川小渚。\n那韶石参天，郡纲宜录，为我分南顾。\n锦衣昼，满袖尚疑香雾。\n催人富贵如许。\n岭云见说今如砥，凤挟九成迎舞。\n烦道甫。\n问金镜铁胎，还记开元否。\n封词寄与。\n但目送河桥，吟消醉拍，载酒满江浒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳","author":"鲖阳居士","text":"良月霜清，小春寒浅，瑞庭蓂荚双飞。\n岭梅香度，初发向南枝。\n此际高门袭庆，真贤降、金璧生辉。\n传瀛海向歆父子，相继大名垂。\n广寒，山藉在，笔驱造化，夕照虹霓。\n暂徘徊、莲幕名誉交驰。\n行继夔龙步武，蓬山静、玉宇春迟。\n当清夜，神交大一，相对熟青藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偈","author":"印首座","text":"丘师伯莫晓，寂寂明皎皎。\n日午打三更，谁人打得了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋情","author":"慧姞","text":"自怜新髻好，对镜久夷犹。\n回首瞥见郎，含羞整搔头。\n花间并郎行，低说夜来话。\n蝴蝶学娇痴，飞来傍裙带。\n羡杀叶底花，色娇香不漏。\n安得郎如叶，长将玉肌覆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"蕲春乡人","text":"园客有丝难比瓮，鲛人无杼自成绡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"醉客","text":"行尽蓬莱弱水源，今朝忍渴过昆崙。\n兴来莫问酒中圣，且把金杯和月吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田横墓","author":"懒云","text":"荒冢临歧尚隐然，春风吹绿草芊芊。\n牧儿乱唱黄昏后，犹似悲歌薤露篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烛影摇红","author":"懒堂女子","text":"绿净湖光，浅寒先到芙蓉岛。\n谢池幽梦属才郎，几度生春草。\n尘世多情易老。\n更那堪、秋风袅袅。\n晓来羞对，香芷汀洲，枯荷池沼。\n恨锁横波，远山浅黛无人扫。\n湘江人去叹无依，此意从谁表。\n喜趁良宵月皎。\n况难逢、人间两好。\n莫辞沉醉，醉入屏山，只愁天晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙华山","author":"懒渔","text":"梵王宫倚市廛开，波劫何曾断俗埃。\n百万源流归海会，三千世界属如来。\n老龙收雨藏香钵，野鹤听经绕法台。\n闻道题名还有塔，熙宁四老总多才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四穿楼 其一","author":"廖德明","text":"四壁无遮碍，凭阑豁远胸。\n何须高百尺，亦可卧元龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四穿楼 其二","author":"廖德明","text":"南北东西四望开，熙熙人似上春台。\n时平不用筹边策，閒看双江抱郭来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郁林郡城","author":"廖德明","text":"荒烟漠漠双江上，往事悠悠古戍孤。\n春到偏临青草渡，梦中犹记白鸥湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南楼","author":"廖德明","text":"三里之城渺大荒，两江横截壮金汤。\n唐家设险基犹在，圣代增陴虑更长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饯陈随隐归临川","author":"吴大有","text":"我昔见君方成童，长吉才华惊钜公。\n人间科第不屑就，直使声名闻九重。\n乃翁引上凝华殿，子虚不待他人荐。\n入直来来凡几年，天上奇书尽曾见。\n翩然归去大江西，二疏父子还相随。\n故乡分得云水地，却喜不爽渔樵期。\n春雨骑牛对烟草，何如振衣随龙五云表。\n秋霜黄独煨地炉，何如驼峰犀箸食天厨。\n林间拾叶抄诗句，何如宫妃捧砚挥毫处。\n溪边照影著荷衣，何如龙门应制夺锦时。\n钧天梦断难回顾，浩然合在山中住。\n金石台前伴白云，六年不踏西湖路。\n今日重来发长吁，忍看清平破草庐。\n尽拈书籍向人卖，归买田园供荷锄。\n乃翁八十齿发落，倚门待儿斜日薄。\n孤山梅花带不归，却唤扁舟载童鹤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨梅洲别墅","author":"燮元圃","text":"枯桑败叶集寒鸦，篱落芙蓉晚见花。\n有客归来新作主，钓鱼湾处是生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过锦湾望岳亭","author":"燮元圃","text":"十载重来一凭栏，光阴不改旧江山。\n亭高下瞰龙藏室，天远遥瞻虎拜班。\n耕钓每怀生处乐，驰驱未许老来閒。\n雄风入座披襟好，静看渔舟上锦湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瀛岩","author":"董荆楚","text":"岩根商舸集高桅，岩顶朱门小殿开。\n未信瀛洲环弱水，始知鳌背负蓬莱。\n青山到海重重小，白鸟随潮两两来。\n坐久松风吹骨冷，此身浑觉在瑶台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"妙庭观","author":"麋师旦","text":"不寻铜鼎不求丹，从许琉璃碎旧盘。\n阿母堂前几春梦，耳边犹听玉笙寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一剪梅","author":"醴陵人士","text":"宰相巍巍坐庙堂。\n说着经量，便要经量。\n那个臣僚上一章，头说经量，尾说经量。\n轻狂太守在吾邦。\n闻说经量，星夜经量。\n山东河北久抛荒，好去经量，胡不经量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 孟史君祷而得雨","author":"臞翁","text":"祷雨文昌，只全靠、心香一瓣。\n才信宿，沛然膏泽，来从方寸。\n早稻含风香旖旎，晚秧饱水青葱茜。\n问螺江、恰见线来流，今平岸。\n君作事，看天面。\n天有眼，从君愿。\n信瑞莲芝草，几曾虚献。\n此雨千金无买处，丰年饱吃君侯饭。\n管酿成、春酒上公堂，人人献。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题衢州驿舍","author":"衢州士人","text":"午夫荷担在山阿，膏血如何有许多。\n不若扁舟竟归去，休从清献墓前过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南龛山","author":"郑之才","text":"一本修楠出万蓬，挺生绵邈尚谁穷。\n胡为壮烈思严老，雅爱甘棠学召公。\n怀德自应存庇荫，企贤那不念英雄。\n要知遗躅传无尽，时听龛崖度远风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 贺人妾生子","author":"丁几仲","text":"喜溢蟾宫梦。\n起推衣、平章宝桂，湿鸦飞动。\n果报佳音传络秀，丹穴雏生彩凤。\n想孔释、亲来抱送。\n不羡徐卿秋水澈，试闻声、识破真英种。\n培杞梓，待时用。\n当年绛帐承新宠。\n问何如归来，碧荷香重。\n都是刘郎看承处，多少温柔从臾。\n会起我嘉宾钦竦。\n左氏公羊，从初所学，看家传、声誉今腾涌。\n拚醉舞，与谁共。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"松岭","author":"丁大容","text":"十里城西松岭庵，每经过此便怀惭。\n此山若有归耕地，肯坠嵇康七不堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"澄心轩","author":"丁天锡","text":"高馆含秋溪水平，白云一榻临空清。\n云影天光入怀抱，玉楼银阙无人行。\n滔滔活水源头落，却笑奔流争万壑。\n雪照梅檐坐月明，露泻荷盘见鱼跃。\n长安车马多富儿，汗流浃背尘满衣。\n谁识君心有真乐，沙头白鸟犹忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"可惜","author":"丁开","text":"日者今何及，天乎有不平。\n功高人共嫉，事定我当烹。\n父老俱呜咽，天王本圣明。\n不愁罹党祸，携泪向孤城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"扬州岁莫","author":"丁开","text":"万国春回日，层成晚眺馀。\n江声隔吴楚，原色到邳徐。\n大阅军容壮，狂歌客礼疏。\n百年寒荻里，风雨忆吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建业","author":"丁开","text":"谁遣凄凉满眼中，蘋花渺渺又秋风。\n龙蹲虎踞江山大，马去牛来社稷空。\n纵有千人惟诺诺，本无百岁更匆匆。\n乾坤颠倒孤舟在，聊复残生伴钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漂泊岳阳遇张中行因汎舟洞庭晚宿君山联句","author":"丁开","text":"元气无根株，地脉有断绝。\n日月互吞吐，云雾自生灭。\n楚妃结幽想，巴客答清吷。\n宁知莽苍中，不假巨鳌力。\n势阅南纪浮，思随西风发。\n形影寄孤舟，吾道成鴃舌。\n笑谈正凌傲，俯仰不偪侧。\n每与景物会，未省欢娱毕。\n叠翠晚愔愔，堕黄秋的的。\n鱼龙负赑赑，独鸟去不息。\n旷原眇周抱，异境超慌惚。\n径度万顷空，忽得一拳碧。\n稍稍鸡犬近，依依钟梵夕。\n推门月微堕，煮茗香初歇。\n衣裳识霜信，瓶钵了禅悦。\n事定心源清，梦回斗柄直。\n周游兴欲尽，长往计未决。\n出门更回首，沙水荡虚白。\n美哉神禹功，已矣三苗国。\n山川长不朽，愚智俱可惜。\n神交正冥冥，指点空历历。\n慎勿语俗人，桃源恐相失。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 其二","author":"丁无悔","text":"偃屋霜清，棱层烟碧，玲珑移在人间。\n山光林色，常伴主人闲。\n元有仙风道骨，无心趁、玉简朝班。\n归来赋，不因五斗，谈笑挂衣冠。\n尤难。\n谁不羡，商山橘乐，湄水渔竿。\n引相君王子，助发幽欢。\n满泛寿觞多祝，南溟共、比海波澜。\n君知否，庙堂有意，相与问寒岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 其一","author":"丁无悔","text":"道格天渊，令行海岳，凛然名德尊崇。\n云烟千里，分付笑谈中。\n川后波神效职，潮声细、一鉴涵空。\n风樯便，蛮珠贾舶，累译更遥通。\n雍容。\n廊庙手，蓍龟先见，日月精忠。\n自丛机初解，眷渥尤隆。\n共道奇庞福艾，衮衣到，宁久居东。\n谯门晓，高牙大纛，辉映醉颜红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵何安节抚机","author":"丁木","text":"送别邗江路，梅花作暮愁。\n关情何水部，回首古扬州。\n雁影明寒水，冰凘涩去舟。\n想应今夜宿，霜月满瓜洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汴邸","author":"丁氏","text":"西岭雌雄鸟，双双览德辉。\n阳台迟雨散，沧海会尘飞。\n夜月参差玉，春云窈窕衣。\n君王宴阿母，却寄碧桃归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"少永少云二弟对弈","author":"丁世昌","text":"平处须忘险，危时好计安。\n兴亡关一著，慎勿等閒看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]