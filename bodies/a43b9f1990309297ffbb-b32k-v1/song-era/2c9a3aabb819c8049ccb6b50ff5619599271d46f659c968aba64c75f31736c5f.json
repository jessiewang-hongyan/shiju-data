csv","pointer":17303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和谹父分洞庭柑","author":"王洋","text":"林屋仙丹色外妍，清泉香雾总堪怜。\n不知自落人间后，三寸黄金直几钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和谹父楼字","author":"王洋","text":"共醉元龙百尺楼，方知尘世已高秋。\n举头把酒问明月，许我乘风归去不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾吉父以诗谢郑顾道送酒二首 其二","author":"王洋","text":"南浦红蕖色欲然，北山僧枕梦无边。\n醉乡境界无南北，不用移封向酒泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾吉父以诗谢郑顾道送酒二首 其一","author":"王洋","text":"文人运化得天然，九酝香醪自日边。\n分与诗人浇舌本，不妨石涧一杯泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾吉父求梅于谹父二章 其二","author":"王洋","text":"春入茶山梦未回，闲情独爱一枝梅。\n团圞要共邻僧借，不怕铜瓶带月来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾吉父求梅于谹父二章 其一","author":"王洋","text":"沙觜冰消水上波，春风初不奈梅何。\n雪中犹恐迷真色，残雪如今得似么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾吉父酬郑顾道韵","author":"王洋","text":"古涧久无轩冕梦，茶山参遍古今诗。\n江湖风月闲天地，不爱牙旗爱酒旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾谹父约八月十六日看月","author":"王洋","text":"海上群仙锦旋襕，舞馀掷出紫金盘。\n人心自爱休分别，未必全输昨夜看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾谹父庚伏书怀六首 其六","author":"王洋","text":"申郎句法祖师意，取玉凿山开混茫。\n疏帘清簟半云雨，卧听天籁生虚凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾谹父庚伏书怀六首 其五","author":"王洋","text":"皇家休符彻象纬，河上五老飞人间。\n即今三老不住世，赖有两峰高玉山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾谹父庚伏书怀六首 其四","author":"王洋","text":"仙翁服食久遗年，且作童儿戏眼前。\n井上辘轳休轧轧，檐间风露自溅溅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾谹父庚伏书怀六首 其三","author":"王洋","text":"绿漪平涨小桥头，红蓼花鲜杜若洲。\n便唤画师来貌取，不须云梦泽南州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾谹父庚伏书怀六首 其二","author":"王洋","text":"吴兴水郭芰荷堤，别后扁舟去岸迷。\n莫讶道人新活计，亦看粉面照清溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾谹父庚伏书怀六首 其一","author":"王洋","text":"垣衣侵砌竹穿墙，日日萧条气运凉。\n急雨满池鸣两部，幽奇不独水云乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赋千叶桃花二首 其二","author":"王洋","text":"才喜寻春又惜春，寻春眉展惜春颦。\n莫将颦笑为花用，处处平芜是醉裀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赋千叶桃花二首 其一","author":"王洋","text":"驺玉团香移宝绡，凌风浥露势惊飘。\n从教不结千年实，且看尊前一味娇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赋秋声","author":"王洋","text":"初传岩谷声犹静，乍转松篁韵更清。\n莫遣幽人破幽梦，梦中荣辱一般轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建炎八月乘家舟往来龟山","author":"王洋","text":"张侯无居寄岸上，志和有意学浮家。\n我今乘舟任来去，便应随处为生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"明日沈干送花二枝续一章","author":"王洋","text":"暖风吹得也轻狂，连夜争开有底忙。\n困恨兰宵留宿酒，笑濡晓露试新妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦寒得酒二首 其二","author":"王洋","text":"鲲鹏蜩鴳子知不，小大形殊各有俦。\n取醉尽情师李白，放言极力问庄周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦寒得酒二首 其一","author":"王洋","text":"因雪成寒势未收，及时一醉比封侯。\n阳功亭毒无人见，已有春光亦信不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑吏部开山路成二岩对棋于上因成二诗 其二 白云洞","author":"王洋","text":"棋局随空破碧雰，上方剥啄下方闻。\n方圆变化知多少，笑杀先生洞里云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑吏部开山路成二岩对棋于上因成二诗 其一 寿松岩","author":"王洋","text":"向来本为买山田，饶得青松不费钱。\n更向青冥斸峰顶，放教南斗照臞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑顾道惠腊梅二首 其二","author":"王洋","text":"长垂月帔别天阶，剪作金钟应律灰。\n世上语言无入处，好从天上觅诗来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑顾道惠腊梅二首 其一","author":"王洋","text":"一种佳名两字猜，蜜脾融液腊中开。\n雪花不敢迷真色，风格都缘不是梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金山","author":"王洋","text":"突兀波心倚翠空，他年金碧照鱼龙。\n火烧水转休惆怅，且看中流树荫浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"两小人相凌","author":"王洋","text":"负担相随语笑同，不分强弱便相攻。\n若无三尺齐民律，旷野何人是长雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]