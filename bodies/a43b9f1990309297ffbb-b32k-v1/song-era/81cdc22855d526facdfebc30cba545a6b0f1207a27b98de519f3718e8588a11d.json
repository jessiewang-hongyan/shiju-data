[{"title":"再和雁湖十首 其八","author":"李壁","text":"绕城流水碧潺潺，好是芳菲一月间。\n诗阵不收疑破竹，谈围未解递连环。\n健如俊鹘秋翻野，壮似惊龙夜擘山。\n传后化今当有待，百年距几可今閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和雁湖十首 其七","author":"李壁","text":"作诗真是学文馀，馀力犹将鲍谢俱。\n流俗是非何足算，古人出处要良图。\n闲来籍草须寻侣，自起浇花不倩奴。\n著却纶巾披鹤氅，中郎元住曲阿湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和雁湖十首 其六","author":"李壁","text":"流光匆匆泪潺潺，又报清明瞬息间。\n暖日陂塘空荇带，薰风时节近瓜环。\n谋非为食宁忘世，懒不从人但爱山。\n想见长安五陵道，少年袍马逐宽閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和雁湖十首 其五","author":"李壁","text":"总角趋庭得绪馀，诗书元自与生俱。\n词林教诵鹪鹩赋，画苑嗔传蛱蝶图。\n千古凌烟思郑国，一时偃月怨哥奴。\n情和颜蹠均为寄，忍絜新樽上镜湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和雁湖十首 其四","author":"李壁","text":"梦回檐溜响潺潺，断送群芳一夕间。\n静见蜂须拈笔架，细看蛛网度窗环。\n数行古篆留科斗，一穗沉烟起博山。\n终岁掩关非避俗，自缘多病爱清閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和雁湖十首 其三","author":"李壁","text":"翠华南度几千馀，始见中原与闰俱。\n千载一时周历数，两河百郡汉舆图。\n平南上策归诸葛，伐北奇功属寄奴。\n安得忠良负雄略，一清关洛到江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和雁湖十首 其二","author":"李壁","text":"畦径生痴笔墨间，洗心聊欲近潺潺。\n干时辄莫谈商鞅，枉道渠宁主瘠环。\n无事捲帘消白日，有时支枕梦青山。\n湖光莫笑无多子，印却中天象纬閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和雁湖十首 其一","author":"李壁","text":"观物年来等腐馀，已甘事与众人俱。\n园林得地须频赏，冕绂关天莫浪图。\n好事难陪金谷友，穷居祇辨玉川奴。\n亲逢圣世生非晚，不比当年孺子湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘子澄约游汉阳郎官湖子澄风雨中绝江先去余泊舟黄鹤楼下风大不可进因成七言为寄","author":"李壁","text":"沔水悠悠下武昌，向来风物未凄凉。\n江楼还对辽天月，湖草犹分汉署香。\n信笔题诗输李白，开樽一笑后刘郎。\n蹇余终日凭高望，吊古怀人几度伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张季长红梅七言三首 其三","author":"李壁","text":"雪里横枝冻不禁，故将浓丽变轻盈。\n色分鹤顶真如醉，影借蟾辉也自清。\n晚觉郑公殊妩媚，生憎夷甫太鲜明。\n上林依旧群芳首，翻笑唐昌浪得声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张季长红梅七言三首 其二","author":"李壁","text":"琳馆清閒异马曹，红梅折得助挥毫。\n眼明北客初疑杏，笑倚东风亦类桃。\n露浥檀心滋鼎实，春生玉面散宫醪。\n从今约略施丹粉，未害从来品格高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张季长红梅七言三首 其一","author":"李壁","text":"江路悠悠无驿使，道南特寄惬公心。\n似嫌大洁惊凡卉，故染轻红伴醉吟。\n绝艳偷春来雪径，绛葩翻露出琼林。\n病馀不得陪真赏，祇玩新章抵碎金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过汉州留房公湖一日戏和少陵韵二首 其二","author":"李壁","text":"子美来湖上，篇篇只爱鹅。\n昔年惟有此，佳处总无多。\n竹径萦新筑，荷池引旧波。\n不应悭五字，共和有阴何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过汉州留房公湖一日戏和少陵韵二首 其一","author":"李壁","text":"西湖天下胜，贤相古来稀。\n汛扫邀明月，徜徉逗落晖。\n蒲深鸂鶒响，林静鹧鸪飞。\n脚力应难遍，雕栏幸可依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余十岁时从亡兄仲氏侍先父摄帅江陵郡圃蜡梅数百株一昔盛开予为记之仲兄颇赏爱以为工今十六七年矣属感前事重赋七言以纾余悲","author":"李壁","text":"病眼清晨欲泫霜，谁将幻色对山房。\n十年犹记湖阴梦，几度愁闻汉苑香。\n腊雪近春才一白，好花得地更深黄。\n祇应无复当时意，草木何知我自伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"季允用韵各赋两章予亦再赋四首 其四","author":"李壁","text":"春至题诗满竹间，晚风窗影漾潺潺。\n水花未放红千叶，岸柳先教绿四环。\n陶令当年惟北牖，谢公早日便东山。\n古来豪杰非无意，尽把功名付等閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"季允用韵各赋两章予亦再赋四首 其三","author":"李壁","text":"囊空那复冀赢馀，但有巍楼百尺俱。\n匣镜频开聊自玩，庭芜不扫欲何图。\n少缘多病辞欢伯，长更贪眠谢酪奴。\n生世所资能几许，一竿好在石鱼湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"季允用韵各赋两章予亦再赋四首 其二","author":"李壁","text":"碧瓦城中一万间，溜渠无处不潺潺。\n凫眠落日沙留篆，鱼蹙轻冰玉破环。\n细草争春空满路，孤云未雨莫归山。\n寓言聊以忘忧耳，进德渠教一刻閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"季允用韵各赋两章予亦再赋四首 其一","author":"李壁","text":"新阡泪叶记霜馀，早见春风万壑俱。\n姱节当时谁鹗立，故人今日半鹏图。\n清谈我不如平子，下策君元笑阿奴。\n此地对床先有约，莫教风雨隔重湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"知府丈袖赐新篇愈叹精奇勉缀俚辞干览采","author":"李壁","text":"书边惯度短檠宵，心和南山扣角谣。\n霢霂几随风入夜，荧煌行见日升朝。\n自怜镜里吴霜满，难敌毫端海蜃摇。\n好是濉阳桃李树，春风新照玉麟腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"知府李大谏特枉新诗存问甚厚以谢","author":"李壁","text":"盖代今推骨鲠臣，朝来有使到漳滨。\n稍谙逆境宁非梦，不隔寒荄始是春。\n菜甲旋锄聊诳口，茅堂新葺且怡神。\n故应犹喜斯文在，风雨鸣鸡夜向晨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金石山林宣参山房","author":"李壁","text":"高处浑无一点尘，平川极目净于茵。\n松声满院日亭午，世味著人谁识真。\n倘乞半岩容卜筑，仍留别浦待垂纶。\n寒灰岂复重然望，独爱新诗语不陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送梁漕帅夔二首 其二","author":"李壁","text":"先声凛凛慑乌蛮，舟引旌旗略万山。\n白帝城头风日好，永安门外水云閒。\n功名可致身为重，富贵相寻发未班。\n千古江濆卧龙在，请公携酒数开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送梁漕帅夔二首 其一","author":"李壁","text":"天涯留滞几星霜，两见飞来诏版黄。\n止水无私陶静冶，干将不露起颓纲。\n拭看远服恩波被，转觉朝家德意长。\n持此便应归法从，色丝先补舜衣裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钱史君见赠元夕新什次韵答之","author":"李壁","text":"元夕风光付湿薪，更堪门外雨如尘。\n千枝宝炬知何处，一寸清愁苦傍人。\n落纸惊蛇空妙墨，中庭独鹤漫閒身。\n青藜不照蓬莱阁，云断苍梧怆百神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄陵题咏二首 其二","author":"李壁","text":"小哀洲北渚云边，二女明装共俨然。\n野庙向江空寂寂，古碑无字草芊芊。\n东风近墓吹芳芷，落日深山哭杜鹃。\n犹似含颦望巡狩，九疑凝黛隔湘川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湛庵出示宪使陈益之近作且蒙记忆再次韵一首适王令君国正携酒相过断章并识之有便仍以寄陈也","author":"李壁","text":"重将倦翼羾天关，流浪深惭佛眼看。\n名宿青灯仍燕坐，故人白雪自幽弹。\n西江一吸还居士，寒涕双垂任懒残。\n应笑区区话陈迹，秋风吹老碧芦滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雁湖二首 其二","author":"李壁","text":"新结方桥跨两间，更渠清溜作潺潺。\n春来得句因池草，病起无端减带环。\n楼迥却愁多见月，城高元不碍看山。\n销忧况有诗书在，赢得湖边日日閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雁湖二首 其一","author":"李壁","text":"藻荇连延十亩馀，从来佳致与人俱。\n水禽扑碌时惊枕，城月朦胧当画图。\n莫去渚兰留作佩，剩栽洲橘遣为奴。\n从今杖屦频来往，乞与嘉名唤雁湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"为刘漫翁老人赋云月高斋诗","author":"李壁","text":"嵇康遇王烈，幽愤竟莫摅。\n我今识漫翁，转欲与世疏。\n况闻高斋胜，云月随卷舒。\n息深固以踵，道集其惟虚。\n一朝破生死，直到心地初。\n嗟我觉既晚，尚收废弃馀。\n疑翁乃真契，百里纡柴车。\n谓我骨本好，误落尘寰居。\n已障不自解，顾遣他人除。\n稽首谢至言，田荒始知畬。\n虽微跪履敬，脱粟荐霜蔬。\n翁早涉文史，雅意追严徐。\n中睹世路恶，纷纷臭如帤。\n回光述鸿宝，妙解超堪舆。\n启钥借我读，恍梦犹华胥。\n匪惟见异人，乃复得异书。\n穷途有良遇，喜极还欷歔。\n居然困缰锁，阻造焦生庐。\n后会岂无日，碧霄揽霞裾。\n不见垂天翼，变化本鲲鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月十八日作","author":"李壁","text":"三伏已过二，九夏欲宾秋。\n月林疏梧响，露圃幽花稠。\n故人有晁子，高諠今前脩。\n胜地能馆我，衰疾于焉瘳。\n山寂便午憩，井冽共晨滫。\n坟素共偃蹇，几杖亦夷犹。\n嗟哉作田苦，斛水车轮抽。\n暮歌宛如笑，达旦不肯休。\n新谷幸稍登，惧贻晚禾忧。\n安得荡尘?，倒卷天河流。\n生意浃万物，仁风扇九州。\n老馀亦苏醒，翛然脱笼囚。\n眷言南山曲，仙袂追浮丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东帅少才兄宠贶七言一首口占八句以谢","author":"李壁","text":"辛苦灯窗少日同，未应岁晚马牛风。\n匡山何敢杜陵敌，子贡还怜颜巷空。\n红旆碧油虽贵重，清泉白石也英雄。\n长哦缺月长江句，总是霜须六十翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北园酌酒观鹤","author":"李壁","text":"仰看翔翮俯游鳞，物意落落各自春。\n遥想沧浪五君子，长身玉立伴闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月十八日送连帅毋丘厚卿三圣院即事","author":"李壁","text":"送客来山寺，客去独凭栏。\n新篁已解箨，瑩眼青琅玕。\n玉台居上头，连峰郁巑岏。\n清泉动古甃，凉飔发轻纨。\n黄云刮欲空，子规鸣声酸。\n秋种亦已布，豆菽行漫漫。\n诚知藩寄忝，但愿农亩安。\n归路转沙碛，广川浩澄澜。\n物色固自好，我忧何当宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题王才臣南山隐居六咏 其一 庄敬日强斋","author":"杨万里","text":"居人晏犹眠，行子夕未宿。\n此心从何生，却道力不足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庄敬日强斋二首 其一","author":"李壁","text":"人情乐安肆，昼夜物欲婴。\n惟敬以直之，山立而川行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过昭君村赋诗","author":"李壁","text":"王嫱南郡良家子，靓饰丰容照江水。\n何人引入光明宫，绿鬓云鬟朝暮理。\n增成亦拟备充依，反向阴山嫁胡儿。\n阴山一去归无期，塞雁南翥马北嘶。\n当时送往穹庐底，安得属车藏豹尾。\n何如滩头媲东家，石上持竿钓游鲤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"严泰伯出示诚斋五诗属予继声奉呈一首","author":"李壁","text":"为爱比邻好，诛茅试结庐。\n地临平楚回，堂枕一峰孤。\n乞予青霞佩，斟吾白玉腴。\n行行对金马，谨莫戏侏儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"投壶","author":"李壁","text":"弯弧力不任，棋局思虑费。\n不如习投壶，闲暇可观礼。\n心精手斯应，古谓射之细。\n无宁贵巧得，近取直如矢。\n瀛洲远尘雾，永日但书几。\n相携千步廊，百发皆贯耳。\n兢兢图克终，一瞬有成毁。\n昔贤著新裕，取正斥奇诡。\n造次垂令仪，高山劳仰止。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青神道中","author":"李壁","text":"沧江掩映桤树林，宝塔崷崒孤云岑。\n田家春时相劳苦，结社分朋宴箫鼓。\n道边儿女齐唱词，钗梁复挂一钩丝。\n相携却踏溪桥路，荠麦连云住何处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"格斋","author":"李壁","text":"一物具一理，皆有极则处。\n索焉而不精，于德何所据。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真州元夕和韵二首 其二","author":"李壁","text":"通宵风撼天，清晓雪压蓬。\n苍茫烟海涯，寂寞葭苇丛。\n龙骧水犀手，有亦安所事。\n洪波绛鼍翻，阴穴翠螭睡。\n孰能乘此险，惟应汉戈船。\n烱烱眸电闪，摇摇心旆悬。\n排烟把盏笑，铁瓮高了了。\n阴云欣解剥，丽日廓清照。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真州元夕和韵二首 其一","author":"李壁","text":"璧月舒金波，流光入窗蓬。\n江水碧杳杳，淮山直丛丛。\n牢落亦清甘，繁华儿辈事。\n一褐拥春寒，倦拨青编睡。\n绛纱眩纨绮，箫鼓沸隔船。\n龛灯独耿耿，静对花双悬。\n更深共语笑，为客何时了。\n纷兮总浊恶，文字有潜照。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游西湖分韵得栖字","author":"李壁","text":"深居独痴坐，愁听鹎鴂啼。\n起寻尘外游，绿阴已连畦。\n撑舟泛湖去，万顷青玻瓈。\n天风振云杪，飞步凌丹梯。\n同游金玉人，旷荡追阮嵇。\n更摛江鲍思，杰句竞吐霓。\n刘侯冥鸿侣，松菊思故栖。\n岂为稻粱谋，如彼凫与脩。\n维之永今夕，胜游共攀跻。\n行将著清班，奇字从君稽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登拟岘台诗","author":"李壁","text":"羊公洙泗人，易地即颜子。\n功名真馀弃，邂逅照图史。\n况复权利间，何啻鼠肝似。\n武库偶并称，相去不知几。\n台倾属新葺，天远暮山紫。\n佳月唤我来，抛却乌皮几。\n莫言风景非，世本无真是。\n有酒即宜城，有鱼斯汉水。\n殷勤一樽共，清唱切云起。\n羁旅聊自纾，高兴未渠已。\n银河帘旌接，斗柄屋山指。\n侧闻急才秋，便坐引奇士。\n但遣君意陈，流落非予耻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋黄香梅绝句八首正月二十三作时筑楼居将就 其八","author":"李壁","text":"一种清香属当家，将黄对白本非差。\n胡床十日花前坐，看得楼成管物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小重山 数椽甫葺，知府载酒宠临，辄次日近环湖所赋韵为一杯寿","author":"李壁","text":"燕雀风轻二月天。\n一枝何处是家园。\n有花不惜是谁怜。\n生嫌怕，不为老人妍。\n眉黛拥连娟。\n高情时载酒、雁湖边。\n略无雕饰自天然。\n新诗好，品第入朱弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"好事近 饯交代劝酒","author":"李壁","text":"莫惜一樽留，共醉锦屏山色。\n多少飞花悠扬，送征轮南陌。\n曲湖归去未多时，还捧诏黄湿。\n生怕别来凄断，看满园行迹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江神子/江城子 劝酒","author":"李壁","text":"露荷香泛小池台。\n水云堆。\n好风催。\n宝扇胡床，无事且徘徊。\n帘外海榴裙一色，判共釂、两三杯。\n此怀能得几番开。\n玉山颓。\n不须推。\n回首慈恩，前梦老堪咳。\n好是上林多少树，应早晚、待公来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 和提刑昂席新赋","author":"李壁","text":"又送鹏程轩翥，几看驹隙推移。\n多端时事只天知。\n不饮沈忧如醉。\n白首已甘蓬艾，苍生正倚丞疑。\n楚台风转一帆吹。\n朝列问君来未。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归 劝袁制机酒","author":"李壁","text":"苏台一别费三年。\n锦书凭雁传。\n风姿重见阆江边。\n玉壶秋井泉。\n翻短舞，趁么弦。\n篆香同夕烟。\n多情莫惜为留连。\n落花中酒天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 偶与子建小酌，知府秘书惠然临顾，此一段奇也。辄成小阕，呈二使君","author":"李壁","text":"紫绶新符竹，叶赪老弟兄。\n西风吹棹过湖亭。\n杨柳夫渠相伴、也多情。\n况是瀛洲侣，来同酒盏倾。\n白沤浑不避双旌。\n一种风流人似、玉壶清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 人日过灵泉寺次韵少壮","author":"李壁","text":"只记梅花破腊前。\n恼人春色又薰然。\n山头井似陆公泉。\n上客长谣追楚些，娇娃短舞看胡旋。\n崇桃积李自年年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 人日蟆颐席间和韵","author":"李壁","text":"东风歌吹发重闉。\n飞旆入山新。\n小雨不妨酥润，江头一并霜晴。\n年年心似，输他钗燕，蟠带迎春。\n怎得尊前避酒，史君精鉴如神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 燕史君席间和韵","author":"李壁","text":"岸柳阴阴跃锦鳞。\n并湖莲子恰尝新。\n谁教故岁应官去，会老堂中少个人。\n归未久，意弥新。\n吹香不断酒倾银。\n行藏判已天公付，且斗而今见在身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"李壁","text":"莫令归往地，翻作杀胡林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"李壁","text":"向来交态云翻手，静里无言石点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"李壁","text":"鸦健触翻红蔌蔌，鸥閒占断碧粼粼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"李壁","text":"平生阅世朦胧眼，偏向白鸥飞处明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"李壁","text":"三十六峰今入手，若无公事且留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"李壁","text":"忧时铁石孤忠在，阅世风花老眼空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"李壁","text":"一杯谩道愁能遣，几度醒来错唤君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":65944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]