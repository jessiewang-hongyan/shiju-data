[{"title":"睡起","author":"葛绍体","text":"西风搅雨十分秋，谁驾秋涛汗漫游。\n日午小窗初睡起，一回魂梦到沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"锦园晚雨","author":"葛绍体","text":"一围蜀锦万花枝，红绿相携傍酒卮。\n不必夜深来秉烛，满庭风雨湿胭脂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘲蛩","author":"葛绍体","text":"浮沙篱落乱鸣蛩，永夜相寻客梦中。\n尽是秋风借馀力，声声却似怨秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题天庆观","author":"葛绍体","text":"淡云疏雨嫩凉天，老柏梢头挂瘦猿。\n仙殿崔嵬钟磬响，纸钱灰起祭中元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题四清枕屏","author":"葛绍体","text":"横梅枝下兰为伴，瘦石拳边竹更长。\n月上小窗人欲静，睡来清入梦魂香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题丽句亭","author":"葛绍体","text":"王谢风流盟未寒，枝藤杯酒翠微间。\n松花半落春山暮，云满一溪春水闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题戒珠寺竹阁","author":"葛绍体","text":"松雪半梢寒鹊语，风敲疏竹度斜阳。\n幽寻有客自来去，静对僧禅一缕香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题松竹梅画扇","author":"葛绍体","text":"扇招三友亦风骚，淡墨萧疏雨露梢。\n不止暑天凉意足，爱他曾耐岁寒交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题秋风亭","author":"葛绍体","text":"稻镰影尽云垂野，衣杵声高月满空。\n春在万家歌笑里，不知亭上有秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题赵献可抚干池亭","author":"葛绍体","text":"浸碧虚亭烟水中，参差荷渚小桥东。\n露花相对立清晓，闲里丝桐歌舜风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题越人贺韩司户令子得举诗卷","author":"葛绍体","text":"一鹗秋风东越初，龙门春浪少踌躇。\n客来多说新河过，古柳阴中闻读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题韩伯直顺斋","author":"葛绍体","text":"路似直弦万古新，平吾方寸是经纶。\n一元静展凭何力，日月序行天地春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题韩季默春山图","author":"葛绍体","text":"春山一簇带春云，楼阁高低日欲曛。\n骑马棹船游冶客，一天风月自平分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题新安汪氏心远亭","author":"葛绍体","text":"来傍蓬莱夜读书，盂山相对是吾庐。\n不妨车马自来去，一片闲心泊太虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鹤","author":"葛绍体","text":"丹顶低回疑舞水，雪翎高展欲排云。\n也知尔得闲中趣，较得能闲更几分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠休斋沈老丈 其二","author":"葛绍体","text":"酒边风月是诗情，平淡精神最老成。\n每爱晋人标韵别，发挥天趣更渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠休斋沈老丈 其一","author":"葛绍体","text":"澉浦东南海面横，惯看潮落又潮生。\n嫌渠万里风波险，心地一生平处行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠黄友把酒东皋三首 其三","author":"葛绍体","text":"东风鹭影几横斜，晚日飞来漾雪华。\n好伴闲身春雨里，一川烟雨落梨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠黄友把酒东皋三首 其二","author":"葛绍体","text":"风光依约上征帆，云影参差带远山。\n野岸水平耕钓足，镜湖消得一春闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠黄友把酒东皋三首 其一","author":"葛绍体","text":"野水平流一带斜，去来征棹几年华。\n东风又染山光绿，好拂丝纶钓浪花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日登真如阁","author":"葛绍体","text":"云阁凭高起暮愁，西风吹作帽檐秋。\n烟林回薄地欲转，水国苍茫天共浮。\n富贵从来联后乘，行藏何处借前筹。\n东篱又负黄花约，新月光中一献酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早发西城即景","author":"葛绍体","text":"天台今日去，步步紫云乡。\n麦浪涨新绿，花风吹旧香。\n屏开千嶂远，带绕一溪长。\n游冶谁家子，酣歌古道傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵杜十三丈","author":"葛绍体","text":"双溪风月只当年，客梦寻君屡慨然。\n万里青云谁览镜，一窗黄卷自鸣鞭。\n病馀念此怀忧乐，醉里从其号圣贤。\n多少离情那写似，排空烟柳绿无边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卧病","author":"葛绍体","text":"攲枕小春雨，虚屏半夜风。\n病惊身是客，愁恐鬓成翁。\n窗曙逗微白，灯寒带浅红。\n归期倩谁卜，心挂浙江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后到芙蓉村","author":"葛绍体","text":"又上篮舆去，西风暂放晴。\n雾深孤屿没，日薄片云明。\n诗思通山色，琴怀澹客情。\n悬知百里路，分作两三程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晓访客","author":"葛绍体","text":"述作当经纶，孤灯坐到晨。\n笑迎东海日，唤起北窗人。\n露滴烟梢静，鸟啼花径春。\n自怜身是客，与客谩相亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洵上人房","author":"葛绍体","text":"自占一窗明，小炉春意生。\n茶分香味薄，梅插小枝横。\n有意探禅学，无心了世情。\n不知清夜坐，知得若为清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送上蔡谢悔斋赴召","author":"葛绍体","text":"诏趣朝天去，春风半月程。\n西湖花锦重，东越柳绵轻。\n趋走输年少，谋猷让老成。\n边烽半明灭，?亩一关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王伯逢泰兴令","author":"葛绍体","text":"扬子江头路，龟池草色新。\n细调弦上曲，闲拂马前尘。\n远塞秋风静，平畴夜雨匀。\n遥知报嘉政，笑我苦吟身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王秀才同谢德庆行","author":"葛绍体","text":"三千八百里，何自遽成行。\n只重新知己，都忘逆旅情。\n瘴烟随处合，庾岭际天横。\n应有相思泪，清宵梦里惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送林子柄缙云令","author":"葛绍体","text":"交情苦疏阔，君复是行人。\n灯火谁同坐，诗书只自亲。\n丹枫苍岭晓，黄菊好溪春。\n一别三年远，相思入梦频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵紫芝入金陵幕","author":"葛绍体","text":"会面难如此，人生祇自怜。\n笑言无一日，离别有三年。\n故国带秋色，长淮起暮烟。\n官闲足登眺，吟满菊花天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵献可福州抚干","author":"葛绍体","text":"往岁南闽路，曾知幕府崇。\n已先多士列，不与众人同。\n红透荔枝日，香传茉莉风。\n还应飞诏急，催向道山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送高仲发赴铨 其一","author":"葛绍体","text":"不记京华路，西行有几程。\n因君一言别，动我十年情。\n野水涵天碧，山花照眼明。\n春风马蹄急，得意向东城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送高仲发赴铨 其二","author":"葛绍体","text":"多应无旅思，天气正春暄。\n柳送行时路，花迎到处村。\n捷书新得意，诗句旧曾论。\n独坐相思日，东风静扫门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送薛子舒华亭造船场","author":"葛绍体","text":"此日携家去，休言惜远离。\n江天虽雨意，客路正花时。\n击楫漫长啸，把书常自随。\n为官闲亦好，竹外鹤偏宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重阳后五日再和叔愚","author":"葛绍体","text":"不对黄花酒，还添白苧衣。\n沼鳞空细泳，林翼奋高飞。\n气槩今谁是，才华昔已非。\n最怜多病后，衣带褪重围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浸碧亭月夜","author":"葛绍体","text":"夜半横空一片云，云边明月带疏星。\n松关露重惊飞鹊，荷渚风轻低度萤。\n粟缀嫩黄怀老圃，酒篘新绿见虚亭。\n秋吟不作相思调，许我西湖伴醉醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留别永嘉文友","author":"葛绍体","text":"归去是明朝，多应趁早朝。\n虽然邻邑近，亦似客程遥。\n村社酒三杓，山家水一瓢。\n吟边如得句，共语在元宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"袁从道山庐三首 其二","author":"葛绍体","text":"竹屋已三间，花径旋一新。\n芳苞束碎锦，细草铺柔茵。\n曾悟顺动豫，岂叹云雷屯。\n个中足俛仰，世上谁经纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄三衢赵希远","author":"葛绍体","text":"同是他乡客，分携二月初。\n如何近流火，曾不寄来书。\n夜雨青灯暗，晨风黄卷舒。\n相思五字句，惠好莫相疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄谢周西麓国博","author":"葛绍体","text":"三年涕血渍槃蔬，蓬首春风未欲梳。\n客病屡惊几死去，母慈常念有生初。\n乞文西麓标铭墓，立石东山伴倚庐。\n恩到九原那可答，近来和泪看除书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄越中文友","author":"葛绍体","text":"客情无处著，身事定何如。\n秀水且停棹，蕺山终结庐。\n秋风一杯酒，夜雨半翻书。\n把手蓬莱顶，梅花腊月初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道傍酒家","author":"葛绍体","text":"门当海峤开，篱脚破新苔。\n梅影落寒井，渔歌近酒杯。\n客帆云外过，沙鸟雨中回。\n多少风烟趣，从今入梦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩氏与闲即事","author":"葛绍体","text":"堂深暑不到，闲意一炉香。\n棋斗过河急，琴弹流水长。\n古瓶疏牖下，怪石小池旁。\n忠献画图在，英声不可忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韩吏部竹隐亭","author":"葛绍体","text":"秋浦星郎旧隐居，石巢长伴竹萧疏。\n寒窗细酌月来往，暑槛残编风卷舒。\n砚滴净涵天地秘，炉烟闲接水云虚。\n风流格调今犹在，有子挑灯读父书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新昌道中","author":"葛绍体","text":"归路忘羁思，邛枝第共携。\n江船闲载鹤，山店静闻鸡。\n晚稻新收敛，秋花旧品题。\n明朝行几里，应近赤城西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入竹西道院","author":"葛绍体","text":"双桧老虬干，万竹苍龙枝。\n道院傍西筑，书窗下南帷。\n笑谈清灯晕，坐起白麈挥。\n天低月初挂，河澹星欲垂。\n醉生笔砚妍，卧筹民物规。\n蟋蟀唤乡梦，莎鸡引秋思。\n客身休自疑，古人以为期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山台","author":"葛绍体","text":"春晓栏干无数山，山云浓淡去来间。\n湖光一片东城外，鸥鹭相亲风日寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋后二夜对月","author":"葛绍体","text":"中秋竟夕佳月色，万里光芒霜雪白。\n人言阴晴一瞬易，不料清辉连永夕。\n有情傍我书几多，书中今古旧应识。\n玉华婵娟彻鬓眉，冰澌的皪瑩肝膈。\n风流似与仙娥俱，缟衣练裳新洒涤。\n酒酣颠倒欲结交，灯火希微疑避席。\n出门露气已半销，轻风西来荡虚碧。\n中天镜悬见本真，一点灵明透八极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"分水岭","author":"葛绍体","text":"岐路东西分，闽浙自兹异。\n平波翼丛筱，荒丘带深隧。\n渐闻新蛮音，不见旧朋类。\n悽然独含情，谁与话幽意。\n满空霜气横，鸿影过一二。\n回首良不堪，归期数长至。\n茫茫宇宙大，人生本如寄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太湖吟","author":"葛绍体","text":"只饮太湖水，不鲙松江鲈。\n鲈杂鱼虾腥，水涵天地初。\n千里开镜奁，一色包冰壶。\n日月递吐吞，蛟龙相蛰舒。\n上接河汉高，下连溟渤虚。\n中有洞庭山，云气相萦纡。\n我来风雪天，修绠汲自如。\n一饮尘涴清，再饮浇诗书。\n三饮毛发寒，胸次包寰区。\n大禹果至神，彷佛来前除。\n万古不尽流，禹功常与俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水陆寺","author":"葛绍体","text":"松柏苍苍荫碧澜，碧澜深处有龙蟠。\n清闲日月长廊静，惨澹云烟画阁寒。\n林鸟忽鸣疑悟道，石矶危坐似逃禅。\n天台行客东嘉友，一笑春风共倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王深道别酒走笔次韵","author":"葛绍体","text":"取友但闻道，不问年先后。\n西涧吾世交，岂在接杯酒。\n言归复言归，光怪愿袖手。\n楼崎灵泉山，松柏岁寒友。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"头陀岭","author":"葛绍体","text":"峭绝不可步，肩舆屡颠覆。\n南北三十里，上下九回曲。\n两畔沿古松，虬枝乱相续。\n根迸石齿裂，叶密云气宿。\n或一盖高张，或万蛇奔促。\n或魑魅隐见，或虎豹踯躅。\n纵无游子悲，遇此亦惨目。\n鼠梯侧将崩，鸟径深更蹙。\n吾道岂终穷，朅来意何欲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对月简松庐","author":"葛绍体","text":"但爱秋月明，不厌秋夜永。\n掀髯立长风，舞手弄孤影。\n天净神宇清，露重衣袂冷。\n隐约辨山河，分明认奎井。\n一笑震九霄，唤起迷者省。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早起","author":"葛绍体","text":"竹声枕上报平安，曙色依稀隔幌寒。\n风雨满庭人未起，蛛丝斜挂碎珠团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵","author":"葛绍体","text":"吟边逡巡风雨催，秋空萧索声隐雷。\n老松相应发清响，疑伴吹箫仙子来。\n当年作楼远尘务，坊僧执筹工执锯。\n爱他栏槛看云山，不肯匆匆下楼去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江心长句","author":"葛绍体","text":"问津城西市，呼渡江南岸。\n棹稳当潮生，帆轻趁风便。\n龙翔古招提，鸟革今轮奂。\n回合列翠屏，周遭铺素练。\n邀行嫩篁竿，劝坐老木干。\n沿壁览新题，吹尘认旧篆。\n一隅看不足，两塔穷未见。\n阳光烁岗顶，飙阵掠波面。\n郛郭聚拱伏，烟云散呈献。\n俯拜肃御邸，仰瞻粲宸翰。\n皇帝南巡意，生灵北望眼。\n书千古清辉，为万世伟观。\n楼台明月宴，钟鼓朝暮饭。\n徒见一时近，孰念百年远。\n江涛常摏撞，帝泽共流转。\n游子感诗歌，居人思日勉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过曹娥江","author":"葛绍体","text":"依旧临江镇庙门，参差江树带春云。\n男儿愧死知多少，我欲重招孝女魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饭溪石","author":"葛绍体","text":"一石类古钟，范模昔谁制。\n开辟几岁月，萝蔓疑篆隶。\n老木上婆娑，清泉下溶㵝。\n左右乱石列，拱若朝玉帝。\n惜在道路傍，倦客谩凝睇。\n倘立泰山巅，爰遇封禅代。\n万乘躬巡幸，想像羲皇际。\n铭德刻隽功，表里千万世。\n愿言勿轻凿，天意或有待。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和水心先生寄越帅汪焕章得雨韵","author":"葛绍体","text":"步虚影里云璈举，精诚上对东皇语。\n蓬莱拂槛多飞云，西风吹作人间雨。\n田家谁不知公勤，千里欢声公亦闻。\n早禾登场晚禾实，公庭如水清无尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招鹤所词为澉浦监税赵潜夫作","author":"葛绍体","text":"君之来兮鹤自九皋，驾以去兮渺天地而逍遥。\n缟衣玄裳兮横大海之惊涛，云旗先驱兮霓旌旖旎。\n月皓皓兮风洒洒，青山之上兮黄湾之下。\n挹北斗兮椒浆，羽扇纶巾兮佩璆锵，盼而笑兮玉洁水光。\n鸣鸾凤兮舞鼋鼍，冯夷鼓兮虞妃歌，鱼咏龙吟兮蛟螭护呵。\n眷言归兮南浦，帆飞兮过舶橹，春复秋兮终古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青坚即事","author":"葛绍体","text":"老桧依庭下，青坚自旧名。\n林深便静坐，径浅却幽深。\n逗日分松色，迎风和竹声。\n相韩亲匾字，相对有馀清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宣公泉歌","author":"葛绍体","text":"几年废井城东衙，甃石缺裂洿淖多，奈此宣公初凿何。\n宣公浩气辈孟轲，论谏仁义永不磨，炳炳丹衷史所誇。\n当时芟薙开藤萝，细穿地脉泉源过，暗引云气通天河。\n谁知荒芜日冥冥，泥舍不食羸其瓶，谷射瓮漏汲莫升。\n旧迹契君怀古情，一朝渫治翻光晶，百丈修绠辘轳声。\n乳泉溶溶早夜生，寒冽不改彻底清，静养日月印列星。\n君欲著亭泉之侧，味良高风梦想觌，酿泉为酒觞佳客。\n舂来香秫珠的皪，玉缸方糵化醇醳，蚁蜉槽床春滴滴。\n宣公在天酹可索，宣公之泉带神识，滨湖一啸暮天碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"树影 其二","author":"葛绍体","text":"莫要随风上下狂，空将闲影傍斜阳。\n斜阳西去还催去，自在虚明一带窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送仙居令","author":"葛绍体","text":"邑称仙之居，山水开画图。\n著我老仙子，少试胸中书。\n视印秋风前，观化冬日初。\n琴调待平弦，发稠借轻梳。\n岂必三年期，期月亦可乎。\n赤城势连越，朱溪流通吴。\n人限地百里，而滞天一隅。\n俄然乘云翔，邑人空叹吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]