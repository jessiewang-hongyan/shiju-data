[{"title":"送福州监郡陈殿丞","author":"张方平","text":"七闽一都会，乃是无诸城。\n海近气物异，山遥风候清。\n宦游过乡美，君禄及亲荣。\n去去倚门念，溪船归棹轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈汝玉谒三川大资政左丞吴公","author":"张方平","text":"吴公昔作河南尹，首唱儒风荐贾生。\n今日治平承祖德，可无推引助文明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒青州范天章","author":"张方平","text":"剑横驴膊儒装陋，戟列台门霸府雄。\n喜似祢衡逢北海，直须雷焕辨南丰。\n谬悠为说非今味，疏略言诗粗古风。\n更似贾生多叹息，闻公真赏胜吴公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送沈生昆弟随侍之博白四绝句 其一","author":"张方平","text":"炎方景象异中原，海气昏昏杂瘴烟。\n今日荒夷成雅俗，薰风南播自妫弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送沈生昆弟随侍之博白四绝句 其二","author":"张方平","text":"不须南浦怀消黯，好过西山访隐沦。\n比到岭时应近腊，相思可寄一枝春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送沈生昆弟随侍之博白四绝句 其三","author":"张方平","text":"东连海道彻扶桑，北望神皋斗柄旁。\n两处音尘杳难接，征鸿岁只到衡阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送沈生昆弟随侍之博白四绝句 其四","author":"张方平","text":"夕阳疏苇暮江湄，秋色萧萧动客思。\n自侍严君领州去，岂同骚客梦边时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴范天章","author":"张方平","text":"诏起东山对紫庭，清风萧洒动阶蓂。\n谠言几为忠邪发，大用须凭庙社灵。\n武库神兵罗斧戟，大宫礼器列笾铏。\n愿公早入当钧轴，重演三篇相武丁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送汾阳高士归三峰","author":"张方平","text":"知逢三洞客，曾指九丹方。\n气抱冰霜冷，神含日月光。\n閒轩同鹤静，妙境入龟长。\n它日南峰路，相期过华阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送邢遁山人","author":"张方平","text":"忽悔轻抛云水来，便将鹤去指林斋。\n生涯琴剑外无物，日逐醉吟中遣怀。\n旧隐居常因梦到，尘游动是与心乖。\n送君翻自嗟羁滞，木叶脱时还计偕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵先生","author":"张方平","text":"家住崆峒塞垣上，翩然游蜀遂忘归。\n九还气足通神化，一日丹成是道机。\n曾共灵龟波上隐，又随苍雀火中飞。\n只于醉里藏身去，休入红尘作是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送圭师归衡岳","author":"张方平","text":"师通禅律外，外学二篇微。\n貌似寒山古，身随风叶飞。\n潇湘曾晓梦，鸿雁伴南归。\n七十三峰里，云庵拂旧扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧南游雪窦","author":"张方平","text":"早出都门何往哉，四明雪窦指崔嵬。\n便从古道扬眉去，莫到宝山空手回。\n乘月晓行松露湿，迎风晚渡海涛来。\n普贤楼阁知非远，逦迤南游想善财。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠韦不伐","author":"张方平","text":"莫随世伪作圆方，坦坦元邪是履祥。\n学鄙浅讹趋古道，天教轗轲与刚肠。\n俛投胯下人皆笑，独卧隆中自不常。\n毕竟途穷无所合，何妨持钓坐沧浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兖海孙学士寄昼锦编述先德宣公进退之美报之长句四韵奉扬盛事","author":"张方平","text":"邹鲁衣冠古士乡，义方不独有扶阳。\n德名垂世先君子，经术传家小太常。\n闾巷共荣新昼锦，吏民司爱旧甘棠。\n前人彝鼎铭勋伐，未似盈编盛事光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠赵先生","author":"张方平","text":"此老得天乐，自称云水人。\n佯狂不妨道，太息漫劳神。\n沈醉少醒日，与游多逸民。\n常忧忽不见，无处访清尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠三茅朱先生","author":"张方平","text":"郁仪结邻太霄道，金铛玉佩虚皇冠。\n炉中火候烟霞煖，坛上磬声星斗寒。\n紫节晨游从玉女，绿軿夜降接灵官。\n愿持璧纽充盟信，乞取胎精九化丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉泉观赠高道士","author":"张方平","text":"古屋气象冷，苍崖烟翠中。\n龙归半天雨，虎啸一岩风。\n露后芝房紫，霜馀柏实红。\n终期把藜杖，来伴白云翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠郭诚思","author":"张方平","text":"壮志本桑弧，当年亦弃繻。\n尘游谢京国，火记得酆都。\n露气凝琼树，冰光澈玉壶。\n世间出世法，胎食即天厨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠赵抱一","author":"张方平","text":"石门路已绝尘寰，紫柏高深不可攀。\n野色苍茫连远水，暮云惨澹裹寒山。\n琴棋有徇皆为役，松竹无情且共閒。\n卉醴一杯时自酿，陶然亦可发朱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠青城山威仪观李鍊师","author":"张方平","text":"天仓三十六峰下，犹有轩辕辙迹存。\n丹灶前临六时水，芎田远接九仙门。\n火芝夜照千灯迥，江树朝涵一气浑。\n道友相邀寻异药，携筇几到老人村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠终南李道人","author":"张方平","text":"神仙灵药自然功，五色光中一气通。\n借问参同相类法，何如相类即参同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠琅邪智先长老","author":"张方平","text":"山路层层峻，幽栖最上层。\n净光悬海月，幻体任春冰。\n四句有为法，一心无尽灯。\n我来忘所问，相伴久腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠辰长老","author":"张方平","text":"燕坐非持律，游方不学禅。\n长空任飞鸟，古涧自寒泉。\n见月何须指，追风不待鞭。\n平生一破衲，随处伴閒眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠崆峒天水公","author":"张方平","text":"天下赤龙诀，人间金液丹。\n先生今已得，此事古传难。\n阴德留尘世，仙阶在广寒。\n旧闻三五一，乞取略开端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送徐总","author":"张方平","text":"半醉长呼意若何，官情道味两蹉跎。\n眼前渐渐故人少，世上纷纷新事多。\n疏籁自鸣非节奏，虚舟妄触任风波。\n悲歌深叹流年急，常忆江南蓝采和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送杜山人","author":"张方平","text":"到不说来处，去安知所之。\n野云同自在，溪鸟与谁期。\n虎伴閒行远，猿惊住啸迟。\n相逢聊一醉，重见又何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宋屯田归湖南","author":"张方平","text":"旧学孙明复，春秋助发微。\n倦游惊白首，知已失缁衣。\n乞了朝鸡去，南随社燕归。\n衡湘多隐逸，道侣未应稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"筇杖赠凌生","author":"张方平","text":"山居知独处，一杖代儿曹。\n试水溪沙浅，挑云岭路高。\n访僧归有伴，采药远忘劳。\n它日蓬莱会，应骑过海涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都官叶郎中归三衢","author":"张方平","text":"宗邸横经授小侯，迹同半隐久沈浮。\n却寻故国溪山路，多谢朝堂钟鼓楼。\n冉冉年华年老态，纷纷时事作閒愁。\n一丘一壑平生志，况有门人伴钓游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"微子庙","author":"张方平","text":"西伯已招二大老，东邻更弃三仁人。\n元龟遂讫商家命，白马永为周室宾。\n抱器幸存天凤祀，丧邦都为牝鸡晨。\n可怜长发源流远，旧国犹存庙树春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦州北山云是隗嚣宫登城楼下瞰偶题","author":"张方平","text":"宛下君臣实儿戏，昆阳胜败非人力。\n刘秀其来异独夫，隗嚣何事为西伯。\n送质已是不能强，保险明知本无策。\n惟其得士似田横，后世英雄共嗟惜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读杜工部诗","author":"张方平","text":"文物皇唐盛，诗家老杜豪。\n雅音还正始，感兴出离骚。\n运海张鹏翅，追风骋骥髦。\n三春上休苑，八月浙江涛。\n璀璨开鲛室，幽深闭虎牢。\n金晶神鼎重，玉气霁虹高。\n甲马腾千队，戈船下万艘。\n吴钩铦莫触，羿彀巧无逃。\n远意随孤鸟，雄筋举六鳌。\n曲严周庙肃，颂美孔图褒。\n世乱多群盗，天遥隔九皋。\n途穷伤白发，行在窘青袍。\n忧国论时事，司功去谏曹。\n七哀同谷寓，一曲锦川遨。\n妻子饥寒累，朝廷战伐劳。\n倦游徒右席，乐善伐干旄。\n旧里归无路，危城至辄遭。\n行吟非楚泽，达观念庄濠。\n逸思乘秋水，愁肠困浊醪。\n耒阳三尺土，谁为剪蓬蒿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题杨大年集后","author":"张方平","text":"天上灵仙谪，人间秀气涵。\n朱弦清庙瑟，美干豫章楠。\n富艳三千牍，从容八十函。\n典纯追古昔，雅正合周南。\n温粹琼瑶润，滋醲稼穑甘。\n微中缄海蚌，巧处吐春蚕。\n璀璨龙宫出，精深虎穴探。\n机衡成臲尯，嵩洛入烟岚。\n寂忍修禅智，虚柔慕史聃。\n骥辕曾未骋，鸾驭不停骖。\n岩庙登何数，承明入独三。\n可怜经济意，旧客记高谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读王朴传","author":"张方平","text":"世主英威动九阳，高贤事业出岩廊。\n何须梦卜疑千古，灼见云雷定四方。\n小国霸图微管葛，当时人杰自萧张。\n不终制作成遗恨，律准今犹在太常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读素书","author":"张方平","text":"孺子圯桥跪履年，七章德在谷城仙。\n所言道德帝王事，不比盘盂长短篇。\n晚欲出尘应有诀，初行遇汉岂非天。\n萧曹勋业皆劳力，宁似功成樽俎前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过丰","author":"张方平","text":"刘季当年在古丰，芒砀王气已连空。\n天机先露由啼妪，人意冥符自董公。\n历数有归徒胜负，风云相会尽英雄。\n不然樊郦萧曹辈，尽老屠商掾吏中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过沛题歌风台","author":"张方平","text":"落托刘郎作帝归，樽前感慨大风诗。\n淮阴反接英彭族，更欲多求猛士为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题中阳里高祖庙","author":"张方平","text":"纵酒疏狂不治生，中阳有土倚兄耕。\n晚遭乱世成功业，更向公前与仲争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临淄同刘仲方作","author":"张方平","text":"回合空山万叠苍，磻溪投钓此开疆。\n儒家俎豆连洙泗，战图戈鋋接楚梁。\n四岳子孙终海屿，诸田意气尽尸乡。\n不惟仲父能轻重，形胜由来自霸强。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剧孟","author":"张方平","text":"人物无重轻，庙朝有失得。\n世平徒匹夫，时摇一敌国。\n奸雄望风尘，冠剑动惭色。\n治庭不论功，声名辉典策。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读齐世家","author":"张方平","text":"默坐磻溪素发垂，商周于此系兴衰。\n机深正似忘机者，应被沙鸥静处窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读楞伽经","author":"张方平","text":"楞伽三万六千偈，百八句中成自性。\n法法非法离法尘，心心无心入心病。\n渐熟当似庵罗果，顿照犹如大圆镜。\n龟毛兔角妄有无，海浪空华不清净。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读混元经","author":"张方平","text":"五行生成本一气，晓此体用知命枢。\n还元当复定金锁，过宿宁更怀蘧庐。\n无质生质是丹地，有象非象真坛图。\n此途得道亦连袂，迟晚须乘八景舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寂默通真说因戒而定云是小乘渐法然至则成大其致一也赵少师叔平览之有疑见问以此答","author":"张方平","text":"即定非存出入间，照而常寂所居安。\n将心起用知逾远，有眼无光见亦难。\n向上本来惟一路，初机聊为立三关。\n莫于此地分延促，弹指时中海水乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读坐忘论","author":"张方平","text":"正一初传王远知，后来体用益精微。\n惟无矜贵为真地，但涉成亏即世机。\n松径风声犹有待，糠炉火候事终违。\n便令直了九丹术，不到坐忘何处归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览九丹上化经寄南都王宣徽君贶","author":"张方平","text":"上清紫简世传稀，中有灵都妙旨微。\n云雾披光丹凤出，风雷接势赤龙飞。\n琴心三叠胎仙舞，籥筦双迎帝子归。\n幸得九天真一诀，尘劳何事尚依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读穆天子传","author":"张方平","text":"八龙长鹜造昆丘，七萃前驱纵逸游。\n遇雪自裁黄竹唱，捧觞喜答白云讴。\n羽陵广奏随风逝，崦阜铭踪共日留。\n惆怅璧台人不返，乐池遗恨素波愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读樊川集","author":"张方平","text":"不遇元和得献谟，望山东北每长嘘。\n独赓唐律雅风后，更注孙篇俎豆馀。\n霅水胜游成怅望，杜川归事竟踌躇。\n中年遽使山根折，尽写雄襟在此书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读杜诗","author":"张方平","text":"杜陵有穷老，白头惟苦吟。\n正气自天降，至音感人深。\n昭回切云汉，旷眇包古今。\n万壑入溟海，一枝成邓林。\n掩抑鬼神泣，寂寥星月沈。\n珠凭罔象得，玉看晶采寻。\n穰穰丰年谷，磊磊殊方琛。\n病源问岐伯，兵略须淮阴。\n流寓四方路，浩荡平生心。\n每览述怀篇，使我清泪淫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题英烈王庙","author":"张方平","text":"固云志在修私怨，破郢其如不利吴。\n由此夫差心遂侈，鸱夷岂得谓非辜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东方朔","author":"张方平","text":"不独岩扃与市尘，金门亦可晦吾真。\n孤风大义人谁见，宣室聊曾抗倖臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天圣中年尝有异梦熙宁癸丑退居南台聊记旧事","author":"张方平","text":"凌空素阁彩霞鲜，旧侣相容见九玄。\n上下登梯一童子，逡巡离座六灵仙。\n跪瞻宝案凝神久，手纳金匙受记专。\n病卧夜长思此境，忽惊四十有三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"侯君房","author":"张方平","text":"爵位功名可自豪，青云志士岂而曹。\n一朝黄钺看看下，始愧狂奴故态高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"被命中山以亲老不赴书怀寄集贤曾公参政赵公","author":"张方平","text":"野怀常逐白云飞，疏拙那能合世机。\n偶似曹溪一宿觉，已多蘧瑗九年非。\n略呈幻事何须了，惟愿朝恩早放归。\n它日莲华峰下去，犹期话道过黄扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上三司蔡内阁","author":"张方平","text":"此日河南念贾生，留将名字彻丹庭。\n秋声渐觉寒生树，亲老遥知独倚扃。\n徒系车傍淹白昼，得离韝上必青冥。\n公如未信牛间气，试掘丰城必有灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢范天章荐应制科","author":"张方平","text":"初辟明堂见帝轩，此时宁得恋丘园。\n程文懒谒春官氏，决策思干法扆尊。\n千古声名传鹗表，四方豪俊望龙门。\n若趋丹陛承清问，何以酬知或敢言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬潭州周沆学士见寄","author":"张方平","text":"鳌背三山压海涛，云台高议接时髦。\n一麾忽到江湖外，回首方惊日月高。\n不善取容同曼倩，且歌乐职学王褒。\n贾生自是长沙远，更吊湘累赋广骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻龚懋","author":"张方平","text":"所至辄惊座，归来成泪痕。\n怜君孤剑客，掷谒五侯门。\n骄气羞纨裤，凉风忆故园。\n时清经世事，扪虱为谁言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄徐白久客襄汉","author":"张方平","text":"避暑鹿门寺，虚斋风竹凉。\n草连郧国远，水接汉川长。\n寓客怀江表，骚人爱楚乡。\n京尘诚可厌，君未舍名场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄高弁侍郎","author":"张方平","text":"大雅久颓弊，夫君真古人。\n道维皇极正，文著帝刑淳。\n美望锵金石，深诚照鬼神。\n立朝惟一介，为郡有遗仁。\n素尚陶弘景，风流贺季真。\n岁寒松有节，明瑩玉无尘。\n霜简虽清重，铜符亦久迍。\n老成急登用，必有及斯民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄汾阳郭先生","author":"张方平","text":"君家白云外，岩溜响嘈嘈。\n绝壑风烟澹，孤峰冰雪高。\n自能无世累，谁见有生劳。\n指我蓬壶路，琼宫隔海涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄三峰郭诚思","author":"张方平","text":"松桧峰前古柏林，结茅无伴对幽禽。\n鄙为浮薄八公事，独入精微九圣心。\n春斸晴川閒种玉，夜开丹灶试还金。\n泠然风驭知何返，三十六关云路深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访朱先生值昼寝","author":"张方平","text":"一枕清风靖馆深，满庭公桧郁交阴。\n此时真境谁人见，月在泥丸日在心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄代渊","author":"张方平","text":"尘走我何劳，岩栖君愈高。\n林斋且吟啸，世路尽风涛。\n小桂閒招隐，西岷续返骚。\n气机冲不露，承弁纵双毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]