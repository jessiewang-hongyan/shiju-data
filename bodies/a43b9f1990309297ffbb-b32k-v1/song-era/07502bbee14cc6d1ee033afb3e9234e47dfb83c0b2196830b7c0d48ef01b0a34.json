[{"title":"偈颂一百零二首 其七","author":"释绍昙","text":"松粉飘香，麦须弄黄。\n今朝春告别，无处觅行藏。\n燕子知不迁义，深谈实相，对语雕梁。\n见汝诸人不会，衔泥营故垒，飞过莫家塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十三","author":"释绍昙","text":"社燕催归，宾鸿欲返。\n雪点白蘋洲，锦铺红蓼岸。\n虾蟆入汝鼻孔里，毒蛇穿汝眼睛中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十一","author":"释绍昙","text":"寒食清明节，人家拜扫时。\n纸灰粘蝶翅，啼血染花枝。\n追亲思远，写恨含悲。\n不论富贵，大小由之。\n唯有林泉衲子，无思无念，无欲无为。\n圆蒲静倚，瘦策闲戏。\n燕子自长春寂寂，长歌一曲啰啰哩，不是知音说向谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十七","author":"释绍昙","text":"正令全提，无在不在。\n簸箕有唇，洞庭无盖。\n若作奇特商量，入地狱如箭射。\n不作奇特商量，入地狱如箭射。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十七","author":"释绍昙","text":"久病脚力衰，婴儿学移步。\n丧尽目前机，辩得麈中主。\n鼻直眼横，皮穿骨露。\n驴不成兮马不成，且无描摸处。\n赚杀僧繇吴道子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十五","author":"释绍昙","text":"我也无端到住山，忙忙业识不曾闲。\n白云拂尽到枯叶，恐碍采樵人往还。\n寒松瑟瑟，幽鸟关关。\n家私花擘尽，谁道语音蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十二","author":"释绍昙","text":"从上爪牙，千差万别。\n截鹤续凫，伤龟恕鳖。\n拄杖子，不入这保社。\n颟颟顸顸，跛跛挈挈。\n有眼如盲，有舌如结。\n静倚松根，憨眠不彻。\n佛法从教烂似泥，不说不说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十四","author":"释绍昙","text":"脚跨马师门，便有弥天过。\n喝得耳朵聋，扭得鼻头破。\n纵大雄老虎略露爪牙，脱百丈野狐不昧因果。\n说条念贯，监本无端，不独瞒人亦自瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十八","author":"释绍昙","text":"家住云坳，盖头把茆。\n蓬门无钥，谁解推敲。\n万籁声沈，鸟啼幽谷。\n千林色静，月挂寒梢。\n风檐索寞人投宿，睡到平明手脚交。\n更问其中端的，床头木枕子，葛坦半中凹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十四","author":"释绍昙","text":"千圣灵枢，妙在转处。\n烁尽玄微，更进一步，莫来拦我毬门路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十四","author":"释绍昙","text":"惟一坚密身，一切尘中现。\n老婆腰系紫纱裙，娇儿手把红罗扇。\n南岙东村，张坊李店。\n拜贺新年，春风满面。\n欢悰不觉语声高，惊落梅花一片两片三四片。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十三","author":"释绍昙","text":"出佛身血，破和合僧。\n驴腮马颔，逞技矜能。\n堪笑灵山儿戏剧，聚头争看蜡人冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十三","author":"释绍昙","text":"进人若将加诸膝，退人若将坠诸渊。\n云门放去较憨，雪窦收来较险。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八","author":"释绍昙","text":"父不慈，子恶毒。\n热血相喷，痛拳相?。\n不共戴天雠，推入阿鼻狱。\n此冤此恨与谁论，海月山云亦断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十二","author":"释绍昙","text":"篱菊铺黄，茱萸喷香。\n渊明错会，耽赏重阳。\n何似林间衲子，无荣无辱，无可思量。\n饱噇香积饭，高卧古禅床。\n是佛是魔俱扫迹，献花无路鸟空忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其一○○","author":"释绍昙","text":"司南车，辘辘转。\n务与冥行指迷，肯被傍人指点。\n三脚驴却步不前，老杨歧恶殽难掩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十四","author":"释绍昙","text":"丹桂飘庭际，寒蛩语砌阴。\n声声调雅奏，点点簇黄金。\n尽情拈出，宴乐嘉宾，佛垄虽贫未是贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十六","author":"释绍昙","text":"秘魔擎叉，俱胝竖指。\n邪法难扶，如何得是。\n山僧冷地思量，不觉吞声饮气。\n攻乎异端，斯害也矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十八","author":"释绍昙","text":"地僻云深，秋高境寂。\n堂户凄凉，无人面壁。\n净地上谁肯狼籍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十九","author":"释绍昙","text":"三十二相，八十种好。\n马颔驴腮，弥天罗过。\n新法华，因甚刺脑入胶盆。\n过在你，殃及我。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十五","author":"释绍昙","text":"冻折枯梅，三两枝亚。\n香度野桥，影横茆舍。\n道人鼻观相忘，有眼如盲，不被这些留碍。\n可怜鬼窟藏身，唤起来，雪团打，雪团打。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十六","author":"释绍昙","text":"不绍金轮尊贵位，被人打落当门齿。\n难亸梁王掘地埋，脱身留得空棺履。\n死款供成，临文不讳。\n乳窦今朝报不平，臭烟蓬㶿薰他鼻。\n任是老顽，也须喷嚏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十二","author":"释绍昙","text":"庄上吃油糍，鬼精魂罢休拈弄。\n雁影沉寒水，穷伎俩何用施呈。\n虽云博饭栽田，何似归堂向火，静悄悄，暖烘烘。\n不劳共话无宾主，衲被蒙头万境空，死水何曾有活龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十五","author":"释绍昙","text":"诸庄旱涝不为忧，只恐难调水牯牛。\n拽脱鼻绳憨睡稳，数声羌笛野田秋。\n绝无形影，谁放谁收。\n通身白了通身黑，游戏风烟百草头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十二","author":"释绍昙","text":"久雨不晴，高低水平。\n浸烂释迦鼻孔，淹鳖迦叶眼睛。\n拄杖子，天造草昧，宜建侯而不宁。\n豁开正眼明如日，扫荡重昏天宇清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十","author":"释绍昙","text":"正直聪明，风流儒雅。\n坚护法城，策勋千载。\n李将军有佳声在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十九","author":"释绍昙","text":"活鱍鱍，硬纠纠，明眼人觑不透。\n刚被春山杜宇知，点血啼清昼。\n临风?跳撼坤维，驴前马后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十一","author":"释绍昙","text":"六用门头，力战争夺，鎗杀贼阵云横。\n群魔窜入藕丝孔，竟挽天河洗甲兵。\n凌烟阁就，汗血功成。\n高枕圆蒲尘梦破，隔窗幽鸟话升平。\n灼然如是，千圣同盟。\n诸禅德，若也脚跟浮逼逼，画堂立变铁围城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十五","author":"释绍昙","text":"燕语雕梁，绿阴覆墙。\n缲车声轧轧，风递茧丝香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其一○二","author":"释绍昙","text":"向上机，顶门眼。\n碗脱丘，漏灯盏。\n从上诸祖，已错拈提，瑞岩今朝分明剖判。\n夜后打眠，斋时吃饭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十九","author":"释绍昙","text":"甘菊舒黄，茱萸喷香。\n渊明错会，耽赏重阳。\n采采东篱下，南山见未忘。\n刚道花枝有短长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十","author":"释绍昙","text":"三月青春弹指过，九旬朱夏又从头。\n茶抽雀舌郎忙摘，麦弄虾须逐旋收。\n炽然说法，声撼林丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十五","author":"释绍昙","text":"索寞芝峰，赏元宵节。\n佳宾到来，如何铺设。\n能挑海底灯，细剪山头月。\n东山瓦鼓歌，堋八剌札，不是知音向谁说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十三","author":"释绍昙","text":"顶?机，法空座。\n不涉思而知，不动步而到，无端入荒草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十四","author":"释绍昙","text":"一径直，二周遮。\n眉毛眼睫，地角天涯。\n云门胡饼赵州茶，惠崇芦雁赵昌花。\n会则星河秋一雁，不会砧杵夜千家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十三","author":"释绍昙","text":"春日打春牛，一击百杂碎。\n黄梅石女暗惊胎，生下无名物一块。\n问四圣四圣不知，问六凡六凡不会。\n风前散作万家春，贱似黄金贵似尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十八","author":"释绍昙","text":"玉几山前，凌霄峰下。\n热血嗔拳，做人话把。\n犀牛扇飏向他方，捋虎须拦胸便打。\n一炷兜娄怨结成，贵买贱卖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十三","author":"释绍昙","text":"佛垄开炉，寒灰死火。\n拨著星儿，弥天罪过。\n笑倒嵩山破灶堕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十","author":"释绍昙","text":"三日晴，五日雨。\n无象太平，满田禾黍。\n不作佛法商量，亦非世谛流布。\n碧眼黄头总不知，问讯轮皴拄杖子，牢记取。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十一","author":"释绍昙","text":"川僧素无头脑，步步引人入草。\n忽惊野鸭群飞，便把鼻头捏扭。\n哭不成哭，笑不成笑。\n只因家富小儿娇，七世门风都坏了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十四","author":"释绍昙","text":"蔓草系罗裙，山云笼席帽。\n鼓舞贺元正，石女呵呵笑。\n唤作新年头佛法，赚度人不少。\n不唤作新年头佛法，赚度人不少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九","author":"释绍昙","text":"平如镜面，险似悬崖。\n不容拟议，岂属安排。\n闪电光中行活路，大悲院里赴村斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十七","author":"释绍昙","text":"横该竖抹，古路封苔。\n圣凡情尽，马腹驴胎。\n不用闭门防俗客，爱闲能有几人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十一","author":"释绍昙","text":"正因二字得闻，鼠粪污一釜羹。\n乳峰初无个事，饱噇饭了闲行。\n松门雨霁，苔径云横。\n堤防平地上，著脚是深坑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十五","author":"释绍昙","text":"韩柳肺肠，苏黄骨髓。\n点著禅衣，香风匝地。\n七十二峰增秀气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四","author":"释绍昙","text":"春日晴，烧痕青。\n锦云片片，花雾溟溟。\n无位真人，面门出入，贼精贼精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十五","author":"释绍昙","text":"上下三指，彼此七马。\n眼见如盲，口说如哑。\n拄杖子忍俊不禁，等闲捉败。\n休休，尽法恐无民，且放天寒赦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十二","author":"释绍昙","text":"一宿觉，三担土。\n脚未跨门，丰骨已露。\n等闲举一步，危径结寒花，信彩示一机，断崖飞瀑布。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十六","author":"释绍昙","text":"骨瘦如柴，机深似井。\n划地为牢，酷行商令。\n儿孙无地雪深冤，烧炷兜娄苦告天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十八","author":"释绍昙","text":"茆屋赋新诗，内院寻知识。\n身从胜境中来，句自活法中得。\n非身非句，绝毫绝釐，慈氏少陵安得知。\n法华不敢轻饶舌，只恐山禽语带徼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十","author":"释绍昙","text":"一坞耕樵，门扃绿萝。\n富骄时少，贫乐时多。\n妇摇机轧轧，儿弄口喎喎。\n涧水松声交节奏，何似东山瓦鼓歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十","author":"释绍昙","text":"打头不遇作家，谩说俱轮先度。\n饶伊诸漏顿超，到底终成染污。\n不染污，活眼点开，光吞寰宇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十八","author":"释绍昙","text":"尊贵中来，报土无差。\n琼琚庭院，锦绣楼台。\n何似灵山听法华，联镳稳驾白牛车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十五","author":"释绍昙","text":"觉城东际，小小丛林。\n旃檀围绕，狮子嚬呻。\n萝月四窗云万壑，见成一片祖师心。\n眼里无筋一世贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十二","author":"释绍昙","text":"杨岐栗棘蓬，临际清凉树。\n钁头无柄，正好栽培，版齿生毛，不妨吞吐。\n一抽三，二添四，跛脚云门，乾坤独步。\n瞎人天眼分缁素。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十","author":"释绍昙","text":"三月春云暮，韶华似酒浓。\n莺啼杨柳雨，蝶弄海棠风。\n若作境会，过山寻蚁迹，不作境会，度水觅鱼踪。\n故国归路远，日暮泣途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十三","author":"释绍昙","text":"人间万斛金莲，竞赏元宵佳节。\n法华彻骨贫穷，斗胜不如斗劣。\n室内一盏灯，灿灿心花发。\n不夜光明照古今，见得分明，眼里重添屑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十六","author":"释绍昙","text":"肥马碌碌，瘦马碌碌。\n医得眼前疮，剜却心头肉。\n朝不足，莫不足，六六依然三十六。\n云门见睦州，良遂参麻谷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十三","author":"释绍昙","text":"水洗硬石头，浪打枯杨树。\n净智装严功德聚。\n虽然脱体无尘，未是透法身句。\n如何是透法身句，只有湖水无行路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十九","author":"释绍昙","text":"堋八剌札，新翻曲调，逸格乡谈。\n意随流水远，声遏莫云寒，月移花影上栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其一○二","author":"释绍昙","text":"明月可中庭，雁影沉寒水。\n烹金炉冷岁华深，九鼎遗言犹在耳。\n深深拨著，宿火通红。\n不假一槌成大器，刈禾镰子疾如风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十三","author":"释绍昙","text":"一雨润焦枯，大地承恩泽。\n黄铺?亩云，青锁郊原色。\n刈禾镰子疾如风，收放全归掌握中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十","author":"释绍昙","text":"梅开的皪花，径糁模糊雪。\n装点早春容，庆贺新年节。\n少室家风，全机漏泄。\n堪笑神光不识瞥，白把一枝臂折。\n有屈难伸说，无端拄杖重饶舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十七","author":"释绍昙","text":"弃金轮王位，尊贵不尊贵。\n冻饿深雪中，冷地里短气。\n见明星，没巴鼻。\n更言大地一切众生成正觉，吽吽，棒折也未。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十一","author":"释绍昙","text":"幕挂春烟，簟铺秋水。\n高枕横眠，鼻雷聒耳。\n烁石流金总不知，何须殿阁薰风至。\n又谁管九十日种粟烧畬，说什么十三番悟明自己。\n灼然是个无惭愧，阎罗王倒退三千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十六","author":"释绍昙","text":"三伏炎蒸，汗流如雨。\n老倒白云，说迷说悟。\n一茎草上建琼楼，熟睡饶谵语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十八","author":"释绍昙","text":"万壑乔松，九枝灵草。\n瑞气久钟，清声远播。\n材大今为宗庙梁，国香世产芝房宝。\n别露风规，寻僧论道。\n十二峰高势莫齐，到顶方知天下小。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十八","author":"释绍昙","text":"风前不见花中叶，雨后难寻叶底花。\n蜂蝶纷纷过墙去，只疑春色在邻家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]