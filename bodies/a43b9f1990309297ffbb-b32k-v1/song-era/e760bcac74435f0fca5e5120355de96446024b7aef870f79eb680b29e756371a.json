[{"title":"观南戍士","author":"刘攽","text":"膂力三军士，由来百战经。\n舞旗翻鸟隼，叠鼓会风霆。\n杀气过铜柱，欢声塞洞庭。\n九州防盗贼，儒服愧青萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平山堂","author":"刘攽","text":"吴山不过楚，江水限中间。\n此地一回首，众峰如可攀。\n俯看孤鸟没，平视白云还。\n行子厌长路，秋风聊解颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伯父挽诗二首 其一","author":"刘攽","text":"遂有终焉志，才成智者居。\n户庭连水竹，几杖接舟舆。\n爱客樽中酒，传家箧里书。\n疏公知足计，不益旧田庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伯父挽诗二首 其二","author":"刘攽","text":"民思常在去，令德久犹存。\n恸哭新阡树，迟疑旧里门。\n大招声断绝，丹旐影翩翻。\n后日谈随会，人知叹九原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽刁景纯二首 其一","author":"刘攽","text":"承明通佚老，仁智远归居。\n门下无留客，灯前不废书。\n舞筵交履舄，倚杖及田庐。\n以此为家事，忘年八十馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽刁景纯二首 其二","author":"刘攽","text":"延陵君子墓，南极老人星。\n自古称遗爱，斯文重典刑。\n一生隆许与，五福最康宁。\n逝矣俱陈迹，临风祇涕零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽孔经父二首 其一","author":"刘攽","text":"乡里东南秀，衣冠伯仲贤。\n先鸣俱中隽，竞爽故无前。\n朔雪凋华萼，炎风急逝川。\n斗间占紫气，应复在龙渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽孔经父二首 其二","author":"刘攽","text":"往昔方闻策，中间五谏书。\n直绳无废墨，利刃必投虚。\n任重生何薄，年长恨有馀。\n悲君虽视草，不及马相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽丁元珍","author":"刘攽","text":"颜驷縻三省，君山困六安。\n宦游俱邂逅，行路正艰难。\n去水争还壑，凝霜苦败兰。\n唯馀青简在，时为拂尘看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽苏明允二首 其一","author":"刘攽","text":"季子才无敌，桓公义有馀。\n空悲武儋石，犹得茂陵书。\n郢路营魂远，江源气象虚。\n康成宜有后，正使大门闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽苏明允二首 其二","author":"刘攽","text":"汉仪绵蕝盛，周谥竹书存。\n益以春秋法，因知皇帝尊。\n百年当绝笔，诸子谢微言。\n诗礼终谁及，贤良萃一门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻雷","author":"刘攽","text":"过腊山微雨，开正两震雷。\n渐南风土异，伤早岁时催。\n放逐渔翁问，淹留漂母哀。\n馀寒附烟火，尚有复燃灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和孙宣德中秋不见月","author":"刘攽","text":"便有倚天剑，决云殊细微。\n清光自无蔽，绝境转知稀。\n露重蝉时落，风高雁已飞。\n嫦娥苦幽独，会载客槎归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和中秋对月","author":"刘攽","text":"星稀如有避，云卷不辞劳。\n露已深秋白，天应为月高。\n幽怀向谁尽，诗兴更何逃。\n勿负盈樽酒，须营千兔毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月四日离都归陈州","author":"刘攽","text":"南浦三篙水，归人五日粮。\n寒沙晨起雁，古树夜经霜。\n久客复去国，有情知望乡。\n鬓毛浑欲变，鸣笛不须长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"去陈二首 其一","author":"刘攽","text":"近关蘧舍卫，接淅孔违齐。\n今日思狂简，儒生自滑稽。\n归欤那愠见，去矣约轻赍。\n颍水清如镜，风波定弗迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"去陈二首 其二","author":"刘攽","text":"礼贤齐相国，爱客郑尚书。\n徐孺曾悬榻，冯公预食鱼。\n甘棠勿剪伐，客馆遂邱墟。\n长铗还相语，冥鸿幸起予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端午","author":"刘攽","text":"万里荆州俗，今晨采药翁。\n浴兰从忌洁，服艾已同风。\n泛酒菖蒲细，含沙蝘蜓红。\n沉湘犹可问，角饭畏蛟龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉祐大行皇帝挽诗十首 其一","author":"刘攽","text":"七月期先远，三泉异卜征。\n悲忧同轨事，遏密兆人情。\n晚出苍龙驾，真游白玉京。\n称天腾茂实，厚德始能名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉祐大行皇帝挽诗十首 其二","author":"刘攽","text":"北发声名远，西城剑戟销。\n万灵潜受记，百兽乐闻韶。\n昧谷迷升日，璇霄失建杓。\n仙游那可问，赋讽已飘飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉祐大行皇帝挽诗十首 其三","author":"刘攽","text":"盛德终无逸，元功熟间然。\n启疆神禹绩，著记帝虞年。\n桑变旋观海，弓遗杳望天。\n霸陵无石椁，不改故山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉祐大行皇帝挽诗十首 其四","author":"刘攽","text":"尽礼三神事，斋居五日朝。\n绨衣仍浣濯，禁籞亦刍荛。\n汾水游何往，华胥梦转遥。\n羹藜与环堵，无日不思尧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉祐大行皇帝挽诗十首 其五","author":"刘攽","text":"属车全卤簿，宝玉焕渠眉。\n万国瞻龙翣，三辰会素旗。\n雪迷帝乡望，风动海隅悲。\n今日西巡守，仍非八月期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉祐大行皇帝挽诗十首 其六","author":"刘攽","text":"清光非可望，天道亦难闻。\n策府开群玉，赓歌续庆云。\n一经皆赐复，九译尚同文。\n会尽南山竹，成书纪帝坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉祐大行皇帝挽诗十首 其七","author":"刘攽","text":"陵阙俨因山，明中恍下天。\n燃鱼常照夜，耕象自成田。\n鸿洞深投玉，莓苔密瘗钱。\n涕流昭德舞，无复柏梁篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉祐大行皇帝挽诗十首 其八","author":"刘攽","text":"帝车旋北斗，驰道绕青松。\n银海浮双阙，虞渊顿六龙。\n深思倾杞国，遗恨泣华封。\n述作无忧事，灵台与辟雍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉祐大行皇帝挽诗十首 其九","author":"刘攽","text":"车书共文轨，律度出声身。\n明白垂中典，优容礼直臣。\n熊罴渭川叟，风雨越裳人。\n更想攀髯士，犹知不犯鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉祐大行皇帝挽诗十首 其十","author":"刘攽","text":"哀挽千人唱，崇冈万岁居。\n呼关想传警，羡道法周庐。\n晚日涂车静，深山灌柏初。\n谷神知有术，犹欲信前书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和麻直讲题杨直讲所种三樗树","author":"刘攽","text":"谁能知散木，封植亦无心。\n岁月如视荫，栖迟还息阴。\n宦情移柳在，诗兴爱棠深。\n定有归飞翼，怀音似泮林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽诗四首 其一","author":"刘攽","text":"制作夸三正，规模壮百王。\n自然推大略，谁得望清光。\n东乐来蟠木，南琛过越裳。\n白云那可测，应复向汾阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽诗四首 其二","author":"刘攽","text":"绵宇正欢心，虞韶骤遏音。\n戴天忧杞国，就日怅崦岑。\n贯朽三泉府，方输九牧金。\n斯民已仁寿，至理更难忱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽诗四首 其三","author":"刘攽","text":"四塞联初郡，千官仅代工。\n舟车逾汉迹，台省变唐风。\n贤杰程能际，戎夷率服中。\n轩威百年在，何必画周公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"神宗皇帝挽诗四首 其四","author":"刘攽","text":"晚驾严仙御，西巡即旧都。\n天寒馀鹤语，弓堕脱龙须。\n白发孤臣泪，清湘万里途。\n无由宣室问，回首叫苍梧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大行挽诗二首 其一","author":"刘攽","text":"受名从大行，复土自因山。\n秋草龙髯堕，宫烟泪竹斑。\n不知汲水远，犹与化人还。\n寂寞崦嵫日，空瞻咫尺颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大行挽诗二首 其二","author":"刘攽","text":"讴歌前授启，桑谷遂兴商。\n恭己朝无事，优贤礼亦庄。\n那惊同轨至，方奏万年觞。\n西望归云白，悠悠指帝乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又二首 其一","author":"刘攽","text":"万国依无外，三登颂太平。\n樵夫亦谈道，耆旧莫知兵。\n云去仙乡远，龙来宝鼎成。\n西风动阊阖，哀涕不胜情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又二首 其二","author":"刘攽","text":"供张连三辅，梯航会九围。\n属车疑晚驾，清跸望来归。\n草露凄金阙，松风飏玉衣。\n旧传当脱躧，遥见五云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日晚","author":"刘攽","text":"清秋来早晚，落日正萧然。\n稍见林外水，独听风际蝉。\n牛羊暝知道，墟落远生烟。\n岁事看禾黍，方知沮溺贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽杜祁公太师二首 其一","author":"刘攽","text":"孤童迨耆老，仕郡至三公。\n任重仍长道，材全信永终。\n时推子房智，人识伯夷风。\n存殁哀荣礼，千秋谁与同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽杜祁公太师二首 其二","author":"刘攽","text":"赤舄三师贵，诸公百里封。\n旧勋兼注意，馀事寄明农。\n哀动襄阳市，悲残郑国舂。\n空馀灵寿赐，无复见临雍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋雨四首 其一","author":"刘攽","text":"冷雨黄昏暮，秋声众叶喧。\n濯烦天宇阔，流恶楚江浑。\n蛙黾烦当道，鱼龙稍在门。\n一樽聊自劝，还欲笑臧孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋雨四首 其二","author":"刘攽","text":"漠漠清秋雨，萧萧万宇寒。\n蛟龙移窟宅，江汉急波澜。\n瘴雾深蛮洞，旌旗湿汉官。\n南征愁失道，后土若为乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋雨四首 其三","author":"刘攽","text":"海风吹暮雨，淮上始秋声。\n点滴潜滋润，阴沈未放晴。\n林塘云似密，水鉴镜来清。\n无事看鱼鸟，飞沈体亦轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋雨四首 其四","author":"刘攽","text":"炎天常畏酒，秋兴忆开觞。\n海面孤云黑，林端一叶黄。\n岛夷歌似楚，村笛语如羌。\n更觉非吾土，登临思旧乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有怀北归","author":"刘攽","text":"江汉不宜秋，羁人北望愁。\n帝乡从此去，楚水正东流。\n竟日悲鶗鴂，长歌倚蒯缑。\n天边两黄鹄，那肯为人留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秘阁梅花","author":"刘攽","text":"始知丹禁密，独见早梅新。\n天上应常雪，人间未有春。\n乱香交砌草，疏影媚庭筠。\n浪作瀛洲客，催成白发人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中晚凉","author":"刘攽","text":"落日浮云暝，沧江雨气来。\n风灯殊未定，洞户故频开。\n秋意梧桐急，宵征蟋蟀哀。\n客心聊洒濯，天地久尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"始凉","author":"刘攽","text":"秋风来几时，客病不相宜。\n摇落令心苦，虚凉益气衰。\n生涯贫更拙，交态卧尤知。\n安得千金赠，鸱夷与尔期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张直温主簿赴南阳","author":"刘攽","text":"张君年少予，冠岁聚公车。\n留落成强仕，声名就子虚。\n穰橙千户富，潭菊万家居。\n吏隐何为乐，优游不废书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄知录园池","author":"刘攽","text":"劫火无遗者，灵光独岿然。\n寒池清照日，古木碧参天。\n细雨来幽鹭，凉风急乱蝉。\n颇知鱼乐意，仍得离钩筌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40889,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游李氏园池二首 其一","author":"刘攽","text":"从人问乔木，系马得名园。\n柳带晴先绿，禽声暖更喧。\n临池照清水，拂石置芳樽。\n不畏归侵夜，严城未掩门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40890,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游李氏园池二首 其二","author":"刘攽","text":"树密浑成坞，花深更有蹊。\n来游春尚浅，重到客应迷。\n已近无人境，深怜快马蹄。\n风光不负约，樽酒会长携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40891,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春阴","author":"刘攽","text":"峡云春易雨，水国暮多风。\n原草萋萋绿，林花淡淡红。\n清江晚寒外，落景半晴空。\n物色怜新燕，归怀目去鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40892,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋雨","author":"刘攽","text":"南国秋常暑，凉风起自今。\n泄云无白日，度夕亦层阴。\n摇落梧楸意，萧条蟋蟀音。\n穷愁抵衰病，坐作老翁心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40893,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"树阴二首 其一","author":"刘攽","text":"清阴方丈得，暑气乍来无。\n尘榻从箕踞，前贤亦锻炉。\n晚虫多黑羽，秋草半青珠。\n安得遗方客，玄谈似给孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40894,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"树阴二首 其二","author":"刘攽","text":"避世长梧子，居贫五柳生。\n清秋葛衣薄，晚日浊醪倾。\n雨蝶轻犹舞，风蝉凉不鸣。\n淮南摇落早，倚树不无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40895,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐","author":"刘攽","text":"积雨凝凉气，疏林滴露华。\n流星占使者，斜汉挹浮槎。\n喜近天流火，回看斗转车。\n秋风下阊阖，消散万人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40896,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饮酒城南门赠高子中","author":"刘攽","text":"苍山际碧霄，绿树及山腰。\n青霭照残日，白云萦丽谯。\n偶然成胜赏，长啸隔尘嚣。\n少驻飞凫舄，吾无独酌谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40897,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬晁单州二首 其一","author":"刘攽","text":"九载一相逢，侵寻头已童。\n喜君真傲吏，老我未成翁。\n简易文书省，悲欢酒盏空。\n平生怀旧意，尽见醉醒中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40898,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬晁单州二首 其二","author":"刘攽","text":"弹琴君子邑，贤守智逾多。\n不作长沙赋，仍传白雪歌。\n解酲应用酒，成佛却须魔。\n正买千金骨，何忧骥跋跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40899,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送吕国博知常州","author":"刘攽","text":"计然馀半策，贾子就新书。\n屈意银青绶，之官鸟隼旟。\n丹枫千里远，秋兴二毛初。\n最可羞晨膳，莼丝杂脍鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40900,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李公择自滑州移知鄂州","author":"刘攽","text":"黄河鲂与鲤，不及武昌鱼。\n好去连城守，翩然双隼旟。\n谏官仍重外，天禄不成书。\n可待三年最，归来侍赤除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40901,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朝回","author":"刘攽","text":"朝回还闭户，讲彻复观书。\n重禄争消得，微躯且自如。\n俗情矜不及，生理付无馀。\n寂嘿怀张挚，淹留苦魏渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40902,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同宋次道饮王史馆园","author":"刘攽","text":"珍馆扫尘埃，宾阶馀绿苔。\n凉风知广厦，清唱急行杯。\n修竹端藏日，交流静殷雷。\n欢穷有馀恨，不及壮年来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40903,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同韩持国饮城东俞氏园","author":"刘攽","text":"贫家常汲汲，一饮自难营。\n不笑烹鸡黍，因之同耦耕。\n林花含秀色，谷鸟变新声。\n归马无庸疾，郊扉最近城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40904,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泛舟城南二首 其一","author":"刘攽","text":"清溪亦多曲，窄地颇宜花。\n出水游鱼乐，惊人白鹭斜。\n孤城旧郢树，三户楚人家。\n归兴仍风雨，萧然眷物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40905,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泛舟城南二首 其二","author":"刘攽","text":"风逆湍声急，云酣雨气豪。\n川蜺垂饮近，江鹤去飞高。\n洗藕还馀味，操舟未觉劳。\n蒹葭弥极望，秋意晚骚骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40906,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早行","author":"刘攽","text":"山鸟相呼曙，樯乌自指南。\n健看帆席满，坐数舳舻衔。\n水阔蛟龙舞，鱼肥鹳鹤贪。\n阵云浓似墨，送雨向湘潭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚行","author":"刘攽","text":"天阔西曛久，风多客语闻。\n九江秋落水，三峡暮归云。\n饮啄鸥相并，归飞鹤不群。\n湘潭早摇落，稍稍怅平分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬钱少卿","author":"刘攽","text":"簿书非力学，何事不窥园。\n乘兴缘心赏，忘怀到酒樽。\n露蝉凉寂寞，风叶静翩翻。\n少驻东方骑，前盟岂可温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":40909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]