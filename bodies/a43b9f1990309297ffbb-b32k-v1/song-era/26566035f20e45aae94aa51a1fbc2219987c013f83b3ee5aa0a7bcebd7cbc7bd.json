[{"title":"次韵谢敬存见寄","author":"汪炎昶","text":"锵然新诗堕崖谷，一片寒光浮越罗。\n字搜珠玑竭贝阙，笔捲波浪乾银河。\n未能力学自知愧，正使工诗奚足多。\n矧兹小技尚未至，议论我私当如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵题张氏耆逸堂","author":"汪炎昶","text":"游戏壶天岁月深，人间又见谪仙人。\n镜中商岭飘萧发，物外箕山自在身。\n安石少徒轻冕绂，伏波老未厌风尘。\n输君物外全双美，洛社耆英汉逸民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵题琴谱三首 其三","author":"汪炎昶","text":"竞誇珠贝溢吟编，豹管微窥惜未全。\n月瑩寒光磨晓镜，风铿逸调脆秋弦。\n才惟渐少逾堪爱，诗不须多贵可传。\n囊里新篇还有几，不妨容我嘒蜩蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵题琴谱三首 其二","author":"汪炎昶","text":"镌琼镂玉缀为编，积雪涵秋调总全。\n听处孰忘身有耳，弹时自以意为弦。\n大音不泄琴何预，至妙无形操岂传。\n忽触悠扬徽外趣，冷风凄雨滋孤蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵题琴谱三首 其一","author":"汪炎昶","text":"三峡啼猿恨满编，乐于此外本来全。\n累虽犹泥调兼操，高在已忘徽与弦。\n纸上陈言奚足恃，指间妙趣不容传。\n须知自有天然韵，寄在风泉与露蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江伯几新覆雪矼草堂","author":"汪炎昶","text":"山人新覆草堂成，便觉烟霞别有情。\n凿牖先思当瀑布，看云旋拟著桃笙。\n庞公隐处携妻子，匡氏同来有弟兄。\n鹤背仙人应错愕，世间亦自有蓬瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余于汪推官别墅睹壁间蜀道山水欲赋未能一夕忽梦如所见而有作觉记门字韵一联就枕上续之","author":"汪炎昶","text":"满壁蚕丛墨未昏，牵情一夜役吟魂。\n舟掀波浪经巫峡，袖扑云烟度剑门。\n九折乍惊身出险，三声犹似耳闻猿。\n无端一事留遗恨，欠觅浣花溪上村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余年二十馀即有二毛盖乱离间关所致感而有作","author":"汪炎昶","text":"两鬓宁逃雪色明，何须种种即关情。\n故应弱质生来早，未信穷愁染得成。\n偶脱乱离真已幸，更添憔悴亦休惊。\n镜中幸有朱颜在，尚用孤怀起不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏","author":"汪炎昶","text":"小雨清初夏，榴花著意红。\n短篁齐远树，轻燕接飞虫。\n睡眼云招去，馀寒酒扫空。\n苦无羁思迫，端与故园同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事","author":"汪炎昶","text":"豪右方怀惧，疲羸岂易禁。\n力田逢屡歉，祷雨得微阴。\n气运宁无复，天灾匪独今。\n居然怀抱恶，满耳是呻吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和友人论诗二首 其二","author":"汪炎昶","text":"蒲团与檀版，拈著足家风。\n性觉随资近，人难尽己同。\n奇非居正外，易正在难中。\n意近语须远，形离神暗通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和友人论诗二首 其一","author":"汪炎昶","text":"原自风骚浚，根从李杜寻。\n烟云裁体制，月露洗胸襟。\n所施殊高下，论功系浅深。\n尽饶材力赡，政要苦留心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齿痛戏成三首 其三","author":"汪炎昶","text":"强把残编阅，支颐坐北堂。\n味从中夜永，痛偶暂时忘。\n意外逢奇药，人间欠此方。\n仓公如欲觅，寄语不珍藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齿痛戏成三首 其二","author":"汪炎昶","text":"疗法人争授，奇功竟未遭。\n嚼侵惊已折，漱撼喜犹牢。\n幸不妨黄奶，惟当釂浊醪。\n子荆泉石约，一笑我将逃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齿痛戏成三首 其一","author":"汪炎昶","text":"齿应宜脱落，鬓已旧苍浪。\n肉食定无分，茹蔬犹见妨。\n动疑难再稳，痛似忽微长。\n舌在吾何患，休看肘后方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀二首 其二","author":"汪炎昶","text":"乾瓦鸣疏雨，虚棂受远风。\n平生负奇志，此地托微躬。\n人笑书成癖，吾疑道未穷。\n数峰青入眼，天际失孤鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀二首 其一","author":"汪炎昶","text":"剧暑逢添闰，微凉忽值秋。\n年争飞鸟疾，云共此生浮。\n多难仍怀古，他乡独倚楼。\n可能天下虑，政有一身忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送友人江和叔调闽海宪掾二首 其二","author":"汪炎昶","text":"莫叹才为掾，云霄自此初。\n会能舒所蕴，且复试其馀。\n黄叶山村雨，青灯竹几书。\n平时学经济，谁不笑迂疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送友人江和叔调闽海宪掾二首 其一","author":"汪炎昶","text":"使幕须材掾，君今有此行。\n蛮烟山树远，驿雨海蝉鸣。\n持赠端何有，愚言慎勿轻。\n奋飞无异术，惟在保清贞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送江天多之淮东梁县迎先尉公柩兼陈言行省二首 其二","author":"汪炎昶","text":"复有忧民意未忘，欲从分省拜封章。\n马周笔下文章妙，贾谊书中太息长。\n治世可能无利病，吾徒自此卜行藏。\n亦知自系苍生福，聊复临风倍激昂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送江天多之淮东梁县迎先尉公柩兼陈言行省二首 其一","author":"汪炎昶","text":"淮县当年逼塞垣，乃翁采棒此悬门。\n馀威尚可消奸猾，故老应思识子孙。\n几岁荒邱埋月冷，九秋丹旐逆风翻。\n访求合有遗文在，归与乡闾共讨论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送澹斋吴判官还台","author":"汪炎昶","text":"佐郡清声播，巡台应辟除。\n施为多近古，恬澹不渝初。\n政每寻无迹，□□□□馀。\n抚摩殊搏击，去蠹肯踌躇。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭中彝兄三首 其三","author":"汪炎昶","text":"追随从早岁，终始只真情。\n责善古朋友，恤灾亲弟兄。\n靡酬亏大义，重聚倘来生。\n泪尽哭吾父，情伤忽屡倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭中彝兄三首 其二","author":"汪炎昶","text":"我方缠世故，而已返于真。\n亦岂异流俗，自难逢若人。\n病多犹嗜学，客至不知贫。\n毫发犹无愧，情钟骨肉亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭中彝兄三首 其一","author":"汪炎昶","text":"涉世才知命，菱花鬓尚青。\n天如憎善类，君又促馀龄。\n病以忧虞积，和因学力形。\n奚从觇慎密，闾里涕交零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭云泉俞君","author":"汪炎昶","text":"踏雪相过似语离，岁俄在巳可胜悲。\n买臣富贵天悭与，贾谊才名众误期。\n奉养慈闱才有弟，流传家学更无儿。\n羸骖偶跨身为累，稳骤雕鞍竟是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽毕宰二首 其二","author":"汪炎昶","text":"极穷如自虑，笃养有馀欢。\n动以古为法，事皆人所难。\n凶奸多上寿，庸鄙或高官。\n为喜才堪恃，丛深谢砌兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读孙元京诗集","author":"汪炎昶","text":"佐时犹幸识斯人，不尔终身憾不禁。\n诗里重逢神骨峭，老来更觉语言深。\n鬼吟似有声堪听，风过浑无迹可寻。\n死去岂馀毫发恨，生前亲获遇知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪诸公携酒山家用壁间韵三首 其三","author":"汪炎昶","text":"玉屑辉群彦，衣冠俨数翁。\n礼严推让际，情洽笑谈中。\n物外来真趣，樽前□古风。\n无端狂态发，从此忆新丰。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪诸公携酒山家用壁间韵三首 其二","author":"汪炎昶","text":"雪涛奔两涧，毛发竖清寒。\n鼻裂花香劲，衣牵棘刺攒。\n步崖青壁滑，憩树绿阴团。\n莫忘兹游好，题诗后日看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪诸公携酒山家用壁间韵三首 其一","author":"汪炎昶","text":"小试登临脚，岚光饰嫩情。\n跨虚桥缓渡，避险路迂行。\n端被狂为累，虚将饮得名。\n醉乡前日近，才稍认途程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚出山涧","author":"汪炎昶","text":"树崩崖更豁，涧曲路增长。\n片雨暝遥壑，疏蝉凄夕阳。\n竹潭初月影，萝谷稍秋光。\n适叹炎蒸剧，絺衣已怯凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅雨","author":"汪炎昶","text":"萧瑟连朝暮，凄凉抵客居。\n疏渠防更骤，绽屋趁微疏。\n润起荒厨醭，腥传僻巷淤。\n遣愁吾有策，闭户卧看书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨","author":"汪炎昶","text":"欲雨天如惜，先为数日阴。\n碎声才满树，残照已穿林。\n暂喜还成闷，因嗟已作吟。\n固应私此壤，潜洒待更深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"程存虚梦与六人饮酒赋诗余亦与焉而眉长夹鼻下与髯齐觉而记其诗以见示或以此为余寿徵因忆罗汉中有长眉尊者戏次韵","author":"汪炎昶","text":"莫是阿罗汉，前身住化城。\n梦犹形法相，业未刬诗情。\n矧复论修短，真当外死生。\n世人宽作计，端欲俟河清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"编就荆公律","author":"汪炎昶","text":"半山松菊黯风烟，犹有新词世共传。\n暗叶宫商那有韵，绝无脂粉却成妍。\n趋朝玉佩行行整，入手骊珠颗颗圆。\n老子平生端崛强，可能著句独浑然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕读牛女事","author":"汪炎昶","text":"天澄灏气辉银湾，惊鸿未阵点绀寒。\n毕逋之孙嗜秽腐，为梁岂无鹓与鸾。\n暂抛机梭息鞅靷，别久未惬须臾欢。\n聚落扰扰集蠛蠓，小智未易镌孱顽。\n蓬颗牛羊半馁饫，云路险涩托足艰。\n增亏益庳祷乃遂，未见仁悯遗私干。\n经纬森罗蕴精耀，宁论匹偶腾欺谩。\n帝降厥孙责礼币，曷自贷予期追还。\n辎軿沓飒倡河鼓，虽异临邛亦疵瘢。\n政使流光夜奔迸，寸心尚在狐疑间。\n如何东西两相望，躔次不动光芒攒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月食笋","author":"汪炎昶","text":"土底寻鞭剖茁来，花敲社雨乍闻雷。\n髯奴功过难相掩，夭阏中郎笛管胎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三洪遗墨石刻 其三","author":"汪炎昶","text":"几钱典质乐毅论，十鼓尚阙周宣诗。\n响急黄楼须彻夜，碑埋岘首岂无时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上岭","author":"汪炎昶","text":"客程不遑息，犯暑淩嵚崟。\n微风不足凉，汗流被衣襟。\n忙行趁云影，已过他山阴。\n疲极觉更高，攀跻力不任。\n幽蝉若相劳，屡作凄楚吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山行","author":"汪炎昶","text":"林磴诘曲萝茑缠，苍翠逼人诗思鲜。\n烟云改变异状出，草树点缀疏花妍。\n景好初疑未经涉，路熟忽记曾攀缘。\n杖藜兴来不可禦，前有百尺风崖泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山园戏书三物 其三 咏蚯蚓","author":"汪炎昶","text":"群动各矜奋，尔独聊优游。\n引颈欲出穴，忽缩寻无由。\n物资爪牙利，一饱才能谋。\n尔形独何殊，宜有馁死忧。\n乃能乐清夜，和我商声讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山园戏书三物 其一 咏蜗牛","author":"汪炎昶","text":"雨馀露双角，戴角缘攲危。\n吾疑甚为累，失此将何依。\n荒凉一亩宫，晨出暮来归。\n虽不著我体，为累岂异兹。\n应有露卧翁，窃视复见嗤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山园戏书三物 其二 咏虾蟆","author":"汪炎昶","text":"名著虽已古，形模绝丑怪。\n应视坎井卑，不啻河海大。\n时作高雄声，如泄肝肠快。\n欲逃鼎俎烹，绝技惟一□。\n何劳努两目，怒气常不杀。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书兴四首 其三","author":"汪炎昶","text":"兴逼不暇卧，蹑屐鸣鸡先。\n裛袂碧氛润，袭襟爽概繁。\n噫馁出故气，咽甘漱新泉。\n骨瘦易酸楚，体虚觉轻便。\n樵子隔岭见，宁谓吾非仙。\n手持白羽扇，笑坐青崖巅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书兴四首 其二","author":"汪炎昶","text":"时时溪上行，或与幽人遇。\n手把一编书，共倚崖边树。\n鹭近始暂飞，鱼惊却重聚。\n佳景不待求，足熟自知处。\n稚子爱相随，似亦耽幽趣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书兴四首 其一","author":"汪炎昶","text":"山如斲新棱，泉如注新碧。\n醉卧便妥帖，似换松根石。\n混俗悼昔遗，嗜静竦今获。\n吸鲸涤烦想，饫奇苏惫力。\n追往忽悟咎，持虑日增惕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书兴四首 其四","author":"汪炎昶","text":"积阴敛荒霾，崖崿诡秘阐。\n泼光润绿漾，错彩岚翠闪。\n藓槎惊鹘巢，露扑裹虫茧。\n布棋出田庐，洒墨凝鸦点。\n每恨前山逼，遐眺不得展。\n意才豁危陟，日车已攲转。\n畏与俗人逢，归途取迂远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五月二十三日雷雹大作","author":"汪炎昶","text":"午热蒸崖嶂，晡时骤雨来。\n仍年频见雹，中夏始闻雷。\n地撼山疑压，林昏鸟误回。\n吾宁识天意，吟苦自生哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月二十一日大雨数里外旱如故是岁淮浙皆大旱","author":"汪炎昶","text":"见说他州旱，孤怀尚惨然。\n泉浤分脉细，稻垄斸泥坚。\n墟落才连壤，阴晴若异天。\n苍茫千里隔，甘泽固应怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"友人江顺德连日留饮分韵赋诗得日字操笔立成","author":"汪炎昶","text":"峰峦秋翠秾，禾黍晚露湿。\n虽然诗兴多，其奈归情急。\n清逼蓼花风，热薄桐阴日。\n社酒欲娱亲，岂不怀宴集。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"友人俞伯初梦余立悬崖飞瀑之下谓曰吾缘涧曲折而来泉声忽左忽右子其为我赋所未能伯初即句曰石根行步转耳畔水声移遂足成短篇见示次韵答之","author":"汪炎昶","text":"事往孰非梦，岂必梦见之。\n安知非携手，胜处真哦诗。\n而子以为梦，确固不可移。\n竟亦莫能辨，鸦影横空陂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至 其一","author":"汪炎昶","text":"草草欢娱共一觞，葭灰昨夜煦初阳。\n民贫绝喜冬犹煖，客倦翻嫌日渐长。\n造化不停聊阖辟，人情自此隔炎凉。\n欲占岁稔浑无雪，儿诧晴云晓色黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬夜闻雷","author":"汪炎昶","text":"人事正难料，天时仍可猜。\n仲冬连日雨，中夜数声雷。\n穷谷无薪卖，深村有虎来。\n疲民饥馑极，逃徙哭声哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古铜小鼎砚滴铭","author":"汪炎昶","text":"泗水没宝鼎，此岂其云仍。\n煅顽炼钝凝，赤精小瓠断。\n疐枵以盛篆，细丹霞疑古。\n铭如虫啮馀，渗枯青石液。\n迸云吸绀清，溉我毛颖波。\n陶浤豕腹仰，呀外膨亨?。\n而不注闻戛，羹量函合龠。\n三趾狞入屡，出继常如盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"休宁朱肖岩葺其先大父岐山书堂为藏修之所而徵诗于余余闻其先伯父由释褐职教姑苏今其父子能世家学不坠遗基是可敬已为赋二章 其一","author":"汪炎昶","text":"闭门读书非俗人，政使未见犹倾心。\n斑窥已骇文彩异，流长要自根源深。\n松比灵椿健霜骨，草连玉树辉庭阴。\n岐山紫阳近相接，逸响流入花间琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"休宁朱肖岩葺其先大父岐山书堂为藏修之所而徵诗于余余闻其先伯父由释褐职教姑苏今其父子能世家学不坠遗基是可敬已为赋二章 其二","author":"汪炎昶","text":"乃翁读书功未收，大儿收功才□流。\n三年刻楮岂无用，一鸣惊人姑少留。\n大伸纡郁数应值，但力根本吾何求。\n书声夜杂岭猿苦，想见灯火虚堂秋。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同张李二同知及诸学官游石龙潭以韩公炭谷湫诗为韵分赋得捧字","author":"汪炎昶","text":"鬼斧淬霜劂嵚洞，石璺津□□清湩。\n一潭绀影浸秋寒，云染龙腥罥枝重。\n镌瑶□□四巑岏，雄压坤维妥以巩。\n人言曾见华阳儿，突□□濛珠尚捧。\n云璈丁当杂梵呗，悯涸忧枯乞灵宠。\n虚无怪电摇青光，谷搅崖搜雷雨□。\n地储精英固如是，岂必盘涡龙所拥。\n石藓镀绿攲风磴，局步下窥毛发疏。\n蟠鳞潜角见无由，鱼弄戏腮微浪涌。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同张赵二山长及郡城诸友小饮紫阳溪上分韵赋诗得金字","author":"汪炎昶","text":"出郭未云远，野趣觉已深。\n溪声洗尘梦，树影凉絺襟。\n师模炯连璧，士价逾兼金。\n杯行孰为侑，间关爱幽禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同侪坚挽同游用韵为谢然终不能从也","author":"汪炎昶","text":"道人结庐青山巅，如望蓬莱无渡船。\n石栈天梯欲千仞，流水桃花知几年。\n辟佛谁持退之论，入社岂废渊明贤。\n亦闻曾破虎溪界，暂往勿谓吾无缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏题江冲陶池亭","author":"汪炎昶","text":"寒荫竹梢云，清分稻畦水。\n无令鸥鹭知，惊散菰蒲雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早雪","author":"汪炎昶","text":"起晚寒犹力，衣棱刮肉铦。\n吟豪须火逼，汲瓮被冰粘。\n犬卧贪依灶，乌窥欲下檐。\n遥峰惊变状，琢玉闯疏帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次颂符术致雨之韵","author":"汪炎昶","text":"术乃轰雷电，时方切禜雩。\n感通渠自诿，造化本无拘。\n翻想匙明雪，量同斛粜珠。\n天公应有语，尔力不关吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":72926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]