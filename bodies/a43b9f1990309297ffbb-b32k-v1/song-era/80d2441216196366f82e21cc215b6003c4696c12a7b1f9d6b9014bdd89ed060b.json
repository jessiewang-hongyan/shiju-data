[{"title":"寄浮山远禅师","author":"释警玄","text":"杨广山头草，凭君待价焞。\n异苗翻茂处，深密固灵根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄侍郎五曙偈","author":"释警玄","text":"吾年八十五，修因至于此。\n问我归何处，顶相终难睹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"释警玄","text":"宝殿无人不侍立，不种梧桐免凤来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"释警玄","text":"白云覆青山，青山顶不露。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"释警玄","text":"白牛吐雪彩，黑马上乌鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"释警玄","text":"赢鹤老猿啼谷韵，瘦松寒竹锁青烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释警玄","text":"我昔初机学道迷，万水千山觅见知。\n明今辨古终难会，直说无心转更疑。\n蒙师点出秦时镜，照见父母未生时。\n如今觉了何所得，夜放乌鸡带雪飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释警玄","text":"夜半鸟鸡抱鹄卵，天明起来生老鹳。\n鹤毛鹰觜鹭鸾身，却共乌鸦为侣伴。\n高入烟霄，低飞柳岸。\n向晚归来子细看，依稀恰似云中雁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释警玄","text":"撒手那边千圣外，祖堂少室长根芽。\n鹭倚雪巢犹自可，更看白马入芦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和崔象之紫菊","author":"韩琦","text":"紫菊披风碎晓霞，年年霜晚赏奇葩。\n嘉名自合开仙府，丽色何妨夺锦砂。\n雨径萧疏凌藓晕，露丛芬馥敌兰芽。\n孤标只取当筵重，不似寻常泛酒花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重九席上赋金铃菊","author":"韩琦","text":"黄金缀菊铃，兖地独驰名。\n细蕊浮杯雅，香筒贮露清。\n风休沉夜警，雨碎入寒声。\n自此传仙种，秋芳冠玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洋州","author":"韩亿","text":"梁州邻左右洋川，气候融融别是天。\n地僻过冬稀见雁，箐深初夏已闻蝉。\n乡风与蜀微相似，驿路见秦旧接连。\n骆谷转山围境内，汉江奔浪绕城边。\n展开步障蘩花地，画出棋枰早稻田。\n远寺径危攒迸笋，后园池冷软飞泉。\n秋深满院芭蕉雨，晚色临轩薜荔烟。\n南浦采蒲当凛冽，西溪踏石向暄妍。\n夕阳道观鸣钟鼓，夜月人家奏管弦。\n杨柳影中沽酒市，芰荷香里钓鱼船。\n珍禽听久名难辨，新果尝馀味更全。\n野渡潮平分浅濑，群楼云散露高巅。\n喧阗鼓吹迎神社，狼籍杯盘送客筵。\n慈竹清筠霜斗腻，海棠堆艳火争燃。\n苍崖险峻应藏虎，碧洞阴深恐隐仙。\n妓女从游持翠盖，士流寻胜擘香笺。\n戚姬庙宇青芜没，和相诗碑绿藓沿。\n三县俗淳宜静理，两衙事简可閒眠。\n纷华度岁他乡外，幽趣终朝在眼前。\n不为近颁明诏下，及瓜情愿满三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"七夕","author":"韩元吉","text":"银河翻浪拍空流，玉女停梭清露秋。\n天上一年真一日，人间风月自生愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日送酒与朱元晦 其二","author":"韩元吉","text":"老大相望寄一州，故人鄙我倦追游。\n应知命驾无千里，惆怅山堂暮雨秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日送酒与朱元晦 其一","author":"韩元吉","text":"平生爱酒陶元亮，曾绕东篱望白衣。\n底事秋来犹止酒，重阳须插菊花归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入冬苦雨祷晴幸应刘若讷惠诗为贺因次其韵 其一","author":"韩元吉","text":"雨馀云杪澹疏星，老病窥帘眼自明。\n农事已知今岁好，天公剩放十分晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入冬苦雨祷晴幸应刘若讷惠诗为贺因次其韵 其三","author":"韩元吉","text":"灯花作喜夜来占，楼角初晴月似镰。\n便说市亭新酒美，好风寒日舞青帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入冬苦雨祷晴幸应刘若讷惠诗为贺因次其韵 其二","author":"韩元吉","text":"酒难忘处能消日，雨不愁时任戴星。\n欲和新诗无好语，竹窗灯火夜晶荧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入冬苦雨祷晴幸应刘若讷惠诗为贺因次其韵 其四","author":"韩元吉","text":"麦田秋过未休工，䆉稏如云白雨中。\n乞得晴明三十日，披襟可咏快哉风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵子云春日绝句三首 其三","author":"韩元吉","text":"日月行天自汉家，十年京洛恨无涯。\n儿童不识乡园事，竞说江南春后花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵子云春日绝句三首 其二","author":"韩元吉","text":"春来残雪自消檐，只有愁人鬓雪添。\n未省双鞬谈豹略，且听红袖唱香奁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又次韵子云春日绝句三首 其一","author":"韩元吉","text":"乱离谁意有新春，共醉春盘能几人。\n但道沙场无匹马，便惊罗绮总争新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又溪山堂次韵四首 其四","author":"韩元吉","text":"梅子青青杏子红，绕城荷叶已掀风。\n莫嫌春尽无花柳，犹得清樽阿堵中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又溪山堂次韵四首 其二","author":"韩元吉","text":"潋潋溪光白鸟前，昏昏雨脚暮云边。\n一年风景君应记，五月来看竞渡船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山口道中","author":"韩元吉","text":"芳草连云水拍溪，春山树树子规啼。\n东风何事催行客，偏遣残红趁马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山行二首 其二","author":"韩元吉","text":"春来南涧水初生，鸥鸟逢人自不惊。\n步绕幽花随树歇，望寻高柳趁堤行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山行二首 其一","author":"韩元吉","text":"晴日烘林百草香，杖藜徐步兴何长。\n残花的皪明幽径，老笋参差出断墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以双莲戏韩子师 其一","author":"韩元吉","text":"雨洗风梳两斗新，凌波微步袜生尘。\n真成红玉娇相倚，不减昭阳第一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以双莲戏韩子师 其二","author":"韩元吉","text":"并舞连歌意态新，水晶宫里向无尘。\n一时风月谁能许，要是君家两玉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太湖秋晚","author":"韩元吉","text":"片帆几日下西风，湖色秋容暮霭中。\n买得鲈鱼吊张翰，卧听欸乃度垂虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"去岁得黟江县牡丹数种今年开一枝盖白者谱中所谓水晶毬也","author":"韩元吉","text":"黟江新样水晶毬，冰雪肌香体更柔。\n弹压风光知第一，酴醾玉蕊见应羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"去草","author":"韩元吉","text":"永日荒园独荷锄，草根藤蔓喜无馀。\n谁怜仲举平生志，却学齐民种树书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"史十伯强浮沈市廛自号道人而笔力议论不可掩抑岂隐者耶观其诗卷赠以绝句二首 其二","author":"韩元吉","text":"头上尘冠岂易弹，匣中长剑箧中丹。\n放怀风月真馀事，好向朝廷策治安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"史十伯强浮沈市廛自号道人而笔力议论不可掩抑岂隐者耶观其诗卷赠以绝句二首 其一","author":"韩元吉","text":"未容君识得君诗，添我幽栖一段奇。\n会有吹嘘天上去，沈香亭北要新词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圣政更新诏书正告讦之罪因得小诗十首 其十","author":"韩元吉","text":"潮阳初谪八千里，中令俄成十九年。\n地下修文应泚笔，卫公精爽故依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圣政更新诏书正告讦之罪因得小诗十首 其九","author":"韩元吉","text":"荆棘谁令满路栽，雷州司户却生回。\n独怜阳陆真天命，不见承平公道开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295