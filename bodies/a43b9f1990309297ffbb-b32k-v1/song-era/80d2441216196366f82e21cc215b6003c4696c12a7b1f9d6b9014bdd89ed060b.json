f84d192fe5294295f79689","path":"宋_3.csv","pointer":22722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圣政更新诏书正告讦之罪因得小诗十首 其二","author":"韩元吉","text":"桓温将死谢安起，霍氏初除魏相来。\n谁与圣君安大业，巍巍廊庙可无材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"圣政更新诏书正告讦之罪因得小诗十首 其一","author":"韩元吉","text":"恶复凶终事久知，岂知圣断不踰时。\n小儒未叹周南滞，但喜逢人敢说诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"市人有弄虎者儿辈请观饲以豚蹄睹其攫噬戏作四绝句 其二","author":"韩元吉","text":"呀然一啸朔风生，儿女窥帘笑且惊。\n槛内应怜只摇尾，山中不记旧横行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"市人有弄虎者儿辈请观饲以豚蹄睹其攫噬戏作四绝句 其一","author":"韩元吉","text":"眈眈出柙小于菟，犹意他年见画图。\n养汝由来得无患，却惊赤手竞编须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"市人有弄虎者儿辈请观饲以豚蹄睹其攫噬戏作四绝句 其四","author":"韩元吉","text":"荧荧目色为生寒，蛮獠歌呼意自閒。\n莫倚便能探虎穴，势卑还长越王炎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"市人有弄虎者儿辈请观饲以豚蹄睹其攫噬戏作四绝句 其三","author":"韩元吉","text":"长年肉食定何功，乞汝豚蹄且慰穷。\n猿臂将军应老矣，南山忽忆夜弯弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汉光武庙","author":"韩元吉","text":"涿郡渔阳此路分，用兵诸将总如神。\n白头浪说关中事，邓禹当年已笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用梁士衡韵还邓器先道中诗卷","author":"韩元吉","text":"梦绕江南云水乡，麻姑坛下月如霜。\n风光景色一千里，都在君家古锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同翁子功之平江午憩涵山净慈寺","author":"韩元吉","text":"蘋花吹尽藕花香，日落风生水面凉。\n净洗扁舟载明月，共君长啸饮湖光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次棹歌韵","author":"韩元吉","text":"宛宛溪流九曲湾，山猿时下鸟关关。\n钓矶茶灶山中乐，大隐苍屏日月閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子云中秋见寄二首 其二","author":"韩元吉","text":"水绕孤城意自由，远山无数郁相缪。\n月明又作中秋好，白发相望在两州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子云中秋见寄二首 其一","author":"韩元吉","text":"风雨经时忆对眠，秋声愁绝雁横天。\n未应放却西楼月，得酒宁须问圣贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子云春日杂兴五首 其五","author":"韩元吉","text":"山如眉绿画新就，江似蒲萄始泼醅。\n收拾风光付佳句，此行嗟我未空回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子云春日杂兴五首 其四","author":"韩元吉","text":"绿阴池沼乱莺流，眼底春来鬓却秋。\n不用黄金买白日，待寻三径作归休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子云春日杂兴五首 其三","author":"韩元吉","text":"瓦盆倾酒未全贫，岁岁田家肯负春。\n不恨酒醒花落去，花开酒尽最愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子云春日杂兴五首 其二","author":"韩元吉","text":"鶗鴂鸣时春事空，菰蒲叶小未成丛。\n已拚江草无情绿，不奈山花恣意红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子云春日杂兴五首 其一","author":"韩元吉","text":"马上还逢江上春，冷烟和雨作红尘。\n不堪柳絮催行客，也有桃花似故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子云寄杨仙姑酒绝句二首 其二","author":"韩元吉","text":"蒲萄底用博凉州，有酒逢春更上楼。\n留取杨家风味客，对床来此话离愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子云寄杨仙姑酒绝句二首 其一","author":"韩元吉","text":"海上冰浆冠八州，旧传仙姥下层楼。\n一樽压倒长安市，白堕青春未解愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王季夷时同宿蒋山 其二","author":"韩元吉","text":"草堂一壑转山腰，杖策无因隐士招。\n蕙帐只应容我老，冷猿孤鹤夜寥寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王季夷时同宿蒋山 其一","author":"韩元吉","text":"北山应见太清年，兴废由来亦偶然。\n自我得之还自失，老禅刀尺尚相连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王季夷时同宿蒋山 其三","author":"韩元吉","text":"当年丞相读书林，谁识更张万事心。\n垄上牛羊共回首，插天乔木暮阴阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵务观城西书事二首 其二","author":"韩元吉","text":"川摇百艇陆千车，多是淮南避地家。\n黄纸赦来戎马去，儿歌妇笑总呦哑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵务观城西书事二首 其一","author":"韩元吉","text":"腊尽雪晴春欲柔，濛濛烟柳认瓜洲。\n潮生潮落无穷事，江水东西不限愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵石林见贻绝句四首 其四","author":"韩元吉","text":"先生德业万人雄，寻尺犹收爨下桐。\n乞与朱弦弄流水，坐听岩壑起松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵石林见贻绝句四首 其三","author":"韩元吉","text":"青山白水对开帘，佳句中边胜蜜甜。\n机杼由来千丈锦，区区割截笑江淹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵石林见贻绝句四首 其二","author":"韩元吉","text":"敢从州县叹徒劳，斗米真成费束蒿。\n一醉石林岩下月，世间无复武陵桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵石林见贻绝句四首 其一","author":"韩元吉","text":"平昔勋名步玉除，碧油幢下见悬车。\n定知他日平泉记，不数当年种树书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李平叔直舍竹二绝句 其二","author":"韩元吉","text":"诗翁爱竹有佳句，诗就移官可奈何。\n密叶岁寒应更好，剩来和雪看婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵李平叔直舍竹二绝句 其一","author":"韩元吉","text":"寒梢到地不肯屈，迸笋出檐还作行。\n故应馀韵占风月，要自劲节含冰霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵沈明远春尽书事","author":"韩元吉","text":"街槐园柳绿初连，花尽春归思黯然。\n密叶鸣琴清梦断，白云双眼暮山前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]