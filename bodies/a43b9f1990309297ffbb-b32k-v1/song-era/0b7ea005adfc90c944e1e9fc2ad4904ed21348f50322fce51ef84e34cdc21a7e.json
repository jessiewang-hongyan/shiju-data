[{"title":"题日涉园","author":"吴芾","text":"幽园足佳趣，散策日经行。\n岁久禽鱼熟，人来自不惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题圭师松云庵","author":"吴芾","text":"一瓶一钵一枝筇，皓首归来万事慵。\n应笑白云犹世态，却来庵外媚孤松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题许倅浮香亭二绝 其一","author":"吴芾","text":"一新栏槛水中央，更植疏梅向水傍。\n只恐花繁亭太小，黄昏无处著清香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题许倅浮香亭二绝 其二","author":"吴芾","text":"为爱梅花不自禁，拟分风月到花阴。\n水深草满都迷路，祇向暗浮香处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题枕流亭","author":"吴芾","text":"山涵倒影新晴后，水漾圆花乍雨时。\n每到凭栏心似镜，细看无一不相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题金山四首 其四","author":"吴芾","text":"人言海上有三山，弱水瀰茫去路难。\n若欲目前寻彷佛，只须来此凭栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题金山四首 其三","author":"吴芾","text":"北望瓜洲咫尺间，向来白骨积如山。\n欲论旧事慵开口，且对高僧共说闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题金山四首 其二","author":"吴芾","text":"老大疏慵百不堪，倦游犹未脱征衫。\n君王若许投簪去，拟与头陀共此岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题金山四首 其一","author":"吴芾","text":"江上经行四十秋，今朝始得驻扁舟。\n老夫宁复重来日，欲去殷勤更少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题总持寺龙井","author":"吴芾","text":"洞庭归去几何年，旱岁犹来泽我田。\n我访遗踪虽已泯，灵泉百尺尚依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题钟路分见一轩二首 其二","author":"吴芾","text":"懒将功业勒燕然，闭户深居二十年。\n嗟尚强颜纡郡绂，老来犹未得归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题钟路分见一轩二首 其一","author":"吴芾","text":"名利场中车马尘，区区有愧百年身。\n如君未老甘闲退，眼底今方见一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题阅岁亭","author":"吴芾","text":"岁月催人老，少年安在哉。\n羡君杯酒里，日日见花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题蛾眉亭用内翰沈公韵","author":"吴芾","text":"几多去棹与来帆，竞利奔名一水间。\n应怪行人浑不悟，临流长是蹙眉山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题戴雄飞腴轩诗","author":"吴芾","text":"四壁萧然万卷书，时人莫认作癯儒。\n他年得志英华发，始信胸中道味腴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题臞庵","author":"吴芾","text":"轻视浮名若一毛，名园百亩占江皋。\n三贤祠宇谁重葺，何不添公作四高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"憩慈云寺","author":"吴芾","text":"幽人不见许玄度，千载徒存旧梵宫。\n水竹回环犹可爱，徘徊山下想遗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠方山人二首 其二","author":"吴芾","text":"故山久已办菟裘，得去欣闻止在秋。\n涉世安能长戚戚，收心只欲罢休休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠方山人二首 其一","author":"吴芾","text":"日者俱云我未归，独君算我有归期。\n仍言不出三秋里，东望家山喜可知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠余居士二首 其二","author":"吴芾","text":"我老祇思还旧隐，君今更为卜新阡。\n馀生得此夫何欠，所欠归来一溘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠余居士二首 其一","author":"吴芾","text":"君知我意欲休官，却道如今未得閒。\n万事无求惟一退，天公于此不应悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠张发","author":"吴芾","text":"日给都来能几何，汝能受少却辞多。\n试询世上无厌者，还有何人肯恁么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠远老","author":"吴芾","text":"一瓶一钵自由身，聊向江南玩水云。\n踏遍千山并万壑，却归林下炷炉薰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"濠水累年不泄鱼既充牣每触热辄死余既浚治市河因开水门导之入江遂作放鱼二绝 其一","author":"吴芾","text":"局促洿池几岁鱼，想应日日念江湖。\n如今放汝非无意，亦欲天公放老夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"濠水累年不泄鱼既充牣每触热辄死余既浚治市河因开水门导之入江遂作放鱼二绝 其二","author":"吴芾","text":"我今纵汝入江中，好趁风雷早化龙。\n只恐为龙行雨苦，碧波深处且从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"藏云寺有海棠一树在僧舍后竹篱荆棘之间余因劝耕偶见之遣兵移植于堂下仍赋一绝以纪之","author":"吴芾","text":"海棠一树竹篱根，密掩深藏若避人。\n移向亭前端有意，要令山下尽知春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日和向巨源送行韵","author":"吴芾","text":"世事无穷生有涯，羞将白发对黄花。\n一江秋水涵初雁，万里暮天飞落霞。\n昔日自怜长作客，今朝方喜得还家。\n尊前话别宁辞醉，后夜相思月满沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二儿纳妇有感","author":"吴芾","text":"老乘一障楚江滨，无奈星星鬓影新。\n客里情怀那似旧，忙中日月不知春。\n若为经岁抛泉石，犹把非才玷缙绅。\n还尽此生儿女债，盍归林下作闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二十八日出郊劝农陈泽民见示佳作因次来韵","author":"吴芾","text":"雨多晴少恐妨农，相劝欣逢日出东。\n烟蔼已收霄汉外，江山如在画图中。\n相看且喜头俱白，一醉休辞颊暂红。\n万事要从勤苦得，莫言丰歉在天公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二公见和又成一首寄之","author":"吴芾","text":"忆昔同台接胜游，相期端不愧清流。\n一时人物存无几，百岁光阴挽不留。\n老去只思陶靖节，向来尤叹薛居州。\n亦闻聚首时倾倒，应笑衰翁守故丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月晦日劝耕石城三首 其三","author":"吴芾","text":"兀坐无聊赖，所期怀抱开。\n偶驱千骑出，还得十朋来。\n遣兴非无句，消愁亦有杯。\n此心终不乐，祇是忆天台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月晦日劝耕石城三首 其二","author":"吴芾","text":"经年萦吏役，今日作春游。\n梅雪随风去，桃花逐水流。\n已惊时节晚，还叹物华休。\n扰扰终何补，归与老一丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月晦日劝耕石城三首 其一","author":"吴芾","text":"春晓喜新晴，聊为野外行。\n残花红雨乱，垂柳绿丝轻。\n路入藏云寺，山围走马城。\n空馀怀古意，往事与谁评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月望日三七侄移庖于休休堂约四老人为送春之集拙者预一老之数因成八句","author":"吴芾","text":"光阴过眼似奔轮，谁保生前梦幻身。\n四老共成三百岁，一时已胜万千人。\n得閒对酒须拚醉，乘健看花莫厌频。\n勿谓病多衰已甚，尚堪开口送残春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十五夜与朝宗对月把酒朝宗屡怀归因赋二首 其二","author":"吴芾","text":"雾捲云收月迸光，一时烦浊变清凉。\n怪来坐上深无暑，疑是山间已有霜。\n老去岂期身尚健，閒中且以酒为忙。\n故人若也坚辞醉，忍负良宵月满床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十五夜与朝宗对月把酒朝宗屡怀归因赋二首 其一","author":"吴芾","text":"人间无处避炎光，赖有湖山六月凉。\n清夜已欣天似水，长空还爱月如霜。\n我将乘兴拚沉醉，君苦怀归有底忙。\n试问今宵能饮否，更来月下对胡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十六夜再登月台","author":"吴芾","text":"虚度中秋颇动怀，今宵却再上高台。\n强延风月虽聊尔，一对江山亦快哉。\n小子仍携竹叶至，同僚还折桂枝来。\n老夫为尔牵诗兴，笑向花前覆一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又陈伯明知郡远寄诗篇因次韵二首 其二","author":"吴芾","text":"喜到旧家山水乡，依然山色与湖光。\n此身宛在真仙窟，回首空怀太守章。\n岂意新诗犹见及，尚言故郡不相忘。\n自怜秕政无遗爱，安得人思蔽芾棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又陈伯明知郡远寄诗篇因次韵二首 其一","author":"吴芾","text":"信笔题诗不记篇，聊凭赋咏写林泉。\n閒来倚杖云千嶂，睡起凭栏月一川。\n野性已安三径里，吟魂犹绕两湖边。\n何时更许陪清话，复把深杯手自传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和陈天予","author":"吴芾","text":"边敌临江强指麾，狂图欲效白登围。\n一朝殄灭妖氛净，万里欢传盛事稀。\n故国山河看克复，中原父老徯来归。\n六飞便好乘时进，顺取天心莫失机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和金克家送春","author":"吴芾","text":"春来纵使日衔杯，老去逢春能几回。\n幸有良朋同雅集，不妨烂醉罄馀罍。\n羞看落絮愁盈抱，强对残花泪满腮。\n惆怅又为经岁别，莫辞花下少徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月十一日风雹","author":"吴芾","text":"向晚欣逢霁色开，方思花下共衔杯。\n一时雨雹排檐急，万里风云捲地来。\n扫荡千花真可恨，摧残二麦亦堪哀。\n赏心乐事俱休矣，惆怅青春去不回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与江朝宗丁彦功饮酒梅花下二首 其二","author":"吴芾","text":"一笑未易得，今朝岂偶然。\n故园方自适，我辈更相便。\n好月好花夜，不寒不暖天。\n莫辞拚一醉，为我棹觥船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与江朝宗丁彦功饮酒梅花下二首 其一","author":"吴芾","text":"挈榼西园去，花光照月华。\n共看花上月，肯负月中花。\n酒与花俱白，人如月不瑕。\n且陪月花醉，何用苦思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与鹿郎中","author":"吴芾","text":"思到高人见一堂，经年魂梦镇飞扬。\n抱疴已恨身无力，拗俗还疑路有妨。\n聊寄一樽牵酒兴，更凭五字恼诗肠。\n巡檐应索梅花笑，无计从君醉几场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乞身不获再和","author":"吴芾","text":"老合休官况七旬，我非辞富欲居贫。\n也知光景无多日，更觉筋骸不逮人。\n岂谓九重恩未替，复颁一札意犹亲。\n囊封再上终期允，已对苍穹誓此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大阅即事书怀 其二","author":"吴芾","text":"懒散无堪合杜门，十连帅阃若为分。\n仁风尚可扬千里，勇气安能作六军。\n戈甲纷纷徒曜日，旌旗猎猎漫连云。\n归来夹道人争看，应笑苍颜老使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居归来恰一年有感","author":"吴芾","text":"去岁兹辰始息肩，俄然日月已周天。\n经营小隐虽云毕，栽种清阴苦未圆。\n湖畔百年多古木，山前一望足平川。\n从嗟白发催吾老，能享林泉得几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋后一夕烟雨楼玩月","author":"吴芾","text":"危楼百尺俯层城，烟敛云收眼更明。\n四面月华千顷白，一天秋气十分清。\n昨宵欲见浑无计，今夕相看似有情。\n又值病夫慵对酒，赏心乐事信难并。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五月五日领客泛舟","author":"吴芾","text":"要同佳客濯清泉，却下危楼上画船。\n拭目已看云际月，洗心还爱水中天。\n更无暑气侵尊俎，但有薰风入管弦。\n我欲就闲行作别，且拚一醉共陶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仆平日闻有此生待足何时足未老得闲方是闲之句每叹服之恨不知作者姓名一日与鲁漕话次方闻此诗乃福唐余倅所作鲁继录全诗及余君所梦始末见示读之使人益起怀归之兴因成小诗以记其事","author":"吴芾","text":"寒士叨尘分已踰，不为归计待何如。\n暮年光景那能久，浮世荣华总是虚。\n此去直须甘澹泊，个中元自有乘除。\n因公拈起余君话，愈使衰翁忆故庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元夕用胡经仲所寄韵呈辛倅及诸僚友","author":"吴芾","text":"星斗潜移下九天，满城如昼酒如泉。\n当时行乐陪千骑，今日重来恰十年。\n灯烛光中春更好，绮罗丛里月争妍。\n诸君莫惜长鲸量，要向樽前中圣贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元夕有感","author":"吴芾","text":"当涂连岁看烧灯，又见洪都烂满城。\n紫陌人疑春欲晓，清宵天放月争明。\n老逢好景知能几，暗数流年祇自惊。\n亦拟樽前成一笑，吾衰无复旧心情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元宵雪作因成短句","author":"吴芾","text":"天公着意做元宵，陡使新春乐事饶。\n已放金莲开陆地，更疑银阙下云霄。\n坐中星斗浑相照，庭下琼瑰更乱飘。\n佳客莫辞通夕醉，要令来岁记今朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六鹤中偶一鹤折翅","author":"吴芾","text":"皓鹤相从久，衰颜每为开。\n忽闻渠翅折，频使我心摧。\n本意俱仙去，那知偶祸来。\n纵令医得活，无复见毰毸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"开河毕功喜而有作","author":"吴芾","text":"污河积水困薰蒸，开凿那知不日成。\n野水尽从檐下过，客舟还傍市中行。\n江山自昔天然秀，人物从今分外清。\n本为此邦开眼目，老夫双目亦增明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆昔","author":"吴芾","text":"忆昔从吾友，兹焉事笔耕。\n萤窗秋夜短，莲社晚风清。\n乱后成陈迹，重来怆故情。\n惟馀云水客，依旧戏长鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆鹿鹤","author":"吴芾","text":"山中鹿鹤久相疏，恨不归来与汝俱。\n飞舞尚如前日否，奔腾还上后山无。\n不闻警露来庭下，犹想衔花近座隅。\n叹我素钟山野性，从来与汝本无殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月下独酌有怀梁丈因和前韵以寄且约为明夜之集","author":"吴芾","text":"晚来清跸驻旌麾，月色分明彻四围。\n对景已欣群动息，仰天还觉众星稀。\n如今路入中原去，看即春从上苑归。\n况是升平时节近，一尊相属且忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王百洪遭旱经火之后赴官荆南作诗勉之","author":"吴芾","text":"莫将外物挠胸中，旱魃从他更祝融。\n道业不应缘火尽，生涯会复值年丰。\n事经盘错才方见，诗到羁穷句始工。\n休叹徒劳淹幕府，要君努力振家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王瞻叔参政寄惠云笈经因成四韵奉酬","author":"吴芾","text":"老来犹未返林泉，终日区区亦可怜。\n拟扣玄关求至道，喜披云笈探真筌。\n他时使我离尘境，今日由君结妙缘。\n莫谓骨凡难变化，丹成鸡犬尚升仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见市上有卖海棠者怅然有感","author":"吴芾","text":"连年踪迹滞江乡，长忆吾庐万海棠。\n想得春来增艳丽，无因归去赏芬芳。\n偶然担上逢人卖，犹记樽前为尔狂。\n何日故园修旧约，剩烧银烛照红妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"加恩进秩有作","author":"吴芾","text":"庆典施恩及万方，老臣遭遇亦非常。\n顿加多邑惭非称，倍进崇阶惧莫当。\n自念生来无此望，却忧福过有馀殃。\n病躯莫效循墙避，且上天庭控免章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北山席上见梅偶成","author":"吴芾","text":"闻道前村梅已开，有心踏月共徘徊。\n谁知白日匆匆过，竟阻青鞋得得来。\n席上相逢如有旧，尊前伫立恨无媒。\n楼头且莫横孤管，我欲今宵醉百杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"去郡日寄居诸公作饯即席奉呈","author":"吴芾","text":"三年江上守孤城，日日思归去未能。\n虽愧憩棠无惠政，却欣伐木有良朋。\n花开后圃春同醉，月满高楼夜共灯。\n别后要须俱自爱，从今拭目看飞腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月六日同江朝宗花下饮","author":"吴芾","text":"十分拟共醉花枝，底事君来苦后期。\n芍药阶前犹烂熳，酴醾架上已离披。\n春归又是辜杯酒，老去还应惜岁时。\n今日要须拚酩酊，从教人笑赏花迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归来到红梅下有感","author":"吴芾","text":"惜花端拟醉花时，不谓花开失素期。\n去日横枝才蓓蕾，归来满树已离披。\n虽知胜赏输同舍，尚爱馀芳绕曲池。\n花亦念予情不浅，更留残萼索题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"未腊已见四白偶得数语呈子寿且述挽留之意","author":"吴芾","text":"人言三白兆丰年，四白欣逢向腊前。\n细糁芦花初着地，乱飘柳絮忽漫天。\n雅宜领客登台上，正欲开尊向酒边。\n乐岁幸君同赋咏，若为归棹遽翩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":43668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]