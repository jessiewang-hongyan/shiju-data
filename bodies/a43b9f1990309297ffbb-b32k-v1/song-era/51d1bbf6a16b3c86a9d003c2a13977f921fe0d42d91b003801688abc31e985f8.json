[{"title":"继净头归天衣故里","author":"释绍昙","text":"归访荆溪旧钓蓑，看长空雁影沉波。\n临风一扫无踪迹，净地岂容人放屙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"铁钉","author":"释绍昙","text":"恶钳锤下翻身去，个个当阳要出尖。\n钉得虚空无缝罅，有完全有不完全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其五十三","author":"释绍昙","text":"幽赏春华到画桥，金丝拖柳锦翻桃。\n临风不识东皇意，却听流莺舌弄娇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其四十九","author":"释绍昙","text":"春有百花秋有月，夏有凉风冬有雪。\n莫将闲事挂心头，便是人间好时节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其四十","author":"释绍昙","text":"白发将军坐碧油，教婴儿打百花毬。\n被人驰马拿将去，犹把兵书说未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其二十七","author":"释绍昙","text":"太平时节岁丰登，旅不赍粮户不扃。\n官路无人夜无月，唱歌归去月三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五十五首 其二十三","author":"释绍昙","text":"南国江山入战图，生灵何处问渔樵。\n凭君休说封侯事，一将功成万骨枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其一一五","author":"释绍昙","text":"捞摝群迷，示生五浊。\n臭秽通身，如何洗却。\n百滚洋铜浇一杓，彻骨清凉，快活快活。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其一一三","author":"释绍昙","text":"五髻峰头，怨憎会苦。\n热血相喷，重重染污。\n个样老妖魔，惭愧今朝死。\n粗茶一瓯，粗香一炷，供养阿侬。\n愿百劫千生，蓦劄相逢，好眼看承，好心攀顾。\n切莫重行巇险路，背后恐遭人指注。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其一一二","author":"释绍昙","text":"薄福值荒年，日餐三顿粥。\n两眼挂青山，真味填枵腹。\n贫有馀，乐不足。\n谁管古人见延寿不见延寿，山前麦熟与未熟。\n无事岩泉洗耳听，幽禽巧奏阳春曲。\n好大哥，快活快活。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其一一一","author":"释绍昙","text":"浴乎沂，舞雩归。\n道存目击，乐以忘机。\n嗟叹奔驰途路客，抛家失业有谁知。\n杜鹃啼出血，劝得几人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其一一○","author":"释绍昙","text":"二月十五，瞿昙灭度。\n山鸟悲春，山花泣雨。\n尽大地人，有屈无伸处。\n独有瑞岩拄杖子，铁作心肠浑不顾。\n唱太平歌，欢声满路。\n因甚如此，歼厥渠魁，澄清寰宇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其一○九","author":"释绍昙","text":"贫苦芝峰，赏元宵节。\n宴乐佳宾，将何铺设。\n明挑海底灯，细剪亭前月。\n打拍东山瓦鼓歌，掤八剌札，乐有馀，清不彻。\n趣味森严，恰似赵州，曾到未到，吃杯杯茶，洞山生姜不改辣。\n哑，不是知心向谁说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其一○八","author":"释绍昙","text":"昨宵送旧，今日迎新。\n迎新送旧，费尽精神。\n新旧两头忘记了，始知今日是元正。\n不用借婆衫子拜，今年人是去年人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其一○七","author":"释绍昙","text":"航海而来，面壁而坐。\n未明直指单传，先被梁王勘破。\n当门齿露风，只履归何早。\n熊耳峰前，累累荒草，至今惹得行人笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其一○六","author":"释绍昙","text":"杨岐驴弄蹄，天衣雁沉影。\n两个老无知，语不分邪正。\n何似火炉头话，无主无宾。\n是非审定，不违法印。\n我王库内岂有是刀哉，古今多少人以橘皮为火，纷然错认。\n哑，死灰煨杀谁深省。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其一○五","author":"释绍昙","text":"䆉稏黄云，精神玉粒。\n熟知稼穑人，著意勤收拾，已收拾，舂石坠腰，炊香满室。\n客来唱曲贺丰年，抚髀清欢，莫嫌贫极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其一○四","author":"释绍昙","text":"秋菊铺黄，茱萸裛翠。\n彭泽渊明，清吟浊醉。\n一年一度赏东篱，蹉过重阳总不知。\n因甚如此，逐物意移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其一○三","author":"释绍昙","text":"监本祖庭花，东西争擢秀。\n一等放清香，不分新与旧。\n枝枝叶叶，陡顿精神，妆点芝园劫外春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其一○二","author":"释绍昙","text":"八月秋，何处热。\n塞雁来宾，井梧凋叶。\n衲僧拄杖知时节，千里万里一条铁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其一○○","author":"释绍昙","text":"跨弄蹄驴，住疏壁院，千古遗风今再见。\n吞吐何须栗棘蓬，煅炼已成丹九转。\n倾出瓶壶，寒光闪电，扶危妙在通权变。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其九十九","author":"释绍昙","text":"倾倒投子油瓶，拗折龙孙头角。\n大炉鞴里烹煎，香透千岩万壑。\n殷勤奉供昔年高卧白云僧，与无舌人从头咬嚼。\n咬得著，鼓舞升平，唱村田乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其九十八","author":"释绍昙","text":"筀笋剪龙须，山茶烹雀舌。\n款客话家私，各打乡谈说。\n闽蜀同风，浙音迥别。\n老倒芝峰耳重听，子规声诉三更月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其九十七","author":"释绍昙","text":"九旬禁足，困鱼止泺。\n三月安居，钝鸟栖芦。\n圆觉伽蓝俱扫迹，释迦弥勒是他奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其九十六","author":"释绍昙","text":"九曲河清产圣人，行尧舜道觉斯民。\n万邦翘仰垂衣化，鼓舞春风贺太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其九十五","author":"释绍昙","text":"示大家身，为帝王母。\n与佛同生，福兼寰宇。\n万国欢悰庆诞弥，蟠桃何止宴瑶池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其九十三","author":"释绍昙","text":"四十年同参，廿馀年相别。\n不唱菩萨蛮，何暇说佛法。\n蓦劄相逢十二峰，我患生盲你患聋。\n是圣是凡都莫问，且分苔石憩松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其九十二","author":"释绍昙","text":"杨岐栗棘蓬，赵州殿里底。\n一句当机裂万差，尽大地人扶不起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其九十一","author":"释绍昙","text":"久雨新晴，物情显焕。\n蝶弄海棠阴，莺啼杨柳岸。\n声色纯真，不得一半。\n堪笑灵云活眼睛，却被桃花换。\n哑，瞎汉瞎汉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其九十","author":"释绍昙","text":"今朝二月十五，黄面瞿昙灭度。\n诸方挝鼓声冤，尽是闲言长语。\n一点涅槃心，无人知落处。\n山花泪滴如红雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其八十八","author":"释绍昙","text":"兆应丰年，单明一色。\n玉作楼台，银连巷陌。\n新晴人喜贺元正，不识春山头并白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其八十七","author":"释绍昙","text":"当年不合弃金轮，忍冻吞饥度六春。\n又被毛头星换眼，至今苦屈未能伸。\n瑞岩不孝，尚有慈心。\n烧块木头修薄供，且图温饱过，切忌赚他人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其八十六","author":"释绍昙","text":"十方义聚，和气如春。\n非魔非佛，无主无宾。\n食法二轮能妙转，不虚剪月过书云。\n闻韶不知味，门户喜重新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其八十五","author":"释绍昙","text":"要见心珠发耿光，只消一念破悭囊。\n昆虫草木承恩力，世世丛林建法幢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其八十三","author":"释绍昙","text":"九月授衣天，山林无可授。\n破衲拥残云，痴坐蒲团透。\n长庆棱捲帘悟道，病眼见空花。\n香林远纸袄大书，破袖争出手。\n凫短鹤长，驴前马后，不知笑破他人口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其八十二","author":"释绍昙","text":"九月九，重阳节。\n不向东篱赏菊花，只点茱萸茶一啜。\n苦涩难尝舌如㔢，更吞栗棘蓬肝肠裂。\n且道陶渊明，还曾知此味么。\n莫说莫说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其八十一","author":"释绍昙","text":"岩桂飘香，井梧凋叶。\n活祖师机，重重漏泄。\n见得分明眼似眉，道得完全舌如结。\n诸人要知亲切句么，蒲团三月冷如冰，今朝稳坐，静听渠分说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其八十","author":"释绍昙","text":"八月十五中秋节，人皆竞赏天边月。\n心月孤圆自不知，不涉圆亏光影灭。\n马师父子错商量，拂袖便行犹未彻。\n诸人还见心月么，急著眼看，重重金屑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其七十九","author":"释绍昙","text":"人从福州来，接得江西信。\n报道雪峰木毬，辊入育王鳗井。\n怒浪翻空，鱼龙乞命。\n秋风吹落惺惺石上，惊触主人翁酣睡醒。\n掀眉一笑千峰静。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其七十七","author":"释绍昙","text":"雨足龙闲，年丰民乐。\n袖出刈禾镰，大地全收却。\n归来十二峰前，别甑炊香，明玑满钵。\n喂饱活衲僧，曲肱酣睡著。\n佛法身心烂似泥，哑，医无药。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其七十六","author":"释绍昙","text":"六月苦炎热，蜡人何似生。\n火云烹得解，解后却完全。\n堪笑云门老，杲掣风颠，通身臭汗。\n微凉生殿阁，打失鬼精魂。\n要会诸佛出身处，驴年驴年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十七","author":"释绍昙","text":"放下著，莫妄想。\n无孔铁槌，半斤八两。\n面门抛掷，土旷人稀。\n堪笑赵州无业，一味凤林吒之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其七十四","author":"释绍昙","text":"小供天中节，家贫乐有馀。\n蒻包粳米粽，茶点石菖蒲。\n不用童寻药，何须鬼画符。\n千妖俱扫迹。\n长夏得安居。\n衲僧门下，天地悬殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其七十三","author":"释绍昙","text":"结夏已半月了也，水牯牛作么生。\n爱从荒草去，不向坦途行。\n闹中牵索，静处加鞭。\n月白风清眠露地，声声牧笛响烟村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其七十一","author":"释绍昙","text":"广汉马驹子，十方罗汉僧。\n不吃金鸡粟，专衔血战冤。\n古龙渊吸乾到底，清凉树靠倒无根。\n五处移场弄巇险，化机曾不涉春缘。\n休征藏密，地陷天崩。\n棠棣花残雁沉影，椎胸未免哭苍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其七十","author":"释绍昙","text":"茅舍春深，韶华可人。\n山花裛翠，烟草如茵。\n况有寻幽客至，锦囊探句，藜杖挑琴。\n握手松根同一笑，高风曾不护东林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其六十九","author":"释绍昙","text":"无辨古今眼，有辨古今舌。\n说得十分真，何如见得彻。\n见得彻，耿耿心灯夺夜寒。\n年年宴赏元宵节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其六十七","author":"释绍昙","text":"向上机，顶门眼。\n察秋毫处暗昏昏，透险崖中平坦坦。\n三世诸佛，正视无门，白牯狸奴，活埋何限。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其六十六","author":"释绍昙","text":"道德五千言，深明玄妙句。\n云门一字关，截断横陈路。\n十二峰前，危分险布。\n唤醒惺惺石上瞌睡主人公，握手评论，掀眉笑语。\n惊放寒梅一两花，漏泄先春，奔驰驿使。\n哑，寻香逐臭人无数。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其六十五","author":"释绍昙","text":"书云开管宴，法轮食轮转。\n觑之双眼盲，味之唾三咽。\n云门胡饼，谩自誇张，杨岐栗蓬，急须收卷。\n露柱灯笼，春风满面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其六十四","author":"释绍昙","text":"一二三四五，六七八九十。\n梵语华言译不成，玉几重新添注解。\n字义炳然，无人领解。\n赖有同风知，点头道奇怪。\n彷彷佛佛，一似东山瓦鼓歌。\n腔调宛同，声无高下。\n彭八剌拶，未在未在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其六十二","author":"释绍昙","text":"九月授衣天，芝峰无可授。\n破衲拥寒云，对客慵开口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其六十一","author":"释绍昙","text":"三月休征，修文偃武。\n治格太平，生灵鼓舞。\n无端塞马嘶风，又欲扬尘簸土。\n密运机筹，肃行师旅。\n塞北安南一战收，生死冤魔都扫去。\n重赏元勋，凯歌声撼芝峰路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其六十","author":"释绍昙","text":"雷轰荐福碑，天秘无文印。\n字义既难明，心传谁得正。\n东湖泻恨浪滔天，惊?瑞岩残梦醒。\n猛拍阑干，叫天不应。\n哭不成兮笑不成，野花泪湿千峰影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其五十九","author":"释绍昙","text":"前宵剪月亭边，曲奏高山流水。\n虽云狮子筋弦，品弄必资妙指，不落宫商人耸耳。\n嘉州大像增百倍精神，荆溪老龙添十分活意。\n正音将谓绝无闻，谁料郑声乱雅中，有此清弹尔。\n惭愧惭愧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其五十八","author":"释绍昙","text":"一春连雨，民心忧惧。\n妻子号饥，米无籴处。\n珍重活衲僧福德聚，衲被蒙头无思无虑。\n九旬禁足，钝鸟栖芦。\n三月安居，蛰虫坏户。\n翻转铁面皮，嫌佛不肯做。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其五十七","author":"释绍昙","text":"岭上云磨松偃蹇，岩前瀑漱石琮琤。\n瞿昙面目全彰露，谁道今朝始诞生。\n跛云门棒，休放拍盲。\n一杓香汤三拜著，听渠千古恶名行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其五十二","author":"释绍昙","text":"一点心灯，灵明炳焕。\n去古来今，清光无间。\n不同万斛金莲，惑乱痴人赏玩。\n今朝上元节，拈出普请看。\n拟议寻思，空华翳眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其五十","author":"释绍昙","text":"兜率天宫初说梦，修多罗藏又谈空。\n一人人饱纯陀味，不与寻常至节同。\n娟娟萝月，瑟瑟松风。\n四壁生涯贫彻骨，敌君王富乐无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其四十九","author":"释绍昙","text":"打破剑门关，未死先辞世。\n书偈自涂糊，白把骊珠碎。\n口款细供通，自首原其罪。\n木人歌舞石人悲。\n声遏行云，雁序分，影落千峰外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其四十八","author":"释绍昙","text":"雨后溪声寒弄玉，风前木叶碎飘金。\n见闻互用非声色，花劈威音古佛心。\n见成家乐，管宴佳宾。\n莫谓瑞岩岑寂甚，一回拈出一回新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其四十七","author":"释绍昙","text":"僧钵一粒饭，农家一滴血。\n战争收拾归，知费几牙颊。\n明玑杵白，别甑炊香。\n伴客地炉烧榾柮，无宾主话商量。\n切忌增金以黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其四十六","author":"释绍昙","text":"秋阳肆酷，划地奔雷。\n洗涤袢襟，喜而不寐。\n懿德山王赠之以偈：大旱逢甘雨，他乡遇故知。\n攧崖泉漱玉，尝稻雪翻匙。\n咿呜咿，谁知艰棘际，复见太平时。\n拄杖子，暗中闻得，手之舞之，足之蹈之。\n暑退凉生前路活，化龙一跃出天池，赢得庞公笑展眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其四十五","author":"释绍昙","text":"秋旸肆酷，秋暑炎蒸。\n不容鹅护雪，难保蜡人冰。\n一夏噇眠虚过了，秋风拈弄刈禾镰。\n有权有用，无党无偏。\n几个祖师头割了，立教凶岁变丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其四十四","author":"释绍昙","text":"长须翁，久不见。\n壁角深藏，心灰百炼。\n将期休影息阴，岂谓明明弄险。\n点出夜叉心，擘开菩萨面。\n丑恶既乖张，佛手难遮掩。\n赢得春山哭杜鹃，鲜血染花枝，声声怨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]