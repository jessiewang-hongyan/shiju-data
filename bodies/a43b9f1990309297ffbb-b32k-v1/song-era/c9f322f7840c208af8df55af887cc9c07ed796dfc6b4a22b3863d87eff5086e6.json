[{"title":"南乡子 次张安国韵","author":"朱熹","text":"落日照楼船。\n稳过澄江一片天。\n珍重使君留客意，依然。\n风月从今别一川。\n离绪悄危弦。\n永夜清霜透幕毡。\n明日回头江树远，怀贤。\n目断晴空雁字连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 次秀野酴醾韵","author":"朱熹","text":"压架年来雪作堆。\n珍丛也是近移栽。\n肯令容易放春回。\n却恐阴晴无定度，从教红白一时开。\n多情蜂蝶早飞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其一 回文","author":"朱熹","text":"晚红飞尽春寒浅。\n浅寒春尽飞红晚。\n尊酒绿阴繁。\n繁阴绿酒尊。\n老仙诗句好。\n好句诗仙老。\n长恨送年芳。\n芳年送恨长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其二 次圭父回文韵","author":"朱熹","text":"暮江寒碧萦长路。\n路长萦碧寒江暮。\n花坞夕阳斜。\n斜阳夕坞花。\n客愁无胜集。\n集胜无愁客。\n醒似醉多情。\n情多醉似醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 刘知郡生朝","author":"朱熹","text":"秀野诗翁，念故山、十年乖隔。\n聊命驾、朱门旧隐，绿槐新陌。\n好雨初晴仍半暖，金釭玉斝开瑶席。\n更流传、丽藻借江天，留春色。\n过里社、将儿侄。\n谈往事，悲陈迹。\n喜尊前现在，镜中如昔。\n两鬓全期烟树绿，方瞳好映寒潭碧。\n但一年、一度一归来，欢何极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其二","author":"朱熹","text":"已分江湖寄此生。\n长蓑短笠任阴晴。\n鸣桡细雨沧洲远，系舸斜阳画阁明。\n奇绝处，未忘情。\n几时还得去寻盟。\n江妃定许捐双佩，渔父何劳笑独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其三 叔怀尝梦飞仙，为之赋此。归日以呈茂献待郎，当发一笑","author":"朱熹","text":"脱却儒冠著羽衣。\n青山绿水浩然归。\n看成鼎内真龙虎，管甚人间闲是非。\n生羽翼，上烟霏。\n回头祗见冢累累。\n未寻跨凤吹箫侣，且伴孤云独鹤飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其一 江槛","author":"朱熹","text":"暮雨朝云不自怜。\n放教春涨绿浮天。\n祗令画阁临无地，宿昔新诗满系船。\n青鸟外，白鸥前。\n几生香火旧因缘。\n酒阑山月移雕槛，歌罢江风拂玳筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鼎湖","author":"朱藻","text":"孤峰独立耸巑岏，辙迹苔封晕未乾。\n秀拔山川清气上，直冲星斗夜光寒。\n东南拟作擎天柱，今古称为压地盘。\n上有鼎湖风雨隔，宝莲吹下碧云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"采桑子","author":"朱藻","text":"障泥油壁人归后，满院花阴。\n楼影沈沈。\n中有伤春一片心。\n闲穿绿树寻梅子，斜日笼明。\n团扇风轻。\n一径杨花不避人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈有功","author":"朱黼","text":"生平不肯负所学，高洁清风自凛如。\n逆孺殿岩辞特荐，昵交戚畹绝私书。\n不矜虏馆穿正鹄，甘向蛮溪佩左鱼。\n沅芷澧兰香满路，万人恸哭护灵舆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真珠帘","author":"朱㫹孙","text":"春云做冷春知未。\n春愁在、碎雨敲花声里。\n海燕已寻踪，到画溪沙际。\n院落秋千杨柳外。\n待天气、十分晴霁。\n春市。\n又青帘巷陌，红芳歌吹。\n须信处处东风，又何妨对此，笼香觅醉。\n曲尽索馀情，奈夜航催离。\n梦满冰衾身似寄。\n算几度、吴乡烟水。\n无寐。\n试明朝说与，西园桃李。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大涤洞天留题","author":"朴子文","text":"不得入壶中，不知有洞天。\n未许涉弱水，蓬瀛名空传。\n洞霄古真境，九锁开其先。\n灵殿拱嘉树，奇岩漱飞泉。\n朝气夜沆瀣，夕岚蟠霏烟。\n自从汉晋间，隐迹丛真仙。\n所以镇琳宫，距今千百年。\n我来寻胜游，聊以息尘缘。\n谁意得高人，凡百为之前。\n扪萝扣大涤，曳裾登来贤。\n宫殿本邃靓，亦许奉周旋。\n倦游恬小憩，借我幽榻眠。\n觉我黄粱梦，枕上破缠绵。\n醉我真一酒，春台熙熙然。\n勿谓房栊深，入室乃渊渊。\n勿谓栏槛小，栖幽即㛹娟。\n苟有一拳石，天巧意已全。\n苟有一树木，风月亦足延。\n况是石与木，森罗呈万妍。\n有仙山即灵，君当悟真筌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过龟山","author":"朴寅亮","text":"岩岩峻石叠成山，下著珠蠙一水环。\n塔影倒垂淮浪底，钟声摇落碧云间。\n门前客棹洪涛急，竹下僧棋白日闲。\n一奉胜游堪惜景，故留诗句约重还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"朴寅亮","text":"万叠危岑天倚杵，一竿斜日水浮金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌夜啼","author":"权无染","text":"洗尽铅华污，玉颜自发轻红。\n无言雪月黄昏后，别是个丰容。\n骨瘦难禁消瘦，香寒不并芳秾。\n与君高却看花眼，红紫谩春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤凰台忆吹箫/凤凰台上忆吹箫","author":"权无染","text":"水国云乡，冰魂雪魄，朝来新领春还。\n便未怕、天暄蜂蝶，笛转羌蛮。\n一树垂云似画，香暗暗、白浅红班。\n东风外，清新雪月，潇洒溪山。\n应是飞琼弄玉，天不管、年年谪向人间。\n占芳事，铅华一洗，红叶俱残。\n多少烟愁雨恨，空脉脉、意远情闲。\n无人见，翠袖倚竹天寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孤馆深沈","author":"权无染","text":"琼英雪艳岭梅芳。\n天付与清香。\n向腊后春前，解压万花，先占东阳。\n拟待折、一枝相赠，奈水远天长。\n对妆面、忍听羌笛，又还空断人肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 其二","author":"权无染","text":"一点檀心紫，千重粉翅光。\n蔷薇水浸淡鹅黄。\n别是一般风韵、断人肠。\n有艳难欺雪，无花可比香。\n寻思无计与幽芳。\n除是玉人清瘦、道家妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南歌子 其一","author":"权无染","text":"照水金莲小，披风宝麝浮。\n雪中开占百花头。\n一味潇潇洒洒、自风流。\n病态含春瘦，芳魂傍月愁。\n轻烟微雨更清幽。\n遮莫姚黄相并、也应羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故侍读黄公挽诗","author":"权安节","text":"西南人物早推先，入践华途誉望全。\n朱邸谈经忠贯日，黄扉批敕力回天。\n敬王素学真无负，忧国沉疴竟莫痊。\n初政遽辜求助意，忍观遗事照青编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石门山","author":"权巽","text":"兹山甲天下，葱翠自开辟。\n石磴缘空青，新营眩金碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄靖安令","author":"权巽","text":"嵯峨幽谷山，寂寞彭泽令。\n绝境空自奇，高标岌相映。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答王黄门寄密蒙花","author":"毕士安","text":"多病眼昏书懒寄，烦君远寄密蒙花。\n愁无内史兼词翰，为写真方到海涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"国清寺","author":"毕士安","text":"三四百年寺，今来国又清。\n若非逢圣祚，徒自有嘉名。\n月殿五峰色，风松十里声。\n不缘君命束，便好脱尘缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"禁林宴会之什","author":"毕士安","text":"好文英主古难齐，宠重词臣意弗低。\n睿藻清新刊翠琰，神踪飞动在璇题。\n芸签许效蓬莱阁，花槛容模罨画溪。\n乐圣朋侪开绮席，爱君诚抱挂金闺。\n买臣晚遇知多幸，犬子端忧思转稽。\n天地恩私无以报，只将兢慎对芝泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨照承议芦雁枕屏","author":"毕仲游","text":"画师不肯传风蝶，故作枯乾逞奇绝。\n清秋未合结繁阴，深户何曾洒飞雪。\n雪里鸭儿苦耐寒，眠沙枕浦白云团。\n黄芦槭槭枝叶乾，江头鸣鸭恰飞起，恍如身到潇湘间。\n潇湘洞庭云水隔，山路坡陀断行客。\n从来冬景画已难，况有翎毛似鹤白。\n已觉冰漫稻粱少，更疑水宿溪垠窄。\n生平有道付沧洲，今日床头行动色。\n屏风主人家近便，我昔曾过浔阳县，田芦野雁尝亲见。\n出门解榻定相逢，借我江乡今对面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 其一 春寿太守","author":"毕大节","text":"玉笋京华，紫荷香润，宴闲密侍西清。\n碧幢金节，仍尹凤皇城。\n须信千龄庆遇，丹霄上、重叠恩荣。\n时多暇，湖山丽景，许酒乐升平。\n新春。\n逢诞日，莺花渐好，初过烧灯。\n想笙歌丛里，醉赏瑶觥。\n占尽人间福寿，行看取、稳赞机衡。\n貂蝉映，朱颜绿鬓，沙路马蹄轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 其二","author":"毕大节","text":"井络储精，岷江钟秀，挺生名世真贤。\n充闾佳气，非雾亦非烟。\n况值小春时候，蓂背下、八荚争妍。\n馀波在，九华父老，歌颂轓喧阗。\n三年。\n书治最，南唐重赋，一旦俱蠲。\n此恩垂不朽，刻石流传。\n愿借沧溟为寿，玳筵上、满吸长川。\n从兹去，鸾坡凤阁，平步稳登仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"信阳道中避暑","author":"毕仲游","text":"下马汤家市，前村数里赊。\n败篱瓜少蔓，簇舍豆先花。\n放袖从风入，停鞍待日斜。\n欲知为客恨，更久不成家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"睢阳五老图诗","author":"毕世长","text":"非才最忝预高年，分务由来近挂冠。\n敢造钜贤论轨躅，幸依都府得盘桓。\n篇章捧和惭风雅，眷待优隆荷岁寒。\n傥许衰容参盛列，愿凭绘事永传看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真霜寺","author":"毕田","text":"石上泉华喷猛霜，境奇因此辟禅坊。\n使君环笏留何用，枯木千馀满一堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朱陵洞水帘","author":"毕田","text":"洞门千尺挂飞流，玉碎珠联冷喷秋。\n今古不知谁捲得，绿萝为带月为钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罗汉绦","author":"毕田","text":"五百移栖绝洞深，空留辙迹杳难寻。\n绿丝绦带何人施，长到春来挂满林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"神鼎山","author":"毕田","text":"玉趾分明印绝巅，药成仙去几千年。\n深藏宝鼎今方出，合得丹经与世传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"香水","author":"毕田","text":"坎上浮图已拂天，椒兰遗馥尚依然。\n九重无复脩常贡，空有香名与邑传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"掷钵峰","author":"毕田","text":"应将钵渡斗神通，掷去乘将赴帝宫。\n争似岭头提不起，于今相续阐真风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39794,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉乡","author":"毕田","text":"三宿酣神酎，乡名因此呼。\n山中千日者，自合是仙都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39795,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凝碧亭","author":"毕田","text":"四面山屏叠万重，古岚浓翠锁寒空。\n清秋独倚危阑立，身在琉璃世界中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39796,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大哀洲","author":"毕田","text":"玉辇南巡去不还，翠娥望断楚云间。\n波寒剩写哀弦怨，露冷偏滋泪筱斑。\n一水盈盈伤远目，九峰??惨愁颜。\n荒洲千古凄凉地，半掩空祠向暮山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39797,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹅羊山","author":"毕田","text":"羽客何年此鍊丹，尚留空灶镇孱颜。\n云中鸡犬仙应远，山下鹅羊石转顽。\n湘渚几因沧海变，辽城无复令威还。\n何年仙驭还来此，尽遣飞腾上九关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39798,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送程给事知越州","author":"毕仲衍","text":"朝回鸣橹下东流，人自承明向越州。\n印绶光华将过里，江山萧洒去迎秋。\n香销琐闼成新梦，云映蓬莱识旧游。\n须体圣心图任切，鉴湖虽好莫淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39799,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"好事近 席上赋","author":"毕良史","text":"高会罢飞觞，方锦再移珍席。\n雷鼎乍烹甘液，试问侯苍璧。\n翠虬宝钏捧殷勤，明灭粲金碧。\n宾主放怀谈笑，满华堂春色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39800,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 席上赋","author":"毕良史","text":"霜月穿帘乍白，苹风入坐偏凉。\n麾灯促席诧时光。\n桃花歌扇小，杨柳舞衫长。\n别乘平分风月，词人剩引觥觞。\n莫将幽恨搅刚肠。\n尽添金掌露，频注玉猊香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39801,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和范公希文怀庆朔堂","author":"毕京","text":"花木还依旧径栽，春园不惜为谁开。\n几多民俗熙熙乐，似到老聃台上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39802,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙虎山","author":"江万里","text":"凿开风月长生地，占却烟霞不老身。\n虚靖当年仙去后，未知丹诀付何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荷花","author":"江万里","text":"结亭临水似舟中，夜雨潇潇乱打篷。\n荷叶晓看元不湿，却疑误听五更风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花 其一","author":"江万里","text":"草际春回残雪消，强扶衰病傍溪桥。\n东风不管梅花落，自酿新黄染柳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花 其二","author":"江万里","text":"床头周易用心来，旧卷经年病不开。\n到得初冬梦颜子，欠伸俄健起寻梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝贺","author":"江万里","text":"四海衣冠拜九重，圣君在位像飞龙。\n遥瞻雉扇双开处，万岁齐呼瑞气浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘲元宰相","author":"江万里","text":"钓得金鳌休便休，何须垂上钓鱼钩。\n昨宵试向江头望，明月芦花别是秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝农","author":"江万里","text":"农岂犹需我劝农，且从人意卜年丰。\n喜闻布谷声声急，莫为催科处处穷。\n父老来前吾语汝，官民相近古遗风。\n欲知太守乐其乐，乐在田家欢笑中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和瑞雪","author":"江万里","text":"与天通处在人和，未有人和天荐瘥。\n消息连朝来玉阙，川原满眼尽银河。\n坡书已得欧公体，力士宜尊太白靴。\n人物于今如越雪，欲令惯见不嫌多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题黄鹤楼","author":"江万里","text":"黄鹤楼高倚半天，楼中黄鹤去千年。\n檐楹自是留真境，几席何妨得老仙。\n云护山光秋驻马，日笼江影昼停船。\n良工改写归图画，俯仰令人一慨然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗退风涛","author":"江万里","text":"万里为官彻底清，舟中行止甚分明。\n如今若有亏心事，一任碧波深处沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柯山图","author":"江万里","text":"柯山千仞郁嶙峋，喜见丹青写送人。\n洞府无人留永日，神仙有路隔重云。\n苍松白石秋容净，绝壁悬崖晓势分。\n归向公庭对真景，却疑人是画中身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钟陵归舟即事","author":"江万里","text":"昨日北风今日强，归船又过斫柴江。\n浮槎却被春流误，挂在沙头古柳桩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39814,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辟妖禽吟","author":"江万里","text":"去国离家路八千，平生不爱半文钱。\n苍天鉴我无私意，莫使妖禽夜叫冤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39815,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道番昜登龙虎","author":"江万里","text":"瞻彼高山，苍苍相缪。\n云舒霞张，溪谷险幽。\n鸣鹤在树，猿猱啾啾。\n青松多风，白露已秋。\n仙乎曷去，胡不少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39816,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 寿二亲","author":"江万里","text":"生日重重见，馀闰有新春。\n为吾母寿，富贵外物总休论。\n且说家怀旧话，教学也曾菽水，亲意尽欣欣。\n只此是真乐，乐岂在邦君。\n吾二老，常说与，要廉勤。\n庐陵几千万户，休戚属儿身。\n三瑞堂中绿醑，酿就满城和气，端又属人伦。\n吾亦老吾老，谁不敬其亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39817,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"江万里","text":"不忍骤开还骤落，殷勤含蕊待君来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39818,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"江上渔父","text":"十年江上无人问，两手今朝一度叉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39819,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"江公亮","text":"好是道人岩边月，夜深清照饮牛溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39820,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久旱微雨","author":"江公著","text":"云叶纷纷雨脚匀，乱花柔草长精神。\n雷车却碾前山过，不洒原头陌上尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39821,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉泉庵","author":"江公著","text":"风暖客衣轻，山行眼乍明。\n人非少年事，泉作旧时声。\n草屦春游倦，茶瓯午睡清。\n不教身自在，城郭莫烟生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39822,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉楼春","author":"江开","text":"风前帘幕沾飞絮。\n家在垂杨深处住。\n倚楼无语忆郎时，恰是去年今日去。\n帝城箫鼓青春暮。\n应有多情游冶处。\n争知日日小阑干，望断斜阳芳草路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39823,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杏花天","author":"江开","text":"谢娘庭院通芳径。\n四无人、花梢转影。\n几番心事无凭准。\n等得青春过尽。\n秋千下、佳期又近。\n算毕竟、沉吟未稳。\n不成又是教人恨。\n待倩杨花去问。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39824,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]