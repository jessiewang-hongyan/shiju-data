[{"title":"黄相儿求诗","author":"陈著","text":"相儿执笔请翁书，要受持从入学初。\n我有至言儿听取，心宜庄敬气宜舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寓建宁推厅送黄子俊","author":"陈著","text":"一聆清话觉昏蒙，樽酒何时可再同。\n最是秋风恃轻薄，易吹羁袂作西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"朝归生日女洸有诗因次韵","author":"陈著","text":"老爷不记汝生辰，一见杯盘便是春。\n兄姊味言儿记取，同胞皆是读书身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游灵济寺方丈酒边","author":"陈著","text":"天画轩前酒一杯，爱閒能有几人来。\n明朝又入深山去，安得如潮日两回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游雪窦杖锡七首 其二 飞雪亭","author":"陈著","text":"雪瀑翻崖直下深，自从开辟到如今。\n天寒水涩山风急，不断朝宗一派心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游雪窦杖锡七首 其三 妙高台","author":"陈著","text":"不到兹台四十年，临风独立意悠然。\n胸中多少难言事，便欲凭高叩九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游雪窦杖锡七首 其七 杖锡入山亭","author":"陈著","text":"山上山根溪一湾，著亭管领此溪山。\n云南更在青天际，步一步高从此攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游雪窦杖锡七首 其五 徐凫岩","author":"陈著","text":"平揖天风一望来，苍崖万仞两分开。\n是中猿鹤亦难得，只有龙云相往回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游雪窦杖锡七首 其四 隐潭","author":"陈著","text":"何神擎破陇头岩，尽束溪流下碧潭。\n潭底有龙能变化，好将霖雨活东南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游雪窦杖锡七首 其一 锦镜池","author":"陈著","text":"万仞崖擎碧玉台，中閒一镜帖天开。\n四时自与幽花对，一点时妆不照来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游雪窦杖锡七首 其六 踟蹰岭","author":"陈著","text":"石路崔嵬云上头，北云南雪此鸿沟。\n谁人题作踟蹰岭，不到山心不当游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游蔡峰道中三首 其二 半坑","author":"陈著","text":"叠障中閒一隙天，数家茅屋鹳巢边。\n逢人试问营生事，笑指岩前煮草烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游蔡峰道中三首 其三 回途望黄沙坑怀朝儿","author":"陈著","text":"昨日山前痛忆儿，回头凝望更依依。\n如今精爽知何在，采得兰花泣看归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游蔡峰道中三首 其一 碧渚庵前","author":"陈著","text":"恩袍拜后两周星，今日西行得再经。\n休问庵中僧在否，满檐松竹旧时青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登慈云阁偶成三首 其三","author":"陈著","text":"行人笑我又偷閒，说与行人听我言。\n知得浮生皆定分，有谁教汝自煎烦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登慈云阁偶成三首 其二","author":"陈著","text":"悠悠双鹭趁溪飞，欲带清风何处归。\n湖海近来难著脚，灵山深处自知机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登慈云阁偶成三首 其一","author":"陈著","text":"五里晴行信一筇，入松迎面旧松风。\n斜阳归路樵渔笑，翁自何来半醉中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答妻侄赵良藩问学","author":"陈著","text":"藩兄欲学书，来问学何如。\n孝悌为根本，文章特绪馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答法椿长老口占","author":"陈著","text":"床前何必问云何，霜顶谁将手自磨。\n可是法身真有病，皱眉头处为人多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答眚医王东林求□","author":"陈著","text":"我抱东林未见心，诸贤诗上见东林。\n两瞳不觉针锋到，一瞬清风扫宿阴。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢云岫重五送酒粽","author":"陈著","text":"金黍琼浆忽到前，方知相近吊湘天。\n客中寂寞堪骚屈，暖熟风光出老禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢单景山载酒同赏牡丹过燕馀","author":"陈著","text":"珍重提樽过小园，更呼贵客到樽前。\n教人镫下看颜色，知得浮生一梦然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢居简送茶面","author":"陈著","text":"银丝饼熟笋供臛，玉糁羹香茶嗽芽。\n食粥案头添雅供，不知此味更谁家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢绍兴石梅癯遗本堂二篆书","author":"陈著","text":"飞下云閒玉箸书，忽如梦觉揖梅癯。\n古来髓脉今谁识，称得山中老饿夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢戴时芳惠物","author":"陈著","text":"蚁绿浮香雪外春，锦翰飞动玉芝新。\n山人已约餐松柏，此馈应知是获麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4c