t":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龄叟得稼山好语因赞之","author":"陈著","text":"高怀不是爱山行，钟鼓楼高有宿盟。\n今夜老禅联榻卧，定应说到有西成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碶头","author":"陈著","text":"篙师无力橹声柔，已分前途夜泊舟。\n忽报西风吹柁尾，不须斜日到程头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"横桥观荠","author":"陈著","text":"物理元随世事新，静观知是泮宫人。\n穿花野荠虽微草，也占年年一分春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中","author":"陈著","text":"乐游原上少年春，安乐窝中快活身。\n古到如今能几日，吁嗟天也不由人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中出门得风字","author":"陈著","text":"残生有今日，一醉得清风。\n想见羲皇上，人人此乐同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中示梅山弟二首 其二","author":"陈著","text":"两山合秀水流中，茅屋相忘松竹丛。\n时节往来容易事，菜汤艾酒一家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉中示梅山弟二首 其一","author":"陈著","text":"夜镫曾醉藕花凉，笋担归来雨亦香。\n閒里不妨长聚首，人生能得几斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题丹霞洞","author":"陈著","text":"丹山高处坐龙宫，山下人归润泽中。\n北马一尘飞不到，危时方见有神功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题严子陵钓台二首 其二","author":"陈著","text":"方信先生大有功，光皇祇是暂时雄。\n东都二百年名节，全在桐江一钓风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题严子陵钓台二首 其一","author":"陈著","text":"才得心安便是通，乘龙非贵钓非穷。\n那知碌碌攀鳞者，尽在先生不钓中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题思远行业碑","author":"陈著","text":"虎溪虽小深似海，截断英雄富贵尘。\n却为渊明过溪笑，方知心自有高人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕馀寄月窗兄三首 其三","author":"陈著","text":"昨夜还乡已夕阳，夕阳今日已他乡。\n回头咄咄相思语，准拟东风好送将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41