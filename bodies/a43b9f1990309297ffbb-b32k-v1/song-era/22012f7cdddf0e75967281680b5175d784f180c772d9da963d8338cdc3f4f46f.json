[{"title":"自零口夜至渭南县作","author":"强至","text":"月黑征途暗，羸驹傍险行。\n村遥微认火，县近忽闻更。\n落寞殊乡意，喧啾小市声。\n故园流水在，想像见冰清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟过三郡率值风雨呈同行沈氏昆仲","author":"强至","text":"冥冥细雨湿高秋，花底歌前也合愁。\n烟树几株疏雨岸，风帆一梦过三州。\n生涯未解谋根固，官路那能免叶浮。\n却羡邻船樽有酒，不妨弟劝与兄酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行河道中","author":"强至","text":"风起秋河吹旆旌，林梢初日露微明。\n壤歌接野知尧力，水害横堤想禹平。\n无数焚香迎使节，不妨傍辔问农耕。\n江湖未敢生归兴，为恋车茵每侍行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行叟权秋掾比回正老以诗寄之因次韵奉和","author":"强至","text":"郡狱乏掾属，君才盛府依。\n犴牢烦暂掌，鸾枳复卑飞。\n尽室轻装去，新吟满箧归。\n风流伤别处，粉泪洒红衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西距渭南二十里有佛祠曰梁田其主僧守遂者引予登阁久之欲题名屋壁守遂遽阻曰有榜谕恐得罪于邑大夫愿勿题又阁有韩玉汝赴洋州日留题诗板而书字犹新询于守遂曰前日韩将漕本道亦邑宰令写之诗也因感世态而作","author":"强至","text":"洋州太守驻双轮，佳句曾留渭水春。\n一纪却题关右节，二篇才出屋间尘。\n濡毫忽听山僧语，题柱须防县令嗔。\n只道衣冠专世态，炎凉也属不毛人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观仲灵久雨诗且道余与公济吟从之意辄次韵奉和二首 其二","author":"强至","text":"吟思那知岁月新，初莺啼雨早经旬。\n娟娟野竹通寒水，洗洗江梅冷照人。\n鹫岭并游劳梦寐，虎溪一笑尚参辰。\n千金褒字形篇尾，迹未相同意已亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观仲灵久雨诗且道余与公济吟从之意辄次韵奉和二首 其一","author":"强至","text":"诗兴句牵日日新，年光初破雨弥旬。\n旧游已得新工部，佳句今逢休上人。\n云外驰心关水石，江边搔首望星辰。\n泥深未爱寻山屐，谁与西庵杖屦亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观棋","author":"强至","text":"斗智不斗力，一枰思解围。\n防人甚勍敌，平地有危机。\n蜗角争先后，狼心竞是非。\n傍观缩手者，往往见精微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观嘉祐南宫奏名","author":"强至","text":"主司拨马选龙媒，二百珍群奏籍开。\n皎皎公衡垂日月，仪仪士类望风雷。\n诚知至鉴无遗照，那免良工有滞材。\n乡国几人同应诏，只将春色与关裴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过练湖","author":"强至","text":"湖畔难寻使者麾，湖光犹照旅人衣。\n气蒸泽国能无润，堤贮云天别有围。\n杨柳经霜相对老，凫鹥饱食自由飞。\n系舟索纸题诗句，更把闲愁付落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过洺州","author":"强至","text":"朔野风烟古，临洺气象存。\n魏风沿土性，漳水抱城根。\n故垒盘荒草，残碑落近村。\n太平民产富，桑柘半郊原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何太宰生日二首 其二","author":"强至","text":"河岳灵神拥瑞来，剑川一夜起云雷。\n祥风破腊吹灰琯，和气先春报砌槐。\n龙邸久膺心膂托，金瓯终为姓名开。\n年年已与梅花约，长借清香入寿杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何太宰生日二首 其一","author":"强至","text":"却数中秋已过旬，老君亲送玉麒麟。\n力侔二气文词重，迥继诸公德业醇。\n论道他年要黄发，看公当世斡洪钧。\n泰山如砺河如带，到此犹为剑履臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初入汴","author":"强至","text":"山势随淮断，河流带地浑。\n严风疏树影，落日露沙痕。\n客兴双蓬鬓，吟怀一酒尊。\n舟行那敢缓，霜意满乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋与赵无愧小饮下关河亭季秋送客复至其间偶成短句","author":"强至","text":"秋早津亭一笑歌，红妆晚景落清波。\n重来霜后攀疏柳，更向风前数败荷。\n物理盛时能有几，人生乐处亦无多。\n不知当日樽前曲，却傍谁边敛翠娥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别王彦祖宫赞","author":"强至","text":"别襟曾判宋玉台，魏北相逢一笑开。\n帅府红莲曾入幕，公堂黄菊偶衔杯。\n未应许国全无策，祇恐趋时自有才。\n且置功名归度外，诗筒频附塞鸿来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别林仁祖御史","author":"强至","text":"论交乡里各儿童，三纪相看两鬓蓬。\n孤宦无资元附骥，故人得意近乘骢。\n秦仪面激殊今日，管鲍心知有古风。\n归兴严程何太急，片时车马复西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即席再赋","author":"强至","text":"乐事遥追戏马台，高吟节物纵天才。\n三朝致主诚心竭，九日携宾笑口开。\n白酒似随秋露滴，清歌疑唤晓云回。\n放怀不有公台贵，惯得萸枝首赐来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即席依韵奉和司徒侍中上巳会许公亭二首 其二","author":"强至","text":"三春乐事揖兰亭，驻旆名园敞绣扃。\n酒盏绿深须露白，花梢红少已多青。\n宾裾特盛人间会，公衮能忘物外形。\n化笔暂归诗句里，清风一诵醉还醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即席依韵奉和司徒侍中上巳会许公亭二首 其一","author":"强至","text":"禊事初脩乐未涯，晴阳浓淡薄云遮。\n风光转入庭前柳，春色随来席上花。\n千载风流追曲水，万人游豫掩长沙。\n相公今日携诸吏，那比山公醉习家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈陆革进士","author":"强至","text":"鱼沫遇穷能一煦，莺声得意亦相求。\n近来无复友朋义，独善颇为鱼鸟羞。\n今日指心论皎皎，明朝掉臂逐悠悠。\n世间唯我交夫子，忧喜同怀二十秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园竹为大雪所折","author":"强至","text":"露叶烟稍拂草亭，雪中颠倒翠虬形。\n且留完处裁吹律，莫听傍人议杀青。\n却恐看来愁野客，若为扶起属园丁。\n寂寥数亩清风地，宿酒从今不易醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宋都忆梅","author":"强至","text":"古屋前头几树梅，长年腊后已全开。\n自经远别凭谁寄，欲问清香无使来。\n空与吟怀惊岁月，愁将客眼对尘埃。\n枣林榆筴粗疏甚，索寞山东把酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张君枉道顾予因书短篇以答来贶","author":"强至","text":"煌煌肉食有高冠，附者如驰顺坂丸。\n吾子与时诚异向，穷山为我肯相看。\n更烦溢幅投玑琲，自愧无门借羽翰。\n努力穷年求禄仕，而今行路倍云难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"志远法师挽辞","author":"强至","text":"寂寞湖边寺，荆溪目已瞑。\n窗云犹晓白，竹径自寒青。\n野鸟悲吟动，门人感涕零。\n里无梁补阙，谁可法师铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旱秋喜雨","author":"强至","text":"风吹旱叶作秋声，凉气微从雨脚生。\n赤地黄埃归一洗，寸心远目觉双清。\n乾坤应救街前暍，黎庶如逃釜内烹。\n我喜南窗无俗物，葛衣飘洒体还轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李花","author":"强至","text":"地暖春才半，蹊深气已暄。\n风光何处好，雪浪此时翻。\n匀似金刀剪，装成玉杖繁。\n夭桃漫相压，吏部竟谁言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杜以诗和答依元韵赠之","author":"强至","text":"子美没已久，正风几替陵。\n上天忧道丧，远裔以诗承。\n驽足辄追骏，鴳心聊慕鹏。\n微之重堂奥，努力愿同登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨公济岁暮惠酒","author":"强至","text":"绀瓶白酒下吟堂，洗盏倾瓷肯漫尝。\n寒屋自融春日面，煖杯能转少年肠。\n山妻相对惊愁破，稚子无端笑饮狂。\n百岁光阴空自远，醉时苦短醒时长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纯甫小池生双莲","author":"强至","text":"造化有诡异，双蕖共萼翻。\n凌波洛神艳，泣竹舜妃魂。\n得所虽欣地，犹孤尚笑根。\n圣朝不言瑞，图献恨无门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纯甫出近郊以梅花未开成篇见贻因次元韵奉酬","author":"强至","text":"朔吹鸣时万叶黄，独留琼蕊擅幽芳。\n水边野外开虽晚，腊后春前赏未忙。\n素艳若敷应雪妒，嫩心犹閟已风香。\n此花更是梅仙咏，消得花间饮百觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"走笔依韵和杨进士倜登南楼之作","author":"强至","text":"当年割据属英雄，楼观诚奢物产穷。\n藩镇一归平削后，关河尽入照临中。\n离宫此日号大壮，织杼无人歌小东。\n全魏万家今乐业，衮衣惟恐迓周公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"走笔和杨蟠从事庭菊","author":"强至","text":"杨子门无载酒宾，菊开谁共醉天真。\n檐前寂寞逢吟客，霜后蹉跎伴主人。\n钿带缀花疑细剪，金钱绕屋岂全贫。\n东家早秀誇桃李，今日空枝不似春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"走笔送杨正臣先辈还吴","author":"强至","text":"客衣沾魏土，归马望吴云。\n一纪困游宦，异乡愁送君。\n骅骝行得路，鸿雁去成群。\n何日江天酒，重论别后文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"走笔谢司徒侍中惠柑","author":"强至","text":"十年空忆满林香，今日堆盘得恣尝。\n摘处嫩苞金隐粟，剖来清液露盈囊。\n自堪珍玩誇群目，可惜馀甘落俗肠。\n拜赐愈知公意重，不同设醴望元王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辛亥九日晚登骑山楼","author":"强至","text":"楼倚秋风引兴长，龙山吹帽忆前良。\n帘虚霜气清逾逼，叶脱天形远更详。\n巧送四筵双舞袖，坐收万景一诗囊。\n登高且醉铜台酒，黄閤多年望衮章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迓漕台感书","author":"强至","text":"郡县齐瞻使者麾，马蹄行处是霜威。\n前驱宁免为负弩，高谢未能图拂衣。\n顾己自知吾道在，折腰甘被俗人讥。\n古来策足皆贫贱，伊起耕夫吕钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邑斋偶书","author":"强至","text":"作邑穷山奈拙何，簿书期会损天和。\n却缘众醉独醒甚，翻觉同舟敌国多。\n岂顾有人张巧舌，第忧无术拯颓波。\n偏亲垂老妻孥少，独愧渊明归去歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰月晦日","author":"强至","text":"乾坤一传舍，日月两征轮。\n邂逅逢馀闰，连绵送晚春。\n巢边迎燕熟，枝上数花频。\n渐暖茅檐日，吾将理葛巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京兆府初赴同天节宴诗二首 其二","author":"强至","text":"五帝今云六，君王合万年。\n日长迟漏水，风细驻炉烟。\n想像联朝佩，欢呼捧御筵。\n喜深恩更远，不竭似秦川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京兆府初赴同天节宴诗二首 其一","author":"强至","text":"四月薰风转，三天瑞景舒。\n歌从归启后，寿起祝尧初。\n诗喜南山对，身甘北阙疏。\n九韶音未作，朝野自欢如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和公济寄仲灵禅老","author":"强至","text":"藤州大士两眉厖，万卷丛身寄一窗。\n诗力健能支倒岳，词源涌可截奔江。\n高名耸动朝中士，旧隐荒芜岭外邦。\n想像孤风犹未见，何时能使片心降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和尹嗣复仲春会食船场","author":"强至","text":"野色宽围四缭墙，一穿林径百忧忘。\n浓花细草青春半，语燕游蜂白日长。\n寄兴不知诗笔倦，惜时犹喜酒杯香。\n席间数点残英坠，万片随风此滥觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和尹嗣复秘校登回銮寺阁有感之什","author":"强至","text":"尹子辞才两崛奇，家声好继汉翁归。\n人间茂器无施设，天畔危栏独据依。\n诗兴远随孤鸟逝，客心闲傍片云飞。\n登临不比江南节，何事徘徊怨落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和王立之中秋阴云不见月","author":"强至","text":"更长不见水精盘，搔首庭除夜向阑。\n一气人间清自转，孤光云外好谁看。\n关河夜色暗朔漠，楼阁吟魂飞广寒。\n幕府病眠憔悴客，独无乐事可相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和令绰兄弟春日出郊","author":"强至","text":"春色才从野外知，柳阴花气暖霏霏。\n出林啼鸟逢人住，掠路游蜂傍马飞。\n薄宦尘埃空自哂，长吟风物阻相依。\n弟酬兄唱饶才思，珠玉同携满袖归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和正老自叹之什二首 其二","author":"强至","text":"我无尺地可耕锄，君有高田占具区。\n若论生涯犹厚薄，独于宦意等分铢。\n壮年未建鸿毛利，寸禄聊甘稚齿孥。\n不学庸庸自持者，高冠空食上农夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和正老自叹之什二首 其一","author":"强至","text":"妙年为学耻迂疏，直欲声光擅八区。\n已是宦情嗟澹泊，可堪世态较锱铢。\n不调台鼎行吾道，便翼天兵戮汝孥。\n出入功名当若此，自馀琐细尽非夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和正老暮秋郊行感事","author":"强至","text":"秋郊物物作秋容，目送横天一鹗雄。\n更远更疑山隔雾，或飘或聚叶随风。\n对时唯恐朱颜改，遣兴除非白酒充。\n感事子真成丽倡，恨无佳句敌才翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和仲灵禅师喜贾丞相赵翰林见称辅教编之什","author":"强至","text":"浩荡藤州老，雄文鼓大编。\n声名元自重，述作许谁传。\n成诵惭空久，相逢偶未缘。\n承明内外相，交口誉师贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和达夫泛湖之作","author":"强至","text":"雨气随云却上天，山头已扫欲晴烟。\n柳条不尽空围岸，荷叶犹新未碍船。\n时序百年催乐事，乾坤一笑入诗篇。\n主人著姓平原后，莫惜金樽醉绮筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和达守徐郎中见寄","author":"强至","text":"铙鼓鸣船送出都，中间不奉一行书。\n荷公恩礼无时薄，接物襟怀似旧虚。\n久别近参元帅幕，相逢屡枉使君车。\n诗筒自附西来驿，那要烟波双鲤鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和伯宪九日感怀","author":"强至","text":"隔雾南山愁漠漠，破烟东日淡晖晖。\n风欺白发勤吹帽，酒妒黄花故点衣。\n九日泪兼疏叶落，几时身逐短蓬归。\n青云欲早秋先晚，更惜登高乐事违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和判府司徒侍中雪霁登休逸台","author":"强至","text":"环台雪后从公登，四顾乾坤表里明。\n粉水半消池日薄，玉枝相戛竹风清。\n园林洒落人间世，樽酒逍遥物外情。\n写景不须搜画笔，诗参化匠自天成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和吴七丈咏雪二首 其二","author":"强至","text":"江边玉树浑无地，世上银河自有桥。\n宿冻即交山口路，冷波应减海门潮。\n当年右席辞空在，今日扁舟兴转遥。\n宽褐红炉温坐外，人间万事任寥寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和吴七丈咏雪二首 其一","author":"强至","text":"平明无数六花飘，气象崔嵬变一朝。\n落势孤城围不尽，寒威穷巷著偏饶。\n临衣未拂还成舞，近烛才看早觉消。\n散称少陵吟白发，更逢太白跨鲸腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和张文通中舍寄韩师元判官","author":"强至","text":"从容须陛对，萧洒待家居。\n近阁从戎笔，闲裁寄旧书。\n青衫逾一纪，黄卷尚三馀。\n闻说山斋好，何时遂曳裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和张文通寺丞寄鲜于子骏职方","author":"强至","text":"西州夫子善谈天，语入精微服四筵。\n交分正论诗卷里，别愁忽到酒樽边。\n马冲雪片归梁苑，莺唤年芳忆渭川。\n盛事青云看接迹，衣冠乡里旧多贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和张君仪职方城上观雪","author":"强至","text":"重城雉堞粉相围，乱片情多故点衣。\n浩荡关河无表里，微茫草树有光辉。\n冷侵容鬓双蓬短，急伴年华一箭飞。\n却忆水曹诗句好，群鸦接翅傍昏归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和张叔毅读柳先生文","author":"强至","text":"先生萧瑟半涂休，一跌青云不再收。\n名压班行来众毁，笔镵造化起天雠。\n王韦党破谁为地，柳播风殊愿易州。\n庙食罗池今尚否，满编遗韵掩鸣球。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和李持正晚晴出谒王子高马上口占之作","author":"强至","text":"谪仙醉跨玉鲸鳞，夷甫名谈喜更闻。\n照眼暖光开野日，入怀晴气散江云。\n尘埃洗去人家好，空阔飞来鸟翼勤。\n莫望帝乡频感慨，世间随处有珍群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和杨公济喜嘉定帅王待制移成都","author":"强至","text":"把诏心先剑外飞，一身与国系安危。\n玉关落日辞金印，锦水春风转绣旗。\n历见本朝归秉轴，多由全蜀出分麾。\n少陵漫为知音喜，行到花溪已恐迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和杨尉郊外怀乡","author":"强至","text":"策马长郊羡子真，独赢风物与诗论。\n惊飞雁鹜投前涧，归去牛羊识旧村。\n暴涨溪声闻远近，久阴山气乱朝昏。\n异乡我亦嗟游宦，莫说啼鹃有怨魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]