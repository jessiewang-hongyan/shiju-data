[{"title":"绝句","author":"游开","text":"黄陵庙前湘水春，春烟愁杀渡湘人。\n人随归雁去无迹，水远山长歌又新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":907,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘叔通","author":"游开","text":"昨夜刘郎叩角歌，朔云寒雪满山阿。\n文章无用乃如此，富贵不来争奈何。\n邴郑向尝依北海，晁张今复事东坡。\n吹嘘合有飞腾便，未用溪头买钓蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":908,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"千秋岁 侄庆侍郎致政","author":"游文仲","text":"今年为寿，都道是、不比寻常时节。\n预庆我公八帙，来献新词一阕。\n算得年时，恰当尚父，入相周西伯。\n亲逢盛事，宗孙也五十八。\n一门富贵荣华，盈床牙笏，何待拈来说。\n且上祝龟龄鹤算，从此千千百百。\n笑道儿时，风流丹篆，写向龙驹额。\n更将彩笔，十字头上添一丿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":909,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠叠山先生","author":"游古意","text":"满腔忠孝有天知，不管人间事已非。\n万里乾坤双草履，百年身世一麻衣。\n行藏自信床头易，卧病惟餐陇首薇。\n傥过宗周见离黍，几多新泪向残晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄鹤楼","author":"游似","text":"长江巨浪拍天浮，城郭相望万景收。\n汉水北吞云梦入，蜀江西带洞庭流。\n角声交送千家月，帆影中分两岸秋。\n黄鹤楼高人不见，却随鹦鹉过汀洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汲泉烹茶寄叶君康直","author":"游师雄","text":"清甘一派古祠边，昨日亲烹小凤团。\n却恨竟陵无品目，烦君粗鉴为尝看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺岷州守种谊破鬼章二首 其二","author":"游师雄","text":"围合洮州敌未知，烟云初散见旌旗。\n忽惊汉将从天下，始恨羌酋送死迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺岷州守种谊破鬼章二首 其一","author":"游师雄","text":"王师一举疾于雷，顷刻俄闻破敌回。\n且喜将门还出将，槛车生致鬼章来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"着棋台","author":"游师雄","text":"石桥跨两岫，野叟尝远蹠。\n旁有枰棋处，云是仙人弈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过九成宫旧址二首 其二","author":"游师雄","text":"不见六龙驻跸，空馀五栝阴森。\n当日宫前流水，潺湲直到如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过九成宫旧址二首 其一","author":"游师雄","text":"今古市朝已变，隋唐楼殿成空。\n惟有山头明月，夜来犹照荒宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早起","author":"游次公","text":"银床露湿井华寒，自挈铜瓶汲水还。\n宿雨未乾池馆静，凉蝉犹在栋梁间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"耒阳道中","author":"游次公","text":"山头磴石危梯险，山下荒田野草悲。\n更著秋风吹两鬓，不消几日尽成丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画虎","author":"游次公","text":"平生射虎裴将军，马狞如龙弓百钧。\n手撚白羽旁无人，注虎使虎不敢奔。\n须臾丛薄斓斑出，人马不知俱辟易。\n矢如蓬蒿弓减力，将军得归几败绩。\n徐行爪牙元不露，眈眈垂头若微顾。\n尾剪霜风林叶飞，倏忽山头日光暮。\n包家画出真于菟，我尚不敢编其须。\n昔人作诗讥画图，吁嗟画图今亦无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋虫","author":"游次公","text":"一气动芒沕，鸣虫应清商。\n天机发天籁，托彼蛩与螀。\n凄然起秋声，感我彻肺肠。\n幽思不自识，远兴来何方。\n至音有如此，始晤韶与章。\n风霜入凄断，月露皆悲凉。\n天地有声乐，呻吟委寒荒。\n尔非丝竹奏，那得登君堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子","author":"游次公","text":"风雨送人来，风雨留人住。\n草草杯盘话别离，风雨催人去。\n泪眼不曾晴，眉黛愁还聚。\n明日相思莫上楼，楼上多风雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺新郎 月夜","author":"游次公","text":"斗柄回秋律。\n素蟾飞、冰霜万里，满川金碧。\n得月偏多何处是，惟有桥南第一。\n正野迥、西风寒寂。\n丹桂婆娑疏影在，想微瑕、未累千金璧。\n河汉远，澹无迹。\n知君有句酬佳夕。\n尽高歌、胡床自倚，露漙珠溢。\n坐到参横星欲暗，隐隐天低似笠。\n但络纬、悲啼催织。\n吟咏凄凉翻有恨，谅知音、人远空追忆。\n谁为置，郑庄驿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺新郎 宫词","author":"游次公","text":"暖霭浮晴籞。\n锁垂杨、笼池罩阁，万丝千缕。\n池上晓光分宿雾，日近群芳易吐。\n寻并蒂、阑干凝伫。\n不信钗头飞凤去，但宝刀、被妾还留住。\n天一笑，万花妒。\n阿娇正好金屋贮。\n甚西风、易得萧疏，扇鸾尘土。\n一自昭阳扃玉户，墙角土花无数。\n况多病、情伤幽素。\n别殿时闻箫鼓奏，望红云、冉冉知何处。\n天尺五，去无路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满江红 丹青阁","author":"游次公","text":"一舸归来，何太晚、鬓丝如织。\n谩叹息、凄凉往事，尽成陈迹。\n山迫暮烟浮紫翠，溪摇寒浪翻金碧。\n看长虹、渴饮下青冥，危栏湿。\n谁可住，烟萝侧。\n俗士驾，当回勒。\n伴岩扃，须是碧云仙客。\n风月已供无尽藏，溪山更衍清凉国。\n恨谪仙、苏二不曾来，无人说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满江红","author":"游次公","text":"云接苍梧，山莽莽、春浮泽国。\n江水涨、洞庭相近，渐惊空阔。\n江燕飘飘身似梦，江花草草春如客。\n望渔村、樵市隔平林，寒烟色。\n方寸乱，成丝结。\n离别近，先愁绝。\n便满篷风雨，橹声孤急。\n白发论心湖海暮，清樽照影沧浪窄。\n看明年、天际下归舟，应先识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绍兴乙丑七月幕谷游何萧卿乘月独游淡岩书事兼简零陵宰君李兄秀实","author":"游何","text":"渡过潇江日已曛，影和明月共三人。\n名岩近郭别州少，好事更谁如我真。\n绝顶有天浮碧树，凌秋无暑断红尘。\n终当早弃人间事，来与山僧作并邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绍兴乙丑秋仲冒雨独游阳华岩胜绝未让淡山岩恨古今诗人未有奇句潏上游何临清流以赋之且棕鞋桐帽怅不一陪浮溪先生金华居士以徜徉","author":"游何","text":"西风卷痴云，欲压不堕地。\n化作碧孱颜，融结在空际。\n是名阳华岩，造物一何异。\n东山雨脚断，明月招我至。\n傍窥嵌窦深，密恐鬼神閟。\n细度泬寥风，旧无卑湿气。\n虚阁架其中，榜以浮岚美。\n下有潺湲溪，翻雪轰雷比。\n阁背两桥分，岩胁双龙起。\n石如缨络垂，整整翠緌委。\n又如鼙鼓形，挝击声颇厉。\n溪水相与喧，镗鞈乱宫徵。\n岩穷天忽开，木杪风自靡。\n坐久发毛寒，兴逸诗语绮。\n无人共一尊，有客自千里。\n山僧颇慇勤，相伴亦忘寐。\n拂石要题诗，挥毫留汉隶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沙冈待潮","author":"游君传","text":"待潮舟阁浅边冈，少憩田园竹树凉。\n数点弄秋疏雨过，槿花篱落带斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴塘晚泊","author":"游君传","text":"西风吹客鬓，孤坐欲销魂。\n野棹他乡客，酒旗何处村。\n稻随秋雨熟，水带晚潮浑。\n寂寞吴塘路，尘沙望眼昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺侍郎 其一","author":"游志甫","text":"松竹青青耐岁寒，长随初度喜相看。\n操同一节冰霜劲，身直三朝柱石安。\n顾问正资持从橐，佚闲坚乞领祠官。\n扶危筋力知尤健，肯向风涛袖手观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺侍郎 其二","author":"游志甫","text":"预喜新元八秩逢，渭川曾说兆非熊。\n清癯骨相今迂叟，纯雅文章昔醉翁。\n乔木旧推清望重，植槐新长绿阴丰。\n都将祝颂无穷意，写入金杯寿酒中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题集仙桥","author":"游冠卿","text":"南桥颓废长官羞，新作川梁代济舟。\n上应星文横北极，下飞虹影落中流。\n惭无子产乘舆惠，谩绝襄公茀道忧。\n路接蓬山仙世界，品题今为邑人留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠画士林尧卿","author":"游彦举","text":"古称名画顾丹青，遗迹远绍难其人。\n迩来忽睹林尧卿，绘像工夫殊绝伦。\n解后俾尔写吾形，妙处一笔夺天真。\n始知人杰间世生，何代无才充选抡。\n待需飞诏来枫宸，凌烟特命书勋臣。\n此时此意倍精神，宁复踆踆走路尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阅武喜晴和厉寺正韵","author":"游清夫","text":"阅武堂前宿雨晴，柳营刁斗五更鸣。\n风生貔虎誇身健，日射旌旗照眼明。\n管领春光三月暮，雕镌诗句十分清。\n折冲樽俎今馀事，自有胸中十万兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水亭","author":"游酢","text":"清溪一曲绕朱楼，荷密风稠咽断流。\n夹岸垂杨烟细细，小桥流水即沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"在颍昌寄中立","author":"游酢","text":"萧条清颍一茅庐，魂梦长怀与子居。\n五里桥西杨柳路，至今车马往来疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题河清县廨","author":"游酢","text":"小院闲亭长薜萝，鹿来穿径晚经过。\n夕阳萧散簿书少，窗里南山明月多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韦氏独乐堂","author":"游酢","text":"林下徜徉得至游，高情不与世情谋。\n羲和叱驭日逾永，猿鹤寻盟山更幽。\n踽踽凉凉还自哂，休休莫莫复何求。\n应门稚子非无意，客至萧萧已百忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"归雁","author":"游酢","text":"天末惊风急，江湖野思长。\n悲鸣愁绝塞，接翼冒风霜。\n泽岸多矰弋，云间乏稻粱。\n茫然栖息地，饮啄欲何乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝应寺读书堂成因怀明道先生","author":"游酢","text":"桥西积雪度新晴，卜筑茅堂快落成。\n郁郁奇花铺野趣，关关好鸟和书声。\n春浓岚色无边景，水净天光彻底清。\n记得程门窗草绿，至今遐想每驰情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饯贺方回分韵得归字","author":"游酢","text":"邀客十分饮，送君千里归。\n情随绿水去，目断白鸥飞。\n松菊今应在，风尘昔已非。\n维舟待夜月，能不重依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游宝应寺","author":"游酢","text":"崒嵂三峰带白湾，谁开兰若翠微间。\n竹林云懒禅心定，草径苔荒屐齿斑。\n天入碧岚成玉宇，鸟飞青嶂出尘寰。\n此中即是蕊珠境，遮莫閒吟一解颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韦深道寄傲轩","author":"游酢","text":"早付閒身老故乡，青松成径菊成行。\n支颐独坐心遗念，坦腹高吟兴欲狂。\n瓮下却应嗤毕卓，篱根遥想对羲皇。\n乘风破浪门前客，试问浮家有底忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日山行有感","author":"游酢","text":"十里桥西别有天，青山欲断翠云连。\n园林寂寂鹿为友，野服翩翩儒亦仙。\n风咏舞雩正此日，雪飘伊洛是何年。\n追寻往事顿成梦，回首春光倍黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"廌山书院","author":"朱熹","text":"三十年来宿草庐，五年三第世间无。\n门前獬廌山常在，只恐儿孙不读书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"接花","author":"游酢","text":"色红可使紫，叶单可使千。\n花小可使大，子小可使繁。\n天赋有定质，我力能使迁。\n自矜接花手，可夺造化权。\n众闻悉惊诧，为我屡叹吁。\n用智固巧矣，天时可易欤。\n我欲春采菊，我欲冬赏桃。\n汝不能栽接，汝巧亦徒劳。\n雨露草必生，霜雪松不死。\n有本性必生，亦时雨与之。\n所遭有变易，是亦时所为。\n时乎不可违，何物可违时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登归宗岩","author":"游酢","text":"奇冠南闽此最奇，归宗千古是谁归。\n至今来访谁先至，知是曹刘先我知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠陈仲循","author":"游酢","text":"即今年才五十馀，脱去簪绂弊屣如。\n圣时搜选动空谷，策足要路争先趋。\n庙堂故人握重柄，僵者可植瘦可腴。\n惓惓风义数寄语，掉头不顾甘如愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中即景","author":"游酢","text":"翠霭光风世界，青松绿竹人家。\n天外飞来野鸟，涧中流出桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"游酢","text":"青山控野双门壮，白浪排空万马来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"多丽 寿待郎十二月初七","author":"游慈","text":"约梅花，年年开向华筵。\n借清香，飞入寿杯中，永祝英贤。\n才履长、便登八帙，那须要、更待来年。\n和气先春，祥风破腊，蓂开七荚正敷妍。\n君不见，太公此际，犹欲钓磻川。\n争知道、副车已办，西伯来畋。\n驻东阳、清谈终日，种成桃李森然。\n向庭闱、绯衣戏彩，更孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浣溪沙 贺人女晬","author":"游稚仙","text":"晬日先联瑞日红。\n寿星明照寿筵中。\n庆门乐事正重重。\n明日贾逵添戏彩，异时李汉看乘龙。\n鱼轩玉轴定荣封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海棠","author":"湛道山","text":"深院无人春日长，游蜂来往燕飞忙。\n海棠娇甚成羞涩，凭仗东风催晓妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荷花","author":"湛道山","text":"涌金门外凉生早，无数荷花斗娇好。\n自怜贫病不出门，无奈心情被花恼。\n夜来一雨愁思浓，晚看玉露垂庭草。\n便须扶杖买兰舟，莫待红妆被霜老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"荼蘼 其一","author":"湛道山","text":"雨后溪流半没沙，粉墙卖酒是谁家。\n客中不觉春深浅，开了荼蘼一架花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"湛道山","text":"一奁碧玉烟开晓，十里红云风作秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游黄山留题","author":"焦本心","text":"自有乾坤不记年，山中紫翠尚依然。\n百千万世留今日，三十六峰横暮烟。\n怪石矬松名岳上，神仙天子一人传。\n桃花流水丹垆畔，欲往从游洗俗缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"焦宗古","text":"酿成汉帝招王母，饮罢凉州拜孟池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"焦宗古","text":"南阳客自称龙卧，东鲁人应叹凤衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"焦宗古","text":"芳树高低啼蜀魄，朝云浓淡极巴天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"焦炳炎","text":"迹虽无地著，心实有天知。\n一禽从不获，不敢范驱驰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游黄山","author":"焦炳炎","text":"秀出云霄一丈探，诸峰高下护晴岚。\n丹成兔臼香生杵，影见龙津月在潭。\n洞暖有花因七七，云深无语住三三。\n粥鱼敲动山林兴，合傍浮丘去结庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游虎邱","author":"焦焕","text":"寻胜访幽刹，招朋泛远舟。\n清风杨柳岸，微雨芰荷秋。\n师去馀禅几，云閒动客愁。\n无缘陪玉麈，共醉碧山头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题黄山送别图","author":"焦焕炎","text":"我家黄山隅，不识黄山面。\n不自到黄山，见图如不见。\n如何黄山客，又别黄山去。\n落日晚烟昏，黄山在何处。\n黄山有汤泉，可以洗涤尘世缘。\n黄山有瑶草，可以饵之长不老。\n黄山有神丹，得之可以超尘寰。\n胡为别却黄山去，祇把生绡写空翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石人峰","author":"焦翠峰","text":"石为肌骨应成假，铁作肝肠未必真。\n当日容成丹就处，何当点化作仙人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汤泉","author":"焦静山","text":"渟渟灵水养灵珠，籁定波生注玉壶。\n洗尽尘劳多少客，不知还解洗心无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赋以鹤羽代银甲","author":"琴士","text":"峄阳孤桐鸣素丝，玉为轸兮金为徽。\n四珍合就已奇绝，犹嫌指声未清彻。\n负金翅管长且尖，剪成爪样鸾胶粘。\n轻弦入手剩超越，却笑弹筝后银甲。\n要知妙处岂在声，一抚一拍如渊明。\n劝君会此不须话，世不宜真只宜假。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"千金意","author":"琴精","text":"音音音。\n音音你负心。\n你真负心。\n孤负我到如今。\n记得年时，低低唱、浅浅斟。\n一曲值千金。\n如今寂寞古墙阴。\n秋风荒草白云深。\n断桥流水何处寻。\n凄凄切切，冷冷清清，教奴怎禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卜算子","author":"琴操","text":"欲整别离情，怯对尊中酒。\n野梵幽幽石上飘，搴落楼头柳。\n不系黄金绶。\n粉黛愁成垢。\n春风三月有时阑，遮不尽、梨花丑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳","author":"琴操","text":"山抹微云，天连衰草，画角声断斜阳。\n暂停征辔，聊共引离觞。\n多少蓬莱旧侣，频回首、烟霭茫茫。\n孤村里，寒鸦万点，流水绕低墙。\n魂伤。\n当此际，轻分罗带，暗解香囊。\n谩赢得青楼，薄幸名狂。\n此去何时见也，襟袖上、空有余香。\n伤心处，长城望断，灯火已昏黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]