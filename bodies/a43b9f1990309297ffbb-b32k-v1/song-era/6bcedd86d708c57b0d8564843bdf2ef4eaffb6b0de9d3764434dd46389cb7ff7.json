[{"title":"句","author":"祝廉夫","text":"会当归去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山矾花","author":"祝穆","text":"玲珑叶底雪花寒，清昼香薰草木间。\n移植小轩供宴坐，恍疑身在普陀山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"豫章","author":"祝穆","text":"豫章偃蹇两苍龙，雪干宁须匠石逢。\n借重岁寒双大字，绝胜松拜大夫封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沁园春 寿宋通判","author":"祝穆","text":"自有东阳，锦水城山，几千百年。\n记往时仅说，拥麾刻郡，而今创见，持橐甘泉。\n地脉方兴，天荒欲破，还为盐梅生钜贤。\n清和候，正风薰日永，作地行仙。\n题舆小驻樵川。\n常只恐祖生先著鞭。\n算谁从井落，重新疆理，谁从襄岘，一洗腥膻。\n幕府归来，未应袖手，行有诏书来九天。\n勋名就，使吾乡夸诧，盛事流传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺新郎","author":"祝穆","text":"此木生林野。\n自唐家、丝纶置阁，托根其下。\n长伴词臣挥帝制，因号紫微堪诧。\n常缥缈、紫微仙驾。\n料想紫微垣降种。\n紫微郎、况是名同者。\n兼二美，作佳话。\n一株乃肯临茅舍。\n肌肤薄、长身挺立，扶疏潇洒。\n定怯麻姑爬痒爪，只许素商陶冶。\n擎绛雪、柔枝低亚。\n我忆香山东坡老，只小诗、便为增声价。\n后当有，继风雅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"祝穆","text":"黄花自与渊明别，不见闲人直到今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读中兴碑","author":"秋隐里叟","text":"辞本春秋作，聱翁策固长。\n漫嗟褒贬迹，孰继老汾阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏桃","author":"种放","text":"习习香薰薄薄烟，杏迟梅早不同妍。\n山斋尽日无鸾□，只与幽人伴醉眠。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题","author":"种放","text":"楼台缥缈路岐傍，共说祈真白玉堂。\n株树风高低绛节，灵台香冷醮虚皇。\n名传六合何昭晰，事隔三清限渺茫。\n欲识当年汉家意，竹宫梧殿更凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄二华隐者","author":"种放","text":"我本厌虚名，致身天子庭。\n不终高尚事，有愧少微星。\n北阙空追悔，西山羡独醒。\n秋风旧期约，何日去冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬陈齐民见寄","author":"种放","text":"竹扉常昼掩，幽僻置身安。\n自委渔樵分，因思出处难。\n周庭方设燎，汉将尚封坛。\n莫问渔樵意，人寰事万端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"潇湘感事","author":"种放","text":"离离江草与江花，往事洲边叹复嗟。\n汉傅有才终去国，楚臣无罪亦沈沙。\n凄凉野浦寒飞雁，牢落汀祠晚聚鸦。\n无限清忠沉浪底，滔滔千顷属渔家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日山居","author":"种放","text":"阴阴林木静，寂寂无人境。\n红绽紫葳香，岚沈玉膏冷。\n看云时独坐，慎事常中省。\n何客驭风来，新篁动疏影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄怀","author":"种放","text":"予生背时性孤僻，自信已道轻浮名。\n中途失计被簪绂，目睹荣辱心潜惊。\n虽从鹓鸾共班序，常恐青蝇微有声。\n清风满壑石田在，终谢吾君甘退耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谕蒙","author":"种放","text":"大盈卑百渎，自成浮天浔。\n崇丘下累块，竟为蔽日深。\n王者在谦小，夙惟尧禹心。\n拜言尊贤仁，慎德弃珠金。\n自满九族散，匪骄百善寻。\n炳兹夏商鉴，灭国因夸淫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酴醾","author":"种放","text":"生成从火令，颜色占中央。\n绿叶排圜翠，青苞蓄异香。\n丛阴周曲干，纤刺比锋芒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"种放","text":"绿萼红葩晚态新，风流如阵战愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"种放","text":"胡雏负恩信，圣主耻干戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"种放","text":"东君若要分流品。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠李用之","author":"种道人","text":"道成元未是，再至却须成。\n但看西行日，归来一饷荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题赵千里夜潮图卷","author":"笃世南","text":"风涛汹涌千堆雪，拍岸翻空倒银阙。\n雁声惊起一江秋，万里无云挂明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬至寓建阳作","author":"胡一桂","text":"绣日添汉宫，书云纪晋观。\n山家独奚为，刚肠占易彖。\n幽人意欣然，起坐视晴汉。\n大化回初阳，漫漫今已旦。\n川泳有游鱼，云飞见翔雁。\n滞留本何心，永怀发孤叹。\n诚哉利攸往，观辞思过半。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至日建中次季真韵","author":"胡一桂","text":"尽日劳劳烟雨里，此行谁识是欤非。\n翩然芒屩相随处，正见梅花欲放时。\n太极便堪窥易蕴，黄钟初可验葭飞。\n天心子半无移改，细玩尧夫至日诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日","author":"胡之纯","text":"春风蒲柳曲江头，恨与春波不尽流。\n莺唤新声啼绿树，燕寻旧垒认朱楼。\n百年骄豢吴儿脆，一味清谈晋士休。\n千古兴亡惟有泪，漫山花雨杜鹃愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其四","author":"胡于","text":"袅袅薰风响佩环。\n广寒仙子跨清鸾。\n谁教瑞世仪周间，自赋多才继小山。\n铃阁静，画堂闲。\n衮衣象服镇团栾。\n年年此日称觞处，留待菖蒲驻玉颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其五","author":"张孝祥","text":"去日清霜菊满丛。\n归来高柳絮缠空。\n长驱万里山收瘴，径度层波海不风。\n阴德遍，岭西东。\n天教慈母寿无穷。\n遥知今夕称觞处，衣彩还将衣绣同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 其三","author":"胡于","text":"楚楚吾家千里驹。\n老人心事正开渠。\n风流不减庭前玉，爱惜真如掌上珠。\n纡绿绶，荐方壶。\n老人沉醉弟兄扶。\n问将何物为儿寿，付与家传万卷书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题榕阴图","author":"胡大用","text":"权臣擅命久心伤，贼主之兄意未凉。\n今日封章期救死，明朝削籍自投荒。\n九重偶眩诬贤舌，四海皆知疾恶肠。\n事久划逢天一笑，锡知刚简易名香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游龙光寺","author":"胡大成","text":"香宇依空结，虚轩傍水开。\n沙明鸿影度，径静竹风来。\n午磬传清梵，晴花点绿苔。\n寥寥人境外，宴坐送馀杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访开公不遇","author":"胡子期","text":"独步小庵清，凭轩数小星。\n霜华连野白，山色满门青。\n风定松犹响，香销室自馨。\n孤云何处宿，案上掩莲经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游乳洞庵","author":"胡子澄","text":"结屋青山下，幽深不计年。\n泉声秋霁雨，钟响暮晴天。\n入洞寻僧伴，穿云见鹿眠。\n徘徊不忍去，夜宿佛堂前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乳洞","author":"胡子澄","text":"古洞幽深处，萦回路几重。\n门开空寂寂，泉溜暗淙淙。\n断壑云连屋，奔流水激舂。\n桥横千丈石，岩挂万年松。\n鹤驾应重到，龟田必再逢。\n碧沙还错落，密筱自迷濛。\n乳结银为树，浆凝雪作峰。\n仙人何处去，应想子乔踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"胡山甫","text":"病起百花开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纵鱼","author":"胡从义","text":"放汝入长江，养教鳞角出。\n风云际会时，莫道不相识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴下同年会诗","author":"胡元功","text":"佳辰胜集不相违，慨念同年会遇稀。\n独有二天均覆荫，归来三径幸栖依。\n诗篇酒盏论时事，山色湖光映夕晖。\n自愧衰迟与荣观，拟将委翅附高飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仙都山","author":"胡升","text":"鼎湖不可见，巍然但孤峰。\n特立亘万古，气压诸山雄。\n黄帝久得仙，游行跨飞龙。\n至今世俗传，尚指辇路通。\n颇如升天桧，追求白鹿踪。\n常言贵荒唐，厥见真儿童。\n顾惟此山奇，实宜仙所宫。\n水声来冷风，和以万本松。\n客枕久未稳，笙箫满虚空。\n颇疑九成音，不在二典中。\n但恐蚩尤旗，晔晔舒长虹。\n虽能独不死，忍视斯民穷。\n君看涿鹿战，万古蒙其功。\n鼎湖何足道，帝德弥苍穹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采桑子","author":"胡夫人","text":"与君别后愁无限，永远团圞，间阻多方。\n水远山遥寸断肠。\n终朝等候郎音耗，挨过春光。\n烟水茫茫。\n梅子青青又待黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽故知容州朝请陶公","author":"胡文举","text":"孤松挺挺凛高风，万语形容不尽中。\n独指平塘塘上水，水之清处俨如公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归 其一","author":"胡文卿","text":"良辰佳景列华筵。\n笙歌奏管弦。\n位居荣显子孙贤。\n功名事双全。\n庆祝寿，拜尊前。\n重重福禄坚。\n愿如彭祖寿齐年。\n金杯劝寿仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"阮郎归 其二","author":"胡文卿","text":"谢娘诗礼有家风。\n吹窗清昼同。\n笑言偕老与梁鸿。\n闺门喜气融。\n来月殿，下珠宫。\n人间春意浓。\n一尊仙酝祝芳丛。\n蟠桃千岁红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其五","author":"胡文卿","text":"昨霄南极星光现。\n今日开华宴。\n朱颜翠鬓占春多。\n且向博山香袅、卷金荷。\n龟游鹤舞千年寿。\n更酌千钟酒。\n满庭佳客捧殷勤。\n此日蒲菊新绿、瓮头春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其三","author":"胡文卿","text":"寿香烟篆金炉细。\n寿酒邀宾至。\n寿筵两畔列红妆。\n寿曲仙音一品、舞霓裳。\n寿星高挂生祥瑞。\n寿祝长生意。\n寿杯满劝庆遐龄。\n寿比南山松柏、永长春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其四","author":"胡文卿","text":"香云佳气交盘结。\n又庆生申节，满堂簪绂奉霞觞。\n瑞应台躔南极、见光芒。\n心田积累阴功足。\n来受人天福。\n从今几度见河清。\n笑傲壶中日月、镇长春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其二","author":"胡文卿","text":"香烟绕遍兰堂宴。\n香鸭珠帘卷。\n香风转后送韶音。\n香酝佳筵今日、庆佳辰。\n香山烧尽禽飞放。\n香袖佳人唱。\n香醪满满十分斟。\n香信传时延寿、保千春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人 其一","author":"胡文卿","text":"枢庭喜庆生辰到。\n仙伯离蓬岛。\n鲁台云物正呈祥。\n绣线工夫从此、日添长。\n满斟绿醑深深劝。\n岁岁长相见。\n蟠桃结子几番红。\n笑赏清歌声调、叶黄钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"胡文媛","text":"却有一端宜恨处，开花相背有何功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷 其十","author":"胡斗南","text":"螺子江头酒一壶，玚花香处赋归欤。\n西湖他日笙歌里，还忆山中人姓胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷 其九","author":"胡斗南","text":"十里莺花处处娇，南新桥过北新桥。\n船来船去东风里，何处佳人弄玉萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷 其八","author":"胡斗南","text":"诗家冷淡作生涯，有客相过旋煮茶。\n斫去梅花除去柳，绕堤只合种桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷 其七","author":"胡斗南","text":"当年出塞几红娃，曾共毡房看雪花。\n今日湖亭霜月夜，梦中犹听撚琵琶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷 其六","author":"胡斗南","text":"越舞吴讴别几春，御船坊下即迷津。\n年来依旧多游赏，半是南人半北人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷 其五","author":"胡斗南","text":"箧里新诗意不传，飘蓬白发地行仙。\n江南江北都看了，更住西湖一百年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷 其四","author":"胡斗南","text":"魁笑先生尚可痴，湖山日日有新诗。\n水光云影窗三尺，雨抹晴装画四时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷 其三","author":"胡斗南","text":"老来无意谒侯门，自爱梅花水月村。\n更拟孤山结茅屋，杖藜聊复信乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷 其二","author":"胡斗南","text":"翠柳摇摇迓客来，红梅的的为公开。\n管宁昔作辽东去，苏武新从塞北回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题汪水云诗卷 其一","author":"胡斗南","text":"一琴一鹤一扁舟，南北东西更九州。\n一曲湖山真得计，半生交结尽清流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张治中朝京","author":"胡斗南","text":"乾坤人物老，牛斗景星明。\n鸿翼天风顺，马蹄沙路平。\n松楸还有托，草木亦知名。\n归日吟千首，江山万里程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽文山 其二","author":"胡斗南","text":"金骨神仙玉色人，千霜万雪见吾真。\n圣贤尽节心弥寿，天地为棺道不贫。\n河汉横流豪杰泪，风霆怒发鬼神嗔。\n先生出入骑箕尾，长现纲常四大身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽文山 其一","author":"胡斗南","text":"裂指秋风感别离，乾坤人物太瑰琦。\n生为孝子忠臣劝，死结皇天后土知。\n万折江流鱼腹石，千年人立首阳碑。\n一门史氏春秋笔，愁绝湖光入画时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"容州闻雁","author":"胡长卿","text":"旧闻雁不到衡阳，今复南飞入瘴乡。\n天阔随阳皆可去，未应为界限潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和经略焕章朱公千叶白梅诗","author":"胡长卿","text":"天怜素质太柔轻，不奈西风雪片凝。\n故与红颜如美玉，尚馀清影似寒冰。\n黄香仅可追多叶，重萼堪怜只两层。\n欲问园官分此贴，宜楼深远叹难应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禁烟日陪经略焕章丈游白龙洞得所赋新诗次韵以呈","author":"胡长卿","text":"悬崖怪石水潺潺，宜有神龙隐此间。\n穷胜不妨穿险洞，寻春那止看群山。\n攀龙行即天边去，跃马聊同野外还。\n好景良辰适相会，一尊且共水云闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"胡长卿","text":"闻道嘉鱼出火山，我来那得一鳞看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酹江月/念奴娇 秋夕兴元使院作，用东坡赤壁韵","author":"胡世将","text":"神州沈陆，问谁是、一范一韩人物。\n北望长安应不见，抛却关西半壁。\n塞马晨嘶，胡笳夕引，赢得头如雪。\n三秦往事，只数汉家三杰。\n试看百二山河，奈君门万里，六师不发。\n阃外何人回首处，铁骑千群都灭。\n拜将台敧，怀贤阁杳，空指冲冠发。\n阑干拍遍，独对中天明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和人七夕诗","author":"胡仔","text":"乞巧筵开玉露秋，一钩凉月挂西楼。\n人间百巧方无奈，寄语天孙好罢休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和人咏蜡梅绝句因纪其事","author":"胡仔","text":"新诗湔拂自苏黄，想见当年喜色香。\n草木无情遇真赏，岂知千载有馀芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏黄白菊花","author":"胡仔","text":"何处金钱与玉钱，化为蝴蝶夜翩翩。\n青丝网住芳丛上，开作秋花取意妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春寒","author":"胡仔","text":"小院春寒闭寂寥，杏花枝上雨潇潇。\n午窗归梦无人唤，银叶龙涎香渐销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题苕溪渔隐图 其一","author":"胡仔","text":"溪边短短长长柳，波上来来去去船。\n鸥鸟近人浑不畏，一双飞下镜中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题苕溪渔隐图 其三","author":"胡仔","text":"卷起纶竿撇棹归，短篷斜掩宿渔矶。\n日高春睡无人唤，撩乱杨花绕梦飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]