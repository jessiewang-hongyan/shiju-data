[{"title":"莆阳徐太守数赐临顾","author":"强至","text":"军垒初分太守麾，马头南去有光辉。\n吏人郊外迎飞盖，父老溪边指绣衣。\n到日岭梅含细蕊，昔时乡树长新围。\n世间得意多遗旧，谁肯柴荆数款扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读尹师鲁集","author":"强至","text":"章句横行古道堙，先生笔力障颓津。\n高文简得春秋法，大体严如剑佩臣。\n冰铁刚颜低狱吏，云风壮略疏边人。\n谪官竟死空名在，一读遗编泪满巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贾麟自睦来杭复将如苏戏赠短句","author":"强至","text":"春风那解系狂游，朝醉桐江暮柳洲。\n大手千篇随电扫，孤踪四海学云浮。\n荣名不落闲宵梦，退筑聊为晚岁谋。\n老橘残鲈犹有兴，片心还起洞庭舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"资国山口石桥","author":"强至","text":"前日枯槎接断溪，今朝白石跨完堤。\n牧儿静立牛磨角，诗客闲惊马驻蹄。\n涧雨涨来流浅濑，山风扫过断纤泥。\n十家岂乏相如辈，当有人从柱上题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"途中寄纯甫","author":"强至","text":"诸友分携地，重阳欲近天。\n共谁搴菊蕊，独立忆梅仙。\n对饮乖今日，伤离似去年。\n佳山足吟赏，应自有新篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"通判国博惠建茶且有对啜之戏因以奉谢","author":"强至","text":"数饼建溪春，求逾尺璧珍。\n封从乡国远，惠与郡僚均。\n午榻忘支臂，晨觞厌启唇。\n拜嘉当对啜，相待况如宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陪群牧使进呈拣中御马","author":"强至","text":"薰风微转殿南棱，玉色天颜粹自凝。\n数马从容陪昼接，飞龙迤逦备时乘。\n久图骏足求初得，一顾奇毛价遂增。\n窃笑漫逾梅福愿，半生玉陛辄三登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书呈公胜","author":"强至","text":"朔吹朝还暮，繁云凝复开。\n不能成雪意，只解作寒媒。\n薄宦家千里，长吟酒一杯。\n西邻郑夫子，乘兴几时来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿山寺","author":"强至","text":"苍莽穷山路，萧森古寺门。\n梦深宵殿月，泪迸晓枝猿。\n人事随群动，山情阻细论。\n城中尘没眼，愁思满归轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿慧安院","author":"强至","text":"积淖厌行路，解鞍欣曲肱。\n疾风穿敝屋，细雨湿青灯。\n聒夜有饥鼠，观空无定僧。\n中宵尘累息，山水思填膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄公立","author":"强至","text":"一朝挥别袂，九日在征岐。\n识我相思意，如君独坐时。\n榴花须满盏，菊蕊况盈枝。\n目下重阳泪，宜看杜牧诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄刘道秘书","author":"强至","text":"夫子文章老更工，六经俱达一身穷。\n为逃州县时情薄，不问田园岁计空。\n别酒正思倾夜雪，书邮忽喜寄春风。\n遥知父子传家乐，却笑当年论异同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄齐州曾子固学士","author":"强至","text":"历山名重舜耕馀，太守文章世罕如。\n但见清风变齐鲁，未闻紫诏起严徐。\n最宜视草归时训，可惜挥毫落簿书。\n千骑行春且乘兴，里无胜母莫回车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄陈介进士","author":"强至","text":"圣门颜子最称贫，犹有箪瓢奉一身。\n罕似饥肠游太学，独将生意托洪钧。\n常时闵笑遭流俗，今日依归得主人。\n早夜从容咨道谊，切防事业去青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄保安军杨公济判官","author":"强至","text":"高吟绝塞十年前，醉笔才停万纸传。\n麟阁主人降健句，鸡林官长购精篇。\n旧游散落今谁在，新感纵横日自怜。\n肝胆不同躯干小，几时献画请开边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄俞君度","author":"强至","text":"夫子惫已甚，平生心向存。\n黄金空旧产，白首寄他门。\n独酌醉应浅，愁吟声更吞。\n飘零那复久，知己有平原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄秦倅吕四丈职方渊","author":"强至","text":"丈人宦意静如山，五十朱衣鬓未斑。\n富庶讴歌归别驾，太平谈笑服诸蛮。\n熊罴一兆高门后，鸿雁连飞绝塞间。\n莫学冯唐终蹭蹬，功名犹好出秦关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄盛子美俞元功二先辈","author":"强至","text":"彼美吴州杰，相从萧寺居。\n聊穷三尺律，肯恃五车书。\n前有殊尤等，行当选擢初。\n秋风吹客袂，乡思复何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄湖掾杨浩然","author":"强至","text":"新持手版苕溪掾，应恨浮名别故乡。\n泽国几瞻飞雁序，春风自入坠鳣堂。\n坐曹未改平生好，开卷能如往日忙。\n龙首主人监郡乐，定蒙宾礼考文章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题双岩寺","author":"强至","text":"古寺南偏两翠微，锦溪碣石岂全非。\n云烟来去长相接，猿鸟东西各有归。\n泉溜夜淙寒入座，岚光朝滴润生衣。\n而今野旷无人筑，唯见林僧对掩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题甘露寺文岳上人环翠阁","author":"强至","text":"铁瓮城边古道场，近来人说赞公房。\n江盘北固山形转，云抱南朝树色苍。\n世外青鸳谁结构，坐间紫鸽自回翔。\n十年滞客空吟想，未识诸天在上方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题张殿直长春亭","author":"强至","text":"甲第俯河湄，修亭面势宜。\n琴樽长有乐，草木似无衰。\n境胜青山敌，心閒白日迟。\n祖良迷大隐，独与赤松期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题殊公禅老黄云阁二首 其二","author":"强至","text":"人悦禅翁巧结庐，更营飞阁取幽虚。\n溪山雨后翠欲活，棂槛风来清有馀。\n龙象几年成佛界，猿猱深夜杂僧居。\n还如梦得闻涵碧，谁写丹青复寄予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题殊公禅老黄云阁二首 其一","author":"强至","text":"大士当年密行成，山居黄色有云生。\n黄云已共斯人去，飞阁犹为此地名。\n欲到尘埃先摆落，纵观气象亦峥嵘。\n谁云瑞应难追复，禅老而今祖意明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题郭明府寺丞颍上西斋","author":"强至","text":"退筑谋何早，闲居兴颇浓。\n渠流通颍派，窗列隔淮峰。\n玉麈谈宾盛，牙签载籍重。\n雨巾时垫角，一代慕林宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"常尉携酒馔就部役所见劳","author":"强至","text":"酒蚁清香绿盏飞，河鲂雪缕玉盘肥。\n三春花草殊南北，一笑乾坤外是非。\n膏血生民劳版筑，筋骸薄宦走都畿。\n陶潜此日方萧瑟，那啻篱边遇白衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得叔毅书","author":"强至","text":"故人消息苦难真，终日吴天望楚云。\n黄鹄不知何处举，新莺应似此中闻。\n旧来饮量还能几，别后诗才转不群。\n忽遣长髯驰短札，数行千里赠殷勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"悼承天月禅老","author":"强至","text":"祖意生来达，诗心老去专。\n传灯与谁子，绝笔在何篇。\n朝客散谈席，野禽窥法筵。\n唯应轩北石，秋后自依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"排岸判官以荷花为贶书五十六字以谢","author":"强至","text":"江国芙蕖夏最繁，临堤每见尚盘桓。\n清淮况是稀疏有，江萼争教取次看。\n晓艳不随生意绝，孤根宁减旧时安。\n主人知我江乡客，弗忍池边独自观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"断碑","author":"强至","text":"何代经兵火，终年委雪霜。\n文章谁黑白，首尾自参商。\n琬琰那沦翠，尘沙渐变黄。\n人生异坚石，抚汝重苍茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚莺献都官","author":"强至","text":"自恨飞迁出谷迟，东君不是故相遗。\n园林纵许容羁迹，蜂蝶还应笑后时。\n休恃绵蛮能巧啭，还须冷落守空枝。\n春风著力年年在，未必羽翰今便衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚晴","author":"强至","text":"云暗青天一鼓雷，旱蝗那得辄为灾。\n易盈畎浍流先溢，不尽关河色渐开。\n丰兆已从膏泽见，喜情还逐夕阳来。\n平明官属趋丞相，乐合公堂送贺杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚登至德上方偶书短篇呈山主云公","author":"强至","text":"城市隔半舍，好山宁在深。\n乱云归别坞，落日照疏林。\n能解外缘缚，始坚安住心。\n冠裳方我诱，漫作爱山吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅","author":"强至","text":"墙边几树玉参差，照眼幽花冷自宜。\n香阵晚交风破蕊，粉花朝湿雪融枝。\n故人消息从谁寄，造物生成似我迟。\n且慰蹉跎尽诗兴，江楼闲笛不须吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梨花","author":"强至","text":"旧爱乐天句，今逢带雨春。\n花中都让洁，月下倍生神。\n玩好张瑶席，攀仍赠玉人。\n莫开红紫眼，此外尽非真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涵碧阁东阳山水佳处予闻且久独未能往近得进士与邑官唱和诗读之景物依然如暂经目因次元韵附诸篇之末云","author":"强至","text":"山水相和碧色鲜，中间飞阁插云端。\n水声喷薄如孤泻，山势巉岩复对盘。\n吟恐昔人精魄笑，到疑盛夏骨毛寒。\n流觞已往双鱼在，怀古探奇两事干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渑池","author":"强至","text":"古邑人烟陕雒间，马蹄车辙许谁閒。\n不堪晓雨妨行兴，犹喜秋风慰客颜。\n老去稍知筋力倦，年来祇益鬓毛斑。\n相如屈赵无遗迹，独有空名重泰山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔者","author":"强至","text":"身世扁舟里，飘飖可奈何。\n万生劳白日，一笑属沧波。\n阔网施能几，闲机用未多。\n余颜自憔悴，莫作楚臣歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菊","author":"强至","text":"花浓新出黄金矿，枝软轻垂绿玉条。\n正色逢人何太晚，清香到酒亦终朝。\n篱边此意同萧瑟，霜后无言对寂寥。\n凡卉不为孤艳地，渊明真赏欲争邀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"萤","author":"强至","text":"幸藉炎蒸力，因迁腐草踪。\n清宵能自照，暗室肯相容。\n雨巷幽光晦，风帘乱点重。\n临书方汝赖，惟恐有鸣蛬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜晴","author":"强至","text":"雷威无节雨霖频，倍喜晴阳照火旻。\n野外刍荛寻故道，田间箫鼓赛闲神。\n乱苗竖似痿人起，积霭披如旧屋新。\n更待高楼今夜月，一樽且乐有涯身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒炉偶坐戏呈任道","author":"强至","text":"人事车轮转，年光木叶摧。\n交情论晚岁，生意共寒灰。\n未足胜宽褐，那能暖冻杯。\n知君寻气类，不为附炎来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食前二日对雨","author":"强至","text":"红湿花枝软，青涵柳色鲜。\n未开新禁火，自起欲晴烟。\n坐卧销佳节，招寻忆旧年。\n故乡游乐地，心折泛湖船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"属疾","author":"强至","text":"壮怀衰独早，乐事病全稀。\n静听闻花落，攲眠见燕归。\n冠裳成外累，尘土汩真机。\n强起亲曹事，遥惭旧隐扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彭及之邀吴仲源杨公济与某夜会望湖楼独某后期为关所隔偶成四篇以呈诸君 其三","author":"强至","text":"波射飞楼缥缈间，云梯岂合在尘寰。\n金樽倒尽星垂地，玉滴书乾月过山。\n槛底吴僧空仰望，座中蜀客赖西还。\n我遭鱼钥无情甚，只许吟魂夜度关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彭及之邀吴仲源杨公济与某夜会望湖楼独某后期为关所隔偶成四篇以呈诸君 其一","author":"强至","text":"月底云楼一水湄，天光湖色两琉璃。\n樽前更坐清风客，笔下争翻白雪词。\n物外骨毛应自爽，世间笑语不容追。\n千年庾亮胡床后，此兴今人亦未衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彭及之邀吴仲源杨公济与某夜会望湖楼独某后期为关所隔偶成四篇以呈诸君 其四","author":"强至","text":"故国英雄已寂寥，飞楼气象自飘飖。\n天边鸟翼愁檐额，雨后虹光转槛腰。\n直恐笑歌惊白日，却怜身世近青霄。\n云梯纵险容人上，始信明河亦有桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彭及之邀吴仲源杨公济与某夜会望湖楼独某后期为关所隔偶成四篇以呈诸君 其二","author":"强至","text":"诸公爱月欲狂颠，脚踏花栏手襞笺。\n那作常时挥綵笔，直须飞句上青天。\n岂无剧笑惊山叟，应有妍词调水仙。\n独我清宵尘滓甚，乱蚊声里汗肤眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"御河舟中","author":"强至","text":"浮舟不用力，一水静于山。\n沙鸟晴相唤，河云晚更闲。\n微吟穷有象，清思入无间。\n河策谁云补，从公漫往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惠山泉","author":"强至","text":"封寄晋陵船，东南第一泉。\n出瓶云液碎，落鼎月波圆。\n正味云谁别，繁声祇自怜。\n要须茶品对，合煮建溪先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景山无思二大师垂和鄙诗复依前韵奉答","author":"强至","text":"西北尘游倦，东南野兴深。\n帐空惭鹤怨，山暝忆猿吟。\n大士真交臂，连篇契夙心。\n会须携蜡屐，云峤陟千寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游华藏寺","author":"强至","text":"我今作邑水云乡，一到犹疑换俗肠。\n况在尘区正纷汩，乍来法界得清凉。\n松筠锁雾姿逾秀，楼阁摩霄势欲翔。\n更即高僧叩空理，功名富贵尽毫芒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游宝掌院","author":"强至","text":"当年秘宝已无形，独有层峰似旧青。\n不许俗人留辙迹，却应神物护岩扃。\n山腰猿啸孤烟暝，洞口龙归暴雨腥。\n今日一来探绝赏，始知全胜考图经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游河遇雨","author":"强至","text":"翠幄初防日影侵，春云送雨信无心。\n莫愁客散妨车马，且喜农安得砭针。\n侍妓点衣重结束，游人沾盖尚追寻。\n临归未尽杯中兴，却放船头醉里吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登陆氏书楼","author":"强至","text":"尘土长愁举眼低，转身今喜近晴霓。\n天边牛斗开吴墅，鸟外山川走越溪。\n拟解醉冠从此宿，恨无健笔为君题。\n牙签绕架藏书满，知与青云别作梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登梵天上方","author":"强至","text":"廊腰偃月势环遭，秋宇澄明照一毫。\n楼槛转身侵白日，海山随眼没惊涛。\n泉枯碧甃鳗形遁，屋跨苍崖鸟翼劳。\n屈指旧游今二纪，新愁烂熳入风骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登塔","author":"强至","text":"身世如追汗漫游，丹梯一步拟三休。\n汉唐前后漫陈迹，城郭是非劳寸眸。\n寒日微明飞鸟背，孤烟渐起暮山头。\n姓名满壁今空在，登此几人忘百忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"程舅夜见过","author":"强至","text":"风雨衡门此夜开，羊昙喜报谢安来。\n病眸强对题诗烛，感泪频添话旧杯。\n江上索居空岁月，渭阳故事未尘埃。\n不眠且听寒更坐，日夕相过复几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答章传道二首 其二","author":"强至","text":"夫子词源涌大江，相逢早觉片心降。\n日哦李白诗千首，夜获虞卿璧一双。\n屡发彩笺移曲几，不知红烛短幽窗。\n吟高莫信须穷滞，亦有从来拥节幢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答章传道二首 其一","author":"强至","text":"旋刻辞章就礼闱，禁园花在遂空归。\n客愁春雪杯间释，诗句青云纸上飞。\n从祖近持丞相印，旧交半著侍臣衣。\n扬雄未老犹堪荐，忍听沧洲买钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"紫微舍人宋公爱子侄三人同日得第作诗以纪盛美二首 其二","author":"强至","text":"君王赐第御灵和，兄弟同时捷隽科。\n名占风雷三级遍，恩沾雨露一门多。\n衣冠盛事喧金榜，里巷荣归缀玉珂。\n他日凤池须接翼，侍中阴德有馀波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"紫微舍人宋公爱子侄三人同日得第作诗以纪盛美二首 其一","author":"强至","text":"君王亲策集英年，始信常山子侄贤。\n白昼相将金榜上，紫微三谢玉阶前。\n衣冠近事尤为盛，阀阅清芬愈可传。\n马跃春风归里巷，芦花争看一行鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"腊月二十三日群牧使元内翰曾龙图同日拜枢参之命是日立春","author":"强至","text":"洗马池边喜气俱，二公同日上云衢。\n北门学士参台鼎，内阁才臣贰斗枢。\n晓殿春风迎拜舞，晚街霁日照传呼。\n回头应笑蹉跎客，养拙长甘伴圉夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落花","author":"强至","text":"林间花自飞，物理不应悲。\n偶对飘残地，休论艳发时。\n有情香水面，无数点河湄。\n蜂蝶含馀意，徘徊绕旧枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"董役河上风霾继日","author":"强至","text":"春迟地冷日萧骚，野旷林疏风怒号。\n畚锸一声趋蚁垤，旗幡四面落鸿毛。\n黄埃成穗坐还积，绿鬓欲丝歌漫劳。\n暂闭柴荆如避寇，江湖归思入渔舠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":76172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]