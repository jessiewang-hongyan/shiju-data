[{"title":"观静江山水呈陈鲁叟漕使 其一","author":"戴复古","text":"桂林佳绝处，人道胜匡庐。\n山好石骨露，洞多岩腹虚。\n峥嵘势相敌，温厚气无馀。\n可惜登临地，春风草木疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"许介之约过清溪道上有成","author":"戴复古","text":"行尽白云际，乘槎过水西。\n稻田秋后雀，茅舍午时鸡。\n野饭自不恶，村醪亦可携。\n闻钟欲投宿，何处是招提。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"许提干湖上下筑","author":"戴复古","text":"才气有如许，功名不可无。\n乐从闲岁月，养就大规模。\n雅志难谐俗，幽居喜并湖。\n君看莲下藕，不与叶同枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访方子万使君宅有园林之胜","author":"戴复古","text":"使君居处好，在郭却如村。\n屋带园林胜，门无市井喧。\n蛰龙将变化，雏凤亦腾鶱。\n客里苦无暇，相从听雅言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访古田刘无竞","author":"戴复古","text":"前说建阳宰，古田今似之。\n难兄与难弟，能政更能诗。\n文字定交久，江湖识面迟。\n人传花萼集，俱受水心知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访西涧王深道 其二","author":"戴复古","text":"诸老伤凋谢，凄凉属此时。\n相从一夜语，忍读四哀诗。\n世事生愁绪，秋风吹鬓丝。\n黄花香晚节，说与秀岩知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访西涧王深道 其一","author":"戴复古","text":"诸王居处僻，古屋满山坡。\n传到宋淳祐，来从晋永和。\n诗书历年久，名胜结交多。\n一涧流芳润，滔滔秋水波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访严坦叔","author":"戴复古","text":"麻姑山下泊，城郭带烟霞。\n携刺投诗社，移船傍酒家。\n沙禽时弄水，榉柳夏飞花。\n小酌未能了，西楼日又斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访张元德","author":"戴复古","text":"今宵何幸宿书林，议论从横感慨深。\n黄卷具传千古意，青灯照破几人心。\n狂夫嗜饮夜偷酒，污吏容私昼攫金。\n尧舜君民旧风俗，凡经几变到于今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访杨伯子监丞自白沙问路而去 其一","author":"戴复古","text":"欲访扬雄宅，扁舟过白沙。\n自从山以后，直到水之涯。\n风节古人物，文章老作家。\n相寻有忙事，第一问梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访杨伯子监丞自白沙问路而去 其二","author":"戴复古","text":"朝市风波地，乾坤渔猎场。\n生民日憔悴，吾道亦凄凉。\n龙不为霖出，凤于何处藏。\n群鸦争晚噪，一意送斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访苍山曾子实","author":"戴复古","text":"故人子曾子，居处近金精。\n福地佳山水，诗家老弟兄。\n十年重会面，一笑最关情。\n万象亭前月，今宵为我明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访陈与机县尉于湘潭下摄市 其二","author":"戴复古","text":"买得南坡景，创成西尉司。\n宅幽连寺观，地广带亭池。\n能事事易了，役民民不知。\n题诗记颠末，政不假人碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访陈与机县尉于湘潭下摄市 其三","author":"戴复古","text":"吾里不识面，他乡喜见君。\n数朝相款曲，杯酒接慇勤。\n清挹湘江水，笑开衡岳云。\n归心逐回雁，转首叹离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访陈复斋寺丞于私第","author":"戴复古","text":"以时为出处，真有古人风。\n奉母易为孝，事君难尽忠。\n閒居非傲世，直气尚摩空。\n语及朝廷事，乾坤万感中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访赵东野","author":"戴复古","text":"朅来问讯病维摩，花满溪堂竹满坡。\n发秃齿危俱老矣，人高诗苦柰穷何。\n四山便是清凉国，一室可为安乐窝。\n犹有忧时两行泪，临风挥洒湿藤萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访徐益夫","author":"戴复古","text":"仲蔚蓬蒿宅，终朝只闭关。\n无心与时竞，未老得身闲。\n绿绕巡除水，青横隔岸山。\n客来新酒熟，相对一酡颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访曾云巢","author":"戴复古","text":"一老今无恙，诸公昔与俦。\n随时难苟合，怀道早归休。\n苦似陶元亮，全如秦少游。\n笔端锋锐别，有待续春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访曾鲁叔有少嫌先从金仙假榻长老作笋供","author":"戴复古","text":"俗物败佳兴，余非后汝期。\n既来迟一见，政恐错相疑。\n同访金仙老，因参玉板师。\n樽前有馀暇，细读放翁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访漳州赵用父使君","author":"戴复古","text":"幸遇故人为太守，客来不惮路程遥。\n九龙山水连沧海，五马声名动紫霄。\n一意奉行宽大诏，多君不负圣明朝。\n欲知惠爱及人处，听取街头卖炭谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访慧林寺僧因有诗","author":"戴复古","text":"故人有约访乡僧，少坐西林待晚晴。\n双燕护雏更出入，群鸦攫肉斗飞鸣。\n长溪积水流无尽，古木号风诉不平。\n一段见成公案在，请君判断要分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过三衢寻乡僧适遇爱山徐叔高同访郑监丞其家梅园甚佳选百家诗","author":"戴复古","text":"暂作三衢客，寻僧出郭迟。\n适逢徐孺子，同访郑当时。\n诗集百家富，梅花几树奇。\n匆匆又行役，不见烂柯棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过昭武访李友山诗社诸人","author":"戴复古","text":"吟过长亭复短亭，喜于溪上访诗朋。\n雕锼已被天公怒，狂狷仍遭俗子憎。\n故故愁人长夜雨，明明照我短檠灯。\n休思京口相逢日，喜雨楼中赋大鹏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"两山赵仁甫宰临安有武学生张丈相访酒边弄刀舞剑甚可观因成七言县乃钱王故宫九龙十锦皆其地","author":"戴复古","text":"风流晋宋时人物，花县鸣琴调甚新。\n不厌开樽留剑客，仍能下榻待诗人。\n九龙池馆空陈迹，十锦山川自好春。\n但见清吟度白日，不知佳政最宜民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"何季皋司理故人也作诗见相勉意二首 其二","author":"戴复古","text":"南州通外国，浊海溷清波。\n人以廉称少，官从辟奏多。\n持身宜洁白，事上莫依阿。\n话别无他语，留心政事科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"何季皋司理故人也作诗见相勉意二首 其一","author":"戴复古","text":"梅花庾岭外，别是一山川。\n那使民无讼，须知狱有冤。\n心常存正直，法不尚平反。\n于氏缘何事，阴功到子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余惠叔访旧","author":"戴复古","text":"扁舟访旧入横塘，新柳今如旧柳长。\n室迩人遥春寂寂，风流云散事茫茫。\n纵题红叶随流水，谁弄青梅出短墙。\n政是沈郎愁绝处，杜鹃不断叫斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别后舟中用前韵","author":"戴复古","text":"出郭风光便不同，转头犹恨去匆匆。\n维舟别岸鸦啼后，倚柂澄江雁影中。\n向老客怀惊岁月，乍寒天气转霜风。\n冰壶亭上人如玉，谩寄篇诗不暇工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别李司直萧小山","author":"戴复古","text":"老作五羊客，时从二妙游。\n文星照南斗，吾道欲东周。\n合作金闺彦，那为玉帐留。\n严徐闻有召，吾亦办归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别邵武诸故人","author":"戴复古","text":"白发乱纷纷，乡心逐海云。\n此行堪一哭，无复见诸君。\n老马寻归路，孤鸿恋旧群。\n酒阑何处笛，今夜不堪闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别钟子洪","author":"戴复古","text":"识得潮阳钟子洪，今人可想古人风。\n文章有气吞馀子，天地无情负此翁。\n问舍求田非细事，参禅学佛见新功。\n欲知别后真消息，莫惜频书寄海鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别章泉定庵二老人","author":"戴复古","text":"腊里春风转，埙篪一气和。\n劝翁新岁酒，唱我老人歌。\n一世声名重，四方书问多。\n章泉一泓水，思与海同波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别董叔宏兄弟","author":"戴复古","text":"年老思家切，交深话别难。\n扁舟行且止，尊酒强相宽。\n客路归来晚，人情去后看。\n西风吹过雁，千万寄平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"君玉同访岂潜饮间君度曼卿不约而至鹤方换翎羽出舞于桂花之下不可无语","author":"戴复古","text":"秋来常日雨，雨霁忽秋深。\n鹤换一身雪，花开满树金。\n三杯动情性，一笑付园林。\n莫怪先归去，衰翁薄疾侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴子似","author":"戴复古","text":"载酒樱桃熟，隈亭柳树阴。\n青山去人远，黄鸟话春深。\n薄俗非吾道，虚名愧此心。\n休言今不古，又恐不如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴子似提干九高亭小景","author":"戴复古","text":"前日作诗题大概，亭前小景亦堪题。\n绿杨树下茅三架，白水田头菜两畦。\n似酒新鹅初泛浦，如孩黄犊试牵犁。\n十分野趣关心事，到此令人忆剡溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭涧泉韩仲止二首 其二","author":"戴复古","text":"忍贫长傲世，风节似君稀。\n死后女方嫁，峡中儿未归。\n门人集诗藁，故卒服麻衣。\n涧上梅花发，吟魂何处飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭涧泉韩仲止二首 其一","author":"戴复古","text":"雅志不同俗，休官二十年。\n隐居溪上宅，清酌涧中泉。\n慷慨伤时事，凄凉绝笔篇。\n三篇遣稿在，当并史书传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吾乡陈万卿儒者能医见宜春赵守盛称其医药之妙著本草折衷可传","author":"戴复古","text":"本草有折衷，儒医功用深。\n何须九折臂，费尽一生心。\n药物辨真伪，方书通古今。\n有时能起虢，一剂直千金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吾族两派而下吾之一派衰落殆尽诸孙一两人而已其势不绝如线彼之一派富盛一日出门有感","author":"戴复古","text":"门外长河水，有时鸣不平。\n河边古樟树，亦各有枯荣。\n人事关时数，春风莫世情。\n贤哉沧海月，夜夜一般明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈姚显叔奉亲送死极孝","author":"戴复古","text":"雁去多年缺寄音，扁舟无复到山阴。\n卧牛岗上经过少，下马陵前感慨深。\n细读文公千字诔，足知孝子一生心。\n无才为作招魂些，自有悲风宰树吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈赵园令","author":"戴复古","text":"翠云屏嶂碧瑶池，万象前陈属指挥。\n彷佛神仙居处好，寻常宾客到来稀。\n荷花香里浑无暑，棋子声中却有机。\n别院笙歌促君去，野夫自步月明归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庐山 其一","author":"戴复古","text":"山灵未许到天池，又作西林一宿期。\n寺是晋时陶侃宅，记传隋代率更碑。\n山椒云气易为雨，客子情怀多费诗。\n暂借蒲团学禅寂，茶烟飞绕鬓边丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庐山 其二","author":"戴复古","text":"道人问我看庐山，地上争如阁上看。\n呈露千峰秋落木，雕锼万象客凭栏。\n静中见得天机妙，闲里回观世路难。\n管领风光有微憾，桂花香里酒瓶乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庐山 其三","author":"戴复古","text":"拥鼻行吟上下廊，今宵又宿赞公房。\n松摇半夜风声壮，桂染中秋月色香。\n白石清泉闻笑语，名山大泽出文章。\n老夫甘作无名者，不逐纷纷举子忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庐州帅李仲诗春风亭会客有尘字韵诗和者甚多韵拘无好语","author":"戴复古","text":"玉关人老鬓丝新，千里长城在一身。\n气使黄金结豪杰，手挥白羽静风尘。\n山河四望亭中景，桃李一开天下春。\n乡日满城骑战马，而今四野尽耕民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庐州界上寄丰帅","author":"戴复古","text":"身健心先老，时危事愈乖。\n无成携短剑，有恨满长淮。\n村酒时时醉，山肴日日斋。\n功名非我有，何处问生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庐陵城外","author":"戴复古","text":"郭外人烟好，行行过北阡。\n迎船分社肉，汲井种春田。\n绿树前村路，黄梅细雨天。\n客游乡土别，景物只同然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张子明索赋永斋诗诺之久矣杜撰四十字以还冷债","author":"戴复古","text":"为学日不足，毋劳课近功。\n声名垂不朽，文字用无穷。\n草色朝朝碧，桃花岁岁红。\n一机长运转，造物与人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张仁仲提干衡阳冰壶亭燕客","author":"戴复古","text":"大抵吾曹臭味同，留欢卜夜莫匆匆。\n一亭景物冰壶上，万里乾坤玉镜中。\n疏柳无心挂明月，败荷有恨倚西风。\n吟家旧日张公子，千首诗成句句工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张统制之子为父求诗蕲州城破匹马打围而出能知数谓时不可为","author":"戴复古","text":"夜半金城破，身随铁马飞。\n横挥三尺剑，突出万人围。\n勇锐资神力，功名与愿违。\n自能占气数，终老著农衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张端义应诏上书谪曲江正月一日赣州相遇 其二","author":"戴复古","text":"正朝送迁客，好去看梅花。\n此岭几人过，念君双鬓华。\n直言知为国，远地莫思家。\n韶石叫虞舜，伤哉古道赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张端义应诏上书谪曲江正月一日赣州相遇 其一","author":"戴复古","text":"忧世心何切，谋身计甚疏。\n樽前话不尽，天下事何如。\n汉武求言诏，贾生流涕书。\n龙颜那可犯，谪向曲江居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀江村何宏甫自赣上寄林檎","author":"戴复古","text":"人好物亦好，交深谊转深。\n他乡如对面，异体实同心。\n未得平安报，相思长短吟。\n无从回去马，有便寄来禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀何宏甫","author":"戴复古","text":"何郎好兄弟，爱我往来频。\n人作交游看，情如骨肉亲。\n茅庵思共隐，蕙帐暖生春。\n别后长相忆，寄书无便人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀赵德行","author":"戴复古","text":"所学源流远，澹交滋味长。\n看来浑易与，别去自难忘。\n独客梦千里，佳人天一方。\n细观宾退录，亦足慰凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀雪蓬姚希声使君 其二","author":"戴复古","text":"有感中来不自禁，短长亭下短长吟。\n梅花差可强人意，竹叶安能醉我心。\n世事无凭多改变，仕途相识半升沉。\n摩挲老眼从头看，只有青山无古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀雪蓬姚希声使君 其一","author":"戴复古","text":"寒入疏蓬夜雪深，是非难辩口如瘖。\n一官不幸有奇祸，万事但求无愧心。\n想像骑牛开画卷，丁宁回雁寄来音。\n传家一首冰壶赋，未信横舟竟陆沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"投江西曾宪二首 其二","author":"戴复古","text":"诸贤皆在位，治效尚迟迟。\n污吏未能去，明君若可欺。\n外台天耳目，正士国根基。\n既揽澄清辔，那无按察时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"投江西曾宪二首 其一","author":"戴复古","text":"枢星居紫极，遥映使星明。\n天下推名德，君家好弟兄。\n一台振纲纪，列郡想风声。\n不试褰帷手，官曹未易清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"抚州节推萧学易衙宇一新","author":"戴复古","text":"掇取高科如拾芥，爱君才调望君深。\n莫誇书判居莲幕，要把文章入禁林。\n华屋修成官满去，好诗改定客来吟。\n西窗共对萧萧竹，不负三杯话此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"抚州谢楼宗丞见访","author":"戴复古","text":"客里门庭可设罗，使君千骑肯相过。\n心忘贵贱交游重，论及兴衰感慨多。\n诸老逢时起岩壑，二边何日罢干戈。\n老夫何预人间事，归去沧江理钓蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟岘台杜子野主簿寓居","author":"戴复古","text":"高台延望眼，风物满前村。\n细读南丰记，频开北海樽。\n远山如看画，近市不闻喧。\n诗是君家事，长城在五言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李友山诸丈甚喜得朋留连日久月洲乃友山道号","author":"戴复古","text":"此身到处自悠悠，一笑非为越女留。\n风雨不妨鸡戒晓，江湖又见雁横秋。\n途中有客居岩谷，天下何人似月洲。\n颇欲相从溪上住，诸君许我卜邻否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李计使领客游白云景泰","author":"戴复古","text":"天近刚风吹面寒，绣衣玉立白云间。\n沧波万顷海南海，翠碧几重山外山。\n自觉登临无限意，谁思富贵不如闲。\n前峰若个神仙宅，指点烟霞见一斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]