[{"title":"孤山雪中写望","author":"林逋","text":"片山兼水绕，晴雪复漫漫。\n一径何人到，中林尽日看。\n远分樵载重，斜压苇丛乾。\n楼阁严城寺，疏钟动晚寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"招思齐上人","author":"林逋","text":"两枪未试泠泠水，五鬣长闲淅淅风。\n清会几时搔首后，病怀无复曲肱中。\n寒云片段浮重巘，白鸟横斜入远空。\n一帙逍遥不能解，牛头焚尽待支公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"易从上人山亭","author":"林逋","text":"湖水江湾隔数峰，篱门和竹夹西东。\n闲来此地行无厌，又共吾庐看不同。\n灵隐路归秋色里，招贤庵在鸟行中。\n屏风若欲相搀见，合把巉岩与画工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"盱眙山寺","author":"林逋","text":"下傍盱眙县，山崖露寺门。\n疏钟过淮口，一径入云根。\n竹老生虚籁，池清见古源。\n高僧拂经榻，茶话到黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗招南阳秀才","author":"林逋","text":"莫因公荐偶失意，便拟飘蓬作旅人。\n志壮任存题柱事，病多争向倚门亲。\n危堤柳色休伤别，上苑杏花长自春。\n况有西湖好山水，归来且濯锦衣尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊园避暑","author":"林逋","text":"柴门鲜人事，氛垢颇相忘。\n爱彼林间静，复兹池上凉。\n托心时散帙，迟客复携觞。\n况有陶篱趣，归禽语夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采石山","author":"林逋","text":"危阁闲登日渐曛，整屏晴雨枕江濆。\n秋棱瘦出无多寺，古翠浓连一半云。\n坐卧不抛输钓叟，往来长见属鸥群。\n翻然却怪宣城守，是甚移将李白坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城中书事","author":"林逋","text":"一门深掩得闲权，纯白遗风要独全。\n强接俗庸中反道，敢嫌贫病是欺天。\n围形古寺谙寻鹤，照藓秋廊拟疏玄。\n从此免惭岩下者，子真高兴未萧然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复赓前韵且以陋居幽胜诧而诱之","author":"林逋","text":"画共药材悬屋壁，琴兼茶具入船扉。\n秋花挹露如红粉，水鸟冲烟湿翠衣。\n石磴背穿林寺近，竹烟横点海山微。\n百千幽胜无人见，说向吾师是泄机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将归四明夜坐话别任君","author":"林逋","text":"酒酣相向坐，别泪湿吟衣。\n半夜月欲落，千山人忆归。\n乱尘终古在，长瀑倚云飞。\n明日重携手，前期易得违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句：诗二句","author":"苏轼","text":"叶随流水归何处，牛载寒鸦过别村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡石寺","author":"林逋","text":"长淮如练楚山青，禹凿招提甲画屏。\n数崦林萝攒野色，一崖楼阁贮天形。\n灯惊独鸟回晴坞，钟送遥帆落晚汀。\n不会剃头无事者，几人能老此禅扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春夕閒咏","author":"林逋","text":"屐齿遍庭深，时为拥鼻吟。\n微风引竹籁，斜月转花阴。\n静赏应难极，孤怀自不禁。\n苍然小池上，烟露达青岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日怀历阳后园游兼寄宣城天使","author":"林逋","text":"昔年行乐伴王孙，事尽清狂是后园。\n一榻竹风横懒架，半轩花月到顽盆。\n佳人暗引莺言语，芳草闲迷蝶梦魂。\n今日凄凉旧春色，可堪烟雨近黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日送袁成进士北归","author":"林逋","text":"春潮上海门，归雁远行分。\n千里倦行客，片帆还送君。\n酒波欺碧草，歌叠袅晴云。\n来岁东堂桂，聊酬一战勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日寄钱都使","author":"林逋","text":"桃花枝重肉红垂，萱草抽苗抹绿肥。\n正语暖莺风细细，著双寒燕雨稀稀。\n亭台物景兼飘絮，宅院时情渐夹衣。\n指背挟肩行乐事，不甘离索向芳菲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日感怀","author":"林逋","text":"衡宇日萧寂，高舂犹掩扉。\n春风似有旧，社燕亦重归。\n览照老已具，开樽人向稀。\n颓然此心曲，持底属芳菲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春阴","author":"王安国","text":"似雨非晴意思深，宿酲牵率卧春阴。\n若怜燕子寒相并，生怕梨花晚不禁。\n薄薄帘帷欺欲透，遥遥歌管压来沉。\n北园南陌狂无数，祇有芳菲会此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞霄宫","author":"林逋","text":"大涤山相向，华阳路暗通。\n风霜唐碣久，草木汉祠空。\n剑石苔花碧，丹池水气红。\n幽人天柱侧，茅屋洒松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日西湖閒泛","author":"林逋","text":"水气并山影，苍茫已作秋。\n林深喜见寺，岸静惜移舟。\n疏苇先寒折，残虹带夕收。\n吾庐在何处，归兴起渔讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀","author":"林逋","text":"霏霏烟雨拂西窗，缃帙披残卧缥缸。\n林木细分山去削，水波微动鹤丁桩。\n凉沈欲睡何妨纵，静壮诗魔未易降。\n搔首旧游堪入画，一樯如练下澄江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀","author":"林逋","text":"惠连初拟赋秋怀，病束慵缠几未谐。\n湿叶堕丹明晚堑，破云拖粉露晴崖。\n先甘衰落归双鬓，已觉清凉入百骸。\n试枕离骚校闲品，竹烟杉籁满萧斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"荣家鹤","author":"林逋","text":"种莎池馆久淹留，品格堪怜绝比俦。\n春静棋边窥野客，雨寒廊底梦沧洲。\n清形已入仙经说，冷格曾为古画偷。\n数啄稻粱无事外，报言鸡雀懒回头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追和彭城太尉夏月寄题湖上湛源大师房","author":"林逋","text":"碧蒲红蓼白莲房，一片栾栌撼水光。\n海岸空闻有孤绝，山中休道更清凉。\n惊飞翡翠当轩鸟，袅过旃檀别院香。\n最爱晚天吟枕上，好云遥耸数峰长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送马程员外之任乌江","author":"林逋","text":"空色青苍寒日明，迟迟携手出柴荆。\n长贫少得交游者，渐老不禁离索情。\n去路浦帆当晚落，到官江草已春生。\n州监县尹多才识，当念吾宗负大名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送马程知江州德安","author":"林逋","text":"酒酣无复耿离肠，一路之官尽水乡。\n公廨寒生对庐阜，客帆风定泊浔阳。\n波涵洲渚初收潦，露浥蒹葭未作霜。\n到日何人先刺谒，二林开士在琴堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送文光师游天台","author":"林逋","text":"天姥山深摇锡杖，野芳春翠共葳蕤。\n松门过水无重数，石壁看霞到尽时。\n闲避鸟啼应作观，忽闻人迹自留诗。\n秦中河朔尝游览，莫恨此方行脚迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王舍人罢两浙宪赴阙","author":"林逋","text":"上阁还旌节，明廷觐冕旒。\n清溪倾绮席，蠹简压归舟。\n远俗今无讼，闲田亦有秋。\n公期论爵赏，当拜富民侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送长吉上人","author":"林逋","text":"囊集暮云篇，行行肯废禅。\n青山买未暇，朱阙去随缘。\n茗试幽人井，香焚贾客船。\n淮流迟新月，吟玩想忘眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送史宫赞兰溪解印归阙","author":"林逋","text":"杜若萋萋天似水，一樯风信快吟怀。\n春坊冠盖还朝籍，宝婺溪山别县斋。\n访旧约僧登北固，破程乘月宿清淮。\n东南出宰才居最，畴为言扬向玉阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送史殿省典封州","author":"林逋","text":"马援疏蛮邑，铜标何可穷。\n人烟时亦有，海色自如空。\n髭发梅分白，旌旗瘴减红。\n惟应莳药罢，都在酒醪中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送吴秀才赴举","author":"林逋","text":"一战词场定策勋，麻衣西笑仕纷纷。\n风神已负青云气，艺业兼携白地文。\n辇下春华期纵辔，野中林色惜离群。\n明年新榜看看见，第甲嘉名且认君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈纵之无为军","author":"林逋","text":"淮天时节少春寒，几蒂梅花雪欲残。\n水次军城囊剑入，雨馀村坞镫驴看。\n名缘未出知谁异，道为深穷却自难。\n第一京师早西入，庙廊题字可无韩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送茂才冯彭年赴举","author":"林逋","text":"相送不觉远，离亭寒日斜。\n川途分野色，僮御想京华。\n背水当公战，凌云属赋家。\n前春得意处，酣燕上林花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送范寺丞","author":"林逋","text":"林中萧寂款吾庐，亹亹犹欣接绪馀。\n去棹看当辨江树，离尊聊为摘园蔬。\n马卿才大常能赋，梅福官卑数上书。\n黼座垂精正求治，何时条对召公车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送思齐上人之宣城","author":"林逋","text":"林岭蔼春晖，程程入翠微。\n泉声落坐石，花气上行衣。\n诗正情怀澹，禅高论语稀。\n萧闲水西寺，驻锡莫忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送昱师赴请姑苏","author":"林逋","text":"同载阖闾人，衣囊覆氎巾。\n新烟赤岸暝，融雪太湖春。\n钟远移斋候，香迟上定身。\n当知举如意，宝地雨花频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵时校书之任临川司理","author":"林逋","text":"南国古来风物好，早时游览熟登临。\n青山满路人家远，丹橘隔江秋色深。\n官况暂应劳折狱，病怀终自重分襟。\n三年解罢当求试，多草新文慰我心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送闻义师谒池阳郡守","author":"林逋","text":"渺渺大江流，沿洄过几州。\n登舻忽此别，振锡未尝游。\n九子寻真界，千兵见假侯。\n松枝谈妙字，铃阁想迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送皎师归越","author":"林逋","text":"林间久离索，忽忽望西陵。\n静户初闻扣，归舟又说登。\n野烟含树色，春浪叠沙棱。\n幸谢云门路，同寻苦未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送越倅杨屯田赴阙","author":"林逋","text":"越中分治罢，山水别来初。\n诗景多留石，船痕半载书。\n野程江树远，公宴郡楼虚。\n看塞严徐召，清风满直庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送楚执中随侍入蜀","author":"林逋","text":"严君将命之邛蜀，令子和家且侍行。\n洛汭好山归别业，江南芳草动离情。\n诗题寺壁云根润，书检松窗野色明。\n他日林间无所望，只求金榜看嘉名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送僧之姑苏","author":"林逋","text":"被请阊门寺，扁舟积水遥。\n几程冲腊雪，一饭泊村桥。\n岑色晴空映，檀烟远吹飘。\n公台悉馀镇，讲罢即相招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送僧休复之京师","author":"林逋","text":"金锡指归鸿，田衣猎晓风。\n春江片席远，松月一房空。\n新句别离后，旧山魂梦中。\n到京当袖刺，馆阁尽名公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送僧机素还东嘉","author":"林逋","text":"康乐遗踪地，言归已有期。\n江流富春阔，山沓栝苍危。\n锡润飞晴霭，罗寒滤晓澌。\n东岩有幽石，应许折松枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻叶初秀才东归","author":"林逋","text":"高鸿多北向，极目雨馀天。\n春满吴山树，人登汴水船。\n吟生千里月，醉尽一囊钱。\n肯便怀乡邑，时清复少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻灵皎师自信州归越以诗招之","author":"林逋","text":"天师苍翠横金锡，地藏清凉掩竹扉。\n千里白云随野步，一湖明月上秋衣。\n诗寻静语应无极，琴弄寒声转入微。\n我亦孤山有泉石，肯来松下共忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻越僧灵皎游天竺山因而有寄","author":"林逋","text":"天竺秋重入，招提隔翠林。\n几回闻桂子，无复隔山阴。\n峰晓云衣破，溪寒石色深。\n扪萝诸胜概，孤病负同寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日寺居和酬叶次公","author":"林逋","text":"午日猛如焚，清凉爱寺轩。\n鹤毛横藓阵，蚁穴入莎根。\n社信题茶角，楼衣笐酒痕。\n中餐不劳问，笋菊净盘樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日池上","author":"林逋","text":"莲香如绮细濛濛，翡翠窥鱼袅水荭。\n卷箔未生单簟月，凭栏初过一襟风。\n横攲片石安琴荐，独倚新篁看鹤笼。\n沉李冻醪无寄与，可怜潇洒兴谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日即事","author":"林逋","text":"石枕凉生菌阁虚，已应梅润入图书。\n不辞齿发多衰病，所喜林泉有隐居。\n粉竹亚梢垂宿露，翠荷差影聚游鱼。\n北窗人在羲皇上，时为渊明一起予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"射弓次寄彭城四君","author":"林逋","text":"襟掩皂貂斜，晴鼙响水涯。\n箭翎沉白雪，贴晕破微霞。\n气为傍观壮，言因决胜誇。\n细钗金捍彀，更忆五侯家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅馆写怀","author":"林逋","text":"垂成归不得，危坐对沧浪。\n病叶惊秋色，残蝉怕夕阳。\n可堪疏旧计，宁复更刚肠。\n的的孤峰意，深宵一梦狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题李颉林亭","author":"林逋","text":"兼琴枕鹤经，尽日卧林亭。\n啼鸟自相语，幽人谁欲听。\n半阑花籍白，一径草盘青。\n何必对樽酒，此中堪独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中 其二","author":"林逋","text":"遗编坐罢披三豕，小轴行当倦伍禽。\n廉肆有徵常遇困，刀圭无状为攻深。\n长卿痟渴应难奈，玄晏清羸已不禁。\n约缚隐囊聊阁膝，忘怀未得是微吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中谢冯彭年见访","author":"林逋","text":"老去已多病，况当梅雨时。\n山空门自掩，昼永枕频移。\n晚燕巢犹湿，新篁箨未披。\n若非求仲至，谁复问栖迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"耿济口舟行","author":"林逋","text":"环回几合似江干，刺眼诗幽尽状难。\n沙嘴半平春晚湿，水痕无底照秋宽。\n老霜蒲苇交千刃，怕雨凫鸥著一攒。\n拟就孤峰寄蓑笠，旧乡渔业久凋残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读王黄州诗集","author":"林逋","text":"坐吟行看对清秋，懒架仍移近枕头。\n放达有唐惟白傅，纵横吾宋是黄州。\n左迁商岭题无数，三入承明兴未休。\n红药紫薇千一古，又添杨子伴牢愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"读种先生丁密谏诗","author":"林逋","text":"旧草闲看即自卑，圣朝空道苦于诗。\n高才眩望如明逸，新句无因似谓之。\n淮甸月华攲枕静，秣陵春色按鞭迟。\n邯郸独步西施笑，落得星星两鬓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"途中回寄闾丘秀才","author":"林逋","text":"极目半秋色，此情聊惨悽。\n行人古道上，落日破村西。\n剑饮无高会，驴游困解携。\n祇因风与月，吾子有新题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书","author":"林逋","text":"閒看是斯文，无秦拟自焚。\n病来兼万事，休去负深云。\n直语时多忌，幽肠俗不分。\n如何麋与鹿，犹此傍人群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄太白李山人","author":"林逋","text":"颜如童子发如黳，卜筑深当太白西。\n身上祇衣粗直掇，马前长带古偏提。\n鹍鹏懒击三千水，龙虎闲封六一泥。\n几度枕肱人迹外，半窗松雪论天倪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄西山勤道人","author":"林逋","text":"天竺山深桂子丹，白猿啼在白云间。\n死生不出千门事，坐卧无如一室闲。\n谁伴锡痕过寂历，自凭茶色对孱颜。\n忘机亦有庞居士，园井萧疏病掩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄吴肃秀才","author":"林逋","text":"肄业寄僧房，暑天湖上凉。\n竹风过枕簟，梅雨润巾箱。\n引步青山影，供吟白鸟行。\n明年重访旧，身带桂枝香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄呈张元礼","author":"林逋","text":"君栖枳棘官将满，我住蓬蒿岁正穷。\n驷马交游从此少，一瓢生事不胜空。\n衡门但枕盈盈水，群木方摇摵摵风。\n若念故人兼久病，公馀无惜寄诗筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄岑迪","author":"林逋","text":"久辜才术向吾朝，公罪应该洗雪条。\n佐邑旧曾居府寺，转官新合入京僚。\n门庭冷落闲中住，僮仆生疏贱价招。\n别后交游定相忆，酒灯棋雨几清宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄和昌符","author":"林逋","text":"家近太行居，西归压一驴。\n同侪多及第，高论独知书。\n名迹收藏遍，公卿扣谒疏。\n离愁不可写，蝉噪夕阳初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]