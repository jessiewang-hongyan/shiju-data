[{"title":"冬日城楼驻望","author":"宋祁","text":"城上危栏徙倚频，由来荆楚岁时新。\n寒塘酒帜能留客，晴坞梅花解笑人。\n客雁参差仍向渚，贪鱼拨剌不容缗。\n凭高更尽三吹角，坐见霞霏仄半轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日野外 其一","author":"宋祁","text":"霜郊堪极目，万籁共骚骚。\n远水无穷绿，寒云自不高。\n候鸿差入渚，田雀短翔蒿。\n岁稔期民阜，中田馌冻醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日野外 其二","author":"宋祁","text":"野迥人来少，天平鸟去长。\n鱼梁四寸罟，樵市五家浆。\n谷转留寒雾，霞休罢夕阳。\n不须教目极，即是到回肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬夜饮散怅然有感","author":"宋祁","text":"酏颜夜酌釂兰卮，怅忆彫年事半违。\n雪墅陇云寒寡色，霜天幌月暗通辉。\n素书有恨随鸿远，蘧梦无成伴蝶归。\n可得延陵重一听，流波雅引在金徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬眺","author":"宋祁","text":"城外斜光角已催，城头倦客首空回。\n星霜牢落凋年往，天地苍茫暝色来。\n千尾昏鸦愁迥戍，几蹄征马思穷埃。\n使君兴罢惟无绪，不是登高能赋才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冯彭年苏州法掾","author":"宋祁","text":"竹箭征舻驶，骊驹客袂分。\n倦游销仲产，参事厌卿军。\n象阙天中隔，乡朝月外闻。\n西山朝气爽，拄颊待谈云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出次近郊","author":"宋祁","text":"江练东南楚塞长，野烟寒气共苍茫。\n局辕班马思长道，攫肉饥乌下夕阳。\n旅舍樵苏劳后爨，农家簦笠远相望。\n坐观民瘼无他画，庭列貆鹑目眩觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出郊","author":"宋祁","text":"茂草平堪藉，长杨绿自垂。\n郊晴艾帐远，桥迥犊车迟。\n有鹤迎飞盖，无蛇赌赐卮。\n秦楼何用识，马尾结青丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出城写望","author":"宋祁","text":"驱车南陌道，物色喜春还。\n水暖初成浦，云晴不抱山。\n原姿平澶漫，禽哢巧间关。\n此适非谋野，祠官只在闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出城所见赋五题 其一","author":"宋祁","text":"二月雨堪爱，霏霏膏泽盈。\n添成竹箭浪，催发杏花耕。\n迥湿风头冷，微含日脚明。\n居然嘉应在，谁是束长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出城所见赋五题 其三","author":"宋祁","text":"二月花堪爱，全开未落时。\n香轻长抱蕊，霞破即团枝。\n舞蝶何曾定，流莺不待期。\n劳君金缕唱，更尽拍浮卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出城所见赋五题 其五","author":"宋祁","text":"二月风堪爱，悠悠天际生。\n向空鸣籁细，乘暝作寒轻。\n拂水纹层浪，穿条杌紫茎。\n烦君期素魄，相伴倒春清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出城所见赋五题 其四","author":"宋祁","text":"二月草堪爱，一番芳意还。\n远迷天泱泱，低隐雉斑斑。\n细雨鲜原润，东风古道閒。\n王孙归定否，持问桂枝山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出城所见赋五题 其二","author":"宋祁","text":"二月水堪爱，泮流清复浑。\n影深天在底，红乱日摇痕。\n鹜没小舟度，鱼喁新藻翻。\n有人无限思，惭愧仲长言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"出城暂憩林下","author":"宋祁","text":"下马清林下，翛然忘俗情。\n山禽不辨种，溪草尽无名。\n露笋披斑箬，风葩抗紫茎。\n徘徊漱岩溜，未忍濯尘缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北归","author":"宋祁","text":"一水清波驶，还将桧楫归。\n缨緌成素滥，猿鹤恐长违。\n斗外城隅出，云端阙影微。\n定知朝夕鸟，却望汉台飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北园池上","author":"宋祁","text":"中园稍萧槭，日脚净空埃。\n寒蝶飞还下，饥鸥去又回。\n林高风搅叶，垣暗雨留苔。\n颇赋高秋兴，人非骑省才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"去州三宿八公山宛然在望","author":"宋祁","text":"山长如不去，三宿趁行舟。\n未必缘人意，祗能搅客愁。\n倦程方浩荡，回首更夷犹。\n独有相思恨，因之东北流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"去郑暮次中牟","author":"宋祁","text":"暮投京县宿，气象已纷罗。\n菀树道旁密，侯田关内多。\n高城切星斗，秋水似天河。\n自问还台马，犹馀几子珂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古邑二首 其二","author":"宋祁","text":"坠雨离邦远，编蓬僦庑卑。\n人非一国敌，家乏万钱赀。\n江海嗟漂荡，乾坤惜变衰。\n此时看落叶，宁翅长年悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古邑二首 其一","author":"宋祁","text":"古邑蓬池上，私居市道邻。\n初抛三釜粟，来作一廛民。\n乞火黔薪突，翻经振隙尘。\n何从复何去，更欲问圆神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古意","author":"宋祁","text":"博妖齐许取侯封，褒贬都归竹帛中。\n三虎有无空逞辩，一狐埋伏妄贪功。\n轮囷自许先枯木，首鼠何曾忌秃翁。\n堪笑云罗弥薮泽，不知天外有冥鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"史逸人","author":"宋祁","text":"菑停滞穗壤馀蔬，亩首东南乐隐居。\n席地雕觞千日酒，振缗丹水百金鱼。\n潺湲弄月蘋汀晚，嗢噱调琴菌阁虚。\n霄外高情思把袂，西畴何日一巾车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叶司封知宣州","author":"宋祁","text":"岁久中台鹄领垂，牢盆罢计拥藩麾。\n新加绶艾天香袭，密对帘须禁刻移。\n青舸信潮随早暮，赤轓灵雨遍公私。\n树犹如此成前感，重荫当年蔽芾枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司马相如琴台","author":"宋祁","text":"故台千古恨，犹对旧家山。\n半夜鸾凰去，他年驷马还。\n死忧封禅晚，生爱茂陵閒。\n惟有飘飘气，仍存天地间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司徒侍中宣献公挽词二首 其一","author":"宋祁","text":"斯文推旧德，忧国变华颠。\n夙夜劳三事，东西止百年。\n温辞联册秘，良史大都传。\n他日贤臣垄，心知望圃田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司徒侍中宣献公挽词二首 其二","author":"宋祁","text":"美疢交明晦，浮龄讵控抟。\n宗盟一个弱，人赎百身难。\n赐敛荣絺衮，临哀驻玉銮。\n欲知桃李爱，朝绂共汍澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四望亭","author":"宋祁","text":"秋城聊一眺，物色已苍茫。\n爽籁风驱远，寒烟晚曳长。\n祠成樗作社，戍罢女留墙。\n要是凋年感，能回倦客肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对月 其二","author":"宋祁","text":"月华真可爱，堂上共徘徊。\n白露方徐贶，清风适共来。\n蚌津随照满，乌阁为啼开。\n万虑方岑寂，愁看云汉回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对月 其一","author":"宋祁","text":"林梢霞尾暗，海面月华新。\n一水开天鉴，千金上佛轮。\n幽岩涵静桂，潜蚌溢凉津。\n不必姑山去，翛然自玉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对雪二首 其二","author":"宋祁","text":"萦丛著树半潇潇，皓气妍华混泬寥。\n为倚风流偏解舞，故藏朝晛未成消。\n玉绳四彻仙峰迥，银界三千佛国遥。\n向曙纷纷殊未已，九门知有谢庄朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对雪二首 其一","author":"宋祁","text":"风过龙山万里沙，密霙疏霰渺无涯。\n台疑穆满都成璧，树忆黄奴并是花。\n曾许轻姿饶白羽，解将寒力减流霞。\n梁王不悦邹枚老，同坐睢园念岁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"永兴郑资政巩县路逢雪见寄","author":"宋祁","text":"大旆关河远，同云天地浮。\n凌晨逢朔雪，此路向西州。\n寒袭生犀健，光催畅毂流。\n馀清念东郭，穿履趁英游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉南州按行江涘以诗见寄","author":"宋祁","text":"侧帽风轻过大堤，水村骄马惜障泥。\n前驱夹道旟开隼，合宴传飧帐绕犀。\n净练寒江供望阔，赤萍圆日对吟低。\n轻筒络绎传清唱，知在春烟几曲溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉南都监官廨射亭","author":"宋祁","text":"的晕遥连射圃墙，碧帘烟瓦斗翚翔。\n庭中桂树含春早，席外帘衣拂地长。\n鲙缕荐盘鳊项缩，酒杯行算蟹螯香。\n主翁绶带多欢极，宾辖沈声在井床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉堂感旧","author":"宋祁","text":"七年辞玉署，再入佐黄扉。\n树与青春换，人将素领归。\n砖花仍可记，厦雀稍惊飞。\n炉蕙非无意，逢人尚袭衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白兆山寺值雨呈同坐","author":"宋祁","text":"飞轩凭望俯丹梯，星雨囊风暝夕曦。\n翠阜天遥云待簇，绀园花老树低枝。\n巾车预畏烟畴迥，蜡屐先忧磴道危。\n未似庾公年最少，桑郊盘马帽檐敧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白兆山桥亭","author":"宋祁","text":"千尺虹泉界道飞，阴虬横绝负云楣。\n浮梁跨岸神移石，劫烬翻波地献池。\n度日衔花翔翠鸟，经年支榻养灵龟。\n披襟便可袪烦吝，不独东京叔度陂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"礼局致斋","author":"宋祁","text":"枌榆秋报汉家坛，斋誓先朝令不刊。\n抱蕝一身依礼署，饭蔬三日属祠官。\n天池唳鹤惊宵滴，宫堞栖乌噪暮寒。\n倦枕不烦神栎梦，有人无用亦常叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙岩寺","author":"宋祁","text":"磴齿缘苍巘，檐牙冒紫氛。\n楼鸣穿峡濑，堂宿抱峰云。\n鸟散生台晏，僧归浴树曛。\n居然化城地，长与客尘分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丞相庞公归政就第数有新诗传播都下偶成拙句上纪盛德二首 其二","author":"宋祁","text":"第门行马护清埃，拂席时时宴具开。\n安石风流今日是，平津宾客几人来。\n幄中谋熟君筹在，川上身閒汝楫回。\n绝俗新章满都纸，向时疏傅定无才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丞相庞公归政就第数有新诗传播都下偶成拙句上纪盛德二首 其一","author":"宋祁","text":"方道逍遥一品身，尽收和气付凝神。\n小车殿里抛丞相，南极星边伴老人。\n双鹤对眠云帐月，五芝催耨雨岩春。\n支离旧客公知否，私计东山作近邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲冬二日使到颁翠毛锦旋襕","author":"宋祁","text":"翠裘朝罢转昕霞，颁服诸方走使车。\n泥和五芳中出诏，锦裁双兽织成花。\n官叨侍橐恩加等，例及和门赐有差。\n坐袭馀温身更宠，不惭多病带镮赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"休日","author":"宋祁","text":"病粟支离月有储，汉家汤沐许家居。\n材同曲社真无用，拙比河阳恐有馀。\n半夜羁魂随鹤警，九秋嘶腹共蝉虚。\n谁言舐痔非长策，却得君王五乘车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"休日阅古堂小宴","author":"宋祁","text":"宴堂丛橑倚晨霏，客衽风清酒力微。\n曲沼新荷能碍钓，霁林浓叶不通飞。\n盘纷素脍鱼腴美，齿渍寒津蔗境肥。\n一笑相欢无吏责，张扶应悟坐曹非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"休沐","author":"宋祁","text":"出休连日似山郎，坐有蛩毡沐有汤。\n缸面酒华随日转，琴中松韵共风长。\n宫卑宁为今无巧，愚极曾闻古是狂。\n自顾支离身碌碌，襆归囊被亦何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伤和靖林先生君复二首 其二","author":"宋祁","text":"笔精传禊帖，句赏俪汀蘋。\n道胜吾忘我，贤嗟岁在辰。\n风愁青桂暝，露泣紫芝春。\n一束生刍赠，门无杂吊宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伤和靖林先生君复二首 其一","author":"宋祁","text":"清濑严生国，良田仲子居。\n姬姜生不娶，封禅死无书。\n灶冷丹何去，厨封画已虚。\n诏函加美谥，不及裹轮车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光禄叶大卿哀词 其一","author":"宋祁","text":"八十浮龄尽，三千去日长。\n丛兰秋寂寞，卿月夜苍茫。\n里友歌迎绋，州民酹续浆。\n英魂知所托，桥梓蔼成行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光禄叶大卿哀词 其二","author":"宋祁","text":"偃息朋三寿，生平定四知。\n乡人荣衣绣，光禄号能诗。\n未赴安车召，遽成埋玉悲。\n方珉纪遗爱，无诳冢中辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再入翰林","author":"宋祁","text":"银台路入复门赊，四载重来鬓愈华。\n况自秋毫皆帝力，何言旧物是吾家。\n宫盘浩气浮襟爽，省树珍阴叠殿斜。\n书枕梦残闻吏报，日痕还复度砖花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再侍经筵有感","author":"宋祁","text":"露门重幄紫云开，何意孤臣得重陪。\n攀树已惊刘放老，受釐犹及贾生来。\n华绨藉暖瞻宸几，甘露浮香入赐杯。\n稽古虽勤成底力，心知不及汉儒才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再逢成上人","author":"宋祁","text":"上都初见赤髭年，并在西州绛帐前。\n每与文殊同问疾，不知灵运遽生天。\n淮山永忆吟无社，梁苑重来供有缘。\n休问外堂诸弟子，饿思周粟赋归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再寄","author":"宋祁","text":"铃下呼儿破锦鳞，新篇遗我故情亲。\n铩鸾遂有翻飞日，行苇应无践履人。\n谗毒未销须刮骨，上恩难报止沾巾。\n夫君何事材为累，短褐征衣拥塞尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"农阁","author":"宋祁","text":"菌阁俯江干，西南蜀塞宽。\n看云记巫峡，望日省长安。\n钿崒峰头碧，霞皴荔子丹。\n比来秋物好，谁伴数凭栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"农歌","author":"宋祁","text":"农歌非度曲，新乐信蚩蚩。\n乃父知田事，吾王采谚辞。\n折杨时动笑，鼓腹自成嬉。\n日暮牛童笛，连声下远陂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘立德同年赴淝州幕","author":"宋祁","text":"春榜连题千佛经，两藩交辟滞弓旌。\n幕中仍是红莲客，门下今为玉笋生。\n林逗楚风披醉衽，浪摇淮月渍离缨。\n归来上赋趋行在，足继西豪旧弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华州西溪","author":"宋祁","text":"山近重岚逼，溪长匹练分。\n霁波平撼日，寒崦侧藏云。\n弄荇鱼差尾，投汀鹭列群。\n如何去寻丈，尘路已纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同小侄圭璞溪上汎舟","author":"宋祁","text":"出郭晓云霁，泛舟春日迟。\n诗怀随物放，酒面任风吹。\n循岸烦鸥起，看山惜棹移。\n州人轻此乐，赖与汝曹期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同年毛洵勾簿新建","author":"宋祁","text":"年衰冬集罢，鹢首晓帆催。\n枳棘非鸾处，膏腴得父才。\n澄江限天阔，孤鹜透霞来。\n此地留清赏，谁同耻宴罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同年王圣源南都讲授","author":"宋祁","text":"刻意悲秋发未华，诸曹频费杜陵嗟。\n歌缘郢客高难和，璧是秦人误指瑕。\n绿底恩书褒振滞，乌衣群从庆还家。\n离宫万户经庠盛，却对诸生坐绛纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同年成楷潍州理掾","author":"宋祁","text":"东风莺友旧联飞，彫岁鹍弦此怆离。\n路怨亭皋长续短，客嗟京邑素为缁。\n且欣便道还家近，未厌无闻得掾卑。\n汉殿有人能夜诵，君才不减子虚辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同年李宗太平法掾","author":"宋祁","text":"俊名参吏启，掾事补编堂。\n尽取黄金酒，重纡碧鹤裳。\n佐庖鲑菜厚，束帙秘厨香。\n认得公庭步，鬑须白皙郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同年梅鼎臣赴凤翔幕兼省觐","author":"宋祁","text":"酪和盘樱旧宴空，凤岐新辟逐旌弓。\n坐陪府幄谈成薮，趋问家庭史有公。\n春斝促浮萍叶紫，夜章催刻密枝红。\n青袍玉骨英游盛，上路争看侧帽风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同年谭综掾江陵","author":"宋祁","text":"乡树湘云外，行辕楚塞东。\n不辞淹拔萃，聊欲辨无同。\n暝紫生寒岫，疏丹点暮枫。\n登楼有归讯，为附北归鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同张子春淮上作","author":"宋祁","text":"南风今日好，归棹上淮津。\n川迥舟如叶，山遥石似人。\n波光篙底动，沙垒涨馀新。\n谁信机心少，溪鸥伴此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同赋饮舫","author":"宋祁","text":"饮有乘舟乐，舟因得饮名。\n能招习池客，便载景山铛。\n暂儗留颓玉，徐牵倒醉罂。\n莫辞沿溯远，双楫自逢迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]