[{"title":"满庭芳 其三 探梅","author":"葛立方","text":"狂吹鸣篱，祥霙剪水，分明欺压寒梅。\n冰威初敛，曦影上池台。\n应有一番和气，南枝上、恐有春来。\n须勤探，呼吾筇杖，屐齿上苍苔。\n春风，浑未到，徘徊香径，巡绕千回。\n见琼英一点，小占条枚。\n且看先锋素艳，看看便、繁蕾齐开。\n香浮动，微薰诗梦，须更著诗催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳 其六 簪梅","author":"葛立方","text":"弄月黄昏，封霜清晓，数枝影堕溪滨。\n化工先手，幻出一番新。\n片片雕酥碾玉，寒苞似、已泄香尘。\n聊相对，畸人投分，尊酒认荀陈。\n吾年，今老矣，佳人薄相，笑插林巾。\n愧苍颜白发，回授乌云。\n玉镜台边试看，相宜是、浅笑轻颦。\n君知否，寿阳额上，不似鬓边春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳 五侄将赴当涂，自金坛来别","author":"葛立方","text":"栗里田园，乌衣门巷，别来几换星霜。\n华阳仙窟，翠桁彩衣香。\n梦堕当涂风月，披绛帐、欲指鳣堂。\n浮鸥外，来宁老子，特泛霅溪航。\n相逢，春正好，梅舒香白，柳曳宫黄。\n且相将一笑，乐未渠央。\n须念离多会少，难轻负、百榼霞浆。\n深深观，舞回飞雪，乐奏小宫商。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳 其七 评梅","author":"葛立方","text":"一阵清香，不知来处，元来梅已舒英。\n出篱含笑，芳意为人倾。\n细看高标孤韵，谁家有、别得花人。\n应须是，魏徵妩媚，夷甫太鲜明。\n北枝，方半吐，水边疏影，绰约娉婷。\n问横空皎月，匝地寒霙。\n何似此花清绝，凭君为、子细推评。\n幽奇处，素娥青女，著意为横陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳 其四 赏梅","author":"葛立方","text":"腊雪方凝，春曦俄漏，画堂小秩芳筵。\n玉台仙蕊，帘外幂瑶烟。\n莫话青山万树，聊须对、一段孤妍。\n杯行处，香参鼻观，百濯未为贤。\n吾庐，何处好，绣香竹畔，偶桂溪边。\n且为渠珍重，满泛金船。\n已拚春酲一枕，如今且、醉倒花前。\n花飞后，欢呼一笑，又是说明年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳 其二 和催梅","author":"葛立方","text":"未许蜂知，难交雀啅，芳丛犹是寒丛。\n东方解冻，春仗做春工。\n何事仙葩未放，寒苞秘、冰麝香浓。\n应须是、惊闻羯鼓，谁敢喷髯龙。\n梅花，君自看，丁香已白，桃脸将红。\n结岁寒三友，久迟筠松。\n要看含章檐下，闲妆靓、春睡朦胧。\n知音是，冻云影底，铁面葛仙翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳","author":"葛立方","text":"扉映琉璃，窗摇云母，水堂新甃云湾。\n际天波面，玉镜宝奁宽。\n栏外青山几叠，瑶烟敛、影落千鬟。\n寒汀晚，芦花飞雪，风定白鸥闲。\n尘寰。\n何处有，方壶圆峤，弱水波翻。\n问何如藜杖，此地跻攀。\n种竹今逾万个，风枝静、日报平安。\n他年事、苍云屯处，千亩看栖鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳 胡汝明罢帅归，坐间次韵作","author":"葛立方","text":"江国麾幢，边城鼓角，湓川几报严更。\n笑谈油幕，英杰为时生。\n腹贮六韬三略，新诗就、矛槊频横。\n功名事，他年未晚，一笴落欃枪。\n归来，何早计，白蘋洲畔，危获深耕。\n又何如，竹帛彝鼎垂名。\n犀节徵还伊迩，春风外、文鹢催行。\n岩廊上，谈兵齿颊，谠论佐休明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瑞鹧鸪 小孙周晬席上作","author":"葛立方","text":"榴花庭院戏氍毹。\n水剪双眸画不如。\n莫恨未能通瑟僩，只今先已辩之无。\n虎睛浅缀新花帽，龙脑浓熏小绣襦。\n乃祖未须贻厥力，及时须读五车书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"锦堂春/锦堂春慢 正旦作","author":"葛立方","text":"气应三阳，氛澄六幕，翔乌初上云端。\n问朝来何事，喜动门阑。\n田父占来好岁，星翁说道宜官。\n拟更凭高望远，春在烟波，春在晴峦。\n歌管雕堂宴喜，任重帘不卷，交护春寒。\n况金钗整整，玉树团团。\n柏叶轻浮重醑，梅枝巧缀新幡。\n共祝年年如愿，寿过松椿，寿过彭聃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花 冬至席上作","author":"葛立方","text":"缇室群阴清晓散。\n灰动葭莩，渐觉微阳扇。\n日永绣工才一线。\n挈壶已报添银箭。\n六幕无尘开碧汉。\n非雾非烟，彷佛登台见。\n梅萼飘香萦小宴。\n霞浆莫放琉璃浅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答陈抟","author":"葛守忠","text":"华岳三峰客，幽居不记年。\n烟霞为活计，云水作家缘。\n种药茅庭畔，栽松涧壑边。\n暂离仙洞去，可应帝王宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏黄石公","author":"葛庆龙","text":"挟书律重火犹光，天下严搜不敢藏。\n圯上老人无见者，一编亲写授张良。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"筇杖","author":"葛庆龙","text":"白发慵巾短短衣，闲行斜倚小筇枝。\n自家弄影犹痴绝，只似初骑竹马时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游宝林寺","author":"葛庆龙","text":"坐如有待思依依，看竹回廊出寺迟。\n窅窅绿荫清寂处，半窗斜日两僧棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢理得惠书","author":"葛庆龙","text":"五朵飞来渍剡藤，重重响似水泠泠。\n不教落在红尘耳，读与青松白鹤听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题仙人洞并谢草堂方公所赠石匣 其二","author":"葛庆龙","text":"云长镇洞有时开，石匣终藏化鹤胎。\n千岁不须华表柱，飞鸣南向洞山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题仙人洞并谢草堂方公所赠石匣 其一","author":"葛庆龙","text":"多谢林僧亦好奇，新遗石匣我酬诗。\n鹤胎收却云封裹，付嘱山灵木客时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠僧","author":"葛庆龙","text":"七轴莲经供茗瓢，一龛绣佛挂松寮。\n舶香亦带鱼龙气，自采枝头柏子烧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"迎神","author":"葛闳","text":"符法千年人尚畏，神林三鼓酒盈杯。\n油囊为取天河水，更折蟠桃海上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招桐柏李道士","author":"葛闳","text":"海岭重重接紫虚，高人还肯敞仙裾。\n玉蟾点滴有清露，少费研朱写道书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罗汉阁煎茶应供","author":"葛闳","text":"山泉飞出白云寒，来献灵芽秉烛看。\n俄顷有花过数百，三瓯如吸玉腴乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送神","author":"葛闳","text":"丹霞缥缈海三峰，归去琼台第几重。\n仙骥一声风驭远，月明清露滴金松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桐柏观","author":"葛闳","text":"桃花烂熳春溪暖，紫玉箫沉月树昏。\n未觉台中光景晚，人间归去见来孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游日山","author":"葛闳","text":"六时香火集宗雷，日上云收紫翠开。\n应笑守麾公暇少，二年官满一曾来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游白云轩赠冲一道正","author":"葛闳","text":"无事之时无事身，天将冲淡养吾真。\n鸱鸢啄腐成滋味，岂识朝霞吐咽人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题清辉堂","author":"葛闳","text":"归老云边一翠岑，静中观动照人心。\n溪湖北上又东去，不似青山无古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桐柏崇道观","author":"葛闳","text":"昔贤书洞石，台有伯阳经。\n碧海船多却，金霞夜不扃。\n炉成九转药，阶布六符星。\n捷径非君意，深游不死庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"巾山广轩","author":"葛闳","text":"胜地藏东越，严城耸二岑。\n万灯迎日早，孤磬出云深。\n雪霁茗初试，雨涵山半阴。\n兹焉即方广，有路到天心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日","author":"葛绍体","text":"不管西风吹帽纱，出门闲步夕阳斜。\n平湖水落苍黄处，一段风烟芦荻花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日寄渭南文友","author":"葛绍体","text":"自古吴兴山水窟，只今杖屦几人闲。\n怀君九日登临处，知向何山向道山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十五夜听雨","author":"葛绍体","text":"断续寒声落晚红，拥炉闲对逗香风。\n醉迷客思醒依旧，不在芭蕉点滴中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三日雪后饮烟雨馆 其一","author":"葛绍体","text":"傍湖千树玉参差，湖面轻风落钓丝。\n晚色晴阴正商略，断云来去半犹痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三日雪后饮烟雨馆 其二","author":"葛绍体","text":"旋融残雪点团茶，碧净红鲜朵上花。\n客散亭闲半湖水，月梳斜掠晚晴霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"义乌道中二首 其二","author":"葛绍体","text":"小雨山寒占麦秋，溪南溪北水交流。\n桃花又报东风急，云带雨来山欲浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"义乌道中二首 其一","author":"葛绍体","text":"溪头石佛泗州身，半染炉烟半路尘。\n儿女一盘清净供，苏溪茶点建溪春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大丘至黎坑口","author":"葛绍体","text":"重岚浮动光相射，峭壁横斜罅欲开。\n比似雁山多秀发，丰棱那复让天台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小憩梵安寺","author":"葛绍体","text":"浅绿深红映夕岚，子规声在虎溪南。\n明朝尘土又归去，长忆来时三月三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"马喻答惟晓问","author":"葛绍体","text":"振鬣长鸣向远天，轻蹄健步欲争先。\n关山万里踏飞雪，何似春风御柳边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五部岭","author":"葛绍体","text":"岭上烟云作伴行，远山凝绿向谁横。\n醉来睡足茅檐雨，三十六滩春水生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元直弟梧坡","author":"葛绍体","text":"东山山下碧梧坡，照映朝阳岁月多。\n好是凤凰栖泊处，一鸣天地起春和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"午坐","author":"葛绍体","text":"疏竹墙头半粉青，盆池荷小欠浮萍。\n虚檐槐影日亭午，醉倚栏干莺唤醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天章桥","author":"葛绍体","text":"画桥人静度杨花，山果溪鱼卖酒家。\n淡淡轻烟绿阴浅，一年春色到桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太师汪焕章社日劝农余出湖曲 其一","author":"葛绍体","text":"飞旆行春沐雨天，风光一阵杂晴烟。\n麦苗绿润秧芽嫩，鼓吹声中卜有年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太师汪焕章社日劝农余出湖曲 其二","author":"葛绍体","text":"春劝老农誇岁岁，晚飞新燕贺年年。\n鉴湖一棹烟波客，燕舞农歌伴醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"见王兼叔上舍寿母","author":"葛绍体","text":"百单二岁尚簪梳，珍重酡颜映雪肤。\n天下丹青谁妙手，倩渠描作寿星图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东阳道中二首 其二","author":"葛绍体","text":"溪头亭匾佳山水，水绕山围巷陌清。\n晚向酒旗高处泊，画楼更点亦春声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东阳道中二首 其一","author":"葛绍体","text":"麦陇东风半展须，桃红柳绿自相于。\n耕犁歇午炊烟起，断岸溪头人钓鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东园池上","author":"葛绍体","text":"急雨斜风颤晓荷，娇羞花面泪痕多。\n向人欲语竟不语，风雨无情花奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乐清道中二首 其二","author":"葛绍体","text":"前浦归帆挂夕阳，傍船打鼓是渔乡。\n居人却惯鱼虾贱，茅店晚厨春荠香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乐清道中二首 其一","author":"葛绍体","text":"雅淡风光近上元，迎神箫鼓自年年。\n客行不趁花灯市，月满寒江水拍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卢子高梅岩","author":"葛绍体","text":"倚岩好竹已清绝，竹里梅梢更绝清。\n要看萧疏影来去，最宜天气半阴晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"四月八日永嘉卢子高醵西湖","author":"葛绍体","text":"远近山光浓淡中，晓云零乱越湖风。\n飞来几点浴佛雨，湿住杨花粘落红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永嘉王孟同适安堂","author":"葛绍体","text":"茂林脩竹更清泉，笑里相逢到酒边。\n一片闲云了无著，共他风月自今年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲和时斋即事","author":"葛绍体","text":"夹径花开一丈红，傍池新竹万枝风。\n闲来笑语忘为客，杯酒淡烟明月中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲和亲迎慈溪 其二","author":"葛绍体","text":"万卷何如一寸心，心涵万卷自知音。\n圣功不是寻常事，泰华高寒沧海深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲和亲迎慈溪 其一","author":"葛绍体","text":"灯火宗盟旧日寻，宜家宜室正如今。\n春风蘋藻慈湖上，琴瑟新调太古音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有感","author":"葛绍体","text":"过了青梅杏子红，担头和雨卖匆匆。\n催人节物如流水，流到东头更向东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹西午坐","author":"葛绍体","text":"桧树参差翠满庭，甜风爱日透疏棂。\n倦行静倚湘斑坐，高下书声得细听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖二首 其二","author":"葛绍体","text":"杨柳芙蓉旧日栽，近来堂宇更安排。\n湖光接得全天趣，莫遣游人鼓吹来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖二首 其一","author":"葛绍体","text":"年年春色客中看，不管今年行路难。\n行到西湖春正好，万重杨柳傍栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西湖即景","author":"葛绍体","text":"笑倚东风看画船，晴天如水水如天。\n酒旗高处玉骢急，万树垂杨一抹烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观雪","author":"葛绍体","text":"只是寻常云雨晓，岁寒然后见天真。\n人间莫作寒愁想，一片飞来一片春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过江心寺","author":"葛绍体","text":"寺带长江山作围，塔峰相对立涟漪。\n好风吹浪舟行急，正是午潮初长时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过西斋","author":"葛绍体","text":"青灯一晕静相看，酒敌残秋夜半寒。\n却怕醒来人独自，西风索索荻声乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴友翠玉轩","author":"葛绍体","text":"嚣市尘中无此清，竹风声应读书声。\n一轩拥翠万玉瘦，正好著渠难弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀元直弟","author":"葛绍体","text":"草色苔痕绿满庭，读书声向梦中听。\n湿云冷雨更愁绝，寂寞旅床思鹡鸰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旱中早起","author":"葛绍体","text":"桔槔声里恨难平，似诉民劳彻上清。\n料得为霖只今日，满天风露看云生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"时斋新植","author":"葛绍体","text":"红栏一带树青青，帘幕风轻飏晓晴。\n日转花阴燕飞去，堂中惟有读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苍岭行三首 其三","author":"葛绍体","text":"只将客路当山行，自觉春光步步生。\n几许花开到桃李，东风又趣陇头耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苍岭行三首 其二","author":"葛绍体","text":"翠拥层崖一水分，括苍遥接赤城春。\n观音城上灵官庙，多少烧香行路人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苍岭行三首 其一","author":"葛绍体","text":"客自忙忙山自闲，有情飞鸟去来间。\n石矶坐久风林静，一派泉声落半山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]