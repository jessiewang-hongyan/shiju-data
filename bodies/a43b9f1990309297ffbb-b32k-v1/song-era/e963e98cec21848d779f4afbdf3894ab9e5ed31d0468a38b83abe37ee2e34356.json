[{"title":"元日词 其四 御阁","author":"晏殊","text":"习习条风拂曙来，清香犹绽雪中梅。\n屠苏酒绿炉烟动，共献宜城万寿杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57265,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆越州 其二","author":"晏殊","text":"湖山杳渺不可状，登览幽求无所遗。\n高僧伴吟足清览，见尽白莲开落时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57266,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆越州 其一","author":"晏殊","text":"鉴湖清澈秦望高，涵虚逗碧供吟毫。\n当日醉眼倚空阔，三江七泽才容舠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57267,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月十九日京邑上元收灯日","author":"晏殊","text":"星逐绮罗沉曙色，月随丝管下层台。\n千蹄万毂无寻处，祇似华胥一梦回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57268,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白云庵","author":"晏殊","text":"草庵何似清风楼，更在空中最上头。\n眼界豁开无畛域，枯藤古木暮烟浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57269,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春祀太乙 其一","author":"晏殊","text":"紫毛双节引青童，一片空歌韵晓风。\n太昊兹辰授春令，莺旗应在矞云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春祀太乙 其二","author":"晏殊","text":"华灯明灭羽衣攒，翠柳萧森矮桧寒。\n千步回廊绕金殿，水苍瑶佩响珊珊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吊苏哥","author":"晏殊","text":"苏哥风味逼天真，恐是文君向上人。\n何日九原芳草绿，大家携酒哭青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和参政陈给事寒食杜门感怀 其二","author":"晏殊","text":"谢堂新句入清歌，雨箔风帘有燕过。\n未免芳辰叹心赏，始知犹患陆才多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和参政陈给事寒食杜门感怀 其一","author":"晏殊","text":"班班疏雨欲晴天，回避春风入醉眠。\n新火未来丝阁静，砌苔窗树两依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹醉日","author":"晏殊","text":"苒苒渭滨族，萧萧尘外姿。\n如能乐封殖，何必醉中移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西垣榴花","author":"晏殊","text":"山木有甘实，托根清禁中。\n岁芳摇落尽，独自向炎风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"牡丹","author":"晏殊","text":"水晶宫殿接龙津，碧树阳春晓色新。\n朱户曲房能驻日，酥盘金胜自生春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"社日戏题呈任副枢","author":"晏殊","text":"开樽幸有治聋酝，把叶能无送燕章。\n所惜近停司饮会，不如村叟醉秋光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日词 其一 内廷","author":"晏殊","text":"朱户未闻迎綵燕，东郊先报舞云翘。\n姜任盛德符青史，金屋千春奉圣朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日词 其三 内廷","author":"晏殊","text":"才闻太昊行新令，更祝元君望景舆。\n白玉龟台资寿历，千春鸿福此春初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日词 其四 内廷","author":"晏殊","text":"双金缕胜延嘉节，五綵为幡奉紫廷。\n春色渐浓人未觉，玉阶杨柳半青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日词 其二 内廷","author":"晏殊","text":"柳燧青青淑气和，冰纹初解縠文波。\n淑风殿里黄金屋，应候称觞万寿多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日词 其二 东宫阁","author":"晏殊","text":"碧燕幡长綵树新，寝门瑶佩庆初春。\n邦家累善钟储贰，皎皎重晖在璧轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日词 其一 东宫阁","author":"晏殊","text":"青幡乍帖宜春字，翠旆初迎入律风。\n一有元良昭大庆，问安长在紫宸中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日词 其三 御阁","author":"晏殊","text":"青辂迎春习习来，天泉池上晓冰开。\n珠幡已报三阳候，柏叶将陈万寿杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日词 其四 御阁","author":"晏殊","text":"綵幡双燕祝春宜，献寿迎祥重此时。\n腊雪未消宫树碧，早莺声在万年枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日词 其二 御阁","author":"晏殊","text":"三素云中晓望时，上真軿盖保参差。\n丹台自有长生籍，睿算方延亿万期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春日词 其一 御阁","author":"晏殊","text":"令月归馀届早春，羲舒相望协元辰。\n初阳乍逐青旂动，圣寿长随凤历新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"迎春花","author":"晏殊","text":"浅艳侔莺羽，纤条结兔丝。\n偏凌早春发，应诮众芳迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闰九月九日","author":"晏殊","text":"闰秋重九再佳辰，犹见黄花裛露新。\n更作登高亦何害，恨无彭泽苦吟人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏上竿伎","author":"晏殊","text":"百尺竿头袅袅身，足腾跟挂骇傍人。\n汉阴有叟君知否，抱瓮区区亦未贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"建茶","author":"晏殊","text":"北苑中春岫幌开，里民清晓驾肩来。\n丰隆已助新芽出，更作欢声动地催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"盂兰盆","author":"晏殊","text":"红白薇英落，朱黄槿艳残。\n家人愁溽暑，计日望盂兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金凤花","author":"晏殊","text":"九苞颜色春霞萃，丹穴威仪秀气殚。\n题品直须名最上，昂昂骧首倚朱栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金灯花 其二","author":"晏殊","text":"兰香爇处光犹浅，银烛烧时焰不馨。\n好向书生窗下种，免教辛苦更囊萤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金灯花 其一","author":"晏殊","text":"煌煌五枝灯，下有玉蟠螭。\n汉宫已荆棘，此地生何为。\n既无膏火用，虚名徒自欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金柅园","author":"晏殊","text":"临川楼上柅园中，十五年前此会同。\n一曲清歌满樽酒，人生何处不相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"草","author":"晏殊","text":"春尽江南茂草深，绕池萦树碧岑岑。\n长安官舍孤根地，一寸幽芳万里心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠 其三","author":"晏殊","text":"昔闻游客话芳菲，濯锦江头几万枝。\n纵使许昌诗笔健，可能终古绝妍辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠 其四","author":"晏殊","text":"濯锦江头树，移根药砌中。\n只应春有意，偏与半妆红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崇因寺","author":"晏殊","text":"卷帘山色眼前见，入夜涛声枕上闻。\n苔径雨馀堆落叶，石楼风静锁寒云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中","author":"晏殊","text":"平台千里渴商霖，内史忧民望最深。\n衣上六花非所好，亩间盈尺是吾心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹿葱花","author":"晏殊","text":"宫后扇开青雉尾，羽人衣剪赤霜文。\n农皇药录真无谓，不向萱丛辩纠纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"煮茶","author":"晏殊","text":"稽山新茗绿如烟，静挈都蓝煮惠泉。\n未向人间杀风景，更持醪醑醉花前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"紫竹花","author":"晏殊","text":"长夏幽居景不穷，花开芳砌翠成丛。\n窗南高卧追凉际，时有微香逗晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禁苑","author":"晏殊","text":"风回玉宇箫声远，日下琼林佩影闲。\n待得年光遍天下，始教春色到人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午作","author":"晏殊","text":"汨渚沉沉不可追，楚人犹自吊湘累。\n灵均未免争琼糈，却道蛟龙畏色丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午词 其四 内廷","author":"晏殊","text":"一一雕盘分楚粽，重重团扇画秦娥。\n宫闱百福逢嘉序，万户千门喜气多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午词 其一 内廷","author":"晏殊","text":"百草斗馀欣令月，五丝萦后祝遐年。\n洞房风暖垂灵艾，神沼波深竞綵船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午词 其二 内廷","author":"晏殊","text":"披风别殿地无尘，辟恶灵符自有神。\n九子粽香仙醴熟，共瞻宸极祝千春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午词 其三 内廷","author":"晏殊","text":"由来佳节载南荆，一浴兰汤万虑清。\n仙苑此时收百药，鍊丹飞石保长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午词 其二 升王阁","author":"晏殊","text":"织组文缯载旧仪，晨朝丹扆奉天慈。\n六斋清素来多福，岁岁今辰侍宴私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午词 其一 升王阁","author":"晏殊","text":"朱邸沐兰逢令节，丹廷祝寿喜嘉辰。\n两宫荣养多延庆，百福潜随命缕新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午词 其一 东宫阁","author":"晏殊","text":"扬子江心铸鉴成，俗传兹日最标灵。\n宣猷视学通文史，问膳多欢奉帝廷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午词 其二 东宫阁","author":"晏殊","text":"百药初收味最良，玉函仍启太清方。\n扇裁葵叶风频度，漏转金胥日更长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午词 其二 御阁","author":"晏殊","text":"初垂彩艾迎新节，复结香茅致百祥。\n就日望云皆善祝，圣人洪算与天长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午词 其一 御阁","author":"晏殊","text":"沐浴兰汤在此辰，内园仙境物华新。\n轻丝五綵缠金缕，共祝尧年寿万春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午词 其三 御阁","author":"晏殊","text":"献寿竞为长命缕，迎祥还佩赤灵符。\n端门漏永晨曦上，飒飒薰风绕帝梧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午词 其二 御阁","author":"晏殊","text":"九子粽新传楚俗，赤灵符验出仙方。\n汉宫尽祝如天寿，鹊尾炉烟起瑞香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午词 其一 御阁","author":"晏殊","text":"五綵丝长系臂初，万年芳树影扶疏。\n岂劳方士标神篆，自有真灵卫帝居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午词 其四 御阁","author":"晏殊","text":"仙家既有灵符术，越俗兼为竞渡游。\n三十六宫迟日永，绮窗朱户彩云浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午词 其四 御阁","author":"晏殊","text":"雕盘角黍竞时宜，组绣风华奉紫闱。\n每日乍升丹禁晓，艾人晴影照金扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午词 其三 御阁","author":"晏殊","text":"乍结香茅祈福寿，更缠金缕贡芳新。\n丹台素有延生箓，岁岁迎祥在此辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题巩县西门周襄王庙","author":"晏殊","text":"人来人去市朝变，山后山前烟雾凝。\n萦带二川河洛水，寂寥千古帝王陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠李阳孙","author":"晏殊","text":"不忍与君别，怜君仁义人。\n三年官满后，依旧一家贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七夕","author":"晏殊","text":"百子池深涨绿苔，九光灯迥绿浮埃。\n天孙宝驾何年驻，阿母飙轮此夜来。\n空外粉筵和露湿，静中珠幌彻明开。\n秋河不断长相望，岂独人间事可哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日宴集和徐通判韵","author":"晏殊","text":"散插黄花两佩萸，粉饘蓬饵釂觞初。\n清歌咽后云生袂，妙舞翻时雪满裾。\n上客采香逢木密，佳人投钓得王馀。\n秋光屈指犹三七，莫向宾朋绮宴疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八日菊","author":"晏殊","text":"瑞蓂才半折，金蕊已争妍。\n幸得重阳近，贪为一日先。\n登高谋宿约，泛酒试芳筵。\n诘旦寻馀馥，明知赏爱偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上元夕次韵答张谏议","author":"晏殊","text":"歌吹欢娱夕，衡门可属垣。\n九城寒漏彻，三市宝灯繁。\n酒想嵇山醉，诗惭谢乐翻。\n如容陪后乘，那避八驺喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋月","author":"晏殊","text":"三十六旬内，此时心赏并。\n中分九秋夜，占断百宵明。\n冷照兰闺澈，光含绮席清。\n谁知沧海曲，珠蚌最盈盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"中秋月 其二","author":"晏殊","text":"天时与人意，龃龉旧无疑。\n坐久翻遗恨，光来已后期。\n行云凝黛色，见跋费金枝。\n况复输来夜，笙歌继夕曦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壬午岁元日雪","author":"晏殊","text":"千门初曙彻星河，飒洒貂裘润玉珂。\n向兽樽前飞絮早，景阳钟后落梅多。\n无声暗重琼林彩，有意微藏璧沼波。\n三殿端辰得嘉瑞，不须庭燎夜如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆临川旧游","author":"晏殊","text":"仲子幽居杳蔼间，回环十亩尽林峦。\n游鱼倒溯清泉急，乳雉惊飞夕烧乾。\n系马短亭乘草茁，携壶芳榭值梅酸。\n浮生莫道今如昨，曷月朋簪争此欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月十八夜","author":"晏殊","text":"槿户茅斋雅自便，京华风味入新年。\n楼台冷落收灯夜，门巷萧条扫雪天。\n病酒不闻花外漏，放朝仍得日高眠。\n何妨静习闲中趣，欲问林僧结净缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"假中示判官张寺丞王校勘","author":"晏殊","text":"元巳清明例未开，小园幽径独徘徊。\n春寒不定斑斑雨，宿醉难禁滟滟杯。\n无可奈何花落去，似曾相识燕归来。\n游梁赋客多风味，莫惜青钱万选才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安昌侯","author":"晏殊","text":"莲勺移家近七迁，鲁儒章句世相传。\n关中沃壤通泾渭，堂上繁声逐管弦。\n身服儒衣同蔡义，日将卮酒对彭宣。\n高坟丈五阳陵外，千古朱云气凛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和天章范待制上元从幸会灵观","author":"晏殊","text":"春莺欲满枝，荷橐从游时。\n旭日生华盖，灵风入羽旗。\n酒含雕玉浅，香度博山迟。\n共识天颜近，都忘昼漏移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和王校勘中秋月","author":"晏殊","text":"广寒仙署惬心期，秋半梧台木叶稀。\n有客正吟星北共，何人重赋鹊南飞。\n光含绮席传三雅，影逗兰房撤九微。\n趋府逸才过鲍掾，不辞终夕赏清晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和史馆吕相公九日偶成","author":"晏殊","text":"凤阙千门制不奢，上公精意在朝家。\n重阳蜜饵承班诏，西苑璆樽辍泛花。\n萧相未央功已半，汉皇宣室宴非赊。\n由来位极妨行乐，目断黄垆酒旆斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初秋宿直","author":"晏殊","text":"绛河星斗夜阑干，禁署沈沈闭九关。\n上帝册书群玉府，仙人宫阙巨鳌山。\n凉蟾影度秋阴薄，促漏声来夜唱闲。\n拥鼻吟多欲愁绝，严钟凄断树乌还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和三兄除夜","author":"晏殊","text":"星汉回曾宇，埙篪集上都。\n夜寒凝爆燎，春气入屠苏。\n九陌传珂乘，千门促漏壶。\n此时开棣宴，仍在碧城隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]