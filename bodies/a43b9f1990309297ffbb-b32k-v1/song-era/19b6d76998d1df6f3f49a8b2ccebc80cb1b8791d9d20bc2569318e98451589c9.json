[{"title":"浮世","author":"陆游","text":"浮世如流水，滔滔日夜东。\n百年均梦寐，万古一虚空。\n青鸟来云外，铜驼卧棘中。\n相逢惟痛饮，令我忆无功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浮生","author":"陆游","text":"浮生真是寄邮亭，短鬓匆匆失故青。\n睡少始知愁有力，病增方叹药无灵。\n谋生懒似逢秋燕，访旧疏于欲旦星。\n自笑若为销此恨，浊醪聊复倒馀瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浴罢","author":"陆游","text":"浴罢淡无事，出门随意行。\n相如知渴减，叔宝觉神清。\n新月参差影，残蝉断续声。\n踌蹰遂忘去，风露欲三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浴罢","author":"陆游","text":"浴罢西轩物色幽，卧看香雾上衣篝。\n半廊月白初侵夜，一叶桐飞忽报秋。\n老觉年光殊衮衮，病知心事断悠悠。\n碧筒且作池边醉，玉色新醅手自篘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浴罢闲步门外而归","author":"陆游","text":"两扇荆扉数掩篱，幽人浴罢得娱嬉。\n南临大泽风来远，东限连山月出迟。\n沙上无泥藤屦健，水边弄影葛巾攲。\n径归却就东窗卧，要及蝉声未歇时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海中醉题时雷雨初霁天水相接也","author":"陆游","text":"羁游那复恨，奇观有南溟。\n浪蹴半空白，天浮无尽青。\n吐吞交日月，澒洞战雷霆。\n醉后吹横笛，鱼龙亦出听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠","author":"陆游","text":"谁道名花独故宫，东城盛丽足争雄。\n横陈锦障阑干外，尽吸红云酒盏中。\n贪看不辞持夜烛，倚狂直欲擅春风。\n拾遗旧咏悲零落，瘦损腰围拟未工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海棠图","author":"陆游","text":"人间奇草木，天必付名流。\n菊待陶元亮，竹须王子猷。\n我为西蜀客，辱与海棠游。\n再见应无日，开图特地愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"消摇","author":"陆游","text":"莫笑茆檐陋，消摇遂野情。\n遇魔增道力，因病悟浮生。\n谋食凭长镵，论交得短檠。\n不知从此去，几见雁南征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"涟漪亭赏梅","author":"陆游","text":"判为梅花倒玉卮，故山幽梦忆疏篱。\n写真妙绝横窗影，彻骨清寒蘸水枝。\n苦节雪中逢汉使，高标泽畔见湘累。\n诗成怯为花拈出，万斛尘襟我自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烧香","author":"陆游","text":"宝熏清夜起氤氲，寂寂中庭伴月痕。\n小斮海沉非弄水，旋开山麝取当门。\n蜜房割处春方半，花露收时日未暾。\n安得故人同晤语，一灯相对看云屯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"爱闲","author":"陆游","text":"今日先生病体轻，爱闲犹有旧心情。\n帖看贞观行间印，琴记中郎爨下声。\n衣焙温温香欲透，雪檐滴滴日初晴。\n客来一笑明窗底，枉道为农事耦耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"爱闲","author":"陆游","text":"爱闲惟与病相宜，壮岁怀归老可知。\n睡熟素书横竹架，吟馀犀管阁铜螭。\n水芭蕉润心抽叶，盆石榴残子压枝。\n堪笑放翁头白尽，坐消长日事儿嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题云门草堂","author":"陆游","text":"小住初为旬月期，二年留滞未应非。\n寻碑野寺云生屦，送客溪桥雪满衣。\n亲涤砚池馀墨渍，卧看炉面散烟霏。\n他年游宦应无此，早买渔蓑未老归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病小减复作三首 其二","author":"陆游","text":"卫养元无术，衰残只自悲。\n扶行十步地，强坐一炊时。\n枕藉漆园语，呻吟栗里诗。\n灾年未易过，那敢望期颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病小减复作三首 其一","author":"陆游","text":"一身真剩长，两月抱沉绵。\n吟作楚人语，耸成山字肩。\n灾从季主卜，药欠宋清钱。\n弥老弥堪笑，藜羹且信缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病小减复作三首 其三","author":"陆游","text":"晨粥半茶碗，秋衣一布裘。\n酒惟诗里见，山向梦中游。\n卜繇儿能测，药方僧为求。\n重阳无半月，尚泥菊花不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病小愈喜晴","author":"陆游","text":"云边采药喜身轻，灯下观书觉眼明。\n扰扰已空浮世事，依依还作苦吟声。\n又为天地几年客，顿觉轩窗三日晴。\n深愧山童怜寂寞，风炉传法煮芜菁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中","author":"陆游","text":"风雨暗江天，幽窗起复眠。\n忍穷安晚境，留病压灾年。\n客助修琴料，僧分买药钱。\n馀生均逆旅，未死且陶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中久止酒有怀成都海棠之盛","author":"陆游","text":"碧鸡坊里海棠时，弥月兼旬醉不知。\n马上难寻前梦境，樽前谁记旧歌辞。\n目穷落日横千嶂，肠断春风把一枝。\n说与故人应不信，茶烟禅榻鬓成丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中久废游览怅然有感","author":"陆游","text":"裘马清狂遍两川，十年身是地行仙。\n归来访旧半为鬼，已矣此生休问天。\n不恨杯觞无藉在，但悲山水旷周旋。\n垂虹风月休如昨，安得青钱买钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中示儿辈","author":"陆游","text":"去去生方远，冥冥死即休。\n狂思攘鬼手，危至服丹头。\n有剑知谁与，无香可得留。\n惟应勤学谨，事事鉴恬侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中戏书三首 其二","author":"陆游","text":"微疾饯馀灾，时须药裹开。\n禽惊杵声去，蜂认蜜香来。\n闭户知长日，全生幸散材。\n晚凉幽兴动，彊到竹边回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中戏书三首 其一","author":"陆游","text":"五十忽过二，流年消壮心。\n避人便小疾，移竹喜微阴。\n洗瓮闲篘酒，焚香静斲琴。\n镜中青鬓在，切莫遣愁侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中戏书三首 其三","author":"陆游","text":"食笋动衰疾，清羸逾两旬。\n药囊随卧起，诗句杂吟呻。\n架足书签蠹，窗凝酒榼尘。\n免从官乞假，且喜是闲身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中杂咏十首 其十","author":"陆游","text":"自我居湖曲，渔樵日往来。\n只知年屡改，不觉老相催。\n小浦潮痕长，长堤草色回。\n逢春心自在，莫道已成灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中杂咏十首 其九","author":"陆游","text":"久病身犹困，闲游性已成。\n未停汤熨事，即理水云程。\n投宿忘街陌，论交失姓名。\n醉怜花坞好，恐是牡丹坪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中杂咏十首 其七","author":"陆游","text":"天远不可问，将如此老何。\n老惊诗思退，贫欠药钱多。\n剡县寻僧宿，桐江买酒歌。\n市桥新柳色，又是一年过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中杂咏十首 其六","author":"陆游","text":"身似头陀不出家，杜陵归老有桑麻。\n茶煎小鼎初翻浪，灯映寒窗自结花。\n残药渐离愁境界，乱书重理淡生涯。\n等闲一事还超俗，断纸题诗字乱斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中杂咏十首 其四","author":"陆游","text":"击壤林间送此生，欣欣东作到西成。\n泥深宿麦苗初长，叶落柔桑眼已生。\n枹鼓无声盗衰息，文书简出吏清平。\n西游携得蹲鸱种，且共山家玉糁羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中作","author":"陆游","text":"床席呻吟里，衡茅隐约中。\n空兴年往叹，未著日新功。\n世远言犹在，身危道岂穷。\n但能无愧怍，天地本来公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中作","author":"陆游","text":"破裘缝更暖，粝食美无馀。\n摩诘病说法，虞卿穷著书。\n身羸支枕久，足蹇下堂疏。\n今日晴窗好，幽怀得好摅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中作","author":"陆游","text":"浮世寄酣枕，劳生居漏船。\n已悲身老大，更著病沈绵。\n亲旧动千里，欢娱无百年。\n床头周易在，端拟绝韦编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中作","author":"陆游","text":"一病二十日，直愁难自还。\n残书不成读，长夜只供闲。\n风舞迎霜叶，云昏欲雨山。\n临窗忽自笑，诗思又相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中作","author":"陆游","text":"老鹤辽天兴未穷，此生光景自匆匆。\n家为逆旅相逢处，身在严装欲发中。\n涩眼尚于书有味，孤愁殊觉酒无功。\n挥戈草檄今谁记，岁晚江边白发翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中作","author":"陆游","text":"苦雨侵衰骨，馀寒著弊裘。\n病多辞社饮，贫甚辍春游。\n日日亲蔬圃，时时弄钓舟。\n回头语造物，与子两无求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中作","author":"陆游","text":"此事明明在默存，一身元有一乾坤。\n不忧竖子居肓上，已见真人出面门。\n力守谁能发底火，深潜自足美灵根。\n用功若到无功处，千载乘云不足言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中夜兴","author":"陆游","text":"病疟秋来久未平，草堂遥夜不胜清。\n疾风递响惊林叶，列宿收芒避月明。\n百计不能逃白发，一生堪笑役虚名。\n钓车且作桐江梦，莫念安西万里行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中夜赋","author":"陆游","text":"客如病鹤卧还起，灯似孤萤阖复开。\n苜蓿花催春事去，梧桐叶送雨声来。\n荣河温洛几时复，志士仁人空自哀。\n但使胡尘一朝静，此身不恨死蒿莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中雨夜","author":"陆游","text":"蹭蹬今如此，沉绵不复支。\n心随形共悴，年与智俱衰。\n雨急孤灯暗，云深断雁悲。\n旧书空满架，惆怅负明时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中思出游","author":"陆游","text":"病境虽犹在，秋天已自清。\n闲思寻酒伴，懒畏主诗盟。\n烟艇桐江去，篮舆剡县行。\n会心随处住，便足了馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中偶书","author":"陆游","text":"灯火青荧古屋深，挂冠境界已骎骎。\n竹枝影瘦横残月，药杵声寒续暮砧。\n病觉死生真大事，老知道德愧初心。\n经龛禅版殊当勉，懒学莎蛩事苦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中偶得名酒小醉作此篇是夕极寒","author":"陆游","text":"一壶花露拆黄縢，醉梦酣酣唤不应。\n屏暖半销香鸭火，窗寒初结研蟾冰。\n诗囊羞涩悲才尽，药裹纵横觉病增。\n早挂朝衣归去是，贵人谁记接茵凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中排闷","author":"陆游","text":"面骨峥嵘鬓雪新，承平版籍有遗民。\n心虽愿继无传学，力不能支已废身。\n开卷眼昏如隔雾，拥炉肺渴欲生尘。\n老庞亦有儿孙念，付与天公不问人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中数辱曾无逸架阁见问今日忽闻徙居走笔奉简因致卜邻之约","author":"陆游","text":"病羸不办揽衣迎，剥啄空惭扣户声。\n凡药岂能驱二竖，清心幸足制三彭。\n巷南僦屋傥可问，岁晚囊衣吾亦行。\n不为朝天愁路涩，夜窗灯火要寻盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中简仲弥性唐克明苏训直","author":"陆游","text":"移疾还家暂曲肱，依然耐久北窗灯。\n心如泽国春归雁，身是云堂旦过僧。\n细雨佩壶寻废寺，夕阳下马吊荒陵。\n小留莫厌时追逐，胜社年来冷欲冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病少愈偶作二首 其一","author":"陆游","text":"萧条白发卧蓬庐，虚读人间万卷书。\n遇事始知闻道晚，抱疴方悔养生疏。\n高门赫赫何关我，薄俗纷纷莫问渠。\n羸疾少苏思一出，夕阳门巷驾柴车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病少愈偶作二首 其二","author":"陆游","text":"病入秋来不可当，便从此逝亦何伤。\n百钱布被敛首足，三寸桐棺埋涧岗。\n但恨著书终草草，不嫌徂岁去堂堂。\n今朝生意才丝发，便拟街头醉放狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病去","author":"陆游","text":"病去身差健，秋高气渐寒。\n未甘常伏几，时作一凭阑。\n玉粒炊粳软，香尘捣药残。\n欣然顾儿辈，灯下语团栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病后自咏","author":"陆游","text":"狂豪扫去得衰残，数啜芳醪兴亦阑。\n闭户交朋疏索尽，捐书日月破除难。\n盘除鲜食生蔬美，衣耸吟肩束带宽。\n赖有一条差自慰，高眠常到日三竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病后衰甚非篮舆不能出门感叹有赋","author":"陆游","text":"酒兴诗情尚自如，形骸可怪顿成疏。\n平生只倚双凫舄，此日常须一鹿车。\n寂寂岂惟惭邓禹，厌厌更觉类曹蜍。\n晚窗弄笔聊湔祓，数首清诗手自书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9857,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病后暑雨书怀","author":"陆游","text":"发毛萧飒疾初平，云物轮囷气未清。\n水涨小亭无路到，雨多幽草上墙生。\n窗昏顿减雠书课，屋老时闻堕瓦声。\n止酒无聊还自笑，少年豪饮似长鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9858,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病后登山亭","author":"陆游","text":"野客双蓬鬓，空山一草亭。\n睡魔欺茗薄，疾竖怯丹灵。\n治世穷冯衍，残年老管宁。\n安居得后死，不敢恨飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9859,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病来","author":"陆游","text":"抱疴虽可验，应接每安徐。\n正使须弹塞，宁当快扫除。\n寡言方祸始，省事养灾馀。\n一饱吾何欠，香粳荐美蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9860,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病足久败游山之兴山中道人多见问戏作示之","author":"陆游","text":"病侵腰股作蹒跚，九折途生布武间。\n东姥自无缘见佛，北公那有力移山。\n买来芒屦真虚费，扶上篮舆亦渐艰。\n赖有舂陵数峰在，虚窗高卧看孱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9861,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病足累日不能出庵门折花自娱","author":"陆游","text":"频报园花照眼明，蹒跚正废下堂行。\n拥衾又听五更雨，屈指元无三日晴。\n不奈病何抛酒盏，粗知春在赖莺声。\n一枝自浸铜瓶水，喜与年光未隔生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9862,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病卧","author":"陆游","text":"病卧东斋怕揽衣，年来真与世相违。\n横林蠹叶秋先觉，别浦骄云暝不归。\n岁月惟须付樽酒，江山竟是属渔矶。\n邻翁一夕成今古，愈信人生七十稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9863,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病卧","author":"陆游","text":"老境偏饶卧，秋天不肯晴。\n愁凭书解散，病仗药支撑。\n果熟鸟乌乐，村深鸡犬声。\n边头定何似，颇说募新兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9864,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病卧","author":"陆游","text":"萧条风雨又经旬，病卧真成不觌邻。\n跨马难酬四方志，耽书空尽百年身。\n碧花引蔓缘疏竹，黄雀呼群啄破囷。\n君见此时风味否，肯辞人笑橐装贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9865,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病疟后偶书","author":"陆游","text":"秋色已萧然，曲肱清夜眠。\n孤灯欺病后，薄酒慰愁边。\n药物从人乞，文章畏客传。\n惟应一篷艇，湖海送凋年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9866,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病疟两作而愈","author":"陆游","text":"久出天魔境，胡为疟鬼来。\n亦知无妄疾，毕竟不为灾。\n引睡须书卷，支羸赖粥杯。\n微风起秋色，樽酒亦时开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9867,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病思","author":"陆游","text":"短发萧萧不满簪，更堪衰疾日侵寻。\n数匙淡饭支残息，一篆清香印本心。\n小径古苔遗鹤毳，空堂坏甃有虫吟。\n悠然更起扁舟兴，秋水门前五尺深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病思","author":"陆游","text":"夜窗孤影怯青灯，瘦著秋衣欲不胜。\n光景正如寒圃蝶，情怀却羡病寮僧。\n篝炉冷落烧残叶，禅榻攲斜倚古藤。\n莫怪颓然遗世事，鬓丝日日镜中增。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病退","author":"陆游","text":"病退身仍健，春回日渐长。\n神诃金鼎药，龙出玉函方。\n美睡三竿日，安禅半篆香。\n残年已如许，幸复起膏肓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病退颇思远游信笔有作","author":"陆游","text":"平日身如不系舟，曾从楚尾客秦头。\n风生江浦千帆晓，月落山城一笛秋。\n万事只能催白发，百年终是卧荒丘。\n扶衰强项君休笑，尚忆人间汗漫游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起","author":"陆游","text":"开岁忽六十，病馀闲炷香。\n春光向客淡，夜漏为愁长。\n已老鸡豚社，永违鹓鹭行。\n苍龙西角月，孤梦堕微茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起","author":"陆游","text":"颓垣破屋暗藜蒿，病起不知秋已高。\n晨倚山楹群木脱，暮临苔砌百虫号。\n力殚编简初何得，腰折尘埃只漫劳。\n赖有浊醪生耳热，狂歌醉草寄吾豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":9873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]