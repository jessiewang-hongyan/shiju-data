[{"title":"秀野以喜无多屋宇幸不碍云山为韵赋诗熹伏读佳作率尔攀和韵剧思悭无复律吕笑览之馀赐以斤斧幸甚 其十","author":"朱熹","text":"清溪何迢迢，上有千仞山。\n山中学仙侣，白石为门关。\n丹经苦吟哦，至道穷跻攀。\n岂知人间世，风尘萦九寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20407,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘秀野蔬食十三诗韵 其一 乳饼","author":"朱熹","text":"清朝荐疏盘，乳钵有真味。\n不用精琼糜，无劳烂羊胃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20408,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘秀野蔬食十三诗韵 其二 新笋","author":"朱熹","text":"翛翛江上林，白日暗风雨。\n下有万玉虬，三冬卧寒土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘秀野蔬食十三诗韵 其三 紫蕈","author":"朱熹","text":"谁将紫芝苗，种此槎上土。\n便学商山翁，风餐谢肥羜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘秀野蔬食十三诗韵 其四 子姜","author":"朱熹","text":"姜云能损心，此谤谁与雪。\n请论去秽功，神明看朝彻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘秀野蔬食十三诗韵 其五 茭笋","author":"朱熹","text":"寒茭翳秋塘，风叶自长短。\n刳心一饱馀，并得床敷软。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘秀野蔬食十三诗韵 其六 南芥","author":"朱熹","text":"黄龙记昔游，园客有佳遗。\n不谓洛生吟，辍餐时拥鼻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘秀野蔬食十三诗韵 其七 ?菜","author":"朱熹","text":"小草有贞性，托根寒涧幽。\n懦夫曾一嘬，感愤不能休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘秀野蔬食十三诗韵 其八 木耳","author":"朱熹","text":"蔬肠久自安，异味非所?。\n树耳黑垂聃，登盘今亦乍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘秀野蔬食十三诗韵 其九 萝卜","author":"朱熹","text":"纷敷剪翠丛，津润擢玉本。\n寂寞病文园，吟馀得深龈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘秀野蔬食十三诗韵 其十 芋魁","author":"朱熹","text":"沃野无凶年，正得蹲鸱力。\n区种万叶清，深煨奉朝食。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘秀野蔬食十三诗韵 其十一 笋脯","author":"朱熹","text":"南山春笋多，万里行枯腊。\n不落盘餐中，今知绿如箦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘秀野蔬食十三诗韵 其十二 豆腐","author":"朱熹","text":"种豆豆苗稀，力竭心已腐。\n早知淮王术，安坐获泉布。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘秀野蔬食十三诗韵 其十三 白蕈","author":"朱熹","text":"闻说阆风苑，琼田产玉芝。\n不收云表露，烹瀹讵相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读秀野刘丈閒居十五咏谨次高韵率易拜呈伏乞痛加绳削是所愿望 其一 秀野","author":"朱熹","text":"为怜蘅芷满芳洲，特地临江赋远游。\n十亩何妨自春色，万缘从此付东流。\n静看朝市真儿戏，须信田园是老谋。\n出处知公有馀裕，未应辛苦谢灵丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读秀野刘丈閒居十五咏谨次高韵率易拜呈伏乞痛加绳削是所愿望 其二 积芳圃","author":"朱熹","text":"乐事从兹不易涯，朱门还似野人家。\n行看靓艳须携酒，坐对清阴只煮茶。\n晓起苍凉承坠露，晚来光景乱蒸霞。\n平生结习今馀几，试数毗那襋上花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读秀野刘丈閒居十五咏谨次高韵率易拜呈伏乞痛加绳削是所愿望 其三 家山堂","author":"朱熹","text":"负米归来手自舂，岂知门外有晴峰。\n羡公竟日尘氛远，拄颊看山幽兴浓。\n心镜悬知不同调，诗坛那敢少争锋。\n空馀远岳寻师意，个里何妨为指踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读秀野刘丈閒居十五咏谨次高韵率易拜呈伏乞痛加绳削是所愿望 其四 拙政堂","author":"朱熹","text":"骥足宁同曳尾龟，青山终是费心期。\n陶公归去有馀乐，潘令闲居不足追。\n自笑十连非所慕，未应三径苦无资。\n明朝谩拥朱轮去，猿鹤咨嗟政尔为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读秀野刘丈閒居十五咏谨次高韵率易拜呈伏乞痛加绳削是所愿望 其五 香界","author":"朱熹","text":"幽兴年来莫与同，滋兰聊欲汎光风。\n真成佛国香云界，不数淮山桂树丛。\n花气无边曛欲醉，灵氛一点静还通。\n何须楚客纫秋佩，坐卧经行住此中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读秀野刘丈閒居十五咏谨次高韵率易拜呈伏乞痛加绳削是所愿望 其六 春谷","author":"朱熹","text":"武夷高处是蓬莱，采得灵根手自栽。\n地僻芳菲镇长在，谷寒蜂蝶未全来。\n红裳似欲留人醉，锦障何妨为客开。\n饮罢醒心何处所，远山重叠翠成堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20426,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读秀野刘丈閒居十五咏谨次高韵率易拜呈伏乞痛加绳削是所愿望 其七 舫斋","author":"朱熹","text":"扁舟容与小房栊，摇飏帘旌蜀锦红。\n两岸蒹葭秋色里，一川烟浪夕阳中。\n不愁滟滪双蓬鬓，未怯江湖万里风。\n筑室水中聊尔尔，何须极浦望朱宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20427,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读秀野刘丈閒居十五咏谨次高韵率易拜呈伏乞痛加绳削是所愿望 其八 药圃","author":"朱熹","text":"种药春畦有近功，不辞耘耔谩劳躬。\n渐看杞菊充庖下，即见芝英入笼中。\n病去自知非往日，身轻何必御泠风。\n出门会有儿童笑，不是当年植杖翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20428,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读秀野刘丈閒居十五咏谨次高韵率易拜呈伏乞痛加绳削是所愿望 其九 山人方丈","author":"朱熹","text":"方丈翛然屋数椽，槛前流水自清涟。\n蒲团竹几通宵坐，扫地焚香白昼眠。\n地窄不容挥麈客，室空那有散花天。\n个中有句无人荐，不是诸方五味禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20429,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读秀野刘丈閒居十五咏谨次高韵率易拜呈伏乞痛加绳削是所愿望 其十 龟峰楼","author":"朱熹","text":"杨柳东边桂树西，小楼晴眺极霏微。\n山川政尔供凝目，尘土何妨略振衣。\n俯瞰桑田悲物化，闲披蕊笈洞玄机。\n却疑栏外连穹石，似厌支床去不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20430,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读秀野刘丈閒居十五咏谨次高韵率易拜呈伏乞痛加绳削是所愿望 其十一 月波台","author":"朱熹","text":"潺潺流水注回塘，中作平台受晚凉。\n四面不通车马迹，一尊聊饮芰荷香。\n韩公无复吟花岛，楚客何劳赋药房。\n少待须臾更清绝，月华零露洗匡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20431,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读秀野刘丈閒居十五咏谨次高韵率易拜呈伏乞痛加绳削是所愿望 其十二 挽蔬园","author":"朱熹","text":"未觉闲来岁月频，荷锄方喜土膏匀。\n连畦已放瑶簪露，覆地行看玉本新。\n小摘登盘先饷客，晚炊当肉更宜人。\n却怜寂寞公仪子，拔尽园蔬不叹贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20432,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读秀野刘丈閒居十五咏谨次高韵率易拜呈伏乞痛加绳削是所愿望 其十三 秋香径","author":"朱熹","text":"门外黄尘没九逵，坊中丛桂长樛枝。\n三秋冷蕊从开落，终岁清阴不改移。\n幽径祇愁空翠滴，浓香一任晚风吹。\n攀援却恨王孙远，惆怅千林□□时。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20433,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读秀野刘丈閒居十五咏谨次高韵率易拜呈伏乞痛加绳削是所愿望 其十四 曲池轩","author":"朱熹","text":"去年种竹长新篁，今岁穿渠过野塘。\n自喜轩窗无俗韵，亦知草木有真香。\n林间急雨生秋思，水面微风度晚凉。\n却厌端居苦无事，凭栏闲理钓丝长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20434,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伏读秀野刘丈閒居十五咏谨次高韵率易拜呈伏乞痛加绳削是所愿望 其十五 前村□","author":"朱熹","text":"玉立寒烟寂寞滨，仙姿潇洒净无尘。\n千林摇落今如许，一树横斜独可人。\n真与雪霜娱晚景，任从桃柳殿残春。\n绿阴青子明年事，众口惊嗟鼎味新。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20435,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秀野刘丈寄示南昌诸诗和此两篇 其一","author":"朱熹","text":"滕王阁下水初生，闻道登临复快晴。\n帝子讵知陈迹在，长江肯趁曲池平。\n山楹雨罢珠帘捲，檐铎风惊玉佩鸣。\n满眼悲凉今古恨，人生辛苦竟何成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20436,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秀野刘丈寄示南昌诸诗和此两篇 其二","author":"朱熹","text":"知向潮边弄碧漪，栏干三抚漾晴辉。\n流传妙语惊离阔，想像清游欲奋飞。\n公去不应停驿骑，我来直欲挂朝衣。\n南州高士何由见，且看新荷出水稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20437,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野韵五首 其一","author":"朱熹","text":"史君帘阁对脩筠，起看名园雨后春。\n便赋新诗留野客，更倾芳酒酹花神。\n未酬管乐平生志，且作羲黄向上人。\n祇恐功名相迫逐，不容老子卧漳滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20438,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野韵五首 其二","author":"朱熹","text":"满园红紫已争新，百啭幽禽亦唤人。\n蜡屐未妨泥步稳，珍丛终恨雨来频。\n卧看晓色忻初霁，起约良游醉好春。\n却笑当年金谷燕，相随仆仆望车尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20439,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野韵五首 其三","author":"朱熹","text":"惆怅春馀几日光，从今风雨莫颠狂。\n急呼我辈穿花去，未觉诗情与道妨。\n萝带不须吟杜若，角弓聊复赋甘棠。\n淋浪坐客休辞醉，饮罢晞身向九阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20440,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野韵五首 其四","author":"朱熹","text":"知君久矣厌喧卑，造物尊前唤小儿。\n一釂未应峨侧弁，十分聊尔快翻卮。\n治中寂寂凝尘日，令尹忧劳退食时。\n正好相寻发孤笑，莫教牢落负心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20441,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野韵五首 其五","author":"朱熹","text":"当年共剪北山莱，脩竹成阴手自栽。\n书卷莫教春色老，柴荆肯为俗人开。\n公能顾我传新句，我欲留公拨旧醅。\n怅望南园芳树底，明年应放小车来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20442,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留秀野刘丈二首 其一","author":"朱熹","text":"好雨当春过一犁，我公远忆故园西。\n孤篷稳转清滩急，十里行穿绿树齐。\n路熟已欣经雾市，身轻未怕蹑云梯。\n诸孙剩欲留公住，细和新诗丐指迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20443,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"留秀野刘丈二首 其二","author":"朱熹","text":"一去屏山今几春，归来三径但荒榛。\n剪除便觉风烟好，徙倚还惊物色新。\n楼外千林遮去路，阶前一水恋行尘。\n劝君更作留连计，同社追游苦未频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20444,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野沧波馆刈麦二诗 其一","author":"朱熹","text":"传闻泛宅贺新成，破月冲烟取次撑。\n鹢首斜飞寒浪急，篷窗侧转好山横。\n知公兴有江湖迥，顾我诗无玉雪清。\n欲跨船舷还未敢，几时得伴镜中行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20445,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野沧波馆刈麦二诗 其二","author":"朱熹","text":"贻牟夙昔但声歌，今见郊园乐事多。\n且喜瓯窭符善祷，未须芦菔颦妖娥。\n霞觞政自誇真一，香钵何烦问毕罗。\n我欲卖刀来学稼，不知还许受廛么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20446,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野躬耕桑陌旧园之韵二首 其一","author":"朱熹","text":"郊园旱久只多蹊，昨夜欣沾雨一犁。\n已办青鞋随老圃，便驱黄犊过深溪。\n农谈剩喜乡邻近，馌具仍教妇子携。\n指点竹寒沙碧处，不知何似锦城西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20447,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野躬耕桑陌旧园之韵二首 其二","author":"朱熹","text":"丈人高致邈难干，云梦何如胸次宽。\n老去未妨诗律在，人来只怕酒杯乾。\n故开麦陇供家酿，更有兰章付客看。\n下走才悭惭嘱和，愿公物色稍留残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20448,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又和秀野二首 其一","author":"朱熹","text":"愁阴一夜转和风，晓看花枝露彩浓。\n觅句休教长闭户，出门聊得试扶筇。\n物华始信如诗好，春色方知似酒浓。\n多谢邻翁笑相迓，为言晴暖更过从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20449,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又和秀野二首 其二","author":"朱熹","text":"江皋晴日丽芳华，翠竹疏疏映白沙。\n路转忽逢沽酒客，眼明惟见满园花。\n望中景助诗人趣，物外春归释子家。\n向晚却寻芳草径，夕阳流水绕村斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20450,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野咏雪韵三首 其一","author":"朱熹","text":"闭门高卧客来稀，起看天花满院飞。\n地迥杉篁增胜概，庭虚鸟雀噪空饥。\n酒肠冻涩成新恨，病骨侵凌减旧肥。\n赖有袁生清兴在，忍寒应未泣牛衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20451,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野咏雪韵三首 其二","author":"朱熹","text":"一夜同云匝四山，晓来千里共漫漫。\n不应琪树犹含冻，翻笑杨花许耐寒。\n乘兴正须披鹤氅，瀹甘犹喜破龙团。\n无端酒思催吟笔，却恐长鲸吸海乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20452,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野咏雪韵三首 其三","author":"朱熹","text":"开门惊怪雪交加，乱落横飞讵有涯。\n密竹不妨呈劲节，早梅何处觅残花。\n山阴客子须乘兴，洛下先生想卧家。\n病废杯觞寒至骨，哦诗无复更豪誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20453,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵雪后书事二首 其一","author":"朱熹","text":"晴烟袅袅弄晨炊，雪屋流澌未觉迟。\n拟挈冻醪追胜践，聊穿蜡屐过疏篱。\n扫开折竹仍三径，认得残梅祇数枝。\n不耐岁寒心事苦，滔滔欲说定从谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20454,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵雪后书事二首 其二","author":"朱熹","text":"未觉春光到柳条，谁教飞絮倚风摇。\n眼惊银色迷千界，梦断彤庭散百寮。\n梅坞任从长笛弄，竹窗闲把短檠挑。\n何人剥啄传清唱，更喜残年乐事饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20455,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵秀野早梅","author":"朱熹","text":"可爱红芳爱素芳，多情珍重老刘郎。\n疏英的皪尊中影，微月黄昏句里香。\n胸次自怜真玉雪，人间何处有冰霜。\n巡檐说尽心期事，肯醉佳人锦瑟傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20456,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野极目亭韵 其一","author":"朱熹","text":"偶向新亭一破颜，高情直寄有无间。\n地偏已隔东西路，天阔长围远近山。\n浩荡只愁春雾合，轮囷却喜暮云还。\n不堪景物撩人甚，倒尽诗囊未许悭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20457,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野极目亭韵 其二","author":"朱熹","text":"坐看山花落幔颜，不知身在翠云间。\n食寒到处雨复雨，客里归来山又山。\n□□孤灯闲□□，无心栖鸟暮忘还。\n世情分逐流年去，只有诗情老更悭。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20458,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野春晴山行纪物之句","author":"朱熹","text":"祇凭诗律作生涯，到处山林总是家。\n便与清尊卧芳草，不妨皂盖拂残花。\n侧闻温诏询耆艾，好趁春风入殿衙。\n回首能忘旧猿鹤，一篇聊尔记年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20459,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用韵题翠壁","author":"朱熹","text":"孤亭一目尽天涯，俯瞰烟村八九家。\n翠壁何年悬布水，绿阴经雨堕危花。\n杖藜徙倚凝春望，觅句淹留到晚衙。\n珍重诗翁莫相恼，枯肠搅断鬓丝华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20460,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次亭字韵诗呈秀野丈兼简王宰三首 其一","author":"朱熹","text":"不驾朝车叩九扃，独携灵寿向新亭。\n人言洞里春长在，自庆樽前老复丁。\n鱼乐波闲诗欲就，鸿冥天阔酒初醒。\n晚来却向南堂坐，珍重家山数点青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20461,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次亭字韵诗呈秀野丈兼简王宰三首 其二","author":"朱熹","text":"吏散庭空昼掩扃，行春只到柳边亭。\n唱酬共喜摛鸿藻，来往何劳笑白丁。\n一笑歌呼从自醉，几年燠暍为谁醒。\n定知细札褒扬后，名入麟台汗简青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20462,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次亭字韵诗呈秀野丈兼简王宰三首 其三","author":"朱熹","text":"几年寂寞掩柴扃，抱膝长吟竹下亭。\n不向参同论纳甲，且将耘耔付添丁。\n思玄赋罢惊遥举，止酒诗成恨独醒。\n却笑春风两蓬鬓，飘萧无复旧时青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20463,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次山行佳句呈秀野丈三首 其一","author":"朱熹","text":"几日春阴锁翠岩，忽惊飞盖度晴岚。\n身轻似起烟霞痼，意适宁论禄位贪。\n句法旧超常语六，年华今富达尊三。\n从容笑语无馀事，兴在南山更向南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20464,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次山行佳句呈秀野丈三首 其二","author":"朱熹","text":"几杖归来觅故岩，眼中犹记旧烟岚。\n诗情自昔元无敌，世味而今更不贪。\n默数流年欣望八，闲寻隐诀话存三。\n小生自愧衰颓早，个里凭公为指南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20465,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次山行佳句呈秀野丈三首 其三","author":"朱熹","text":"曈曈朝日出高岩，簌簌征衣曳晓岚。\n□□向来孤旧意，林泉老去觉真贪。\n凄凉烟火一百五，零落交游十二三。\n叹□□□□世事，卧吹横笛过溪南。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20466,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野泛沧波馆至赤石观刈早稻韵","author":"朱熹","text":"绿云黄半武夷乡，碧水萦纡一带长。\n闻道放船飞皂盖，定知行酒载红裳。\n棹讴如贺丰年信，乐饮闲酬此日凉。\n禾忝谁言不阳艳，晚炊流咏有馀香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20467,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秀野韵题卧云庵","author":"朱熹","text":"君家丘壑本圆成，何意寻荒入翠屏。\n为爱晴云荐孤枕，故将闲日付新亭。\n梦魂寂寂衣裳冷，心事悠悠简策青。\n更把枯桐写奇趣，鹍弦寒夜独泠泠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20468,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉和秀野见留之句","author":"朱熹","text":"闲卧秋山尘事稀，西风催唤出岩扉。\n来看甲第清泉好，更喜仙翁丹颊肥。\n扪虱坐谈端未厌，连环入梦却思归。\n明朝振策千峰顶，满袖琼琚背夕晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20469,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]