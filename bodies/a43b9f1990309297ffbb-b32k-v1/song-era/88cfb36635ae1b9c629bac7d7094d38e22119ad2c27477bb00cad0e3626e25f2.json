[{"title":"笔 其一","author":"吴惟信","text":"早露锋铓获见寻，最于文苑用功深。\n弃捐应只分毫事，谁肯留连一寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31310,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"笔 其二","author":"吴惟信","text":"锋芒虽早露，用舍见升沉。\n白秃千茎发，丹留一寸心。\n策勋芸阁久，洁己石潭深。\n却笑江淹辈，区区梦里寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31311,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中闻笛","author":"吴惟信","text":"霜竹凄清带雨喷，湿烟粘草近黄昏。\n谁教吹暗千林绿，不道飞花正断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31312,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"严陵道中 其一","author":"吴惟信","text":"长安回首远，渐渐近严陵。\n客梦春江橹，乡心野店灯。\n路行三百里，山看万千层。\n处处皆幽胜，题诗愧不能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31313,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"严陵道中 其二","author":"吴惟信","text":"自信平生命，羁孤竟未通。\n春烟行路远，夜雨客房空。\n道术徒稽古，人心不重穷。\n好山何日买，清梦鸟声中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31314,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"严陵道中 其三","author":"吴惟信","text":"祇见青山不见家，石栏空倚夕阳斜。\n梅花欲尽东风急，春事看看到杏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31315,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"严陵道中 其四","author":"吴惟信","text":"抛书闲倚店家门，往事关心孰共论。\n燕子未归春尚冷，一帘细雨湿黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31316,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"严陵道中 其五","author":"吴惟信","text":"漠漠春云暗钓台，云拖雨脚过山来。\n客中心事深于海，小立东风看落梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31317,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乌龙道中","author":"吴惟信","text":"萧瑟江梅堕晚风，桃花红尽杏花红。\n家山不见空回首，一片春愁细雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31318,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苏堤 其一","author":"吴惟信","text":"自向桃源失意回，人间无地避风埃。\n六桥雨雪孤山路，不为梅花也不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31319,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苏堤 其二","author":"吴惟信","text":"贫况今年极向年，过湖尚欠买船钱。\n步行自行苏堤去，恐有沙鸥在柳边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31320,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山中","author":"吴惟信","text":"石壁飞泉洒不乾，松阴满目寺门寒。\n梅花开尽无人到，万叠春山独自看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31321,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题台州巾峰","author":"吴惟信","text":"寺在烟云表，登临思豁然。\n绝怜千嶂月，曾照一诗仙。\n眼阔疑遗世，身高见尽天。\n孤吟功未到，待借竹房眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31322,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖上","author":"吴惟信","text":"湖上风烟古，今朝又一行。\n天寒吟诗苦，岁晚客心惊。\n饥雀窥梅瘦，翔鸥傍柳明。\n惜无人在眼，细细说平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪后孤山","author":"吴惟信","text":"断碑孤冢树苍苍，鹤自飞归道士房。\n春在梅花寻不见，满山残雪只闻香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日道中","author":"吴惟信","text":"水边篱落总斜曛，策策西风捲白云。\n万里秋光人不管，蓼花桐叶自平分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初春湖上","author":"吴惟信","text":"薄薄晴烟锁六桥，酒旗无力任西飘。\n眼前春意知多少，尽属梅梢与柳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31326,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日湖上 其一","author":"吴惟信","text":"傍水秋千柳影遮，衔泥双燕入谁家。\n空山雨过晚风急，吹落墙阴红杏花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31327,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日湖上 其二","author":"吴惟信","text":"柳絮漫空雪样轻，梨花风起近清明。\n山南山北游人闹，屋后屋前春鸟鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31328,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹 其二","author":"吴惟信","text":"耐久相看是此君，眼前才有便无尘。\n尽多转好延留客，虽少犹能爽快人。\n清影疏疏垂地面，高标直直上云津。\n忍饥食肉俱休学，一击从今认所真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31329,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹 其三","author":"吴惟信","text":"天下清高物，无过是此君。\n托根才有地，长节便摩云。\n翠色晴时见，愁声雨夜闻。\n粉痕如早脱，龙化复何云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31330,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新竹","author":"吴惟信","text":"绿玉初抽粉尚深，清风便伴此君吟。\n虽然未见凌霜操，已是先虚应物心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31331,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山梅","author":"吴惟信","text":"寒锁孤山见所长，断桥水冷月如霜。\n自将一点春风恨，散作黄昏万斛香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31332,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瓶中落梅","author":"吴惟信","text":"□英雪粲去难招，遗粉馀香亦暗消。\n休说惜春人未老，小窗明月梦无憀。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"掀蓬梅","author":"吴惟信","text":"断桥日老水瀰茫，谁托丹扉夜望长。\n零雪正埋和靖骨，淡烟微见寿阳妆。\n一时韵巧传清思，几度凝愁忆暗香。\n举世可无题品手，擅场到底属何郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和友人玉簪花韵","author":"吴惟信","text":"一撒轻云埋晓凉，等闲曾入汉宫庄。\n千年抛掷瑶池远，化作云阶月地香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"良月对菊","author":"吴惟信","text":"唐人十日咏，早有怨人心。\n况在严霜后，犹开满地金。\n远香秋梦断，艳色雨吟深。\n未信渊明死，寥寥无赏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寻梅","author":"吴惟信","text":"春山合碧映春泉，今日寻梅忆去年。\n阴径谁知藏造化，晴花一树锁寒烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野步寻梅","author":"吴惟信","text":"夕阳一半落群峰，寒叶零霜野望空。\n阴谷忽然逢造化，小梅枝上见春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饯梅","author":"吴惟信","text":"半逐清流半委尘，残花枝上又纷纷。\n晚来犹自东风恶，吹得幽香满涧云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中对梅寄何户曹 其一","author":"吴惟信","text":"颇爱连山雪映溪，南枝休笑北枝低。\n扬州有客同吟咏，湖上何人更品题。\n云未商量春后雪，花先零落雨中泥。\n清愁一点无归着，回首东风起杖藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中对梅寄何户曹 其二","author":"吴惟信","text":"休说登山与绕溪，林间曾见入檐低。\n尽开花去浑如雪，忽有香来即是题。\n九客不容同气味，六宫回首隔云泥。\n策勋商鼎何愁晚，幽意分明在短藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杜鹃","author":"吴惟信","text":"锦江宫苑已成尘，啼血千年恨益深。\n月满空山花满地，一声愁杀未归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孤雁 其一","author":"吴惟信","text":"成行远远别衡阳，岂道如今却断行。\n声咽为啼千嶂月，翅低因负五更霜。\n虽云传信元无托，纵不遭烹亦可伤。\n遥相倦飞沙上去，芦花吹雪水茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孤雁 其二","author":"吴惟信","text":"饮啄堪怜久弗齐，念群零落楚云西。\n羽翰纵有飞高势，月满芦花又独栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨夜闻猿","author":"吴惟信","text":"山风吹满石床云，花落红缸夜欲分。\n唤起十年乡国恨，一声猿向雨中闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"空斋","author":"吴惟信","text":"空斋日日清吟过，溪上梅开也不知。\n坐久正愁炉火冷，北风吹折蠹杉枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"多景楼","author":"吴惟信","text":"此地昔曾游，今朝复上楼。\n江枫秋雨过，塞草夕阳愁。\n渡急传邮箭，沙危阁战舟。\n栏干空自倚，何许是神州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书山家","author":"吴惟信","text":"山家元住石桥西，篱落周遭尽药畦。\n剥啄柴门人未应，鹧鸪飞上野棠梨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31348,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次妙上人山居韵","author":"吴惟信","text":"茅宇无人过，荆扉尽日关。\n酒中生快乐，诗里着清闲。\n朋友数竿竹，画图千叠山。\n何如终隐此，尘境莫思还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31349,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"村居","author":"吴惟信","text":"喜得身闲散，村居尽不妨。\n花开和蝶看，酒熟带醅尝。\n草径偏临水，柴门正向阳。\n故交应笑我，近日学耕桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31350,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山庵即事","author":"吴惟信","text":"阴阴定是过残年，积雪才晴又满天。\n山寺寻梅谁怕冷，地炉烧竹自无烟。\n斋蔬清洁朝朝食，诗草纵横日日编。\n更有身心空寂处，夜禅多在佛灯前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31351,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日闲居","author":"吴惟信","text":"急雨开新霁，薰风献嫩凉。\n苔花侵画壁，云叶护书床。\n枕上青山远，诗中白昼长。\n地偏人不到，幽鸟语脩篁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31352,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日书壁","author":"吴惟信","text":"开尽桃花落尽梅，衡门寂寂掩苍苔。\n多情惟有双飞燕，不道人贫便不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31353,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"凤凰台怀古","author":"吴惟信","text":"凭高北望旧神州，江绕秦淮万古流。\n塞草寒沙埋战血，更无林叶共伤秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31354,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隐居 其一","author":"吴惟信","text":"床有诗书壁有琴，翠筠佳木午窗阴。\n只因知得清闲贵，是事从今不动心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31355,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隐居 其二","author":"吴惟信","text":"身居脩竹茂林间，婆饼声中白昼闲。\n此地遁潜无不可，何须更买沃洲山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31356,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题冰壶隐居","author":"吴惟信","text":"平生以笔代耕耘，老矣营居志亦勤。\n送子谁为盘谷序，招贤亲草北山文。\n湖鸥近屋拳秋雨，野鹤分松宿暮云。\n从此只寻闲处去，红尘一语自纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31357,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题李师德书楼","author":"吴惟信","text":"楼高山对起，天予逸人居。\n万事不到处，满床皆是书。\n风云知远大，日月付乘除。\n眇眇新吟思，谁怜合古初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31358,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题刘同卿九里松熙游园","author":"吴惟信","text":"胜槩未教容易见，必须委曲一登跻。\n到天不觉乘槎远，出洞方知采药迷。\n柳舞莺啼春雨过，花香人醉夕阳低。\n规模尽可垂千古，却恐无诗为品题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邮亭书怀","author":"吴惟信","text":"晚向邮亭立，原荒草树稀。\n天随云气变，雨带雪花飞。\n客鬓今年白，故园何日归。\n知音空满眼，范叔自无衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31360,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过朴翁故居","author":"吴惟信","text":"电露荣华一梦休，琴书多是越僧收。\n年年柳下游人过，指点春风认竹楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31361,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"幽居遣怀","author":"吴惟信","text":"百年身已任浮沉，但得幽居不厌深。\n鹤立庭阶花寂寂，莺声池馆柳阴阴。\n看书消豁三竿日，琢句驱驰一寸心。\n莫为无才人所弃，携壶野逸自相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31362,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明山楼即事","author":"吴惟信","text":"城高楼又阔，不与别楼同。\n对此山千叠，陶然圣一中。\n秋声争起树，野色半沉空。\n后有登临约，留题愧未工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31363,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书酒楼壁","author":"吴惟信","text":"春光知我上高楼，楼外飞花逐水流。\n蜀魄一声云尽碧，淡烟芳草夕阳收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31364,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题月窗","author":"吴惟信","text":"中宵浩彩泼苍冥，人静棂空物象清。\n若以升沉为得失，求之见识却分明。\n烟迷野草牛先喘，露滴檐枝鹊自惊。\n此地琢磨功业就，昌黎合弃短长檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31365,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古寺 其一","author":"吴惟信","text":"古院无人至，闲门晓亦开。\n山獐攲定石，野蚁集生台。\n春动烟浮树，阴庭雪缀苔。\n午窗幽梦断，万籁发清哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31366,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古寺 其二","author":"吴惟信","text":"山烟藏古寺，鸱殿与云齐。\n松鼠下阶走，竹鸡当户啼。\n泉寒飞瀑远，僧老诵经低。\n细读苔碑了，东风起杖藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31367,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"废寺","author":"吴惟信","text":"山烟寒似暝，鸱殿与云齐。\n栗鼠下阶走，竹鸡当户啼。\n碑荒文字古，僧老语言低。\n欲住嗟无计，斜阳映杖藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31368,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题僧兄山居","author":"吴惟信","text":"白发萧萧万事忘，安闲过似老渔郎。\n半窗残日敲棋响，一院秋风捣药香。\n浇菊旋分苔涧水，开松新架草堂凉。\n过从皆是诗朋友，开口何曾论短长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31369,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次僧兄山居韵 其一","author":"吴惟信","text":"僧兄肥遁地，正在太湖头。\n新句老而健，一钱贫不留。\n寡交山自看，多病药相投。\n终日书堂坐，风筠冷似秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31370,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次僧兄山居韵 其二","author":"吴惟信","text":"素抱居山志，今番始有涯。\n琴床临砌竹，棋局近庭花。\n诗兴常便酒，蔬肠渐畏茶。\n清闲兄自乐，世事绝无些。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31371,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日书僧舍壁 其一","author":"吴惟信","text":"一宿山中万虑忘，石泉声细鸟声长。\n落花满地游人去，寂寞棋窗又夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日书僧舍壁 其二","author":"吴惟信","text":"松风声里草堂幽，欲问归津又小留。\n人自看诗春自老，毋烦海燕说闲愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲居即事书僧舍壁","author":"吴惟信","text":"自说居山好，多年静掩扉。\n松阴围坐石，苔色上禅衣。\n鹤瘦迎风舞，云闲带雨归。\n地幽人事断，客至亦忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31374,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿馀晖庵","author":"吴惟信","text":"庵在村烟底，除非到者知。\n因投今夜宿，记得去年诗。\n窗外雨犹滴，佛前灯未吹。\n无人同淡话，看杀菊花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31375,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送北涧常州住院","author":"吴惟信","text":"一生玉雪照人间，古意因君唤得还。\n丹凤未应栖恶木，白云又见出空山。\n吟分柳色春风暖，船载梅花月夜闲。\n从此共谁歌大雅，羁孤寒影欲追攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31376,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"下竺后塔","author":"吴惟信","text":"僧持咒语下层峦，远客无言自倚栏。\n龙带雨归阴洞暗，鹤冲烟入暮松寒。\n奔腾瀑布穿云落，断裂碑文刮藓看。\n未有因缘来此住，三生石上指空弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31377,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登下竺塔","author":"吴惟信","text":"浮图灵鹫上，迢递入晴氛。\n绝顶我忽到，下方钟屡闻。\n林深馀腊雪，谷暖涨春云。\n更待溪梅发，相期一访君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31378,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送人之姑苏","author":"吴惟信","text":"鹤唳空山晓，凝情畏别离。\n且知君返日，正是我行时。\n花月吴城梦，松风竺寺时。\n暮云空自隔，初不隔相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31379,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送友上边","author":"吴惟信","text":"壮年游远塞，失意去从军。\n剑在犹凝血，家空未策勋。\n乡心悬夜月，杀气暗秋云。\n近日方知命，兵书欲尽焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31380,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送冯中可讷上边","author":"吴惟信","text":"兵法通儒用，观光上玉京。\n一言旋造化，万古立功名。\n剑入边云静，船开江月明。\n深知有志者，不肯负平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31381,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送陆居士归天台","author":"吴惟信","text":"道貌尘中见，何时下翠萝。\n闲情秋水淡，归梦白云多。\n缨过龙湫濯，诗当雁荡歌。\n清豪不易得，一别又如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31382,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]