[{"title":"废居行","author":"谢翱","text":"海涛翻空秋草短，白蛇入窠啖雀卵。\n经年废屋无居人，孕妇夜向船中产。\n归来多雨臼生鱼，穴虫祝子满户枢。\n邻家置屋供官役，买得沂王园令宅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36052,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古钗叹","author":"谢翱","text":"刑徒鬼火去飘忽，息妇堆前殡齐发。\n白烟泪湿樵叟来，拾得慈献陵中发。\n青长七尺光照地，发下宛转金钗二。\n持归薰沐置高堂，包裹恐为神所将。\n妻儿朝拜复莫拜，冉冉卧病不得瘥。\n省知天物厌凡庸，夜送白龙潭水中。\n扣头却顾祈免死，永入幽宫伴龙子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36053,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"双桐生空井","author":"谢翱","text":"风飘白露井梧落，叶上丸丸缀灵药。\n琴枝连理凤鸣晨，辘轳双转银瓶索。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36054,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"飞来双白鹤","author":"谢翱","text":"飞来缥缈立在门，噣衔竹花臆欲言。\n雄雌来去眼如雾，客已彷佛知其人。\n笙箫忽远不知处，知在云窗与绿户。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36055,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山中曲拟张司业","author":"谢翱","text":"夕烟沉，曙烟起。\n野爨湿茫茫，空竿弄尘水。\n栟榈倚西南云，生叶团团如车轮。\n桑弓蓬矢半刀笔，去者送尽无来人。\n扪萝恸哭衫袖冷，白首空回扫山影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36056,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"远游篇寄府教景熙","author":"谢翱","text":"朝游扶桑根，不折拂日枝。\n莫食楚萍实，掬海见虹霓。\n黄鹄别我影，目尽汉水湄。\n况复衔其子，风露何当归。\n飘萧软桂丛，零落紫苔衣。\n梦魂知尔处，落羽在瑶池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36057,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"峨眉老人别子歌","author":"谢翱","text":"峨眉有老人，奉命过嵩少。\n天风吹西翼，冉冉明夕照。\n湿尘纷堕天，发白更待报。\n有子为异物，不得入家庙。\n恸哭东南云，相望沧海峤。\n青鸟年年来，寄书久不到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36058,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"琼花引","author":"谢翱","text":"后土祠前车马道，天人种花无瑶草。\n英云蕊珠欲上天，夜半黄门催进表。\n酒香浮春露泥泥，二十四桥色如洗。\n阴风吹雪月堕地，几人不得扬州死。\n孤贞抱一不再识，夜归阆风晓无迹。\n苍苔染根烟雨泣，岁久游魂化为碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36059,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"短歌行","author":"谢翱","text":"秦淮没日如没鹘，白波摇空湿弦月。\n舟人倚棹商声发，洞庭脱木如脱发。\n寒螀哀啼众芳歇，晨梳青林望吴越。\n吴歈越吟浪花舞，秋槎湿剑归无所。\n愁生酒醒闻山鸡，石镜飞花汗如雨。\n起招如意击树枝，为君悲歌君泪垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36060,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日拟塞上曲","author":"谢翱","text":"落日墩堭北，妖星太白西。\n凉风吹沙碛，帐下玉人啼。\n吹沙复吹草，嘶马未知道。\n醉后闻塔铃，胡天忽如扫。\n野驼寻水向月行，露下胡儿食秋枣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36061,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故园秋日曲四首 其一","author":"谢翱","text":"空园久闭无人住，城乌应入巢其树。\n食尽满园绿荔枝，引雏飞去人始知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36062,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故园秋日曲四首 其二","author":"谢翱","text":"茅茨竹外烟火青，杉鸡啁哳向田鸣。\n家家红盐殷新杵，绿树裹创子如雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36063,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故园秋日曲四首 其三","author":"谢翱","text":"龙蛇已去荒窟宅，翻藕人人下剑池。\n岸池藕尽无浮叶，惟有青青榕树枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36064,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故园秋日曲四首 其四","author":"谢翱","text":"粤王山下雾如雨，吹入罗襟楚女啼。\n身逐千艘落南去，惟有樯乌飞向西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36065,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咄咄复咄咄","author":"谢翱","text":"咄咄复咄咄，野风吹云起草垡。\n竹尘阴阴不见山，鸡飞上树海没鹘。\n人间旧事新白头，淮南小儿未识愁。\n淮南老翁叫无力，瓦盆盛水看日食。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36066,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桂花引","author":"谢翱","text":"风生河汉吹鸣珰，桂宫神斧伐远扬。\n西游真人得奇曲，九门不锁天雨霜。\n人间青烟湿尘鞚，药臼嵯峨压天梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36067,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赋得建业水","author":"谢翱","text":"建业水，秋风动扬子。\n鱼龙夜落星斗南，潮没潮生苍鹘起。\n他年冠盖物具美，风吹小船入城市。\n潮去不来风日死，白浪黄尘烟雾里。\n中有长鱼食鳣鲔，解后食鱼何处是。\n西上国门望武昌，风雨徙鱼来汉阳。\n武昌鱼劳聚寒椮，太白入月鱼脑减，武昌城头鼓紞紞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36068,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赋得北府酒","author":"谢翱","text":"北府酒，吹湿宫城柳。\n柳枝著地春垂垂，祇管人间新别离。\n离情欲断江水语，女儿连臂歌白纻。\n淮南神仙来酒坊，甲马猎猎羽林郎。\n百年风物烟尘苍，老兵对月犹举觞。\n青帘泪湿女墙下，曾识行军旧司马。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36069,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"楚女谣","author":"谢翱","text":"楚山萧萧吹绀发，楚女采莲歌夜发。\n年年种菂迟成藕，水深拔根丝在手。\n悬房学茧秋雨多，化为魂梦巢蜂窠。\n前花作实采已尽，后花尚蕊船未过。\n昨昔浮萍随涨水，湿紫寒青裹莲蕊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36070,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"后琼花引","author":"谢翱","text":"扬州城门夜塞雪，扬州城中哭明月。\n堕枝湿云故鬼语，西来阴风无健鹘。\n神娥愬空众芳歇，一夕苍苔变华发。\n宫花窣帘尘掩袜，玉华无因进吴越。\n漓漓淮水山央央，谁其死者李与姜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36071,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邳州哭","author":"谢翱","text":"邳州哭，井水竭，去年哭母瘴海热。\n今年此日来邳州，母死未禫子为囚。\n邳州土湿泪长在，化为苍苔色不改，雨洗游魂归瘴海。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36072,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋风海上曲","author":"谢翱","text":"秋风吹水龙上天，龙女抱珠海底眠。\n水花生云起如葑，神龙下宿藕丝孔。\n巨鳌赑屃鼍鼓随，赤鱼鳞鬣陈旌旗。\n海人见此失操纲，归对妻儿月下纺。\n自言移家来碛中，十载秋风潮不上。\n老夫一人语门前，见此已是开皇年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36073,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明河篇","author":"谢翱","text":"牵牛夜入明河道，泪滴相思作秋草。\n婺女城头玩月明，星君冢上无啼鸟。\n天寒露净沾衣巾，明河倏化为白云。\n云飞蜿蜿秋在水，石压槎头海烟起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36074,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"射鸠行","author":"谢翱","text":"少年操弩挟两矢，朝射青鸠暮射雉。\n人言雊雉蛇所化，欲食踌躇箸不下。\n街头得钱争买鸠，网林抉薮无时休。\n老父劝儿食且止，燕安有毒况珍美。\n尔不见鸠食半夏鸣尔屋，尔毋食鸠有药毒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36075,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"虞美人草词","author":"谢翱","text":"髑髅起语鸱叫啸，山精夜啼楚王庙。\n渡淮风雨八千人，叱咤向天成白道。\n身经百战转危亡，很籍悲歌出汉堡。\n夜帐天寒抱玉泣，血变草青烟晓湿。\n他年辟仇春草生，吴中草死无妾名。\n自从为草生西楚，得到吴中犹楚舞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36076,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘寄奴草词","author":"谢翱","text":"榛中小草夏蔚荟，叶如牡艾花如毳。\n少年防塞得命生，出镞肉中无粟起。\n向来神奸见白昼，湿竹烟青闻杵臼。\n英雄奋臂徵此时，唾落虚空散林薮。\n汉家白蛇入本纪，况是天王旧支子。\n岂知苗裔在民伍，蛇鬼犹呼帝小字。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36077,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中怨","author":"谢翱","text":"妾在江南家楚东，忆君月落雨声空。\n夜来入梦君无语，落月同看雨不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36078,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陌上桑","author":"谢翱","text":"旭日曈昽飏拂羽，落葚空条生晓雾。\n人生颜色逐春妍，夏叶喂蚕少丝缕。\n兰膏照茧未登簇，露湿头梳惟水沐。\n却怜邻女学鍊真，药炉七过煮桑薪。\n纵逢萧史上天去，瓮盆生苔愁杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36079,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"折杨柳","author":"谢翱","text":"月时折柳江头别，春去来看柳上月。\n翠翎小鸟巢短枝，巢老重重编败发。\n人生贫贱多别离，巢中发密妾发稀。\n人生富贵能几时，年年柳色青绿垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36080,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"废瑟词","author":"谢翱","text":"发埋空山贩缯客，草中惟弃秦时瑟。\n樵夫拾置贻乐工，朱徽作弦如墨色。\n自从汉曲入铙歌，清庙无人传不得。\n至今崔嵬声已死，越■春虫闻咒子。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36081,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"飞仙引游沃州水帘谷作","author":"谢翱","text":"赤城后门桃花尾，湿浸蘼芜洗苍耳。\n小支菩提海上来，天风吹下谷帘水。\n斜珠界左转复右，华盖县肝三叶紫。\n内间肉芝承乳流，鬼母仙姝临洗胃。\n苍龟守关朝太微，色阻谗神诬奏事。\n海桑男子在谪籍，驱鹿行车闰年至。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36082,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"樊夫人上升词","author":"谢翱","text":"石蚝粘窗秋见海，山鸡夜啼弄毛彩。\n王孙吹笙导夫人，青发凌风素霞在。\n雨尘离地白浩浩，河西种星榆树老。\n海桑童童日出归，衣湿上池洗头草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36083,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"侠客吴歌立秋日海上作","author":"谢翱","text":"潮动秋风吹牡荆，离歌入夜斗西倾。\n佽飞庙下蛇含草，青拭吴钩入匣鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36084,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岛上曲二首 其一","author":"谢翱","text":"皮带墨鳞身卉衣，晚随鬼渡水灯微。\n石门犬吠闻人语，知在海南种蛤归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36085,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岛上曲二首 其二","author":"谢翱","text":"夫招贾客岁经辽，自到城中卖织绡。\n却买铅华采珠母，槟榔露下月中调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36086,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"落梅词","author":"谢翱","text":"北风花糁枝，春风花糁衣。\n青鸟梦中见，畏来花下飞。\n岂是得春迟，因缘别春早。\n夜湿灞陵苔，半在古驰道。\n入瓦雪冥冥，离树香草草。\n那无返魂术，不忍见春老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36087,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"望蓬莱","author":"谢翱","text":"青枝啼鸟波延延，方士指海谈神仙。\n五云垂天光属夜，老父相传说车驾。\n千官此地佩宛宛，舟发黄门止供顿。\n绕樯赤日护龙旗，西北驿书驰羽箭。\n百年尘空沧海晚，月落无人度灞浐。\n鸡鸣白石烂如银，蓬莱不见夷州远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36088,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"结客行","author":"谢翱","text":"结客卫京师，弃家南斗陲。\n相看各意气，欲取辽阳归。\n事左脱身去，岂为无所为。\n家藏楚王子，手执五陵儿。\n泣奉先主令，白旗向天挥。\n鞭尸雠必报，函首捷终驰。\n力尽志不遂，以死谢渐离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36089,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古别离","author":"谢翱","text":"仙人别母母哭啼，遗以神药乃醉之。\n醒来哭定记儿语，食此庭前双橘树。\n叶能禦饥病能愈，岂似当时逐儿去。\n邻翁有女立我前，取刀剖腹尔勿怜。\n但尔嫁夫能治田，生子不愿生神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36090,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"花卿冢行","author":"谢翱","text":"湿云模糊埋秋空，雨青沙白丹陵东。\n莓苔阴阴草茸茸，云是花卿古来冢。\n花卿旧事人所知，花卿古冢知者谁。\n精灵未归白日西，庙鸦啄肉枝上啼，绵州柘黄魂正飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36091,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和靖墓","author":"谢翱","text":"山中处士白麻履，死后无书献天子。\n青童玄鹤昼上天，夜下玉棺葬湖水。\n湖堤四合葑如发，芳树玲珑倚春雪。\n百年凤舞云雾空，玉椀人间出句越。\n宫岚塔雨恍如失，飞网绕湖冠聚鹬。\n琳宇焚芝秋寂历，斗下无人祠太乙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36092,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"莲叶舟","author":"谢翱","text":"湿云冉冉依芳芷，楚女神弦迎帝子。\n天人种莲露染根，一片碧花秋堕水。\n笙箫闻声影如梦，浮花漠漠船来重。\n神蛟蜕肠江水湄，化为五色光陆离。\n中有玉人跨蛟舞，藕根断丝罥人衣。\n碧瞳秋发眠清夜，按肌不粟清露下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36093,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉井水","author":"谢翱","text":"玉华翳日神封井，液泠秋根洗云影。\n年年天女下来观，露湿风吹太华顶。\n冰枝脱叶坠欲舞，青鸟伺枝忽衔去。\n夜深井气白吐虹，井中龙子如守宫。\n凡人不敢饮此水，往往梦寐游其中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36094,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送人归乌伤","author":"谢翱","text":"湖边老屋墙压篱，饥鸦啄雪枝上啼。\n湖中葑田产菰米，菖蒲花开照湖水。\n蒺藜老翁呼不起，曾入东宫教皇子。\n文雅风流俱扫地，瓦砖掷人老兵醉。\n后园小坊近市廛，借人樗蒲无税钱，君归故里何所怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36095,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"觅紫芝","author":"谢翱","text":"少微昏见觜觿中，山深夜气光流虹。\n青芝独产林下石，染根湿云如紫漆。\n天门梦断路初回，山鬼守根不敢食。\n银泥彻锁守者疲，老翁持咒取夜归。\n明当食之闻鬼哭，对尔洗肠还入腹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36096,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨后海棠","author":"谢翱","text":"春光摇摇一万里，野粉残英空蜀水。\n天人愁湿红锦窠，万里移根泪如洗。\n苍苔裹枝雪堕地，雨中闻有西南使。\n化为黄鹄凌空青，开时衔花落衔子。\n绿章青简下蓬莱，滞魄游魂恨未已。\n至今鹦鹉啼猩红，不随明月葬空中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36097,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登广灵寺塔望南高峰","author":"谢翱","text":"城池风烟杯渡僧，广灵孤塔悬昼灯。\n塔灯上齐南高云，南高峰巅祠歙神。\n灵旗萧萧卷清雨，结喉巫阳能楚语。\n回望人烟塔峰北，惟有空城临水浒。\n赤蛇不神江海翻，薮泽狐狸作巴舞。\n当年介弟阶防禦，玉鸾青鞭上天去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36098,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪度","author":"谢翱","text":"千山万山雪崔嵬，欲流不流水洄洄。\n蛰熊出穴戍草短，客行心急梦归来。\n南园桑柘未生叶，南溪渡头不可涉，朝种木兰拔为楫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36099,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"阅方史君登行状","author":"谢翱","text":"九江黥王所理州，衰年仗箠作诸侯。\n唐人旧隐衣冠尽，归闯宫潮不得觐。\n天吴舞罢尘土飞，廿载腥云寄空殡。\n当年电隙岂所问，生死身名惟转瞬。\n睦人共说方饶州，番人作庙祠唐震。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36100,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"食荠歌送别方安道","author":"谢翱","text":"山中荠发烧馀地，与君为客同食荠。\n荠长故君收烬馀，君归食荠如食荼。\n我家瓯越草应出，土湿烟青归不得。\n相逢举酒复为别，对君盘中不忍食。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36101,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜宿南明县斋","author":"谢翱","text":"朝阴扣舷清剡曲，暝投天姥峰前宿。\n桂虫食叶露湿身，影落莓苔云矗矗。\n天风吹枝断末殊，梦寻杳霭来绛车。\n下车者谁藏姓氏，夜向琼台读诸子。\n觉来隐隐声在耳，月白西南望为水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36102,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书画梅花水仙卷","author":"谢翱","text":"风吹袜露明微照，芳云弱植仙姝庙。\n髻鬟零乱在枕函，月里罗浮梦中到。\n鲛绡拂尘蝉翼隔，窗雾凝寒唯影入。\n晓来坐对残空标，翠翎不见额黄湿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36103,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冬青树引别王潜","author":"谢翱","text":"冬青树，山南陲，九日灵禽居上枝。\n知君种年星在尾，根到九泉杂龙髓。\n恒星昼霣夜不见，七度山南与鬼战。\n愿君此心无所移，此树终有开花时。\n山南金粟见离离，白衣人拜树下起，灵禽啄粟枝上飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36104,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小元祐歌寄刘君鼎","author":"谢翱","text":"前甲子，小元祐，句章祲黑权臣死。\n端平天子初改纪，袭芳泰陵种兰芷。\n当秋淮甸枯草黄，弯弧北向射天狼。\n狐南星光天狗堕，入蔡生擒完颜王。\n是年南海无波浪，月湿珠胎君以降。\n只今六十空白头，独骑麒麟补春秋。\n天回星周美恶复，人世更传蔡州录。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36105,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句章见月食","author":"谢翱","text":"縠州见月如鱼口，沬聚痕消暗窗牖。\n鄞城见月如破臼，弃药含垢挂南斗。\n龙蛇伏气诸脑空，水中睡失群阴母。\n其间海禽独夜啼，黑云赴海同奔犀。\n市人识母不识父，击柝摧扉救月死。\n况值蕤宾月十五，干神附甲支在子。\n孤子哀吟离楚尾，泪落荒江吊南纪。\n犹忆秦淮哭日年，不敢仰视看盆水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36106,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵安天北游求诗安天韶王孙作诗送之","author":"谢翱","text":"海云抱沤海水热，道路征人裹冰雪。\n怜君独作万里游，雨把莲茎手中别。\n莲茎刺多莲叶湿，翻为君衣覆为笠。\n汴南淮北多故人，马上相逢泪相揖。\n故园萋萋长草根，迟君归来洗雨痕。\n青鞭碧影角湖曲，芳梦犹到韶王孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36107,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"逃暑崇法寺","author":"谢翱","text":"城南古寺凉生处，草色遥连孝子墓。\n棋局雨生苔鲜文，袈裟晴挂芭蕉树。\n自昔阇黎修白业，会公唯与舒王椄。\n只今尘土影堂空，石上犹镌麻纸帖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36108,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鄞女墓","author":"谢翱","text":"网草新垂月中露，青禽夜宿菱塘渚。\n寺西幽修云覆土，知葬舒王下殇女。\n百年光尘事事新，皇子夫人墓作邻。\n民间厌胜祈新鬼，稚鬼久随风雨陈。\n去来似尔勿复道，白下钟山梦中老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36109,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五言近体二首 其一","author":"谢翱","text":"南雁去来尽，音书不可凭。\n应过蛮岭瘴，闻拊楚臣膺。\n沧海沈秦璧，愁云起舜陵。\n可堪梦魂在，回首旧孤棱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36110,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五言近体二首 其二","author":"谢翱","text":"月离孤嶂雨，寻梦下山川。\n野冢埋鹦鹉，残碑哭杜鹃。\n妓收中使客，民买内医田。\n到此闻邻笛，离情重惘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36111,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋忆山中人","author":"谢翱","text":"兹夕发清啸，为君楚舞终。\n西风五陵梦，凉露九霄中。\n野逻烟常起，溪流榜不通。\n天阴无乳兔，林尽见飞鸿。\n湿湿云垂发，丸丸树偃弓。\n剑歌玄武莫，尘语白鸥空。\n祇有淮南泪，应沾青桂丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36112,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]