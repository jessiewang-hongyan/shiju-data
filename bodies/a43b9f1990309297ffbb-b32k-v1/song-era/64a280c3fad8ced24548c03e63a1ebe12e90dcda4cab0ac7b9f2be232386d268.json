[{"title":"吴门狱中怀北山旧隐 其五","author":"释道潜","text":"甘冷宜茶石缝泉，得名初自玉堂仙。\n苍苔滓秽聊疏治，照月涵星复粲然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴门狱中怀北山旧隐 其六","author":"释道潜","text":"一径缘云入寿星，竹间窈窕见疏棂。\n阑干数曲观台上，幽草靓花常满庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴门有怀钱塘何彦时仙尉 其一","author":"释道潜","text":"英妙何郎蕴德光，不随人世事炎凉。\n麒麟步武开天上，他日青云道路长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴门有怀钱塘何彦时仙尉 其二","author":"释道潜","text":"英游阁前官柳行，柔枝袅袅弄鹅黄。\n多情春色还依旧，独有离人天一方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴门有怀钱塘何彦时仙尉 其三","author":"释道潜","text":"湖岸茸茸细草生，芳洲杜若想纵横。\n去年问柳寻花地，谁伴穿云渡水行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘咸临秀才挽词 其一","author":"释道潜","text":"刘子江南英，韵胜不友俗。\n闭门诵诗书，户外无来躅。\n昔我寄匡山，岩扉屏幽独。\n君闻跨蹇驴，迢迢访深谷。\n忘怀去畦畛，结好比松竹。\n浮云事忽空，逝水难再复。\n徒有箧中文，千秋成鬼录。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘咸临秀才挽词 其二","author":"释道潜","text":"异材擢阳阿，秀色方蔚然。\n侵寻掩众阜，屹屹上造天。\n惊飙忽摧殒，中道虚弃捐。\n颜渊古称夭，道德今独妍。\n何求拥肿为，无用徒永年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘咸临秀才挽词 其三","author":"释道潜","text":"平生本家学，耻作干时语。\n著书以愚名，绰欲慕前古。\n纷纷诋迂阔，默默君自许。\n弱龄咏风骚，其词哀以苦。\n先生叹奇作，寿达终难与。\n果为冥冥游，一往不可睹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"刘咸临秀才挽词 其四","author":"释道潜","text":"吾希李长吉，异代不得友。\n赖馀锦囊篇，把玩时在手。\n斯人君并驾，未易较先后。\n肝脾裹阳秋，落笔粲琼玖。\n当年邂逅初，宛在三峡右。\n相携石桥行，下瞰冰雪溜。\n音容俄永隔，山月空依旧。\n铭诗得黄香，知子垂不朽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠霍山人","author":"释道潜","text":"先生少年喜武事，三略六韬曾遍阅。\n胸中云梦吞八九，气胜万夫真勇决。\n防边伊昔从都护，欲取功名继前烈。\n臂弓腰箭事戎装，远出砂场恣游猎。\n擒狐射雁狂且逸，不觉归途迷夜雪。\n败官遭谴失所志，回首飘然辞魏阙。\n挟持妙术当生涯，放浪江湖闲岁月。\n寻常得钱即沽酒，笑与妻奴同饮啜。\n乐天知命了无忧，奕奕红颜浮两颊。\n春风浩荡鲁城边，稠花乱蕊争纷妍。\n方将与君共携手，骋怀游目相回旋。\n兴来别我汶阳去，黄鹄一举难留连。\n村桥野店醉斜日，路人谁识地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘不已推官罢奉符尉入都注拟","author":"释道潜","text":"少年读书破万卷，河朔声名压诸彦。\n词场百战功不成，晚得青衫非所愿。\n白头况有北堂亲，斗禄强须甘冗贱。\n三年一尉泰山下，簿领区区事弓箭。\n追穷寇盗走山谷，肯为风霜辞怯懦。\n要功冀赏本无心，脱去仅能逃所谴。\n草枯蓬断岁将徂，结束行装抵京县。\n达官贵吏急贤材，一鹗君须预论荐。\n投竿舍筑去作相，邂逅风云一朝变。\n造物于人自有时，未足为君生忿怨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过彭城观陈传道知录所藏东坡公画","author":"释道潜","text":"枯株瘦石两相望，南北悠悠径路长。\n卷尽平冈三百里，风枝雨叶更飘扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"淮上观水","author":"释道潜","text":"桐柏昆崙日夜倾，投溪注壑本无情。\n乍为含垢千寻浊，不作矜人一掬清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏书诚师秋景小屏","author":"释道潜","text":"黄芦败苇两三丛，彷佛江湖在眼中。\n雁鸭惊呼缘底事，一时昂首立秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过韫秀堂观仲豫二诗因次其韵 其一","author":"释道潜","text":"箕南斗北各殊方，谁信相思去梦长。\n蓬断草枯当岁晏，寥寥空对蕙炉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过韫秀堂观仲豫二诗因次其韵 其二","author":"释道潜","text":"荆溪一别十年馀，流窜何尝定所居。\n等与山河同幻质，更将三界作蘧庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵聪师见寄 其一","author":"释道潜","text":"三年东鲁贬，闭户实超然。\n静极通幽眇，神游岂间焉。\n独全霜后操，未异火中莲。\n不似沈湘客，徒怀忿与悁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵聪师见寄 其二","author":"释道潜","text":"夙学谁知子，源流务所滋。\n风骚追五柳，禅寂拟长髭。\n桂魄元昭晰，浮云自蔽亏。\n险夷终一节，吾以古为师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵升师见招 其一","author":"释道潜","text":"老去年光知几寻，无端华发苦相侵。\n独怜碧眼平生旧，未改青松一寸心。\n欲扣禅关当岁晏，肯愁溪路隔云深。\n相逢试探梅花信，应有香须擢碎金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵升师见招 其二","author":"释道潜","text":"儿童笺管已能操，书乏吟窗几兔毫。\n文囿垣墙增渐广，词林枝叶势方高。\n嗟余旧喜论周诰，晚岁无心讽楚骚。\n羡子得时勤述作，宛如秋浦涌云涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"残菊","author":"释道潜","text":"霜摧露殒万枝空，丛菊鲜鲜尚见容。\n细蕊冷香聊自媚，无心引蝶更勾蜂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"涤轩","author":"释道潜","text":"隔云穿窦引涓涓，喷玉跳珠亦可怜。\n心垢本无何用涤，戏将萧洒度流年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"千顷廨院观司马才仲遗墨次韵","author":"释道潜","text":"濛濛春雨暗村桥，竹里禽啼婆饼焦。\n度谷倦闻车轧轧，穿林愁听马萧萧。\n细窥陈迹僧坊静，默想风流鄙吝消。\n浮魄沉魂今已矣，无人为作楚词招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"唐昌王悦道桃竹轩","author":"释道潜","text":"馀杭门西山迤逦，屹屹千峰插天起。\n穷幽摘胜过三邑，随处云林皆可喜。\n迩来杖策到君家，始觉溪山逢骨髓。\n争流万壑会目前，竞秀千岩对窗几。\n丹枫洗雨秋霁馀，白鸟出没岚光里。\n主人韵胜无尘埃，翠竹红桃相映栽。\n良辰樽俎凭谁共，友月朋云自往来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪上","author":"释道潜","text":"红蓼丛边双鹭飞，波痕翻动碧琉璃。\n须臾相趁却回首，斜立垂杨烟外枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"听盛道人琴 其一","author":"释道潜","text":"阴云收雨阁曾檐，寂寂西风不动帘。\n烧尽夜堂红蜡炬，高山流水听无厌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"听盛道人琴 其二","author":"释道潜","text":"有客浮游不定家，玉琴三尺当生涯。\n从来正始无人会，掉首高歌乌帽斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"千顷山圆镜堂呈应禅师","author":"释道潜","text":"兹山嵯峨冠天下，一径萦云行两舍。\n始穷绝顶见招提，碧阁丹楼屹如画。\n门前池水滀蜿蜒，座上风雷惊昼夜。\n峨眉五台誇壮观，品目真不此为亚。\n伟哉南师非世人，开荒辟土初椎轮。\n寥寥相望三百载，废兴一一难具陈。\n丹丘大士来鼓舞，气象焕发重增新。\n投金输赆走南北，法雨所被无涯津。\n虚堂选胜得佳处，隆檐巨栋成逡巡。\n窗扉洞达舒两目，异景错出罗蓁蓁。\n朝云夜月常万顷，寒光炯炯如镕银。\n堂中隐几人何似，湛若玉毛悬秋旻。\n榜名圆镜示来客，庶使方寸无缁磷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沈道原养浩堂","author":"释道潜","text":"尘劳万计日纷纷，未碍堂中养浩心。\n花草暗香来屋角，溪山爽气入衣襟。\n樽中白酒无时有，箧里清诗不废吟。\n夜夜邻家助幽致，数声羌管弄微音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宣上人玉渊堂","author":"释道潜","text":"玉渊閟苍崖，源深杳难测。\n但见涓涓附箨龙，宛转来投小池侧。\n小池方折馀两寻，蛙黾不游苔不侵。\n青天无云落寒影，沈柔见底空人心。\n妙哉支公营小筑，气象萧然真不俗。\n夜吟朝讲度流年，何用峥嵘誇杰屋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与定师话别六言 其一","author":"释道潜","text":"客有来从东越，示余满把琼瑶。\n万壑千岩钟秀，故知多士翘翘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与定师话别六言 其二","author":"释道潜","text":"雪解松筠振色，气回兰蕙含芳。\n兴动剡溪吟客，梦先归鸟飞翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与定师话别六言 其三","author":"释道潜","text":"出海涛雷方震，横江雪阵如山。\n一叶舟轻飞燕，飘然掠水东还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与定师话别六言 其四","author":"释道潜","text":"凤咮山含暮霭，西陵月破黄昏。\n惯作江湖离别，未应当此销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧觉孜师绿筠轩","author":"释道潜","text":"绿筠萧萧含爽籁，幽姿冷落人难爱。\n壁间但有谪仙词，声名自到江湖外。\n当年创轩非壮观，局促帘栊日亏蔽。\n一朝经画有底难，推倒墙头了无碍。\n坐挹西南十里山，彩翠浮空屹相对。\n开池凿圃增气象，佳致真为一方最。\n鸟声鸣春春渐融，兰芽蕙出初蒙茸。\n我来正值新雨定，弄日吹香闻座中。\n主人散策邀我步，池南池北聊从容。\n会待龙孙添夏荫，借君此地眠清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏夜智果怀武康令毛泽民","author":"释道潜","text":"暮磬寥寥殷上方，笼纱朱火影微茫。\n窗虚竹净雨初阕，云润星辉夜更凉。\n落枕松声惊瑟瑟，扑帘香雾霭苍苍。\n遥怜散发东堂老，正卧风漪六尺床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄宗室赵伯言朝请","author":"释道潜","text":"赵侯天人裔，雅韵能拔俗。\n岂意江湖间，解后识眉目。\n高谈为余倾，落落如转毂。\n端无贵富骄，但有文字欲。\n交游多望士，颉颃争驰逐。\n艰难风义高，迹与古人续。\n铜章领剧邑，宛在江之曲。\n鸣弦陶永日，了不事鞭扑。\n新诗拟建安，简远词不缛。\n锦囊有馀弃，示我仅盈轴。\n持还故山栖，把玩时反覆。\n美哉韶濩音，锵然落岩谷。\n嗟余真浅陋，学海无一掬。\n仰君东溟深，短绠不可触。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读东坡居士南迁诗","author":"释道潜","text":"居士胸中真旷夷，南行万里尚能诗。\n牢笼天地词方壮，弹压山川气未衰。\n忠义凛然刚不负，瘴烟虽苦力何施。\n往来惯酌曹溪水，一滴还应契祖师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读闻复诗卷","author":"释道潜","text":"诗律久已废，宏纲谁与操。\n断弦那虑续，吾党有英髦。\n气稳侔彭泽，词幽近楚骚。\n未输汤从事，独诧碧云高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复庐山见怀","author":"释道潜","text":"匡庐三载恣徜徉，肯惮衣裘弊雪霜。\n学彻死生追粲忍，力穷骚雅陋齐梁。\n心源素与秋潭静，定水宁同夏潦潢。\n邂逅逢余旧题墨，藓封苔駮不成行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日寄愚坦二上人","author":"释道潜","text":"仙潭从古水云乡，不羡西湖六月凉。\n支港官河通市井，采菱拾翠有舟航。\n觚棱迥与星辰接，铁凤疑参鹳鹤翔。\n九夏登临输二子，一时摹写付诗囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复西湖夏日六言 其一","author":"释道潜","text":"山水初无今古，人间自有沈浮。\n试问行歌野老，桑麻用事何忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复西湖夏日六言 其二","author":"释道潜","text":"老葑年来席卷，吴侬旧恨弥申。\n昨夜冯夷鼓吹，遨嬉抵彻诸邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复西湖夏日六言 其三","author":"释道潜","text":"夜深一碧万顷，彷佛明河接天。\n岸曲风篁成韵，绝胜细管危弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复西湖夏日六言 其四","author":"释道潜","text":"西湖清浅可泛，湍险岂类瞿塘。\n随处菰蒲莲芡，栉风沐雨尤香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复西湖夏日六言 其五","author":"释道潜","text":"南窗寄傲一榻，午帐风来卷舒。\n懒蹑子云陈迹，解嘲更续成书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复西湖夏日六言 其六","author":"释道潜","text":"烧空火云万丈，气焰信可流金。\n嗟尔龟鱼得计，适然游泳滋深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复西湖夏日六言 其七","author":"释道潜","text":"栎杜侵阶美荫，鸣蝉托质初凉。\n薰风正被草木，莫作秋声感伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复西湖夏日六言 其八","author":"释道潜","text":"柱础争流馀润，油云忽改山容。\n定有盲风怪雨，晓来已听鼍龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复西湖夏日六言 其九","author":"释道潜","text":"湖光宛同玉镜，堤柳閟若房栊。\n六月行人过此，未输仙客壶中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵闻复西湖夏日六言 其十","author":"释道潜","text":"河汉斗杓横七，重城漏鼓传三。\n露鹤一声何许，嘎然震响空岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏夜偶兴","author":"释道潜","text":"微阳堕曾巘，归翼投空林。\n龛灯閟古殿，梵呗无馀音。\n眷兹石壁下，徐风散冲襟。\n缺月如断环，依微挂松阴。\n清晖婉相属，永夜谐吾心。\n空生大觉中，一沤示浮沉。\n此身沤中客，冥观无古今。\n昔我婴世故，纷纷那重陈。\n且求华胥梦，胡蝶相追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵古上人湖上步月","author":"释道潜","text":"寻常西湖月，云雾多袭明。\n兹宵实昭晰，似慰诗人情。\n低昂见列宿，戢曜非光荧。\n起余二三子，微咏哦新声。\n杖藜山前去，鸡犬寂不鸣。\n兰皋宿鹭群，回首时自惊。\n君看南北山，气象真峥嵘。\n参差烟树丛，一一含馀清。\n上人江南秀，邂逅意所倾。\n夜阑劝复路，浩兴殊未盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临江月上人","author":"释道潜","text":"能仁说教满竺乾，流入中国馀五千。\n于中妙经为最胜，顗师所解尤通玄。\n化行吴会连海壖，纷纷得法如云烟。\n见闻读诵又其次，随类譬率无间焉。\n呜呼上人志且坚，善邀佛子同法筵。\n妙香炷炉馥旃檀，十科劝进追昔贤。\n旁行贝叶轴似椽，卷舒朝暮往复旋。\n利根微种聊穷研，鱼兔一获忘蹄筌。\n自馀区区顾未然，澜翻口舌如涌泉。\n外物交错心匪缘，功成一朝脱爱缠。\n晔如红蕖濯清渊，俯仰千圣遽可肩。\n茫茫苦海旁无边，不有舟筏谁能先。\n乌蟾疾驰如走丸，咨尔佛子无睡眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琅琊山茶仙亭呈曾子开侍郎","author":"释道潜","text":"滁山虽僻左，谪宦皆名臣。\n后先闻数公，卓然皆凤麟。\n忆昨绍圣初，谴公俾省循。\n盛德忘怨悱，虚怀随屈信。\n政成思览眺，兴与烟霞亲。\n后车载邹枚，主客惊路人。\n逶迤度山谷，导从屏所陈。\n渔樵许争席，解后全天真。\n泠泠庶子泉，味压康王珍。\n团团小圆月，色冠闽山春。\n白足相与饭，溪毛撷青芹。\n熊鱼得兼美，乐事无涯津。\n花瓷劝引满，疏瀹贯百神。\n危亭倚岩阿，榜额独未新。\n牧之擅风流，茶仙誇绝伦。\n相望三百载，公能嗣芳尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送钱持正主簿西归","author":"释道潜","text":"兰陵号多士，君实名家孙。\n高才縻管库，枳棘栖鸳鸾。\n一旦谢朱墨，超然整归轩。\n迎秋饯伏初，炎威尚歊烦。\n松陵接苕霅，迤逦皆清源。\n舟子宜夜泛，蘋风生梦魂。\n回塘官柳行，千树如云屯。\n明河挂柳外，凉月低金盆。\n兹行信有得，它日为余言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄子开内翰","author":"释道潜","text":"天将有作会云龙，一德君臣邂逅同。\n表率衣冠真领袖，羽仪台阁旧家风。\n词林岂独专周诰，衮职深期补舜聪。\n四海滞淹公可弃，尽收凫雁集庭中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠潜照月师","author":"释道潜","text":"吴兴上人心志苦，笔研十年耕学圃。\n形癯骨瘦神独清，耿若霜鸥立秋浦。\n锦囊新诗殊汗漫，妙语间发犹稽古。\n铢锄冗长更磨揉，激浊疏清导灵府。\n自然韵胜遗岛可，远跂渊明追步武。\n瓶盂劝子适四方，莫学匏瓜甘堕窳。\n崇山广泽遍游览，始信凭高极天宇。\n蓺成技进蔚文采，楚楚华身竟何补。\n茫乎三界同传舍，而我与君俱逆旅。\n不如回首依老褐，妙精明心求许与。\n鸣蝉委蜕藁壤馀，脱略秋风即高举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"垂慈堂木樨花","author":"释道潜","text":"堂下高花屹两株，繁英碎萼巧连茹。\n猛香匪占春园盛，清烈仍分里巷馀。\n长抱秋蟾滋夜气，偶摇风露堕阶除。\n根盘厚地知方壮，封植何人考厥初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵关子容晚霁 其一","author":"释道潜","text":"小院回廊明霁霞，疏帘未捲尚横斜。\n应怜碧砌无尘滓，石竹红薇靓有花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵关子容晚霁 其二","author":"释道潜","text":"飞帘初遣雨师回，独上江城百尺台。\n万景横前方领略，越山仍欲送青来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和湖上晚归 其一","author":"释道潜","text":"漾舟归路兴何赊，水树低凉一道斜。\n菱蔓蒹葭都卷尽，芙蓉炯炯独开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]