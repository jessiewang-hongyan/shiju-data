d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45803,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其六十","author":"赵炅","text":"白云风散聚天香，霞彩高明道味长。\n银汉影沈星乍没，又看红日起扶桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45804,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其五十二","author":"赵炅","text":"识性低凡故不知，宣传好事却为非。\n可怜此辈居人世，逆恶求真善不依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45805,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其七十九","author":"赵炅","text":"故无形像显教寻，隐秘踪由自古今。\n妙法不传经上字，玄门消息冈知深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45806,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其五十六","author":"赵炅","text":"玄元一气不相监，清静如存意马衔。\n大隐居廛迷小道，绝巅顶上白云岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45807,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其十七","author":"赵炅","text":"每逢清夜坐更深，白日忙忙各是情。\n南北东西谁定准，无穷天地始知名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45808,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其五十四","author":"赵炅","text":"修行缘识近宗师，妄想真空各自持。\n慕道终来归正法，无穷方寸莫教痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45809,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其九十七","author":"赵炅","text":"修持须是要精专，常恐他人业类牵。\n莫把我言为戏弄，轮回断定不迁延。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45810,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其二十九","author":"赵炅","text":"常思清净世情闲，遥认天平我扣关。\n莫道玄谈些子是，凤飞鹤宿九疑山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45811,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其七","author":"赵炅","text":"上短下长人莫笑，信缘披得便前行。\n衣裳不是颠来倒，凭仗丹青画取成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45812,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"缘识 其七十四","author":"赵炅","text":"道在希夷不易寻，忘言息虑便知深。\n黄金白玉将何用，争比灵源一寸心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":45813,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]