[{"title":"句 其二十四","author":"楼楚材","text":"野花香胜名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34396,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二十五","author":"楼楚材","text":"窠花盆是地，巢燕屋为天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34397,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二十六","author":"楼楚材","text":"天晴常网湿，船窄自心宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34398,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二十七","author":"楼楚材","text":"不须忧暑气，有我便无它。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34399,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二十八","author":"楼楚材","text":"要满地卑处，常鸣石激时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34400,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二十九","author":"楼楚材","text":"着马轻鞍重，随僧皂衲斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34401,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"吴倧","text":"老去渐同嫫母丑，归来免效贾胡留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34402,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"吴倧","text":"两生更肯从绵蕞，高祖规模又不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34403,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"吴倧","text":"吴市终身避言耳，去家岂是去为仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34404,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其五","author":"吴倧","text":"渔携网近鸥斜去，人过桥东影倒行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34405,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其六","author":"吴倧","text":"岸近田多损，潭深石叠平。\n村舂林外急，钓艇柳阴横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34406,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其七","author":"吴倧","text":"竹牖迎风翻贝叶，铜炉温火养龙涎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34407,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赋风花 其二","author":"何梦桂","text":"大钧播万物，静观自森著。\n倏见朝华荣，夕陨亦何遽。\n升沈信天机，高下两无据。\n世眼空纷籍，往事逐飞絮。\n今年花上枝，去年花落处。\n开落无常期，年来复年去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34408,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和昭德孙闻鹃","author":"何梦桂","text":"平生抵掌志伊吾，闻著鹃声泪血枯。\n故国蚕丛千古恨，雾关熊耳一身孤。\n自从飞去啼痕在，纵不归来有梦无。\n莫向延秋门上叫，门楼无数白头乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送胡簿秩满归","author":"何梦桂","text":"佐邑三年去后思，祇今无奈送行时。\n不谐白雪皇荂耳，谩指清风恶木枝。\n台府无心空里镜，士民有口路傍碑。\n锦溪流下严陵濑，八月潮来有转期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"承书言别再寄","author":"何梦桂","text":"一曲离鸾感寄心，此心谁解试分明。\n百年耆旧閒中话，千古溪山去后名。\n双鲤尺书儿女泪，只鸡斗酒弟兄情。\n男儿须勒燕然石，归拜堂谖始是荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赠潘氏积善堂","author":"何梦桂","text":"市义今无古孟尝，不图近见郑公乡。\n布金地已成祇树，箪食人应遍翳桑。\n身享九龄耆寿福，眼看五世子孙昌。\n天公有耳长聪听，多少行碑在路傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灞桥骑驴","author":"何梦桂","text":"小骊买得最便宜，好是河梁古柳涯。\n风急吹沙长耳峻，雪深没板蹇蹄迟。\n据鞍吟透肩双耸，敲镫歌狂帽半攲。\n道上莫教逢大尹，推敲句里不曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送陈治中勿斋二首 其一","author":"何梦桂","text":"天台万丈下灵光，便合乘旗翳凤凰。\n身在金台天北阙，手提铜柱地南荒。\n一生许国心如铁，万里封侯鬓未霜。\n别驾小淹元不恶，公来私得海沂康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送陈治中勿斋二首 其二","author":"何梦桂","text":"箳篂三载诵贤侯，折柳邮亭菊又秋。\n无翼解随云北去，有心长注海东流。\n千崖雨意留行旆，七里滩头送去舟。\n早为苍生题福笔，尚回麾节顾沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽徐子愚母","author":"何梦桂","text":"萱花落尽北堂空，龙颔碑铭百尺丰。\n鄹纥晚婚无徵在，孟光不嫁有梁鸿。\n一官得子荣身后，四世看孙满眼中。\n三酹生刍人似玉，故丘狐首此封崇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽方中立同舍","author":"何梦桂","text":"回首炉亭梦已非，英雄老尽壮心违。\n钧天云散苍龙堕，华表风寒白鹤归。\n往事悠悠川水逝，故人落落曙星稀。\n乐天无子留孙在，多少龙门客泪挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又代人","author":"何梦桂","text":"一曲哀歌老泪垂，英雄不偶数孤奇。\n百年事堕槐安国，半世名成荐福碑。\n无禄逮亲生自憾，有孙表墓死何悲。\n黄门靖节均生死，清议无情更属谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送阮梅仙","author":"何梦桂","text":"佐邑三年吏隐仙，声名留照锦江边。\n才高不受青衫束，官小聊将綵仗悬。\n流沫吕梁游十仞，抟风溟海上三千。\n沙头双玉难为别，一曲离歌约暮年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠电目相士","author":"何梦桂","text":"知君说相压南州，相我空贻白发羞。\n但得羊裘归钓泽，安知燕颔去封侯。\n穷通有分都休问，出处难言已自谋。\n一笑相看出山去，逢人莫道见壶丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽汝南袁君 其一","author":"何梦桂","text":"一曲哀歌行道难，满堂试听一潸然。\n两儿青紫开荣路，五世曾玄送暮年。\n乔木受风危易撼，孤舟排浪险终全。\n故丘狐首君无憾，寒食年年洒墓阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽汝南袁君 其二","author":"何梦桂","text":"黄金不铸百年身，世变相劘白发亲。\n龙角墓碑生古藓，砥如亭路落缁尘。\n明时事业留诸子，前代衣冠见似人。\n得失鸡虫都莫问，故丘抔土是全真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽汝南袁君 其三","author":"何梦桂","text":"桐木山西送落晖，百年耆旧数他谁。\n畏途几历青泥险，往事惟馀白发知。\n今代衣冠遗此老，前朝簪笏付吾儿。\n明朝归葬西邙路，五世哀思百尺碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽检院吴对山","author":"何梦桂","text":"岝崿山前吊隐君，招魂九些泪沾巾。\n风云失势丹心死，天地无情白发新。\n西洛衣冠遗一老，东篱诗酒是全人。\n盖棺事了应无愧，消得新阡号逸民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽南坡章知县章运使子家则堂志","author":"何梦桂","text":"丰碑二绝照新阡，节义成名得象贤。\n善政人能书宰邑，宽恩民尚诵公田。\n家翁不负心传印，冢嗣能忘手泽编。\n仕学一生行未了，后来好为拂青毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽邵青溪二章 其一","author":"何梦桂","text":"尊酒生刍吊旧游，白髭老泪故山秋。\n百年勋业黄粱枕，一代文章白玉楼。\n豪杰彫零天地老，山河牢落古今愁。\n行人不歃青溪水，付与閒翁对白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34426,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽邵青溪二章 其二","author":"何梦桂","text":"贞元一曲泪沾巾，耆旧今能有几存。\n斗酒只鸡空酹冢，缟衣匹马尚招魂。\n百年身后事终定，千古眼前谁共论。\n试问故侯瓜熟未，青门犹自有儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34427,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居即事","author":"何梦桂","text":"分得南窗与世违，坐消白昼乐清时。\n楼头秋意一声笛，镜里岁华双鬓丝。\n绿水放教通竹径，清风招不下梧枝。\n心期自得难为说，白鸟青山是己知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34428,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠旧同舍王景阳","author":"何梦桂","text":"何许相逢客路岐，相看须鬓各成丝。\n两年衰病苦牢落，千里故人伤别离。\n江月不遗流水逝，天风未起老桑知。\n人生百岁先朝露，惟有贞名死不隳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34429,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送高参政","author":"何梦桂","text":"声名盖世古人豪，天遣西来展六韬。\n狐鼠何能婴虎旅，鲸鲵犹合避龙刀。\n将坛七拜功增重，省府重登官转高。\n他日中书勋第一，汾阳应只是儿曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34430,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送马高参政","author":"何梦桂","text":"瘦骨丰棱产渥洼，几年俛首服盐车。\n穿花久失青丝辔，莝豆谁怜白鼻騧。\n汗血浪誇空北冀，风蹄犹惯步东华。\n锦鄣不肯污泥水，好去侯门逐五花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34431,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄寿王直卿省郎二亲年八十诗二首 其一","author":"何梦桂","text":"金盘玉箸脯麒麟，荣福堂前寿二亲。\n白发宋州老司马，红颜晋国太夫人。\n生时曾结同年会，见世重来两佛身。\n庭下有儿归省掾，执鞭时自导双轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34432,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄寿王直卿省郎二亲年八十诗二首 其二","author":"何梦桂","text":"二老婆娑出寿筵，绿衣人好舞蹁跹。\n餐桃阿母脸犹玉，食杞仙翁头返玄。\n堂上相看新八秩，尊前重话旧同年。\n累茵列鼎人间有，安得亲庭此乐全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34433,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上留尚书","author":"何梦桂","text":"昆明池劫化灵缁，梦觉功名忝一炊。\n钟子未将南操变，庾公空抱北朝悲。\n归来眼底湖山在，去后心期浙水知。\n白发门生怜未死，青袍留得裹遗骴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34434,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽何此园","author":"何梦桂","text":"南窗一枕梦槐安，咽鼓悲笳生暮寒。\n寿极星移堕芒角，诗仙身蜕失丸丹。\n扶藜记与渔樵话，种菊留教孙子看。\n归去休休言不尽，残阳木末乱鸦盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34435,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶成","author":"何梦桂","text":"唤醒邯郸出梦关，悠悠身世隔尘寰。\n飞鸿落照琴三叠，流水寒花屋半间。\n老不如人甘遁世，闲谁似我得看山。\n乾坤许大双蜗角，消得人间战触蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34436,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和访使徐容斋西湖韵寄县尹赵文玉二首 其一","author":"何梦桂","text":"一幅西湖画，谁将淡墨挥。\n水浮孤屿出，山约五云飞。\n雨洞猿啼湿，烟林鸟度微。\n龙舟双翠楫，曾此夜游归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34437,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和访使徐容斋西湖韵寄县尹赵文玉二首 其二","author":"何梦桂","text":"满目湖山恨，凭栏泪雨挥。\n泉寒龙已化，云尽鹤犹飞。\n楼影摇波乱，钟声隐岫微。\n谁家航十锦，歌舞夜深归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34438,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和徐云屿寄徐清溪","author":"何梦桂","text":"平生经济事，宁与世沉沦。\n日暮倦行客，天寒却扫门。\n百年双白发，四海一缁尘。\n欲相壶丘子，深惭见地文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34439,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"为友人解无妻之嘲","author":"何梦桂","text":"自甘为牧犊，何不娶巫臣。\n鱼目长凄断，雉飞徒苦辛。\n远衣无与寄，孤枕有谁亲。\n毋惜蛾眉买，黄金未是贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34440,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄月岩黄高士","author":"何梦桂","text":"有客扣松扃，重来问宿盟。\n青山尘世梦，玄鹤故人情。\n柯烂棋犹在，垆寒药未成。\n鼎边无好句，惭愧谢弥明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34441,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和文公见寄降笔","author":"何梦桂","text":"玉垒失元戎，关河惨北风。\n中原残照外，故国梦魂中。\n往事随流水，馀生叹转蓬。\n唾壶歌未已，飞雁落江空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34442,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和可庵见寄韵","author":"何梦桂","text":"蜃境平生梦，名场逝水川。\n相逢惊白发，一醉仰青天。\n浪出疑鸥笑，遄归伴鹤眠。\n故人知道意，珍重寄诗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34443,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"倚栏即景","author":"何梦桂","text":"落日青山外，寒烟古树头。\n犬声隔村落，渔火半汀洲。\n兴废江郊屋，行藏野渡舟。\n夜深风雨恶，人尚倚层楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34444,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽汾阳何北园二首 其一","author":"何梦桂","text":"宇宙千年暮，丘山一老遗。\n头因忧世白，体为哭亲羸。\n明月落何处，清风归去时。\n英魂招不返，回首北邙噫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34445,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽汾阳何北园二首 其二","author":"何梦桂","text":"五十年来梦，邯郸黍一炊。\n传家无长物，志墓有丰碑。\n落日江湖泪，西风里巷悲。\n故园吟不尽，千古付他谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34446,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登天台巾山","author":"何梦桂","text":"寸碧倚苍旻，孤城俯可吞。\n人行平木杪，帆去入云根。\n月榻留僧梦，风松吊鹤魂。\n江心千古石，岁岁记潮痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34447,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"到石宝岩下二绝 其一","author":"何梦桂","text":"十里矗巉岩，移来指顾间。\n相逢曾识面，元不隔重关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34448,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"到石宝岩下二绝 其二","author":"何梦桂","text":"相望各天涯，相看又恐差。\n朅来山下路，端的到君家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34449,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和夹谷佥事题钓台十首 其一","author":"何梦桂","text":"白水龙飞帝运开，先生梦不到云台。\n当时已笑占星误，岂易虚名落后来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34450,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和夹谷佥事题钓台十首 其二","author":"何梦桂","text":"当年江上一竿青，老尽羊裘两鬓星。\n往事成尘遗迹在，石痕齿齿水泠泠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34451,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和夹谷佥事题钓台十首 其三","author":"何梦桂","text":"龙信蛇屈各升沉，白发朱颜亦故今。\n出处两难人不识，云山江水是知心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34452,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和夹谷佥事题钓台十首 其四","author":"何梦桂","text":"误出山来亟已还，绝尘逸驾竟难攀。\n狂奴不了宫中事，剩得閒身宇宙间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34453,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和夹谷佥事题钓台十首 其五","author":"何梦桂","text":"咄咄相逢话故交，不嫌万乘友渔樵。\n当初未有玄纁至，只好收纶学弃瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34454,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和夹谷佥事题钓台十首 其六","author":"何梦桂","text":"汉事如舟要着篙，诸公已共济风涛。\n勋华终不臣巢许，莫道先生索价高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34455,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和夹谷佥事题钓台十首 其七","author":"何梦桂","text":"逝水滔滔七里滩，高情聊寄一丝竿。\n无鱼可钓浑閒事，脚底龙眠尽自安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34456,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和夹谷佥事题钓台十首 其八","author":"何梦桂","text":"苔藓碑漫字断章，休将汉事费评量。\n兴亡付与东流水，留得荒祠一瓣香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34457,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和夹谷佥事题钓台十首 其九","author":"何梦桂","text":"双台绝壁锁林霏，每恨跻攀足力微。\n今日重来问鸥鹭，绝无人迹上苔矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34458,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和夹谷佥事题钓台十首 其十","author":"何梦桂","text":"观风祠下谒先生，隔世相知重感情。\n归向中州诸老说，且休拈出此山名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34459,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桃源三首 其一","author":"何梦桂","text":"误逐桃花去访春，当年犹有种桃人。\n相逢休问秦时事，世上兴亡又几春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34460,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桃源三首 其二","author":"何梦桂","text":"洞里栽桃不记时，世间秦晋是邪非。\n落花落地青春老，千载渔郎去不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34461,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桃源三首 其三","author":"何梦桂","text":"牧歌樵唱自朝昏，白首何曾出洞门。\n一度草青添一岁，如今世代长儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34462,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梦中作","author":"何梦桂","text":"草浓阡陌眠黄犊，沙煖汀洲浴翠禽。\n一径梧桐花落后，半江春水绿阴阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34463,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠地理章月岩","author":"何梦桂","text":"世事兴亡千古意，山花开落几番春。\n年年惟有岩头月，照尽今人与古人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34464,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠张月斋","author":"何梦桂","text":"斸尽青瑶补缺光，暂持玉斧下青苍。\n相逢一笑乘鸾去，颜色犹疑在屋梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34465,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽林公坐化","author":"何梦桂","text":"一枕黄粱透梦关，独留蝉蜕在人间。\n有时欲见公颜色，木落枝枯月万山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34466,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题川无竭寄傲窗二首 其一","author":"何梦桂","text":"远公招不到渊明，莲社千年迹已陈。\n莫道先生曾傲己，如今更傲世间人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34467,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]