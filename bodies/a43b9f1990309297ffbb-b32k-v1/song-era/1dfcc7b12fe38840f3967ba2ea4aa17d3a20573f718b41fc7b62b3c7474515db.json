[{"title":"次虞仲房司马送秋韵","author":"丁世昌","text":"自入秋光能几时，无端又赋别秋诗。\n夜长月冷虫鸣急，天阔风高雁过迟。\n三径黄花存旧节，半栏红叶堕残枝。\n往来毕竟乘除法，何用年年宋玉悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中无聊忽徐渊子送酒","author":"丁世昌","text":"丹桂传香后，黄花著蕊时。\n老怀期欲赏，病足瘦难移。\n静对陶潜径，长吟杜甫诗。\n白衣人忽至，把酒慰愁眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古乐府","author":"丁世昌","text":"郎如枝上禽，妾比庭前树。\n翅健入云飞，根深随不去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"绛都春 上元","author":"丁仙现","text":"融和又报。\n乍瑞霭霁色，皇州春早。\n翠幰竞飞，玉勒争驰都门道。\n鳌山彩结蓬莱岛。\n向晚色、双龙衔照。\n绛绡楼上，彤芝盖底，仰瞻天表。\n缥缈。\n风传帝乐，庆三殿共赏，群仙同到。\n迤逦御香，飘满人间闻嬉笑。\n须臾一点星球小。\n渐隐隐、鸣鞘声杳。\n游人月下归来，洞天未晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿先生 其二","author":"李刘","text":"今年生日胜常年，一佛中间万佛缘。\n善念才兴方寸地，恩光便下九重天。\n花香作供围方丈，粟粒成功福大千。\n长寿如来更多宝，饱参住世小乘禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"景定壬戌除夜","author":"丁石","text":"罗列椒盘人未眠，红炉围坐笑灯前。\n时光过隙那知老，才到鸡鸣又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"碧沼寺","author":"丁仿","text":"万峰翠插锁萦纡，一沼光涵湛碧虚。\n驯虎旧闻输野鹿，化龙俄已失金鱼。\n白莲尚结高僧社，古木全荒隐士庐。\n襆被须期借禅榻，尽穿荦确与崎岖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游大涤","author":"丁先民","text":"我欲避尘嚣，乘风入洞霄。\n循溪山作路，驾水石为桥。\n台殿黄金锁，神仙碧玉箫。\n拂衣天柱顶，清思欲飘飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游洞霄宫","author":"丁先民","text":"午过青山渡，扬鞭入洞霄。\n旁观昔隐迹，信步冷泉桥。\n说简金龙古，仙风道古饶。\n小轩曾寄宿，秋雨闹芭蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽故知容州朝请陶公 其四","author":"丁师正","text":"苦硬黄花节，霜枝香更清。\n乾坤一庞老，今古两渊明。\n白玉难重见，孤冰不复清。\n梦中期会面，雪涕话平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽故知容州朝请陶公 其一","author":"丁师正","text":"游宦天西北，心随造物游。\n春风郧子国，明月岳阳楼。\n政出黔黎喜，名高夷狄愁。\n案巡边万里，风雪破貂裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽故知容州朝请陶公 其五","author":"丁师正","text":"揖坐楼头夜，酒杯生菜盘。\n交情三月暮，细雨一灯寒。\n谈笑响如在，赓酬墨未乾。\n死生千古别，西日照阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽故知容州朝请陶公 其二","author":"丁师正","text":"嚼得菜根断，诗寒骨更臞。\n爱民心雪白，报国鬓霜枯。\n仕久衣长破，归来屋亦无。\n全家寄僧舍，冰冻折吟须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽故知容州朝请陶公 其三","author":"丁师正","text":"万影奔朝市，归山见一人。\n青云莫相附，白雪不生尘。\n暖日眠松石，凉风岸葛巾。\n依然旧原宪，猿鹤伴清贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送程给事知越州","author":"丁执礼","text":"晓辞龙尾下青冥，持节东南一镇并。\n共治蚤分天子寄，暮来今颂里民声。\n吟高郢雪谁能拟，韵敌壶冰凛更清。\n遥想棠阴多暇日，江风吹角绕蓬瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五更枕上","author":"丁竹岩","text":"一着非时一局非，山房愁到晓钟时。\n楠榴枕上平生事，听雨听风听子规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题醉翁亭","author":"丁臣","text":"山僧野老远逢迎，指点清泉笑语同。\n近日帝前枢轴老，旧来亭上醉吟翁。\n林峦自古名虽胜，事物因人地转雄。\n从此州民增壮观，岘山非独有羊公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中","author":"丁西湖","text":"金门待漏马嘶寒，月落宫墙未晓天。\n争子莫教容易扫，恐伤一片惜花心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送吴菊潭游越","author":"丁西湖","text":"春江柳色新，别酒易成醺。\n自厌久为客，难堪又送君。\n溪晴沙度鹤，地暖水生云。\n若到兰亭上，应须吊右军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚坐","author":"丁伯桂","text":"小雨流花急，香风随晚荷。\n清天闻野磬，高木乱秋波。\n人度红桥少，灯来溪径多。\n幽冥间一坐，深恐负苍萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏莎行 其一","author":"丁求安","text":"风卷霜浓，寒销冰谢。\n一年皎月惟今夜。\n桑弧蓬矢庆门阑，云旌羽盖连车马。\n命服新翻，恩波如泻。\n海沂致锦傅声价。\n晓来和气着梅梢，春随温诏看看下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏莎行 其二","author":"丁求安","text":"紫府延龄，瑶池开宴。\n人间好事都如愿。\n凤雏喜带桂宫香，东床镇压鸾台彦。\n酒泛金杯，香飘龙篆。\n大家齐把瑶觞献。\n中兴天子急贤才，相期共入金銮殿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浯溪","author":"丁叔岩","text":"相去祁阳五里馀，撼山为谷断为溪。\n河南刺史老文学，石上真□健笔题。\n风月满堂无地着，云烟半壁与天齐。\n英雄说着唐朝事，泪溅长安蜀道西。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵十五日菊 其一","author":"丁宝臣","text":"秋香多日閟英华，霜脱离离抱砌斜。\n趁节不随时俗眼，近冬真是岁寒花。\n摛辞旧入骚人笔，载酒谁寻醉令家。\n曾读南华齐物论，均无迟速可惊嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和慧山泉","author":"丁宝臣","text":"谁识澄渊万古清，潢污扰扰谩纵横。\n出从山底应无极，流落人间自有声。\n江汉想能同浩渺，尘沙虽混更分明。\n从来旱岁为膏泽，安用茶经浪得名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"招通判沈兴宗游五泄","author":"丁宝臣","text":"路缘萝茑荫杉松，翠壁丹崖不计重。\n天作锦屏环十里，僧开朱屋面千峰。\n花閒越鸟钩辀语，溪外秦人髣髴逢。\n早晚车驺到山下，篮舆多日待追从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题崇法院","author":"丁宝臣","text":"濒湖三寺倚峥嵘，梵刹相高对县城。\n楼殿尽知随处盛，山林独爱此中清。\n剪开木末檐牙出，凿破岩腰磴道成。\n悟得祖师心印法，禅僧遥指塔灯明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游五泄书呈完夫节推","author":"丁宝臣","text":"莫厌幽寻路险辛，细思容易是山神。\n能收地巧藏深处，不惜天奇示俗人。\n古有少陵吟未到，今无摩诘画难真。\n海边见说天童好，祗待君诗判等伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题慧山翠麓亭","author":"丁宝臣","text":"谛看轩轩面翠微，暂来登此已忘机。\n地连佛寺楼台古，泉落山田稻蟹肥。\n晓径忽穿清气入，夜船多载白云归。\n世人谁识红尘外，终老功名未拂衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和永叔新晴独过东山","author":"丁宝臣","text":"芳辰百五前，选胜到林泉。\n万树绿初染，群花红未然。\n阴岩犹贮雪，暖谷自生烟。\n妇汲溪头水，人耕草际田。\n日中林影直，风静鸟声圆。\n健令多情甚，寻春最占先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵十五日菊 其二","author":"丁宝臣","text":"寒芳开晚独堪嘉，开日仍逢小雨斜。\n秋尽亭台凋木叶，月圆时节伴蓂花。\n幽香不入登高会，清赏终存好事家。\n黄蕊绿茎如旧岁，人心徒有后时嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田母拒金图","author":"丁易东","text":"噫嘘嚱，人奔奔，皆为名利之所役，贤反愚兮明反昏。\n夜却金兮尚高洁，择一钱兮义同颉。\n莱芜甑中尘扑飞，悬鱼老子肝似铁。\n四公皦皦何不墨，图中但见齐田稷。\n蠹吏亏纲勿足誇，特貌慈闱耀贞德。\n奉君本欲娱亲喜，阿母怒兮惊且愧。\n若使当年一纳间，那得芳名播青史。\n主圣亲贤臣涤衷，公金赐妪恩爱隆。\n非独舍之罪不诛，昭昭淳化扬仁风。\n我披此传重踟蹰，岂独田卿贪若斯。\n谓语今人知不知，偷安苟富诚何如。\n老万翁，志不渝，费千金，畜此图。\n此图传后世，后世重义轻金与。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无闷","author":"丁注","text":"风急还收，云冻又开，海阔无人剪水。\n算六出工夫，怎教容易。\n刚被郢歌楚舞。\n镇独向，尊前夸轻细。\n想谢庭诗咏，梁园赋赏，未成欢计。\n天意。\n是则是。\n便下得控持，柳梢梅蕊。\n又争奈、看看渐回春意。\n好趁东君未觉，预先把、园林都装缀。\n看是处，玉树琼枝，胜却万红千翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙都山","author":"丁宣","text":"世上洞天三十六，缙云第二十九区。\n古木参天架云屋，总真灵迹号仙都。\n独峰壁立二千尺，凌空耸翠屹然孤。\n仰瞻绝顶烟岚际，曾开菡萏名鼎湖。\n旧说轩辕驻车辙，云骈风驭经此涂。\n石釜鍊灶丹砂就，乘龙帝乡才须臾。\n紫虚碧落超尘世，侍臣无路攀龙须。\n唐朝天子仙李裔，德格天心来瑞符。\n祥烟嘉气卿云布，山中九传万岁呼。\n步虚对峙云断续，东西互云高下殊。\n涧边幽径登鸟道，上有镜岩如方壶。\n岩中乳水沥嵌罅，滴石成穴如仰盂。\n水一昼夜斛加半，潦不泛溢旱不枯。\n鲁望曾记周景复，绝粒餐霞黄老徒。\n栖真妙入悬珠会，八十馀年隐此居。\n千古寥寥桑海变，仙迹渺邈还有无。\n石门瀑布虽云好，此间殊胜未易俱。\n特然造化钟神秀，虎头妙手亦难图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六么令","author":"丁宥","text":"清阴一架，颗颗蒲萄醉花碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水龙吟","author":"丁宥","text":"雁风吹裂云痕，小楼一线斜阳影。\n残蝉抱柳，寒蛩入户，凄音忍听。\n愁不禁秋，梦还惊客，青灯孤枕。\n未更深，早是梧桐泫露，那更度、兰宵永。\n空叹银屏金井。\n醉乡醒、温柔乡冷。\n征尘倦扑，闲花谩舞，何心管领。\n葱指冰弦，蕙怀春锦，楚梅风韵。\n怅芙蓉城杳，蓝云依黯，锁巫峰暝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"失调名 寒梅","author":"丁宥","text":"疏绮笼寒，浅云栖月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"法曲献仙音","author":"丁宥","text":"蝉碧句花，雁红攒月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴山县","author":"丁带","text":"潇洒吴山县，居民近百家。\n孤城连阜起，小市枕溪斜。\n土润宜栽竹，泉甘好试茶。\n公馀无一事，何处息纷华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"碧桃春/阮郎归","author":"丁持正","text":"几年辛苦捣元霜。\n一朝琼粉香。\n云英缥渺曳仙裳。\n相将骑凤凰。\n鍧帝乐，酌天浆。\n千年颜色芳。\n从兹归去白云乡。\n碧桃春昼长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东山","author":"丁逢","text":"水绕山围夏木苍，旧时贤相读书堂。\n窗间远岫供吟遍，来倚阑干半月凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"八咏楼","author":"丁逢","text":"槛外溪山缥缈楼，共看雨歇涨痕收。\n天开图画无穷态，峡束盘涡自在流。\n赋咏偶然休吊古，登临政尔可销忧。\n邛徕九折经行遍，又向东吴寄此游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝农香山","author":"丁逢","text":"宿云留润欲侵衣，草长山腰路溅泥。\n映屋画图花远近，接畦湍濑水高低。\n人趋南亩生涯乐，春入东菑土脉齐。\n说与老农还自笑，近来辛苦惯扶犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"到郴","author":"丁逢","text":"眼界山逾碧，腰舆步转高。\n未疑禦魑魅，自笑尹鼯猱。\n末路成三折，衰年感二毛。\n次山虽漫仕，安敢遽辞劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后十日重游","author":"丁逢","text":"层楼重到已经旬，远岫晴岚发兴清。\n风送炎天堕冰雪，香清仙界引星辰。\n茶瓜暂唤林间客，杖履长输物外人。\n便欲从游赤松子，君恩应许乞微身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次袁尚书巫山十二峰二十五韵","author":"丁逢","text":"半雨半晴山弄姿，湿云吹风不成痴。\n蘼芜渐遍楚宫碧，葡萄未涨巴江迟。\n西南大尹初涉境，山川效职加瑰奇。\n翠屏窥窗故娟妙，松峦映掩相参差。\n浮云击汰睨青壁，灵君一去今安之。\n吟情浩荡隘宇宙，万景敢云骄莫随。\n当年楚境半天下，孱王醉梦方昏疲。\n珊瑚玉佩赤帝女，星髾羽盖蜺旌旗。\n锡符赐荣岂无意，侍臣托讽褰帱帷。\n尹今文采继骚雅，梦得诗魂羞竹枝。\n吾行一百八盘上，钻天但觉天云低。\n荒荒野驿虎豹怒，阴阴岭树猿猱嬉。\n危登险陟倦三伏，口呿背浃嗟胡为。\n岂知舟行有奇观，山灵秘惜留归时。\n青帘白舫夙已具，芒鞋布袜将从兹。\n胸中丘壑未尘土，头上岁月从驱驰。\n虽无胜具逐支许，尚有乐趣同周施。\n何当投劾便归去，发船打鼓清江湄。\n更催尺一唤公觐，同看二六浮修眉。\n常山蛇阵想鱼腹，建溪龙焙倾蟆颐。\n摊钱昼浪看三老，杖藜晚岸寻名缁。\n昔人汶岭寄书帖，更歌蜀道先吁嘻，未若尹外岳牧中丞疑。\n惠爱春江之赴沧海，清明秋月之挂峨嵋。\n尽驱三峡波涛笔，第入思齐访落诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠姜邦杰 其一","author":"丁逢","text":"人间谁得似留侯，何但功名唾手收。\n皮里阳秋有公论，胸中泾渭不同流。\n餐梨久验轻身诀，辟谷长怀许国忧。\n傥非暮年专一壑，岂能真伴赤松游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"丁逢","text":"山来分楚越，水落会蒸湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"榴皮题壁","author":"丁逢季","text":"水云深处扣仙居，对酌春风夜有馀。\n说遍东南耆旧话，始知胜读十年书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜居","author":"丁高林","text":"圯上求西舍，隆中买北邻。\n种花行造化，移竹试经纶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中吟","author":"丁高林","text":"万红千紫画乾坤，绿染江南江北村。\n文鸟双飞鱼作队，好花生子竹添孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村舍柳","author":"丁高林","text":"邮亭折尽为分携，争得长条拂地垂。\n何似竹篱茅舍畔，新年不减旧年枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对菊","author":"丁高林","text":"几本仅成畦，山晴手自栽。\n花逢新过雁，根带旧移苔。\n正色通骚籍，清香入酒杯。\n傥无陶靖节，今古为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀胡怡斋府教","author":"丁高林","text":"未得多时别，无时不念君。\n池深春草雨，天远暮山云。\n去雁情千里，残蝉思十分。\n不知明月夜，曾复望乡枌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄龙岩张节翁","author":"丁高林","text":"归向龙岩岩下房，又添移竹种松忙。\n江湖万事孤灯夜，风月千篇满镜霜。\n日暮乌栖梧叶落，天晴雁过菊花香。\n诚知道义相忘处，岂恨云山隔渺茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题石好山诗卷","author":"丁高林","text":"得趣贪山好，山翁清更癯。\n琴诗立门户，姓字出江湖。\n步月寻松子，锄烟补菊株。\n相携多道义，谁可与同徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山","author":"丁高林","text":"东皇太一司花命，花落花开老岁华。\n天地精英无着处，今朝开到牡丹花。\n千山桃李尽舆台，独有梅花是相材。\n定是傅岩传得种，年年商正又花开。\n红尘世界梦都迷，我正闲吟得意诗。\n夜气清时天地别，梅花头上看参旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋霜阁","author":"丁惟","text":"高阁何年结构成，朱帘捲处眼偏明。\n阶前古木寒云色，涧底流泉碎石声。\n山近烟岚浮几席，楼高星斗在檐楹。\n我来三伏炎蒸候，便觉清风两腋生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九华山","author":"丁谓","text":"宿月鸥凫立浅沙，落花芦荻露人家。\n天寒夜静长无物，一片清江浸九华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山","author":"丁谓","text":"嫩云零落树参差，忽见千峰豁所思。\n酷爱似看名手画，难题却忆古人诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"广利","author":"丁谓","text":"出城数里即青山，路入青松白石间。\n只合步行寻石径，不宜呵喝入松关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以诗送宣赐进奉红绡封龙字茶与琏禅师","author":"丁谓","text":"密缄龙焙火前春，翠字红绡熨眼新。\n品味至高谁合得，双林树下上乘人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3258,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游郭希吕石洞二十咏 其十六 韬玉","author":"刘过","text":"至宝不自献，韬藏亦英华。\n馀香被草木，秀擢幽岩花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3259,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏答白稹","author":"丁谓","text":"欺天行当吾何有，立地机关子太乖。\n五百青蚨两家阙，白洪崖打赤洪崖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3260,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]