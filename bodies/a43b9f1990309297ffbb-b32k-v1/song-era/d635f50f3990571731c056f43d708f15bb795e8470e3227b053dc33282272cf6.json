[{"title":"西征范田遇雪三绝 其二","author":"陈淳","text":"饱啖炊粱莱菔羹，皂台催促赶前程。\n手携竹杖足穿革，缓拨琼花徒步行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20455,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西楚霸王庙二绝 其一","author":"陈淳","text":"气压关河力拔山，绝人武勇更无前。\n若于今代当戎寄，子弟何须用八千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20456,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西楚霸王庙二绝 其二","author":"陈淳","text":"辙乱旗靡绕旧畿，烽烟起处羽书驰。\n思君一剑为平荡，盖世英魂知不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20457,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过衢州第二程见麦雪中青","author":"陈淳","text":"雪过三衢越厚埋，却于农事不为灾。\n今朝方尔半融释，陇麦青青奋出来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20458,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居杂咏三十二首 其十七 手","author":"陈淳","text":"手所以司执，所执必正事。\n回德谨勿持，持必为痿痹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20459,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居杂咏三十二首 其十五 目","author":"陈淳","text":"目所以司视，视正乃为明。\n非礼谨勿睹，睹之则为盲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20460,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居杂咏三十二首 其三 礼","author":"陈淳","text":"礼者人之门，节文自中根。\n所主一以敬，出入无不存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20461,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居杂咏三十二首 其十四 耳","author":"陈淳","text":"耳所以司听，听正乃为聪。\n匪彝谨勿闻，闻之则为聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20462,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居杂咏三十二首 其五 孝","author":"陈淳","text":"孝以事其亲，斯须不离身。\n始终惟爱敬，二者在书绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20463,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居杂咏三十二首 其二十四 笃行","author":"陈淳","text":"学问思辨者，于中瑩且精。\n欲实据而有，要在笃于行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20464,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居杂咏三十二首 其六 悌","author":"陈淳","text":"悌以事其兄，温恭尽乃情。\n出门惟敬长，内外一于诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20465,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和卓廷瑞赠诗之韵四绝 其四","author":"陈淳","text":"我愧年几六十秋，时华虚度事优柔。\n头云皓矣未闻道，深藉磨砻与勿休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20466,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和卓廷瑞赠诗之韵四绝 其三","author":"陈淳","text":"长书一卷墨新题，志在斯民寿域跻。\n历历爱君忧国语，施行须自起锄犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和卓廷瑞赠诗之韵四绝 其一","author":"陈淳","text":"一见襟怀便豁然，交情输写意忘年。\n倾囊经训璠玙富，与我从头细细传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和卓廷瑞赠诗之韵四绝 其二","author":"陈淳","text":"日复陪游泮水湄，发挥史学到渊微。\n直从天理人心处，剖破存亡治乱机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和傅侍郎至临漳感旧十咏 其四 和访晦翁庐已毁","author":"陈淳","text":"燕游规画孔明庐，陈法区藏梅李株。\n慨想先儒遗意远，能将旧观一还无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和傅侍郎至临漳感旧十咏 其三 和行郡圃","author":"陈淳","text":"郡圃森森几阅春，一番太守一番新。\n何如今日同行乐，綵袖恭陪紫橐人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和傅侍郎至临漳感旧十咏 其二 和阅题名","author":"陈淳","text":"黄堂盛事据今论，向日郎君忠肃孙。\n依旧诚心劳抚字，漳民世世沐深恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和傅侍郎至临漳感旧十咏 其七 和访水云馆","author":"陈淳","text":"云移月色爽人看，雨趁潮声迅拍栏。\n自是与民同乐地，何妨一整复前欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和傅侍郎至临漳感旧十咏 其十 和下山","author":"陈淳","text":"台前一带绕漳溪，台下回环万象齐。\n就拓宏模须大手，非为谄语病丁畦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和傅侍郎至临漳感旧十咏 其一 和始至","author":"陈淳","text":"阳复东郊雨阁丝，欢迎父老拥车随。\n竞传碧眼朱颜在，宛若当年剖竹时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和傅侍郎至临漳感旧十咏 其五 和访古榕茅亭","author":"陈淳","text":"老榕盘郁植根深，意到扶藜赏绿阴。\n天理流行随寓足，何心故步与追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和傅侍郎至临漳感旧十咏 其九 和登临漳台","author":"陈淳","text":"三山昂首状魁嵬，虎踞龙蟠萃一台。\n若跨地灵规贡宇，英才衮衮拔条枚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和傅侍郎至临漳感旧十咏 其八 和游柑橘园","author":"陈淳","text":"南州佳品胜罗浮，青女飞花任打头。\n寒涸更深香更烈，松朋梅友敢凌不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和傅侍郎至临漳感旧十咏 其六 和访西山爽气","author":"陈淳","text":"依山种竹衬山佳，傍水栽花水妒霞。\n一意生生俱好玩，休分红翠有无遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送瘳子晦倅潮还别四绝 其四","author":"陈淳","text":"圣贤事业浩无疆，未易孤闻寡见穷。\n友善更资天下士，时推一二附南鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送瘳子晦倅潮还别四绝 其二","author":"陈淳","text":"使车南骛过吾邦，幸挹端严毅直风。\n多谢两年勤尺素，谆谆频为发童蒙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送瘳子晦倅潮还别四绝 其三","author":"陈淳","text":"松窗梅雪岁寒馀，奉别城东古驿头。\n君去有行应可乐，我来独学重为忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送瘳子晦倅潮还别四绝 其一","author":"陈淳","text":"紫阳门户耸参天，骈往纷来几计千。\n谁立脚跟老弥笃，交溪原上有深传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"铅山遇霜","author":"陈淳","text":"冒风冒雪冒霜寒，手足胼胝百状艰。\n只为胸中春一点，未能忘世卧溪山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隆兴书堂自警三十五首 其三十五","author":"陈淳","text":"成汤之盘铭，新焉旦复旦。\n未闻作圣功，毫釐有间断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隆兴书堂自警三十五首 其三十一","author":"陈淳","text":"质暴难入德，心粗宁配义。\n君看箪瓢人，磨砻极醇粹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隆兴书堂自警三十五首 其二十九","author":"陈淳","text":"开卷必起敬，肃容正冠襟。\n如侍圣贤侧，亲承謦欬音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隆兴书堂自警三十五首 其二十三","author":"陈淳","text":"心藏隐奥中，乘间亦易动。\n须于动之微，坚持勿使纵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隆兴书堂自警三十五首 其十五","author":"陈淳","text":"知以达其行，行以精其知。\n二者互相发，不容偏废之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隆兴书堂自警三十五首 其十三","author":"陈淳","text":"辅仁贵有益，谨毋友善柔。\n良心放则死，胡为乐佚游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隆兴书堂自警三十五首 其十","author":"陈淳","text":"细味古人书，惕焉重深惭。\n循首以至足，百无一二三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隆兴书堂自警三十五首 其四","author":"陈淳","text":"茫茫八极内，何莫非斯人。\n苟非富道义，何异彼黔民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游雷峰塔处晦上人求诗","author":"陈淳","text":"摆脱人间名利缰，湖山深处事韬藏。\n要知晦里真消息，养取灵台一点光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"紫溪遇日","author":"陈淳","text":"日露雪头红玉盘，氤氲和气霭人寰。\n回眸万素无从觅，依旧千山列翠鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"横逆自广三绝 其二","author":"陈淳","text":"乐天一说见轲书，岂是高谈强解渠。\n牛马蚊虻无足校，不须芥蒂此襟裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"横逆自广三绝 其一","author":"陈淳","text":"汤文事小岂为迷，物我从来绝町畦。\n胸次洞然天地阔，本无南北与东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"横逆自广三绝 其三","author":"陈淳","text":"仁人方寸万机空，片逆何能介此中。\n视尔恰如风动竹，在予安有竹嫌风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题江郎庙六绝 其四","author":"陈淳","text":"礼经岳渎视公侯，只谓祠仪一例修。\n不识鬼神情状者，错将经意以人求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题江郎庙六绝 其一","author":"陈淳","text":"三石参天作柱擎，自从开辟便峥嵘。\n何为末俗为奇怪，尽道江郎魄化成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题江郎庙六绝 其六","author":"陈淳","text":"礼学无人发世蒙，正神流弊与妖同。\n既非气类相求者，岂解精诚妙感通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题江郎庙六绝 其三","author":"陈淳","text":"好看三石绝奇踪，自是山灵气所钟。\n致雨兴云功利博，合编祀典以神封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题江郎庙六绝 其五","author":"陈淳","text":"峙立嶆峨本石形，人其庙貌据何经。\n祗宜坛壝为民祷，时雨时旸便是灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题盖竹庙六绝 其六","author":"陈淳","text":"升沉大分系于天，决匪人谋所必然。\n告尔往来通达者，不须赘赘鬼神前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题盖竹庙六绝 其五","author":"陈淳","text":"大都流俗急荣名，切切于中梦自形。\n附会便为神所告，神明虚得号通灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题盖竹庙六绝 其四","author":"陈淳","text":"至人神定气常清，夜息虚明一若醒。\n假使妖祠能献兆，如何窥得此门庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题盖竹庙六绝 其一","author":"陈淳","text":"人心污物本来灵，动静那分晦与明。\n昼接事为思有主，夜思无主梦因成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题盖竹庙六绝 其三","author":"陈淳","text":"世人莫悟此端原，兆自心机辟阖间。\n却向妖祠求證应，妖祠于我固何关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大浆岭","author":"陈淳","text":"大浆陟降几千层，积雪朝来错去程。\n溜石琼花新琢就，平田玉镜恰尘成。\n不嫌冻气侵肌慄，最爱清姿照胆明。\n聊把杖头敲击处，那忘疲苶旅中情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子方宗弟侧弄之璋","author":"陈淳","text":"珍祥充塞故旁流，底信先传庆有由。\n莫讶鸡胞宁吐凤，须知虎气已吞牛。\n古来孽士皆荣达，此日宗支自颖尤。\n蛰蛰绳绳从未艾，会看贵种出公侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"不赴十姊初度之席","author":"陈淳","text":"吾姊今朝庆诞辰，奈何贱弟亦同伦。\n汝逢寿考荣双老，我感劬劳悼昔人。\n赞祝欲陪千岁愿，追思难遏寸心真。\n一欢一戚应殊分，只任天情不必均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"分水岭","author":"陈淳","text":"宝贝山前去，琼瑶世界行。\n蜡鞋穿瑟瑟，竹杖独铿铿。\n冻色迫毛窍，寒光射眼晴。\n酒亭何处认，速欲一壶倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无言上人求诗依黄簿韵","author":"陈淳","text":"休说西来几许年，此身动静莫非禅。\n须知天理流行妙，不待人言髣髴传。\n运水搬柴存实则，著衣吃饭即当然。\n若能默悟真消息，剖破诸空亿大千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四月十八日喜雨再用前韵呈郑宰","author":"陈淳","text":"民间霓望正频倾，天泽如期为养耕。\n终夜连朝淋不住，上畦下亩浸皆盈。\n春来又见兹浓霈，秋穫何愁弗满情。\n感格一机无外事，气和端自有和声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对葵","author":"陈淳","text":"开阖随阳自晓昏，轻如绡縠净瑶琨。\n淡黄相枕五重靓，浓紫深藏一窍浑。\n熟视绝无妆点态，细看不见剪裁痕。\n谁能会取个中意，与玩乾坤造化根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平坦雪兼风雨","author":"陈淳","text":"自从平坦望衢南，值雪霏霏日日添。\n既挟狂风和面扑，又偕猛雨向身沾。\n手拈纸伞凝犹痹，足踏皮鞋冻亦渐。\n那识坚刚金石操，于中凛凛独争严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"权长泰簿喜雨呈郑宰","author":"陈淳","text":"夜雨滂沱一若倾，朝来南亩足春耕。\n相呼荷耒奔趋急，便与担秧插莳盈。\n令尹精诚知到处，上天仁爱见真情。\n从今可释悬悬望，百里已无愁叹声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西征过仙霞雪晴","author":"陈淳","text":"自入仙霞十里程，满山晴雪射虚明。\n路从宝贝洞中去，人在琼瑶世界行。\n枯木竞传千状巧，荒崖亦作十分清。\n回环四望真奇观，识破乾坤洒落情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西征黄莲坑遇雪","author":"陈淳","text":"行入黄莲北，风严雪又加。\n满山罗玉树，遍地错琼花。\n清洒姿无颣，虚明质不华。\n瘴眸为一洗，惊觉若仙家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过江山遇雪","author":"陈淳","text":"江山方进半程前，正值群游剪水仙。\n满道盐花堆粲粲，飞空粉屑舞翩翩。\n樊墙庐舍皆银饰，沟渎潢污尽玉瑱。\n却认青山埋不得，嶆峨气势直凌天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邻舍横逆","author":"陈淳","text":"茫茫薄俗沸蚊蛆，礼义全无一点馀。\n只得杜门对贤圣，专来教子读诗书。\n千般横直休干己，一切是非无问渠。\n若救乡邻为被发，风波转起挠吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依赵尉狱空韵上陈宰","author":"陈淳","text":"民沐仁风状小儿，陶陶远罪日何知。\n圜扉草色春长茂，公舍棠阴昼缓移。\n谁复鼠牙纷击剥，类将鸡黍乐追随。\n涂歌里咏喧传处，尽是吾侯德政碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和丁大咏史君祷雨之韵","author":"陈淳","text":"史君持志一恭谦，何间幽明与巨纤。\n渴雨方将为旱闵，卧龙便不复泥潜。\n连宵颇作霶?注，阖郡均蒙优渥沾。\n窃喜阳春端有脚，闾阎和气日须添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陈侍郎韵寄题林尉尚絅堂","author":"陈淳","text":"中庸尚絅示诸儒，为己何心世毁誉。\n只要美中存德本，无容饰外事文馀。\n鱼潜理趣真如灼，屋漏工夫的不虚。\n珍重子思深属意，一言纲领此篇书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陈侍郎韵寄题林尉肯堂","author":"陈淳","text":"肯堂题扁自名公，表里须教实一同。\n门阅不誇车马大，家声端藉礼诗隆。\n熟仁便足膏粱味，殉义能传清白风。\n终始此生无忝处，精诚妙与古人通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陈叔馀韵二首一以谢来意一以勉之 其一","author":"陈淳","text":"碌碌平生学，惭无席上珍。\n仅馀守师训，岂欲衒时人。\n误入侯门听，翻劳友义陈。\n愿从温故业，庶或稍知新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和陈叔馀韵二首一以谢来意一以勉之 其二","author":"陈淳","text":"此道何曾远，吾儒自有珍。\n反求皆在我，中画岂由人。\n利善分须白，知行语未陈。\n若能祛旧见，明德日惟新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和梅韵","author":"陈淳","text":"不妨雪压与霜糊，友结松筠鄙橘奴。\n特放孤标先煖觉，肯随众卉望寒逋。\n疑将冰月为精爽，端借琼瑶琢体肤。\n闯出一元生物意，从兹引领万容姝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":20527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]