[{"title":"天香 宛委山房拟赋龙涎香","author":"冯应瑞","text":"枯石流痕，残沙拥沫，骊宫夜蛰惊起。\n海市收时，鲛人分处，误入众芳丛里。\n春霖未就，都化作、凄凉云气。\n惟有清寒一点，消磨小窗残醉。\n当年翠篝素被。\n拂馀薰、倦怀如水。\n谩惜舞红犹在，为谁重试。\n几片金昏字古，向故箧聊将伴憔悴。\n□□□□，□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万州","author":"冯时行","text":"银珠络髻绣衣裳，家住江南山后乡。\n闻道君侯重行乐，相将腰鼓迓年光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"茶岭","author":"冯时行","text":"翠岭依然在，芳根久已陈。\n山灵如感旧，亦合厌荆榛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题庞宫使提举山斋二绝 其一","author":"冯时行","text":"才及中年便买山，山中何事可怡颜。\n当时白傅登临眼，物色浑归几案间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题庞宫使提举山斋二绝 其二","author":"冯时行","text":"白衣苍狗变浮云，过眼纷纷不可论。\n晚岁逢迎真耐久，青山相对两忘言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涪州北岩","author":"冯时行","text":"晴著春江镜样光，扁舟来炷佛前香。\n山从幽处亭亭绿，日倚闲边故故长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落花十绝 其一","author":"冯时行","text":"枝头日日候韶妍，百舌声中又隔年。\n莫道山翁无思绪，见人踏著便悽然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落花十绝 其十","author":"冯时行","text":"朝来酌酒尚芳菲，醉眼醒时已觉稀。\n苦妒妖饶莺拂下，解怜飘泊燕衔归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落花十绝 其二","author":"冯时行","text":"著花著酒苦相留，嗔雨嗔风毕竟休。\n有态游扬元妩媚，无心点缀亦风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落花十绝 其五","author":"冯时行","text":"恼教衰病倩人扶，掩得疏慵倒酒壶。\n半湿垂垂粘醉帽，全轻冉冉上吟须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落花十绝 其九","author":"冯时行","text":"瘦筇随意步晴沙，困卧江头野老家。\n桃李盈门春寂寂，莺惊睡觉一床花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落花十绝 其八","author":"冯时行","text":"幽栖竹路满苍苔，花拥柴扉午未开。\n可是春风料理得，时吹一片过窗来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落花十绝 其六","author":"冯时行","text":"半去还来绕旧丛，半随胡蝶便西东。\n从交满地无人扫，快意甘心薄倖风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落花十绝 其三","author":"冯时行","text":"万翠千红锦一张，春秋何处不芬芳。\n谁教无赖狂风雨，收作年华入鬓霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"稽古堂诗为曹应祥题","author":"冯时行","text":"稽古堂前雨半天，濛濛山色思依然。\n几多心事催霜鬓，零落梅花又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汉初东岩","author":"冯时行","text":"疏官寂寂解行衣，脱木萧萧立翠微。\n江带暝烟随意曲，鸟翻落日向人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日邀郭信可登龙鹤山","author":"冯时行","text":"已脱青衫付酒家，请君含笑岸乌纱。\n百年行见星星发，一醉须还岁岁花。\n令甲许人休吏卒，峰峦邀客上烟霞。\n龙山故事依然在，莫把风流让孟嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月将半雨过花盛开二首 其二","author":"冯时行","text":"最怜半见或不见，更惜欲开犹未开。\n树远祇疑随水去，枝低还似傍人来。\n不堪小蕊樽前落，可忍残红砌下堆。\n著尽工夫春自去，不须风雨恶相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二月将半雨过花盛开二首 其一","author":"冯时行","text":"一年青春日无几，二月小雨花齐开。\n底事我禁愁思得，可能不近酒杯来。\n山青树树明于缬，江远村村烂作堆。\n老罢兴来须抖擞，自吟诗句自相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十七日夜月色尤佳与韦去非东亭小酌","author":"冯时行","text":"秋来瑶海浴婵娟，天上人间又一年。\n有酒何妨三夜看，无云尚见九分圆。\n楼台迥忆仙游眼，村落遥思禁曙烟。\n斗柄衔山风露冷，归来清绝不成眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和子应游万州岑公洞","author":"冯时行","text":"泉细或疑雨，岩深微见天。\n暂来如可老，长往不难仙。\n石髓层层落，松声树树传。\n欲归重回首，明月傍船舷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上知己","author":"冯时行","text":"十年宦海尘埃客，文墨于人有底功。\n天远宁知心匪石，官卑不许气如虹。\n唐虽未老行将老，衍不应穷究竟穷。\n何日得君天上去，收云拾雨借长风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋探韵坤字","author":"冯时行","text":"山雨连秋懒出门，婵娟佳节更堪论。\n一年有限天知已，万里无云月返魂。\n淡影参差收海岳，清光浮动洗乾坤。\n拟凭樽酒相酬答，遮莫沈沈下别村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云安下岩二首 其二","author":"冯时行","text":"曩游成断梦，再至是陈人。\n揽景追前迹，寻诗拂旧尘。\n孤松难破冻，细草易生春。\n晴日江天好，凭栏愁更新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云安下岩二首 其一","author":"冯时行","text":"系缆江沙静，杖藜岩谷春。\n花依竹色好，草入涨痕新。\n占笋苔初破，尝梅客遽颦。\n篙师勿槌鼓，幽兴苦留人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日二首 其二","author":"冯时行","text":"日月新年节，乾坤旧观还。\n郁葱浮晓雾，紫翠动晴山。\n御气笼宫阙，朝班杂佩环。\n遥知王会散，喜色粲天颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日二首 其一","author":"冯时行","text":"谷旦休祥见，元朝氛祲开。\n日车扶晓出，斗柄斡春回。\n致理归廊庙，私忧尚草莱。\n太平岂无象，天意是胚胎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天华寺亭二首 其二","author":"冯时行","text":"一亭开浩荡，千载纳幽閒。\n日色射丹巘，秋姿凝翠鬟。\n人家屏上见，鹭点镜中还。\n冷宦惊人眼，无妨饱看山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天华寺亭二首 其一","author":"冯时行","text":"老去心如水，眼明犹爱山。\n偶来出己意，特为破天悭。\n能使渺茫处，尽归寻丈间。\n公馀成践蹂，心事等云閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"日望冉雄飞之来久不闻近耗因成鄙句以见翘然之思","author":"冯时行","text":"缓辔微吟自不催，看山下马想徘徊。\n阳春白雪久不听，日暮碧云殊未来。\n已戒儿童篘熟酒，更勤风雪化新梅。\n云间飞舄何时下，抑郁孤怀迟一开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月夜","author":"冯时行","text":"秋立雨新霁，气清云自消。\n地空银海阔，天净玉丸跳。\n把砚承明露，扶儿看碧霄。\n病禁凄冷得，不惜到明朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见张魏公二首 其二","author":"冯时行","text":"四海于今望治安，当头退避也应难。\n是非历历开新听，变化纷纷入静观。\n孰把后图歌寤枕，再将前事倚危栏。\n重拈今古看奇特，幸记尘冠久不弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"见张魏公二首 其一","author":"冯时行","text":"危机易蹈退难安，进退如公地最宽。\n忧国忧家双鬓白，通天通地一心丹。\n久虚海宇苍生望，专结庭帏綵绶欢。\n终始哀荣情罔极，谁云忠孝两全难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代简寄壁山诸友慈洞砚","author":"冯时行","text":"闻道诸郎长似林，临池已遣学山阴。\n信传鸿翼兼双砚，物比鹅毛表寸心。\n书札总无缘懒病，襟怀堪寄有孤吟。\n归装准拟随春色，岁酒须留待细斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至有感","author":"冯时行","text":"萧辰俛仰及严冬，白发空云是至公。\n造雪不成天本恕，唤梅未醒句无功。\n可能人事无消长，只待天时有变通。\n节物相关愁似醉，一庭霜叶一窗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卢秀才家食梨","author":"冯时行","text":"屡款卢仙贡玉堂，谷梨霜饱每分香。\n冰圆咀液凉疏齿，金醴吞甘浣热肠。\n误诮斧斤讹鲁简，骇听名字笑吴娘。\n好同火枣供嘉品，端比蟠桃味更长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白云安尉出戍至夔州","author":"冯时行","text":"戍鼓黄云外，征夫白帝东。\n风林行啸虎，雨夜飒哀鸿。\n路入山光静，村含晚色空。\n岚烟欺眼力，不见鹿皮翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再登岳阳楼","author":"冯时行","text":"楼高临迥渚，天阔上丹梯。\n云尽树不去，水平天更低。\n江湖分去住，吴楚亘东西。\n遐瞩宽幽抱，愁多望转迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同王公佩和老杜韵 其一","author":"冯时行","text":"新长筼筜竹，傍穿薜荔墙。\n夜须邀月坐，昼不待风凉。\n剩放梢添绿，斜将箨抱香。\n幽居绝还往，相伴兴何长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同王公佩和老杜韵 其二","author":"冯时行","text":"敝屋甫环堵，此君忧面墙。\n当窗蔽寒绿，入坐荐清凉。\n客咏閟馀响，佛薰留散香。\n老成看气骨，霜雪表灵长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁暮舟次荆州呈李尧俞","author":"冯时行","text":"肃霜闻渡雁，湖海发归船。\n烟树开吴泽，风帆尽楚天。\n经过成往事，信宿是明年。\n诗句随元礼，云山共一天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早行","author":"冯时行","text":"马入寒林惊宿鸦，羸僮呵手怯霜华。\n已经残月路数里，知过安眠人几家。\n呖呖晓乌天外唱，疏疏烟树岭头斜。\n前程自谓明时近，不用孜孜苦叹嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有感","author":"冯时行","text":"俛首趋时独自嫌，年来壮胆尚相淹。\n神锋不及锥头利，花蜜翻亏蔗尾甜。\n万里水云閒有约，一床坟籍静无厌。\n明珠自得非他得，懒更骊腮著手拈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自行在解维宿长安闸下回望天竺诸山依依在目微臣去国抚事感伤因成此诗","author":"冯时行","text":"归来岂不好，去国意如何。\n主圣忧思切，时危习俗讹。\n山高更回首，天阔阻悲歌。\n一寸丹诚地，馀生感愤多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至日三首 其三","author":"冯时行","text":"令节仍长至，公家放小休。\n愁城开六府，醉眼见千忧。\n梅萼含春小，云容带雨收。\n曦娥自来往，生理百年浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至日三首 其二","author":"冯时行","text":"至日寒无赖，今朝愁奈何。\n两宫黄屋远，二老白头多。\n圣主今尝胆，皇天忍荐瘥。\n乾坤为回首，慷慨一悲歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至日三首 其一","author":"冯时行","text":"太史书云日，周家纪历年。\n一樽供笑里，五载客江边。\n城暗催春雨，山连作雪天。\n功名惊过隙，节物自推迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"至日读庄子","author":"冯时行","text":"世路频时节，山城暗夕烟。\n酒先回暖律，梅自断残年。\n日月长江水，功名小井天。\n如何割幽抱，更与问虚玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中见月","author":"冯时行","text":"濮上今秋月，于人大有情。\n银盘随水涌，素练截江横。\n岸阔天光近，船虚夜月明。\n寒光迷上下，万里一心清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中观雪呈李尧俞二首 其二","author":"冯时行","text":"密雪晚来急，扁舟江上看。\n冻云千顷白，对我一襟寒。\n屦冷深犹立，巾攲重更弹。\n家山想同梦，夜倚玉栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中观雪呈李尧俞二首 其一","author":"冯时行","text":"孤渚凝寒睇，斜风看乱飘。\n已狂难自定，初泊不胜娇。\n白向水边断，轻来衣上消。\n更愁清梦觉，篷底听萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行遇小雨","author":"冯时行","text":"小雨暗两岸，孤舟撑一篙。\n清同寒鹭迥，愁与暝云高。\n已判乱波色，时饶点鬓毛。\n三农有重赋，为汝喜如膏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过铁山驿","author":"冯时行","text":"来时趁作世情游，归去凄凉遣客愁。\n万事世间多反复，一生此地几春秋。\n天寒树老叶全脱，水落岸高溪不流。\n行路崎岖纵难料，江湖付与一孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张公升挽诗","author":"冯时行","text":"扫地绿覆牖，拨醅香绕墙。\n是非閒处少，日月醉中长。\n薤滴悲歌露，柯寒落叶霜。\n百年成底事，宿草任苍茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阻雪","author":"冯时行","text":"朔风飘正急，客况老难禁。\n问路迷南北，携筇探浅深。\n地惊盈尺许，杯喜十分斟。\n梅蕊如相识，暗香何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和丁利用韵","author":"冯时行","text":"末路初倾盖，春风一系舟。\n英姿森剑戟，馀论有春秋。\n时事朝暮别，年华日夜流。\n徒劳是州县，东去勿迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王祖文","author":"冯时行","text":"河东河北塞烟长，谁作今年一苇航。\n已见五龙思自奋，似闻两虎却相伤。\n麟台君有青云路，蜗舍吾其白首郎。\n忧国忧家连梦寐，端知不复有他肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和史济川见赠","author":"冯时行","text":"岁晚扁舟雪霰边，萧疏与君俱可怜。\n向来共厄黄杨闰，别后相逢白发年。\n觅句剩烦梅作兴，攻愁直纵酒称贤。\n故人一笑诚希阔，得失休论布幔天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘仲廉新年春望二首 其二","author":"冯时行","text":"辟掠閒愁自不干，因春成老亦看看。\n花枝本自能时样，燕子从前有岁寒。\n酒著酡颜衰似健，杖扶沙步雨犹乾。\n杜门何似频还往，藉绿簪红趁逐欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和刘仲廉新年春望二首 其一","author":"冯时行","text":"年于鬓发最相干，又作新正一再看。\n懒共燕泥烘午霁，吟随莺树涩朝寒。\n馀生已分千人后，燥吻犹须百榼乾。\n愁绝向来飞舄伴，萧然形影若为欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和向文叔见寄","author":"冯时行","text":"烟云浩荡五湖身，老向风尘学问津。\n白发只应无奈若，青衫定是可怜人。\n草侵吟枕依依梦，花傍愁襟故故春。\n江上负暄樵牧晚，素书千里慰萧辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和何子应记所见","author":"冯时行","text":"公事有馀暇，披衣绕风林。\n高吟起高兴，閒事引閒心。\n未种渊明柳，方鸣子贱琴。\n几多疏散意，矫首乱山深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和何子应盛山一首","author":"冯时行","text":"径扫风云净，炉薰山谷香。\n青葱环暗壁，金碧跨崇冈。\n小雨留归旆，飞霞落酒觞。\n干戈遽如许，税鞅更何妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和何子应游西山","author":"冯时行","text":"乘时休杖屦，胜槩洗尘凡。\n屏障开苍壁，龙蛇拔老杉。\n水明花并倒，山叠玉相搀。\n卜筑公相可，吾当住翠岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李工部月夜","author":"冯时行","text":"天地浑无滓，清光濯肺肝。\n倚风哦绝唱，想像见仙官。\n照我竹书冷，恋君银鬓寒。\n家山想同梦，倚玉夜阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李尧俞郎中西归有感","author":"冯时行","text":"去留出处勿相关，炼得心丹已九还。\n自有文章为鼓吹，只将廊庙等云山。\n百年有酒堪留念，万事无心忘驻颜。\n郎署分符旧名姓，安知不在覆盂间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李尧俞韵","author":"冯时行","text":"海头归到峡江滨，新岁残年只并邻。\n梅自多情工恼客，月如知己辄亲人。\n江山纵肯容吾老，猿鹤应嫌不自珍。\n从此扁舟须驾阁，名教鲁史续书麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和杨团练元韵","author":"冯时行","text":"此生浑褦襶，秋鬓渐鬅鬙。\n跂德山徒仰，雄谈垒更增。\n奇谋閒袖手，佳句老传灯。\n起我栖迟意，寒鸠欲化鹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":21194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]