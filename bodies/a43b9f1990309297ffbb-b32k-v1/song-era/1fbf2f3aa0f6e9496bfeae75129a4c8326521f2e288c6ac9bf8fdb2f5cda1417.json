[{"title":"次韵酬张仲思高邮见寄二首 其一","author":"张镃","text":"春来慵把酒，间日伴僧斋。\n风雨梅花梦，溪山老子怀。\n有人非吏俗，同好任天涯。\n归上青云日，幽期孰与偕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬杜材卿","author":"张镃","text":"楼寒鹤骨旧竛竮，别后溪山梦不扃。\n世事益知推去好，鬓毛浑减向来青。\n诗篇又见声谐律，才兴何疑刃照硎。\n愁里不妨同茗酌，古梅园种百龙形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬杨伯子兼呈诚斋 其一","author":"张镃","text":"我固有诗癖，怜君尤苦心。\n自闻非为俗，异处却同音。\n病后閒方乞，湖边秋渐深。\n排门听车骑，相与话幽襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬杨伯子兼呈诚斋 其二","author":"张镃","text":"见说聪明早，童年便与玄。\n细看今日句，宛似乃翁篇。\n家谱无他姓，文星聚此边。\n何须待千首，一首已堪传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬陈伯冶监仓","author":"张镃","text":"小筑才成赐也墙，传家那是钓徒张。\n非求世上人看好，但要閒中句律昌。\n成阵游鯈波上暖，打团飞蝶菊初荒。\n邻翁莫厌频相遇，会见翱翔入未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬郑唐老见寄","author":"张镃","text":"黄叶归根静不风，回塘雪后正浟溶。\n山林有分吾当去，簪绂方兴子未慵。\n点检寒荣梅又动，思量暖事李将秾。\n桥南水北来还往，露布诗篇不必封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬唐老见赠","author":"张镃","text":"菊边莎处坦平居，危径吾知勉覆车。\n争似即时三盏酒，何曾得力半行书。\n鱼乡坐占真清矣，蜂户行看亦要如。\n过我不疏君始信，向来犹恐压荒墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬喻工部雪中见怀","author":"张镃","text":"坐厌增冰地，遥思胜热城。\n忘名全道用，远俗养诗情。\n枕病怜幽独，心交阻合并。\n晴春开径在，自断学渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬曾无逸宗教 其二","author":"张镃","text":"地秀溪通邑，山高寺矗云。\n望殊惊乍见，景胜厌前闻。\n鸡犬人家乐，风烟钓艇纷。\n奔程船径过，虽雨未西曛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬曾无逸宗教 其一","author":"张镃","text":"自识閒中趣，常嫌闹处行。\n湖山真富贵，花鸟小声名。\n有客金兰好，贻诗徵角鸣。\n相期耐霜露，斯事岂凡情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬新九江使君赵明达二诗仍送自制香饼白鸥波酒 其二","author":"张镃","text":"岁晏怀人水一湄，归鸿去雁各参差。\n寒风不解频吹梦，疾置何妨数寄诗。\n酿酒改名聊济胜，和香因谱更求奇。\n路遥不暇多瓶送，一炷同参日渐迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬新九江使君赵明达二诗仍送自制香饼白鸥波酒 其一","author":"张镃","text":"纷纷金佩与瑶环，骨相如吾敢妄攀。\n居处何曾离城郭，襟期终不负湖山。\n杉旁试履拖云湿，石上敲钩破藓斑。\n冲晓樵童便来往，思量谁是我投閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵酬潘茂洪见寄","author":"张镃","text":"怀人非特为能诗，襟抱如君坦复怡。\n三径许时无地觅，一生高处只天知。\n江湖老梦疏篷惯，灯火凉秋细字宜。\n此兴未尝殊往岁，水边唯欠咏黄葵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵谭德春见寄","author":"张镃","text":"端的公宜语个中，对山萦碧照清冬。\n鹤毛雨渍苔钱古，蚁穴风堆橡斗重。\n已乏尖新陪世话，断无阔匾拆书封。\n一轩煨芋方题榜，时过松扉慰我慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵潘茂洪春日书怀","author":"张镃","text":"东风渐放柳遮门，隔水人家聚似村。\n渔艇远来誇甫里，僧邻閒过讲慈恩。\n花繁惯识蜂情性，昼静初闻燕语言。\n病起适逢春正好，莫教诗思却尘昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汎锦池霞川呈张以道二首 其二","author":"张镃","text":"戏选婵娟结伴来，画桥低处侧鸾钗。\n娲簧静试醒松响，鲁酒聊倾旷荡怀。\n万事亦须从使便，百年无过任天排。\n怜君近许同心友，分取湖光到竹斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汎锦池霞川呈张以道二首 其一","author":"张镃","text":"夕风轻飏一池香，遥为荷花泛短航。\n俗子几曾贪韵胜，閒人嬴得放清狂。\n幽栖野鹤林松黑，乱扑流萤水叶凉。\n会取渭川当日意，不将终老俟周王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灯夕","author":"张镃","text":"插花呼酒少年场，烂赏花灯十里香。\n璧月当天星纬少，珠帘排户乐声长。\n非缘风景今殊昔，自是情怀老不狂。\n赢得安禅心似水，碧琉璃照佛龛旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹轩诗兴","author":"张镃","text":"柴门风捲却吹开，陕径初成竹旋栽。\n梢影细从茶椀入，叶声轻逐篆烟来。\n暑天倦卧星穿透，冬昼閒吟雪压摧。\n预想此时应更好，莫移墙下一株梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"约斋西窗先有垂柳腊后四日辟地增植花数十辈","author":"张镃","text":"经年规画种酴醾，柳际春将一再归。\n蔓草藩墙才放远，海棠桃杏得成围。\n连宵冷月知予乐，数日条风挟鸟飞。\n尽写前人题品句，诵声时撼绿窗扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老笔赠铦上人二首 其二","author":"张镃","text":"已事殷然急，江湖第一流。\n才高楼五凤，伎进刃全牛。\n可惜梅花节，忙回竹叶舟。\n老师应赏棒，碑巨压东州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老笔赠铦上人二首 其一","author":"张镃","text":"握手四年别，满心千偈禅。\n清灯才软语，新雪尚幽眠。\n了了翻身诀，寥寥断臂缘。\n我怀吾自会，恶句莫多传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自叹","author":"张镃","text":"居士年来更觉痴，竹梢云过望移时。\n晓窗倦栉犹思梦，夜榻忘眠尚改诗。\n匹马未能随李广，一丘端欲效元规。\n客谈休讶无心对，贪看蜘蛛结网丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自咏","author":"张镃","text":"南湖老子太汗漫，第一生来懒做官。\n钱物用多常是解，权门路便不曾钻。\n红裙遣去如僧榻，白发梳来称道冠。\n若没祖财教饭饱，定应饿作壁鱼乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自料","author":"张镃","text":"自料躬耕体力微，他年为圃雅相宜。\n植茶要是依桑荫，种芋先须纳豆萁。\n药爱金樱长林薄，花因木槿作藩篱。\n祗应分绝陶朱富，不愿鱼繁六亩池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自横山归偶成","author":"张镃","text":"杖藜如向碧空行，路转松杉面面声。\n遗庙香残人少到，古台仙去草閒生。\n都缘世念多时绝，不但尘襟逐境清。\n却上小舆归寓舍，晚峰明暗紫烟横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行","author":"张镃","text":"经夕舟行路未赊，不须寒梦早还家。\n云连冈势通平野，雨溢滩声走乱沙。\n蘋蓼静怜鱼世界，菰蒲遥想雁生涯。\n玄真便合苕溪隐，莫待摧颓两鬓华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行次季村","author":"张镃","text":"破衣鸣蓬雨，迎晨捩柁风。\n擘茭溪饭白，锻铁店炉红。\n于役多无定，于心少所同。\n船人探蟹室，持寿觅诗翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行次莺脰湖","author":"张镃","text":"震泽匆匆过，胥塘渐渐来。\n风高多罨岸，船侧屡翻杯。\n积草摊渔网，疏林聚客桅。\n景逢宜急写，句过恐难裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行近湖州不果入城寄王成之使君","author":"张镃","text":"江左风流燕子家，有人襟度渺云涯。\n讴歌冯翊今分竹，词藻西垣旧判花。\n相望每居形迹外，投閒常动别离嗟。\n因行一见还成阻，谁谓人遐自室遐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"许深父送日铸茶","author":"张镃","text":"短笺欣见小龙蛇，谏省初颁越岭茶。\n瓷缶秘香蒙翠箬，蜡封承印湿丹砂。\n清风洒落曾谁比，正味森严更可嘉。\n堪笑云台方忍睡，强行松径嚼新芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过凤山高氏以榴实荐酒","author":"张镃","text":"湾洄绿处得鸡声，俯槛山宜柳外明。\n京洛涨尘衣半黑，邯郸炊黍梦曾惊。\n榴皮就为翁题好，竹叶能邀我兴成。\n办此一廛归老计，弄孙相对说春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过红城子","author":"张镃","text":"阔港旁边狭港横，大桥侧畔小桥平。\n吠人黄耳穿篱走，唤子青裾出户迎。\n寒日树枯山得势，顺风樯稳浪无声。\n自知吟写红城景，不让丹青笔作城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过冷泉","author":"张镃","text":"未喜亭阴坐，先贪树畔行。\n溪浑因雨瀑，岩近得风清。\n一饭幽人福，三杯太古情。\n尚须冰月挂，来放雪涛倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过杨伯虎即席书事","author":"张镃","text":"四面围疏竹，中间著小台。\n有时将客到，随意看花开。\n拂拭莓苔石，招携码碯杯。\n昏鸦归欲尽，数个入诗来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过临安海会寺东长桥有怀苏文忠公","author":"张镃","text":"竦踊峰环碧玉城，乱蝉争送夕阳明。\n飞桥预快登山足，坏塔遥增吊古情。\n陈迹几年惊梦幻，清文随处振英茎。\n胡床等到三更看，閒过桐乡或驾鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过湖至郭氏庵","author":"张镃","text":"山色棱层出，荷花浪漫开。\n只如平日看，自喜此时来。\n杨柳侵船影，蜻蜓傍酒杯。\n僧庐须过夜，城禁莫催回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过翔鸾院留题僧房","author":"张镃","text":"频年虽并住，今日偶能来。\n水槛因莲设，风窗为客开。\n诗凡惭鲍谢，社近忆宗雷。\n莫问通衢隔，轻舟自往回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伴书回寄建康张总卿","author":"张镃","text":"湖上初晴擅晓凉，一缄俄坠读书床。\n月卿星使年年忆，雪白兰薰字字香。\n闻道江边勤叱驭，也知鸥外静鸣榔。\n新君未识诗人在，早觐枫宸荷紫囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"余家兄弟未尝久别今夏送平父之官山口冬仲朔又送深父为四明船官因成长句","author":"张镃","text":"遵渚霜鸿散漫飞，江天分序益凄悲。\n孤生只合群居乐，半岁那禁两别离。\n发轫固知期远到，望船犹怕独归时。\n书来岂是寒暄语，尽写衷情慰渴饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即席次吴季行韵","author":"张镃","text":"昔逢欣把袂，三叹说吴钩。\n共醉虚堂晚，还兴故国愁。\n花黄思靖节，鬓绿傲浮丘。\n世济王门业，洪流万斛舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即席次韵器之相赠","author":"张镃","text":"会閒须是莫论年，直把浮生付且然。\n桂隐欲为山宰相，漆园曾是地神仙。\n看抄妙句行催酒，更向清流卧泛船。\n但喜相从得真乐，何心玩世学前贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即席次潘茂洪韵","author":"张镃","text":"我恨填胸三斗尘，略无警句可留春。\n烟云空外吹成鹤，梅杏枝头长就人。\n但解时中心独废，自然随处乐常新。\n诸公要识居园法，第一先教懒是真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈毛崇夫司直","author":"张镃","text":"春到深时味更长，草晴胜似杂花香。\n清阴渐次迷天绿，白发依稀照领光。\n逐妇墙鸠知雨近，生儿梁燕补巢忙。\n擘笺谩记今朝景，朝路归时肯易忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈吴居甫待制","author":"张镃","text":"挺挺风规轶辈流，肯因官誉掩清脩。\n南宫妙画多时见，北固新篇去岁收。\n每念小人同话此，曾知閒客到门不。\n平生自笑迂疏甚，趋造才频更觉愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈张左曹郎中","author":"张镃","text":"持节江湘公去久，浙西风月我孤吟。\n相逢未叙三年话，此事先抛一寸心。\n风调不因通宦汨，世涂尤见故情深。\n随人一错终能复，林墅应劳得得寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈曾仲躬侍郎","author":"张镃","text":"公道欣从禁路开，世家今有伟人来。\n共推掌学文清手，突过谈兵杜牧才。\n老眼知人明月镜，时情荐士冷秸灰。\n诗章活法从公了，要使诸方听若雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"园中梅有开者寄呈当涂叔祖","author":"张镃","text":"春到林梅得重权，首冬疏萼巳争先。\n移栽尚记陪深斝，静看因思觅近篇。\n佐世勋庸金鼎味，贪閒怀抱竹篱烟。\n临风欲寄横斜去，梦绕江城暮角边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"园桂初发邀同社小饮","author":"张镃","text":"故故论年赏，新看惜未多。\n一香参众树，千月下纤娥。\n今雨胡能阻，秋虫亦复歌。\n有情毋吝醉，斯世合婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"改旧诗戏成","author":"张镃","text":"不作新诗只改诗，当家功用亦几希。\n全牛迎刃未能解，六鹢遇风先退飞。\n欲脱规模还似旧，枉教躯干不曾肥。\n何如尽付红炉火，免使群公说是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"时贤有爵高名重而不自由者再念閒居之可乐为赋长句","author":"张镃","text":"多幸因愚得养恬，林扃风变陡寒天。\n杯传蕉叶温成酒，袄织梅花软入绵。\n经室炉添羊胫炭，道床屏护鹧斑烟。\n遥思病叟头如雪，冒冷遐征想自怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨仲子携诗见过次韵酬赠并呈诚斋二首 其二","author":"张镃","text":"爱水移居宅，行藏岂但迂。\n若非风月管，枉伴竹松臞。\n野服常宽带，芒鞋亦断絇。\n请君看此老，堪作贵人无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨仲子携诗见过次韵酬赠并呈诚斋二首 其一","author":"张镃","text":"老监过陈实，贤郎似窦群。\n共将奇句了，不许外人分。\n访我三竿日，萦帘一炷云。\n当家相见处，那此世情欣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨伯子见访惠示两诗因次韵并呈诚斋 其二","author":"张镃","text":"别去常关梦，书来意已强。\n那看多竹地，相对两绳床。\n壮志霜空鹘，禅心古庙香。\n糠炉熟黄独，待子数分尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨伯子见访惠示两诗因次韵并呈诚斋 其一","author":"张镃","text":"自作诗中祖，翁难子更难。\n波澜千偈阔，光焰九霄寒。\n觅著由来远，成时自好看。\n头头见成字，谁道要吟安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨伯子过访翌日以两诗见贻因次韵答 其一","author":"张镃","text":"晴色今朝好，春光恰半头。\n波情如钓渭，圃事胜封留。\n瘦觉中黄合，閒宜大白浮。\n无端同志侣，相过结诗愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨伯子过访翌日以两诗见贻因次韵答 其二","author":"张镃","text":"句业诚渊海，愚方一苇航。\n空成由也瑟，难应女娲簧。\n拟易乾坤别，传家父子香。\n整翰从此去，拭眦望朝阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨伯时李子永潘茂洪同游安福寺诗","author":"张镃","text":"湖滨初试暮春衣，绿径钟残到寺迟。\n二月梅花还傍竹，一时游客总能诗。\n横栏著砚争濡墨，断石缘蒲静看池。\n莫问邻亭是谁筑，山园持酒本幽期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨秘监补外赠送","author":"张镃","text":"止是寻常月，今宵不爱明。\n江边有归客，都下减诗情。\n上自怜公直，人知暂此行。\n贤郎先返舍，应喜候门迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泛湖","author":"张镃","text":"駮云飞去见晴岚，叠巘平湖影共涵。\n景与新诗争上下，天将真赏冠东南。\n频来但觉如初到，得侣何妨纵剧谈。\n归路一弯明月好，闹花风里跃华骖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵源精舍小憩旧名龙泉有古井极甘洌","author":"张镃","text":"姑恶声催雨不来，暑云空际只崔嵬。\n投鞭得地古佛刹，看竹满窗风叶堆。\n百岁可堪轻日月，一官才得便尘埃。\n清泉酌罢犹贪恋，更瀹松黄当茗杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"牡丹","author":"张镃","text":"分数论春物，都应让牡丹。\n几枝单叶紫，满担夕香寒。\n除我知心切，从人得句难。\n肯辞回棹日，多瓣剪来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纳凉至夜深","author":"张镃","text":"积潦斜阳忽射阶，夜深穿树雨还来。\n披襟径放清凉入，倚扇微教懒困催。\n出草乱萤时自照，叫空孤鸟暗飞回。\n贪吟四鼓犹妨寝，除此人间念总灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芦山长老慧举见访约游其临平庵居自号云邱草堂因赠四韵","author":"张镃","text":"此客南湖不易逢，几年尘外愿相从。\n风流前辈亲曾识，兴寄高情老未慵。\n行柳映门宜著舫，青灯同坐到闻钟。\n稻畦莲渚临平境，何幸同师觅旧踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苍寒堂","author":"张镃","text":"短桥斜路入松林，何止能销利欲心。\n眼悟一真清净色，耳通千古泰和音。\n尺量梢影邀僧记，竹护根茎恐鹤侵。\n莫讶塼炉多宿火，春晴犹似处云深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":57643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]