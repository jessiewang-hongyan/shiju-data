307e1","dynasty":"宋"}},{"title":"宿育王河头庵","author":"戴栩","text":"晚霭图成绀碧天，鹭鸶无数起平田。\n渡船委岸人家闭，却向僧床听雨眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"斜川晚书","author":"戴栩","text":"水减桥痕晕翠霓，弄花小女立晴堤。\n蜻蜓欲下嗔飞去，击溅惊流过树西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题浣川 其一","author":"戴栩","text":"五十知非雪鬓鲜，尚将疏褊谪尘缘。\n近来万境心如洗，笑改斜川作浣川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]