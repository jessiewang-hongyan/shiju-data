[{"title":"正月三日郊外马上作","author":"强至","text":"长日牵人事，新年散马蹄。\n和风吹冻柳，残雪点春泥。\n意惬境自胜，兴来杯屡携。\n徘徊羡飞鸟，晓逐野云低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用洪景之韵送郭子山","author":"强至","text":"别筵那得易为情，别酒连连祇自倾。\n车马纵游怜客兴，江湖幽适负吾生。\n盘中异味归南食，箧里新诗记北行。\n文史藏身荣路在，未应高迹混柴荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"甲寅仲冬祠马步宿斋宫乙卯仲春十七日复因马祭到此漫成短篇","author":"强至","text":"昔年庭木雪僵条，今此风和柳自摇。\n人事转如风不定，年光暗与雪俱消。\n城中佳气生宫阙，尘外清居隔市朝。\n顾我何能知马政，江村祗合老渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石太保挽词","author":"强至","text":"许国三朝老，传家万石君。\n乞骸章未报，没齿讣先闻。\n挽铎摇秋露，铭旌卷暮云。\n龙冈逢吉壤，马鬣寄高坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立之临别连以佳篇见贶依韵和酬","author":"强至","text":"建溪夫子惠新诗，雅道深惭未得知。\n曲享鶢鶋真过矣，吟成款段复何之。\n日斜留煮山家茗，烟重愁燃客舍萁。\n我系一官君四海，可怜出处不同时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春","author":"强至","text":"北风已作东风客，昨日何如今日暄。\n造化有期寻万木，阳和无迹走千门。\n土牛陌上摧花杖，玉燕钗头坠綵幡。\n独我题诗添意绪，又看残腊委冰痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春","author":"强至","text":"鱼寻细脉上轻澌，鸟趁微和哢好枝。\n多病强倾春日酒，苦吟还接暮冬诗。\n江南信息梅应蕊，京国风流柳未丝。\n最有佳人随节序，钗头綵胜竞垂垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春","author":"强至","text":"宿冻归何处，池塘涨暖波。\n日盘花面永，风入鸟声和。\n俎菜堆生叶，闺裳剪薄罗。\n独怜诗酒兴，早较昨宵多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春","author":"强至","text":"残腊新春判此朝，斗寒犹未动寅杓。\n白催晓色融冰片，绿转风光入柳条。\n丝菜落盘随玉手，镂花垂胜压金翘。\n六年不见江梅影，长觉归心似旆摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春后连雨","author":"强至","text":"东风自动故园枝，未见终期不雨时。\n遮莫年光浮水嫩，定应春色上花迟。\n山川惨淡随人意，车马艰难误客期。\n万瓦烟青犹足慰，始知井屋有晨炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立春辇下作","author":"强至","text":"雪意徘徊收腊尾，风光迤逦上花梢。\n强倾浮蚁尝春酌，终似南禽忆旧巢。\n愁里年华侵短发，吟边生意满东郊。\n玉盘丝菜无消息，索寞空斋畏客嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"立秋后病作此写怀","author":"强至","text":"卧病喜秋至，昏烦庶以平。\n清风不少济，宿疢仍相撄。\n凉叶犹未振，阴蛩已先鸣。\n四时顺万物，奚独戕吾生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仲冬十六日祭马步","author":"强至","text":"提辔傍险径，喜随双炬红。\n薄云笼淡月，苦雾捲严风。\n马害谁云屏，神休觊所蒙。\n晨门未开钥，残梦续斋宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仲灵禅师以诗见邀辄走笔依韵附还使奉和","author":"强至","text":"世好元难合，便甘或弃辛。\n喜师同肺腑，偶尔异衣巾。\n文约牵常俗，诗情远过人。\n相邀松下别，山意入秋新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仲春感怀","author":"强至","text":"春色愁边已不浓，眼开天地久阴中。\n乱红杂下残花雨，暗绿兼飞弱柳风。\n生计荒芜有酒盏，交期零落减诗筒。\n多情惟有堂前燕，来往贫家与旧同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仲春摄太仆卿祭马祖宿斋城外作","author":"强至","text":"一年四出国门西，今喜春郊散马蹄。\n晴日自随河面动，宿云仍傍柳梢低。\n斋宫得句还挥笔，乡国寻芳忆杖藜。\n承祀九卿犹假摄，不应巧宦至通闺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伏睹留守安抚司徒侍中镇魏三日遂获甘雨吟成律诗一章上荐","author":"强至","text":"相衮前年抚雍民，下车飞雪满咸秦。\n风行魏国才三日，雨作商岩恰半春。\n忠节此生存社稷，诚心是处感天人。\n二方岂合偏蒙润，四海思归旧化钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"会压沙寺观梨花","author":"强至","text":"小队逶迤驻宝坊，祇园花发认昆冈。\n日高恐释三春雪，风细犹传数里香。\n垢染了无依佛界，品流逾重被台光。\n更蒙佳句形珍赏，漫说寒梅竞效妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"会故人集崔侍郎园池","author":"强至","text":"贰卿园沼压关西，上相篇章绝景宜。\n旧日宫墙流水过，至今苑地画图知。\n孤花春去犹临岸，野蔓晴来欲占篱。\n荀令凤凰池更好，不须游旆此迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次前韵","author":"强至","text":"晻暧秋旻气象浓，对时览物两无穷。\n才开又合烟光重，欲落还收雨意空。\n直恐客头先老白，却思日脚带斜红。\n天真不扰无馀感，谁似前溪下钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵礼之见贻之什","author":"强至","text":"传家素业志雄轲，乌足区区羡决科。\n以道自尊今古少，不才而第苇麻多。\n圣门奥阃期君至，宾馆清谈许我过。\n文酒有时留剧饮，长教阿买到醺酡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再次韵和纯甫红叶之什","author":"强至","text":"徒密嗤翠幄，有文殊紫屏。\n因霜变颜色，点树作丹青。\n废苑扫还聚，疏林生易形。\n秋风无别艳，祝尔莫飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其二","author":"强至","text":"我行平野览秋空，物象吟怀觉两雄。\n远水有时明返照，疏林无限战西风。\n京坻相望农收足，庐井多欢岁计充。\n亦向此时追乐事，归来倒载效山翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和","author":"强至","text":"公到层轩雪已残，萧林素节晓相看。\n山融爱日酥千点，地接顽云缟万端。\n曾有金樽开兔苑，况无铁甲戍桑乾。\n清风落纸成佳句，身世浑疑在广寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和 其一","author":"强至","text":"有客秋郊旷望中，更凭佳句发才雄。\n牛羊饱食眠平野，雕鹗乘时击迅风。\n倦目几随残照断，渴肠惟藉浊醪充。\n登临不用频兴感，忧喜能忘是塞翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和都官见答","author":"强至","text":"离幽便欲趁芳时，越分非能守一枝。\n多语羞随禽反舌，逢辰强学凤来仪。\n故林有约依前去，落絮无踪逐处随。\n若得东风聊借力，免教燕燕竞差池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再宿白岩院","author":"强至","text":"寺在疏林积霭间，举头无处不苍山。\n老松怪石莫知岁，幽鸟孤云相与闲。\n衮衮红尘嗟宦路，时时飞梦绕禅关。\n上方大士观空坐，应笑喧卑数往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再寄元真宫读书","author":"强至","text":"读书曾寄此轩头，官路归来十二秋。\n文酒故人无一在，蓬蒿荒径有馀愁。\n差池岁月辜金印，憔悴乾坤复布裘。\n却扫尘埃张旧榻，云中鸡犬笑淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘叔茂及第后往广德拜亲过吴江新治","author":"强至","text":"今岁同升客，如君有几人。\n青年登一第，白首具双亲。\n喜气生军垒，欢迎聚邑民。\n诸兄在天禄，勉去继清尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刚叔以雅言题拙稿辄依韵和酬","author":"强至","text":"每恨尘劳荒旧学，更惭篆刻得初名。\n圣贤阃奥期深入，风雅源流庶一清。\n短技示人方蓄缩，雄篇鏖我太峥嵘。\n君诗合作咸韶秘，何尔轻酬郑濮声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"压书玉兔","author":"强至","text":"白玉双蹲兔，工深刻楮劳。\n长疑奔月窟，浑欲动霜毛。\n似喜书成穴，犹惊笔有毫。\n案间谁汝待，自觉守株高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同杨公济赋破山得开字","author":"强至","text":"无物终天地，青山岂免开。\n万人镵秀骨，一气失全胚。\n漫贮崇朝雨，犹防浩劫灰。\n何年巨灵手，曾此擘崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同杨公济赋晚过西村","author":"强至","text":"空影倒波面，晚阳留树梢。\n人烟青近郭，鸟道暗长郊。\n世外空搔首，溪边懒结茅。\n沧浪那敢羡，渔父定吾嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同盛任道赋暮阴","author":"强至","text":"野馆临空阔，江城起暮寒。\n年光去天末，雪意上云端。\n自失归禽影，能侵病客肝。\n莫将愁对景，入夜转漫漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"后二日赵无愧杜君章垂和前篇复用元韵自和呈二君","author":"强至","text":"给园胜地隐金沙，随意开筵饯使华。\n社日兼宜数杯酒，春风未动一枝花。\n垂垂禁鼓喧城里，一一归鞍傍水涯。\n鱼目间投引骊颔，夜光双吐照贫家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"因访杨公济遂同步野夫家省其母野夫时就试南宫","author":"强至","text":"马系扬雄宅，门过孟母邻。\n升堂予独拜，同井子兼亲。\n万卷先生富，千金旧产贫。\n早将安稳字，去慰杏园春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孙公素中允将往相台谒韩魏公贻诗为别因以酬送","author":"强至","text":"紫宸班退听宣麻，镇邺司徒换将牙。\n到日玳筵公定喜，当年珠履客尤嘉。\n赋惊閤座争观祢，乐重当时合姓车。\n入夏后园闻更好，绕池十丈看荷花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安正堂二首 其二","author":"强至","text":"飞飞燕雀倦檐牙，绣栱云楣斗彩霞。\n樽俎燕閒归相閤，鼎钟勋业在王家。\n直纹惜破墙阴竹，巧笑嫌开席外花。\n今日正风传魏国，平居诗思亦无邪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安正堂二首 其一","author":"强至","text":"居守园林气象间，堂成壮观入跻攀。\n三朝力辅乾坤倦，一国身偷岁月閒。\n倾座语惊邪说破，勒碑诗召正风还。\n险夷出处皆公迹，不动公心似泰山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏呈宋周士","author":"强至","text":"腊去垂垂冻欲消，春光未动思先饶。\n最宜才客临歌席，更看佳人转舞腰。\n一笑劳生应有定，三冬薄宦独无聊。\n兰台侍从风流裔，合为行云赋此朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏赠孙师尹","author":"强至","text":"是非不到酒樽边，樗散谁呼小谪仙。\n天上浮查空有路，人间种秫独无田。\n花明绿野吟毫秃，月近青楼饮帽偏。\n姓字未劳金简记，圣经方倚大儒传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早春寄择之","author":"强至","text":"北陆寒威尽，东郊昼景添。\n风和引禽哢，水暖出鱼潜。\n草木回生意，乾坤待泽渐。\n宁知岩谷下，经岁叹才淹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵丁评事春雨","author":"强至","text":"溪楼燕子懒飞飞，一鼓轻雷渐作威。\n细濯林花红抹浅，低濛岸柳翠光微。\n偶穿纵步寻山屐，且解销忧贳酒衣。\n华表有人还未得，更堪取次送春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵仁叟禁中清晓","author":"强至","text":"禁庐休夜直，瑞霭向朝敷。\n华阙辨云气，紫宸低斗枢。\n帝梧鸣彩凤，宫漏息铜乌。\n日出将临扆，天光冒海隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵公胜早梅","author":"强至","text":"昨夜寒梅忽一枝，早如常岁合开时。\n欲冬天地恩先及，未雪园林色易知。\n世眼已教容易赏，晓风何用再三吹。\n若论霜菊无多晚，只此春葩苦较迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵公胜晓起对雪","author":"强至","text":"向晓寒威觉倍浓，雪霙纷糅冷兼风。\n乱装琼树千林密，疑泻银河一夜空。\n鸥鹭失群吟景内，乾坤同色醉眸中。\n青衫瘦马凌朝出，翻羡袁安得卧穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵卢六员外避暑","author":"强至","text":"城市苦歊暑，寻凉到水穷。\n环林得高荫，解带取微风。\n渴肺举杯缓，汗肤兼酒红。\n当年河朔会，旧事岂全空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵礼之斋中述怀","author":"强至","text":"僻坐治孤学，取书窥古人。\n高风凛如在，千载邈相亲。\n欲满诗书腹，宁规富贵身。\n独君知己厚，无亦虑吾贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵礼之淮上吟","author":"强至","text":"泗上风宜旧罕传，邦人谁说贡鳞鲜。\n隔淮小市若古画，接楚远山疑宿烟。\n民舍卑洼多困水，农畴硗瘠少逢年。\n顾予居里号繁胜，举目只为乡思牵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵阳朔邱尉述怀","author":"强至","text":"登科君已十年馀，斗粟犹肩县尹卑。\n闵己漫形韩子赋，添丁赖有玉川儿。\n海边毒瘴浓如雾，岭外征涂乱若丝。\n三岁归来无荐者，金门犹喜从臣知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵邱秘校程苦热","author":"强至","text":"羲和驱日昼如燔，万里焦原草木乾。\n旱雨骤晴还作热，炎风寡势岂成寒。\n渴思沆瀣朝餐美，坐想凌兢迹到难。\n汗浃肌肤空秉箑，浪将霜雪拟轻纨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和纯甫秋阴闷书","author":"强至","text":"乾坤泱漭作秋容，节物情怀两莫穷。\n山雨欲来阴竟日，溪云不断气浮空。\n赖存樽酒时倾绿，更有歌裙可醉红。\n偶尔登临愈兴感，朱颜容易变衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和秋扇","author":"强至","text":"形如圆月色欺霜，曾许佳人掩面藏。\n袁守扬风方慰惬，班姬中道忽悲凉。\n自知掌握初经用，岂顾尘埃此暂伤。\n只恐来年清暑殿，别将纨素上君堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵国博九日","author":"强至","text":"秋光未老已风酸，还似春来料峭寒。\n酒盏莫辞今日醉，人心况是在时欢。\n佳辰从古逾金重，远岫登高见黛攒。\n且学牧之开口笑，休因菊蕊泪阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵知郡郎中应期喜雪","author":"强至","text":"公将民欲达天心，瑞雪如期白昼阴。\n皓色恍疑霄宇接，浓寒都为岁华深。\n辞妍席右人雄赡，兴尽溪边客访寻。\n铃阁唱高宜和寡，不才刚缀郢中吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵通判张静之郎中席上对客","author":"强至","text":"一饮真须尽百杯，异乡怀抱酒边开。\n田园几日能归去，轩冕浮云亦傥来。\n交态与谁论淡水，宦情空自学寒灰。\n何如席上张公子，白雪辞兼郢客来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵通判都官和诸公雪中席上之作","author":"强至","text":"龙沙千里绝纤埃，银色浑疑王母台。\n宴席此时惊酒薄，晓枝无处认梅开。\n骋辞梁苑客方至，乘兴越溪人自来。\n从古六花长一色，化工应不费培栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵都曹灯夕之作","author":"强至","text":"夜色澄明宇宙宽，新正才半觉春悭。\n行歌溯月疑尘外，醉眼随车忆梦间。\n烛影更和人散乱，漏声不放马舒閒。\n啼鸟看报严城晓，满引金船倒玉山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答方晦之","author":"强至","text":"昔时英杰未伸时，胯下淮阴尚俛眉。\n之子古心能自信，众人谤口不须疑。\n讨论直取遗经本，芟剔宁容异说枝。\n圣世尊儒君富学，等闲危涕莫交洟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答正老","author":"强至","text":"幽欢閒忆去年时，饮量人人灌漏卮。\n我更典衣邀浅饮，君犹刻烛赋新诗。\n由来世事都无定，再结朋游未可期。\n一纸清风惠佳句，慇勤胜寄陇头枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵答承天月长老","author":"强至","text":"方外得师晚，相逢出古心。\n交成真合水，意在始知琴。\n宦路尘泥久，禅扃岁月深。\n清风贻绝唱，一诵快烦襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵酬礼之见贻","author":"强至","text":"庆历天王设网罗，君时遗俊我登科。\n当时未识名犹熟，此日相逢分固多。\n摩戛青云知志在，惊嗟素业怵时过。\n朱颜皓齿偷欢处，暂置功名任酒酡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵酬答胡一之","author":"强至","text":"六科顿网索豪雄，岩穴贤群为一空。\n夫子独沈穷巷底，故人多列要涂中。\n志行应在功名早，欲大难为富贵充。\n年未平津学晁董，伫观画并耀江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汤七秀才见和再和","author":"强至","text":"清吭临风啭较迟，春光相背去如遗。\n名园已失堪栖处，幽谷何如未出时。\n早恨狂风偷好景，更和微雨宿残枝。\n斋庭健翼飞虽晚，一举青云笑我衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"羽师院假山","author":"强至","text":"累石作危峰，轩然曲沼中。\n山形在眉睫，人意自衡嵩。\n影骇鱼虾避，路疑猿鸟通。\n宦途尤巧险，匠手莫言工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":75790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]