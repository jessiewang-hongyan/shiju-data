[{"title":"梦中幻成","author":"何梦桂","text":"一片閒云本住山，暂为行雨下人寰。\n白云可是无心物，朝出山来暮又还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34624,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"起坐谩成","author":"何梦桂","text":"银河西转静无声，唱彻天鸡夜未明。\n万里无云霜月上，坐鞭玄鹤下蓬瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34625,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶成","author":"何梦桂","text":"心无损物宜平怨，语不妨人贵寡尤。\n说与时人莫相忌，全家已拟鹿门游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34626,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠星史胡达翁","author":"何梦桂","text":"杜甫拾遗终老去，陈平户牖岂长贫。\n达翁言命未为达，安命方知是达人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34627,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题骆菊岩诗稿","author":"何梦桂","text":"歃尽秋泉不疗饥，菊边更读菊岩诗。\n寒英摇落渊明老，尚见遗编说义熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34628,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴对山跋 其一","author":"何梦桂","text":"一点灵犀传地理，明如指掌秘通神。\n潜斋不作周公梦，閒使人参郭景纯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34629,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴对山跋 其二","author":"何梦桂","text":"电眸只是天机到，龙脉皆如教法寻。\n抔土百年人子孝，知君不负托孤心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34630,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和柯提举寄诗 其一","author":"何梦桂","text":"曾拂三台最上星，赤城云气暖生春。\n回头往事邯郸梦，落尽鹈霜白发新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34631,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和柯提举寄诗 其二","author":"何梦桂","text":"倚遍层楼数曙星，鹧鸪声里暗惊春。\n开元耆旧今无几，怕听尊前唱永新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34632,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和柯提举寄诗 其三","author":"何梦桂","text":"亲跨灵槎访渚星，归来云锦照青春。\n湖山夜半生神气，一雨田田采芑新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34633,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和柯提举寄诗 其四","author":"何梦桂","text":"天上文昌望六星，陇头农稷趁三春。\n玉京玄圃尘尘隔，璧月琼枝岁岁新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34634,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋思有感","author":"何梦桂","text":"落日西风捲白沙，关山万里客思家。\n芦花雁断无来信，柿子霜红满树鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34635,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题竹境","author":"何梦桂","text":"种竹元非辟世人，竹环人境似山村。\n苍苔满径客稀到，云锁閒堂鹤护门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34636,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠章月岩乃子德父","author":"何梦桂","text":"学得屠龙莫履狶，屠龙有技未全疏。\n斲轮老去谁传业，珍重青囊肘后书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34637,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观燕哺雏","author":"何梦桂","text":"閒堂看尽燕双飞，终日劳劳为哺雏。\n父母此心谁不有，生儿几个似慈乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34638,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹鸡冢","author":"何梦桂","text":"活活声乾落羽翎，分甘砧几委危形。\n主人肯与封抔土，犹胜当年翳冢青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34639,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自题画像","author":"何梦桂","text":"七分形貌十分心，纵有丹青画不真。\n萧散风神清瘦骨，分明小有洞天人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34640,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与张郎中省庵二首 其一","author":"何梦桂","text":"一统山河遍八埏，江南等作弹丸看。\n公来踏遍官田土，只有池蛙不为官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34641,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与张郎中省庵二首 其二","author":"何梦桂","text":"青山云影日悠悠，却怪随龙上下游。\n能捲沧溟为雨去，白云依旧宿林丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34642,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题二美人图","author":"何梦桂","text":"美人娟娟江水隔，翠竹萧萧江月白。\n笺心欲寄不成章，伫立思君情脉脉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34643,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠吴对山先生","author":"何梦桂","text":"绀裘久堕还天阙，结佩乘云遗玉玦。\n耿光灭没不可望，一歃寒泉酹秋月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34644,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠钱季实","author":"何梦桂","text":"一醉狂歌天地老，醒来不记邯郸道。\n祁连千丈土一抔，至今下马陵前草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34645,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠月山相士","author":"何梦桂","text":"万古乾坤万古山，山前万古月光寒。\n人生几度能看月，常被青山与月看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34646,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读书有感","author":"何梦桂","text":"短发凌霜强自搔，可能书剑更徒劳。\n春秋已降功名薄，秦汉而来智术高。\n天外寸心孤雁影，人间万事九牛毛。\n却怜刺股徒辛苦，狐貉何曾耻缊袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34647,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚雨","author":"何梦桂","text":"已当天色暮，况复雨霏微。\n落叶元无定，因风更自飞。\n壮心攲客枕，寒事到征衣。\n明日临晴霁，黄花看晚晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34648,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅魂","author":"何梦桂","text":"香满罗帏凝不消，笛声吹断夜迢迢。\n霜蜚月落无寻处，欲倩青衣使者招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34649,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅影","author":"何梦桂","text":"玉颊寒肌强对人，今年清瘦不胜春。\n相知只有窗前月，摹写春风水上身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34650,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽山房先生 其一","author":"何梦桂","text":"东壁无光夜陨星，为公痛哭泪沾襟。\n才高不竟平生志，身死空留万古心。\n听曲谁能歌白雪，知音徒拟铸黄金。\n伤嗟迟暮邅吾道，恨不相从九地深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34651,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽山房先生 其二","author":"何梦桂","text":"病入膏肓药砭难，绵绵相忆劝加餐。\n击奸曾藉青萍剑，报德惭无白玉盘。\n树槚未成年岁暮，枯桑犹在海风寒。\n平生书至将盈箧，泪洒长笺不忍看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34652,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题观壁诗","author":"胡次焱","text":"仙子王僚上九天，山中遗迹尚依然。\n药炉云冷灰无火，丹井松阴地有泉。\n虫篆碑文传万古，鹤鸣华表动千年。\n我来吊古空惆怅，尘世茫茫几变迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34653,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日早行","author":"胡次焱","text":"草衣路室夜偏长，起问征途趁早凉。\n藜杖对星占曙色，芒鞋踏月涴秋光。\n栎阴羃砌疑浇墨，桂露滴人如馈浆。\n山鬼似嫌天欲晓，故嘘岚气扼朝旸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34654,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"媒问嫠","author":"胡次焱","text":"媒问嫠，汝何伤。\n汝为闺秀时，辛苦事蚕桑。\n僩瑟顺为正，婉娩礼自将。\n笥中有练裙，衣上无明珰。\n贫女古难嫁，卖犬办资装。\n中年得夫婿，憧憧拜姑嫜。\n肃容采蘋藻，洗手供羹汤。\n良人正少年，相期家道昌。\n良缘天所妒，夫婿奄云亡。\n自从夫婿亡，十年守空房。\n素帷代锦帱，苫席易牙床。\n孤眠耿夜半，单立黯昏黄。\n茕茕影徘徊，鞅鞅情彷徨。\n皓月照枕衾，暴雨颓垣墙。\n独寤谁呼唤，独语谁交相。\n如凌空失翼，如涉川无梁。\n嫠来吾语汝，琴瑟贵更张。\n汝箧既单薄，汝门复凄凉。\n汝寒何以衣，汝饥何以粮。\n纺绩终难给，舂汲劳欲僵。\n死者不复起，生者宜自详。\n邻有美丈夫，颙颙更昂昂。\n牛羊量用谷，金玉堆满堂。\n画梁青琐闼，珠帘毹氍厢。\n雕户金弹丸，宝鞍青丝缰。\n旌旗明晚霞，剑戟磨秋霜。\n奴隶厌绮纨，犬猫弃餦餭。\n门下粲珠履，庭前沸笙簧。\n出则专城居，入则侍明光。\n一呼千夫诺，一指万夫张。\n一笑生羽翼，一怒起锋芒。\n吾慕昔蹇修，与汝解佩纕。\n以此窈窕妇，配彼组绘郎。\n花树戏蛱蝶，莲浦浴鸳鸯。\n无烦赋藕花，且喜华枯杨。\n何妨鸾舞镜，应彼凤求凰。\n人无百岁人，倏忽如风狂。\n莫将泡影身，徒置冰炭场。\n死后留名节，身朽魂茫茫。\n生前受富贵，志得意洋洋。\n人生行乐尔，二者试裁量。\n蔬食不日给，孰与饫膏粱。\n荆钗不自谋，孰与云霞裳。\n年滔滔不反，貌骎骎已苍。\n败棋须换局，作戏且逢场。\n文君慕相如，恢女唤江郎。\n有发可重结，有耳何自戕。\n试问东夷子，何如声伯娘。\n信书不如无，未必有共姜。\n鬼妻变人妇，毋作老死孀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34655,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"嫠答媒","author":"胡次焱","text":"嫠答媒，妾自怜。\n妾家贫如洗，妾貌妆不妍。\n中年方择配，幸逢夫婿贤。\n蓝桥疑仙会，红叶开良缘。\n俯以奉箕帚，仰焉供豆笾。\n粤从定六礼，稳图偕百年。\n讵疑有家愿，倏罹中道捐。\n城崩哭呦呦，竹斑泪溅溅。\n空房照明月，幽陇凄寒烟。\n禽鸟喧墓门，魄降魂翩翩。\n蛜蝛满窗户，心结目涓涓。\n寮室昔华屋，埋玉今荒阡。\n恨不即同穴，何忍续断弦。\n翻思合?初，参透老婆禅。\n如鱼水游泳，如茑萝缠绵。\n奈何生死阔，泛泛水中船。\n绸缪为夫妇，反覆如市廛。\n徒贻杨华丑，宁免柳絮颠。\n妾颇亲笔砚，亦尝阅简编。\n女不践二庭，妇不再移天。\n陶婴寡鹄吟，卫妻孤燕篇。\n或刑耳自誓，或断发自全。\n或劓鼻偃蹇，或毁面迍邅。\n吾足幸可刖，吾臂不可牵。\n卓卓节操立，表表凤孤鶱。\n藐兹未亡人，有意奉周全。\n媒虽悯妾寡，媒适重妾愆。\n妾命春叶薄，妾心顽石坚。\n栖栖谋尺布，岂不羡罽毡。\n皇皇图斗粟，岂不思荤膻。\n胝手任舂汲，孰与奴婢千。\n鞠躬跧衡茅，孰与疏绮便。\n枯荄欣回春，缺月喜再圆。\n世谁不乐此，妾意独不然。\n理义自有闲，物欲常无厌。\n三少秽难洗，五嫁丑莫镌。\n浮荣瞥似电，遗臭流如川。\n媒言颇喋喋，媒意遽拳拳。\n之死矢靡他，斯言当真诠。\n文姬殊妖媚，易安亦婵娟。\n失身再事人，彤管无取焉。\n节义日以颓，文章何足诠。\n王母有差事，青鸟信频传。\n毋乃堕人欲，反以污天仙。\n嫦娥岂不嫁，空抱老金蟾。\n所以广寒宫，万古清鉴悬。\n宁贫任劳鹿，宁贱受磨研。\n宁冻如寒蝇，宁饿如饥鸢。\n终不以快乐，而易此忧煎。\n井底水不波，山头石不迁。\n再拜谢媒妁，归来双泪涟。\n十袭藏破镜，他年会黄泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34656,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅隐君六秩寿","author":"赵洪","text":"隐君家世出梅山，描得清芬满世间。\n梅禀正阳全太极，同姓同心不赧颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34657,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钉诗","author":"缪万年","text":"顽矿非铜刚样坚，寒坑才离亟趋炎。\n十来槌打随成器，一得人拈却逞鑯。\n不怕斧敲惟要入，全凭钻引任教嫌。\n休言深处难抽拔，自有羊蹄与铁钳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34658,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送马静山寄林晓山兄弟","author":"林千之","text":"古井谁复汲，古调谁复裁。\n玄鹤引清吭，万壑松风哀。\n彼美三株树，沆瀣?琼台。\n吾宗大小山，正尔期不来。\n袖有明月珠，远遗马子才。\n江空山亦深，乃肯穿苍苔。\n妙悟玄中玄，使我心悠哉。\n有墙肩曹刘，无苑延邹枚。\n采薇雾失道，钓鳌风折桅。\n朔风无重裘，地炉拥寒灰。\n两穷相值遇，一笑聊参陪。\n白日苦无光，暖律何当回。\n持此将安归，令人心胆摧。\n吾闻三神山，缥缈连蓬莱。\n沧海正清浮，神仙亦崔嵬。\n归欤三隽朋，下界空飞埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34659,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"塘下","author":"林千之","text":"一片颓园生谷桑，惟馀小圃佔秋光。\n竹篱蔓引牵牛碧，野菜崇生苦藚黄。\n抱叶蝉瘖枯树冷，衔花鹿去古台荒。\n兴亡往往关天数，搔首踌躇对夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34660,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送胡季昭谪象州","author":"罗耕","text":"赤心端欲赞皇图，鼓瑟那知却好竽。\n崇论已闻惊仗马，摅忠宁复忌城狐。\n当为天下奇男子，肯学人间小丈夫。\n更问澹庵老居士，儋州还似象州无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34661,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山斋夜坐","author":"平天祐","text":"悄然人不寐，山馆意何深。\n落叶添寒色，幽虫助苦吟。\n青灯怜夜永，白发带愁簪。\n天末怀良友，音书雁影沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34662,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"池上作","author":"朱绍远","text":"生涯幻吹沫，功名鲇上竿。\n鱼岂知许事，人意强相干。\n春风一鼓荡，芳池生碧澜。\n逐队半亩馀，乐有江湖宽。\n世路无险易，心閒自达观。\n悟彼蜗壳涎，空转蛣蜣丸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34663,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"濯足","author":"赵必涟","text":"小桥坐濯足，涧狭水流急。\n源头夜雨多，落花漾露湿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34664,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自题梅花庄","author":"赵必涟","text":"一间茅屋傍溪斜，三径荒于靖节家。\n但得鹤粮随分足，更须锄月种梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34665,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题梅花庄","author":"刘济","text":"庄后庄前千万枝，元方题扁季方诗。\n何当把酒对花树，坐到参横月落时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34666,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋思","author":"陈则翁","text":"在世身如客，馀年老一洲。\n荒村寒信早，黄叶晚风秋。\n水净见孤影，天空生远愁。\n杰然霜下菊，佳色满林丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34667,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题刘世疏庵","author":"释希坦","text":"藏却胸中万卷书，却来山顶结茅庐。\n当时若也羁缰锁，争得高名是世疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34668,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广化院","author":"释希坦","text":"路转几多曲，山登千万重。\n未游走马泽，先看斗鸡峰。\n高树出云耸，寒泉趁石舂。\n徜徉因觅句，时复倚青松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34669,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"福海院","author":"释希坦","text":"路入转幽处，浑疑别是天。\n虬松虽变化，牛石尚酣眠。\n骤过一番雨，鸣飞七布泉。\n望中千点雪，白鹭立平田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34670,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老人峰","author":"释希坦","text":"二气分时有此翁，寿年直与太虚同。\n想应伛偻千峰上，默笑人间说篯公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34671,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五台明智院","author":"释希坦","text":"时过九月秋，来作上方游。\n林瘦霜凋叶，钟鸣风满楼。\n五台新月上，一洞暮云收。\n夺利争名者，宁知此地幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34672,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"崇寿院","author":"释希坦","text":"踏破苍苔径，幽居在岭巅。\n亭台清映月，松竹淡笼烟。\n佳客才登席，高僧忽起禅。\n呼童急煎茗，新汲白龟泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34673,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曹溪","author":"释希坦","text":"五水奔流会合通，大溪飞过一长虹。\n芙蓉面目重重见，多在烟霞变态中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34674,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"华池","author":"释希坦","text":"阳魂日运金乌髓，阴魄时含玉兔脂。\n一旦相交化神水，山中分作两华池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34675,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李昭象书堂","author":"释希坦","text":"废兴生死妄安名，山水何曾改旧清。\n孰谓堂空人已往，溪声还作读书声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34676,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金步摇","author":"释希坦","text":"偶对丛条巧栉成，动摇徐步寂无声。\n仙花不识兴亡事，岂学吴宫响屧行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34677,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"婆饼焦","author":"释希坦","text":"绿柳含烟烟不消，红花喷火火无烧。\n如何焦却婆婆饼，每到春风舌苦饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34678,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昆山","author":"凌岩","text":"九峰西峙比昆崙，晋代将军墓尚存。\n今日扪萝登绝顶，桑丘麦垄自村村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34679,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"横云山","author":"凌岩","text":"七峰?崒拥层峦，偃盖孤松石上蟠。\n行云白龙何处去，暮云深锁洞门寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34680,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"机山","author":"凌岩","text":"六峰乔木锁云根，青接平原数里村。\n此处无人来听鹤，海灵山鬼哭黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34681,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"干山","author":"凌岩","text":"八峰葱茜石林幽，给事题诗记胜游。\n昨夜僧归钟鼓静，一声鹤唳海天秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34682,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"细林山","author":"凌岩","text":"四峰孤耸郁苍苍，新构僧庐傍野塘。\n林下雨晴春昼暖，松花薰得白云香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34683,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"佘山","author":"凌岩","text":"三峰高远翠光浓，右列仙宫左梵宫。\n月落轩空人不见，野花山鸟自春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34684,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"薛山","author":"凌岩","text":"五峰遥隔水村西，薛老曾来隐翠微。\n牧子唱歌樵子笛，贪看明月夜忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34685,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"凤凰山","author":"凌岩","text":"一峰云气接蓬莱，白石磷磷护碧苔。\n几向凤凰池上望，不知何日凤凰来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34686,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陆宝山","author":"凌岩","text":"三峰藏宝树精神，金碧楼台处处春。\n溪上落花流水远，老翁疑是避秦人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34687,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"叶宋英","text":"柳香何处春风店，酒醒月明闻杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34688,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"林月香","text":"楚人一缕垂亡命，尽向秦庭哭得回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34689,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"林月香","text":"六国既亡秦一统，如何却道帝秦非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34690,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"林月香","text":"那知老子痴顽福，曾见官家历五朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34691,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]