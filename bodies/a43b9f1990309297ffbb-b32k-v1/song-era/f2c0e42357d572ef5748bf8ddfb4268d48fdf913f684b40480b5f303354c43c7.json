[{"title":"寄高邮僧","author":"陈造","text":"门巷萧然草不锄，小轩祇置两团蒲。\n惟师表表丛林秀，眷我凉凉山泽臞。\n晨饭每同三韭陋，夜棋常办百筹输。\n一书未负西飞翼，满寄清风到座隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄章茂深郎中二首 其二","author":"陈造","text":"立谭当日受知深，不待陈情道古今。\n高会几陪山简醉，长篇许为爱卿吟。\n岁华迁谢心虽在，世路崎岖老不禁。\n拟近卞山谋卜筑，借公泉水濯尘襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄章茂深郎中二首 其一","author":"陈造","text":"州麾郎省未华颠，解组归来作地仙。\n杖屦良多闲日月，亭台仍占好林泉。\n青奴白牯冰壶里，堕絮漂花醉眼前。\n政用著书传我辈，未须缄口缚枯禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"崔侯燕城西高家亭复次韵","author":"陈造","text":"昔人胜践此兴怀，复见西园游上才。\n谭麈生风容满听，酒觞插羽未须催。\n小令纤指鸣飞雹，却遣红檀趁落梅。\n更约归来醉丛碧，将军端岂兴阑回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得侄消息二首 其二","author":"陈造","text":"二顷居耕穫，为谋未觉非。\n输租能早计，坐社莫相违。\n念我官将满，连宵梦只归。\n团栾老丘壑，肯作食言肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得侄消息二首 其一","author":"陈造","text":"甚喜年谷熟，仍闻佳食眠。\n郡人新过此，乡信得真传。\n社酒浮蛆渌，湖鱼割玉鲜。\n平时计安稳，莫靳里胥钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晚饭商卿家〗","author":"陈造","text":"我似长松久卧沙，迄今谏鼓梦犹挝。\n倚消愁斛人如玉，欲近书签眼有花。\n投老无庸尚强聒，过君每肯具柔嘉。\n婪酣得饱行摩腹，不省饥号有莫鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曹娥庙二首 其二","author":"陈造","text":"阅世谁无父，渠宁厌久生。\n惊波轻一死，森木竟双茔。\n石壁千寻立，江流万古清。\n祠宫拜遗像，犹复涕纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曹娥庙二首 其一","author":"陈造","text":"处死稽缃素，求名每寂寥。\n纷纷等枯冢，凛凛独高标。\n玉刻龟趺字，风驱水伯潮。\n英魂俨如在，楚些未须招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梁教病起","author":"陈造","text":"侧听长须得好音，笑谭已复替呻吟。\n逃知二竖今无地，仇想三彭亦就禽。\n定免带围忧沈约，可须檄手待陈琳。\n尚须十日安岑寂，酒圣诗愁恐未禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梁教授次柘枝诗韵再和","author":"陈造","text":"洞里莺花别有天，为渠蘸甲上金船。\n舞姝贪看尘生袜，饮兴浑忘雪满颠。\n弄影竞垂三昧手，倚风疑袅五枝莲。\n广寒再阅霓裳罢，笙鹤飞来未是仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祷雨凤凰山二首 其二","author":"陈造","text":"人心神理未交孚，敢爱微躯走道涂。\n云气满山空梦永，秧畦夹涧就焦枯。\n罢羸眼看号庚癸，感格吾犹愧鼓桴。\n老去忧民心易折，龙公高卧得知无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祷雨凤凰山二首 其一","author":"陈造","text":"跨凤西来得好山，千年人与凤俱还。\n本规法席专崭绝，先遣山灵凿捍顽。\n闻道碧泓严水印，试携清醥闯云关。\n此心炯炯龙应识，莫遣归涂更厚颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隐静简堂老赠藤杖","author":"陈造","text":"两枝藤杖各过头，一赠诗翁一自留。\n借力崎岖知意厚，分岐喧静果谁优。\n拄归山路烟岚好，横向禅堂魔魅愁。\n偿尽阿师行脚债，不妨分我老沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪晴再用韵","author":"陈造","text":"龙烛飞空雪渐无，光摇穷巷丽金铺。\n妓楼遽喜春生座，席户浑惊粟在肤。\n剡水不须乘兴去，饭山犹是作诗臞。\n自怜白发疏慵客，拥被高舂梦未苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪晴再次韵","author":"陈造","text":"璇穹瑩澈晴风后，晓日初融陌路泥。\n老桧苍筠潜动色，迎春送腊好分题。\n藏春僧閤心曾恋，闯海山亭梦到迷。\n回首桑阴三宿旧，鄮城东去虎存西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"骑过山村","author":"陈造","text":"烟村面势枕苍山，一径循山作屈蟠。\n入望高幢罗翠密，挂空匹练噀清寒。\n吟髭撚白迎风去，妆面骈红倚户看。\n颇似骑驴后山老，倩谁粉墨洒豪端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹿鸣宴致语口号","author":"陈造","text":"黄堂宾宴雾香浮，峙玉时髦得意秋。\n庄海长风吹怒翼，禹门惊浪化吞舟。\n黄生眉宇看辉映，渌涨瑶杯剩献酬。\n来岁归时君记取，恩袍成行拥龙头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄尉挽章二首 其二","author":"陈造","text":"落笔心犹壮，论年鬓未斑。\n砚捐初铸铁，泽失善藏山。\n谈麈那容数，灵輀去莫攀。\n松阡萦望眼，衰泪可胜潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄尉挽章二首 其一","author":"陈造","text":"传绪祖风懿，居乡家道肥。\n群书了渔猎，一性自弦韦。\n官仅纡黄绶，时须补黑衣。\n空缠百身恨，遽作九原归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19650,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"傅商卿借鹅","author":"陈造","text":"吾家水豢惯秋春，谷饲栏栖又一新。\n友义何须换鹅帖，邻墙防有嗾獒人。\n眠沙泛渚期它日，问俗充庖戒未仁。\n酬我质剂当倍称，学书还复慰清真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19651,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨燕致语口号","author":"陈造","text":"华筵楚楚为谁开，和气融融逐雨回。\n饮处偕酬未央乐，旱馀新纪不为灾。\n诗成肯放庭阴转，舞困何妨羯鼓催。\n听取邦人歌笑地，山城几处不春台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19652,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"强同年次子挽诗二首 其二","author":"陈造","text":"弱岁不好弄，俯窥同队鱼。\n开编便头角，诸老办吹嘘。\n囊锦馀诗草，悲风忽輤车。\n人今埋玉恨，清泪洒衣裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19653,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"强同年次子挽诗二首 其一","author":"陈造","text":"识子初衿佩，崭然自夙成。\n风猷乃公似，文字老夫惊。\n遽陨连城器，难推造物情。\n新宫漫仙伯，政复待君铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19654,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游乾明分韵得山字","author":"陈造","text":"一从隽轨得追攀，日日江皋倒载还。\n贪向诸公论友义，未容老子忆家山。\n酒边鲸吸仍畴昔，笔底羊肠出险艰。\n莫便樽前话分袂，此心不与石俱顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19655,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登平山堂","author":"陈造","text":"平山堂上命琴樽，前辈风流肯见分。\n恋客懒斜当槛日，藏山不断隔江云。\n吟笺得意窥天巧，醉面禁凉减缬纹。\n杖策归来新月上，落梅如雪点风裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19656,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登招宝山","author":"陈造","text":"一鹫风烟上，三韩指点中。\n地随山共尽，天与水无穷。\n梦蚁纷轩冕，骑鱼可阆蓬。\n仙曹应拊掌，顾我簿书丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19657,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答寿诗","author":"陈造","text":"感念垂弧日，无成忽老衰。\n尚须庚癸诺，可讳甲辰雌。\n但有散人传，难胜幼妇辞。\n呼兄张座右，言配蓼莪诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19658,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答龚炳泽卿","author":"陈造","text":"之子违离久，前宵梦见之。\n秋蛇开侧理，晓鹊啅疏篱。\n歆秀何时改，郊庠更问为。\n有言今赘矣，暗里自应知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19659,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢陈梦锡诗卷二首 其二","author":"陈造","text":"高才万夫敌，馀事十全医。\n有句撞哀玉，它年饮上池。\n可缘乖世用，政自畏人知。\n当复嫌多口，频烦说项斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19660,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢陈梦锡诗卷二首 其一","author":"陈造","text":"诗法工如此，何时粟一囊。\n渠侬须拥彗，老子欲烧香。\n世论瞢贤否，人家皆稻粱。\n愿天开老眼，为子疗饥肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19661,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢袁起岩使君借贡院居 其四","author":"陈造","text":"槃薄萧寺中，永叹无客到。\n吾室自勃溪，粗免以饥告。\n及此荫宽閒，好风日见劳。\n安得长者车，茶饼写襟抱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19662,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赏酴醾病不赴","author":"陈造","text":"不得花前共一樽，萧斋药裹自相亲。\n闲追水佩风裳梦，空负云阶月地春。\n缥缈瑶英雾为幄，敷腴玉面酒生鳞。\n蜚觞刻烛输公等，定指芳条笑恶宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19663,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感兴","author":"陈造","text":"如镜江流去，奔驰合自羞。\n病容霜后叶，归兴浪前沤。\n岐路三生债，风埃一饱谋。\n山田饶芋栗，珍重故园秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19664,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简章宰二首 其二","author":"陈造","text":"缥缈云藏羽客庐，不妨寻胜小踟蹰。\n鸱夷载酒莺花处，古锦囊诗簿领馀。\n百和风轻吹欲醉，万山岚凝对凭虚。\n谭间定笑衰慵客，竹屋高舂尚枕书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19665,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简章宰二首 其一","author":"陈造","text":"蕙兰洲北观山头，未暇寻盟访旧游。\n自笑春来多病过，静无人处但诗愁。\n遥知联辔穷幽胜，更想簪花剩献酬。\n报答东风应得句，奚奴亟肯寄侬不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19666,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鉴湖道中","author":"陈造","text":"风烟佳处放归桡，吟坐篷窗首屡搔。\n万壑千岩争献状，三江九堰自忘劳。\n尚多菡萏张秋锦，少待蟾蜍印夜涛。\n缭碧森青谁子宅，未容载酒访清高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19667,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赭圻","author":"陈造","text":"朱旗仅奏蜀川功，咫尺中原未向风。\n礼接谢安犹故旧，心知越石是英雄。\n生前逆气无宗国，身后馀殃有狡童。\n忍对青山话遗臭，人生过鸟抹秋空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19668,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题成倅小筑","author":"陈造","text":"主人领客竟成迟，闲杀林园此段奇。\n胜日阿莲须后乘，即今佳菊尚东篱。\n肯来雪壁题诗处，许继华堂堕帻时。\n醉后与渠同起舞，一庭花影月迷离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19669,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题吴司理子隆兼隐","author":"陈造","text":"绅笏视林薮，达人忘异同。\n端知柱下史，却笑鹿门翁。\n犴狱仍阴德，诗书亦隽功。\n何须笠泽去，烟浪放船篷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19670,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陈主管小壶天三首 其三","author":"陈造","text":"未放歌云散，先看醉帽偏。\n周郎自醇酎，乐广定青天。\n持胜收贤业，推枰睨世缘。\n明年一品手，却访玉堂仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19671,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题陈主管小壶天三首 其二","author":"陈造","text":"棋枰外世故，喧静信奇偏。\n俗网恢三面，冰壶令一天。\n时供诗友课，未断宰官缘。\n付我红尘去，如君自半仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19672,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题林监税渔乡小楼","author":"陈造","text":"半是蜚轩半是楼，主人雅趣寄沧洲。\n晨霞莫霭纷浓淡，越舶番樯阅去留。\n徙倚想君舒醉眼，从容须我掉吟头。\n病来止酒便高卧，几梦烟波没白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19673,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题彭传师无喧境壁","author":"陈造","text":"尘外轩窗寓啸吟，胜游重到更情深。\n湖山觌面浑相识，蜂蝶窥帘似见寻。\n客路每歌归缓缓，岁华亦叹去骎骎。\n摩挲竹树论今昔，亲见栽时已欲林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19674,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题殖轩","author":"陈造","text":"窗户青红断手初，桃蹊竹径类僧居。\n日陪骚客挥椽笔，时著班衣奉板舆。\n领会能忘一樽酒，穷通拟付十年书。\n仍闻布谷催春事，一雨朝来溜决渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19675,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题潘德久竹居","author":"陈造","text":"竹里幽栖不掩关，解将应俗等居山。\n风流彭泽羲黄上，诗力苏州季孟间。\n官缚犹存紫公服，客来肯靳玉绦环。\n雪儿小直珠千斛，可但疏帘见一斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19676,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕乡守致语口号","author":"陈造","text":"胡床玉麈锦囊诗，宾主风流此一时。\n玳席邀欢酬令节，羽觞湛碧转微漪。\n绮罗围外香风远，弦管声中漏刻迟。\n莫道兰亭已陈迹，胜游端复嗣芳规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19677,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠四子二首 其一","author":"陈造","text":"峨峨冰港仅通舟，策策霜风透重裘。\n良为予来真好事，小留君住得销忧。\n可无谭笑传觞处，剩有烟云洒笔头。\n保社相娱倚公等，暮年干禄判悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19678,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠仲国美","author":"陈造","text":"三阅春光一建瓴，依然归棹泊危亭。\n乌迎客子各头白，柳学故人俱眼青。\n曾是纵谭僵婢仆，又成豪饮卧罍瓶。\n明朝小话前溪别，分付溪风管醉醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19679,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠陈居士","author":"陈造","text":"昏宦冥冥堕急流，羡君高谢此笼囚。\n能诗似是林和靖，博古宁惭许散愁。\n上药化金才顷刻，虚舟触物信沉浮。\n何时我亦休官去，对卧元龙百尺楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19680,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠陈钱二别乘 其一","author":"陈造","text":"蜂蝶如相识，窥人却怪生。\n平时被花恼，因病此心轻。\n笑语初疑梦，香红旋问名。\n杖藜回白首，颓景欻衔城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19681,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠陈钱二别乘 其三","author":"陈造","text":"小筑萦人梦，诗翁况旧期。\n定携桃叶女，犹羡习家池。\n莺燕听歌惯，风烟取醉宜。\n饯春馀几日，一笑更容迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19682,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠陈钱二别乘 其二","author":"陈造","text":"花气浮迟日，莺歌佐缓觞。\n肯孤留客意，兼贷著书忙。\n畴昔朋游乐，扶携醉后狂。\n因君话尘外，清兴顿能长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19683,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠陈签判","author":"陈造","text":"熠熠萤光略露荷，摇摇杯面涨金波。\n受风正作团栾饮，闭户深防褦襶过。\n情话想无云母隔，新篇应有雪儿歌。\n揆予可讳刘郎笑，讲舌长乾鬓自皤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19684,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠实老","author":"陈造","text":"几时风色不飞沙，再遣斋鱼为客挝。\n尘里槐安空梦境，眼中优钵忽天花。\n玄谭正用蠲忧患，白饭胡宁当旨嘉。\n南去路贫同一笑，不忧攫肉有飞鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19685,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠相士蜀张二诗 其二","author":"陈造","text":"贫病谢人谋，形容览镜羞。\n要随耕钓往，聊为斗升留。\n子术诚探妙，吾门恐暗投。\n霜髯文学掾，宁复邓元侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19686,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠赵步帅","author":"陈造","text":"出处升沉转首非，无端颠倒念分违。\n瘦羊博士尚骨立，白马将军今肉飞。\n共仰钩陈明帝极，少须尺箠下金微。\n为公草罢平羌檄，径指淮乡旧钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19687,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠赵秀才","author":"陈造","text":"衮衮红尘去，扁舟得挽回。\n半生障日手，一笑沃愁杯。\n应俗吾衰矣，论文子壮哉。\n明年日边信，满冀好怀开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19688,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠赵秀才一首","author":"陈造","text":"平生心事钓渔舟，邂逅青衫映白头。\n肯为功名戏雕虎，不留颜面对沙鸥。\n露漙青盖高荷晓，风约黄陂小麦秋。\n入眼斜川归趣好，此身何处不菟裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19689,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠赵监岳","author":"陈造","text":"才俊如君士论推，下交从昔最知归。\n谈间八面无馀敌，酒处千金不当挥。\n方办西湖陪语笑，预愁南浦诉分违。\n只今又捧江西檄，连夜惊魂梦打矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19690,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠课会诸公","author":"陈造","text":"书社他年事，寻盟未厌烦。\n须吾执牛耳，助子跃龙门。\n凌厉先诸彦，从容即万言。\n隽功科举外，暇日要深论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19691,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠课会诸公","author":"陈造","text":"岁月翩翩骥受檛，妙年云路不应赊。\n手中白羽真穿叶，门外苍槐又著花。\n丹灶功成须换骨，天河波浅待乘槎。\n雁行看即青冥上，却笑臞儒两鬓华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19692,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠高司理","author":"陈造","text":"穷乡洗眼挹清扬，凛若重登月旦堂。\n骥子凤雏端不苟，吏能儒业况兼长。\n简孚首解秋荼密，襞积仍熏古锦香。\n我亦床头一经在，自公正欲共平章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19693,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠高黄二子","author":"陈造","text":"平昔金兰契，过逢意自饶。\n乘闲无窘步，命笑有嘉招。\n翠敛歌眉黛，红生醉颊潮。\n归骖从惜夜，小待玉笙调。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19694,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠曹秀才二首 其二","author":"陈造","text":"抖擞胸襟一不优，迂临惟子肯绸缪。\n访书笠泽心摧落，苟禄吴门路阻脩。\n老去欲追三径约，客来当办一钱留。\n它年水北山南计，更挈诗瓢就我不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19695,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠曹秀才二首 其一","author":"陈造","text":"不复林逋起九京，空留诗卷逼人清。\n如君况自鬼神助，掷地应闻金玉声。\n败履人今笑东郭，奔蜂我亦愧南荣。\n三千奏牍真馀事，侧耳齐廷待一鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19696,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]