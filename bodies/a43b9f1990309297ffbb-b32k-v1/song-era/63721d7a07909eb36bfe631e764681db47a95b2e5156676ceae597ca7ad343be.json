[{"title":"过金仙寺","author":"韩淲","text":"陟径沿冈上玉田，穿墟涉港遇金仙。\n黄云割尽桑重绿，风撼舆篮但兀然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鹅湖僧房","author":"韩淲","text":"青笋初成宿雨晴，并檐啼鸟两三声。\n鹅湖峰下僧窗晚，一枕谁知梦亦清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"僧房 其一","author":"韩淲","text":"炷香小阁听山雨，木叶风摇万壑声。\n更与野僧供茗事，是知身外有閒僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"僧房 其二","author":"韩淲","text":"僧床午睡梦初成，展转轻安分外清。\n搔首起来神观定，一窗山影正虚明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"辩才塔院次致道韵","author":"韩淲","text":"苏赵从前说辩才，后人尘土不须猜。\n风篁岭下青春晚，寂寂应知我独来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子陵墓","author":"韩淲","text":"閒来信脚到乾封，千古清名一梦中。\n却忆桐江客星阁，可怜田垄对秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观李参政墓","author":"韩淲","text":"石壁云泉四十秋，儿时来往见风流。\n可堪松柏衣冠地，世事深沉懒转头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谒尹谏议墓","author":"韩淲","text":"髣髴儿时拜德容，中州江左事难同。\n高泉宰木阴阴绿，白发人来酹晓风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拜王处士墓","author":"韩淲","text":"不见先生已六年，湖团只是旧山川。\n我携茗酒奠荒草，寒雨吹风泪湿烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拜吕舍人墓","author":"韩淲","text":"生晚常嗟南北分，故家文献少知闻。\n襄阳耆旧无庞老，独对高坟看白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过南豅有怀成季之亡 其一","author":"韩淲","text":"西风原上脊令寒，零落交游我独难。\n不信人间有生死，菊花还作去年看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过南豅有怀成季之亡 其二","author":"韩淲","text":"纷纷人物古犹今，夭寿衰荣共此生。\n秋冷南豅半沟水，翛然唯见二难兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过南豅有怀成季之亡 其三","author":"韩淲","text":"红叶初翻秋已深，暮云凝乱薄寒侵。\n排空忽断飞鸿影，谁识江湖万里心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐子颜挽章 其一","author":"韩淲","text":"信城多士固多才，乡老凋零安在哉。\n自哭湖团王处士，每逢人逝有馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐子颜挽章 其二","author":"韩淲","text":"被褐纱巾醉后歌，寻常还往记婆娑。\n遁翁九日同登处，残照吹红玉水波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐子颜挽章 其三","author":"韩淲","text":"坚坐山头十数年，后来卜筑转萧然。\n古梅风折篱倾倒，朱橘空垂屋角边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐子颜挽章 其四","author":"韩淲","text":"门外曾听刺史车，也令乡国重贫儒。\n伤心又赙君之葬，此事应须近日无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27791,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐子颜挽章 其五","author":"韩淲","text":"人营家室因妻子，二者何能一一贤。\n到底伶俜反无累，反乎真宅总如然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27792,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐子颜挽章 其六","author":"韩淲","text":"霜风漠漠叶阑斑，积水陂池映浅山。\n气尽敛形阴野土，一生心事白云閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27793,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐子颜挽章 其七","author":"韩淲","text":"覆雨翻云以利名，汉庭无日不公卿。\n试言行志今谁是，却羡长贫过此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27794,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐子颜挽章 其八","author":"韩淲","text":"宗人相送入山阿，谁挽谁扶谁作歌。\n既老无家且无子，不知君者谓如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27795,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐子颜挽章 其九","author":"韩淲","text":"常与交朋奉杖藜，放怀携手动移时。\n苍茫溪北溪南路，忍对交朋只自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27796,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐子颜挽章 其十","author":"韩淲","text":"谈天谈佛共谈仙，静里光阴不计年。\n几度过家扶醉去，岂知今日见沉泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27797,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"怀古","author":"韩淲","text":"往来是日月，变动是寒暑。\n伏腊虽不周，尔且对妻子。\n遥知风尘表，万象互吞吐。\n所以鹿门人，江左不得取。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27798,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"五月十日","author":"韩淲","text":"片月生林白，沿流涧亦明。\n幽人方独夜，山寺有微行。\n野处偏宜夏，贫家不厌晴。\n薰风吹老鬓，腐草见飞萤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27799,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七月三首 其一","author":"韩淲","text":"地僻稀人迹，重林日自虚。\n鸟飞晨气外，蝉噪晚凉初。\n馀润从侵屦，浮埃倦整书。\n樵渔时上下，闭户又何居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27800,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七月三首 其二","author":"韩淲","text":"木末芙蓉起，亭亭绿且青。\n墙犹承片瓦，窗不碍疏棂。\n次第花擎盖，纵横叶展屏。\n石丁谁主者，仙岂待沉冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27801,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七月三首 其三","author":"韩淲","text":"拥砌丛生菊，何关老意多。\n浇花惊易燥，耘草喜成科。\n枕腊尤宜睡，餐香岂待哦。\n渊明藏不尽，满把尚婆婆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27802,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋呈潘德久","author":"韩淲","text":"一年明月在中秋，数日阴云不奈愁。\n忽喜新晴转书室，极知清夜照歌楼。\n醉当弄影如坡老，诗就撞钟忆贯休。\n千里故人应若此，吾生常好更何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鹅湖道中 其一","author":"韩淲","text":"野花狼藉雨初晴，人在山南山北行。\n东风浅浅尚寒色，云映远天斜照明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鹅湖道中 其二","author":"韩淲","text":"高田下田流水声，前村后村鹁鸠鸣。\n山矾已开桃已谢，霏霏小雨未成晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鹅湖道中 其三","author":"韩淲","text":"雨斜风骤树连云，荒远人家酒不村。\n小醉未成愁又入，更无情绪到清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鹅湖道中 其四","author":"韩淲","text":"青松影里小桃花，山崦横冈人几家。\n牧童樵子自来往，水拥断沟留残沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周国正约过茶山带湖","author":"韩淲","text":"青春行乐耳，谁无一林园。\n馀阴敛宿雨，桃李亦复暄。\n坐閒语句到，酒半情意宣。\n从容出处易，缅邈聚散难。\n记此野城北，望望横灵山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次公招看绿萼梅和韵","author":"韩淲","text":"春山有梅，萼绿香洁。\n爱雪宜霜，凭风藉月。\n花已开明，枝复横绝。\n翠袖天寒，供吟试折。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十五日舒村","author":"韩淲","text":"秋水澄溪渌，秋山远岸青。\n村酤因觅句，雅放却嫌醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"深村","author":"韩淲","text":"已是依山住，更为深村行。\n莽莽少人迹，幽幽闻鸟声。\n忽逢三四家，草树亦敷荣。\n不觉六七里，烟霭还纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"初八日传闻光州虏退又云东海之捷","author":"韩淲","text":"疆埸未云静，家国疑摇摇。\n深乎帷帐筹，公卿日以朝。\n虏势固不壮，虏骑固为骁。\n强弱士气少，战守民力凋。\n荒山涧壑冷，岁暮风萧萧。\n百草皆烂死，扑面黄叶飘。\n枭鹠互鸣啸，狐豺纷踯跳。\n秃鬓祗枯藜，伫立天益寥。\n恭惟我寿皇，恢复悉有条。\n咄哉开禧臣，妄动尤虚嚣。\n女贞亦分裂，幽燕乱无聊。\n贤愚世运厄，隆替华夏焦。\n羌戎汉威灵，河隍唐僖昭。\n民老曾何知，但愿归富饶。\n中外持论平，致君舜与尧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故友不可见新相知者有数","author":"韩淲","text":"老觉宾朋日日稀，故家言语转依违。\n百年以往自兴废，千古其间谁是非。\n江左风流徒可想，山东豪杰竟何归。\n勾吴于越连闽峤，瘴雨蛮烟百鸟飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题孙伯符墓","author":"韩淲","text":"自无太史慈，孰对孙伯符。\n群舒有馀地，周郎或知予。\n既推道南宅，以湿谩相濡。\n本拟驰中原，扫灭邺中都。\n天乎许贡客，一箭失壮躯。\n黾勉付后事，张昭乃其奴。\n赤壁之火攻，仅可保全吴。\n公瑾复不长，伯业益荒芜。\n至今春草生，高坟在姑苏。\n传言尚相点，经行倍踟蹰。\n异代岁月速，谁为我非夫。\n酹酒起英爽，白杨鸣赤乌。\n荆州或已分，曹刘竟称孤。\n堂堂破虏冢，归命诚足俘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"韩淲","text":"玄机未易窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27815,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄甘孝先二首 其二","author":"王大受","text":"古戍相从已许年，中间转徙废书传。\n似闻南栅溪边柳，准拟君来系酒船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27816,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"客枕","author":"王大受","text":"山居猿狖最多情，啸月旋风伴醉醒。\n昨夜数声霜雪外，元来不比在家听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27817,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉山道中","author":"王大受","text":"夜夜还家梦，行行扑面风。\n征尘添老色，酒病重诗穷。\n世路方行险，吾生且转蓬。\n天涯重回首，愁满夕阳中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27818,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"抵袁阳 其二","author":"施德","text":"曲涧萦纡树密蒙，放船正值楝花风。\n王程不及村南好，水碓无人昼自舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27819,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"李埴","text":"日射红鸾扇，风清白兽樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27820,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句","author":"徐玑","text":"薤叶秀且耸，兰香细而幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27821,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其二十","author":"杨皇后","text":"迎春燕子尾纤纤，拂柳穿花掠翠檐。\n闻道蕊官三十六，美人争为捲珠帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27822,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宫词 其二十四","author":"杨皇后","text":"凉秋结束斗炎新，宣入毬场尚未明。\n一朵红云黄盖底，千官下马起居声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题马和之画四小景 其一","author":"杨娃","text":"人道中秋明月好，欲邀同赏意如何。\n华阳洞里秋坛上，今夜清光此处多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"静观堂十偈 其二","author":"汪晫","text":"一间虚室自安然，何必求仙更问禅。\n尽日焚香闭门坐，饥来吃饭困来眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感兴四章章五句 其二","author":"汪晫","text":"胶扰浮生事若麻，世路崎岖易覆车，争如清净山人家。\n静观抚掌付一笑，出户蔌蔌飞松花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感兴四章章五句 其三","author":"汪晫","text":"一树雪花白如玉，辛夷为车荷为屋，閒中享此亦清福。\n一双沙禽竹上啼，对客取琴弹一曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27827,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感兴四章章五句 其四","author":"汪晫","text":"坐读南华一卷经，富贵百年如邮亭，人生怒瘿空成瓶。\n香炉缕烟风浩荡，白鸟点破前山青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27828,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"汪晫","text":"灭烛闵蛾伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27829,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈颂一百零一首 其八十三","author":"释慧性","text":"春山青，春水绿。\n春雨濛濛，春花簇簇。\n春光满目画难成，春风万里何拘束。\n肥马辘辘，瘦马辘辘。\n日逐忙忙等闲过，些儿毒气谁轻触。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27830,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九月十八日夜梦赏春某氏园池赋春词二首题柱 其二","author":"刘学箕","text":"楼下酴醾压架香，翠围帷幄覆池塘。\n桃花浪煖鱼成阵，人倚雕栏到夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27831,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"种梅","author":"刘学箕","text":"隐沦冲寂澹生涯，芍药樱桃厌艳华。\n剔乱剪繁疏影瘦，临溪只合种梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27832,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古坟诗","author":"周端臣","text":"短墙摧倒树攲斜，碧荠春开满地花。\n马鬣就荒无认处，墓前碑在野人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朱门","author":"周端臣","text":"朱门茅屋偶为邻，北阮那怜南阮贫。\n却是梅花无世态，隔墙分送一枝春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过山阴希瓐侄新居","author":"赵师吕","text":"美哉轮奂构华堂，如鸟飞兮接大荒。\n广植门墙容驷马，洞开扃户透书香。\n满帘湿翠怡情远，入座清晖引兴长。\n会见祝言千万载，纷纷燕雀贺高堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27835,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孤山行","author":"释居简","text":"盛时考槃古逸民，湖山草木咸知名。\n至今八篇烂古锦，岂特五字如长城。\n长驱万骑到其下，束手按甲循墙行。\n大邦维翰蔽骚雅，遐冲既折犹精神。\n抗衡剧孟一敌国，弹压西子孤山春。\n死诸葛走生仲达，送修靖邀陶渊明。\n聚蚊莫及怒雷迅，老瓦不乱黄钟鸣。\n清弹岂为赏音废，自芳更问林扉扃。\n鸥盟未冷浪拍拍，弋者何慕鸿冥冥。\n水流山空鹤态度，冰枯雪寒梅弟兄。\n梅当成实自调鼎，鹤既生子仍姓丁。\n乡来偶同赋招隐，老去亦各相忘形。\n故庐夜夜月如昼，少微耿耿天无云。\n千金傥可市骏骨，万古适足空凡群。\n百身可赎但虚语，九原唤起知无因。\n为公满酌井花水，酹一抔土公应闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27836,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"塘淫","author":"释居简","text":"苍官百夫雄，盘错千仞冈。\n铁干紫尤劲，铜柯青更刚。\n屡吞霜雪敌，弗受斤斧戕。\n支厦不为柱，跨壑犹飞梁。\n胡为在泥滓，断岸繄关防。\n岂伊坚贞姿，泥滓永相望。\n中分枵其中，吻合相抵当。\n彼巧事穿凿，我方信行藏。\n惟其司出内，秉彝德之常。\n谨口饱涵畜，与时相抑扬。\n持满岂无道，损馀端有方。\n尾闾小溟渤，砥柱回污潢。\n瞥尔手翻覆，枯涸随汪洋。\n叔度万顷陂，未足与较量。\n匠氏弗遇郢，才不登俊良。\n藐然用其小，约水不得洚。\n有若古豪隽，落落吞湖江。\n遭时发所蕴，利泽何其厖。\n时哉倘不逢，蕙帐云雾窗。\n独善与兼善，一辙元非双。\n任大岂遗小，养浩惟能降。\n对此一感慨，勿谓吾言哤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27837,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"檄菖蒲","author":"释居简","text":"陶器承昆珉，猎猎散绿丝。\n饮以一杯水，卒岁长如斯。\n露叶矗锋锷，霜根蟠崄巇。\n昌阳欲论功，十驾不得追。\n松柏脚踏土，并驱仍背驰。\n寒苦我所安，泉石皆闻知。\n岂意泉石间，得此偿心期。\n澡濯冀怀新，疏剪贵适宜。\n芳洁日以薄，潜逐炎凉移。\n谓我水太清，汝便清涟漪。\n抑我水太浑，古井非污池。\n孤根要特立，晚节须坚持。\n贞姿或不返，终当怨尤谁。\n春葩与秋芗，擅美固有时。\n西风一摇落，不死将安之。\n亦足观物化，亦足为箴规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27838,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次宫讲于素斋韵为别 其一","author":"释居简","text":"凫短何曾计鹤长，从他踽踽复凉凉。\n马归塞上元非失，弓在人间岂是亡。\n旋别薰莸充子佩，剩栽红白课蜂房。\n到家趁得梅花在，分遣飞来数点香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27839,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次宫讲于素斋韵为别 其二","author":"释居简","text":"无言桃李各成春，造化番腾巧入神。\n佳境骎骎逢蔗尾，苦心隐隐饫猩唇。\n蠖虽善屈难忘直，虹岂长蟠不得伸。\n一日百畦机事了，区区亦有汉阴人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27840,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月初九日客舍","author":"释居简","text":"水冻冰连底，山疑雪满颠。\n恰才如旧腊，全不似新年。\n绵折何曾暖，柴生只拥烟。\n较他山店雨，枉自怨秋天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27841,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上钱昭文","author":"释居简","text":"拄天有佳木，青跨云沉沉。\n不知几何高，四海分清阴。\n悠然响虚籁，万象寂若瘖。\n寒则为阳和，盎盎春昼深。\n穆若吹清泠，六月消烦衿。\n烈风益遒劲，厚地盘崎嵚。\n浓翠出云雨，大旱徯作霖。\n巍巍架明堂，枝干端可寻。\n上有孤凤凰，下有众羽禽。\n和乐声成文，戛击韶濩音。\n大雅得指归，一洗郑卫淫。\n向来艰难际，凡才空满林。\n天风一披拂，寸碧开遥岑。\n遂使化弦改，人命蚁出燖。\n大哉德曰生，抑见天地心。\n悠悠江海人，蜀道扪井参。\n怀土如仲宣，破囊无一簪。\n回首白玉霄，欲往勇不禁。\n区区竟何有，有句如惜金。\n金亦不足惜，铸作颂与箴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27842,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"早课","author":"释居简","text":"井花嫩煮熨梅花，先酌芳甘注佛茶。\n冷淡工夫相次了，却留窗日看横斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":27843,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]