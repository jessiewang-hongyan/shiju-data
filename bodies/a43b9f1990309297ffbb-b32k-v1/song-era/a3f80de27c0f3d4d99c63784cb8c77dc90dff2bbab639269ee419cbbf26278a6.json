[{"title":"菩萨蛮","author":"利登","text":"玉阑干外重帘晚。\n流云欲度长天远。\n花草不知名。\n春来各自春。\n绿鞍游冶客。\n何处垂杨陌。\n不信不归来。\n海棠花又开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虞美人","author":"利登","text":"当时养士知何许。\n总把降幡去。\n汉家王气塞乾坤。\n一树盈盈、不为汉家春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"利登","text":"凤尾鬟香再叠梳。\n藕丝衫嫩蹙双鱼。\n闲收末利熏藤枕，自插芙蓉绕翠幮。\n新浴后，浅妆初。\n卫夫人帖学行书。\n西窗一霎黄昏雨，笑问新凉饮酒无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铁券山","author":"吴之选","text":"宗派天潢衍，文章吏部遗。\n前朝尺土尽，轶事几人知。\n岁月松杉古，尘沙日夜吹。\n数家芳草外，凭吊总凄其。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南乡子","author":"吴亿","text":"江上雪初消。\n暖日晴烟弄柳条。\n认得裙腰芳草路，魂消。\n曾折梅花过断桥。\n潘鬓为谁凋。\n长恨金闺闭阿娇。\n遥想晚妆呵手罢，夭饶。\n更傍珠唇暖玉箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烛影摇红 上晁共道","author":"吴亿","text":"楼雪初消，丽谯吹罢单于晚。\n使君千炬起班春，歌吹香风暖。\n十里珠帘尽卷。\n正人在、蓬壶阆苑。\n卖薪买酒，立马传觞，升平重见。\n谁识鳌头，去年曾侍传柑宴。\n至今衣袖带天香，行处氤氲满。\n已是春宵苦短。\n且莫遣、欢游意懒。\n细听归路，璧月光中，玉箫声远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头","author":"吴千能","text":"澹氏人安在，缥缈九霄间。\n我来唯有石屋，周览百寻宽。\n一曲中分夷险，两牖空光平布，满洞贮清寒。\n高歌自堪仰，何必论金丹。\n周贤士，知此意，薄秦官。\n一床一枕，依然犹伴白云闲。\n门外俗尘如海，门里道心如水，谈笑足回澜。\n此事无今古，不信叩嵛山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长桥","author":"吴及","text":"有客过津亭，高歌愿濯缨。\n阑干聚烟碧，波浪捲秋声。\n蝀饮潇湘渴，龙游河汉横。\n夕阳看不厌，待看月华生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登狼山","author":"吴及","text":"郡僻山更远，尘喧与世违。\n水横观雁度，天静见龙归。\n落叶霜凝树，思亲泪湿衣。\n西风怕回首，不忍白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂诗 其三","author":"吴大有","text":"客行情最苦，草草共清尊。\n万水千山路，今朝好出门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂诗 其二","author":"吴大有","text":"山中多雨水，秋晚正妨农。\n病菜和根煮，新粳带湿舂。\n拥沙埋废井，堕石折枯松。\n寂寂猿啼昼，白云藏数峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂诗 其一","author":"吴大有","text":"多年书问断，湖海竟悠悠。\n一见心虽满，相看泪忽流。\n彩烟山色暮，碧濑月痕秋。\n明日登程去，鹡鸰河上愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游上竺寺","author":"吴大有","text":"编茅为屋住，结叶作衣裳。\n不试烧金诀，惟寻煮石方。\n洗瓢溪月冷，采药野云香。\n尝有仙家鹤，飞来绕石傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂诗 其四","author":"吴大有","text":"雁声低度水村深，中有人敲月下门。\n满屋秋风灯欲暗，江山千里故园心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚过西湖","author":"吴大有","text":"曙色溟溟湿缊袍，涌金门下上轻桡。\n五更钟鼓星初没，两岸楼台雾未消。\n路傍柳洲人语近，山连葛岭鹤声遥。\n冲寒亦有寻梅客，拥袖骑驴过短桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 送李琴泉","author":"吴大有","text":"江上旗亭，送君还是逢君处。\n酒阑呼渡。\n云压沙鸥暮。\n漠漠萧萧，香冻梨花雨。\n添愁绪。\n断肠柔橹。\n相逐寒潮去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访隐者不遇","author":"吴子文","text":"道人入山访道人，山深俗朴鸡犬驯。\n道人不见道人去，?毵草木无边春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"林和靖祠","author":"吴子良","text":"松树高低逐径斜，祠堂牢落锁烟霞。\n我来閒咏梅花句，想见此翁如此花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"葵花","author":"吴子良","text":"花生初咫尺，意思已寻丈。\n一日复一日，看看众花上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吴子良","text":"问花何事人偏爱，会遇渊明把玩来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行即事","author":"吴子实","text":"烟暗前村树欲无，草蓑箬笠一翁渔。\n无端风伯吹斜雨，湿却蓬窗数册书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题张穫轩诗卷 其一","author":"吴子实","text":"中兴踰百载，独有放翁诗。\n豪出谪仙右，妙惟工部知。\n镜湖归老日，剑阁入军时。\n英气今何在，九原千古悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题张穫轩诗卷 其二","author":"吴子实","text":"句法亲传得，江湖老穫轩。\n推敲深得趣，穷达可曾论。\n好爵无三字，清名有五言。\n还知绝奇处，难弟复难昆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣城倅馆","author":"吴山","text":"一年荒宿敬亭岚，世路如今亦颇谙。\n鸦带夕阳来舍北，雁传秋信到江南。\n王曾素志非温饱，毛义微名为旨甘。\n料得倚门凝望切，东风何日拥归骖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梵王宫","author":"吴山","text":"灵鳌戴出梵王宫，殿阁崔巍百世雄。\n额古泽心颁建武，地钟元气孕鸿濛。\n云连吴楚江山秀，水接沧溟海日红。\n我欲楞伽分半榻，汲泉煮茗话真空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吴山","text":"外列千区民庶巷，中藏万载帝王家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"吴己正","text":"举头不忍看王十，回首犹欣见李三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和承谏议","author":"吴中复","text":"瘴雾日消岚气静，飓风朝息海波闲。\n安期尝饵菖蒲在，马援应无薏苡还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋待月终夕阴晦偶书","author":"吴中复","text":"待月西楼上，平秋气象分。\n辉光唯此夜，遮掩奈浮云。\n红烛灯交烂，清香篆自薰。\n明年好景在，何处会多闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"众乐亭二首 其二","author":"吴中复","text":"烟波空阔岸低回，草绿花红处处堆。\n一片湖光分岛溆，四边山色入楼台。\n从前未有吾民乐，此地欣逢刺史来。\n目断鄞江何日到，京师只得画图开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"众乐亭二首 其一","author":"吴中复","text":"贤侯新葺水云乡，虚阁峥嵘绿渺茫。\n波面长桥步明月，人家疏影带残阳。\n风中白鸟侵烟去，雨后红蕖拥袖香。\n从此郡图添故事，岁时遗爱似甘棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江左谓海棠为川红","author":"吴中复","text":"靓妆浓淡蕊蒙茸，高下池台细细风。\n却恨韶华偏蜀土，更无颜色似川红。\n寻香只恐三春暮，把酒欣逢一笑同。\n子美诗才犹阁笔，至今寂寞锦城中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江渎泛舟","author":"吴中复","text":"晓来一雨过池塘，江渎祠前馆宇凉。\n翠水细风翻昼浪，红蕖微露浥秋香。\n欲停画舫收船楫，旋折圆荷当羽觞。\n逃暑岂须河朔饮，迟留车马到斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园十咏 其四 方物亭","author":"吴中复","text":"草木虫鱼部，披寻自古无。\n飞沉天产异，生植土风殊。\n物色随心匠，形容记绘图。\n虚亭玩真意，浩思满江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园十咏 其九 乔楠亭","author":"吴中复","text":"古木西园胜，亭延上客过。\n色无花卉妒，坚为雪霜多。\n干育千年秀，根含一气和。\n明堂求厚栋，可得老岩阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园十咏 其二 众熙亭","author":"吴中复","text":"亭枕方塘上，轩开四照新。\n花涵清露晓，风卷绿波春。\n日暖眠汀鹭，荷翻跃锦鳞。\n熙熙游宴地，行乐慰西人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园十咏 其三 竹洞","author":"吴中复","text":"阴森过百步，屈曲锁莓苔。\n翠色寒无改，清风时自来。\n叶笼苍玉干，路入碧云堆。\n吏散无公事，支筇到几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园十咏 其一 西楼","author":"吴中复","text":"信美他乡地，登临有故楼。\n清风破大暑，明月转高秋。\n朝暮岷山秀，东西锦水流。\n宾朋逢好景，把酒为迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园十咏 其六 圆通庵","author":"吴中复","text":"坐对圆通境，陶然胜静斋。\n观空无物我，扣寂外形骸。\n燕坐埋遗照，虚名莫疚怀。\n人间忧乐地，所丧甚山崖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园十咏 其八 流杯亭","author":"吴中复","text":"结客乘公暇，流觞逐浩歌。\n乱峰晴倒影，曲水宛回波。\n小海逢元巳，兰亭记永和。\n西州行乐事，应比晋贤多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园十咏 其七 琴坛","author":"吴中复","text":"潇洒琴坛上，贤侯养道情。\n无今亦无古，求意不求声。\n林邃风初静，云收月乍明。\n拂弦成一弄，尘思浩然清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园十咏 其十 锦亭","author":"吴中复","text":"帘幕临彫槛，窗疏照烂霞。\n园林初过雨，风日猛催花。\n香入游人袖，红堆刺史家。\n四时俱好景，终不似春华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园十咏 其五 翠柏亭","author":"吴中复","text":"众木坠黄叶，皴皮抱翠枝。\n自然根性在，不为雪霜移。\n灵润承多露，清阴贯四时。\n婆娑岁寒意，每到坐迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐山图","author":"吴中复","text":"当时齐映为州日，从此山因姓得名。\n却自牧之赋诗后，每逢秋至菊含情。\n行寻古洞诸峰峭，坐看寒溪数曲清。\n梦到亦须尘虑息，那堪图画入神京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闰春三月二日陪行之秘监游柏谷寺","author":"吴中复","text":"宝界嵚岑路入云，闰馀三月属芳辰。\n烟林未动阴森地，山杏寒开寂寞春。\n潞子岭头销白日，神农祠畔柅朱轮。\n乘闲自是逍遥事，谁羡襄阳倒载人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"览齐山寺陈鸿断碑","author":"吴中复","text":"翠琰何年沉朽壤，羡师寻访得其馀。\n应同湘水断碑字，难辨韩陵片石书。\n汨没身名真梦幻，变迁时月易丘墟。\n收藏且作山中物，莫问陈鸿记事初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"续和签判太博游海云","author":"吴中复","text":"海云摸石近东城，莽苍春郊去路平。\n绕寺溪光照金络，夹堤柳色混青旌。\n榴花新酿盈樽渌，玉柄高谈照座清。\n上客西州胜京口，给鲜牛炙旋供烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游海云寺唱和诗","author":"吴中复","text":"锦里风光胜别州，海云寺枕碧江头。\n连郊瑞麦青黄秀，绕路鸣泉深浅流。\n彩石池边成故事，茂林坡上忆前游。\n绿樽好伴衰翁醉，十月残春不少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游琴台墨池","author":"吴中复","text":"寻春景物乍晴暄，连月馀寒花未繁。\n犬子琴台馀古寺，扬雄墨沼但空园。\n池边宿草交加绿，林外鸣禽相斗喧。\n秀麦渐渐摇暖日，几重苍翠满郊原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋新繁周表权如诏亭","author":"吴中复","text":"君构义方亭，人知善教成。\n恩封新诰命，词合旧题名。\n承袭诗庭训，辉光里闬荣。\n如今綵衣养，蔼蔼振家声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢惠茶","author":"吴中复","text":"我闻蒙山之巅多秀岭，烟岩抱合五峰顶。\n岷峨气象压西垂，恶草不生生菽茗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"吴中复","text":"莫爱荔子红，岁作嘉州孽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"吴中复","text":"鲸鱼有浪春涛阔，铜鼓无声夜柝闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"吴中复","text":"前有牧之之风流，后有元之之篇咏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠胡彦忠","author":"吴丰","text":"古羊人物舜风馀，子姓传来祇旧庐。\n为爱一门能守义，相承五世不分居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送汪水云入湘","author":"吴仁杰","text":"碧水波翻海亦摧，奋身鳌背护蓬莱。\n忍随天上红云散，却驭关中紫气回。\n天道有常须变化，元关无钥任敲推。\n携琴更拜苍梧野，□想南薰入调来。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游虎丘山 其二","author":"吴从善","text":"两岸黄堆罢亚香，月波金泻乱波光。\n不驱风露归囊锦，安得新诗郁鬯凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游虎丘山 其一","author":"吴从善","text":"乐声随转阖闾城，樯杪无风水自平。\n不待尊前催画烛，落霞明月送船行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兄弟同登进士","author":"吴元","text":"勒马江边问玉京，百花头上占梅英。\n云霄万里开鹏路，诗乐三章奏鹿鸣。\n拂剑笑谈天下事，担簦慷慨日边行。\n吴公兄弟谁先后，此事君王合与评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凤凰台上忆吹箫 秋意","author":"吴元可","text":"更不成愁，何曾是醉，豆花雨后轻阴。\n似此心情自可，多了闲吟。\n秋在西楼西畔，秋较浅、不似情深。\n夜来月，为谁瘦小，尘镜羞临。\n弹筝，旧家伴侣，记雁啼秋水，下指成音。\n听未稳、当时自误，又况如今。\n那是柔肠易断，人间事、独此难禁。\n雕笼近，数声别似春禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"扬州慢 初秋","author":"吴元可","text":"露叶犹青，岩花迟动，幽幽未似秋阴。\n似梅风带溽，吹度长林。\n记当日、西廊共月，小屏轻扇，人语凉深。\n对清觞，醉笑醒颦，何似如今。\n临高欲赋，甚年来、渐减狂心。\n为谁倚多才，难凭易感，早付销沈。\n解事张郎风致，鲈鱼好、归听吴音。\n又夜阑闻笛，故人忽到幽襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"采桑子 春夜","author":"吴元可","text":"江南二月春深浅，芳草青时，燕子来迟。\n剪剪轻寒不满衣。\n清宵欲寐还无寐，顾影颦眉。\n整带心思。\n一样东风两样吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令","author":"吴元可","text":"浅约未曾来。\n一径苍苔。\n缃桃无数棘花开。\n怪得闭门机杼静，挑菜初回。\n幽树鸟声催。\n欲去徘徊。\n□□别久易相猜。\n幽绪一晴无处著，戏打青梅。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"濯缨石","author":"吴元美","text":"杖履叨从五马行，山翁醉舞乐升平。\n昨朝台上观垂钓，今夕江边伴濯缨。\n瘴水东流头半白，仙山南望眼双明。\n他时诵得使君句，绝似寒潭彻底清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"都峤山","author":"吴元美","text":"群峦环翠绣江隈，八叠中峰洞府开。\n剑戟香炉空际列，马鞍兜子上方排。\n烟笼丹灶鳌擎稳，云盖仙人鹤驾来。\n观此宝玄真胜境，何须航海觅蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李忠定公挽诗 其三","author":"吴冈","text":"才大时难合，言深道转艰。\n去朝吾不负，巧谮尔何颜。\n袖手功名外，忘怀水石间。\n苍生不知恨，犹望起东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李忠定公挽诗 其一","author":"吴冈","text":"梦卜庸真相，艰难倚大儒。\n英风起衰懦，直气慑奸谀。\n琳馆终高卧，燕然漫仕图。\n哀荣看赠典，犹是慰寰区。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李忠定公挽诗 其二","author":"吴冈","text":"胡骑围城日，诸生伏阙时。\n公方扶病起，人遂有生期。\n日者犹如此，天乎不憖遗。\n伤心原上路，烟淡鼓箫悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题清芬阁 其一","author":"吴升之","text":"先生曾此濯尘缨，七里寒滩分外清。\n少日决科虽失意，全家肥遁岂无成。\n蛟龙窟宅身如寄，泉石膏肓诗有声。\n虽与子陵同一律，不将丝线钓虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":42096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]