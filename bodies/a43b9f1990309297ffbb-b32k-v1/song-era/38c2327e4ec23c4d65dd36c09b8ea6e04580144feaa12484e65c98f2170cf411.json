[{"title":"上钦成皇后册宝六首 其三 盥洗用《嘉安》。","author":"郊庙朝会歌辞","text":"有炜柔仪，率履不越。\n惠于初终，既明且达。\n我将我享，相盥乃登。\n胡臭亶时，攸介攸宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上钦成皇后册宝六首 其二 迎神用《歆安》。","author":"郊庙朝会歌辞","text":"于显惟德，徽柔懿明。\n嫔于初载，有闻惟馨。\n肆我鼓钟，万舞在庭。\n神保是格，来止来宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上钦成皇后册宝六首 其一 入门、升殿用《显安》。","author":"郊庙朝会歌辞","text":"上帝锡羡，寔生婉淑。\n辅佐神皇，宠膺天禄。\n诞育泰陵，劬劳顾复。\n于昭徽音，久而弥郁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大中祥符封禅十首 其六 终献用《顺安》。","author":"郊庙朝会歌辞","text":"浩浩元精，无臭无声。\n临下有赫，得一以清。\n备物致享，荐兹至诚。\n泰尊奠献，夙夜齐明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大中祥符封禅十首 其十 太宗配坐酌献用《禅安》。","author":"郊庙朝会歌辞","text":"毖祀柔祇，报功厚载。\n思文太宗，侑神严配。\n钟石斯和，笾豆咸在。\n永锡坤珍，资生为大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大中祥符封禅十首 其三 太祖配坐酌献用《封安》。","author":"郊庙朝会歌辞","text":"于穆圣祖，肇开鸿业。\n我武惟扬，皇威有晔。\n四隩混同，百灵震叠。\n陟配高穹，明灵是接。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大中祥符封禅十首 其一 山上圜台降神用《高安》。","author":"郊庙朝会歌辞","text":"岩岩泰山，配德于天。\n奉符展采，翼翼乾乾。\n涤濯静嘉，罔有弗蠲。\n上帝顾諟，冷风肃然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大中祥符封禅十首 其八 皇地祇坐酌献用《禅安》。","author":"郊庙朝会歌辞","text":"坤德直方，博厚无疆。\n秉阴得一，静而有常。\n宝藏以发，乃育百昌。\n肃祗禅祭，锡祉穰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大中祥符封禅十首 其九 太祖配坐酌献用《禅安》。","author":"郊庙朝会歌辞","text":"皇矣圣祖，丕赫神武。\n秉运宅中，威加九土。\n德厚功崇，颂声载路。\n陟配方祗，对天之祜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大中祥符封禅十首 其四 太宗配坐酌献用《封安》。","author":"郊庙朝会歌辞","text":"祗若封祀，神宗配天。\n礼乐明备，奠献精虔。\n景灵来格，休祥蔼然。\n于昭垂庆，亿万斯年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大中祥符封禅十首 其五 亚献用《恭安》。","author":"郊庙朝会歌辞","text":"因高定位，礼修物备。\n荐鬯卜牲，虔恭寅畏。\n八音克谐，天神咸暨。\n降福穰穰，永锡尔类。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大中祥符封禅十首 其二 昊天上帝坐酌献用《奉安》。","author":"郊庙朝会歌辞","text":"皇天上帝，阴骘下民。\n道崇广覆，化洽鸿钧。\n灵文诞锡，宝命惟新。\n增高钦事，式奉严禋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大观三年朝献景灵宫二首 其二 奉馔用《吉安》。","author":"郊庙朝会歌辞","text":"尔牲既充，是烹是肆。\n尔肴既具，是羞是馈。\n非物之重，惟德之备。\n神之格思，歆我精意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"大观三年朝献景灵宫二首 其一 奉馔用《吉安》。","author":"郊庙朝会歌辞","text":"威灵洋洋，靡有常向。\n于惟钦承，来假来飨。\n博硕芬香，是烝是享。\n奉器有虔，载德无爽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太极观奉册宝一首 《登安之曲》。","author":"郊庙朝会歌辞","text":"荐号穹冥，登名祖祢。\n陟配阳郊，协宣典礼。\n感电灵区，诞圣鸿懿。\n册宝斯陈，福禄来暨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"开禧三年成肃皇后祔庙一首 酌献用《歆安》。","author":"郊庙朝会歌辞","text":"天合重华，内治昭融。\n承承继继，保佑恩隆。\n归从阜陵，登祔太宫。\n燕我后人，福禄来崇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 其三 降神用《太安》。六变。","author":"郊庙朝会歌辞","text":"龙车既奏，凤驭载翔。\n帝幄伫灵，天衢腾芳。\n神来留俞，神来蹇骧。\n礼鬯乐明，奏假孔将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 皇帝入门用《乾安》。","author":"郊庙朝会歌辞","text":"閟幄邃深，云景杳冥。\n天清日晬，展容玉庭。\n缔基发祥，希夷降灵。\n神其来燕，是飨是听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 文舞退、武舞进用《正安》。","author":"郊庙朝会歌辞","text":"持翟成象，秉朱就列。\n旄乘整溢，凤仪谐节。\n挥舒皇文，歌蹈先烈。\n合好效欢，福流有截。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 奉馔用《吉安》。","author":"郊庙朝会歌辞","text":"我簋斯盈，我簠斯实。\n或剥或烹，或燔或炙。\n有殽既将，为俎孔硕。\n礼仪卒度，永锡尔极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 诣圣祖位用《乾安》。","author":"郊庙朝会歌辞","text":"维宋肖德，钦天顾右。\n于皇道祖，丕釐灵祐。\n葛藟殖繁，瓜瓞孕茂。\n克昌厥后，世世孝奏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 其四 降神用《太安》。六变。","author":"郊庙朝会歌辞","text":"虹旌蜺旄，鸾旗翠盖。\n星枢扶轮，月御叶卫。\n灵至阴阴，灵般裔裔。\n来格来飨，福流万世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 皇帝还位用《乾安》。圣祖位奉玉币用《灵安》，高宗御制，见前。","author":"郊庙朝会歌辞","text":"桂宫耽耽，藻仪穆穆。\n天回衮彩，风韶璜玉。\n咸英皦亮，容典炳煜。\n假我上灵，景命有仆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 再诣圣祖位用《乾安》。","author":"郊庙朝会歌辞","text":"肇基骏命，巩右鸿业。\n鼎玉龟符，垂固万叶。\n灵贶具臻，神光烨烨。\n晖祚无疆，规重矩叠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 诣望燎位用《乾安》。","author":"郊庙朝会歌辞","text":"厥初生民，渊浚唯祖。\n芳荐既辍，明燎具举。\n德馨升闻，灵贶蕃诩。\n怀濡上灵，佑周之祜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 亚献用《冲安》。","author":"郊庙朝会歌辞","text":"光熉紫幄，神流玉房。\n秉文侑仪，嘉虞贰觞。\n震澹醉喜，彷佛迪尝。\n璇源之休，地久天长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 饮福酒用《报安》。","author":"郊庙朝会歌辞","text":"旨酒惟兰，勺浆惟椒。\n福流瓒斝，光烛琨瑶。\n拜贶清宫，凝辉庆霄。\n神其如在，徘徊招摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 盥洗用《乾安》。","author":"郊庙朝会歌辞","text":"礼文有俶，祀事孔明。\n将以洁告，允惟齐精。\n自盥而往，聿观厥成。\n灵监下临，天德其清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 其二 降神用《太安》。六变。","author":"郊庙朝会歌辞","text":"芬枝扬烈，熉珠叶陶。\n闿珍阐符，展诗舞箾。\n神哉来下，神哉来翱。\n肃若有承，灵心招摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 送真用《太安》。","author":"郊庙朝会歌辞","text":"云车风马，灵其来游。\n天门轶荡，神其莫留。\n遗庆阴阴，祉发祥流。\n康我有宋，与天匹休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 诣饮福位用《乾安》。","author":"郊庙朝会歌辞","text":"若木露英，清云流霞。\n蔓蔓芝秀，冯冯桂华。\n绵瑞无疆，产嘏孔奢。\n皇则受之，巩我帝家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 彻馔用《吉安》。","author":"郊庙朝会歌辞","text":"房铏陈列，室簋登奉。\n告飨具歆，展彻惟拱。\n祥光奕奕，嘉气懞懞。\n受嘏不愆，燕天之宠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 升殿用《乾安》。","author":"郊庙朝会歌辞","text":"帝居瑶图，璇题玉京。\n日月经振，列宿上荧。\n桂簋飶芬，瑚器华晶。\n夤承禋祀，用戒昭明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 还位用《乾安》。","author":"郊庙朝会歌辞","text":"烝哉我皇，继天毓圣。\n逆釐玄都，对越灵庆。\n如天斯久，如日斯盛。\n瑶图浚邈，永隆骏命。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 降殿用《乾安》。","author":"郊庙朝会歌辞","text":"璇庭烂景，紫殿流光。\n礼洽乾回，福应日昌。\n圣系厖鸿，景命溥将。\n德茂功成，率祀无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 再盥洗用《乾安》。","author":"郊庙朝会歌辞","text":"觞澹初勺，礼戒重盥。\n假庙以萃，取象于观。\n清明外畅，精肃中贯。\n我仪图之，三灵攸赞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 其一 降神用《太安》。六变。","author":"郊庙朝会歌辞","text":"四灵晨耀，五纬夕明。\n风云晏和，天地粹清。\n灵兮来迎，灵兮来宁。\n启我子孙，飨于纯精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 还大次用《乾安》。","author":"郊庙朝会歌辞","text":"王假有庙，对越在天。\n帷宫旋御，率礼不愆。\n泰畤展祠，云阳奉瑄。\n齐居精明，益用告虔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 降殿用《乾安》。","author":"郊庙朝会歌辞","text":"圣有谟训，诒谋燕翼。\n奉天酌祖，万世维则。\n维皇孝熙，乾乾夕惕。\n礼既式旋，惟福之锡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 送神用《兴安》。","author":"郊庙朝会歌辞","text":"珠幄熉黄，神既燕娭。\n监观于下，福禄来宜。\n云车风马，神保聿归。\n启佑我后，福禄来为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 彻豆用《丰安》。","author":"郊庙朝会歌辞","text":"升馔有章，卒食攸序。\n庭锵金奏，凯收铏筥。\n其献惟成，其馂维旅。\n礼洽庆流，皇祖之祜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 还位用《乾安》。","author":"郊庙朝会歌辞","text":"圣图广大，宗祊光辉。\n假于有庙，帝命不违。\n僾若有慕，夙夜畏威。\n嘉乐君子，福禄祁祁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 饮福用《乾安》。","author":"郊庙朝会歌辞","text":"玉瓒黄流，有飶其香。\n来假来享，降福穰穰。\n我应受之，汤孙之将。\n有百斯男，福禄无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 再升殿用《乾安》。","author":"郊庙朝会歌辞","text":"明明维后，诒厥孙谋。\n系隆我汉，陈锡哉周。\n以孝以飨，世德作求。\n介以繁祉，万邦咸休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 出小次用《乾安》。","author":"郊庙朝会歌辞","text":"庙楹邃严，夜景藻清。\n文物炳彪，礼仪熙成。\n帷宫载敞，佩珩有声。\n帝复对越，将受厥明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 终献用《正安》。","author":"郊庙朝会歌辞","text":"秉德翼翼，显相肃雍。\n疏幂三举，诚意益恭。\n光烛黼绣，和流笙镛。\n子孙众多，福禄来从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 亚献用《正安》。","author":"郊庙朝会歌辞","text":"尊斝星陈，罍幂云舒。\n来贰鸾觞，玉佩琼琚。\n相予严祀，秉德有初。\n对扬王休，何福不除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 文舞退、武舞进用《正安》。","author":"郊庙朝会歌辞","text":"明庭承神，鼗磬柷敔。\n玉梢饰歌，佾缀维旅。\n既肖厥文，复象乃武。\n祖德宗功，惟帝时举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 入小次用《乾安》。","author":"郊庙朝会歌辞","text":"皇容肃祗，天步舒迟。\n对越惟恭，敬事不遗。\n陟降莅止，永言孝思。\n上帝临女，日监于兹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 降殿用《乾安》。","author":"郊庙朝会歌辞","text":"黼幄蝉蜎，飙斿宁燕。\n尊彝献祼，瑚簋陈荐。\n视仪天旋，淳音韶变。\n遹求厥宁，福禄流羡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 光宗室用《大和》。","author":"郊庙朝会歌辞","text":"维宋洽熙，帝继于理。\n万姓厚生，三辰顺轨。\n对时天休，以燕翼子。\n肃唱和声，神其有喜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 孝宗室用《大伦》。","author":"郊庙朝会歌辞","text":"艺祖有孙，聪睿神武。\n绍兴受禅，归尊于父。\n行道袭爵，百度修举。\n圣德曰孝，光于千古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 高宗室用《大德》。","author":"郊庙朝会歌辞","text":"昊天有命，中兴复古。\n治定功成，修文偃武。\n德隆商宗，业闳汉祖。\n付托得人，系尧之绪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 钦宗室用《端庆》。","author":"郊庙朝会歌辞","text":"显显令主，辉光日新。\n奉亲以孝，绥下以仁。\n兢兢业业，诞保庶民。\n于穆不已，之德之纯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 徽宗室用《承元》。","author":"郊庙朝会歌辞","text":"帝抚熙运，晏粲协期。\n礼明乐备，文恬武嬉。\n道光授受，谋深燕诒。\n骏命不易，子孙保之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 哲宗室用《重光》。","author":"郊庙朝会歌辞","text":"于皇我宋，世有哲明。\n元祐用人，遹骏有声。\n绍述先志，思监于成。\n受天之祜，王配于京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 神宗室用《大明》。","author":"郊庙朝会歌辞","text":"厉精基治，大哉乾刚。\n信赏必罚，内修外攘。\n礼乐法理，号令文章。\n作新之功，度越百王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 英宗室用《治隆》。","author":"郊庙朝会歌辞","text":"明明英后，仁孝俭恭。\n丕显丕承，增光祖宗。\n继志述事，遵制扬功。\n万邦作孚，盛德形容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 仁宗室用《美成》。","author":"郊庙朝会歌辞","text":"在宋四世，天子圣神。\n用贤致治，约己裕民。\n海内富庶，裔夷肃宾。\n四十二年，尧舜之仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 真宗室用《熙文》。","author":"郊庙朝会歌辞","text":"天地熙泰，跻时升平。\n阐符建坛，声容文明。\n君臣赓载，夷夏肃清。\n本支百世，持盈守成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 再诣盥洗用《乾安》。","author":"郊庙朝会歌辞","text":"精粹象天，明清鉴月。\n再御兹盥，益致其洁。\n齐容颙若，诚意洞彻。\n百礼允洽，率礼不越。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 捧俎用《丰安》。","author":"郊庙朝会歌辞","text":"簋豆荐牲，铏笾实馈。\n其俎孔庶，吉蠲为饎。\n惟德达馨，以忱以贵。\n神既佑享，祉贶来暨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":57999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 其四 迎神用《兴安》。九变。","author":"郊庙朝会歌辞","text":"文以谟显，武以烈承。\n圣训之保，祖武之绳。\n有肃孝假，式严衎烝。\n神其来兮，以宜以宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 其三 迎神用《兴安》。九变。","author":"郊庙朝会歌辞","text":"穆穆紫幄，璜璜清宫。\n旱麓流咏，凫鹥叶工。\n道闳诒燕，业绵垂鸿。\n神其来兮，以康以崇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 其二 迎神用《兴安》。九变。","author":"郊庙朝会歌辞","text":"勾陈旦辟，阊阖夜分。\n轸风挟月，车驷凌云。\n瑞景晻霭，神光耀煴。\n神其来兮，以留以忻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宁宗朝享三十五首 其一 迎神用《兴安》。九变。","author":"郊庙朝会歌辞","text":"咸英备乐，簋席列斝。\n诗歌安世，声叶皇雅。\n翠旗羽盖，云车风马。\n神其来兮，以燕以下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":58003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]