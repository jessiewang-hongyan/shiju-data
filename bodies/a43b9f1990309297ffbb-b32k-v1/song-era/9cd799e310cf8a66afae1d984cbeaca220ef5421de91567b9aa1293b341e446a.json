[{"title":"和答元明黔南赠别","author":"黄庭坚","text":"万里相看忘逆旅，三声清泪落离觞。\n朝云往日攀天梦，夜雨何时对榻凉。\n急雪脊令相并影，惊风鸿雁不成行。\n归舟天际常回首，从此频书慰断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和答王世弼","author":"黄庭坚","text":"文章年少气如虹，肯爱闲曹一秃翁。\n弦上深知流水意，鼻端不怯运斤风。\n燕堂淡薄无歌舞，鲑菜清贫只韭葱。\n惭愧伯鸾留步履，好贤应与孟光同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和答刘太博携家游庐山见寄","author":"黄庭坚","text":"缓辔松阴不起尘，岚光经雨一番新。\n遥知数夜寻山宿，便是全家避世人。\n落日已迷烟际路，飞花还报洞中春。\n可怜不更寻源入，若见刘郎想问秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和答孙不愚见赠","author":"黄庭坚","text":"诗比淮南似小山，酒名曲米出云安。\n且凭诗酒勤春事，莫爱儿郎作好官。\n簿领侵寻台相笔，风埃蓬勃使星鞍。\n小臣才力堪为掾，敢学前人便挂冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和答张仲谟泛舟之诗","author":"黄庭坚","text":"云容天影水中摇，分坐船舷似小桥。\n联句敏于山吐月，举觞疾甚海吞潮。\n兴来活脔牛心熟，醉罢红炉鸭脚焦。\n公子翩翩得真意，马蹄尘里有嘉招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和答李子真读陶庾诗","author":"黄庭坚","text":"乐易陶彭泽，忧思庾义城。\n风流扫地尽，诗句识馀情。\n往者不再作，前贤畏后生。\n君言得意处，此意少人明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和答赵令同前韵","author":"黄庭坚","text":"人生政自无闲暇，忙里偷闲得几回。\n紫燕黄鹂驱日月，朱樱红杏落条枚。\n诗成稍觉嘉宾集，饮少先愁急板催。\n亲遣小童锄草径，鸣驺早晚出城来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和答郭监簿咏雪","author":"黄庭坚","text":"细学梅花落晚风，忽翻柳絮下春空。\n家贫无酒愿邻富，官冷有田知岁丰。\n夜听枕边飘屋瓦，梦成江上打船篷。\n觉来幽鸟语声乐，疑在白鸥寒苇中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和答登封王晦之登楼见寄","author":"黄庭坚","text":"县楼三十六峰寒，王粲登临独倚阑。\n清坐一番春雨歇，相思千里夕阳残。\n诗来嗟我不同醉，别后喜君能自宽。\n举目尽妨人作乐，几时归得钓鲵桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏伯时画太初所获大宛虎脊天马图","author":"黄庭坚","text":"笔端那有此，千里在胸中。\n四蹄雷电去，一顾马群空。\n谁能乘此物，超俗驾长风。\n逸材归辔勒，岁在执徐同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏雪奉呈广平公","author":"黄庭坚","text":"连空春雪明如洗，忽忆江清水见沙。\n夜听疏疏还密密，晓看整整复斜斜。\n风回共作婆娑舞，天巧能开顷刻花。\n正使尽情寒至骨，不妨桃李用年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜观蜀志","author":"黄庭坚","text":"盖世英雄不自知，暮年初志各参差。\n南阳陇底卧龙日，北固樽前失箸时。\n霸主三分割天下，宗臣十倍胜曹丕。\n寒炉夜发尘书读，似覆输筹一局棋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉送刘君昆仲","author":"黄庭坚","text":"游子归心日夜流，南陔香草可晨羞。\n平原晓雨半槐夏，汾上午风初麦秋。\n鸿雁要须翔集早，脊令无憾急难求。\n欲因行李传家信，姑射山前是晋州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉答圣思讲论语长句","author":"黄庭坚","text":"簿领文书千笔秃，公庭嚚讼百虫鸣。\n时从退食须臾顷，喜听邻家讽诵声。\n观海诸君知浩渺，学山他日看崇成。\n暮堂吏退张灯火，抱取鲁论来讲评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉答固道","author":"黄庭坚","text":"平生湖海鱼竿手，强学来操制锦刀。\n末俗相看终眼白，古人不见想山高。\n未乘春水归行李，傥得閒官去坐曹。\n自是无能欲乐尔，烦君错为叹贤劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宗室公寿挽词二首 其二","author":"黄庭坚","text":"昧旦鸣珂路，春朝禁殿班。\n方看分宝玉，何意作丘山。\n燕入风荣舞，花开日笑颜。\n空馀杜陵泪，一为汉中潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宗室公寿挽词二首 其一","author":"黄庭坚","text":"昔在熙宁日，葭莩接贵游。\n题诗奉先寺，横笛宝津楼。\n天网恢中夏，宾筵禁列侯。\n但闻刘子政，头白更清修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宜阳别元明用觞字韵","author":"黄庭坚","text":"霜须八十期同老，酌我仙人九酝觞。\n明月湾头松老大，永思堂下草荒凉。\n千林风雨莺求友，万里云天雁断行。\n别夜不眠听鼠齧，非关春茗搅枯肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"明叔惠示二颂云见七佛偈似有警觉乃是向道之端发于此故以二颂为报 其一","author":"黄庭坚","text":"山川围宴坐，日月转庭隅。\n般若寻常事，如来卧起俱。\n多闻成外道，只是守凡夫。\n欲听虚空教，须弥作鼓桴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"河舟晚饮呈陈说道","author":"黄庭坚","text":"西风脱叶静林柯，浅水扁舟阁半河。\n落日游鱼穿镜面，中秋明月涨金波。\n由来白发生无种，岂似青山保不磨。\n胜事只愁樽酒尽，莫言争奈醉人何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"范蜀公挽词二首 其二","author":"黄庭坚","text":"公在昭陵日，文章近赤墀。\n空嗟伏生老，不侍迩英帷。\n去国几三虎，闻韶待一夔。\n谁言盖棺了，新乐锁蛛丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"范蜀公挽词二首 其一","author":"黄庭坚","text":"信道虽常尔，知人乃独亨。\n书林身老大，谏纸字敧倾。\n鳌去三山动，人危五鼎烹。\n保全天子圣，几杖送馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"黄庭坚","text":"石磴层层鸟道斜，仙家楼阁锁烟霞。\n丹砂已化黄金鼎，玉洞犹开白鹤花。\n铁简有云神永护，金钟无韵鬼曾楂。\n洞天福地阴阳合，胜事留传岂浪誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨过至城西苏家","author":"黄庭坚","text":"飘然一雨洒青春，九陌净无车马尘。\n渐散紫烟笼帝阙，稍回晴日丽天津。\n花飞衣袖红香湿，柳拂鞍鞯绿色匀。\n管领风光唯痛饮，都城谁是得闲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"信中远来相访且致今岁新茗又枉任道寄佳篇复次韵呈信中兼简任道","author":"黄庭坚","text":"安坐一柱观，立遣十年劳。\n玄圭于我厚，千里来江皋。\n松风转蟹眼，乳花明兔毛。\n何如浮大白，一举醉陶陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南安试院无酒饮周道辅自赣上携一榼时时对酌惟恐尽试毕仆夫言尚有馀樽木芙蓉盛开戏呈道辅","author":"黄庭坚","text":"闻说君家好弟兄，穷乡相见眼俱青。\n偶同一饭论三益，颇为诸生醉六经。\n山邑已催乘传马，晓窗犹共读书萤。\n霜花留得红妆面，酌尽斋中竹叶瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"客自潭府来称明因寺僧作静照堂求予作","author":"黄庭坚","text":"客从潭府渡河梁，籍甚传誇静照堂。\n正苦穷年对尘土，坐令合眼梦湖湘。\n市门晓日鱼虾白，邻舍秋风橘柚黄。\n去马来舟争岁月，老僧元不下胡床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"弈棋二首呈任公渐 其一","author":"黄庭坚","text":"偶无公事负朝暄，三百枯棋共一樽。\n坐隐不知岩穴乐，手谈胜与俗人言。\n簿书堆积尘生案，车马淹留客在门。\n战胜将骄疑必败，果然终取敌兵翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"弈棋二首呈任公渐 其二","author":"黄庭坚","text":"偶无公事客休时，席上谈兵校两棋。\n心似蛛丝游碧落，身如蜩甲化枯枝。\n湘东一目诚甘死，天下中分尚可持。\n谁谓吾徒犹爱日，参横月落不曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思亲汝州作","author":"黄庭坚","text":"岁晚寒侵游子衣，拘留幕府报官移。\n五更归梦三百里，一日思亲十二时。\n车上吐茵元不逐，市中有虎竟成疑。\n秋毫得失关何事，总为平安书到迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"既作闵雨诗是夕遂澍雨夜中喜不能寐起作喜雨诗","author":"黄庭坚","text":"南风吹雨下田塍，田父伸眉愿力耕。\n麰麦明年应解好，帘栊今夜不胜清。\n直须洗尽焦枯意，不厌屡闻飘洒声。\n黄卷腐儒何所用，惟将歌咏报升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春祀分得叶公庙双凫观","author":"黄庭坚","text":"春将祠事出门扉，宫殿参差缭翠微。\n清晓风烟迷部曲，小蹊桃杏挂冠衣。\n叶公在昔真龙去，王令何时白鹤归。\n糟魄相传漫青史，独怀千古对容徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雪呈张仲谋","author":"黄庭坚","text":"暮雪霏霏若撒盐，须知千陇麦纤纤。\n梦阑半枕听飘瓦，晓起高堂看入帘。\n剩与月明分夜砌，即成春溜滴晴檐。\n万金一醉张公子，莫道街头酒价添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳闳展如子瞻甥也其才德甚美有意于学故以桃李不言下自成蹊八字作诗赠之 其四","author":"黄庭坚","text":"任世万钧重，载言以为轩。\n空文误来世，圣达欲无言。\n咸池浴日月，深宅养灵根。\n胸中浩然气，一家同化元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"癸亥立春日煮茗于石池寺见庚戌中盛二十舅中叔为县时题名叹此寺不日而成哀县学弊而不能复","author":"黄庭坚","text":"中叔风流映江左，当年桃李自光辉。\n看成佛屋上云雨，不忍学宫荒蕨薇。\n人物深藏青白眼，官联曾近赭黄衣。\n蛛丝柱后惠文暗，憔悴今乘别驾归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"神宗皇帝挽词三首 其二","author":"黄庭坚","text":"钓筑收贤辅，天人与圣能。\n辉光唐六典，度越汉中兴。\n百世神宗庙，千秋永裕陵。\n帝乡无马迹，空望白云乘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"神宗皇帝挽词三首 其三","author":"黄庭坚","text":"昔在基皇极，师臣论九畴。\n丘陵忽为谷，天地不藏舟。\n河洛功无憾，幽燕策未收。\n嗣皇朝万国，任姒正兴周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"神宗皇帝挽词三首 其一","author":"黄庭坚","text":"文思昭日月，神武用雷霆。\n制作深垂统，忧勤减梦龄。\n孙谋开二圣，末命对三灵。\n今代谁班马，能书汗简青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋思","author":"黄庭坚","text":"椎牛作社酒新篘，扶老将儿嬉陇头。\n木落人家见鸡犬，晓寒溪口在汀洲。\n无功可佩水苍玉，卒岁空思狐白裘。\n身到楚伧非屈宋，顾惭疏懒作悲秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"结客","author":"黄庭坚","text":"结客结英豪，肯同儿女曹。\n黄金妆佩剑，猛兽画旗旄。\n北极狼星落，中原王气高。\n终令贺兰贼，不著赭黄袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵令许载酒见过","author":"黄庭坚","text":"玉马何时破紫苔，南溪水满绿徘徊。\n买鱼斫鲙须论网，扑杏供盘不数枚。\n广汉威名知讼少，平原樽俎费诗催。\n草玄寂寂下帘幕，稍得闲时公合来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵令答诗约携山妓见访","author":"黄庭坚","text":"晴波鸂鶒漾潭隈，能使游人判不回。\n风入园林寒漠漠，日移宫殿影枚枚。\n未尝绿蚁何妨拨，宿戒红妆莫待催。\n缺月西南光景少，仍须挽取烛笼来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追和东坡壶中九华","author":"黄庭坚","text":"有人夜半持山去，顿觉浮岚暖翠空。\n试问安排华屋处，何如零落乱云中。\n能回赵璧人安在，已入南柯梦不通。\n赖有霜钟难席卷，袖椎来听响玲珑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追和东坡题李亮功归来图","author":"黄庭坚","text":"今人常恨古人少，今得见之谁谓无。\n欲学渊明归作赋，先烦摩诘画成图。\n小池已筑鱼千里，隙地仍栽芋百区。\n朝市山林俱有累，不居京洛不江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈氏女弟至石塘河","author":"黄庭坚","text":"富贵常多覆族忧，贱贫骨肉不相收。\n独乘舟去值花雨，寄得书来应麦秋。\n行李淮山三四驿，风波春水一双鸥。\n人言离别愁难遣，今日真成始欲愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐隐父宰馀干二首 其二","author":"黄庭坚","text":"天上麒麟来下瑞，江南橘柚间生贤。\n玉台书在犹骚雅，孺子亭荒只草烟。\n半世功名初墨绶，同兄文字直青钱。\n割鸡不合庖丁手，家传风流更著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐隐父宰馀干二首 其一","author":"黄庭坚","text":"地方百里身南面，翻手冷霜覆手炎。\n赘婿得牛庭少讼，长官斋马吏争廉。\n邑中丞掾阴桃李，案上文书略米盐。\n治状要须闻岂弟，此行端为霁威严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐景道尉武宁二首 其二","author":"黄庭坚","text":"黄绶补一尉，还依水竹居。\n身随南渡马，书寄北来鱼。\n风俗谙邻并，艰难试事初。\n官閒莫歌舞，教子诵诗书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐景道尉武宁二首 其一","author":"黄庭坚","text":"李苦少人摘，酒醇无巷深。\n当官莫避事，为吏要清心。\n葛藟松千尺，寒泉绠百寻。\n公朝有汲引，吾子茂徽音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送莫郎中致仕归湖州","author":"黄庭坚","text":"霅上多高士，君今又乞身。\n中年谢事客，白日上升人。\n静泛苕溪月，閒尝顾渚春。\n滔滔夜行者，能不愧清尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送顾子敦赴河东三首 其三","author":"黄庭坚","text":"揽辔都城风露秋，行台无妾护衣篝。\n虎头妙墨能频寄，马乳蒲萄不待求。\n上党地寒应强饮，两河民病要分忧。\n犹闻昔在军兴日，一马人间费十牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送顾子敦赴河东三首 其二","author":"黄庭坚","text":"家在江东不系怀，爱民忧国有从来。\n月斜汾沁催驿马，雪暗岢岚传酒杯。\n塞上金汤惟粟粒，胸中水镜是人材。\n遥知更解青牛句，一寸功名心已灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送顾子敦赴河东三首 其一","author":"黄庭坚","text":"头白书林二十年，印章今领晋山川。\n紫参可掘宜包贡，青铁无多莫铸钱。\n劝课农桑诚有道，折冲樽俎不临边。\n要知使者功多少，看取春郊处处田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送高士敦赴成都钤辖二首 其二","author":"黄庭坚","text":"捧日高宣事，东京四姓侯。\n军中闻俎豆，庙胜脱兜鍪。\n烧烛海棠夜，香衣药市秋。\n君平识行李，河汉接天流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送高士敦赴成都钤辖二首 其一","author":"黄庭坚","text":"玉钤金印临参井，控蜀通秦四十州。\n日下书来望鸿雁，江头花发醉貔貅。\n巴滇有马驹空老，林箐无人叶自秋。\n能为将军歌此曲，鸣机割锦与缠头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送曹黔南口号","author":"黄庭坚","text":"摩围山色醉今朝，试问归程指斗杓。\n荔子阴成棠棣爱，竹枝歌是去思谣。\n阳关一曲悲红袖，巫峡千波怨画桡。\n归去天心承雨露，双鱼来报旧宾僚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送彭南阳","author":"黄庭坚","text":"南阳令尹振华镳，三月春风困柳条。\n携手河梁愁欲别，离魂芳草不胜招。\n壶觞调笑平民讼，宾客风流醉舞腰。\n若见贤如武侯者，为言来仕圣明朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送舅氏野夫之宣城二首 其二","author":"黄庭坚","text":"试说宣城郡，停杯且细听。\n晚楼明宛水，春骑簇昭亭。\n䆉稏丰圩户，桁杨卧讼庭。\n谢公歌舞处，时对换鹅经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送舅氏野夫之宣城二首 其一","author":"黄庭坚","text":"藉甚宣城郡，风流数贡毛。\n霜林收鸭脚，春网荐琴高。\n共理须良守，今年辍省曹。\n平生割鸡手，聊试发硎刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"食瓜有感","author":"黄庭坚","text":"暑轩无物洗烦蒸，百果凡材得我憎。\n藓井筠笼浸苍玉，金盘碧箸荐寒冰。\n田中谁问不纳履，坐上适来何处蝇。\n此理一杯分付与，我思明哲在东陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徐孺子祠堂","author":"黄庭坚","text":"乔木幽人三亩宅，生刍一束向谁论。\n藤萝得意干云日，箫鼓何心进酒樽。\n白屋可能无孺子，黄堂不是欠陈蕃。\n古人冷淡今人笑，湖水年年到旧痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起次韵和稚川进叔倡酬之什","author":"黄庭坚","text":"池塘夜雨听鸣蛙，老境侵寻每忆家。\n白发生来惊客鬓，黄粱炊熟又春华。\n百年不负胶投漆，万事相依葛与瓜。\n胜日主人如有酒，犹堪扶病见莺花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"罢姑熟寄元明用觞字韵","author":"黄庭坚","text":"追随富贵劳牵尾，准拟田园略滥觞。\n本与江鸥成保社，聊随海燕度炎凉。\n未栽姑熟桃李径，却入江西鸿雁行。\n别后常同千里月，书来莫寄九回肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袁州刘司法亦和予摩字诗因次韵寄之","author":"黄庭坚","text":"袁州司法多兼局，日暮归来印几窠。\n诗罢春风荣草木，书成快剑斩蛟鼍。\n遥知吏隐清如此，应问卿曹果是何。\n颇忆病馀居士否，在家无意饮萝摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":72351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]