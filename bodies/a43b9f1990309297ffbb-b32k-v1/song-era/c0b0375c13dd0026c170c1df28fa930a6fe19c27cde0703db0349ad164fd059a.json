[{"title":"分司卒至富池","author":"董嗣杲","text":"疲兵喜离九江城，且报新篁长数茎。\n未问主人先问竹，要分吟屋听秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4545,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天池晚眺二首 其二","author":"董嗣杲","text":"天灯逢夜涉江危，直绕文殊阁上飞。\n暗里试将衫袖裹，祇馀树叶几星归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4546,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天池晚眺二首 其一","author":"董嗣杲","text":"古塔寒擎夕照红，泉声涌海入虚空。\n分明九十九峰翠，都在天池窗眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4547,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王倅寄弟富池酒边述兴","author":"董嗣杲","text":"竹亭难障隔淮尘，补种疏花几树春。\n若忆六龙南渡日，到今我亦是流民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4548,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乍热","author":"董嗣杲","text":"树禽苦叫不如归，午睡醒时已落晖。\n新暑渐回身尚客，此无黄葛可裁衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4549,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"厉屏山祠","author":"董嗣杲","text":"漪岚堂北县楼东，香火新标旧令功。\n此地岂知钟鼓乐，月明如水藕池空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4550,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"生意堂三首 其三","author":"董嗣杲","text":"絮花挼雪小桥寒，浑是苏堤柳下看。\n愁去不知春袖湿，晚风吹雨入阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4551,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"生意堂三首 其二","author":"董嗣杲","text":"江天饶雾未能开，閒拉孤筇睨九垓。\n红日破阴晴色转，庐山如洗入堂来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4552,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"生意堂三首 其一","author":"董嗣杲","text":"画堂清傍水南桥，烟气如炊掩紫霄。\n十二阑干成独倚，橹声风隔大江遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4553,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自庐山归城赋四首 其四","author":"董嗣杲","text":"重葺芒鞋约更坚，山家意味况相便。\n须先折简同游客，剥藓题名就石镌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4554,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自庐山归城赋四首 其三","author":"董嗣杲","text":"入城回睇万松横，祇隔浮云几万层。\n八月秋风明月下，天池池上看天灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4555,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自庐山归城赋四首 其二","author":"董嗣杲","text":"才去还回似不情，萧然两耳乱泉声。\n衣巾染得江岚透，谁道山人骨亦清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4556,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自庐山归城赋四首 其一","author":"董嗣杲","text":"绝壑松风泻瀑声，此身如寄画图清。\n馀生结得东林社，三笑亭前看月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4557,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"记仙女三绝 其三","author":"董嗣杲","text":"屈曲阑干月半规，藕花香淡水漪漪。\n分明一夜文姬梦，只有青团扇子知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4558,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"记仙女三绝 其二","author":"董嗣杲","text":"松影侵坛琳观静，桃花流水石桥寒。\n东风吹过双蝴蝶，人倚危楼第几阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4559,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"记仙女三绝 其一","author":"董嗣杲","text":"柳条金嫩不胜鸦，青粉墙边道蕴家。\n燕子不来春寂寞，小窗和雨梦梨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4560,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再逢黄山矶上老叟","author":"董嗣杲","text":"过此未几还问归，归时又眺黄山矶。\n不如矶上钓鱼父，雪霁扶藜行夕晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4561,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上晚眺 其一","author":"董嗣杲","text":"江北西风高，江南新酒熟。\n长笛吹梅花，月色满营屋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4562,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上晚眺 其二","author":"董嗣杲","text":"得酒终日醉，都忘醒后愁。\n往来狂走马，直过皖山头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4563,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟上望九华山","author":"董嗣杲","text":"雪残半积阳山矶，大江云涌涛头飞。\n九峰不受夕晖掩，杜牧一亭空翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4564,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西兴道中二首 其一","author":"董嗣杲","text":"无马可租冲晓去，有筇堪策趁晴行。\n初程便是萧山县，喷火榴花两岸明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4565,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过梅根港","author":"董嗣杲","text":"雨压云低雪气浑，风帆未午过梅根。\n港头惊见官舟泊，野老争先掩荻门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4566,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过彭蠡口","author":"董嗣杲","text":"云凝入港大孤山，芦荻翻风秋夕寒。\n水急乱从彭蠡出，来舟不似去舟难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"估客谣二首 其二","author":"董嗣杲","text":"溺利谁知轻，性流甚于水。\n东去复西回，难将逝水比。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"估客谣二首 其一","author":"董嗣杲","text":"浪儿重规利，半世家如寄。\n千金得美人，长向船窗醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冷翠谷口占 其一","author":"董嗣杲","text":"乱山蔽天尽，丛涧绕山流。\n茅屋冷欲压，今日方中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冷翠谷口占 其四","author":"董嗣杲","text":"苍童负诗箧，百钱挂杖头。\n何当倩画手，画我庐山游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初八日立壬戌春","author":"董嗣杲","text":"腊尽春犹客，春来病转多。\n孤樽洗块礧，万事付无何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈石泉送芍药花","author":"董嗣杲","text":"花分近侍了春残，分付荼蘼糁雪寒。\n天色转阴阴转雨，愁人可凭柳边阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐东林寺","author":"董嗣杲","text":"晚云敛尽鹤声迟，万木号空夜景移。\n三笑亭前山月上，却如身在冷泉时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜宴赠筝妓","author":"董嗣杲","text":"方响琵琶借当家，十三弦上雁行斜。\n雨筵合出残春曲，愁扫屏风满地花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊曹家沙 其一","author":"董嗣杲","text":"雪覆芦花障远郊，小舟不待起风抛。\n沙头只有三家住，烂草檐头两把茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊曹家沙 其二","author":"董嗣杲","text":"行沙回望岸南头，叠叠层层雪积稠。\n民社一同犹是寄，故应羁迹此生浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陌上二首 其二","author":"董嗣杲","text":"恨鹃啼桑颠，丑妇泪如洗。\n手中捻银丝，阶头博红米。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陌上二首 其一","author":"董嗣杲","text":"水花粘稚蛙，野菜恋残蝶。\n麦岐苦薄收，青黄两不接。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客中怀西湖二首 其二","author":"董嗣杲","text":"閒多便可赋诗健，客少应能减酒豪。\n风雨六桥入图画，此身可并南山高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客中怀西湖二首 其一","author":"董嗣杲","text":"一日无诗气还浊，百年有限身更孱。\n西湖多少好风月，何时买屋安萧閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春去喜无怨乌二首 其二","author":"董嗣杲","text":"失笑羁人泥听禽，年年春老益愁心。\n江城树少无栖处，堕落千岩万壑深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春去喜无怨乌二首 其一","author":"董嗣杲","text":"春尽江头望几回，支持愁态入衔杯。\n要归便问西门渡，行止何关杜宇催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春步岳园二首 其二","author":"董嗣杲","text":"将军墓域在杭州，如此家园入梦游。\n谁惜再传无嗣续，至今匙钥属官收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春步岳园二首 其一","author":"董嗣杲","text":"暖风晴日艳芳天，独客心情不忍言。\n何处有花春掠眼，金陀坊里岳家园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夜","author":"董嗣杲","text":"秋堂初霁短檠凉，堂外风帘减旧香。\n萤火正流孤溆燄，閒来坐觉二更长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻笛 其一","author":"董嗣杲","text":"四海水尚浅，孤城愁更深。\n船上何人笛，吹入芦花林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻笛 其二","author":"董嗣杲","text":"吹腔不识愁，愁耳偏闻吹。\n月明吹更苦，泪洒降羌儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻笛","author":"董嗣杲","text":"凄凄吹笛裂寒云，羁客难禁醒坐闻。\n声逐逝波流不断，月明吹老戍回军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病起怀归","author":"董嗣杲","text":"绝饮还知百脉清，病夫明日值阳生。\n治装肯发迟疑口，要趁江寒水色平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"逢曹子敬知录三首 其三","author":"董嗣杲","text":"屏气安时彼此同，此时虹燄已销空。\n东君造化搀春早，看取花开自在红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"逢曹子敬知录三首 其二","author":"董嗣杲","text":"州县间关老调官，青衫敝尽只儒酸。\n玉堂学士思求代，珍重春风在笔端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"逢曹子敬知录三首 其一","author":"董嗣杲","text":"相逢愁醉霅溪西，老却陈思七步诗。\n二十年前亲擢第，孤忠曾际穆陵知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿九江驿","author":"董嗣杲","text":"孤灯花烬糁窑台，古驿凉扉傍月开。\n数事支持愁外去，十年憔悴梦中来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿清虚庵二首 其二","author":"董嗣杲","text":"来此看云骨欲仙，竹窗秋雾蓊炉烟。\n西风正满溪头树，直送寒声到枕前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿清虚庵二首 其一","author":"董嗣杲","text":"拨云峰下拨云亭，万竹凝秋列画屏。\n皇甫真人遗业在，满林寒叶佛灯青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄江城口占 其二","author":"董嗣杲","text":"蹉跎岁事空，次第春风起。\n雪消夕阳平，彻底清江水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄江城口占 其一","author":"董嗣杲","text":"梦魂荡孤舟，波声塞两耳。\n不眠闻管弦，方悟江城里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄庐山道士二首 其二","author":"董嗣杲","text":"常常有约寻幽趣，汨汨无从避俗喧。\n欲断世间千万事，须穷纸上五千言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄庐山道士二首 其一","author":"董嗣杲","text":"才怀故里馀清梦，方说庐山得好诗。\n何日与师传菊酒，剧谈浩劫未分时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晚泊烽火矶","author":"董嗣杲","text":"野阴远阁雪风乾，向暮维舟水色寒。\n火号荧荧今夜烛，因知江北报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野望","author":"董嗣杲","text":"过午浮阴掩石台，疾风掠草散狂埃。\n江豚吹皱空江浪，远见淮云捲雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食日偶出","author":"董嗣杲","text":"漪岚堂下野芳晴，杨柳枝头歇雨声。\n笑逐游人城外去，沙洲沽酒做清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"落梧","author":"董嗣杲","text":"梧叶几片飞，三日西风急。\n新月冷银床，床下孤螀泣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪村晚步即事二首 其二","author":"董嗣杲","text":"小策盘旋草舍东，东西拾穗走儿童。\n村家间有秋收处，愁语酣歌自不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溪村晚步即事二首 其一","author":"董嗣杲","text":"溪岚攒翳入窗空，最恼悲秋病疟翁。\n三日不行亭北路，谁将丹缬染乔枫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠莲花洞僧二首 其二","author":"董嗣杲","text":"老僧眉毛霜争妍，重补袈裟防雪天。\n閒看青山忙看水，庵门不掩今几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠莲花洞僧二首 其一","author":"董嗣杲","text":"山枯叶落晴纷纷，莲花洞前流水分。\n流水自送夕阳去，洞上白猿啼白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日留彭泽","author":"董嗣杲","text":"牢系扁舟在树根，依然风物晋时村。\n几年思采东篱菊，此际狂倾北海樽。\n野鹤离群翔碧落，江鸿排字入黄昏。\n有人若学渊明隐，五柳萧疏静掩门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九江易帅遂得尽游郡斋","author":"董嗣杲","text":"郡吏东征迓衮衣，不知郡圃掩芳扉。\n樱桃熟处香山识，杨柳栽时靖节归。\n壁帖嵌尘钟鼎碎，楼歌压市管弦飞。\n庐山面目清如此，几客登临几夕晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九里松","author":"董嗣杲","text":"开元刺史擅清风，九里亲栽夹道松。\n屋顶自生涛浪势，根头谁觅茯苓踪。\n行春桥掩云千态，一字门封翠几重。\n人讶金填吴说笔，不知此笔遇高宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入东林寺","author":"董嗣杲","text":"晴向过溪亭下留，拂碑慨想晋时流。\n云生古树茑萝雨，风捲脩廊松竹秋。\n登阁冷知山扑面，照池凉觉水澄眸。\n捻香礼遍远公墓，僧舍乞茶谈赵州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入庐山","author":"董嗣杲","text":"断陇横溪出酒旗，乘疲小憩晚阴时。\n幽林合翠痕痕净，远瀑飞琼派派奇。\n水迥起风传鹳垤，村荒入夕见鸡埘。\n竹间谁拂农家壁，觅写如今夜醉诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入庐山感兴","author":"董嗣杲","text":"古翠深中拥紫烟，幽行先酌石溪泉。\n未能耕野安愚分，且乐游山趁壮年。\n五色在前难障碍，连镳来此可留连。\n杏花林里閒风月，况有宗人演地仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入贵池逢张秀夫","author":"董嗣杲","text":"风姿欣邂逅，彼此略寒暄。\n为客那知老，相看不忍言。\n湖鱼朝上市，驿鼠夜穿垣。\n共尔添贫病，攒眉说故园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又憩西林寺有乘马人来同宿","author":"董嗣杲","text":"孤凭水阁坐斜曛，七级浮屠压暝氛。\n慧永祠空依晋树，率更碑古宿唐云。\n自听远鹤情偏逸，谁策羸骖趣不群。\n同向西林卸行橐，溪风摵摵叶纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"万年枝花","author":"董嗣杲","text":"此种何奇等寿椿，吹香时借好风频。\n细花当暑飞黄玉，密叶屯阴侍紫宸。\n深樾暗埋巢鹊乳，纤蕤乱缀网蛛尘。\n岁赛重结青青子，培拥皇基不老春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三贤祠","author":"董嗣杲","text":"东坡政绩踵香山，梅下韬光独养閒。\n一样清风无异代，三公遗像有生颜。\n竹亭画鹤衔芝老，石鼎蟠蛛炷柏悭。\n摘取吟联分扁隶，英游时驾碧云还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大佛头","author":"董嗣杲","text":"不是金涂丈六仙，庄严法界想西天。\n自因僧净镌空像，谁说秦皇缆海船。\n全体未知何日现，半生且坐此山禅。\n石头照水无尘土，饱听钟声杂管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大笑花","author":"董嗣杲","text":"种出海南谁为誇，嫣然无语送韶华。\n何人何事入彼粲，倾国倾城非比花。\n羞靥倚风遗素脸，烂香浥露逼青瓜。\n开时气味起憎妒，牢掩篱门蚕妇家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小步晚兴","author":"董嗣杲","text":"板桥孤渡险，草屋四檐穿。\n远客感新月，短髭伤壮年。\n水篱微雪冱，天宇列星悬。\n无地寻朋好，归情托七弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]