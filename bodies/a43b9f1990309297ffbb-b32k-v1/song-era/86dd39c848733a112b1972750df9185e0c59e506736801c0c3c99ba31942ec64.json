[{"title":"禅人写师真请赞 其九","author":"释慧远","text":"按轮王剑，全生杀机。\n豁开正眼，当头者谁。\n从来无忌讳，底事没商量。\n赵州密意凭谁诉，铁作心肝也断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其十三","author":"释慧远","text":"透过荆棘林，瞎却醯罗眼。\n拈起破砂盆，放下漏灯盏。\n独有周书记，全机识得渠。\n好笑云黄傅大士，也曾赤脚礼文殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其十九","author":"释慧远","text":"列列挈挈，硗硗聱聱。\n廓然无圣，平地吃交。\n鼻孔生三窍，眉毛只一般。\n奇哉王道士，头戴桦皮冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其五","author":"释慧远","text":"断灭佛种，破除家计。\n不是别人，杨岐五世。\n禅道耳边风，佛法眼中翳。\n问渠将底为人，尚有随身赤契。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其二十","author":"释慧远","text":"面目可憎，语言无味。\n放箸忘恩，停杯断义。\n参得些儿小玉禅，几回卖弄帝王前。\n圆悟室中遭毒手，为人挥起迸心拳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其二十九","author":"释慧远","text":"入魔王队，住邪见林。\n修菩萨行，现夜叉心。\n舌头拖地有谁识，鼻孔辽天无处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其三","author":"释慧远","text":"画也错，赞也错。\n不识蚬子笊篱，唤作普化木铎。\n而今要且头不是头，脚不是脚。\n恐人无信，立此为约。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其二十三","author":"释慧远","text":"幸自十分，画出一半。\n我便是渠，略无思算。\n无思算处妙难传，忿怒那吒吃痛拳。\n道不是道，禅不是禅。\n星驰电掣，汉语胡言。\n蓦地揭起脑盖，依前舌拄梵天。\n咄，是甚么面目，可怜只有些儿栗棘金圈，尽底分付常山林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其一","author":"释慧远","text":"早依圜悟，晚住林泉。\n无门雪屈，遍界声冤。\n对天子廓摩醯首罗眼，提杨岐金圈栗棘蓬禅。\n神仙秘诀，父子不传。\n平地放开缚虎手，等闲迸出拦胸拳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其三十","author":"释慧远","text":"大道廓然，真空泯迹。\n金里淘砂，玉中辨石。\n衲僧用处脱罗笼，熨斗煎茶铫不同。\n一声师子吼，遍界绝狐踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其八","author":"释慧远","text":"把定放开全在你，和泥合水更由谁。\n大地簇成三事衲，虚空迸出两条眉。\n绝忌讳，猛提撕。\n惊回春梦破，倒跨铁牛归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其二十六","author":"释慧远","text":"普證作此像，是相故非真。\n虚空无背面，露柱倒生根。\n傍提正按低叉手，独掇单提高打躬。\n佛魔削迹，凡圣泯踪。\n雨过云山空漠漠，日高花影乱重重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其二十一","author":"释慧远","text":"飘飘萧萧松百赤，突突兀兀云半肩。\n放□□□□□调，刚被时人唤作禅。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其二十五","author":"释慧远","text":"住飞来峰，饮冷泉水。\n倒用逆施，拈头作尾。\n十字街头击鼓，五天印土吃茶。\n南北东西若稻麻。\n钁头些子意，验尽当行家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其十五","author":"释慧远","text":"匝地普天，银山铁壁。\n正令全提，虚空削迹。\n月眉横，照用分，星流电掣透龙门。\n向道瞎驴无忌讳，脚尖趯出旧乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其二","author":"释慧远","text":"独步邪见林，高据魔王殿。\n说欺凡罔圣禅，现夜叉罗刹面。\n掀翻巨岳，彻底放憨。\n打破牢关，突出难辨。\n阿呵呵，见也么。\n到江吴地尽，隔岸越山多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其十","author":"释慧远","text":"冷笑德山，热谩临济。\n头重尾轻，碗鸣?沸。\n明侍者，透天机，八十翁翁巧画眉。\n掀翻师子窟，倒跨瞎驴儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其四","author":"释慧远","text":"开荆棘林，塞人天路。\n把断纲宗，阔行大步。\n风高云静月眉横，直向金轮水际行。\n到家无剩地，日出事还生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其三十一","author":"释慧远","text":"到处说禅说道，为人入水入泥。\n半生出来住院，一□断送头皮。\n赞也得，毁也得，临济便是白拈贼。\n贼贼，也只当甚乾罗卜。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其六","author":"释慧远","text":"大地一浑身，虚空绝四邻。\n不识柏树子，唤作麻三斤。\n好时十分潇洒，恶时一味藞苴。\n等闲牵犁上佛殿，乘兴钵盂里走马。\n平地撒屎撒尿，知佗是真是假。\n禅人描邈将来，大虫头上火把。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其十四","author":"释慧远","text":"靠倒云门抽顾鉴，挨开临济主宾禅。\n一星猊血化驴乳，半点鸾胶续断弦。\n淳侍者，脱机缘。\n波斯拾得招文袋，月里麒麟笑揭天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其二十四","author":"释慧远","text":"倒数一二三，翻成四五六。\n蹋断独木桥，唱起云门曲。\n急似箭，直如弦。\n列祖不知何处去，瞎驴依旧痛加鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其十六","author":"释慧远","text":"不参鼻祖禅，不使冬瓜印。\n倒拈定命索，单提不犯令。\n天堂地狱莫能收，佛界魔宫任意游。\n因寻清水闸，误入赤城州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其十一","author":"释慧远","text":"风高云澹，露冷烟清。\n坐松下石，听松上声。\n闻知见觉没干涉，暑往寒来无处雪。\n八臂那吒䫌面看，七星利剑和声截。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其十八","author":"释慧远","text":"横按拄杖，坐盘陀石。\n鼻孔辽天，眼睛突出。\n澹烟笼古树，缺月挂藤萝。\n分付俊禅者，勘破老头陀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其二十二","author":"释慧远","text":"松形鹤骨底村僧，鬼妒人嫌我亦憎。\n悬羊卖狗随时遣，栗棘金圈任跳吞。\n忽然拶著东弗于逮，骑驴吃扑。\n蓦地拓开北郁单越，海涌波腾。\n淮山两踞，拨火求冰。\n问渠西祖之道，何曾□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其十二","author":"释慧远","text":"画出不堪，弃智杂毒。\n赞之不是，厌身桎梏。\n一十三处坐道场，二时粥饭何曾足。\n日里夜行，投明暗宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写师真请赞 其十七","author":"释慧远","text":"虽有两条眉，不识一个字。\n露柱未怀胎，面目却相似。\n说心说性，来与三斤麻。\n撒屎撒尿，演出一大事。\n阿呵呵，见也么？\n江南生皂树，江北出天萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答曾侍郎","author":"释慧远","text":"辉天绰地金刚眼，再锻重烹铁蒺藜。\n脱体顿抛无朕迹，瞎驴从此丧全机。\n当阳活脱向上路，收放应须阔著步。\n印泥印水目前观，日面月面没回互。\n脱笼掣辔绝名模，棒喝交驰得也无。\n不落化门成底事，紫罗帐里撒真珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"释迦出山相赞","author":"释慧远","text":"大哉释迦文，福聚海无量。\n此地少朱砂，赤土以为上。\n我今稽首礼赞扬，留与人天作榜样。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"楞严六根 其四 异舌知味","author":"释慧远","text":"憍梵钵提知此味，苦涩咸酸那里是。\n一举如能至梵天，超證如来真实义。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"楞严六根 其六 意根了知","author":"释慧远","text":"金色头蛇意根灭，圆明了知无处雪。\n草鞋跟断眼皮横，善财拄杖生三节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瞎堂三句 其一","author":"释慧远","text":"我有不入驴耳句，日盈月昃未容呈。\n出门会得天平错，未出门先举向君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瞎堂三句 其四","author":"释慧远","text":"瞎堂一句分三句，纯钢打就生铁铸。\n半夜乌龟脱壳飞，星罗云散无寻处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题墨竹","author":"释慧远","text":"通乎笔端之有神，妙乎造化之有功。\n戏苍龙之引尾，背皓月而摇风。\n疏影无声乱寒墨，瘦枝有叶翻秋空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠演说人","author":"释慧远","text":"西湖演士妙天机，舌转风雷口角飞。\n夺骑未闻沙塞冷，斩关先觉阵云低。\n前贤后圣从君数，水远山长我自知。\n皓首不须寻旧隐，到头谁是复谁非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十五首 其六","author":"释慧远","text":"三唤三应，更饶贴称。\n月逗寒窗，水归巨浸。\n负汝负吾，全锋敌胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十五首 其五","author":"释慧远","text":"电捲星飞，珠回玉转。\n打破面皮，赤心片片。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其八","author":"释慧远","text":"拗折秤锤，掀翻露布。\n突出机先，鸦飞不度。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其三","author":"释慧远","text":"天道亏盈，地道变盈。\n鬼神害盈，人道恶盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十八","author":"释慧远","text":"一心不生，万法无咎。\n木匠带枷，自作自受。\n有心无法，受报好丑。\n有法无心，天长地久。\n心生法生，乌飞兔走。\n心灭法灭，倒翻筋斗。\n口似鼓椎，眉如扫帚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十八","author":"释慧远","text":"徐六担板，我则不然。\n初三十一，不用择日。\n鼻孔剔穿，眼睛突出。\n撞著露柱，参学事毕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十六","author":"释慧远","text":"长连床上，北俱卢洲。\n吃粥吃饭，遍界冤雠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十五","author":"释慧远","text":"初二十六，齑羹豆粥。\n日午夜行，投明暗宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十三","author":"释慧远","text":"古圣伽蓝，一切成见。\n未跨三门，先见佛殿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十八","author":"释慧远","text":"春日迟迟，春风浩浩。\n绿水绕腰，青山戴帽。\n柳绿花红，鸦鸣鹊噪。\n大施门开，何处著到。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨祖师赞","author":"释慧远","text":"不是梁皇勘过，肯来少室冷坐。\n累佗二祖失心，被人唤作达磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十五首 其十五","author":"释慧远","text":"尽力当胸一拳，几个眉须堕落。\n更欲如何若何，普化空中木铎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十五首 其八","author":"释慧远","text":"行行月冷风高，步步山寒水深。\n逢人披肝露胆，见义劈腹剜心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十五首 其二","author":"释慧远","text":"接著一个半个，觅得三文两文。\n谁知破布袋里，许多弥勒世尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其三十四","author":"释慧远","text":"饶君舌拄梵天，我也令行一半。\n赵州头戴草鞋，也是新繁轹钻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古四十五首 其二十八","author":"释慧远","text":"不问有言无言，说甚见影见鞭。\n露柱口挂壁上，灯笼倒退三千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈八首 其二","author":"释慧远","text":"昨夜来报五参，正值老僧洗脚。\n起来抖擞精神，末上输他一著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十六","author":"释慧远","text":"山僧有个不是，丧尽衲僧巴鼻。\n惊回陕府铁牛，吞却山河大地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十六","author":"释慧远","text":"会得浮山两错，佛祖从头架阁。\n若还依旧宁馨，若极黄病白鹤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七十一","author":"释慧远","text":"今朝腊月二十，依旧眼横鼻直。\n从头收拾将来，恰似一棚杂剧。\n便是抹土涂灰，我也阿谁相识。\n九百木大小进，处分全由节级。\n忽然出至棚前，也解打躬相揖。\n驼起要打便打，放下要泣便泣。\n蓦然冷笑一声，笑倒判官五十。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十八","author":"释慧远","text":"大地山河不现，虚空冷汗通身。\n拄杖头边路绝，髑髅眼里抽筋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八十五","author":"释慧远","text":"文殊尽力一问，维摩结舌无言。\n布袋长时落魄，饮光论劫坐禅。\n鼻孔只在面上，口皮不离唇边。\n四个合成两个，三钱置得一钱。\n而今除本算利，且喜本利俱全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其二十三","author":"释慧远","text":"昨夜三更风起，吹皱一池春水。\n鱼龙头角峥嵘，露柱振腮摆尾。\n虾蟆㪍跳上天，鸭儿惊得匾觜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄源大师","author":"释慧远","text":"学佛以悟为则，虚词不入公门。\n君看羲之草圣，一点入石三分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维摩居士赞","author":"释慧远","text":"到处毁僧骂佛，知佗有官无官。\n善现屡遭呵责，瞿昙也被热谩。\n只有文殊不肯，吃气出来理问。\n遮汉自知无理，当时口似磉盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂","author":"释慧远","text":"雪霁长空，迥野飞鸿。\n段云片片，向西向东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释慧远","text":"至道无难，唯嫌拣择。\n但莫憎爱，洞然明白。\n毫釐有差，天地悬隔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"付净彻首座竹篦","author":"释慧性","text":"竹篦付了复何为，佛祖当头劈面挥。\n尺水便能翻逆浪，尽教人荐截流机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沈安齐草庵号常牧","author":"释慧性","text":"尚堕功勋不自由，还同死水卧泥牛。\n何如阔进竿头步，撒手悬崖万仞头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其七","author":"释慧性","text":"当阳利剑斩狸奴，刃下翻身会也无。\n脱下草鞋头戴出，石人吞却洞庭湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古七首 其一","author":"释慧性","text":"南枝向暖北枝寒，一种春风有两般。\n寄语高楼莫吹笛，大家留取倚栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其三十四","author":"释慧性","text":"归宗无法可商量，独掇单提不覆藏。\n有问西来端的意，天寒日短夜偏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其四","author":"释慧性","text":"不知立处高多少，回头四顾白云低。\n等闲移步毗卢顶，拽转南辰安向西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其七十八","author":"释慧性","text":"东村王老夜烧钱，打著南边动北边。\n赤骨历穷誇富贵，日高三丈尚憨眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零一首 其八","author":"释慧性","text":"哑却我口秃我舌，明眼衲僧难辨别。\n今朝撒向诸人前，须弥灯王笑不彻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":22130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]