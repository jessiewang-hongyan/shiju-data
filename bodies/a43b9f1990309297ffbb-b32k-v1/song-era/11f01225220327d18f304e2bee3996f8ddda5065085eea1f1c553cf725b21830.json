[{"title":"又和病起","author":"林逋","text":"展转匡床乍起来，缥缸湘帙亦慵开。\n三年一尉湖东住，谁识神仙本姓梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小舟","author":"林逋","text":"舷低冷戛荷千柄，底?斜穿月半轮。\n一笠一蓑人稳坐，晚风萧飒弄青蘋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中寒食 其一","author":"林逋","text":"方塘波绿杜蘅青，布谷提壶已足听。\n有客新尝寒具罢，据梧慵复散幽经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中寒食 其二","author":"林逋","text":"气象才过一百五，且持春酒养衰年。\n中林不是不禁火，其奈山樱发欲然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山阁夏日寄黄大茂才","author":"林逋","text":"几日无缘见叔度，令人鄙吝不能忘。\n新篁绕阁薰风细，还肯时来纳晚凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予顷得宛陵葛生所茹笔十馀筒其中复得精妙者二三焉每用之如麾百胜之师横行于纸墨间所向无不如意惜其日久且弊作诗二篇以录其功 其二","author":"林逋","text":"神锋虽缺力终存，架琢珊瑚欠策勋。\n日暮闲窗何所似，灞陵憔悴故将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予顷得宛陵葛生所茹笔十馀筒其中复得精妙者二三焉每用之如麾百胜之师横行于纸墨间所向无不如意惜其日久且弊作诗二篇以录其功 其一","author":"林逋","text":"江南秋兔老毫疏，数字钟王尚贾馀。\n因读退之毛颖传，可怜今日不中书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水轩","author":"林逋","text":"日于诗雅转沉迷，尤爱凭阑此构题。\n飘荡杨花春意晚，黄鹂飞过水东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凫","author":"林逋","text":"三三两两自相随，檀颈回看■赩衣。\n野水无波秋色净，不知何事忽惊飞。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28810,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池上作","author":"林逋","text":"簇簇菰蒲映蓼花，水痕天影蘸秋霞。\n分明似个屏风上，飞起鵁鶄一道斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28811,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹林","author":"林逋","text":"寺篱斜夹千梢翠，山径深穿万箨乾。\n却忆贵家厅馆里，粉墙时画数茎看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28812,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自作寿堂因书一绝以志之","author":"林逋","text":"湖上青山对结庐，坟头秋色亦萧疏。\n茂陵他日求遗稿，犹喜曾无封禅书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28813,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏","author":"林逋","text":"乳雀啁啾日气浓，雉来交影日重重。\n秧田百亩鹅黄大，横策溪村属老农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28814,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即席送江夏茂才","author":"林逋","text":"与君未别且酣饮，别后令人空倚楼。\n一点风帆若为望，海门平阔鹭涛秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28815,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李翰林寄松扇及诗乃答之","author":"林逋","text":"编松为箑寄山中，兼得紫微诗一通。\n入手凉生殊自慰，耳频长听隐居风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28816,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闵上人以鹭鸶二轴为寄因成二韵","author":"林逋","text":"閒飏粉丝荷苇外，数声惟欠叫秋阴。\n虚堂隐几时悬看，增得沧洲趣更深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28817,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闵师自天台见寄石枕","author":"林逋","text":"斲石自何许，枕之怀赤城。\n空庐复蕙帐，旦暮白云生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28818,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呦呦","author":"林逋","text":"深林摵摵分行响，浅葑茸茸叠浪痕。\n春雪满山人起晚，数声低叫唤篱门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28819,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和才上人春日见寄","author":"林逋","text":"俗外多将云作装，花前惟以醉为乡。\n瑶华伸玩情何极，高绝犹如登百常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王给事同诸官留题","author":"林逋","text":"千兵款户迂红旆，四壁留题拂紫苔。\n他日北山传故事，愿将猿鹤比云来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和安秀才次晋昌居士留题壁石","author":"林逋","text":"岑寂衡门题凤处，岭云庭树似无依。\n湖滨伫立应相望，一信樵风晚未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和唐异见寄","author":"林逋","text":"骚人新遗畔牢词，隐几微吟愧所知。\n几欲樽前论款密，可能林下访栖迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和皓文二绝 其一","author":"林逋","text":"李杜风骚少得朋，将坛高筑竟谁登。\n林萝寂寂湖山好，月下敲门只有僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和皓文二绝 其二","author":"林逋","text":"芳草谁能梦谢池，但将心地喻摩尼。\n千岩万壑时相忆，明月清风两自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和谢秘校西湖马上","author":"林逋","text":"表里湖山极目春，据鞍时此避埃尘。\n苍苍烟树悠悠水，除却王维少画人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和蒙尉见寄","author":"林逋","text":"开尊且醉圣贤酒，理棹时乘旦暮风。\n懒为躬耕咏梁甫，敢将高卧敌隆中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和酬周寺丞","author":"林逋","text":"门横野水席凝尘，束缊谁能问乞邻。\n除是千庐贵游客，中林时复访幽人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤山隐居书壁","author":"林逋","text":"山水未深猿鸟少，此生犹拟别移居。\n直过天竺溪流上，独树为桥小结庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤山雪中写望寄呈景山仙尉","author":"林逋","text":"璚树瑶岑掠眼新，鲜飙时复飏珠尘。\n此中自是蓬莱阙，何处更寻姑射人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"易从师山亭","author":"林逋","text":"林表秋山白鸟飞，此中幽致亦还稀。\n西村渡口人烟晚，坐见渔舟两两归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松径","author":"林逋","text":"霜子落秋筇卓破，雨钗堆地屐拖平。\n不知呵止长安客，肯爱深穿冷翠行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸣皋","author":"林逋","text":"皋禽名祇有前闻，孤引圆吭夜正分。\n一唳便惊寥泬破，亦无閒意到青云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复送慈公还虎丘山","author":"林逋","text":"孑孑归樯五两翻，香林禅石抱云根。\n单囊憩罢还微笑，却是青山不出门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日斋中","author":"林逋","text":"空阶重叠上垣衣，白昼初长社燕归。\n落尽海棠人卧病，东风时复动柴扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋江写望","author":"林逋","text":"苍茫沙嘴鹭鸶眠，片水无痕浸碧天。\n最爱芦花经雨后，一篷烟火饭鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送丁秀才归四明","author":"林逋","text":"有似东浮沧海君，乘槎泛泛逐归云。\n蛟绡市得能为寄，拟写清真隐秘文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人之苍梧","author":"林逋","text":"侧身南望但依依，片席乘风去似飞。\n莫谓苍梧在天末，帝乡看逐白云归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送人游金山","author":"林逋","text":"水烟霜树矗层峦，点破江心一簇寒。\n见说天多剩得月，为予间上上方看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送大方师归金陵","author":"林逋","text":"渺渺江天白鸟飞，石城秋色送僧归。\n长干古寺经行了，为到清凉看翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送有交师辇下","author":"林逋","text":"滤罗閒佩氎巾轻，秋籁随身指去程。\n辇下大僚多好事，退朝谁著道衣迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈日章秀才","author":"林逋","text":"閒却清尊掩缥囊，病来无故亦凄凉。\n江南春草旧行路，因送归人更断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送易从师还金华","author":"林逋","text":"吟卷田衣岁向残，孤舟夜泊大江寒。\n前岩百本长松色，及早回来带雪看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送善中师归四明","author":"林逋","text":"四明山水别多时，老病心閒事事违。\n梦想西湖古兰若，又和秋色送僧归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送然上人南还","author":"林逋","text":"囊携琴谱与诗稿，寄卧船窗一榻深。\n莫向云中认江树，等閒惊