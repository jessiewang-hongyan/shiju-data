[{"title":"和超然翁韵二首 其二","author":"黄公度","text":"西风回首故乡情，何日为园学邵平。\n已办孤帆冲夕浪，可堪万壑更秋声。\n折腰为米追时辈，当面输心愧老成。\n饮罢归来未能寝，微吟拥鼻数寒更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和超然翁韵二首 其一","author":"黄公度","text":"才微祇合老荆扉，误窃虚名及盛时。\n藜杖端须为刘烛，匏竽聊复预齐吹。\n亨衢腾踔非吾事，客路逢迎仰己知。\n莫讶归程秋向晚，也应去鲁自迟迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和蔡司法南安之什","author":"黄公度","text":"一夜晴风吹晓霞，平明联辔踏飞花。\n岚光且对圣贤酒，世事仅同蛮触蜗。\n簿领迷人春易老，渔樵满地昼无哗。\n登临未饱溪山兴，归路星星月照沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐梅树下率尔","author":"黄公度","text":"羌吹宣重籥，胡床近小台。\n轻轻云片度，淡淡月华开。\n壁暗雨留藓，庭虚风落梅。\n纳凉公宇邃，清夜兴悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉别王宰先之","author":"黄公度","text":"画角城头绕怨音，秋风握手别杯深。\n三年故国相从地，万里青云欲别心。\n醉罢林霜催菊老，梦回江月转棠阴。\n预愁晓色离亭外，衰草撩人思不禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"实之有诗复次其韵","author":"黄公度","text":"鞅掌从王事，招邀愧主人。\n弹琴秋叶落，听雨夜床亲。\n岁月何妨纪，诗篇莫厌频。\n要令千载下，不但数姜秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岳阳楼","author":"王十朋","text":"后乐先忧记饱观，兹楼今始得凭栏。\n吐吞五水波涛阔，出纳三光境界宽。\n黄帝乐声喧广宙，湘君山影侵晴澜。\n江山何独助张说，收拾清诗上笔端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庚午秋观进士入试","author":"黄公度","text":"棘扉晓辟万袍趋，邹鲁虽微士所都。\n三献有人怀楚璞，滥吹何事试齐竽。\n要令廋语题齑臼，莫把元文覆酱瓿。\n袖手傍观君勿怪，个中曾是老于菟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庚申元日","author":"黄公度","text":"茧足度残腊，回头又一年。\n文书疏病眼，事业付高眠。\n盥栉从朝懒，衾裯觉夜便。\n南邻竞春色，车马日喧阗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徯诸同年和章久之无耗再用前韵","author":"黄公度","text":"劳君携酒出郊坰，强缉巴词醉墨轻。\n我辈讵能捐习气，伊人底事寡诗情。\n漫令抆目朝朝望，无复挥毫字字清。\n冷淡生涯殊不恶，想应著意讳穷名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苦热","author":"黄公度","text":"玉井晨不冷，茅檐午欲焚。\n月摇看画箑，榴吐认红裙。\n迥野都如火，奇峰空自云。\n衣巾负芒刺，曝背有人耘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试院中蒙相君惠茶和钱教授韵","author":"黄公度","text":"误向文闱齿搢绅，相君分赐壑源春。\n穷搜千卷非吾事，满引一杯如故人。\n无复睡魔能偃蹇，敢将诗律斗清新。\n西湖好趁清明约，泉活涓涓火不陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后春游","author":"黄公度","text":"鸣鸠乳燕报新晴，更被提壶苦劝人。\n万点桃花落红雨，十分蕉叶负青春。\n醉乡归去疑无路，诗笔拈来似有神。\n莫惜千金买一笑，馀年乐事更关身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后陪省中诸公游竹阁","author":"黄公度","text":"红尽桃初实，青浓柳欲花。\n春归人迹少，山远市声哗。\n空有前朝树，难寻处士家。\n登临多感慨，况复客天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将归","author":"黄公度","text":"北首寒犹浅，南辕暑正深。\n马蹄长道路，鹿性本山林。\n客至能相勉，愁来可独禁。\n功名竟何物，造化久冥心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将放榜用钱韵","author":"黄公度","text":"银袍健笔落云烟，入眼高文墨尚鲜。\n隐隐蚕声桑叶下，看看鹄立棘图前。\n空阶夜响催诗雨，平地雷轰造榜天。\n试问西湖好风景，何如华屋艳神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将赴高要官守书怀","author":"黄公度","text":"古来仕路多机阱，我复情田少町畦。\n回首壮图犹拾沈，惊心往事屡吹齑。\n不因昏嫁那能许，此去声名敢厌低。\n但使安閒更强健，何妨流落在涂泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思归","author":"黄公度","text":"醉眼乾坤大，归心日夜长。\n风霜岁云暮，尘土鬓成苍。\n俗物犹能在，危机只自防。\n可无田种秫，三径未宜荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日书怀","author":"黄公度","text":"才薄难任家国忧，年衰未免稻粱谋。\n权门虽好羞摇尾，世路多猜敢转喉。\n是处溪山可藏拙，何人庭院许寻幽。\n便须火急营春事，九十韶光一半休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日怀王庆长","author":"黄公度","text":"夜雨才沾地，朝晖已照墙。\n润畦舒菜甲，暖树拆茶枪。\n胡虏潜沙碛，关河息战场。\n王孙缘底事，萍迹久他乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日宴共乐台","author":"黄公度","text":"画栋朱甍插紫清，连山带水自纡萦。\n闾阎高下鱼鳞比，田亩纵横棋局平。\n花发鸟啼春耐事，夜阑客散月多情。\n寸阴自古千金重，一笑人间万虑轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨中会西山佛迹","author":"黄公度","text":"自喜平生山水心，公馀犹及此登临。\n云埋古寺钟声远，花落空村烟雨深。\n是处芳尊追胜槩，几人寒勒度疏林。\n都无春色一分在，况有尘寰万虑侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春思","author":"黄公度","text":"红入西园早，青归平野多。\n日长花欲睡，风软幕微波。\n万户茅柴酒，一声欸乃歌。\n天涯春漫好，无奈客愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日晚晴怀南山旧游","author":"黄公度","text":"霁色孤城外，秋声独树边。\n烟云澄远屿，风月渺平川。\n寇盗休何日，登临忆去年。\n吾曹得疏放，醉墨洒层巅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴二首 其二","author":"黄公度","text":"牙叉老木抱江城，城古江寒相对清。\n云雁不逢音信杳，沙鸥无数往来轻。\n露华今夜凝仙掌，词藻他年动帝京。\n淮海一身犹卧病，关河千里未休兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋兴二首 其一","author":"黄公度","text":"秋入蒹葭霜正威，数声归雁塞痕微。\n欺人白发萧萧得，未老丹枫故故飞。\n胡虏乾坤多战骨，江湖风雨一蓑衣。\n百年粗饭从衰朽，万事尘寰有是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋旱祈雨","author":"黄公度","text":"万顷膏腴欲圻龟，祷祠曾不补毫釐。\n朝廷无事政刑简，天地何心岭海饥。\n绝徼难逢霖雨手，隐忧先到老农眉。\n谁能鞭策卧龙起，乞与滂沱一解颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜独酌","author":"黄公度","text":"溪山态足身无事，天地功深岁有秋。\n投老相从管城子，平生得意醉乡侯。\n捲帘清坐月排闼，横笛谁家风满楼。\n可是离人更遗物，自缘身世两无求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋城晚望","author":"黄公度","text":"断续悲笳起丽谯，冥冥晚色四山椒。\n隔江人散虚分米，十里津喧蜑趁潮。\n夕照含山心悄怆，西风动地鬓飘萧。\n低头自笑微官缚，东望沧溟归路遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺陆盐允济二首 其二","author":"黄公度","text":"大手聊分八使车，腰丛六印益纡徐。\n圜扉鞠草刑无滥，万灶熬波国有储。\n航栈蛮琛纷络绎，权衡选路不崎岖。\n苍生久郁为霖望，早晚徵书下玉除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺陆盐允济二首 其一","author":"黄公度","text":"商飙送喜满华轩，乔岳钟灵积庆门。\n天上台星对南极，人间佳节是中元。\n一时闽越看前辈，千载机云见远孙。\n香火祝公如卫武，他年勋业照乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺郑漕三首 其三","author":"黄公度","text":"东京望重两儒先，经术传家几百年。\n派别九仙绵庆胄，运逢千载毓真贤。\n鼎槐未即登三事，社栎何知托二天。\n寿考祝公如卫武，愿赓淇澳入诗篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺郑漕三首 其二","author":"黄公度","text":"天子欲宽南顾忧，绣衣曾是旧人求。\n山川不改元风采，父老能言昔政猷。\n襦裤疲民应枕奠，纪纲新度觉钱流。\n生灵一种同天地，雨露何偏十四州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺郑漕三首 其一","author":"黄公度","text":"当年画省与成均，联璧看君亲弟昆。\n清世几人兼五福，白头相对备三尊。\n朝班犹识尚书履，时论同推通德门。\n早晚芝函趣归骑，要令勋业照乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴南恩道间和杨体南三首 其一","author":"黄公度","text":"再岁大江滨，了无功可程。\n行行看绝塞，录录更专城。\n不作安巢鸟，应惭出谷莺。\n赖同草玄手，时抱一经横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送余子美归淮上","author":"黄公度","text":"怪底穷途遭白眼，依然别酒对青春。\n百年甘旨为贫计，千里羁栖有故人。\n道在不妨轻去鲁，功成他日会归秦。\n江淮若遇南飞翼，尺素无忘东海滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈景明尚书赴召四首 其四","author":"黄公度","text":"薄宦跕鸢城，归来梦乍惊。\n壮图空老大，朴学误平生。\n有客嘲杨子，无人荐祢衡。\n盐车逢伯乐，作意一长鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈景明尚书赴召四首 其三","author":"黄公度","text":"雁塔相先后，麟台数往还。\n至今清夜梦，时共早朝班。\n岁月栖迟里，云泥指顾间。\n天涯瞻马首，喜气动衰颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈景明尚书赴召四首 其二","author":"黄公度","text":"鼎轴今虚席，忧勤轸我皇。\n苍生思起谢，丹诏急徵黄。\n风欲回三代，恩难私一方。\n愿公摅远业，吾道倍辉光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送陈景明尚书赴召四首 其一","author":"黄公度","text":"物望唐姚宋，才名汉董晁。\n力陈治安策，亲际圣明朝。\n谠议裨宸极，高文灿斗杓。\n鹏程九万里，一举接扶摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑察推叔友罢官之潮阳二首 其二","author":"黄公度","text":"春草故人去，落花离绪多。\n芙蓉少颜色，薏苡尽风波。\n尘土非长策，功名一醉歌。\n周南暂留滞，莫改岁寒柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑察推叔友罢官之潮阳二首 其一","author":"黄公度","text":"官达身何补，才名陆未沉。\n不妨吾道在，休较吏文深。\n城郭春将暮，风云晚更阴。\n相看炎海阔，魂断欲分襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夜","author":"黄公度","text":"暮景流年速，寒灯照夜长。\n艰危仍薄宦，时序更他乡。\n雪暗吴宫下，春归越峤傍。\n明朝对佳节，无处觅椒觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倚薄","author":"黄公度","text":"茅檐供倚薄，藜杖费扶携。\n天入平芜阔，山含宿霭低。\n树声风便旋，野色晚凄迷。\n容易营生事，秋田稻欲齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夏日陈应求见访","author":"黄公度","text":"酷暑避脩竹，繁阴侵短楹。\n形骸方枕簟，车马忽柴荆。\n对酒情无极，哦诗韵更清。\n昏鸦催别急，天末片云横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"家僮归得王庆长消息知留浙中秋举","author":"黄公度","text":"倦仆去复返，怜君归未能。\n吟馀幽砌月，梦破短檠灯。\n地僻人稀到，书成雁莫凭。\n秋风霜翮健，天末看飞腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"恩平灯夕忆上都旧游呈座客","author":"黄公度","text":"千尺鳌山面紫宸，豪华曾见夹城春。\n至今魂梦钧天奏，投老宦游穷海滨。\n随分尊罍奉佳客，记时灯火照严闉。\n年来大觉欢情减，聊与风光作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽十一伯奉议四首 其四","author":"黄公度","text":"往者更声律，公兮独老成。\n馀波及犹子，作赋得虚名。\n瘴海三年别，灵岩一梦惊。\n归来访遗迹，心折涕纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽十一伯奉议四首 其三","author":"黄公度","text":"有子皆麟凤，承家赖一夔。\n朝班通籍日，纶诰锡封时。\n堂上兰羞罢，人间风树悲。\n生荣死不朽，犹恨未期颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽十一伯奉议四首 其二","author":"黄公度","text":"丘壑性所乐，诗书老自娱。\n谭惟听两部，贫不种千奴。\n岁月柯间蚁，功名水上凫。\n平生五车读，留得付诸孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽十一伯奉议四首 其一","author":"黄公度","text":"弓冶传家学，才名观国宾。\n谭经至白首，投老漫青纶。\n北去曾乘险，南归益自珍。\n要知超悟处，缥帙有离尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽方仲及签判二首 其二","author":"黄公度","text":"年来群盗满南区，百指间关返旧庐。\n杖屦不辞还往数，尊罍犹想笑谭馀。\n音容忽忽成千古，身世悠悠竟六如。\n脩短穷通一无恨，可怜经济尽丘墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽方仲及签判二首 其一","author":"黄公度","text":"才华早岁妙中州，惠爱长存瘴岭头。\n陈迹他年循吏传，遗文何日茂陵求。\n平生业履一经在，投老功名万事休。\n惟有岿然岘山石，往来涕泪不胜流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽方有成教授","author":"黄公度","text":"生平劲节朱丝直，老去清规玉斗寒。\n卜筑空存新第宅，典刑不见旧衣冠。\n百年世事随风烛，二纪才名独冷官。\n谢砌馀芳知未泯，森森儿侄长芝兰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽乐全宋丈二首 其二","author":"黄公度","text":"叹息高人逝，仪形绘事传。\n耆年馀八十，遗行满三千。\n朱绂沾新命，苍松郁故阡。\n春风笳吹咽，桃李亦凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽乐全宋丈二首 其一","author":"黄公度","text":"吾道初彫丧，斯文竟老成。\n一经贻子训，万石擅家声。\n棠棣春阴重，芝兰晚节荣。\n馀芳知未泯，奕世有簪缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽朱师禹母二首 其二","author":"黄公度","text":"孝养空怀橘，严规想断机。\n影留生日面，棺掩嫁时衣。\n萱室言犹在，兰陔事已非。\n九原行楚挽，桃李惨春晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽朱师禹母二首 其一","author":"黄公度","text":"安室全贞操，刑家蔼令仪。\n乘龙推快婿，干蛊有馨儿。\n未遂林乌报，俄缠风树悲。\n汗青他日传，不愧柏舟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽张直讲圣行二首 其二","author":"黄公度","text":"故老复谁在，此邦嗟至今。\n文章千古事，忠孝一生心。\n客散门庭寂，尘留几杖深。\n莆人颂遗爱，南望泪横襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽张直讲圣行二首 其一","author":"黄公度","text":"末学知归㝢，先生有典刑。\n家贫甘半菽，身后只群经。\n尊俎言犹在，琼瑰梦已灵。\n林宗负全节，无愧冢中铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽陈夫人卓氏二首 其二","author":"黄公度","text":"蘋藻洁羞遗训在，芝兰奕叶庆源赊。\n何人诔德须千字，他日冢傍应万家。\n秋风摧谢忘忧草，古木悲啼反哺鸦。\n犹忆升堂初拜跪，依然象服俨笄珈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽陈夫人卓氏二首 其一","author":"黄公度","text":"贵不改旧习，老犹遵幼仪。\n安贫偕隐者，急义胜男儿。\n馀润河九里，宁馨桂一枝。\n秋毫有遗恨，石窌剖封迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽林闻远","author":"黄公度","text":"曾向文闱屈壮图，羞将华发傍戎车。\n平生自致千金产，投老相辜一卷书。\n有子克家追羯末，何人会葬尽严徐。\n青天白日佳城闭，宰木萧萧穗帐虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽林惠州深父二首 其二","author":"黄公度","text":"昭代轻辞禄，高堂久击鲜。\n庆馀黄雀报，梦契白鸡年。\n酹酒生刍外，归魂宿草边。\n伤生耆旧尽，执绋涕潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽林惠州深父二首 其一","author":"黄公度","text":"吾道初彫丧，名公竟典刑。\n牧民沾汉玺，诏子有韦经。\n阻奉金銮对，虚埋石椁铭。\n登门人已往，遗范俨丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽欧阳夫人许氏二首 其二","author":"黄公度","text":"曹范梅峰下，安舆晋水傍。\n百年亏上寿，五鼎富前丧。\n鸾鉴尘初合，龙龛木已苍。\n平生足阴德，亲受伯仁觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":70942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]