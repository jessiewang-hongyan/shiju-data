[{"title":"春暮怀伯弜","author":"释永颐","text":"筼筜深谷近青霄，春尽思君梦自劳。\n歌鸟不来香室掩，绶花空结紫藤高。\n荒池瓦砾迷芳草，晓案烟云拥墨袍。\n山近响潭多胜好，论诗无处觅刘曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日与知言学士","author":"释永颐","text":"水落小山浮，山人上下游。\n月崖烟桂晚，风浦石兰秋。\n食芰渔溪宿，烹葵野馆留。\n肩吾相对坐，清话不知休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日汎西湖","author":"释永颐","text":"水凉宜照影，与客上湖船。\n白浪翻红楫，青山映碧莲。\n鸟飞荷叶下，人散柳条边。\n烟盖归来晚，灯前鹤未眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送通上人归仙潭寺","author":"释永颐","text":"寺忆清溪绕，舟移曲岸分。\n塔昏飞雨怪，殿黑隐雷文。\n锡挂秋房冷，香浮夕帐熏。\n藓庭閒望过，碧鹤下晴云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧之金陵","author":"释永颐","text":"秋针感线溪，云衲几回披。\n陇月当窗夜，钟山入句时。\n梦依红树宿，寒渡碧江迟。\n吴楚繁幽胜，相逢苦未期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郜溪别周伯弜","author":"释永颐","text":"夜馆寒相对，篝灯语不眠。\n夕烟生水郭，风柳泊沙船。\n暖弃山中宅，春耕葑上田。\n西峰晴霭碧，归去挹飞泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄周宗圣","author":"释永颐","text":"我心如有失，曾未识南园。\n几见閒花落，频将好梦原。\n时贤多厚禄，君子尚衡门。\n诗卷逢僧寄，长吟落照村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼周晋仙 其二","author":"释永颐","text":"诗救元和失，先生学最精。\n律严方苦硬，才大始纵横。\n贞曜何须谥，魏闲相继生。\n他年诗集著，风雅被家声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼周晋仙 其一","author":"释永颐","text":"萧散嵇康辈，难教缚宦情。\n识高浑脱略，意广惜沈婴。\n老面烟霞古，醉衣苔藓生。\n西峰难独往，茶灶对谁烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"悼赵宰紫芝甫","author":"释永颐","text":"紫芝昔赋天台日，桐柏宫诗老更成。\n梦断玉楼春帐晓，蝶迷花院夕魂轻。\n钱郎旧体终难并，姚贾新裁近有声。\n有子无家须吊问，故交谁不为伤情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中 其二","author":"释永颐","text":"谷寺掩高扉，松亭雪侧垂。\n石幢围隐兽，野殿没寒鸱。\n路转空林积，风惊老树危。\n草堂香火静，山鹿到荒墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中 其一","author":"释永颐","text":"风定片初微，移时鹊噪稀。\n曲塘添柳重，彤阁映花飞。\n鹤怪云黏石，僧疑月照扉。\n闭门高卧者，终岁复何依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游霅城寄辉明远","author":"释永颐","text":"老来霅上经过少，不复虚堂拜皎然。\n窥庙野童惊古像，拊碑山客慕先贤。\n雨多乱水穿城过，日上苍山绕郡连。\n隔港木兰摇客棹，浦荷香散碧云天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潭上","author":"释永颐","text":"落叶寒潭上，秋风钓艇閒。\n片云移晚渡，孤浪兀晴山。\n败栅寒芜拥，高枫夕照还。\n一鸥飞起处，烟霭暮溪湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中晚兴","author":"释永颐","text":"松间石上听流泉，看尽云归宿鸟还。\n夕殿焚香春院闭，暮钟沈响月阶閒。\n非干独往轻遗世，自合离群静掩关。\n林境翠深烟树合，正堪高卧纵疏顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山乐官寄野斋","author":"释永颐","text":"山乐官，山乐官。\n尔为灵凤典音乐，想尔废职来考槃。\n莫厌山中多寂寞，山中无事忘忧乐。\n晓窗睡起春昼静，听尔幽情如有托。\n山乐官，山乐官。\n纵令致汝百鸟前，此声此曲终难传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云岩寺","author":"释永颐","text":"老来好古尚关心，寺里荒题几度寻。\n山鹊报晴窥画阁，水鸡嫌雨上高林。\n麦残馀冷收春候，楝落轻风滞晚阴。\n无限幽怀难具写，一凭阑罢一閒吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"友人铜雀台砚","author":"释永颐","text":"异物留传因好古，南来箧笥伴瑶琴。\n漳河流水去无已，魏主荒台久废沈。\n往日奸文须九锡，今朝片瓦尚千金。\n所嗟人事多浮伪，谁识河滨古舜心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月夜游冷泉亭","author":"释永颐","text":"地灵泉上寺，松壑定深清。\n独听子规叫，况逢山月明。\n树藏春洞黑，石拥夜泉鸣。\n日出喧车马，终非隐者情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙山野望","author":"释永颐","text":"闻说西潘桑柘少，旧来多种紫樱桃。\n龙山春晚聊舒望，雪白梨花一丈高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"后谷春晚","author":"释永颐","text":"烟冷云深燕不归，径多松叶少花枝。\n春风过尽无行客，白昼山獐饮石池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西峰日暮","author":"释永颐","text":"手携一束书，秋风独来此。\n松深夜月清，水冷芙蓉死。\n懒于檐下读，两眼悬秋水。\n时看涧鼠来，食我山茶子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过青芝村观晚梅","author":"释永颐","text":"梅花树下春风静，苔荒荠老围春井。\n山翁汲泉来点茶，触残花下玲珑影。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伯弜出示新题乐府四十章雄深雅健有长吉之风喜而有咏","author":"释永颐","text":"伟哉吴人周伯弜，国风雅颂今再昌。\n钧天洞庭不敢张，楚芈暗泣嗟穷湘。\n庆祚三百多祯祥，呜呼四十乐府章。\n春宵剪烛飞兰香，浩歌激烈声洋洋。\n贞魂义血流精光，奸鬼妒魄诛幽荒。\n土木闪怪踏雪僵，茫茫万窍塞鼓簧。\n再洗律吕调宫商，金玉振耀齐铿锵。\n一清一浊均阴阳，风霆变化始有常。\n咏歌唐虞及商汤，矇瞽献纳皆赞襄。\n煌煌天子朝明堂，永被金石无哀伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杉下聋僧","author":"释永颐","text":"殿阴古杉高百尺，苍弁虬髯森淀漆。\n林深化蝶粉光冷，威凤飘飖感仙实。\n旁有聋僧唤不闻，嗫嗫枯吟如有失。\n或时兀坐何堆豗，或时手把古书帙。\n帙中明星不复记，案上吟篇已亡律。\n居山六月不知暑，地凉艳草生幽苾。\n茶灶泥崩古藓黏，石盆仰地莲花出。\n山童昼睡靠其旁，裤如盘络不掩膝。\n僧今老矣无别怀，时梦响潭清汩汩。\n终当卜室居其偏，坐看蜿蜒舞清溢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苧渎夜泊","author":"释永颐","text":"吴城水冷秋风高，迎霜枫叶飘城壕。\n吴侬射利如射虏，高帆大艑横江涛。\n黄昏不顾风水恶，篙儿怒击何轻豪。\n苧渎人家惯迎接，憧憧来往无停艘。\n水上悬灯招夜泊，沙头认客相呼号。\n人生富贵多不足，亦有稗贩当勤劳。\n万斛高装谋重利，斗升未给浮轻舠。\n吾生最爱鲁仲连，封侯不受海上逃。\n轻世肆志甘贫贱，谁能富贵诎辱遭。\n夜歌新诗喜达旦，起看征雁飞云皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和韩涧泉韵题周晋仙山楹","author":"释永颐","text":"不剪亦不斲，山楹在尘表。\n石泉声淙淙，秀谷自围绕。\n是中玄览人，未见今日了。\n君固自无心，世亦不易晓。\n梦奠何可攀，颓然泰山小。\n当时岩壑人，百世何矫矫。\n清吟振霞缨，日翳群阴悄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏怀","author":"释永颐","text":"落日重云下，哀哀闻子规。\n荆玉化为土，湘泪摧空枝。\n彼禽复何怨，岁岁号春时。\n春风自无情，众芳日夜衰。\n冉冉无终极，哀乐徒尔为。\n睇彼川上流，浩荡无前期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏怀","author":"释永颐","text":"晨风荡原野，高林摩苍条。\n屋上野花落，阶前春草摇。\n少壮不可恃，金骨亦易销。\n夙志叹沈泯，晚心日幽寥。\n紫烟凌石峰，绿云生桂标。\n林怀颇清畅，况复灵景饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金鹅晚眺","author":"释永颐","text":"天低野旷树濛濛，尽入金鹅望眼中。\n青嶂月生双雁去，碧溪云绕乱帆通。\n平篙落照沈烟墅，结阵寒鸦噪暝丛。\n岁月飞腾吾懒矣，昏钟迢递起秋宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后对月","author":"释永颐","text":"清夜不复寐，萧然据胡床。\n对此九天上，阴魄含虚光。\n光飞激洞户，彩瑩栖云塘。\n芙蓉杂羽盖，暗水流瑶芳。\n景异沈昔梦，心定闻空香。\n不知孤寂身，尚此山水乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"姚震父自剡来喜晴郊行","author":"释永颐","text":"梅发春江棹绿波，越乡才离认吴歌。\n寻花戴帽谁家去，载酒移船与客过。\n废馆夕阳寒柳动，古宫芳草白云多。\n山行每是清晨出，归路牛羊下远坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将别旧山寄伯弜","author":"释永颐","text":"吾道贵日损，纪纲付有力。\n誓舍耕凿资，生以给信食。\n岁晏民物耗，霜枯鹰隼击。\n寂士无丰姿，空田罄尘积。\n小臧别我去，晚瓢先挂壁。\n饥寒并一身，舍下无遗迹。\n穷达不异趣，死生共短息。\n硕友谅难舍，他山终易适。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庭心草","author":"释永颐","text":"兀坐转流光，见尔庭心草。\n亭亭花未开，靡靡叶先老。\n潜荄几化萤，芳蕤暂妍好。\n悁虑果徒劳，吾言非计早。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牵牛花","author":"释永颐","text":"老梅枝上挂牵牛，引得青花上树头。\n秋圃日斜风露冷，倒垂长蔓拂鸣鸠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋馆","author":"释永颐","text":"林暑渐消歇，爽气浮高松。\n风蝉有遗响，露花结秋红。\n微月出东岭，碧云散遐穹。\n暮馆正虚寂，泉声杂鸣蛩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王以通之官金陵 其二","author":"释永颐","text":"伯符兄弟最英雄，千载青山绕故宫。\n宋祖只知曹马事，齐高还与獍枭同。\n暮箫尚带兰陵怨，春水多愁旧垒空。\n登览未应迷宿昔，夜猿啼在晋时枫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送王以通之官金陵 其一","author":"释永颐","text":"芳辰早失意兼衰，不拟君来重举杯。\n云暗月墙花气重，蜡残风幕鸟声催。\n醉乡人有江东役，乘兴船从阙下回。\n明日沙头相送罢，荼蘼小院独徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送别韶溪权上人","author":"释永颐","text":"溪行逢雪后，明月照孤身。\n夜榜闻烟艇，春耕见穑人。\n早梅容易落，征路往来频。\n应感随阳雁，年年度柳津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧归霅寺坐夏","author":"释永颐","text":"道会三旬满，乡山九夏初。\n蝶移金鼓梦，龙护宝莲书。\n日落沙洲迥，蘋香水殿虚。\n闭门溪上寺，好好自安居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻子规","author":"释永颐","text":"客情谁是不思归，芳草春深未有期。\n昨夜月明啼更苦，山花满树落胭脂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"食新茶","author":"释永颐","text":"自回山中来，泉石足幽弄。\n茶经犹挂壁，庭草积已众。\n拜先俄食新，香凝云乳动。\n心开神宇泰，境豁谢幽梦。\n至味延冥遐，灵爽脱尘控。\n静语生云雷，逸想超鸾凤。\n饱此岩壑真，清风愿遐送。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"唐栖寺前","author":"释永颐","text":"唐栖寺前溪水流，客帆来往旧杭州。\n津亭树老无人记，得见几回僧白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乾元山洪水","author":"释永颐","text":"乾元山头洪水发，溪有长蛟潜伺察。\n两岸居人莫等閒，年深物怪终腾拔。\n往岁邻封遭水变，只道溪流净如练。\n倏忽人烟数里间，夜半平沈皆不见。\n东南地坼乾坤浮，几番赤子葬洪流。\n神龟去后不复返，休看浪打石人头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄凤山满上人","author":"释永颐","text":"空生久不来，端居常掩室。\n缅怀旧林社，泉壑翳清密。\n古凤閟灵音，野竹无花实。\n动植皆营营，忘言消永日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄姚赣州","author":"释永颐","text":"雪蓬生剡溪，家近放鹤岑。\n晋士有遗风，爱寻支遁林。\n得善忘形服，率然披素襟。\n功名亦偶尔，王戴非无心。\n今人异古昔，贱义而怀琛。\n萧条石门咏，浩荡东山吟。\n如何昌黎翁，醉乡讥湎沈。\n玉带与金鱼，刘毕非所钦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惜梅赠别","author":"释永颐","text":"芦管含愁苦怨春，况兼风雨送行频。\n数株零落寒云畔，难拣香枝寄远人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野棠花","author":"释永颐","text":"野火回飙掩旧株，新丛满眼临征途。\n绿攒深棘欲自蔽，千朵万朵争敷腴。\n新晴远客过林坂，烟涨吴船春泊晚。\n冶艳空摇荡子情，繁香暗逐吴姬远。\n吴姬漂泊行人愁，年年此花开不休。\n半压坏墙荒馆外，乱生春蕻野池头。\n人间买花贵纨绮，一世争知异朝市。\n曲槛朱栏转首空，野棠无主自成丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中送僧还竹阁 其二","author":"释永颐","text":"湖练平铺肃夜涛，柳翻王母白旌旄。\n舞残鹭翿归何处，天上飞花散碧桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11137,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游何山登道场","author":"释永颐","text":"中流望极山头寺，溪午闻钟泊柳津。\n春草细沾微雨润，老松高与碧虚邻。\n鹤归烟麓书堂废，虎去寒岩藓石皴。\n无奈薄游归路晚，水边风旆湿征尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11138,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"葺唐栖旧庐","author":"释永颐","text":"矫时无峻节，立行亏众美。\n远岳惮孤征，徘徊就乡里。\n人情好愉悦，我老齐贤鄙。\n娓娓听乡言，时时容侧耳。\n前脩不可见，法社渐凋毁。\n名山半征徭，祖塔乱獐麂。\n林筑无清资，泽居循旧址。\n凿牖纳晴曦，莳竹临幽泚。\n时将了岁寒，闭户春风里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"越溪吟","author":"释永颐","text":"石磊磊，猿啾啾，越王霸业秋山头。\n英雄丧尽知何数，可怪犹存浣纱处。\n当时月照清溪头，美人如水逐东流。\n至今片石终难改，千载犹含泽国羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感雁来红","author":"释永颐","text":"落落云中雁，亭亭阶下草。\n草心将变红，雁声来已早。\n霜风日夜催，对此忘吾老。\n玲珑叶数层，次第颜色好。\n燕脂染尽时，倚栏如醉倒。\n年年秋雁来，每被吟情恼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠术者王髯","author":"释永颐","text":"王君僧服而胡须，赠我手写千隶书。\n秦汉古法沦俗笔，钟王秘刻藏绮疏。\n君游市俗谁问此，我好奇古贫无馀。\n閒来古寺看画壁，醉去野店烹寒鱼。\n击竹有时谈九命，无钱踏雪走千墟。\n问君岁晚君何如，家有老婢归田庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏夜怀洞霄 其二","author":"释永颐","text":"凉夜宛游清境，归时尚爱攀松。\n回首云烟满目，尽遮九锁寒峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏夜怀洞霄 其一","author":"释永颐","text":"跣足曾穿古洞，衲衣挂在长松。\n一别烟霄十载，夜来梦入西峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释玄应","text":"今年六十六，世寿有延促。\n无生火炽然，有为薪不续。\n出谷与归源，一时俱备足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠英公大师","author":"释玄宝","text":"□爱王家草圣踪，独于小篆苦留功。\n何人会得师高意，欲把时风变古风。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"浮槎山","author":"释用孙","text":"山为浮来海莫沈，萧梁曾此布黄金。\n梵僧亲指耆阇路，帝女归传达磨心。\n地控好峰排万仞，涧馀流水落千寻。\n灵踪断处人何在，日夕云霞望转深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登竺云山","author":"释白幻","text":"独上千峰与万峰，晴岚淡写海江容。\n偶从动问山居事，笑拍岩前一树松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释礼","text":"不是翻涛手，徒誇跨海鲸。\n由基方撚镞，枝上众猿惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"释礼","text":"夺不夺，纵有馀。\n临岐不分袂，富贵却萧疏。\n句里不曾舒慷慨，禹门先自透金鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"永乐寺","author":"释龙石","text":"江云如镜平，月当秋夜白。\n欸乃一声歌，舟中南北客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云门峰","author":"释仲休","text":"鹤唳峰前路，行行世虑消。\n萝交藏石窦，云破露山椒。\n树老形多怪，人闲色似骄。\n谁同访诸谢，烟草满溪桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游梅山寺","author":"释仲休","text":"世续香灯演圣言，再新华构称凭轩。\n阴阴松色连僧阁，飋飋波声入寺门。\n飞鹭衔鱼离浅濑，残云带雨渡遥村。\n沃洲相较应相近，树杪啼烟祇欠猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]