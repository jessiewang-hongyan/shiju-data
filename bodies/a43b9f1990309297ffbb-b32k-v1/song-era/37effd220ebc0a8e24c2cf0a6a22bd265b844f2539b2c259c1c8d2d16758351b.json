[{"title":"呈梦锡","author":"孔平仲","text":"结绶本何意，浩歌今欲归。\n从君卧病去，使我出门希。\n燕领新雏出，鸱盘落景飞。\n何时起相见，一笑两忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"银河咏","author":"孔平仲","text":"江湖有客卧孤城，每见银河眼亦明。\n万里长风吹不断，一番微雨洗尤清。\n星辰白石参差乱，云气飞梁倏忽生。\n牛女东西波浪隔，夜寒天阔不胜情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"学舍","author":"孔平仲","text":"簿领如棼处处忙，日华偏向此中长。\n吟馀林表孤云改，梦觉窗间小雨凉。\n佩玉上趋承斗极，棹歌深入钓沧浪。\n何如潇洒诗书局，不在山林不庙堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"风雨有秋色率然成小诗呈道济长官","author":"孔平仲","text":"学馆人归静若山，久阴梅湿上衣冠。\n酣酣雨意牵愁远，飒飒秋声吹梦寒。\n竹笋解包堆屋角，蓼花抽穗出墙端。\n此时最忆吴江上，千顷烟波一钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游田氏池亭","author":"孔平仲","text":"磅礴青山入望长，古城东下见回塘。\n云阴更杂梧桐影，野气仍连菡萏香。\n久处尘埃思浣濯，忽逢虚旷自清凉。\n主人华发能谈笑，犹抚归鞍恨夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中戏梦锡","author":"孔平仲","text":"云横金岭迷驱辙，水溢沂河卷断梁。\n预祝愁霖贯秋序，留君行色到重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄常父","author":"孔平仲","text":"秋风又摇落，历下意何如。\n学馆人归后，山城月上初。\n东西各引领，咫尺但通书。\n难共重阳醉，黄花日向疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白日","author":"孔平仲","text":"白日无所适，况兹秋夜深。\n青灯可自照，缺月强相侵。\n糺缦观时事，崎岖见俗心。\n退藏无乃幸，矍起捧吾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饯梦锡于折柳亭醉中倚柱","author":"孔平仲","text":"折柳亭边柳已衰，送行犹拗最高枝。\n西风黄叶萧萧地，多少伤心为别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杨慎之著作孙正甫推官欧阳甫长官随诏使东来并会斋中","author":"孔平仲","text":"故人得会合，况复有乡闾。\n静失秋天幕，幽忘海上居。\n留连且彻晓，分散即如初。\n笑语同灯火，还思远寄书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经社","author":"孔平仲","text":"经社无甘雨，深秋已肃霜。\n锄犁心最切，牟麦事尤妨。\n比屋何缘饱，天行固不常。\n自吾来此土，连岁见丰穰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熙宁口号 其一","author":"孔平仲","text":"日坐明堂讲太平，时闻深诏下青冥。\n数重遣使询新法，四面兴师剪不庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熙宁口号 其二","author":"孔平仲","text":"万户康宁五谷丰，江淮相接至山东。\n须知锡福由京邑，天子新成太一宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熙宁口号 其三","author":"孔平仲","text":"祇因铜落久纷纷，砥砺廉隅自圣君。\n能使普天无贿赂，此风旷古未尝闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熙宁口号 其四","author":"孔平仲","text":"近闻寇盗理戈殳，太府输金入大炉。\n百鍊刚刀斫西夏，万钧强弩射单于。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熙宁口号 其五","author":"孔平仲","text":"百姓命悬三尺法，千秋谁恤两端情。\n近闻崇尚刑名学，陛下之心乃好生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大风","author":"孔平仲","text":"不雨今已久，北风还起埃。\n声搴海岳动，寒挟雪霜来。\n落羽高千丈，脩筠折几枚。\n未应由虎啸，吾欲讼奔雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新霜","author":"孔平仲","text":"皎皎寒月白，清晨霜满林。\n萌芽至今日，肃杀尔何心。\n入水成冰晕，迷天作雪阴。\n自兹开火阁，却坐小窗深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄常父","author":"孔平仲","text":"海上穷秋白日阴，霜飙猎猎稍相侵。\n手持黄菊江南意，目送征鸿万里心。\n每想清谈真丽瞩，欲弹流水少知音。\n东山兄弟非难继，谁敢先为招隐吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月旦怀梦锡","author":"孔平仲","text":"去岁开炉郡中起，芙蓉幕下醉相邀。\n今年两事俱萧索，白日孤城转寂寥。\n缘饰新茶烹小凤，咨嗟名画展苍雕。\n长篇藁出依然在，千里思君不可招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知郡姚驾部十月三日生日","author":"孔平仲","text":"冰为清洁玉为淳，籍籍名家第一人。\n皂盖已颁东郡政，綵衣犹侍北堂亲。\n遐年此去随长景，和气生来得少春。\n何以献公今日寿，仙山不朽海无津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄板桥卞进之主簿","author":"孔平仲","text":"以才牵挽自由身，岁暮无家寄海滨。\n扰扰满前人一把，纷纷趋事抱千钧。\n风掀驼岛波声壮，云倚蓬山雪意新。\n回首高城已摇落，菊花羞逼小阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"步日","author":"孔平仲","text":"步日问吾影，汝何为此留。\n天寒岁云暮，地僻海之陬。\n涉世心弥壮，逢人语或收。\n蛟龙得云雨，千丈拔灵湫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄萧虚中","author":"孔平仲","text":"平川掺袂屡星霜，楚尾畿东各一乡。\n安得便风传讯问，只应明月共辉光。\n茅斋夜出犹能记，古观秋吟最不忘。\n近日诗成无和者，思君才俊似青杨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独夜","author":"孔平仲","text":"徘徊想此夜，夜长犹未眠。\n出门还复入，无语月空圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晨雨","author":"孔平仲","text":"经秋久不雨，既雨亦纷纷。\n气入书帷暖，声从屋瓦闻。\n问人疑落霰，出户见行云。\n亭午全开霁，青山远可分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访道济","author":"孔平仲","text":"出门已晚鼓，访客傍西城。\n无事诗书局，相过僚友情。\n风来稍尘暗，日落更寒生。\n归路逢灯火，喧喧马屡惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月夜","author":"孔平仲","text":"出户怜清影，循除拥敝裘。\n霜寒方午夜，月色似中秋。\n丹桂何常有，姮娥为我留。\n竹阴如壁画，更助眼前幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄常父","author":"孔平仲","text":"台州与京邑，中有泰山阴。\n谁谓三隅远，长分一寸心。\n南陔戒已旧，棠棣兴尤深。\n思作团圆计，囊无买舍金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再用前意","author":"孔平仲","text":"台州云海阔，梁苑雪天低。\n地隔书来少，心分梦去迷。\n惟兄最邻近，同路隔东西。\n常欲投簪笏，相招傍虎溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中","author":"孔平仲","text":"江南梅已熟，塞北杏初黄。\n飒飒连朝雨，萧萧满眼凉。\n海山阴不断，节物意何长。\n坐想萧滩景，烟波对渺茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"试墨","author":"孔平仲","text":"长夏人虽厌，兹晨物所遭。\n鸣蜩抱枝急，新燕出巢高。\n衣葛宁嫌薄，驱蚊亦惮劳。\n时时得一雨，蒸湿地生毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有感时梦锡寻医而思求免官","author":"孔平仲","text":"去岁城门坐彻晚，前年火阁饭连宵。\n当时已是嫌羁束，今日那堪转寂寥。\n绿水红莲非旧客，清风明月想同寮。\n不知比我离高密，谁向长亭折柳条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久雨","author":"孔平仲","text":"一日三日雨，雨中有青天。\n未能舒叆叇，何苦弄潺湲。\n卷海长风里，倾河白日边。\n泥鸣万丸跃，瓦破百绳穿。\n鸟雀深依舍，蛟龙痛着鞭。\n醉阴昏翠巘，走浊乱青川。\n急洒随奔电，馀霏倚断烟。\n兴居愁湿热，行步阻流泉。\n闵仆衣为障，看儿板作船。\n稍移茶近火，更使带添绵。\n僻陋无人迹，幽閒足昼眠。\n梦回闻点滴，垂晚兴萧然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬聂察推","author":"孔平仲","text":"昔年随宦在筠阳，总角频趋数仞墙。\n绿水近经王俭府，锦衣今见买臣乡。\n能谈旧事情何厚，忽枉新诗味更长。\n闾里优游正多暇，幸君时访读书堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"食冰","author":"孔平仲","text":"又见颁冰出，曾看白雪收。\n清辉分积玉，爽气忽高秋。\n尽室虽同享，吾亲独异州。\n淮南地卑湿，安得代兰羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郡聚","author":"孔平仲","text":"促坐留宾醉，传呼放晚衙。\n门庭少公事，节物正秋华。\n斋酿新篘美，官奴远望佳。\n归时虽落月，银蜡照红纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈宗圣县丞往登州问有所干以此托之","author":"孔平仲","text":"北望登州匹马驰，驼裘孤扇任风吹。\n才闻使者方相委，事属公家不敢辞。\n聚落萧条宿山县，波涛浩荡瞰天池。\n烦君一上蓬莱阁，归说扶桑日出时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郡集","author":"孔平仲","text":"旋彻银杯泛海螺，故人相遇乐如何。\n东西合作双双舞，工拙分为一一歌。\n吹角共惊冬晷短，添炉更觉晚寒多。\n不须苦鍊登州语，大抵东音唯与阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送段从道司户","author":"孔平仲","text":"扰扰东来又西去，风霜匽薄不胜劳。\n请君饮马沂河上，徐看家山万叠高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早阴","author":"孔平仲","text":"青女随明月，来时夜已深。\n霜花结不就，散作海天阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓目","author":"孔平仲","text":"倏此年华晚，萧然学馆幽。\n常閒心却闷，极静景多愁。\n叶走堂阶响，云依殿吻浮。\n黄茅日西下，戏犬在城头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初雪即霁","author":"孔平仲","text":"纷纷千里暗，雪下海边城。\n方与冬为瑞，如何晚即晴。\n竹枝微觉重，瓦口未能平。\n深夜庭前看，尤添月色清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜观残雪","author":"孔平仲","text":"墙阴留得雪斓斑，有客更深独自看。\n江上落梅人不扫，山头明月夜初寒。\n清心直与神仙比，好景只应图画难。\n宇宙之中无一物，碧天如水静漫漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬至日作","author":"孔平仲","text":"今宵当月满，此日又阳生。\n明净乾坤气，欢和井邑声。\n年年对佳节，处处乐升平。\n遥想京师盛，新宫太一迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小酌","author":"孔平仲","text":"落日山城晚，黄云雪意浓。\n更须开一瓮，频醉送残冬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪意遽解","author":"孔平仲","text":"向晚黄云天为低，卷帘注目雪花飞。\n谁知夜半阴晴别，皎皎庭前寒月辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题老杜集","author":"孔平仲","text":"七月鸱鸮乃至此，语言闳大复瑰奇。\n直侔造物并包体，不作诸家细碎诗。\n吏部徒能叹光燄，翰林何敢望藩篱。\n读罢还看有馀味，令人心服是吾师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻登莱大雪","author":"孔平仲","text":"闻说登莱雪一尺，此中晴色更无云。\n安得北风从海上，满天吹过玉纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"集于昌龄之舍","author":"孔平仲","text":"一醉昏昏万不知，黄昏促席夜深归。\n明朝惟见家人说，昨夜归时雪满衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"随倅入京师答同列赠别","author":"孔平仲","text":"挥鞭西指凤凰城，疏野之心无所营。\n预约牡丹花下酒，归时节物近清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"途中口占","author":"孔平仲","text":"两岁东州不自知，人情全在欲分时。\n饯行连日侵银烛，送别临岐驻玉羁。\n望见蒙山思马耳，路经沂水忆河淇。\n归来定得从容否，寄语庭前红药枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"省谒有日","author":"孔平仲","text":"捧檄欣然喜可知，轻裘浅?去如飞。\n亲庭一别今三载，即得从容戏綵衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"不雨","author":"孔平仲","text":"雨意竟寥寂，浮云如涌泉。\n商羊空自舞，霹雳谩加鞭。\n溽暑烦挥箑，荒湾久住船。\n何时出污浊，洗闷向清川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昔时","author":"孔平仲","text":"昔时过此心何如，今时过此心何须。\n回波为我将双泪，逆上三江转五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏芦","author":"孔平仲","text":"地近长芦芦已深，舟行两岸蔚森森。\n能藏蛇虺连山涧，强庇蛙蟆接水阴。\n疑汝此中无劲节，使吾终日隔遥岑。\n春风暑雨多情思，霜霰峥嵘想不禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郭公","author":"孔平仲","text":"枉渚潮初落，平冈日又西。\n芦丛深处泊，惟有郭公啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"芙蓉堂","author":"孔平仲","text":"芙蓉堂下花如锦，记得当年此泊舟。\n今日重来皆蔓草，水红无数强排秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"弄水亭","author":"孔平仲","text":"弄水垂吾手，圆波触石堤。\n夜深翻斗极，秋霁把虹蜺。\n鸟泛閒相得，烟生望稍迷。\n问源思杖策，人指白云西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵屯寺","author":"孔平仲","text":"崎岖自牛径，潇洒得僧房。\n坏壁题名满，幽轩背日凉。\n涧花时委地，邻竹稍过墙。\n归路风犹紧，垂杨作意狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"扬子道中寄陈君佐 其一","author":"孔平仲","text":"别我如不忍，念君方索居。\n萧然对松竹，独自理图书。\n击钵诗无敌，连环辩有馀。\n骅骝志万里，那久困盐车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"扬子道中寄陈君佐 其二","author":"孔平仲","text":"会合未云久，笑言今苦赊。\n山空愁夜鹤，野阔沸春蛙。\n雨涨新波满，烟昏故垒遮。\n输君官守佚，吟遍郡园花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天长道中","author":"孔平仲","text":"柔桑满野麦成川，晴色连陂雨在田。\n顾影寂寥谁与语，据鞍閒暇不妨眠。\n尘劳可厌非今日，老大无堪异昔年。\n此去聊为上都客，行当货马觅归船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至盱眙作","author":"孔平仲","text":"邮亭系马日西斜，却向盱眙望白沙。\n春色淡中唯有柳，晓风狂过已无花。\n古人出处真难一，吾道穷通未可涯。\n白水黄粱不须具，呼奴挈榼取流霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓目","author":"孔平仲","text":"枝上馀花脱尽红，行人驱马绿阴中。\n青春裁剪应辛苦，不奈东南一夜风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"汴上行","author":"孔平仲","text":"芳草连坡挂柳绵，春风卷地落榆钱。\n时光解与行人别，若有离情应泫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"发青阳驿","author":"孔平仲","text":"悠悠驱马汴河湾，几处邮亭略解鞍。\n春尽榆钱堆狭路，晓阴花雨作轻寒。\n山川相背图中画，日月双移坂上丸。\n行役渐多身渐老，诗题聊寄旅程难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"发灵驿作","author":"孔平仲","text":"晨装独入古河堤，杜宇无端向客啼。\n昨夜东风吹猛雨，绿阴遮合不成泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"河亭独酌寄林次中","author":"孔平仲","text":"沙岸朝来雨乍晴，东风舒卷柳条轻。\n消愁亦有旗亭酒，谁与当樽唱渭城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶书","author":"孔平仲","text":"季子悬头思赵国，越王尝胆望吴城。\n少年莫念纷华事，功业多从辛苦生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入亳州界","author":"孔平仲","text":"赢粮襆被望都门，路出符离日未醺。\n清汴横飞天上浪，方塘稳锁镜中云。\n淮南风物多相似，江上音书久不闻。\n寄语北山姑待我，莫因西去勒移文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]