[{"title":"野庵分题 笔架","author":"史浩","text":"四友文房相与俱，管城偏是一豪儒。\n自从乞得珊瑚枕，还有周公梦也无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16389,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野庵分题 柳阴","author":"史浩","text":"始惊妩媚作眉颦，又见青葱锁暮春。\n几度夕阳穿小院，密藏多少卖花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16390,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野庵分题 墨香","author":"史浩","text":"万突长然古涧松，远烟收拾藉良工。\n胶媒酿出真消息，付与毛锥立俊功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16391,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野庵分题 茶香","author":"史浩","text":"灵芽雨后发幽丛，剩馥先令鼻观通。\n战退睡魔三百万，枪旗果解立奇功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16392,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野庵分题 柳色","author":"史浩","text":"何处朱门窈窕深，萧然一径绿成阴。\n回眸却笑阳关道，匹马区区走到今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16393,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵张汉卿","author":"史浩","text":"钓竿方欲展丝纶，独向山房访可人。\n但觉烟霞随步武，不知身已在三神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16394,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又次韵汉卿 其一","author":"史浩","text":"本是飘然不系船，迩来清兴为梅牵。\n小春枝上含珠颗，蜡屐还须破晚烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16395,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又次韵汉卿 其二","author":"史浩","text":"利锁名缰此幻身，故园一别五经春。\n而今乞得归来后，夜鹤朝猿不怨人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16396,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵汉卿谩赋","author":"史浩","text":"夫君胸次炯冰壶，坐受沧溟万壑输。\n付与笔端为雨露，九天神物夜惊呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16397,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏閒","author":"史浩","text":"幽蹊亲见花苞拆，静室频看香篆移。\n莫道閒中无事业，此般消息有谁知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16398,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还乡后十月作 其一","author":"史浩","text":"后园三径欲重开，一曲新从君赐来。\n有愧莱公勋业盛，平生无地起楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16399,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还乡后十月作 其二","author":"史浩","text":"乞得閒身正首丘，朝猿夜鹤怨皆休。\n静观心地浑无事，祇有君王恩未酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16400,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还乡后十月作 其三","author":"史浩","text":"钟鼓园林无尽乐，交游息绝到春閒。\n予今方寸无偏系，似处陶裴季孟间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16401,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑郎中作四明谢遗尘九题走笔不二 其一 石窗","author":"史浩","text":"峻极生从地势坤，擎天一柱四窗存。\n有时空洞来龙驾，列岳灵祇尽骏奔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16402,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑郎中作四明谢遗尘九题走笔不二 其二 过云","author":"史浩","text":"苍苍廿里籍仙踪，出岫无心瑞霭浓。\n南北往来蹊径熟，故应环佩日相从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16403,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑郎中作四明谢遗尘九题走笔不二 其三 云南","author":"史浩","text":"向阳一麓与天齐，鸡犬遥闻只隔溪。\n俗客未应容易到，是间唯许羽人栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16404,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑郎中作四明谢遗尘九题走笔不二 其四 云北","author":"史浩","text":"云北人言是北溟，脩鳞可驾上金庭。\n高风已得扶摇便，聊向虚窗聚德星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16405,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑郎中作四明谢遗尘九题走笔不二 其五 鹿亭","author":"史浩","text":"谁将此物命危亭，漏泄知因甫里生。\n渴饮云浆饥沆瀣，笑渠凡质食蒿萍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16406,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑郎中作四明谢遗尘九题走笔不二 其六 樊榭","author":"史浩","text":"从来此地隔凡尘，多是嬴秦避世人。\n檐外饱闻丹凤味，阶前更看舞麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16407,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑郎中作四明谢遗尘九题走笔不二 其七 潺湲洞","author":"史浩","text":"金作栏干玉作塘，莲漪一派注仙乡。\n涓涓波及人间世，雪窦山前白练长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16408,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑郎中作四明谢遗尘九题走笔不二 其八 青棂子","author":"史浩","text":"羽幰新从帝所回，馀欢未尽玳筵开。\n醉抛青子香泥上，留与王家取次栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵郑郎中作四明谢遗尘九题走笔不二 其九 鞠侯","author":"史浩","text":"乌鞠攀缘日往还，人间仰视在天端。\n如今蕙帐休惊晓，林下衰翁已挂冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又一绝","author":"史浩","text":"能比桃源去路迷，洞天乞得在湖西。\n南雷九咏增光甚，多谢雄篇再品题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用文叔州字韵和飓风诗","author":"史浩","text":"西帝风行杀气秋，丘陵草木尽虔刘。\n要令地轴平如掌，混一车书四百州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和竹里","author":"史浩","text":"霜筠万个绕云根，中作茅檐据水村。\n疏处只容猿鹤过，了无俗客敢登门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和夜直","author":"史浩","text":"金莲双烛渐烧残，青琐珑璁月影寒。\n五色丝纶朝入奏，天街花露已阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和杨柳","author":"史浩","text":"绿衣濯濯红妆靓，春半园林露未晞。\n正似佳人与才子，倚窗深处淡相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和钟山晚步","author":"史浩","text":"幽溪细雨落轻花，无限舂锄立岸沙。\n苦竹黄芦迷望眼，孤烟起处是人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和道傍大松人取以为明","author":"史浩","text":"夭矫龙鳞众欲攀，肯随蒿艾老空山。\n便教不受栋梁用，犹作光明满世间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和同熊伯通自定林过悟真","author":"史浩","text":"欲寻云屋煮新茶，领客行寻一径斜。\n遐想当时挂纱帽，笑看碗面白浮花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和城北","author":"史浩","text":"春温初褪鹤绫袍，已觉东风绽小桃。\n支策城阴无限景，秦淮波阔蒋山高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和答东流顿令罢官阻风","author":"史浩","text":"解印今朝去有期，何须更勒北山移。\n了知风伯恳留意，正是攀辕卧辙时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和斜径","author":"史浩","text":"风拂繁阴开曲径，云移寸碧出遥岑。\n柳枝濯濯嫌烟淡，荷叶田田怯水深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和雨晴","author":"史浩","text":"不管狂风横雨催，小园日日有花开。\n群仙恐湿凌波袜，戏蹴香红衬绿苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和乌石","author":"史浩","text":"梅花一径万重山，冈外浮云去住间。\n莫恨寻幽无侣伴，世途能有几人閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和乌塘","author":"史浩","text":"云绕青山水绕堤，游人陌上手同携。\n遗簪坠珥欢方洽，只恐楼头日欲西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和奉和严公军城早秋","author":"史浩","text":"金飙猎猎受降旌，虎帐累累细柳营。\n坐屈遐荒三百万，何须掠地与屠城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和从韦明府觅绵竹","author":"史浩","text":"县以竹名佳致在，令君节与竹俱高。\n何妨乞取千竿翠，月影翻风似碧涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16426,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和杜中书九日","author":"史浩","text":"佳人通夕赏重阳，醉尽楼边白玉缸。\n莫遣飞霜到丛菊，恐惊宿蝶去双双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16427,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和春晚题韦家亭子","author":"史浩","text":"马蹄轻蹙落花香，三月芳菲堕渺茫。\n正好留春开雅宴，危亭群幕已高张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16428,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和朱坡绝句","author":"史浩","text":"芳华三月只些儿，生怕春林鸟唤归。\n寄与东君须久住，勿容一片落花飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16429,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和重送国棋王逢","author":"史浩","text":"前身应是奕秋徒，自谓人间敌手无。\n君去尚留边角势，为君题作烂柯图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16430,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和题水口草市","author":"史浩","text":"饭裹绿荷朝趁市，香浮青瓮晚登楼。\n凭谁写入鹅溪绢，一簇人烟古渡头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16431,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和泊秦淮","author":"史浩","text":"一叶轻舠倚岸沙，沙边灯火几人家。\n夜来江阔天无际，唯见银蟾辊浪花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16432,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即席赋木芙蓉","author":"史浩","text":"盈盈伫立傲秋霜，露染胭脂作靓妆。\n正似瑶池见金母，醉归未脱绿云裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16433,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"弥坚小圃小春见梅","author":"史浩","text":"孤根十月已先温，不待青春入烧痕。\n冷艳一枝何处看，竹边池阁水边村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16434,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"棠阴得明字","author":"史浩","text":"蔽芾甘棠绕讼庭，日高碎影更纵横。\n直教憩处无人迹，始信康公教化明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16435,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"砚纹得明字","author":"史浩","text":"歙水端溪各擅名，刷丝鸲鹆眼分明。\n不因守黑谈玄辈，奇璞缘何见管城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16436,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瓜州渡头六言","author":"史浩","text":"竹叶舟中渔父，瓜州渡口人家。\n占得烟波活计，全胜富贵生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16437,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饯徽州李守 其一","author":"史浩","text":"当年仗策扣军戏，已有昌言简帝知。\n目见飞龙升白水，手扶赫日上咸池。\n飘萍一世其如命，剖竹专城会得时。\n三十六峰方秀发，可无佳致付新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16438,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饯徽州李守 其二","author":"史浩","text":"九重翔凤舞丝纶，圣主临朝见故人。\n德友再生洙水上，客星今起钓台滨。\n紫荷欲待明光晓，红旆先行泽国春。\n祖帐岂须怀别思，来年马首向城闉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16439,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周祭酒所和馆中雪诗 其一","author":"史浩","text":"不作当年行路难，平明下马趋朝班。\n欢声渐入玉连锁，瑞气先凝金博山。\n曾说岁穰占腊里，更传天喜见颜间。\n归来乞与新诗句，清绝何人许共攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16440,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周祭酒所和馆中雪诗 其二","author":"史浩","text":"造化工夫正不难，幻成梅柳已班班。\n清吟且可对冰柱，烂醉未应颓玉山。\n鹤冷风亭来砌下，雁迷烟渚驻云间。\n不移跬步居银阙，仙驭何劳著手攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16441,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周祭酒所和馆中雪诗 其三","author":"史浩","text":"风急何辞上阁难，且来共住玉京班。\n一蓑已得诗中画，万叠休传海外山。\n未放微阳穿日脚，少留清影在窗间。\n莫嗔爱入西湖社，夫子龙鳞正许攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16442,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花借喜雪韵 其一","author":"史浩","text":"老去风光报答难，树头春律喜新班。\n忽惊断岸一番雪，便忆故园千叠山。\n斜日淡烟茅舍外，冷香幽韵竹篱间。\n玉壶虚佐寒窗静，不敢呼童取次攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16443,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花借喜雪韵 其二","author":"史浩","text":"看花容易咏花难，自古何人立首班。\n东阁五言还水部，西湖一径指孤山。\n度墙野月黄昏后，啄雪幽禽去住间。\n冷定识渠真面目，从兹桃李不须攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16444,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花借喜雪韵 其三","author":"史浩","text":"谩取山樊作二难，祇今风味若为班。\n斜窥浅碧洛神赋，瘦怯轻寒姑射山。\n小辍殊杯清影下，竞留新绝翠微间。\n枝边青子垂垂出，金鼎成时试一攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16445,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵刘国正再赋","author":"史浩","text":"去腊寻幽良独难，杖藜何处见斓斑。\n江村篱落雪晴路，水月池台春近山。\n纸帐朦胧来醉里，人家依约在林间。\n西湖处士君今是，月晓多应独自攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16446,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵何国博春日隔年","author":"史浩","text":"嶰琯灰飞又一年，綵幡聊复映皤然。\n香催元日椒花酒，星点千家爆竹烟。\n未分风光销老里，拟追欢赏到春边。\n凭谁为向东君说，莫遣寒英趁野泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16447,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"少卿杨公雅喜士左举善又东南之秀假楼居为丹壶以济人既谢以诗因出示辄次其韵","author":"史浩","text":"烟柳葱葱锁玉栏，楼头伟观熟窥斑。\n不因置酒垂青目，安得开窗面北山。\n尘市故知容隐者，声名无奈落人间。\n胸中剩有安民术，且把丹壶与驻颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16448,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和普安郡王桂子","author":"史浩","text":"嫦娥屑玉酝旃檀，乞与人间秋后看。\n已向水边吟月晓，却来花下立更残。\n西风把酒休催菊，南国行歌不赋兰。\n何必秾香千万斛，鼻端须此百忧宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16449,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送任秘监龙图知洪府","author":"史浩","text":"夫子胸中万顷宽，照人英采玉峰寒。\n难蟠凛凛虹蜺气，易舍峨峨獬豸冠。\n秋在石渠同过雁，春回江渚却鸣鸾。\n由来内外俱行道，达者何曾异辙看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16450,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代恩平郡王赋董氏园亭","author":"史浩","text":"怪底王生愿卜邻，岩前有月对颐真。\n夜深清影频侵户，日永虚堂不著尘。\n能向个中参妙旨，却于忙里作閒身。\n朝回试解黄金带，即是毗耶彼上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16451,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵任龙图留别","author":"史浩","text":"挂席桅樯倚数寻，小风吹饱思难禁。\n三千奏牍曾医国，十万兵屯已属心。\n江路疏梅春意近，楚天孤鹜晓烟沈。\n是中秀句应无限，著眼归鸿迟好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16452,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上普安郡王生辰 其一","author":"史浩","text":"朔风吹律酝霜严，帝遣神仙下斗南。\n阙月溯弦金作缕，非烟效瑞锦成岚。\n平生漫吹欣相遇，一瓣浓薰已遍参。\n欲向今朝伸善颂，世间唯有达尊三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16453,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上普安郡王生辰 其二","author":"史浩","text":"银潢双派毓诸昆，始信閒平不足论。\n画戟森严韬虎豹，玉阶芬馥蔼兰荪。\n明光殿下纡莱服，命衮丛中上寿樽。\n长立首班扶帝社，是为天下爵之尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16454,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上普安郡王生辰 其三","author":"史浩","text":"寿乡日月缓征辕，箕翼光芒万古存。\n龟上碧莲波荡漾，鹤归华表影翩翻。\n笑看曼倩三偷果，坐阅刘晨七世孙。\n绿发扶疏受修日，是为天下齿之尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16455,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上普安郡王生辰 其四","author":"史浩","text":"堂堂玉立冠宗藩，中有澄波挠不浑。\n彩笔英辞追电影，黄钟和气散春温。\n不言自是行天运，独智何妨入圣门。\n忠孝一心唯戴主，是为天下德之尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16456,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵林寺簿立冬日斋祠精进寺","author":"史浩","text":"篮舆忽得到林间，飞鸟翩翩相与还。\n俎豆欲严来日祭，轩窗聊共此时閒。\n芬敷残菊添秋色，摇落苍梧见远山。\n夫子肝肠真锦绣，归途新句已班班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16457,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王龟龄校书梅花 其一","author":"史浩","text":"底处冲寒欲放梅，柴门雪压为伊开。\n酸风不管攲纱帽，冷艳终朝粲玉杯。\n尚觉西湖三径远，先吹东阁五言来。\n一枝入眼君须惜，莫遣高楼怨笛催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16458,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王龟龄校书梅花 其二","author":"史浩","text":"朔风吹雪障江梅，不著诗攻不解开。\n正恐与花无半面，胡然有意及三杯。\n清凉怕逐炎炎去，澹泊曾参的的来。\n祇向茅檐露消息，华堂虚费管弦催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16459,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠杨都运持节夔路","author":"史浩","text":"帝城祖帐溢千夫，又遣星轺下蜀都。\n春昼预知看衣锦，秋风可但为思鲈。\n北方泉货须留地，他日车轮剩结蒲。\n万里未应怀别恨，与君元不隔江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":16460,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]