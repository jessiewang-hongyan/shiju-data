[{"title":"送秘书刘监归嵩阳隐居 其一","author":"文彦博","text":"昔年宝应茅斋主，别后炎凉已屡经。\n暂入城来缘买药，却骑牛去似飘萍。\n缑山重访吹笙伴，秘省长虚画鹤厅。\n一任洛阳人白眼，且看三十六峰青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送秘书刘监归嵩阳隐居 其二","author":"文彦博","text":"四明畴昔称狂客，二室于今号散仙。\n子晋料登缑岭望，待君笙鹤共升天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和副枢吴谏议寄题广化寺东轩","author":"文彦博","text":"净居高出四禅天，更对伊嵩辟广轩。\n塔耸千花依鹫岭，舟浮一叶上龙门。\n云藏古木当危槛，风递疏钟过远村。\n我有草堂南涧口，一回西望一销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伏睹致政太傅侍郎答枢密谏议留题斋阁诗依韵和呈 其一","author":"文彦博","text":"三朝光辅仰耆年，谢政归来作散仙。\n筑室尚依双凤阙，放怀何必五湖船。\n清谈倾座簪缨盛，綵服趋庭子舍贤。\n公伴赤松应念我，早教西去老伊川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伏睹致政太傅侍郎答枢密谏议留题斋阁诗依韵和呈 其二","author":"文彦博","text":"华颠相顾最相亲，同是三朝二府人。\n曾忝政堂陪大论，又叨枢筦继清尘。\n我惭蒲柳衰残质，公称夔龙强健身。\n把酒观言兼恋德，春晖不觉渐西沦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中枢密蔡谏议借示范宽雪景图","author":"文彦博","text":"梁园深雪里，更看范宽山。\n迥出关荆上，如游嵩少间。\n云愁万木老，渔罢一蓑还。\n此景堪延客，拥炉倾小蛮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和副枢蔡谏议植山芋","author":"文彦博","text":"平台山芋传区种，久饵能令玉寿延。\n欲长深根培客土，便期珍味荐宾筵。\n吴莼顿觉名称减，楚芰须惭嗜好偏。\n况是丹头推绝品，百金供费亦宜然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"窃知今日于家园种山芋辄成拙诗奉呈副枢谏议","author":"文彦博","text":"闻说家完乐，仍携山芋来。\n何烦心助长，惟喜手亲栽。\n若务丰根本，应须薙草莱。\n迎知冬荐味，决不减平台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和副枢蔡谏议赠副枢吴谏议谢惠新宅杂花之什","author":"文彦博","text":"百卉千花淑景新，主人吟啸惜芳辰。\n依依绿减随堤色，灼灼红移洛浦春。\n已爱清香飘宴席，更分秾艳与交亲。\n邹阳本是梁园客，醉赏犹思濉水滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新酿酴醾酒送吴蔡二副枢","author":"文彦博","text":"此花犹未发，此酒已先香。\n独有甘芹意，开樽略为尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和副枢蔡谏议孟夏旦日右府书事","author":"文彦博","text":"杲日无亏彰睿圣，前星有庆耀东朝。\n皇明烛远群羌服，火德乘时众慝消。\n丹扆焦荣犹损膳，华颠尸素合归樵。\n夔牙共奏康哉□，雅咏和声彻九霄。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"去春蒙西都致政李少师惠诗五首追叙旧游因而招隐某尚羁枢务请退未谐深味来章未知所答迁延宿留遂涉岁时今蒙圣慈俯从人欲听解重柄均逸便藩仰西河之上游瞻仁宅之实迩即当胥会弥积欣怡辄成小诗三章代书见意且答去春之赐","author":"文彦博","text":"新诗五首缘招隐，未得西归未敢酬。\n今许均劳解枢柄，期君同伴赤松游。\n伊西古寺茅庵静，不到经今八九春。\n岩谷定知云水冷，宫师常作独游人。\n斗薮缁尘捋白髭，缄书先去问宫师。\n仙舟东下能相访，同上平嵩把酒卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过鲁太师庙作","author":"文彦博","text":"墨绶前朝宰，桑郊郑圃东。\n丛祠临大道，遗烈凛清风。\n顾我才尤薄，与君时不同。\n历官无一异，得位亦三公。\n屑屑刑名内，区区薄领中。\n循良谁复道，贪刻自为功。\n哲后方勤治，愚臣合尽忠。\n承流奉宽大，宣泽务庞鸿。\n此意缘思古，何人为发蒙。\n神交傥来鉴，潜愿启其衷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再到积庆坟庄即事偶成 其一","author":"文彦博","text":"不到伊川八九年，重来风物尽依然。\n惊回俗梦鸣皋鹤，洗净尘襟漱玉泉。\n绿筱侵阶当蕙帐，苍霞满目对松阡。\n天怜老懒优深处，罢听晨鸡彻晓眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再到积庆坟庄即事偶成 其二","author":"文彦博","text":"郊园乍适疏慵意，勉强逢迎已不能。\n赤米白盐充野馔，蕉衫芒蹻见山僧。\n含风古木遮檐角，漱玉清泉泻石棱。\n田父相过复相劝，早归林下醉腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东溪泛舟","author":"文彦博","text":"东溪伊水东，溪水丘溶溶。\n两桨夷犹去，双凫上下逢。\n馀波通洛浦，倒影浸嵩峰。\n荷动闻鱼跃，沙平见鹤踪。\n岛蒲森剑戟，岸柳亚虬龙。\n并载惟禅客，随观有牧童。\n风传棹讴远，露湿钓蓑浓。\n不是迷津处，何烦问老农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游楚谏议园宅呈留守宣徽留台端明","author":"文彦博","text":"五里依仁宅，西邻数仞墙。\n主人为屏翰，园吏占风光。\n地胜金瓯小，林深锦襻长。\n轻烟罩丛桂，幽鸟入脩篁。\n藓色沿茶灶，松阴覆石床。\n一区诚可乐，三径莫令荒。\n有木皆交荫，无花不并芳。\n相期挂冠后，同此事琴觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游史馆张大卿致政李少卿史馆傅兵部济上郊园","author":"文彦博","text":"畴昔常闻处士庄，林泉胜景甲山阳。\n一渠寒水流清济，千仞浓岚耸太行。\n枋口云归穿古木，燕川风过入脩篁。\n前贤旧业何人继，分与三贤作醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题龙潭寺","author":"文彦博","text":"古寺依青障，高轩俯碧潭。\n山僧如有待，先扫侍中庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒济祠作","author":"文彦博","text":"导沇灵源祀典尊，湛然凝碧浸云根。\n远潮沧海殊无碍，横贯洪河自不浑。\n一派平流滋稼穑，四时精享荐萍蘩。\n未尝轻作风涛险，惟有涵濡及物恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登平崧阁右崧亭作","author":"文彦博","text":"不较平崧与右崧，大都亭阁尽穹崇。\n太行太室当前后，俱是山家入望中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游碧涟堂偶作寄致政司空相公聊布所怀","author":"文彦博","text":"公以心如水，开轩俯碧涟。\n尝虚济川楫，却就钓璜渊。\n北倚平崧阁，南临种黍田。\n缘经冶城望，到此即怀贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗寄相州侍中韩魏公","author":"文彦博","text":"鼎邑从来事足誇，冰台近岁景尤嘉。\n天平峰秀堪图画，昼锦堂高可宴衙。\n新表门闾通德里，旧栽桃李相君家。\n仍闻降志相希慕，林下时乘洛样车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗寄西都致政司空相公","author":"文彦博","text":"燕居堂北虚闲地，藜藿森森欲柱天。\n中有红梨最翘秀，削成鸠杖佐衰年。\n初同野叟甘芹味，终学狂翁挂酒钱。\n分寄一枝公必讶，提携不称葛陂仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗寄答致政司空相公","author":"文彦博","text":"众卉群芳品自奇，遍形歌咏殆无遗。\n名过卫国平泉记，数协江淹杂体诗。\n苏颋祗誇长乐赋，元舆惟咤牡丹词。\n岂知哲匠风骚美，不间鸿纤尽物宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知郡傅学士将赴彭门蒙贶佳什次韵奉答","author":"文彦博","text":"史局郎曹得俊贤，稔闻高誉已多年。\n山阳松菊抛三径，泗水衣冠戴二天。\n合作商霖光祖构，犹持汉节滞英躔。\n河梁欲上难轻别，亦望迟迟驻曲旃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"致政仲损张工部询及孟酝之味因寄数器副以小诗","author":"文彦博","text":"醽渌如渑味似饴，朝回何必典春衣。\n序宾留饮觞无算，速父供甘羜更肥。\n不惜郫筒令远寄，惟忧辽豕得深讥。\n小家曲糵君谙在，莫使邯郸枉见围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西都留守宣徽祈谢嵩祠往还敝庄因成雅章为贶谨次严韵 其一","author":"文彦博","text":"腊雪应祈沾下土，府公遵命祀中天。\n定陪仙驭经缑岭，应访禅林过玉泉。\n和气随风生二室，欢谣继日满三川。\n悠悠大旆累累印，却爱苏家负郭田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西都留守宣徽祈谢嵩祠往还敝庄因成雅章为贶谨次严韵 其二","author":"文彦博","text":"若比扬雄多一廛，仅同徐勉葺东田。\n沟塍万亩言之过，却恐增添助役钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"前朔宪孔嗣宗太博过孟云近于洛下结穷九老会凡职事稍重生事稍丰者不得与焉其宴集之式率称其名其事诚可嘉尚其语多资嗢噱因作小诗以纪之亦以见河南士人有名教之乐简贪薄之风辄录呈留守宣徽聊资解颐","author":"文彦博","text":"洛城冠盖敦名教，任是清贫节转高。\n见说近添穷九老，从初便不要山涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢留守王宣徽寄花","author":"文彦博","text":"远惠奇花自洛城，吟观醉赏动乡情。\n开编读到安仁传，方信河阳浪得名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和","author":"文彦博","text":"惟有陈园接府城，池塘花竹可娱情。\n虽然不及芙蓉萼，犹得河桥史馆名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗谢留守王宣徽远惠牡丹","author":"文彦博","text":"姚黄左紫状元红，打剥栽培久用功。\n采折乍经微雨后，缄封仍在小奁中。\n勤勤赏玩倾兰醑，漠漠馨香逐蕙风。\n犹恐花心怀旧土，戴时频与望青嵩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熙宁癸丑季冬十有三日某被旨谢雪于济祠已事与秘书监光禄卿直史馆太常少卿屯田郎中秘书丞同游枋口泛舟沁水至岘石而登岸历观岩谷间前贤之题名翌日游化成寺以车渡沁回入盘谷穷览山水之嘉处由燕川而归 枋口作","author":"文彦博","text":"下马入枋口，漾舟缘碧溪。\n雪消山骨瘦，风定浪头低。\n数里复登岸，群贤俱杖藜。\n徘徊岩石畔，寻觅退之题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熙宁癸丑季冬十有三日某被旨谢雪于济祠已事与秘书监光禄卿直史馆太常少卿屯田郎中秘书丞同游枋口泛舟沁水至岘石而登岸历观岩谷间前贤之题名翌日游化成寺以车渡沁回入盘谷穷览山水之嘉处由燕川而归 化成寺作唐裴相之山墅舍为寺","author":"文彦博","text":"昔览传心法，知公素学禅。\n今游化成寺，使我复思贤。\n大舍倾高产，多生结胜缘。\n人琴虽已矣，松菊尚依然。\n宝地侵苍藓，巍峰柱碧天。\n撮衣书久失，砻石像犹全。\n境寂遗尘虑，僧闲足昼眠。\n欲归情恋恋，缓辔出燕川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熙宁癸丑季冬十有三日某被旨谢雪于济祠已事与秘书监光禄卿直史馆太常少卿屯田郎中秘书丞同游枋口泛舟沁水至岘石而登岸历观岩谷间前贤之题名翌日游化成寺以车渡沁回入盘谷穷览山水之嘉处由燕川而归 过燕川渡","author":"文彦博","text":"早过燕川渡，千峰插太虚。\n云开微见日，水浅不渐车。\n风急樵歌响，霜严木叶疏。\n缘溪东北去，岩腹有精庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熙宁癸丑季冬十有三日某被旨谢雪于济祠已事与秘书监光禄卿直史馆太常少卿屯田郎中秘书丞同游枋口泛舟沁水至岘石而登岸历观岩谷间前贤之题名翌日游化成寺以车渡沁回入盘谷穷览山水之嘉处由燕川而归 其一 盘谷作","author":"文彦博","text":"昔有幽栖士，兹焉遂考槃。\n惊眠涧泉响，醒酒谷风寒。\n列岫开窗见，冥鸿倚杖观。\n韩文传已久，合在翠岩刊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熙宁癸丑季冬十有三日某被旨谢雪于济祠已事与秘书监光禄卿直史馆太常少卿屯田郎中秘书丞同游枋口泛舟沁水至岘石而登岸历观岩谷间前贤之题名翌日游化成寺以车渡沁回入盘谷穷览山水之嘉处由燕川而归 其二 盘谷作","author":"文彦博","text":"愿也乖真隐，韩文旨趣深。\n本非逃富贵，岂是爱云林。\n已失豪华望，方萌退缩心。\n归来老穷谷，村叟共浮沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自济源回及中道得通守郎中诗跂羡山水之游以不得陪从为恨因以诗答之","author":"文彦博","text":"奉祀灵源腊雪馀，薄寒风景似春初。\n因寻山下游三日，惟恨樽前欠贰车。\n南望思君回五马，北来遗我得双鱼。\n新诗两首连城贵，百斛骊珠价不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"司空相公特贶雅章俯光陋迹依韵和呈以答厚意","author":"文彦博","text":"一代勋贤孰拟伦，惟公爵德齿俱尊。\n顾惭参鲁辞枢筦，辄继萧规偃辅藩。\n每到碧涟思召茇，时倾绿醑忆曹樽。\n平嵩极目西南望，仁里高闳近鼎门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初泛舟新池观子弟辈作诗因为此示之","author":"文彦博","text":"旧池疏引透新池，转觉澄澜势渺瀰。\n得志鱼虾争跳跃，无根萍梗任推移。\n船头欲过冲桥脚，柳眼初开映水湄。\n借问阿连春草句，何人先把紫毫摛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将赴大名奉寄西都留守王宣徽","author":"文彦博","text":"骤易铜台守，脂车冒蕴隆。\n北行如拾鲁，南望倚平嵩。\n畏日临倾藿，惊飙走断蓬。\n伊流旧亲友，应亦念衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春旱既甚祷祈未应小园即事","author":"文彦博","text":"渴望甘膏苏旱岁，日趋祠庙罄虔祈。\n春风也解相欺罔，鼓扇杨花学雪飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄相州侍中韩魏公","author":"文彦博","text":"晋公名画鲁公书，高出张吴与柳虞。\n幸得魏公挥宝墨，缘公楷法亦颜徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题韩晋公村田歌舞图后","author":"文彦博","text":"治世舒长日，田家事力苏。\n干戈久不识，箫鼓共为娱。\n浊酒行无算，酡颜倒更扶。\n将求太平象，此是太平图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题辋川图后","author":"文彦博","text":"吾家伊上坞，亦自有椒园。\n漠漠清香远，离离丹实繁。\n盈襜常要采，折柳不须藩。\n每看辋川画，起予商可言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事偶书","author":"文彦博","text":"世道逢消长，人情徇爱憎。\n光华如石火，明灭似风灯。\n巢幕堪忧燕，垂天不羡鹏。\n危心戒行险，视履益兢兢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昨夜饮散未眠偶成拙颂录呈武功寺丞若犹未弃无惜开示","author":"文彦博","text":"以幻能除幻，居尘不染尘。\n略于歌舞地，聊现宰官身。\n有法犹为滞，无心乃是真。\n还将所得趣，试问悟空人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再答","author":"文彦博","text":"说幻缘知幻，言尘为觉尘。\n觉知今亦遣，尘幻岂关身。\n独体方无对，双脩未是真。\n因君祗夜颂，自愧小乘人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"提举刘司封访别将赴滏阳辄成五十六言","author":"文彦博","text":"乞领琳宫作散仙，云情鹤态任天然。\n荣驱轩驭归仁里，恳拜封章解计权。\n尺璧时光须爱惜，寸金乡土且留连。\n铜台事事君誇诧，莫望西山紧著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成小诗赠提举刘司封","author":"文彦博","text":"向上应无快活人，斯言未敢便当仁。\n留君且住非他意，好作熙宁第八春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"家园酴醾自京寄至奉送提举刘司封","author":"文彦博","text":"小圃酴醾烂熳开，盈箱采得寄铜台。\n当花对酒熏然意，似到清香洞里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"提举刘司封监牧张职方咏酴醾诗皆以微文形于善谑辄成累句奉呈聊用解纷 其一","author":"文彦博","text":"蛮笺往复写琼瑰，皆是论都作赋才。\n花本无情亦无语，清香自到邺城来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"提举刘司封监牧张职方咏酴醾诗皆以微文形于善谑辄成累句奉呈聊用解纷 其二","author":"文彦博","text":"已折素华迷雪苑，更将琼艳照冰台。\n刘郎曾入仙源路，又到唐昌观里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招仲通司封府园避暑","author":"文彦博","text":"骑山楼下水轩东，一室初开待白公。\n虽是不如南涧上，都缘却有北窗风。\n衔杯避暑称河朔，飞盖延宾在邺中。\n解榻况逢徐孺子，馈浆如饭与君同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金宿楼望月呈仲通司封 其一","author":"文彦博","text":"满满十分酒，高高百尺楼。\n于兹赏圆月，况乃值仲秋。\n天宇浩无际，露华光欲流。\n西园清夜景，公干不同游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金宿楼望月呈仲通司封 其二","author":"文彦博","text":"缅想建安盛，西园飞盖游。\n初筵会才雅，今夕继风流。\n月伴昏星出，云随晚吹收。\n老生于此兴，不减庾荆州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗赠提举窦侍郎","author":"文彦博","text":"紫髯真将白云卿，总领琳宫道气清。\n蕲竹一林曾断买，青溪三弄得遗声。\n季伦自作思归曲，向秀方深感旧情。\n虽恨功名非谢傅，樽前更欲听君筝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟中别后中夕无寐偶成四十言奉寄中辉大卿聊致黯然之怀","author":"文彦博","text":"五十年亲友，如今两鬓霜。\n相逢在淇澳，所乐似潇湘。\n话旧如春梦，听歌放酒狂。\n压关楼下别，一夕九回肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵谢运使陈虞部生日惠双鹤灵寿杖 其一","author":"文彦博","text":"仙禽寿杖垂佳贶，丽句雕章焕列星。\n深悉至怀形善祷，拟延西景驻颓龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"依韵谢运使陈虞部生日惠双鹤灵寿杖 其二","author":"文彦博","text":"青田双戏九皋鸣，屈降仙姿入户庭。\n宜与衰翁为老伴，雪毛霜鬓共星星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":35738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]