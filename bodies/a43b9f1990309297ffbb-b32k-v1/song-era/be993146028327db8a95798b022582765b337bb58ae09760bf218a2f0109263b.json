[{"title":"放姑恶","author":"喻良能","text":"为怜心折骨仍惊，四十方兄博汝生。\n从此直须防巧中，著身未稳莫先鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74820,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昌园赏梅","author":"喻良能","text":"十年不踏淮安路，今日昌原得纵游。\n千树撩人诗兴动，恰如何逊在扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74821,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松源山","author":"喻良能","text":"征途未尽弋阳西，且过松源九节溪。\n烟雨濛濛山色好，鹧鸪更与尽情啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74822,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"采菊","author":"喻良能","text":"采采黄金蕊，盈盈白玉觞。\n露兰何足饮，自觉肺肝香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74823,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中至上竺","author":"喻良能","text":"云满千山雨满川，肩舆来礼白衣仙。\n山间秋色知多少，总在危檐缭槛前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74824,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨后闻蛙","author":"喻良能","text":"雨过窗虚夜气清，草间何处乱蛙鸣。\n休论公地兼私地，且听萝根呷呷声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74825,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南剑道中","author":"喻良能","text":"桂树青青百里疆，鹧鸪啼彻午阴凉。\n延平津上峰如削，剑去江空水自长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74826,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡桥 其一","author":"喻良能","text":"惊流落石震林坰，一洗红尘耳目醒。\n妙语曾闻杜陵老，高江急峡斗雷霆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74827,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"峡桥 其二","author":"喻良能","text":"百尺危桥跨綵虹，快输白浪入晴空。\n眼惊巫峡江山近，身在苏仙诗句中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74828,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"弈棋","author":"喻良能","text":"睡馀无俗役，信手一枰间。\n胜负何须较，神情政欲閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74829,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彦礼提宫以诗见招赴惠山登高之集次韵奉酬 其一","author":"喻良能","text":"王勃挥毫滕阁上，苏仙把酒华山颠。\n去秋相与追清赏，回首匆匆又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74830,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彦礼提宫以诗见招赴惠山登高之集次韵奉酬 其二","author":"喻良能","text":"西风摇落雁南翔，万里晴空一洗凉。\n幸有从来茱菊约，敢辞相对引壶觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74831,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彦礼提宫寄似黄芙蓉诗次韵奉酬二绝 其一","author":"喻良能","text":"红粉虽云妙，鹅黄亦大奇。\n欲知堪画处，绝胜采江时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74832,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"彦礼提宫寄似黄芙蓉诗次韵奉酬二绝 其二","author":"喻良能","text":"幽圃知何处，青山东复东。\n芙蓉黄玉蕊，还与海榴同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74833,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日偶成","author":"喻良能","text":"烟霏初散晓寒收，花气烘晴草色浮。\n一片风光吟不尽，青春池上海棠洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74834,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日道中绝句","author":"喻良能","text":"缭绕孤村一径斜，绿杨深处有人家。\n翠眉红颊墙头出，淡淡春山浅浅霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74835,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨 其二","author":"喻良能","text":"春阴不断怒鸠声，日日溪云带雨行。\n试挂西窗看霁色，一川烟草画难成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74836,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雨 其一","author":"喻良能","text":"晚风吹雨过西畴，恻恻轻寒似早秋。\n燕乳鸠鸣春又老，可堪芳草唤人愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74837,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚 其一","author":"喻良能","text":"春及瓜期夏景生，鸣蝉渐欲替啼莺。\n蜂臣飞急冲残絮，蚁子行忙碍落英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74838,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚 其二","author":"喻良能","text":"荷叶商量贴水开，乱红无数点苍苔。\n穿帘双燕复双燕，把酒一杯还一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74839,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洄溪阁","author":"喻良能","text":"十寻杰阁倚云隈，淡霭轻烟照眼来。\n山色不随天际远，溪流长为水深回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74840,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浇花","author":"喻良能","text":"花木蒙沾润，根坚枝亦骄。\n悬知如舌本，端藉酒杯浇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74841,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禹帝祠道中","author":"喻良能","text":"薰风正欲拂江梅，去岁兹晨宿雾开。\n新竹出墙荷贴水，今年潦倒又重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74842,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日有怀仲文季直二弟","author":"喻良能","text":"微云初月澹层城，络纬声连促织清。\n北雁不来千里信，西风还起故园情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74843,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"种水仙酴醾","author":"喻良能","text":"酴醾水仙皆玉英，请借汝南言以评。\n水仙内润叔慈似，酴醾外朗似慈明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74844,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"窆石","author":"喻良能","text":"禹陵踪迹颇堪疑，窆石衣冠知几时。\n犹解起人河洛思，可怜大胜峄山碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74845,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"览镜","author":"喻良能","text":"平生壮夫志，老去未消磨。\n其奈青铜里，萧萧双鬓何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74846,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贺知章祠","author":"喻良能","text":"乞得君王一曲湖，笑他三径就荒芜。\n欲知千古高风在，月落寒山影自孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74847,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追忆王詹事何知录","author":"喻良能","text":"平生师友子王子，四海襟期录事君。\n白发红颜俱异物，高山流水欲谁闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74848,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王节推夷仲秩满赴阙 其一","author":"喻良能","text":"紫禁胪传第四人，锦肠贝齿凛长身。\n三年来作诸侯客，千里江山阴受春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74849,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王节推夷仲秩满赴阙 其四","author":"喻良能","text":"中年谢傅良多感，欲别能忘作恶无。\n今日与公休惜别，须知元不隔江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74850,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王季海敷文赴闽漕 其二","author":"喻良能","text":"谏省归来三载馀，君王应渴见鸿儒。\n七闽重地谁能漕，聊出长才为转输。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74851,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王季海敷文赴闽漕 其一","author":"喻良能","text":"铁冠慷慨老臣风，谏纸雍容补衮功。\n久以精忠简天上，暂将和气到闽中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74852,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王季海敷文赴闽漕 其三","author":"喻良能","text":"圣主方怀南顾忧，且烦持节按闽州。\n政成早作朝天计，两地端须第一流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74853,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送师相陈大观文 其六","author":"喻良能","text":"黄童白叟走踆踆，总向城边拥去轮。\n愿为此邦聊小驻，公归谁作万家春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74854,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送师相陈大观文 其五","author":"喻良能","text":"裴令有心吟绿野，赞皇作意向平泉。\n君王夜半思元老，明日金瓯宝墨鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74855,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送师相陈大观文 其八","author":"喻良能","text":"溶溶曳曳白云閒，救旱濡枯顷刻间。\n四海苍生望霖雨，谢公早晚起东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74856,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送师相陈大观文 其七","author":"喻良能","text":"将令四海变虞唐，那得夔龙滞一方。\n寄语邦人休卧辙，道傍