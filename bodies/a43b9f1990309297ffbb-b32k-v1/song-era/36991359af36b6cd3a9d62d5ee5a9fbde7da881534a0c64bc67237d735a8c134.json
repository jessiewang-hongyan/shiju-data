[{"title":"赠吴山人","author":"释德洪","text":"已得希夷旨趣深，平生踪迹任浮沉。\n壶中景待和烟卧，海上山须带鹤寻。\n月里一枝慵举手，人间万事肯关心。\n出尘风骨凭谁识，且枕焦桐混世吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东溪僧听泉堂","author":"释德洪","text":"诸方游遍归来晚，閒构虚堂赎世纷。\n雷转空山动林叶，雪飞乱石溅溪云。\n石桥旧处龙湫吼，漱玉曾看岳色分。\n拄策眼高双耳瞆，上方白塔却亲闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送庄上人归云居","author":"释德洪","text":"青锁晓开残雨上，烟鬟春解笑声中。\n丛林今日犹雌伏，膺简当年是法雄。\n露盌忆尝安乐味，锦笼曾著瑞香□。\n何时玉钵青林下，与子婆娑小立同。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上元宿百丈","author":"释德洪","text":"上元独宿寒岩寺，卧看篝灯映薄纱。\n夜久雪猿啼岳顶，梦回清月在梅花。\n十分春瘦缘何事，一掬归心未到家。\n却忆少年行乐处，软红香雾喷京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵黄次山见寄","author":"释德洪","text":"君诗清绝似沅湘，写妙宣心气味长。\n地僻且为三径乐，才高真是万夫望。\n随流我自分泾渭，赏骏谁能略牝黄。\n自古丰城匿神物，斗牛应觉动光芒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日同祖贤二道人步云归亭忽忆东坡此日诗有怀其人次韵","author":"释德洪","text":"谁家杨柳欲遮门，依约东坡醉处村。\n捶地不堪华屋句，仰天空记刻舟痕。\n尚馀千载风流在，乞与三人语笑温。\n归路松风吹冻耳，共追前事吊英魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与客论东坡作此","author":"释德洪","text":"东坡醉墨浩琳琅，千首空馀万丈光。\n雪里芭蕉失寒暑，眼中骐骥略玄黄。\n机轮妙转风雷舌，春色浓缠锦绣肠。\n可惜骑鱼天上去，断弦空壁暗凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"京师上元观驾二首 其一","author":"释德洪","text":"及时膏雨已阑珊，黄道新泥晓未乾。\n白面郎敲金镫过，红妆人揭绣帘看。\n管弦叫月宣和气，灯火烧空夺暮寒。\n咫尺凤楼开雉扇，玉皇仙仗紫云端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"京师上元观驾二首 其二","author":"释德洪","text":"阁雨轻寒敛夕氛，青牛画毂已争奔。\n皇州浩荡风光里，紫陌喧阗笑语温。\n冠压花枝驰万骑，帘垂绣箔卷千门。\n特传诏语君恩重，凝睇天阶谢至尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵天觉进喜雪","author":"释德洪","text":"万马天街听启关，晓光佳气泼人寰。\n春生殿阁玲珑外，秀发园林顷刻间。\n为瑞欢声浮动植，争妍诗句丽江山。\n从教飞上朱蓝袂，点缀彤墀玉笋班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别天觉左丞","author":"释德洪","text":"童颊清光已浑圆，共惊玉骨解藏年。\n庵中篆缕长凝帐，门外云涛欲际天。\n道眼从来无异见，微踪何幸预谈禅。\n新诗满箧江南去，又作丛林盛事传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李德茂家有磈石如匡山双剑峰求诗","author":"释德洪","text":"胸次能藏大千界，掌中笑看小重山。\n飞来华岳一峰失，幻出匡庐双剑閒。\n偶触篆烟云点缀，戏浇砚滴瀑潺颜。\n莫将道眼生分别，随意聊安几案间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余昔居百丈元夕有诗后十年是夕过京师期子因不至","author":"释德洪","text":"北游烂熳看并川，重到皇州及上元。\n灯火风光记前事，管弦音节试新翻。\n期人不至情如海，穿市归来月满轩。\n忽忆寒岩曾独宿，雪窗残夜一声猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都下送僧归闽","author":"释德洪","text":"汴水悠悠去不回，绿波垂柳眼初开。\n日边无意事迎送，海畔有山归去来。\n白却人头忙日月，缁飘山衲乱风埃。\n此行若到忘情处，拂石猿声后夜哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜雨歇怀渊才邦基","author":"释德洪","text":"剧笑无因见秀眉，劳生会合恨难期。\n永怀京国旧游处，伏枕梦魂初破时。\n战叶萧萧山雨后，绕床唧唧草虫悲。\n明年定复西归去，船尾何妨载我随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄权巽中","author":"释德洪","text":"摩云标格久去眼，传得诗词锦段新。\n雪玉在躬秋满鬓，风雷为舌语惊人。\n留连南浦西山雨，弃掷炉峰绣谷春。\n何日诗肩拥寒帔，对床听我说京尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书承天寺西斋壁","author":"释德洪","text":"半年客食毗陵寺，颇厌尘埃污衲裙。\n虽有一身犹外物，且将万事付浮云。\n忽思放浪佳山水，要与顽麻散骨筋。\n凉夜满庭风露重，竹梢微月欲纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵隐送僧还南岳","author":"释德洪","text":"海隅相识笑谈馀，清境同疑在玉壶。\n方作灵山栖小岭，又随苕水出东吴。\n透须白雪惊衰老，脱手青春入叹吁。\n悬想他年衡岳寺，雨窗相对话西湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿灵山示月上人","author":"释德洪","text":"地灵形胜自天成，山色溪光泼眼明。\n北岫飞来么凤落，东邻相去一牛鸣。\n霜筠绕寺秋无数，璧月临轩夜更清。\n已约高人结莲社，他年香火寄馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧归石门","author":"释德洪","text":"曾学云庵逸格禅，别来江柳几春烟。\n相逢水寺初尝橘，忽忆风檐共擘莲。\n遥想到山寒食后，却思分首上元前。\n与谁振策西湖路，清晓一声啼杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至西湖招廓然游春","author":"释德洪","text":"别后西湖长在梦，相逢气韵宛清真。\n剧谈要使君颐脱，大笑从教坐客瞋。\n淮海飘零方见友，湖山秀绝更逢春。\n快当火急追清景，莫厌寻幽散策频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"廓然得石门信叹其踵席非其人用韵酬之二首 其一","author":"释德洪","text":"相对天涯岁月新，石门消息远难真。\n乘闲且觅几场笑，疾恶休生一念瞋。\n衬鹭芙蕖方破暖，藏鸦柳色又残春。\n光阴如此空搔首，行诵知归倦鸟频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"廓然得石门信叹其踵席非其人用韵酬之二首 其二","author":"释德洪","text":"颓纲安得见重新，红紫纷纷正乱真。\n已矣无才吾自叹，慨然有志子宜瞋。\n闲寻陈迹消磨日，强作新诗挽绊春。\n振策苏堤朝复暮，路人应笑往来频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"廓然再和复答之六首 其一","author":"释德洪","text":"独立湖边一笑新，纷纷世事信非真。\n竹林逢寺端须往，藜杖敲门不怕瞋。\n僮仆见人空自若，轩窗幽处亦藏春。\n老僧那识闲来兴，怪我时时过此频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"廓然再和复答之六首 其二","author":"释德洪","text":"与君藉草湖边坐，听我论怀句句真。\n慵斗睡魔强分怯，懒酬诗债不须瞋。\n亦知人寿一百岁，已识老来三十春。\n相见几回开口笑，忧愁风雨可胜频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"廓然再和复答之六首 其三","author":"释德洪","text":"湖水行歌鸭绿新，吴音清软十分真。\n但知客子幽情快，不管游人醉眼瞋。\n戈昔曾闻能倒日，笔今犹喜解收春。\n剩将诗句藏深箧，归去须知展玩频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"廓然再和复答之六首 其四","author":"释德洪","text":"处处山川俱胜绝，满村风物自纯真。\n横舟隔岸殊堪唤，吠犬随人不识瞋。\n归鸟独飞当晚照，鸣鸠相应正深春。\n心期卜筑藏幽隐，忽笑行行指划频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"廓然再和复答之六首 其五","author":"释德洪","text":"湖山昔梦虽非实，开睫今游未必真。\n久客情多空自厌，故山归晚欲谁瞋。\n聊将愁里十分兴，更赏湖边一半春。\n君傥肯来尤所愿，莫辜日日作诗频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"廓然再和复答之六首 其六","author":"释德洪","text":"绕舍初晴对意新，出门幽鸟语如真。\n催耕布谷殊堪听，劝客提壶却莫瞋。\n垄麦约风远有浪，海棠经雨匆添春。\n可怜好景无人共，回首斜阳太息频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"明日欲往龙华瞻大士像廓然和前诗叙其事又用韵答之","author":"释德洪","text":"双林大士不复见，闻说龙华画像真。\n要向冰霜识风骨，愿求清冷洗贪瞋。\n空庭再拜俨如在，扣几重看喜胜春。\n我亦钝根期听法，质疑他日故应频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和前韵二首 其一","author":"释德洪","text":"头白逢人宛似新，自嗟世态不容真。\n君才廓落宜无合，我语刚强屡被瞋。\n千里来寻非爱雪，一时行乐谩游春。\n邻居冷淡应相笑，数夕温然语话频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和前韵二首 其二","author":"释德洪","text":"篇篇俊逸间清新，老阅群才始见真。\n秀却采莲溪畔态，豪吞指壁柱边瞋。\n肺肠旧信能缠锦，文字今知解斗春。\n笔力肯低容我和，诗成无惜寄来频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶读和靖集戏书小诗卷尾云长爱东坡眼不枯解将西子比西湖先生诗妙真如画为作春寒出浴图廓然见诗大怒前诗规我又和二首 其一","author":"释德洪","text":"居士多情工比类，先生诗妙解传真。\n只知信口从头咏，那料高人作意瞋。\n云堕鬓垂初破睡，山低眉促欲娇春。\n何须梦境生分别，笑我忘怀叹爱频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶读和靖集戏书小诗卷尾云长爱东坡眼不枯解将西子比西湖先生诗妙真如画为作春寒出浴图廓然见诗大怒前诗规我又和二首 其二","author":"释德洪","text":"轻狂举世谁非伪，迟钝知余却甚真。\n未把僻怀投俗好，且将狂语博君瞋。\n已嗟心折垂垂老，忍看花飞片片春。\n满眼闲愁图不得，江南无奈到心频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱济明作轩于古井旁名冰华赋此","author":"释德洪","text":"刮地阴风剪玉尘，那知此井解藏春。\n折胶堕指嗟时事，秀骨温颜似主人。\n碧甃湛明堪数发，小轩深静可收身。\n超然高趣真难及，浪士愚溪一笑新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钟山悟真庵西竹林间苍崖千尺岁久折裂余与敦素行山中至此未尝不徘徊庵僧为开轩向之尽收其形胜名曰两翁作此","author":"释德洪","text":"水边脩竹才堪数，竹外苍崖已半颓。\n我辈自追方外乐，轩窗谁为此间开。\n待邀山月三人共，要听松风万壑哀。\n坐久篆畦香绕遍，碧消烟缕雪残灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵敦素两翁轩见寄","author":"释德洪","text":"识暗长嗟未烛微，坐令归梦绕岩扉。\n忽惊尘土登须鬓，已觉云山负衲衣。\n孤坐知君扶瘦策，此诗慰我脱危机。\n天藏钟阜一区胜，乞与君侪为发挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大风夕怀道夫敦素","author":"释德洪","text":"病觉春寒花信重，起来散策夕阳中。\n方收一霎挂龙雨，忽作千林攧鹞风。\n淮水粘天雪翻浪，吴山吐月镜缘空。\n二豪诗眼应惊叹，觅句遥知与我同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿鹿苑书松上人房二首 其一","author":"释德洪","text":"数峰烟翠叠黄昏，忽见松间窈窕门。\n好境未将佳句写，幽怀先与故人论。\n隔林每恨音容阻，此夕相逢笑语温。\n雪意不成应有月，夜深同看涌金盆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿鹿苑书松上人房二首 其二","author":"释德洪","text":"冷斋托宿自携衾，卧听松风度栗林。\n黄卷青灯纸窗下，白灰红火地垆深。\n梦回清响春岩溜，夜久幽香喷水沈。\n惯作横刀眠下板，为君令有住庵心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李师尹以端砚见遗作此谢之","author":"释德洪","text":"歙珍先数刷丝纹，那料端溪更逸群。\n已作退闲今似我，温然自重尚如君。\n岂宜禅室埋声价，合在文场著策勋。\n忍垢风棂应有梦，梦随笔阵扫烟云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王节推安道见过云盖二首 其一","author":"释德洪","text":"湘山名与故山齐，寺在沙村断岸西。\n系马槐根秋雨歇，倚栏云际暮猿啼。\n公宜谈笑光台阁，我合摧颓老涧溪。\n袖有新诗如泻出，逼人骏气不容羁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵王节推安道见过云盖二首 其二","author":"释德洪","text":"睡起春衫取次披，髻云随从倚栏时。\n生憎柳底莺声巧，不分花前日影移。\n伊昔笑来忧易老，而今思去恨难追。\n林梢悬挂团团日，无语东风玉箸垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿石霜山前庄梦拜普贤像明日到院见壁间画如所梦有作","author":"释德洪","text":"十幅蛾眉紫翠寒，何人逸想发毫端。\n匆惊瑞色云间相，曾向清宵梦里看。\n影像不真心自寂，悟迷无隔指空弹。\n了然一念非新故，我与群生入正观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠涌上人乃仁老子也","author":"释德洪","text":"照人风骨玉颀然，来慰衰途亦自贤。\n肝胆秋光磨洞彻，齿牙岳色嚼芳鲜。\n应传画里风烟句，更学诗中文字禅。\n已作一灯长到晓，定然百衲不知年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道林喜见故人","author":"释德洪","text":"十年一别今重见，风度依然照映人。\n韵胜折松秋露骨，气和寒谷夜生春。\n三都君已传名誉，万事吾今付欠伸。\n梦境楼钟同此听，独寻陈迹记前身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送日上人归石门","author":"释德洪","text":"三界无家谁适从，大千俱集笑谈中。\n江南湖外梦到晓，宴坐经行月运空。\n狐死怀生正丘首，鸟栖知暖择南风。\n石门今日名天下，想见沿崖一径通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵隐山次超然韵时超然归南岳住庵劝之","author":"释德洪","text":"君亦工诗苦入神，冥搜物象故应贫。\n客儿亭下才相见，巾子峰前便卜邻。\n梦里笔期生蕊萼，胸中镜懒拂埃尘。\n何当鈯斧住山去，要看青原一角麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"湘山独宿闻雨","author":"释德洪","text":"殷床钟静自垂帘，庭树无声欲雪天。\n山寺凄凉容我宿，地垆深暖枕肱眠。\n铜瓶秋蚓为谁泣，蜡烛春花亦自妍。\n夜半梦回闻骤雨，十年踪迹一茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读三国志","author":"释德洪","text":"无计酬劳夏簟凉，遗编枕上阅兴亡。\n气增髯竟从元德，笑里瞒徒造子将。\n汉鼎未移存北海，蜀兵已挫失南阳。\n莫将胜败论人物，忠义千年有耿光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妙高老人卧病遣侍者以墨梅相迓","author":"释德洪","text":"高丝才歇转轻雷，无数晴峰笑靥开。\n大士已闻方卧疾，小空端遣出山来。\n宝方世路知无隔，俗驾山灵故勒回。\n多谢高情饯春色，十分浑在一枝梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别李公弱","author":"释德洪","text":"残红换得绿阴成，随分闲愁取次生。\n须信百年终有别，未能一日便无情。\n何时岳色君同看，后夜湘晴我独行。\n好在西园行乐处，为谁依旧月华清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠关西温上人","author":"释德洪","text":"铁面关西气逸群，平生踪迹付浮云。\n爪州渡口曾同泛，石廪峰前又见君。\n荔子招呼闽岭外，白粳留滞汝江濆。\n拄藤更入西川去，要读丰碑未见文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将登南岳绝顶而志上人以小团斗夸见遗作诗谢之","author":"释德洪","text":"壑源独步宝带夸，官焙无双小月团。\n未作浓甘生齿颊，先飞微白上眉端。\n汤声蜂稚秋窗晚，乳面鹅儿春瓮寒。\n饮罢为君登绝顶，俯临落日看跳丸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题草衣岩","author":"释德洪","text":"锄头当枕草为毡，曾与高人说任缘。\n岂料大嫌沽世价，未应虚费买山钱。\n闲编木叶轻于纸，细葺芦花软胜绵。\n石室至今增壮观，可知千载得人传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与僧游石头庵","author":"释德洪","text":"我携骨面潜溪子，来访西山鈯斧庵。\n梦蝶人惊犹栩栩，藏鸦柳暗已毵毵。\n峰连小阁宜春望，水绕重城隔夜谈。\n欲唤扁舟寻熟路，与君支策上千岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题还轩","author":"释德洪","text":"老去情枯道自肥，大刀破镜露全机。\n山边湖水无行路，枝上春禽亦倦飞。\n半夜舟移空壑在，故乡家是昔人非。\n炷香阅遍楞严义，坐看烟消一缕微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送晓上人归西湖白阁所居","author":"释德洪","text":"我忆钱塘雪鬓新，三年东望肺生尘。\n那知南浦清湘岸，忽见西湖白阁人。\n熟视音姿疑梦寐，便惊风物有精神。\n倏然又入千峰去，惆怅孤云野鹤身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"法轮齐禅师开轩于薝卜丛名曰薝卜二首 其一","author":"释德洪","text":"人世百年蝴蝶梦，纷纷栩栩逐春繁。\n观根戏扫旃檀座，随意为开薝卜园。\n君每据梧深有味，我来欲问自忘言。\n丛林何必犹迷照，香在枝头不在轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"法轮齐禅师开轩于薝卜丛名曰薝卜二首 其二","author":"释德洪","text":"响石岣嵝峰下寺，小轩开处近山房。\n苾刍来问宗风事，薝卜为薰知见香。\n聊复淡然成独坐，从教此语遍诸方。\n钝根不识金轮转，摘叶寻枝谩嗅芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南岳法轮寺与西林比居长老齐公筑堂于丈室之西名曰雪堂作此寄之","author":"释德洪","text":"法道陵夷赖典刑，此堂真有救时心。\n坐令衡岳为嵩岳，便觉西林近少林。\n面壁高风知独振，薝花细雨为谁深。\n故应弟子分皮髓，未愧驹儿善古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":61839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]