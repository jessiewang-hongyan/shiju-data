[{"title":"答子温雪中见寄","author":"刘敞","text":"劲风萧飒结冲波，飞雪奔腾万里过。\n亦未妨人洛阳卧，还闻有客郢中歌。\n壮心可念哀鸿远，正色遥怜翠竹多。\n会卜礼年慰羁旅，敢辞荒径重张罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和永叔岁旦对雪见寄时某于上源驿典护契丹朝正使人日当归前一日始得此诗","author":"刘敞","text":"朔风千里动高帘，雷起龙山昼拥檐。\n属国请缨谋巳拙，屠苏浇酒岁空添。\n剪幡春事宜人日，破鉴归期见玉蟾。\n聊欲为君留薄具，?蠡床酒水精盐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答景彝对月","author":"刘敞","text":"正惜蟾蜍沈夕霭，忽传钟鼓送秋晴。\n浮云四卷无馀迹，斜汉西流亦自明。\n危槛钩帘吟独久，薄帷高枕梦逾清。\n幽兰佳菊漙新露，的历珠华满翠茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立夏祠太乙宫","author":"刘敞","text":"绛阙迎年侯执期，羽衣通夕侍严祠。\n神光映月开璇室，香雾含风拂桂旗。\n路绕城南天最近，地非人境日偏迟。\n还闻增授无穷筴，驰奏中宸对受釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自陕到阙感而成咏","author":"刘敞","text":"葱葱气象瞻峣阙，肃肃行装造近畿。\n钧奏昔年曾梦到，玉关今日是生归。\n茂林病久迷朝序，宣室人疏慑帝晖。\n簪履未忘恩再造，不然何路谒彤闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人赴阙","author":"刘敞","text":"五月齐侯报政时，衮章英节照西畿。\n昔看高雁冥冥去，今喜长魂婉婉归。\n诏使相望拥冠盖，都人倾倒迟光晖。\n师臣固有三公拜，岂独优游奉讲闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留别永叔","author":"刘敞","text":"回车欲度幕南庭，此地那知眼界清。\n老觉鬓毛俱种种，醉看风物尽冥冥。\n平时恸哭休论事，远别悲歌更忍听。\n且共春风同入塞，忆君时计短长亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"澄心堂读许浑以下诸诗","author":"刘敞","text":"许浑诗后三百年，长啸空堂览旧篇。\n落日孤城曾不改，曲池高榭复依然。\n尘埃暂憩道路客，文雅相追今昔贤。\n鱼跃鸢飞殊有意，卜居仍欲近湖边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄密令杨彦文","author":"刘敞","text":"倾盖相亲成白头，离怀终日敌三秋。\n可怜鸡黍虚朋好，应用弦歌乱旅愁。\n太史成书自留滞，石城通信已沈浮。\n王孙可恨山中久，旧令曾为褒德侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答杨令彦文","author":"刘敞","text":"从吏相望千里馀，蓬蒿无以避空虚。\n岂惟论议沈时俗，更觉精神耗簿书。\n惭愧故人存雅素，殷勤佳句慰离居。\n周南会是弦歌地，莫忘寻盟一起予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄致政张大卿","author":"刘敞","text":"昭回云汉丽清秋，曾看星槎历斗牛。\n归去还为竹林会，相望宁减赤松游。\n达人轩冕都如梦，尘世功名不自谋。\n闻道东山多逸赏，从君欲具五湖舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送伯镇守湖州","author":"刘敞","text":"冯公白首敞长裾，莱子斑衣乐有馀。\n金马门前歌避世，水精宫里奉安舆。\n万重岩岫高藏日，百丈溪前俯见鱼。\n去去春风称行乐，京尘回首忆离居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵四叔父出守新定寄欧阳一首","author":"刘敞","text":"勾吴半在海山中，闻道驱车更向东。\n旧治空传汉都尉，遗民无复楚诸熊。\n文章老去轻时辈，势利恬来付觉雄。\n卧理便应长闭阁，一方还见古人风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"园人献蒲萄","author":"刘敞","text":"婉婉柔条万虺蟠，累累佳实紫金寒。\n甘泉渗液秋香重，瑞露凝膏晓色乾。\n鲛室珠盘惊不定，蓬莱金体恨微酸。\n贵人宁借凉州牧，暂负衡门报一餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘先辈恕","author":"刘敞","text":"关东少年西入都，诸老先生惊不如。\n射策遂为天下选，限年却就里中居。\n豫章固起秋毫末，千里方从跬步初。\n会见高明成伟器，不忧绛灌毁新书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻范参政巡西边","author":"刘敞","text":"汉与匈奴如弟兄，犹传敌骑向边城。\n数烦卿士亲持节，始恨儒生妄请缨。\n形势倒悬方舛逆，计谋无益是纵横。\n古来贤哲多屠钓，公试咨询策太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和王刑部秋日寄元兄尚书","author":"刘敞","text":"脊令原隰晓霜清，季子嗟行不自宁。\n归梦时环北斗极，相辉犹隔太微星。\n源流淮水占何远，羽翼西山药最灵。\n接武禁严多故事，共看兰玉出阶庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至日早起","author":"刘敞","text":"至日应添一线长，汉仪忆奉万年觞。\n鸣珂列炬随丞相，长剑高冠满未央。\n法从此时瞻玉座，侍臣独许近清光。\n輶轩今出荒山外，厌见尘沙万里黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬至","author":"刘敞","text":"殊方喜及固阴消，积雪层冰意亦聊。\n就日稍欣南极永，观云尚恨帝乡遥。\n闭关自信天心复，吹律应知玉琯调。\n留滞能无越乡恋，甘泉受计万神朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻元旦大朝会","author":"刘敞","text":"玉帛雍容万国来，帝城如斗挹春回。\n旂常影乱三辰象，钟鼓声喧百里雷。\n北极正临丹凤扆，南山遥入万年杯。\n诸神受计明堂定，留滞江滨志已摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"招友上清宫","author":"刘敞","text":"脩竹高松无俗尘，全然不似近城闉。\n黄冠习静多藏客，野鸟忘机却傍人。\n高阁切云衔落日，广庭霏雨湿清珉。\n北窗固有逍遥地，来读离骚戴角巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻范饶州移疾","author":"刘敞","text":"汲黯廉平汉主知，淮阳移病苦情羸。\n偃藩政事应无及，伏阁精神定未衰。\n天欲期人身必乏，帝疑飞将数多奇。\n何当半夜开宣室，独使雍容对受釐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"编杜子美外集","author":"刘敞","text":"少陵诗笔捷悬河，乱后流传简策讹。\n乐自戴公全废坏，书从鲁壁幸增多。\n斯文未丧微而显，吾道犹存啸也歌。\n病肺悲愁情自失，苦吟时复望江沱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鼓角楼宴集","author":"刘敞","text":"周城百雉拥中军，阿阁三间丽白云。\n燕雀总知依盛德，山河相与助雄文。\n轻裘缓带居多暇，旨酒嘉肴客易醺。\n还识魏牟怀北醺，正逢长日扇南熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日上府公","author":"刘敞","text":"红芳过尽绿阴多，索寞无如长日何。\n午影迟留成蕴暑，熏风飘荡作清和。\n梦馀欲验松生腹，棋罢真知斧烂柯。\n还想高吟酬美景，讼庭岑寂长青莎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺司马君实何济川得宠公炭","author":"刘敞","text":"上府爱才天下闻，两君素出将军门。\n欲正大冶慰民望，豫排寒风作春温。\n不烦束缊资游说，聊复游贤报国恩。\n自笑野人卧穷巷，负暄方拟献天阍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"独宿直舍","author":"刘敞","text":"谈笑从容宫漏稀，高轩去尽掩重扉。\n风含玉宇霜威劲，月上疏窗烛影微。\n周卫相望諠夕警，炉香不断护朝衣。\n尘躯更觉仙山峻，旅梦端从江海归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五月望日赴紫宸谒待旦假寐","author":"刘攽","text":"半夜北风凛凛寒，倒衣惊问紫宸班。\n云容不辨阴晴际，月色犹迷爽晦间。\n偏喜鸣鸡识钟漏，正怜残梦失江山。\n濯缨簪笔初无补，空愧纷纷数往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送李留后守东平","author":"刘敞","text":"少壮去人如水流，似君那作待祠侯。\n高谈每及功名际，出守真宽圣主忧。\n麾下百城包海岱，道旁千骑拥貔貅。\n家声时论俱辉赫，世将宁为好畤羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题连理亭","author":"刘敞","text":"灵光芜灭泮宫平，三百年中独此亭。\n无复乔林见连理，尚传高栋出穷溟。\n疏帘清簟宜炎日，菀柳长梧半广庭。\n卧向汶篁惭蓟植，燕山都欲负刊铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答陈州通判廷评同年","author":"刘敞","text":"黄门献赋接群贤，上国知名独累年。\n不谓招徕从隗始，至今惭愧在卢前。\n簿书几废三馀学，绳墨空勤一割铅。\n还喜迁乔友声近，高山流水入清弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"麃子岭帐馆寄隐直","author":"刘敞","text":"离肠易感岁华催，更席龙沙望紫台。\n持节不眠宵自永，听笳无事泪空摧。\n扁舟何处山阴雪，驿使他年岭上梅。\n欲寄一书愁已乱，天边应候客星回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过中京走马上平安奏状","author":"刘敞","text":"载驱冬岁极河源，状奏今朝款帝阍。\n目断白云浮魏阙，心先飞骑向中原。\n揣摩讵试衡人术，感激空衔国士恩。\n犹使匈奴戴黄屋，南归惭吊陆公魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冀州正月十六日饮席","author":"刘敞","text":"月缺雪残云乱飞，千灯相照续长辉。\n寒欺短夜禁杯酒，春入东风试舞衣。\n老惜佳辰经岁得，醉惊陈迹出门非。\n渔阳鼓节尤悲壮，知我新从万里飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无双亭观琼花赠圣民","author":"刘敞","text":"东风万木竞纷华，天下无双独此花。\n那有灵霙凌暖日，不为琪树隔流沙。\n祠城寂寂春空老，江雨冥冥日易斜。\n仙品国香俱绝妙，少倾高兴尽流霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"园人献芍药","author":"刘敞","text":"淮海由来草木夭，春工殊复自娇娆。\n始知隋苑多佳丽，未觉吴宫久寂寥。\n冰雪肌肤明绰约，云霞衣服润飘萧。\n一枝漫取堪谁赠，老去风情不自聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中北轩晚寝","author":"刘敞","text":"树色禽声相与閒，吾庐仍共一枝安。\n浮云蔽日绵绵雨，积水婴城惨惨寒。\n还恐百芳从此歇，不知后土几时乾。\n闭关高枕交游绝，一梦江湖意绪宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和府公多叶榴花","author":"刘敞","text":"翠条红蕊映贫家，笑倚熏风拂露华。\n重叠火云烧落日，浅深金鼎矗丹砂。\n多情强自含春恨，不语那能学馆娃。\n但寄一枝共醉赏，试将颜色比裙纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄谢霍丘静乐亭","author":"刘敞","text":"城西陵谷几推移，仍有中亭玉树枝。\n从政真同傲吏隐，赏心能与古人期。\n诛茅改筑成芳榭，引水交流涨曲池。\n闻道小山多丽句，还因春草梦新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"昼寝","author":"刘敞","text":"屋边高树绿云阴，堂下清池碧玉深。\n卧想溪山迷远近，梦为鱼鸟或飞沉。\n治逢平日如无事，老觉衰容稍见侵。\n聊取南华寄齐物，不为东武极悲吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中家人致酒","author":"刘敞","text":"急雨连宵昼不收，草堂晨起似新秋。\n山歌倚瑟清无赖，野馔随樽特自优。\n追古最宜真浑沌，旁骚仍有畔牟愁。\n纶巾搭脑醒还醉，得此尧民已甚休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答令狐司封使君舟中见寄","author":"刘敞","text":"汝颍相从弥十年，江楼今日迟归船。\n自惊物役还如昔，但觉诗情更爽然。\n寥落莺花千骑里，苍茫烟雨万山前。\n未知后会仍何地，彊醉春风酒似泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和春卿城西同步","author":"刘敞","text":"夕光却射戍楼红，野色遥瞻百里中。\n玉帐坐休铃下卫，春衣行试舞雩风。\n招携直许威仪略，戏笑深矜意气融。\n流水高山俱在眼，知公令望共无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"往得南岳玄猿特善啸立秋后风雨颇凉声尤清绝怜其山林之思为作七言","author":"刘敞","text":"薄云疏雨湿风枝，衡岳猿啼忆此时。\n回首那无万里感，向人时作一声悲。\n钟仪故有南冠恨，庄舄犹多旧国思。\n车马纷纷九域客，路傍翻笑断肠为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过思乡岭南茂林清溪啼鸟游鱼颇有佳趣","author":"刘敞","text":"山下回溪溪上峰，清辉相映几千重。\n游鱼出没穿青荇，断蝀蜿蜒奔白龙。\n尽日浮云横暗谷，有时喧鸟语高松。\n欲忘旅思行行远，无奈春愁处处浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题临波亭","author":"刘敞","text":"绿杨芳草旧无蹊，竹坞花源敌剡溪。\n水影时翻高槛动，天形略抱曲城低。\n逢迎野兴鸥双下，点缀春愁莺乱啼。\n宿雨楚山云正满，高楼莫上使人迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"至日宴水上呕吐先醉上府公","author":"刘敞","text":"南极微阳中夜新，碧池风物晓来春。\n鼓鼙似动鱼龙伏，旌旆不惊鸥鹭驯。\n东阁于今待贤士，西曹不意吐车茵。\n博阳气度平津学，虽贱犹堪颂得人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送沈康学士知常州","author":"刘敞","text":"三科妙选汉台臣，君去分符牧远人。\n富贵须为千骑长，中和好布万家春。\n山川阳羡由来胜，谣俗延陵自古淳。\n曾是倦游羁旅地，送行增羡两朱轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送柳舒州","author":"刘敞","text":"金马宿儒当世贤，著书天禄自忘年。\n中和屡以乐职用，九次方为耆老迁。\n何恨一回仍出守，会须千室看鸣弦。\n祗因闭阁江湖上，正想遥心象魏前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张苏州","author":"刘敞","text":"始上蓬邱肃羽仪，旧更台省著清规。\n怀章又下芙蓉阙，候骑先瞻鸟隼旂。\n楚泽潦收腾驾远，广陵涛起渡江迟。\n吴中事事皆奇胜，还见风流太守诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刁越州","author":"刘敞","text":"笑持符印下瀛州，真得千岩万壑游。\n父老为郎无自苦，鉴中行乐不知秋。\n居人旧俗多姚姒，幕府连城半斗牛。\n太守会兼四千石，玺书宁复久淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送修撰张待制知越州","author":"刘敞","text":"倦簪华笔直承明，自请分符江外行。\n真得蓬莱为治所，径从云汉濯尘缨。\n山游访古穷书穴，春事劭农见象耕。\n若向鉴中望明月，会吟还肯寄新声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送张兵部知遂州","author":"刘敞","text":"锦帐郎官锦里贤，皂衣休直綵衣还。\n怀章过邸惊群吏，建节乘春感旧关。\n道侧壶浆积遗爱，里中牛酒庆承颜。\n朝廷孝治君先布，更听传歌太学间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送彭待制知瀛州","author":"刘敞","text":"赵北燕南如掌平，定知台选寄长城。\n雅歌不废军中乐，缓带能令塞外清。\n倾盖由来欣意气，著鞭从此想功名。\n灞池送目邯郸道，倚瑟空多惜别声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同邻几持国过杜和州","author":"刘敞","text":"江南太守水斋居，残雪层冰正满渠。\n忽忆山阴乘兴往，可怜心抱向人摅。\n放歌浩荡惊狂客，换酒从容解佩鱼。\n四座欢衷两倾倒，归鞍欲犯夕钟初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄献臣","author":"刘敞","text":"通塞由来自有期，奏书未上莫嗟咨。\n锥藏勉后三千客，舌在须强百万师。\n固有青云堪自致，暂虚丹桂不为迟。\n如今相府闻名甚，应以雄文荐赤墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离京后寄贡甫隐直","author":"刘敞","text":"清川如带屡回环，信宿犹居百里间。\n敢恨淹留同桂渚，正怜风雨似梁山。\n月残虚魄无由共，云映高楼不可攀。\n却怪梦中翻识路，化为蝴蝶一飞还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伯镇出都后见寄","author":"刘敞","text":"叠鼓鸣笳太守船，都人倾注似登仙。\n旧游俯仰成陈迹，离思纷纭绕别弦。\n愁目青枫空自极，素书双鲤不忘传。\n恐君未得江湖乐，追诏方将急用贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄刘景烈","author":"刘敞","text":"汉设重关斥塞垣，诏移飞将护秋屯。\n胡人无复窥南牧，燕客时应祭北门。\n清酒肥牛宴长日，轻车精骑猎平原。\n少年真得军中乐，况复诗书盛讨论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄隐直","author":"刘敞","text":"江汉相思山万里，君家少室定西东。\n年华过去如流水，心事差池似老翁。\n一世共争蜗角上，微生多付酒杯中。\n穷途何必多垂涕，吾更冥冥笑阮公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄王二十","author":"刘敞","text":"昔借君家杜甫集，无端卧疾不曾编。\n近从霅上吴员外，复得遗文数百篇。\n夫子删诗吾岂敢，古人同疾意相怜。\n新书不惜传将去，怅望秦城北斗边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新居陈州城下读书作","author":"刘敞","text":"诛茅负郭楚人居，泌水衡门自有馀。\n数困米盐希辟谷，素轻农圃重捐书。\n绝粮尼父期先进，画卦羲皇序古初。\n千世风流尚在眼，百年贫病不欺予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"读汉书","author":"刘敞","text":"贾谊求为典属国，终军愿得使匈奴。\n和亲不及当时策，慷慨犹为大丈夫。\n百年强敌轻中国，一世奇功悲腐儒。\n闻道边民尚严警，异时回首恨江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"连雨三日东轩读书","author":"刘敞","text":"雨中无复故人居，寂寞闭门三日馀。\n却信袁安似有道，未知原宪定何如。\n浮云极目无由卷，积藓侵阶不易除。\n正赖高眠堪自遣，时时纷乱满床书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":39657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]