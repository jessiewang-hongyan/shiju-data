[{"title":"别曾运使","author":"赵蕃","text":"钟陵寂寞几何年，公自茶山又一传。\n万里未能攀老鹤，晚风那复听鸣蝉。\n乖离每觉如思古，流转何知复拜前。\n剩欲相从还索去，候门稚子望归鞯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴仲权相别诗云欲少留桃川山中昨日同在伯怀之作诗约在伯同赋以寄并属徐季纯于去非","author":"赵蕃","text":"诗卷方欣见管斑，酒杯已复动离颜。\n余当火伞朱冠际，君政清虚爽气间。\n逸兴飘飘难并驾，好风发发待吹还。\n如舟可使长身久，有竹悬知不用关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈广仲运干","author":"赵蕃","text":"招真岩畔菊花秋，忆昨赋诗相赠投。\n不但居民思憩树，每令客子击行舟。\n只言腾踏已云远，岂料转输由尔留。\n我亦老焉犹昔日，倚楼看镜两悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈公择二首 其二","author":"赵蕃","text":"此地无此客，若人吾故人。\n论文皆意到，出语见情真。\n未议作轻别，且当留浃旬。\n畦蔬饱春雨，小摘未妨频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈公择二首 其一","author":"赵蕃","text":"背郭才数里，深林溪四环。\n精庐于此建，寓舍即其间。\n我已成栖遁，君能数往还。\n故知交义厚，不与世情关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈毛伯明李叔器","author":"赵蕃","text":"阴雨春三月，倦游天一隅。\n故难同类我，还复叹犹吾。\n不惑防终蔽，无闻恐遂愚。\n犹欣得师友，可以慰羁孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈王平江二首 其二","author":"赵蕃","text":"先生自词伯，举世孰诗人。\n纵不藏人善，惭无佳句新。\n每怀青眼旧，应念白头贫。\n未弭沅湘楫，蒸湘复问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈王平江二首 其一","author":"赵蕃","text":"倦著尚书履，闲凝燕寝香。\n声犹传汉殿，句岂羡韦郎。\n偃泊姑铃阁，遄归定玉堂。\n不惟资献纳，政复用文章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈丘运使三首 其三","author":"赵蕃","text":"从士二千里，学诗三十年。\n坐穷宁为此，将老岂其然。\n耻食陶奴米，羞言夷甫钱。\n相逢何用早，契合有忘年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈丘运使三首 其二","author":"赵蕃","text":"奔逸闻千里，飞腾见九迁。\n禁途才咫尺，玉节屡回旋。\n看即自天下，催归夜席前。\n如怜落鸢外，为遣反驱边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48752,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈丘运使三首 其一","author":"赵蕃","text":"海内求名辈，如公得未多。\n风流正始士，艺达孔门科。\n愿识亦已久，陈诗无见诃。\n蒿蓬虽培塿，松柏自嵯峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48753,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈亦韩","author":"赵蕃","text":"寒食寒未归，清明清晓时。\n花残渺无迹，柳细不胜垂。\n即事须诗写，多忧赖酒支。\n虽亲友朋益，更苦弟兄思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48754,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈全真鲁山","author":"赵蕃","text":"有怀思放旷，兹地窘幽潜。\n屋脊山微见，庭前树莫添。\n把书唯立壁，扶杖祗巡檐。\n深羡凭江宅，登临万象兼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48755,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈刘子后赵行之司理舅二首 其二","author":"赵蕃","text":"忽忽江头住一旬，敢疏请谒恐烦人。\n肯敦宿昔论交旧，更辱慇勤枉句新。\n已向清澌看流水，更从高节抚霜筠。\n白醪煮饼留终日，吾舅于今惊座陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48756,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈刘子后赵行之司理舅二首 其一","author":"赵蕃","text":"南渡凄凉六十年，故家遗俗日萧然。\n不应门户端如此，政坐吾曹欠勉旃。\n斗食我今悲白发，束书今喜继青毡。\n乡来未识衡州士，闾里皆推有此贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48757,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈刘子卿四首 其四","author":"赵蕃","text":"往自清江别，于今近十年。\n依僧聊避暑，拥节会朝天。\n我愧不如昔，公乎真过前。\n政规期断手，明本已终篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48758,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈刘子卿四首 其三","author":"赵蕃","text":"王气东南盛，流风西北疏。\n往犹称旅寓，今乃逐乡闾。\n要熟儿童听，惟传父祖书。\n如公不一二，安得亦相于。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48759,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈刘子卿四首 其二","author":"赵蕃","text":"近喜周公相，初传荐士章。\n非才孰为治，与国倍生光。\n故国异乔木，白驹空食场。\n弹冠与结绶，吾道不其昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48760,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈刘子卿四首 其一","author":"赵蕃","text":"南渡六十载，况谈元祐时。\n故家垂欲尽，遗事莽难知。\n文字既多舛，传闻宁破疑。\n唯公有源委，万折必东之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48761,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈庆伯","author":"赵蕃","text":"开到牡丹春十分，不堪风雨尚纷纷。\n酒杯强适谁知我，药裹关心更念君。\n老去青衫甚蓝缕，愁来白发懒锄耘。\n稻针出水蚕初扫，惭愧耕桑每废勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48762,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈庆伯","author":"赵蕃","text":"顾藉微官无一分，强能从俗亦徒纷。\n他乡骤喜逢诗伯，故里浑疑对竹君。\n莫为饥寒常道路，要留精力事耕耘。\n如君少壮端宜勉，老我衰摧直漫勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48763,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈许深父及之","author":"赵蕃","text":"路入分宜县，心驰月旦评。\n参差万木合，曲折乱滩行。\n江右孰茂宰，斯人垂大名。\n凫飞看公入，鸢堕黯余情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48764,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈邢叔三首 其三","author":"赵蕃","text":"听说桃川事，凭虚意欲仙。\n真成在人境，无用觅渔船。\n卜宅自何载，赋诗凡几篇。\n挥毫傥毋靳，图貌并流传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48765,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈邢叔三首 其二","author":"赵蕃","text":"浏浏晴檐响，愔愔兰斛香。\n时于簿书暇，乐是话言长。\n政可昼连夕，兴怀参与商。\n平生事贤志，烱烱未尝忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48766,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈邢叔三首 其一","author":"赵蕃","text":"前辈已云远，公身亲见之。\n老成疑故在，风俗未忧衰。\n问学本日用，文章先达辞。\n从兹得夷步，不复困多歧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48767,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈何县丞","author":"赵蕃","text":"古屋无多客挂包，占风政类鸟居巢。\n谁能故赋感不遇，亦莫空书广绝交。\n开阖屡摇尘户牡，戛磨时袅竹檐梢。\n南朝文物君家盛，听我追随学咏嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48768,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈宋伯潜","author":"赵蕃","text":"学有南轩派，文仍二宋家。\n泉源端有本，玉立更无瑕。\n傥遂成三径，当从读五车。\n朋游有如此，未恨落长沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48769,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈寿冈","author":"赵蕃","text":"夏雨凄凄曾过公，祇今端复是秋风。\n青青但保庭前竹，渺渺不悲江上枫。\n每忆诵诗头且白，可期频见颊犹红。\n陶家九日明朝事，问讯菊篱开几丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48770,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈张太平三首 其三","author":"赵蕃","text":"门墙十五载，每见辱加亲。\n老至名不立，道乖家转贫。\n世谁能我及，志欲向公申。\n剩欲搜诗献，青山恐笑人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48771,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈张太平三首 其二","author":"赵蕃","text":"贵者多骄士，古然宁迩来。\n惟公独超俗，片善靡遗才。\n誉已满台阁，勤方散草莱。\n深知桃李径，不为看花栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48772,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈张太平三首 其一","author":"赵蕃","text":"游日甘泉旧，如公孰与先。\n内虽资献纳，外乃藉蕃宣。\n今日江淮地，宁惟牧守权。\n功名端未晚，勉力继青毡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48773,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈李思永","author":"赵蕃","text":"往见刘夫子，得闻君姓名。\n飘零方客路，邂逅若平生。\n学要精微讲，文须仔细评。\n道林并岳麓，他日得经行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48774,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈李赣州四首 其四","author":"赵蕃","text":"学时元草草，赋就每匆匆。\n竟复无真好，空令坐枉穷。\n春风才乱鸟，秋雨又鸣蛩。\n笑我胡为者，真成浪自攻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48775,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈李赣州四首 其三","author":"赵蕃","text":"安否每难问，姓名今得通。\n久忧埋积雪，大喜得春风。\n与世故多识，如公能几同。\n既欣还有感，愁对海棠丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48776,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈李赣州四首 其二","author":"赵蕃","text":"见自长台数，于今十五年。\n虽云公偃薄，政坐我迍邅。\n苦志思重写，愁肠不易煎。\n却怜难掩处，霜发半萧然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48777,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈李赣州四首 其一","author":"赵蕃","text":"忆昔重湖北，逢人问处州。\n寄书宁尽达，觅使苦无由。\n风月无离阔，山川自阻修。\n那知远游棹，又傍昔年洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48778,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈杨溥子","author":"赵蕃","text":"晓过子云居，霜风柳未疏。\n飘零五年别，断绝一行书。\n安否劳苦外，诗编吟诵馀。\n君宁老骐骥，我已愧舂锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48779,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈杨谨仲监庙三首 其三","author":"赵蕃","text":"地占清江胜，居兼水竹幽。\n衡门阻静僻，高卧乐优游。\n深雾隐玄豹，沧波翻白鸥。\n弓旌不可挽，刍牧政旁搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48780,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈杨谨仲监庙三首 其二","author":"赵蕃","text":"刘孔何如士，欧苏敢并行。\n江山故好在，人士熟知名。\n道遇澄清使，为言月旦评。\n经过才一见，已似慰平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48781,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈杨谨仲监庙三首 其一","author":"赵蕃","text":"祇道无前辈，于今识后凋。\n形容犹矍铄，鬓发自飘萧。\n早日破万卷，暮龄甘一瓢。\n纷纷盈郑卫，洗耳骤闻韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48782,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈辛卿二首 其二","author":"赵蕃","text":"今昔名流几许人，况于室迩更身亲。\n南州行卷虽云旧，东阁知名固若新。\n再见每怀风度远，两年空恨往来频。\n其谁为我谈名姓，车辙勤公野水滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48783,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈辛卿二首 其一","author":"赵蕃","text":"诗老当年聚此州，迩来零落尽山邱。\n公虽暂尔淹时用，天岂特令继夙游。\n幽事傥多尘事绝，灵山孰与博山优。\n林栖相去无百里，窈窕崎岖可后不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48784,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈陆严州二首 其二","author":"赵蕃","text":"去年犯雪到严州，呵笔题诗曳履投。\n所恨决然成间阔，故兹复尔小迟留。\n精金美玉自有价，伯乐王良无即休。\n珠玉见褒犹美疢，药须瞑眩疾方瘳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48785,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈陆严州二首 其一","author":"赵蕃","text":"一代诗盟孰主张，试探源委见深长。\n家声甫里归严濑，句法茶山出豫章。\n千里寸心长炯炯，十年两鬓漫苍苍。\n扁舟纵欲乘风去，可不一登君子堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48786,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈陈深父二首 其二","author":"赵蕃","text":"役役到番国，悠悠谁故人。\n僧房半牢落，湖水失清沦。\n我岂倚楼赵，君真惊座陈。\n何为辱倾倒，相与尽情亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48787,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈陈深父二首 其一","author":"赵蕃","text":"相望仅一水，相赊逾十年。\n寻君向萧寺，叹我已华颠。\n老至是其理，穷来当益坚。\n云深雪溪树，尘暗曲肱弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48788,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈叔文诸公","author":"赵蕃","text":"村村迎湫水，户户■炉香。\n何以救我穑，但知呼彼苍。\n傥宽饥欲死，聊听醒而狂。\n困极惟思睡，诗来得助凉。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48789,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈叔骥和叔","author":"赵蕃","text":"吴楚山川隔，埙篪笑语欢。\n柳迟因积雪，梅悴坐馀寒。\n痛饮还忧病，离愁孰可宽。\n故非元与白，压倒又何难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48790,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈周昭礼二首 其二","author":"赵蕃","text":"又向江头觅去船，故山归路反茫然。\n秋鸿社燕各千里，落日残霞同一川。\n酒得老兵犹可饮，诗须我辈始堪传。\n经行到处无生景，平日梦中今目前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48791,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈周昭礼二首 其一","author":"赵蕃","text":"自从君发信州船，令我登临每怅然。\n把臂真成一倾倒，转头知隔几山川。\n憎余况有年年恶，美子诗堪句句传。\n记取相逢又相别，菊枯荷尽早梅前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48792,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈季承","author":"赵蕃","text":"发舒言笑非关酒，慰藉辛勤一以诗。\n往日追从虽旧矣，祇今夷险更同之。\n真仙岩壑君行访，快阁江山我亦披。\n但恐衡阳无过雁，书筒不至费人思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48793,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈审知","author":"赵蕃","text":"晨出及未热，饭馀因就谈。\n结交真有道，致此亦何堪。\n静听多闻益，微吟佳句耽。\n疏檐有新月，当共影成三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48794,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈审知二首 其二","author":"赵蕃","text":"楼前木叶下缤纷，楼上长吟独有人。\n勿漫悲秋成楚些，要知达识自天真。\n从渠屐著一生几，莫问锥无今岁贫。\n平日相期定何事，君今到岸我迷津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48795,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈审知二首 其一","author":"赵蕃","text":"秋风已作重阳雨，客子将回下水船。\n卒岁褐裘悲破箧，丰年稌黍欠多田。\n平生漫说诗书学，满眼不祛儿女煎。\n颇怪渊明瓶乏粟，若为犹送酒家钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48796,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈明叔且约诘朝过买江天阁","author":"赵蕃","text":"老屋支风政觉疏，况堪急雪堕空虚。\n黑甜颇念华胥去，白战仍牵故事馀。\n雀噪还喑家立壁，鼠窥欲下粟无储。\n江天快阁相萦带，曳履明朝不命车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48797,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈林子方运使四首 其四","author":"赵蕃","text":"白发丝难理，青衫叶半枯。\n自怜谋斗食，敢作恸穷途。\n试问遥书札，何如迩坐隅。\n合江趋浩渺，分水忘崎岖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48798,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈林子方运使四首 其三","author":"赵蕃","text":"一代推人物，诸生赖楷模。\n高风虽莫并，盛德本非孤。\n物望归台阁，官称复转输。\n澄清虽雅志，献纳政时须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48799,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈林子方运使四首 其二","author":"赵蕃","text":"忆自梧州别，怀兹下榻勤。\n寸心长炯炯，尺素每云云。\n远地必迂报，高情真薄云。\n百年公几见，五十我无闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48800,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈林子方运使四首 其一","author":"赵蕃","text":"去岁都城客，传闻召节驰。\n深期遂披睹，得以叙乖离。\n竟复参差是，空成怅望兹。\n外台知不远，匹马敢言疲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48801,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈欧阳伯威","author":"赵蕃","text":"传得新诗字字惊，佛廊骤识病身轻。\n李邕昔已求工部，文举今宜荐祢衡。\n祇道迷邦尚蓝缕，试令吐气即峥嵘。\n一官不作来南限，取友得交齐鲁生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48802,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈赵叔侍郎子直二首 其二","author":"赵蕃","text":"潦倒三年白下官，畏途常以此心观。\n求为庙令直不易，翻入帝城良独难。\n落落白头游且倦，悠悠青眼刺空漫。\n文章功用知无补，保此不渝惟岁寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48803,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈赵叔侍郎子直二首 其一","author":"赵蕃","text":"忆昨才闻召节趋，江湖日月诵除书。\n政途去此不容咫，物望在廷谁得如。\n岂但疲民望苏醒，更知寒士待吹嘘。\n所期异日施行次，不负于今拜献初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48804,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈赵蕲州善扛","author":"赵蕃","text":"雨合园林水满池，黄鹂无语鹭频窥。\n哦吟终日大自好，黜陟与时殊不知。\n北海定欣真识面，阿连还喜伴成诗。\n自从诸老凋零后，此事于今更属谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48805,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈闾丘四舅二首 其二","author":"赵蕃","text":"不识高安县，饱闻明恕堂。\n毋卑百里小，未觉四年长。\n议论兼秦汉，规模类越杭。\n庙堂方急此，已试乃为良。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48806,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈闾丘四舅二首 其一","author":"赵蕃","text":"忆昨都城见，于今岁月长。\n中间各忧患，重对两悲凉。\n课最舅材显，诗穷甥鬓苍。\n相逢又相别，客路况冰霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48807,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈唐德舆兼寄呈可久三首 其三","author":"赵蕃","text":"敬作沙随问，归来安稳不。\n一官成弃却，微恙想今瘳。\n诗箧犹堪倒，钱囊不用谋。\n更思从二老，何日具扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48808,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈唐德舆兼寄呈可久三首 其二","author":"赵蕃","text":"前岁长安雪，从公饮屡过。\n放谈成绝叹，狂态亦悲歌。\n我仕鱼缘竹，公行漩绕涡。\n相逢虽足慰，相别奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":48809,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]