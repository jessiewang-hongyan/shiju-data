[{"title":"北京留守王太师挽歌词二首 其一","author":"司马光","text":"卢肇时推重，终军众共贤。\n何如夺标日，未及弃繻年。\n官历清涂遍，名居美事先。\n人间福有五，视履岂非全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"去春与景仁同至河阳谒晦叔馆于府之后园既去晦叔名其馆曰礼贤梦得作诗以纪其事光虽愧其名亦作诗以继之","author":"司马光","text":"蓬飞匏系十馀年，并荫华榱出偶然。\n郭隗金台虽见礼，华歆龙尾岂能贤。\n浮云世味闲先薄，寒柏交情老更坚。\n明日河梁即分首，人生乐事信难全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古松","author":"司马光","text":"摧颓岩壑间，磊落得天顽。\n香叶低渐水，馀根倒挂山。\n白猿窥子落，黄鹤认巢还。\n不久应为石，莓苔旧已班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司徒开府韩国富公挽辞四首 其四","author":"司马光","text":"杖屦还私第，精诚在本朝。\n爱君老不懈，忧国没方昭。\n东阁秋牢落，西芒夜寂寥。\n只应忠亮志，气运不能消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司徒开府韩国富公挽辞四首 其三","author":"司马光","text":"大吕功名重，鸿毛轩冕轻。\n闲居客愈盛，暂出市皆倾。\n溟海涵容大，龙门谒见荣。\n谦光俨在目，恸哭望佳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司徒开府韩国富公挽辞四首 其二","author":"司马光","text":"松漠骄无信，渔阳广聚兵。\n移书侮中国，决意背齐盟。\n直气轻轺入，英辞左衽惊。\n虏归烽火灭，宇县复升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司徒开府韩国富公挽辞四首 其一","author":"司马光","text":"天祐休明祚，时生隽杰臣。\n贤科首多士，宰府泽生民。\n焕烂三台正，冲融四海春。\n欲知甄冶力，试问白头人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月十三日立夏呈安之","author":"司马光","text":"留春春不住，昨夜的然归。\n欢趣何妨少，闲游勿怪稀。\n林莺欣有托，丛蝶怅无依。\n窗下忘怀客，高眠正掩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平日游园常策筇杖秋来发箧复出貂褥二物皆景仁所贶睹物思人斐然成诗","author":"司马光","text":"筇杖携已久，貂褥展犹新。\n渐染岷山雪，拂除京国尘。\n危扶醉归路，稳称病来身。\n赖此斋中物，时如见故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归田诗 其一","author":"司马光","text":"秋水风波大，嗟嗟未可游。\n渔樵自应乐，圭组为谁忧。\n直木知先伐，明珠忌暗投。\n果然钩可曲，不惜取封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归田诗 其四","author":"司马光","text":"松菊陶潜宅，蓬蒿仲蔚家。\n行游筇杖瘦，啸傲幅巾斜。\n屋小疏茅覆，门深乱柳遮。\n村童迎客至，竹帚扫桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归田诗 其三","author":"司马光","text":"圣哲虽云远，遗文幸未亡。\n沈冥观礼乐，彷佛见虞黄。\n鸡黍延三径，琴书乐一堂。\n逍遥名教内，富贵亦微茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归田诗 其二","author":"司马光","text":"绂冕诚虚器，簪裳悉畏途。\n触机身未保，好直道先孤。\n甔石曾何有，田园浪更无。\n可能推两耜，沮溺共为徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月二十四日夜雪","author":"司马光","text":"叠瓦浮轻雪，参差粉画难。\n苦欺初变柳，故压未生兰。\n夜色微分白，春容不受寒。\n即为花卉夺，犹得暂供看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉宫词","author":"司马光","text":"苜蓿花犹短，昌蒲叶未齐。\n更衣过柏谷，走马宿棠梨。\n逆旅聊怀玺，田间共斗鸡。\n犹思饮云露，高举出虹蜺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉徽亭","author":"司马光","text":"房公昔漂泊，置酒此鸣琴。\n人事有忧乐，山光无古今。\n风流俱寂寞，结构尚萧森。\n松竹含虚籁，犹疑弦上音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙门","author":"司马光","text":"石楼临晴空，南眺出千里。\n人怜山气佳，予叹禹功美。\n想彼未凿时，极目皆洪水。\n谁知耕桑民，幸免鲂与鲤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仲庶同年兄自成都移长安以诗寄贺","author":"司马光","text":"蚕丛龟印解，鹑野隼旟新。\n借问锦江乐，何如兴庆春。\n骊歌遮去辙，竹马望行尘。\n惠政如膏雨，遥知彼此均。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伏蒙留守相公赐示陪太师潞公东田宴集诗辄敢属和","author":"司马光","text":"舞雩新雨浃公田，水满东溪上下天。\n行径乍迂初见笋，浮舟正好未生莲。\n弦收裂帛胡琴阕，袖结清风楚舞妍。\n相国火城光满路，夜归不假玉蟾圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伫月亭","author":"司马光","text":"灯火动鱼矶，湖边过鸟稀。\n孤蟾久未上，五马不成归。\n长啸风生座，高吟露满衣。\n闲情无日厌，岸帻对清晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"先春亭","author":"司马光","text":"园林近铃阁，旦夕被仁风。\n自得芳菲早，岂将疏远同。\n冰开半塘绿，雨借数枝红。\n会待韶光遍，还应到野丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光诗首句云饱食复闲眠又成二章 其一 饱食","author":"司马光","text":"钱少何须万，杯多不过三。\n龟肠本易足，熊掌讵宜贪。\n散步竹斋外，高吟柳径南。\n此心无所用，脱粟亦深惭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光顷为诸生常受经于钱丈学赋于张丈今乃叨忝同为侍臣蒙钱丈置酒张丈赐诗不胜愧悚之深言志为谢","author":"司马光","text":"畴昔胜冠日，曾为绛帐生。\n九言闻至教，一顾得虚声。\n不意叨严近，于今接老成。\n宁须诗酒赐，侍坐导知荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"光皇祐二年谒告归乡里至治平二年方得再来怆然感怀诗以纪事","author":"司马光","text":"十六载重归，顺涂歌式微。\n青松弊庐在，白首故人稀。\n外饰服章改，流光颜貌非。\n巫咸旧山色，相见尚依依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送龚章判官之卫州","author":"司马光","text":"几砚昔年游，于今成十秋。\n松坚终发石，鱼变即辞流。\n近郡无飞檄，清时不借筹。\n淇园春竹美，军宴日椎牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和邵尧夫年老逢春","author":"司马光","text":"年老逢春犹解狂，行歌南陌上东冈。\n晴云高鸟各自得，白日游丝相与长。\n草色无情尽眼绿，花林多思袭人香。\n吾侪幸免簪裾累，痛饮闲吟乐未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和伯常见寄","author":"司马光","text":"诛茅宋玉宅边人，知醉宜城几瓮春。\n细雨短蓑渔向市，孤村极浦鼓迎神。\n遍游七泽身忘倦，更赋千篇意转新。\n不必沧浪羡清泚，向来缨上已无尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"华清宫","author":"司马光","text":"新丰鸡犬稀，蓟北马秋肥。\n金殿翠华去，玉阶红叶飞。\n荒林上路废，温谷旧流微。\n嗟此非人事，何须问是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同次道元日宿尚书省听戒誓寄常州卲不疑","author":"司马光","text":"椒花献岁新，瑄玉侍祠频。\n此夕同华省，非才愧后尘。\n江风迎茜旆，沙雨待朱轮。\n不比斋宫冷，端居弃掷春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同宋次道陪宴琼林","author":"司马光","text":"冠盖连翩数里尘，帝家全借上林春。\n鹓行不动烟霞秀，龙角正高雷雨新。\n喜气晴曛宫树绿，飞花醉堕玉卮频。\n蒲萄卢橘应相识，半是当年举酒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕宣徽挽歌二首 其二","author":"司马光","text":"维岳人皆仰，长城众所依。\n远猷方克壮，昭世忽长违。\n象设俨如在，英灵窅不归。\n唯应令名久，竹素蔼馀辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕宣徽挽歌二首 其一","author":"司马光","text":"奕世台衡贵，盈门绂冕荣。\n遐方流惠化，殊俗詟威声。\n宥密资忠力，安平寄老成。\n遽骑箕尾去，何以慰苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕禄庙","author":"司马光","text":"赤帝祚四百，徒然诸吕谋。\n出游逢友卖，未返见家收。\n弊冢昔无记，遗祠今幸留。\n士心俱左袒，何怨曲周侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安之令子河阳官舍作蛙乐轩安之有诗寄题辄敢继和","author":"司马光","text":"鼓吹娱俗耳，蛙鸣惬雅怀。\n最宜凉雨歇，更与晚风偕。\n骥子方长骛，云衢偶未谐。\n功名当努力，留此遗吾侪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安之朝议哀辞二首 其二","author":"司马光","text":"乐易春阳暖，孤高秋气清。\n老惟知自适，贫不问为生。\n京兆开阡贵，延陵题墓荣。\n如何帝师笔，纯孝纪名卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"安之朝议哀辞二首 其一","author":"司马光","text":"场屋推声价，朝绅仰典型。\n朱衣老卿列，白首恋亲庭。\n舟壑一朝失，泉台万古扃。\n音容宛在目，争免净飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"庆文公八十会口号","author":"司马光","text":"元勋茂德古无伦，海内高闲第一人。\n台席已酬调鼎志，磻溪还作钓鱼身。\n师臣首冠三旌贵，岁历行开九十新。\n愿过期颐跻上寿，飞觞四十有馀春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏书宋子才止足堂","author":"司马光","text":"举世恋荣禄，夜行无乃劳。\n独君年未至，止足一何高。\n矮制乌纱帽，宽裁白氎袍。\n华榱坐终日，闲按紫檀槽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏呈尧夫","author":"司马光","text":"近来朝野客，无坐不谈禅。\n顾我何为者，逢人独懵然。\n羡君诗既好，说佛众谁先。\n只恐前身是，东都白乐天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早行","author":"司马光","text":"寒犬吠柴门，荒鸡鸣远村。\n河声空自急，月影不曾浑。\n木末星犹白，榛中露已繁。\n客心独惆怅，四顾与谁言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早春 其二","author":"司马光","text":"璿霄转斗车，春意逼梅花。\n熟寐侵街鼓，闲情到酒家。\n晴阳浮地末，寒色敛天涯。\n归雁空馀迹，朝来印浦沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早春寄东郡旧同僚","author":"司马光","text":"楼台带馀雪，寒色未全收。\n久负入关意，空为同舍羞。\n清樽接胜友，飞盖从贤侯。\n应恨春来晚，烟林已数游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早朝书事","author":"司马光","text":"太白明如李，东方三丈高。\n晨光孤照阙，雾气湿侵袍。\n槐柳经霜惨，骅骝得路豪。\n素餐无小补，俛仰愧金鳌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"资善堂宴饯应诏","author":"司马光","text":"士论归清德，皇心重老成。\n陈谟侍经席，得谢解尘缨。\n坐密金章并，行徐玉醴清。\n都门昔供帐，疏傅未为荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和王胜之十二月十五日朝退马上作","author":"司马光","text":"瓦沟微白雪光清，阙角初红海日腾。\n尘息长街千骑入，鞘鸣深殿六龙升。\n云岩有客空回首，圭荜何人尚曲肱。\n自笑鲰生章绶缚，不容逃去正如罾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和冲卿中秋胧月","author":"司马光","text":"岂无锦幄翠帘垂，匝树明灯正赫曦。\n共惜月华方满夜，更当秋色中分时。\n乌皮几稳风侵鬓，白玉楼高冷透肌。\n千里浮云何处断，北来试问雁应知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和江邻几九月五日省直","author":"司马光","text":"群驺布路歆，瘦马解鞍回。\n雨阕虫声乐，秋深菊意催。\n图书纷自适，僚友邈谁陪。\n何以消寒夜，残醪不满杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵谢杜祁公借观五老图","author":"司马光","text":"脱遗轩冕就安闲，笑傲丘园纵倒冠。\n白发忧民虽种种，丹心许国尚桓桓。\n鸿冥得路高难慕，松老无风韵自寒。\n闻说优游多唱和，新篇何惜画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祁国正献公挽歌三首 其三","author":"司马光","text":"先子同乌府，知音诚皦然。\n脱缞来拜伏，抚首辱哀怜。\n迨此泉扃掩，空悲尘网牵。\n无由怀酒絮，撇涕望新阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祁国正献公挽歌三首 其二","author":"司马光","text":"钧玉吴台旧，诛茅梁苑新。\n位登华衮贵，家似布衣贫。\n直道高当世，清风遗后人。\n千秋寒照目，竹帛不栖尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祁国正献公挽歌三首 其一","author":"司马光","text":"舟楫才猷大，冰霜德操坚。\n陶钧成茂业，书史乐高年。\n瞻望簪绅共，吁嗟馆舍捐。\n举时无异论，方信令名全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹坞","author":"司马光","text":"二何迹相继，竹坞日阴森。\n欲识养民意，先观爱物心。\n低垂樽俎冷，密映管弦深。\n勿怪湖光少，年来碧影侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自嘲","author":"司马光","text":"英名愧终贾，高节谢巢由。\n直取云山笑，空为簪组羞。\n浮沈乖俗好，隐显拙身谋。\n惆怅临清鉴，霜毛不待秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自嘲","author":"司马光","text":"盘飧罗新蔬，充腹不求馀。\n穷巷昼扃户，闲轩卧读书。\n有心齐塞马，无意羡川鱼。\n世道方邀逐，如君术已疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致政王侍郎挽歌二首 其二","author":"司马光","text":"振鹭辞灵沼，冥鸿翔太虚。\n清朝解鸣玉，旧里挂安车。\n诗酒江山胜，园林俸禄馀。\n所忠今不往，谁奏茂陵书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致政王侍郎挽歌二首 其一","author":"司马光","text":"弱冠献奇策，居然终贾才。\n赋成平乐馆，歌奉柏梁杯。\n丽藻留昭世，英游隔夜台。\n土中埋美玉，谁见不兴哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖","author":"司马光","text":"佳丽三吴国，湖光荡日华。\n鱼惊动蘋叶，燕喜掠杨花。\n云过山腰黑，风驱雨脚斜。\n烟波遥尽处，彷佛见渔家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西溪公宴 其二","author":"司马光","text":"谢守爱山水，军城况不赊。\n鱼惊避落叶，鸟倦立浮查。\n古柏依冈远，垂杨带岸斜。\n秋风吹急管，一曲度荷花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西溪公宴 其一","author":"司马光","text":"五马非从乐，西城念劝功。\n翠帷低映水，红旆不胜风。\n叶脱青山静，云归碧落空。\n淹留尽佳兴，新月渐朦胧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初到洛中书怀","author":"司马光","text":"三十馀年西复东，劳生薄宦等飞蓬。\n所存旧业惟清白，不负明君有朴忠。\n早避喧烦真得策，未逢危辱好收功。\n太平触处农桑满，赢取闾阎鹤发翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别一章改韵同五诗呈尧夫","author":"司马光","text":"家虽在城阙，萧瑟似山阿。\n远去名利窟，自称安乐窝。\n云归白石洞，鹤立碧松柯。\n得丧非吾事，何须更寤歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别聂之美","author":"司马光","text":"客宦常漂泊，离怀徒自劳。\n贫无衣换酒，空有涕沾袍。\n木叶寒犹在，江湖暮更豪。\n行舟远不见，赖有片帆高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别韵一首","author":"司马光","text":"风日虽寒昼景长，探春远访白莲庄。\n岸冰犹在水先绿，柳叶未生条已黄。\n老木根侵苔径窄，新梅花入酒卮香。\n天真不必人修饰，得趣勿嫌台馆荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"君贶环溪","author":"司马光","text":"地胜风埃外，门深花竹间。\n波光冷于玉，溪势曲如环。\n荣路回翔厌，华轩啸咏闲。\n堪羞谢太傅，不复到东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴正肃公挽歌辞三首 其三","author":"司马光","text":"念昔少年日，谬登君子堂。\n重言何以称，厚德不能忘。\n玉麈声容在，泉台岁月长。\n凭谁寄清泪，为我洒松冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴正肃公挽歌辞三首 其二","author":"司马光","text":"辞华已独步，政治复无前。\n吏不容三穴，民皆戴二天。\n于今知和寡，自古愧才偏。\n惆怅棠阴下，仁风尚蔼然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴正肃公挽歌辞三首 其一","author":"司马光","text":"皇家延茂异，鹗立迥无伦。\n高议谁能夺，英才自有真。\n骅骝宁受絷，水鉴不栖尘。\n试为咨清论，风流第几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":24143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]