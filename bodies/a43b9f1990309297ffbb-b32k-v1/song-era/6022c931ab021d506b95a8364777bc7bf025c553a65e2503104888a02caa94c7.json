[{"title":"杏花","author":"朱淑真","text":"浅注胭脂剪绛绡，独将妖艳冠花曹。\n春心自得东君意，远胜玄都观里桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11592,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梨花","author":"朱淑真","text":"朝来带雨一枝春，薄薄香罗蹙蕊匀。\n冷艳未饶梅共色，靓妆长与月为邻。\n许同蝶梦还如蝶，似替人愁却笑人。\n须到年年寒食夜，情怀为你倍伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11593,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"茶蘼","author":"朱淑真","text":"花神未怯春归去，故遣仙姿殿后芳。\n白玉体轻蟾魄瑩，素纱囊薄麝脐香。\n梦思洛浦婵娟态，愁记瑶台淡净妆。\n勾引诗情清绝处，一枝和雨在东墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11594,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶得牡丹数本移植窗外将有著花意二首 其一","author":"朱淑真","text":"王种元从上苑分，拥培围护怕因循。\n快晴快雨随人意，正为墙阴作好春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11595,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶得牡丹数本移植窗外将有著花意二首 其二","author":"朱淑真","text":"香玉对春未啄花，露根烘晓见红霞。\n自非水月观音样，不称维摩居士家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11596,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瑞香","author":"朱淑真","text":"玲珑巧蹙紫罗囊，今得东君著意妆。\n带露欲开宜晓日，临风微困怯春霜。\n发挥名字来雕辇，弹厌芳菲入醉乡。\n最是午窗初睡省，重重赢得梦魂香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11597,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柳","author":"朱淑真","text":"万缕千丝织暖风，绊烟留雾市桥东。\n砌成幽恨斜阴里，供断闲愁细雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11598,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柳絮","author":"朱淑真","text":"缭绕晴空似雪飞，悠扬不肯著尘泥。\n花边娇软黏蜂翅，陌上轻狂趁马蹄。\n贴水化萍随浪远，弄风无影度墙低。\n成团作阵愁春去，故把东君归路迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11599,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻子规有感","author":"朱淑真","text":"花落花开事可悲，等闲一醉失芳菲。\n园林初听莺声涩，庭径俄看蝶粉稀。\n攲枕夜深无梦到，倚楼天外便魂飞。\n我无云翼飞归去，杜宇能飞却不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11600,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"日永","author":"朱淑真","text":"雨过横塘蛙吹闹，日融芳圃蜜脾香。\n一痕心事难消遣，双鹊飞鸣过短墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11601,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苦热闻田夫语有感","author":"朱淑真","text":"日轮推火烧长空，正是六月三伏中。\n旱云万叠赤不雨，地裂河枯尘起风。\n农忧田亩死禾黍，车水救田无暂处。\n日长饥渴喉咙焦，汗血勤劳谁与语。\n播插耕耘功已足，尚愁秋晚无成熟。\n云霓不至空自忙，恨不抬头向天哭。\n寄语豪家轻薄儿，纶巾羽扇将何为。\n田中青稻半黄槁，安坐高堂知不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11602,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纳凉桂堂二首 其一","author":"朱淑真","text":"微凉待月画楼西，风递荷香拂面吹。\n先自桂堂无暑气，那堪人唱雪堂词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11603,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纳凉桂堂二首 其二","author":"朱淑真","text":"清香满座瓜分玉，明月澄空酒漾金。\n不是夜凉难就醉，一帘秋色竹森森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11604,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅蒸滋甚因怀湖上二首 其一","author":"朱淑真","text":"东风作雨浅寒生，梅子传黄未肯晴。\n戢戢箨龙头角就，温云缭绕变江城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11605,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅蒸滋甚因怀湖上二首 其二","author":"朱淑真","text":"云暗湖光雨四垂，珠玑万斛撒琉璃。\n紫苔阶面寒声急，有甚心情更赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11606,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"纳凉即事","author":"朱淑真","text":"旋折莲蓬破绿瓜，酒杯收起点新茶。\n飞蝇不到冰壶净，时有凉风入齿牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11607,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏雨生凉三首 其一","author":"朱淑真","text":"烈日如焚正蕴隆，黑云载雨泻长空。\n搜龙霹雳一声歇，庭竹潇潇来好风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11608,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏雨生凉三首 其二","author":"朱淑真","text":"崒嵂金蛇殷殷雷，过雷斑驳渐晴开。\n雨催凉意诗催雨，当尽新篘玉友醅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11609,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏雨生凉三首 其三","author":"朱淑真","text":"眼界清无俗事来，要凉更著好诗催。\n凉生还又撩幽恨，留取孤樽对月开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11610,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨过","author":"朱淑真","text":"幽篁脱箨绿参差，雨过微风拂面宜。\n浴罢晚妆慵不御，却亲笔砚赋新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11611,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜雨","author":"朱淑真","text":"赤日炎炎烧八荒，田中无雨苗半黄。\n天工不放老龙懒，赤电驱雷云四方。\n琼瑰万斛写碧落，陂塘池沼皆泱泱。\n高田低田尽沾泽，农喜禾无可槁伤。\n我皇圣德布寰宇，六月青天降甘雨。\n四海咸蒙滂沛恩，九州尽解焦熬苦。\n倾盆势歇尘点无，衣袂生凉罢挥羽。\n江上数峰天外青，眼界增明快心腑。\n炎热一洗无留迹，顿觉好风生雨腋。\n纱厨湘簟爽气新，沉李削瓜浮玉液。\n傍池占得秋意多，尚馀珠点缀圆荷。\n楼头月上云散尽，远水连天天接波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11612,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏夜","author":"朱淑真","text":"花底杯倾演漾金，月边风细竹阴阴。\n故人清远更真绝，消尽烦襟爽气深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11613,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新荷","author":"朱淑真","text":"平波浮动洛妃钿，翠色娇圆小更鲜。\n荡漾湖光三十顷，未知叶底是谁莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11614,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"青莲花","author":"朱淑真","text":"净土移根体性殊，笑他红白费工夫。\n幽姿羞损婵娟女，异色孤芳潋滟湖。\n顾影有情欺水荇，向人无语鄙风蒲。\n一枝摇动清香远，几许诗笺与画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11615,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水栀子","author":"朱淑真","text":"一痕春寄小峰蛮，薝卜香清水影寒。\n玉质自然无暑意，更宜移就月中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11616,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"羞燕","author":"朱淑真","text":"停针无语泪盈眸，不但伤春夏亦愁。\n花外飞来双燕子，一番飞过一番羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11617,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"早秋","author":"朱淑真","text":"一痕雨过湿秋光，纨扇初抛自有凉。\n雾影乍随山影薄，蛩声偏接漏声长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11618,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日登楼","author":"朱淑真","text":"梧影萧疏弄晚晴，残蝉凄楚不堪听。\n楼高望极秋山去，溢眼重重叠叠青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11619,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜杂书二首 其一","author":"朱淑真","text":"雨过凉生枕簟秋，楼头新月挂银钩。\n且无挥扇劳纤手，只好烧香伴酒瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11620,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜杂书二首 其二","author":"朱淑真","text":"窗外蛩吟解说秋，迢迢清夜惜前游。\n月华飞过西楼上，添起离人一段愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11621,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜二首 其二","author":"朱淑真","text":"凉天如水夜澄鲜，桂子风清嫩去眠。\n多谢嫦娥知我意，中秋未到月先圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11622,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜闻雨三首 其一","author":"朱淑真","text":"似箭撩风穿帐幕，如倾凉雨咽更筹。\n冷怀攲枕人无寐，铁石肝肠也泪流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11623,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜闻雨三首 其二","author":"朱淑真","text":"竹窗萧索镇如秋，雨滴檐花夜不休。\n独宿广寒多少恨，一时分付我心头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11624,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜闻雨三首 其三","author":"朱淑真","text":"似篾身材无事瘦，如丝肠肚怎禁愁。\n鸣窗更听芭蕉雨，一叶中藏万斛愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11625,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中夜","author":"朱淑真","text":"冯夷捧出一轮月，河伯吹开万里云。\n寥廓无尘河汉远，水光天影接清芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11626,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月夜","author":"朱淑真","text":"灯花鹊喜两无凭，那更清宵梦不成。\n月上楼头天似洗，愁人别是一般情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11627,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七夕","author":"朱淑真","text":"拜月亭前梧叶稀，穿针楼上觉秋迟。\n天孙正好贪欢笑，那得工夫赐巧丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11628,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋","author":"朱淑真","text":"秋来长是病，不易到中秋。\n欲赏今宵月，须登昨夜楼。\n露浓梧影淡，风细桂香浮。\n莫做寻常看，嫦娥亦解愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11629,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋值雨","author":"朱淑真","text":"积叶冷翻阶，痴云暗海涯。\n楼高劳望眼，天暝隔吟怀。\n宛转愁难遣，团圆事未谐。\n四檐飞急雨，寂寂坐空齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11630,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闷怀二首 其二","author":"朱淑真","text":"秋雨沉沉滴夜长，梦难成处转凄凉。\n芭蕉叶上梧桐里，点点声声有断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11631,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖上闲望二首 其一","author":"朱淑真","text":"照水芙蓉入眼明，败荷枯草闹秋声。\n疏云不雨阴长定，唤起诗怀酒兴清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11632,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湖上闲望二首 其二","author":"朱淑真","text":"薄云疏日弄阴晴，山秀湖平眼界清。\n不必西风吹叶下，愁人满耳是秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11633,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"写怀二首 其一","author":"朱淑真","text":"淡月疏云九月天，醉霜危叶坠江寒。\n孤窗镇日无聊赖，编辑诗词改抹看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11634,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"写怀二首 其二","author":"朱淑真","text":"菊有黄花离槛边，怨鸿声重下寒天。\n偏宜小阁幽窗下，独自烧香独自眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11635,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日述怀","author":"朱淑真","text":"妇人虽软眼，泪不等闲流。\n我因无好况，挥断五湖秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11636,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日偶成","author":"朱淑真","text":"初合双鬟学画眉，未知心事属他谁。\n待将满抱中秋月，分付萧郎万首诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11637,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日晚望","author":"朱淑真","text":"烟浓难认别州山，彷佛鸥群浴远滩。\n一点客帆摇动处，排云给日弄先寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11638,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜牵情三首 其二","author":"朱淑真","text":"檐外秋清绣绮窗，菊烟月露冷浮香。\n寒更二十五声点，相应愁情尔许长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11639,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜牵情三首 其三","author":"朱淑真","text":"闲闷闲愁百病生，有情终不似无情。\n风流意思镌磨尽，离别肝肠铸写成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11640,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏桂四首 其一","author":"朱淑真","text":"弹压西风擅众芳，十分秋色为君忙。\n一枝淡贮书窗下，人与花心各自香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11641,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏桂四首 其二","author":"朱淑真","text":"移根蟾窟不寻常，枝叶犹垂月露香。\n可笑当年陶靖节，东篱犹带菊花黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11642,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏桂四首 其三","author":"朱淑真","text":"酷爱清香折一枝，故簪香髻蓦思维。\n若教水月浮清浅，消得林逋两句诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11643,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"咏桂四首 其四","author":"朱淑真","text":"月待圆时花正好，花将残后月还亏。\n须知天上人间物，同禀秋清在一时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11644,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"堂下岩桂秋晚未开作诗促之","author":"朱淑真","text":"著意裁诗特地催，花须著意听新诗。\n清香未吐黄金粟，嫩蕊犹藏碧玉枝。\n不是地寒偏放晚，定知花好故开迟。\n也宜急趁无风雨，莫待霜高露结时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11645,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白菊","author":"朱淑真","text":"回旋秋色漙清露，淩厉西风紫嫩霜。\n莫作东篱等闲看，下清曾借广寒香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11646,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山脚有梅一株地差背阴冬深初结蕊作绝句寄之","author":"朱淑真","text":"溪桥野店梅都绽，此地冬深尚未寒。\n寄语梅花且宁奈，枝头无雪不堪看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11647,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪夜对月赋诗","author":"朱淑真","text":"一树梅花雪月间，梅清月皎雪光寒。\n看来表里俱清彻，酌酒吟诗兴尽宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11648,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"欲雪","author":"朱淑真","text":"寒雀无声满竹篱，冻云四羃雪将垂。\n北风不看人情面，控勒梅花不放枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11649,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪二首 其一","author":"朱淑真","text":"一夜青山换玉尖，了无尘翳半痕兼。\n寒鸦打食围沙渚，冻雀藏身宿画檐。\n野外易寻东郭履，月中难认塞翁髯。\n梅花恣逞春情性，不管风姨号令严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11650,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪二首 其二","author":"朱淑真","text":"谁剪飞花六出尖，索娥肌肉瑩相兼。\n分明幻玉迷青嶂，轻薄随风入画檐。\n冻笔想停诗客手，寒蓑宜拥钓翁髯。\n长安陋巷多贫士，可见鹑衣透胆严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11651,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪晴","author":"朱淑真","text":"饥禽高噪日三竿，积雪回风堕指寒。\n秀色暗添梅富裕，绿梢明报竹平安。\n冷侵翠袖诗肩耸，春入红炉酒量宽。\n帘外有山千万叠，醉眸浑作怒涛看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11652,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"围炉","author":"朱淑真","text":"圜坐红炉唱小词，旋篘新酒赏新诗。\n大家莫惜今宵醉，一别参差又几时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11653,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"下湖即事","author":"朱淑真","text":"晴波碧漾浸春空，邃馆清寒柳曳风。\n隔岸谁家修竹外，杏花斜袅一枝红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11654,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西楼寄情","author":"朱淑真","text":"静看飞蝇触晓窗，宿酲未醒卷梳妆。\n强调朱粉西楼上，愁里春山画不长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11655,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书窗即事二首 其二","author":"朱淑真","text":"一阵催花雨，高低飞落红。\n榆钱空万叠，买不住春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11656,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜留依绿亭 其一","author":"朱淑真","text":"水鸟栖烟夜不喧，风传宫漏到湖边。\n三更好月十分魄，万里无云一样天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11657,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜留依绿亭 其二","author":"朱淑真","text":"雨换新凉秋兴浓，流萤明灭绿杨中。\n庭虚池印一方月，楼静檐披四面风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11658,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闲步","author":"朱淑真","text":"天街平贴净无尘，灯火春摇不夜城。\n乍得好凉宜散步，朦胧新月弄疏明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11659,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻鹊","author":"朱淑真","text":"墙头花外说新情，拔去闲愁著耳听。\n青鸟已承云信息，预先来报两三声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11660,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"试墨","author":"朱淑真","text":"翠楼高压浙山头，海角湖光豁醉眸。\n万景入帘吹不捲，一般心做百般愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11661,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书王庵道姑壁","author":"朱淑真","text":"短短墙围小小亭，半檐疏玉响泠泠。\n尘飞不到人长静，一篆炉烟两卷经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11662,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"墨梅","author":"朱淑真","text":"若个龙眠手，能传处士诗。\n借他窗上影，写作雪中枝。\n顷刻回春色，轻盈动玉卮。\n不能殷七七，横笛月中吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11663,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月台","author":"朱淑真","text":"下视红尘意眇然，翠栏十二出云颠。\n纵眸愈觉心宽大，碧落无垠绕地圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11664,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"云掩半月","author":"朱淑真","text":"霜月迎寒著意圆，横天云浪碍婵娟。\n嫦娥未肯全梳掠，玉鉴先教露半边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11665,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伤别二首 其二","author":"朱淑真","text":"双燕呢喃语画梁，劝人休恁苦思量。\n逢春触处须萦恨，对景无时不断肠。\n寒食梨花新月夜，黄昏杨柳旧风光。\n繁华种种成愁恨，最是西楼近夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11666,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]