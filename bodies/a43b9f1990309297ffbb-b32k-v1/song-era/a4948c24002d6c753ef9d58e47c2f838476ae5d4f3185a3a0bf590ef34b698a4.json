[{"title":"赠胡人","author":"林逋","text":"妻儿终拟弃，旧识尽名贤。\n高节嫌趋世，常流笑学仙。\n金方烧易得，星度算来玄。\n祇说寻山去，相期已数年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠胡明府","author":"林逋","text":"一琴牢落倚松窗，孤澹天君得趣长。\n谒庙有时封县版，坐衙终日著公裳。\n为收牌印教村仆，偶检图书见古方。\n微足税粮人更静，却支吟策立秋廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠钱唐邑长高秘校","author":"林逋","text":"几万人家山水中，为官古雅少人同。\n疏帘衙退卷花轴，曲槛客来凭竹风。\n唯道簿书多傍俗，自怜琴酒未妨公。\n等闲呵出郭门近，轻棹绕湖寻佛宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠崔少微","author":"林逋","text":"贤才负圣朝，终日掩衡茅。\n尚静师高道，甘贫绝俗交。\n晒碑看壁蠹，蒸朮拾邻梢。\n却忆杨夫子，劳劳事解嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠蒋公明","author":"林逋","text":"高亢近谁同，心闲爱子慵。\n居深避俗客，睡起听邻钟。\n纸轴敲晴响，茶铛煮晚浓。\n南斋屡招宿，幽话数诸峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水亭秋日偶书","author":"林逋","text":"巾子峰头乌臼树，微霜未落已先红。\n凭阑高看复低看，半在石池波影中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"风水洞","author":"林逋","text":"平昔常闻风水洞，重山复水去无穷。\n因缘偶入云泉路，林下先闻接客钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北山晚望","author":"林逋","text":"晚来山北景，图画亦应非。\n村路飘黄叶，人家湿翠微。\n樵当云外见，僧向水边归。\n一曲谁横笛，蒹葭白鸟飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"平居遣兴","author":"林逋","text":"有甚馀闲得解嘲，高慵时把几桯敲。\n卑孜晚鸟沉幽语，历剌烟篁露病梢。\n草野交游披褐见，神仙书史点朱抄。\n皇朝不是甘逃遁，争向心如许与巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伤白积殿丞","author":"林逋","text":"吏散门墙转寂然，疏狂投分向生前。\n苦无名位高今世，空有文章出古贤。\n遗传得谁修阙下，孤坟应祇客江边。\n池阳渺渺堪垂睫，奠罢秋枝一叫蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖与性上人话别","author":"林逋","text":"秋山与湖水，远近如相送。\n后府宿扁舟，知师有归梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闵师见写陋容以诗奉答","author":"林逋","text":"顾我丘壑人，烦师与之写。\n北山终日悬，风调一何野。\n林僧忽焉至，欲揖顷方罢。\n复有条上猿，惊窥未遑下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和运使陈学士游灵隐寺寓怀","author":"林逋","text":"山壑气相合，旦暮生秋阴。\n松门韵虚籁，铮若鸣瑶琴。\n举目群状动，倾耳百虑沉。\n按部既优游，时此振衣襟。\n泓澄冷泉色，写我清旷心。\n飘飖白猿声，答我雅正吟。\n经台复丹井，扪萝常遍临。\n鹤盖青霞映，玉趾苍苔侵。\n温颜煦槁木，真性驯幽禽。\n所以仁惠政，及物一一深。\n洒翰嶙峋壁，返驾旃檀林。\n回睨窣堵峰，天半千万寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和梅圣俞雪中同虚白上人来访","author":"林逋","text":"湖上玩佳雪，相将惟道林。\n早烟村意远，春涨岸痕深。\n地僻过三径，人闲试五禽。\n归桡有馀兴，宁复比山阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"知县李太博得替","author":"林逋","text":"惠爱复公清，三年报政成。\n弦歌敦雅俗，桃李蔼春荣。\n县治尝游刃，朝趋久彯缨。\n相门如有相，他日愿持衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"相思令","author":"林逋","text":"吴山青，越山青。\n两岸青山相对迎。\n争忍有离情。\n君泪盈，妾泪盈。\n罗带同心结未成，江边潮已平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日含山道中回寄历阳希然山人","author":"林逋","text":"村落人家总入诗，下驴盘薄立多时。\n霜陂一掬清于鉴，漱著牙根便忆归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日湖西晚归舟中书事","author":"林逋","text":"水痕秋落蟹螯肥，闲过黄公酒舍归。\n鱼觉船行沉草岸，犬闻人语出柴扉。\n苍山半带寒云重，丹叶疏分夕照微。\n却忆清溪谢太傅，当时未解惜蓑衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送牛秀才之山阳省兄","author":"林逋","text":"之子咏陟冈，别我岁时晏。\n后夜失群鹤，高天著行雁。\n楚山远近出，江树青红间。\n尊酒无足辞，离愁满行盼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送史殿丞之任封州","author":"林逋","text":"炎方将命选朝伦，治行何尝下古人。\n拥旆肯辞临远郡，登舻还喜奉慈亲。\n水连芳草江南地，烟隔寒梅岭上春。\n若过中途值归雁，慰怀能与致音尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送谢尉","author":"林逋","text":"试吏才未申，食贫同古人。\n何以赠行色，一酌湖上春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送僧之京师","author":"林逋","text":"皇城十二衢，埃尘满香裓。\n何以待归期，山中桂花色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃花","author":"林逋","text":"柳坠梅飘半月初，小园孤榭更庭除。\n任应雨杏情无别，最与烟篁分不疏。\n比并合饶皮博士，形相偏属薛尚书。\n薄红深茜尖尖叶，亦有愁肠未负渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"留题李休山居","author":"林逋","text":"俗口喧喧利与名，到君风品即难凭。\n曾将五老关秋梦，只爱南薰是正声。\n鸟恋药棚长独立，树欺诗壁半旁生。\n公车便不能徵出，搔首吾皇负圣明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病中 其一","author":"林逋","text":"坐钓行樵那不倦，寻云看月亦应劳。\n烦襟入夜权宜减，瘦格乘秋斗顿高。\n猿下任窥煎药鼎，客来慵动碾茶槽。\n床头卧架直闲却，免有情憀揭悼骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"监郡太博惠酒及诗","author":"林逋","text":"尘事久谢绝，园庐方晏阴。\n铿然郢中唱，伸玩清人心。\n况复对樽酒，百虑安能侵。\n何以比交情，松桂寒萧森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿洞霄宫","author":"林逋","text":"秋山不可尽，秋思亦无根。\n碧涧流红叶，青林点白云。\n凉阴一鸟下，落日乱蝉分。\n此夜芭蕉雨，何人枕上闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄玉梁施道士","author":"林逋","text":"子云遗构住丹房，天鼓时闻数叩霜。\n真景截波寻铁柱，怪书披月看铜墙。\n氲氲颢气朝胎息，熠熠辰辉夜步纲。\n大静入来诸事罢，灵芜盘穗卷良常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄辇下莫降秀才","author":"林逋","text":"犀围古暗革靴鸣，楚楚衣裾白苧轻。\n节概平时长独立，文章近日合双行。\n且看辇毂千蹄晓，复忆溪山数峰晴。\n一第临临杏花宴，满都春色叫迁莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题僧院庭竹","author":"林逋","text":"岑寂宝坊清夜月，几移疏影上跏趺。\n更怜斋罢闲看处，一日还应不可无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄薛学士","author":"林逋","text":"飞徵偶未下天衢，古郡宽闲且寄居。\n曾许布衣通一刺，每留蔬食看群书。\n高斋已想闲丹灶，清梦谁同话直庐。\n江外敢知无别计，只携琴鹤听新除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舒城僧舍呈赠李仲宣文学","author":"林逋","text":"竹深淮寺雪萧骚，一壁寒灯伴寂寥。\n瘦尽骨毛终騕袅，蚀来锋刃转豪曹。\n宦情冷落诗中见，谈态轩昂酒后高。\n莫为无辜惜才术，圣明求治正焦劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠金陵明上人","author":"林逋","text":"高社似东林，修行岁月深。\n讲多删旧抄，斋早唤幽禽。\n上国名流重，诸方学者寻。\n长因对清话，山阁转松阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇","author":"林逋","text":"金谷年年，乱生春色谁为主？\n余花落处，满地和烟雨。\n又是离歌，一阕长亭暮。\n王孙去，萋萋无数，南北东西路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霜天晓角","author":"林逋","text":"冰清霜洁。\n昨夜梅花发。\n甚处玉龙三弄，声摇动、枝头月。\n梦绝。\n金兽爇。\n晓寒兰烬灭。\n要卷珠帘清赏，且莫扫、阶前雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29113,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"林逋","text":"珠繁杨氏果，翠耀孔家禽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29114,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十二","author":"林逋","text":"天寒络纬悲向壁，秋高风露声入怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29115,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"林逋","text":"草泥行郭索，云木叫钩辀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29116,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"林逋","text":"水天云黑白，霜野树青红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29117,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"林逋","text":"隐非秦甲子，病有晋春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29118,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十一","author":"林逋","text":"算吟千万首，方得两三联。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29119,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"林逋","text":"阴沉天气连翩醉，摘索花枝料峭寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29120,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其六","author":"林逋","text":"风回时带笛，烟远忽藏村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29121,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十","author":"林逋","text":"印文生绿经旬合，砚匣留尘尽日封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29122,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"牵牛花","author":"林逋山","text":"圆似流钱碧剪纱，墙头藤蔓自交加。\n天孙滴下相思泪，长向秋深结此花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29123,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日亭","author":"林通","text":"危顶裁成九日亭，蓬瀛透出海峰青。\n满前细菊浮樽酒，四顾凝云簇画屏。\n月为情多良夜至，人贪景胜醉魂醒。\n风流令尹江山主，此乐同民德已馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29124,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白云亭 其二","author":"林通","text":"双溪会处创危亭，我爱亭成不异名。\n到此更谁分别派，同归终见入东瀛。\n清辉黛染环檐色，幽响琴传出涧声。\n自信竹林林上美，剪裁今已属贤明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29125,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白云亭 其一","author":"林通","text":"白云亭构见浮图，贤尹标名意有馀。\n閒抱石岩禅客座，影笼墨迹宪台书。\n玎珰玉溜无停响，潇洒琅玕不用疏。\n登赏已知情放佚，飘飘应喜类相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29126,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆梅州刘侯修葺程乡学宫落成 其一","author":"林陶","text":"孰不为邦，孰守其乡。\n如被锦衣，昼行辉煌。\n侯曰上恩，曷敢弭忘。\n何以报之，俾民向方。\n言葺泮宫，于乡有光。\n宣圣南面，珠旒衮章。\n十哲侑坐，群贤缋廊。\n六斋分列，小学峙傍。\n谈经议道，春祠秋尝。\n我侯戾止，率由典常。\n闇訚诸生，振鹭来翔。\n诗书礼乐，游息修藏。\n勉尔行业，为时俊良。\n毋毁于随，毋嬉于荒。\n三岁大比，用宾于王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29127,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题太白五松书堂 其四","author":"林桷","text":"为儒为吏两无功，采石铜官邂逅同。\n四见清明今一换，归欤我欲片帆东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29128,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题太白五松书堂 其三","author":"林桷","text":"荡漾清溪两桨飞，趋行不及到斜晖。\n无人跪进雕胡饭，只学卢仝啜茗归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29129,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题太白五松书堂 其二","author":"林桷","text":"千载名山乐有馀，功名常愧十年书。\n英风凛凛无今古，醉草明光一梦如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29130,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题太白五松书堂 其一","author":"林桷","text":"翰林最爱五松山，长说千年未拟还。\n而我抗尘良自愧，来游只得片时閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29131,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠汪孝子","author":"林桷","text":"事死如生实至难，古来不独数丁兰。\n遗骸已逐干戈尽，刻木难忘菽水欢。\n天地一身难养育，子孙百口复团圆。\n吾皇德泽将何报，忠孝垂名两不刊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29132,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金石台 其一","author":"林梦英","text":"云作岩扉风自关，清阴半壑树中间。\n傍厢更著茅亭好，放入西南一面山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29133,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金石台 其二","author":"林梦英","text":"台后漫山十里梅，村南村北总诗材。\n荒寒莫恨无人领，会与奚奴杖屦来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29134,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧涧书堂","author":"林梦英","text":"临川遇邹君，示我铜陵辨。\n相邀游其间，百闻须一践。\n自从双耳聋，已办两足茧。\n武夷乃招隐，仙都辄策蹇。\n遥睇麻源村，梦思劳辗转。\n今披碧涧记，华冈订讹舛。\n疑信吁莫论，是非争之褊。\n但欣泉石奇，堂成书可辇。\n晁侯云梦胸，妙处参坟典。\n家有万竹坡，琳琅閟营剪。\n徘徊康乐旧，此兴尤不浅。\n人生贵自得，假物非至善。\n山川侈遭逢，所托各偕显。\n严光钓越滩，叔子登楚岘。\n气象不低摧，吾徒志当勉。\n相思邀未到，烟霞自舒卷。\n唯应原上月，共照人孤狷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29135,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 温陵东湖次陈休齐体仁韵","author":"林淳","text":"潇洒东湖上，夜雨洗清秋。\n朝来尘霁，凝望千里兴悠悠。\n山色揉蓝深染，波影青铜新铸，□冷翠光浮。\n蓑笠真吾事，聊整钓鱼钩。\n坐中客，凌王谢，更风流。\n一觞一咏，豪俊谈笑气吞牛。\n花月连环长好，到处名园池□，遇景且遨游。\n试问陶元亮，底事赋归休。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29136,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其一 次赵帅开西湖韵","author":"林淳","text":"湖波涨新绿，环绕越王山。\n棠斋清昼馀暇，赢得静中观。\n四面屏围碧玉，十里障开云锦，冰鉴倒晴澜。\n目送孤鸿远，心与白鸥闲。\n隘游人，喧鼓吹，杂歌欢。\n晓天澄霁，花羞柳妒怯春寒。\n好在风光满眼，只恐阳春有脚，催诏下天关。\n剩写鹅溪幅，归去凤池看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29137,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其三","author":"林淳","text":"螺水亘千古，鳌顶冠三山。\n年丰帅阃尘静，栏槛纵遐观。\n四望潮登浦溆，万顷绿浮原野，堤岸溢波澜。\n畎浍皆沾足，日永桔槔闲。\n肆华筵，鱼鸟乐，众宾欢。\n良辰好景，年年莫放此盟寒。\n且念新湖遗爱，莫作故园遐想，到处是乡关。\n勋业知非晚，聊把镜频看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29138,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其二","author":"林淳","text":"疏水绕城郭，农利遍三山。\n使君重本，雅志初不在游观。\n化出玉壶境界，挥洒锦囊词翰，笔下涌波澜。\n天巧无馀蕴，意匠自舒闲。\n拥鳌头，民同乐，颂声欢。\n养花天气，云柔烟腻护朝寒。\n桃李满城阴合，杨柳绕堤绿暗，幽鸟语间关。\n似诉风光好，留与后人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29139,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳梢青","author":"林淳","text":"富贵园林。\n清虚清馆，随意登临。\n物外风光，云明花媚，鸟语烟深。\n徐徐缓辔微吟。\n迤逦度、松间柳阴。\n览遍幽奇，小舟归晚，月映波心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29140,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 忆西湖","author":"林淳","text":"却忆西湖烂漫游。\n水涵山影翠光浮。\n轻舟短棹不惊鸥。\n带露精神花妩媚，依风情态柳温柔。\n莺歌燕语巧相留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29141,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 郑尚书席上再作","author":"林淳","text":"冒雪休寻访戴船。\n红炉剩爇宝香然。\n阁儿煨暖两三椽。\n更有玉杯传素手，梅花相对两争妍。\n停杯听唱月娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29142,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其二","author":"林淳","text":"烛花呈灿。\n瑞气满筵春欲烂。\n月色中宵。\n疑是阶前雪未消。\n骚人词客。\n魂断蜡梅香已籍。\n谁更情关。\n一点新愁入远山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29143,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其一 郑尚书席上借前韵","author":"林淳","text":"嫣然笑粲。\n醉靥融滋春意烂。\n侍宴终宵。\n欢动帘帏酒易消。\n尊前狂客。\n惊见蕊仙新谪籍。\n珠阁深关。\n丹就同归海上山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮","author":"林淳","text":"鹅溪净称烟笼月。\n澄心白称光浮雪。\n净白两俱宜。\n天然浓淡枝。\n花光神意远。\n吮墨含毫浅。\n依约有香来。\n春风随手开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹧鸪天 西湖","author":"林淳","text":"天近袄知雨露浓。\n湖山无日不春风。\n闲花野草皆掀舞，曾在君王顾盼中。\n时易得，会难逢。\n朝为逆旅暮三公。\n蛟龙得雨飞无便，鸡犬腾云夙有功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]