[{"title":"和无适四时赋雪梅 其四","author":"王柏","text":"寄言青女莫来宾，闻道长安冻杀人。\n应瑞丰年占尚远，忧时君子虑方新。\n幸闻北境无他警，更喜东皇已问津。\n有客方携诗到手，天才端的是祥麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仰庵池上梅韵","author":"王柏","text":"窗外梅兄不可无，山人一见两眉舒。\n江头千树应难得，池上数根宜有馀。\n蟾魄浮香无定相，虬枝压水可常居。\n只愁疏影翻多事，一片清光不得虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和伯兄适庄访立斋","author":"王柏","text":"园林襟带两三家，翁季怡怡意度嘉。\n时把酒杯倾月影，或烧石鼎煮天花。\n青编有味毋吾隐，白发无情任汝加。\n翠竹数竿新映石，岁寒只此是生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和汪元思喜雨韵","author":"王柏","text":"龙蛰金瓶小，神驱雨阵斜。\n建瓴飞素练，走涧舞生蛇。\n风使开云磨，雷香隐炮车。\n农人有骄色，一饱不须赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和易岩兰菊韵","author":"王柏","text":"小春天气未和平，冷暖于人孰重轻。\n幽菊瘦兰皆有味，凄风楚雨自无情。\n披来破衲便身稳，写到新诗彻骨清。\n个里不知谁得失，薰莸境界要分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和易岩首夏韵","author":"王柏","text":"垂老东君恋旧寒，惜春情绪正孤单。\n笑它功业传千古，还我诗书博一安。\n芍药阶前风味浅，酴醾架上典刑残。\n勒回春色凭诗句，生意津津上笔端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和易岩梅下韵","author":"王柏","text":"梅送清香到酒边，东君伎俩已先传。\n棱棱梢外殊无冷，点点花中各有天。\n霜洁冰清时未正，风和日暖老相便。\n一杯适意毋空度，添一年时减一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和易岩喜雨韵 其一","author":"王柏","text":"转移剧暑若艰难，谁谓炎凉反掌间。\n狐鼠就擒元愤郁，旄倪相庆便清閒。\n雨声恰似政声好，天意翻嗤诗意悭。\n一饱所关诚大矣，吾侪安得不开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和易岩喜雨韵 其二","author":"王柏","text":"歊烦一转亦何难，只在邦君念虑间。\n社鼠城狐才就絷，土龙刍狗便投闲。\n平时真见天人密，顺处不疑霖雨悭。\n梦里忽闻风力猛，定知千里破愁颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和易岩韵","author":"王柏","text":"一身之外总虚名，未必虚名果有情。\n诩诩交游何足恃，区区世味本来轻。\n三春已过犹无雨，四海将枯只是晴。\n利害所关天样大，一豪得失岂难平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和秋涧惠兰韵","author":"王柏","text":"竹兰臭味古来同，同处元非造化工。\n墨竹方生秋涧上，紫兰已到鲁斋中。\n筑台移玉尊清惠，运笔挥金尚古风。\n却似高人来伴我，幽芬日日透帘栊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和胡子升大欠韵","author":"王柏","text":"能践其形亦甚难，天高地下我中间。\n读书未造精微阃，处世应迷利欲关。\n勉勉工夫何假字，区区绘事岂真颜。\n须知天赋元无欠，还尔当时勿恃还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵师日韵二首 其二","author":"王柏","text":"我生无燕颔，四壁笑相如。\n门巷堪罗雀，灯窗且读书。\n老来心事懒，贫后故人疏。\n尚有多情月，时时到子庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵师日韵二首 其一","author":"王柏","text":"佳士温其玉，相亲意豁如。\n窗前千个竹，灯下一编书。\n交道无穷达，人情自密疏。\n清风明月夜，或可访吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和通斋密窝韵二首 其二","author":"王柏","text":"密密窝中克己私，人心才动最惟危。\n诚身有道须明善，暗室之中莫自欺。\n凛凛知风知显处，兢兢不睹不闻时。\n圣师欲到无言地，子贡当年也未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和通斋密窝韵二首 其一","author":"王柏","text":"密密窝中养妙倪，恐因题扁被人知。\n了无声臭谁能测，纵有神明岂足窥。\n此外不忧还不惧，于中何虑更何思。\n浩然一气充天地，谁道吾侪老未衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和得全喜雪韵 其二","author":"王柏","text":"瞻彼西山紫翠间，百年遗族备艰难。\n一区济济虽孤立，万物原原得静观。\n举世莫知黄发贵，何人肯伴白云寒。\n相将共折长亭柳，况是残梅已著酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和得全喜雪韵 其一","author":"王柏","text":"天道流行自有经，一冬常燠大无伦。\n临期飞雪粗成冷，只隔明朝便是春。\n窗外晓山高积玉，梦回夜月更铺银。\n玄冥恰似轮台悔，改过虽新已误人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曹西溆明月楼韵 其一","author":"王柏","text":"宣和栋宇镇东城，平野苍然一眺明。\n叠嶂有情宜晚对，两溪无奈向西倾。\n招邀风月标严句，麾斥云烟醒鲁楹。\n谁倚阑干来点检，渡头终日有舟横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和硕夫兄五松韵","author":"王柏","text":"重开甲子旧年华，莫问行程差不差。\n幸有数杯浇舌本，不须一笔镂心花。\n岁无腊雪非人福，时到春风不我赊。\n两手托天缘有气，箪瓢陋巷也为家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和喜雨韵","author":"王柏","text":"体天生物以为心，喜读箕畴好雨星。\n我已不疑丰见斗，君今何虑井羸瓶。\n只缘报国推心赤，自是忧民感帝青。\n若旱作霖人望久，雄风那数快哉亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和遁泽初夏韵二首 其二","author":"王柏","text":"深深陋巷更深藏，袜线曾无一寸长。\n学问不宜随苟且，传闻何敢喜张皇。\n一池科斗书千古，满径风骚竹万章。\n此意寂寥谁与共，美人只在水之阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和遁泽初夏韵二首 其一","author":"王柏","text":"万古南薰与舜同，何时吹入五弦中。\n百年乔木支秋哨，一旦新萌长露丛。\n世事渐如宣子日，诗情犹有大王风。\n来牟丝枲新勋业，更有何人咏大东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和遁泽雨中韵 其一","author":"王柏","text":"梅霖博得遁翁怜，磊磊诗邮忽到前。\n噀雾扫清尘外马，瀑泉呼起耳中蝉。\n妨它种事并芒事，知是丰年或歉年。\n陋巷一瓢应易足，更无思虑且安眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和遁泽雨中韵 其二","author":"王柏","text":"一雨踰旬势未休，微寒犹欲衣轻裘。\n水精颗颗留蛛网，土脉层层起蚁楼。\n正免客车频倒屣，莫将诗句苦埋头。\n书生事业浩如海，鞭辟尤思友谊稠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和遁泽喜雨韵二首 其二","author":"王柏","text":"叶下亭皋半月秋，风飞雷厉起云头。\n一奁返照收林樾，万派飞泉响浍沟。\n放郑贤侯初下令，乞灵拙士未能瘳。\n吾侪且说维鱼梦，那问驱车相国愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和遁泽喜雨韵二首 其一","author":"王柏","text":"久欲飞山试笋车，避炎情绪未能嘉。\n读书求道调心马，制药无方遣睡蛇。\n天地秋来催祭鸟，池塘雨过闹私蛙。\n病夫推枕幡然起，骨健神清眼不华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和遁泽韵取临江叔父墨梅","author":"王柏","text":"我翁久驾白云归，谁宝冰绡一旧枝。\n疏影暗香浮戏墨，光风霁月惠仙姿。\n只疑和靖旧争长，纵是逃禅甘伏雌。\n寄语古樵毋睥睨，青毡归我不应迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和德夫弟韵","author":"王柏","text":"偶寻沮溺问年丰，负笈肩琴恨不同。\n春草池塘君有梦，秋风灯火我何工。\n年时犹愿文加进，老大方忧道未洪。\n妙手自堪修五凤，绳枢草舍愧吾穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐呈外舅 其二","author":"王柏","text":"略无家具可经营，有子顽冥秘锢深。\n岁月自催忙里客，功名不著静中心。\n诗非得意贫难遣，酒已忘情恨莫禁。\n坐对冰翁无可语，孤灯残火伴清吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐呈外舅 其一","author":"王柏","text":"伤春心事正无聊，短发萧萧任意搔。\n旋买茶芽清睡思，不须酒力助诗豪。\n生涯狭处饭多味，世路险时才忌高。\n我为独醒愁不奈，羡君万事赴陶陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孟冬朔旦修翁诞辰韦轩府判寺簿同宴与三侄孙忝陪于僎介之间以纪其事","author":"王柏","text":"招徕二老冠耆英，宝鼎氤氲俎豆珍。\n南极玉绳浮列宿，西屏綵袖祝千春。\n亲亲同醉杯中渌，老老深推膝下仁。\n看取来年宣劝处，松椿桃李转鸿钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"举业有感","author":"王柏","text":"后世求才术太疏，三年三日判荣枯。\n消磨岁月莫知老，奔走英雄不觉愚。\n与死为邻犹未已，虽生在世却如无。\n圣门反在揶揄内，何敢忠言请改图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南省有感","author":"王柏","text":"魁文不过欲趋新，从此相疏有几人。\n个里未知全是命，平时无用苦劳神。\n后先难必三年事，得失同归万古尘。\n堪笑近来狂士计，求荣就辱太迷津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春归","author":"王柏","text":"春来春去果何心，静坐焚香细细评。\n太极流行千古事，一元发育四时情。\n黄堆稼穑谁勋业，绿到桑麻已老成。\n舒惨荣枯人自异，此中生意本分明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"科举","author":"王柏","text":"纷纷衿佩止时文，竞巧趋新做日程。\n一试奔驰天下士，三年冷暖世间情。\n清朝不许人心坏，举子安知天爵荣。\n所用是人行是学，不知何日可升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迷道有感次韵","author":"王柏","text":"未识大安道，行行多路岐。\n人言讹近远，山路倍嵚巇。\n自有康庄处，多因便捷移。\n我今知堠子，万里不须疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送马秋山寄友人","author":"王柏","text":"赤城千古一东湖，谁肯重开太极图。\n要得斯文传气脉，定须吾党立规模。\n圣贤不尽七分易，天地长存三字符。\n念念服行方是学，莫将枝叶费工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送金华赵宰二首 其二","author":"王柏","text":"六龙潜处起宗英，来作金华有脚春。\n人被抚摩称是佛，事归听断果如神。\n忍看凫舄双飞去，趁得葭灰一点新。\n近世柏台冠豸者，多求作邑有声人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送金华赵宰二首 其一","author":"王柏","text":"弦歌声里一瓢安，士友催诗送长官。\n律己十分无可议，爱民一念未尝寒。\n更知耐事如公少，留取清名作样看。\n百姓越疆归令问，恩流职外此尤难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送耐翁住天柱延恩","author":"王柏","text":"换却钳锤过赤城，先声知已沸腾腾。\n当机棒喝须端的，护法神通莫尽凭。\n脚底涌泉同瑩洁，脊梁天柱共崚嶒。\n果符鼓棹沧溟句，海角元来欠一灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵书记二首 其二","author":"王柏","text":"只将精识作生涯，评古论今吐粲花。\n玉洁冰清官自大，云飞川泳吏无哗。\n伟人落落难重见，馀子纷纷未足誇。\n老我不能歌颂语，杯中须减饭须加。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵书记二首 其一","author":"王柏","text":"相逢虽晚意无加，满腹经纶肯浪誇。\n雅兴屡陪郊外乐，清谭不尚酒边哗。\n忍于柳驿攀金缕，记取梅坡嚼玉花。\n木落山空平野阔，浩然别思满天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵素轩去婺守为本道仓使","author":"王柏","text":"人物乾淳旧典型，满腔全是远庵仁。\n来时懒作三刀梦，去日留为一道春。\n千里桑麻深雨露，双溪风月更精神。\n出门父老欢迎处，犹有文公旧郡民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送硕夫兄之武昌","author":"王柏","text":"年年征袖拂孤篷，饱历风霜似有功。\n行李又谋千里外，别情多在数联中。\n骚骚荻岸飘新白，索索枫江落冷红。\n若遇雁音频寄字，寒窗时欲对清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"适庄兄游山","author":"王柏","text":"谁阁重阴一日晴，清游应是惬高情。\n遥知雨后山光好，但想云边屐齿清。\n素壁虽曾题旧字，沈痾不许插新盟。\n因知关吏留鱼钥，谩遣奚奴候晚程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重题八咏","author":"王柏","text":"楼压重城万井低，星从天阙下分辉。\n伤心风月诗应瘦，满眼桑麻春又肥。\n山到东南皆屹立，水流西北竟同归。\n倚阑莫问齐梁事，断石凄凉卧落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭钱学老","author":"王柏","text":"鲁国黔娄死，升堂吊者谁。\n不邪能至此，千载有妻知。\n凛凛默成德，清风百世师。\n舅甥贫到底，终老外家祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽丁知县","author":"王柏","text":"蚤识北平贵，从游五十年。\n迟迟登虎榜，急急到凫仙。\n振起非无地，荣枯自有天。\n老成彫落尽，一壑锁苍烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽邓夫人","author":"王柏","text":"霜冷留宾发，心融篆贝经。\n疏金重锦诰，琢玉璨芝庭。\n方禄参军养，俄丹寿母铭。\n可怜萱草露，也解泣仪形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽司直兄 其一","author":"王柏","text":"老厌鸳行武，骑鲸不肯留。\n空存丹棘谳，未告紫宸猷。\n黄老辜初志，青山飏晚谋。\n夕阳无限好，心事竟悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽司直兄 其二","author":"王柏","text":"典重班诸老，声名始璧流。\n开尊口佳士，襆被闯前脩。\n月冷金闺籍，尘生玉杖鸠。\n梅岩伤目处，雁影正宾秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽司直兄 其三","author":"王柏","text":"晚始亲荆玉，劬愉气谊稠。\n泰坛霜月下，暑枕夜江头。\n一困关公念，连书释我忧。\n平生知己泪，寂寞洒新楸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽朱侍郎","author":"王柏","text":"蚤亚魁躔入谏坡，却因忠谠蹈风波。\n龙墀一去江湖远，鹤骨归来岁月多。\n紫橐将随时事转，丹旌无奈夜舟何。\n万松苍翠皆亲种，月露凄凄泣陇阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽朱侍郎 其一","author":"王柏","text":"国论多同异，身名有险夷。\n一从离紫橐，再不上丹墀。\n慷慨风云断，飘零岁月移。\n却因閒得早，冷眼看人痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽朱侍郎 其二","author":"王柏","text":"渺渺康湖水，峨峨蜀野山。\n是翁元不死，蜕骨此中间。\n草木券台绿，莓苔翁仲斑。\n白云伤北望，清泪更潸潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽何南坡 其二","author":"王柏","text":"少公禀气后三年，易箦翻居三日先。\n学数弟兄犹间有，寿随父母独谁全。\n悲哉易感精神往，造化难凭祸福迁。\n应恨南山人远去，从今独卧北山阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽何南坡 其一","author":"王柏","text":"刻苦工夫真实心，一言体用已全陈。\n圣贤断续三千载，伯仲渐摩八十春。\n保护斯文勤且让，作成吾党敬而亲。\n我来不复瞻耆德，流水苍烟迹已尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽何南坡 其三","author":"王柏","text":"篱落纵横一径分，平生杖屦几登临。\n某山某水机缄露，彼室彼庐精分深。\n检校旧规心欲折，摩挲新志泪难禁。\n素车白马人归后，鹤唳猿啼总些音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽张佛子 其二","author":"王柏","text":"陟屺虽频莫慰心，见公犹幸母如存。\n东山何事遽陈迹，西路如今又断魂。\n柳翣忽临新冢道，林花空满旧时园。\n一衿和气归何处，化作功名遗子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽张佛子 其一","author":"王柏","text":"嘉庆图传世所稀，夫何佛子遽西归。\n平生施予心无为，时事艰难众有依。\n德谊百年犹积累，诗书五世渐光辉。\n儿童父老倾山谷，洒泪追随丹旐飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽汪约叟 其一","author":"王柏","text":"幸有灵光在，天乎作么亡。\n生来最真实，病里亦康强。\n和气留丹鼎，清尘凝笔床。\n溪山呈秀处，风露悄凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽汪约叟 其二","author":"王柏","text":"忆昔先君子，金兰气味投。\n中间有生死，一别几春秋。\n晓漏传幽梦，英魂觅旧游。\n城东烟月冷，应是访新丘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽思泉居士 其二","author":"王柏","text":"犹记年时访故山，细聆旧话侍清閒。\n汲泉倚杖临荒甃，寻塔呼僮斸野菅。\n回首恍如前日事，伤心已隔夜泉关。\n手携菖歜歌清些，泪染含风细葛班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽思泉居士 其一","author":"王柏","text":"平生不蓄买山钱，晚得佳城岂偶然。\n官职丛中韬素志，风波险处谒名贤。\n只将和气占心地，尚想清尊养性天。\n宗党典刑难倒指，忍看庭玉泪溅溅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":16985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]