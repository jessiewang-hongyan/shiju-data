[{"title":"为兴国周少隐题","author":"王之道","text":"紫翠森攒面面山，个中佳致为君还。\n凭阑人在风尘表，落纸诗成咳唾间。\n良夜幸陪红袖醉，清时聊伴白鸥閒。\n笼纱归去高城晚，凝翠堂东月满湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"为彭积甫题熙春堂","author":"王之道","text":"似闻伐石旋诛茅，已见高堂荫乐郊。\n百里湖山供眼界，满城桃李动春梢。\n寒梅过尽看成实，乳燕飞来欲定巢。\n何日登临閒信马，路边人复少年嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"历阳倅蒙庵郑公卒于位记岁在丁丑与仆有交承之契方来自镇西而仆亦自安丰往邂逅于合肥驿中获为三日之款所谈无非周易太玄老庄之书开警蒙昧多矣公平生学佛行一着端的不昧所谓毫发无遗恨者仆老矣请从其后而为净土之游似不晚也作是诗以吊之 其二","author":"王之道","text":"东晋陶元亮，西京董仲舒。\n高风敦薄俗，妙论见遗书。\n水石伤新窆，松篁惨旧庐。\n楞伽今在否，此道发明初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"历阳倅蒙庵郑公卒于位记岁在丁丑与仆有交承之契方来自镇西而仆亦自安丰往邂逅于合肥驿中获为三日之款所谈无非周易太玄老庄之书开警蒙昧多矣公平生学佛行一着端的不昧所谓毫发无遗恨者仆老矣请从其后而为净土之游似不晚也作是诗以吊之 其一","author":"王之道","text":"我倅安丰日，君来自历阳。\n交承分彼此，邂逅及行藏。\n精义通玄易，微言妙老庄。\n刹那今十稔，叹仰未能忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"历阳寄定城尉彦逢弟","author":"王之道","text":"故园鹎鵊久催耕，休恋公田秫与粳。\n别恨久随黄耳去，归心应望白云生。\n干戈丛里三书考，春夏交来几闭城。\n我亦蓝田负丞者，相从何日赋渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太湖呈邵公晋沈元吉","author":"王之道","text":"半月江湖上，晚来方得风。\n挂帆谁共快，到岸偶相逢。\n可是过从旧，都缘臭味同。\n长亭一樽茗，亲厚意何穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长至和魏公达","author":"王之道","text":"半夜迎长坐候明，眼看初日屋山平。\n诗豪不共年俱长，鬓雪惟应老自生。\n得酒人情何太喜，犯寒春色不多争。\n老农相庆无它语，尽道冬晴好趁耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东灵鹫","author":"王之道","text":"松盖雨还偃，云扉风自关。\n纵横两溪水，高下万重山。\n入室三弹指，临渊一点颜。\n悬知少来往，石笋绿苔斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代人上段拂参政","author":"王之道","text":"玉牒书成已六年，东游曾记此周旋。\n千龄令庆亨嘉会，二府新分造化权。\n咫尺云天依日月，斯须霖雨浃山川。\n应怜汨没尘埃者，白发青衫走道边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬夜对月怀彦逢弟","author":"王之道","text":"荒庭寒有月，穷巷静无声。\n坐想积年别，遥同今夕明。\n蹉跎前进士，憔悴老书生。\n短棹归来好，边城久偃兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对雪和马大卿","author":"王之道","text":"投分江梅亦太清，寻盟风絮却多情。\n势先泽腹归冰鉴，气迫毫尖入管城。\n吏部梦踰秦岭去，将军来作蔡州行。\n拥炉令我思前躅，策蹇高吟愧孟生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对雪和因老韵","author":"王之道","text":"谏陛何人正伏蒲，将坛无事且投壶。\n因观雪曲词争胜，便觉诗邻势不孤。\n警雁王师方入蔡，赠梅边使欲离吴。\n可怜鼠辈殊轻敌，乃敢堂堂捋虎须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归自合肥于四顶山绝湖呈孙仁叔抑之","author":"王之道","text":"达岸三时顷，瞻山四顶赊。\n乔林知马尾，乱石见獐牙。\n水脚浮青靛，湖唇滉白沙。\n渔人收辏网，归去日西斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用东坡赠晁新城韵呈朱乌江","author":"王之道","text":"偶然来赋瓦梁行，乱后欣闻醉客声。\n村戍火明人指路，江城风静夜鸣钲。\n对床听雨他时念，拨火哦诗此意清。\n闻说鱼轩还枳里，先生应合暂归耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用李梦发韵","author":"王之道","text":"梦回诗思不胜清，卧听幽禽两啭更。\n窗角界金分月色，山腰鸣玉漱溪声。\n欲行且住心还适，久雨新晴眼倍明。\n莫为浮名废真赏，较来何重亦何轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用陈阜卿劝农韵呈宣城太守 其二","author":"王之道","text":"欲知人意喜，万户郁炉烟。\n纱帽花垂额，金卮酒到莲。\n岁丰端可卜，农劝竞相传。\n往矣南阳政，今追召父贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用陈阜卿劝农韵呈宣城太守 其一","author":"王之道","text":"何处催耕早，宣城刺史先。\n旗麾明晓市，耒耜遍晴川。\n道路欢声接，樽罍丽景鲜。\n似闻携百榼，分饷及高年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田间夜归有作示王觉民二首 其二","author":"王之道","text":"江上秋来忆少牢，龟肠尤觉病诗饕。\n调和索似三分酱，澒洞看如八斗糟。\n水怪重增风势恶，湘灵难禁雁声高。\n何当一雨洗烟月，为放清光归我曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田间夜归有作示王觉民二首 其一","author":"王之道","text":"风云踪迹付扁舟，水竹生涯寄一丘。\n世故举同鸡抱鸭，物情无怪马生牛。\n百年半向愁中老，万事常从酒到休。\n莫爱得官轻得句，争如饱食对吟搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"示隐静恭老","author":"王之道","text":"游山何敢避泥涂，恰值催花夜雨馀。\n杯渡已知无用楫，马行今信不更车。\n数声幽鸟过庭际，一派飞泉赴壑初。\n正欲寻师问心法，却惊行色逼钟鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春小酌呈诸兄","author":"王之道","text":"共喜春随晓色来，东郊欢踊赛牛回。\n破寒青转芜菁叶，抵日红抽芍药荄。\n岁换未劳惊我壮，酒封聊复为君开。\n上林不负迁乔约，百蛰同惊此夜雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春日雪和赵端质韵","author":"王之道","text":"春寒有信不踰期，肯为衰颜独见欺。\n白雪已输梅斗早，绿樽尤与火相宜。\n撷来野蔌和萱草，分得江鱼贯柳枝。\n刺史忧民民共乐，赛牛归去竞褰帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春示儿二首 其一","author":"王之道","text":"雪尽适沾雨，腊穷初得春。\n上冰鱼意乐，出谷鸟声新。\n便觉风光好，何忧活计贫。\n一樽聊共醉，疏率见吾真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春示儿二首 其二","author":"王之道","text":"朝来何所喜，人唱玉楼春。\n酒著心还壮，诗成思转新。\n士衡宁久困，曲逆岂长贫。\n千载风云会，欣逢圣主真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春和孙子绍二首 其二","author":"王之道","text":"南浦初开冻，东郊未去寒。\n芳华归草木，生意入门阑。\n绿蚁供瑶瓮，青丝送玉盘。\n新诗妙当世，赋答敢辞难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春和孙子绍二首 其一","author":"王之道","text":"老穷推不去，湖海又逢春。\n懒复论三甲，空惊荐五辛。\n柳梢寒已动，萱草暖还新。\n我亦寰中物，因君试问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"边公式周表卿侍郎同年会","author":"王之道","text":"侍郎修好燕群公，雁塔题名二纪同。\n谈笑静移杨柳日，杯盘清泛芰荷风。\n鹏抟竞祝三旌贵，鲸吸相期百榼空。\n此会明年应更好，马周行亦起新丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伏蒙知县县尉二寮友以夏旱得雨赓石徂徕喜雨韵见贶不可虚辱复嗣其韵书谢仍命儿曹同赋","author":"王之道","text":"绿槐阴外听蝉吟，节过分龙夏已深。\n千里亢阳忧岁旱，一时甘雨快人心。\n养禾不害连朝曀，沃暑应容数日霖。\n多谢同寮怜老拙，双南佳句竞铿金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和董令升雪二首 其二","author":"王之道","text":"欲下閒庭不蹋泥，但惊飞絮与阶齐。\n一枝误失禽栖稳，三窟遥应兔迹迷。\n填塞涧溪还地厚，壅培山阜觉天低。\n寒光照应东窗白，咿喔应先报晓鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和董令升雪二首 其一","author":"王之道","text":"春雪初融作燕泥，梅花零落杏花齐。\n遥山扫翠云初敛，芳草铺青路欲迷。\n别恨每忧儿辈觉，老怀终为世情低。\n新诗价重连城壁，敢比灵犀独骇鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"因上人访予相山夜闻二子诵书有诗次韵","author":"王之道","text":"杖锡东来意亦勤，寒岩枯木自相亲。\n方惊妙论雨侵坐，忽喜新诗光照人。\n物外交游清似水，梦中忧患碎如尘。\n儿童正欲承砻错，应觉临文便有神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次方正叔知县韵仆今年六十有三窃观正叔赠陈甥述怀诗有感予心并和二首奉呈 其二","author":"王之道","text":"水满陂塘麦满村，路逢田父和长言。\n题诗懒作蝇头字，贳酒愁看犊鼻裈。\n芳草藉青迷野径，远山横翠入柴门。\n道衡骨朽无人继，卿相谁能预识温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次方正叔知县韵仆今年六十有三窃观正叔赠陈甥述怀诗有感予心并和二首奉呈 其一","author":"王之道","text":"年踰六十我何堪，心曲因君得纵谈。\n阅史旧尝疑夏五，参禅今遂荐前三。\n饮阑却怪清樽恶，饥甚犹怜粝食甘。\n交态物情何足较，迩来炉鼎兴方酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次因上人韵","author":"王之道","text":"一从潜水别，三见菊花黄。\n旧好论交笃，新诗引兴长。\n劳生閒自笑，道术淡相忘。\n蝴蝶秋来懒，时应到睡乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次彦时兄苦旱韵","author":"王之道","text":"斗粟衡门且自安，老来筋力厌辛酸。\n官游动是三年别，邂逅应容一笑欢。\n荷浦珠联秋露溢，稻田龟坼暑风乾。\n昨朝溪足捎新雨，已觉羸躯怯夜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵元发弟秋日德馀庵书事二首 其二","author":"王之道","text":"十载江湖叹断蓬，梦魂时到帝王宫。\n珠帘高捲虾须日，宝扇斜开雉尾宫。\n勿诮赵尧刀笔吏，须怜窦巩嗫嚅翁。\n儿童来告黄花熟，可喜樽中酒不空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵元发弟秋日德馀庵书事二首 其一","author":"王之道","text":"饱谙世事转疏慵，投老犹能向佛宫。\n危坐遂移桑荫日，清谈仍对菊花风。\n凭君为我追欢伯，自此游山作醉翁。\n闻说秋来足佳句，暮归应念锦囊空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵同舍李支使梦与二首 其二","author":"王之道","text":"短短灯檠便且光，看书犹记感秋凉。\n飘零未遂襟期远，迟暮徒惊岁月伤。\n初喜嫩荷青直盖，不知新竹粉储霜。\n相从益觉交情笃，时掷隋珠到我行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵同舍李支使梦与二首 其一","author":"王之道","text":"三纪桥门过隙光，醉吟曾共晚风凉。\n旧游何在已芜没，前好欲言空感伤。\n重对诗囊开锦绣，要看谈麈落冰霜。\n苕溪此去如相忆，双鲤时应寄一行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵因上人谢徐守遗顾渚茶","author":"王之道","text":"相从聊罢致书邮，情寄诗筒早晚休。\n顾我未忘童子好，评君还向古人求。\n缃奁启处云英馥，石鼎煎来雪浪浮。\n多谢徐卿分顾渚，报之琼玖两相收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵孙兴宗梅花","author":"王之道","text":"厌浥庭柯雨未乾，乍晴天气午犹寒。\n传来多谢新诗寄，接得翻愁病眼看。\n漫想素妆嫌粉涴，须怜青子着枝酸。\n和羹有日君知否，老大心肠只自宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵伯远运干见寄","author":"王之道","text":"善邻虽幸借馀光，终愧陈臻问发棠。\n官柳又惊眉拂翠，宫梅应喜额涂黄。\n江湖得计还相造，道义论交付两忘。\n多谢乾坤容长物，许乘春意到文昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵何子应大卿喜雪武昌作","author":"王之道","text":"云气浮江不见边，拥炉吟雪思飘然。\n风将急霰先鸣瓦，水剪寒花忽际天。\n才涩敢陪梁苑客，兴来从泛剡溪船。\n将军乘夜平淮蔡，翻笑元和十二年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张进彦见寄二首 其二","author":"王之道","text":"鼻息齁齁尽日眠，从他儿辈竞嘲边。\n那知问对成中说，自得逍遥喜内篇。\n雪里书来檐噪鹊，灯前诗就鼎凝烟。\n中郎去后人难继，漫诧柯亭富笛椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵张进彦见寄二首 其一","author":"王之道","text":"坐想云烟走笔端，夜哦佳制老忘寒。\n一时思致追长庆，千载风流识建安。\n接武尚稽班玉笋，昂霄终合待金銮。\n自怜衰退无新语，捧腹还君醉眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵沈元吉兵火后初食羊","author":"王之道","text":"时难盆甑久无膻，梦寐何郎食万钱。\n一脔乍惊肥羜美，五紽应喜敝裘全。\n好从牛炙论莼菜，堪笑河鲀咏柳绵。\n弹铗得鱼良不恶，先生何用鄙烹鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵周子嘉咏雪","author":"王之道","text":"势凌风力斗清严，彻骨尤非老病堪。\n冻蠡夜回千首北，寒梅朝放一枝南。\n扁舟底事方行役，贩履何人正立谈。\n江上别来劳梦寐，相宽犹喜见诗三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵周运判彦约芍药","author":"王之道","text":"独殿群芳占晚春，对花犹幸有斯人。\n宓妃正自须曹赋，楚女何妨与宋邻。\n醉著午风浓似酒，妆融朝雨细如尘。\n边城正藉诗书帅，俎豆于今识祭遵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵周漕喜雨","author":"王之道","text":"十载栖迟畎亩间，无聊尤苦屡无年。\n可怜一雨今时若，便觉千塍顿郁然。\n击壤有期应共庆，效颦非分敢争妍。\n正当檐溜江河决，想见高吟夜不眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵徐伯远木芙蓉","author":"王之道","text":"千林摇落见孤芳，销得诗人赋拒霜。\n高压菊花还独步，静窥池水试新妆。\n自怜衰病追欢懒，忽睹骚吟引兴长。\n何必采江重比并，佳名艳色正相当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵秦寿之题四祖","author":"王之道","text":"古木参天翠作堆，云中石栈为谁开。\n楼台正倚双峰起，香火曾瞻四祖来。\n霜重静闻秋子落，风高愁听晓猿哀。\n当年松上花何似，五叶依然映紫苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵程德远登清淮楼","author":"王之道","text":"西望中原懒转头，十年空见水东流。\n涂山漫想诸侯会，濠上聊追二子游。\n大剑长刀秋正扰，淡烟疏雨暮还愁。\n谁能不讨清河朔，誓楫当期祖豫州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵董令升梅花","author":"王之道","text":"花前樽酒泻尖泥，痛饮仍欣客到齐。\n竹外一枝青更好，水边疏影动还迷。\n醉醒正值微风入，酬唱何妨素魄低。\n闻说归舟阳羡去，应容酌别为烹鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵蒋守张进彦","author":"王之道","text":"邂逅传杯莫放杯，七年重见梦初回。\n休嗟岁月堂堂去，且喜旌麾得得来。\n春至会沾新雨露，时清应扫旧氛埃。\n如君才业今张镐，怜我栖迟毂屡推。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵鲁如晦七夕","author":"王之道","text":"今夕知何夕，相逢莫漫愁。\n凉飔开北牖，新月挂西楼。\n重惜经年别，贪延数刻秋。\n明朝河汉隔，西向望牵牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵蔡永叔双头芍药","author":"王之道","text":"反复新诗对月华，视模犹及正而葩。\n坐驰芍药心先醉，身老江湖眼欲花。\n夜半已酬连理约，风前还见一枝斜。\n滩头更下双鸂鶒，并与妖红作意誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江南道中","author":"王之道","text":"江回山崦两三家，招飐东风酒旆斜。\n羸马送曛行自急，峭寒欺客晚还加。\n日边雁足应传信，竹外梅梢合放花。\n指点东城归路窎，一川流水闹栖鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟过三丫河","author":"王之道","text":"摇落蒹葭浦，荒凉雁鹜村。\n吴柑迎齿冷，鲁酒著颜温。\n水涩风还逆，天寒日自暾。\n不堪归思乱，鸟鹊闹黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过邓步和张叔元见赠韵","author":"王之道","text":"独舸东来夏日长，归装从此益生光。\n卧云禾穗珠成实，倾露荷花麝被囊。\n逸世才猷金騕袅，逼人风味木兰堂。\n常疑正始遗音绝，把读新诗远坛场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丽泽堂","author":"王之道","text":"焚香读易欲何求，只恐西邻未识丘。\n千里交游思命驾，一龛灯火喜逢秋。\n胸中云梦应无算，天上风雷得遍搜。\n莫向明时老岩壑，伊周元不羡巢由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴兴舟中有作","author":"王之道","text":"大泽知何处，扁舟快此行。\n绮罗纷胜赏，歌吹溢欢声。\n茭葑春还合，波涛暮自平。\n临风一披拂，谁识未归情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈蔡元德二首 其二","author":"王之道","text":"一叶黄梅雨，潺潺过麦秋。\n昏沉浑似醉，憔悴不禁愁。\n渠溢门庭淖，园荒草树稠。\n乍晴酬绝唱，何幸对风猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈蔡元德二首 其一","author":"王之道","text":"别来閒计日，一日似三秋。\n顾我无能老，逢君始欲愁。\n诗情今转胜，交契久还稠。\n学问神龟似，当年继践猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]