epo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其六十二","author":"释了惠","text":"星在天上，眼在眉下。\n星无暗明，眼无昼夜。\n密密绵绵无缝罅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其六十一","author":"释了惠","text":"去年今日节，海角天涯传报捷。\n今日去年朝，黄童白叟尽歌谣。\n雨不破块，风不鸣条。\n渔者自渔，樵者自樵。\n草木昆虫王化里，万拜谁道不逢尧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其五十九","author":"释了惠","text":"东土与西土，镬汤无冷处。\n暗室里突出鳖鼻蛇，平田中撞著白额虎。\n眼放闪电光，毒气成烟雾。\n最难行是芝峰路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其五十八","author":"释了惠","text":"仲冬严寒年年事，须知事上大有事。\n若人知得事上事，到了全然不干事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其五十五","author":"释了惠","text":"孟嘉已前，渊明去后。\n谁家篱畔欠黄花，那个杯中无白酒，重阳只是九月九。\n阿呵呵，始信茱萸茶苦涩，展眉人少皱眉多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其五十四","author":"释了惠","text":"屋前基业，屋后生涯。\n堂堂妙用，不假安排。\n暑退凉飙起，燕归鸿雁来。\n天台南岳，峨嵋五台。\n新罗击鼓大唐斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其五十二","author":"释了惠","text":"南山鳖鼻蛇，撺入新罗国。\n吞却镇海珠，咬杀嘉州佛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其四十九","author":"释了惠","text":"千峰沐雨，万树笼烟。\n磨盘呈旧面，水碓拜新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其四十八","author":"释了惠","text":"扁舟划断晓江云，一曲高歌远送君。\n惊起滩头野鸭子，海天飞去不成群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其四十七","author":"释了惠","text":"今朝九月九，渊明开醉口。\n指点东篱菊，大骂西门柳。\n诸人听得，只么饮气吞声。\n山僧闻之，不免袖中出手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其四十四","author":"释了惠","text":"满目荆榛，亘天烈焰。\n百匝千重，四方八面。\n赵州拿得七斤衫，普化走入大悲院，蜡人眼光如掣电。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其四十三","author":"释了惠","text":"护生须是杀，杀尽始安居。\n会得个中意，铁船水上浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其四十二","author":"释了惠","text":"拄杖自拄杖，山僧自山僧。\n庭空积深雪，池冷起冰棱。\n楼上未吹新岁角，窗前且点旧年灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其四十","author":"释了惠","text":"飞雪岩前，炎天飞雪。\n冻得虚空，七花八裂。\n至今捏聚不成团，子规夜哭松梢月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其三十七","author":"释了惠","text":"明星照得眼睛穿，眼睛觑得明星落。\n夜半依前是子时，敢保不曾成正觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其三十一","author":"释了惠","text":"诸佛日日降生，圣人时时出现。\n与大地群生，同一耳闻，同一眼见，同此一心，同此一念。\n共乐太平时，大家呈笑面。\n有谁更问，日与长老，孰近孰远，大千沙界含元殿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其二十九","author":"释了惠","text":"冰雪冻皮肤，麻麦饿肠肚。\n见日未尝迷，见星安有悟。\n黄面老瞿昙，甜瓜成苦瓠。\n那更错行山下路，一步两步三四步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其二十八","author":"释了惠","text":"洪机莫测，至德难量。\n万民几鸥鹭，四海一池塘。\n日日春风相鼓舞，不知时世是羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其二十七","author":"释了惠","text":"迦叶擎拳，阿难合掌。\n临济入门喝，德山入门棒。\n小人道消，君子道长。\n晓来策杖过溪西，十分春在梅梢上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其二十六","author":"释了惠","text":"洞山有物黑似漆，老倒玉泉裈赫赤。\n赤者吉中有凶，黑者凶中有吉，明眼衲僧难辨的。\n即今吉凶悔吝拈向一边，玉泉洞山且靠一壁，却听拄杖子出来露个消息。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其二十一","author":"释了惠","text":"年去年来，年来年去。\n虽有去来年，且无来去路。\n既无来去路，实无有去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其二十","author":"释了惠","text":"秉太阿剑，立太平基。\n卷旗青海尾，奏凯乱峰西。\n弟应兄呼成活业，汝携锄去我扶犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其十七","author":"释了惠","text":"向上关，脚下路。\n才拟问如何，邯郸学唐步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其十六","author":"释了惠","text":"的的此事，真不可说。\n不可说中真可说，真可说，无可说。\n齿临部临，急急敕摄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂七十一首 其十四","author":"释了惠","text":"五月端午令节，艾人苦痛不彻。\n可怜病在膏肓，又被邪神所惑。\n撞著太上老君，也是赤口白舌。\n山僧反覆思量，别无仙方秘诀。\n如今抑不得已，只得就渠身上打劫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]