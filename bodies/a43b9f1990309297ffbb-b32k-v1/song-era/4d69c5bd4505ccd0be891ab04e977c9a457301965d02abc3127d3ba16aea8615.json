[{"title":"得家嫂书","author":"朱淑真","text":"声声喜报鹊温柔，忽接芳缄自便邮。\n一尺溪藤摛锦带，数行香墨健银钩。\n倾心吐尽重重恨，入眼翻成字字愁。\n添得情怀无是处，非干病酒与悲秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春会东园","author":"朱淑真","text":"红叠苔痕绿满枝，举杯和泪送春归。\n鸧鹒有意留残景，杜字无情恋晚晖。\n蝶趁落花盘地舞，燕随狂絮入帘飞。\n醉中曾记题诗处，临水人家半敞扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新春","author":"朱淑真","text":"楼台影里荡春风，协气融怡物物同。\n草色乍翻新样绿，花容不减旧时红。\n莺唇小巧轻烟里，蝶翅轻便细雨中。\n聊把新诗记风景，休嗟万事转头空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"膏雨","author":"朱淑真","text":"添得垂杨色更浓，飞烟捲雾弄轻风。\n展匀芳草茸茸绿，湿透妖桃薄薄红。\n润物有情如著意，催花无语自施工。\n一犁膏脉分春垄，只慰农桑望眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日行","author":"朱淑真","text":"春云漠漠连春空，映阶草色绿茸茸。\n不寒不暖雨新霁，满城佳气浮葱葱。\n岸柳依依微烟笼，园林淡荡催花风。\n东君造化一何工，施青绘紫复匀红。\n多少闲花与凡卉，不论妍丑争夭秾。\n燕舞莺歌昼晷永，帘幕无人门宇静。\n何处飞来双蛱蝶，翻翻飞入寻香径。\n可怜春色都九旬，朝欢暮宴归王孙。\n秃毫写纸属诗人，长歌短什劳精神。\n长歌短什聊自适，岂有佳句生阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卜算子 咏梅","author":"朱淑真","text":"竹里一枝斜，映带林逾静。\n雨后清奇画不成，浅水横疏影。\n吹彻小单于，心事思重省。\n拂拂风前度暗香，月色侵花冷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆秦娥 正月初六日夜月","author":"朱淑真","text":"弯弯曲，新年新月钩寒玉。\n钩寒玉，凤鞋儿小，翠眉儿蹙。\n闹蛾雪柳添妆束，烛龙火树争驰逐。\n争驰逐，元宵三五，不如初六。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月华清 梨花","author":"朱淑真","text":"雪压庭春，香浮花月，揽衣还怯单薄。\n欹枕裴回，又听一声干鹊。\n粉泪共、宿雨阑干，清梦与、寒云寂寞。\n除却，是江梅曾许，诗人吟作。\n长恨晓风漂泊，且莫遣香肌，瘦减如削。\n深杏夭桃，端的为谁零落。\n况天气、妆点清明，对美景、不妨行乐。\n拌著，向花时取，一杯独酌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"生查子 其二","author":"朱淑真","text":"年年玉镜台，梅蕊宫妆困。\n今岁未还家，怕见江南信。\n酒从别后疏，泪向愁中尽。\n遥想楚云深，人远天涯近。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"生查子 其一","author":"朱淑真","text":"去年元夜时，花市灯如昼。\n月上柳梢头，人约黄昏后。\n今年元夜时，月与灯依旧。\n不见去年人，泪湿春衫袖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"生查子 其三","author":"朱淑真","text":"寒食不多时，几日东风恶。\n无绪倦寻芳，闲却秋千索。\n玉减翠裙交，病怯罗衣薄。\n不忍卷帘看，寂寞梨花落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后庭花","author":"朱淑真","text":"岂意为花属后庭，荒迷亡国自兹生。\n至今犹恨隔江唱，可惜当时枉用情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江城子 赏春","author":"朱淑真","text":"斜风细雨作春寒。\n对尊前。\n忆前欢。\n曾把梨花，寂寞泪阑干。\n芳草断烟南浦路，和别泪，看青山。\n昨宵结得梦夤缘。\n水云间。\n悄无言。\n争奈醒来，愁恨又依然。\n展转衾裯空懊恼，天易见，见伊难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月 春半","author":"朱淑真","text":"办取舞裙歌扇，赏春只怕春寒。\n卷帘无语对南山，已觉绿肥红浅。\n去去惜花心懒，踏青闲步江干。\n恰如飞鸟倦知还，澹荡梨花深院。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 二首催雪 其一","author":"朱淑真","text":"冬晴无雪，是天心未肯，化工非拙。\n不放玉花飞堕地，留在广寒宫阙。\n云欲同时，霰将集处，红日三竿揭。\n六花剪就，不知何处施设。\n应念陇首寒梅，花开无伴，对景真愁绝。\n待出和羹金鼎手，为把玉盐飘撒。\n沟壑皆平，乾坤如画，更吐冰轮洁。\n梁园燕客，夜明不怕灯灭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 其二","author":"朱淑真","text":"鹅毛细剪，是琼珠密洒，一时堆积。\n斜倚东风浑漫漫，顷刻也须盈尺。\n玉作楼台，铅镕天地，不见遥岑碧。\n佳人作戏，碎揉些子抛掷。\n争奈好景难留，风僝雨僽，打碎光凝色。\n总有十分轻妙态，谁似旧时怜惜。\n担阁梁吟，寂寥楚舞，笑捏狮儿只。\n梅花依旧，岁寒松竹三益。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 冬","author":"朱淑真","text":"风劲云浓，暮寒无奈侵罗幕。\n髻鬟斜掠，呵手梅妆薄。\n少饮清欢，银烛花频落。\n恁萧索。\n春工已觉，点破香梅萼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇","author":"朱淑真","text":"黄鸟嘤嘤，晓来却听丁丁木。\n芳心已逐，泪眼倾珠斛。\n见自无心，更调离情曲。\n鸳帏独。\n望休穷目，回首溪山绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 清明","author":"朱淑真","text":"春巷夭桃吐绛英，春衣初试薄罗轻。\n风和烟暖燕巢成。\n小院湘帘闲不卷，曲房朱户闷长扃。\n恼人光景又清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 春怨","author":"朱淑真","text":"独行独坐，独唱独酬还独卧。\n伫立伤神，无奈轻寒著摸人。\n此情谁见，泪洗残妆无一半。\n愁病相仍，剔尽寒灯梦不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"圈儿词","author":"朱淑真","text":"相思欲寄无从寄，画个圈儿替。\n话在圈儿外，心在圈儿里。\n单圈儿是我，双圈儿是你。\n你心中有我，我心中有你。\n月缺了会圆，月圆了会缺。\n整圆儿是团圆，半圈儿是别离。\n我密密加圈，你须密密知我意。\n还有数不尽的相思情，我一路圈儿圈到底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐","author":"朱淑真","text":"风光紧急，三月俄三十。\n拟欲留连计无及，绿野烟愁露泣。\n倩谁寄语春宵，城头画鼓轻敲。\n缱绻临歧嘱付，来年早到梅梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐 夏日游湖","author":"朱淑真","text":"恼烟撩露，留我须臾住。\n携手藕花湖上路，一霎黄梅细雨。\n娇痴不怕人猜，和衣睡倒人怀。\n最是分携时候，归来懒傍妆台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"眼儿媚","author":"朱淑真","text":"迟迟春日弄轻柔，花径暗香流。\n清明过了，不堪回首，云锁朱楼。\n午窗睡起莺声巧，何处唤春愁。\n绿杨影里，海棠亭畔，红杏梢头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 咏梅","author":"朱淑真","text":"湿云不渡溪桥冷，娥寒初破东风影。\n溪下水声长，一枝和月香。\n人怜花似旧，花不知人瘦。\n独自倚阑干，夜深花正寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 木樨","author":"朱淑真","text":"也无梅柳新标格，也无桃李妖娆色。\n一味恼人香，群花争敢当。\n情知天上种，飘落深岩洞。\n不管月宫寒，将枝比并看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其二","author":"朱淑真","text":"山亭水榭秋方半，凤帏寂寞无人伴。\n愁闷一番新，双蛾只旧颦。\n起来临绣户，时有疏萤度。\n多谢月相怜，今宵不忍圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮 其一 秋","author":"朱淑真","text":"秋声乍起梧桐落，蛩吟唧唧添萧索。\n欹枕背灯眠，月和残梦圆。\n起来钩翠箔，何处寒砧作。\n独倚小阑干，逼人风露寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门 其一 春半","author":"朱淑真","text":"春已半，触目此情无限。\n十二栏干倚遍，愁来天不管。\n好是风和日暖，输与莺莺燕燕。\n满院落花帘不卷，断肠芳草远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹊桥仙 七夕","author":"朱淑真","text":"巧云妆晚，西风罢暑，小雨翻空月坠。\n牵牛织女几经秋，尚多少、离肠恨泪。\n微凉入袂，幽欢生座，天上人间满意。\n何如暮暮与朝朝，更改却、年年岁岁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花 送春","author":"朱淑真","text":"楼外垂杨千万缕。\n欲系青春，少住春还去。\n独自风前飘柳絮。\n随春且看归何处。\n绿满山川闻杜宇。\n便做无情，莫也愁人苦。\n把酒送春春不语。\n黄昏却下潇潇雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"朱淑真","text":"独倚阑干昼日长，纷纷蜂蝶斗轻狂。\n一天飞絮东风恶，满路桃花春水香。\n当此际，意偏长，萋萋芳草傍池塘。\n千钟尚欲偕春醉，幸有荼蘼与海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓜桥竞渡","author":"朱清","text":"东吴霸业已成然，渡口瓜畦泽未乾。\n为问曩时仙在否，何堪云树鹤蹁跹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"严峙钓台","author":"朱清","text":"谁著羊裘探故人，客星炯炯照天文。\n严陵矶下桐江水，流到东山一色清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乞双峰山频婆果 其一","author":"朱翌","text":"我昔南游三眼国，逢人一笑启丹唇。\n祇今重到孤峰顶，依旧丹唇一笑新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乞双峰山频婆果 其二","author":"朱翌","text":"我闻如来有佛眼，结子成时速寄来。\n从此慈悲修广目，得争开处便争开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山芥","author":"朱翌","text":"湿带青烟古涧滨，气含石理助芳辛。\n山中酒醒凉生脑，乞与文园渴肺人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天申节诗 其二","author":"朱翌","text":"明庆晓班催百辟，钧容仙部下层霄。\n如今独立薰风里，却听群仙奏九韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天申节诗 其一","author":"朱翌","text":"南来欣遇千秋节，北向空驰万里心。\n永日清风吹古寺，一杯聊见祝尧深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月下对白菊 其二","author":"朱翌","text":"饮冰啮雪傅延年，要比蟾宫桂子妍。\n忽遇嫦娥蒙一盼，桂花未敢著鞭先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月下对白菊 其一","author":"朱翌","text":"诗人月下见梅花，著力形容极口誇。\n若使月明中见菊，欲将何语为褒嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送前东阳于明府由鄂渚归故林","author":"张元干","text":"结东征车换黑貂，灞西风雨正潇潇。\n茂陵久病书千卷，彭泽初归酒一瓢。\n帆背夕阳湓水阔，棹经沧海甑山遥。\n殷勤为谢南溪客，白首萤窗未见招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜饮","author":"陆游","text":"引剑酣歌亦壮哉，要君共覆手中杯。\n秋鸿阵密横江去，暮角声酣战雨来。\n莫恨皇天无老眼，请看白骨有青苔。\n中年倍觉流光速，行矣西郊又见梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"延祥寺手植竹有甘露 其一","author":"朱翌","text":"圣主尊贤方侧席，此君凝露美如饴。\n形容盛德书生事，请对佳祥著好诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"延祥寺手植竹有甘露 其二","author":"朱翌","text":"穰穰天酒被修篁，的皪枝间日射光。\n岂为炎荒多热恼，故教灌顶作清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲江渔者得鳜鱼弃之目为师婆鱼 其二","author":"朱翌","text":"溪友渔翁忍弃捐，却应游泳得长年。\n遐方未识珍羞贵，不道杨凭已得仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曲江渔者得鳜鱼弃之目为师婆鱼 其一","author":"朱翌","text":"巨口细鳞初出网，?皮玳瑁乃同斑。\n了无骨鲠人人喜，更捣盐齑发笑颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有惠新酱及酒者","author":"朱翌","text":"拾遗久住浣花桥，生理谁能济一毫。\n携酱藉糟来过我，故人惟有孟仓曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵书事 其二","author":"朱翌","text":"圣朝始悟文章弊，大霈首更诗赋科。\n白苇黄茅供一扫，英豪人物未消磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵书事 其三","author":"朱翌","text":"熙宁事作崇宁样，嘉祐政为元祐师。\n但得至诚行号令，坐令风俗似当时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵书事 其四","author":"朱翌","text":"当年司马温公力，今日宣仁圣烈尊。\n哲后在天何愠喜，要令元老雪沉冤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵董令升四咏 其四 玉泉","author":"朱翌","text":"至宝何年伏九渊，飞空散作玉声琤。\n那知夜半腾朝采，会见长虹属太清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵董令升四咏 其一 寻幽亭","author":"朱翌","text":"帝遣银河下太微，馀波散绕野人扉。\n此行步步有佳处，盘礴孤亭试解衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵董令升四咏 其三 性乐堂","author":"朱翌","text":"且置纷纷事百端，从公系马白云边。\n欲知太守乐其乐，山色溪声得两全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵董令升四咏 其二 竞秀亭","author":"朱翌","text":"山阴道士顷留连，应接烟云马不前。\n君说江南亦如此，我虽未到想当然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观乌龙山瀑布 其一","author":"朱翌","text":"一日一夜雨如倾，北山山顶垂天绅。\n是间去海只咫尺，缓流何用走踆踆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观乌龙山瀑布 其三","author":"朱翌","text":"漱石漱流俱可意，濯缨濯足且随时。\n到江莫作滔天浪，妨我轻舟理钓丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"佛头菊","author":"朱翌","text":"我杖常扶佛面强，我花今见佛头香。\n灵山会上曾拈出，一笑悬知是饮光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听鸽铃","author":"朱翌","text":"蓬蒿门巷久张罗，岂有笼坊重客过。\n天外鸽铃惊午枕，儿童误起听长呵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏紫荆","author":"朱翌","text":"鹤骨龙筋结寿枝，红绡紫绮曝仙衣。\n只应不奈麻姑爪，独领春风住翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜梦采选","author":"朱翌","text":"荣辱悲欢反覆手，竞呼穴骼欲求功。\n大开眼作人间梦，何况真成一梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舍后污池有小鱼数百迁之于江","author":"朱翌","text":"一泓已脱归涔水，万顷初惊广莫乡。\n且向江湖成自在，幸因风雨得腾骧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金盏玉盘菊","author":"朱翌","text":"玉盘金盏世称珍，天酒琼浆晓自盈。\n天为我贫都乞我，我虽不饮亦关情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南山观雪 其一","author":"朱翌","text":"入山初与雪云俱，坐定云收雪亦无。\n不见旧时苍翠色，换将粉墨作新图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南山观雪 其二","author":"朱翌","text":"南游客上妙高峰，拄杖敲冰袖障风。\n卷起面前帘看雪，烟鬟浑插玉珑璁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南华书事诗 其一","author":"朱翌","text":"珍重南华五色禽，云栖雾宿见无因。\n雨中恐误翩然出，我是闲人非贵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南华书事诗 其四","author":"朱翌","text":"火树烧春明踯躅，紫罗囊笔缀辛夷。\n花枝照眼蒙清润，带雨游山亦自奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南华书事诗 其三","author":"朱翌","text":"真觉止能留一宿，桐乡今已住连宵。\n却将膏雨下山去，聊助南溟早晚潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南屏 其一","author":"朱翌","text":"百步阶头长进步，南屏堂上立移时。\n明明万象森罗处，锻鍊雕镌费我诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃花菊","author":"朱翌","text":"菊花忽作桃花面，放眼难看九月黄。\n花不见桃惟见菊，又将红雨学啼妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]