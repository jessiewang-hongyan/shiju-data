[{"title":"新定感兴五首 其二","author":"范仲淹","text":"山水真名郡，恩多补谏官。\n中间好田锡，风月亦盘桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31467,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新定感兴五首 其一","author":"范仲淹","text":"数仞黄堂上，题名仅百贤。\n孤高宋开府，千载可拳拳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31468,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新定感兴五首 其四","author":"范仲淹","text":"去国三千里，风波岂不赊。\n回思洞庭险，无限胜长沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31469,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题翠峰院","author":"范仲淹","text":"翠峰高与白云闲，吾祖曾居水石间。\n千载家风应未坠，子孙还解爱青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31470,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠吴秀才","author":"范仲淹","text":"万户侯家几叶孙，弟兄红旆独乌巾。\n携琴人入庐山去，谁信朱门有逸人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31471,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠茅山张道者","author":"范仲淹","text":"有客生平爱白云，无端年老尚红尘。\n只应金简名犹在，得见仙岩种玉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31472,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠钟道士","author":"范仲淹","text":"人间无复动机心，挂了儒冠岁已深。\n惟有诗家风味在，一坛松月伴秋吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31473,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日","author":"范仲淹","text":"欲赋前贤九日诗，茱萸相斗一枝枝。\n可怜宋玉情无限，争似陶潜醉不知。\n绿鬓爱随风景变，黄华能与岁寒期。\n登高迥处狂多少，笑杀襄阳拍手儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31474,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"八月十四夜月","author":"范仲淹","text":"光华岂不盛，赏宴尚迟迟。\n天意将圆夜，人心待满时。\n已知千里共，犹讶一分亏。\n来夕如澄霁，清风不负期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31475,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与人约访林处士阻雨因寄","author":"范仲淹","text":"闲约诸公扣隐扃，江天风雨忽飘零。\n方怜春满王孙草，可忍云遮处士星。\n蕙帐未容登末席，兰舟无赖寄前汀。\n湖山早晚逢晴霁，重待寻仙入翠屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31476,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书事呈韩布殿丞","author":"范仲淹","text":"南宫曾荐牧之文，失足徒劳忽十春。\n天上云龙期际会，山中猿鹤愧因循。\n无功岂不孤黄石，有道何堪忆紫莼。\n少壮由来须努力，篆铭钟鼎古何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31477,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"升上人碧云轩","author":"范仲淹","text":"爱此诗家好，幽轩绝世纷。\n澄宵半床月，淡晓数峰云。\n远意经年就，微吟并舍闻。\n只应虚静处，所得自兰芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31478,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同年魏介之会上作","author":"范仲淹","text":"寒苦同登甲乙科，天涯相对合如何。\n心存阙下还忧畏，身在樽前且笑歌。\n闲上碧江游画鹢，醉留红袖舞鸣鼍。\n与君今日真良会，自信粗官乐事多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"尧庙","author":"范仲淹","text":"千古如天日，巍巍与善功。\n禹终平洚水，舜亦致薰风。\n江海生灵外，乾坤揖让中。\n乡人不知此，箫鼓谢年丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江干闲望","author":"范仲淹","text":"江干日清旷，寓目一支筇。\n落叶信流水，归云识旧峰。\n兰荪谁共采，凫雁自相从。\n莫爱蘋风起，波来千万重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"芝山寺","author":"范仲淹","text":"楼殿观崔嵬，灵芝安在哉。\n云飞过江去，花落入城来。\n得食鸦朝聚，闻经虎夜回。\n偶临西阁望，五老夕阳开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西湖筵上赠胡侍郎","author":"范仲淹","text":"官秩文昌贵，功名信史褒。\n朝廷三老重，乡党二疏高。\n涯业尽图籍，子孙皆俊髦。\n西湖天下绝，今日盛游遨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西溪书事","author":"范仲淹","text":"卑栖曾未托椅梧，敢议雄心万里途。\n蒙叟自当齐黑白，子牟何必怨江湖。\n秋天响亮频闻鹤，夜海朣胧每见珠。\n一醉一吟疏懒甚，溪人能信解嘲无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过太清宫","author":"范仲淹","text":"丑石危松半绿萝，函关真相玉嵯峨。\n谁言仙道求难至，自愧阴功积未多。\n渺渺云霞开绛节，雍雍鸾凤答空歌。\n几时身退琼坛畔，荣利匆匆奈老何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过长安醉别资政郑侍郎","author":"范仲淹","text":"乡关交复亲，把酒且逡巡。\n共上青云路，相看白发人。\n有为须报国，无事即颐神。\n故素几云在，风音莫厌频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过馀杭白塔寺","author":"范仲淹","text":"登临江上寺，迁客特依依。\n远水欲无际，孤舟曾未归。\n乱峰藏好处，幽鹭得闲飞。\n多少天真趣，遥心结翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过陈州上晏相公","author":"范仲淹","text":"曩由清举玉宸知，今觉光荣冠一时。\n曾入黄扉陪国论，重求绛帐就师资。\n谈文讲道浑无倦，养浩存真绝不衰。\n独愧铸颜恩未报，捧觞为寿献声诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即席呈太傅相公","author":"范仲淹","text":"凤池三入冠台躔，致了升平一品闲。\n白傅歌诗传海外，晋公桃李满人间。\n上都云远经时别，故国春浓几度还。\n太史占天应有奏，寿星光彩近南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"应制赏花钓鱼","author":"范仲淹","text":"万汇嘉亨日，皇心豫宴辰。\n华林新濯雨，灵沼正涵春。\n帝幄纷仙蘤，天钩掷锦鳞。\n洋洋颁睿唱，赓颂浃簪绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苏州十咏 其九 观风楼","author":"范仲淹","text":"高压郡西城，观风不浪名。\n山川千里色，语笑万家声。\n碧寺烟中静，红桥柳际明。\n登临岂刘白，满目见诗情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苏州十咏 其八 伍相庙","author":"范仲淹","text":"胥也应无憾，至哉忠孝门。\n生能酬楚怨，死可报吴恩。\n直气海涛在，片心江月存。\n悠悠当日者，千载秪惭魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞庭山","author":"王禹称","text":"吴山无此秀，乘暇一游之。\n万顷湖光里，千家橘熟时。\n平看月上早，远览鸟归迟。\n近古谁真赏，白云应得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苏州十咏 其五 阊门","author":"范仲淹","text":"吴门耸阊阖，迎送每跻攀。\n一水帝乡路，片云师子山。\n落鸿渔钓外，斜柳别离间。\n白傅归休处，盘桓几厚颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苏州十咏 其六 灵岩寺","author":"范仲淹","text":"古来兴废一愁人，白发僧归掩寺门。\n越相烟波空去雁，吴王宫阙半啼猿。\n春风似旧花犹笑，往事多遗石不言。\n唯有延陵逃遁去，清名高节满乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈质殿丞挽歌词","author":"范仲淹","text":"贤者逝如斯，皇天岂易知。\n众人皆堕泪，君子欲安碑。\n几世传清白，满乡称孝慈。\n贤哉生令嗣，遗秀在兰芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京口即事","author":"范仲淹","text":"突兀立孤城，诗中别有情。\n地深江底过，日大海心生。\n甘露楼台古，金山气象清。\n六朝人薄命，不见此升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和介之未开菊","author":"范仲淹","text":"本非桃李色，佳节敢先开。\n席上无言晚，霜前幸未摧。\n芳心应有待，真赏直须催。\n愿上金樽寿，何伤蝶不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和并州郑宣徽见寄二首 其二","author":"范仲淹","text":"西湖载客恣游从，湖上参差半佛宫。\n回顾隙驹曾不息，沉思樽酒可教空。\n层台累榭皆清旷，万户千门尽郁葱。\n向此行春无限乐，却惭何道继文翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和并州郑宣徽见寄二首 其一","author":"范仲淹","text":"钱唐作守不为轻，况是全家住翠屏。\n名品久参卿士月，部封全属斗牛星。\n仁君未报头先白，故老相看眼倍青。\n最爱湖山清绝处，晚来云破雨初停。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和胡使君书事","author":"范仲淹","text":"都督再临横海镇，集仙遥辍内朝班。\n清风又振东南美，好梦多亲咫尺颜。\n坐啸楼台凌皓月，行春鼓吹入青山。\n太平天子尊耆旧，八十王祥未赐闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和魏介之同游玉仙坛","author":"范仲淹","text":"云坛共上百神清，碧坞红霞相照明。\n幽草欲迷丹井处，乱峰依旧白云生。\n亭亭翠纛高杉矗，险险狂雷落石轰。\n待得九霄鸾鹤驭，玉书应改地仙名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵答王源叔忆百花洲见寄","author":"范仲淹","text":"芳洲名冠古南都，最惜尘埃一点无。\n楼阁春深来海燕，池塘人静下仙凫。\n花情柳意凭谁问，月彩波光岂易图。\n汉上山公发新咏，许昌何必诧申湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵答并州郑大资政见寄","author":"范仲淹","text":"制节重并汾，淹留又见春。\n年高成国老，道在乐天真。\n风韵应如旧，精明迥绝伦。\n致君心未展，宁是式微人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵答蒋密学见寄","author":"范仲淹","text":"东南为守慰衰颜，忧事浑祛乐事还。\n鼓吹夜归湖上月，楼台晴望海中山。\n奋飞每羡冥鸿远，驰骋那惭老骥闲。\n此日共君方偃息，是非荣辱任循环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵答韩侍御","author":"范仲淹","text":"虽叨世契与邻藩，东道瞻风御史尊。\n郑馆昔时延下客，于家今日见高门。\n我居方面荣为惧，君向台端直且温。\n彼此中怀蕴金石，不须销黯动离魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵酬太傅张相公见赠","author":"范仲淹","text":"出处曾无致主功，南阳为守地犹雄。\n醉醒往日惭渔父，得失今朝贺塞翁。\n七里河边归带月，百花洲上啸生风。\n卧龙乡曲多贤达，愿预逍遥九老中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵酬池州钱绮翁","author":"范仲淹","text":"天涯彼此勿冲冲，内乐何须位更崇。\n白发监州身各健，青山绕郭景多同。\n日高窗外眠方起，月到樽前宴未终。\n况在江南佳丽地，重阳犹见牡丹红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵酬邠州通判王稷太博","author":"范仲淹","text":"南豳日日接英标，公外追随岂待招。\n恶劝酒时图共醉，痛赢棋处肯相饶。\n一抛言笑如何遣，频得音书似不遥。\n独上西楼为君久，满城明月会云销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵酬吴安道学士见寄","author":"范仲淹","text":"圣君贤相正弥纶，谏诤臣微敢徇身。\n但得葵心长向日，何妨骛足未离尘。\n岂辞云水三千里，犹济疮痍十万民。\n宴坐黄堂愧无限，陇头元是带经人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵酬吴春卿二首 其二 松","author":"范仲淹","text":"亭亭百尺栋梁身，寂寞云根与涧滨。\n寒冒雪霜宁是病，静期风月不须春。\n萧萧远韵和于乐，密密清阴意在人。\n高节直心时勿伐，千秋为石乃知神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵酬李光化见寄","author":"范仲淹","text":"南阳偃息养衰颜，天暖风和近楚关。\n欲少祸时当止足，得无权处始安闲。\n心怜好鸟来幽院，目送微云过别山。\n此景此情聊自慰，是非何极任循环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵酬李光化叙怀","author":"范仲淹","text":"列宿专城且自娱，清名善最即前途。\n江山乐国诚难会，风月诗家的不辜。\n未必晚成输早达，好将高笑代长吁。\n公馀更励经邦业，思为清朝赞禹谟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵酬周骙太博同年","author":"范仲淹","text":"孰敢先怀富贵图，良时须惜几嗟吁。\n众心可致巍巍主，上意思平两两符。\n不称内朝裨耳目，多惭外补救皮肤。\n子陵滩畔观渔钓，无限残阳媚绿蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵酬章推官见赠","author":"范仲淹","text":"姑苏从古号繁华，却恋岩边与水涯。\n重入白云寻钓濑，更随明月宿诗家。\n山人惊戴乌纱出，溪女笑偎红杏遮。\n来蚤又抛泉石去，茫茫荣利一吁嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵酬黄灏秀才","author":"范仲淹","text":"再贬鄱川信不才，子规相爱劝归来。\n客心但感江山助，天意难期日月回。\n白雪孤琴弥冷淡，浮云双阙自崔嵬。\n南方岁宴犹能乐，醉尽黄花见早梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和太傅邓公归游武当见寄","author":"范仲淹","text":"三提相印代天工，邓国归来耀本封。\n此日神仙丁令鹤，几年霖雨武侯龙。\n酬恩定得祠黄石，谈道须期会赤松。\n莫虑故乡陵谷变，武当依旧碧重重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和并州大资政郑侍郎秋晚书事","author":"范仲淹","text":"太原兵重压强胡，莫对秋风忆鲙鲈。\n万里天声扬紫塞，十年人望在黄枢。\n定应松柏心无改，自信云龙道不孤。\n应笑病夫何所补，独能安坐养桑榆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和沈书记同访林处士","author":"范仲淹","text":"山中宰相下岩扃，静接游人笑傲行。\n碧嶂浅深骄晚翠，白云舒卷看春晴。\n烟潭共爱鱼方乐，樵爨谁欺雁不鸣。\n莫道隐君同德少，樽前长揖圣贤清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄惣太博上知郡杜少卿","author":"范仲淹","text":"万石君贤再出麾，犹龙川上五歌时。\n九重执宪清规在，十镇分忧白发知。\n环禁申威星拱极，铃斋舒啸月侵帷。\n金台下客思何报，愿上中和乐职诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"欧伯起相访","author":"范仲淹","text":"海涯牢落若为怀，惟子相过未忍回。\n劲草不随风偃去，孤桐何意凤飞来。\n樽藏金醴迟迟进，匣锁云和特特开。\n万古功名有天命，浩然携手上春台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"河朔吟","author":"范仲淹","text":"太平燕赵许闲游，三十从知壮士羞。\n敢话诗书为上将，犹怜仁义对诸侯。\n子房帷幄方无事，李牧耕桑合有秋。\n民得裤襦兵得帅，禦戎何必问严尤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"知府孙学士见示和终南监宫太保道怀五首因以缀篇 其一","author":"范仲淹","text":"玉皇近侍请脩真，赐得南山十里云。\n樽有圣贤聊自慰，鼎多龙虎复谁分。\n谢家山色朝晡见，陶隐松风寤寐闻。\n万物已齐无一事，独醒惟笑众醺醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"知府孙学士见示和终南监宫太保道怀五首因以缀篇 其二","author":"范仲淹","text":"要路抛来自寡尤，高怀卷去白云收。\n玉缘秘宝须藏密，兰为奇香却在幽。\n仙骨岂曾移静节，帝心终是竭嘉猷。\n红霞绿竹忘机地，未免天家下诏求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"知府孙学士见示和终南监宫太保道怀五首因以缀篇 其三","author":"范仲淹","text":"汉陂高兴自飘飘，何必天台渡石桥。\n潭上药灵多饵菊，林间诗逸半书蕉。\n勤歌兰佩招逋隐，懒事尘缨逐采僚。\n客有赤松盟约在，异时猿鹤不相辽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"知府孙学士见示和终南监宫太保道怀五首因以缀篇 其五","author":"范仲淹","text":"门外烟岚紫阁横，九衢风土更何情。\n篱边醉傲渊明饮，陇上歌随桀溺耕。\n三乐放怀千古重，万钟回首一毫轻。\n鹏鹪共适逍遥理，谁复人间问不平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"知府孙学士见示和终南监宫太保道怀五首因以缀篇 其四","author":"范仲淹","text":"瑶坛日月静中长，诗思时时逸谢塘。\n神枕自成仙岛梦，朝衣犹有御炉香。\n三元秘简侵星奏，五岭灵芽待雪尝。\n金阙九重留不住，高风何处是严光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试笔","author":"范仲淹","text":"偶缘疏拙得天真，岂问前途屈与伸。\n车马纵能欺倦客，江山犹可助骚人。\n懒如叔夜书盈几，狂似渊明酒满巾。\n况有南窗姬易在，此心那更起纤尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刁纺户掾太常下第","author":"范仲淹","text":"精鉴本非深，英僚暂此沉。\n火炎方试玉，沙密偶遗金。\n岂累青云器，犹孤白雪音。\n敢希苏季子，潜有激仪心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送石曼卿","author":"范仲淹","text":"河光岳色过秦关，英气飘飘酒满颜。\n贾谊书成动西汉，谢安人笑起东山。\n亨途去觉云天近，旧隐回思水石闲。\n此道圣朝如不坠，疏封宜在立谭间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送向综国博通判桂州","author":"范仲淹","text":"通籍三公后，监州五岭深。\n欲知明主意，将慰远人心。\n岁计多藏药，舟行不废琴。\n归书清白最，宁问橐中金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送江南运使张传度支","author":"范仲淹","text":"刑措东南始诏回，重分邦计命钦哉。\n于公已积充闾庆，萧相还施富国才。\n十郡甘棠歌未歇，一方流马路初开。\n启心知有嘉谟在，足乱云霓忆帝台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":31532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]