[{"title":"题蕲倅烟霏亭","author":"王质","text":"落木寒声晚更悲，斜阳隐隐雾霏霏。\n并塘官路青莎合，带郭人家绿树围。\n莫遣风霜惊雁字，从教烟雨润凫衣。\n接䍦吹动肩楼耸，却下脩篁径里归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24375,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张君量恩波寺","author":"王质","text":"恩波全似海波深，聊傍支流筑小亭。\n下映南山千丈影，上通云汉一河星。\n濠梁此日堪同乐，文沼何时共效灵。\n人意亦随鱼意好，一觥相对万荷青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24376,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题挹翠楼","author":"王质","text":"胸中磊磈但江山，翠积灵台挹不乾。\n拂子折时无点滴，杖头转处涌波澜。\n收回晚照千岩静，放出灵光万壑寒。\n我欲登楼聊举眼，乾坤虽大不能宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24377,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张安国为朱黄二豪作传索赋诗","author":"王质","text":"二豪名字遍人间，未许痴儿见一斑。\n俯仰半生双鬓秃，是非千古寸心关。\n向来踪迹埋空谷，老去文章满道山。\n我有诗书三十乘，肯来相伴小窗閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24378,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余过荆州张安国已请祠先行","author":"王质","text":"心事何曾吐一分，鼓严早已报三声。\n元戎十乘公先启，野渡孤舟我自横。\n细看好山须少驻，缓摇柔橹莫多鸣。\n倘能黄鹤楼前见，安得春江尾柁行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24379,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵景山程德绍视旱有诗成编","author":"王质","text":"相随骑尾紫游缰，各佩牛腰古锦囊。\n过眼风烟都领略，聚头灯火更平章。\n鹊枝赋罢骄横槊，蚓鼎联成倦倚墙。\n三读轩渠仍伎痒，亦撩草梦到池塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24380,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送陶茂安知永州","author":"王质","text":"弓刀陌上起征尘，行到潇湘春已深。\n柳子文章亲到眼，魏公池馆故沾襟。\n莫生去鲁迟迟想，且慰歌廉望望心。\n泷水浯溪江不隔，肯凭鲤尾寄佳音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24381,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观政堂成上黄少誉二首 其一","author":"王质","text":"胸中道德五千文，聊借高堂发妙音。\n背倚飞楼怀古意，面临止水正人心。\n新荷此际敷青叶，稚柳他年贮绿阴。\n但使厨烟无太远，时来分座伴孤斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24382,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观政堂成上黄少誉二首 其二","author":"王质","text":"颍州丞相旧能名，传到云孙尚典型。\n月在澄潭心共白，山围宴坐眼同青。\n暂离方丈群仙侣，独抱黄庭一卷经。\n十顷玻璃能几许，看公击水渡南溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24383,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题邕希孟静室","author":"王质","text":"绿玉珊珊密映门，双扉不受一丝尘。\n经函药鼎元无用，茗椀熏炉总是真。\n坐阅百年俱幻境，肯悬一榻贮閒身。\n麈毛挥罢无人语，静看冰壶一点春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24384,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送钮子明","author":"王质","text":"大夫离别莫心酸，痛饮长歌作壮颜。\n勿羡春江烧赤壁，须从夜碛度阴山。\n精神勃郁双眉上，功业轮囷十指间。\n看罢吴钩腾上马，临分小试出三关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24385,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老人尝馔北食儿女辈不能过芜湖多鱼且美仆生长泽国不可一日无此","author":"王质","text":"不得扬州蟹蛤尝，江乡鱼味亦相当。\n自从南渡为生理，惭见东人说故乡。\n出火麦团犹雪白，带浆米饭更鹅黄。\n老人日日惟须此，长笑儿郎太楚伧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24386,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"含山寺","author":"王质","text":"一僧庞眉拄杖扶，自汲石泉浇茗盂。\n山深松树须髯古，寺老木鱼鳞甲枯。\n心閒逢人谢礼乐，身倦到枕即江湖。\n梦回石壁半斜照，蝙蝠打人山鸟呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24387,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王仲钤口号","author":"王质","text":"华屋沈沈燕不哗，绿阴悄悄树含花。\n旌旗照野元戎壮，礼乐充庭使者华。\n解袂莫辞双玉酒，同班行待五云车。\n金虬度彻阳关曲，佳月随人未肯斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24388,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送胡正仲二首 其一","author":"王质","text":"万安松槚已参天，属眼昆仍故宛然。\n荣尹堂前周两纪，甘王楼下跨三年。\n八风翻海如如定，一月当空在在圆。\n太极清都天尺五，柂牙捩转去翩翩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24389,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送胡正仲二首 其二","author":"王质","text":"稍稍秋风吹客衣，浮云斜照送将归。\n摇开楚岸蝉方急，行到吴江雁已飞。\n直恐相思衣带缓，无令问讯驿书稀。\n一牛鸣地难倾倒，何况山川道路违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24390,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和陈阜卿","author":"王质","text":"雨花台下晚江秋，曾对斜阳倒玉舟。\n自断我当归吊屈，不应君亦未封留。\n异时兵里同悲喜，今日樽前再劝酬。\n怅望佳人云暮合，空遗别恨与汤休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24391,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送酒与胡倅","author":"王质","text":"青坚堂下出香泉，历历春声到耳边。\n卷起白波滋舌本，养成黄气舞胎仙。\n帝觞他日分涓滴，家酿今朝养圣贤。\n饮罢铃绦应已制，汝阳乘此去朝天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24392,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘子开二首 其一","author":"王质","text":"帝恩无吏肯承宣，雨露滂沱贮半天。\n璀璨两星同拱所，萧梢一骥独当先。\n驱驰足下千重茧，忠孝心头一寸田。\n孺子亭前见三隽，为言秋事亦茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24393,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送刘子开二首 其二","author":"王质","text":"尘中拈出玉光明，追琢多年老更精。\n会使低头降志士，无令抵掌笑书生。\n此行原野霜风急，所过溪湖潦水平。\n鸿雁同天不同侣，为传好在与南卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24394,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王充老归旴江","author":"王质","text":"风遣轻蒲趣去程，满江秋月碧纷纷。\n相看断雁情何极，同著征衫袂更分。\n千里固应俱对月，一樽安得再论文。\n从今竹枕蓬窗梦，不梦悬刀只梦君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24395,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送李公","author":"王质","text":"海内堂堂见此公，孤高不与万夫同。\n身行宇宙东西遍，心彻乾坤表里通。\n莫共林泉谋老境，更看彝鼎篆新功。\n君王拊髀休长叹，亦有英豪在眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24396,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送赵子真送藏经于朝廷","author":"王质","text":"忆昔同游金凤台，临高望远思悠哉。\n重来又作燕山别，不意翻为驿马催。\n宝藏元辉天上去，塞尘秋色鬓边来。\n归期已定终年约，莫遣丹心一寸灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24397,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别张君玉二首 其一","author":"王质","text":"烟霜江汉雁南飞，鹦鹉洲前再拜辞。\n风劲周郎焚舰日，月明庾老上楼时。\n无言只共江声语，有意惟凭山色知。\n他日中原公事了，磨崖千丈要丰碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24398,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别张君玉二首 其二","author":"王质","text":"白云黄鹤会相逢，湖北江南故楚宫。\n拭目文章王八座，叩头勋业赵三公。\n今朝侧耳听奇伟，何日投身佐事功。\n公到京师相记忆，芦花江上竹竿风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24399,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢王巽泽新火","author":"王质","text":"月落参横剥啄声，起惊新火到陈人。\n鬓随周爟年年改，心共商盘日日新。\n桐甑饭香增意气，草堂灯影换精神。\n侯家宫蜡晴烟起，公自他时作好春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24400,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢范西叔惠诗","author":"王质","text":"世间无可似君诗，兔杵声寒露脚飞。\n颔下骊珠能夺取，袖中沧海更携归。\n久荒此事成疏懒，赖有斯人为发挥。\n佳处不随车马得，但扶古堞看斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24401,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠徐辉","author":"王质","text":"五曜循环十二宫，乾坤尽落往来中。\n竹罗书在人安在，姑射山空道不空。\n畴昔未能知本末，从今不复问穷通。\n东楼恣享湖山乐，三尺阑干万里风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24402,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠汤元亨","author":"王质","text":"汤子亲携宝鉴囊，路开春草见王郎。\n只今萍梗栖湓浦，畴昔松楸在建康。\n数转话端才历历，一生身世不茫茫。\n从今点破心间事，独对东风笑一场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24403,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠邓东","author":"王质","text":"青藜半夜放光明，玉字金文下太清。\n举眼试看君行略，点头会尽我平生。\n运行胜景丁居丑，岁建昌期乙遇庚。\n四十五年如梦过，尚堪晚景见升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24404,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠刘遂良","author":"王质","text":"二年不下竹匡床，枕损茅斋小米囊。\n吹起江风渡刘子，踏开荒草见王郎。\n胡湾此际谈三命，淝水何时战一场。\n他日中原公事了，与君同话此荒凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24405,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和李粹伯","author":"王质","text":"不多风雨已秋容，惨澹斜阳湿晚红。\n长忆蘋风过归雁，更思烟浪拍垂虹。\n未应堂上烛能灭，所愿樽中酒不空。\n卷雪楼前卸帆日，却从天际望吴中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24406,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又和李粹伯","author":"王质","text":"云似诸公簿领閒，不名阿堵但江山。\n秋风未白平生发，尊酒聊赪壮士颜。\n醉后参虚无咫尺，悲来天地总间关。\n归眠梦绕潇湘野，红叶黄花满望斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24407,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"问王稚川觅酒","author":"王质","text":"麦天一似菊花秋，涩雨痴风故作愁。\n幸自从来公不饮，何如乞与我销忧。\n胶胶扰扰谁能问，兀兀陶陶得即休。\n七泽五湖烟水阔，可容閒梦到沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24408,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次通守韵题和政堂","author":"王质","text":"搀天高柳意堂堂，柳外山长水亦长。\n百尺冰壶清彻底，一川云锦烂生光。\n暂看属玉摇波影，速驾麒麟入帝乡。\n宣曲宜春骖辇路，上林风味薄沙棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和郭子应二首 其一","author":"王质","text":"出门吹面已薰风，春在垂杨惨淡中。\n我辈不须悲聚散，此江元自有西东。\n日暄波暖鱼苗出，雨润泥融燕颔丰。\n尚可淹留成一醉，引杯说剑未输公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和郭子应二首 其二","author":"王质","text":"北窗睡起复西窗，心事悠悠付枕囊。\n日静无人惊燕雀，野青随意卧牛羊。\n愁中故自伤游子，别后还应忆漫郎。\n万里梅边寻斗米，夫君身世亦遑遑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和张君玉","author":"王质","text":"且把锄头且著书，懒随臣朔怖侏儒。\n车肠久自思怀橘，蓬首还应念执殳。\n未暇洞天寻小有，尽将世界付南无。\n不知南北东西后，肯寄书来问老夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和张君玉与史乔年","author":"王质","text":"弩矢先驱导绣衣，芙蓉倒影动旌旗。\n行归容与螭头陛，且去摩挲岘首碑。\n吴帝城边逢此日，越王楼上忆他时。\n相烦问讯隆中陌，尚有当年草木知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和张君玉","author":"王质","text":"使星卿月共光辉，行转杓衡入紫微。\n白粲万樯军总饱，红稠千干马能飞。\n后身叔子今安得，万代夷吾古亦希。\n风动一江吹晚雪，岁云暮矣送将归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和沈述之赠权干诗","author":"王质","text":"江枫不敌寸心丹，何待霜雄吏自寒。\n满眼空空无一佛，举头在在有三官。\n毛端解运三千界，脚底常飞九万抟。\n凫茈馀根挑欲尽，莫忧鲁巷有颜箪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用沈述之韵赋灵槎","author":"王质","text":"甘王楼下挽清晖，不到三湘识九疑。\n骨健任从波浪啮，眼空冷看市朝移。\n常怀一篑香炉日，不见三峰雪岭时。\n安得杜苏添此沈，相从地上作三奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵姚贵聪","author":"王质","text":"小帘低捲一庵春，茗椀薰炉作意新。\n今日共欢何事酒，他年定托不孤邻。\n愁肠缭绕终难展，醉字横斜半失真。\n遥望江流横日脚，极思沙嘴问归津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次通守韵题廓斋","author":"王质","text":"遥传碧落入新除，早向清都卜定居。\n金勒鸣珂班退后，玉堂挥翰酒醒馀。\n试听掣动铃绦响，惊看飞来锦帕舒。\n甘露堂前正秋色，集贤如堵望相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"银山寺和宗禅师四季诗 春","author":"王质","text":"但听清圆不觉喧，松床纸帐坦便便。\n草深雉子争烘日，树暖蜂雏懒趁烟。\n无事石头频打睡，有时村店暂逃禅。\n寻花问柳山前后，隐隐钟声暮已传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"银山寺和宗禅师四季诗 夏","author":"王质","text":"绕廊行听铎丁当，禾稻桑麻各一乡。\n竹影能令心洒落，溪声自与意清凉。\n门无惊鹿冲篱破，路有疏萤掠草光。\n才到斜阳生暮霭，满庭山露滴松香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"银山寺和宗禅师四季诗 秋","author":"王质","text":"尘埃飞不到郊坰，山鹿溪鱼任意行。\n密径竹烟迷暮影，幽岩松露滴秋声。\n烧残野草斓斑黑，脱尽疏林隐约明。\n溪石棱棱波激激，水花红紫谢还生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"银山寺和宗禅师四季诗 冬","author":"王质","text":"夹径长松耐凛冬，随溪觅路杳无穷。\n晓霜易滑荆桥上，朔雪难侵纸帐中。\n溪冷无鱼供酒客，林荒有鹿伴樵翁。\n江湖水泺多芦苇，不异飘鸿泊野风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答杨教见和","author":"王质","text":"饭鼓逢逢睡起时，先生弟子总关扉。\n不妨堂下轻骑马，切莫江头浪典衣。\n且对灯花随雨落，任从苜蓿列盘稀。\n杜陵郑老襟期在，今昨那能定是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽赵处士","author":"王质","text":"叩阍凛凛疏三通，归社萧萧酒一钟。\n龙卧高阳呼不醒，鹏飞北海去无踪。\n无年及见安车召，有子能荒大国封。\n想见功名心未死，亦随江汉去朝宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吊法空","author":"王质","text":"鹤不胜癯汝更癯，平沙独立未为孤。\n雨花台上方知有，明月堂中竟省无。\n此夜吟风凭北固，何时乘月叩西湖。\n出头已解挑包走，试路西江问老夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽虞丞相","author":"王质","text":"一德风云会，千秋海岳灵。\n中涵天度量，外峙玉仪形。\n人物如三代，文章似六经。\n嘉谋调药石，伟望振雷霆。\n二水盘明镜，三嵎揭秀屏。\n天心开俊杰，世路化畦町。\n采石交绥急，参谋揽辔停。\n舟中掬晋指，屋上建秦瓴。\n帝座忧回喜，邦人醉得醒。\n江声鸣历历，图画俨亭亭。\n蜀道驰宣诏，函关寖启扃。\n希文初遇吕，平仲卒逢丁。\n直北烟都歇，居东雨载零。\n野随裴令绿，竹为武公青。\n宇宙倾风采，朝廷迟典刑。\n三边频仗节，七府遍移厅。\n坚重车方轨，光新刃发硎。\n事融汤里雪，物转手中瓶。\n杞梓充庭茂，芝兰满甸馨。\n宝奁森漆栗，乐笼富参苓。\n幽士宁悲鵩，该儒总识鼮。\n输怀情缱绻，接语步竛竮。\n岩壑多空帐，江湖少带笭。\n姚崇资倜傥，葛亮意丁宁。\n秀气横连霍，洪恩沇溢荥。\n德威驯虎兕，道力化蝗螟。\n烽燧寒边堠，桑麻蔽远坰。\n农熙牛??，兵劲马駉駉。\n雁泽宽心驻，龙沙侧耳听。\n檄囊停插羽，纶阁缓摇铃。\n周廪仍多黍，尧阶再产蓂。\n长杨荒御宿，茂草鞠虚囹。\n忽化双林火，俄流五丈星。\n更生游佛国，中卫立仙庭。\n陵寝稽朝洛，王师寖度泾。\n萧何虽镇蜀，韩信未踰陉。\n鹤踞新华表，鲸归旧紫溟。\n月明空皎皎，风远但泠泠。\n蚤岁蒙推奖，多时备使令。\n盘餐传舴艋，茵吐溅篁箳。\n追琢参群玉，调和作五鲭。\n自从悲殄瘁，谁弗念伶俜。\n道路纡脩阻，音尘堕杳冥。\n口呿惟墨墨，头点自惺惺。\n发白心随老，灯青目不瞑。\n有声号井络，无路挽车軨。\n睿意思元老，徽章播大廷。\n云台先邓禹，烟阁重房龄。\n未解联温赞，何劳勒固铭。\n孙多骐骥骨，子悉凤凰翎。\n生死虽无憾，哀荣不忍聆。\n一从云隔汉，两见水漫汀。\n飞梦风翻絮，浮生浪捲萍。\n西尘黯沈日，双照泪荧荧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24426,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灯花","author":"王质","text":"造化管不得，要开时便开。\n洗天风雨夜，春色满银台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24427,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"团扇歌","author":"王质","text":"鸾背如花女，出自咸阳宫。\n不愁无主爱，惟怕见秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24428,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹夫人二首 其一","author":"王质","text":"夫人承主爱，不在鸳鸯帏。\n庭枫飘一叶，满眼贮秋悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24429,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹夫人二首 其二","author":"王质","text":"洞房暗薰结，谁作双蝴蝶。\n夫人独自梦，清露泣寒月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24430,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上虞相行春口号十首 其一","author":"王质","text":"宾从行间锦作团，相公马上玉为山。\n今朝除却西湖好，天下无春似此间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24431,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上虞相行春口号十首 其二","author":"王质","text":"驰上平冈小打围，相公自控紫丝鞿。\n一鞭挥出三千骑，惊动流红窣窣飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24432,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上虞相行春口号十首 其三","author":"王质","text":"蝶整莺齐不乱飞，好风吹雨上花啼。\n和宁门外沙如雪，且向江堤试马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24433,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上虞相行春口号十首 其四","author":"王质","text":"团红碎绿罥丝飞，不敢轻轻触衮衣。\n正欲辞春春未许，且教留待相公归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24434,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上虞相行春口号十首 其五","author":"王质","text":"暖雾昏云养麦天，春风引绿去绵绵。\n种成百万军民饱，忠孝心头一寸田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24435,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上虞相行春口号十首 其六","author":"王质","text":"浪縠高张碧四垂，游丝欲下不能低。\n斜阳却恐花成睡，只在天边未肯西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24436,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]