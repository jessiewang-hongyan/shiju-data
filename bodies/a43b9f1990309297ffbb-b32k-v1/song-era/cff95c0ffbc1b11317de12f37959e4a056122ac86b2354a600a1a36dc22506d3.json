[{"title":"残腊","author":"欧阳修","text":"腊雪初销上古台，桑郊向日綵旗开。\n山横南陌城中见，春逐东风海上来。\n老去每惊新岁换，病多能使壮心摧。\n自嗟空有东阳瘦，览物惭无八咏才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"独至香山忆谢学士","author":"欧阳修","text":"伊水弄春沙，山临水上斜。\n曾为谢公客，遍入梵王家。\n阴涧初生草，春岩自落花。\n却寻题石处，岁月已堪嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日与诸君马头山登高","author":"欧阳修","text":"晴原霜后若榴红，佳节登临兴未穷。\n日泛花光摇露际，酒浮山色入樽中。\n金壶恣洒毫端墨，玉麈交挥席上风。\n惟有渊明偏好饮，篮舆酩酊一衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋阴","author":"欧阳修","text":"秋阴积不散，夜气凛初清。\n雨冷侵灯晕，风愁送叶声。\n国恩惭未报，岁晚念馀生。\n却忆滁州睡，村醪自解酲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋怀","author":"欧阳修","text":"节物岂不好，秋怀何黯然。\n西风酒旗市，细雨菊花天。\n感事悲双鬓，包羞食万钱。\n鹿车终自驾，归去颍东田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋郊晓行","author":"欧阳修","text":"寒郊桑柘稀，秋色晓依依。\n野烧侵河断，山鸦向日飞。\n行歌采樵去，荷锸刈田归。\n秫酒家家熟，相邀白竹扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赴集禧宫祈雪追忆从先皇驾幸泫然有感","author":"欧阳修","text":"琳阙岧岧倚瑞烟，忆陪游豫入新年。\n云深晓日开宫殿，水阔春风飏管弦。\n千骑清尘回辇路，万家明月放灯天。\n一朝人事凄凉改，惟有灵光独岿然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"退居述怀寄北京韩侍中二首 其二","author":"欧阳修","text":"书殿宫臣宠并叨，不同憔悴返渔樵。\n无穷兴味闲中得，强半光阴醉里销。\n静爱竹时来野寺，独寻春偶过溪桥。\n犹须五物称居士，不及颜回饮一瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"退居述怀寄北京韩侍中二首 其一","author":"欧阳修","text":"悠悠身世比浮云，白首归来颍水濆。\n曾看元臣调鼎鼐，却寻田叟问耕耘。\n一生勤苦书千卷，万事销磨酒百分。\n放浪岂无方外士，尚思亲友念离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送丁元珍峡州判官","author":"欧阳修","text":"为客久南方，西游更异乡。\n江通蜀国远，山闭楚祠荒。\n油幕无军事，清猿断客肠。\n惟应陪主诺，不费日飞觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送公期得假归绛","author":"欧阳修","text":"风吹积雪销太行，水暖河桥杨柳芳。\n少年初仕即京国，故里几归成鬓霜。\n山行马瘦春泥滑，野饭天寒饧粥香。\n留连芳物佳节过，束带还来朝未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送友人南下","author":"欧阳修","text":"河桥别柳减春条，隔浦挐音听已遥。\n千里羹莼誇敌酪，满池滮稻欲鸣蜩。\n东风楚岸神灵雨，残月吴波上下潮。\n如吊湘累搴香若，秋江斜日驻兰桡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王公慥判官","author":"欧阳修","text":"久客倦京国，言归岁已冬。\n独过伊水渡，犹听洛城钟。\n山色经寒绿，云阴入暮重。\n腊梅孤馆路，疲马有谁逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王平甫下第","author":"欧阳修","text":"归袂摇摇心浩然，晓船鸣鼓转风滩。\n朝廷失士有司耻，贫贱不忧君子难。\n执手聊须为醉别，还家何以慰亲欢。\n自惭知子不能荐，白首胡为侍从官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王汲宰蓝田","author":"欧阳修","text":"喧喧动车马，共出古都门。\n落日催行客，东风吹酒樽。\n树摇秦甸绿，花入辋川繁。\n若遇西来旅，时应问故园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王学士赴两浙转运","author":"欧阳修","text":"汉家财利析秋毫，暂屈清才岂足劳。\n邑屋连云盈万井，舳舻衔尾列千艘。\n春寒欲尽黄梅雨，海浪高翻白鹭涛。\n平昔壮心今在否，江山犹得助诗豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王尚恭隰州幕","author":"欧阳修","text":"去国初游宦，从军苦寂寥。\n愁云带城起，画角向山飘。\n秋劲方驰马，春寒正袭貂。\n遥知为客恨，应赖酒杯消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送王尚哲三原尉","author":"欧阳修","text":"初仕便西辕，骊驹两佩环。\n山河识天府，风雨度函关。\n桑柘千畴富，人烟万井闲。\n欲为京洛咏，应苦簿书间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送左殿丞入蜀","author":"欧阳修","text":"传闻蜀道难，行客若登天。\n紫竹深无路，黄花忽见川。\n闻禽嗟异域，问俗访耆年。\n欲识京都远，惟应望日边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送田处士","author":"欧阳修","text":"秦士多豪侠，夫君久遁名。\n青山对高卧，白首喜论兵。\n气古时难合，诗精格入评。\n公车不久召，归袖夕风生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送目","author":"欧阳修","text":"送目衡皋望不休，江蘋高下遍汀洲。\n长堤柳曲妨回首，小苑花深碍倚楼。\n楚径蕙风消病渴，洛城花雪荡春愁。\n流杯三日佳期过，掷度兰波负胜游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送石扬休还蜀","author":"欧阳修","text":"长爱谪仙誇蜀道，送君西望重吟哦。\n路高黄鹄飞不到，花发杜鹃啼更多。\n清禁寒生凤池水，绣衣荣照锦江波。\n昔年同舍青衿子，夹道欢迎鬓已皤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘半千平阳簿","author":"欧阳修","text":"岭梅归驿路迢迢，越鸟巢倾木半乔。\n松径就荒聊应召，桂丛留隐定相招。\n家庭噪鹊争喧树，夜帐惊猿自拥条。\n何处秋风摧客鬓，青丝恐逐物华凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送同年史褒之武功尉","author":"欧阳修","text":"久作游边客，常悲入塞笳。\n今兹一尉远，犹困折腰嗟。\n白马关中道，青天栈外家。\n过秦应吊古，惟有故山斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送馀姚陈寺丞","author":"欧阳修","text":"铜墨佩腰间，中流望若仙。\n鸣蝉汴河柳，画鹢越乡船。\n下濑逢江雁，瞻氛落海鸢。\n山川仍客思，尽入隐侯篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张生","author":"欧阳修","text":"一别相逢十七春，颓颜衰发互相询。\n江湖我再为迁客，道路君犹困旅人。\n老骥骨奇心尚壮，青松岁久色逾新。\n山城寂寞难为礼，浊酒无辞举爵频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张吉老赴浙宪","author":"欧阳修","text":"吴越东南富百城，路人应羡绣衣荣。\n昔时结客曾游处，今见焚香夹道迎。\n治世用刑期止杀，仁心听狱务求生。\n时丰讼息多馀暇，无惜新篇屡寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张如京知安肃军","author":"欧阳修","text":"相逢旧从事，新命忽临戎。\n界上山河壮，军中鼓角雄。\n朔风驰骏马，塞雪射惊鸿。\n试取封侯印，何如笔砚功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李寔","author":"欧阳修","text":"几幅归帆不暂停，吴天遥望斗牛横。\n香薰翠被乘青翰，波暖屏风咏紫茎。\n江水自随潮上下，月轮闲与蚌亏盈。\n河桥折柳伤离后，更作南云万里行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送杨先辈登第还家","author":"欧阳修","text":"解榻方欣待俊英，挂帆千里忽南征。\n锦衣白日还家乐，鹤发高堂献寿荣。\n残雪楚天寒料峭，春风淮水浪峥嵘。\n知君归意先飞鸟，莫惜停舟酒屡倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送杨君之任永康","author":"欧阳修","text":"剑峰云栈未尝行，图画曾看已可惊。\n险若登天悬鸟道，下临无地泻江声。\n折腰莫以微官耻，为政须通异俗情。\n况子多才兼美行，荐章期即达承明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送杨君归汉上","author":"欧阳修","text":"我昔谪穷县，相逢清汉阴。\n拂尘时解榻，置酒屡横琴。\n介节温如玉，嘉辞掷若金。\n趣当乡士荐，无滞计车音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送沈学士知常州","author":"欧阳修","text":"旧馆芸香锁寂寥，斋舲东下入秋涛。\n江晴风暖旌旗飏，木落霜清鼓角高。\n吟就綵笺宾已醉，舞翻红袖饮方豪。\n平生粗得为州乐，因羡君行首重搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送沈待制陜西都运","author":"欧阳修","text":"几岁疮痍近息兵，经营方喜得时英。\n从来汉粟劳飞挽，当使秦人自战耕。\n道左旌旗诸将列，马前弓剑六蕃迎。\n知君材力多闲暇，剩听阳关醉后声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送辛判官","author":"欧阳修","text":"被荐方趋召，还乡仍綵衣。\n看山向家近，上路逐鸿飞。\n结绶同为客，登高独送归。\n都门足行者，莫讶柳条稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送京西提刑赵学士","author":"欧阳修","text":"题舆尝屈佐留京，揽辔今行按属城。\n楚馆尚看淮月色，嵩云应过虎关迎。\n春寒酒力风中醒，日暖梅香雪后清。\n野俗经年留惠爱，莫辞临别醉冠倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郑革先辈赐第南归","author":"欧阳修","text":"少年乡誉叹才淹，六十犹随贡士函。\n握手亲朋惊白发，还家闾里看青衫。\n阁涵空翠连衡阜，门枕寒江落楚帆。\n试问尘埃勤斗禄，何如琴酒老云岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送郓州李留后","author":"欧阳修","text":"北州遗颂蔼嘉声，东土还闻政有成。\n组甲光寒围夜帐，綵旗风暖看春耕。\n金钗坠鬓分行立，玉麈高谈四坐倾。\n富贵常情谁不羡，爱君风韵有馀清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送前巫山宰吴殿丞","author":"欧阳修","text":"俊域当年仰下风，天涯今日一樽同。\n高文落笔妙天下，清论挥犀服坐中。\n江上挂帆明月峡，云间谒帝紫微宫。\n山城寂寞少嘉客，喜见琼枝慰病翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送威胜军张判官","author":"欧阳修","text":"北地不知春，惟看榆叶新。\n岑牟多武士，玉麈重嘉宾。\n野燐惊行客，烽烟入远尘。\n系书沙上雁，时寄日边人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送客回马上作","author":"欧阳修","text":"南浦空波绿，西陂夕照寒。\n瑶华伤远道，芳草送归鞍。\n翠敛遥山叠，氛收古泽宽。\n衰容畏秋色，不及楚枫丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送祝熙载之东阳主簿","author":"欧阳修","text":"吴江通海浦，画舸候潮归。\n叠鼓山间响，高帆鸟外飞。\n孤城秋枕水，千室夜鸣机。\n试问还家客，辽东今是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵山人归旧山","author":"欧阳修","text":"屈贾江山思不休，霜飞翠葆忽惊秋。\n吟抛楚畹兰苕老，归有淮山桂树留。\n聒耳春池蛙两部，比封秋坞橘千头。\n嗔条怒颖真堪愧，莫染衣尘更远游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送润州通判屯田","author":"欧阳修","text":"船头初转两旗开，清晓津亭叠鼓催。\n自古江山最佳处，况君谈笑有馀才。\n云愁海阔惊涛涨，木落霜清画角哀。\n善政已成多雅思，寄诗宜逐驿筒来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送致政朱郎中东归","author":"王安石","text":"平生不省问田园，白首忘怀道更尊。\n已上印书通北阙，稍留冠盖饯东门。\n冯唐老有为郎恋，疏广终无任子恩。\n今日荣归人所羡，两儿腰绶拥高轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送贾推官赴绛州","author":"欧阳修","text":"白云汾水上，人北雁南飞。\n行李山川远，风霜草木腓。\n郡斋宾榻挂，幕府羽书稀。\n最有题舆客，偏思玉麈挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送高君先辈还家","author":"欧阳修","text":"闲居寂寞面重城，过我时欣倒屣迎。\n入洛机云推俊誉，游梁枚马得英声。\n风晴秀野春光变，梅发家林鸟哢轻。\n祗待登高成丽赋，汉庭推毂有公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梅龙图公仪知杭州","author":"欧阳修","text":"万室东南富且繁，羡君风力有馀闲。\n渔樵人乐江湖外，谈笑诗成樽俎间。\n日暖梨花催美酒，天寒桂子落空山。\n邮筒不绝如飞翼，莫惜新篇屡往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梅秀才归宣城","author":"欧阳修","text":"从学方年少，还家罄橐金。\n久为江北客，能作洛生吟。\n罢亚霜前稻，钩辀竹上禽。\n归帆何处落，应拂野梅林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送黄通之郧乡","author":"欧阳修","text":"君子贵从俗，小官能养贤。\n无惭折腰吏，勉食落头鲜。\n困有亨之理，穷当志益坚。\n惟宜少近祸，亲发况皤然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送谢中舍二首 其二","author":"欧阳修","text":"喜闻嘉誉蔼淮壖，又看吴帆解画船。\n陇亩遗民谈旧政，江山馀思入新篇。\n人生白首吾今尔，仕路青云子勉旃。\n举棹南风吹酒醒，禽觞莫惜少留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送谢中舍二首 其一","author":"欧阳修","text":"滁南幽谷抱山斜，我凿清泉子种花。\n故事已传遗老说，世人今作画图誇。\n金闺引籍子方壮，白发盈簪我可嗟。\n试问弦歌为县政，何知樽俎乐无涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送道州张职方","author":"欧阳修","text":"桂籍青衫忆共游，怜君华发始为州。\n身行南雁不到处，山与北人相对愁。\n莫为高才轻远俗，当令遗老识贤侯。\n三年解组来归日，吾已先耕颍水头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送楚建中颍州法曹","author":"欧阳修","text":"冠盖盛西京，当年相府荣。\n曾陪鹿鸣宴，遍识洛阳生。\n共叹长沙谪，空存许劭评。\n堪嗟桃李树，何日见阴成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送窦秀才","author":"欧阳修","text":"晴原高下细如鳞，树转城回路欲分。\n望月西楼人共远，跃鞍南陌草初薰。\n短亭山翠偏多叠，送目鸿惊不及群。\n一驿赋成应援笔，好凭飞翼寄归云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送廖八下第归衡山","author":"欧阳修","text":"曾作关中客，尝窥百二疆。\n自言秦陇水，能断楚人肠。\n失意倦京国，羁愁成鬓霜。\n何如伴征雁，日日向衡阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送薛水部通判并州","author":"欧阳修","text":"胸怀磊落逢知己，气略纵横负壮心。\n玉麈生风宾满坐，金鳞照甲士如林。\n牛羊日暖山田美，雨雪春寒土屋深。\n自古幽并重豪侠，祗应行乐费黄金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送襄陵令李君","author":"欧阳修","text":"绿发襄陵新长官，面颜虽老渥如丹。\n折腰聊为五斗屈，把酒犹能一笑欢。\n红枣林繁欣岁熟，紫檀皮软禦春寒。\n民淳政简居多乐，无苦思归欲挂冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郡斋忆书事寄子履","author":"欧阳修","text":"使君居处似山中，吏散焚香一室空。\n雨过紫苔惟鸟迹，夜凉苍桧起天风。\n白醪酒嫩迎秋熟，红枣林繁喜岁丰。\n寄语瀛洲未归客，醉翁今已作仙翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻朱祠部罢浔州归阙","author":"欧阳修","text":"汉柱题名墨未乾，南州坐布政条宽。\n岭云路隔梅攲驿，使驿秋归柳拂鞍。\n建礼侵晨趋冉冉，明光赐对佩珊珊。\n颍川此召行闻拜，冠頍凝尘俟一弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻沂州卢侍郎致仕有感","author":"欧阳修","text":"少年相与探花开，老病惟愁节物催。\n蹉跎归计荒三径，牢落生涯泥一杯。\n颍上先生招不起，沂州太守亦归来。\n自愧国恩终莫报，尚贪荣禄此徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻原甫久在病告有感","author":"欧阳修","text":"东城移疾久离居，安得疑蛇意尽祛。\n诸老何为谗贾谊，君王犹未识相如。\n浮沉俗喜随时态，磊落材多与世疏。\n谁谓文章金马客，翻同憔悴楚三闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻颍州通判国博与知郡学士唱和颇多因以奉寄知邵陆经通判杨褒","author":"欧阳修","text":"一自苏梅闭九泉，始闻东颍播新篇。\n金樽留客史君醉，玉麈高谈别乘贤。\n十里秋风红菡萏，一溪春水碧漪涟。\n政成事简何为乐，终日吟哦杂管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"倦征","author":"欧阳修","text":"沈约伤春思，嵇含倦久游。\n帆归黄鹤浦，人滞白蘋洲。\n乳燕差池远，江禽格磔浮。\n物华真可玩，黑鬓恐逢秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"原甫致斋集禧余亦摄事后庙谨呈拙句兼简圣俞","author":"欧阳修","text":"受命分行摄上公，紫微人在玉华宫。\n楼台碧瓦辉云日，莲芰清香带水风。\n每接少年嗟老病，尚能联句恼诗翁。\n凌晨已事追佳赏，绿李甘瓜兴未穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]