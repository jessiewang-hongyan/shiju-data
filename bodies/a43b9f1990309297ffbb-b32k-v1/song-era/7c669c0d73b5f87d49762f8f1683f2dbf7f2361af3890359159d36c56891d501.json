[{"title":"山中桃花","author":"郑獬","text":"春入关山亦未迟，苧萝山下见西施。\n不羞白发欺双鬓，且对清尊插一枝。\n纵落不随流水去，仅开惟有白云知。\n何须惆怅无人赏，自有春风二月时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"不出","author":"郑獬","text":"高卧即经旬，林间挂葛巾。\n野云閒照水，山鸟自啼春。\n酿酒期佳客，开书见古人。\n莓苔渍双履，不识洛阳尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云中忆归","author":"郑獬","text":"何日燕南去，平生此别稀。\n定知花已发，不及雁先归。\n寒日连云惨，惊沙带雪飞。\n云中风土恶，换尽别家衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"劝客饮","author":"郑獬","text":"谁解西回沧海波，且听白苧数声歌。\n人生所得只如此，世事到头无奈何。\n酒海莫教空濩落，金堆安用郁嵯峨。\n古今共是一丘土，只有刘生得计多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆在晋阳","author":"郑獬","text":"忆在晋阳日，曾为痛饮家。\n披衣投宿酒，把烛觅残花。\n莫解玉骢马，且留金钿车。\n壮游今不复，愁卧鬓将华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆泛西湖","author":"郑獬","text":"四面青山紫绣围，平湖万顷碧罗衣。\n风摇酒面金鳞活，月弄波光玉篆飞。\n醉客半眠红烛下，画船行唱采莲归。\n十年衣袖遮尘土，惆怅飞云满翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"月波楼","author":"郑獬","text":"古壕凿出明月背，楼角飞来兔影中。\n野色更无山隔断，天光直与水相通。\n溪藏画舫青纹接，人住荷花碧玉丛。\n谁把金鱼破清暑，晚云深处待归风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水馆","author":"郑獬","text":"绕舍清流淙碧玉，尘怀开阔洒然醒。\n窗棂风入秋气活，桥脚倒撑天面青。\n露湿风标红芰老，雨生鳞甲伏龙腥。\n将书借取琴高鲤，从此横骑入杳冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王氏园","author":"郑獬","text":"车马少行迹，邻僧为掩门。\n飞泉鸣似雨，老竹瘦于孙。\n幽鸟静相语，晚花寒亦繁。\n主人双绶重，游客倒金樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"东园招孙中叔","author":"郑獬","text":"花路横梢已碍马，断无人迹赏年芳。\n绿杨成穗点著地，蝴蝶作团飞过墙。\n不禁梦回多黯郁，长因酒后得凄凉。\n期君待与春翁约，买取东风任醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"乍凉","author":"郑獬","text":"云涌海潮黑，轩窗凉气侵。\n清风醒病骨，快雨破烦心。\n喷薄紫荷盖，飘飖青桂林。\n作诗招醉友，方外一相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正夫饮遐举家留佳什仆酷爱其金斗玉泉之句辄次高韵","author":"郑獬","text":"相逢渐向白头年，世路谙来尽付天。\n六印虽多终是客，一壶才倒即为仙。\n穿天入月捉诗句，搥鼓插旗飞酒船。\n长愿醉眠浑不醒，虚名安用俗儿传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石榴","author":"郑獬","text":"高枝重欲折，霜老裂丹肤。\n试剖紫金椀，满堆红玉珠。\n根虽传大夏，种必近仙都。\n题作江南信，人应贱橘奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伏谒太神御殿诗","author":"郑獬","text":"景烟满殿晓香清，日角龙颜五色明。\n五季积成天下乱，千年方有圣人生。\n重开混沌立万象，独斩蚩尤销五兵。\n愿作周公清庙颂，神孙世世告升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伤田肃秀才","author":"郑獬","text":"动哭遂灭性，谁言天道长。\n未收双宝剑，已失一飞黄。\n稚子遥虚祭，孤棺寄异乡。\n可怜江夏守，不得荐黄香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伤贾老","author":"郑獬","text":"世事一毫不挂眼，放怀只用酒为年。\n已从车后携一榼，更向杖头留百钱。\n顾我曾传丹鼎诀，疑君便是紫芝仙。\n忽如蝉蜕不复见，雨坏茅斋八九椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再至会稽","author":"郑獬","text":"自怜多病趁朝稀，合引朱轓东路归。\n名姓未通丹陛下，梦魂已过浙江飞。\n人生如意即为乐，世事惊心渐觉非。\n正是春风催酒熟，蝤蛑霜饱蛤蜊肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和","author":"郑獬","text":"使君携酒送馀春，缥缈高怀倚白云。\n新曲旋教花下按，好题只就席间分。\n阮公醉帽玉山倒，谢女舞衣沈水薰。\n自笑尘埃满朱绂，良辰乐事两输君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和","author":"郑獬","text":"海棠乱插满雕盘，为爱繁梢更绕栏。\n顾我有情还惜别，闻君未去且留欢。\n锦裀只就花边卧，细袖偏宜烛下看。\n若背荆州容易去，故人于义未为安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同彦范谒仲巽饮之甚乐仲巽且有北归之期情见卒章辄用写呈","author":"郑獬","text":"明珠堆满赤金盘，未买花前笑倚栏。\n特地寻春难约伴，等閒携酒却成欢。\n人生试把从头算，世事何烦著眼看。\n莫怪夜深犹换烛，它时相望在长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"同贾运使章职方王推官赏梅","author":"郑獬","text":"花前留客解金鞍，拣遍繁梢尽折残。\n翠帽插来无处著，玉盘收取与人看。\n无言有意空相对，欲去重来更绕栏。\n把酒殷勤须会取，风头只待作春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吕稚卿唐彦范并赋游西池亦成菲句","author":"郑獬","text":"青翰龙舟云外横，黄金殿阁镜中明。\n波光柳色恰相似，酒味人心俱有情。\n醉洒珠玑留满纸，晚骑鸾凤下层城。\n游人应解笑狂客，隔水映花闻语声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏学张水部赠河南少尹","author":"郑獬","text":"河南少尹鬓如丝，角里先生是吏师。\n花下放衙因试酒，竹间留客为寻棋。\n年劳只许钞书数，月俸长留买药资。\n已说开春须上表，终南山下乞分司。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早朝","author":"郑獬","text":"花鬣斑虬驾早朝，玉栏宫殿压云涛。\n九州画地中原壮，万象横天紫极高。\n日月辉明留阙角，龙蛇蟠结动旌旄。\n群仙遥望蓬莱拜，五色非烟绕赭袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早朝马上口占","author":"郑獬","text":"赤城横绝六鳌头，夹道栏干覆御沟。\n残月画楼双阙晓，凉风绿树万家秋。\n联飞群鹄愧豪彦，醉卧落花思旧游。\n御史临班望天陛，紫云飞绕翠云裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵元肃兄三题汴渠夜泛","author":"郑獬","text":"汴渠夜泛亦快意，月射长波如断冰。\n不见湘灵挥宝瑟，空教水怪避犀灯。\n烟云叠影相亏蔽，星斗翻芒互降升。\n好蓄金钱多买酒，满船载去觅严陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵元肃兄见喜知荆州二首 其二","author":"郑獬","text":"西风原上鹡鸰鸣，喜见朱旗画兽狞。\n尘袖渐抛秦地远，云帆聊作楚江行。\n人家掩映寒塘水，秋物鲜明绿树橙。\n欲表新阡在郧国，不同张翰浪逃名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵元肃兄见喜知荆州二首 其一","author":"郑獬","text":"逾年谬掌凤凰诏，择日拜章芸若庭。\n拥节笑归江汉国，飞帆醉拂斗牛星。\n留连物景诗千首，准拟交亲酒百瓶。\n共采芳兰晨事毕，不妨儿侄夜横经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵元肃兄汴口阻风","author":"郑獬","text":"风阻浪头如駴马，险于天堑欲摧车。\n却随宿雁留寒渚，深羡飞云韂碧虚。\n对酒客怀真土梗，满船生计只图书。\n世无勇奡携之去，不得连鳌作鲙鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵石秀才淮上偶作","author":"郑獬","text":"出汴忽如鱼脱网，长淮万里断烦嚣。\n白云已抱日光转，碧浪更和天面摇。\n自此乘槎须犯斗，谁能鞭石解为桥。\n玉京醉客无消息，不及蓬山两信潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵丞相柳湖席上","author":"郑獬","text":"湖上春深不见沙，画桥飞影入晴霞。\n园林到处消得酒，风雨等閒飞尽花。\n令罚艳歌传盏急，诗成醉墨落笺斜。\n兰亭乐事无丝管，待与羲之子细誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵张公达游西池","author":"郑獬","text":"醉漾兰舟不忍归，斜阳已落碧云西。\n天开银汉水初满，春入武陵人自迷。\n殿倚鳌头连并幕，桥飞虹影度金堤。\n游人不惜残花地，无限落红粘马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵汪正夫对雨","author":"郑獬","text":"雨气飘萧动竹斋，惊秋高思若为裁。\n壮心虽被愁催去，欢意须凭酒借来。\n云脚一从边地合，风头半是海潮回。\n长汀从此伤摇落，独有骚人最费才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵梁天机见寄","author":"郑獬","text":"一听秋声鬓已凋，孤心惊起拂星杓。\n轮囷自分为蟠木，濩落宁堪作大瓢。\n新箧唱酬诗草满，旧衣倾泼酒痕消。\n高篇已许临佳菊，更作栏杆护翠条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵程丞相牡丹","author":"郑獬","text":"曾倒金壶为牡丹，矮床设座绕花坛。\n有人偷插玉钗上，到夜更留银烛看。\n醉里春风遗翠帽，归时寒月送雕鞍。\n如今兰棹催西去，惆怅明年谁倚栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵酬张择甫","author":"郑獬","text":"别后正春孟，溪头黄柳芽。\n相思满芳草，独自照残花。\n晚树秦川阔，黄云瘴海赊。\n上楼无别望，归路向西斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵酬项城姚子张到县感事","author":"郑獬","text":"胶西童子近之官，坐按春秋讨隐桓。\n休叹折腰向彭泽，犹胜索米困长安。\n来篇喜见万金字，厚报恨无双玉盘。\n莫就白云买烟艇，磻溪久已弃鱼竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江上","author":"郑獬","text":"芦叶萧萧江上秋，鲥鱼清酒解消忧。\n云才散后月当浦，潮欲来时风满楼。\n好景未应输白鹭，飞尘终不到扁舟。\n晚来天卷苍霞尽，万顷玻璃烂不收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江行","author":"郑獬","text":"碧草已堪剪，长江二月头。\n林深藏宿雨，岸豁聚春流。\n潮背燕支浦，山横桑落州。\n松醪欺客病，易醉苦难投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自贻","author":"郑獬","text":"乌巾筇杖白云夫，寄谢黄公旧酒垆。\n懒性惟看高士传，归心空展旧山图。\n病来瘦骨支离在，老去欢情积渐无。\n啼鸟落花应怪问，绿尘何事满金壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟次芜湖却寄维扬刁学士","author":"郑獬","text":"柳叶初黄未解飞，东风还与赏心违。\n纵逢春处花期少，自过江来酒病稀。\n平子解酬青玉案，秋娘能唱缕金衣。\n扬州二十四桥月，长忆醉乘明月归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟泊","author":"郑獬","text":"鸣橹解双缆，寒蒸江气昏。\n春云兼雨重，晚水带潮浑。\n小市鱼虾集，空亭燕雀喧。\n一尊得浓睡，行计不须论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行次汉水寄荆南漕唐司勋","author":"郑獬","text":"汉水渺渺东南流，萧萧雨打杏花洲。\n欲托双鱼寄书札，不知几日到荆州。\n荆州故人日渐远，到时绿草满沙头。\n争得报章来阙下，凤林北去不通流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行旅","author":"郑獬","text":"捲衣上马去骎骎，檐雨飘零楚客心。\n归路渐惊红叶老，旧山已落白云深。\n庄鹏聊欲辞沧海，越鸟终须忆故林。\n初启松阡青未合，岭头一望一沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过魏都","author":"郑獬","text":"忆把貂裘买玉壶，重来不敢解金鱼。\n当时曾谒将军府，今日还乘使者车。\n歌管渐非人去后，楼台依旧雪消初。\n韩门弟子偏怊怅，泪满朝阳耆旧书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初春欲为小饮先寄运使唐司勋运判张都官","author":"郑獬","text":"人生长与赏心违，莫遣樽前笑语稀。\n老去未羞花插帽，醉来不怕酒淋衣。\n免听画鼓催朝去，且驻金鞍待月归。\n休道东风犹早在，落梅已扑翠苔飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"即事简友人","author":"郑獬","text":"门巷遍芳草，相期春醉稀。\n可怜双燕到，还似故人归。\n幽鸟隔溪语，落花穿竹飞。\n谁知静者乐，石上脱朝衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"吴比部致仕归蕲阳","author":"郑獬","text":"蘧公四十已知非，长揖公卿卧翠微。\n结绶才还双阙下，上书便乞故乡归。\n伏辕赤骥相随老，出网冥鸿自在飞。\n应向黄梅访逋客，白云飘洒紫荷衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张寺丞见讶久不致书兼惠佳篇辄用奉答","author":"郑獬","text":"数日看花生怕迟，杭州更有乱花围。\n为贪携酒寻春去，不及修书趁雁归。\n且击壮怀期篆鼎，莫缘华发便沾衣。\n谁知寂寞寒山外，万里苍鹰正苦饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张李二君获荐喜而成篇兼简岑令蒋掾","author":"郑獬","text":"榜帖初传见姓名，喜来把读绕栏行。\n长风又送二龙去，明月已看双桂生。\n群玉聚来俱是宝，真金鍊出始为精。\n虽知自是文章得，须待秦台宝鉴明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扶沟白鹤观有苏子兄弟赠黄道士诗二阕县令周原又以三篇纪之邀余同作","author":"郑獬","text":"道士黄初平，爱酒老不衰。\n二豪留醉墨，潇洒白云辞。\n流莺境寂寞，无复落花枝。\n空馀凤凰字，犹得周郎悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李都尉芙蓉堂","author":"郑獬","text":"堂上芙蓉花最饶，开时不见玉栏桥。\n来从洛浦见罗袜，生在楚宫俱细腰。\n何处仙人来跨凤，夜深明月好吹箫。\n剩收秋蕊为佳酿，醉入飞云解画桡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"李道士","author":"郑獬","text":"金鼓破南粤，山中冷不闻。\n是非同一马，富贵自浮云。\n吐纳龙虎气，遨游麋鹿群。\n朝来问丹诀，已酌冻醪醺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汴河夜行","author":"郑獬","text":"汴流长恐日夜落，夜行愁杀刺船郎。\n橹声惊破老龙睡，船底触翻明月光。\n大儿灯下寻难字，小女窗间学剪裳。\n自笑病夫无所事，一尊身世两相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"羌奴","author":"郑獬","text":"豢饱则蹄齧，羌奴敢肆行。\n蚊虻失驱逐，蝼蚁遂纵横。\n古先谋士帅，今谁可将兵。\n庙堂揽群策，还许访书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贡麟","author":"郑獬","text":"麟本出中国，无闻贡海滨。\n岂将远方兽，烦我太平民。\n烹割罗牲饩，奔趋扫路尘。\n汉高尝聘士，此礼属蛮人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒闷","author":"郑獬","text":"閒闷万千缕，金刀不可裁。\n逢人心不记，见酒眼方开。\n乱梦无时断，残春数日回。\n东风固相恼，时送落花来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居二首 其二","author":"郑獬","text":"不从山下住，若个似山家。\n留地教移竹，开门自扫花。\n林疏容鹤卧，溪净怕云遮。\n落日杖藜去，塍头看稻牙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居二首 其一","author":"郑獬","text":"空庭罗雀网，应似翟侯居。\n多病惟寻药，忘机不著书。\n僧来留石鼎，人在典金鱼。\n惟有南窗睡，春来分不疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张公达暮春寄宋使君","author":"郑獬","text":"独绕栏干正惜春，不堪西望陇头云。\n弄烟细柳才三尺，著地残花厚一分。\n梁苑草深平似熨，秦关山煖翠如薰。\n骑鲸李白时过我，未引金尊先说君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜怀","author":"郑獬","text":"独倚青桐听鼓声，参旗历落上三更。\n凉风卷雨忽中断，明月背云还倒行。\n赖有清吟消意马，岂无美酒破愁城。\n是非人世何须校，方外曾师阮步兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"往年与刘元忠诸公寻春夜归今兹卧病感而成篇","author":"郑獬","text":"已醒又醉倦游客，乍雨却晴寒食天。\n共系紫骝芳树下，却随红烛落花前。\n层城已报黄金锁，外苑犹贪碧草眠。\n明月春风依旧好，竹溪散尽酒中仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"明皇","author":"郑獬","text":"四海不摇草，九重藏祸根。\n十年傲尧舜，一笑破乾坤。\n羌貊皆冠冕，豺狼尽子孙。\n潼关兵已破，会忆老臣言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杭州喜雪","author":"郑獬","text":"吴儿经年不识雪，忽惊大片遮空来。\n黑帝不分苦荒拙，六花一夜随风开。\n平明扫径招佳客，座上岂无邹与枚。\n荆州新酿泼醅熟，清光透彻黄金杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"松陵道中","author":"郑獬","text":"萧萧落日荻花林，秋浪陂陀快醉襟。\n江上碧峰偏入眼，沙边白鸟最知心。\n百分美酒酬双鬓，一觉高眠敌万金。\n闻道鲈鱼属张翰，飞帆欲过五湖寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"直宿省中","author":"郑獬","text":"娟娟海棠花，小蕊春来瘦。\n斑斑青竹枝，疏叶未生就。\n碧砌画栏干，雨断黄昏后。\n厌酒未能眠，时拾残花嗅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":35648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]