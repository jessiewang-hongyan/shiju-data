[{"title":"次祝泽之表兄韵送刘子晋归省","author":"朱熹","text":"之子真吾友，心期到古人。\n慇勤来讲学，迢递远辞亲。\n黄卷工夫妙，斑衣梦想频。\n今朝首归路，何处问知津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送祝泽之表兄还乡","author":"朱熹","text":"首夏何来此，清秋却复归。\n应缘心未快，岂是世相违。\n落日空书馆，凉风净客衣。\n功名须努力，别泪莫频挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"知郡傅丈载酒幞被过熹于九日山夜泛小舟弄月剧饮二首 其一","author":"朱熹","text":"扁舟转空阔，烟水浩将平。\n月色中流满，秋声两岸生。\n杯深同醉极，啸罢独魂惊。\n归去空山黑，西南河汉倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"知郡傅丈载酒幞被过熹于九日山夜泛小舟弄月剧饮二首 其二","author":"朱熹","text":"谁知方外客，亦爱酒中仙。\n共踏空林月，来寻野渡船。\n醉醒非各趣，心迹两忘缘。\n江海情何限，秋生蓬鬓边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"教思堂作示诸同志","author":"朱熹","text":"吏局了无事，横舍终日闲。\n庭树秋风至，凉气满窗间。\n高阁富文史，诸生时往还。\n纵谈忽忘倦，时观非云悭。\n咏归同与点，坐忘庶希颜。\n尘累日以销，何必栖空山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再得古木","author":"朱熹","text":"青山一何深，上下尽云木。\n中有千岁姿，偃蹇卧寒谷。\n明堂不徵材，大匠肯回目。\n樵斧莫谩寻，从渠媚幽独。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示诸同志","author":"朱熹","text":"夏木已云暗，时禽变新声。\n林园草被径，端居有馀清。\n端居亦何为，日夕掩柴荆。\n静有弦诵乐，而无尘虑并。\n良朋肯顾予，尚有夙心倾。\n深惭未闻道，折衷非所宁。\n眷焉抚流光，中夜叹以惊。\n高山徒仰止，远道何由征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示四弟","author":"朱熹","text":"十日一洗沐，诸生各归休。\n虚斋息群响，兀坐心悠悠。\n雨久苔径荒，林深鸟啼幽。\n阶前树萱草，与子俱忘忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"还家即事","author":"朱熹","text":"献岁事行役，徂春始还归。\n昔往草未芳，今来翠成帏。\n扶疏满园阴，时禽互翻飞。\n丛萱亦已秀，丹葩耀晨辉。\n即事谁与娱，淹留自忘机。\n日暮复出门，怅然心事违。\n古人不可见，独掩荒园扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20219,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小盈道中","author":"朱熹","text":"今朝行役是登临，极目郊原快赏心。\n却笑从前嫌俗事，一春牢落闭门深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20220,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题囊山寺","author":"朱熹","text":"晓发渔溪驿，夜宿囊山寺。\n云海近苍茫，层岚拥深翠。\n行役倦脩途，投归聊一憩。\n不学塔中仙，名涂定何事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20221,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题九日山石佛院乱峰轩二首 其一","author":"朱熹","text":"因依古佛居，结屋寒林杪。\n当户碧峰稠，云烟自昏晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20222,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题九日山石佛院乱峰轩二首 其二","author":"朱熹","text":"岩中老释子，白发对青山。\n不作看山想，秋云时往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20223,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题可老所藏徐明叔画卷二首 其一","author":"朱熹","text":"群峰相接连，断处秋云起。\n云起山更深，咫尺愁千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20224,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题可老所藏徐明叔画卷二首 其二","author":"朱熹","text":"流云绕空山，绝壁上苍翠。\n应有采芝人，相期烟雨外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20225,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再至同安假民舍以居示诸生","author":"朱熹","text":"端居托穷巷，廪食守微官。\n事少心虑怡，吏休庭宇宽。\n晨兴吟诵馀，体物随所安。\n杜门不复出，悠然得真欢。\n良朋夙所敦，精义时一殚。\n壶餐虽牢落，此亦非所难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20226,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"末利","author":"朱熹","text":"旷然尘虑尽，为对夕花明。\n密叶低层幄，冰蕤乱玉英。\n不因秋露湿，讵识此香清。\n预恐芳菲尽，微吟绕砌行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20227,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢人送兰 其一","author":"朱熹","text":"幽独尘事屏，晼晚秋兰滋。\n芳馨不自媚，掩抑空相思。\n晤对日方永，披丛露未晞。\n翛然发孤咏，九畹陈悲诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20228,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢人送兰 其二","author":"朱熹","text":"淹留阅岁序，契阔心怀忧。\n独卧寄僧闾，一室空山秋。\n徘徊起顾望，俯仰谁为俦。\n伊人远赠问，孤根亦绸缪。\n芳馨不我遗，三载娱清幽。\n愧无琼琚报，厚意竟莫酬。\n瞻彼南陔诗，使我心悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20229,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋兰已悴以其根归学古","author":"朱熹","text":"秋至百草晦，寂寞寒露滋。\n兰皋一以悴，芜秽不能治。\n端居念离索，无以遗所思。\n愿言托孤根，岁晏以为期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20230,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"去岁蒙学古分惠兰花清赏既歇复以根丛归之故畹而学古预有今岁之约近闻颇已著花辄赋小诗以寻前约幸一笑","author":"朱熹","text":"秋兰递初馥，芳意满冲襟。\n想子空斋里，凄凉楚客心。\n夕风生远思，晨露洒中林。\n颇忆孤根在，幽期得重寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20231,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夕二首 其一","author":"朱熹","text":"西斋坐竟日，旷然谁与俦。\n感兹风露夕，始知天宇秋。\n庭树且扶疏，时物讵淹留。\n心空累云远，岁月真悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20232,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夕二首 其二","author":"朱熹","text":"公门了无事，吏散终日闲。\n凉叶何萧萧，悲吟庭树间。\n琴书写尘虑，菽水怡亲颜。\n忆在中林日，秋来长掩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20233,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜听雨奉怀子厚","author":"朱熹","text":"悄悄窗户暗，青灯读残书。\n忽听疏雨落，稍知凉气初。\n披襟聊自适，掩卷方踌躇。\n亦念同怀人，怅望心烦纡。\n鸣琴爱静夜，乐道今闲居。\n岑岑空山中，此夕知焉如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20234,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"对月思故山夜景","author":"朱熹","text":"沉沉新秋夜，凉月满荆扉。\n露泫凝馀彩，川明澄素晖。\n中林竹树映，疏星河汉稀。\n此夕情无限，故园何日归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20235,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同僚小集梵天寺坐间雨作已复开霁步至东桥玩月赋诗二首 其一","author":"朱熹","text":"杰阁翔林杪，披襟此日闲。\n层云生薄晚，凉雨遍空山。\n地迥衣裳冷，天高澄霁还。\n出门迷所适，月色满林关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20236,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同僚小集梵天寺坐间雨作已复开霁步至东桥玩月赋诗二首 其二","author":"朱熹","text":"空山看雨罢，微步喜新凉。\n月出澄馀景，川明发素光。\n星河方耿耿，云树转苍苍。\n晤语逢清夜，兹怀殊未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20237,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梵天观雨","author":"朱熹","text":"持身乏古节，寸禄久栖迟。\n暂寄灵山寺，空吟招隐诗。\n读书清磬外，看雨暮钟时。\n渐喜凉秋近，沧洲去有期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20238,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登阁","author":"朱熹","text":"横空敞新阁，高处绝炎氛。\n野迥长风入，天秋凉气分。\n凭栏生逸想，投迹远人群。\n终忆茅檐外，空山多白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20239,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋怀二首 其一","author":"朱熹","text":"秋风吹庭户，客子怀故乡。\n矧此卧愁疾，徘徊守空房。\n伫想涧谷居，林深惨悲凉。\n鹍鸡感萧辰，拊翼号风霜。\n氛杂无留气，悄茜有馀芳。\n幸闻卫生要，招隐夙所臧。\n终期谢世虑，矫翮兹山冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20240,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋怀二首 其二","author":"朱熹","text":"怀痾坐竟日，晚色散幽树。\n寂历候虫悲，沆瀁碧草露。\n端居兴方澹，沉默自成趣。\n羽觞欢独持，瑶琴谁与晤。\n空知玄思清，未惜年华度。\n美人殊不来，岁月恐迟暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20241,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中元雨中呈子晋","author":"朱熹","text":"徂暑尚繁郁，大火空西流。\n兹辰喜佳节，凉雨忽惊秋。\n晼晚兰径滋，萧副庭树幽。\n炎气一以去，恢台逝不留。\n刀笔随事屏，尘嚣与心休。\n端居讽道言，焚香味真诹。\n子亦玩文史，及此同优游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20242,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋暑","author":"朱熹","text":"晨兴纳新凉，亭午倦犹暑。\n卧对北窗扉，淡泊将谁侣。\n疏树含轻飔，时禽转幽语。\n端居悟物情，即事聊容与。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20243,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和李伯玉用东坡韵赋梅花","author":"朱熹","text":"北风日日霾江村，归梦正尔劳营魂。\n忽闻梅蕊腊前破，楚客不爱兰佩昏。\n寻幽旧识此堂古，曳杖偶集僧家园。\n岚阴春物未全到，邂逅只有南枝温。\n冷光自照眼色界，云艳未怯扶桑暾。\n遥知云台溪上路，玉树十里藏山门。\n自怜尘羁不得去，坐想佳处知难言。\n但哦君诗慰岑寂，已似共倒花前樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20244,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与诸人用东坡韵共赋梅花适得元履书有怀其人因复赋此以寄意焉","author":"朱熹","text":"罗浮山下黄茅村，苏仙仙去馀诗魂。\n梅花自入三叠曲，至今不受蛮烟昏。\n佳名一旦异凡木，绝艳千古高名园。\n却怜冰质不自暖，虽有步障难为温。\n羞同桃李媚春色，敢与葵藿争朝暾。\n归来只有脩竹伴，寂历自掩疏篱门。\n亦知真意还有在，未觉浩气终难言。\n一杯劝汝吾不浅，要汝共保山林樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20245,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽刘宝学二首 其一","author":"朱熹","text":"天地谁翻覆，人谋痛莫支。\n公扶西极柱，威动北征旗。\n肉食谋何鄙，家山志忽赍。\n平生出师表，今日重伤悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20246,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽刘宝学二首 其二","author":"朱熹","text":"生死公何有，飘零我自伤。\n向非怜不造，那得此深藏。\n心折风霜里，衣沾子侄行。\n哦诗当肃挽，悲哽不成章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20247,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题梅川溪堂","author":"朱熹","text":"沧波流不极，上有一亩园。\n幽人掩关卧，脩竹何娟娟。\n虚堂面群峰，秀色摩青天。\n静有山水乐，而无车马喧。\n人言市门子，往往苍崖颠。\n挥手谢世人，日中翔紫烟。\n遗迹尚可觌，神交邈无缘。\n慨然一永叹，耀灵忽西迁。\n褰裳下中沚，濯足娱清川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20248,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和刘抱一","author":"朱熹","text":"几年牢落旧村墟，此日脩然水竹居。\n病起试寻春径草，客来聊煮雪畦蔬。\n开樽细说平生事，信手同翻集古书。\n适意何劳一千卷，新诗闲出笑谈馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20249,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和","author":"朱熹","text":"久矣投装返旧墟，不将心事赋闲居。\n荷锄带月朝治秽，植杖临风夕挽蔬。\n三径犹寻陶令宅，万签聊借邺侯书。\n木瓜更得琼琚报，吟咏从今乐有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20250,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送芮国器二首 其一","author":"朱熹","text":"拄节千山外，勤劳饱所经。\n一心无适莫，万口自丹青。\n拂拭先贤传，光辉处士星。\n活人功更远，试与问林坰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20251,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送芮国器二首 其二","author":"朱熹","text":"紫陌同年旧，青云得路新。\n论心端有契，下榻岂辞频。\n话别惊如许，相逢渺未因。\n期公念经济，从此上星辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20252,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花开尽不及吟赏感叹成诗聊贻同好二首 其一","author":"朱熹","text":"忆昔身无事，寻梅只怕迟。\n沉吟窥老树，取次折横枝。\n绝艳惊衰鬓，馀芳入小诗。\n今年何草草，政尔负幽期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20253,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花开尽不及吟赏感叹成诗聊贻同好二首 其二","author":"朱熹","text":"棐几冰壶在，梅梢雪蕊空。\n不堪三弄咽，谁与一尊同。\n鼻观残香里，心期昨梦中。\n那知北枝北，犹有未开丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20254,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋丈示及红梅腊梅借韵两诗辄复和呈以发一笑 其一","author":"朱熹","text":"闻说寒梅尽，寻芳去已迟。\n冷香无宿蕊，秾艳有繁枝。\n正复非同调，何妨续旧诗。\n广平偏妩媚，铁石误心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20255,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋丈示及红梅腊梅借韵两诗辄复和呈以发一笑 其二","author":"朱熹","text":"风雪催残腊，南枝一夜空。\n谁知荒草里，却有暗香同。\n质瑩轻黄外，芳滕浅绛中。\n不遭岑寂侣，何以媚孤丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20256,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"呈黄子厚","author":"朱熹","text":"茅斋尘事远，幽独兴无穷。\n永昼呻吟内，新凉愁思中。\n朱颜非昨日，绿鬓又秋风。\n珍重墙东客，遥怜此意同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20257,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉酬子厚咏雪之作","author":"朱熹","text":"遥夜不能寐，披衣起彷徨。\n仰视天正黑，寒气惨悲凉。\n飞霰忽下零，雪花亦飘扬。\n飘扬未云已，须臾满空翔。\n前山失旧姿，川谷流素光。\n念昔少小时，无事志四方。\n五年江海上，不见雪与霜。\n飘飖今日情，浩荡谁能量。\n凌晨饮一杯，竟日守空堂。\n伫立玩奇变，永言获新章。\n踌躇欲何报，玉树生琼冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20258,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送籍溪胡丈赴馆供职二首 其一","author":"朱熹","text":"祖饯衣冠满道周，此行谁与话端由。\n心知不作功名计，祇为苍生未敢休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20259,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送籍溪胡丈赴馆供职二首 其二","author":"朱熹","text":"执我仇仇讵我知，谩将行止验天机。\n猿悲鹤怨因何事，祇恐先生袖手归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20260,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄籍溪胡丈及刘恭父二首 其一","author":"朱熹","text":"先生去上芸香阁，阁老新峨豸角冠。\n留取幽人卧空谷，一川风月要人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20261,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄籍溪胡丈及刘恭父二首 其二","author":"朱熹","text":"瓮牖前头翠作屏，晚来相对静仪刑。\n浮云一任闲舒卷，万古青山祇么青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20262,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽范直阁二首 其一","author":"朱熹","text":"献纳陪兴运，如公众所期。\n忧时最深切，信道不磷缁。\n落落归来赋，匆匆殄瘁诗。\n菟裘当日计，宰木后人悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20263,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽范直阁二首 其二","author":"朱熹","text":"先友多名士，存亡几许人。\n惟公且彊健，于我更情亲。\n出处论心晚，音书枉诲频。\n素车今日会，谁与共伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20264,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"顷以多言害道绝不作诗两日读大学诚意章有感至日之朝起书此以自箴盖不得已而有言云","author":"朱熹","text":"神心洞玄鉴，好恶审薰莸。\n云何反自诳，闵默还包羞。\n今辰仲冬节，寤叹得隐忧。\n心知一寸光，昱彼重泉幽。\n朋来自兹始，群阴邈难留。\n行迷亦已远，及此旋吾辀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20265,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仁术","author":"朱熹","text":"在昔贤君子，存心每欲仁。\n求端从有术，及物岂无因。\n恻隐来何自，虚明觉处真。\n扩充从此念，福泽遍斯民。\n入井仓皇际，牵牛觳觫辰。\n向来看楚越，今日备吾身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20266,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻善决江河","author":"朱熹","text":"大舜深山日，灵襟保太和。\n一言分善利，万里决江河。\n可欲非由外，惟聪不在它。\n勇如争赴壑，进岂待盈科。\n学海功难并，防川患益多。\n何人亲祖述，耳顺肯同波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20267,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仰思二首 其一","author":"朱熹","text":"公德明光万世师，从容酬酢更何疑。\n当年不合知何事，清夜端居独仰思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20268,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仰思二首 其二","author":"朱熹","text":"圣贤事业理难同，僭作新题欲自攻。\n王事兼施吾岂敢，傥容思勉议成功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20269,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"困学二首 其一","author":"朱熹","text":"旧喜安心苦觅心，捐书绝学费追寻。\n困衡此日安无地，始觉从前枉寸阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20270,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"困学二首 其二","author":"朱熹","text":"困学工夫岂易成，斯名独恐是虚称。\n傍人莫笑标题误，庸行庸言实未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20271,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"复斋偶题","author":"朱熹","text":"出入无时是此心，岂知鸡犬易追寻。\n请看屏上初爻旨，便识名斋用意深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20272,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示四弟","author":"朱熹","text":"务学脩身要及时，竞辰须念隙驹驰。\n清宵白日供游荡，愁杀堂前老古锥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20273,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"克己","author":"朱熹","text":"宝鉴当年照胆寒，向来埋没太无端。\n祇今垢尽明全见，还得当年宝鉴看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20274,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曾点","author":"朱熹","text":"春服初成丽景迟，步随流水玩晴漪。\n微吟缓节归来晚，一任轻风拂面吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20275,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伐木","author":"朱熹","text":"伐木相将入远山，共听幽鸟语关关。\n殷勤若解当时意，此日那容不尽欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20276,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日偶作","author":"朱熹","text":"闻道西园春色深，急穿芒屩去登临。\n千葩万蕊争红紫，谁识乾坤造化心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":20277,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]