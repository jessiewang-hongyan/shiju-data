[{"title":"吊猿","author":"释居简","text":"巫硖第三声，无愁亦怕听。\n养铅烦护鼎，献果伴看经。\n失树难忘返，投笼不畏扃。\n旧铭曾瘗鹤，猿瘗亦宜铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28625,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"太守劝耕别驾有诗子弟宾客皆和","author":"释居简","text":"华风煖入劝耕卮，后苑词头欲下时。\n父老怕公归觐速，莺花惜日燕歌迟。\n肥生鸭顶痕遵渚，嫩学鹅儿蔓染丝。\n好是东郊元祐寺，两年千骑驻旌旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28626,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵盘隐新亭","author":"释居简","text":"管领风烟一半闲，池南池北画阑间。\n红添蜀绮渐成韵，绿间湘琼过得斑。\n待燕欲归帘尽卷，惜猿蜚去栅犹关。\n种花先课园丁最，看到丛犀赋小山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28627,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梯飙","author":"释居简","text":"凉腋拊岧峣，可扪丛玉霄。\n一层高步武，千仞拔尘嚣。\n明月秦箫断，雕盘古篆消。\n天浆几时熟，款曲试芳瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28628,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石上坐忘归","author":"释居简","text":"猎猎并闾起暮寒，秋声隐隐落秋湍。\n偶然石上闻天籁，横膝焦梧不足弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28629,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书壁图","author":"释居简","text":"雨涩苍崖墨色鲜，长安犹自犬羊膻。\n试临旧刻思天宝，末上先题十四年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28630,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送俞司户","author":"释居简","text":"落日东郊寺，春风北固桡。\n三年控吴楚，几度到金焦。\n岸绿晴初重，汀红雨后消。\n蒲牢鸣夜半，款曲度枫桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28631,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王寺丞后圃","author":"释居简","text":"不独甘棠茂午阴，净如止水照人心。\n楼通阊阖天垂斗，云锁蜿蜒鼎篆金。\n袖里有春还自乐，尊前无客不能吟。\n古菱花里青青鬓，半点吴霜不敢侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28632,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"强斋高使君假山","author":"释居简","text":"呼猿洞口冷泉湾，尽把天真作假看。\n低切一峰庭际立，屹如九仞坐中寒。\n闲来不觉留连久，好处方知斗砌难。\n尤物移人易成趣，莫嗔强健懒弹冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28633,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张于潜画轴五首 其一","author":"释居简","text":"百尾谁传觳觫真，浅缁轻拂替丹青。\n逸群大武如曾见，不见当时挂角经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28634,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张于潜画轴五首 其二","author":"释居简","text":"昭阳燕子一双飞，涎涎随风懒哺儿。\n可是刘郎无酝藉，不教嫔御读周诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28635,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张于潜画轴五首 其三","author":"释居简","text":"老发鬅鬙两髻丫，天台山里老烟霞。\n闾丘别后无踪迹，又在兰陵故相家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28636,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张于潜画轴五首 其四","author":"释居简","text":"玉虎嘶蟾噎万鼍，五云低处涌蓬婆。\n平生海若嫌模写，如此梁生狡狯何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28637,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题张于潜画轴五首 其五","author":"释居简","text":"飙生凉腋策茶勋，欲御刚风度海云。\n任是蓬莱更高处，叫苍生苦有谁闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28638,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送王寺丞","author":"释居简","text":"公来兰陵州，旧俗如解酲。\n封中小草木，薿薿皆精神。\n乡来矜陆梁，今也猿鸟驯。\n乡来矜巧诋，今也伏不伸。\n扊扅谨夜户，两载俱撤扁。\n舟车集大贾，庠序登秀民。\n外则仓廪实，内则府库盈。\n此特馀事耳，外此请具陈。\n时方尚武力，习阅锋选精。\n黄金不爱惜，中的咸赏勤。\n重信不重金，貔貅肝胆倾。\n悠然一寸丹，秋水风泠泠。\n脱使玷如粟，孰掩离娄明。\n离娄寂无睹，只赋荆溪清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28639,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送郡斋两客 其一","author":"释居简","text":"五马尊前客，长沙太傅双。\n疆侵过秦论，骚反度湘江。\n晞露纫春佩，留蟾款曙窗。\n束书还小隐，静胜扫纷厖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28640,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送郡斋两客 其二","author":"释居简","text":"宾主在兰陵，清哉胜挟冰。\n弈机明揖逊，酒令旋番腾。\n池草春虽度，溪藤价益增。\n梯飙十二曲，曲曲款吟朋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28641,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬盘隐别驾 其一","author":"释居简","text":"早悟玄元一曰慈，持身有本是无私。\n戒将重帚伤蝼蚁，弗买生鱼喂鹭鸶。\n桂实松高宜寿此，竹清梅瘦亦如斯。\n吟成换得神仙骨，不枉凭阑撚断髭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28642,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬盘隐别驾 其二","author":"释居简","text":"随官曾读颂中兴，符竹将分第二灯。\n一气所钟清似镜，十成相肖澹于僧。\n红栽水玉不多日，碧数雾鬟无数层。\n台上只教猿自啸，秦箫虽美弗同登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28643,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"求图记古字于何老渔","author":"释居简","text":"古意荡不反，古声今亦亡。\n一期甜画贵，几个淡交长。\n马去有时反，豹饥无处藏。\n刘郎鬓先老，犹得访何郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28644,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泣瓜庐薛景石","author":"释居简","text":"梦与瓜庐别，平明见又玄。\n偏傍蕃手校，奇正想心传。\n谷贱烦丰豕，风酸噎瘦蝉。\n阿伶坟上土，滴不到重泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28645,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新竹","author":"释居简","text":"嫩青霣箨未禁摇，细字何烦扈碧绡。\n乘月露梢须点滴，少留墨色到明朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28646,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠笔工","author":"释居简","text":"散捉紫毫新脱颖，玄泓渴饮淬锋寒。\n将军翰墨场中老，避槊方知夺槊难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28647,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊涧兰石松菊手卷","author":"释居简","text":"髯高江汉归，化作木石妖。\n槁树怪槎蘖，俱趁毫端朝。\n苍藓并砌泣，老棘伤秋彫。\n筱簜霜不蕃，兰茝春方饶。\n抵死兰茝傍，不肯著艾萧。\n坡陁数片石，仙袂拂不消。\n定知何处见，五老前山椒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28648,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬盘隐总饷园中之什","author":"释居简","text":"总饷园中赋咏佳，可曾误指玉钩斜。\n烟鬟闯户青浮玉，羽盖亭云绿护花。\n瘦竹引风留客旆，长江流月去谁家。\n暮天漾漾随潮展，彷佛西兴渡口沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28649,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中贻赵野云之官三衢","author":"释居简","text":"笑君吟似饮中歌，船贴清溪翠卷罗。\n梦枕熟时忺昼永，午阴团影得凉多。\n官非奉礼宁如贺，家岂扬州旧姓何。\n试问柯山棋一局，不知曾烂几人柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28650,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬盘隐别驾七夕","author":"释居简","text":"水风池馆濯明妆，两袖澄鲜伫晚香。\n金注月波秋未满，银开星渚夜生凉。\n素怜醉客阳辞酒，才就新题略举觞。\n拙不可穷安用巧，听他乞得巧人忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28651,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"逆风","author":"释居简","text":"劈面东风不肯西，西州客子莫颦眉。\n一从四国流言后，直至如今不反吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28652,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野云赴三衢酒官","author":"释居简","text":"跌宕四十年，吴霜变玄发。\n卓然所不变，傲寒勇弥决。\n醉翰笔为祟，狂歌酒作孽。\n煮字不疗饥，袖手不求热。\n囊羞一簪直，腰嫌五斗折。\n狼饱千里肉，豕卧半寻穴。\n于菟道边窟，蝼蚁梦中垤。\n骥困黄泥阪，驽践黄金埒。\n臣朔漫诙谑，侏儒笑明哲。\n生女不生男，跨灶亦超绝。\n安得径尺蝉，冠此半簪雪。\n县官严榷酤，一官弗徒设。\n安知涤器时，已有谕蜀节。\n莫羡白头吟，自看柯山月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28653,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送汤少瞻见疏寮","author":"释居简","text":"而翁扣竹扃，拈出两诗新。\n凉柄骎骎置，秋檠隐隐亲。\n年劳须制胜，日益是刊陈。\n翰长渊源地，山阴试问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28654,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄宽堂赵左藏","author":"释居简","text":"玉壶饮湖渌，决眦连云根。\n霜蟾驾飞辙，万顷秋不痕。\n怀哉壶中仙，弗鉴行潦浑。\n一衿洞冰澌，三舍祛尘昏。\n玉盌勺冷瀣，琼佩经芳荪。\n剩撷书传香，鲜腾水花芬。\n爱闲受远次，负郭成荒村。\n广文饭不足，北海酒满樽。\n弗春长熙熙，弗约常存存。\n气馁贵益贱，道在卑逾尊。\n安知忘情地，岂在炙手门。\n只与白鸥说，莫与俗子论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28655,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送范主簿","author":"释居简","text":"考绩果何如，三年上上书。\n官箴小能大，俸给少常馀。\n款客壶觞静，寻僧水竹虚。\n麦船容借便，石浦访楼居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28656,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄陈给事","author":"释居简","text":"别元龙了别西湖，到得兰陵二月初。\n沉想金闺随梦熟，楷书玉楮问安疏。\n傍人燕子新巢小，得友莺雏煖翼舒。\n落落环中有馀地，道枢旋斡看虚邪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28657,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送赵司理","author":"释居简","text":"未报金陵大阃书，鹊声犹自绕庭除。\n若非尚德嘉同姓，应是蒐才副所如。\n寒日鹭洲千点雪，旧时燕垒几番雏。\n江东可是无诸葛，不记于家有小于。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28658,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送满上座","author":"释居简","text":"文公住处儿时到，尚记崔嵬紫翠联。\n隔岸土封刘氏藁，它山石刻杜陵篇。\n天开双阙凌飞雾，经注千名富近年。\n倘有异时陈伯玉，潸然为我作欣然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28659,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芙蓉盛开","author":"释居简","text":"霣霜槁百卉，拒霜独开花。\n寒驱煖消落，秋借春韶华。\n酣酣罗珍姿，表表骈翠葩。\n晴云剪新绮，落日明丹砂。\n瀣冷褪宿艳，叶散摘零霞。\n离骚比君子，城阙藏山家。\n二月三月时，红紫相矜誇。\n西风一摇落，乱委随蓬麻。\n花中障颓澜，晚节礼有加。\n芳洁以类从，薰莸分等差。\n梅追元气回，菊制暮景斜。\n弗使四时气，断续令人嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28660,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泣瓜圃翁应叟","author":"释居简","text":"不幸人谁免，如公孰不嗟。\n母怜它姓子，金润别人家。\n行义穷尤著，持身死不差。\n寸田犹可圃，图蔓勿伤瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28661,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄凝云归张公洞","author":"释居简","text":"洞在深云里，仙畦茂药苗。\n偶随山下水，来泊寺前桡。\n瀣泠长凝颊，丹轻不坠瓢。\n多应久离索，老鬓各萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28662,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒泉赴赵建康辟","author":"释居简","text":"辟书才下了，节节闯挐音。\n一日偶它适，尺书烦重寻。\n似回浮雪棹，来作访僧吟。\n梦草相忘地，于君忆更深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28663,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬盘隐别驾雪","author":"释居简","text":"台空罢讲经，底事雨花零。\n鸡误中宵白，山迷昨日青。\n槎牙浑欲死，和煦便通灵。\n怕压疏疏竹，寒敲不忍听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28664,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"盘隐别驾修龟山祠","author":"释居简","text":"商今藐人物，振坠起先贤。\n俸薄知难集，财轻觉易捐。\n便成新气象，顿醒旧风烟。\n撙节昌颓俗，何心食万钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28665,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"承天万佛阁","author":"释居简","text":"睹史何年宫，飞跨双峨眉。\n又如听经塔，涌出踞地维。\n不然钧天人，来下观阙随。\n去年曾此游，入眼未始窥。\n西风一回首，峭峙凌烟霏。\n璇题翚万椽，雕础逾十围。\n神速藐鬼工，莫知为者谁。\n或曰金泉僧，短发霜披披。\n信孚全吴地，幻此一段奇。\n胸中楚泽小，檐外吴天低。\n举手斗可扪，纵脚云可梯。\n江穷水屈折，港尽天畛畦。\n因知广大量，不为狭隘移。\n阁中优钵花，万朵秋不萎。\n天子寿万年，一年开一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28666,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹风亭","author":"释居简","text":"尽锄菑翳了，华构绕筼筜。\n矗矗半檐绿，疏疏六月凉。\n雪林听响玉，粉节晕零霜。\n话到扬州鹤，无非俗肺肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28667,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"平江太守李宝谟移漕荆湘 其一","author":"释居简","text":"荆溪溪上传，接畛使君贤。\n行旅归如市，羁游亟受廛。\n丰储优郡计，薄敛裕民天。\n谁似山阴叟，临行赠一钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28668,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"平江太守李宝谟移漕荆湘 其二","author":"释居简","text":"不据喉衿地，如何展壮图。\n一麾移使节，三楚即全吴。\n鹦鹉春常早，貔貅信必孚。\n不知坐上客，更有祢生无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28669,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"葛庵阻雪 其一","author":"释居简","text":"城中倦酬接，小泊在同泾。\n竹已休教醉，梅方唤得醒。\n山嫌时画俗，天满古壶青。\n怕有归来鹤，柴门夜不扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28670,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"葛庵阻雪 其二","author":"释居简","text":"天上花如席，门前径拥樵。\n全葩不到地，零蒂谩齐腰。\n梅笑竹先裂，柏随松后雕。\n烧痕漫灭尽，黄独更无苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28671,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张荃翁赴浦江丞而丧耦唁荃翁谢穫轩见寄 其一","author":"释居简","text":"蓝田厅壁记，又向浦江镌。\n棋垒须延敌，吟疆旋拓边。\n镜空鸾独舞，幌冷鹤先眠。\n八咏弦难续，麒麟角可煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28672,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张荃翁赴浦江丞而丧耦唁荃翁谢穫轩见寄 其二","author":"释居简","text":"绝笑诸郎似乃翁，荃翁又自去哦松。\n救焚赏必先焦额，欲雨香非后土龙。\n徵调苦多忘惜日，燮调伤煖不成冬。\n吴江短楫华亭月，称副茎齑藐万钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28673,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月初一酬盘隐陆别驾再雪得封字初三夜醮遇风得泾字 其一","author":"释居简","text":"前回滴未融，密洒又重重。\n半刺庆三白，载歌赓四封。\n猎围寻迹去，吟思为谁供。\n沉想山阴夜，来如去兴浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28674,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正月初一酬盘隐陆别驾再雪得封字初三夜醮遇风得泾字 其二","author":"释居简","text":"巽二胡为尔，喧豗不可听。\n弗摧山坠地，必辊渭成泾。\n窗俟东方白，灯留冷幌青。\n想应遵帝命，弱水送飞軨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28675,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春前三日雪","author":"释居简","text":"旦夕灰吹律，涟漪尚剪新。\n虽正犹是腊，差晚不伤春。\n夜户凝朝彩，生柴代熟薪。\n老僧眉最白，寒锁玉津津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28676,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"武进赵哦松吐茹异流俗雪中与邦人颂而饯之","author":"释居简","text":"自拔千寻俗，澜从砥柱回。\n炎驱旱魃死，凉似故人来。\n梅待春开眼，歌催雪荐杯。\n荆溪镜纤悉，是岂负丞哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28677,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"立春前四日天大雷电以雨","author":"释居简","text":"霹雳如春雨似秋，兰陵冬夜忆黄州。\n茂陵封禅期身后，恰恰营成小竹楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28678,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次薛叔载石泉韵","author":"释居简","text":"石泉曾未面，泉石旧忘情。\n不与滔滔竞，常怀止止清。\n渭非泾酝藉，贪是恶声名。\n自洁怜他浊，凭谁吊屈平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28679,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"惠山泉","author":"释居简","text":"源远涵山锡，风高逊甲科。\n论于前辈定，重似别泉多。\n清泚停无滓，扶摇荡不波。\n澹交从古小，如此一杯何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28680,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄湖州故旧","author":"释居简","text":"梦忆湖州旧，楼台画不如。\n溪从城里过，人在镜中居。\n闭户防惊鹭，开窗便钓鱼。\n鱼沈犹有雁，弗寄一行书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28681,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵盘隐别驾偕抱独作诗相劳苦 其一","author":"释居简","text":"小奚云锦重来地，时与山人尉寂寥。\n妃子墓前苔砌绿，风烟商略到前朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28682,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵盘隐别驾偕抱独作诗相劳苦 其二","author":"释居简","text":"径萦蛇腹不嫌纡，花蔓玲珑画不如。\n太子布金祇树老，一锄无地可藏愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28683,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代农答别乘劝耕 其一","author":"释居简","text":"敢忘百拜与三行，非贾非工只得耕。\n旧不便民毋助长，新非怫众却休更。\n验今多是迂扶曲，考古无非直胜横。\n只把襦歌徵别乘，不从谏议问苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28684,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代农答别乘劝耕 其二","author":"释居简","text":"守令丁宁在必行，女当知织子知耕。\n课春蚕务从三月，听夏鸡声起五更。\n畎浍满时瞻日上，桔槔俯处候云横。\n调疏征省家才给，便买诗书教后生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28685,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"菊涧之宜兴兼简赵长官","author":"释居简","text":"伯氏如文举，何烦仲氏书。\n山阴溪上棹，灞岸雪中驴。\n耕岂无闲地，居仍有弊庐。\n看家老猿鹤，渠不为贫疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28686,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闰月三日即事","author":"释居简","text":"星历新传误，无人重讲明。\n日中阴似夜，春半冷如正。\n柳欲眠还醒，花犹染不成。\n燕归多日了，犹自未闻莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28687,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"横山王八伯丹井","author":"释居简","text":"殿阴瓴甃古，汲向瓦炉煎。\n甘拊惠山背，冽差帘谷肩。\n还丹非内外，馀沥尚清涟。\n莫问井中影，盍窥天地先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28688,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食","author":"释居简","text":"才见茅檐插柳条，便知寒食是今朝。\n春应不恨相寻晚，应恨常阴一半消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28689,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翟园 其一","author":"释居简","text":"廷尉园池傍柳塘，自携魏紫访姚黄。\n问它濯锦江头路，共汉梁王醉几场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28690,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]