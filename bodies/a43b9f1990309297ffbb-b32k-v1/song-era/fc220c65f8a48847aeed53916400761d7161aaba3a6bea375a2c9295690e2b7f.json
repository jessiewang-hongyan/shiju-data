[{"title":"和怀英雪诗 其一","author":"李处权","text":"路迷应有误随车，望眼楼高莫可涯。\n鹤驾鹭涛来浩渺，瑶林琼树出交加。\n广寒玉兔翻羞缩，上蔡苍鹰正怒拿。\n得句幽人方起舞，夜寒明月在梨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和表臣遗诗招归仙隐","author":"李处权","text":"客里栖栖叹食艰，桃源也复念人间。\n九重鹓鹭思金屋，万里烟尘痛玉关。\n节物可怜梅竞出，浪萍长羡鸟知还。\n明朝跋马归仙隐，健笔清樽尽傲閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和彦冲同原仲过交溪桥头","author":"李处权","text":"不识交溪路，诗来锦绣重。\n閒云时出岫，落日更明松。\n叔夜常为锻，渊明亦近农。\n喜君机事息，鱼鸟故相容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赏卿席上之韵","author":"李处权","text":"翠竹丹枫共一村，诗家得句转清新。\n已怜楚地梅知腊，更想隋河柳欲春。\n须信成名皆志士，故应行乐属吾人。\n请君淬砺斑斑刃，始验儒冠不误身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜雪偶书","author":"李处权","text":"岁晚山云合，窗鸣霰雪飞。\n方欣樽有酒，未叹箧无衣。\n谷杳青松健，林空绿萼肥。\n月明溪上醉，应是夜深归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉怀养源士特似表","author":"李处权","text":"一坐关山百念灰，德邻诗社许徘徊。\n静看林鸟衔花去，寒觉溪风送雨来。\n小阮有怀应种竹，步兵无事且传杯。\n东床坦腹真佳婿，俗客多惭数月陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"放步登游回谢表臣遗酒","author":"李处权","text":"每爱前山似画图，兴来萧散岂能无。\n幽人著屐全忘懒，野老关门不可呼。\n夕照晖晖明远水，春风莽莽著平芜。\n晴来已喜儿能赋，软脚仍烦送一壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武林偶作","author":"李处权","text":"江山天下胜，北客兴悠哉。\n月上千峰雪，潮生万壑雷。\n酒狂怜老大，吟苦觉衰颓。\n始满平生愿，征帆未忆开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"表臣检校东皋雨中有怀诗以促归","author":"李处权","text":"旅泊愁春雨，春寒更北风。\n云山方秀发，烟树却冥濛。\n念我携家客，逢君足谷翁。\n胡为在穷谷，正渴一尊同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨止送王侍郎","author":"李处权","text":"南州春老雨如丝，刺眼青秧水满陂。\n树湿黄莺看更好，溪浑白鹭立多时。\n寸心折尽人千里，霜鬓凋残酒一卮。\n我恐前身是匡鼎，幸公不厌解颐诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后凝秀阁口占呈子方","author":"李处权","text":"凿石为渠水有声，四垣惟欠竹青青。\n壁含霁月光千丈，黛拂云峰画一屏。\n香异定应来绝岛，茶甘初不藉中泠。\n主人莫惜千金费，更作飞楼拟摘星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临川道中寄汪守","author":"李处权","text":"渐远闽中地更平，土风疏爽语言轻。\n山浓不减嵩高翠，溪涨浑如洛浦声。\n忽见槐花思举子，欲求萤火遗书生。\n使君元是丈人行，回首铃斋空复情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复次韵呈诸友","author":"李处权","text":"梅树飘香酒满杯，时危风景亦佳哉。\n横筇有客挑钱去，重担谁家送米来。\n云色可怜谈次改，年华不奈鬓边催。\n萧郎及我亲书尺，珍赠霜纨费剪裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彦修席上命赋何处难忘酒","author":"李处权","text":"何处难忘酒，南州盗贼多。\n黄巾方裂眦，白日敢持戈。\n不见韩擒虎，宁闻马伏波。\n此时无一盏，其奈客愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚简德孺","author":"李处权","text":"人生有酒即佳辰，忽忽园林已暮春。\n雨后落花浑帖砌，风前飞絮欲沾人。\n我如放浪陶彭泽，公是风流贺季真。\n伊水崧云在何处，旧衣犹有洛阳尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"草饮招表臣才臣彦文道夫","author":"李处权","text":"愧匪屠门嚼，且无金屈卮。\n人生难得醉，我辈不须辞。\n山迥云生谷，林空鸟并枝。\n前溪天欲雪，为报戴逵知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赴端礼之招道中偶成","author":"李处权","text":"月离于毕俾滂沱，兆及丰年喜欲歌。\n任有泥涂甘曳尾，更无波浪敢凭河。\n老来酒量难酬酢，閒里诗情好琢磨。\n晏子方观久而敬，人间炙手又张罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送二十兄还镇江","author":"李处权","text":"此行检校幽栖事，佳处知公故未忘。\n新笋定应过母大，旧松想亦及人长。\n老来对客须灵照，贫后持家藉孟光。\n世乱身危何处是，二年孤负北窗凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送公卷赴金陵","author":"李处权","text":"惟曾家世颇堪论，文采南丰实浚源。\n德必有言人望重，义形于色主威尊。\n随珠未可轻弹雀，腐鼠从教竞嚇鹓。\n固是相门终出相，鲁公泉下有英魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送石与德孺","author":"李处权","text":"坡老仇池安在哉，佛家鹫岭解飞来。\n但令气象侔衡霍，可要孤高切斗魁。\n涡处正堪承雨露，浪中莫使长莓苔。\n明窗净几无尘入，想对诗翁墨沼开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨充老","author":"李处权","text":"蚤接君家伯仲贤，笑谈吹断各风烟。\n人生俱是梦中事，归计却须沙上田。\n悔有论心三尺喙，恨无糊口一囊钱。\n他时局罢樵柯烂，小道谁知亦有仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杲兄","author":"李处权","text":"衲子谁为盖代豪，生憎污俗紫方袍。\n何须鉴水能知止，未必归云可拟高。\n虎穴等閒休探手，龙泉取次莫吹毛。\n君知五祖堂中老，妙处何曾挂一毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送表之","author":"李处权","text":"平生佳处在离骚，怪我年来得此豪。\n不信胸中横太华，试从笔下看惊涛。\n门连止水心无竞，地接名山眼更高。\n要是一时廊庙器，莫将刘向比王褒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送徐漕","author":"李处权","text":"都门雪罢看杨柳，濯濯风流已不群。\n千里澄清方有道，十年出处不忘君。\n新诗旧自开锦段，醉面向人生缬纹。\n我欲从公借馀地，与传名姓上青云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送密老","author":"李处权","text":"岁寒纡锡辱西临，一笑忘言意自深。\n怪石奇松那有价，片云孤鹤本无心。\n上人已了洞山偈，倦客方为梁父吟。\n枯木堂中无孔笛，侍郎今日是知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谹父","author":"李处权","text":"一见琼林病眼开，东南秀爽力能回。\n须知载腹五千卷，受我浇肠三百杯。\n可但世官从凤沼，要看人物上云台。\n歌呼枉费谈天口，宜及中兴国论陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送景荀","author":"李处权","text":"丈人能事见斯文，世业家风尽属君。\n自许旦评方藉藉，岂同时辈漫纷纷。\n清于须水真堪挹，秀自郎峰故不群。\n五马双旌何足道，便看平步到青云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送粹伯弟亲迎兼简宣卿龙图","author":"李处权","text":"悲秋宋玉已销魂，忍听阳关共十分。\n黄叶萧萧下寒日，碧山逐逐过晴云。\n面如濯玉想无对，气已食牛知不群。\n问讯冰清怀大雅，世家王谢属斯文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送蔡伸道","author":"李处权","text":"当年倾盖便情亲，老去那知更贱贫。\n松竹故园秋未老，溪山南国雨能新。\n可怜作客身如梦，尚喜传家笔有神。\n咫尺重阳归务速，吹花落帽要吾人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"食鲙","author":"李处权","text":"设网机关密，磨刀意气粗。\n令人思洛鲤，愧客问江鲈。\n豆曲偏相与，橙齑未可无。\n相从频莫厌，乘兴不烦呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"席上次表臣韵以遗明之仍督其和章","author":"李处权","text":"一日复倾三百杯，新年物色兴悠哉。\n应怜远客此流落，故有幽人常往来。\n楮刻三年殊未就，诗成七步可须催。\n平生信笔多狂简，从此方知所以裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"席上赋梅","author":"李处权","text":"桃李何须续后开，芝兰胜韵许相陪。\n先春莫道无深意，调鼎方知有大才。\n南国正宜溪上路，故园长梦竹间台。\n骚人不为寻诗句，自爱幽芳特特来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃花","author":"李处权","text":"照水桃花树，春风灼灼开。\n虽非天上种，何异观中栽。\n帝子吹笙罢，渔人信棹回。\n故园何处是，目尽望乡台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桐庐道中九日逢子公","author":"李处权","text":"三年客里重阳节，故典征衣共一杯。\n雁下紫萸能自好，霜前黄菊为谁开。\n中原豺虎定何许，故国池台安在哉。\n山水中逢张学士，慢扶双桨不须催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桥院","author":"李处权","text":"淹留岁云暮，旅泊似幽栖。\n鸥鹭如相识，牛羊自不迷。\n已烦陶令顾，何必谢公携。\n始觉吴侬健，天寒更涉溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪诸友赴城南妙智上人晚集","author":"李处权","text":"晚烟林际泊，夕阳波上明。\n天寒少佳色，树老无柔声。\n支郎颇好事，我辈适同行。\n剧论不知醉，感时空复情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪诸友野步 其一","author":"李处权","text":"北客身将老，东风又岁华。\n山晴添气象，水暖莫津涯。\n贫觉他乡苦，慵嫌去路斜。\n升平吾会见，时事不须嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪诸友野步 其二","author":"李处权","text":"淹留伤老眼，放旷适閒心。\n石浅出佳色，鸟幽传好音。\n课诗空自切，馈酒莫辞深。\n更说溪西寺，明朝款款寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪德久出郊","author":"李处权","text":"北客南征岁欲阴，经行始满爱山心。\n霜溪见石如清洛，烟树参云似故林。\n昨日喜传黄屋信，馀生怕听白头吟。\n公归问讯庵中老，只履西来意浅深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陪德孺游徐氏园池","author":"李处权","text":"十载吾庐信不通，偶来仁里一尊同。\n心惊人物如江左，眼净林塘似洛中。\n著日晶明松下雪，弄波萧瑟竹间风。\n浇花酿酒勤料理，作记东园有醉翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶至溪岸时当寒食书节物呈同行","author":"李处权","text":"风作山云断复飘，沙平竹日影萧萧。\n柔桑始叶蚕争出，浅水无鱼鹭独翘。\n白发寻春悲去国，朱门赐火望行朝。\n游从此地多君子，乘兴来过不待招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶坐西斋陪介卿赏卿嘉话久之成诗","author":"李处权","text":"静闻檐际雨，密障坐隅风。\n竹晚叶时堕，梅疏香欲空。\n芝兰室自好，文字饮谁同。\n它日功名事，应从笔砚中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄八十五侄","author":"李处权","text":"把玩新诗病眼开，家风端有谪仙才。\n祗应鱼蟹留人住，肯为溪山唤我来。\n客舍更堪秋乍入，鬓毛无柰老相催。\n重阳共醉滕王阁，此观人间亦伟哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄吕季升","author":"李处权","text":"家世中朝第一流，郡符那得久淹留。\n诗情更入山水国，醉眼独高烟雨楼。\n文举定非馀子辈，元龙须向古人求。\n磻溪莫讶功名晚，今代何人有直钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄朱希真","author":"李处权","text":"故人俱白发，念子始青袍。\n仆色新生敬，诗名旧仰高。\n天寒西日瘦，岁晚北风号。\n望望滕王阁，何时共浊醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄昙晦二首 其二","author":"李处权","text":"高僧辟馆坐诸生，夜久亦闻弦诵声。\n物外喜君能笔砚，尘中愧我漫簪缨。\n钵飧尚返慈乌哺，囊句时为老凤鸣。\n他日篮舆莲社约，秖应惠远识渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄昙晦二首 其一","author":"李处权","text":"道无南北本同流，远赴丛林非所求。\n到底此生俱扰扰，从前何事不悠悠。\n撞钟击鼓千人饭，戴角披毛万劫休。\n蚤晚相从岩下寺，对床清话雨飕飕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄益谦","author":"李处权","text":"青鬓追随到白头，中间忧患两悠悠。\n异时果有臧仓沮，他日宁无雍齿侯。\n旧隐重过三径菊，昔贤何在五湖舟。\n一杯坐阻论文酒，老懒闭门春事休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄萧国器","author":"李处权","text":"路贫不在扊扅炊，调苦谁闻食菜时。\n枉道故于寻尺见，求人曷以斗升为。\n夷吾不去齐何患，叔向方来晋可知。\n得士则兴今亦古，可能只直五羊皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄德器二首 其二","author":"李处权","text":"客舍春寒数挽衣，云重雨湿不闻鼙。\n老妻未免负薪叹，稚子何为索饭啼。\n南地好山青不断，故园芳草绿应齐。\n胸中磈磊但尘土，惭愧锦囊兼玉溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄德器二首 其一","author":"李处权","text":"清耽七盌爱卢全，富贵千金鄙邓通。\n新岁烟尘悲塞北，旧时花鸟忆回中。\n可能春雨如秋雨，合是东风却北风。\n尚喜张仪惟舌在，百年从古没终穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅二首 其二","author":"李处权","text":"可怜映竹深深见，似为催诗特特开。\n湖上林逋今老矣，扬州何逊未归来。\n前村欲雨鸠呼妇，断垄收晴雉应媒。\n幻境应当如是观，道人深悟劫池灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅二首 其一","author":"李处权","text":"岁晚匆匆日复夜，老禅相对口慵开。\n梦归千里几时到，香度一枝何处来。\n世乱飘零少供给，地寒潦倒无梯媒。\n可怜七尺髯如戟，愧负妻孥空拨灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日席上呈诸友 其一","author":"李处权","text":"佳节年年好，新春处处宜。\n莺花从自得，蒲柳顿先衰。\n事过如惊梦，愁来剧乱丝。\n神仙端可学，吾愿问安期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日席上呈诸友 其二","author":"李处权","text":"飘零何足怪，丧乱故应宜。\n炙手宁为盛，张罗未必衰。\n篇章怀杜牧，游说鄙袁丝。\n钟鼎山林事，胸中自有期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒王夏卿同过曼卿西轩留题","author":"李处权","text":"烟云坐久湿人衣，未觉城中有鼓鼙。\n春到好花随意折，日长幽鸟尽情啼。\n贵公行色心方壮，旷士閒居物已齐。\n客子不知今夕梦，故乡何处是潜溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后赴徐氏招呈德孺","author":"李处权","text":"梅林楼阁上嵯峨，浅渌浮澌亦自波。\n庄叟梦中非一蝶，右军书次失群鹅。\n句从永柱思能苦，人在玉壶寒更多。\n宴寝凝香归入夜，流苏帐小奈公何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后赴徐氏燕集","author":"李处权","text":"已雪犹阴更逆风，斜川略彴断行踪。\n瑶台贝阙三千丈，玉树琼林一万重。\n学子经时无载酒，邻僧过午未鸣钟。\n华筵此地成宾主，孔翠屏深琥珀浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜闻三十弟消息","author":"李处权","text":"喜得真消息，仍安岭表居。\n深知道路远，不在信音疏。\n荔子应怜汝，槟榔敢笑渠。\n一年看又尽，兄弟意何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雪","author":"李处权","text":"剪水适从天上手，缀条不作世间花。\n柴门有客方高枕，石鼎无人共试茶。\n清借远山迎马出，润含修竹倚窗斜。\n令人却忆前年盛，辇毂欢声百万家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食日同赏卿步江头","author":"李处权","text":"树含新绿花事稀，友生要我宁重违。\n信脚一百五日出，扪心四十九年非。\n饧粥盘空家立壁，松楸地远涕沾衣。\n弟兄不见音书绝，植杖临流赋式微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"强立许酒不至因以趣之","author":"李处权","text":"北里溪山翠满门，似闻小阮瓮浮春。\n怜渠世乱益风味，念我途穷多苦辛。\n旷士可无千日醉，浮生何事百年身。\n临风日日香穿鼻，被缚甘为瓮下人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"温其示梅诗用韵为谢兼简士特 其二","author":"李处权","text":"潦倒谁怜五十霜，登门可愧及肩墙。\n银钩已作惊人势，玉唾何悭照眼光。\n春醉灯前犹纵博，夜阑帐底更添香。\n阮生正作穷途哭，漫道江南刺史肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"温其示梅诗用韵为谢兼简士特 其一","author":"李处权","text":"可喜刘郎鬓未霜，能容宋玉近东墙。\n自知老眼无春事，谁意穷途得夜光。\n前日桃园真有路，何时兰室可无香。\n便须一醉经千日，免作人间寸寸肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游岘山观颜鲁公洼樽呈谹父","author":"李处权","text":"人物如公亦伟哉，洼樽寂寞岘山隈。\n似闻著履凌风出，不见拿舟弄月回。\n往事只应君可纪，幽期孰谓我能开。\n留诗更约荷花语，莫惜障泥走马来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58793,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]