[{"title":"丁香","author":"洪遵","text":"来自丁香国，还应世所稀。\n丛生盛枝叶，乱结罥中衣。\n冷艳琼为色，低枝翠作围。\n蔓连疑锁骨，时见玉尘飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王世英秀才出示曾卿诗求和","author":"洪遵","text":"投笔文章壮志休，鸟经鹤训漫心留。\n若为一见开青眼，解使三公出黑头。\n望陇自应知可否，折潮须信妙源流。\n夜光明月无虚售，可忍庸人按剑求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洛花不望而至次相兄韵","author":"洪遵","text":"多谢吴中客，移花五亩园。\n灰心劳远梦，茧足蹈前言。\n定是黄金蕊，真须白玉尊。\n从今付幽赏，不用赋招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉诏郡县行乡饮酒礼颂诗 其六","author":"洪遵","text":"乃速庠门，乃洁东荣。\n宾主僎介，堪舆是程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉诏郡县行乡饮酒礼颂诗 其十二","author":"洪遵","text":"允哉帝德，侯其伟而。\n矢诗不多，维后之诒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉诏郡县行乡饮酒礼颂诗 其八","author":"洪遵","text":"咏仁蹈德，骎骎措刑。\n舄弈千载，薰为太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉诏郡县行乡饮酒礼颂诗 其四","author":"洪遵","text":"爰敕方国，礼行于乡。\n稽经诹律，属民横堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉诏郡县行乡饮酒礼颂诗 其九","author":"洪遵","text":"乾清坤夷，轩豁呈露。\n万祥毕溱，登三咸五。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉诏郡县行乡饮酒礼颂诗 其十","author":"洪遵","text":"昔在建武，大圣载营。\n有臣曰湛，示我汉行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉诏郡县行乡饮酒礼颂诗 其三","author":"洪遵","text":"斤斤显宗，黼黻王度。\n三宫孔阳，精意治具。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉诏郡县行乡饮酒礼颂诗 其五","author":"洪遵","text":"先圣严严，拜跪荐祭。\n冠缨莘莘，鳞差栉比。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉诏郡县行乡饮酒礼颂诗 其一","author":"洪遵","text":"天生蒸民，曷其有识。\n维圣摩励，规闲矩饬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉诏郡县行乡饮酒礼颂诗 其二","author":"洪遵","text":"阳礼教逊，诰誓上仪。\n降周迄秦，淟涊弗治。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉诏郡县行乡饮酒礼颂诗 其七","author":"洪遵","text":"笙流觯扬，少长位辨。\n已事而竣，不诫用劝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汉诏郡县行乡饮酒礼颂诗 其十一","author":"洪遵","text":"绵蕝无传，莫克用人。\n孰播其馨，孝明是似。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞霄宫","author":"皇甫介","text":"大涤云深日月迟，羽人曾作帝王师。\n鼎中绛雪成千日，岩下幽花占四时。\n玉仗已乘鸾鹤去，青山难使鬼神移。\n人间万事惟閒好，山顶诛茅待几时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游洞霄","author":"皇甫介","text":"九曲烟霞染画图，羽人曾作帝王师。\n鼎中绛雪成千日，岩下幽花占四时。\n仙客已骖鸾鹤去，青山难使鬼神移。\n何当继踵长生地，疏瀹灵根出有为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"进诗","author":"皇甫坦","text":"夜静天中星历历，晓来坛上月娟娟。\n皇图巩固中兴业，帝祚遐昌亿万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"皇甫坦","text":"每蒙天一笑，遂与物为春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水国","author":"皇甫明子","text":"水国凄凉住，秋宵烂熳眠。\n归云犹带雨，堕月忽明船。\n社稷资长算，髭须近莫年。\n乱离栖不定，百口托浮田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京口行","author":"皇甫明子","text":"京口兵可用，酒可饮。\n一语参差族成血，忠贼相持各凛凛。\n岂知好丑隔形骸，父为孔鸾子为鸩。\n人众天定理则那，遗臭流芳且高枕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海口","author":"皇甫明子","text":"穷岛迷孤青，飓风荡顽寒。\n不知是海口，万里空波澜。\n蛟龙恃幽沈，怒气雄屈蟠。\n峥嵘抉秋阴，挂席潮如山。\n荧惑表南纪，天去何时还。\n云旗光惨澹，腰下青琅玕。\n谁能居甬东，一死谅非难。\n呜呼朝宗意，会见桑土乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梵才上人归天台 其一","author":"皇甫泌","text":"昔在童蒙岁，学礼暨诗书。\n肃肃秉庭训，罔敢宁斯须。\n积习将一纪，心目多勤劬。\n本此修拙辞，阶之登仕途。\n得以施所学，闻者谓之迂。\n吾道固未行，或嗤为腐儒。\n腐诚如所云，儒非吾敢居。\n时英贱民政，亦诮官之粗。\n嘉言屡诒勖，周旋画伟谟。\n胡不事章句，清贵无加于。\n我闻今学者，为人不自图。\n六朝文物壅，化源由是枯。\n华文愧不能，迷深甘守株。\n古人不得见，临风重欷歔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梵才上人归天台 其二","author":"皇甫泌","text":"美玉不自贵，贵之者良工。\n高才不自明，明之者至公。\n和璞文未刻，他山石正同。\n子虚赋未行，相如车不东。\n我今徵此词，亦将拟未通。\n粤有空门子，孕秀赤城中。\n性静不欲俗，诗癖俄在躬。\n意淳自高古，言雅思变风。\n劳劳不称年，名尚高远聪。\n我来山月乡，即貌知困蒙。\n吾师道虽否，天子方文崇。\n一旦因得意，诵之于六宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和诣岩祈雨","author":"皇甫韶","text":"路尽山尤胜，溪深水愈豪。\n寺楼今不见，依旧五峰高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故人亭","author":"皇甫□","text":"倚棹短亭西，吹尘认旧题。\n水添春岸阔，云压暮山低。\n沙觜鹭初宿，树头乌自啼。\n故人今不见，惟有草萋萋。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"皇甫□","text":"棹穿波底月。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄王山","author":"盈盈","text":"枝上差差绿，林间簌簌红。\n已叹芳菲尽，安能樽俎空。\n君不见铜驼茂草长安东，金玉镳勒雪花骢。\n二十年前是侠少，累累昨日成衰翁。\n几时满饮流霞钟，共君倒载夕阳中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"伤春曲","author":"盈盈","text":"芳菲时节，花压枝折。\n蜂蝶撩乱，阑槛光发。\n一旦碎花魂，葬花骨。\n蜂兮蝶兮何不来，空使雕阑对寒月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送僧归护国寺","author":"祖士衡","text":"雪中问法传宗印，日暮裁诗变楚骚。\n香积诸天修净供，蒲茸三殿赐新袍。\n夜禅锡驻青鸳刹，晓渡杯陵白露涛。\n参罢虚堂惟宴坐，风松露桂海蟾高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又游灵岩","author":"祖无择","text":"红尘满为三回到，青嶂迎人万叠开。\n却被野僧相顾笑，区区还是旧时来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"马古口占","author":"祖无择","text":"前年蹑屩念归与，今日乘轩类使乎。\n千里班春忧寄重，自惭翻属个非夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"历城春日对酒","author":"祖无择","text":"数尺游丝拂面来，数枝红杏向人开。\n眼前信美非吾土，且劝春风酒一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"记万载风俗三绝 其三","author":"祖无择","text":"田中多峭石，苍玉乱攲斜。\n怪似湘中见，封域近长沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"交代屯田远惠书问纸尾批示若就江州至军兼可腹背游览庐阜因成拙句且答佳意","author":"祖无择","text":"庐山在境好行春，犹恨奇峰半属邻。\n腹背遍游烦示谕，即当先谒乐天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘仙石 其一","author":"祖无择","text":"神仙不死石长存，万古千秋表洞门。\n人欲求真好修炼，莫徒将杖叩苔痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘仙石 其二","author":"祖无择","text":"支机莫问君平肆，取履谁收黄石祠。\n深洞自开人不见，何须惆怅忆当时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏别申申堂","author":"祖无择","text":"翠柳和烟笼碧沼，红芳如火照诸邻。\n主公欲去宁无恋，倚翠隈红属后人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵酬陈判官见贻","author":"祖无择","text":"一篇为惠枉瑶封，疑得仙文自蕊宫。\n始信夫君才力大，居然天地入形笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自咏二首 其一","author":"祖无择","text":"松下门开入翠微，草香花气袭春衣。\n山中深僻无人到，自有閒云共鹤飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过涡河","author":"祖无择","text":"扬鞭策羸马，桥上一徘徊。\n欲拟临涡赋，惭无八斗才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"汴水即事","author":"祖无择","text":"波狂如箭雨如丝，汎汎扁舟瞥鸟飞。\n睡起讴鸦乍鸣橹，却思村舍听邻机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"周成职方笑台","author":"祖无择","text":"贾生太息唐衢哭，感事伤时可奈何。\n争似君当尧舜日，台头大笑乐天和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李觏《送春绝句二首寄呈龙学》 其一","author":"祖无择","text":"忆昔相逢甲午年，与君同赋送春篇。\n等闲又见春风老，更捧新吟一惘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李觏《送春绝句一首呈龙学》","author":"祖无择","text":"九十日春今日尽，送春何况我偏知。\n后期应在经残腊，重探梅开雪里枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李觏《送春绝句二首寄呈龙学》 其二","author":"祖无择","text":"万树红芳落渐稀，浮荣能得几多时。\n孤根未识阳和力，春去春来两不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏茧儿","author":"祖无择","text":"千丝万缕自经营，本为藏身却误身。\n待得巧成归鼎镬，不知轻煖属他人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏震山岩彭徵君钓台","author":"祖无择","text":"闲作山城吏隐居，敬君真逸寓渔矶。\n台前岩畔清风在，尚想烟波映芰衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"招二三僚友游庐阜","author":"祖无择","text":"雨馀庐阜连天碧，公退铃斋尽日闲。\n为报二三佳客道，速须蜡屐共登山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将至南康道中","author":"祖无择","text":"湓江辍棹整骖騑，松路杨鞭入翟微。\n好是近郊人候望，纷纷羽服与田衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋晓寓自","author":"祖无择","text":"梧桐冷坠秦宫井，沆瀣光浮汉苑槃。\n倚杵远天垂六幕，照梁初日上三竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袁州庆丰堂十闲咏 其五","author":"祖无择","text":"晓桉三杯后，闲烹北苑茶。\n色香俱绝品，雪泛满瓯花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袁州庆丰堂十闲咏 其九","author":"祖无择","text":"渐老无功业，闲思惜壮年。\n桑榆如有得，犹可勒燕然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袁州庆丰堂十闲咏 其七","author":"祖无择","text":"雨霁轻埃息，闲吟面曲池。\n游鳞时对掷，双破碧涟漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袁州庆丰堂十闲咏 其八","author":"祖无择","text":"朝来因试笔，闲答故交书。\n莫怪音尘绝，吾心与世疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袁州庆丰堂十闲咏 其一","author":"祖无择","text":"吏散铃斋掩，闲眠到日斜。\n无端是春梦，容易绕京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袁州庆丰堂十闲咏 其六","author":"祖无择","text":"扁舟宾客少，闲作道家装。\n迹静心还静，逍遥觉日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袁州庆丰堂十闲咏 其四","author":"祖无择","text":"青山日相对，闲看白云生。\n谁谓无心出，中含济物情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40632,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袁州庆丰堂十闲咏 其十","author":"祖无择","text":"晴轩足清趣，闲与鹤开笼。\n寄语北山侣，无惊蕙帐空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40633,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袁州庆丰堂十闲咏 其二","author":"祖无择","text":"郑声良可厌，闲抱七丝琴。\n欲识调弦意，理人先理心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40634,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袁州庆丰堂十闲咏 其三","author":"祖无择","text":"年长身多病，闲钞已试方。\n未甘先犬马，毕命报恩光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40635,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸳鸯","author":"祖无择","text":"水宿云飞无定期，雄雌两两镇相随。\n到头不会天何意，却使人生有别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40636,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"曹六四歌同游灵岩因寄尊府判院","author":"祖无择","text":"石湖浮动灵岩月，天静碧云低白烟。\n此夜山川宜断取，为予携到若翁前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40637,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游栖贤","author":"祖无择","text":"偷得沈迷簿领身，暂来林下访幽人。\n云泉满眼慵归去，便拟抛官学隐沦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40638,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登泰山简周行","author":"祖无择","text":"日日尘中眼不开，暂登苍翠喜游陪。\n莫辞辛苦经难险，大有人生不到来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40639,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感事","author":"祖无择","text":"东家木铎德音远，西竺金人像教来。\n礼乐不兴王道绝，吾民何日遂康哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40640,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"聚为九老自咏","author":"祖无择","text":"科名高厌玉阶前，历任公卿四十年。\n休道老夫无事业，两扶红日上青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40641,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"澄清阁在","author":"祖无择","text":"范滂雅志在澄清，今日廉车命阁名。\n华榜高标虽具美，奈何长是困苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40642,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题余尚书山居要术","author":"祖无择","text":"张衡已作归田赋，汜胜仍修种树书。\n愿借山居精要术，欲将嵩洛葺吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40643,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题蔡州东湖","author":"祖无择","text":"夕阳水底霞铺锦，清夜波心月涌金。\n此是东湖最佳处，无人来伴水仙吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40644,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题蔡州壶仙观","author":"祖无择","text":"莺老花残过禁烟，杖藜閒步到壶仙。\n仙家本是无尘地，别有风光一洞天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40645,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠江州李虚一司户","author":"祖无择","text":"官况萧条三语掾，地居卑湿九江城。\n曾闻午夜开宣室，早晚君王召贾生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40646,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日陪旧参政蔡侍郎宴颍州西湖","author":"祖无择","text":"秋晚西湖胜槩多，台轩来此驻鸣珂。\n沙鸥散去惊丝竹，烟柳低垂间绮罗。\n乱掷金钱和露菊，狂摇钿扇倚风荷。\n下僚幸接曹尊末，率尔翻成击箸歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40647,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日登袁州宜春台","author":"祖无择","text":"落帽佳辰又到来，黄花烂熳为谁开。\n已经多岁衰容改，更被无情急景催。\n取次杯盘须尽醉，随宜歌管任频陪。\n却渐未报君恩厚，空向山城养不才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40648,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又和题宜春台","author":"祖无择","text":"异乡何处散幽怀，赖得城中百尺台。\n还向天涯经岁住，那知春色为唯来。\n雪消江上看梅发，风暖衡阳有雁回。\n强拟登高聊赋咏，再三愧乏楚人才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":40649,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]