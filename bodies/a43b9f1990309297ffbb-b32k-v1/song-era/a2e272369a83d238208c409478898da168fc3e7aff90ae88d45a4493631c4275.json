[{"title":"同程郎中父子月陂上闲步吟","author":"邵雍","text":"草软沙平风细溜，云轻日淡柳低萎。\n狂言不记道何事，剧饮未尝如此杯。\n景好只知闲信步，朋欢那觉太开怀。\n必期快作赏心事，却恐赏心难便来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"名利吟","author":"邵雍","text":"重之以名，见人之情。\n厚之以利，见人之意。\n情意内也，内重则外轻。\n名利外也，内贱则外贵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"因何吟","author":"邵雍","text":"梅因何而酸，盐因何而咸。\n茶因何而苦，荠因何而甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宇宙吟","author":"邵雍","text":"宇宙在乎手，万物在乎身。\n绵绵而若存，用之岂有勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中一炷香","author":"邵雍","text":"安乐窝中一炷香，凌晨焚意岂寻常。\n祸如许免人须謟，福若待求天可量。\n且异缁黄徼庙貌，又殊儿女䙚衣裳。\n中孚起信宁烦祷，无妄生灾未易禳。\n虚室清泠都是白，灵台瑩静别生光。\n观风禦寇心方醉，对景颜渊坐正忘。\n赤水有珠涵造化，泥丸无物隔青苍。\n生为男子仍身健，时遇昌辰更岁穰。\n日月照临功自大，君臣庇荫效何长。\n非徒闻道至于此，金玉谁家不满堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中一部书","author":"邵雍","text":"安乐窝中一部书，号云皇极意何如。\n春秋礼乐能遗则，父子君臣可废乎。\n浩浩羲轩开辟后，巍巍尧舜协和初。\n炎炎汤武干戈外，恟恟桓文弓剑馀。\n日月星辰高照耀，皇王帝伯大铺舒。\n几千百主出规制，数亿万年成楷模。\n治久便忧强跋扈，患深仍念恶驱除。\n才堪命世有时有，智可济时无世无。\n既往尽归闲指点，未来须俟别支梧。\n不知造化谁为主，生得许多奇丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中好打乖吟","author":"邵雍","text":"安乐窝中好打乖，打乖年纪合挨排。\n重寒盛暑多闭户，轻暖初凉时出街。\n风月煎催亲笔砚，莺花引惹傍樽罍。\n问君何故能如此，秪被才能养不才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中自讼吟","author":"邵雍","text":"不向红尘浪著鞭，唯求寡过尚无缘。\n虚更蘧瑗知非日，谬历宣尼读易年。\n发到白时难受彩，心归通后更何言。\n至阳之气方为玉，犹恐钻磨未甚坚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中吟 其五","author":"邵雍","text":"安乐窝中春梦回，略无尘事可装怀。\n轻风一霎座中过，此乐直从天外来。\n日影转时从杖屦，花阴交处傍樽罍。\n人间未若吾乡好，又况吾乡多美才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中吟 其七","author":"邵雍","text":"安乐窝中三月期，老来才会惜芳菲。\n自知一赏有分付，谁让万金无孑遗。\n美酒饮教微醉后，好花看到半开时。\n这般意思难名状，只恐人间都未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中吟 其六","author":"邵雍","text":"安乐窝中春不亏，山翁出入小车儿。\n水边平转绿杨岸，花外就移芳草堤。\n明快眼看三月景，康强身历四朝时。\n凤凰楼下天津畔，仰面迎风倒载归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中吟 其十三","author":"邵雍","text":"安乐窝中虽不拘，不拘终不失吾儒。\n轻醇酒用小盏饮，豪壮诗将大字书。\n花木暄妍春雨后，山川澄净九秋馀。\n闲中意思长多少，无忝人间一丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中吟 其一","author":"邵雍","text":"安乐窝中职分脩，分脩之外更何求。\n满天下士情能接，遍洛阳园身可游。\n行己当行诚尽处，看人莫看力生头。\n因思平地春言语，使我尝登百尺楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中吟 其八","author":"邵雍","text":"安乐窝中春暮时，闭门慵坐客来稀。\n萧萧微雨竹间霁，嘒嘒翠禽花上飞。\n好景尽将诗记录，欢情须用酒维持。\n自馀身外无穷事，皆可掉头称不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中吟 其十","author":"邵雍","text":"安乐窝中设不安，略行汤剂自能痊。\n居常无病不服药，就使有灾宜俟天。\n理到昧时须索讲，情于尽处更何言。\n自馀虚费闲思虑，都可易之为昼眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中诗一编","author":"邵雍","text":"安乐窝中诗一编，自歌自咏自怡然。\n陶镕水石闲勋业，铨择风花静事权。\n意去乍乘千里马，兴来初上九重天。\n忺时更改三两字，醉后吟哦五七篇。\n直恐心通云外月，又疑身是洞中仙。\n银河汹涌翻晴浪，玉树查牙生紫烟。\n万物有情皆可状，百骸无病不能蠲。\n命题滥被神相助，得句谬为人所传。\n肯让贵家常奏乐，宁惭富室剩收钱。\n若条此过知何限，因甚台官独未言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中看雪 其一","author":"邵雍","text":"同云漠漠雪霏霏，安乐窝中卧看时。\n初讶后园罗玉树，却惊平地璨瑶池。\n未逢寒食梨花谢，不待春风柳絮飞。\n酒放半醺帘半卷，此情无使外人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中看雪 其二","author":"邵雍","text":"满目是瑶琚，贫家遂富如。\n许观非许卖，宜惨不宜舒。\n醇酿装醺后，重衾造暖馀。\n肯于人世上，造险较锱铢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝中酒一樽","author":"邵雍","text":"安乐窝中酒一樽，非唯养气又颐真。\n频频到口微成醉，拍拍满怀都是春。\n何异君臣初际会，又同天地乍絪纭。\n醺酣情味难名状，酝酿功夫莫指陈。\n斟有浅深存燮理，饮无多少寄经纶。\n凤凰楼下逍遥客，郏鄏城中自在人。\n高阁望时花似锦，小车行处草如茵。\n卷舒万世兴亡手，出入千重云水身。\n雨后静观山意思，风前闲看月精神。\n这般事业权衡别，振古英雄恐未闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安乐窝铭","author":"邵雍","text":"安莫安于王政平，乐莫乐于年谷登。\n王政不平年不登，窝中何由得康宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"尧夫吟","author":"邵雍","text":"尧夫吟，天下拙。\n来无时，去无节。\n如山川，行不彻。\n如江河，流不竭。\n如芝兰，香不歇；如箫韶，声不绝。\n也有花，也有雪。\n也有风，也有月。\n又温柔，又峻烈；又风流，又激切。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁俭吟","author":"邵雍","text":"岁俭心非俭，家贫道不贫。\n谁知天地内，别有好乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮自贻吟","author":"邵雍","text":"天道无长春，地道无常珍。\n须禀中和气，方生粹美人。\n良田多黍稌，薄地足荆榛。\n樗栎蓬蒿类，止能充恶薪。\n既为万物灵，须有万物粹。\n既无万物灵，徒分万物类。\n欲出至珍言，须有至珍意。\n欲彰至美名，须作至美事。\n济时为美事，悟主为珍意。\n奈何此二者，我独无一与。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮吟 其一","author":"邵雍","text":"此情人不知，亦尝叹迟暮。\n虽则叹迟暮，奈何难分付。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮吟","author":"邵雍","text":"世上纷华都不见，眼前惟见读书尊。\n百千难过尚惊惕，三十岁前尤苦辛。\n少日只知艰险事，老年方识太平身。\n家风幸有儿孙继，足以无心伴白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮吟 其二","author":"邵雍","text":"此情人不知，亦尝叹迟久。\n虽则叹迟久，奈何人不受。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"异同吟","author":"邵雍","text":"俊快伤灭裂，厚重伤滞泥。\n趋造随所尚，不免有同异。\n异己必为非，同己必为是。\n是非战异同，终身不知义。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏呈王郎中","author":"邵雍","text":"近年好花人轻之，东君恶怒人不知。\n直与增价一百倍，满洛城春都买归。\n一株二十有四枝，枝枝皆有倾城姿。\n又恐冷地狂风吹，盛时都与籍入诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏答友人吟","author":"邵雍","text":"邵尧夫者是何人，岁岁春秋来谒君。\n车小半年行一转，非如骏马走香尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有妄吟","author":"邵雍","text":"作伪少阴德，饰非多隐情。\n人心虽暧昧，天道自分明。\n手足既皆露，语言安足凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"有常吟","author":"邵雍","text":"天地有常理，日月有常明。\n四时有常序，鬼神有常灵。\n圣人有常德，小人无常情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"欢喜吟","author":"邵雍","text":"欢喜又欢喜，喜欢更喜欢。\n吉士为我友，好景为我观。\n美酒为我饮，美食为我餐。\n此身生长老，尽在太平间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"欢喜吟","author":"邵雍","text":"行年六十一，筋骸未甚老。\n已为两世人，便化岂为夭。\n况且粗康强，又复无忧挠。\n如何不喜欢，佳辰自不少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"死生吟","author":"邵雍","text":"学仙欲不死，学佛欲再生。\n再生与不死，二者人果能。\n设使人果能，方始入于情。\n赏哉林下人，不为人所惜。\n哀哉公与卿，重为人所惑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"百病吟","author":"邵雍","text":"百病起于情，情轻病亦轻。\n可能无系累，却是有依凭。\n秋月千山静，春华万木荣。\n若论真事业，人力莫经营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"竹庭睡起","author":"邵雍","text":"竹庭睡起闲隐几，悠悠夏日光景长。\n莺方引雏教嫩舌，杏正垂实装轻黄。\n雨滴幽梦时断续，风翻远思还飞扬。\n小渠弄水绿阴密，回首又且数日强。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老去吟 其一","author":"邵雍","text":"使吾却十岁，亦可少集事。\n奈何天地间，日无再中理。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老去吟 其一","author":"邵雍","text":"老去无成不入时，中年养病只吟诗。\n因乘意思要舒放，肯把语言生事治。\n世上闲愁都一致，人间何务更能为。\n携筇晚步天津畔，为报沙鸥慎勿飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老去吟 其二","author":"邵雍","text":"吾今六十六，衰老何可拟。\n志逮力不逮，人共知之矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老翁吟","author":"邵雍","text":"皤然一老翁，凡百事皆慵。\n旧物不尽记，故人难得逢。\n幽花浑在雾，残梦半随风。\n只且愿天下，时和与岁丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自凤州还至秦川驿寄守倅薛姚二君","author":"邵雍","text":"欢聚九十日，回首都如梦。\n明月与清江，东轩又难共。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自古吟","author":"邵雍","text":"自古大圣人，犹以为难事。\n而况后世人，岂复便能至。\n求之不胜难，得之至容易。\n千人万人心，一人之心是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自在吟","author":"邵雍","text":"心不过一寸，两手何拘拘。\n身不过数尺，两足何区区。\n何人不饮酒，何人不读书。\n奈何天地间，自在独尧夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自问二首 其二","author":"邵雍","text":"年来因甚可吟诗，桃李无言莺有辞。\n啼到黄昏犹自啼，奈何人老又春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自问二首 其一","author":"邵雍","text":"因甚年来可作诗，奈何人老又春归。\n流莺不忍花离披，啼到黄昏犹自啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自馀吟","author":"邵雍","text":"身生天地后，心在天地前。\n天地自我出，自馀何足言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自况三首 其三","author":"邵雍","text":"每恨性昏闻道晚，长惭智短适时难。\n人生三万六千日，二万日来身却闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自况三首 其二","author":"邵雍","text":"满天风月为官守，遍地云山是事权。\n唯我敢开无意口，对人高道不妨言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自咏吟","author":"邵雍","text":"老去无成齿发衰，年将七十待何为。\n居常无病不服药，间或有怀犹作诗。\n引水更怜鱼并至，折花仍喜蝶相随。\n平生积学无他效，只得胸中恁坦夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自贻吟","author":"邵雍","text":"六十有七岁，生为世上人。\n四方中正地，万物备全身。\n天外更无乐，胸中别有春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"自悯","author":"邵雍","text":"天无私覆古今同，手足情多骤一空。\n五七年来并家难，六十岁许更头风。\n常情不免顺世俗，私计固难专仆童。\n安得仙人旧查在，伊川云水乐无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至论吟","author":"邵雍","text":"民于万物已称珍，圣向民中更出群。\n介石不疑何尽日，知几何患未如神。\n若无刚果难成善，既有精明又贵纯。\n祸福兆时皆有渐，不由天地只由人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至灵吟","author":"邵雍","text":"至灵之谓人，至贵之谓君。\n明则有日月，幽则有鬼神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"至诚吟","author":"邵雍","text":"不多求故得，不杂学故明。\n欲得心常明，无过用至诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观七国吟","author":"邵雍","text":"当其末路尚纵横，仁义之言固不听。\n肯谓破齐存即墨，能胜坑赵尽长平。\n清晨见鬼未为怪，白日杀人奚足惊。\n加以苏张掉三寸，扼喉其势不俱生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观十六国吟","author":"邵雍","text":"溥天之下号寰区，大禹曾经治水馀。\n衣到敝时多虮虱，瓜当烂后足虫蛆。\n龙章本不资狂寇，象魏何尝荐乱胡。\n尼父有言堪味处，当时欠一管夷吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观三王吟","author":"邵雍","text":"一片中原万里馀，殆非孱德所宜居。\n夏商正朔犹能布，汤武干戈未便驱。\n泽火有名方受革，水天无应不成需。\n详知仁义为心者，肯作人间浅丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观三皇吟","author":"邵雍","text":"许大乾坤自我宣，乾坤之外复何言。\n初分大道非常道，才有先天未后天。\n作法极微难看迹，收功最久不知年。\n若教世上论勋业，料得更无人在前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3621,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观五伯吟","author":"邵雍","text":"刻意尊名名愈亏，人人奔命不胜疲。\n生灵剑戟林中活，公道货财心里归。\n虽则饩羊能爱礼，奈何鸣凤未来仪。\n东周五百馀年内，叹息唯闻一仲尼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3622,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观五帝吟","author":"邵雍","text":"进退肯将天下让，著何言语状雍容。\n衣裳垂处威仪盛，玉帛脩时意思恭。\n物物尽能循至理，人人自愿立殊功。\n当时何故得如此，只被声明类日中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3623,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观天","author":"邵雍","text":"千里南山对华山，二山中有修□□。\n□时禾黍交搔□，□静禽鱼相与闲。\n好景尽□□扬外，虚名不显落□□。\n□□□语无心旨，自谓羲皇正却还。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3624,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观陈希夷先生真及墨迹 其三","author":"邵雍","text":"希夷真可观，希夷墨可传。\n希夷心一片，不可得而言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3625,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观陈希夷先生真及墨迹 其二","author":"邵雍","text":"及见希夷迹，又见希夷真。\n始知今与古，天下长有人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3626,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观陈希夷先生真及墨迹 其一","author":"邵雍","text":"未见希夷真，未见希夷迹。\n止闻希夷名，希夷心未识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3627,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观事吟","author":"邵雍","text":"一岁之事慎在春，一日这事慎在晨。\n一生之事慎在少，一端之事慎在新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3628,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观性吟","author":"邵雍","text":"千万年之人，千万年之事。\n千万年之情，千万年之理。\n惟学之所能，坐而烂观尔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3629,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观易吟","author":"邵雍","text":"一物其来有一身，一身还有一乾坤。\n能知万物备于我，肯把三才别立根。\n天向一中分体用，人于心上起经纶。\n天人焉有两般义，道不虚行只在人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3630,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观物吟","author":"邵雍","text":"利轻则义重，利重则义轻。\n利不能胜义，自然多至诚。\n义不能胜利，自然多忿争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3631,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]