[{"title":"卢通议挽词三首 其二","author":"范纯仁","text":"教子生前贵，休官物外荣。\n去家金节重，开户玉棺轻。\n江水元如旧，松林长未成。\n祗应山鸟恨，长向垄头鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42139,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"卢通议挽词三首 其三","author":"范纯仁","text":"谁记先生事，声名五十年。\n素风人不及，阴德世相传。\n气与诗流合，官随子舍迁。\n门闾迷故客，怅望白云天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42140,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孙曼叔尚书挽词三首 其一","author":"范纯仁","text":"少海风云会，先朝眷遇隆。\n直辞裨衮阙，妙翰照琳宫。\n未展陶钧手，徒高羽翼功。\n恤终皆盛典，伤衋出宸衷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42141,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孙曼叔尚书挽词三首 其二","author":"范纯仁","text":"彼俗争同好，唯公耻妄随。\n青松寒不改，白玉涅难淄。\n梁坏营居日，舟沈欲济时。\n空留良史笔，长俾善人思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42142,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孙曼叔尚书挽词三首 其三","author":"范纯仁","text":"交分逾三绝，官联历四朝。\n心知俱白首，接武近青霄。\n逝水嗟何及，英魂恨莫招。\n空悲柏城路，风雨暮萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42143,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙图张公挽词三首 其一","author":"范纯仁","text":"仪凤来丹穴，麒麟瑞圣时。\n壶冰凝雅操，冠玉耸英姿。\n敦阅今儒将，循良古吏师。\n未登台鼎贵，胡不到期颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42144,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙图张公挽词三首 其二","author":"范纯仁","text":"四纪澄清志，三朝尽瘁身。\n褰帷跻雅俗，缓带息边尘。\n圣世歼民望，中原丧国珍。\n千秋仗良史，直笔纪贤臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42145,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙图张公挽词三首 其三","author":"范纯仁","text":"兄事儿童日，情亲五十年。\n西州官共久，畿邑政相连。\n谪籍孤踪远，亨衢众望先。\n那知不复见，一别遂终天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42146,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鲜于谏议挽词三首 其一","author":"范纯仁","text":"左蜀称多彦，唯公第一流。\n青蒲曾悟主，白首未封侯。\n名节传千古，英灵掩一丘。\n平生僚友分，怀想涕难收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42147,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鲜于谏议挽词三首 其二","author":"范纯仁","text":"命矣才中寿，天乎丧哲人。\n逢时身已病，达晚志难伸。\n清俭贫弥乐，文章老更醇。\n贻谋有馀庆，孙子自振振。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42148,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鲜于谏议挽词三首 其三","author":"范纯仁","text":"曾向西都陪白社，同为御史带乌纱。\n盘筵真率无多品，歌舞相参作一家。\n连日赏穷伊阙寺，乘春看尽洛阳花。\n那知遥作终天别，不预乡人挽葬车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42149,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"申国太师吕公晦叔挽词三首 其一","author":"范纯仁","text":"冢宰传三世，元勋辅六朝。\n承家同郑武，致主必唐尧。\n梁坏将何仰，川流不可邀。\n新阡人散后，林柏暮萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42150,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"申国太师吕公晦叔挽词三首 其二","author":"范纯仁","text":"仪物罗西甸，恩荣葬上公。\n悠扬蒿里日，惨淡柏城风。\n河岳收英气，旂常纪茂功。\n传家多令子，将复继遗忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42151,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"申国太师吕公晦叔挽词三首 其三","author":"范纯仁","text":"达尊推国老，雅量寔予师。\n世翊千龄运，哀闻二圣悲。\n伤心瞻傅象，竭力奉萧规。\n多少忠贤泪，非唯哭己知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42152,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜀郡范公景仁挽词三首 其一","author":"范纯仁","text":"翰苑文章伯，金华侍从臣。\n四朝行直道，一意在生民。\n白首唯忧国，青云早退身。\n囊中有遗藁，不学茂陵人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42153,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜀郡范公景仁挽词三首 其二","author":"范纯仁","text":"伊洛相逢日，忠贤盛集时。\n游从敦气义，唱和若埙篪。\n汉嗣资商老，尧章忆后夔。\n云亡时共惜，不独故人悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42154,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜀郡范公景仁挽词三首 其三","author":"范纯仁","text":"新阡近箕颍，故国远岷峨。\n禁从同侪少，门风吉士多。\n笑言如昨梦，身世逐颓波。\n唯有高名在，千年不可磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42155,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李师中待制挽词二首 其一","author":"范纯仁","text":"才识无前辈，文章有古风。\n爱时甘屡黜，报国仗孤忠。\n夙有请缨志，竟成标柱功。\n子孙传善庆，不独在其躬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42156,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李师中待制挽词二首 其二","author":"范纯仁","text":"历阳相遇日，流落喜俱存。\n不起骚人叹，唯知圣主恩。\n蟹膏红满箸，蚁酒白盈尊。\n岂谓江边别，深情不再论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42157,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"康国韩公子华挽词二首 其一","author":"范纯仁","text":"棣萼联三事，台星聚一门。\n诚心多士服，德望四朝尊。\n傅相骑箕远，萧规与汉存。\n两宫临奠日，哀恸见殊恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42158,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"康国韩公子华挽词二首 其二","author":"范纯仁","text":"弟兄俱是龙门客，数载难忘国士知。\n疲马每怜谙远道，焦桐竟待挂朱丝。\n青云空费提携力，白首应无报称期。\n未到柏城持葬绋，祖庭长恸涕淋漓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42159,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李彦深哀词二首 其一","author":"范纯仁","text":"妙年亲研席，壮岁各西东。\n场屋腾文价，乡关振义风。\n不违颜巷陋，竟哭阮途穷。\n赖得贤夫子，遗骖为送终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42160,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李彦深哀词二首 其二","author":"范纯仁","text":"汲汲亲师友，翘翘绝辈流。\n读书求体要，知命释穷愁。\n清白传三世，才华掩一丘。\n平生怀旧泪，为子独难收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42161,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王乐道观文挽词三首 其一","author":"范纯仁","text":"人间失词伯，天上落文星。\n商皓终辞汉，桓荣厌授经。\n重泉赍志业，乔岳返英灵。\n身后千年事，空留竹简青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42162,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王乐道观文挽词三首 其二","author":"范纯仁","text":"秘殿承新宠，储宫冠旧僚。\n从龙登紫极，扶日上青霄。\n暝壑移舟远，长川阅水遥。\n瞻怀柏城路，丹旐去飘飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42163,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王乐道观文挽词三首 其三","author":"范纯仁","text":"才罢荆州市，俄归蒿里坟。\n盐梅失群望，羽翼有前勋。\n浪作登龙客，惭无幼妇文。\n辱知无以报，洒泪向嵩云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42164,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张掞龙图挽词三首 其一","author":"范纯仁","text":"宣力三朝旧，于身五福全。\n家风良将后，经术古人前。\n丁令终辞世，留侯定得仙。\n贻谋有贤嗣，素业尽能传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42165,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张掞龙图挽词三首 其二","author":"范纯仁","text":"江边承讣日，羁宦正摧颓。\n早获登龙便，惭无附骥才。\n寄诗招悸魄，引水活枯腮。\n白首知难报，长言致一哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42166,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"张掞龙图挽词三首 其三","author":"范纯仁","text":"二纪金华侍从臣，升平看足作閒人。\n身跻显仕由稽古，世有阴功为庇民。\n但见朝廷方贵老，那知河岳遽收神。\n哀荣终始公无憾，况有清名服搢绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42167,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"筹思堂","author":"范纯仁","text":"亭为筹思设，公将称此名。\n致诚通造化，审虑敌权衡。\n境寂居忘倦，心虚照自明。\n讵同游宴事，休戚系群生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42168,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睢阳五老图","author":"范纯仁","text":"荣名雅望退休闲，声誉清高已纳冠。\n匡国多方开五老，齐名有道列双桓。\n耆英后会成威烈，相貌前图壮世寒。\n吾道欲如公道立，百年藻鉴动人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42169,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"范纯仁","text":"君行方在急流间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42170,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"运司园亭十咏 其一 山堂","author":"章楶","text":"古木郁参天，苍苔下封路。\n幽花无时歇，丑石终朝踞。\n水竹散清润，烟云变晨暮。\n何必忆山林，直有山林趣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42171,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"运司园亭十咏 其二 玉溪堂","author":"章楶","text":"堂因水得名，方沼当其后。\n漪澜荡榱桷，窗户挹花柳。\n虫鱼不避人，鸥鹭若相友。\n午枕夏簟凉，此乐亦奚有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42172,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"运司园亭十咏 其三 雪峰楼","author":"章楶","text":"层构压池塘，不僭亦不偪。\n影浮绿水静，寒凝雪山色。\n抚槛接修竹，连檐引苍柏。\n注目望长安，无奈浓云隔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42173,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"运司园亭十咏 其四 海棠轩","author":"章楶","text":"珍葩寄幽岛，正对孤轩植。\n优柔自俯仰，红绿若组织。\n春酣晴日曛，坐久浓香逼。\n池面净可鉴，朝霞罩澄碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42174,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"运司园亭十咏 其五 月台","author":"章楶","text":"蜀地饶夜雨，轻阴多蔽天。\n见月月无几，筑台邀婵娟。\n高疑桂影近，俯视云幄连。\n顾盼已尘外，欲挹瑶宫仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42175,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"运司园亭十咏 其六 翠锦亭","author":"章楶","text":"楩楠百尺馀，排列拱檐际。\n畏日自成阴，隆冬宁灭翠。\n虚旷得寂理，懒僻恣浓睡。\n谁知官府中，获此冲漠味。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42176,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"运司园亭十咏 其七 潺玉亭","author":"章楶","text":"傍砌酾小渠，回环是流水。\n石蜃吐珠涎，清响醒人耳。\n风彻竹影碎，月皎波光起。\n飒爽无尘嚣，静适心所喜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42177,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"运司园亭十咏 其八 茅庵","author":"章楶","text":"竹间构圆庵，所向自潇洒。\n珍禽弄巧舌，宛是居山野。\n默坐见真心，万缘尽虚假。\n勿陋寻尺地，兹焉息意马。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42178,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"运司园亭十咏 其九 水阁","author":"章楶","text":"架木浮水中，略彴通孤岛。\n扶疏花影反，泼刺跳鱼小。\n风月所得多，经营信云巧。\n隐几寂无人，朱兰萃幽鸟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"运司园亭十咏 其十 小亭","author":"章楶","text":"花边二小亭，双跨清渠上。\n规模虽甚隘，幽僻良可赏。\n幸依佳木阴，未羡大厦广。\n不足延赏朋，携筇常独往。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"章楶","text":"湖当荆楚百川会，江自岷峨万里山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜀先主庙古柏","author":"裴士禹","text":"武侯翊汉嗣，始欲大神器。\n天命固有常，云雷极屯否。\n流星坠武帐，万卒摧锐气。\n孤负卧龙心，三顾君臣意。\n庙貌今寂寥，握节空垂泪。\n兴废事徒然，无以穷往志。\n陵前古柏树，千丈起平地。\n根大压巨鳌，心虚藏野燧。\n风动虬龙枝，雷雨随声至。\n疑是虚空间，神明专拥庇。\n不尔千万年，突兀无枯瘁。\n观柏又惨然，念侯功业炽。\n功业亘无穷，与柏共苍翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题滴水岩 其一","author":"巩彦辅","text":"千条玉箸挂岩前，一派银潢泻碧天。\n疑是鲛人在山泣，乱流珠颗落危颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题滴水岩 其二","author":"巩彦辅","text":"岩上流泉滴滴来，史君岩下宴频开。\n衰翁閒局官清淡，不许听歌醉玉杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题滴水岩 其三","author":"巩彦辅","text":"天然潇洒绝尘埃，四面如山画帐开。\n世上何须问仙境，只应此地是蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"胡揆","text":"弄珠解佩风流古，缓带轻裘道味闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南峰亭","author":"方仲谋","text":"水色山光照曲阑，芳春时节称游观。\n莺花不为少年惜，尊俎莫辞终日欢。\n香逐好风来席上，景随佳句落毫端。\n人间胜事今犹古，谁识相并四者难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上丁守","author":"谢履","text":"闽岭天南表，清源第一州。\n朝廷推重镇，师帅得贤侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诗一首","author":"谢履","text":"蛇冈蹑龟背，虾屿据龙头。\n岸隔诸蕃国，江通百粤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"谢履","text":"近日莲峰净，春风石笋抽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"谢履","text":"凭高直接青云势，览胜双瞻碧玉颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南山","author":"许广渊","text":"路入青山几万重，前山行尽路还通。\n小舟棹急岩溪水，高柳絮飞堤岸风。\n春物老时林遍绿，晚烟收处日垂红。\n民居稀阔兼穷僻，多使顽夫气自雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜕龙洞 其一","author":"许广渊","text":"山远洞难穷，相传旧隐龙。\n蟠泥知几载，穿石见遗踪。\n灵骨岩中换，阴云日下从。\n乡人祈旱岁，歌舞尚虔恭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蜕龙洞 其二","author":"许广渊","text":"往昔开锄古洞存，神龙曾隐穴山峦。\n灵踪何日青天去，云气无时白昼寒。\n穿石分明印鳞爪，履泉惊惧作波澜。\n于今霖雨均方国，来客休疑尚此蟠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"葛溪","author":"许广渊","text":"樨川仙化后，溪以葛为名。\n水激翻空白，潭澄到底清。\n山多晴倒影，雨过夜添声。\n月满寒光入，鱼龙患太明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杜公井","author":"许广渊","text":"几处城中井，标名孰与伦。\n异非深百尺，功在活千人。\n大旱流皆涸，甘泉惠受均。\n无情知水石，诚发应如神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鍊丹井","author":"许广渊","text":"葛公高隐处，凿井碧山前。\n鍊就长生药，空馀白乳泉。\n鼎藏今去水，气吐旧成烟。\n午夜风雷作，人疑羽佩还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"放生池","author":"许广渊","text":"天宝当年寺，鱼池此日存。\n溪移古岸脚，殿压旧山根。\n月照霜钟远，风开雾阁昏。\n网纶虽废禁，和气满乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题昌国院","author":"许广渊","text":"轩开环列万峰青，门对乌伊遂榜名。\n千室楼台凭栏尽，一溪烟水捲帘明。\n炉烟晨起迷云色，松韵时来杂梵声。\n峻极祇宜长闭户，柰何持钵入东城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题广福院","author":"许广渊","text":"溪光山色照天晴，开豁襟怀远眼明。\n每日风清生竹韵，有时雨过沸滩声。\n夷犹水上渔舟逸，奋迅檐前燕翼轻。\n珍重老僧无个事，坐观群动竞经营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宁国院","author":"许广渊","text":"寺结千峰上，门通一径幽。\n静心无物乱，清耳有泉流。\n楼阁先知晓，园林预觉秋。\n因君题秀句，却省昔年游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净名院","author":"许广渊","text":"杖锡穷危顶，茅庵构白云。\n轩窗半峰出，钟磬别山闻。\n海月晓同色，炉烟昼杂薰。\n莫教深静处，思虑落尘氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"普照院","author":"许广渊","text":"乱峰环合处，中见古精庐。\n万事尽不到，数僧閒有馀。\n岭云时聚散，松竹昼清虚。\n自辨一泉后，多来长者车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈氏园","author":"许广渊","text":"今日青芜满，当年碧瓦稠。\n轩楹无寸木，池沼有残丘。\n过客嗟啼鸟，居人竟牧牛。\n子孙谁秀颖，念祖力重修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和徐令南新道中","author":"许广渊","text":"崄岩通小径，湍水度危桥。\n茶女巾蒙髻，樵人斧插腰。\n鸠鸣春昼静，莺啭晓林娇。\n令尹求民瘼，行行听路谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和晁令首夏道中","author":"许广渊","text":"山盘村曲晓烟迷，昼静新禽信意啼。\n风敛雨痕千嶂碧，日烘蚕箔万家齐。\n叶怜绿密真成幄，花惜红深又落泥。\n气候宜人尤解倦，夕阳归路绕长溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宁国院","author":"许广渊","text":"杉松郁郁际青天，堂殿重重蘸碧泉。\n山合不能遮日月，径深无碍入云烟。\n弥陀佛建千人会，照律师来五戒传。\n乘兴登临与僧话，分明水戏在帘前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惠济院","author":"许广渊","text":"建刹基千古，淩云阁数层。\n成群皆旧衲，那个是真僧。\n未灭惟心火，长明总佛灯。\n泉灵名惠济，济物有时增。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":42208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]