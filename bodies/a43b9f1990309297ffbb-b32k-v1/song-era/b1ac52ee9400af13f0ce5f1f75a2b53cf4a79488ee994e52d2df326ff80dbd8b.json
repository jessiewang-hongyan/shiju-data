[{"title":"章献明肃皇太后恭谢太庙 其十三","author":"郊庙朝会歌辞","text":"籥翟既备，干戚是陈。\n德业昭著，用和神人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章献明肃皇太后恭谢太庙 其五","author":"郊庙朝会歌辞","text":"太宫尔肃，烈祖巍巍。\n上炳淳耀，下流德晖。\n诒谋燕翼，奄宅邦畿。\n子孙千亿，历数同归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章献明肃皇太后恭谢太庙 其十二","author":"郊庙朝会歌辞","text":"苾芬既荐，溥硕咸陈。\n礼备乐举，先后有伦。\n以奉七室，齐洁惟寅。\n皇灵斯享，福祥荐臻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章献明肃皇太后恭谢太庙 其二","author":"郊庙朝会歌辞","text":"九奏允谐，皇灵来暨。\n备物芬馨，昭违精意。\n升降有仪，群臣序位。\n享于克诚，万福攸至。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章献明肃皇太后恭谢太庙 其九","author":"郊庙朝会歌辞","text":"英英艺祖，出震承乾。\n握图抚运，卜祚延年。\n衣冠在庙，威灵在天。\n永锡无疆，子孙保焉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章献明肃皇太后恭谢太庙 其三","author":"郊庙朝会歌辞","text":"懿彼灵龟，在宫之池。\n芳莲是托，千岁奇姿。\n祼将清庙，播于声诗。\n神降之吉，永保寿祺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"章献明肃皇太后恭谢太庙 其六","author":"郊庙朝会歌辞","text":"乃祖齐圣，绵瓞其昌。\n源流浚邈，统祚悠长。\n如闻肃僾，有飶馨香。\n监观垂祐，万叶储祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祫飨回升楼 其二","author":"郊庙朝会歌辞","text":"端闱壮丽，羽卫骁腾。\n天仪毕晔，如日之升。\n千官景从，万宇仰承。\n辉光四充，介福其膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祫飨回升楼 其三","author":"郊庙朝会歌辞","text":"涣号爰发，皇敷至仁。\n幽隐尽达，洪德日新。\n国容肃穆，天宇晏温。\n惠浃四远，富寿无垠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祫飨太庙 其一","author":"郊庙朝会歌辞","text":"猗我僖祖，德潜而充。\n庆之所基，日茂以崇。\n施及后嗣，天命有融。\n庙歌载之，播于无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祫飨太庙 其九","author":"郊庙朝会歌辞","text":"瑟彼良玉，荐于明灵。\n宸襟蠲洁，郁鬯芬馨。\n牲牢在俎，金石在庭。\n莫重者祼，慈嘏来宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祫飨太庙 其十一","author":"郊庙朝会歌辞","text":"铺昭典礼，诞合神灵。\n飨通纯孝，治感至馨。\n郁香既祼，圣酒来宁。\n膺兹福禄，万寿益龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祫飨太庙 其十五","author":"郊庙朝会歌辞","text":"帝还于次，佩玉其徐。\n帝色不渝，罔解如初。\n凡百府司，各祗乃位。\n敢不肃恭，以讫尔事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祫飨太庙 其四","author":"郊庙朝会歌辞","text":"洪绪载德，盛际讲仪。\n精崇祫事，恭展孝思。\n肸蚃锡羡，齐庄受釐。\n猗欤馨烈，垂贶本支。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祫飨太庙 其七","author":"郊庙朝会歌辞","text":"皇皇在宥，品物由庚。\n文教纯被，武功告成。\n流颂乐府，拥休宗祊。\n帝奉祼瓒，钦哉孝诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祫飨太庙 其十三","author":"郊庙朝会歌辞","text":"乐统大安，舞昭盛德。\n合奏允谐，孔容有翼。\n秉翟言竣，总干是力。\n箫勺之仁，参和万国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祫飨太庙 其六","author":"郊庙朝会歌辞","text":"明明圣宗，大定区宇。\n永怀奉先，阙礼兹举。\n惟德是馨，冀格我祖。\n万嗣其昌，繄神之祐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祫飨太庙 其二","author":"郊庙朝会歌辞","text":"皇矣烈祖，次于僖宫。\n燕贻凭厚，德远而隆。\n尊昭缀穆，合食惟丰。\n孝孙奠爵，福嘏来同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祫飨太庙 其十二","author":"郊庙朝会歌辞","text":"礼备乐成，祖考来格。\n有严有翼，天子孝德。\n臣工在庭，罔不祗饬。\n玉爵之华，执如弗克。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祫飨太庙 其十四","author":"郊庙朝会歌辞","text":"灵其顾思，降福来萃。\n天子受之，馂尔在位。\n神既享矣，福既均矣。\n豆斯彻矣，礼之成矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祫飨太庙 其三","author":"郊庙朝会歌辞","text":"清庙有严，观德惟祖。\n裕典时修，亲尊并序。\n以祼以献，礼交乐举。\n灵其醉止，笃我纯祐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御楼 其三","author":"郊庙朝会歌辞","text":"重城春满，双阙云浮。\n将披雉扇，载俨珠旒。\n叶风应律，文德怀柔。\n溥天率土，惠泽咸周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御楼 其二","author":"郊庙朝会歌辞","text":"青坛帝籍，在国之东。\n荐笾执耜，率礼和容。\n鸣鸾回跸，瑞气凝空。\n万方瞻仰，百顺来同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"御楼 其四","author":"郊庙朝会歌辞","text":"恩覃春煦，令布风驰。\n声名昭晰，文物葳蕤。\n重森宝扇，将降端闱。\n永光国典，翕受天祺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":