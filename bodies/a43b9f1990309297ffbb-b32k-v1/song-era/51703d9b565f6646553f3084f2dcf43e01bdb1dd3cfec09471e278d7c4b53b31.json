[{"title":"晚兴","author":"孔武仲","text":"吏退公门静，萧然似宴居。\n秋声来簟枕，晚色被庭除。\n仄径窥栖鸟，荒池听跃鱼。\n黄花恼陶令，搔首赋归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚行","author":"孔武仲","text":"客子念家意，远行投驿心。\n乱鸦争噪晚，宿鸟已归林。\n渐觉残阳尽，更忧前港深。\n云师颇知足，久久困狂霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚坐三峡桥","author":"孔武仲","text":"雨施雷音动十方，檀那奔走助津梁。\n泉舂石窦千秋白，风扫松桥六月凉。\n泼泼小鱼生处乐，溅溅馀濑静中忙。\n尘襟正欲留潇洒，坐听清音到夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚登庾楼","author":"孔武仲","text":"却从江汉望匡庐，湓口风波日愈疏。\n满瓮尚留桑落酒，登盘今有武昌鱼。\n斜阳柳色明埼岸，纤月波光湿太虚。\n鹦鹉洲前吊豪士，重将词赋为君书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅径","author":"孔武仲","text":"一径皎无尘，浓酥点烂银。\n园池晴后雪，风景腊中春。\n采蜜蜂时背，偷香蝶命屯。\n都将潇洒格，分付与诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮西道中","author":"孔武仲","text":"曾历光黄岭百寻，悲伤仆马在岖嵚。\n却思前日山行苦，未比今朝车辙深。\n恐转春风成猛雨，喜逢寒色阁轻阴。\n荒陂杳杳无人语，坐拥华貂只苦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清凉寺","author":"孔武仲","text":"白寺荒湾略舣舟，携筇来作上方游。\n何年巧匠开山骨，自古精兵聚石头。\n故垒无人空向久，高堂问话凛生秋。\n云庵快望穷千里，一借澄江洗客忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒吴传正因赠","author":"孔武仲","text":"宴坐足观妙，朝归还闭门。\n身居丞相第，室似给孤园。\n竞逐浮云驶，难揩古镜昏。\n相期荷君厚，商榷有清言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒张文思于湖西不见","author":"孔武仲","text":"绿竹阴深屋数间，篮舆来傍古溪边。\n垂杨芳草迷三径，斜日新秋媚一川。\n澎湃直连湓口浪，逍遥如泛剡中船。\n山阴不见戴安道，回首西风亦浩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鄂州","author":"孔武仲","text":"绿柳阴阴蔽武昌，汀洲如画引帆樯。\n一江见底自秋色，千里无风正夕阳。\n暂别胜游浑老大，追思前事只凄凉。\n贤豪况有遗踪在，欲买溪山作漫郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铜陵县端午日寄兄弟二首 其二 寄季毅","author":"孔武仲","text":"南北飘然各转蓬，佳辰无路笑言同。\n铜壶县冷更微雨，白鹊楼高来远风。\n粽剥雪肤明席上，酒倾玉骨映杯中。\n区区羁旅无欢笑，遥想华堂屡一烘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铜陵县端午日寄兄弟二首 其一 寄经父","author":"孔武仲","text":"柳浦移舟带雨行，奔波南北是平生。\n忽惊佳节临端午，还记当年客禁城。\n丹杏饤盘深簇火，碧醪倾盏酽堆饧。\n菖蒲角粽俱如旧，何事樽前醉不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后","author":"孔武仲","text":"万里屯云一夜收，天街累日未通牛。\n峨峨正觉严冰起，㶁㶁还同涧水流。\n色变荒郊迎日媚，气蒸黄壤逼春浮。\n农家不用藏乾面，相与新年饱麦麰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"馆中夏日","author":"孔武仲","text":"珍簟舒明玉，凉窗纳碧天。\n殿楼传远鼓，宫井取深泉。\n竹箨风频脱，榴房晚更鲜。\n却惊非故国，五月未闻蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"馆中桃花","author":"孔武仲","text":"蓬壶深绝锁方菲，初见仙桃第一枝。\n天近自应风景别，春长莫恨化工迟。\n相重朱户人稀到，半掩香苞蝶未知。\n想像江南今盛发，亦经频雨稍离披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄几道挽词","author":"孔武仲","text":"当时京右盛朋从，邂逅经旬托泮宫。\n诗社苦吟霜月白，离亭纵饮酒杯空。\n十年契阔江湖外，百岁推迁梦幻中。\n行已临民俱可述，仍高孝友古人风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄州二首 其一","author":"孔武仲","text":"客路深秋一转蓬，淮天牢落此将穷。\n城开云水苍茫处，人在茅篁掩映中。\n对岸武昌风月近，千年赤壁是非空。\n悠悠陈迹慵开口，谩把筠竿伴钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜至亭","author":"孔武仲","text":"岭路蟠蟠石似龙，亭轩更在最高峰。\n九江山水吾家近，四祖烟霞晚色浓。\n吟兴不惟誇美景，行人当为破愁容。\n前村有酒青帘远，强饮岩间水一钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游州南同文潜作","author":"孔武仲","text":"峨峨宫殿列仙居，深水方圆气象殊。\n万里舟船会京洛，几人诗酒到蓬壶。\n日斜清弄来幽谷，风定蔫红满绿芜。\n语罢恍然真梦幻，不应天邑有江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游建隆观","author":"孔武仲","text":"瑞云灵迹久荒芜，琳馆重开耸碧虚。\n邂逅马蹄过胜境，纷纭人世得仙居。\n异花重叠春辉早，乔木森阴晚景疏。\n金阙瑶台不容久，归来风驭冷襟裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游洪福寺","author":"孔武仲","text":"清晨戒童仆，匹马出皇州。\n欲探逍遥趣，因成烂漫游。\n藤萝回昼暝，云雨送春愁。\n傍近绯桃坞，寻春亦少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游凝祥池同晁无咎作","author":"孔武仲","text":"平时念京国，此地惬幽情。\n杨柳繁无路，凫鹥远有声。\n郊原斜日下，襟袂好风生。\n把酒须拌醉，还家不隔城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游籍田三首 其三","author":"孔武仲","text":"落日隐山谷，清风来户庭。\n烂柯棋已罢，伏槛酒初醒。\n归辔须长骛，都门偶未扃。\n辛勤到蓬荜，林表已华星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游籍田三首 其二","author":"孔武仲","text":"杖履重林外，樽罍曲水边。\n深荷时下鹭，乔木正嘶蝉。\n敏捷文楸战，清凉竹簟眠。\n浮瓜复沈李，况有主人贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游籍田三首 其一","author":"孔武仲","text":"酷暑不可逭，天郊聊共寻。\n云繁当飞盖，风好得披襟。\n白水田畴远，红蕖浦溆深。\n斜川陶靖节，千载想知心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘上二首 其二","author":"孔武仲","text":"南归曾泛碧湘船，击伏临流似浩然。\n平野几枯残岁草，渌波犹浸旧时天。\n簿书倥偬嗟岩邑，樽酒欢娱忆少年。\n尺水片云今我有，亦当风月为留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘中阻风","author":"孔武仲","text":"夜泊湖南岸，晓开天北风。\n愁云来覆渚，白浪起吞空。\n瓮酒霞将薄，瓶花锦带红。\n邻舟如隔海，孤坐寂寥中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘西","author":"孔武仲","text":"文园春晚病无聊，剩欲登临散郁陶。\n远野输凉来宴坐，长冈倾秀入诗毫。\n轻明物态归仙境，咫尺城闉限海涛。\n胜事满前难记忆，戏逢香草缀离骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘潭二首 其一","author":"孔武仲","text":"禄仕飘然寄楚乡，才能苦短志方强。\n已栽绿柳如彭泽，况有黄金似栎阳。\n风飐湘波天影动，云来衡岳雨声长。\n尚疑卑湿难安处，更起西边百尺堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登齐山","author":"孔武仲","text":"路出南堤思洒然，乌藤点点破苔圆。\n山腰仄塞元无路，洞底虚无别有天。\n六月清风醒客醉，千丛怪石伴僧禅。\n近人登览方为贵，从此匡庐不直钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登城","author":"孔武仲","text":"应俗虽劳甚，登高即旷然。\n日浓花覆地，春静草连天。\n竹坞连山远，湖光带郭偏。\n斯官本閒佚，吾政愧烹鲜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登涵晖亭","author":"孔武仲","text":"常时洲岛隔波澜，故觅君山直上看。\n罨画园林春减色，水晶宫阙昼添寒。\n州城斜引群峰小，湖面平吞数泽宽。\n坐久西风响乔木，扁舟思到武陵滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登湘阴北寺江亭","author":"孔武仲","text":"古县峨新刹，孤亭占上头。\n野苔侵坐绿，江水带天流。\n丝断湘灵瑟，蘋荒帝子洲。\n人寰真是梦，顷刻已千秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答元珍见赠","author":"孔武仲","text":"汴柳毵毵绿蔽河，春城旅舍数相过。\n一闻高论烦襟豁，更捧新诗雅贶多。\n清鉴欲回荆玉价，芜音难断郢人歌。\n儒林志业期千古，旧事惭君话决科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答宋履中见赠","author":"孔武仲","text":"粉袍如雪会群英，往岁曾当月旦评。\n梦想十年嗟旧事，翱翔三舍羡新荣。\n相如素擅为文丽，班固终期作史成。\n潦倒讵堪君借重，篇诗今见古人情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫极宫默轩","author":"孔武仲","text":"宴坐寂不语，先生心谓何。\n逍遥疏世味，恬淡养天和。\n一息忘言后，方知得象多。\n壶中藏日月，鼎里煮山河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"葡萄","author":"孔武仲","text":"万里殊方种，东随汉节归。\n露珠凝作骨，云粉渍为衣。\n柔绿因风长，圆青带雨肥。\n金盘堆马乳，樽俎为增辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蛤蜊","author":"孔武仲","text":"去年曾赋蛤蜊篇，旅馆霜高月正圆。\n旧舍朋从今好在，新时节物故依然。\n栖身未厌泥沙稳，爽口还充鼎俎鲜。\n适意四方无不可，若思鲈鲙未应贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢彦成子侄四人同时登科调官南归","author":"孔武仲","text":"处士好孙子，秘书贤弟兄。\n弓旌万里会，兰玉一家荣。\n盛事酬先志，清风警后生。\n田园何足道，力学是功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道中观荷花","author":"孔武仲","text":"放棹东南去，正值荷花荣。\n玉质不待染，仙香无限清。\n朱朱仍白白，脉脉复盈盈。\n迢递天风起，谁怜舞态轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"韩公祠堂","author":"孔武仲","text":"曾持金节抚淮壖，磊落英姿正少年。\n万里风鸿看振翼，一时毫素冠凌烟。\n新祠更慰舟人望，遗像仍从幕客传。\n精爽威容俱不泯，今骑箕尾在青天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楸花","author":"孔武仲","text":"淡薄已无俗，秋高真出群。\n峨峨揭翠藻，漫漫缀红云。\n远色天街尽，馀香省户闻。\n狂风晓来剧，惆怅落纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"筠州张氏追远堂","author":"孔武仲","text":"惨淡佳城侧，穹隆百尺堂。\n岁时如过隙，松柏已成行。\n玉笋登盘美，琼醅入奠香。\n英灵似明月，时到此山傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"辞二妃庙","author":"孔武仲","text":"盘空乌鹊噪丛祠，船上行人半起时。\n残月朦朦倾岛屿，南风袅袅透旌旗。\n开帆便欲日千里，别庙仍浇酒一卮。\n岸芷洲兰俱可荐，新声翻入九歌词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鄢陵界中","author":"孔武仲","text":"古县居人少，归轩喜气多。\n连天皆秫黍，盖水有莲荷。\n宿雨云容薄，微风日气和。\n征行不辞远，所得是吟哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉鱼界中作","author":"孔武仲","text":"楚泽秋穷未有霜，飘然如雁去随阳。\n连空积蔼湖天闇，极目无人水国荒。\n破浪不须论万里，佩兰聊欲寄三湘。\n驼裘更作春晖暖，嬴得瞢腾昼梦长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"榴花分题","author":"孔武仲","text":"东京石榴好，几处照楼台。\n秀色裙难学，幽香蝶不来。\n连枝成幄幕，著子尽琼瑰。\n乞取当窗种，年年四季开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翠微亭","author":"孔平仲","text":"蜡屐萦纡洞府间，飞甍人在最高巅。\n青山东去无馀地，黄潦西来正接天。\n太子池塘烟漫漫，紫微踪迹草芊芊。\n松枯石朽由来事，莫作常情叹逝川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题上蔡驿","author":"孔武仲","text":"驻马东门己夕阳，淡云衰草意何长。\n当年公子牵黄犬，此地春风吹白杨。\n千岁只疑经旦暮，一城犹可鉴兴亡。\n我来不独嗟行役，览古依然为闵伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题山光楼","author":"孔武仲","text":"山静围平野，楼高映碧空。\n人居仙岛曲，天入画屏中。\n倚槛云蟾近，倾觞客兴同。\n扁舟期一到，须借五湖风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题介之小阁","author":"孔武仲","text":"画帘初卷碧山低，面面青蓝翠拂衣。\n秋水暮天长一色，渚鸥沙雁或双飞。\n烟霞逗眼光相乱，松竹敲风韵更微。\n却笑屈原憔悴甚，渔歌何苦泪交挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题光山驿壁","author":"孔武仲","text":"跨县连州几叠山，为君题作小潼关。\n江湖不得长耕钓，尘土胡为屡往还。\n渐入长郊趋坦荡，却从平地望孱颜。\n何当轻骑重登险，指点湓城夕照间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠子通","author":"孔武仲","text":"金石论交古所希，朱颜相结少年时。\n自嗟龌龊逢人少，尤喜轩昂出众奇。\n文字往来谐律吕，笑谈错杂和埙篪。\n近闻俗语多谗间，愿子高歌锦与箕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠长沙僧守节","author":"孔武仲","text":"花木重重鹿苑春，萧然一室坐安贫。\n真乘但要心知法，喜舍无如药济人。\n增损诸方精古义，窥寻六脉妙通神。\n长沙旅泊无聊赖，诗乞刀圭养病身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠梦符朝议","author":"孔武仲","text":"人笑公衣不浣濯，我惮公心霜雪明。\n青衫仕宦有真气，白首乡闾无恶声。\n相逢回首又再岁，暂去还来观太平。\n何事南归太果决，萧然远作玉溪生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠程瑰","author":"孔武仲","text":"识尽公卿更食贫，苍髯瘦骨走京尘。\n高谈亦与时多忤，屡中方知术有神。\n前会渺茫浑不记，远游萧索复相亲。\n疑公别得壶中趣，回首人间二十春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五老峰","author":"孔武仲","text":"峻叠起青峰，森然五老翁。\n云将色共古，天与寿无穷。\n突兀巅崖峭，骈罗面势雄。\n三光同孕育，四岳是儿童。\n杰立层霄际，曾经坏劫中。\n梦龄应可锡，图写献尧宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王文玉出清溪图以示坐客","author":"孔武仲","text":"舟在此溪滨，披图看愈亲。\n须知堂上客，便是画中人。\n潇洒苍葭映，舂容碧浪春。\n秀山旁发派，秋浦净为邻。\n飞鹭来窥影，游鱼可数鳞。\n饮阑须卷去，聊以辟京尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白公草堂","author":"孔武仲","text":"达士因忘世，非求高尚名。\n林泉得佳处，风物有馀清。\n贝锦伤谗舌，浮云寄宦情。\n诗才今古备，性理死生明。\n莲沼秋芳合，香山晚翠横。\n黄芦绕官舍，不复念青城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同赋京尘","author":"孔武仲","text":"白日临黄道，红尘满玉京。\n长风吹不尽，骤雨洒还清。\n不放虚空快，应同世界生。\n随时势用壮，度隙体能轻。\n舞榭凝添恨，歌梁堕趁声。\n沧浪归有计，行矣濯吾缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同赋虎帧","author":"孔武仲","text":"何事斑然虎，来依静者堂。\n英姿犹詟物，画手必殊常。\n快笔挥如雨，新缣洗似霜。\n浅山迎暮黯，丛苇得秋黄。\n炳焕霞纹缛，晶荧镜目光。\n前趋疑抟取，却顾尚摧藏。\n仙子休骑去，将军莫射伤。\n相随千里客，更欲卷还乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同赋蚊","author":"孔武仲","text":"生长虽微细，翾飞逐盛阳。\n吾身非铁石，尔觜太铦刚。\n戢戢朝藏壁，喧喧暮满房。\n灯前已环绕，檐角尚悠扬。\n纱眼能缘过，冰肤亦噬伤。\n用心均货殖，损物亚螟蝗。\n栖宿么虫巧，追擒蝙蝠忙。\n秋风动天地，尔辈更凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"坤成节南宫赐宴","author":"孔武仲","text":"盛德千龄会，坤成四海观。\n南琛走交趾，北赆引呼韩。\n紫极经躔近，文昌步武宽。\n横天起嵩华，照地集琅玕。\n美酒来天禄，珍殽赐大官。\n炉烟凝栋宇，冰雪袭杯槃。\n瞻拜戎心服，山呼士气欢。\n风清百尺庑，花压两梁冠。\n雷作闻挝鼓，猱升看戏竿。\n华裀舒雾霭，妙舞起波澜。\n乔木秋声远，高城夕照残。\n天街淡佳气，振鹭杳归翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸葛武侯","author":"孔武仲","text":"天下军书动，西南霸气偏。\n太公谋国妙，伊尹佐时专。\n季汉基还立，强吴势外连。\n兵从新节制，志复旧山川。\n霜肃关中晚，春浮渭上天。\n恩威人并附，将相器俱全。\n丑虏羞巾帼，遗音被管弦。\n妖星如不堕，功业管箫前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雪十韵","author":"孔武仲","text":"此夜不成雪，明朝应作霖。\n细声来户牖，爽气入裯衾。\n窥隙疑相射，循檐觉更深。\n因风成倒阵，过竹有馀音。\n画阁迷钗玉，旗亭付酒金。\n封漫碧涧曲，点缀假山岑。\n鹤氅行何丽，牛衣卧不任。\n渔罨平易失，樵径浩难寻。\n却赴明光贺，潜追霢霂吟。\n天街立马望，双阙正球琳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":5152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]