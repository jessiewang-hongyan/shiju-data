[{"title":"夏旱四首 其三","author":"刘克庄","text":"吾闻曲礼当凶岁，诸大夫安敢食粱。\n婢臛香芹羹过美，水车声畔不能尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏旱四首 其二","author":"刘克庄","text":"蛟潭雩祀稀曾讲，蟹井灵泉亦未迎。\n代拜烦它村祝叟，愿丰误杀老书生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏旱四首 其一","author":"刘克庄","text":"沟堪揭厉难车水，雨怕讥征不入城。\n沃野燥刚妨种艺，老农歌哭不成声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"席间即事","author":"刘克庄","text":"急召传来主第中，孙郎上马鼓三通。\n山人无复金莲梦，稳听琵琶到曲中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐偃王庙","author":"刘克庄","text":"仁暴由来各异施，秦徐至竟孰雄雌。\n君看骊岫今无墓，得似柯山尚有祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽陈孺人","author":"刘克庄","text":"隐衣先自著，舂具亦同操。\n不但鸿高节，鸿妻节更高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓意","author":"刘克庄","text":"鸦啼曙色尚朦胧，惊起山房梦蝶翁。\n始悟区区大槐里，不如栩栩乱花中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桐庐","author":"刘克庄","text":"桐庐道上雪花飞，一客骑驴觅雪诗。\n亦有扁舟蓑笠兴，江行却怕子陵知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桐庐舟中即事","author":"刘克庄","text":"车前弯帽同声散，关外华簪一揖休。\n惟有浙江潮好事，肯随逐客到严州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桥西","author":"刘克庄","text":"昔饮桥西岁月多，梨花深处待郎过。\n垂鞭欲访湔裙约，奈此萧萧鬓雪何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浯溪二首 其二","author":"刘克庄","text":"形容唐事片言中，元子文犹有古风。\n莫管看碑人指点，写碑人是太师公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浯溪二首 其一","author":"刘克庄","text":"上置书堂下钓矶，漫郎陈迹尚依稀。\n无端一首黄诗在，长与江山起是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠七首 其七","author":"刘克庄","text":"地行臣耄矣，稽首告天公。\n藉草千场醉，留花十日红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠七首 其六","author":"刘克庄","text":"恰见如丹粒，俄惊似紫绵。\n山翁无供帐，只就落花眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠七首 其五","author":"刘克庄","text":"神女漂红者，颠姨发赤然。\n年年吹洗了，未必恕今年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠七首 其四","author":"刘克庄","text":"一种秾纤态，三郎未必知。\n浪将妃子比，妃子太浓肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠七首 其三","author":"刘克庄","text":"莫惜千银烛，频添两玉瓶。\n不须擂羯鼓，花睡未曾醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠七首 其二","author":"刘克庄","text":"范公蜀西曲，陆老剑南诗。\n子美渠曾道，渊材辈岂知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠七首 其一","author":"刘克庄","text":"蜀女羞施粉，轻装爱淡红。\n抹涂尚年少，膏沐为谁容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涑水","author":"刘克庄","text":"洛下人呼为迂叟，非惟语简意无穷。\n曲台不合加美谥，俗了深衣大带翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留山间种艺十绝 其八 笑花","author":"刘克庄","text":"春风满面喜津津，纵有嗔拳不忍嗔。\n尚恐傍观安注脚，笑他何事与何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留山间种艺十绝 其二 菊","author":"刘克庄","text":"羞与春华艳冶同，殷勤培溉待秋风。\n不须牵引渊明比，随分篱边要几丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留山间种艺十绝 其一 梅","author":"刘克庄","text":"鄙事关人智浅深，漆堪成器楮堪衾。\n自怜到死犹迂阔，纯种梅花作墓林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留山间种艺十绝 其三 松","author":"刘克庄","text":"一生著数落人先，白发栽松故可怜。\n待得伏菟堪采掘，此翁久矣作飞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留山间种艺十绝 其七 柚","author":"刘克庄","text":"两树亭亭藓砌傍，未论包贡奉君王。\n世无班马堪薰炙，且嗅幽花亦自香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留山间种艺十绝 其四 兰","author":"刘克庄","text":"萧艾敷荣各有时，深藏芳洁欲奚为。\n世间鼻孔无凭据，且伴幽窗读楚辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留山间种艺十绝 其十 芭蕉","author":"刘克庄","text":"搅醉妨眠挟雨声，碧丛宜看不宜听。\n而今一任萧萧滴，华发鳏翁彻夜醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留山间种艺十绝 其五 桃","author":"刘克庄","text":"岁岁春风花覆墙，摘来红实亦甘香。\n当时若种瑶池本，却恐河清未得尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留山间种艺十绝 其九 末利","author":"刘克庄","text":"一卉能令一室香，炎天尤觉玉肌凉。\n野人不敢烦天女，自折琼枝置枕傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留衣庵","author":"刘克庄","text":"老子今年五十三，诸方参了又重参。\n谁能远礼文殊佛，且访颠师海上庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中杂兴五言十首 其十","author":"刘克庄","text":"跌荡四千首，流行宇宙间。\n国风几曾熄，圣笔不能删。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中杂兴五言十首 其九","author":"刘克庄","text":"向来春帖子，残膏罥蛛丝。\n无复秦郎思，聊吟党进诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中杂兴五言十首 其八","author":"刘克庄","text":"柳七葬淮头，营妓岁沥酒。\n不知花翁坟，有人擘纸否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中杂兴五言十首 其七","author":"刘克庄","text":"蒙叟云聃死，当时有吊宾。\n始知关尹子，迂诞诳愚人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中杂兴五言十首 其六","author":"刘克庄","text":"佛以灭为乐，观身等一沤。\n如何卢行者，镕铁护枯髅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中杂兴五言十首 其五","author":"刘克庄","text":"鳌顶来差晚，龙髯去莫攀。\n不能从襄野，只合殉桥湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中杂兴五言十首 其四","author":"刘克庄","text":"李广飞将军，世南行秘书。\n乃知数寸管，不及丈二殳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中杂兴五言十首 其三","author":"刘克庄","text":"乌寺迎岩主，螭坳起涧翁。\n也须留几个，相伴听松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中杂兴五言十首 其二","author":"刘克庄","text":"皓素应难染，玄纁未易迎。\n只宜大床卧，或命小车行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中杂兴五言十首 其一","author":"刘克庄","text":"铁笔俱牵动，金台总去登。\n老僧不出院，挂起一枝藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病后访梅九绝 其三","author":"刘克庄","text":"区区毛郑号精专，未必风人意果然。\n犬彘不吞舒亶唾，岂堪与世作诗笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病后访梅九绝 其八","author":"刘克庄","text":"春信分明到草庐，呼儿沽酒买溪鱼。\n从前弄月嘲风罪，即日金鸡已赦除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病后访梅九绝 其九","author":"刘克庄","text":"菊得陶翁名愈重，莲因周子品尤尊。\n后来谁判梅公案，断自孤山迄后村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病后访梅九绝 其二","author":"刘克庄","text":"先生岁晚被人疑，梅畔浑无一字诗。\n明月清风愁并案，野花啼鸟怕随司。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病后访梅九绝 其五","author":"刘克庄","text":"老子无粮可禦冬，强鸣饥吻和寒蛩。\n舍南舍北花如雪，止咽清香饱杀侬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病后访梅九绝 其一","author":"刘克庄","text":"梦得因桃数左迁，长源为柳忤当权。\n幸然不识桃并柳，却被梅花累十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病后访梅九绝 其六","author":"刘克庄","text":"与梅交绝几星霜，瞥见南枝喜欲狂。\n便欲佩壶携铁笛，为花痛饮百千场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病后访梅九绝 其四","author":"刘克庄","text":"和靖林间欬嗽时，一边觅句一边饥。\n而今始会天公意，不惜功名只惜诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起","author":"刘克庄","text":"病起登楼怯晓风，爱他残雪映前峰。\n傍人休问何郎瘦，不见梅花过一冬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起","author":"刘克庄","text":"不求玉杵杵，不要水银银。\n但祝未来世，长为无病人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起窥园十绝 其六","author":"刘克庄","text":"久匣菱花懒一窥，都忘挟弹洛阳时。\n若非病起临池水，白尽须眉不自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起窥园十绝 其七","author":"刘克庄","text":"病来岂有力迎缓，耄及已将家付康。\n干蛊久劳小儿子，探丸未遇大医王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起窥园十绝 其十","author":"刘克庄","text":"云里金乌瞥见些，屋山鹊语亦查查。\n侵晨扫径开篱户，童子知翁出看花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起窥园十绝 其九","author":"刘克庄","text":"花外小车时出游，有佳风月亦登楼。\n水晶宫与人间相，把乞先生未点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起窥园十绝 其四","author":"刘克庄","text":"一阵狂风吹彩云，猩红万点落缤纷。\n人间无处堪翻诉，说向天公似不闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起窥园十绝 其一","author":"刘克庄","text":"夜起饭牛薄暮舂，古人既老始明农。\n残年尚欲勤东作，未肯将身旁瘦筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起窥园十绝 其五","author":"刘克庄","text":"经月龙钟少下床，土花上壁笋穿墙。\n不知老去无筋力，犹自支吾探海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起窥园十绝 其二","author":"刘克庄","text":"谬叨虚奖每惭颜，奇字新经未一斑。\n除却骑驴搜句外，了无些子似钟山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起窥园十绝 其三","author":"刘克庄","text":"青帝施恩野老家，分张红白乞年华。\n安知巽二无斟酌，吹尽先生一架花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离郡五绝 其一","author":"刘克庄","text":"自伤临郡浅，有愧在民深。\n稽首文公庙，由唐直至今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离郡五绝 其四","author":"刘克庄","text":"赫赫戎衣定，区区扣马非。\n如何孤竹子，嫌粟不嫌薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离郡五绝 其三","author":"刘克庄","text":"昨日专城守，今朝失国人。\n乾坤如许大，无地著孤臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离郡五绝 其二","author":"刘克庄","text":"既收其印绶，犹送以车船。\n回首柱下史，江边更可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离郡五绝 其五","author":"刘克庄","text":"丘笔郑克段，轲言象爱兄。\n回天力不足，削地罚犹轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秦纪","author":"刘克庄","text":"土广曾吞九云梦，民劳因起一阿房。\n人皆怜楚三户在，天独知秦二世亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秦城","author":"刘克庄","text":"缺甓残砖无处寻，当年筑此虑尤深。\n君王自向沙丘死，何必区区戍桂林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杂咏一百首 其三十三 荷蓧丈人","author":"刘克庄","text":"客云自孔氏，不觉喜逢迎。\n止宿见二子，孰云无世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莲社图","author":"刘克庄","text":"但见篮舆出，安知酒榼空。\n老僧翻折本，收不得陶公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莺梭","author":"刘克庄","text":"掷柳迁乔大有情，交交时作弄机声。\n洛阳三月春如锦，多少工夫织得成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莺粟","author":"刘克庄","text":"初疑邻女施朱染，又似宫嫔剪綵成。\n白白红红千万朵，不如雪外一枝横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蚋","author":"刘克庄","text":"蚓穿槁壤及黄泉，蜂采花房与柳绵。\n微蚋么么殊嗜好，以醯为蜜瓮为天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸侯客","author":"刘克庄","text":"犬吠鸡鸣者，皆为席上珍。\n如何弹铗客，亦有窃弓人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诸家牡丹已谢小圃忽开两朵皆大如斗戏题二绝 其二","author":"刘克庄","text":"踏青人被色香迷，击壤翁看蓓蕾知。\n漏籍谱中无可恨，花开殿后未为迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读本朝事有感十首 其十","author":"刘克庄","text":"愈作唐经还蓄缩，邕知汉事谩喽啰。\n假令实录成书了，其奈雍丘问目何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读本朝事有感十首 其九","author":"刘克庄","text":"翻来覆去几枰棋，靖国崇宁各一时。\n前日雕笼栖宿者，等闲飞过蔡家池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读本朝事有感十首 其八","author":"刘克庄","text":"垂帘复辟身俱稳，送吕迎章话又新。\n瞒得庭中相泣者，难瞒屏后窃听人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"述志","author":"程公许","text":"仙曹寄江干，吏隐适吾愿。\n西轩馆梅友，屋老狸鼠觇。\n坐令高世姿，不耐尘网罥。\n殷勤数问讯，馀力稍营缮。\n八窗敞虚明，孤标对老健。\n伫立惨澹中，恍觉容采绚。\n天风发奇芬，霜月泼冷艳。\n官卑苟逃责，交淡日相见。\n冻摇哦诗吻，坚作忍饥面。\n痴顽信可怜，无取复奚羡。\n村醪未必佳，苦味且耐咽。\n洗盏寿亲尊，春和元不欠。\n勿竞桃李场，恐为吾友玷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读本朝事有感十首 其五","author":"刘克庄","text":"师道在三乌可畔，友伦居五岂容亏。\n恰方誉瓘俄倾瓘，亦有尊颐不救颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读本朝事有感十首 其四","author":"刘克庄","text":"非独苏仙念老穷，古灵亦复荐孤忠。\n白头不得诸公力，惟有西塘八十翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]