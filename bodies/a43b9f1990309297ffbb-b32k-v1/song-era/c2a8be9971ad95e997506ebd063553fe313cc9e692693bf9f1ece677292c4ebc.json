[{"title":"怒成","author":"华岳","text":"舌端豪气吐长虹，四海一身无处容。\n不向北山求刺虎，便从南海学屠龙。\n鼎须刘辟方成器，剑到魏齐那是锋。\n欲抱不平朝玉帝，梦魂飞上祝融峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怒题","author":"华岳","text":"壮气横秋面渥丹，男儿未遇指休弹。\n卖浆岂料周分国，盗粟焉知汉筑坛。\n胫脡未甘缠吏鞅，髑髅不信误儒冠。\n夜深踢起床头婢，和泪挑灯把剑看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思故人","author":"华岳","text":"十载无人问益之，谁于欬唾觅珠玑。\n两三千里家何在，三十六峰人未归。\n将谓抱薪能救燎，果然画饼不充饥。\n东川恐遇连荣祖，一笑不须论是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思故人","author":"华岳","text":"太乙年来落冀并，几多豪杰未成名。\n尧天日月计和玉，胡地山川知耀卿。\n卢六驱风能破屋，陈三平水可倾城。\n年来幕府勤延揽，何事诸兄未有声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拜茶","author":"华岳","text":"北苑春将半，星槎欲奏功。\n杵鸣千臼雪，鎗卷一旗风。\n盝锦鹦毛翠，签罗象眼红。\n封成拜玄鹤，飞上紫微宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日书怀","author":"华岳","text":"紫褪红销到海棠，几多游侠为渠忙。\n秋声落盏莺调曲，春色恼人花斗香。\n羝乳虽能屈苏武，牛衣终不卧王章。\n男儿多少英雄气，只对东风醉几场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春郊即事","author":"华岳","text":"东风吹动绮罗尘，翠盖红缨处处新。\n蝶翅拍开千树雪，莺声催老十洲春。\n人生有酒须行乐，吏禄无阶且食贫。\n归客不须笼画烛，醉和明月上雕轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春郊即事","author":"华岳","text":"东风吹不断轮蹄，处处鞦韆环佩飞。\n剪翠弄妆归髻掠，乱红翻锦上屏帏。\n花应笑我春尝醉，燕解嘲人夜不归。\n莫怪逢春太娱乐，人生能有几芳菲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春游有感","author":"华岳","text":"上苑春工到海棠，老夫随分为春忙。\n朱弦转枕莺催拍，红粉倚栏花斗妆。\n吾道几时曾损益，人心今日自炎凉。\n愿言相约花前醉，一听儿童号酒狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春愁","author":"华岳","text":"十日春愁不出门，出门春事已消魂。\n摘花掀帽倩人插，索酒得杯和月吞。\n啼鸟声中近寒食，落花阴里又黄昏。\n春来春去总休问，往事悠悠付一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春述怀","author":"华岳","text":"买春无计托花神，费尽榆钱不计缗。\n风絮飞成三径雪，雨犁翻动一园春。\n有心报国从招祸，无相封侯莫怨贫。\n试问专坛与分社，予何人彼亦何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"狱中作","author":"华岳","text":"壮士刚肠不受冤，髑髅可断志难干。\n越仇未报薪当卧，汉贼犹存铗谩弹。\n情款不从囚口责，炙浆难塞吏肠宽。\n何当尽沥奸邪血，染作衣裳看孟安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"狱中责廷尉 其二","author":"华岳","text":"吾巾不是不冠儒，曾被儒冠几误予。\n铁砚不磨天地轴，毛锥难复帝王居。\n当传卫霍无传秘，却著韩曹不著书。\n堪笑苍生无眼力，不知豪杰在樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋宵有感","author":"华岳","text":"满目秋容拂画图，败荷衰柳接平芜。\n西风刮地雁声落，寒月满天人影孤。\n木耳有才持紫橐，楮皮无计换青蚨。\n不知此去功名事，还许封彝见也无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晚即事","author":"华岳","text":"秋宇清如洗，秋宵分外长。\n寒鸡鸣午夜，征雁唤重阳。\n枫叶已全赤，菊花才半黄。\n不知秋几许，试与问苏郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晚述怀呈薛子长","author":"华岳","text":"一瓮香醪一曲琴，得相寻处且相寻。\n杯宽却怪青山小，坐久不知黄叶深。\n当路星轺已钳口，异乡风物更关心。\n何时系艇秋江上，醉卧芦花雪满襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋望有怀","author":"华岳","text":"片云如雨卷西风，绰尽遮阑眼力雄。\n远水半连晴汉碧，暮霞全借夕阳红。\n姓名未得联诸子，鬓发皤然已一翁。\n欲识翠微诗外意，岂徒忧国愿年丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋意","author":"华岳","text":"木剪空山瘦，西风扫落黄。\n荷残簪失盖，菊老饼还香。\n诗尽情尤阔，愁多夜更长。\n闷怀无处著，随雁落潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贵池秋晚","author":"华岳","text":"暮色千林薄，秋空万里长。\n寒蝉鸣晚树，归棹发斜阳。\n水远天同碧，风高叶脱黄。\n星星老蓬鬓，不觉到潘郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺赵丞登第","author":"华岳","text":"要与宗盟立纪纲，俯从多士较文章。\n人材漏网无疏密，科目搜罗有短长。\n蟾窟一枝分玉树，凤池三浪出银潢。\n何当推解延豪杰，为复中原万里疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李子方","author":"华岳","text":"乱云推月上层楼，楼上朱帘不下钩。\n鸡翅拍开朱户锁，雁声唤上木兰舟。\n黄花撚酒留人醉，红叶题诗倩水流。\n李广不侯人不笑，笑他人作烂羊头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送周魁","author":"华岳","text":"昨夜霜风鼓万兵，今朝华节照边庭。\n人间元日是春日，天上魁星为使星。\n且向虎囊探寸尺，却归麟阁仿丹青。\n离觞不是延清夜，明日异邦长短亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵右秋 其二","author":"华岳","text":"闽藩齐指右参军，玉骨清无半点尘。\n一味恤刑常召祸，十年游宦只忧贫。\n圜扉月照金波夜，寒谷花开玉树春。\n客子与君虽素昧，一时聊记子张绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送赵右秋 其一","author":"华岳","text":"梅花飞雪满霜洲，洲上行人去莫留。\n蜡炬结花催管籥，雁声唤客上兰舟。\n莫嫌冰炭情难入，自是薰莸味不侔。\n执节从教少知遇，勿于世路学沉浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送倪尚书归霅川","author":"华岳","text":"笔麟图凤久无声，何事权舆复见今。\n鲁祭不因夫子肉，齐卿难夺孟轲心。\n我公去就何为重，吾道兴亡所系深。\n安得斯文天未丧，载歌狼跋继遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送倪尚书赴召","author":"华岳","text":"守节如初未足观，毫釐终始实其艰。\n郑公勇却枢衡贵，卫叔羞居荷橐班。\n冷暖万端炊饭顷，是非一著弈棋间。\n江湖无限孤高客，拭目看公此召还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜 其二","author":"华岳","text":"吴钩不是怒鲸鲵，夜半刘琨屡舞鸡。\n十载载春游太学，二年年夜宿圜扉。\n楚盘未必资毛遂，周粟如何饱叔齐。\n尘世功名傥来尔，无言桃李自成蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜 其一","author":"华岳","text":"才辱东皇造化工，便随飞鹊报帘栊。\n人间狴犴知无所，天上蓬莱还有宫。\n酒色半澄春后绿，蜡花全折夜来红。\n从今泰道能连茹，愿驾苍蟠跃震风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜大雪丙寅除夜得春，瑞雪大作，时有襄淮之衄，因记夜半入蔡之事，使人振腕不寐。时在建三除夜矣","author":"华岳","text":"青帝明朝下玉京，先教滕六掩车尘。\n梅花笑我三年腊，椒叶争他一夜春。\n乌角触檐鞭堕玉，马蹄印路椀抛银。\n何当夜缚吴元济，去作中兴社稷臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"借景楼","author":"华岳","text":"朱箔钩新月，平阑架落霞。\n百钱呼酒炙，四壁听笙笳。\n翠映谁家竹，香飘何处花。\n功名未归我，且此寄生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"倪尚书生祠","author":"华岳","text":"闻说先生入建都，一年民乐吏清癯。\n四厢夜月封朱户，两院春风锁翠芜。\n一旦有书追驷马，万冤无计彻群乌。\n焚香再拜祝公寿，问有清朝赏罚无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"套筒","author":"华岳","text":"作个咿?赘项咽，个中和我万愁牵。\n一筒作柄箫无窍，双铁为圜扇有圈。\n身拜却疑人是犬，手擎还类笔如椽。\n从今节节能通气，安得当为积蓄钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"容膝","author":"华岳","text":"具体功非远，全躯恨已消。\n安禅须促膝，觅句敢成摇。\n悔不身齐足，时当事半腰。\n行人只蒲伏，何处得逍遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽吴夫人","author":"华岳","text":"鸾骖不是厌尘凡，王母瑶池促驾还。\n家在两三千里外，人生一十六年间。\n好随神女游舒水，难伴文君归蜀山。\n试向仙源问消息，桃花零落水潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽戚虚中","author":"华岳","text":"梦里匡庐兴未阑，转头世事已辛酸。\n肥家有术疑非药，漉酒从人笑不冠。\n雁序向人群已失，凤雏过眼影何单。\n不堪回首原头路，一坞松楸生暮寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"捉月仙","author":"华岳","text":"缆解西风拍岸颠，雁拖秋色上航船。\n挂帆未作乘风客，举棹先惊捉月仙。\n楚些有渊心石殒，贺狂无井眼花眠。\n慇勤为酹一杯酒，断送西江浪拍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浦城买舟","author":"华岳","text":"微雨催行旆，西风送客舟。\n菊□□□□，□□□□□。\n浪激花翻雪，山涵影浸秋。\n前滩□□□，□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"热","author":"华岳","text":"翠微家在大江东，五月鞭驴入建中。\n云烈火车天欲雨，汗淹香葛扇无风。\n不求殿阁千间庇，却喜岩泉一线通。\n为汲满盂清齿颊，与君行尽夕阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酒楼秋望","author":"华岳","text":"西风吹客上阑干，万里无云宇宙宽。\n秋水碧连天一色，暮霞红映日三竿。\n花摇舞帽枝犹软，酒入诗肠句不寒。\n古往今来恨多少，一时收拾付杯盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"华岳","text":"一别京华近十年，此心无日不悠然。\n嗅梅得句天然巧，把酒开怀地自偏。\n铁砚不须兵十万，铜盘何用客三千。\n功名自有风云会，不遇风云毋自煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿水陆寺","author":"华岳","text":"萧寺廊庑阔，无人独自行。\n吴侬非好僻，楚客为谁清。\n花落凭风扫，灯残借月明。\n江湖有烟浪，且此寄馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿横溪桥","author":"华岳","text":"夜宿横溪烟霭间，眉头归路万山攒。\n连天麦浪波千顷，扑地杨花雪一团。\n馀镪不供春后酝，夹衾犹怯夜来寒。\n征夫莫怪车音涩，自是愁多行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄小王徐子晋","author":"华岳","text":"十载长沙路二千，归心日夜在长安。\n居家有誉眉空白，恋阙无谋心谩丹。\n获雁不闻苏子信，沐猴徒笑楚人冠。\n马蹄恐有唐城便，为把功名问二潘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄王士贵","author":"华岳","text":"画桥相送百花春，转眼孤鸿逐断云。\n别后有谁能顾我，客中无日不思君。\n风前花影尝兴念，月下桐声久不闻。\n见说近来多好况，一书无惜寄云云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄王清之","author":"华岳","text":"封书汉上寄清之，却恐清之汉上归。\n千里谩怀明月共，寸心常伴白云飞。\n湘妃有泪能斑竹，周士无心恋采薇。\n安得一缄飞海峤，与兄联辔上淮淝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄卢进士","author":"华岳","text":"丈夫策定在吴钩，浪把桥门作胜游。\n綵笔误人随骥尾，锦标还我占鳌头。\n关山梦寐三千里，竹帛功名四十秋。\n安得九重容借箸，尽将军国为前筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄刘浩然","author":"华岳","text":"樽酒檠窗鬓发新，别来惊见雪霜侵。\n几行泪滴风前烛，一片心敲月下砧。\n好德未闻如好色，知人安得似知音。\n一书欲寄南来雁，江阔天高无处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄江子岗","author":"华岳","text":"秋夜封书上子岗，别来化日又舒长。\n只知电烛两经月，不觉星毛半欲霜。\n竹叶照人凝盏滑，梅花撩客透篱香。\n知他诗债曾偿未，料得寻春日日忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄西山","author":"华岳","text":"姓名久不到西山，觅便无风鼻谩酸。\n天堑有花春堰急，地炉无火夜堂寒。\n青灯昔记对床卧，白发今羞把镜看。\n见说北归常有雁，一书无惜报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄西山","author":"华岳","text":"宫墙无地可穿窬，犹幸先人有敝庐。\n仕版可羞宁毁瓦，儒冠曾误枉收书。\n供柴我合同收炭，寄食君当自办蔬。\n此理晓然明似镜，何须足下肆耕锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄两庠同舍","author":"华岳","text":"昔年槌鼓扣天阍，远谪南州七度春。\n大享有恩来北阙，小囚无赂脱东闽。\n乌衣座满民流血，画烛帘深案积尘。\n见说九重宵旰虑，长沙犹有少年人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄张舍人","author":"华岳","text":"万冤无计彻天衢，三尺金科谩卷舒。\n公不戴星驰驷马，民将指日就枯鱼。\n黄堂宴妓不加意，丹陛虑囚空有书。\n见说群乌广瞻听，如何公论尚踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄杨渭夫","author":"华岳","text":"自愧材猷不足观，独于忠义死难干。\n二陵风雨谁思汉，万里腥膻谁报韩。\n眼到北盟常揾血，话残南渡欲冲冠。\n如何一代多人杰，稽首称藩鼻不酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄陈士元","author":"华岳","text":"郊野英雄不肯收，膏粱刍豢有何谋。\n胡儿只怒马黄弩，公子当求狐白裘。\n唐诏屡颁蕡不第，汉坛才筑信当侯。\n古今得丧同儿戏，何必区区叹白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄苕溪故人","author":"华岳","text":"昔年分袂霅川东，系马花梢扑乱红。\n解佩送行情怏怏，举杯言别恨匆匆。\n中人以上谁知我，北斗以南惟有公。\n此去东闽有良便，一书无惜慰羁穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悉事","author":"华岳","text":"欲归未去两纷拿，何事回天力未加。\n九牧谁为十羊主，百冠当念一人髽。\n肘边有石心虽切，腰下无钱手谩叉。\n千万有人逢伯乐，为言龙种尚盘车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅","author":"华岳","text":"一年无处觅春光，杖策寻春特地忙。\n墙角数枝偏冷淡，江头千树欲昏黄。\n梢横波面月摇影，花落樽前酒带香。\n更仗西湖老居士，为予收拾付诗囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祷梅山","author":"华岳","text":"许我登龙尚未还，作诗更为谒梅山。\n如何威惠推千载，犹使英雄困八蛮。\n神不提身归虎帐，鬼须擘口动龙颜。\n聪明傥为扶宗社，愿借风雷顷刻间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祷富沙","author":"华岳","text":"十年踪迹淖泥沙，为炷灵香祷富沙。\n万里无由诣霜阙，一书聊欲为星槎。\n解骖许我来齐晏，释缚从君问左车。\n他日横飞上麟阁，行祠当为建京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野饮呈祝山甫","author":"华岳","text":"野景何须买，山花不待培。\n幕天分古木，裀地得苍苔。\n酒上莺调曲，肴空鹊堕梅。\n一壶随所适，何处问蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪","author":"华岳","text":"天低江阔水连天，上下周回一色兼。\n扑雀猎鹰翻白缟，得鲈渔父指青帘。\n马抛玉勒珑?落，狮欠金铃橘柚添。\n得句莫嫌呵冻笔，明年岁事已堪占。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中有戏","author":"华岳","text":"一夜风神揭海神，尽将纯素掩丹青。\n四围白壁成千嶂，万里红尘没一星。\n搭岸柳条横玉带，压墙梅萼上银屏。\n好将今日平淮策，说与当年李愬听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中呈刘子冲","author":"华岳","text":"朔风卷水入天渠，剪作飞花散六虚。\n竹本无声缘叶密，梅因有影怕花疏。\n路从玉鉴上头过，家在冰壶里面居。\n欲作一诗撩谢女，不知为况近何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄氏三层楼","author":"华岳","text":"瘦筇支我上高寒，风露凄清酒力悭。\n千里人邀千里月，一重楼见一重山。\n筵前飞雪喷焦遂，槛外行云遏小蛮。\n便好翻身驾黄鹄，直将情枉扣天关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"楮衾","author":"华岳","text":"霜风剪水作冰花，织出吴绫不用梭。\n十幅晓云藏处士，一床秋水浸嫦娥。\n直疑天上无青女，却信人间有睡魔。\n更向屏山画梅竹，红尘还有此风么。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游溪西寺","author":"华岳","text":"寺觉重游好，僧期后会赊。\n青虫彫病叶，白鸟篆平沙。\n水瘦石生齿，山寒梅未花。\n功名今有待，且谒惠公茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":36065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]