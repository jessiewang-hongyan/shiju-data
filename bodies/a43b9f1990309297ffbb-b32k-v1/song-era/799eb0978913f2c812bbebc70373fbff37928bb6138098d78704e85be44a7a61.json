llection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘唐卿户曹擢第西归六首 其六","author":"范成大","text":"四海西州旧故多，烦君问讯各如何。\n心期本自无南北，万里天波一月波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘唐卿户曹擢第西归六首 其五","author":"范成大","text":"我识岷峨最上头，当年脚力与云浮。\n两山父老如相问，一席三椽正卧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘唐卿户曹擢第西归六首 其三","author":"范成大","text":"槐黄灯火困豪英，此去书窗得此生。\n学力根深方蒂固，功名水到自渠成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘唐卿户曹擢第西归六首 其二","author":"范成大","text":"学道何关紫与青，发身聊假佛名经。\n归来解尽程书缚，千古文章似建瓴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘唐卿户曹擢第西归六首 其四","author":"范成大","text":"中年亲友惜分离，况我身兼老病衰。\n馀景庶几犹及见，登瀛召客过门时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送刘唐卿户曹擢第西归六首 其一","author":"范成大","text":"摩挲汉柱怆分襟，邂逅吴船喜盍簪。\n别久十年知几梦，情亲万里只初心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送同年万元亨知阶州 其二","author":"范成大","text":"路入南山旧汉畿，油油清渭照牙旗。\n古来百战功名地，正是鸡鸣起舞时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送同年万元亨知阶州 其三","author":"范成大","text":"十年关陇困科输，圣德如天尽扫除。\n临遣中和二千石，好乘春日下宽书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送同年万元亨知阶州 其一","author":"范成大","text":"老我曾颁万里春，怜君飞棹也浮秦。\n当年千佛名经里，又见西游第二人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送许耀卿监丞同年赴静江倅四绝 其一","author":"范成大","text":"南国春深雁欲回，湘江花浪一帆开。\n知君不为骖鸾去，直为渊明五斗来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送许耀卿监丞同年赴静江倅四绝 其三","author":"范成大","text":"雁塔交亲比断金，故人岁晚更情深。\n只今不隔同年面，想见青云异日心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送许耀卿监丞同年赴静江倅四绝 其四","author":"范成大","text":"官涂真有上竿鱼，玉笋翻乘别驾车。\n闻道留行有公论，从今日日看除书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送寿老往云间行化","author":"范成大","text":"天平船子过华亭，舍卫城中次第行。\n留取钵盂归院洗，东岩新出一泉清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送举老归庐山","author":"范成大","text":"二千里往回似梦，四十年今昔如浮。\n去矣莫久留桑下，归欤来共煨芋头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送琴客许扬归永嘉","author":"范成大","text":"乌帽休冲九陌埃，瘦藤定约到秋回。\n龙湫雁荡经行处，断取松风万壑来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送端言","author":"范成大","text":"东君留恋一分春，蜂蝶阑珊燕子新。\n桃李无情空绿径，市桥杨柳送行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重阳不见菊二绝 其一","author":"范成大","text":"节物今年事事迟，小春全未到东篱。\n可怜短发空欹帽，欠了黄花一两枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重阳不见菊二绝 其二","author":"范成大","text":"冷蕊萧疏蝶懒飞，商量何日是花时。\n重阳过后开无害，只恐先生不赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重阳后菊花二首 其二","author":"范成大","text":"过了登高菊尚新，酒徒诗客断知闻。\n恰如退士垂车后，势利交亲不到门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重阳后菊花二首 其一","author":"范成大","text":"寂莫东篱湿露华，依前金靥照泥沙。\n世情儿女无高韵，只看重阳一日花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重送文处厚因寄蜀父老三首 其三","author":"范成大","text":"灌口江源不断流，峨眉山月几番秋。\n江山好处吾能记，为问江山记客否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重送文处厚因寄蜀父老三首 其二","author":"范成大","text":"下峡东归十五年，因君话旧意茫然。\n烦将远道悠悠梦，直到天西暑雪边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重送文处厚因寄蜀父老三首 其一","author":"范成大","text":"江上连樯叠鼓行，不争微利即争名。\n算来无似君潇洒，来往空船载月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钟山阁上望雨","author":"范成大","text":"天阔山长雨似烟，忽然飞去暗平川。\n粳禾未实籼禾瘦，不用廉纤便霈然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻石湖海棠盛开亟携家过之三绝 其三","author":"范成大","text":"低花妨帽小携筇，深浅胭脂一万重。\n不用高烧银烛照，煖云烘日正春浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻石湖海棠盛开亟携家过之三绝 其二","author":"范成大","text":"家人扶上锦城头，蜂蝶团中烂熳游。\n报答春光须小醉，红云洞里按伊州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻石湖海棠盛开亟携家过之三绝 其一","author":"范成大","text":"东风花信十分开，细意留连待我来。\n开过十分风不动，更无一片点苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻春远牡丹盛开","author":"范成大","text":"东轩闻道有花开，痴坐三椽首谩回。\n纵得好晴犹懒看，那堪风雨揭天来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"除夜前二日夜雨","author":"范成大","text":"雪不成花夜雨来，垄头一洗定无埃。\n小童却怕溪桥滑，明日先生合探梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"香山","author":"范成大","text":"抖擞轩裳一鬨尘，任教空翠滴乌巾。\n老身已到篮舆上，处处青山是故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"香山","author":"范成大","text":"采香径里木兰舟，嚼蕊吹芳烂熳游。\n落日青山都好在，桑间荞麦满芳洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"唐山","author":"范成大","text":"勋唐遗德照清湾，百圣闻风不敢班。\n何物苦寒胡地鬼，二名犹敢废尧山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"唐懿仲诸公见过小饮凌寒残梅之下二绝 其二","author":"范成大","text":"问人何处是花蹊，香玉匀铺不见泥。\n莫怪山翁行步涩，更无空处著枯藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"唐懿仲诸公见过小饮凌寒残梅之下二绝 其一","author":"范成大","text":"春风动是隔年期，更对残花把一卮。\n少待和烟和月看，依稀犹似未开时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"壶春堂","author":"范成大","text":"松漠丹成去不归，龙髯无复有攀时。\n芳园留得觚棱在，长与都人作泪垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其二十七","author":"范成大","text":"二麦俱秋斗百钱，田家唤作小丰年。\n饼炉饭甑无饥色，接到西风熟稻天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其二十六","author":"范成大","text":"五月江吴麦秀寒，移秧披絮尚衣单。\n稻根科斗行如块，田水今年一尺宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其三十","author":"范成大","text":"下田戽水出江流，高垄翻江逆上沟。\n地势不齐人力尽，丁男长在踏车头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其三十二","author":"范成大","text":"槐叶初匀日气凉，葱葱鼠耳翠成双。\n三公只得三株看，閒客清阴满北窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其二十九","author":"范成大","text":"小妇连宵上绢机，大耆催税急于飞。\n今年幸甚蚕桑熟，留得黄丝织夏衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其三十四","author":"范成大","text":"千顷芙蕖放棹嬉，花深迷路晚忘归。\n家人暗识船行处，时有惊忙小鸭飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其三十六","author":"范成大","text":"蜩螗千万沸斜阳，蛙黾无边聒夜长。\n不把痴聋相对治，梦魂争得到藜床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其四十二","author":"范成大","text":"秋来只怕雨垂垂，甲子无云万事宜。\n穫稻毕工随晒谷，直须晴到入仓时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其三十三","author":"范成大","text":"黄尘行客汗如浆，少住侬家漱井香。\n借与门前磐石坐，柳阴亭午正风凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其三十八","author":"范成大","text":"朱门巧夕沸欢声，田舍黄昏静掩扃。\n男解牵牛女能织，不须徼福渡河星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其四十一","author":"范成大","text":"垂成穑事苦艰难，忌雨嫌风更怯寒。\n笺诉天公休掠剩，半偿私债半输官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其四十三","author":"范成大","text":"中秋全景属潜夫，棹入空明看太湖。\n身外水天银一色，城中有此月明无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其三十九","author":"范成大","text":"橘蠹如蚕入化机，枝间垂茧似蓑衣。\n忽然蜕作多花蝶，翅粉才乾便学飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其二十八","author":"范成大","text":"百沸缲汤雪涌波，缲车嘈囋雨鸣蓑。\n桑姑盆手交相贺，绵茧无多丝茧多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 其四十","author":"范成大","text":"静看檐蛛结网低，无端妨碍小虫飞。\n蜻蜓倒挂蜂儿窘，催唤山童为解围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"四时田园杂兴六十首 秋日十二绝 其三十七","author":"范成大","text":"杞菊垂珠滴露红，两蛩相应语莎丛。\n虫丝罥尽黄葵叶，寂历高花侧晚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴坐庵四首 其三","author":"范成大","text":"粥鱼吼罢鼓逢逢，卧听饥鼯上晓釭。\n一点斜光明纸帐，悟知檐雀已穿窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴坐庵四首 其一","author":"范成大","text":"油灯已暗忽微明，石鼎将乾尚有声。\n衲被蒙头笼两袖，藜床无地著功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴坐庵四首 其四","author":"范成大","text":"跏趺合眼是无何，静里惟闻鸟雀多。\n俗客叩门称问字，又烦居士起穿靴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宴坐庵四首 其二","author":"范成大","text":"五更风竹闹轩窗，听作江船浪隐床。\n枕上翻身寻断梦，故人待漏满靴霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晒茧","author":"范成大","text":"隔篱处处雪成窝，牢闭柴荆断客过。\n叶贵蚕饥危欲死，尚能包裹一丝窠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓行","author":"范成大","text":"篝灯驿吏唤人行，寥落星河向五更。\n马上谁惊千里梦，石头冈下小车声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏书二首 其二","author":"范成大","text":"群儿欺老少陵穷，口燥唇乾发漫冲。\n颠沛须臾犹执礼，古来惟有一高共。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓泊横塘","author":"范成大","text":"短梦难成却易惊，披衣起漱玉池清。\n遥知中夜南风转，汹汹前村草市声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓起","author":"范成大","text":"窗明惊起倒裳衣，铃索频摇定怪迟。\n即入簿书丛里去，少留欹枕听黄鹂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"栾城","author":"范成大","text":"颓垣破屋古城边，客传萧寒爨不烟。\n明府牙绯危受杖，栾城风物一凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃花坛下望龟峰","author":"范成大","text":"石坛无土谩嵚岑，何自能生小柏林。\n拟擘蛤蜊龟壳上，病来不杀懒登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"案上梅花二首 其二","author":"范成大","text":"地炉火煖日烘窗，一夜花须半吐黄。\n鼻观圆通熏百和，博山三夕罢烧香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"案上梅花二首 其一","author":"范成大","text":"南坡玉雪万花团，旧约东风载酒看。\n冷落铜瓶一枝亚，今年天女亦酸寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桐川郡圃梅极盛皆围抱高木浙中无有","author":"范成大","text":"家住丹枫白苇林，横枝一笑万黄金。\n玉溪园里逢千树，还尽春风未足心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桐庐","author":"范成大","text":"湿云垂野淡疏林，十日山行九日阴。\n梅子弄黄应要雨，不知客路已泥深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桐庐江中初打桨","author":"范成大","text":"二十年前鬓未斑，下滩归路落潮乾。\n如今衰雪三千丈，却趁潮平再上滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"殊不恶斋秋晚閒吟五绝 其二","author":"范成大","text":"旁若无人鼠饮砚，麾之不去蝇登盘。\n天凉睡起枕痕煖，日晚慵来香字寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"殊不恶斋秋晚閒吟五绝 其五","author":"范成大","text":"中秋昨已等閒过，重九今还如梦来。\n霜鬓数茎羞堕帻，黄花三度笑空杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浙江小矶春日","author":"范成大","text":"客里无人共一杯，故园桃李为谁开。\n春潮不管天涯恨，更捲西兴暮雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]