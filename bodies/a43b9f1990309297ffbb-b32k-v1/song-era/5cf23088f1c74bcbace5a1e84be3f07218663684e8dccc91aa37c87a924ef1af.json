[{"title":"送沈鍊师归武夷 其一","author":"胡仲弓","text":"仙骨久已蜕，尚遗空石函。\n白云最深处，猿鹤情相谙。\n松花饥可飧，渴饮寒泉甘。\n招邀武夷君，清风资玄谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41479,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送季同归龙泉","author":"胡仲弓","text":"天寒犹客路，行李况担书。\n唤醒江湖梦，归寻水竹居。\n词华须近古，剑气欲凌虚。\n好趁功名会，言诗特绪馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41480,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送梅臞三山","author":"胡仲弓","text":"曾共梅花约，论心到岁寒。\n如何倾别酒，独自上吟鞍。\n药裹留馀剂，诗囊有近刊。\n怀人眇云际，频展墨龙看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41481,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"适吾意","author":"胡仲弓","text":"嘲风咏月天，问花寻柳地。\n随遇可行乐，但欲适吾意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41482,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭墓","author":"胡仲弓","text":"拜亲亲不待，事事与心违。\n万里有归日，九泉无见时。\n愁生新绿绶，泪满旧斑衣。\n从此白云断，何当慰所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41483,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"旅中早行","author":"胡仲弓","text":"前山风雨暗，欲去路还迷。\n烛影照行李，钟声催晓鸡。\n年光销旅况，秋气入征蹄。\n如此困行役，何时归去兮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41484,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晋安城东温泉","author":"胡仲弓","text":"女娲补天愁天破，石底千年埋宿火。\n火蒸泉脉为温汤，凿开浴沼涵天光。\n美人含羞弄清泚，一朵芙蓉蘸秋水。\n起来无力著纤裳，冰肌缥缈轻云香。\n人间何福能堪此，好与天家浴仙子。\n曾闻前代有华清，玉龙活动真妮惊。\n吾皇仁圣格天地，天锡玄符地呈瑞。\n风雷奔击鬼神呼，温泉一夕移燕都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41485,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桐庐县","author":"胡仲弓","text":"富春山下桐庐县，江水萦回千万峰。\n县宰何人真解事，做官来向画图中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41486,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"海月堂观涛","author":"胡仲弓","text":"青天与海连，羲娥代吞吐。\n封姨助馀威，阳侯倏起舞。\n或奔千丈龙，或轰万叠鼓。\n蓬弱此路通，祇界一斥卤。\n浩浩无津涯，尾闾辟地户。\n嬴女驱鲛人，献怪扶桑府。\n琛球来百蛮，玭珠还合浦。\n独立象冈外，身世等一羽。\n宇宙纳溟渤，万山齐伛偻。\n清风与明月，造物不禁取。\n临流喜得句，玉栏失笑拊。\n眺望此一时，澒洞注千古。\n安得捲上天，霈作天下雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41487,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病后","author":"胡仲弓","text":"病发凋零后，朱颜似旧无。\n愁多诗债减，贫剧故交疏。\n风挟砧声急，云拖雁影孤。\n夜来长不寐，攲枕看方书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41488,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秦氏楼","author":"胡仲弓","text":"秦氏楼中双飞燕，楼前柳絮沾人衣。\n春风轻薄穿绣帏，抱琴指按黄金徽。\n鼓终一曲三叹息，思君子兮何时归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41489,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"耕钓境","author":"胡仲弓","text":"莘野特浪耕，璜溪岂真钓。\n珍重富春翁，此境最高妙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41490,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谈星林汉留求诗","author":"胡仲弓","text":"君贫卖术我卖文，君贫似我贫一分。\n君挟天盘走湖海，我携破砚登青云。\n两穷相值君莫笑，卖文有时饥可疗。\n天边一点少微星，会与太阳来合照。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钱塘潮图","author":"胡仲弓","text":"轻绡淡墨天冥冥，眼中似觉对西兴。\n银山大浪万鼓过，海潮逆上江倒行。\n前年南游此饯别，亲友握手难为情。\n酒酣拂袂不忍顾，攲枕仰看云帆轻。\n平生浪迹半天下，摇毫掉舌终何成。\n并州故乡真可画，新生白发星星明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高阳山远眺","author":"胡仲弓","text":"龙寻多伟观，立马少徘徊。\n地僻风埃少，天成图画开。\n仅留官驿在，无复酒徒来。\n一雁长空去，凭高叫不回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄杨蕴古","author":"胡仲弓","text":"匹马游边已千里，如何未奏凯歌声。\n太平不用干戈策，辜负胸中百万兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清吟寺","author":"胡仲弓","text":"高僧曾住此，长对佛炉吟。\n萧寺有兴废，清名无古今。\n禅心秋水瑩，灯影石坛深。\n不见鬼神泣，空闻钟磬音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"隐者 其一","author":"胡仲弓","text":"老去绝尘缘，人疑行地仙。\n釜中惟煮石，囊里不储钱。\n寄迹茅三架，随身诗一编。\n云山深处住，与鹤作忘年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后","author":"胡仲弓","text":"一冬寒意少，既雪又还晴。\n地面冰初结，天涯春已深。\n六花随雨化，三白有梅争。\n袖手灞桥道，怀人心事清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒食","author":"胡仲弓","text":"初过一百五，园林正好看。\n梨花未全秃，梅子带微酸。\n近世烟初禁，何人食肯寒。\n东风犹作恶，谁念客衣单。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒碧席上薪隐分韵得初字","author":"胡仲弓","text":"心远尘难到，高堂便读书。\n凤归巢已覆，鹤去栅常虚。\n野水平荷叶，清风绕竹庐。\n静边生万感，况复晚凉初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晴溪","author":"胡仲弓","text":"晴溪湛如酒，越儿中拍浮。\n羡之不可学，徙倚溪上楼。\n直下数游鱼，咳唾鱼惊愁。\n偷生几漏网，为龙知何秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"赵汝腾","text":"阳萌知独复，岁寒见孤洁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游紫泽观","author":"胡仲弓","text":"地偏尘不到，俗客可曾来。\n写帖云侵砚，朝真风满台。\n兰荒根有蠹，梅古树生苔。\n莫论还丹诀，金炉久已灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答林颛民","author":"胡仲弓","text":"镆铘如此甘埋光，犹向牖下寻笔床。\n辕驹局促不千里，堂堂七尺空尔长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"答颐斋诗筒走寄 其一","author":"胡仲弓","text":"才听檐花点滴声，锦囊入手便欣情。\n啼乾杜宇春言别，赋到牡丹诗改盟。\n洗涤愁肠凭酒遣，揄扬心事借琴鸣。\n诘朝紫翠栏边约，喜有溪毛可絮羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蛛丝巧","author":"胡仲弓","text":"蛛丝虽巧能害物，蚕丝虽拙能利人。\n害物晨昏一饱足，利人往往害及身。\n乃知巧者能远祸，拙者生死常为邻。\n吾宁为蚕勿为蛛，所愿杀身以成仁。\n千丝万缕何足恤，要令寒谷皆阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感古十首 其十","author":"胡仲弓","text":"杜康精酒法，陆羽修茶经。\n标致虽不同，均是劳吾形。\n采薇及茹芝，亦掇天地英。\n玄酒非曲糵，或可通神明。\n天不生杜陆，人间无醉醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感古十首 其九","author":"胡仲弓","text":"惠连梦春草，江淹梦彩笔。\n一梦何足凭，材名繇此出。\n读书三十年，仅可变形质。\n所向如面墙，此语难致诘。\n何事殷武丁，因梦得良弼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感古十首 其八","author":"胡仲弓","text":"范蠡泛五湖，子房从赤松。\n功成乞身退，明哲保令终。\n彼美二丈夫，世异辙则同。\n此道久不作，利欲尘相蒙。\n急流不知返，失脚机阱中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感古十首 其七","author":"胡仲弓","text":"四皓隐商山，子陵隐严濑。\n隐身非隐名，清致一何在。\n羽翼若为成，狂奴滋故态。\n一出竟奚为，名被世人卖。\n所以终南山，捷径不可再。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感古十首 其六","author":"胡仲弓","text":"商君金徙木，赵高鹿为马。\n徒欲取民信，疑心随解瓦。\n罔民适自欺，何以刑天下。\n四维已灭亡，命脉存已寡。\n焚书火咸阳，斯言信非假。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感古十首 其五","author":"胡仲弓","text":"共工触不周，荆卿悲易水。\n所遭虽异时，等为血气使。\n争帝力已穷，报怨反害己。\n一为狂夫愚，一为刺客靡。\n二者俱无成，三叹而已矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感古十首 其四","author":"胡仲弓","text":"相如归全璧，范增撞玉斗。\n为主心固同，逆顺异所守。\n发怒俱忘身，裂眦欲碎首。\n此完彼玷缺，尽在一举手。\n万形各有敝，斯名长不朽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感古十首 其三","author":"胡仲弓","text":"豫让口吞炭，智伯头已漆。\n报仇须及晨，安用诈行乞。\n饮器骨已枯，癞哑特小术。\n壮士死于义，千古犹一日。\n弃主事雠人，万死奚足恤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感古十首 其二","author":"胡仲弓","text":"管蔡厄周公，陈蔡厄夫子。\n圣人于此时，所俟惟一死。\n弦歌乃自知，赤舄亦几几。\n未明周孔心，道统安所恃。\n天苟丧斯文，坠地扶不起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感古十首 其一","author":"胡仲弓","text":"卞氏璧难售，渊明琴本瘖。\n自衒亦可丑，三献机转深。\n无弦避俚耳，举世谁知音。\n所以古达士，万事何容心。\n勿学卞氏璧，请事渊明琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感兴","author":"胡仲弓","text":"有丝不绣平原君，有金不铸钟子期。\n此心抱独无人会，百年只有青天知。\n青天冥冥不可诘，举头当中有皦日。\n从来天日不可欺，何用区区守暗室。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"溪亭夜集走笔","author":"胡仲弓","text":"倚柱看潮生，渔歌静中发。\n吟罢寂无声，江风对山月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"颐斋联日有事于琛亭赋诗聊为解嘲","author":"胡仲弓","text":"诗人有公事，日日走琛亭。\n紫翠和衣重，香尘满面生。\n蚌还江月湿，龙起浪云腥。\n薏苡亦何有，奚囊澈底清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鲈乡道院","author":"胡仲弓","text":"宦情原自薄，卜得吴松居。\n乡味已饱谙，胡为羡鲈鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"僧过涧图","author":"胡仲弓","text":"溪急水摇石，野僧蹑石度。\n寒流漾笠影，历险无窘步。\n仆夫后岭来，木末迹樵路。\n苍茫盼精蓝，惨澹没烟雾。\n忆昔山中行，顾瞻歌陟岵。\n今犹梦见之，觉乃忘其故。\n画师从何知，展玩失毫素。\n怅然渺予怀，江乡碧云暮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"漫兴","author":"胡仲弓","text":"大笑出尘间，吟身得暂閒。\n解衣临水阁，倚杖看云山。\n归鸟声如市，骑牛歌更蛮。\n明边一点墨，元是野僧还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"精卫","author":"胡仲弓","text":"子房铸铁报韩仇，智者反为豪侠误。\n倾秦岂在博浪沙，继世自闻嬴业仆。\n吁嗟精卫亦偿冤，一旦奋飞身不顾。\n衔石填海抑何愚，岂在朝朝与暮暮。\n精卫精卫汝不知，沧海终有陵谷时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠竹","author":"胡仲弓","text":"修修青琅玕，霜雪不可折。\n肯随流水去，赖有岁寒节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"静中","author":"胡仲弓","text":"静中天地阔，岁月听悠悠。\n往事浑如梦，长江不尽流。\n蛩吟似怀古，雁阵去防秋。\n习得看山癖，终朝懒下楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题山居十绝 其九 梅涧","author":"胡仲弓","text":"今昨孤山迥不同，逋仙谁与管春风。\n暗香疏影无寻处，元在泠泠一涧中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题叶山甫见惠古琴走笔以谢","author":"胡仲弓","text":"南风之歌久绝响，生民不作声希想。\n声音之道与政通，审音知政惟丝桐。\n堪嗟世道多翻覆，几度桑田变陵谷。\n摩挲古物忆当年，人在春风和气天。\n治世之音安以乐，斯琴当年羽衣作。\n物换星移阅几周，不图今日为君留。\n袖来赠与无弦客，得之何啻如圭璧。\n籀文篆古未为奇，我思古人珍秘时。\n古人不可得而见，见琴如见当时面。\n安得寻声问爨人，为吾一洗琴上尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题杨妃上马娇图","author":"胡仲弓","text":"并辔行春沉醉归，侍儿扶上绣鞍来。\n君王微笑回眸看，肯信嵬坡掩面时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题金粟洞","author":"胡仲弓","text":"名山洞府三十六，若拟帽峰犹未足。\n有人曾此坐丹炉，有人曾此安棋局。\n一朝悟道归去来，依旧紫云锁林屋。\n武荣贾客来洛阳，手携尺书叩岩谷。\n觌面亲逢吕洞宾，有眼不辨郑文叔。\n功成行满欲度人，酬之遗以半升粟。\n岂知粒粒皆金砂，一服可但能辟谷。\n先嗔后喜来重寻，痴心才动隔山谷。\n故老相传金粟仙，凌霄有塔苍标玉。\n乾坤外物号无尘，凡夫到此懒著脚。\n我来稽首问先生，若为乞得壶中药。\n刀圭分与医国人，却入深山抱幽独。\n先生道我亦不尘，且走千岩并万壑。\n它时相过岳阳楼，定把奇书与君读。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题野云庵","author":"胡仲弓","text":"庵中有高人，不受红尘触。\n吟诗每夜深，来伴山云宿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠张南金谈星","author":"胡仲弓","text":"乃祖乘槎去复还，君平饶舌世人传。\n天机不道因渠泄，更遣云仍学算天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邀月坐中庭","author":"胡仲弓","text":"邀月坐中庭，清影不可驻。\n举酒浇枯肠，落笔欠长句。\n瀣气惟沾衣，秋声远鸣树。\n磕睡依危栏，梦断足幽趣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寻梅","author":"胡仲弓","text":"因探梅花踏晓云，隔墙时有暗香闻。\n枝头才漏春消息，便带春愁一二分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南浦","author":"胡仲弓","text":"脩途无好况，满面受风埃。\n见说山穷处，曾经水患来。\n溪桥横独木，田野长荒莱。\n薄暮投孤馆，寒猿声更哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谒金门","author":"胡仲弓","text":"蛾黛浅。\n只为晚寒妆懒。\n润逼镜鸾红雾满。\n额花留半面。\n渐次梅花开遍。\n花外行人已远。\n欲寄一枝嫌梦短。\n湿云和恨剪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落梅","author":"胡仲弓","text":"谢娥三弄笛，错恨五更风。\n树老馀香少，花残瘦影空。\n深堆和靖墓，浅点寿阳宫。\n结果重来此，方知造化工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落梅 其一","author":"胡仲弓","text":"花本无情却有情，谁将开落拟浮生。\n盈虚自是天机事，错认楼前羌笛声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落梅 其二","author":"胡仲弓","text":"南枝不与北枝同，及早开时及早空。\n莫笑北枝开较晚，前头毕竟有春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中口占三首 其三","author":"胡仲参","text":"饭罢呼僮旋煮茶，棋枰诗卷小生涯。\n从今厌踏红尘路，多在山间少在家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中口占三首 其二","author":"胡仲参","text":"踯躅花开野色浓，和风和雨卧丛丛。\n城中只买零枝看，那似山头满树红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山中口占三首 其一","author":"胡仲参","text":"四野平田春水肥，前山隐隐带残晖。\n千林晚色无人共，时有樵翁独自归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"圩田","author":"胡仲参","text":"圩田依涧水，入夏未栽禾。\n不是春耕晚，山中寒气多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过界首","author":"胡仲参","text":"几重岭隔几重湾，路入濛濛烟雨间。\n独立溪桥重回首，前头已是剑州山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"听雨","author":"胡仲参","text":"听尽灯前细雨声，声声总是别离情。\n何时断得闲烦恼，一任芭蕉滴到明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还赵靖轩吟卷","author":"胡仲参","text":"借得君诗在案头，篝灯夜夜看银钩。\n苦吟暗数秋更尽，何处笛声人倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和伯氏春雨中韵 其二","author":"胡仲参","text":"两堤杨柳拂新亭，怪底游人懒踏青。\n手撚梨花成小立，半窗湖水雨冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和伯氏春雨中韵 其一","author":"胡仲参","text":"痴寒脉脉压晴莎，春渐三分景未和。\n待得浓阴收拾后，花边春色已无多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜来闻曾性之丘君就二友隔楼吟声不绝以诗柬之","author":"胡仲参","text":"月下归来深闭门，衾寒时倩博山温。\n隔楼忽听吟声苦，引得清愁入梦魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":41547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]