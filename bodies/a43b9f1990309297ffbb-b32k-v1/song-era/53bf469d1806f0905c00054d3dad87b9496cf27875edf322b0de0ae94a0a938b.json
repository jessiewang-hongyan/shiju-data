[{"title":"黄兵部生辰四首 其四","author":"陈渊","text":"地上泉流府库充，艰难天与岁时丰。\n他时若论关中漕，合数萧何第一功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感时 其二","author":"仲并","text":"忽传群盗下淮濒，又逐黄州韩使君。\n却望长安在天上，愁看天际有孤云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感时 其一","author":"仲并","text":"伤春那得易为情，世味年来一一更。\n驰马弯弓今日事，儒冠深觉误平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题章伯深臞怪图 其二","author":"仲并","text":"杖策山隈亦水滨，閒中未害饱经纶。\n何曾寂寞嵌岩里，惯著风流廊庙人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题章伯深臞怪图 其一","author":"仲并","text":"竹户茅檐一径斜，清樽黄卷定生涯。\n溪山胜处春长在，却放朱藤一半花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"薄暮游潘登仕园园有堂三间榜曰一枝盖湖公枢密两取庄周郤诜之语既以嘉潘亦以勉潘之二子因用其意各赋一绝 其一","author":"仲并","text":"斜窗短屋傍残晖，宴坐萧然老布衣。\n枯淡生涯一枝足，世间惊鹊误南飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"薄暮游潘登仕园园有堂三间榜曰一枝盖湖公枢密两取庄周郤诜之语既以嘉潘亦以勉潘之二子因用其意各赋一绝 其二","author":"仲并","text":"玉树郎君两白眉，照人英爽自儿时。\n乃翁可笑太多事，绕舍春风千万枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上平江李侍郎生辰 其一","author":"仲并","text":"持橐朝端誉有光，垂弧门左昼初长。\n功名唾手囊中物，药石关心肘后方。\n公念承流当振廪，人歌难老竞持觞。\n寿筵一举松江渌，便趁追锋侍帝旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上平江李侍郎生辰 其二","author":"仲并","text":"昔襦今裤雄藩守，佩玉峨冠近侍臣。\n十万人家等蒙润，三千风月政当仁。\n仙姿照坐桃如许，冷艳当檐梅一新。\n愿比秦淮与钟阜，郁葱佳气自长春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上孟郡王生辰三首 其三","author":"仲并","text":"月挂微弦天未霜，初筵遽作十分凉。\n饱参平日安心法，自是长年却老方。\n诏下龙墀思旧德，名标雁塔看诸郎。\n慇勤为采瀼潭菊，满泛西风岁岁觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上孟郡王生辰三首 其二","author":"仲并","text":"先门勋业画图中，又见麒麟第一功。\n吹帽龙山前日事，还珠合浦昔人风。\n满籯何有简编足，荐牍无心天地公。\n谁说维熊契占梦，君王卜处本非熊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上孟郡王生辰三首 其一","author":"仲并","text":"霜馀晴日照堤沙，早晚天墀下白麻。\n有吏当筵歌湛露，须公满斝泛流霞。\n篇章况是万人敌，阀阅相仍百乘家。\n落帽何须定重九，探先三日醉黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上枢密生辰 其一","author":"仲并","text":"家住东南最上游，一从束发侍宸旒。\n文兼钟阜古今秀，庆与秦淮日夜流。\n盛业行刊千琬琰，馀威坐折万貔貅。\n伫看拜后恩荣异，槐鼎相联鲁与周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上枢密生辰 其二","author":"仲并","text":"谤焰谗波岂易然，功成方验古无前。\n十年险阻忠偿国，万口纷纭诚格天。\n已遣烽消边障火，行看贯朽大农钱。\n如今闻道持盈业，旦旦开陈黼扆边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上枢密生辰 其三","author":"仲并","text":"儿童犹解仰芬芳，合缀韩门弟子行。\n久矣飘蓬疏望履，幸哉拥彗即升堂。\n夔龙会合时千载，鸥鹭留连天一方。\n遥愿衮衣仍鹤发，年年今日侍君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"日暮系舟","author":"仲并","text":"新晴不受短篷遮，系缆持觞一太嗟。\n柳岸萧条难驻客，茅檐安稳不如家。\n百年有几欲华发，今日无多已暮鸦。\n五世乡关泽未斩，欲归心折雁行斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代人上师垣生辰 其二","author":"仲并","text":"直把孤忠动帝聪，平生房杜不言功。\n冲霄鸾凤谋谟合，遮道豺狼党与空。\n韬略暇时谈笑里，勋名他日画图中。\n中书未数汾阳考，万有千年似鲁公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代人上师垣生辰 其三","author":"仲并","text":"清风孤映紫宸班，平立伊周伯仲间。\n几岁苦心扶国步，今年喜色到天颜。\n羽书已静淮西报，翟辂初从塞北还。\n式廓中原断无事，从容廊庙有馀閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代人上师垣生辰 其四","author":"仲并","text":"已闻鼙鼓静边陲，初见丝纶宠帝师。\n寰宇一新周礼乐，广庭重用汉威仪。\n江南江北无他事，春后春前更此时。\n举盏上公千岁寿，赓歌永赞舜无为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代人上师垣生辰 其五","author":"仲并","text":"日日衣冠金马门，有谁出力正乾坤。\n来归季子国人喜，终藉叔孙皇帝尊。\n凤沼真成逢旦暮，龙楼今得问晨昏。\n欲知馀庆来何似，带砺山河永永存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代人上师垣生辰 其一","author":"仲并","text":"盛世还生瑞世人，东风屈指岁华新。\n祥烟不断千山晓，爱日无边万国春。\n鸣玉珥貂扶紫极，櫜弓偃革转洪钧。\n我民非敢私为寿，永作堂堂社稷臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代人上师垣生辰 其六","author":"仲并","text":"冠豸英风传至今，于时早已望商霖。\n挂帆鲸浪朝天日，借箸龙墀许国心。\n帝渥荐颁廉陛远，边声初断塞垣深。\n不须更诵烝民句，处处儿童尽好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代人上师垣生辰 其七","author":"仲并","text":"不用天河洗甲兵，只凭直道致升平。\n三王事业贤臣主，一代师儒难弟兄。\n屡薄赋徭民鼓舞，尽除氛翳国清明。\n休将前古论今日，万古无人敢抗衡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代人上叔母张氏生辰三首 其三","author":"仲并","text":"忆昔观光际，温颜获屡亲。\n奖提烦叔父，驽蹇负前人。\n幸会逢今日，飘飖愧此身。\n捧觞陪子侄，深觉仲容贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代人上叔母张氏生辰三首 其二","author":"仲并","text":"仙阀流芳远，吾门袭庆长。\n萱堂今寿考，枢府昔辉光。\n玉树诸郎秀，金花宠命昌。\n欲知椿算久，辟谷有家方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代人上叔母张氏生辰三首 其一","author":"仲并","text":"云汉良辰近，秋风一叶初。\n祥光连户牖，喜色动门闾。\n蘋藻仪无间，芝兰庆有馀。\n仁人宜上寿，不必问瀛居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27372,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代同舍上黄相生辰三首 其三","author":"仲并","text":"五月天恩解网罗，四方举首愿时和。\n我公寰海甘霖望，今日门阑瑞气多。\n已幸羁穷蒙庇赖，伫看谈笑却干戈。\n汾阳二十中书考，他日遥知数倍过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27373,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代同舍上黄相生辰三首 其二","author":"仲并","text":"籍甚声华振九州，龙名未许颍川优。\n两年鈇钺扶黄屋，一品星躔尚黑头。\n烜赫朝班联棣萼，张皇军势拥貔貅。\n自惭东閤叨甄录，愿向清时与国谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27374,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代同舍上黄相生辰三首 其一","author":"仲并","text":"列宿东南夜有辉，门弧此际诞英奇。\n晏婴俭德人皆仰，召虎中兴日可期。\n名誉雅为天下望，孤忠自结圣君知。\n大椿会见千年算，应许惊乌托一枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27375,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四老堂诗 其一","author":"仲并","text":"好上清班冠紫宸，抽身便作最閒身。\n疏梅茂竹几多目，曲槛方池随处春。\n两两脊令听自好，重重华萼见长新。\n灵椿一树婆娑甚，稳覆家庭四老人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27376,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四老堂诗 其二","author":"仲并","text":"便胜从来三戟门，良金如友玉如昆。\n天边鸿雁空千里，堂上埙篪共一樽。\n自昔披榛扶社稷，几人衣锦向丘园。\n商山曾为留侯起，来作侯家异世孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27377,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"外舅庄子尚生辰 其二","author":"仲并","text":"家声久矣冠淮东，自喜升堂获拜公。\n每看云烟生笔下，故应丘壑满胸中。\n祠公此日家山乐，明府他时社稷功。\n早晚锋车下吴会，西来犹想及春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27378,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"外舅庄子尚生辰 其一","author":"仲并","text":"祥光昨夜拥冰轮，南国初生瑞世人。\n倚马高文追异代，憩棠馀爱在斯民。\n吟毫剩借江山助，诏墨行颁雨露新。\n要识漆园非浪语，传家重看八千春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27379,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"外舅庄子尚生辰 其三","author":"仲并","text":"两州佳誉亚龚黄，琳馆归来道益光。\n凛凛松筠非俗韵，诜诜兰玉见馀芳。\n梅催寒萼春初破，月满冰轮夜未央。\n景物渐新人不老，年年于此醉华觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27380,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对雪用曾丈韵呈徐丈","author":"仲并","text":"鹤氅偏宜鹤发翁，戏挼筇杖与儿同。\n梅梢弄影半窗玉，柳径吹绵三月风。\n拥户且眠窗未晚，泛舟何向水如空。\n阳春便逐新诗到，不待葭灰落嶰筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27381,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平江太守生辰二首 其二","author":"仲并","text":"玉笋初辞鹓鹭群，一麾来此振馀芬。\n三槐事业他年看，五裤歌谣随处闻。\n方丈可量閒日月，泰阶还赴旧风云。\n年年东注松江绿，浑欲朝来寿使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27382,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平江太守生辰二首 其一","author":"仲并","text":"画戟从来瑞霭浮，顿回春意到南州。\n占熊馈鲤呈祥日，拖玉腰金得志秋。\n十载声名天下最，满怀韬略古人求。\n寿觞频举公休惜，明日催归侍邃旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27383,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"归自江阴寄蒋知郡汪签判","author":"仲并","text":"维舟江口未栖鸦，急趁飞觞一笑哗。\n旋喜使君倾皂盖，尽从醉客堕乌纱。\n高城不记人分袂，短棹空随月到家。\n尚欲趋陪连夜饮，东篱容有后开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27384,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用汪彦章内翰诸公韵二首呈信安 其二","author":"仲并","text":"王门一岁几经过，客里承颜未厌多。\n诗卷心胸倾锦绣，珍庖盘釜荐麟驼。\n自惭淮海可怜客，每费江湖无尽波。\n玉树芝兰为公喜，庭空千丈影婆娑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27385,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用汪彦章内翰诸公韵二首呈信安 其一","author":"仲并","text":"勋业皋夔前后身，门从罗雀厌蹄轮。\n旌麾亟解江城守，丘壑苦留廊庙人。\n禅观起侵千嶂晓，篇章分与万家春。\n要将姓字誇今古，史笔何人似获麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27386,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用前韵别寄耿时举二首 其二","author":"仲并","text":"方兄于我一无堪，闭户休休口不谈。\n忆昔茅檐差傍北，望公花坞恰平南。\n高歌频举巨觥一，佳唱如闻小雅三。\n投分素深贫酷似，相期同苦亦同甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27387,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用前韵别寄耿时举二首 其一","author":"仲并","text":"树犹如此我何堪，赖有随斋可剧谈。\n少日声称满中外，几年词采秀东南。\n诗坛欲借背城一，材馆均蒙吐哺三。\n每见匆匆又分去，与公交淡不须甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27388,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"用前韵奉寄孟峤之","author":"仲并","text":"剩喜今年琢句频，仍闻灯火夜相亲。\n悬知耸壑昂霄日，不负腰金拖玉身。\n攻苦诗书如白屋，加鞭辞藻正青春。\n古来孟氏好兄弟，馀韵未忘今转新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27389,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白氏夫人生日二首 其二","author":"仲并","text":"断机久已传家训，采藻端然继国风。\n庭院炉烟春蔼蔼，门阑瑞气晓葱葱。\n遐龄愿效三桃实，拜寿何辞百盏空。\n自幸晚为门下士，馀波应许丐奇穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27390,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白氏夫人生日二首 其一","author":"仲并","text":"相门苗裔正诜诜，长庆风流几百春。\n吉梦忽随秋日晓，祥光常对月华新。\n翰林大笔高前古，玉树诸郎霭后尘。\n何假捧觞勤颂祝，由来寿考属仁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27391,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵呈陈得之诸公","author":"仲并","text":"勋业毋庸揽镜频，空馀白发向人亲。\n未论骨相无三甲，细数年华有六身。\n泉石相看应笑我，萍蓬不定几经春。\n尚须勇往趁晴日，竹外疏梅应斩新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27392,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵答徐圣可 其一","author":"仲并","text":"乃翁儒学似文翁，韵句天然无异同。\n社稷堂堂推故相，家庭挺挺见遗风。\n词场已擅千军敌，诗律仍惊万马空。\n愿报琼瑶无好语，朝来浑欲达空筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27393,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再用前韵答徐圣可 其二","author":"仲并","text":"公方绿发我成翁，犹喜芝兰臭味同。\n雅奏黄钟仍大吕，旷怀明月与清风。\n共高卞璧连城价，肯使衡茅四壁空。\n所望苕溪分一曲，邮签日日溯归筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27394,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再呈德邵","author":"仲并","text":"草草茅檐俭异奢，坐观物态尽空华。\n放怀近欲轻千户，排难何当念两家。\n壮岁我今成传癖，清时君勿病官邪。\n他年政恐从名宦，回首菟裘恨太赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27395,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再和高提干见寄","author":"仲并","text":"昂昂犹想立鸡群，三夜寒窗叠梦君。\n人物芝兰晋王谢，篇章黼黻汉卿云。\n飘蓬贱迹谁能记，推毂高风今创闻。\n不敢驰书丞相府，何当收拾与斯文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27396,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘乾耀绍原昔同里巷以贫见过愧无以副其意辄成四韵为别","author":"仲并","text":"旧时阡陌荆榛底，十载纵横豺虎群。\n绛帐并游那更得，乌衣群从断相闻。\n尚传是是非非语，翻坐奇奇怪怪文。\n谀墓平生吾岂敢，了无一物寿刘君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27397,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后数年登旷远亭用前韵再赋","author":"仲并","text":"坐客一时人物换，此山海内旧知名。\n华筵为我歌金缕，深院有人来石城。\n酒浪满浮春浪碧，眉峰浅画晚峰平。\n日斜柁转各回首，松竹绕溪知此情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27398,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晚泊姑苏用吕居仁舍人韵二首寄孟信安 其一","author":"仲并","text":"断岸留孤棹，层台耸近城。\n雁传他邑信，鸥背去年盟。\n几片雪多思，一枝梅有情。\n何人在楼上，吹笛暮寒生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27399,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晚泊姑苏用吕居仁舍人韵二首寄孟信安 其二","author":"仲并","text":"睡稳窗迟晓，愁多鬓易秋。\n祇堪浮小艇，不拟上西楼。\n无尽江山景，须陪杖屦游。\n一区何日办，孰为我公留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27400,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答友人四首 其四","author":"仲并","text":"百年未见一人閒，曾是兴嗟唐已还。\n遗躅有谁高往古，清风元自振中间。\n我惭官薄当投绂，公比吾家已买山。\n待得有田归已暮，何当分我一沧湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27401,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答友人四首 其三","author":"仲并","text":"晚矣吾身未乞閒，如公尺一合徵还。\n高标迥立风尘表，秀句喧传字宙间。\n谁和阳春仍白雪，我知流水与高山。\n归欤已熟他时路，直北龙溪一二湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27402,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答友人四首 其二","author":"仲并","text":"久矣忘情岂用閒，已看要起示无还。\n自怀白发苍颜客，不堕黄花翠竹间。\n顾我分为方外友，如公合上道家山。\n暇时及此频相过，城北城南浔几湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵答友人四首 其一","author":"仲并","text":"颇忆高人相与閒，扁舟谁与趣公还。\n杯行欸乃歌声底，客坐参差帆影间。\n多病扶携新几杖，平生契好旧湖山。\n未容月转各分手，醉语狂吟下碧湾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行再用前韵 其一","author":"仲并","text":"一棹苕溪去，千门榆火新。\n老来犹是客，病起怯逢春。\n儒馆妙人物，吟毫泣鬼神。\n平生经济业，勉矣正逢辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟行再用前韵 其二","author":"仲并","text":"行藏那用卜，皱面不重红。\n又作都城别，长怀国士风。\n折巾从有道，斗酒对无功。\n一梦何时续，南窗笑语中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟过吴江谒臞庵翁少留为赋二诗 其一","author":"仲并","text":"住家却学浮家样，横截江湖叠浪中。\n漫说三高无起日，孰知千古可同风。\n长林蒙雾行平远，层榭攀云语半空。\n堤上系舟何限意，匆匆著句未全工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟过吴江谒臞庵翁少留为赋二诗 其二","author":"仲并","text":"明明窗色极知晚，隔岸喧阗祇掩关。\n上下亭台烟雨外，参差花竹水云间。\n从多莫剪东南柳，胜绝新增西北山。\n客路十年辛苦里，也容一日及公閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈彦平","author":"仲并","text":"诗人老去倍伤秋，我亦秋来尚黑头。\n世事可怜催晚景，皇天未许减羁愁。\n不堪败菊愁彭泽，又见寒云饯蓐收。\n旋解鹴裘沽一醉，纷纷谈话任封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怀沈文伯","author":"仲并","text":"春服初成属暮春，舞雩那似霅溪滨。\n绕溪箫鼓谁家子，并塞风烟吾故人。\n好去定无为客恨，临分犹复念予贫。\n驱车跃马平安否，雁断无因消息真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]