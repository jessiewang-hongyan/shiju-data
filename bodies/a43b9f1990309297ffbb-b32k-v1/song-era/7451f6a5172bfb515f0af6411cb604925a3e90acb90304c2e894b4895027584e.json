[{"title":"题汉阳郎官湖","author":"夏倪","text":"太白当年夜郎谪，一樽聊与故人留。\n南湖乞得郎官号，从此名传五百秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南纪楼","author":"夏倪","text":"江发岷山如瓮口，汉从嶓冢又东流。\n滔滔江汉为南纪，我忆禹功时倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仁风台","author":"夏倪","text":"天水相浮合渺漫，杖藜翘首得遐观。\n祇应台上开阊阖，便觉银潢到耳端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"夏倪","text":"蚁浮金椀浊，妓压画船低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"夏倪","text":"犹喜平生蟹螯手，尚能半幅写行书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"夏倪","text":"天寒霜雪繁，游子有所之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"夏倪","text":"书来整整复斜斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"夏倪","text":"坐食今添几支遁，煮盐那得百弘羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"苏迨","text":"吾侪归卧髀骨裂，会友携壶劳行役。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题惠山练师竹轩","author":"袁植","text":"子猷喜种竹，太白喜乘月。\n俛仰云泥间，胜事俱清绝。\n况乃吾庐幽，风烟浩一丘。\n竹虚能受月华白，月白能牵竹翠浮。\n不应玉垒李太白，长对山阴王子猷。\n未携花下一壶酒，已登残夜水明楼。\n人间好景四并难，无如月下春琅玕。\n影摇金锁碎，光动剑芒寒。\n魂醒耿不寐，哦诗坐长叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题惠山次韵蒋叔任观溪涨","author":"袁植","text":"烟曳平川上，云屯翠岭头。\n雨淫成大浸，堤溃失安流。\n地入三吴窄，山馀九陇浮。\n不应昏垫后，始用济川舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游惠山一首","author":"钱绅","text":"挐舟到山寺，诗句偶缘情。\n山自锡无后，寺因泉有名。\n楼阴回夕景，树色向冬荣。\n就水别茶味，全胜它处烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"二妃庙","author":"李邦彦","text":"苍梧杳霭迷遐躅，晚云愁入修眉绿。\n薰风不动五弦空，清血斑斑在山竹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"李邦彦","text":"古郡荒藉驿舍卑，岁华羁思两依依。\n晓寒破暝清霜凛，暮色笼烟落月微。\n风物未谙惟近药，暄凉无定只更衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"张缜","text":"两岸更无通步路，四时常有避风船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双溪驿","author":"黄策","text":"已列危峨浮倒影，故淙寒碧护孤洲。\n峰回路断迷征客，雪溅雷奔阻下鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"汪恺","text":"露叶萤光湿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵岩寺呈锐公禅师","author":"唐绩","text":"一水穿岩走碧沙，沿溪樛木卧龙蛇。\n分明便是桃源路，不见溪头流落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登孤峰","author":"唐绩","text":"昨浮枉渚水，今上枉人山。\n想像云深处，先生独往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上城院","author":"鹿敏求","text":"疏林烟重集昏鸦，揽辔行穿路径斜。\n丈室飕飂风入户，龛灯明灭烬垂花。\n抵寒犹欠千钟酒，破睡聊资七碗茶。\n昨夜惊鸿云外过，渐催清梦绕天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"福恩寺","author":"鹿敏求","text":"自怜滚滚抗尘容，深入云山得梵宫。\n拂榻欲为庄叟梦，披襟聊挹楚王风。\n条松老干森森直，古麓寒泉脉脉通。\n衲子久能严戒律，炉香深炷掩房栊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南园道堂","author":"辛炳","text":"纵步幽园晚未回，已驯鱼鸟莫相猜。\n垂杨当路从教折，细草沿阶不费栽。\n花树影中流水过，林梢缺处远山来。\n一筇春事无人共，踏破空庭几点苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"辛炳","text":"有节松筠方直操，无言桃李尽成蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓台","author":"许中","text":"何代何人把钓缗，至今犹有钓台存。\n身名俱隐成真隐，吕渭严滩讵足论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山辉堂","author":"张劝","text":"萧萧松竹荫华扉，更有虚堂隐翠微。\n云露峰峦横秀色，月低岩下弄清辉。\n分开远碧鸣泉落，点破寒光白鸟飞。\n还似山阴秋霁后，照人怀抱欲忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏龙舟","author":"张劝","text":"两岸人人开盛宴，飞来飞去如掣电。\n明年文场角胜时，也如此日舟人战。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋玩月","author":"李宾王","text":"西风萧萧起青蘋，苍空碾玉收暮云。\n可怜八月十五夜，宝光九十方平分。\n东山飞来雪毛兔，瑞光千丈无纤尘。\n谁将八万修月斧，合成宝镜如珠轮。\n包藏宇宙几千万，留与此夕誇清新。\n柴门朱户同一照，清辉岂择富与贫。\n袁宏因此泛牛渚，知微何必登嶙峋。\n对兹良夜可携酒，呼童与我开芳樽。\n寒光凄冷砭肌骨，恍然疑作瑶台宾。\n我欲因之游广寒，叶师去后今无人。\n我欲因之登箸梯，周生之术谁能陈。\n浩歌痛饮人寂寂，惟有素影长相亲。\n须臾酒醒月未落，卧听潮声千万军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜","author":"汪洙","text":"久旱逢甘雨，他乡遇故知。\n洞房花烛夜，金榜挂名时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李花","author":"汪洙","text":"枝缀霜葩白，无言笑晓风。\n清芳谁是侣，色间小桃红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梨花","author":"汪洙","text":"院落沉沉晓，花开白雪香。\n一枝轻带雨，泪湿贵妃妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"应瓒挽诗","author":"汪洙","text":"先生高谊古人几，缔就良缘誓不违。\n要使有情皆作偶，纵然无目也相依。\n倡随偕老天何厚，生死同期世所希。\n寒月宵深光万里，浑疑华表鹤双归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留题王官谷","author":"李釜","text":"司空唐达士，寂寞卧云岑。\n扰扰任群态，休休信此心。\n泉声半山急，柳色旧庭深。\n彷佛登临处，遗踪一访寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"许居仁","text":"胜游怀橘偏思陆，高隐烧丹拟问洪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"知吴公仲庶游海云寺","author":"黄元","text":"海云春赏冠西州，醉帽花枝半压头。\n笳鼓不徒同俗乐，篇章还许缀诗流。\n祇应胜事多前日，长恐无人继后游。\n台鼎行闻虚席召，此欢须少为民留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题崎滩铺壁","author":"黄琮","text":"暖日淡胧霞，林梢噪晚鸦。\n游人何事喜，顷刻是山家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日郊居","author":"林冲之","text":"寄庐城郭逐风尘，不信农夫有食贫。\n世极全无干子姓，臣愚只恐负君亲。\n枯桑伐火怜龟觳，野鼠食禾讼谷神。\n劝汝及春收耒耜，官家子弟欲行春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"林遹","text":"饮马驱骄虏，飞龙纪建炎。\n艰危三改岁，仓卒两垂帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游石桥","author":"成大亨","text":"昙花亭下卧晴虹，两瀑交流雪喷洪。\n已许银灯观浚壑，未瞻秋月印长空。\n龙盘修榜千峰霁，金吼霜钟半夜风。\n念我宿根惟德本，为除冥障与心通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂 其一","author":"成大亨","text":"调燮勋庸万国欢，暂携造化入名园。\n芝兰绕砌初争秀，桃李成蹊自不言。\n沧海从龙扬巽翼，虞渊取日破妖昏。\n功存社稷膺宸眷，莫滞芳菲远帝阍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂 其二","author":"成大亨","text":"恳辞钧轴逸祠庭，园辟东郊以退名。\n花木争妍虽寓目，干戈未戢可忘情。\n鹰扬蚤继磻溪业，霖雨爰从傅野生。\n愿把经营芳圃手，更将春色遍寰瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵仲举知府徽猷劝农出郊","author":"成大亨","text":"鹤盖群山晓，熊旗爱日明。\n万夫观拥路，千耦劝深耕。\n江熟渔歌闹，山丰社鼓声。\n老农醉酺饮，鼓舞暮归情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"啸岩","author":"周裕","text":"万窟藏云造化宽，仙源路在小江干。\n三冬洞府幽栖暖，九夏星槎稳泛寒。\n飞雁忽经天柱过，蛰龙犹向石田蟠。\n揭名为报红尘客，尽把兹岩取次看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"烟村","author":"周裕","text":"千山环拱号烟村，名曰烟村却不村。\n路入清湘徒旅众，坐看扰扰到黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游虎邱","author":"陈珹","text":"选胜得朋俦，萦纡信小舟。\n旧游浑是梦，衰鬓独知秋。\n爽气侵残暑，名言破积愁。\n醉归有明月，莫咏大刀头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白鹭","author":"曾安强","text":"其外殊洁白，俯风临清流。\n其中乃贪秽，尽日鱼虾求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"曾安强","text":"何尝释书禁，新学破盲聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题大风山","author":"陈朝老","text":"上到禅关眼更明，重重天际万山青。\n便当常住云飞处，闲炷清香学诵经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"陈朝老","text":"姑射楼台簇水仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"陈朝老","text":"淑气随风裂麝脐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"陈朝老","text":"拥炉莫言冷，世间行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慈母画像赞","author":"释慧昌","text":"前身女，后身男，清净摩尼触处参。\n应现顿忘前后际，从今青出胜于蓝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释慧昌","text":"担板老翁，性本虚空。\n永劫不死，明月清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慈圣皇后赐钟赞","author":"宋直方","text":"稽首圆通圆觉王，圆合一切救有情。\n圆修自性妙湛然，假以音声而说法。\n众生闻音得悟解，非色非空二非尘。\n方便无边行法门，成就如来大圆智。\n稽首巍巍观世音，證入如是秘密门。\n于一尘中现多身，于多刹尘现一相。\n于不可说微尘劫，而救不可说众生。\n发起耳根真实门，不与世间相流转。\n世閒声论已宣明，声无无灭有非生。\n生灭二谛悉圆离，六根由是皆解脱。\n奇哉庆喜最多闻，不知闻性常周普。\n因钟而闻佛所呵，不应更立钟之事。\n当知金钟不可舍，能于末劫救沈沦。\n茫茫六道迷昏衢，得见钟声为慧日。\n悲酸恶趣忍泪中，得凭钟声超彼岸。\n钟声有是大福力，能越苦海如智航。\n我愿一切诸众生，闻是钟声同證觉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻笛","author":"刘吉甫","text":"戍鼓停挝月五更，呜呜巧作断肠声。\n江南自是春来早，吹到梅花梦也清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"陈思温","text":"尘踪犹隐豹，风采几临鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庠窃观学士九丈题此君轩诗谨次元韵因以求教","author":"王庠","text":"竹君久要已忘年，临风相语叶响泉。\n休学我图中似璧，莫师我直劲如弦。\n劝人达节通天命，舒卷若绳明若镜。\n尺无枉己空宿昼，圣岂有心犹击磬。\n岁寒来伴老柴门，我岂好静为躁君。\n惟有青青四时性，笑发千载空浮云。\n平安为报春依旧，珍重道人怜特秀。\n忍饥宁可食无肉，相对忘形笋黑瘦。\n更有涪翁心似月，平生相照何劳说。\n不为煎茶不作椽，清风万壑到处传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庠拜手顿首启伏蒙学士九丈再赐诗章庠僭率继和尚觊采览","author":"王庠","text":"鸣凤览德来纪年，要知圣泽如流泉。\n霜钟堂前饱竹实，道人娱凤抚舜弦。\n敲门剥啄谁传命，淡云磨丹开天镜。\n明朝相约送涪翁，夜静林深绕清磬。\n涪翁万里离鬼门，竹枝莫恼白使君。\n欲试刚肠置冰炭，抱琴远别冲行云。\n邂逅东坡应话旧，但说海山千万秀。\n道庠问讯今何如，自笑侬还空鹤瘦。\n我不愧天欺日月，何须更扣杯珓说。\n玉局洞天云绕椽，渔竿远信烦公传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上郡守","author":"严武","text":"一阵春风散晓霞，使君千骑拥高牙。\n太平天子加崇重，见说瀛洲已草麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"严武","text":"江头枫叶赤愁客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄友人","author":"张绎","text":"有客厌事事，洁身山之幽。\n寒暑不相贷，乃有卒岁忧。\n有生此有事，简之成赘疣。\n澄江本无浪，不如信虚舟。\n六经力道要，无以利心求。\n一朝与理会，万境真天游。\n伊水正清泠，子行无滞留。\n西风昨夜至，送子至中流。\n落月洒残梦，已看古岸头。\n我病强送君，是行良难俦。\n异时清门下，谁识东陵侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书座右","author":"张绎","text":"凡语必忠信，凡行必笃敬。\n饮食必慎节，字画必楷正。\n容貌必端庄，衣冠必肃整。\n步履必安详，居处必正静。\n作事必谋始，出言必顾行。\n常德必固持，然诺必重应。\n见善如己出，见恶如己病。\n凡此十四者，我皆未深省。\n书此当座隅，朝夕视为警。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其一","author":"释法成","text":"灯笼忽尔笑咍咍，如何露柱亦怀胎。\n天明生得白头女，至今游荡不归来。\n这冤家，好归来，黄花与翠竹，早晚为谁栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其二","author":"释法成","text":"归源性无二，方便有多门。\n但了归源性，何愁方便门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其三","author":"释法成","text":"露柱将来作木杓，旁人不肯任从伊。\n木杓将来作露柱，撑天拄地也相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二首 其一 达磨见武帝","author":"释法成","text":"闲将一段秦川锦，裁作人间巧妇衣。\n几度著来呈伎俩，暗中曲调少人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二首 其二 三顿棒","author":"释法成","text":"山藤六十轻分付，肋下三拳已太迟。\n堪笑不能知痛痒，上堂犹道拂蒿枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示小师思悟","author":"释法成","text":"维摩不默不良久，打破玄关没窠臼。\n堪嗟几个杜波斯，问著痴痴不问口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居 其一","author":"释法成","text":"四顾巍峨锁碧阴，松风和雨响于琴。\n居山不用逃声色，百鸟归来何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居 其二","author":"释法成","text":"雪覆乔林同一色，清光上下含虚碧。\n采樵人立渡头寒，极目圆蟾为谁白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"内前行","author":"唐庚","text":"内前车马拨不开，文德殿下宣麻回。\n紫薇侍郎拜右相，中使押赴文昌台。\n旄头昨夜光照牖，是夕收芒如秃帚。\n明日化为甘雨来，宅家唤作调元手。\n周公礼乐未要作，致身姚宋也不恶。\n向来两翁当国年，民间斗米才四钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":60847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]