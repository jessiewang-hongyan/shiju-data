[{"title":"力耕","author":"陆游","text":"力耕岁有一囷米，残俸月无三万钱。\n莫怪穷空心不动，正缘愚拙气差全。\n学经亹亹悬车后，秉礼拳拳易箦前。\n犹恨未能忘笔砚，小儿收拾又成编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月八日夜灯下对梅花独酌累日劳甚颇自慰也","author":"陆游","text":"奔走人间无已时，夜窗喜对出尘姿。\n移灯看影怜渠瘦，掩户留香笑我痴。\n冷艳照杯欺曲蘖，孤标逼砚结冰澌。\n本来难入繁华社，莫向春风怨不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月十八日蒙恩再领冲佑邻里来贺谢以长句","author":"陆游","text":"绿章封事彻虚皇，黄纸除书降野堂。\n海上春常探先到，壶中日已不胜长。\n冰衔再署仙班贵，鹤料重支玉粒香。\n便挂朝冠亦良易，金铜茶笼本相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月十三日夜作","author":"陆游","text":"风雪正相乘，萧然一点灯。\n拥炉蒙衲被，就壁倚枯藤。\n火降神方王，河潮脑自凝。\n邻鸡太多事，三唱请晨兴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月五日夜半偶作","author":"陆游","text":"草径江村人迹绝，白头病卧一书生。\n窗间月出见梅影，枕上酒醒闻雁声。\n寂寞已甘千古笑，驰驱犹望两河平。\n后生谁记当年事，泪溅龙床请北征。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月五夜风雪寒甚燃薪取暖戏作五字","author":"陆游","text":"束薪从涧底，及此不时求。\n力比鹅黄酒，功如狐白裘。\n分才具糜粥，馀事暖衾裯。\n复恐成骄惰，三更起饭牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月廿七日夜分披衣起坐神光自两眦出若初日室中皆明作诗志之","author":"陆游","text":"灵府无思踵息微，神光出眦射窗扉。\n大冠长剑竟何有，尺宅寸园今始归。\n忧患过前皆梦事，功名自古与心违。\n三峰二室烟尘静，要试霜天槲叶衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十一月四日夜半枕上口占","author":"陆游","text":"小室愔愔夜向分，幽人残睡带残醺。\n檐间雨滴愁偏觉，枕畔橙香梦亦闻。\n惊雁数声投野泽，悲笳三叠上霜云。\n年来万事俱抛尽，自笑诗中尚策勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月一日二首 其二","author":"陆游","text":"东风吹斗柄，暖律变严凝。\n草色迷残烧，溪流带断冰。\n儿书春日榜，女剪上元灯。\n莫笑蒲龛睡，山翁怯岁增。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月一日二首 其一","author":"陆游","text":"病愈都忘老，晴和已似春。\n畦蔬青长甲，塘水绿生鳞。\n酒盌论交密，丹炉作梦新。\n穷居那敢恨，幸远庾公尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月二十七日祭风师归道中作","author":"陆游","text":"虎豹生憎上九关，诸公衮衮遂难攀。\n面颜已老尘埃里，精力虚捐簿领间。\n束带敢言趋玉陛，横戈犹忆戍天山。\n新春自笑摧颓甚，鼓吹东风拜胙还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月八日步至西村","author":"陆游","text":"腊月风和意已春，时因散策过吾邻。\n草烟漠漠柴门里，牛迹重重野水滨。\n多病所须唯药物，差科未动是闲人。\n今朝佛粥更相馈，更觉江村节物新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月十九日晚巫山送客归回望西寺小阁缥缈可爱遂与赵郭二教授同游抵夜乃还楚乡偶得长句呈二君","author":"陆游","text":"送客沙头落日催，遥看重阁更同来。\n清尊与闷都倾尽，倦马和诗总勒回。\n憔悴远游悲骑省，豪华前事记章台。\n归时灯火参差晚，自脱征衣拂帽埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十二月初一日得梅一枝绝奇戏作长句今年于是四赋此花矣","author":"陆游","text":"高标已压万花群，尚恐娇春习气存。\n月兔捣霜供换骨，湘娥鼓瑟为招魂。\n孤城小驿初飞雪，断角残钟半掩门。\n尽意端相终有恨，夜寒皴玉倩谁温。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十五日","author":"陆游","text":"谁推圜镜上天东，桂影婆娑满镜中。\n天宇更无云一点，谯门初报鼓三通。\n儿童草草杯盘喜，邻曲纷纷笑语同。\n逐禄岂能无聚散，明年谁复伴衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十五日云阴凉尤甚再赋长句","author":"陆游","text":"褦襶京尘触热行，岂知世有野堂清。\n硙茶落雪睡魔退，激水跳珠凉意生。\n亹亹清风随麈柄，悠悠长日付棋枰。\n小舟先向蘋汀泊，浴罢还须泛月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十日夜月中马上作","author":"陆游","text":"身游碧海跨鲸鱼，心似寒冰贮玉壶。\n衣湿三更清露坠，眼明万里片云无。\n横空孤鹤曾相识，散发飞仙定可呼。\n老向人间无复意，逝将从此谒清都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月","author":"陆游","text":"塞向倾书槴，开炉积豆萁。\n林居得温暖，天遣养衰迟。\n瓮盎藏蔬后，锄耰下麦时。\n农家冬最乐，我老颇能知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月","author":"陆游","text":"红树平沙十月天，放翁今作水中仙。\n鼕鼕林外迎神鼓，只只溪头下钓船。\n世事极知吾有命，俗人终与汝无缘。\n菊花枯尽香犹在，又付东篱一醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月","author":"陆游","text":"十月霜侵季子裘，吾诗又送一年秋。\n风回断续闻樵唱，木落参差见寺楼。\n久已浮云看富贵，固应华屋等山丘。\n江边海际多幽致，拟跨青骡处处游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月二十四日夜梦中送庐山道人归山","author":"陆游","text":"平生不到三公府，晚岁归来五老庵。\n夙士极知成殿后，吾曹所赖作司南。\n孤舟夜泊滩声恶，小瓮晨香雪意酣。\n笑语床隅拄杖子，即今惟汝是同参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月八日九日连夕雷雨","author":"陆游","text":"雨声聒耳不停点，云气冒山殊未开。\n敢恨终年惟短褐，但惊十月有奔雷。\n牵萝且复补茆屋，饭豆何妨羹芋魁。\n莫笑赋诗无杰句，年来万事学低摧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月十九日大风作寒闭户竟日","author":"陆游","text":"霜风捲地起，落叶拥蜗庐。\n终日澹无事，一窗宽有馀。\n坐多知力耗，食少觉心虚。\n懒惰无新句，松声忽起予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月十五夜对月","author":"陆游","text":"离海月盈丈，寒光万里明。\n众星敛欲尽，一镜独徐行。\n重露滴松鬣，高风吹鹤声。\n老来殊畏冷，不尽倚阑情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月十四夜梦与客分题得早行","author":"陆游","text":"蓐食寒灯下，脂车小市傍。\n驿门犹淡月，街树正清霜。\n触目关河异，兴怀道路长。\n丈夫当自力，双鬓易苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十月晦日作","author":"陆游","text":"藤疏不覆架，桐落欲平沟。\n闰岁风霜晚，衰年日月遒。\n观书方坐石，把钓又登舟。\n不是无羁束，闲人得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜居二首 其一","author":"陆游","text":"历尽人间行路难，老来要觅数年闲。\n供家米少因添鹤，买宅钱多为见山。\n池面纹生风细细，花根土润雨斑斑。\n借舂乞火依邻里，剩酿村醪约往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜居三山已四十年矣暇日有感聊赋五字二首 其二","author":"陆游","text":"泥古衰犹学，开荒夜亦耕。\n屋芟生草盖，釜撷野蔬烹。\n白稻雨中熟，黄鸦桑下鸣。\n残云忽吐日，喜对小窗明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜居三山已四十年矣暇日有感聊赋五字二首 其一","author":"陆游","text":"薄宦非初志，幽居不计年。\n稚松成偃盖，小竖亦华颠。\n生理凭耕稼，光阴付醉眠。\n从来慕园绮，一著要争先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又明日复作长句自规","author":"陆游","text":"大学渊源不易穷，古人立志自童蒙。\n醉犹温克方成德，梦亦斋庄始见功。\n痛哭孰能悲陷溺，力行犹足变雕虫。\n太空云翳终当散，吾道常如日正中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"万州放船过下岩小留","author":"陆游","text":"画船四月满旗风，饮散匆匆鹢首东。\n醉里偏怜江水绿，意中已想荔枝红。\n断碑零落莓苔遍，幽涧淙潺略彴通。\n一疋宁无好东绢，凭谁画此碧玲珑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"万里桥江上习射","author":"陆游","text":"坡陇如涛东北倾，胡床看射及春晴。\n风和渐减雕弓力，野迥遥闻羽箭声。\n天上搀抢端可落，草间狐兔不须惊。\n丈夫未死谁能料，一笴他年下百城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丈亭遇老人长眉及肩欲就之语忽已张帆吹笛而去","author":"陆游","text":"飒飒长眉绿覆肩，欲推寿数意茫然。\n若非楚国庚寅岁，定是尧时丙子年。\n铜笛一声惊宿鹭，蒲帆数幅破晴烟。\n遥知乘醉江湖去，黄鹤楼头又放颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三三孙十月九日生日翁翁为赋诗为寿","author":"陆游","text":"正过重阳一月时，龟堂欢喜抱孙枝。\n弃襦已足惊关吏，堆笏宁惟取世资。\n落笔千言犹细事，读书万卷要深期。\n汝翁豪杰非今士，不用担簦更觅师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三山卜居三十有四年矣老身七十有五儿辈亦颇宦学未为非吉也偶作五字示诸儿","author":"陆游","text":"买地不占龟，心知百世宜。\n西邻梅福隐，南望项王祠。\n庵小偷僧样，陂长按古规。\n保家无异法，一念勿萌欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月一日府宴学射山","author":"陆游","text":"北出升仙路少东，据鞍自笑老从戎。\n百年身世酣歌里，千古功名感慨中。\n天远仅分山髣髴，雾收初见日曈昽。\n横空我欲江湖去，谁借泠然禦寇风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月二十一日作","author":"陆游","text":"蹴鞠墙东一市哗，鞦韆楼外两旗斜。\n及时小雨放桐叶，无赖馀寒开楝花。\n明月吹笙思蜀苑，软尘骑马梦京华。\n欢情减尽朱颜改，节物催人只自嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月二十二日作","author":"陆游","text":"雨过草争出，溪湍鱼逆行。\n轻舟摘莼菜，小市听莺声。\n万事已无梦，一樽犹有情。\n吾儿能讲学，不必说无生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月二十五夜达旦不能寐二首 其一","author":"陆游","text":"愁眼已无寐，更堪衰病婴。\n萧萧窗竹影，磔磔水禽声。\n捶楚民方急，烟尘虏未平。\n一身那敢计，雪涕为时倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月二十五夜达旦不能寐二首 其二","author":"陆游","text":"忧国心常折，观书眼欲枯。\n百年终坎壈，一饭且枝梧。\n忽忽残春过，迢迢清夜徂。\n壮心空万里，老病要人扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月二十日晚酌","author":"陆游","text":"暂因赐沐作闲身，太息才馀一日春。\n委地落花新著雨，穿帘归燕不生人。\n卫青此日怪长揖，王翰当年谋卜邻。\n商略晚窗须小醉，朱樱青店正尝新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十一日郊行","author":"陆游","text":"到处人家可乞浆，槐阴巷陌午风凉。\n水陂漫漫新秧绿，山垄离离大麦黄。\n父子力耕春渐老，妇姑共绩夜犹长。\n尧民击壤虽难继，芹美怀君未敢忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十六日至柯桥迎子布东还二首 其一","author":"陆游","text":"江国常年秋雁飞，吾儿远客寄书稀。\n道途一见相持泣，邻曲聚观同载归。\n草草杯盘更起舞，匆匆刀尺旋裁衣。\n从今父子茅檐下，回首人间万事非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十六日至柯桥迎子布东还二首 其二","author":"陆游","text":"我似伤禽带箭飞，更怜汝作雁行稀。\n异时恐抱终身恨，此日宁知徒步归。\n万里外应劳远梦，三年前已挂朝衣。\n断编蠹简相从老，绝念功名亦未非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三月十六日作","author":"陆游","text":"石笋街西风景幽，醉眠万事付悠悠。\n倦游我已七年客，促驾春无三日留。\n枝上蝶稀红药老，舍中蚕起绿桑柔。\n功名堕甑谁能问，羞作饥鹰夜掣韝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三年前与儿辈步过东泾小岭得胜处可营别墅贫不能成偶复至其地怅然有感","author":"陆游","text":"前年度岭踏斜阳，曾卜松阴置草堂。\n只倚气吞云梦泽，竟无钱买雪堆庄。\n烟脂菱角空频摘，火齐杨梅已再尝。\n事不如心居十九，往来常羡捕鱼郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三江","author":"陆游","text":"三江郡东北，古戍郁嵯峨。\n渔子船浮叶，更人鼓应鼍。\n年丰坊酒贱，盗息海商多。\n老我无豪思，悠然寄醉歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三泉驿舍","author":"陆游","text":"残钟断角度黄昏，小驿孤灯早闭门。\n霜气峭深摧草木，风声浩荡卷郊原。\n故山有约频回首，末路无归易断魂。\n短鬓萧萧不禁白，强排幽恨近清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三游洞前岩下小潭水甚奇取以煎茶","author":"陆游","text":"苔径芒鞋滑不妨，潭边聊得据胡床。\n岩空倒看峰峦影，涧远中含药草香。\n汲取满瓶牛乳白，分流触石佩声长。\n囊中日铸传天下，不是名泉不合尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上巳","author":"陆游","text":"残年登八十，佳日遇重三。\n帘幕低新燕，房栊起晚蚕。\n名花红满舫，美酝绿盈甔。\n春事还如昨，衰怀自不堪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上书乞祠","author":"陆游","text":"上书又乞奉祠归，梦到湖边自叩扉。\n此去敢辞依马磨，向来真惯拥牛衣。\n致身途远年龄暮，报国心存气力微。\n誓墓那因一怀祖，人间处处是危机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上元二首 其二","author":"陆游","text":"病起衰颜非昔红，偷闲聊与少年同。\n一规寒玉挂楼角，千点华星来坐中。\n久戍遗民虽困弊，承平旧镇尚繁雄。\n归时瘦马崔嵬影，定有游人笑此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上元二首 其一","author":"陆游","text":"细细香尘暗六街，鱼鳞浅碧暮云开。\n新妆褰幕全身见，误马随车一笑回。\n酒酽顿忘风力峭，夜长犹恨漏声催。\n京华旧侣彫零尽，短鬓成丝心未灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上元前一日","author":"陆游","text":"异县客游久，今年春事迟。\n峭寒增酒价，微雨恼灯期。\n老态人未觉，孤愁心自知。\n停车呼病妇，彊出伴诸儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上章纳禄恩畀外祠遂以五月初东归五首 其一","author":"陆游","text":"身似霜松老不枯，乞骸犹得侍清都。\n百钱浊酒浑家醉，六月飞蚊彻晓无。\n美睡不愁闲客搅，出游自有小儿扶。\n买山尚恐巢由笑，敢问君王觅镜湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上章纳禄恩畀外祠遂以五月初东归五首 其五","author":"陆游","text":"此身惟有一躬耕，乞得馀年乐太平。\n东观并游收昨梦，西湖重到付来生。\n一堤草露明晨照，半浦荷风飐晚晴。\n历历归途皆胜事，江亭先听棹歌声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上章纳禄恩畀外祠遂以五月初东归五首 其三","author":"陆游","text":"群玉峰头孤梦断，五云溪上野舟回。\n傍人鸥鸟自然熟，到处藕花无数开。\n麦饭不餍常面槁，柴门闲掩自心灰。\n雨来正作盆山地，不怕冥冥半月梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上章纳禄恩畀外祠遂以五月初东归五首 其二","author":"陆游","text":"黄纸淋漓字似鸦，即今真个是还家。\n园庐渐近湖山好，邻曲来迎鼓笛哗。\n笾实傍篱收豆荚，盘蔬临水采芹芽。\n皇家养老非忘汝，不必青门学种瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6614,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上虞逆旅见旧题岁月感怀","author":"陆游","text":"舴艋为家东复西，今朝破晓下前溪。\n青山缺处日初上，孤店开时莺乱啼。\n倦枕不成千里梦，坏墙闲觅十年题。\n漆园傲吏犹非达，物我区区岂足齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6615,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与儿子至东村遇父老共语因作小诗","author":"陆游","text":"桑竹穿村巷，衡茅隔土垣。\n海氛成物象，秋气肃川原。\n豆芋行将熟，鸡豚亦已繁。\n丰凶岁所有，农事更深论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6616,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与儿孙小饮","author":"陆游","text":"岁暮寒多雨，村深早闭门。\n荒园摘葵芥，近市买鸡豚。\n短褐联三世，幽窗共一樽。\n吾曹常得此，馀事不须论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6617,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与儿孙同舟泛湖至西山旁憩酒家遂游任氏茅庵而归","author":"陆游","text":"过埭维舟古柳根，却扶拄杖入烟村。\n印泥接迹牛羊过，投宿争林鸟雀喧。\n酒保殷勤邀瀹茗，道翁伛偻出迎门。\n郊居不与人间事，惟有耕桑得细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6618,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与儿辈小集","author":"陆游","text":"老子秋来乐事稠，吴粳新捣酒新篘。\n矮黄不待园官送，小白每烦溪女留。\n顿饱可怜频梦与，半酣自喜有儿酬。\n不如意事何穷已，且放团栾一笑休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6619,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与儿辈泛舟游西湖一日间晴阴屡易","author":"陆游","text":"逢著园林即款扉，酌泉煮笋欲忘归。\n杨花正与人争路，鸠语还催雨点衣。\n古寺题名那复在，后生识面自应稀。\n伤心六十馀年事，双塔依然在翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6620,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]