[{"title":"绍兴以后祀感生帝十六首 盥洗用《保安》。","author":"郊庙朝会歌辞","text":"冲牙锵鸣，肃容专精。\n交神之义，罔敢弗诚。\n设洗于阼，罍水惟清。\n盥以致洁，感通神明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36571,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"皇祐亲享明堂六首 其二 奠玉币曰《镇安》。","author":"郊庙朝会歌辞","text":"乾亨坤庆育函生，路寝明堂致洁诚。\n玉帛非馨期感格，降康亿载保登平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36572,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"皇祐亲享明堂六首 其三 酌献曰《庆安》。","author":"郊庙朝会歌辞","text":"肃肃路寝，相维明堂。\n二仪鉴止，三圣侑旁。\n灵期欣合，祠节齐庄。\n至诚并贶，降福无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36573,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"皇祐亲享明堂六首 其四 三圣配位奠币用《信安》。","author":"郊庙朝会歌辞","text":"祖功宗德启隆熙，严配交修太室祠。\n圭币荐诚知顾享，本支锡羡固邦基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36574,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大观宗祀明堂五首 配位酌献用《大明》。","author":"郊庙朝会歌辞","text":"于昭皇考，大明体神。\n宪章文思，宜民宜人。\n严父之道，陟配于天。\n躬行孝告，有孚于先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36575,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴淳熙分命馆职定撰十七首 亚、终献用《文安》。","author":"郊庙朝会歌辞","text":"总章灵承，维国之常。\n礼乐宣鬯，降升齐庄。\n竭诚尽志，荐兹累觞。\n于昭在上，申锡无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36576,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴淳熙分命馆职定撰十七首 彻豆用《肃安》。","author":"郊庙朝会歌辞","text":"于皇上帝，肃然来临。\n恭荐芳俎，以达高明。\n烹饪既事，享于克诚。\n以介景福，惟德之馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36577,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"常祀皇地祇五首 其三 奉俎用《丰安》。","author":"郊庙朝会歌辞","text":"礼崇禋祀，神鉴孔明。\n牲牷博腯，以炰以烹。\n馨香蠲洁，品物惟精。\n锡以纯嘏，享兹至诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36578,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴祀皇地祇十五首 盥洗用《正安》。","author":"郊庙朝会歌辞","text":"于穆盛礼，肃肃在宫。\n蒇事有初，直于东荣。\n涤濯是谨，惟寅惟清。\n祗荐柔嘉，享兹克诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36579,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋初祀神州地祇三首 其一 降神用《静安》。","author":"郊庙朝会歌辞","text":"膴膴郊原，茫茫宇县。\n画野分疆，禹功疏奠。\n灵祇是臻，豆笾祗荐。\n幽赞皇图，视之不见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36580,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元符祭神州地祇二首 其二 送神用《宁安》。","author":"郊庙朝会歌辞","text":"都邑浩穰，民物富盛。\n主以灵祇，昭乃丕应。\n玉帛牲牷，鼓钟筦磬。\n祗荐攸歆，归于至静。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36581,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夕月三首 其二 奠玉币、酌献用《嘉安》。","author":"郊庙朝会歌辞","text":"夕耀乘秋，功存宇县。\n金奏在县，以时致荐。\n祀事孔寅，明灵降眷。\n洁粢丰盛，仓箱流衍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36582,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴朝日十首 其一 降神用《高安》。","author":"郊庙朝会歌辞","text":"玄鸟既至，序属春分。\n朝于太阳，厥典备存。\n载严大采，示民有尊。\n扬光下烛，煜爚东门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36583,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴朝日十首 其三 降神用《高安》。","author":"郊庙朝会歌辞","text":"周祀及闇，汉制中营。\n肸蚃是届，礼神以兄。\n我洁斯璧，我肥斯牲。\n神兮燕享，鉴观孔明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36584,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴朝日十首 奠玉币用《嘉安》。","author":"郊庙朝会歌辞","text":"物之备矣，以交于神。\n时惟炎精，不忘顾歆。\n经纬之文，璆琳之质。\n灿然相辉，其仪秩秩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36585,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"熙宁以后祀高禖六首 其二 升降用《正安》。","author":"郊庙朝会歌辞","text":"郊禖之应，肇自生商。\n诞膺宝命，浚发其祥。\n天材蕃衍，德称君王。\n本支万世，与天无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36586,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"景祐亲享太庙二首 其二 酌献真宗室用《大明》。","author":"郊庙朝会歌辞","text":"于穆真皇，宅心道粹。\n和戎偃革，焕乎文治。\n操瑞拜图，封天祀地。\n盛德为宗，烝尝万世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36587,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴以后时享二十五首 其二 迎神用《兴安》。","author":"郊庙朝会歌辞","text":"圣灵在天，九关崇深。\n风马云车，纷其顾临。\n拥祥储休，昭答孝心。\n孝孙受祉，万福是膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36588,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"高宗郊祀前朝享太庙三十首 其一 皇帝入门用《乾安》。后还前殿并同。","author":"郊庙朝会歌辞","text":"于皇我后，祗戒专精。\n假于有庙，祖考是承。\n趋进惟肃，僾思惟诚。\n神之听之，来燕来宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36589,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宁宗朝享三十五首 光宗室用《大和》。","author":"郊庙朝会歌辞","text":"维宋洽熙，帝继于理。\n万姓厚生，三辰顺轨。\n对时天休，以燕翼子。\n肃唱和声，神其有喜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36590,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宁宗朝享三十五首 还位用《乾安》。","author":"郊庙朝会歌辞","text":"在周之庭，设业设簴。\n酒醴惟醹，尔殽伊脯。\n帝觞毕勺，天步旋举。\n丕显丕承，念兹皇祖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36591,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"高宗祀明堂前朝享太庙二十一首 其二十 彻豆用《丰安》。","author":"郊庙朝会歌辞","text":"歆我齐明，威德如存。\n牲牷是享，圭玉其温。\n群公执事，亦既骏奔。\n礼成告彻，咸福黎元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36592,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孝宗明堂前享太庙三首 其二 高宗室用《大德》。","author":"郊庙朝会歌辞","text":"于皇时宋，自天保定。\n高宗受之，再仆景命。\n绍开中兴，翼善传圣。\n何千万年，永绥厥庆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36593,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"皇后庙十五首 其十五 送神用《归安》。","author":"郊庙朝会歌辞","text":"明禋告毕，灵辂难留。\n升云杳邈，整驭优游。\n诚深嘉栗，礼罄钦修。\n丰融垂佑，以永洪休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36594,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"景祐以后乐章六首 其一 章献明肃皇太后室奠瓒用《达安》。","author":"郊庙朝会歌辞","text":"肃肃閟宫，顺时荐事。\n郁鬯馨香，如见于位。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36595,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"景祐以后乐章六首 其五 奉慈庙章惠皇太后室奠瓒用《翕安》。","author":"郊庙朝会歌辞","text":"祼圭既陈，酌鬯斯醇。\n音容彷佛，奠献惟寅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36596,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元德皇后升祔一首 《显安之曲》。","author":"郊庙朝会歌辞","text":"显矣皇妣，德侔柔祇。\n升祔太室，协礼之宜。\n耀彼宝册，列之尊彝。\n惟诚是厚，永佑庆基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36597,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"崇恩太后升祔十四首 入门用《显安》。","author":"郊庙朝会歌辞","text":"伣天生德，作配元符。\n仪刑壶则，辅佐帝图。\n登崇庙祏，勒号璠玙。\n烝尝亿载，皇极之扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36598,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"崇恩太后升祔十四首 彻豆用《成安》。","author":"郊庙朝会歌辞","text":"锵洋纯绎，于论鼓钟。\n周旋陟降，齐庄肃容。\n维罍既旨，维笾伊丰。\n歌彻以雍，介福来崇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36599,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上册宝十三首 罍洗用《嘉安》。","author":"郊庙朝会歌辞","text":"嘉肴旨酒，洁粢丰盛。\n既盥而往，以我齐明。\n有孚颙若，黍稷非馨。\n神之格思，享于克诚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36600,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上钦成皇后册宝六首 其五 酌献用《明安》。","author":"郊庙朝会歌辞","text":"天维显思，有相于内。\n右贤去邪，夙夜儆戒。\n猗欤追册，重翟袆衣。\n既右享之，百世是仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36601,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朝谒太清宫九首 其四 奉玉币用《灵安》。","author":"郊庙朝会歌辞","text":"琳宫奕奕，黼坐煌煌。\n玉帛成礼，飙驭延祥。\n鸿仪有则，景福无疆。\n嘉应昭协，丕犹诞扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36602,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"孝宗明堂前朝献景灵宫八首 其一 盥洗用《乾安》。","author":"郊庙朝会歌辞","text":"合宫之飨，报本奉先。\n钦惟道祖，浚发璿源。\n驾言谒款，其盥惟虔。\n尚监精衷，锡祚绵绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36603,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 还位用《乾安》。圣祖位酌献用《祖安》，高宗御制，见前。","author":"郊庙朝会歌辞","text":"皇帝瑞庆，长发其祥。\n纂系悠远，溯源灵长。\n德之克明，休烈有光。\n配天作极，孝飨是将。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36604,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 终献用《冲安》。","author":"郊庙朝会歌辞","text":"灵舆蹇骧，毕觞泰筵。\n贰飨允穆，祼将克竣。\n垂恩储祉，锡羡永年。\n将以庆成，燕及皇天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36605,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宁宗郊前朝献景灵宫二十四首 还大次用《乾安》。","author":"郊庙朝会歌辞","text":"帝假于宫，彝承清祀。\n天晖临幄，宸卫森峙。\n行繇大室，旋趋紫畤。\n率礼不违，式敷灵祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36606,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大中祥符封禅十首 其七 社首坛降神用《靖安》。","author":"郊庙朝会歌辞","text":"至哉坤元，资生伊始。\n博厚称德，沈潜柔止。\n降禅方位，聿修明祀。\n寅恭吉蠲，永锡蕃祉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36607,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祗奉天书六首 其二 奉香酌献用《瑞安》。","author":"郊庙朝会歌辞","text":"地届兴王，祥开图箓。\n典礼昭成，祺祥交属。\n大辂逶迤，卿云纷郁。\n祐我含灵，锡兹介福。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36608,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"熙宁望祭岳镇海渎十七首 其十四 送神用《凝安》。","author":"郊庙朝会歌辞","text":"我乐我神，簋俎腥饔。\n曰神之还，西土是宫。\n于蕃禽鱼，于衍草木。\n富我薮隰，滋我高陆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36609,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴祀岳镇海渎四十三首 其二 初献盥洗用《同安》。","author":"郊庙朝会歌辞","text":"青阳肇开，祀事孔饬。\n郁人赞溉，其馨苾苾。\n敬尔威仪，亦孔之则。\n神之格思，无我有斁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36610,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴祀大火十二首 其一 降神用《高安》。","author":"郊庙朝会歌辞","text":"五纬相天，各率其职。\n司礼与视，则维荧惑。\n至阳之精，届我长嬴。\n于以求之，祀事孔明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36611,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出火祀大辰十二首 其四 降神用《高安》。","author":"郊庙朝会歌辞","text":"星入于戌，与火俱诎。\n火出于辰，与星俱伸。\n一伸一诎，孰操纵之。\n利用出入，民咸用之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36612,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"景祐祀社稷三首 其三 奉俎用《丰安》。神州地祇、皇地祇与社稷通用。","author":"郊庙朝会歌辞","text":"礼崇明禋，维馨斯酒。\n洁粢丰盛，杀时犉牡。\n齐庄严祗，升燎于槱。\n其报伊何，如山如阜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36613,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴祀太社太稷十七首 太社位酌献用《嘉安》。秋社、腊太稷、土正、后稷通用。","author":"郊庙朝会歌辞","text":"叶气嘉生，年谷顺成。\n万亿及秭，如坻如京。\n奉时犉牡，告于神明。\n歌此良耜，于昭德馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36614,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴祀太社太稷十七首 彻豆用《娭安》。","author":"郊庙朝会歌辞","text":"报本之礼，载于甲令。\n灵坛昭告，神既来听。\n彻彼豆笾，精诚斯罄。\n实惟丰年，农夫之庆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36615,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"明道亲享先农十首 其五 皇帝初献用《禧安》。","author":"郊庙朝会歌辞","text":"云罍已实，玉爵有舟。\n荐于灵籍，伫乃神休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36616,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"景祐飨先农五首 其五 送神用《凝安》。","author":"郊庙朝会歌辞","text":"务啬之本，恤祀惟馨。\n神斯至止，降福攸宁。\n崇兹稼政，合于礼经。\n俎彻乐阕，邈仰回灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36617,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"先蚕六首 其四 酌献用《美安》。","author":"郊庙朝会歌辞","text":"夐哉圣神，成功微妙。\n乃兖乃裳，以供郊庙。\n百末旨酒，嘉觞自炤。\n灵徕宴飨，不嚬以笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36618,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴享先农十一首 其七 亚献用《正安》。","author":"郊庙朝会歌辞","text":"显相祀事，济济锵锵。\n举斝酌醴，神其允臧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36619,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴享先农十一首 其八 终献用《正安》。","author":"郊庙朝会歌辞","text":"殽核维旅，酒醴维馨。\n于再于三，礼则有成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36620,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"熙宁蜡祭十三首 其五 酌献用《怿安》。","author":"郊庙朝会歌辞","text":"秩秩礼文，为坛四方。\n嘉栗旨酒，百神迪尝。\n敷与万物，既阜既昌。\n伊乐厥福，传世无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36621,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 神农位酌献。曲同大明。","author":"郊庙朝会歌辞","text":"惟酒欣欣，惟神冥冥。\n是顾是飨，来燕来宁。\n耒耜之利，神所肇兴。\n万世永赖，无斁其承。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36622,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 夜明位奠玉币用《钦安》。","author":"郊庙朝会歌辞","text":"穆穆太阴，礼严姊事。\n璧玉华光，推以裒对。\n十二周天，岁乃有终。\n尽我备物，莫报元功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36623,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴以后蜡祭四十二首 后稷氏位酌献用《禔安》。","author":"郊庙朝会歌辞","text":"煌煌后稷，实配于天。\n司啬作稼，民以有年。\n匪神之私，岁以醴告。\n酌彼泰尊，于德之报。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36624,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大晟府拟撰释奠十四首 彻豆用《娱安》。","author":"郊庙朝会歌辞","text":"牺象在前，豆笾在列。\n以飨以荐，既芬既洁。\n礼成乐备，人和神悦。\n祭则受福，率遵无越。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36625,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴祀祚德庙八首 其二 初献升降用《同安》。","author":"郊庙朝会歌辞","text":"庙宇更新，轮奂丰敞。\n神灵如在，英姿飒爽。\n执事进趋，降升俯仰。\n威仪翼翼，虔祈歆飨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36626,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"淳化中朝会二十三首 三举酒用《河清》。","author":"郊庙朝会歌辞","text":"沔彼泾渎，澄明鉴如。\n清应宝运，光涵帝居。\n洞分沈璧，彻见游鱼。\n圣祚无极，神休伟与。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36627,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大中祥符朝会五首 其一 皇帝举酒用《醴泉》。","author":"郊庙朝会歌辞","text":"觱沸槛泉，寒流清泚。\n地不爱宝，其旨如醴。\n上善至柔，灵休所启。\n利泽无疆，允资岱礼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36628,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大中祥符朝会五首 其二 再举酒用《神芝》。","author":"郊庙朝会歌辞","text":"彼茁者芝，茂英煌煌。\n敷秀乔岳，寔繁其房。\n适符修贡，封峦允臧。\n永言登荐，抑惟旧章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36629,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大中祥符朝会五首 其三 三举酒用《庆云》。","author":"郊庙朝会歌辞","text":"惟帝佑德，卿云发祥。\n纷纷郁郁，五色成章。\n奉日逾丽，回风载翔。\n歌荐郊庙，播厥无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36630,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大中祥符朝会五首 其四 四举酒用《灵鹤》。","author":"郊庙朝会歌辞","text":"玄文申锡，嘉祥绍至。\n伟兹胎禽，羽族之异。\n翻翰来仪，徘徊嘹唳。\n祚圣储休，聿昭天意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36631,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大中祥符朝会五首 其五 五举酒用《瑞木》。","author":"郊庙朝会歌辞","text":"天生五材，木曰曲直。\n维帝顺天，厚其生植。\n连理效祥，成文表德。\n总萃坤珍，永光秘刻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36632,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"熙宁中朝会三首 其二 再举酒用《嘉禾》。","author":"郊庙朝会歌辞","text":"彼美嘉禾，一茎九穗。\n农畴告祥，史牒书瑞。\n击壤欢歌，如京委积。\n留献春种，昭锡善类。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36633,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"熙宁中朝会三首 其三 三举酒用《灵芝》。","author":"郊庙朝会歌辞","text":"皇仁溥博，品物蕃滋。\n庆祥回复，秀发神芝。\n灵华双举，连叶四施。\n披图按牒，永享纯禧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36634,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哲宗传受国宝三首 其一","author":"郊庙朝会歌辞","text":"于穆我王，继序不忘。\n明昭上帝，上帝是皇。\n长发其祥，惠我无疆。\n受命于天，既寿永昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36635,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"绍兴朝会十三首 三举酒用《瑞粟呈祥》。","author":"郊庙朝会歌辞","text":"至治发闻惟馨香，播厥百谷臻穰穰。\n农夫之庆岁其有，禾易长亩盈仓箱。\n时和物阜粟滋茂，嘉生骈穗来呈祥。\n自今以始大丰美，行旅不用赍糇粮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36636,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"治平皇太后皇后册宝三首 其一 皇帝升坐用《乾安》。","author":"郊庙朝会歌辞","text":"王化之始，治繇内孚。\n时庸作命，玉简金书。\n磬筦在庭，其纵绎如。\n天临法扆，礼与诚俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":36637,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]