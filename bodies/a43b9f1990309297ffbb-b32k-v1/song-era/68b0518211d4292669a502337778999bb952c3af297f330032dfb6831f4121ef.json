[{"title":"寿范漕 其一","author":"吴泳","text":"粲粲桐花昨夜风，吹香还到鹿园中。\n前生出处黄山谷，后代风流范蜀公。\n洒落一襟涵霁月，精神满面贯晴虹。\n直须整顿坤维了，归侍祥云一朵红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿范漕 其二","author":"吴泳","text":"自从绣绂解麒麟，一片忠诚只为民。\n涪水竹枝秋送客，汉嘉火树夜迎神。\n玄蜂赤蚁三垂静，白黍黄鸡万井春。\n尽使蜀人翻覆看，皇华礼乐只如新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿范漕 其三","author":"吴泳","text":"伏波老子缚长虬，典护兰闱更两秋。\n学问只从苗脉看，辞章不向语言求。\n俱称脚迹门生好，无复颜行执事羞。\n夹袋中间富人物，更须为国贡琳球。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿某翁","author":"吴泳","text":"当日麻衣抑未猜，贵公元自有仙材。\n文辞敏妙真星魄，学问沈潜是圣胎。\n黄石授兵非有意，红旗破贼却归来。\n阿同且共玻瓈饮，源上桃花想未开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿胡兴元三首 其三","author":"吴泳","text":"耿耿三秋别，悠悠四月馀。\n菊潭闻上寿，梅驿急驰书。\n簇蘤红成阵，骈筵翠曳裾。\n封侯平四十，前路尽宽舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿胡兴元三首 其二","author":"吴泳","text":"皂盖开藩日，黄河洗甲时。\n柳阴承羽葆，花气扑旌麾。\n兵悍须柔止，民碞莫胜之。\n麦头如得雪，来岁可休师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿胡兴元三首 其一","author":"吴泳","text":"几代贞元会，还生忠简孙。\n清风拔薤本，爱日护葵根。\n疋马驰周道，分公翰蜀门。\n保安桥上路，手涤瘴云昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿崔侍郎三首 其三","author":"吴泳","text":"小队元戎未弭旌，群飞鹤雁已充庭。\n只缘匹马修途健，唤起三刀昨梦醒。\n犀麈自挥坤宇静，鲸风不涨海波停。\n牛头衮衮春无际，捻出三诗寿蜀星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿崔侍郎三首 其二","author":"吴泳","text":"胸次知蟠几监书，事随天理只平铺。\n来从京兆德星社，揽取西峨明月湖。\n民岂无衣须补绽，极元有柱要撑扶。\n欲知天授西平意，绣帽临戎为万夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿崔侍郎三首 其一","author":"吴泳","text":"天开碧落洗云扉，暂辍仙郎下紫微。\n独有素琴随从橐，更无侍史护朝衣。\n霜清潦净荣名薄，枣熟花香道力肥。\n列炬照空还岁晚，明年仍傍火城归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张仁溥寄游沧浪诗用韵一首非为沧浪作也","author":"吴泳","text":"卉木萋萋二月寒，杏垂红雨涕浪浪。\n无司花女太幽绝，有索酒郎多醉狂。\n弄影莫陪张子野，断肠空忆贺横塘。\n春来亦欲寻诗社，却怕诗工与道妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沔州和李长孺","author":"吴泳","text":"朔风吹雨湿征衣，卿月西升伴紫微。\n出塞未经榆眼白，宿师先喜麦头肥。\n宝刀尚可屠龙去，锦字何缘寄雁归。\n犹学骚人工索句，品题香草咏菲菲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张亨泉宴鹿鸣","author":"吴泳","text":"平生湖海独元龙，门作丹梯倚太空。\n还我蛾眉千顷月，借渠羊角一帆风。\n文随脚迹机难活，学到源头理自通。\n何代不生田表圣，诸君切在敏前功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张周玉访别","author":"吴泳","text":"白露下百草，年光惊易徂。\n邮亭人折柳，别浦雁衔芦。\n社瓮应藏酒，秋盘好斫鲈。\n贤渠陶靖节，晚岁觉迷涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张周玉峨眉山行","author":"吴泳","text":"支筇更上最高峰，浮出修眉翠扫空。\n雪汁半消岩路口，苔衣倒挂树林中。\n异禽语已非人世，香草名应系国风。\n晚色渐侵衣袂冷，恍疑身在蕊珠宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李宪使 其二","author":"吴泳","text":"比岁兵戈息，山民幸有秋。\n麦畦翻雨种，瓜圃带霜收。\n墐户夕熏鼠，荷蓑晨饭牛。\n使家廉到骨，清议在锄耰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和李宪使 其一","author":"吴泳","text":"关上青牛去，林间白鹤归。\n月函书味澹，霜浸道根肥。\n草树连生色，鱼梁閟杀机。\n晚年偏好易，落处是麻衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和杜枢密雪 其一","author":"吴泳","text":"紫宸朝动鸡人唱，一片天光接绛河。\n花样绣鞯冲晓去，霙铺毬路带春多。\n边无疋马比宁地，土有遗蝗奈冻何。\n檠重玉龙犹未老，莫将图画写披蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和杜枢密雪 其二","author":"吴泳","text":"一自金銮陡下坡，更无津可问明河。\n云蒸黄野风寒薄，雪皎皓庭幽思多。\n高艳未能攀屈宋，寒灰聊复拨阴何。\n聚星堂上如相问，竟日长镵对短蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和制垣金泉山","author":"吴泳","text":"昔日南充县，卑栖枳棘鸾。\n道根随境悟，屐齿过桥寒。\n梦觉松花白，重来鹤顶丹。\n仙翁梨枣熟，亦欲傅脩翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和洪司令九日观阅 其二","author":"吴泳","text":"剑花弓月几秋寒，宿将凋零更不坛。\n师众弗于先事戒，蒐田祇作具文看。\n戍还黎雅魂方定，箭洗褒斜血未乾。\n为报道傍泥饮者，尹来遗汝百年安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和洪舜俞太一宫韵","author":"吴泳","text":"祠事归来夜向晨，仰瞻天宇肃无尘。\n瓶搊金井辘轳晓，钟撼茅山幡影春。\n傍水且栽梅半树，扫檐莫使雪横陈。\n柏台近日清无酒，赢得吟诗分外新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晏子忠 其一","author":"吴泳","text":"天地肇开辟，江山谁主盟。\n岸深沙走白，石秀水含清。\n鱼自春来美，猿虽晓不惊。\n汀洲生杜若，薄欲采其英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晏子忠 其二","author":"吴泳","text":"每逢耆旧问，誇说太平年。\n橘柚三冬富，荷花万顷联。\n断岩书姓氏，胜迹已蹄筌。\n群盗方如猬，渠鞭恐著先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晏子忠 其三","author":"吴泳","text":"我往才秋莫，君来恰岁寒。\n离鸿书落莫，归马路平宽。\n白社论心易，文坛出手难。\n近来诗思涩，风雪立雕鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和虞沧江饯腊观梅 其二","author":"吴泳","text":"饯岁江梅老树边，每逢佳处辄犁然。\n吟风弄月成劳绩，种药移花当贸迁。\n心事细评无此日，春风长健有明年。\n更期人日连头去，酬此青蘋木末天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和虞沧江饯腊观梅 其一","author":"吴泳","text":"买断江天不用赊，弦琴觞咏乐无涯。\n年深屡见巢添鹤，春到还知未放花。\n时有诗情窥洛社，断无书尺到京华。\n面前杨柳风来处，豪岸依然属富家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和韵谢惠提干约观梅不赴","author":"吴泳","text":"才看花回晚日明，停杯不饮槊空横。\n羡君洒落方成趣，笑我虺隤不及盟。\n但向舍南窗北看，浑如林下水边清。\n自来太素先群物，枉被山矾唤作兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"径山留赠无准","author":"吴泳","text":"十载京华少得閒，兹游浑似梦中山。\n僧行古道元无径，云掩重扉更不关。\n夜语浓时花簇簇，禅机漏处月湾湾。\n东坡妙喜无人识，往往神游在世间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"试院和李湛溪韵","author":"吴泳","text":"呵叱星辰赋远游，更提水镜著中流。\n读书有眼月千里，爱士无方春九州。\n论及养生浑是道，时因主试却关愁。\n武夷不作逢溪老，亦欲临风助击鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客中和程丞相雪","author":"吴泳","text":"萧萧客岁澹如家，耿耿青灯冻不花。\n窗外晓添梅意韵，田间春透麦精华。\n书来颇复怀归雁，杯散何繇觅画蛇。\n明日雪晴乡社去，辛盘随俗点春茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣城劝农","author":"吴泳","text":"一分东作五分春，相汝耕夫更在勤。\n七月诗成种田法，庶人章作劝农文。\n祈蚕必使蚕如瓮，卜稼须观稼似云。\n老守别无新治行，只将丰岁答吾君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣城宴六县宰","author":"吴泳","text":"本是词林翰墨臣，诏书特遣牧宣城。\n使君只办平平政，令尹无要赫赫名。\n狱苟得情须近恕，财如足用莫求赢。\n荻花风起江防急，秋阅应令弩手精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣城鹿鸣宴","author":"吴泳","text":"儒臣簪笔典州麾，重为江山缉旧仪。\n宴序古来元有礼，鹿鸣废后更无诗。\n科名到手还须耐，文字当场莫好奇。\n更尽工歌笙一曲，明年春洒上林枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洪都病中口占","author":"吴泳","text":"去年舆疾上洪州，百感婴怀又怕秋。\n病体不因衰后觉，宦情谁向死前休。\n乞身已晚荒三径，葬子无期负一丘。\n造物傥从心所欲，乐天知命更何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送杨子达入国学","author":"吴泳","text":"鸾凤久束咮，贤关时一鸣。\n子今观上国，志岂为浮名。\n母线丝丝直，爷诗字字情。\n别离非所惜，回看锦衣荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送洪司令 其一","author":"吴泳","text":"经年分月伴西清，又佐戎轺勇北征。\n下马必能书檄草，从军元是擅诗名。\n熙丰作俑能无过，元祐操舟却要平。\n局面既新棋势别，消详专在幕中评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送洪司令 其二","author":"吴泳","text":"夏日曾随别驾归，朔风还作送公诗。\n行军司马自文采，祭酒诸生亡崛奇。\n国事急忙中着手，边筹閒暇处开眉。\n嘉陵想已波涛落，风雨无忘泊岸时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送洪司令赴阙","author":"吴泳","text":"曾记嘉陵共舣舟，江风又是荻花秋。\n三年长别不一见，十事欲言还九休。\n頫聘交驰淮水浊，行程不定陇云愁。\n凤鸣已向朝阳去，飞雨残霞湿柁楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送梁漕东归 其二","author":"吴泳","text":"皎皎从来世不容，平平未足与言功。\n介言西事何妨谪，洵著权书竟是忠。\n祇为边民忧自北，卷将吾道载而东。\n分明自有天知己，趣檄行看骑火红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送鲜于帅三首 其三","author":"吴泳","text":"忆昨行台再见时，恍兮涪水送将归。\n丰神比旧微加瘦，道力于今转觉肥。\n赖有一灯标日指，曾无寸草报春晖。\n孔门独立成何事，祇舞风雩咏浴沂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送鲜于帅三首 其二","author":"吴泳","text":"时事牵连卒未休，三边烽火又惊秋。\n养鹰未得鹰扬力，豢虎终怀虎视忧。\n面势只缘前局误，肘方合向古人求。\n玉关不是无兵守，上策人心要急收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送鲜于帅三首 其一","author":"吴泳","text":"载锡圭符起伏龙，遄提小队出南中。\n军容倒海鲸波息，旗采吹云蚓瘴空。\n但倚硕才为保障，仍开诚意接兵戎。\n渡泸已觉秋风晚，争看筹边第一功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王夫人","author":"吴泳","text":"婉娩娴诗画，僮僮被典章。\n有齐先祭洁，薄浣展衣香。\n唁卫心虽切，伤周义不忘。\n勉哉君子正，彤管尚遗芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李寺丞","author":"吴泳","text":"文献中原旧，箕裘户部清。\n官终一麾守，事历五廷评。\n挂壁琴无谱，传家砚有名。\n东风吹画翣，溪上若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽李郎中 其二","author":"吴泳","text":"河洛辍微响，朱张传古心。\n世随人影落，君向路头寻。\n蔓草侵山径，柔荑死树林。\n良朋更能几，百感集孤斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽罗宗卿","author":"吴泳","text":"晓月璿源澹，春风璧水香。\n一条冰透骨，五色凤鸣岗。\n翳彼菟裘老，伤哉宝鉴亡。\n囊封尚生意，今与日争光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郑夫人","author":"吴泳","text":"淑行繇真履，慈根自夙知。\n性情诗调适，内外礼维持。\n春閤青蘋乱，秋原白木悲。\n只今哀窈窕，手线授衣时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽郑文昌","author":"吴泳","text":"何代无豪杰，惟公气独刚。\n束身同绞紟，遗训辟缁黄。\n定力老逾壮，英魂凛不忘。\n蜀名省科调，犹说郑文昌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽青阳俞夫人","author":"吴泳","text":"彼美宜家室，之媛友瑟琴。\n漆园歌未歇，澧浦佩还沉。\n懿范贻彤管，佳铭得藁砧。\n卧龙山下路，风雨乱愁心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽贵平大夫","author":"吴泳","text":"介介汝溪叟，青衫三十年。\n澹如彭泽柳，廉过石门泉。\n漫仕曾无意，遗文竟有传。\n浮山读书处，定跨玉蜍仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽游监簿 其二","author":"吴泳","text":"昔上金泉去，翁方玉局閒。\n橘中春响雹，壶里晓行山。\n迂叟空扶杖，坡仙不赐环。\n每思生处所，壮泪为公潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽游监簿 其一","author":"吴泳","text":"好汉三巴杰，危言九陛忠。\n王前留孟子，国尔念周公。\n日驭龙堆出，天昏虎踞雄。\n收声诸老尽，铭有后溪翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽雍处士","author":"吴泳","text":"折柳诗名远，滋兰德本深。\n挞禽能起孝，训鲤只平心。\n半夜酒星落，千山薤露吟。\n芭蕉溪上水，呜咽不堪斟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中有怀","author":"吴泳","text":"二年多病少佳怀，酒落杯中见影猜。\n青女降霜溪屋冷，白姑记日命宫灾。\n柳州解祟祟频作，孙子逐痁痁转来。\n就使新春年运吉，钝庚难拨马头开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读黄子实诗卷","author":"吴泳","text":"唐人漫自说金华，山谷云孙自当家。\n玄色酿成真一酒，别机织出象生花。\n缅怀友义留巫峡，难割闺情下汉嘉。\n看彻一编酬未得，夜深窗月净笼纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题蒋湾效尧夫体","author":"吴泳","text":"刚把西湖卖与邻，卜园新得蒋湾春。\n半荒亭树景偏老，欲压溪桥花更真。\n漫赋莫教诗过好，浅斟时要酒轻醇。\n若能会得閒中趣，便是羲皇向上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清晓踏雪送季武博","author":"吴泳","text":"送客陵阳第一峰，临分莫遏顺帆风。\n人行水驿梅花外，诗在昭亭雪界中。\n破屋但留黄檗老，高风难觅紫芝翁。\n笋舆访别惊回首，无数寒鸦点碧空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪夜","author":"吴泳","text":"云蒸黄野润，月瑩皓庭清。\n夜静悄人迹，溪流皆雪声。\n帐吹灯彩暗，炉扑火花明。\n遥想鸡人误，鸣歌报六更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄漕祠堂","author":"吴泳","text":"古谊寥寥千载间，却从宾主得窥斑。\n道同元不分穷达，礼重何妨尚往还。\n拄杖过桥声易识，壁纱笼墨句难攀。\n篝灯试取丰碑读，名压三犀石更顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖亭酌王史君纪事并呈看花诸君子","author":"吴泳","text":"红雨斑斑点嫩苔，朱轮轧轧碾轻埃。\n园公不作橘中隐，康节肯从花外来。\n莺啭树林添道韵，鸥分江色献诗材。\n篮舆便载春归去，谁管酴醾芍药开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢尊固送茶","author":"吴泳","text":"閒居早是宾俦寡，有弟山行访鸟窠。\n黄卷渐成迂叟僻，朱颜不似美人酡。\n诗因怕事吟偏少，酒为看花饮辄多。\n珍重山园芳茗饷，犹胜乡国赵家坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪亭春日 其二","author":"吴泳","text":"春事无边著语难，得逢佳处辄停骖。\n河豚渐美誇梅十，芳草如屏说柳三。\n小韵作诗防跌宕，浅杯斟酒怕沉酣。\n买山那得青钱在，只欲花间结小庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉熙丁酉七月上浣游大涤题住山龚冲妙艮泓轩","author":"吴泳","text":"旧与清泉白石盟，身閒方作洞霄行。\n青山延客元无锁，碧涧流花似有情。\n古洞欲随仙隐去，高冈终待凤来鸣。\n道人唤我松间饮，坐拂寒云月未生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端平改元阳月同弟某自南山过龙井山僧饶舌话辩才近事且以某兄弟为坡颍当有所识因赋","author":"吴泳","text":"一百年前老辩才，复褰绦带下山来。\n松杉溜雨惊龙起，篁竹生风唤鹤回。\n戒行净通林水观，语言香落宝花台。\n更看坡颍留诗处，月堕山空眼豁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霅溪舟中读唐人诗","author":"吴泳","text":"大雅声才息，骚人词竞兴。\n语工终离道，味泊祇如僧。\n霜夜杜荀鹤，秋风张季鹰。\n抚编吟魄动，飞雨洒船灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":44550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]