[{"title":"悼鹤","author":"魏野","text":"谁折仙禽足，经旬致枉终。\n雠宜天与报，恨使我难穷。\n风月犹疑惨，园林顿觉空。\n殷勤亲起冢，只在草堂东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晨兴","author":"魏野","text":"夜长乞待得晨兴，耽睡童犹唤不应。\n烧叶炉中无宿火，读书窗下有残灯。\n临阶短发梳和月，傍岸衰容洗带冰。\n料得巢禽翻怪讶，寻常日午起慵能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪中书事上李阶殿院","author":"魏野","text":"草堂高迥乐郊东，西望支筇景莫穷。\n山水城池云叶里，管弦楼阁雪花中。\n须知应瑞因仁政，不独呈祥自帝功。\n太守多才又多暇，唱酬翻怯见诗筒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜大孙状元见访","author":"魏野","text":"道同忘贵贱，陋巷每频看。\n相见唯呼字，留题不著官。\n狂吟无所忌，静坐有馀欢。\n却恨归公署，茅堂会宿难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜岐贲王闱见访","author":"魏野","text":"久别思方切，同来宿弊庐。\n闲听一夜话，胜读十年书。\n拙喜交情在，贫惭主礼疏。\n共嗟高会少，且愿更踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜怀古上人见访","author":"魏野","text":"隔岭僧来宿，闲同倚石楼。\n漏声过半夜，月色近中秋。\n雅道玄须到，权门险莫游。\n此心方共适，明月更相留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渭上秋夕闲望","author":"魏野","text":"秋夕满秦川，登临渭水边。\n残阳初过雨，何树不鸣蝉。\n极浦涵新月，孤帆没远烟。\n渔人空老尽，谁似太公贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游蓝田王顺山晤真寺","author":"魏野","text":"蓝田王顺升仙处，白傅曾题似更稀。\n野客暂游期欲住，山禽何事叫思归。\n称心不独烟霞媚，适口仍逢笋蕨肥。\n两日正当寒食日，家园忘却有芳菲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"疏小渠","author":"魏野","text":"分得前溪水，萦纡绕砌流。\n清泠虽可乐，呜咽不关愁。\n静称浮花片，闲宜泛酒瓯。\n却嫌川上看，时复有沉舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登龙门县楼与知宰刘大著将话别因有题纪","author":"魏野","text":"名士为官处，登楼景好题。\n县城蚕市闹，村墅鹊巢低。\n日暖园蔬嫩，烟晴垄麦齐。\n长宜同此望，那忍话分携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登原州城呈张蕡从事","author":"魏野","text":"异乡何处最牵愁，独上边城城上楼。\n日暮北来唯有雁，地寒西去更无州。\n数声塞角高还咽，一派泾河冻不流。\n君作贫官我为客，此中离恨共难收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢长安孙舍人寄惠蜀笺并茶二首 其二","author":"魏野","text":"谁将新茗寄柴扉，京兆孙家小紫微。\n鼎是舒州烹始称，瓯除越国贮皆非。\n卢仝诗里功堪比，陆羽经中法可依。\n不敢频尝无别意，却嫌睡少梦君稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢长安孙舍人寄惠蜀笺并茶二首 其一","author":"魏野","text":"彩笺一轴敌琼瑰，喜见亲题手自开。\n远胜浣花人寄到，贵从视草客分来。\n百张重叠霞初卷，十色参差锦乍裁。\n红药篇章方雅称，老夫无用拟封回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢冯亚惠鹤","author":"魏野","text":"慇勤亲惠鹤，迢递自江濆。\n情性浑如我，精神酷似君。\n舞思同座看，唳想隔城闻。\n从此添诗景，为题好共分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢乔职方惠书","author":"魏野","text":"珍重君郎一纸书，亲书何啻敌琼琚。\n便回岂易逢归雁，频看应难长蠹鱼。\n先寄路经千里外，后批情更万重馀。\n静思贵不忘贫贱，当日荆州亦未如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢刘小谏寄惠双鹤","author":"魏野","text":"令威兄弟涉烟波，谏署人教到薜萝。\n毛比君情犹恐少，格如我性不争多。\n相呼似说冲霄意，对舞初闻击壤歌。\n仙术无能骑谢去，青云未免阻闲过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢孙状元寒食见赠","author":"魏野","text":"一首状元诗，封来到竹扉。\n读留寒食烛，拜换道家衣。\n誉过心无愧，酬迟礼转非。\n闲思播琴里，谁更会玄微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢孙紫微同郡侯石太尉见访","author":"魏野","text":"谁共东郊访懒魁，一时文武尽奇才。\n朱衣列到柴门住，皂纛随穿竹径来。\n乍照儿童戈似雪，忽惊猿鹤鼓如雷。\n眼看两地翱翔去，溪上无由更接陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢师刑部见召","author":"魏野","text":"锦帐公馀后，纱巾召见初。\n一言忻契合，三拜愧生疏。\n渐见诗多拙，方知誉转虚。\n犹能时遣吏，相问到贫居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢何学士王专推官王道士同见访","author":"魏野","text":"闲离锦帐带纱巾，谁从东郊访隐沦。\n旧在幕中珠履客，新游门下羽衣人。\n扫苔虽是开三径，采蕨何繇致八珍。\n太史还应怪躔次，郎官星犯客星频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢呈寇相公召宴","author":"魏野","text":"两度为霖六镇临，春残公暇宴棠阴。\n周瑜辩乐宁妨醉，裴度论兵不废吟。\n五色诏书丹凤降，十香御酒翠娥斟。\n野人每喜陪樽俎，三入唯愁阻访寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢张中允见访","author":"魏野","text":"园林花未发，岂是为游春。\n深愧青宫客，先寻白屋人。\n儿童惊茜绶，仆隶笑纱巾。\n踏雪携诗谢，朱门必许亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢潘阆寄惠白鸡","author":"魏野","text":"远惠鸡同雪，应图警卧云。\n如君鸣有信，似我素无文。\n映树迷蟾彩，临流杂鹭群。\n朝昏何所恨，不共隔篱闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新井","author":"魏野","text":"林间凿井新，里巷汲来频。\n及见赢瓶者，翻思抱瓮人。\n乍尝牙觉冷，试煮茗尤珍。\n从此前溪水，潜轻似不仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新栽竹","author":"魏野","text":"苍翠两三枝，亲和冻块移。\n旋吟酬得处，就刻记栽时。\n已任雪频洒，未禁风苦吹。\n幽人心自足，千亩复堪嗤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新栽苇","author":"魏野","text":"临砌复临流，栽初尚未稠。\n长因带风雨，远似在汀洲。\n静閒宜红蓼，闲栖称白鸥。\n前春应更好，江上梦潜休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新晴书事上知府宋谏议","author":"魏野","text":"美化何因见，民歌处处同。\n雨申诸县足，狱奏半年空。\n郡阁烟光里，人家霁色中。\n偶吟知浅拙，将献愧明公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬闰师见赠","author":"魏野","text":"绝唱知难继，因兹久滞淹。\n隔年酬不得，终日诵无厌。\n㬠曝偏防蠹，收藏别著签。\n偶吟聊报谢，迟拙莫相嫌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬和知制诰孙舍人见寄","author":"魏野","text":"也知皇宋足名人，至论谁堪继后尘。\n已见世传元相制，将闻诏写白公真。\n紫微星宿虽潜望，红药阶除岂易亲。\n野客多惭惠佳句，强酬应信废精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬和知府李殿院见访之什往来不休因成四首 其四","author":"魏野","text":"虽喜乘骢到水村，却愁诗敌势难亲。\n平生未竖降旗客，临老将为弃甲人。\n豸角勇无心害物，鸡皮怯有汗沾巾。\n数篇勉和情枯竭，潦倒词锋息战尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬和知府李殿院见访之什往来不休因成四首 其三","author":"魏野","text":"使君误访乐郊民，顾我何由得暂亲。\n茜旆动驱千百骑，茅亭才著两三人。\n旋烧陆羽烹茶鼎，忙换陶潜漉酒巾。\n可爱水边松竹上，数朝犹自有香尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬和知府李殿院见访之什往来不休因成四首 其二","author":"魏野","text":"玉韵重听倍爽神，银钩忽睹更躬亲。\n郡侯喜是风骚主，野客惭为唱和人。\n积雾曾侵红绣旆，异香犹惹白纶巾。\n两篇箧里贞珉上，频拂看宁有蠹尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬和知府李殿院见访之什往来不休因成四首 其一","author":"魏野","text":"暂拥红旌到郡新，相知情似旧交亲。\n尽惊慷慨山河主，忽访支离草泽人。\n苏径让惭扬绣袂，溪桥迎喜整纱巾。\n留诗中贵仍挥翰，双美应难继后尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬和提刑王国博见寄兼谢惠竹簟","author":"魏野","text":"召伯城边劳梦想，滕王阁上动诗心。\n闲思已隔江山远，老别那堪岁月深。\n三径出稀青草合，双眸望久墨花侵。\n翻嗟珍簟虽蒙寄，早晚同将坐卧吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬谢商秘丞见赠诗牌","author":"魏野","text":"初得春方暖，今来岁已阑。\n紫泥辞却易，白雪和终难。\n频拂心宁倦，时吟齿觉寒。\n会须亲谢去，闲拄折鱼竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬赠绛台钱太尉见寄","author":"魏野","text":"分符不独得民誇，玉署清华有棣华。\n重耳山河初作主，阖闾宫阙旧为家。\n风飘楼阁高低乐，日照池塘上下花。\n多谢到州农未劝，双金先沐寄烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮冬郊居怀李安","author":"魏野","text":"草屋松篁杪，寒多市井閒。\n严风生北户，爱日落南山。\n下第人何处，林居鸟自还。\n琴樽虽在侧，难以解愁颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮春雨中作","author":"魏野","text":"独院信寥寥，蚕生谷未苗。\n残春无数日，积雨复连宵。\n不恨流光速，唯伤去圣遥。\n那堪当此景，时见落花飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮秋怀王专臧奎王衢三从事","author":"魏野","text":"旧友各西东，閒思兴莫穷。\n尽居花幕下，独在竹林中。\n白屋贫虽异，清宵梦想同。\n吟馀遥望处，寒雨正濛濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮秋闲望","author":"魏野","text":"水阁闲登望，郊原欲刈禾。\n坏檐巢燕少，积雨病蝉多。\n砧隔寒溪捣，钟随晚吹过。\n扁舟何日去，江上负烟蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题陕府同判衙吏隐亭","author":"魏野","text":"小亭高岸上，危绝复何言。\n墨迹唐丞相，诗牌宋状元。\n山形连二华，河势泻三门。\n吏隐真宜此，无穷景满轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题鄠县杨氏书楼","author":"魏野","text":"竹多千亩馀，卖竹济贫儒。\n门掩圭峰影，楼添鄠县图。\n蜗涎缘栋有，鹤迹入泉无。\n终约重来此，相邻卜养愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"薛端公寄示嘉川道中作次韵和酬","author":"魏野","text":"绣衣不间薜萝衣，春暮嘉川入咏思。\n忆我茅庐攲枕处，当君骢马著鞭时。\n展眉喜近龙头境，回首伤遥鹤发期。\n从此亲题山馆里，多情顿掩浪仙诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠三门漕运钱舍人","author":"魏野","text":"相知有宿缘，一见两忻然。\n我拙宜名野，君廉恨姓钱。\n唱酬思阁笔，迎送愧楼船。\n却恐徵归阙，慵过砥柱边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠华山何学士致仕","author":"魏野","text":"累表乞眠云，明君始许君。\n三峰同鹤住，半俸与僧分。\n益寿药谁得，朝元香自焚。\n承家多令子，冠盖世纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠安邑知县方寺丞","author":"魏野","text":"寻常少往还，门静似居山。\n书为传家秘，琴因国忌闲。\n坐衙更鹤氅，行乐到禅关。\n约我休官后，邻居竹树间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠岐贲推官","author":"魏野","text":"动静不违书，如君始是儒。\n婢闲犹画卦，儿戏亦投壶。\n门冷僧长往，官清道更孤。\n吾君能大用，皇宋即唐虞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠颍阳知县刘烨著作","author":"魏野","text":"门风是相门，积庆岂须论。\n祖德书仪在，科名榜贴存。\n政声闻牧竖，墨迹见花村。\n物论将徵用，多应入谏垣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠薛田察院兼呈刘大著","author":"魏野","text":"居丧贫御史，家近亦难归。\n却恐诏起复，如何赎绣衣。\n仆夫潜去尽，亲友频来稀。\n惟有刘东观，时时扣掩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醍醐鸟","author":"魏野","text":"解啼能解酌，啼处静堪听。\n林下虽沽酒，人间最独醒。\n石泉窥认瓮，花露饮为瓶。\n翻叹耽杯者，还应损性灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上知府李殿院十韵","author":"魏野","text":"诏选来棠树，花骢拥旆乘。\n饥民期再活，寒士贺中兴。\n廌角谁伤触，狼心自战兢。\n只求天子信，宁避世家憎。\n窃听无馀论，唯愁有急徵。\n每因公宴乐，方遣妓祗承。\n才薄终难纪，情深岂易胜。\n相亲容似鹤，不拜许如僧。\n郡阁招看雪，溪亭访蹑冰。\n转愁诗老退，何以答褒称。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上知府赵侍郎二首 其一","author":"魏野","text":"往哲英灵在，重生出镇初。\n傅岩存旧迹，棠树认前居。\n美化民歌实，流言帝觉虚。\n暂来淹外郡，再入老中书。\n善欲皆升举，奸思尽剪除。\n登科嗤负鼎，避事鄙悬车。\n权助天生杀，才随道卷舒。\n百官凭整肃，万物待吹嘘。\n接士殊龙板，寻僧却隼旟。\n嘉谋常启沃，谏草旋焚如。\n赤子方安枕，黄巾亦荷锄。\n囚无经宿禁，农有数年储。\n山势朝衙署，河声贯里闾。\n野人携此咏，将献几踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上知府寇相公","author":"魏野","text":"文武禀全才，何人更可陪。\n有官居鼎鼐，无宅起楼台。\n圣主诗方和，亲王状始回。\n镇临求二陕，调燮辍三台。\n凤阁须重去，龙旌暂拥来。\n下车三度雨，上事数声雷。\n未暇瞻圭璧，先蒙访草莱。\n几思趋相府，恐惧复徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上知府鲍少卿","author":"魏野","text":"五福三朝客，同年想少存。\n立功从太祖，卧里见曾孙。\n易进因仁政，难休为帝恩。\n权临二陕重，官处九卿尊。\n烟翠甘棠柳，风清画戟门。\n四门潜遂意，百吏动惊魂。\n不病轻丹曶，无愁鄙酒樽。\n出衙清道路，在宅素盘飧。\n上马身犹健，看书眼未昏。\n狱空时拥旆，多谢到山村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上解梁潘学士十韵","author":"魏野","text":"尽继祖风流，其如鬓未秋。\n石渠陈表让，山郡折资求。\n舜禹城分界，神仙岳映楼。\n淫祠随处毁，学校逐乡修。\n密疏多亲写，狂诗少自收。\n通宵营有乐，度岁狱无囚。\n酒席围红粉，盐池照碧油。\n药同方士炼，壶共野僧投。\n瓦砾今徒献，琼瑶旧未酬。\n几多怀抱事，欲去复迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灯花","author":"魏野","text":"岂假栽培力，自然殊众芳。\n开非因雨露，落不为风霜。\n鸡似残莺啭，蛾如宿蝶狂。\n丹心尘岂染，明焰雾难藏。\n堕睫客看懒，画眉人剪忙。\n杏园游宴者，曾借我馀光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吾友山阳蹇子韫尝游颍上言彼之居人有许氏者富不因贪学非求进于郡之西手植众木郁然成林林下搆亭壮而不丽郡倅黄公宗旦皇宋有名之士也常造焉上阙歌诗以旌其美故俾予请诗于子吾以子韫之请诗于予八十言以寄题","author":"魏野","text":"道胜富如贫，亭临颍水滨。\n一瓢思祖德，三径与僧邻。\n虚白虽同性，丹青不似身。\n趋庭知有子，下榻岂无人。\n纫佩兰多老，成蹊李尽珍。\n开筵回雪少，联句聚星频。\n家谱书难备，州图画不真。\n遥题应未的，莫把刻贞珉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王衢见寄","author":"魏野","text":"久向东郊住，渐同麋鹿情。\n游山岐路熟，见寄礼仪生。\n藜杖新仍重，荷衣破转轻。\n身犹为外物，诗亦是虚名。\n自爱闲无敌，谁忧道未行。\n绝疑疏日者，相许愧时英。\n穷易怜无著，围棋恶有争。\n唯应心友至，林下笑相迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和宗人见寄","author":"魏野","text":"兀坐几忘形，柴门夜不扃。\n稔怜丞相雨，瑞爱老人星。\n妻识琴材料，童谙鹤性灵。\n远山延颈望，疏竹枕肱听。\n祖业存圭窦，年支有茯苓。\n閒身寄精舍，狂迹在旗亭。\n养药依丹诀，尝茶验水经。\n何时得相见，静话向松庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏菊","author":"魏野","text":"荣虽同雨露，晚不怨乾坤。\n五色中偏贵，千花后独尊。\n馨非惭黍稷，采合胜蘋蘩。\n蛱蝶寒犹至，鹪鹩静亦存。\n味堪资玉铉，光欲夺金樽。\n带雾丛犹密，经霜艳更繁。\n砌虫亲有路，梁燕识无门。\n薜荔宜求友，茱萸好结婚。\n栽培劳婢仆，服食教儿孙。\n易把方先哲，难为继后昆。\n败莎承亚朵，落叶拥纤根。\n虽异皇家瑞，宁孤白帝恩。\n延龄仙诀著，应候礼经言。\n不与群芳竞，还如我避喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送长安赵侍郎赴阙","author":"魏野","text":"嗣君徵旧相，物论更无馀。\n圣日归黄阁，台星正碧虚。\n四方闻乐只，一郡泣涟如。\n灞水犹疑噎，秦云亦不舒。\n绮罗围祖席，朱紫拥征车。\n从乐时调瑟，行厨忽馔蔬。\n先牌唯选寺，递铺只担书。\n古道禾残后，长亭木落初。\n朝官逢下马，野客送骑驴。\n从此门尤峻，何由再曳裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送师刑部赴阙","author":"魏野","text":"白首休嗟叹，君方任老臣。\n凤书才入手，鹊印喜离身。\n锦帐眠来旧，花砖步去新。\n离情棠树晓，吟思洛阳春。\n御札催应并，天文动已频。\n拜迎台有吏，泣送巷无人。\n寺宿知题壁，山行想驻轮。\n从兹归近密，闲谒转无因。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]