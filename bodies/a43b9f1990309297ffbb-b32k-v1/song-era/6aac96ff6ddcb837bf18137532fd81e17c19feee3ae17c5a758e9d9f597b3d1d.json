[{"title":"和谹父问讯吉父 其一","author":"王洋","text":"北园依梵庋，东郭据梧桐。\n鹤并千年骨，诗传一祖风。\n有愁添鬓白，无药驻颜红。\n台上秋期句，思君类渴虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和谹父连雨快晴 其二","author":"王洋","text":"官无三不遇，身负四宜休。\n无意花迷眼，唯因月上楼。\n役车悬白地，社鼓祭黄收。\n何事关心切，逢人说有秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和谹父留别 其二","author":"王洋","text":"卧鼓开亭障，斯人久晏然。\n宣王思采芑，羊祜保新边。\n妙手传干叶，鳌头控六连。\n使君双眼阔，塞草不供怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和谹父留别 其一","author":"王洋","text":"细雨关山路，梅花识旧邻。\n拥旄红额骑，抺杖白头民。\n故国悲王粲，年光送李频。\n摇瞻解鞍马，正是小阳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和谹父答郑丈","author":"王洋","text":"郑圃潜仙客，陈留继阮生。\n抡才俱道用，昌誉得诗鸣。\n未解侯三接，先歌玉六成。\n篇篇多瘦骼，疑似带铜声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和谹父携家南坡期以招客","author":"王洋","text":"日日寻春春未休，高情可是惬风流。\n诗如濯锦江波色，身在浣花流水头。\n行想袿裳分襞积，晚因鱼鸟得迟留。\n草堂费尽无人寄，怅望前溪独自愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄朝请 其一","author":"王洋","text":"谋身学业愧渊云，急退还惭谷口真。\n可是有生同冗长，真成无补费精神。\n抽簪早觉宏图远，侧席时闻妙语新。\n共道徵君似颜子，升堂今日见诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄朝请 其二","author":"王洋","text":"极目关山不断云，岭梅开处若为真。\n沈迷簿领政无术，展拓诗章笔有神。\n夜市鬻茶如访旧，晓妆吹颊自争新。\n长溪西畔烟霞远，闻有风光属主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾谹父中秋前六日二诗 其二","author":"王洋","text":"谁将兔消长，用卜月阴晴。\n三穴由来暗，中天本自明。\n金盆如未满，玉斝为谁倾。\n处处随人去，长空不送迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾谹父雨中诗 其二","author":"王洋","text":"往年茅屋水，痕过一由旬。\n人论方宜夏，心惊已畏春。\n花光如劝酒，山色独谈真。\n补拙供吟课，聊开一笑频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾谹父促丛珍之集","author":"王洋","text":"布谷但催耕，鸣鸠不唤晴。\n风添前夜急，花负去年盟。\n老去欢娱少，茶多怀抱清。\n论文一樽酒，何日向人倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾谹父春半书怀 其一","author":"王洋","text":"节物各自好，春风独太华。\n装添山衣锦，零落地铺花。\n趁课蜂招侣，幽吟鹤自嗟。\n放开平望眼，翠幕不须遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾谹父春半书怀 其二","author":"王洋","text":"敲火开香焙，书斋思渐清。\n田翁新社长，巢燕旧门生。\n学僻诗无味，心开语见情。\n不愁无乐事，正与物俱荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和谢方智善","author":"王洋","text":"潇湘十亩弄柔猗，独染啼斑事已奇。\n但爱波声鸣荦确，不须蝇翅避琉璃。\n莫疑山路崎岖险，解脱绳桥性命危。\n惭愧平生竹上座，得相随处每相持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和曾谹父简吉父伯南坡","author":"王洋","text":"柳径桃蹊草色新，一年春半又侵寻。\n无情燕子疑巢冷，多怒鸣蛙互目禁。\n满眼为花留色艳，转头遗我是清阴。\n莫愁艇子芙蓉楫，且听拿音作好音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和滕宰与徐思远","author":"王洋","text":"故国愁来有所思，那堪更读四愁诗。\n令君术业辉千古，处士才名冠一时。\n醉后啸歌争气焰，闲来履屐共追随。\n诗豪酒侠方推重，野客何知但朵颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和酬郑共老","author":"王洋","text":"万事易瓦裂，故人情未休。\n殷勤一诗语，辛苦百端求。\n书托峰头雁，人随海上鸥。\n终期断湖尾，卜筑共良谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和嘉仲秀实九日诗","author":"王洋","text":"幸分微禄养闲身，杖策登高拟令辰。\n贫愧减员招酒伴，闲多债数得诗人。\n不辞眼见黄花旧，却恐花惊白发新。\n人道二疏贤父子，我疑文采是天伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赠知宫","author":"王洋","text":"洞门九锁是天关，出世那知在世间。\n行客冲烟排洞户，主人失足到人寰。\n饱餐蔬笋充朝暮，便与孤云结往还。\n因为群仙作家主，却应我到胜君闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赠郑法师","author":"王洋","text":"仙翁八十保纯精，自解真符不送迎。\n信是虚闲能却老，从教草木不知名。\n交邻有兴开三径，只用无求度一生。\n闻说嵌岩云石路，翁能行处我能行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜闻赛神鼓","author":"王洋","text":"坎坎丰年鼓，鳞鳞赛社人。\n神宽陟降礼，情取笑言真。\n掩豆豚肩薄，分馀福斝频。\n灵坛本宜夜，考鼓已疏津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉酬秀实报章外以前韵示谑且闻灼艾次韵","author":"王洋","text":"早冲料峭别岩扉，惜别音容意自知。\n道上每因同客笑，箧中常恨少君诗。\n饱参静定推先觉，苦炙虚空得下医。\n菽韭盘空春睡起，伯仁还遇火攻时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦寒","author":"王洋","text":"平侵炉火易成灰，稳闭斋扉不用开。\n浩荡晚风随伴起，迟回前雪待朋来。\n他无杂念专思酒，纵有交情敢忆梅。\n静坐不闻箫鼓急，土牛莫是送春回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郊行","author":"王洋","text":"曾问征夫路，名山两日程。\n能销几两屐，况值一川晴。\n诗欲谋于夜，云多不近城。\n暮年尘事有，逐处得心清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中赠尹少稷","author":"王洋","text":"滞雨昏风涨野田，旅亭犹幸窃高眠。\n闭门不为辞宾客，开卷端如揖圣贤。\n梦里庄周花里蝶，醉中徐邈酒中仙。\n老来此兴非吾事，静识东君意自传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"厚载王君求仆赋寄闲斋诗又欲仆作晚实此君二诗皆未果惠然枉佳篇甚厚非老钝所及聊次韵奉酬","author":"王洋","text":"布鼓何堪付阿香，平生痴绝亦长康。\n曲成下里安知宋，疏就中郎不姓常。\n未许芳馨依杜若，摇窥光怪识干将。\n秋风一水空相望，留滞何时贡玉堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昭武旧同僚见过","author":"王洋","text":"半生辛苦路漫漫，八月樵川类破酸。\n官事到时初觉易，人情别后始知难。\n苦无私惠违情重，俭用官钱得谤宽。\n闻说东园墙下柳，有时颦蹙念前官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祝舜俞拉希言见访富春赤亭山居","author":"王洋","text":"岩腹纡盘一径通，故劳都骑载郫筒。\n先生旧负连城价，校尉今烦一箭工。\n著雪老山清刻骨，添梅官路巧迎风。\n此身终解浑无事，共乐郊原浩荡中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"茶荈","author":"王洋","text":"蠹关草掩日萧疏，自汲寒瓶煮涧蔬。\n早愧空肠添雪乳，何须杂佩列琼琚。\n往陪雪茧千重贵，顾试铅刀一割如。\n风露满楼人未散，小窗应为赋归欤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺张帅 其一","author":"王洋","text":"日边春早帝王州，花满黄堂寿醑浮。\n世有忠嘉扶社稷，天教勋业绍箕裘。\n稀鸣枹鼓无偷市，屡敞圜扉罢虑囚。\n已佩荷囊簉鸳鹭，径将名姓覆金瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵倅兼善再用前韵赋木犀","author":"王洋","text":"物外家风本自奇，人间独步九秋时。\n谁登月姊青霄露，折得郤诜丹桂枝。\n韫玉岩扉通户牖，蕊珠花殿彻藩篱。\n渊明不共真香醉，只与黄花作便宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵筠州惠书贺冬道予得宫观讶久无书且劝满泛寿杯及问老妻安否","author":"王洋","text":"筠阳太守旧知闻，笔力清新思不群。\n泰道自当随纪历，蹇涂何用庆书云。\n杯中旨酒衰难尽，床上愁妻病未分。\n故向琳宫同寂寞，一炉香火伴清芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送小刘解元赴试南宫","author":"王洋","text":"衰年税萧寺，偶与凤巢邻。\n万里刷鲜羽，一鸣惊众人。\n寒催征骑急，春接赐袍新。\n折取如丹桂，归荣鹤发亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送犹子之官武昌","author":"王洋","text":"旅情伤别意何如，霜打枯茄雪未除。\n门户难成攻事业，殷勤暇日读诗书。\n须怜白发亲今晚，莫恃朱颜气有馀。\n要使仇香非醉尉，定知不负武昌鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送宝觉禅师","author":"王洋","text":"夏浅春馀宇宙清，溪山千里送君行。\n今宵柳岸半轮月，何处花村飞锡声。\n衣挽岭云犹带湿，鹤随杯渡不须惊。\n江头一线轻帆急，稳压鲸波气自平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送章明章善解官奉亲还吴中二首 其二","author":"王洋","text":"病卧江城五见秋，惟君向我用青眸。\n廪人白粟长相续，官簿青钱不用求。\n向日倾心今得意，犯严荐口昔徒羞。\n期君通籍金闺后，唤我松江共钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送章明章善解官奉亲还吴中二首 其一","author":"王洋","text":"了知天意贵生全，南岳夫人奉化权。\n当日论功门户重，至今传泽子孙贤。\n聊书鬲上三年课，最爱杯中一百篇。\n君宠母恩如已报，暮云春树约他年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17570,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谹父守光州","author":"王洋","text":"沉戟卧江皋，诗人拥节旄。\n便期犀结带，安事马腾槽。\n地入淮源重，霜随雁信高。\n命书催入觐，应及荐香醪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17571,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送蒋推官归宜兴","author":"王洋","text":"阳羡溪头蟹正肥，三年客尽拂征衣。\n一川秋色背人去，满路黄花迎子归。\n未用解装荣故里，少须通籍扣天扉。\n红妆莫作离凰怨，自有鹓雏接翅飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17572,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送魏滁州","author":"王洋","text":"惠政从来到处宽，民心欢喜吏心寒。\n醉翁亭畔霜初肃，酿酒泉边菊未乾。\n紫绶绣衣催传送，黄童白叟挽车看。\n今君已是滁阳守，父老犹称魏长官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17573,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重九日至云号","author":"王洋","text":"梯山七千丈，接迹上清虚。\n钟杂钧天奏，僧参梵帝居。\n摄衣鹏展背，洒墨雁添书。\n今日登高眼，平生总不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17574,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻沈氏小亭欲往主人辞出先闻赵丞相尝游","author":"王洋","text":"篱横地狭曲相裁，倦扫残花长绿苔。\n连榭似闻兼静雅，闲情暂欲洗尘埃。\n料将春色供家用，那有芳尊为客开。\n怪见门前少车马，多因只要相公来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17575,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭宋文渊 其一","author":"王洋","text":"清怀凛凛古人风，尚忆当年语意同。\n开口剑锋初论事，归林弱羽已伤弓。\n累朝因革襟怀内，四海悲欢指顾中。\n寂寞门阑感恩客，曾将顽质谢磨砻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17576,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭宋文渊 其二","author":"王洋","text":"蔼蔼声华动帝宸，一时车马走芳尘。\n文如屈宋才仍富，心似皋夔道已醇。\n身后功名因报主，生前勋业为忧民。\n知公本意安刘氏，不许身危更累亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭李清卿侍郎 其二","author":"王洋","text":"金石虽云久，精诚谅不移。\n但期忠可仗，谁谓敌难知。\n吁极天应泣，难谌信有亏。\n报君如不尽，祸福定虚辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭李清卿侍郎 其四","author":"王洋","text":"眼见盟城筑，俄闻钟鼎移。\n忆君还抆泪，胡尔大无知。\n名擅千钧重，功无一篑亏。\n杀身因主辱，独为实前辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭李清卿侍郎 其一","author":"王洋","text":"薄垒毡车咽，危台斥候移。\n孤忠万夫望，独许寸心知。\n义动乾坤正，生残日月亏。\n南山竹有限，难尽泣君辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭李清卿侍郎 其三","author":"王洋","text":"皇泽淹时久，人怀孝可移。\n不应当后患，端恨未前知。\n国破言犹壮，身亡义不亏。\n青编照千古，昭代有芳辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭沈行彦宫教","author":"王洋","text":"气迥神清形骨立，蓝绶纡腰垂四十。\n年侵运栉发蒙丝，日晚煮黎羹不粒。\n教司胄子禄方来，日薄西山风已急。\n平生失意固多端，忽向幽泉犹饮泣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐思远出示月夜登楼诗句法甚高不类平生语幸少卑之在我辈中自不失为社头且使时见一斑也","author":"王洋","text":"几处澄辉几处秋，好闲时上水明楼。\n谁怜老子风前兴，为遣中郎醉上舟。\n一带横空长漠漠，时看飞栋影悠悠。\n今宵踏月归时节，莫骂徐郎只暗游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽玉山詹教授","author":"王洋","text":"鹤发双亲岁月残，既沾三釜即心欢。\n广文未脱一官冷，范叔宁忘昔日寒。\n文中八科名益重，魂归千里命尤难。\n后生它日思风范，只向传铭石上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽乔民瞻","author":"王洋","text":"世德书青史，荣名在本朝。\n如何元士葬，不得大夫招。\n惆怅空萧瑟，秋风正泬寥。\n摇看古原上，松柏暮萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽乔民瞻","author":"王洋","text":"楚乡槐市忆当年，锦绣文章六艺先。\n朱绂哀怜应有在，白头故旧各凄然。\n修文地下埋英骨，遗爱江城付綵编。\n造化于公意良厚，不教丹旐涉长川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽向伯恭 其一","author":"王洋","text":"十里林花带月萝，垄头车马断经过。\n可怜人物今如此，试问天公事若何。\n篱下渊明惟酒菊，舟中范子任烟波。\n璇题金榜垂霄汉，千古荣名定不磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽向伯恭 其二","author":"王洋","text":"绝代风流世所希，如公真是命难推。\n三辞令尹高前哲，两挂儒冠当盛时。\n丞相耐官天语贵，左师习礼楚人知。\n试看流庆当何似，滚滚长江不尽期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽向倅","author":"王洋","text":"襟量尘埃外，功名慷慨中。\n人怀不满望，身有未全功。\n逸气犹惊眼，驰光息转蓬。\n萧条古原上，松柏自号风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽向倅","author":"王洋","text":"耐官丞相山河业，靖国帘帷社稷勋。\n四姓风流传学问，三朝润泽庆来云。\n重车折轴人何力，积阀传家子有文。\n史笔它时汗青简，左师家谱绍清芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽杨承事并夫人诗二首 其二","author":"王洋","text":"梦协幽兰故可誇，来从君子更宜家。\n疏恩自合开新邑，比德还应副六珈。\n解使威仪同诂训，聊随轻薄事铅华。\n自从瑶瑟初扃后，槛外春风懒放花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽杨承事并夫人诗二首 其一","author":"王洋","text":"除却家传教子经，世间百事不营营。\n自应艺学推前辈，故得风流劝后生。\n疏傅挥金终足食，徐卿有子自成名。\n后来若不流馀庆，真享千钟亦未荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽徐次翁 其一","author":"王洋","text":"仁义功高泽子孙，衣冠由是古王门。\n位升五品鹓鸾贵，政在三州民社尊。\n一旐岂期江汉远，千年惟有德风存。\n了知大末渊源在，功业皋夔付后昆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽徐次翁 其二","author":"王洋","text":"自想温容耳诲词，他乡已恨重分违。\n送人作守乘轩去，结草为灵象俑归。\n会合只如风过烛，花阴何异月澄辉。\n相门子婿诸侯服，除却清名百事非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽黄夫人","author":"王洋","text":"官栖枳棘莫消魂，身托丝萝在德门。\n三后姻联门户重，贰卿阅阀德名尊。\n伤心结蚁灵轜远，保室鸣鸠道化存。\n为问如何慰冥漠，饱闻中外有兰孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽焦适道寺丞 其一","author":"王洋","text":"学有千箱富，言无一字欺。\n脊令慈孝地，兄弟急难诗。\n颂美观名士，传家付令儿。\n平日磨玷缺，此理上天知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽程伯禹 其二","author":"王洋","text":"待问盈朝日，群生解褐初。\n太常方奏第，儒馆下除书。\n出入劳忠荩，襟怀自卷舒。\n如何夺公早，不得待悬车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽程伯禹 其一","author":"王洋","text":"盛德师千古，高名满四方。\n位登三品贵，身任百夫防。\n公在衣冠重，公归远近伤。\n哀荣终始事，褒典在徽章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]