[{"title":"次韵石塔睡庵","author":"韩驹","text":"寺南寺北竹阴浓，背日茆茨雪未融。\n为厌呢喃说禅病，故将?䶎现神通。\n殷勤问话非庞蕴，邂逅论交得赞公。\n借我蒲团睡今夜，五湖春梦雨声中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4463,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧化宁吴中行脚 其一","author":"韩驹","text":"我欲游京口，浮家未有船。\n羡君无一物，篷底曲肱眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4464,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧化宁吴中行脚 其二","author":"韩驹","text":"渡水穿云去，神光触处开。\n隔江如有得，飞锡早归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4465,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示龟山平老 其一","author":"韩驹","text":"二年三饮龟山井，道上菰蒲亦笑人。\n犹觉是身多世累，一庵何日与翁邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4466,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示龟山平老 其二","author":"韩驹","text":"水横绝浦曾争渡，浪打船头又少留。\n安得一舟淮上钓，水生水落任沉浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4467,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵侯思孺将至黄州见简","author":"韩驹","text":"未用船头报水程，为君持酒打愁城。\n青山久负当年约，白发多从客路生。\n点检转工新句法，揩磨难减旧风情。\n小留莫道无供给，一味东篱有落英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4468,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故资政忠惠韩公挽词 其一","author":"韩驹","text":"籍甚中山守，风流世有人。\n猎围边月晓，筵蹋塞花春。\n金絮盟犹在，灰钉事已新。\n使公长卧护，何地起胡尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4469,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"故资政忠惠韩公挽词 其二","author":"韩驹","text":"忆在昭文馆，垂绅看立朝。\n敢论同自出，但喜识高标。\n有子仍持橐，如公合珥貂。\n伤心邺城路，宰树结寒飙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4470,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以正赐库蒲萄醅送何斯举复次其韵 其一","author":"韩驹","text":"叹息苏公无恙日，坡头自筑小山房。\n五年不识官壶味，只以春江当酒觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4471,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以正赐库蒲萄醅送何斯举复次其韵 其二","author":"韩驹","text":"老臣政术不堪论，尚得君王赐酒樽。\n异日黄州成故事，蒲萄醅熟记初元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4472,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"以正赐库蒲萄醅送何斯举复次其韵 其三","author":"韩驹","text":"蒲萄酒用春江水，压倒云安曲米春。\n未解敲门问奇字，一杯聊醉草玄人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4473,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次范元长韵兼简郑有功博士","author":"韩驹","text":"少年饶舌类丰干，老似鸣蝉不耐寒。\n无复酒杯同设席，几思斋钵共开单。\n便从此去真差易，未有生涯良独难。\n樗散郑公官益冷，雪中何以继朝餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4474,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵耿龙图棱陵书事","author":"韩驹","text":"十月舟藏芦荻林，客衣顿觉夜寒侵。\n乱离祗有穷途泪，勋业都无过去心。\n敢恨青鞋蹋江浦，近传黄屋渡淮阴。\n中兴气象须公等，是日频闻正始音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4475,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送蜀僧希肇往云居","author":"韩驹","text":"邂逅他乡识，艰难此地逢。\n扁舟逆春水，一钵趁晨钟。\n便欲依风穴，宁辞上雪峰。\n老禅行履处，著眼看机锋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4476,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵金陵赵德夫使君上元三绝 其一","author":"韩驹","text":"小风吹水涨平湖，屋角残冰亦已无。\n投老只图春睡足，可须山鸟强招呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4477,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵金陵赵德夫使君上元三绝 其二","author":"韩驹","text":"卧听秦淮呜咽声，起看江月暮潮平。\n旧时忆在延真观，玉作芙蕖院院明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4478,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵金陵赵德夫使君上元三绝 其三","author":"韩驹","text":"忆昨宣和从武皇，春风省识御袍香。\n自从翠盖巡沙漠，无复徵歌出洞房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4479,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芜湖戏赵德夫","author":"韩驹","text":"西来有客共征途，不恨维舟日日孤。\n爱子清明似秋月，当涂见了又芜湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4480,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送显上人归蜀 其一","author":"韩驹","text":"楚雨冥冥催入峡，巴云漠漠伴归乡。\n只应袖有欧峰录，万里神珠照地光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4481,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送显上人归蜀 其二","author":"韩驹","text":"未可西归白帝城，半天亭下即胡尘。\n他年若悟居山好，一束茆茨老此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4482,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"为超然道人作云卧庵 其一","author":"韩驹","text":"窣堵西头屋数楹，知君卧占一溪云。\n老夫亦有缘云兴，应为情亲肯见分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4483,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"为超然道人作云卧庵 其二","author":"韩驹","text":"一溪清驶到天宫，上有千株偃盖松。\n未肯分流下山去，为君纯浸紫霄峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4484,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵南溪观鱼","author":"韩驹","text":"城西鼓楫又城东，不待溪分上下风。\n碧树垂柑间黄绿，冰盘行鲙簇青红。\n横塘日暮林峦合，断岸秋来浦溆通。\n安得此身无世累，便随渔艇入空濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4485,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"避贼严阳山次蜀僧清雅韵 其一","author":"韩驹","text":"苦菜敷新叶，高槐偃旧枝。\n三生草庵主，故与此山期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4486,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"避贼严阳山次蜀僧清雅韵 其二","author":"韩驹","text":"乱离多探报，荒僻少知闻。\n白发如荒草，秋来不可耘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4487,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用逊子游严阳庵韵 其一","author":"韩驹","text":"路转冈头松柏深，百年唯我独追寻。\n不知尊者真归处，岭上浮云自古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4488,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用逊子游严阳庵韵 其二","author":"韩驹","text":"石根路转白云深，坏壁遗椽可细寻。\n只道来时无一物，尚留陈迹到如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4489,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次抚州高使君韵","author":"韩驹","text":"直道居中少，长才举最频。\n初闻挽红粟，又往破黄巾。\n代北犹屯虏，山东有未臣。\n看公为世用，容我任天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4490,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次韵兼简李道夫 其一","author":"韩驹","text":"麦秋宜晚起，况复雨频频。\n桃竹犹能杖，柴车未可巾。\n闲分酒贤圣，静记药君臣。\n会有骑鲸李，来陪贺季真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4491,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次韵兼简李道夫 其二","author":"韩驹","text":"李侯梨饤坐，风味胜仁频。\n投老须鸣玉，相看尚秃巾。\n便应寻木客，何必问波臣。\n不复来城市，从人笑我真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4492,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再次韵兼简李道夫 其三","author":"韩驹","text":"犹记一麾出，敢论三顾频。\n馀生过飞鸟，幻事捏空巾。\n学道无疑怖，忧时有主臣。\n买舟苕霅去，我亦号玄真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4493,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵钱逊叔侍郎见简","author":"韩驹","text":"白头逢世难，无地可推愁。\n晓日瞻天阙，春风忆御沟。\n他年余老蜀，万户子封留。\n尚记临川郡，溪山烂漫游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4494,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"往岁自京口与曾公永宏父同行至下蜀因次前韵简之","author":"韩驹","text":"下蜀追随日，欢言一散愁。\n篮舆转陂路，小楫渡潮沟。\n万里家何在，三年淹此留。\n犹欣迟暮眼，见子并英游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4495,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钱逊叔见示小诗次韵 其一","author":"韩驹","text":"邂逅邗沟记昔年，知君跋马自湘川。\n欲持斗酒洗泥滓，未办青铜三百钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4496,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钱逊叔见示小诗次韵 其二","author":"韩驹","text":"卜筑相依约暮年，向来深驻汨罗川。\n叩门忽送铜山句，知是赋诗人姓钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4497,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钱逊叔见示小诗次韵 其三","author":"韩驹","text":"堕絮飞花又一年，黄梅小雨暗平川。\n莫言晚起家何事，日傍南池数绿钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4498,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钱逊叔见示小诗次韵 其四","author":"韩驹","text":"且复江西度岁年，会须投老剑南川。\n日长一局枯棋罢，卧看儿童学意钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4499,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"抚州邂逅彦正提刑道旧感叹辄书长句奉呈","author":"韩驹","text":"忆在昭文并直庐，与君三岁侍皇居。\n花开辇路春迎驾，日转蓬山晓曝书。\n学士南来尚岩穴，神州北望已丘墟。\n愁逢汉节沧江上，握手秋风泪满裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4500,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题伯时所画宫女 其一","author":"韩驹","text":"只道春风闭掖廷，朝来绾结髻鬟新。\n蛾眉不是专君宠，试触君衣鹦鹉嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4501,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题伯时所画宫女 其二","author":"韩驹","text":"睡起昭阳暗淡妆，不知缘底背斜阳。\n若教转盼一回首，三十六宫无粉光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4502,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵游橘陂 其一","author":"韩驹","text":"水边卢舍寺，朱实绕霜荣。\n棘刺防来密，筠笼赠岂轻。\n谁为嘉橘诵，自拟渼陂行。\n莫讶归时黑，吾兼吏隐名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4503,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵游橘陂 其二","author":"韩驹","text":"缓寻随父老，偷折饫僮奴。\n的皪连僧舍，馨香到客厨。\n题诗郡丞至，问俗使华俱。\n只道千缣易，良田岂易图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4504,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送曾宏父 其一","author":"韩驹","text":"见子京江尚少年，大梁重见已翩翩。\n顷来更觉文章进，他日宁容老病先。\n梅谷旧题幽谷引，橘陂新和渼陂篇。\n常惭散吏空称赏，不敢吹嘘上九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4505,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送曾宏父 其二","author":"韩驹","text":"乃翁名见豫章诗，学术传家有大儿。\n四海共推文赋早，三年应讶省郎迟。\n生逢侧席求贤日，即是摩霄耸壑时。\n若到朝廷问衰朽，为言藏缩畏人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4506,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题双牛图 其一","author":"韩驹","text":"騃牛蹢躅知何事，定自春山细雨来。\n漫漫平沙相逐去，可无人掣鼻头回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4507,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题双牛图 其二","author":"韩驹","text":"好事谁如公子贤，千金买尽亦欣然。\n老夫若有沉牛二，春雨归耕负郭田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4508,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵钱逊叔侍郎见简 其一","author":"韩驹","text":"扫地焚香元自喜，傍门骑马向来慵。\n田园此去须安枕，海岱今年不举烽。\n已分瘦藤扶病骨，生憎明镜写衰容。\n两公故是经纶手，只问腰金早晚重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4509,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵钱逊叔侍郎见简 其二","author":"韩驹","text":"排闷径须沽酒饮，贮愁端为作诗慵。\n连声倦听城头角，落点惊飞塞上烽。\n闻道久闲金騕袅，有时高卧绣芙容。\n年来自说无尤物，已结维摩按两重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4510,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵钱逊叔侍郎见简 其三","author":"韩驹","text":"开心未用饮门冬，老去何妨万事慵。\n胡虏近闻归绝漠，洛阳无复化为烽。\n休官昔愧陶彭泽，受禄今惭邴曼容。\n谁似侍郎春思乱，解言花影日高重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4511,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"信州连使君惠酒戏书二绝谢之 其一","author":"韩驹","text":"上饶籍甚文章守，曾共紫薇花下杯。\n铃阁昼闲思老病，故教从事送春来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4512,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"信州连使君惠酒戏书二绝谢之 其二","author":"韩驹","text":"忆倾南库官供酒，共赏西京敕赐花。\n白发逢春醒复醉，岂知流落在天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4513,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵钱逊叔谢曾使君送酒","author":"韩驹","text":"谁怜定武故将军，醉舞狂歌老更真。\n好事时分小槽酒，残樽也到白头人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4514,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵曾寺丞观早朝上徐谏议","author":"韩驹","text":"忆昨飘然下叶闉，十年江海望严宸。\n遥知驻跸艰危地，尚有忧时老大臣。\n已起阳城司谏诤，又传陆贽掌丝纶。\n为公细数能文士，几个麒麟阁上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4515,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵徐翰林","author":"韩驹","text":"远闻仙伯上神山，始觉升平气象还。\n一梦休论玉堂事，两行曾缀紫宸班。\n想烧椽烛书天诏，看剪花騣出帝闲。\n尚忆平生故人否，夜驱黄犊在田间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4516,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧住梅山 其一","author":"韩驹","text":"寺门岑寂知何许，想对千岩万壑开。\n待得梅山梅子熟，不辞先寄一枝来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4517,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧住梅山 其二","author":"韩驹","text":"近闻僧说宜黄寺，一道松门夜不关。\n投老有禾三百把，亦随君去住梅山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4518,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"某顷知黄州墨卿为州司录今八年矣邂逅临川送别二首 其一","author":"韩驹","text":"自罢黄州守，殊方任转流。\n宁论九年谪，已判一生休。\n此士真材杰，诸公定挽留。\n傥归存老病，车骑拥西畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4519,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"某顷知黄州墨卿为州司录今八年矣邂逅临川送别二首 其二","author":"韩驹","text":"盗贼犹如此，苍生困未苏。\n今年起安石，不用哭包胥。\n子去朝行在，人应问老夫。\n髭须衰白尽，瘦地日携锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4520,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送云门妙喜游雪峰 其一","author":"韩驹","text":"忆宰分宁日，逢师溪水头。\n裁书访彭泽，倚杖话荆州。\n幻世吾方梦，迷津子作洲。\n禅心如密付，更为小淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4521,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送云门妙喜游雪峰 其二","author":"韩驹","text":"不谓英灵汉，犹怜老病翁。\n回舟残破岸，驻锡涅槃宫。\n复作千山去，真成一段空。\n直愁林下乐，从此更谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4522,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送云门妙喜游雪峰 其三","author":"韩驹","text":"老子幽栖地，劳君久见存。\n夜毡从栗爆，午盌看茶翻。\n旧事时追忆，深禅得细论。\n还应雪峰老，领众待云门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4523,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送东林圭老游闽五绝句 其一","author":"韩驹","text":"平时访我乌江上，乱后逢君汝水滨。\n欲问龙门真在否，大千沙界邈全身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4524,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送东林圭老游闽五绝句 其二","author":"韩驹","text":"少年高掇老庞科，未必龙门众角多。\n幕府三招三不去，唯将一钵渡娑婆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4525,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送东林圭老游闽五绝句 其三","author":"韩驹","text":"北风捲地雪漫天，惭愧君来住过年。\n日与邻翁同展钵，老夫时复听谈禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4526,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送东林圭老游闽五绝句 其四","author":"韩驹","text":"直自三湘到七闽，无人不道竹庵名。\n诗如雪窦加奇峭，禅似云居更妙明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4527,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送东林圭老游闽五绝句 其五","author":"韩驹","text":"竹庵端为故人留，尚许衰翁预胜流。\n寄语丛林好清客，未宜轻辊雪峰毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4528,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示圭上人","author":"韩驹","text":"自识云门老，经时水石间。\n尚嫌闻法少，随度七闽山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4529,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即席送吕居仁","author":"韩驹","text":"一樽相属两华颠，落日临分更泫然。\n蹀躞鸣珂君得路，伶俜散策我归田。\n近闻南国生涯尽，厌见西江杀气缠。\n欲买扁舟吴越去，看山看水乐馀年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4530,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余往岁与逊叔侍郎同寓广陵靖康元年逊叔守符离余被召过焉未几余守南都逊叔移真定过留数日绍兴二年复同寓临川感念畴昔奉送一首","author":"韩驹","text":"广陵三岁共祠宫，二月帆开上水风。\n北渚荡舟公醉我，南湖张乐我留公。\n岂知去国千山外，又得连墙一笑同。\n丧乱难堪重离别，可无书札问衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4531,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送李献可奉使湖南","author":"韩驹","text":"客居蓬藋绕门深，两岁频闻车马音。\n子壮飞腾日无那，吾衰瘴疠久相侵。\n旧知文力雄青土，想有诗声动绿林。\n归傍玉皇香案立，莫忘江阁共登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4532,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"余为著作郎如瑩为司令官舍皆在左掖门外高头坊绍兴四年如瑩持节江西道抚相访辄成长句","author":"韩驹","text":"邂逅都城接下风，官居总在日华东。\n门瞻曲角趋朝近，路转高头出局同。\n今日绣衣新使者，晚涂霜鬓旧邻翁。\n一杯无复当时乐，赤县黄图泪眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4533,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]