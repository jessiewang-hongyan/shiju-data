[{"title":"宫词 其三十八","author":"周彦质","text":"名园蹴游称春游，近密宣呈技最优。\n当殿不教身背向，侧中飞出足跟毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其三十九","author":"周彦质","text":"春昼宫娥睡足时，凭栏无语听黄鹂。\n谁家按曲敲檀板，惊破林间自在啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其四十","author":"周彦质","text":"春昼宫娥直退迟，茶馀清话屡移时。\n困人天气成浓睡，偶失鞦韆伴侣期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其四十一","author":"周彦质","text":"端午茸花簇彩鸾，高标宝鉴缕金鞶。\n不宜夏景销酥腕，似觉新来百索宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其四十二","author":"周彦质","text":"初夏清和昼漏长，酴醾高架映华堂。\n一枝斜插蓝罗扇，摇动时时送好香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其四十三","author":"周彦质","text":"朱夏炎炎昼漏长，迸珠亭下共流觞。\n清风寒韵侵肌冷，谁信宫中六月凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其四十四","author":"周彦质","text":"冰屏四合响流泉，白玉杯盘奉御筵。\n纵有炎蒸无处入，水晶宫阙会神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其四十五","author":"周彦质","text":"荔子珍奇冠九垓，上林航海近移栽。\n绛囊玉颗如闽峤，不用红尘一骑来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其四十六","author":"周彦质","text":"亲蚕摘叶满筠笼，机杼仍观组织工。\n圣世后妃躬道化，仪刑无愧二南风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其四十七","author":"周彦质","text":"便殿时时燕二王，吾君亲睦似陶唐。\n寂寥棠棣留芳后，盛事应传入雅章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其四十八","author":"周彦质","text":"燕子安巢近上阳，惯听深殿理丝簧。\n伊州入破喧轰闹，不废呢喃语画梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其四十九","author":"周彦质","text":"碧玉峥嵘照座清，良工镌斲亦难成。\n巫山雁荡惭粗俗，销得君王号胜瀛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其五十","author":"周彦质","text":"君王锡庆自高天，禖燕宫庭每每传。\n老㜮宝箱珠遍蹙，别收诸阁洗儿钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其五十一","author":"周彦质","text":"七夕宫娥设席祈，翠台莲烛静交辉。\n綵楼逗晓蛛丝满，女伴谁传得巧归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其五十二","author":"周彦质","text":"郊庠已见咏台莱，近密仍多著撰才。\n汉武得人何足道，内朝今亦盛邹枚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其五十三","author":"周彦质","text":"瑞竹亭亭近玉墀，初同一簳却分岐。\n已传国史新图籍，更得君王御制诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其五十四","author":"周彦质","text":"禁籞承平种植繁，枇杷荔子近移根。\n地祇应借东南候，养就甘香奉至尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其五十五","author":"周彦质","text":"桂魄初生出翠台，玉人拜祝久徘徊。\n非唯月月长相见，更愿重重喜庆来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其五十六","author":"周彦质","text":"青唐陇拶觐神都，亿万天兵列路隅。\n三省枢臣合班对，进呈平旦受降图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其五十七","author":"周彦质","text":"乌巾袅脚锦袍襕，供奉新来进押班。\n从此便应閒日少，玉除轮日侍天颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其五十八","author":"周彦质","text":"瑞竹初生每觉长，分岐共簳出宫墙。\n普天无限成林地，故产皇家是吉祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其五十九","author":"周彦质","text":"内庭耸秀碧云屏，冠绝群峰最杰英。\n圣世瑰才终显赫，嶙峋犹得赐佳名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其六十","author":"周彦质","text":"瑶津亭榭俯池塘，芬馥氤氲杂众芳。\n永昼和风一披拂，近城分得禁园香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其六十一","author":"周彦质","text":"珠帘十二捲金钩，万里无云桂魄浮。\n嘈杂笙箫半天响，瑶津亭上赏中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其六十二","author":"周彦质","text":"振振皇族盛豪雄，籍庆天支自不同。\n宗学宏开崇教养，已多歆向出深宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其六十三","author":"周彦质","text":"资善诸王就傅初，常宣步辇按观书。\n六宫准拟经由处，一一排门候起居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其六十四","author":"周彦质","text":"集英赐第对天颜，顷刻蓝袍翠一班。\n漫说禹门三级浪，鱼龙只在指呼间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其六十五","author":"周彦质","text":"唐帝惟珍阳羡茶，未尝百草不开花。\n太平奉御穷佳异，建焙先春进露芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其六十六","author":"周彦质","text":"深院相过笑语同，选仙清乐得从容。\n由来本是桃源侣，常占三清最上宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其六十七","author":"周彦质","text":"召对词臣幄殿华，密宣令草相公麻。\n黄庭诏下齐欢舞，望协群工共叹嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其六十八","author":"周彦质","text":"圣主边谋过六奇，指踪决胜率前知。\n深沉清禁传三鼓，犹报金牌出睿思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其六十九","author":"周彦质","text":"掖门放钥响铜镮，平晓传催百辟班。\n垂拱殿前人肃静，独闻莺语转间关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其七十","author":"周彦质","text":"地衣红锦蹙盘雕，罗袖飘香转舞腰。\n清暇君王休务日，宣和深殿按仙韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其七十一","author":"周彦质","text":"深秋萧爽十分凉，茱菊浮杯满座香。\n百尺玉楼喧鼓吹，六宫思许醉重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其七十二","author":"周彦质","text":"禁籞瑶津宝阁重，芳亭曲榭暗相通。\n汪洋太液澄清影，金碧丹青上下同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其七十三","author":"周彦质","text":"圣学渊宏百世师，六宫薰习喜文词。\n睿思传出宸章丽，院院珠装御制诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其七十四","author":"周彦质","text":"永昼宫娥聚笑嬉，小王初习起居仪。\n朱衫御史心聪慧，学得中庭赞对词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其七十五","author":"周彦质","text":"永昼嫔嫱小燕阑，投壶雅戏集清欢。\n众中最觉天机巧，平送筠筹觅倚干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其七十六","author":"周彦质","text":"象戏宫娥共雅欢，团团犀玉布牙盘。\n蹉车避马寻常事，却是堤防叠炮难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其七十七","author":"周彦质","text":"德自关雎乐善心，六宫渐染化风深。\n鼓琴擘阮非凡好，为有淳和太古音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其七十八","author":"周彦质","text":"庭试初宣进士班，玉阶咫尺觐天颜。\n画廊两畔楸花发，时递清香笔砚间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其七十九","author":"周彦质","text":"按乐清宵女伴同，和谐仙韵出深宫。\n寻腔理得新翻曲，月上龙楼第一重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其八十","author":"周彦质","text":"太平天子绝畋游，结束宫娥马打毬。\n韶乐引来花锦队，男儿跪拜谢头筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其八十一","author":"周彦质","text":"开炉佳节乍寒朝，近侍班联衣锦朝。\n兽炭香新金鸭暖，珠帘龙幕按箫韶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其八十二","author":"周彦质","text":"瑞香圆结异凡丛，天幸移根植禁中。\n露浥清香来御榻，玉牌题作锦薰笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其八十三","author":"周彦质","text":"锦裀方窄簇花毬，羯鼓琼台七宝钩。\n共按升平新制曲，不同箫索打梁州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其八十四","author":"周彦质","text":"白玉镌成十六牌，禁宫方响古无偕。\n非唯韵出箫竽上，仍是音参律吕谐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其八十五","author":"周彦质","text":"上直归来日未晡，宫嫔相与戏摴蒲。\n蓦关渡堑寻常彩，无奈时时掷雉卢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其八十六","author":"周彦质","text":"三卫千官侍冕旒，君王郊祀款圆丘。\n彩棚夹路瞻天表，一半珠帘上玉钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其八十七","author":"周彦质","text":"庆成大礼御端门，肃肃千官拱至尊。\n高捧金鸡宣霈泽，两班欢舞荷天恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其八十八","author":"周彦质","text":"聪俊宫娥妙奕棋，每虞宣唤各穷奇。\n更阑自覆忘忧局，好著长防敌手知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其八十九","author":"周彦质","text":"腊后寒梅蕊弄黄，金瓶丛插贮兰房。\n已供阖座清香满，更得临鸾学晚妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其九十","author":"周彦质","text":"踊跃新羁已过关，未高生怕别人盘。\n到窝路数无多掷，急满须防将马阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其九十一","author":"周彦质","text":"冬候寒威凛未央，初欣至日乍迎长。\n退朝一曲升平乐，共进新阳万寿觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其九十二","author":"周彦质","text":"感古梅妆范样殊，折梅特地试妆梳。\n薄施红粉临鸾鉴，却是梅花迥不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其九十三","author":"周彦质","text":"五云宫阙郁岧峣，尤称濛濛瑞雪飘。\n中使到来东上阁，传宣初放紫宸朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其九十四","author":"周彦质","text":"二月春宫折杏花，垂梢繁蕊闹交加。\n折来已觉柔枝重，插向搔头宝髻斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其九十五","author":"周彦质","text":"丹青御笔趣尤深，不许流传到翰林。\n乞得睿思全幅轴，宝藏端胜满籯金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其九十六","author":"周彦质","text":"女冠新观近西清，玉宇幽奇称道情。\n宫禁沉沉银漏永，好风时送步虚声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其九十七","author":"周彦质","text":"碧芦方沼水潺潺，叠石嵯峨翠霭间。\n不谓九重宫禁里，忽逢江国好溪山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其九十八","author":"周彦质","text":"綵架清阴接凤楼，分班左右各朋俦。\n就中最得抛梭便，不碍珠门紫绣毬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其九十九","author":"周彦质","text":"楼殿亭台处处通，花光柳色共溟濛。\n苑东即出横门道，已觉仙凡路不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宫词 其一○○","author":"周彦质","text":"分引天源入禁城，御沟萦绕六宫行。\n寒声碧甃淙淙急，流到人间分外清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53874,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄子弟","author":"周谞","text":"浪有虚名落世间，自惭无实骨毛寒。\n未年三十身先倦，才得一官心已阑。\n卜宅拟寻栽药圃，买田宜近钓鱼滩。\n他年子弟重相见，藜杖蓑衣笋箨冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53875,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游九锁","author":"关澥","text":"山下寒流咽细泉，晓林浮日自生烟。\n九峰密锁疑无路，五洞潜通别有天。\n羽客依山多得道，昔人涉海谩求仙。\n我来要学栖真事，愿借孤云一榻眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53876,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"五泄山","author":"曾谔","text":"五泄高寒插太清，银河垂地落天声。\n玉虹贯日晴空见，骢马翻瓢白昼倾。\n作赋曾闻誇雁荡，乘槎应可到蓬瀛。\n何当一比乖龙起，手挽商霖洗甲兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53877,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵赵仲美表弟西斋自遣","author":"曾旼","text":"谪守凄凉卧郡斋，夫君失意偶同来。\n海边故国渺何许，城上新楼空几回。\n宁羡一囊供鹤料，会看千里跃龙媒。\n清吟未免萦机虑，只恐飞鸥便见猜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53878,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"统军池","author":"曾旼","text":"长山谩刻金芝颂，宫相空吟石竹诗。\n事往岁深无处问，北园唯见孟家池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53879,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游九锁","author":"曾旼","text":"山势盘纡是几重，溪行乱石水溶溶。\n东西路口分双洞，苍翠群中起一峰。\n石上仙翁留去迹，壁间羽客有吟踪。\n夜分不是红尘境，清梦回时晓殿钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53880,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈同院诸公 其一","author":"柳子文","text":"邓子知名久，秋闱得暂依。\n论文虚以往，讲道实而归。\n得句赓酬数，忘言笑语稀。\n自惭初学步，鱼目混珠玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53881,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈同院诸公 其二","author":"柳子文","text":"刻意长沙客，编书近隙光。\n朝方登庙器，时可咏山梁。\n未用嘲经笥，端宜号智囊。\n颇闻穷史学，犹想见三长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53882,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈同院诸公 其三","author":"柳子文","text":"官辍蓬莱直，身从帝所回。\n文章孔庭奥，事业傅岩隈。\n多士朝廷念，诸公殿阁来。\n英雄须入彀，应有济川才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53883,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日同文馆 其一","author":"柳子文","text":"磊落群英集，峥嵘逸气齐。\n捷机闻堕灶，妙论及交梨。\n庭木何年植，窗尘异域题。\n独怜车马散，寒月满宫闺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53884,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日同文馆 其二","author":"柳子文","text":"懒散江湖客，秋深念涤场。\n端宜返田里，安敢论文章。\n山坞橙应熟，霜篱菊正香。\n行归招隐客，鼓腹咏时康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53885,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日同文馆 其三","author":"柳子文","text":"国器来金马，儒冠萃木鸡。\n胜心群逐北，锐气鼓争西。\n海峤鹏程息，春风雁塔题。\n应思连夜雨，车马六街泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53886,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"未试即事杂书 其一","author":"柳子文","text":"虚廊空白月，灯火闭重闱。\n思苦诗难继，更长梦易归。\n徒劳争墨榜，须信有朱衣。\n万事前期定，升沉不尔违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53887,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"未试即事杂书 其二","author":"柳子文","text":"一一听宫徵，铢铢较短长。\n品题分玉石，得失异炎凉。\n中的非无术，知音岂易忘。\n鱼龙头角老，变化更何方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":53888,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]