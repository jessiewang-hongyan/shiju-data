[{"title":"题卢鸿一《学士堂图》","author":"苏轼","text":"昔为太室游，卢岩在东麓。\n直上登封坛，一夜茧生足。\n径归不复往，峦壑空在目。\n安知有十志，舒卷不盈辐。\n一处一卢生，裘褐荫乔木。\n方为世外人，行止何烦录。\n百年入箧笥，犬马同一束。\n嗟余缚世累，归未有茅屋。\n江干百亩田，清泉映修竹。\n尚欲逃世名，岂须上图轴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李白谪仙诗","author":"苏轼","text":"我居青空里，君隐红埃中。\n声形不相吊，心事难形容。\n欲乘明月光，访君开素怀。\n天杯饮清露，展翼登蓬莱。\n佳人持玉尺，度君多少才。\n玉尺不可尽，君才无时休。\n对面一笑语，共蹑金鳌头。\n绛宫楼阙百千仞，霞衣谁与云烟浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饮酒四首 其一","author":"苏轼","text":"我观人间世，无如醉中真。\n虚空为销殒，况乃百忧身。\n惜哉知此晚，坐令华发新。\n圣人骤难得，日且致贤人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饮酒四首 其二","author":"苏轼","text":"左手持蟹螯，举觞瞩云汉。\n天生此神物，为我洗忧患。\n山川同恍惚，鱼鸟共萧散。\n客至壶自倾，欲去不得间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饮酒四首 其三","author":"苏轼","text":"有客远方来，酌我一杯茗。\n我醉方不啜，强啜忽复醒。\n既凿浑沌氏，遂远华胥境。\n操戈逐儒生，举觞还酩酊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饮酒四首 其四","author":"苏轼","text":"雷觞淡于水，经年不濡唇。\n爰有扰龙裔，为造英灵春。\n英灵韵甚高，蒲萄难与邻。\n他年血食汝，当配杜康神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游山呈通判承议写寄参寥师","author":"苏轼","text":"煌煌世冑馀，夫子非碌碌。\n由来有诗书，所以能绝俗。\n得官本河朔，瓜期未易促。\n扁舟下南来，逸驾追鸣鹄。\n遇胜即徜徉，风餐兼露宿。\n嗟余偶倾盖，一笑外羁束。\n杖策每过从，相携访山谷。\n东风披鲜云，绣错出林麓。\n松门有时尽，幽景无断续。\n崖转闻钟声，林疏见华屋。\n衔山馀落景，归迹犹踯躅。\n谁云邺下欢，往事不可复。\n吾曹二三子，取乐亦云足。\n愿公寄新诗，一一能见录。\n船头行北归，囊橐有美玉。\n尘埃京洛人，亦与洗心目。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辘轳歌","author":"苏轼","text":"新系青丝百尺绳，心在君家辘轳上。\n我心皎洁君不知，辘轳一转一惆怅。\n何处春风吹晓幕，江南绿水通珠阁。\n美人二八颜如花，泣向花前畏花落。\n临春风，听春鸟。\n别时多，见时少。\n愁人一夜不得眠，瑶井玉绳相对晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵张甥棠美述志","author":"苏轼","text":"仲子甘心织屦避万钟，渊明不肯折腰为五斗。\n一年鸿雁识来往，终日沐猴谁去取。\n知甥诗意慕两君，读书要在存心久。\n平生所谈性命奥，长弃不忧金石朽。\n我今已习鹙子定，犹复晨朝怖头走。\n刳心先拟谢声名，不作羊邹悲岘首。\n云梯雨矢集无方，我已中灰同墨守。\n恐甥自是禹门鳞，未可潜逃入吾薮。\n琢磨晚觉孟光贤，畏我放言时被肘。\n甥能锄我青门瓜，正午时来休老手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观开西湖次吴左丞韵","author":"苏轼","text":"伟人谋议不求多，事定纷纷自唯阿。\n尽放龟鱼还绿浦，肯容萧苇障前坡。\n一朝美事谁能纪，百尺苍崖尚可磨。\n天上列星当亦喜，月明时下浴晴波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏题巫山县用杜子美韵","author":"苏轼","text":"巴俗深留客，吴侬但忆归。\n直知难共语，不是故相违。\n东县闻铜臭，江陵换裌衣。\n丁宁巫峡雨，慎莫暗朝晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答晁以道索书","author":"苏轼","text":"阅世真难记，如公自不忘。\n其于书太简，正以懒相妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈伯比和回字复次韵","author":"苏轼","text":"田里冯生宁屑去，湖海陈侯犹肯来。\n诗书好在家四壁，蒲柳蓊然城一隈。\n骑上下山亦疏矣，鯈从容出何为哉。\n市桥十步即尘土，晚雨潇潇殊未回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与道源游西庄，遇齐道人，同往草堂，为齐书此","author":"苏轼","text":"桑麻已零落，藻荇复消沉。\n园宅在人境，岁时伤我心。\n强穿南埭路，遥望北山岑。\n欲与道人语，跨鞍聊一寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答子勉三首 其一","author":"苏轼","text":"君不登郎省，还应上谏坡。\n才高殊未识，岁晚喜无他。\n枥马羸难出，邻鸡冻不歌。\n寒炉馀几火，灰里拨阴、何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答子勉三首 其三","author":"苏轼","text":"欧倩腰支柳一涡，小梅催拍大梅歌。\n舞馀片片梨花落，争奈当涂风物何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和子由次王巩韵，「如囊」之句，可为一噱","author":"苏轼","text":"平生未省为人忙，贫贱安闲气味长。\n粗免趋时头似葆，稍能忍事腹如囊。\n简书见迫身今老，尊酒闻呼首一昂。\n欲挹天河聊自洗，尘埃满面鬓眉黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元祐癸酉八月二十七日，于建隆章净馆，书赠王觏","author":"苏轼","text":"海上东风犯雪来，腊前先折镜湖梅。\n遥思禁苑青春夜，坐待宫人画诏回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东园","author":"苏轼","text":"岑寂东园可散愁，胶胶扰扰梦神州。\n万竿苦竹旌旂卷，一部鸣蛙鼓吹收。\n雨后月前天欲冷，身闲心远地偏幽。\n杜门谢客恐生谤，且作人间鹏鴳游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"藏春坞","author":"苏轼","text":"朱阁前头露井多，碧桃花下美人过。\n寒泉未必能胜此，奈有银瓶素绠何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵参寥寄少游","author":"苏轼","text":"岩栖木石已皤然，交旧何人慰眼前。\n素与昼公心印合，每思秦子意珠圆。\n当年步月来幽谷，拄杖穿云冒夕烟。\n台阁山林本无异，故应文字不离禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠仲勉子文","author":"苏轼","text":"雨昏南浦曾相对，雪满荆州喜再逢。\n有子才如不羁马，知君心似后凋松。\n闲看书册应多味，老傍人门想更慵。\n何日晴轩观笔砚，一杯相属更从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"讲武台南有感","author":"苏轼","text":"山城九月冒朝寒，讲武台南路屈盘。\n驺子雨中乘马去，村童烟外倚墙看。\n鸦啼冢木秋风急，鹭立渔船夜水乾。\n花似去年堪折赠，插花人去泪阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"移合浦郭功甫见寄","author":"苏轼","text":"君恩浩荡似阳春，合浦何如在海滨。\n莫趁明珠弄明月，夜深无数采珠人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题怀素草帖","author":"苏轼","text":"人人送酒不曾沽，终日松间挂一壶。\n草圣欲成狂便发，真堪画作《醉僧图》。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仆年三十九，在润州道上过除夜，作此诗。又二十年，在惠州，追录之以付过，二首 其一","author":"苏轼","text":"寺官官小未朝参，红日半窗春睡酣。\n为报邻鸡莫惊觉，更容残梦到江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仆年三十九，在润州道上过除夜，作此诗。又二十年，在惠州，追录之以付过，二首 其二","author":"苏轼","text":"钓艇归时菖叶雨，缲车鸣处楝花风。\n长江昔日经游地，尽在如今梦寐中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"万州太守高公宿约游岑公洞，而夜雨连明，戏赠二小诗 其二","author":"苏轼","text":"蓬窗高枕雨如绳，恰似糟床压酒声。\n今日岑公不能饮，吾侪犹健可频倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送柳宜归","author":"苏轼","text":"折脚铛边煨淡粥，曲枝桑下饮离杯。\n书生不是南迁客，魑魅惊人须早回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢都事惠米","author":"苏轼","text":"平生忍欲今忍贫，闭口逢人不少陈。\n俸薄身轻赵都事，也能作意向诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句三首 其一","author":"苏轼","text":"松柏萧森溪水南，道人只作两团庵。\n市区收罢豚鱼税，来与弥陀共一龛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33457,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句三首 其二","author":"苏轼","text":"此身分付一蒲团，静对萧萧竹数竿。\n偶为老僧煎茗粥，自携修绠汲清泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33458,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句三首 其三","author":"苏轼","text":"天风吹月入栏干，乌鹊无声夜向阑。\n织女明星来枕上，乃知身不在人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33459,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睡起","author":"苏轼","text":"柿叶满庭红颗秋，薰炉沉水度春篝。\n松风梦与故人遇，自驾飞鸿跨九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33460,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋思寄子由","author":"苏轼","text":"黄叶山川知晚秋，小虫催女献功裘。\n老松阅世卧云壑，挽著苍江无万牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33461,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"侯滩","author":"苏轼","text":"江边皎皎过侯滩，更上山腰看打盘。\n百岁老儿亲击鼓，城中忧患不相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33462,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"火星岩","author":"苏轼","text":"火星岩下石凌壁，阁上相忘止一僧。\n莫问人间兴废事，门前流水几前灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33463,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢惠猫儿头笋","author":"苏轼","text":"长沙一日煨笾笋，鹦鹉洲前人未知。\n走送烦公助汤饼，猫头突兀鼠穿篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33464,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题净因壁","author":"苏轼","text":"瞑倚蒲团卧钵囊，半窗疏箔度微凉。\n蕉心不展待时雨，葵叶为谁倾夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33465,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题净因院","author":"苏轼","text":"门外黄尘不见山，个中草木亦常闲。\n履声如渡薄冰过，催粥华鲸守夜阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33466,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同景文咏莲塘","author":"苏轼","text":"塘上钩帘对晚香，不知斜日已侵床。\n江妃自惜凌波袜，长在高荷扇影凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33467,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹枝词","author":"苏轼","text":"自过鬼门关外天，命同人鲊瓮头船。\n北人堕泪南人笑，青嶂无梯闻杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33468,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄欧阳叔弼","author":"苏轼","text":"昔葬衣冠今在否，近来消息不须疑。\n曾闻圯上逢黄石，久矣留侯不见欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33469,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和黄龙清老三首 其一","author":"苏轼","text":"万山不隔中秋月，一雁能传寄远书。\n深密伽陀枯战笔，真诚相见问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33470,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和黄龙清老三首 其二","author":"苏轼","text":"风前橄榄星宿落，月下桄榔羽扇开。\n静默堂中有相忆，清江或遣化人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33471,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和黄龙清老三首 其三","author":"苏轼","text":"骑驴觅驴真可笑，以马喻马亦成痴。\n一天月色为谁好，二老风流各自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33472,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过土山寨","author":"苏轼","text":"南风日日纵篙撑，时喜北风将我行。\n汤饼一杯银线乱，蒌蒿如箸玉簪横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33473,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"跋姜君弼课册","author":"苏轼","text":"云兴天际，歘若车盖。\n凝矑未瞬，弥漫霮䨴。\n惊雷出火，乔木麋碎。\n殷地爇空，万夫皆废。\n霤绠四坠，日中见昧。\n移晷而收，野无完块。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33474,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惠崇芦雁","author":"苏轼","text":"惠崇烟雨芦雁，坐我潇湘洞庭。\n欲买扁舟归去，故人云是丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33475,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子瞻和渊明拟古九首 其一","author":"苏辙","text":"客居远林薄，依墙种杨柳。\n归期未可必，成阴定非久。\n邑中有佳士，忠信可与友。\n相逢话禅寂，落日共杯酒。\n艰难本何求，缓急肯相负。\n故人在万里，不复为薄厚。\n米尽鬻衣裳，时劳问无有。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33476,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子瞻和渊明拟古九首 其二","author":"苏辙","text":"闭门不复出，兹焉若将终。\n萧然环堵间，乃复有为戎。\n我师柱下史，久以雌守雄。\n金刀虽云利，未闻能斫风。\n世人欲困我，我已长安穷。\n穷甚当辟谷，徐观百年中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33477,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子瞻和渊明拟古九首 其三","author":"苏辙","text":"萧萧发垂素，晡日迫西隅。\n道人闵我老，元气时卷舒。\n岁晚风雨交，何不完子庐。\n万法灭无馀，方寸可久居。\n将扫道上尘，先拔庭中芜。\n一净百亦净，物我皆如如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33478,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子瞻和渊明拟古九首 其四","author":"苏辙","text":"夜梦披发翁，骑驎下大荒。\n独行无与游，闯然欸我堂。\n高论何峥嵘，微言何渺茫。\n我徐听其说，未离翰墨场。\n平生气如虹，宜不葬北邙。\n少年慕遗文，奇姿揖昂扬。\n衰罢百无用，渐以圆斲方。\n隐约就所安，老退还自伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33479,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子瞻和渊明拟古九首 其五","author":"苏辙","text":"佛法行中原，儒者耻论兹。\n功施冥冥中，亦何负当时。\n此方旧杂染，浑浑无名缁。\n治生守家世，坐使斯人疑。\n未知酒肉非，能与生死辞。\n炽哉吴闽间，佛事不可思。\n生子多颖悟，德报岂吾欺。\n时俾正法眼，一出照曜之。\n谁为邑中豪，勤诵我此诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33480,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子瞻和渊明拟古九首 其六","author":"苏辙","text":"忧来感人心，悒悒久未和。\n呼儿具浊酒，酒酣起长歌。\n歌罢还独舞，黍麦力诚多。\n忧长酒易消，脱去如风花。\n不悟万法空，子如此心何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33481,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子瞻和渊明拟古九首 其七","author":"苏辙","text":"杜门人笑我，不知有天游。\n光明遍十方，咫尺陋九州。\n此观一日成，衮衮通法流。\n竿木常自随，何必返故丘。\n老聃白发年，青牛去西周。\n不遇关尹喜，履迹谁能求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33482,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子瞻和渊明拟古九首 其八","author":"苏辙","text":"耝田种紫芝，有根未堪采。\n逡巡岁月度，太息毛发改。\n晨朝玉露下，滴沥投沧海。\n须芽忽长茂，枝叶行可待。\n夜烧沉水香，持戒勿中悔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33483,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵子瞻和渊明拟古九首 其九","author":"苏辙","text":"海康杂蛮蜑，礼俗久未完。\n我居久闾阎，愿先化衣冠。\n衣冠一有耻，其下胡为颜。\n东邻有一士，读书寄贤关。\n归来奉亲友，跬步行必端。\n慨然顾流俗，叹息未敢弹。\n提提乌鸢中，见此孤翔鸾。\n渐能衣裘褐，袒裼知恶寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33484,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次晁无咎韵阎子常携琴入村","author":"苏轼","text":"士寒饿，古犹今。\n向来亦有子桑琴，倚楹啸歌非寓淫。\n伯牙山高水深深，万世二垄一知音。\n阎君七弦抱幽独，晁子为之《梁父吟》。\n天寒络纬悲向壁，秋高风露声入林。\n冷丝枯木拂蛛网，十指巧能写人心。\n○○击鼓如鸣鼍，○○○○○成螺。\n岁丰寒士亦把酒，满眼饤饾梨枣多。\n晁家公子屡经过，笑谈与世殊臼科。\n文章落落映晁、董，诗句往往如阴、何。\n阎夫子，勿谓使人难，使琴抑怨天不和。\n明光昼开九○肃，不令高才牛下歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33485,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和南都赵少师","author":"苏轼","text":"富贵功名已两忘，望高嵩华量包湘。\n还家傲似蒙庄子，定策忠于汉霍光。\n远访交亲情益重，共论诗酒兴偏长。\n园亭继日休车马，却悔多年滞庙堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33486,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄汝阴少师","author":"苏轼","text":"得时行道善知终，猛退如公世罕逢。\n掷弃浮名同敝屣，保全高节似寒松。\n文章千古进谟诰，勋业三朝镂鼎钟。\n见说新堂频燕会，故时宾客定相容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33487,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日寄友人","author":"张咏","text":"柳条风暖会吟时，林下池边屐齿移。\n别后过从更疏懒，暮蝉嘹乱不胜悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33488,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雷岩诗","author":"苏轼","text":"空岩发灵籁，彷佛如风雷。\n只疑函宝剑，天遣六丁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33489,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"治易洞","author":"苏轼","text":"自昔遥闻太守高，明爻象彖日忘劳。\n洞中陈迹今如扫，斯道何曾损一毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33490,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵钱穆父还张天觉行县诗卷","author":"苏轼","text":"君如天马玉花骢，万里须臾不计功。\n投刃皆虚有馀地，运斤不辍自成风。\n如何十日敲榜外，已复千篇笑语中。\n只恐学禅馀此在，卓锥犹是去年穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33491,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失题一首","author":"苏轼","text":"读书头欲白，相对眼终青。\n身更万事已头白，相对百年终眼青。\n看镜白头知我老，平生青眼为君明。\n故人相见尚青眼，新贵如今多白头。\n江山万里将头白，骨肉十年终眼青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":33492,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]