[{"title":"依韵和王安之少卿秋约吟","author":"邵雍","text":"升沉恶足论，事体到头均。\n一片蓬蒿地，千年云水身。\n收成时正好，寒暖气初匀。\n自此过从乐，诸公莫厌频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和王安之少卿谢富相公诗","author":"邵雍","text":"宠辱见多恶足惊，出尘还喜自诚明。\n闲中气象乾坤大，静处光阴宇宙清。\n素业经纶无少愧，全功天地不虚生。\n野人何幸逢昌运，一百馀年天下平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和王安之判监少卿","author":"邵雍","text":"人行一善已为优，何况夫君百行修。\n曩日慈闱贪眷恋，多年官路不追求。\n官才少列辜清德，职异上庠尊白头。\n洛社逾时阻相见，许多欢意却还休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和王安之少卿六老诗仍见率成七首 其七","author":"邵雍","text":"林下狂歌不帖腔，帖腔安得谓之狂。\n小车行处莺花闹，大笔落时神鬼忙。\n门掩柴荆阛阓远，墙开瓮牖薜萝香。\n一般天下难寻物，洛浦清风拂面凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和王安之少卿六老诗仍见率成七首 其四","author":"邵雍","text":"六人相聚会时康，著甚来由不放狂。\n遍地园林同已有，满天风月助诗忙。\n文章高摘汉唐艳，骚雅浓薰李杜香。\n水际竹边闲适处，更无尘事只清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和王安之少卿六老诗仍见率成七首 其六","author":"邵雍","text":"见率野人成七老，野人唯解野疏狂。\n编排每日清吟苦，趁辨递年闲适忙。\n夏末喜尝新酒味，春初爱嗅早梅香。\n问君何故须如此，不奈心头一点凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和王安之少卿六老诗仍见率成七首 其二","author":"邵雍","text":"六老相陪卿与郎，闲曹饶却不清狂。\n过从无事易成乐，职局向人难道忙。\n烟柳嫩垂低更绿，露桃红裛暖仍香。\n乘春醉卧花阴下，恰到花阴别是凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和田大卿见赠","author":"邵雍","text":"日日步家园，清风不著钱。\n城中得野景，竹下弄飞泉。\n自愿无嗟若，何妨养浩然。\n却惭天下士，语道未忘筌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和刘职方见赠","author":"邵雍","text":"造物工夫意自深，从吾所乐是山林。\n少因多病不干禄，老为无才难动心。\n花月静时行水际，蕙风香处卧松阴。\n闲窗一觉从容睡，愿当封侯与赐金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和吴传正寺丞见寄","author":"邵雍","text":"五十年来读旧书，世间应笑我迂疏。\n因思偊女忘今古，遂悟轮人致疾徐。\n道业未醇诚可病，生涯虽薄敢言虚。\n时和受赐已多矣，安有胸中不晏如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和寿安尹尉有寄","author":"邵雍","text":"不向红尘浪着鞭，殊无才业合时贤。\n本酬壮志都无效，欲住青山却有缘。\n翠竹阴中开缥帙，白云堆里揖飞泉。\n锦屏正与溪南对，他日从游子子传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和张子坚太博","author":"邵雍","text":"八载相逢恨未平，如何别酒又还倾。\n虽惭坦率珠多类，却识清和玉有声。\n处世当为天下士，赏花须是洛阳城。\n也知今古真男子，造化功夫不易生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和陈成伯著作长寿雪会","author":"邵雍","text":"琼苑群花一夜新，瑶台十二玉为尘。\n城中竹叶涌增价，坐上杨花盛学春。\n时会梁园皆墨客，谁思姑射有神人。\n馀粮岂止千仓望，盈尺仍宜莫厌频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和陈成伯著作史馆园会上作","author":"邵雍","text":"竹绕长松松绕亭，令人到此骨毛清。\n梅梢带雪微微拆，水脉连冰湱湱鸣。\n残腊岁华无奈感，半醺襟韵不胜情。\n谁怜相国名空在，吾道如何必可行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和镇戎倅龚章屯田","author":"邵雍","text":"十五年前初见君，见君情意便如亲。\n虽然林下无他事，不那心间思故人。\n万物比之论至底，丹诚到了总输真。\n过从洛社胜诸处，何日能来共卜邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵寄成都李希淳屯田","author":"邵雍","text":"思君君未还，君恋蜀中官。\n白首虽知倦，清衷宜自宽。\n花时难得会，蚕市易成欢。\n莫叹归休晚，生涯苦未完。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵答友人","author":"邵雍","text":"百万貔貅动塞尘，朝廷委寄不轻人。\n胡儿生事虽然浅，国士尽忠须是纯。\n陇上悲歌应愤惋，林间酣饮但酸辛。\n欲陈一句好言语，只恐相知未甚真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵答王安之少卿","author":"邵雍","text":"叠巘如屏四面开，可堪虚使乱云堆。\n已曾同赏花无限，须约共游山几回。\n未老秋光诗拥笔，乍凉天气酒盈杯。\n轻风早是得人喜，更向芰荷深处来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵谢登封刘李裴三君见约游山","author":"邵雍","text":"诸公见约往嵩前，重走新诗各一篇。\n摆落尘埃非敢后，访寻云水奈输先。\n三阳宫近丛幽石，万岁峰高羃紫烟。\n多少胜游俱未到，愿陪仙躅共攀缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和人放怀","author":"邵雍","text":"为人虽未有前知，富贵功名岂力为。\n涤荡襟怀须是酒，优游情思莫如诗。\n况当水竹云山地，忍负风花雪月期。\n男子雄图存用舍，不开眉笑待何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和人闻韩魏公出镇永兴过洛","author":"邵雍","text":"佐命三朝为太宰，名垂千古号元功。\n栽培桃李满天下，出入风涛半海中。\n虎帐夜寒心益壮，凤池波暖位犹空。\n君王鼎盛子仪在，万里河湟不足攻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和内乡李师甫长官见寄 其一","author":"邵雍","text":"虽未似神仙，能逃暑与寒。\n何尝无水竹，未始离林峦。\n道不同新学，才难动要官。\n时和岁丰后，亦自有馀欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和内乡李师甫长官见寄 其二","author":"邵雍","text":"岁丰时又康，为邑在南阳。\n不废吏民事，得游云水乡。\n春输桃李艳，风荐蕙兰香。\n太守兼贤杰，且无奔走忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王不疑郎中见赠","author":"邵雍","text":"二十年来住洛都，眼前人事任纷如。\n形同草木何胜野，心类钟彝不啻虚。\n已沐仁风深骨髓，更惊诗思剧琼琚。\n庄周休道亏名实，自是无才悦众狙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王中美大卿致政二首 其二","author":"邵雍","text":"自古有才思奋飞，夫君何故独知时。\n平生怀抱未少屈，盛世挂冠良得宜。\n入格柳拖风细细，压春花笑日迟迟。\n传呼震地门前过，更不令人问是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王中美大卿致政二首 其一","author":"邵雍","text":"等候人间七十年，便如平子赋归田。\n知时所得诚多矣，养志其谁曰不然。\n况有林泉情悦乐，却无官守事拘牵。\n小车近日曾驰谒，正值夫君春昼眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王安之少卿雨后","author":"邵雍","text":"焦劳九夏馀，一雨物皆苏。\n蛙鼓不足听，蚊雷未易驱。\n非唯仰岁给，抑亦了官输。\n林下闲游客，何妨尽自愉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王安之少卿秋游","author":"邵雍","text":"春夏而来可作诗，虽然可作待何为。\n屡空滥得同颜子，历物固难如惠施。\n风月情怀无奈处，云山意思不胜时。\n一歌一咏聊酬唱，敢拒安之与静之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王安之少卿韵","author":"邵雍","text":"却恐乡人未甚知，相知深后又何疑。\n贫时与禄是可受，老后得官难更为。\n自有林泉安素志，况无才业动丹墀。\n荀杨若守吾儒分，免被韩文议小疵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王规甫司勋见赠","author":"邵雍","text":"何止千年与万年，岁寒松桂独依然。\n若无扬子天人学，安有庄生内外篇。\n已约月陂寻白石，更期金谷弄清泉。\n谁云影论纷纭甚，一任山巅复起巅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孙传师秘校见赠","author":"邵雍","text":"天津南畔是吾庐，时荷夫君枉乘车。\n始为退来忘检束，却因闲久长空疏。\n与其功业逋青史，孰若云山负素书。\n一片丹诚最难状，庶几长得类舟虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和君实端明","author":"邵雍","text":"养道自安恬，霜毛一任添。\n且无官责咎，幸免世猜嫌。\n蓬户能安分，藜羹固不厌。\n一般偏好处，曝背向前檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和君实端明见赠","author":"邵雍","text":"曾不见譊譊，城中类远郊。\n虽无千里马，却有一枝巢。\n月出云山背，风来松竹梢。\n顽然何所得，岂复避人嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和君实端明花庵独坐","author":"邵雍","text":"静坐养天和，其来所得多。\n耽耽同厦宇，密密引藤萝。\n忘去贵臣度，能容野客过。\n系时休戚重，终不道如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和吴冲卿省副见赠","author":"邵雍","text":"非有非无是祖乡，都来相去一毫芒。\n人人可到我未到，物物不妨谁与妨。\n失即肝脾为楚越，得之藜藿是膏粱。\n一言千古难知处，妙用仍须看吕梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张二少卿丈白菊","author":"邵雍","text":"清淡晓凝霜，宜乎殿颢商。\n自知能洁白，谁念独芬芳。\n岂为琼无艳，还惊雪有香。\n素英浮玉液，一色混瑶觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李文思早秋五首 其五","author":"邵雍","text":"日脚云微淡，林梢叶渐黄。\n可堪须变色，彻了为侵霜。\n酒到难成醉，风来易得凉。\n老年何所欲，唯愿且平康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李文思早秋五首 其四","author":"邵雍","text":"池畔拖垂柳，栏边笑晚花。\n败荷倾弊盖，老桧露枯槎。\n岁暮惊时态，年高惜物华。\n东陵风未替，解忆故园瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李文思早秋五首 其三","author":"邵雍","text":"王金秋已至，烁石景方阑。\n直养能希孟，闲居肯让潘。\n竹间风嘒嘒，松罅月团团。\n洛社多贤友，人人可共欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李文思早秋五首 其二","author":"邵雍","text":"径小新经雨，庭幽遍有苔。\n风前闲意思，阶下静徘徊。\n不分筋骸老，难甘岁月催。\n时时藉芳草，赖有酒同杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李文思早秋五首 其一","author":"邵雍","text":"一雨洗觚棱，三川气象清。\n林风传颢气，木叶送商声。\n忽忽莲生的，看看菊吐英。\n太平时里老，何以报虚生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李审言龙图大雪","author":"邵雍","text":"万树琼花一夜开，都和天地色皑皑。\n素娥腰细舞将彻，白玉堂深曲又催。\n瓮牖书生方挟策，沙场甲士正衔枚。\n幽人骨瘦欲清损，赖有时时酒一杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和花庵上牵牛花","author":"邵雍","text":"叶闹深如幄，花繁翠似钿。\n瀼瀼零晓露，羃羃蔽晴烟。\n谢既成番次，开仍有后先。\n主人凝伫苦，长是废朝眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和闲来","author":"邵雍","text":"以身观万物，万物理非遥。\n马为乘多瘦，龟因灼苦焦。\n能言谢鹦鹉，易饱过鹪鹩。\n伊洛好烟水，愿同渔与樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和和承制见赠","author":"邵雍","text":"自度无能处世间，经冬经夏掩柴关。\n青云路稳无功上，翠竹丛疏有分闲。\n犹许艳花酬素志，更将佳酒发酡颜。\n年来老态非常甚，长惧英才未易攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和相国元老","author":"邵雍","text":"崇台未经庆，瑞雪下云端。\n虽地尽成白，而天不甚寒。\n有年丰可待，盈尺润难乾。\n畎亩无忘处，追踪击壤欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和祖龙图见寄","author":"邵雍","text":"吾家职分是云山，不见云山不解颜。\n游兴亦难拘日阻，梦魂都不到人间。\n烟岚欲极无涯乐，轩冕何尝有暂闲。\n洛社交朋屡相约，几时曾得略跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和绛守王仲贤郎中","author":"邵雍","text":"为郎得绛分铜虎，见寄诗中非浪誇。\n地土尚传唐草木，山川犹起晋云霞。\n园池富有吟供笔，风俗淳无讼到衙。\n太守下车民受赐，一心殊不负官家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵充道秘丞见赠","author":"邵雍","text":"人言人事危冠冕，吾爱吾庐远市朝。\n野面不堪趋魏阙，闲身唯称访杨寥。\n殊无纪律诗千首，富有云山酒一瓢。\n预借轩车又东去，自兹风月恐难招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和商守西楼雪霁","author":"邵雍","text":"大雪初晴日半曛，高楼何惜上仍频。\n数峰崷崒剑铓立，一水萦纡冰缕新。\n昆岭移归都是玉，天河落后尽成银。\n幽人自恨无佳句，景物从来不负人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和商守雪残登楼","author":"邵雍","text":"残雪已消冰已开，风光渐觉拥楼台。\n旅人未遂日边去，春色又从天上来。\n况是樽中常有酒，岂堪岭上却无梅。\n若非太守金兰契，谁肯倾心重不才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和商守雪霁对月","author":"邵雍","text":"雪满群山霜满庭，光寒月碾一轮轻。\n羁怀殊少向时乐，皓彩空多此夜明。\n竹近帘栊饶碎影，风涵台榭有馀清。\n恨无好句酬佳景，徒自凄凉梦不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和商守雪霁登楼","author":"邵雍","text":"百尺危楼小雪晴，晚来闲望逼人清。\n山横暮霭高还下，水隔疏林淡复明。\n天际落霞千万缕，风馀残角两三声。\n此时此景真堪画，只恐丹青笔未精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和商守登楼看雪","author":"邵雍","text":"西楼赏雪眼偏明，次第身疑在水晶。\n千片万片巧妆地，半舞半飞斜犯楹。\n形如玉屑依还碎，体似杨花又更轻。\n谁谓天涯有羁客，一般对酒两般情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和商守新岁","author":"邵雍","text":"衰躯在旅逢新岁，因感平生鬓易凋。\n饮罢襟怀还寂寞，欢馀情绪却无聊。\n望仙风月晴偏好，抹绿帘栊夜正遥。\n对此块然唯土木，降兹未始不魂销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和登封裴寺丞翰见寄","author":"邵雍","text":"陋巷箪瓢世所传，予何人则耻萧然。\n既知富贵须由命，难把升沉更问天。\n静默有功成野性，骞骧无路学时贤。\n纷华出入金门者，应笑溪翁治石田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和魏教授见赠","author":"邵雍","text":"清世文章日月悬，无才唯幸乐丰年。\n游山太室更少室，看水伊川又洛川。\n古有孟轲难语觉，时无颜子易为贤。\n读书每到天根处，长惧诸公问极玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和夔峡张宪白帝城怀古","author":"邵雍","text":"不愤曹公跨许昌，苟非梁益莫争王。\n三分区宇风雷恶，横截西南气势强。\n行客往来闲指点，史官褒贬浪文章。\n后人未识兴亡意，请看江心旧战场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"所感吟","author":"邵雍","text":"人生无定准，事体有多端。\n客宦危疑处，家书子细看。\n既曾忧险阻，方信喜平安。\n男子平生事，须于痛定观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"放小鱼","author":"邵雍","text":"纤鳞不足留，此失一生休。\n放尔江湖去，宽渠鼎镬游。\n更宜深避网，慎勿误吞钩。\n天下多庖者，无令落庶羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"放言","author":"邵雍","text":"既得希夷乐，曾无宠辱惊。\n泥空终是着，齐物到头争。\n忽忽闲拈笔，时时自写名。\n谁能苦真性，情外更生情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林下五吟 其二","author":"邵雍","text":"老年躯体索温存，安乐窝中别有春。\n万事去心闲偃仰，四支由我任舒伸。\n庭花盛处凉铺簟，檐雪飞时软布裀。\n谁道山翁拙于用，也能康济自家身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林下五吟 其四","author":"邵雍","text":"相招相劝饮流霞，鬓乱秋霜发乱华。\n所记莫非前甲子，凡经多是老官家。\n共誇今日重孙过，更说当时旧事呀。\n言语丁宁有情味，后生无笑太周遮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林下五吟 其五","author":"邵雍","text":"生来未始事田畴，无岁无时长有秋。\n随分杯盘俱是乐，等闲池馆便成游。\n风花雪月千金子，水竹云山万户侯。\n欲俟河清人寿几，两眉能著几多愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林下五吟 其三","author":"邵雍","text":"有物轻醇号太和，半醺中最得春多。\n灵丹换骨还如否，白日升天似得么。\n尽快意时仍起舞，到忘言处只讴歌。\n宾朋莫怪无拘检，真乐攻心不奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":3235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]