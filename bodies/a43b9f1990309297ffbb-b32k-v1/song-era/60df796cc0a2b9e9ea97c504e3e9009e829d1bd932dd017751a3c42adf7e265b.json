[{"title":"出朝赋归来好 其十一","author":"徐经孙","text":"归来好，万喜千欢无烦恼。\n日课吾孙读古书，此是吾家传世宝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31913,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"北坑拜扫有感","author":"徐经孙","text":"手植松楸四十年，扶疏枝叶欲参天。\n四儿惟有衰翁在，时领孙曹拜墓前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31914,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题金鱼郎","author":"徐经孙","text":"金鱼有术妙谈天，走遍江湖谒踆躔。\n玉带贵人如一遇，定知换酒不论钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31915,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠射虎人","author":"徐经孙","text":"冯妇下车须有勇，将军射石亦通神。\n南山白额新除害，好赏今时射虎人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31916,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"去国","author":"徐经孙","text":"崎岖山路记曾游，谁识为臣去国愁。\n柏府官中羞豸角，桐江台上愧羊裘。\n重违君命留行者，既竭吾才归去休。\n霜露感人千里思，松楸未扫已三秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31917,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"北壑瀛洲亭","author":"徐经孙","text":"山中有水水中洲，欲访蓬瀛此处求。\n孤屿插天如搢笏，危亭临渚似飞楼。\n并崖香草仙馀药，隔岸人家风引舟。\n个里藏脩功行满，弘文学馆快情游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31918,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山塘精舍","author":"徐经孙","text":"归来鱼鸟亦相亲，草创山塘谩以名。\n旋筑堤防留水住，尽除菑翳听松声。\n族姻语语人情洽，云势阴阴天气清。\n好续溪山真率会，从今八景又重成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31919,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"恭和御制诗","author":"徐经孙","text":"多士新弹贡禹冠，对天忠切动龙颜。\n胪传声彻颁袍笏，燕喜筵开肃佩环。\n乐奏箫韶成广内，诗成奎画照人间。\n微臣捧诏惭疏拙，也抱传宣拜赐还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31920,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"弭节堂","author":"徐经孙","text":"慇勤主礼重宾荣，弭节新堂庆落成。\n语熟不妨移座密，更长那复记杯行。\n辖投相共传佳话，榻下于今见故情。\n太史定知牛斗分，客星也傍使星明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31921,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庆仲明弟领乡荐","author":"徐经孙","text":"记得溪山横膝语，何时解取世科收。\n荐名恰在二八数，屈指重来四十秋。\n岁月滔滔催后进，功名冉冉继前脩。\n福州得捷知安福，更愿君恩赐状头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31922,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"福州即景","author":"徐经孙","text":"一别居诸岁月增，遥闻此景画难能。\n潮田种稻重收谷，道路逢人半是僧。\n城里三山千簇寺，夜间七塔百枝灯。\n常年六月东山里，地涌寒泉漱齿冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31923,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"福州鹿鸣宴","author":"徐经孙","text":"鹿鸣今日宴佳宾，六万场中一百人。\n鳌岭峰前连巨钓，龙台高处耀脩鳞。\n假途文字皆由命，实地功名好致身。\n得意春风马蹄速，杏园交庆绿袍新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31924,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"长孙敏学授承务郎","author":"徐经孙","text":"辛勤场屋一书生，六卷时文谩策名。\n身事两朝奚所补，恩覃五世亦何荣。\n前人庆泽宜丰报，尔辈官曹讵可轻。\n移孝为忠斯不负，更须勤学绍家声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31925,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄元肇江山风月阁","author":"徐经孙","text":"江山到处堪图画，风月无边自古今。\n但要清明如外境，便分动静即吾心。\n坡仙取用原无尽，康节登临岂浪吟。\n天理流行须体识，莫将嘲弄费光阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31926,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"培芳亭草创胥会","author":"徐经孙","text":"培芳草创强铺筵，画出清明三月天。\n长少团栾还五世，笑谈邂逅集群贤。\n或歌或弈杯无算，非竹非丝乐自然。\n过则相规善相勉，须令和气蔼无边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31927,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送仲时弟","author":"徐经孙","text":"江关千里隔山川，有弟能来慰眼前。\n方喜雁行随处乐，可堪蟾影别时圆。\n暑行勿亟宜强饭，湍激多惊莫问船。\n归到家山相劳苦，团栾恰是菊花天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31928,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题西坡屷心亭","author":"徐经孙","text":"翛然古木湛然池，乐意相关自造微。\n庄子非鱼真实问，海翁狎鸟本忘机。\n樽中有酒逢人酌，琴上无弦信手挥。\n秃尽剡藤吟不就，妙哉川泳与云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31929,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"贺汝立拜恩封","author":"徐经孙","text":"君恩岁序两俱新，鸾诰叨荣鹤发亲。\n天上龙光疏雨露，堂前燕笑寿松椿。\n孙枝子舍皆腾踏，兰省璧池交问津。\n此去椒盘重献颂，斑衣中有绿衣人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31930,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和李后林分惠琼花降字韵","author":"徐经孙","text":"诗句寻芳自抑扬，一观佳什觉心降。\n山中玉蕊虽无数，天上琼花孰有双。\n愧我未能瞻后土，荷君分惠到南窗。\n从今可小中兴瑞，大地移根到此邦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31931,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乙丑三月十二夜梦得家有园池乐寿康之句觉而足成效邵康节作首尾吟八首 其一","author":"徐经孙","text":"家有园池乐寿康，四时随分得徜徉。\n鱼游春水吾同趣，莲拆秋房客共尝。\n风里松声传古调，雪中梅蕊验初阳。\n官闲身老犹帮俸，家有园池乐寿康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31932,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乙丑三月十二夜梦得家有园池乐寿康之句觉而足成效邵康节作首尾吟八首 其二","author":"徐经孙","text":"家有园池乐寿康，闲中日月觉偏长。\n睡馀携幼游花圃，饭后呼童给鹤粮。\n堆案纵横书数册，随盘欢喜酒三觞。\n客来问我浑无事，家有园池乐寿康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31933,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乙丑三月十二夜梦得家有园池乐寿康之句觉而足成效邵康节作首尾吟八首 其三","author":"徐经孙","text":"家有园池乐寿康，君恩广大寿无疆。\n玉龙自是神仙骨，紫殿容依日月光。\n不织不蚕时赐帛，无功无过岁支粮。\n老臣得此知惭愧，家有园池乐寿康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31934,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乙丑三月十二夜梦得家有园池乐寿康之句觉而足成效邵康节作首尾吟八首 其四","author":"徐经孙","text":"家有园池乐寿康，抚存松菊未为荒。\n斛租不及胡椒数，樊圃何如步障长。\n静里谩看猿弄臂，闲中时听鹤鸣吭。\n山林阴密宜藏拙，家有园池乐寿康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31935,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乙丑三月十二夜梦得家有园池乐寿康之句觉而足成效邵康节作首尾吟八首 其五","author":"徐经孙","text":"家有园池乐寿康，人生何用苦乾忙。\n三冬惯曝茅檐日，九夏贪眠竹簟凉。\n大写文书遮老眼，熟煨芋栗饱枯肠。\n无荣无辱浑无事，家有园池乐寿康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31936,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乙丑三月十二夜梦得家有园池乐寿康之句觉而足成效邵康节作首尾吟八首 其六","author":"徐经孙","text":"家有园池乐寿康，北窗何敢傲羲皇。\n池开满引灵渊脉，户厂西迎太乙光。\n初节易渝谁保晚，好人难做必观常。\n老来自适闲中趣，家有园池乐寿康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31937,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乙丑三月十二夜梦得家有园池乐寿康之句觉而足成效邵康节作首尾吟八首 其七","author":"徐经孙","text":"家有园池乐寿康，晴檐曝日小春阳。\n炉存榾柮火难过，?酌芹蔬味更长。\n更觉寒威潜出户，便令和气复连床。\n团圆家庆堪图写，家有园池乐寿康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31938,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"乙丑三月十二夜梦得家有园池乐寿康之句觉而足成效邵康节作首尾吟八首 其八","author":"徐经孙","text":"家有园池乐寿康，浮云富贵利名场。\n栏栽药相扬楼美，坛植花王姚魏良。\n忘机久结盟鸥社，得意闲观狎鹭塘。\n提壶挈榼堪游赏，家有园池乐寿康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31939,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丙寅九月送龙门课试士友","author":"徐经孙","text":"凉风九月菊花天，路近龙门自坦然。\n胜友如云儒雅集，雄文丽藻灿连篇。\n平时学问勤攻玉，圣世功名好着鞭。\n黄屋临轩新策士，姓名一一听胪传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31940,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和胡适斋韵","author":"徐经孙","text":"得得高轩到涧泉，真成空谷喜跫然。\n三诗惠我惊人句，八秩如公现世仙。\n一见长身知润德，颇疑盛际有遗贤。\n君王已获非熊兆，钓隐如今起渭川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31941,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼陶德芳","author":"徐经孙","text":"袖有银毫刺史章，先生不是薄淮阳。\n倦游谁不思三径，勇退今惟见一堂。\n讲席有功周子学，义田无愧范公庄。\n忍闻耆旧铭旌举，此语吟成泪数行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31942,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秀岩 其一","author":"徐经孙","text":"风露增凉晓气清，崎岖取路绕沟塍。\n早田得雨秋耕遍，晚稻如云岁事登。\n古涧蛇行泉曲折，崇冈虎踞石棱层。\n撩人野兴皆诗料，自愧尘埃谢不能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31943,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秀岩 其二","author":"徐经孙","text":"四山环抱似围城，石屋中间地砥平。\n天隔俗尘飞不到，神开宝藏画难成。\n岩分上下光皆透，水有往来踪不明。\n可惜韩张期界上，当时过此未知名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31944,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西陵望","author":"严羽","text":"西陵终日望，不见有归桡。\n欲去犹回首，寒江起暮潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31945,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闺怨 其一","author":"严羽","text":"昨夜中秋月，含愁顾影频。\n空留可怜影，不见可怜人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31946,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闺怨 其二","author":"严羽","text":"欲作辽阳梦，愁多自不成。\n错嫌乌臼鸟，半夜隔窗鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31947,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中示同志","author":"严羽","text":"见说春帆外，康庐水石多。\n期君一把臂，长啸入烟萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31948,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"塞下绝句","author":"严羽","text":"莫被封侯误，封侯似汉家。\n君看城下骨，万古一黄沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31949,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送友人之楚州","author":"严羽","text":"黯黯离筵夕照收，江城羌笛起边愁。\n念君此去三千里，何处关山是楚州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31950,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬故人见赠","author":"严羽","text":"湘江南去少人行，瘴雨蛮烟白草生。\n谁念梁园旧词客，桄榔树下独闻莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31951,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"羽林郎","author":"严羽","text":"貂帽狐裘塞北妆，黄须年少羽林郎。\n弯弓不怕天山雪，生缚名王入建章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31952,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闺中词","author":"严羽","text":"良人西去击狂胡，妾在闺中对影居。\n万里长看天外月，一生空得梦中书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31953,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"塞下曲六首 其一","author":"严羽","text":"孤城莽莽秋天外，竟日无云空自哀。\n忽怪一时天尽黑，合群胡雁向西来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31954,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"塞下曲六首 其二","author":"严羽","text":"渺渺云沙散橐驼，风吹黄叶渡黄河。\n羌人半醉蒲萄熟，塞雁初肥苜蓿多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31955,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"塞下曲六首 其三","author":"严羽","text":"古戍秋生画角哀，思归泣尽望乡台。\n胡天日落寒风起，但见黄沙万里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31956,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"塞下曲六首 其四","author":"严羽","text":"一身远客逐戎旌，落日萧条望古城。\n渐近碛西无水草，北风沙起橐驼惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31957,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"塞下曲六首 其五","author":"严羽","text":"玉关西去更无春，满眼蓬蒿起塞尘。\n汉马不归青海月，胡笳愁杀陇头人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31958,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"塞下曲六首 其六","author":"严羽","text":"天山一夜雪漫漫，虏去营空战血乾。\n十万征人回马首，天边烽火报平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31959,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江上送客","author":"严羽","text":"留君夜饮北风寒，且折梅花耐醉欢。\n明日桐庐潮去远，孤帆天际若为看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31960,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赖成之还自江西感旧有赠","author":"严羽","text":"十年心事两蹉跎，南北东西别恨多。\n今日樽前重把手，相看争奈白头何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31961,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻笛","author":"严羽","text":"江上谁家吹笛声，月明霜白不堪听。\n孤舟万里潇湘客，一夜归心满洞庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31962,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中望落星寺","author":"严羽","text":"日暮黄沙压岸平，江心风浪暗冥冥。\n南康一望何由到，愁杀舟中指落星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31963,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答李友山山中留别","author":"严羽","text":"已恨青山临渡口，相思回首隔夫君。\n更堪重到相思处，不见青山见白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31964,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日","author":"严羽","text":"西风催我转胡床，坐落秋山午梦凉。\n蝉老树深音响别，满天风雨带斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31965,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"新凉","author":"严羽","text":"小院新凉水竹通，鸣蝉声断晚来风。\n忽然坐睡瞢腾去，不觉残书落手中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31966,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"临池","author":"严羽","text":"乍凉池馆雨初收，菱角莲房共趁秋。\n独恨碧波浑占却，更无剩水浴沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31967,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"北风","author":"严羽","text":"夜来雨雪北风颠，吹得波涛欲暗天。\n世上如今少知己，烦君牢系钓鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31968,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"燕","author":"严羽","text":"巢破春雏半不存，衔泥空傍主人门。\n一生巧计输黄雀，饮啄官仓长子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31969,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴中送友归豫章","author":"严羽","text":"川程极目渺空波，送尔归舟奈别何。\n南国音书须早寄，江湖春雁已无多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31970,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"临川送周月船入京","author":"严羽","text":"别时把酒已魂销，别后音书更阒寥。\n一片离心寄春水，随君船入浙江潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31971,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"别客","author":"严羽","text":"客鬓风霜晚，离亭鼓角闻。\n念君当此去，把袂不能分。\n衡霍连秋气，潇湘合暮云。\n愁心将落叶，向晚共纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31972,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送张季远入京","author":"严羽","text":"手把一枝菊，赠金千里行。\n山川遥满目，何处是吴京。\n饮罢北风起，萧萧胡雁声。\n东流傥未尽，见我望君情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31973,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"从军行 其一","author":"严羽","text":"朔风嘶马动，遥想雁门秋。\n负剑辞乡邑，弯弓赴国雠。\n黄榆连白草，河陇去悠悠。\n报主男儿事，焉论万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31974,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"从军行 其二","author":"严羽","text":"翩翩双白马，结束向幽燕。\n借问谁家子，邯郸侠少年。\n弯弓随汉月，拂剑倚胡天。\n说与单于道，今秋莫近边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31975,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"出塞行","author":"严羽","text":"将军救朔边，都护上祁连。\n六郡飞传檄，三河聚控弦。\n连营当太白，吹角动胡天。\n何日匈奴灭，中原得晏然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31976,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"关山月","author":"严羽","text":"今夜关山月，偏能照马鞍。\n卢龙征戍客，圆缺几回看。\n遥想金闺里，应悲玉露寒。\n黄沙三万里，何日是长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31977,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蜀女怨","author":"严羽","text":"几时离月峡，五见紫兰凋。\n塞雁随魂断，江花逐泪飘。\n沙头南北客，京口去来潮。\n日日无消息，空登万里桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31978,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寻宁山人所居","author":"严羽","text":"幽人以道隐，结室岩之东。\n余亦避世客，逢君于此中。\n鸟因留食至，泉为炼丹红。\n向晚下山去，月高秋色空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31979,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江楼夜月怀故山友人陈聘君吴樗乡","author":"严羽","text":"昨夜江楼月，思君好断肠。\n猿声相应发，山色更青苍。\n楚塞来书远，闽关隔梦长。\n今朝看愁鬓，为尔半成霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31980,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江上有怀上官良史","author":"严羽","text":"忆君怅不乐，立马大江边。\n塞雁来无际，惊沙度飒然。\n客心悬日夜，书札断云天。\n莫作青山老，空为人所怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31981,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻雁","author":"严羽","text":"远客惊秋雁，高楼复异乡。\n声兼边哨苦，影落楚云长。\n此夜头堪白，他山叶又黄。\n年年洞庭浪，飘泊更无行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":31982,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]