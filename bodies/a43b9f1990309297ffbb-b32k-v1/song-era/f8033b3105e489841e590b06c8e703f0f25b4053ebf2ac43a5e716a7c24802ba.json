[{"title":"题九老图二首 其二","author":"陈造","text":"帝怜忧国许归田，犹得幽居俯涧瀍。\n应笑诗人赋招隐，茹芝带索只臞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题九老图二首 其一","author":"陈造","text":"凉亭燠馆尘埃外，野鸟溪花俎豆前。\n但爱林泉映华发，岂知勋烈载青编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题人家壁","author":"陈造","text":"等是黄粱未熟时，车尘马足竟胡为。\n山翁不起功名想，足谷多田正自奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题史髯词卷二首 其二","author":"陈造","text":"南风未蛰浙江波，倦客闲愁似许多。\n安得双鬟如阿素，红檀声里釂金荷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题史髯词卷二首 其一","author":"陈造","text":"方朔岁星仍客星，窃桃他日太狂生。\n几时又泛灵槎去，平掇天孙翠织成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题史髯诗卷后二首 其二","author":"陈造","text":"脑脂侵眼耐昏眵，诗卷犹便小字题。\n浪信奇方须损读，即今刮膜胜金篦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题史髯诗卷后二首 其一","author":"陈造","text":"平生一士万金多，更恨诗人饿涧薖。\n羁旅忽成开笑口，软红尘底得阴何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题因师百雁图二首 其二","author":"陈造","text":"闻道崔公作芦雁，端如庄叟玩鯈鱼。\n鶱翔唼啑妙百态，君看老因般礴馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题因师百雁图二首 其一","author":"陈造","text":"蓼滩芦渚好徜徉，肯便云天去作行。\n未用选奴防夜燎，不妨结伴傲晨霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题因师蒲桃图二首 其二","author":"陈造","text":"晶荧压架绀珠圆，苒蒻萦风露叶鲜。\n病酒人方渴羌似，为师开卷忍馋涎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题因师蒲桃图二首 其一","author":"陈造","text":"因师写物三昧手，公取天机付笔端。\n坐想瑛盘分磊磈，忆尝贝齿冰甘寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题因老松江烟雨图二首 其二","author":"陈造","text":"千里湖山宿雾昏，倚栏一笔解平吞。\n渔郎好在收纶罢，想踞笭箵共一樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题因老松江烟雨图二首 其一","author":"陈造","text":"远峰近薄鉴中浮，每泊行舟十日留。\n雨望晴临俱不恶，最怜烟霭暝高秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题毕直閤翻经图三首 其三","author":"陈造","text":"中原正朔合天王，细读遗书瘿作囊。\n老子披图揩病眼，为公重炷石炉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题毕直閤翻经图三首 其二","author":"陈造","text":"伯图无继昧尊王，独抱残经析渺茫。\n地下威文应吐气，人间宋李解升堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题吴子隆兼隐二首 其二","author":"陈造","text":"元亮官居亦松菊，次山生事有笭箵。\n酒如欸乃声中醉，目向平反笑处青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题吴子隆兼隐二首 其一","author":"陈造","text":"盛吉低眉亦问囚，不疑断狱但春秋。\n定知小试皮鞭罢，却唤樵青荐茗瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题坟庵壁四首 其四","author":"陈造","text":"寂寞江湖吏隐翁，平生纯默养胸中。\n即今技痒馀诗癖，时眩晴霄作綵虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题坟庵壁四首 其三","author":"陈造","text":"钟鸣已饭尚来游，竹好排门不待求。\n争席馈浆吾不计，此身沧海信虚舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题坟庵壁四首 其二","author":"陈造","text":"损益才通理洞明，不应知死异知生。\n惜无人把宣尼语，说似当年尚子平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题坟庵壁四首 其一","author":"陈造","text":"糊口卑官似不逢，解将觞咏当千钟。\n劣优何似隆中叟，投老归来作卧龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题张省干扇","author":"陈造","text":"前溪天阔渌泱泱，溪上诗翁引兴长。\n安得南风吹小艇，吟看千盖拥红妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题杜彦敷山茶","author":"陈造","text":"丹艳浓妆媚晏温，谁招妃子醉时魂。\n此花信出此君下，那有诗人来叩门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题驿舍二首 其二","author":"陈造","text":"官曹有底著迂疏，祇合江湖老钓徒。\n萍梗可能忘在莒，莼鲈祇有梦归吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题驿舍二首 其一","author":"陈造","text":"客到淮乡话楚乡，长将天末指襄阳。\n如今漂泊君休问，又过襄阳十舍彊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题柏氏壁二首 其二","author":"陈造","text":"梦觉号呼攧鹞风，忽惊肤粟似深冬。\n凄凉敛白收红后，赖有春醪琥珀浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题柏氏壁二首 其一","author":"陈造","text":"客里春光似许忙，还家馀几酒边狂。\n酴醾芍药芳期在，不问芜菁满意黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题济胜七物 一拄杖","author":"陈造","text":"惊蛇却犬破莓苔，筇竹随公几往回。\n龙化葛陂应未忍，为扶衰病作陈雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题济胜七物 七村童","author":"陈造","text":"貌野言伧却近真，客前疏略不能嗔。\n折花替我簪纱帽，看竹须渠问主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题济胜七物 二扇","author":"陈造","text":"何人月样剪霜绨，改就新诗却自题。\n为惜持杯折花手，免教遮日步苏堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题济胜七物 三钱箧","author":"陈造","text":"与人替得杖头闲，日日莲塘柳岸边。\n烂醉质衣吾不问，归时犹有买舟钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题济胜七物 五酒榼","author":"陈造","text":"相从有命每倾舒，不寄辕端即坐隅。\n肯落苏家悭妇手，深藏云待不时须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题济胜七物 六钉鞋","author":"陈造","text":"几步山间属雨馀，徐行犹可当安舆。\n计功高出芒鞋上，傍险冲泥得屡书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题济胜七物 四笔囊","author":"陈造","text":"毛锥老去未轻投，革带罗囊特命收。\n准拟西胡持酒处，偕翁濡首破诗愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题赵秀才壁","author":"陈造","text":"日日危亭凭曲栏，几山苍翠拥烟鬟。\n连朝策马冲云去，尽是亭中望处山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题赵景安二亭 尺五二首 其一","author":"陈造","text":"山亭缥缈五云连，瑞霭灵河最近天。\n当念江湖吏尘客，举头见日独悽然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题赵景安二亭 尺五二首 其二","author":"陈造","text":"仙乐惯常醒醉梦，市香不断袭衣裾。\n何须更羡城南杜，丹地黄扉即诏除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题赵景安二亭 云涛二首 其一","author":"陈造","text":"坐看银山捲坏云，涛头蜚过不逡巡。\n世间壮观何人领，付与亭中笔有神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题赵景安二亭 云涛二首 其二","author":"陈造","text":"闛沓每疑坤轴动，撞唐更恐日车翻。\n凭栏待得波声寂，擘絮依然挂海门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题项处士山堂二首 其二","author":"陈造","text":"久安楚俗眠云屋，又向吴侬倒药囊。\n出处无心俱乐地，世间何处不山堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题项处士山堂二首 其一","author":"陈造","text":"一庵小憩俗间劳，月牖风轩俯鸟巢。\n我亦青衫倦游者，羡君先办盖头茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇七首 其七","author":"陈造","text":"广寒二十五万户，跪奉素娥听指呼。\n落屑欲堆悬圃满，人间但爱玉轮孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇七首 其六","author":"陈造","text":"峨眉山北雪极目，方丈海中冰作壶。\n我自飙轮随所往，怜渠局息寄洪炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇七首 其五","author":"陈造","text":"裁就霜纨未副挥，濡毫欲下更迟迟。\n昔游尚记芜湖夜，把酒中秋见月时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇七首 其四","author":"陈造","text":"东绢须题黄绢辞，老来斲句不能奇。\n定知烁石流金日，记我持觞赏雪时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇七首 其三","author":"陈造","text":"闻道广寒修月手，静看如鉴忽如眉。\n即今扇里乘鸾女，解笑嫦娥不自持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇七首 其二","author":"陈造","text":"吴霜有信镜先知，楚雨无踪梦自迷。\n风榻烧香作僧过，罗襟得句为谁题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇七首 其一","author":"陈造","text":"桃叶渡头鱼噞春，莫愁堂上燕依人。\n玉觞欲举心先醉，痛忆当时迹未尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇集句五首 其五","author":"陈造","text":"绿槐高柳咽新蝉，绫扇唤风阊阖天。\n见欲扫床悬麈尾，簟纹如水帐如烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇集句五首 其四","author":"陈造","text":"自恨寻春去较迟，古来四事巧相违。\n如今说著成离恨，曾为梅花醉不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇集句五首 其三","author":"陈造","text":"竹里高亭灯烛光，月移花影上西厢。\n蔗浆金椀冰盘冻，始信人间五月凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇集句五首 其二","author":"陈造","text":"庭院深深深几许，美人绵渺在云堂。\n落花游丝白日静，锦荐金炉梦正长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题扇集句五首 其一","author":"陈造","text":"宝扇重寻明月影，月边仍有女乘鸾。\n主家阴洞细烟雾，姑射仙姿不畏寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题高缙之剑室二首 其二","author":"陈造","text":"皇家威德憺遐荒，何物楼兰尚颉颃。\n想见诗人攲枕处，云霄中夜有光芒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题高缙之剑室二首 其一","author":"陈造","text":"高郎櫑具映峨冠，沈燎茶铛一室安。\n游刃圣经千载计，即今长铗未须弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题乾明寺壁","author":"陈造","text":"不待车轮四角生，欲行还驻为交情。\n又成一笑渌樽晚，诗卷竹风相与清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题龚养正孩儿枕屏二首 其二","author":"陈造","text":"眼中何止舞雩音，况是君家积庆重。\n梦里送来烦孔释，要令门户继荀龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题龚养正孩儿枕屏二首 其一","author":"陈造","text":"小屏光洁雪难如，写出嬉然同队鱼。\n索句拥书皆薄相，笑啼嗔喜莫怜渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题傅商卿家壁二首 其二","author":"陈造","text":"酒处清谭烛下棋，归期初未厌迟迟。\n若为径作翩然去，明日阴晴可得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题傅商卿家壁二首 其一","author":"陈造","text":"表表两卿吾莫逆，青刍白饭玉为醅。\n因循桑下成三宿，解后花时更一来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题彭尉轩壁三首 其三","author":"陈造","text":"轩成首作梅仙客，再到园池更可观。\n日有脊令栖小树，时看鸂鶒下前滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题彭尉轩壁三首 其二","author":"陈造","text":"甓社家居水四环，房陵官舍祇重山。\n客中一旦兼双美，山影江光衽席间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689"