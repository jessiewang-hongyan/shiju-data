[{"title":"会宿再送子野","author":"赵师秀","text":"又承出郭到贫家，一度分携鬓易华。\n自说印书春可寄，独惭阙酒夜难赊。\n眠迟古鼎销残火，吟苦寒缸落细花。\n羸病不能亲送别，梦魂先立渡头沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44491,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"会景轩","author":"赵师秀","text":"此中非一景，欲状固难名。\n江近秋阴早，山多晓气清。\n断云分树泊，饥鹤下田行。\n别拟深更至，虚空看月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44492,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再游北山和韵","author":"赵师秀","text":"或行或坐水边亭，处处春风户不扃。\n飞絮伴人衰鬓白，远山学我道衣青。\n迢遥更入烟霏去，髣髴如曾梦寐经。\n恐是前生林处士，晚年不饮至今醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44493,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刘隐君山居","author":"赵师秀","text":"嫌在城中住，全家入翠微。\n开松通月过，接竹引泉归。\n虑淡头无白，诗清貌不肥。\n必无车马至，犹掩向岩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44494,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"多景楼晚望","author":"赵师秀","text":"落日栏干与雁平，往来疑有旧英灵。\n潮生海口微茫白，麦秀淮南迤逦青。\n远贾泊舟趋地利，老僧指瓮说州形。\n残风忽送吹营角，声引边愁不可听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44495,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安仁道中","author":"赵师秀","text":"行尽沿溪路，天寒岁又除。\n欲消冰似雪，初长麦如蔬。\n于世无成事，何时有定居。\n等缘贫所役，为仕愧为渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44496,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延禧观","author":"赵师秀","text":"寂寞古仙宫，松林常有风。\n鹤毛兼叶下，井气与云同。\n背日苔砖紫，多年粉壁红。\n相传陶县令，曾住此山中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舟行寄翁十","author":"赵师秀","text":"舟轻风色好，波面去迢迢。\n取尔诗重读，令吾病欲销。\n江禽停晚树，涧水入秋潮。\n已觉怀人极，分携始一朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访韩仲止不遇题涧上","author":"赵师秀","text":"隔涧竹扉深，苍童引客寻。\n虽然乖晤语，犹得见园林。\n野蔓时妨步，山蝉亦好吟。\n石根泉数斗，清冷应人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过弋阳","author":"赵师秀","text":"三月三番过弋阳，吾生辛苦莫思量。\n磨圆滩石几年浪，丹尽江枫昨夜霜。\n已算中途当度腊，更怜抵舍未为乡。\n高眠旧有山中约，只欠青骡道士方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"严州潇洒亭","author":"赵师秀","text":"高榭出禅关，人家向下看。\n千峰春隔雾，数里夜闻滩。\n偶至因成宿，前游亦值寒。\n州人多有咏，何不见方干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冷泉夜坐","author":"赵师秀","text":"众境碧沈沈，前峰月正临。\n楼钟晴听响，池水夜观深。\n清净非人世，虚空是佛心。\n却寻来处宿，风起古松林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈蒋薛二友","author":"赵师秀","text":"中夜清寒入缊袍，一杯山茗当香醪。\n鸟飞竹叶霜初下，人立梅花月正高。\n无欲自然心似水，有营何止事如毛。\n春来拟约萧闲伴，重上天台看海涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扶栏","author":"赵师秀","text":"强起扶栏立，新寒陡见侵。\n钟声诸寺晓，柳荫半池阴。\n病久方凭艾，贫深或梦金。\n湖边好风日，孤负几登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"抚栏","author":"赵师秀","text":"抚栏惊岁月，久住欲如何。\n水国花开早，春城人上多。\n病令诗懒作，闲喜客频过。\n听说边头事，时贤策在和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨柳塘寄徐照","author":"赵师秀","text":"因贫为远别，已是十三程。\n尽日行山色，逢人问地名。\n近书无便寄，新句与谁评。\n想尔寒宵雨，思予亦梦成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沈洞主","author":"赵师秀","text":"案上阴符卷，应逢骊母传。\n无言过永日，不食度终年。\n云覆烧丹灶，花浮洗药泉。\n时闻有玄虎，来礼洞门前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵山阁见二徐友旧题句","author":"赵师秀","text":"一面见溪水，三边皆翠微。\n晚来虚槛外，秋近白云飞。\n重至恰身老，同吟感客非。\n灵山自如画，依旧隔斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵岩","author":"赵师秀","text":"忽有千岩聚，禅宫得土悭。\n古来云是海，天下别无山。\n久立增寒思，初看损壮颜。\n曾闻斤石剥，夜落半空间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"进贤道中","author":"赵师秀","text":"半月逢梅雨，初晴客意消。\n莺声临野水，松影卧新苗。\n少憩休舆卒，闲行过板桥。\n平生无饮分，空愧酒旗招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈待制湖楼","author":"赵师秀","text":"何处飞来缥缈中，人间惟有画图同。\n两层帘幕垂无地，一片笙箫起半空。\n岩竹倒添秋水碧，渚莲平接夕阳红。\n游人未达蒙庄旨，虚倚栏干面面风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龟峰寺","author":"赵师秀","text":"石路入青莲，来游出偶然。\n峰高秋月射，岩裂野烟穿。\n萤冷粘棕上，僧闲坐井边。\n虚堂留一宿，宛似雁山眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"京华病后","author":"赵师秀","text":"久在京华损道心，故人谁与念升沈。\n春楼卧病燕相伴，湖寺题诗僧为吟。\n三月不逢家信至，一茎新有鬓丝侵。\n早知谏猎非时节，只在山中自养金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和人韵赠北山僧","author":"赵师秀","text":"又得相逢闲寺里，凡人多笑太无营。\n谁知见事心先懒，未说寻幽足已轻。\n二月春风添树色，一山夜雨失泉声。\n谢师更作重眠约，来往云消两日晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和朱子发韵兼简青龙诸友二首 其二","author":"赵师秀","text":"虽说京华住，西湖岂不清。\n病多妨野兴，贫甚损诗情。\n插柳观春意，粘碑隔市声。\n松江几閒客，日夕听波鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和朱子发韵兼简青龙诸友二首 其一","author":"赵师秀","text":"巷南与巷北，相去路无多。\n以我常孤坐，劳君数见过。\n望山嫌夕霭，听雨想春波。\n稍俟晴明日，相携一醉歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和鲍县尉","author":"赵师秀","text":"留僧秋阁上，身自伴僧闲。\n漱齿临寒水，焚香对远山。\n野禽偷果去，童子借经还。\n馀兴成诗句，高题屋柱间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉赋朱新父足庵","author":"赵师秀","text":"人欲难穷极，于中觉者稀。\n但令无过分，何处有危机。\n长日书千册，清风竹一围。\n东南坤势阙，子计不为非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"姑苏台作","author":"赵师秀","text":"何人可与话登临，徙倚危栏日又沈。\n千古苍茫青史梦，一年迢递故乡心。\n天无雨雪梅花早，地有波涛雁影深。\n为是夫差旧台榭，愁来不敢越人吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孤山寒食","author":"赵师秀","text":"二月芳菲在水边，旅人消困亦随缘。\n晴舒蝶翅初匀粉，雨压杨花未放绵。\n有句自题闲处壁，无钱难买贵时船。\n最怜隐者高眠地，日日春风是筦弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"官舍初成","author":"赵师秀","text":"为宅傍城墙，先求夏日凉。\n凿池容众水，栽竹断斜阳。\n官是三年满，身无一事忙。\n不知何补报，安坐恐难当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岩居僧","author":"赵师秀","text":"开扉在石层，尽日少人登。\n一鸟过寒木，数花摇翠藤。\n茗煎冰下水，香炷佛前灯。\n吾亦逃名者，何因似此僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"林逋墓下","author":"赵师秀","text":"梅花千树白，不是旧时村。\n倾我酤来酒，酹君仙去魂。\n短碑藤倚蔓，空冢竹行根。\n犹有归来鹤，清时欲与论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"信州草衣寺","author":"赵师秀","text":"芙蕖四五枝，寂寞在空池。\n难见草衣士，空看宴坐碑。\n香烟思盛日，诗句记游时。\n欲问台中鹤，长松自不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚即事","author":"赵师秀","text":"一身来作吏，白日算徒劳。\n尘土侵衣重，年光如鬓牢。\n春深禽语改，溪落岸沙高。\n柳下垂钓者，吾今愧尔曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳下书斋","author":"赵师秀","text":"转曲认幽栖，斋名壁上题。\n柳遮船步水，草出瓦沟泥。\n养静抛书册，销闲倚杖藜。\n谁知凤城外，宛是武陵溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日偶书","author":"赵师秀","text":"官事何曾晓，閒名苦要签。\n大书公吏恐，直语众人嫌。\n俸少贫如故，医慵病却添。\n秋风墙下菊，相对忆陶潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋色","author":"赵师秀","text":"幽人爱秋色，祇为属吟情。\n一片叶初落，数联诗已清。\n瘦便藤杖细，凉觉葛衣轻。\n门外萧萧径，今年菊自生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜偶书","author":"赵师秀","text":"此生谩与蠹鱼同，白发难收纸上功。\n辅嗣易行无汉学，玄晖诗变有唐风。\n夜长灯烬挑频落，秋老虫声听不穷。\n多少故人天禄贵，犹将寂寞叹扬雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋屏作","author":"赵师秀","text":"凡有栏干处，秋来遍往还。\n就中惟此地，全得见西山。\n雁落遥沙小，人登废垒闲。\n因怜一州景，皆在夕阳间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贵溪夜泊寄赵昌甫","author":"赵师秀","text":"蓍草占秋动，逢秋早得归。\n本非为事迫，不欲与心违。\n波净孤萤度，宵凉数叶飞。\n远怀高卧者，微月闭松扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送邓汉卿","author":"赵师秀","text":"我亦将归者，先行极羡君。\n惟因交已久，颇觉意难分。\n江满帆侵树，山高烧入云。\n他年有书札，彼此访耕耘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送古壶与人","author":"赵师秀","text":"小壶纯素无文采，验是殷商物至今。\n损处怕教凡手触，铸时应有吉星临。\n久藏厚土金声尽，微贮清泉翠色深。\n持赠高人安几席，为勾古意入新吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送汤千","author":"赵师秀","text":"能文兼悟性，前是惠休身。\n为选来京邑，因吟访野人。\n所居才隔水，不见忽经旬。\n何事云归速，儒官拜敕新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送汤主簿","author":"赵师秀","text":"扶起阶前菊，秋霖苦未休。\n更逢千里别，早白一年头。\n客借程文看，儿分赐服收。\n还家有新兴，佳句入书邮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送沈庄可","author":"赵师秀","text":"清事贫人占，斯言恐是虚。\n与花方作谱，为米又持书。\n时节寒相近，山林拙未除。\n西江波浪急，送子一愁予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送周端常之建康","author":"赵师秀","text":"高名闻已久，方策有文雕。\n接得诗人信，知从谏议招。\n住遥劳枉刺，去速恨移桡。\n何处逢黄菊，秋风故六朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵判官","author":"赵师秀","text":"三岁莲华幕，何曾仕者同。\n开墙通野客，分树借江鸿。\n与世如无味，于民自有功。\n神仙今已近，不畏引帆风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送倪道士之庐山","author":"赵师秀","text":"近方辞地肺，本自住天台。\n有鹤相同出，无云作伴回。\n道房随处借，诗板逐时开。\n又说庐山去，闲看瀑布来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐玑赴永州掾","author":"赵师秀","text":"二水鸿飞外，君今问去程。\n家贫难择宦，身远易成名。\n入署梅花落，过汀蕙草生。\n莫因饶楚思，词体失和平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送徐道晖游湘水","author":"赵师秀","text":"春尽雨霏霏，春寒犹在衣。\n人寻香草去，雁背远峰归。\n潇水添湘阔，唐碑入宋稀。\n应知名与姓，题写遍岩扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送真直院出使江东","author":"赵师秀","text":"一节铸黄金，翩然别禁林。\n几于言事日，已作去朝心。\n有识愁虽结，无惭喜自深。\n江边瞻使者，谁不敬曾参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送翁卷入山","author":"赵师秀","text":"已送山民归旧庐，子今复去我何如。\n渐成老大难为别，早占清闲未是疏。\n小雨半畦春种药，寒灯一盏夜修书。\n有人来问陶贞白，说与华阳何处居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送黄叔向谒杨伯子","author":"赵师秀","text":"尝闻事将坛，何得复儒冠。\n口诵新诗句，身呈旧箭瘢。\n赏因贫未受，愁拟醉相宽。\n当伏湖州牧，应怜志士寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送蒋节推赴岳阳","author":"赵师秀","text":"君山那可上，四面是层波。\n此地风烟古，前人赋咏多。\n征帆冲雁字，官舍近渔歌。\n况尔修真者，回仙必见过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送谢耘之无为","author":"赵师秀","text":"双旌虽有旧，道路亦劳形。\n不用携书尺，惟当带酒瓶。\n柘空淮茧白，梅近楚秧青。\n尔以亲为请，仁人岂厌听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送辉上人再住空相","author":"赵师秀","text":"忽然闻受请，铁锡指秋风。\n寺在寒城里，州居野水中。\n生缘抛未尽，旧讲续应终。\n不用相寻别，浮云去住同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送奭上人抄化","author":"赵师秀","text":"冒寒独向何方去，为建灵山阁未能。\n诗卷带呈看疏客，药炉留借共房僧。\n夕阳岸上行枯叶，瀑布岩前听拆冰。\n事到有缘随处应，回来金碧入云层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送潘景参赴利路帐干","author":"赵师秀","text":"蜀道如天远，携家难计程。\n不从三峡过，免听几猿声。\n戍密野花少，栈虚山雨鸣。\n同年同寂寞，此去子成名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送薛子舒赴华亭船官","author":"赵师秀","text":"竹笼盛书去，遥知官事闲。\n水程春有雨，海岸晓无山。\n奥理渐摩后，清名护养间。\n坐曹观剡木，意与易相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"借居湖上","author":"赵师秀","text":"出仕归来贫似旧，借园偶近画桥居。\n纵观不用春携酒，清坐何妨夜读书。\n港小只通闲客棹，树低多碍故人车。\n向时城里缘尘土，久欲湖边住岁馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徐灵晖挽词","author":"赵师秀","text":"在生贫不害，早丧可嗟吁。\n天下黄金有，人间好句无。\n魂应湘水去，名与浪仙俱。\n平日惟耽茗，坟前种几株。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徐侍郎挽词","author":"赵师秀","text":"少赞经纶业，周家已卜年。\n谤兴无白日，心在有青天。\n迁谪还迎母，艰危复用贤。\n未令吾道泰，星殒灌城边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"徐孺子宅","author":"赵师秀","text":"今识高眠处，沧波是切邻。\n已知难即鹿，惟有独潜鳞。\n草长过荷叶，藤深失树身。\n闲思昔微子，犹自得称仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"栗禁","author":"赵师秀","text":"宵长非一梦，欲记已迷茫。\n照镜枯于腊，梳头落似霜。\n病疴如退愈，贫屡又商量。\n所嗜惟崖栗，今年不敢尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃花寺","author":"赵师秀","text":"旧有桃花树，人呼寺故云。\n石幽秋鹭上，滩远夜僧闻。\n汲井连黄叶，登台散白云。\n烧丹勾漏令，无处不逢君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桐柏观","author":"赵师秀","text":"山深地忽平，缥缈见殊庭。\n瀑近春风湿，松多晓日青。\n石坛遗鹳羽，粉壁剥龙形。\n道士玉灵宝，轻强满百龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"润陂山上作","author":"赵师秀","text":"一山大半皆槠叶，绝顶閒寻得径微。\n无日谩劳携纸扇，有风犹怯去绵衣。\n野花可爱移难活，啼鸟多情望即飞。\n惟与寺僧居渐熟，煮茶深院待人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"病起","author":"赵师秀","text":"身如瘦鹤已伶俜，一卧兼旬更有零。\n朝客偶知亲送药，野僧相保密持经。\n力微尚觉衣裳重，才退难徼笔砚灵。\n惟有爱花心未已，遍分黄菊插空瓶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]