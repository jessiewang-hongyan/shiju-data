[{"title":"送谢耕道谒赵史君","author":"张弋","text":"槠叶阴深杜宇啼，远游还欲过淮西。\n吕蒙城下河流浊，亚父祠边草色齐。\n太守旧来相爱重，故交老去惜分携。\n年年慈母手中线，缝得征衫当一犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送蔡监丞赴高邮","author":"张弋","text":"城古似盘盂，荣分刺史符。\n夏新看藕叶，夜久见蠙珠。\n吏过朱方接，山从邵伯无。\n文游遗迹在，民俗易相孚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日从陈宗之借书偶成","author":"张弋","text":"自从春去后，少省出柴扉。\n树暗鸦巢隐，檐空燕迹稀。\n忆山怜有梦，当暑咏无衣。\n案上书堆满，多应借得归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"逢王元任","author":"张弋","text":"寂寞淮南道，凭君独记余。\n始知元住此，久悔不通书。\n暮岳留同眺，寒房与借居。\n共怀京邑燕，已是二年馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高邮送紫芝","author":"张弋","text":"重逢又重别，把盏更凄然。\n明日帆开岸，平湖水接天。\n好诗应自作，狂梦与谁圆。\n我欲来相趁，扬州且住船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄别颜伯奇","author":"张弋","text":"情深袂怕分，岂不欲辞君。\n转柁方乘晓，思山已隔云。\n菊当前路见，雁在半江闻。\n把盏秋才好，遥怜白鹭群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄苏希亮","author":"张弋","text":"因何也识闲名字，遂托交游索近诗。\n想像独吟应更苦，分明此意似相知。\n空林日短归鸦早，远水寒多雁到迟。\n安得你来同度岁，传闻画笔最清奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄秋塘","author":"张弋","text":"五湖风雪分头去，千里淮山信脚行。\n涉世真成妄男子，谈诗长忆老先生。\n塘边瓜茹须频灌，郭外田畴粗可耕。\n莫倚瘦筇吟白发，浪传诗句入都城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄赵紫芝","author":"张弋","text":"独游非一事，书札故应迟。\n江上逢春月，湖边忆醉时。\n有云为我伴，终日诵君诗。\n百鸟鸣花树，声声在远思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得山中友人书","author":"张弋","text":"近得山中信，山中颇寂寥。\n酒方收秫酿，薪旋割茅烧。\n破屋秋多雨，平湖暗有潮。\n不曾逢客至，默坐过清宵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"移菊","author":"张弋","text":"秋风篱落远，晨起自移栽。\n稍觉微根损，须迟数日开。\n最清人爱重，乍见蝶疑猜。\n昔有陶元亮，因兹归去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"彭蠡阻风寄城中故人","author":"张弋","text":"欲行行未得，累日滞孤舟。\n月照山皆近，风吹水倒流。\n地名人不识，秋景客相愁。\n忆你惟成梦，遥知独倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游长干留寄聪公","author":"张弋","text":"僧去寻芳草，客来看落花。\n就斋槃乞菜，借水鼎煎茶。\n日炙春无色，风吹天有沙。\n欲回成再住，此意问林鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游禅林寺","author":"张弋","text":"寺置萧梁曾识少，今朝藓磴始经过。\n天低落日江湖远，烟冷风清竹树多。\n虫引翠禽行坏屋，马惊白犬吠悬萝。\n一僧九十形容古，岩下逢予忽浩歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游蒋山","author":"张弋","text":"綀布作方袍，因闲偶出遨。\n秋风城郭净，寒色树林高。\n鹿守禅关老，僧修佛殿劳。\n再来思久住，人世事如毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"慈母矶","author":"张弋","text":"莫嫌舟逆上，子细得看山。\n众草名难识，孤花影自闲。\n避人鹰翅响，经雨石文斑。\n夜久江风冷，神仙定往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简周宗圣","author":"张弋","text":"旷野有芳芷，近江无早莺。\n春诗定多少，旬日又清明。\n树暗怜杨柳，花开认橘橙。\n相寻每乖阻，梦里亦愁生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莫春","author":"张弋","text":"日日雨霏霏，闭门无所知。\n谩寻花发处，已过絮飞时。\n替纸蚕生遍，修巢燕立危。\n但催人老去，羞作送春诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"豫章别紫芝","author":"张弋","text":"吟苦事俱废，拙深贫未除。\n年来如旅雁，秋至即移居。\n古道行黄叶，空囊贮素书。\n一生江海恨，惟子最知余。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠沈庄可","author":"张弋","text":"卷上芳名旧所知，见君还恨识君迟。\n数茎短发沾霜白，一叶扁舟触浪危。\n问遍菊名因作谱，画将兰本要求诗。\n向南郡邑多经过，楚士能狂更有谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留滞","author":"张弋","text":"萧条十日馀，留滞别人居。\n借吏抄陈作，黏碑学草书。\n烟清数村晓，月落一潭虚。\n吾自疑秋色，那堪树木疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中花慢","author":"张才翁","text":"万缕青青，初眠官柳，向人犹未成阴。\n据雕鞍马上，拥鼻微吟。\n远宦情怀谁问，空嗟壮志销沈。\n正好花时节，山城留滞、忍负归心。\n别离万里，飘蓬无定，谁念会合难凭。\n相聚里，休辞金盏，酒浅还深。\n欲把春愁抖擞，春愁转更难禁。\n乱山高处，凭阑垂袖，聊寄登临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灯花联句","author":"白玉蟾","text":"青灯知有喜，花发满堂红。\n宝饼攒金蚁，琼钗缀玉虫。\n根非滋夜雨，蕊不绽春风。\n照破乾坤事，能攘日月功。\n燄凝中夜露，烬落五更钟。\n蟾桂光无比，冰花巧不同。\n无香开瑞瓣，有燄似珍丛。\n鹊噪欢娱定，蛛丝信息通。\n今宵真有感，好事喜相逢。\n不假金乌照，应非玉斧工。\n草虫空乱树，野燐谩枮蓬。\n蛾至浑疑蝶，蛟飞不是蜂。\n酒亲思杜老，诗咏忆韩公。\n不昧本来者，孤光曜太空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长桥 其二","author":"张亢","text":"万顷平湖水接天，湖光水色远相连。\n虹蜺截雨未归得，横在波心几十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长桥 其一","author":"张亢","text":"云收雾霁水风高，百丈虹桥气势豪。\n疑是玉龙藏爪距，潜来江上看波涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长桥 其三","author":"张亢","text":"记得当年过此桥，月明江上暑风消。\n而今重到经行处，空有湖光伴寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"王琪","text":"张亢触墙成八字。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张介","text":"应是子规啼不到，致令我父未归家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪","author":"张元","text":"五丁仗剑决云霓，直取银河下帝畿。\n战死玉龙三十万，败鳞风捲满天飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"张元","text":"夏竦何曾耸，韩琦未是奇。\n满川龙虎举，犹自说兵机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"张元","text":"有心待搦月中兔，更向白云头上飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"张元","text":"好著金笼收拾取，莫教飞去别人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上平江陈侍郎十绝 其三","author":"张元干","text":"前贤一节皆名世，此道终身公独行。\n每见遗编须掩泣，晚生期不负先生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上平江陈侍郎十绝 其九","author":"张元干","text":"先生许可能尊祖，词采今存干蛊身。\n碑版灿然垂世誉，要知忠肃有门人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上平江陈侍郎十绝 其五","author":"张元干","text":"酒酣怒发上冲冠，四十年前庐阜南。\n杖履周旋痛开警，为言小子颇尝参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上平江陈侍郎十绝 其六","author":"张元干","text":"英灵精爽平生话，尚记先生苜蓿槃。\n仙去星辰终不灭，至今梦想骨毛寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上平江陈侍郎十绝 其七","author":"张元干","text":"功名啐啄与时同，譬似青天白日中。\n不觉片云随雨雹，适从何处运神通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上平江陈侍郎十绝 其二","author":"张元干","text":"灼见祸机宁有死，剖心立敌肯忘言。\n向来逆料无遗恨，彻底孤忠抱至冤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上平江陈侍郎十绝 其四","author":"张元干","text":"南荒百谪愈不屈，便道忽闻天遣来。\n峨帽焚香姑拱立，果无片楮可成灾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上平江陈侍郎十绝 其十","author":"张元干","text":"伤心顷拜公床下，一气飘零馀几人。\n七十衰翁谁信及，话言端欲广书绅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"甲戌正月十四日书所见来日惊蛰节","author":"张元干","text":"老去何堪节物催，放灯中夜忽奔雷。\n一声大震龙蛇起，蚯蚓虾蟆也出来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕公像 其一","author":"张元干","text":"巾裹唐装本布衣，平生唯识一钟离。\n此中养得婴儿就，世上行尸有许悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕公像 其二","author":"张元干","text":"秋空一剑岳阳楼，醉里乾坤日夜浮。\n五百年间兴废事，不知谁是赤松游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵奉送李季言四首 其四","author":"张元干","text":"我辈避谗过避贼，此行能饱即须归。\n山川久有真消息，世上从渠闲是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵奉送李季言四首 其三","author":"张元干","text":"几年脱迹冠冕窟，一味偷生兵火中。\n不见君家好兄弟，何人怜我最奇穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵奉送李季言四首 其二","author":"张元干","text":"藩镇各传新号令，山河那复旧提封。\n归时剩语骑鲸老，坚卧无如涧底松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵奉送李季言四首 其一","author":"张元干","text":"向来敌帅窥吴越，稳泛楼船舍骑兵。\n开辟所无颠倒事，可能今日独横行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江梅","author":"张元干","text":"密雪飞花万木僵，南枝的皪待朝阳。\n还知百果输先手，政为孤根压众芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伽陀二首送了可首座归四明 其二","author":"张元干","text":"问讯天童今老子，偶同庚甲事如何。\n他时要向山中去，容我一庵遮薜萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔次廷藻韵二绝 其二","author":"张元干","text":"小苏一物绝风流，竹杖芒鞋爱讨幽。\n招隐归来吐佳句，何时一笑共重游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"走笔次廷藻韵二绝 其一","author":"张元干","text":"风雨声中过半春，泥深郊水阻游人。\n老夫不出浑闲事，但觉年来白发新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"麦秋亭","author":"张元干","text":"东坡喜雨事如此，吾舅名亭思不群。\n不问两歧何许秀，且看十顷卷黄云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏二疏","author":"张元干","text":"两傅常存好老心，汉廷元自少知音。\n归来日日相娱乐，赖有君王旧赐金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉祠后作","author":"张阐","text":"八请犯天颜，今朝出汉关。\n浑如倦飞鸟，日暮傍巢还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岷山万松图","author":"张元干","text":"叠嶂连娟入翠微，乔松蔽日有孙枝。\n江流不尽松声远，云栈行人力困时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范才元道中杂兴 其一","author":"张元干","text":"遐想吴门人姓梅，高踪千古共徘徊。\n橘中傥有商山乐，不必胡僧问劫灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范才元道中杂兴 其二","author":"张元干","text":"山晚江寒春雨疏，比来消息定何如。\n竹舆行倦异乡县，赖得金楼引睡书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范才元道中杂兴 其四","author":"张元干","text":"君家鼻祖大范老，气压贺兰威凤鸣。\n文采风流今未泯，耳孙胸次似冰清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范才元道中杂兴 其三","author":"张元干","text":"底处烟林飞伯劳，春生诗思剩摇毫。\n归来准拟扶头醉，日射花梢三丈高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"范才元道中杂兴 其五","author":"张元干","text":"名姓未能随老变，政须卜宅近前峰。\n看君决策上封事，揽取奇勋铭鼎钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祖颖漕使希道使君以绝句相酬答聊成二章解嘲并发一笑 其二","author":"张元干","text":"薰炉玉煖云生岫，晓鉴鸾窥翠扫空。\n未许尊前听金缕，两公新句漫争雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祖颖漕使希道使君以绝句相酬答聊成二章解嘲并发一笑 其一","author":"张元干","text":"从渠冷蕊篱边少，未放浮蛆瓮面空。\n高烛几时催夜饮，隔帘度曲也英雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"圆通秀禅师送逊公首座赴明水请","author":"张元干","text":"卷衲和云离五老，派分三峡济临川。\n兴波作浪从风鼓，莫学世流空度缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂井","author":"张元干","text":"移根一户蟾光溢，分派银河地脉灵。\n定与苏仙双橘井，他年续入郦元经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起枕上口占三绝句奉呈公实峤之贤伯仲一笑 其二","author":"张元干","text":"素馨茉莉及玫瑰，清馥浑同雪里梅。\n六入不分初病起，眼前欠此共徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起枕上口占三绝句奉呈公实峤之贤伯仲一笑 其三","author":"张元干","text":"海外绿洋来万里，齐驱黎母鹧鸪斑。\n肯分种种箧中富，不用公家金博山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病起枕上口占三绝句奉呈公实峤之贤伯仲一笑 其一","author":"张元干","text":"天上宝囊无尽藏，向来密赐被先王。\n自怜门下老宾客，燕寝饱曾闻妙香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高尚居士 其一","author":"张元干","text":"卜室高垣桑柘边，空中来往尽飞仙。\n似闻一举三千里，更待成功上九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高尚居士 其二","author":"张元干","text":"往在澶渊过我家，自怜凡骨走天涯。\n丹青始识先生面，点化何时一粒砂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题悠然阁三绝句 其三","author":"张元干","text":"谁标此阁作悠然，万事无非信手拈。\n参得东篱把菊意，不妨老远引陶潜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题悠然阁三绝句 其二","author":"张元干","text":"登临巧处属僧家，随分生涯度岁华。\n莫待藤萝满山月，时来倚杖数昏鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题悠然阁三绝句 其一","author":"张元干","text":"林端结阁小跻攀，四面岚光绕曲栏。\n佛法本来南北异，个中北望见南山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菊","author":"张元干","text":"秋风著意菊丛黄，不怕东篱五夜霜。\n曾记南阳饮潭水，要令道骨合仙方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游庐山","author":"张元干","text":"古木寒藤挽我住，身非靖节谁能留。\n多惭不及鸾溪水，长向山前山后流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]