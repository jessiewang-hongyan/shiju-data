[{"title":"呈万庵十章 其六 温养","author":"白玉蟾","text":"金翁姹女结亲姻，洞口桃花日日春。\n拾得一轮天上月，炼成万劫屋中珍。\n黄婆即是母之母，赤子乃其身外身。\n龙汉元年消息断，威音前面更何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25829,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈沈同知","author":"白玉蟾","text":"三面俱江一面湖，古今画作水晶图。\n门临车马红尘道，身在冰霜碧玉壶。\n何道两山俱翠紫，霅苕二水合清污。\n岸头笑与黄冠语，为问东林沈在乎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25830,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张子衍为至德知观鄢冲真求诗","author":"白玉蟾","text":"一簇楼台水上居，琅风韵竹动笙竽。\n鱼龙飞舞半帆雨，鸥鹭眠呼两岸芦。\n雪覆高低春玉树，月明表里夜冰壶。\n渔郎倚棹桃花落，认得扶桑宫殿无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25831,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张进甫静寮","author":"白玉蟾","text":"脱俗卧云眠，胸中别有天。\n壁间五六榻，屋上两三椽。\n风月真滋味，溪山旧面缘。\n静中有真静，猿啸暮林边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25832,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"张道士鹿堂","author":"白玉蟾","text":"清梦绕罗浮，羽衣延我游。\n新茶寻雀舌，独芋煮鸱头。\n春鹤饮药院，夜猿啼石楼。\n丹炉犹暖在，聊为稚川留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25833,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"快轩书怀","author":"白玉蟾","text":"满树牡丹相次红，客来不放酒杯空。\n三分春色二分去，一处风光是处同。\n柳絮打残连夜雨，桃花飞落五更风。\n与君饮到如泥烂，我欲明朝杖屦东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25834,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"步虚四章 其一","author":"白玉蟾","text":"昔在神霄府，飞云步玉天。\n玉天三十六，六梵聚飞仙。\n太帝升烟殿，东皇驾凤軿。\n真灵来亿万，听演太灵篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25835,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泛舟松江","author":"白玉蟾","text":"白酒黄封冽以妍，鲈鱼买得一双鲜。\n舟行无浪无风夜，人在非晴非雨天。\n醉熟不知天远近，梦回但见月婵娟。\n垂虹亭下星如织，云满长洲草满川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25836,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泛舟黄桥归庐山","author":"白玉蟾","text":"清风为我送归船，数粒青松起薄烟。\n帆影惊飞秋水雁，橹声搅断夕阳蝉。\n几人家在溪头岸，一片云生水底天。\n满眼良朋无好酒，此心已挂九江边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25837,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"卧病","author":"白玉蟾","text":"故故抽身入翠微，头昏背痛便相随。\n只今得病缘身有，待我无身更病谁。\n天际寒云糊远岫，松梢归鹤客枯枝。\n青灯独照黄昏影，且自扶头强赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25838,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和主簿家兄赠别韵","author":"白玉蟾","text":"接耳交肩话绮疏，扶摇九万此南图。\n对床风雨人皆有，协韵埙篪我独无。\n偶尔诗家鸿雁行，为今酒岛鹡鸰徒。\n情知一舸鸱夷去，临欲出门灯影孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25839,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和张紫微韵题清虚庵","author":"白玉蟾","text":"鸡犬声村市，烟霞古洞天。\n晨坛凝玉露，夜井浸珠躔。\n凤翼团宸画，龟趺负古镌。\n于湖诗去后，今昔几千篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25840,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜宿太清悟真成道宫","author":"白玉蟾","text":"朱楼紫殿贴晴空，前后千峰更万峰。\n蝶殢秋花黄淡伫，猿啼晓树翠溟濛。\n断霞烟重苔粘露，薄暮云兴夜起风。\n醉倚玉栏弄明月，嗟嗟身世等萍蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25841,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉呈天谷","author":"白玉蟾","text":"底事英人便养高，角鹰放了弃弓刀。\n六壬八遁成韬晦，四塞三边娄绎骚。\n九十日秋凉气少，一千年事乱时多。\n长歌大笑不对饮，奈此水光山色何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25842,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉酬陈宫教","author":"白玉蟾","text":"落魄逍遥一醉仙，笑携藜杖夕阳边。\n三年睡法应须得，九蕴仙方妙不传。\n骤雨猛催今日作，老苔为锁异时镌。\n偶来水绿红花野，自与庐山亦有缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25843,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"怡斋","author":"白玉蟾","text":"逸士幽居松竹林，小堂偃枕北山阴。\n夜深冷月寒蓬户，晓起清风爽楮衾。\n把剑更餐杯内酒，收书动破壁头琴。\n自从一见羲皇面，千古谁知养浩心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25844,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武昌怀古十咏 其七 江汉亭","author":"白玉蟾","text":"西风黄叶满秋城，水鸟飞无沙碛腥。\n淮浪白如头似白，沔山青与眼俱青。\n何人得见莲花女，此地空馀江汉亭。\n一自郑生双佩断，幽情渺在蓼花汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25845,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武昌怀古十咏 其九 西塞","author":"白玉蟾","text":"落尽桃花水满湖，西山西塞长新蒲。\n斜风细雨今如许，青笠绿蓑谁又无。\n圣主龙飞邦有道，醉仙睡到日高梧。\n何时尧舜无巢许，我也人乎粘壁枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25846,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武昌怀古十咏 其四 吴王宫","author":"白玉蟾","text":"不将胆命付周郎，安得儿孙见太康。\n三国兴亡成梦事，一川烟草断人肠。\n黄旗紫盖伊巴蜀，翠殿朱楼自武昌。\n纵谓西山非王气，金陵能得几时王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25847,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武昌怀古十咏 其五 灵竹寺","author":"白玉蟾","text":"孝之一字协天伦，信可通天感鬼神。\n霜满竹林安得笋，心倾泪雨自生春。\n祇闻郭巨曾埋子，岂得曾参亦杀人。\n凿隧及泉愚尔耳，斯人盍是舜之臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25848,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武昌怀古十咏 其三 赤壁","author":"白玉蟾","text":"不说江山笑老权，尽称造化戏曹瞒。\n飞乌绕树孤回首，断戟沉沙怒激湍。\n豪杰已随霜叶尽，兴亡尽付浪花翻。\n画堂莫唱坡仙赋，战骨草中吟夜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25849,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武昌怀古十咏 其六 奇章台","author":"白玉蟾","text":"登台日费万缗钱，宾从如云剑履骈。\n食鼎歌钟移楚地，貂金佩玉整唐天。\n缅怀?钺熊旂里，尚有冰辞雹语传。\n偃月堂中人用事，牛家僧孺得称贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25850,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武昌怀古十咏 其十 南浦","author":"白玉蟾","text":"越禽胡马易空疏，水远天长梦亦迂。\n南北故人鸿去外，古今陈迹雨晴初。\n云连碧草别愁黯，风眇绿波征骑孤。\n三径凄凉一杯酒，夜深重读寄来书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武昌怀古十咏 其一 南楼","author":"白玉蟾","text":"凭暖朱栏醉已酥，楼前眼缬望中疏。\n汉阳草树看来短，淮岸渔家淡欲无。\n薄暮鸦翻千点墨，晴空雁草数行书。\n多情庾亮吟魂远，风泛芦花秋满湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武昌怀古十咏 其二 黄鹤楼","author":"白玉蟾","text":"白云黄鹤迹成遗，何独当年丁令威。\n洞里不知朝市改，人间再到子孙非。\n笛声吹断秋江黯，月影飞来夜漏稀。\n大醉倚楼呼费?，蓬莱山下几斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武昌怀古十咏 其八 鹦鹉洲","author":"白玉蟾","text":"无人为叫祢平原，表祖粗人岂识文。\n鹤在鸡群怀月露，豹将虎变欠风云。\n凤凰池上才方酒，鹦鹉洲边已自坟。\n道大不容才见忌，渔阳挝断不堪闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊头圆照堂","author":"白玉蟾","text":"脱白来求法，披缁去出家。\n此心如水月，结屋老烟霞。\n翠长真如竹，黄开般若花。\n寄言刘铁磨，自识赵州茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"知足轩","author":"白玉蟾","text":"得陇还为望蜀谋，贪心来往似江潮。\n谁知一死乃所欠，若曰四休渠不消。\n田氏三千人食客，元家八百斛胡椒。\n更烹侍妾充殽馔，何事贫颜但一瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罗适轩净明轩","author":"白玉蟾","text":"占断人生百岁閒，绛宫有路透玄关。\n明如雪夜潭心月，静似春天雨后山。\n万籁无声人不寐，一尘何处夜将阑。\n琴心三叠倚楼坐，黄鹤悠悠去不还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罗浮歌朝斗回作","author":"白玉蟾","text":"紫霄飞步谒琼楼，回首人间祇一周。\n云绕昆崙山上起，月沉娑竭水中浮。\n香烟欲断归来早，羽驾相迎未敢留。\n尽洗尘缘知熟路，瑶池花木未应秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"述怀","author":"白玉蟾","text":"吊影自怜孤，消愁得酒壶。\n客悰迷晓夜，梦事付江湖。\n雨壁琴弦润，风窗砚水枯。\n晚蝉知此意，为我噪高梧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"述翠虚真人安乐法","author":"白玉蟾","text":"收敛神光少默然，顶门一路聚云烟。\n且升阳火烹金鼎，却降灵泉灌玉田。\n交结只于牛渚外，分明正在鹊桥边。\n功夫九九数六六，此是人间安乐仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"降真室","author":"白玉蟾","text":"琼钟发响綵幡飞，窗外青乌半夜啼。\n松竹无言争地静，星辰可摘觉天低。\n黄云屋角腾金辇，素月檐头放玉梯。\n稽首紫皇初宴罢，步虚声断乞刀圭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中题旅馆","author":"白玉蟾","text":"风搅长空秋雨悬，路如苔滑懒摇鞭。\n入门指仆买杯酒，磨墨倚窗吟一篇。\n黄竹绕檐黄蚁战，白芦映水白鸥眠。\n一声长啸便归去，回首孤村空暮烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"俞楼","author":"白玉蟾","text":"十二栏杆秋月明，谪仙曾此宴飞琼。\n半窗树色粘山色，隔岸风声送水声。\n织翠回纹伤薄倖，香红染袖怅都城。\n酒愁花恨无人诉，赖有延年俞秀英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"复卢良庵韵","author":"白玉蟾","text":"拟占朝班最上头，宦情冷似一天秋。\n风花雪月千金子，水竹云山万户侯。\n海客盟鸥终不动，塞翁失马更何求。\n明窗净几华胥外，蝴蝶翩翩自梦周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"契妙","author":"白玉蟾","text":"契妙堂中静养神，神凝气聚一壶春。\n青山绿水无非道，翠竹黄花有几人。\n世外不知千百世，身中还更两三身。\n一从契得虚无妙，明月清风是我邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡山寺","author":"白玉蟾","text":"重楼复屋枕层崖，想有残碑锁翠苔。\n但见苍山如壁立，不知绿水自何来。\n岩花满眼红而紫，谷鸟呼名去复回。\n便欲买舟从此隐，岂惟一处子陵台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峡中见芙蓉","author":"白玉蟾","text":"峡畔寻常有虎踪，峡中闻说有蛟龙。\n心知峭壁生如剑，目送清波去似弓。\n绕树尽皆青薜荔，举头忽见白芙蓉。\n西风为我吹残酒，最喜千峰翠色浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"思微堂","author":"白玉蟾","text":"思微堂里自冲虚，高士闲居兴味殊。\n月冷花开数朵静，风清鸟过一声孤。\n谁知心上工夫妙，欲觅人间俗累无。\n九转内丹成也未，快骑白鹤去天衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日即事","author":"白玉蟾","text":"伶伦窥管夜飞灰，万紫千红暗剪裁。\n微雨绩天烟织雪，寒风簸水月筛梅。\n寿鸠索妇花前笑，鳏燕呼雏柳外哀。\n春色无边茶未荚，社前犹欠一声雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日饮酒","author":"白玉蟾","text":"拍拍浮浮几酒樽，梅花入梦酒归魂。\n半窗寂寞猿三咽，满户萧骚月一痕。\n山后山前鸠唤妇，舍南舍北竹生孙。\n天明醉醒策霜竹，春在江天芦荻村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日道中","author":"白玉蟾","text":"洞口鸟呼鸟，山头花戴花。\n风篁苍韵玉，烟树晚笼纱。\n怀白一樽酒，邀卢七椀茶。\n春光索弹压，万象晓排衙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日遣兴","author":"白玉蟾","text":"大家放下杖头云，夜宿南安烟水村。\n蝴蝶梦残天拂晓，杜鹃声断月黄昏。\n蜂王遣使使花坞，蚁阵分屯屯荜门。\n自是吾侬适怀处，诗山酒海一乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春梦","author":"白玉蟾","text":"我亦频年饮大苛，吟髭撚尽为诗魔。\n夜来斗转参横后，梦在吴头楚尾多。\n所喜江山无病痛，可怜故旧半消磨。\n水车自转如谁踏，枕上松声奈若何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳花","author":"白玉蟾","text":"闲傍珠帘散漫初，垂垂欲下得风扶。\n绣床渐满圆还碎，醉目遥看有似无。\n只见鱼吞池面水，不知萍满岸头湖。\n往来无数香毬子，粘缀春衣自不须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳塘送春","author":"白玉蟾","text":"急雨将雷过柳塘，春因底事亦归忙。\n经时不放荷花叶，昨夜尽收栀子香。\n判断千林成梦去，安排一夏纳风凉。\n开眉无觅愁来处，数笔晴云尽水乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夏之交奉呈胡总领","author":"白玉蟾","text":"残红点点尚春光，小立芳台送夕阳。\n莺语只闻花里面，鸥飞宛在水中央。\n风前绿草无人管，烟外青山底处藏。\n柳幄张天槐幕静，一川涨起麦云黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞庭","author":"白玉蟾","text":"帆腹膨脝饱北风，一弹指顷万山空。\n天垂九马层云外，人在孤鸿过影中。\n夙世曾游银世界，飞精复谒水精宫。\n湖神波吏须相识，吾在神霄旧有功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日有怀","author":"白玉蟾","text":"一点秋光寄画图，秋来吟鬓似枫疏。\n晴烟染树看何足，缺月梳云状不如。\n暑退凉生蝉有语，水长天远雁无书。\n此心直欲鹏南举，不学蜘蛛结网居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜","author":"白玉蟾","text":"有客眠孤馆，更阑拥纸衾。\n清风千里梦，明月一声砧。\n素壁秋灯暗，红炉火夜深。\n寒猿啼岭外，惹起故乡心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胡子嬴庵中偶题","author":"白玉蟾","text":"道人惯吃胡麻饭，来到人间今几年。\n白玉楼前空夜月，黄金殿上起春烟。\n闲倾一盏中黄酒，闷扫千章内景篇。\n昨夜钟离传好语，教吾且作地行仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"草庐","author":"白玉蟾","text":"刘禅材非天下君，出师一表费殷勤。\n卧龙梦破隆中月，列雁轰开蜀口云。\n甫得江心成八阵，奈何天意要三分。\n木牛流马今何用，赖有玄仍继策勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"草亭偶书","author":"白玉蟾","text":"赋罢清都白玉楼，不知何事复阎浮。\n琴弹十二栏杆月，酒洗三千世界秋。\n绛阙瑶台知有路，空青水碧若为求。\n紫皇早晚怜孤愤，背土凌虚上去休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王待制自温州移镇三山","author":"白玉蟾","text":"春暖涂歌里咏喧，鹑衣百结过苏天。\n九重亲擢公为此，百姓皆云我自然。\n五马重来寻墨沼，一麾又去镇闽川。\n庙堂相位犹虚左，已筑沙堤在日边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送江子恭 其三","author":"白玉蟾","text":"子到铅山我信州，笋舆轧轧又归休。\n数程细雨斜风路，一片落花啼鸟愁。\n何必便为阮籍哭，不来相伴赤松游。\n他年我到蓬莱去，一粒金丹汝去不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送江子恭 其二","author":"白玉蟾","text":"春来行尽烂田畦，云满春空水满溪。\n风漾碧波翻麦垄，日晴红雨落桃蹊。\n杜鹃声断惊寒兔，蝴蝶梦残听晓鸡。\n人在江东寄归信，海棠花谢燕衔泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送江子恭 其一","author":"白玉蟾","text":"我欲杨村结草庐，不知踪迹又江湖。\n回观咫尺如天远，自别丰标仅月馀。\n忽一二时思故旧，整千百里望音书。\n忆君不忍忘怀处，一片青云点太虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送张大师","author":"白玉蟾","text":"自从汝离武夷来，险阻艰难历几回。\n江左旅中连值雨，春深路上滑成苔。\n鸟啼花片落流水，风惨猿声啸古台。\n举眼四山如壁立，教君归去也心灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送春","author":"白玉蟾","text":"草木从交代，溪山无故新。\n更斟些子酒，尚是霎时春。\n雨止莺如怨，花飞柳亦颦。\n东皇催上印，生怕子规嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送黄心大师","author":"白玉蟾","text":"如今无用绣香囊，已入空王选佛场。\n生铁脊梁三事衲，冷灰心绪一炉香。\n庭前竹长真如翠，槛外花开般若香。\n万事到头都是梦，天倾三峡洗高唐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送彭侍晨","author":"白玉蟾","text":"铁髭鹘眼两颜酡，走遍江湖所得多。\n脚踏雷车朝帝极，手持斗柄戽天河。\n剑尖指处乾坤暗，丹篆书时鬼魅号。\n名满四方今老矣，请归玉府掌西曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送蜀李道士","author":"白玉蟾","text":"我居琼海子潼川，相望西南路八千。\n乃祖青牛今不返，予家白鹿尚闲眠。\n云萍莫测真如梦，琴剑相逢亦宿缘。\n多少西风黄叶恨，待须贳酒泛湖船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闽清醉中","author":"白玉蟾","text":"东风正月二，吹我上梅溪。\n白雪方才散，黄莺未见啼。\n半空萌雨意，一蝶访桃蹊。\n醉卧黄三店，夜深闻竹鸡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夕客桂岭","author":"白玉蟾","text":"谁使诗狂堕桂林，鸣鞭袅雪一伤心。\n自怜褦襶衣何薄，安有酴酥酒得斟。\n真个飘蓬将欲老，何曾卤莽似如今。\n黄刘不喜瑜蒙喜，须信甘宁有赏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":25893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]