[{"title":"鹧鸪天 其三","author":"无名氏","text":"雪屋冰床深闭门。\n缟衣应笑织成纹。\n雨中清泪无人见，月下幽香只自闻。\n长在眼，远销魂。\n玉奴那忍负东昏。\n偶然谪堕行云去，不入春风花柳村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其一 上元词","author":"无名氏","text":"春晓千门放钥匙。\n万官班从出祥曦。\n九重彩浪浮龙盖，一点红云护赭衣。\n车马过，打球归。\n芳尘洒定不教飞。\n钧天品动回銮曲，十里珠帘待日西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 寿摆铺","author":"无名氏","text":"鹤算遗芳续世传。\n武夷来作散神仙。\n柳营隐隐兵戎整，兰砌诜诜子舍贤。\n倾柏酒，爇沉烟。\n殷勤起舞祝长年。\n行须一札飞鸦诏，促缀银班侍九天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其二 上元词","author":"无名氏","text":"日暮迎祥对御回。\n宫花载路锦成堆。\n天津桥畔鞭声过，宣德楼前扇影开。\n奏舜乐，进尧杯。\n传宣车马上天街。\n君王喜与民同乐，八面三呼震地来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 春闺","author":"无名氏","text":"枝上流莺和泪闻。\n新啼痕间旧啼痕。\n一春鱼鸟无消息，千里关山劳梦魂。\n无一语，对芳尊。\n安排肠断到黄昏。\n甫能炙得灯儿了，雨打梨花深闭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其十二 上元词","author":"无名氏","text":"彻晓华灯照凤城。\n犹嗔宫漏促天明。\n九重天上闻花气，五色云中应笑声。\n频报道，奏河清。\n万民和乐见人情。\n年丰米贱无边事，万国称觞贺太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其十三 上元词","author":"无名氏","text":"忆得当年全盛时。\n人情物态自熙熙。\n家家帘幕人归晚，处处楼台月上迟。\n花市里，使人迷。\n州东无暇看州西。\n都人只到收灯夜，已向樽前约上池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"无名氏","text":"梦草池塘春意回。\n巧传消息是寒梅。\n北枝休羡南枝暖，凭仗东风次第开。\n酥点萼，粉匀腮。\n未攀已得好香来。\n西邻且莫吹羌笛，留待行春把酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 寿姑","author":"无名氏","text":"溪水连天秋雁飞。\n藕花风细鲤鱼肥。\n阿婆一笑知何事，怀橘郎君衣锦归。\n天上月，几秋期。\n娟娟凉影画堂西。\n堂前拜月人长健，两鬓青如年少时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 八月十九","author":"无名氏","text":"宴罢中秋恰四朝。\n金炉因甚把香烧。\n若非金母生今日，应是麻姑降此宵。\n歌窈窕，舞娇娆。\n迭将寿酒酌金蕉。\n椿龄柏算何须祝，名列仙班亦孔昭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 自寿","author":"无名氏","text":"云外青山是我家。\n两年城里作生涯。\n杜陵赏月延秋桂，彭泽无钱对菊花。\n初度日，感年华。\n三杯浊酒一瓯茶。\n尊前儿女休相笑，更有人穷似汝爷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"无名氏","text":"清明将近春时节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 贺人生女","author":"无名氏","text":"象榻香篝冷宝猊。\n虺蛇吉梦寤惊时。\n缇萦生下虽无益，谢女他年或解围。\n花骨脉，雪肤肌。\n飞琼抱送下瑶池。\n弄璋错写何妨事，爱女从来甚爱儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其七 上元词","author":"无名氏","text":"玉座临轩宴近臣。\n御楼灯火发春温。\n九重天上闻仙乐，万宝床边侍至尊。\n花似海，月如盆。\n不任宣劝醉醺醺。\n岂知头上宫花重，贪爱传柑遗细君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"无名氏","text":"抛却功名弃却诗。\n从教身染气球泥。\n侵晨打?齐云会，际暮演筹落魄归。\n园苑里，粉墙西。\n佳人偷揭绣帘窥。\n高侵云汉垂肩久，低拂花梢下脚迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 五月初十","author":"无名氏","text":"饮了蒲觞五日期。\n彩丝还系玉麟儿。\n台云荐瑞生香褓，菡萏飘香入寿卮。\n占骨相，孕清奇。\n秋风雁序看齐飞。\n卿家奕世青毡在，况是双亲未老时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"无名氏","text":"不贪名利乐优游。\n收转心猿踢气球。\n日享三餐朋友饭，夜眠一宿玉人楼。\n真快活，度春秋。\n从他乌兔走无休。\n或时戏耍名园里，或把长竿湖上游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其九 上元词","author":"无名氏","text":"宣德楼前雪未融。\n贺正人见彩山红。\n九衢照影纷纷月，万井吹香细细风。\n复道远，暗相通。\n平阳主第五王宫。\n凤箫声里春寒浅，不到珠帘第二重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"无名氏","text":"五百人中第一仙。\n等闲平步上青天。\n绿袍乍著君恩重，黄榜初开御墨鲜。\n龙作马，玉为鞭。\n花如罗绮柳如绵。\n时人莫讶登科早，自是嫦娥爱少年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 十二月十六","author":"无名氏","text":"腊月初开一荚蓂。\n祥开崧岳庆生申。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其十五 上元词","author":"无名氏","text":"真个亲曾见太平。\n元宵且说景龙灯。\n四方同奏升平曲，天下都无叹息声。\n长月好，定天晴。\n人人五夜到天明。\n如今一把伤心泪，犹恨江南过此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其六 腊梅","author":"无名氏","text":"别得东皇造化恩。\n黛消铅褪自天真。\n耻随庾岭花争白，疑是东篱菊返魂。\n风淡淡，月盈盈。\n麝煤沈馥动孤根。\n寒蝉冷蝶知何处，惟有蜂房不待春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其三 上元词","author":"无名氏","text":"紫禁烟光一万重。\n五门金碧射晴空。\n梨园羯鼓三千面，陆海鳌山十二峰。\n香雾重，月华浓。\n露台仙仗彩云中。\n朱栏画栋金泥幕，卷尽红莲十里风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 弟寿兄又赴省","author":"无名氏","text":"冬至阳生才两日，欣逢伯氏绂麟辰。\n鹡鸰原上欢声沸，棣萼堂前喜气新。\n斟九酝，劝千巡。\n华途从此问云津。\n杨前未把耆年祝，且愿青云早致身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 送人出赘","author":"无名氏","text":"喜气乘龙步步春。\n梅花影里送君行。\n君行直到蓝桥处，一见云英便爱卿。\n鸾鹤舞，凤凰鸣。\n群仙簇拥绿衣人。\n我嗏有句叮咛话，千万时思望白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"无名氏","text":"遇酒当歌酒满斟。\n一觞一咏乐天真。\n三杯五盏陶情性，对月临风自赏心。\n环列处，总佳宾。\n歌声缭亮遏行云。\n春风满座知音者，一曲教君侧耳听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其五","author":"无名氏","text":"春入江梅破晚寒。\n冻枝惊鹊语声乾。\n离愁满抱人谁问，病耳初闻心也宽。\n风细细，露珊珊。\n可堪驿使道漫漫。\n斜梢待得人来后，簪向乌云仔细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"无名氏","text":"满池荷叶动秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"无名氏","text":"落花凝恨夕阳中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 生日自寿赋谢人庆寿","author":"无名氏","text":"生羡鸡冠与凤仙。\n时秋华艳遍园间。\n自怜生日悲生事，搔首吴江载月船。\n休身外，且樽前。\n喜君文彩锦相鲜。\n青云贻我长生曲，唤醒凄凉乐暮年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"无名氏","text":"虎掌葵花一锭银。\n全凭巧匠弄精神。\n里臁外跨知高下，逼拐挑尖月一轮。\n欺强汉，灭村人。\n其间奥妙岂堪论。\n不问贵戚并公子，曾与区区并马行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"无名氏","text":"巧匠园缝异样花。\n身轻体健实堪夸。\n能令公子精神爽，善诱王孙礼义加。\n宜富贵，逞奢华。\n一团和气遍天涯。\n宋祖昔日皆曾习，占断风流第一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 寿妇人","author":"无名氏","text":"织女初秋渡鹊河。\n逾旬蟾苑聘嫦娥。\n蓬莱仙子今宵降，前后神仙引从多。\n餐玉蕊，抚云璈。\n寿筵戏彩捧金荷。\n黄金照社三儿贵，他日潘舆侍绮罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"无名氏","text":"题得相思字数行。\n起来桐叶满纱窗。\n秋光欲雨棋声泻，粉帐不容花露香。\n新寂寞，旧疏狂。\n玉炉消息记钱塘。\n小阑立遍红蕉树，一带残云趁月黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其一 车中","author":"无名氏","text":"紫陌朱轮去似流。\n丁香初结小银钩。\n凭阑试问秦楼路，瞥见纤纤十指柔。\n金约腕，玉搔头。\n尽教人看却佯羞。\n欲题红叶无流水，别是桃源一段愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"无名氏","text":"轩辕起置号齐云。\n社祖西川妙道君。\n□□亲自裁成就，万古流传作玩珍。\n江湖客，听原因。\n今朝出岳见其真。\n来到圣前必撞案，诚将实艺向前呈。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"无名氏","text":"冷落人间昼掩门。\n泠泠残粉縠成纹。\n几枝疏影溪边见，一拂清香马上闻。\n冰作质，月为魂。\n萧萧细雨入黄昏。\n人间暂识东风信，梦绕江南云水村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其六 上元词","author":"无名氏","text":"宝炬金莲一万条。\n火龙围辇转州桥。\n月迎仙仗回三殿，风递韵音下九霄。\n登复道，听鸣鞘。\n再颁酥酒赐臣僚。\n太平无事多欢乐，夜半传宣放早朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 集曲名","author":"无名氏","text":"烛影摇红玉漏迟。\n鹊桥仙子下瑶池。\n倾杯乐处笙歌沸，苏幕遮阑笑语随。\n醉落魄，阮郎归。\n传言玉女步轻移。\n凤凰台上深深愿，一日和鸣十二时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 秋榜将开得子","author":"无名氏","text":"菊釂萸残玉未颓。\n文星喜趁梦熊回。\n预传鲲拟南溟去，亲送魁从北斗来。\n真间世，定奇材。\n满堂欢笑动春雷。\n明年郎罢蟾宫近，更把丹枝为我栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 寿赵簿","author":"无名氏","text":"当日名驹产渥洼。\n追风千里堕君家。\n不辞贤路甘栖棘，来伴河阳且种花。\n梅试雪，酒潮霞。\n寿觞还捧笑声哗。\n唐朝九相青毡旧，为报新堤早筑沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 七月廿七","author":"无名氏","text":"秋至人间灏气清。\n蓂馀三荚映阶庭。\n挺生豪杰为时瑞，来至簪缨亨世荣。\n天付与，寿康宁。\n不须举酒祝椿龄。\n楼头昨夜瞻南极，偏向梅峰分外明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"无名氏","text":"小小池亭自有凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 三月初二","author":"无名氏","text":"罗袜凌波洛浦仙。\n谪来潭府话夤缘。\n应嫌曲水香尘涴，诞降兰亭禊事前。\n歌窈窕，舞婵娟。\n芝兰满室庆团圆。\n殷勤试问刘郎看，阿母蟠桃种几年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"无名氏","text":"往事旧游浑似梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"无名氏","text":"山色晴岚景物佳。\n暖烘回雁起平沙。\n东郊渐觉花供眼，南陌依稀草吐芽。\n堤上柳，未藏鸦。\n寻芳趁步到山家。\n陇头几树红梅落，红杏枝头未著花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 佳人","author":"无名氏","text":"全似丹青揾染成。\n更将何物斗轻盈。\n雪因舞态羞频下，云为歌声不忍行。\n螺髻小，凤鞋轻。\n天边斗柄又斜横。\n水晶庭柱琉璃帐，客去同谁看月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"檐前铁","author":"无名氏","text":"悄无人，宿雨厌厌，空庭乍歇。\n听檐前铁马戛叮当，敲破梦魂残结。\n丁年事，天涯恨，又早在心头咽。\n谁怜我、绮帘前，镇日鞋儿双跌。\n今番也、石人应下千行血。\n拟展青天，写作断肠文，难尽说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜天晓角","author":"无名氏","text":"一声阿鹊。\n人在云西角。\n信有黄昏风雨，孤灯酒、不禁酌。\n错错。\n谁误著。\n明知明做却。\n颇寄香笺归去，教看了、细揉嚼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霜叶飞","author":"无名氏","text":"故宫秋晚馀芳尽，轻阴闲淡池阁。\n风泥银暗玳纹花，卷断肠帘幕。\n渐砌菊、遗金谢却，芙蓉才共清霜约。\n半弄蕊、冰绡波浅，拂胭脂、翠琼连并雕萼。\n应是曾倚东君，纵艳姿轻盈，映损丹杏红药。\n旋成深妒，判与西风，任从开落。\n况衰晚、渊明意薄。\n重阳羞对吟酌。\n待说与江梅，早傅粉匀香，慰伊萧索。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鬓边华","author":"无名氏","text":"小梅香细艳浅。\n过楚岸、尊前偶见。\n爱闲淡，天与精神，掠青鬓、开人醉眼。\n如今抛掷经春，恨不见、芳枝寄远。\n向心上、谁解相思，赖长对、妆楼粉面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"无名氏","text":"众鸟不喜亦不悲，又复别寻高树枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"无名氏","text":"祖来产业分兄弟，身后诗书遗子孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"无名氏","text":"三春花发惟樗树，二月莺啼是老鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"无名氏","text":"赢得儿童叫夫子，可怜名位只都官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"无名氏","text":"城边一水抱城流，城外群山拥郡楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"无名氏","text":"但看建德安民榜，即是虚翁德政碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"无名氏","text":"地下若逢秦相国，也应不说到沅湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"无名氏","text":"不到施黔不见山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"无名妇人","text":"蚌胎光透壳，犀角晕盈尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"无名氏","text":"楚国封疆六千里，荆门岩峦十二碚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"无名氏","text":"天涯亭下有龙窟，林冶山头出碎金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"无名氏","text":"啼月杜鹃喉舌冷，宿花蝴蝶梦魂香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"无名氏","text":"一色楼台三十里，不知何处觅孤山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"无名氏","text":"文章却似呼延赞，风貌全同富相公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李廷彦","text":"舍弟江南没，家兄塞北亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"无名氏","text":"鸟鸣深夜岂知形，彻晓音喧响更清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郊寺","author":"木待问","text":"红委墙阴花寂寂，翠滋亭角草纤纤。\n风翻书叶常交案，雨压炉烟不过帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"千里思","author":"木待问","text":"君行千里轻所历，妾驰千里心匪石。\n春房酌酒意匆匆，愁不在离愁在忆。\n鸳鸯瓦上昏无色，鹦鹉杯中尘更积。\n灯前独坐制君衣，泪湿剪刀裁不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"火后寄诠老","author":"木待问","text":"搀枪堕九霄，列缺乱阡陌。\n西城若黔庐，东墟已堆甓。\n幽栖仅容膝，隐市意自适。\n天公不我相，同此编户厄。\n平生一丘壑，未信天地窄。\n终焉感穷途，万虑集中夕。\n载观宇宙内，在在等公宅。\n鄙夫六尺躯，俯仰叹逼仄。\n炙手事当路，快意已烂额。\n野子今兀然，乘除付陈迹。\n此身亦何有，而复身外惑。\n相逢肯分山，试面九年壁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]