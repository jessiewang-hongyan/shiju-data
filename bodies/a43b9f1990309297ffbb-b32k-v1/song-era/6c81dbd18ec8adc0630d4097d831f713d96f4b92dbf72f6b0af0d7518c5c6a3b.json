[{"title":"小暑日寄山甫二首 其二","author":"刘克庄","text":"七年侍膝极融怡，半月分襟费梦思。\n比鹿门翁吾齿耄，作鱼梁吏汝官卑。\n击鲜何忍为儿溷，反鲊无烦寄土宜。\n若见省郎问村叟，不能书札尚能诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小暑日寄山甫二首 其一","author":"刘克庄","text":"微官便有简书畏，贫舍非无水菽欢。\n插架签存先世旧，堆床笏美一时观。\n远书且问平安好，前哲曾嗟嗣守难。\n了却台参早怀檄，暂归亦可小团栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中祠堂","author":"刘克庄","text":"端平闻说建斯堂，白首才重一炷香。\n早有埋辞表真曜，晚为画赞讼东方。\n秋风浩荡吹坟树，落月依稀照屋梁。\n千古行人来下马，陈诗不必奠椒浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山丹","author":"刘克庄","text":"偶然避雨过民舍，一本山丹恰盛开。\n种久树身樛似盖，浇频花面大如杯。\n怪疑朱草非时出，惊问红云甚处来。\n可惜书生无事力，千金移入画栏栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山甫既别三日复得此诗追饯","author":"刘克庄","text":"珍重吾儿记瞽言，献之玉帐及輶轩。\n汉钳者众商多犯，秦税民深吏少恩。\n监竹忍馋毋食笋，割葵轻手勿伤根。\n乌衣子弟多佳者，莫遣诸贤笑后村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山茶","author":"刘克庄","text":"青女行霜下晓空，山茶独殿众花丛。\n不知户外千林缟，且看盆中一本红。\n性晚每经寒始拆，色深却爱日微烘。\n人言此树尤难养，暮溉晨浇自课僮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"工部弟哀诗二首 其二","author":"刘克庄","text":"去岁书来欲解麾，数行遗墨半倾攲。\n斑衣不遂娱亲志，白发因吟哭子诗。\n让枣犹如前日事，摘瓜空抱暮年悲。\n情知衰泪无堪滴，原上寒笳苦死吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"工部弟哀诗二首 其一","author":"刘克庄","text":"忽然吹散恨难平，六十年间老弟兄。\n春草池塘成昨梦，夜床风雨付来生。\n归谋甫里田差晚，去与端溪石共行。\n部曲出门情态异，不如笼鹤有哀声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"己未元日","author":"刘克庄","text":"久向优场脱戏衫，亦无布袋杖头担。\n化弥勒身千百亿，问绛人年七十三。\n诸老萧疏留后殿，高僧灭度少同参。\n未应春事全无分，醉折缃桃蒲帽簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"广州劝驾一首","author":"刘克庄","text":"番禺文物于今盛，闽浙彬彬未足夸。\n丞相宅曾住南郭，鼎魁坊止在东家。\n好陈董子三篇策，莫看唐人一日花。\n珍重诏书相勉意，士先器识后词华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"广州都试","author":"刘克庄","text":"自昔番禺统府雄，君恩暂许领元戎。\n不羞短发垂肩白，且爱前旌照眼红。\n笔久不灵妨草檄，臂新无力怯开弓。\n即今超距多枭俊，安用辎车载此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"门外 其一","author":"刘克庄","text":"门外沙鸥忽散群，云何飞矢远寻君。\n今身莫是前□干，异世宁无后子云。\n早岁多言生悔吝，暮年双聩断知闻。\n吾儿谨勿趋华藻，宁使班书议少文。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"门外 其二","author":"刘克庄","text":"平生孤立懒随群，未爱标名附五君。\n投老病身甘碓□，无穷世事等轮云。\n牛衣尚许寻初服，蚕室何堪续旧闻。\n玉座他年如记忆，安知不讲礼融文。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"门前榕树","author":"刘克庄","text":"木寿尤推栎与樗，观榕可信漆园书。\n绝无翡翠来巢此，曾有蚍蜉欲撼渠。\n五凤修成安用汝，万牛力挽竟何如。\n山头旦旦寻斤斧，拥肿全生计未疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不寐","author":"刘克庄","text":"万户千门尽拥衾，据梧展转看横参。\n不知身已成衰證，枉被人疑是苦吟。\n周汉前书盲记忆，乾坤外事彊思寻。\n华山老子差堪语，安得呼来论此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不寐二首 其二","author":"刘克庄","text":"□□□□听漏筹，檐声得得伴春愁。\n残灯似唤人开□，□□□□妾护篝。\n昔者鹤曾为道士，俄而蝶又化庄周。\n要知梦觉皆虚幻，且拨寒炉起坐休。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"不寐二首 其一","author":"刘克庄","text":"□□凭书作睡媒，夜窗危坐乱书堆。\n甫从安乐窝移去，又向华胥国遣回。\n转枕易如炊斗黍，据梧听彻奏□□。\n□□□□东方白，仍取残编更阖开。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中?先茔","author":"刘克庄","text":"昔遇重华席屡前，因排贵近去翩然。\n叩墀袖有驰毬疏，易箦囊无沐椁钱。\n当日传家惟谏草，至今赡族赖祠田。\n原头宰木苍如此，才见山庵葺数椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"为圃二首 其二","author":"刘克庄","text":"衰病归来占把茅，譬如僧葺退居寮。\n因存橘树斜通径，怕碍荷花小著桥。\n古有功名兴钓筑，今无物色到渔樵。\n可怜岁晚闲双手，种罢芜菁撷菊苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"为圃二首 其一","author":"刘克庄","text":"屋边废地稍平治，装点风光要自怡。\n爱敬古梅如宿士，护持新笋似婴儿。\n花窠易买姑添价，亭子难营且筑基。\n老矣四科无入处，旋锄小圃学樊迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌石山","author":"刘克庄","text":"客子家山亦此峰，可堪投宿听疏钟。\n旋沽村酒开霜柿，欲访禅扉隔暮松。\n乡信写成无便寄，寒衣著绽倩人缝。\n远来只为营瓜圃，不是贪渠万户封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌石山","author":"刘克庄","text":"儿时逃学频来此，一一重寻尽有踪。\n因漉戏鱼群下水，缘敲响石斗登峰。\n熟知旧事惟邻叟，催去韶华是暮钟。\n毕竟世间何物寿，寺前雷仆百年松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书","author":"刘克庄","text":"两帖走蛟虬，堂堂腕力遒。\n太师唐死节，大令晋风流。\n要续麻姑刻，那容扇媪求。\n教儿勤护惜，恐被六丁偷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书田舍所见","author":"刘克庄","text":"漠漠晴埃起远畴，占相云日几家愁。\n细民方虑填中壑，巨室何心堰上流。\n斩木由来基小衅，浇瓜谁为解私仇。\n宁知送老茅檐下，犹抱书生畎亩忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书灯","author":"刘克庄","text":"童子糊新就，笼纱碧色深。\n唤回少年梦，照见古人心。\n每对忘甘寝，频挑伴苦吟。\n与君交到老，莫虑弃墙阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书考一首","author":"刘克庄","text":"香火精勤阅一期，孤臣无路答鸿私。\n衔如已废陈人样，俸比初开小学时。\n世上升沉姑付酒，考中功状是吟诗。\n五钱买得羊毛笔，自写年劳送有司。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书近事二首 其二","author":"刘克庄","text":"石卫尉家先没入，黔娄生处亦诛求。\n客嘲未悟漫天戏，鬼瞰皆知偃月谋。\n不许他人分越国，预拚异日去崖州。\n傍观莫枉为酸鼻，鹿死无魂岂有愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书近事二首 其一","author":"刘克庄","text":"坏局今犹劳圣虑，穷涂自叹失人心。\n贵曾颛面居金鼎，谪尚于飞恋绣衾。\n罪大□□□柳下，恩宽许卧古藤阴。\n殡时惟有青蝇集，此外应无吊客临。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事","author":"刘克庄","text":"市朝无处避喧啾，思驾飞车事远游。\n古志曾云寿多辱，前贤亦说耄宜休。\n愈诃彼佛为夷鬼，蹠骂吾师作盗丘。\n安得海波都变酒，洗空开辟以来愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事二首 其一","author":"刘克庄","text":"谦之绋翣迎归福，平甫灰钉送返莆。\n空累两家营后事，仅留四壁遗诸孤。\n学徒谁是单传者，史藁曾经乙览无。\n贫富皆当终牖下，招魂何处有神巫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事二首 其二","author":"刘克庄","text":"人道山东入职方，书生胆小虑空长。\n遗民似蚁饥难给，侠士如鹰饱易扬。\n未见驰车修寝庙，先闻铸印拜侯王。\n青齐父老应流涕，何日鸾旗驻路旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事二首 其二","author":"刘克庄","text":"二士平生极好修，箪瓢之外尚何求。\n暮年更傍谁门户，故国宁无某水丘。\n华箦殊非爱曾子，短衾自可覆黔娄。\n小车处士差安稳，十二行窝取次游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事二首 其一","author":"刘克庄","text":"空空都没一行书，行行徒矜九尺躯。\n面上带妖真可耻，脚中有鬼不容扶。\n末年铁拐传仙诀，他日金锥抉冢珠。\n泉下定为明允笑，果能看破半山无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事二首 其二","author":"刘克庄","text":"利刃斩风空恶毒，疾声吠雪似呆颠。\n嗟余刍狗木鸡尔，视汝螟蛉蜾蠃然。\n墓上将军堪嚇鬼，龛中大士且安禅。\n不须忏礼如来足，佛与波旬共结缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事十首 其九","author":"刘克庄","text":"战鼙非起自渔阳，到寇皆由偃月堂。\n相国裘虽来贺捷，蚩尤旗尚未收芒。\n厨车古有刑都市，宝剑今谁请尚方。\n莫倚圣朝家法恕，前卢后蔡亦投荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事十首 其八","author":"刘克庄","text":"晋士材疏辩舌优，俗虽虚诞尚清脩。\n可容卿等数百辈，亦过江来第一流。\n元老纵然挥玉麈，七贤已有执牙筹。\n后来灵宝真儿态，书画惟凭夺与偷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事十首 其七","author":"刘克庄","text":"不知边信近何如，但见朝朝发虎符。\n河北几于九节度，漠南奚止五单于。\n黑天肥瘗犹存孽，红贼巢荒尚有雏。\n安得四方皆猛士，旄头扫尽一尘无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事十首 其六","author":"刘克庄","text":"魁柄推移偶属渠，可堪一掷付狂疏。\n文中子处无熏染，桑大夫边窃绪馀。\n痴物汝为何等相，纤儿吾惜好家居。\n时人误把朱崖比，若比朱崖尽欠书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事十首 其五","author":"刘克庄","text":"旦旦寻斤杰木衰，艰危深动听鼙思。\n赐龙墀对询韬略，复雁门踦建义旗。\n古有舆迎聋主簿，今谁卧载膑军师。\n不应在野无贤隽，林密山深世未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事十首 其四","author":"刘克庄","text":"生长承平玩细娱，变兴仓卒不支吾。\n轻裘太守抛铃下，宝玦郎君泣路隅。\n谍报长驱殊未觉，经书大去可胜诛。\n世间果有桃源否，千载无人更问途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书事十首 其三","author":"刘克庄","text":"天堑犹艰限臭夷，江边蚌鹬久相持。\n昔珠帘阁俱清野，今琵琶亭亦浚池。\n户万八千封作么，计三十六走安之。\n平生师慕尧夫者，老去无端也皱眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书感","author":"刘克庄","text":"恩赐残骸得返耕，孤臣安敢厌承明。\n羊肠曾有单车覆，牛背那无一笛横。\n俗子休疑眉宇异，痴人错望耳毫生。\n老身虽厄心常泰，听取商歌绕屋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书感","author":"刘克庄","text":"髧髦驰逐少年场，晚向深山学老庄。\n名以马牛犹不校，嘲为豚犬极何妨。\n性疏熟客来难记，意懒生书读易忘。\n却笑痴人误标榜，贤愚千古共茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书感","author":"刘克庄","text":"仲尼已没世无师，新学专门各自私。\n死守不为它说胜，秘藏似恐外人窥。\n欲招程子看通典，兼起欧公讲系辞。\n浩叹迩来耆旧尽，绪言分付与群儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云","author":"刘克庄","text":"农家望汝卜年丰，似絮如峰?不同。\n纵有浓阴工阁雨，略无定态喜随风。\n往来与月为仇敌，舒卷和天尽蔽蒙。\n安得竦身腾汗漫，叫开阊阖扫长空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五月旦日鸡鸣梦袖疏墀下先君问言何事答曰犹素论也先君太息称善闻追班声惊寤以诗识之","author":"刘克庄","text":"梦中候对殿东厢，解后先亲问答详。\n碓磨不能移素论，曝芹终欲献清光。\n触屏训谄生犹臭，攀槛传名死亦香。\n君父临之安所避，凌晨起坐涕淋浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五和 其二","author":"刘克庄","text":"江湖浩渺常存阙，云汉昭回妙阐坤。\n妓或携来安石墅，客谁畔去翟公门。\n戴花老岂非同姓，拾穗翁犹有远孙。\n杀马毁车吾耄矣，尚堪扶杖过邻村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五和","author":"刘克庄","text":"客怪村翁老犹健，我知造物有乘除。\n曾看鲸海鹏天了，岂比蜂窝蚁垤如。\n旧敬尊公维北斗，今为后学指南车。\n此生只合熏班马，掩鼻人间等鲍鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五和 其二","author":"刘克庄","text":"少日父兄夸俊声，后来场屋擅文名。\n锦囊久矣憎长吉，玉枕几于杀阿平。\n怪底鸥群及鱼队，化为虎落与蛇坑。\n可怜彩翠矜毛羽，顾影无言只自惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五和 其一","author":"刘克庄","text":"出门机阱已相随，竟放灵均逐伯奇。\n始者齧肤微似蚋，俄然择肉及于罴。\n不言快箭穿杨叶，却讶长松托兔丝。\n败坏人材由利禄，乃知曾点胜颛师。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五和 其一","author":"刘克庄","text":"雾扫山如泼黛浓，一开口笑古难逢。\n斩新种柳辋川水，火急移莲玉井峰。\n甚爱名花当辇致，远求佳果莫函封。\n人生惟有田园乐，未可轻将仕易农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五和二首 其二","author":"刘克庄","text":"颓然一榻懒巾靴，二月东风尚未和。\n雀闯屋檐来作宿，蜂衔窗纸去为窝。\n牢愁余发五分白，健思君才十倍多。\n欲访东皋贤鼻祖，几回路与醉乡蹉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五和二首 其一","author":"刘克庄","text":"尚记诸贤聚本朝，当时君相急旁招。\n箫韶九奏凤谐乐，金弹一声莺下乔。\n彊项昔尝攀殿槛，饥肠今欲把僧瓢。\n蚤知不得文章力，却悔从初夺锦标。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纵笔一首","author":"刘克庄","text":"邺下徐陈逐逝波，仅留老子尚婆娑。\n吾宗世有戴花舞，大耋谁能鼓缶歌。\n松下寻常无喝道，花间随处有行窝。\n痴人逐物回头少，看到棋终恐烂柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仓使和诗出奇不穷再次韵四首 其四","author":"刘克庄","text":"公似长松特秀冬，青蒿安敢与松同。\n高于岱顶谁曾览，远若河源未易穷。\n历块岂无追电骏，步虚疑有架天虹。\n吾诗直犹砖抛耳，载宝而归所得丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仓使和诗出奇不穷再次韵四首 其三","author":"刘克庄","text":"向来文史足三冬，今与樵儿牧竖同。\n旧领木天良不恶，新加菜地未为穷。\n笔精公有词批凤，瓶罄吾无酒灌虹。\n老思迟于寒谷黍，更烦邹律为吹丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仓使和诗出奇不穷再次韵四首 其二","author":"刘克庄","text":"百禽久已蛰于冬，春暖喧啾各不同。\n壶少提沽村店静，裤无脱著小家穷。\n山翁吟窍黄泥蚓，阁老毫端白昼虹。\n社饮今年多醒者，豚肩掩豆不能丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仓使和诗出奇不穷再次韵四首 其一","author":"刘克庄","text":"作雨宾春雪饯冬，田家休戚使家同。\n鱼非人所当加察，马与民皆不可穷。\n政尔和风并暖日，管他雌霓更雄虹。\n耿侯非祖荆舒者，预创常平备歉丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以宋香方红送听蛙翁答柬云两年来啖荔颗则动气按本草等书云荔枝能蠲渴补髓未闻其动气也口占一首发翁一笑","author":"刘克庄","text":"奁封名品饷耆年，谊比□芹曝背然。\n帖报能生采薪疾，谱言曾有荔枝仙。\n朵颐笑我脾神馁，节腹知君气□全。\n来岁郎官香烂熟，定分千颗沃馋涎。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日","author":"刘克庄","text":"元日家童催蚤起，起搔冷发惜残眠。\n未将柏叶簪新岁，且与梅花叙隔年。\n甥侄拜多身老矣，亲朋来少屋萧然。\n人生智力难求处，惟有称觞阿母前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日七言二首 其二","author":"刘克庄","text":"屋角微闻哢晓禽，起煨榾柮旋冠簪。\n莱衣儿老长相守，椒酒翁衰且少斟。\n浮世事浑忘记了，暮年诗转用功深。\n双桃忽放花如锦，勾引先生策杖寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日七言二首 其一","author":"刘克庄","text":"久辞两禁归民伍，遥想群仙谒帝居。\n少有人临雀罗者，未知谁饮兽樽欤。\n向来不晓京房易，老去粗通泛胜书。\n懊恼西畴春事动，渐难为国荷犁锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"公论","author":"刘克庄","text":"公论无过月旦评，吾衰安敢主乡盟。\n触蛮力劝休争战，猿鹤相安不怨惊。\n髧彼两髦呼作友，长吾一日敬为兄。\n前身定是徐先辈，延寿溪头了一生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]