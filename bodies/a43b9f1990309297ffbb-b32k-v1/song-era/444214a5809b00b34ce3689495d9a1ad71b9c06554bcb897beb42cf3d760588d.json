[{"title":"喜晴晚归","author":"宋庠","text":"八月高空卷断霓，落霞残照掖门西。\n仙城气暖犹藏雾，辇路尘清不杂泥。\n殿里风回闻禁漏，阙边云敛见丹梯。\n迎寒便立甘泉仗，扈从应无七圣迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒野","author":"宋庠","text":"芳岁行遒尽，高堂兴耿然。\n林号欲风野，云绽已霜天。\n乌彩疑留日，鸿声似恶弦。\n幽衿忽忘返，更为月娟娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓居寰内宰邑者数见存访因成谢","author":"宋庠","text":"谢病非三最，为氓乏一廛。\n何言罗爵尉，时驻舄凫仙。\n华辙交深巷，馀香袭故毡。\n猪肝难设具，应作闵生怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓直晚归见天街早春景物","author":"宋庠","text":"霁云衔苑雪云开，春色先从禁籞回。\n马上妩眉偏认柳，楼前妆额固知梅。\n吹残凤籥惊寒律，忙杀鸱幐取冻醅。\n莫问康年行乐意，寿觞初罢佛灯来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惠泉","author":"宋庠","text":"济物功偏厚，朝宗势不迷。\n一航容宋苇，六斗异泾泥。\n润溢呼鱼辙，光分抱瓮畦。\n宁同南国咏，酌饮变夷齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"提刑张司封同年垂访别郡以诗为谢","author":"宋庠","text":"天圣光华第二春，与君同日脱凡鳞。\n何知素领分符地，却见青云共榜人。\n千重使移行府重，一觞欢伯故俦亲。\n言诗击节兼风义，且欲因声附翠珉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝谒应天神御瞻仰壮丽退憩斋房作","author":"宋庠","text":"云构崔嵬敞梵筵，皇家基运此兴先。\n如存不改当阳坐，善护常开种福田。\n四彻金绳规宝所，九衢琼树宿非烟。\n须知补旧延洪意，重数仙人拂石年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝谒建隆寺","author":"宋庠","text":"郡国高皇庙，天龙释帝居。\n兵销擒布后，台耸畏轩馀。\n宝榻成莲坐，戎韬入贝书。\n守臣荣就望，屏息拜前除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝谒待漏偶成咏怀","author":"宋庠","text":"天街残月斗城西，五里葱葱瑞雾迷。\n仙翰入陪廱泽鹭，晓筹初听汝南鸡。\n星翻徼道千庐密，云敛觚棱两观齐。\n自顾山林疏贱质，谁将车马载惊鼷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登大明寺塔","author":"宋庠","text":"寂寞南朝寺，徘徊北顾人。\n钟声含晓籁，塔相涌仙轮。\n吊古千龄恨，观空万法尘。\n三车何处在，归鞅欲迷津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答子京","author":"宋庠","text":"一辞云陛五周年，琐闼销符宠再迁。\n时誉敢希吴陆俊，归心偏识汉疏贤。\n蜗头狼籍争锋地，鸿影徘徊避弋天。\n命驾不须频见约，颍滨嵩麓有私田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"落花","author":"宋庠","text":"一夜春风拂苑墙，归来何处剩凄凉。\n汉皋佩冷临江失，金谷楼危到地香。\n泪脸补痕劳獭髓，舞台收影费鸾肠。\n南朝乐府休赓曲，桃叶桃根尽可伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感怀寄进士胡肃","author":"宋庠","text":"离怀何事共凄然，云路无因著祖鞭。\n赋苑竹荒沈旧赏，书邮梅老怨残年。\n庄魂断处星垂地，楚思摇时水接天。\n赵壹穷愁堪自笑，拟将文腹敌囊钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感秋二首 其二","author":"宋庠","text":"岁事催人事，荣心伴客心。\n鸾骖收画扇，螳臂感瑶琴。\n夕露繁将滴，朝云薄亦阴。\n金貂寓直省，潘兴转难任。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感秋二首 其一","author":"宋庠","text":"夕轩疏雨罢，物物为秋惊。\n病叶先风落，寒蝉趁候鸣。\n西飞愁燕急，左界恨河倾。\n借问三江客，鲈鱼底有情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"摄祀出城过西苑马上作","author":"宋庠","text":"斗柄仙城晓，龙鳞下隰通。\n三竿眺羲驭，十里过商中。\n水藉天容碧，尘依驿辙红。\n喜闻何力语，应为乐秋丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新月","author":"宋庠","text":"稍傍夕楼明，娟娟底有情。\n眉纤斗蛾出，钩曲误鱼惊。\n欲暗犹衔岫，将斜更上楹。\n刀头君自晚，莫枉桂初生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新年谢故人惠建茗","author":"宋庠","text":"春筥收英得几丛，小团珍串刻闽工。\n甘踰宝屑非关露，快入烦襟不为风。\n左䥶沸香殊有韵，越瓷涵绿更疑空。\n从来酪茗嘲伧鬼，莫枉奴名立异同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新春雪霁坐郡圃池上二首 其二","author":"宋庠","text":"溪上危堂堂下桥，腊馀春意卷寒飙。\n烟催树色全疑染，暖逼禽声自学调。\n封径老苔翻败锦，抱城空水皱轻绡。\n茨山小隐归心动，坐想琼芝几陇苗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新春雪霁坐郡圃池上二首 其一","author":"宋庠","text":"铃斋西北小池台，漠漠年光病眼开。\n水面绿深知冻解，柳梢黄浅觉春来。\n啁啾野雀遗寒毳，拨剌潜鱼露戏鳃。\n物物恼人俱入咏，使君争奈乏天才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新晴","author":"宋庠","text":"清明初过雨初收，春意重因霁景留。\n风定草烟还压野，云开山色始归楼。\n邙阴高树藏低岭，河曲新波没故洲。\n点检丛花犹半在，应须秉烛为君游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"溪斋春日","author":"宋庠","text":"问君何事拙谋身，竹坞溪斋养钝人。\n白鹭仪形閒照水，野莺言语乱嘲春。\n半生已悔婴朝绂，万境方将付客尘。\n自笑经旬无宴具，对花孤坐咽琼津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"禁中寒蝉","author":"宋庠","text":"何处幽林蜕，来依禁树鸣。\n风緌非冒宠，露腹祗知清。\n晓韵飘觚阙，残嘶逗綵甍。\n秋螳多怒臂，寂寞好全生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"遥夜","author":"宋庠","text":"夜夕更筹永，霜飞岁籥空。\n斗杓常记候，蟾晕豫知风。\n过雁惊流弋，衰萤恋故丛。\n可堪乡思发，梦绕兔园东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬王拱辰侍郎归阙见赠","author":"宋庠","text":"俊誉由来服搢绅，更烦馀略霁边尘。\n威留玉帐时无战，班入金华地最亲。\n昔看草辞知大笔，今荣除馆识嘉宾。\n一章求旧人知否，媮俗都融郢曲春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"酬仲微以舍弟忝直螭阶余近尘凤署见庆之作","author":"宋庠","text":"世隐东畿赋遂初，荆枝相乐本田庐。\n偶随幽鸟同还俗，何意惊鼷并载车。\n浴殿封芝惭视草，史阶簪笔玷成书。\n犹欣夙契寒松在，持谢雕章悦柏馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暮春感兴","author":"宋庠","text":"九十芳期去不留，解痟何计贳珍裘。\n炉残晋俗清明火，水冷山阴祓禊洲。\n风径舞花催暮色，雨梁归燕说春愁。\n离归莫问年华事，赋笔悲于宋玉秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"榴花","author":"宋庠","text":"孤根西土几时传，绛蕊缃趺早夏天。\n艳发虽惭李桃后，子成犹占雪霜前。\n酝馀霞醑香应在，染杀绡裙色未鲜。\n一种芳心耐风雨，敢辞重叠奏君筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"漕渠春台","author":"宋庠","text":"缥陂春色极晴虚，新水遥连六辅渠。\n沙上钓归人获鹬，梁边观罢客知鱼。\n苍浮树影烟生后，红皱溪纹日侧初。\n刮目暂成江海趣，狂奴终忆越滩居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"霁后","author":"宋庠","text":"小雨春膏润，微波晚照空。\n壶光遥送电，梁影半倾虹。\n珍树疏烟合，坳塘暗溜通。\n羲皇谁可上，靖节有窗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蔬食","author":"宋庠","text":"何箸空图贵，潘园且荐羞。\n肥非糠籺饱，炙耻弹鸮求。\n馀薤行堪种，芳葵莫预忧。\n伯阳真意在，鼠坏弃谁收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"醉枕","author":"宋庠","text":"楚辞虚美独醒贤，左手香螯伴醉眠。\n国器载归壶似腹，江萍兴罢幕为天。\n雪楼珠丽巴人曲，芝馆尘生洛浦田。\n昼枕蝶魂方适兴，莫教痟意傍鹍弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题广爱寺楞伽山亭","author":"宋庠","text":"谁覆为山篑，工侔架海形。\n神鞭阴助险，佛髻巧分青。\n栋老栖烟湿，禽翻避咒灵。\n会须依定观，一一访岩扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题江南程氏家清风阁","author":"宋庠","text":"临波飞阁迓层飙，溽暑狂酲此并销。\n客至自同仙寇御，舟归不减郑公樵。\n云明别岛朝虹饮，月碎前溪夜鲤跳。\n借问北窗馀兴否，羲皇高世一相招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题李洗马归欤堂","author":"宋庠","text":"君有诛茅地，重归一亩宫。\n身同岩桂老，心似草堂空。\n昔叹鱼随饵，今欢鹤出笼。\n吾庐嵩颍畔，亦欲狎樵翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题高明堂后池杂景二首 其二","author":"宋庠","text":"一窦春泉贯晓溪，水光涵物见纤微。\n波凫泛泛骚人卜，风蝶翩翩佛助飞。\n雨足旧兰穿畹出，饵香鲜鲔压钩肥。\n昔闻缓带犹堪羡，退食何妨野客衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题高明堂后池杂景二首 其一","author":"宋庠","text":"荒城岑寂冒春霏，竹落江村具体微。\n蛙怒爱为先雨叫，燕轻多作逆风飞。\n印波鸾鉴新荷小，碍路犀簪早笋肥。\n极目纤尘都不动，元规安得污人衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题酂城张氏林亭","author":"宋庠","text":"里占西豪族望雄，一隅幽概掩隆中。\n彩鸳戢翼高梧在，蔚豹成章旧雾空。\n冷接安斋投辖井，细生吟榭快襟风。\n谢庭罗宅资真赏，兰有清芬菊有丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠中书令沂国王文正公挽词二首 其二","author":"宋庠","text":"自昔荣归衮，今兹骇阅川。\n天愁摧柱日，星痛殒箕年。\n素履遗儒范，忠谋溢吏篇。\n空馀洧乡陌，长似岘碑前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠中书令沂国王文正公挽词二首 其一","author":"宋庠","text":"揆路同寅业，师垣出守麾。\n终无三令喜，便集两楹悲。\n衮职嗟何补，天心感慭遗。\n幽泉空漏淎，非复作霖时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠太子太保晁文公挽词二首 其二","author":"宋庠","text":"几杖辞荣久，龙蛇感岁迁。\n留春太史记，成佛谢公缘。\n素盖寒云外，哀箫落月前。\n无烦樵牧禁，行路拜新阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠太子太保晁文公挽词二首 其一","author":"宋庠","text":"帝禁留辞范，儒林老栋材。\n方期割牲礼，遽近奠楹灾。\n岁晏巢鵀逝，天秋吊鹤来。\n宗工铭盛德，千古照泉台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠太傅中书令张文节公挽词三首 其三","author":"宋庠","text":"平日开黄阁，兹辰奠素旗。\n留侯尝辟谷，岩说遂骑箕。\n天迥哀笳咽，林长导翣迟。\n行人此堕泪，何必岘亭碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠太傅中书令张文节公挽词三首 其二","author":"宋庠","text":"昔命光三事，今嗟赎百身。\n堂无织蒲妾，车有吐茵人。\n台坼层氛夜，槐凋故府春。\n空馀相国第，不与势家邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠太傅中书令张文节公挽词三首 其一","author":"宋庠","text":"素范流邦册，昌言溢帝聪。\n三台应天老，万事问胡公。\n道有如弦直，生嗟委蜕穷。\n令君兼上傅，衮敛贲遗忠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠令狐进士","author":"宋庠","text":"阙里高谈擅席珍，多年嵇痹叹沈沦。\n封轺续食论乡士，綵服承颜断织亲。\n风直鹢郊伤六翮，机藏鼷弩惜千钧。\n载肴谁就扬雄宅，覆瓿书成担石贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/P