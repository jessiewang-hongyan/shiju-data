[{"title":"建溪青玉峡云际寺","author":"释文珦","text":"飞瀑挂晴霓，山门对小溪。\n晓行青玉峡，时听白猿啼。\n野竹樊蕉径，脩桐间茗畦。\n傥容分席地，便此卜幽栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忠文洪相公挽辞 其二","author":"释文珦","text":"盛德归冥寞，斯文转寂寥。\n声名昭信史，功业在清朝。\n遗表祈天切，忠魂入地遥。\n九重思亮直，应作楚辞招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忠文洪相公挽辞 其一","author":"释文珦","text":"间气钟河岳，深衷悟冕旒。\n雄文惊万古，劲节凛高秋。\n清庙弦何绝，明堂柱不留。\n我生蒙许与，洒泪莫能休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"放吟","author":"释文珦","text":"心绝驰竞如安流，身逃系属同虚舟。\n无车每每跨黄犊，有暇时时盟白鸥。\n随分嬉游随分乐，可曾计较可曾愁。\n老吟亦不记声律，乱写孟郊沙井头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"放浪","author":"释文珦","text":"放浪一虚舟，江湖七十秋。\n见闻遗耳目，生死付浮休。\n宁有机心在，唯同造物游。\n脱然人境外，无喜亦无忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"松屋","author":"释文珦","text":"试问青松若个栽，僧门祇向树边开。\n月明定有仙人过，露滴频闻野鹤回。\n千岁老根成虎魄，几寻枯干裹莓苔。\n住来自得清虚味，不管流光白发催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武康道中","author":"释文珦","text":"又过防风旧国西，客怀烟景两凄凄。\n青山环绕疑无路，白水分流尽入溪。\n竹外野祠荒甃缺，柳边渔户草庐低。\n萍蓬漂转成何事，不及林猿有定栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"物外","author":"释文珦","text":"物外烟霞古，幽深断送迎。\n聩僧唯反听，啼鸟自春声。\n望岳山心静，临池水观成。\n岂知趋世者，终日但营营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"物我","author":"释文珦","text":"物我两俱忘，隤然入道乡。\n空为真命脉，静是悟肝肠。\n竹月光零乱，松风韵短长。\n色声皆妙契，曾不费思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"空山 其一","author":"释文珦","text":"深山一敝庐，今是几年居。\n举世皆嫌拙，吾心独有馀。\n寒苴珍芥酱，嘉核爱梅诸。\n樵父时同赋，多将槁叶书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"空中","author":"释文珦","text":"空中窴至理，彼我两俱忘。\n自有心如铁，宁嫌鬓似霜。\n清泉随涧远，古屋入云长。\n此是吾安处，陶然乐未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"空庐","author":"释文珦","text":"荒径草青青，空庐未始扃。\n好山皆在目，无事可劳形。\n已信虚空讲，何妨树石听。\n悠然朝复莫，真道自相冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苕溪夜泛","author":"释文珦","text":"萍踪人泛清苕去，水宿风餐几度经。\n结网灯沈渔浦雾，待艐船泊酒家亭。\n树头栖鹭疑残雪，草上流萤似乱星。\n夜后梦回寒月上，棹歌声里弁山青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苦雨","author":"释文珦","text":"秋雨连三月，愁吟野水濆。\n渐看禾黍没，难使渭泾分。\n山泽才通气，天霄便作云。\n民忧昏垫苦，苦语不堪闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茅茨 其一","author":"释文珦","text":"千重青嶂底，坐卧一茅茨。\n栖息今成乐，兴亡总不知。\n林居独脚鬼，壁画九头龟。\n自是山林样，休嫌欠入时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"茅茨 其二","author":"释文珦","text":"茅茨住得安，何必府潭潭。\n省祸由知足，防心在不贪。\n衣荷同纩暖，食檗比饴甘。\n清苦人休讶，山翁已惯谙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊行","author":"释文珦","text":"陋室随缘住，空山信意行。\n何须称隐逸，且复谢将迎。\n古木青猿性，孤烟白鸟程。\n由来各有适，岂必用浮名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郊行遣兴","author":"释文珦","text":"节序易推迁，行行感暮年。\n麦云黄冒陇，柳浪绿浮川。\n倦鸟犹知返，飘蓬最可怜。\n故乡无旧业，何计赋归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"采菖蒲","author":"释文珦","text":"雁荡高寒处，穿云采得来。\n岂能同野草，容易有花开。\n瘦节偏宜石，纤丛不受埃。\n幽人知尔性，晓涧汲泉杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓台","author":"释文珦","text":"世祖龙飞日，玄纁起故人。\n荣名既无取，閒足固应伸。\n钓石关乾象，江流入富春。\n高风千古在，来者自迷津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钓雪老渔","author":"释文珦","text":"彼渔者何人，莫是沧浪叟。\n万顷自清心，千山同白首。\n忘世但垂纶，得鱼唯换酒。\n醉后任扁舟，流到湘川口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨后寄侃直翁新行古","author":"释文珦","text":"相去亦不远，相寻殊觉难。\n一旬长苦雨，五月尚清寒。\n石屋深浮霭，山溪易作澜。\n今朝喜新霁，始得问平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨夜","author":"释文珦","text":"身同水上萍，老去尚飘零。\n远客人谁到，空床梦独醒。\n闪云双电紫，晦雨一灯青。\n慷慨长歌发，歌声入杳冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临安县","author":"释文珦","text":"霸业归王室，空城但黍苗。\n溪随山势转，路入市声遥。\n故俗多征敛，遗民尚寂寥。\n伤心到今古，祠树亦萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叙志","author":"释文珦","text":"夙了万缘空，年衰转更慵。\n梦身休化蝶，病耳畏闻蛩。\n野服萝堪制，山粮穄可舂。\n誓将云木友，怕与世人逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哀梅麓楼寺丞 其三","author":"释文珦","text":"寄酒全清达，论交不世情。\n远猷期变俗，直气反伤生。\n属纩无妻子，营坟尚弟兄。\n九原那可作，肠断买山盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哀梅麓楼寺丞 其一","author":"释文珦","text":"散逸羲皇上，风流晋宋间。\n金莲推寓直，玉笋竟虚班。\n名在方为重，身荣等是閒。\n知心千古月，耿耿照泉关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哀梅麓楼寺丞 其二","author":"释文珦","text":"道与时人背，多因得所深。\n文章千古印，忠孝一生心。\n棘冷难承泽，梅残祇在林。\n空门翻有泪，断断是知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哀理樗散","author":"释文珦","text":"樗散本灵种，根于广莫乡。\n繁阴深雨露，怪节老风霜。\n幸自忘封植，何须较短长。\n世交多未达，为子重悲伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"姚江舟中","author":"释文珦","text":"江潮远入河，几度此经过。\n浦溆渔船聚，泥涂蟹穴多。\n缠绵吴客恨，哀怨越人歌。\n一曲头堪白，频闻可奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"姚江舟中梦故人劝归","author":"释文珦","text":"一舸寒江上，萧萧两鬓华。\n不唯伤道路，终恐委泥沙。\n宿雨添山霭，秋风起浪花。\n故人应念我，梦里劝还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客中会友","author":"释文珦","text":"客涂方浩荡，岁物正萧条。\n相见江城暮，俱伤鬓发凋。\n阴云将变雪，寒水不成潮。\n明日还为别，离愁未易消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客里","author":"释文珦","text":"客里还惊节序还，倚阑搔首独凄然。\n垂开柳眼如相看，落尽梅花又可怜。\n幻境自知如梦蚁，离情几欲托啼鹃。\n数声忽听乌檐角，款曲吹残谷口烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客居","author":"释文珦","text":"借得空房住十春，野麋山鹿日相新。\n宁嫌老景犹为客，却喜闲身不属人。\n于转物时观世界，向无心处得天真。\n深居谢绝曾非傲，朽钝形骸畏屈伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客居阻雪","author":"释文珦","text":"客居还岁暮，风雪掩柴扉。\n人向行中老，乡从梦里归。\n繁声交涧竹，馀冷入山衣。\n消遣凭诗句，犹惭未入微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客袂","author":"释文珦","text":"客袂只翩翩，家林何处边。\n天寒愁远道，木落感衰年。\n惨澹渔村日，凄凉雁渚烟。\n秋来更多疾，空有梦归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"客游","author":"释文珦","text":"客游忘岁月，长是自调心。\n野水偏多浪，浮云易作阴。\n途穷何用哭，兴到即须吟。\n吟到忘言境，方谐正始音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"室空","author":"释文珦","text":"室空无侍者，坐卧一团蒲。\n但见朝还暮，焉知荣与枯。\n山心便寂寞，天籁听喁于。\n云外幽人好，时来问老夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽处","author":"释文珦","text":"幽处绝烦喧，白云常在门。\n高歌动涧壑，空境外乾坤。\n洗眼菖蒲水，轻身枸杞根。\n閒中存至乐，难与俗人言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽处","author":"释文珦","text":"恶圆难与俗浮沉，野处穷居岁月深。\n青嶂于予偏有分，白云嫌道太无心。\n人间富贵皆尘物，世外风泉是好音。\n老去翛然竟何事，若非入静即閒吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽怀","author":"释文珦","text":"野僧如野鹿，畏下白云层。\n迟暮知身幻，疏慵奈世憎。\n烟埋秋径竹，风闪夜堂灯。\n万事何须问，幽怀自可凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽步","author":"释文珦","text":"僻好唯泉石，深居任草莱。\n宁辞幽步远，且放好怀开。\n绿树莺求友，青坡雉应媒。\n因逢道人语，月出始能回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽谷","author":"释文珦","text":"幽谷寒偏早，初秋御裌衣。\n山田禾未熟，径树叶先飞。\n涧浅樵夫涉，篱疏野鹿归。\n不嫌生计薄，且与世人违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽程","author":"释文珦","text":"幽程宁惮远，野外意无穷。\n山叠高低古，川流宛转通。\n采芝随羽客，拾橡共狙公。\n烂熳游三日，尘劳顿觉空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"持律僧","author":"释文珦","text":"坚持先佛戒，不染世间缘。\n过午都忘食，终年只坐禅。\n可曾焚蠹木，长是滤虫泉。\n何日能相见，同君话五篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日","author":"释文珦","text":"春泉青似淀，春嶂碧于螺。\n远近随吾意，芒鞋幽兴多。\n人生行乐尔，富贵复如何。\n难与时人道，风前独放歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日怀人","author":"释文珦","text":"林岭春云满，陂湖春水多。\n旧乡书不到，久客意如何。\n老去长牢落，悲来一啸歌。\n故人今在否，相忆梦青萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日病起","author":"释文珦","text":"暮景交朋尽，何人问死生。\n卧于蜗室底，看得鹊巢成。\n缘绝门常静，心空疾渐平。\n又思扶杖出，溪上听泉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春尽日","author":"释文珦","text":"春去无缘得暂留，意行晓到古原头。\n落花随水如多怨，老柳因风不奈愁。\n鹃声作意归何许，蝶梦无凭觉即休。\n林叟相逢俱一笑，都缘彼此是同流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春谷","author":"释文珦","text":"春谷行难尽，鸡声忽一家。\n溪流随雨涨，崖树受风斜。\n竹地偏生菌，桐阴正养茶。\n老翁年八十，不识有纷华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春夜梦中得观与心为度身将世作仇一联既觉而足成四韵寄修观者","author":"释文珦","text":"高人持远流，净行在林丘。\n观与心为度，身将世作仇。\n不曾过午食，常满六时修。\n苦海人求度，师应驾法舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春游","author":"释文珦","text":"风和宿雨晴，幽屦出柴荆。\n好鸟各相语，野花如有情。\n心閒何用隐，身健岂须名。\n今日不行乐，真成孤此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柘溪道中","author":"释文珦","text":"荒烟迷小市，细雨隔遥津。\n麦浪农畴晚，桐花客路春。\n几番时序换，两鬓雪霜新。\n唯有溪边鹭，相看似故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柳下吟","author":"释文珦","text":"娿娜绿杨阴，深于夏屋深。\n居来身自在，胜与俗浮沉。\n坐暑堪忘箑，乘风或散襟。\n清閒消不尽，乞与野莺吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"残灯","author":"释文珦","text":"残灯闪闪青，蟋蟀怨空庭。\n骨老似难睡，梦寒还易醒。\n凄凉生倦枕，沆瀣入疏棂。\n起视东方白，唯馀三两星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"残夜清坐","author":"释文珦","text":"壶更犹未彻，起坐看萤流。\n夜气清如水，禅心淡似秋。\n月沉西岭树，钟动上方楼。\n可有昏冥者，知吾所得优。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洞霄宫","author":"释文珦","text":"山势逶迤九锁分，洞天终自异人群。\n君王在昔曾游幸，故老犹今述见闻。\n瀑溅鹤衣明似雪，气蒸龙穴暗成云。\n梦回髣髴鸣笙磬，定有游仙拜老君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"看月","author":"释文珦","text":"静室焚香罢，间吟倚石栏。\n忽从青玉峡，涌出白银盘。\n列宿消芒尽，清晖照胆寒。\n终宵不成寐，二十四回看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"看新历","author":"释文珦","text":"又看景定新颁历，百岁还惊五十过。\n忆昔壮怀多旷远，只今衰鬓已蹉跎。\n飘零世路饶荆棘，展转归心念薜萝。\n春草夕阳江上去，不堪回首一长歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋分前三日偶成","author":"释文珦","text":"秋光几一半，在候已无雷。\n颢气凝为露，嘉禾秀出胎。\n燕衔馀暑去，虫唤嫩寒来。\n泡影非能久，流光又苦催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日","author":"释文珦","text":"秋气清如此，閒踪信所如。\n因穷流水脉，偶到野僧居。\n地远嚣纷息，山回响答虚。\n几人来不得，老死向尘车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日怀新敬二上人","author":"释文珦","text":"所知惟二仲，不见意何如。\n别后云山阻，传来信息虚。\n黍粱收露下，草木变霜馀。\n应有悲秋作，何曾一寄予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日禅房","author":"释文珦","text":"绝巘秋光里，禅房夜气清。\n天风吹鹤梦，山月照猿声。\n性懒诸缘绝，身閒四体轻。\n生来自萧散，不是彊遗名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋江独泛","author":"释文珦","text":"秋波无际远，短艇溯寒江。\n风景由来异，乡心未易降。\n晚烟生驿树，空翠扑船窗。\n赋得沧浪曲，长谣不便腔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋声","author":"释文珦","text":"商飙何厉疾，群籁尽嚣嚣。\n回穴生崖谷，淜滂度泬寥。\n恍疑沙漠战，误听浙江潮。\n遮莫频相聒，羁魂易得消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋怀","author":"释文珦","text":"寂寥谁共语，白发对寒流。\n往事浑疑梦，馀生祇似浮。\n青虫鸣向夕，玄鸟去因秋。\n故友沧江外，茫茫不可求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋怀","author":"释文珦","text":"西风吹客襟，客正白头吟。\n无复欢娱意，惟伤迟暮心。\n饮虹明远浦，饥鹘下荒林。\n日月不相贷，人生那易禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夜忆兄","author":"释文珦","text":"石房清睡熟，犹拥黑貂裘。\n乡远难为梦，山深易得秋。\n脊令空在咏，蟋蟀暗生愁。\n何日潜溪岸，吟诗共倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夜月下独吟","author":"释文珦","text":"看月倚修桐，寥寥夜正中。\n西郊金气肃，南陆火云空。\n绕树徒怜鹊，传书未有鸿。\n浩歌谁与和，禅意自相通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋野即事","author":"释文珦","text":"深原草径斜，烟际两三家。\n老屋门无钥，清溪底见沙。\n断蝉嘶败柳，孤蝶恋寒花。\n历省曾游处，分明似若耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]