[{"title":"茂书记归闽 其二","author":"释居简","text":"淡学梅花不受妆，酷嫌脂泽缀词章。\n汉妆更在青山外，留得华风管暗香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28820,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苕溪新上人石窗","author":"释居简","text":"太白岩空夜弗扃，好风不约满疏棂。\n旧题寂寞无人管，散作苕溪水上云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28821,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"顾寺簿云伯挽章","author":"释居简","text":"黄岩二松下，别调听新吟。\n寻说丑羊去，寄声双鲤沉。\n班空华玉笋，弦绝断文琴。\n宿草春重绿，伤心日更深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28822,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"施当涂东洲见寄","author":"释居简","text":"骚吟富名流，东洲敏风雨。\n小低演纶手，联作石鼎语。\n真龙得人畏，况复射真虎。\n妖踪与怪迹，三舍亟避去。\n出如一角麟，贵若五色羽。\n不然六月息，扶摇快抟举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"长兴赵可斋辟扬州别驾","author":"释居简","text":"清俯箬溪流，裴回水上楼。\n同心独陈桧，别乘半扬州。\n斗酌江分暝，轮空月碾秋。\n琼花难驿寄，花露记珍投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漫塘名陈内机小斋曰能止","author":"释居简","text":"莫窥殽与函，峭绝青错磨。\n可无济胜具，振衣披峨峨。\n更复游吕梁，虎眼漩作涡。\n堂堂济深涉，如此忠信何。\n游子听我语，审听毋媕婀。\n通都横九逵，平平非仄颇。\n并驾方峥嵘，辐辏相骈罗。\n嗜进弗知了，十步九跌蹉。\n何如反吾辕，自少不自多。\n怡然事天全，盎然毓天和。\n倦翼安故林，归云仍中阿。\n晓猿时自吟，好鸟时自歌。\n凉树坐茂密，醉石眠坡陁。\n何须鹑奔奔，静胜超凡科。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"船窗蕙萱 其一","author":"释居简","text":"国香旖旎霣林扉，依约华风变雅迟。\n写出一茎三四萼，紫毫零瀣冷涵滋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"船窗蕙萱 其二","author":"释居简","text":"小试凉薰四月初，芳心曾不与春疏。\n是中可托忘忧地，看睡鸳鸯傍母雏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28827,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"瑞香","author":"释居简","text":"谱上先题五老名，宫袍云锦旧为邻。\n华风似惜诗人老，一样裁成紫绮新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28828,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月丹","author":"释居简","text":"展样山茶染不如，宫黄齐撚牡丹须。\n不忺宿雨曦晴露，玉袖垂红护绛襦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28829,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曹提举荣上","author":"释居简","text":"乡也才聆謦咳声，暗中摸索认轮囷。\n故家大雅元戎老，词学清流使节新。\n直指大门标俗子，莫嫌高贾著山人。\n紫荷琳馆君诸父，说项斯贤不厌频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28830,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颜提举之官","author":"释居简","text":"兰陵曾颂邻州政，除却龚黄总不如。\n又似澄江千尺练，只传陋巷一编书。\n坐令季子昌遗俗，尽道丹山更好雏。\n老我林泉散樗栎，守愚终不与贤疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28831,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠日本国僧顺侍者","author":"释居简","text":"粟散王都藐莫知，星分棋布海中泜。\n三韩未远须重译，九土虽中共秉彝。\n但见神僧巍跨水，弗闻君子陋居夷。\n由余季札高千古，更复区区桀蹠为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28832,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"葛仙迁居图","author":"释居简","text":"欲问丹砂不定居，绝怜岣嵝令君疏。\n弗教鸡犬蜚腾去，犹看随行挂角书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈刑书问近况 其一","author":"释居简","text":"孤风晋东土，宿望鲁灵光。\n迹恨山林阻，精驰研席傍。\n环中枢待转，水上玉生凉。\n一点华风在，看看动八荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈刑书问近况 其二","author":"释居简","text":"万卉竞春新，孤芳见老成。\n斗高纷晓蝶，递巧响乔莺。\n山染眉津绿，湘澄眼采明。\n东山谢安石，深意在苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28835,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"洪御史","author":"释居简","text":"山林色色昧讲明，不识更化云胡更。\n或云乡来立仗马，画然勇作朝阳鸣。\n邕邕逸响犹在耳，宠以官名只三字。\n昔人谩煮水银银，妄冀锱铢相比类。\n衮衮王言独超绝，盘诰丁宁古无别。\n眼两腰重不自荣，回向高堂一簪雪。\n只今又上四紧头，准拟钧天侍冕旒。\n弹压风烟看制胜，取之左右皆相应。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28836,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄蔷薇","author":"释居简","text":"窗风一线度晴熏，晚韵繁香态度新。\n亲压屠苏湛华玉，古壶斜插浅浮春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28837,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中","author":"释居简","text":"物华雨后各矜晴，红得晴多绿便争。\n未与东风写怀抱，绵蛮已作送春声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28838,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苏叔党所作兰蕙","author":"释居简","text":"风雅传衣到小坡，笔头分外得春多。\n佩寒帐冷空遗恨，澹写孤芳续九歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28839,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"云山道人榴桃橙橘戏墨","author":"释居简","text":"造化工夫竟属谁，墨花岂恨子生迟。\n海榴不与山桃约，趁得橙黄橘绿时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28840,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次陈中书木犀韵","author":"释居简","text":"一枝开月蕊，万粟蜕风埃。\n我欲乘风去，君须采月来。\n降真当换骨，甲第合班梅。\n蔌蔌都吹了，分香到绿苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28841,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬宁国陈中书劝耕","author":"释居简","text":"深阒禅扉未扣关，先将鸾尾扫层峦。\n贵于步屧狂工部，健胜游山老谢安。\n静里韶华天宇大，笑中耆艾酒尊宽。\n独馀缱绻林泉思，更为山红小倚阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28842,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"包氏卧虎图","author":"释居简","text":"猿臂将军死弗侯，发机百中巧无酬。\n不逢肉醉眠山路，饮羽空嗟老石头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28843,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"廉上人得玄晖活法","author":"释居简","text":"微抹岑楼不见尖，澹迷山阁不蜚檐。\n一从蒙澒云收后，活法知谁付阿廉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28844,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"破琴行","author":"释居简","text":"轸折徽残弦索乱，贴壁缘空暗尘满。\n历声爆得黑髹皴，蛇腹庚庚成百断。\n爨痕孰辨赝与真，古已往矣思古人。\n木虽就槁声不槁，老龙弗吟谁解听。\n得时郑卫嘈杂鸣，泯默韶頀瘖咸英。\n南风不竞愠若酲，林林俚耳安知此。\n寰天满地浮俗子，还我知音子钟子。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28845,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李帅新创溪山真趣","author":"释居简","text":"动者智之机，惟仁与静宜。\n天开真个画，谁识自然诗。\n水与云相友，鸥驯鹭不疑。\n终南讥捷径，有耳怕闻知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28846,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大洞","author":"释居简","text":"才入肤生粟，炎炎伏暑前。\n凹中元有路，虚处岂无天。\n待扣钟非簴，将崩石架船。\n蜿蜒毋熟寐，我欲庆丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28847,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"续王黄州四皓赠答 其一","author":"释居简","text":"遮得冥冥翼，谁云汉网宽。\n劫谋飞隼疾，克爱拔山难。\n旒恐悬中断，盂从覆处安。\n不如甘嫚骂，莫受子房谩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28848,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"续王黄州四皓赠答 其二","author":"释居简","text":"白眼看隆准，悠然见屈伸。\n奇功巍弗处，峻节退无邻。\n用则王非伯，潜嗟汉不纯。\n虽亡秦日月，犹是避秦人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28849,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用前送行韵寄赵编修可斋","author":"释居简","text":"烁石与金流，怀人眺晚楼。\n忽闻提健笔，喜似得神州。\n稻粒不多日，窗疏相次秋。\n只分千里月，木李不中投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28850,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄盘隐府判","author":"释居简","text":"闲把新抽粉节题，疾邪字字赋心思。\n溺非袖手无遗援，虐是专门忍助为。\n山下水流花尽处，人间豕燎虱焦时。\n盈虚消息还来复，六月扶摇岂远而。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28851,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祠山解后陈舒州","author":"释居简","text":"盍步花砖草制书，尚烦丐外替中除。\n肯堂肯室五经笥，难弟难兄三凤雏。\n家学不逃钟鼎贵，野情弗与隐沦疏。\n乾坤肯负真宏博，聊为斯文发绪馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28852,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伯时二马 其一","author":"释居简","text":"刁斗无声苜蓿秋，不知猿臂未封侯。\n尚堪汗滴沙场血，花结青丝恨络头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28853,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伯时二马 其二","author":"释居简","text":"市骏爰从画骏谋，何如脱鞅纵骅骝。\n青青许负双眸子，不识骅骝只相牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28854,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"佛国白赴召刘侍郎无言与诸贤作供于报恩题壁以纪傍有隆茂宗所作古木怪石","author":"释居简","text":"白也度苕溪，诸贤重挽携。\n金刀眷良集，铁画粲芳题。\n神护藏书壁，鸿留印爪泥。\n阿隆霜干老，附并薄云霓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28855,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"状元袁府判作诗赠王司理其略云简川号工诗只今在市廛试呼一问之参寥师孰贤王索答酬以四十字","author":"释居简","text":"籍甚参寥子，临平破夏归。\n弗经人道语，肯落箭锋机。\n盘走珠无定，泥沾絮不飞。\n长公归玉局，千载赏音稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28856,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送伊侍者归嘉兴","author":"释居简","text":"伊才十二三，便学善财参。\n讳懒偏晨起，忘眠听夜谈。\n阮贫居道北，符学近城南。\n已壮贫如我，青青看出蓝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28857,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古松下禅僧图","author":"释居简","text":"眼明千载老风烟，幽思悠然喜欲颠。\n疑在浣花诗里见，只无松子落僧前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28858,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"米家平远","author":"释居简","text":"树岂无根瘦立，云疑有蒂慵飞。\n好处不经人道，一家父子传衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28859,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻曹侍郎讣唁太博大孝","author":"释居简","text":"去酌孤山六一泉，吟邀两衲簉诸贤。\n郎君拾芥登科后，老子惩奸去国前。\n鬓自侍郎班里白，官从天子学中联。\n半轮不死峨眉月，还乡沧浪阔处圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28860,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄真尚书","author":"释居简","text":"京索风烟一日还，东山起了到西山。\n应知雅量浑相似，默蕴沉机只等闲。\n棋妙胜于淮上捷，扇轻铭露管中斑。\n共为天下苍生贺，不为苍生亦破颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28861,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪林李兄偕昌国长之官","author":"释居简","text":"潮涨家门雪，无风亦震雷。\n饱帆蜚百尺，饥蜃吐丛台。\n绡展洴鲛室，珠明剖蚌胎。\n春城种花地，冷帐小蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28862,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵左厢再荐","author":"释居简","text":"勤苦佐丰年，成功只听天。\n聊挥数寸管，不费一文钱。\n灯娄层葩剪，杨曾百步穿。\n宗藩大廷对，可惜两名先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28863,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"多景楼","author":"释居简","text":"好山可是登临少，此地云胡应接多。\n天自有初恢壮观，人非无故辄悲歌。\n烟收三面平开镜，雨后双鬟对绾螺。\n欲辩南徐古徐话，忍将名刻细摩挲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28864,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"很石","author":"释居简","text":"石很与孙俦，安知很易柔。\n借州托强援，归妹叶奇谋。\n蜀相死犹胜，晋宣生可偷。\n吞吴恨如海，微意似尊周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28865,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蔡山在江阴北湖西相传是蔡邕伯喈墓","author":"释居简","text":"身与东都孰重轻，至今犹擅蔡山名。\n四围深堑方方禁，千古英词凛凛生。\n汉鼎已归曹马手，胡笳犹播管弦声。\n传家更有柯亭竹，曾作岐阳老凤鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28866,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三高亭","author":"释居简","text":"雪滩祠三高，高字累三子。\n故夫三子者，凛凛元不死。\n西风动归思，不与歌散殊。\n用则谋人国，不用沦江湖。\n名节照勋庸，人与秋容洁。\n浩然天地中，朣朣湛华月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28867,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"虎丘","author":"释居简","text":"门掩怕山移，棱棱塔填攲。\n断崖抽晓碧，死草借春滋。\n地狭楼蜚巧，云低屋跨危。\n雨花台上石，不似点头时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28868,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"剑池","author":"释居简","text":"云根无底窦，或谓水通溟。\n下瞰几千尺，高标第四名。\n鬼题孤独字，剑沕属镂精。\n翠秃青残处，黄州旧勒铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28869,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二月十五陈枢密席上","author":"释居简","text":"上苑春常早，北海尊难老。\n朝来清镜中，满镜朱颜好。\n回观斗以南，如此能几翁。\n秉彝固全德，数量齐崆峒。\n坐寝淮南谋，俯视汲长孺。\n凛然老精神，折冲在尊俎。\n吟律行师严，四海岩岩瞻。\n莫袖春风手，脍炙天下口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28870,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"种梅","author":"释居简","text":"一枝春种水仙兄，著子先调老菜羹。\n鼎铉工夫求近效，怕难得似黑衣卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28871,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"槃隐","author":"释居简","text":"考得幽栖地，怡然胜美除。\n未归已彭泽，不梦亦华胥。\n绿绕清分远，红稀碧间疏。\n渔樵莫争席，不是野人居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28872,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋壑","author":"释居简","text":"泠风在怀袖，何必借商弦。\n就下识天巧，适安忘地偏。\n寒泓嫌雪暖，秋草似春鲜。\n见说蓬莱远，依稀拄杖前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28873,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋壑亲迎","author":"释居简","text":"龟筮从元吉，征车庆礼成。\n骎骎近七夕，脉脉耿双明。\n羽饮黄金的，云翻紫玉泓。\n扇鸾蜚翰墨，谁不解卿卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28874,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王神童","author":"释居简","text":"夙慧虽无蒂，抽萌便不凡。\n兰薰腾玉砌，侯国荐冰衔。\n荷橐行须复，牙签尽疗馋。\n一经千佛字，先把客儿搀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28875,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杜鹃花","author":"释居简","text":"染得深红剪万葩，春归独自绚韶华。\n丁宁莫受西风误，误使人看顷刻花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28876,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丘监丞入新宅","author":"释居简","text":"朝日乌爰止，东家喜可占。\n槐阴随旧砌，柳色动新檐。\n图史虽添富，田园仅养廉。\n清才少閒日，那复久相淹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28877,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"为老僧化衣褐","author":"释居简","text":"淅沥寒生菡萏池，雪残老藕不成丝。\n老僧岁晚无衣褐，却遣灵均去问谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28878,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"木犀著雨","author":"释居简","text":"拟续小山吟，庭犀渍弗禁。\n再花仍剪剪，十日苦涔涔。\n堕砌金难燥，随沟玉不沈。\n安知广寒殿，几日扫重阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28879,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"木犀得晴","author":"释居简","text":"宿翳开新霁，繁枝耀浅黄。\n还如醒滞思，又似整残妆。\n碎影仍多态，晴天别是香。\n坐分花下石，勺月荐深凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28880,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中中秋","author":"释居简","text":"楼外与楼头，无如一叶舟。\n风轻随月走，江远与天流。\n好是今宵满，新于曩日修。\n水云相汗漫，襟袖独飕飗。\n皓采通千隙，寒芒洞六幽。\n无枝空绕鹊，有约不惊鸥。\n汉掌仍承露，秦貂未换裘。\n弗须占蚌腹，已自压江楼。\n欲放仪邻老，长随蟾兔游。\n一年看晦朔，终不似中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28881,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"灵岩","author":"释居简","text":"断崖苍玉削，四绕绿屏帷。\n无港不相接，有山如此稀。\n树秋连石瘦，云晚截湖归。\n一点西风急，籧篨相趁飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28882,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夫差避暑宫","author":"释居简","text":"天堑连天付水犀，离宫表里万山围。\n越帆直指吴松落，犹在娃宫醉不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28883,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枫桥夜泊","author":"释居简","text":"谁遣蒲牢吼夜阑，玉虫剪尽玉脂乾。\n高山流水易为赏，求赏此声人独难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28884,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书云后三日游致道观","author":"释居简","text":"九日同游柱史家，野英羞涩未成花。\n重来又是书云后，刚德才抽四日芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28885,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬钟省元","author":"释居简","text":"东华肥马尘，隽游浩如海。\n择交如观澜，涤濯百谷濑。\n一瞬判清浑，三舍避狷怪。\n膝耻望尘金，簪愧侧冠玳。\n四三成朋曹，千百繁行辈。\n爬搔甚翎羽，嘲?赴笼械。\n弗与众接畛，亦复远分界。\n知音丈人后，有玉无善价。\n哦诗山月倾，奏赋金马待。\n青钱不俟选，白眼又焉浼。\n采笔虽暗投，雪曲获佳配。\n朋来得分赏，客去但独对。\n鲜明云锦囊，名氏擅先载。\n坛想陶谢登，盟忆曹刘会。\n所交贵同德，所赠胜杂佩。\n一夔未鸣韶，族庖已芒背。\n悲凉吊楚骚，慨慷唁齐薤。\n宁方不为卿，至圆在其内。\n圆方为时中，俱付形骸外。\n三千风月篇，纷纷课谁最。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28886,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]