[{"title":"循资赵宰有贺诗次韵三首 其二","author":"陈造","text":"蒿帛入门无几润，妻孥食粥有馀清。\n轻肥腾趠非吾愿，矻矻雌黄且课程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"循资赵宰有贺诗次韵三首 其一","author":"陈造","text":"宦涂跛鳖陵坡上，学舍寒蝉饮露清。\n蹩躠强颜才跬步，不应天骥与论程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景安和章来再次韵谢设醴四首 其四","author":"陈造","text":"拜赐清诗醒醉昏，恍如帝所听新翻。\n君才炙輠无穷尽，未敢先关月下门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景安和章来再次韵谢设醴四首 其三","author":"陈造","text":"玉盘盂侧玉为人，插羽瑶觞不计巡。\n想送客归回醉盼，司花来梦斗精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景安和章来再次韵谢设醴四首 其二","author":"陈造","text":"道装人映醉中姝，十二分行俨翠裾。\n遥想翻阶丽清禁，似今群艳簉庭除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"景安和章来再次韵谢设醴四首 其一","author":"陈造","text":"朅来取友得三贤，安石仁风乐广天。\n七字不应呈此拙，诗肠老去已枵然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山阳十首 其十","author":"陈造","text":"熙台楚观小开樽，老去登临易断魂。\n蹀血龙荒平昔志，即今搔首望中原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山阳十首 其九","author":"陈造","text":"刘伶台畔酹金卮，寂寂荒丘带晚晖。\n今日先生不能饮，妇言屏弃未为非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山阳十首 其八","author":"陈造","text":"多许金钗换好辞，长巾短帕缕金泥。\n老来诗力知何似，细访香罗验旧题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山阳十首 其七","author":"陈造","text":"会看亭下水涵空，菡萏香中理钓筒。\n北道主人吾有托，不应独飨北窗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山阳十首 其六","author":"陈造","text":"高郎胸次著潇湘，亭枕城闉野趣长。\n我欲亭西分一曲，白鸥波外自鸣榔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山阳十首 其五","author":"陈造","text":"故人不复倒奚囊，但有荒阡荫白杨。\n魂定可招吾得已，试吟楚些命巫阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山阳十首 其四","author":"陈造","text":"玳筵当日小红裳，珠压双丫十岁强。\n回首方知但青子，胡琴声里怨茶商。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山阳十首 其三","author":"陈造","text":"官池二十四鸳鸯，锦綵争鲜伴醉狂。\n翡翠有儿知更好，几时飞到酒樽傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山阳十首 其二","author":"陈造","text":"邗沟帆席即长淮，鬓未霜时惯往回。\n绛县老人今若此，此生更复几番来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游山阳十首 其一","author":"陈造","text":"山阳城外舣舟初，先问黄公旧酒垆。\n空有向来觞咏意，岁华不贷白髭须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游灵山二首 其二","author":"陈造","text":"何年山股创禅房，陵谷迁移不易量。\n旧日中流小浮玉，如今欲到祇褰裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游灵山二首 其一","author":"陈造","text":"高人避俗水云居，客子偷闲簿领馀。\n本自毗耶病居士，不妨僧饭小躇蹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游隐静往反四首 其四","author":"陈造","text":"梦觉篝灯曀曀明，碧鸡啼罢欲三更。\n定知山雨阵头恶，但怪瀑声雷样鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游隐静往反四首 其三","author":"陈造","text":"一随俗驾走红尘，松竹生愁鹤怨人。\n杯渡老师相悉否，野僧心地宰官身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游隐静往反四首 其二","author":"陈造","text":"烟树云生若有无，行舆咿轧路盘纡。\n小风弄雨晴还落，身在龙眠水墨图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游隐静往反四首 其一","author":"陈造","text":"突兀南山万仞青，餍观山顶白云生。\n今朝访道五峰去，却向白云生处行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游普向十首 其六","author":"陈造","text":"寺壁龙蛇石刻新，夔州十绝典刑存。\n鹅溪为卷湖山去，拟与诗人到处论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游普向十首 其五","author":"陈造","text":"日冒风埃鬓脚黄，归怀绊骥可能忘。\n谁知碧岭苍云外，占断人间五月凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":18912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游普向十首 其四","author":"陈造","text":"齑盐未必劣僧蔬，尘里光阴易破除。\n他日摩肩霄汉上，却须此室与藏书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f7968