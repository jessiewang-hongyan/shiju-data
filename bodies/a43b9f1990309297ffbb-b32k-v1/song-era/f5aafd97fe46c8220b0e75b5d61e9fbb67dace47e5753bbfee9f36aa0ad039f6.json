[{"title":"训蒙绝句 西铭","author":"朱熹","text":"人因形异种私根，不道其初同一源。\n直自源头明说下，尽将父母属乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21326,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 仁二首 其一","author":"朱熹","text":"心无私滓与天同，物我乾坤一本中。\n随分而施无不爱，方知仁体合言公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21327,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 仁二首 其二","author":"朱熹","text":"义兼礼智由仁出，接物当先主在仁。\n方由四端随用发，譬之四序始于春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21328,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 居敬二首 其一","author":"朱熹","text":"大哉程子明居敬，千圣同符入德门。\n试把功夫横竖看，总来不出欲斯存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21329,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 居敬二首 其二","author":"朱熹","text":"但得心存斯是敬，莫于存外更加功。\n殷勤夫子明斯意，约礼之时已在中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21330,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 静二首 其一","author":"朱熹","text":"心惟动与静相乘，当静之时乃动源。\n所以功夫先要静，动而无静体难全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21331,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 静二首 其二","author":"朱熹","text":"莫专靠静偏于静，须是深加格物功。\n事到理明随理去，动常有静在其中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21332,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 致知","author":"朱熹","text":"此心原自有知存，气蔽其明物又昏。\n渐渐剔开昏与蔽，一时俱透理穷源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 克己二首 其一","author":"朱熹","text":"本体原来只是公，自将私意混其中。\n虽颜造圣无他事，惟在能加克己功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 克己二首 其二","author":"朱熹","text":"莫道公私未判然，自忧一日用功难。\n便随明处猛分摆，志在希颜即是颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 戒谨恐惧","author":"朱熹","text":"防欲当施禦寇功，及于未至立崇墉。\n常求四者无他法，依旧同归主敬中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 求放心","author":"朱熹","text":"不察予心重似鸡，更兼放处只缘私。\n才知用理维持际，不待追求便在兹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 下学上达","author":"朱熹","text":"学在事时斯是理，盍于事上每寻思。\n但令下学功夫到，上达之机便自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 夜气","author":"朱熹","text":"理则无形气是乘，气随夜息理斯存。\n息时无感犹当验，昼不能清夜亦昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 体认","author":"朱熹","text":"虽云道本无形象，形象原因体认生。\n试验操存功熟后，隐然常觉在中明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 唤醒","author":"朱熹","text":"为学常思唤此心，唤之能熟物难昏。\n才昏自觉中如失，猛省猛求明则存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 为人","author":"朱熹","text":"辛勤尽作求闻计，沽得过情声誉来。\n自外而观为可喜，此心已失实堪哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 三省二首 其一","author":"朱熹","text":"曾子尚忧三者失，自言日致省身功。\n如何后学不深察，便欲传心一惟中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 三省二首 其二","author":"朱熹","text":"用功事上实根源，三省真传入道门。\n理即是心随事显，事能尽理始心存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 十五志学","author":"朱熹","text":"工夫一进十年期，断自圣言当致思。\n岂不欲人跻圣速，只缘科级盖如斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 小学","author":"朱熹","text":"洒扫庭堂职是供，步趋唯诺饰仪容。\n是中有理今休问，敬谨端详体立功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 存心","author":"朱熹","text":"功夫但欲存心尔，底事存心条绪多。\n直使圣贤更剖析，只缘私意费消磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 养性","author":"朱熹","text":"性初不假增加力，养字原非别用功。\n只要关防并省察，莫要私意害其中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21348,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 心之官则思","author":"朱熹","text":"一身胡属此心微，只为能思择所为。\n底事虚灵成暗塞，独于物欲用其思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21349,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 莫知其乡二首 其一","author":"朱熹","text":"此心活动元无定，或出他乡入此乡。\n猛省不知谁是主，只因操舍有存亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21350,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 莫知其乡二首 其二","author":"朱熹","text":"存以公兮亡以私，存亡倏忽动时机。\n莫教事过方才省，辨析须严念虑微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21351,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 人心道心三首 其一","author":"朱熹","text":"自从载籍流传后，此是论心第一条。\n剖析精明为训切，如何心学尚寥寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21352,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 人心道心三首 其二","author":"朱熹","text":"因形与理别言心，其实随形有理存。\n才与理违形独用，便为物欲理皆昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21353,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 人心道心三首 其三","author":"朱熹","text":"莫道惟危便为恶，只缘众欲起于形。\n常须急把理来救，亦要少从危处行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21354,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 知天命","author":"朱熹","text":"假借立言虽似是，知非我出枉劳功。\n苟从立志循而得，方信真知味不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21355,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 古者以利为本","author":"朱熹","text":"论性无非日用间，何须虚诞与深艰。\n昭昭万事皆其理，只是功夫欲顺难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21356,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 参前倚衡","author":"朱熹","text":"理随心见不曾离，苟有斯心便在兹。\n果似有形君信否，用心熟后自能知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21357,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 汶上","author":"朱熹","text":"仕非其地宁无仕，此事还他德行人。\n彼以势邀吾自逝，丈夫无欲气常伸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21358,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 山径之蹊","author":"朱熹","text":"苟能用力可充微，一息昏忘功便亏。\n老矣方知深自警，几番茅塞径之蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 不能使人巧","author":"朱熹","text":"学求入处须师授，此外难为尽靠师。\n但向行时无息处，进前曲折自能知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21360,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 观澜","author":"朱熹","text":"眇然方寸神明舍，天下经纶具此中。\n每向狂澜观不足，正如有本出无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21361,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 良知","author":"朱熹","text":"孩提自幼良知发，此日心蒙尚未开。\n既壮蒙开趋物欲，良心反丧亦哀哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21362,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 动心忍性二首 其一","author":"朱熹","text":"不当拂处常逢拂，不合空时亦至空。\n处顺不如常处逆，动心忍性始成功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21363,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 动心忍性二首 其二","author":"朱熹","text":"困穷拂动虽天意，如舜何须增不能。\n上智虽明事之理，也须亲到事中行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21364,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 刍养悦口","author":"朱熹","text":"食中有味知斯悦，知是能加咀嚼功。\n行处心安思处得，馀甘常溢齿牙中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21365,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 先难","author":"朱熹","text":"为学须教效自形，但专一意使功深。\n哀哉狭隘频求效，仰止仁人后获心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21366,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 谨独","author":"朱熹","text":"为学无功由间断，其如间断费关防。\n方知谨独功诚切，多是此时心易忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21367,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 鸢飞鱼跃二首 其一","author":"朱熹","text":"此理充盈宇宙间，下穷鱼跃上飞鸢。\n飞斯在上跃斯下，神化孰尸本自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21368,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 鸢飞鱼跃二首 其二","author":"朱熹","text":"神化孰尸本自然，盍将此意反而观。\n试将事上深加察，才著些私便不安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21369,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 勿忘勿助长","author":"朱熹","text":"忘则无功助则私，不忘不助正斯时。\n是中体段须当察，便是鸢飞鱼跃机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21370,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 乐在其中","author":"朱熹","text":"夫子亦将贫对乐，只因人苦处贫难。\n苟非天理能攘敌，只向私心重处安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21371,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 不改其乐","author":"朱熹","text":"己私既克本心存，到处逢原与理行。\n不待有心求乐道，此心之乐自然生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 逝者如斯二首 其一","author":"朱熹","text":"如何物却能形道，只为皆存理一端。\n偶感斯川存动理，故言逝者可同观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 逝者如斯二首 其二","author":"朱熹","text":"岷源万古只如斯，东注曾无间断时。\n后学不因川上叹，安行体用亦难窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21374,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 牛山","author":"朱熹","text":"此心此理自天根，不待栽培触处生。\n只要关防人欲伐，更须著意察滋萌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21375,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 任重","author":"朱熹","text":"气无强弱志为先，努力便行休放肩。\n挨得一番难境界，便添脊骨一番坚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21376,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 万物皆备于我","author":"朱熹","text":"万物当须以理观，不离太极是其源。\n故须万类皆我具，只为中心太极存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21377,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 难言","author":"朱熹","text":"难言非谓不容言，谓状其中体段难。\n须是养成天地塞，却将正直反而观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21378,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 四十五十无闻","author":"朱熹","text":"圣人接物本于仁，罕以深言拒绝人。\n不足畏辞严且截，急将此意省吾身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21379,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 九思","author":"朱熹","text":"人之进学在于思，思则能知是与非。\n但得用心纯熟后，自然发处有思随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21380,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 辞达而已二首 其一","author":"朱熹","text":"方识圣门辞达旨，作文之法在其中。\n但将正意由辞出，此外徒劳苦用功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21381,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 辞达而已二首 其二","author":"朱熹","text":"因辞可以验人心，心地开明辞必明。\n试把正人文字看，何尝巧滞与艰深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21382,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 君子去仁","author":"朱熹","text":"谁云贫贱人难处，只为重轻权倒持。\n钓渭耕莘皆往辙，圣贤不法我何归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21383,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 就有道而正","author":"朱熹","text":"差以毫釐大乱真，苟羞就正堕终身。\n不惟枉费穷年力，反作滔天祸世人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21384,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 出门如见大宾","author":"朱熹","text":"竦然敬立体斯存，容貌常如见大宾。\n此是圣门持守法，必须心在可为仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21385,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 心有邻","author":"朱熹","text":"德者人心之所同，苟能有德类斯从。\n不须闭户嗟寥落，但立诚心自用功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21386,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 浴沂","author":"朱熹","text":"只就吾身分上思，相呼童子浴沂归。\n更无一点閒思想，正是助忘俱勿时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21387,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 言志","author":"朱熹","text":"莫道车裘事亦轻，仲由勇义乃能行。\n欲知共敝为难易，试把车裘验世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21388,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 斐然成章","author":"朱熹","text":"学须随器有成形，方可裁中设准绳。\n假借变移无定止，纵逢大匠亦何成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21389,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 安仁利仁","author":"朱熹","text":"语利犹能安则难，且从利做莫空安。\n悬知等级无他义，去尽私心只一般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21390,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 一贯","author":"朱熹","text":"一贯明言忠与恕，教人之意已昭然。\n当于用处求其一，慎勿悬空想圣贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21391,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 卓尔","author":"朱熹","text":"颜渊不日趋于化，此境宁容末学知。\n细诵师言强思索，独于博约语无疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21392,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 闻知","author":"朱熹","text":"见固能知闻亦知，虽闻如与见同时。\n只缘一本元无二，千圣已亡心在兹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21393,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 绝四","author":"朱熹","text":"在人四者要皆无，绝尽圣心天与俱。\n敢尔单提希圣术，力除私欲是功夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21394,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 莫我知也夫三首 其一","author":"朱熹","text":"心即是天天即理，无行不与理相随。\n故言惟有天知我，天岂真如人有知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21395,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 莫我知也夫三首 其二","author":"朱熹","text":"天怨人尤两不形，欿然下学是功程。\n了无可使人知处，尽是相酬理与心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21396,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 莫我知也夫三首 其三","author":"朱熹","text":"圣心端似涉修蹊，俛首无言但疾驰。\n学者须常存此意，自能遏绝为人私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21397,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 予欲无言","author":"朱熹","text":"妙道皆形日用间，即斯可见不须言。\n试将天象明人事，希圣功夫万古存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21398,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 吾无隐乎尔","author":"朱熹","text":"圣道虽云妙莫窥，初非恍惚与希夷。\n分明说在吾行处，后学无于行外思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21399,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 化二首 其一","author":"朱熹","text":"春冰融尽绝澌微，彻底冰壶烛万几。\n静对春风感形化，圣心体段盖如斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21400,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 化二首 其二","author":"朱熹","text":"从心所欲皆天理，具体颜渊罢不能。\n所谓不思并不勉，舜由仁义即非行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21401,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 吾知勉夫","author":"朱熹","text":"常怀四体昊天恩，自是渊冰恐惧深。\n一息尚存忧未免，死而后已即斯心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21402,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"训蒙绝句 博约","author":"朱熹","text":"事来身向礼中行，事过将心去学文。\n局定更无他罅隙，得斯二者老吾身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21403,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]