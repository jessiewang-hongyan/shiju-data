[{"title":"送白鱼","author":"李子西","text":"秋江水落白鱼肥，正是莼鲈入兴时。\n举网得鱼溪上路，挥毫走兔简中诗。\n雅知宾幕饶供给，何待侬芹荐敛私。\n鲁鬲楚鱼羞不腆，此诚只有孔门知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李子迁","text":"石鼎夜联诗笔健，布囊春醉酒钱粗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉楼春","author":"李子酉","text":"纱窗春睡朦胧著。\n相见尚怀相别恶。\n梦随城上角声残，泪逐楼前花片落。\n东风不解吹愁却。\n明月几番乖后约。\n当时惟恐不多情，今日情多无处著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏杨妃菊","author":"李山节","text":"命委马嵬坡畔泥，惊魂飞上傲霜枝。\n西风落日东篱下，薄倖三郎知不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"慧光寺 其二","author":"李山甫","text":"僧堂拂拭旧时尘，莺老花残五换春。\n四海干戈如鼎沸，山中犹有太平人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"慧光寺 其一","author":"李山甫","text":"梦游山寺有馀清，邂逅来游却自惊。\n珍重秋风知客意，又吹好梦到江亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题灵山寺","author":"刘恕","text":"早晚报衙蜂扰扰，友朋相和鸟关关。\n馀香满袖花惊眼，空翠沾巾雨暝山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和王漕使逵游麻姑山","author":"李山甫","text":"铃阁清虚刺史闲，廉车因得访仙山。\n旌旂飘缈烟霞外，冠盖追随水石间。\n丹井寂寥终古在，鸾骖怅望几时还。\n从来谢史留诗笔，今日遗风尚可攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题瑞相寺","author":"李山甫","text":"路入禅关僻，僧迎取衲披。\n自怜重到此，还忆旧游时。\n泉石清虚境，松筠古老姿。\n问师从此别，鹤驾几回知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同知县陈公彦游章山寺","author":"李山甫","text":"想见寻幽到此山，诗成珠玉笑谈间。\n莲花社里千年约，柏子香中半日闲。\n寂历松窗连远籁，萦纡竹径断荒湾。\n琴堂吏散帘垂昼，舁笋何妨数往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"禅窟寺","author":"李山甫","text":"迟日浓花午，闲云小阴天。\n半岩春洞水，万片晚林烟。\n惭愧华巅客，来分紫府仙。\n倚窗山竹夜，风溜响朱弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"李山甫","text":"多谢灞陵堤上柳，与人头上拂尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"凌云台","author":"李中立","text":"山围平野四回环，天迥台高眼界宽。\n云漏残阳明远岫，涛翻急雨涨前滩。\n一川胜趣四时好，千里雄风三伏寒。\n谁见凌云清绝处，夜凉空翠湿阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉别尧夫先生承见留数刻渍梅酒磨沈水饮别聊书代谢","author":"李中师","text":"磨汤渍酒重分携，景霁风和二月时。\n莫忘天津别君处，黄梅庭下半离披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送程给事知越州","author":"李中师","text":"出藩宠进白云司，台札仍欣得告归。\n苏子佩虎钮，腰龟緺，列城旗鼓随高牙。\n兰亭一水近馆娃，乃今衣绣先过家。\n秋风从此生蒹葭，舟五百里行荷花。\n西陵渡口晓㟏谺，飞楼想到期及瓜。\n恩先甘雨满菑畬，讼逐笔止庭不哗。\n秦山千仞高无加，昼望蓬莱挹仙霞。\n鉴湖万顷淼无涯，夜看牛斗乘星槎。\n平林摘笋崖撷茶，酒胾泉美而鱼嘉。\n醒吟醉墨斗天葩，此乐未可岁月赊。\n玉皇赭案香飘斜，匹马赴召且复挝。\n民贫惠政空叹嗟，重见尨眉出若邪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瓶花","author":"李云岩","text":"点检春风事，瓶花最可怜。\n本根不知处，犹自向人妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题桂殿秋辞 其一","author":"李仁本","text":"飞翠盖，走篮舆，乱山千叠为先驱。\n洞天迎目深且窈，满耳天风吹步虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小溪","author":"李介山","text":"东风满眼柳花飞，信步扶藜过小溪。\n淮甸凄凉春事少，楚天空阔暮云低。\n江山有意怜孤客，桃李无心恋故蹊。\n纵使有家归未得，数声蜀魄为谁啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅雨潭","author":"李介山","text":"灵源分左界，千仞落飞泉。\n散作一空雨，长如四月天。\n挂岩寒练直，溅席水珠圆。\n湫石龙应在，岩扉浮翠烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五马山","author":"李从训","text":"北山从何来，昆岷而鼻祖。\n并包河与江，考历不能谱。\n近推连括苍，继乃至天姥。\n既而南入台，盘桓遂东下。\n嵯峨起东峁，沃洲兀墙堵。\n孟塘五山顶，乐祖旧游处。\n时髦集松下，抵掌道今古。\n秀分为五龙，骈首饮平楚。\n环县如负扆，为县护生聚。\n隐岳耸其南，西隅列旗鼓。\n其间诸名流，晋宋最旁午。\n我惭貂尾续，于汝竟何补。\n登楼览清秋，黄菊满樽俎。\n持螯送新酒，醉为山起舞。\n人生行乐耳，无徒与羊祜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一丛花令/一丛花","author":"李从周","text":"梨花随月过中庭。\n月色冷如银。\n金闺平帖阳台路，恨酥雨、不扫行云。\n妆褪臂闲，髻慵簪卸，盟海浪花沈。\n洞箫清吹最关情。\n腔拍懒温寻。\n知音一去教谁听，再拈起、指法都生。\n天阔雁稀，帘空莺悄，相傍又春深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乌夜啼","author":"李从周","text":"径藓痕沿碧甃，檐花影压红阑。\n今年春事浑无几，游冶懒情悭。\n旧梦莺莺沁水，新愁燕燕长干。\n重门十二帘休卷，三月尚春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风入松 冬至","author":"李从周","text":"霜风连夜做冬晴。\n晓日千门。\n香葭暖透黄钟管，正玉台、彩笔书云。\n竹外南枝意早，数花开对清樽。\n香闺女伴笑轻盈。\n倦绣停针。\n花砖一线添红景，看从今、迤逦新春。\n寒食相逢何处，百单五个黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风流子","author":"李从周","text":"双燕立虹梁。\n东风外、烟雨湿流光。\n望芳草云连，怕经南浦，葡萄波涨，怎博西凉。\n空记省，浅妆眉晕敛，罥袖唾痕香。\n春满绮罗，小莺捎蝶，夜留弦索，么凤求凰。\n江湖飘零久，频回首、无奈触绪难忘。\n谁信温柔牢落，翻坠愁乡。\n仗玉笺铜爵，花间陶写，宝钗金镜，月底平章。\n十二主家楼苑，应念萧郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"抛球乐","author":"李从周","text":"风罥蔫红雨易晴。\n病花中酒过清明，绮窗幽梦乱于柳。\n罗袖泪痕凝似饧。\n冷地思量著，春色三停早二停。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玲珑四犯","author":"李从周","text":"初拨琵琶，未肯信，知音真个稀少。\n尽日芳情，萦系玉人怀抱。\n须待化作杨花，特地过、旧家池沼。\n想绮窗、刺绣迟了，半缕茜茸微绕。\n旧时眉妩贪相恼。\n到春来、为谁浓扫。\n新归燕子都曾识，不敢教知道。\n长是倦出绣幕，向梦里、重谋一笑。\n怎得同携手，花阶月地，把愁勾了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐","author":"李从周","text":"美人娇小。\n镜里容颜好。\n秀色侵人春帐晓。\n郎去几时重到。\n叮咛记取儿家。\n碧云隐映红霞。\n直下小桥流水，门前一树桃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐","author":"李从周","text":"东风无用。\n吹得愁眉重。\n有意迎春无意送。\n门外湿云如梦。\n韶光九十悭悭。\n俊游回首关山。\n燕子可怜人去，海棠不分春寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门","author":"李从周","text":"花似匝。\n两点翠蛾愁压。\n人又不来春且恰。\n谁留春一霎。\n消尽水沈金鸭。\n写尽杏笺红蜡。\n可奈薄情如此黠。\n寄书浑不答。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"李从周","text":"绿色吴笺覆古苔。\n濡毫重拟赋幽怀。\n杏花帘外莺将老，杨柳楼前燕不来。\n倚玉枕，坠瑶钗。\n午窗轻梦绕秦淮。\n玉鞭何处贪游冶，寻遍春风十二街。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮","author":"李元卓","text":"一枝绛蜡香梅软。\n宜春小胜玲珑剪。\n拂晓上瑶钗。\n春从鬓底来。\n菱花频自照。\n粉面惊春早。\n淡拂晓山眉。\n为谁今日宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再作十绝寄胡伯负兵侍仲方尚书 其三","author":"李元实","text":"官职庐陵不是无，文章更亦拟欧苏。\n若言直气横牛斗，但见人间说姓胡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再作十绝寄胡伯负兵侍仲方尚书 其九","author":"李元实","text":"东西两浙及闽川，皆见鸳行有直言。\n若我江西独钳口，澹翁九地也埋冤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再作十绝寄胡伯负兵侍仲方尚书 其七","author":"李元实","text":"绍兴秦桧秉洪钧，澹老昌言斩桧秦。\n犹恨日来三四子，抗章不说斩奸臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再作十绝寄胡伯负兵侍仲方尚书 其四","author":"李元实","text":"赤手批鳞事最难，况渠班底一微官。\n澹翁去后能如此，当作三生石上看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再作十绝寄胡伯负兵侍仲方尚书 其十","author":"李元实","text":"寄语朝家廊庙人，新州奇事又重新。\n肯甘富贵忘他底，应为斯人作好春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再作十绝寄胡伯负兵侍仲方尚书 其五","author":"李元实","text":"澹翁直气贯三才，入座云仍渐上台。\n料想而今闻底事，中心应亦念渠回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再作十绝寄胡伯负兵侍仲方尚书 其一","author":"李元实","text":"文昌武库九霄中，翁是新州老澹翁。\n应念象台今日客，清风端与我翁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再作十绝寄胡伯负兵侍仲方尚书 其六","author":"李元实","text":"朝行多少气英英，不怕霜朝曲嘴鹰。\n一网而今都打尽，庐陵人且说庐陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再作十绝寄胡伯负兵侍仲方尚书 其二","author":"李元实","text":"公家富贵足掀天，都出新州十九年。\n若念象台今日客，方知澹老子孙贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再作十绝寄胡伯负兵侍仲方尚书 其八","author":"李元实","text":"一从艺祖握乾符，元气都凭直气扶。\n若欲皇家宗社永，胡家直气岂容无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送胡季昭谪象州次王卢溪送澹庵贬新州韵 其二","author":"李元实","text":"清名传播到黄支，直节宁忧赵氏危。\n虎尾蹈时都不畏，象台到日大为奇。\n是行廊庙人皆怍，所过山川鬼亦知。\n官职本为锡底鸩，伤今正论有谁持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送胡季昭谪象州次王卢溪送澹庵贬新州韵 其一","author":"李元实","text":"知公不怕鬼门关，直气横干清禁闲。\n雕嘴明知林甫毒，鲠言要与澹庵班。\n一身渠任黄茆里，千古名标青史间。\n非晚清朝邪正辨，紫薇红药待君还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"一落索","author":"李元膺","text":"天上粉云如扫。\n放小楼清晓。\n古今何处想风流，最潇洒，龙山帽。\n人似年华易老。\n且芳樽频倒。\n西风于我更多情，露金靥，篱边笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞仙歌 其一","author":"李元膺","text":"廉纤细雨，殢东风如困。\n萦断千丝为谁恨。\n向楚宫一梦，千古悲凉，无处问。\n愁到而今未尽。\n分明都是泪，泣柳沾花，常与骚人伴孤闷。\n记当年，得意处，酒力方融，怯轻寒、玉炉香润。\n又岂识、情怀苦难禁，对点滴檐声，夜寒灯晕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞仙歌 其二","author":"李元膺","text":"雪云散尽，放晓晴池院。\n杨柳于人便青眼。\n更风流多处，一点梅心、相映远。\n约略嚬轻笑浅。\n一年春好处，不在浓芳，小艳疏香最娇软。\n到清明时候，百紫千红花正乱。\n已失春风一半。\n蚤占取韶光，共追游，但莫管春寒，醉红自暖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"茶瓶儿","author":"李元膺","text":"去年相逢深院宇。\n海棠下、曾歌金缕。\n歌罢花如雨。\n翠罗衫上，点点红无数。\n今岁重寻携手处。\n空物是、人非春暮。\n回首青门路。\n乱红飞絮，相逐东风去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二","author":"李元膺","text":"饮散兰堂月未中。\n骅骝娇簇绛纱笼。\n玳簪促坐客从容。\n已醉人间千日酒，赐来天上密云龙。\n蓬仙清兴欲乘风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一 咏掠发","author":"李元膺","text":"乞与安仁掠鬓霜。\n不须红线小机窗。\n剪刀疏下蜀罗长。\n纤手捻残针缕细，金钗翻过齿痕香。\n同心小绾寄思量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菩萨蛮","author":"李元膺","text":"彩旗画柱清明后。\n花前姊妹争携手。\n先紧绣罗裙。\n轻衫束领巾。\n琐绳金钏响。\n渐出花梢上。\n笑里问高低。\n盘云亸玉螭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蓦山溪 送蔡元长","author":"李元膺","text":"溪堂欢燕。\n惯捧玻璃盏。\n今日祖西城，更忍把、一杯重劝。\n别离情味，自古不堪秋，催泪雨，湿西风，肠共危弦断。\n夕阳去路，五马旌旗乱。\n便是古都春，应醉恋，曲江池馆。\n须知别后，叠翠倚阑情，青嶂晚，碧云深，日近长安远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天","author":"李元膺","text":"寂寞秋千两绣旗。\n日长花影转阶迟。\n燕惊午梦周遮语，蝶困春游落拓飞。\n思往事，入颦眉。\n柳梢阴重又当时。\n薄情风絮难拘束，飞过东墙不肯归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题武夷","author":"李公平","text":"溪头借得钓鱼船，又向山中觅洞天。\n闻道岩前有遗蜕，神仙飞去二千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万岁楼","author":"李公异","text":"万岁名虚得，兴亡已屡移。\n楼头秋夜月，当只似当时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"京口怀古 其一","author":"仲殊","text":"北顾横江尽，东南第一州。\n六朝都在望，回首倦登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"花山魏公园","author":"李公异","text":"当年花草径，满目旧林亭。\n无复东山妓，空门苔藓青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早梅","author":"李公明","text":"东风才了又西风，群木山中叶叶空。\n只有梅花吹不尽，依然新白抱新红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灯夕","author":"李公明","text":"江风淡淡放初晴，灯火明时月色明。\n谁信姮娥要行乐，随他女伴绕街行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芙蓉","author":"李公明","text":"野花能白又能红，也在天工长育中。\n长对秋烟颜色好，岂知人世有春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作 其一","author":"李公明","text":"石光火中寄此身，谁论北富与南贫。\n眼前正爱溪梅瘦，冰雪亭亭笑伴人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作 其二","author":"李公明","text":"天涯地角古来传，今在天涯地角边。\n日日江头望江水，蛮风瘴雨又凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓行青村","author":"李公明","text":"关关新鸟逐声啼，群鹭冲寒帖水飞。\n最恨山云去如织，不教春色着征衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过修诚馆","author":"李公明","text":"败馆冷如许，修诚志已非。\n风光不曾改，人事故相违。\n寸碧雪山出，争喧风叶飞。\n伤心旧时月，长是送人归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓烟","author":"李公明","text":"晓出倚溪亭，溪烟四面生。\n昏时山绿浅，浓处日红轻。\n簇簇树尤好，依依人未行。\n玄晖信萧放，澄练有佳名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿郑山铺","author":"李公明","text":"行役苦行役，凄凉应奈何。\n自从多事后，应恨一身多。\n草店张灯宿，石桥乘月过。\n曳裾悲我计，回首一烟蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大安人至","author":"李公明","text":"冻雨杂零雪，柴门不敢开。\n持来一片纸，说自大安来。\n元帅方归沔，边书又报阶。\n忍寒再三问，老弟几时回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中庸","author":"李公明","text":"要识中庸义，中庸乃是庸。\n不须求胜解，只此是奇功。\n卓卓孤峰上，明明百草中。\n若将声色舍，声色却盲聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木芙蓉","author":"李公明","text":"孤芳照寒水，婉娩自幽闲。\n万木碧无色，一花红独殷。\n秋莲多绿子，晚槿亦朱颜。\n却笑渊明宅，于今五柳残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":58535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]