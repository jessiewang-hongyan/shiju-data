[{"title":"仲钦寄民为重斋诗和答 其二","author":"张孝祥","text":"玉节南来两使星，埋轮折槛有家声。\n不嫌斋榜民为重，去国当时一叶轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲钦寄民为重斋诗和答 其三","author":"张孝祥","text":"德意丁宁到绿林，都捐刀剑作齐民。\n皇华入奏天颜喜，趁得朝元第四春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲钦寄民为重斋诗和答 其四","author":"张孝祥","text":"行边使者几时回，寄我清风欲满怀。\n已把十诗镌乐石，为公满意落新斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲钦寄民为重斋诗和答 其五","author":"张孝祥","text":"蛮烟瘴雨侵行李，每向南云有所思。\n定自为民忘涉险，请君细读寄来诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠圭老求竹","author":"张孝祥","text":"东窗便种千竿竹，准拟清风六月凉。\n传语报恩圭长老，相烦去作竹街坊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶得四月菊以奉提刑运使 其一","author":"张孝祥","text":"午阴篱落小裴回，底许清香鼻观来。\n定自霜台风力峻，故教霜菊暑中开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶得四月菊以奉提刑运使 其二","author":"张孝祥","text":"金缕裁衣玉缀裳，扫除瘴暑作秋香。\n一杯拟做重阳赏，更借西风一夜凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶得新茶献提刑丈既寿北堂太夫人亦可助齐眉之饷也","author":"张孝祥","text":"龙焙新春出尚方，细官佳句总堪尝。\n遥知举案齐眉处，再拜萱堂寿未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"郑义宁送莼菜","author":"张孝祥","text":"我梦扁舟震泽风，莼羹到箸晚盘空。\n那知岭海炎蒸地，也有青丝满碧笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠甘法曹","author":"张孝祥","text":"北岳仙人汗漫游，斯文曾到海边州。\n谁怜诗礼甘公子，牢落青衫向白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠刘全州子龟从兄弟","author":"张孝祥","text":"山到湘中青未了，月横岭北夜何其。\n问字刘郎能载酒，为渠更赋一篇诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和蔡济忠溪上","author":"张孝祥","text":"一潭秋水不见底，十里暮山无断头。\n长恨公馀过溪晚，放教明月上扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广右无笔刘子思携一束来择其尤者作字但如此它日中州有笔当爱惜也","author":"张孝祥","text":"刘侯赠我笔一束，笔锋如锥管如玉。\n不嫌夜艾剪银烛，为君一扫千兔秃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登七星山呈仲钦 其一","author":"张孝祥","text":"魁杓历历控云岚，地阔天虚万象涵。\n不与天公管喉舌，犹堪岳立镇湘南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登七星山呈仲钦 其二","author":"张孝祥","text":"便驱匹马出烟岚，圣主恩深若海涵。\n却到玑衡高处望，白云无数满江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿老迓使者以斋素不置饯 其一","author":"张孝祥","text":"火云飞电远连天，太息斋厨几不膻。\n定自随车有甘雨，为言星使早加鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寿老迓使者以斋素不置饯 其二","author":"张孝祥","text":"藩府东行迓绣衣，海云山月照旌麾。\n锦囊剩有新诗句，寄与幽人莫遣迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"风洞","author":"张孝祥","text":"山入乌蛮连越巂，天开斗野对珠宫。\n应怜岭海长炎热，乞与清凉万窍风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"罗江驿","author":"张孝祥","text":"湘南湘北三十里，六月七月再经过。\n紫荆花开白酒贱，柰此湘中风月何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秦城","author":"张孝祥","text":"堑山堙谷北防胡，南筑坚城更远图。\n桂海冰天尘不动，那知垄上两耕夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龟潭","author":"张孝祥","text":"浯溪见渠文字古，龟潭有此竹石幽。\n王孙卖药城市去，江雨过时余独游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"早发衡山","author":"张孝祥","text":"飞廉盛怒土囊口，美满风帆真快哉。\n后日南山山下过，更留馀力扫尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中 其一","author":"张孝祥","text":"扁舟东去几时还，身寄云涛泱漭间。\n一夜橹声鸣到晓，觉来满眼是它山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中 其二","author":"张孝祥","text":"山围平远水浮天，目送归鸿落照边。\n好趁新年酿云液，归来犹及牡丹前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中 其三","author":"张孝祥","text":"乱山深崦小蹊斜，野水微茫浸断霞。\n一笛晚风生碧树，始知林里有人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中 其四","author":"张孝祥","text":"南来北去祇纷纷，又过荆山一月春。\n笑杀风前桃李树，飘蓬犹作未归人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中 其五","author":"张孝祥","text":"泊船江口夜深深，月傍蓬窗照浅斟。\n隔岸渔灯半明灭，不眠空有故人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜雨","author":"张孝祥","text":"已晴复雨雨还晴，惯阅人间梦不惊。\n小立栏干搔短发，乱云飞度夕阳城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢黄主管","author":"张孝祥","text":"一杯为我贳天刑，便觉人间有独醒。\n忆昨金华侍经席，曾分甘露饮春庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有怀","author":"张孝祥","text":"故人春梦谁复见，故园梨花二月天。\n丁祝主人时醉赏，荆州寒食又经年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广右道中 其一","author":"张孝祥","text":"参天古木绿阴合，峻极层峦瀑布长。\n啼鸟一声家万里，依然无语对斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"广右道中 其二","author":"张孝祥","text":"触鼻野花香泛泛，劝归啼鸟意谆谆。\n岭南三月已烦暑，犹向江头细问津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠鹿苑信公诗禅 其一","author":"张孝祥","text":"诗卷随身四十年，忙时参得竹箄禅。\n而今投老湘西寺，卧看湘江水拍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠鹿苑信公诗禅 其二","author":"张孝祥","text":"句中有眼悟方知，悟处还同病著锥。\n一个机关无两用，鸟窠拈起布毛吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻德远与曾裘甫黎师侯会饮范周士所 其一","author":"张孝祥","text":"海棠开后碧桃开，寒食人家燕子来。\n一病闭门三十日，更无屐齿到苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻德远与曾裘甫黎师侯会饮范周士所 其二","author":"张孝祥","text":"张饮名园乐有馀，奉常何苦但斋居。\n一杯我亦垂涎甚，病起无聊只羡渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻德远与曾裘甫黎师侯会饮范周士所 其三","author":"张孝祥","text":"臞曾句法早知名，新筑诗坛五字城。\n不要绨袍怜范叔，应将石鼎调弥明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水仙","author":"张孝祥","text":"净色只应撩处士，国香今不落民家。\n江城望断春消息，故遣诗人咏此花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赋衡山张氏米帖","author":"张孝祥","text":"人物千年海岳翁，笔精墨妙与天通。\n传闻有帖藏张姓，怪底湘江月贯虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"借魏元理画","author":"张孝祥","text":"复古殿中留醉墨，只今神品世间无。\n衡山尚画传家宝，花鸭来禽肯借不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"钦夫折赠海桐赋诗定叟晦夫皆和某敬报况","author":"张孝祥","text":"童童翠盖拥天香，穷巷无人亦自芳。\n能致诗豪四公子，不教辜负好风光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠周义山子季隐","author":"张孝祥","text":"乃翁几年在黄阁，郎君四十犹白丁。\n一家荣瘁不足道，谁持此意闻天庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枢密端明先生宠分新茶将以丽句穆然清风久矣不作感叹之馀辄敢属和 其一","author":"张孝祥","text":"伐山万鼓震春雷，春乡家山挽得回。\n定自君王思苦口，便同金鼎荐盐梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枢密端明先生宠分新茶将以丽句穆然清风久矣不作感叹之馀辄敢属和 其二","author":"张孝祥","text":"先生笔势挟风雷，春色先从笔底回。\n却笑粗官成漫与，望林止渴竟无梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"枢密端明先生宠分新茶将以丽句穆然清风久矣不作感叹之馀辄敢属和 其三","author":"张孝祥","text":"诗肠隐隐转饥雷，春困无人与唤回。\n强续新诗终不似，空传衣钵向黄梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送慈曼如金山迎印老住大沩","author":"张孝祥","text":"传语金山山下龙，乞将上水一帆风。\n道人自有飞空锡，只载中泠十丈洪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小山书院","author":"张孝祥","text":"万里清江占一湾，丛生桂树点幽闲。\n谁人得似刘郎子，赋到淮南大小山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舟中热甚从鄂守李寿翁乞冰雪樱桃","author":"张孝祥","text":"熟颗樱桃和露摘，新冰削玉辟风开。\n南楼纵作一水隔，不遣小舟冲浪来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21760,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜半走笔酬寿翁 其一","author":"张孝祥","text":"短篷掀舞不得寐，忽枉新诗手自开。\n主人留客不作意，更送一江风雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21761,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜半走笔酬寿翁 其二","author":"张孝祥","text":"二年尘土堆中坐，一到南楼眼暂开。\n风静江平留不得，待教黄鹄送诗来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21762,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"琵琶亭 其一","author":"张孝祥","text":"江州司马旧知音，流落江湖感更深。\n万里故人明月夜，琵琶不作亦沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21763,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"琵琶亭 其二","author":"张孝祥","text":"浔阳江上琵琶月，彭泽门前杨柳风。\n两贤抵许不相似，哀乐虽殊吾意同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21764,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过三塔寺 其一","author":"张孝祥","text":"湖光潋滟接天浮，风捲银涛未肯休。\n夜岸系舟来古塔，不妨踪迹更迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21765,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过三塔寺 其二","author":"张孝祥","text":"层峦叠嶂几重重，万顷烟波浩渺中。\n钓艇未归饶夕照，耳边芦苇战寒风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21766,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉渊","author":"张孝祥","text":"灵源直上与天通，借路来从五老峰。\n试向栏干敲拄杖，为君唤起玉渊龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21767,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"万杉寺 其一","author":"张孝祥","text":"庄田总是昭陵赐，更著官船载御书。\n今日残僧无饭吃，却催积欠意何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21768,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"万杉寺 其二","author":"张孝祥","text":"老干参天一万株，庐山佳处著浮图。\n只因买断山中景，破费神龙百斛珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21769,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"楞伽寺 其一","author":"张孝祥","text":"朱砂峰下楞伽寺，白发僧生乙丑年。\n乞我一杯清净水，为扶脚力上层巅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21770,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"楞伽寺 其二","author":"张孝祥","text":"天围欲尽三千界，地险真成百二关。\n不向中峰最高处，诸君元未识庐山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21771,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"楞伽寺 其三","author":"张孝祥","text":"山北山南劫火馀，如何留得此僧居。\n可怜钟阁三枝竹，无复山房万卷书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21772,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"鸾溪","author":"张孝祥","text":"苍龙翔舞馀千仞，瀑水奔流欲百盘。\n定自山灵怜寂寞，故教临镜有窥鸾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21773,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漪澜堂","author":"张孝祥","text":"水漫春洲到处通，樯竿无数插空濛。\n主人只爱堂前木，不放庐山入眼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21774,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和家君韵寄舅氏","author":"张孝祥","text":"夷齐之清格鄙顽，孳孳盗蹠何曾闲。\n空斋风定香缕直，但有书册犹相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21775,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送猿翟伯寿","author":"张孝祥","text":"万里归来无苜蓿，扁舟共载两猿君。\n今日送君向何处，黄鹤山中多白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21776,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉题富文横舟","author":"张孝祥","text":"山林城市不相得，此处俱胜天下降。\n欲展江天一千里，横舟西南更开窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21777,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"子馀许修草堂遣句劝请","author":"张孝祥","text":"莲社高人久寂寥，草堂风物故萧萧。\n追还旧观须公等，唤我它年寄一瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21778,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵南轩喜雨 其一","author":"张孝祥","text":"午窗溜雨忽潺潺，想见欣然阡陌间。\n敬简堂中有新事，水满新池雨满山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21779,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵南轩喜雨 其二","author":"张孝祥","text":"北风吹云如裂丝，赤龙卷水尾倒垂。\n雷轰电激不敢驻，驱入吾家喜雨诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21780,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵南轩喜雨 其三","author":"张孝祥","text":"天公有意不作难，一雨千里须臾间。\n但得湖南今岁熟，我亦腰镰归故山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21781,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵南轩喜雨 其四","author":"张孝祥","text":"使君保障仍茧丝，可怜民屋如罄垂。\n今朝一雨秋事了，便可高咏丰年诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21782,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送茶","author":"张孝祥","text":"头纲八饼密云龙，曾侍虚皇拆御封。\n今日湘中见新夸，唤回清梦九烟重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21783,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"从吴伯承乞茶","author":"张孝祥","text":"三月新茶犹未识，作诗去问野堂君。\n春风有脚家家到，定为粗官不见分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21784,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送僧游天台","author":"张孝祥","text":"宝刹凭虚五百仙，犹将心事向尘边。\n烦君试问桥东寺，若个而今又应缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21785,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石惠叔以石斛为贶因笔赋诗","author":"张孝祥","text":"截得苍山一段秋，千峰万壑翠光浮。\n虚堂百尺琉璃簟，对此真堪作卧游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21786,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题赵知府墓","author":"张孝祥","text":"翁仲无声石马闲，墓门萧瑟锁青烟。\n故人仰卧青松下，落日孤村闻杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21787,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"朝谒南岳","author":"张孝祥","text":"泰常嵩岱拱神州，玉帛闲来四十秋。\n却到朱明回北首，忧时泪作九江流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21788,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题方务德静江所作雪观","author":"张孝祥","text":"昔日主人今法从，空留伟观古城隅。\n邦人指点思遗爱，我亦先生屋上乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21789,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和伯承送茶韵","author":"张孝祥","text":"佳句新茶亦太奇，尝新即日未全迟。\n扫除雁鹜行边事，细辗春风细读诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":21790,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]