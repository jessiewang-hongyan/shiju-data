[{"title":"送邓器先赴罗田尉五首 其三","author":"曾协","text":"之子抱奇器，弹冠始兹年。\n邑人望风度，夫岂南昌仙。\n乐土风俗淳，吠犬申旦眠。\n弓刀无可试，斑衣日蹁跹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送邓器先赴罗田尉五首 其二","author":"曾协","text":"吾乡旴江西，流转半天下。\n梦为故国游，流涕指丘社。\n漂萍偶同止，风力巧相借。\n感君声气似，剪烛对清夜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送邓器先赴罗田尉五首 其一","author":"曾协","text":"我始来相居，谈公口澜翻。\n平生惊人句，笔力正始间。\n古人不可作，因君见班班。\n矍然起懦庸，褰裳撼诗关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送汪汝冯沿檄造朝","author":"曾协","text":"春风扇微和，散入桃李场。\n枯蘖受披拂，处处生辉光。\n有客事行役，起柁凌官塘。\n浮家入烟浪，琴书粲成行。\n旁有玉颊人，妙指出宫商。\n主人志超俗，心胸瑩琳琅。\n但使秋月明，岂虑浮云翔。\n富贵恐不免，赋予元有常。\n善保万金璧，毋遗轻毁伤。\n岂无山径蹊，徐步遵康庄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵有翼监丞造朝供职","author":"曾协","text":"君侯昂然百夫雄，近之和气如春风。\n扬眉高论多折衷，众人敛衽称名通。\n发为诗章灿璧琮，气豪笔健敏且工。\n口占欲使十手供，春云容与朝霞烘。\n肯如空阶号秋虫，槁项岩穴甘老穷。\n是将织文裨衮龙，润色造化分天功。\n奏之清庙流笙镛，宜使正笏趋槐枫。\n发舒平生学古胸，时吐奇论惊群公。\n久矣高门映衰宗，金兰投分自诸翁。\n我尝联曹愧凡庸，竭蹶道上昔所同。\n朔雪扑面花蒙茸，六龙先路如云从。\n重来苕溪奉从容，好若胶漆始且终。\n先后唱和如歌钟，君还清班朝九重。\n我将毂下居治中，他时涉笔朱墨丛。\n已见矫翼凌长空，一笑道旧双颊红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵有翼通守吴兴","author":"曾协","text":"江南雨无时，桃李迹已陈。\n有客念江湖，别乘陪朱轮。\n明德先九族，恩殊在廷臣。\n惟公真龙种，眉宇犹津津。\n不受膏粱昏，辞章动枫宸。\n合著玉笋班，冠冕朝大昕。\n去丞股肱郡，要此骨肉亲。\n萧萧霅水乡，溪山绕城闉。\n空光缬纹乱，倒影图画新。\n金石富文墨，烟波多隐沦。\n坐想贤使君，迎笑均凭茵。\n席间荀陈俱，会此主与宾。\n陈榻对清夜，潘舆行莫春。\n拄颊爱爽气，挥毫咏风蘋。\n远近入题品，苍翠生精神。\n我忘鸥鸟盟，低徊践香尘。\n因子动归兴，诘旦车当巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵德庄右司赴江东漕八首 其八","author":"曾协","text":"我公廊庙姿，当为济时霖。\n生材必有用，应物初无心。\n异时百僚上，金貂耀华簪。\n富贵恐不免，易退其自今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵德庄右司赴江东漕八首 其七","author":"曾协","text":"乡来远门墙，引睇想光辉。\n宦游偶相值，间关得因依。\n都门送星轺，依然寸心违。\n勿为贾胡留，速书季子归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵德庄右司赴江东漕八首 其六","author":"曾协","text":"饱学兼内外，超然悟空无。\n是身任东西，乾坤一蘧庐。\n目前谩纷纭，一致总万殊。\n良欲行世间，不效山泽癯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵德庄右司赴江东漕八首 其五","author":"曾协","text":"建业一都会，由来帝王畿。\n旷哉怀古心，陈迹犹依依。\n当年王谢家，青紫满乌衣。\n万事一丘土，简策徒是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵德庄右司赴江东漕八首 其四","author":"曾协","text":"行迈未为远，两州东西都。\n中天敞华阙，鱼钥黄金铺。\n山川俨形势，貔貅凛戈殳。\n正须埋轮手，先声震江吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵德庄右司赴江东漕八首 其三","author":"曾协","text":"正色立公府，嘉谋赞岩廊。\n材华动人主，咫尺鸳鹭行。\n掉头不肯住，清宵梦沧浪。\n丈夫贵勇决，养此百鍊刚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵德庄右司赴江东漕八首 其二","author":"曾协","text":"轩盖事朝谒，阊阖方晨趋。\n霜露怀松楸，慨然赋归欤。\n确志感清衷，载以使者车。\n往宣问事条，勿但安田庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送赵德庄右司赴江东漕八首 其一","author":"曾协","text":"往年际风云，濯濯春月柳。\n俊气横九天，下笔蛟龙走。\n岁晚收其实，落落坚且久。\n澹然松桧质，不为霜雪朽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题兰陵郡斋梅露堂","author":"曾协","text":"兰陵为郡更齐梁，地望卓荦闻四方。\n清班诜诜储材良，相踵往佩太守章。\n宪公遗爱初未忘，当时瑞露今名堂。\n于兹辽辽几星霜，此邦复得尚书郎。\n政似古人天降祥，揭榜华屋遥相望。\n使君燕寝东西厢，岭梅林林分两傍。\n春事已退堕渺茫，调羹有实升庙廊。\n叶间奇葩忽芬芳，缥白异状中有香。\n襞绩千叶成花房，天公好善善必彰。\n故出瑞物非其常，此花颜色见未尝。\n浴以沆瀣宵瀼瀼，炯如珠玑缀琳琅。\n蜂房割蜜蔗流浆，邦人欢呼走且僵。\n我公中心念丁黄，抚摩凋瘵还耕桑。\n天锡嘉瑞不肯当，尽掇钜美归圣皇。\n公岂我留返鹓行，但有盛事存甘棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清富庵","author":"曾协","text":"一衲缠身便有馀，乱山深处卜幽居。\n举头物物皆呈露，试问金多得似无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"章季子携所作乐府来以诗谢之","author":"曾协","text":"平生尚幽僻，尘务百不省。\n屡从松竹游，身闲爱官冷。\n何知事大缪，穷日厌鞭打。\n抽身对佳客，屣倒冠不整。\n吏徒环顾人，为我忍俄顷。\n匆匆上马揖，语略意已领。\n新诗满怀袖，璀璨吐光景。\n归来坐明月，万象入清境。\n风林起惊鹊，闲窗散花影。\n吟哦不成寐，尽此良夜永。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赋赵有翼仇池石次沈正卿用苏翰林韵","author":"曾协","text":"贪夫居奇货，什袭藏结绿。\n宁知十五城，不救卞和足。\n岂如嗜石人，丘壑在胸腹。\n不知连城价，但赏数峰蹙。\n长公仙去后，兵马遂南牧。\n尤物落何许，心知委沟渎。\n何期超世贤，爱石不爱玉。\n夜半负之走，包裹随窜伏。\n一朝返窗几，时清端可卜。\n李虎初平羊，案上纷相逐。\n峥嵘幸无恙，不问牛马谷。\n赵侯天机异，阅世轻嗜欲。\n好奇与嗜利，达观均一曲。\n正恐便弃置，就赏君宜速。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜡梅","author":"曾协","text":"小树列仙质，翛然道家装。\n雪帔挂浅绛，铢衣曳微黄。\n清风一披拂，芝兰让幽香。\n老子专鼻观，此花正相当。\n就令困霜雪，肯受泥涂伤。\n题评得名字，诗人惜辉光。\n虽无调鼎实，不作时世妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题大儿新安官舍三乐斋","author":"曾协","text":"吾先圣人徒，游夏同渊源。\n孝友与忠信，入道先本根。\n下视晋楚富，商歌满乾坤。\n一唯了万事，伋轲继师尊。\n至今百世后，家法要不烦。\n近数高曾来，洁身等玙璠。\n当时天下士，白首称曾门。\n世掇太常第，自致冕与轩。\n养禄到北堂，孝哉无间言。\n犹悲鲤庭空，遗恨终自吞。\n至我壮无成，浪使岁月奔。\n文科始不嗣，愧此朱两轓。\n赖汝念祖烈，先登倡诸孙。\n寂寥四十载，重拜雨露恩。\n吾年独天假，将雏见飞翻。\n腼颜幸一洗，积德惭九原。\n三年作尉归，横经处侯藩。\n孤城山水稠，草木霜不蕃。\n官閒身无事，旧书可重翻。\n故职在六经，绪业勤讨论。\n避堂舍翁媪，齿在发未髡。\n不忧俸酸寒，罗列奉晨飧。\n公黉沸弦诵，私室合篪埙。\n气完万物轻，始验中所存。\n结屋将乐此，不换钟鼓喧。\n爱汝此乐地，老苍离童昏。\n朱金了无慕，况乃纨绮繁。\n真趣出自然，盎盎如春温。\n名斋怜汝志，可使薄俗敦。\n此乐吾家无，诗之劝仍昆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题李粹伯晦庵","author":"曾协","text":"天道有消息，物理兼屈伸。\n鸟匿定将击，龙蛰以存身。\n卷舒虽不同，为用常相因。\n老聃晞发时，恝然似非人。\n肢体尚可堕，外物真埃尘。\n信知犹龙姿，涵养知几春。\n寂寥千载下，裔孙岂其伦。\n磊落感意气，峥嵘富精神。\n乃以晦自居，悠然返天真。\n渔樵欲争席，鸥鸟行相亲。\n形谍不可掩，眉端已津津。\n风云一朝便，垂天起潜鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤栖梧/蝶恋花 西溪道中作","author":"曾协","text":"柳弄轻黄花泣露。\n万叠春山，不记尘寰路。\n日射霜林烟罩素。\n长空不著纤云污。\n历历远村明可数。\n绿涨前溪，渺渺迷津渡。\n客子光阴能几许。\n画图拟卷晴川去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水龙吟 别故人","author":"曾协","text":"楚乡菰黍初尝，马蹄偶踏扬州路。\n莼丝向老，江鲈堪脍，催人归去。\n秋气萧骚，月华如洗，一天风露。\n望重重烟水，吴淞万顷，曾约旧时鸥鹭。\n惆怅别离无奈，整孤帆、依然回顾。\n玉龙节底，故人情重，欲行犹驻。\n敛散功多，澄清志遂，好回高步。\n看归鞍稳上，文鸳班里，五云深处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其二 细君生日作","author":"曾协","text":"日永向槐夏，绕屋树扶疏。\n麦秋天气清润，设帨记生初。\n新拜小君佳号，更过诸郎官舍，仍玩掌中珠。\n乐事似今少，一笑倒双壶。\n列山肴，烹野蔌，且欢娱。\n鹿门远引，平生此志与君俱。\n终向苕溪烟水，携手云庄风月，不践利名区。\n功业看儿辈，相对老江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其一 送史侍郎","author":"曾协","text":"今日复何日，欢动楚江滨。\n紫泥来自天上，优诏起元臣。\n想见傅岩梦断，记得金瓯名在，却念佩兰人。\n永昼通明殿，曾听话经纶。\n促归装，趋北阙，觐严宸。\n玉阶陈迹如故，天笑一番新。\n好借食间前箸，尽吐胸中奇计，指顾静烟尘。\n九万云霄路，飞走趁新春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇 其二 汪汝冯置酒请赋芍药","author":"曾协","text":"乱叠香罗，玉纤微把燕支污。\n靓妆无数。\n十里扬州路。\n怨绿啼红，总道春归去。\n君知否。\n画阑幽处。\n留得韶光住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"点绛唇 其一 送李粹伯赴春闱","author":"曾协","text":"小驻征骖，一尊古寺留君住。\n六花无数。\n飞舞朝天路。\n上苑繁华，却似词章富。\n春将暮。\n玉鞭凝伫。\n总是经行处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"祝英台/祝英台近 和翁士秀牡丹韵","author":"曾协","text":"放花开，催花谢，谁解东君意。\n要遣花王，独占花蹊邃。\n且看玉镜台前，霞觞新举，红玉软、晓妆慵试。\n好风味。\n须信金屋中人，谁堪并娇媚。\n隐约微潮，应向尊前醉。\n最怜纹锦搴帷，青罗飞盖，尘土外、轻盈相倚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"桃源忆故人 和翁士秀","author":"曾协","text":"野亭问柳今朝试。\n更访小园开未。\n月下山横空际。\n两两修眉对。\n骚人对此增高致。\n意入笔端清邃。\n投分周郎心醉。\n真解消人意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 咏芍药金系腰海陵席上作","author":"曾协","text":"昼漏新来一倍长。\n众宾沾醉尚传觞。\n浓云遮日惜红妆。\n应是主人归凤沼，为传芳讯到黄堂。\n腰围恰恰束金黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秦楼月/忆秦娥 留别海陵诸公","author":"曾协","text":"清秋月。\n长空万里烟华白。\n烟华白。\n江云收尽，楚天一色。\n莼丝惹起思归客。\n清光正好伤离别。\n伤离别。\n五湖烟水，伴人愁绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酹江月/念奴娇 其二 宴叶叔范新第","author":"曾协","text":"苕溪古岸，有朱门初建，落成华屋。\n对启园林随杖履，迤逦柳蹊相属。\n好是危亭，片峰迎面，独立清溪曲。\n芜城低远，一尘不碍游目。\n公子豪饮方酣，夜堂深静，隐隐鸣丝竹。\n却尽春寒宾满座，深酌葡萄新绿。\n密户储香，广庭留月，待得清欢足。\n纷纷沾醉，四筵倒尽群玉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酹江月/念奴娇 其一 扬州菊坡席上作","author":"曾协","text":"一年好处，是霜轻尘敛，山川如洗。\n晚菊留花供燕赏，金缕宝衣销地。\n旧观初还，层楼相望，重见升平际。\n小春时节，绮罗丛里人醉。\n此日武帐贤侯，六年仁政，浃长淮千里。\n欲入鹓行仍缓带，聊抚竹西歌吹。\n紫塞烟清，玉关人老，宜趣朝天骑。\n香尘归路，旧游回首应记。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蹋莎行 春归怨别","author":"曾协","text":"柳眼传情，花心蹙恨。\n春风处处关方寸。\n朱帘卷尽画屏闲，云鬟半亸罗衣褪。\n燕语莺啼，日长人困。\n鱼沈雁断无音信。\n琵琶声乱篆烟斜，寸肠欲断无人问。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题考功印纸","author":"曾如骥","text":"谨将节义二字，结果印纸一宗。\n了却神游何处，澄江明月清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游麻姑山九首 其八 七星杉","author":"曾巩","text":"古杉苍苍横斗文，其干十围阴蔽野。\n应到夜深山月来，林色天光迷上下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"二月八日北城闲步","author":"曾巩","text":"土膏初动麦苗青，饱食城头信意行。\n便起高亭临北渚，欲乘长日劝春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与舍弟别舟岸间相望感叹成咏","author":"曾巩","text":"涕泪昨辞亲，酸心今别子。\n舟陆空相望，掺袂即千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"千丈岩瀑布","author":"曾巩","text":"玉虬垂处雪花翻，四季雷声六月寒。\n凭槛未穷千丈势，请从岩下举头看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孔明","author":"曾巩","text":"称吴称魏已纷纷，渭水西边独汉臣。\n平日将军不三顾，寻常田里带经人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆越中梅","author":"曾巩","text":"浣沙亭北小山梅，兰渚移来手自栽。\n今日旧林冰雪地，冷香幽艳向谁开？","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"方推官寄新茶","author":"曾巩","text":"采摘东溪最上春，壑源诸叶品尤新。\n龙团贡罢争先得，肯寄天涯主诺人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蹇磻翁寄新茶二首 其二","author":"曾巩","text":"贡时天上双龙去，斗处人间一水争。\n分得馀甘慰憔悴，碾尝终夜骨毛清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蹇磻翁寄新茶二首 其一","author":"曾巩","text":"龙焙尝茶第一人，最怜溪岸两旗新。\n肯分方胯醒衰思，应恐慵眠过一春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北归三首 其三","author":"曾巩","text":"江海多年似转蓬，白头归拜未央宫。\n堵墙学士惊相问，何处尘埃瘦老翁？","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北归三首 其二","author":"曾巩","text":"拜捧恩书喜满颜，马蹄遥望斗杓还。\n从今步步行平地，出得千山与万山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北归三首 其一","author":"曾巩","text":"终日思归今日归，著鞭鞭马尚嫌迟。\n曲台殿里官虽冷，须胜天涯海角时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"北园会客不饮","author":"曾巩","text":"画桥南北水西东，高下花枝绿间红。\n殢得春风人尽醉，独醒谁似白头翁？","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游麻姑山九首 其四 半山亭","author":"曾巩","text":"树杪苍崖路屈盘，半崖亭榭午犹寒。\n平时举眼看山处，到此凭栏直下看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":78557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"去年久旱六月十三日入境得雨今年复旱得雨亦六月十三日也","author":"曾巩","text":"去年六月焦原雨，入得东州第一朝。\n今日看云旧时节，又来农畔听萧萧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":1,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正月六日雪霁","author":"曾巩","text":"雪消山水见精神，满眼东风送早春。\n明日杏园应烂熳，便须期约看花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":2,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"会稽绝句三首 其三","author":"曾巩","text":"年年谷雨愁春晚，况是江湖两鬓华。\n欲载一樽乘兴去，不知何处有残花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":3,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"会稽绝句三首 其二","author":"曾巩","text":"花开日日插花归，酒盏歌喉处处随。\n不是心闲无此乐，莫教门外俗人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":4,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"会稽绝句三首 其一","author":"曾巩","text":"花开日日去看花，迟日犹嫌影易斜。\n莫问会稽山外事，但将歌管醉流霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":5,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旬休日过仁王寺","author":"曾巩","text":"杂花飞尽绿阴成，处处黄鹂百啭声。\n随分笙歌与樽酒，且偷闲日试闲行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":6,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"百花台","author":"曾巩","text":"烟波与客同樽酒，风月全家上采舟。\n莫问台前花远近，试看何似武陵游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":7,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西楼","author":"曾巩","text":"海浪如云去却回，北风吹起数声雷。\n朱楼四面钩疏箔，卧看千山急雨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过零壁张氏园三首 其三","author":"曾巩","text":"秫地成来多酿酒，杏林熟后亦留钱。\n不须置驿迎宾客，直到门前系画船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过零壁张氏园三首 其二","author":"曾巩","text":"汴水溶溶带雨流，黄花艳艳亦迎秋。\n看花引水园林主，应笑行人易白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":10,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过零壁张氏园三首 其一","author":"曾巩","text":"梨枣累累正熟时，粟田鹑兔亦争肥。\n园亭尽日追寻遍，只欠厌厌醉始归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":11,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乱山","author":"曾巩","text":"乱山深处转山多，此地栖身奈远何？\n莫问吾亲在何处，举头东岸是新罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]