[{"title":"上巳同沈虞卿尤延之王顺伯林景思游湖上得十绝句呈同社 其二","author":"杨万里","text":"总宜亭子小如拳，著得西湖不见痕。\n湖上轩窗无不好，何须抵死拣名园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳同沈虞卿尤延之王顺伯林景思游湖上得十绝句呈同社 其三","author":"杨万里","text":"孤山山后北山前，十里长堤隔两边。\n一行垂杨绿无缝，石桥通处过春船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳同沈虞卿尤延之王顺伯林景思游湖上得十绝句呈同社 其六","author":"杨万里","text":"雨催杖屦却须回，捲上疏帘眼顿开。\n十里湖光平似镜，柳梢梢外一船来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳同沈虞卿尤延之王顺伯林景思游湖上得十绝句呈同社 其四","author":"杨万里","text":"天色䰒松未肯收，吾侪自乐不曾愁。\n随宜旋旋商量著，晴即闲行雨即休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳同沈虞卿尤延之王顺伯林景思游湖上得十绝句呈同社 其九","author":"杨万里","text":"今年山路少人来，酒肆萧然绮席埃。\n政尔坐愁春寂寞，画船箫鼓忽如雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳同沈虞卿尤延之王顺伯林景思游湖上得十绝句呈同社 其十","author":"杨万里","text":"岸上湖中各自奇，山觞水酌两皆宜。\n只言游舫浑如画，身在画中元不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳同沈虞卿尤延之王顺伯林景思游湖上得十绝句呈同社 其八","author":"杨万里","text":"凭久栏干可一杯，湖山飞入水中来。\n多情燕子能相劝，舞破东风去却回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳同沈虞卿尤延之王顺伯林景思游湖上得十绝句呈同社 其一","author":"杨万里","text":"鹄袍林里过芳辰，闻道春来不识春。\n及至识春春已老，于中更老是诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳后一日同子文伯庄永年步东园三首 其三","author":"杨万里","text":"只爱酴醾雪作葩，不知雪后减金沙。\n春归道是无情著，试看游丝舞落花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳后一日同子文伯庄永年步东园三首 其二","author":"杨万里","text":"九径阴阴一一穿，前谈后笑各欣然。\n缓行不是身无力，满地残红不忍前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳后一日同子文伯庄永年步东园三首 其一","author":"杨万里","text":"兄弟相过看牡丹，牡丹看了看东园。\n攀翻花木来还去，九径还行十八番。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元日晚过顺溪","author":"杨万里","text":"恰恰元宵雨脚垂，天风为我扫除之。\n怪来平地寒如许，雪满远峰人未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元后一日往山庄访子仁中涂望见庄里李花二首 其二","author":"杨万里","text":"李花十里纵长围，漏出桃花片子儿。\n千丈越罗初水冻，中间一点涴燕脂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元后一日往山庄访子仁中涂望见庄里李花二首 其一","author":"杨万里","text":"庄里李花何似生，山头转处最分明。\n轿中举首聊东望，不见花枝见雪城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元前一日游东园看红梅三首 其三","author":"杨万里","text":"儿牵黄犊父担犁，社鼓迎神簇纸旗。\n不是丰年那得此，今春大胜去春时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元后犹寒二首 其二","author":"杨万里","text":"道是春工做物华，春工元自不由它。\n杏花只作去年面，萱草别抽今岁芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元后犹寒二首 其一","author":"杨万里","text":"雪后不妨寒较差，莫教一并放千花。\n旧来池上金丝柳，新学江西鹰爪茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上印有日代者未至","author":"杨万里","text":"不是新人不肯来，天教老子小徘徊。\n坐看桃李缤纷落，等得酴醾烂熳开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上岑水岭二首 其二","author":"杨万里","text":"天上云泉脚下鸣，玉虹倒挂客心惊。\n试教转落峰头石，衮到深溪作么声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上岑水岭二首 其一","author":"杨万里","text":"危峰上面更危峰，特地无梯上碧空。\n遥望白云生绝顶，如今身在白云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上章戴滩","author":"杨万里","text":"脱巾枕手仰哦诗，醉上诸滩总不知。\n回看他船上滩苦，方知它看我船时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上濛悴滩","author":"杨万里","text":"清江斜抱岭根来，暗石冲波却倒回。\n幸自琉璃青一片，落滩碎作雪花堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下鸡鸣山诸滩望柯山不见三首 其三","author":"杨万里","text":"却忆归舟是去年，上滩浑似上青天。\n诸滩知我怀馀怨，急送秋风下水船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下鸡鸣山诸滩望柯山不见三首 其二","author":"杨万里","text":"莫怯诸滩水怒号，下滩不似上滩劳。\n长年三老无多巧，稳送惊湍只一篙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下鸡鸣山诸滩望柯山不见三首 其一","author":"杨万里","text":"地近莲花江渐深，一滩一过快人心。\n贪看下水船如箭，失却柯山无处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下横山滩头望金华山四首 其四","author":"杨万里","text":"玉立金华霄汉间，帝封天女锡仙山。\n被他走下严滩去，一水穷追竟不还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下横山滩头望金华山四首 其三","author":"杨万里","text":"道是兰溪水较宽，兰溪欲到怪生难。\n后船只羡前船快，不觉前船阁在滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下横山滩头望金华山四首 其二","author":"杨万里","text":"山思江情不负伊，雨姿晴态总成奇。\n闭门觅句非诗法，只是征行自有诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"下横山滩头望金华山四首 其一","author":"杨万里","text":"篙师只管信船流，不作前滩水石谋。\n却被惊湍漩三转，倒将船尾作船头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与子上野步","author":"杨万里","text":"篱落深深巷，茅茨小小家。\n冬晴好行脚，何处不梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与子仁登天柱冈过胡家塘莼塘归东园四首 其四","author":"杨万里","text":"厌看家园桃李春，踏青行遍四山村。\n芳菲看尽还归看，看得园花特地新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与子仁登天柱冈过胡家塘莼塘归东园四首 其三","author":"杨万里","text":"数间茅屋傍山根，一队儿童出竹门。\n只爱行穿杨柳渡，不知失却李花村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与子仁登天柱冈过胡家塘莼塘归东园四首 其二","author":"杨万里","text":"胡床脚底万峰寒，拄杖锥尖乱藓斑。\n天柱冈头行未饱，相携更上一重山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与子仁登天柱冈过胡家塘莼塘归东园四首 其一","author":"杨万里","text":"嫩晴无日也无风，政是春光酒样醲。\n行到中峰元未觉，回头已度打头峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与山庄子仁侄东园看梅四首 其一","author":"杨万里","text":"仰树看花不见梅，闻香疑在别园开。\n更行数步偶回首，却被青松映出来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与山庄子仁侄东园看梅四首 其二","author":"杨万里","text":"梅花不是雪家仙，雪里如何不怕寒。\n冻脱龙髯冰却海，千花试与斗来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与刘景明晚步","author":"杨万里","text":"行尽南溪溪北涯，李花看了看桃花。\n归来倦卧呼童子，旋煮山泉瀹建茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与次公夜酌","author":"杨万里","text":"汤盂深浅任横斜，酒力微醺略减些。\n剪烛小童殊解事，不留烛烬却留花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与伯勤子文幼楚同登南溪奇观戏道傍群儿","author":"杨万里","text":"䰒松睡眼熨难开，曳杖缘溪啄紫苔。\n偶见群儿聊与戏，布衫青底捉将来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨小霁东园行散","author":"杨万里","text":"雨寒两月勒春迟，初喜云间漏霁晖。\n道是攀花无雨点，忽然放手溅人衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久病小愈雨中端午试笔四首 其一","author":"杨万里","text":"病较欣逢五五辰，宫衣忽忆拜天恩。\n旧时叠雪含风眼，今看空山雨点痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"之官五羊过太和县登快阁观山谷石刻赋两绝句呈知县李绅公垂主簿赵蕃昌父 其二","author":"杨万里","text":"庐陵山水说西昌，天遣金华印此邦。\n诗本道他将取去，如何遗下一澄江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"之官五羊过太和县登快阁观山谷石刻赋两绝句呈知县李绅公垂主簿赵蕃昌父 其一","author":"杨万里","text":"阁中陈迹故依然，欲问风流已百年。\n南岸一峰东一塔，自言曾识老诗仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大儿长孺同罗时清寻凉盐桥","author":"杨万里","text":"灯火希疏夜向中，追凉只与热相逢。\n意行行到新桥上，两岸无人四面风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大司成颜几圣率同舍招游裴园泛舟绕孤山赏荷花晚泊玉壶得十绝句 其四","author":"杨万里","text":"船开便与世尘疏，飘若乘风度太虚。\n坐上偶然遗饼饵，波间无数出龟鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大司成颜几圣率同舍招游裴园泛舟绕孤山赏荷花晚泊玉壶得十绝句 其一","author":"杨万里","text":"凤城鱼钥晓开银，国子先生领搢绅。\n山水光中金凿落，芙蕖香里葛头巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大司成颜几圣率同舍招游裴园泛舟绕孤山赏荷花晚泊玉壶得十绝句 其三","author":"杨万里","text":"岸岸园亭傍水滨，裴园飞入水心横。\n旁人莫问游何许，只拣荷花闹处行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大司成颜几圣率同舍招游裴园泛舟绕孤山赏荷花晚泊玉壶得十绝句 其六","author":"杨万里","text":"小泛西湖六月船，船中人即水中仙。\n外铺云锦千弓地，中度琉璃百摺天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大司成颜几圣率同舍招游裴园泛舟绕孤山赏荷花晚泊玉壶得十绝句 其八","author":"杨万里","text":"故人京尹剧风流，走送厨珍佐胜游。\n青李来禽沈冰雪，黄金白璧斫蝤蛑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大司成颜几圣率同舍招游裴园泛舟绕孤山赏荷花晚泊玉壶得十绝句 其五","author":"杨万里","text":"西湖旧属野人家，今属天家不属他。\n水月亭前且杨柳，集芳园下尽荷花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大司成颜几圣率同舍招游裴园泛舟绕孤山赏荷花晚泊玉壶得十绝句 其十","author":"杨万里","text":"游尽西湖赏尽莲，玉壶落日泊楼船。\n莫嫌当处荷花少，剩展湖光几镜天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大司成颜几圣率同舍招游裴园泛舟绕孤山赏荷花晚泊玉壶得十绝句 其九","author":"杨万里","text":"人间暑气正如炊，上了湖船便不知。\n湖上四时无不好，就中最说藕花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渝州寄王道矩","author":"苏轼","text":"曾闻五月到渝州，水拍长亭砌下流。\n惟有梦魂长缭绕，共论唐史更绸缪。\n舟经故国岁时改，霜落寒江波浪收。\n归梦不成冬夜永，厌闻船上报更筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大司成颜几圣率同舍招游裴园泛舟绕孤山赏荷花晚泊玉壶得十绝句 其二","author":"杨万里","text":"小步深登野寺幽，古松将影入茶瓯。\n铃声忽起九天半，有塔危峰最上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大丞相益国周公访予于碧瑶洞天刘敏叔写以为图求予书其后","author":"杨万里","text":"平叔曾过魏秀才，何如老子致元台。\n苍松翠竹青苔径，也不传呼宰相来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子上持豫章画扇其上牡丹三株黄白相间盛开一猫将二子戏其旁","author":"杨万里","text":"暄风暖景政春迟，开尽好花人未知。\n输与狸奴得春色，牡丹香里弄双儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"子年刘郎写余老貌求赞","author":"杨万里","text":"鬓少梳欲无，髭短镊更少。\n搔鬓祗撚髭，觅句何日了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小立净远亭","author":"杨万里","text":"清景无终极，频来未属厌。\n远山秋后出，茅屋近来添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小池","author":"杨万里","text":"泉眼无声惜细流，树阴照水爱晴柔。\n小荷才露尖尖角，早有蜻蜓立上头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小舟晚兴四首 其四","author":"杨万里","text":"一船在后忽搀前，前后篙师各粲然。\n山入春来肥更秀，向人依旧耸寒肩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小舟晚兴四首 其三","author":"杨万里","text":"潮痕初落水犹肥，雨点才来已复微。\n半湿岸沙危欲落，牵船稚子去如飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小舟晚兴四首 其二","author":"杨万里","text":"人在非晴非雨天，船行不浪不风间。\n坐来堪喜还堪恨，看得南山失北山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小饮俎豆颇备江西淮浙之品戏题二首 其二","author":"杨万里","text":"味含霜气洞庭柑，鲊带桃花楚水?。\n春暖著人君会否，不教淮白过江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小饮俎豆颇备江西淮浙之品戏题二首 其一","author":"杨万里","text":"满盘山海眩芳珍，未借前筹已咽津。\n鲎酱子鱼总佳客，玉狸黄雀是乡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小泊英洲二首 其二","author":"杨万里","text":"数家草草劣无多，跕水飞鸢也不过。\n道是荒城斗来大，向来此地著东坡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小泊英洲二首 其一","author":"杨万里","text":"人人藤叶嚼槟榔，户户茅檐覆土床。\n只有春风不寒乞，隔溪吹度柚花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小泊梅堰登明孝寺","author":"杨万里","text":"泊船梅堰日微升，一径深深唤我登。\n随分垂杨兼老桧，备员野寺更残僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小泊新丰市","author":"杨万里","text":"也知小倦泊楼船，何苦争先柳岸边。\n须把碧篙摇绿净，舟人不惜水中天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小雨","author":"杨万里","text":"雨来细细复疏疏，纵不能多不肯无。\n似妒诗人山入眼，千峰故隔一帘珠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小雨","author":"杨万里","text":"雨才放脚又还无，叶上萧萧半霎馀。\n贮得千珠无点漏，丝窠元自不胜疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小斋晚兴","author":"杨万里","text":"不会邻家养鸽儿，清晨齐放晚齐归。\n网丝到处萦人鬓，欲打蜘蛛拣最肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小桃","author":"杨万里","text":"小桃著子可怜渠，疏处全疏无处无。\n并缀一梢三十颗，缒枝欲折没人扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小瓶梅花","author":"杨万里","text":"梅萼才开已乱飞，不堪雨打更风吹。\n萧萧只隔窗间纸，瓶里梅花总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小酌","author":"杨万里","text":"酒入春逾劲，天寒烛始明。\n偶然倾一盏，政尔忽三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":66660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]