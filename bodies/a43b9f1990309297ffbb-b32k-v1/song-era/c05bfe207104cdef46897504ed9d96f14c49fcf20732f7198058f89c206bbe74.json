50b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晏太尉三月十三日锡庆院二首 其一","author":"宋祁","text":"绀宇传香鹭序回，南趋别馆宴庭开。\n正因恩厚心先醉，不待君王常满杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晏太尉三月初五日","author":"宋祁","text":"东南郊日上团红，浩荡天区望始穷。\n独爱暖云如擘絮，纷纷无事映晴空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晏太尉西园晚春 其二","author":"宋祁","text":"风蘤幡幡续去条，一朝欢尽负霞朝。\n人间赋笔如公少，借问离愁著底浇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晏太尉西园晚春 其三","author":"宋祁","text":"涡曲攀花泥酒卮，西园春去一凝思。\n谢公今系苍生望，无复东山携妓时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晏太尉西园晚春 其一","author":"宋祁","text":"北平心计尽红牙，五日雕鞍暮到家。\n林下觅春春已晚，绿杨枝暗不通鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晏尚书出城口占四首 其四","author":"宋祁","text":"终年羁束厌华绅，暂到林墟似出尘。\n尽是机心可忘处，争教鱼鸟不留人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晏尚书出城口占四首 其三","author":"宋祁","text":"千里梁陈一眺分，古愁今恨枉相闻。\n早须跋马收清思，莫看沈西日暮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晏尚书出城口占四首 其二","author":"宋祁","text":"榔栗婆娑昼影圆，披襟凝眺此翛然。\n鹂留便作林间伴，正是麰黄椹紫天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晏尚书出城口占四首 其一","author":"宋祁","text":"沆莽团红上晓原，露英风叶隔尘喧。\n天边一寄冥鸿意，越乙荆凫判自翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和晏尚书咏芙蓉金菊","author":"宋祁","text":"千叠绡红抱蕊乾，一番金雨映趺攒。\n比来醉笔赓新曲，简上飞霜不拟寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郭六玉律上巳宴罢见寄","author":"宋祁","text":"式燕灵琨眷蕙时，祓兰浮枣惜春晖。\n回骖并跃都门道，谁识颜王曲水归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和御制皇太后恭谢太庙","author":"宋祁","text":"柔极深慈冠古先，谢成宗祏奉斋牷。\n欲知太姒嗣音盛，亲见周王作雅年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏水红","author":"宋祁","text":"夏砌绿茎秀，秋檐红穗繁。\n终然体不媚，无乃对虞翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏史","author":"宋祁","text":"一马浮江拥瑞图，青规群彦掎长裾。\n本缘献替居门下，不为江虾与䱥鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏叔孙通","author":"宋祁","text":"马上成功不喜文，叔孙绵蕞擅经纶。\n诸生可笑贪君赐，便许当时作圣人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏棠棣","author":"宋祁","text":"潘赋幽芳在，周诗荣鄂传。\n佛轮千幅细，公带万钉圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏葵","author":"宋祁","text":"纤草无人爱绿葵，一生私意竟谁知。\n须防白日倾心处，自是中园卫足时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜分","author":"宋祁","text":"此夕炎氛罢，浩然天意秋。\n桂华兼月上，槎影带星流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学舍直归","author":"宋祁","text":"衣满天街车马尘，学庐番下已迎曛。\n敝裘欹帽驱羸马，官长多能骂广文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"学舍昼上","author":"宋祁","text":"风射长廊雪絮春，经筵无客有流尘。\n扪心自问何功德，五管支离治繲人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"房陵旧第","author":"宋祁","text":"谪去房陵席尚温，回看北第已消魂。\n当时贺厦翩翻者，今日张罗不过门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"房陵旧第股引蔡水养鱼于池败日或有塞其水窦鱼多涸矣","author":"宋祁","text":"后园平日引春渠，浴凤翔鸳两自如。\n一旦绣衣来簿责，馀灾犹得及池鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"招希元奕","author":"宋祁","text":"饱食南荣曝昼曦，小星联影入枯棋。\n座宾只待王郎至，为判南风不竞时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"直舍饮饯杨子奇","author":"宋祁","text":"杯霞三釂客颜酏，明日离魂伴玉珂。\n我为有人轻狗曲，同居不敢唱骊歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"直舍雠理律书呈同舍二首 其二","author":"宋祁","text":"经筵敢倦力刊梓，国典将追鼎铸书。\n静对阙疑还阁笔，不知三古字为鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"直舍雠理律书呈同舍二首 其一","author":"宋祁","text":"旧文新札俨成行，柏熏微开帙气香。\n天下书多殊未见，颜生应笑下雌黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"肃简鲁公挽词四首 其四","author":"宋祁","text":"密勿千龄旦，生平三命恭。\n承家男得凤，择婿女乘龙。\n酂邑穷遗产，邢山卜素封。\n空馀吊客泪，倾海望长松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦热二首 其二","author":"宋祁","text":"秋阳昼长不可度，身被单葛如重裘。\n何当急雨洗天地，坐使清风还九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":46661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]