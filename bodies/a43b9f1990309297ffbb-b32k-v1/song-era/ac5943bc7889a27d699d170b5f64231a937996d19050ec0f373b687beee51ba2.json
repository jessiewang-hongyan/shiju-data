[{"title":"无锡道观","author":"刘过","text":"门外红尘市一廛，买瓜买李兴悠然。\n树根石透月洒落，殿阁屋多风折旋。\n卖墨道人勤置酒，能诗老子欲飞仙。\n髑髅南面蛆虫辈，鹏鴳逍遥各自天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28851,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"长干寺用荆公韵","author":"刘过","text":"萦纡一径试幽寻，花竹禅房未是深。\n野水不波清欲冻，崇冈有竹翠成阴。\n琵琶昵昵怨儿语，兰桂温温和水沈。\n诗句欲追前辈后，谁呼粉黛污清吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28852,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代上韩开府","author":"刘过","text":"位号钧枢等，元勋阀阅传。\n九重新洗日，一柱独擎天。\n战守筹帷外，迁除化笔边。\n衣冠图盛事，不记几貂蝉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28853,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代上谯太尉","author":"刘过","text":"叮咛天语听传呼，吒咤雷霆压万夫。\n泽国使临殊玉节，彤墀香近惹金炉。\n庆逢龙跃风云阔，职有蝉联父子俱。\n援手坠渊馀事耳，故人有子在泥途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28854,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代寿韩平原 其五","author":"刘过","text":"宇宙之间物物春，戚疏曾不间陶钧。\n裔分裴皞东西眷，谊笃嗣宗南北邻。\n中令诸孙难遍识，栖筠俗子老堪亲。\n试捐内举拘挛迹，无异平原十九人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28855,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代寿韩平原 其一","author":"刘过","text":"衣钵登庸复旧毡，文王尚父赵平原。\n自从庆历到今日，只说开禧初改元。\n朝辟东斋广东阁，夜看南极照南园。\n九霞觞举先旬浃，却领千官寿帝垣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28856,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代寿韩平原 其三","author":"刘过","text":"畴昔张旃过相时，相人争睹汉官仪。\n未能劖刻燕然石，不忍摩挲昼锦碑。\n慷慨欲平千载恨，经营已叹十年迟。\n要令阅古诗篇伟，好读车攻复古诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代寿韩平原 其二","author":"刘过","text":"际会风云振古难，十年袖手且旁观。\n要令邻敌尊裴度，必向东山起谢安。\n一品千龄灵寿杖，五公四世进贤冠。\n功成裂地封留了，却趁赤松盟未寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"对雪效乐天","author":"刘过","text":"匣中雷吼一长剑，溪上月明多少舟。\n无贼可平閒李愬，有人不访倦王猷。\n银杯缟带从渠便，瑶树琼林得自由。\n衣敝独嫌灰絮料，帘高想见月垂钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再游仪真呈张使君","author":"刘过","text":"江淮冠盖闹如林，求一己知何处寻。\n风月欲谈嫌许事，山川不险似人心。\n使君德量如天远，举子科名自陆沉。\n秋气未悲先泪下，黄花虽好不曾簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同许从道登琼翠阁","author":"刘过","text":"清潭石洞游俱遍，最后来寻此阁遨。\n树木满林成芘荫，溪山围县恰周遭。\n结交有味贫何害，薄酒虽村饮亦豪。\n明日重阳吾未去，更于何处可登高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同郭殿帅游凤山寺探桃李","author":"刘过","text":"廉纤小雨久于梅，喜得晴新亦快哉。\n五色波光丽鳷鹊，十分云气近蓬莱。\n旌旗侧畔宫墙转，戈戟丛中武库回。\n走马看花生怕晚，果然桃李一山开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同曹元章游新安寺","author":"刘过","text":"畏暑倦杯酌，修廊散步行。\n寺深藏古意，蝉老带秋声。\n去就诸缘薄，穷通一念轻。\n更寻水清处，为我濯尘缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晚","author":"刘过","text":"手种疏梅已发妍，相从三过客中年。\n吾生岂得须如意，随处何妨且信缘。\n风月心多时小醉，轩裳梦少且闲眠。\n万人海里能如此，是自在禅并散仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次刘启之韵","author":"刘过","text":"豪结交游三十年，暮年识子海霜边。\n江西析派诗同社，鸿宝传家子已仙。\n无用白须甘我老，有才青眼望谁怜。\n譬如飘泊湓城下，篁竹萧疏无管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次吕簿池亭韵","author":"刘过","text":"举杯邀月到幽塘，八月波心碎夜光。\n倒影帘花翻翠色，飞梭锦段织红芳。\n是中有客供千首，此外无尘染六郎。\n昨夕主人閒立久，一身风露带天香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次张昌化合溪新亭韵 其二","author":"刘过","text":"燕尾溪流上下分，中馀里许地翻平。\n林疏邑屋高低见，水涨舫船来往轻。\n坡老已仙谁杰作，诗人为县得重评。\n唐山见说双溪馆，今见双溪亭又成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次张昌化合溪新亭韵 其一","author":"刘过","text":"不碍溪流水不平，主人平处主鸥盟。\n两峰呈秀出天造，双涧同流到地清。\n尚忆经过曾对酒，欲来登览恨无名。\n仙凡咫尺红尘隔，草草题诗亦浪评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"聿追庵题壁","author":"刘过","text":"路转羊肠曲，山藏蜗角深。\n树多成荫密，水少亦悲吟。\n露草重阳泪，风花寒食心。\n摩挲墓铭看，久立读碑阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自述 其二","author":"刘过","text":"精神凋耗鬓毛衰，劫火光中第几回。\n无可奈何教老去，有时猛省忽愁来。\n师崇道学原非伪，客寄苏州却类呆。\n明日重阳又佳节，得钱且醉菊花杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自惭","author":"刘过","text":"一榻留人去便垂，自惭非友亦非师。\n初无伎俩惟贪酒，遇有工夫或赋诗。\n晒日枣林红磊落，响风桐叶碧参差。\n人家正做鲈鱼鲙，老子秋来却自悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中","author":"刘过","text":"下水南风未觉难，我舟不动稳如山。\n东西日月寻常事，变化烟云顷刻间。\n沙鸟似惊皆退避，林峦如画亦浑閒。\n归期只欲长安近，屈指何时到北关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中偶作","author":"刘过","text":"日日拖舟上碧溪，寒滩水浅草离离。\n尺书雁断岁行尽，五两风轻帆去迟。\n白鹭导吾如有志，丹枫愁客亦何为。\n关头要趁梅花约，更著宽程五日期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟次富池寄九江诸公","author":"刘过","text":"既无文彩又颠狂，五十馀年梦一场。\n错认我为林子晦，也教人唤贺知章。\n樽前鹤翅从谁舞，老去槐花尚自忙。\n船解酒醒人不见，长江万里水茫茫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖次弟润之韵","author":"刘过","text":"旧说西湖好，春来更一游。\n林逋山际宅，苏小水边楼。\n行密柳堤闹，树多花影稠。\n天堂从此去，真个说杭州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖别舍弟润之","author":"刘过","text":"几度归程入梦间，秋鸿社燕两为难。\n西湖半夜风雨急，交泗一床心胆寒。\n落第我为中酒味，圜桥子亟洗儒酸。\n臂弓秣马长淮去，莫笑狂夫老据鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观白鹭洲风涛","author":"刘过","text":"一声雷鼓挟风威，顷刻冲涛没钓矶。\n行客骇看银汉落，阳侯惊起玉山飞。\n蛟龙便尔争先化，鸥鹭茫然失所依。\n安得长竿入吾手，翩然东海钓鳌归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过泰和宫","author":"刘过","text":"林塘漠漠乱花飞，门掩苍苔过客稀。\n蝴蝶与身俱是梦，杜鹃怜我几时归。\n徐行便当篮舆稳，清话何妨羽扇挥。\n四十九年蘧伯玉，此生毕竟是邪非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初伏阙上书得旨还乡上杨守秘书 其一","author":"刘过","text":"郡大庐陵古，分符得秘郎。\n息争民珥笔，课最米连樯。\n水隔蓬山远，风凝画戟香。\n少须官事了，归去玉为堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初伏阙上书得旨还乡上杨守秘书 其二","author":"刘过","text":"百计归无策，谁知祸有胎。\n江河周顗泣，城郭令威来。\n访旧须俱白，过家心欲摧。\n故乡非不好，不是锦衣回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴尉东阁西亭 其二","author":"刘过","text":"石板桥东阁，轩窗如此华。\n碧虚澄水鉴，红影侵霜花。\n似串歌云驻，如泥醉帽斜。\n但惊风露冷，飘落怕还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴尉东阁西亭 其一","author":"刘过","text":"袭桂行香径，朱栏稍转西。\n水风飕石冷，云月堕檐低。\n棋败深杯罚，诗豪健笔题。\n舞忙钗鬓乱，更为捧柔荑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈李漕 其二","author":"刘过","text":"尘埃破帽倦骑驴，一雨穷途快有馀。\n盆盎自天倾屋瓦，龙蛇平地起阶渠。\n冷侵絺绤觉太甚，声满梧桐殊不疏。\n口业未偿诗有债，夜深灯大小窗虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈李漕 其一","author":"刘过","text":"默祷神仙政隐忧，天心人意已周流。\n旱苗已槁七八月，甘雨如期十五州。\n风月冷吹云梦晚，水花新浸武昌秋。\n异时白粲输官处，知有丰年万斛收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"呈胡季解","author":"刘过","text":"老病颠狂药不医，粗豪骂坐欲何为。\n前生纵使希真是，已死尚存忠简知。\n颠倒六经鸲鹆舞，澜翻一曲竹枝词。\n虽然结袜王生僭，人以此贤张释之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿建康太尉","author":"刘过","text":"万里寒风一布袍，特将诗句谒英豪。\n正当武曲临凡世，恰值骊龙出海涛。\n五马尽投千岁鹤，六军急献万年桃。\n不因此日沧溟近，一钓那能得巨鳌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和大参相公 其一","author":"刘过","text":"松深烟锁径，月冷水明楼。\n日涨沧溟窄，山阴古木秋。\n琴书超物表，气宇识神游。\n突兀东南壮，乾坤第一流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和大参相公 其三","author":"刘过","text":"山邃龙蟠屈，江昏蜃吐楼。\n撞钟千百指，阅世八千秋。\n僧笑衣冠累，天容杖屦游。\n松梢清影碎，薄月带沙流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和大参相公 其二","author":"刘过","text":"气压三千界，云横百尺楼。\n地灵绝兴替，木老阅春秋。\n杖屦逍遥步，琴书汗漫游。\n利名空役役，回首愧禅流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子纯韵","author":"刘过","text":"桥下水如箭，惊奔万古号。\n溪毛翻碧带，石藓衬银涛。\n天外千层秀，云低数尺高。\n垂垂兴偏恶，蓬鬓为诗搔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和印监寺玉簪花","author":"刘过","text":"得得寻芳听自由，名花先占八分秋。\n鹭鸶折股晚风冷，姑射遗簪胜地幽。\n霜叶皱痕罗扇薄，香苞破处雪衣柔。\n一瓶一钵休岑寂，骑鹤腰钱岂易谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和都干并柬允道","author":"刘过","text":"老子声名旧白眉，客窗相款话心时。\n相犹忘我吾无法，骨已换仙君有诗。\n莼菜羹香春冉冉，鹿游台上草离离。\n一樽吊古平章看，未羡君王郡牧麾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏余商卿栀子花","author":"刘过","text":"香不求知色自然，朝来何许雪华鲜。\n如行佛国参知识，未嫁仙姿益净娟。\n梅子已黄犹夜雨，客游方倦作春眠。\n地卑山近征衣润，不费熏炉一炷烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜思中原","author":"刘过","text":"中原邈邈路何长，文物衣冠天一方。\n独有孤臣流血泪，更无奇杰叫天阊。\n关河夜月冰霜重，宫殿春风草木荒。\n犹耿孤忠思报主，插天剑气夜光芒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"姑苏送王武冈不值访汪仲冕席上口占","author":"刘过","text":"严城夜出鼓鼕鼕，画鹢三更不见踪。\n何必披云寻乐广，真成避雨识茅容。\n藓花似雪玲珑白，腊酒如春琥珀浓。\n若使世间无我辈，老夫何处不穷冬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建业酒楼落成预点灯","author":"刘过","text":"高楼百尺久摧颓，轮奂重新亦壮哉。\n彻夜笙歌催腊尽，聒天箫鼓挽春回。\n都人杂沓挥千镒，我辈登临谩一杯。\n京国繁华欣再睹，老来醉眼更堪开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"招义铭育王见佛照","author":"刘过","text":"豪杰书生懒散仙，小庵藏迹得安閒。\n禅曾勘破诸公去，诗在推敲一字间。\n夜雨滴残梧叶老，夕阳行处水花悭。\n买舟便欲乘风去，孤绝同游海岛山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"放翁坐上","author":"刘过","text":"林雾霏霏晓意凉，野栀才放已传香。\n幸哉世事日相远，怪底诗情老更狂。\n腊蚁三杯浮重碧，春膏一幅砑轻黄。\n何如放浪形骸外，尽乞江湖作醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊船吴江县","author":"刘过","text":"草树连塘岸，人家半橘洲。\n暖寒寻酒去，觉懒罢诗休。\n逆境年年梦，劳生处处愁。\n天涯倦行客，明日又苏州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵雪中","author":"刘过","text":"风幻寒威夜扑人，晓看云脚四垂阴。\n牧羝塞上功名泪，骑马蓝关窜逐心。\n冷面不春愁菀结，冻须如铁恐萧森。\n昼炉醉拨灰为字，不为閒思煖帐金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨作妨登山 其三","author":"刘过","text":"杖履飘然不整巾，缘何问得梵王城。\n淡烟翠湿千螺皱，微日烟消一纸轻。\n隔山鸟语如人语，触处风声若水声。\n见说一犁今已足，笑歌蓬首饷夫耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨作妨登山 其一","author":"刘过","text":"莫笑林宗折角巾，雨师坚壁助愁城。\n菰蒲乍冷横烟淡，鸥鹭惊秋立水轻。\n山势欲穷犹有路，溪流似断又闻声。\n好怀聊拟携筇去，政惬农夫荷笠耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南康天开图画楼","author":"刘过","text":"楼外烟波渺去鸿，楼头庐阜翠摩空。\n故知造物铺张巧，不费丹青点染工。\n赤壁江山横夜月，辋川庭馆卧秋风。\n祇今满地无图画，尽在西湾杳霭中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南康邂逅江西吴运判 其二","author":"刘过","text":"万里西征一叶舟，谁怜天地此生浮。\n初征秋浦雁飞处，又泊江南霜叶洲。\n贫困尽从归后见，雄豪半为病来休。\n十年心事閒搔首，荻雨芦风总是愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南康邂逅江西吴运判 其一","author":"刘过","text":"一节西来已骇传，不堪归去便湘川。\n舟行彭蠡轻文种，酒到浔阳醉乐天。\n台谏久无公议论，朝廷新有骤除迁。\n臣心毕竟终忧国，不敢瞻乌涕泫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"幽居","author":"刘过","text":"对面沧浪可濯缨，不思泛舸出春城。\n浮沈枌社何人重，俯仰茅檐是事轻。\n玉蕊连屏寒徙倚，蒲萄上架月纵横。\n江湖老矣无他愿，只欲清阴便得成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挂搭松窝","author":"刘过","text":"十年南北走东西，豪气峥嵘老不衰。\n快斩妖魔三尺剑，朗吟风月五言诗。\n山无福地吾焉往，神有灵丹世不知。\n却恐松窝知此意，一丝挂搭去何疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日即事 其一","author":"刘过","text":"久客无人问所须，小窗翻得逐痴愚。\n黄昏以后酒三盏，白日之间饭两盂。\n谷雨笋茶俱俊美，条风杞菊竞甘腴。\n先贤且谓可行乐，况是平生山泽癯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日即事 其二","author":"刘过","text":"出门虽是欠陶朱，便使关门亦可居。\n物价甚廉常食肉，佣赀极省易钞书。\n已安栎社如无用，若比丛林似有馀。\n归与未归天上事，只消如此看何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雨寄徐东阳","author":"刘过","text":"和州昔有贤从事，今作东阳父母官。\n百里望风皆畏易，四郊得雨及时难。\n秋成有望米价减，水满不争民业安。\n诗句定多公事少，不妨閒写寄人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春游","author":"刘过","text":"东风镇日倚阑干，浅红深绿取次攀。\n麦陇浪翻袍色绿，花钿风卷锦纹斑。\n依林僧寺青山绕，倚竹人家绿水环。\n趁取春光未狼藉，不嫌日日到花间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洞霄宫","author":"刘过","text":"杖藜随步到琼宫，满目幽奇景莫穷。\n山锁九层虽极远，洞庭五处自相通。\n侵云天柱笼朝雾，傍水清阴弄晚风。\n可惜春禽啼晓月，又催行李过江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送友人得馆游南康","author":"刘过","text":"匏大从来速售难，依人高戴误儒冠。\n江南又客诸侯去，梅子愁人四月寒。\n半世光阴旋蚁磨，百年举子上鱼竿。\n世间多少不平事，盍向庐山静处看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王东乡归天台 其二","author":"刘过","text":"千岩万壑天台路，一日分为两日程。\n事可语人酬对易，面无惭色去留轻。\n放开笔下閒风月，收敛胸中旧甲兵。\n世事看来忙不得，百年到手是功名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送刘从周教授","author":"刘过","text":"凤阁鸾台次第留，此生何必为身谋。\n工夫到易通三圣，洁白持身第一流。\n桑梓静思如子少，萍蓬自叹此生浮。\n还乡若有过从便，会尽人间只点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]