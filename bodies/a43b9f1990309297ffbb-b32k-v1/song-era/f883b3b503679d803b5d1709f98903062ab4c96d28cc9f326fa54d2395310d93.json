[{"title":"鹧鸪天 其三 雨后湖上看落花","author":"叶梦得","text":"小雨初收报夕阳。\n归云欲渡转横塘。\n空回雨盖翻新影，不见琼肌洗暗香。\n追落景，弄微凉。\n尚馀残泪浥空床。\n只应自有东风恨，长遣啼痕破晚妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其二 元夕次韵干誉","author":"叶梦得","text":"夹路行歌尽落梅。\n篆烟香细袅寒灰。\n云移碧海三山近，月破中天九陌开。\n追乐事，惜多才。\n车声遥听走晴雷。\n十年梦断钧天奏，犹记流霞醉后杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其六 与鲁卿晚雨泛舟出西郭，用烟波定韵","author":"叶梦得","text":"天末残霞卷暮红。\n波间时见没凫翁。\n斜风细雨家何在，老矣生涯尽个中。\n惟此意，与公同。\n未须持酒祝牛宫。\n旁人不解青蓑意，犹说黄金宝带重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其四 续采莲曲","author":"叶梦得","text":"晓日初开露未晞。\n夕烟轻散雨还微。\n暗摇绿雾游鯈戏，斜映红云属玉飞。\n情脉脉，恨依依。\n沙边空见棹船归。\n何人解舞新声曲，一试纤腰六尺围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 其五 次韵鲁卿大钱观太湖","author":"叶梦得","text":"兰茝空悲楚客秋。\n旌旗谁见使君游。\n凌云不隔三山路，破浪聊凭万里舟。\n公欲去，尚能留。\n杯行到手未宜休。\n新诗无物堪伦比，愿探珊瑚出宝钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武夷九曲","author":"叶梦鼎","text":"兴穷九折更悠然，棹转船头障去川。\n留取洞中无尽意，桃花水暖鳜鱼天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武夷鼓楼岩","author":"叶梦鼎","text":"鼓楼岩下鼓楼开，举世邯郸梦未回。\n安得老鼍教唤起，万人醒眼上山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建府戊午鹿呜宴","author":"叶梦鼎","text":"黄堂燕衎盛衣冠，人道魁星照建安。\n多士权衡推月旦，一番桃李属春官。\n升歌鸣鹿陪樽俎，好与溟鹏插羽翰。\n发策致身须正学，功名久远要人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"隔竹","author":"叶梦鼎","text":"隔竹斜阳唤小舟，寥寥天柱访仙游。\n风声树杪疑笙鹤，云气峰头见翠虬。\n凡骨面岩那可蜕，尘容镜水只包羞。\n几时肝胆无羁靮，卧看中天素月流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瀛洲亭","author":"叶梦鼎","text":"汝城高处著危阑，人在苍寒缥缈间。\n下瞰无边春境界，西来第一处江山。\n酒拈重碧酣诗思，柳曳轻黄入笑颜。\n阁老可能专此胜，蛾眉花底又催班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅林八景总咏","author":"叶梦鼎","text":"黄墩巨海通昌国，花园大路连西域。\n九顷农歌乐丰年，赤山牧唱喧朝夕。\n罗溪流水出通潮，仕岆高山古贤迹。\n方寺钟声诵善音，桃源击鼓评民籍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"叶梦鼎","text":"芦笋满洲银鲙美，琼花滴露玉醅醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大慈寺","author":"叶清臣","text":"佛陇光沉茂草平，树林犹作诵经声。\n一心三观休分别，秋净山高海月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"国清寺","author":"叶清臣","text":"绀宇初成国已清，千灵慈护属仁明。\n山僧了得真空观，好续炉薰傲太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"广惠寺","author":"蔡清臣","text":"云中老树冷萧萧，溪上僧归倚画桡。\n谁为秋风乘兴去，松窗先听富阳潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"先照寺","author":"叶清臣","text":"一径凉飙响万松，青霞紫雾秘灵峰。\n寒生列洞前溪雨，声到诸天午夜钟。\n仙顶月高犹驾鹤，阴潭云起旧降龙。\n出尘境界无多地，已上金庭第七重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送馀姚知县陈最寺丞","author":"叶清臣","text":"旧见恩初渥，新游刃久虚。\n官曹鹊树下，民版象耕馀。\n山迥人逢麂，江清客厌鱼。\n送君多怅望，云外是亲居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送梵才大师归天台","author":"叶清臣","text":"江水望不极，杨花江面飞。\n春风自无定，远客又言归。\n景胜诗逾老，心冥语亦稀。\n从来林下意，为谢北山薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得请宣城府","author":"叶清臣","text":"理剧惭心计，承颜念远游。\n时情自轻外，天幸复临州。\n霜馆残梨晓，风淮水桂秋。\n官勤诗意减，先愧谢公楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东池诗","author":"叶清臣","text":"园林日将暮，缅怀池上酌。\n轻烟隐孤屿，绿水摇虚阁。\n人闲山鸟静，风馀岸花落。\n稚子晚荡归，扁舟自飘泊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"累日前伏蒙袖书临访并小文编及明堂图披玩寻绎弥增景服偶书二百四十言以伸谢臆伏惟采览","author":"叶清臣","text":"进士不读书，明经不根义。\n诟病君子儒，于今作文弊。\n礼部右词赋，诸生窃科第。\n从道不违人，追趋斯近利。\n李生何为者，力学务逊志。\n羞耻事章句，深湛刺经艺。\n常惟天子贵，无大明堂位。\n邈焉三代风，鲜矣百世继。\n去圣日逾远，攻端非其致。\n公玉既妄图，戴德亦缪记。\n汉唐盛容典，规画不足示。\n其间区区者，何暇盛德事。\n确论无甚高，阔讲寖而坠。\n披文会今古，援笔考同异。\n面势本周官，纤悉探吕氏。\n俛拾林甫长，仰擿康成盩。\n昭发老生矇，冥符作者意。\n圣期接千统，缛礼恢万祀。\n无文既已秩，同节此云备。\n宁当总章法，未揽云台议。\n废兴有时合，聪明自民视。\n成厦繄众材，至理岂一士。\n南阙朝奏书，中朝夕鸣佩。\n行矣无自遗，日中今可熭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游摄山栖霞寺","author":"叶清臣","text":"仙峰多灵草，近在东北维。\n僧绍昔舍宅，总持尝作碑。\n高风一缅邈，废宇亦陵迟。\n清泉漱白石，霏雾蒙紫芝。\n松萝日萧寂，猿鸟自追随。\n游人鲜或诣，隐者谁与期。\n支郎笃清尚，千里孤云飞。\n览古玩青简，寻幽穷翠微。\n顾予荷戟守，出宿简书违。\n凭师访陈迹，剩作摄山诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题石桥","author":"叶清臣","text":"觉雄示入灭，尊者俱授记。\n现彼声闻身，护此浊恶地。\n他方自感通，此地真灵秘。\n一路指桥西，谁明导师意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江南好/忆江南","author":"叶清臣","text":"丞相有才裨造化，圣皇宽诏养疏顽。\n赢取十年闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺圣朝 留别","author":"叶清臣","text":"满斟绿醑留君住。\n莫匆匆归去。\n三分春色二分愁，更一分风雨。\n花开花谢、都来几许。\n且高歌休诉。\n不知来岁牡丹时，再相逢何处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西阳岭","author":"叶维瞻","text":"杜鹃啼处花成血，燕子忙时麦未胎。\n举世但知春易老，不知春老几人来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"摸鱼儿","author":"叶阊","text":"倚薰风、画阑亭午。\n采莲柔橹如语。\n红裙溅水鸳鸯湿，几度云朝雨暮。\n游冶处。\n最好是、小桥芳树寻幽趣。\n绣帘低护。\n任凉入霜纨，月侵冰簟，长夏等闲度。\n都如梦，怅望游仙旧侣。\n遗踪今在何许。\n愁予渺渺潇湘浦。\n槛竹空敲朱户。\n黯无绪。\n念多情文园，曾草长门赋。\n酒酣自舞。\n笑满袖缁尘，数茎霜鬓，羞杀照溪鹭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烟雨楼","author":"叶隆礼","text":"傍家亭馆占湖东，寂寞为邻祗陆公。\n竹树一堤如有碍，乾坤万象自无穷。\n棹歌远入秋波绿，塔影中分晚照红。\n尊酒待游烟雨景，画图著我笠蓑翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兰陵王 和清真","author":"叶隆礼","text":"大堤直。\n袅袅游云蘸碧。\n兰舟上，曾记那回，拂粉涂黄弄春色。\n施颦托倾国。\n金缕尊前劝客。\n阳台路，烟树万重，空有相思寄鱼尺。\n飘零叹萍迹。\n自懒展罗衾，羞对瑶席。\n折钗分镜盟难食。\n看桃叶迎笑，柳枝垂结。\n萋萋芳草暗水驿。\n肠断画阑北。\n寒恻。\n泪痕积。\n想柱雁尘侵，笼羽声寂。\n天涯流水情何极。\n悲沈约宽带，马融怨笛。\n那堪灯幌，听夜雨，镇暗滴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芹溪八咏 其六 砚峰晴雪","author":"叶善夫","text":"登楼眺望雪晴天，银作高山玉作田。\n最好夜深明月上，素娥滕六斗婵娟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芹溪八咏 其三 芦峰夕照","author":"叶善夫","text":"云谷山高列画屏，晚来尽对更多情。\n烟凝紫翠斜阳里，一幅丹青写不成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芹溪八咏 其七 山寺晚钟","author":"叶善夫","text":"数尽寒鸦日已昏，疏钟隐隐隔林闻。\n僧归林下柴门静，声逐前村一片云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芹溪八咏 其八 插云三峰","author":"叶善夫","text":"笔架三峰插碧虚，午来倒影落平湖。\n凭高最好供吟笑，宜入王维画里图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芹溪八咏 其一 子期丹灶","author":"叶善夫","text":"何人辟谷砚山隈，洞府藤萝锁不开。\n炼就金丹乘鹤去，药炉烟冷未归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芹溪八咏 其五 桃源别墅","author":"叶善夫","text":"高人栖隐向山林，林壑幽清绝俗尘。\n当日武陵人已老，谁知犹有种桃人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芹溪八咏 其二 龙潭秋月","author":"叶善夫","text":"月光如水水连天，万顷玻璃浸碧渊。\n一颗骊珠收不去，几回惊起卧龙眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芹溪八咏 其四 芹溪小隐","author":"叶善夫","text":"芹溪处士古人风，宝剑尘埋未化龙。\n旧隐至今名不朽，扁题元出紫阳翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒翠亭","author":"叶堪之","text":"管领江山胜，无如寒翠亭。\n一朝成土梗，万象蔽林坰。\n且喜新经理，犹存旧典刑。\n为留亭柱句，姑以代镌铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿汤吏部","author":"叶巽斋","text":"朔风烈烈吹繁霜，天地闭塞阳气藏。\n玄冥恣横生育息，万类郁结无辉光。\n东皇爱物怜下土，斡旋造化回机杼。\n新阳用事阴类消，爱命崧高降申甫。\n精神秀发气宇新，造化局量推宽仁。\n未施商鼎盐梅手，且转江城草木春。\n江城民繁事业脞，公私煎熬急汤火。\n我公下车政化新，雨露恩深民帖妥。\n湖山千里和气中，卖剑买牛施农功。\n雪消畦麦弄春色，雨过女桑摇暖风。\n裤襦歌声沸田里，象魏教条挟都鄙。\n东山虽惜我公归，安石当为苍生起。\n新春乐土人熙熙，冥寝凝香昼景迟。\n金莲舞罢歌一曲，瑶觞照席光陆离。\n流霞潋滟玻瓈盏，玉悄轻浮露华满。\n西来王母献蟠桃，天锡灵砂丹九转。\n愿公一醉饮千钟，仙姿不老颜长红。\n正位钧衡等箕翼，尽纳群生箕翼中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月 其一","author":"叶巽斋","text":"维此十月，岁聿云暮。\n惟月之良，是谓盈数。\n阴极于坎，阳比于子。\n阴阳消长，否泰攸寓。\n亶生哲人，盛世基柱。\n文章机略，册府武库。\n承明厌居，雄藩外护。\n吏畏民爱，颂声载路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 寿王簿","author":"叶巽斋","text":"冬岭秀乔松，江南飞雪。\n数朵梅花弄春色。\n玉颜苍鬓，人似松梅标格。\n岁寒长不老，人奇绝。\n簿领馀间，长生有道，福寿从今更千百。\n孙枝浸盛，万卷家传方册。\n樽前频醉，此宵风月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其二","author":"叶景山","text":"杨柳池塘桃李径，华堂寿宴初开。\n香团翠幕舞风回。\n东山携妓女，北海罄樽罍。\n玉笋轻敲红象板，金荷潋潋传杯。\n笙歌缭绕宴春台。\n华阳闲日日月，绿野醉蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"临江仙 其一","author":"叶景山","text":"清晓于门开寿宴，绮罗香袅芳丛。\n红娇绿软媚光风。\n绣屏金翡翠，锦帐玉芙蓉。\n珠履争驰千岁酒，葡萄满泛金钟。\n人生福寿古难逢。\n好将家庆事，写入画图中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩 寿越总管","author":"叶景山","text":"十月小春时，蓂舒六翠。\n天佑皇家诞贤裔。\n熊罴协梦，疑是麒麟分瑞。\n世间无限事，都如意。\n粉阵香围，香娇玉媚。\n春酒争持泛琼蚁，笙歌缭绕，同祝我公千岁。\n他年陪绿野，拚酣醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"感皇恩","author":"叶景山","text":"春水满池塘，春风吹柳。\n春草茸茸媚晴昼。\n春烟骀荡，春色着人如旧。\n春光无限好，花时候。\n春院宴开，春屏环绣。\n春酒争持介眉寿。\n春衫春暖，春回遏云声透。\n春年常不老，松筠茂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过子陵钓台","author":"叶棐恭","text":"势利轻捐寄傲中，毅然高节凛秋风。\n耕閒钓寂千年迹，立懦贪廉万世功。\n须信林间无怨鹤，更知天外有冥鸿。\n扁舟夜泊灵祠下，慨慕先生道不穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白鹭亭次罗公愚韵","author":"叶辉","text":"白鹭洲边敞此亭，淮山江水瞰芦汀。\n鹭飞点点星颜色，那似公山鹤有灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏清凉寺竹","author":"叶辉","text":"茂林修竹绿侵云，清到心君赖有君。\n李主当年饱凉后，民间苦热几曾闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"驻马坡","author":"叶辉","text":"将军气势溢江河，跃马曾来驻此坡。\n坡下石头城最险，屯兵正自不消多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秦淮次北谷罗叠韵","author":"叶辉","text":"人言王气在鄣州，嬴政因来凿此流。\n地脉何曾真断得，几多天子御宸楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺王伯愚登第 其一","author":"叶寘","text":"先君有女尝择对，玉雪王郎真可人。\n连榜舍升俱伯氏，中兴家世最名臣。\n回翔璧水十年旧，踊跃龙门三月新。\n从此青霄腾踏上，久知陈孺不长贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿陈监丞","author":"叶寘","text":"岷峨之秀如云起，前有三苏后三李。\n三苏专以节行闻，三李相承最工史。\n两家百年成美谈，盛事胡不云东南。\n春风楼前拥三山，秀出君家父子三。\n玉佩琼琚词大放，宏博取科迹相望。\n演纶妙体王者言，下笔仍裁舍人样。\n君于兄弟尤白眉，天质宽厚心平夷。\n如舟万斛方整棹，驾扬稳听天风吹。\n道山蓬莱陈几席，自当席草宫门北。\n玉堂深处觉天低，金锁开时分夜直。\n人生穷达惟两途，富贵外物如锱铢。\n生朝相祝何所如，导引愿与栾城俱，名节要当参长苏。\n凛然天地相终始，何独扁舟载五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺王伯愚登第 其二","author":"叶寘","text":"世无羔雁到林泉，惟有登科路坦然。\n我亦门阑多喜色，君今衣钵得家传。\n龙旗方照三千字，虎榜争趋五百仙。\n莫道中年情态薄，华涂名节尽加鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送玉面狸与月湖","author":"叶寘","text":"迎阳舐掌餐朝霜，虎额分白狐裘黄。\n野人供之未敢尝，聊比涧沚溪毛将。\n方其潜遁嵌空去，塞向固然知墐户。\n藏身为地抑何拙，令人开户知其处。\n贵重荣称玉面郎，尾以牛后誇奇章。\n世间丑好谁争强，贤否一语由臧仓。\n谂季狸兮美南国，范我驰驱非诡获。\n衣褐褐见脱脱兮，雪绰通身妙藏白。\n人言可以贡金门，芹美犹云欲献君。\n倘幸珍称供玉食，全胜肥遁老丘园。\n侑以诗篇烦笔削，诗欠活眼觅一著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送熊掌熊白","author":"叶寘","text":"熊掌舍鱼吾有取，自幼尝闻子车语。\n饭香猎户分熊白，妙语涪翁乃能吐。\n世间两味果称珍，故人念我肯珍分。\n数千里致良不易，食美真当持献君。\n从小知尝熊胆苦，人不通今宁识古。\n熊皮兀坐二十年，毛去皮存缝谁补。\n人言穷命有时通，老翁八十卜非熊。\n试将两味从公卜，世间真有磻溪翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木寂院","author":"叶槐","text":"为爱莲塘水石幽，画桥斜日任迟留。\n两山云出□□雨，一叶风来断送秋。\n滚滚流年愁里度，凄凄明月暗中投。\n何时谷口归耕去，种得黄粱饱即休。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汪水云诗卷","author":"叶福孙","text":"今雨水云来访我，西窗剪烛话辽东。\n百千万事掷天外，一十四年如梦中。\n琴到拙时方得趣，酒于愁处恰收功。\n明朝又挂孤帆去，江海茫茫正北风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"占贮橘子","author":"叶简","text":"圆如珠，赤如丹，倘能擘破分吃了，争不惭愧洞庭山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南雁西洞","author":"叶群","text":"石门深窅锁丹霞，倚马西风日欲斜。\n幽境已无尘俗气，白云尚有翠微家。\n林间摘句书红叶，涧底烹泉带落花。\n向晚且从西洞息，碧山明月正堪赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头 寿太守黄少卿","author":"叶路钤","text":"天启黄旗运，复见汉黄香。\n名高黄榜，飞黄腾踏入鸳行。\n文彩苏黄而上，政事龚黄而右，黄纸选循良。\n黄见眉间色，卿月照黄堂。\n调黄钟，舞黄鹤，醉鹅黄。\n黄云催熟，黄童老叟庆金穰。\n闲展黄庭一卷，自爱黄花晚节，黄阁日偏长。\n印佩黄金斗，黄发半苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 寿吴权郡","author":"叶路钤","text":"伛指循良吏。\n祗吴公、传不书名，一人而已。\n彷佛三生来展骥。\n就种棠阴千里。\n又还是、治平为最。\n绣线渐添红日影，恰搀前、七日冬书至。\n吾道长，佛出世。\n公清但酌螺川水。\n屏星躔次吴头，极星先比。\n节谊家声香国史。\n中有千秋生意。\n宜衮衮、公侯昌炽。\n充育登庸元有样，况甬东、一脉山东气。\n珠峰畔，又呈瑞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":23704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]