[{"title":"读本朝事有感十首 其三","author":"刘克庄","text":"晚遭吕范攻尤峻，死辟荆舒恨未销。\n举世共非前濮议，无人细考后尊尧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30403,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读本朝事有感十首 其二","author":"刘克庄","text":"力荐资深入柏台，独延吉甫客翘材。\n如何岁晚钟山寺，只见黄州副使来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30404,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祖饯三山赵茂实二首 其二","author":"程公许","text":"三生岩壑姿，失脚红尘踏。\n羡君得郡去，胜事踵康乐。\n云海渺无津，烟霞互开阖。\n似闻石门藓，犹带屐齿蜡。\n惜哉荒游误，竟为时论薄。\n秉谊以事君，奚间暌与合。\n矧是侯社贵，艰哉保障托。\n宣室恐渴思，趣归职献纳。\n我拙念请閒，雁荡恣飞屩。\n及君留郡斋，为我拂尘榻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30405,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读汤伯纪大人赋","author":"刘克庄","text":"此赋何曾涉怪神，本诸孔孟体诸身。\n乃知犬子揄扬者，才是僬侥国里人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30406,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读阮籍传一首","author":"刘克庄","text":"言出勿令圭有玷，舌扪不及驷难追。\n阮公托醉劝进表，庞老无名受禅碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30407,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读严光传二首 其二","author":"刘克庄","text":"羊裘素不习朝仪，公遣西曹屈致之。\n道是君痴君不服，巢由安肯见皋夔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30408,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读严光传二首 其一","author":"刘克庄","text":"一栖岩壑一冲霄，冠履联翩建武朝。\n招得故人来话旧，也呼文叔作唐尧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30409,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读秦纪七绝 其一","author":"刘克庄","text":"黔首死于城者众，杞梁身直一微尘。\n不知当日征入妇，亲送寒衣有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30410,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读秦纪七绝 其四","author":"刘克庄","text":"人所难言敢纳忠，祖龙虽暴却英雄。\n同时见者皆齑粉，肯活茅焦沸鼎中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30411,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读秦纪七绝 其七","author":"刘克庄","text":"通国无人敢挟书，峄山碑自篆虫鱼。\n至今览者赏奇古，先汉文章已不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30412,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读秦纪七绝 其三","author":"刘克庄","text":"秦贱儒冠贵鞅斯，士生此际命如丝。\n可怜聚议骊山下，骈首趋坑尚未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30413,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读秦纪七绝 其二","author":"刘克庄","text":"匈奴驱向长城外，当日蒙恬计未非。\n欲被筑城夫冷笑，辒凉车载鲍鱼归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30414,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"起来","author":"刘克庄","text":"起来呵手检衣篝，烛影蛩声伴小楼。\n赖有梦中堪细说，锦笺写不尽离愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30415,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"高光","author":"刘克庄","text":"发兵坑黥布竖子，踞洗骂隋何腐儒。\n谁道东都重名节，故人只唤作狂奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30416,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶题二首 其二","author":"刘克庄","text":"莫耗官仓粟，休贪御手羹。\n新年采薇食，诗比旧年清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30417,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶题二首 其一","author":"刘克庄","text":"自幼耽章句，年高竟未工。\n自称豁达老，人号嗫嚅翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30418,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"商妇词十首 其十","author":"刘克庄","text":"自说居奇货，人知有贩心。\n相如小商尔，卖赋得千金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30419,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"商妇词十首 其九","author":"刘克庄","text":"昔梦随君去，犹疑在我傍。\n素惭倾国色，旋学入时妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30420,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"商妇词十首 其八","author":"刘克庄","text":"道远书筒少，时难旅橐垂。\n花飞春事过，柳暗晓妆迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30421,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"商妇词十首 其七","author":"刘克庄","text":"粉堞五七里，青帘三四家。\n客沽北府酒，女唱后庭花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30422,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"商妇词十首 其六","author":"刘克庄","text":"月夕孤单女，天涯放逐臣。\n偶逢顾曲客，忘却买茶人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30423,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"商妇词十首 其五","author":"刘克庄","text":"客梦嫌鸡早，归心恨马迟。\n感君留半镜，教妾画新眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30424,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"商妇词十首 其四","author":"刘克庄","text":"蜮含沙射影，鳄以尾勾人。\n不是妾饶舌，愿言君爱身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30425,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"商妇词十首 其三","author":"刘克庄","text":"图南倭舶透，败北榷场开。\n妾貌不长好，君行何日回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30426,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"商妇词十首 其二","author":"刘克庄","text":"今夕佳风月，身同影守房。\n藁砧定何处，皮裹铁心肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30427,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"商妇词十首 其一","author":"刘克庄","text":"嫁作商人妇，牙筹学算商。\n元来有胎教，生子肖弘羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30428,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"商翁","author":"刘克庄","text":"初隐灵芝处，终逃小橘中。\n谁言秦法密，网不得商翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30429,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿山中十首 其十","author":"刘克庄","text":"凄风转林杪，露坐感衣单。\n不道山中冷，翻忧世上寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30430,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿山中十首 其九","author":"刘克庄","text":"玉箸篆文古，银钩楷法精。\n得知千载下，时有打碑声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30431,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿山中十首 其八","author":"刘克庄","text":"山中无价宝，月色与泉声。\n莫向贵人说，将为有力争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿山中十首 其七","author":"刘克庄","text":"崖居供给少，不用犬防篱。\n只恐偷儿黠，来窥壁上诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}