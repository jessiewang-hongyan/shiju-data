"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝答石塘二林 其三","author":"刘克庄","text":"无梅诗兴阑珊了，无雪梅花冷淡休。\n懊恼天公堪恨处，不教滕六到南州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝答石塘二林 其六","author":"刘克庄","text":"塞北寒梅要笛催，更凭画鼓夺春回。\n江南气候闽尤暖，只用诗催也自开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝答石塘二林 其十","author":"刘克庄","text":"翁与梅花即主宾，月中缟袂对乌巾。\n不知卫玠何为者，举世推他作玉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝答石塘二林 其二","author":"刘克庄","text":"东邻安得如渠白，西域何曾有许香。\n苏二聪明真道著，杏花恐不敢承当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝答石塘二林 其五","author":"刘克庄","text":"少狂籍草共追欢，铁笛横吹到夜阑。\n老怕画檐风露冷，不如吹烛隔窗看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝答石塘二林 其七","author":"刘克庄","text":"斧残留得半株斜，相对微吟到暮鸦。\n堪叹病翁无绮语，不如枯树有琪花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝答石塘二林 其九","author":"刘克庄","text":"有香影处即追攀，岂必西湖水月间。\n若问何人传此诀，后村翁授小孤山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花五首 其五","author":"刘克庄","text":"夜来几阵隔窗风，便恐明朝已扫空。\n点在青苔真可惜，不如吹入酒杯中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花五首 其四","author":"刘克庄","text":"肯因冷澹怨年芳，霜满寒林月满塘。\n至白世间惟玉雪，不如伊处为无香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花五首 其三","author":"刘克庄","text":"篱边屋角立多时，试为骚人拾弃遗。\n不信西湖高士死，梅花寂寞便无诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花五首 其二","author":"刘克庄","text":"糁地纷纷著树稀，岁华摇落惨将归。\n世间尤物难调护，寒怕开迟暖怕飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":30482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]