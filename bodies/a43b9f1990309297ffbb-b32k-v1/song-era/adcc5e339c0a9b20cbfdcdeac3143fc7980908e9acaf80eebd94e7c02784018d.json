[{"title":"济阳作","author":"孔平仲","text":"曾浮轻舸下长江，依旧东风卷绿杨。\n往事山川空满目，新年须鬓欲成霜。\n烟尘莽苍随长路，云日萧条隔旧乡。\n膂力四方男子事，不须弹铗苦悲伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"榆钱","author":"孔平仲","text":"镂雪裁绡个个圆，日斜风定稳如穿。\n凭谁细与东君说，买住青春费几钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柳絮","author":"孔平仲","text":"风定漫漫雪不飞，忽然飘荡几时归。\n琼林金谷知多少，半入楼台半拂衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"废庙","author":"孔平仲","text":"灵宇何年置，荒台渐欲平。\n丹青多泯灭，苔藓太分明。\n栋宇非难复，威灵想不行。\n长林相蔽翳，惟有暮鸦鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雍丘驿作","author":"孔平仲","text":"京尘漠漠稍侵衣，秣马雍丘日未西。\n驿舍萧然无与语，远墙閒觅故人题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄苏子由","author":"孔平仲","text":"历下攀游今几年，相逢颜鬓觉苍然。\n西齐美锦窥诗轴，北郭浓霞入酒船。\n别思忽随春浩荡，还期已过月团圆。\n君家早有为霖望，莫学隆中但稳眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"入陈留界","author":"孔平仲","text":"青青麦陇鸟相呼，淡淡长空尺霭无。\n驿道宽平人语好，共知明日到皇都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自雍丘取别路至陈留界较汴堤径二十里","author":"孔平仲","text":"平生羞捷径，到此尚狐疑。\n望断澹台路，登高赋所思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵偶书","author":"孔平仲","text":"凄风下残叶，疏雨滴黄昏。\n山气先冬冷，江流入夜浑。\n无兵诛二鄙，有策济群元。\n郁郁平生志，凭谁荐一言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"有感","author":"孔平仲","text":"末俗皆趋利，贫心独恶华。\n葛衣冬已晏，黍饭日将斜。\n岳重渊骞伍，毫轻许史家。\n浩然忘世虑，书剑一生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喻意","author":"孔平仲","text":"楚天阴易久，颜巷意何孤。\n贫贱身虽困，英雄胆未枯。\n西山縻虎足，北海拔龙须。\n一剑何时起，功成泛五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夜偶书","author":"孔平仲","text":"击剑悲歌涕滴胸，清时一向老英雄。\n白狼黑犬如相犯，愿语南山矍铄翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠王吉甫 其一","author":"孔平仲","text":"项王战败耻归东，仗剑南游寂寞中。\n雨雪萧条千里暗，乾坤浩荡一身穷。\n文章未属清时用，议论徒多烈士风。\n四海望霖龙折角，为君悲绝诉苍穹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠王吉甫 其二","author":"孔平仲","text":"生计箪瓢少郁陶，谈经千古见秋毫。\n神驱笔下锋铓俊，天纵胸中气象豪。\n事业今朝心孔孟，功名他日踵萧曹。\n行行努力牵牛饵，北海波中钓巨鳌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠王吉甫 其三","author":"孔平仲","text":"嗟予困羁旅，雨昏萧寺中。\n客情随日淡，诗思入秋雄。\n目断故乡路，心飞黄叶风。\n文轩又将去，坐觉笑谈空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夕","author":"孔平仲","text":"月色清馀睡，寒霜入病躯。\n漏随诗思急，灯伴客心孤。\n匣锁剑三尺，身沈天一隅。\n蛟龙困勺水，永夜忆江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月寒","author":"孔平仲","text":"初寒十月终，凛烈若穷冬。\n阴谷冻猛虎，冰潭僵老龙。\n霜威刷六合，雪影暗千峰。\n孤客坐无火，悲吟听暮钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别介之","author":"孔平仲","text":"归去白云居，山行百里馀。\n腰藏三尺剑，腹载五车书。\n暮雨添云重，秋风落翠疏。\n此时别离兴，滴泪满襟裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谈道亭睡觉而成","author":"孔平仲","text":"松竹昼阴环，清风枕席间。\n梦随啼鸟散，心伴白云闲。\n渔艇归前浦，樵歌下远山。\n徘徊明月夜，高兴向忘还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈介之","author":"孔平仲","text":"铁面嵚岩鬼亦惊，世间儿女敢相轻。\n文章自古传周燮，德行当时贵灭明。\n四海生灵虽帖泰，两边豺虎尚纵横。\n胸中久畜平戎策，不日敷施报太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈介之求礼部唱和一阅","author":"孔平仲","text":"金紫相摩上玉堂，南宫诗战镇相将。\n毫端写出青春色，窗下吟销白昼长。\n辞艳迸开昆嶂火，文章翻出铁林鎗。\n愁中欲得神仙句，更藉夫君不闭藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜坐舟中偶成","author":"孔平仲","text":"臲卼扁舟抱寒水，逍遥野客坐孤蓬。\n一天星月清吟外，万里江山极望中。\n遁迹未能离草莽，机心唯欲破羌戎。\n此心未遂难为语，负剑长吁气满空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郭圣原归庐陵","author":"孔平仲","text":"文章豪逸难为敌，格志孤高自出凡。\n两岁论交重金石，今朝泣别倚松杉。\n满江春碧围仙棹，入晓风轻送锦帆。\n此去天涯皆独立，寂寥相望隔溪岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蹇叔以登亭有感示予因以答之","author":"孔平仲","text":"何处登临可极观，危轩隐在碧云端。\n千年古树少春态，一片江天带暮寒。\n人似神仙君自好，心如铁石我难干。\n花红柳绿休多语，且把诗书仔细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明雨不果出","author":"孔平仲","text":"雷势黑飞天马阵，雨声狂播铁林鎗。\n清明节物都谁赏，寂寞无聊恋故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和酬介之","author":"孔平仲","text":"笔刃词锋剑戟稠，千金明月暗相投。\n君鸡已勇誇长嘴，我豕徒劳诧白头。\n清似愁中闻玉笛，美如饥后嘬兰羞。\n伯牙未老钟期在，再写孤音漫继酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书斋独坐有怀","author":"孔平仲","text":"孤烛夜自明，四壁冷无声。\n攲枕清无寐，思时愤不平。\n林中多虎豹，天上有欃枪。\n匣剑蟠龙气，何时仗汝评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈介之","author":"孔平仲","text":"古柏青黄苦暗凋，怪松千尺老嶕峣。\n词源浩浩声连海，笔力冲冲气逼霄。\n贾赋任雄难作敌，杜诗虽健亦相饶。\n英豪自古非尘物，他日峨冠立汉朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登谈道亭","author":"孔平仲","text":"为厌红尘触目生，与君携手上幽亭。\n波光碎碧琉璃地，竹影疏青翡翠屏。\n云惹闲心归远岫，风吹诗思入沧溟。\n名机利械都忘去，才得人间醉一醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和介之","author":"孔平仲","text":"井邑喧嚣不忍行，捲帘终日爱江亭。\n竹声满耳萧萧雨，山色挨檐曲曲屏。\n连夜剑光摩北斗，几时鹏翼起南溟。\n与君分义尤相合，有酒频来此醉醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别馆春","author":"孔平仲","text":"别馆无人迹，春归空绿芜。\n落花深不扫，啼鸟静相呼。\n坐想龙山景，方淹瘴海隅。\n几因北窗卧，一梦到西湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清夜","author":"孔平仲","text":"夜久景逾清，行吟到小亭。\n梨花带明月，银汉淡疏星。\n渡水渔歌远，巡山鬼火青。\n此时尘虑息，豁若醉初醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中夜口占","author":"孔平仲","text":"晴汉疑收练，阴云忽涌涛。\n山空鬼聚啸，月黑虎长号。\n露偪睡魔走，风飘诗胆豪。\n静中余所乐，六印一鸿毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"求言","author":"孔平仲","text":"人多护所短，孰肯告之言。\n不自聪明广，何由道义尊。\n知非君子趣，文过鄙夫存。\n安得同心友，相攀至圣门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"口号","author":"孔平仲","text":"今日朱颜客，明朝白发人。\n莫教行乐晚，须惜少年春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西轩偶书","author":"孔平仲","text":"潇洒无俗韵，登临纾远情。\n吟题红叶满，卧看白云生。\n山色差屏翠，溪流泻镜明。\n优游此终日，其乐胜公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宽恤民力","author":"孔平仲","text":"天地清明日，君臣际会秋。\n雷霆大号遍，雨雪湛恩流。\n士卒休群戍，耕桑劝九州。\n中邦节赐予，下吏省诛求。\n物继由庚咏，民喧击壤讴。\n泰宁堪坐致，宽恤此良谋。\n户晓为今失，官询校古羞。\n愚言惟圣择，神断戒优游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览镜","author":"孔平仲","text":"拂拭菱花试一临，貌随年改叹光阴。\n朱颜惨淡尘埃满，白发萧疏瘴雾侵。\n自笑腐唇因苦学，谁知瘦骨为愁吟。\n平生履行无人识，嗟尔顽铜岂照心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶书","author":"孔平仲","text":"经岁留南戍，频时思故邦。\n青山又薄暮，斜日满西窗。\n遣愤诗千首，迷愁酒百缸。\n何缘幸免去，归棹破长江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近乾元节方教乐而雨","author":"孔平仲","text":"半月新调乐府班，佳期今近迫阴颜。\n歌喉断续微风外，舞队差池细雨间。\n坐赏宾朋愁不解，来游士女半皆还。\n人心共望晴明景，嗟尔乖龙独阻艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城楼晚眺","author":"孔平仲","text":"华阁倚青空，凭栏啸远风。\n溪光梅雨后，山影夕阳中。\n细草伤心绿，馀霞照面红。\n此身归计未，客棹自西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"余得文竹寸馀上有仙翁神女像相偶而坐异之作诗","author":"孔平仲","text":"千载皇英恨未平，泪沾湘竹锦文成。\n我收寸管尤瑰异，上有群仙无姓名。\n乍见偶同神女梦，静看独认赤松迎。\n世间此物真难滞，它日相从上太清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事","author":"孔平仲","text":"久病情怀已索然，况当景气似秋天。\n书窗静滴芭蕉雨，吟砌轻笼薜荔烟。\n云结繁阴低远岫，风排白浪满平川。\n多愁无计堪消遣，斗酒浇成一觉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陶侃","author":"孔平仲","text":"梭作龙飞应自喜，指将针决欲何求。\n赖君乍觉登天梦，不尔王敦一辈流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"扶苏","author":"孔平仲","text":"天下精兵掌握间，便宜长啸入秦关。\n奈何伏剑区区死，不辨书从赵李奸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"屈平","author":"孔平仲","text":"进居卿相谋何拙，退卧林泉道未降。\n堪笑先生不知命，褊心一斥便沈江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"平津侯","author":"孔平仲","text":"待士声名画饼虚，天资多忌与人疏。\n未闻东阁升贤者，已见胶西置仲舒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人见赠","author":"孔平仲","text":"少年有志慕轲雄，十载潜心黄卷中。\n富贵未来嗟命蹇，文章多妙叹童蒙。\n驽材尚藉鞭驱力，顽璞须资刻琢功。\n诱掖相成期在子，可惭誇咏枉清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王秀才谋归作诗留之","author":"孔平仲","text":"相邀盂饭与盘蔬，坐偶行从半岁馀。\n夜倚松窗咏风月，昼挥玉麈讲诗书。\n论交切切初谋协，告别匆匆晚意疏。\n须亮主人攀惜甚，挽回归袖欲投车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏呈叶秘校求蔷薇栽","author":"孔平仲","text":"今岁花开应笑君，对花都不召嘉宾。\n东邻乞种归封植，我欲自为花主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叶晦之送蔷薇栽仍贻诗因以韵和","author":"孔平仲","text":"曾约种花为主人，花开犹在隔年春。\n只应未赏君先去，自是芙蓉幕下宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋晚怀晦之","author":"孔平仲","text":"宿鸟窥檐日渐昏，徘徊顾视少埃氛。\n高槐结阵鸣秋雨，叠嶂争豪出暝云。\n愁病巑岏谁省我，笑谈磊落独怜君。\n遥思静坐西窗下，只与何人治典坟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晦之病酒因书以戒之","author":"孔平仲","text":"本为情沈饮，翻成病染身。\n今朝高枕处，应羡独醒人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月夕待人不至","author":"孔平仲","text":"故人相约一访我，东望不至心踌躇。\n清风满袖月千里，此处苦吟谁和予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶书","author":"孔平仲","text":"羁旅淹南戍，栖迟绕塞垣。\n海氛朝自暗，山气昼常昏。\n虫穴风来毒，蛮溪水出浑。\n故乡方远想，斜日更啼猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄中渊","author":"孔平仲","text":"我行君在家，南北各天涯。\n恨别三秋久，悲思万里赊。\n归心泷浪急，远目岭云遮。\n相见何时再，青山日又斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十月梨花","author":"孔平仲","text":"皓质轻盈粉乍匀，小园初放一枝新。\n意嫌开在梅花后，先吐香心不待春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重到山寺","author":"孔平仲","text":"人迹少到此，山扉长悄然。\n空庭但噪雀，古木自生烟。\n鼠拱颓墙穴，蜗交腐栋涎。\n登临未穷览，斜影促归鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"介之惠诗言斥于礼部欲自此高退山园且招予游故答此章","author":"孔平仲","text":"角艺词场欲进身，混然谁辨玉并珉。\n无常胜负如六博，不幸沈浮知几人。\n君已自甘龙退蛰，我犹有待蠖求伸。\n未腰相印男儿耻，他日功成方卜邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓目","author":"孔平仲","text":"云惨天如褐，山横日易昏。\n寒鸦啼古木，饥雀噪空园。\n红叶风飘势，苍苔雨滴痕。\n行吟有清兴，寂寞与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁暮作","author":"孔平仲","text":"目极天地旷，心凄原野荒。\n高梧脱叶瘦，冻雀抱枝僵。\n松柏凌寒在，雕鸿得意翔。\n平时岂相混，此日辨风霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬晚怀介之","author":"孔平仲","text":"窜迹南游岁再侵，思归望远久沈吟。\n风敲古木寒声碎，云拥江天暝色深。\n饮可涤愁谁伴醉，诗从写恨少知音。\n想君笑语如饥渴，何日相逢慰此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶书","author":"孔平仲","text":"穷骨支离甚，危肠感激多。\n人生易日月，世路苦风波。\n素志偿犹未，朱颜顾几何。\n不如都弃置，对酒且高歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春阴","author":"孔平仲","text":"惨淡春阴久，萧条客望中。\n愁云抱孤岭，密雨暗长空。\n草色萋已绿，花开枝半红。\n何时见晴景，携酒趁东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寒食宴北山席上走笔得松字","author":"孔平仲","text":"骀荡禁烟节，相随上北峰。\n雨馀澄远水，风细韵长松。\n柳影摇歌席，花香入酒钟。\n南州富閒暇，行乐且从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春归","author":"孔平仲","text":"春到强娱乐，春归心寂然。\n夕阳芳草地，梅雨落花天。\n梁舌独调燕，林声渐噪蝉。\n朱颜随物改，谁与驻流年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晦之厌州县之劳作诗奉勉","author":"孔平仲","text":"踠足骅骝铩羽鸿，似君今日叹途穷。\n濯缨空有沧浪志，敛板犹趋尘土中。\n论议最宜陪凤沼，文章独可直鳌宫。\n暂时淹恤宁非命，得失须观塞上翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旦夕北归徵晦之诗为别","author":"孔平仲","text":"殊邦会遇喜亲依，聚散参差志愿违。\n君屈清才尚南戍，我随流水欲东归。\n沈吟晚日愁堪掬，顾盼江云泪满衣。\n冀得佳篇慰离苦，且令行色有馀辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"回王秀才二赋","author":"孔平仲","text":"郭璞长江宋玉风，君才可与角豪雄。\n织成故典文之巧，琢就新词学者工。\n昔日貌观轻子羽，今朝颖出喜毛公。\n频烦教我勤多矣，疏决蒙泉使向东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"族人春饮","author":"孔平仲","text":"柳榭阴阴春半时，相邀閒暇赏芳菲。\n家人共酌榴花酒，蛮妓争歌金缕衣。\n火焰高低红踯躅，绣龙浓淡小蔷薇。\n此中莫惜长欢醉，自古人生七十稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":51862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]