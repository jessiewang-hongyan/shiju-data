[{"title":"浣溪沙","author":"赵长卿","text":"画角声沈卷暮霞。\n寒生促索锦屏遮。\n沈檀半爇髻堆鸦。\n蝴蝶梦回馀烛影，子规啼处隔窗纱。\n夜深明月浸梨花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其二 初夏有感","author":"赵长卿","text":"薄雾轻阴酿晓寒。\n起来宿酒尚酡颜。\n柳莺何事苦关关。\n新恨旧愁俱唤起，当年紫袖看弓弯。\n泪和梅雨两潸潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 初夏","author":"赵长卿","text":"睡起风帘一派垂。\n失巢燕子傍人飞。\n日长深院委香泥。\n绿笋出林翻锦箨，红葵著雨褪胭脂。\n微风度竹入轻衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其一 为王参议寿","author":"赵长卿","text":"密叶阴阴翠幄深。\n梅黄弄雨正频频。\n榴花照眼一枝新。\n缑岭有人今毓粹，飞凫不日簉严宸。\n一尊敬寿太夫人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其二 呈赵状元","author":"赵长卿","text":"雨过西湖绿涨平。\n环湖密柳暗藏莺。\n麦秋天气似清明。\n对策有人新切直，逢春不日尽施行。\n扁舟未用速归程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其二 春暮","author":"赵长卿","text":"柳老抛绵春已深。\n夹衣初试晓寒轻。\n别离无奈此时情。\n先自愁怀容易感，不堪闻底子规声。\n西楼料得数回程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙","author":"赵长卿","text":"恻恻笙竽万籁风。\n阳关叠遍酒尊空。\n相逢草草别匆匆。\n满眼泪珠和雨洒，一襟愁绪抵秋浓。\n相思今夜五云东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其二 初冬","author":"赵长卿","text":"风卷霜林叶叶飞。\n雁横寒影一行低。\n淡烟衰草不胜诗。\n白酒已篘浮蚁熟，黄鸡未老藁头肥。\n问侬不醉待何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙","author":"赵长卿","text":"一味风流一味香。\n十分浓艳十分妆。\n自然娇态自然芳。\n楼上好风楼下水，雪前栏槛竹前窗。\n也宜单著也宜双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其三 腊梅","author":"赵长卿","text":"忆为梅花醉不醒。\n断桥流水去无声。\n鹭翘沙嘴亦多情。\n疏影卧波波不动，暗香浮月月微明。\n高楼羌管未须横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 宠姬小春","author":"赵长卿","text":"帘卷轻风怜小春。\n荷枯菊悴正愁人。\n江梅喜见一枝新。\n料得主人偏爱惜，也应冰雪好精神。\n故园桃李莫生嗔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 夜凉小饮","author":"赵长卿","text":"露挹新荷扑鼻香。\n恼人更漏响浪浪。\n柳梳斜月上纱窗。\n小醉耳边私语好，五云楼阁羡刘郎。\n酒阑烛暗断回肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其三","author":"赵长卿","text":"堆枕冠儿翡翠钗。\n蒙金领子满絣鞋。\n于中沈净好情怀。\n新浴晚凉梳洗罢，半娇微笑下堂来。\n莲花因甚未曾开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙","author":"赵长卿","text":"金兽喷香瑞霭氛。\n夜凉如水酒醺醺。\n照人娇眼媚生春。\n我自愁多魂已断，不禁楚雨带巫云。\n人情又是一番新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其三 早春","author":"赵长卿","text":"不愤江梅喷暗香。\n春前腊后正凄凉。\n霜风雪月忍思量。\n斜倚幽林如有恨，玉鳞飞后转堪伤。\n时人那解惜孤芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 早秋","author":"赵长卿","text":"雨滴梧桐点点愁。\n冷催秋色上帘钩。\n蛩声何事早知秋。\n一夜凉风惊去燕，满川晴涨漾轻鸥。\n怀人千里思悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其一 春深","author":"赵长卿","text":"寒食风霜最可人。\n梨花榆火一时新。\n心头眼底总宜春。\n薄暮归吟芳草路，落红深处鹧鸪声。\n东风疏雨唤愁生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":43999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其一 赋梅","author":"赵长卿","text":"雪压前村曲径迷。\n万山寒立玉参差。\n孤舟独钓一蓑归。\n别坞时听风折竹，断桥闲看水流澌。\n一枝冻蕊出疏篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙","author":"赵长卿","text":"闲理丝簧听好音。\n西楼剪烛夜深深。\n半嗔半喜此时心。\n暖语温存无恙语，韵开香靥笑吟吟。\n别来烦恼到如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙 其一 初夏","author":"赵长卿","text":"雾透龟纱月映栏。\n麦秋天气怯衣单。\n楝花风软晓来寒。\n懒起麝煤重换火，暖香浓处敛眉山。\n眼波横浸绿云鬟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浣溪沙","author":"赵长卿","text":"坐看销金暖帐中。\n羔儿酒美兽煤红。\n浅斟低唱好家风。\n爱客东君多解事，晚妆新与画眉峰。\n便须催唤出房栊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令","author":"赵长卿","text":"绿树转鸣禽。\n已是春深。\n杨花庭院日阴阴。\n帘外飞来双语燕，不寄归音。\n旧事懒追寻。\n空惹芳心。\n天涯消息远沈沈。\n记得年时中酒后，直至而今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令","author":"赵长卿","text":"帘卷露花容。\n几度相逢。\n他知我意欲相通。\n偏奈天教多阻间，积恨何穷。\n云雨杳无踪。\n愁怕东风。\n时闻语笑恣欢浓。\n惟有俺咱真分浅，往事成空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浪淘沙令","author":"赵长卿","text":"窈窕绣帏深。\n窈窕娉婷。\n梅花初试晚妆新。\n那更娇痴年纪小，冰雪精神。\n举措忒轻盈。\n歌彻新声。\n柔肠魂断不堪听。\n但恐巫山留不住，飞作行云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"烛影摇红 深春","author":"赵长卿","text":"梅雪飘香，杏花开艳燃春昼。\n铜驼烟淡晓风轻，摇曳青青柳。\n海燕归来未久。\n向雕梁、初成对偶。\n日长人困，绿水池塘，清明时候。\n帘幕低垂，麝煤烟喷黄金兽。\n天涯人去杳无凭，不念东阳瘦。\n眉上新愁压旧。\n要消遣、除非殢酒。\n酒醒人静，月满南楼，相思还又。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 冬日饮别赵德远","author":"赵长卿","text":"小春天气。\n未唱阳关心已醉。\n红蓼秋容。\n后会何时得再逢。\n归朝好事。\n仰看皇州扬雨露。\n百里恩波。\n拟欲留公无奈何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其一","author":"赵长卿","text":"阳关唱彻。\n断尽离肠声哽咽。\n酒已三巡。\n今夜王孙是路人。\n此情难说。\n莫负等闲风与月。\n欲问归期。\n来戴钗头艾虎儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 其二","author":"赵长卿","text":"半窗斜月。\n茅店萧条灯已灭。\n床下蛩声。\n声动凄凉不忍听。\n终宵无寐。\n覆去翻来真个是。\n屈指归期。\n应是梅花烂熳时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"减字木兰花 咏柳","author":"赵长卿","text":"柳丝摇翠。\n翠幄笼阴无限意。\n不绊行舟。\n只向江边绊客愁。\n月明风细。\n分付一江流去水。\n娇眼伤春。\n谁是章台欲折人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惜奴娇 赋水仙花","author":"赵长卿","text":"洛浦娇魂，恐得到、人间少。\n把风流、分付花貌。\n六出精神，腊寒射、香试到。\n清秀。\n与江梅、争相先后。\n檐卜粗疏，怎似妖娆体调。\n比山樊、也应错道。\n最是殷勤，捧出金盏银台笑。\n拼了。\n仙源与、奇葩醉倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"探春令 其二 立春","author":"赵长卿","text":"数声回雁。\n几番疏雨，东风回暖。\n甚今年、立得春来晚。\n过人日、方相见。\n缕金幡胜教先办。\n著工夫裁剪。\n到那时睹当，须教滴惜，称得梅妆面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"探春令 其七","author":"赵长卿","text":"疏篱横出，绿枝斜露，笑盈盈地。\n悄一似、初睹东邻女，有无限、风流意。\n半开折得琼瑰蕊。\n惹新香沾袂。\n放曲屏珠幌胆瓶儿里，伴我醺醺睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"探春令 其五","author":"赵长卿","text":"雕墙风定，绮窗烛灺，沈吟独坐。\n料雪霜深处，司花神女，暗里焚百和。\n恼人一阵香初过。\n把清愁薰破。\n更那堪得，冰姿玉貌，痛与惜则个。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"探春令 早春","author":"赵长卿","text":"笙歌间错华筵启。\n喜新春新岁。\n菜传纤手青丝细。\n和气入、东风里。\n幡儿胜儿都姑媂。\n戴得更忔戏。\n愿新春已后，吉吉利利。\n百事都如意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"探春令 其十一","author":"赵长卿","text":"楼头月满。\n栏干风度，有人肠断。\n为多情、役得神魂撩乱。\n又被梅萦绊。\n对花沈醉应须拚。\n且尊前相伴。\n恨无端玉笛，穿帘透幕，好梦还惊散。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"探春令 其八","author":"赵长卿","text":"冰澌池面。\n柳摇金线，春光无限。\n问梅花底事，收香藏蕊，到此方舒展。\n百花头上俱休管。\n且惊开俗眼。\n看绿阴结子，成功调鼎，有甚迟和晚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"探春令 其九","author":"赵长卿","text":"溪桥山路。\n竹篱茅舍，凄凉风雨。\n被摧残沮挫，精神依旧，无奈相思苦。\n东君故与收拾取。\n忍教他尘土。\n向绿窗绣户，朱栏小槛，做个名花主。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"探春令 其一","author":"赵长卿","text":"雨孱风瘦，雪欺霜妒，时光牢落。\n怎奈向、天与孤高出众，一任傍人恶。\n凡花且莫相嘲谑。\n尽强伊寂寞。\n便饶他、百计千方做就，酝藉如何学。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"探春令 其一 寻春","author":"赵长卿","text":"新元才过，渐融和气，先到帘帏。\n谩闲绕、柳径花蹊里。\n探看试、春来未。\n年时曾把春抛弃。\n与春光陪泪。\n待今春、日日花前沈醉。\n款细偎红翠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"探春令 其六","author":"赵长卿","text":"龟纱隔雾，绣帘钩月，那时曾见。\n照影儿、觑了千回百转。\n素艳明于练。\n柔肠堆满相思愿。\n更重看几遍。\n是天然不用，施朱栊翠，羞损桃花面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44022,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"探春令 赏梅十首 其三","author":"赵长卿","text":"冰檐垂箸，雪花飞絮，时方严肃。\n向寻常摇曳，凡花野草，怎生敢夸红绿。\n江梅孤洁无拘束。\n只温然如玉。\n自一般天赋，风流清秀，总不同粗俗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44023,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"探春令 其四","author":"赵长卿","text":"而今风韵，旧时标致，总皆奇绝。\n再相逢还是，春前腊后，粉面凝香雪。\n芳心自与群花别。\n尽孤高清洁。\n那情怀最是，与人好处，冷淡黄昏月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44024,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其一 忠孝堂雨过，荷花烂然，晚晴可人，因呈李宜山同舍","author":"赵长卿","text":"水乡清楚。\n襟袖销袢暑。\n绰约藕花初过雨。\n出浴杨妃无语。\n葡萄满酌玻璃。\n已拼一醉酬伊。\n浪卷夕阳红碎，池光飞上帘帏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44025,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其二 早起闻莺","author":"赵长卿","text":"绮疏新晓。\n学语雏莺巧。\n烟暖瑶阶梧叶老。\n满地东风芳草。\n少年不合风流。\n偿他酒债花愁。\n望断绿芜春去，销魂懒上层楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44026,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其一 问讯梅花","author":"赵长卿","text":"楚梅娇小。\n好是霜天晓。\n宿酒恼人香暗绕。\n浸影碧波池沼。\n生成素淡芳容。\n不须抹黛匀红。\n准拟成阴结子，莫教枉费春工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44027,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其二","author":"赵长卿","text":"秋容眼界。\n随寓浑堪爱。\n远岫连天横淡霭。\n望断孤鸿飞外。\n夕阳红树林坰。\n重重锦障横陈。\n一段江南景色，倩谁为下丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44028,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其二 初夏舞宴","author":"赵长卿","text":"清和时候。\n底事休交瘦。\n满酌流霞看舞袖。\n步步锦裀红皱。\n六么舞到虚催。\n几多深意徘徊。\n拼了明朝中酒，为伊更饮琼杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44029,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐","author":"赵长卿","text":"紫箫声断。\n窗底春愁乱。\n试著春衫羞自看。\n窄似年时一半。\n一春长病厌厌。\n新来愁病重添。\n香冷倦熏金鸭，日高不卷珠帘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44030,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"清平乐 其一 秋暮","author":"赵长卿","text":"鸿来燕去。\n又是秋光暮。\n冉冉流年嗟暗度。\n这心事还无据。\n寒窗露冷风清。\n旅魂幽梦频惊。\n何日利名俱赛，为予笑下愁城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44031,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 旅中远思","author":"赵长卿","text":"客里情怀谁可表。\n凄凉举目知多少。\n强饮强歌还强笑。\n心悄悄。\n从头彻底思量了。\n当日相逢非草草。\n果然恩爱成烦恼。\n稳整征鞍归去好。\n重厮守。\n相期待与同偕老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44032,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"眼儿媚 霜夜对月","author":"赵长卿","text":"一钩新月照西楼。\n清夜思悠悠。\n那堪更被，征鸿嘹唳，绊惹离愁。\n倚栏不语情如醉，都总寄眉头。\n从前只为，惜他伶俐，举措风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44033,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"眼儿媚","author":"赵长卿","text":"南枝消息杳然间。\n寂寞倚雕栏。\n紫腰艳艳，青腰袅袅，风月俱闲。\n佳人环佩玉阑珊。\n作恶探花还。\n玉纤拈粟，樱唇呵粉，愁点眉弯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44034,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"眼儿媚","author":"赵长卿","text":"连沧危观暮江前。\n几醉使君筵。\n少年俊气，曾将吟笔，买断江天。\n重来细把朋游数，回首一辛酸。\n兰成已老，文园多病，负此江山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44035,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"眼儿媚 东院适人乞词，醉中书于裙带三首 其一","author":"赵长卿","text":"人随社节去匆匆。\n此恨几时穷。\n阳台寂寞，巫山凄惨，云雨成空。\n芭蕉密处窗儿下，冷落旧香中。\n黄昏静也，蛩声满院，明月清风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44036,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"眼儿媚","author":"赵长卿","text":"玉楼初见念奴娇。\n无处不妖娆。\n眼传密意，樽前烛外，怎不魂消。\n西风明月相逢夜，枕簟正凉宵。\n殢人记得，叮咛残漏，且慢明朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44037,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"眼儿媚 其二","author":"赵长卿","text":"槐阴密处啭黄鹂。\n午日正长时。\n一番过雨，绿荷池面，冷浸琉璃。\n红尘不到华堂里，纤楚对蛾眉。\n笑偎人道，新词觅个，美底腔儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44038,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"眼儿媚 其三","author":"赵长卿","text":"当年策马过钱塘。\n曲径小平康。\n繁红酽白，娇莺姹燕，争唤何郎。\n而今又客东风里，浑不似寻常。\n只愁别后，月房云洞，啼损红妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44039,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"眼儿媚","author":"赵长卿","text":"先来客路足伤悲。\n那更话别离。\n玉骢也解，知人欲去，骧首频嘶。\n马蹄动是三千里，后会莫相违。\n切须更把，丁香珍重，待我重期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44040,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其三","author":"赵长卿","text":"倚楼小小穿针女。\n秋光点点蛛丝雨。\n今夕是何宵。\n龙车乌鹊桥。\n经年谋一笑。\n岂解令人巧。\n不用问如何。\n人间巧更多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44041,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其二 梅","author":"赵长卿","text":"梅花枝上东风软。\n朝来吹散真香远。\n雅淡有馀清。\n客心和泪倾。\n美人临别夜。\n月晃灯初灺。\n玉枕小屏山。\n眉尖曾细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44042,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其二 初夏","author":"赵长卿","text":"方池新涨蒲萄绿。\n晓来雨过花如浴。\n测测杏园风。\n梢头一捻红。\n危楼愁独倚。\n一寸心千里。\n宿酒尚微醺。\n懒装堆髻云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44043,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其一 赏梅","author":"赵长卿","text":"梅花有意舒香粉。\n舒香已得先春信。\n香与露华清。\n露浓愁杀人。\n酒多愁愈重。\n此意谁能共。\n泪湿染衣斑。\n夜霜金缕寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 残春","author":"赵长卿","text":"杨花飞尽莺声涩。\n杜鹃唤得春归急。\n病酒起来迟。\n娇慵懒画眉。\n宝奁金鸭冷。\n重唤烧香饼。\n著意炼龙涎。\n纤纤手逴烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其二 秋老江行","author":"赵长卿","text":"炊烟一点孤村迥。\n娇云敛尽天容净。\n雁字忽横秋。\n秋江泻客愁。\n银钩空寄恨。\n恨满凭谁问。\n袖手立西风。\n舟行秋色中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮","author":"赵长卿","text":"日高犹恋珊瑚枕。\n羞红不忿花如锦。\n双燕运芹泥。\n燕归人未归。\n纵饶梳洗罢。\n朱户何曾跨。\n寂寞小房栊。\n回文和泪封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 其一 初冬旅思","author":"赵长卿","text":"枫林飒飒凋寒叶。\n汀苹败蓼遥相接。\n景物已非秋。\n凄凉动客愁。\n还家贫亦好。\n肯厌杯中草。\n香饭滑流匙。\n三登快乐时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":44048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]