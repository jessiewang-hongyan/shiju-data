rovenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"晁迥","text":"安得大金柅，制彼日月轮。\n免同流水车，今人续古人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十三","author":"晁迥","text":"善思委顺世间法，于本真心而不动。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十六","author":"晁迥","text":"文昭岂异天垂象，泽布还同雨洒溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"晁迥","text":"介居僧尚杂，警听鹤犹聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"晁迥","text":"三台八座九品官，名目不同而已矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二十一","author":"晁迥","text":"心如莲花不著水，身似翔鸿不可笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十四","author":"晁迥","text":"岂知习静知常子，尘外天声满耳根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十七","author":"晁迥","text":"凤驾都门晓，凉风苑树秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十二","author":"晁迥","text":"宴居寂寂堪修道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十九","author":"晁迥","text":"期月政成当事简，不妨游燕楚宫春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其十一","author":"晁迥","text":"妄缘扰扰知萦己。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偈 其一","author":"晁迥","text":"起灭心不停，生化形无数。\n奇哉大丈夫，自在空中住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偈 其三","author":"晁迥","text":"求听存灵响，冥心合太虚。\n清融浮想尽，名曰小无馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偈","author":"晁迥","text":"心空如太空，豁然无可触。\n一真法界中，灵照常安住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偈 其二","author":"晁迥","text":"一切是非薮，皆从外听成。\n我是厌闻者，反听存灵响。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潭畔芙蓉","author":"浣花女","text":"芙蓉花发满江红，尽道芙蓉胜妾容。\n昨日妾从堤上过，如何人不看芙蓉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"借翠蛟亭韵","author":"笑掷震雷","text":"兀兀梅窗坐已顽，自怜失脚落人间。\n洞霄宫里星辰近，天柱峰前日月闲。\n野鹤听琴飞雪舞，湫龙喜客为澜翻。\n此中不昼生云雨，珍重坡仙一扁颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蛩","author":"耕吴","text":"九夏蜩螗不可听，秋风才动便无声。\n一襟月露丘园里，却胜趋炎作队鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"村庄即事","author":"耕吴","text":"菊过重阳尚吐香，晚秋风景属村庄。\n日羹野菜同妻饭，时倩邻刍对客觞。\n霜后树枝多老丑，雨馀山色半微茫。\n近来少入城中去，为爱闲居滋味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"隐居","author":"耕吴","text":"得失两忘机，何心问是非。\n难求斩马剑，且守钓鱼矶。\n鹤瘦添新料，儿寒补旧衣。\n诗成兴飘逸，天外片云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"歌","author":"莎衣道人","text":"胡孙死，闹啾啾，也须还我一百州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白云庵 其四","author":"逍遥子","text":"蚁窠得意从渠计，螳翳忘言息我机。\n寒尽山庵无历日，野花啼鸟又春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白云庵 其三","author":"逍遥子","text":"洞底菖蒲绿作坡，松根况有茯苓多。\n自能饱饭太平日，不学式微歌浩歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白云庵 其二","author":"逍遥子","text":"泉流东畔是蓬莱，我爱青山为展开。\n独倚瘦筇谁是伴，白云日晚自归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"白云庵 其一","author":"逍遥子","text":"山居常与白云俱，小筑东轩著药炉。\n消遣客魔须底物，竹间叶叶有灵符。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"罗浮茶","author":"逍遥子","text":"活水仍将活火煎，茶经妙处莫虚传。\n陆颠所在闲题品，未试罗浮第一泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"茶庵","author":"逍遥子","text":"道人宴坐碧山阿，啄木敲门拟客过。\n吾境本无妖魅事，日长翻有睡为魔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠林次龄","author":"部使者","text":"户长尽蠲民不病，室家相庆酒频沽。\n农桑课绩无遗恨，循吏声名并两都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题汪水云诗卷","author":"兜率长老","text":"穷发归来脱孟劳，何嗟澹与泊相遭。\n瑶琴摘罢意犹在，石鼎联成韵更高。\n世事可能书咄咄，人情只合醉陶陶。\n雁门弦断无人续，输子诗成夺锦袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏花扇","author":"崖州女子","text":"团扇画方新，金花照席茵。\n那缘灯下见，更值月中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"晚静","text":"牛饮芳陂鸦立背，马过秀野蝶随蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红","author":"晦庵","text":"胶扰劳生，待足后、何时是足。\n据见定、随家丰俭，便堪龟缩。\n得意浓时休进步，须知世事多翻覆。\n漫教人、白了少年头，徒碌碌。\n谁不爱，黄金屋。\n谁不羡，千钟禄。\n奈五行不是，这般题目。\n枉费心神空计较，儿孙自有儿孙福。\n也不须、采药访神仙，惟寡欲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"运庵普岩禅师像赞","author":"梦庵在居士","text":"松源嫡嗣，伏虎后身。\n接物有验，见地不亲。\n丛林沾润恩波阔，万古云峰翠色新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花","author":"淮上女","text":"淮山隐隐。\n千里云峰千里恨。\n淮水悠悠。\n万顷烟波万顷愁。\n山长水远。\n遮住行人东望眼。\n恨旧愁新。\n有泪无言对晚春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"淮安守","text":"一从楚客死，淮山无颜色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元遇雨","author":"淳祐士人","text":"隐隐雷声天鼓吹，荧荧灯火夜星辰。\n风流太守明如镜，何用姮娥作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"内司毁林建寺","author":"淳祐士人","text":"合抱长材卧壑深，于今惟恨不空林。\n谁知广厦千斤斧，斲尽人间孝子心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"讽临安试","author":"淳祐士人","text":"南省观图丧一名，补闱又试万人英。\n两重门阈如天险，十有七人倒地横。\n谁设秦坑来贡院，枉教唐士梦登瀛。\n云山万里家何在，月白风清鬼哭声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二吴谣","author":"淳祐民谣","text":"大蜈蚣，小蜈蚣，尽是人间业毒虫。\n夤缘扳附有百足，若使飞天能食龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刺陈贾","author":"淳熙太学生","text":"周公大圣独遭谤，元晦真贤亦被讥。\n堪叹古今两陈贾，如何都把圣贤非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诮陈贾","author":"淳熙太学生","text":"周公大圣犹遭谤，伊洛名贤亦被讥。\n堪叹古今两陈贾，如何专把圣贤非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居 其十","author":"淳藏主","text":"坐石已知毛骨冷，漱泉长觉齿牙清。\n个中有味忘归念，身老无馀合此情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居 其九","author":"淳藏主","text":"渔父子歌甘露曲，拟寒山咏法灯诗。\n深云莫谓无人听，万像森罗历历知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居 其八","author":"淳藏主","text":"数行大字贝多叶，一炷粗香古柏根。\n石室静延春昼永，杜鹃啼破落花村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居 其七","author":"淳藏主","text":"一瓢颜子非为乐，四壁相如未是高。\n争似山家真活计，屋头松韵泻秋涛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居 其六","author":"淳藏主","text":"瓦炉爇处清烟霭，铁磬敲时晓韵寒。\n一穿数珠粗又重，拈来百八不相谩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居 其五","author":"淳藏主","text":"随身只有过头杖，饱腹唯凭折脚铛。\n几度遣閒何处好，水声山色里游行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居 其四","author":"淳藏主","text":"无心閒淡云归洞，有影澄清月在潭。\n此景灼然超物外，本来成现不须参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居 其三","author":"淳藏主","text":"自笑疏狂同拾得，谁知痴钝若南泉。\n几回食饱游山倦，只么和衣到处眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居 其二","author":"淳藏主","text":"屋架数椽临水石，门通一径挂藤萝。\n自缘此处宜投老，饶得溪云早晚过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居 其一","author":"淳藏主","text":"拙直自知趋世远，疏愚赢得住山深。\n现成活计无他物，只有鳞皴杖一寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝中措 庆友人八月十三","author":"菊翁","text":"桂花庭院是蓬壶。\n行地列仙图。\n月姊搀先两日，捧觞来庆垂弧。\n埙篪伯仲，翁前再拜，彩袖嬉娱。\n人羡一经教子，君今满屋皆书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题资福院平绿轩","author":"辅广","text":"名区与利垄，羊肠竞攀跻。\n谁能为芳草，四旷成幽栖。\n春风一凭栏，秀色无高低。\n山遥不作障，水近何妨堤。\n只恐金气寒，黄枯变碧萋。\n坐令群目惊，有似七圣迷。\n人心无天游，六凿相攘挤。\n但于平处观，众有何端倪。\n日月互宾送，景物随乖暌。\n彼昏如执著，惟君试金篦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江城子 中秋忆举场","author":"逸民","text":"秀才落得甚乾忙。\n冗中秋，闷重阳。\n百年三万，消得几科场。\n吟配十年灯火梦，新米粥，紫苏汤。\n如今且说世平康。\n收战场。\n息欃枪。\n路断邯郸，无复梦黄粱。\n浪说为农今决矣，新酒熟，菊花香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大涤洞天留题 其一","author":"湖杓","text":"蔓藤森木阅千龄，断壁嵌崖翠削成。\n安得抱琴来此宿，夜深随意写溪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偈","author":"湡禅师","text":"优游实际妙明家，转步移身指落霞。\n无限白云犹不见，夜乘明月出芦花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书中山驿壁","author":"番阳布衣","text":"回头四十五年非，无赖秋光满客衣。\n可惜吴中莼菜好，陆机张翰不同归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"百字谣/念奴娇 贺彭谦仲八月生子","author":"禅峰","text":"中秋近也，正于门瑞气，葱葱时节。\n隔岁维熊占吉梦，今夕天生英杰。\n仙籍流芳，瑞龙毓秀，应是非凡骨。\n诗书勋业，妙龄行见英发。\n好是日满三朝，剩陈汤饼，投辖留宾客。\n玉果犀钱排绮宴，窈窕歌珠舞雪。\n枕玉凉时，屏山深处，好事权休说。\n小蛮杨柳，迩来还可攀折。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"齐天乐 令狐佥迁新廨","author":"赋梅","text":"雕阑曲曲芙蓉水，天然一时潇洒。\n露浥冰壶，风摇玉佩，缥缈蓬莱如画。\n银烛欲下。\n照藻桷翚飞，杏梁虹架。\n如此规模，杜陵何止万间厦。\n明年春燕归早，卷帘应认得，旧家王谢。\n袖里经纶，幕中佳话，高斸云根谁写。\n青冥纵靶。\n看人在金坡，炬莲盈把。\n句忆湘南，渌池明月夜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]