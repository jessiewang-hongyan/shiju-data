[{"title":"书感","author":"陆游","text":"楚些难招去干魂，正令舌在向谁论。\n中分白日归攲枕，全付青春与杜门。\n凛凛咥人愁履虎，区区染指畏尝鼋。\n残年誓报嗟何有，虚负明时养老恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书感","author":"陆游","text":"伐性戕生岂一端，暮年赢得是衰残。\n齿牙零落畏大胾，毛发萧疏便小冠。\n惜日每惊新历换，怯寒尚觉弊庐宽。\n华山阻绝岷山远，安得冥鸿借羽翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书感","author":"陆游","text":"俗学方哗世，遗经寖已微。\n斯文未云丧，吾道岂其非。\n拔本宁馀力，迷途幸识归。\n新凉起衰疾，灯火耿郊扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书感","author":"陆游","text":"夺璧元知价不雠，屠龙谁信本无求。\n哦诗声里岁时速，忧国泪边天地秋。\n已欠谢安俱泛海，况无王粲与登楼。\n此身著处凭君记，万里烟波没白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书感","author":"陆游","text":"老荷宽恩许退耕，丝毫无报亦何情。\n民贫乐岁尚艰食，道丧异端方肆行。\n党祸本从名辈出，弊端常向盛时生。\n古人骨冷青松下，谁起英魂与细评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书感","author":"陆游","text":"疋马曾为塞上游，东归几见剡川秋。\n故城废市古今叹，断角残钟朝暮愁。\n尺寸无功真碌碌，耄期未死转悠悠。\n阿奴尚喜强人意，三日于菟气食牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书壁二首 其二","author":"陆游","text":"故里还初服，明恩念老农。\n方蒙镜湖赐，又忝渭川封。\n炊粟犹支日，藏蔬可御冬。\n霜天病益减，高枕听邻钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书壁二首 其一","author":"陆游","text":"稻草高茨屋，绳枢窄作门。\n渔樵皆结友，邻曲自通婚。\n留客秋茶苦，醺人社酒浑。\n馀年尚何叹，一饭亦君恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书懒","author":"陆游","text":"此身不觉老侵寻，残发萧萧雪满簪。\n那有新诗书触目，亦无闲话问安心。\n塞垣西戍茫如梦，省户东归病至今。\n一懒便知生世了，午窗酣枕敌千金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书怀","author":"陆游","text":"愁向东华蹋软红，暂归旧隐乐无穷。\n石池洗药涓涓水，渔艇投竿袅袅风。\n尽日醉醒菱唱里，邻家来往竹阴中。\n何须列戟长安第，四面云山拥此翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予以壬戌六月十四日入都门癸亥五月十四日去国而中有闰月盖相距正一年矣慨然有赋二首 其一","author":"陆游","text":"三百六十日，扶衰得出都。\n略无新伎俩，仍是旧形模。\n世事蛮攻触，人情越事吴。\n勿言莼菜老，舣棹醉湘湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予以壬戌六月十四日入都门癸亥五月十四日去国而中有闰月盖相距正一年矣慨然有赋二首 其二","author":"陆游","text":"一百七十里，我行谁谓赊。\n期年初去国，度宿即还家。\n事似谈春梦，身如寄客槎。\n石帆村好在，重理旧桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予未冠即交诸名胜今无复在者感叹有作","author":"陆游","text":"早岁乡闾接胜流，老来零落叹山丘。\n欲寻共语人难得，却是封侯印易求。\n数酌不能成兀兀，一枰且复寄悠悠。\n世间只有身差重，惆怅今年白尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予自春夏屡病至立秋而愈作长句自贺","author":"陆游","text":"良药扶衰抵万金，渐加糜粥辍呻吟。\n溪风拂簟有秋意，山影半庭生夕阴。\n薄俗只成惊老眼，幽居正得遂初心。\n岸巾待月栏干曲，更觉天公爱我深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予行蜀汉间道出潭毒关下每憩罗汉院山光轩今复过之怅然有感","author":"陆游","text":"山光轩上几闲游，潭毒关前又小留。\n麦陇雪苗寒剡剡，柘林风叶莫飕飕。\n马行剑阁从今始，门泊吴船亦已谋。\n醉眼每嫌天地迮，尽将万里著吾愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予所居三山在镜湖上近取舍东地一亩种花数十株彊名小园因戏作长句","author":"陆游","text":"出郭西南十里过，小园风月得婆娑。\n翠屏三扇恰相倚，玉镜一奁谁为磨。\n投镊未嫌衰鬓白，插花聊喜醉颜酡。\n耶溪更尽青鞋兴，免使将军怒脱靴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予宿疾多已失去独气痛时作赋诗自宽","author":"陆游","text":"疾久难全去，扶持度岁年。\n垣墙完罅隙，匕箸禁芳鲜。\n渐减观书课，常储买药钱。\n乡人多不识，谁与问沉绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"予数年不至城府丁巳火后今始见之","author":"陆游","text":"陈迹关心已自悲，劫灰满眼更增欷。\n山川壮丽昔无敌，城郭萧条今已非。\n窣堵招提俱昨梦，祝融回禄尚馀威。\n故交减尽新知少，纵保桑榆谁与归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云门道中","author":"陆游","text":"川霭林霏翠欲浮，散人心事寄沙鸥。\n暮投野店孤烟起，晓涉清溪小蹇愁。\n岭路穷时萦细栈，山形缺处起重楼。\n钓游陈迹浑如昨，一念凄然不自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6975,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云门道中","author":"陆游","text":"度岭穿林一径斜，旋篝新火试新茶。\n箬包粉饵祠寒食，雨湿青鞋上若耶。\n石罅微泉来滴沥，溪涯老木卧槎牙。\n不须苦觅东柯谷，是处云山可寄家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6976,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云门感旧","author":"陆游","text":"总角来游老未忘，背人岁月去堂堂。\n稚松看到偃霜盖，废寺忆曾开宝坊。\n佛几古灯寒焰短，斋厨新粟午炊香。\n兴阑未忍登车去，更倚溪桥立夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6977,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"云门溪上独步","author":"陆游","text":"山路联翩十日阴，晚晴剩喜得幽寻。\n残红犹有数枝在，涨绿真成一倍深。\n泉响佩环鸣闇壑，月明珠璧散疏林。\n归来寂寞钟初动，羞向孤灯说壮心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6978,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五十","author":"陆游","text":"五十未名老，无如衰疾何。\n肺肝空激烈，颜鬓已蹉跎。\n夜宴看长剑，秋风舞短蓑。\n此身如砥柱，犹足阅颓波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6979,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五云门晚归","author":"陆游","text":"高城带远林，落日动寒砧。\n行客自朝暮，青山无古今。\n衰迟惭逸气，忧患足危心。\n溪迮滞归艇，何时春水深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6980,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月一日作","author":"陆游","text":"处处稻分秧，家家麦上场。\n敢悲身老大，独幸岁丰穰。\n酪美朱樱熟，菰青角黍香。\n翛然一竹几，饱受北窗凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6981,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月七日夜梦中作二首 其一","author":"陆游","text":"征行过孤垒，寂寞已千年。\n马病霜菅瘦，狐鸣古冢穿。\n烟尘身欲老，金石志方坚。\n零落英雄尽，何人共著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6982,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月七日夜梦中作二首 其二","author":"陆游","text":"霜露薄貂裘，连年塞上留。\n芦笳青冢月，铁马玉关秋。\n振臂忘身惫，凭天报国雠。\n诸公方衮衮，好运幄中筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6983,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月七日拜致仕敕口号二首 其一","author":"陆游","text":"剡曲东归日醉眠，冰衔屡忝武夷仙。\n恩如长假容居里，官似分司不限年。\n一札疏荣驰厩置，两儿扶拜望云天。\n坐糜半俸犹多愧，月费公朝二万钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6984,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月七日拜致仕敕口号二首 其二","author":"陆游","text":"黄纸东来墨未乾，孤臣恩许挂朝冠。\n小儿扶出迎门拜，邻舍相呼拥路观。\n白首奉身归畎亩，清霄无梦接鹓鸾。\n从今剩把花前酒，忧患都空量自宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6985,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月二十一日风雨大作","author":"陆游","text":"风雨纵横夜彻明，须臾更觉势如倾。\n出门已绝近村路，对面不闻高语声。\n衔舳江关多蜀估，宿师淮浦饱吴粳。\n老民愿忍须臾死，传檄方闻下百城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6986,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月十一日夜坐达旦","author":"陆游","text":"莫笑耽书不计年，寒儒业定几生前。\n读经今日韦编绝，作赋当时铁砚穿。\n公路晚悲身至此，令威归叹冢累然。\n三更听雨蓬窗底，又作鳏鱼夜不眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6987,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月十一日睡起","author":"陆游","text":"病眼慵于世事开，虚堂高卧谢氛埃。\n帘栊无影觉云起，草树有声知雨来。\n茶碗嫩汤初得乳，香篝微火未成灰。\n翛然自适君知否，一枕清风又过梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6988,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月下旬大热晦日夜得雨明旦凉甚","author":"陆游","text":"一雨萧然洗睡昏，清晨屣履自开门。\n岂惟爽气生山袂，坐觉凉飔入发根。\n浦口鱼多来野鹤，林梢果熟下山猿。\n吾庐清绝君知否，钓雪寒江不足言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6989,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月中连夕风雨气候如高秋枕上有赋","author":"陆游","text":"拥被微吟短鬓秋，孤灯残漏共悠悠。\n雨声不贷三更梦，酒力宁禁万里愁。\n身寄湖山邻剡曲，心游河岳过关头。\n世间可恨知多少，虚弊当年季子裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6990,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月初作","author":"陆游","text":"邻舍舂新麦，家人拾晚蚕。\n推移逢夏五，赋与叹朝三。\n遣日须棋局，忘忧赖酒甔。\n幽居有高致，多取未为贪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6991,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月初病体益轻偶书","author":"陆游","text":"世事纷纷了不知，又逢燕乳麦秋时。\n经年谢客常因醉，三日无诗自怪衰。\n乘雨旋移西崦药，留灯重覆北窗棋。\n但将生死俱拈起，造物从来是小儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6992,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月雨","author":"陆游","text":"空濛五月雨，景气一番新。\n换尽园林叶，洗空衢路尘。\n山邮恼行客，野渡滞归人。\n独有龟堂叟，凉风吹角巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6993,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五月得雨稻苗尽立","author":"陆游","text":"城郭迎龙鼓吹喧，甘膏三夕慰黎元。\n草荒常日经行路，水到前村旧涨痕。\n黄犊尽耕稀旷土，绿苗无际接旁村。\n家家足食山无盗，安枕何劳夜闭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6994,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五更起坐","author":"陆游","text":"世间醉梦过浮生，谁肯披衣坐五更。\n煜煜心光回自照，绵绵踵息浩无声。\n古人得意捐糟粕，痴子何知堕化城。\n七十老翁须努力，邻鸡才唱又窗明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6995,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五鼓","author":"陆游","text":"梦断华胥夜艾时，绕廊萧散曳筇枝。\n长空渐见明河落，短调犹残画角吹。\n世事又随朝日出，钓船莫负早秋期。\n南湖五亩新菰熟，此味惟应老子知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6996,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五鼓","author":"陆游","text":"楼堞鼕鼕鼓，帘栊煜煜灯。\n浪名随牒吏，实似打包僧。\n衰病元难强，疏慵每自憎。\n谁知戍边日，秋野正呼鹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6997,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五鼓不得眠起酌一杯复就枕","author":"陆游","text":"栖冷鸡声咽，窗深烛焰明。\n流年容易过，华发等闲生。\n浊挹连醅酒，香搓带叶橙。\n残骸付蝼蚁，汗简更须名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6998,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五鼓赴太社腊祭","author":"陆游","text":"霜寒裂屋瓦，月白射坊门。\n病骨愁看影，孤吟怯断魂。\n饥鹰掣羁绁，老马伏车辕。\n不奈清宵梦，残芜满故园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":6999,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五鼓送客出城马上作","author":"陆游","text":"夜漏馀十刻，凉飔如九秋。\n滩声聒酒醒，月色照人愁。\n落魄悲孤宦，龙钟怯远游。\n此生那可料，六岁剑南州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7000,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五鼓起坐待旦","author":"陆游","text":"睡觉初闻鸡一鸣，披衣危坐待窗明。\n残躯已向闲中老，痴梦犹寻熟处行。\n南北迢迢悲往事，古今莽莽叹浮生。\n伯伦一锸君休笑，冢象祁连亦已平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7001,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"井研道中","author":"陆游","text":"穷冬景方促，下岭路微平。\n地瘦竹无叶，风乾茅有声。\n客游空自叹，归计与谁评。\n尚喜长亭下，云穿夕照明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7002,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"今岁六月望后一日立秋故比常年凉意差早","author":"陆游","text":"九衢车马困炎曦，正是山中散发时。\n秋近梧桐已摇落，阴生蟋蟀最先知。\n稻陂水白宁忧旱，灶突烟青幸续炊。\n谁谓吾庐太岑寂，茶瓜亦有野人期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7003,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"今年立冬后菊方盛开小饮","author":"陆游","text":"胡床移就菊花畦，饮具酸寒手自携。\n野实似丹仍似漆，村醪如蜜复如齑。\n传芳那解烹羊脚，破戒犹惭擘蟹脐。\n一醉又驱黄犊出，冬晴正要饱耕犁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7004,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以事至城南书触目","author":"陆游","text":"十里西风吹帽裙，江城衣杵远犹闻。\n路如剑阁逢秋雨，山似炉峰锁暮云。\n原上老翁眠犊背，篱根小妇牧羊群。\n百钱且就村场醉，舌本醇醨莫苦分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7005,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"以菜茹饮酒自嘲","author":"陆游","text":"山泽有臞儒，残年病满躯。\n拙疏难救药，贫困不枝梧。\n海客留苔脯，山僧饷笋枯。\n衰颜得村酒，犹解暂时朱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7006,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公安","author":"陆游","text":"地旷江天接，沙隤市井移。\n避风留半日，买米待多时。\n蝶冷停菰叶，鸥驯傍橹枝。\n昔人勋业地，搔首叹吾衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7007,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六七月之交山中凉甚","author":"陆游","text":"城市方炎热，村墟乃尔凉。\n拂窗桐叶下，绕舍稻花香。\n独鹤警秋露，双萤明屋梁。\n卧闻机妇织，感叹夜初长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7008,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六日云重有雪意独酌","author":"陆游","text":"遍游数泽一渔舠，尽历风霜只缊袍。\n天为念贫偏与健，人因见懒误称高。\n地连海澨涛声近，云冒山椒雪意豪。\n偶得名樽当痛饮，凉州那得直蒲萄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7009,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月九日夜步月至朝真观","author":"陆游","text":"朝斗真人有旧祠，追凉老子曳筇枝。\n从来步月难为客，此夕听琴合有诗。\n竹院沉沉闻漏永，玉绳耿耿看星移。\n慇勤更作重来约，迨及冰轮未缺时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7010,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月二十六日夜梦赴季长招饮","author":"陆游","text":"少城骏马逐春风，二十年间万事空。\n清梦都忘双鬓改，绣筵还喜一尊同。\n乌巾掩冉簪花重，羯鼓敲铿列炬红。\n安得此欢真入眼，碧油幢拥主人翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7011,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月二十四日夜分梦范至能李知几以尤延之同集江亭诸公请予赋诗记江湖之乐诗成而觉忘数字而已","author":"陆游","text":"露箬霜筠织短篷，飘然来往淡烟中。\n偶经菱市寻溪友，却拣蘋汀下钓筒。\n白菡萏香初过雨，红蜻蜓弱不禁风。\n吴中近事君知否，团扇家家画放翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7012,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月十七日大暑殆不可过然去伏尽秋初皆不过数日作此自遣","author":"陆游","text":"赫日炎威岂易摧，火云压屋正崔嵬。\n嗜眠但喜蕲州簟，畏酒不禁河朔杯。\n人望息肩亭午过，天方悔祸素秋来。\n细思残暑能多少，夜夜常占斗柄回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7013,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月十四日宿东林寺","author":"陆游","text":"看尽江湖千万峰，不嫌云梦芥吾胸。\n戏招西塞山前月，来听东林寺里钟。\n远客岂知今再到，老僧能记昔相逢。\n虚窗熟睡谁惊觉，野碓无人夜自舂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7014,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月十四日微雨极凉","author":"陆游","text":"湖上清秋近，斋中白日长。\n云来树收影，雨过土生香。\n莲小红衣湿，瓜甘碧玉凉。\n晚来幽兴极，移榻近方塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7015,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月十夜风月佳甚起坐中庭有作","author":"陆游","text":"曼肤汗雨不胜挥，夜景泠然暂解围。\n漱罢寒泉甘齿颊，梦回斜月入窗扉。\n荷翻小浦孤萤度，露湿危巢倦鹤归。\n我亦驭风思远适，岳阳楼上酹湘妃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7016,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六月晦日作","author":"陆游","text":"长夏忽云过，徂年行且休。\n川原方渴雨，草木已惊秋。\n露蔓晨犹泫，风蝉莫更遒。\n明窗对清镜，世事判悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7017,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六经示儿子","author":"陆游","text":"六经如日月，万世固长悬。\n学不趋卑近，人谁非圣贤。\n马能龙作友，蜹乃瓮为天。\n我老空追悔，儿无弃壮年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7018,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"六峰项里看采杨梅连日留山中","author":"陆游","text":"绿阴翳翳连山市，丹实累累照路隅。\n未爱满盘堆火齐，先惊探颔得骊珠。\n斜簪宝髻看游舫，细织筠笼入上都。\n醉里自矜豪气在，欲乘风露摘千株。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7019,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"分韵作梅花诗得东字","author":"陆游","text":"浅寒篱落清霜后，疏影池塘淡月中。\n北客同春俱税驾，南枝与我两飘蓬。\n从来遇酒千钟少，此外评花四海空。\n惟恨广平风味减，坐看徐庾擅江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7020,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"刈穫后书事二首 其二","author":"陆游","text":"耄岁谁知困不苏，每虞黠鬼笑狂图。\n陶公老去但浊酒，管老归来惟白襦。\n不逐儿童觅兼味，且随邻曲了残租。\n细思自有欣然处，高谢人间九折途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7021,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]