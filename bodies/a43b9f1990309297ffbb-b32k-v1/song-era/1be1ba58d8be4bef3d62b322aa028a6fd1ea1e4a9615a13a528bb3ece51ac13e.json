[{"title":"田叔","author":"韦骧","text":"冒死随敖衣赭衣，当时踪迹已几希。\n忠哉相鲁扶君过，不使民情向我归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"感事","author":"韦骧","text":"治体清明已久成，世途攲侧未全平。\n憸人仗势千钧重，直士无媒一缕轻。\n忍视凿墉高外观，更嗟画饼窃虚名。\n山林岂是多扃鐍，自为区区志欲行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和鲁成之兄弟见谢","author":"韦骧","text":"新文来复数，旧观顿然还。\n愿助群锋锐，那惭砥石顽。\n辞豪虽欲抑，理属不容删。\n废懒幡多愧，衰迟近学山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"迎亲来毕幼妹之嫁久雨稽阻思望而作一首","author":"韦骧","text":"江南二月尚春寒，千里安舆冒险艰。\n远想长岐同积雨，不知今日过何山。\n出迎应喜诸孙慧，奉寿须惊两鬓班。\n从此莫轻离膝下，茹蔬坚乞侍高閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"董公肃都官被命倅南海以当分符之寄南归道中贶书因以诗为寄一首","author":"韦骧","text":"痟中邂逅饮寒冰，未及公书慰鄙情。\n脂辖近离双凤阙，拜恩新倅五羊城。\n旌旗晓过山川秀，笳鼓春归里落荣。\n诗社荒凉怀旧将，不知何日可寻盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答鲁成之兄弟以诗惠牡丹","author":"韦骧","text":"品冠名园盖物尤，主人分惠若为酬。\n摘兼残雨妖娆甚，将以新诗意义优。\n几树天香盈翠笼，一栏春色想鸿沟。\n满头恣插成狂醉，为恐花神恨暗投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻诏寄鲁成之兄弟","author":"韦骧","text":"天子需贤虑逸遗，诏书间岁出丹墀。\n嗟予衮衮成无状，羡子飘飘正得时。\n能将必先期敌胜，善占当自照心疑。\n相将岐路青云近，莫厌萧条更下帷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代官未至泊舟颁条门独宿署中","author":"韦骧","text":"独宿官居静，维舟古岸斜。\n尘埃犹吏局，烟水寄吾家。\n乡梦连宵动，归心计日差。\n向晨望星斗，晓橹趣呕哑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南湖晚霁","author":"韦骧","text":"雨脚随云断，湖光带日还。\n微虹初照水，馀雾尚怀山。\n理网渔歌喜，支篷孤棹閒。\n萧然安舣泊，尽室画图间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过白公堂","author":"韦骧","text":"四百馀年兵火后，至今遗构葺如新。\n谪官岂是多恩惠，谁谓文章不动人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庾楼","author":"韦骧","text":"仗节当年分国寄，危楼千古压江浔。\n山川风月宜如旧，疏旷还同庾老心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"狄公祠","author":"韦骧","text":"数间冷屋苍山觜，忠孝功名万载师。\n曲俗佞神惟畏祸，停舟祗谒小姑祠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陶令祠","author":"韦骧","text":"莫笑先生犹假醉，先生于道未宜轻。\n门前五柳今何在，唯有江流百丈清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舍绮霞阁五首呈石丈职方 其一 绮霞阁","author":"韦骧","text":"美构冠名城，区区喜与登。\n澄泉朝窃鉴，爽气夜相陵。\n物象方倾盖，襟怀过饮冰。\n苍葭此何幸，玉树是依凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舍绮霞阁五首呈石丈职方 其二 水中亭","author":"韦骧","text":"回环水面碧于蓝，晓夕清虚万象涵。\n佳趣不容为独揽，史君横彴在亭南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舍绮霞阁五首呈石丈职方 其三 枯荷","author":"韦骧","text":"绿萍漂合旧根斜，独恨来迟过了花。\n不见离披照秋水，尽依名阁作馀霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舍绮霞阁五首呈石丈职方 其四 蕉径","author":"韦骧","text":"两行对植接低圯，弱质毋嫌费壅治。\n十月绿阴犹满径，也胜蒲柳望秋衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舍绮霞阁五首呈石丈职方 其五 小山","author":"韦骧","text":"嵌空寻尺立池津，池北池南孰可邻。\n草树自羞还自笑，凋荣一节任天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和石丈职方长春花","author":"韦骧","text":"舄奕红芳续，皇皇若竞辰。\n尽居群卉右，独得四时春。\n孤节寒方见，滂葩日又新。\n笑梅侵腊候，欺菊冒萧晨。\n值赋知均被，生成此特频。\n咨咨偏惠意，天听杳难尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"待令移寓赵氏园亭","author":"韦骧","text":"待次乡闾计索然，故人亭馆寓?跧。\n折腰五斗羞彭泽，破屋数间如玉川。\n晓竹冒霜清节苦，夜禽啼月小声圆。\n萧条真趣非无赖，捽茹箪瓢素所便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺简夫石丈罢令先期请老","author":"韦骧","text":"七十能归世已稀，挂冠况在壮龄时。\n休风远过疏公上，清节未甘陶令卑。\n门枕白云朝睡美，席函明月夜杯迟。\n区区胶禄宁无耳，漏尽钟鸣合自思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遣兴一绝","author":"韦骧","text":"睡思容易醒，辗转衾裯单。\n今宵听风竹，始觉窗外寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得陈安道书知移邑名次","author":"韦骧","text":"安道枉书自东都，报我外移春可准。\n予方寂处藜藿空，蓄缩仅同枯壤蚓。\n闻之虽喜良自嗟，仕岂为贫今颇近。\n男儿有志期必行，五斗折腰何足悯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初睡","author":"韦骧","text":"冻云卷尽月华清，寒气棱棱夜转生。\n一卷古书齐万虑，满杯醇酎卧三更。\n附炎鄙态悲时薄，养僻孤踪任俗评。\n旷逸最便朝睡美，邻鸡不用再三鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆富川四首 其一","author":"韦骧","text":"渴忆富川好，官居似隐潜。\n江山慰情淡，鱼稻养贫廉。\n旅传无将送，狴牢绝滞淹。\n疏閒真自得，何恤远炎炎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆富川四首 其二","author":"韦骧","text":"渴忆富川好，孤城插翠屏。\n淳风在人物，真趣满郊坰。\n野屋千间古，晴山四壁青。\n别来千鄙思，偃卧阅图经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆富川四首 其三","author":"韦骧","text":"渴忆富川好，优游度岁时。\n白云藏治署，苍竹对书帷。\n弈战侵遗算，诗坛让拥麾。\n还乡固佳况，畴昔尚深思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆富川四首 其四","author":"韦骧","text":"渴忆富川好，官休欲放船。\n垂囊买村酿，掷饵得溪鲜。\n迹寄纷嚣外，怀摅旷逸全。\n交游日相醉，屡以去期迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪胡公弈棋","author":"韦骧","text":"区区席末侍枯棋，臆计苍黄胆欲飞。\n制胜固难施小智，冥行多是触沈机。\n狂谋殊愧千无得，锐气何劳十即围。\n贱子衄归深自庆，袛裯荣带老人辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清明","author":"韦骧","text":"去岁清明富水滨，今年旧里遘芳辰。\n风流萧洒殊前日，花木依稀似故人。\n游览不宜辞烂熳，别离还复在逡巡。\n暂閒幸可频吟醉，春色当于我辈亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阻雨","author":"韦骧","text":"清明未远正春浓，澍雨无情苦见攻。\n沽酒穷垆应减价，障泥豪锦若为功。\n轮蹄寂寞湖山闇，桃杏彫疏台榭空。\n唯有居閒足幽况，晏眠冷屋似山翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病目未愈","author":"韦骧","text":"病目私庐药足治，茫然盈月尚多眵。\n易平本远风埃路，难愈应缘笋蕨时。\n花入书编飞朴朴，星攒檐隙转累累。\n古今是否消深虑，视少唯便默以思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即事","author":"韦骧","text":"云物半阴晴，春罍酒气清。\n花空叶自隘，梅重核初成。\n噱论无柔语，酣歌有壮声。\n翠眉应见笑，先老掷风情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杜鹃","author":"韦骧","text":"杜鹃叫林表，晓窗色初分。\n却忆动乡思，去年江外闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周生哀辞","author":"韦骧","text":"所到固为命，嗟君志不通。\n未施稽古效，遽遘及泉凶。\n玉毁垂成际，兰摧共茂中。\n哀歌闭新垄，寂寞四山空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"致政胡郎中生日","author":"韦骧","text":"未容广受擅馀徽，远嗣亲荣二十期。\n山岳有神储秀日，朝廷无事乞身时。\n挂车濯濯吴风厚，奉寿诜诜夏景迟。\n贱士葭莩敢为献，愿光南国过期颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和简夫游南岩","author":"韦骧","text":"古寺因山半翠微，跻攀危蹬上云扉。\n祇应秀色随秋吹，还似红尘染客衣。\n子贱鸣弦方暇逸，渊明解绶已来归。\n吾侪幸得陪清览，相与优游养道肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和见招鼓山游","author":"韦骧","text":"气凉天淡正时秋，野兴山情猝未休。\n承召驩于凫藻甚，但忧尘迹累清游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和閒居","author":"韦骧","text":"雨馀秋气逼幽斋，时动新篇雅奏谐。\n不是溪山清耳目，自缘冰雪满襟怀。\n荣名疣赘心都弃，世事毫毛力已排。\n唯有鉴湖风月近，贺公前迹可为侪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和扑满","author":"韦骧","text":"一等出钧陶，唯便儿女曹。\n诲悭材甚小，扑满祸难逃。\n所忌同敧器，为忧在错刀。\n物微诚谕远，招损警贪饕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送处道丈之台任民掾","author":"韦骧","text":"词曹新调补，术学久坚完。\n有位欲行志，爱民无小官。\n脂车乘短日，山国动微寒。\n即听佳声满，贤劳岂或叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"简夫丈昔遗老杜别集而骧以外集当之久而亡去近承多本因以诗请","author":"韦骧","text":"昔日交传集外诗，规模虽记旧编遗。\n近闻几格多兼副，可赐閒中一解颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠项子后处士","author":"韦骧","text":"介似于陵可谓清，老来志操益坚成。\n胁肩傅会羞衰俗，捽茹优游尽此生。\n祇以图书养高性，不繇林薮市虚名。\n谁编野史防遗逸，当为先生作独行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"去年今日","author":"韦骧","text":"去年今日到宣州，舟倚昭亭晚雨收。\n鸭脚饤盘随土物，蟹螯将酒掩珍羞。\n溪间雁集菰蒲老，田外人歌?稏稠。\n此际剡游还忆旧，閒中情味两悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"忆江上","author":"韦骧","text":"故岁官还势亦勤，飘然单舸下长津。\n风江无定收帆早，夜浦多虞击柝频。\n俸辍稻粱虽怕乏，值轻鱼蟹不嫌贫。\n苍波古木应如旧，惆怅经由又隔春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"千佛岩读书寄内","author":"韦骧","text":"官期未迫暂閒身，敩学岩居及夜分。\n霜落空山寒切骨，风号万木响连云。\n有民勿谓书休读，无术当知政必棼。\n独宿不辞应会我，功名富贵本辛勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石夫人挽辞","author":"韦骧","text":"有子任清时，夫人新拂衣。\n人生到此乐，天数奈相违。\n壸肃风规在，奁閒粉泽微。\n云愁寒垄暮，何处是魂归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石经老挽辞","author":"韦骧","text":"已矣九泉归，嗟君值短期。\n胸襟遗草在，孝友阖门悲。\n学谢生前用，名多没后知。\n幽冥当自慰，造物本无私。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏唐史 李卫公","author":"韦骧","text":"能作膏肓遗萧辅，更于西北振威雄。\n若非明主矜羸老，几向高丽弃旧功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏唐史 李英公","author":"韦骧","text":"威加突厥胜长城，药赐须灰感圣情。\n垂没训言非不虑，奈何坟土竟遭平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏唐史 尹思正","author":"韦骧","text":"执笔威踰知一杖，忤权活得月将身。\n位终八座非为幸，埋戟相符岂不神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏唐史 李朝隐","author":"韦骧","text":"拽宦鞭奴蔑贵权，当时风骨愯衣冠。\n及为御史声名减，岂是官高便欲安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏唐史 张中令","author":"韦骧","text":"金镜文高压万珍，开元宠遇号知人。\n范阳奏日言如用，安得西蒙蜀道尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏唐史 李适之","author":"韦骧","text":"矿金言率遇参商，罢相还歌乐圣章。\n怖死宜春中奸贼，令人扼腕痛其亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏唐史 二阎","author":"韦骧","text":"八座蝉联属弟兄，当年门地足辉荣。\n可嗟不富经纶业，唯著丹青制造名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏唐史 苏世长","author":"韦骧","text":"披香殿上叹隋君，校猎营閒劝十旬。\n莫谓口忠心则诈，如何胶禄不言人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏唐史 刘知几","author":"韦骧","text":"五说三长历历陈，坚辞史任斥因循。\n若教直笔专归手，褒贬应能慰后人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏唐史 卢怀慎","author":"韦骧","text":"言极公忠器业清，死犹勤恳荐时英。\n贤哉度己推姚相，不幸幡成伴食名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏唐史 李林甫","author":"韦骧","text":"国忠祸衅根芽日，此贼倾唐势已先。\n搆陷名臣冤且众，天乎何意与终全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":45990,"sha256":"ed4f