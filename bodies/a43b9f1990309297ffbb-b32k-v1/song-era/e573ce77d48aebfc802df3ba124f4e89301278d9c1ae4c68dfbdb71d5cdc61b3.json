[{"title":"淮河舟中晓起看雪二首 其二","author":"杨万里","text":"梅花脑子撒成云，明月珠胎屑作尘。\n爱水舞来飞就影，怯风斜去却回身。\n真成一腊逢三白，并把三冬博一春。\n开放船窗尽渠入，天差滕六访诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淮河舟中晓起看雪二首 其一","author":"杨万里","text":"三日颠风刮地来，不成一雪肯空回。\n何曾半点漏春信，只怪千花连夜开。\n顷刻装严银世界，中间遍满玉楼台。\n琼船撑入玻瓈国，琪树瑶林不用栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日午憩黄池镇","author":"杨万里","text":"莫笑孤村小市头，花边人出浦边游。\n绿杨拂水双浮鸭，碧草粘天一落鸥。\n懒困风光酣午睡，阴沉天气嫁春愁。\n阿谁道是清明节，我对清明唤作秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明果饮二首 其二","author":"杨万里","text":"深著炉香浅著杯，杯行尽缓莫教催。\n可怜花树浑无赖，下却帘钩也入来。\n雪藕新将削冰水，蔗霜只好点青梅。\n明年寒食还家去，却忆荆溪花政开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明果饮二首 其一","author":"杨万里","text":"南溪春酒碧于江，北地鹅梨白似霜。\n颓却老人山作玉，更加食邑醉为乡。\n春光如许天何负，雨点殊疏燕不妨。\n绝爱杞萌如紫蕨，为烹茗椀洗诗肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清晓出城别王宣子舍人","author":"杨万里","text":"月细惟愁落，阳升未要忙。\n出门鸡未觉，夹路稻初香。\n涉世宁容懒，侵星幸稍凉。\n病来诗久废，觅句费商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清晓趋郡早炊幽居延福寺","author":"杨万里","text":"小轿欹还正，荒蹊细又纡。\n危峰上金镜，远草乱琼珠。\n雾外钟声近，花梢殿脊孤。\n老僧知我冷，展席傍红炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"理蔬","author":"杨万里","text":"小摘吾犹惜，频来径自成。\n青虫捕仍有，蠹叶病还生。\n贫里犹存灶，霜馀正可羹。\n窥园未妨学，抱瓮更须营。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"船过灵洲","author":"杨万里","text":"却缘野阔觉天低，政值潮平苦桨迟。\n洲觜两船归别港，岸头数屋出疏篱。\n江山惨淡真如画，烟雨空濛自一奇。\n病酒春眠不知晓，开门拾得一篇诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菜圃","author":"杨万里","text":"此圃何其窄，于侬已自华。\n看人浇白菜，分水及黄花。\n霜熟天殊暖，风微旆亦斜。\n笑摩桃竹杖，何日拄还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萧照邻参政大资挽诗二首 其二","author":"杨万里","text":"东府辞金印，南园伴赤松。\n门阑无薏苡，泉石自从容。\n忽作丁威鹤，云亡老子龙。\n一哀缘殄瘁，不是涕无从。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"萧照邻参政大资挽诗二首 其一","author":"杨万里","text":"父子双晁董，中兴只一家。\n里刚金百鍊，表粹玉无瑕。\n死力扶忠善，生平嫉佞邪。\n古人少全传，公传即非夸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒张安国","author":"杨万里","text":"帝苑花秾记并游，万人回首看鳌头。\n也知旬月应颛面，已逼云霄又作州。\n别后闻公非故我，学林著脚到前修。\n登门犹说同年话，未觉红鸾映白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒昌黎伯庙","author":"杨万里","text":"南海行几遍，东潮欠一来。\n若无韩子庙，只有越王台。\n文字天垂日，兴亡草上埃。\n聊吹鳄溪水，洒起六丁雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒范参政并赴袁起岩郡会坐中炽炭周围遂中火毒得疾垂死乃悟贵人多病皆养之太过耳","author":"杨万里","text":"后炭前炉便是窑，饶君是铁也教销。\n不须泉下火山狱，新制人间法外条。\n今日晴明殊可喜，病夫意绪自无聊。\n看来只欠刀圭药，脚踏层冰雪没腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野炊猿藤径树下","author":"杨万里","text":"径仄旁无地，林开忽有天。\n丹枫明远树，黄叶暗鸣泉。\n苔锦银枪灶，芦茸玉帐毡。\n从军古云乐，乞与个山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野菊","author":"杨万里","text":"未与骚人当糗粮，况随流俗作重阳。\n政缘在野有幽色，肯为无人减妙香。\n已晚相逢半山碧，便忙也折一枝黄。\n花应冷笑东篱族，犹向陶翁觅宠光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阊门外登溪船五首 其五","author":"杨万里","text":"无家不住曲溪边，祗种高山不种田。\n绝壁入天天入水，乱篙鸣石石鸣船。\n百滩春浪雪头过，两岸林花镜底眠。\n归路商量更舟楫，庐山彭蠡好风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阊门外登溪船五首 其四","author":"杨万里","text":"选甚天时晴未晴，舟行终是胜山行。\n篷忺雨点斜偏好，枕惯波声梦不惊。\n幸自车徒小休息，又闻鼓笛闹将迎。\n偶然回首来时路，一夜霜毛一倍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阊门外登溪船五首 其三","author":"杨万里","text":"当面峰头些子云，坐看吹作雨纷纷。\n朝来山路能愁我，今者溪船正要君。\n远岭轻盈横皱縠，明窗撩乱触惊蚊。\n犹争新涨一篙碧，遮莫飘萧二十分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阊门外登溪船五首 其二","author":"杨万里","text":"上得船来恰对山，一山顷刻变多般。\n初堆翠被百千摺，忽拔青瑶三两竿。\n夹岸儿童天上立，数村楼阁电中看。\n平生快意何曾梦，老向阊门下急滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阊门外登溪船五首 其一","author":"杨万里","text":"步下新船试水初，打头揽载适逢予。\n一椽板屋才经雨，两面油窗好读书。\n剩买春风木芍药，乱篸棐几竹籧篨。\n清溪浮取松亭子，赏遍千山不要驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中登姑苏台","author":"杨万里","text":"我亦闲来散病身，游人不用避车尘。\n插天四塔云中出，隔水诸峰雪后新。\n道是远瞻三百里，如何不见六千人。\n吴亡越霸今安在，台下年年花草春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪用欧阳公白战律仍禁用映雪访戴等故事赋三首示同社 其二","author":"杨万里","text":"是雨还堪拾，非花却解飞。\n儿童最无赖，抟弄肯言归。\n向树翻投竹，欺人故点衣。\n肩寒未妨耸，笔冻可能挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪用欧阳公白战律仍禁用映雪访戴等故事赋三首示同社 其三","author":"杨万里","text":"细听无仍有，贪看立又行。\n落时晨却暗，积处夜还明。\n幸自漫山好，何如到夏清。\n似知吾党意，未遣日华晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪用欧阳公白战律仍禁用映雪访戴等故事赋三首示同社 其一","author":"杨万里","text":"夜映非真晓，山明不觉遥。\n尽寒无奈爽，且落未须销。\n体怯心仍爱，颜衰酒强潮。\n毛锥自堪战，寸铁亦何消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后十日日暖雪犹未融","author":"杨万里","text":"地冻雪起立，檐生冰倒垂。\n日穿银笋透，风琢玉山欹。\n今晓还差暖，清寒退尚迟。\n生愁便销去，将底伴吟髭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后东园午望","author":"杨万里","text":"天色轻阴小霁中，昼眠初醒未惺松。\n梅横破屋无多雪，云放东山第一峰。\n不道风光亏此老，将何功业答残冬。\n土羔菜甲鹅儿酒，醉入梅林化作蜂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后陪使客游惠山寄怀尤延之","author":"杨万里","text":"已到苏州未到常，惠山孤秀蔚苍苍。\n一峰飞下如奔马，万木深围古道场。\n锡骨中空都是乳，玉泉致远久偏香。\n眠云跂石梁溪叟，恨杀风烟隔草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪冻未解散策郡圃","author":"杨万里","text":"积雪偏工霁后凝，不妨冷极不妨清。\n静闻檐滴元无雨，倒挂冰牙未怕晴。\n独往独来银粟地，一行一步玉沙声。\n圃中散策饶君强，敢犯霜风上古城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪夜候迎使客","author":"杨万里","text":"六花不放一尘生，晴后犹馀十日凝。\n新月未光输与雪，夜风尽冷只留冰。\n候迎银汉槎头客，挑尽玉虫窗下灯。\n纸帐蒲团地炉煖，自怜不及草庵僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪晴","author":"杨万里","text":"天公有诏放朝晴，排遣云师懒未行。\n头上忽张青玉伞，海东涌出紫金钲。\n雪山冰谷居然暖，银屋瑶台分外明。\n二十四船人笑语，寒声一变作春声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄太守元授挽词二首 其二","author":"杨万里","text":"我忝通家子，公如父行亲。\n一书虽不欠，半面遂无因。\n旅榇千江远，铭旌两竹新。\n庆门宁有此，造物岂其仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄太守元授挽词二首 其一","author":"杨万里","text":"五马新通贵，千牛旧不全。\n岂渠才作祟，从古命悬天。\n半世风波里，清名玉雪边。\n诸郎俱伟器，枢属更人先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄世成挽辞","author":"杨万里","text":"文行高无对，功名莫动渠。\n宁登逸民传，不著茂陵书。\n谁谓风流尽，犹疑信息疏。\n九京何所憾，玉树满庭除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄司法妻欧阳氏孺人挽诗","author":"杨万里","text":"法掾无双裔，夫人六一孙。\n夙勤南涧藻，晚享北堂萱。\n蒲圃严新槚，潘舆閟旧轩。\n庭阶森玉树，驷马看高门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龚令国英约小集感冷暴下归卧感而赋焉二首 其一","author":"杨万里","text":"客里何烦病，春馀不谓寒。\n并来无计奈，那得有怀宽。\n憎药犹须强，耽书更暇看。\n两亲问消息，敢道不平安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龚令国英约小集感冷暴下归卧感而赋焉二首 其二","author":"杨万里","text":"吏卒稀仍散，僮奴野自亲。\n问吾适无恙，遽病此何因。\n初觉身为客，还疑老逼人。\n焚香发深省，一笑对残春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食雨作","author":"杨万里","text":"双燕冲帘报禁烟，唤惊昼梦耸诗肩。\n晚寒政与花为地，晓雨能令水作天。\n桃李海棠聊病眼，清明寒食又来年。\n老来不办雕新句，报答风光且一篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食前三日行脚遇雨","author":"杨万里","text":"信脚那知远，虽劳亦快哉。\n如何寒食近，无数野花开。\n碧草望中去，黑云头上来。\n吾行吾自返，雨子不须催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食相将诸子游翟园得十诗 其一","author":"杨万里","text":"雨罢饶晴色，松阴转午时。\n堆成李花雪，开遍海棠枝。\n旋酌新篘酒，留题细字诗。\n不来真是枉，欲去更云迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓倅厅寒夜不寐","author":"杨万里","text":"不堪斜雨打虚窗，只愿晴阳送晓光。\n自是老人眠不著，近来春夜几曾长。\n楼头吹动梅花曲，梦里犹疑燕寝香。\n道是官居如客舍，等闲一宿两年强。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岁晚出城","author":"杨万里","text":"温饱能消底，奔忙自作痴。\n平生脚已茧，今日鬓将丝。\n山刻霜馀骨，梅临水底枝。\n只嫌长落莫，不道许幽奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"惠泉分茶示正孚长老","author":"杨万里","text":"寒泓不到十馀年，老眼重看意惘然。\n漱裂苍崖玉龙口，堕成清镜雪花天。\n须烦佛界三昧手，拈出茶经第二泉。\n珍重赞公惊久别，且谈诗句未谈禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"普明寺见梅","author":"杨万里","text":"城中忙失探梅期，初见僧窗一两枝。\n犹喜相看那恨晚，故应更好半开时。\n今冬不雪何关事，作伴孤芳却欠伊。\n月落山空正幽独，慰存无酒且新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"景灵宫闻子规","author":"杨万里","text":"今年未有子规声，忽向宫中树上鸣。\n告诉落花春不管，裴回晓月恨难平。\n斜风细雨又三月，柳絮浮云空一生。\n岂不怀归归未得，倩渠传语故园莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晴后雪冻","author":"杨万里","text":"负暄尚觉日无功，炙手仍愁火失红。\n本是雪前风作雪，却缘雪后雪生风。\n四郊冻合如相约，七日晴来不肯融。\n旧说醉乡堪避暑，避寒也合此乡中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暑中待月小酌","author":"杨万里","text":"火伞朝张复暮张，若教无月底禁当。\n隔林欲上光先漏，窥户无多气已凉。\n万里无云天似水，一奁新镜色如霜。\n广寒宫里应无酒，挽住姮娥劝一觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曾达臣挽词二首 其二","author":"杨万里","text":"议论千千古，胸怀一一奇。\n非关时弃我，不肯我干时。\n老鹤云间意，长松雪外姿。\n平生独知命，冷眼看人痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曾达臣挽词二首 其一","author":"杨万里","text":"珠冻兰溪水，冰封玉笥山。\n是翁元不死，蜕骨此中间。\n书画今存否，仪刑杳莫攀。\n端令郡博士，陟岵泪斑斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曾伯贡主簿挽诗二首 其二","author":"杨万里","text":"我壮君初冠，相逢便定交。\n即今俱白首，赴告忽黄茅。\n人物王兼谢，诗声岛与郊。\n病来无气力，不得奠兰肴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曾伯贡主簿挽诗二首 其一","author":"杨万里","text":"练练兰溪秀，家家玉树荣。\n兴安有才子，艮老是先生。\n师与三冬学，诗专五字城。\n一官才祭灶，作么便铭旌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朝饭罢登净远亭","author":"杨万里","text":"近水孤亭迥，萦城一径斜。\n霜林乌鹊国，冰岸鹭鸶家。\n殊觉冬曦暖，还拈小扇遮。\n传呼惠山水，来瀹建溪茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登大鞋岭望大海","author":"杨万里","text":"杖屦千崖表，波涛万顷前。\n琼天吹不定，银地湿无边。\n一石当流出，孤尖卓笔然。\n更将垂老眼，何许看风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登凤凰台","author":"杨万里","text":"千年百尺凤凰台，送尽潮回凤不回。\n白鹭北头江草合，乌衣西面杏花开。\n龙蟠虎踞山川在，古往今来鼓角哀。\n只有谪仙留句处，春风掌管拂蛛煤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69559,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登牛渚蛾眉亭二首 其二","author":"杨万里","text":"山拆江通万里流，菱花双照茧眉头。\n扫除却月横云样，别有颦风蹙雨愁。\n明月入波那可捉，长庚伴月本同游。\n君看夜夜青天上，渠与姮家分管秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69560,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登牛渚蛾眉亭二首 其一","author":"杨万里","text":"谪仙携妓戏人寰，也被千花妒玉颜。\n半点闲情千古恨，一波秋水两春山。\n锦袍宫烛云霄上，白苧乌纱江海间。\n欲寄双鱼招醉魄，月轮捉了蚤言还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69561,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"程泰之尚书龙学挽词二首 其二","author":"杨万里","text":"公弭江西节，侬横南浦舟。\n相逢便金石，一别几春秋。\n问讯频黄耳，归休各白头。\n丰碑那忍读，未读涕先流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69562,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"程泰之尚书龙学挽词二首 其一","author":"杨万里","text":"庙器圭璋骨，儒林虎豹章。\n韦编双辅嗣，禹迹再平当。\n月冷谈经幄，尘昏弄笔床。\n西州何处路，溪水咽梅乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69563,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答陆务观佛祖道院之戏","author":"杨万里","text":"老禅分得破丛林，薄供微斋也不曾。\n道院敕差权院事，筠庵身是住庵僧。\n人间赤日方如火，松下清风独似冰。\n别有暮春沂水在，为君一滴洒千灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69564,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答胡仲方赠诗","author":"杨万里","text":"畴昔昭王渡楚江，得萍斗大嚼甘芳。\n因君黄绶作此县，问古青蘋何处乡。\n民乐弦歌爱言偃，天将桃李醉河阳。\n望郎旧说为邑宰，邑宰今看为望郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69565,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答胡伯圜赠诗","author":"杨万里","text":"澹老郎君阿永贤，渥洼财驾折金鞭。\n只今两子似连璧，一建双旌开二天。\n白马将军震交阯，青钱学士即甘泉。\n弟兄蕙茂仍兰发，顿有机云在眼前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69566,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答章汉直","author":"杨万里","text":"诗人今代谢宣城，举手新年章子平。\n雨剩风残忽春暮，花催草唤又诗成。\n五湖烟水三冬卧，万里云霄一日程。\n老里睡多吟里少，旧来句熟近来生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69567,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫牡丹二首 其二","author":"杨万里","text":"岁岁东风二月时，司花辛苦染晴枝。\n夜输百斛蔷薇水，晓洗千层玉雪肌。\n寒食清明空过了，姚黄魏紫不曾知。\n春愁蹙得眉头破，何处如今更有诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69568,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫牡丹二首 其一","author":"杨万里","text":"万花不分不春妍，至竟专春是牡丹。\n紫锦香囊金屑暖，翠罗舞袖掌文寒。\n恨无国色天香句，借与风条日萼看。\n家有洛阳一千朵，三年归梦绕栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69569,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]