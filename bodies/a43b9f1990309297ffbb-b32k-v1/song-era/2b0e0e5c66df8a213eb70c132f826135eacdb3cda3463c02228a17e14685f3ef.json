[{"title":"次韵六四叔村居即事十二绝 其六","author":"刘子翚","text":"蠲病惟应一日晴，小窗萤度暗还明。\n韦编读罢闻幽鸟，演出精微是此声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵六四叔村居即事十二绝 其十一","author":"刘子翚","text":"屋角仙洲入眼明，清风澡涤醉魂醒。\n麻姑未必堪搔背，薄相由来是蔡经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵六四叔村居即事十二绝 其十二","author":"刘子翚","text":"几许椎埋尽把锄，而今户户偃犀渠。\n太平无象从何见，一夜春风长碧蔬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵朱乔年送山老住三峰二首 其二","author":"刘子翚","text":"平生耳里三峰寺，况识峰头新主人。\n借我一筇扶病去，月林松吹度纶巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵朱乔年送山老住三峰二首 其一","author":"刘子翚","text":"已爱云山信脚行，撩人诗句更增情。\n直须吏部寻盟日，急遣双鱼一寄声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵明仲幽居春来十首 其十","author":"刘子翚","text":"岂惭辛苦把渔竿，犹有机心傍钓滩。\n文定书堂最深稳，何如袖手试观澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵明仲幽居春来十首 其九","author":"刘子翚","text":"近邻分得续随栽，准拟新晴手自培。\n不奈馀寒侵病骨，锄耰无味却归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵明仲幽居春来十首 其六","author":"刘子翚","text":"莫遣潇湘双鲤来，归心生怕晓禽催。\n咄嗟新转渠渠屋，寒士欢颜正尔开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵明仲幽居春来十首 其四","author":"刘子翚","text":"归来十六见新元，种得黄楠绕旧村。\n岂是翛然便遗物，吾衰不复梦修门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵明仲幽居春来十首 其三","author":"刘子翚","text":"一幅乌巾雪发盈，村深时听鵽刀声。\n浪将兰艾评春事，我自平生小屈平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵明仲幽居春来十首 其二","author":"刘子翚","text":"幽居十绝巧凌春，我亦刳肠强效颦。\n忧乐悬知不同调，山南山北寂寥人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵明仲幽居春来十首 其一","author":"刘子翚","text":"醉毫叵我落乌丝，况是桃源乍入时。\n祇恐升平要华藻，赐笺春动万年枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵挹山亭张子猷绝句","author":"刘子翚","text":"鹤驾腾空春复秋，淡烟寒日锁林丘。\n夕郎自是金门客，莫更临风思远游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵黄宰一源亭二首 其二","author":"刘子翚","text":"宾榻浮尘拂不开，胸中丰恨结崔嵬。\n幔亭云散天全露，犹想双凫化舄来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵黄宰一源亭二首 其一","author":"刘子翚","text":"闻说催耕步涧幽，田家喜气共春浮。\n仁声似水潜潜物，不作惊人汹汹流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵傅茂元二绝 其二","author":"刘子翚","text":"酒兴何如毕吏部，诗情已过鲍参军。\n醉吟自足了一世，肯羡飘飘出岫云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵蔡学士岩桂","author":"刘子翚","text":"才应摛藻大明宫，戏咏岩花属意工。\n酷爱清香凌鼻观，更欣佳句愈头风。\n移来已觉池台胜，赏处何当杖屦同。\n不解小山招隐意，岩幽归梦绕青丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上","author":"刘子翚","text":"江上潮来浪薄天，隔江寒树晚生烟。\n北风三日无人渡，寂寞沙头一簇船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池莲四咏分韵 其四 子","author":"刘子翚","text":"分房圆戢戢，弄色翠娟娟。\n摘实怜空菂，方知雨露偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池莲四咏分韵 其二 花","author":"刘子翚","text":"孤红低映岸，并艳远连汀。\n露浥层层展，风披叶叶零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池莲四咏分韵 其三 藕","author":"刘子翚","text":"密蕴罗文细，明含玉色清。\n冰盘时荐美，刀惹断丝轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"约致明入开善不至二首 其二","author":"刘子翚","text":"偶临沙岸立多时，淡淡烟村日向低。\n幽事挽人归不得，一枝梅影浸澄溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"约致明入开善不至二首 其一","author":"刘子翚","text":"乔松翠竹锁禅关，乘兴时来兴尽还。\n懊恨刘郎招不得，瘦筇独自入寒山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"两山","author":"刘子翚","text":"渡南渡北两山遥，隔岸行人手可招。\n日暮海门烟雨黑，一川舟楫趁归潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"园蔬十咏 其八 子姜","author":"刘子翚","text":"新芽肌理腻，映日净如空。\n恰似匀妆指，柔尖带浅红。","collection":"宋","notice":"","provenance":{"re