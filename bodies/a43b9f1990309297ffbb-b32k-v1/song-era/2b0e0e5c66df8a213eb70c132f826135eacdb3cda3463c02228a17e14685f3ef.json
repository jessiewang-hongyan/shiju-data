3bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汴京纪事二十首 其九","author":"刘子翚","text":"神霄宫殿五云间，羽服黄冠缀晓班。\n诏许群臣亲受箓，步虚声里认龙颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汴京纪事二十首 其十","author":"刘子翚","text":"宫娃控马紫茸袍，笑撚金丸弹翠毛。\n凤辇北游今未返，蓬蓬艮岳内中高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汴京纪事二十首 其十一","author":"刘子翚","text":"笃耨清香步障遮，并桃冠子玉簪斜。\n一时风物堪魂断，机女犹挑韵字纱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汴京纪事二十首 其十二","author":"刘子翚","text":"万炬银花锦绣围，景龙门外软红飞。\n凄凉但有云头月，曾照当时步辇归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汴京纪事二十首 其十三","author":"刘子翚","text":"云芝九干麦双岐，盍有嘉生瑞圣时。\n玉殿称觞闻好语，时教张补撰宫词。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汴京纪事二十首 其十四","author":"刘子翚","text":"桥上游人度镜光，五花殿裹奏笙簧。\n日曛未放龙舟泊，中使传宣趣郓王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汴京纪事二十首 其十五","author":"刘子翚","text":"天厩龙媒十万蹄，春池蹴踏浪花飞。\n路人争看萧衙内，月下亲调御马归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汴京纪事二十首 其十六","author":"刘子翚","text":"盘石曾闻受国封，承恩不与倖臣同。\n时危运作高城炮，犹解捐躯立战功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汴京纪事二十首 其十七","author":"刘子翚","text":"梁园歌舞足风流，美酒如刀解断愁。\n忆得少年多乐事，夜深灯火上樊楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汴京纪事二十首 其十八","author":"刘子翚","text":"仓黄禁陌夜飞戈，南去人稀北去多。\n自古胡沙埋皓齿，不堪重唱蓬蓬歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汴京纪事二十首 其十九","author":"刘子翚","text":"河汉如云扫泬寥，登东寒铁响清宵。\n竹窗惊破高人梦，门外骎骎万马朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汴京纪事二十首 其二十","author":"刘子翚","text":"辇毂繁华事可伤，师师垂老过湖湘。\n缕衣檀板无颜色，一曲当时动帝王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汴堤","author":"刘子翚","text":"参差歌吹动离舟，宫女张帆信浪流。\n转尽柳堤三百曲，夜桥灯火看扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"沙头","author":"刘子翚","text":"沙头鸂鶒寒相傍，老树槃跚枝拂浪。\n前村急雨涨滩流，日暮渔舟撑不上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和士特栽果十首 其六 石榴","author":"刘子翚","text":"庭榴结实垫芳丛，一夜飞霜染茜容。\n万子同胞无异质，金房玉隔谩重重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和士特栽果十首 其二 李","author":"刘子翚","text":"仙枝移傍小岩幽，答遝名推第一流。\n曾向清波沈寒碧，甘瓜五色但轻浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和士特栽果十首 其九 来禽","author":"刘子翚","text":"粲粲来禽味独香，孤根谁徙向天涯。\n好寻青李相遮映，风味应同逸少家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和士特栽果十首 其八 枇杷","author":"刘子翚","text":"万斛金凡缀树稠，遗根汉苑识风流。\n也知不作清时瑞，朽腐那关故主忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和士特栽果十首 其七 枨","author":"刘子翚","text":"枨橘甘酸各效能，南苞锡贡不同升。\n果中亦抱遗才叹，有客攀条气拂膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和士特栽果十首 其一 桃","author":"刘子翚","text":"手种桃花满北山，花红艳艳照春湾。\n不知何代儿孙老，却见渔舟乍往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和士特栽果十首 其三 梅","author":"刘子翚","text":"园林渐见绿阴浓，漠漠轻烟细雨中。\n底事望梅能止渴，惟应万想先来空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和士特栽果十首 其十 椑柿","author":"刘子翚","text":"秋林黄叶晚霜严，熟蒂甘香味独兼。\n火伞赪虬浪褒拂，风标那似邑中黔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和士特栽果十首 其五 樱桃","author":"刘子翚","text":"一树含桃火烁空，而今春献隔离宫。\n只应壮士忧时泪，洒向枝头点点红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和士特栽果十首 其四 橘","author":"刘子翚","text":"南北由来地气偏，凌寒松柏但苍然。\n逾淮种橘今为枳，岂比中人性易迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和丘斯行牧牛颂","author":"刘子翚","text":"软草丰苗任满前，苍然觳觫卧寒烟。\n直饶牧得浑纯熟，痛处还应著一鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和熊叔雅四咏 其四 屏山夜雪","author":"刘子翚","text":"谁怜组练寒，夜雪连营积。\n有客卧衡茅，淮山梦中白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜凉","author":"刘子翚","text":"茅舍萧萧暑雨馀，夜凉清若在冰壶。\n一窗月上杉篁影，便是人间水墨图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拙句谢伯达老友","author":"刘子翚","text":"赠梅发言吾过矣，卫生无术谁之尤。\n鲁兀游心聊自遣，乐春举足岂无忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":27980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]