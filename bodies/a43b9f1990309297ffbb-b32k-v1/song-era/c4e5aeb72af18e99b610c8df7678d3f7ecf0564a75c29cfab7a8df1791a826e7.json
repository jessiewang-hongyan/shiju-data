[{"title":"至节日君仪见过诵思猿佳作","author":"郭祥正","text":"不赴郡楼宴，能过野寺门。\n抚循悲节物，飘泊任乾坤。\n瘴雾经霜尽，溪潮向晚浑。\n思猿有佳作，敢为倒清樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨怀安止三首 其一","author":"郭祥正","text":"春雨霪难霁，春山阻俊游。\n绿迷芳草恨，红湿落花愁。\n古剑空弹铗，疏帘懒上钩。\n何当生羽翼，一日似三秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨怀安止三首 其二","author":"郭祥正","text":"身隔空山雨，心同物外游。\n成篇超俗格，开卷释新愁。\n鸾凤翔青琐，蛟鼍挂玉钩。\n重吟垂翼句，春气返如秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨怀安止三首 其三","author":"郭祥正","text":"雨隔陈夫子，僧坊懒独游。\n闭门谁复过，欲语已含愁。\n病翼深防弹，惊鳞远避钩。\n交情君勿替，松柏挺霜秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻惠休师将浮海如吴省宝觉禅师","author":"郭祥正","text":"去兴已翩翩，轻包赴海船。\n雾收山翠湿，月出浪华鲜。\n鼓动看风力，浮沈信佛缘。\n何时达钟阜，重省宝公禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨霁怀进醇老","author":"郭祥正","text":"宿雨洗林扃，开窗晓色清。\n池深鱼竞跃，花落鸟频惊。\n结友论三益，营居共一城。\n风骚真有意，世事久无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"览进醇老诗卷","author":"郭祥正","text":"羁栖海上州，岁晚得师游。\n句泻碧潭月，篇成清夜秋。\n云根龙洞锁，花气蜜房收。\n此理何人达，营营枉白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同萧英伯登净惠寺山亭二首 其一","author":"郭祥正","text":"策杖轻衣惬，凭栏远目明。\n清江排暮钓，绿野碎春耕。\n嗜酒今非勇，题诗尚有情。\n薄游攀俊德，唐相旧家声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同萧英伯登净惠寺山亭二首 其二","author":"郭祥正","text":"一径穿林麓，幽人借杖扶。\n西山螺顶秀，南塔笔锋孤。\n好鸟当花语，轻烟衬草铺。\n登临情未足，暝色欲吞吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和英伯四首 其一","author":"郭祥正","text":"亭出林峦表，春归气象明。\n江晴稚子浴，田暖老夫耕。\n弱柳禁风力，游丝奈客情。\n欲归归未得，愁听杜鹃声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和英伯四首 其二","author":"郭祥正","text":"野兴怜诗逸，春酲要酒扶。\n登临同俊哲，笑傲不羁孤。\n日落金霞卷，江翻雪浪铺。\n闽山又寒食，何日到东吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和英伯四首 其三","author":"郭祥正","text":"亭临天外构，春物望中明。\n客兴托诗酒，野心怜钓耕。\n露花如有恨，风柳自含情。\n何事子规鸟，故为肠断声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又和英伯四首 其四","author":"郭祥正","text":"开亭当险绝，疑有百神扶。\n江静群鸥集，天空一鹗孤。\n落英红锦碎，狂絮白毡铺。\n试问江南信，归帆至自吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送惠休师浮海如吴","author":"郭祥正","text":"游吴兴不浅，真欲跨冥鸿。\n岂畏海波险，自明禅性空。\n柁楼瞻北斗，帆索张东风。\n我欲江南去，音书却易通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨中酌君仪所送酒有怀","author":"郭祥正","text":"冬雷知不密，地震复如何。\n海角晴明少，客心忧虑多。\n白鸥欺浪舞，黄鸟挟春歌。\n幸有故人酒，门深掩薜萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"午日送酒与元舆","author":"郭祥正","text":"前岁菖蒲酒，临汀共一樽。\n回思当触网，犹有未招魂。\n抱义君偏厚，馀生我尚存。\n都城酬此酌，佳节可重论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乐游轩呈运使陈大夫","author":"郭祥正","text":"狭径通萧寺，墙开薜荔阴。\n坐闻松籁奏，归待月华沈。\n雅有贤人乐，清无俗坌侵。\n一轩宁久驻，四海望为霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西池水漫莲叶资深劝予理之","author":"郭祥正","text":"短短芰荷叶，深深野水漫。\n何神能止雨，无术理惊湍。\n久客怀三径，包羞拘一官。\n赏心那复数，岁望骨毛寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"稍霁二首 其一","author":"郭祥正","text":"稍止今朝雨，犹埋瘴岭云。\n乱流安可塞，故老未尝闻。\n阴怪群难数，阳光晚渐分。\n仅能存井邑，不复念锄耘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"稍霁二首 其二","author":"郭祥正","text":"霪霖霾昼夜，积潦接郊郛。\n小艇家家有，危椽处处扶。\n稍晴人共喜，却暖鸟争呼。\n海若一何暴，几翻天地枢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自和二首 其一","author":"郭祥正","text":"已喜收微雨，还愁合暮云。\n潮痕殊未减，屋拆厌频闻。\n天地溟濛内，山川早晚分。\n吾民方乏食，何以慰耕耘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自和二首 其二","author":"郭祥正","text":"猛风来半夜，骇浪却平郛。\n避地忧桥断，登山借杖扶。\n马牛真不辨，老稚乱相呼。\n安得瞻晴景，苍苔绣户枢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净惠桥亭为水所漂因劝宽老葺之二首 其一","author":"郭祥正","text":"怊怅风兼雨，西桥半夜摧。\n青龙真变化，白鸟漫惊猜。\n荡潏无遗迹，登临不再来。\n道师如好事，重为购良材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净惠桥亭为水所漂因劝宽老葺之二首 其二","author":"郭祥正","text":"水涨西桥折，重来路已差。\n檐牙翻骇浪，石脚没平沙。\n梦想追尘迹，湮沈叹物华。\n何人能起废，壮观老禅家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈辑都曹致仕还乡","author":"郭祥正","text":"赋笔惊场屋，高才叹陆沈。\n宦游今日尽，野兴暮年深。\n黄菊看看秀，青云处处阴。\n君怀能亢爽，吾意亦侵寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟经彭泽谒靖节祠","author":"郭祥正","text":"彭泽江边邑，萧疏靖节祠。\n烟昏鹿皮画，草暗菊花篱。\n咏德今千载，言归彼一时。\n男儿要出处，此道几人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹子滩逢广漕张公诩二首 其一","author":"郭祥正","text":"泗水初倾盖，西江再逆舟。\n策能诛贼灭，心不为身谋。\n夜永谈无寐，樽空幸少留。\n迟明还惜别，飞桨下滩头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹子滩逢广漕张公诩二首 其二","author":"郭祥正","text":"会合嗟无酒，留连漫索茶。\n晚云随落日，归雁集寒沙。\n自达聊安命，多言任指瑕。\n吾宗有令弟，恩复出君家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"螺川送别王公济朝奉还台","author":"郭祥正","text":"亭上客送客，江头山映山。\n白醪须酌尽，彩凤欲飞还。\n帆转疏林外，烟生远渚间。\n离愁自堆积，辄莫唱阳关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郭晦叔知海州","author":"郭祥正","text":"凛凛汾阳秀，螺川旧徙居。\n文名动场屋，孝节冠乡闾。\n御史论才久，方州躐等除。\n朝廷终器使，宗庙得璠玙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"英州烟雨楼","author":"郭祥正","text":"江路分韶广，城楼压郡东。\n妓歌星汉上，客醉水云中。\n泼墨天涵暝，铺绡月映空。\n登临逢此景，不复念途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南山禅院","author":"郭祥正","text":"栋宇新成寺，黄金贴翠微。\n山眉一双碧，江带两条飞。\n乱石森门戟，晴云作地衣。\n薰弦谁与奏，松响泻珠玑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"廖华国史君致酒","author":"郭祥正","text":"飞盖穿林外，行厨就竹间。\n酒狂思海泻，歌响遏云还。\n逸骥方腾跃，疲驽强附攀。\n磨崖记名姓，长伴水潺潺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同颖叔修撰游吴圃分得须字","author":"郭祥正","text":"地与浮丘接，花如锦帐铺。\n杜康倾琥珀，海若献珊瑚。\n老竹争抽笋，幽禽自引雏。\n人生行乐尔，富贵亦何须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"即席和颖叔送别四韵","author":"郭祥正","text":"二月溟濛雨，春寒反似秋。\n玉觥浮浊浪，兰楫拟沧洲。\n自顾驽骀困，宁攀逸骥游。\n楚歌弹未彻，归思已难留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蔡梧州叙拜礼用四韵谢之兼送别","author":"郭祥正","text":"卓荦金闺客，经过慰老夫。\n能当韩子拜，深愧孟生愚。\n开卷诗千首，论交酒一壶。\n春风送和气，连夜入苍梧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄东莞李宰宣德","author":"郭祥正","text":"旧交几人在，宁嫌双鬓皤。\n一生长作客，九死漫悲歌。\n岁月惊秋速，关山恨别多。\n君须陟台省，吾欲隐松萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送象守贾正夫朝奉还台二首 其一","author":"郭祥正","text":"六载为南郡，归时雪满颠。\n一家才度岭，单骑欲朝天。\n介洁终无玷，精神老尚全。\n十分愁别酒，魂断鹄亭前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送象守贾正夫朝奉还台二首 其二","author":"郭祥正","text":"十载音书绝，扁舟忽见过。\n有樽倾别酒，无妓唱离歌。\n海阔春光少，城空瘴雾多。\n羡君先度岭，猿叫隔云萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和颖叔千岁枣","author":"郭祥正","text":"彼美祗园枣，珍同玉井船。\n后期千载熟，今日万珠圆。\n地润仍依佛，栏深自羃烟。\n结花虽最晚，藏核莫如坚。\n鸭脚看何小，鸡头美未全。\n种来谁共老，服久必成仙。\n大食移根远，番禺记蒂连。\n旧名稽药录，新赏著诗编。\n甜出诸饧上，香居百果前。\n黑腰虚羡尔，红皱岂为然。\n柔脆怜金凤，飘零难木绵。\n讽包丹荔赋，精夺宝刀篇。\n静夜风回海，清秋月蘸天。\n綵山要客集，翠颗绕枝骈。\n邂逅为公寿，婆娑与世延。\n暮钟催酒散，嘶马引旗旋。\n今作中州瑞，原从异国传。\n何当广栽植，欲以慰饥年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同颖叔修撰登蕃塔","author":"郭祥正","text":"宝塔疑神运，擎天此柱雄。\n势分吴越半，影插斗牛中。\n拔地无层限，登霄有路通。\n三城依作镇，一海自横空。\n礼佛诸蕃异，焚香与汉同。\n祝尧齐北极，望舶请南风。\n瑞气凝仙露，灵光散玉虹。\n铎音争响亮，春色正冲融。\n视笔添清逸，凭栏洗困蒙。\n更当高万丈，吾欲跨冥鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"将至历阳先寄王纯父贤守","author":"郭祥正","text":"竹马交游早，星轺会遇难。\n行年均坎坷，抚己共悲酸。\n凤去钟山暝，龙沉洛水寒。\n朝廷新日月，风俗旧衣冠。\n佳郡分符印，修途振羽翰。\n樽醪千蚁汎，楼瓦万鳞蟠。\n直节坚逾柏，忠心赤夺丹。\n才华佥论著，功业鼎铭刊。\n贱子初投阱，收身即弃官。\n生涯添鬓雪，岁序走江湍。\n造膝思陈榻，论诗愧杜坛。\n鹪鹩信微物，聊假一枝宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郑致国宣义见过小山留饮叙旧","author":"郭祥正","text":"一见翰林子，怅然怀昨游。\n尽为泉下鬼，犹有水中沤。\n屏迹今虽久，惊魂恐未收。\n残年唯伏枕，几月不登楼。\n促榻开青眼，论诗慰白头。\n岭云遮薄暑，江雨湿新秋。\n蔬饭惭无味，星轺强少留。\n会难真可惜，老去只添愁。\n明岁闻官满，高才副帝求。\n功名随会遇，阀阅畅源流。\n养大应知损，安卑且尚柔。\n不孤将有托，吾说肯虚投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得瑞金晖评上人书因以酬之","author":"郭祥正","text":"野寺三秋别，缄书一度收。\n青开今日眼，白尽昔年头。\n高义嗟难得，劳生苦远游。\n新亭名六以，真妄复何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题六以亭","author":"郭祥正","text":"以幻聊观幻，亭将六以名。\n隔林风籁息，满地月华清。\n不动超千劫，随缘度一生。\n有时拈榔标，划断野泉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立夏日示陈安国宣义","author":"郭祥正","text":"昨日春归尽，轻衣畏暑侵。\n落花空眷影，新叶自成阴。\n书永惟便睡，蝉清稍伴吟。\n小团宫样茗，分酌莫辞深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"携酒就陈安国隐居小酌","author":"郭祥正","text":"家住逍遥国，门无车马音。\n十分消睡茗，一寸已灰心。\n春去花应尽，潮生岸恐沉。\n径须携饮具，来傍荔支阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同崔员外访陈安国隐居","author":"郭祥正","text":"共出尘埃外，来寻董监家。\n未能穿草屩，且欲驾柴车。\n谷断双桥险，门荒一径斜。\n客心聊为洗，石鼎煮新茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书寻真观王契元先生祠堂","author":"郭祥正","text":"久悟寻真诀，应为蜕骨仙。\n寿龄过九十，功行满三千。\n旧话皆如约，知心信有缘。\n相思一杯酒，和泪洒云泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄九江陶子骏通直","author":"郭祥正","text":"家住庐山脚，堂开佚老名。\n清朝知止足，白发慰平生。\n日月归千载，乾坤付一觥。\n曾逢金马客，唤作小渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题程信叔朝散先坟思成堂归真亭二首 其一","author":"郭祥正","text":"水聚山仍合，营祠构一堂。\n丹青瞻邃表，簪笏遍诸郎。\n烟雨和春暝，松篁浥野香。\n命书连岁下，潜德发幽光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题程信叔朝散先坟思成堂归真亭二首 其二","author":"郭祥正","text":"世泽从今远，音容杳莫期。\n桃源春去后，华表鹤归时。\n月惨烟云晦，风生竹树悲。\n登亭还洒涕，千载景丰碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题赵康州石声编后","author":"郭祥正","text":"一贼鸣铜鼓，孤城陨使星。\n形骸糜矢石，忠义贯丹青。\n皎皎张巡传，新新李子铭。\n吾诗愧涓滴，何以助南溟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿广善院","author":"郭祥正","text":"峻岭隔人世，深云藏宝坊。\n龙鳞蟠碧瓦，虹影卧雕梁。\n道济三涂苦，斋馀七日香。\n炎天蚊蚋绝，此地信清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢贾明叔侍御见过弊庐","author":"郭祥正","text":"不是少陵客，宁烦谢守过。\n雨昏穷巷柳，风折小池荷。\n至论铿琼玉，幽情爱薜萝。\n朝廷容直道，予亦乐渔蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和胡与几承议藏云山云际寺留题","author":"郭祥正","text":"山路入云际，山深云更深。\n老龙方晦角，秀木不依林。\n溪溜冰生面，泉泓月赠心。\n何须长抱石，天下望成霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上巳席上有赠","author":"郭祥正","text":"眸子剪秋水，丹青画不真。\n谁知上巳日，忽见浣纱人。\n姑射长留月，桃源别有春。\n地衣新样锦，罗袜不生尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贾侍御同游石盆寺以白玉船酌酒","author":"郭祥正","text":"共访青山寺，仍翻白玉船。\n不忧身坠马，先觉口流涎。\n水镜初涵月，云峰半倚天。\n新堂虽未就，诗思已飘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄漳州陈昌国解元","author":"郭祥正","text":"为问陈昌国，醇醪几度春。\n海中消息断，枕上梦魂频。\n旧恨随流水，新吟待故人。\n何当骑鹿去，重笑九溪滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送褚南翁赴浔幕","author":"郭祥正","text":"学行从来著，官临益有规。\n众人皆信谤，惟我独无疑。\n万里还趋幕，三年且待时。\n烟霄歧路在，晚达未为迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送刘彦思推官","author":"郭祥正","text":"入幕三年久，还家万里遥。\n道孤谁汲引，政善众歌谣。\n北梦君方稳，南魂我未招。\n官醪不许买，别恨几时销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢倪敦复惠酒","author":"郭祥正","text":"江雨今朝霁，柴门爽气高。\n病馀逢七夕，书至得双醪。\n饮德知无尽，论心敢惮劳。\n凤团分赐茗，持以报诗豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"喜胡展诚改官南归","author":"郭祥正","text":"闻道扁舟至，南归得意人。\n拜官临百里，增禄慰双亲。\n所养应趋大，能廉不患贫。\n山家一樽酒，聊为拂京尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"何明道宣德话所见龙作四韵志之","author":"郭祥正","text":"跬步双龙起，惊嗟莫遁藏。\n冰鳞摇白影，火鬣纵红光。\n穴地遗涎在，排云曳尾长。\n不逢吴手画，想咏独难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送南剑王倅奉议","author":"郭祥正","text":"何幸一身老，亲逢三世贤。\n文章吾已尽，阀阅尔能传。\n归剑光生夜，层楼影插天。\n课书登善最，汉殿席应前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘汉阳见寄郎官湖佳作","author":"郭祥正","text":"出郭湖光满，转山湖影凉。\n得名因太白，起废自刘郎。\n石镜三更见，荷花一丈长。\n客来筹往事，兰草死犹香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":48077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]