[{"title":"次韵富修仲见赠二首 其一","author":"范浚","text":"故人欣面款，令我得眉伸。\n意有千金重，诗无一字陈。\n清规看后裔，贤业想前人。\n会续安边策，何当谒紫宸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33868,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"池上晚酌","author":"范浚","text":"雨馀池上兴悠哉，坐荫藤花藉石苔。\n白鸟联拳相对立，红蕖粲艳一时开。\n吐吞月色云浓淡，经纬水纹风去来。\n幽事相关心自乐，岸巾独啸更衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33869,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春饮分章字韵","author":"范浚","text":"传杯行美酿，击钵课名章。\n月借全窗白，花分小树香。\n人情欢不尽，道术醉相忘。\n鸡黍襟期厚，渠论汉范张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春望二首 其二","author":"范浚","text":"眺听不知暮，徘徊聊复吟。\n归云迷近谷，去鸟度前林。\n长日凭高目，伤春望远心。\n边方杀气在，天北惨沉阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春望二首 其一","author":"范浚","text":"岑楼上独园，高槛俯平原。\n野秀风烟合，春深草木繁。\n晴山明历历，远水去浑浑。\n兴出青冥外，心随独鹤翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"避盗泊舟武康远光亭下与同行分和杜工部诗伤秋及宿江边阁二首 其二","author":"范浚","text":"客子舟维岸，人家树作门。\n西风秋惨切，南鹊夜飞翻。\n恻恻惊心折，鞺鞺戍鼓喧。\n若为容足地，广大自乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"避盗泊舟武康远光亭下与同行分和杜工部诗伤秋及宿江边阁二首 其一","author":"范浚","text":"带郭人烟少，通村径路微。\n水光浮栋宇，野色动窗扉。\n小树无重数，前山不合围。\n艰危邻虎窟，奔迫诡牛衣。\n白舫竟何适，丹枫看即稀。\n西园小茅屋，知复几时归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵弟茂通郊行见梅","author":"范浚","text":"好风催冷蕊，上番即芳葩。\n春色独先得，年芳谁复加。\n日边看暖艳，雪后识真花。\n吟玩归来晚，江村月照沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初冬郊行","author":"范浚","text":"空阔野云疏，行行思郁纡。\n露花啼晚菊，风叶舞高梧。\n日落牛羊下，天寒雁鹜呼。\n却回南涧路，暝色拥蓬庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春雪晚晴出西村","author":"范浚","text":"步屐寻春犯雪泥，村南村北鹁鸠啼。\n堕梅残白犹明树，著柳暗黄初映堤。\n风景快晴云擘絮，江天未暮日悬规。\n最怜碧涨侵沙尾，更傍横桥一杖藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春融融效李长吉体","author":"范浚","text":"天暄地媚春融融，化工点染分花容。\n东风夜半入香陌，杂树晓繁争白红。\n兰丛蕙根芳翠滴，柳艳明眉轻羃䍥。\n红颜绿鬓青春客，壶中新醅鸭头色。\n残丝冉惹愁如织，日暮低迷草萋碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日行兰溪道中六言","author":"范浚","text":"远草连云碧积，繁花照日红酣。\n信马贪看春意，不知错过村南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送成都护戎韩舍人","author":"范祥","text":"全蜀兵符重，霄宸注念劳。\n临戎号人杰，分组得时髦。\n军府威名播，斋坛世阀高。\n历桥题驷马，扬旆启三刀。\n矍铄前谋大，澄清此志豪。\n忠臣希子贡，民颂继王褒。\n腊市繁千盖，春江涨万艘。\n浣溪云粉薄，公暇废援毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"满庭芳慢/满庭芳","author":"范致虚","text":"紫禁寒轻，瑶津冰泮，丽月光射千门。\n万年枝上，甘露惹祥氛。\n北阙华灯预赏，嬉游盛、丝管纷纷。\n东风峭，雪残梅瘦，烟锁凤城春。\n风光何处好，彩山万仞，宝炬凌云。\n尽欢陪舜乐，喜赞尧仁。\n天子千秋万岁，徵招宴、宰府师臣。\n君恩重，年年此夜，长祝本嘉辰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张承吉韵","author":"范偃","text":"飞阁临无地，巨区可平吞。\n高岩耸怪石，老木缠云根。\n人散鱼虾市，帆归葭苇村。\n每来豁尘虑，不妨频款门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和孟东野韵","author":"范偃","text":"散策欲薄暮，疏钟犹殷床。\n风烟函古趣，岩壑生幽香。\n仰首逼象纬，俯视渺川光。\n向来非突兀，几成虎豹场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"藤道","author":"范寅孙","text":"峻极藤为道，盘旋百转多。\n崖悬枯树杪，涧折怪岩阿。\n雁入云霄去，猿从荆棘过。\n谁云西蜀险，较此更如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"范寅亮","text":"寺藏螺髻顶，人在藕花心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂 其一","author":"范寅宾","text":"忽辞端委侍岩廊，归卧菟裘退老堂。\n远避势家萧相国，旁连永巷郭汾阳。\n江如渭水烟波碧，山似灵岩草木香。\n公向此閒留杖屦，宁知身在赤城傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"建炎丞相成国吕忠穆公退老堂 其二","author":"范寅宾","text":"不令甲第起康庄，却向郊园草作堂。\n庐阜规模临嵽嵲，霅溪颜色俯沧浪。\n参旂井钺聊遮户，赤舄貂冠且挂墙。\n几净窗明无俗事，愿公时草乞言章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"范崇","text":"川源通汉沔，舟楫下潇湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题江湖伟观","author":"范晞文","text":"西湖何处可消愁，快上人间百尺楼。\n千里山川浮王气，百年形势壮皇州。\n逋仙宅近梅应古，坡老祠空竹自秋。\n立遍阑干无限意，六桥歌舞懒回头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湖上","author":"范晞文","text":"湖边多少游湖者，半在断桥烟雨间。\n尽逐春风看歌舞，几人著眼到青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"燕山闻鹃","author":"范晞文","text":"燕山三月初三夜，听得啼鹃第一声。\n同是小楼孤烛下，主人熟睡客惊心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"意难忘","author":"范晞文","text":"清泪如铅。\n叹咸阳送远，露冷铜仙。\n岩花纷堕雪，津柳暗生烟。\n寒食后，暮江边。\n草色更芊芊。\n四十年，留春意绪，不似今年。\n山阴欲棹归船。\n暂停杯雨外，舞剑灯前。\n重逢应未卜，此别转堪怜。\n凭急管，倩繁弦。\n思苦调难传。\n望故乡，都将往事，付与啼鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江仙 成都西园","author":"范梦龙","text":"试问前村深雪里，小梅未放云英。\n阳和先到锦官城。\n南枝初破粉，东阁有馀清。\n人在高楼横怨管，寄将陇客新声。\n西园下晚看飞琼。\n春风催结子，金鼎待调羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岳阳","author":"范综","text":"万里山川宽眼界，两湖风月送天涯。\n云通巫峡襄王梦，鵩吊长沙贾谊家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"登慈恩塔","author":"范智闻","text":"独上慈恩塔，疏怀亦慨然。\n异朝多少事，不改旧山川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33895,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"苍玉洞","author":"范智闻","text":"山容巀嶭石为身，造化安排气象匀。\n杳窱一湾开洞府，巉岩四立护风尘。\n溪光照野疑无夜，树色参天不计春。\n谁把翠崖磨似玉，喜留诗语记幽人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33896,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 赠人博山","author":"范智闻","text":"紫素全如玉琢，清音不假金妆。\n海沈时许试芬芳。\n仿佛云飞仙掌。\n烟缕不愁凄断，宝钗还与商量。\n佳人特特为翻香。\n图得氤氲重上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33897,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岘山","author":"范微之","text":"南□会要地，山水控雄壮。\n峨峨峙岘首，浓绿叠千嶂。\n群峰相迤逦，顽□厕□□。\n汉流纪东麓，汪汪□□涨。\n原隰错绮组，云□织纤纩。\n景物革四时，眺听增万状。\n羊公昔镇抚，平吴启霸王。\n经国有馀裕，□□此登访。\n表表□形势。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33898,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"咏梅","author":"范楷","text":"开遍南枝又北枝，春风消息不嫌迟。\n平生自抱冰为骨，莫待趋炎附热时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33899,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠惠演","author":"范置公","text":"相逢三十年前话，记得途中并马御。\n顾我倦游成白首，喜君新命得青衫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33900,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纪西夏事 其三","author":"范雍","text":"剧贼称中塞，驱驰甲铠精。\n昔惟矜突骑，今亦教攻城。\n伏险多邀击，驱羸每玩兵。\n拘俘询虏事，肉尽一无声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33901,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"白兆山","author":"范雍","text":"车盖聊引步，浮云镇消忧。\n郧川梦泽地，古迹堪询求。\n白兆桃花岩，翰林栖此邱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33902,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"安陆","author":"范雍","text":"安陆号方镇，江边无事州。\n民淳讼词少，务简官政优。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33903,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纪西夏事 其二","author":"范雍","text":"承平废边事，备预久已亡。\n万卒不知战，两城皆复隍。\n轻敌谓小丑，视地固大荒。\n愿因狂狡叛，从此葺边防。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33904,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"纪西夏事 其一","author":"范雍","text":"七百里山界，飞沙与乱云。\n虏骑择虚至，戍兵常忌分。\n啸聚类宿鸟，奔败如惊麇。\n难稽守边法，应敌若丝棼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33905,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"范雍","text":"清凉万杉下，苍翠五峰前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33906,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"范雍","text":"山奇号九嵏，名与雍州同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33907,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"范雍","text":"日下涢川暮，烟横梦泽秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33908,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"范雍","text":"五老峰排连户色，万山寒耸入云株。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭赵忠定 其二","author":"范模","text":"鼌董青冥上，夔龙紫极边。\n五龙方夹日，九虎已当天。\n夷险丹心直，安危白发卷。\n吊湘人不去，何用解胶弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哭赵忠定 其一","author":"范模","text":"日月开黄道，乾坤奠浑仪。\n斯人今已矣，吾道竟何之。\n玉铉忧思苦，金縢感慨迟。\n仆碑今复立，恨不见封彝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城南塔院","author":"范端臣","text":"青天寥廓地轮囷，云海苍茫万里春。\n渺渺江风吹不断，塔中人与太虚邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜智者华藏二禅老到宝惠","author":"范端臣","text":"云窗共盥石潭冷，雪屋对吟山叶红。\n我欲径寻莲社去，莫将归目挂飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹅湖山","author":"范端臣","text":"缭垣千尺秀峰环，台殿参差杳霭间。\n更借西湖一千顷，为君题作小孤山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题游叫岩","author":"范端臣","text":"溪心碛石圆如磨，岩腹精庐冷似冰。\n弭楫来游冲夜雨，翛然一叟对孤僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秀野亭 其二","author":"范端臣","text":"不敢寻诗怕雨催，须知挈榼为春来。\n天公未放阳乌出，坐客何妨笑脸开。\n寒食花光犹照眼，乱山云气欲侵罍。\n黄昏数点池南雨，似惜香尘逐马回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秀野亭 其一","author":"范端臣","text":"乞得天公五亩春，暂抛手板著纶巾。\n搴花露粉频沾袖，洗竹山光忽傍人。\n金点流莺田幂幂，雪翘幽鹭水粼粼。\n尊前无地栖荣辱，秀野亭中自在身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岭南鞭春","author":"范端臣","text":"一辞湖上月，三见岭南春。\n怪鸟呼如鬼，痴猿立似人。\n蛮商通海舶，渔户杂江滨。\n尚有鞭牛扑，纷拿起路尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"挽龙图待制徐良能墓","author":"范端臣","text":"少日蜚声竦白袍，暮年策足上青霄。\n功名略已追前辈，事业真堪托后凋。\n谏草半焚烟寂寂，琐窗一梦夜寥寥。\n古塘原上谁行路，只有哀笳引葬箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题密山寺壁","author":"范端臣","text":"篱落邻林麓，江湾应霭烟。\n乌鸦依野屋，独鹿度平田。\n孤阁高竿隔，篮棂绿柳连。\n僧栖心象息，游衍亦夤缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"藏春园","author":"范端臣","text":"园径萧条草树荒，半山林影净回塘。\n墙根绕荠春还近，亭角舒梅暖自香。\n两鬓斜知随节改，百忧差喜得身强。\n寻诗问酒追豪胜，且送残年入醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又仙山行","author":"范端臣","text":"仙山仙山郁嵯峨，紫烟氤氲生绿波。\n飞琼玉楼不知处，杂佩丁珰隔烟语。\n三青山鸟去不来，六龙落日只衔哀。\n呼声嗷嗷动天地，老蛟吹涎海波沸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"下洞","author":"范端臣","text":"孤烟灵洞远，未羡三茅山。\n柏子得妙见，梅花有奇攀。\n虽无金碧丽，高士昔所关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天池泉","author":"范端臣","text":"天然水泓洞，不涸亦不涌。\n纷披石苔静，掩翳寒茗拥。\n微风不生波，金刹影时动。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬日寓宝惠教寺","author":"范端臣","text":"观书倦棐几，理策开蓬门。\n萦纡竹溪步，迤逦僧家园。\n云容酿密雪，烟景收残暾。\n人语野桥店，鸟鸣桑柘村。\n山深古殿閟，涧曲回流喧。\n松桂不改色，梅蕊亦已繁。\n久厌城市卑，愈觉山林尊。\n归途偶成咏，所乐非所言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"半山亭","author":"范端臣","text":"窈窕转岩腹，划然见孤亭。\n横分树矗矗，下枕溪泠泠。\n日暮人迹绝，犹闻樵斧声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"石磴","author":"范端臣","text":"短策将我影，照尽山前溪。\n夤缘入风磴，历览穷攀跻。\n不须剪梧桐，自倚青冥梯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"此君轩","author":"范端臣","text":"主人结屋清溪侧，对敞轩扉幽更僻。\n自怜桃李涴尘泥，故植琅玕对丛碧。\n只今俗子纷廛阓，铜臭熏天誇侈极。\n曲眉皓齿宴华堂，嫚绿妖红醉春色。\n争如此处是潇洒，左右牙签散图籍。\n暑风韵玉脱豹胎，凉月影金交兔魄。\n我来登轩同赋诗，试问何如严武宅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怪石","author":"范端臣","text":"人间足安危，顷刻异候状。\n唯应山中石，不受客尘障。\n搜奇贮元龙，飞云劳鲁望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洞桥","author":"范端臣","text":"桥边十丈水，折干馀风霆。\n桥下一泓水，泠然照吾缨。\n世故暂如失，兹山得深行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新嫁别","author":"范端臣","text":"邻家新妇谁家女，昨日嫁来今日去。\n徘徊欲去呼问之，何乃遽遭姑舅怒。\n妇欲致词先泪雨，妾在村东年十五。\n长成只待嫁良人，不识人间离别苦。\n妾从五岁遭乱离，频年况逢年凶饥。\n母躬蚕桑父锄犁，耕无馀粮织无衣。\n十年辛苦寸粒积，倒箧倾囊资女适。\n岂知薄命嫁良人，招得偷儿夜穿壁。\n晓看奁橐无馀遗，罗绮不见空泪垂。\n公姑忌妾遣妾去，欢意翻成长别离。\n公姑遣妾妾难住，出门惘失来时路。\n不恨良媒恨妾身，生离不为夫征戍。\n我闻此语长嗟咨，谁知贼遣人分离。\n抚人捕贼官乃职，纵贼不捕官何为。\n妇言妾去君莫语，偷儿如鼠官如虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题灵洞路","author":"范端臣","text":"傍溪多立石，径转特勾衣。\n云兼晚色至，叶带秋声飞。\n孤鹭忽惊去，片云明残晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇 其二 上太守月词","author":"范端臣","text":"玉楼绛气，卷霞绡云浪，飞空蟾魄。\n人世江山惊照耀，烟霭鳌峰千尺。\n陆海蓬壶，银葩星晕，点破琉璃碧。\n有人吟笑，紫荷香满晴陌。\n况是东府君侯，西清别骑，樽俎开华席。\n迤逦飞轮催杖履，入对青藜仙客。\n襦裤歌谣，升平风露，拼取金莲侧。\n梅花吹动，满城依旧春色。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秀野亭","author":"范端杲","text":"高着春山最蔚蓝，截然屹立白云端。\n小亭为爱依青壁，野色当窗指点看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游宝惠寺山","author":"范端杲","text":"不到兹山久，寒梅又著花。\n白烟丛古木，乌鹊倚枯槎。\n路转冲危石，泉流涨浅沙。\n不堪回首处，樵唱起呕哑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]