[{"title":"点绛唇 其九 妙香檐卜","author":"王十朋","text":"毗舍遥遥，异香一炷驰名久。\n妙香稀有。\n鼻观深参透。\n问讯东来，知□谁先后。\n称仙友。\n十花为偶。\n近有江西守。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其十三 清香莲","author":"王十朋","text":"十里西湖，淡妆浓抹如西子。\n藕花簪水。\n清净香无比。\n记得曾游，短棹红云里。\n聊相拟。\n一盆池水。\n十里西湖似。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其八 韵香荼蘼","author":"王十朋","text":"羽盖垂垂，玉英乱簇春光满。\n韵香清远。\n暖日烘庭院。\n露浥琼枝，脸透何郎晕。\n凝余恨。\n古人不见。\n谁与花公论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其十六 奇香蜡梅","author":"王十朋","text":"蜡换梅姿，天然香韵初非俗。\n蝶驰蜂逐。\n蜜在花梢熟。\n岩壑深藏，几载甘幽独。\n因坡谷。\n一标题目。\n高价掀兰菊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇 其四 国香兰","author":"王十朋","text":"芳友依依，结根遥向深林外。\n国香风递。\n始见殊萧艾。\n雅操幽姿，不怕无人采。\n堪纫佩。\n灵均千载。\n九畹遗芳在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"踏莎行","author":"王万之","text":"柳外寒轻，水边亭小。\n昨朝燕子归来了。\n天涯无数旧愁根，东风种得成芳草。\n亭畔秋千，当时欢笑。\n香肌不满和衣抱。\n那堪别后更思量，春来瘦得知多少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"经筵彻章御赐诗卷","author":"王与钧","text":"一种寒梅白玉条，迥临村路傍溪桥。\n应缘近水花先发，疑是经春雪未消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代谢刘小坡送乡会劝酒赓韵 其一","author":"王与钧","text":"履端开帝历，会拜谨王春。\n百世枌榆旧，一番桃李新。\n珍颁来腆渥，妙句带清真。\n骑省云霄上，宁辞染翰频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代谢刘小坡送乡会劝酒赓韵 其二","author":"王与钧","text":"一枝鹪漫集，千仞凤方翔。\n谏纸清时省，经帷镇日香。\n湖波怜鸭绿，宫酝挹鹅黄。\n应轸乡中士，毛锥未脱囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游洞霄宫","author":"王与能","text":"洞霄飞杖屦，人境共真清。\n天柱擎峰出，丹泉迸霤生。\n栖岩遗隐迹，漱石洗虚名。\n珍重乐斯者，微吟谩纪行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赓翠蛟亭韵","author":"王与能","text":"灵砂九转鍊金顽，留得丹泉在此间。\n明月清风谁管领，洞天福地占幽闲。\n岩巅雪涌金波立，石罅潮生银屋翻。\n句续坡仙怀古意，梅花也觉带欢颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送李按察之任","author":"王之奇","text":"先生持使节，极力救生民。\n郡县宁无弊，朝廷未有闻。\n某官贪可去，若事屈宜伸。\n更为君王说，如今可用文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"王之奇","text":"炳若丹青敷德义，后人于此取良规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又题鸿祐寺","author":"王之望","text":"石佛山头日欲颓，寻僧不遇懒空回。\n青鞋布袜云门路，拄杖穿林归去来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"以鼎炉遗关子东有诗相谢次韵 其二","author":"王之望","text":"赠君剑川八卦鼎，一饼清泉终日然。\n净几明窗读周易，妙香时炷不论钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏景思 其一","author":"王之望","text":"明镜佳期故未忘，月圆人缺恨何长。\n阳台朝暮谁为主，梦里时时怨楚王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏景思 其二","author":"王之望","text":"颜色倾城艺更精，爱卿长是说卿卿。\n卷中昔日崔徽貌，重见应怜太瘦生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王司户梅花五绝不得用古人意及比妇人玉雪并洁白等字 其五","author":"王之望","text":"一岁都来几日开，一开能得几回来。\n清尊留待溪边月，不怕山城晚鼓催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王司户梅花五绝不得用古人意及比妇人玉雪并洁白等字 其二","author":"王之望","text":"溪外人家处处栽，三分蓓蕾一分开。\n故教嫩萼参差发，似要幽人次第来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王司户梅花五绝不得用古人意及比妇人玉雪并洁白等字 其四","author":"王之望","text":"闻说江梅已恼人，冲寒著意去寻春。\n枝枝细看枝枝好，岁岁相逢岁岁新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵王司户梅花五绝不得用古人意及比妇人玉雪并洁白等字 其一","author":"王之望","text":"牢落天涯邂逅逢，清愁幽恨与谁同。\n故园肠断三千里，客里看花岁又穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10067,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尚书李丈六绝 其六","author":"王之望","text":"雨过千山翠色重，群花欲尽絮飞空。\n牡丹寂寞芬芳晚，日暮朱栏独倚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10068,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尚书李丈六绝 其五","author":"王之望","text":"经旬山雨暗春辉，桃李成阴总未知。\n试逐东风入城市，不妨尊酒暂娱嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10069,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尚书李丈六绝 其一","author":"王之望","text":"丈人诗律照青春，句到诸郎副析薪。\n特许八分传阿买，囊收珠玉破清贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10070,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尚书李丈六绝 其二","author":"王之望","text":"风光无赖恼诗翁，健笔凌云思未慵。\n长句数篇欺白雪，江山浩荡发春容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10071,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尚书李丈六绝 其三","author":"王之望","text":"近侍三朝捧御床，宫衣犹带内家香。\n殊庭更得流霞助，杖屦春风步履强。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10072,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和尚书李丈六绝 其四","author":"王之望","text":"休论世事苦悲辛，龙卧南阳自有人。\n指日承明却归去，烟花紫禁及青春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10073,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和姚令威春阴四绝 其三","author":"王之望","text":"雨过山村绿满陂，红芳渐少翠阴低。\n春风吹草依然碧，潮水浮花却自西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10074,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和姚令威春阴四绝 其四","author":"王之望","text":"休对风光感物华，且将春酒趁春赊。\n一声杜宇芳菲晚，只有荼?芍药花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10075,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和姚令威春阴四绝 其二","author":"王之望","text":"十日春阴昼景微，鸣鸠逐妇几时归。\n柔桑细麦宁馨长，落絮游丝可解飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10076,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和姚令威春阴四绝 其一","author":"王之望","text":"急雨颠风带海烟，白头肠断落花天。\n东风为买春光住，柳撒黄金榆掷钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10077,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和钱处和梅花五绝 其一","author":"王之望","text":"万木归根冷未滋，可怜孤绝发寒枝。\n心期本在冰霜后，占得隆冬未恨迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10078,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和钱处和梅花五绝 其五","author":"王之望","text":"林下风神物外姿，闺房秀色鉴中奇。\n两家标韵谁兼得，会有多情识者知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10079,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和钱处和梅花五绝 其三","author":"王之望","text":"莫欺玉蕊瘦栾栾，中有江南长恨端。\n白发天涯归未得，年年老眼泪中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10080,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和钱处和梅花五绝 其四","author":"王之望","text":"铁心开府不妨狂，赋语清便独擅唐。\n堪笑离骚穷逐客，只知兰蕙有幽香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10081,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和钱处和梅花五绝 其二","author":"王之望","text":"枝上春风渐有涯，断魂初见两三花。\n一尊尽日看无厌，要待参横月影斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10082,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送海棠与姚令威","author":"王之望","text":"酣酣芳意不胜春，一笑嫣然恼杀人。\n分寄多情还解否，要教国色在东邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10083,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郢守乔民瞻寄襄阳雪中三绝因追述前过石城杯酒登临之胜为和 其一","author":"王之望","text":"沧浪渡口莫愁乡，万顷寒烟木落霜。\n珍重使君留客意，一尊芳酒醉斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10084,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郢守乔民瞻寄襄阳雪中三绝因追述前过石城杯酒登临之胜为和 其二","author":"王之望","text":"江上危亭思黯然，追游陈迹欲经年。\n别来西望应相忆，郢树荆门共一川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10085,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郢守乔民瞻寄襄阳雪中三绝因追述前过石城杯酒登临之胜为和 其三","author":"王之望","text":"白雪楼倾不记秋，楼前江水自悠悠。\n多情犹忆湖南守，一曲阳春白尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10086,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钟鼓山间久雨二绝 其二","author":"王之望","text":"高林缥缈强可见，茅屋半山烟雨昏。\n谁家一幅鹅溪绢，古画犹存水墨痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10087,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饶守陈粹中有诗见留次韵为谢","author":"王之望","text":"相逢一笑又相离，肠断登临送别时。\n久占都亭惭重客，秋风回首片帆迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10088,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"倚江亭会上虞伯逵送梅花并二绝句坐上次韵并调贺子忱 其二","author":"王之望","text":"喜见江梅又著花，插来不怕帽檐斜。\n高标幽韵谁真似，人在风流贺监家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10089,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"倚江亭会上虞伯逵送梅花并二绝句坐上次韵并调贺子忱 其一","author":"王之望","text":"肠断江头索笑花，三三两两逐枝斜。\n忽随清绝惊人句，来自西湖处士家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10090,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病馀兀坐偶成二绝 其一","author":"王之望","text":"寂寂经旬病卧家，起来都不记年华。\n一声檐上惊秋晚，墙外初闻卖菊花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10091,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病馀兀坐偶成二绝 其二","author":"王之望","text":"病骨栾栾瘦转加，秋风怯傍小窗纱。\n萧然丈室维摩观，一炷清香到日斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10092,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢景思惠酒并二绝时宗守邀看上元景思不至次韵 其一","author":"王之望","text":"户外惊闻剥啄声，东山消息到柴荆。\n两章著意撩衰白，风味相扶有曲生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10093,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢景思惠酒并二绝时宗守邀看上元景思不至次韵 其二","author":"王之望","text":"使君高会著幽人，灯火元宵醉夜分。\n博士从来文字饮，不妨聊复醉红裙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10094,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题邓寨周氏小园","author":"王之望","text":"径草荒春绿作堆，东风深入小园来。\n可怜几阵嫣香里，立尽庭前数树梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10095,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题前诗已天忽作雨戏成一绝","author":"王之望","text":"岁暮灵泉水未饶，苍崖无复舞飞蛟。\n诗成不觉天零雨，料得神龙欲解嘲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10096,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题真符道中山寺","author":"王之望","text":"江路南风涨白沙，镫驴来憩梵王家。\n片云忽作萧萧雨，梦断僧窗日未斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10097,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙巳四月自都下省欧阳氏姊于封丘时河朔流移满道即事有作寄范觉民","author":"王之望","text":"北出都门道，红尘污客襟。\n号蝉如有意，高柳自成阴。\n辙乱思良马，林幽慕逸禽。\n据鞍回首处，愈觉帝阍深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10098,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和 其一","author":"王之望","text":"胜游每恨不相同，邮递犹欣日日通。\n玉帐未容佳境到，云山已在好诗中。\n灵珠忽富千金赠，凡马堪嗟万古空。\n展卷高吟知几过，大音一震耳根聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10099,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和 其三","author":"王之望","text":"新篇孤峻绝阶梯，照眼光芒五色迷。\n已向诗坛称独步，不妨祖令更全提。\n真空雅与高情契，绝景终希大手题。\n馀事文章暂游戏，要将李杜与名齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10100,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和 其四","author":"王之望","text":"住因得坎去乘流，万里西南更倦游。\n三径未成归计晚，一尊犹喜故人投。\n小篇偶寓诗筒去，佳句还劳驿使酬。\n得与诸贤更倡和，故应盛事播西州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10101,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和 其二","author":"王之望","text":"尘劳汩没老尤顽，遍走岷峨杳霭间。\n筋力已疲难报国，田园有计即归山。\n何期俗驾经时出，却得浮生数日閒。\n已请一麾江海去，故应生入玉门关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10102,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"丈人观设醮留题","author":"王之望","text":"翠麓丹崖敞洞天，琼宫珠殿照云烟。\n森罗壁绘推前辈，缥缈楼居见列仙。\n朝斗坛边星象冷，步虚声内月华圆。\n尘埃迥隔人间世，骨悚魂清夜不眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10103,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上曾二丈仲成 其二","author":"王之望","text":"忆拜冰壶日下时，先君未老我方儿。\n庭闱一閟成今昔，世路重来太险巇。\n风义肯忘三益友，姓名愿入八哀诗。\n遗孤么么何能报，泉下幽魂傥有知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10104,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上曾二丈仲成 其三","author":"王之望","text":"患难馀生二十年，一身孤苦百忧缠。\n文章昔谓古可到，踪迹今为人所怜。\n憔悴形容勋业镜，归依空寂祖师禅。\n不孤虽有山公在，恐逐龙舒下九泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10105,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上曾二丈仲成 其一","author":"王之望","text":"湖海元龙气尚豪，笑谈谁料已霜毛。\n文章家法西京在，兄弟才名北斗高。\n欲取功名酬老大，岂将州县叹徒劳。\n登坛不独风骚将，出幕他年看节旄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10106,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与同舍游净明是日大寒予独乘马诸公以孟浩然相戏以其乡人故也关丈有诗次韵","author":"王之望","text":"惨淡阴风暗广川，冲寒直到白云边。\n寒驴苦忆长安道，古寺深行小有天。\n岘首诗人穷入画，孤山处士句堪传。\n疑君便是林君复，妙字清题故宛然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10107,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大龙湫","author":"王之望","text":"瀑水传闻旧壮哉，飞流亭下久徘徊。\n玉龙鳞甲寒犹蛰，银汉波澜冻未开。\n斜日湫潭微溅雨，深冬天地不鸣雷。\n斯游未快平时意，更拟他年得得来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10108,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋同儿侄登宝峰亭","author":"王之望","text":"绝顶凭栏思有馀，沧江下眺眇三隅。\n月光此夜十分满，风色今朝一点无。\n乡国不须悲楚蜀，庭阶且喜集封胡。\n史君邂逅分鲜鲫，斫鲙还成逸少图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10109,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文监丞出关子东西湖春游倡和且约为重九之游次韵","author":"王之望","text":"西湖烂醉踏青天，秀句重寻未隔年。\n已约清樽携九日，要将黄菊荐三贤。\n深秋风日明寒水，宿雨波澜起画船。\n佳气葱茏如有待，晓妆浓淡抹非烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10110,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"帅漕复次韵再和","author":"王之望","text":"二豪诗律晋江东，迭倡更酬卷轴丰。\n狎主齐盟争定霸，互为勍敌锐临戎。\n波澜已得江流助，组丽仍依锦段红。\n入蜀词人多妙句，向来严杜一编同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10111,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙华山寺寓居十首 其十","author":"王之望","text":"水乡经月雨，潮海暮春天。\n芒种嗟无日，来牟失有年。\n人多逢菜色，村或断炊烟。\n谁谓山中乐，忧来百虑煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10112,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙华山寺寓居十首 其九","author":"王之望","text":"杜宇来何处，天涯又复鸣。\n空山听更激，寒夜窈难明。\n故国三千里，春风第一声。\n年年羁旅地，愁绝不胜情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙华山寺寓居十首 其八","author":"王之望","text":"有客过松径，呼儿下竹关。\n张灯深夜语，沽酒远村还。\n醇异交公瑾，清非醉景山。\n剧谈自有理，不在浊醪间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙华山寺寓居十首 其七","author":"王之望","text":"羊乳茎犹嫩，猪牙叶未残。\n呼童聊小摘，为尔得加餐。\n仗马卑三品，山雌慕一箪。\n朝来食指动，苦菜入春盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"龙华山寺寓居十首 其六","author":"王之望","text":"时节清明过，溪山晴霁初。\n出游偕妇子，相识半樵渔。\n稼穑归宁遂，经纶计已疏。\n渊明至穷约，三径亦吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":10116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]