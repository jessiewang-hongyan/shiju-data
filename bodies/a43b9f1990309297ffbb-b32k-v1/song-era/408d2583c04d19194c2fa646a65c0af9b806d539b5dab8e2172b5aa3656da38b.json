[{"title":"禅人写真请赞 其十","author":"释昙华","text":"茅屋紫霄下，良田石镜边。\n此生随分过，不用买山钱。\n这般恶比丘，何人敢近傍。\n恣焚三毒火，力起无根谤。\n破除少室窠巢，并荡衲僧见障。\n闻者见者攒眉，应是无人瞻仰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真请赞 其九","author":"释昙华","text":"江上青山千万叠，水边茅屋两三间。\n朝来无限扁舟过，何似渠侬把钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真请赞 其四","author":"释昙华","text":"竖拂拄拂，全机出没。\n一喝耳聋三日，丛林至今狼藉。\n屈屈，且道是马祖屈，百丈屈，归宗屈。\n宗一侍者，但恁么拈出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真请赞 其二","author":"释昙华","text":"法中之魔，僧中之贼。\n盗佛祖宝刀，断衲僧命脉。\n贫穷者示之无价宝珠，富贵者令之破家散宅。\n不是平地上干戈，且非孤峻处标格。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满禅人画临济像请赞","author":"释昙华","text":"临济秃，无眼目，讨便宜兮不知足。\n高悬羊头卖狗肉，秤头斤两惜如玉。\n胸中更有一般毒，天下无人敢轻触。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辞此庵和尚塔","author":"释昙华","text":"道韵如山重，冰怀有纪纲。\n一拳成活业，千古更无双。\n松竹森森老，云山叠叠长。\n洛阳无限意，对此一炉香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题刘民用居士藏六庵 其一","author":"释昙华","text":"西溪缚屋称幽居，坐对松窗与世疏。\n到眼青山千万叠，此生安乐更无如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞大慧禅师","author":"释昙华","text":"人天之师，佛祖榜样。\n顶?一著，匙挑不上。\n俾临济价增十倍，起圆悟更无伎俩。\n小侄如此赞扬，老胡决定有望。\n三十年后脱空话行，也是一番性懆起谤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞此庵元和尚二首 其一","author":"释昙华","text":"佛祖生冤家，人天不喜见。\n忒杀聱头，却通一线。\n劈胸拳下破牢关，大用机轮辘辘转。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞佛眼叔祖雪堂和尚侍立","author":"释昙华","text":"正法眼藏，瞎驴边灭。\n父行子随，了无途辙。\n老禅已是错针锥，添得应庵乱饶舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞李知府朝议","author":"释昙华","text":"人言公死，我言公在。\n在在在何处，清风动天籁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞程宗古承务","author":"释昙华","text":"庞居士悟心于马驹言下，裴相国得大用于黄檗棒头。\n虽相去数百年间，其金声玉振联环不断。\n彼时有此二大老光明烜赫，此时有宗古先生仁义礼信。\n根于心而能以此心确然履践，佛祖大解脱门诚不让耳。\n白云山月未足为齐，寒桧青松堪同大节。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠成主簿","author":"释昙华","text":"同是崇宁癸未生，公为官长我为僧。\n大家履践通天路，共踏毗卢顶上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乌巨山逵长老命立首座持师顶相请赞","author":"释昙华","text":"烟林风姿，山岳气宇。\n坐看春回，行无伴侣。\n不图成佛，岂欲作祖。\n一句掀翻，万机罔措。\n更提柱杖，击涂毒鼓。\n立禅持归，分付乌巨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古","author":"释昙华","text":"居士倒地，灵照扶起。\n乞儿伎俩，讨甚巴鼻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其二十六","author":"释昙华","text":"佛祖正印，衲僧藞苴。\n有眼如盲，有口如哑。\n更问如何，可知礼也。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其三十七","author":"释昙华","text":"元正启祚，更无回互。\n万物咸新，截铁斩钉。\n应时纳祜，跳出窠臼。\n孟春犹寒，言端语端。\n知事头首，各各希有。\n云堂大众，雍容郑重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其十八","author":"释昙华","text":"现成公案，百匝千重。\n峻如崄崖，平如镜面。\n执之失度，必入邪路。\n放之自然，体无去住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其十二","author":"释昙华","text":"虚空为鼓，须弥为槌。\n要打便打，莫问是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其三十六","author":"释昙华","text":"一呼善来，须发自落。\n积累既多，无处安著。\n普请大众，把火烧却。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂六十首 其十","author":"释昙华","text":"少室峰前，漆桶话堕。\n曹溪路上，赚杀阇梨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真请赞 其八","author":"释昙华","text":"拭眼堂前，临济正令。\n且行一半，拈佛祖病。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题仲逸宣教三境图","author":"释昙华","text":"太清之云，镜中之尘。\n从无住本，廓应如春。\n妙玄不动，示现无垠。\n三世普入，孰妄孰真。\n现成公案，岂费精神。\n当头一著，坐断要津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十首 其九","author":"释昙华","text":"丹霞寒烧木佛，院主因祸得福。\n可怜杜撰巡官，祇管胡卜乱卜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十五首 其二十三","author":"释智愚","text":"大道只在目前，要且目前难睹。\n欲识大道真体，不离声色言语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真请赞 其五","author":"释昙华","text":"鲁祖偏工面壁，秘魔动便擎杈。\n唯有归宗长老，一味撒土撒沙。\n三个上牢漆桶，不知那个堪誇。\n诸方检点得出，也是勾贼破家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅人写真请赞 其三","author":"释昙华","text":"者汉初无罪过，祇是头匾眼大。\n虽然肚里醒醒，开口便先话堕。\n如斯出世为人，恰似大虫看水磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞此庵元和尚二首 其二","author":"释昙华","text":"十分画得相似，祇有一处誵讹。\n佛祖检点不出，从教平地干戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞虎丘先师","author":"释昙华","text":"老汉从来无禅，一味心中含毒。\n此毒时复现前，浑家大小不穆。\n异口同音咒诅，至今活陷地狱。\n一名临济正宗，一名丛林瞎秃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释昙华","text":"五百力士揭石义，万仞崖头撒手行。\n十方世界一团铁，虚空背上白毛生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释昙玩","text":"我无长处名虚出，谢汝殷勤特地来。\n明因无法堪分付，谩把山门为汝开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其一","author":"释昙玩","text":"汝有一对眼，我也有一对眼。\n汝若瞒，还自瞒。\n汝若成佛作祖，老僧无汝底分。\n汝若做驴做马，老僧救汝不得。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示超然上人","author":"释昙瑩","text":"往事明明是梦中，发霜那有旧形容。\n客床对卧秋深雨，听得邻僧半夜钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南张道中","author":"释昙瑩","text":"北山松粉落轻黄，濯雨虾须麦吐芒。\n槐火石泉寒食后，十分春事属农桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"姚江","author":"释昙瑩","text":"沙尾鳞鳞水退潮，柳行出没见渔樵。\n客船自载钟声去，落日残僧立寺桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二首 其二","author":"释昙瑩","text":"百结襕衫破幞头，年年落第出神州。\n却因一只穿杨箭，临老来封马上侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二首 其一","author":"释昙瑩","text":"溪山尽处夕阳斜，溪上冬风雪满沙。\n便是江南旧行路，和烟隔水见梅华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"睡起","author":"释昙瑩","text":"蕙帐烟凝昼掩关，落花时节雨阑珊。\n客来惊起还乡梦，绕屋春风绿树寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿香积寺","author":"释昙瑩","text":"拂榻香凝夜，清眠拥衲衣。\n五更闻唤起，一路听催归。\n山雨寒仍重，溪云湿不飞。\n幽花短临水，蜂蝶冷相依。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古","author":"释昙密","text":"崔颢曾题黄鹤楼，长沙拈起当风流。\n大千国土俱家业，诸佛何曾有地头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二首 其二","author":"释昙密","text":"汲水僧归林下寺，待船人立渡头沙。\n澄江渺渺烟波窄，云静一天星斗斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古二首 其一","author":"释昙密","text":"塞北平沙阔，黄河衮底流。\n征帆才及岸，蛮狄一时收。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十首 其八","author":"释昙密","text":"菩提妙心作么发，日应万机元不差。\n回首瞥然轻觑著，大千沙界是皇家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十首 其二","author":"释昙密","text":"五祖个老翁，从来多指注。\n不是不知归，忘却来时路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"数珠","author":"释昙密","text":"百八摩尼颗颗圆，辽天鼻孔一时穿。\n恒河沙数佛菩萨，日日呼来跳一圈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古","author":"释昙密","text":"平地摝鱼虾，辽天射飞鹗。\n跛脚老云门，千错与万错。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十首 其十","author":"释昙密","text":"湖山叠乱青，湖水漾虚碧。\n断岸蓼花红，疏林秋露滴。\n良哉观世音，处处失弥勒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14317,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十首 其九","author":"释昙密","text":"咄这花木瓜，苦涩无以加。\n蓦然嚼得碎，清风生齿牙。\n种性恶，不堪誇。\n杨岐老驴三只脚，蹋人无数满天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14318,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十首 其七","author":"释昙密","text":"岂弟张夫子，遗我径寸璧。\n中有数个字，字字无人识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14319,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十首 其六","author":"释昙密","text":"一身浪宕无拘捡，闹市门头恣意游。\n汉地不收秦不管，不风流处也风流。\n健则坐，困则休，信任从教雪满头。\n寄语宣和政和元和佛陀，张僧伽李达磨，老聃孔丘，照顾沩山水牯牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14320,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十首 其五","author":"释昙密","text":"即心即佛，非心非佛。\n不是心，不是佛，不是物，半夜虚空揣出骨。\n十分描摸画难成，试问诸人是何物。\n阿呵呵，咄咄咄。\n拶倒门前大案山，搏风放出辽天鹘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14321,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十首 其四","author":"释昙密","text":"春日晴，黄莺鸣，更听断崖流水声。\n青山叠翠，款步作程，归来烟岛有谁争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十首 其三","author":"释昙密","text":"连绵雨不晴，谷子多损失。\n二麦未入泥，忧心常惕惕。\n来岁不饥荒，未敢相委悉。\n启告梵天帝释天玉皇大帝天，且放日头出。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十首 其一","author":"释昙密","text":"一二三四五，金木水火土。\n拾得语寒山，丰干骑老虎。\n报君知，莫莽卤。\n从来保福四谩人，不似禾山解打鼓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小溪","author":"释昙颖","text":"小溪庄上掩柴扉，鸡犬无声月色微。\n一只小舟临断岸，趁潮来此趁潮归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游上雪窦","author":"释昙颖","text":"下雪窦游上雪窦，过云峰后望云峰。\n如趋仙府经三岛，似入天门彻九重。\n无日不飞丹洞鹤，有时忽起隐潭龙。\n只应奉诏西归去，此境何由得再逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和昙颖师四明十题 其三 含珠林","author":"梅尧臣","text":"山为骊龙蟠，谷作骊龙腮。\n珠树存其间，谁采明月来。\n何须循海隅，笑蚌未成胎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和昙颖师四明十题 其五 云外庵","author":"梅尧臣","text":"山僧好寂静，入云恨不深。\n峰间一雨昏，林表孤灯沉。\n往来有猿狖，呼啸自成音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"释昙颖","text":"从归青嶂里，不出白云来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"释昙颖","text":"三世诸佛是奴婢，一大藏教是涕唾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其六","author":"释昙颖","text":"天地尚空秦日月，山河不见汉君臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其三","author":"释昙颖","text":"自从游紫陌，谁肯隐青山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其八","author":"释昙颖","text":"深水取鱼长信命，不曾将酒祭江神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其五","author":"释昙颖","text":"沧海尽教枯到底，青山直得碾为尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其四","author":"释昙颖","text":"家里已无回日信，路边空有望乡牌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其七","author":"释昙颖","text":"莺啭千林花满地，客游三月草侵天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释昙颖","text":"秤锤井底忽然浮，老鼠多年变作牛。\n慧空见了拍手笑，三脚猢狲差异猴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂","author":"释果慜","text":"南泉提起下刀诛，六臂修罗救得无。\n设使两堂俱道得，也应流血满街衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂","author":"释法升","text":"我诵光明经，自得三昧力。\n举起便周圆，何用高声觅。\n一日三百部，日轮犹未昃。\n见者总生疑，我自心坚实。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"绝句","author":"释法平","text":"春风吹枕小屏寒，客舍无聊梦不安。\n花叶暗时人已去，夕阳光满旧栏干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晓上人还浙东","author":"释法平","text":"鸟宿柴门静，更深别意倾。\n孤灯寒有晕，细雨夜无声。\n渡晓人争立，潮平橹乱鸣。\n君今成独往，老罢苦为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登北固楼","author":"释法平","text":"不负南徐眼，来看北固云。\n金焦两山小，吴楚一江分。\n雨气生苍壁，秋声起夕曛。\n半生流落恨，此日重殷勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释法平","text":"梦魂不入入閒世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻僧举五祖颂赵州露刀剑作偈","author":"释法全","text":"鼓吹轰轰袒半肩，龙楼香喷益州船。\n有时亦脚弄明月，踏破五湖波底天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其十九","author":"释法全","text":"几回沾水又拖泥，年老心孤不自知。\n游子不归空怅望，一溪流水落花随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古十九首 其十八","author":"释法全","text":"马转牛回岂足誇，烂泥中刺当行家。\n霜刃一挥全意气，坐令千载定龙蛇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":14346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]