[{"title":"还诸唱和雪诗次韵作二首 其二","author":"晁说之","text":"胸中块磊若为平，今日相如雪赋成。\n广野喜逢三得白，高山真遇四边明。\n瑶音顾我何能和，玉色烦君几见倾。\n形秽由来惭独目，自怜犹识佩环声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还诸唱和雪诗次韵作二首 其一","author":"晁说之","text":"萧散人间阮始平，轻盈云外董双成。\n飞英试比休争丽，连璧驩言与共明。\n黄竹异时徒思苦，幽兰同调得心倾。\n何须灞岸蹇驴夜，更学幽人老婢声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"远戎","author":"晁说之","text":"远戎深入震中原，为问何人守蓟门。\n功业论天初已缪，和亲割地竟难存。\n将军不战喜三北，逐客何堪厌七奔。\n尚有微诚思献策，千行血泪叩天阍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"閒居","author":"晁说之","text":"閒居岂无事，一动百艰难。\n水为斋僧惜，花因供佛残。\n喜闻多死士，厌话小长安。\n香火同缘客，饥肠先永叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"饮酒","author":"晁说之","text":"与君厌苦洛阳尘，望断今朝那得亲。\n为问红旗白马客，何如左蔗右螯人。\n醉来无意诛谗鬼，醒后倾身事曲神。\n辜负景钟勋业志，杜康庙里作功臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56378,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和张姑夫主簿","author":"晁说之","text":"即今时节总堪悲，寒食仍多雨意垂。\n几处垄头飘断纸，谁家碑额仆盘螭。\n江湖鱼糁聊为客，儿女来团难疗饥。\n即见胡尘都扫尽，张公诗思更温其。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56379,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和卲太子文兄八月总章朝归长句","author":"晁说之","text":"东皇受箓增嘉运，晓坐明堂夜拜章。\n玉烛千年承瑞露，金龙万国镇青霜。\n风来紫极箫声静，人在丹台佩影凉。\n与子飘零逢盛旦，独无藻思颂瑶光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56380,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和钟离秀才留别之作","author":"晁说之","text":"不脱征裘已到春，纵风横雨又经旬。\n期君独步入京国，与我相逢在水滨。\n愤世何言诗溅泪，愁心自醉酒生尘。\n胡然乘兴稽山去，为问流觞曲水人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56381,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和袁秀才见赠之作","author":"晁说之","text":"志士相逢属暮年，泪如有尽恨无边。\n空城鬼火随胡骑，满驿莼丝倚楚天。\n愁外谁知餐玉术，醉来自咏钓竿篇。\n夫君心事有如此，何日骑鲸出九渊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56382,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"依韵和高二承宣歙墨长句","author":"晁说之","text":"妙句之来墨妙同，信知吾道未全穷。\n岂容短棹千年恨，不贮长江五月风。\n眷恋孔鸾嗟叹外，磨研胶漆笑歌中。\n为予留取沧浪道，使挈儿童学钓翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56383,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和出郭","author":"晁说之","text":"万斛无多宁贮愁，不如留著寸心忧。\n怕闻天假渔阳骑，莫话春迷炀帝楼。\n出去暂能欣绿野，归来还是梦沧洲。\n何人解赏鹪鹩赋，岂但工夫在句头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56384,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和朱少章见寄","author":"晁说之","text":"兼该夫子耻专门，却笑何人哮吼村。\n闷己赋疑唯独语，恼卿诗似得同论。\n夜来雨足宽贫病，秋到凉生破睡昏。\n几欲抛书閒过日，只惭无可谢嫣荪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56385,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和圆机佳作","author":"晁说之","text":"官憎诗过好，人亦忌才多。\n君子自如此，伊人其奈何。\n单裘千日醉，短发百年歌。\n漫纳新愁泪，终惭带女萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56386,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和圆机题草虫","author":"晁说之","text":"怒剑无烦起逐蝇，从教小物此冯陵。\n礼加蛙臂何时用，书到蚕头几日能。\n半是苔边徒有感，全收芋处肯生憎。\n如椽大笔么么落，愤懑今人终拂膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56387,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和资道岩岩亭二首 其二","author":"晁说之","text":"昔年蜀武侯，泣下荡阴里。\n何如无事人，一亭欣所止。\n悠然太山岑，相对真可喜。\n不须樽中物，且酌岩下水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56388,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和资道岩岩亭二首 其一","author":"晁说之","text":"我来游此亭，岂羡高阳里。\n形神既生生，吉祥斯止止。\n我无古人愁，古人无我喜。\n颇恨桑苧翁，不来尝此水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56389,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和高二偶作长句","author":"晁说之","text":"流落归来少故人，婆娑白发强容身。\n雷霆能断王敦首，宇宙犹多庾亮尘。\n以国与盟非所志，在边不战岂其仁。\n兼资文武唯高子，谁识中原有虎臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56390,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜风雨声甚恶","author":"晁说之","text":"上元灯火胡尘里，寒食田园野草生。\n文武坠来唯不寐，精神耗后更多情。\n片云忽作几日雨，众恨添号半夜声。\n从此无烦问春色，市无过客漫荒城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56391,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜雨不少住枕上作","author":"晁说之","text":"几年飘泊敢何求，甘作伧公对楚囚。\n风转荣光新辇道，雨无时节旧扬州。\n陆公奏议同谁恨，屈子离骚亦独愁。\n岁暮长江癃病客，飘飘荆渚觅同游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56392,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奈我","author":"晁说之","text":"奈我所安何，无烦问所过。\n潮声云外散，花色醉中多。\n京国昨宵梦，边城几日歌。\n功名误男子，必使愧云萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56393,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉杨公近蒙答四六状极为精丽","author":"晁说之","text":"博物张公适圣神，经营佐国不谋身。\n一枪采撷朝林下，八骏遨游暮海滨。\n诗就秦州宁独乐，政成周道要相亲。\n败军污蔑谁哀念，敢谓勤渠问解巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56394,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"尚忧","author":"晁说之","text":"建康庾令岂多愁，未识皇恩覆九州。\n初讶单于陵大汉，重惊猃狁犯宗周。\n今朝不见安边策，前日空多定远侯。\n江海张公漂泊久，即看谠议动前旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56395,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庚子至前二日韩德全李师民相继而至聊书一时之事","author":"晁说之","text":"先后客无约，寒窗注夕阳。\n纵谈香柏子，孤兴饮松黄。\n不道仇池远，唯迎至日长。\n于焉岂易得，回首即他乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56396,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"承议郎王东起挽辞二首 其二","author":"晁说之","text":"洛下书生誉，秦川公子豪。\n飘零诸老恨，肮脏此生劳。\n病卧分丹剂，魂游问室皋。\n当时蛮纸在，絮酒共萧骚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56397,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"承议郎王东起挽辞二首 其一","author":"晁说之","text":"三十年来梦，王郎歌有情。\n桂亭看跃马，蒿里望铭旌。\n废相存亡托，孤儿内外并。\n休论书数万，色色负平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56398,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斩将","author":"晁说之","text":"斩将斩谁将，今多樊爱能。\n庶几威国俗，聊可詟边僧。\n缚虎何堪责，骑猪尚不胜。\n将军如自治，荡寇有先登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56399,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"明仲约七月晦集属抱病先以此见意犹并以申谢","author":"晁说之","text":"秋日在长安，多悲对极欢。\n栗疏肥木落，芡觜瘠池寒。\n居室清樽健，羁人白石殚。\n惭君过缱绻，扶病强盘桓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56400,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"昏昏","author":"晁说之","text":"昏昏非所志，忽忽是何时。\n客恨潮声起，春愁柳色知。\n何烦连日雨，要剧故乡思。\n自顾囊中术，黄金未可为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56401,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕上作","author":"晁说之","text":"年华又已暮，客恨更难裁。\n寒雁背潮去，钟声随雨来。\n离骚今我读，时命昔人哀。\n但喜归期近，宁论白发催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56402,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"武泰节使归金陵","author":"晁说之","text":"戟影摇寒波影稀，王孙心事与人违。\n灯边赤轴得居士，窗下清谈见布衣。\n执玉诏从天上去，挥金船向岁前归。\n尪羸不解少行乐，卧待公来起采薇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56403,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"河中府追怀亡二兄及思永兴十二弟","author":"晁说之","text":"表里山河季布州，我家兄弟忆同游。\n芸香寂寞空青冢，绛帐飘零欲白头。\n羁旅即今无好语，登临自古有高楼。\n颇闻酬唱西岩在，阙里诸孙添我愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56404,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"视蕴文","author":"晁说之","text":"飘零海角悟平生，岂料王孙肯远行。\n迟日待君游化国，凄风要我到愁城。\n诗书灰烬宁无梦，翰墨馨香尚有情。\n闻道东京已返跸，箕云缑月得秋耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56405,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵二首 其二","author":"晁说之","text":"上帝于人靡有常，江流何处任兴亡。\n干戈揖逊一锡杖，社稷山川半面妆。\n故自无人比叔子，尚怜有意保襄阳。\n白头难待太平策，万国明朝建治康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56406,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金陵二首 其一","author":"晁说之","text":"金陵形势眼中见，一吊兴亡梦寐间。\n侯景长驱走龙虎，王敦内叛压江山。\n中原有主申明命，下国何人敢肆奸。\n白首自伤归未得，此身何处得清閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56407,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"顷客解梁有诗云中条山下读周易定是前身关子明是时频与张芸叟侍郎通书亦尝寄此诗呈视今再过此郡遇芸叟之客王六东起感怀而作","author":"晁说之","text":"坂路十年尘坱身，不知何事往来频。\n敢言上国非吾土，自许中条是故人。\n志在韦编徒寡与，人亡陆海漫多珍。\n龙门有客暂相值，颇话年来亦苦辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56408,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南充大兄尝梦见予作诗见寄次韵和呈","author":"晁说之","text":"仙山能梦我，书帙正思君。\n一德谁荣滞，群儿谩戚欣。\n过秦何必论，喻蜀却须文。\n未落丰碑笔，唯贪辨惑勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56409,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"哀韩君表无文编","author":"晁说之","text":"少师名德振鹓鸾，孙子何为短羽翰。\n不使功名藏竹简，宜留文字后人看。\n六丁取去嗟韩第，七子亡来恨建安。\n赖有上公曾塔葬，多情无用涕汍澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56410,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复用前韵即事奉寄","author":"晁说之","text":"南充有狂女，何以号仙君。\n不食喧愚嗜，忘言耸世欣。\n我常饥亦健，公更默能文。\n鹤驾如相招，应须即日勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56411,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"幽斋","author":"晁说之","text":"幽斋无客自焚香，古像谁知静放光。\n秋色深来人寂寞，雁声断处月荒凉。\n病躯如似小损可，贼势流传大獗张。\n可笑韩公忧有分，人言忧责属岩廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56412,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"思归","author":"晁说之","text":"忽有故园梦，秋冬恨不胜。\n菊难月掩映，梅耐雪冯陵。\n客斗南唐墨，僧禅后夜灯。\n如何不归去，京国脚腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56413,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"总管刘观察相饯于高岩经句杨朝奉出所和诗即席再赋","author":"晁说之","text":"花开为客向金城，待得无花羸马行。\n柳荫高岩开祖帐，月摇洛水话离情。\n将军精悍千山耸，宾客风流一笛横。\n更愧新昌孙子在，诗成白眼得清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56414,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拭目","author":"晁说之","text":"拭目中兴宜碌碌，褊心触事独迟迟。\n刘琨祖逖无由见，邺下关中何所之。\n万里耕桑仁德在，九天雨露庙堂滋。\n龙钟只合归田去，犹解重吟采芑诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56415,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故资政殿学士特赠光禄大夫曾公挽辞二首 其二","author":"晁说之","text":"马援枕前叹，张飞帐下怨。\n古人有馀泪，今日不堪言。\n犬豕方逃格，玙璠忽自焚。\n共嗟当宁恨，宁复问乾坤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56416,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故资政殿学士特赠光禄大夫曾公挽辞二首 其一","author":"晁说之","text":"选吏时无最，论兵世有书。\n风神相门旧，胆气将坛初。\n地轴尘埃转，天航津汉虚。\n忠规子孙在，太史笔何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56417,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春光","author":"晁说之","text":"春光能负我，为客更添愁。\n梅蕊一何晚，莺声便欲休。\n新庖惊异味，旧侣梦同游。\n道术知何用，江山空白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56418,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春色","author":"晁说之","text":"春色真无赖，羁人自慨慷。\n莺能嘲客语，花解笑人忙。\n腰衱休含睇，栏干枉断肠。\n明当元几日，何处有流觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56419,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春初","author":"晁说之","text":"春初未有象，幽兴一何深。\n细雨能输酒，轻风不隔琴。\n无烦问北信，且强学南音。\n白发宁欺客，愁来处处侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56420,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春晚感怀","author":"晁说之","text":"春来谁挽去难援，中有悲驩万古痕。\n飞絮无家凌紫极，落英不聘恨黄昏。\n半涂未肯击鸣缶，百感何因招些魂。\n海内一经连海外，欲搜怪物且重翻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56421,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"洪泽守闸和二十二弟韵","author":"晁说之","text":"小舟洪泽叹嗟馀，欲说人间孰得如。\n蝙蝠倒悬徒颉顽，猕猴徐步漫趑趄。\n岁穷云际行求雁，日暮溪头坐羡鱼。\n何处长风万里浪，龙盘鳌抃蜃楼居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56422,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"癸未岁余与开封解安行同知定州外县赴二帅上元之集今辛卯明州灯夕公会上见邸报解以大夫知嘉州感旧作寄","author":"晁说之","text":"伊昔中山胜事赊，初当三五便开花。\n君能选色沉醉倒，我自伤心深感嗟。\n聚散十年逢节序，穷通百态各天涯。\n使君绮席谁同乐，莫遣灯花照鬓华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56423,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋","author":"晁说之","text":"长年何事不悲秋，今日天涯愁复愁。\n故国老槐空寂寂，半天归雁自悠悠。\n故知庾信多清泪，何事陶潜亦白头。\n前日家人带楸叶，求身强健更何求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56424,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋叹","author":"晁说之","text":"为起秋风有所怀，江头秋色信多哉。\n孔明何岁荆州去，乐毅即时燕国来。\n今古悠悠共涕泪，江山寂寂尽尘埃。\n麒麟阁上功名士，闻道其中有不才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56425,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋阴","author":"晁说之","text":"漠漠秋阴好，遥空见故乡。\n可堪高叶病，无赖晚花香。\n枕静泉声细，帘疏风影长。\n肯教容易雨，吟兴动何郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56426,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋来","author":"晁说之","text":"秋来颇自适，抚此清收时。\n不假绝交论，聊吟招隐诗。\n山阿新橡栗，朝廷旧皋夔。\n早晚罢给散，恩偕雨露垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56427,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋感","author":"晁说之","text":"又作此秋飘泊客，茫茫谁是北归人。\n庭前雨过鹅群浴，池上风来萤火新。\n战马不肥淮甸草，属车思辗洛阳尘。\n如闻胡虏渡河去，缑月箕云待老身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56428,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"胡季和送江梅山茶来","author":"晁说之","text":"山茶有色笑江梅，无色江梅谢不才。\n莫言无色无才思，几许才从色上来。\n天际素娥能绰约，人间红袖恨徘徊。\n谁将玉质酡颜醉，绛雪朱丝解不开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56429,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"说之复兼二公而作圆机既同邪籍之契显夫又与仆元丰五年登科事相类时曾子固坐失考罚铜三十斤后为先人语之甚详","author":"晁说之","text":"波臣好荡箕风急，浮世谁为自必人。\n顾我高飞摧短翮，念君阔步踬长绅。\n一枝青桂憎兄好，三府丹书重友因。\n近接语言遥梦寐，共将白发傲芳春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56430,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"追感","author":"晁说之","text":"颍水箕山已卜休，忽逢新政误恩收。\n白头不识为郎叹，黄帽难供作客愁。\n何事京师书信断，漫从泽国稻粱谋。\n和亲莫恃河为界，百骑东来破一州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56431,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送邢子强还洛","author":"晁说之","text":"行乐洛城为第一，暂劳使节持还家。\n桥头铺遍中秋月，楼上吹残九日花。\n谁听高谈擒虎豹，且容浊酒傲烟霞。\n从君一笑知无分，短发长途倍叹嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56432,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送李先之归南","author":"晁说之","text":"夫子声名大，凄凉三十年。\n晚交弥好易，夙志自覃玄。\n泰华冰霜洁，江湖鸿雁边。\n别期不相假，吾道信茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56433,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送韩七十赴澶渊旧任所为士掾","author":"晁说之","text":"不乐予何甚，非关未策勋。\n秋灯逢积雨，客泪送离群。\n身事千年鹤，心期万里云。\n烦君经废庙，呜咽当家文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56434,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送蒲君赴陜西漕属","author":"晁说之","text":"殽函为客乐，巴蜀故乡荣。\n风雪担书梦，旌旂从使行。\n黩兵烽燧息，积粟犬羊平。\n同谷曾谈话，知君笔阵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56435,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"选部中作","author":"晁说之","text":"白发来游宦，山公不我闻。\n邪犹在中等，政不占微分。\n孤泪沧溟感，微言上帝勋。\n何妨贫且贱，嵩岭有高云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56436,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重蒙三十六丈大夫德充中大赋九日诗期字韵诗辄复以致谢遂及阁笔之域","author":"晁说之","text":"平阳楼上重阳日，周览悲欢孰与期。\n盛德不应无隐者，大豪宁复有屠儿。\n未舒鸑鷟青天翼，难识珊瑚碧海枝。\n莫拟吹花多继笔，羸兵易衄橐仍垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56437,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闻三十六丈乞西京留台辄成长句时先之七兄已拜北京留台","author":"晁说之","text":"门地何人论甲乙，碧梧丹凤重徘徊。\n前时五相继三相，此日西台望北台。\n器业云霄能我有，功名钟鼎待时来。\n重言四海宫师德，季子白头谁识哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":56438,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]