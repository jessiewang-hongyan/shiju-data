[{"title":"偈二十二首 其十七","author":"释洵","text":"头颅百皱发又白，两手扶犁更出来。\n拈起旧时毡拍板，大家看我舞三台。\n啰啰哩，啰啰哩。\n无处有月波澄，有处无风浪起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其十六","author":"释洵","text":"三年来在此山中，上下人情贵一同。\n今日溪头休惜别，德云祇在妙高峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其十五","author":"释洵","text":"春风吹裂峰头石，晏下东峰绝踪迹。\n日轮正午现全身，生铁蒺藜当面掷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其十三","author":"释洵","text":"榕溪脉脉，鹿岭巉巉。\n龙象蹴踏，前三后三。\n二人一见便归去，何待山堂更指南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其十二","author":"释洵","text":"不是玄妙奇特，亦非圣解凡情。\n茂林芳草摧残尽，坐看春风吹又青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16387,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其十一","author":"释洵","text":"岁月去人如箭急，一年祇有十五日。\n雪砌禅人总不知，但见钵盂两度湿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16388,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其九","author":"释洵","text":"针劄不到处，放下死蛇头。\n唱拍相应时，权尘俱脱尽。\n明眼汉，没窼臼。\n百尺竿头放步行，大洋海里和身倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16389,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其八","author":"释洵","text":"天下无二道，圣贤无两心。\n世尊不说说，迦叶不闻闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16390,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其七","author":"释洵","text":"是非海里横身入，豺虎群中放步行。\n自是渠侬无影迹，从教天下竞头争。\n常在动用中，动用收不得。\n常在万象中，出万象一头。\n你若簸土扬尘，我则空澄海湛。\n你若单提独弄，我则竖四横三。\n不是渠侬多意气，他家曾踏上头关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16391,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其五","author":"释洵","text":"拽回天关，踏翻地轴。\n拄杖化为龙，一雨沛然足。\n在坑满坑，在谷盈谷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16392,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其四","author":"释洵","text":"有佛处，不得住，藕丝孔里行官路。\n无佛处，急走过，十字街头相对坐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16393,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其二","author":"释洵","text":"朔风扫地卷黄叶，门外千峰凛寒色。\n夜半乌龟带雪飞，石女溪头皱用眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16394,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其一","author":"释洵","text":"穷谷无人作上元，一灯历劫镇长存。\n诸人尽在光明里，看时不见暗昏昏。\n灯笼与露柱相交，佛殿与三门斗额。\n留雪嶂横趍下海，九叠峰?跳上天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16395,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二十二首 其十","author":"释洵","text":"掩室摩竭，正令已行。\n杜口毗耶，全机脱略。\n更来开口，犹欠三拳。\n拟欲吞声，不消一钁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16396,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其三十一","author":"释玿","text":"唇上必并班豹剥，舌头当的帝都丁。\n自古上贤犹不识，造次凡流岂可明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16397,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十","author":"释玿","text":"塞北千人帐，江南万斛船。\n菩提窝里坐，总谓是虚传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16398,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十七","author":"释玿","text":"劫火光中共唱酬，随波逐浪谩悠悠。\n剖尽衷肠人不会，草鞋拈取盖龟休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16399,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十","author":"释玿","text":"此儿活计口皮边，点著风驰与电旋。\n谩说镇州萝卜大，何曾亲见老南泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16400,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其六","author":"释玿","text":"大雄山下老狐精，千古丛林恼杀人。\n若遇金毛师子子，看伊无处著浑身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16401,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其五","author":"释玿","text":"喝声绝处怒雷收，丧尽家风一不留。\n总是战争收拾得，却因歌舞破除休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16402,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其三","author":"释玿","text":"身世悠悠不系舟，得随流处且随流。\n今朝有酒今朝醉，明日无钱明日愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16403,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二","author":"释玿","text":"相逢打鼓弄琵琶，须是还他两会家。\n曲罢不知何处去，夕阳斜映暮天霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16404,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其一","author":"释玿","text":"文死罔明休卜度，瞿昙女子谩针锥。\n推倒铁山归去也，纵横十字更由谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16405,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九首 其九","author":"释玿","text":"一拳拳到黄鹤楼，一踢踢翻鹦鹉洲。\n玉麟掣断黄金锁，大丈夫儿得自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16406,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其三十","author":"释玿","text":"佛手驴脚生缘，生缘驴脚佛手。\n李公醉倒街头，元是张公吃酒。\n黄龙山里老婆禅，恰似河阳新妇丑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16407,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十六","author":"释玿","text":"一人牙如剑树，一人口似血盆。\n一拳还一踢，一踢报一拳。\n亚竖摩醯顶门眼，不妨亲踏上头关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16408,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十五","author":"释玿","text":"有主有宾，有礼有乐。\n得失是非，如何摸索。\n才摸索，无上醍醐成毒药。\n君不见大鹏展翼盖十洲，投窗之物空啾啾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16409,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十四","author":"释玿","text":"苦中乐，乐中苦，大唐打鼓新罗舞。\n寒山烧火满头灰，却笑丰干倒骑虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16410,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十三","author":"释玿","text":"北禅夜分岁，特地巧安排。\n维那出只手，线去又丝来。\n田郎催拍板，鲍老舞三台。\n若教行正令，活作一坑埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16411,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十二","author":"释玿","text":"隔，穿耳胡僧眼睛黑。\n东院西边是赵州，观音院里安弥勒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16412,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十一","author":"释玿","text":"曹山不如，花根本艳。\n不如曹山，虎体元班。\n江南地暖，塞北春寒。\n一把柳丝收不得，和烟搭在玉阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16413,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十九","author":"释玿","text":"有是父兮有是子，同条生也同条死。\n三世如来烈焰堆，互换说法元如此。\n莫颠言，休倒语，截断葛藤须荐取。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16414,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十八","author":"释玿","text":"投子投子，机轮无阻。\n要吞即吞，要吐即吐。\n若还殢齿粘牙，争得超今迈古。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16415,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十六","author":"释玿","text":"明日大悲院里斋，铁围山岳尽冲开。\n猪头象鼻，乌觜鱼腮。\n石人抚掌呵呵笑，寒山拾得在天台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16416,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十五","author":"释玿","text":"拶到悬崖撒手时，七斤衫重有谁知。\n寒来暑往浑无用，挂在赵州东院西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16417,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十三","author":"释玿","text":"无直路，却萦纡。\n赵州东壁上，依旧挂葫芦。\n有张公吃村酒。\n李公醉不醒，面南看北斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16418,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十二","author":"释玿","text":"庭前柏树子，一二三四五。\n窦八布衫穿，禾山解打鼓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16419,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十一","author":"释玿","text":"当机转处不踌躇，琉璃盘里走明珠。\n赵州老子村校书，一条拄杖两人舁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16420,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其九","author":"释玿","text":"前得得，后不得，一贯谁知两五百。\n雨桧萧萧，风松瑟瑟。\n隔山人听鹧鸪词，错认胡笳十八拍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16421,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其八","author":"释玿","text":"家财丧尽没丝毫，祇个一身犹恨多。\n却向池阳最深处，杀人空手不持刀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16422,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其七","author":"释玿","text":"是贼识贼精识精，南泉无过强惺惺。\n赵州礼拜归堂去，前箭犹轻后箭深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16423,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其四","author":"释玿","text":"梦中要渡深溪水，伎俩多般进不能。\n蓦地觉来伎俩尽，床头山月已三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16424,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九首 其八","author":"释玿","text":"休卜度，世间那有扬州鹤。\n一身与世等委蛇，万事随缘即安乐。\n无意来时却宛然，有心用处还应错。\n错错错，莫莫莫，近日秋林多叶落。\n铁牛飞过洞庭湖，西山走入滕王阁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16425,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九首 其六","author":"释玿","text":"垦土诛茆作佛宫，栽田博饭与君同。\n梦中十载因缘尽，又拄乌藤过别峰。\n临岐一句如何说，此去平分江上月。\n千里同风事宛然，云山虽别何曾别。\n别不别，鹭鸶飞入寒江雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16426,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九首 其五","author":"释玿","text":"向来云岫访雷峰，朔风吹雪落长松。\n今日雷峰访云岫，无限春光满岩窦。\n机锋互换主宾分，八两元来重半斤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16427,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九首 其四","author":"释玿","text":"语是谤，寂是诳。\n不语不寂，转增虚妄。\n春风吹落桃李花，淡烟疏雨笼青嶂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16428,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九首 其三","author":"释玿","text":"云山偶尔遭攧，臂痛不可胜言。\n府教挥金办供，殷勤咨请谈禅。\n禅禅，不在拈槌竖拂，亦非作用周旋。\n不在扬眉瞬目，亦非文字语言。\n祇据现成公案，自然七方八圆。\n在云门得之，则曰一句三句。\n在法眼得之，则曰惟心法门。\n在沩仰得之，则曰父慈子孝。\n在临济得之，则曰三要三玄。\n在曹洞得之，则有偏正回互。\n在天下老和尚得之，则有问答机缘。\n在云山得之，则全提正令于人天之上。\n在府教学士得之，则致吾君于尧舜之前。\n在现前大众得之，则随宜应用。\n在太孺人黄氏得之，则生于忉利诸天。\n禅禅，绵绵密密，密密绵绵。\n渡水胡僧无膝裤，东村王老屋头穿。\n拈来一一中的，不妨似箭离弦。\n脱或踌躇拟议，迢迢十万八千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16429,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九首 其二","author":"释玿","text":"五五二十五，乖龙不为雨。\n沙石欲生烟，稻麻将槁死。\n山僧有个七字顶轮王陀罗尼，能破龙宫。\n开蛰户，斥雷师，驱电母，布慈云而洒甘露。\n唵苏噜悉哩苏噜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16430,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂九首 其一","author":"释玿","text":"鹊既鸣鹊鹊，鸦则鸣鸦鸦。\n禾山四打鼓，赵州三吃茶。\n春来花处处，云散月家家。\n达磨当年无板齿，祇应特地过流沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16431,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十九","author":"释玿","text":"人人尽有生缘，且非夷狄中原。\n镇府出大萝卜，赵州亲见南泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16432,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十八","author":"释玿","text":"我脚何似驴脚，拟议知君大错。\n进前欲饮醍醐，已似遭他毒药。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16433,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其二十七","author":"释玿","text":"我手何似佛手，堪笑紫湖养狗。\n撞著焦尾大虫，性命输他一口。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16434,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三十一首 其十四","author":"释玿","text":"利刀截断命根，跳出狐群狗队。\n拈起万煅蒺藜，铁额铜头粉碎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16435,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庚辰九日陈世崇来访说偈","author":"释珍南州","text":"从上行不到处行，取步步登高。\n从上说不到处说，取言言见谛。\n白酒酿千家，黄花开满地。\n噫嘻，陶渊明若知有今此世界，终不执着东篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16436,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"辞众偈","author":"释省回","text":"九十二光阴，分明对众说。\n远洞散寒云，幽窗度残月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16437,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释省回","text":"南番人泛船，塞北人摇舻。\n波斯入大唐，须弥山作舞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16438,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其二","author":"释省念","text":"万里神光都一照，谁人敢并日轮齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16439,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句 其一","author":"释省念","text":"一言截断千江口，万仞峰前始得玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16440,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释省念","text":"今年六十七，老病随缘且遣日。\n今年记却来年事，来年记著今朝日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16441,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释省念","text":"白银世界金色身，情与非情共一真。\n明暗尽时俱不照，日轮午后示全身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16442,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示执坐禅者","author":"释省澄","text":"大道分明绝点尘，何须枯坐始相亲。\n杖藜日涉溪山趣，便是烟霞物外人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16443,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"香严贫","author":"释祖元","text":"无地无锥未是贫，知无尚有守无身。\n侬家近日贫来甚，不见当初贫底人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16444,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈一首","author":"释祖元","text":"小庵小舍小丛林，土地何须八九人。\n若解轮番来打供，免教碎作一堆尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16445,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其三","author":"释祖元","text":"雁山枯木实头禅，不在尖新语句边。\n背手忽然摸得著，长鲸吞月浪滔天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16446,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其二","author":"释祖元","text":"有佛处不得住，踏著秤锤硬似铁。\n无佛处急走过，脚下草深三尺。\n三千里外，逢人不得错举。\n北斗挂须弥，棒头挑日月。\n摘杨花，摘杨花，眼里瞳人著绣鞋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16447,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈三首 其一","author":"释祖元","text":"剔起灯来是火，历劫无明照破。\n归堂撞见圣僧，几乎当面蹉过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16448,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈","author":"释祖印","text":"昔日南泉亲斩却，今朝耶舍示玄徒。\n而今卖与诸禅客，文契分明要也无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16449,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示南华行者","author":"释祖先","text":"黄梅会里七千指，虎骤龙驰空点胸。\n碓蹯老卢愚且拙，坤维占断最高峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16450,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自诒","author":"释祖先","text":"宴坐白云里，经行碧嶂中。\n游人穷不到，幽鸟自匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16451,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"定光赞","author":"释祖先","text":"天涯海角俱行遍，鬼面神头只自谩。\n却忆当年旧风月，杖头挑出与人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16452,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送虎丘首座住庵","author":"释祖先","text":"剑池拾得丰城剑，凛凛寒光射斗牛。\n为报不平平底事，草庵蓬户也风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16453,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三首 其二","author":"释祖先","text":"师姑元是女人作，百衲禅僧多罔措。\n雁回沙塞口衔芦，燕绕红梁浑不顾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16454,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古三首 其一","author":"释祖先","text":"应无所住以生心，大地山河一发沉。\n从此别开穷世界，新州柴把贵如金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16455,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十二首 其一","author":"释祖先","text":"扶持临济正法眼，出手还它勇毅人。\n利物应机全体用，丛林又见一番新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":16456,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]