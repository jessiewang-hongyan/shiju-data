[{"title":"晓枕三首 其三","author":"范成大","text":"舒惨常随天气，关心窗暗窗明。\n日晏扶头未起，唤人先问阴晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33497,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓枕三首 其一","author":"范成大","text":"煮汤听成万籁，添被知是五更。\n陆续满城钟动，须臾后巷鸡鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33498,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓起","author":"范成大","text":"帘额绣波荡漾，烛盘红泪阑干。\n梦里五更风急，愁边一半春残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33499,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"积雨作寒五首 其二","author":"范成大","text":"已报舟浮登岸，更怜桥塌平池。\n养成蛙吹无谓，扫尽蚊雷却奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33500,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"积雨作寒五首 其一","author":"范成大","text":"压屋雨云昼暗，环城霖潦夏寒。\n西池半没荷柄，南荡平沉芡盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33501,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"积雨作寒五首 其五","author":"范成大","text":"山寒禅老不下，泥滑琴僧罕来。\n且唤园丁閒语，喜闻湖岸未颓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33502,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"积雨作寒五首 其四","author":"范成大","text":"婢喜蚊僵雾帐，儿嗔蜗篆风棂。\n兀坐鼻端正白，忘怀眼底常青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33503,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"积雨作寒五首 其三","author":"范成大","text":"熨帖重寻毳衲，补苴尽护纸窗。\n馀生雪鬓禅榻，昨梦云帆涨江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33504,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿牧马山胜果寺","author":"范成大","text":"佛灯已暗还吐，旅枕才安却惊。\n月色看成晓色，溪声听作松声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33505,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题林景思雪巢六言三首 其三","author":"范成大","text":"万境人踪尽绝，百围天籁都沉。\n惟馀冷淡生活，时复撚髭冻吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33506,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题林景思雪巢六言三首 其二","author":"范成大","text":"何处温泉火井，谁家熊席狐裘。\n堂燕几番炎热，冰蚕一茧绸缪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33507,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题林景思雪巢六言三首 其一","author":"范成大","text":"大地九冰彻底，小巢四壁俱空。\n只有梅花同调，雪中无限春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33508,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄题筠州钱有文明府新昌小道院 其一","author":"范成大","text":"忠厚平生心学，敏明随处民功。\n江左幕中荒政，江西县里仁风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33509,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园丁折花七品各赋一绝 其五 崇宁红","author":"范成大","text":"匀染十分艳绝，当年欲占春风。\n晓起妆光沁粉，晚来醉面潮红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33510,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后六言二首 其一","author":"范成大","text":"雨声和深巷屐，风力到短檠灯。\n可惜滴残檐雪，从教漂尽河冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33511,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后六言二首 其二","author":"范成大","text":"岁寒破屋万卷，风急疏窗一灯。\n高卧眼生醉缬，远游须有坚冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33512,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪复大作六言四首 其四","author":"范成大","text":"伶俜冻雀蹲晚，噤渗疏梅锁春。\n有客典衣沽酒，何人增价卖薪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33513,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪复大作六言四首 其一","author":"范成大","text":"奇寒拥被晓枕，噩梦披蓑晚江。\n遥想漫天匝地，近听穿幔鸣窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33514,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪复大作六言四首 其二","author":"范成大","text":"酿成送腊三白，功在迎年九秋。\n樵指担肩相贺，饭囊酒瓮何忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33515,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪复大作六言四首 其三","author":"范成大","text":"初报折篁抢地，旋闻压柳堆桥。\n宁教风过掀舞，可惜雨来半销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33516,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜晴二首 其二","author":"范成大","text":"窗间梅熟落蒂，墙下笋成出林。\n连雨不知春去，一晴方觉夏深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33517,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜晴二首 其一","author":"范成大","text":"驱帚水争沟口，卷帘日款屋山。\n饥燕痴儿叫怒，拙鸠去妇复还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33518,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园丁折花七品各赋一绝 其七 紫中贵","author":"范成大","text":"沉沉色与露滴，泥泥香随日烘。\n满眼艳妆红袖，紫绡终是仙风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33519,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"园丁折花七品各赋一绝 其四 叠罗红","author":"范成大","text":"襞积剪裁千叠，深藏爱惜孤芳。\n若要韶华展尽，东风细细商量。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33520,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题如梦堂壁","author":"范成大","text":"勃姑午啼唤雨，鹎鵊晓啭留春。\n片云不载归梦，两鬓全供客尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33521,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题画卷五首 其五","author":"范成大","text":"秋晚黄芦断岸，江南野水连天。\n日色微明鱼网，雁行飞入苍烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33522,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题请息斋六言十首 其六","author":"范成大","text":"税驾今吾将老，结庐此地不喧。\n恐妨蝴蝶同梦，笑倩颠当守门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33523,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题请息斋六言十首 其二","author":"范成大","text":"多谢纷纷云雨，相忘渺渺江湖。\n坐隅但忌占鵩，屋上何烦誉乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33524,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题请息斋六言十首 其四","author":"范成大","text":"见影蜮犹铋铋，闻声厖尚狺狺。\n问谁毛生名纸，知我角出车轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33525,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题请息斋六言十首 其十","author":"范成大","text":"园丁以时白事，山客终日相陪。\n竹比平安报到，花依次第折来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33526,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题请息斋六言十首 其九","author":"范成大","text":"亲戚自有情话，来往都无杂言。\n酒熟径须相报，文成聊与细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33527,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题请息斋六言十首 其八","author":"范成大","text":"冷煖旧雨今雨，是非一波万波。\n壁下禅枯达磨，室中病著维摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33528,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题请息斋六言十首 其一","author":"范成大","text":"洞门昼挂铁锁，阁道秋生绿苔。\n蓍下略同龟伏，瓜中且免蝇来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33529,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题请息斋六言十首 其七","author":"范成大","text":"口边一任醭去，鼻孔慵将涕收。\n閒门冷落车辙，空室团栾话头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33530,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题请息斋六言十首 其五","author":"范成大","text":"不惜人扶难拜，非关我醉欲眠。\n劳君敬枯木耳，恐汝见湿灰焉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33531,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题请息斋六言十首 其三","author":"范成大","text":"滟滪年年似马，太行日日摧车。\n笑中恐有义甫，泣里难防叔鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33532,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题黄居寀雀竹图二首 其二","author":"范成大","text":"蔓花露下凝碧，丛竹秋来老苍。\n噪雀群争何事，么禽自啭清篁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33533,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题黄居寀雀竹图二首 其一","author":"范成大","text":"群雀岁寒保聚，两鹑日晏忘归。\n草间岂无馀粒，刮地风号雪飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33534,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子 其一","author":"范成大","text":"凉夜竹堂虚，小睡匆匆醒。\n银漏无声月上阶，满地阑干影。\n何处最知秋，风在梧桐井。\n不惜骖鸾弄玉箫，露湿衣裳冷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33535,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子 其二","author":"范成大","text":"云压小桥深，月到重门静。\n冷蕊疏枝半不禁，更著横窗影。\n回首故园春，往事难重省。\n半夜清香入梦来，从此熏炉冷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33536,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三登乐 其四","author":"范成大","text":"方帽冲寒，重检校、旧时农圃。\n荒三径、不知何许。\n但姑苏台下，有苍然平楚。\n人笑此翁，又来访古。\n况五湖、元自有，扁舟祖武。\n记沧洲、白鸥伴侣。\n叹年来、孤负了，一蓑烟雨。\n寂寞暮潮，唤回棹去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33537,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三登乐 其一","author":"范成大","text":"一碧鳞鳞，横万里、天垂吴楚。\n四无人、橹声自语。\n向浮云、西下处，水村烟树。\n何处系船，暮涛涨浦。\n正江南、摇落后，好山无数。\n尽乘流、兴来便去。\n对青灯、独自叹，一生羁旅。\n敧枕梦寒，又还夜雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三登乐 其三","author":"范成大","text":"今夕何朝，披岫幌、云关重启。\n引冰壶、素空似洗。\n卷帘中、敧枕上，月星浮水。\n天镜夜明，半窗万里。\n盼庭柯、都老大，树犹如此。\n六年前、转头未几。\n唤邻翁、来话旧，同篘新蚁。\n秉烛夜阑，又疑梦里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三登乐 其二","author":"范成大","text":"路转横塘，风卷地、水肥帆饱。\n眼双明、旷怀浩渺。\n问菟裘、无恙否，天教重到。\n木落雾收，故山更好。\n过溪门、休荡桨，恐惊鱼鸟。\n算年来、识翁者少。\n喜山林、踪迹在，何曾如扫。\n归鬓任霜，醉红未老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"千秋岁 重到桃花坞","author":"范成大","text":"北城南埭。\n玉水方流汇。\n青樾里，红尘外。\n万桃春不老，双竹寒相对。\n回首处，满城明月曾同载。\n分散西园盖。\n消减东阳带。\n人事改，花源在。\n神仙虽可学，功行无过醉。\n新酒好，就船况有鱼堪买。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"忆秦娥 其四","author":"范成大","text":"楼阴缺，栏杆影卧东厢月。\n东厢月，一天风露，杏花如雪。\n隔烟催漏金虬咽，罗帏暗淡灯花结。\n灯花结，片时春梦，江南天阔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"木兰花慢 其三 送郑伯昌","author":"范成大","text":"古人吾不见，君莫是、郑当时。\n更筑就山房，躬耕谷口，名动京师。\n诸公任他衮衮，与杜陵野老共襟期。\n有客至门先喜，得钱沽酒何疑。\n昔年连辔柳边归。\n陈迹恍难追。\n况种桃道士，看花才子，回首皆非。\n相逢故人问讯，道刘郎去久无诗。\n把作一场春梦，觉来莫要寻思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水龙吟 寿留守","author":"范成大","text":"仙翁家在丛霄，五云八景来尘表。\n黄扉紫闼，化钧高妙，风霆挥扫。\n漠北寒烟，峤南和气，笑谈都了。\n自玉麟归去，金牛再款，却回首、人间少。\n天与丹台旧籍，笑苍生、祝公难老。\n春葩秋叶，暄寒易变，壶天长好。\n物外新闻，凤歌鸾翥，龙蟠虎绕。\n想如心高会，寒霜夜永，尽横参晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其二 燕山九日作","author":"范成大","text":"万里汉家使，双节照清秋。\n旧京行遍，中夜呼禹济黄流。\n寥落桑榆西北，无限太行紫翠，相伴过芦沟。\n岁晚客多病，风露冷貂裘。\n对重九，须烂醉，莫牢愁。\n黄花为我，一笑不管鬓霜羞。\n袖里天书咫尺，眼底关河百二，歌罢此生浮。\n惟有平安信，随雁到南州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 人日","author":"范成大","text":"元日至人日，未有不阴时。\n新年叶气，无处人物不熙熙。\n万岁声从天下，一札恩随春到，光采动天鸡。\n寿域遍寰海，直过雪山西。\n忆曾预，宣玉册，捧金卮。\n如今万里，魂梦空绕五云飞。\n想见大庭宫馆，重起三山楼观，双指赭黄衣。\n此会古无有，何止古来稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头 其一","author":"范成大","text":"细数十年事，十处过中秋。\n今年新梦，忽到黄鹤旧山头。\n老子个中不浅，此会天教重见，今古一南楼。\n星汉淡无色，玉镜独空浮。\n敛秦烟，收楚雾，熨江流。\n关河离合，南北依旧照清愁。\n想见姮娥冷眼，应笑归来霜鬓，空敝黑貂裘。\n酾酒问蟾兔，肯去伴沧洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"水调歌头","author":"范成大","text":"万里筹边处，形胜压坤维。\n恍然旧观重见，鸳瓦拂参旗。\n夜夜东山衔月，日日西山横雪，白羽弄空晖。\n人语半霄碧，惊倒路傍儿。\n分弓了，看剑罢，倚阑时。\n苍茫平楚无际，千古锁烟霏。\n野旷岷嶓江动，天阔崤函云拥，太白暝中低。\n老矣汉都护，却望玉关归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春","author":"范成大","text":"佳人无对甘幽独。\n竹雨松风相澡浴。\n山深翠袖自生寒，夜久玉肌元不粟。\n却寻千树烟江曲。\n道骨仙风终绝俗。\n绛裙缟袂各朝元，只有散仙名萼绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"玉楼春 牡丹","author":"范成大","text":"云横水绕芳尘陌。\n一万重花春拍拍。\n蓝桥仙路不崎岖，醉舞狂歌容倦客。\n真香解语人倾国。\n知是紫云谁敢觅。\n满蹊桃李不能言，分付仙家君莫惜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其一","author":"范成大","text":"云幕暗千山，肠断玉楼金阙。\n应是高唐小妇，妒姮娥清绝。\n夜凉不放酒杯寒，醉眼渐生缬。\n何待桂华相照，有人人如月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"好事近 其二","author":"范成大","text":"昨夜报春来，的皪岭梅开雪。\n携手玉人同赏，比看谁奇绝。\n阑干倚遍忆多情，怕角声呜咽。\n与折一枝斜戴，衬鬓云梳月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"如梦令 其二","author":"范成大","text":"两两莺啼何许。\n寻遍绿阴浓处。\n天气润罗衣，病起却忺微暑。\n休雨。\n休雨。\n明日榴花端午。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"如梦令 其一","author":"范成大","text":"罨画屏中客住。\n水色山光无数。\n斜日满江声，何处撑来小渡。\n休去。\n休去。\n惊散一洲鸥鹭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月","author":"范成大","text":"樱笋园林绿暗，槐榆院落清和，年年高会引笙歌，戏彩人随燕贺。\n一笑难逢身健，十分休惜颜酡。\n还将瓜枣送金荷，遍照金章满座。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其一","author":"范成大","text":"十月谁云春小，一年两见风娇。\n云英此夕度蓝桥。\n人意花枝都好。\n百媚朝天淡粉，六铢步月生绡。\n人间霜叶满庭皋，别有东风不老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月 其二","author":"范成大","text":"北客开眉乐岁，东君著意华年。\n遮风藏雨晚云天。\n应怕杏梢红浅。\n不惜灯前放夜，从教雪后留寒。\n水晶帘箔万花钿。\n听彻南楼晓箭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步虚声 白玉楼六首 其四","author":"范成大","text":"流铃响，龙驭籋云来。\n夹道骞华笼綵仗，红云扶辂辗天街，迎驾鹤毰毸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步虚声 白玉楼六首 其三","author":"范成大","text":"罡风起，背负玉虚廷。\n九素烟中寒一色，扶阑四面是青冥，环拱万珠星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步虚声 白玉楼六首 其二","author":"范成大","text":"浮黎路，依约太微间。\n雪色宝阶千万丈，人间遥作白虹看，幢节度高寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步虚声 白玉楼六首 其一","author":"范成大","text":"珠霄境，却似化人宫。\n梵气弥罗融万象，玉楼十二倚清空，一片宝光中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步虚声 白玉楼六首 其五","author":"范成大","text":"钧天奏，流韵满空明。\n琪树玲珑珠网碎，仙风吹作步虚声，相和八鸾鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步虚声 白玉楼六首 其六","author":"范成大","text":"楼阑外，辇道插非烟。\n閒上郁萧台上看，空歌来自始青天，扬袂揖飞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宜男草 其一","author":"范成大","text":"篱菊滩芦被霜后。\n袅长风、万重高柳。\n天为谁、展尽湖光渺渺，应为我、扁舟入手。\n橘中曾醉洞庭酒。\n辗云涛、挂帆南斗。\n追旧游、不减商山杳杳，犹有人、能相记否。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宜男草 其二","author":"范成大","text":"舍北烟霏舍南浪。\n雪倾篱、雨荒薇涨。\n问小桥、别后谁过，惟有迷鸟羁雌来往。\n重寻山水问无恙。\n扫柴荆、土花尘网。\n留小桃、先试光风，从此芝草琅玕日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"念奴娇 其四","author":"范成大","text":"水乡霜落，望西山一寸，修眉横碧。\n南浦潮生帆影去，日落天青江白。\n万里浮云，被风吹散，又被风吹积。\n尊前歌罢，满空凝淡寒色。\n人世会少离多，都来名利，似蝇头蝉翼。\n赢得长亭车马路，千古羁愁如织。\n我辈情钟，匆匆相见，一笑真难得。\n明年谁健，梦魂飘荡南北。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":33566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]