[{"title":"亭前柳 其一","author":"朱雍","text":"拜月南楼上，面婵娟、恰对新妆。\n谁凭阑干处，笛声长。\n追往事，遍凄凉。\n看素质、临风消瘦尽，粉痕轻、依旧真香。\n潇洒春尘境，过横塘。\n度清影，在回廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"亭前柳 其三","author":"朱雍","text":"养就玄霜圃，问东君、曾放瑶英。\n回首蓝桥路，遍琼城。\n横斜影，照人明。\n飘香信、玉溪仙佩晚，同新月、步入西清。\n冰质枝头袅，更轻盈。\n分春色，赠双成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"点绛唇","author":"朱雍","text":"轻艳盈盈，相逢曾向寒溪路。\n惜飘零处。\n无计禁春雨。\n素影参差，人在琼城步。\n危阑暮。\n年光催度。\n特地香风住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"迷神引","author":"朱雍","text":"白玉楼高云光绕。\n望极新蟾同照。\n前村暮雪，霁梅林道。\n涧风平，波声渺。\n喜登眺。\n疏影寒枝颤，太春早。\n临水凝清浅，靓妆巧。\n瘦体伤离，向此萦怀抱。\n觉璧华轻，冰痕小。\n倦听塞管，转呜咽，令人老。\n素光回，长亭静，无尘到。\n烟锁横塘暖，香径悄。\n飞英难拘束，任春晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"朱雍","text":"残日凭阑目断霞。\n寒林人静每归鸦。\n小梅春早压群花。\n一槛风声清玉管，数枝月影到窗纱。\n隔帘时度暗香些。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花引","author":"朱雍","text":"梅亭别。\n梅亭别。\n梅亭回首都如雪。\n粉融融。\n月濛濛。\n月上小车，归去小楼空。\n当时曾傅新妆薄。\n而今一任花零落。\n朝随风。\n暮随风。\n竹外孤根，犹与幽径通。\n长相忆。\n无消息。\n庾岭沈沈云暗碧。\n玉痕惊。\n对离情。\n无奈水遥天阔、隔琼城。\n年来素袂香不灭。\n此心无限凭谁说。\n夜绵绵。\n路漫漫。\n愁听枕前，吹彻笛声寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清平乐","author":"朱雍","text":"雪开瑶径。\n素蕊迎春影。\n楼上玉声三弄定。\n无奈幽香翻阵。\n凌晨不事铅华。\n化工却付春花。\n流水残阳江上，清随月色低斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"笛家弄/笛家 用耆卿韵","author":"朱雍","text":"镶质仙姿，缟袂清格，天然疏秀。\n静轩烟锁黄昏后。\n影瘦零乱，艳冷珑璁，雪肌莹暖，冰枝萦绣。\n更赋风流，几番攀赠，细拈香盈手。\n与东君、叙暌远，脉脉两情有旧。\n立久。\n阆苑凝夕，瑶窗淡月，百琲寻芳，醉玉谈群，千钟酹酒。\n向此，是处难忘瘦花，送远何劳垂柳。\n忍听高楼，笛声凄断，乐事人非偶。\n空馀恨，惹幽香不灭，尚沾春袖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒金门","author":"朱雍","text":"春太早。\n十二玉楼初晓。\n半额试妆深院悄。\n相逢何草草。\n临水幽香缥缈。\n彷佛淡妆窥照。\n恰值日边人未到。\n纷纷萦古道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"塞孤 次柳耆卿韵","author":"朱雍","text":"雪江明，练静波声歇。\n玉浦梅英初发。\n隐隐瑶林堪乍别。\n琼路冷，云阶滑。\n寒枝晚、已黄昏，铺碎影、留新月。\n向亭皋、一任风冽。\n歌起郢曲时，目断秦城阙。\n远道冰车清彻。\n追念酥妆凝望切。\n淡伫迎佳节。\n应暗想、日边人，聊寄与、同欢悦。\n劝清尊、忍负盟设。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三山次郑德予韵 其一","author":"朱槔","text":"日脚微明雨脚疏，谁将云梦赋相如。\n西南山好君知不，一见全胜读异书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三山次郑德予韵 其二","author":"朱槔","text":"何日归舟片叶轻，白鸥相伴橹微鸣。\n只应潮打蓬窗处，已作离骚一半清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元英折惠柚花","author":"朱槔","text":"白玉繁花五叶芳，春风吹尽洞庭霜。\n河西道眼分明处，识破此中知见香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"向年舟自三山上延平和人韵两绝 其一","author":"朱槔","text":"春江一月困扬舲，醉梦无人与唤醒。\n欲识故交金石处，相逢诗里眼犹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"向年舟自三山上延平和人韵两绝 其二","author":"朱槔","text":"春风一梦收桃李，双燕不知愁绝时。\n卧向蓬窗饱听雨，无人识此是新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"延平道中 其二","author":"朱槔","text":"云间三十六峰高，北望思归梦亦劳。\n来客双峰莫相笑，少低吾眼为儿曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"延平道中 其一","author":"朱槔","text":"一溪春涨午晴初，日透波光绿浸裾。\n却忆孤山山下路，石桥清澈看叉鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次岭上壁间韵","author":"朱槔","text":"云卧双峰祇对亭，黄尘萦拂玉梅惊。\n春风一棹归来早，谁作窗间拥鼻声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵梅花两绝句 其一","author":"朱槔","text":"一月尤溪烟雨浓，玉梅浑作玉人逢。\n江南他日摘香处，莫忘云间双髻峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵梅花两绝句 其二","author":"朱槔","text":"清浅弯环绕故墙，一身将影理残妆。\n西施俗处无人见，冷落吴宫溪水香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟次鼋湖阻水因由董山 其四","author":"朱槔","text":"梦好山晴晓不知，船边今日见须眉。\n向来快写昆崙地，元有薰风绿尽时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟次鼋湖阻水因由董山 其三","author":"朱槔","text":"拂拂朝霞到客舟，苦疑雨意在鸣鸠。\n好峰天半元相识，且作僧床挟策游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟次鼋湖阻水因由董山 其二","author":"朱槔","text":"一川黄浊写昆崙，苦恨南溪不尽吞。\n三老亦知行意速，时时插竹记沙痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟次鼋湖阻水因由董山 其一","author":"朱槔","text":"山雨疏疏心又惊，起瞻天色斗微明。\n他年一枕江关梦，知忆蓬窗此夜声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和德粹三绝 其一","author":"朱槔","text":"平生乐事在三馀，不管梧阴过玉除。\n绝尾忽参嫠纬句，风尘今日正愁予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和德粹三绝 其三","author":"朱槔","text":"未坐他年百尺楼，浮云身上且悠悠。\n眼高四海骑鲸客，不见长安亦解愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和德粹三绝 其二","author":"朱槔","text":"心赏南楼一味凉，波光山影上藜床。\n莫言体国非吾事，好梦不能千里长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春间小诗书赵园壁追录之 其二","author":"朱槔","text":"小语不知夕，幽香无尽时。\n影寒人欲醉，明月照酴醾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春间小诗书赵园壁追录之 其四","author":"朱槔","text":"夜月闽杯浅，春风楚制轻。\n故乡空费梦，来此听溪声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春间小诗书赵园壁追录之 其一","author":"朱槔","text":"柳态随时秀，花容近酒轻。\n绿窗京洛语，尽抹早莺声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春间小诗书赵园壁追录之 其三","author":"朱槔","text":"自得春风信，开怀待此花。\n馀寒固艰棘，今夕雪斜斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春寒","author":"朱槔","text":"人道春寒早系舟，楚山一夜雨浏浏。\n此生削迹江边路，嫩绿纷红只自愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日 其三","author":"朱槔","text":"山静溪回树绿晴，鹭群点点雪分明。\n影沉寒水初无意，只是鱼儿独自惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日 其二","author":"朱槔","text":"簸弄天风发彩凉，西河一笑问吴刚。\n借君玉斧烦轻手，留取个中秋影香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日 其一","author":"朱槔","text":"鸣蜩初歇树犹阴，黄菊红榴色转深。\n管领秋风有今日，留仙群称辟寒金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"草堂诸陈同游崧山精舍冕仲携琴先归用壁间韵 其一","author":"朱槔","text":"来伴秋风十日闲，笔端久已识波澜。\n烦君一醉双峰月，乞与儿曹白眼看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"草堂诸陈同游崧山精舍冕仲携琴先归用壁间韵 其二","author":"朱槔","text":"破尘妙语慰畸人，鹤发深衣雨垫巾。\n独自抱琴山下去，石桥月色为谁新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"乙丑腊月","author":"朱槔","text":"自数今年腊，天饶半月春。\n酒船欺白首，桃靥笑青唇。\n避地疏同队，逢人试问津。\n伤心穿豺虎，未肯尽奔秦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日与客语慨然有庐山之兴","author":"朱槔","text":"九日黄花笑白头，分将牢落付林丘。\n半川暝色聊偿梦，别岭秋声旋寄愁。\n江国经年成浪语，匡庐入手是真休。\n未能免俗须登陟，睨视元龙百尺楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二诗寄德粲并简内观诸友 其一","author":"朱槔","text":"春风本自掣肘去，那更病留过一旬。\n满眼山川虽不改，连天桃李已成尘。\n银河谁与洗兵马，宝唾安能泣鬼神。\n怅望故人分雪此，飞云落日在纶巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二诗寄德粲并简内观诸友 其二","author":"朱槔","text":"九渊亭上二三子，见说年来事事新。\n隔水不容招手唤，曲窗已有画眉人。\n酴醾香好急携酒，鶗鴂声繁催送春。\n笑我江南未归客，飘然天地一闲身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月上休日示求道人","author":"朱槔","text":"老禅独卧千岩表，枯木寒云伴此身。\n只倚藜根作诗本，肯分秋色与骚人。\n心源落落故难合，笔势翩翩想绝伦。\n记取濠梁断金语，三山好处要传真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三山次潘静之升书记韵","author":"朱槔","text":"客路那知岁月长，掀眉一笑苾刍房。\n且倾徐邈圣贤酒，不问陈登上下床。\n云影翻空迷海峤，秋声随梦到江乡。\n明朝各听船窗雨，犹忆枯棋战四郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大食瓶","author":"朱槔","text":"窳质谢天巧，风轮出鬼谋。\n入窑奔阏伯，随舶震阳侯。\n独鸟藏身稳，双虹绕腹流。\n可充王会赋，漆简写成周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书报国壁向年寓学于此尝见虹下饮溪中复闻子规","author":"朱槔","text":"昔与春风来此时，携书龊龊伴儿嬉。\n山晴栏楯投雌霓，身病林峦号子规。\n短发萧萧吹易尽，长江滚滚去何之。\n欲追旧事无言说，更作三生石上期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仆自以四月十四日自延平归所寓之南轩积雨阴湿体中不佳二十五日夜梦至一处流水被道色清绝若有栏槛而无屋宇有笔砚皆浸水中予惊问何地旁有应者曰此玉澜堂也梦中欲取水中笔砚作诗诗未成而觉意绪萧爽殆不类人世鸡已一再鸣矣因赋此","author":"朱槔","text":"蘧蘧飞梦过云乡，物色清辉眼界长。\n阊阖未招金马士，蓬莱先立玉澜堂。\n千寻濯足衣裘冷，六字哦诗笔砚香。\n当与瑶池作同社，红巾青鸟两相忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月二十日","author":"朱槔","text":"天涯明月见秋风，错莫谁惊碧树空。\n岂意楚山招隐处，尽归蜀客广骚中。\n钓鱼聊尔针方直，乞米茫然帖自工。\n独卧南轩听南涧，蛮花犹作杜鹃红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"尤溪县之南李花千树无一杂木春时尝饮其中酒家小轩可爱不知何故不曾作诗追赋二首明年修故事当书之壁间 其一","author":"朱槔","text":"桥外茅茨好，相过问酒钱。\n李花今若此，白发自茫然。\n落日云千步，春风雪一川。\n明朝记来处，石涧响溅溅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"尤溪县之南李花千树无一杂木春时尝饮其中酒家小轩可爱不知何故不曾作诗追赋二首明年修故事当书之壁间 其二","author":"朱槔","text":"见说小轩久，无人唤我来。\n直如春力快，故遣客怀开。\n玉立花千树，霞翻酒一杯。\n江陵二月尾，襟韵信难陪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"平津","author":"朱槔","text":"西风扶病上江楼，老眼凄迷一色秋。\n帆影戛云追断雁，角声吹月舞潜虬。\n栽培白业初无路，点检青山始欲愁。\n左海此中才咫尺，何年烟雨解扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同蹈元看竹了轩因用去年方字韵作此","author":"朱槔","text":"淇澳渭川那复梦，而今天遣出南方。\n要观大节须霜雪，莫说此君无肺肠。\n照水形容殊不恶，临风言语一何长。\n山僧岂识留连意，千里故人逢异乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"竹醉日怀故山","author":"朱槔","text":"一室真容膝，何人客子猷。\n土浮迎竹醉，云净对山羞。\n无地青归幌，他年翠绕楼。\n且从邻寺去，烟雨看沙鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老兵种菊以诗谢之","author":"朱槔","text":"蔬畦雨径策勋时，徙种邻墙菊两枝。\n九日无人过朱放，十分举酒酌王尼。\n花裁栗玉秋风健，香近龙涎晓梦知。\n负口不应还负眼，长镵烦尔镇相随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谷雨","author":"朱槔","text":"大点纷林际，虚檐写梦中。\n明朝知谷雨，无策禁花风。\n石渚收机巧，烟蓑建事功。\n越禽牢闭口，吾道寄天公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐池上用简斋韵","author":"朱槔","text":"落日解衣无一事，移床临水已三回。\n斗沉北岭鱼方乐，月过秋河雁不来。\n疏翠庭前供答话，浅红木末劝持杯。\n明明独对苍华影，莫上睢阳万死台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑德予同游桃花山次韵 其一","author":"朱槔","text":"江村卜筑路斜斜，模写癯仙四壁家。\n闻道读书忘肉味，不缘避世宿桃花。\n青山自作千年调，白眼空惊一望赊。\n欲买鸡豚投近社，烟蓑雨笠寄生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑德予同游桃花山次韵 其二","author":"朱槔","text":"春红万树抱山斜，落落真源自一家。\n云起坐中疑有雨，酒行杯面恐飞花。\n尘缘未断心虽胜，他日重来约尚赊。\n略倩渊明记遗事，武陵今不在天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春风","author":"朱槔","text":"一举造物手，万生和气中。\n酒边排雪意，诗里要春风。\n了了谁孤起，滔滔我即空。\n试询三世事，犹有读书功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏夜极凉","author":"朱槔","text":"素简久辞夜，清风先戒秋。\n稻深群蛤吠，草暗一萤流。\n舌在殊无计，心空尚有求。\n按图寻分野，楚尾见吾州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄人","author":"朱槔","text":"一牛鸣地两禅林，雾雨初晴翠霭深。\n熟路缘溪穿窈窕，疏钟唤客出岖嵚。\n未求黄卷成功处，且办青山避世心。\n怅望不来还独返，秋风聊作暮云吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄梦肇","author":"朱槔","text":"沧海横流无处安，只今且作梦中看。\n岂须游戏两蜗角，收此微茫一弹丸。\n老境怀人山宛转，春风著物鬓摧残。\n穷愁似与诗增气，嚼雪敲冰字字寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄龚十三","author":"朱槔","text":"支颐独揖北窗风，怪事从今咄咄空。\n简策不知春色晚，山川浑落战尘中。\n花飘茵席三生净，草入池塘一句工。\n想见楚龚怀我处，扁舟遨荡夕阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼郑彦继书墓亭","author":"朱槔","text":"苍梧翠柏泣西风，尺冢巍然宿草中。\n宝剑何心求季子，只鸡今日过桥公。\n麟经有味人谁识，鹤阵论功气自雄。\n欲拂苍厓写奇节，陈琳檄手语言工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"盖竹与陈和仲昆季","author":"朱槔","text":"玉树成群不可攀，谩将牢落待苍山。\n五年分手河梁外，一夕连床风雨间。\n梅蕊凌寒春欲动，酒杯无力病相关。\n朱陈自古同乡社，更约青云作往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓居南轩","author":"朱槔","text":"云气披猖月意孤，冬青倒影上庭隅。\n灯横老荠蛾方去，书掩新芸蠹已无。\n一世尽知关鲁酒，十年不拟叹齐竽。\n支颐坐觉疏星没，独扣龙头泻酪奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答戏昭文梅花","author":"朱槔","text":"腊到方留此日寒，雨多未觉过云残。\n共惊台柳匆匆去，独抱园花细细看。\n洗面不劳千点雪，薰衣剩破一分檀。\n诗人穷苦谁料理，只倚东风酒量宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠周功崇","author":"朱槔","text":"闽岭浮沈二十年，归心日夜梦江天。\n谩题甲乙烦君看，若说功名只自怜。\n造物小儿知薄相，个中老子已忘筌。\n一筇闻作东南去，岂欲求人左海边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":39700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]