[{"title":"张谋父乞花","author":"陈师道","text":"二顷田园汴泗东，春来心事几人同。\n固知短绠无深汲，又见新花发旧丛。\n花气著人浑欲醉，妍华过眼旋成空。\n冷官门外无消息，与报江南春信通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15909,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀远","author":"陈师道","text":"海外三年谪，天南万里行。\n生前只为累，身后更须名。\n未得平安报，空怀故旧情。\n斯人有如此，无复涕纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15910,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杜侍郎挽词三首 其三","author":"陈师道","text":"身去风流在，人难玉石分。\n平生才一见，治行已多闻。\n更觉知音少，还修地下文。\n他年九原泪，仍是两冯君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15911,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杜侍郎挽词三首 其二","author":"陈师道","text":"骥騄方怀远，松筠忽有秋。\n雍容名士数，终始法家流。\n凛凛惊千载，堂堂閟一丘。\n能令羊季子，不肯过西州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15912,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杜侍郎挽词三首 其一","author":"陈师道","text":"美政真吾母，名家更杜陵。\n于张从昔少，鲁卫至今称。\n丝竹中年好，词华夙世能。\n周南棠棣传，平世几人登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15913,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨夫人挽词","author":"陈师道","text":"初说南奔道路长，湖边丹旐已飞扬。\n百年积庆钟连璧，十念收功到净方。\n绛幔未经亲宋母，绿衣犹记识黄裳。\n欲图不朽须诠载，今代谁堪著石章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15914,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沈道院有水墨壁画奇笔也惜其穷年无赏之者贾明叔请余同赋","author":"陈师道","text":"壁间水墨画，为尔拂尘埃。\n草树精神出，溪山气势回。\n路从沙觜断，人自渡头来。\n莫怪知音少，牙弦匣不开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15915,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泛淮","author":"陈师道","text":"冬暖仍初日，潮回更下风。\n鸟飞云水里，人语橹声中。\n平野容回顾，无山会有终。\n倚樯聊自逸，吟啸不须工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15916,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还江上","author":"陈师道","text":"夜夜沧洲梦，归心剧旆悬。\n呼童买轻舸，拂榻下平川。\n溯浪潮如斗，凌风岸若牵。\n江乡厌回首，行及练花天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15917,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连日大雪以疾作不出闻苏公与德麟同登女郎台","author":"陈师道","text":"掠地冲风敌万人，蔽天密雪几微尘。\n漫山塞壑疑无地，投隙穿帷巧致身。\n晚积读书今已老，闭门高卧不缘贫。\n遥知更上湖边寺，一笑潜回万室春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15918,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈询秀才归徐","author":"陈师道","text":"千里相从愧子心，未堪归路马骎骎。\n更能作意怜衰病，肯后重来道古今。\n三岁有期看一举，百年聊待到千寻。\n行逢净社论馀习，为说登临久废吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15919,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸡笼镇","author":"陈师道","text":"河市新经集，鸡笼旧得名。\n初闻北人语，意作故乡声。\n客久艰难极，情忘去就轻。\n空虚仍废忘，何以慰诸生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15920,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和三日","author":"陈师道","text":"苦遭年少强追陪，病眼看花更覆杯。\n夹岸万人倾国出，清江一注两山开。\n游人欲尽惊鸥下，晚日犹须恶雨催。\n更恐明年有离别，折花临水共裴徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15921,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和元乐销暑楼晓望","author":"陈师道","text":"绕郭溪山接四邻，身轻步蹑一梯云。\n图南羽翮抟空见，倚北光芒入夜分。\n芜没池台馀故事，风流人物想前闻。\n翛然便欲移招隐，猿鹤还应怨旧群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15922,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和元夜","author":"陈师道","text":"笳鼓喧灯市，车舆避火城。\n彭黄争地胜，汴泗迫人清。\n梅柳春犹浅，关山月自明。\n赋诗随落笔，端复可怜生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15923,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王子安至日三首 其三","author":"陈师道","text":"晨起公私迫，昏归鸟雀催。\n百年忙里尽，万事醉间来。\n竹雨深宜晚，江梅半欲开。\n风灯挑不燄，寒火拨成灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15924,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王子安至日三首 其二","author":"陈师道","text":"物理有终极，人情从往还。\n阴阳消长际，老疾去留间。\n申白徒怀惠，巢由不买山。\n更歌吾和汝，风日稍侵颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15925,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王子安至日三首 其一","author":"陈师道","text":"近节翻多事，为家不亦难。\n老成须药力，愁绝向谁宽。\n冻雨能妨梦，朝霜故作寒。\n衰颜心自了，不待镜中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15926,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王明之见寄","author":"陈师道","text":"末路相逢首重回，紫芝眉宇向人开。\n老来惟有风情在，事去空怜岁月催。\n憔悴不堪临楚泽，栖迟无路上燕台。\n少陵肺病疏杯斝，想负花前载酒来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15927,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和休文至自新安","author":"陈师道","text":"无成底事到天涯，重见春工换柳枝。\n历尽江山苦行役，归来风雨过花时。\n驱驰共厌人间世，险阻时闻别后诗。\n独有穷愁销未尽，一番相见一伸眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15928,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和刘元乐月夜寄贾耘老","author":"陈师道","text":"胡床欲上庾公楼，那复周南叹滞留。\n皓魄光连鲛室午，疏星冷浸洞庭秋。\n锦袍有兴思姑熟，桃楫无心问莫愁。\n唤取长江来入社，不劳牛渚问行舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15929,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和朱智叔鹿鸣席上","author":"陈师道","text":"三楚风流秀士林，英词从昔动脩门。\n充庭初识苍龙础，赐醴行沾白兽樽。\n已上荐书轻一鹗，更凭诗力化群鲲。\n千年辽鹤空城郭，谁见朱公有异孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15930,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和过田承君","author":"陈师道","text":"寺古专宜僻，居深自作幽。\n兴来宁惮远，句苦不缘愁。\n逸气无前足，虚怀不系舟。\n逢人难晤语，冒雨亦相求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15931,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和吴子副知海斋","author":"陈师道","text":"法筵应供赖三车，堆案抽身辍算沙。\n破暑好风开乐国，脱尘新句散馀霞。\n僧奁手汗空留迹，佛几堆红拂委花。\n客舍黄粱未应熟，且容秋蝶梦南华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15932,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张次道再游翠岩之作","author":"陈师道","text":"去岁寻山有旧题，重来似与故人期。\n回峦俯仰如迎客，流水喧鸣拟索诗。\n岭路依危通鸟过，吾身趁健白云随。\n自怜久快屠门嚼，欲往安能久茹芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15933,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和张奉议赠舅氏庞大夫","author":"陈师道","text":"朝下公门不曳裾，身宽心远等林居。\n传家声烈三公后，贮腹平生万卷馀。\n藤架倚春听语鸟，石池迎日数游鱼。\n人言酷似牢之舅，未有新诗锦不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15934,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和李使君九日登戏马台","author":"陈师道","text":"登高能赋属吾侪，不用传杯击钵催。\n九日风光堪落帽，中年怀抱更登台。\n江山信美因人胜，萸菊逢辰满意开。\n二谢风流今复见，千年留句待公来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15935,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和沈世卿推官见寄","author":"陈师道","text":"倦看世态久低徊，且置穷通近酒杯。\n未忍一身闲处著，暂容双眼醉时开。\n为呼阿武扶头起，拟与山翁倒载回。\n好在东篱旧时菊，无心准拟白衣来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15936,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和和叟梅花","author":"陈师道","text":"百卉前头第一芳，低临粉水浸寒光。\n卷帘初认云犹冻，逆鼻浑疑雪亦香。\n鼎实自应终有待，天真不假更匀妆。\n江南望断无来使，且伴诗翁入醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15937,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和和叟第课还自都下","author":"陈师道","text":"青云直上马如龙，来往泠然若御风。\n高步只应天咫尺，旧游宁寄浙西东。\n升沉道路从今异，邂逅比邻此日同。\n相见可堪怀抱冷，需君健语破樊笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15938,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和南丰先生出山之作","author":"陈师道","text":"侧径篮舁两眼明，出山犹带骨毛清。\n白云笑我还多事，流水随人合有情。\n不及鸟飞浑自在，羡他僧住便平生。\n未能与世全无意，起为苍生试一鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15939,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和南丰先生西游之作","author":"陈师道","text":"孤云秀壁共崔嵬，倚壁看云足懒回。\n睡眼剩潮寒绿洗，醉头强为好峰抬。\n山僧煮茗留宽坐，寺板题名卜再来。\n有愧野人能自在，尘樊束缚久低徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15940,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和彦詹题远轩","author":"陈师道","text":"开窗得远意，兴出杳冥间。\n芳草日边路，片云天外山。\n好花和露斸，脩竹夹藤删。\n每许南邻伴，时来一寄闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15941,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和赵大夫鹿鸣宴集","author":"陈师道","text":"赵侯诗律近风骚，雅意推贤答圣朝。\n鸿雁著行过渭水，凤凰览德下虞韶。\n三千著籍今为盛，九万论程不作遥。\n不读世书谈世事，卧看君自致青霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15942,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和秦太虚湖上野步","author":"陈师道","text":"晓风疏日乍相亲，黯黯轻寒拂拂春。\n触目渐随红蕊乱，经年不见绿条新。\n宁论白黑人间世，懒复雌黄纸上尘。\n十里松阴穷野步，暂时留得自由身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15943,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和贾明叔秋晚见怀","author":"陈师道","text":"陋巷少行迹，故人车马稀。\n世情方汩没，吾道肯依违。\n万叶迎风脱，孤云带月归。\n独怜高义在，犹肯问柴扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15944,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和贾耘老春晚","author":"陈师道","text":"萦萦袅袅几丝飞，榴叶千灯照晚晖。\n紫翠园林莺欲懒，黄昏帘幕燕初归。\n花明西苑将迎幸，草绿平原正打围。\n一卧海城春又晚，不妨闲处得真机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15945,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寄朱文中","author":"陈师道","text":"仰高当日诵成规，想见风流盛一时。\n鲁国故知臧有后，孔庭早见鲤能诗。\n侵寻末路同倾盖，邂逅清谈为解颐。\n愿借湖山容膝地，为令松菊寄吾衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15946,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寇十一同游城南阻雨还登寺山","author":"陈师道","text":"雨阻游南步，泥留逐北情。\n稍看飞雾断，复作远山横。\n野润膏新泽，楼明纳晚晴。\n归宜有佳思，纱帽压香英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15947,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和寇十一雨后登楼","author":"陈师道","text":"秀岭归云里，华谯夕照中。\n登临终不数，吟笑近多同。\n麦秀知春力，人和验岁丰。\n预为逃暑约，一快楚台风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15948,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄预七夕","author":"陈师道","text":"盈盈一水不斯须，经岁相过自作疏。\n坐待翔禽报佳会，径须飞雨洗香车。\n超腾水部陈篇上，收拾愚溪作赋馀。\n信有神仙足官府，我宁辛苦守残书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15949,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄预病起","author":"陈师道","text":"似闻药病已投机，牛斗蛇妖顿觉非。\n李贺固知当得疾，沈侯可更不胜衣。\n惊逢白璧山千仞，会见黄金带十围。\n只信诗书端作祟，孰知糠籺亦能肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15950,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和黄预感怀","author":"陈师道","text":"壁立无堪佐子贫，漫修简牒效慇勤。\n起临明镜看生意，卧向晴檐共白云。\n逸气不应供潦倒，剧谈脱或致纷纭。\n但令苏晋禅妨醉，不患何山病故荤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15951,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和富中容朝散雨中感怀","author":"陈师道","text":"节物惊心懒复嗟，樽中酒尽复谁赊。\n风撩雨脚俄成阵，雪阁云头欲结花。\n万里可堪长作客，一年将尽未还家。\n自怜落落终难合，白首诗书谩五车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15952,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和董判官寺居作","author":"陈师道","text":"共作东州客，同栖古寺深。\n论交非有旧，不见解相寻。\n冷过清明节，悲生故国心。\n此身随所寄，未足问升沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15953,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和舅氏公退言怀","author":"陈师道","text":"追陪强韵愧难过，应接前闻觉未多。\n盛礼每虚摩诘席，旧词犹可雪儿歌。\n手开新径延徐步，眼趁高梧上碧萝。\n风雨入怀泥满眼，时须好语涤烦痾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15954,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和蒲左丞有美座上观雪二首 其二","author":"陈师道","text":"破晓初惊失旧山，瑶台化出坐中寒。\n江心冻合愁蛟蜃，匣里冰生吼镆干。\n门闭洛阳人迹绝，指穿东郭履痕乾。\n凤池不比梁园客，咳唾珠玑落玉盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15955,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和蒲左丞有美座上观雪二首 其一","author":"陈师道","text":"高牙大纛晓登山，卷帐飞觞不避寒。\n十二玉楼横閤道，三千银甲壮师干。\n封条已验遗蝗化，平陇宁虞宿麦乾。\n预喜丰年惟太守，旋追宾从促杯盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15956,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和酬施和叟宣德","author":"陈师道","text":"山阴倾盖两绸缪，十载重来鬓已秋。\n往事侵寻如昨日，故人牢落半沧洲。\n流离道路生涯拙，芜没田园岁计休。\n久要尚怜君子在，为言鸡黍亦迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15957,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和酬魏衍","author":"陈师道","text":"阙然声问略相同，百里之间一水通。\n春兴多多高纸价，愁怀一一逐归鸿。\n不忧寒饿成吾老，稍喜朝廷记此公。\n梦每见君心已了，不因新句觉情东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15958,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和颜生同游南山","author":"陈师道","text":"竹杖芒鞋取次行，琳琅触目路人惊。\n常年此日仍为客，病目今来喜再明。\n筋力尚堪供是事，登临那得总无情。\n已知名世徒为尔，可复缘渠太瘦生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15959,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和魏衍同游阻风","author":"陈师道","text":"旧说春风亦世情，不应作意断人行。\n绝须一怒催新句，更可多忧促短生。\n胜日著忙端取怪，妙年得此未须惊。\n悬知出处非吾事，已复星河烂漫晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15960,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和魏衍同登快哉亭","author":"陈师道","text":"经时不出此同临，小径新摧草旧侵。\n欲傍江山看日落，不堪花鸟已春深。\n来牛去马中年眼，朗月清风万里心。\n故著连峰当极目，回看幽径绕双林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15961,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜雨","author":"陈师道","text":"十月天犹雨，三更月失明。\n溟濛才洒润，点滴不成声。\n辟户风烟入，投林鸟雀轻。\n旅怀终易感，倏起别离情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15962,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉贺陈圣予","author":"陈师道","text":"合谱儿童岁，为僚一再秋。\n初闻消息报，已作别离忧。\n急雪将无路，寒江欲断流。\n相逢宁易得，端为小迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15963,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉送阎醇老推官","author":"陈师道","text":"古今犹异俗，邹鲁尚多儒。\n簿领三年责，云霄一武趋。\n数过忘潦倒，惜别更斯须。\n说与晁夫子，今年锥也无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15964,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉陪赵大夫游桓山","author":"陈师道","text":"后水喧江落浑黄，晚云障日作微凉。\n笙歌声里旌旗动，罗绮丛中语笑香。\n劝相秋郊开稔熟，摩娑苔壁吊荒亡。\n风流一代今山简，有底樽前著葛强。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15965,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庚辰三月上旬登白门闲望","author":"陈师道","text":"昔别子未仕，人言诗有神。\n预知河岭阻，不作往来频。\n剩喜今犹学，须知禄为亲。\n五陵花满眼，作意莫禁春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15966,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"放怀","author":"陈师道","text":"施食乌鸢喜，持经鸟鼠听。\n杖藜矜矍铄，顾影怪伶俜。\n门静行随月，窗虚卧见星。\n拥衾眠未稳，艰阻饱曾经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15967,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"河上","author":"陈师道","text":"背水连渔屋，横河架石梁。\n窥巢乌鹊竞，过雨艾蒿光。\n鸟语催春事，窗明报夕阳。\n还家慰儿女，归路不应长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15968,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南丰先生挽词二首 其二","author":"陈师道","text":"精爽回长夜，衣冠出广庭。\n勋庸留琬琰，形像付丹青。\n道丧馀篇翰，人亡更典刑。\n侯芭才一足，白首太玄经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15969,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南丰先生挽词二首 其一","author":"陈师道","text":"早弃人间事，真从地下游。\n丘原无起日，江汉有东流。\n身世从违里，功名取次休。\n不应须礼乐，始作后程仇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15970,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城南","author":"陈师道","text":"白下官杨小弄黄，骑台南路绿无央。\n含红破白连连好，度水吹香故故长。\n蹲滑踏青穿马耳，转危缘险出羊肠。\n孰知南杜风流在，预怯排门有断章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15971,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"拱翠亭","author":"陈师道","text":"千年茅竹蔽幽奇，一日堂成四海知。\n便有文公来作记，尚须吾辈与题诗。\n至人但有经行处，宝盖仍存朽老枝。\n能事向来非促迫，经年安得便嫌迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15972,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春怀示邻里","author":"陈师道","text":"断墙著雨蜗成字，老屋无僧燕作家。\n剩欲出门追语笑，却嫌归鬓著尘沙。\n风翻蛛网开三面，雷动蜂窠趁两衙。\n屡失南邻春事约，只今容有未开花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15973,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春夜","author":"陈师道","text":"宿鸟一枝足，争林终夜鸣。\n庭花当户发，江月向人明。\n鸟度清溪影，风回晚市声。\n梦中无好语，池草为谁生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":15974,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]