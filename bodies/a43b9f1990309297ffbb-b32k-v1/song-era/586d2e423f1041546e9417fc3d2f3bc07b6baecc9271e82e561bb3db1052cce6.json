[{"title":"白莲","author":"释智圆","text":"栽种空池岁已赊，暑天开处异群花。\n澄波照影疑秋鹭，静夜擎香混月华。\n雪态自堪怜翡翠，玉苞终耻近蒹葭。\n闲来倚槛看无厌，为似禅心本绝瑕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早行","author":"释智圆","text":"杖锡无同侣，冲霜独自行。\n断桥残月在，孤店晓鸡鸣。\n灌木栖禽散，荒原宿雾平。\n回观远山色，已觉太阳明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬子文师","author":"释智圆","text":"门静孤云去复还，讲馀他虑绝相关。\n遗名懒住城中寺，招隐曾居海畔山。\n卧疾雪房苔色老，行禅秋径树阴闲。\n玄机共了心无事，相见宁愁鬓渐斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬邻僧昼上人","author":"释智圆","text":"居止闲相近，临流野色分。\n深秋山共见，清夜磬交闻。\n静榻移明月，疏帘卷暮云。\n相于别有趣，冷淡况同群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬明上人","author":"释智圆","text":"养病孤山下，消摇任野情。\n闲门浸寒水，高槛露荒城。\n砌月移杉影，岩泉隐磬声。\n唯君许来此，相伴老馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵酬闻聪上人春日书怀见寄","author":"释智圆","text":"景色融融万卉新，潜知青帝又东巡。\n阴崖竹树犹攲雪，暖砌莺花已觉春。\n吟苦渐惊华发乱，身闲终忌俗流亲。\n寥寥此意将谁说，回首禅门有故人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上作","author":"释智圆","text":"往事那堪问，长江空渺然。\n孤城闭残日，荒陇积寒烟。\n沙涨中洲阔，潮冲古路偏。\n莫疑陵谷事，即目是桑田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江上闻笛","author":"释智圆","text":"夜久闻横笛，寥寥景更赊。\n天容垂极岸，月色冷平沙。\n静引乡心远，闲惊旅鬓华。\n哀音殊未已，可处落梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江亭晚望","author":"释智圆","text":"江亭闲写望，秋景正无穷。\n鸟没寒云外，帆归暮色中。\n淡烟生极浦，败叶坠凉风。\n回道闻渔唱，人家隔苇丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自嘲","author":"释智圆","text":"门径任苔荒，长年寝一床。\n病中消白日，诗里发清狂。\n窗暗云遮月，林明叶坠霜。\n百年能几日，两鬓已苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冷泉亭","author":"释智圆","text":"亭幽无俗状，清景涤烦襟。\n砌压寒流浅，檐分积翠深。\n晚花闲照影，古木冷垂阴。\n凭槛不能去，澄澄发静吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初晴登叠翠亭偶成","author":"释智圆","text":"杳杳遥空雨乍晴，闲拖山屐上山亭。\n平湖风静开菱鉴，叠嶂云收列画屏。\n已觉万缘真是梦，岂因闲事妄劳形。\n可怜竞利贪名者，扰扰人间醉未醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"君复处士栖大师夙有玩月泛湖之约予以卧病致爽前期因为此章聊以道意","author":"释智圆","text":"凉风吹众木，羸病转加前。\n伏枕谁相问，中秋月又圆。\n清光浮远峤，冷色混平川。\n不得同支许，乘舟乐浩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"听琴","author":"释智圆","text":"自得南风旨，虚堂此夕弹。\n正声传不易，俗耳听终难。\n峭壁虫音绝，乔枝鹤梦残。\n坐来消万虑，斜月上危栏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀子仁师","author":"释智圆","text":"寥寥尘迹远，禅外动闲思。\n水国人归后，秋轩月白时。\n鸣蛩藏坏壁，幽鸟立寒枝。\n独坐谁相问，微吟镊病髭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀中侄","author":"释智圆","text":"一从林下别，倏忽又经年。\n旧约山空在，相怀月屡圆。\n郡钟宵断梦，江树晚沈烟。\n书札凭谁寄，波涛况渺然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀友人","author":"释智圆","text":"忆向荒原别，残阳雪霁初。\n几宵成去梦，经闰绝来书。\n处世慵难减，眠云癖未除。\n幽怀向谁说，昨夜对蟾蜍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀石壁山寺","author":"释智圆","text":"梵宫藏积翠，往岁屡游遨。\n月上寒溪静，云收峭壁高。\n幽阶封药草，古树宿猿猱。\n终待携瓶锡，闲栖解郁陶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀石壁旧居兼简绍上人","author":"释智圆","text":"壁立岩峦照冽泉，几思幽景叹流年。\n归栖自合同仙迹，深隐谁云有洞天。\n修竹寒声风乍动，古潭秋影月初圆。\n伊余亦拟依支遁，枕石眠云碧嶂前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀同志","author":"释智圆","text":"孤吟成白首，十载别同声。\n海国书难到，空堂梦易成。\n淳风心共乐，直道世多轻。\n未卜重相见，波涛万里程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"怀南游道友","author":"释智圆","text":"曾闻飞锡入南闽，鹤态云踪不可亲。\n静夜独吟空对月，昔年聚话更无人。\n波涛路阻书难到，泉石房闲梦自频。\n未省相逢在何日，西风萧索浙河滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟洛下分题 文石酒杯","author":"释智圆","text":"良匠凿顽璞，为杯异彩存。\n云蒸犹有润，藓駮已无痕。\n静爱如冰洁，闲怜似玉温。\n野民便古质，长把近洼樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拟洛下分题 松石琴荐","author":"释智圆","text":"松石为琴荐，鳞皴状颇奇。\n补天虽变质，映涧尚含滋。\n静砌和烟立，虚堂带藓移。\n最宜弹别鹤，况有旧栖枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李秀才以山斋早起诗见赠因次韵和酬","author":"释智圆","text":"搜奇适异兴何全，雅句分明敌惠连。\n丹桂平窥君有分，红尘闲去我无缘。\n陶情岳雪时同望，解睡山茶夜共煎。\n静语前涂俱有意，谢公红药远公莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玛瑙坡即事","author":"释智圆","text":"玛瑙坡前住，清幽绝世缘。\n湖澄秋夜月，山碧晚晴天。\n了性方成佛，烧丹漫学仙。\n会逢温伯雪，目击道还全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲咏","author":"释智圆","text":"造化无馀岂有私，如何庶物自参差。\n群乌不涅身长黑，双鹭无愁顶亦丝。\n岩桂翠浓深雪夜，井桐黄落暮秋时。\n虚空世界都如幻，莫把闲心逐境思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居书事","author":"释智圆","text":"淡然忘外事，林下自怡情。\n室冷秋苔色，轩闲夜月明。\n眠云惭道薄，铒药觉身轻。\n拟学鸱夷子，时时变姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闲居示友人","author":"释智圆","text":"冷淡谁知趣，闲房枕水湄。\n秋窗开暮景，孤枕梦天涯。\n道直时流笑，心清夜月知。\n何当学支遁，共约买山期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和聪上人悼梵天阇梨","author":"释智圆","text":"讲院悲风动素帷，摇松难更见吾师。\n尘生旧榻休开卷，月上秋轩罢赋诗。\n真法自将传后学，清名谁为勒丰碑。\n横经弟子怀高迹，共指龙华作后期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和辩才访仲微上人不遇","author":"释智圆","text":"不见二十载，重寻事更违。\n门临寒水闭，鸟向夕阳归。\n吟恐成华发，闲疑入翠微。\n登舟独南去，乘兴一何飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏燕","author":"释智圆","text":"来去知时候，堪怜异众禽。\n双飞春雨细，对语画堂深。\n寄宿雕梁稳，衔泥柳岸阴。\n栖身自有处，鹰隼莫相侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夜怀张逸人","author":"释智圆","text":"默坐怀幽趣，谁知动郁陶。\n窗虚残月在，天静少微高。\n书去言难尽，眠来梦亦劳。\n终期冒风雪，乘兴泛轻舠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤山闲居次韵酬会稽仁侄见寄","author":"释智圆","text":"山耸湖心住任缘，考槃茆舍闭深烟。\n月澄秋水牵吟思，花满春岩照困眠。\n触石微云闲致雨，鸣皋孤鹤静闻天。\n会抛此景相寻去，渺渺沧江片席悬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤山闲居次韵酬辩才大师","author":"释智圆","text":"地僻人稀到，病来无话端。\n远山游未得，终日卧中看。\n药箧经梅润，松窗过雨寒。\n唯师知我趣，尘事绝相干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19640,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤山诗二首 其二","author":"释智圆","text":"势与群峰绝，崔嵬几倦登。\n波澄涵倒影，云尽露危棱。\n景象全胜画，林泉半属僧。\n何人凭郡阁，西望翠层层。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19641,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤山诗三首 其三","author":"释智圆","text":"仙岛湖西见，湖西景有馀。\n春融迎晓日，秋碧碍空虚。\n竹荫高僧塔，云迷处士居。\n史迁今若在，此处合藏书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19642,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤山诗三首 其二","author":"释智圆","text":"四绝尘埃路，孤山景实孤。\n危巅侵迥汉，冷色浸平湖。\n古塔名支佛，新泉号仆夫。\n王维在何处，奇迹更堪图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19643,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"孤山诗三首 其一","author":"释智圆","text":"楼阁压危碧，山根疑有鳌。\n隔湖千嶂断，出水一峰高。\n岩冷秋空月，林清雪夜猱。\n伊余绝羁束，长得恣游遨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19644,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"武肃庙","author":"释智圆","text":"土德衰微后，忠诚道不群。\n誓功陈带砺，霸业拟桓文。\n妙略奸雄慑，英声四海闻。\n山旁遗庙在，牢落闭深云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19645,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牡丹","author":"释智圆","text":"栽培宁暇问耕桑，红白相鲜映画堂。\n泪湿浓妆含晓露，火燔寒玉照斜阳。\n黄金剩买心无厌，绮席闲观兴更狂。\n谁向风前悟零落，百年荣盛事非长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19646,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玩月","author":"释智圆","text":"去秋曾久玩，皓魄坠天涯。\n始恨经年别，还忻此夜期。\n鸣蛩沈古砌，惊鹊绕寒枝。\n莫厌凭栏久，冰轮觉渐移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19647,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经松江陆龟蒙旧居","author":"释智圆","text":"甫里旧深隐，夫君道不行。\n清名身后在，明月夜来生。\n寒水曾垂钓，春田久废耕。\n空遗散人传，千古见高情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19648,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经通慧僧录影堂","author":"释智圆","text":"寂尔归真界，人间化已成。\n两朝钦至业，四海仰高名。\n旧迹存花社，遗编满帝京。\n徘徊想前事，庭树跪鸦鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19649,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经照湖方干旧居","author":"释智圆","text":"磻溪垂钓者，终得展其才。\n何事先生隐，不逢明主来。\n泉声秋雨歇，月色夜云开。\n对此空惆怅，吟魂早晚回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19650,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苔","author":"释智圆","text":"与僻偏饶分，苍苍称静吟。\n闲阶经雨遍，峭壁度秋深。\n色冷分禽迹，痕幽入树阴。\n衡门终岁在，车马绝相侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19651,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雨","author":"释智圆","text":"润物有深功，霏霏下半空。\n寒声清入竹，斜势急因风。\n苔片添秋碧，花枝损晚红。\n山人独攲枕，静听草堂中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19652,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南塔寺上方","author":"释智圆","text":"绝顶深栖万虑平，路盘危石雨苔青。\n江涵迥汉供闲望，雪映幽窗卷旧经。\n磬击晓霜禅乍起，枕摇秋浪梦初醒。\n为邻自有忘机者，月下时时扣竹扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19653,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"幽居","author":"释智圆","text":"尘迹不能到，衡门藓色侵。\n古杉秋韵冷，幽径月华深。\n窗静猿窥砚，轩闲鹤听琴。\n东邻有真隐，荷策夜相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19654,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庭松","author":"释智圆","text":"乔枝偃盖势凌云，一植幽庭度几春。\n荣落未曾同众木，孤贞长自伴闲人。\n风生静夜寒声健，雪霁遥峰翠色新。\n萧洒最宜禅定起，坐观行绕远埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19655,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日闲居即事寄元敏上人","author":"释智圆","text":"门掩平湖避俗嚣，静观风景识春朝。\n庭梅向日花全拆，岳树连云雪未消。\n少壮可惊年暗减，幽栖翻觉睡偏饶。\n相知赖有曹溪子，禅外时来慰寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19656,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日湖居书事寄子璿师","author":"释智圆","text":"闲居作赋拟安仁，壮志潜消白发新。\n烟浪静牵来往梦，莺花深慰寂寥身。\n野塘草绿湖村暮，石鼎茶香岳寺春。\n终学支公买山住，白云深处待为邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19657,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春晚言怀寄聪上人","author":"释智圆","text":"晚树归禽乱，翛然古院空。\n清谈远君子，幽兴寄丝桐。\n短发全成雪，残花半逐风。\n终期结真侣，归老乱云中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19658,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"柳","author":"释智圆","text":"融融春色伴花荣，浓翠参差雨乍晴。\n低拂冷烟元亮宅，静笼明月亚夫营。\n叶浮晚水愁眉细，絮落春衣雪片轻。\n莫上隋堤思往事，万株萧索傍河声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19659,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洞霄宫","author":"释智圆","text":"萧洒绝尘迹，虚廊画列仙。\n洞灵潜彻海，山峭欲奔天。\n松古巢高鹤，庭闲涌异泉。\n长生如有术，谁复叹流年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19660,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"砌下老梅","author":"释智圆","text":"傍砌根全露，凝烟竹半遮。\n腊深空冒雪，春老始开花。\n止渴功应少，和羹味亦嘉。\n行人怜怪状，上汉采为槎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19661,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禹庙","author":"释智圆","text":"洪水不为害，黎元受赐多。\n道尊由揖让，功大匪干戈。\n任上诸侯贡，贻谋五子歌。\n稽山千古在，宫阙倚嵯峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19662,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夕","author":"释智圆","text":"沧江秋色暮，幽思起穷居。\n风叶寒侵梦，窗灯冷照书。\n砌深虫韵咽，天淡雁行疏。\n终谢人群去，孤峰待结庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19663,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夕寄友僧","author":"释智圆","text":"白云高卧者，滞疾阻相寻。\n信断沧洲阔，房扃翠岳深。\n寒虫藏坏壁，庭树滴残霖。\n早晚同闲话，孤灯照苦吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19664,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日感事","author":"释智圆","text":"满眼皆相识，论心自不同。\n闲门扃夕照，败叶落西风。\n往事全成梦，浮生渐觉空。\n支颐独无语，四壁响秋虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19665,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋晚客舍寄故山友僧","author":"释智圆","text":"隐几不成寝，何人慰寂寥。\n空阶鸣蟋蟀，寒雨滴芭蕉。\n静语窗灯暗，归心海寺遥。\n唯应释慧远，莲社为相招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19666,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"草","author":"释智圆","text":"浅碧与深绿，萋萋古岸傍。\n旅愁生暮色，吟思发清光。\n过雨侵闲径，披烟上坏墙。\n更堪思往事，金谷旧年荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19667,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"草堂书怀","author":"释智圆","text":"浮华念久绝，闲卧爱茆堂。\n门外沧洲阔，闲中白日长。\n庭寒频坠果，炉暖忽飘香。\n寂寂无他事，谁知世路忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19668,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵万宗入道因寄","author":"释智圆","text":"羔雁已闻徵不起，却求披戴守贞居。\n月堂攲枕三清梦，秋榻生尘万卷书。\n坛匝冷痕春藓碧，鹤翘寒影雪杉疏。\n年来未得寻幽迹，闲夜何人听步虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19669,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人归旧隐","author":"释智圆","text":"要地慵投刺，刚肠耻折腰。\n旧山归兴切，残日去程遥。\n大野明残烧，空江响落潮。\n到时云树下，静听厌悬瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19670,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送人南游","author":"释智圆","text":"难阻南游兴，酣歌出故林。\n路分沧海阔，山叠瘴云深。\n马援碑宁在，重华庙可寻。\n他年却归此，闲话学夷音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19671,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送希中游霅","author":"释智圆","text":"日暮蝉鸣急，临流动别吟。\n片帆冲晚照，归鸟入遥林。\n月色寒溪静，钟声岳寺深。\n蘋洲逢旧识，应得话无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19672,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送悦上人归仙岩","author":"释智圆","text":"道性轻为别，荒城夕照阴。\n波涛归路远，云木旧山深。\n夜定依霜岛，中餐狎野禽。\n禅房清景在，飞瀑映疏林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19673,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送遇贞师归四明山","author":"释智圆","text":"吟馀江上别，一锡寄扁舟。\n远度浮残照，千峰指旧游。\n疏钟沈杳霭，群木落高秋。\n莫负重来约，禅心本自由。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19674,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送僧归饶阳","author":"释智圆","text":"执手离亭暮，言归思不禁。\n故乡千里外，为客十年心。\n帆影寒江静，猿啼雪峤深。\n饶阳泉石在，讲退自堪吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":19675,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]