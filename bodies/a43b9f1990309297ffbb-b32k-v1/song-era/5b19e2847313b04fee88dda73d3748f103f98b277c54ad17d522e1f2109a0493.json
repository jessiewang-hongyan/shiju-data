[{"title":"和李后林贺黄后谷漕荐韵","author":"萧立之","text":"爱君满腹贮精神，王翰当年愿卜邻。\n一日雄文諠上国，三生太史属前身。\n猎心勃郁惊残梦，新榜誇张说古人。\n早作功名归馆阁，诗情莫涴簿书尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34186,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送孙竹云住浮云观","author":"萧立之","text":"城郭尘埃心自村，一生吟褐任乾坤。\n江湖处处客曾席，风雨潇潇人闭门。\n蕙帐晓空云出岫，芜城春老竹生孙。\n诗囊挑入苍烟去，谁管斜阳到韵轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34187,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"丰城虑囚和滕倅壁间韵","author":"萧立之","text":"略彴横波压石安，小亭谁占此溪湾。\n晨装带月犹长道，久梦随云又别山。\n不敢告劳怜岁晚，未能免俗觉诗悭。\n梅花树下春风酒，小醉归来未掩关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34188,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次滕倅夜登楼韵","author":"萧立之","text":"湖边四面小云楼，城上三更漏鼓秋。\n月淡无痕诗共好，官清有味境能幽。\n人间路绝蓬瀛近，木末天低宇宙浮。\n唤醒尘劳椀中茗，西风黄叶正飕飕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34189,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题王衡甫吟稿","author":"萧立之","text":"君家冠冕半山翁，晚唱漓波一洗空。\n万世尚须观往复，一江元不隔西东。\n松精入地千年魄，鹏翼垂云万里风。\n安得共君秋月底，朗吟峰顶撼松公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34190,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漕园古梅","author":"萧立之","text":"花身怪怪复奇奇，几度春风未入诗。\n列璺有文蛇蜕壳，刳心不死豹留皮。\n风流不在宫妆称，冷淡偏于晚岁宜。\n为怕清寒欺客袖，一檐斜月立多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34191,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代同官送方蛟峰二首 其一","author":"萧立之","text":"除书飞舞下元正，人在金鳌背上行。\n班笋步联黄阁近，橐荷先照綵衣明。\n文章华国三千牍，樽俎筹帷十万兵。\n宣室席前应有问，愿培元气厚苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34192,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代同官送方蛟峰二首 其二","author":"萧立之","text":"蟠木离奇谁是客，讵图燕谷亦春风。\n方皋相马骊黄外，康节识花根拨中。\n投士泥途公为国，读书城旦我何功。\n只今一瓣南丰在，夹袋他年愿始终。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34193,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠张南溪","author":"萧立之","text":"长鬣张郎诗骨□，幅巾藜杖气仇仇。\n老坡言语妙百世，子美经行半九州。\n自笑我犹为口累，不应君亦有羁愁。\n眼看尘土羞形秽，梦拗梅花雪上头。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34194,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"辂新帅出城见梅","author":"萧立之","text":"城里康衢三寸埃，出城江上有疏梅。\n问公安在见何晚，似客可人期不来。\n质白不随玄令改，枝南还受北风开。\n花前不作匆匆醉，却有新诗藉手回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34195,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送娄高士归渝","author":"萧立之","text":"我无可送全椒酒，君有堪传石鼎诗。\n客里归忙云亦散，吟边相忆月明知。\n出山似已铸成错，煮石尤来疗得饥。\n别挹未成先一笑，湖元交割付他谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34196,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送黄仲与之崆峒任","author":"萧立之","text":"平生场屋几秋风，三尺词绫上界中。\n笔力健凌黄鹞子，剑心雄迈白猿公。\n羞交人指原夫辈，早慕史称儒者功。\n夜半南云瞻紫气，知君长剑倚崆峒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34197,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送曾寺簿知南安二首 其一","author":"萧立之","text":"倦随龙尾踏□檛，却爱山城放早衙。\n官好何曾啸篁竹，州清第一管梅花。\n濂翁道脉犹今日，铁汉风声想故家。\n君去我留人自恨，春风祖帐满东华。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34198,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送曾寺簿知南安二首 其二","author":"萧立之","text":"南丰事业炳如丹，振起斯文一代看。\n霄汉行飞上鸿雁，画图盛事入衣冠。\n旌幢有喜春郊满，剑槊无声夜峒寒。\n小试淮阳君且召，金狨湖外等归鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34199,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"李鹤林田惠诗有孤山探梅之句用韵为谢","author":"萧立之","text":"向来山里读书房，便是人间白玉堂。\n地有梅花三百本，春回纸帐五更霜。\n山林有约狐淘令，岁月无情老子长。\n欲起林逋说香影，急须同买月中航。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34200,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈蒲塘送端砚用韵为谢 其一","author":"萧立之","text":"龙渊打底为谁来，半瓦残砖愧不才。\n天上分星涵水镜，人间有石等舆台。\n忽惊万里诗翁眼，如发千年地媪胎。\n鬼夺客偷关梦寐，吟边时与理烟煤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34201,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈蒲塘送端砚用韵为谢 其二","author":"萧立之","text":"真盐铁使有云来，多少人怜白朴才。\n合趁闺班高处籍，尚携檄笔外间台。\n劳君海怪探龙颔，赠我厨珍得豹胎。\n又俸前诗清似水，通群辟尽锁窗煤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34202,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再韵贺得阙","author":"萧立之","text":"日日边书带羽来，时艰撑拓正需才。\n我犹不定转五木，君已高翔长一台。\n此日知心鱼在水，他时得路鹤离胎。\n江东日暮深云里，人醉冰台拥麝煤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34203,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和蒲塘乡饮酒席上韵","author":"萧立之","text":"洛社当年留样子，客中正可饮亡何。\n樽前聊复会真率，殿上相期侍馺娑。\n事意旧游忘鬓改，坐分前席觉年多。\n西风管取都长健，更插茱萸上嵬峨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34204,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和罗涧谷寄以姑苏旧游韵","author":"萧立之","text":"为云旧欠四方从，投老相逢稛载空。\n吟榻几时今雨客，尘襟一夏故人风。\n长江秋色烟波外，落日渔家醉梦中。\n无计事君吟得好，诗来面摺欲生红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34205,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送官出守平江二首 其一","author":"萧立之","text":"天上红云第二班，乞身祗要觅祠官。\n清朝得路古来有，晚节全名人所难。\n歇马重来森戟近，携龟已放去船宽。\n待公过阙争留相，温国风流此日看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34206,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送官出守平江二首 其二","author":"萧立之","text":"班玉通明散早朝，春风桃李满江皋。\n自然著我尘劳没，安得如公勇退高。\n地近黄扉才一武，天教清梦更三刀。\n仪刑渴想催归衮，只借阑门水半篙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34207,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同林城山杨学舟游虎丘","author":"萧立之","text":"虎踞名丘往事赊，胜游千载梵王家。\n山灵旧出点头石，地妒曾埋解语花。\n佛国凭空云入座，剑池共汲水随车。\n吟人谩有兴亡感，雪壁淋漓落阵鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34208,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日拉管西窗诸丈游凤石洞天酒边用草堂韵","author":"萧立之","text":"巨灵擘画境能宽，吟似追随亦可欢。\n地有此山开宇宙，天留今日会衣冠。\n石交可与论千载，岁晚相期共一寒。\n山外黄尘深没马，澄潭聊复倚阑看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34209,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄曾牧庵","author":"萧立之","text":"丹林自语叶骚骚，寒入江南入缊袍。\n丘壑风流须我辈，弓刀事业付儿曹。\n神灵助晋天机转，妊姒兴周庙算高。\n相不当侯吾事了，不妨羹泡煮溪毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34210,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次曾渔矶贺得士赟音问韵","author":"萧立之","text":"时危多难合驱除，安见娇儿竞挽须。\n支厦可能扶绪汉，誓江犹欲活全吴。\n疑从马革无还璧，忽得蝇头似串珠。\n君有诗来逾骨肉，为君吟罢酒三呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34211,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"请兵道中作","author":"萧立之","text":"八表同昏草露深，西风愁绝不成吟。\n申包胥有伤时泪，南霁云无食肉心。\n日月重光天与子，山河正统古犹今。\n微生千里间关意，净洗妖氛待相霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34212,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渔矶惠诗适闻王师过邑次韵作欢喜口号","author":"萧立之","text":"不是逃名韩伯休，避兵聊欲蔽林丘。\n天公悔祸有今日，臣子扶颠无半筹。\n苍玉硖鸣春意动，红绵袄出雾痕收。\n诗来适喜王师至，醉插梅花舞白头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34213,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春晴试笔","author":"萧立之","text":"为喜逢春亦自怜，新晴风物此花前。\n蝶狂有意如耽色，树老无枝莫记年。\n钟虡尘深唐九庙，金铜泪尽汉中天。\n二三豪俊今何在，愁绝孤臣雪满天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34214,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和本县黎月罔劝农韵","author":"萧立之","text":"白发衰翁且翠颠，伤心难问屈原天。\n当时一聚如金谷，此日数间惟玉川。\n劝谏只今犹乐土，耕犁何地不炊烟。\n欲亲偃室无公事，一段阻心似壅泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34215,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再韵谢黎月罔笔墨丹砂之贶","author":"萧立之","text":"今君好赐及层颠，怜我幽篁不见天。\n束缚遣前浮月窟，品题称绝重黟川。\n药来南海增新价，剂入西窗煮晚烟。\n惟有吟哦相报答，为君涤砚试新泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34216,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄罗涧谷 其一","author":"萧立之","text":"同是人间七十馀，相思无地问何如。\n仓皇空忆归时别，契阔都无落□书。\n□去避兵长蓐食，迩来古地且巢居。\n题诗甲子应同集，便雁相逢赖启予。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34217,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄罗涧谷 其二","author":"萧立之","text":"诗去诗来只月馀，渴心顿解沃心如。\n居然咫尺有万里，如此乱离无一书。\n山里黄齑犹可饱，天涯白草更堪居。\n汉宫旧日烟花绕，造化胡宁亦忍予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34218,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又和","author":"萧立之","text":"东南文物古遗馀，不料冠绅忽弃如。\n门外逢人作胡跪，官中投牒见番书。\n谁教天女解作俑，欲倩渔郎寻卜居。\n更欲久留观此世，昌黎此语倍愁予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34219,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次黎宰并柬曾楚山二首 其一","author":"萧立之","text":"谁道行年值小游，转添白发上人头。\n檀公上计无多子，潘令吟情第一流。\n四海交游惊鬼录，一身生死寄岑楼。\n因公唤醒推敲梦，此夕灯前忘却愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34220,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次黎宰并柬曾楚山二首 其二","author":"萧立之","text":"我耕枯旱不逢年，君解翻瓢涨九渊。\n道义相忘床上下，诗书有味蜜中边。\n向来湖海鱼千里，此去功名马一鞭。\n坐想昼帘公事少，时将诗递破苍烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34221,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读文山诗","author":"萧立之","text":"退未能休进未前，英雄到此亦堪怜。\n此心耿耿赤如日，吾道悠悠苍若天。\n顾我尚堪输九死，观公端可愧诸贤。\n新诗读罢无谁语，欲折梅花意不传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34222,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和周平洲韵","author":"萧立之","text":"此日旧无灵运屐，参差今有盖头茅。\n自怜后死罹兵革，枉有闲愁上鬓毛。\n泪尽不堪怀故国，诗来端喜得同袍。\n梅花夹雪无饶景，惜许吟情与病遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34223,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"左臂痛","author":"萧立之","text":"人生两臂重天下，濠上仙翁语意高。\n不以拾遗曾坠马，可教吏部废持螯。\n风寒欠护知谁过，药裹频更藉汝曹。\n安得慈悲有千手，一枝才是九牛毛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34224,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与刘两峰","author":"萧立之","text":"可竹诗来为说君，采蘋宫冷尚疑尘。\n人生不幸有奇祸，天道终当与善人。\n蔡琰援琴应制曲，寿昌见母足娱亲。\n两峰座上客常满，芋栗杯盘日夜春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34225,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠道士湖古澹","author":"萧立之","text":"江湖千载吊沉筒，楚俗今仍楚节供。\n已分三生委鱼鳖，肯争一饱为蛟龙。\n怜君客死非吾土，顾此首丘犹故封。\n试问厌厌曹李辈，人间膏沐若为容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34226,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江行得水压青天下小桥一句足成唐律","author":"萧立之","text":"老去无心任一瓢，意行聊复侣渔樵。\n云迷远树昏残照，水压青天下小桥。\n物我境空鸡已木，功名梦断鹿犹蕉。\n插秧绿遍江南岸，又送年光入画桡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34227,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次曾楚山","author":"萧立之","text":"自笑忧兵阅四州，此身只为苦吟留。\n林栖几见芦穿膝，室毁欲无茅盖头。\n岁月巧将吾辈老，江山唤起故人愁。\n诗来忽作山阴想，问字敲门可得不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34228,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"早起","author":"萧立之","text":"参差曙色走归云，落月犹高欲近人。\n客鬓已随时事改，风光犹逐世情新。\n孔方不是折简客，白堕真成入幕宾。\n忽有微吟生眼界，山光遥映雨如尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34229,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次楚山见寄","author":"萧立之","text":"穿青度密且衡门，剪纸谁招客子魂。\n少不若人伤老大，死无容力为乾坤。\n一枰孰与危机活，千古难磨此道存。\n前有长蛇后猛虎，少陵只合老羌村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34230,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观楚山关庙长篇记旧读史成唐律","author":"萧立之","text":"振世威名一宝刀，紫髯郁郁见人豪。\n受恩刘氏心非二，报效曹公义亦高。\n须信千年存庙食，不应一死误儿曹。\n江南处处新祠屋，可使雄兵叹不遭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34231,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次使长苍玉洞韵","author":"萧立之","text":"不是仙源不是村，千年霜壁树蟠根。\n半山鱼鼓动城郭，一日龙雷出洞门。\n云似世情翻覆变，石如尊宿典刑存。\n摩挲藓刻无穷意，时听游人自细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34232,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书罢偶成","author":"萧立之","text":"书眼犹明返照窗，西风篱落已啼螀。\n放慵自觉闲居好，涉难争期末路长。\n稍解忍饥知道进，未能守口坐诗狂。\n世间万事如蓬转，且对青山进晚凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34233,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"己卯秋社","author":"萧立之","text":"社公水又一番新，阵阵秋风入白蘋。\n归燕去如秦逐客，羁鸿哀似楚累臣。\n青山有约堪娱老，红树无情强作春。\n好为麻姑问人世，如今几见海扬尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34234,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄楚山","author":"萧立之","text":"别后梅花几度春，催人年纪亦匆匆。\n长如此日易百岁，未觉吾衰成两翁。\n晓镜拂须无可白，霜颜压酒不□红。\n莫看谈笑封侯得，留眼江皋送断鸿。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34235,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄题崇仁吴甫伯寿康堂","author":"萧立之","text":"五福难并寿且康，如君有此扁斯堂。\n乔松岁晚不改色，佳菊霜寒弥有香。\n身健清樽供笑咏，眼明细字辨毫芒。\n风流万一成图画，容两诗翁作雁行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34236,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次刘苍涯见访","author":"萧立之","text":"山里清怀人得知，地炉灰冷雪来时。\n七年有别君仍壮，一事无成我自悲。\n履豨应为天下计，缚鸡曾见故人诗。\n欲谈世事难相就，不为冲寒脚力疲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34237,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和烧榾柮韵","author":"萧立之","text":"樵子归来赪担肩，长镵作我地炉缘。\n深山大泽蛰蛇虺，冷窗冻壁生云烟。\n暗室长明天不夜，团茶自煮客堪延。\n穷吟自笑成寒色，不到琉璃玳瑁边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34238,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题陈氏西园","author":"萧立之","text":"旧赋西园墨尚新，西园风物又精神。\n子孙相望百年事，宇宙重回一气春。\n独乐风流今寂寞，平泉言语谩悲辛。\n两家子弟材智下，撞破烟楼有几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34239,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"壬午元日试笔有怀十翁楚山先生两章奉寄 其一","author":"萧立之","text":"年似渭滨人样子，竹房深夜一灯青。\n老莱有妇能言语，元亮无言亦典刑。\n诗到夔州尊绝倡，人瞻鲁殿兀苍冥。\n写添涧谷成三老，洛下风流可得成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34240,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"壬午元日试笔有怀十翁楚山先生两章奉寄 其二","author":"萧立之","text":"记前壬午甫能冠，甲子周回有此年。\n方寸可耕宁要地，须臾毋死尚观天。\n史无一事贤黄宪，士有终身感鲁连。\n万里梅花一樽酒，青山不尽水无边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34241,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋燕","author":"萧立之","text":"犹记东风社雨晴，步栏辛苦得巢成。\n依刘信美非吾土，去鲁虽迟在此行。\n生也有涯同是客，逝将去汝得无情。\n乌衣巷陌休回首，兴废人间又一枰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34242,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"壬午九日士资自广运铁南雄归途过家士贽士赟有诗因用韵","author":"萧立之","text":"惊心节物首重回，尚觉昏云黯未开。\n旧向醉馀狂客帽，今犹健在倒莲台。\n菊如杜老开偏晚，客胜后山期不来。\n碌碌阿奴俱在目，剩锄菘韭种蒿莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34243,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游凤石道院","author":"萧立之","text":"山外西风掣大船，悬崖一席镜中天。\n凤何年化石班驳，龙有时回潭碧鲜。\n礨空似经灵运凿，苍筤竞著祖生鞭。\n人知鱼乐谁知我，度度归时月满川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34244,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄彭梅庄","author":"萧立之","text":"懒似嵇康多几分，缄情久不报殷勤。\n人言岁暮于吾子，今见梅花疑是君。\n岁月尚须留我辈，乾坤何可少斯文。\n相期不作草中腐，付与后来杨子云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34245,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵答徐毅斋","author":"萧立之","text":"文印诗灯自正宗，不忘生死访衰翁。\n樽前谈笑有此客，眼底轮囷亡是公。\n两世交游明月共，百年人物大江东。\n吾生荣悴乖逢尔，昨夜春风梅信中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34246,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"溪行见落梅为赋","author":"萧立之","text":"玉龙轻软雪能乾，好在晴沙野水看。\n舞翠梦回仙袂远，射雕人去露檐寒。\n连环骨冷香犹暖，如意痕轻补未完。\n花自年年人自老，春风满袖独凭阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34247,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桃源","author":"萧立之","text":"桃源花发几番春，闻说渔郎此问津。\n秦帝漫劳方士遣，神仙已是避秦人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":34248,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]