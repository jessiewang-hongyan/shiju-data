[{"title":"候人","author":"张载","text":"林木南山荟蔚时，工斤樵斧竟朝侪。\n举知趋利青冥上，不念幽闺季女饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渚宫观梅寄康侯","author":"杨时","text":"欲驱残腊变春风，只有寒梅作选锋。\n莫把疏英轻斗雪，好藏清艳月明中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿兴庆池通轩示同志","author":"张载","text":"清湘庭下千竿竹，百尺斑斓耸苍玉。\n通轩轩外万顷陂，陂接南山天与齐。\n唐基一坏半禾黍，举目气象增愁思。\n我来正当摇落时，尘埃七日无人知。\n东平叔子信予友，问学不厌坚相随。\n叔子莫痛凤沼湮，又莫悲愁花萼堕。\n所忧圣道久榛塞，富贵浮云空点涴。\n明发予西叔且东，高谈更为通宵坐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"移疾","author":"张载","text":"移疾谢华省，问耕还弊舍。\n扶持便疏慵，旷僻逃将迓。\n昼棋莎径侧，暮粥梧阴下。\n久矣澄清心，永愧桑弧射。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55650,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游山寺","author":"张举","text":"冻仆堆堆依灶燎，山僧草草具盘飧。\n井丹已厌尝葱叶，庾亮何劳借薤根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55651,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古乐府 其一 虞帝庙乐歌辞","author":"张载","text":"皇胡为兮西山之幽，翳长薄兮俯湖流。\n眇冀州兮何有，眷兹上兮淹留。\n皇之神兮如在，子我民兮不穷以爱。\n沛皇泽兮横流，畅威灵兮无外。\n洁尊兮肥俎，九歌兮拓舞。\n嗟莫报皇之佑，皇欲下兮俨相羊，烈风雷兮暮雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55652,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古乐府 燕歌行","author":"张载","text":"小雅废兮，东山不作。\n哀我人斯，皇心不乐。\n烝哉斯人，胡然而天兮，王师于铄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55653,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠司马君实","author":"张载","text":"二龙闲卧洛波清，今日都门独饯行。\n愿得贤人均出处，始知深意在苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55654,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"古乐府 鞠歌行","author":"张载","text":"鞠歌胡然兮，邈予乐之不犹。\n宵耿耿其尚寐兮，日孜孜焉继予乎厥修。\n井行恻兮王收，曰曷贾不售兮，阻德音其幽幽。\n述空文以见志兮，庶感通乎来古。\n骞昔为之纯英兮，又申申其以告。\n鼓弗跃兮麾弗前，千五百年，寥哉寂焉。\n谓天实为兮，则吾岂敢，羌审己兮乾乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55655,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"张举","text":"无限寒鸦冒雨飞，红树高高出粉墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55656,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"张举","text":"苦厌尘沙随马足，却思风浪拍船头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55657,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"张载","text":"若要居二宅，先须入礼门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55658,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其九","author":"张载","text":"无疑菱荇香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55659,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"张载","text":"十载相从应学得，怕人知事莫萌心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55660,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"张载","text":"一目全牛万隙开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55661,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"张载","text":"春菰牙露翠，水荇叶连青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55662,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"张载","text":"红树高高出粉墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55663,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题高房山夜山图","author":"张逢原","text":"地位清高眼界宽，尽收风景入豪端。\n废宫台榭和烟锁，隔岸江山对月看。\n一水中分吴越近，层楼低接斗牛寒。\n有声画意吟难了，更把瑶琴膝上弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55664,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游山七绝 千山观","author":"张釜","text":"小立东风紫翠颠，画屏展尽一山川。\n非关眼界因高别，自是人心逐物迁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55665,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游山七绝 其一 水月洞","author":"张釜","text":"水际空明月正圆，人行月里水如天。\n道旁听得人争指，半是当年折桂仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55666,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游山七绝 龙隐洞","author":"张釜","text":"何年此地蛰飞龙，石壁蜿蜒尚有踪。\n为报龙公莫贪睡，郡人于尔卜丰凶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55667,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游山七绝 栖霞洞","author":"张釜","text":"云封雾锁半天寒，短杖攀缘扣玉关。\n见说碧虚风景别，傥容投老寄尘颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55668,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游山七绝 其二 水月洞","author":"张釜","text":"千年佛阁与云齐，足力穷时目力移。\n堪笑痴儿誇壮丽，那知芥子纳须弥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55669,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游山七绝 訾家洲","author":"张釜","text":"訾洲风物柳州文，开□□□□梦魂。\n老去一尊酬望眼，淡烟衰草莽连村。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55670,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送鹤还齐云","author":"张釜","text":"胎仙谁遣到尘寰，尽日清吟伴我闲。\n不作冲天支遁想，颇疑携箭佐卿还。\n欲追鸾驾烟霞上，肯处鸡群伯仲间。\n为语齐云好看取，他年我欲访缑山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55671,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游澹岩 其二","author":"张釜","text":"真仙窟宅在人境，应有鸾驾乘云归。\n物华创见讶三岛，坠脉远来从九疑。\n有石可砺食檗齿，有泉可濯凝尘衣。\n清游未足鸡报午，一尊会合人生稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55672,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游澹岩 其一","author":"张釜","text":"澹岩类古隐君子，一见可洗千劫尘。\n清旷信出世间境，经行如画图中人。\n幽泉涓涓不碍坠，灵草苒苒非关春。\n题诗因昔□游子，冷眼阅尽惟唐珉。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55673,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张釜","text":"此生吾变未蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55674,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张釜","text":"盘礴幽窗觅诗句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张釜","text":"人去人来眼转新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张釜","text":"烟锁西山暝色赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张釜","text":"山意入时清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张釜","text":"幻成一岛画图閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张釜","text":"回首重阳嗟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"张釜","text":"诗村眼界知多少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和吴仲庶龙图西园海棠","author":"范纯仁","text":"丹葩翠叶竞夭浓，蜂蝶翩翻弄暖风。\n濯雨正疑宫锦烂，媚晴先夺晓霞红。\n芳菲剑外从来胜，欢赏天涯为尔同。\n却想乡关足尘土，只应能见画图中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠","author":"张冕","text":"海棠栽植遍尘寰，未必成都欲咏难。\n山木瓜开千颗颗，水林檎发一攒攒。\n初疑红豆争头缀，忽觉燕脂众手丸。\n西蜀僧家根拨小，南荆官舍树支宽。\n高穿群木无因蔽，平倚危楼最好看。\n十亩园林浑似火，数方池面悉如丹。\n锦袍万丈仍连袂，珠被齐光更合欢。\n风袅细腰妆正罢，露晞铜雀泪新乾。\n晨曦远借彤云暖，秋魄微侵甲帐寒。\n会宴岂劳供幄幕，采香应见费龙檀。\n秾烧游女青丝发，殷染妖姬白玉冠。\n宾席半移隈茜绶，使车多热簇雕鞍。\n层层排朵萦飞蝶，密密交柯宿翠翰。\n诗客早惭矜镂管，画工谁敢衒霜纨。\n本期相伴千场醉，可忍轻邀百卉残。\n川路尚移随迅濑，蕃船犹折出长澜。\n飘零绛雪深盈尺，收拾晴霞散结团。\n时去独应贤者识，色空前有达人观。\n谱为仙子终须美，实作寒梅况不酸。\n五六年来离别恨，春宵频梦石台盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五台山","author":"张商英","text":"五顶嵯峨接太虚，就中偏称我师居。\n毒龙池畔云生早，猛兽岩前客过疏。\n冰雪满山银点缀，香花遍地锦舒铺。\n展开坐具长三尺，方占山河五百馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南乡子 其一","author":"张商英","text":"向晚出京关。\n细雨微风拂面寒。\n杨柳堤边青草岸，堪观。\n只在人心咫尺间。\n酒饮盏须乾。\n莫道浮生似等闲。\n用则逆理天下事，何难。\n不用云中别有山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南乡子 其二","author":"张商英","text":"瓦钵与磁瓯。\n闲伴白云醉后休。\n得失事常贫也乐，无忧。\n运去英雄不自由。\n彭越与韩侯。\n盖世功名一土丘。\n名利有饵鱼吞饵，轮收。\n得脱那能更上钩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小绝句 其一","author":"张埴","text":"解貂换美酒，半与美人醉。\n留半伴山翁，夜深谈世事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书萍实旅舍","author":"张埴","text":"身谋落落屠羊说，心事冥冥司马炎。\n告诉春风无一语，江南陌上雨廉纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东湖汤饼后进翁展墓饮嵩山踏雨泳归在行相继属和兰亭集献之噤无半语果人情耶 其二","author":"张埴","text":"溪桥三日雨轻过，归影苍凉雨奈何。\n诗落邙山松柏后，相看有愧少陵多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东湖汤饼后进翁展墓饮嵩山踏雨泳归在行相继属和兰亭集献之噤无半语果人情耶 其一","author":"张埴","text":"诸老襟期三十年，看花杖屦又栖禅。\n春风不断斯文意，嘘拂衣冠著一边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月旦小斋观梅","author":"张埴","text":"粗桃俗李要风光，番雨危君白玉堂。\n回首南枝春梦断，芳心犹忆古含章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘元翁为索赋鞠逸 其二","author":"张埴","text":"与花丛薄且媻娑，早晚风霜亦奈何。\n欲待太平求不死，南阳水胜上池多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘元翁为索赋鞠逸 其一","author":"张埴","text":"回首桃花只俗休，还君本色一篱秋。\n小儿德祖渠何见，不认杨梅个话头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西山九曲亭","author":"张埴","text":"一藜屈折入高秋，惆怅天门万里头。\n世路转看无直处，黄州以后有儋州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过洞庭书所见","author":"张埴","text":"湿烟吹起岸东西，渔子藏舟竹四围。\n脱下蓑衣扬去雪，不教人道钓鱼归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏湖山 其一","author":"张埴","text":"重台栀子玉攒花，初夏湖山一供嘉。\n三嗅馨香几欲泣，年时曾食故侯瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏湖山 其三","author":"张埴","text":"三供飞来个白鸥，炯然点破一池幽。\n午阴小扇人回首，何许白蘋江上愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏湖山 其四","author":"张埴","text":"山灵浑不倦差排，四供相随好雨来。\n花木成行新膏沐，麻鞋更上一层台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏湖山 其六","author":"张埴","text":"六供菖阳气味真，还教绳墨百年身。\n幅巾清脱山风外，都等离骚说众人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏湖山 其二","author":"张埴","text":"今朝二供亦相宜，眼底忘忧粲是诗。\n有恨春风不相待，山林著在日长时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏湖山 其五","author":"张埴","text":"五供翛然可是鲜，一生只抱石头眠。\n死应不恨为冯剑，夏日攸山二十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴城山用东坡韵","author":"张埴","text":"半篙水映四垂山，不见年时白雨船。\n自恨阑干搔短发，斜飞一鸟远粘天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和梅溪岁晚所寄","author":"张埴","text":"客里无鱼未易禁，春风颇忆洞庭针。\n可能更问诙谐肉，发已如今不及心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和舒波社日清明","author":"张埴","text":"小试麻鞋路半乾，归来连得好诗看。\n去年曾被梅花恼，今过林边辄齿寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奇山在繁步二十八字迎之","author":"张埴","text":"闻有翛然一角巾，湖山雨亦动吟声。\n如何十里繁江路，犹待诗筒一笑迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送衣还石泓弟 其一","author":"张埴","text":"十指本非扪虱具，半生何有结鹑时。\n道安一矢不相及，管领岁寒吟此诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送衣还石泓弟 其二","author":"张埴","text":"所不贷人惟世道，最无穷处是天机。\n昂藏池上霜枫树，寒冷年年著锦衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏日鹄山","author":"张埴","text":"合昏枝上数花白，领略山中每日看。\n阅历春风人眼恕，相传此法度荒寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湘中二首书县斋冰壶 其二","author":"张埴","text":"晴垄麦过花，暖泥秧出水。\n宽得一寸心，人行更千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登岳阳楼 其三","author":"张埴","text":"坐拥湖山把一麾，当年吏部只吟诗。\n平章功业如今许，弃了吟诗选得碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登岳阳楼 其二","author":"张埴","text":"冻云吹尽楚天宽，鸿去冥冥叫不还。\n饶得两翁文墨在，至今楼上伴君山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登岳阳楼 其一","author":"张埴","text":"临风把酒此何时，白首登临亦暮迟。\n一片湖光寒日里，品题都是北来诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答士宜 其一","author":"张埴","text":"老来凡事不须知，只著冲襟向圣涯。\n怊怅无人思祸水，一窗夜雨客谈诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答士宜 其二","author":"张埴","text":"书生何饰结天知，忽放晴光渺四涯。\n一片归心湖草外，轻风摇艇自吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十三日归天光云影堂","author":"张埴","text":"因缘十日坐无哗，吹尽蒲香更结跏。\n几上玉鸲犹刮目，阶前金凤已衔花。\n且将柳浪还摩诘，莫去麻丘说子嗟。\n满袂木阴清似水，时看跳处是虾蟆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三用韵谢士安","author":"张埴","text":"清言一掬解千纷，又向名家见大君。\n北海无风鹏不运，南山有雨豹能文。\n更令此手曾扶日，未必吾冠不切云。\n鼻已辛酸复何事，天寒梅气只心闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中","author":"张埴","text":"一笑归来百事疏，溪山随意葺吾庐。\n有时临水亦清矣，无事听禽皆起予。\n但喜达人谋熟醉，不知论者谓因馀。\n马蹄未踏门前路，也怕先生废看书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山阁","author":"张埴","text":"绛甲至今寻四百，东风吹酒楚天涯。\n有时咄咄口三唾，无事由由手一叉。\n不怨雨声聋客耳，只愁春思乱杨花。\n弄乌此日人何往，自倚小楼娱晚霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书彭秋卷末","author":"张埴","text":"雨露悽其厚地阴，千秋宰木是衣襟。\n君看江头寒食日，谁不邙山路上心。\n勿剪世无嘉树传，相寻事有后来吟。\n相堂翁仲曾传语，所谓天光要下临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太白祠","author":"张埴","text":"翰林昭代世之雄，何止将军走下风。\n吟墨淋漓三极浃，酒杯倾倒五湖空。\n可怜墓草离离碧，不似袍花袅袅红。\n端的骑鲸何许去，娥眉亭上问渔翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风雨后有怀","author":"张埴","text":"凄凄如此雨，仆仆是何人。\n野饭徒炊湿，泥行亦浃旬。\n斯文从古有，我辈及今贫。\n岁晚归南郭，为靴不用银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":55721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]