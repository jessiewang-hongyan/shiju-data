[{"title":"哭左次魏二首 其一","author":"刘克庄","text":"少日一编书，中年丈二殳。\n乃知杜预智，谁谓狄山愚。\n小试飞钳策，方为进筑图。\n到头麟阁上，终不著臞儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭刘连江","author":"刘克庄","text":"晚唐才调晋风期，一片胸襟颇涉奇。\n每过邻家因贳酒，偶添别墅为赢棋。\n议郎秩浅无超拜，令尹官清有去思。\n种得花成身不见，江边父老至今悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭孙行之二首 其二","author":"刘克庄","text":"世上高科众，君尤自贵珍。\n如何一夕里，忽尽百年身。\n双旐齐眉友，孤灯拥髻人。\n伤心惟孟母，头白送归闽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭孙行之二首 其一","author":"刘克庄","text":"已了灯窗债，心知举业非。\n立朝多谏草，取友必深衣。\n齑瓮贫时共，书筒贵后稀。\n病身偏惜泪，一为故人挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭孙季蕃二首 其二","author":"刘克庄","text":"每岁莺花要主盟，一生风月最关情。\n相君未识陈三面，儿女多知柳七名。\n自有菊泉供祭享，不消麦饭作清明。\n老身独殿诸人后，吟罢无端雪涕横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭孙季蕃二首 其一","author":"刘克庄","text":"岁晚湖山寄幅巾，浩然不见两眉颦。\n看花李益无同伴，顾曲周郎有后身。\n厚禄殷勤营葬地，隐君欢喜得吟邻。\n看来造物于君厚，判断风光七十春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭伯姊二首 其二","author":"刘克庄","text":"幼以木兰为长兄，岂堪垂老隔幽明。\n空疏谁更讥匡鼎，友爱何曾詈屈平。\n服已降期从变礼，圣犹尚左况诸生。\n追严不必伊蒲供，自有松风与涧声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭伯姊二首 其一","author":"刘克庄","text":"弟为龟湖妹制碑，伯姬舍我复何之。\n今彤史笔嗟谁炳，古锦囊诗独姊知。\n起絮撒盐才有间，燎须作粥力安施。\n澜湍石畔霜风冷，行路无情亦涕洟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭吴杞","author":"刘克庄","text":"七十未升舍，目深双鬓残。\n病中依佛寺，死处近严滩。\n俗薄挥金少，家贫返骨难。\n遗言令火葬，闻者鼻皆酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭吴卿明辅二首 其二","author":"刘克庄","text":"吴兢史法蔡邕碑，每叹斯文尚在兹。\n老夺故交堪痛惜，晚徵集序未遑为。\n单传骨髓惟吾子，空呕心肝向阿谁。\n道远束刍携不去，覆翻遗墨岂胜悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭吴卿明辅二首 其一","author":"刘克庄","text":"水心文印虽传嫡，青出于蓝自一家。\n尚意祥麟来泰畤，安知怪鵩集长沙。\n忤因宫妾头无发，去为将军手污靴。\n他日史官如立传，先书气节后词华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭宋君辅","author":"刘克庄","text":"早题淡墨魁多士，晚著青衫事护军。\n方见叔孙来议礼，已传子夏去修文。\n先朝缫藉为圭璧，近世摧残用斧斤。\n回首冶城棋饮地，雁悽蝉咽不堪闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭张玉父","author":"刘克庄","text":"华发客朱门，文高道又尊。\n十分穷不屈，一片气长存。\n篱掩湖边宅，坟依郭外村。\n二孤弹旧铗，泣感孟尝恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭李公晦二首 其二","author":"刘克庄","text":"洲边三亩宅，有竹有梅花。\n岂不堪名世，何如勿起家。\n身才著朱绶，州谩出丹砂。\n渺渺重湖外，悲风咽暮笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭李公晦二首 其一","author":"刘克庄","text":"不会苍天意，令君死五溪。\n少曾游洛下，晚乃相胶西。\n白首尊师说，丹心对御题。\n悲乎成底事，路远客魂迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭李景温架阁","author":"刘克庄","text":"挟策说荆州，那知亦闇投。\n漫招温处士，几杀杜参谋。\n出幕有清议，还乡空白头。\n人间容不得，下与阿翁游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭杨吏部通老","author":"刘克庄","text":"白首除郎已晚哉，民间桑柘手亲栽。\n盖棺只著深衣去，行李空担语录回。\n主祭遗孤犹未冠，著书残藁漫成堆。\n可怜薄命飘蓬客，虚事江西莫府来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭陈钥主簿","author":"刘克庄","text":"不但心孤介，生形亦怪奇。\n在为官长骂，没使邑人思。\n魂远乡犹隔，名微世未知。\n空存朋友谊，到此力何施。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭周晋仙","author":"刘克庄","text":"君在诗人里，功夫用最深。\n古如神禹铸，清似鬼仙吟。\n死定无高冢，生惟有破衾。\n长安酒楼上，犹记昔相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭林山人","author":"刘克庄","text":"僵卧茅檐下，怡然八十春。\n竟无衾覆首，惟有钟随身。\n赙吊稀来客，封崇托外亲。\n自言坟出贵，后必产奇人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭林晋之判官晋","author":"刘克庄","text":"去岁冲寒赴辟时，感君骑马远追随。\n一春不得梅花信，万里空题薤露诗。\n小简佩壶邀士友，大铛煮粥活流移。\n平生二事尤堪记，应有名公与撰碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭泽孺方先生二首 其二","author":"刘克庄","text":"方讶书来少，殊乡讣忽闻。\n素帏无祭主，破笥散遗文。\n已闭三间屋，谁封四尺坟。\n旧曾传业者，南北各离群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭泽孺方先生二首 其一","author":"刘克庄","text":"弟子成名众，先生独命穷。\n广场双鬓秃，陋巷一瓢空。\n鸡馔为亲设，牛衣与妇同。\n嗟乎犹啬寿，神理竟难通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭郑君瑞长官二首 其二","author":"刘克庄","text":"史著陶潜卒，何妨爵秩卑。\n竟无乞米帖，止有采薇诗。\n旧友谁为诔，新阡尚欠碑。\n中年哭同志，孤立可胜悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭郑君瑞长官二首 其一","author":"刘克庄","text":"自解铜章后，终身耻折腰。\n偶然安旧隐，非不恋清朝。\n薪水才能给，弓旌未易招。\n坟山梅似雪，犹足配清标。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭赵百微少蓬二首 其二","author":"刘克庄","text":"长君尤岁辈流稀，君直西垣我北扉。\n襆被本无桑下恋，联鞍犹记柳边归。\n锦残尚足邱迟用，斤妙曾看郢客挥。\n闻卜菟裘殊未定，吴中埋玉是耶非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭赵百微少蓬二首 其一","author":"刘克庄","text":"书筒旧岁尚谆谆，曾几何时哭蜀珍。\n对紫薇边还老手，近红云处立长身。\n禁中视草蒙天笑，湖外埋轮触相嗔。\n直气雄辞俱已矣，西风怀友一沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭赵紫芝","author":"刘克庄","text":"夺到斯人处，词林亦可悲。\n世间空有字，天下便无诗。\n尽出香分妓，惟留砚付儿。\n伤心湖上冢，谁葬复谁碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭容倅舅氏二首 其二","author":"刘克庄","text":"尚记陪言笑，如今叫不应。\n儿分身后俸，僧上殡前灯。\n宅有遗基在，田无一亩增。\n问天何至此，在日以廉称。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭容倅舅氏二首 其一","author":"刘克庄","text":"老赴容州辟，移书劝不回。\n客迎萧寺哭，丧附海舟来。\n瘴雨铭旌暗，空山梵磬哀。\n未知坟上柏，此去几时栽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭常权","author":"刘克庄","text":"曾佐下风山县里，长官贵重若神明。\n行香野寺徐方至，白事琴堂久始迎。\n远递无书悲契阔，老襟有泪怆生平。\n郎君如玉闻先夭，谁护丹旌问去程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭梁运管","author":"刘克庄","text":"忆共游山犹昨日，奄归白昼隔存亡。\n宅深外不知何病，医杂人争试一方。\n吊客伤心同沥酒，爱姬收泪各分香。\n淳熙丞相潭潭府，今日门庭冷似霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭章泉二首 其二","author":"刘克庄","text":"小扉通水竹，幽绝少比邻。\n家似巢栖者，诗非火食人。\n于今无宿士，若昔有先民。\n彊作徵君诔，居然语未亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭章泉二首 其一","author":"刘克庄","text":"自有箪瓢乐，那须璧帛迎。\n后凋仁者寿，独往圣之清。\n古不称千驷，今犹重两生。\n吾衰久无泪，一恸为耆英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭黄直卿寺丞二首 其二","author":"刘克庄","text":"当年出塞共临戎，箭满行营戍火红。\n督府凯旋先请去，坚城筑就独无功。\n身谋彼此皆迂阔，国事中间偶异同。\n莫怪些词含哽噎，在时曾赏小诗工。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭黄直卿寺丞二首 其一","author":"刘克庄","text":"久在文公几杖旁，暮年所得最精详。\n贫甘香火辞符竹，病整衣冠坐箦床。\n壮士军中悲亮死，先师地下惜回亡。\n法云破寺三间屋，却有门人远赴丧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭谭户录二首 其二","author":"刘克庄","text":"胸次有千年，囊中乏一钱。\n客来临旅殡，官为雇归船。\n通德梳新髻，童乌拾旧编。\n伤心邻巷里，废宅锁寒烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭谭户录二首 其一","author":"刘克庄","text":"读过书皆记，非惟善属文。\n有名登进士，无命作参军。\n白发行秋暑，青衫殓瘴云。\n可怜膏火下，虚费一生勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭薛子舒二首 其二","author":"刘克庄","text":"忍死教磨墨，留书诀父兄。\n读来堪下泪，寄去怕伤情。\n墓要师为志，诗于世有名。\n夜阑秋枕上，犹梦共山行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭薛子舒二首 其一","author":"刘克庄","text":"医自金坛至，犹言疾可为。\n濒危人未信，闻死世皆疑。\n友共收残藁，妻能读殓仪。\n借来书册子，掩泪付孤儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭囊山觉初长老 其二","author":"刘克庄","text":"雪峰寺里曾相识，面皱颧高五十馀。\n削发入山参最久，白头出世瘦如初。\n觉心不共真身坏，遗偈犹能战手书。\n何必塔铭并语录，吾诗自可表幽墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭囊山觉初长老 其一","author":"刘克庄","text":"岂谓茶毗速，龛前一怆情。\n空留尊宿貌，难问小师名。\n骨已迎归塔，衣多唱入城。\n百年如此过，何异不曾生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐衣二首 其二","author":"刘克庄","text":"晚持汉藁愧衰迟，先帝恩深解絷维。\n貂映虽无华冕贵，鹑悬差胜缊袍时。\n笥藏尚喜衣裳在，械系方知剑履危。\n画向古贤颜子里，儿童却问此翁谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐衣二首 其一","author":"刘克庄","text":"传来两个诗翁像，吾制冠裳略放他。\n华似庄农加盛服，清于朝士赐香罗。\n儒衣曾有髡钳者，公衮其如跋疐何。\n皂缘黄紽安且吉，不妨藉草更眠莎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐诗","author":"刘克庄","text":"瀛洲学士风流远，中叶唐惭贞观唐。\n灵武拾遗晚羁旅，开元供奉老佯狂。\n戏苕翡翠非伦拟，撼树蚍蜉不揣量。\n赖有元和韩十八，骑麟被发共翱翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐博士祠","author":"刘克庄","text":"博士位尤卑，投名入党碑。\n今观名世作，多在谪官时。\n太史沅湘笔，仪曹永柳诗。\n新祠绵蕞尔，未尽复遗基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏旱","author":"刘克庄","text":"满望梅天雨，谁知日转骄。\n畦蔬新住摘，盆树久停浇。\n米贵粮囷尽，泉乾汲路遥。\n未遑忧世事，灾已到颜瓢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏夜","author":"刘克庄","text":"热极不可度，起行林影中。\n开窗需过月，移簟就来风。\n豪鼠喧深夜，高蝉响半空。\n永言时物变，露已湿莎丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"席间次水村主人韵","author":"刘克庄","text":"游人似蚁磨边旋，惊怪壶中有别天。\n铁画谁如奎画妙，锦湖赛过鉴湖贤。\n悬知星照严光濑，不管江通鲁望田。\n昭代未应无狗监，诵公新作冕旒前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐仲晦以尚书郎召","author":"刘克庄","text":"进立乎朝多惮黯，谊形于色欲烹桑。\n瞻前昔遍参诸老，殿后今留遗嗣皇。\n主圣方当亲上辇，时清未可梦凝香。\n蒲轮定以何时发，耄瞎难占紫气祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐洪二公再和二诗余亦随喜 其四","author":"刘克庄","text":"久愧君恩禄具臣，太仓非有粟陈陈。\n立朝到老羞营窟，避客经年少觌邻。\n鹤夜失鸣犹给料，鱼寒不食已收纶。\n小瓢如玺犹慵佩，何况金龟与玉麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐洪二公再和二诗余亦随喜 其二","author":"刘克庄","text":"龙钟讵可备藩臣，半俸恩深胜在陈。\n熏鼠少曾开北牖，杀牛何必效东邻。\n笺天疏许初还笏，上水船难更掌纶。\n幼读学而浑忘却，岂能歌凤又书麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐洪二公再和二诗余亦随喜 其一","author":"刘克庄","text":"腰臂拘挛倦笏绅，笺天乞得水云身。\n古书一点心源合，时事千茎鬓雪新。\n世重晚香并晚节，史难全传更全人。\n岁寒赖有梅相伴，先向南枝漏泄春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐洪二公再和二诗余亦随喜 其三","author":"刘克庄","text":"松风地籁瀑天绅，下有苔矶著老身。\n僵卧从教茅屋破，放歌不犯玉台新。\n陶元亮可羲皇上，管幼安非汉魏人。\n酒禁近来开一线，霜天便觉满怀春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐潭即事二首 其二","author":"刘克庄","text":"一生常寄人篱落，入手斯丘得自专。\n防墓向来封四尺，骊山何必锢三泉。\n暮年已作饰巾客，它日那无挂剑贤。\n种万株松千本桂，不忧千载不参天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐潭即事二首 其一","author":"刘克庄","text":"不要元戎访草堂，勿烦儿子表泷冈。\n一窗看设囊萤几，四壁惟安梦蝶床。\n聊与僧分半间屋，且无人夺上三房。\n韩公作志潘郎诔，得似先生自举扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐孺子墓","author":"刘克庄","text":"今晓安坟意，梅仙旧廨傍。\n醢成龙不至，罗设凤高翔。\n党锢人俱烬，先生骨尚香。\n小诗拈未出，何以侑椒浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐懋功饷酒用其韵","author":"刘克庄","text":"少时酒伴尽豪雄，岁晚瓶罍一并空。\n方叹独醒吟泽畔，忽勤分饷到篱东。\n鲲鲸有量真溟涬，螟蠃无知妄异同。\n老矣此身何处著，便应埋向醉乡中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭和御制礼记彻章诗","author":"刘克庄","text":"临决遗经自圣衷，固殊野外与淹中。\n五三典礼勤稽古，十六星霜久积功。\n倚席居然惭寡浅，登床安敢紊卑崇。\n防民不在文为末，端系宫庭实践充。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭和御制进读唐鉴彻章诗","author":"刘克庄","text":"考详往事炳蓍龟，精论微言训戒垂。\n度赞元和中兴业，徵开贞观太平基。\n览披贤似铜为鉴，顾问谦然木就规。\n孤远谀儒叨执卷，白头两和缉熙诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭和御制闻喜宴诗","author":"刘克庄","text":"□□□□□□冠，圣世君师自铸颜。\n海运而南六月息，辰居于北众星环。\n宴开镐邑升平际，乐奏钧天缥缈间。\n惭愧微臣蒙特起，羡他先辈夺标还。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32061,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽六二弟二首 其二","author":"刘克庄","text":"向来造诣极深醇，土苴浮名贵重身。\n无愧里中称正士，有辞地下白先人。\n大招谁识三号礼，小敛惟消一幅巾。\n老别亲朋犹作恶，可堪白首哭天伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32062,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽六二弟二首 其一","author":"刘克庄","text":"叹惜三良尽，龙钟一老存。\n瓜稀悲摘蔓，豆泣惜同根。\n梦句空遗恨，连床不践言。\n奈何令杖者，要绖向寒原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32063,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽开国陈寺丞二首 其二","author":"刘克庄","text":"伯也不可作，叔兮犹典刑。\n公车玉堂荐，书室鹤山铭。\n久上通侯印，新营太祝厅。\n衰年亲旧少，吟罢涕先零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32064,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽开国陈寺丞二首 其一","author":"刘克庄","text":"昨御祥琴后，多传吉语通。\n虚令占列宿，不料奏悲风。\n华表孙从祖，生刍婿吊翁。\n九原一无憾，全璧见先公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32065,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽方孚若寺丞二首 其二","author":"刘克庄","text":"斯人讵意掩斯丘，六合茫茫不可求。\n射虎山中如昨日，骑鲸海上忽千秋。\n帝方欲老长沙傅，虏尚能言博望侯。\n回首濑溪溪畔路，跛驴无复从公游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":32066,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]