[{"title":"琼花","author":"释元肇","text":"胜地足繁华，灵根最可嘉。\n人间无别种，后土独开花。\n玉帐三千客，珠帘十万家。\n年年到初夏，来此醉流霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30091,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"芍药","author":"释元肇","text":"旧说扬州有，移来此地栽。\n年年送春后，处处见花开。\n红药还相似，朱颜换不回。\n晴窗添水浸，吟愧谢公才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30092,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水仙","author":"释元肇","text":"仙家遗玉种，岁晚发幽芳。\n露重金杯侧，天寒翠袖长。\n神犹步洛汜，梦不到高唐。\n待得春风觉，游蜂空断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30093,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"凤仙花","author":"释元肇","text":"凤者世难逢，花开瑞亦同。\n九苞元有种，五色自成丛。\n竹实无心食，池光照影中。\n玉箫吹不彻，飞起向秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30094,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"胆瓶蕉","author":"释元肇","text":"解报窗前雨，清声细可听。\n一身都是胆，数叶共生瓶。\n不作抽书样，休寻本草经。\n夏虫犹怕苦，莫敢近青青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30095,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石菖蒲","author":"释元肇","text":"烟雨暝朝昏，龙湫雁荡滨。\n移根来别处，终日伴閒身。\n劲气冲如发，寒芒凛辟尘。\n年年看花者，应笑不曾春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30096,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"金鱼","author":"释元肇","text":"造物真成戏，鳞中亦有殊。\n黄金凡几尾，碧沼自相濡。\n众口安能铄，悬腰但可模。\n多因名色误，不得泳江湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30097,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"移竹","author":"释元肇","text":"南庭多绿竹，移种近西墙。\n远待三年后，阴成一片凉。\n月铺金锁碎，风度玉铿锵。\n定爱常来坐，中间顿石床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30098,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻雁有感","author":"释元肇","text":"秋思堪悲处，江城雁到初。\n先声落羁旅，寒阵过空虚。\n淅淅黄芦际，茫茫碧水馀。\n愁人在沙漠，可有寄来书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30099,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹邻","author":"释元肇","text":"虚怀似此君，所至爱为邻。\n寒影过墙绿，清风无俗尘。\n恐孤栖凤侣，不作钓鱼身。\n昔有吟人癖，移家更苦辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30100,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蝶","author":"释元肇","text":"一捻翅如霜，閒飞宫样黄。\n年年因物化，日日为花忙。\n风雨惊相失，儿童趁欲狂。\n寻常见图画，安得遇滕王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30101,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蜘蛛","author":"释元肇","text":"罗网挂虚檐，将身僻罅潜。\n露含罾眼细，月镂藕丝纤。\n作茧输他巧，飞虫苦被黏。\n静中观节物，能有几时炎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30102,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"茶花","author":"释元肇","text":"茗有花难识，山中采得来。\n试从枝上看，全胜盏中开。\n绿叶微如桂，黄心大似梅。\n晴窗澹相对，能遣睡魔回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30103,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题草书洗兵马","author":"释元肇","text":"诸将收功日，山东平定时。\n妙须怀素笔，草出少陵诗。\n风雨驱驰疾，龙蛇变化宜。\n何当崖石上，见写次山碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30104,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陈圃疏方池","author":"释元肇","text":"细斸苍苔地，东西曲带坡。\n取泥高壅竹，积水旋栽荷。\n明月自先到，清风应更多。\n丁宁安略彴，时复小经过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30105,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大水伤田家","author":"释元肇","text":"沙头秋日黄，烟水白茫茫。\n无处分畦畛，伤时贵秕糠。\n家鹅随野鹜，农父作渔郎。\n禹力成千古，孤吟欲断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30106,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宿福胜寺","author":"释元肇","text":"投宿三十里，过山千万层。\n天寒犹有菊，寺静更无僧。\n掘芋充朝供，寻薪点夜灯。\n望云归未得，惆怅一枝藤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30107,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋下含辉亭","author":"释元肇","text":"秋意足凄冷，归心只自怜。\n乱峰分落照，只雁度遥天。\n拙学千金帚，浮生上水船。\n含晖亭畔月，最好别时圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30108,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪","author":"释元肇","text":"风回急有声，欲住更娉婷。\n顷刻增奇观，依稀得细听。\n空庭禽啄树，吟屋冻生瓶。\n多是邻僧爱，柴扉晚不扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30109,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"庭池","author":"释元肇","text":"窗外空无有，清池瞰屋除。\n去萍嫌碍月，留藻怕惊鱼。\n夜雨知深浅，晨光透碧虚。\n时时来顾影，照见白髭疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30110,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"叠石","author":"释元肇","text":"澄彻池光上，嵷巃相对闲。\n谁将太湖石，叠作小庐山。\n种树蟠春长，栽花带土悭。\n当时真隐者，只在篆烟间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30111,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹院","author":"释元肇","text":"爱竹真成癖，相传子又孙。\n苍寒云翳翳，碧净玉温温。\n月散惊龙化，风喧醒鹤魂。\n几回清不寐，因雪夜开门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30112,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南塔","author":"释元肇","text":"韶光将敛艳，麦野绿成堆。\n庵内人如在，庭前柏自栽。\n炉烟沿石碧，经梵杂风哀。\n诸子知仁孝，逢春好一来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30113,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"海陵道中","author":"释元肇","text":"来往吴陵路，渔樵是切邻。\n雨容轻湿晓，水气暗浮春。\n野雁情如客，汀鸥黠近人。\n梅花篷底见，倍觉有精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30114,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山居","author":"释元肇","text":"山寺偏宜夏，游尘不染苔。\n烟光收迥野，江影上层台。\n竹笋侵崖出，藤花借树开。\n幽禽如解意，飞去又飞来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30115,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋晚庵中","author":"释元肇","text":"江边成独宿，彻夜听吟蛩。\n窗月低残影，客衣寒未重。\n林疏出幽磬，风迥递村舂。\n细采东篱菊，晓云横瘦筇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30116,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"閒居","author":"释元肇","text":"孤云自舒卷，万类各生成。\n迈世有贫士，长年无俗情。\n林塘初雨过，山鸟不时鸣。\n为问沧浪客，何须歌濯缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30117,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和许提干宿平远","author":"释元肇","text":"倾盖话平远，阴阴清昼长。\n沧波没鸥鹭，烟草暗牛羊。\n楼影攲东岭，钟声出上方。\n新诗吟不足，就月屡移床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30118,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病起","author":"释元肇","text":"江皋生远趣，尽日独沈吟。\n雨洗四郊净，云分片地阴。\n黄梅成树落，青稻入村深。\n农事今如许，犹能一散襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30119,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山村初夏","author":"释元肇","text":"麦熟鸟声乐，桑空蚕箔温。\n阴阴傍山路，曲曲抱溪村。\n唤雨鸠夫妇，添林竹子孙。\n牛羊杂樵牧，随月到柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30120,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋","author":"释元肇","text":"今夜中秋月，相看异楚江。\n侵阶如有雪，透屋欲无窗。\n鹊为无枝绕，钟因得句撞。\n不知风露冷，吟到影成双。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30121,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"林酒仙","author":"释元肇","text":"持犯苦相分，陶沈曲糵真。\n世间皆醉梦，师是独醒人。\n难合虚开口，长留坐化身。\n春风过东寺，苔砌落花新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30122,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"腊雪","author":"释元肇","text":"从前知雪意，祇向夜中来。\n光逼鸡窗晓，寒催蝶梦回。\n开门思煮茗，摇树怕伤梅。\n高处偏多积，因高却易隤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30123,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大阅","author":"释元肇","text":"吴宫旧有名，阅武事非轻。\n金鼓从天落，戈鍪照雪明。\n令严云鸟绝，机发鬼神惊。\n士气贾馀勇，归笳奏太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30124,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春雪","author":"释元肇","text":"乾坤公道在，又见雪来苏。\n贵贱皆白屋，高低尽坦涂。\n莫嫌春力浅，犹胜去年无。\n却忆寻芳者，还成访戴图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30125,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送春","author":"释元肇","text":"又送春归去，幽居转寂寥。\n林花皆落尽，鬓雪不曾消。\n明日无三月，愁吟过一宵。\n更添檐外雨，点点在芭蕉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30126,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清明","author":"释元肇","text":"寒食清明节，家家拜扫辰。\n酒杯难醉土，泪眼不知春。\n旧冢连新冢，今人叹昔人。\n路傍无主认，几个石麒麟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30127,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哀通城","author":"释元肇","text":"闻道通城破，伤心不可论。\n隔江三日火，故里几人存。\n哭透青天裂，冤衔白昼昏。\n时逢过来者，恐是梦中魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30128,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"掬泉","author":"释元肇","text":"一坳寒贮玉，非沼又非渠。\n捉月弄清浅，把山摇碧虚。\n久晴应不竭，积雨亦无馀。\n陆羽来题品，他泉定弗如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30129,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"时敬庵","author":"释元肇","text":"主人时孝敬，结屋尉幽灵。\n山近岚生砌，池清月在庭。\n鸟行窥施食，鹤立听看经。\n有客来相过，林扉且莫扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30130,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜坐","author":"释元肇","text":"露坐黄昏后，城居若在村。\n天阴萤火亮，秋近草虫喧。\n老去浑无睡，贫来不闭门。\n也知疏拙甚，此意与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30131,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"七夕","author":"释元肇","text":"年年逢七夕，鹊绕故枝惊。\n天上谁曾会，人间自动情。\n巧云还易散，曲月岂长明。\n大拙无如我，孤吟晓未成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30132,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪中访赵守宗簿","author":"释元肇","text":"终岁掩柴荆，雪中乘兴行。\n水光相莽苍，云意自从横。\n风压孤舟重，烟消野店明。\n休寻戴安道，且访谢宣城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30133,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送赵守寺丞除郎","author":"释元肇","text":"专城不两年，千骑促朝天。\n星宿明前席，江神护奏篇。\n梅开堠亭雪，柳绽御楼烟。\n怅望寒汀晚，芦花一钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30134,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送仲新恩","author":"释元肇","text":"倍喜逢乡老，离家岁月长。\n衣沾新雨露，面带旧风霜。\n云气侵晴槛，泉声入夜堂。\n明朝出山去，后会说重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30135,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送凌佥判","author":"释元肇","text":"江皋秋意足，倚策送君行。\n戍鼓声方断，登楼赋已成。\n野潮漫晓白，乡岫出烟迎。\n只有津亭柳，摇摇系别情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30136,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送孙教授翔父","author":"释元肇","text":"泮宫留不得，廊庙叹才难。\n远送嫌江碍，深思上阁看。\n菊开秋意足，雁到水天寒。\n德释关民社，何须问改官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30137,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄赵东阁","author":"释元肇","text":"与君生己酉，年月日时中。\n除却吟相似，其它事不同。\n梦寒春草绿，天阔莫江空。\n见面知何处，东华踏软红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30138,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"访方蕙岩不值","author":"释元肇","text":"吴城多第宅，毋过蕙岩家。\n不是门如海，都缘刺似麻。\n风声虚动竹，日影渐移花。\n清兴浑无奈，归来自煮茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30139,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和宋松竹","author":"释元肇","text":"保障风寒地，勤劳不问家。\n年来对松竹，客至话桑麻。\n灵运池塘草，玄都观里花。\n打门惊梦起，上苑赐新茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30140,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和方新恩","author":"释元肇","text":"诗礼擅英华，源流奕世家。\n已攀天上桂，不弃道傍麻。\n乌鹊朝来噪，青灯昨夜花。\n惭无报琼句，相对只杯茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30141,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送致政许朝请","author":"释元肇","text":"相遇在东州，相分十五秋。\n挂冠当健日，见子早封侯。\n城外钟寒寺，山阴雪夜舟。\n还经钓台过，不愧客星游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30142,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方蕙岩宅","author":"释元肇","text":"移宅住园中，高怀便不同。\n生涯虽最少，乐地却无穷。\n人记为州日，家传处士风。\n閒来对岩石，坐到夕阳红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30143,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题陈藏一山房","author":"释元肇","text":"浩浩人如海，吟居独可嘉。\n远山长入户，万卷是生涯。\n挂石添名画，分瓶插买花。\n多应市朝客，无暇到君家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30144,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄龟翁史君","author":"释元肇","text":"添藁近方开，传从越上来。\n不曾经道句，真个是仙才。\n禹庙题新在，兰亭到几回。\n莫教儿辈觉，瓜戍恐相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30145,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄项秘监","author":"释元肇","text":"吴中住岁馀，所乐在诗书。\n有句题幽石，无人识借居。\n蓬莱最高处，雅颂正关渠。\n此道能如古，今谁伴直庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30146,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄御史王少卿","author":"释元肇","text":"朝阳有鸣凤，天下喜初闻。\n去棹轻如叶，閒心淡似云。\n杯羹留奉母，一饭不忘君。\n千古濠梁水，流清涤世氛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30147,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和黄东浦早秋韵","author":"释元肇","text":"门径半交莎，幽居事若何。\n地偏人到少，云淡自怡多。\n林杪危凉叶，池容减翠荷。\n翻思种阳艳，终竟不如禾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30148,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄郑司业直院右史","author":"释元肇","text":"由来行所学，最是得时难。\n春草书带绿，东风御柳寒。\n金炉烟喷晓，玉署漏声残。\n献纳丝纶样，流传盛代看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30149,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵竹所书诗卷后","author":"释元肇","text":"江湖三十载，每听说君诗。\n古寺过逢处，寒城欲莫时。\n自看霜落后，唯倚竹相知。\n吟垒惭无律，虚劳为出奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30150,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周伯弜诗送僧至吴","author":"释元肇","text":"周友别多时，湖山翠染衣。\n宦情如纸薄，诗句逐云飞。\n一片孤鸿影，三高钓雪矶。\n只消传此意，知我似君稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30151,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"书薛野鹤水竹稿","author":"释元肇","text":"野性昂如鹤，期君寿合坚。\n虽然传去世，必定得为仙。\n华表千年后，崖铭几字全。\n诗名长不泯，集是石龟编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30152,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送周肖白","author":"释元肇","text":"新年才两日，又见送行人。\n画好难投俗，诗工不疗贫。\n烟深杨柳岸，雨瘦鹭鸶身。\n且莫东归去，京华易得春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30153,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题石瑶林山录","author":"释元肇","text":"天姥紫芝岑，仙灵宅下临。\n幽光千古月，孝德一生心。\n拱木秋声早，寒泉泪滴深。\n彼苍知不远，同聘入书林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30154,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"足庵寄朱新父","author":"释元肇","text":"知机何太蚤，庵以足为题。\n动静关天理，纤洪类物齐。\n鱼游池水满，鸟宿树枝低。\n来往门前客，黄尘没马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30155,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"汤西楼新居","author":"释元肇","text":"闻君移住处，相近太平坊。\n旧日同吟侣，新来认草堂。\n避喧犹未可，在陋亦何妨。\n只有西楼月，清光不改常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30156,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和王郎中韵","author":"释元肇","text":"淮水入吴深，乘流住到今。\n石幢寒日影，铁塔夜风吟。\n举世无知己，惟公识此心。\n朝来惠新作，三叹有馀音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30157,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅山","author":"释元肇","text":"历阳风土秀，清气在梅山。\n自古英灵出，垂名天地间。\n相传司业句，又逐省郎还。\n岁岁春消息，宁忘问故关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30158,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小閤","author":"释元肇","text":"老子小婆娑，装成安乐窝。\n不堪人狭隘，足称自吟哦。\n爱日烘窗煖，承檐听雨多。\n来春在铃下，思治作民和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30159,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吊毛惜惜","author":"释元肇","text":"妓者有毛嫱，高沙骂贼狂。\n一身虽就死，千古不曾亡。\n嗟尔男儿活，羞它冢树傍。\n史应收烈传，祀合御睢阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30160,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓谷","author":"释元肇","text":"长夜何时旦，藏脩只任真。\n惜阴常起早，吹律自生春。\n处处闻啼鸟，声声若应人。\n日高云散后，方始正衣巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":30161,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]