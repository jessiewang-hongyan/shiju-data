[{"title":"赠铁面王说易","author":"马廷鸾","text":"春风吹袂过溪塘，有客来称铁面郎。\n今代贵人甘软媚，可能肮脏倚门墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4293,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠彭瀛洲","author":"马廷鸾","text":"芸香茗供尽清流，十八仙人忆旧游。\n要是山中好风月，年来无梦到瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4294,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕雨中饮客","author":"马廷鸾","text":"羁怀病思不禁秋，又报西风大火流。\n梧叶未凋高树翠，薇花不厌小山幽。\n燕鸿来往书生老，禾黍高低故国愁。\n志士悲秋宁复尔，楼头樽酒漫销忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4295,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七月八夜宿东平精舍","author":"马廷鸾","text":"昨夜双星会鹊桥，好风佳月度今宵。\n天孙晓发银河落，帝昊秋成宝穑饶。\n玉露尚添荷缊藉，金风不惜柳飘飘。\n炉香直为攀髯苦，望断高空正泬寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4296,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"二儿就试","author":"马廷鸾","text":"老病吾今业已衰，已还魏笏尚支颐。\n祝儿指日传金榜，怀我当年别玉墀。\n殿陛详延方吁俊，江湖空旷剧忧时。\n此行蹇谔论邦国，莫为区区杏苑诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4297,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月二十六日甲子","author":"马廷鸾","text":"乘云伤往岁，甲子又今晨。\n莫唱贞元曲，谁为宝庆人。\n早霜明带月，寒菊艳争春。\n敢睨昭陵柏，伪呵有鬼神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4298,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月二十日有感","author":"马廷鸾","text":"精一危微尚赘辞，只须三语好为之。\n风清月白此良夜，雪暗云昏彼一时。\n玉斧照廊开嗣圣，金縢纳册付宫姬。\n思成门外荒荆棘，惆怅何人失令规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4299,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月二十日客有言儒学事感而有赋","author":"马廷鸾","text":"大中之后建隆前，鱼烂瓜分且百年。\n地辟天开崇帝学，河辉斗灿动星躔。\n千龄必反人弘道，一念潜通圣即天。\n叹息斯文今有幸，昭昭奎运岂徒然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4300,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月二十日感旧","author":"马廷鸾","text":"九衢灯火闹嘈嘈，斗柄低昂列宿高。\n漏箭声沉金锁彻，纱笼影避贵官豪。\n乌号望帝穷霄壤，鱼烂遗民沸海涛。\n三百五年风雪夕，孤臣白首卧林皋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4301,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"十月八日有感","author":"马廷鸾","text":"日来天马愤挥戈，直为当年斧画河。\n万炬莲灯照鲸海，一杯麦饭渡滹沱。\n思陵录上哀荣极，德寿宫前耆旧多。\n忍把原碑参叶记，江头石刻懒摩挲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4302,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又题德寿宫古松","author":"马廷鸾","text":"千岁堂堂十八公，雨膏露沐贮清风。\n龙吟高啸长身客，蠹化低摧秃鬓翁。\n谁谓蚍蜉能撼树，不堪蟊贼欲蟠空。\n御香洒酒荒荆棘，肠断孤臣泣寿宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4303,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月初五日先秘阁忌","author":"马廷鸾","text":"鸟啼花落暮春天，一遇斯晨一泫然。\n旧业岂无书可读，遗言犹有石堪传。\n孝思不碍飞遐想，忠愤何由竭报缘。\n庙社已同缨绂尽，尊尧千古忆陈编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4304,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"三月初四夜宿僧庐","author":"马廷鸾","text":"风雨萧萧夜未央，呼童襆被宿僧房。\n无肠可断啼鹃苦，有喙皆鸣吠蛤忙。\n七岁遗孤今老大，百年远忌足悲伤。\n司晨唤起窗全曙，归命清都炷瓣香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4305,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与三儿涉穰田渡车中读朱忠靖中兴事实有感","author":"马廷鸾","text":"骚情长爱重阳近，客路归迟夕照西。\n举目山河秋寂寂，满城风雨晚凄凄。\n老思旧隐盟鸥社，寒涉深流信马蹄。\n凭轼试看炎绍录，空嗟语石与天齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4306,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨遣饷王新班","author":"马廷鸾","text":"舍南舍北水漫漫，乍霁仍阴暖复寒。\n石补色天原有漏，泥污后土不曾乾。\n龙蛇起陆生光怪，鸾凤翀霄怯羽翰。\n聊复盘餐饷桑户，可能藜杖过苏端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4307,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中对紫薇花书感","author":"马廷鸾","text":"轻盈插向胆瓶中，看到山林禁籞同。\n阁下天葩秋月黯，楼头奎画晓云空。\n高攀玉树扶斑白，静扫苍苔拾堕红。\n三十年前天上梦，老来无泪洒西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4308,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五月二十夜记梦","author":"马廷鸾","text":"生来不作浮名计，老去翻惊幽梦奇。\n宫黍不知哀九庙，廷麻犹听拜三师。\n睡昏拟草榻前疏，寤辟疑催牖下期。\n更把在前荣路看，痴翁说梦尽添痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4309,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"双鹤","author":"马廷鸾","text":"荒塘水竭只蹄涔，双鹤翩然啄午阴。\n此纵有鱼应渴死，不濡其咮漫窥临。\n病鸱尚畏泥坑辱，宿鸟常虞矰缴侵。\n何似舂锄甘寂寞，一滩藻荇立清深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4310,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至","author":"马廷鸾","text":"山寒律琯又飞灰，万壑松风冬起雷。\n风景不殊云黯淡，雪霜初霁日徘徊。\n无人献袜抛尘屦，有客传觞酦冻醅。\n天地不教阳德尽，韦编曾叩伏羲来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4311,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北平家传成 其一 编首","author":"马廷鸾","text":"三百年间事屡危，降之人杰岂中衰。\n巍巍祖烈将千岁，赫赫元功彼一时。\n起义堂碑云汉丽，凌烟阁像日星垂。\n藏山自纂前朝史，付与云礽百代知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4312,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北平家传成 其二 辨谤","author":"马廷鸾","text":"选将初年起范阳，和戎晚节误平凉。\n大功宜受春秋责，盛毁何能日月伤。\n文士谈兵多谬误，兰台作史漫裁量。\n折衷自有成书在，公论从知千岁长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4313,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"北平家传成 其三 感事","author":"马廷鸾","text":"彼美人兮无古今，挑灯勘史夜沉沉。\n昌唐无复浯溪颂，哀郢常多楚泽吟。\n麟获自伤王迹息，鹃啼谁念帝魂深。\n祇今莫唱贞元曲，但忆曾闻正始音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4314,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"外孙朱饶归吴兴","author":"马廷鸾","text":"出门一别行千里，闭户归休读五车。\n天路尘冥车服骥，世科墨湿字翻鸦。\n绣绷尚忆春晖报，云舍无令暮霭遮。\n晚岁饰巾吾待尽，高空摩翮汝横斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4315,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"本朝治衰高宗生","author":"马廷鸾","text":"岁逢渊献感炎精，创业中兴二主生。\n天启高皇符艺祖，人将大观拟天成。\n生民厌乱思平治，造物开先毓圣明。\n甲子□□□□亥，试从汉史漫推评。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4316,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"正月四日","author":"马廷鸾","text":"皇厌纷拿五季馀，万兵朝遣暮还都。\n虎头预卜清明旦，鳌足重开混一区。\n天下归仁吾有道，日中为市尔无虞。\n孤臣白首怀佳节，奠桂焚兰泪与俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4317,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"创木行","author":"马廷鸾","text":"矫首昂霄上，刳心泣露馀。\n高门封植旧，暴客斧斤初。\n斲作有瑕玉，创为无用樗。\n终当宿威凤，勿为汝欷歔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4318,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后中秋","author":"马廷鸾","text":"金风吹彻玉箫寒，志士悲秋思万端。\n千古凄凉更馀闰，百年圆缺又重看。\n清辉照胆浑无寐，苍昊催人自鲜欢。\n斗酒属公今夜看，只亏些子莫长叹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4319,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"屺瞻拜墓 其二","author":"马廷鸾","text":"假汝稀年只八年，争教老境不凄然。\n青山慈母已黄壤，绿鬓中男馀白颠。\n天外群鸿随灭没，云间孤鹤自蹁跹。\n共携斗酒浇坟土，衰泪何由滴到泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4320,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"屺瞻拜墓 其一","author":"马廷鸾","text":"老诵劬劳易感伤，一年一度拜金塘。\n食莲正忆慈颜远，毁璧新增苦泪滂。\n松蠹穹林成秃帚，草荒高冢蔽幽篁。\n山哀浦思愁余极，阵阵溪风叶叶黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"屺瞻道中 其二","author":"马廷鸾","text":"波粼粼处浅溪沙，渔屋低迷舴艋家。\n地老天荒原野静，江空岁晚水云赊。\n淤泥日课黄金粟，清泚时吹白浪花。\n漫喜时丰阡陌里，豚蹄行矣祝污邪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"屺瞻道中 其一","author":"马廷鸾","text":"蓐食需明出远村，笋舆咿轧睡昏昏。\n禾麻丰岁云连亩，风露高秋水落痕。\n清晓跨鞍儿从父，当年戏綵母怜孙。\n白头老病松楸隔，一望云飞一断魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次许表兄韵","author":"马廷鸾","text":"物换星移一慨然，天荒地老断鳌前。\n岂无志士王官谷，亦有飞仙太华巅。\n我若加三逢本命，君今过一渐稀年。\n两人中表俱头白，蜀馈才堪几幅笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次吴园亲友韵","author":"马廷鸾","text":"乞得危身百尺竿，冥心晦息掩柴关。\n自寻别墅开荒径，忽见高轩厌辔环。\n海宇泬寥黄鹄举，风涛浩荡白鸥閒。\n剑花落尽长堤圮，叹息英雄隐此山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次张龙山韵反骚","author":"马廷鸾","text":"雪柏霜松自有神，冲风槁叶故难禁。\n云间已閟贞元曲，岁晚谁闻正始音。\n天地有穷归幻化，圣贤无命亦山林。\n愁来又把离骚读，长夜悠悠慷慨吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次费洁堂韵","author":"马廷鸾","text":"谁翻溟渤倒天瓢，大地山河等呴漂。\n九陌扬尘京路暗，一声鸣鵙楚魂招。\n归心猛折湖边柳，活计频寻江上苗。\n回首神皋双泪落，孤烟斜日短长桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次赵二车韵","author":"马廷鸾","text":"世事真如此，劳生何所知。\n功名蚁行磨，意气鹊栖枝。\n于蔿歌偏好，归来赋足师。\n达人宁自苦，天乐更无疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵朱婿实甫见寿","author":"马廷鸾","text":"南华参透解天刑，夜夜心香祷玉衡。\n紫盖十年违帝阙，青山九琐梦云京。\n缁郎宁忍忘天祐，白傅空令羡普明。\n人以寿欢臣以戚，孤怀借酒为浇平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李竹坞怀古","author":"马廷鸾","text":"宝箓炎图未百年，神徂圣伏一凄然。\n徵先生起淹中礼，与老人期圯上编。\n柯烂不惊人换世，瓢空独乐士希贤。\n昌黎愤世犹稽古，难拗何妨只自鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵洁堂五日","author":"马廷鸾","text":"故国天中节，吾侪日暮年。\n愁心菖歜苦，悲绪綵丝牵。\n叠雪虚唐赐，薰风绝舜弦。\n穷山饤越果，醉摘尚凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵洁堂别岁","author":"马廷鸾","text":"月底南枝插屋椽，无人共赏祇凋年。\n我惭王氏青毡旧，君效坡翁白鹤迁。\n小隐未荒存菊径，独清难涴出山泉。\n归时好待春江涨，稳泛轻舟一叶莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老学楼","author":"马廷鸾","text":"元龙高卧仲宣忧，我独丛书置此楼。\n把卷欣将圣贤对，凭栏遮断古今愁。\n山前翠树森云表，林罅青秧匝垄头。\n收拾吟篇供老眼，陈登王粲总悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观鱼车渡溪","author":"马廷鸾","text":"如带溪流拍两崖，投泥贾客竞喧豗。\n只轮自力掀诸淖，断岸先登陟彼嵬。\n江水斗升宁汝活，岸旁车马为渠来。\n老夫自取鲸鲵戮，掩鼻沙丘未足哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过屺瞻墓","author":"马廷鸾","text":"白发苍颜六十三，年年拜母忆中男。\n云归别岫山呈碧，江抱寒汀水染蓝。\n草报春晖天罔极，树随人老我何堪。\n荐馀煮茗清泉供，泪泫馀潸酒不酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"我辈小年端午给假蒲酒奉亲之外日游村田间致足乐也今老矣竹坞老友近馆授徒逢此小熟奉一酌道旧且有感于并汾旧事云","author":"马廷鸾","text":"香罗细葛端阳节，绛帐青衿少小时。\n曩以弹丸俘晋孽，今于筒黍吊湘累。\n千年感旧慵开卷，一酌销忧强把卮。\n蒲酒少年供母后，村南村北恣游嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和许伯脩韵","author":"马廷鸾","text":"秋风孤愤只心知，接得诗筒为色怡。\n句眼独参成佛后，吟肩耸彻欲仙时。\n俗衰竞觅胡奴饱，节在何妨臣朔饥。\n此话只今谁举似，趋时言语正如卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和南塘叔赏芙蓉韵","author":"马廷鸾","text":"自携败册小窗开，三十头颅四十来。\n閒日诗书真足味，薰天富贵只飞灰。\n怜渠每吸醋三斗，输我清馀水一杯。\n何似山翁醉花下，安排笾豆洗樽罍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜病","author":"马廷鸾","text":"幻身危抱十年病，青眼俄成一旦昏。\n夜席何常卧尊者，晨炊不拟饭王孙。\n蜗涎有几春潮涌，鸡唱无凭晓日暾。\n惟有阿枢痴不去，几回惊起问家尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉谢龙山使君","author":"马廷鸾","text":"四美持来野老家，灯前儿女自欢哗。\n匙抄天上神仙饭，瓶插人间富贵花。\n剡雪尚堪书茧纸，吴霜聊欲寄乌纱。\n今朝新雨无人迹，莫向门前几个誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苦雨","author":"马廷鸾","text":"倦夜抛书病不禁，投床无寐雨涔涔。\n长潸旧国山河泪，细滴孤臣禾黍心。\n狂象蹋池喧泞淖，饥鸦谋稻怆淋淫。\n天公老手须斟酌，次第龙分正望霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拜屺瞻墓有感","author":"马廷鸾","text":"我走金塘十五年，新年六十意凄然。\n扶藜策蹇趋庐下，洗盏将雏拜影前。\n蠹化不妨松饮露，凤栖犹拟柏参天。\n微吟缓步沧江晚，一抹青山落照边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拜饯修史大著吏部使浙西","author":"马廷鸾","text":"高怀岂必薄昆崙，揽辔登车意自欣。\n周太史官惭著我，汉常平使喜推君。\n庐山向已高千仞，野水从今宽一分。\n□□鹔鹴裘供□，□□□□更纷纷。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸酉春暮钟信甫寄诗次其韵 其二","author":"马廷鸾","text":"精诚可使岳云开，浊世狂澜挽不回。\n苍狗白衣从物变，青山流水唤人来。\n交游莫作宣明面，气燄终成内史灰。\n我有长波一归艇，枕书春睡兴悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨叹","author":"马廷鸾","text":"夜夜黄昏雨打窗，愁霖久矣晦明阳。\n天公一怒四山黑，田父三吁百亩黄。\n禾黍油油生有耳，芭蕉点点断无肠。\n病身更与儿俱懒，墙角全抛风露凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送文甫兄归番阳二首 其二","author":"马廷鸾","text":"少小追随子佩青，如今相视鬓丝横。\n式相好矣天伦重，归去来兮世念轻。\n目送飞鸿云缥缈，身怜病鹤影伶仃。\n圣恩若许还农亩，依旧山窗共短檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送文甫兄归番阳二首 其一","author":"马廷鸾","text":"白发苍颜老弟兄，累年隔阔话情亲。\n杭京一访且千里，盘祖诸孙才九人。\n扫榻少留深雨夜，著鞭又趁早霜晨。\n曾门有衍诗书泽，为计维垣蜜印新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送朱子式从军","author":"马廷鸾","text":"折镞奇勋在，冲冠怒气深。\n尧天日月大，禹甸曀霾侵。\n塞下将军令，隆中梁甫吟。\n酒行君可起，快展击胡心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送汤东涧出守南剑州 其二","author":"马廷鸾","text":"七聚名藩亦甚都，龙津剑气正扶舆。\n斯文孰是南夫子，此地重逢行秘书。\n忠爱平生在宗社，叹愁肯使到田闾。\n黄花粲粲牵归兴，岁晚江空一怅如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送汤东涧出守南剑州 其一","author":"马廷鸾","text":"掉头不肯住清都，勇趁秋风乞左符。\n大论峥嵘耸廊庙，雅怀磊落胜江湖。\n丹心岂不恋明主，清节还能立懦夫。\n正是商山访鸿鹄，归来羽翼莫踟蹰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送建康知录操襟兄","author":"马廷鸾","text":"虎鞯尚落诸贤后，雁塔谁知几榜前。\n尽向心田宽地步，却将官职信天缘。\n难忘旧日钟山阁，易趁东风上水船。\n王谢诸人英烈在，问今何策可筹边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭进度宗皇帝挽词 其一","author":"马廷鸾","text":"四闰临朝浅，群生被泽深。\n俭勤成禹圣，仁孝本虞心。\n汉殿觞称玉，轩湖鼎铸金。\n龙髯攀不得，清血但盈襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭进度宗皇帝挽词 其二","author":"马廷鸾","text":"道远年何驶，民肥身独癯。\n宝龟传圣子，玉几导宸谟。\n百世尊王度，千秋拱帝图。\n孤臣惭舜辅，愁绝望苍梧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭进理宗皇帝挽词 其五","author":"马廷鸾","text":"尽拜宸奎赐，新编圣训成。\n孙谋方燕翼，龙驭忽遐征。\n四海尧音密，三年舜慕情。\n因山图固在，合应若神明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭进理宗皇帝挽词 其三","author":"马廷鸾","text":"天保惟勤政，春秋有复雠。\n园陵初谒汉，境土合归周。\n连海沧波静，长江兵祲收。\n庚申重立极，功与建隆侔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恭进理宗皇帝挽词 其二","author":"马廷鸾","text":"典学怀终始，熙明四十年。\n立心天地厚，接统帝王前。\n舄奕临雍礼，昭回赞道篇。\n古今惟理大，尊号冠瑶编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]