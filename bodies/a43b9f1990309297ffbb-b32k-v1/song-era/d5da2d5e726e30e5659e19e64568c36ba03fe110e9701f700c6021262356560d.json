[{"title":"送朱叔召归吴中","author":"洪适","text":"长忆吴中鸣橹声，风高月上水波清。\n臞庵掩映花成聚，笠泽微茫烟若城。\n十载相忘存梦想，一帆此去喜归荣。\n老来无复莼鲈会，尚看骅骝得路行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"景孙以妇病稽赏甘尝蟹之约景卢以诗诘之","author":"洪适","text":"郑庄好客底虚声，药裹关心兴未清。\n应恐被围因鲁酒，也防完璧弃秦城。\n双螯弗讲连宵会，千橘谁教满路荣。\n见说高台新断手，何如自索玉杯行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19360,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏景卢","author":"洪适","text":"千橘亭前莫听声，岂无邺酌和汾清。\n轻裾长袖闲列屋，碧瓦朱甍高照城。\n台上金波催夜集，楼边玉树待春荣。\n赏花斫鲙言犹在，还被题舆诮却行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19361,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隆庭竹至四绝句 其一","author":"洪适","text":"忆昨分抄种树书，三荆今古美同株。\n闲将草木供诗戏，待把渔樵足画图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19362,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隆庭竹至四绝句 其二","author":"洪适","text":"竹里巧传幽鸟语，月台高视客星移。\n乡园何幸立分鼎，鸣鼓铿钟乐圣时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19363,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隆庭竹至四绝句 其三","author":"洪适","text":"斑箨远移湘岸种，猫头亦是渭川孙。\n百金得诺今无恨，千亩封侯不在言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19364,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"隆庭竹至四绝句 其四","author":"洪适","text":"装景松篁浑可喜，忘机鸥鹭不相猜。\n南窗情话有时尽，唤取青州从事来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19365,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答景卢久阴遣闷","author":"洪适","text":"几日思君环佩声，方冬天宇未澄清。\n冲寒也到临春阁，处暗如登却月城。\n整顿建瓴愁雨作，商量设醴卜花荣。\n锦囊不用诗排闷，起看朝云亦倦行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19366,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜小隐新得山茶","author":"洪适","text":"芳园封植阅年华，异卉搜求闹小车。\n不羡竹林生石竹，独来茶坞补山茶。\n游人认柿枝头子，归鹤求雌叶底花。\n我去临川寻玉茗，遥将白雪映红霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19367,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答小隐惠山茶","author":"洪适","text":"何处仙官萼绿华，鞭鸾独御五云车。\n来从月窟曾依桂，分种盘洲不碍茶。\n枝耐岁寒犀换叶，蕊藏朝雾锦羞花。\n红颜不逐东君老，须著频来斗脸霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19368,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答小隐闻野处开尊","author":"洪适","text":"遗我双鱼集棣华，尚疑信马误随车。\n丝声自是不如肉，酒薄须知大胜茶。\n翠袖明朝看倚竹，兰灯昨夜报开花。\n饮阑同步曾台月，古堞危亭见绮霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19369,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答小隐喜得白山茶之报","author":"洪适","text":"素质宁嫌潘鬓华，来时应有雪翻车。\n赋传山谷文堆绣，种出麻源韵胜茶。\n不向桂宫藏玉兔，合横蕊观俪琼花。\n冥搜未获诗先作，驻目轻帆溯落霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19370,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"忆东阁手植花木用雍陶过旧宅看花诗韵","author":"洪适","text":"分根徙核望春栽，曲径幽蹊手自开。\n今日成林浑著子，花时不折一枝来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19371,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"玉茗未有耗而小隐作诗以琼花为二绝当专美野处可也","author":"洪适","text":"休论官业出金华，共乐家林鹿挽车。\n何日寻春携漉酒，有时留客试擂茶。\n望梅止渴宁非梦，却月横枝始是花。\n祇恐偏枯惭好句，空教步障锦如霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和景严送方蒂柿","author":"洪适","text":"万株红叶咏光华，嘉实堆盘走绀车。\n方蒂宁同牛奶柿，朱唇应笑鸠盘茶。\n园官急送须足茧，童子争观多眼花。\n罗列林珍生饮兴，讵思辟谷更餐霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答景卢怀旧","author":"洪适","text":"了无梦寐到京华，来往园林整钓车。\n缓步竞移霜后橘，清谈旋碾雨前茶。\n虚名长愧称三凤，旧事休怀判五花。\n共把诗筒销永日，喜君襟韵秀朱霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19374,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"园中观种树","author":"洪适","text":"望中赤叶渍霜华，林下徐行便当车。\n好处见山仍见水，兴来呼酒不呼茶。\n旋移朱橘添卢橘，更拣红花间白花。\n出郭最欣尘事少，饱看孤鹜逐飞霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19375,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答景卢报月台将毕工","author":"洪适","text":"新筑崇台款桂华，凌虚如跨白鸾车。\n西瓜来自余吾水，远物谁询悉里茶。\n不减平泉书草木，更寻南部录烟花。\n落成有约何时讲，舞袖还看举彩霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19376,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答景严咏山居夹道种松","author":"洪适","text":"投黻归来发半华，苍官怪我出无车。\n树当樵径频争席，地接禅房好觅茶。\n要使行人长荫樾，不教侍女独司花。\n十园五鬣它年事，会见摩空薄绛霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19377,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和景卢饯朱叔召往宣城","author":"洪适","text":"与客窥园春未华，也须日昃始回车。\n松间共赏猫头竹，酒半先尝雀舌茶。\n云覆疏棂香起篆，风侵密坐烛吹花。\n双溪叠嶂催行色，佳句重吟绮散霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19378,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答景卢咏道上新松","author":"洪适","text":"落落乔松说九华，远移霜骨想专车。\n沦脂此地能和药，结实殊方却入茶。\n村女拾钗分翠叶，野人敲粉聚黄花。\n翛然一径穷芝岭，晓见飞云夕见霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19379,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和景卢雨中叹","author":"洪适","text":"工徒滞雨望朝华，好倩泥蛮指日车。\n末利怯寒先近火，瑞香蒙润免浇茶。\n莫嫌云暗青油幕，尚恐天开端木花。\n待得严霜变阴翳，便须酌酒赏金霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19380,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和景卢喜晴","author":"洪适","text":"共喜胡尘不乱华，戍边聊出武刚车。\n天公欲遣风催雪，僧舍方疑烟湿茶。\n巡圃观橙无坠叶，隔溪移杏恐伤花。\n举头忽见云间日，急草诗章庆半霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19381,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闽商货千叶牡丹疑其非而却之并怀蓝宪所许","author":"洪适","text":"星文陨石应皇华，鹊语参差雨洗车。\n忽报商人缄苇箧，初疑闽产杂官茶。\n栽培况乃三冬月，真赝难分千叶花。\n宁使双坛且虚左，空吟轻日护香霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19382,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和景卢咏新得歙县牡丹","author":"洪适","text":"旁搜嘉卉对韶华，宝玩明珠诧照车。\n可使东坛无蔓草，如游北苑得名茶。\n安排酿具多炊黍，准拟襟期共赏花。\n醉语美人无可恨，不教拖帔泣归霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19383,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野处送百结花","author":"洪适","text":"盘屈枝仍垫，葱青叶未稀。\n双衔疑凤带，百结类鹑衣。\n弱骨长连锁，轻腰孰解围。\n若教花自在，应作彩云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19384,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野处送金灯花","author":"洪适","text":"银灯未茁有金灯，翠叶森森比剑棱。\n待得花光无断续，却须拈出问邻僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19385,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和景严咏冬开木犀","author":"洪适","text":"桂枝冬更好，浪蕊到今稀。\n雅韵催吟笔，幽香傍舞衣。\n月分千里影，风突百花围。\n倚策山亭暮，寒鸦亦倦飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19386,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和景严约赏木犀","author":"洪适","text":"蔌蔌蟾宫桂，冬开自昔稀。\n犀通一点骨，蜜染六铢衣。\n樽渌拚深酌，炉红渐可围。\n赏花宜卜昼，莫待晚霞飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19387,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜景卢有落成琼楼之约","author":"洪适","text":"地近篮舆便，心清俗事稀。\n檐花琼结佩，窗月练垂衣。\n松竹添三径，溪山豁四围。\n落成歌管集，仰首暗尘飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19388,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和景严咏新得蒲萄","author":"洪适","text":"名传马乳久，物比蚌胎稀。\n高出酴醾架，轻铺薜荔衣。\n孤根临水窟，疏蔓接篱围。\n急酿凉州酒，西园盖欲飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19389,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"得洛中牡丹","author":"洪适","text":"洛花天下选，千里凑三园。\n望岫方缄恨，凭莺忽践言。\n群葩俱退舍，胜日便开尊。\n莫惜诗偿债，真同香返魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19390,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蓝宪所送牡丹道远失时颇多枯槁","author":"洪适","text":"殷勤人有信，惊喜得花饶。\n可惜三冬晚，来从千里遥。\n根荄愆润泽，牙檗顿枯焦。\n傥有更生路，宁辞楚些招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19391,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答景韦赴调还家见寄","author":"洪适","text":"迎归乌鹊竟传声，摆落埃尘襟宇清。\n薪桂岂容留帝阙，幕莲且得近乡城。\n眼边触处梅争破，陌上分行柳向荣。\n如约速来春可探，肩舆须去静中行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19392,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"许倩遣舟送花栽","author":"洪适","text":"双舟十日涉长湖，瓷斛筠篮且百株。\n可喜石榴初变白，更惊玉茗不施朱。\n临风含笑劳花使，映水分行拥木奴。\n装点园林娱杖屦，好来一醉倒金壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19393,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予得圃芝山之麓去春始治畦径名曰山居中为芝榭四楹其秋双芝产于榭南今夏复见四本而盘洲亦有其二因刻诗以志之","author":"洪适","text":"山中曾有采芝仙，此日灵根讵偶然。\n题柱漫将诗纪实，凭栏真共酒忘年。\n英华可是丘园瑞，造化元非雨露偏。\n留与山居作嘉话，未甘草木羡平泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19394,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"双溪堂","author":"洪适","text":"负郭藏嘉处，清溪夹岸流。\n风漪前后起，云态浅深浮。\n入户松横岫，开窗橘满洲。\n心闲身自在，尘事底能留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19395,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舣斋二绝句 其一","author":"洪适","text":"野色山光列画图，坐看渔子入菰蒲。\n恰如放鹢穿三峡，何事航家问五湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19396,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舣斋二绝句 其二","author":"洪适","text":"青翰不动柳阴多，桂棹无声鸟语和。\n有此孤舟寄丘壑，可怜平地起风波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19397,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"侣鸥亭","author":"洪适","text":"憩策新亭上，波光入坐来。\n鱼游能自乐，鸥狎肯相陪。\n风快尘襟豁，云深俗驾回。\n寻盟须日涉，未怕落霞催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19398,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小隐芝草","author":"洪适","text":"芝丛盈百见闻希，不数嘉禾连理枝。\n紫盖堆云光点染，金茎蒙露色凝脂。\n一时竞秀园林胜，十载深藏天地知。\n急办轩楹尊瑞物，泥封诏墨有来期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19399,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"招二弟赏盘洲双头莲","author":"洪适","text":"何须艳质斗鲜妆，并蒂红蕖本自双。\n却恐花飞成造次，急来相就倒银缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19400,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"紫薇花以六月至自溧阳在道已五十日今有花满树因示二弟","author":"洪适","text":"六月炎天千里移，不期繁蕊便盈枝。\n向来浑是西垣客，忆得看花草制时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19401,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日欲为云松之集以病倦而辍","author":"洪适","text":"半秋翻药裹，九日负云松。\n黄菊从他好，清尊不我容。\n零丁怜败叶，旁午羡游蜂。\n今古登临恨，云迷五老峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19402,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"景卢约赏朝天菊不克往","author":"洪适","text":"暮节真无分，头风祇自知。\n朝天虽有菊，向日不如葵。\n久旱千株槁，深秋百草萎。\n吾衰亦相类，饮兴谢东篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19403,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"除夕","author":"洪适","text":"岁尽春虽浅，更长夜亦阑。\n枕边鸡送晓，窗外雁冲寒。\n学圃心常在，筹边力所难。\n老来惊节序，那复问椒盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19404,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"观园人接花","author":"洪适","text":"植杖看园吏，挥斤接果栽。\n夺胎移造化，类我借根荄。\n一似雀为蛤，能令桃作梅。\n天工待人力，信手便春来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19405,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"开岁三日有夜雨屡闻雷声继以大风晨起飞雪已盈积景卢作诗即事次其韵","author":"洪适","text":"旱灾已叹失秋成，春到谁教夏令行。\n风阵骤来收雨脚，雪花未集听雷声。\n阴阳改变才俄顷，冷暖乘除若晦明。\n待向斜川会邻曲，占晴须问蜀君平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19406,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪后游盘洲","author":"洪适","text":"书事斜川日月同，行年过四逼衰翁。\n纵情自洗和陶笔，乘兴谁开访戴蓬。\n梅萼仅存难聚雪，竹根未稳不禁风。\n莫将野趣逢人说，冰上轻鸥西复东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19407,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舣斋观耕","author":"洪适","text":"城下经营二顷田，倒囊不惜买山钱。\n一犁驻目雨初歇，三径藏身地自偏。\n乞米帖来须领略，相牛经在与周旋。\n尝新指拟翻匙雪，旱魃诛夷胜去年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19408,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"景卢新治西园而亭榭未立以诗趣之","author":"洪适","text":"斩新曲径治西园，野色春来已可观。\n便好作亭供客醉，望中流水有时乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答景卢和篇","author":"洪适","text":"致君无术合归田，谁敢贪荣食万钱。\n且对清尊希北海，最欣别墅接西偏。\n转头麦垄龙工往，缓步花蹊蚁磨旋。\n辛苦三农营一饱，莫教牟贼坏丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上元日圃中归","author":"洪适","text":"春风环柳岸，夜雨失沙痕。\n环竹期新笋，移花护旧根。\n身闲贪独乐，舌在戒多言。\n是处无灯火，荒凉一上元。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵梁宪盘洲之集","author":"洪适","text":"轻风吹雨称行春，丘壑装怀我辈人。\n照水轩窗如进艇，穿花旌节屡移轮。\n携壶迭讲三杯酒，挥麈曾无一点尘。\n明日兵厨寻故事，已教园吏拂华茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再和","author":"洪适","text":"于越归来三见春，买山学圃狎渔人。\n非嫌厚禄轻捐印，所畏空餐咏伐轮。\n时运可惊如过隙，人生何苦不同尘。\n明年此会谁重讲，唯把书邮问鼎茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江守置酒盘洲张贰卿两宪及景卢同集时江新兼泉司","author":"洪适","text":"皇华分鼎坐添春，隐雾巢松三散人。\n半月阴云浓似墨，今朝晴日大于轮。\n不辞多酌娱浮蚁，何用清歌落暗尘。\n归去池塘入新梦，句中芳草醉中茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再赋","author":"洪适","text":"到处争持曲米春，阗阗花底凑游人。\n同盟非是新倾盖，巧匠谁云老斲轮。\n倚竹岂无人拾翠，凌波谁想袜生尘。\n后期直待荷花发，欲唤轻裾上舞茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"醉中三用韵","author":"洪适","text":"小车追逐赏光春，花坞行盘走隶人。\n水面落英如濯锦，云心初月未安轮。\n今宵同举盈觞酒，后夜还凝满席尘。\n倒载归时童稚舞，莫教驺哄滓冯茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中排闷","author":"洪适","text":"生怕花飞减却春，半旬苦雨恼幽人。\n山房挂壁有双屐，村径冲泥无只轮。\n但见渌波侵碧草，不须皂荚去黄尘。\n拥炉更甚三冬月，转觉寒威逼坐茵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵梁宪再集盘洲","author":"洪适","text":"春风步屧共优游，小筑园庐匪拙谋。\n罗列清尊资啸傲，安排好语待赓酬。\n茸茸香草装三径，恰恰鸣禽想十洲。\n玉节寻盟端不再，便回天上近凝旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"浮杯","author":"洪适","text":"南北芝泉一涧开，穿花度柳势萦回。\n不须元巳方修禊，才遇良辰便泛杯。\n行止岂由人智巧，沉浮长与客惊猜。\n急流一去谁难进，却有先游殿后来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送吴远泽赴南宫","author":"洪适","text":"文压秋闱揽桂华，一鸣天陛稳乘槎。\n归来须踏盘洲路，要看荷衣醉藕花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九曲有感","author":"洪适","text":"忽忽光阴转，骎骎华发添。\n迹陈三可叹，心赏四难兼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁三日插柳","author":"洪适","text":"欲教垂柳匝池台，寻觅长柯处处栽。\n待得成阴身益老，攀条能有几番来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵梁子正咏棕亭","author":"洪适","text":"鬋得栟榈制数椽，绣衣拈出少陵篇。\n倚楹见水幽情畅，驻屐迷花诗兴牵。\n便觉茅轩俱退舍，若谈竹室不同年。\n满山所欠青青药，且趁流觞集醉仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梁子正有诗谢牡丹及聚仙花次其韵 其一","author":"洪适","text":"天教国色傲春华，不肯争先伍杂花。\n西洛尘埃长太息，名园今属犬羊家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梁子正有诗谢牡丹及聚仙花次其韵 其二","author":"洪适","text":"痴坐林间类守株，一年春事已无馀。\n直须九曲添清涨，洒扫棕亭进一盂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":19425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]