[{"title":"挽兖守程大卿四首 其三","author":"华镇","text":"交游敦久要，赏鉴谢先容。\n自愧非王粲，人惊得蔡邕。\n垩漫犹在刃，舟壑已遗踪。\n不见星躔处，空瞻马鬣封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽兖守程大卿四首 其四","author":"华镇","text":"忆昨湘江上，追风送使帆。\n青云方满路，丹旐忽垂縿。\n燕舞难重见，霞杯不复衔。\n遥怜三径菊，冷落对双岩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿蔡大资留守","author":"华镇","text":"四气成功月，三阳得数辰。\n昴星还辅汉，崧岳复生申。\n事业乘时会，心源体道真。\n燕来新赐第，相贺八千春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽严四府君","author":"华镇","text":"岁事时无失，先畴手自耘。\n克家亲有养，投老意弥勤。\n方羡高年庆，旋惊白日曛。\n可怜坟上土，仍占垄头云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽郑十一府君并夫人","author":"华镇","text":"君子言无玷，夫人德有邻。\n丝桐人世远，窀穸陇头新。\n妆閤闲明镜，吟窗积暗尘。\n西风原上路，鸣铎为悲辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽蒋尊师","author":"华镇","text":"少报羽人衣，年耆道更肥。\n未容青雀至，俄驾白云归。\n海上蟠桃熟，人间晚露稀。\n空留墨妙在，鸾鹤自翻飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽傅仲温","author":"华镇","text":"人是南州老，家传北地雄。\n忽骑箕尾去，不待大丹功。\n华屋闲歌席，长杨惨暮风。\n已符同穴契，宁复念孤桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽冯际道","author":"华镇","text":"令德称乡党，风流有自来。\n能仁曾益寿，善计亦丰财。\n凤羽弥增秀，车门既有开。\n祗怜原上路，松柏莫风哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽周祖文","author":"华镇","text":"蠲辰临远日，祖奠彻中楹。\n寒月铭旌影，霜风晚铎声。\n夜台无晓日，泉路断回程。\n已矣生前事，空劳问代耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽冯户曹","author":"华镇","text":"干禄名虽啬，承家实自肥。\n身全五福美，数过百年稀。\n有裕居清世，何嗟掩夜扉。\n芝兰更盈畹，指日见光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽陈朝奉","author":"华镇","text":"畴昔乡评事，风流出后生。\n早联华萼秀，先得桂枝荣。\n守死尊文墨，持平御重轻。\n已焉休茹恨，三凤伫飞鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽冯通直","author":"华镇","text":"功名早自期，策足有馀赀。\n世路多荆棘，荣途失羽仪。\n素丝宁复理，青眼不胜悲。\n千古秦山路，霜风岁暮时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":55999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽毛夫人","author":"华镇","text":"守义惟贤妇，夫人更妙年。\n纷华人自竞，始卒意弥坚。\n善庆曾无爽，家声既有传。\n秀眉归永夜，无愧及重泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽钟氏夫人","author":"华镇","text":"处号闺房秀，归称内助贤。\n丰华欢壮齿，甘旨庆高年。\n乡誉良人重，家声嗣子传。\n道傍多健羡，宁贵一潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽陈氏夫人","author":"华镇","text":"纯贞谢琢磨，报施竟无讹。\n义守三从固，身膺五福多。\n有言贻綵服，无恨属颓波。\n行路惟称叹，宁悲薤露歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和光道元日书事二首 其一","author":"华镇","text":"芜城池苑尽荒残，春到长思竞秀山。\n谷口风和莺已出，天南日转雁初还。\n千家帘幕峰峦上，百里笙歌水竹间。\n记得当年行乐事，韶光不放片时閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和光道元日书事二首 其二","author":"华镇","text":"急管妖弦朝暮闻，翠帘下应当垆君。\n叫呼枭卢一百万，砍削兕脯三千斤。\n孔座嘉客每日满，杨园细草何须耘。\n夜长秉烛可为乐，春色三分未一分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元丰六年正月二十九日季壬生徐元立以诗来贺用韵酬之","author":"华镇","text":"芳荆堂下两枝长，一本朝来产此旁。\n敢谓他年当似骥，且期今日得如冈。\n顾余已免重占虺，闻子还思待弄璋。\n多谢见贻真锦绣，归时应得衒吾乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"石笋","author":"华镇","text":"小窗西下碧溪隅，片石干云一笋粗。\n苍藓长时斑点露，老藤蟠处节痕纡。\n不须凡木装佳色，自有灵花入画图。\n为美又应胜竹箭，坚高元与众材殊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"养竹诗","author":"华镇","text":"莫笑青青一两茎，春来次第满林生。\n露凝节目犹含粉，风过枝梢已有声。\n拂拭且看霜雪干，剪裁当见凤凰鸣。\n繁枝去尽生微径，几为清阴特地行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和光道春日雨寒","author":"华镇","text":"细风密雨冷相添，天右馀寒势未歼。\n漠漠乱丝凝旷野，涓涓碎玉下重檐。\n凌晨预约阳光发，入夜先闻霰雪兼。\n蝶梦未成攲宝枕，铜壶声咽冻孤蟾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元丰六年二月检田凌塘中马上口占因简德器主簿","author":"华镇","text":"强半春光未足看，花心柳眼尚盘桓。\n景阳不放融怡色，密雨犹矜料峭寒。\n借问董工湮沮洳，何如骑马按冈峦。\n几番回首自惆怅，可借江南一钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈尉见贻二首 其一","author":"华镇","text":"画栋尘惊燕子来，芳郊时雨敛轻埃。\n须怜好景分明在，为把愁颜勉强开。\n仙客有情深赏物，新诗劝我且持杯。\n更言留得花王住，忍放韶光取次回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈尉见贻二首 其二","author":"华镇","text":"燕语莺啼次第新，柳绵花锦曲江滨。\n且将邂逅天涯客，共看芳妍海角春。\n须爱日添随日线，莫教花笑对花人。\n一杯随分休辞诉，况有清歌激绛唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"食樱桃思越中风俗","author":"华镇","text":"答答驱禽欲晓天，筠笼轻摘荐芳筵。\n檀唇深注胭脂紫，琪树匀排火齐圆。\n醇蜜冷和甘益重，小梅青近色增鲜。\n花时南国豪华甚，得尔杯盘更可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56012,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陆彦则郊外初夏送客","author":"华镇","text":"红英落尽紫荷长，野岸阴阴暗绿杨。\n过眼芳菲浑似梦，感时情绪直如狂。\n江皋有客怀双佩，淮上逢人赋乘黄。\n顾我越吟方自苦，可堪别曲念江乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56013,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"槿篱","author":"华镇","text":"移栽野槿密参差，来束乘时作短篱。\n树立已教存大本，弥缝不使去纤枝。\n春残叶暗青云合，秋至花繁锦障垂。\n家似长卿惟壁立，不忧鼠窃夜潜窥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56014,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题共亭","author":"华镇","text":"驾鹤峰前山气佳，炼丹泉上石如排。\n高低檐宇依丛竹，屈曲梯桥跨断厓。\n仙客肯教人世得，贤侯还与郡民偕。\n春风日落歌声散，藓径时时有坠钗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56015,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元老十二丈教授就馆西城因以寄之","author":"华镇","text":"谁教蹇步蹑丹梯，曾是先生振所迷。\n始喜草庐依郡北，旋聆绛帐出城西。\n仪韶久合为虞凤，伏鹄犹劳似鲁鸡。\n却爱春风嘉树下，依然还见旧成蹊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56016,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和光道喜和叔得雨兼呈和叔知县乡兄","author":"华镇","text":"精诚一念格明神，时雨经宵即效珍。\n政属士龙真有誉，颂成吉甫更无伦。\n千畴土脉三冬起，百里根荄一日春。\n自古移风由美化，善良从此在吾民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56017,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送左司董郎中出知汾州三首 其一","author":"华镇","text":"策足年来据要津，渐分符竹寄兵民。\n双旌卷雾辉霜日，驷马骄风蹀路尘。\n魏晋河山元险固，陶唐风俗本深淳。\n铦锋爽鉴清夷旦，报政应须笑鲁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56018,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送左司董郎中出知汾州三首 其二","author":"华镇","text":"少壮同看桂苑春，白头相顾等天伦。\n素风凛凛惊颓俗，高义翛翛媲古人。\n邂逅论情槐棘地，殷勤分袂雪霜晨。\n剖符自是诸侯贵，不学河梁话苦辛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56019,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送左司董郎中出知汾州三首 其三","author":"华镇","text":"养狙有感谁非是，塞马无因自去来。\n人见终军持汉节，世闻郭隗上燕台。\n九门天上云泥隔，三径山阴梦想开。\n青琐黄扉严密地，待看旌旆应时回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56020,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李判官","author":"华镇","text":"卫玉清标未及门，先知和气袭人温。\n言高自有精醇味，手敏曾无洗削痕。\n一捧丝纶来幕府，两迂舟楫过江村。\n已惭无取叨交契，更辱新诗仔细论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56021,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂咏三首 其一","author":"华镇","text":"相逢邂逅典文场，人世机心一笑忘。\n丽藻满籯堆锦绣，清谈终坐击琳琅。\n衣裘不羡公西胜，才术当知贾傅长。\n今日故园聊踯躅，他年要路看腾骧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56022,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂咏三首 其二","author":"华镇","text":"风过依稀听步虚，穿林度水得清都。\n地灵自有烟霞胜，岁久何妨粉墨芜。\n双鹤未归晴昼永，片山长在白云孤。\n无端堑断灵源地，王气宁知属后湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56023,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杂咏三首 其三","author":"华镇","text":"日曝山头土欲焦，全家冒日走岧峣。\n石泉绝涧阶千级，岭路穿云线一条。\n借问裹粮朝历险，何如坦腹夜吹箫。\n□□□□□□□，□□□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56024,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凤凰台","author":"华镇","text":"昔吟太白凤凰诗，此日登临认故墟。\n丹穴好音今寂寞，碧梧秋叶晚萧疏。\n访寻池苑无陈迹，指顾江山似旧书。\n流影逝波何足恨，且听天籁响虚徐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56025,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陪潭倅张朝散江皋观鱼","author":"华镇","text":"通守陈鱼许纵观，旋开芳宴俯江干。\n合围缓觉波心远，数获丰知网目宽。\n何必姬姜当脆板，自多鲂鲤荐雕盘。\n归舟清兴知何限，湘水无风夕月寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56026,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送史道源往宛丘","author":"华镇","text":"与君身世本西东，一席虚斋邂逅同。\n张尉宽衷无巧诋，陶唐遗俗有淳风。\n座中未阁红瑶麈，门外还嘶白玉骢。\n来岁金科新榜上，当看名字冠诸公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56027,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈承事喜雨应祈见贺","author":"华镇","text":"空阶昨夜响淋漓，正是东皋渴雨时。\n蝼蚁未应能有感，乾坤自是本无私。\n已知协气通三壤，想见嘉禾秀两岐。\n更待秋冬高廪后，与君同赋誉尧诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56028,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送湖南提刑安学士 其一","author":"华镇","text":"洞庭六月暑风长，使者征帆挂短樯。\n汲引津途多肉食，追随行路有壶浆。\n南洲自恋涵濡德，北阙方思献纳良。\n更识高门延庆事，綵衣新有桂枝香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56029,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送湖南提刑安学士 其二","author":"华镇","text":"节遇中秋挟日馀，哲人来契梦熊时。\n神澄晓露珠凝彩，气爽秋风桂有枝。\n歌裤始喧清赣曲，使星还照碧湘西。\n太平天子方求旧，但指松椿祝寿祺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56030,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"龙窟寺","author":"华镇","text":"篮舆薄暮下禅扃，贪看松萝气象清。\n未与老僧张榻坐，且携稚子绕廊行。\n小堂烟重镫生晕，远壑风高水有声。\n寂寞卧龙无处问，数声山鸟自飞鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56031,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和纯翁新秋夜雨","author":"华镇","text":"西风吹雨下天涯，还见萧疏八月期。\n筠簟惊秋初冷后，兰缸凝晕未吹时。\n谁人击节悲秋夜，几处停针念所思。\n此景多情吟不尽，何郎底事最先知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56032,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日登戒珠寺","author":"华镇","text":"幽寻兰若已多欢，更踏崇山望远山。\n高阁路馀心未惬，秀岩目尽兴初还。\n陇云凝素晴犹阔，篱菊分金暖尚悭。\n飞盖不须容易去，且偷閒暇笑谈间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56033,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重过高邮丁志高道路","author":"华镇","text":"扁舟平日此东西，屈指于今二十期。\n村落平田添栋宇，人家碧瓦焕茆茨。\n经过自觉风烟好，来往谁知岁月移。\n密柳高槐都似旧，行人双鬓渐成丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56034,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿顾侍郎","author":"华镇","text":"应钟司序两旬时，台座光凝照水湄。\n善庆远归三俊后，哲人来副半千期。\n澄波渺渺韬洪量，乔岳棱棱挺异姿。\n早晚钧衡调燮去，凤池当见老莲龟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56035,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送敏修赴官钜鹿","author":"华镇","text":"蜩鸴悠悠祇可怜，抢榆控地已飘然。\n早闻达识无诸蔽，晚挹清风胜所传。\n会面已欣浑似旧，开怀还肯便忘年。\n渌波碧草芳春日，忍咏江生送别篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56036,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题王氏清轩","author":"华镇","text":"开亭后圃号清轩，非逐豪华效兔园。\n入座馨香惟蕙草，照窗清浅只池源。\n暂来自怪尘埃远，竟日原无鸟雀喧。\n况是绕垣多翠竹，春风次第长龙孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56037,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题明轩","author":"华镇","text":"两楹开处面纯离，题作明轩得事宜。\n计利已居人会地，征商还是日中时。\n平持刀尺无心用，高倚权衡莫我欺。\n达识主人元有大，谁知细故亦无遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56038,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题海鹤","author":"华镇","text":"仙禽西过万年枝，人道飞鸣是路岐。\n几向静中陪振鹭，也曾高处见长离。\n共知天上闻声韵，直羡风前刷羽仪。\n好与便随行缀去，舞韶应自有嘉时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56039,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题西成轩","author":"华镇","text":"华轩闻在了溪东，轩号西成学老农。\n碧玉千峰终日好，黄云万顷几香浓。\n天低每接金仙语，夜迥时闻紫府钟。\n祇恐主人为吏去，春来三径绿苔封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56040,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"用韵谢越帅程给事","author":"华镇","text":"大屏元侯重荐论，自惭蹇浅匪多闻。\n已当壮齿逢清世，敢向南山恋白云。\n宴以笙簧终永日，宠将珠玉焕新文。\n愿凭陶铸冲天去，黄阁门前拜使君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56041,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏呈程民老","author":"华镇","text":"多才是处走华镳，问柳寻花九十朝。\n春去光阴祇恨晚，兴来行路莫知遥。\n谢安携妓情虽远，崔烈为公臭不消。\n应是醉魂伤骀荡，大歌楚些为君招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56042,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙云叟司户宠示佳篇若将以功名相勉者再用韵以呈 其一","author":"华镇","text":"来时春半忽惊秋，思虑关心欲破头。\n符竹徒劳乘绝障，舆图那忍望神州。\n未酬素志终难已，欲问皇天肯断休。\n樽酒且须浇垒块，不须更作畔牢愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56043,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蒙云叟司户宠示佳篇若将以功名相勉者再用韵以呈 其二","author":"华镇","text":"直须富贵在何时，到手杯行且莫辞。\n未放沈酣千日醉，何妨酬唱百篇诗。\n喜看小雨生新润，要使閒愁破两眉。\n景物秋来尽佳句，濡毫会看墨成池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56044,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和都城春雪","author":"华镇","text":"六花飞压九街尘，应讶人间未觉春。\n天上楼台银作屋，云中车辂玉为轮。\n三秋狼戾盈仓兆，万国欢呼击壤辰。\n寂寞袁门烟火冷，未知谁是扣关人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56045,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"病中闻梅已放就邻人求之","author":"华镇","text":"屈指新春只月馀，园梅闻道已盈枝。\n暗香便欲朝三嗅，寒笛愁闻夜一吹。\n病眼未能临翠薄，幽怀还恐失霜枝。\n从君觅取春消息，莫使空吟寄驿诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56046,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和道守曾大夫堂前早梅花","author":"华镇","text":"画堂深处腊前开，应笑孤根庾岭隈。\n不比一枝随驿至，肯愁三弄逐风来。\n华繁素逼窗纱月，香重寒销印篆灰。\n贤守吟看多丽句，清新未羡宛陵梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56047,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梅花一首","author":"华镇","text":"生来幽意酷怜梅，醉眼愁眉见即开。\n案上欲教终日在，林梢令折数枝来。\n轻匀素色欺鱼网，潇洒清香压麝煤。\n一嗅一观情一倍，熙熙不啻上春台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56048,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近日","author":"华镇","text":"近日英雄涉世疏，休言弹铗便乘舆。\n昼操板艇穿沟径，夜爇芦薪阅簿书。\n似此小心纡若绶，何如阔步曳长裾。\n江南若有扁舟便，不待秋风始忆鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"列子观","author":"华镇","text":"日日鸡声马上闻，鉴中不是少年身。\n倦从客路长摇辔，喜得真祠暂拂尘。\n仙驭不归风自好，遗编长诵意弥亲。\n隋珠轻用弹黄雀，愧汝当年辞粟人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"紫薇花","author":"华镇","text":"雨馀庭下紫薇芳，帘幕风清发早凉。\n细叶密攒红縠皱，纤枝交曳彩霞长。\n清都旧许分星号，西掖曾容对省郎。\n怅望日边承露掌，何时相与照秋光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"野岸白莲","author":"华镇","text":"越溪深处楚江湄，玉刻冰裁一两枝。\n天借明蟾滋秀色，云垂清露润丰肌。\n解知洁素风神远，始觉红鲜品格卑。\n何日曲池亭槛上，细看朝暮弄轻飔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":56052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]