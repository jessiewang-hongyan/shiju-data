[{"title":"芗林五十咏 其三十一 梨花原","author":"杨万里","text":"禁火晓未暖，踏青昏恰归。\n何堪一原雪，将冷入春衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芗林五十咏 其四十二 雪台","author":"杨万里","text":"玉树参差出，天花顷刻开。\n先生倚栏处，指点是瑶台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芗林五十咏 其七 寓斋","author":"杨万里","text":"宇宙一行店，谁为店主人。\n主人亦解去，而况爨馀薪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芗林五十咏 其二十五 鹅篆滩","author":"杨万里","text":"不博右军字，且留房相池。\n新雏黄似酒，把酒看群嬉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芗林五十咏 其二十四 羃翠庭","author":"杨万里","text":"软甃琉璃地，生揉翡翠帏。\n莫教星月入，玉镜点金徽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芗林五十咏 其三十九 槐阴墿","author":"杨万里","text":"阴作官街绿，花催举子黄。\n公家有三树，犹带凤池香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芗林五十咏 其十八 碧芦潨","author":"杨万里","text":"春笋肥堪菜，秋花暖可毡。\n何须双野鸭，屏上五湖天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芗林五十咏 其四十四 碧梧垷","author":"杨万里","text":"往往游西崦，时时憩午阴。\n凤来人不见，飞入碧枝深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芗林五十咏 其十 醉石","author":"杨万里","text":"晚酌居然醉，昏昏不自持。\n奇哉苍玉枕，眠到月来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行圃","author":"杨万里","text":"薤本新痕割复齐，豆苗初叶合仍离。\n莺声政好还飞去，不为诗人更许时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行圃二首 其二","author":"杨万里","text":"澹天薄日倦春游，苍桧丛篁引径幽。\n忽有小风人未觉，荠花无数总摇头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行圃二首 其一","author":"杨万里","text":"摘杞搜枯梗，攀花脱脆包。\n蝶呈新样粉，柳送隔城梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行部决狱宿新隆寺观邹至完题壁","author":"杨万里","text":"道乡千古一清风，雪壁银钩墨尚浓。\n若爱殿前苍玉佩，断无身后碧纱笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行阙养种园千叶杏花二首 其二","author":"杨万里","text":"白白红红两不真，重重叠叠是精神。\n谁言跂石眠云客，也见长杨五柞春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"行阙养种园千叶杏花二首 其一","author":"杨万里","text":"不信东皇也有私，如何偏宠杏花枝。\n于中更出红千叶，且道此花奇不奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园早梅二首 其一","author":"杨万里","text":"已刻酥花趁腊前，更团蜡糁等春妍。\n不知天巧能多少，一朵梅花占两年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园晚步二首 其二","author":"杨万里","text":"为爱荷池日日来，一来一度眼双开。\n画船不晓风相戏，猛触花堤得倒回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西园晚步二首 其一","author":"杨万里","text":"龙眼初如菉豆肥，荔枝已似佛螺儿。\n南荒北客难将息，最是残春首夏时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西斋睡起","author":"杨万里","text":"小睡西斋听雨凉，竹鸡声里梦难长。\n开门山色都争入，只放青苍一册方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西湖晚归","author":"杨万里","text":"际晚游人也合归，画船犹自弄斜晖。\n西湖两岸千株柳，絮不因风暖自飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观田中鸲鹆啄粟因悟象耕鸟耘之说戏题二首 其二","author":"杨万里","text":"粟黄荞白未全秋，谁报乌衣早作偷。\n只在林梢筑仓廪，便知去处若为搜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观田中鸲鹆啄粟因悟象耕鸟耘之说戏题二首 其一","author":"杨万里","text":"乌衣缁布外无华，白锦中单分外嘉。\n只么跳行人不觉，忽然飞起自成花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观汤田铺溪边汤泉","author":"杨万里","text":"下泓堪浴上堪煎，阴火熬成未必然。\n海底日升波自沸，偶分一眼作汤泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观陂水","author":"杨万里","text":"波缓沤迟似让行，忽然赴壑怒还生。\n东归到底谁先后，何用争流作许声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观蚁二首 其二","author":"杨万里","text":"一骑初来只又双，全军突出阵成行。\n策勋急报千夫长，渡水还争一苇杭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观蚁二首 其一","author":"杨万里","text":"偶尔相逢细问途，不知何事数迁居。\n微躯所馔能多少，一猎归来满后车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观荷上雨","author":"杨万里","text":"细雨沾荷散玉尘，聚成颗颗小珠新。\n跳来跳去还收去，祇有琼柈弄水银。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观棋感兴","author":"杨万里","text":"本是输棋强作赢，看来终与好棋争。\n君看国手无双底，何用旁人救败兵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"观稼","author":"杨万里","text":"三年再旱独堪闻，一熟诸村稍作欣。\n老子朝朝弄田水，眼看翠浪作黄云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访周仲觉夜宿南岭月色粲然晓起路湿闻有夜雨","author":"杨万里","text":"夜晴那得晓来泥，才见金钲浴绀池。\n一阵五更松上雨，元来睡著不曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"访蓬莱老人","author":"杨万里","text":"不到蓬莱又几时，凉花渐盛暑花稀。\n我来不是忘归去，忘却来时况道归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过八尺遇雨三首 其三","author":"杨万里","text":"细雨无声忽有声，乱珠跳作万银钉。\n呼僮速买庉村酒，更煮鲈鱼莼菜羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过八尺遇雨三首 其二","author":"杨万里","text":"去年今日凤山头，儿女团栾争劝酬。\n不及松江烟雨里，独搔华发一扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过八尺遇雨三首 其一","author":"杨万里","text":"垂虹登了劣归船，又复毛空暗水天。\n节里无多好天色，阑风长雨饯残年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过三衢徐载叔采菊载酒夜酌走笔二首 其二","author":"杨万里","text":"疾风动地雨倾荷，一事商量君信么。\n试问糟床与檐溜，雨声何似酒声多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过三衢徐载叔采菊载酒夜酌走笔二首 其一","author":"杨万里","text":"征涂半月客尘黄，今夕初逢一雨凉。\n冷笑菊花堪计会，为君八月作重阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过上湖","author":"杨万里","text":"上湖名是实全非，只合松江雁鹜池。\n若与五湖通谱系，澹台湖弟太湖儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过上湖岭望招贤江南北山四首 其四","author":"杨万里","text":"晓日秋山破格奇，青红明灭舞清漪。\n画工著色饶渠巧，便有此容无此姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过上湖岭望招贤江南北山四首 其三","author":"杨万里","text":"一水横拖两岸峰，千痕万摺碧重重。\n谁言老子经行处，身在江山障子中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过上湖岭望招贤江南北山四首 其二","author":"杨万里","text":"岭下看山似伏涛，见人上岭旋争豪。\n一登一陟一回顾，我脚高时他更高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过上湖岭望招贤江南北山四首 其一","author":"杨万里","text":"远山高绝近山低，未必低山肯下伊。\n定是远山矜狡狯，跳青涌碧角幽奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过下梅","author":"杨万里","text":"不特山盘水亦回，溪山信美暇徘徊。\n行人自趁斜阳急，关得归鸦更苦催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过丫头岩","author":"杨万里","text":"告老身心日互催，又将乌帽点黄埃。\n丫头岩下来仍往，四十三年十二回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过大皋渡","author":"杨万里","text":"隔岸横州十里青，黄牛无数放春晴。\n船行非与牛相背，何事黄牛却倒行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过广济圩三首 其三","author":"杨万里","text":"桑畴一眼郁金黄，麦垄千机绿锦坊。\n诗卷且留灯下看，轿中只好看春光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过广济圩三首 其二","author":"杨万里","text":"两渠水夹一堤宽，个是东皇大御园。\n旋插绿杨能几日，新枝已自不胜繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过广济圩三首 其一","author":"杨万里","text":"圩田岁岁镇逢秋，圩户家家不识愁。\n夹路垂杨一千里，风流国是太平州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过乌石大小二浪滩俗呼浪为郎因戏作竹枝歌二首 其二","author":"杨万里","text":"小郎滩下大郎滩，伯仲分司水府关。\n谁为行媒教作赘，大姑山与小姑山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过乌石大小二浪滩俗呼浪为郎因戏作竹枝歌二首 其一","author":"杨万里","text":"滩声十里响千鼙，跃雪跳霜入眼奇。\n记得年时上滩苦，如今也有下滩时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过五里径三首 其三","author":"杨万里","text":"入山无路出无门，鸟语猿声更断魂。\n当处迷涂何处问，一溪引我得前村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过五里径三首 其二","author":"杨万里","text":"野水奔流不小停，知渠何事太忙生。\n也无一个人催促，自爱争先落涧声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过五里径三首 其一","author":"杨万里","text":"瘦日当中暖稍回，冷山未许瘴全开。\n溪光远隔深深竹，特地穿帘入轿来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过双陂","author":"杨万里","text":"霜后寒溪清更清，冰如溪水水如冰。\n闲行也有穷忙事，问讯梅花开未曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过水车铺二首 其二","author":"杨万里","text":"轿里看书得昼眠，梦中惊浪撼渔船。\n觉来书卷风吹乱，忘却前篇与后篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过水车铺二首 其一","author":"杨万里","text":"尽日涂中断客行，两边山色到云青。\n溪光摇碎黄金日，波面跳成白玉星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过长峰径遇雨遣闷十绝句 其四","author":"杨万里","text":"石上菖蒲铁作须，寸根九节许清臞。\n安期自是参渠底，却重安期不重渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过长峰径遇雨遣闷十绝句 其八","author":"杨万里","text":"下到危坡斗处泥，旁临崩岸仄边溪。\n不须杜句能驱疟，只诵长峰遣闷诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过长峰径遇雨遣闷十绝句 其二","author":"杨万里","text":"百里如何一日行，晴天犹自急追程。\n山云管得侬愁雨，强做催诗数点声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过长峰径遇雨遣闷十绝句 其五","author":"杨万里","text":"一眼空山空复空，欹芦倒荻雨和风。\n却缘小队旌旗过，教得青枫学著红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过长峰径遇雨遣闷十绝句 其三","author":"杨万里","text":"野炊未到也饥嗔，到得炊边却可人。\n伞作旅亭泥处坐，水漂地灶雨中薪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过长峰径遇雨遣闷十绝句 其六","author":"杨万里","text":"何须人迹到来曾，点污松风涧水声。\n不是先生爱山水，是间却遣阿谁行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过长峰径遇雨遣闷十绝句 其十","author":"杨万里","text":"鳅是虾兄非善地，橘和瓣种带禳灾。\n乌椑不熟还无事，小艇难乘莫载来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过长峰径遇雨遣闷十绝句 其七","author":"杨万里","text":"猿藤陂子枉惊吁，未抵长峰小半涂。\n今夕前头何许宿，不知出得径来无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过长峰径遇雨遣闷十绝句 其一","author":"杨万里","text":"说著长峰十日愁，夜来发处四更头。\n莫令炬火风吹黑，未说红纱绛蜡休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过长峰径遇雨遣闷十绝句 其九","author":"杨万里","text":"出得山来未见村，已知村近稍多田。\n坐看云脚都垂地，回望峰头已入天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过乐平县","author":"杨万里","text":"笋蕨都无且则休，菜无半叶也堪羞。\n满城都卖雪花荠，昨日愁人未是愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过玉山东三塘五首 其五","author":"杨万里","text":"缲车香里过征衫，白茧黄丝两两三。\n不是秋风上饶路，一生不信有冰蚕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过玉山东三塘五首 其四","author":"杨万里","text":"身行衢信两中间，夹路尖峰面面寒。\n只道秋山似春笋，不知春笋似秋山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过玉山东三塘五首 其三","author":"杨万里","text":"赤日中涂绿树阴，肯将碧伞借行人。\n片云忽在树头上，失却勋劳庇得身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过玉山东三塘五首 其二","author":"杨万里","text":"远峰隔水醒人心，一半斜阳一半阴。\n仙子更衣晚妆束，紫茸领子翠毛衿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过玉山东三塘五首 其一","author":"杨万里","text":"笋舆拾得小凉天，旋与开窗急捲帘。\n十里轻云阁秋日，日光移在远峰尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过白沙竹枝歌六首 其六","author":"杨万里","text":"绝壁临江千尺馀，上头一径过肩舆。\n舟人仰看胆俱破，为问行人知得无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过白沙竹枝歌六首 其五","author":"杨万里","text":"昨日下滩风打头，羡他上水似轻鸥。\n朝来上水帆都卸，真个轻鸥也自愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过白沙竹枝歌六首 其四","author":"杨万里","text":"东沿西溯浙江津，去去来来暮复晨。\n上岸牵樯推稚子，隔船招手认乡人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过白沙竹枝歌六首 其三","author":"杨万里","text":"绝怜山崦两三家，不种香粳只种麻。\n耕遍沿堤锄遍岭，都来能得几生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过白沙竹枝歌六首 其二","author":"杨万里","text":"田亩浑无寸尺强，真成水国更山乡。\n夹江黄去堤堤粟，一望青来谷谷桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过白沙竹枝歌六首 其一","author":"杨万里","text":"穹崖绝嶂入云天，乌鹊才飞半壁间。\n远渚长汀草如积，牛羊须上最高山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过石塘","author":"杨万里","text":"万石中通一线流，千盘百折过孤舟。\n滩头未下人犹笑，下了滩头始觉愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":67201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]