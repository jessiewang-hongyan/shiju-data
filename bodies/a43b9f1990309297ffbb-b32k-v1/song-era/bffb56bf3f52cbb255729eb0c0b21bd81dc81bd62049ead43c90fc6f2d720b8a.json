sv","pointer":29710,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午帖子 皇帝閤六首 其二","author":"欧阳修","text":"綵索盘中结，杨梅粽里红。\n宫闱九重乐，风俗万方同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29711,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午帖子 皇帝閤六首 其一","author":"欧阳修","text":"天容清永昼，风色秀含薰。\n五日逢佳节，千龄奉圣君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29712,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午帖子 温成閤四首 其三","author":"欧阳修","text":"闻说仙家事杳微，世传真伪岂能知。\n遥思海上三山乐，宁记人间五日时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29713,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午帖子 温成閤四首 其二","author":"欧阳修","text":"珠箔凉飔入，金壶昼刻长。\n鸾台尘不动，销尽故时香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29714,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"端午帖子 温成閤四首 其一","author":"欧阳修","text":"香黍筒为粽，灵苗艾作人。\n芳音邈已远，节物自常新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29715,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霁后看雪走笔呈元珍判官二首 其二","author":"欧阳修","text":"嘉景无人把酒看，县楼终日独凭栏。\n山城岁暮惊时节，已作春风料峭寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29716,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"霁后看雪走笔呈元珍判官二首 其一","author":"欧阳修","text":"江上寒山祗对门，野花岩草共嶙峋。\n独吟群玉峰前景，闲忆红莲幕下人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29717,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题东阁后集","author":"欧阳修","text":"东閤三朝多大事，营丘二载足闲辞。\n近诗留作归荣集，何日归田自集诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29718,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题荐严院","author":"欧阳修","text":"那堪多难百忧攻，三十衰容一病翁。\n却把西都看花眼，断肠来此哭东风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29719,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹤","author":"欧阳修","text":"樊笼毛羽日低摧，野水长松眼暂开。\n万里秋风天外意，日斜闲啄岸边苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29720,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"樵者","author":"欧阳修","text":"云际依依认旧林，断崖荒磴路难寻。\n西山望见朝来雨，南涧归时渡处深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29721,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠庐山僧居讷","author":"欧阳修","text":"方瞳如水衲披肩，邂逅相逢为洒然。\n五百僧中得一士，始知林下有遗贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29722,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠歌者","author":"欧阳修","text":"病客多年掩绿樽，今宵为尔一颜醺。\n可怜玉树庭花后，又向江都月下闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29723,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠潘道士","author":"欧阳修","text":"门无车辙紫苔侵，鸡犬萧条陋巷深。\n寄语弹琴潘道士，雨中寻得越江吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29724,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹭鸶","author":"欧阳修","text":"激石滩声如战鼓，翻天浪色似银山。\n滩惊浪打风兼雨，独立亭亭意愈闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29725,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鹭鸶","author":"欧阳修","text":"风格孤高尘外物，性情闲暇水边身。\n尽日独行溪浅处，青苔白石见纤鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29726,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鷤䳏","author":"欧阳修","text":"花残如霰落纷纷，紫陌空遗翠幰尘。\n鷤䳏枉缘催节物，年华不信有伤春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29727,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七言二首答黎教授 其一","author":"欧阳修","text":"拨瓮浮醅新酿熟，得霜寒菊始开齐。\n养丹道士颜如玉，爱酒山公醉似泥。\n不惜蕊从蜂采去，尚馀香有蝶来栖。\n莫嫌学舍官闲冷，犹得芳樽此共携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29728,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又行次作","author":"欧阳修","text":"秋色满郊原，人行禾黍间。\n雉飞横断涧，烧响入空山。\n野水苍烟起，平林夕鸟还。\n嵩岚久不见，寒碧更孱颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29729,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又和","author":"欧阳修","text":"凭高寓目偶乘闲，袨服游人见往还。\n明月正临双阙上，行歌遥听九衢间。\n黄金络马追朱幰，红烛笼纱照玉颜。\n与世渐疏嗟老矣，佳辰乐事岂相关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29730,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"三日赴宴口占","author":"欧阳修","text":"赐饮初逢禊节佳，昆池新涨碧无涯。\n九门寒食多游骑，三月春阴正养花。\n共喜流觞修故事，自怜双鬓惜年华。\n凤城残照归鞍晚，禁籞无风柳自斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29731,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"下牢津","author":"欧阳修","text":"依依下牢口，古戍郁嵯峨。\n入峡江渐曲，转滩山更多。\n白沙飞白鸟，青障合青萝。\n迁客初经此，愁词作楚歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29732,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"下直","author":"欧阳修","text":"宫柳街槐绿未齐，春阴不解宿云低。\n轻寒漠漠侵驼褐，小雨班班作燕泥。\n报国无功嗟已老，归田有约一何稽。\n终当自驾柴车去，独结茅庐颍水西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29733,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与谢三学士唱和八首 和游午桥庄","author":"欧阳修","text":"晓坛初毕祀，弭盖共寻幽。\n鸟哢林中出，泉声冰下流。\n攀条惊雪尽，翻袂爱风柔。\n好驻城南马，春桑遍陌头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29734,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与谢三学士唱和八首 昨日偶陪后骑同适近郊谨成七言四韵兼呈圣俞","author":"欧阳修","text":"堤柳才黄已落梅，寻芳弭盖共徘徊。\n桑城日暖蚕催浴，麦垄风和雉应媒。\n别浦人嬉遗翠羽，弋林春废锁歌台。\n归鞍暮逼宫街鼓，府吏应惊便面回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29735,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与谢三学士唱和八首 除夜偶成拜上学士三丈","author":"欧阳修","text":"万瓦青烟夕霭生，斗杓迎岁转东城。\n隋宫守夜沈香燎，楚俗驱神爆竹声。\n玉树罗阶家宴盛，羽觞称寿綵衣荣。\n九门朝客思公甚，向晓天风舞雪霙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29736,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与谢三学士唱和八首 陪饮上林院后亭见樱桃花悉已披谢因成七言四韵","author":"欧阳修","text":"寻芳长恨见花迟，岂意看花独后期。\n试藉落英聊共醉，为怜残萼更攀枝。\n清香肯以无人减，幽艳惟应有蝶知。\n开谢两堪成怅望，伤春不到柳丝时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29737,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久在病告近方赴直偶成拙诗二首 其二","author":"欧阳修","text":"清晨下直大明宫，驰马悠然宿露中。\n金阙云开沧海日，天街雨后绿槐风。\n岁华忽忽双流矢，鬓发萧萧一病翁。\n名在玉堂归未得，西山画阁兴何穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29738,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"久在病告近方赴直偶成拙诗二首 其一","author":"欧阳修","text":"经时移病久端居，玉署新秋独直庐。\n夜静楼台落银汉，人闲铃索少文书。\n江湖未去年华晚，烟火微凉暑雨初。\n敢向圣朝辞宠禄，多惭禁禦养慷疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29739,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夕照","author":"欧阳修","text":"夕照留歌扇，馀辉上桂丛。\n霞光晴散锦，雨气晚成虹。\n燕下翻池草，乌惊傍井桐。\n无憀照湘水，丹色映秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29740,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"子华学士儤直未满遽出馆伴病夫遂当轮宿辄成拙句奉呈","author":"欧阳修","text":"万钉宝带烂腰镮，赐宴新陪一笑欢。\n金马并游年最少，玉堂初直夜犹寒。\n自嗟零落凋颜鬓，晚得飞翔接羽翰。\n今日遽闻催递宿，不容多病养衰残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29741,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小圃","author":"欧阳修","text":"桂树鸳鸯起，兰苕翡翠翔。\n风高丝引絮，雨罢叶生光。\n蝶粉花沾紫，蜂茸露湿黄。\n愁酲与消渴，容易为春伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29742,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庆爱寺","author":"欧阳修","text":"都人布金地，绀宇岿然存。\n山气蒸经阁，钟声出国门。\n老杉春自绿，古壁雨先昏。\n应有幽人屐，来留石藓痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29743,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书王元之画像侧","author":"欧阳修","text":"偶然来继前贤迹，信矣皆如昔日言。\n诸县丰登少公事，一家饱暖荷君恩。\n想公风采常如在，顾我文章不足论。\n名姓已光青史上，壁间容貌任尘昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29744,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"公子","author":"欧阳修","text":"黄山开苑猎初回，绛树分行舞递来。\n下马春场鸡斗距，鸣弦初日雉惊媒。\n犀投博齿呼成白，桥隔车音听似雷。\n不问春蚕眠未起，更寻桑陌到秦台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29745,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"内直对月寄子华舍人持国廷评","author":"欧阳修","text":"禁署沉沉玉漏传，月华云表溢金盘。\n纤埃不隔光初满，万物无声夜向阑。\n莲烛烧残愁梦断，蕙炉薰歇觉衣单。\n水精宫锁黄金阙，故比人间分外寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29746,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"内直奉寄圣俞博士","author":"欧阳修","text":"千门钥入断人声，楼阁沉沉夜气生。\n独直偏知宫漏永，稍寒尤觉玉堂清。\n霜云映月鳞鳞色，风叶飞空摵摵鸣。\n犬马力疲恩未报，坐惊时节已峥嵘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29747,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"内直晨出便赴奉慈斋宫马上口占","author":"欧阳修","text":"凌晨更直九门开，驱马悠悠望禁街。\n霜后楼台明晓日，天寒烟雾著宫櫰。\n山林未去犹贪宠，樽酒何时共放怀。\n已觉萧条悲晚岁，更怜衰病怯清斋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29748,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太清宫烧香","author":"欧阳修","text":"清晨琳阙耸巑岏，弭节斋坊暂整冠。\n玉案拜时香袅袅，画廊行处佩珊珊。\n坛场夜雨苍苔古，楼殿春风碧瓦寒。\n我是蓬莱宫学士，朝真便合列仙官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29749,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太傅杜相公有答兖州待制之句其卒章云独无风雅可流传因辄成","author":"欧阳修","text":"南都已见成新集，东鲁休嗟未作诗。\n霖雨曾为天下福，甘棠何止郡人思。\n元刘事业时无取，姚宋篇章世不知。\n二美惟公所兼有，后生何者欲攀追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29750,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太傅杜相公索聚星堂诗谨成","author":"欧阳修","text":"楚肆固知难衒玉，丘门安敢辄论诗。\n藏之十袭真无用，报以双金岂所宜。\n已恨语言多猥冗，况因杯杓正淋漓。\n愿投几格资咍噱，欲展须于欲睡时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":29751,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]