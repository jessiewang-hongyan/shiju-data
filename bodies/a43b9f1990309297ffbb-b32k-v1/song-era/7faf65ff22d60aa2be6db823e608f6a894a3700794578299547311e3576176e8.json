[{"title":"句 其十七","author":"王禹称","text":"先帝升遐日，词臣寓直时。\n柩前书顾命，笔下定鸿基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再赋二章一以颂高人之风一以伸俗吏之意 其一","author":"王禹称","text":"表让皇家买酒钱，醉乡归去便陶然。\n吾君若问徵君意，自有东皋种黍田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再赋二章一以颂高人之风一以伸俗吏之意 其二","author":"王禹称","text":"不应明时鹄板书，可能终老傲唐虞。\n神仙见说须阴德，肯为苍生一出无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后土庙琼花诗　 其二","author":"王禹称","text":"春冰薄薄压枝柯，分与清香是月娥。\n忽似暑天深涧底，老松擎雪白娑婆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"后土庙琼花诗　 其一","author":"王禹称","text":"谁移琪树下仙乡，二月轻冰八月霜。\n若使寿阳公主在，自当羞见落梅妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏从丰阳喻长官觅笋","author":"王禹称","text":"春来春笋满丰阳，祇把盘餐劝孟光。\n犀角锦文虽可惜，也须分惠紫微郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏赠嘉兴朱宰同年","author":"王禹称","text":"县前苏小旧荒坟，应作行云入梦频。\n犹胜白公尉盩厔，庭花刚唤作夫人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"朱红牡丹","author":"王禹称","text":"渥丹容貌著霓裾，何事僧轩祇一株。\n应是吴宫歌舞罢，西施因醉误施朱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池边菊","author":"王禹称","text":"绿池绕径几千栽，准拟登高泛酒杯。\n未到重阳归阙去，金英寂寞为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"自嘲","author":"王禹称","text":"三月降霜花木死，九秋飞雪麦禾灾。\n虫蝗水旱霖淫雨，尽逐商山副使来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芍药花开忆牡丹绝句","author":"王禹称","text":"风雨无情落牡丹，翻阶红药满朱栏。\n明皇幸蜀杨妃死，纵有嫔嫱不喜看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"问四皓","author":"王禹称","text":"四冢累累岂是仙，避秦安汉道空全。\n紫芝探处应辛苦，何似腰金食万钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初入山闻提壶鸟","author":"王禹称","text":"迁客由来长合醉，不烦幽鸟道提壶。\n商州未是无人境，一路山村有酒沽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初拜拾遗游琼林苑","author":"王禹称","text":"开宴曾游此缀行，五年为吏别仙乡。\n杏园莺蝶如相识，应怪重来茜绶香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别丹水","author":"王禹称","text":"曾经烂漫濯吾缨，忍别潺湲月下声。\n便入红尘染诗思，吟魂犹合数年清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别仙娥峰","author":"王禹称","text":"商山留滞再经春，吟爱仙娥最出群。\n若有精灵念迁客，暂来河北作行云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别北窗竹","author":"王禹称","text":"满窗疏韵伴吟声，别夜犹怜枕簟清。\n见说解梁难种植，此君相别若为情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别四皓庙","author":"王禹称","text":"明朝欲别采芝翁，吟绕阶前苦竹丛。\n贬谪入山非美退，此中争敢逐冥鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别商山量移解州作","author":"王禹称","text":"欲辞苍翠入尘嚣，把酒看山思寂寥。\n莫动移文苦相责，解梁闻说近中条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"别堂后海棠","author":"王禹称","text":"一堆红雪媚青春，惜别须教泪满巾。\n好在明年莫憔悴，校书兼是爱花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听泉","author":"王禹称","text":"平生诗句多山水，谪宦谁知是胜游。\n南下阌乡三百里，泉声相送到商州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿宁节祝圣寿 其一","author":"王禹称","text":"待漏齐趋圣节筵，云开金阙上青天。\n平明引入长生殿，共祝尧云百万年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿宁节祝圣寿 其二","author":"王禹称","text":"数声飞电响鸣鞘，香袅金炉映赭袍。\n王母亲承玉皇诏，年年今日进蟠桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17970,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿宁节祝圣寿 其六","author":"王禹称","text":"庄周浪说华封祝，汉帝虚传嵩岳声。\n争似寿宁嘉节日，千门万户愿长生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17971,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿宁节祝圣寿 其三","author":"王禹称","text":"华胥国土何时见，兜率天宫底处开。\n尽说今年寿宁节，一齐移入帝城来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17972,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿宁节祝圣寿 其九","author":"王禹称","text":"汉主寿山称万岁，玄宗佳节号千秋。\n吾皇别享无疆福，百姓欢呼动九州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17973,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿宁节祝圣寿 其十","author":"王禹称","text":"谪宦商于又解梁，二年不见赭袍光。\n重来班列虽疏远，祝寿情深泪数行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17974,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿宁节祝圣寿 其八","author":"王禹称","text":"祇为忧民感上玄，玉京今日集群仙。\n更教添注吾君寿，直过人皇万八千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17975,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿宁节祝圣寿 其五","author":"王禹称","text":"益算真君南斗高，还因圣节奏天曹。\n扶桑枯尽灵椿老，始放尧眉出寿毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17976,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿宁节祝圣寿 其七","author":"王禹称","text":"帝德由来动百神，年年圣节绝纤尘。\n万家喜气生和气，冬日翻疑一日春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17977,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿宁节祝圣寿 其四","author":"王禹称","text":"帘前可爱三冬日，阶下新抽七叶蓂。\n昨夜灵台因预奏，綵云高捧老人星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17978,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杏花 其六","author":"王禹称","text":"长安废弃迁都后，曲沼荒凉一梦中。\n见说旧园为茂草，寂寥无复万枝红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17979,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杏花 其一","author":"王禹称","text":"红芳紫萼怯春寒，蓓蕾粘枝密作团。\n记得观灯凤楼上，百条银烛泪阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17980,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杏花 其七","author":"王禹称","text":"陌上缤纷枝上稀，多情犹解扑人衣。\n双成洒道迎王母，十里濛濛绛雪飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17981,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杏花 其二","author":"王禹称","text":"暖映垂杨曲槛边，一堆红雪罩轻烟。\n春来自得风流伴，榆荚休抛买笑钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17982,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杏花 其五","author":"王禹称","text":"登龙曾入少年场，锡宴琼林醉御觞。\n争戴满头红烂熳，至今犹杂桂枝香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杏花 其三","author":"王禹称","text":"桃红李白莫争春，素态妖姿两未匀。\n日暮墙头试回首，不施朱粉是东邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泛吴松江","author":"王禹称","text":"苇篷疏薄漏斜阳，半日孤吟未过江。\n唯有鹭鹚知我意，时时翘足对船窗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"言怀","author":"王禹称","text":"宦途日日与心违，人事纷纷任是非。\n却为游山置行李，渔家船舫道家衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"陆羽泉茶","author":"王禹称","text":"甃石封苔百尺深，试茶尝味少知音。\n唯馀半夜泉中月，留得先生一片心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"制除工部郎中出内署","author":"王禹称","text":"温树阴中别玉堂，应星犹得入文昌。\n莫嫌工部官曹慢，杜甫才名是外郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲咸杏花三绝句 其一","author":"王禹称","text":"莫道商山节候迟，晓来帘外半空枝。\n明朝落尽无蜂蝶，冷暖人情我最知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲咸杏花三绝句 其二","author":"王禹称","text":"阶前已见三分落，枝上都无十日繁。\n谁伴多情王副使，吟诗倾酒与招魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲咸杏花三绝句 其三","author":"王禹称","text":"老去对花多感叹，春来耽酒少康宁。\n也知此事终无益，免被渔人笑独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和仲咸诗六首 其六 和送道服与喻宰","author":"王禹称","text":"朝客吟诗送羽衣，应知彭泽久思归。\n三年官满谁留得，领鹤携琴赋式微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏白莲","author":"王禹称","text":"昨夜三更后，姮娥堕玉簪。\n冯夷不敢受，捧出碧波心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏石榴花","author":"王禹称","text":"王母庭中亲见栽，张骞偷得下天来。\n谁家巧妇残针线，一撮生红熨不开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"知州厅杏花昨日烂漫录事院今日零落唯副使公署未开戏题二韵","author":"王禹称","text":"知州宅畔繁如雪，录事厅前落似梅。\n副使官闲花亦冷，至今未有一枝开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舍人院竹","author":"王禹称","text":"封了词头绕砌行，此君相伴最多情。\n西垣不宿还堪恨，辜负夜窗风雨声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"王禹称","text":"一路翠烟垂柳驿，满川红雨落花村。\n云随钓艇归渔浦，潮送沙鸥入店门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"王禹称","text":"徒劳官职在天涯，一望家园一泪垂。\n不是虎丘多胜概，拂衣归去已多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郑州联句","author":"张秉","text":"函关秋霁雁初回，六里商于晓色开。\n四皓有灵应笑我，谪官方始入山来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":17999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南园偶题","author":"王禹称","text":"天子优贤是有唐，鉴湖恩赐贺知章。\n他年我若功成去，乞取南园作醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"急就章","author":"王禹称","text":"赐来三载锦囊盛，今日重看倍觉荣。\n元白当时皆谪宦，不闻将得御书行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日","author":"王禹称","text":"门冷官闲似死灰，人言今日是春来。\n犹残旧赐银幡胜，且向山州当酒杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春居杂兴 其一","author":"王禹称","text":"两株桃杏映篱斜，妆点商山副使家。\n何事春风容不得，和莺吹折数枝花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春居杂兴 其二","author":"王禹称","text":"春云如兽复如禽，日照风吹浅又深。\n谁道无心便容与，亦同翻覆小人心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春居杂兴 其四","author":"王禹称","text":"一夜春雷百蛰空，山家篱落起蛇虫。\n无端蚯蚓争头角，触破莓苔气似虹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春居杂兴 其三","author":"王禹称","text":"闲写新诗十数篇，晓来铺向竹窗前。\n无端燕子欺人睡，故落春泥污綵笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独酌自吟拙诗次吏报转运使到郡戏而有作","author":"王禹称","text":"日高睡足更何为，数首新篇酒一卮。\n郡吏谩劳相告报，转输应不管吟诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独游南静川","author":"王禹称","text":"高车岭上无人见，南静川中信马行。\n多谢仙娥相管顾，远擎松雪助诗情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"省中苦雨 其一","author":"王禹称","text":"霏霏连昼复连宵，红药苍苔也寂寥。\n唯有御沟堤畔柳，拂檐遮槛不胜娇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"省中苦雨 其二","author":"王禹称","text":"醉魂吟魄共悽悽，檐溜窗风冷切肌。\n阶下怒蛙休跳跃，浮云遮日不多时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荥阳怀古","author":"王禹称","text":"纪信生降为沛公，草荒孤垒想英风。\n汉家青史缘何事，却道萧何第一功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻进士孙何及第因寄","author":"王禹称","text":"昨朝邸吏报商山，闻道孙生得状元。\n为贺圣朝文物盛，喜于初入紫微垣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阁下暮春","author":"王禹称","text":"诏书稀少日何长，闲枕通中睡一场。\n院吏报来丞相出，紫微花影上东廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭同年罗著作五首 其五","author":"王禹称","text":"同试五题为县吏，共求三字作词臣。\n西垣谪宦何须恨，若比罗三是幸人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭同年罗著作五首 其二","author":"王禹称","text":"一枝丹桂谩成名，一片绯衫未是荣。\n赖有遗文在东观，直应千载气如生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭同年罗著作五首 其四","author":"王禹称","text":"生死虽殊道义存，晓来襟袖有啼痕。\n只应知我方憔悴，时向商山入梦魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭同年罗著作五首 其三","author":"王禹称","text":"荒凉故宅何人住，寂寞孀妻即日还。\n一岁婴儿安健否，巨源虽在谪深山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭同年罗著作五首 其一","author":"王禹称","text":"宿草离披泪满衫，孤坟遥想帝城南。\n天生贾谊成何事，祇得人间三十三。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夏云","author":"王禹称","text":"嵯峨高锁夕阳红，斜入吟窗秀色浓。\n六里青山长满眼，不劳云片学奇峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海仙花诗 其二","author":"王禹称","text":"春憎窈窕教无子，天为妖娆不与香。\n尽日含毫难比兴，花中应是卫庄姜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海仙花诗 其一","author":"王禹称","text":"一堆绛雪压春丛，袅袅长条弄晓风。\n借问开时何所似，似将绣被覆薰笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海仙花诗 其三","author":"王禹称","text":"何年移植在僧家，一簇柔条缀彩霞。\n锦带为名卑且俗，为君呼作海仙花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠木瓜二绝句 其二 木瓜答海棠","author":"王禹称","text":"莫誇颜色斗扶疏，秾艳繁香总是虚。\n看取卫风诗什里，只因投我得琼琚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠木瓜二绝句 其一 海棠赠木瓜","author":"王禹称","text":"我向商山占断春，风流还似锦江滨。\n群花自合知羞耻，莫对西施更学颦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留别扬府池亭","author":"王禹称","text":"竹绕亭台柳拂池，徘徊终恋郡斋西。\n斜阳更上渔舟坐，明日红尘逐马蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"笋 其三","author":"王禹称","text":"一夜春雷起旧根，乱披烟箨出溪门。\n稚川龙过频回首，认得青青数代孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":18026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]