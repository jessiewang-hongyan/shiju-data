[{"title":"用前韵","author":"张纲","text":"雪花吹面冻凌凌，客路艰危敢缓行。\n春酒可赊三日近，野梅初见一枝横。\n伤时在处愁先满，讨贼无期梦自惊。\n谁解山东问消息，谢公应起为苍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11323,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泊舟庙湾次侄合","author":"张纲","text":"泊船高岸曲，散策小村傍。\n盗贼耳边满，朝廷天际望。\n系愁官柳嫩，醒醉野梅香。\n后进推吾子，词锋不可当。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11324,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春耕","author":"张纲","text":"乱后荒田杞棘生，归来还喜见春耕。\n随犁细雨濛濛湿，转垄新泉聒聒鸣。\n好劝卖刀添健犊，尽令长亩种香粳。\n腐儒一饱真馀事，莫遣闾阎有叹声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11325,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵黄尧翁斗鸡三首 其一","author":"张纲","text":"宴罢金鸡列，笼瞻黼座遥。\n两雄争定霸，一战息虚憍。\n忍受摧冠辱，贪承赐锦饶。\n如何纪渻氏，今乃混渔樵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11326,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵黄尧翁斗鸡三首 其二","author":"张纲","text":"系马翠楼下，斗鸡花树傍。\n飞毛惊辟易，喋血壮摧伤。\n奋击方乘势，欢呼忽擅场。\n忿心能几许，嗟尔太匆忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11327,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵黄尧翁斗鸡三首 其三","author":"张纲","text":"约斗提笼出，无哗倚壁看。\n祸心藏芥羽，碎首湿朱冠。\n擒敌壮夫事，策勋公子欢。\n栖群哙等伍，今日始知韩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11328,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵顾应文","author":"张纲","text":"万事浮云过眼空，羞将白发竞春红。\n折腰久已惭元亮，作赋何劳慕敬通。\n经世岂无天下士，知心应有古人同。\n破除孤愤难忘酒，圣处时时且一中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11329,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"读书","author":"张纲","text":"却老惭无术，驱愁赖有书。\n披寻穷浩渺，领略造玄虚。\n窗日三竿静，炉薰一炷馀。\n倦来还自哂，蠹简类蟫鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11330,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵孙仲益食豚鱼","author":"张纲","text":"说食书生费口牙，一杯初捧白瓷花。\n晨凫夜鲤可亡命，早韭晚菘同世家。\n毒甚镆铘浑谩语，诗成珠玉且雄誇。\n腐儒一饱忘粗粝，更索卢仝七椀茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11331,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵应文游东园","author":"张纲","text":"筋力摧颓老自知，追欢犹学少年时。\n园林胜处看如梦，杖履行来步懒移。\n对酒不堪蕉叶满，插花那复帽檐攲。\n羡君诗句方豪甚，应笑疏狂亦强随。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11332,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李道士观南山三首 其一","author":"张纲","text":"濛濛烟雨忽晴开，坐觉群山爽气来。\n谁向此间寻贺老，相逢莫放酒船回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11333,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李道士观南山三首 其二","author":"张纲","text":"山似围屏六曲开，小溪如带傍山来。\n结庐溪北对山住，俗驾何妨且勒回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11334,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李道士观南山三首 其三","author":"张纲","text":"柴门无事昼慵开，杖履谁曾得得来。\n隔岸野花随处发，护巢幽鸟傍林回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11335,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与韩子苍别久忽邂逅于临川遭时乱离道旧感叹子苍有诗见赠次韵奉呈二首 其一","author":"张纲","text":"三顾当年尚草庐，南阳谁识卧龙居。\n舍人自是出世佛，学子犹呼行秘书。\n视草似闻虚翰苑，追锋看即近郊墟。\n论思好为苍生计，莫学辛毗谩引裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11336,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与韩子苍别久忽邂逅于临川遭时乱离道旧感叹子苍有诗见赠次韵奉呈二首 其二","author":"张纲","text":"随缘到处是吾庐，风雨飘飖敢定居。\n异县逢君如隔世，七年怪我苦无书。\n平生出处皆陈迹，大半交游已故墟。\n愁绝不知尊酒尽，醉归儿女笑牵裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11337,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"言怀用子苍韵","author":"张纲","text":"早从微宦去田庐，惭愧英游许并居。\n拙计自怜嵇叔懒，暮年空悔子公书。\n归寻松竹开幽径，坐看牛羊下夕墟。\n已把经纶付王导，不妨綀布制襟裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11338,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢钱巽叔用子苍韵","author":"张纲","text":"底事承明厌直庐，孤城天远寄幽居。\n根尘已悟三乘祖，香火聊看八会书。\n是处风烟供翰墨，何妨杖履入村墟。\n皇文近日收遗老，妙手终烦补帝裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11339,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄曾公衮用子苍韵","author":"张纲","text":"五马归来识旧庐，相门曾对水云居。\n家声自可威戎虏，吏最何劳课簿书。\n好扈六飞还魏阙，却麾单骑复姚墟。\n莫欺霜鬓将军老，矍铄犹能一揽裾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11340,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚兴二首次人韵 其一","author":"张纲","text":"病骨支离怯晚风，可堪游目送飞鸿。\n书淫老去还知倦，酒圣秋来却喜中。\n北伐会须空虎落，西边先欲靖蚕丛。\n卑飞莫起扶摇念，徒使庄生笑二虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11341,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚兴二首次人韵 其二","author":"张纲","text":"衰草连云万木风，天高灭没见孤鸿。\n夕阳人散酒旗下，远浦船归渔笛中。\n兀兀松窗翻蠹简，垂垂蓬鬓飒霜丛。\n自怜世味谙来惯，已觉忘辛似蓼虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11342,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵谢人惠诗","author":"张纲","text":"翩翩才气逸轻翰，倒写波澜笔力宽。\n沈醉不辞金盏侧，清吟长占竹窗寒。\n捧心欲效羞颦媚，斲鼻须烦尽垩漫。\n辱赠骊珠念无报，但惊怀袖有奇观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11343,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜雨","author":"张纲","text":"夜雨妨清梦，疏檐落细声。\n幽怀无客语，偶坐有琴横。\n水阔柴荆迥，风高雁鹜惊。\n感时思报主，材薄愧平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11344,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闭閤","author":"张纲","text":"闭閤静无寐，观书空复愁。\n虞卿双白璧，晏子一狐裘。\n万事等归尽，百年谁得留。\n还将句中眼，为问贾长头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11345,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"行部至南陵题隐静寺","author":"张纲","text":"篮舆行尽万松冈，得得来看古道场。\n飞锡落花成佛去，后人谁见紫金光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11346,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄宿隐静东轩轩外竹引飞泉落地中隔窗闻之如秋雨泻檐声","author":"张纲","text":"踏残西日寄僧房，一炷炉熏秋夜长。\n谁作响泉喧客枕，梦回攲听雨淋浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11347,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李彦达客舍秋怀","author":"张纲","text":"落日孤村静，凄风一笛秋。\n寸心灰欲死，双鬓雪添愁。\n未报中原复，应烦肉食谋。\n独惭苏季子，计拙敝貂裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11348,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵彦达","author":"张纲","text":"之子初倾盖，论诗即定交。\n心清悬水鉴，才逸奋蒲梢。\n贳酒移宾榻，携盘杂野肴。\n半醒还半醉，相对老蘅茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11349,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"木落","author":"张纲","text":"木落秋声迥，山寒暮色连。\n时危羞冕绂，身老寄林泉。\n浊酒平孤愤，清吟续短篇。\n一枝吾已足，鸿鹄谢哀怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11350,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"思归","author":"张纲","text":"梧阴低落月，蛩响怨凄风。\n旧隐江烟里，归期客梦中。\n揽衣惊带缓，看烛待花红。\n莫谩呼欢伯，驱愁正罔功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11351,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵酬彦达","author":"张纲","text":"浮荣过眼风脱叶，鸳行无复清梦接。\n柴门昼闭雀可罗，寒日晖晖弄疏樾。\n已种芳兰滋九畹，更遣胎仙舞三叠。\n李侯壮志亦可人，举目万里欲横绝。\n醉眼时看石棱紫，吟鬓半作霜棘折。\n方今圣主躬俭勤，奏赋不须誇羽猎。\n中兴盛事要磨崖，老于文字谁踰结。\n愿君勉力上扶摇，渺渺云海出飞楫。\n莫随铩翮卧穷巷，漫学啼螀吊寒月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11352,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"烧香三绝句 其一","author":"张纲","text":"卷去竹书闲棐几，卧看桐影转檐牙。\n试凭波律送清梦，未信华胥天一涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11353,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"烧香三绝句 其二","author":"张纲","text":"霏霏沉水屑玄玉，霭霭博山生翠云。\n罗筏城旁知几里，坐令香界彻微熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11354,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"烧香三绝句 其三","author":"张纲","text":"闭眼无劳身外思，安心有法静中知。\n香添细炷焚千和，茶碾新芽试一旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11355,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵钱巽叔见赠","author":"张纲","text":"阻阔书邮顿两忘，三年清梦独徜徉。\n风旌引兴与天远，茧绪牵愁知日长。\n逸翮伫归鸳鹭列，鸣驺忽下水云乡。\n秋霖穷巷无人到，裹饭应烦问子桑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11356,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"感恩","author":"张纲","text":"伊昔趋青锁，尝叨奉紫宸。\n燕间承仄席，清问及垂纶。\n宠荷皇恩重，归惭白发新。\n粉身那足报，结草是吾邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11357,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"幽情","author":"张纲","text":"褊性多违俗，忘年只旧山。\n心随黄叶谢，身与白云闲。\n杜酒频应酌，莱衣剩喜班。\n幽情在丛桂，为着槿篱环。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11358,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"彦达作诗自叹次韵勉之","author":"张纲","text":"未试屠龙学，频应引剑看。\n梦惊秋枕雨，愁入曙窗寒。\n战伐今年定，乾坤万里宽。\n扶摇终一举，回首谢悲酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11359,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"日暮","author":"张纲","text":"地偏车马静，门闭水云深。\n野艇收晴网，村舂续暮砧。\n危肠逢酒怯，病骨畏寒侵。\n又见鸦归尽，谁赓梁甫吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11360,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵彦达雨霁","author":"张纲","text":"坐看飞雨激风雷，忽变晴空万里开。\n残暑暗随檐溜去，新凉频逐树声来。\n朱弦奏罢空三叹，白酒篘残尚一杯。\n病懒怕催诗债急，彊吟狂斐不知裁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11361,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晚雨","author":"张纲","text":"急雨鸣初歇，崇云凝不流。\n客帆迷息浦，渔火聚烟洲。\n委巷藏身拙，残编乱眼愁。\n功名心已谢，肯负故山幽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11362,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"彦达借研意在白取次韵戏答","author":"张纲","text":"斲石染轻翰，对面可十手。\n价重千黄金，欲见那得苟。\n难欺相如璧，宁碎范增斗。\n作诗伐君谋，聊以当墨守。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11363,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"家叔示秋夜诗次韵","author":"张纲","text":"秋来天色半晴阴，衰鬓难禁节物侵。\n兰叶向人方泣露，菊花催酒已浮金。\n莫将诗课频频聒，不那愁城日日深。\n咫尺南山堪寄傲，欲随鸠杖遍幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11364,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用前韵","author":"张纲","text":"萧然云屋敞溪阴，荒径蒿莱故故侵。\n穿竹晚风轻戛玉，入帘凉月碎摇金。\n畏寒皮骨惊秋早，得酒情怀语夜深。\n临老工夫在禅说，试拈波若为重寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11365,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵戏彦达思归","author":"张纲","text":"月窗明素练，风榻净飞沙。\n饮极樽无绿，更长烛自花。\n感时忧未散，得句喜能誇。\n莫寄思归语，妆寒损鬓鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11366,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月夜","author":"张纲","text":"渔火前村近，秋砧静夜多。\n山烟归宿鸟，水月动明波。\n烛短催诗急，樽空奈客何。\n抱愁眠不稳，林影半床过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11367,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜小酌","author":"张纲","text":"宇宙秋光老，崦嵫夜色连。\n澄波寒浸月，低树远浮烟。\n巷僻喧都骑，杯行促广筵。\n摩尼元自照，沉醉不妨禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11368,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"探梅","author":"张纲","text":"俗态多违性，忧梅不近城。\n诗书看长物，林壑寄馀情。\n傍驿寻梅使，冲寒过曲生。\n一枝供细酌，归路见参横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11369,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山中即事","author":"张纲","text":"地僻官仍冷，心闲日自长。\n松篁供远吹，芝朮度幽香。\n直木应先伐，惊禽忍再伤。\n家山吾所爱，投老慰相望。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11370,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵彦达折梅","author":"张纲","text":"信步寻梅约，欣逢亚雪枝。\n春藏红萼小，寒啬暗香迟。\n画角传新曲，妆台敛翠眉。\n广平心不动，唯许笔端知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11371,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"僻居","author":"张纲","text":"陋巷人谁乐，穷居意自安。\n拥门云树暗，缭径土花乾。\n白发惊时速，青灯耿夜寒。\n中原满胡骑，一念一悲酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵彦达对雪有感","author":"张纲","text":"朔风卷地寒云繁，忽惊空花堕檐间。\n远山历乱眼中失，飞鸟灭没天际还。\n缅想端门万官贺，云陛俨列鸣佩环。\n丰年献瑞天一笑，声动四海具欢颜。\n李侯人物妙天下，何独卧穷看屋山。\n胸次冰壶自深瑩，管中雾豹难窥斑。\n异时富贵恐不免，讵忍空歌梁甫艰。\n君看鸿鹄有高志，一举九万谁能攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪晴","author":"张纲","text":"雪晴日脚下茅屋，深巷泥融频屐声。\n幽鸟唤春啼不那，野梅迎客意先倾。\n愁肠断送酒边散，诗眼安排烟际横。\n晚岁浮荣安用许，祗应丘壑未忘情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11374,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵彦达催诗","author":"张纲","text":"老去交亲浑谩与，兴来终日饮亡何。\n扣门颇厌催书债，隐几凭谁遣睡魔。\n肯怪物情相楚越，端由吾道自丘轲。\n衰慵更着诗烦恼，笔阵方开已倒戈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11375,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁暮二首 其一","author":"张纲","text":"忽忽岁云暮，霏霏山雨频。\n鸟啼茅舍静，梅映竹篱新。\n陋巷无深辙，清酤有善邻。\n中原消息断，聊与醉乡亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11376,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁暮二首 其二","author":"张纲","text":"寒逐云阴散，年催节物新。\n桃符趋腊市，社鼓赛田神。\n任性琴书懒，呼儿杖履频。\n君恩难报处，家食奉双亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11377,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用前韵","author":"张纲","text":"雪残春信近，山迥客愁新。\n兴极樽无酒，诗成笔有神。\n玩心云物变，惊梦雨声频。\n坐对华严海，忘言意自亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11378,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"野望","author":"张纲","text":"日落寒云薄，楼高望眼迷。\n兴亡千古恨，衰病万行啼。\n拔士空岩穴，防秋尚鼓鼙。\n建章何处是，坐待玉绳低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11379,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"探梅","author":"张纲","text":"倚空山翠罗曲屏，入山晓日寒凄清。\n苍龙导前散疏影，幽鸟劝坐回新声。\n探梅忽见数枝发，曳杖折来双眼明。\n绰约东窗可无伴，烦君火急呼曲生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11380,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"彦达乘小舟醉归堕水作此戏之","author":"张纲","text":"舍爵颓然饮中仙，夜归一苇航深渊。\n长歌扣舷天上坐，起舞失脚水底眠。\n未省渴羌笑肉动，会令鼹鼠惊腹便。\n布帆无恙急藏去，明年更试春江船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11381,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李公显","author":"张纲","text":"士有鸿鹄志，万里一举翮。\n胸中自廊庙，肯顾三亩宅。\n李侯气迈爽，词锋凛霜戟。\n老夫晚结交，文会欣有绎。\n剧谈到时事，唾手欲任责。\n短褐天路高，畎亩抱忠赤。\n风雷惜变化，泥蟠等蜥蜴。\n结茅西山下，樵爨走僮获。\n富贵会有时，箪飘岂不适。\n世态翻覆手，宁较黑与白。\n兴来时一杯，南窗俯遥碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11382,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归自金坛值雨宿顾龙山翌日施米作供","author":"张纲","text":"蒲牢不击欠晨炊，风伯如何圣得知。\n留我舣舟明日去，满堂香饭雪翻匙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11383,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵公显见赠 其一","author":"张纲","text":"李侯词气吐朝阳，光焰真成万丈长。\n绿发莫将尘土暗，会看它日照金章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11384,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵公显见赠 其二","author":"张纲","text":"年齐耆旧愧衰阳，懒性唯耽野趣长。\n了却官租更何事，君王约法已三章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11385,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用前韵戏公显","author":"张纲","text":"初试梅妆惬寿阳，藁砧山上夜何长。\n式微未尽闺中怨，束晰那辞补一章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11386,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送公显应举","author":"张纲","text":"堂堂笔阵一当千，得意秋风急着鞭。\n百万破荒明日事，未应长欠亩头钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11387,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵公显木犀","author":"张纲","text":"铺茸紫葵乱晴飔，点金寒菊栖短篱。\n木犀韵高陋凡枝，顾与葵菊同阶墀。\n香闻十里自绝奇，造物岂偏雨露滋。\n閒见层出珠琲垂，鹅黄靛妆宫样宜。\n烟销红日下薄帷，宴坐幽窗风度时。\n颇觉飘飘兰蕙姿，着人不去催作诗。\n李侯为续离骚辞，香草端从笔下移。\n花前把卷不停披，何以酬君金屈卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11388,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵公显赋蜡梅诗二首 其一","author":"张纲","text":"寿阳催妆花睡起，半额残黄娇欲语。\n香魂浮动满幽思，着莫春风暗相与。\n李侯铁心似广平，笔力万钧谈笑举。\n诗成夜诵更清绝，向来谁识袁临汝。\n句中有味应独知，吟罢馀甘发微咀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":11389,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]