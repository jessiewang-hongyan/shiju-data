[{"title":"游大涤 其一","author":"赵善䚮","text":"黄帘有影金灯暗，碧殿无人玉磬清。\n我亦三生羽衣客，梦魂久已到瑶京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4663,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"游大涤 其二","author":"赵善䚮","text":"云葩裛石侵衣润，岚翠笼山入眼明。\n何处如今有仙隐，愿寻药圃斸玄英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4664,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题岑公洞","author":"赵善赣","text":"真人邈何之，恍忽不可见。\n洞居独嵌空，壁留明珠溅。\n藤萝含冥濛，竹柏斗葱茜。\n至幽合人心，远翠落江面。\n野老乘篮舆，使君肆清燕。\n日影砌下倒，云容坐间变。\n大木岩欲倾，邃壑路微转。\n峥嵘施屏风，点缀成彩绚。\n虽云急行乐，胜赏殆亦遍。\n欲归重盘旋，拂石看古篆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4665,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题翠蛟亭","author":"赵善革","text":"未到康庐看玉渊，且来大涤掬飞泉。\n决流放闸虽人力，溅玉跳珠却自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4666,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大涤洞 其一","author":"赵善革","text":"敲撑振策上嶙峋，乱石逢迎领略频。\n风窦静吟吹地籁，涧泉高泻曳天绅。\n云山胜景身无累，觞咏清怀笔有神。\n残梦惊回三十岁，琅玕芝草一时新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4667,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大涤洞 其二","author":"赵善革","text":"旧游风物转头非，只有青山不改移。\n深壑贮风驯虎啸，断崖飞瀑翠蛟驰。\n郭翁遗迹云烟锁，坡老清名草木知。\n笑问聚仙亭上月，风流应不减当时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4668,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大涤洞 其三","author":"赵善革","text":"冠盖初收见在身，来寻大涤涤尘氛。\n心如霜后凌虚月，迹是风前出岫云。\n仙姥定能赊瓮酒，华堂小憩看炉熏。\n甚思屏置人间事，韬养岩间雾雨文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4669,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大涤洞 其一","author":"槻伯圜","text":"洞霄问路觅青梯，尚恐岩阿有勒移。\n暂许寻山留信宿，何由税驾息驱驰。\n七仙不死今仍在，五洞交扃昔所知。\n信有灵丹藏箬下，刀圭分乞岂无时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4670,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大涤洞 其二","author":"槻伯圜","text":"飞饷江淮脱此身，聊寻九锁浣兵氛。\n笑呼天柱峰前月，共踏栖真洞里云。\n阴谷神泉霜后王，阳坡灵草雨馀薰。\n十年洗髓除凡骨，傥契仙翁迈与文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4671,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大涤洞 其三","author":"槻伯圜","text":"馀杭晓旆籋飞梯，大涤松阴午未移。\n群从追随巾屦集，众真参会佩环驰。\n白鸦翻舞仙如在，黄鹤迎来圣得知。\n老□□□□□□，□□□□□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4672,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大涤洞 其四","author":"槻伯圜","text":"□□□□□□□，□□□□□□□。\n□□□□□□□，捲壑飞泉日夜驰。\n龙蜕洞深神所蛰，凤鸣岩隐世谁知。\n坡仙一去无消息，相见清游彼一时。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4673,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大涤洞 其五","author":"槻伯圜","text":"快上篮舆晓色分，松风满袂涤埃氛。\n三竿未放高峰日，一笑先开洞府云。\n忆昔曾留天帝坐，至今犹带御炉薰。\n莫教俗驾来相尾，只恐诒讥晋郭文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4674,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大涤洞 其六","author":"槻伯圜","text":"人间安得倚天梯，欲访真源志不移。\n大涤乃今追胜迹，清都何待更神驰。\n已逃萧斧杉难老，不逐秦鞭石有知。\n尚觉林泉佳气王，难忘羽卫幸临时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4675,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大涤洞 其七","author":"槻伯圜","text":"松筠玉立见长身，琼馆沉沉远楚氛。\n裂石看倾三峡雪，解衣同试一瓯云。\n朮畦晓露初收药，兰径秋风静吐薰。\n为拂苍崖题岁月，重来应复感斯文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4676,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"王才元","text":"雪曳山容改。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4677,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"王才元","text":"远墅炊烟近。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4678,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄弟子慧山偈","author":"释道琼","text":"口觜不中祥老子，爱向丛林鼓是非。\n分付雪峰山首座，为吾痛骂莫饶伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4679,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二首 其一","author":"释道琼","text":"掩耳不及忽雷奔，天低尺五雨倾盆。\n叶随流水归何处，牛带寒鸦过别村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4680,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二首 其二","author":"释道琼","text":"舍筏怀兼济，逢耕更问津。\n却将未归意，说与欲行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4681,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"呈芙蓉楷禅师","author":"高世则","text":"悬崖撒手任纵横，大地虚空自坦平。\n照壑辉岩上借月，庵头别有一帘明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4682,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈三首 其一","author":"释介谌","text":"出西天，入东土。\n云从龙，风从虎。\n一任诸方点头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4683,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈三首 其二","author":"释介谌","text":"文殊智，普贤行，多年历日。\n德山棒，临济喝，乱世英雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4684,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈三首 其三","author":"释介谌","text":"我若说有，你为有碍。\n我若说无，你为无碍。\n我若横说，你又跨不过。\n我若竖说，你又跳不出。\n若欲丛林平贴，大家无事，不如推倒育王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4685,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二首 其一","author":"释慧琳","text":"有漏笊漓，无漏木杓。\n庭白牡丹，槛红芍药。\n因思九年面壁人，到头不识这一著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4686,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈二首 其二","author":"释慧琳","text":"一即多，多即一，毗卢顶上明如日。\n也无一，也无多，现成公案没殽讹。\n拈起旧来毡拍板，明时共唱太平歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4687,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二首 其一","author":"释慧琳","text":"五凤楼脱问洛阳，金鞭遥指御街长。\n春风是处华争发，游子年年忆故乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4688,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"颂古二首 其二","author":"释慧琳","text":"赤体更无藏隐处，黄龙未语先分付。\n若将见解上门来，他家自有通霄路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4689,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"呈泐潭草堂清禅师偈三首 其一","author":"本明道人","text":"不识烦恼是菩提，若随烦恼是愚痴。\n起灭之时须要会，鹞过新罗人不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4690,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"呈泐潭草堂清禅师偈三首 其二","author":"本明道人","text":"不识烦恼是菩提，净华生淤泥。\n人来问我若何为，吃粥吃饭了洗钵盂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4691,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"呈泐潭草堂清禅师偈三首 其三","author":"本明道人","text":"莫管他，莫管他，终日痴憨算海沙。\n要识本来真面目，便是祖师一木叉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4692,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈","author":"释圆智","text":"芦华白，蓼华红，溪边脩竹碧烟笼。\n闲云抱幽石，玉露滴岩丛。\n昨夜乌龟变作鳖，今朝水牯悟圆通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4693,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偈","author":"释良范","text":"尘劫已前事，堂堂无背面。\n动静莫能该，舒卷快如电。\n莫道凡不知，佛也觑不见。\n决定在何处，合取这两片。\n荐不荐，更为诸人通一线。\n天下太平，皇风永扇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4694,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"竹枝辞","author":"李邦献","text":"江上渔舟叶叶轻，峡中云雨晚凉生。\n长亭宴罢客归去，桂树夕阳啼鸟声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4695,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过仙都徐氏山居 其一","author":"李邦献","text":"道出仙都下，溪深草木闲。\n阴晴老农事，丰稔此心关。\n谁削千寻石，云藏万叠山。\n王程元有限，那得更跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4696,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过仙都徐氏山居 其二","author":"李邦献","text":"四海无尘战马闲，稻梁桑柘绿回环。\n不知尽是君王力，华屋重重对好山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4697,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仁寿堂古梅","author":"李邦献","text":"手种黄梅已着花，此身依旧在天涯。\n三年客罢携家去，赢得东风两鬓华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4698,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"马王庙","author":"李邦献","text":"矍铄兹翁老莫量，据鞍犹得亚燕扬。\n能将岸帻窥文叔，祇把虚蛙当子阳。\n薏苡满车翻作祸，马人上日竟成行。\n三泷庙食传千古，回首云台草树荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4699,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄鹤林辛上人","author":"苏庄","text":"苦忆长廊清磬音，复怀赞公栴檀林。\n阳坡佳木鸟相唤，涧户晓行藤竹阴。\n日晴山路笋橛晚，雨足野塘蒲稗深。\n短褐兀然聊戏剧，沧江鸥鹭本无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4700,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小斋即事二首 其二","author":"刘一止","text":"旱夏甘雨零，坐见草木长。\n天怜官穷隘，乞与风飒爽。\n四檐溜通池，激激听微响。\n虽非山林间，故作山林想。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4701,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道中杂兴五首 其一","author":"刘一止","text":"濒春欲生妍，梅蕊先媚好。\n宁辞犯霜雪，渐拟苏百草。\n耿耿甘独待，馀恩及枯槁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4702,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道中杂兴五首 其二","author":"刘一止","text":"姚黄花中君，芍药乃近侍。\n我尝品江梅，真是花御史。\n不见雪霜中，炯炯但孤峙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4703,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道中杂兴五首 其三","author":"刘一止","text":"晴风扫顽云，白日光在地。\n云翳无几何，聚散等悬寄。\n所以寸草心，各各抱根蒂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4704,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道中杂兴五首 其四","author":"刘一止","text":"麦头渐青青，麦田何井井。\n黄云被原野，众草昏未醒。\n方知天壤间，春风有畦畛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4705,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道中杂兴五首 其五","author":"刘一止","text":"长亭连短亭，只堠复双堠。\n居然送行客，历历记奔走。\n十里同五里，先后无好丑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4706,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"识舟亭一首","author":"刘一止","text":"渺渺归帆江北渚，脉脉相望那得语。\n舟中贾客婵娟女，朝乐潇湘暮荆楚。\n我欲招之问计然，浮名唾去如飘烟。\n买鱼沽酒啸俦侣，槌鼓弄笛凋残年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4707,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过新开湖呈无言兄御史","author":"刘一止","text":"整整斜斜村舍居，十十五五沙中凫。\n潜鱼钓影水深浅，高柳着行烟有无。\n天阔云低过平楚，已觉淮音近吴语。\n淮南米贱好留侬，正恐不归心更苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4708,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"腰镰一首","author":"刘一止","text":"腰镰行稻区，引挽亲刈熟。\n黄云卧千顷，弥望极平陆。\n潦水秋未收，褰裳听满足。\n为士复兼农，自身仍当仆。\n书年贺丰稔，天事诚委曲。\n辛苦岂敢辞，幸此卒岁蓄。\n归来妻孥笑，风日缁面目。\n未觉城市胜，生理系斗斛。\n少年事笔耕，初不辨穜稑。\n读书舌本燥，得食仅半菽。\n人言清有馀，自哂瘦如竹。\n虚名真画饼，逸景等转烛。\n今我更百态，渐已不讳俗。\n杯水重万言，囊钱踰满腹。\n却嗤祖士少，未免怀愧恧。\n客来讵相访，底用身障簏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4709,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无言兄以银壶作粥糜颇极其妙舟居夜饥顷刻可办戏作此诗","author":"刘一止","text":"少年爱酒不废沽，滑稽鸱夷每随车。\n春禽似是知我意，日日劝我提葫芦。\n侵寻老境筋力异，宿昔百嗜今一无。\n羁穷未免走四方，是口时赖薄粥糊。\n怜君巧作此瓢壶，善为口计真不疏。\n上盖下丰腹胍?，空洞可置升米馀。\n釜汤外沸如隔膜，气塞不作声卢胡。\n须臾已复成淖糜，匀滑不减倾醍醐。\n篷窗夜饥急星火，咄嗟而办功可书。\n山僧歙钵未足诧，考父古鼎非时须。\n我闻壶中有高隐，日月或类蓬莱居。\n神仙有无事恍惚，山泽形貌常多臞。\n不如一饱睡清熟，个中便是真华胥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4710,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卢骏元宪使寄示会稽竞秀阁识舟亭二诗为各赋一首 其一","author":"刘一止","text":"葱笼秀拥秦山落，尽日春风吹岭脚。\n朝来领略到窗几，谁遣虚空出阿阁。\n南台御史去天近，身与孤云生两角。\n胸中摸索千丈弦，更恐并吞有衡霍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4711,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卢骏元宪使寄示会稽竞秀阁识舟亭二诗为各赋一首 其二","author":"刘一止","text":"海门山边初落潮，西兴渡口浪痕高。\n渺渺目乱翻云涛，心识不语迎归桡。\n江亭晚日风萧骚，轧哑鸣橹相向摇。\n平头雁落沙没腰，舟人底处寻青招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4712,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天长道中作饥来驱我去二首寄呈刘卢二御史 其一","author":"刘一止","text":"饥来驱我去，去去复何之。\n西风迎马头，背日霜林披。\n十年京洛尘，衣弊因改为。\n岂惟衣日化，面目亦已缁。\n功名误少小，辛苦道老黧。\n追惟中自惊，恍声失旦鸡。\n安得如虚空，万境俱一齐。\n我心无去来，我马随东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天长道中作饥来驱我去二首寄呈刘卢二御史 其二","author":"刘一止","text":"饥来驱我去，去去复何如。\n我饥亦何惭，所叹为此躯。\n明发着征衫，薄暮投郊墟。\n烟林号怒风，牛背立饥乌。\n境恶梦多悸，愁孤郁难舒。\n念初别乡邦，短楫穿菰芦。\n眼中两御史，炯炯冰在壶。\n清游失追攀，负此山绕湖。\n我行日已西，回首风牵裾。\n两公饫文章，笔端吐新腴。\n愿言继残膏，龟肠正空虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拱州道中二首 其一","author":"刘一止","text":"城楼百尺兀相望，帝作东辅拱神州。\n当日隋家漕渠柳，至今春在末梢头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拱州道中二首 其二","author":"刘一止","text":"柳条明媚欲变色，便想春思浩无涯。\n行人手挽不忍断，云此生意方萌芽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"家侄季高作诗止酒戏赋二首 其一","author":"刘一止","text":"渊明出从任，初亦计林田。\n一朝倦束带，唾弃如飘烟。\n无酒每从人，兹事若可怜。\n醉来便逐客，卿去我欲眠。\n了知此贤胸，醒醉皆超然。\n胡为遽止酒，而作止酒篇。\n此身役万物，不使一物偏。\n有偏即是累，在性皆非圆。\n我樽可忘酒，我琴故无弦。\n携琴玩空樽，惟我乐也天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"家侄季高作诗止酒戏赋二首 其二","author":"刘一止","text":"渊明赋止酒，止酒未尝止。\n今朝诗固云，从此真止矣。\n我观他日诗，说酒特未已。\n必饮诚有累，必止亦非理。\n无如作病何，聊用忘忧耳。\n得失定相半，随遇无彼此。\n胡为我阿咸，深拒坚壁垒。\n子言故多师，乌有与亡是。\n独此止酒诗，字字如信史。\n恐子昧圆通，未究真正义。\n当观诸世间，一一等幻戏。\n死生尚云尔，何乃较醒醉。\n操瓢起相从，无为乏我事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方时敏寄和诗复用韵报之并简季高理前止酒之语季高尝梦萧相国戒勿饮酒 其一","author":"刘一止","text":"畴昔城南隅，莲叶秋田田。\n从公觞玉醪，醉墨看云烟。\n我乃世背驰，公独肯顾怜。\n追思十年梦，仅熟一觉眠。\n念当老扁舟，生理师计然。\n不意菰芦中，复见琼瑶篇。\n笔力如置阵，弥缝认先偏。\n从容步武间，左右方若圆。\n又如清庙音，三叹闻疏弦。\n安得化为云，追逐飞上天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"方时敏寄和诗复用韵报之并简季高理前止酒之语季高尝梦萧相国戒勿饮酒 其二","author":"刘一止","text":"阮籍刘伯伦，嗜酒不知止。\n颠狂欲求名，此计真陋矣。\n酒中有何好，正自未能已。\n愁来得暂驱，洞若适妙理。\n我岂沈酣徒，公亦聊尔耳。\n世间等梦间，未悟彼易此。\n阿高志得殊，家学自中垒。\n嗷嗷求独醒，今昨较非是。\n无心穷酒圣，有意造诗史。\n自言古酂侯，告戒存密义。\n逡巡若神授，恍惚类儿戏。\n不须更论酒，春梦本如醉。\n我知昴星精，不管太白事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵端直贻何子楚卜居山间二绝句 其一","author":"刘一止","text":"贺老晚乞一曲湖，绝胜叔平千头奴。\n端直自是功名人，未用早计此索居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵端直贻何子楚卜居山间二绝句 其二","author":"刘一止","text":"后堂弹丝娇不止，知有性灵双婢子。\n歌词自制清如水，却怪惊尘暗中起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子楚秀才 其一","author":"刘一止","text":"何郎卜筑吞江湖，下瞰培塿皆仆奴。\n山川胜绝本相假，正复此士堪此居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵子楚秀才 其二","author":"刘一止","text":"何郎归欤直止止，所恨扁舟欠西子。\n山高日长贪睡美，不有江声谁唤起。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠道人王生一首","author":"刘一止","text":"夜来清商入梧桐，策策不已鸣霜风。\n故烟一碧万烟树，惨淡已有伤秋容。\n嗟哉造物本何意，安得永赖长养功。\n我独冷眼阅荣悴，心与日出清霜融。\n子奚不来助我喜，瓮头春风生曲米。\n人间有酒谁不醉，知其天者我与子。\n我身虽无双羽翰，欲将梦到三神山。\n借尔八尺龙须席，蘧然一觉俱飞还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"家弟元成将参部来取别是夕忽梦与元成跨马并行隐隐闻车毂声如在道途觉而作诗并以赠行","author":"刘一止","text":"荒凉半亩居，风烟夜沈沈。\n安得清梦间，尚有车毂音。\n自我客京华，半世历嵚嵚。\n日月不相贷，鬓有微霜侵。\n骑马著青衫，兹事已不任。\n如何栖迟中，心迹犹差参。\n梦境通前生，染习良已深。\n岁月不可磨，愈厉如精金。\n富贵岂足道，大是功名心。\n勉哉子驰驱，壮志方在今。\n力学懒似侬，膏肓恐难针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":4726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]