[{"title":"菩萨蛮","author":"李洪","text":"寒山横抹修眉绿。\n楼前溪瀑锵鸣玉。\n车马各西东。\n行人如转蓬。\n阑干成独倚。\n海阔天无际。\n云淡隔壶山。\n鸿飞杳霭间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红 和盐田驿驹父留题","author":"李洪","text":"梅雨成霖，倦永昼、暑行岩曲。\n爱云梢翠樾，枕溪蓬屋。\n轻木凌波冲卷雪，飞泉奔壑呜哀玉。\n羡渔翁、终岁老烟波，披蓑绿。\n嗟客宦，荒松菊。\n颓壮志，青编竹。\n更长年谙尽，是非荣辱。\n钟鼎无心时节异，山林有味箪瓢足。\n感故人、于此赋归欤，思之熟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 木犀","author":"李洪","text":"香满千岩，芳传丛桂，小山曾咏幽菲。\n仙姿冷淡，不奈此香奇。\n翠葆层层障日，深爱惜、早被风吹。\n秋英嫩，夜来露浥，月底半离披。\n谁知。\n清品贵，带装金粟，韵透文犀。\n与降真为侣，罗袖相宜。\n宝鸭休薰百濯，清芬在、常惹人衣。\n姮娥约，广寒宫殿，留折最高枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 送客至汤泉","author":"李洪","text":"十月南闽未有霜。\n蕉林蔗圃郁相望。\n压枝橄榄浑如画，透甲香橙半弄黄。\n斟绿醑，泛沧浪。\n白沙翠竹近温汤。\n分明水墨山阴道，只欠冰溪雪月光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题清芬阁二首 其二","author":"李洸","text":"备员何奉再依仁，仰慕亨衢速若神。\n万里云龙遭圣世，三年苫块报慈亲。\n卢茨山水风骚国，獬豸衣冠法令臣。\n谁谓趋朝虚几席，长兄歌酒更延宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题清芬阁二首 其一","author":"李洸","text":"诗亡向千载，礼义谁维持。\n唐人得名者，沈宋称绮词。\n卓哉先生才，邈视数子卑。\n抗怀信高洁，出事皆清奇。\n不矜险绝句，意远窥无涯。\n春归鉴湖绿，水落严子矶。\n往来寄渔钓，遁世心独知。\n松月绕云山，尽入骚人思。\n白雪雅调高，俗耳听不宜。\n群儿谩嘲毁，百岁名愈驰。\n裔孙有清风，宛若先生诗。\n搔头试一吟，古意犹能追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题妙庭观","author":"李浃","text":"风驭云车去几年，空馀故迹锁苍烟。\n古来信有神仙事，莫漫诗成谢自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吊危一","author":"李炳","text":"南乡老人危翁一，岁晏雨晴扶杖出。\n惊闻二圣尘再蒙，归阖柴门哭三日。\n眼空愁绝声遂止，里人唁翁翁死矣。\n凛然生气申包胥，万古千秋葬忠义。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"木兰花慢 寄豫章故人","author":"李珏","text":"故人知健否，又过了、一番秋。\n记十载心期，苍苔茅屋，杜若芳洲。\n天遥梦飞不到，但滔滔、岁月水东流。\n南浦春波旧别，西山暮雨新愁。\n吴钩。\n光透黑貂裘。\n客思晚悠悠。\n更何处相逢，残更听雁，落日呼鸥。\n沧江白云无数，约他年、携手上扁舟。\n鸦阵不知人意，黄昏飞向城头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"击梧桐 别西湖社友","author":"李珏","text":"枫叶浓于染。\n秋正老、江上征衫寒浅。\n又是秦鸿过，霁烟外，写出离愁几点。\n年来岁去，朝生暮落，人似吴潮展转。\n怕听阳关曲，奈短笛唤起，天涯情远。\n双屐行春，扁舟啸晚。\n忆昔鸥湖莺苑。\n鹤帐梅花屋，霜月后、记把山扉牢掩。\n惆怅明朝何处，故人相望，但碧云半敛。\n定苏堤、重来时候，芳草如剪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送钤辖馆使王公","author":"李畋","text":"郤縠诗书奕世传，西人歌德别戎旃。\n三朝功业标勋府，四稔恩绥播蜀川。\n耦射隔花闻破帖，分题临沼间中筵。\n归朝圣旨俞佥望，畿内封侯养重权。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"李畋","text":"红沽村落酒，肥鲙海乡鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"李畋","text":"银山云出海，练水涧分冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"李畋","text":"沃心甘蔗冷，烧眼刺桐繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62504,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题浯溪 其一","author":"李祐孙","text":"明皇何以致颠危，林甫国忠成祸基。\n妃子良心犹不悟，此机惟有九龄知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62505,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题浯溪 其二","author":"李祐孙","text":"浯溪崖石与天齐，两刻中兴大业碑。\n北向几多垂白叟，百年不见汉官仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62506,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"西江月","author":"李结","text":"若将花卉论行藏。\n盍在凌烟阁上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62507,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"李结","text":"花圃萦回曲径通。\n小亭风卷绣帘重。\n秋千闲倚画桥东。\n双蝶舞馀红便旋，交莺啼处绿葱珑。\n远山眉黛晚来浓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62508,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送天柱冯先生","author":"李绚","text":"闲驰风驭恣飘飘，因失仙班几度朝。\n紫阁旧怜秦树老，赤城新别海山遥。\n飞凫又说春经岳，叱橘曾令夜探潮。\n不是桃源不归去，故人多半在烟霄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62509,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"李绚","text":"收得桑榆归物外，种成桃李满人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62510,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"李绚","text":"日回龙并影，风过凤联声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62511,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"李绚","text":"吾宗天下著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62512,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铁袈裟","author":"李美","text":"十载松关隔世尘，俯襟云石骨毛清。\n他时脱得浮名利，好作清凉境里人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62513,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"李荣","text":"国人久倚东园望，拟筑沙堤到广陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62514,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送永嘉张德载归","author":"李诲言","text":"一书催客棹，兴已落天涯。\n诗捲愁中景，人归梦里家。\n山田耕过雨，溪水钓残霞。\n茆屋容身老，文章不足誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62515,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠周书记","author":"李诲言","text":"早悟功名岁月空，衲衣何处不从容。\n几回渡水自寻鹤，岂但买山方种松。\n麾玉固尝闻咳唾，掷金未尽写心胸。\n与君能隔几多地，薄暮一声湖上钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62516,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆王孙 其四 冬词","author":"李重元","text":"彤云风扫雪初晴。\n天外孤鸿三两声。\n独拥寒衾不忍听。\n月笼明。\n窗外梅花瘦影横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62517,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆王孙 其三 秋词","author":"李重元","text":"飕飕风冷荻花秋。\n明月斜侵独倚楼。\n十二珠帘不上钩。\n黯凝眸。\n一点渔灯古渡头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62518,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆王孙 其二 夏词","author":"李重元","text":"风蒲猎猎小池塘。\n过雨荷花满院香。\n沈李浮瓜冰雪凉。\n竹方床。\n针线慵拈午梦长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62519,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"忆王孙 其一 春词","author":"李重元","text":"萋萋芳草忆王孙。\n柳外楼高空断魂。\n杜宇声声不忍闻。\n欲黄昏。\n雨打梨花深闭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62520,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次朱文公廓然亭韵","author":"李倜","text":"清晨出西郊，危径甃滑石。\n徐登九日山，眼观天地窄。\n沧溟渺无涯，云林森削壁。\n徙倚极遐观，感今怀往昔。\n而我遂幽寻，尘事忽如失。\n颀然隐君子，未审果何得。\n磨崖古题名，半含苍藓碧。\n日夕促归鞍，青山云乱白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62521,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还桑泽卿兰亭考二首 其一","author":"叶时","text":"书法光芒晋永和，后来摹写不胜多。\n考论又得桑夫子，兰渚风流转不磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62522,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戒事魔十诗 其六","author":"李兼","text":"蚩蚩女妇太无知，吃菜何须自苦为。\n料想阿童鞭背后，心中虽悔可能追。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62523,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戒事魔十诗 其七","author":"李兼","text":"仙居旧有祖师堂，坐落当初白塔乡。\n眼见菜头头落地，今人讳说吕师囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62524,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戒事魔十诗 其十","author":"李兼","text":"官家为是爱斯民，临遣知州诲尔谆。\n愿尔进知庠序教，怕嫌尔做事魔人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62525,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戒事魔十诗 其一","author":"李兼","text":"劝尔编氓莫事魔，魔成刬地祸殃多。\n家财破荡身狼籍，看取胡忠季子和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62526,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戒事魔十诗 其三","author":"李兼","text":"金针引透白莲池，此语欺人亦自欺。\n何似田桑家五亩，鸡豚狗彘勿违时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62527,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戒事魔十诗 其四","author":"李兼","text":"莫念双宗二会经，官中条令至分明。\n罪流更溢三千里，白佛安能救尔生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62528,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戒事魔十诗 其二","author":"李兼","text":"白衣夜会说无根，到晓奔逃各出门。\n此是邪魔名外道，自投刑辟害儿孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62529,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戒事魔十诗 其八","author":"李兼","text":"贵贱家家必有尊，如何舍祖事魔神。\n细思父母恩难报，早转头来孝尔亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62530,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戒事魔十诗 其九","author":"李兼","text":"肉味鱼腥吃不妨，随宜茶饭守家常。\n朝昏但莫为诸恶，底用金垆爇乳香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62531,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居苦","author":"李兼","text":"地僻尘心远，台高纵目赊。\n鹭明烟际渚，鸟篆雨馀沙。\n橡栗骈秋实，鸡冠媚晚花。\n断无车马客，来问野人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62532,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水阳道中","author":"李兼","text":"落日河西岸，春风水北桥。\n地迂帆影转，石出涨痕销。\n浊酿淋茅滓，赪鳞贯柳条。\n几年安稳处，才幸适今朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62533,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发于湖","author":"李兼","text":"断岸收潢潦，苍烟出翠微。\n众帆争鹁港，孤塔认枭矶。\n万事皆前定，重来悟昨非。\n此身縻薄爵，何处避危机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62534,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"田里","author":"李兼","text":"百谷盈成后，三秋假乐时。\n鸡豚开社瓮，箫鼓赛神祠。\n野茹青盈筥，香炊雪满匙。\n欲知田里趣，细诵老翁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62535,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石子涧","author":"李兼","text":"去郭无多地，肩舆又独来。\n青山随路转，老树挟溪回。\n映水深宜竹，皑林早见梅。\n颇思倾白酒，适意卧青苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62536,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"回次采石","author":"李兼","text":"千帆东下势连樯，控带河山自一方。\n塞角凄风营戍远，野花湿雨墓田荒。\n落霞孤鹜江干阔，去马来牛岁月长。\n老我声名无一遂，征衫蓝缕鬓苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62537,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵周与能","author":"李兼","text":"坠绪今如线，遗书尚满床。\n功名两蜗角，世路几羊肠。\n癖有登山屐，贫无在笥裳。\n故人应见念，莫遣字稀行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62538,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"舟中","author":"李兼","text":"昔向画图见，今行莽苍间。\n天连疑有路，湖阔更无山。\n地入番君国，星潜左蠡湾。\n江神相行客，未觉畏途艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62539,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送交代高丞","author":"李兼","text":"天涯客里送人归，恨绝青青杨柳枝。\n细雨杏园摩诘画，春风花岸少陵诗。\n九天抡擢堪先卜，万里功名莫后时。\n江上岂无西到雁，平安数遣故人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62540,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送桑泽卿归天台","author":"李兼","text":"野鹤昂然不可羁，伴行双屐一筇枝。\n屈公萧寺三旬客，益我空囊几卷诗。\n乱帙检残烧烛夜，浅杯流向落花时。\n春光只恋西湖好，不念台山老桂枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62541,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓出","author":"李兼","text":"凌晨躬蒇事，未晓出城关。\n路暗鸡三唱，天青月一弯。\n华香衣笥外，岚翠竹舆间。\n欲尽清游兴，官程索遽还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62542,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莎鸡","author":"李兼","text":"悲思亦何苦，繁声咽未休。\n家庭残月曙，衰草故园秋。\n物化终归尽，年华迅若流。\n要当期子夜，相与和商讴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62543,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄白云轩周道正","author":"李兼","text":"自往丹丘去，因循过一年。\n孤云无定止，明月又重圆。\n书尾间相问，琴声淡悄然。\n何时当会面，吟醉海涛边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62544,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春","author":"李兼","text":"筠窗幽独静亡邻，坐睡从吾一欠伸。\n绿树清圆宜静昼，孤花寂寞照馀春。\n时拈柏子烧铜鼎，旋碾茶团瀹玉尘。\n在昔刍荛犹足采，独惭无用养閒身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62545,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢当涂陈舍人馈姑孰春","author":"李兼","text":"门巷春风翳草莱，笔耕无艺甑生埃。\n空成洛下书生咏，敢望青州从事来。\n洗盏首供堂上寿，留尊更待月中开。\n陶然竟堕难名境，疑是凌歊百尺台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62546,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谢张世显诗卷","author":"李兼","text":"珍重张公子，交情不我遗。\n肯迂林下步，来贽袖中诗。\n江树烟中色，丛梅雪外枝。\n吟哦清绝句，一一可同时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62547,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"简丘倅即次韵","author":"李兼","text":"先生志尚直明庐，庀职毋嫌外且疏。\n聊向江城纡骥足，行趋禁闼侍鸾舆。\n河阳花树曾亲植，鲁相葵根欲尽锄。\n从此把君诗过目，绝胜厚禄故人书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62548,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"还桑泽卿兰亭考二首 其二","author":"叶时","text":"自从茧纸殉昭陵，定武流传剩得名。\n总辑旧闻为博议，即今真赝不难凭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62549,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"江上","author":"李兼","text":"晚来舣棹濒江侧，汀草蘋花间红碧。\n无声画里更斜阳，匹练光中正秋色。\n云间落帆系高树，烟外牧牛横短策。\n黄昏渔火乱前村，犹有孤吟未归客。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62550,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戒事魔十诗 其五","author":"李兼","text":"生儿只遣事犁锄，有智宜令早读书。\n莫被胡辉相引诱，此人决脊尚囚拘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62551,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"芳洲","author":"李兼","text":"芳洲日云夕，薄言撷兰荃。\n悠悠无与赠，脉脉空自怜。\n美人洵且都，为加一笑嫣。\n知己古所重，欲报甘縻捐。\n未省晼晚姿，可复成春妍。\n彼哉爨下桐，犹为朱丝弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62552,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"依韵和吴起季见寄","author":"李兼","text":"骐骥瘦，驽骀肥，不如占我白石矶。\n出无车，食无肉，宁复羡渠黄金屋。\n叔孙礼乐何纷纶，两生不行岂徒云。\n丈夫结交半天下，几人沮溺同耕云。\n捷径趋荣速如鬼，龌龊岂堪豪右齿。\n虞卿著书托穷愁，仲蔚绕宅蓬蒿秋。\n朅来话旧重携手，往事纷纷集樽酒。\n胸中奇气耿独在，匣剑时作蛟龙吼。\n穷亦乐，贫非痡，且复安步行坦途。\n从人嘲笑我非夫，乘流则逝宁须扶。\n亦知落落固难合，焉能郁郁屈此乎。\n朝驱车于阆风之颠，夕济舟于丹水之渊。\n放身物外岂不好，局蹐人间真可怜。\n追若亡，汗漫游，笑宁子，商声讴。\n岂曰无衣，与子同裘。\n天地一马，日月双辀。\n噫，流光胡可以淹留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62553,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉陪撄宁侍郎游柏山寺谒梅公墓小憩行轩勉酌","author":"李兼","text":"萧寺倚岩郭，昔游几何年。\n兹辰惬幽赏，杖屦从儒先。\n稍穿苍藓径，旋入青萝烟。\n山色若倒屣，松风自鸣弦。\n目力眩奇观，步屧信所便。\n俄登旃檀林，金碧耀脩缘。\n道旁老木拱，诗翁久飞仙。\n蝉蜕万物表，蝶梦三生前。\n至今二百载，相望箕斗悬。\n缅怀文忠公，丰碑泯遗镌。\n乐善如缁衣，后世两称贤。\n山僧矜好事，华表新题璇。\n向来委榛棘，时情任渠迁。\n先生笑抚掌，此事从古然。\n相逢一樽酒，劝君小流连。\n江梅欲浮动，春光向妖妍。\n同游二三子，舂容有佳篇。\n归欤不知夜，霜雪净寒天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62554,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋扇行","author":"李兼","text":"忆当九夏初，恒御君王手。\n西风飒然至，持用焉能久。\n人情易变如三秋，君恩覆水不可收。\n藉使凉飙夺炎热，感陨此身终不绝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62555,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钟山","author":"李兼","text":"白鸟江天阔，青山佛阁重。\n影孤寒日塔，声殷暮烟钟。\n异世文中选，当时镜里容。\n犹传遗蜕骨，只在此高峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62556,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"食兔","author":"林宗放","text":"弱质司明视，虚名直望舒。\n轶群辞上蔡，能事到中书。\n狡计空多窟，珍盘竟付厨。\n独将毫末效，曾纪汗青馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62557,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离家","author":"李兼","text":"送者临门庑，征人暮路歧。\n翻思津遣后，可奈独归时。\n岁旱田畴薄，家贫母子离。\n能忘手中绵，密密缀衣湿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62558,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]