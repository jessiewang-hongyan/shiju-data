[{"title":"赠净慈主人五首 其三","author":"陈造","text":"识君方吏虎存边，已叹疲羸雪满颠。\n别后漂零怯人问，穷山往返费三年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19044,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠净慈主人五首 其二","author":"陈造","text":"炊珠爨桂走门徒，须信高人道不孤。\n政使过门尽侯主，也须拳棒做工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19045,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠净慈主人五首 其一","author":"陈造","text":"平时野饭与岩栖，忽向皇都作住持。\n见说禅和蜂蚁聚，心闲祇似瑞岩时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19046,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠相士潘翁二首 其二","author":"陈造","text":"凉凉寂寂不关天，自诡诗穷五十年。\n君比老夫痴又甚，更教斲句当行缠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19047,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠相士潘翁二首 其一","author":"陈造","text":"平时镜里笑头颅，道我为官已近谀。\n但遣馀年犹甲子，不妨绛老尚泥涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19048,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠相者二首 其二","author":"陈造","text":"材同樗栎将安用，官带笭箵亦漫为。\n更欲品题人所弃，君痴尤胜老夫痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19049,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠相者二首 其一","author":"陈造","text":"人言庞艾可功名，独取臞儒子么生。\n槁项犹多吟拥鼻，好移君眼与公卿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19050,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠赵丞四首 其四","author":"陈造","text":"共约京都看早春，枣骝缓踏软红尘。\n要君弹压湖山景，莫惜新篇举似人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19051,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠赵丞四首 其三","author":"陈造","text":"我衰但作一廛计，认古宣城为故乡。\n待得故人来作牧，试吟打鸭起鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19052,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠赵丞四首 其二","author":"陈造","text":"君家鸾镜照芙蓉，笑我衣襦绽不缝。\n想见后堂颓醉玉，梁州按罢晚妆慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19053,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠赵丞四首 其一","author":"陈造","text":"老懒无诗到雪梅，僧窗驼坐拨萁灰。\n朝来好语成快读，匕箸惊投不为雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19054,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠郭高叔三首 其三","author":"陈造","text":"翠扇红牙浅黛愁，梁尘飞下晚云留。\n贯珠未竟金杯侧，却欠周郎一转头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19055,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠郭高叔三首 其二","author":"陈造","text":"燕台赋就尚缄囊，已作新声绕杏梁。\n见说负山常夜半，能言鹦鹉枉关防。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19056,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠郭高叔三首 其一","author":"陈造","text":"护香深閤写乌丝，有底朱楼望得知。\n与问天津倚栏客，庸非青琐窃桃儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19057,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠琴妓二首 其二","author":"陈造","text":"千纸争传戛玉词，一庭浑卧借书瓻。\n从今有问新知识，径说江城女项斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19058,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赠琴妓二首 其一","author":"陈造","text":"梦中曾揖蔡文姬，焦尾亲传半夜衣。\n莫向诗人弹别鹄，免烦衰泪对君挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19059,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"襄阳二首 其二","author":"陈造","text":"采药仙人去不还，鹿门山翠郁孱颜。\n霜髯尚困卑官缚，自问胡颜上此山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19060,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"襄阳二首 其一","author":"陈造","text":"自怜薄宦走红尘，相见山灵厌俗氛。\n咫尺岘山无计到，祇应飞雨是移文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19061,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁酉道中暮春","author":"陈造","text":"去家如昨日，节物转头非。\n风处绿自舞，雨馀红顿稀。\n野桥平水过，村路蹑花归。\n趁得酴醾在，筝琶拂旧衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19062,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"丁簿到芜湖书不至","author":"陈造","text":"几日到于湖，交情未合疏。\n相望百里地，不寄一行书。\n待此宽相忆，何人念索居。\n朔风吹雁断，徙倚正愁予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19063,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"七夕","author":"陈造","text":"龙旌凤扇一相迎，知费青禽几寄声。\n天上经年才旧约，人间转盼便深更。\n凉河只向樽前落，微月偏来酒面明。\n后夜玉琴弹别鹤，独应乾鹊梦魂惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19064,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日登神居留题","author":"陈造","text":"行行十刻冒风沙，骤喜深堂放马挝。\n旋报阴云漏红日，共追佳节把黄花。\n多烦沽酒留元亮，莫漫移文调孟嘉。\n未竟笑谭人树醉，檐栖片月欲翻鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19065,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"九日登楼","author":"陈造","text":"县曹逢节犹忙迫，阴雨乘秋每接连。\n九日欢娱异前日，几年晴霁有今年。\n湖山入座褰珠箔，萸菊挼香荐玉船。\n帽委西风判一醉，故人应未笑华颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19066,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"十六夜张丞有诗次韵","author":"陈造","text":"灯夕胜游皆遌意，可无歌酒答丰年。\n云藏玉斧重修月，乐奏壶仙小隐天。\n雁阵低空危欲堕，龙公驱雨未成眠。\n惟应铁锁银花句，落纸明朝万口传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19067,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又对厅","author":"陈造","text":"黄堂绿影转槐龙，锦绣围中度好风。\n珠履相辉人峙玉，金罍更劝酒如空。\n逢辰正自千龄会，胜日何妨一醉同。\n来岁从公话今日，钧天应簉未央宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19068,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又对厅","author":"陈造","text":"绿舆初下玉龟山，小驻黄堂相府莲。\n上客居多天下士，主人况自地行仙。\n九光霞里闻谭笑，三素云中度管弦。\n来岁日边桃荐碧，帝觞应共醉钧天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19069,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又通衢","author":"陈造","text":"清微风动万年枝，瑞纪流虹诞圣时。\n天上玉卮山比寿，侯邦锦席酒如池。\n满城淑气生英簜，夹道欢声度綵旗。\n来岁望公天仗侧，尚应回首记吴儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19070,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"又悼石湖老人","author":"陈造","text":"老商笑不待三年，枵腹人人得果然。\n商俗均沾傅岩雨，中行羞死绕朝鞭。\n探原已茹丘轲胾，落笔聊差屈宋肩。\n缅想神游知有处，定骖鸾鹤戏芝田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19071,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上巳溪上燕二首 其二","author":"陈造","text":"杜若洲边卓旆旌，佳晨一醉万金轻。\n春光仅有一分在，天气可能三日晴。\n解道兰亭亦陈迹，肯吟楚些怆幽情。\n人生到处皆儿戏，笑看争标斗两鲸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19072,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上巳溪上燕二首 其一","author":"陈造","text":"后溪分占羽觞浮，雷隐欢声半棹讴。\n况我闲官似犀首，为渠领客作鳌头。\n玻瓈影里妆光腻，桃李香中步障留。\n病骨得晴堪近酒，与君同拜醉乡侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19073,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上外朝山","author":"陈造","text":"度陇凌坡冒百艰，今朝又上外朝山。\n当车狠石通人过，交道飞萝要手攀。\n猿坐泬寥犹啸诧，雁惊巉绝故飞还。\n临风却快尘埃眼，全楚山川指顾间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19074,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"上峨桥早行","author":"陈造","text":"一从箠楚替陈编，渐惯山行野店眠。\n白氎风霜鸡唱后，黄尘岐路马蹄前。\n光阴付我千茎雪，伏腊何时二顷田。\n寄语淮乡隐君子，浪言梅福是神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19075,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山行寄程帅","author":"陈造","text":"雨馀支径湿平沙，恰称卑官下泽车。\n杂树暝烟森立槊，乱峰迎客俨排衙。\n水禽时弄蹁跹影，野草争开细碎花。\n久忆山行此如愿，不应回首更思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19076,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居十首 其十","author":"陈造","text":"丁年陪友旧，尘雾去骎骎。\n不赖学问力，终孤云水心。\n无波真古井，跃冶岂祥金。\n抚己知今是，扁舟钓碧浔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19077,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居十首 其九","author":"陈造","text":"一室市声外，生经良不孤。\n园花非独笑，风竹巧相娱。\n为客求鹅母，供家课橘奴。\n残年温饱尔，外此亦何须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19078,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居十首 其八","author":"陈造","text":"蕉鹿谢依乘，孤高乃得朋。\n闲谈每褐父，清晤或邻僧。\n止酒玄真子，居家杜伯升。\n此心安隐处，蜩鸴傲鹍鹏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19079,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居十首 其七","author":"陈造","text":"萍梗才糊口，爬沙亦畏涂。\n悠然三径地，有此百金躯。\n乘兴聊吟笔，无弦且槁梧。\n幽居喜客醉，未遣秫田芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19080,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居十首 其六","author":"陈造","text":"涉世惯多遌，还欣惬此心。\n鸡孙当岁稔，竹母值秋阴。\n言配香粳软，行须绿影深。\n继今摩腹去，风日更萧森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19081,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居十首 其五","author":"陈造","text":"鸟息我亦倦，行行取径微。\n石棱妨错足，藤蔓每钩衣。\n森木各天籁，连山同夕晖。\n推门吟袖冷，满带野风归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19082,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居十首 其四","author":"陈造","text":"居深自少客，儿辈省应门。\n日课午钟饭，生涯三亩园。\n嗜鱼亲蜑户，辍果及王孙。\n不惜苔钱破，横纵步屧痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19083,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居十首 其三","author":"陈造","text":"忽作断过访，经旬闲瘦筇。\n慵添和诗债，病减灌园功。\n石鼎袅轻碧，庭柯零碎红。\n竹君如见慰，竟日啸窗风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19084,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居十首 其二","author":"陈造","text":"咀毒横戈地，财堪博一羞。\n时流正攘臂，老子解抽头。\n秦楚蜗两角，蹠夷貉一丘。\n向来回晚照，了不见全牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19085,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"山居十首 其一","author":"陈造","text":"山间有好事，时肯问何如。\n束送箸头薤，鲜分匙面鱼。\n披襟偕我饱，揽发为君梳。\n一笑尘劳外，都无病可祛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19086,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"马息山","author":"陈造","text":"猿蹊鸟道且攀隮，暝霭顽苍只尺迷。\n狠石忽开防地裂，屯云不散讶天低。\n眼高欲了三千界，梦断犹惊七百梯。\n回望故山真可指，杜鹃肠断为谁啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19087,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书刘元之教授劄子后","author":"陈造","text":"碧酒清歌兴未央，挽留行色为风光。\n小人政自属餍足，老子工于作乐妨。\n舞雪放闲愁踏月，梦云惊散冷禁霜。\n明朝一寄相思字，旅雁无情亦断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19088,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书怀二首 其二","author":"陈造","text":"薄宦爬沙地，平生一不施。\n才名将底用，齿发欻如斯。\n自笑书汗马，谁今手不龟。\n惟馀五色笔，忍赋四愁诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19089,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书怀二首 其一","author":"陈造","text":"俛仰人间世，才为一笑资。\n百年羊胛熟，万事虎头痴。\n文字聊遮眼，功名浪朵颐。\n浮生如此尔，况复病馀衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19090,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"仁于庵","author":"陈造","text":"䆉稏围僧屋，檀栾隔槿篱。\n月池聊濯足，雪壁剩留诗。\n里社皆囷廪，钟鱼亦岁时。\n平生松隐赋，回首十年迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19091,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日","author":"陈造","text":"爆竹声中杂笑呼，斗杓插海寺钟初。\n椒觞带梦随小饮，桃板得诗仍自书。\n愒日晚涂知内讼，占风吉卜定非虚。\n新年旧管新收累，大府隆宽傥贷予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19092,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日访丁端叔安抚二首 其二","author":"陈造","text":"节中应接可辞烦，客子回车重慨然。\n比我过秦应一笑，想君出峡富千篇。\n前知此别非久别，定复新年胜故年。\n红药紫薇方次第，莫占风色问春田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19093,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日访丁端叔安抚二首 其一","author":"陈造","text":"几夜徒劳梦帝宸，行赀已橐更逡巡。\n北山祇合追逋客，南道于今欠主人。\n表表德名当世重，堂堂公议有时申。\n继今重策冲霄足，鹗表胡宁后隐沦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19094,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夜病起二首 其二","author":"陈造","text":"节物撩佳兴，浮生盍自宽。\n山城如许乐，灯市不多寒。\n微步漂香细，行歌惜夜阑。\n何人攲醉帽，朱袖簇归鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19095,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元夜病起二首 其一","author":"陈造","text":"霁色莫澄鲜，和声入管弦。\n人家无事日，时节放灯天。\n璧月红尘外，东风绿酒前。\n强陪儿女笑，病骨得轻便。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19096,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"厅事落成致语口号","author":"陈造","text":"向晚帘栊上玉钩，县人应指小瀛洲。\n龙兰烟外调宫羽，罗绮香中拥献酬。\n百祀规模新壮观，一时文武极风流。\n月明鼓吹烦重赋，终恐清新愧少游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19097,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"天申节致语","author":"陈造","text":"遐想云璈奏未央，璇舆金箓庆生商。\n九光霞里停仙仗，万岁声中奉帝觞。\n天上擗麟供乐事，人间舞凤侈恩光。\n小臣愿效华封祝，试颂灵椿寿圣皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19098,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太硕人臧氏挽章二首 其二","author":"陈造","text":"帝恩三沐寿亲筵，更数何人福庆全。\n纸眩鸾回馀旧诰，地占牛卧忽新阡。\n阴功不倚长年药，补处仍开上品莲。\n欲纪哀荣付丰石，诸儒当有笔如椽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19099,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"太硕人臧氏挽章二首 其一","author":"陈造","text":"德风千祀蔼芳馨，生享修龄殁更荣。\n早岁衣冠贤德耀，莫年门户寄升卿。\n迹陈莫嗣登堂拜，匏系空驰执绋情。\n里巷万人缌布会，一应如我泪河倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19100,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"文炳近岁节感怆作诗宽之","author":"陈造","text":"严侯才气旧无朋，晚作江淮肉食僧。\n饱对风烟吐膏馥，时因节物动销凝。\n君今宛是林和靖，我亦何如杜伯升。\n浊酒寒菹共一笑，未妨同剔课诗灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19101,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题三首 其二","author":"陈造","text":"浪出嗟何补，归来乐有馀。\n山川付不借，天地托蘧庐。\n酒熟聊呼客，钩垂不在鱼。\n平生栖遁意，政用盖迂疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19102,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题三首 其三","author":"陈造","text":"卧病十四五，秋来身自轻。\n已拚不籍在，宁复可怜生。\n每笑隐者传，尚存身后名。\n灌园聊日力，分药且交情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19103,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"无题三首 其一","author":"陈造","text":"薄宦受风梗，还家归岫云。\n行人与乔木，老色竟平分。\n末路惭周朴，穷交有墨君。\n看渠绶若若，千骑诧乡枌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19104,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"王母致语口号","author":"陈造","text":"天仗凌晨拱未央，君王亲奉紫霞觞。\n社鸣当纪乾坤辟，筴授端知日月长。\n为祝尧龄辞翠水，闲留羲驭顿扶桑。\n儿家不上千秋鉴，自摘蟠桃寿圣皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19105,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"邓倅有诗次韵","author":"陈造","text":"袖手从公辟不怀，天心月胁有馀才。\n将坛贾勇知无敌，册府新除定见催。\n楚国谁今衙屈宋，欧门我亦后苏梅。\n锦囊得句无虚日，尽卷淮山胜槩回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19106,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冬至","author":"陈造","text":"至节占天意，丰登又必然。\n相风绿漪静，宾日矞云鲜。\n比屋皆生意，穷阎有醉眠。\n端容衰病宰，索句海山前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19107,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"对客再次韵","author":"陈造","text":"客来一笑同乡味，便粉秋菰刷藕泥。\n糟浥子姜仍旧法，笼缄乾笋俨新题。\n白鱼紫蟹空濡沫，窘兔惊麋想砀迷。\n自揣臞儒合蔬粝，放麑终恐愧巴西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19108,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归有日喜作","author":"陈造","text":"夜灯晨饭棘围重，槛束飞猱鹤在笼。\n敢效骚人悲迫阨，祇防举子诮冬烘。\n抟风定有庄鹏化，得隽从知冀马空。\n明日还家压新酒，菊登金蕊拒霜红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19109,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归自湖西","author":"陈造","text":"晨具湖西饭，还家腹果然。\n怒风长擘席，急浪不鸣船。\n身觉青冥上，情留白鸟边。\n衰年端一快，整帽向云天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19110,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"归欤老秋","author":"陈造","text":"已办求田问舍谋，登临那复更悲秋。\n蟹肥与客争先把，稻熟催儿彻晚收。\n霜后峰峦添峭措，波间鸥鹭剧风流。\n寰中胜处天应惜，付与痴儿祇暗投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19111,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"正月十六夜大雪次张守诸公韵二首 其二","author":"陈造","text":"诗款铃斋到即通，细工时肯博粗工。\n政声已独当时步，人士饫观前辈风。\n未分清新命开府，可能简远尽安丰。\n谭间和气熏人醉，不觉栖栖客路中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":19112,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]