[{"title":"又和寒食感怀","author":"韩维","text":"絮飞丝堕满春阴，叹息流光节物深。\n鸡鞠自喧游侠地，莺花空思长年心。\n寂寥功业看孤剑，淡薄情怀寄素琴。\n我亦新来有华发，并须携酒白头吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与林大夫谢灵寿杖","author":"韩维","text":"万岁山中美木成，古今灵寿得嘉名。\n龙鳞未测他年化，蜗角先从每节生。\n禅拟问来须便打，醉思吟后不妨行。\n使君有惠怜衰薾，欲报惭非藻思清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久雨奉怀象之九兄","author":"韩维","text":"萧洒崔居士，高闲养性灵。\n凉风满樽酒，永日一函经。\n竹色垂遮户，桐花开满庭。\n未嗟相见阔，交照本忘形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"之石桥","author":"韩维","text":"闻说西桥水树间，不辞驱马涉风烟。\n疏篱老屋临官道，瘦棘荒茅蔽石田。\n欲下鸣鸦盘木末，远来惊雉落山前。\n瓢中幸有村醪美，不怕春寒雨满川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"之雍丘舟中奉寄少述处士明叔公缊","author":"韩维","text":"柔橹咿哑画鹢东，翛然清兴不知穷。\n新秋草树轻凉外，落日帆樯远思中。\n人事感心怀素友，年华催鬓作衰翁。\n江湖旧约今仍负，肠断从南万里风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"千叶梅","author":"韩维","text":"南园卉木遍春光，独爱琼葩掩众芳。\n不为雪摧缘正色，忽随风至是真香。\n未经采折携樽酒，忍见飘零入野塘。\n醉客为予簪白发，栏边几作少年狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"予会宾答微之惠诗","author":"韩维","text":"官冷身闲百不营，一时高会得耆英。\n杯心酒气兼香重，池面水华共月清。\n铁骑忽从弦上出，水龙争向笛中鸣。\n白头学士耽禅习，未免诗魔搅道情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"予招宾和微之","author":"韩维","text":"恩予琳宫庇病身，闲中得近酒杯频。\n偶成五老追前会，仍喜三公作主宾。\n欢兴到来歌自发，吝情消尽语皆真。\n时人不用惊疏放，同是羲皇以上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云","author":"韩维","text":"抱石情虽久，为霖意若何。\n天心如见用，风力不消多。\n冷湿朝仙洞，寒迷宿鸟窠。\n飞扬终得路，曾入汉皇歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"从厚卿乞移水仙花","author":"韩维","text":"翠叶亭亭出素房，远分奇艳自襄阳。\n琴高住处元依水，青女冬来不怕霜。\n异土花蹊惊独秀，同时梅援失幽香。\n当年曾效封培力，应许移根近北堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日寄袁州仲文兄","author":"韩维","text":"前日都门尽鹢飞，秋风执别泪交颐。\n清朝远谪庸非命，直道终申自有时。\n佳句应因子卿赋，胜游仍共鹡鸰期。\n宜春台上春归早，谁伴花前酒一卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"公时遗石榴","author":"韩维","text":"高冠趋尹君方掾，促席迎宾我已翁。\n交态不忘平日厚，歌声犹似少年工。\n映阶露菊秋吟苦，盈筥霜榴岁问通。\n每与东邻话知旧，白头强健几人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"公美侍郎赋诗见诒次韵答谢","author":"韩维","text":"哭兄悲友老来情，默默终朝究道精。\n双毂幸回贤者驾，一觞聊展故人诚。\n身随风力常无住，辩若河源每自倾。\n早晚东城见华屋，与君垂白话无生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六弟亲诣松楸时祭","author":"韩维","text":"上冢还家古所荣，白头今日倍伤情。\n怀今又出高阳里，夹道争看太守旌。\n应念少游尝有语，可能疏氏独高明。\n昔湖水色清堪濯，毋使尘埃久污缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"化光殿丞谒告还里某数奉游集蒙赋诗道旧辄依元韵","author":"韩维","text":"定契多惭国士知，交欢重喜故人期。\n莫辞日嚼千觞酒，况值春归百卉枝。\n披竹共寻前会处，插花仍学少年时。\n词章褒纪明情重，坐讽行吟刻屡移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水阁","author":"韩维","text":"约略横云岛，栏干瞰玉渊。\n雨汀翘睡鹭，风树咽嘶蝉。\n绿发莓苔地，红衣菡萏天。\n夜深三弄笛，月在钓鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王岩叟招饮南园","author":"韩维","text":"翠木珍丛百亩间，我来虽晚及春残。\n未嗟流景飘蓬疾，犹喜馀芳对酒看。\n斜照舒迟明埤堄，清阴迢递覆栏干。\n凭君莫剪高花尽，留插游人醉后冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长安留别七弟兼简刘郎","author":"韩维","text":"二年牢落坐回山，平日交亲梦寐间。\n关外相逢非素约，樽前一笑慰衰颜。\n匡衡沿牒朝廷远，王粲从军幕府閒。\n跋马题诗离绪乱，霜风萧飒鬓毛班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东郊","author":"韩维","text":"东郊丝雨破浮埃，绣骑寻芳两两来。\n十亩霜阴青翳目，一篙溪色碧于苔。\n林花泛日莺求友，垄麦含风雉应媒。\n绿柳朱栏多酒市，杖头谁伴玉山颓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东禅院坐上作","author":"韩维","text":"山林曾是自由身，岂合区区入世尘。\n萧散未能忘故态，优游聊喜及时春。\n闲中浊酒偏亲我，风外飞花欲趁人。\n多谢鸣鸠催对雨，坐惭无术粒斯民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵君俞偶成 其一","author":"韩维","text":"我道非生灭，天时自去来。\n交亲常在席，醪酒不空罍。\n默坐唯听水，閒行忽见梅。\n何人同此适，君意亦悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵君俞偶成 其二","author":"韩维","text":"雪意凝还解，冰纹结复开。\n林鸦时啸侣，城雉不忧媒。\n造适心无碍，忘机语绝猜。\n曹溪不欺我，何处有尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬日喜雨呈稚卿景仁","author":"韩维","text":"严冬温气袭人间，忽听繁声慰病颜。\n从律好风千里至，执权真令一朝还。\n顿抽陇麦全如揠，欲绽江梅已可攀。\n主尹勤民嘉岁望，径携歌鼓乐幽闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬夜","author":"韩维","text":"繁阴扫无迹，庭雪尚馀光。\n屋背生寒月，林梢绡暗霜。\n昏瞳频废卷，悲泪易沾裳。\n却想故园夜，张灯宿草堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北园坐上探题得新杏","author":"韩维","text":"红蘤随风尽，团枝泣露光。\n叶深惊乍见，实小贵先尝。\n点缀怜馀萼，飘零惜旧香。\n不须悲节物，且喜手中觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"去冬蒙君实示嘉篇懒拙不即修谢临书走笔深愧浼渎","author":"韩维","text":"南园百草雨中秋，把烛题诗寄驿邮。\n意重不辞终日看，韵强深愧隔年酬。\n登山屡赴幽人约，筑野犹稽圣主求。\n命驾幸无千里远，春湖舣楫待君游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"史局坐寝戏呈崇文掌学士","author":"韩维","text":"闲官身散诞，饱食坐攲斜。\n永日槐阴静，清风葆鬓华。\n废书良愧马，落帽偶同嘉。\n此适谁知者，逢人莫浪誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对雪看梅","author":"韩维","text":"持梅况酒诚为得，对雪看梅始见真。\n失素定应潜送腊，露红如欲巧矜春。\n神凝姑射今仍在，云覆巫峰晓更新。\n谁识仙家事严秘，舞妍妆靓不传人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对雪送花走笔况之","author":"韩维","text":"春阴黯黯压城低，乱扑帘帷细点衣。\n梅蕊更寒犹竞发，杨花未暖忽先飞。\n便思樽酒陪公议，敢望笙歌近使威。\n绝景坐嗟清燕隔，一篮朱白慰旋归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"对雪偶成三颂呈芳公长老兼简收贵二上人 其三","author":"韩维","text":"谁识天公造化情，珠楼玉殿一朝成。\n色空无有何能辨，陵坎高低本自平。\n定见乌鸡遭指注，宁分皓鹤失鲜明。\n可怜辛苦齐腰客，不悟纷纷觌面呈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玉汝弟创治新居作诗见诒次韵为答","author":"韩维","text":"止足嘉言每念兹，不应华发叹归迟。\n非关启第誇三战，直为营巢欠一枝。\n盛放清风来北户，细分鸣溜入西池。\n十年契阔多遗恨，今日欣同仲氏篪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"伏蒙三哥以某再领许昌赋诗为寄谨依严韵","author":"韩维","text":"久陪法从常怀愧，再领乡州始觉荣。\n政事敢言前可继，宠光深见古为轻。\n预装白酒留春盎，旋剪红葩出洛城。\n两道况闻时泽足，不妨吟啸玉杯倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"会微之诸君","author":"韩维","text":"开斋坐阅岁华空，乐与贤豪燕喜同。\n清影屡移松桂月，和声频送管弦风。\n远于籍外追歌妓，恨不樽前作醉翁。\n况近始郊多废事，共迎萧露入弦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和二首 其二","author":"韩维","text":"应为开门近太清，故携歌管逐双旌。\n酒逢欢后宁论量，语到真时不属情。\n木叶吟风千籁作，菊丛含雨万珠明。\n知公几案常丰暇，诗思如泉日夜生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和二首 其一","author":"韩维","text":"壮岁希高事独清，介然何意慕三旌。\n无邪每奉先儒戒，有犯常存狷者情。\n任重股肱惭暗弱，老全骸骨赖休明。\n非因大旆闲来往，仲蔚蓬蒿绕舍生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和乐道","author":"韩维","text":"凤凰台下芳林合，鸭子陂中绿水深。\n不惜清光输曲沼，欲将幽韵伴鸣琴。\n馀波及晋良惭昔，春服沿沂正在今。\n洗耳濯缨何足道，愿同沉醉复高吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和昌言喜雪 其二","author":"韩维","text":"愧无奇策辅吾皇，乞得闲官老故乡。\n壮志未甘悲白发，欢情犹看舞红妆。\n长歌不计闲光景，吟苦难滋旧肺肠。\n多谢同心二三友，每传佳句挹华觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和昌言喜雪 其一","author":"韩维","text":"精祷潜通上下神，恍然佳气一朝新。\n隆楼杰阁偏宜晓，槁木残荄尽变春。\n有客裁诗传锦段，谁家度曲试朱唇。\n相思不得相从乐，虚作箕嵩无事人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再游卞氏园亭","author":"韩维","text":"多谢春风意，残芳得我游。\n绿阴人去远，翠竹鸟啼幽。\n醉舞纷无次，狂歌漫不收。\n林间簇车马，欲去尚迟留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同三兄安公亭看雨","author":"韩维","text":"高堂六月苦炎曦，雨逐轻雷过后池。\n水面凉生跳赤鲤，林端声寂语黄鹂。\n翠深岸筱无风乱，红重蔷薇到地垂。\n清景虽嘉欢意少，白头支策坐题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同士则游西湖","author":"韩维","text":"今日西湖好，来游未觉喧。\n柳枝风处乱，花艳暖中繁。\n桥远归人渡，舟移集鸟翻。\n何须更樽酒，道胜有清言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同化光饮象之家","author":"韩维","text":"又从邻舍客，来折主人花。\n游处当年似，悲伤老去加。\n兴长歌易放，情密语无哗。\n归路生残月，春风醉袂斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同化光陪宁极之滍阳城","author":"韩维","text":"不踏南溪路，于今五换春。\n能来再联骑，还是旧游人。\n置酒真乘兴，谈经或入神。\n欢馀不无愧，林壑未还身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同江谢王出郊","author":"韩维","text":"东郊二月天，寒尽未成暄。\n永日青丝骑，和风绿酒樽。\n径抽萱甲细，墙倚杏梢繁。\n烂醉谁知者，行歌入国门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同芳公上人游湖","author":"韩维","text":"晴阳溢目尽光华，乘兴闲来步径沙。\n水满不知新穫稻，霜严犹放后凋花。\n传心密处宁离妄，著眼高时亦是邪。\n竟日清谈何所得，鱼沉鹭起各归家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同曼叔化光游卞氏园","author":"韩维","text":"野圃无人到，秋风共子行。\n花临流水落，草上废台生。\n气晚才看菊，天寒不见莺。\n幽闲固多味，浊酒讵须倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和永叔雪","author":"韩维","text":"二十年来野逸身，懒能奔走傍埃尘。\n偶逢闾里闲游伴，同过丛林燕坐人。\n世事纠纷宁有尽，劳生萧散不妨频。\n晴阳缓辔殊多适，它日重来访道真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"后园杂花特献辄书呈子华兄","author":"韩维","text":"向晚低云还作雨，稍寒飞雪又随风。\n新芽展尽枝头绿，落蘤飘成水面红。\n身外有名皆是妄，杯中无物未为通。\n扁舟少待暗阳放，西阁何妨一醉同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"字谷道中","author":"韩维","text":"驱车背河去，鸡犬几家村。\n山断春风急，云生野气昏。\n涉溪沙水乱，步径草花繁。\n谷口多幽思，青林啼鸟喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏月","author":"韩维","text":"缺处还孤守，圆时亦独栖。\n何曾闻合璧，只见是如圭。\n桂子遗秋信，方诸寄夜啼。\n建章残漏促，又伴玉绳低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵","author":"韩维","text":"势利拘牵无已时，超然真乐绝端倪。\n家风淡寂从今见，人事尘劳与我暌。\n门外旌旗犹坌拂，辕间款段已鸣嘶。\n何当解组如初约，直与西京二傅齐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵玉汝","author":"韩维","text":"浮生难得是华颠，美景能并属禁烟。\n况值公庭多暇日，且欣农亩兆丰年。\n曾裁酒量容杯斝，谓品歌声被管弦。\n莫道老人无气力，能排万事付陶然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵玉汝弟乞致仕不允","author":"韩维","text":"人生大节在行藏，七十归休有旧章。\n红旆碧幢虽帝宠，紫嵩清颍是吾乡。\n老依莲社心冲寞，梦绕榆关路杳茫。\n何日安车解归鞅，浊醪鸡黍晏东岗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵君俞","author":"韩维","text":"世事真千变，年光又一新。\n举生皆是幻，熙我莫如春。\n啸傲盈樽酒，诗书满席尘。\n园林已芳意，悬榻待高人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和三兄田家","author":"韩维","text":"东皋雨新足，绿野对柴扉。\n晴日风景旷，暮春草木肥。\n好鸟依林响，疲牛望舍归。\n饷妇散田陌，桑间人语稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和之美十日菊","author":"韩维","text":"孤根随地发，繁蕊破霜迟。\n但取凋零晚，何忧赏爱移。\n物情伤老大，人事阅兴衰。\n会有陶彭泽，清樽与重持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和厚卿答微之","author":"韩维","text":"秉节当官号直清，非招不往为虞旌。\n书闻玉座光儒效，任久琳宫长道情。\n老纵笔锋尤壮健，醉评花艳益精明。\n吾人岂是蓬蒿士，默默拘挛过一生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵和唐公北使途中见寄二首 其一","author":"韩维","text":"文史平居乐，尘埃少别心。\n都门开柳色，樽酒驻车音。\n汉节光华远，春风藻思深。\n一闻传丽句，清兴霭盈襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵奉同景仁答微之","author":"韩维","text":"鸦腹灵砂养就丹，知公不复更衰残。\n洛川花下经春醉，潩水亭边尽日欢。\n白发高吟思老笔，青娥嘉赠伫华鞍。\n淮阳过客如相问，莫道闲人姓范韩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵奉答四哥廷评欲垂访以诗为示","author":"韩维","text":"再临乡国两逢春，乞与优闲荷帝宸。\n德薄敢同商四老，论狂难预汉诸臣。\n行吟水际花粘履，燕坐林间絮点茵。\n早晚湖波照车马，为君酌酒鲙鲜鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵奉答君俞","author":"韩维","text":"闾里幽居几案前，迹虽相异意同然。\n禅书罢阅成端坐，讼牒希投得晏眠。\n情累已知超永劫，身名那复计当年。\n才疏政拙逢嘉岁，敢窃天功自谓贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵答景仁喜雨","author":"韩维","text":"凉云四向复，沴气一消沉。\n上天垂景贶，高秋沾喜霖。\n槁苗变新实，时菊抽芳心。\n聆君得意句，起我掉头吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江亭晚眺","author":"韩维","text":"日下崦嵫外，秋生沆砀间。\n清江无限好，白马不胜闲。\n雨过云收族，天空月上弯。\n归鞍侵调角，回首六朝山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自城南濠上步月之葆光","author":"韩维","text":"厌踏尘中路，远寻濠上行。\n水声喧夜堑，月色满春城。\n衎衎交游乐，依依里巷情。\n优哉不知老，何暇慕轩缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西轩会中与辛杨诸君同赋","author":"韩维","text":"一笑聊为适，非关事赏心。\n芳菲逐风尽，时序感人深。\n世事无多问，香醪且细斟。\n更须乘月色，潇洒坐中林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西轩雨中期象之夜话","author":"韩维","text":"积雨空堂暮，清宵独掩门。\n陈编徒自对，幽兴欲何言。\n碧草生墙角，丹花发竹根。\n聊持静者辙，一与道人论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":23869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]