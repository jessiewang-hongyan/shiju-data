[{"title":"宿不老山 其一","author":"方岳","text":"未必催租能办诗，不妨扶老上烟霏。\n彭仙一去夜坛冷，老鹤不归云自飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7857,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿不老山 其二","author":"方岳","text":"借得松风一觉眠，旋烧枯叶煮山泉。\n人间蚁蛭王侯梦，不到梅花纸帐边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7858,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿芳润用壁间韵","author":"方岳","text":"只为梧桐怨夜长，不知杨柳老年芳。\n林梢一片过云雨，便作秋声占取凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7859,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"客饟银茄不敢送场屋士","author":"方岳","text":"秋风谁怒水中蟹，昨梦不疑杯里蛇。\n迸齿清寒银粟粟，不随盐酪供毗耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7860,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄梅","author":"方岳","text":"枝北枝南恨未除，春风误到寿阳居。\n诗家不识梅花讳，把做好看誇道渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7861,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄游山友人","author":"方岳","text":"不是山阴访戴船，真成迷局烂柯仙。\n径行处用规摹取，归与都人作画传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7862,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄越友 其一","author":"方岳","text":"茂竹脩林已陈迹，禹穴剡溪俱胜游。\n秋风倘未理归梦，我欲买船官渡头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7863,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄越友 其二","author":"方岳","text":"湖山掩映信乐国，烟雨凄迷非故乡。\n青灯何日一杯酒，江头极目吴山长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7864,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题赵德成东岩 其三","author":"方岳","text":"空山谁可閒来往，自种梅花伴月明。\n小筑便为身后计，此奇千古未忘情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7865,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题赵德成东岩 其二","author":"方岳","text":"人间无处著我辈，只可飞泉藓石边。\n习气犹馀子虚赋，苦令猿鹤怨风烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7866,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题赵德成东岩 其一","author":"方岳","text":"好山倒合诗人管，新出东岩付此公。\n略向画图曾半面，石床定许听松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7867,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题章氏起青楼 其一","author":"方岳","text":"结楼多与青山对，却是青山不对渠。\n见说蜃岩排闼入，一窗晴色共残书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7868,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄题章氏起青楼 其二","author":"方岳","text":"寒青拔起二千石，山是一分云一分。\n切莫向渠谈世事，怕渠说与沈休文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7869,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得祠 其二","author":"方岳","text":"石床散发洒松风，安用黄冠累此翁。\n但喜太平今有象，渔樵亦在万几中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7870,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"得祠 其一","author":"方岳","text":"十年梦不到清都，云满寒蓑雪满颅。\n一片青山一黄犊，底须更著旧称呼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7871,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼栖云主人","author":"方岳","text":"羽士岩前烟树深，乱云堆屋自无心。\n鹤惊蕙帐夜岑寂，霜月正寒愁不禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7872,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚秋犹热 其二","author":"方岳","text":"适自相遭各有时，莫悲团扇与秋辞。\n班姬不死天无准，定悔当时作许悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7873,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚秋犹热 其一","author":"方岳","text":"九月年时已肃霜，今年九月尚追凉。\n幸吾絺绤犹无恙，杜老何烦苦自伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7874,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花 其四","author":"方岳","text":"茅茨烟水隔孤村，雪冷谁敲月下门。\n只与梅花曾有旧，暗香时肯到洼尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7875,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花 其三","author":"方岳","text":"雪压横枝卧浅波，三花五蕊不须多。\n平生为尔添诗兴，今日无诗奈尔何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7876,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花 其一","author":"方岳","text":"竹绕疏篱水绕村，一枝无语更黄昏。\n暗香似识骚人意，月澹无风自入门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7877,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝 其十","author":"方岳","text":"竹缘货殖比封君，松爱微官不避秦。\n至竟羞与哙等伍，岁寒谁障庾公尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7878,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝 其二","author":"方岳","text":"日日寻梅未肯春，几番和月倚吟身。\n一枝斜入丛篁里，人不见渠渠见人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7879,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝 其四","author":"方岳","text":"是处溪桥浅带流，山中别有一深幽。\n规模略比林君复，开上风烟顶?头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7880,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝 其一","author":"方岳","text":"尽道春风有等差，从前谩语待诗家。\n今年雪屋亲曾见，的当南枝先著花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7881,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝 其八","author":"方岳","text":"三分香有七分清，月冷霜寒太瘦生。\n山泽之儒君识否，乐天姓氏谪仙名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7882,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝 其五","author":"方岳","text":"自插斜枝垫角巾，诗狂又有老精神。\n黄昏酒醒欲归去，月出山来唤住人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7883,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝 其七","author":"方岳","text":"逋仙解道影南斜，二百年来蔑以加。\n别有脱胎诗一句，自从梅后更无花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7884,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝 其三","author":"方岳","text":"自有诗来几许诗，玉堂吹彻又茅茨。\n阿谁不爱梅花句，未省梅花爱阿谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7885,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅花十绝 其六","author":"方岳","text":"老树生苔冻欲枯，山村雪意晚模糊。\n一梢横打竹边过，造化工成水墨图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7886,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦中 其一","author":"方岳","text":"凡我同盟鸥鹭群，既盟之后亦幽欣。\n山中芝朮香堪煮，鹤未归来空暮云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7887,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦中 其二","author":"方岳","text":"树擎晚色柔枝碧，兔睡晴香老月寒。\n自滴玉蜍秋满袖，轻云片片泊阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7888,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦中","author":"方岳","text":"屋头晴哢已交交，更向春风打一遭。\n花片已肥红欲绽，柳丝烟重绿如缫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7889,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦过湖","author":"方岳","text":"万柄风荷秋渺然，百钱又买过湖船。\n菰蒲鸥鹭浑相识，惊怪人间已十年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7890,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦放翁为予作贫乐斋扁诚斋许画斋壁予本无是斋亦不省诚斋之能画也","author":"方岳","text":"晴窗欲晓鸟声春，唤起藜床入定身。\n老去不知三月暮，梦中亲见两诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7891,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明","author":"方岳","text":"淡烟疏雨清明日，飞絮落花游子心。\n燕话春愁初睡起，一帘草色暮池深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7892,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日舟次吴门 其二","author":"方岳","text":"片片飞花更异乡，人家插柳抵愁长。\n晴沙烟草几今古，春去春来燕子忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明日舟次吴门 其一","author":"方岳","text":"篷窗恰受夕阳明，杨柳梨花半月程。\n老去不知寒食近，一篙烟水载春行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父词 其二","author":"方岳","text":"阴阴深树晚生烟，雨急归来失系船。\n白鹭不惊沙水浅，依然共在绿杨边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父词 其三","author":"方岳","text":"烟波渺渺一轻篷，浦溆生寒芦荻风。\n昨夜新霜鱼自少，满江明月笛声中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父词 其四","author":"方岳","text":"沽酒归来雪满船，一蓑撑傍断矶边。\n谁家庭院无梅看，不似江村欲暮天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父词 其一","author":"方岳","text":"晚晴铺网占鸥沙，各自分鱼就酒家。\n洞口醉眠船正暖，碧桃流出两三花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"猫叹","author":"方岳","text":"雪齿霜毛入画图，食无鱼亦饱于菟。\n床头鼠辈翻盆盎，自向花间捕乳雏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祷晴福善 其三","author":"方岳","text":"背犊腰牛忽解颜，摩挲一饱政相关。\n王于霓望无终极，孰与侯邦年岁间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祷晴福善 其一","author":"方岳","text":"稻压田塍米似珠，老农为说几年无。\n一晴不费君王力，莫等香烟上化炉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"祷晴福善 其二","author":"方岳","text":"夜落檐花未肯晴，灯寒等不到天明。\n自怜短发垂垂老，一滴秋霖白一茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中","author":"方岳","text":"行缠不了醉生涯，空宿沙头卖酒家。\n最是晓寒吟未稳，雪深无面见梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中观梅","author":"方岳","text":"落尽梅花合一杯，雪深无复旧莓苔。\n山溪莫遣人行破，安得酒从天上来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪中迓新宪","author":"方岳","text":"踏碎琼瑶千里寒，新年才此试吟鞍。\n不须更说逢迎恶，只作灞桥诗兴看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后草亭","author":"方岳","text":"梅花面目冷于冰，亦笑山翁草作亭。\n一夜雪寒重整过，碧琉璃瓦水晶钉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后梅边 其六","author":"方岳","text":"小小茅亭面面寒，玉花能薄雪花乾。\n今年不是开迟著，等得群花比并看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后梅边 其十","author":"方岳","text":"春风且莫一齐开，留与山翁逐日来。\n只恐难将冰雪面，伴渠桃李并尘埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后梅边 其一","author":"方岳","text":"老来筋力倦登山，契阔梅花几日间。\n莫与梅花筋力倦，且推一雪阻跻攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后梅边 其八","author":"方岳","text":"野径茅茨竹作墙，岁寒曾亦几平章。\n高人风味天然别，不在横斜不在香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后梅边 其三","author":"方岳","text":"半身苍藓雪槎枒，直到顶头才数花。\n看尽玉林山上下，还须渠是当行家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后梅边 其二","author":"方岳","text":"与君只隔竹笆篱，踏雪过从自一奇。\n开口便遭花问当，老夫愧面了无辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后梅边 其四","author":"方岳","text":"花中淡伫只梅花，未见梅中萼绿华。\n一色琼瑶裾织翠，尚嫌红蜡蒂村些。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后梅边 其九","author":"方岳","text":"寒雀群飞最上头，啄残香玉翠云裘。\n老坡诗里么么凤，待与梅花渠是不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后梅边 其七","author":"方岳","text":"一枝密密一枝疏，一树亭亭一树枯。\n月是毛锥烟是纸，为予写作百梅图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪后梅边 其五","author":"方岳","text":"玉蕤五出是天姿，六出时时更绝奇。\n夜半同参雪花去，春风元自不曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"堪笑 其三","author":"方岳","text":"堪笑刘安苦学仙，云中鸡犬事茫然。\n早知官职乃如许，悔不人间差自贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"堪笑 其五","author":"方岳","text":"堪笑张华死不休，谩精象数古无俦。\n中台星拆何曾识，祗识龙泉动斗牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"堪笑 其四","author":"方岳","text":"堪笑山阳汉鼎移，智如文若岂难知。\n定嫌佐命居人后，略一昌言死亦痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"堪笑 其一","author":"方岳","text":"堪笑平原血溅衣，但知忠义未知机。\n命悬鬼貌千秋事，年及悬车自不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晴梦","author":"方岳","text":"尘土侵人懒出门，小窗容我负晴暾。\n梦骑瘦马寻诗去，曾到梅花深雪村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暑中杂兴 其五","author":"方岳","text":"是非不到野溪边，只就梧桐听雨眠。\n睡熟不知溪水长，鹭鸶飞上钓鱼船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暑中杂兴 其八","author":"方岳","text":"只锄蔬甲亦妨閒，久与溪云断往还。\n今日偶来僧却在，共煎茶吃话庐山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暑中杂兴 其三","author":"方岳","text":"今年不上一竿竹，渠岂于人亦世情。\n风雨尚馀千个在，结巢吾欲听秋声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暑中杂兴 其一","author":"方岳","text":"一刻之间值万金，苦无人可共幽襟。\n几年不作西湖想，听得啼莺不自禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"暑中杂兴 其二","author":"方岳","text":"不惯山中夜月寒，满窗树影藓花乾。\n移床近壁不敢卧，恐是龙蛇之屈蟠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游九曲 其一","author":"方岳","text":"掀蓬仰看玉峥嵘，借得渔船一日晴。\n九曲水穷山雨急，老仙于我岂无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游九曲 其二","author":"方岳","text":"鹤怨空山久勒文，买船又访武夷君。\n一声铁笛不知处，但觉满身生白云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游九曲 其三","author":"方岳","text":"莫问神仙定有无，地灵断不著凡夫。\n我来便觉芒鞋好，飞上前山不用扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上八首 其一","author":"方岳","text":"沙暖鸳鸯傍柳眠，春来亦懒避湖船。\n佳人窈窕惜颜色，自照晴波整翠钿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上八首 其二","author":"方岳","text":"今岁春风特地寒，百花无赖已摧残。\n马塍晓雨如尘细，处处筠篮卖牡丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上八首 其八","author":"方岳","text":"鞦韆人散雨千丝，谁把秦笙隔院吹。\n但觉小桥烟外柳，春风无力逞腰支。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上八首 其五","author":"方岳","text":"春连禁籞绿阴交，对面晴烟舞翠蛟。\n最是君王游幸少，宫花浑未识鸣鞘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上八首 其四","author":"方岳","text":"绿波如画雨初晴，一岸烟芜极望平。\n日暮落花风欲定，小楼弦管压新声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上八首 其六","author":"方岳","text":"连天芳草晚凄凄，蹀躞花边马不嘶。\n蜂蝶已归弦管静，犹闻人语画桥西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"湖上八首 其三","author":"方岳","text":"轻尘不动雨霏微，堤外芹香燕子飞。\n庭院日长帘幕静，含情脉脉看春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":7936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]