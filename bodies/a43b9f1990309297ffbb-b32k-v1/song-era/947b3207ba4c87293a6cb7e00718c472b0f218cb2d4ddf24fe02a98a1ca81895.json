[{"title":"豫章东湖","author":"戴复古","text":"亭亭绿荷叶，密密罩清波。\n为见湖光少，却嫌荷叶多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题尹惟晓芙蓉翠羽图","author":"戴复古","text":"何人妙笔起秋风，吹破枝头烂漫红。\n翠羽飞来又飞去，一心祇在蓼花丛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题牛图","author":"戴复古","text":"牡丹花下连宵醉，今日闲看黑牡丹。\n得此躬耕东海曲，一贫无虑百忧宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题吴熙仲云萍录","author":"戴复古","text":"家在蓬莱海上居，出身履历一时无。\n姓名羞上云萍录，本是烟波一钓徒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题陈景明梅庐 其一","author":"戴复古","text":"手栽梅核待成林，慈母当年属望深。\n梅未成林人已往，空酸孝子一生心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题陈景明梅庐 其二","author":"戴复古","text":"思亲如海渺无涯，观物惊心感岁华。\n谁见诗人心苦处，年年挥泪看梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题郑子寿野趣","author":"戴复古","text":"菜花园圃槿花篱，麦满前坡水满池。\n野老横竿拦鸭过，牧儿携笛倚牛吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题梅岭云封四绝 其四","author":"戴复古","text":"南迁过岭面无惭，前有东坡后澹庵。\n儿辈欲知当日事，青山解语水能谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题梅岭云封四绝 其三","author":"戴复古","text":"凿破青山两壁开，石头路上踏成埃。\n梅花自与白云笑，几见夷齐出岭来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题梅岭云封四绝 其一","author":"戴复古","text":"东海边来南海边，长亭三百路三千。\n飘零到此成何事，结得梅花一笑缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题梅岭云封四绝 其二","author":"戴复古","text":"淮南得道岭南行，岭上回头作么生。\n传得祖师心印了，钵盂何必与人争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题黄州谢深道国正山庵","author":"戴复古","text":"就荒山竹重抽笋，新种池荷晚著花。\n意象全然似村落，又添茅屋两三家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"衡阳舟中","author":"戴复古","text":"萧萧风雨送行舟，小泊垂杨古渡头。\n不忍缓行江上路，落梅片片是诗愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠饶叔虎谈易论命多奇中","author":"戴复古","text":"中年多病早衰翁，诗不能工枉受穷。\n郊岛五行君识否，要知我命与渠同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赣州上清道院呈姚雪蓬","author":"戴复古","text":"短墙不碍远山青，无事烧香读道经。\n时把一杯非好饮，客怀宜醉不宜醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一冬无雨雪而有雷","author":"戴复古","text":"万物久如渴，三冬一向晴。\n时无腊雪下，夜有瑞雷鸣。\n休咎占天意，悲欢见物情。\n山禽何所感，烂熳作春声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一老儒为贵人烧丹丹垂成而走因此失所","author":"戴复古","text":"道途多险阻，此老欲何之。\n命薄丹砂走，天寒白发悲。\n从教达官骂，忍受小儿欺。\n月夜双乌鹊，飞鸣绕树枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一相识无辜获罪","author":"戴复古","text":"一宿津亭睡不成，愁来物物是离情。\n月轮高挂山河影，江浪巧为风雨声。\n志士失涂为鬼笑，佳人泣血送君行。\n塞翁得马非为福，公论如天久自明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"一笑","author":"戴复古","text":"海曲荒凉地，吟边蹭蹬身。\n时危法当隐，年老惯居贫。\n俗客苦恋坐，小孙痴弄人。\n等闲成一笑，不觉把杯频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日","author":"戴复古","text":"今日知何日，他乡忆故乡。\n黄花一杯酒，白发几重阳。\n日晚鸦争宿，天寒雁叫霜。\n客中无此醉，何以敌凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日登裴公亭得无灾可避自登山之句何季皋滕审言为之击节足以成篇","author":"戴复古","text":"良辰乐事两相关，不可不求今日閒。\n有酒能赊堪荐菊，无灾可避自登山。\n心怀屈贾千年上，身在潇湘八景间。\n好向樽前开笑口，人生枉自作愁颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九日槠洲舟中","author":"戴复古","text":"几年重九客他州，少泊槠田古渡头。\n人向饮中言我乐，谁知笑里是吾愁。\n黄华可忍抛三径，白发犹堪柰几秋。\n今日登高无处所，一樽携上枕江楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九月七日江上阻风","author":"戴复古","text":"舣棹依乔木，扶筇涉浅沙。\n云山多态度，水月两光华。\n白首吟诗客，青帘卖酒家。\n明朝风不定，来此醉黄花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"人不聊生梅柳早有春意","author":"戴复古","text":"岁歉家家窘，时危事事难。\n出门如有碍，对酒亦无欢。\n杨柳含春思，梅花耐岁寒。\n少须天意转，谷熟万民安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"人日","author":"戴复古","text":"自换端平新历日，眼看日月倍光辉。\n南州有雪古来少，人日不阴今见稀。\n鼓舞万方观德化，转移一世属天机。\n朝廷有道吾君圣，办作升平老布衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又送行二首 其二","author":"戴复古","text":"荆门在何许，鄂渚小踌躇。\n宿处好看剑，客中宜读书。\n交游天作合，江汉景何如。\n窗户半天上，南楼好寓居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又送行二首 其一","author":"戴复古","text":"荏苒岁云暮，雪霜天正寒。\n取程毋太急，御下放教宽。\n朝夕去家远，关山行路难。\n边头办功业，恐不在儒冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"万安江上","author":"戴复古","text":"不能成佛不能仙，虚度人间六十年。\n镜里姿容虽老矣，酒边意气尚飘然。\n安排玉白花红句，趁办橙黄橘绿天。\n无柰秋风动归兴，明朝问讯下江船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"万安县芙蓉峰","author":"戴复古","text":"凌空杰阁为谁开，隔岸芙蓉不用栽。\n今古相传彩云现，江山曾识大苏来。\n酒边歌舞共一笑，客里登临能几回。\n翠浪玉虹从此去，明朝人在郁孤台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"万杉长老秀痴翁见示五言次韵","author":"戴复古","text":"了得宗门事，何忧常住贫。\n听师林下话，是我眼中人。\n星渚三秋月，庐山万古春。\n昭陵御书在，岁久莫生尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三山林唐杰潘庭坚张农师会于丁岩仲新楼","author":"戴复古","text":"又携诗卷到南州，尘满征衫雪满头。\n桃李春风故园梦，江山落日异乡愁。\n樽前一笑真奇事，坐上诸君尽胜流。\n政倚清谈洗胸臆，莫教王粲赋登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上乔右司","author":"戴复古","text":"端笏立朝日，肺肝倾上前。\n把麾持节处，桃李满淮壖。\n药石箴时病，蓍龟烛事先。\n焦头与曲突，为计孰为贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上封","author":"戴复古","text":"楼台逼霄汉，窗户纳云霓。\n回顾千岩路，如登万仞梯。\n泉从山顶出，雪压树头低。\n高绝无人境，非僧不可栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与侄南隐等赓和","author":"戴复古","text":"梦回啼鸟聒幽棂，古篆香烟结画屏。\n谈麈一挥尘事少，离骚才读醉魂醒。\n闲居便是人间乐，克己何须座右铭。\n但了耕桑□门户，我生安分合宁馨。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久客还乡","author":"戴复古","text":"短檐纱帽旧麻衣，铁杖扶衰步履迟。\n老去分为无用物，客游谁道有归时。\n丰年村落家家酒，秋日楼台处处诗。\n生长此方真乐土，江淮百姓政流离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"口号送椰心簟刘使君","author":"戴复古","text":"适有椰心席，慇勤持赠君。\n来从三屿国，织作五花文。\n凉暖宜冬夏，清光隔垢氛。\n桃笙与蕲簟，优劣迥然分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大龙湫","author":"戴复古","text":"百丈云岩上，神龙噀水飞。\n四时作风雨，万斛泻珠玑。\n不可形容处，无穷造化机。\n非他瀑布比，对此欲忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"子渊送牡丹","author":"戴复古","text":"有酒何孤我，因花赋恼公。\n可怜秋鬓白，羞见牡丹红。\n海上盟鸥客，人间失马翁。\n不知衰病后，禁得几春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小园","author":"戴复古","text":"小园春欲半，老子作儿嬉。\n政喜花开蚤，还愁客到迟。\n诗当得意处，酒到半酣时。\n蜂蝶来无数，无知却有知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小畦","author":"戴复古","text":"小畦寻丈许，凿壁置柴扉。\n雨后菜虫死，秋来花蝶稀。\n插篱新种菊，抱瓮已忘机。\n俗客忽相访，妨人洗布衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中少憩","author":"戴复古","text":"地僻人稀到，山寒水欲冰。\n闻钟知有寺，见犬不逢僧。\n断垄森乔木，颓檐挂古藤。\n斜阳照孤影，诗骨瘦崚嶒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中见梅寄曾无疑","author":"戴复古","text":"香动寒山寂寞滨，直从空谷见佳人。\n树头树底参差雪，枝北枝南次第春。\n有此瑰琦在岩壑，其他草树亦精神。\n移根上苑谁云晚，桃李依然在后陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中即目二首 其二","author":"戴复古","text":"茅屋七五聚，沙汀八九磐。\n梯山畦麦秀，囊石障溪湍。\n父老鸡豚社，儿童梨栗盘。\n幽居有馀乐，奔走愧儒冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中即目二首 其一","author":"戴复古","text":"岩路穿黄落，人家隐翠微。\n笼鸡为鸭抱，网犬逐鹑飞。\n竹好堪延客，溪清欲浣衣。\n禅扉在何许，僧笠戴云归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山中夜归","author":"戴复古","text":"落尽一林月，山中夜半归。\n惊行群犬吠，破暗一萤飞。\n举我赤藤杖，敲君白板扉。\n兴来眠不得，吟到晓星稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山行","author":"戴复古","text":"度岭休骑马，临渊看网鱼。\n木根高可坐，岩石细堪书。\n谷鸟鸣相答，山云卷复舒。\n儒衣人卖酒，疑是马相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山行遇秀痴翁","author":"戴复古","text":"新冬行乐赏新晴，几个江湖旧友朋。\n霜蟹得橙同臭味，梅花与菊作交承。\n樽前尽是论文客，林下那逢好事僧。\n机解到时言语别，李翱诗句入传灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广东漕李实夫四首 其四","author":"戴复古","text":"忘家甘旅食，忧国属愁颜。\n有客佩金印，何人守玉关。\n风霜晚秋后，天地夕阳间。\n痛洒伤时泪，别公归故山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广东漕李实夫四首 其三","author":"戴复古","text":"千里长城手，如何在广州。\n共谈天下事，莫上斗南楼。\n瘦露封侯骨，忠怀报国秋。\n丁宁北来雁，边信怕沉浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广东漕李实夫四首 其二","author":"戴复古","text":"志士规模远，非时展布难。\n莫言南地暖，须念北风寒。\n楮贱伤财力，兵骄稔祸端。\n盛衰关气数，天下几时安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30854,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广东漕李实夫四首 其一","author":"戴复古","text":"乾坤虽广大，人物不能多。\n议论还诸老，文章自一科。\n从横负才略，缓急任干戈。\n不有济时杰，其如世事何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30855,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"广州所见","author":"戴复古","text":"风波行险道，万里绝人烟。\n几个下番客，经年渡海船。\n人皆贪舶货，我独惜青钱。\n□□□□□，留心禁漏川。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30856,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋李漕冰壶燕集","author":"戴复古","text":"诸亭环立一湖湾，区界无多眼界宽。\n苍石传为伪刘物，绿波曾浴葛仙丹。\n两边堤树四时碧，一片冰壶六月寒。\n咫尺云烟接沧海，须知此地有龙蟠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30857,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为石云悼鹤","author":"戴复古","text":"瘗鹤有故事，花边结小茔。\n不登千岁寿，无复九皋鸣。\n问汝缘何死，主翁无限情。\n最令人忆处，侧耳听松声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30858,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"为客","author":"戴复古","text":"琴剑长为客，诗书欠策勋。\n老来临镜懒，愁里把杯勤。\n北雁寒离塞，秋鹰健拂云。\n物情能奋发，人不解超群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30859,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"乌聊山登览","author":"戴复古","text":"抖擞嚣尘上翠微，旁溪寺上坐题诗。\n忽闻啼鸟不知处，细看好山无厌时。\n风扫云烟开远景，人携香火谒丛祠。\n客来千里登临意，说与时人未必知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30860,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书事","author":"戴复古","text":"两揆新当国，三边未解兵。\n吾君极勤俭，天下望升平。\n春雨随时下，福星连夜明。\n寒儒卜天意，对酒百忧轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30861,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书事","author":"戴复古","text":"喜作羊城客，忘为鹤发翁。\n问天求酒量，翻海洗诗穷。\n已过西南道，适遭东北风。\n扁舟载明月，枉作卖油公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30862,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日二首呈永丰刘叔冶知县 其二","author":"戴复古","text":"市近人声杂，窗明雨色开。\n异乡轻度节，同邸重传杯。\n不碍狂夫醉，知无贺客来。\n故园归未得，茅屋想苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30863,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"元日二首呈永丰刘叔冶知县 其一","author":"戴复古","text":"焚香拜元日，受岁客他州。\n白发难遮老，新年讳说愁。\n无人能访戴，有地足依刘。\n桃李争春事，梅花笑未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30864,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六月三日闻王鉴除殿前都虞候孟枢除夔路策应大使时制司籍定渔船守江甚急","author":"戴复古","text":"闻说北风凛，其然其不然。\n新除策应使，急点守江船。\n设险浑无地，扶危赖有天。\n吾皇自神武，北伐美周宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30865,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凤凰台","author":"戴复古","text":"登临舒老眼，吊古得凄凉。\n故国自龙虎，高台无凤凰。\n浮云多改变，乔木见兴亡。\n往事浑休问，钟山又夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30866,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"化成岩","author":"戴复古","text":"城郭嚣尘外，江山胜概中。\n铿然一滩水，和以万松风。\n夹径森奇石，危亭纳太空。\n苍岩不能语，曾识赞皇公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30867,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"友人朱渊出示廷对策不顾忌讳读之使人凛凛受淮东制置辟","author":"戴复古","text":"龙墀射策对明君，忧国忠言骇见闻。\n皎皎一心如白日，寥寥千古再朱云。\n时危诸老皆求去，兵满三边未解纷。\n要使文臣知武事，不妨王粲且从军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30868,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"友松亭代松语","author":"戴复古","text":"从来岩壑守孤踪，岂料移归宝籞中。\n幸在交游一人数，愿勤培植百年功。\n朱门纵有三千客，青眼毋忘十八公。\n根本既深枝叶茂，相期直上碧霄中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30869,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬寅岁旦景明子渊君玉携酒与诗为寿次韵","author":"戴复古","text":"舍我白瓷椀，把君金屈卮。\n判为元日醉，共赋早春诗。\n冰泮鱼龙起，花开蜂蝶知。\n为子扶病脚，赖有古藤枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30870,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"壬寅除夜","author":"戴复古","text":"今夕知何夕，满堂灯烛光。\n杜陵分岁了，贾岛祭诗忙。\n横笛梅花老，传杯柏叶香。\n明朝贺元日，政恐雨相妨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30871,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天竺访明上座","author":"戴复古","text":"顾影良堪笑，胡为八尺长。\n苍颜抗尘土，饿喙说兴亡。\n竹雨先秋爽，松风生夜凉。\n爱寻湖上寺，留宿赞公房。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30872,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"太湖县雪中简段子克知县","author":"戴复古","text":"腊雪随风下，蹇驴行路难。\n匆匆投邸舍，草草共杯盘。\n喜见丰年瑞，浑忘昨夜寒。\n儿童不解事，却作柳花看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":30873,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]