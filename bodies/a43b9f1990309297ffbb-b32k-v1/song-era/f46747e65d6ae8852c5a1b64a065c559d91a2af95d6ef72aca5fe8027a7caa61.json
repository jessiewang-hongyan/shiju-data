[{"title":"望江南 其九","author":"净圆","text":"西方好，七宝甃成池。\n四色好华敷菡萏，八功德水泛清漪。\n除渴又除饥。\n池岸上，楼殿势飞翚。\n碧玉雕栏填玛瑙，黄金危栋间玻璃。\n随处发光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34049,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其十","author":"净圆","text":"西方好，群鸟美音声。\n华下和鸣歌六度，光中哀雅攒三乘。\n闻者悟无生。\n三恶道，犹自不知名。\n皆是佛慈亲变化，欲宣法语警迷情。\n心地顿圆明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34050,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其十一","author":"净圆","text":"西方好，清旦供尤佳。\n缥缈仙云随宝仗，轻盈衣裓戒贮天华。\n十万去非赊。\n诸佛土，随念遍河沙。\n莲掌抚摩亲授记，潮音清妙响频伽。\n时至即还家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34051,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其十二","author":"净圆","text":"西方好，我佛大慈悲。\n但具三心圆十念，即登九品越三祇。\n神力不思议。\n临执尽，接引定无疑。\n普愿众生同系念，金台天乐共迎时。\n弹指到莲池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34052,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门","author":"卫元卿","text":"花过雨。\n又是一番红素。\n燕子归来愁不语。\n故巢无觅处。\n谁在玉楼歌舞。\n谁在玉关辛苦。\n若使边尘吹得去。\n东风侯万户。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34053,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人 黄州江上寄王帅","author":"黄机","text":"三年万里黄尘路。\n只欠江湖去。\n扁舟二月下湘湾。\n过了洞庭青草、又春残。\n□□□□□□□。\n□□□□□。\n□□□□□□□。\n□□□□□□、□□□。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34054,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"倚鞦韆 寓好事近","author":"张辑","text":"人在玉屏闲，逗晓柳丝风急。\n帘外杏花微雨，罩春红愁湿。\n单衣初试曲尘罗，中酒病无力。\n应是绣床慵困，倚鞦韆斜立。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34055,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山坡羊 其二","author":"葛长庚","text":"不刻时阴阳交并。\n古盆一声号令。\n九宫八卦，排列下拿龙阵。\n领金乌左右军。\n夺乾坤始媾精。\n三回九转，交战在西南境。\n得胜回朝也，河车不曾暂停。\n辛勤。\n曲枕昼夜行。\n专精。\n铁打方梁磨绣针。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34056,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山坡羊 其三","author":"葛长庚","text":"独坐无为宫殿。\n息息绵绵不断。\n我把生身父母，要使他重相见。\n青头郎天外玄。\n白衣妇海底眠。\n婴儿姹女，阻隔在天涯远。\n全仗着黄婆也，黄婆在两下缠。\n团圆。\n打破都关共一天。\n托延。\n赏罢蟾辉斗柄偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34057,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"最高楼 其四","author":"刘克庄","text":"吾衰矣，不慕勒燕然。\n不爱画凌烟。\n此生惭愧支离叟，何功消受水衡钱。\n错教人，占卦气，算流年。\n漫摘取、野花簪一朵。\n更拣取、小词填一个。\n晞素发，暖丹田。\n罗浮杖胜如旌节，华阳巾不减貂蝉。\n这先生，非散圣，即臞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34058,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"醉高歌","author":"姚镛","text":"十年燕月歌声。\n几点吴霜鬓影。\n西风吹起鲈鱼兴。\n已在桑榆暮景。\n荣枯枕上三更。\n傀儡场中四并。\n人生幻化如泡影。\n几个临危自省。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34059,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其四","author":"吴潜","text":"家山好，好处是三冬。\n梨栗甘鲜输地客，鲂鳊肥美献溪翁。\n醉滴小槽红。\n识破了，不用计穷通。\n下泽车安如驷马，市门卒稳似王公。\n一笑等鸡虫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34060,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其五","author":"吴潜","text":"家山好，结屋在山椒。\n无事琴书为伴侣，有时风月可招邀。\n安乐更相饶。\n伸脚睡，一枕日头高。\n不怕两衙催判事，那愁五鼓趣趋朝，此福要人消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34061,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其六","author":"吴潜","text":"家山好，底事尚忘归。\n但我辞荣还避辱，从渠把是却成非。\n跳出世关机。\n将五十，老相已相催。\n争得气来有甚底，更加官后亦何为。\n奉劝莫痴迷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34062,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其七","author":"吴潜","text":"家山好，一室白云中。\n时唤道人谈命蒂，也呼和尚说禅宗。\n孔佛老和同。\n淘汰尽，八面总玲珑。\n欲把捉时无把捉，道虚空后不虚空。\n且问主人公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34063,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其八","author":"吴潜","text":"家山好，负郭有田园。\n蚕可充衣天赐予，耕能足食地周旋。\n骨肉尽团圆。\n旋五福，岁岁乐丰年。\n自养鸡豚烹腊里，新抽韭荠荐春前。\n活计不须添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34064,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其十","author":"吴潜","text":"家山好，好处是安居。\n无事不须干郡县，有馀但管济乡闾。\n及早了王租。\n随日力，也著几般书。\n静里精神偏爽快，闲中光景越舒徐。\n腊月尽工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34065,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其十四","author":"吴潜","text":"家山好，凡事看来轻。\n一壑尽由侬饾饤，三才不欠你称停。\n有耳莫闲听。\n静地里，点检这平生。\n著甚来由为皎皎，好无巴鼻弄醒醒。\n背后有人憎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34066,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"洞仙歌 其一","author":"吴潜","text":"□□□□，□□□□瘦。\n□□□□□□酒。\n□□深，碎蕊残萼都收，归簟枕，谁道栀橐敢就。\n月边偏爱惜，冰玉肌肤，应对姮娥共搔首。\n疑怪得中原，讹道天花，胡尘后、可堪怀旧。\n且海国、浮沉醉花心，喜近日烽烟，渐消亭候。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34067,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 其一","author":"李曾伯","text":"风又雨。\n芳事匆匆如旅。\n借问甚时才百五。\n东君浑弗顾。\n红紫园林几许。\n横笛数声何处。\n桃涨连天归未去。\n客和春且驻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34068,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金子 其二","author":"吴文英","text":"吴城连日赏桂，一夕风雨，悉已零落。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34069,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"天香 宛委山房拟赋龙涎香","author":"李彭老","text":"捣麝成尘，薰薇注露，风酣百和花气。\n品重云头，叶翻蕉样，共说内家新制。\n波浮海沫，谁唤觉、鲛人春睡。\n清润俱饶片脑，芬馡半是沉水。\n相逢酒边花外。\n火初温、翠炉烟细。\n不似宝珠金缕，领巾红坠。\n荀令如今憔悴。\n消未尽、当时爱香意。\n烬暖灯寒，秋声素被。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34070,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门 其三","author":"陈允平","text":"春又晚。\n枝上绿深红浅。\n燕语呢喃明似剪。\n采香人渐远。\n草色池塘碧软。\n丝竹谁家坊院。\n拂拂和风初著扇。\n蜂情愁不展。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34071,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"周密","text":"商，西风只在垂杨外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34072,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"沁园春 其二 雪霁","author":"文天祥","text":"同云笼覆，遍效原、一望苍茫无际。\n是处青山皆改色，姑射琼台初启。\n渔艇迷烟，樵柯失径，歉收点风霜厉。\n子猷短棹，三高祠畔堪系。\n江城梦纪罗浮，踽步豪吟，东郭先生履。\n欲伴袁安营土室，高卧六花堆里。\n此是冰天，谁言水国，千古孤臣滋涕。\n芒苇首白，浑疑缟素刘季。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34073,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满江红 其二","author":"邓剡","text":"酹酒天山，今方许、征鞍少歇。\n凭铁胁、千磨百炼，丈夫功烈。\n整顿乾坤非异事，云开万里歌明月。\n笑向来、和议总蛙鸣，何关切。\n铙吹动，袍生雪。\n军威壮，笳声灭。\n念祖宗养士，忍教残缺。\n洛鼎无亏谁敢问，幕南薄洒膻腥血。\n快三朝、慈孝格天心，安陵阙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34074,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"念奴娇 冰澌","author":"邓剡","text":"琮琤何得，响空濛、却似鸣榔声沸。\n望里平江横雪岭，驾断虹梁渔市。\n若有神驱，如遵帝遣，瞬息层峦峙。\n南阳龙奋，滹沱凝合犹此。\n遥想苏武穷边，霜鸿夜渡，蒿目吟寒视。\n铁骑街枚还疾走，瑟瑟风摇旗帜。\n月白沙明，云凝地裂，四野悲徊至。\n羁魂牢落，我身今在何世。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南乡子 其一","author":"吴某","text":"楼台里、东风淡荡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花","author":"苏小小","text":"别离情绪。\n万里关山如底数。\n遣妾伤悲。\n未心郎家知不知。\n自从君去。\n数尽残冬春又暮。\n音信全乖。\n等到花开不见来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"减字木兰花","author":"李秀兰","text":"自从君去。\n晓夜萦牵肠断处。\n绿遍香阶。\n过夏经秋雁又来。\n想伊那里。\n应也情怀愁不止。\n渺渺书沉。\n直至如今没信音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"无名氏","text":"解下痴绦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王子六么大曲","author":"无名氏","text":"梦中黄跨青鸾翼。\n……一簇楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望江南 其二","author":"无名氏","text":"梅花好，依约透春光。\n记得佳人初睡起，巧临鸾鉴试新妆。\n粉面斗琼芳。\n江亭上，绕树嗅清香。\n拟把一枝传信去，不知何处是兰房。\n独自暗凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"调笑集句 其六 文君","author":"无名氏","text":"君去。\n逐鸳侣。\n斜倚绿窗鸳鉴女。\n琴弹秋思明心素。\n一寸还成千缕。\n锦城春色知何许。\n那似还山眉妩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"无名氏","text":"喜则喜、得入手。\n愁则愁、不长久。\n忻则忻、我两个厮守。\n怕则怕、人来破斗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"无名氏","text":"送千里蟾宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名 其四","author":"无名氏","text":"便是盐商孟客儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"无名氏","text":"却折花枝斜插鬓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"愁倚阑令 其二","author":"无名氏","text":"东风恶，宿云凝。\n忒无情。\n合造梨花深院雨，断肠声。\n枕上春梦初醒。\n红窗外、何处啼莺。\n已办春游双画舫，几时晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"虞美人","author":"无名氏","text":"□□□□□□□。\n□□□□□。\n□□□□□□□。\n□□□□□□、□□□。\n□□□□□□处。\n归向桃源住。\n桃源有路透渔溪。\n自恨仙凡从此、隔云泥。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"水龙吟","author":"无名氏","text":"□□含娇眼。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"无名氏","text":"雨后轻寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"无名氏","text":"金鸭香消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"无名氏","text":"这愁绪、仗他谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"无名氏","text":"病酒厌厌，未解馀酲，三竿丽日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"无名氏","text":"频试脸边新泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南乡子","author":"无名氏","text":"宝鸭沉烟袅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"无名氏","text":"落花点点乡苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"殢人娇","author":"无名氏","text":"也待作个、儿寄与。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戛金钗","author":"无名氏","text":"怎数向、更筹计。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"无名氏","text":"欹枕无眠又无寐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"无名氏","text":"愁厌厌、脉脉上心谁消遣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"双雁儿","author":"无名氏","text":"这心事、倚他谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诉衷情","author":"无名氏","text":"黄昏新月一纤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"无名氏","text":"花有重开日圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"江神子","author":"无名氏","text":"今朝鸳帐酒醒初。\n……还忧酒，解酲无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"无名氏","text":"晚赵倦梳妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名","author":"无名氏","text":"为谁瘦、为谁癯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"如梦令","author":"无名氏","text":"不暖不寒天，春色恰倚人意。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名 下惯饶人词","author":"无名氏","text":"泪珠弹了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳","author":"无名氏","text":"飞花剪、六出工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名 其三","author":"无名氏","text":"盼盼秋波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"失调名 其十","author":"无名氏","text":"一番雨过，池溏十里芰荷香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谒金门","author":"无名氏","text":"山无数。\n遮断故人何处。\n见说阑舟独系住。\n溪边红叶树。\n忆著前时欢遇。\n惹起今番愁绪。\n怎得西风吹泪去。\n阳台为暮雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"捣练子 其三 八梅","author":"无名氏","text":"捣练子，赋梅红。\n玉体凝酥半醉中。\n诗酒兴来须要早，忍看红雨落西东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"捣练子 其四 八梅","author":"无名氏","text":"捣练子，赋梅香。\n蕙魄兰魂又再阳。\n只为人间无着处，借他龙笛返仙乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"捣练子 其五 八梅","author":"无名氏","text":"捣练子，赋梅英。\n枝上商量细细生。\n不是根株贪结子，被吹羌笛两三声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"捣练子 其六 八梅","author":"无名氏","text":"捣练子，赋梅妆。\n镜里佳人傅粉忙。\n额子画成终未是，更须插向鬓云傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"捣练子 其七 八梅","author":"无名氏","text":"捣练子，赋梅音。\n云底江南树树深。\n怅望故人千里远，故将春色寄芳心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"捣练子 其八 八梅","author":"无名氏","text":"捣练子，赋梅青。\n休共檀梨取次争。\n叶底青青如豆小，已知金鼎待和羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"蝶恋花","author":"钱易","text":"一枕闲欹春昼午。\n梦入华胥，邂逅飞琼作。\n娇态翠颦愁不语。\n彩笺遗我新奇句。\n几许芳心犹未诉。\n风竹敲窗，惊散无寻处。\n惆怅楚云留不住。\n断肠凝望高唐路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"后庭花破子","author":"王翠鸾","text":"无心度岁华。\n梦魂常到家。\n不见天边雁，相侵井底蛙。\n碧桃花。\n鬓边斜插。\n伴人憔悴杀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"如梦令","author":"元净","text":"春色湖光如练。\n杨柳依稀拂面。\n杨柳已难□，栽向别家庭院。\n哀怨。\n哀怨。\n欲见无由得见。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"如梦令","author":"南轩","text":"柳眼笑窥人送。\n袅娜舞腰纤弄。\n那更柳眉效蹙，三件皆出众。\n尊重。\n尊重。\n已作一场春梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]