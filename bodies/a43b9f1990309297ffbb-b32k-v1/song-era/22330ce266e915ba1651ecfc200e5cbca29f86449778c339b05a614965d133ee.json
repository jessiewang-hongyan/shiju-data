[{"title":"社日即事","author":"周密","text":"社公雨过稻花香，过了中秋早晚凉。\n正是故园新酒熟，橙脐微绿蟹脐黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35859,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"漏静","author":"周密","text":"漏静知宵永，灯昏觉夜阑。\n隔窗响秋叶，梦不到关山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35860,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陇头水","author":"周密","text":"陇阪萦九折，一折一愁绝。\n涓涓陇头水，征人眼中血。\n水流有尽时，征人无还期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35861,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"婕妤怨","author":"周密","text":"金钥封紫苔，锦茵湿红泪。\n永巷无风月，深宫谩歌吹。\n恨如合欢扇，秋来共捐弃。\n愿如合欢扇，薰风有时至。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35862,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"入塞曲","author":"周密","text":"五年戍陇南，十年戍陇北。\n夜雪度阴山，秋风入绝域。\n战多宝刀缺，行苦马蹄蚀。\n归来见天子，功高无矜色。\n功是战士功，德是明主德。\n小臣何所有，一心期靖国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35863,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"首夏幽居","author":"周密","text":"一枕薰风一架书，幽居景物尽堪娱。\n孤云依石自舒卷，小雨酿梅时有无。\n粗识古今知得丧，细看草木验荣枯。\n诗边剩喜多生意，门外新塘长细蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35864,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻蛩","author":"周密","text":"莓苔经积雨，蟋蟀响庭阴。\n不特吟秋苦，长怀警世心。\n梭寒闺梦短，衣薄旅愁深。\n月冷霜清夜，闲人最赏音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35865,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邂逅","author":"周密","text":"邂逅村翁语，停筇古柳边。\n相邀茅舍坐，自摘野茶煎。\n桑已抽三叶，蚕将及两眠。\n绿蓑烟雨足，我欲赋归田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35866,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋日书怀寄仪父","author":"周密","text":"老尽窗前桂，三秋过二分。\n蛩哀半庭月，雁冷一天云。\n静极通诗境，机疏远世群。\n写怀因有作，寄似鲍参军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35867,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春日书所见","author":"周密","text":"谁家翠袖倚朱楼，指画栏干不举头。\n蜂蝶入怀花扑面，可能全不解春愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35868,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湘夫人画卷","author":"周密","text":"一幅春冰写九歌，就中愁绝是湘娥。\n不知脩竹疏疏外，此去苍梧路几多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35869,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"春暮","author":"周密","text":"绿老兰苕笋满林，一帘轻梦昼愔愔。\n东风已捲春归去，空误杨花扰乱寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35870,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"偶题","author":"周密","text":"烧残一篆香，睡起凭窗坐。\n静中得新诗，研墨瓶花堕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35871,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夜泊","author":"周密","text":"月沉江路黑，傍岸已三更。\n知近人家宿，林西犬吠声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35872,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"伐木杂言","author":"周密","text":"庭前一双桂，娟娟如幽人。\n染我毛骨香，薰我梦寐清。\n恶木忽见妒，累累引繁藤。\n拘絷清风枝，不使舒芳阴。\n滋蔓日益多，恶木亦难任。\n引藤欲伤桂，岂期自伤身。\n侵晨戒仆夫，为我持斧斤。\n论木妒桂罪，诛藤反噬心。\n呜呼君子交，择之贵在精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35873,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宝山园即席次韵","author":"周密","text":"林峦蕴秀玉生晖，左界楼台近紫微。\n画里江湖春浩荡，骚中草木日芳菲。\n莺迁锦树香连屋，鹤唳青桐露湿衣。\n一段高寒无写处，吟情閒逐片云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35874,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次秋崖韵","author":"周密","text":"故山谁为扫苔矶，颇喜闲门过客稀。\n许靖久贫惟马磨，王章多病有牛衣。\n逢时不偶聊藏拙，漫仕无成欲赋归。\n饮水饭蔬差省事，底须汲汲蹈危机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35875,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"避暑吕园","author":"周密","text":"我意不在酒，而在荷柳间。\n轻风行微波，高蝉答空山。\n邂逅同心人，共此一日閒。\n风乎咏归欤，幽兴殊未阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35876,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赋松山","author":"周密","text":"山中深结屋，山上并栽松。\n自有冰霜意，全无尘土容。\n晓风香九里，夜月翠千峰。\n切勿污秦爵，山林有素封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35877,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赋菊次吴竹窗韵","author":"周密","text":"西风入东篱，花事殊草草。\n幽葩发孤丛，未觉芳意少。\n谁云九秋冷，孰谓三径小。\n粲粲黄金英，采采不盈抱。\n幽深秀霜杰，不许蜂蝶到。\n正色知者谁，尚絅无外襮。\n寒香正宜晚，何事叹秋杪。\n不逐雨馀荒，但觉霜后好。\n一见爽入脾，三嗅清彻脑。\n细参花中禅，可以入道奥。\n人生百年内，能几花前笑。\n昌黎似未悟，颇恨生不早。\n岂无春风妍，羞与红紫校。\n万物各有待，此理须自了。\n不作时世妆，不顾流俗诮。\n居然处于独，耿介类有道。\n信乎抱脩洁，终胜自炫耀。\n虽云得时晚，未肯随秋老。\n呼童谨培溉，勿使蓬藋挠。\n泛之亦堪醉，餐之亦堪饱。\n莫赋湘累吟，泽畔颜色槁。\n持似斜川翁，闻此当绝倒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35878,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"元夕次松窗韵","author":"周密","text":"霁景浮灯市，春声动乐章。\n翠帘流月影，黄道散天香。\n鳌蜃三山耸，鱼龙陆地骧。\n醉馀天欲曙，归路笛声长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35879,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"月下闻笙次赵元父韵","author":"周密","text":"碧桃花外听缑笙，袅袅馀音度月明。\n风静啭春莺出谷，夜深警露鹤传更。\n十三簧冷参差影，廿四栏高缥缈声。\n愁想嵩山归未得，醉魂清绝梦难成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35880,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"荪壁惠白踯躅口占以谢","author":"周密","text":"何人种玉白云边，岁岁花开叫杜鹃。\n乞得东风一枝雪，等闲归诧鹤林仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35881,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病中谢友人相问","author":"周密","text":"卧病残春亦可嗟，萧然一閤闭如蜗。\n尺铛自课童煎药，丈室应无女散花。\n患难时方知谊友，炎凉医亦厌贫家。\n兼旬不踏门前径，绿叶青阴渐可嘉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35882,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"病起偶成","author":"周密","text":"负暄行药小徜徉，困卧长安意自伤。\n短发怯梳霜柳脆，衰容销镜病梨黄。\n熊经龟息持新诀，马勃牛溲试旧方。\n解祟送穷浑未验，数奇应笑贾司仓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35883,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送徐道士之剡六言二首 其一","author":"周密","text":"化鹤曾游赤壁，笼鹅又过山阴。\n带月片帆归去，凌风一剑飞吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35884,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送徐道士之剡六言二首 其二","author":"周密","text":"倦踏长安落叶，闲寻剡曲扁舟。\n三十六湾清晓，不知何处逢秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35885,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小木天次曾昭阳韵","author":"周密","text":"弱水蓬莱路，人间隔几千。\n未知太仓令，何似道山仙。\n草木涵春露，池亭媚晓烟。\n静参齐物意，小大岂其然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35886,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次张明叔韵","author":"周密","text":"祇今吾亦自忘吾，东里何人念葛綀。\n遁世每思盘谷隐，传家惟有善和书。\n生平自喜一无愧，老去从嘲百不如。\n五亩桑麻三径菊，潘郎真可赋闲居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35887,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次竹窗见寄韵","author":"周密","text":"季鹰次第赋归来，底用莼鲈苦苦催。\n顾我已如无用木，从人自笑不然灰。\n江湖空有忧时叹，朝野应多济世才。\n不信子牟存阙意，可能全付与衔杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35888,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋望","author":"周密","text":"赤日黄尘叹倦游，长谣曾赋四宜休。\n酸风小雨层梯外，半是愁痕半是秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35889,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"有约","author":"周密","text":"有约携樽去，同登百尺楼。\n便须乘好月，何必待中秋。\n天地能容醉，山川不贮愁。\n悠悠身世事，已付一虚舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35890,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄牟德范九江幕府","author":"周密","text":"怀人渺渺隔风涛，湓浦炉峰梦寐劳。\n雄堞拂云屯万灶，空江锁月宿千艘。\n临流击楫宾朋盛，草檄飞书笔墨豪。\n枫叶荻花秋正好，琵琶休听郁轮袍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35891,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苦雨","author":"周密","text":"闭门吟苦雨，谁识子桑愁。\n石破杞天漏，瓢翻后土浮。\n捲茅惊客梦，恤纬动嫠忧。\n自此开新霁，犹堪望有秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35892,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"甲戌七月二十七夜大雷雨有感","author":"周密","text":"骄阳煽馀威，热恼若昏醉。\n邀凉卧虚棂，顿觉景象异。\n乾坤若黟漆，相对不相视。\n雷车与电镜，云族撑赑屃。\n如发马陵伏，万弩一时至。\n如河决宣房，澎湃石崩坠。\n又如入蔡州，鹅鹜杂兵骑。\n轰腾立四海，熛怒翻九地。\n儿啼抱头窜，婢噤移足踬。\n鸟兽相号呼，鸡犬竞趋避。\n隐床夜九迁，穿瓦雨如酾。\n屋老欲摧压，危慄心惴惴。\n敬此天动威，起坐不敢寐。\n哀哉昔吾亲，多病易惊悸。\n每于风雨交，拥护不少置。\n九京闻不闻，生死同一致。\n不能抱冢泣，不孝天所弃。\n漫游远坟墓，荣亲愿难遂。\n作誓守松楸，或可酬此志。\n白云起泷冈，西望挥血泪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35893,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登北高峰","author":"周密","text":"山巅复山巅，树杪复树杪。\n白云已摩肩，青意犹未了。\n积苏笑壤鼠，决眦极飞鸟。\n吴涛与越树，灭没窥缥缈。\n洪荒本无界，所恨见者小。\n九万逍遥游，语大未易少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35894,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"揽秀台观月","author":"周密","text":"吟到危梯最上层，天空星斗入杯明。\n游心寥廓生虚白，与世周旋忌独清。\n冰雪四山皆月色，宫商一片是秋声。\n广寒今夕知何夕，欲驾银桥上玉京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35895,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与陈君衡别","author":"周密","text":"君归春亦去，心赏易蹉跎。\n烟柳绿如此，霜髭白柰何。\n别来空作恶，醉后且高歌。\n莫把诗销恨，诗成恨更多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35896,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"甲戌八月武康安吉水祸甚惨人畜田庐漂没殆尽赋苦雨行以纪一时之实","author":"周密","text":"雷车推翻电车折，龙鬣劳劳滴清血。\n羲和愁抱赤乌眠，阳侯怒蹴秋潢裂。\n风寒田火夜不明，桔槔椎鼓声彭彭。\n家家救田如救死，处处防陇如防城。\n丁男冻馁弱女泣，今岁催苗如火急。\n一家命寄一田中，何敢辞劳叹沾湿。\n四山湓涌地轴浮，潮声半夜移桃州。\n千家井邑类飘叶，啾啾赤子生鱼头。\n大田积沙高数尺，南陌东阡了难识。\n死者沉湘魂莫招，生者无家归不得。\n呼天不闻地不知，县官不恤将告谁。\n与其饥死在沟壑，不若漂死随蛟螭。\n何人发廪讲荒政，笺天急救生民命。\n拯溺谁无孟氏心，裹饭空怜子桑病。\n恭惟在位皆圣贤，等闲鍊石能补天。\n转移风俗在俄顷，不歌苦雨歌丰年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35897,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"小木天晚倚","author":"周密","text":"吟情偏向静中生，桂影吹凉似水清。\n十日雨晴秋便老，一蛩犹恋豆根鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35898,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次魏川联句韵","author":"周密","text":"丹砂何日化黄金，衣上秋尘积渐深。\n生意无边观草色，春风有约到梅心。\n白头自感华年瑟，俗耳谁听太古琴。\n联句定知思孟简，溪边因寄采蘋吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35899,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吟社饮桂月边即席次韵","author":"周密","text":"白头强逐少年游，闲倚西风十二楼。\n共醉玉壶千古月，平分香国一天秋。\n祇应李白怜吾意，不信姮娥识此愁。\n夜久高寒犹露饮，花阴传漏已三筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35900,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"醉后放歌","author":"周密","text":"冷风如冰月如水，夜久霜寒倚秋桂。\n酒樽已眠人未睡，闲与孤蛩各言志。\n宇宙宽闲容我辈，千古万古同一致。\n天上人间好恶异，君子小人常倒置。\n不愿建侯游万里，金印红旗拥千骑。\n不愿闻鸡五更起，衮绣传呼趋九陛。\n惟愿擘画千百岁，坐见无怀大庭氏。\n不须结绳与画地，何者为愚何者智。\n不蚕而衣不耕刈，不暑不寒春泄泄。\n有酒如江碧浮蚁，一瓢日日江头醉。\n醉后长歌语流丽，歌声透天天为喜。\n赐我三元九霞佩，佩之乘风御清气。\n虎豹遁迹鬼神避，意之所之身即至。\n竦身蜚出扶摇外，直到天宫三十二。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35901,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"甲戌七月","author":"周密","text":"未撤关河戍，边声动塞鸿。\n忧时方恤纬，闻诏忽号弓。\n两鬓三秋雪，千林一夜风。\n寸心犹未改，何敢叹途穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35902,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南园","author":"周密","text":"清芬堂下千株桂，犹是韩家旧赐园。\n白发老翁和泪说，百年中见两平原。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35903,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"甘园","author":"周密","text":"小小蓬莱在水中，乾淳旧赏有遗踪。\n园林几换东风主，留得庭前御爱松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35904,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"褒亲崇寿寺","author":"周密","text":"鹤羽鸾绡事已空，奉华遗寺对高松。\n宫斜凤去无人见，且看门前粉壁龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35905,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"西太一宫","author":"周密","text":"蕊宫广殿号黄庭，突兀浮云最上层。\n五福贵神留不住，水堂空照九枝灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35906,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"南园香山","author":"周密","text":"旧事凄凉尚可寻，断碑闲卧草深深。\n凌风阁下槎牙树，当日人疑是水沈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35907,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"为杨大芳悼亡","author":"周密","text":"帐中蝶化真成梦，镜里鸾孤枉断肠。\n吹彻玉箫人不见，世间难觅返魂香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35908,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"蜡梅","author":"周密","text":"蜡本花所作，作花应更香。\n月参无味禅，不作有色妆。\n未知香山白，何似江夏黄。\n坐令彼粲者，难擅春风场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35909,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄括苍山人","author":"周密","text":"遥知深隐处，草木亦无尘。\n瀑响千林雨，花浮一岭春。\n地灵松化石，岁久树成人。\n纵未为仙去，何妨作逸民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35910,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水村","author":"周密","text":"紫鸡白凤满秋畦，血色蜻蜓上客衣。\n野水近门篱落晚，摆头芦苇有船归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35911,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题高房山夜山图为江浙行省照磨李公略作","author":"周密","text":"郎潜暇日多冥搜，夜深独上千尺楼。\n天回海立月正湿，风起云涌山疑浮。\n萦青缭白互变灭，浮岚飞雾寒飕飕。\n潜虬栖鹘声磔磔，山鬼木客鸣呦呦。\n城中痴儿方呓语，有梦不到千山幽。\n遥岑寸碧目力远，欲溯汗漫凌风游。\n高侯落笔万象泣，写出千古苍茫愁。\n无声诗与有声画，一夕异事传南州。\n玉琴在膝酒在手，欲写天籁无庄周。\n凭谁为问华表鹤，城郭人民今是不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35912,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题高彦敬山村图卷","author":"周密","text":"我昔游七闽，百岭争巀嶪。\n白云涨川原，深谷如积雪。\n又游天姥岑，幽磴缘曲折。\n长林翳寒日，十里行落叶。\n转头五十年，遐想正愁绝。\n开图意忽动，惝恍生内热。\n何当驾松广，分我翠一叠。\n弁阳我所庐，见谓山水窟。\n漂零愧楸槚，岁月老薇蕨。\n平生阮遥集，足痹屐齿折。\n何当赋归田，初志遂所惬。\n怀哉复怀哉，清梦绕林樾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35913,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题温日观葡萄","author":"周密","text":"百八牟尼颗，携将万里游。\n归来还自笑，何不博凉州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35914,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"古墓","author":"周密","text":"碑断苔荒土半穿，老狐号冷穴空垣。\n珠襦玉碗谁携去，翁仲相看不敢言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35915,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杂诗","author":"周密","text":"万类更变化，造物无时闲。\n人生天地中，长短百年间。\n未知百年后，奄忽何时还。\n辛苦立修名，留用后世看。\n后世既无我，于我何所关。\n有如梦中游，梦觉无馀欢。\n天理正如此，一笑付达观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35916,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"跋晋王大令保母帖","author":"周密","text":"王郎擅风流，笔墨美无度。\n残砖与断刻，亦有神物护。\n埋光八百载，复出疑有数。\n伟哉羲献迹，并见山阴路。\n抗衡丙舍帖，突过黄初赋。\n景师与阳朔，漶漫不足数。\n要须中山石，乃可与之伍。\n十行百馀字，一一生媚妩。\n家鸡与野鹜，此论吾不取。\n佳处将无同，閟妙未易语。\n我贫乃嗜此，字字若可煮。\n不知何物媪，托此传万古。\n却怪玉匣书，反累昭陵土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35917,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送西秦张仲实游大涤洞天","author":"周密","text":"玉室金堂积翠边，旧游犹记劫灰前。\n禽声夜捣千年药，花片春浮九锁泉。\n洞府暗通沧海路，楼居何异化城仙。\n茶香笋美松醪熟，正好山中过禁烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35918,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"周密","text":"秦邸狱成杯酒里，乌台祸起一诗间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35919,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"周密","text":"山林绿发秦宫女，风雨青萍禹庙梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35920,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"周密","text":"繁华不结三春梦，零落空馀寸草心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":35921,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]