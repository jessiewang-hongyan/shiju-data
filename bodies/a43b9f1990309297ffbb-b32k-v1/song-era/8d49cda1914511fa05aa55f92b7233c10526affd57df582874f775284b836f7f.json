[{"title":"尝枸杞","author":"杨万里","text":"芥花菘莟饯春忙，夜吠仙苗喜晚尝。\n味抱土膏甘复脆，气含风露咽犹香。\n作齑淡著微施酪，芼茗临时莫过汤。\n却忆荆溪古城上，翠条红乳摘盈箱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"待次临漳诸公荐之易地毗陵自愧无济剧才上章丐祠","author":"杨万里","text":"亦岂真辞禄，谁令自不才。\n更须三釜恋，未放两眉开。\n道我今贫却，何朝不饭来。\n商量若为可，杜宇一声催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故太恭人董氏挽词五首 其五","author":"杨万里","text":"溧县初栖凤，金陵复木牛。\n重来喜城郭，一夕閟山丘。\n终始非无数，东西岂自由。\n铭旌二千里，处处哭归舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故太恭人董氏挽词五首 其四","author":"杨万里","text":"九秩开鸿算，前春祝寿觞。\n秦淮作椒柏，钟阜当星香。\n花压藤舆重，游回绣幰凉。\n诸台谁有母，羡杀綵衣郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故太恭人董氏挽词五首 其三","author":"杨万里","text":"亲见卿为月，频移使者星。\n藻虚南涧碧，萱落北堂青。\n遗下新褕狄，空传训宁馨。\n又孙还又子，玉树满阶庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故太恭人董氏挽词五首 其二","author":"杨万里","text":"贫是儒家事，谁贫奉直如。\n也无一瓢饮，劣有半床书。\n妇妇能攻苦，卿卿不负渠。\n竟令鸿与侃，相继大吾闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故太恭人董氏挽词五首 其一","author":"杨万里","text":"谁别夫人孝，惟天与病姑。\n每云吾妇在，底用别人扶。\n愉色春相似，弥年倦更无。\n苍苍不汝报，种黍定生菰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故少师张魏公挽词三章 其一","author":"杨万里","text":"出昼民犹望，回军敌尚疑。\n时非不吾以，天未胜人为。\n自别知何恙，从谁话许悲。\n一生长得忌，千载却空思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故少师张魏公挽词三章 其二","author":"杨万里","text":"手麾日三舍，身驭月重轮。\n始是岷峨秀，前无社稷臣。\n向来元破斧，何用更洪钧。\n只使江淮草，明年不作春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故少师张魏公挽词三章 其三","author":"杨万里","text":"读易堂边路，曾闻赤舄声。\n心从画前到，身在易中行。\n忧国何缘寿，思亲岂欲生。\n不应永州月，犹傍两窗明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故王氏令人挽诗二首 其二","author":"杨万里","text":"西掖梧方茂，南濒藻已芜。\n谢庭风絮远，潘室月窗孤。\n有训才吾子，无人乳阿姑。\n吊宾成白鹤，卜地得青乌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故王氏令人挽诗二首 其一","author":"杨万里","text":"贝叶参祇树，蓍簪当副笄。\n来嫔舍人样，如古大夫妻。\n鸾诰金花湿，芝庭玉树齐。\n药成奔月去，寂寞海山西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"故恭人刘氏挽词","author":"杨万里","text":"雨露低蘋沼，芝兰上桂林。\n鱼轩帘蹙绣，鸾纸诰涂金。\n死者夫何恨，归欤乃宿心。\n不偕君子老，愁绝白头吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春半雨寒牡丹殊无消息","author":"杨万里","text":"今岁芳菲尽未忙，去年二月牡丹香。\n寒暄不定春光晚，荣落俱迟花命长。\n才一两朝晴炫野，又三四阵雨鸣廊。\n鞓红魏紫拳如蕨，而况姚家进御黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春尽有感","author":"杨万里","text":"等春不到怨春迟，又是红稀绿满枝。\n雨后晚花犹好在，槛前残醉欲醒时。\n百年人事皆如许，千载诗声亦浪垂。\n金印不争争钓石，更饶争得鬓边丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春尽感兴","author":"杨万里","text":"春事匆匆掠眼过，落花寂寂奈愁何。\n故人南北音书少，野渡东西芳草多。\n笋借一风争作竹，燕分数子别成窠。\n青灯白酒长亭夜，不胜孤舟兀绿波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜无睡思虑纷扰","author":"杨万里","text":"不堪万虑搅中肠，打破愁城入醉乡。\n酒力尽时还又动，春宵短后却成长。\n浮思闲念纷无数，飞絮游丝遍八荒。\n看到东窗窗欲白，忽然一梦到羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雨呈袁起岩","author":"杨万里","text":"昨日晴暄尽十分，无端寒湿复今晨。\n苍颜华发差排老，急雨颠风屏当春。\n只有观书堪遣日，从来病眼不如人。\n诗名满世真何用，更赚先生愿卜邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚往永和","author":"杨万里","text":"春事已如许，山居殊未知。\n绿光风度麦，白碎日翻池。\n景好怀翻恶，人嬉我独悲。\n郊行聊著眼，兴到漫成诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春寒早朝","author":"杨万里","text":"十载江湖今又归，朝鸡不许夙兴迟。\n每闻扑鹿初鸣处，正是䰒松好睡时。\n病眼生憎红蜡烛，晓光未到碧桃枝。\n谁能马上追前梦，坐待金门放玉?。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晴怀故园海棠二首 其二","author":"杨万里","text":"竹边台榭水边亭，不要人随只独行。\n乍暖柳条无气力，淡晴花影不分明。\n一番过雨来幽径，无数新禽有喜声。\n只欠翠纱红映肉，两年寒食负先生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晴怀故园海棠二首 其一","author":"杨万里","text":"故园今日海棠开，梦入江西锦绣堆。\n万物皆春人独老，一年过社燕方回。\n似青如白天浓淡，欲堕还飞絮往来。\n无那风光餐不得，遣诗招入翠琼杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昨日访子上不遇裴回庭砌观木犀而归再以七言乞数枝","author":"杨万里","text":"昨携儿辈扣云关，绕遍岩花恣意看。\n苔砌落深金布地，水沉烝透粟堆盘。\n寄诗北阮赊秋色，供我西窗当晚餐。\n小朵出丛须折却，莫教折破碧团栾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泉声","author":"杨万里","text":"初闻蟹眼雪花声，忽有仙人玉佩鸣。\n时作微吟清入骨，又成幽咽怨多情。\n问知古涧飞泉落，起看寒泓绕石行。\n欲解尘缨聊一濯，无尘可濯濯谁缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洪丞相挽辞二首 其二","author":"杨万里","text":"家谱忠仍孝，词林博更宏。\n牧羝无是子，雏凤有难兄。\n谁谓身非达，其如道不行。\n青蝇满天地，白日转清明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"洪丞相挽辞二首 其一","author":"杨万里","text":"乾道扶初旭，中台焕五云。\n才登右丞相，已拜大观文。\n胡不迟期月，看渠集茂勋。\n一朝惊玉折，千载叹芝焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸巳省宿咏南宫小桃","author":"杨万里","text":"孤坐南宫悄，桃花故故红。\n晴曛半脸日，寒惨数须风。\n昔岁山村里，春光痛饮中。\n不烦渠伴宿，今我已衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"癸亥上巳即事","author":"杨万里","text":"怪底风光好，还当上巳辰。\n柳莺樊子口，梁燕赵家身。\n花落春容瘦，阴浓夏意新。\n晒书仍焙药，幽事也劳神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夕书怀","author":"杨万里","text":"老去还多感，归来政倦游。\n数峰愁外月，一叶静边秋。\n偶忆平生事，真供独笑休。\n灯花吾会得，村酒恰当篘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日见橘花二首 其二","author":"杨万里","text":"不夜非关月，舞风也自香。\n著花能许细，落子不多长。\n玉糁开犹半，金须撚更强。\n得秋何恨晚，映暑却生凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋日见橘花二首 其一","author":"杨万里","text":"花净何须艳，林深不隔香。\n初闻无处觅，小摘莫令长。\n春落秋仍发，梅兼雪未强。\n缥瓷汲寒甃，浅浸一枝凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋月","author":"杨万里","text":"夜气凉于水，高斋可当楼。\n古来除却月，此外更无秋。\n寒入兰心劲，光随菊脚流。\n惟愁清不极，清极却成愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋典","author":"杨万里","text":"宿有青霞愿，惟应白鹭知。\n风烟聊晚望，山水入秋宜。\n老里还多病，贫中却剩诗。\n浪愁馀热在，会自有凉时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋怀","author":"杨万里","text":"随分哦诗足散愁，老怀何用更冥搜。\n聿来胥宇蚁移穴，无以为家燕入秋。\n盖世功名吹剑首，平生忧患淅矛头。\n从今归去便归去，未到无颜见白鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜读书","author":"杨万里","text":"稚子慵都睡，先生唤不应。\n虫声窗外月，书册夜深灯。\n半醉聊今古，千年几废兴。\n有怀人未会，不乐我何曾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋雨初霁","author":"杨万里","text":"松竹阴寒分外苍，芭蕉花湿梦中香。\n抽身朱墨尘埃里，入眼山林气味长。\n今日更无秋热去，晓晴犹带雨馀凉。\n却将白发三千丈，缲作霜丝补锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋凉晚酌","author":"杨万里","text":"寄老山林度懒残，新秋又是一年年。\n青编翠竹风窗月，白酒红蕖水槛天。\n暑欲谢时偏更毒，侬当醉后恕渠颠。\n者稀尚隔来年在，且釂今宵药玉船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋圃","author":"杨万里","text":"何处秋深好，山林处士家。\n青霜红碧树，白露紫黄花。\n一熟雠频雨，朝晴祷暮霞。\n连宵眠不著，犹自爱新茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋热追凉池上","author":"杨万里","text":"圃迥人全寂，池清虑自消。\n萍根微著水，荷叶欲穿桥。\n今岁知何故，秋阳尔许骄。\n追凉犹有处，此老未无聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋晚过泉口","author":"杨万里","text":"日色全无热，秋凉不似初。\n行人惊翡翠，掠水度芙蕖。\n平野一回顾，远山千有馀。\n谁令贪眺望，却道废看书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胡季永挽词二首 其二","author":"杨万里","text":"一昨官都下，同时寄客间。\n相从湖上寺，览遍浙西山。\n骏足应千里，彪文未一斑。\n霜风吹病眼，老泪为渠潸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胡季永挽词二首 其一","author":"杨万里","text":"澹庵潜圣学，未许外人传。\n门里存衣钵，吟边可管弦。\n浣花宗武辔，儋耳小坡船。\n绿鬓成黄壤，从今更问天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荔枝堂昼憩","author":"杨万里","text":"荔子阴中风绝凉，菖蒲节后日偏长。\n落残数柄荷花蕊，浸得一瓶泉水香。\n多病早衰非破砚，欲行复倦且胡床。\n曲江近北差迟暑，不道江山胜五羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蚤起秣陵镇二首 其二","author":"杨万里","text":"山路祇言迥，农家俱夙兴。\n短长群稚子，回避一田塍。\n随犬能知路，骑牛底用绳。\n兹行有胜事，何处不丰登。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蚤起秣陵镇二首 其一","author":"杨万里","text":"人趁村中市，鸡鸣担上笼。\n忽看一天紫，未吐半轮红。\n谁撼扶桑露，吹来杨柳风。\n诗肩忍凉冷，已出两臞峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蚤谒景灵宫闻子规","author":"杨万里","text":"帝里都无个里宽，苑深地禁到应难。\n蔚然绿树去天近，上有子规啼月残。\n便觉恍如还故里，不知闻处是长安。\n野蔷薇发桐花落，孤负南溪老钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺建康帅余处恭迎宝公祷雨随应","author":"杨万里","text":"大士多时不入城，入城犹未炷炉熏。\n忽吹淮水千峰雨，不费钟山半朵云。\n桑叶秧苗俱起舞，葵花萱草亦欢欣。\n尚书款送公归去，留下丰年二十分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺皇太子九月四日生辰二首 其二","author":"杨万里","text":"典学光阴璧不如，简编灯火卷还舒。\n极知储后勤稽古，却是儒生懒读书。\n心到帝王图籍外，手追雅颂国风初。\n人间未见瑶山集，十倍曹丕尚有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺皇太子九月四日生辰二首 其一","author":"杨万里","text":"金茎分露与黄花，银汉非烟作瑞霞。\n万国元良当诞节，重轮日月正光华。\n祖尧父舜真千载，禹子汤孙更一家。\n清晓寿觞天上至，蟠桃如瓮枣如瓜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺皇太子九月四日生辰四首 其四","author":"杨万里","text":"继照姿天纵，分阴学日勤。\n橘中招绮夏，瓜处屏伾文。\n老别鱼竿月，来依鹤禁云。\n还将古为鉴，聊当野人芹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺皇太子九月四日生辰四首 其三","author":"杨万里","text":"重九吹花节，千龄梦日时。\n东朝分菊水，南内赐萸枝。\n禹酒无多酌，尧樽更一卮。\n三宫千万寿，剩费若干诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺皇太子九月四日生辰四首 其二","author":"杨万里","text":"代邸躬仁俭，汤孙世圣贤。\n谁云无二日，今恰见三天。\n甲观初寒夕，神光似昼然。\n前星那解老，何但八千年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺皇太子九月四日生辰四首 其一","author":"杨万里","text":"地出雷初震，天升日更重。\n高飞千里鹄，潜跃九渊龙。\n隆准如高帝，虬须似太宗。\n八荒阴赐里，户户是华封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺皇孙平阳郡王十月十九日生辰","author":"杨万里","text":"玉历当千运，天潢第一源。\n本支尧百世，有道宋曾孙。\n接武前星曜，依光太极尊。\n年年会庆节，更庆茁兰孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺澹庵先生胡侍郎新居落成二首 其二","author":"杨万里","text":"眼高不肯住清都，梦绕江南水竹居。\n却入青原更青处，饱看黄本硬黄书。\n剪裁风月聊堪醉，拆洗乾坤正要渠。\n赐宅不应公得免，未知北第似林庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺澹庵先生胡侍郎新居落成二首 其一","author":"杨万里","text":"清庙欹斜一笑扶，归来四壁亦元无。\n可怜拙计输馀子，住破僧房始结庐。\n三径非遥人自远，万间不恶我何须。\n冥搜善颂终难好，贺厦真成燕不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赴文德殿听麻仍拜表","author":"杨万里","text":"苍龙观阙启槐宸，白玉阶除振鹭群。\n仗外诸峰献松雪，霜前一雁度宫云。\n舍人就日宣麻制，丞相瞻天进表文。\n夙退自欣还自笑，素餐便当策殊勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赵通判恭人周氏挽辞","author":"杨万里","text":"早与梁鸿隐，中随士会归。\n一门忠义气，千古日星晖。\n紫告金花诏，青灯锦字机。\n西峰今夜月，坟是昔人非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"追和尤延之检详紫宸殿贺雪","author":"杨万里","text":"锡山诗老立层霄，黄竹赓歌宴在瑶。\n有客梦中闻雪作，曲肱篷底信船摇。\n遥知端叶飘香袖，笑向梅花趁早朝。\n未叹山人负猿鹤，负渠缩项与长腰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送丁子章将漕湖南三首 其三","author":"杨万里","text":"半世行天下，同心寡友生。\n故人今又去，此意向谁倾。\n白发三更语，青灯一点明。\n看渠还玉署，老我正归耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送丁子章将漕湖南三首 其二","author":"杨万里","text":"湖外游曾漫，荒馀好在么。\n山应依样瘦，民岂似田多。\n不是无风物，其如费拊摩。\n人言补外乐，且道定如何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送丁子章将漕湖南三首 其一","author":"杨万里","text":"岳麓猿声里，湘流雁影边。\n自天持一节，到日是新年。\n身退名逾重，今稀古则然。\n黄花非不好，只是插离筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送丁牧仲新除奉常寺簿入朝","author":"杨万里","text":"帝念潜龙雪邸臣，宠光玉树照青春。\n家藏履舄星辰旧，天借旂常日月新。\n从此云霄君稳步，向来鹓鹭我曾邻。\n曲台簿正多廊庙，西府璇枢是一人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送王季山主簿省觐枢府","author":"杨万里","text":"六馆名流王季山，十年风雨短檠寒。\n不曾文字饶群子，勉为庭闱就一官。\n伯也腾身紫极上，叔兮著眼白云端。\n会当再奏河东赋，姓字从头揭榜看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送乡余文明劝之以归","author":"杨万里","text":"一别高人又十年，霜筋雪骨健依然。\n席门未害车多辙，斗酒尚能诗百篇。\n苍狗白衣俱昨梦，长庚孤月自青天。\n故山松菊平安在，何日归欤解钓船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送子仁侄南归二首 其一","author":"杨万里","text":"酒为吾人绿，花知九日黄。\n风灯秋焰冷，霜雁夜声忙。\n爱子文无对，嗟予老更狂。\n相分即相见，不待半年强。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":69247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]