[{"title":"致爽轩 其一","author":"米芾","text":"水口痴云散，林梢爱景还。\n朝寒无物禦，拥鼻对西山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34677,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"致爽轩 其二","author":"米芾","text":"夕紫堆香豆，朝岚映墨池。\n客来不须报，正是学书时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34678,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鄙诗上呈通判朝奉大夫 其一","author":"米芾","text":"不是通侯贵，还应贡禹弹。\n只应好形制，自己愧彫残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34679,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鄙诗上呈通判朝奉大夫 其二","author":"米芾","text":"簪玳尚谁继，风云那可看。\n自曾许持送，谈笑未尝乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34680,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"长寿庵咏梅","author":"米芾","text":"沉檀应在骨，龙麝自薰心。\n千载吟蕲竹，清雅少知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34681,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答刘泾书","author":"米芾","text":"唐满书奁晋不收，却缘自不信双眸。\n发狂为报豢龙子，不怕人称米薛刘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34682,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送大郎应举","author":"米芾","text":"天下英才米大郎，朝来跨马入文场。\n绪馀惊世须魁选，归带蟾宫桂子香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34683,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉呈彦昭使君陪壮观之赏","author":"米芾","text":"邀宾壮观不辞寒，玉立风神气上干。\n欲识谢公清兴处，千山万岭雪漫漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34684,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄吴诗客","author":"米芾","text":"江上迟留臈破春，好诗时见贾参军。\n年来鉴远多新句，难附江风与海云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34685,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奉诏书御屏","author":"米芾","text":"目炫五光开，云蒸步起雷。\n不知天近远，亲见玉皇来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34686,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏梅二首 其一","author":"米芾","text":"姑射真人自少群，要亲高节许交君。\n一台二妙逢清赏，甘逊佳名得致荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34687,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"咏梅二首 其二","author":"米芾","text":"江头尽醉似泥何，管领仙姿酒醟多。\n烟艇两三横岸处，惜花伫立想凌波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34688,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿紫极宫","author":"米芾","text":"重柯交荫动尘容，蓬阆仙家住水宫。\n道士神升金阙下，天君光降玉虚中。\n朱鬃笔定超凡箓，碧简书传避世翁。\n三夕临风醒病骨，钧天冉冉梦魂通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34689,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道林","author":"米芾","text":"楼阁明丹垩，杉松振老髯。\n僧迎方拥帚，茶细旋探檐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34690,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"法华台","author":"米芾","text":"坱圠有同色，雪深云未开。\n终南晴夜月，彷佛似登台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34691,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"笔","author":"米芾","text":"摹画由来妙手知，彩笺落处直疑飞。\n寸心用尽终何补，赢得霜毫秃后归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34692,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"墨","author":"米芾","text":"百鍊经来老更奇，暗中光价自然飞。\n锦囊手迹长颜色，曾是君王乞得归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34693,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"纸","author":"米芾","text":"陶泓毛颖陈玄辈，同日声名四海飞。\n独有先生索高价，谁人献赋洛阳归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34694,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"砚","author":"米芾","text":"金井寒生一水池，读书窗纸照萤飞。\n悲欢穷泰寻常共，掷破还须匣取归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34695,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"今日献祝寿纪庆生申诗辄录呈某顿首再拜","author":"米芾","text":"祥云蔼蔼拥华筵，玉府蓬山见上仙。\n琼杯潋滟祈眉算，永荐生申寿八千。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34696,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"青山","author":"米芾","text":"一园松竹冷阴森，犹得桓公叹可临。\n却叵刘琨看左传，玉壶徒缺误雄心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34697,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过当涂","author":"米芾","text":"鸥鹭依寒水，蒹葭静晚风。\n烟光秋雨细，树色碧山重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鉴远楼","author":"米芾","text":"赏心亭上群山雪，三夕丹渊借月华。\n吟尽江南清绝趣，亟行归觐紫皇家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"拜书学博士作","author":"米芾","text":"昔梦浮生定是非，家山且喜隔年归。\n扁舟又出栏潮闸，出处初心老更违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"研山诗","author":"米芾","text":"山研云初抱，奁书客不传。\n北窗多异气，正对净名天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宝月观","author":"米芾","text":"浊尽尘难掩，光分逐露圆。\n香清得桂子，珠瑩坠花钿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"槐竹","author":"米芾","text":"槐前竹后午阴繁，壶岭华胥屡往还。\n雅兴欲为十客具，人和端使一身閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"万籁","author":"米芾","text":"万籁寒空响，群山隐映开。\n迟迟暮钟里，且唤竹舆来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"杉径","author":"米芾","text":"万槊森然老更成，要将馀韵斗僧清。\n道傍谁识凌云操，只有诗人著眼明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早来堂","author":"米芾","text":"山聚诗增思，洋宽墨有池。\n紫金化夕境，岚翠发朝曦。\n兜率当铜槛，蓬壶对蕙帷。\n平生会心趣，归计岂应迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游湖州","author":"米芾","text":"泛泛五湖霜气清，漫漫不辨水天形。\n虽无织女支机石，且对姮娥称客星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"周氏园居","author":"米芾","text":"高花落落照轩明，沼水涓涓绕砌声。\n静里闻香醒倦思，雨中无事见閒情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同官送鲈二首 其一","author":"米芾","text":"斑鳞拧鬣玉为肌，梦入松江自可疑。\n?跳金盘催脍手，西风正是忆鲈时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"同官送鲈二首 其二","author":"米芾","text":"齑黄鲤赤太凡生，莼紫枨青道不行。\n暂喜满盘堆玉臛，误教陈粟傲香粳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观雪","author":"米芾","text":"月姊封银界，龙君幻玉壶。\n江南三尺雪，人道十年无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"新沼未有水","author":"米芾","text":"排槛花争媚，环林石斗苍。\n何时潴渌净，吾欲借藤床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净名作","author":"米芾","text":"大球三尺美无臕，素业清风合立朝。\n此别何言赠君子，谠言忠论好裨尧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题壁间 其二","author":"米芾","text":"水月虚怀，烟霞浪迹。\n但莫憎爱，洞然明白。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书法赞","author":"米芾","text":"去颜肉，增褚骨。\n发天秀，助神物。\n敢窃议，增骨突。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"十八罗汉赞","author":"米芾","text":"巍巍释能儒，十八大果士。\n每于垢浊世，见此无相身。\n追貌自楚工，磷玉妙吴匠。\n种种出道韵，二幻与佛同。\n在处为道场，五浊化净土。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"法云佛国禅师白如来真赞","author":"米芾","text":"频瞻玉座，再奠金田。\n一般獦獠，敬备人天。\n不落此相，莫下名言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李邕帖赞","author":"米芾","text":"蓬□皇皇，才高气方。\n张说妒善，杜甫扬光。\n子敬储逸，僧虔与详。\n润分玉瑩，秀溢春芳。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"晦堂心如来真赞","author":"米芾","text":"此是晦堂，更无佛祖。\n百尺竿头，谁敢进步。\n无限众生，为此老误。\n误不误，陕府铁牛跳出土，两脚搥胸叫冤苦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王谢真迹赞","author":"米芾","text":"山林妙寄，岩廊英举。\n不繇不羲，自发淡古。\n有赫太帝，天造翰艺。\n末下龙迹，震惊天地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"唐文皇手诏赞","author":"米芾","text":"龙彩凤英，天开日升。\n亟戡多难，力致太平。\n云章每发，目动神惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王略帖赞","author":"米芾","text":"昭回于天垂英光，跨颉历籀化大荒。\n烟华淡浓动彷徉，一噫万古称天章。\n鸾夸虬引鹄序翔，洞天九九通辽阳。\n茫茫十二小劫长，玺完神诃命黻藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"欧阳询《度尚》《庾亮帖》赞","author":"米芾","text":"渤海光怪，字亦险绝。\n真到内史，行自为法。\n庄若对越，俊如跳踯。\n后学莫窥，遂趋尪劣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王献之苏氏宝帖赞","author":"米芾","text":"猗太宰，秀当代。\n灵襟疏，冲韵迈。\n一笔落，两行带。\n云龙廷，走百怪。\n惊电掣，断兕快。\n盘偃蹇，意无在。\n藐百川，会百海。\n人那知，冠千载。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"褚摹《右军兰亭燕集序》赞","author":"米芾","text":"耀耀客星，岂晋所得。\n养气泉石，留腴翰墨。\n戏著谭标，书存马式。\n郁郁昭陵，玉盌已出。\n戎温无类，谁宝真物。\n水月何殊，志专用一。\n绣缫金鐍，瑶机锦綍。\n猗欤元章，守之勿失。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王右军稚恭帖赞","author":"米芾","text":"混沌破，龙蛇出。\n大荒子，鼓神物。\n纵变怪，造恍忽。\n起洪水，稽天骨。\n大道惊，戮狂勃。\n时蛰引，无惮率。\n神禹符，镇罅窟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黄龙真赞","author":"米芾","text":"的的曹溪一点开，从兹驴足踏尘埃。\n黄龙若不三玄接，争得东林八转来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"临化偈","author":"米芾","text":"众香国中来，众香国中去。\n人欲识去来，去来事如许。\n天下老和尚，错入轮回路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"满庭芳 绍圣甲戌暮春与周仁熟试赐茶书此乐章中岳外史米元章书","author":"米芾","text":"雅燕飞觞，清谈挥坐，使君高会群贤。\n密云双凤，初破缕金团。\n窗外炉烟自动，开瓶试，一品香泉。\n轻涛起，香生玉麈，雪溅紫瓯圆。\n娇鬟，宜美盼。\n双擎翠袖，稳步金莲。\n坐中客翻愁，酒醒歌阑。\n点上纱笼画烛，花骢弄，月影当轩。\n频相顾，馀欢未尽，欲去且留连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"郴江百咏 其五十 千秋水","author":"阮阅","text":"不求至道不修真，一穴涓涓岂有神。\n王锡苏耽已仙去，未应皆是酌泉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉泰昭阳大渊献筑室董孝君祠之西下有湖焉某曰溪以董君慈孝而得名县又以是名则是湖宜亦以慈名作诗曰 其五","author":"杨简","text":"惜也天然一段奇，如何万古罕人知。\n只今讲学从游地，一听思为一听疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"嘉泰昭阳大渊献筑室董孝君祠之西下有湖焉某曰溪以董君慈孝而得名县又以是名则是湖宜亦以慈名作诗曰 其六","author":"杨简","text":"惜也天然一段奇，如何万古罕人知。\n慇勤为语从游子，孰是思为孰是疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶作 其八","author":"杨简","text":"勿认胸中一团气，一团气里空无地。\n既空何地更何义，此无广狭无一二。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶作 其十四","author":"杨简","text":"雪月风花总不知，雕奇镂巧学支离。\n四时多少閒光景，无个閒人领略伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偶成 其一","author":"杨简","text":"春入园林种种奇，化工施巧太精微。\n山禽说我胸中事，烟柳藏他物外机。\n既遣杏桃呈似了，又令蜂蝶近前飞。\n如何有眼无人见，只解西郊看落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上耿泉生朝","author":"杨简","text":"瞻彼云台，有那其武。\n祝阿发迹，中兴元辅。\n历世数十，有孙惟良。\n恺悌君子，之纪之纲。\n柔亦不茹，刚亦不吐。\n有志而宽，夫谁敢侮。\n天子曰于，亟来辅予。\n实彼周行，为上大夫。\n乃眷西顾，畀之节符。\n是司九府，爰总数路，爰究爰度。\n阜丰化布，国用是裕。\n江左矜刑，狱平讼清。\n惟清惟明，民用以宁，奸宄亦惩。\n乃抚徽人，惠绥千里。\n匪亟匪除，匪作匪异，而郡亦治。\n泉课复艰，属任斯难。\n□□斧扆，节至累颁，公毋惮烦。\n洎阳为邑，实惟所临。\n宽简虽至，威信亦深。\n敢不兢兢，治所赋金。\n以谨以程，以恪以忱。\n惟公诞弥，良月惟时。\n地数盈成，梦维熊罴。\n何以寿之，南山维基，松柏维滋。\n毋祝毋祈，公自有之。\n某也作诗，于以敬之。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上邓宪生","author":"杨简","text":"维彼岷源，维深且长。\n是为大江，润泽南方。\n维江之东，有贤使者。\n惠德似之，溥泽润下。\n使者维公，有祖高密。\n云台第一，流芳泌泌。\n有孙维良，秉德正方。\n天子曰于，寘彼周行。\n古之遗直，亟辅予德。\n疾风劲草，岁寒松柏。\n乃眷西顾，金节畀之。\n礼乐光华，亦王近畿。\n钦哉祥刑，克宽克明。\n民罹旱虐，焦劳发情。\n民饥毋恐，惠泽方涌。\n适兼郡符，民有天宠。\n首白蠲租，宽博其模。\n大公靡私，匪畏匪拘。\n僵者起之，骨者肉之。\n知几千万，父之母之。\n洎阳为邑，罹旱则甚。\n故维私邑，蒙泽亦甚。\n维公诞弥，端月维时。\n梦维熊罴，何以寿之。\n南山维基，大椿植之。\n毋祝毋祈，公自有之。\n某也作颂，于以敬之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"代冯似宗寿楼文昌","author":"杨简","text":"维山四明，涵奇孕英。\n或曰降神，为今甫申。\n倬彼云汉，昭回其文。\n凤鸣朝阳，决河昆崙。\n代天而言，粹其德音。\n补衮大手，石色五有。\n砥柱中流，屹屹其守。\n为人所难，一辞万口。\n文昌大名，太山北斗。\n云归星驾，持麾东下。\n乘流御风，琳宫燕暇。\n山水清晖，亲戚情话。\n不间遐贱，如某某者。\n肆筵设席，获教蒙益。\n缱绻绸缪，问遗不息。\n万金良药，再生大德。\n阳复之望，惟公诞辰。\n何以贶之，秉国之钧。\n何以寿之，南山之椿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题景范堂","author":"袁燮","text":"曾子才高事事能，就中一事最堪称。\n前贤拯救苍生意，赖有斯人解服膺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"答林康民见和梅花诗","author":"洪迈","text":"寒崦人家碧溪尾，一树江梅卧清水。\n□□不受俗眼污，风敛天香瘴烟里。\n向来休沐偶无事，谁我亦游二三子。\n弯埼曲径一携筇，冻雀惊飞能莫委。\n班荆劝客小延伫，酌酒赋诗相料理。\n多情入骨怜闵殊，休倚横斜嚼冰蕊。\n至今清梦挂残月，强作短歌传□□。\n韵高常恨白难称，赖有君诗清且美。\n天涯岁晚感乡物，归欤何时路千里。\n柁楼一笛雪漫空，回首江亭泪如洗。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钟山石","author":"曾极","text":"战血潜流石脉中，苍崖凿断见殷红。\n千年杀气方回薄，草木无春山尽童。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三品石","author":"曾极","text":"一士真能重本朝，中原劲敌是天骄。\n无情石却登三品，不念忠贤屈下僚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"华隐楼","author":"曾极","text":"松声听罢独看云，华隐楼中控鹤身。\n治国神方难自献，祗将本草语时人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送郑丈赴建宁五首 其五","author":"叶适","text":"屏弃诚愚分，牢愁更索居。\n若逢知巳问，犹解课儿书。\n地僻门长闭，年饥菜自锄。\n相望无一事，不是故情疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送鹤还建康章德茂侍郎因成两诗 其一","author":"张镃","text":"来时雪羽带缁尘，养得摧残病离身。\n晓浴池宽薝卜绕，夜栖笼阔海棠邻。\n吟诗屡听狂居士，入梦应思旧主人。\n且喜载随千骑去，不妨乘势长精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"桂隐纪咏四十八首 其一 桂隐","author":"张镃","text":"未说花开好，团看叶自奇。\n明朝非愿避，爱树恐相离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"敬和东宫春日泛湖韵","author":"张镃","text":"空林飞彩逐丝轻，瑞日重光特易晴。\n岁岁都人望行乐，六旂遥映百花明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":34747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]