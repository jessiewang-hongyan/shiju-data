[{"title":"偈颂二十一首 其十七","author":"释坚璧","text":"金叶银茎报有秋，明珠万斛堂中收。\n自从一饱家田饭，不用埋头向外求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十三","author":"释坚璧","text":"空手把锄头，步行骑水牛。\n凭兹陪睿算，垂拱亿千秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十二","author":"释坚璧","text":"及时阳燄欲烧空，中有清凉一径通。\n众苦不来寒暑尽，铁昆崙卧水晶宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十一","author":"释坚璧","text":"十日梅天晓未晴，千岩俱作偃溪声。\n直饶透出威音外，犹较曹山半月程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其九","author":"释坚璧","text":"园林宿雨不胜清，岩谷舂撞万杵鸣。\n个里豁开千圣眼，不闲弓矢贺升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其五","author":"释坚璧","text":"寰中独照万机息，壸外分权六国清。\n四海晏然王化里，不须当道话升平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居二首 其二","author":"释坚璧","text":"平生湖海竟何依，选得佳山赋式微。\n茗椀炉熏同宿学，蒲团禅板接初机。\n陂城水满芹尤滑，瓦钵肩挨粥未稀。\n睡起乌藤清兴在，不知老木挂残晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山居二首 其一","author":"释坚璧","text":"瓶盂古涧冷相依，云淡山寒月色微。\n眼底宾朋聊自足，屋头猿鸟恰忘机。\n山园茶笋疏疏有，世路人情渐渐稀。\n不记化权前后际，卷帘移榻看斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"义副寺求","author":"释坚璧","text":"拈却义，除却法，过现未来，不消一劄。\n大海波腾河四流，激湍衮衮吞三峡。\n须弥山王拊掌笑，江神河神俱?跳。\n留得珊瑚对月寒，九曲明珠无孔窍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞三首 其三","author":"释坚璧","text":"喻指喻马，何劳真假。\n说性说心，转见病深。\n灵山拈花，不曾动著。\n少林冷坐，徒自沈吟。\n良工欲写莫可写，汝曹敬之隔千林。\n山阴阴，水沈沈。\n苍苔雪径冷不彻，花鸟夕阳閒古今。\n真兮真兮，胡得而临。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞三首 其二","author":"释坚璧","text":"痴不自揆，老不知休。\n提真觉雀觜杖，用曹山死猫头。\n乾剥剥，冷湫湫。\n炙地熏天无气息，抛沙撒土觅冤雠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自赞三首 其一","author":"释坚璧","text":"三际断，一亘空。\n转不转，功不功。\n迢迢物外像，矫矫岩间松。\n密密处不堪亲近，荒林里得意相逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十九","author":"释坚璧","text":"阴极俄惊一线回，石人岭上笑咍咍。\n摧残枯木非枯木，今日花从冷处开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十六","author":"释坚璧","text":"木人夜半穿靴，难寻踪迹。\n石女天明不露，谁辨亲疏。\n枯木上一点春回，古渡头千寻寒雪。\n同门出入不来还忆渠，同气相求回来劫无说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十五","author":"释坚璧","text":"树凋叶落，体露金风。\n尧眉八字，舜目重瞳。\n机如掣电者，难寻踪迹。\n口似磉盘者，蓦地相逢。\n翻地揭天休作解，新罗元在海门东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十四","author":"释坚璧","text":"法法不隐藏，古今常独露。\n槐影转清阴，风催岩下雨。\n厨库对僧堂，灯笼挂露柱。\n只有一处最誵讹，半夜泥蛇吞石虎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十","author":"释坚璧","text":"皓月当空，寒江不动。\n万里清光，曾非别共。\n蚌孕珠而无从，兔怀胎而非种。\n万别千差，波腾海涌。\n卷舒只在一毫端，不用浑家生奉重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其八","author":"释坚璧","text":"仲冬严寒，一阳长至。\n佛祖有机关，俱落第二义。\n岂不见沩山寂子与香严，未免将泥土里洗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其七","author":"释坚璧","text":"玉象吞狮子，泥牛上绣鞍。\n御楼观射猎，不是刈茆田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其六","author":"释坚璧","text":"释迦悭，迦叶富。\n欺负乎人，誇张莽卤。\n五天不纳到支那，塞壑填沟无避处。\n无避处，不遮护，汲兴相逢，如涂毒鼓。\n直须亲切一回来，莫似邯郸学唐步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其四","author":"释坚璧","text":"今朝六月中，嘉田雨沾足。\n山房冷似冰，千山拥寒玉。\n祖意不西来，法身无展缩。\n水上挂灯毬，镇州出萝卜。\n三盏不沾唇，百味皆具足。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其三","author":"释坚璧","text":"大用全提作者知，烁迦眼活电光迟。\n大悲院里翻身处，临济甘为小厮儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其二","author":"释坚璧","text":"晷运推移，日南长至。\n一夜东海乌龟，吞却南山鳖鼻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其一","author":"释坚璧","text":"日月如弹丸，顽心似坚石。\n坚石不可融，弹丸易跳掷。\n始见踏青行，相将年又极。\n谁将后夜霜，换我双鬓黑。\n有个不老方，诸人识不识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞卿老真","author":"释坚璧","text":"风萧萧，天空四壁。\n雨疏疏，岩花狼藉。\n乾剥剥，白浪滔天。\n寂寥寥，遍界荆棘。\n漾在栖云草莽中，堪嗟大地无人识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赞真觉","author":"释坚璧","text":"三回九度，见神见鬼。\n德山一棒，痛彻骨髓。\n敲老观门，泼瓦官水。\n而今冷坐眼麻眉，错认东瓜作碓觜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和静照诗韵 其二","author":"释妙弘","text":"寻幽觅胜到天台，触目风光剪剪开。\n欲问昙猷旧遗迹，千山排闼送青来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和静照诗韵 其一","author":"释妙弘","text":"莫辞迢递供杯茶，香喷云腴映彩霞。\n两两梦中休说梦，觉来浑是梦中花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"六祖夜渡赞","author":"释妙伦","text":"树烟漠漠水沈沈，父子相抛用贼心。\n授了衣盂连夜渡，钉桩摇橹到于今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无杂","author":"释妙伦","text":"平常用处黑漫漫，十二时中没两般。\n大小赵州噇饭汉，斧头返被蛀虫钻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月窗","author":"释妙伦","text":"曲曲弯弯地，明明白白中。\n当轩开阖处，一隔为谁通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"示舜上人","author":"释妙伦","text":"古镜未磨黑似漆，及乎磨后也模糊。\n忽然打作百杂碎，笑倒当年舜老夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西岩","author":"释妙伦","text":"怪石嵌空溅碧流，从来无路与人游。\n莫嫌立处孤危甚，要与东山作对头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音赞","author":"释妙伦","text":"皎皎月沈波，萋萋草泣露。\n良哉观世音，不会转身句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牧溪","author":"释妙伦","text":"百草头边意已赊，鞭绳放下卧平沙。\n觉来古岸东风急，横笛一声山日斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其三","author":"释妙伦","text":"草舍柴门僻更幽，何期过客也经由。\n蒿汤备礼不知愧，犹对傍人卖口头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12972,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"颂古五首 其二","author":"释妙伦","text":"赵老七斤衫，提来用恰好。\n若更问如何，且去青州讨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12973,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其十六","author":"释妙伦","text":"安眠露地牛，未脱黄金索。\n常在顾盼中，牧童难捉摸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12974,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其六","author":"释妙伦","text":"庭前黄叶坠，岭上白云屯。\n风味无多子，何人共我论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12975,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十二首 其二","author":"释妙伦","text":"一自休戈见太平，跨龙仙去彩霞轻。\n感恩惟有西湖水，夜夜清波蘸月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12976,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其八十五","author":"释妙伦","text":"将军令下闪旌旗，胡骑纷纷顿失威。\n纵有突然骁骤者，不知身已陷重围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12977,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其八十三","author":"释妙伦","text":"扫荡边尘未著劳，折弓戏把射青霄。\n满攀自觉无多力，随手那知落一雕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12978,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其八十一","author":"释妙伦","text":"明珠璨璨对人倾，是甚多年鱼眼睛。\n抛撒满前收不上，粪箕埽帚乱纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12979,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其八十","author":"释妙伦","text":"窦八抽身已败赃，偷儿曲为巧遮藏。\n一家著贼犹闲事，搅断平人几肚肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12980,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其七十七","author":"释妙伦","text":"一从醉别画堂前，鬓乱钗横语笑颠。\n最是恼人肠肚处，借婆裙子拜婆年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12981,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其七十","author":"释妙伦","text":"送春剩欲举金樽，客不开襟怎与论。\n自饮一杯归去后，喜逢家乐闹黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12982,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其六十四","author":"释妙伦","text":"紫箫声断月初斜，笑指蓬瀛是故家。\n十二玉楼寻不见，手攀仙鹤步烟霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12983,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其五十八","author":"释妙伦","text":"村翁因事扣巫师，祸福通肠直示伊。\n获得黄金家富贵，几多空自起狐疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12984,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其五十六","author":"释妙伦","text":"百花丛里跃鞭过，俊逸风流有许多。\n未第儒生偷眼觑，满怀无柰旧愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12985,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其四十八","author":"释妙伦","text":"自把碌砖空里掷，必端自打自家头。\n酌然自痛自难说，自著摩挲归去休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12986,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其四十五","author":"释妙伦","text":"老姑强作少年时，烂把宫嫱红粉施。\n不管旁边人冷笑，满头犹更插花枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12987,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其四十","author":"释妙伦","text":"萧萧黄叶埋荒径，霭霭浮云锁野堂。\n一阵西风俱埽尽，几根乔木倚斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12988,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其三十七","author":"释妙伦","text":"后园驴吃草，开口见心肝。\n潘阆倒骑处，有谁能解看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12989,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其三十三","author":"释妙伦","text":"九日重阳节，渊明采菊时。\n黄花到处有，何止在东篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12990,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其三十一","author":"释妙伦","text":"秋云秋水两依依，塞雁声声度翠微。\n多向洞庭芳草岸，楚天空阔不知归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12991,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其二十五","author":"释妙伦","text":"隐隐烟村闻犬吠，欲寻寻不见人家。\n忽于桥断溪回处，流出碧桃三四花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12992,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其二十三","author":"释妙伦","text":"祇园千树秀，净土九莲敷。\n多少参玄士，茫茫在半途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12993,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其十六","author":"释妙伦","text":"沙鸥尽日戏江滨，几度浮来几度沈。\n渔笛一声惊起去，依前飞下碧波心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12994,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂八十五首 其四","author":"释妙伦","text":"晓花初拆露香新，独向空山冷衬云。\n忽被春风轻触著，淡红脱落乱纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12995,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄人","author":"释妙伦","text":"去年共绕涧滨行，话尽山云海月情。\n芳树幽禽尤记得，风前时作两三声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12996,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦庵相士","author":"释妙伦","text":"烟霞影里苍苔面，山水光埋古柏身。\n为报梦庵休诸梦，老僧不是梦中人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12997,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"懒散","author":"释妙伦","text":"一味放落魄，谁人柰得何。\n忽然刀斫手，依旧著摩挲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12998,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"又泛水像赞","author":"释妙伦","text":"觉而动，照而寂。\n云净月明，波停水碧。\n圆通触处露全身，依旧脚跟浮逼逼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":12999,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与若虚新戒付衣","author":"释妙伦","text":"灵山密付，少室亲传。\n或长或短，或方或圆。\n直下若能提得起，优昙一朵瑞祇园。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13000,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"友方请赞","author":"释妙伦","text":"怒具慈悲，喜怀惨酷。\n指方为圆，拗曲作直。\n不特凿石栽花，兼要堆云种竹。\n五五合成三十六，好彩是汝不学他，学他和汝入地狱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13001,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"支提宏老请赞","author":"释妙伦","text":"搭一只手，挥三尺铁。\n天下衲僧，望风胆裂。\n岂料丰干院里撞著个匾头魔孽，尽把家私俱漏泄。\n却向玉融侧童峰前，对人点胸，背地吐舌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13002,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日本门上人请赞","author":"释妙伦","text":"须弥绕白日，碧落穿红霞。\n唤作真则错，唤作相则差。\n只此一门难摸索，赚他几个失脚走天涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13003,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日本云上人请赞","author":"释妙伦","text":"山头云，天上月。\n云月有殊，光影无别。\n此是吾端的，不许见，不许闻。\n大唐国有人，必能辨，必能别。\n不妨捲去挂向大溪头，教他几个横论竖论东说西说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13004,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"日本见上人请赞","author":"释妙伦","text":"一见便见，一得永得。\n有影无形，易辩难识。\n大唐不许藏踪，日本那容隐迹。\n扶桑夜半日头红，不妨背手拈起一观，决定头斜面曲，鼻横眼直。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13005,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月藏主请赞","author":"释妙伦","text":"头颅突兀，面孔鳞皴。\n刚把一茎灯草，对人秤作半斤。\n阿呵呵，从教道月明照见夜行人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13006,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋和尚赞","author":"释妙伦","text":"朝向廛中游，暮打市里过。\n滞货卖不行，赖是肚皮大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13007,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观音观老请赞","author":"释妙伦","text":"眼无筋，头无脑。\n是个非个并除，佛兮魔兮俱扫。\n须弥山折箸挑来，眉毛上悬挂恰好。\n是谁识他，观音长老。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13008,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"达磨赞","author":"释妙伦","text":"西竺乾，东震旦。\n遍流毒，是者汉。\n不知赚了多少衲僧，至今八错七差三马九乱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13009,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寿首座请赞","author":"释妙伦","text":"漆桶一枚，无大得大。\n鼓合丛林，翻成口过。\n有语不勘玄机，有棒不打铁磨。\n南屏今日开眼放一个，咄咄咄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13010,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵照女赞","author":"释妙伦","text":"生不居家，长不出嫁。\n一柄笊篱，天上天下。\n虽然不直分文，只是无人著价。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":13011,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]