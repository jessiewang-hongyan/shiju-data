[{"title":"席上信笔 其四","author":"李弥逊","text":"游丝无力系春风，水面从飘点点红。\n晚渡舟横人独立，厨烟著柳细濛濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60577,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"席上信笔 其三","author":"李弥逊","text":"春衫更怯晚来风，准拟衰颜借酒红。\n到得杯行愁不饮，烛红隐隐睡濛濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60578,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"席上信笔 其二","author":"李弥逊","text":"春云无绪不禁风，小立中庭数落红。\n还似江南断肠处，杨花十里雪濛濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60579,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"席上信笔 其一","author":"李弥逊","text":"春眠不觉夜来风，桃萼犹沾未尽红。\n愁绝小湖山畔路，同云疏雨晚濛濛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60580,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"席上偶成 其二","author":"李弥逊","text":"伤春早觉鬓丝垂，谁遣飞花近酒杯。\n青翼若能传客恨，莫教红紫放春回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60581,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"席上偶成 其一","author":"李弥逊","text":"群玉装成宝璐垂，月扶疏影上馀杯。\n莫言一醉驱愁得，载酒须来一百回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60582,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题曾丞道堂","author":"李弥逊","text":"阴阴翠竹锁虚堂，竹外青山半出墙。\n七尺龙牙消白昼，便应题作小秋霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60583,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题鉴远楼 其三","author":"李弥逊","text":"霜天晓日鉴中新，眼力由来未见真。\n万古茫茫一尘迹，碧山无际水无垠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60584,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题鉴远楼 其二","author":"李弥逊","text":"凭虚瞰碧与云浮，只有闲身尽日留。\n更拟梦回还独上，来看残夜水明楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60585,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留题鉴远楼 其一","author":"李弥逊","text":"表里江山面面来，秋风此日偶徘徊。\n尘埃阅尽心如鉴，一到江楼眼为开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60586,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"留赠无诤堂涌泉利老","author":"李弥逊","text":"户外双峰碧碍天，定回香灺已收烟。\n苦将峭语撩痴客，借枕重参一味禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60587,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中初见梅花驰送季申枢密并以二绝 其二","author":"李弥逊","text":"病眼逢花不忍窥，飞奴走送已嫌迟。\n定知着意怜纤瘦，不放春心落别枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60588,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"病中初见梅花驰送季申枢密并以二绝 其一","author":"李弥逊","text":"老干疏枝不耐冬，喜闻芳信扰青红。\n应缘技痒争春力，不待铅华破晓风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60589,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成 其一","author":"李弥逊","text":"蘧然真梦午钟回，独倚风轩数落梅。\n鼻观得香无处觅，僧窗寂寂定初开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60590,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成 其二","author":"李弥逊","text":"野水旁边不系舟，偶随波浪信沉浮。\n如今却向来时路，预买闲塘着狎鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60591,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿光林怀少章","author":"李弥逊","text":"烟断伽蓝欲报昏，竹梢风雨乱纷纷。\n悬知借枕山腰舍，魂梦已随超化云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60592,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"崇安寺谒归云老人不遇","author":"李弥逊","text":"入寺又逢曦未来，草荒庭院几生埃。\n黄华翠竹无人问，只得僧房一梦回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60593,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚投大云峰 其二","author":"李弥逊","text":"高树风生晚径秋，平沙无日下凫鸥。\n野航邀月渡溪北，古寺僧归钟鼓楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60594,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚投大云峰 其一","author":"李弥逊","text":"山根篱落枕溪流，岸竹攲斜系小舟。\n一段黄云粳稻熟，牧儿腰笛倒骑牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60595,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚步独至西溪 其三","author":"李弥逊","text":"我来点检春踪迹，山北山南绿暗丛。\n留与骚人做愁本，花根一点著泥红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60596,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚步独至西溪 其二","author":"李弥逊","text":"十日不一见此君，春笋满林深闭门。\n杖藜特特穿苔径，问讯南阶添几根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60597,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚步独至西溪 其一","author":"李弥逊","text":"睡起方床日未斜，旋移屐齿破晴沙。\n石栏独立数归鸟，高树无风落柿花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60598,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒奉天超公法师作 其二","author":"李弥逊","text":"杯水能令重百钧，阿师心法妙通神。\n维摩正苦众生病，为洗无边热恼尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60599,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒奉天超公法师作 其一","author":"李弥逊","text":"赤云叶叶挂林丘，道士黄尘没马头。\n隔水净坊人不到，抱崖竹柏暗藏秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60600,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"富沙道中","author":"李弥逊","text":"征衣犹带去年尘，入眼溪山似故人。\n社燕秋鸿应共笑，是翁如我往来频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60601,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"智道者入闽作大缘事一住数年将归以偈送之","author":"李弥逊","text":"道者南行作胜缘，下穷有际上诸天。\n却来踏着铜峰路，可费虚抛买屐钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60602,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渡江 其二","author":"李弥逊","text":"山形虎脊高低去，帆影鱼鳞远近来。\n已到江南望江北，更留青眼为谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60603,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渡江 其一","author":"李弥逊","text":"沿江山断水如天，横绝奔流一叶船。\n身世自知同幻梦，不应对此重茫然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60604,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游玉华洞","author":"李弥逊","text":"步出山门日已西，昏鸦寒并隔巢枝。\n更寻陈迹穿阴洞，藓壁关真屈径奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60605,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游龙潭","author":"李弥逊","text":"百念轻冰已着汤，解缨何必濯沧浪。\n欲收一滴寒潭水，散作人间无尽凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60606,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游梅坡席上杂酬 其一","author":"李弥逊","text":"知章不怕酒如泉，莫遣花催蜡蠋烟。\n明日宿云生晓雾，一番风雨暗梅川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60607,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游梅坡席上杂酬 其三","author":"李弥逊","text":"酒面风生缬，纱巾日共斜。\n醉乡知路隐，不复问吾家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60608,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游梅坡席上杂酬 其五","author":"李弥逊","text":"白玉千株暗，青云一径斜。\n从来少车马，恐是阿环家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60609,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游梅坡席上杂酬 其六","author":"李弥逊","text":"花拥山头白，云翻日脚斜。\n银蟾已照路，游客莫思家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60610,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游梅坡席上杂酬 其二","author":"李弥逊","text":"风约疏梅蘸石泉，山涵弱柳借厨烟。\n竹篱茅屋倾樽酒，坐看银钩上晚川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60611,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游梅坡席上杂酬 其四","author":"李弥逊","text":"醉帽迎风落，春衣日径斜。\n花梢密藏路，隐约见山家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60612,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游梅坡席上杂酬 其八","author":"李弥逊","text":"得路山方尽，如归馆暂投。\n春风供笑傲，一醉岂人谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60613,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游梅坡席上杂酬 其七","author":"李弥逊","text":"夜饮宁辞醉，春醒莫厌投。\n有人重载酒，后会不须谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60614,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登楼","author":"李弥逊","text":"翻经兴尽捲书帷，独上江楼送落晖。\n人迹已随云影断，傍檐嘉月冷侵衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60615,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道游武夷遇雨既渡复回明日竟游九曲而行因留 其二","author":"李弥逊","text":"渡口回舟未忍移，净坊听雨坐题诗。\n馀龄倘有寻真路，试与披云问凤儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60616,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"道游武夷遇雨既渡复回明日竟游九曲而行因留 其一","author":"李弥逊","text":"人间何地寄衰翁，偶到神山一苇中。\n可是仙君谢逋客，船头无处避刚风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60617,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嗣知客远访筠溪留旬馀将归以偈送之","author":"李弥逊","text":"剥啄君来破郁陶，解包相对煮溪毛。\n一坡脩竹无穷意，可但灵云只见桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60618,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题大儒寮小阁","author":"李弥逊","text":"青鞋踏尽剑铓山，借枕僧房落照间。\n高屋凭虚听泉语，岭云应似我身闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60619,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题范才元湘江诗画","author":"李弥逊","text":"诗才妙入江南画，画手工传渭北诗。\n一段澄心卷湘水，吟轩长对唤船时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60620,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵干江行初雪图","author":"李弥逊","text":"瓜步西头水拍天，白鸥波上寄长年。\n个中认得江南手，十里黄芦雪打船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60621,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题福州与春亭","author":"李弥逊","text":"史君同乐在春亭，吏退心田水样清。\n恰似春风吹百卉，白红无数不知名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60622,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又和少章别","author":"李弥逊","text":"非无山林意，去住亦随缘。\n落日有归翼，乱山犹着鞭。\n风檐依路湿，烟树著行圆。\n清绝归时思，新诗句句传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60623,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与公序避暑石盎方昼欲寝闻林间鸟鸣甚乐因得小诗云","author":"李弥逊","text":"一林啼鸟不知名，应怪山翁此地行。\n化蝶与周俱是梦，游鱼知我久忘情。\n胸中丘壑真馀事，世上功名畏后生。\n但得盈樽供自酌，何妨人境卧渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60624,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与公晔饮西山坐上再和前韵","author":"李弥逊","text":"了无一物可当情，休数行年问丙丁。\n世事于今浑似梦，醉魂从此不须醒。\n江流带月分清浊，星汉无云见纬经。\n酒尽更谋须稚子，坐听潮落响霜汀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60625,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与似表弟游石门怀蹈元时中用高字韵","author":"李弥逊","text":"逼人尘事等牛毛，袖手端须着眼高。\n策蹇倦追千里马，荷锄安用百金刀。\n病来避酒连三月，春半寻山等一遭。\n不见鞭鸾两仙吏，秪应上界亦分曹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60626,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与粹之游支提九日仲宗以诗酒见寄次韵答之","author":"李弥逊","text":"蛇径回环织女机，足间攲石碍云飞。\n西风短发欺乌帽，落日清尊走白衣。\n病眼逢山寒水净，妄心更事远烟微。\n扫除磊磈装怀地，为载千岩万壑归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60627,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久阴闻督邮至县奉简蹈元","author":"李弥逊","text":"惊呼鸡犬督邮来，想见文书手自催。\n鼓枻黄头罢田去，倾囊黔首入苗回。\n春盈半月倾盆盎，夜雹前时落李梅。\n已向茫头望笼饼，阳乌几日放天开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60628,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨 其二","author":"李弥逊","text":"榕根败屋两三椽，客径无人老更便。\n地近东南多泽国，雨逢甲子少丰年。\n径须酣饮六十日，安用取禾三百廛。\n待得风头风力□，梅花如雪月初圆。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60629,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨似有晴意继而复阴作望晴","author":"李弥逊","text":"一夜翻河落瓦沟，平明山霭欲全收。\n正疑础润云生足，直怕天明日探头。\n倏忽去来观聚蚁，现前起灭悟浮沤。\n占晴不问黄衣使，已向鸟乌声际求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60630,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"久雨阻游昭亭有作","author":"李弥逊","text":"浪迹随方寄，穷途触事谙。\n雨逢春甲子，江满地东南。\n客鬓霜前落，诗情酒外酣。\n上方愁独往，藜杖许同参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60631,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大暑久不请谒登南楼望成父西庵慨然奉思因成小诗","author":"李弥逊","text":"南郭子綦隐，西郊杜老居。\n风流知异代，臭味本吾庐。\n高阁深翻贝，虚堂静散书。\n经旬想颜色，着雨问何如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60632,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小云堂","author":"李弥逊","text":"老子何因一念差，肯将簪绂换袈裟。\n同参尚有满路在，异世犹将逊老誇。\n结习未忘能作舞，因缘那得见拈花。\n却修净业寻来路，澹泊如今居士家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60633,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山门晚归","author":"李弥逊","text":"毗耶香饭壑源春，午枕聊分百亿身。\n旋落涧泉高下语，自鸣山鸟送迎人。\n云山往岁真成癖，觞咏一时俱绝尘。\n已办归途踏山暝，试扪高壁上星津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60634,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中遇雨","author":"李弥逊","text":"卯酒催归梦，僧房借枕头。\n客愁三日雨，山意十分秋。\n鸣涧涨还落，凝云去复留。\n阳乌肯回翼，高处卜深游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60635,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山居寄友人","author":"李弥逊","text":"结庐人境经过少，晚起长遭稚子催。\n闲处赤心忧国尽，病中白发爱山回。\n林泉可使居无竹，风雨空嗟摽有梅。\n不遣飞奴频过我，欲将怀抱向谁开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60636,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山游遇雨","author":"李弥逊","text":"杖藜寻胜复中休，不比红尘走燕骝。\n幽趣未穷随雨断，高情无尽与云浮。\n冥冥深树秋犹暗，猎猎新蒲暖更柔。\n老去行藏甘一壑，不须重广畔牢愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60637,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"门下大资颜公挽诗 其三","author":"李弥逊","text":"东郡连墙日，行藏二纪馀。\n空留冢上剑，不见枕中书。\n山黑佳城閟，堂阴旦宅虚。\n悲心寄松槚，哀韵拥輀车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60638,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"门下大资颜公挽诗 其二","author":"李弥逊","text":"不作鸾台梦，来寻凤沼春。\n劬劳知永慕，寿考见深仁。\n示疾元非病，离人已反真。\n生绡写遗恨，犹露衮衣身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60639,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"门下大资颜公挽诗 其一","author":"李弥逊","text":"洙泗流风远，仪型世有人。\n一经窥圣域，三返得贤臣。\n勋业艰难际，声名寂寞滨。\n赤松归有伴，此道独知津。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60640,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"云门道中晚步","author":"李弥逊","text":"层林叠巘暗东西，山转岗回路更迷。\n望与游云奔落日，步随流水赴前溪。\n樵归野烧孤烟尽，牛卧春犁小麦低。\n独绕辋川图画里，醉扶白叟杖青藜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60641,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五石 其五 阴壑","author":"李弥逊","text":"春山秋亦佳，霜树风更落。\n阴晴卷复舒，气象今非昨。\n功名等浮云，文字悬高阁。\n剩扫胸中奇，还将贮丘壑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60642,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天庆道士何丹林作亭竹间方成予名之以秀野因留小诗","author":"李弥逊","text":"斫竹通圭窦，开垣列画图。\n乾坤藏小有，日月近方壶。\n树色云边断，山形地外孤。\n时来骋游目，更为剪繁芜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60643,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天封观","author":"李弥逊","text":"摇落秋山路，烟留宝搆昏。\n曾回翠华步，不到紫虚门。\n可鉴丰碑壮，无知老柏尊。\n勒功当日事，寂寞更谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60644,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"月夜携家筠庄露坐池上分韵得谁字","author":"李弥逊","text":"累石骊泉十丈围，周遭种柳未成丝。\n溪童掬水得明月，山客扫花安屈卮。\n一榼团栾儿女语，四更历落斗牛垂。\n拦街白叟笑相问，倒着接䍦歌者谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60645,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东岗晚步","author":"李弥逊","text":"饭饱东岗晚杖藜，石梁横渡绿秧畦。\n深行径险从牛后，小立台高出鸟栖。\n问舍谁人村远近，唤船别浦水东西。\n自怜头白江山里，回首中原正鼓鼙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60646,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬雪呈太守张嵇仲 其三","author":"李弥逊","text":"插檐冰箸长新寒，薄日欺云到屋山。\n见晛半消梅额粉，因风犹染鬓毛斑。\n书生闭户眠仍稳，游子扁舟兴欲还。\n客里情怀逢岁晚，曲生邀我一开颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60647,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬雪呈太守张嵇仲 其二","author":"李弥逊","text":"控鹤缘云上广寒，四看明玉镂群山。\n铺檐漠漠鱼鳞合，入垄离离虎脊斑。\n整驭炎官方退听，将妃白帝肯言还。\n丰年预作田家喜，不独三钟慰病颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60648,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬雪呈太守张嵇仲 其一","author":"李弥逊","text":"夜气凝空作暮寒，平明积雪欲藏山。\n定知连腊连三白，已喜先春见一斑。\n神力巧将人意改，物华阴逐岁功还。\n忧民太守铃斋暇，想对壶觞正解颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":60649,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]