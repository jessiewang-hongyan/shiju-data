[{"title":"證道歌 其五十三","author":"释印肃","text":"三身四智体中圆，犹说三千及大千。\n八万法门从此出，咄哉王子去求仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二十五","author":"释印肃","text":"唤取机关木人问，触目菩提谁辨论。\n亡僧可喻木人机，玄沙直指何劳顿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一八○","author":"释印肃","text":"一性如来体自同，声闻执相有西东。\n忽然撞出来时路，九万鹏程顷刻通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其五","author":"释印肃","text":"无明实性即佛性，心净还同佛土净。\n水鸟树林声色中，殊无毫发来争竞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二○一","author":"释印肃","text":"若是野干逐法王，未曾举步早郎当。\n贵价精神贱价用，渠露全身汝急忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其七十四","author":"释印肃","text":"天龙寂听生欣悦，来散仙花岩畔列。\n解空没量道无能，动地雨华重漏泄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其五十二","author":"释印肃","text":"利物应机终不吝，毗耶假说众生病。\n众生了病即通光，领取旧持元本柄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其四十六","author":"释印肃","text":"貌悴骨刚人不顾，唯驾一乘称广度。\n谁人肯上此莲舟，独畅清风明月赋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一○八","author":"释印肃","text":"雾露云霞体上衣，何必缘尘百衲披。\n大庾岭头拈不起，卢公冷笑秀公痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二一三","author":"释印肃","text":"分别名相不知休，阳燄空花岂可求。\n龙舟旧阁闲田地，一度赢来方始休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8784,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一二二","author":"释印肃","text":"莽莽荡荡招殃祸，佛宝金轮翻铁磨。\n十波罗蜜变洋铜，饱吃多餐应不饿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8785,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二一一","author":"释印肃","text":"吾早年来积学问，冲风冒雨多迷闷。\n一到曹溪更不疑，方知往昔虚劳顿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8786,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其六十八","author":"释印肃","text":"定慧圆明不滞空，黄幡直下起清风。\n当时不得印宗老，卢能有过且无功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8787,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一二三","author":"释印肃","text":"弃有著空病亦然，却将阴入定安禅。\n阿赖耶识昆崙藏，万劫顽痴被业缠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8788,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其八十三","author":"释印肃","text":"我师得见然灯佛，历劫有为从此没。\n心心相印了无生，为君几下苍龙窟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8789,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二三八","author":"释印肃","text":"深嗟幪懂顽皮靼，只道无人来剔拨。\n我今年少或龙钟，胡乱度生管广挞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8790,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二三二","author":"释印肃","text":"病遇医王争得瘥，卢医体貌殊严怪。\n我见堂堂心胆惊，不领仙丹从此坏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8791,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其三十二","author":"释印肃","text":"有人不肯任情徵，大地山河发问情。\n一指头端无两样，普天匝地一时明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8792,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其八十","author":"释印肃","text":"语默动静体安然，谢三抛下钓鱼船。\n刚道参方不出岭，痴人犹尚走如烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8793,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一一九","author":"释印肃","text":"万象森罗影现中，无头无尾耀玲珑。\n常光运运从何起，始觉浑身赤挞穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8794,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一一五","author":"释印肃","text":"无相无空无不空，拈槌竖拂警盲聋。\n解道狗子无佛性，焉知全体与空同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8795,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其九十九","author":"释印肃","text":"争似无为实相门，朝歌暮拍整乾坤。\n东边打著西边响，到头只用一光吞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8796,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一三一","author":"释印肃","text":"是以禅门了却心，心心心外别无心。\n如今只是旧时底，不换源机放旷吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8797,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一二○","author":"释印肃","text":"一颗圆光非内外，镇海明珠今尚在。\n仰山不敢自埋藏，问著灵知当不昧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8798,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其九十四","author":"释印肃","text":"一切有为法不同，百鍊精金胜赤铜。\n自持自用应无尽，济老怜贫透日红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8799,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其五十五","author":"释印肃","text":"上士一决一切了，十二时中常皎皎。\n掷剑挥空大丈夫，回头自觉无边表。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8800,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二○○","author":"释印肃","text":"三岁便能大哮吼，文殊也道难征斗。\n遑遑权托罽宾牵，如今脱体无人守。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8801,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其四十五","author":"释印肃","text":"调古神清风自高，忘荣傲世性坚牢。\n示一往还无个事，见人摇手莫忉忉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8802,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一一一","author":"释印肃","text":"不是标形虚事持，释迦老子要人知。\n拈来放去非他物，运水搬柴事事宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8803,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一四五","author":"释印肃","text":"一月普现一切水，四处分舟同一体。\n多中一了一中多，莫学痴猿捞沼底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8804,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一五二","author":"释印肃","text":"刹那灭却三祇劫，更无丝发相交涉。\n无名天地亦非先，有名万物光重叠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8805,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一四八","author":"释印肃","text":"我性同共如来合，莫怪山僧情义薄。\n与君相见不相知，自脱方能解彼缚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8806,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二四二","author":"释印肃","text":"波离萤光增罪结，却把小乘文句说。\n疑心到此转怀惶，莫怪经非人自拙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8807,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二三六","author":"释印肃","text":"早时成佛于今在，瓶倾不出周沙界。\n妙音遐畅广宣扬，念者念兮拜者拜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8808,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一七九","author":"释印肃","text":"二十空门元不著，三乘五教都拈却。\n指头消息甚分明，病瘉何须重点药。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8809,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其四十九","author":"释印肃","text":"贫则身常披缕褐，教化众生求解脱。\n众生愈把綵红缠，见我如斯嗔咄咄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8810,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一五八","author":"释印肃","text":"觅即知君不可见，穿过髑髅无不遍。\n举头鹞子过新罗，失却桃花秋月面。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8811,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一九八","author":"释印肃","text":"走兽飞禽皆远去，知道本来无住处。\n空无鸟迹地无踪，碧眼胡僧面壁觑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8812,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其九十八","author":"释印肃","text":"招得来生不如意，得少为多儿子戏。\n广大门庭不肯游，衔铁拖犁泥里睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8813,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其十四","author":"释印肃","text":"自招拔舌尘沙劫，沙界弥纶唯我舌。\n未曾停歇说真经，惟愿含灵皆廓彻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8814,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一九三","author":"释印肃","text":"欲得不招无间业，对境无心心自歇。\n何须苦苦外驰求，灵光独耀如明月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8815,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其九十二","author":"释印肃","text":"阒寂安居实潇洒，拄杖撑天犹懒把。\n兴云布雨济含生，试问乾坤谁渴者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8816,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一九二","author":"释印肃","text":"不须怨诉更尤人，动是洋铜铁汁淋。\n更入火轮并剉碓，牛头狱卒脔肝心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8817,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其七十三","author":"释印肃","text":"香象奔波失却威，木女来呼叫阿谁。\n普贤露地空弹指，一场败阙少人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8818,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二五七","author":"释印肃","text":"大千沙界海中沤，何必春风更点头。\n雪夜一枝浑漏泄，速传驿马进王侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8819,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二五九","author":"释印肃","text":"假使铁轮顶上旋，万里神光体自然。\n邪魔似雪飞汤里，安能惊动老婆禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8820,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二四三","author":"释印肃","text":"维摩大士顿除疑，离四句兮绝百非。\n实相门中非我所，一轮心月镇光辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8821,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二五三","author":"释印肃","text":"我今解此如意珠，不论贫富灌头舒。\n出没往来无欠缺，四生六道入无馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8822,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二○四","author":"释印肃","text":"有疑不决直须争，强把砖磨马祖前。\n牛行不在车心打，当时鼻孔廓辽天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8823,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其七十六","author":"释印肃","text":"寻师访道为参禅，先将鼻孔与人穿。\n大喝一声三日困，尘毛犹挂曲床边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8824,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其六十九","author":"释印肃","text":"非但我今独达了，万古宗心应不少。\n皆从非相入无馀，未离形名终莫晓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8825,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一一四","author":"释印肃","text":"了知二法空无相，泥塑金装为佛像。\n日日香华夜夜灯，谁知在一毛头上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8826,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一九○","author":"释印肃","text":"恨不灭除令瓦碎，百计千方来逞怪。\n熙怡端坐古峰头，设若归依还自拜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8827,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一三八","author":"释印肃","text":"布慈云兮洒甘露，润物沛生无伴侣。\n庐陵米价没人酬，窈窕冥冥自相许。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8828,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一○四","author":"释印肃","text":"自利利他终不竭，一华五叶□分别。\n森罗万象影居中，自古至今无漏泄。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8829,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一五○","author":"释印肃","text":"非色非心非行业，休指黄花并绿叶。\n说时似有證时无，从此家邦大安贴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8830,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二○八","author":"释印肃","text":"差之毫釐失千里，掣电之机休拟议。\n不在低头与别思，普光即是无师智。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8831,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二二二","author":"释印肃","text":"外道聪明无智慧，养生只欲贪名利。\n烧丹鍊药学神仙，有为不了终归坠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8832,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二四四","author":"释印肃","text":"犹如赫日消霜雪，逡巡业海皆枯竭。\n露出毗卢体不分，别无艺解堪施设。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8833,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二四七","author":"释印肃","text":"四事供养敢辞劳，自有摩尼价最高。\n任君宝满三千界，性无利益漫丰豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8834,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二三四","author":"释印肃","text":"火里生莲终不坏，念念劳生不自在。\n彼既丈夫我亦然，舍短从长无挂碍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8835,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其三十","author":"释印肃","text":"即是如来大圆觉，切忌将心重卜度。\n鸟窠拈起布毛吹，未透玄津休摸索。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8836,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其四十四","author":"释印肃","text":"达者同游涅槃路，个个无衫并没裤。\n一灯相续百千灯，传灯录上名无数。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8837,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其三十六","author":"释印肃","text":"如来藏里亲收得，随时影现青黄白。\n珠体元无一色同，无端也被沩山索。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8838,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二三○","author":"释印肃","text":"未了还须偿宿债，这个冤家何日解。\n得休休去且休休，莫入他家饶了卖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8839,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其九","author":"释印肃","text":"五阴浮云空去来，自是凡夫眼不开。\n烂煮坚冰充午膳，熟煎雪块作油䭔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8840,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一八七","author":"释印肃","text":"去圣远兮邪见深，祖师肚里觅知音。\n两个禅僧相借问，旧时佛法不如今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8841,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一一六","author":"释印肃","text":"即是如来真实相，闹市卓牌标榜样。\n子湖狗子咬三关，未透玄机招业障。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8842,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一三二","author":"释印肃","text":"顿入无生知见力，不问晴乾并雨湿。\n逢场作戏弄心花，彼自纷纷非我急。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8843,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二六八","author":"释印肃","text":"未了吾今为君决，一字不留无可说。\n耀古腾今彻底辉，不离当体常光洁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8844,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二二七","author":"释印肃","text":"不见一法即如来，万机顿绝笑咍咍。\n将军战马今何在，野草闲花满地开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8845,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其一○二","author":"释印肃","text":"如净琉璃含宝月，昔时未悟今皆彻。\n只有此心更没心，不览邪师文字诀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8846,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二十八","author":"释印肃","text":"寂灭性中随饮啄，渴饮饥餐无住著。\n不患寡而患不均，众生和悦因斯乐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8847,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其七十七","author":"释印肃","text":"自从认得曹溪路，鸟道征空步坦途。\n攫雾拿云风亦怕，降魔事毕念苏卢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8848,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其四十","author":"释印肃","text":"唯證乃知难可测，莫逐文章名利客。\n聪明不敌死生关，五蕴皆空何苦厄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8849,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"證道歌 其二○六","author":"释印肃","text":"修行恐落断常坑，说有说无只管争。\n教体未全言句落，意识心随声色行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8850,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十四首 其十三","author":"释印肃","text":"一轮秋月映悲风，数和松音标此意。\n因缘究竟莫劳神，时节到来无不备。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8851,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十四首 其八","author":"释印肃","text":"老卢得法非僧相，庞老通明岂离家。\n大事未成俱业网，除非了本是生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8852,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十四首 其三","author":"释印肃","text":"若得桥行心亦行，莫教孤负见贫僧。\n不因通济何如此，暗室千年忽遇灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":8853,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]