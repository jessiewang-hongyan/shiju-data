[{"title":"春晚","author":"释斯植","text":"满地落花流水，伤心芳草青时。\n江上数声杜宇，更堪一笛横吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"释斯植","text":"小桃自与春风恶，花不随人独下楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无锡刘相干笃信佛法常来参请自和雪窦罂粟颂来呈老僧即次韵酬之云","author":"释普宁","text":"一实包含万点春，收来粒粒是家珍。\n些儿圆转谁能委，唯一身分百亿身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"写华严经求颂","author":"释普宁","text":"破一微尘出此经，因该果海果该因。\n无端却被管城子，名句文俱错指陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"竹溪","author":"释普宁","text":"空服高心耐岁寒，滔滔声价没遮拦。\n自从南北分枝派，搅动江西十八滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"灵照女赞","author":"释普宁","text":"拈将破笊篱，风前卖与谁。\n搀行夺市处，非独老爷知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"画髑髅檐人我檐者求颂","author":"释普宁","text":"自从尘劫至于今，执著无明人我心。\n蓦忽眼睛俱突出，乾坤大地孰知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"亮知客","author":"释普宁","text":"主中宾句验来端，四海禅流总被瞒。\n铁磨机轮难比拟，逢人即出舌翻澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南洲","author":"释普宁","text":"赡部那边沙际间，鬨然魔子恣纵横。\n周金刚带不平气，勘破却从潭上行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"铁牛","author":"释普宁","text":"骨格纯刚蹄角全，轩然鼻孔自辽天。\n不贪陕府栏边草，肯遍耕翻祖父田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其二十一","author":"释普宁","text":"往复落人绻缋间，那知同步不同行。\n当初乍可无容质，别作心肠过一生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十","author":"释普宁","text":"七佛引其前，维摩接其后。\n一盲引众盲，至今不唧?。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈二首 其二","author":"释大通","text":"吾本来兹土，传法救迷情。\n一华开五叶，结果自然成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三十","author":"释普宁","text":"为国为民运此心，果符虔祷获丰荣。\n时清道泰封疆阔，合国欢呼贺太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十六","author":"释普宁","text":"出得油缸入酱缸，通身是口若为谈。\n老拳尚有些筋力，拚命来机为指南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三","author":"释普宁","text":"释迦不出世，四十九年说。\n祖师不西来，少林有妙诀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"雪窦前堂音座寮有炼指行人求颂","author":"释普宁","text":"未彻根源肯便休，炼磨三种愈精修。\n发辉自己光明藏，抹过俱胝一指头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"最明寺殿悟道后赠之助道颂五首 其五","author":"释普宁","text":"壬戌十月十六朝，虚空拳踢不相饶。\n等闲打破疑团后，大地黄金也合消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"最明寺殿悟道后赠之助道颂五首 其四","author":"释普宁","text":"治国治民俱外事，存心存念自工夫。\n心思路绝略观看，佛也无兮法也无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"最明寺殿悟道后赠之助道颂五首 其三","author":"释普宁","text":"二十一年曾苦辛，寻经讨论枉精神。\n蓦然摸著娘生鼻，翻笑胡僧弄吻唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"最明寺殿悟道后赠之助道颂五首 其二","author":"释普宁","text":"悟了还同未悟时，著衣吃饭顺时宜。\n起居动静曾无别，始信拈花第二机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"最明寺殿悟道后赠之助道颂五首 其一","author":"释普宁","text":"老僧初到与三拳，埋恨胸中结此冤。\n痛恨忽消开正眼，方知吾不妄宣传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三十七","author":"释普宁","text":"圆同太虚，无欠无馀。\n良由取舍，所以不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小师景用请赞","author":"释普宁","text":"要赞而无德可赞，要骂而无过可骂。\n赞与骂不及处，大地而不能载。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"无准和尚顶相赞","author":"释普宁","text":"文武火煨杀人，千衲子恨难伸。\n五处主法，双径两新。\n内庭敷演，赐号超伦。\n自创正续梵苑，延纳云水高宾。\n将谓多少奇特，依前满面埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出山相赞","author":"释普宁","text":"入山出山，何异何别。\n六年所成，一时漏泄。\n那堪满口嚼冰雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"布袋赞","author":"释普宁","text":"杖头挑百亿乾坤，布袋贮三千世界。\n闹市丛中等个人，不知谁是知音者。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正传寺住持安东岩请赞","author":"释普宁","text":"生缘于西蜀，非独游日本。\n十方国土中，当头俱坐断。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"正因法孙命工绘吾幻质炷礼请赞","author":"释普宁","text":"个样面嘴，阿谁敢拟。\n威凛凛生，气愤愤地。\n临济德山，望风敬畏。\n和苏噜之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行道持数珠观音赞","author":"释普宁","text":"从闻思修，入三摩地。\n八万行门，一十九类。\n寻声救苦越尘沙，一串数珠数不已。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"鱼妇观音赞","author":"释普宁","text":"提起活鱍鱍，马郎亦被惑。\n度生虽愿重，那知成败缺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"栽松道者","author":"释普宁","text":"栽培得地，节操苍然。\n死而复活，身后身前。\n楖?横肩阿剌剌，再来不直半分钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"海月","author":"释普宁","text":"金波涌出烂银盆，黑白亏盈湛不痕。\n莫谓清波无透路，珊瑚枝上影团团。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"铁壁","author":"释普宁","text":"刚然隔断太虚空，缝罅浑无拶不通。\n顽钝碓夫觑不破，倩人书处转乖宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其二十","author":"释普宁","text":"诸方此日，安居禁足。\n双林难说，禁足安居。\n厨乏聚蝇之糁，廪无隔宿之储。\n策杖遍叩檀度，免我一众饥虚。\n休以蜡人为验，但愿处处逢渠。\n早知今日事，悔不慎当初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十九","author":"释普宁","text":"去年十月十七，被命来尸败席。\n陈逋弊积如山，中外仓库赤立。\n勉效佛在世时，持钵沿门求乞。\n不惮涉险登危，波波为众竭力。\n逗到四月十五，恰满六个月日。\n诸方禁足安居，双林岂容禁足。\n领众展转求贤，然后求己的实。\n心空及第归来，和这自己抛掷。\n更有一事告报，古圣言端语的。\n宁可热铁缠身，不受信心人衣。\n宁可镕铜灌口，不受信心人食。\n吃饭忽咬著砂，一生参学事毕。\n若不量彼来处，水也难消一滴。\n且誵讹在什么处，直待当来问弥勒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十八","author":"释普宁","text":"这个老汉，软顽希罕。\n煨而不熟，煮而不烂。\n没兴遭他负累，被陷云黄苦难。\n怨之不已，恨之不休，且将这个雪冤雠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十七","author":"释普宁","text":"有处不是有，无处不是无。\n有无不到处，馨香满道途。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十六","author":"释普宁","text":"云门一曲，调高千古。\n子细推穷，从来无谱。\n此曲只应天上有，大士得来无本据。\n今日当阳分付，新年诸路化主。\n在处富有知音，遇著知音举似。\n举似则不无，且道是何曲调，腊月二十五。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十五","author":"释普宁","text":"一阳来复，暖回幽谷。\n云黄山上，喜气浮空。\n绣水溪头，疏影含玉。\n老胡不会转身句，无节目中生节目。\n累及拄杖子，皮肤脱落尽，通身乌律漆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十四","author":"释普宁","text":"破砂盆，漏灯盏。\n死偷心，灭正眼。\n近之则愈远，亲之则愈疏。\n瞻之在前，忽然在后。\n全明全暗，双放双收。\n番复看来，当甚热大。\n是则也是，只如进前叉手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十三","author":"释普宁","text":"久向双林，可曾游历。\n及乎到来，果是殊别。\n山环水绕，寺广人稀。\n内空外空，无彼无此。\n彷佛威音那畔，分明古佛家风。\n不妨按下云头，钵囊暂且高挂。\n坐则同坐，行则同行。\n同苦同甘，同忧同乐。\n必竟事作么生，但看人情若好，自然吃水也肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其十二","author":"释普宁","text":"拄杖头边，草鞋跟底。\n随缘放旷，隐遁过时。\n岂谓业债难逃，复落他家绻缋，扶病拖泥带水。\n只得竖四横三，乘时拽取。\n正续山与云黄山斗额，为复是神通游戏。\n为复是法尔如然。\n不见道，浙东山，浙西水，四海五湖皇化里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其九","author":"释普宁","text":"如何是佛殿里底，无端开口便臭气。\n掩鼻不及，只得五体投地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其八","author":"释普宁","text":"衲僧门下，活路通天。\n脚头脚底，能方能圆。\n照顾踏破常住砖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其七","author":"释普宁","text":"无心游此国，有心复宋国。\n有心无心中，通天路头活。\n拄杖头边挑日月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其六","author":"释普宁","text":"夜夜明星现，时时两眼开。\n如何腊月八，特地叹奇哉。\n引得随邪逐恶者，至今一味狗来腮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其五","author":"释普宁","text":"东望大乘器，区区十万里。\n因这一著错，累及人断臂。\n彼错犹且可，此错无巴鼻。\n彼错此错诉之谁，倒拈铁笛逆风吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其四","author":"释普宁","text":"青州布衫重七斤，由来错认定盘星。\n那知富士山孤峻，到顶须行三日程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其三","author":"释普宁","text":"出水未出水，心疑生暗鬼。\n巩县造茶瓶，一只三个嘴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其二","author":"释普宁","text":"有处不是有，无处不是无。\n有无不到处，馨香满道涂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂二十一首 其一","author":"释普宁","text":"檀那梦见大栋梁，高僧罗汉满云堂。\n慷慨重新铺盖就，比之兜率更尤强。\n衲子办道耐长久，成佛作祖法中王。\n下等愚迷无正念，镕铜灌口卧铁床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18765,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其四十一","author":"释普宁","text":"每年三月十八，忆著痛恨入骨。\n巨福山上望凌霄，万重山海烟波阔。\n谩爇一炷兜罗木，唵，喷喷昂昂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18766,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其四十","author":"释普宁","text":"梦中演说六波罗，觉时同别苦问他。\n今日最明重演说，更无一字有誵讹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18767,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三十九","author":"释普宁","text":"腊月八夜眼见鬼，便开大口说道理。\n若向衲僧门下过，烂槌一顿无疑矣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18768,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三十八","author":"释普宁","text":"冬至寒食一百五，中有一转平实语。\n缺齿老胡举不全，赚他立雪人莽卤。\n猫儿偏解捉老鼠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18769,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三十六","author":"释普宁","text":"近得远来口传信，报道年来颇安静。\n唯有太白瑞岩翁，撞破虚空有杂碎。\n惊起西川大蓬山上石女泪双垂，引得扶桑巨福山中木人空叹息。\n同饮龙渊无义水，手足义重如胶漆。\n断弦安得鸾胶续。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18770,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三十五","author":"释普宁","text":"人从天台来，却得西川信。\n报道万年松，生在石桥顶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18771,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三十三","author":"释普宁","text":"同饮龙渊，同依师席。\n切瑳琢磨，相滋相益。\n分袂东西，各提祖令。\n越漠来投，心胆倾尽。\n执别恰恰一周，千里俯垂辉映。\n举众再奉慈光，无异拨云见日。\n若是向上向下，总将靠之一壁。\n忆得凌霄蛊毒之家，水也不曾沾他一滴。\n阿呵呵，会也么。\n青山不锁长飞势，沧海合知来处高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18772,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三十二","author":"释普宁","text":"南山白额虫，撞倒太白峰。\n直得西湖彻底枯竭，东海怒浪翻空。\n安汉圭峰拊掌，天台尊者槌胸。\n郎忙日本国里打鼓，大唐国里撞钟。\n兄弟添十字，此意孰能穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18773,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其三十一","author":"释普宁","text":"一尘入正定，诸尘三昧起。\n诸尘入正定，一尘三昧起。\n三昧与正受，土块泥里洗。\n咦，白日堂堂眼见鬼。\n非不非，是不是。\n甲子乙丑海中金，丙午丁未天河水。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18774,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十九","author":"释普宁","text":"解开布袋头，纵横得自由。\n其住也无拘无束，其去也南州北州。\n放牧沩山水牯牛，不风流处也风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18775,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十八","author":"释普宁","text":"昨日晴，今日雨。\n春夏交承，时节顺序。\n一似林下衲僧，不越规矩。\n三月安居，克期而取。\n西天以蜡人冰，云峰以铁弹子。\n建长亦有一条活路，饥则餐，渴则饮，闲则坐，困则眠，以此为据。\n诸人但任么参，决不赚忤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18776,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十七","author":"释普宁","text":"右胁才生，便放拍盲。\n指天指地，独步纵横。\n云门要打杀，建长助掘坑。\n恶种从教不复萌，虽然也是贼过后张弓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18777,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十五","author":"释普宁","text":"梁渚溪边下直钩，波翻浪辊费牵抽。\n六年用尽腕头力，收卷丝纶恁性游。\n不著此岸，不著彼岸，不滞中流，欸乃一声天地秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18778,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十四","author":"释普宁","text":"金乌急，玉兔速，百岁光阴一瞬息。\n惟有拄杖子，硬葛狚，黑粼皴，勿变迁，无面目。\n三月护生，九旬禁足。\n酌然使得十二时，不被十二时催促。\n任他门外红尘扰扰，来往憧憧，肥马碌碌，瘦马碌碌。\n蓦然翻变化为龙，为雨为霖俱莫测。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18779,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十三","author":"释普宁","text":"弟应兄呼，自扬家丑。\n倒却刹竿，全机漏逗。\n虽有西湖月如昼，何似南禅铁苕帚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18780,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十二","author":"释普宁","text":"东涧水，清且泚。\n源远流长，波腾鼎沸。\n从这里入，不知其几。\n是则是，只如国一禅师经过梁溪，蓦将泗州大圣鼻孔一捏，直得无处出气。\n为复压良为贱，为复神通游戏。\n君子可入。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18781,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十一","author":"释普宁","text":"心随万境转，转处实能幽。\n随流认得性，无喜亦无忧。\n山僧官差不自由，只得随流入流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18782,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂四十一首 其二十","author":"释普宁","text":"折脚铛，破木杓。\n无柄霸，难摸索。\n横拈倒用，破二作三。\n正按傍提，七穿八穴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":18783,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]