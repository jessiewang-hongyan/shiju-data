tion":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁望祭岳镇海渎十七首 其九 中望迎神用《凝安》。","author":"郊庙朝会歌辞","text":"维土作德，维帝御行。\n含养载育，万物以成。\n有严祀典，荐我德馨。\n神其歆止，永用亿宁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁望祭岳镇海渎十七首 其八 送神用《凝安》。","author":"郊庙朝会歌辞","text":"鼓钟云云，吹管伊伊。\n神既醉饱，曰送言归。\n山有厚藏，水有灵德。\n物其永依，往奠炎宅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁望祭岳镇海渎十七首 其七 酌献用《成安》。","author":"郊庙朝会歌辞","text":"景风应律，朱鸟开辰。\n肃肃明祀，嘉笾列陈。\n牲用牷物，乐奏蕤宾。\n克绥永福，祐此下民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁望祭岳镇海渎十七首 其六 南望迎神用《凝安》。","author":"郊庙朝会歌辞","text":"嵩嵇衡霍，暨厥海江。\n时维长养，惠我南邦。\n肆严牲币，神式来降。\n以侑以妥，百福是庞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁望祭岳镇海渎十七首 其五 送神用《凝安》。","author":"郊庙朝会歌辞","text":"神之至止，熙坛为春。\n神之将归，旂服振振。\n欻兮回飙，窅兮旋云。\n祐于东方，永施厥仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2742,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁望祭岳镇海渎十七首 其四 酌献用《成安》。","author":"郊庙朝会歌辞","text":"肇兹东土，含润无疆。\n维时发春，嘉荐令芳。\n祭用薶沈，顺性含藏。\n不涸不童，诞降祺祥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2743,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁望祭岳镇海渎十七首 其三 奠玉币用《明安》。","author":"郊庙朝会歌辞","text":"祀以崇德，币则有仪。\n肃我将事，登降孔时。\n精明纯洁，罔有弗祗。\n史辞无愧，神用来娭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2744,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁望祭岳镇海渎十七首 其二 升降用《同安》。","author":"郊庙朝会歌辞","text":"绅韠襜兮，玉佩橤兮。\n于我将事，神燕喜兮。\n帝命望祀，敢有不共。\n往返于位，肃肃雍雍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2745,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁望祭岳镇海渎十七首 其一 东望迎神用《凝安》。","author":"郊庙朝会歌辞","text":"盛德惟木，勾芒御神。\n沂岱淮海，厥功在民。\n爰熙坛坎，裒对庶神。\n于以歆格，灵贻具臻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2746,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁祭风师五首 其五 送神用《欣安》。","author":"郊庙朝会歌辞","text":"奠献纷纷，灵心欣欣。\n超然而返，众御如云。\n其施伊何，多黍多稌。\n其祥伊何，不愆厥叙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2747,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁祭风师五首 其四 亚、终献，酌献用《雍安》。","author":"郊庙朝会歌辞","text":"栗栗坛坫，载是豆觞。\n醇烈氤氲，普荐芬芳。\n酌之维宜，献之维时。\n民有报侑，灵用安之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2748,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁祭风师五首 其三 奠币用《容安》。","author":"郊庙朝会歌辞","text":"育我嘉生，神惠是仰。\n载致斯币，庶几用享。\n鼓之舞之，式繄尔神。\n锡福无疆，佑此下民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2749,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁祭风师五首 其二 升降用《钦安》。","author":"郊庙朝会歌辞","text":"盥帨于下，有盘有匜。\n馈酌于上，有登有彝。\n服容柔止，进退优止。\n即事寅恭，神其休止。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2750,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁祭风师五首 其一 迎神用《欣安》。","author":"郊庙朝会歌辞","text":"飘飖而来，淅沥而下。\n爰张其旂，爰整其驾。\n有豆有登，有兆有坛。\n弭旌柅辀，降止且安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2751,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁蜡祭十三首 其十三 送神用《成安》。","author":"郊庙朝会歌辞","text":"嘉荐芳美，灵来宴娭。\n斿车结云，若风马驰。\n既至而喜，锡我蕃禧。\n嘉承天贶，曼寿无期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2752,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁蜡祭十三首 其十二 亚、终献用《曼安》。","author":"郊庙朝会歌辞","text":"林林生民，含哺而嬉。\n教之稼穑，实神之为。\n图报厚德，万祀无期。\n以假以享，锡我繁禧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2753,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁蜡祭十三首 其十一 酌献用《禔安》。","author":"郊庙朝会歌辞","text":"英英礼文，既备而全。\n严严四郊，屹屹紫坛。\n百末旨酒，其敷若兰。\n何以畀民，既寿而安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2754,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁蜡祭十三首 其十 奠币用《吉安》。","author":"郊庙朝会歌辞","text":"于穆明祀，莫如报功。\n灵之利泽，惠我无穷。\n斋以涤志，币以达衷。\n抚宁四极，永锡登丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2755,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁蜡祭十三首 其九 升降用《穆安》。","author":"郊庙朝会歌辞","text":"皇皇灵德，经纬万方。\n承诏摄事，陟降以庄。\n高冠岌峨，长佩锵洋。\n嘉承神贶，令闻不忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2756,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁蜡祭十三首 其八 南北方迎神用《简安》。","author":"郊庙朝会歌辞","text":"美若休德，民和岁丰。\n稼穑云施，其积如墉。\n惠我四国，先啬之功。\n祭之百种，来享来宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2757,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁蜡祭十三首 其七 送神用《宣安》。","author":"郊庙朝会歌辞","text":"灵之来下，扩景乘光。\n灵之回御，景龙以骧。\n鉴我休德，降嘏产祥。\n大田多稼，以惠无疆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2758,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁蜡祭十三首 其六 亚、终献用《庆安》。","author":"郊庙朝会歌辞","text":"礼文备矣，肃肃无哗。\n金石谐节，圭璧光华。\n粢以告丰，醴以告嘉。\n锡兹福祉，以泽幽遐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2759,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁蜡祭十三首 其四 奉俎用《承安》。","author":"郊庙朝会歌辞","text":"礼崇明祀，必先成民。\n奉牲以告，备腯其均。\n炮炙芬芬，俎豆莘莘。\n锡之纯嘏，以佑斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2760,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁蜡祭十三首 其三 奠币用《钦安》。","author":"郊庙朝会歌辞","text":"穰穰丰年，繄侯休德。\n帅承天和，钦象古则。\n嘉玉量币，奠容翼翼。\n灵施暨民，罔有终极。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2761,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁蜡祭十三首 其二 升降用《肃安》。","author":"郊庙朝会歌辞","text":"惟蜡有祭，报神之功。\n合聚万物，来享来宗。\n承诏摄事，不忘肃雍。\n灵之格思，福禄来崇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2762,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"熙宁蜡祭十三首 其一 东西郊降神用《高安》。","author":"郊庙朝会歌辞","text":"天锡康年，四方顺成。\n乃通蜡祭，索享于明。\n金石四作，羽旄翠旌。\n神来宴娭，泽被群生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2763,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"佚名","text":"社近记穿黄茧子，雨前趱摘紫枪旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2764,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题谯楼","author":"吹角老兵","text":"画角吹来岁月深，谯楼无古亦无今。\n不如归我龙山去，松柏青青何处寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2765,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"箴仲殊","author":"孚禅师","text":"大道久凌迟，正风还陊隳。\n无人整颓纲，目乱空伤悲。\n卓有出世士，蔚为人天师。\n文章通造化，动与王公知。\n囊括十洲香，名翼四海驰。\n肆意放山水，洒脱无羁縻。\n云轻三事衲，瓶锡天下之。\n诗曲相间作，百纸顷刻为。\n藻思洪泉泻，翰墨清且奇。\n惜哉大手笔，胡为幽柔词。\n愿师持此才，奋起革浇漓。\n骛彼东山嵩，图祖进丰碑。\n再续辅教编，高步凌丹墀。\n它日僧史上，万世为蓍龟。\n迦叶闻琴舞，终被习气随。\n伊予浮薄人，赠言增忸怩。\n倘能循我言，佛日重光离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2766,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题壁","author":"庐陵田父","text":"云兮云兮，变化有神灵兮。\n捲起地下黄，飞去天上青兮。\n仙人乘云天尺五，借我清阴覆赤土。\n云间逍遥人间苦，年年苦时望君雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2767,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"忘怀老人","text":"寸地不可弃，东风何处无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2768,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"郡宴合生","author":"抚州乐妓","text":"同是天边侍从臣，江头相遇转情亲。\n瑩如临汝无瑕玉，暖作庐陵有脚春。\n五马今朝成十马，两人前日压千人。\n便看飞诏催归去，共坐中书秉化钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2769,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳 嘲梅娇","author":"杏俏","text":"景傍清明，日和风暖，数枝浓淡胭脂。\n春来早起，惟我独芳菲。\n门外几番雨过，似佳人、细腻香肌。\n堪赏处，玉楼人醉，斜插满头归。\n梅花何太早，消疏骨肉，叶密花稀。\n不逢媚景，开后甚孤栖。\n恐怕百花笑你，甘心受、雪压霜欺。\n争如我，年年得意，占断踏青时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2770,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蒸豚","author":"村寺僧","text":"觜长毛短浅含臕，久向山中食药苗。\n蒸处已将蕉叶裹，熟时兼用杏浆浇。\n红鲜雅称金盘饤，软熟真堪玉箸挑。\n若把膻根来比并，膻根只合吃藤条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2771,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿运使 其一","author":"芹庵","text":"炎蒸忽逐火云敛，爽气俄随玉露瀼。\n不是真贤生间世，争教烦暑变清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2772,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿运使 其二","author":"芹庵","text":"玉节煌煌拥使星，泉流地上富全闽。\n光华勋业知何自，咸咏崧高降甫申。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2773,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿运使 其七","author":"芹庵","text":"鹏程九万翼方展，桃实三千花正开。\n再拜愿伸难老颂，仙风定合继蓬莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2774,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿运使 其三","author":"芹庵","text":"总计宁专借远方，高勋盟府要深藏。\n明年今日归清禁，天语传宣劝寿觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2775,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿运使 其四","author":"芹庵","text":"白叟黄童喜色开，诞辰喜遇福星来。\n满城牵挽问衙探，祝寿明晨荐几杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2776,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿运使 其八","author":"芹庵","text":"父老偏怜最小官，晚来争借寿诗看。\n般门尽说难挥斧，句法丁宁子细安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2777,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿运使 其六","author":"芹庵","text":"庞眉相对讲英猷，尽说当年气食牛。\n六十重新开甲子，八千从此富春秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2778,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿运使 其五","author":"芹庵","text":"发籴转沟蒙厚德，葬枯横野荷深恩。\n当知仁者从来寿，鹤算龟龄不足论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2779,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"轩氏","text":"栗棘蓬，栗棘蓬，一口吞却更无踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2780,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"邺雍","text":"大易谈馀庆，胡君世聚居。\n家声先孝弟，庭训守诗书。\n百堵环堂宇，千箱助岁储。\n荣逢平治日，天监表门闾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2781,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南 娑婆苦六首 其一","author":"净圆","text":"娑婆苦，长劫受轮回。\n不断苦因离火宅，祗随业报入胞胎。\n辜负这灵台。\n朝又暮，寒暑急相催。\n一个幻身能几日，百端机巧衮尘埃。\n何得出头来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2782,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望江南/忆江南 西方好六首 其七","author":"净圆","text":"西方好，随念即超群。\n一点灵光随落日，万端尘事付浮云。\n人世自纷纷。\n凝望处，决定去栖神。\n金地经行光里步，玉楼宴坐定中身。\n方好任天真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2783,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苏幕遮","author":"净端","text":"遇荒年，每常见。\n就中今年，洪水皆淹遍。\n父母分离无可恋。\n幸望豪民，救取庄家汉。\n最堪伤，何忍见。\n古寺禅林，翻作悲田院。\n日夜烧香频□□，祷告皇天，救护开方便。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2784,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其二","author":"净端","text":"浪静西溪澄似练。\n片帆高挂乘风便。\n始向波心通一线。\n群鱼见。\n当头谁敢先吞咽。\n闪烁锦鳞如闪电。\n灵光今古应无变。\n爱是憎非都已遣。\n回头转。\n一轮明月升苍弁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2785,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其四","author":"净端","text":"一只孤舟巡海岸。\n盘陀石上垂钩线。\n钓得锦鳞鲜又健。\n堪爱羡。\n龙王见了将珠换。\n钓罢归来莲苑看。\n满堂尽是真罗汉。\n便爇名香三五片。\n梵□献。\n原来佛不夺众生愿。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2786,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其一","author":"净端","text":"斗转星移天渐晓。\n蓦然听得鹈鹕叫。\n山寺钟声人浩浩。\n木鱼噪。\n渡船过岸行官道。\n轻舟再奈长江讨。\n重添香饵为钩钓。\n钓得锦鳞船里跳。\n呵呵笑。\n思量天下渔家好。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2787,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔家傲 其三","author":"净端","text":"七宝池中堪下钓。\n八功德水烟波渺。\n池底金沙齐布了。\n羡鱼鸟。\n周回旋绕为阶道。\n白鹤孔雀鹦鹉噪。\n弥陀接引毫光照。\n不是修行何得到。\n一般好。\n西方净土无烦恼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2788,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺新郎 代寿东屏","author":"咏槐","text":"绿长阶蓂九。\n近黄钟、薰晴爱日，渐添宫绣。\n乾鹊檐头声声喜，催与东屏祝寿。\n怪一点、星明南斗。\n玉燕当年储瑞气，记垂弧、共醉蓬莱酒。\n无杰语，为觞侑。\n英风耿耿拿云手。\n向青春、蟾宫已步，桂香盈袖。\n却要诗书成曲糵，酝酿锦心绣口。\n待匣里、青萍雷吼。\n今日功名乘机会，笑谈间、首入英雄彀。\n看父子，继蓝绶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2789,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寿母","author":"怡轩","text":"又见梅妆碧玉枝，弟兄相聚著莱衣。\n西方佛庆明朝诞，南极星胜寿日晖。\n百岁阿㜷开九秩，两房孙子戏重闱。\n年年得侍高堂醉，对坐天花散漫飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2790,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石宝盖","author":"怡然","text":"圆顶环珠幡，久与石俱化。\n我执黄庭经，跏趺坐其下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2791,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翠蛟亭 其二","author":"怡然","text":"擘石斗雷霆，蛟乎尔□怒。\n会当捲银河，凌空泻甘澍。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":2792,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]