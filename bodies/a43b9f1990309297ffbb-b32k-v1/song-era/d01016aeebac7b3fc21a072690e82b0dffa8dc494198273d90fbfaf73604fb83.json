[{"title":"奉使契丹二十八首 过杨无敌庙","author":"苏辙","text":"行祠寂寞寄关门，野草犹知避血痕。\n一败可怜非战罪，太刚嗟独畏人言。\n驰驱本为中原用，尝享能令异域尊。\n我欲比君周子隐，诛彤聊足慰忠魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉使契丹二十八首 古北口道中呈同事二首 其一","author":"苏辙","text":"独卧绳床已七年，往来殊复少萦缠。\n心游幽阙乌飞处，身在中原山尽边。\n梁市朝回尘满马，蜀江春近水浮天。\n枉将眼界疑心界，不见中宵气浩然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉使契丹二十八首 古北口道中呈同事二首 其二","author":"苏辙","text":"笑语相从正四人，不须嗟叹久离群。\n及春煮菜过边郡，赐火煎茶约细君。\n日暖山蹊冬未雪，寒生胡月夜无云。\n明朝对饮思乡岭，夷汉封疆自此分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉使契丹二十八首 次莫州通判刘泾韵二首 其一","author":"苏辙","text":"北国亦知岐有夷，何尝烽火报惊危。\n拥旃绝漠闻嘉语，缓带临边出好诗。\n约我一樽迎嗣岁，待君三馆已多时。\n从今无事唯须饮，文字声名人自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉使契丹二十八首 次莫州通判刘泾韵二首 其二","author":"苏辙","text":"平世功名路甚夷，不劳谈说更骑危。\n早年拭目看成赋，近日收心闻琢诗。\n古锦屡开新得句，敝貂方竞苦寒时。\n南还欲向春风饮，塞柳凋枯恐未知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉使契丹二十八首 春日寄内","author":"苏辙","text":"春到燕山冰亦消，归骖迎日喜嫖姚。\n久行胡地生华发，初试东风脱敝貂。\n插髻小幡应正尔，点槃生菜为谁挑。\n附书勤扫东园雪，到日青梅未满条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉使契丹二十八首 奚君","author":"苏辙","text":"奚君五亩宅，封户一成田。\n故垒开都邑，遗民杂汉编。\n不知臣仆贱，漫喜杀生权。\n燕俗嗟犹在，婚姻未许连。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉使契丹二十八首 惠州","author":"苏辙","text":"孤城千室闭重闉，苍莽平川绝四邻。\n汉使尘来空极目，沙场雪重欲无春。\n羞归应有李都尉，念旧可怜徐舍人。\n会逐单于渭桥下，欢呼齐拜属车尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉使契丹二十八首 赠右番赵侍郎","author":"苏辙","text":"霜须顾我十年兄，朔漠陪公万里行。\n骈马貂裘寒自暖，连床龟息夜无声。\n同心便可忘苛礼，异类犹应服至诚。\n行役虽劳思虑少，会看梨枣及春生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"奉使契丹二十八首 赠知雄州王崇拯二首 其一","author":"苏辙","text":"赵北燕南古战场，何年千里作方塘。\n烟波坐觉胡尘远，皮币遥知国计长。\n胜处旧闻荷覆水，此行犹及蟹经霜。\n使君约我南来饮，人日河桥柳正黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"官居即事","author":"苏辙","text":"官局纷纭簿领迷，生缘琐细老农齐。\n偷安旋种十年木，肉食还须五母鸡。\n对酒不尝怜酤榷，钓鱼无术漫临溪。\n此身已分长贫贱，执爨缝裳愧老妻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"官舍小池有鸂鶒遗二小雏二首 其一","author":"苏辙","text":"半亩清池藻荇香，一双鸂鶒竞悠扬。\n来从碧涧巢安在，飞过重城母自将。\n野鸟似非官舍物，宰君昔是钓鱼郎。\n直言愧比奇章老，得县无心更激昂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"官舍小池有鸂鶒遗二小雏二首 其二","author":"苏辙","text":"清池定谁至，鸂鶒自来驯。\n知我无伤意，怜渠解托身。\n桥阴栖息稳，岛外往来频。\n勿食游鱼子，从交长细鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宛丘二咏 其二","author":"苏辙","text":"古殿山花丛百围，故园曾见色依依。\n凌寒强比松筠秀，吐艳空惊岁月非。\n冰雪纷纭真性在，根株老大众园希。\n山中草木谁携种，潦倒尘埃不复归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"放榜后次韵毛守见招","author":"苏辙","text":"饱食安眠愧不材，疏帘翠帟幸相陪。\n深居正厌银袍乱，失喜初闻铁锁开。\n佳句径蒙探古锦，小槽仍报滴新醅。\n诸人欲见风流伯，不用招呼亦自来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"欧阳太师挽词三首 其一","author":"苏辙","text":"雄文元命世，直气早成风。\n受任衰迟后，安邦反侧中。\n回天深有力，扈圣耻言功。\n事已身随去，惊嗟柱石空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"欧阳太师挽词三首 其二","author":"苏辙","text":"唐弊文初丧，书成法至今。\n雍容趋圣处，深切可人心。\n气力知难继，风流喜不淫。\n悬知公欲谢，异说勇交侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"欧阳太师挽词三首 其三","author":"苏辙","text":"推毂诚多士，登龙盛一时。\n西门行有恸，东阁见无期。\n念昔先君子，尝蒙国士知。\n旧恩终未报，感叹不胜悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"河上莫归过南湖二绝 其一","author":"苏辙","text":"西来白水满南池，走马池边日落时。\n桥底荷花无限思，清香乞与路人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"河冰复结复次前韵","author":"苏辙","text":"懊恼河冰散复生，徂年近已失峥嵘。\n身留短舫厌厌睡，目送飞鸿一一轻。\n引纤低徊疑上坂，打凌辛苦甚攻城。\n东风怜我归心速，稍变杨梢百里迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"河冰稍解喜呈王适","author":"苏辙","text":"留滞江湖白发生，西归犹苦冻峥嵘。\n春风未到冰先解，河水初深船自轻。\n去国偶然经昼梦，逢人稍欲问都城。\n羁鸿共有成行喜，双鲤应将尺素迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"范丞相尧夫挽词二首 其二","author":"苏辙","text":"南迁头已白，北返病初加。\n君意知无罪，天心许到家。\n同朝曾忝旧，握手一长嗟。\n时事纷无已，还应付棣华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"范丞相尧夫挽词二首 其一","author":"苏辙","text":"持身守忠恕，临事耻浮沉。\n直道更三黜，平生惟一心。\n家风来自远，国论老弥深。\n令德真如玉，泥沙枉见侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试院唱酬十一首 次韵吕君丰城宝气亭","author":"苏辙","text":"紫气飞空不自谋，谁怜黾勉匣中留。\n西山猛兽横行甚，北海长鲸何日收。\n星斗不堪供醉舞，蛟龙会看反重湫。\n功成变化无踪迹，望断中原百尺楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试院唱酬十一首 戏呈试官","author":"苏辙","text":"只隔墙东便是家，悁悁还似在天涯。\n客心不耐听松雨，归信犹堪饮菊花。\n剪烛看书良寂寞，披沙见玉忽喧哗。\n自惭空馆难留客，试问姮娥稍驻车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试院唱酬十一首 戏呈试官吕防","author":"苏辙","text":"新秋风月正凉天，空馆相看学坐禅。\n满榻诗书愁病眼，隔墙砧杵思高眠。\n霜飞一叶凋琼玉，风绕双松奏管弦。\n闻道熊罴归梦数，侵天闱棘漫森然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试院唱酬十一首 次前韵三首 其一","author":"苏辙","text":"老去在家同出家，《楞伽》四卷即生涯。\n粗诗怪我心犹壮，细字怜君眼未花。\n霜落初惊衾簟冷，酒酣犹喜笑言哗。\n归心知有三秋恨，莫学匆匆下坂车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试院唱酬十一首 次前韵三首 其二","author":"苏辙","text":"门前溪水似渔家，流浪江湖归未涯。\n邂逅高人来说法，支离枯木旋开花。\n诸生试罢书如积，剧县归时讼正哗。\n安得骑鲸从李白，试看牛女转云车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试院唱酬十一首 次前韵三首 其三","author":"苏辙","text":"浊醪能使客忘家，屈指归期已有涯。\n鱼化昨宵惊细雨，鹿鸣他日饮寒花。\n已谙江上肴蔬薄，莫笑衙前鼓笛哗。\n太守况兼乡曲旧，会须投辖止行车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试院唱酬十一首 次韵吕君见赠","author":"苏辙","text":"偶然倾盖接清言，不觉门前昼漏传。\n老病低摧方伏枥，壮心坚锐正当年。\n莫嫌客舍一杯酒，试论灊山三祖禅。\n明日程文堆几案，只应衰懒得安眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"试院唱酬十一首 次韵吕君兴善寺静轩","author":"苏辙","text":"自恨寻山计苦迟，年过四十始知非。\n小轩迎客如招隐，野鸟窥人自识机。\n窗外竹深孤鹤下，阶前菊秀晚蜂飞。\n老僧战胜长幽寂，瘦骨缘何未肯肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"金沙台","author":"苏辙","text":"待罪东轩仅两秋，搉酤事了且夷犹。\n奖崇善类询舆论，过访仁贤棹小舟。\n契合通家心异姓，情敦同气迈凡流。\n金沙台上聊舒乐，即景题诗閤酒瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨中宿酒务","author":"苏辙","text":"微官终日守糟缸，风雨凄凉夜渡江。\n早岁谬知儒术贵，安眠近喜壮心降。\n夜深唧唧醅鸣瓮，睡起萧萧叶打窗。\n阮籍作官都为酒，不须分别恨南邦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雨过","author":"苏辙","text":"东南流注已鸣涧，西北霏微仅敛尘。\n人意共怀艰食病，天公那有不仁人。\n云移已分贫无福，雩应方知社有神。\n田里相望无一舍，终年苦乐会须匀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"驾幸亲贤宅赠随驾诸公","author":"苏辙","text":"日日南风夜气烦，一声鸣䟆万人看。\n禁沟飞水清黄道，凉殿分冰遍从官。\n急雨未成昏观阙，微飙稍觉泛和銮。\n相看挥汗尘埃里，散发何人旧不冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"临江萧氏家宝堂","author":"苏辙","text":"高人不解作生涯，唯有中堂书五车。\n竹简多于孔氏壁，牙签新似邺侯家。\n田园岂是子孙计，青紫今为里巷誇。\n富贵早知皆有命，君应未厌十年赊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南斋独坐","author":"苏辙","text":"独坐南斋久，忘家似出家。\n香烟秾作穗，茶面结成花。\n细竹才通径，长松初有槎。\n往还真断绝，一一数归鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南堂新游花坛二首 其二","author":"苏辙","text":"老木不忍伐，横枝宜少除。\n根茎渐有托，雨露稍分馀。\n生意初无损，开花终自如。\n他年诸草木，成就此幽居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南堂新游花坛二首 其一","author":"苏辙","text":"乱竹侵红药，病花羞晚春。\n移根近谈笑，得土长精神。\n荣悴非由尔，芬芳止为人。\n庭西井泉好，汲灌每躬亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城中牡丹推高皇庙园迟适联骑往观归报未开戏作","author":"苏辙","text":"汉庙名园甲颍昌，洛川珍品重姚黄。\n雨馀往看初疑晚，春尽方开自不忙。\n争占一时人意速，养成千叶化功长。\n老人终岁关门坐，花落花开已两忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"城南访张恕","author":"苏辙","text":"事似棼丝拨不开，秋随脱叶暗相催。\n城南绿野宜幽步，水北红尘漫作堆。\n赤枣青瓜报丰熟，黄鸡白酒劝徘徊。\n此中真有醇风在，一亩何年斸草莱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复次烟字韵答黄大临庭坚见寄二首 其一","author":"苏辙","text":"水竹遮藏自一川，日高茅屋始炊烟。\n犬牙舂米新秋后，麦粒烝茶欲社天。\n冠盖只今成弃物，杉松他日记栽年。\n定应笑我劳生在，卯睡闻呼衣为颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复次烟字韵答黄大临庭坚见寄二首 其二","author":"苏辙","text":"十载劳思寤寐间，新诗态度比云烟。\n清风吹我无千里，明月随人共一天。\n归去林泉应避暑，北征道路恐经年。\n与君共愧知时鹤，养子先依黑柏颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"复次韵","author":"苏辙","text":"滕王阁在谁携手，徐孺湖宽可放情。\n楚客解书南国恨，秦筝助发上林莺。\n系匏独负杯中物，拥鼻知逢洛下生。\n问得长须添梦想，蓬窗灯火达天明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将之绩溪梦中赋泊舟野步","author":"苏辙","text":"扁舟逢野岸，试出步崇冈。\n山转得幽谷，人家馀夕阳。\n被畦多绿茹，堆屋剩黄粱。\n深羡安居乐，谁令志四方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将归二首 其二","author":"苏辙","text":"为客不满岁，还家见两孙。\n遥知临竹户，相对引瓢樽。\n老罢那嫌瘦，心宽尚喜存。\n风波随处有，何幸免惊奔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将归二首 其一","author":"苏辙","text":"久客初何事，言归似有名。\n腾腾且随俗，落落竟无成。\n病苦医犹厌，囊空身自轻。\n家人惊别后，无限白须生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将至南京雨中寄王巩","author":"苏辙","text":"河牵一线流不断，雨散千丝卷却来。\n烟际横桥村十里，船中倦客酒三杯。\n老年转觉脾嫌湿，世路早令心似灰。\n赖有故人怜寂寞，系舟待我久徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将使契丹九日对酒怀子瞻兄并示坐中","author":"苏辙","text":"黄华已向初旬见，白酒相携九日尝。\n萸少一枝心自觉，舂同斗粟味终长。\n兰生庭下香时起，玉在人前坐亦凉。\n千里使胡须百日，暂将中子治书囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将拆旧屋权住西廊","author":"苏辙","text":"平生未有三间屋，今岁初成百步廊。\n欲趁闲年就新宅，不辞暑月卧斜阳。\n修篁已谢前人种，甘井何妨众口尝。\n奔走从来成底事，安居到处漫为乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将移绩溪令","author":"苏辙","text":"坐看酒垆今五年，恩移岩邑稍西还。\n他年贫富随天与，何日身心听我閒。\n山栗似拳应自饱，蜂糖如土不须悭。\n仲卿意向桐乡好，身后烝尝亦此间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故成都尹陆介夫挽词","author":"苏辙","text":"拥节西南未一年，凄凉道路泣东辕。\n蜀都富乐真当惜，民事艰难谁复论。\n白马何人趋远日，青刍盈束更无言。\n异时归去逢遗老，空听咨嗟述旧恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故枢密签书赠正议大夫王彦霖挽词二首 其二","author":"苏辙","text":"倾盖晚相亲，东西省户邻。\n听君占谏草，继我出词纶。\n京尹声初浃，枢廷迹尚新。\n邯郸炊未熟，荣谢隔逡巡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"故枢密签书赠正议大夫王彦霖挽词二首 其一","author":"苏辙","text":"试吏有能名，升台擅直声。\n雄飞极九载，修路止三城。\n壮志方凌厉，遗书忽叹惊。\n老人殊可念，白首泣新茔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春日耕者","author":"苏辙","text":"阳气先从土脉知，老农夜起饲牛饥。\n雨深一尺春耕利，日出三竿晓饷迟。\n妇子同来相妩媚，乌鸢飞下巧追随。\n纷纭政令曾何补，要取终年风雨时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春尽","author":"苏辙","text":"春风过尽百花空，燕坐笙箫起灭中。\n树影连天开翠幕，鸟声入耳当歌童。\n楞严十卷几回读，法酒三升是客同。\n试问邻僧行乞在，何人闲暇似衰翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春阴","author":"苏辙","text":"春后谁令百日阴，雨淫风横两相侵。\n天公未有惜花意，野老空存念麦心。\n共怪丛筠亦黄落，终怜老桧独萧森。\n过中不克阳安在，夏旱前知未易禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春旱弥月郡人取水邢山二月五日水入城而雨","author":"苏辙","text":"春旱时闻孽火然，邢山龙老不安眠。\n麦生三寸未覆垄，雨过一犁初及泉。\n深愧贫民饥欲死，可怜肉食坐称贤。\n南斋遗老知尤幸，汤饼黄齑又一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春深三首 其三","author":"苏辙","text":"偶有茅檐潩水阴，近依城市浅非深。\n幽居每自比陈寔，古学何人贵杜林。\n邻父时来陪小饮，儿曹颇解续微吟。\n前年仅了春秋传，后有仁人知我心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春深三首 其二","author":"苏辙","text":"小园松竹有清阴，懒病从兹日益深。\n醉客满堂惭北海，野僧同社忆东林。\n逢人问道空长啸，久客思归尚越吟。\n三十年前诵圆觉，年来虽老解安心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"春深三首 其一","author":"苏辙","text":"郊原红绿变青阴，闭户不知春已深。\n稍喜荒畦添野荠，坐看新竹补疏林。\n帘中飞絮萦残梦，窗外啼莺伴独吟。\n欲听楞严终懒出，道人知我祖无心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳子玉郎中挽词二首 其一","author":"苏辙","text":"晚岁抽身尘土中，灊山仍乞古仙宫。\n羞将白发随冯叟，欲就丹砂继葛洪。\n龙虎未能留物化，芭蕉久已悟身空。\n骚人欲作招魂赋，蝉蜕疑非世俗同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":241,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳子玉郎中挽词二首 其二","author":"苏辙","text":"新诗锦绣烂成编，醉墨龙蛇洒未乾。\n共首卜居空旧约，宛丘携手忆馀欢。\n风流可见身如在，乡国全归意所安。\n行到都门送君处，长河清泪两汍澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":242,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"柳湖久无水怅然成咏","author":"苏辙","text":"平湖水尽起黄埃，惟有长堤万万栽。\n病鹤摧颓沙上舞，游人寂寞岸边回。\n秋风草木初摇落，日暮樵苏自往来。\n更试明年春絮起，共看飞雪乱成堆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":243,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]