[{"title":"用前韵赠张正仲朝散二首 其二","author":"曹勋","text":"朅来仰止德之隅，颇欲徜徉遂所摅。\n倚杖未忘千里恨，飞鸿为作一行书。\n喜君燕寝凝香暇，念我哀涂税驾初。\n湖海不除豪举想，尚容访古问槐锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用前韵赠张正仲朝散二首 其一","author":"曹勋","text":"郎官出宰镇方隅，聊试牛刀意未摅。\n不特持平争结友，要知博物有成书。\n不惊雉羽桑阴静，一洗蛮烟霁景初。\n恨识羽山眉宇晚，徒闻嘉惠及耕锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用前韵赠岸老","author":"曹勋","text":"年来学稼似樊迟，惟有农功每不醨。\n事与本心虽自适，病随老境岂相遗。\n我方枕簟和云住，公正风幡撇地时。\n林下相逢笑相领，一枝筇竹水云姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用秦公赠李次仲韵呈次仲三首 其三","author":"曹勋","text":"灵明独耀驻年华，九任玄归有等差。\n帝一澄明藏水火，昆丘凝结粲云霞。\n金精盛处须寻兔，火枣成时要似瓜。\n识得神仙木中子，丹腴愿及小生家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用秦公赠李次仲韵呈次仲三首 其二","author":"曹勋","text":"欲求玄牝蕴清华，莫放朝昏子午差。\n收得五华滋湛露，自应双鹤下青霞。\n颇闻北海终栖火，莫向东陵只种瓜。\n它日黄庭留黍米，遨游海岳未须家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"用秦公赠李次仲韵呈次仲三首 其一","author":"曹勋","text":"命本先须植日华，抽添气液了无差。\n融融玛瑙升神室，曲曲琅玕焕綵霞。\n枢辖工夫储太漠，至人妙理寓甘瓜。\n阳源昭彻参同处，试与三家作一家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"示诸子","author":"曹勋","text":"霜入晴云暖，冰生掠岸沙。\n卑枝闲剪橘，幽径试寻花。\n客路人情薄，乡关去路赊。\n只应托诸子，莫倦问桑麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"休致后效乐天体","author":"曹勋","text":"从来受性岂其天，遇物常随处处缘。\n未病遽为辞职去，欲归亟引挂冠年。\n冒寒须放寻梅步，更窘常留买药钱。\n恩许天台遂幽筑，清风一棹送归船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"会庆圣节","author":"曹勋","text":"帝出乘时叶小春，中兴复古付曾孙。\n奉亲圣德躬仁孝，御极天章廓晏温。\n书轨自应归正统，蛮夷先已侍脩门。\n凌虚志远吞寰宇，亿载端临四海尊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再乞休致未遂得二诗呈之奇乡友 其一","author":"曹勋","text":"晚岁归心岂易收，挂冠已去复淹留。\n东方曼倩多奇节，司马相如故倦游。\n床上诗书供一笑，山中松桂入清愁。\n儿童怪我经春病，此意还能掩得不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再乞休致未遂得二诗呈之奇乡友 其二","author":"曹勋","text":"录录虽能早致身，中年东海与西秦。\n只宜桐柏山中老，不是麒麟阁上人。\n故病未休新病起，黑头应笑白头新。\n天公早赐还山诏，怀抱纷纷倦俗尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再和呈李提举","author":"曹勋","text":"侨寓江城意岂疏，得亲仙李似南舒。\n高门带佩昭寰宇，一代勋庸切太虚。\n相业自应求的子，老成宜复被亲除。\n中兴文物须名世，会见金珂下直庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再答前韵二首 其二","author":"曹勋","text":"客居索寞厌天穷，抚事无能笑语中。\n破睡好茶盈碗白，曝檐晴日半帘烘。\n向来切己连丁祸，政以临民获罔功。\n赖有破除馀习在，后山端欲扣南丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再答前韵二首 其一","author":"曹勋","text":"不裘而暖得横披，绝叫西昆不复诗。\n耸入山容成紫障，暖回玉糁缀繁枝。\n从知公有青云士，聊欲文成黄绢辞。\n但得锦囊风月在，胸中佳处未妨痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"厌厌","author":"许月卿","text":"厌厌夜饮忘更深，客不来辞主有情。\n僮仆触屏成蝶梦，姬姜压笛作蝉声。\n月如有待行行慢，风不生嗔细细清。\n萍散人生何可料，婵娟千里共交盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"多谢","author":"许月卿","text":"多谢东皇着意晴，海棠匀趁笑相迎。\n园林富贵何千万，花柳功勋已十成。\n晓雨有情于芍药，春风无处不流莺。\n扁舟水长一篙许，茶灶笔床聊意行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"当垆","author":"曹勋","text":"胡姬年十五，艳色娇阳春。\n花间开绣户，席上设红茵。\n含羞留醉客，敛袂送行人。\n多谢金吾子，衷情讵易陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏简钱处和","author":"曹勋","text":"闻道维摩棐几前，花随宝女下云天。\n合欢带缓新妆薄，燕子楼深晚色鲜。\n想得琼枝宜夜夜，只应璧月共娟娟。\n何时遂预平生友，与出湘云伴锦筵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次子自越来见省","author":"曹勋","text":"江分吴越寄寒温，赖有飞鸿旦夕闻。\n作别半年常入梦，相望百里叹离群。\n庭萱雪已侵寒绿，梅萼春回耿暮云。\n喜汝暂归俱慰悦，老怀无复更纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵呈南嘉","author":"曹勋","text":"塞北初辞虏，泉南滥总戎。\n请缨怀壮节，横槊愧家风。\n草木年华晚，关河鼓角雄。\n何当一笑粲，要赋马群空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵李汉老参政重阳前游泉州东湖","author":"曹勋","text":"郊亭十里绕风漪，一鉴光涵万象微。\n胜址几年因事废，遗芳今日识公归。\n凤山前直供晨翠，鲸海旁连涨夕晖。\n少并江湖鱼钓乐，绿蓑青笠鳜鱼肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灯下读山谷诗","author":"杨万里","text":"天下无双双井黄，遗编犹作旧时香。\n百年人物今安在，千载功名纸半张。\n使我诗篇如许好，关人身事亦何尝。\n地炉火暖灯花喜，且只移家住醉乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"约桑守公肃同还剡中","author":"曹勋","text":"生理空疏坐久闲，聊随云影下吴山。\n驱驰斗粟应怜我，勉强人情亦厚颜。\n浊酒淳漓元不较，梅花的皪欲同攀。\n行行小艇撑寒碧，剡夜无妨共载还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老拙观诸公及儿辈和篇差以自慰再和前韵","author":"曹勋","text":"浓阴深月作春悭，兹夕栖巢鹊不安。\n淅沥潜回连夜雨，缤纷遽作勒花寒。\n色迷梅径香非远，声抑琴丝润未乾。\n西北高楼临缥缈，海山群玉得重看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"老景逢春每多留赏子美所谓老去愿春迟子忱雅知其况以佳句见贻信笔为答","author":"曹勋","text":"吾俦春味等闲情，识我幽花种绕亭。\n云带竹光天外碧，风回松吹梦中醒。\n樽罍湛绿邀芳景，红翠收香拂夜屏。\n归傍清池留未足，更看涵泳一天星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过小圃","author":"曹勋","text":"小隐州城北，先谋儋石储。\n几椽将弊屋，数策未看书。\n碧色新松径，泉声旧石渠。\n欣然终日过，真是爱吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过郑吏部水阁","author":"曹勋","text":"九夏销烦日正长，沉沉虚阁枕横塘。\n更无尘土侵衣裓，只有荷花度晚香。\n一道清泉供枕漱，千章古木进风凉。\n相从时得游佳处，何必持杯玉色光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"问讯子忱游天台","author":"曹勋","text":"落落贺吏部，萧萧湖海姿。\n好山应自适，短棹得回迟。\n花发庭中槛，香传舍外篱。\n相思梅已谢，无处问归期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"何季崇生日","author":"曹勋","text":"庆阀当年侍从臣，传家今见石麒麟。\n瑶觞初过菖蒲节，碧海聊观荔子春。\n超逸绝尘髯政事，暑天汤饼魏簪绅。\n祝公千百松筠寿，常对团团月色新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"余比出疆以茶遗馆伴乃云茶皆中等此间于高丽界上置茶凡二十八九缗可得一胯皆上品也予力辩所自来谓所遗皆御前绝品他日相与烹试果居其次伤为猾夷所诮因得一诗","author":"曹勋","text":"年来建茗甚纷纭，官焙私园总混真。\n圆璧方圭青箬嫩，绛苞黄角綵题均。\n未论洁白衷肠事，只贡膏油首面新。\n世乏君谟与桑苧，翻令衡鉴入殊邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初冬日怀先垄","author":"曹勋","text":"中原金鼓未全衰，拜扫逢时泪满衣。\n丘垄萧条应蔓草，松楸寂历想斜晖。\n残骸漫向天南住，乡思空随雁北飞。\n海上伤心一卮酒，梦魂先已酹重闱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初到阙下","author":"曹勋","text":"墨敕双驰侍帝傍，何堪窘步入明光。\n退风久作翻风翼，倦客何能久客梁。\n野寺残僧思缓步，断桥流水忆寒香。\n何时裋褐携筇去，数里松声细麦冈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈时宰二首 其二","author":"曹勋","text":"不毛山海尽梯航，德洽重熙圣祚昌。\n万国鼎新周礼乐，千官星拱舜衣裳。\n惠沾圜土恩波阔，德及昆虫化日长。\n天地至和昭感格，比闻甘露降番阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈时宰二首 其一","author":"曹勋","text":"黔黎谁识迓衡功，赤白囊闲寝燧烽。\n史不绝书称上瑞，地无遗利足三农。\n已闻奠玉祠真室，未见泥金款岱宗。\n七十二君梁父禅，何时展采更东封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张右相生日二首 其二","author":"曹勋","text":"气禀无为秀，钟灵付秉钧。\n周南知盛德，江左在斯民。\n衮绣东山望，貂蝉綵服春。\n帝师殊寿祉，汉祚有元臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张右相生日二首 其一","author":"曹勋","text":"玉律歌无射，金风下四蓂。\n三台丞相位，一德将臣星。\n弼亮时师表，文章世典刑。\n百神扶大手，远业庆千龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张叔广索近诗辄为短韵","author":"曹勋","text":"咫尺高斋未一嬉，病身坐苦废巫医。\n但能料理扶衰药，岂复狂吟乱道诗。\n秋热正随残暑炽，新凉如与故人期。\n唯应共此江蟾白，万顷风漪月上时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀归呈同官","author":"曹勋","text":"老去光阴易变迁，佳时常在泪痕边。\n一寒休待绨袍惠，二顷须资负郭田。\n邀客预留醅下酒，凭栏闲数渡头船。\n此身更待烟萝去，放尽天游只醉眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀赵希元","author":"曹勋","text":"久怀宣殿浮山老，句满东南著老成。\n一笑忘言寻小隐，十年去国得双清。\n别来体力兼人健，喜甚诗书满意评。\n天子中兴求谠论，故应启沃慰平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨和王挽章五首 其五","author":"曹勋","text":"乍去潭潭府，方多耿耿心。\n尝忘言激切，共叹老侵寻。\n侧听医方验，何期讣报临。\n缞麻望神坐，云亦惨愁阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨和王挽章五首 其四","author":"曹勋","text":"帝谓关张勇，气吞豺虎群。\n忠诚昭白日，始卒翊明君。\n灭没台躔耀，哀荣凤口坟。\n传家有贤嗣，泪血入江云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨和王挽章五首 其三","author":"曹勋","text":"早岁名虓将，阴功晚益昌。\n职齐张右相，威并郭汾阳。\n水月宸奎炳，风云宝墨香。\n两宫恩赙礼，深见眷忠良。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨和王挽章五首 其二","author":"曹勋","text":"代北生英杰，临戎发策新。\n两淮平僣乱，二纪并洪钧。\n定难诗书将，推忠社稷臣。\n临分双下泪，每忆每沾巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨和王挽章五首 其一","author":"曹勋","text":"奉銮翔霸府，血汉圣心留。\n稍护勾陈卫，旋分慰抚忧。\n威名腾瀚海，姓字竦旄头。\n和国真封贵，元功记冕旒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辛卯题壁","author":"曹勋","text":"中原陷贼百城没，龙驭天旋守一江。\n恢复未逾衣带水，功名惭有碧油幢。\n痛无雁信来沙漠，愁觉梅风到夜窗。\n朔吹搅云心慷慨，拊床未易寸心降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连雨有感","author":"曹勋","text":"连雨霏霏作晓阴，倚栏不复见遥岑。\n已疏日上三竿报，只听风随十日霖。\n枝上绽梅肥自坠，庭中新绿色逾深。\n田苗涨水横斜卧，甚悯为农种植心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65221,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲过小圃督治冬蔬","author":"曹勋","text":"山园乘兴便忘归，习静关情万事非。\n落叶翻江垂露网，小梅藏白倚苔矶。\n等看朔雪连云密，数得栖鸦几阵飞。\n台岳久惭猿鹤怨，水云三合寸心违。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65222,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闲居泉州","author":"曹勋","text":"平世功名不可期，羝羊自恨触藩篱。\n劳生漫弭众人谤，虽死肯辜天下知。\n劝进偶能回漠北，输忠犹忆佐边陲。\n秋风一夜翻庭绿，晓看髭髯半作丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65223,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈太夫人挽章二首 其二","author":"曹勋","text":"有子贤仍贵，成家际盛时。\n清修勤且俭，御下爱而慈。\n忽忽辞荣养，哀哀见孝思。\n几筵将启绋，惨淡晓云悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65224,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"陈太夫人挽章二首 其一","author":"曹勋","text":"淑德兼前懿，年龄甫八旬。\n义方能教子，佛理已诠身。\n卧病才踰月，求医不浃辰。\n人间膺上寿，松路黯凝尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65225,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"到庐阜谒清虚","author":"曹勋","text":"足趼踰千里，仙山岂易逢。\n欲将遮日手，款扣拨云峰。\n奎壁垂无极，星辰拱几重。\n师心微太漠，不碍白云封。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65226,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和人见寄","author":"曹勋","text":"客里相逢乐可涯，坐来三见换年华。\n喜君舞綵庭趋鲤，愧我惊鸿迹在沙。\n白眼故应聊溷俗，青毡当亦谨传家。\n他时伫看趋三接，大对行应罄五车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65227,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和人荔子","author":"曹勋","text":"冥冥细雨不沾梅，喜熟筠笼荔子来。\n满眼骊山当日意，十年闽岭此时杯。\n色香岂谓撩禅悦，甘旨隃知并老莱。\n伏读佳章辄赓唱，敢将瓦砾拟琼瑰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65228,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和人惠诗二首 其二","author":"曹勋","text":"从来五技已成穷，顾我方今五技中。\n治絮不能防暴冷，拥炉聊复借微烘。\n怀乡固与我同志，浮胆悬知酒有功。\n待约杯盘寻一醉，醉来宁复问凶丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65229,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和人惠诗二首 其一","author":"曹勋","text":"忧患心知振古稀，北征读尽少陵诗。\n孰能狡兔谋三穴，且愿鹪鹩寄一枝。\n出陇麦苗忧客念，摇风柳色动春辞。\n与公共作诗魔役，不害闲中故作痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65230,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和人题倚江亭","author":"曹勋","text":"老去求闲计已疏，若寻多事即荆舒。\n孤高简澹为三益，淳白清凉共一虚。\n有意烟云供眼界，无心鸟雀下庭除。\n兹亭未足为依泊，自是山中有旧庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65231,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和子忱惠八月青梅","author":"曹勋","text":"神仙闻水部，妙物与长生。\n鼎饪元滋味，山樊好弟兄。\n佳音当有象，短韵已驰兵。\n试咽甘酸处，行看雪里英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65232,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和双溪","author":"曹勋","text":"常忆双溪老，伽陀日益多。\n津梁今坐断，风月奈君何。\n清梵山藏路，南薰归满柯。\n何时话暌阔，芒屦入云萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65233,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和元介之","author":"曹勋","text":"五年相别改形容，又向潮阳识飓风。\n萧散喜君真有道，驱驰如我久无功。\n一鸣遂堕尘埃里，九死馀生患难中。\n吊影自怜仍自放，钝根不复就磨砻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65234,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王有道二首 其二","author":"曹勋","text":"泉南幕府峻华迁，不涉铨曹已自贤。\n悟物颇闻才半偈，受知顾岂待三篇。\n青连山顶行行去，香度莲腮细细传。\n郊外高情想夷旷，诗成无惜襞云笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65235,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王有道二首 其一","author":"曹勋","text":"客里羁情厌九迁，相逢赖有故人贤。\n见贻劳苦平生句，如诵中和乐职篇。\n江左风流从昔著，日边事业向来传。\n祇应好语盈编简，并待秋风送锦笺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65236,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王应夫见贻二首 其二","author":"曹勋","text":"况味年来薄，书音寄亦稀。\n乱离多病后，人物故园非。\n潮揭当年会，朋侪几旐归。\n悲心那听此，生理念依微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65237,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王应夫见贻二首 其一","author":"曹勋","text":"不见应夫久，永怀清晤同。\n名高湖海内，诗在笑谈中。\n光泛崇兰露，香传碧桂风。\n只应家学著，更看庙堂功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65238,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王应夫见贻六首 其六","author":"曹勋","text":"晓程寒水散城隅，款段徐行得自摅。\n天外好山宜日衬，风前老柳半虫书。\n赓诗已玷清新后，扣户仍烦剥啄初。\n忙似老农无住著，看人仓庾亟持锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65239,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和王应夫见贻六首 其五","author":"曹勋","text":"开缄韵语起廉隅，坐使心胸百想摅。\n公比士元方展骥，我如毛颖不中书。\n烛摇冷晕人方寂，犬吠寒云月上初。\n北首故关山万叠，几时艰棘一诛锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":65240,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]