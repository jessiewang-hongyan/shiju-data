[{"title":"柳","author":"刘子翚","text":"体为常轻定复飘，间梅遮杏得春饶。\n别离处处添愁色，风雨年年换旧条。\n拂瓦半枯陶令宅，沿溪不断灞陵桥。\n凄凉又见千门绿，野老当时恨未销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋宵","author":"刘子翚","text":"秋宵如许永，兀坐思悠哉。\n手误挑灯灭，情长鼓瑟哀。\n清号生窍穴，皓色转崔嵬。\n醉觉雄心在，流光且莫催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋意","author":"刘子翚","text":"又见庭梧一叶飞，物华心事两差池。\n百年未半老相逼，四序平分秋独悲。\n过岸山川云漠漠，残灯院落雨丝丝。\n客怀料理须杯酒，哭向穷途定自痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胡文定公挽诗三首 其三","author":"刘子翚","text":"奕叶论深契，平生仰大儒。\n淹留趋绛帐，寂寞奠生刍。\n忍见摧梁木，悲歌碎玉壶。\n尺书垂奖意，提耳愧朱愚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胡文定公挽诗三首 其二","author":"刘子翚","text":"有意扶名教，躬行语默中。\n楷模陶士器，药石补天聪。\n衡岳邻新卜，伊川道已东。\n传经知有子，接武大明宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"胡文定公挽诗三首 其一","author":"刘子翚","text":"今代儒林伯，声名旧蔼如。\n不为簪绂累，常乐燕閒居。\n悟主承三接，尊王著一书。\n天胡夺杨绾，素业未全摅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荔子","author":"刘子翚","text":"挺秀穷荒叹未遭，昔贤吟赏著风骚。\n纵班卢橘材非偶，不近长安价愈高。\n烟雨万株遥若画，尘埃一骑笑徒劳。\n雕盘此日无遗选，品格妍媸敢自逃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"荔子","author":"刘子翚","text":"炎蒸午枕梦沧浪，落落星苞喜乍尝。\n笔下丹青千品色，钗头风露一枝香。\n鸡冠借谕何轻许，马乳争名固不量。\n直待当时妃子笑，骊山千古事凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送六四叔之茶陵","author":"刘子翚","text":"底用匆匆便据鞍，离觞纵满不能欢。\n潇湘万里客愁远，鶗鴂一声春事阑。\n此去宦游当益显，时来功业自非难。\n似闻幕府资奇画，好借雄风弄羽翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送瓜与胡原仲","author":"刘子翚","text":"呼儿急走送筠篮，敌暑惟应此物堪。\n一握青瑶含秀润，满襟寒雪冱清甘。\n搔园底用修邻怨，剪棘聊应益盗惭。\n它日傥收遗瓣种，离离虎掌遍山南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送炜侍者之湖南","author":"刘子翚","text":"茗碗深浇破别愁，掺裾犹得小迟留。\n不将流落遇知己，故向艰难作远游。\n春动闽山迎两屐，夜凉楚月趁孤舟。\n相逢应说庞翁笑，黑頞黄髯万念休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送原仲之荆南","author":"刘子翚","text":"风急尘埃满汉关，送君行处路漫漫。\n不知争战几时定，常恐别离相见难。\n三径旧游松竹老，五湖新隐水云宽。\n交朋日觉知音少，绿绮从今莫浪弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送彭奭应礼部试","author":"刘子翚","text":"君家诗礼冠南区，文阵堂堂尽壮夫。\n汉杰姓名归大族，周官事业属吾儒。\n争题玉字传金榜，悉奋朱鸾与凤雏。\n月桂香传南北巷，千言长策耀天衢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送惠州史君范智闻","author":"刘子翚","text":"喜听清谈满座倾，不堪行色动双旌。\n长亭把酒分携易，暮角催人太瘦生。\n地远守臣知妙选，时危壮士耻南征。\n罗浮说与潮阳近，盍拟离骚吊二英。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送曾彦思减罢赴阙","author":"刘子翚","text":"马首成南渡，西风木叶疏。\n去程烟雨外，孤馆别离初。\n未试平戎策，空怀逐客书。\n汉皇方问赋，谁复荐相如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻笛","author":"刘子翚","text":"倚楼何处笛，飞响彻云霄。\n曲怨吹难尽，风回听忽遥。\n戍兵临绝漠，闺妇起寒宵。\n一弄梅飞雪，华年鬓亦凋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻韩侯至","author":"刘子翚","text":"今代淮阴将，宣威瘴海东。\n夜营兵气黑，寒碛战声雄。\n有寇常亲讨，无官可赏功。\n屹然沈鸷貌，识汝未侯中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"原仲致中寄梅雪二诗再次前韵 其二","author":"刘子翚","text":"饭了意行忘远近，翛翛老眼入疏梅。\n愁边赏味平生剧，乱后横斜几度开。\n胜韵撩诗频呫嗫，冷香薰梦破咍台。\n莫将花客轻题品，自有渠侬十倍才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"原仲温其彦藻彦符致明集敝庐","author":"刘子翚","text":"清樽劝客且留连，乱后相从亦偶然。\n三径生涯乡社里，一秋心事菊花前。\n向来忧喜皆陈迹，老去光阴逐断弦。\n怀抱故人今有几，只因情话可忘年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭士特二首 其二","author":"刘子翚","text":"世绪风流远，乡评誉望清。\n苦心几传癖，老笔擅诗名。\n已讶祥占鵩，终怜梦泣琼。\n五峰云外碧，一恸见交情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭士特二首 其一","author":"刘子翚","text":"自古才难得，斯人又早亡。\n青蝇频去国，白首叹为郎。\n不睹遗书奏，徒怀挂剑伤。\n楚魂招不得，南斗夜无光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"哭吕倅","author":"刘子翚","text":"瞑目荒山里，携家万里来。\n旅茔犹借地，儿哭不胜哀。\n裂甑妖难测，藏舟事可猜。\n大贤应有后，天道信悠哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宵长","author":"刘子翚","text":"宵长慵早寐，念念客愁新。\n灯影明高屋，蛩声动四邻。\n满怀平日事，双鬓倦游身。\n避地从漂转，西风羽檄频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐大著挽诗二首 其二","author":"刘子翚","text":"方同倾盖乐，遽起绝弦悲。\n道向清朝屈，心惟静者知。\n阻修绵酒奠，谁序锦囊诗。\n宣室空思贾，凄凉又一时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"徐大著挽诗二首 其一","author":"刘子翚","text":"韦经传素业，汉策射巍科。\n史擅三长誉，书雠九写讹。\n甑尘终寂寞，云路久蹉跎。\n迅景崦嵫迫，知君恨独多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠花","author":"刘子翚","text":"幽姿淑态弄春晴，梅借风流柳借轻。\n初种直教围野水，半开长是近清明。\n几经夜雨香犹在，染尽烟脂画不成。\n诗老无心为题拂，至今惆怅似含情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烧","author":"刘子翚","text":"惹草荧荧焰，随风烈烈声。\n欲临横涧断，忽上晚风明。\n踸踔无潜迹，蒙茸有怒生。\n尚馀飞烬煖，培耔及春耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"离居","author":"刘子翚","text":"马嘶何陇暮，有意念离居。\n去路经秋雨，行装一担书。\n穷知身计拙，病觉世缘疏。\n晓枕残归梦，翻然忆旧庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"翁仁山受恩归以诗相访因次其韵","author":"刘子翚","text":"寒阶响叶终日静，剥啄欣闻人叩关。\n一听清言风洒座，几回幽梦月沈山。\n遗珠未许留沧海，老骥终闻在六闲。\n献策明光岂无用，人心久矣厌多艰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致中手谈见知胡漳州而奇仲未有定论","author":"刘子翚","text":"了无胜负著胸中，三百枯棋破老慵。\n云陈春收花脱树，雹声夜碎月衔峰。\n危机每惮张颐虎，窘步休誇独眼龙。\n无复漳州赏新妙，只应公论付吾宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致中招原仲游武夷","author":"刘子翚","text":"病暑冠裳与体忘，一廛幽僻得深藏。\n微风时度涧光活，残日忽无山气凉。\n但想子綦方隐几，终惭南郭谩连墙。\n何时九曲寻幽事，船尾应须著漫郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致中诗戏论诗棋酒辄次原韵","author":"刘子翚","text":"只应心醉六经醇，自是陶陶晋魏人。\n每向幽居横素榻，惟容我辈岸乌巾。\n毫端空有千题巧，枰上原无一著真。\n要得坦然怀抱稳，烦君浇泼乳泓春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致中相拉游武夷有六耳不同谋之语原仲和章意似未平也再次原韵","author":"刘子翚","text":"年衰渐涸玉池津，拟丐明窗一匕尘。\n底用趋风防六耳，须知对影已三人。\n高情政喜追灵运，饱学那容欠大春。\n右挈左提俱有赖，应怜怀抱久倾囷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致中晚集","author":"刘子翚","text":"笑语北潭晚，微寒入绮疏。\n雨声留篆雾，灯影跃潜鱼。\n病间欲疏酒，老便惟读书。\n喜君新隐地，山翠切吾庐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致中惠瓜","author":"刘子翚","text":"瓜畴暑雨乱花飞，美实蠲烦喜及时。\n苏并筠笼香发越，金刀玉手翠离披。\n侯家昔见连阡盛，贾肆徒誇厚貌奇。\n珍重故人分少意，临风宛若对冰姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致明携酒来云际","author":"刘子翚","text":"有客携家酿，敲门访病翁。\n一春寒食过，幽寺晚晴中。\n嫩竹扶檐绿，残花盖地红。\n牢愁赖君破，归意莫匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致明赠茯苓如婴孩状以诗为报","author":"刘子翚","text":"老松寒不死，密壤聚流脂。\n小斸凌苍翠，深藏发怪奇。\n应怜霜鬓客，为寄玉婴儿。\n屑饵消残疢，同寻汗漫期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读士特诗集","author":"刘子翚","text":"谁将家集到书帷，故喜风骚擅一时。\n快读祇愁雌霓误，流传不但落枫奇。\n唱酬滥许联东野，叙引仍欣得牧之。\n生死穷途天不恤，虚名安用日星垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读李忠悯文集","author":"刘子翚","text":"英姿直节想堂堂，不忍偷生向扰攘。\n二帝蒙尘方幸虏，六臣奉玺更朝梁。\n身轻欲抗豺狼怒，名在终同日月光。\n曾与先君共褒录，拊编交感泪浪浪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读韩子苍吕居仁近诗","author":"刘子翚","text":"诗人零落叹才难，二妙风流压建安。\n已见词锋推晋楚，定应臭味等芝兰。\n鸿轩意气惭交吕，凤跃声华敢望韩。\n咫尺烟尘不相见，它时惆怅隔金銮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"途中","author":"刘子翚","text":"小市犹依海，横桥欲跨汀。\n雨馀榕径冷，春晚苧田青。\n薄宦低豪气，浮生惜壮龄。\n急流归亦好，忧患饱曾经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶书","author":"刘子翚","text":"风急胡尘暗九州，岸巾长啸一登楼。\n故园却忆桐孙在，薄宦端为荔子留。\n湖海以南兵尚斗，犬戎不死祸难休。\n似闻推毂皆飞将，盍有清谈谢傅流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿云际偶题","author":"刘子翚","text":"谷雨都无十日间，落红栖草已斑斑。\n晓烟未放屋头树，春涨欲浮天际山。\n翠盖萦风沉远坂，渔舟惊浪落前湾。\n钟声认得林边寺，岁岁篮舆独往还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿回向寺","author":"刘子翚","text":"清秋聊命驾，细雨独行山。\n浅淡烟云里，回还紫翠间。\n病多新觉老，心懒旧能閒。\n宿遍山南寺，何曾兴尽还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄子静","author":"刘子翚","text":"有约来何晚，行吟溯远风。\n老怀清似水，双鬓乱如蓬。\n晤语非无得，疏慵政略同。\n秋来湖上集，只是欠单公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄巨山","author":"刘子翚","text":"分携六换禁城烟，梦也慵飞到日边。\n綵笔尚怀貂可续，冰衔时许雁遥传。\n紫薇院静君宵直，绿苧村深我昼眠。\n会向急流归亦好，双筇同访幔亭仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄行夫兼怀如愚珙","author":"刘子翚","text":"已把重阳菊，吟怀不为秋。\n江湖三俊远，天地一翁愁。\n日近书来少，宵长梦不休。\n吴云犹可望，时上堇峰头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄张子平","author":"刘子翚","text":"老矣张平子，飘零客此州。\n清樽如有伴，白发不知愁。\n雨燕捎帘入，风花拥槛浮。\n梦中家在否，归兴莫悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄秀峰忠老","author":"刘子翚","text":"高钟号月掩岩扉，遥想幽人不梦时。\n曾听微言知见妙，应怜懒我用功迟。\n帻疏种种宁相贷，窗静山山尚可疑。\n傥有一单容过客，眼中须接秀峰奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄致中因温前约","author":"刘子翚","text":"故山归路岂云赊，忆对春风饯物华。\n尚口乃穷怜反舌，以年当废惜残花。\n勤渠载酒传非误，仓卒回舆事偶差。\n今日重来绿槐夏，已拚缬面醉君家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄致明并纪惠雁观梅之旧","author":"刘子翚","text":"稚刘于我最多情，此日诗筒不绝声。\n孤雁相依真得地，早梅一粲又倾城。\n向来兰好知谁许，病后霜林懒独行。\n小几清香慰临别，极知了了万缘轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄蜀二首 其二","author":"刘子翚","text":"有客传归信，愁怀得暂宽。\n儿童占鹊喜，邻里借书看。\n离蜀秋方半，浮湘岁欲阑。\n柴门频洒扫，梦想见征鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄蜀二首 其一","author":"刘子翚","text":"盗隔枝江远，人来蜀道稀。\n乱离非复昔，富贵不如归。\n戎马心何壮，家山愿莫违。\n阿圆从小慧，解叹白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼李奉","author":"刘子翚","text":"选拔由亲卫，时危远出征。\n气骁尝忽敌，身殁始知名。\n故妾辞空帐，残兵隶别营。\n伤心豺虎窟，冒险尔何轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"望楚","author":"刘子翚","text":"客浦舟凝滞，凭高识楚乡。\n有愁关眺览，何地不凄凉。\n草木词人怨，江山霸主亡。\n悠然独搔首，暮霭一星光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梦如愚珙","author":"刘子翚","text":"惊破池塘梦，宵长不再眠。\n寒声摇谷口，侧月到床边。\n一自芝兰远，都无翰墨传。\n老怀安得写，孤咏不成篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梨","author":"刘子翚","text":"尚想飞花照绮疏，离离秋实点烟芜。\n丹腮晓露香犹薄，玉齿寒冰嚼欲无。\n旧有佳名留大谷，谁分灵种下仙都。\n蔗浆不用传金椀，犹得相如病少苏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菊","author":"刘子翚","text":"青丛馥郁早抽芽，金蕊斓斑晚著花。\n秋意祇应宜淡泊，化工可是惜铅华。\n轻烟细雨重阳节，曲槛疏篱五柳家。\n暮醉朝吟供采摘，更怜寒蝶共生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野步","author":"刘子翚","text":"野步忘归远，春心不自休。\n管弦非老伴，风雨定花雠。\n柳暗深深路，溪寒小小楼。\n谢娘歌白纻，此意可忘忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"隆祐太后挽歌辞三首 其三","author":"刘子翚","text":"俭约身为率，忧勤寿岂延。\n钟残长乐夜，日断泰陵烟。\n归驭应奔月，馀勋赖补天。\n伤心南渡日，一棹赣江船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"隆祐太后挽歌辞三首 其二","author":"刘子翚","text":"谥易徽名正，恩加戚属优。\n素心潜道妙，盛化秉坤柔。\n握玺终存汉，为梁实配周。\n愿书班马纪，万古播芳猷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"隆祐太后挽歌辞三首 其一","author":"刘子翚","text":"三朝钦母训，四海被仁风。\n仓卒垂帘政，艰难取日功。\n仙游暌懿范，孝慕惨皇衷。\n寝隧休华饰，灵輀必返嵩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雪","author":"刘子翚","text":"晚天冥漠霰初飞，皓皓山颜复水湄。\n莫遣瑶林生染污，却忧云路隐巇危。\n寒侵夜褐樽前觉，春入晴檐枕上知。\n忆得梁园探花早，十年泪眼看旌旗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28253,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"馆中简张约斋","author":"刘子翚","text":"书生赋分合穷愁，官与休辰不肯休。\n清晓犯寒开省户，谁家见雪似瀛洲。\n烂银宫阙云端见，素柰园林月下游。\n说与南湖张秘阁，速来同直道山头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28254,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹿鸣燕诗送诸进士","author":"刘子翚","text":"讲艺欣闻暂息兵，槐花秋晚诏群英。\n胡尘不隔蟾宫路，镜水初题雁塔名。\n礼盛邦侯开宴豆，道隆乡老萃簪缨。\n更期妙手皆穿的，荐士吴僚亦与荣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28255,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄彦达之衡山有诗留别因次其韵","author":"刘子翚","text":"穷腊冰霜千里客，此行何事更间关。\n永怀契阔徒酸鼻，无力吹嘘祇厚颜。\n铅椠一囊身计拙，烽烟匝地世途艰。\n曳裾端向龙门去，清梦犹应忆故山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28256,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜诛大将","author":"刘子翚","text":"自提乌合众，南北久跳梁。\n避事几危国，专权拟僭王。\n然脐诛未快，擢发罪难详。\n膏血污砧斧，何曾洒战场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":28257,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]