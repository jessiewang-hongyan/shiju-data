[{"title":"清湘驿送王柳州南归二绝 其二","author":"范成大","text":"我已兼程无脚力，君犹追路有襟期。\n从今月下共花下，谁复醉吟先和诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渐水","author":"范成大","text":"黄流日夜向南风，道出封丘处处逢。\n紫盖黄旗在湖海，故应河伯欲朝宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"琉璃河","author":"范成大","text":"烟林葱茜带回塘，桥眼惊人失睡乡。\n健起褰帷揩病眼，琉璃河上看鸳鸯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"续长恨歌七首 其三","author":"范成大","text":"闻道蓬壶重见时，瘦来全不耐风吹。\n无端却作尘间念，已被仙官圣得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"续长恨歌七首 其六","author":"范成大","text":"骊山六十二高楼，突兀华清最上头。\n玉羽川长湘浦暗，三郎无事更神游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"续长恨歌七首 其一","author":"范成大","text":"金杯潋滟晓妆寒，国色天香胜牡丹。\n白凤诏书来已暮，六宫铅粉半春阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"续长恨歌七首 其七","author":"范成大","text":"帝乡云驭若为留，八景三清好在不。\n玉笛不随双鹤去，人间犹得听梁州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"续长恨歌七首 其二","author":"范成大","text":"紫薇金屋闭春阳，石竹山花却自芳。\n莫道故情无觅处，领巾犹有隔生香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"续长恨歌七首 其四","author":"范成大","text":"别后相思梦亦难，东虚云路海漫漫。\n仙凡顿隔银屏影，不似当时取次看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"续长恨歌七首 其五","author":"范成大","text":"人似飞花去不归，兰昌宫殿几斜晖。\n百年只有云容姊，留得当时旧舞衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"绿萼梅","author":"范成大","text":"朝罢东皇放玉鸾，霜罗薄袖绿裙单。\n贪看修竹忘归路，不管人间日暮寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菊楼","author":"范成大","text":"东篱秋色照疏芜，挽结高花不用扶。\n净洗西风尘土面，来看金碧万浮图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"野景","author":"范成大","text":"菰蒲声里荻花乾，鹭立江天水镜宽。\n画不能成诗不到，笔端无处著荒寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中苦寒戏嘲二绝 其一","author":"范成大","text":"冥凌分职大间关，辛苦行冬强作难。\n费尽无边风与雪，劣能供得一番寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中送炭与龚养正","author":"范成大","text":"谁与幽人煖直身，筠笼冲雪送乌薪。\n烦君笑领婆欢喜，探借新年五日春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中闻墙外鬻鱼菜者求售之声甚苦有感三绝 其一","author":"范成大","text":"饭箩驱出敢偷閒，雪胫冰须惯忍寒。\n岂是不能扃户坐，忍寒犹可忍饥难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中闻墙外鬻鱼菜者求售之声甚苦有感三绝 其三","author":"范成大","text":"啼号升斗抵千金，冻雀饥鸦共一音。\n劳汝以生令至此，悠悠大块亦何心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪中闻墙外鬻鱼菜者求售之声甚苦有感三绝 其二","author":"范成大","text":"忧渴焦山业海深，贪渠刀蜜坐成禽。\n一身冒雪浑家煖，汝不能诗替汝吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后苦寒","author":"范成大","text":"旋融檐滴冻琅玕，风力如刀刮面寒。\n雪阵搅空风却软，天公知我倚阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪后雨作","author":"范成大","text":"瑞叶飞来麦已青，更烦膏雨发欣荣。\n东风不是厌滕六，却怕雪天容易晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪寒探梅","author":"范成大","text":"酸风如箭莫凭阑，冻合横枝雪未乾。\n吴下得春元自晚，那堪天与十分寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"黄伯益官舍赏梅","author":"范成大","text":"一杯何处洗愁颜，黄法曹家玉树寒。\n翠袖撚香留客看，春风都在小阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜收知旧书复畏答书二绝 其一","author":"范成大","text":"故人寥落似晨星，珍重书来问死生。\n笔意不如当日健，鬓边应也雪千茎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜收知旧书复畏答书二绝 其二","author":"范成大","text":"强裁尺素答相思，两目眵昏腕力疲。\n牵率老夫令至此，门前犹说报书迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜周妹自四明到","author":"范成大","text":"团栾话里老庞衰，一妹仍从海浦来。\n孤苦尚馀兄弟乐，如今虽病也眉开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雨","author":"范成大","text":"昨遣长须借踏车，小池须水引鸣蛙。\n今朝一雨添新涨，便合翻泥种藕花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜雪示桂人","author":"范成大","text":"腊雪同云岭外稀，南人北客尽冬衣。\n从今老杜诗犹信，梅片飞时雪也飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"富阳","author":"范成大","text":"不到江湖恰五年，歙山青绕屋头边。\n富春渡口明人眼，落日孤舟浪拍天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒夜独步中庭","author":"范成大","text":"忍寒索句踏霜行，刮面风来须结冰。\n倦仆触屏呼不应，梅花影下一窗灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寒雨","author":"范成大","text":"何事冬来雨打窗，夜声滴滴晓声淙。\n若为化作漫天雪，径上孤篷钓晚江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"插秧","author":"范成大","text":"种密移疏绿毯平，行间清浅縠纹生。\n谁知细细青青草，中有丰年击壤声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"斑骓","author":"范成大","text":"斑骓别后月纤纤，门外疏桐影画帘。\n留下可怜将不去，西风吹上两眉尖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渡淮","author":"范成大","text":"船旗衮衮径长淮，汴口人看拨不开。\n昨夜南风浪如屋，果然双节下天来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游宁国奉圣寺","author":"范成大","text":"松梢台殿郁高标，山转溪回一水朝。\n不惜褰裳呼小渡，夜来春涨失浮桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湘江怨","author":"范成大","text":"蘋芷迷烟路，莲舟忘却归。\n夜寒江水黑，风雨梦如飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"湘潭","author":"范成大","text":"暮雨樯竿县一湾，长官立马水云间。\n风吹江沫浮浮去，谁在沙头闭户閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"程助教远饯求诗","author":"范成大","text":"残山剩水带离亭，送客烦君远作程。\n直欲明年击吴榜，白沙翠竹是柴荆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"窗前木芙蓉","author":"张镃","text":"辛苦孤花破小寒，花心应似客心酸。\n更凭青女留连得，未作愁红怨绿看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"缓带轩独坐","author":"范成大","text":"午日烘开豆蔻苞，檐尘飞动雀争巢。\n蒙蒙困眼无安处，閒送炉烟到竹梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"落鸿","author":"范成大","text":"落鸿声里怨关山，泪湿秋衣不肯乾。\n只道一番新雨过，谁知双袖倚楼寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"谢龚养正送蕲竹杖","author":"范成大","text":"一声霜晓谩吹愁，八尺风漪不耐秋。\n上座独超三昧地，诺惺庵里證般舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赏海棠三绝 其三","author":"范成大","text":"忆向宣华夜倚阑，花光妍煖月光寒。\n如今蹋飒嫌风露，且只铜瓶满插看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赏海棠三绝 其一","author":"范成大","text":"芳春随分到贫家，儿女多情惜岁华。\n聊为海棠修故事，去年灯烛去年花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赏海棠三绝 其二","author":"范成大","text":"烛光花影两相宜，占断风光二月时。\n但得常如妃子醉，何妨独欠少陵诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32342,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"道见蓼花","author":"范成大","text":"秋风袅袅露华鲜，去岁如今刺钓船。\n歙县门西见红蓼，此身曾在白鸥前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32343,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"销夏湾","author":"范成大","text":"蓼矶枫渚故离宫，一曲清涟九里宫。\n纵有暑光无著处，青山环水水浮空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32344,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新荔枝四绝 其四","author":"范成大","text":"趠舶飞来不作难，红尘一骑笑长安。\n孙郎皱玉无消息，先破潘郎玳瑁盘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32345,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新荔枝四绝 其二","author":"范成大","text":"海北天西两鬓蓬，闽山犹欠一枝筇。\n鄞船荔子如新摘，行脚何须更雪峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32346,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新荔枝四绝 其一","author":"范成大","text":"荔浦园林瘴雾中，戎州沽酒擘轻红。\n五年食指无占处，何意相逢万壑东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32347,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞香三首 其三","author":"范成大","text":"一丛三百朵，细细拆浓檀。\n帘幕护花气，不知窗外寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32348,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞香三首 其二","author":"范成大","text":"紫云蹙绣被，团栾覆衣篝。\n浓薰百和韵，香极却成愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32349,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"瑞香三首 其一","author":"范成大","text":"小槛移秀色，端来媚禅房。\n道人不解饮，醺然醉天香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32350,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睡觉","author":"范成大","text":"寻思断梦半瞢腾，渐见天窗纸瓦明。\n宿鸟噪群穿竹去，县前犹自打残更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32351,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睢水","author":"范成大","text":"一战填河拥汉屯，拔山意气已鲸吞。\n直南即是阴陵路，兵果难将胜负论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32352,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"福胜阁","author":"范成大","text":"翚飞五级半空翔，指点楼栏说太皇。\n劫火不能侵愿力，岿然独似汉灵光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32353,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"简毕叔滋觅牡丹","author":"范成大","text":"冷落韶光谷雨寒，一年孤负倚阑干。\n欲知春色偏浓处，须向香风径里看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32354,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞姬墓","author":"范成大","text":"刘项家人总可怜，英雄无策庇婵娟。\n戚姬葬处君知否，不及虞兮有墓田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32355,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蜀花以状元红为第一金陵东御园紫绣毬为最","author":"范成大","text":"西楼第一红多叶，东苑无双紫压枝。\n梦里东风忙里过，蒲团药鼎鬓成丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32356,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"跨马过练墟喜晴","author":"范成大","text":"稻穗初乾怕雨时，晚来蒸煖欲霏微。\n西风若肯吹云尽，不惜飘飘侧帽归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32357,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酬姜尧章","author":"范成大","text":"鹅鹜声暗雪意豪，直前不惮夜行劳。\n更能櫜鞬尊裴度，千古人知李愬高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32358,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"锦亭然烛观海棠","author":"范成大","text":"银烛光中万绮霞，醉红堆上缺蟾斜。\n从今胜绝西园夜，压尽锦官城里花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32359,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雷万春墓","author":"范成大","text":"九陨元身不陨名，言言千载气如生。\n欲知忠信行蛮貊，过墓胡儿下马行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32360,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雷雨邻舍起龙","author":"范成大","text":"雨工避事欲蟠泥，帝遣丰隆执以归。\n连鼓一声人失箸，不知挂壁几梭飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32361,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"墙外卖药者九年无一日不过吟唱之声甚适雪中呼问之家有十口一日不出即饥寒矣","author":"范成大","text":"十口啼号责望深，宁容安稳坐毡针。\n长鸣大咤欺风雪，不是甘心是苦心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32362,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"碧瓦","author":"范成大","text":"碧瓦楼头绣幕遮，赤栏桥外绿溪斜。\n无风杨柳漫天絮，不雨棠梨满地花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32363,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"缥缈峰","author":"范成大","text":"满载清閒一棹孤，长风相送入仙都。\n莫愁怀抱无消豁，缥缈峰头望太湖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32364,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"翠楼","author":"范成大","text":"连衽成帷迓汉官，翠楼沽酒满城欢。\n白头翁媪相扶拜，垂老从今几度看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32365,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蔺相如墓","author":"范成大","text":"玉节经行虏障深，马头酾酒奠疏林。\n兹行璧重身如叶，天日应临慕蔺心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32366,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘲风","author":"范成大","text":"纷红骇绿骤飘零，痴騃封姨没性灵。\n报道海棠方熟睡，也须留眼为渠青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32367,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘲里人新婚","author":"范成大","text":"冷艳頩容一笑开，休将鸾扇更徘徊。\n箜篌细写归舟字，彷佛游仙梦里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32368,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"横塘","author":"范成大","text":"南浦春来绿一川，石桥朱塔两依然。\n年年送客横塘路，细雨垂杨系画船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32369,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题蜀果图四首 其二 樱桃","author":"范成大","text":"火齐宝璎珞，垂于绿茧丝。\n幽禽都未觉，和露折新枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32370,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"樱桃花","author":"范成大","text":"借煖冲寒不用媒，匀朱匀粉最先来。\n玉梅一见怜痴小，教向傍边自在开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32371,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蝙蝠","author":"范成大","text":"伏翼昏飞急，营营定苦饥。\n聚蚊充口腹，生汝亦奚为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32372,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"镇下放船过东山二首 其二","author":"范成大","text":"老禅竿木各逢场，诗客端来共苇航。\n一任颠风聒高浪，满船欢笑和诗忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32373,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"镇下放船过东山二首 其一","author":"范成大","text":"打头风急鼻雷鼾，醉梦閒心铁石顽。\n惟有爱山贪未厌，西山才了又东山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32374,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题山水横看二首 其一","author":"范成大","text":"烟山漠漠水漫漫，老柳知秋渡口寒。\n尽是西溪肠断处，凭君将与故人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32375,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题山水横看二首 其二","author":"范成大","text":"霜入丹枫白苇林，横烟平远暮江深。\n君看雁落帆飞处，知我秋风故国心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32376,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题天平寿老方丈","author":"范成大","text":"二十三年再入山，此山于我有前缘。\n时人不用怜衰病，天与丹房一线泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":32377,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]