[{"title":"拟寒山寺 其一","author":"释怀深","text":"我爱寒山子，身贫心自如。\n吟诗无韵度，烧火有工夫。\n弊垢衣慵洗，鬅鬙发懒梳。\n相逢但长啸，肉眼岂知渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1611,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其二","author":"释怀深","text":"拾得诗清苦，风骚道自存。\n看云攲怪石，步月出松门。\n识取心中佛，休磨镜上痕。\n时时多漏泄，尘世少知恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1612,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其三","author":"释怀深","text":"寒山三百编，言淡而有味。\n论心无隐情，警世多逆耳。\n下士闻之嗔，上土读之喜。\n翻笑老闾丘，对面如千里。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1613,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其四","author":"释怀深","text":"吾诗少风骚，急欲治人病。\n譬如万灵丸，服者无不应。\n良药多苦口，忠言须逆听。\n劝君勉强服，生死殊不定。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1614,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其五","author":"释怀深","text":"佛以真实口，说法无虚谬。\n人天常诵持，龙神知护祐。\n施食放生命，决定报长寿。\n过酒与僧尼，后世必无手。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1615,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其六","author":"释怀深","text":"在家闻见熟，意谓合食肉。\n一蚁不忍杀，何况烹六畜。\n愿君青眼开，试将黄卷读。\n要闻知见香，熏汝腥膻腹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1616,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其七","author":"释怀深","text":"世上多杀生，遂有刀兵劫。\n负命杀汝身，欠财焚汝宅。\n离散汝妻子，曾破他巢穴。\n影响各相似，洗耳听佛说。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1617,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其八","author":"释怀深","text":"偶然家计富，享用便过度。\n猪厌思食羊，鱼厌思食兔。\n朝昏但醉饱，锥刀图积聚。\n不畋鹑在宎，此理早须悟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1618,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其九","author":"释怀深","text":"何曾食万钱，颜子饮一瓢。\n贤者心念道，愚人志在庖。\n贤愚趣不同，何啻云泥遥。\n豢养恐非福，可信如昭昭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1619,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其十","author":"释怀深","text":"世间一等人，谄事诸神鬼。\n杀命欲邀福，皇天无此理。\n种棘不生禾，身曲影难直。\n孔子有箴诫，可信如金石。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1620,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其十一","author":"释怀深","text":"人生平为福，有馀返为害。\n庄周烛理明，可作贪者戒。\n富汉喜食肉，贫家多吃菜。\n吃菜比食肉，且无身后债。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1621,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其十二","author":"释怀深","text":"渔者不能猎，猎者不能渔。\n贵人钱为网，水陆皆可图。\n畜生肉尝遍，诸佛心转疏。\n黄泉途路滑，失脚恐难扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1622,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其十三","author":"释怀深","text":"富人聚族多，鱼肉论秤买。\n腥膻众口分，罪业一身载。\n既失慈悲心，恣情为杀害。\n忽然死到来，去还畜生债。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1623,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其十四","author":"释怀深","text":"祝寿作生日，亲朋互相庆。\n未烧一炉香，且杀百个命。\n奴仆各醉饱，歌舞乱观听。\n如此望长年，为汝惭诸圣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1624,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其十五","author":"释怀深","text":"日食半斤肉，十年一百秤。\n且限六十年，不知几个命。\n肉块高如山，业坑深似井。\n前路黑漫漫，劝君宜猛省。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1625,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其十六","author":"释怀深","text":"有酒方开颜，无肉不举箸。\n颠倒自戕贼，拟将血肉补。\n弃却囊中金，反收路傍土。\n不见富贵家，未死神先去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1626,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其十七","author":"释怀深","text":"人生稍富足，著意营口腹。\n买鱼寻鳜鱼，买肉要羊肉。\n谛观异类身，无非亲眷属。\n正当举箸时，仁人宜自烛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1627,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其十八","author":"释怀深","text":"忽闻贼杀人，吞声眉已皱。\n不知杯中羹，甘肥自何有。\n汝身既怕死，物命亦爱寿。\n彼此莫相杀，且要无身后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1628,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其十九","author":"释怀深","text":"忍人喜啖脍，砧几膏血洒。\n想见鱼痛时，正似人遭剐。\n咀嚼称珍奇，恻隐略无也。\n影响恐非遥，不在九泉下。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1629,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其二十","author":"释怀深","text":"肉食未必珍，蔬食未必恶。\n若知妄想根，始笑舌头错。\n此身喻行厕，臭秽相勾络。\n打破饭袋子，光明常阴速。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1630,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其二十一","author":"释怀深","text":"买肉须要肥，买鱼须要活。\n买酒须要美，买田须要阔。\n买婢须要峭，买奴须要黠。\n若教买香烧，一毛不肯拔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1631,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其二十二","author":"释怀深","text":"美食意生贪，粗食心起怒。\n喃喃嗜饱满，殊不知来处。\n人生一饭间，贪嗔痴悉具。\n智者善思惟，莫为餔啜误。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1632,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其二十三","author":"释怀深","text":"人生贵无求，乐善而知足。\n安步以当车，晚食以当肉。\n藜羹傲鼎食，草茵欺绣褥。\n须知高明家，鬼神瞰瞒天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1633,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其二十四","author":"释怀深","text":"有个聪明汉，家中五欲全。\n吃得肉已饱，来寻僧说禅。\n心口自违背，佛祖望齐肩。\n不知有底急，平白要瞒天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1634,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其二十五","author":"释怀深","text":"冷笑富家翁，营生忙似钻。\n囷里米生虫，库中钱烂贯。\n白日把秤称，夜间点灯算。\n形骸如傀儡，莫教麻量取。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1635,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其二十六","author":"释怀深","text":"福轻似鸿毛，祸重如厚地。\n避祸而修福，百中无一二。\n黄雀死弹丸，锦鳞丧香饵。\n箴诫甚分明，愿君宜早计。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1636,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其二十七","author":"释怀深","text":"大富长者家，具足诸烦恼。\n福多作业多，福少作业少。\n争如贫道人，一裘一纸袄。\n也不怕死生，也不忧贼盗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1637,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其二十八","author":"释怀深","text":"我口常吃菜，你腹常饱肉。\n看你肥如瓠，笑我瘦如竹。\n我瘦且无冤，汝肥恐非福。\n斯言虽逆耳，请君徐徐读。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1638,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其二十九","author":"释怀深","text":"好生恶死心，人畜无差别。\n刀砧才见前，愁苦不容说。\n鹑诗颇哀鸣，牛拜弥惨切。\n嗟吁人不悟，一至身殂灭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1639,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其三十","author":"释怀深","text":"刀上有少蜜，小儿争欲舐。\n花底藏毒蛇，老翁不瞥地。\n割舌与伤身，皆从贪爱起。\n世上聪明人，往往皆如是。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1640,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其三十一","author":"释怀深","text":"有人好臧否，信口乱比况。\n张三小有才，李四大无当。\n终日品藻人，不知是虚诳。\n自己一灵物，抛在粪堆上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1641,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其三十二","author":"释怀深","text":"人生萍托水，流转诸爱河。\n鼓激无明风，出入生死波。\n一念若知歇，诸魔必倒戈。\n急须登觉岸，劝子莫蹉跎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1642,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其三十三","author":"释怀深","text":"肥鱼死砧机，过在贪香饵。\n蚌蛤不吞钩，亦遭人所嗜。\n有身则有苦，无身则无累。\n跳出业波澜，始到安乐地。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1643,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其三十四","author":"释怀深","text":"人生贪爱重，所欲未尝周。\n一饭饱足矣，万钟心未休。\n黑业埋头做，红裙判命求。\n鬓毛已侵雪，犹自不知羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1644,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其三十五","author":"释怀深","text":"一朝失一朝，一瞬老一瞬。\n去生渐渐远，去死渐渐近。\n愿君倒指数，光阴有几寸。\n蓦被死魔牵，前头多闷闷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1645,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其三十六","author":"释怀深","text":"黄犬被人杀，哀号告诉人。\n汝不辨犬语，犬必怨汝身。\n恶根今日种，苦果异时新。\n酬偿恐未已，早以戒香熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1646,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其三十七","author":"释怀深","text":"黄犬见人喜，未唤先掉尾。\n长年护汝家，深夜不敢睡。\n无罪忽见烹，此理恐未是。\n细推犬有功，却叹人无义。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1647,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其三十八","author":"释怀深","text":"因果耳不闻，说话多差错。\n畜生若不杀，世上无处着。\n此语乃魔语，诱人入鼎镬。\n不知羊与人，互换相酬酢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1648,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其三十九","author":"释怀深","text":"今生你杀羊，后世羊杀你。\n两角还两角，一尾偿一尾。\n假使百千劫，影响无差理。\n见你气峥嵘，无人敢启齿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1649,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其四十","author":"释怀深","text":"君看砧上鱼，忍痛不能语。\n身虽遭斩斫，心犹念男女。\n人既有妻儿，鱼岂无子母。\n若怀这个心，如何可下箸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1650,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其四十一","author":"释怀深","text":"贵人惜性命，奉养欲长生。\n空心鹿茸酒，补气腰子羹。\n汤药不离口，卑湿岂敢行。\n饶君善将理，难与死魔争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1651,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其四十二","author":"释怀深","text":"人生贵无业，不贵多伎能。\n伎能人看好，业能灾汝形。\n文章妙天下，气宇吞沧溟。\n此身若一失，六趣且飘零。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1652,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其四十三","author":"释怀深","text":"猪羊养一群，鸡鹅不知数。\n准拟宾客来，旋杀供钢箸。\n烹羊猪已惊，割鸡鹅已惧。\n从头吃至尾，不知何以故。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1653,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其四十四","author":"释怀深","text":"嗟乎崔道纪，酒狂啖龙子。\n天网信不漏，响应若弹指。\n既失黑头相，便作黄泉鬼。\n怜君学仲尼，曾无子产志。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1654,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其四十五","author":"释怀深","text":"贫民饿欲倒，富汉米不粜。\n米烂化为虫，犹嫌价利小。\n价利更若高，沟壑皆饿殍。\n人生萌此心，鬼神暗里笑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1655,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其四十六","author":"释怀深","text":"世人无智慧，区区营口体。\n啜茶怕损脾，食蔬恐耗气。\n二毛今半百，千金买一醉。\n算来黠是痴，嗟君开眼睡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1656,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其四十七","author":"释怀深","text":"老翁急营生，贪饕不可化。\n一截已入土，百事放不下。\n经卷无暇看，数珠未曾把。\n死去见阎王，必定遭唾骂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1657,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其四十八","author":"释怀深","text":"贫贱关前业，休嗟命未亨。\n田园不种树，花果何由生。\n千沉两条路，看你如何行。\n愿君牢着脚，前面有深坑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1658,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其四十九","author":"释怀深","text":"人生如春花，能得几时好。\n朝吹与暮洗，朱颜变枯槁。\n花落有时生，人老不复少。\n万事只令休，莫惹闲烦恼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1659,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其五十","author":"释怀深","text":"富汉欺贫汉，南邻瞒北邻。\n斗秤有两样，言语无一真。\n大秤买他物，小斗粜与人。\n眼下得便宜，暗中多鬼神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1660,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其五十一","author":"释怀深","text":"人生重道德，不重多金银。\n金银润汝屋，道德光汝身。\n金银生盗贼，道德息贪嗔。\n寻思富汉子，不如贫道人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1661,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其五十二","author":"释怀深","text":"健啖众生肉，痴心要作过。\n白发五六十，红裙七八个。\n歌舞中笑谈，锦绣中坐卧。\n苦海前头深，莫教船子破。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1662,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其五十三","author":"释怀深","text":"天高听甚卑，神幽察甚厚。\n埋蚕蚕变尸，烧蚁蚁成漏。\n呵吹一气间，冷暖各成就。\n恶从汝心生，还从汝心受。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1663,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其五十四","author":"释怀深","text":"池中养却鱼，岸上养却鸭。\n瘦者喂教肥，肥者便要杀。\n不思身债重，只要口甘滑。\n腊月三十日，看你成忉怛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1664,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其五十五","author":"释怀深","text":"世上聪明人，必欲闻其过。\n不知是业牵，却云合恁么。\n因果镜中容，容岂非是我。\n阴报最分明，不论官职大。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1665,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其五十六","author":"释怀深","text":"口如无底谷，餔啖何时足。\n力未能长蔬，心且戒四肉。\n腥膻念有间，慈悲种渐熟。\n人生弹指间，少恣在明腹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1666,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其五十七","author":"释怀深","text":"世人黠是痴，忘身多为口。\n拚命吃河鲀，忍臭餐石首。\n年年江浙间，药杀十八九。\n自云直一死，佛亦不可救。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1667,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其五十八","author":"释怀深","text":"自能持不杀，随处多放生。\n如人犯刑宪，堕落枷锁坑。\n忽然身得脱，惊喜且悲鸣。\n含生皆怕死，何欲苦相烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1668,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其五十九","author":"释怀深","text":"前世杀害多，今报夭折苦。\n方矜面如花，已见身归土。\n哭倒白头亲，怨杀朱唇妇。\n因果镜中形，毫发无差误。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1669,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其六十","author":"释怀深","text":"人间官法中，畜生杀无罪。\n朝烹与暮割，恬然不知悔。\n世法虽不理，冤债何时已。\n不见遂安公，五犬逼而死。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1670,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其六十一","author":"释怀深","text":"前世食肉多，今报疾病苦。\n针艾遍支体，呻吟彻朝暮。\n变医虽有术，夙业岂能去。\n愿君祈忏摩，刳心听佛语。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1671,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其六十二","author":"释怀深","text":"守口要如瓶，语言当自保。\n多知多是非，少出少烦恼。\n东平乐为善，司马只称好。\n相逢但寒温，万事皆默了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1672,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其六十三","author":"释怀深","text":"浮生类俳忧，但可付一笑。\n做人复做马，吃饭今吃草。\n富贵变贫穷，丑陋却美好。\n不识主人公，去来三恶道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1673,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其六十四","author":"释怀深","text":"人云我聪明，识尽天下理。\n逐日弄精魂，长年钻故纸。\n自家一个心，殊不知落地。\n及乎死到来，看你无巴鼻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1674,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其六十五","author":"释怀深","text":"世人怕说死，说着死便讳。\n及期死到来，老眼先垂泪。\n恋妻复恋妾，见神并见鬼。\n不入祖师门，痴迷直到底。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1675,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其六十六","author":"释怀深","text":"六十休造屋，七十莫置衣。\n纵然得受用，能得几多时。\n身心要早歇，准拟与死期。\n正如人远出，预辨者便宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1676,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其六十七","author":"释怀深","text":"野鹿贪嗜草，忽中猎师箭。\n老鼠翻饭盆，已落狸奴便。\n祸从贪上起，苦自爱中现。\n贪爱若不生，灾害自然远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1677,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其六十八","author":"释怀深","text":"道力与福力，平时似乱真。\n福力有盛衰，道力无富贫。\n人生不学道，只种轮回因。\n君看天福尽，满眼生埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1678,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其六十九","author":"释怀深","text":"不贪以为宝，日用无欠少。\n一裘聊御寒，百味无过饱。\n堪嗟尘世人，经营长扰扰。\n衣底摩尼珠，光明都昧了。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1679,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"拟寒山寺 其七十","author":"释怀深","text":"善恶生汝心，汝心宜早戢。\n鹅烹语告人，狗死魂犹泣。\n警诫甚分明，愚耳终不入。\n苦果一朝熟，恐君悔不及。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":1680,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]