[{"title":"偈颂十七首 其十五","author":"释智愚","text":"城东圣母坐莲台，大地众生正眼开。\n与佛同生嫌见佛，一身难作二如来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其十三","author":"释智愚","text":"丁宁损君德，无言真有功。\n任从沧海变，终不为君通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其十","author":"释智愚","text":"道人猛利难亲近，漾笠中流验作家。\n忆昔高人何处去，夜深和月过平沙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其九","author":"释智愚","text":"群阴剥尽一阳生，又见东山水上行。\n冷笑云门多口老，却来日午打三更。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20243,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂十七首 其五","author":"释智愚","text":"七步周行犹彷佛，指天指地不分明。\n是非既落傍人耳，洗到驴年也不清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20244,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄东湖溥侍者","author":"释智愚","text":"声前未举已先知，曾用输机陷国师。\n险处与谁分胜负，蘋花汀草暗相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20245,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄节维那","author":"释智愚","text":"几度忘言话克宾，丛林音响许谁闻。\n海山秋夜对孤月，应记北高峰顶云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20246,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄都省罗太尉","author":"释智愚","text":"海涵山育气如春，内相声华中外闻。\n纲纪禁庭天宠密，金珰长染御炉熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20247,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄寂照庵主","author":"释智愚","text":"远引高踪继覆盆，一龛枯寂是前身。\n秀峰影里闲揩眼，见尽深云未到人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20248,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄崇福源长老","author":"释智愚","text":"一发千钧适此时，风前无语皱双眉。\n松源正脉将枯竭，浚发灵源复是谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20249,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄雪窦足首座","author":"释智愚","text":"光芒曾不著纤埃，拂拭磨砻心已灰。\n秋夜不禁猿啸月，与谁同上妙高台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20250,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄雪窦性首座","author":"释智愚","text":"祝融峰下烧红叶，应梦山中看白云。\n足迹未教容易见，谁知天外有人闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20251,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄婺守赵玉堂","author":"释智愚","text":"儒释同科到者稀，道融冰雪鉴精微。\n和平堂上公馀坐，静看寒云片片归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20252,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄慈峰故人","author":"释智愚","text":"湖面春归物理明，水花无数点青萍。\n因行若访和庵主，未必孤踪在二灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20253,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"得颐","author":"释智愚","text":"地窄天宽古所闻，诛茅分得半溪云。\n有时梦觉萝窗底，懒听前峰鹿叫群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20254,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"惟侍者号曲江","author":"释智愚","text":"源脉滔滔古岸头，往来终是碍行舟。\n无风激起千寻浪，到海方知是逆流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20255,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"断桥","author":"释智愚","text":"瞎驴一蹈两头空，便与寻常路不同。\n寸步却成千里隔，纷纷多在半途中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20256,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梁楷忘机图","author":"释智愚","text":"寻常忘物我，浑不涉希夷。\n梦落秋坛冷，从教斗柄移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20257,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"清禅者游方","author":"释智愚","text":"金风露浥菊花秋，杞棘当途何处游。\n衡岳康庐相撞著，恐伊未是汝同流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20258,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"渊禅人之乳峰","author":"释智愚","text":"渊默雷声善发机，钝根难下顶门椎。\n青霜黄叶压穷野，急急归来见隐之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20259,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"善应无方","author":"释智愚","text":"两脚蹒跚林叶稀，去来初不涉离微。\n灵机未转已先照，踪迹拟从何处归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20260,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"璟和尚号石庵","author":"释智愚","text":"空岩为屋薜萝门，天巧浑无斧凿痕。\n花鸟不来云自合，竖拳消息与谁论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20261,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"曾禅人唯之","author":"释智愚","text":"当头一诺未为亲，大道难将语默分。\n不听晚风江上笛，一声吹破碧天云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20262,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"棘林","author":"释智愚","text":"海凤飞来不敢栖，旧条新刺利如锥。\n茫茫出得出不得，只许拚身到者知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20263,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"琳禅人归豫章","author":"释智愚","text":"慎将窥管鉴灵知，用在亡羊愧在斯。\n莫谓西山好消息，须知江海有名缁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20264,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"缘对","author":"释智愚","text":"石床偃月梦魂冷，溪水写真癯影清。\n平生矻矻自忘我，世外不知谁可盟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20265,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢芝峰交承惠茶","author":"释智愚","text":"拣芽芳字出山南，真味那容取次参。\n曾向松根烹瀑雪，至今齿颊尚馀甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20266,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢梦庵居士性宗集","author":"释智愚","text":"性本无宗梦亦非，万机难透一真机。\n有时暗与乾坤合，笑看春花秋叶飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20267,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"越山","author":"释智愚","text":"翠螺簇簇绕湖滨，寒影清磨古鉴尘。\n休问冈头望夫石，人间恐有断肠人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20268,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"铸印","author":"释智愚","text":"袍著金花勒小骢，扬鞭几度月明中。\n黄河界上空来往，直至如今未树功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20269,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溥禅人归疏山","author":"释智愚","text":"故山临汝梦秋江，况是蛩吟月到窗。\n不住京华南荡寺，法身归去问枯桩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20270,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"溥禅者西还","author":"释智愚","text":"梅影稀疏兰叶香，吴中水草越中行。\n荒田触目无人拣，款款归来带月耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20271,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬李新恩惠竹杖","author":"释智愚","text":"一枝苍玉寄宵人，远胜邛州九节纹。\n添得老来山水兴，指空敲石看飞云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20272,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬觉如居士","author":"释智愚","text":"觉体如如不变时，能驱万象入毫釐。\n毗耶城里无人识，一默雷轰只自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20273,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧之金陵","author":"释智愚","text":"良宵桂月耿中庭，蛩在青莎叶底鸣。\n别我寸心如寸铁，不知南国几多程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20274,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧归越","author":"释智愚","text":"露激风抟岸草秋，揽衣何处上兰舟。\n无方始是知方者，莫效支师泥沃洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20275,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"僧游台雁","author":"释智愚","text":"音旨双消不可闻，捲衣南去与谁论。\n龙湫水涩石桥滑，得路应敲尊者门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20276,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"碧照轩","author":"释智愚","text":"剪木依山巧凿池，已知写影到人稀。\n一奁寒玉坐来久，但见双双白鸟飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20277,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"端书记赴云城辟命","author":"释智愚","text":"不游文苑入祇园，刍草风香春正妍。\n要识根茎来处远，葛仙丹井冷云边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20278,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"韬光室","author":"释智愚","text":"懒去栽花傍竹篱，旋收岩叶毳寒衣。\n不知陆谷几迁变，时见断云相逐归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20279,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"墨竹","author":"释智愚","text":"毫端不及处，精神殊可掬。\n靡靡听谈玄，六月添重服。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20280,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"德信西上","author":"释智愚","text":"出门溪叶乱纷纷，欲去重寻旧主人。\n碓下莫辞腰石冷，古菱花绽不干春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20281,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"德惟侍者巡礼","author":"释智愚","text":"岩桂初飘好问津，软风轻结露华新。\n诸方不用多招手，自有寻香逐臭人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20282,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"慧禅人之万年","author":"释智愚","text":"鼠入钱筒伎已穷，十年踪迹眼头空。\n如今又问平田路，山舍半吹黄叶风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20283,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"憨憨泉","author":"释智愚","text":"憨泉一掬清无底，暗与曹源正脤通。\n陆羽若教知此味，定应天下水无功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20284,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"潭老号古渊","author":"释智愚","text":"蛟龙窟宅初无底，神禹难穷浅与深。\n好把凝流消息子，沛然为雨活丛林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20285,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题渔矶","author":"释智愚","text":"秋竿倚石台，沙鸟暗相猜。\n一草有时动，几朝鱼不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20286,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"衡阳庞居士庵","author":"释智愚","text":"居士当年错用心，浑家不睦到如今。\n摝篱柄短无人买，空自萧萧风满林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20287,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠许居士","author":"释智愚","text":"山仪不裹庞公帽，亸袖深藏傅老槌。\n敲磕诸方应未已，眼头乖角少人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20288,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠妙洁道人","author":"释智愚","text":"妙心明洁契如如，操履分明女丈夫。\n庞老家风殊不二，摝篱高价许谁沽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20289,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠妙喜社道友","author":"释智愚","text":"断来妙喜针锋上，塞破虚空不碍空。\n昔日维摩今社友，相逢个个有神通。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20290,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠禅客智仁","author":"释智愚","text":"法战场中树胜旗，话头何似问头危。\n古人减灶添兵处，切忌交锋蹉过伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20291,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"霞光亭","author":"释智愚","text":"灵迹宣符岂易量，故应祥彩发天藏。\n真风不逐三韩去，直至如今草木香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20292,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瞿居士号无知","author":"释智愚","text":"过缘触境总茫然，地阔天宽著那边。\n一点既明超物表，不知将底鉴偏圆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20293,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上竺池院归鹫峰庵","author":"释智愚","text":"鹫岭心旌动，池边影渐疏。\n一生无定力，七十尚移居。\n细雨洒松坞，凉风挽竹舆。\n白云相望处，局蹐自渠渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20294,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北山庵居","author":"释智愚","text":"祖担终难荷，岩栖尽可攀。\n爱闲嫌日短，遇兴不知还。\n谷啸风搏虎，窗明月启关。\n馀生无异念，赢得放疏顽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20295,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"玄黄不真","author":"释智愚","text":"万物自全璧，蒙庄安可齐。\n月高松影细，风急雁行低。\n谁把丹青入，难将竹帛题。\n寒山应笑我，携手隔云泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20296,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"动静双照","author":"释智愚","text":"举息冥方所，徒称宋地僧。\n百年应自掷，一饭若为凭。\n风暖斗山鹊，烟消露石棱。\n分甘云水共，终日任腾腾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20297,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次白云端和尚韵礼杨岐会禅师塔","author":"释智愚","text":"来拜东山祖，峰高日未央。\n遐瞻心已足，右绕兴何长。\n啼鸟惊人去，飞花过水香。\n西河牙爪在，曾不愧汾阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20298,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观山水图留休禅者","author":"释智愚","text":"近远何多趣，难将尺寸求。\n向来披岳顶，今已遍神州。\n水肃苍林晚，寒生玉井秋。\n圆蒲冷相对，时与话峰头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20299,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"针生大坑","author":"释智愚","text":"假道针锋上，行藏云水中。\n且非心法妙，自是手头通。\n前辈多遗偈，灵襟出众工。\n明朝何处去，黄叶度溪风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20300,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"净发吴生","author":"释智愚","text":"适意多云水，寻幽访所知。\n曾于竺峰下，会见宝溪时。\n巧理数茎发，清分两点眉。\n忽忘心手处，何谓不如斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20301,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"物我两忘","author":"释智愚","text":"居常多不器，情谓尽方知。\n有眼挂空壁，无心合祖师。\n衲穿随手补，客至下阶迟。\n或问虚堂叟，慇勤说向伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20302,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罗汉树","author":"释智愚","text":"稽首如来种，悲生末世中。\n枝枝成小果，叶叶现神通。\n海月分清影，天香逐晓风。\n愿惟迷己者，睹此出樊笼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20303,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"剃剪林荣","author":"释智愚","text":"众技尔为得，养生何所亲。\n箧中三寸铁，云外一闲身。\n黑白已无几，修治转失真。\n畏寒宜少伐，未愧舀溪人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20304,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日对镜","author":"释智愚","text":"不住复新新，来从幻里真。\n旧髯皆变白，老眼尚精神。\n世事终难鉴，菱花亦有尘。\n东风原上草，不觉又生春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20305,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵开府访霞谷次韵谢之","author":"释智愚","text":"旌幢天外见，缥缈谷中来。\n望重草先偃，山灵云自开。\n禅衣坐幽石，棕柄拂清埃。\n勋业凌烟上，难教隐钓台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20306,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"隐侍者游乳峰","author":"释智愚","text":"窦深惟古雪，霄岸列危峦。\n到者难披顶，寻师多卖单。\n无时云气重，长带瀑声寒。\n挨得入门句，归来示我看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20307,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"就明书怀","author":"释智愚","text":"流菜非深隐，那堪复故山。\n未能忘影迹，终是碍人间。\n白发吟边短，清灯话里闲。\n江湖有新梦，何日出松关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20308,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游栖霞观","author":"释智愚","text":"海上多幽迹，寻碑始得名。\n仙成丹灶冷，霞暖地花生。\n有鹤久不死，见人长欲鸣。\n坛西羽衣子，知我不虚行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20309,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赓静学林府判游天泽庵韵","author":"释智愚","text":"古道兼禅到，躬行得几年。\n乾坤资定力，心月鉴前缘。\n一静人难学，三生话未圆。\n老来重有约，不在北山边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20310,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"黑白何咎","author":"释智愚","text":"世事乱如麻，情人未到家。\n连延深院雨，滴碎后庭花。\n旧话几时别，音书未有涯。\n暝烟将四合，何处起胡笳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20311,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"楫禅人之太白","author":"释智愚","text":"明明不可铭，断续复谁听。\n海上有痴绝，山中无白丁。\n天风生寂籁，霜月下寒汀。\n子去忘幽讨，重岩犹未扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20312,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"酬李寄轩","author":"释智愚","text":"寄傲知何所，行藏匪一轩。\n究心无别旨，鸣道有来源。\n未话先通理，声诗不在言。\n相期湖上寺，执手听啼猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20313,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题书画什后","author":"释智愚","text":"发挥多古迹，优彼色丝辞。\n逸少观鹅处，玄晖纵墨时。\n室虚蛟自触，神久树生悲。\n得处何机感，寻披当尔思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20314,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"霞谷清夜","author":"释智愚","text":"执昼蕴丘壑，冥机未策勋。\n瓦匜消古篆，石榻伴归云。\n胜事知如许，馀生无所闻。\n灯花冷相笑，何可补毫分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20315,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"山行示思穆侍者","author":"释智愚","text":"春水绿浮影，山光泻入怀。\n因思善牧者，随分纳些些。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":20316,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]