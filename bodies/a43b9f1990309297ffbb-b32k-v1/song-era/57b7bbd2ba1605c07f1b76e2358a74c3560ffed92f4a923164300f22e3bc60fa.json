[{"title":"和野渡甲申雪吟 其一","author":"卫宗武","text":"盈尺为祥须应占，洪纤著物类形盐。\n幻成列阜鼍城涌，散作千林蝶阵粘。\n清友不妨添玉骨，苍官俄怪变银髯。\n祇怜岁岁催人老，染尽华颠亦可嫌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3675,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和野渡咏梅","author":"卫宗武","text":"傍宅林园巧，亭垂剪剪茅。\n雪香藏冷艳，月影浸疏梢。\n桃李陪台等，松筠道义交。\n巡檐频索笑，应不厌推敲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3676,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和野渡春雪","author":"卫宗武","text":"天教滕巽互驱驰，令下东皇莫敢违。\n云擘碎绵迷眼界，山遮新黛抹腰围。\n众芳被虐难争巧，二麦呈祥不用祈。\n片片吹将入檐幕，佳人错认落梅飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3677,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和野渡雪消二律 其一","author":"卫宗武","text":"雪晴吟弄句仍佳，满纸鲛珠屡拜嘉。\n刻玉林林空楮叶，沾泥处处失杨花。\n消成滴沥原归旧，润入根荄生有涯。\n剩洗瓶罂储此水，待驱炎暑煮春茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3678,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和野渡雪消二律 其二","author":"卫宗武","text":"可亲馀暇复奚为，雪霁何妨剩赋诗。\n应怪玉峰还翳荟，更怜银屋变茅茨。\n结成冰笋方连夜，散作檐花特顷时。\n物物要知须返本，冰仍归水更何疑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3679,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"咏野渡香片蟠梅","author":"卫宗武","text":"一瓣生香独傲寒，此梅难并众梅看。\n明眸玉雪层层积，蜕骨蛟龙曲曲蟠。\n巧若天成经岁远，移来地阔占春宽。\n老夫犹未识花面，觅句含毫作是观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3680,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨后坚山行之约","author":"卫宗武","text":"水泛新堤蘸柳条，郊行喜有可人招。\n不堪白发三千丈，莫负青春九十朝。\n鸥鹭何妨为伴侣，鹍鹏一任诧扶摇。\n山灵久拟骚人到，霁月光风不待邀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3681,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南徐买舟将归","author":"卫宗武","text":"风雨连朝思黯然，山迷宿霭水迷烟。\n一年春事少閒日，半月客程逢漏天。\n喜涉鲸波返江国，便思鹤唳买河船。\n修途往复成何事，姑了馀生未了缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3682,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南塘归自浙东","author":"卫宗武","text":"鼓枻归来波浪平，碧天如水月分明。\n几番恶梦频惊散，一片閒愁顿扫清。\n桂子高风生逸思，菊花老圃悦吟情。\n同盟约过渊明宅，载酒东篱莫厌倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3683,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣妙寺即事","author":"卫宗武","text":"寺小经年久，地偏人到稀。\n山光含野色，泉脉出林霏。\n老树藏金粟，繁枝长绿衣。\n门前千岁柏，长日映清晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3684,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宣妙寺偶成","author":"卫宗武","text":"孤寺萧然寄碧岑，尘无半点到僧门。\n风传钟鼓万家县，山绕犁锄十里村。\n一榻高眠慨今夕，八窗洞达纳乾坤。\n此行梅月孤良觌，雨打寒林晚复昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3685,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"星节前戏成","author":"卫宗武","text":"依稀桥鹊布银潢，又见天孙作妇忙。\n已向烟萝深遁迹，不烦云锦粲成章。\n追思高会饮传烛，徒得清眠梦熟粱。\n却喜连朝天沛泽，应为月姊酿秋芳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3686,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春山","author":"卫宗武","text":"新晴散佳丽，列阜气尤豪。\n腻草翻风沃，芳林映日高。\n殢情醲似酒，溢目涌如涛。\n众史应难画，吟将入彩毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3687,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雨 其三","author":"卫宗武","text":"一自苍精涣号扬，如酥小雨酿春忙。\n霏霏透入根荄脉，点点染成桃杏妆。\n泽遍高深俱及物，气融枯槁亦生香。\n老夫那复问芳讯，但愿三时协雨旸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3688,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春雨 其二","author":"卫宗武","text":"一自春来二月强，连宵甘霔泽斯滂。\n润留根蒂梅桃实，清及萌芽黍稷香。\n雀舌纤纤抽茗叶，羊群戢戢长松秧。\n农桑从此无虚日，织妇耕夫处处忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3689,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚郊行 其二","author":"卫宗武","text":"步屧出郊原，家家春满门。\n斜阳芳草岸，流水落花村。\n露叶梅藏子，云根竹长孙。\n东君老仍媚，犹有野芳存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3690,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚郊行 其一","author":"卫宗武","text":"盎若阳和气，融融满太空。\n水涵春屿碧，林镂夕阳红。\n过尽桃花雨，吹来杨柳风。\n韶光晚尤媚，游兴浩难穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3691,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚郊行","author":"卫宗武","text":"细草平芜接渚沙，僧庵系马柏阴斜。\n青山几曲绕流水，啼鸟数声随落花。\n芳景流连春富贵，晴林浮动日光华。\n独怜人事多非旧，寂寞荒村点暮鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3692,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晚郊行 其三","author":"卫宗武","text":"东风吹不断，芳草正萋萋。\n暗绿藏禽语，残红衬马蹄。\n莎汀连苇岸，麦陇间蔬畦。\n往岁行春路，推敲认旧题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3693,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"津途风雨欲雪","author":"卫宗武","text":"宇宙忽凝合，一元如未分。\n天悭花剪水，风泼墨成云。\n饥鸟啄木理，戏凫生浪纹。\n祁寒飞两棹，行役为谁勤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3694,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋后郊行","author":"卫宗武","text":"水北水南村，萦回草径深。\n食蔬虫篆叶，宿树鸟盘林。\n岸断分支港，云开出远岑。\n意行无个事，斜日照孤吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3695,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赴野渡招赏桂 其二","author":"卫宗武","text":"插架金英喷月光，园中列树更堂堂。\n信从天上灵根出，染得古来诗句香。\n今度花迟前度发，三分秋占二分强。\n主人健笔供模写，压倒当年苏与黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3696,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赴野渡招赏桂 其一","author":"卫宗武","text":"几年寥落负秋光，剩喜朋簪列耐堂。\n枌社重开真率集，桂华新荐广寒香。\n故交今日嗟无几，我辈晨星当自强。\n况有坐中名胜在，携尊何待菊花黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3697,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重九","author":"卫宗武","text":"榆景转凄凉，逢秋更断肠。\n百年能几日，多岁负重阳。\n杜酿悭浮白，陶篱半点黄。\n可嗟人事异，花不减寒香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3698,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重到霅陇 其二","author":"卫宗武","text":"少壮记曾游，兹来营首丘。\n青山不改色，白发自多愁。\n寂寂千年晚，萧萧风雨秋。\n世缘何日了，一笑问盟鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3699,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重到霅陇 其一","author":"卫宗武","text":"重来知几度，行屐遍松楸。\n白日惟催老，黄花又送秋。\n山深林翳扫，墅豁稻云收。\n尽说丰年乐，田家更觉愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3700,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重到霅陇新阡","author":"卫宗武","text":"摸金郎久遍郊原，冢域犹欣草木蕃。\n松已高年为老友，竹添新谱长仍孙。\n四围秀色山浮几，一曲清溪水到门。\n莫恨牛眠无瑞应，且欣老寿此身存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3701,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"首春同枌友携樽过野渡访梅即席 其二","author":"卫宗武","text":"访梅寻友款幽居，俄见栖鸦已毕逋。\n霁日幸同终日笑，春花有似此花无。\n衔杯林下嫌来晚，索句檐前祇恐晡。\n菲作不妨为玉引，要看词藻竞芬敷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3702,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"借丹岩韵贻青溪","author":"卫宗武","text":"良朋有约著书催，未到愁云拨不开。\n丹穴孤云宜间见，青溪只鹤喜重来。\n有谁剖玉明荆璞，愧我无金筑隗台。\n郑校子衿佻达久，拟延尼父铸颜回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3703,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"唐村买杉为椁南浔买杉为棺戏作","author":"卫宗武","text":"一出四旬归，身谋喜不遗。\n歌方想原壤，谶复合龟兹。\n厚薄惟求称，死生难预知。\n桐棺三寸窆，亦足矫茶毗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3704,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽王总干父知县","author":"卫宗武","text":"蜀溪名阀世为儒，祖擢巍科子亦如。\n从仕为民辞荐牍，移忠有后竟悬车。\n一生冰檗节愈厉，两度弦歌政可书。\n共拟泷碑表亲墓，讵知簪笏化犁锄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3705,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽叶倅二章 其二","author":"卫宗武","text":"死别喜生反，心亲恨迹赊。\n交情金可断，粹德玉无瑕。\n方拟来闻鹤，俄惊梦在蛇。\n归藏重悲感，幸有子承家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3706,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽叶倅二章 其一","author":"卫宗武","text":"八座家声著，居官政不迷。\n典刑乡党敬，节行古人稽。\n展骥空凡马，解牛犹割鸡。\n鸳行才展武，勇退倦攀跻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3707,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽林梅癯","author":"卫宗武","text":"晚擢亚科跻宪掾，拟航选海竟无缘。\n苦吟方与甫俱瘦，疏影俄随逋已仙。\n谷水吟编多手泽，广陵琴趣得心传。\n年几八秩身何憾，老友凋零重怆然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3708,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽南塘朱检阅二首 其二","author":"卫宗武","text":"蚤岁笃盟姻，交情晚更亲。\n耆英亡老友，吟社欠同人。\n气貌温温玉，襟怀盎盎春。\n北山期共隐，临窆重伤神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3709,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽南塘朱检阅二首 其一","author":"卫宗武","text":"传笏自文昌，身名克显扬。\n蜚声腾宦路，接武近鸳行。\n廉尚冰霜洁，吟篇风露香。\n晚年陶靖节，松菊更凄凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3710,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽柳月涧","author":"卫宗武","text":"素履辈儒先，居乡行不愆。\n五言唐句法，千古宋吟编。\n每恨贫难疗，犹欣名可传。\n此生何所有，老寿更希年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3711,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽悟悦师二章 其二","author":"卫宗武","text":"契合岂前因，交情淡愈真。\n开缄疑晋帖，赓句逼唐人。\n高著棋空局，清谈案积尘。\n满襟挥老泪，释友更谁亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3712,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽悟悦师二章 其一","author":"卫宗武","text":"耆宿已凋零，如师亦晓星。\n宗门僧巨栋，梵宇世传灯。\n身阅空花境，心潜多业经。\n悦禅方有悟，六秩吊颓龄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3713,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽都务弟 其二","author":"卫宗武","text":"袭舛承讹俗尚仝，为谋所喜适吾从。\n伤心几载鸰原梦，洒泪今朝马鬣封。\n梁栋材嗟空故木，珠玑香喜长新松。\n最忻壤树首丘正，祖垄葱葱佳气钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3714,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽常蒲溪端明二首 其二","author":"卫宗武","text":"异邑阻登门，因风辄寄声。\n方驰咫尺牍，已奠两间楹。\n模仿楚人些，摩挲白傅铭。\n贞元朝士几，三叹重伤情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3715,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽常蒲溪端明二首 其一","author":"卫宗武","text":"兰省冠时英，清华晚遍更。\n有年尤有德，全节复全名。\n世袭乌台誉，身辞鹓阁荣。\n平生扬历地，千古载廉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3716,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽储华谷四首 其四","author":"卫宗武","text":"归来才一见，病已不能支。\n拟作岁寒友，俄成夜壑悲。\n凄风吹老泪，落日照幽姿。\n赓唱无从再，酸心阅旧诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3717,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽储华谷四首 其三","author":"卫宗武","text":"世慕长生术，君尤早用功。\n谈玄徒至老，养素竟成空。\n身已随朝露，神应到阆风。\n清言那复接，赖有注参同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3718,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽储华谷四首 其二","author":"卫宗武","text":"处晦心常乐，安贫节愈坚。\n遗书订无极，妙蕴发先天。\n扬子惟存宅，龟蒙粗有田。\n阨穷身至泯，遗子独青编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3719,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"挽储华谷四首 其一","author":"卫宗武","text":"吾里文华士，平生湖海襟。\n四书穷洛学，五字逼唐吟。\n多识精能事，诸公竞赏音。\n结交犹恨晚，十载独知心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3720,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晓枕追记山梅","author":"卫宗武","text":"高眠纸帐思无尘，祇忆冰花入梦频。\n斜倚溪山独标致，明分霜月倍精神。\n瑞才六出先呈腊，香压群芳不敢春。\n今古骚翁题不尽，孤山续笔属何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3721,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钱园小隐","author":"卫宗武","text":"林园依岸曲，小隐是谁家。\n画阁虚临水，绿筠深护花。\n晴川流皓月，落景衬明霞。\n幻境无多地，幽情未易涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3722,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶成","author":"卫宗武","text":"平生梦不遇邯郸，学道求仙兴已阑。\n旋改诗编入新刻，重寻琴谱发清弹。\n不惭晚境为寒峻，翻笑当年慕热官。\n志业无成年及耄，那知身反误儒冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3723,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄兴 其一","author":"卫宗武","text":"希年逾五叹无闻，岁事从头又一新。\n徒得襄阳齿耆旧，却惭庄子号陈人。\n垂垂榆景已侵耄，冉冉花辰不减春。\n日涉丘园今已矣，北山亦足了閒身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3724,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄兴 其二","author":"卫宗武","text":"杜门世事不须闻，一任如棋局自新。\n多病不妨为寿考，馀生更喜作閒人。\n居今野处黄冠日，记昔郊行红旆春。\n须识世荣俱土苴，岂如有道善其身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3725,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春 其一","author":"卫宗武","text":"转眼韶华老，絮飘萍满塘。\n啼莺求友急，乳燕护雏忙。\n春晚犁锄闹，雨馀桑柘香。\n清和犹好在，未忍废奚囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3726,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚春 其二","author":"卫宗武","text":"飞花迷柳岸，小叶贴荷塘。\n冉冉年增老，匆匆春去忙。\n候禽喧巧哢，野卉逗馀香。\n尽日敲吟字，诗悭类括囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3727,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚眺 其一","author":"卫宗武","text":"一碧秋万顷，了无云翳侵。\n远山醒病眼，澄水瑩尘襟。\n雁落浮寒渚，乌栖认旧林。\n临流小盘薄，飞镜挂危岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3728,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"晚眺 其二","author":"卫宗武","text":"病眸犹远眺，惟恨鬓霜侵。\n稻色云连亩，桂香风满襟。\n野桥横落照，晚磬出幽林。\n牧笛数声外，明霞衬碧岑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3729,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明行役过淀湖至吴","author":"卫宗武","text":"涉泖正清明，淀湖波更平。\n雉媒空古迹，鹤唳动乡情。\n杨柳家家插，桃花处处生。\n青山俄在望，咫尺见吴城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3730,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明前有远役呈野渡","author":"卫宗武","text":"月集相期在后旬，料应主席不寒盟。\n方思北陆催行色，又为东风问客程。\n鼓楫欲随芳草去，传杯须待绿阴成。\n姑苏城外春光老，还许同舟载友生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3731,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明前呈文几","author":"卫宗武","text":"此月才过禊事修，芳辰冉冉逝如流。\n牡丹开了寒应尽，燕子归来春又休。\n衰鬓难将新绿染，颦眉岂为落红愁。\n劳生扰扰何时足，已拟抛家理钓舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3732,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明前呈南塘","author":"卫宗武","text":"晚景凄凉事事休，与波上下任沉浮。\n花辰岁岁惟添老，榆火春春不改愁。\n几曲画屏新绿暗，一川流玉落红稠。\n出门有碍家无累，水北山南负胜游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3733,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菊秋呈南塘","author":"卫宗武","text":"凄凉时序每兴嗟，那复登高似孟嘉。\n尚喜乌纱粘皓发，犹存青眼对黄花。\n百篇剩有诗堪索，九日愁无酒可赊。\n采采缅怀元亮节，不随流俗竞春华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3734,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"菊秋晓枕偶成","author":"卫宗武","text":"希年七十又加零，渐脱尘缘万事轻。\n冉冉壮心随岁减，萧萧衰鬓与霜明。\n愁倾白堕嫌无量，老对黄花更有情。\n欲写秋容到寥廓，却惭健笔欠纵横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3735,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"野步","author":"卫宗武","text":"清景浩无际，天光接水光。\n晴云侵别屿，远溆落残阳。\n岩菊幽含馥，岸花娇衒妆。\n田家竞秋报，社鼓乐村坊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3736,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜晴 其二","author":"卫宗武","text":"雨收宇宙喜清明，社舞村歌沸鼓钲。\n竹下蛛丝粘叶稳，柳间蝶粉缀绵轻。\n班班远岫髻鬟列，滟滟平川衣带横。\n候转清和景尤胜，翠林幽哢听仓庚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3737,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜晴 其一","author":"卫宗武","text":"梅雨成霖味已甘，淋漓更久恐难堪。\n风雷几昼起平陆，星斗一宵移下潭。\n万畛针芒青曳曳，千山鳞羽绿毵毵。\n老夫晴雨不关念，心醉青编维日酣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3738,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜晴","author":"卫宗武","text":"披雾出松关，行行破晓寒。\n崎岖忽平坦，迤逦复巑岏。\n霜沐林光沃，山围野色宽。\n朝曦开霁景，鸣鸟亦声欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3739,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登多景楼口占立成","author":"卫宗武","text":"新霁登多景，斯游亦快哉。\n双尖浮殿塔，千堞裹楼台。\n潋滟琉璃合，微茫图画开。\n江山仍似旧，投绂慨重来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3740,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"紫荆花","author":"卫宗武","text":"秾艳压春葩，葩成叶始芽。\n未张青羽旆，先糁紫金砂。\n谱接三荆树，名齐连萼花。\n移根向深谷，寂寞爱繁奢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":3741,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]