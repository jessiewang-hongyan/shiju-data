[{"title":"简徐判院","author":"潘柽","text":"风谊峥嵘昔未亲，正悬一榻待高人。\n当年曾接东莱话，今日宁嫌北阮贫。\n世味梅花开野水，诗情马首没黄尘。\n何时载酒从君去，灵鹫峰前借早春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29567,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题钓台","author":"潘柽","text":"蝉冠未必似羊裘，出处当时已熟筹。\n但得诸公依日月，不妨老子卧林丘。\n英雄陈迹千年在，香火空山万木秋。\n自笑黄尘吹鬓客，爱来祠下系孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29568,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠姜邦杰","author":"潘柽","text":"诗人拥节古来稀，今见梅山际盛时。\n传世篇章红锦烂，去天门户碧油垂。\n风霜气老同陈柏，亭馆花开对蜀葵。\n应记灞桥人寂寞，依然风雪撚霜髭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29569,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书姜夔昔游诗后","author":"潘柽","text":"我行半天下，未能到潇湘。\n君诗如画图，历历记所尝。\n起我远游兴，其如须毛霜。\n何以舒此怀，转轸移清商。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29570,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁莫怀旧","author":"潘柽","text":"白发将朱颜，一去几时返。\n怀哉不能寐，展转复展转。\n雀噪晓窗白，鸡鸣芳岁晚。\n梅花眼中春，故情千里远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29571,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"遇旧有感","author":"潘柽","text":"人间百寒暑，正似须臾期。\n当年同袍子，一见雪满颐。\n不惟形容变，亦复声音移。\n坐定问姓字，始省从师时。\n见此发咏叹，劳生果何为。\n不如多饮酒，满腹同鸱夷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29572,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句","author":"潘柽","text":"一树黄葵金盏侧，劝人相对醉西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29573,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"献沈詹事","author":"潘矩","text":"昔年单骑向筠州，觅得歌姬共远游。\n去日正宜供夜直，归来浑未识春愁。\n禅人尚有香囊愧，道士犹怀炭妇羞。\n铁石心肠延寿药，不风流处却风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29574,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经贾秋壑故第","author":"潘旆","text":"相业如何不到头，诸公历历颂伊周。\n梦迷葛岭酣歌夜，鬼哭樊城血战秋。\n误国正须忧大厦，覆师宁忍驾孤舟。\n木棉庵里催归魄，谁掩湖山富贵羞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29575,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"比梅三绝 其一","author":"潘桂","text":"铁肝迂叟秉刚肠，只有梅花可比方。\n任意东风染红紫，自留冰雪腊前香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29576,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"比梅三绝 其二","author":"潘桂","text":"功名高并蜀山苍，已矣封州道路长。\n岁晚凛然何所似，暗香疏影正昏黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29577,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"比梅三绝 其三","author":"潘桂","text":"千枝枯瘁剩残葩，雪虐风饕压不斜。\n人道梅花似潘子，如何自不比梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29578,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"九华山","author":"潘阆","text":"将齐华岳犹多六，若并巫山又欠三。\n好是雨馀江上望，白云堆里泼浓蓝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29579,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与道士冯德之话别","author":"潘阆","text":"一宿山房话别离，殷勤劝我酒盈卮。\n更教弟子横琴送，弹彻悲风尽泪垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29580,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋与柳赞善开宗赞善坦寇学士准宿宋拾遗白宅不见月","author":"潘阆","text":"共约中秋来看月，一轮终不见清辉。\n众人眠后唯孤坐，翻忆无云宿翠微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29581,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋月","author":"潘阆","text":"待月中秋上古城，迥然光掩别宵明。\n野人望久翻惆怅，无奈浮云灭又生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29582,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书诗卷末","author":"潘阆","text":"一卷诗成二十年，昼曾忘食夜忘眠。\n莫言不及相如赋，谁敢高吟汉帝前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29583,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句：岁除题王文甫家桃符","author":"苏轼","text":"门大要容千驷入，堂深不觉百男欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29584,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过华山","author":"潘阆","text":"高爱三峰插太虚，掉头吟望倒骑驴。\n旁人大笑从他笑，终拟移家向此居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29585,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"呈钱塘知府薛谏议","author":"潘阆","text":"再到钱塘眼暂清，骑驴看月又南行。\n可怜一片西湖水，不得垂纶老此生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29586,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"到钱塘却寄姑苏太守","author":"潘阆","text":"姑苏太守义何长，东泛仙舟已不忘。\n更借洞庭湖上月，数宵相送到钱塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29587,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"泊禹祠","author":"潘阆","text":"禹庙高高万木齐，蟾蜍影里月光低。\n出中不惯闻寒漏，一夜猿惊与鸟啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29588,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金陵禁林有感","author":"潘阆","text":"六代繁华难重问，此时兴废动吟情。\n空流一带秦淮水，朝暮惟闻鸣咽声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29589,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏书王文甫家","author":"苏轼","text":"湖上秋风聚萤苑，门前春浪散花洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29590,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送冯尊师德之出长安","author":"潘阆","text":"浩浩霜风万木寒，高吟大醉出长安。\n杖头一卷金丹诀，尘世何人借得看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29591,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"书璿公房牡丹 寺中闻说牡丹花，多少人争耳傍誇。潦倒参军来看晚，数枝已谢病僧家 送成库部肃建安监税","author":"潘阆","text":"万树青青带雨寒，离亭相别泪阑干。\n莫将便作无情物，亦待抽身入建安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29592,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻陈贽郎中下世","author":"潘阆","text":"有家数口寄伊川，孤宦东西二十年。\n见说葬时无一物，空留满箧旧文编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29593,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句：联","author":"苏轼","text":"人言卢祀是奸邪，我觉魏公真妩媚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29594,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"旅舍秋夕书怀","author":"潘阆","text":"边鸿过尽背枕卧，弟侄无书忧胆破。\n蛩声更苦不忍闻，半夜起来塞耳坐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29595,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句：戏村校书七十买妾","author":"苏轼","text":"侍者方当而立岁，先生已是者希年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29596,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离滁阳","author":"潘阆","text":"长亭黄叶正纷纷，一曲骊歌酒十分。\n须信滁阳人有意，满城来送散参军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29597,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宿灵隐寺","author":"潘阆","text":"绕寺千千万万峰，满天风雪打杉松。\n地炉火暖黄昏睡，更有何人似我慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29598,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄石隐之","author":"潘阆","text":"独上危楼返照间，乱鸦群鸟噪回还。\n故人岁暮在何处，空见千山与万山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29599,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢寇员外准见示诗卷","author":"潘阆","text":"一轴新诗意转深，几回看了又重寻。\n最怜积水浮秋汉，閒望沧溟尽日吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29600,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题资福院石井","author":"潘阆","text":"炎炎畏日树将焚，却恨都无一点云。\n强跨蹇驴来得到，皆疑渴杀老参军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29601,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题萧山祇园寺门","author":"潘阆","text":"门掩多年生绿苔，想师心地似寒灰。\n劳心扰扰休来此，我是閒人尚不开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29602,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠吴处士棋","author":"潘阆","text":"昔日长饶国手先，如今多病卧林泉。\n有时閒倚青松笑，犹忆曾输一著玄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29603,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠林处士逋","author":"潘阆","text":"云剪乌纱雾剪衣，存神养气语还稀。\n人人尽唤孙思邈，只恐身轻白日飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29604,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上李学士","author":"潘阆","text":"名场欲独立，一念一心寒。\n白日升天易，明时取仕难。\n家园半牢落，须发渐衰残。\n试把平生业，来投作者看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29605,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与人游会润州金山寺","author":"潘阆","text":"浮生难会此，此寺绝尘埃。\n容易莫言去，等閒争得来。\n江声寒若吼，山色翠如堆。\n自是忘机者，凭阑不忍回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29606,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"与张覃秀才邺中途次言别","author":"潘阆","text":"南北各何之，重来宁有期。\n相将行数里，欲别立多时。\n野店人烟迥，前村草木衰。\n只应今夜梦，未苦远分离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29607,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"句：戏人","author":"苏轼","text":"有甚意头求富贵，没些巴鼻便奸邪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29608,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"北高峰塔","author":"潘阆","text":"北高峰上塔，竟上最高层。\n尝谓人难到，何当我独登。\n天香闻不断，海月见微棱。\n懒下红尘路，重来恐未能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29609,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"瓜州临江亭留题","author":"潘阆","text":"谁构危亭已半空，野人时得恣疏慵。\n閒观扬子江心浪，静听金山寺里钟。\n醉卧岂能妨燕雀，狂吟争法劝鱼龙。\n夜来雨歇蛙声乱，忆著嵩阳千万峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29610,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"老翁井","author":"苏洵","text":"井中老翁误年华，白沙翠石公之家。\n公来无踪去无迹，井面团团水生花。\n翁今与世两何与，无事纷纷惊牧竖。\n改颜易服与世同，无使世人知有翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29611,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自诸暨抵剡 其四","author":"潘阆","text":"出得云门路，风悽日夕曛。\n船撑鉴湖月，路指沃州云。\n山色周遭见，溪流屈曲分。\n一觞还一咏，谁是右将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29612,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自诸暨抵剡 其二","author":"潘阆","text":"夷犹双桨去，暮不辨东西。\n夕照偏依树，秋光半落溪。\n风高一雁小，云薄四天低。\n莽荡孤帆卸，水村杨柳堤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29613,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自诸暨抵剡 其一","author":"潘阆","text":"莫叹尘泥汩，且图山水游。\n双峰天姥翠，一舸剡溪秋。\n不见戴安道，有怀王子猷。\n西风无限意，尽属钓鱼舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29614,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"舟中自吴之越寄润州柳侍禦开杨博士迈","author":"潘阆","text":"两岸山光合，况当三月天。\n好花红照水，芳草绿随船。\n货药村桥醉，收帆野渡眠。\n因思二朝客，同泛恐无缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29615,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蜀僧去麈","author":"苏轼","text":"十年读《易》费膏火，尽日吟诗愁肺肝。\n不解丹青追世好，欲将芹芷荐君盘。\n谁为善相宁嫌瘦，复有知音可废弹。\n拄杖挂经须倍道，故乡春蕨已阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29616,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人回文五首 其一","author":"苏轼","text":"红窗小泣低声怨，永夕春寒斗帐空。\n中酒落花飞絮乱，晓莺啼破梦匆匆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29617,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"叙事答所知","author":"潘阆","text":"久客向天末，唯将鸾鹤群。\n盈亏频叹月，舒捲几怜云。\n有志思光国，无才可佐君。\n知音时见赠，应达圣朝闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29618,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"春日对酒书事","author":"潘阆","text":"车马不暂驻，年光如泻波。\n人间欢乐少，陌上别离多。\n往事只如此，浮生终若何。\n花前一尊酒，得失且高歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29619,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"癸未岁秋七月祷禹庙","author":"潘阆","text":"万古稽山下，森森大禹祠。\n幽人来暗祷，灵魄望潜知。\n帝虑河频决，民忧业旋移。\n自惭无异策，载拜泪双垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29620,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日登楼客次怀张覃进士","author":"潘阆","text":"闻说飘零亦异乡，登楼吟望益悲凉。\n当时欲别言难尽，他日相逢话更长。\n蝉噪水村千万树，雁过云岫两三行。\n明朝策蹇还无定，空倚危栏到夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29621,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋日题琅琊山寺","author":"潘阆","text":"岩下多幽景，且无尘事喧。\n钟声晴彻郭，山色晓当门。\n深洞藏泉脉，悬崖露树根。\n更期来此宿，绝顶听寒猿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29622,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赴滁州散参军途中书事","author":"潘阆","text":"微躯不杀谢天恩，容养疏慵世未闻。\n昔日已为閒助教，今朝又作散参军。\n高吟瘦马冲残雪，远看孤鸿入断云。\n到任也应无别事，愿将清俸买香焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29623,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻高舍人锡下世","author":"潘阆","text":"早掌纶言世尽知，岂期谪宦至于斯。\n生前是客能投卷，死后何人为撰碑。\n才佞万端应已矣，文章千古恐无之。\n野夫旧句多蒙赏，昨日月思泪暗垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29624,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏日宿西禅院","author":"潘阆","text":"此地绝炎蒸，深疑到不能。\n夜凉如有雨，院静若无僧。\n枕润连云石，窗明照佛灯。\n浮生多贱骨，时日恐难胜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29625,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"钱塘秋夕旅舍感怀","author":"潘阆","text":"永夜不能寐，閒门懒复开。\n片心生万绪，孤枕转千回。\n败叶声如雨，狂风响似雷。\n更堪江上笛，历历有馀哀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29626,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄会稽仲休山人","author":"潘阆","text":"近携琴鹤游东越，曾接谈谐气味深。\n佛意已知师达了，儒书却为俗披寻。\n稽山有雪寒凝骨，鉴水无风冷彻心。\n别后相思向谁说，只应霜鬓暗相侵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29627,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人回文五首 其二","author":"苏轼","text":"同谁更倚闲窗绣，落日红扉小院深。\n东复西流分水岭，恨兼愁续断弦琴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29628,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄赠柳殿院开授崇仪使赴边上","author":"潘阆","text":"从来长见说兵机，今日君恩志岂违。\n骢马不骑骑铁马，绣衣休挂挂戎衣。\n雄师已听心皆伏，丑虏将闻魄尽飞。\n应笑苦吟头白者，二南章句转衰微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29629,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"望湖楼上作","author":"潘阆","text":"望湖楼上立，竟日懒思还。\n听水分他浦，看云过别山。\n孤舟依岸静，独鸟向人閒。\n回首重门闭，蛙鸣夕照间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29630,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"维扬秋日牡丹因寄六合县尉郭承范","author":"潘阆","text":"绕栏忽见思傍徨，造化功深莫可量。\n稼艳算无三月盛，残红更向九秋芳。\n万家珠翠还争赏，一郡笙歌又是狂。\n惆怅东篱下黄菊，有谁来折泛瑶觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29631,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寓泊浙江寄汉阳孙迈郎中","author":"潘阆","text":"维扬相别后，十载浙江居。\n气概贫犹在，颠狂老渐疏。\n已凭天柱客，曾寄汉阳书。\n近见人来说，才华患有馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29632,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游龙虎山赠天师 其二","author":"潘阆","text":"铁鞋踏破几山行，惟此山行越样清。\n顾我尘中一簪绂，任他世上几公卿。\n分安淡泊全真性，身厌轻肥已半生。\n汉鼎馀丹今在否，愿须七粒守三彭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29633,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"落叶","author":"潘阆","text":"片片落复落，园林渐向空。\n几番经夜雨，一半是秋风。\n静拥莎阶下，閒堆藓径中。\n谷松与岩桧，宁共此时同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29634,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"落花","author":"潘阆","text":"花残雨又风，飘紫复飘红。\n不到三春尽，都经数夜空。\n绕阑仍聚散，逐水尚西东。\n可惜多情蝶，徘徊晚照中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29635,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"阙下留别孙丁二学士归旧山","author":"潘阆","text":"名利路万辙，我来意如何。\n红尘三尺深，中有是非波。\n波翻几潜没，来者犹更过。\n归去感知泪，永洒青松柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29636,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和人回文五首 其三","author":"苏轼","text":"寒信风飘霜叶黄，冷灯残月照空床。\n看君寄忆传文锦，字字萦愁写断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29637,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"樽前勉兄长","author":"潘阆","text":"一家久寄浙江滨，倏忽如今二十春。\n须信百年都似梦，莫嗟万事不如人。\n樽中有酒何妨醉，箧里无金未是贫。\n但看故乡荣达者，算来多葬北邙尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29638,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋无月","author":"潘阆","text":"西风妒秋月，浮云重叠生。\n一夕不见光，双目如失明。\n立恐疾足折，坐觉秋愁抱盈。\n况当百虫苦，绕阶千万声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":29639,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]