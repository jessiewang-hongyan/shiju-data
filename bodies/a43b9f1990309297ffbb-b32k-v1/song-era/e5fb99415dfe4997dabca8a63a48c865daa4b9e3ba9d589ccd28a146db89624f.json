[{"title":"岁晚书怀","author":"陆游","text":"早见龙翔上太清，即今孤宦老山城。\n灵丹不解换凡骨，薄命枉教生太平。\n积雪楼台增壮观，近春鸟雀有和声。\n如山吏牍何时了，惆怅西窗晚照明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁晚书怀","author":"陆游","text":"残岁堂堂去，新春鼎鼎来。\n梦移乡国近，酒挽壮心回。\n暖律初催柳，晴光并上梅。\n东湖有归日，衰抱得频开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁晚怀故人","author":"陆游","text":"衰髯白尽无添处，病骨癯然欲折时。\n客抱琴来聊瀹茗，吏封印去又哦诗。\n山横城上势如压，角动楼头声正悲。\n零落断鸿书不到，岁残何以慰相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁晚怀镜湖旧隐慨然有作","author":"陆游","text":"公府还家鬓未秋，镜湖南畔决归休。\n读书精舍岂轻出，采药名山成远游。\n白堕兴来犹小醉，青精材足又何求。\n俗间毁誉惟堪笑，常隘韩公咎斗牛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁晚幽兴四首 其一","author":"陆游","text":"梅出疏篱柳拂池，流年已迫早春时。\n壮心卓荦犹欺酒，老业呻吟未废诗。\n眼暗观书如棘沥，齿疏嘬饭似牛呞。\n风炉欲试苍鹰爪，自向林间拾堕枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁晚幽兴四首 其四","author":"陆游","text":"短鬓元知不久青，况开九帙数馀龄。\n全家共保一忍字，累世相传三住铭。\n时泛孤舟过梅市，却穿双屩上兰亭。\n拥炉莫恨无僧在，满院松风要细听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁晚幽兴四首 其二","author":"陆游","text":"残年欲遂迫期颐，追数朋俦死已迟。\n卜冢治棺输我快，染须种齿笑人痴。\n野梅堕地草生后，街柳拂鞍冰泮时。\n满眼云山不须买，剩倾新酿赋新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁晚幽兴四首 其三","author":"陆游","text":"万里风波行路难，君恩尚许缀祠官。\n中庭郁郁药苗长，绝壁飕飕松吹寒。\n泥巷有人寻杜甫，雪庐无吏问袁安。\n清晨对镜增幽致，龟屋新裁二寸冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁晚盘尊索然戏书","author":"陆游","text":"经年薄宦客桐庐，市邑萧然一物无。\n名酒不来惟饮湿，长鱼难觅且焚枯。\n支离鹤骨寒添瘦，宛转龟肠夜自呼。\n更与儿曹同一笑，灯前短褐拆天吴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮","author":"陆游","text":"小筑幽栖与拙宜，读书写字伴儿嬉。\n已无叹老嗟卑意，却喜分冬守岁时。\n羹?芳鲜新弋雁，衣襦轻暖自缫丝。\n农家岁暮真堪乐，说向公卿未必知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮","author":"陆游","text":"案间官历喜更端，鬓畔罗幡巧耐寒。\n筛辣捣香篘腊酒，染红丝绿簇春盘。\n衰容未觉馀年迫，佳日犹思一笑欢。\n太息儿童痴过我，乡傩虽陋亦争看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮","author":"陆游","text":"半生浪走跨秦吴，白首还如筮仕初。\n冻芋浊醪邀里巷，昏烟湿雪暗郊墟。\n穷空敢恨寒无褐，忧患元因出有车。\n笑掩陈编聊自慰，古来富贵羡樵渔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮","author":"陆游","text":"岁暮风霜惨，村深草棘稠。\n力衰行每蹇，衣薄鼻多鼽。\n久矣当长往，悠然尚小留。\n儿童报炊熟，得饱且忘忧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮","author":"陆游","text":"吴中寒气薄，岁暮亦和风。\n移树来村北，寻僧渡港东。\n露葵收半绿，霜稻杵微红。\n一饱无馀念，吾生正不穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮书怀二首 其一","author":"陆游","text":"世事从来不可常，把茆犹幸得深藏。\n床头酒瓮寒难熟，瓶里梅花夜更香。\n薄命元知等蝉翼，畏途何处不羊肠。\n诗成读罢仍无用，聊满山家骨董囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮书怀二首 其二","author":"陆游","text":"忆昔初辞鹓鹭行，慨然誓墓老耕桑。\n蓼汀夜宿梦魂爽，梅坞暮归襟袖香。\n穷巷每多闲日月，小儿时诵古文章。\n吾侪穷死从来事，敢变胸中百鍊刚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮出游","author":"陆游","text":"残历消磨无半纸，一年光景又成非。\n瓦沟雪水滴欲尽，江路梅花开尚稀。\n竹院篝灯留度宿，旗亭誇酒劝无归。\n此身自笑知何似，万里辽天一鹤飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮老怀","author":"陆游","text":"粥美忘流啜，灯孤伴独吟。\n衾寒知夜艾，身痛卜天阴。\n薪炭常忧绝，杯觞不厌深。\n故人今已矣，三叹有遗音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮作","author":"陆游","text":"鱼贯长条兔卧盘，往来聊续里闾欢。\n旧符又拟新年换，残历都无半纸看。\n梅影横斜春尚浅，角声悲壮夜将阑。\n坚顽敢望今如许，戏说期颐强自宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮怀张季长","author":"陆游","text":"已迫桑榆景，况逢梅柳时。\n功名终自误，老病独如期。\n醉眼嫌天迮，孤吟觉鬼悲。\n唐安在何许，无字寄相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮贫甚戏书","author":"陆游","text":"阿堵元知不受呼，忍贫闭户亦良图。\n曲身得火才微直，槁面持杯祇暂朱。\n食案阑干堆苜蓿，褐衣颠倒著天吴。\n谁知未减粗豪在，落笔犹能赋两都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮贫甚戏作","author":"陆游","text":"得米还求涧底薪，始知天地有穷人。\n年开八秩宁赊死，官及三儿不救贫。\n药尽无如医偃蹇，囊空那办酒逡巡。\n柳条萱草添愁思，不似寻常见早春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮独酌感怀","author":"陆游","text":"明时频忝武夷仙，俯仰人间只自怜。\n总角回思如昨日，挂冠过限已三年。\n病多晴日思行药，睡少清宵学坐禅。\n更叹衰孱不禁酒，地黄一盏即颓然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮感怀","author":"陆游","text":"征尘十载暗戎衣，虚负名山采药期。\n少日覆毡曾草檄，即今横槊尚能诗。\n昏昏杀气秋登陇，飒飒飞霜夜出师。\n会有英豪能共此，镜中未用叹吾衰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮遣兴二首 其一","author":"陆游","text":"昔慕骚人赋远游，放怀蜀栈楚山秋。\n橘中尚可著四老，海外谁云无九州。\n薄酒时须浇舌本，闲愁莫遣上眉头。\n幅巾短褐吾差便，实厌衣冠裹沐猴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"岁暮遣兴二首 其二","author":"陆游","text":"病著愁侵并不支，孤村况遇岁残时。\n水轩客散成舒啸，山寺僧来得剧棋。\n铜鸭香生风袅袅，竹鸡声断雨丝丝。\n新诗煅炼功何似，问著衰翁自不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"年光","author":"陆游","text":"无赖年光逐水流，人间随处送悠悠。\n千帆落浦湘天晚，孤笛吟风鄠县秋。\n小市莺花时痛饮，故宫禾黍亦闲愁。\n久留只恐惊凡目，又向西凉上酒楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"并山东南闲步至野人吴氏居乃归","author":"陆游","text":"信步闲行遍四邻，拥篱老稚看纶巾。\n人随世换朋侪少，志与年衰感慨频。\n梅送冷香横雪岸，雁翻孤影下烟津。\n丰年何地酬君赐，剩向旗亭作醉人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"庄器之作招隐阁项平父诸人赋诗予亦继作","author":"陆游","text":"诸公共赋反招隐，细字斜行肯见传。\n语到淮南小山作，人如江左永和年。\n一窗萝月禁春瘦，万壑松风撼昼眠。\n我亦尚嫌林谷浅，因君更拟斸云烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延和殿退朝口号二首、 其一","author":"陆游","text":"雨馀未肯放朝暾，穿仗恭承圣主恩。\n清跸传声徐御殿，紫衣引拜许龙门。\n徘徊漫结尧阶恋，零落难招楚泽魂。\n归去犹堪誇里巷，桐江新赐两朱轓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"延和殿退朝口号二首、 其二","author":"陆游","text":"十年短棹乐沧波，强著朝衫弃钓蓑。\n才薄何堪试冯翊，恩深犹许对延和。\n空墙烟柳遥迎马，辇路春泥欲溅靴。\n莫恨此身衰病去，同时朝士久无多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"异梦","author":"陆游","text":"山中有异梦，重铠奋雕戈。\n敷水西通渭，潼关北控河。\n凄凉鸣赵瑟，慷慨和燕歌。\n此事终当在，无如老死何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戍卒说沉黎事有感","author":"陆游","text":"亭障曾无阅岁宁，频闻夷落犯王灵。\n孤城月落冤魂哭，百里风吹战血腥。\n瘴重厌看茅叶赤，春残不放柳条青。\n焦头烂额知何补，弭患从来贵未形。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏书燕几二首 其二","author":"陆游","text":"饱知此手合锄犁，剩喜东归老故栖。\n僧乞新诗题院壁，人扶半醉下楼梯。\n少通朝籍谗销骨，晚畏京尘悔噬脐。\n尚有远游心未死，梦携猿鹤渡敷溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏书燕几二首 其一","author":"陆游","text":"平生万事付天公，白首山林不厌穷。\n一枕鸟声残梦里，半窗花影独吟中。\n柴荆日晚犹深闭，烟火年来只仅通。\n水品茶经常在手，前身疑是竟陵翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏用方外语示客","author":"陆游","text":"红粟青钱一扫空，笊篱行卖学庞翁。\n身居本地风光里，愁掷它方世界中。\n剩欲剧谈明不二，谁能太息赏无同。\n踞床一喝君闻否，三日犹应觉耳聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏作贫诗二首 其一","author":"陆游","text":"垂老贫弥甚，虚教遇太平。\n灶闲无马穴，釜冷有鱼生。\n妾病常停织，儿饥屡辍耕。\n痴顽惟此老，未废浩歌声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏作野兴六首 其三","author":"陆游","text":"久已挂吾冠，江边岁又残。\n心惟无愧怍，身取不饥寒。\n小酌三杯足，安居一席宽。\n东冈有泉脉，携杖试寻看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏作野兴六首 其二","author":"陆游","text":"扰扰亭中客，悠悠局上棋。\n所遭元有命，自苦竟何为。\n冯衍深尤妇，陶潜过责儿。\n奇文虽可贵，寱语岂非痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏作野兴六首 其一","author":"陆游","text":"省事贫犹富，宽怀客胜家。\n充虚一箪饭，遣睡半瓯茶。\n有兴闲垂钓，逢欢醉插花。\n皋桥亦可死，处处是生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏作野兴六首 其四","author":"陆游","text":"今年病微减，耕稼乐江村。\n灯火耿破屋，歌呼围老盆。\n常时但葵苋，盛馔有鸡豚。\n客散茅檐寂，蹒跚自闭门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏作野兴六首 其五","author":"陆游","text":"出户语邻叟，与卿同一愚。\n逢人即如旧，临事不胜迂。\n发白花犹插，囊空酒亦沽。\n回思五十载，何处有荣枯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏作野兴六首 其六","author":"陆游","text":"有酒皆堪醉，无山不可庐。\n遂初成近赋，孤愤悔前书。\n湘寺分经帙，庐山寄药锄。\n江头霜叶满，诗兴属骑驴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏咏山阴风物","author":"陆游","text":"万里秦吴税驾迟，还乡已叹鬓成丝。\n城边绿树山阴道，水际朱扉夏禹祠。\n项里杨梅盐可彻，湘湖莼菜豉偏宜。\n图经草草常堪恨，好事他年采此诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏咏山家食品","author":"陆游","text":"牛乳抨酥瀹茗芽，蜂房分蜜渍棕花。\n旧知石芥真尤物，晚得蒌蒿又一家。\n疏索乡邻缘老病，团栾儿女且喧哗。\n古人不下藜羹糁，斟酌龟堂已太奢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏咏西州风土","author":"陆游","text":"衍沃绵千里，融和被四时。\n蚕丛角歌吹，石室盛书诗。\n绿树藏渔市，清江绕佛祠。\n吾行更堪乐，载酒上蟆颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏咏村居二首 其一","author":"陆游","text":"歌起陂头正插秧，梯斜篱外又剶桑。\n日长处处莺声美，岁乐家家麦饭香。\n林杏半丹禁宿雨，丛萱自敛避斜阳。\n北窗合是羲皇上，巳置临风八尺床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏咏闲适","author":"陆游","text":"暮秋风雨暗江津，不下书堂已过旬。\n鹦鹉笼寒晨自诉，狸奴毡暖夜相亲。\n典衣旋买修琴料，叩户时闻请药人。\n说与乡邻当贺我，死前长作自由身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏咏闲适三首 其一","author":"陆游","text":"钞书字细眼犹明，捣药声清疾渐平。\n桐叶雨边寻断梦，菊花香里散馀酲。\n人间荣辱知难到，纸上兴亡看亦轻。\n惟恨暮年交旧少，满怀情话向谁倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏咏闲适三首 其二","author":"陆游","text":"剡曲稽山是故乡，人言景物似潇湘。\n三升花露春壶满，八尺风漪午枕凉。\n树合绿阴山鹊闹，盆镌紫石水栀香。\n回思乌帽京尘客，始觉幽居白日长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏咏闲适三首 其三","author":"陆游","text":"涉世心知百不能，闭门懒出病相仍。\n箪瓢味美如烹鼎，邻曲人淳近结绳。\n半颗鸦残墙外杏，一枝鹊袅涧边藤。\n萧然扫尽弹冠兴，敢为诗情望武陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏遣老怀五首 其三","author":"陆游","text":"儿时万死避胡兵，敢料时清毕此生。\n已迫九龄身愈健，熟观万卷眼犹明。\n深深小坞梅初动，潋潋清溪水欲平。\n安得飘然从此逝，缑山风月听吹笙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏遣老怀五首 其一","author":"陆游","text":"平生碌碌本无奇，况是年垂九十时。\n阿囝略如郎罢老，稚孙能伴太翁嬉。\n花前骑竹强名马，阶下埋盆便作池。\n一笑不妨闲过日，叹衰忧死却成痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏遣老怀五首 其二","author":"陆游","text":"清羸正怯倚阑干，纱帽还惊半指宽。\n日漏云端才欲暖，风催梅信又成寒。\n寻僧竹院逢茶熟，引鹤溪桥及雪残。\n只道捐书差似达，庖丁数纸尚须看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏遣老怀五首 其四","author":"陆游","text":"旧袭家风号散人，晚承恩诏赐闲身。\n放狂泥酒都忘老，厚价收书不似贫。\n霜晓方惊群木脱，春晴又喜一花新。\n先生偶出人难遇，陌上争先看角巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏题酒家壁三首 其二","author":"陆游","text":"送了春归又送秋，人间随处寄悠悠。\n百年此际成遗老，万里当时赋远游。\n笔力日衰惭阵马，江天岁晚狎冥鸥。\n清狂自笑无时歇，又犯新寒上市楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏题酒家壁三首 其三","author":"陆游","text":"朋旧存亡寂不闻，年年江海怆离群。\n时平酒价贱如水，病起老身闲似云。\n饱食每惭荒旧学，后生谁可付斯文。\n案头清镜尘昏尽，残发知添白几分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏题酒家壁三首 其一","author":"陆游","text":"漫道江南倚寺楼，岂如烟雨弄扁舟。\n并刀不剪清愁断，楚练难縻白日留。\n湖上采菰甘似蜜，街头买酒滑如油。\n金丹九转何时毕，且对梅花一醉休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏题僧庵","author":"陆游","text":"致虚守静气常全，家付儿孙命委天。\n梦事只堪高卧看，危途谁较疾行先。\n独辕短棹聊乘兴，野草幽花自斗妍。\n数字漫留僧壁去，与身闲作后身缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"戏赠酒榼","author":"陆游","text":"老去卧湖海，白发朝朝新。\n赖有小道士，时来中圣人。\n形模虽简古，风味绝清真。\n何当秋雨夕，倾倒见情亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"成都大阅","author":"陆游","text":"千步毬场爽气新，西山遥见碧嶙峋。\n令传雪岭蓬婆外，声震秦川渭水滨。\n旗脚倚风时弄影，马蹄经雨不沾尘。\n属櫜缚裤毋多恨，久矣儒冠误此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"成都书事二首 其一","author":"陆游","text":"剑南山水尽清晖，濯锦江边天下稀。\n烟柳不遮楼角断，风花时傍马头飞。\n芼羹笋似稽山美，斫脍鱼如笠泽肥。\n客报城西有园卖，老夫白首欲忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"成都岁暮始微寒小酌遣兴","author":"陆游","text":"革带频移纱帽宽，茶铛欲熟篆香残。\n疏梅已报先春信，小雨初成十月寒。\n身似野僧犹有发，门如村舍强名官。\n鼠肝虫臂元无择，遇酒犹能罄一欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7611,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"扫除小园未竟归卧","author":"陆游","text":"竹叶扫仍落，莎根锄更生。\n阴阳常代谢，今昔各施行。\n勋业须时至，衰荣忌力争。\n径归差省事，高枕听蝉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7612,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"早发奴寨","author":"陆游","text":"暖彻衣篝蜡炬明，邻鸡喔喔促残更。\n丈夫虽有四方志，客子终悲千里行。\n月落龙蛇蟠木影，山空风雨起滩声。\n上车莫恨晨霜冷，又得修途一日晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":7613,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]