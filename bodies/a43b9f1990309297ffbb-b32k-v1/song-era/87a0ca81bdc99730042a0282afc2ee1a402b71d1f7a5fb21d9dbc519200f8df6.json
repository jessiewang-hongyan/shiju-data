[{"title":"次子都兄借杨凝式帖韵 其二","author":"李洪","text":"前朝惟有杨虚白，心画心声独擅功。\n身絷南冠怀洛寺，恨无北客话高嵩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62113,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次子都兄借杨凝式帖韵 其三","author":"李洪","text":"杨李书名五季间，江南劲笔俭而寒。\n临摹更陋唐人笔，不脱兰亭旧界阑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62114,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池中双鸭甚驯笼赠古灵陈仲 其一","author":"李洪","text":"双凫荡漾小池幽，荷叶田田两见秋。\n却恨主人官满去，荒陂野水狎轻鸥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62115,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"池中双鸭甚驯笼赠古灵陈仲 其二","author":"李洪","text":"饭馀临槛数龟鱼，蛙黾跳浪亦任渠。\n笼寄双凫古灵去，不因羽客换鹅书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62116,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红蕉","author":"李洪","text":"旧馆彤云谁解赋，朱光绿润感遗芳。\n词人自古伤流落，安得移根贡玉堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62117,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纪行杂诗 其五","author":"李洪","text":"高桅一一上滩船，流汗赪肩尽日牵。\n笑忆太湖波上宿，云涛无际欲粘天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62118,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纪行杂诗 其三","author":"李洪","text":"蒲帆风驶送行舟，篷底哦诗相棹讴。\n三老相呼兴不浅，溪回山拥近严州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62119,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纪行杂诗 其六","author":"李洪","text":"石罅飞泉鸣佩玉，滩头怒石响惊雷。\n故人相见应相笑，爱底微官触暑来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62120,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纪行杂诗 其一","author":"李洪","text":"鸬鹚源畔数人家，匼匝青罗布障遮。\n胥口山前沽酒市，钓船相逐买鱼虾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62121,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"纪行杂诗 其四","author":"李洪","text":"支流二水绕山城，潇洒桐庐旧得名。\n好在鸟笼山霭里，眼生诗句易诗成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62122,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"老人亭","author":"李洪","text":"梦中已识雪髯翁，线去丝来信不通。\n觌面相呈了无得，岩前万窍自号风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62123,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过分水岭","author":"李洪","text":"江南山尽处，两山如石门。\n溪流湍激雪，残日雨犹存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62124,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过张司空庙","author":"李洪","text":"昔人博物岂虚传，自斸龙泉古狱边。\n今代司空应见惯，斗间何用气冲天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62125,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"过婺港","author":"李洪","text":"已辞悍石严滩险，稍快平波婺港行。\n夜宿喜逢渔酒市，南风拂面月胧明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62126,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事 其一","author":"李洪","text":"宝策欢传万岁声，涂山执玉萃华缨。\n独怜太史周南滞，不预尧阶贺太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62127,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"即事 其二","author":"李洪","text":"苒苒残年白发新，可怜蹭蹬老修鳞。\n坐观沟渎寻常困，未使扬鬐化若神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62128,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"含晖亭","author":"李洪","text":"渺渺曦车旸谷升，东封日观未容登。\n山僧更约中宵看，列炬煌煌现圣灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听雨轩四首 其四","author":"李洪","text":"天寒病鸭守冰池，折苇枯荷霰雪飞。\n不觉哦诗成独立，南枝的皪露春机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听雨轩四首 其三","author":"李洪","text":"听风听雨江湖上，一叶轻舟舣钓沙。\n暂却鹜行容退食，秋声先已到枯葭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听雨轩四首 其二","author":"李洪","text":"脱帽风檐迎晚吹，催诗急雨唤轻雷。\n祗应荷气薰人醉，不用轮囷象鼻杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"听雨轩四首 其一","author":"李洪","text":"春到池塘草自青，飞花时度破窗棂。\n恨无好句追颜谢，赖有鸣蛙鼓吹听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"饮桂香茶简翁及甫","author":"李洪","text":"午睡初醒缓注汤，一瓯清露沃诗肠。\n疑君昔日探蟾窟，犹带天边桂子香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鸡菜岭","author":"李洪","text":"烟雨濛濛不湿衣，春风欺客逞寒威。\n篮舆无著新愁处，小酌村醪款竹扉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"周尧夫示秋怀诗然公方为贵恙所挠因以箴之","author":"李洪","text":"伐性蛾眉贾祸长，何如铅鼎养中央。\n应怜剌剌出门语，苦怨寥寥秋夕凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和人 其二","author":"李洪","text":"池面粼粼已送凉，小窗危坐听风篁。\n不应尚厌秋来热，已减炎天五刻长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和人 其四","author":"李洪","text":"夕阳返照树头明，天外虹收放晚晴。\n洗尽尘埃初雨过，一蝉飞入绿槐鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和人 其三","author":"李洪","text":"庭前槐树绿阴阴，静听玄蝉尽日吟。\n枕簟虚凉清梦境，了无俗物动禅心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和人 其一","author":"李洪","text":"杨柳疏疏已报秋，月华如水浸阶头。\n惜无画手王摩诘，貌取中宵一段愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和人松江 其二","author":"李洪","text":"去年春尽西湖上，把酒看山听涧泉。\n今日松江烟浪里，平分诗思入渔船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和子永韵","author":"李洪","text":"林樾交阴闹雨鸠，滞留已敝黑貂裘。\n却思把钓江湖上，万仞苍崖插碧流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和寺丞叔赐对亲奉玉音叙及家世韵 其一","author":"李洪","text":"心存魏阙江湖远，归觐重瞳日月明。\n遥忆五伦思一见，岂询宣室鬼神情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和寺丞叔赐对亲奉玉音叙及家世韵 其二","author":"李洪","text":"乌台凤沼承亲擢，尚有孤忠简圣明。\n大雅一门时鲜俪，急难尤切在原情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和林尚善读子云传梦得诗韵 其二","author":"李洪","text":"君子惟宜以懿文，后生轻进附佥人。\n竹枝空有蛮歌怨，争似当年略转钧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和林尚善读子云传梦得诗韵 其一","author":"李洪","text":"尚白宁堪众楚咻，井湄瓶碎愈增愁。\n后人归罪美新作，莫污萧郎文选楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郑康道探梅十绝句 其一","author":"李洪","text":"国艳冰姿非世妆，忍教腊雪苦韬藏。\n昔年曾醉万松岭，尚友诗人苏与黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郑康道探梅十绝句 其六","author":"李洪","text":"石肠底事斗清新，赋就摛华万象春。\n谁知袖手苦吟客，中有筑岩和鼎人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郑康道探梅十绝句 其九","author":"李洪","text":"瑟瑟清波溪涧寒，属联诗笔不当悭。\n请君更舣菁山棹，万斛愁侵山复山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郑康道探梅十绝句 其十","author":"李洪","text":"吟到梅开醉不休，十诗刻烛写蝇头。\n须知老匠能雕句，月仄金盆独倚楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郑康道探梅十绝句 其五","author":"李洪","text":"夜寒池面结冰花，谁识吴姬张丽华。\n待到黄昏斜月吐，暗香疏影属林家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郑康道探梅十绝句 其七","author":"李洪","text":"多病年来懒作诗，燃萁何敢衒才奇。\n探梅技痒撩幽梦，只有清香是己知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郑康道探梅十绝句 其四","author":"李洪","text":"独秀娟然寄一枝，江南岁岁腊前开。\n缀椒未见封条雪，应误插花晴昊来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郑康道探梅十绝句 其三","author":"李洪","text":"雪后苍茫立水滨，香肤不粟自生温。\n南枝钟美知春早，未使蛮烟蜑雨昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郑康道探梅十绝句 其二","author":"李洪","text":"学诗少日赋梅花，诗老忘言借齿牙。\n媟语淫言漫元白，单传衣钵勿矜誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和郑康道探梅十绝句 其八","author":"李洪","text":"万木凋枯一笑春，未应兰芷伴骚人。\n东风桃李皆奴仆，我辈论文未厌频。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"国一禅师塔","author":"李洪","text":"蓬径安禅五百年，六时钟呗震诸天。\n我来不问安心法，露柱风林说炽然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"坦庵僧名崇彼","author":"李洪","text":"万象森罗具一尘，小庵花木四时春。\n客来相对默无语，亲见毗耶彼上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜坐","author":"李洪","text":"驱蚊无术但抓肤，灯火无因暂映书。\n半夜西风吹急雨，芭蕉声响竹萧疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜泊第四桥","author":"李洪","text":"月淡波寒夜向分，断行孤雁不堪闻。\n扁舟第四桥南泊，无限清愁寄梦云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓台 其一","author":"李洪","text":"故人泽畔被羊裘，高挹中天会冕旒。\n不使客星侵帝座，谩誇拜衮与封侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"钓台 其二","author":"李洪","text":"古木阴森蔽钓台，苍崖石壁倚天开。\n当年童稚曾游处，十八年间复此来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"剑池","author":"李洪","text":"削成峭壁碧孱颜，石罅高临毛发寒。\n我有胸中一寸铁，湛然如水绝波澜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"南塔","author":"李洪","text":"别峰相见路非遥，指点钱塘一线潮。\n安得南山退之句，赋成直使意飘飘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"残春偶作 其一","author":"李洪","text":"溪边且种刺史柳，园里未栽怀县花。\n若有故人来问字，浮图西畔绿阴斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"残春偶作 其二","author":"李洪","text":"閒里光阴趣渐长，下帘深护一炉香。\n游心华藏众香国，绝胜争名翰墨场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋祀上丁斋宿中夜雨凉因思去岁气候颇同书壁","author":"李洪","text":"秋云黯黯结层阴，頖水人稀夜漏沉。\n独有芭蕉如道侣，二年相伴宿斋心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送许季韶倅桂林 其二","author":"李洪","text":"高枕秋风病骨轻，随銮无复起侵星。\n铜瓶漱井锁尘虑，舌本犹堪读道经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送许季韶倅桂林 其三","author":"李洪","text":"除墨犹新湿诏黄，题舆不称愧龙光。\n且观百粤蛟鳄徙，勿羡九霄鸾鹄翔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送许季韶倅桂林 其四","author":"李洪","text":"文登犹记旧青毡，敢恨瓜期尚六年。\n办取扁舟五湖上，吴松鱼蟹不论钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送许季韶倅桂林 其一","author":"李洪","text":"二年鞭弭侍君轩，立仗从来愧不言。\n乞得閒官九仙隐，身谋优稳荷明恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"倦雨","author":"李洪","text":"留滞都城日欲归，江昏雨脚又霏微。\n祗愁陇上麦蛾化，岂要枝间梅子肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涂中杂兴 其三","author":"李洪","text":"很石惊涛枕席喧，长江蛟鳄屡垂涎。\n早知行路难如此，何似修涂稳著鞭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涂中杂兴 其二","author":"李洪","text":"草间蟋蟀动秋吟，偏感羁栖旅念深。\n功业岂关双鬓事，年来白处已通心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涂中杂兴 其四","author":"李洪","text":"荔子如丹橄榄青，红蕉叶落古榕清。\n温汤浴罢晚风快，老酒倾盆醉月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涂中杂兴 其五","author":"李洪","text":"山颠怪石如蹲兽，波底危矶似化羊。\n却忆鉴湖明月里，绿荷红芰暑风凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"涂中杂兴 其一","author":"李洪","text":"畏日炎炎火伞张，扁舟挂席泛沧浪。\n飞流溅沫倾三峡，过崄方知有底忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶书","author":"李洪","text":"世事悠悠莫问天，一觞且醉酒中贤。\n阶前落叶无人扫，满院芭蕉听雨眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作 其二","author":"李洪","text":"十日王程未许归，登山临水此心违。\n夜阑佛屋龛灯暗，时有飞萤点客衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作 其三","author":"李洪","text":"小雨纤纤未肯晴，归程犹趁欲宵征。\n潮来江浦绿如染，云抹山腰练许横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"偶作 其一","author":"李洪","text":"不种松陵二顷田，却来江浦按戈船。\n乘风破浪非吾事，暂借僧窗永日眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿汤泉驿","author":"李洪","text":"炎方到处水如汤，地脉深疑有臭黄。\n犹胜骊山污艳质，渔阳簇马鉴兴亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宿鲈风亭","author":"李洪","text":"暂解尘缨锁与缰，鲈风秋色似鲈乡。\n从今第四桥南去，蟹簖渔矶属漫郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清明钻火烹茶","author":"李洪","text":"客舍垂杨依旧青，自钻新火应清明。\n故山紫笋谁能摘，倒箧云龙手自烹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"清晖亭","author":"李洪","text":"溪山佳处称题诗，终日篮舆绕翠微。\n夹路苍官管迎送，客情那得澹忘归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"谒皇甫清虚","author":"李洪","text":"五湖四海仰仪形，道貌天真孰可名。\n偶泛仙舟来泽国，回先生后见先生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"骑骡","author":"李洪","text":"留城北去去分骡，冷笑亲朋驷马多。\n赖得劲蹄无可碍，一鞭安稳过沙河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄碧","author":"李洪","text":"轩台铸鼎已飞升，留与仙祠万古名。\n羽驾霓旌锁深翠，无因暂听步虚声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜雨","author":"李洪","text":"京尘睬目厌黄埃，萧飒风棂听雨来。\n心似芭蕉半憔悴，喜闻蛰户一声雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喝石岩","author":"李洪","text":"信脚来游喝石岩，老来到处少同参。\n出家本是丈夫事，岁晚终期卜一庵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"富沙城外李花盛开","author":"李洪","text":"万石滩头数十家，溪流衮衮麦畦斜。\n三分春色今馀几，开尽桃花见李花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":62191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]