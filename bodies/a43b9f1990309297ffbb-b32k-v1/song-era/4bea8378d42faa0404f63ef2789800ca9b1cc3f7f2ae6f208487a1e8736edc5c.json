[{"title":"初夏杂咏五首 其三","author":"陆游","text":"屐路缘虚壁，棋轩枕小滩。\n玄言不愧籍，熟睡却输抟。\n咄咄书常懒，便便腹本宽。\n山园时节好，杏子已微丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8144,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏杂咏五首 其一","author":"陆游","text":"挥袖谢人间，一窗如海宽。\n鹿麛为老伴，松屑当朝餐。\n自悟达生理，尽容非意干。\n却嫌孤寂甚，支灶学烧丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8145,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏杂咏五首 其四","author":"陆游","text":"去日惊钻燧，穷途困负薪。\n故人天末远，薄俗眼边新。\n踽踽飘零客，悠悠剩长身。\n寸心知已矣，端欲为谁陈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8146,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏行平水道中","author":"陆游","text":"老去人间乐事稀，一年容易又春归。\n市桥压担莼丝滑，村店堆盘豆荚肥。\n傍水风林莺语语，满原烟草蝶飞飞。\n郊行已觉侵微暑，小立桐阴换夹衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8147,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏即事","author":"陆游","text":"夏景遽如许，先从草木知。\n朱樱连蒂剪，红药带花移。\n病起单衣怯，身闲昼漏迟。\n空斋无长事，帘影看参差。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8148,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏怀故山","author":"陆游","text":"镜湖四月正清和，白塔红桥小艇过。\n梅雨晴时插秧鼓，蘋风生处采菱歌。\n沉迷簿领吟哦少，淹泊蛮荒感慨多。\n谁谓吾庐六千里，眼中历历见渔蓑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8149,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏闲步村落间","author":"陆游","text":"薄云韬日不成晴，野水通池渐欲平。\n绿叶忽低知鸟立，青萍微动觉鱼行。\n醉游放荡初何适，睡起逍遥未易名。\n忽遇湖边隐君子，相携一笑慰馀生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8150,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏闲居八首 其一","author":"陆游","text":"云液初篘小瓮香，风漪乍展北窗凉。\n巢乾燕乳虫供哺，花过蜂闲蜜满房。\n闭户不知春已去，钞书但觉日方长。\n所嗟诗思年来减，虚负奚奴古锦囊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8151,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏闲居八首 其七","author":"陆游","text":"水边茆屋两三间，野叟幽人日往还。\n两卷硬黄书老子，数峰破墨画庐山。\n功名会上元须福，生死津头正要顽。\n试说龟堂得力处，向来何啻半生闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8152,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏闲居八首 其四","author":"陆游","text":"城上朱旗夏令初，溪头绿水蘸菰蒲。\n花贪结子无遗萼，燕接飞虫正哺雏。\n箫鼓赛蚕人尽醉，陂塘移稻客相呼。\n长安青盖金羁马，也有农家此乐无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8153,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏闲居八首 其二","author":"陆游","text":"川云漠漠雨冥冥，浊酒闲倾不满瓶。\n蚕簇尚寒忧茧薄，稻陂初满喜秧青。\n王师护塞方屯甲，亲诏忧民已放丁。\n病起自怜犹健在，不须求应少微星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8154,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏闲居八首 其五","author":"陆游","text":"啜茗清风两腋生，西斋雅具惬幽情。\n熏衣过后篝炉冷，展卷终时懒架横。\n巢燕何曾择贫富，鸣鸠元不为阴晴。\n但能与物俱无著，小草新诗取次成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏闲居八首 其三","author":"陆游","text":"松棚黯黯接虚堂，扫地烧香旋置床。\n密叶留花供浅酌，断云障日作微凉。\n高城薄暮闻吹角，小市丰年有戏场。\n白首史官闲尽岁，祇将搜句答流光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏闲居八首 其八","author":"陆游","text":"煮酒青梅次第尝，啼莺乳燕占年光。\n蚕收户户缫丝白，麦熟村村捣麨香。\n民有裤襦知岁乐，亭无桴鼓喜时康。\n未尝一事横胸次，但曲吾肱梦自长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏闲居即事","author":"陆游","text":"门巷萧萧日正长，方床曲几傲羲皇。\n轻风忽起杨花闹，清露初晞药草香。\n对弈两奁飞黑白，雠书千卷杂朱黄。\n穿帘语燕能从我，分尔湖边一夏凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏夜赋","author":"陆游","text":"好景入新夏，幽人卧弊庐。\n廊腰得风远，树罅见星疏。\n门掩鸦栖后，钟鸣月上初。\n青灯尚堪近，起了读残书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏郊行","author":"陆游","text":"小砚孤吟恐作愁，长堤曳杖且闲游。\n破云山踊千螺翠，经雨波涵一镜秋。\n粔籹青红村步市，阑干高下寺家楼。\n去年此日君知否，十丈京尘没马头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏幽居四首 其二","author":"陆游","text":"虚堂一幅接䍦巾，竹树森疏夏令新。\n瓶竭重招曲道士，床空新聘竹夫人。\n寒龟不食犹能寿，弊帚何施亦自珍。\n枕簟北窗宁有厌，小山终日对嶙峋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏幽居四首 其三","author":"陆游","text":"野草幽花无歇时，一窗终日对东篱。\n病犹独醉虽堪笑，老未全衰亦自奇。\n古纸硬黄临晋帖，矮笺匀碧录唐诗。\n个中疑是忘忧处，问著山翁却不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏幽居四首 其四","author":"陆游","text":"东园梅熟杏初丹，老子披襟每不冠。\n古砚坡陀麝煤绿，小山葱茜石盆寒。\n移床剩欲眠松坞，鼓枻还思泊蓼滩。\n未用丝毫辨差等，黄尘终胜客长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏幽居四首 其一","author":"陆游","text":"日长巷陌晒丝香，雨霁郊原割麦忙。\n小担过门尝冷粉，微风解箨看新篁。\n傍篱邻妇收鱼笱，叩户村医送药方。\n欲到湖边还懒动，悠然扶杖立斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏幽居杂赋七首 其五","author":"陆游","text":"曲曲羊肠径，疏疏麂眼篱。\n渴蜂窥砚水，狂蝶入书帷。\n一枕轻安梦，数联萧散诗。\n馀生已过足，不必到期颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏幽居杂赋七首 其三","author":"陆游","text":"水际闲将鹤，林间独拥琴。\n披丛采香草，映树看珍禽。\n正使居无屋，犹胜突不黔。\n过春差觉健，处处得幽寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏幽居杂赋七首 其七","author":"陆游","text":"修名宁复冀，馀日苦无多。\n已叹堂堂去，将如寂寂何。\n编篱护香草，埋盎贮清波。\n儿戏君无笑，相从且浩歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏幽居杂赋七首 其四","author":"陆游","text":"篱落鱼池北，房栊道院东。\n水纹藤坐榻，山字素屏风。\n采药松冈近，投竿荻浦通。\n悠然搔短发，心事寄冥鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏幽居杂赋七首 其二","author":"陆游","text":"过尽一春雨，园林气少和。\n偶然扶楖栗，复尔坐盘陀。\n小草数行字，残花一曲歌。\n公卿非傲汝，无奈爱闲何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏幽居杂赋七首 其六","author":"陆游","text":"辟地剪蓬蒿，何曾叹作劳。\n药名寻本草，兰族验离骚。\n北涧穿篱过，南山出屋高。\n回头看富贵，何啻一秋毫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏幽居杂赋七首 其一","author":"陆游","text":"雨霁逢初夏，胡床荫绿槐。\n半酣方嵬峨，假寐忽咍台。\n小穗闲簪麦，微酸细嚼梅。\n衰翁不禁老，更著物华催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏幽居偶题四首 其三","author":"陆游","text":"昔如转战堕重围，今幸鶱翔脱骇机。\n晓树好风莺独语，夜窗细雨燕相依。\n安居不恨蜗庐迮，得食宁论鹤料微。\n更喜暮年彊健在，又看刀尺制缣衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏幽居偶题四首 其四","author":"陆游","text":"朱樱羊酪喜新尝，碧井桐阴转午凉。\n书几得晴宜试墨，衣篝因润称熏香。\n枯龟自觉支床稳，老马安能试草长。\n半世学骚终不近，空馀清梦上沅湘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏幽居偶题四首 其一","author":"陆游","text":"放逐还家一老翁，痴顽自笑更谁同。\n倚栏风月黄昏后，携杖园林绿润中。\n泳水小鱼依藻荇，觅巢轻燕拂帘栊。\n此身要岂坚牢物，莫遣须臾酒盏空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏幽居偶题四首 其二","author":"陆游","text":"展尽高槐日渐长，了无蜂蝶为花忙。\n青梅旋摘宜盐白，煮酒初尝带腊香。\n林下光阴无一事，水边窗户有馀凉。\n应门不用辞衰疾，车马何由到野堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏野兴三首 其一","author":"陆游","text":"得意烟霞不讳穷，一庵聊寄寂寥中。\n山从树杪参差见，水过花阴曲折通。\n闲倚胡床溯新月，时停团扇受微风。\n元知梦境无真实，不待邯郸觉后空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏野兴三首 其二","author":"陆游","text":"披衣清晓倚阑干，龟屋裁成二寸冠。\n盆桧雨馀抽嫩绿，研池风过起微澜。\n爱书自笑心常在，去死悬知日尚宽。\n回视前修似无愧，不教一字入长安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏喜事","author":"陆游","text":"箕颍元非争夺场，潇湘自古水云乡。\n采茶歌里春光老，煮茧香中夏景长。\n敛版早知游宦恶，署门晚悟世情常。\n茹芝却粒虽无术，散发犹当效楚狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏游凌氏小园","author":"陆游","text":"水满池塘叶满枝，曲廊危榭惬幽期。\n风和海燕分泥处，日永吴蚕上簇时。\n闲理阮咸寻旧谱，细倾白堕赋新诗。\n从来夏浅胜春日，儿女纷纷岂得知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏新晴","author":"陆游","text":"曲径泥新晚照明，小轩才受一床横。\n翩翩乳燕穿帘影，蔌蔌新篁解箨声。\n药物屏除知病减，梦魂安稳觉心平。\n深居不恨无来客，时有山禽自赞名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初夏燕堂睡起","author":"陆游","text":"歌凤平生类楚狂，山城迟暮得深藏。\n洗春雨过清阴合，掠水风生绿藻凉。\n晨几砚凹涵墨色，午窗杯面聚茶香。\n功名到手浑闲事，此兴他年未易忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初离兴元","author":"陆游","text":"梦里何曾有去来，高城无奈角声哀。\n连林秋叶吹初尽，满路寒泥蹋欲开。\n笠泽决归犹小憩，锦城未到莫轻回。\n炊菰斫脍明年事，却忆斯游亦壮哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒","author":"陆游","text":"雨霁林犹滴，泥新路易乾。\n萧条山步晚，憔悴客衣单。\n小女收鱼笱，童儿放鸭栏。\n初寒岂不好，衰病自无欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒","author":"陆游","text":"江路常逢雨，山城早得寒。\n兰凋初解佩，菊老尚加餐。\n节物知何负，情怀自鲜欢。\n浮生看已熟，不必梦邯郸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒","author":"陆游","text":"逐禄天涯半此生，明时宽大许归耕。\n山围鱼市寒无色，雨掠蓬窗夜有声。\n白发青灯身潦倒，残芜落叶岁峥嵘。\n尔来有喜君知否，买得乌犍万事轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒","author":"陆游","text":"久雨重阳后，清寒小雪前。\n拾薪椎髻仆，卖菜掘头船。\n薄米全家粥，空床故物毡。\n身犹付一歃，名字更须传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒","author":"陆游","text":"蚊蝇扫迹叶飞初，剩喜幽窗读我书。\n墙角短檠真耐久，手中团扇又成疏。\n百年作梦行休去，九月无衣亦晏如。\n独恨故人消息断，寒江谁与倩双鱼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒二首 其一","author":"陆游","text":"老遇初寒候，贫当绝禄时。\n衣裘俱在笥，薪炭不愆期。\n鹑满群童网，鱼浮百石陂。\n比邻每分饷，扪腹可无饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒","author":"陆游","text":"新雁来时岁又残，丹枫数树照江干。\n前山云起忽成暝，陋屋雨来初变寒。\n身退已收清禁梦，里居终出上恩宽。\n作诗老恨无奇思，时取囊中断稿看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒","author":"陆游","text":"今日霜露冷，凛然悲暮秋。\n垂帷跨微火，发箧出轻裘。\n徂岁逝将换，残生愈觉浮。\n一杯还自闵，小猎记梁州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒","author":"陆游","text":"日月谁能驻，风霜忽已高。\n公孙分布被，范叔共绨袍。\n䆉稏炊香甑，蒲萄压小槽。\n所惭才已尽，孤咏不能豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒二首 其二","author":"陆游","text":"重帘禦晚吹，密瓦护晨霜。\n焰焰砖炉火，霏霏石鼎香。\n行迟依木杖，坐久穴藜床。\n昼亦无聊甚，胡为厌夜长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒书怀","author":"陆游","text":"嵩云缑月本闲人，误落尘中白发新。\n万事看山差入眼，百年把酒独关身。\n栈边老马行安往，床下寒龟息自匀。\n藜杖一枝犹好在，未妨闲探早梅春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒对酒","author":"陆游","text":"晨起常教置一壶，色如鹅氄滑如酥。\n侍郎取榼不须笑，司业与钱还复酤。\n霜路预愁骑款段，雪舟每忆钓菰蒲。\n寒花满帽君无笑，醉倒偏宜稚子扶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒在告有感三首 其三","author":"陆游","text":"横林吹叶水生洲，身落穷山古睦州。\n到枕雨声酣旅梦，背窗灯影动清愁。\n气冲星斗有孤剑，力挽栋梁无万牛。\n未灭匈奴身已老，此生虚负幄中筹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒在告有感三首 其一","author":"陆游","text":"扫地烧香兴未阑，一年佳处是初寒。\n银毫地绿茶膏嫩，玉斗丝红墨沈宽。\n俗事不教来眼境，闲愁那许上眉端。\n数棂留得西窗日，更取丹经展卷看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒在告有感三首 其二","author":"陆游","text":"豪举当年气吐虹，即今憔悴一衰翁。\n寄怀本自俗尘外，移病何妨寒雨中。\n香暖候知银叶透，酒清看似玉船空。\n故人吴蜀音尘断，安得相携一笑同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒老身颇健戏书二首 其二","author":"陆游","text":"过雁声悲落叶稠，孤村景物更禁秋。\n穷谙客路风尘恶，老判人间岁月遒。\n酒号贤人真古语，疾为竖子岂吾忧。\n山房幸有初寒备，且傍篝炉拥褐裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒老身颇健戏书二首 其一","author":"陆游","text":"一身百病老难支，病减身轻偶此时。\n窗暖不妨聊假寐，囊空久已罢招医。\n山炉巉绝香生岫，鏊研坡陀墨满池。\n个里生涯君莫厌，痴人至死不曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒独居戏作","author":"陆游","text":"开壳得紫栗，带叶摘黄甘。\n独卧维摩室，谁同弥勒龛。\n宗文树鸡栅，灵照挈蔬篮。\n一段无生话，灯笼可与谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒宴坐","author":"陆游","text":"微火如萤度篆盘，明窗坐败几蒲团。\n群儿谁信老怀懒，万事不禁醒眼看。\n道在箪瓢端自足，心闲天地本来宽。\n此生自断君知否，不办归装也挂冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒病中有感","author":"陆游","text":"楚水枫林霜露新，白头一叟正吟呻。\n牛衣未起王章疾，马磨何伤许靖贫。\n治道本来存简册，神州谁与静烟尘。\n新亭对泣犹稀见，况觅夷吾一辈人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初寒晨起","author":"陆游","text":"推枕悠然起，寒灯谁与同。\n晓窗俄已白，宿火尚能红。\n老境呻吟外，年华寂寞中。\n长饥亦可恨，聊复固吾穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初晴","author":"陆游","text":"暑雨初收体为轻，远山尽出眼偏明。\n诗凭写兴忘工拙，酒取浇愁任浊清。\n绿树有阴休倦步，澄溪无滓濯尘缨。\n老人本少凋年感，不奈江城暮角声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初晴","author":"陆游","text":"袖手东窗初日明，残编未负老书生。\n不胜多病畏寒雨，正得一霜方快晴。\n客户饷羹提赤鲤，邻家借碓捣新粳。\n柴荆莫怪无车马，恰要无人识姓名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初晴野步","author":"陆游","text":"入市路三叉，缘山港半斜。\n疏篱带残雪，幽窦泻湍沙。\n好鸟晴相语，芳兰暖欲芽。\n病馀无脚力，随处憩人家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初暑","author":"陆游","text":"槐阴清润麦风凉，一枕闲眠昼漏长。\n山鹊喜晴当户语，海桐带露入帘香。\n酒缘久病常辞酌，茶为前衔偶得尝。\n云北云南动游兴，速呼小竖治轻装。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"初睡起有作","author":"陆游","text":"喔喔晓鸡鸣，迢迢残漏声。\n拨衾幽梦断，褰幌小窗明。\n獠婢篝衣暖，山童拥彗行。\n老夫徐下榻，负火听瓶笙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"别王伯高","author":"陆游","text":"冷落何人肯见寻，断弦尘匣愧知音。\n倾家酿酒犹嫌少，入海求诗未厌深。\n薄宦簿书常衮衮，中年光景易骎骎。\n香奁赠别非无意，共约跏趺看此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":8209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]