[{"title":"寄潭州何正臣君表待制二首 其二","author":"冯山","text":"高卑鹏鴳分难攀，岂意相知邂逅间。\n北海旧时曾荐鹗，愚公终日尚移山。\n平生泯默无他技，一顾差池已厚颜。\n犹有功名心尚在，炉锤当手待公还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47075,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄上范蜀公二首 其一","author":"冯山","text":"去就人兼众美难，侍郎高望肃衣冠。\n每寻当世群公议，更在清流绝等看。\n楚屈辞多谁谤国，汉疏名重只休官。\n求仁已得无馀憾，自向冥冥著羽翰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47076,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄上范蜀公二首 其二","author":"冯山","text":"拱极星文动少微，西南风物重光辉。\n平生亲友倾心望，共庆功名毕手归。\n车马欢声传里巷，松楸佳气杂烟霏。\n长卿儿戏扬雄拙，未足公前较是非。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47077,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄上北京文侍中","author":"冯山","text":"四纪三朝会遇同，陪京犹望节旄雄。\n欲知元老经纶迹，尽在生民鼓舞中。\n汉府重归黄阁相，商山难访紫芝翁。\n陶钧末士惭无报，惟解声诗写至公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47078,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和东川吴几复辨叔朝议见寄","author":"冯山","text":"幕府参差恨莫追，公车才下我亲闱。\n高谈乍听曾心死，前会难寻但肉飞。\n千里有时重咳唾，一言何处尽精微。\n惟思旌棨趋严召，双剑西南望落晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47079,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈图南道中见寄","author":"冯山","text":"故人重见老相看，江上秋风已薄寒。\n曾约浮沉俱里社，岂期侥倖亦侯籓。\n休嗟华发多年别，且喜清樽数日欢。\n惟有旧游难得处，风骚遗恨满三轩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47080,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李献甫见寄","author":"冯山","text":"别肠回转似车轮，千里相忘一水滨。\n自愧卑飞徒衮衮，过蒙高义最恂恂。\n已违兰养三经岁，犹恐瓜期再见春。\n趋府何当听约束，分为膏泽与乡民。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47081,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和朱牧宣德","author":"冯山","text":"英游相聚日相欢，休唱还家蜀道难。\n为爱尊前文字饮，不知门外雪霜寒。\n酒酣依约群仙梦，谈剧飞扬巨海澜。\n从此追随频语笑，莫教憔悴耻儒冠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47082,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"运使李献甫有书云千山万水之间泥泞劳苦不可胜言者因以诗答之","author":"冯山","text":"使车东按宕渠还，霖潦千山万水间。\n为把仁恩行郡国，肯教愁色到容颜。\n高贤本为苍生起，良骥应无白日閒。\n从此促归天上去，翱翔鹓鹭紫宸班。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47083,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送梓宪巩彦辅中散二首 其一","author":"冯山","text":"宏才高望出簪裾，尤向持平意豁如。\n辇毂声名三辅最，西南恩惠十年馀。\n诸公每恨归朝晚，美职行闻半道除。\n今日老成应不次，中台烦剧在刑书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47084,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送梓宪巩彦辅中散二首 其二","author":"冯山","text":"绣衣三峡始归来，孤迹青天道上回。\n牛马经年驰使檄，云霓终日望行台。\n鹓鸿去势看千里，桃李遗芳占一栽。\n都邑群公如见问，漳滨衰病已难材。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47085,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和知资州许广渊泽翁同年朝奉见寄","author":"冯山","text":"每思同榜多零落，忽见新篇慰寂寥。\n今日抗尘俱白首，当时联翮共青霄。\n休嗟远地犹沈俊，况是深知已满朝。\n饥渴未能亲一笑，祗忧严召促归轺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47086,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和周正孺游醴泉寺蚕丛","author":"冯山","text":"衰迟犹有少年心，十里名蓝共访寻。\n抹绿郊原逢雨后，残妆桃李觉春深。\n諠哗歌舞随流俗，潇洒溪山忆故林。\n一醉不辞繁上酒，簿书回首费光阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47087,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和周正孺春游","author":"冯山","text":"路入江村五马游，江边生俗弄春毬。\n客愁无地时分请，乐看能俳预点抽。\n趁赏不辞花欲老，劝农偏喜雨新收。\n经年多病无欢意，强逐双旌一举头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47088,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李曼修孺户曹","author":"冯山","text":"青云回首即红尘，且向卑官事隐沦。\n衮衮泥途方索足，区区天地不容身。\n前头功业安知命，满腹文章未称贫。\n深愧相知空握手，羽书边上辍嘉宾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47089,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和徐之才回纹","author":"冯山","text":"行轺使指屡襟分，路去重看思纠纷。\n清夜峡前江照月，霁天郊外剑横云。\n情多苦近归褒汉，景物应难会见闻。\n荣虑俗缘因刺按，燕堂虚愧有移文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47090,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘泾巨济教授","author":"冯山","text":"卷地严风动马蹄，忽闻投馆到鸡栖。\n路随黄鹤翱翔远，诗压青山气象低。\n我已衰年思故国，君方高步陟丹梯。\n迟留且伴临江醉，剩听清猿峡口啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47091,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和吕少蒙蚕市","author":"冯山","text":"何处青衣旧俗酣，峨嵋东畔蜀江南。\n从来岁首争为市，大半民间已不蚕。\n几日笙歌常继烛，晚春桃李尚仍蓝。\n嬉游果获神明助，太守虽贫亦荠甘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47092,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"往时与今钱唐蒲资政传正修史邓内翰温伯同和唐韦考功张水部盛山十二咏畀开江吴令使榜于宿云亭二十三年矣因缘登览感慨畴昔复为短篇以纪故事元祐二年正月二十八日安岳冯允南","author":"冯山","text":"曾继唐贤旧唱酬，宿云亭传为迟留。\n韦温石上寻遗迹，蒲邓天边忆俊游。\n亭榭寂为閒处所，溪山清带古风流。\n神交冥漠相知远，重把狂吟此暗投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47093,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中岩封崇寺","author":"冯山","text":"万竹林间一径升，满岩金碧静香灯。\n飞泉散乱垂千尺，危阁攲斜拥数层。\n雨气或从檐际落，风光时向坐中凝。\n荒碑文字那能读，合眼煎茶问老僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47094,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"扶欢驿王衮居也梁承秀居今隆化县李光吉居今荣懿寨皆土豪犯法禁以取夷灭","author":"冯山","text":"僭田收尽连蛮徼，旧版从来实汉民。\n草染华风能不瘴，山离污俗自无尘。\n连城解丧吴王濞，钜积终刑石季伦。\n一代英豪犹不免，咄嗟三叛尔何人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47095,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"三家兄书报荐起楼屋喜而有诗","author":"冯山","text":"临街楼观百馀年，司马辛勤五世传。\n凡在子孙俱肯构，敢忧门户或先颠。\n亢宗本是先人意，干蛊成于伯氏贤。\n他日举杯相属处，为留书阁井东偏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47096,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄陈蓬州图南","author":"冯山","text":"临老蹉跎来剑阁，故人留滞在蓬池。\n光阴一别六七载，功业半生多少时。\n谪宦可怜嗟子骏，径归难学羡诚之。\n何当江上重携手，同到三轩看旧诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47097,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邓温伯二首 其一","author":"冯山","text":"不独高文耀世奇，曾将宏议振天维。\n谁人才术能争首，自古功名贵及时。\n暂别鹓鸿蓬海上，少留旌旆蜀江陲。\n西州笔砚虽衰落，会有中和乐职诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47098,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和邓温伯二首 其二","author":"冯山","text":"虚誉交游共借推，清途俛首倦重窥。\n方将素志随鸥鹭，敢拂华巅望鵔鸃。\n衰晚欲成漳浦病，嗟矜犹得郑公诗。\n相逢少置升沉事，且把金莲为倒垂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47099,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送邓温伯","author":"冯山","text":"长羡横飞霄汉远，多惭窘步路途穷。\n如何会合青天道，俱是衰迟白发翁。\n万里每嗟音信绝，一樽还喜笑言同。\n遨游莫作经春计，伫看高旌促召东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47100,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘漕明复观吴生画","author":"冯山","text":"古观萧条昔未名，却因吴笔助神灵。\n能将万化豪端意，写出群仙物外形。\n俊逸状如裴剑舞，周环时见蜀山青。\n阴兵耸动惊魑魅，真仗飘摇拥户庭。\n按部每来除枳棘，题诗留与禦风霆。\n因嗟画癖无由见，魂逐车尘为一经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47101,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和题成都诸公唱和集","author":"冯山","text":"诸公高咏蜀人编，唱和舂容近百篇。\n厚重江山藏古气，轩翔雕鹗在秋天。\n不徒神物阴相护，兼有风谣乐共传。\n谁谓开州新集好，退之题后始完全。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47102,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘明复再游剑州东园二首 其一","author":"冯山","text":"孤城寥落万山围，惟有东溪景最奇。\n拥传使华寻旧赏，满园春色待多时。\n援琴故故弹流水，隐几萧萧听竹枝。\n摆脱风光情不尽，停车门外欲行迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47103,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和刘明复再游剑州东园二首 其二","author":"冯山","text":"危亭飞阁照寒溪，重到依然杜宇啼。\n好事且看韦守记，补亡思觅义山题。\n频来已免山移诮，久坐翻为水乐迷。\n一宿有情非雅素，他年嵩洛是真栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47104,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和徐之才喜雨","author":"冯山","text":"悯雨何须事祷祈，霈然未足便晴晖。\n润通垄亩麦禾起，香遍园林樱笋肥。\n浮藻水生鱼聚戏，落花泥熟燕交飞。\n民谣已洽丰年望，惟恐使车将北归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47105,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和徐之才觜体","author":"冯山","text":"菜蔓全除看绿槐，木阴秾合乍闻雷。\n田间虽荷沾濡泽，水际先忧荡溺灾。\n火气已随妖焰出，山光尤喜晚晴开。\n门前雅致无馀事，惟见诗筒竞往来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47106,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄新先辈蹇颀子长书记","author":"冯山","text":"年少才华自不群，果然飞步出儒绅。\n汉廷大对无双手，蜀学巍科第四人。\n暂屈鹓鸾栖枳棘，行看雕鹗离风尘。\n东川佳气因相待，共作荣归昼锦春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47107,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和杨寿祺承事见寄","author":"冯山","text":"道屈文章价不低，误传新句落天西。\n忽闻命驾趋云栈，犹忆同舟上井溪。\n争叹科名淹旧发，谁怜簿领困沉迷。\n相逢且约嘉陵酒，为洗关中数尺泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47108,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送苗子君运使赴河东漕二首 其一","author":"冯山","text":"圣君宵旰尚忧边，移领并汾将漕权。\n汉使已更三数节，壶关才下十馀年。\n民情姑息方师后，兵计从容试上前。\n卿相通途从此致，横飞雕鹗上秋天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47109,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送苗子君运使赴河东漕二首 其二","author":"冯山","text":"一顾生平于我厚，十年门下见公亲。\n祗知谈笑无难事，谁识襟怀似古人。\n遽别未遑论出处，相看何用惜沉沦。\n清朝勋业谁相问，已向籓篱托此身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47110,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄李献甫运使","author":"冯山","text":"江淮勋绩已优殊，重使西南出帝俞。\n被泽民谣千里远，望风边事十分无。\n文书顷刻随谈笑，骚雅雍容命仆奴。\n旦暮即闻严召速，扶摇三省上鹏图。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47111,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和赵良弼初秋即事","author":"冯山","text":"尊酒相看白发翁，重来宁复问穷通。\n十年旧事资谈柄，一箧新诗载古风。\n楚客远行经素节，蜀人归兴羡冥鸿。\n登山临水无多日，且伴閒中说苦空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47112,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甲子鹿鸣燕上呈诸秀才二首 其一","author":"冯山","text":"诏书天上颁春泽，经义人间沸海涛。\n俊秀一时随品藻，文章万选即英豪。\n溟鹏乍见抟风起，郡守宁辞劝驾劳。\n当有奇才为时出，中元佳气似嵩高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47113,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甲子鹿鸣燕上呈诸秀才二首 其二","author":"冯山","text":"重阳高会最风流，为礼贤书席俊游。\n已爱食萍歌小雅，更宜攀菊赏清秋。\n荣观坐见邦人喜，壮志行期国士酬。\n酒到从容当尽醉，登仙名籍在瀛洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47114,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重和四首 其一","author":"冯山","text":"群俊争求一字褒，诸公清识晋山涛。\n蓬仙寥落谁人继，史笔纵横自古豪。\n胜爵频倾知得隽，剧谈无极坐忘劳。\n勉行无负题评意，东蜀斯文价已高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47115,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重和四首 其二","author":"冯山","text":"郡筵潇洒宴清流，疏懒相从伴奂游。\n但喜狂歌犹应节，不知衰发已伤秋。\n多情共把金英看，厚赠惭无玉案酬。\n未去且为诗酒会，萧萧休咏白蘋洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47116,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重和四首 其三","author":"冯山","text":"整此笙歌散郁陶，雨檐飞瀑泻秋涛。\n吟情彻骨清尤健，饮量随人喜更豪。\n黄菊光容嗟向晚，哀筝言语恨徒劳。\n相逢宜共冥冥醉，回首青云路转高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47117,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"重和四首 其四","author":"冯山","text":"年少相看自辈流，深知惟喜旧交游。\n休言白发参差老，只恐朱颜次第秋。\n欢笑且从今日起，功名能有几人酬。\n逍遥不必分高下，凫雁翩翩芦苇洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47118,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和陈兴州见寄","author":"冯山","text":"音信易传临一水，道途相去隔三州。\n何时樽酒同为会，无补篇章约共休。\n乡思豁从归后少，贪心宜向静中收。\n此情惟有君知我，不羡人间万户侯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47119,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"戏谢赵良弼寄薏苡山药","author":"冯山","text":"?珠舂出真珠颗，山药锹开白玉团。\n本草经中俱上品，故人书寄善加餐。\n轻投已获琅玕报，每饮兼资菽水欢。\n欲把长篇酬厚意，吟肠无味苦搜难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47120,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"问江巨源求茶","author":"冯山","text":"语笑嘉陵醉别辰，曾留一角建阳春。\n不将閒碾无佳客，每到开尝忆主人。\n蒙顶纵甘馀草气，月团虽有隔年陈。\n吟魂半去难招些，愿得兰溪数片新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47121,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢李献甫寄凤茶","author":"冯山","text":"双凤婆娑绿玉团，初纲犹怯禁中寒。\n贵从侍从时宣赐，传到西南作宝看。\n旋碾合留清浩气，亲题何事寄粗官。\n感公珍惠宁须试，一嗅烦怀已自宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47122,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"再和","author":"冯山","text":"此品何尝下小团，分甘仍值雪霜寒。\n恐尘竹叶微蒸过，要细银杆旋碾看。\n紫盏烘时愁俗客，清风来处属仙官。\n平江一啜吟佳句，起舞不知天地宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47123,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李曼长官约游郊园","author":"冯山","text":"郊园闻葺旧亭台，晓访冰须冻结腮。\n野景豁从江上见，云扃深向雾中开。\n早知閒处登临好，何恨忙时取次来。\n梦草新诗酬不得，谢家兄弟尽清才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47124,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和李献甫云顶","author":"冯山","text":"举首看山不到山，每来留恨翠微间。\n禅关但有经年约，使传终无一日閒。\n春到柏林香渺渺，雨馀岩漏泻潺潺。\n虎溪莫过虚邀客，猿鹤钟峰怅未还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47125,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和鲜于顷节推惠诗","author":"冯山","text":"英驾能来慰寂寥，相看衰鬓共飘摇。\n风骚会里多年别，谈笑杯中万事销。\n休叹辕驹方局蹐，不知籓鴳已逍遥。\n如将巧思鸣孤愤，为我商声更一谣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47126,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"下黔江","author":"冯山","text":"崎岖才喜下荆岑，一水奔腾万石林。\n使节敢辞重险阻，客舟将命寄浮沉。\n可怜幽窦非人境，犹有清泉慰我心。\n劳逸贤愚宁可问，但嗟衰晚愧临深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47127,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和王子严南平道中寄示","author":"冯山","text":"雨随行色过重闉，路有思归送别人。\n未省几时趋北阙，且同回首望西邻。\n黄花渐近羞重见，白酒犹期醉一巡。\n三峡苦辛尝欲遍，置杯休要问浇醇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47128,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄贺李修孺移利宪","author":"冯山","text":"才出关来又入关，欲閒天意未教閒。\n一生孤直知心处，三度交承隔政间。\n食蔗羡君方有味，过屠怜我尚何颜。\n功名不是蹉跎物，犹惜清时共仰攀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47129,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"牟仲甫作鸡终有意趣为予写斗鸡矜骄自得犹有馀勇因以绝句题其画云","author":"冯山","text":"忘身为利得忘形，弃弹庄生只自惊。\n嗟汝虚憍气方盛，何时全得似无情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47130,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄利宪张充宗司勋","author":"冯山","text":"曾言英馆愿重寻，犹记当时恋别心。\n千里江山劳客思，一年风物又春深。\n梦中花发人将老，关外愁生酒不禁。\n引领使台归未得，且疏怀抱寄知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47131,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"木门早行","author":"冯山","text":"白虎前峰数尺高，露华萧飒满征袍。\n只知眼底簿书静，岂意山中车马劳。\n石夹雨馀重按辔，草间风动几横刀。\n通途闻说无多地，踊跃身轻意气豪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47132,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵悦道参政大资知越州二首 其一","author":"冯山","text":"乖崖威重兼之恕，正献纯风重以和。\n高世清名公取尽，经邦馀事蜀沾多。\n二江遗爱流长在，双剑铭功壁屡磨。\n闻向蓬莱指归路，其如朝野具瞻何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47133,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵悦道参政大资知越州二首 其二","author":"冯山","text":"徒御纷纷拥剑关，蜀人感泣送公还。\n欲知千里讴歌意，半在百篇文字间。\n风霰道途方过阙，烟霞旌旆更寻山。\n重金不负扁舟约，贺老鉴湖春水閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47134,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和鲜于子骏游沙溪洞","author":"冯山","text":"放辔深穷物外天，少偿游恨十馀年。\n诸仙羽化曾由此，千载岩居尚宛然。\n门转青溪空水石，室存丹灶养云烟。\n冰骸坐久虽清澈，独有区中世俗缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47135,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"兴州坐卧二仙","author":"冯山","text":"莫逆真心际混茫，岂将生死系存亡。\n已骖云雾朝丹阙，犹蜕衣冠寄异乡。\n姓氏不传灵秘录，精神长在发圆光。\n洪肩丘袂攀无及，分向尘中到老忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":47136,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]