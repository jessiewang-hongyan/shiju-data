[{"title":"小师智宽与国清作丐请语","author":"释正觉","text":"入廛一钵是生涯，来自寒山拾得家。\n晓影玉钩萝户月，春丛黄粉蜜房华。\n午炊佛土香传鼻，参饱云门饭打牙。\n准拟神通何处借，净名居士住毗耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9910,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"小师慧果丐盐求颂","author":"释正觉","text":"可中滋味欠些些，成就庐山笋蕨家。\n丐事子行黄苇渡，盟心人在白鸥沙。\n和羹户户俱煎卤，扫雪村村欲没靴。\n味及衲僧初偃月，圆通只个是生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9911,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云上人持钵乞颂","author":"释正觉","text":"云水千僧共默耕，烦君乞食出山行。\n蕨薇夜雨萌寒麓，桃李春风织锦城。\n空谷一呼同响应，圆珠众色合光明。\n上方此去分香饭，为我先须见净名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9912,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"云上人持钵求颂","author":"释正觉","text":"云林风雪暮纤纤，滴沥寒声晓断檐。\n一点丐心盟杖屦，十分化事入锤钳。\n霁光如拭月无碍，华锦落机春不嫌。\n百亿分身遍尘刹，见闻萧洒孰相黏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9913,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"以何学士韵示像侍者","author":"释正觉","text":"茂养高标松抱苓，岁寒姿傲雪霜丁。\n萧骚风度山林韵，偃蹇气钟丘壑形。\n霁月霁云胸次淡，秋山秋水眼棱青。\n磨砖谁问马师语，妙发枯龟一灼灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9914,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"化上人持钵乞颂","author":"释正觉","text":"化事而今尽付君，归来还我验儿孙。\n诸尘正受盛于钵，一句含胡覆却盆。\n别处见人知雪岭，自家吃饭识云门。\n底心肯负檀那力，开发真机报施恩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9915,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"心上人乞食求颂","author":"释正觉","text":"去去之人乞食心，春风浩荡洗丛林。\n松蹊香腻糁黄粉，竹坞清癯包玉簪。\n炊甑分珠斋钵满，净瓶汲月夜塘深。\n归来磨濯光明在，向道尘泥不涴金。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9916,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"心知庄求颂","author":"释正觉","text":"耕云种月自由人，田地分明契券真。\n黄独将看炊作饭，白牛今已牧来纯。\n钁头活计时时用，物外家风处处亲。\n禾黍十分秋可望，饱丛林汉著精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9917,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"心禅人出丐求颂","author":"释正觉","text":"将看秋早瘦风林，禾卷黄云副丐心。\n妙印手中那外物，虚空胸次不容针。\n谁家落甑炊香雪，后夜归船棹软金。\n洗足蒲团松石上，绕篱山水有清音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9918,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"方上人持钵乞颂","author":"释正觉","text":"卷衣破晓下连城，意欲分炊往上方。\n僧钵饭归三篾饱，蜂房蜜合百华香。\n柳丝莺友调唇滑，云锦人家照眼光。\n应变纵横看伎俩，随身干木惯逢场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9919,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月禅人出丐求颂","author":"释正觉","text":"一月在诸水，动随来去舟。\n分身能恁么，到处恰相投。\n湖海堕全璧，鱼龙吞曲钩。\n归来端可庆，俱得饱参休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9920,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月禅人出丐求颂","author":"释正觉","text":"踏雪到人家，投机的不差。\n月魂通水脉，春信入梅华。\n去觅炊香许，来宽束篾些。\n上方分佛事，先我过毗耶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9921,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王观察求颂","author":"释正觉","text":"廓虚深净里头看，一点至灵珠走盘。\n默默通身明有眼，尘尘分应妙无瘢。\n江湖浩浩月随溜，华木欣欣春入端。\n变化鲲鹏是时节，便乘羊角作风抟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9922,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仙上人出丐求颂","author":"释正觉","text":"缀钵持来勇入廛，家家行结胜因缘。\n三千界重慈悲佛，五百生称忍辱仙。\n芳濯丛林春冉冉，明随流水月娟娟。\n饱参事与千僧供，洗足蒲团枯木禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9923,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"出康庐渡江淮山拜诸祖塔道中作","author":"释正觉","text":"涩舟沙水岸棱棱，岸上春泥深涴藤。\n回首康山怀结社，真情祖室事传灯。\n子孙亹亹雪庭可，衣钵绳绳舂屋能。\n坐照少林墙面意，湛明心地瑩如冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9924,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"甲寅春之海山雨后访王渊明知县","author":"释正觉","text":"谁问春泥没履牙，萝门窈窕绿差斜。\n幽芳松菊渊明径，深秀溪山摩诘家。\n默照佛灯寒不掉，对缘心鉴净无瑕。\n仍闻懒甚融居士，庭鸟几番狼藉华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9925,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"立春后五日次本上人韵","author":"释正觉","text":"雪绕楼栏同楚些，梅将青子柳柔柯。\n山林臭味入新语，风月膺胸遵古科。\n梦付曲肱春困甚，乞如骈拇老閒何。\n雨师雷伯情多妒，收拾陶家壁上梭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9926,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"仲春过龙舒法华山寻诵经道者旧庵","author":"释正觉","text":"支径入穷谷，来寻道者庵。\n梵音今默默，华雨尚毵毵。\n夜白月半屋，寒青灯一龛。\n梦随歌吹去，借路过江南。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9927,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"传上人丐盐求颂","author":"释正觉","text":"濒海人居不事田，生涯清白是家传。\n雷鸣山麓潮横雪，津出泥沙卤泛莲。\n冰玉色承熬炼力，蕨薇滋藉合和缘。\n舌头妙有圆通眼，坐断丛林五味禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9928,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冲禅人与翠山出丐求颂","author":"释正觉","text":"归去家山雪未消，到时雪后翠棱高。\n豁然直下断三际，卓尔个中抽一毫。\n化钵不妨游幻海，虚舟何惮驾惊涛。\n因缘成熟袖双手，莫学吾家败酒糟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9929,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"华亭顾道友儿女俱出家求颂","author":"释正觉","text":"儿儿女女著袈裟，留得闲身且在家。\n不作丘坑看觉地，当锄荟蘙种昙华。\n深藏北斗端能许，吸尽西江始较些。\n三界脱然亡影像，净名居士好生涯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9930,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因览仰山小释迦语成唱道二首 其一","author":"释正觉","text":"脱尽诸缘空不空，杳无边表喻难同。\n须知月蚌肠中物，体取云犀角里通。\n建化何妨行鸟道，回途复妙显家风。\n太平游子归来也，云鬓霜眉内转功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9931,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"因雪示随行禅者","author":"释正觉","text":"家家种玉满区区，谁裹烟蓑细步趋。\n千里同风休缀缀，十方一色尚拘拘。\n梦醒光彩两头断，坐稳身心三际无。\n清白传家衲僧事，其间转处看工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9932,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"尘上人出丐求颂","author":"释正觉","text":"轻轻弹指便开门，百亿门前百亿身。\n妙应因缘通处处，圆明个事遍尘尘。\n华间蜂采黄须蜜，柳上莺传青眼春。\n归日相呼满钵饭，一时分付饱参人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9933,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"岁开八日谒西溪真悟讲师","author":"释正觉","text":"雨华几席自清馨，茗碗初收篆缕青。\n柔弄柳条风剪剪，冷濡梅蕊雪星星。\n不嫌黄卷闲遮眼，有意微尘破出经。\n思大气吞三世佛，儿孙未到败门庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9934,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"早发宁海寿宁道中过奉化","author":"释正觉","text":"晓径风香雨阵红，凿崖棱石上梯空。\n劝归鸟语春过半，投饭人家日正中。\n山怪翠寒台对偶，溪能柔碧剡相通。\n杨华便是浮萍草，踪迹又随流水东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9935,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱熙载作平阴令八十日致仕而归","author":"释正觉","text":"勇退归来适旧游，家林禾黍一成秋。\n黄芦雪照沙头屋，明月波浮江口舟。\n耕道谁从夫子后，逃禅今与老僧俦。\n柴桑试问陶彭泽，风味真醇相肖不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9936,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"机禅人出丐求颂","author":"释正觉","text":"尘刹分身看化机，青烟几处午家炊。\n面墙坐照丛林事，持钵丐缘云水饥。\n出谷鸟传春次第，漾舟人爱月相随。\n归来定有饱参句，笑解枯禅篾肚皮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9937,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"机禅人发心丐田","author":"释正觉","text":"历历机梭看转旋，衲僧手眼有千千。\n将知白雪上方饭，出自黄云负郭田。\n溉灌流金溪口月，耕犁卷幕陇头烟。\n和泥合水谁家事，参饱元无分外禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9938,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵传道者且游落星院","author":"释正觉","text":"风立沙根肤粟顽，冷涵星石水湾湾。\n登舟欲济轩窗底，扶槛政疑图画间。\n云拭山容苍玉障，日浮江面紫金环。\n回头五老相招我，林友无嫌夜扣关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9939,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵真歇和尚圆觉经颂一十四首 其一 大光明藏","author":"释正觉","text":"衲僧拨转铁牛机，默耀灵通底是谁。\n月兔影沉云母地，海禽梦卧珊瑚枝。\n韶阳佛法嫌饶舌，鲁祖家风解惜眉。\n端坐环中虚白处，纵经尘劫个难移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9940,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵真歇和尚圆觉经颂一十四首 其十 净诸业障菩萨章","author":"释正觉","text":"證语由来把柄长，重重脱处雪加霜。\n众生相在犹流浪，寿命根除自息狂。\n退骨龙能将雨去，蜕鳞鲲复得风翔。\n郢人斲尽蝇泥也，方见元初鼻孔光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9941,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵真歇和尚圆觉经颂一十四首 其六 弥勒菩萨章","author":"释正觉","text":"痴根爱种力锄除，一段灵明是旧基。\n插草天人深会意，拈华尊者笑开眉。\n鱼行大士须珍重，布袋憨僧且伏惟。\n处处鼻头相撞磕，唯心境界你谩谁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9942,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵真歇和尚圆觉经颂一十四首 其十三 贤善首菩萨章","author":"释正觉","text":"陀罗尼句觉皇宣，一略闻名胜施缘。\n端见髓心相付嘱，莫将耳口作流传。\n顿机做处天飞电，大器任时海纳川。\n不是老婆情分切，肯留文字破尼乾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9943,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵真歇和尚圆觉经颂一十四首 其五 金刚藏菩萨章","author":"释正觉","text":"黄金出矿断前疑，岸走舟安觉所欺。\n动目是渠摇湛水，聚萤无我灼须弥。\n翳消便见飞华尽，机迅将知击电迟。\n识得堆堆庵内主，外魔那得到藩篱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9944,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵真歇和尚圆觉经颂一十四首 其八 威德自在菩萨章","author":"释正觉","text":"门开三观莫迟留，得路行行到始休。\n鉴像照心无所住，楼钟出碍有来由。\n顶中具眼如天主，肘后分符似国侯。\n应世度生游幻海，月船风棹驾涛头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9945,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵真歇和尚圆觉经颂一十四首 其十四 总颂","author":"释正觉","text":"木童吟处槁回春，个里庄严功德林。\n垂手断崖知路活，藏身空劫忌机沈。\n未翻识浪无多子，不挂唇皮有一音。\n佛祖契心言迹外，炷香清坐与追寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9946,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵真歇和尚圆觉经颂一十四首 其十二 圆觉菩萨章","author":"释正觉","text":"选场随手取标毬，长短期中入社流。\n觉后绳绳机自脱，悟来密密类难收。\n十分饱足雪山草，一色浑成露地牛。\n风扫水天尘翳尽，芦华相照月明秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9947,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵真歇和尚圆觉经颂一十四首 其七 清净慧菩萨章","author":"释正觉","text":"觉了前前非处难，而今步步到长安。\n色心㳷合无丝路，法性圆融没许般。\n个事本来元脱洒，几人到此出颟顸。\n妄亡起灭功成也，应笑风幡动刹竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9948,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵真歇和尚圆觉经颂一十四首 其三 普贤菩萨章","author":"释正觉","text":"侬家活计本天然，刹刹尘尘见普贤。\n犀角一星蟾影透，神珠九曲蚁丝穿。\n觉非渐次亡棱缝，幻自消镕得混圆。\n妙应通身无向背，古菱花不染媸妍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9949,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵真歇和尚圆觉经颂一十四首 其十一 普觉菩萨章","author":"释正觉","text":"药病相攻双去难，心华开发自家禅。\n天真历历非修證，日用堂堂岂授传。\n高步丹霄知得计，止啼黄叶信成权。\n底时屑屑行泥滓，可笑蜗牛自涴涎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9950,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵真歇和尚圆觉经颂一十四首 其四 普眼菩萨章","author":"释正觉","text":"谁从普眼道场来，天帝堂前珠网开。\n彻底光明成一段，个中清净绝纤埃。\n交罗理事真空观，照破根尘不夜台。\n恰恰相应尔时节，陶家壁上起梭雷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9951,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵真歇和尚圆觉经颂一十四首 其九 辩音菩萨章","author":"释正觉","text":"妙圆单复绝中边，五五机轮互换难。\n弦管调来声律合，梭丝织出锦文观。\n身心一一能分应，手眼千千不可谩。\n似付盐梅岩叟用，和羹无复见咸酸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9952,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"次韵端楞伽与生首座","author":"释正觉","text":"缚茨枯坐九江东，镜像虚融方寸中。\n舜若多身禅夜看，母陀罗臂用时通。\n缘生谁兆有非有，寂照自知空不空。\n道契观音斯善应，萧萧竹雨杂松风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9953,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行月大师求颂","author":"释正觉","text":"霁明夜永月行空，破暗真光默默中。\n一点至灵虚且应，十方圆鉴照而冲。\n床头炉篆浮寒紫，壁上龛灯对冷红。\n个里宗乘消息在，蒲团纸帐旧家风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9954,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"行通善友求颂","author":"释正觉","text":"明白家风月洗霜，道人寒夜坐绳床。\n安身谁效兔三窟，返照自如龟六藏。\n疑若蛇弓蟠酒盏，妙同蜂蜜得华房。\n默游宛转臻元极，虚廓无涯步大方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9955,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"观知殿化殿堂灯油求颂","author":"释正觉","text":"广堂清白照蒲团，相续真灯未许残。\n寂默无声闲口醭，光明不掉寸心寒。\n莲开似对秋波浅，梦觉浑疑晓漏乾。\n十法界身流影事，自他交彻镜中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9956,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访杨才叔不遇留偈斋舍","author":"释正觉","text":"呼筇起寂下云居，寒麓回春寻友于。\n烟染草芒三径暗，雪晞麦脚一锄濡。\n欲求真语涤尘想，那畏峭风生粟肤。\n不见诗郎归怅怏，清癯时对石菖蒲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9957,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"访黄给事承往宝陀礼普门大士留偈","author":"释正觉","text":"泛舟谁畏海门津，丈室来寻彼上人。\n麈语欲求青眼旧，友心未爽白头新。\n黄家羊卧藩篱晚，梅氏仙游岛屿春。\n糊饼馒头看手段，观音妙智在尘尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9958,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过虎头岩","author":"释正觉","text":"空岩俨若虎头苍，云腻岩前草木光。\n竹吐锦萌春雨饱，松含黄粉野吹香。\n石床蟠足散征倦，道境洗心聊坐忘。\n投饭上方兰若去，未能痴学顾长康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9959,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"过般若庵","author":"释正觉","text":"重轩瘦立曲栏头，岛屿青微冷枕流。\n望眼解随沙水转，赏心真与岸云浮。\n平分野色连延屋，点破江光相趁舟。\n般若空宗深得义，森罗元不碍人休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9960,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"齐上人发心知罗汉堂求颂","author":"释正觉","text":"修结僧缘清净因，青油白茗与乌薪。\n庞眉五百圣尊者，行脚一千吾上人。\n云屋芳姿开菡萏，地炉煖气卧麒麟。\n睡魔不至蒲禅稳，自照光明默默神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9961,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"馀姚胡氏绣观音求颂","author":"释正觉","text":"线蹊密密度金针，一一针针观世音。\n妙净庄严成相好，光明感应发身心。\n江横练色月浮水，雨灌华枝春在林。\n闻见可中超有路，普门处处许相寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9962,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初禅人持钵求颂","author":"释正觉","text":"佛事潜通兴化门，用时斤斧莫成痕。\n全机超出轮回际，一句拔除生死根。\n凉吹洗磨烦袂暑，素蟾排逐夜台昏。\n鹅王引饮唯醇味，水乳斯分不我浑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9963,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别五祖山悦众","author":"释正觉","text":"东山聚散亦夤缘，华吐芳姿柳锁烟。\n肯处根尘非一一，用时手眼恰千千。\n塔中祖有相传事，岭外人元不会禅。\n后日能来圆此话，未嫌敲枕唤春眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9964,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别陆尚书","author":"释正觉","text":"千里同风德不孤，心秋觉月照空壶。\n两头坐断何生死，一点圆明异有无。\n木马寒嘶青草坞，泥牛春种白云区。\n见闻佛事谁迎背，用处全机道转枢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9965,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别环首座","author":"释正觉","text":"雪立空庭畴堕宾，丹山握手履芳尘。\n石人破晓初移位，玉女羞明却转身。\n去意江湖频挂梦，回头棠棣一成春。\n丛林衰色待膏沃，侧耳风霆起蛰鳞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9966,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别觉知藏","author":"释正觉","text":"一从豆颗爆寒灰，头角峥嵘顶目开。\n碧玉盘中珠宛转，琉璃殿上月徘徊。\n木人顾影当明去，石女披云半夜来。\n偏正功圆须转位，入廛垂手类难该。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9967,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"别满首座","author":"释正觉","text":"丹山凤窟冷相依，惭愧如今羽翼齐。\n云外翔鸣同颉颃，林间啄步暂分携。\n玉华衔处天容晓，珠树栖时月影低。\n引喙醴泉期后会，殆将新语濯尘泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9968,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妙禅人出丐求颂","author":"释正觉","text":"劫壶浩浩洗魔缘，妙处真观自见前。\n的的未萌明宾际，灵灵无得入深禅。\n风抟海运鲲将蜕，月皎沙寒鹭不眠。\n触事投谐能转变，何妨大浪驾空船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9969,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"妙慧上人求颂","author":"释正觉","text":"妙中有慧独醒醒，历历机前自照灵。\n老兔梦寒眠净魄，真犀心醉得通星。\n道游刹刹参诸佛，智破尘尘出大经。\n顽石点头挥麈尾，坐间华雨一番馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9970,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"应禅人开田求颂","author":"释正觉","text":"飘飘捉杖出烟萝，行丐身心遽许多。\n针鼻细中投玉线，机头密处度金梭。\n应缘片片云成雨，分照团团月在波。\n底意周旋便回首，旧巢寒卧雪林柯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":9971,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]