[{"title":"和九兄古梅","author":"苏泂","text":"处女何因发半华，一生蓝缕在贫家。\n冷灰豆爆真奇事，枯树中间忽数花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73983,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵宫管看梅三首 其三","author":"苏泂","text":"水边山下懒寻伊，折放瓶中看一枝。\n一片飞来沾砚滴，似嗔老子不题诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73984,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵宫管看梅三首 其二","author":"苏泂","text":"缚屋疏疏傍柳塘，诗肠浑不畏田荒。\n今年天赐清修福，只咽梅花一味香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73985,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和赵宫管看梅三首 其一","author":"苏泂","text":"除却梅花不可无，梅花之外更何须。\n花中儿女纷纷是，唯有梅花是丈夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73986,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和黄观复梅句","author":"苏泂","text":"梅花骨相本通仙，何况苔枝缀玉鸾。\n如著官袍更潇洒，不应将作女人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73987,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和颍叟弟春句","author":"苏泂","text":"厌听鸠妇屋头声，十日何曾五日晴。\n一到红芳了归去，几多时便绿阴晴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73988,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜二首 其二","author":"苏泂","text":"明月在天上，流光遍草莱。\n平生一樽酒，思与故人开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73989,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜二首 其一","author":"苏泂","text":"明月耿清夜，乱蛩啼草根。\n幽人浑未寝，独自倚柴门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73990,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜句三首 其三","author":"苏泂","text":"四更过尽五更来，看见参旗卷复开。\n澄澈定非人世酒，就渠斗柄酌三杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73991,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜句三首 其二","author":"苏泂","text":"一派天边淡淡横，虽然无浪有风生。\n人间各自昏沉睡，看到三更刬地清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73992,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜句三首 其一","author":"苏泂","text":"儿女咿嘤斑竹床，蜩螗六月沸如汤。\n登楼谁问牛郎事，只看银河意已凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73993,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夜汎","author":"苏泂","text":"澄波湛湛接新秋，月子波心印一钩。\n荷叶乱花看不见，夜深时有小龙游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73994,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"奉和知县兄","author":"苏泂","text":"苍烟湿湿雨微微，一榼山醪手自提。\n看了梅花来看竹，春寒如水不曾知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73995,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"岩壑兄去岁此时作春前四绝句姿媚可爱然犹有遗者因复作一首","author":"苏泂","text":"萦风送腊回，生意遍陈荄。\n似织如丝处，春从里许来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73996,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"建邺即事","author":"苏泂","text":"凄凄风雨病情怀，准拟东归事不谐。\n买得扁舟如箬叶，又随明月过秦淮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73997,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"往回临安口号八首 其八","author":"苏泂","text":"吟诗一日便东归，吟到楼头日色西。\n今度重来有吟兴，湖边寺寺与留题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73998,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"往回临安口号八首 其七","author":"苏泂","text":"天竺前头灵隐东，山川奇崛自玄工。\n旧时可是不曾看，今度重来看不同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":73999,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"往回临安口号八首 其六","author":"苏泂","text":"清晓无车一仆随，南山行遍北山来。\n日长搭得回船去，薄暮涌金门尚开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74000,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"往回临安口号八首 其五","author":"苏泂","text":"戒子桥南白塔西，青桐新长盖楼枝。\n轻风忽向楼前过，不似长安店里时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74001,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"往回临安口号八首 其四","author":"苏泂","text":"江湖漂荡旧刘郎，不饭经旬病在床。\n起见旧交仍慷慨，绝怜鬓底有新霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74002,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"往回临安口号八首 其三","author":"苏泂","text":"道傍举首揖髯陈，领得秋塘句法新。\n归饭客楼随取别，隔桥相见两诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74003,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"往回临安口号八首 其二","author":"苏泂","text":"老铦相见一欣然，说似艰虞是去年。\n从此新诗更超诣，时人欲杀岂无天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74004,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"往回临安口号八首 其一","author":"苏泂","text":"高丽寺里访诗僧，懒上湖船独自行。\n行到寺前人迹少，不知傍有白云迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74005,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"所忆","author":"苏泂","text":"一陂潭水绕花身，渌净分明照得人。\n最忆蒋陵西曲路，春风相伴两乌巾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74006,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"所思","author":"苏泂","text":"香炉峰顶行人绝，曾借匡庐带雪看。\n今日东州逢六月，恍然回首一清寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74007,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"放翁入朝后寄","author":"苏泂","text":"贞元朝士已无遗，白发当权更有谁。\n六十还朝今八十，却归修史几人知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74008,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"放翁宠赐正月九日诗翰","author":"苏泂","text":"一篇盈轴粲龙蛇，归自黄州政尔嘉。\n大似新年逢好事，春风吹宝入贫家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74009,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"松桂堂","author":"苏泂","text":"伯夷能使鄙夫宽，此老传家不在官。\n魂梦犹能教儿息，九原风节更高寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74010,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"武昌","author":"苏泂","text":"南楼丝管日纷纷，一带春江浸碧云。\n遗老相逢问年几，白头閒话岳将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74011,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊头陀寺","author":"苏泂","text":"世上身名孰是非，维舟日日钓鱼矶。\n长江天阔不知处，夏口青山人夜归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74012,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"泊祠下诗","author":"苏泂","text":"潮小淹留孝子祠，雪花须要老夫诗。\n钟声篷底不知处，却似姑苏夜泊时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74013,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苕溪杂兴四首 其四","author":"苏泂","text":"笔判虚空也太奇，古今天下几多诗。\n虚空判了元无尽，信手拈来自不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74014,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苕溪杂兴四首 其三","author":"苏泂","text":"只道还家犹未还，故山书册蠹鱼残。\n半生不疗饥寒苦，空有诗名满世间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74015,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苕溪杂兴四首 其二","author":"苏泂","text":"美人楼上晓梳头，人映清波波映楼。\n来往舟行看不足，此中风景胜扬州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74016,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"苕溪杂兴四首 其一","author":"苏泂","text":"斜风细雨转船头，夜半波平带月流。\n行到下菰城畔望，水晶宫阙是湖州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74017,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"虎丘剑池","author":"苏泂","text":"剑石光寒响辘轳，轩窗高下尽平芜。\n山中幸自清如水，好换缁流著士夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74018,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"采菱","author":"苏泂","text":"引蔓搴花钓艇妨，游飏锦浪霅溪傍。\n若教总不餐烟火，只采芳香亦味长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74019,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一六九","author":"苏泂","text":"压架荼蘼百万枝，月边花下更涟漪。\n三更比屋皆高枕，如此清凉弃不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74020,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其二十一","author":"苏泂","text":"青溪阁上看青春，一度春风一度新。\n堪笑南朝江令老，北朝依旧作词臣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74021,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其九十七","author":"苏泂","text":"梦得当时五绝诗，一回吟起一回悲。\n试偷格律无人识，只恐王家燕子知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74022,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其六十九","author":"苏泂","text":"陶山松柏已成阴，地阔天高不可寻。\n二十年中儿又女，人间独自有伤心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74023,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一五四","author":"苏泂","text":"马军骁骑试楼船，见说倾城出道边。\n元帅留台都赏赐，一时百万喝金钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74024,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其七","author":"苏泂","text":"有时幽鸟百般啼，无数阶头萱草齐。\n第一怕听泥滑滑，再三莫放雨凄凄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74025,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一九六","author":"苏泂","text":"兵机将略总如神，儒术仍参席上珍。\n补得国风成百咏，不妨幕府有诗人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74026,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其三十四","author":"苏泂","text":"内官折送御园梅，历剌如薪苦不才。\n安得昌原带苔树，疏花分得几枝来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74027,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其二十三","author":"苏泂","text":"客怀元不间春秋，柳绿花红见亦愁。\n第一不如归去好，东皋犹幸有锄耰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74028,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一八七","author":"苏泂","text":"前日葵苗匝地青，几何时节与人平。\n旁观指点荼蘼架，折蕊攀条似隔生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74029,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其六十","author":"苏泂","text":"睍睆飞来载好音，分明残夏胜春深。\n小窗谁作幽人伴，惟是炉香共绿阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74030,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一一四","author":"苏泂","text":"老大驱驰亦已劳，移文宁受客嗤嘲。\n人间多少閒田地，无处令渠著把茅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74031,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其七十","author":"苏泂","text":"寻诗还步小虹桥，薄日轻阴叫百劳。\n芦叶深青荷叶紫，江湖从此兴滔滔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74032,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一一二","author":"苏泂","text":"江流带雪少波澜，见说潮头也怕寒。\n未枉推敲瘦诗骨，且令澄澈瑩中肝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74033,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其五十八","author":"苏泂","text":"香罗初换裌衣新，除却垂杨不是春。\n昨日街头骑马过，眼明犹见卖花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74034,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一四五","author":"苏泂","text":"青山渺渺水迢迢，王气千年久未消。\n独客重来睹风景，江头犹有女吹箫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74035,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其八十一","author":"苏泂","text":"观殿今年七十八，往时同饭此斋前。\n梁金华石依然在，屈指重来十五年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74036,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一四一","author":"苏泂","text":"十里城壕尽是花，覆舟山下几人家。\n日长知道游车倦，自汲新泉唤饮茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74037,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一○八","author":"苏泂","text":"花案妆来日日新，金陵犹有许多春。\n若为造物回芳意，尽结嘉禾活饿人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74038,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一一六","author":"苏泂","text":"高世何须更欲名，古人于此畅幽情。\n后来同味无王谢，自折幽兰上冶城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74039,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一六四","author":"苏泂","text":"九十春光即渐休，莫将双眼上层楼。\n江南归计无由遂，一点杨花万斛愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74040,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其八","author":"苏泂","text":"蒌蒿登盘朝饭美，河鲀入市晚羹香。\n应无白傅思春草，却有东坡赋海棠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74041,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其三","author":"苏泂","text":"浪说思家不我听，萧斋闲对竹青青。\n若为解释妻儿念，读尽栾城道德经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74042,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一三七","author":"苏泂","text":"曲曲清溪有几湾，酒船笳鼓去仍还。\n閒情自合频来此，只在州衙咫尺间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74043,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一六五","author":"苏泂","text":"月楼谁伴咏黄昏，剪剪轻风阵阵寒。\n独据槁梧成不寐，杏花生影小阑干。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74044,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一七八","author":"苏泂","text":"听筝堂上一欷歔，翻手君恩似昔殊。\n按罢金縢应莫怪，近前閒捋使君须。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74045,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一八○","author":"苏泂","text":"方山四面不曾圆，中有仙人号葛玄。\n见说丹成浑不食，五云破洞白升天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74046,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一八四","author":"苏泂","text":"高资冢上五楼穹，先祖曾经相哲宗。\n乱后伤心馀石马，小孙来补万株松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74047,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其九十三","author":"苏泂","text":"朱园应是好花开，最忆西庄送别杯。\n火急封书寄子大，少留春色待归来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74048,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一二二","author":"苏泂","text":"葛巾裹却葛天民，有女闺中号燕春。\n只在西湖不行脚，金陵风月欠斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74049,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一一三","author":"苏泂","text":"笑谈容易发仓囷，全活生灵百万人。\n十五年来山里坐，不妨来此越精神。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74050,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其十四","author":"苏泂","text":"南位之南下曲街，画罗窗户隔红梅。\n方方丈石平如掌，曾是官家拜斗来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74051,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其二十二","author":"苏泂","text":"铁钱转手变铜钱，父老相传喜欲颠。\n未必颍川能若此，画图随处有香烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74052,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其六十二","author":"苏泂","text":"桂棹青溪夜泊船，胡床歇马坐江边。\n一声笛罢不知处，两不交谈意已传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74053,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一○五","author":"苏泂","text":"窗间日日叫提壶，有酒分明不用沽。\n自是老来游兴懒，日长添得睡工夫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74054,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其七十一","author":"苏泂","text":"幽草沿阶翠织成，初荷经雨碎珠生。\n藕丝道服松毛扇，独自花间趁鹿行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74055,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其六","author":"苏泂","text":"稍经运渎过潮沟，野草闲花触处愁。\n二十四航春水满，有谁来此上扁舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74056,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其八十","author":"苏泂","text":"城西二里楚金陵，吴帝名为石首城。\n如今土坞无青草，笑杀当时所必争。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74057,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其二十五","author":"苏泂","text":"蘼芜涧边春草青，桃叶渡头江水生。\n女郎到此歌一曲，不尽今来古往情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74058,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其一二四","author":"苏泂","text":"中年多病才都减，无奈金陵景物何。\n安得山楹周四者，肯来相伴此吟哦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74059,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"金陵杂兴二百首 其三十八","author":"苏泂","text":"四望庭中四望花，青春那属外人家。\n中间更著垂垂柳，自倚东风待翠华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":74060,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]