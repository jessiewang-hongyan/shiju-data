[{"title":"山中忆鹤林 其四","author":"白玉蟾","text":"苍崖兮巍巍，对落花兮倚斜晖。\n猿啼兮鹤唳，望美人兮天一隅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26321,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"山中忆鹤林 其二","author":"白玉蟾","text":"可惜兮春光，芹泥香兮燕忙。\n花红兮水暖，望美人兮天一方。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26322,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"布袋和尚赞","author":"白玉蟾","text":"布袋包尽太虚空，拄杖击破三千界。\n世界若还击得碎，拄杖何止如许大。\n若言包得太虚空，虚空却在布袋外。\n如何偏爱此等物，常与小儿作一队。\n问世人，会不会。\n夺了他拄杖，抢了他布袋。\n打杀许多小孩儿，看他弥勒何能解。\n弥勒抚掌笑呵呵，明月清风无挂碍。\n等到龙华三会时，依前有一弥勒在。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26323,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"师祖鸡足紫贤真人赞","author":"白玉蟾","text":"秃头俭相，做尽模样。\n张平叔若不再来，石得之不成信向。\n你即是道光和尚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26324,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红岩感怀四首 其四","author":"白玉蟾","text":"草青兮烟冷，山苍苍兮水楚楚。\n山深兮地僻，青鸟不来兮凄苦。\n断烟兮荒草。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26325,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红岩感怀四首 其三","author":"白玉蟾","text":"风悲兮花落，鸟哀哀兮水簌簌。\n水寒兮石苍，幽人自感兮茕独。\n古洞兮枯木。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26326,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红岩感怀四首 其二","author":"白玉蟾","text":"猿啼兮鸟哀，风飕飕兮雪皑皑。\n雪霁兮云收，思我故人兮伤怀。\n古径兮苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26327,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红岩感怀四首 其一","author":"白玉蟾","text":"山高兮风寒，烟濛濛兮雨漫漫。\n雨霁兮雪飞，半夜无人兮倚栏。\n明月兮空山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26328,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"许紫冲求真容赞 其一","author":"白玉蟾","text":"虎已伏，龙已降，猕猴不复窥六窗。\n万籁无声秋夜静，一轮明月照西江。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26329,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"许紫冲求真容赞 其二","author":"白玉蟾","text":"卢山之下，绣谷之中。\n一江夜月，万壑松风。\n此意谁能委，岳阳城外松。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26330,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"周伯神喜神赞","author":"白玉蟾","text":"方丈老仙客，寸心水一滴。\n双脸红朱砂，两眼点黑漆。\n白须抚掌笑呵呵，白鹤一去无人识。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26331,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孤雁叹","author":"白玉蟾","text":"孤雁声嚘嚘，忧如司马牛。\n君不见煮豆燃豆萁，斯人者斗米尺布渠岂羞。\n知有鹡鸰在原不，知有棠棣之华不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26332,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"知宫王琳甫赞","author":"白玉蟾","text":"青布衲，碧藜筇。\n诗吟白芍药，曲唱紫芙蓉。\n一局著残人事醒，七弦弹破世间空。\n时乎泛一叶于沧海之外，时乎飞片羽于虚空之中。\n铁笛横吹老龙泣，金樽一倒琪花红。\n孤猿啸夜月，淡露滴秋风。\n云锦溪深碧无底，天苍山秀绿不穷。\n白鹤卧占眠牛草，丹鹊飞上栖鸦松。\n真人一声长啸于蓬莱之东，青童回首指道神仙中之最雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26333,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"隶轩真赞","author":"白玉蟾","text":"骨气已神仙，玄圃挺生贤。\n面上四时春，心次一壶天。\n人皆就法门栋梁上踔他光景，我道隶轩高士志趣飘然。\n若也未知涯涘，为君指出言诠。\n丹成若未归蓬岛，且结溪山风月缘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26334,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"种桃斋写神赞","author":"白玉蟾","text":"南海琼山子，香山居士孙。\n习文不若陆贾，习武不如孙膑。\n八千馀里琴剑，二十一年水云。\n偶过庐山之下，痛饮蟾溪之滨。\n纵饶画得十分似，何似天边一月轮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26335,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送谈执权张南显归广州","author":"白玉蟾","text":"七月送我东南道，八月送我西南道。\n西南江沙黄茫茫，东南海水白浩浩。\n海水飞作潮头来，潮头卷取潮舌回。\n江沙一望渺千里，千里亦此一江水。\n水外青山山外云，云边苍树树边村。\n村有酒酤酤不得，小船寂寞愁黄昏。\n大丈夫，不拘此。\n无酒便如何，有酒亦乐只。\n为问东南海水西南江，如何滔滔独未降。\n岂不亦笑老先生，有如此水亦迷邦。\n君但归，归去好，人生有情为情恼。\n明朝轻舟当径度，不须回首端州路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26336,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秽迹赞","author":"白玉蟾","text":"宝杵动时天地黑，镮铃震处鬼神惊。\n释迦临入涅槃日，六欲天中现此身。\n现此身，无边际。\n太圆镜中点检看，个个三头并六臂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26337,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"曾祖圣师真一还源真人赞","author":"白玉蟾","text":"杏林驿，雪之夕。\n老师张，弟子石。\n凛凛清风生八极，那些儿消一滴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26338,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叠字招隐 其二","author":"白玉蟾","text":"逐逐且贪怎足。\n恋松楸，爱莲菊。\n食玉衣锦，池酒林肉。\n瓮埋地阁钟，月泻天窗瀑。\n郑卫殆塞其聪，赵燕可盲其目。\n镜盟钗诅谩交交，马迹车尘何仆仆。\n名伤神兮宠辱若惊，事掣肘兮进退惟谷。\n一真妄兮故知空不空，观徼妙兮常有欲无欲。\n吾将先天后天明月之珠，裁作左仙右仙宾云之曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26339,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"叠字招隐 其一","author":"白玉蟾","text":"逐逐何时知足。\n来归山，共种菊。\n有松为酒，有藜当肉。\n亦有涧底芝，亦有岩上瀑。\n白日自觉如年，青山长是对目。\n闲云与充封门人，清风为作扫室仆。\n朝宴息乎长松之阴，夜偃仰乎冷翠之谷。\n我无涕唾津精气血液，了绝喜怒哀乐爱恶欲。\n练空碧毓紫冲兮身如玉，乘气御飞兮咏九霞之曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26340,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"颐庵喜神赞","author":"白玉蟾","text":"江月射双眼，岩云飞两眉。\n自是上饶一团和气，点化自家方寸真机。\n能落笔作泣鬼神之诗，能坐石下烂柯之棋。\n千人万人，瞻礼不已。\n笑骑白鹿，独步天墀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26341,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"潘龙游喜神赞","author":"白玉蟾","text":"龙章凤姿，既非嵇叔夜。\n燕颔虎颈，又非班定远。\n机鸣籁动，听其自然。\n虚心何物，何增何损。\n花满一壶春色好，半班顿露与人看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26342,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头","author":"白君瑞","text":"凉吹拂衣袂，助我上高台。\n云檐风栋，窗户绝纤埃。\n四绕江山雄丽，万古盘龙踞虎，壮气锁崔嵬。\n二水中分远，艇子自归来。\n望白云，迎碧汉，俯长淮。\n铎声到耳，亭亭孤塔现林隈。\n烟惹宫城深树，日照酒楼帘幕，物象眼前排。\n长啸下梯径，欲去更徘徊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26343,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风入松 寄故人","author":"白君瑞","text":"一冬不见雪花飞。\n爱日荡晴晖。\n腊残未解寒塘冻，东风细、已露春期。\n正是年时策马，相随村落寻梅。\n故人别久信音稀。\n排闷有新诗。\n雁声北去江城暖，暗舒展、花柳容仪。\n屈指烧灯不远，等闲休锁双眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26344,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"念奴娇 寄临安友","author":"白君瑞","text":"江干蹭蹬，镇寻常、怀想京城春色。\n静倚山亭凝望处，惟见鸟飞云幂。\n拂面埃尘，跳□□□，老却风流格。\n年来却有，短蓑轻棹胸臆。\n闻与俊逸嬉游，笙歌丛里，眷恋中华国。\n况是韶阳将近也，应办青骢金勒。\n丰乐阑干，西湖烟水，遍赏苏堤侧。\n举觞须酹，天隅犀渚孤客。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26345,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"柳梢青 曹溪英墨梅","author":"白君瑞","text":"玉骨冰姿，天然清楚，雪里曾看。\n物外幽人，细窥天巧，收入毫端。\n一枝影落云笺。\n便似觉、清风夜寒。\n试向松窗，等闲一展，俗虑都捐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26346,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满江红","author":"白君瑞","text":"木落林疏，秋渐冷、芙蓉新拆。\n傍碧水，晓妆初鉴，露匀妖色。\n故向霜前呈艳态，想应青女加怜惜。\n映朝阳、翠叶拥红苞，闲庭侧。\n岩桂香，随飘泊。\n篱菊嫩，陪幽寂。\n笑春红容易，被风吹落。\n满眼炯然宫锦烂，一身如寄神仙宅。\n把绿尊、莫惜醉相酬，春工力。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26347,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠丁和","author":"白侍郎","text":"步入罗湖石径斜，阴阴乔木锁烟霞。\n小桥流水君须记，便是丁和处士家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26348,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"铁袈裟","author":"白彦惇","text":"步绕危峰渡翠崖，扪萝初上更崔嵬。\n他年若有寻真分，定结茅庐傍此台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26349,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赤日炎炎似火烧","author":"白胜","text":"赤日炎炎似火烧，野田禾稻半枯焦。\n农夫心内如汤煮，公子王孙把扇摇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26350,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游青城山","author":"白逊","text":"青城山中云茫茫，龙车问道来轩皇。\n当封分为五岳长，天地截作神仙乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26351,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"白逊","text":"鹿随采药携家去，鹤恐飞仙佩箭归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26352,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"白逊","text":"上清宫殿与云齐，六六峰朝万岭低。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26353,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"白巽","text":"分符真吏隐，燕寝傍岩栖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26354,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"东屯行","author":"白巽","text":"雨足稻畦春水满，插秧未半青短短。\n马尘追逐下关头，北望东屯转山坂。\n一川洗尽峡中想，远浦疏林分气象。\n沟塍漫漫堰源低，滩濑泠泠石矶响。\n中田筑场亦有庐，翚飞夏屋何渠渠。\n李氏之子今地主，少陵祠堂疑故居。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26355,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"合江探梅","author":"白麟","text":"艇子飘摇唤不回，半溪清影漾疏梅。\n有人隔岸频招手，和月和霜剪取来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26356,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诗一首","author":"白麟","text":"谁破天荒开僰道，千栽岩木护天宫。\n背城山合疑无路，面水窗横自有风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26357,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"峨眉","author":"白麟","text":"四海佛宫阙，三峨不待誇。\n山深龙听法，野迥鹿衔花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26358,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"盘溪之游前一日知几太博行矣同令君梅下清饮不无怅然吾人会合之难再赋绝句 其一","author":"白麟","text":"君去我来吟赏地，盘溪环绕翠微中。\n溪人似秘惊人语，不许从容一醉同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26359,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"盘溪之游前一日知几太博行矣同令君梅下清饮不无怅然吾人会合之难再赋绝句 其二","author":"白麟","text":"骑鲸人去醉吟来，公子风流尊为开。\n笑问竹间梅淡泊，何如筵上舞低回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26360,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游盘溪园亭二首 其二","author":"白麟","text":"爱梅爱竹爱溪山，可惜天公未放閒。\n待学盘溪溪上老，松门虽设日常关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26361,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游盘溪园亭二首 其一","author":"白麟","text":"割忙载酒把寒来，指点盘溪花未开。\n撼动东风须好句，扫除积雪放春回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26362,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寓居叙南","author":"白麟","text":"僰道古戎州，何人开天荒。\n向者名胜流，经兹水云乡。\n少陵三百年，继踵山谷黄。\n二老经行处，草木生辉光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26363,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"白麟","text":"三峨影漾沧浪里，万景烟笼缥缈中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26364,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉祐寺留别丕上人","author":"皮公弼","text":"两年无惠及编氓，蜀道天难六月行。\n深羡高僧捐世累，竹风湖处听泉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26365,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"皮公弼","text":"壁山老守似僧家，无酒无歌度岁华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26366,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青阳驿 其一","author":"石才孺","text":"幸蜀奔波为禄儿，闻铃夜雨有馀悲。\n青阳一夕难高寝，黼幄千官减盛仪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26367,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"青阳驿 其二","author":"石才孺","text":"锦绷只拟情方昵，绣袜那知祸已成。\n自古覆车循一辙，哲王宁不玷聪明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26368,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧归护国寺","author":"石中立","text":"振锡来京辇，薰兰近赐衣。\n种莲曾结社，指柏迥投机。\n旧寺千岩隔，归艎片席飞。\n禅心天海外，永夕望台辉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26369,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"石中立","text":"寻常不召犹相造，况是今朝得指挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26370,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"予自南京留守推官循资为掌书记由将仕郎超阶至朝奉郎得蜀嘉州友人相贺者因答之","author":"石介","text":"一循资走五千里，四遇恩超十六阶。\n自顾非才已过分，谁言英俊尚沉埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26371,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文中子 其一","author":"石介","text":"龙蛰河汾道不行，吁谟经济授诸生。\n由来房魏皆卿相，共辅文皇致太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":26372,"sha256"