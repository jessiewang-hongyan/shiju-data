[{"title":"偈颂一百一十七首 其四十三","author":"释绍昙","text":"九十日春今欲过，人生能见几韶光。\n秦源方被桃花误，隋岸还看柳絮狂。\n拄杖子，知不迁义，缄封不密，满口嚼冰霜。\n千言万语无人会，又逐流莺过短墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15322,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其四十二","author":"释绍昙","text":"祖父田园，积年荒废。\n农不务耕，渔专讨利。\n彻底掀翻自有人，去尽残芦并败苇。\n雁过长空，影沉寒水，字字声声说大义。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15323,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其四十一","author":"释绍昙","text":"家在蓬莱，霓裾粲霞。\n步虚声有节，观徼念无差。\n护剑苍虬鸣宝匣，听琴瘦鹤倚庭花。\n丹成九转，符扫群邪。\n不负东林莲社约，乘轺来访竺仙家。\n虎溪分未得，款吃赵州茶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15324,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其四十","author":"释绍昙","text":"人从雪峰来，接得乳峰信。\n报道古涧寒泉，涌出千丈飞雪。\n推倒妙高台，掀翻乌石岭。\n松山土主冷地翻身，隐潭龙王梦中惊醒。\n郎忙抖擞精神，念一道离怖畏真言，南无三满多，没驮喃，唵部龄，唵齿龄。\n吽吽，急急如律令。\n三世诸佛立地听，梵语华言难改正。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15325,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其三十九","author":"释绍昙","text":"独坐大雄峰，临机多弄险。\n遭虎口杀活不分，脱狐身真假难辨。\n那堪创立清规，平地深深坑堑。\n结成不共戴天雠，烧炷枫香解释休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15326,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其三十八","author":"释绍昙","text":"一点心灯，寒光灿烂。\n今古长明，几人著眼。\n诸方老冻脓，烧畬种粟，三呼三应，妙悟水因，眉间挂剑。\n虽然列焰分辉，当暗中有明，当明中有暗。\n而今拈出普请看，出格元宵，何妨赏玩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15327,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其三十七","author":"释绍昙","text":"正月一，是新年。\n家家庆贺，处处喧阗。\n惟有拄杖子，不随时变。\n松根稳坐，石上安眠。\n蓦地放憨歌一曲，啰啰哩啰啰哩啰。\n木人听不足，瘦立绿萝烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15328,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其三十六","author":"释绍昙","text":"半夜逾城，六年栖雪。\n饿得肠枯，冻得骨折。\n那更见明星，两眼添重屑。\n后代儿孙苦證羊，一年一度争饶舌。\n正法眼藏，宜乎向这瞎驴边灭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15329,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其三十五","author":"释绍昙","text":"簸弄乾坤，灵蛇在掌。\n露刃含霜，阿谁近傍。\n歼厥渠魁未得时，蛰龙护匣牢收抗。\n还他道地，剑州与太阿无两样。\n携来剪月亭前，共聚五湖禅流，拭目纵观，连声称赏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15330,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其三十三","author":"释绍昙","text":"扭碎东山鼻孔，牵断佛眼耳轮。\n一等施呈毒手，腕头力重千钧。\n饫饕法味，饱听圆音。\n汉室威仪重复见，紫芝香散碧岩春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15331,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其三十一","author":"释绍昙","text":"大智洞明，十方虚彻。\n玄枢妙转，千圣迷踪。\n直饶透箐眼明，截流机峻。\n须知更有向上一路在，这里见得彻去，方知东山五祖老冻脓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15332,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其三十","author":"释绍昙","text":"书载五云，绣添一线。\n剥尽群阴，天心复见。\n惟有龟毛拂，今古无迁变。\n松根石上笑谈空，切忌随他语脉转。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15333,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其二十九","author":"释绍昙","text":"荆棘林，大火聚。\n峭壁深坑，无栖泊处。\n直饶伊瞥转一机，转得身，通得步。\n瑞岩未敢轻相许，何故凤栖不在梧桐树。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15334,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其二十八","author":"释绍昙","text":"没弦琴，有遗音。\n调高流水，声振缁林。\n碧眼黄头争品弄，无端花擘祖师心。\n瑞岩素非妙手，效颦弹一曲看。\n叮当叮当，绝听子期迷节奏，和云高挂古松阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15335,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其二十七","author":"释绍昙","text":"沧溟深，未必深。\n须弥险，未必险。\n衲僧家险崖机不可挨，深密心不可察。\n拄杖子忍俊不禁，试与探测看。\n深无半寸，平如镜面。\n浩大雷声，全无雨点。\n只好深云龟六藏，佛眼迷踪寻不见。\n寻得见，瑞岩点一杯茶，徐徐向伊道，日暮穷途，家乡尚远。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15336,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其二十六","author":"释绍昙","text":"万叠青山，一溪流水。\n幽鸟绵蛮，烟萝锁翠。\n瑞岩活计无多，徒挂傍人唇齿。\n彻骨贫穷，熏天富贵。\n一阵西风丹桂香。\n二三子，吾无隐乎尔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15337,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其二十五","author":"释绍昙","text":"拄杖子，黑粼皴。\n韬藏头角，枯槁身心。\n刚被业风飘鼓，忙忙入草寻人。\n奔驰鸟道，簸弄驴唇。\n湖海听闻齐掩耳，只宜藏拙古岩阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15338,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其二十四","author":"释绍昙","text":"凤宿龙巢，宸车苔辗。\n前不搆村，后不迭店。\n疑杀天下人，自疑犹未免。\n瞥转一机，星驰电捲。\n飞来峰刮地风寒，冷泉水滔天浪衮。\n死句翻成活句传，大冶精金经百鍊。\n哑，退耕师兄，能事云周，一死何憾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15339,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其二十三","author":"释绍昙","text":"劄得脚跟牢，不怕风涛险。\n大田多稼如云，只要及时收敛。\n归来香积国经行，喜见飞檐翔唇吻。\n议赏元勋，高低有分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15340,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其二十二","author":"释绍昙","text":"寒空书雁，破壁吟螀。\n井梧翻叶，岩桂飘香。\n无位真人，横拖倒拽，无地埋藏。\n举世生盲人不识，分拿摸象恣猖狂。\n徒劳香至子，历魏与游梁。\n哑，鹊石何曾解放光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15341,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其二十一","author":"释绍昙","text":"截流机，分泾渭。\n清浊浅深，穷源倒底。\n三脚驴子弄蹄行，踏过何曾沾著水。\n芝峰家丑外扬，也是碓坊洿米。\n低声低声，墙壁有耳。\n座满江南客，何须唱鹧鸪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15342,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其二十","author":"释绍昙","text":"衲僧家，无本据。\n暑退凉生，任情去住。\n折拄杖，挑拨红尘堆里人，破草鞋，踏断枯木岩前路。\n无佛处，急赴过，有佛处，不得住。\n捏聚大千无寸土，业风吹上十二峰。\n来，徐徐向伊道，提鞋去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15343,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其十八","author":"释绍昙","text":"天地不仁，人心招感。\n田稼如云，一风消散。\n农家血泪流，肝肠断。\n惟有林间衲子，有亦不知，无亦不管。\n圆蒲拥雪衾，缀钵盛香饭。\n放憨一饱万缘空，冷笑傍人忙似钻。\n灼然如是，万两黄金也合消，其或未然，切莫怪阎家打算。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15344,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其十七","author":"释绍昙","text":"诸庄收敛，几样心肠。\n忧风忧雨，忧旱忧荒。\n刈禾镰虽云快利，要用处不犯锋铓。\n策勋汗血，别甑炊香。\n饭里有沙如咬著，方知禾熟不临场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15345,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其十六","author":"释绍昙","text":"一二三四五六七，数目分明谁委悉。\n李淳风与袁天纲，推尽先天算不出。\n算得出，昨日五月尽，今朝六月一。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15346,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其十五","author":"释绍昙","text":"半晴半雨，酿成梅溽。\n无位真人，口生白醭。\n玄谈发渊默之雷，妙应答传声之谷。\n花簇簇，锦簇簇，听不足，玩不足。\n哑，六六依前三十六。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15347,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其十四","author":"释绍昙","text":"苦涩菖蒲茶，胶粘青蒻粽。\n嗅著鼻头辛，咬得牙关肿。\n佛病祖病蠲除，妖星怪星惊悚。\n善才采药，飏在壁根。\n天师书符，抗藏衣笼。\n和盘掇出宴佳宾，山鸟山花欣然。\n锦绣铺陈，笙簧品弄。\n啰啰招，啰啰送，莫怪空疏，伏惟珍重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15348,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其十三","author":"释绍昙","text":"跛脚阿师，弄蹄驴子。\n一字关徒费分疏，栗棘蓬恣情吞吐。\n凌灭祖师禅，函盖乾坤句。\n孤危不立自孤危，万仞雪崖丰骨露。\n十二峰前，斫额望汝。\n洞山佛无光，无你扪摸处，无你栖泊处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15349,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其十二","author":"释绍昙","text":"净饭王宫积恶多，从天降谪个妖魔。\n指天指地胡挥揎，无柰通身秽污何。\n瑞岩无柄杓，恶水劈头浇，特石须顽也合消。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15350,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其十一","author":"释绍昙","text":"再世唐尧，更生虞舜。\n统御金轮，永膺天命。\n林泉何以报生成，一缕檀烟万佛名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15351,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其十","author":"释绍昙","text":"万叠青山，一溪寒水。\n花禁冷叶红，草滴虚岚翠，无位真人祇者是。\n不离当处当湛然，左右逢原无二体。\n觑之瞎双眸，即之云万里。\n祇如坚持汉节，贱卖生姜，妙悟水因，重光佛日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15352,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其九","author":"释绍昙","text":"国有世臣，伊周是则。\n神政冰清，忠谟鲠直。\n存方寸地子孙耕，黍稷非馨深种德。\n美则美矣，这争如何。\n巨辟十三华藏界，藏身无迹海腾波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15353,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其七","author":"释绍昙","text":"逼人上树拔却梯，推人入井覆却桶。\n江湖用此恶心肠，谁云契义金兰重。\n怪语颠言，开眼说梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15354,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其六","author":"释绍昙","text":"杓柄短长，锅儿大小，家丑无端花擘了。\n狼籍不小，惭惶不少。\n藏主师兄，平跋则个。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15355,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其五","author":"释绍昙","text":"入微尘，含法界。\n顶?机，看脚下。\n须弥灯王，冰消瓦解。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15356,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其四","author":"释绍昙","text":"瘦藤枝，乌律卒。\n入草寻人，揣空出骨。\n不是心不是佛不是物，贬向无生国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15357,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其三","author":"释绍昙","text":"十二瑞峰前，一火白拈贼。\n佛面夜叉心，是何等相识。\n烧香供养，使自知非，剪月初无陷虎机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15358,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其二","author":"释绍昙","text":"你面黄，我面黑。\n是马是驴，各随业力。\n蓦劄相牵入草窠，鼻头香臭不争多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15359,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百一十七首 其一","author":"释绍昙","text":"池开古镜奁，山耸青螺髻。\n急著眼来看，不得作境会。\n觌体全彰解脱门，一踏牢关百杂碎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15360,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十二","author":"释绍昙","text":"未见岑大虫，狐胆先惊破。\n密室不通风，家私狼藉了。\n更说新开乳窦山，无端刻粪作旃檀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15361,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十七","author":"释绍昙","text":"三百斤铁枷，数载无人荷。\n飏在壁根头，只得冤雠到。\n口款分明不可翻，老肩无力也须担。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15362,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十一","author":"释绍昙","text":"鼠窃竺乾，身逃震旦。\n合火分赃，儿孙无眼。\n死款诸方不言，今朝佛垄分明断。\n以何为据，看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15363,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九十四","author":"释绍昙","text":"南宕湖边，天台山上。\n踏断石桥，绝人来往，难透无过者。\n一关望崖，多少空惆怅。\n握不成拳，伸不成掌。\n活语翻成死款招，谩说藕丝牵玉象。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15364,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十九","author":"释绍昙","text":"玉几凌霄，横趋密室。\n如风吹水自成纹，掷剑挥空无朕迹。\n子细思量，令人气急。\n白木既无香，秤槌宁有汁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15365,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十九","author":"释绍昙","text":"入荒田不拣，信手拈来草。\n纬地与经天，头头俱是妙。\n打成一片见全功，碧眼黄头俱靠倒。\n岂不见长庆棱道者坐破蒲团，一个两个三个，四五六七个，家风狼籍知多少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15366,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其九","author":"释绍昙","text":"拘尸罗城，娑罗双树。\n死款难翻，贼身全露。\n引得波旬，丛然笑舞。\n后代儿孙口似椎，有屈谁伸诉，山花点滴啼红雨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15367,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十一","author":"释绍昙","text":"三伏走人间，炎蒸汗如雨。\n非无休歇时，亦无栖泊处。\n拄杖子，脊梁生铁铸，浩浩尘中能辨主。\n归来息影翠微深，抹月披云，截断千差路。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15368,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十四","author":"释绍昙","text":"撞烟楼，不知羞。\n辟蟭螟眼，辊百花毬。\n四七二三阿辘辘，不思万里有崖州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15369,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三","author":"释绍昙","text":"人家竞赏元宵，佛陇百无一有。\n管宴虽愧空疏，宾主不分新旧。\n陇头月助放光明，谷口松编排节奏。\n春风舞袖乐升平，不知身在然灯后。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15370,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四","author":"释绍昙","text":"临崖挤人，恶语伤人。\n冤深潮海，嚼齿吞龈。\n哑，说著无非是恶心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15371,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其十四","author":"释绍昙","text":"撼茶树，偷笋去。\n角虎出林，铁蛇横路，毒气炎炎如火聚。\n眨上眉毛见得亲，灵迹不在猿啼处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15372,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十九","author":"释绍昙","text":"野客吟残，中岩月落。\n坐断白云，死不再活。\n只将宗镜鉴惟心，法眼重重添翳膜。\n翳无药，光烁烁。\n要识永明妙旨，更添香著。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15373,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十二","author":"释绍昙","text":"觌面当机，东涌西没。\n平地上险崖，惺惺中淈?。\n不是心，不是佛，不是物，贬向无生国。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15374,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三","author":"释绍昙","text":"震旦心宗，竺乾正眼。\n觌面当机，是非俱刬。\n不落思惟透险崖，阶下汉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15375,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十五","author":"释绍昙","text":"一喝三日聋，大寂门风丧。\n深掘陷人坑，密布漫天网。\n笑一上，哭一上。\n做尽死模活样，乳峰子细思量。\n沉本无香，何须起谤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15376,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十","author":"释绍昙","text":"发得一机活，出得一言当。\n万里无片云，青天合吃棒。\n不待春风著意吹，暗香已在梅花上。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15377,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其三十四","author":"释绍昙","text":"冬至日舒长，这个长多少。\n虚空为尺不能量，蟭螟眼中盛恰好。\n盛恰好，衒惑神光，迷逢达磨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15378,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其五十八","author":"释绍昙","text":"天寒人寒，滴水滴冻。\n赤脚走冰棱，力负千钧重。\n堪笑霜趺拥叶人，漆桶漆桶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15379,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六十三","author":"释绍昙","text":"湖山苍苍，湖水茫茫。\n丹枫飘锦，金橘铺黄。\n明眼衲僧，随境转圣凡，无处觅行藏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15380,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其八","author":"释绍昙","text":"妙应群机，亨衢得路。\n浩浩尘中，如何辨主。\n辨得主，进退随宜，不妨去住。\n倒跨杨岐三脚驴，南北东西誇独步。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15381,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十一","author":"释绍昙","text":"雪峰辊毬，睦州担板。\n展尽神通，搆得一半。\n那一半，戴嵩牛卧绿杨阴，韩干马嘶芳草岸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15382,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其七","author":"释绍昙","text":"山雨酿春寒，晓湿梅花重。\n结实较迟迟，且听香浮动。\n化工有意待重来，永为鼎鼐调羹用。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15383,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六","author":"释绍昙","text":"赤脚走红尘，全身入荒草。\n费了几精神，不若居山好。\n一坞闲云，千峰啼鸟。\n声色纯真，是非不到。\n堪悲堪笑寒山子，十年归不得，忘却来时道。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15384,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其六","author":"释绍昙","text":"现成个，见得到，行得到，说得到。\n须弥灯王，狼籍不少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15385,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"偈颂一百零二首 其四十九","author":"释绍昙","text":"洞庭七十二峰，飞雪一千馀丈。\n晨昏说法琅琅，谁谓卢公已往。\n元不往，在这里。\n优昙火里开，嗅著无香气。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":15386,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]