[{"title":"文宣王及其弟子赞 其二十八","author":"赵构","text":"婉彼子羔，受业先圣。\n宗庙之问，一出乎正。\n克笃于孝，非愚乃令。\n师知其生，有辉贤行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49432,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其五十八","author":"赵构","text":"学者行道，敝缊亦称。\n使齐光华，偶为肥轻。\n周急之言，君子所令。\n答问允严，理皆先经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49433,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其六十八","author":"赵构","text":"雍容子皙，已望堂室。\n幼则有造，成则祖述。\n文采日化，儒效力弼。\n永观厥成，德音秩秩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49434,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其二十三","author":"赵构","text":"惟时义方，有子诚孝。\n怡怡圣域，俱膺是道。\n暮春舞雩，咏歌至教。\n师故与之，和悦宜召。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49435,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文宣王及其弟子赞 其二十","author":"赵构","text":"伯夫荥阳，实惟令德。\n优入圣门，过不留迹。\n道以目传，妙则心识。\n倚欤伟欤，后代之则。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49436,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吴郡王冷泉图赞","author":"赵构","text":"富贵不骄，戚畹称贤。\n扫除膏粱，放旷林泉。\n沧浪濯足，风度萧然。\n国之元舅，人中神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49437,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"皇甫真人像赞","author":"赵构","text":"皇甫高士，眉字列仙。\n以道兴世，孰计其年。\n闲云在空，孤鹤行天。\n掀髯一笑，同乎自然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49438,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其八","author":"赵构","text":"绕池曳杖携双鹤，架水浇花课小奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49439,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"赵构","text":"白云断处斜阳转，几曲青山献画屏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49440,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"赵构","text":"有美三宫德，无嫌并后心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49441,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"赵构","text":"天末归帆何处宿，钓船独在蓼花傍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49442,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"赵构","text":"气回俎豆群工泰，喜入貔貅万马秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49443,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"赵构","text":"池上疏烟笼翡翠，水边迟日戏蜻蜓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49444,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"赵构","text":"趁此一轩风月好，橘香酒熟待君来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49445,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"赵构","text":"秋江烟瞑泊孤舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49446,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题琵琶亭","author":"王安国","text":"夜泊浔阳宿酒楼，琵琶亭畔荻花秋。\n云沈鸟没事已往，月白风清江自流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49447,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送客至西陵作","author":"王安国","text":"若耶溪畔醉秋风，猎猎船旗照水红。\n后夜钱塘酒楼上，梦魂应绕浙江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49448,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"史院席上奉和首相吴公元韵","author":"宋敏求","text":"二圣垂鸿烈，天临四纪馀。\n元台地率属，赐会宠刊书。\n世业叨荣甚，君恩可报欤。\n衮衣相照烂，归拥鹿鸣车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49449,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送程给事知越州","author":"宋敏求","text":"浙东歌舞望旌麾，远泛樵风羽綄飞。\n论撰内通仙殿籍，拜兴初别夕郎闱。\n老人日俟刘公至，狂客今无贺监归。\n闻有新诗频寄我，莫嗟梅雨裛朝衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49450,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送裴司门倅越","author":"宋敏求","text":"剡中新佐郡，去路触炎威。\n民富杼机利，地含山水晖。\n樵风送舟綄，梅雨润朝衣。\n政在宜谣俗，当期奏课归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49451,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题招提院静照堂","author":"宋敏求","text":"丛林起新构，燕坐水云乡。\n本自禅心静，能令世累忘。\n幡花围昼永，钟梵度宵长。\n归裓新篇富，笼纱映宝坊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49452,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其二","author":"宋敏求","text":"左川风俗美，资中亭上人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49453,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"宋敏求","text":"圣时建官追茂制，唐家压角失前规。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49454,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其五","author":"宋敏求","text":"林腰似泻瑰，水面如融汞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49455,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"宋敏求","text":"十年情味与君同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49456,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"宋敏求","text":"千岩相望蔽松筠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49457,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"拙诗奉赠富乐山海公禅师","author":"宋球","text":"游遍西南转法轮，归来挂锡旧溪滨。\n师心皎皎潭中月，世俗悠悠几上尘。\n白雪眉毫俱晚暮，碧云章句独清新。\n近来素壁皆图像，如满联成七老人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49458,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉华山","author":"奚球","text":"玉华山来自何处，巉巉拔立陵紫烟。\n上有干云切霄之苍松，下有迸崖漱壑之清泉。\n长河西来齧山足，燐火白日明峰巅。\n浮岚暖翠入窗户，六月殿阁风泠然。\n我来岂暇吊古迹，俛仰但喜遗嚣喧。\n心魂澄澈耳目醒，如脱世故游神仙。\n平明却入俗尘去，回首烟萝羞满颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49459,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉华寺","author":"宋球","text":"一径入云壑，游人高下行。\n绿萝垂绀幰，屏壁削层城。\n山气蒸衣湿，松风洒面清。\n野僧遗万事，饱听石泉声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49460,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孝梅里","author":"赵昀","text":"南风六月吐梅花，奇绝西昌孝子家。\n一点落英千古月，夜来啼杀后栖鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49461,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"批养性存心二说","author":"赵昀","text":"方寸中涵一太虚，操存须用养工夫。\n瑩然镜净无纤翳，一性融明万理俱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49462,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又赐颂和灵隐长老颂","author":"赵慎","text":"欲言心佛难分别，俱是精微无碍通。\n跳出千重缚不住，天涯海角任西风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49463,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐贾相","author":"赵昀","text":"清明朝野遇清明，万国欢心乐太平。\n樽俎优贤咨启沃，载赓既醉咏盈成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49464,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐答郑采","author":"赵昀","text":"秋思太华峰头雪，晴忆巫山一片云。\n去国归来犹未得，诗篇遥赠北山君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49465,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题赵葵墨梅","author":"赵昀","text":"溪藤疏影势千寻，笔补春工著意深。\n止渴调羹归妙手，谁知一片岁寒心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49466,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"李璮归国","author":"赵昀","text":"力扶汉鼎赖元勋，泰道宏开万象新。\n声暨南郊方慕义，恩渐东海悉来臣。\n凯书已奏三边捷，庙算全消万里尘。\n坐致太平今日事，中兴宝运喜环循。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49467,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"昌化县进嘉禾嘉粟赐贾丞相","author":"赵昀","text":"一德交孚叶两仪，嘉禾嘉粟献珍奇。\n祥呈属邑信非偶，瑞应明禋若有期。\n周纪唐封生秀颖，汉歌郊庙产灵芝。\n何如近在王畿内，庆典珍符萃一时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49468,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"闻喜宴诗赐状元方逢辰","author":"赵昀","text":"肆予临御九宾兴，蔼蔼盈庭俊乂升。\n喜赖谠言调八事，欲垂景运进三登。\n摅忠社稷惟名节，济用邦家必器能。\n丰芑涵濡盛今日，勉思德意共钦承。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49469,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"淳祐丙午讲礼记毕锡宴秘书省赐侍读少师郑清之以下","author":"赵昀","text":"鳌极开先已降衷，上天下泽礼居中。\n三才义理维持力，万世纲常建立功。\n孔圣法言多纂辑，汉儒师学共修崇。\n经帷讲彻资群彦，克己工夫在广充。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49470,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐马廷鸾四首 其四","author":"赵昀","text":"圣烈神谟肇我邦，钜编诏后总宏纲。\n立心广大侔天地，行事明通迈帝王。\n训与六经相表里，法垂万世愈巍煌。\n讲帷可但资敷绎，夙夜惟知率旧章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49471,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐马廷鸾四首 其三","author":"赵昀","text":"古掖摛文步武高，绫衾寓直焰兰膏。\n当年宫锦飞双鹄，今夕仙图看巨鳌。\n诗赐玉堂苏易简，光摇莲炬令狐绹。\n明时盛事今重见，爰制篇章示衮褒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49472,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐马廷鸾四首 其二","author":"赵昀","text":"春秋万古一权衡，笔削昭然揭日星。\n道贯百王垂大法，义先五始定常经。\n是非褒贬寓深意，理乱安危烛未形。\n内夏外夷归一统，烨然治象炳丹青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49473,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐马廷鸾四首 其一","author":"赵昀","text":"天高地下礼由分，圣哲于焉秩纠纷。\n心法操存毋不敬，治功显设在斯文。\n会通自可跻明圣，品节应知本俭勤。\n旃厦讲磨资众彦，精微尽处是尊闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49474,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐状元文天祥以下","author":"赵昀","text":"道久于心化未成，乐闻尔士对延英。\n诚惟不息斯文著，治岂多端在力行。\n华国以文由造理，事君务实勿沽名。\n得贤功用真无敌，能为皇家立太平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49475,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赐郑丞相","author":"赵昀","text":"菲德承休帝命新，青阳闿动御昌辰。\n庆贻虹渚嘉祥衍，春满鳌山景色新。\n镐燕颂思勤□□，灵韶协奏喜横陈。\n在朝从此薰和气，要使驩心万姓均。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49476,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重修复古殿纪事","author":"赵昀","text":"烈祖谋诒燕，冲人命绍龟。\n禁严瞻复古，缔创想当时。\n凤纪因多历，翚飞欲寖隳。\n端居常念此，凉德恐羞之。\n勉辑炎兴业，新还舜禹规。\n栋骧非玉瑱，朴斲仅涂茨。\n咫尺羹墙见，延洪典则贻。\n缅怀光宅旧，俨若焕章垂。\n圣志惟先定，鸿名寓有为。\n风烟沈庙算，天日俯畴咨。\n屏翰环方召，言谟富禹夔。\n权纲归总揽，制度永维持。\n养士翔鸳鹭，蒐兵振虎貔。\n宣王修政日，光武中兴时。\n文治绥函夏，英威鬯远夷。\n万年丕显绩，三纪太平基。\n继述惭非称，规恢动慨思。\n肯堂心翼翼，景行日孜孜。\n载绎车攻雅，宜赓考室诗。\n告成书梗概，拜手缉芜辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49477,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宁宗皇帝挽词 其一","author":"赵昀","text":"冲澹凝金汞，忧勤失宝丹。\n讲馀曦正午，班促漏方残。\n济野云生暗，苍梧日转寒。\n列朝从艺祖，天阙会金銮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49478,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"项龙归省","author":"赵昀","text":"清河正愿得忠臣，岂觉辞官归思匆。\n为道思亲心甚切，难留执手意奚穷。\n亲斟御酒资行色，更敕云台写范容。\n回到家乡人问及，始知朕不负勋功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49479,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"笔占示林君奇","author":"赵昀","text":"许负往昔矣，天纲今何之。\n谁知千载后，复遇林君奇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49480,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题浯溪 其一","author":"黄社庵","text":"蜀道于今似弈棋，要令一著□安危。\n朝廷独选李曾伯，勋业当如郭子仪。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49481,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"瑞不为祥","author":"赵昀","text":"初是烈祖开炎图，华夷一统同车书。\n人心爱戴无远迩，亲传圣像绘成都。\n成都赤子尊君父，大廷重光奉祠宇。\n殿旁一木久已枯，俄发三芽当夏五。\n万物荣枯知有时，枯杨况更能生稊。\n天胡此野大此瑞，祖宗垂佑从可知。\n吁嗟全蜀今非昔，玉垒金城久荆棘。\n幸今天道已好还，欲洗腥膻归古益。\n矧兹廊庙古栋梁，肃雍显相登明堂。\n岷峨万里来献瑞，愿符景运答休祥。\n书言颠木有由檗，天其永命复大业。\n中兴肇开同一机，万载重芳光史牒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49482,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"赵昀","text":"天高地下礼居中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49483,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元以修史促成书特免扈从因赋","author":"宋绶","text":"属书不得陪春豫，结客何妨事夜游。\n还胜南宫假宗伯，重扉深锁暗登楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49484,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"玉堂壁画","author":"宋绶","text":"忆昔唐家扃禁地，粉壁曲龙闻曩记。\n承明意象今顿还，永与銮坡为故事。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49485,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送何水部蒙出牧袁州","author":"宋绶","text":"梧楸初谢楚天凉，亲见腰间换印囊。\n渔浦雾浓沈叠鼓，湓江风急下危樯。\n帝城云表瞻龙首，故国星边认剑光。\n退食斋中多燕喜，暖泉春酿泛瑶觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49486,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送僧归护国寺","author":"宋绶","text":"台岭分灯契上机，政庭传教及禅扉。\n供开蒲馔持盂至，梦忆霞标振策归。\n吟砚自澄晨磬彻，经窗闲掩夕香微。\n袍纹迥夺岩芝色，猊座人天喜重围。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49487,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"宋绶","text":"六阙表门荣，华林地气灵。\n乌衣王氏族，玉树谢家庭。\n邹鲁多亟犬，荀陈更聚星。\n怡神虚室白，讲学夜灯青。\n篇籍巾箱满，弦歌里巷听。\n兰堂时合宴，槐市正谈经。\n丹井通仙穴，西山接翠屏。\n烟萝皆胜概，何日扣岩扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49488,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其六","author":"宋绶","text":"楚泽伤春怨鶗鴂，长安索米愧侏儒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49489,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"向敏中","text":"四时常有烟棚合，三月犹无菜甲生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49490,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其一","author":"宋绶","text":"神归梁小庙，礼袝汉馀陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49491,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其七","author":"宋绶","text":"云间乍阕仙韶曲，禁里还过睿武楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49492,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其三","author":"宋绶","text":"鹤料署文移，鲚场收赋算。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49493,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句 其四","author":"宋绶","text":"奇材剑客当前队，丽赋骚人托后车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49494,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灵岩","author":"宋逸","text":"抖擞尘衣访古踪，扪萝涉崄彻灵峰。\n寒堆泰岳千岩雪，清绕方山十里松。\n泉顶客回闻法鼓，云堂僧起动斋钟。\n如来元现因明处，直在人天第一重。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49495,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"阮郎归","author":"宋媛","text":"东风成阵送春归。\n庭花高下飞。\n柔条缭绕入帘帏。\n斑斑装舞衣。\n云鬓乱，坐偷啼。\n郎来何负期。\n人生恰似这芳菲。\n芳菲能几时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49496,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"蝶恋花","author":"宋媛","text":"云破蟾光穿晓户。\n敧枕凄凉，多少伤心处。\n惟有相思情最苦。\n檀郎咫尺千山阻。\n莫学飞花兼落絮。\n摇荡春风，迤逦抛人去。\n结尽寸肠千万缕。\n如今认得先辜负。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49497,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题万年妙莲阁","author":"宋景年","text":"上方危阁化无踪，平顾摩空万桂丛。\n自有莲华发泥下，何须芝草遍山中。\n石桥暮隔霏霏雨，翠壁寒供凛凛风。\n弹指凭谁开户牖，向来禅观仰群公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49498,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戏周默","author":"宋温故","text":"骄阳为戾已成灾，赖有开筵周秀才。\n莫道上天无感应，故教风雨一齐来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49499,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠英公上人","author":"宋温舒","text":"粹钟衡岳诞吾师，十九彤廷赐紫衣。\n青简篆文穷妙绝，碧云诗句入玄微。\n降龙钵里无尘染，回雁峰前有梦归。\n他日好同莲社约，逸眠禅坐两忘机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49500,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送陈尧叟赴广西漕","author":"宋湜","text":"怜君将命拜新恩，送别都门亦断魂。\n雨歇桂林秋更暖，瘴连梅岭日多昏。\n诏颁海徼征徭薄，兵罢蛮州市井繁。\n愧我不才居禁近，前春洒扫待回辕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49501,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"宋湜","text":"纷纷游客豫章回，俱道华林就学来。\n门第昔年旌阙耸，主人长日讲筵开。\n化行乡党浑无颂，教得儿孙尽有才。\n好是诸生游息处，四时花木绕书台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49502,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赠淳于公归养","author":"宋湜","text":"宦路厌风尘，高堂役梦频。\n拜章辞旨切，致政罢光新。\n陶令羞为吏，潘生喜养亲。\n况登朝序贵，半俸岂忧贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":49503,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]