[{"title":"题浣川 其二","author":"戴栩","text":"浣纱元是此川名，鸥鹭蒲荷物物清。\n人把渊明居并拟，如今倒换学渊明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31698,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠朱子文因寄朱元刚二绝 其二","author":"戴栩","text":"故人墓木半藤萝，儿侄东西雁一莎。\n绝喜阿连新笔长，契君风鉴爱渠多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31699,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠朱子文因寄朱元刚二绝 其一","author":"戴栩","text":"僻寄僧房锁月萝，惊来客屐卿云莎。\n病侵瘦骨寒于水，却说冲和占得多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31700,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠黄叔向二绝 其一","author":"戴栩","text":"常恐清吟不疗时，软弓轻剑学兵书。\n君今得句攲纱帢，马上功名更莫疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31701,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赠黄叔向二绝 其二","author":"戴栩","text":"艇舣江南几度春，几时溯洛向咸秦。\n若应只载閒风月，击楫英灵笑杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31702,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上丞相寿 其十 自叙","author":"戴栩","text":"天地深仁不自知，物才有识荷恩私。\n前年仓钥尘遮面，今日朝班笏拄颐。\n宛若凌虚生羽翮，了无报效及毫丝。\n平生金石不移志，只在钧陶听所之。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31703,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上丞相寿 其七 翊辅","author":"戴栩","text":"圣主千龄不易逢，直应护养到清躬。\n观书子夜勤毋过，颐志宸庭乐自融。\n盛有聪明称帝舜，深于保辅是周公。\n治平元祐从头数，此是皇家第一功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31704,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上丞相寿 其三 天春","author":"戴栩","text":"天心妙处不难通，祗爱忠勤与至公。\n云映礼容呈晓霁，雪符腊令报年丰。\n的于何处容人力，诚到无言是极功。\n试向璇玑观大象，三台夜夜色齐同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31705,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上丞相寿 其一 册宝","author":"戴栩","text":"篆金成宝玉成编，春满东朝万象妍。\n黼衮有尊天子圣，盐梅无迹上公贤。\n日开喜色临黄道，风递和声下碧躔。\n清晓两宫齐锡寿，三槐影里沸传宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31706,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上丞相寿 其五 玉带","author":"戴栩","text":"万钉宝璐价连城，赐敕初宣上不名。\n虹彩助成霖雨润，龙光叠映衮衣荣。\n五湖四海归蟠际，万岁千秋侍圣明。\n应笑唐家于阗玉，不于房杜表忠精。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31707,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上丞相寿 其八 用人","author":"戴栩","text":"手引群工上帝庭，常须吉士认仪型。\n一般笙磬方同曲，千古蒿兰各异馨。\n泰道正应分内外，前贤错是说调停。\n愿歌周雅卷阿什，鸣凤喈喈梧叶青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31708,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上丞相寿 其四 人和","author":"戴栩","text":"帝里熙熙笑语闲，新春胜事总相关。\n眼看长乐鸿名建，心爱淳熙盛象还。\n雪晓万家沾廪玉，月宵九陌涌灯山。\n升平此德将谁报，一炷晨香斗柄间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31709,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上丞相寿 其六 太傅","author":"戴栩","text":"上傅新加鼎铉金，辞荣几度至如今。\n力陈逊表撝谦甚，细想神毫注意深。\n道合明良关数运，礼隆典册答群心。\n越王盛业辉煌在，欲把缁衣百遍吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31710,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上丞相寿 其九 驭外","author":"戴栩","text":"古来要镇及边城，祗在深谋不在兵。\n庙算何曾有遗策，将臣容易欲要名。\n弱翁持重羌还服，裴度经营蔡自平。\n靖定规模天广大，会须混一到神京。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31711,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"上丞相寿 其二 飨献","author":"戴栩","text":"宗祊享德本无私，手捧羲轮上玉墀。\n牺象洁新亲荐处，凫鹥燕乐守成时。\n重闉昔诵明光赋，硕辅今赓圣德诗。\n一体君臣同五福，无穷无极太平基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31712,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"久雨记农父语","author":"戴栩","text":"炊烟不出窟，雨久未知晴。\n冷缩秧芽烂，滋含树耳生。\n南风愁甲换，湿土怕星明。\n朝客惭无补，归来伴耦耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31713,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"大水次友人韵","author":"戴栩","text":"天公岂是出新奇，涨潦茫茫秋暮时。\n牵浪何曾传雨信，回南不用掣风旗。\n拍浮瓮盎鸣相属，颠倒篱墙去若驰。\n数日羲和尚羞涩，嫩黄晴影浸清漪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31714,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"劝耕题正觉寺诗次王文康韵二首 其二","author":"戴栩","text":"海山春过半，未见一花开。\n岩溜无时滴，松风尽日来。\n前生身已到，归路首重回。\n祇恐山灵笑，衣巾着吏埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31715,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"劝耕题正觉寺诗次王文康韵二首 其一","author":"戴栩","text":"渤澥东南极，何年梵室开。\n地形缘水尽，潮势挟山来。\n古市朝仍暮，遥帆去若回。\n老僧无一事，窗日射飞埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31716,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"少文挽词","author":"戴栩","text":"尘外拾科名，儒袍一半青。\n凄凉余旧友，端的墓新铭。\n池浃骚人墨，山空隐士星。\n没言犹戒佛，引葬只刍灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31717,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"王秘监夫人挽词","author":"戴栩","text":"五桂堂深处，霜萱竟不春。\n独从前崦路，重见道山人。\n检点哀词众，推寻碑事真。\n应言嫁时物，纵在亦为尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31718,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"丘处士挽词","author":"戴栩","text":"自移小隐寄西阛，终是高人性爱闲。\n梦到春潮生荻渚，眼看旧友上蓬山。\n棋声忽背樵风远，书影空涵棹月弯。\n令子相过犹昨日，不堪衰鬓泪沾斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31719,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"东山隐士曾公挽词","author":"戴栩","text":"儿袍已绿鬓丝鲜，尚爱寒檠对夜编。\n里不闻喧钦德重，诗能藏巧得名全。\n慈平心是今时佛，隐卧身多晋传贤。\n晓奠所亲凝恸处，忆曾持酒寿新年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31720,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"白鹤寺作","author":"戴栩","text":"子晋昔游处，平台片石成。\n寺名犹记鹤，松响却疑笙。\n岩壁飞双瀑，金沙照一泓。\n野人岂仙伴，随鹿过溪行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31721,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"农家","author":"戴栩","text":"农家何所有，挂壁一锄犁。\n岁计唯供赋，门前自好溪。\n剥麻秸覆日，缲茧蛹分鸡。\n不复知炎月，南风焚稻泥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31722,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱邵州挽词","author":"戴栩","text":"湖湘梦断两旌红，素业俄随逝水东。\n邑政清平民是子，京钱流转楮如铜。\n祇今吏道通才少，况尔家庭友谊崇。\n欲挽九原无好句，漫同回札寄飞鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31723,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"朱尚书夫人洪氏挽词","author":"戴栩","text":"八座方新玉铉家，妆台忽掩五云赊。\n徽声不愧古彤管，觉性能空昙钵花。\n夜月东冈疏磬度，春风南国去旌斜。\n所亲多少酬恩泪，待看重封燎诏麻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31724,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"自龙湫出灵岩","author":"戴栩","text":"四山奇更峭，外看未知山。\n藏此千峰在，多应一壑间。\n飘湍洗云骨，灵异出人寰。\n埋没尚多有，寄言榛与菅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31725,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"吴状元兄泳挽词","author":"戴栩","text":"理学通深艺学高，一官俄逐盛年抛。\n门中晁董刊新志，海内陈雷哭旧交。\n黄落己空秋半叶，清芬未著腊寒梢。\n魂兮有句重吟否，谢脁山孤月转坳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31726,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"坐中有一桃花自屋栈飞下因而即事","author":"戴栩","text":"幽意静中见，春风处处通。\n层阶生晕碧，罅瓦落飘红。\n禅语关诗趣，寒阴出酒功。\n人家社日近，翠饵捣香蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31727,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"宋叔简挽词","author":"戴栩","text":"上国曾随计，香名众所闻。\n百年犹是短，寸禄不沾分。\n笛送邻家月，楼藏卧处云。\n生刍何必奠，徐稚有铭文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31728,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陈民表挽词","author":"戴栩","text":"住僻宜玄晏，门高聚郤诜。\n没犹存议论，生岂恨沉沦。\n旧姓符占地，新铭胜写真。\n登堂曾独拜，愧见德星人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31729,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和卢直院秋怀","author":"戴栩","text":"因秋又动长年情，老却于秋分外清。\n病骨汗销衣亦健，水窗影净日添明。\n有声无谱寒蛩切，似定还狂暮叶轻。\n不为鲈鱼未归得，问言微宦欲何成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31730,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"定海寒食西湖忆卢玉堂葬西湖之上近传有僧请大仙降者是其笔","author":"戴栩","text":"寒食无朝谒，閒携载酒车。\n燧青宫蜡火，雨白野棠花。\n旧友频游处，荒阡一酹赊。\n传闻有仙笔，丽句落僧家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31731,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林孔英岳母卢夫人挽词","author":"戴栩","text":"南涧承家事遍经，东床得婿众知名。\n纵于人世百年短，添得儒门一倍清。\n科第旋收夫又子，空缘自解殁犹生。\n新阡闻与姑茔近，松霭朝昏管送迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31732,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"林酒库挽词","author":"戴栩","text":"静梦钟催漏，荣恩露眩花。\n能镌题墓语，终认读书家。\n壤乐齐裘褐，风酸送旐车。\n竹轩孙几辈，又减雁行斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31733,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"祈雨二古迹","author":"戴栩","text":"已出郊坰曙色微，田翁指点路分岐。\n门前大白刘伶墓，壁上箜篌炀帝祠。\n五斗精神醒亦醉，二妃恩宠死相随。\n何如一挽天河洗，却为君刊万古碑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31734,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"罗汉寺","author":"戴栩","text":"崖势石龙如，中为大士居。\n茗花时现异，檀施最缘渠。\n灶爇山枝湿，灯悬龛影虚。\n山门难即去，奇嶂列前除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31735,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"饯曹西士宰南康","author":"戴栩","text":"君名华省里，庐岳未应过。\n寿日人兼饯，凉风湖际多。\n茶醒怜鹤睡，琴寂听渔歌。\n候骑新来说，先声众已和。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31736,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"前休处士余君挽词","author":"戴栩","text":"事向生前了，名逾死后新。\n溪山三尺冢，诗酒四时春。\n急义先乡社，忧民问搢绅。\n蜃江才一苇，恨阻送车尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31737,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贺水心先生七十","author":"戴栩","text":"欲盟鸥鹭老昌湖，其奈君恩未许何。\n迟此经纶今日后，定须酬折得年多。\n著书新稿天无尽，阅世閒心海不波。\n七十却嫌人贺寿，缭墙闭雨长庭莎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31738,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵开府仪国公挽词 其一","author":"戴栩","text":"郎星卿月递辉光，忽着蝉冠换鹭行。\n人世阅来知幻境，钧天归去侍先皇。\n棠阴政惠人人说，花底篇章字字香。\n一段风流埋不得，传家玉雪照人旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31739,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵开府仪国公挽词 其二","author":"戴栩","text":"西湖曾伴玉堂仙，我亦陪登李郭船。\n便有荐书如旧识，剩怀此意忽重泉。\n西风引旐笳吹咽，东国疏封宝册鲜。\n如此哀荣将底恨，泪因知己自潸然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31740,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送卢次夔赴仲父校书之诏","author":"戴栩","text":"离家向京国，客思独从容。\n有句诗人读，无书馆吏供。\n蛰雷先一月，晴岭沓千峰。\n马上思亲处，题缄寄所逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31741,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送先室归葬西山","author":"戴栩","text":"结束遥装异昔时，江头送尔一沾衣。\n五年客殡依禅寂，千里香魂与梦归。\n闺美欲书碑易尽，龙封新斸草应稀。\n西山便想西湖是，云树深深谷鸟飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31742,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送西士之南康","author":"戴栩","text":"祇听留行语，难工送别诗。\n清才今少比，循吏古为师。\n水转朝京路，山迎近县时。\n种莲曾有社，应共逸人期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31743,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送宋君辅迎母往总所","author":"戴栩","text":"步合趋台阁，人于此去疑。\n定应中路召，早是十年迟。\n草奏怀边略，开缄得贺诗。\n从亲登赏处，花发小春枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31744,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈叔方闽县丞","author":"戴栩","text":"两年湘岸听筹声，又向闽峰住冷厅。\n可是初阶带朝籍，己闻独荐起斋铃。\n秋边梧叶无风下，旱后苗根一雨青。\n客路方新世路熟，莫将彩笔斗英灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31745,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送陈漫翁教授官满赴都下","author":"戴栩","text":"嫩黄千点糁槐枝，此别诸生倍所思。\n判牒署名书字小，开经酬问具餐迟。\n竹边亭在谁招隐，囊里书成合济时。\n东府主人偏爱士，为歌厦屋杜陵诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31746,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送侯居甫监军器所门","author":"戴栩","text":"青云直上不留难，也向神京效一官。\n御带禁严曹事少，员分省户荐书宽。\n明时兰锜曾何用，昨夜边烽未肯寒。\n定有囊封神庙略，还同新句寄来看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31747,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送赵端行殿试","author":"戴栩","text":"杏园诗句定无如，却拟雕弓赐得绯。\n立仗陛郎无唱姓，过江宗相有传衣。\n红尘辇路桐阴满，翠箔人家燕子飞。\n过马传呼齐指处，鞭丝一半拂金鞿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31748,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送项季约赴成都钤干呈洪倅","author":"戴栩","text":"辟奏来从旧所知，蜀天万里去嫌迟。\n青油幕建元寮贵，锦领首参小校随。\n千古泪痕诸葛事，十分行色杜家诗。\n益州别驾如相问，为说思君草檄时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31749,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蒋德瞻弋阳","author":"戴栩","text":"下车先访俗，期减月桩银。\n廉使旧知己，长官贤过人。\n吏稀中路接，山密道家邻。\n县谱传无用，祇将琴谱亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31750,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送蔡子重知松阳县","author":"戴栩","text":"叶岭书翻昨夜风，主人应辟出山中。\n长淮再定因前画，小邑频难试后功。\n办得分明归版籍，写将清静入丝桐。\n朝堂赴日勤延问，应说无它只至公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31751,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭周茂洪","author":"戴栩","text":"清襟无物最怜才，怪傲翻从怨口来。\n于我此生同管鲍，昔人何处觅陈雷。\n龙驹有种长途见，宝镜无言众丑猜。\n一恸欲从天外酹，吴门斜日起云埃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31752,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏运属挽词","author":"戴栩","text":"我愧文襄漫述铭，喜闻诗挽遍群英。\n俗媮万事皆漓薄，子孝重泉独显荣。\n著脚官尘能道远，委身王事不求名。\n故园引得湘江水，依旧东流彻底清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31753,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏肯父为先都仓求水心墓志未得而归社中诸友皆赋诗送其行","author":"戴栩","text":"文星金石笔，许尔有新铭。\n宽作春风约，归看宰树青。\n房留僧闭月，舟渡雁移汀。\n凭寄梅花酹，先贤必典型。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31754,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"夏迪简都仓挽词","author":"戴栩","text":"圣代难平进，仓官不厌卑。\n恨无终岁寿，名有上臣知。\n事业空流水，科名在墓碑。\n儿能起门户，何止继前基。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31755,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奚帑院挽词二首 其二","author":"戴栩","text":"藜杖脱朝缨，萧閒物外情。\n问梅添旧句，爱石品新铭。\n鹤侣归何处，鸡牛梦已成。\n中庸馀旧业，留付后儒耕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31756,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"奚帑院挽词二首 其一","author":"戴栩","text":"历官凡有几，五驾令君车。\n健吏犹难色，儒生未必疏。\n廪饥祠有像，乡饮礼成书。\n惜阻蒲轮召，申公八十馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31757,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐少卿挽词 其二","author":"戴栩","text":"忽作严州梦，难随上雍班。\n行藏天分巧，夷险世机閒。\n瘴酒云生绿，铭旌露湿斑。\n保昌钟梵晓，依旧是家山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31758,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"徐少卿挽词 其一","author":"戴栩","text":"盛业清朝选，香名早岁芳。\n所忻逢舜禹，宁肯学于张。\n卿月高秋部，恩波彻夜郎。\n谁嗟贤哲事，身外欠周防。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31759,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽张知县词","author":"戴栩","text":"卓绝为官事，碑铭字画深。\n万钧持重力，一点觉圆心。\n天地空轮迹，贤愚荒草林。\n老来频阅世，有泪不沾襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31760,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽张金都郎中词","author":"戴栩","text":"唤作郎官三十年，淡于名爵自应贤。\n摩天灵燄诸生笔，匝地春风使者旃。\n手种路松添墓色，门开族井冽炊泉。\n淳熙耆旧今无几，忍把豪华万口传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31761,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽陈县尉歌词","author":"戴栩","text":"欲裁薤曲问耆贤，见说声华四十年。\n六馆已推天下士，一官何羡吏中仙。\n白砂旧事渔樵老，缥轴新铭蜡墨鲜。\n便觅当今徐稚笔，榜知如玉在松阡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31762,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"挽林知县朝奉词","author":"戴栩","text":"两拜恩纶世泽垂，皇天老眼未嫌迟。\n百年忽失古君子，四海难逢今吏师。\n祖奠兼排遮道帐，影祠别写憩棠碑。\n湖堤荪满读书处，雪意将云万叠悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31763,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"眠轻","author":"戴栩","text":"眠轻梦不定，晨户入疏风。\n清坐一遐想，古人皆大空。\n少言训俗客，忍事付天公。\n祇了此生足，不嗟吾道穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":31764,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]