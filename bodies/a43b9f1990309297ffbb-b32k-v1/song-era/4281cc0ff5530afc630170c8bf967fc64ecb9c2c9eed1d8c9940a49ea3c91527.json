[{"title":"次韵昌甫 其六","author":"韩淲","text":"我圃虽荒亦有梅，相随酬唱谓何哉。\n须知流水孤村外，尽有清明风月来。\n幽艳肯因人意发，好花元是化工栽。\n几番立尽空行去，犹记西湖挈杖回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26646,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫 其七","author":"韩淲","text":"交游零落旧同盟，望望章泉共此情。\n病后如斯犹得句，老来应不要知名。\n久于朝市闹中住，便合山林静处行。\n今岁雪多梅更好，巡檐宜与细逢迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26647,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫 其八","author":"韩淲","text":"看梅动是隔年期，僧寺逢花正此时。\n火拨白灰相对榻，酒倾清醥亦盈卮。\n幽幽寒事空如梦，历历閒情独寄诗。\n怜我倦游还薄宦，南枝和雪又纷披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26648,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫 其九","author":"韩淲","text":"何处逢人可共杯，老来空觉岁时催。\n门前涂路无芳草，山里林园欲放梅。\n残雪未消经小至，繁霜犹冻待春回。\n好诗寄自章泉水，起我寒心一寸灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26649,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫 其十","author":"韩淲","text":"老觉浮生空地隔，时来犹幸得书题。\n梦思百里身长遁，语别经年意转凄。\n槐叶易风惊热恼，莲根少水厌涂泥。\n何当整履苍苔滑，啸竹高凉手重携。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26650,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫 其十一","author":"韩淲","text":"叹息弥襟强拄撑，人间閒处且閒行。\n风光漫与酬诗债，岁月何堪说宦情。\n近脱市朝谁信我，久居荒野孰如兄。\n青青又满新成竹，相望章泉夜月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26651,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫 其十二","author":"韩淲","text":"尽道庞公遗以安，笋林上番又成竿。\n几年手种要谁问，常日身閒只自看。\n墨妙席间殊不恶，茶甘林下莫留残。\n荒寻幽讨真空举，今世孤风世所难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26652,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫 其十三","author":"韩淲","text":"仅得从容亦素期，意消心惬恨来迟。\n相将里舍欢言酒，珍重家庭听说诗。\n落佩倒冠非所籍，毁车杀马尚何思。\n从来鹏鴳夔蚿耳，不怨人之有佚遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26653,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫见寄","author":"韩淲","text":"薄宦归来盍罢休，閒心终是爱吾州。\n高名又喜为澄观，素隐何妨得卧游。\n四海九州彫落尽，东邻西舍往来不。\n秋风山里相寻处，莫问人间有比周。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26654,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫闻予过仲益见寄","author":"韩淲","text":"离群常恨不能佳，桂到秋深处处花。\n幽讨既寻泉水矣，傍搜岂忘月轩耶。\n翁留觞酌时煨栗，友为炉熏更作茶。\n不是襟期安得此，世间馀事我何加。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26655,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫别后所寄","author":"韩淲","text":"多病登台畏独醒，荒园蕊菊尚青青。\n山中我友还新别，门外巾车亦始停。\n老去年年无以醉，诗来字字信斯馨。\n遥知隐地秋风急，坐对松寒数鹤翎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26656,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十五日次韵昌甫别后所寄 其一","author":"韩淲","text":"九十里山宽两程，白云随步不辜行。\n石嵌塘水观鱼跃，土旷田塍放鹤鸣。\n兄弟留连因共集，儿孙问劳笑相迎。\n归家转觉深居简，强把柴门更拄撑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26657,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十五日次韵昌甫别后所寄 其二","author":"韩淲","text":"山净泉甘草树香，书楹茶具酒壶觞。\n故家南渡衣冠少，前辈中原文献长。\n朝野从先终较别，衰荣到底未须忙。\n高风且作闲言会，时寄连篇复断章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26658,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫寄所和朴翁诗因亦次韵","author":"韩淲","text":"长日怀贤只坐驰，炎凉谁与世推移。\n贫生梦枕槐柯蚁，笑杀仙巢莲叶龟。\n萧瑟两峰吟和处，辛勤千里寄来时。\n风流是我身名事，付与刘郎歌竹枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26659,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵徐子颜丈","author":"韩淲","text":"老觉年光秋更好，人间从昔易纷纭。\n漫将诗酒供閒客，常喜山林对隐君。\n话到忘言清似水，思之何事懒于云。\n相逢得醉茱萸盏，一段高风信不群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26660,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵耿运干","author":"韩淲","text":"如君便合上鹓行，却爱湖边梅蕊香。\n尽把珠玑为妙手，谁疑铁石作刚肠。\n文园病减初何苦，金谷春归有底忙。\n我亦被花恼不彻，又因鼎脔得珍尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26661,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵民瞻","author":"韩淲","text":"独酌梅花醉似泥，市尘何敢近园扉。\n孤香藉雨知幽眇，冷艳排风与世违。\n灯火丽谯新气象，琴尊高隐久光辉。\n隔江相望空华发，燕子将来雁欲归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26662,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵余季伦","author":"韩淲","text":"兴寄寥寥岂尚同，诗歌往往懒求工。\n从他汉魏曹刘上，尽尔齐梁沈谢中。\n百巧百穷无似我，一觞一咏有如公。\n今来古往能言者，多少焦琴爨下桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26663,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵巩仲至","author":"韩淲","text":"青青客舍付离骚，岁月峥嵘又一朝。\n不奈驱驰堕烟海，少迟盘礴对风潮。\n弹冠自笑平生拙，落笔谁容万景骄。\n秋入壮怀探禹穴，吴天回首越山遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26664,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵周景瑜","author":"韩淲","text":"日日锄园净扫门，待寻幽草艺芳荪。\n秋花又满庭前树，浊酒閒开座上尊。\n新事任从千百变，旧交才得两三番。\n凄凉北客溪南住，有句长吟莫厌繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26665,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二十三日次韵斯远","author":"韩淲","text":"閒身襟抱为君开，山已高深水漫洄。\n趁得春时花下饮，犹思秋夜月中来。\n留连自觉太多事，潦倒相从更几回。\n诗到唱酬成宛转，悠悠今古复关怀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26666,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吴子似以长句为赠次韵","author":"韩淲","text":"玉石村船子欲归，相逢只合醉如泥。\n平生学识知何患，随世功名信不迷。\n浪饮未应愁剂量，放言宁复究端倪。\n象山经得堂之记，出处升沈惜此题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26667,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵王教授","author":"韩淲","text":"春残物物尚堪书，捉笔寻诗独绕庐。\n不特唱酬浑老也，未知交往尽欢欤。\n怕将笑口荒忙合，欲待愁眉款曲舒。\n忽尔流风萍是絮，宜乎化气鼠为鴽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26668,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵同访潘丈","author":"韩淲","text":"风流儒雅古难并，自昔从公意气倾。\n已觉好诗销永夜，正宜小阁快新晴。\n推琴置酒情何适，取帖披图论更精。\n当代如斯真可数，一潮烟棹我将行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26669,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵抱朴君问病求閒","author":"韩淲","text":"清都谁不愿居官，且是西湖最好山。\n此地固难常养病，他乡只可便求閒。\n苦无筋力追王贡，那有心机衒孔颜。\n秋入两峰明碧落，几多鹓鹭簇天关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26670,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵孙叔晦","author":"韩淲","text":"春阴漠漠晚来寒，欲写相思一字难。\n古锦诗囊无我佩，暗尘弦索尚谁弹。\n閒乘野逸神尤旺，静少牢愁梦亦安。\n好爵浮名能有几，人间翻覆自悲欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26671,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"正旦次韵敖器之所寄","author":"韩淲","text":"笑倒兴公赋遂初，便寻前话岂无馀。\n春秋列国乘轩鹤，耆旧襄阳缩项鱼。\n腊日未除曾举酒，春正还始尚堪书。\n岭头梅萼归来晚，湖海谁人更得如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26672,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵","author":"韩淲","text":"孤山夏木已苍苍，更著岚光与水光。\n择胜轩窗尤有味，怀贤姓字转生香。\n湖阴涨雾归云静，海气吹风卷雨忙。\n恨不相从饫蔬食，细吟酬唱亦清凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26673,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"周景瑜同杨伯升见过次景瑜所赠伯升韵","author":"韩淲","text":"风流二士真连璧，乃尔行春到涧滨。\n小坐纵谈前后事，推贤因数古今人。\n却思尊酒青灯夕，殊觉头颅白发新。\n得醉有閒诚可味，此情终不负吾身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26674,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"世昌携项平甫所和诗来叹其已逝次韵一首","author":"韩淲","text":"只宜乡党与州闾，天下英名不可居。\n奋迅临边虽似壮，差池退隐实非疏。\n纷纷虽满庸人见，历历难逃识者书。\n晚对匡山应自笑，却将心事赋兵车。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26675,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵德脩","author":"韩淲","text":"已接湖头笑语香，雨馀又得句生凉。\n分明天意如人意，占尽山光与水光。\n朝市虚嚣还隔远，轩亭闲雅信深长。\n输君少袖弦歌手，此乐吾侪亦未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26676,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九月二十五日仲至携酒与客相过因为作生日次韵春时所赠","author":"韩淲","text":"名胜相从餐菊英，楚骚情味是三生。\n会逢其适论奇字，进退之间付濯缨。\n览德凤凰非苟集，俟秋蟋蟀也须鸣。\n诞弥俾尔耆而艾，况复村酤煮芋羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26677,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵上饶","author":"韩淲","text":"一抹红桥卧水云，雨收风叶尚沾巾。\n开门觅句无馀日，曲水流杯又浃旬。\n春事匆匆容易老，人情往往总输真。\n河阳县里花千树，犹记溪南寂寞滨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26678,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵余伯皋 其一","author":"韩淲","text":"萧然一叶下庭空，便觉风凉入袖中。\n糊口可能盂饭白，放身那羡带鞓红。\n江湖水满悲游子，城阙秋生醉秃翁。\n且剥鸿头对杯酌，翻云覆雨久来同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26679,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵余伯皋 其二","author":"韩淲","text":"与君莫放酒杯空，是事无过一笑中。\n衮衮细看谁眼白，休休赢得自颜红。\n世间爵服无归客，天下渔蓑有钓翁。\n饮罢不知今古异，酣然而睡且相同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26680,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"视民如伤书呈上饶因其诗次韵","author":"韩淲","text":"此话休嘲道学残，忧时当复寸心丹。\n扶沟在昔多遗绪，西伯于前实肇端。\n县邑岂皆椎剥甚，民农惟独抚摩宽。\n因公善治重拈起，侑坐谁图作美观。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26681,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上饶新刊巩宋齐六言寄赵晏叟者次韵上饶","author":"韩淲","text":"凋零我亦鬓星星，旧墨新刊百念轻。\n诗案自应留笔研，书窗谁不对梅瓶。\n赵岐交契身俱老，李汉亲传眼独明。\n赢得泉溪春草绿，离离烟水照坟清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26682,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"闻张饶县有诗次韵","author":"韩淲","text":"绝俗寻幽岂好奇，章泉不信更何之。\n仁贤固曰能亲炙，交伴要之岂诡随。\n去泊玉田虽宿雨，回程冷水喜晴飔。\n那知更著张饶县，风雅还吟五字诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26683,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵校官","author":"韩淲","text":"要底劳生醉即休，从他势利有包羞。\n秋高野外空环堵，月满城时定倚楼。\n平揖山光明绝巘，净摇溪影转沧洲。\n可怜儿辈知陶写，丝竹何如且茗瓯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26684,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵赵路分","author":"韩淲","text":"落尽篱前一树梅，海棠禁冷未全开。\n待晴自历郊原去，苦雨谁从涧壑来。\n近喜交游能好句，即须解后与深杯。\n佳人望断碧云合，九十日春馀几哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26685,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵次公 其一","author":"韩淲","text":"涨云吹雨转轻雷，香草沿阶芍药开。\n正好青春乃奔走，只宜白日且徘徊。\n离怀未说人千里，抚事浑如水一杯。\n酒到多时诗定少，渭城绝唱复谁哉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26686,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵次公 其二","author":"韩淲","text":"山人常抱白云眠，梦想云林竹树边。\n恨不一杯同卜夜，情知七字独吟天。\n由来里社无非旧，细数交游有是贤。\n茗事肯随人共煮，樵渔真足豁忧煎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26687,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵","author":"韩淲","text":"西风吹雨动云车，野水浮花绕屋除。\n得兴无过寻旧约，称心尤觉是閒居。\n市尘不到秋声早，树色初分夜气馀。\n架上古书吾辈事，一襟清暑为踌躇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26688,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵昌甫","author":"韩淲","text":"竹窗寒夜雪宜听，涧道柴荆晓更扃。\n那得拥炉倾白堕，且为数息问黄宁。\n舆篮兴可知人胜，落纸诗尤见德馨。\n腊日寻常岂能尔，梅兄于我眼终青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26689,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次仲至 其一","author":"韩淲","text":"望断湖山湖水西，君来我亦醉如泥。\n只宜吏隐歌仍啸，莫问儿饥号与啼。\n巷仄人家随地转，庭空花草傍檐齐。\n楼高又倚秋风老，待把君诗处处题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26690,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次仲至 其二","author":"韩淲","text":"冷烟无计了愁端，花满湖阴百顷宽。\n渺邈家山身独老，周回园馆眼长寒。\n吹饧近市徒誇卖，上冢何人不鲜欢。\n空对海棠春睡足，数枝红湿露漙漙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26691,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"仲至举似项平甫所赠宦汉阳教官时也次韵","author":"韩淲","text":"文献相传有父兄，山堂留得是诗情。\n果回富艳归清远，尽扫虚骄入正平。\n保社祇今难可继，赠言如昔信堪惊。\n汉阳历历晴川树，鹦鹉洲前黄鹤鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26692,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵亨中见寄","author":"韩淲","text":"团源深处有幽期，谁见壶林杜德机。\n曳履信知贫不病，采薇空论怨还非。\n前时解榻临风处，半夜呼杯踏月归。\n吟到菊花须再会，落霞孤鹜已秋飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26693,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵潘德久见寄","author":"韩淲","text":"叹息骚人不我违，常同醉酒把花枝。\n如今但得流传赋，已久都无唱和诗。\n瓯粤州闾临去日，永嘉乡井入朝时。\n相思屈指秋鸿近，空使挥弦目送知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26694,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵陈肤仲又过铅山见寄兼怀真卿丈","author":"韩淲","text":"海内师门复几人，书来善诱意循循。\n休论用舍与斯世，试较仙凡隔彼尘。\n是道渊渊书自若，相传本本话常新。\n三山想像陈黄学，五马归来各素贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26695,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"借章泉翁韵回斋","author":"韩淲","text":"狂澜正倒筑新斋，回我家声属雅怀。\n想到渊源深彻底，窥从涯涘溜浮阶。\n舜文正道须身见，佛老他岐定力排。\n今古沈浮几多少，滔滔应不与之偕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26696,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵次公","author":"韩淲","text":"梅花腊后与春前，爆竹声中更恍然。\n来往南山惊渐老，唱酬东郭信能贤。\n风流往事高情外，雅淡新知醉眼边。\n尽日论文君慷慨，因时写物我缠绵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26697,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵倅再赋又次韵答","author":"韩淲","text":"閒却身心堕一偏，从渠佳月更凉天。\n每思君子宜看竹，设道宜男谁戴萱。\n寂寂故乡通德里，悠悠往行孝廉船。\n江南过夏多梅雨，赋就郊居空放言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26698,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次公和韵再赋答之","author":"韩淲","text":"雨烟埋却面前山，怅望高吟祇自看。\n既以酒壶相煖热，更因墨帖破荒寒。\n谁家篱落梅千点，到处园林竹数竿。\n不是故人心事在，也随尘虑失幽欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26699,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"答行甫","author":"韩淲","text":"检点归装有句无，一楼晴日照阶除。\n提瓶洗盏犹堪醉，破研摇毫亦可书。\n江水东流挟湖海，家山西上接匡庐。\n轩然握手春风里，刎颈从来笑耳馀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26700,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵蒋县尉","author":"韩淲","text":"霜风岁暮正深幽，喜见才华誉甚休。\n古者重交多管鲍，今之能赋少应刘。\n枯荣到底俱尘网，起灭由来付海沤。\n拨尽寒炉既相觅，恨无肥马共轻裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26701,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵巩帑辖","author":"韩淲","text":"省事遥知多杜门，拥炉寻睡定温温。\n年来尚喜常同赋，日近还当不复言。\n略去便回须管学，可行时止是丘园。\n雪寒江浅潮头小，舟到泉溪春已暄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26702,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵伯皋至日","author":"韩淲","text":"眼中林密更山深，昧昧从前直至今。\n且与儿童誇好节，岂无交友话閒心。\n繁霜似雪空疑画，尽日移时肯废吟。\n欢喜有诗余半隐，遍游朝市却山林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26703,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"昌甫诗叙同僚以皆为南岳监也昌甫秩满又重请于庙堂矣次韵少笃仕契","author":"韩淲","text":"诗寄同僚意有馀，清朝犹有此差除。\n悠悠道室仍祠庙，衮衮金坡尽石渠。\n会弁假饶方寸地，折铛消得斗升储。\n要之因任荣堂帖，员外空餐独愧予。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26704,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又次赵倅五日即事韵","author":"韩淲","text":"水断浮梁地愈偏，山人不记艾花天。\n深林碍屋犹多竹，积翠满庭无复萱。\n蒸溽既难寻笔砚，荒凉岂易饮觥船。\n不因别乘离骚句，那得斯时有是言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26705,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵贵池兄见寄","author":"韩淲","text":"违离伯氏五年矣，又得春风一纸书。\n老去光阴非旧比，閒中滋味是真如。\n鸣琴且喜身无恙，著句遥知兴有馀。\n梦绕齐山堤上路，万花飞树绿扶疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26706,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赴贵池临别呈景清兄","author":"韩淲","text":"试吏齐山敢作难，相看风雪去途殚。\n客情已觉自无绪，子职不知谁问安。\n亲老岂禁成远别，我思只合且团栾。\n三年愿得各强健，赢得归来满室欢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26707,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岁暮和韵甚思昌甫兄","author":"韩淲","text":"风雨空山可奈何，门前寒港水增波。\n君多亲戚定欢宴，我乏从游徒浩歌。\n岁晚一身知又老，年来三友仅相过。\n章泉超在百里外，应自打乖安乐窝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":26708,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]