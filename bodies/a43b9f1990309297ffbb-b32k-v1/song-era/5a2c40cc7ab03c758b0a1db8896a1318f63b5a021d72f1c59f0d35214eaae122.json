89","path":"宋_2.csv","pointer":63870,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酒醒","author":"寇准","text":"胜游欢宴是良图，何必凄凄独向隅。\n深院酒醒春日晚，只闻芳树语提壶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63871,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"偶书","author":"寇准","text":"往事都如梦，流年只断魂。\n不堪春尽日，细雨欲黄昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63872,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"惜花","author":"寇准","text":"深谢暖风传馥郁，长忧夜雨暗摧残。\n黄昏欲放笙歌散，更绕朱栏子细看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63873,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"望都雨夜","author":"寇准","text":"孤驿萧条风雨夜，夜深窗竹动秋声。\n离魂无睡难成梦，却绕长廊独自行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63874,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舂陵闻雁 其一","author":"寇准","text":"萧萧疏叶下长亭，云淡秋空一雁经。\n惟有北人偏怅望，孤城独上倚楼听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63875,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"舂陵闻雁 其二","author":"寇准","text":"危栏秋尽偶来凭，霜落秋山爽气澄。\n谁道衡阳无雁过，数声残日下舂陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63876,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虚堂","author":"寇准","text":"虚堂寂寂草虫鸣，攲枕难忘是旧情。\n斜月半轩疏树影，夜深风露更凄清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63877,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游花岩寺","author":"寇准","text":"寺对南山积翠浓，水村鸥鹭下遥空。\n层楼望尽樊川景，恨不凭栏烟雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63878,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"辇下春日","author":"寇准","text":"雨馀宫阙丽春阴，三月花光照上林。\n谁倚青楼望归骑，日斜南陌柳烟深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63879,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送转运梅学士巡边郡四首 其四","author":"寇准","text":"夙驾巡边徼，归程隔乱山。\n长安花木丽，春苑待君还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63880,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送转运梅学士巡边郡四首 其三","author":"寇准","text":"水远沉来信，山长叠去愁。\n夜深关月白，休凭驿边楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63881,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送转运梅学士巡边郡四首 其二","author":"寇准","text":"绝塞程方远，穷阴岁欲残。\n石城归梦断，陇月照人寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63882,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送转运梅学士巡边郡四首 其一","author":"寇准","text":"怅饮惜离群，穷边去路分。\n雪深山馆夜，孤雁背灯闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63883,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"微凉","author":"寇准","text":"高桐深密间幽篁，乳燕声稀夏日长。\n独坐水亭风满袖，世间清景是微凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63884,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感旧","author":"寇准","text":"长思密勿侍甘泉，丹地翱翔独少年。\n重到文昌倍惆怅，秋风霜鬓共萧然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63885,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"新蝉","author":"寇准","text":"寂寂宫槐雨乍晴，高枝微带夕阳明。\n临风忽起悲秋思，独听新蝉第一声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63886,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"暇日 其一","author":"寇准","text":"江楼昼静春阴变，日午帘空飞乳燕。\n帆稀客散野岸空，隐隐遥峰望中见。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63887,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"醉题","author":"寇准","text":"榴花满瓮拨寒醅，痛饮能令百恨开。\n大抵天真有高趣，腾腾须入醉乡来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63888,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题庐山太平兴国宫","author":"寇准","text":"飞泉喷薄走虹蜺，远岫峥嵘植玉圭。\n若有桃花镇开落，游人应认武陵溪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63889,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"与诗友会宿","author":"寇准","text":"此夕南轩宿，论诗万虑忘。\n苦吟秋信近，寂坐漏声长。\n室静灯光暗，桐疏露气凉。\n幽怀聊自遣，山色渐苍苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63890,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书山馆壁","author":"寇准","text":"秋作西南使，千林覆去程。\n四时无日影，终夜有猿声。\n路入溪云过，人穿鸟道行。\n不堪孤驿望，风雨动乡情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63891,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书怀寄韦山人","author":"寇准","text":"万事不关虑，孤吟役此生。\n风骚中旨趣，山水里心情。\n众木彫寒色，空江喷暮声。\n终期谒君子，同绕绿苔行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63892,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书怀寄唐工部","author":"寇准","text":"不才曾忝吾君选，紫殿科名志已酬。\n孤立敢言逾素分，高吟深愧预清流。\n西风独见江蓠暮，红叶还思苑树秋。\n多谢明公知贱节，每贻清句缓牢愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63893,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"书黄山馆壁","author":"寇准","text":"残日住孤馆，迟迟行古台。\n大河连野去，白鸟背城来。\n离恨浑如结，乡心渐欲灰。\n山花半寥落，犹在社前开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":63894,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]