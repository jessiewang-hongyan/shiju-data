[{"title":"贤者之孝二百四十首 其六十六 董仲舒","author":"林同","text":"汉有孝廉举，谁知发自舒。\n可怜三策罢，却去相江都。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28270,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贤者之孝二百四十首 其一五八 谢朏","author":"林同","text":"直以父名戏，其为君命同。\n朏能礼自处，似是胜超宗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28271,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贤者之孝二百四十首 其四 微子","author":"林同","text":"岂计身封宋，祗愁祀绝殷。\n不惟称克孝，亦自有三仁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28272,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贤者之孝二百四十首 其一一一 窦章","author":"林同","text":"蔬食可堪贫，勤哉孝养亲。\n蓬莱知不远，应是著斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28273,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贤者之孝二百四十首 其二十一 蓼莪孝子","author":"林同","text":"莫遂终养志，难酬罔极恩。\n哀哀父母句，肠断不堪闻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28274,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贤者之孝二百四十首 其九十五 蔡顺","author":"林同","text":"贼疑拾葚异，母怪弃薪还。\n雷震辄圜墓，火飞因伏棺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28275,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贤者之孝二百四十首 其六十九 霍去病","author":"林同","text":"不早知此体，元来托大人。\n低头拜县吏，谁拟霍将军。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28276,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禽兽昆虫之孝十首 其八 豺獭","author":"林同","text":"曾闻豺祭兽，还见獭陈鱼。\n人苟不知祭，能如豺獭无。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28277,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禽兽昆虫之孝十首 其九 蛇","author":"林同","text":"似有人传讣，来从榛莽中。\n叩头至流血，垂泣有哀容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28278,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"禽兽昆虫之孝十首 其三 燕雀","author":"林同","text":"共母一屋下，宁知屋欲然。\n不须讥寡智，相哺政堪怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28279,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题嘉祐院东轩","author":"林师蒧","text":"到处已无花可吹，东风犹自舞残枝。\n山僧只解关门睡，春去春来总不知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28280,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"熊守子复左史刻九朝宸翰寘于台学赋诗记之","author":"林师蒧","text":"皇天祐宋实历昌，列圣功德高虞唐。\n万机馀暇不自逸，银钩铁画挥天章。\n洋洋谟训揭日月，留心庶事宁少忘。\n当时赐予皆贤杰，至今缇袭为珍藏。\n丹邱史君武夷仙，快凌紫清登玉堂。\n亲从芸阁获墨本，宝如金玉留巾箱。\n承明厌直暂出守，邦人尽喜来龚黄。\n公馀铃斋静无事，祖宗盛烈思发扬。\n编摩允属大手笔，白玉镂牒陈胶庠。\n要令衿佩睹盛事，端拜伏读思激昂。\n明如星斗丽霄汉，奎躔壁宿纷光芒。\n翻如和气结云雾，氛氲融液为嘉祥。\n龙蛇委迤欲飞举，鸾凤宛转争翱翔。\n晋唐数君无出右，王颜诸子难比方。\n史君一旦出奇秘，岂与刘洎争升床。\n亟聆飞诏下丹阙，指日入觐登明光。\n云龙风虎庆会遇，股肱元首歌明良。\n邦人颂戴自今始，为公纪德龟趺旁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28281,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酹江月/念奴娇","author":"林式之","text":"桐皋东去，又依然、烟际云边柔橹。\n赖有双台知己耳，牢落孤怀欲吐。\n小倚云根，细商心事，提起千年语。\n九天飞梦，别来长记幽渚。\n试说北海归文，西山何事，犹不甘臣武。\n广大尧天箕颍小，绵上可能如许。\n举世真痴，先生长啸，尘海谁堪与。\n啸声吹送，刺天鸾鹤冲举。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28282,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题安隐院曲竹","author":"林次麟","text":"直节棱棱是此君，耳孙却以曲为名。\n首阳山下知难种，祇可斜封向管城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28283,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"林观过","text":"公来无琴鹤，公去有芒鞋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28284,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"歌","author":"林自然","text":"访古老洞天，撞见神仙饮三杯。\n复三杯，又三杯，不觉醺醺醉。\n回头看人间，身在青烟外。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28285,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"西江月","author":"林自然","text":"二十馀年访道，经游万水千山。\n明师未遇肯安闲。\n几度拈香一瓣。\n幸遇至人说破，虚无妙用循环。\n工夫只在片时间。\n遍体神光灿烂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28286,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"酹江月/念奴娇 其九 金丹合潮候图","author":"林自然","text":"凿开混沌，见钱塘南控、长江凝碧。\n今古词人图此景，谁解推原端的。\n岁去年来，日庚月甲，因甚无差忒。\n如今说破，要知天地来历。\n道散有一强名，五行颠倒，互列乾坤历。\n坎水逆流朝丙户，随月盈亏消息。\n气到中秋，金能生水，倍涌千重雪。\n神仙妙用，与潮没个差别。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28287,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浯溪 其一","author":"林访","text":"灵武储皇识事端，解将权术济艰难。\n当时若徇区区节，宗社何由获再安。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28288,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浯溪 其二","author":"林访","text":"文士相轻自古然，堪嗟嘲咏费雕镌。\n元颜文笔非馀子，未可毛疵议昔贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28289,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"感时","author":"林伯元","text":"旧谷新丝价未平，田苗一半属官青。\n白头老子面如鬼，倚杖开门见彗星。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28290,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"浯溪","author":"林伯成","text":"读时方喜能戡乱，责备犹疑过颂功。\n归美纵来臣子事，谁歌宋德乃心同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28291,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"枕流轩","author":"林伯材","text":"谁在红莲阵里行，泠泠飞玉抱山清。\n几番人世兴亡梦，千古云涯黯淡声。\n春暖藓花随雨到，夜深寒月落溪明。\n倦怀一枕清凉地，斗薮尘埃羽翼生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28292,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蓝溪次曾状元韵","author":"林伯春","text":"羊肠路入最高峰，倦倚东风点瘦筇。\n芳草有情春意远，青山依旧暮云重。\n新来梵阁添奇观，前度诗人带老容。\n寄我此身天地里，梦回林杪一声钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28293,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"凤栖梧/蝶恋花 施司谏冬生日","author":"林伯镇","text":"破腊星回春可数。\n天佑中兴，岳降神生再。\n造膝一言曾寤主，翱翔历遍清华路。\n盖代功名知自许。\n倦把州麾，小向琳宫任。\n早晚诏催归禁署，致身宰相双亲具。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28294,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"南乡子","author":"林伯镇","text":"弥诞秩初筵。\n催舞春雷杂管弦。\n惊破梅梢香喷雪，都缘。\n王母瑶池会列仙。\n残腊嫩寒天。\n恰在正朝两日前。\n搀借椒花先献寿，新元。\n重数壬辰第一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28295,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"喜迁莺","author":"林伯镇","text":"百年卿族。\n更七叶桂籍，蝉联相续。\n早冠鳌峰，入持魁柄，却商野耕岩筑。\n搢绅望山瞻斗。\n勋业铭书金竹。\n倦陶冶，暂镜湖舒啸，琳宫休足。\n催促。\n归秉轴，须与君王，同享无疆福。\n缓访赤松，莫留绿野，宇县待公恢复。\n手把命圭堂印，腰束精镠寒玉。\n愿岁岁，看和羹梅绽，古阶槐绿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28296,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"波斯岩","author":"林岊","text":"何物波斯有此岩，岩前岩后著深潭。\n双猊顾母鱼鳞脊，峙阙迎宾玉笋簪。\n立塑崩崖天入牖，垂缨宝盖佛留龛。\n使君劝课亲来此，谩与邦人父老谈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28297,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"青田岩","author":"林岊","text":"老鹤回翔去几年，至今岩壑此名传。\n跻攀分寸疑无路，飞入方壶却有天。\n白象绿狮呈怪石，神泉深洞隐真仙。\n细看滴乳流脂处，不是青田是玉田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28298,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"砻岩","author":"林岊","text":"尝闻仙人渡海术，授以尺杖如飞龙。\n凭虚闭目不敢瞬，波涛汹涌喧天风。\n兹岩山窟飞海岸，直扫一涧声何雄。\n瞑行千步水入耳，明探万壑云生胸。\n嵚崖滴乳芝玉脆，剜穴喷水莲腮红。\n神仙缥缈在何许，心平意定天为通。\n此行况复匪游戏，出门借问春耕农。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28299,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"盘石","author":"林岊","text":"捲烟阁西官道长，一水东注襟沧浪。\n山连踞虎岩如屋，栈接飞鸾石作梁。\n田野四时歌乐土，关河千里隔蛮乡。\n我来九载叨民牧，亿万斯年说太康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28300,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"林岊","text":"山中有寺寺有阁，阁外之山横翠来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28301,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"溪上谣","author":"林希逸","text":"溪上行吟山里应，山边闲步溪间影。\n每因人语识山声，却向溪光见人性。\n溪流自漱溪不喧，山鸟相呼山愈静。\n野鸡伏卵似养丹，睡鸭依芦如入定。\n人生何必学臞仙，我行自乐疑散圣。\n无人独赋溪山谣，山能远和溪能听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28302,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"君子岩","author":"林应隆","text":"石楼千丈锁山南，青壁盘桓下有岩。\n知是何年隐君子，清名留得在烟岚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28303,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游碧沼胜居","author":"林杜娘","text":"幽谷泉声冷，鸟啼僧定深。\n好花丛古砌，寒瀑发高岑。\n游客陆鸿渐，居人支道林。\n欲归青嶂去，临去复沈吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28304,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"莲花峰","author":"林杞","text":"天开八叶莲花峰，神龟引子巢其中。\n千年皮骨老化石，玉色不与凡工同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28305,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"游鸣山","author":"林芘","text":"杏花舞径乱红雨，麦浪涨空摇翠烟。\n十里清风寻小寺，快船如马水如天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28306,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"观潮阁","author":"林芘","text":"江山不受范，偃蹇散莫收。\n领略得要会，聚此百尺楼。\n霁色明千峰，斜阳带归舟。\n堪洗北客尘，似脱南冠囚。\n二子倚秋晚，岸巾送明眸。\n杯寒风景切，句落云烟愁。\n况我江海人，二顷亦易秋。\n百年鸥盟在，脱帻行当休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28307,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"龙隐洞","author":"林谷","text":"峥嵘头角隐何年，直露灵光在此间。\n天下苍生方引领，好施膏雨润人寰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28308,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"嘲张乂","author":"林叔弓","text":"中分爻两段，风使十横斜。\n文上元无分，人前强出些。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28309,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"不见胡仲隶题苏溪僧壁","author":"林季仲","text":"念别三年久，相望一舍间。\n无人寄消息，风雨暗前山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28310,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失子","author":"林季仲","text":"檐鹊哺雏时自喜，垄牛舐犊互相嘘。\n老妻觑我无他语，欢笑何年得似渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28311,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"失题","author":"林季仲","text":"平生丘壑自相于，幽意悠然入画图。\n好向溪边石矶上，羊裘披我作狂奴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28312,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"厌于行役感梅赋诗","author":"林季仲","text":"归袖曾攀墙外子，征鞍又拂雪中花。\n往来应被江梅笑，笑我经年不在家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28313,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵十叔父书怀","author":"林季仲","text":"咸阳市上欲思归，人到于今笑李斯。\n老去何如我痴叔，了无一事独支颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28314,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和康侍郎雪后小雨二首 其二","author":"林季仲","text":"白头羞见尊前烛，赪颊深凭瓮里春。\n不分落梅纷似雪，更兼疏雨细如尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28315,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵和康侍郎雪后小雨二首 其一","author":"林季仲","text":"残霙初伴梅梢月，小雨仍禁柳底春。\n莫厌酒摇金盏浪，更听歌绕画梁尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28316,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵苗彦先题薛献可新居四首 其四","author":"林季仲","text":"轩槛青红压水滨，小桥斜出树横陈。\n功名豫计殊非计，且与龟鱼作主人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28317,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵苗彦先题薛献可新居四首 其三","author":"林季仲","text":"西山拿得落檐前，飞翠侵帘夕更妍。\n心远地偏如靖节，江湖处处是斜川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28318,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵苗彦先题薛献可新居四首 其二","author":"林季仲","text":"方塘环植绿杨新，朱户重重欲闭春。\n若许茅茨傍清泚，敢教鹅鸭恼比邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28319,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"次韵苗彦先题薛献可新居四首 其一","author":"林季仲","text":"仙隐深深竹径中，杖藜还许我相从。\n君能惜取清阴在，斤斧须令赦箨龙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28320,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"访梅值雪示觉慈升老","author":"林季仲","text":"林峦出没晚云低，旋放寒梅照浅溪。\n雪意殷勤解留客，不教归马识东西。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28321,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过东阳诸人饯别独刘叔明不至","author":"林季仲","text":"松竹森森灏气生，一帘疏雨故人情。\n扁舟还载离愁去，不见西城刘叔明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28322,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"过荆山寺","author":"林季仲","text":"丛条曾欲截来辕，应讶行人数往还。\n归老故园犹得在，满斟杯酒谢荆山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28323,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和康侍郎喜雪二首 其二","author":"林季仲","text":"不扫林间一径开，夜深留伴月皑皑。\n问谁踏我琼瑶碎，新有诗筒破晓来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28324,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和康侍郎喜雪二首 其一","author":"林季仲","text":"六出随轩逞厥祥，天人应感得能忙。\n使君未到然香处，先有心香叩上苍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28325,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊行感怀 其四","author":"林季仲","text":"一夫容易缚淮阴，辟谷留侯念已深。\n去伴赤松聊尔尔，后人真向海山寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28326,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊行感怀 其一","author":"林季仲","text":"路转溪回草木香，有人荷笠山之阳。\n定知我是金华守，笑道牧民如牧羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28327,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊行感怀 其三","author":"林季仲","text":"竹光野色净祠堂，古木千章俨在傍。\n矫矫先生竟何往，痴儿犹认石为羊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28328,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"郊行感怀 其二","author":"林季仲","text":"羽仗霓旌去不还，空馀菊水照人寒。\n至今山下无枯草，便是田家九转丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28329,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"钓台","author":"林季仲","text":"脱身归去亦何求，刚被声名落钓钩。\n买得扁舟在祠下，从公觅取旧羊裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28330,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赵殿撰赏红梅次韵","author":"林季仲","text":"西湖独未赋红梅，留待知音细细开。\n好把新诗补遗逸，不才空与作云来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28331,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送张侍郎归省","author":"林季仲","text":"时时去弄老莱衣，也似何蕃岁一归。\n相送江头无一语，寸心遥与白云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28332,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"重九前一日宿灵岩","author":"林季仲","text":"马上衰颓只自嗟，惊心那复见黄花。\n花如相问终羞涩，底甚重阳不在家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28333,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"罢官金华手植秋香而去通判赋诗勉强次韵","author":"林季仲","text":"孤根忆向雪中移，早被春风次第知。\n夺汝岩栖近城郭，多应相怨不相思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28334,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"罢金华留别双青","author":"林季仲","text":"手植双青十八年，墙头一见一凄然。\n饱尝霜露休相忆，我欲归耕瘴海边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28335,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袁居士来自桐庐索诗赠二绝句 其一","author":"林季仲","text":"霜髯垂臆杖过眉，得得桐庐江上来。\n对我休谈钓台好，姓名方挂北山移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28336,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"袁居士来自桐庐索诗赠二绝句 其二","author":"林季仲","text":"木落空山霜露寒，却驱羸马傍长安。\n君看仕路风波恶，孰与严陵七里滩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28337,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿中竺碧梧轩","author":"林季仲","text":"梦破初惊枕簟秋，懒思身世独搔头。\n山禽强欲知人事，叶底移时语未休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28338,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿天台石桥 其二","author":"林季仲","text":"今人议论只从多，篑土那能障大河。\n我有室庐亦方广，归途不向石桥过。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28339,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿天台石桥 其一","author":"林季仲","text":"卧听泉声似雨声，直愁泥滑马难行。\n世间疑事多如许，千百年来谁与明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28340,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"宿钱塘江诗","author":"林季仲","text":"大江推月上层霄，夜色分人此最饶。\n乡国未成千里梦，海门又捲五更潮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":28341,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]