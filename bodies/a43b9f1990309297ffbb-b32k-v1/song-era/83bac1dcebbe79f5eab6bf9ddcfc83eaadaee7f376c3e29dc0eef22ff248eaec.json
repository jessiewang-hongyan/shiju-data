[{"title":"呈潘潭州十首 其八","author":"赵蕃","text":"少陵已入严公幕，徐孺还为仲举宾。\n自愧无诗复非隐，况堪谋食更忧贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47538,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈潘潭州十首 其七","author":"赵蕃","text":"昔者湘西借榻眠，自嗟老眼负青编。\n虽然旧识山中趣，绝爱松风泻百泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47539,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈潘潭州十首 其六","author":"赵蕃","text":"犯雪渠乘访戴舟，不逢安道便归休。\n我今一月春风里，纵复回舟匪浪游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47540,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈潘潭州十首 其五","author":"赵蕃","text":"微官本欲救饥寒，欲逭啼号政尔难。\n不是贤侯任吾耻，未容陋巷乐瓢箪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47541,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈潘潭州十首 其四","author":"赵蕃","text":"楚国固多兰与荃，长林野水若何边。\n樵夫政自不知贵，采卖何曾直一钱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47542,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈潘潭州十首 其三","author":"赵蕃","text":"梅花初出炯如冰，未许馀花似我能。\n太息天公不加意，放教风雨苦侵陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47543,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈潘潭州十首 其二","author":"赵蕃","text":"江边石上白皑皑，远对难分李与梅。\n因是欲占春早晚，桃花一树有新开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47544,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"呈潘潭州十首 其一","author":"赵蕃","text":"西江亭上东风客，鸥鸟重来似亦驯。\n买得小舟连夜发，不知肯别定留人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47545,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"妙香院僧堂后路直临溪石台古松蟠其上松之下有足迹及石穴三十馀浅容杯水问僧云自昔葛洪鍊丹种桃于此穴乃丹灶其数三十有二适与龟峰相应亦谓足迹为仙人迹又有云日光照石壁隐若青红盖桃影云作两绝 其一","author":"赵蕃","text":"台高十丈独株松，下有仙人旧履踪。\n三十二窠丹灶在，亦云数目应龟峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47546,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"妙香院僧堂后路直临溪石台古松蟠其上松之下有足迹及石穴三十馀浅容杯水问僧云自昔葛洪鍊丹种桃于此穴乃丹灶其数三十有二适与龟峰相应亦谓足迹为仙人迹又有云日光照石壁隐若青红盖桃影云作两绝 其二","author":"赵蕃","text":"壁间石色隐青红，指似夭夭即此中。\n金石著文犹叵信，况堪传者自渔翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47547,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孝扬成父约须晴见过二首 其二","author":"赵蕃","text":"雨来喜逭车田苦，晴至欣成穫稻忙。\n协趣终焉在农舍，倦游不拟老官仓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47548,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"孝扬成父约须晴见过二首 其一","author":"赵蕃","text":"积雨能凉故自佳，候当秋早欲收畬。\n频宵佳月连朝雾，雾破山空日已斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47549,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张帅置酒环波觞孙会之签判严造道主簿及蕃作绝句呈二君","author":"赵蕃","text":"炎蒸三伏有无中，十里荷花四面风。\n严濑苏门两奇侣，一尊共德使君公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47550,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张伯永折梅走笔谢之","author":"赵蕃","text":"岁晚梅花未经眼，自嗟枉作近南官。\n忽来数朵惊初识，已是先生觅句残。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47551,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张伯永和诗以仆送笋减于常年复用韵以调一笑 其二","author":"赵蕃","text":"八珍既饱思持去，借问何如一脔尝。\n笋例减常犹费说，可堪馀事极更张。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47552,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"张伯永和诗以仆送笋减于常年复用韵以调一笑 其一","author":"赵蕃","text":"竹薄方思渐补锄，笋时可得尽驱除。\n此生已负管城债，计且不悛真个疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47553,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀玉山旧游寄王彦博徐审知 其一","author":"赵蕃","text":"南山白塔高何许，弄日摩穹相与曾。\n放歌直下清溪去，落日半衔渔木灯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47554,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀玉山旧游寄王彦博徐审知 其二","author":"赵蕃","text":"何人作亭山半道，颇解发舒山掩藏。\n几度携筇挽君去，月高人寂尚绳床。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47555,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀玉山旧游寄王彦博徐审知 其四","author":"赵蕃","text":"王郎家近石田溪，溪上行人古路迷。\n王郎家苦了无事，自沟溪水灌蔬畦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47556,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀玉山旧游寄王彦博徐审知 其三","author":"赵蕃","text":"下湖堤上青青柳，曾为行人系马鞍。\n落魄还成一春事，料应飞絮也漫漫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47557,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀远父斯远成父 其二","author":"赵蕃","text":"春风吹雨昼成昏，萧寺萧条早闭门。\n坐久行人更萧瑟，定倾老酒向何村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47558,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀远父斯远成父 其一","author":"赵蕃","text":"徐郎已渡浙江潮，王子还从折简招。\n平日往还惟二士，去余何以慰亡聊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47559,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀明叔","author":"赵蕃","text":"江天买得总输君，我亦当年作记人。\n珍重平生一杯酒，又孤洲渚绿生春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47560,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀祖印","author":"赵蕃","text":"古寺僧容客寓居，客行仍许借藏书。\n老无眼力书慵看，忆著竹根泉漱渠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47561,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"怀梅花及斯远","author":"赵蕃","text":"几思载酒更携筇，一访梅花山崦中。\n忽念去君三十里，怅然将复与谁同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47562,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投王饶州日勤四首 其四","author":"赵蕃","text":"使君本是经邦手，聊为疲民滞一方。\n直道正声谁可拟，百年文正故堂堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47563,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投王饶州日勤四首 其三","author":"赵蕃","text":"为政悬知如治疾，岂求汤砭一时功。\n但今安养无遗策，肤革充盈由本丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47564,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投王饶州日勤四首 其二","author":"赵蕃","text":"我行三日鄱阳路，每向居民说岁年。\n荞麦吐花胜宿麦，山田小旱熟湖田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47565,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投王饶州日勤四首 其一","author":"赵蕃","text":"福星谁遣出虚危，帝念鄱人因数饥。\n试问公来若为政，皆言吏瘠与民肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47566,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投曾秀州逢四首 其四","author":"赵蕃","text":"请到江西得正宗，后来曾吕出群雄。\n大阳遗履归何处，端欲从公一破聋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47567,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投曾秀州逢四首 其三","author":"赵蕃","text":"有蟹无监乃乐邦，人生如意信难双。\n公才自是明堂用，寄语蚍蜉盍少降。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47568,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投曾秀州逢四首 其二","author":"赵蕃","text":"人物如公乃作州，不知谁合致公侯。\n清名不与官称等，颇解天公用意不。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47569,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"投曾秀州逢四首 其一","author":"赵蕃","text":"我向茶山得屡行，至今人说老先生。\n九原不作吾安仰，宗武宗文贤弟兄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47570,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"折梅赠答二首 其二","author":"赵蕃","text":"昔人行役功名误，嗟我何为久未回。\n落尽繁花有青子，期君烟雨上池台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47571,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"折梅赠答二首 其一","author":"赵蕃","text":"送君祇数梅花节，开到岭梅君不回。\n折得花来有重出，妾惟孤影愧妆台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47572,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"报谒徐大雅仁因以题赠三首 其三","author":"赵蕃","text":"兰芽紫坼映青盆，杏蕊红深供佛瓶。\n何独春能归草木，看君已老鬓重青。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47573,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"报谒徐大雅仁因以题赠三首 其二","author":"赵蕃","text":"我住东郊祇树园，无人肯顾席为门。\n多君用意非流俗，忙里偷閒每见存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47574,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"报谒徐大雅仁因以题赠三首 其一","author":"赵蕃","text":"好在东都孺子孙，壮年曾谒舍人门。\n祇今此道同终少，君独深藏耻自论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47575,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"杨知录送千叶白莲","author":"赵蕃","text":"几思载酒问扬雄，不但尊空囊亦空。\n枉道荷花有新发，又闻能白胜能红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47576,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步北园示沈四弟","author":"赵蕃","text":"得趣堂到蓬荟深，主人何惜费千金。\n我行旬月当重到，要见梅花出树林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47577,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步溪头 其二","author":"赵蕃","text":"浴凫拍拍已春声，相趁双飞属玉明。\n更待前山一犁足，断槎号濑总波平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47578,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步溪头 其三","author":"赵蕃","text":"草软沙平路不泥，岸巾扶策步循堤。\n江南春事信能早，正月已闻林鸟啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47579,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"步溪头 其一","author":"赵蕃","text":"溪头弱柳已丝垂，那得江南尚好枝。\n从此春风日亡赖，与须排写付新诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47580,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沅陵见招赏海棠病不能往辄尔言谢三首 其三","author":"赵蕃","text":"二月已尽三月来，计君行日已相催。\n奈何病著不能往，岂但看花仍把杯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47581,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沅陵见招赏海棠病不能往辄尔言谢三首 其二","author":"赵蕃","text":"四海知名蜀海棠，是邦元与蜀同方。\n少陵当日犹无语，而我何人敢漫狂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47582,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沅陵见招赏海棠病不能往辄尔言谢三首 其一","author":"赵蕃","text":"去年已负海棠期，今岁还当卧病时。\n造物小儿应见相，恐余无此看花时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47583,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沅陵契丈用蕃将至辰州寄在伯兄韵作诗见属用韵奉答二首 其二","author":"赵蕃","text":"能事岂工刀与笔，閒情聊付咏而觞。\n生前忧累须陶写，身后声名尽在亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47584,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"沅陵契丈用蕃将至辰州寄在伯兄韵作诗见属用韵奉答二首 其一","author":"赵蕃","text":"往日交游才著我，近来酬唱喜添君。\n请君立拜诗坛将，容我閒寻茗椀勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47585,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"灵鹫道间","author":"赵蕃","text":"霏霏小雨湿松株，疑是初成道士图。\n我亦搜诗要穷底，此时幽思不枝梧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47586,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"社日醉起","author":"赵蕃","text":"醉状初如春水船，梦成蝴蝶更翩翩。\n觉来已是情无奈，那更急风吹雨颠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47587,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花屿","author":"赵蕃","text":"杨垂空寄恨，草碧会添愁。\n祇有花无数，春风醉不休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47588,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"花屏","author":"赵蕃","text":"阴能间其疏，竹可扶其弱。\n点缀自天然，讵须金孔雀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47589,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"赤岸道中呈斯远","author":"赵蕃","text":"小雨洗红叶，青山舒白云。\n秋风有奇处，我友得平分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47590,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还家二绝 其一","author":"赵蕃","text":"小出端如远客归，仆迎儿候犬循衣。\n家人不问城中事，但道雨多蔬茹肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47591,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"还家二绝 其二","author":"赵蕃","text":"竹因易叶听风吹，入屋穿窗纵所之。\n我亦闭斋愆扫溉，渠因投隙遂纷披。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47592,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连日得顺风","author":"赵蕃","text":"上水深虞费挽牵，顺风似得江神怜。\n云山好处留不得，纵望令人空惘然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47593,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连雪不已复作绝句咏之及六而止殆未免不愁冻杀之诮也 其四","author":"赵蕃","text":"不假丹青手，居成水墨图。\n莫嗟玄尚白，靡叹粪难污。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47594,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连雪不已复作绝句咏之及六而止殆未免不愁冻杀之诮也 其二","author":"赵蕃","text":"对岸初封屋，临流已蔽汀。\n长江停衮衮，去鸟失冥冥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47595,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连雪不已复作绝句咏之及六而止殆未免不愁冻杀之诮也 其六","author":"赵蕃","text":"背荫常先积，当明竟早消。\n草衰犹秀色，柳悴亦长条。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47596,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连雪不已复作绝句咏之及六而止殆未免不愁冻杀之诮也 其三","author":"赵蕃","text":"勿谓虚明质，能成积厌威。\n由轻终及重，至著本从微。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47597,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"连雪不已复作绝句咏之及六而止殆未免不愁冻杀之诮也 其一","author":"赵蕃","text":"粲粲初投米，飘飘旋落花。\n巷深迷吠犬，林合误归鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47598,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闷坐 其一","author":"赵蕃","text":"天气欲阴还欲晴，病多愁绝两关情。\n梅花已是飘零尽，底事春风恨未平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47599,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"闷坐 其二","author":"赵蕃","text":"天气欲晴还欲阴，强扶头起更岑岑。\n睡魔欲遣茶料理，政恐蔬肠不易禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47600,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"冽泉","author":"赵蕃","text":"名士每名泉，一瓢宁取贤。\n道行期及物，为涧定为川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47601,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"到江口寺","author":"赵蕃","text":"已绝朱林渡，还瞻白塔擎。\n欲从微径陟，复命小舟横。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47602,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卓文君","author":"赵蕃","text":"成都共逸为琴心，岂不尝闻赋丽淫。\n重聘茂陵今已晚，不须多赋白头吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47603,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜过王兆明","author":"赵蕃","text":"门外春风吹倒人，过门宁惜滞车轮。\n君能劝我杯中物，我亦挥君壁上尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47604,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜作绝句三首 其三","author":"赵蕃","text":"高下钟声一听闻，林梢落月乱纷纷。\n忽来眼底诗无数，颇念高人与细分。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47605,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜作绝句三首 其二","author":"赵蕃","text":"月明入户白于霜，林影当檐耸若翔。\n睡味不应如许好，不来吟咏答寒螀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47606,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜作绝句三首 其一","author":"赵蕃","text":"秋入吟窗夜气清，旧书虽老眼犹明。\n悠悠行李空长铗，落落功名负短檠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47607,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐读书闻瓶梅之香口占五绝 其一","author":"赵蕃","text":"客去门扃未作眠，续灯添火了残编。\n此时孤绝谁相与，能送幽香亦可怜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47608,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐读书闻瓶梅之香口占五绝 其二","author":"赵蕃","text":"非风非月自腾香，我亦何心适与当。\n此味绝佳谁得解，顾须攀折走林塘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47609,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐读书闻瓶梅之香口占五绝 其四","author":"赵蕃","text":"身落江南不自悲，正欣梅也可供诗。\n纷纷桃李胡为者，政似当年蔡克儿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":47610,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"夜坐读书闻瓶梅之香口占五绝 其三","author":"赵蕃","text":"旧说春寒花较迟，况今