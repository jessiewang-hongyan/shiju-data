[{"title":"贻刘几","author":"张方平","text":"家自唐来世大儒，惟君不肯读家书。\n春游烂漫少曾醒，俊气飘扬频得卢。\n早讲猿公飞剑术，更通风后握机图。\n何时羽猎长围合，请看云中一鹗孤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36179,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢韩仲文学士送白竹簟","author":"张方平","text":"带粉裁疏节，凌霜剪翠筒。\n鲸鳞铺海浪，鹏翅展天风。\n暖恐春冰释，清宜晓魄融。\n露华流沆瀣，寒色凛崆峒。\n栩栩来庄蝶，??失夏虫。\n枕须松石碧，幌鄙雾绡红。\n坐觉非尘境，魂如在月宫。\n北窗聊寄傲，俗骨愧方瞳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36180,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金陵久旱喜雨呈运使韩综学士提刑令狐挺祠部及示诸府僚","author":"张方平","text":"江城风日燥将燃，喜此滂沱仅有年。\n诸泽气交阴压地，四溟水立阔围天。\n廓开紫宙清凉界，顿去骄阳跋扈权。\n须信化工人可代，傅岩才业在三篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36181,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"提刑祠部再和前篇猥为祷祈之应辄复次韵且以见志","author":"张方平","text":"长吏忧民深望岁，诸侯闵雨著编年。\n鹅鲜聊用遵明诏，尪鼻何能感上天。\n五事肃时敛在宥，九功美利属持权。\n守藩无状惟推分，必在蒙庄内外篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36182,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"谢浙漕刘忠顺郎中送簟","author":"张方平","text":"玉水一方光潋滟，霜华八尺翠琅玕。\n卧来病骨殊清快，胜饵西山五色丸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36183,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近自钟山采松花和汤甚美送汤一罂呈仲文学士 其一","author":"张方平","text":"青松北山麓，春蕊摘金团。\n芳泽逾肪节，滋华本岁寒。\n功传上品药，饵胜曲晨丹。\n一泛彤霞液，天和入肺肝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36184,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"近自钟山采松花和汤甚美送汤一罂呈仲文学士 其二","author":"张方平","text":"日精月华所滋结，金匮琼笈称灵珍。\n味胜仙人掌中露，色如游女衣上尘。\n饵之伐邪鍊神魄，久且长年登高真。\n轻瑿茯菟乃沦滓，嘉赏当问清遐人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36185,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"居忧过祥制示辰长老","author":"张方平","text":"流景无端隙驷驰，永怀顾复感慈闱。\n幸兹门外车马少，更复朝中书信稀。\n衰飒颠毛素丝短，芒佯病眼乱花飞。\n舍西赖与招提接，时叩禅关话祖机。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36186,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"贻辰长老","author":"张方平","text":"同流谁往还，终日掩柴关。\n壁观少林寺，门风先洞山。\n道场随处是，心地本来閒。\n指我常河水，都忘鬓发斑。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36187,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"离都招友人","author":"张方平","text":"车马交尘路不停，势家门巷密如萍。\n张汤筋力奈寒暑，楼护口舌摇风霆。\n机牙潜发如驰传，声影相连若建瓴。\n此地岂容山野客，盍归乎来掩岩扃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36188,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庆台韩子华寄示清居大士牧牛图颂酬寄长句","author":"张方平","text":"香严昔向沩山住，只作田翁学牧牛。\n路绝纤尘宁见迹，野无寸草漫回头。\n晴天任去云作伴，露地閒眠夜不收。\n却问清居真了未，树边蓑笠为谁留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36189,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"都下别友人","author":"张方平","text":"海内故人少，市楼新酒醇。\n与君聊一醉，公袂此残春。\n北道邢台路，东州泗水滨。\n相期复何处，京洛旧风尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36190,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄鲁平","author":"张方平","text":"平也青云器，乡评推孝廉。\n高怀焦尾澹，壮节湛卢铦。\n与我偏心照，论交以道詹。\n逸群容策蹇，美盼对无盐。\n振楫期同济，提衡岂致嫌。\n前年税征鞅，弥月憩衡苫。\n环堵藜为榻，圭门席挂檐。\n未曾忧四壁，聊与醉青帘。\n且默何尝说，虽寒不附炎。\n伏龙当自起，跃马要谁占。\n舌在居贫乐，情亲茹蓼甜。\n雅游伤遽散，流景顾将淹。\n信断伤秋雁，愁多伴夜蟾。\n不堪男女泪，北望一渐渐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36191,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄郭诚思华下茅斋","author":"张方平","text":"舍在世尘外，松扉夜不关。\n心同秋水静，身共野云閒。\n自得逾三乐，谁堪话九还。\n它年玉泉约，何以救衰颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36192,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄题都下知友山亭时在新定","author":"张方平","text":"古郡利名外，万山云霭中。\n思君痛饮处，累石小轩东。\n观阙风光近，郊园野趣同。\n溪头对鱼鸟，未羡舞裙红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36193,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"庵堂书怀呈郭诚思","author":"张方平","text":"晓驾白龙车，氤氲入紫霞。\n翠微云外路，碧落月中家。\n驶过刚风骑，閒如迥汉查。\n幽窗一攲枕，世虑自空花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36194,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"诚思约以初秋东来相过辄驰短韵以速行期","author":"张方平","text":"已闻露叶寒蝉急，休待霜空晓雁催。\n不是相思閒命驾，无为弟子望师来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36195,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"留别所知","author":"张方平","text":"雪拥归程朔吹寒，来时孤剑系征鞍。\n此行誓不忘知己，昨夜为公重一弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36196,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"熙宁壬子岁寄丁未同甲诸公秦亭吕宣徽宝臣汝阴欧阳少师永叔京下王尚书仲仪","author":"张方平","text":"百二十年名上寿，浮生百岁实稀闻。\n百年三万六千日，今已三分过二分。\n啸歌独喜齿全在，文字看来眼未昏。\n酒量虽衰犹得醉，尘中人事自纷纷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36197,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻翰林承旨宋子京尚书捐馆","author":"张方平","text":"平昔雍容两禁游，共陪帷幄奉咨谋。\n功名不到麒麟阁，词赋空传鹦鹉洲。\n事业三朝虚物望，声华一代擅风流。\n清时只作文章老，谁识深怀蕴九畴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36198,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"哭刘潜","author":"张方平","text":"尝谓君才似武侯，草庐牢落卧龙愁。\n天公不念苍生故，元叔堪怜郡吏休。\n蒿野已埋经国策，岩廊谁是富民侯。\n朝廷今始思英俊，不见庖丁刃一投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36199,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"闻郭诚思解化","author":"张方平","text":"溪堂月榭几分杯，暂住三峰约便回。\n斋榻忽留青竹去，庭除不待玉棺来。\n人间如幻宁同恨，天上修文亦用才。\n碧秀烟云无限好，此生勿复望崔嵬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36200,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"简徐登道人","author":"张方平","text":"闻说频来帝里游，药炉何日得同流。\n劝君只就红尘里，拨转河车万事休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36201,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"葛居士诗","author":"张方平","text":"三峰顶上五经秋，妙法白莲清净脩。\n无数天花常自散，真空性水不停流。\n病痴谁问维摩诘，俗眼徒嗟冉伯牛。\n别有妙身诸相具，金刚坚固异浮沤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36202,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"月夜吴春卿苏仪甫相过会饮忽闻五鼓遂同入朝","author":"张方平","text":"清风凉月满前轩，邂逅相逢索酒樽。\n东有启明俄动色，北来寒雁亦惊魂。\n相车未过尘先起，宫漏才终市早喧。\n阶下从人催上马，百官已是簇朝门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36203,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"寄崆峒天水公","author":"张方平","text":"先生莫可测，沧海远沈沈。\n詹尹徒端策，昭文不鼓琴。\n一丸天上药，几日静中吟。\n安得菊花酒，盈卮金液深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36204,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赴钱塘吴江道中寄侍读王君贶侍郎","author":"张方平","text":"画船浮震泽，烟水接秋空。\n一霎过云雨，满帆开岸风。\n酒旗莲荡里，僧刹橘洲中。\n何似并州路，尘高马队雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36205,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"赵先生王屋杖","author":"张方平","text":"待月移肩倚，听琴向膝横。\n溪桥经雨滑，山屐入云轻。\n击水乖龙起，书空老魅惊。\n夜归闻石响，鹤舞远来迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36206,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"中秋夜清思台独坐对月寄太傅曾鲁公宫师赵公","author":"张方平","text":"万籁沈声群动息，纤尘绝迹片云无。\n此时何物名身世，一点灵光彻太虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36207,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"苏子瞻寄铁藤杖","author":"张方平","text":"随书初见一枝藤，入手方知锻鍊精。\n远寄只缘怜我老，閒携常似共君行。\n静轩独倚身同瘦，小圃频游脚为轻。\n何日归舟上新洛，拄来河岸笑相迎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36208,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"西斋偶书","author":"张方平","text":"祖录忘筌后，丹炉住火时。\n浮生更无事，燕坐复何思。\n暖日移棋局，寒风促酒卮。\n世间安乐法，不独净名知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36209,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"南原观田","author":"张方平","text":"日长春事动，田野膏脉轻。\n草青布谷过，桑绿新蚕生。\n雨足有酒色，社近闻鼓声。\n牛羊暮归饱，舍中灯火明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36210,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"和叔平少师见示知足吟谈宗旨也","author":"张方平","text":"昨日看公知足吟，寂然不动至人心。\n视身无实元泡幻，观世皆空谩古今。\n忽忽岁穷驹度隙，尘尘事过鸟遗音。\n从来两个泥牛斗，一任相将入海深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36211,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题代祠部书院","author":"张方平","text":"上第西归即弃官，此人趣味亦堪怜。\n风波常自庙堂起，云壑不随朝市迁。\n野叟馈浆羞客气，山僧投拂悟尘缘。\n青城山下空堂在，留入华阳续旧编。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36212,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"登泰山太平顶","author":"张方平","text":"区区鲁国争蜗角，矗矗齐城磔猬毛。\n万壑相倾知地险，浮云忽散觉天高。\n苍烟自古埋尘世，红日中宵破海涛。\n七十二君迷旧迹，空教秦汉侈心劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36213,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题乐全堂","author":"张方平","text":"乐全得意自庄书，静阅流光乐有馀。\n四句幻泡明般若，一篇力命信冲虚。\n心閒自觉浮云薄，才拙诚知与世疏。\n只此空名漫儿戏，何王城阙不丘墟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36214,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"逍遥堂","author":"张方平","text":"真乐不违俗，红尘自满城。\n捲帘寒日暖，高枕暑风清。\n世累离忧患，天和得性情。\n五时依约合，多谢白云生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36215,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李少傅佚老亭","author":"张方平","text":"得谢自廊庙，事高疏仲翁。\n安车虽驷马，归路已冥鸿。\n令子承良冶，朱轓治左冯。\n缁衣方改造，列鼎有馀丰。\n屦杖居多适，轩裳梦觉空。\n天倪希柱史，性理问能公。\n窗槛开潇洒，风烟接郁葱。\n上方思贾谊，即奉小舆东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36216,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彭门城上见乡人社会怀古","author":"张方平","text":"南北分疆域，此城当要津。\n幻泡兴废速，蛮触战争频。\n世换山河旧，时平井邑新。\n喧喧村社散，多是白头人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36217,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"彭门公庭古桧为风雨所摧","author":"张方平","text":"杳杳参天气，亭亭构厦材。\n千年对霜雪，一夕折风雷。\n枕静疏声减，庭宽翠影开。\n梧桐与杨柳，娇色倚楼台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36218,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"暮秋登彭祖楼","author":"张方平","text":"危楼古城角，山色绕苍仓。\n寒日下何速，清风来甚长。\n烟尘恩战国，云水似江乡。\n重九登高近，阶前菊已香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36219,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"经远楼","author":"张方平","text":"中夏圣人调律吕，八荒异国入图书。\n从容德让唐虞远，驰骋战争秦汉馀。\n不道鼓旗无勇将，须知俎豆有真儒。\n功臣骑虎凶而国，常向冰渊审庙谟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36220,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"邽翠楼","author":"张方平","text":"一川墟宇暮烟中，楼堞笼山气象雄。\n北路荒原戎子国，东坡断堑隗嚣宫。\n马来洮海蕃城近，鹤去辽天越洞空。\n三十六程劳极目，陇云犹在故关东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36221,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"道斋","author":"张方平","text":"琼签隐诀旧曾寻，共秘还金妙旨深。\n会向本源分造化，即抛尘劫出来今。\n含生皆是坎离气，复会自知天地心。\n幻事徒劳聊一笑，他时云壑有知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36222,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"禅斋","author":"张方平","text":"昔年曾见琅邪老，为说楞伽最上乘。\n顿悟红炉一点雪，忽惊闇室百千灯。\n便超十地犹尘影，更透三关转葛藤。\n不住无为方自在，打除都尽即南能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36223,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凉轩","author":"张方平","text":"楼下凉轩六月凉，风窗一枕傲羲皇。\n寿山云影浮空近，罗谷泉声绕砌长。\n迥觉风尘非此世，不须雪月更交光。\n最宜羽客冰霜骨，共引瑶卮沆瀣浆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36224,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"精思阁","author":"张方平","text":"仙术初脩自性情，本除阴浊养阳明。\n三田窈窈通虚白，一路层层彻太清。\n寂不动中方见道，思无邪处好存诚。\n君如欲到逍遥国，须自还元第一程。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36225,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"凉轩秋意","author":"张方平","text":"南岭云岚开晓霁，北窗松竹度凉飔。\n閒攲碧簟石琴荐，静味丹经金钥匙。\n梦幻泡中何得失，雀蚊虻处苦喧卑。\n更令薰祓澄心阁，客自三峰到有期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36226,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦州即事","author":"张方平","text":"边清羽书息，事简使君慵。\n地僻俗客少，日长春睡浓。\n平安三路火，昏晓两山钟。\n戍满归心动，先随渭水东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36227,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦州后园春宴赠部署刘几阁使","author":"张方平","text":"柳暗三眠困，花繁二月香。\n情怀当酒尽，兴味为春长。\n叠鼓渔阳节，清讴北里妆。\n阶前乐无误，席上有周郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36228,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秦州晚宴即席示诸宾僚","author":"张方平","text":"秦川节物似西川，二月风光已不寒。\n犹去清明三候远，忽惊烂漫一春残。\n香随芳树频移席，晴爱遥山久凭栏。\n却忆京华胜游处，常为暮景促归鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36229,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"陇西郡麦积山有献白鹿者洁如霜雪驯养逾年放归旧山十二韵","author":"张方平","text":"地得金方正，山藏灵物珍。\n月宫遗玉兔，仙仗失霜麟。\n乳窦冰泉冷，晴原露草春。\n清风生涧壑，高格对松筠。\n久卧常存息，凝思若养神。\n烟崖一蹭蹬，华馆久埃尘。\n我意本云水，无心爱佩绅。\n平生厌俗客，待尔当嘉宾。\n萧洒襟情远，虚恬气韵真。\n桧轩同鹤静，竹渚伴鸥驯。\n龟智沾骊血，牺纯被绣巾。\n放归旧林麓，好去避虞人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36230,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"题松江曹生学舍","author":"张方平","text":"江边无限地，君舍劣容蜗。\n争鼓田家社，疏钟野寺斋。\n执经多卉服，牵葑待荆钗。\n秋雨鲈鱼美，时应钓藓崖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36231,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"金陵府署池上草堂","author":"张方平","text":"东方千骑忝藩侯，情味都如寓一丘。\n客气尽将还野马，机心聊自试沙鸥。\n时凭静几随飞蝶，强拂危冠笑沐猴。\n只向公斋得嘉遁，何须远逐赤松游。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36232,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"送屐韩仲文","author":"张方平","text":"江南到梅暑，蒸湿鲜晴明。\n聊仿登山样，无妨涉水行。\n齿牢防易折，蜡滑亦加轻。\n早幸还吾土，閒将挂后楹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36233,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"梦中吟","author":"张方平","text":"神归自何处，记此梦中吟。\n道为无心合，人因省语深。\n窗灯寒影薄，庭月晓光沈。\n悟境真泡幻，迷情妄古今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36234,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"秋夕听弹五弦琴","author":"张方平","text":"古风久已坏，今夕闻遗声。\n恍若忘身世，怡然通性情。\n缅怀有虞氏，旷想三代英。\n此时知此意，青天秋月明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36235,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"李太尉园池","author":"张方平","text":"骠骑子侯第，长门大主园。\n烟波二宫赐，宸翰四朝恩。\n禅客常摇拂，名流必解轩。\n春风与秋月，好景中空樽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36236,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"城南林园避暑示道友","author":"张方平","text":"不必山林远，且离朝市喧。\n前轩好风月，高客共琴樽。\n在所同浮世，何须忆故园。\n八琼还返事，聊更话根源。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36237,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"函谷关","author":"张方平","text":"沛公吊伐军戏下，百二鲁无藩楗牢。\n天险固非一姓有，孙谋宁在两崤高。\n县崖通栈遥连蜀，绝巘横空势走褒。\n几见狂图矜四塞，泥丸封处竟徒劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36238,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"游琅邪山寺","author":"张方平","text":"一径过萧森，幽提此独寻。\n俗游殊不意，僧话粗宽心。\n役役真何了，空空究竟深。\n尘劳何日脱，来伴远公吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36239,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"火车同郭诚思作","author":"张方平","text":"火车双轮驾九虬，出海直上昆崙丘。\n经天三百六十度，匝日一万四千周。\n电破重阴霹雳过，风开霁色烟云收。\n乾关坤轴极排轹，势阑却返无为洲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36240,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"初秋即事","author":"张方平","text":"久雨新晴后，秋风初起时。\n天倪一清旷，精爽入希夷。\n壁上吴生画，床头杜老诗。\n平常性酷爱，对眼忽如遗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36241,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}},{"title":"冬过豪贵故园有感","author":"张方平","text":"萧萧霜草晓风秋，忆是当年最胜游。\n车马自随寒日急，管弦肯入野云幽。\n流渠水断鱼何往，高树阴疏鸟不留。\n为问主人曾到否，自家池馆待谁修。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_3.csv","pointer":36242,"sha256":"ed4f93e4cb01a4d649806dad023e91c64a5ee54610a6a94832e9721a01e307e1","dynasty":"宋"}}]