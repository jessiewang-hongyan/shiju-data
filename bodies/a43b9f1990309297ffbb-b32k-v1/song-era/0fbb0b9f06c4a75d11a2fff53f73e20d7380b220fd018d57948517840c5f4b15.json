[{"title":"送周子馀赴松阳簿","author":"刘植","text":"长松虽剧县，主簿却优闲。\n溪浅清见石，斋空静对山。\n吏嚚嫌讼省，乡狭觉民艰。\n独称诗人意，行吟苔竹间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35129,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送周知丞之官桐庐","author":"刘植","text":"潮满桐江上，秋风洗印时。\n字民知最近，占位莫嫌卑。\n纸尾书名大，松边得句迟。\n定怀东阁老，无复寄来诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35130,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重游仙岩观瀑","author":"刘植","text":"四山云雾重，况复值梅天。\n瀑注玉函碧，派从银汉连。\n飞来三百尺，流润几千年。\n仙者路安在，翠萝青霭边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35131,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"重游法空寺","author":"刘植","text":"寺在方山顶，山深不厌登。\n瀑飞明月峡，桥渡夕阳僧。\n万法元皆妄，馀生了未能。\n累累塔边冢，几见谷为陵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35132,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"悼卢次元","author":"刘植","text":"屈贾幽沉地，单车去不归。\n湘江清见底，吟魄远何依。\n行旐冲残雨，新楸掩落晖。\n谁收遗箧藁，有子未胜衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35133,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"梅","author":"刘植","text":"欲问孤山讯，蹇驴行晓晴。\n一枝篱外见，数点雪中明。\n太洁难为友，群芳让作兄。\n何如伴高隐，岂必尽调羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35134,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"渔父","author":"刘植","text":"生不事农耕，悠然一舸轻。\n沅湘依旧绿，秦汉几回更。\n晚脍杂香茝，夜醺歌濯缨。\n岂同驰骛者，祇欲钓虚名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35135,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"喜曹东畎迁大理寺簿","author":"刘植","text":"九衢多雨后，庭下草痕新。\n终拟持平手，来为折槛人。\n印开桐荫午，吟久烛花春。\n却恨无来客，分题寄所亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35136,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"琵琶亭下问舟","author":"刘植","text":"西亭问津处，白傅此曾游。\n无复锦弦曲，空停估客舟。\n抛江春浪静，传柝夜烽收。\n最爱庐峰峭，相随过别州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35137,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答东阁","author":"刘植","text":"盎乏储空谩自豪，掬泉当酒味尤高。\n卖文近觉马卿倦，脱赠今无范叔袍。\n松下耕樵相尔汝，人间膏火自煎熬。\n荆山山里山如壁，壁罅犹堪种碧桃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35138,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"赋鲥鱼得真字","author":"刘植","text":"寒碧湛无尘，前溪得细鳞。\n香堪配杞菊，味不数菰莼。\n玉露双酘熟，秋风一箸新。\n钓缗吾自有，何用觅玄真。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35139,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"嘉禾兴圣院","author":"刘植","text":"禅关自幽阒，竹亦号真如。\n况是龙潜地，曾经凤食馀。\n土深抱节密，林净著行疏。\n谁谓乾淳达，清阴只似初。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35140,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"静乐赵观文挽词","author":"刘植","text":"大星殒地寂无光，砚席凝尘閟野堂。\n一老海滨天下慭，百年江左恨空长。\n家传遗稿归中秘，帝录元勋纪太常。\n路远生刍来未得，泪乾门下老刘郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35141,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题王宪使沧浪阁","author":"刘植","text":"城池浸空碧，鉴影复观心。\n孺子去何在，此歌传至今。\n一奁凉月白，万井市声沉。\n坎止宁劳问，凭栏意独深。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35142,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题薛氏园","author":"刘植","text":"屋头深锁屿头云，高下亭台景旋分。\n荷气晓来迎露看，泉声雨后隔溪闻。\n疏棂不碍松萝月，高柳时停鸥鹭群。\n只恐此身闲未得，徵书催发暑如焚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35143,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"致爽轩","author":"刘焞","text":"团团竹色绕郊居，勾引清风百亩馀。\n忆昔敲门苏内翰，而今下马范中书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35144,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"登东峰亭","author":"刘琦","text":"凯还几度宴东峰，新构危亭接梵宫。\n势入青冥横绝壁，路盘空曲压高松。\n临流自笑功名薄，对酒忻逢景色重。\n飘泊却惭归未得，日斜坐听暮云钟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35145,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题清芬阁","author":"刘琯","text":"自从笔削三千首，复见风骚二百年。\n佳句独为时辈许，幽光长伴客星悬。\n耳孙文采方高蹈，鼻祖声名更盛传。\n曾到先生栖隐处，桐君山下好林泉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35146,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"诘猫","author":"刘琰","text":"古人养客乏车鱼，今汝何功客不如。\n饭有溪鱼眠有毯，忍教鼠齧案头书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35147,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"王刚仲惠诗醉笔聊和","author":"刘琰","text":"君不见山泽之癯蒙野服，为彼隰桑还自沃。\n又不见侯门公子贵且娇，饱豢膏粱犹未足。\n人生贵贱不难分，唯有圣贤无等伦。\n朝为涂人暮为禹，穷崖断壑看回春。\n君方妙龄截不住，万里飞黄又腾世。\n王良造父不得施，耳侧风声未为遽。\n我思古人爱其宇，青蘋堂兮杜若庑。\n芰荷可裳菊可餐，肯逐纤埃与尘土。\n是中非声亦非色，安得与君一冯轼。\n鹍鹏变化不可量，要指天池为一息。\n悠悠此道谁能将，从知可玩不可忘。\n慎勿随风学飘絮，春光骀荡成飞扬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35148,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"句","author":"刘琰","text":"呜呼诸将官日穹，岂知万鬼号阴风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35149,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吏隐堂","author":"刘舜臣","text":"事因地僻方知少，官得公馀始信闲。\n且喜诗同文史乐，不须身与利名关。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35150,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"仙游亭诗赠丁晋公","author":"刘遁","text":"屡在仙游亭上醉，仙游洞里杳无人。\n他时鸣鹤归沧海，同看蓬莱岛上春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35151,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"游閤皂山","author":"尤袤","text":"春山灵草百花香，谁识仙家日月长。\n满院莓苔绿阴匝，棋声何处隔宫墙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35152,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宗教院","author":"刘铸","text":"雨过江山丽，春深笋蕨肥。\n扶藜苍藓破，移榻乱云飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35153,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"满庭芳","author":"刘颉","text":"莺老梅黄，水寒烟淡，断香谁与添温。\n宝缸初上，花影伴芳尊。\n细细轻帘半卷，凭阑对、山色黄昏。\n人千里，小楼幽草，何处梦王孙。\n十年，羁旅兴，舟前水驿，马上烟村。\n记小亭香墨，题恨犹存。\n几夜江湖旧梦，空凄怨、多少销魂。\n归鸦被，角声惊起，微雨暗重门。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35154,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代意","author":"刘骘","text":"路隔仙源不可寻，紫墙霜戟夜沉沉。\n缄情谩托传书雁，换笑空馀取酒金。\n翡翠巢成珠树密，骊龙睡起玉渊深。\n新知自乐生离苦，年少情多岂易禁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35155,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旧将","author":"刘骘","text":"彊弩当年讨不庭，功成身退炳丹青。\n囊沙泽畔知兵法，聚米山前识阵形。\n骥老未甘秋伏枥，剑閒犹觉夜冲星。\n分茅锡土传家牒，钟鼎还须为勒铭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35156,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉武","author":"刘骘","text":"高挹方诸荐水仓，醮坛时见烛神光。\n日边甲帐虽虚设，汾上楼船不可忘。\n盘槩碧霄甘露白，鼎迁幽壤瑞云黄。\n东巡岱岳探金策，倒指宁闻寿数长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35157,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"送新知永州陈秘丞瞻赴任","author":"刘骘","text":"秋风清紧雁初飞，半醉摇鞭出帝畿。\n名郡又分红旆去，故乡重见锦衣归。\n剖符虽暂宣皇泽，视草终须直紫微。\n从此南轩多倚望，好诗芳信莫教稀。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35158,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"馆中新蝉","author":"刘骘","text":"摇落何须宋玉悲，齐亭遗恨莫沾衣。\n池中菡萏香全减，井上梧桐叶乍飞。\n风促筝声随断续，日移砖影自光辉。\n宜秋门外饶芳树，结驷那堪送客归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35159,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"槿花","author":"刘骘","text":"虢国妆初罢，高堂梦始回。\n霓裳犹未解，绣被已成堆。\n赤帝宫帘卷，华阳洞户开。\n神仙有良会，清唱在瑶台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35160,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵虞舜庙怀古","author":"刘骘","text":"诗人如不颂，谁识太平心。\n石老碑文古，庭荒蚁穴深。\n白云生绝壑，斑竹锁疏林。\n行客自南北，青山共古今。\n登临寻胜迹，望望日西沉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35161,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"题义门胡氏华林书院","author":"刘骘","text":"徐孺亭边水石连，高名频见野僧传。\n箧中书满思安世，楼上诗成忆仲宣。\n已说烂柯忘意远，定知焦尾用心专。\n寒溪乘兴云迎棹，秋夜娱宾月照筵。\n曲槛静宜开木笔，短墙幽称聚苔钱。\n廷评官小无馀俸，致仕身闲得尽眠。\n梅少也须饶越岳，竹多宁肯让湘川。\n樽前白玉杯常在，腰底黄金带未悬。\n清露暖空滋菊圃，紫云垂荫养芝田。\n仍闻旌表门闾后，朝士褒称过百篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35162,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"鹧鸪天 剪彩花送珍省试","author":"刘鼎臣妻","text":"金屋无人夜剪缯。\n宝钗翻作齿痕轻。\n临行执手殷勤送，衬取萧郎两鬓青。\n听嘱付，好看承。\n千金不抵此时情。\n明年宴罢琼林晚，酒面微红相映明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35163,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"红梅","author":"刘嗣庆","text":"瞥眼繁华处处空，寒林独透一枝红。\n入时姿态人争羡，清韵须知冰雪同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35164,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"宜春台","author":"刘嗣隆","text":"一簇亭台画亦难，公馀到此暂盘桓。\n山多不似城中景，树密偏宜雨后看。\n风送江声穿郡郭，日推云影下峰峦。\n当时吏部曾游否，何事无文石上刊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35165,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘待诏老子出关图卷","author":"刘意","text":"不驰骏马驾青牛，西度函关紫气浮。\n文字五千传道德，仅同释教让儒流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35166,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"水调歌头","author":"刘源","text":"几载沧江梦，此夕复经过。\n双台双峙如画，空翠滴晴波。\n不是先生高节，激起清风千古，汉鼎复如何。\n矫首望天际，烟树翠婆娑。\n危楼下，数不尽，去帆多。\n人人惊肉生髀，却日欲挥戈。\n谁识矶边泉石，别有壶中天地，烟雨一青蓑。\n自笑亦华发，三叹吊岩阿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35167,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又赠一绝","author":"刘筠","text":"粉白朱红翡翠翘，汉宫等级不相饶。\n风波若未乖前约，一死何辞更抱桥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35168,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊申年七夕五绝 其一","author":"刘筠","text":"伯劳东翥燕西飞，又报黄姑织女期。\n天帝聘钱还得否，晋人求富是虚辞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35169,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊申年七夕五绝 其二","author":"刘筠","text":"华寝星陈夜未央，明河奕奕度神光。\n一年暂得停机杼，不柰秋虫促织忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35170,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊申年七夕五绝 其五","author":"刘筠","text":"琥车芝驾俨清秋，微雨侵宵助涕流。\n人世莫嗟离恨苦，却应天上更悠悠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35171,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊申年七夕五绝 其四","author":"刘筠","text":"淅淅风微素月新，鹊桥横绝饮牛津。\n岂惟蜀客知踪迹，更问庭中晒腹人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35172,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"戊申年七夕五绝 其三","author":"刘筠","text":"吹笙何处伴乘鸾，窥牖谁人见阿环。\n便有唐家今夕意，月和风露满骊山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35173,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"七夕","author":"刘筠","text":"灵匹迢迢驾七襄，暂陈云幄对星潢。\n已看素魄过三让，何用华灯更九光。\n玉腕双丝轻宛转，霞衣杂佩暗丁当。\n谁言巧意能胜拙，祇见鸠闲鹊自忙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35174,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日赴宴不及简馆中同僚","author":"刘筠","text":"野趣风流属此辰，帝台高会敞重茵。\n绛囊为佩仙萸密，绿酝飞觞寿菊新。\n兼豆丰盈尧箑馔，雅歌清壮汉营人。\n年来多病欢游阻，温玉苍葭岂易亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35175,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上元日","author":"刘筠","text":"汉典久传祠太乙，竺坟亦说会夫人。\n蟾蜍吐耀祥轮满，菡萏凝华宝檠新。\n风转相竽来帝乐，香焚夹道杂车尘。\n承平多庆群欢洽，益见严宸奉紫旻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35176,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与客启明","author":"刘筠","text":"秦痔从来易得车，郤枝今比我何如。\n垂天借喻齐谐志，握火寻盟越绝书。\n旭日西清云幄密，朔风南陌苇衣疏。\n故山夜鹤空多怨，金屋人争诵子虚。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35177,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"夕阳","author":"刘筠","text":"夕阳堪极目，况复近秋残。\n塞迥横烟紫，江清照叶丹。\n伍胥嗟路远，潘子念行难。\n更有芜城恨，城空逼夜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35178,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"小园秋夕","author":"刘筠","text":"枳落莎渠急夜虫，翛然平子四愁中。\n栗林忽感雕陵鹊，云表初过代岭鸿。\n阮籍卧惟疏鉴月，马融横笛远含风。\n郎潜吏隐前贤事，犹胜杨岐泣断蓬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35179,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋馆宿","author":"刘筠","text":"馀欢惊社过，独直奈宵长。\n月向蓬山满，风来桂殿凉。\n睡轻同警鹤，吟苦伴啼螀。\n耿耿迷遥思，残星下建章。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35180,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"公子","author":"刘筠","text":"油壁春车隔渭桥，黄山路远苦相邀。\n行庖爨蜡雕胡熟，永埒铺金汗血骄。\n别馆横陈张静婉，期门长揖霍嫖姚。\n注钩握槊曾无惮，绿桂膏浓晓未销。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35181,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"劝石集贤饮","author":"刘筠","text":"豪家抱瓮擅风流，更燎薰炉白雪楼。\n鲁笔休分科斗字，蜀都且换鹔鹴裘。\n仰天拊髀真为乐，倒载穿肠肯易愁。\n欲鲙长鲸置雕俎，愿回北斗挹东流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35182,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"天禧戊午岁立夏奉祀太一宫斋宿有感","author":"刘筠","text":"七年纶掖滥敷言，八奉斋祠荫宝轩。\n上士半同猿鹤老，病身犹与蟪蛄存。\n饭蔬力弱防冠坠，枕杫神宁喜席温。\n樱序清和芳意歇，淡然毕竟绝朝喧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35183,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题二首 其二","author":"刘筠","text":"昱爚银鞍狭路逢，长裙连带任流风。\n身轻近识吴宫燕，目断还惊洛浦鸿。\n未许香囊安肘后，独怜丹枕在房中。\n南园蝴蝶飞无限，一一雌随一一雄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35184,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题二首 其一","author":"刘筠","text":"曾许千金答浣纱，越溪浪浅不通槎。\n晓楼帘卷还凝雾，外院墙低却映花。\n满目离愁频驻马，一春幽梦祇惊鸦。\n柔桑蔽日南城路，懊恼罗敷自有家。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35185,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题三首 其二","author":"刘筠","text":"帘声竹影浪多疑，仙谷何能为解迷。\n藻井风高蛛坏网，杏梁春晚燕争泥。\n更看山远惟凝黛，纵许犀灵祇骇鸡。\n枉裂霜缯几千尺，红兰终夕露珠啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35186,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"无题三首 其一","author":"刘筠","text":"走马章台冒雨归，后门犹叹滞前期。\n荷心出水终无定，萝蔓从风莫自持。\n复帐麝轻难辟恶，曲房蚕懒不成丝。\n渐渐垄麦藏鸣雉，更恨如皋一箭迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代意","author":"刘筠","text":"华池阿阁不相容，浊水清尘恨莫穷。\n明月自新班女扇，行云无柰楚王风。\n乳莺啼晓销兰炷，媚蝶伤春失蕙丛。\n纵使多才如子建，祇能援笔赋惊鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"召入翰林别同僚","author":"刘筠","text":"一辞銮署守英蕃，两见庐峰媚翠樽。\n政懦每怜民若子，岁丰还喜稻成孙。\n离愁且饮闲人酒，密对须求长者言。\n入奉清朝同一德，晨趋岂叹鬓霜繁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"旧将","author":"刘筠","text":"丈八蛇矛战血乾，子孙今已列材官。\n青烟碧瓦开新第，白草黄云废旧坛。\n劳薄可甘先蔺舌，爵高还许戴刘冠。\n秋来从猎长杨榭，矍铄犹能一据鞍。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"汉武","author":"刘筠","text":"汉武高台切绛河，半涵非雾郁嵯峨。\n桑田欲看他年变，瓠子先成此日歌。\n夏鼎几迁空象物，秦桥未就已沉波。\n相如作赋徒能讽，却助飘飘逸气多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立夏奉祀太一宫","author":"刘筠","text":"舜柏森森拂绛霄，薰风瑟瑟动云璈。\n琳房遍设沉榆席，金檠齐燃绿桂膏。\n秘册十行开凤检，灵辉三烛驻霓旄。\n香飘员峤空歌歇，北斗阑干月殿高。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"休沐端居有怀希圣少卿学士","author":"刘筠","text":"䡾䡾风檐乳燕翔，浴兰衣绤簟流黄。\n云容倏变千峰险，草色相沿百带长。\n旋制紫荷供橐笔，暗移神蔡忍支床。\n思君祇欲倾家酿，待警同谁赋柏梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"再赋七言","author":"刘筠","text":"纫兰为佩桂为舟，北渚云飞发棹讴。\n已有万丝能结怨，不须千盖强障羞。\n金堤勃窣谁同上，翠帟缤纷客自留。\n欲选浣纱倾敌国，越王更起近江楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"刘校理属疾","author":"刘筠","text":"抚枕凄然掩北轩，汉庭谁问马文园。\n风檐鸱啸厨烟绝，月树乌惊药杵喧。\n戏习五禽成妙术，学亏一篑阻微言。\n不因九奏清尘耳，天露应迷简子魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":35195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]