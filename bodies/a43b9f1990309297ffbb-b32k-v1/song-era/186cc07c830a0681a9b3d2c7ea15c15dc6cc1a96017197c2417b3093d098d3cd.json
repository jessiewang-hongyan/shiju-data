[{"title":"十月朔过殿","author":"孔武仲","text":"平晓清风响北林，大明宫殿肃阴阴。\n雕舆来息云天上，黼座遥瞻斗极深。\n庭广袍衣自相照，朝回幡盖尚馀音。\n太平文物多师古，想望汉唐犹视今。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4893,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"万松亭","author":"孔武仲","text":"郁郁青山夹路松，行人笑语绿阴中。\n排云架壑无馀地，洒面侵襟有好风。\n一日劳心非欲速，千年流惠亦何穷。\n我来俯仰寻遗爱，更喜清虚万虑空。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4894,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上巳与江梅叔游城西","author":"孔武仲","text":"禁园灵沼酿风光，恩许游人入醉乡。\n天上仙葩迷阆苑，月中清气泻银潢。\n觞浮曲水青春暮，人在瀛洲白日长。\n却望宜秋指归路，觚棱金碧正斜阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4895,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"上禫除恭谢迎驾有作","author":"孔武仲","text":"仗卫风生下玉宸，倾都瞻望属车尘。\n乾龙已应飞翔始，震鬯方观荐奠新。\n星象低回随曲盖，天阊苍莽入钩陈。\n麟台亦与班迎末，不美甘泉作赋人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4896,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"兴龙节上寿","author":"孔武仲","text":"瑞雪峨峨宫殿明，千秋佳节会公卿。\n香飘彩雾萦天仗，酒浥流霞满寿觥。\n密勿华封多好语，锵洋钧奏尽和声。\n自怜初预称觞乐，江海飘萍已半生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4897,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与同寮游甘泉苦竹二寺","author":"孔武仲","text":"两寺藏山曲，登临恨阻修。\n平时极目处，今日探春游。\n苦竹经霜老，甘泉带雪流。\n醇醪煖肌骨，归路卸轻裘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4898,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"与陈董二君相会于真州经月甚乐诗寄陈董二君兼感存没","author":"孔武仲","text":"平生交友半成尘，想见当年乐会文。\n别泪茫茫添海水，愁怀黯黯塞江云。\n青衫脱去谁同老，白首追随尚有君。\n官暇更将棋子学，他时筹局当功勋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"之官宣城赠毅父次其韵","author":"孔武仲","text":"几夕林声酝造秋，移船回指凤凰楼。\n身疲禁内凝严地，恩与江南爽垲州。\n历数近城多异境，问知前政尽名流。\n嘉观胜赏应难尽，更为吟哦万古愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大风","author":"孔武仲","text":"万窍轩轩渐怒号，坐来浑怕屋山摇。\n洞庭曾听咸池乐，吴会饱闻沧海潮。\n此地风声真有似，残春人意正无聊。\n云师又洒天街雨，明日千宫好上朝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"大雪","author":"孔武仲","text":"穷年阙雨谩悲歌，喜见凌晨雪意多。\n天上乱花初剪玉，楼头密影已翻波。\n轮蹄著路纤尘断，庭宇无风凛气和。\n寄语云师勤覆护，莫令光景漏银河。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"书省即事","author":"孔武仲","text":"恩旨雠书到午休，笑谈连手得优游。\n窗声渐渐回脩竹，庭实鲜鲜亸石榴。\n风色洗清天畔阙，鼓声遥转日边楼。\n群仙暂驾飞鸾去，从此蓬山更少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五鼓","author":"孔武仲","text":"永夜无尘事，閒眠似道堂。\n纸窗分晓色，絮被借春阳。\n万虑此中息，一身今可忘。\n周公不足梦，佳趣在羲皇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"五鼓乘风过洞庭湖日高已至庙下作诗三篇 其三","author":"孔武仲","text":"南津瀺灂夜风微，投晓湖灵更发机。\n想像虚空闻帝乐，逡巡波浪匝天围。\n三湘路指平芜转，两舸帆争白鸟飞。\n却上丛祠荐牲酒，荆云隐隐尚朝晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元日值雪","author":"孔武仲","text":"东皇点缀一何工，飞下琪花顷刻中。\n变尽楼台成夜月，不容车马竞春风。\n崎岖广市黄泥污，冷淡群山彩日红。\n野叟相逢应更喜，从来盈尺瑞年丰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"六月望参","author":"孔武仲","text":"宿露初晞物向阳，袍鞋如水转回廊。\n天开北极星辰正，风应南薰殿阁凉。\n蓂荚已瞻圆魄就，槐花初覆广庭香。\n朝廷礼数优元老，独后千官拜未央。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太一宫","author":"孔武仲","text":"江城南畔碧连峰，畴昔贞人寄此中。\n琳宇邃深灵迹在，仙坛牢落杏花空。\n池塘自老琴高鲤，岩谷仍回禦寇风。\n共羡碧虚官职好，谁知阴有济民功。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"太霞宫","author":"孔武仲","text":"谁氏夸豪力，琳宫一手开。\n光辉动金碧，潇洒绝尘埃。\n煮石洞中火，流霞天上杯。\n篮舆穿翠樾，只为听琴来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孔周翰挽词三首 其三","author":"孔武仲","text":"晚岁班朝列，光华动士林。\n家风当冠豸，官序正腰金。\n霄汉亨衢浅，膏肓积沴深。\n凄凉哭门馆，笑语尚馀音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孔周翰挽词三首 其二","author":"孔武仲","text":"循吏今之选，皇华使者轺。\n关河初异路，巾笏偶同朝。\n急景催迟莫，清魂返泬寥。\n一哀惭不达，生理故风飙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"孔周翰挽词三首 其一","author":"孔武仲","text":"邂逅湓江口，方知叔父亲。\n荣华才一梦，奄忽几千春。\n白玉沽何晚，精金锻愈真。\n耆年所宜得，天苦夺斯人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"巴陵官舍二题 其二 湖山亭","author":"孔武仲","text":"县山峻绝有新亭，公退时来看洞庭。\n天外微茫二湖合，波心缥缈一峰青。\n非时爽气生云雨，永夜寒光浸斗星。\n千古登临增健笔，投文犹可吊湘灵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"巴陵官舍二题 其一 潇洒堂","author":"孔武仲","text":"旅平凹处剪荆榛，画栋明窗学隐身。\n政简琴书聊度日，地閒花木为留春。\n一杯浊酒迷今古，五字清吟泣鬼神。\n暂伴登临对佳景，衣襟浑觉减埃尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"文德朝参退举觞觥于幕下归馆中颓然醉卧官曹多暇未有如此因作四韵以识","author":"孔武仲","text":"朝罢千官卷舄行，袍衣犹带御前香。\n偶倾天上流霞美，便忘壶中白日长。\n丛竹娟娟帘绕碧，回风淅淅殿分凉。\n翛然不与人间事，未信无何别有乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"风铎","author":"孔武仲","text":"潇洒当檐铎，凄清不断风。\n高堂人语后，广殿月明中。\n暂歇还归静，重来复满空。\n群仙鸣玉佩，初下广寒宫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至夜饮","author":"孔武仲","text":"翠帟排银烛，金炉飘篆香。\n人情感佳节，天气踏新阳。\n醉怯醇醪酒，寒知碧瓦霜。\n明朝指天阙，万寿献君王。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发王务二首 其二","author":"孔武仲","text":"春水沟塍绿渐回，喧阗凫雁作群来。\n新年风物动人意，薄宦驱驰岂自媒。\n未解骖龙追渺莽，何妨乘蹇历崔嵬。\n田间亦有人閒逸，门掩柴荆昼未开。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发王务二首 其一","author":"孔武仲","text":"晓随灯火背千家，落尽疏星见远霞。\n一饷春声回宿鸟，半天寒色在啼鸦。\n临陂弱柳犹藏叶，当路残梅已尽花。\n赖值时光正妍润，稳看风物到京华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发彭泽","author":"孔武仲","text":"御风南去觉泠然，今日无惭禦寇仙。\n庐岳奇峰将出地，丰城宝气已连天。\n诗书未敢当谋帅，忠信由来可涉川。\n止仗江神扶羽翮，解帆江浦夕阳边。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"发蔡州","author":"孔武仲","text":"悠悠清晓历长陂，杨柳沟塍雁鹜池。\n风色著人寒料峭，日光生野暖融怡。\n鹤归云海心空在，雁度湖天力己疲。\n客路驰驱元不定，西游应有再来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司马温公挽诗五首 其五","author":"孔武仲","text":"拙与世沈浮，登门二十秋。\n云天曾送上，风壑此来游。\n霄汉三台坐，江湖万里舟。\n抠衣已不及，惨怆逝川流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司马温公挽诗五首 其四","author":"孔武仲","text":"高步朝廷上，羽仪鹓鹭行。\n精诚贯金石，素节履冰霜。\n爽气今仍在，斯人没不亡。\n嵩云自閒暇，长映读书堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司马温公挽诗五首 其三","author":"孔武仲","text":"赐告恩稠叠，闻丧上震惊。\n秋原无喜色，夜雨有悲声。\n世路嗟存没，公心达死生。\n蓬山预雠校，新见史书成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司马温公挽诗五首 其二","author":"孔武仲","text":"鼎鼐华元老，朝廷倚上台。\n除疴得针砭，作解有风雷。\n尚冀松椿寿，谁令柱石摧。\n英灵参列宿，馀惠在春台。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"司马温公挽诗五首 其一","author":"孔武仲","text":"龙卧南阳久，天回北斗高。\n庙堂更政化，岩谷起英髦。\n正色朝端肃，华巅国务劳。\n西州忽移翣，风木动悲号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"四月二十二日拜第二表请御正殿","author":"孔武仲","text":"骤雨鸣宫瓦，新槐密禁城。\n鸳行趋晓肃，鸡唱入云清。\n日晃千袍影，风传万岁声。\n天心求允协，飞奏入承明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"石榴","author":"孔武仲","text":"造物巧雕锼，慇勤在石榴。\n中妍宁暴露，外稳不轻浮。\n露液甘凝蜜，琼房密贮秋。\n非徒适人口，饤坐亦风流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春晚会呈经父","author":"孔武仲","text":"侍史新从天上归，相逢忻喜著春衣。\n萱芽刺土占芳节，兰醑倾觞乱夕晖。\n兄弟几人华萼聚，岁时经眼羽翰飞。\n东风处处吹嘘到，从此乡园笋蕨肥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"休日出城西","author":"孔武仲","text":"秋怀不可奈，驱马漕河边。\n川跃时闻鲤，林嘶已断蝉。\n劳心逐外物，回首是残年。\n强作遨游计，登临却黯然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"同赋李梦符酒斗","author":"孔武仲","text":"酒斗公家物，规摹取自然。\n无时挹香酎，有象挂高天。\n绿玉烧为撇，黄金打作船。\n何如学嘉量，深注瓦樽前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"吕推卿出孔雀画图","author":"孔武仲","text":"昼卧蓬山禁漏长，起观名画得心降。\n曾闻饮啄依南海，颇怪飞鸣到北窗。\n峭格正宜风作驭，脩翎堪与凤为双。\n知公物外寻幽好，不恋荣华拥节幢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早春","author":"孔武仲","text":"欲探年光好，春风入酒帘。\n寒威随雪解，芳意逐情添。\n塞雁今回阵，冰鱼稍出潜。\n王孙幽兴动，颜巷自安恬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早春","author":"孔武仲","text":"密雨霏霏欲结霖，洒开青帝发生心。\n风吹嫩草迸微绿，雷碾长空破积阴。\n啼鸟随阳声自得，卧龙思海意尤深。\n更看三月桃花浪，旧鬣凌云在尺寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"早食铁佛寺","author":"孔武仲","text":"破壁题名满，往还如置邮。\n山河万里道，车马片时休。\n白日初腾晓，凉蝉已唤秋。\n便添山野兴，咫尺帝王州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"有旨放八月朔参","author":"孔武仲","text":"八月大明宫，朝班放会同。\n天时郁残暑，圣语似清风。\n蕙帐便秋睡，沙堤缓晓骢。\n葵心终不已，长望日升东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵马中玉春日偶成","author":"孔武仲","text":"京都久客忆归频，准拟江南看早春。\n多病馀生万事已，起惊芳意一番新。\n东湖水满鱼应乐，南浦波明柳自匀。\n玉脸芙蕖容易得，要须叮嘱养花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵介之","author":"孔武仲","text":"亭上掀帘试解襟，远山崷崒势前临。\n前滩溅沫锵鸣玉，落照蒸霞映翠金。\n运笔欲回天地力，高谈直造圣贤心。\n于中览景宜谁预，愿结夫君此笑吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵天觉行县","author":"孔武仲","text":"馀凉凛凛认乘骢，分走郊圻督事功。\n照路官仪惊众目，快襟诗思有清风。\n隋河杨柳萦天上，魏阙觚棱在梦中。\n朝会相逢劳行色，滑稽酬对兴无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵邓慎思见寄","author":"孔武仲","text":"暂寄潇湘百尺船，谁论灶冷突无烟。\n城阴潦积朝慵出，枕底波鸣夜废眠。\n潭府更看花似锦，洞庭将泛水如天。\n相期尽校蓬山藏，不秖东流酹酒仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵邓慎思初入同文馆","author":"孔武仲","text":"十载江湖万里行，偶来西馆阅豪英。\n云龙九阙晨书诏，灯火千门夜出城。\n潇洒庭除当月色，重稠幕帟断人声。\n年家兄弟今同舍，会见河南起贾生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵余樗年同文馆书事","author":"孔武仲","text":"衡门咫尺限关河，此地平时匹马过。\n欲把尘埃比山岳，宁辞羽翮寄罝罗。\n华堂翠幕供閒燕，明月清风伴啸歌。\n拟写秋容须笔力，新诗句句似阴何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋履中兄弟九日诗","author":"孔武仲","text":"遥知把酒对重阳，檐外秋声叶半黄。\n落帽想当追故事，披襟仍喜得新凉。\n自怜僻处真匏系，只羡清吟属雁行。\n闻说家楹增壮丽，落成应许到华堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵宋履中岁晏言怀","author":"孔武仲","text":"寂寞郊居远，晨晡四马驰。\n日惊东逝水，心感岁寒枝。\n霜色朝如洗，云容莫不怡。\n梁园将密雪，不饮亦奚为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李至之席上作","author":"孔武仲","text":"岁月翩翩插羽过，十年依旧叹蹉跎。\n雁回燕塞乡书少，雪满梁园雅集多。\n取乐醉乡聊邂逅，争新谈薮任纷罗。\n慇勤尚托抠衣旧，遥许巴吟续郢歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李端叔","author":"孔武仲","text":"此身萍梗厌漂流，惭寄浔阳江上头。\n胜景长年关梦寐，轻裘何日返林丘。\n扶摇莫作扶摇计，朴樕应容朴樕投。\n徙倚高楼情不极，恰如王粲在荆州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵李端叔见赠","author":"孔武仲","text":"君才潇洒应时流，久滞宁非命压头。\n昨见河南推贾谊，行闻天子召吾丘。\n已无痛饮观风味，犹有新诗讲报投。\n京洛尘沙著人甚，清凉高爽忆宣州。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和邓愤思与太守同登清湘楼","author":"孔武仲","text":"郡楼邀会乐丰年，极目山川思浩然。\n才子登临嗟昔别，使君藩屏值新迁。\n前峰绿雾藏丹叶，别浦平沙衬碧涟。\n不但醉吟湘与麓，鲁歌崧汉美周宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和邓慎思谢刘明复画道林秋景二首 其二","author":"孔武仲","text":"以诗博画虽不费，要秋得冬如未完。\n恍疑霰雪满天地，惨若暮气迷峰峦。\n夜堂高张醉魂醒，暑馆偶窥吟魄寒。\n笔端直与造化会，莫作人间毫素看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和邓慎思谢刘明复画道林秋景二首 其一","author":"孔武仲","text":"铃斋清话未更端，一埽禅林景趣完。\n缥缈已装新殿塔，萦纡仍引外峰峦。\n冷风有意生空阔，密雪无声下广寒。\n平昔所游今在眼，凄凉疑是梦中看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和张芸老阻风见寄","author":"孔武仲","text":"闻道征帆却滞留，萧条湘岸正南头。\n春光虽有将归意，野色仍供不尽愁。\n破浪心期元万里，扬帆目送已千舟。\n山斋亦欲君重访，逆水如今是顺流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和杨公济见赠三首 其三","author":"孔武仲","text":"清谈衮衮思无穷，浑似饶阳邑下逢。\n霜重湖天初凛冽，夜长樽酒更从容。\n新编自富诗千首，岩邑今饶亩一钟。\n兀坐江城随五斗，肯忧紫□□衣慵。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和杨公济见赠三首 其二","author":"孔武仲","text":"鲁国鮿生与俗同，何尝孤讦慕龙逢。\n邑佳不及陶彭泽，官小差肩邴曼容。\n故国安栖无一瓦，高堂失养感千钟。\n贤豪见顾何恢廓，自写新诗慰病慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和杨公济见赠三首 其一","author":"孔武仲","text":"虢略先生不讳穷，咏歌尧舜与时逢。\n传呼满道今为使，敛板登门亦见容。\n南浦清波辉玉树，西斋新酿入金钟。\n临分警戒言尤切，似欲驱驰叔夜慵。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和欧勉甫见送","author":"孔武仲","text":"抱关委吏可忘年，而况吾徒志圣贤。\n策马渐随南去雁，寄声应有北归船。\n无情尺水犹能鉴，有志精金尚可镌。\n愿以此心推一邑，他时不负赠行篇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和知郡朝奉登禅月台书事二首 其二","author":"孔武仲","text":"素月寒光好，高斋夜已扃。\n影难穿密纸，光稍泛疏棂。\n皎洁临书案，朦胧到研屏。\n沈吟忆丹桂，更欲步中庭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵和知郡朝奉登禅月台书事二首 其一","author":"孔武仲","text":"物有贱而贵，劝公收桦皮。\n自能全烈火，何用爇香脂。\n山径狂风夜，茅檐密雪时。\n金莲猝难买，唯此颇相宜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":4957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]