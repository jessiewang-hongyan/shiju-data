[{"title":"九华山","author":"释居简","text":"九华宜带雪，故故仲冬来。\n翠扫忺梳洗，玄冥未剪裁。\n骤观疑旧识，近看若新开。\n曾说壶中玩，多应小有才。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28372,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老融牛 其一","author":"释居简","text":"一战长驱七十城，可无馀勇替春耕。\n归来不作凌烟梦，只写清溪瘦影明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28373,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老融牛 其二","author":"释居简","text":"力穑工夫画里看，闵劳念旧只长叹。\n断魂千载荆州市，尸素甘心饱阿瞒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28374,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪航","author":"释居简","text":"九逵埃壒点人衣，踏土何如踏浪儿。\n烂熳溪头千树玉，风蓑月笛兴阑时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28375,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"放闸","author":"释居简","text":"截住泠泠碧透沙，放开衮衮怒飞花。\n石疑初裂蓬婆麓，鲸拟洪奔海若家。\n殷地贾馀翻霹雳，喷岩用壮激谽谺。\n凭阑小伫观流止，不独观澜一笑哗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28376,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"下竺朱桐花一根出石上见之四十馀年","author":"释居简","text":"绿柄高扶绛玉开，层层萼萼染猩裁。\n峄阳曾止青鸾翼，无此奇葩更不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28377,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"严山人饷蒲萄浆","author":"释居简","text":"翠朵搴藤剪绿垂，小槽新压水晶澌。\n凉州亦有扬州鹤，惆怅山人只要诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28378,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送心上人归琴川","author":"释居简","text":"五道川流似五弦，绿窗朱户照明鲜。\n飞来峰下僧归去，髣髴华亭落照船。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28379,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"烟竹","author":"释居简","text":"林疏略见两三分，不是岚光不是云。\n亟展生绡轻著墨，幻成初日度晴熏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28380,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋夜","author":"释居简","text":"嫩凉细意入帘栊，禁树秋声未击蒙。\n展尽绿蕉心寸寸，几时消息到梧桐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28381,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天竺两峰堂待月","author":"释居简","text":"朣朣如水洗新秋，到两峰前凝不流。\n曾似丈人祠下看，丹梯飞步玉华楼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28382,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"代人上魏左史","author":"释居简","text":"榜下尽横飞，龙头尚立螭。\n穹崇方善下，谨厚孰逾卑。\n制作虽师古，经纶盍制宜。\n迥超千丈俗，密契九重知。\n北海客常满，西湖雨亦奇。\n文传仁者寿，用适圣之时。\n数道甘棠咏，丛霄湛露诗。\n未移骐骥步，已在凤凰池。\n紫橐荷芬馥，巍冠佩陆离。\n橐中云锦段，拈出解人颐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28383,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"水月庵","author":"释居简","text":"心蟾光朣朣，性静湍不起。\n悠哉小天地，万化渺无蒂。\n清苕半洚水月庵，碧蟾夜夜先清涵。\n曩曾借榻坐凉树，细数秋毫窥夜潭。\n犹来清圆捉不得，何地容兹老豪逸。\n脩名与月俱不死，衮衮东流几时息。\n乡来万州赋此诗，寥寥百岁无此奇。\n诗在天西锦官寺，珠璧照人觉形秽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28384,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刘寺庭犀盛开","author":"释居简","text":"凤井庭犀玉载腴，楼前楼后著花初。\n不须素幌萦檀篆，只放鲜风入绮疏。\n恨弗同寻姑射住，却疑僦得广寒居。\n露零夜老秋衣薄，独自裴回绕屋除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28385,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"直院卢蒲江为余作寿木怪石","author":"释居简","text":"草枯蓝田山，饮羽误入神。\n归来落清梦，起写赝虎真。\n槎牙虎边树，霜虬蜕脩鳞。\n乡来一寸根，今者千岁苓。\n冻雪压不低，华风吹不春。\n落子大蔽牛，娄起厦屋倾。\n日月弗知老，保此坚与贞。\n年年姚家黄，角逐魏紫荣。\n十里春风香，走杀陌上人。\n夭妍极远到，不得一月程。\n居然事颜色，只与朝菌盟。\n安知有耆艾，落落仍亭亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28386,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"江西定上人梅","author":"释居简","text":"眼明不识春风影，收拾风烟入梦思。\n一笑自知天下白，墨名乌足累冰姿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28387,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老融放耕图皇甫都护雁图二绝 其一","author":"释居简","text":"蓑笠从衡觳觫蕃，暝归晨作俟丰年。\n诛求莫挠鸡豚社，春雨春寒苦最先。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28388,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"老融放耕图皇甫都护雁图二绝 其二","author":"释居简","text":"邕邕何处一声秋，杜若汀连宿莽洲。\n米熟菰蒲随分饱，危机多是稻粱谋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28389,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"木犀著雨","author":"释居简","text":"空山雨淫秋，妒我庭中犀。\n犀敷粟玉英，浸渍仍葳蕤。\n有如春方中，名品嗟淋漓。\n因依海棠泪，著此霜蟾枝。\n闻此辄掩耳，代犀前致辞。\n燕脂怨无香，姿色独媚时。\n烘晴睡未足，已惊胡马嘶。\n彫零怕随雨，嫣然成怆悽。\n鲜明擅韶华，不足较等夷。\n自怜宫样黄，不结春风知。\n木兰固可友，宿莽亦可师。\n正色俗子憎，浓馥天风吹。\n苔痕净如染，绿展承霏霏。\n故家换骨法，降真合传衣。\n大山与小山，骚雅同衿期。\n至今百世下，犹有芗林诗。\n何心与物竞，有泪无从挥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28390,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秦时石酒缸","author":"释居简","text":"臃肿窥秦制，曾闻酿酒来。\n腹如包括胀，口作并吞开。\n北筑饥难疗，东巡醉不回。\n痕云疑潋滟，馀沥晕苍苔。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28391,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"九日还山中","author":"释居简","text":"去年佳约负东篱，凤井丹犀彷佛知。\n便使山灵先勒驾，明朝更拟北山移。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28392,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"虞美人草","author":"释居简","text":"君恩如海海不深，妾义如铁利断金。\n舍生取义我所欲，忍死织室羞同心。\n春姿忽作秋蓬委，一寸刚明曾不死。\n明年原上野花繁，一枝自托华风起。\n袅袅娉娉不成艳，态度浅深生色染。\n向人欲诉却无言，寂寞千年恨谁掩。\n芳郊游女宛转歌，倚春拍手看婆娑。\n露晞初日枝头坠，犹有君王别时泪。\n翻刘覆楚知几何，大风竟作还乡歌。\n淮南区区欲为帝，淮阴堂堂贺陈狶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28393,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"苍苔","author":"释居简","text":"湿带秋痕绿可庭，花阴竹色借鲜明。\n簪抽翠笋愁穿破，茵拓青丝喜剪成。\n户外倚筇遮俗屦，楼头横玉衬寒英。\n平阳不惜黄金埒，稠叠蒙茸四畔生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28394,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渔父","author":"释居简","text":"谋生与俗违，一叶浪中蜚。\n水易分团月，云难隐少微。\n雁沙眠晚照，鸥渚棹晴霏。\n见说蓬莱浅，寻津问钓矶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28395,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"装冬后不速之客来","author":"释居简","text":"绽裘纫絮办冬和，羽化其如独冷何。\n藕荡欲搴霜后叶，晓来零落更无多。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28396,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"王总卿季和归自关西","author":"释居简","text":"关西长虑独兢兢，万灶分屯感慨深。\n不易制如巫硖水，最难得是蜀人心。\n拨灰忍见俱焚玉，铭鼎徐看小篆金。\n欲倚筹边开玉帐，共观城外柏森森。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28397,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"耕谷","author":"释居简","text":"屦痕不印步虚坛，欲事锄犁恐亦难。\n云子熟时还自饱，不知沆瀣与谁餐。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28398,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"识全","author":"释居简","text":"占得沙边柳外春，更专吟啸管阴晴。\n延祥观后茅茨老，月旦工夫子细评。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28399,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石亭","author":"释居简","text":"苍壁痕云煖不消，午阴花影共林皋。\n丹藏亭树无人守，付与县枝雪色猱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28400,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋塘报陈提刑讣","author":"释居简","text":"宏博曾闻鼎足无，脚才实处即荣途。\n恰观次第行初志，冀懋神明振后图。\n齿失半唇忘屏翰，棣联双萼更纷敷。\n乡来少戆烦公笑，却忆公言诮故吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28401,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送傅兄归江西简诸宋诸黄","author":"释居简","text":"冲和正脉到江西，中有千岩万壑奇。\n百鍊易成终切玉，一炊难办必精糜。\n艾萧杂处芝兰馥，风土殊方枳橘移。\n铁石故家清婉赋，盍临疏影寄予思。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28402,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题高髯墨菊枕屏","author":"释居简","text":"欲种团枝香，无地著蔓延。\n密化移春霏，零露生秋妍。\n非金亦非玉，采采仍田田。\n餐英不成梦，唤起西窗眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28403,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题高髯诗藁","author":"释居简","text":"翻水千篇未足哦，不酬一语亦同科。\n若非身世相忘久，应是江山得助多。\n旬月有人加锻鍊，壶觞无地不婆娑。\n西湖南荡相寻处，门断红尘接翠萝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28404,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"接虞税院贯卿遗书","author":"释居简","text":"尽心如善射，百步中弥亲。\n不竞与闲契，尊生为死邻。\n关讥千古恨，日计两眉颦。\n一卷花严易，心知更几人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28405,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"甘园寻梅 其一","author":"释居简","text":"疏枝重复裹莓苔，护得寒英煖未开。\n料理不关元化事，翠华长是雪前来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28406,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"甘园寻梅 其二","author":"释居简","text":"楮幌春生斗底房，不知冰结夜来霜。\n无因领略黄昏月，只遣疏钟管暗香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28407,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"松御座","author":"释居简","text":"偃盖交柯坐亦宜，春风翠辇憩逶迤。\n大夫寂寞山阴道，不见西湖鼎盛时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28408,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"云","author":"释居简","text":"自是无心物，依稀似有心。\n因风才冉冉，酿雨忽沉沉。\n一末绅朝岭，重檐帽晚岑。\n丁宁休蔽日，我欲耀阳林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28409,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"趣徐无竞作水仙","author":"释居简","text":"抱独贫如我，飘然更我怜。\n亲思文度瘦，妇笑伯鸾颠。\n混混污成俗，朣朣碧觑天。\n肯移罗袜步，荐菊些林仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28410,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雪湖池上新筑","author":"释居简","text":"疏绮闯冰池，苔封老石矶。\n鱼方深避钓，鸥亦早忘机。\n涤研融残雪，观书竞夕霏。\n春风长似旧，还趁雪中归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28411,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"曹泸南得思陵旧赐张魏公琴曰播云","author":"释居简","text":"岷峨豁尘昏，旧赐出播云。\n不知落人间，虾蟆几亏盈。\n晦显固靡常，数岂逃冥冥。\n想当风雨时，破壁应有声。\n怀璧戒匹夫，呵护烦百神。\n一朝得所托，倏若屈蠖伸。\n人以器图旧，器以人怀新。\n玉轸黄金徽，烂烂奎画明。\n魏公蔼名氏，千载如丹青。\n歌风调舜弦，感物怀尧仁。\n扶日昌中兴，四海同一云。\n载维艰难初，事与得失并。\n万灶嘉陵江，饮此一掬清。\n悠然一再弹，万里怀长城。\n云絮初无根，勇变嘲哳鸣。\n捕蝉写真意，弦外无人听。\n空嗟易水寒，遗恨崆峒平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28412,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杜侍郎之遂宁","author":"释居简","text":"宁为轻以清，抑为重而填。\n重轻惟时中，举辄丽吾正。\n诚斋振家学，本末尽诚敬。\n所施见伦次，所瞩洞遐隐。\n喧啾雄地籁，静胜了天定。\n一经早授受，吴霜未侵鬓。\n精明紫荷橐，所蕴固未尽。\n玉堂与天远，仙槎向人近。\n旌旄屋头州，维翰倚东屏。\n敛此一道惠，徒引兆庶领。\n泉山跨鳌碧，横江秀而整。\n吾亲在其下，枌榆接封畛。\n家有老吟僧，河海借馀润。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28413,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜曹安抚还自泸南","author":"释居简","text":"蜀道因仍涨燧烟，烦公玉节照山川。\n省闱三见文衡正，边柝双兼武备全。\n传自老成需代去，不知威惠倩谁宣。\n回头半壁西南地，不是寻常刺史天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28414,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卢直院挽章","author":"释居简","text":"玉堂云气锁空濛，回首泠然跨阆风。\n纸贵又腾身后贾，骚亡旧策眼前功。\n蜗缘竺涧题名石，鹭忆吴江载酒篷。\n零落九华三四帖，朣朣犹在破囊中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28415,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宋左曹湖州宣谕","author":"释居简","text":"皇华万斛下苕溪，夹道甘棠映绿漪。\n为问只今回首处，曷如它日劝耕时。\n恩光才洽腥风静，烽火初消化日迟。\n士不明经无足用，乡来殷侑亦如斯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28416,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"永嘉壁书记携诸公诗卷索语","author":"释居简","text":"草思含芳梦亦疑，芬陁擢秀自枝枝。\n人间万事醉眯眼，江上数峰青到眉。\n多暇湖山分昼永，少晴风日共春迟。\n一春幽事从头了，先破苍苔吊紫芝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28417,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和寒泉春日儿童三咏 其一 竹马","author":"释居简","text":"争跨迎侯彩竹新，相呼回策巧如萦。\n一鞭看是谁先著，稚子群中觅祖生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28418,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和寒泉春日儿童三咏 其二 风筝","author":"释居简","text":"纵轮不卷只嫌低，高处安知鹢退飞。\n弱缕不禁儿辈掣，断鸢弗下断云归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28419,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和寒泉春日儿童三咏 其三 乌?角","author":"释居简","text":"煖响乌?二月初，调高不作小单于。\n年年陌上儿童戏，嚼徵含商尽不如。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28420,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"酬寒泉牡丹","author":"释居简","text":"见说姚家与魏家，紫琼黄玉剪纷葩。\n亭亭贵重推名辈，岁岁清明赏大花。\n日褪晓晴连影好，露添夜冷并枝斜。\n一从娄舞霓裳遍，憔悴春风怨物华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28421,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上巳日","author":"释居简","text":"龙飞乙酉三三日，节物催春睡不知。\n便作花残莺老态，略无天朗气清时。\n丽人行欠高吟续，禊帖碑从赝本欺。\n逸兴不随今古尽，振衣千仞赴心期。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28422,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"柳絮","author":"释居简","text":"满城漠漠看飞扬，百鍊刚非贺老肠。\n褪雨不忺知酝藉，倚风无力信行藏。\n可曾著意随流急，竟亦何心作许狂。\n酒似海留春不住，为春回雪荐离觞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28423,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杯中鱼子","author":"释居简","text":"眇如丝粟便悠然，洼玉深中浅注泉。\n再晕不知前夜月，才生便乐此中天。\n群分自笑如儿戏，聚育谁偏得母怜。\n罔罟不来斯可乐，洋洋何必泳长川。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28424,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"悼陆秘读","author":"释居简","text":"诸老骑箕上太微，仲谋不似景升儿。\n废寻蹊隧千年古，光奋胸襟一段奇。\n直敢昧寻嗟枉尺，方宁适义不成规。\n泠然差早终无愧，安俟名垂竹帛为。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28425,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三贤堂","author":"释居简","text":"弹压风烟盍鼎分，一新丹碧耀层层。\n异时三凤鸣还止，旧约群鸥唤得应。\n船绕砌云寻水步，葑侵檐影似田塍。\n关心夜老梅花瘦，别有孤山树上僧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28426,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题焕少章墨菊","author":"释居简","text":"采薇不疗餐英瘦，著眼无从到朵颐。\n秋露染毫馀晓馥，便成画饼亦忘饥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28427,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢疏寮高秘书同常博王省元见过 其一","author":"释居简","text":"友生朱与葛，月旦说疏寮。\n老锡思投越，春江梦趁潮。\n句新哦易熟，灯喜剪难消。\n闻道搴旗鼓，山林不寂寥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28428,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谢疏寮高秘书同常博王省元见过 其二","author":"释居简","text":"不纵青云步，行间著得么。\n官居最华要，吟似老头陁。\n行辈今差少，声名早厌多。\n犹将三万轴，清夜答弦歌。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28429,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"刀镊工","author":"释居简","text":"弹镊何曾款俗扃，清晨且了夜来经。\n匣非台镜人谁鉴，阅少年头雪易零。\n老葛句留身后贵，颠僧发烬死前灵。\n白崖薙罢还来薙，饶得长安两独醒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28430,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"卢玉堂枯木怪石","author":"释居简","text":"礧砢不坡陁，非才谢伐柯。\n相看如我瘦，想见阅人多。\n誉笑丹青俗，工如水墨何。\n经营盘礴际，天地困搜罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28431,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"十四夜竹间对月客有说丹霞张郡博已还豫章","author":"释居简","text":"华玉初痕陇树颠，朣朣俄顷散澄鲜。\n已无纤翳净如洗，犹有些儿修未全。\n竺友啸闻青嶂外，胡床移近绿筠边。\n怀人长恨千山隔，云淡天低鹤未眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28432,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"定平怀墨梅","author":"释居简","text":"南昌梅少府，人道是梅仙。\n不疗疏枝瘦，安知坏色妍。\n春归天上去，真自镜中传。\n同出吟机杼，无声亦自贤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28433,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次周和州韵 其一","author":"释居简","text":"绿水绕园庐，花无一日虚。\n柳桥闲研席，竹屿小篮舆。\n恶草防滋蔓，新篁戒剪梳。\n不堪奇字累，酬接费分疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28434,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次周和州韵 其二","author":"释居简","text":"抔土铭骐骏，诙如柳子骚。\n涤新藏缺研，悯旧惜残毫。\n射石惩年少，闻鸡仄枕高。\n云低鸿翼远，弋者不偿劳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28435,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"图翁瓜圃出故淮东使者方诗境所藏杨补之三友","author":"释居简","text":"画寿诗中境，人修地下文。\n金兰三友合，泾渭两边分。\n冻壑层攲盖，炎天独欠君。\n莫嫌疏影瘦，及与欠清芬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28436,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"落日汎舟拉赵寒泉刘成道","author":"释居简","text":"雨添湖满绿浮堤，高柳摇青接葑低。\n觅得晚凉船便住，背斜阳处听蝉嘶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":28437,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]