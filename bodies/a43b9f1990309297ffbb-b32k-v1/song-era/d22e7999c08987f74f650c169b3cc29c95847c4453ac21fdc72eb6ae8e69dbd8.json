[{"title":"三绝句寄几先 其二","author":"陈渊","text":"冷暖平生既自知，是中无病欲谁医。\n但思寒热从何得，未用长吟谴鬼诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13803,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三绝句寄几先 其三","author":"陈渊","text":"敌犯东南夜垒惊，却防西北有奇兵。\n将军坚卧鼻雷吼，七国峥嵘次第平。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13804,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道出南浦见萧子庄十首 其一","author":"陈渊","text":"雾压山城石径遥，笋舆乘月度溪桥。\n已投柳舍人方起，却访鳣堂市未嚣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13805,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道出南浦见萧子庄十首 其二","author":"陈渊","text":"墙仞未容肩可及，豹斑时许管能窥。\n相逢一笑无馀事，明月满怀心自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13806,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道出南浦见萧子庄十首 其三","author":"陈渊","text":"雨丝收尽暮天凉，万窍号风酿晓霜。\n待趁新晴出闽岭，夜谈还喜漏偏长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13807,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道出南浦见萧子庄十首 其四","author":"陈渊","text":"平生交契独公深，岁晚那无裹饭心。\n白首它年林下约，此盟端的几时寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13808,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道出南浦见萧子庄十首 其五","author":"陈渊","text":"五年重见各苍颜，往事纷纷醉梦间。\n不为投闲多暇日，岂能千里谒龟山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13809,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道出南浦见萧子庄十首 其六","author":"陈渊","text":"龟山涉世若虚舟，触处忘怀得自由。\n道大不容长役役，心闲无事只休休。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13810,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道出南浦见萧子庄十首 其七","author":"陈渊","text":"了斋已复归黄壤，便恐人间此道微。\n后代不知谁得法，祇今无复更传衣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13811,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道出南浦见萧子庄十首 其八","author":"陈渊","text":"四海知心有几人，淡然今与鬼为邻。\n天下共冤渠不恨，平生忧国自忘身。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13812,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道出南浦见萧子庄十首 其九","author":"陈渊","text":"斯文初不间衡茅，但有玄经岂患嘲。\n骐骥从他千里足，鹪鹩容我一枝巢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13813,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道出南浦见萧子庄十首 其十","author":"陈渊","text":"我在龙潭直下居，西来应不少双鱼。\n故人南浦如相忆，为寄平安尺素书。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13814,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过江郎岩下少驻感而有作","author":"陈渊","text":"三峰卓立苍崖表，朝夕云烟自围绕。\n几年不向眼中青，忽露全身万山晓。\n凝然不动亘今昔，陌上行人空自老。\n我生悟此其已久，梦事萦人嗟未了。\n却怪神龙依绝顶，独以一身蟠故沼。\n风雷际会岂无时，忍视饥氓日纷扰。\n未能呵汝救凶年，明朝马首霜风早。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13815,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三衢道中感怀寄庞几先","author":"陈渊","text":"霜风卷地号，达晓不成雨。\n游云乍蔽亏，朝日翳复吐。\n衢梁三日行，去往迷处所。\n茅檐得小休，蔬饭不能举。\n所嗟兵火馀，白骨莽无主。\n邻邦岁又恶，贾饭逐婺女。\n遏籴彼何忍，楚越视心膂。\n况欲贼取之，不救沟壑苦。\n生逢尧舜代，短袖不容舞。\n空馀卫物心，持此欲谁语。\n故人幕中杰，筹画多所补。\n朝誉竞推先，丘壑终自许。\n平生陈琳檄，解使头风愈。\n容我七子间，泛爱果轻与。\n此生听造物，未能狙公芧。\n牧羊或可息，抱关亦易处。\n要以一溉勤，聊润汉阴圃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13816,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"二月五日入都厅久坐候山甫不至厅前桃花一夜风雨落尽感事写怀","author":"陈渊","text":"簿书堆里只匆匆，过眼繁红夜雨中。\n可念青春看又老，一杯无计略从容。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13817,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓登严陵钓台和安止所留诗","author":"陈渊","text":"溪山有底好，适契贫士欲。\n敢论生不侯，但喜梦非仆。\n千秋钓台水，不濯市朝足。\n而我独何人，得寓尘埃目。\n携筇纵朝步，初日穿林麓。\n西风扶两腋，一举千里鹄。\n东窥夫差国，繁华混真俗。\n浊流驾颓波，一往不可复。\n之子居其间，嗜古追前躅。\n为寄无弦琴，一和郢中曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13818,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用前韵","author":"陈渊","text":"人闲得安眠，梦断了无欲。\n那思趋朝士，一马百夫仆。\n况闻稻苗盛，昨夜新雨足。\n一饱如可期，吾事岂多目。\n盆山郁葱茜，酌水周其麓。\n照我本来面，真白非浴鹄。\n故应此间住，却扫便违俗。\n超然寂照中，无往亦非复。\n百年只尔是，行矣毋踯躅。\n区区欲何为，世路羊肠曲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13819,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过崇仁莫宿山寺书事","author":"陈渊","text":"驿路涂泥一尺深，竹舆高下历千岑。\n愁霖洗尽梅梢雪，把酒无人慰此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13820,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自梅花村回道中书壁四首 其一","author":"陈渊","text":"刺水秧针出已齐，雨馀膏泽未全犁。\n道傍牛喘无情问，惭愧林间布谷啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13821,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自梅花村回道中书壁四首 其二","author":"陈渊","text":"线路萦纡绕乱山，笋舆追逐棘林间。\n艰难那解苏疲瘵，自笑奔驰未得闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13822,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自梅花村回道中书壁四首 其三","author":"陈渊","text":"野花无数不知名，映竹临流若有情。\n扫尽残红春去后，乱山深处眼增明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13823,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"自梅花村回道中书壁四首 其四","author":"陈渊","text":"城郭初看委地红，川原今见绿蒙茸。\n惊人节物催华发，留滞穷山醉梦中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13824,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邑中诸公见和再用前韵 其一","author":"陈渊","text":"郭外盈畴草又齐，十年犹负带经犁。\n未应五斗能留我，端为痴儿索饭啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13825,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邑中诸公见和再用前韵 其二","author":"陈渊","text":"马上悠悠梦故山，茅斋依旧水云间。\n长怀窃辔尘沙外，岂愿骈头十二闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13826,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邑中诸公见和再用前韵 其三","author":"陈渊","text":"冷艳幽香不可名，老年春去独关情。\n林深雾暗何由见，赖有薰风为證明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13827,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邑中诸公见和再用前韵 其四","author":"陈渊","text":"看尽愁人万点红，晓来双鬓白于茸。\n它时傥记江南梦，画我黄梅细雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13828,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"被檄下乡督税作释负","author":"陈渊","text":"诏书宽逋负，国用岂云阙。\n郡邑有常供，征求安敢辍。\n稽迟推蚤暮，钩摘剧豪发。\n饥氓困鞭箠，十室九告竭。\n连雨催早稻，雪穗迷空阔。\n要令公私办，当复俟旬月。\n平生虑患深，献玉每遭刖。\n忧民已无策，问俗聊省罚。\n阳城吾所慕，晚官敢求达。\n宁无抚字心，便觉催科拙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13829,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"夏日雨后戏书","author":"陈渊","text":"雷霆挟雨惊残梦，萧艾乘风醒宿酲。\n黄檗一杯清昼永，张罗谁复问交情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13830,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"与张司录","author":"陈渊","text":"沉李浮瓜记昔游，重来毡帽映貂裘。\n乘风喜见经旬御，泛雪难留半夜舟。\n坐上谈机通一马，笔间词刃失全牛。\n尊前它日论诗地，柱后微文阻献酬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13831,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉和司录道中二首 其一 山行","author":"陈渊","text":"浪蕊浮花逐去程，流红应恨水无情。\n檐间颇厌催归语，木杪空怜唤友声。\n念远却回鸿阵急，忘贫重到燕巢成。\n待凭物理追风御，怀抱如今喜尽倾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13832,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"奉和司录道中二首 其二 偶成","author":"陈渊","text":"云路横翔计似疏，二原清赏更谁如。\n池塘草满供诗梦，烟雨春来入画图。\n落莫早知贫是病，参池今悟直为迂。\n傍人大笑公焉取，为说忘机或类吾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13833,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和司录行县道中偶风雨有感之作六首 其一","author":"陈渊","text":"叶底莺初啭，枝头蝶渐稀。\n雨馀怜草长，风定恐花飞。\n迟暮歌终寠，淹留叹式微。\n更堪西去雁，声逐晚云归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13834,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和司录行县道中偶风雨有感之作六首 其二","author":"陈渊","text":"吏隐声藏雾，天游更御风。\n分携方举白，转盼复堆红。\n北去豺狼尽，春回雨露同。\n向来相对饮，应复念邻翁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13835,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和司录行县道中偶风雨有感之作六首 其三","author":"陈渊","text":"非关浓艳能倾国，可是幽香解返魂。\n正尔彫零废吟赏，欲留佳丽度晨昏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13836,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和司录行县道中偶风雨有感之作六首 其四","author":"陈渊","text":"酴醾卧雨有馀态，芍药倚风无限情。\n正是江南花欲尽，淡云来往日微明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13837,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和司录行县道中偶风雨有感之作六首 其五","author":"陈渊","text":"山头漠漠烟藏树，山下潺潺水满溪。\n全胜长安花柳陌，万人尘里逐轮蹄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13838,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和司录行县道中偶风雨有感之作六首 其六","author":"陈渊","text":"江山似为诗人设，风雨故应春日多。\n醉里吟哦聊自适，眼前开落莫谁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13839,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饶州张宏中挽词二首 其一","author":"陈渊","text":"壮岁英标冠士林，莫年诗酒任浮沉。\n奇姿不见临风玉，妙语空传掷地金。\n残稿有谁知句眼，断弦何处觅琴心。\n他时戏笑成陈迹，惆怅江亭十亩阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13840,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"饶州张宏中挽词二首 其二","author":"陈渊","text":"画栋雕甍照水村，簪裳多在脊令原。\n百年得计南山豆，万事忘怀北海尊。\n自昔功名何世乏，迨今文字几人存。\n遗书傥有毫芒在，为语韩公请备论。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13841,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李耸卿","author":"陈渊","text":"前辈风流晓露零，忽逢豪士壮心惊。\n雷霆落笔千人扫，珠玉成诗万户轻。\n应许翰林追敏捷，肯容开府斗新清。\n向来乞米无佳传，端欲投瓜趣报琼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13842,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李耸卿贺太守祷雨有应二首 其一","author":"陈渊","text":"一寸丹诚贯上穹，坐令千里走龙工。\n骄阳弥目苗将槁，甘雨连霄泽已丰。\n便觉风霜倾意尽，岂愁荆棘致年凶。\n江南岁漕知无阙，遥想中都喜气同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13843,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李耸卿贺太守祷雨有应二首 其二","author":"陈渊","text":"使君忧国愿年丰，肯放炎威久病农。\n尽道胸中藏渤澥，谁知笔下起蛟龙。\n晓凉秋气生蕲簟，梦断檐声带梵钟。\n高卧已传民讼息，秪应仁政古难逢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13844,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归自郡城见道中山矾盛开","author":"陈渊","text":"梅豆班班已满枝，暗香犹未吐酴醾。\n和风煖日江南路，正是山矾烂漫时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13845,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"香严寺洗足","author":"陈渊","text":"肩舆苦顿撼，步入山间路。\n崎岖历荆榛，砂砾窘芒屦。\n披云造萧寺，弛担日已暮。\n僧房急解袜，一洗尘泥污。\n瓦盘深及膝，汤暖得频注。\n须臾和气达，凛凛毛发竖。\n翛然入无何，醉梦宁知处。\n此生事奔走，早晏失期度。\n念兹顷刻闲，百日不一遇。\n啖蔗入佳境，钟响忽予寤。\n蒲团赴微火，默坐聊箕踞。\n明朝尘沙黄，莫忆少陵句。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13846,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山寺早梅三首 其一","author":"陈渊","text":"竹篱茅舍近前溪，烟淡风微月上迟。\n认得暗香来去处，夜寒无路觅横枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13847,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山寺早梅三首 其二","author":"陈渊","text":"冰雪情怀未遽开，芝兰风味已先回。\n故人隔岁无因见，一夜月明何处来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13848,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"山寺早梅三首 其三","author":"陈渊","text":"丹萼犹含绰约肌，水边篱落雪晴时。\n此间妙得无言意，只有西湖处士诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13849,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又题山寺二首 其一","author":"陈渊","text":"云间初日惨无光，天外归鸿岂恋行。\n短景去人如掣电，不应留滞野梅香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13850,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"又题山寺二首 其二","author":"陈渊","text":"云母烧香不见烟，夜深斋阁闭龙涎。\n此生暇日真难得，萧寺重来已四年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13851,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"即席和焦贯道","author":"陈渊","text":"马上无端骨肉消，老来功业正寥寥。\n便须举白追年少，莫恨红妆不我饶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13852,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赵元述庆得子次韵","author":"陈渊","text":"贫家岂有石麒麟，说梦哦诗愧杜陵。\n但得过庭追孔鲤，不愁传钵欠卢能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13853,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和周唐献郎中登普光寺阁","author":"陈渊","text":"官闲竟日身无事，雨过连峦气似熏。\n未暇含香朝琐闼，且乘飞舄蹑青云。\n九天已振抟风翼，万目难藏隐雾文。\n谁凭危栏亲王唾，笑谈应复许随群。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13854,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄曹载德谏议二首 其一","author":"陈渊","text":"不将尘土叹徒劳，白首驱驰任所遭。\n鸾凤尚能安枳棘，鸴鸠何敢厌蓬蒿。\n论材竞欲推囊颖，备物何由数涧毛。\n末路固穷真自许，未应延颈试鸣号。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13855,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄曹载德谏议二首 其二","author":"陈渊","text":"晚途无复计行藏，捶楚尘埃秪自伤。\n未即卖刀归买犊，自怜挟策亦亡羊。\n已无竿牍勤毛颖，肯为箪瓢念孔方。\n尤喜故人书断绝，不将栖棘戏仇香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13856,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"茂实被檄权永新以诗寄之","author":"陈渊","text":"涧松那可比山苗，谩说凌寒有后彫。\n更向鸡虫论得失，何如鹏鴳各逍遥。\n三钟幸自堪攘臂，五斗谁能更折腰。\n正使争先任劳苦，虞人宁不愧弓招。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13857,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李光祖南山四偈 其一","author":"陈渊","text":"声外闻和岂待言，棒头犹是老婆禅。\n如何更被文殊惑，却道维摩但默然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13858,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李光祖南山四偈 其二","author":"陈渊","text":"腊穷春到不须臾，霜下陈根岂用锄。\n若信彫荣如转毂，故应摇落有扶疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13859,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李光祖南山四偈 其三","author":"陈渊","text":"窗前松竹翠连山，窗下弦歌昼掩关。\n雪里忍看梅欲吐，烟中遥认鸟知还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13860,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵李光祖南山四偈 其四","author":"陈渊","text":"未暇南山访隐居，祇应无处不逢渠。\n凭君一省从前梦，莫叹离群岁又除。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13861,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵光祖避地眉溪十绝 其一","author":"陈渊","text":"眼在句中宁易知，意存言外一何微。\n柏舟故是仁人事，岂为淹留念奋飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13862,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵光祖避地眉溪十绝 其二","author":"陈渊","text":"浮木如何济巨川，积薪其下火将然。\n是中已有安身地，许尔垂绅玉几前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13863,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵光祖避地眉溪十绝 其三","author":"陈渊","text":"弄云微月淡回廊，十室连甍占上方。\n谁道各无容足地，夜谈犹欲致时康。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13864,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵光祖避地眉溪十绝 其四","author":"陈渊","text":"少年凭恃气方强，肤理微邪未觉伤。\n迨得病深无治法，始知先甲是农黄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13865,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵光祖避地眉溪十绝 其五","author":"陈渊","text":"访道寻幽历万山，神仙元不在山间。\n须知对面长相失，莫叹乔松去不还。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13866,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵光祖避地眉溪十绝 其六","author":"陈渊","text":"四海黔黎共一君，须知盗贼亦吾民。\n由来齐梃胜秦甲，要在人如父子亲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13867,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵光祖避地眉溪十绝 其七","author":"陈渊","text":"当时先主得关张，能使西川弱胜强。\n今日中原岂无士，坐愁豺虎乱要荒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13868,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵光祖避地眉溪十绝 其八","author":"陈渊","text":"污莱正尔肥蚯蚓，滞穗那能饱鸒斯。\n布谷似嫌新历缓，每从清晓报农时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13869,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵光祖避地眉溪十绝 其九","author":"陈渊","text":"何人更下仲举榻，举世愿登元礼门。\n千古家声君与我，未知何以起斯文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13870,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵光祖避地眉溪十绝 其十","author":"陈渊","text":"了斋力欲排邪说，谁遣奇穷道不兴。\n长恨人亡琴亦往，赖传心法有卢能。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":13871,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]