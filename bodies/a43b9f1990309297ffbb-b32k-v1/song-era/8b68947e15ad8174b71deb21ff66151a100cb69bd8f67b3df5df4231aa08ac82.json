[{"title":"寿益垣丙午中元日生","author":"黄维之","text":"天祐熙朝世产贤，承平旧事并今传。\n莱公少避中元日，潞国同生丙午年。\n翰墨独传千古秘，声名倔在二公先。\n功成野服平原去，要伴灵龟巢碧莲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74155,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"黄维之","text":"九日溪头携酒去，万安桥上折花归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74156,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五更枕上","author":"黄虚舟","text":"睡觉愁无奈，难禁冬夜长。\n才听晓钟动，又是世人忙。\n入市船撑月，朝天马踏霜。\n布衾绵样软，切莫笑寻常。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74157,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"蛾眉亭","author":"黄虚舟","text":"浩荡长流浪拍天，貔貅十万坐楼船。\n年年春满江南岸，夜夜风传塞北烟。\n中界灵祇藏水府，六朝废寝落山边。\n秋来留得唐时月，捉月今谁是谪仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74158,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"黄辅","text":"许国一心如铁劲，阖门百口等毛轻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74159,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日","author":"黄铢","text":"晓日初浮万里晖，西风摇荡送秋归。\n冥鸿直上三千丈，社燕春莺不敢飞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74160,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梅花","author":"黄铢","text":"玉箫吹彻北楼寒，野月峥嵘动万山。\n一夜霜清不成梦，起来春信满人间。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74161,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"季夏有怀仲晦","author":"黄铢","text":"六月苦炎蒸，山居昼方永。\n泠然南风至，萧散荷气骋。\n蜩鸣绿树阴，鱼跃横塘净。\n高蔓展修条，幽篁茁阴颖。\n良时倏回改，白发益蔽领。\n虽无簪组累，要有贫贱㾪。\n故交何寥阔，画戟光烱烱。\n沧洲期未远，岁晏心独耿。\n谁同兹寂寞，敛退自幽屏。\n向夕牛羊下，过翮急似逞。\n默默掩荆扉，明蟾在东岭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74162,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋日怀元晦","author":"黄铢","text":"叶落不胜秋，山空退烦暑。\n高斋读书罢，枕臂听残雨。\n霭霭野云昏，翻翻坠红舞。\n中虚万思息，动静理可睹。\n敬直如有存，勇进忽无所。\n要当涵濡得，未易气力取。\n林□传秋声，晚色霁宫宇。\n肃骚节物变，仰伏冥鸿举。\n谁与会心期，怀君自延伫。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74163,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送仲晦","author":"黄铢","text":"靡靡岁时晏，乱山红叶稀。\n端居已无悰，况与亲故违。\n驾言临广路，惜此须臾期。\n祖燕未云洽，鸡鸣促再驰。\n晨装俨然队，天澹风凄凄。\n迤逦征人行，怅惘离言悲。\n令德本高世，诚思开圣微。\n虎豹文采异，几年丹诏垂。\n眷兹皇华寄，那得淹遐隮。\n君王久延伫，去矣翔天墀。\n顾我抱幽独，已为清世遗。\n冥鸿聿高举，蜩鸴何由追。\n萦萦西郊道，晻晻朝阳晖。\n出处自殊迹，操袪胡不怡。\n明当逐云月，依旧东冈陂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74164,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"送朱元晦游湘中","author":"黄铢","text":"有美人兮，蹇何为兮中洲。\n鸣玉佩兮，冠云章而远游。\n浮沅湘而西蹠兮，因返睇兮层丘。\n繄发轫之指期兮，歌予怀以送之。\n粤大道之汩湮兮，嗟惟君兮何求。\n唐虞远而不可见兮，凤鸟去兮周衰。\n翟朱之诡行兮，邹人拒而劙之。\n竺老氏之猖披兮，浸淫渝而益非。\n思正气之所繇兮，度百世而固然。\n岂日夜而忘之兮，曰夫子之所传。\n发丝丝其不斩兮，哇淫蔽兮莫开。\n讫大振于兹时兮，余将从乎洛之湄。\n心郁郁而无告兮，顾众兆兮何知。\n梏夜气而不存兮，外其良而四驰。\n彼早兴而夕息兮，既日用而不能察也。\n纷蠢蠢其倚靡兮，曰骛乱而莫之达也。\n思存养而莫吾亏兮，所事天下而不忘繇。\n致知以自强兮，至天下以□览。\n余初其性之兮，稽□坟而载陈。\n仁与人其并致兮，道乌乎而远身。\n刚柔之弛张兮，一气缭转而无息。\n矫吾奠夫两间兮，又阴阳而与为一。\n超无极而混沦兮，精凝融而以神。\n卒变化而不穷兮，周流通乎九垠。\n悲空言之无所底兮，固将推乎余所行。\n杂椒兰以并进君兮，终何乖异而不余信。\n既鄙弃而不吴庸兮，徒渊潜以自珍。\n岂不郁陶而思君兮，觊方来之以申。\n时与时其未际兮，夷与裔兮得志。\n□冠巾之易置兮，曾乐天而不云恚。\n曾永慨以嗟咨兮，聊远举乎湘中。\n即友声以自乐兮，盖将切偲以益其躬。\n山九疑而在上兮，湘流奔其在下。\n故仁智之所乐兮，遂倘佯而辞去。\n超兮浮兮，心若谋兮。\n眴兮眄兮，目横分兮。\n鸾凤并驭，羌不得留兮。\n时未适当适，吾何为东周兮。\n乱曰：汩兮沅湘，生秋风兮。\n商行激御，白云东兮。\n树木萎落，山郁盘兮。\n风车雨轮，旌摇摇其行兮。\n委蛇噎抑，多修艰兮。\n白首倚户，思结棘兮。\n信莫乐兮，君乎无忘归兮。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74165,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"晓起有怀仲晦彦集不至","author":"黄铢","text":"月落北牖晓，邻鸡号梦残。\n林端清露坠，寝衣凄已单。\n爽朗朝景晰，嘲啾庭雀喧。\n日高溪雾收，四望开青天。\n荷谢水初冷，菊黄香正繁。\n晶晶灏气凝，馀光浮远川。\n怀人天一方，晤言谁与殚。\n徘徊遂薄暝，丹枫摇暮寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74166,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"铁笛亭","author":"黄铢","text":"一声苍壁裂，再奏蛟龙悲。\n事往迹犹在，山空人不归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74167,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"寄南康使君仲晦五十二兄","author":"黄铢","text":"故人久已别，出拥朱辕轓。\n昨尝枉札素，谓言寻里门。\n云胡不践诺，使我心烦冤。\n天门深九重，叫阍闻有言。\n狺狺猛犬吠，曀曀黄霾昏。\n何由一褰开，豁然见乾坤。\n沈忧谅难寤，掩默孰与论。\n秋风吹层波，落叶何翩翻。\n林端月照夜，谷口云迷村。\n谁同紫芝友，桂枝谁攀援。\n江蓠老已尽，况复芳兰荪。\n应当虎符恋，茕茕劳梦魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74168,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"江神子 晚泊分水","author":"黄铢","text":"秋风袅袅夕阳红。\n晚烟浓。\n暮云重。\n万叠青山，山外叫孤鸿。\n独上高楼三百尺，凭玉楯，睇层空。\n人间日月去匆匆。\n碧梧桐。\n又西风。\n北去南来，销尽几英雄。\n掷下玉尊天外去，多少事，不言中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74169,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"渔家傲 朱晦翁示欧公鼓子词戏作一首","author":"黄铢","text":"永日离忧千万绪。\n雪舟远泛清漳浦。\n珍重故人寒夜语。\n挥玉麈。\n沈沈画阁凝香雾。\n风砌落花留不住。\n红蜂翠蝶闲飞舞。\n明日柳营江上路。\n云起处。\n苍山万叠人归去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74170,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"菩萨蛮 夜宿崇安县第三铺闻吹箫","author":"黄铢","text":"海山翠叠青螺浅。\n暮云散尽天容远。\n匹马度江皋。\n北风生怒号。\n解鞍栖倦翮。\n皓月空庭白。\n何处小阑干。\n玉箫吹夜寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74171,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"黄铢","text":"先圣有遗训，忧道不忧贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74172,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"黄铢","text":"私意苟未克，放心何由驯。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74173,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"黄提举","text":"耕馀龙跃云津去。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74174,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪 其二","author":"黄景说","text":"瑶林中有翳桑儿，鼎贵生涯不救饥。\n愿缩天人散花手，放渠奔走趁晨炊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74175,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"雪 其一","author":"黄景说","text":"说道羞明却不羞，日光玉洁共飞浮。\n天人胸次明如洗，肯似人间只暗投。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74176,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古风贺周益公休致","author":"黄景说","text":"相公能辞一品官，不能辞他九转丹。\n相公能却万钟粟，不能却他长生箓。\n潭潭之居移气体，新年七十儿童似。\n朝明见客步如飞，窗下时时看细字。\n高车得似垂车荣，巍冠何如挂冠清。\n深衣独乐真天人，谁其友之聃与彭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74177,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"诗一首","author":"黄景说","text":"居乡如处子，居官如战士。\n处子常畏人，战士惟有死。\n儿曹书诸绅，勿谓平平耳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74178,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"梨岭遇雨","author":"黄景说","text":"黑风吹雨又黄昏，鸡犬数声何处村。\n身在岭云飞处湿，不关别泪溅成痕。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74179,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其四","author":"黄景说","text":"孤标只合在孤山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74180,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其三","author":"黄景说","text":"谁与诗人管醉魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74181,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其二","author":"黄景说","text":"侬是水仙鸿雁行。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74182,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其一","author":"黄景说","text":"一落风尘即厚颜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74183,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其五","author":"黄景说","text":"清杀玉川文字肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74184,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其八","author":"黄景说","text":"落日天寒客自愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74185,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十","author":"黄景说","text":"万木逢霜一劫灰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74186,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其六","author":"黄景说","text":"临风长作南枝想。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74187,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其七","author":"黄景说","text":"一身尽著雪衣裳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74188,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其九","author":"黄景说","text":"政尔玉壶相俎豆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74189,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句 其十一","author":"黄景说","text":"肯随桃李斗梳妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74190,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"五年二月朔投晓到岩寺适值亡女忌日因而饭僧","author":"黄朝散","text":"沐雨冲风夜向晨，九龙岩畔报中春。\n行庖一供山僧饭，下咽甘□不笑贫。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74191,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再过九龙岩","author":"黄朝散","text":"腊尽春来气应和，丰年嘉瑞作民歌。\n一杯龙洞梅花酒，□破牢愁埒太阿。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74192,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"行县憩九龙岩","author":"黄朝散","text":"金鳞玉角照人寒，何事清时此蛰蟠。\n甘泽不辞膏品物，奚惭济济舜朝官。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74193,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和士曹曹文林省题九龙岩","author":"黄朝散","text":"不为鱼计伏藏深，鸣和奚惭鹤在阴。\n千里秋苗如普润，何妨信史一书霖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74194,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"和阮倅正名九仙","author":"黄朝散","text":"采□形相异为仙，识性谁知共一天。\n泽物度人均是道，瑞昭千载起祥烟。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74195,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"将到岩洞油云忽作骤雨滂霈","author":"黄朝散","text":"寸心忧旱隐如焚，默念僖心闵雨勤。\n欲到九龙岩数里，霈然甘泽副油云。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74196,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"得雨移刻即止惜乎不广","author":"黄朝散","text":"骤雨滂沱若救焚，痡瘏时暂慰劳勤。\n若教千里均沾渥，多稼看看胜□云。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74197,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"睹丞相曾公为桂帅时经过留题","author":"黄朝散","text":"龙岩重到腊残天，欲访丹成行满仙。\n因睹曾公题刻妙，气腾忠谊拂云烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74198,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"任安仁县秩满归过馀干县台山住寺僧云畴昔之夜梦神人呵之曰可出郊迎知县公赋一绝以纪其事云","author":"黄棆","text":"年来踪迹叹飘然，一笑相逢莫匪缘。\n多谢老僧勤记我，预将消息梦中传。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74199,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"元日待漏院会宰执诗","author":"黄棆","text":"喜陪仙仗禁门前，饯腊宾春启玳筵。\n其听金鸡报新岁，忽闻玉漏惜残年。\n故乡此去三千里，丹扆相违咫尺天。\n待罪谏垣无补报，惟输朴直体蕃宣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74200,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"再题松明寺次前题壁间韵","author":"黄棆","text":"怪若奇峰巧若何，衣冠到此苦无多。\n自惭登览非能赋，敢觊雕镌尚不磨。\n古寺残僧犹记忆，岚烟嶂雨几嘘呵。\n旧题莫辨苍苔迹，多谢梅仙为剪摩。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74201,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题左翰林三友亭","author":"黄棨","text":"劲节虬枝水月香，轩前高坐胜寻常。\n翰林此意知非浅，曾有坚心秉雪霜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74202,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题涪翁亭","author":"黄然","text":"清音妙绝东坡老，方响名高太史公。\n水绕乌尤谈笑外，江连洪雅画图中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74203,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"黄琚","text":"长虹吸尽两潮水，赤鉴妆成万顷田。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74204,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"泽卿示兰亭考作萧翼取兰亭辞","author":"黄畴若","text":"长廊睥睨来者谁，出门解后渠得知。\n不言使者求遗书，只言浴茧当及时。\n从容与语益款洽，论到翰墨尤瑰奇。\n山僧技痒不自禁，稍出脩禊兰亭词。\n启函展玩未及竟，袖有黄纸天庭追。\n口呿气褫僵欲死，一骑趣向咸阳驰。\n虬须天子喜折屐，诏许两禁同观之。\n龙腾凤集在御榻，平生触眼何曾窥。\n自从茧纸归昭陵，宝气夜夜光陆离。\n千年议论经几手，极力追仿分毫釐。\n博闻强志子桑子，上下纂辑无或遗。\n清臞不满六尺长，中有文字无津涯。\n归君此编忽自笑，山东学究真黠儿，而今御史还书痴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74205,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"万峰庵","author":"黄登","text":"上到山巅晓色分，眼看残月待朝昕。\n望迷四顾浑如海，立欲移时祇是云。\n隐隐楼台平地见，行行钟磬半天闻。\n举头顿觉青霄近，我欲乘风谒帝君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74206,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题三岩 其二","author":"黄登","text":"飘然投绂卧云林，一片平生铁石心。\n不是遗文能动我，谁令吊古便沾襟。\n身同逝水几寒暑，名在空山无古今。\n仰止高风琴床下，还教三叹薄朝簪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74207,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"题三岩 其一","author":"黄登","text":"占断烟霞老一丘，玉岩阅历几春秋。\n削成四壁开三面，比似他山出一头。\n几欲登临寻胜概，偶然休沐得佳游。\n醉磨浓墨书岩石，恨不携琴更少留。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74208,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"卜算子 和思宪史韵","author":"黄童","text":"不忍更回头，别泪多于雨。\n肺腑相看四十秋，奚止朝朝暮暮。\n何事值花时，又是匆匆去。\n过了阳关更向西，总是思兄处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74209,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"虞美人","author":"黄舜英","text":"一从骨肉相抛了。\n受了多多少。\n溪山风月属何人。\n到此思量、因甚不关情。\n而今虽道王孙贵。\n有事凭谁济。\n自从今夜得媒言。\n相见佳期无谓、隔关山。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74210,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"句","author":"黄萼","text":"钓沉新月落，龙起暮江寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74211,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗皇帝挽词 其二","author":"黄谦","text":"整顿乾坤后，边烽久已销。\n和亲来北虏，温凊乐东朝。\n历数躬传舜，文章焕有尧。\n会稽天仗路，伤心綵云遥。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74212,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"高宗皇帝挽词 其一","author":"黄谦","text":"火德兴王统，天威詟犷夷。\n重恢周境土，复振汉威仪。\n显号崇瑶册，耆年庆玉卮。\n鼎成龙去远，扳慕不胜悲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74213,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋夜","author":"黄超然","text":"秋近园林风露凉，虫声无数出颓墙。\n前朝旧事过如梦，不抵清秋一夜长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74214,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"古风","author":"黄超然","text":"不知乃不愠，古人叹难能。\n我谓直易事，学道非干名。\n本无求知心，愠亦何从生。\n所以茅檐下，高枕曲吾肱。\n琴书坐中友，云山门外朋。\n肺腑欣有得，耳目谅无憎。\n愿同子扬子，白首太玄经。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74215,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"鸱枭获腐鼠","author":"黄超然","text":"鸱枭获腐鼠，欢喜同八珍。\n凤凰遨千仞，琅然落清音。\n事有适相值，枭遂生欢心。\n仰首噱一嚇，谓凤当见侵。\n凤凰睹腐鼠，掩鼻方微颦。\n投惠且不纳，奋攫岂所任。\n昆崙有竹实，去去不可寻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74216,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"遣兴","author":"黄超然","text":"晒麦有馀粒，双鸠下庭际。\n知我无杀心，相忘两无碍。\n风暝物意乐，云薄花影晦。\n试知春色深，粗觉静可爱。\n纷纷门外客，经过不相诣。\n不邀亦不却，有酒当共醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74217,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"贽见洪师","author":"黄铸","text":"风烟入暝少人行，独鹤来依帝子城。\n华表柱头霜月冷，清宵有梦到钟声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74218,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"小重山","author":"黄铸","text":"凉入秋檐雨意长。\n竹深啼络纬，响虚堂。\n一枝灯影耿昏黄。\n疏帘外，风度木樨香。\n心事易成伤。\n燕支坡下路，语如簧。\n定仙螺子玉钗梁。\n鸳屏梦，应到旧韦郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74219,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}},{"title":"秋蕊香令","author":"黄铸","text":"花外数声风定。\n烟际一痕月净。\n水晶屏小敧醉枕。\n院静鸣蛩相应。\n香销斜掩青铜镜。\n背灯影。\n寒砧夜半和雁阵。\n秋在刘郎绿鬓。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_2.csv","pointer":74220,"sha256":"803c6a90ea341892bf1b9f1a81277053e512e8f979efc9c41cd59a283ba061d3","dynasty":"宋"}}]