[{"title":"次韵刘寺簿与客酌酃泉","author":"程洵","text":"庭无聚讼喧，门有佳客至。\n登高一以眺，天末雁横字。\n公心本无著，佳处偶会意。\n意会旋已忘，陶然不妨醉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24692,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"幽闺","author":"程洵","text":"幽闺有美人，终宵抱长叹。\n念彼远征客，风露如许寒。\n耿耿不成寐，怅然理哀弹。\n离鸾韵纤指，曲终泪阑杆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24693,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秋风","author":"程洵","text":"秋风来几日，草木殊未知。\n寒虫独何者，若与秋有期。\n露竹动寒彩，云松弄幽姿。\n梦寻溪头路，意行当何时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24694,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵胡国器游历崌","author":"程洵","text":"枯筇挂倒星斗傍，意行屈曲忘陵冈。\n忽逢萧寺倚岩腹，门前水影涵山光。\n凭虚飘欲上霄汉，览远浩如浮大沧。\n嗟子失身坠世网，恨不与子同翱翔。\n白莲共结清净社，红裙绝意温柔乡。\n何当脱屣声利场，从渠万态争炎凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24695,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵答唐卿叹梅","author":"程洵","text":"玄冥玄冥如有辞，大钧播物初无私。\n春兰秋菊亦有尔，梅独强分南北枝。\n南枝北枝自有时，人言冷暖浪自欺。\n天公与人不相似，时来看取葭灰吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24696,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄彦周求秀亭诗云其地山水合六秀法故以名亭","author":"程洵","text":"少年锐意功名会，李广数奇终鹢退。\n晚从林下得幽栖，绿净翠微动赏对。\n危亭萧洒八九椽，千岩万壑相回环。\n人言山秀水亦秀，偶然得此宁非天。\n身世区区如逆旅，人生要有归全处。\n天星地卦且置之，阴德从来不知数。\n会当置酒傍清樾，一语寿君君笑发。\n且住人閒五百年，衔杯乐圣山水閒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24697,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张公成生日","author":"程洵","text":"没膝春泥未易过，华堂咫尺隔关河。\n精神闻说年来健，岁月从渠老去多。\n闹里渐应排世事，静中正好养天和。\n祝君寿骨如张果，莫惜频倾金叵罗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24698,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"梅花","author":"程洵","text":"落木萧萧岁已深，天教梅蕊独争新。\n一枝岭上方传恨，千树江头忽暗春。\n会与霜筠矜节概，不同风柳斗腰身。\n罗浮当日醉眠起，斗转参横谁与邻。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24699,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠刘道人兼送何蕃秀才东归","author":"程洵","text":"道人别我三年久，丘壑胸中趣益真。\n更与风流能赋客，来寻憔悴负痾人。\n明窗辨药分寒燥，清夜吟诗动鬼神。\n促膝方欢又分袂，别愁还与月痕新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24700,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"兆察道中","author":"程洵","text":"偶作郊原十里行，萧萧入袂晚风清。\n夕阳疏树无佳处，只有残鸦自在鸣。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24701,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"送张子有彦实舍人之侄","author":"程洵","text":"宴居仙伯已骑鲸，犹子东来尚典刑。\n才气逼人春盎盎，交情阅世柏青青。\n昨朝方对圣贤酒，今日又寻长短亭。\n归路不妨携古锦，萱丛菖叶正芳馨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24702,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄朱德芳","author":"程洵","text":"武林仓卒指归程，千里脩途偶并行。\n云散风流当日事，山长水远此时情。\n栖迟顾我犹藏拙，邂逅烦君尚寄声。\n尺素聊凭西去雁，梦魂今夜绕江城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24703,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"久雨初霁示友","author":"程洵","text":"积雨初收四望新，颓云淡日弄晴阴。\n故园百里梦不到，杜宇一声春又深。\n宿蝶乱红浑满地，藏鸦新绿已成林。\n客中情味君休问，庄舄无聊但越吟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24704,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨日新辟书室以月壶榜之求诗 其一","author":"程洵","text":"清透虚檐冷侵空，下弦祝罢且从容。\n是中自有一天地，何必更登天柱峰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24705,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"杨日新辟书室以月壶榜之求诗 其二","author":"程洵","text":"此郎表里久融明，胸次悠然冰玉清。\n虚室如今已生白，不随晦望有亏盈。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24706,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张巨川为父庆八十二邀予与坐作诗寿之 其一","author":"程洵","text":"龟形鹤骨旧精神，见了春容几度新。\n却笑当年梁秘监，更将多少较前人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24707,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张巨川为父庆八十二邀予与坐作诗寿之 其二","author":"程洵","text":"官为秦世柱下史，生忆尧时丙子年。\n家世从前多寿骨，侯封不必羡神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24708,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示伯羽 其一","author":"程洵","text":"交游半作抟沙散，不见周郎亦四春。\n邂逅相逢无一事，依然都似旧时贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24709,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"示伯羽 其二","author":"程洵","text":"偃蹇我如蛙伏井，飘零君似鹊寻枝。\n回头十二年前事，一笑那能似彼时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24710,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次唐卿九日","author":"程洵","text":"无钱薄酒自难赊，笑解尘衣到酒家。\n只欠道人殷七七，鹤林重发杜鹃花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24711,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祈山九日","author":"程洵","text":"客思到秋如乱麻，每逢佳节倍思家。\n黄花只作去年好，绿鬓自嫌今岁华。\n千里有情犹共月，一樽无事且倾霞。\n闲来甘露堂前坐，老柳条条噪暮鸦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24712,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陪晦庵尊兄山行小憩龙居院","author":"程洵","text":"平生发兴在林邱，况复追随长者游。\n路入乱山青未了，秧分野水绿初稠。\n剧谈已有亲朋乐，小憩仍逢寺宇幽。\n满座春风与和气，对公无地可言愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24713,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用韵送蔡季通还建安","author":"程洵","text":"骑气居然两月留，胜游不减舞雩游。\n道同顿觉语易契，意合不知情自稠。\n□□还惊千里远，著鞭又踏万山幽。\n恨无力挽天河水，为我临歧洗别愁。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24714,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵喜雨","author":"程洵","text":"敲窗打叶不胜繁，洗尽黄尘万里昏。\n便有清风生远树，祇牵孤梦绕归村。\n新粳想见黄堆野，老柳犹能绿映门。\n自笑年来诗事废，得君强韵缩肩跟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24715,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中书事 其一","author":"程洵","text":"门无去马与来车，终日尘编自展舒。\n笑抚蒲团时有会，古人于我未全疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24716,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"雨中书事 其二","author":"程洵","text":"经邱久已罢巾车，寄傲南窗意自舒。\n一炷妙香清万虑，芭蕉叶上雨疏疏。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24717,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予甲戌岁与惠州麦少韩始相会于都下后十九年复会焉今又六年而少韩见予益勤将东归为诗四章以别 其一","author":"程洵","text":"邂逅京华忆昔时，匆匆长恨遽暌离。\n重来只有声音在，两鬓萧萧各欲丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24718,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予甲戌岁与惠州麦少韩始相会于都下后十九年复会焉今又六年而少韩见予益勤将东归为诗四章以别 其二","author":"程洵","text":"与君南北昧平生，倾盖论心若弟兄。\n长笑区区市朝客，白头重欲定交情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24719,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予甲戌岁与惠州麦少韩始相会于都下后十九年复会焉今又六年而少韩见予益勤将东归为诗四章以别 其三","author":"程洵","text":"鼻祖功名冠有隋，耳孙笔力近京西。\n鹅城勿作潜深计，雁塔行看高处题。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24720,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"予甲戌岁与惠州麦少韩始相会于都下后十九年复会焉今又六年而少韩见予益勤将东归为诗四章以别 其四","author":"程洵","text":"人去空山锁碧云，纸窗竹屋尚明深。\n苍珉遗刻烦多寄，慰我平生敬慕心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24721,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵张顺之春日杂诗 其一","author":"程洵","text":"解事东皇自有期，今年春较去年迟。\n未教红著桃开脸，先放青还柳作眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24722,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵张顺之春日杂诗 其二","author":"程洵","text":"春来何物不熙熙，川泳云飞各自奇。\n趁队鱼儿如得意，窥人燕子似相欺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24723,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵张顺之春日杂诗 其三","author":"程洵","text":"闲斋人静日方中，想见先生睡思浓。\n只么赏情殊有味，趁衙杂沓任黄蜂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24724,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵张顺之春日杂诗 其四","author":"程洵","text":"烱烱朝曦暖意回，迟迟午景气佳哉。\n柳阴才逐斜阳去，花影还随皓月来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24725,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵张顺之春日杂诗 其五","author":"程洵","text":"沈水烧残日未西，旧书读罢卷重披。\n傍人欲识闲中趣，看取先生宴坐时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24726,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寄张顺之","author":"程洵","text":"踏遍危途兴已阑，倦飞幽鸟故知还。\n手开高士蓬蒿径，坐对先生苜蓿盘。\n□□揶揄遭点鬼，却羞矍铄据征鞍。\n侯封到底输千首，圆美当□似弹丸。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24727,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵顺之见寄","author":"程洵","text":"梅子垂垂雨复晴，田歌初报罢春耕。\n敲门忽有诗筒至，入手悬知句法精。\n应聘申公何日去，草玄扬子几时成。\n知君不乐杯中物，事业端期身后名。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24728,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"中秋夜久方见月","author":"程洵","text":"此夕清光本自多，不劳玉斧更砻磨。\n祇应云物偶如此，未惬诗情可奈何。\n喜见一轮还旧观，遥知千斛费明河。\n先生赏罢浑无事，古井依然湛不波。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24729,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵杨日新出郊寻桂乃有送者","author":"程洵","text":"月窟移来几换星，幽人何处得繁英。\n行寻十里不知远，归傍一窗相对清。\n未与□兄较标格，且邀松友定交情。\n岁寒正尔团霜露，尚有苍苍照眼明。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24730,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵日新九日书事","author":"程洵","text":"登高不惜蹑凌兢，乐此佳辰古所名。\n白堕从今无远寄，黄花依旧弄秋荣。\n霜凋万木天地肃，水落百川波浪平。\n更喜晚来风力软，恋头破帽亦多情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24731,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"崇安道中","author":"程洵","text":"田如累级登高堂，石如金华卧群羊。\n上梅下梅山路恶，大将小将溪流长。\n振衣欲度分水岭，回首尚忆杨家庄。\n折花恨不逢驿使，为寄一枝还紫阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24732,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过分水岭","author":"程洵","text":"相与振衣千仞冈，浩歌莫惜邱徜徉。\n风来闽徼不知远，山接吴天如许长。\n裘敝且将云作氅，囊羞犹可墨如庄。\n眼明更向西南望，依约家林傍夕阳。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24733,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道傍人家瓶梅正思命赋诗","author":"程洵","text":"茅舍疏篱古道傍，一枝的皪为谁芳。\n壶中春色从来别，冷落全胜白玉堂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24734,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"铅山道中次叔重韵","author":"程洵","text":"烟翠空濛扑远林，氛埃那复犯灵襟。\n归程不恨风霜恶，自有梅花识此心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24735,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"浏口山岩","author":"程洵","text":"牛羊久已下，行李尚匆匆。\n天挂新蟾白，山连野烧红。\n问途愁店远，沽酒叹囊空。\n犹喜家山近，篮舆晓又东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24736,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"和正思赠别","author":"程洵","text":"同途欣得友，欲别惜分襟。\n去路无多远，离觞不厌深。\n游鳞寻旧壑，倦翼带归音。\n有底凄凉甚，风霜搅客心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24737,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次董叔重赠别","author":"程洵","text":"波光草色照人明，别意幽怀酒一倾。\n飘泊君方惊旅梦，淹留我遂识人情。\n穿沙碧干娟娟净，带雨幽葩艳艳荣。\n何日相从溪上路，临流倚策话平生。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24738,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵祖德九日","author":"程洵","text":"黄花岁岁与秋期，又见登高落帽时。\n云水光中孤赏玩，簿书丛里足栖迟。\n大篇且对玉连琐，小酌何须金屈卮。\n只恐颓檐并败屋，不禁巽二恣狂吹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24739,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"晓行湘岸竹閒有怀家山","author":"程洵","text":"琅玕万个倚江湘，中有人家类辟疆。\n地迥自应尘不到，天开初见日舒光。\n此身汩汩五斗役，旧隐遥遥三径荒。\n想见韩溪溪上路，烟稍雨叶拂云长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24740,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"湘岸道中","author":"程洵","text":"按行又复到江干，近水遥山照眼寒。\n从此潇湘在胸次，不须更向画图看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24741,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"渡湘江","author":"程洵","text":"万顷澄澜碧玉宽，笑乘一叶自轻安。\n绿蓑从此关心事，待向烟林乞钓竿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24742,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白竹桥","author":"程洵","text":"向来过此日流金，今日重来雪满林。\n轻弃箪瓢贪斗粟，区区奔走愧初心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24743,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒溪","author":"程洵","text":"溪名偶与故乡同，恍觉家山在眼中。\n定自今宵更愁绝，又飞清梦过江东。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24744,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"过沙木桥怀赵公南","author":"程洵","text":"沙木桥头野老家，又来㢮檐酌流霞。\n坐中只欠当时客，欲寄南枝一两花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24745,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道傍见牛舐犊有感","author":"程洵","text":"人物本来同一原，于何却作两般看。\n祇应气质生时异，差别从兹有万端。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24746,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"泊高安市上夜雪","author":"程洵","text":"柏山高卧有馀清，我坐高安似冻蝇。\n却喜明朝添伟观，峨峨千里踏层冰。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24747,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"三月九日祁阳舟中闻鹃忆去年此日到衡阳有感","author":"程洵","text":"急桨轻舟下碧澜，归心切切陇头鹃。\n人生石火光中住，又向湖南过一年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24748,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵刘寺簿临蒸精舍落成","author":"程洵","text":"濂溪当日起南方，千载斯文有耿光。\n遗俗至今尊孔孟，后生谁肯学苏张。\n贤关莫叹吴天远，精舍今临楚水长。\n试问坐中谁鼓瑟，舞雩风味想难忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24749,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用韵","author":"程洵","text":"斯文从昔患多方，今日因公晦复光。\n心法祇传书一卷，文华那用纸千张。\n窗前草色沿阶翠，川上波流极目长。\n此意更须公指示，后来□□月无忘。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24750,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用韵题诸葛武侯祠二首 其一","author":"程洵","text":"群雄逐鹿走迷方，四百炎精不复光。\n天启奇才思蛰奋，人嗔黠虏久鸱张。\n悠悠陈迹青编在，寂寂丛祠碧草长。\n成败由来难逆睹，祇应大义不容忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24751,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"用韵题诸葛武侯祠二首 其二","author":"程洵","text":"独明大义晓多方，烱烱精忠贯日光。\n开拓荆榛资蜀汉，驱除鬼蜮老关张。\n司徒岂足知邪正，著作宁能识短长。\n公论到头须后世，至今尸祝未能忘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24752,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵刘寺簿诣学","author":"程洵","text":"衡湘山水竞清雄，閒气曾生益代翁。\n后学谁能明绝学，遗风犹可想高风。\n欲求太极精微蕴，可乏群居讲究功。\n飞跃鸢鱼元有道，使君心与古人同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24753,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次韵刘寺簿鹿鸣宴","author":"程洵","text":"江头梅蕊小装春，式宴嘉宾属守臣。\n京国路虽千里远，琼林花又一番新。\n且观鹿野陈乡乐，休忆羊裘整钓纶。\n老我岂堪陪盛集，为公强振簿书尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24754,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用韵","author":"程洵","text":"圣主如天与物春，四方委质愿为臣。\n设科取士制虽旧，侧席求贤意自新。\n扬子词高非篆刻，井春学富独纷纶。\n行行好上江都策，莫厌京华没马尘。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24755,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"寒食次伯潜韵","author":"程洵","text":"小雨浪憎春日迟，轻寒自与晚花宜。\n节过岭外忆饧日，人比山阴脩禊时。\n雀舌味长初试水，猫头意懒任穿篱。\n归途莫恨石头滑，山色波光总是诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24756,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张王臣以诸公骖字韵见贻即席奉次","author":"程洵","text":"圜扉草色碧于衫，晏子何劳更解骖。\n剩喜文书清幕府，翻嗟宾客滞湖南。\n迟回愧我非高士，邂逅因公尚剧谈。\n清夜论诗到山谷，棒头妙旨欲重参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24757,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再韵呈诸公","author":"程洵","text":"羞将华发照青衫，直拟凉秋整去骖。\n应聘岂能如水北，紬书何事尚周南。\n江澄颇觉客愁破，山好那须世事谈。\n犹胜元琳日趋府，强持簪笏逐髯参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24758,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"再用韵呈王臣兼简同社诸公","author":"程洵","text":"亭下江波绿样衫，亭前山势走惊骖。\n心如胡马犹思北，梦比飞乌正绕南。\n银笔新书时有省，金銮故事不须谈。\n经纶从昔须贤哲，洗眼诸公国论参。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24759,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]