[{"title":"捣练子 其一 八梅","author":"无名氏","text":"捣练子，赋梅枝。\n暖借东风次第吹。\n自是百花留不住，让教先发放春归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1187,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"捣练子","author":"无名氏","text":"林下路，水边亭。\n凉吹水面散馀酲。\n小藤床、随意横。\n暗记得、旧时经。\n翠荷闹雨做秋声。\n恁时节、不怕听。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1188,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"捣练子","author":"无名氏","text":"欺万木，怯寒时。\n倚阑初认月宫姬。\n拭新妆，披素衣。\n孤标韵，暗香奇。\n冰容玉艳缀琼枝。\n借阳和，天付伊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1189,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"捣练子","author":"无名氏","text":"心耿耿，泪双双。\n皓月清风冷透窗。\n人去秋来宫漏永，夜深无语对银缸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1190,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"捣练子 其一","author":"无名氏","text":"偏□戏，最风流。\n斗帐金猊暖不收。\n一阵蜜蜂狂絮里，酒酣眠折玉搔头。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1191,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂枝香 贺及第","author":"无名氏","text":"恩袍草色。\n望满目青青，光动阡陌。\n拂拂鞭丝散漫，锦鞯玉勒。\n君王赐与琼林宴，玩丹桂、香浮仙籍。\n舜韶清雅，尧觞泛溢，欢意何极。\n湛露久、需云未饰。\n更星使传呼，天上消息。\n槐幄阴移，上苑淡烟凝碧。\n归来渐近平康路，骤香尘、倒载连璧。\n马蹄轻驶，宫花半亸，艳欺斜日。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1192,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桂枝香 寿赵运管","author":"无名氏","text":"武夷九曲。\n甚乐响云韶，旆走星纛。\n更捧琼浆九酝，蟠桃初熟。\n元来崧岳生申旦，会群仙、献长生箓。\n岁寒堂上，冰壶影里，长跨青鹿。\n记往日、堤沙旧筑。\n有书龠金腾，勋写歌鹄。\n更化和朝，半是世臣乔木。\n明年瑞庆才经月，侍重瞳、应奉卮玉。\n此时奋建联班，却将万年齐祝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1193,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃源忆故人 贺生第二子","author":"无名氏","text":"庭槐沐雨翻新翠。\n叠雪香罗初试。\n铃响彩旗天坠。\n忽报徐卿二。\n帘帏坐客欢声沸。\n脱紫须烦半臂。\n借问月娥知未。\n速长蟾宫桂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1194,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃源忆故人 其三 蜡梅","author":"无名氏","text":"南枝向暖清香喷。\n谁付骚人词咏。\n一种陇头春信。\n不借胭脂晕。\n梢头谁把轻黄揾。\n浑似不忺施粉。\n疑是寿阳孤冷。\n染得相思病。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1195,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃源忆故人 其一","author":"无名氏","text":"园林万木凋零尽。\n惟是寒梅香喷。\n不许雪霜欺损。\n迥有天然性。\n南枝渐吐红苞嫩。\n冠绝夭桃繁杏。\n不记故人音信。\n对影成离恨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1196,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃源忆故人 其四","author":"无名氏","text":"寒苞初吐黄金莹。\n色染蔷薇犹嫩。\n枝上紫檀香喷。\n洒落饶风韵。\n南枝一种同春信。\n何事不忺朱粉。\n自称霓裳孤冷。\n怨感宫腰恨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1197,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"桃源忆故人 其二","author":"无名氏","text":"江天雪意云飞重。\n却倚阑干初冻。\n回傍小楼独拥。\n尽日无人共。\n墙梅未落春先纵。\n欲寄一枝谁送。\n月夜暗香浮动。\n似作离人梦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1198,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其六 蜡梅","author":"无名氏","text":"梅与为名蜡与容。\n寒枝偏缀小金钟。\n插时只恐鬓边熔。\n疑是佳人薰麝月，起来风味入怀浓。\n暗香依旧月朦胧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1199,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其五 茶梅","author":"无名氏","text":"剪碎红娘舞旧衣。\n汉宫妆粉满琼枝。\n东风来晚未曾知。\n颜色不同香小异，瑶台春近宴回时。\n宝灯相引素娥归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1200,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"无名氏","text":"白玉楼中白雪歌。\n更将白纻衬春罗。\n软红香里最么么。\n桃叶桃根随处有，江南江北见来多。\n风前月底奈愁何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1201,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"无名氏","text":"一副纶竿一只船。\n蓑衣竹笠是生缘。\n五湖来往不知年。\n青嶂更无荣辱到，白头终没利名牵。\n芦花深处伴鸥眠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1202,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其三","author":"无名氏","text":"十月开花是子真。\n小春分付与精神。\n折来含露晓妆新。\n暖意便从窗下见，粉容何待鉴中匀。\n宛然长似玉华清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1203,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其七 蜡梅","author":"无名氏","text":"梅与称名蜡与黄。\n枝无袅娜色无光。\n掩檀欺麝冠群芳。\n结处定缘蜂力就，开时微带蜜脾香。\n风标不减寿阳妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1204,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 题赠飞竿族","author":"无名氏","text":"谁识飞竿巧艺全。\n儿童群戏艳阳天。\n十分险处却安然。\n海燕舞空萦弱絮，岭猿连臂下层颠。\n算来真个肉飞仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1205,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其三","author":"无名氏","text":"钓罢高歌酒一杯。\n醉醒曾笑楚臣来。\n夕阳维缆碧江隈。\n蓑笠每因山雨戴，船窗多为水花开。\n安居流景任相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1206,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"无名氏","text":"水阁池亭自有凉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1207,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"无名氏","text":"春院无人花自香。\n飞来蜂蝶意何狂。\n玉钩帘卷日偏长。\n笑又不成愁未是，曲屏闲倚绣鸳鸯。\n归时应供□□妆。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1208,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其四","author":"无名氏","text":"梅粉初娇拟嫩腮。\n一枝春信腊前开。\n玉英珠颗傍妆台。\n明月泛将疏影去，暗香疑是那人来。\n消魂独自立空阶。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1209,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一","author":"无名氏","text":"水净烟闲不染尘。\n小山斜卧几枝春。\n夜寒香惹一溪云。\n粉淡朱轻妆未了，十分孤迥好精神。\n为伊清瘦却愁人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1210,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其二","author":"无名氏","text":"苒苒飞云横画阑。\n黄昏烟雨满江干。\n小梅香浅不禁寒。\n楼上风轻帘不卷，酒红销尽昼妆残。\n玉人斜捻一枝看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1211,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"无名氏","text":"北固江头浪拍空。\n归帆一夜趁秋风。\n月明初上荻花丛。\n渐入三吴烟景好，此身将过浙江东。\n梦魂先在鉴湖中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1212,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一","author":"无名氏","text":"云锁柴门半掩关。\n垂纶犹自在前湾。\n独乘孤棹夜方还。\n任使有荣居紫禁，争如无事隐青山。\n浮名浮利总输闲。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1213,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一 酴醾","author":"无名氏","text":"梦入瑶台千步芳。\n万妃相向玉为装。\n同心鞶带翠罗长。\n浓艳只宜供枕席，醉魂长是傍壶觞。\n绀纱囊薄为谁香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1214,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其四","author":"无名氏","text":"雨气兼香泛芰荷。\n回舟冒雨懒披蓑。\n夜阑风静水无波。\n白酒追欢常恨少，青山入望岂嫌多。\n人间荣辱尽从他。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1215,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 其一 武进厅壁","author":"无名氏","text":"倦客东归得自由。\n西风江上泛扁舟。\n夜寒霜月素光流。\n想得故人千里外，醉吟应上谢家楼。\n不多天气近中秋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1216,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"无名氏","text":"酒拍胭脂颗颗新。\n丹砂然火弃精神。\n暑天秋杪锦生春。\n香味已惊樱实淡，绛皮还笑荔枝皴。\n美人偏喜破朱唇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1217,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"无名氏","text":"水涨鱼天拍柳桥。\n云鸠拖雨过江皋。\n一番春信入东郊。\n闲碾凤团消短梦，静看燕子垒新巢。\n又移日影上花梢。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1218,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙","author":"无名氏","text":"遍地轻阴绿满枝。\n乍晴初试袷罗衣。\n东风院落日长时。\n鸂鶒池边飞燕子，海棠花里闹蜂儿。\n一春心事只春知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1219,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浣溪沙 蔡州瓜陂铺有用篦刀刻青泥壁为词","author":"无名氏","text":"碎剪香罗浥泪痕。\n鹧鸪声断不堪闻。\n马嘶人去近黄昏。\n整整斜斜杨柳陌，疏疏密密杏花村。\n一番风月更销魂。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1220,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令 其三","author":"无名氏","text":"村左小溪傍。\n粉黛宜芳。\n寒添潇洒冷添霜。\n清瘦几枝堪入画，竹映苔墙。\n疏影浸横塘。\n月暗浮香。\n当时曾伴寿阳妆。\n不似东君先倚槛，泄漏春光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1221,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令 其二","author":"无名氏","text":"雪里暗香浓。\n乍吐琼英。\n横斜疏影月明中。\n学傅胭脂桃与杏，虚废春工。\n素艳有谁同。\n不并妖红。\n应如褒姒笑时容。\n绝胜梨花春带雨，旖旎春风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1222,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令 其一","author":"无名氏","text":"春色入横塘。\n变尽凄凉。\n青梢弄粉雪溪傍。\n疑是化工偏著意，欲试新妆。\n玉蓓锁春藏。\n占断寒芳。\n他时鼎鼐不须忙。\n泄漏清香方有思，别是春光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1223,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令","author":"无名氏","text":"水饭恶冤家。\n些小姜瓜。\n尊前正欲饮流霞。\n却被伊来刚打住，好闷人那。\n不免着匙爬。\n一似吞沙。\n主人若也要人夸。\n莫惜更搀三五盏，锦上添花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1224,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令","author":"李清照","text":"帘外五更风。\n吹梦无踪。\n画楼重上与谁同。\n记得玉钗斜拨火，宝篆成空。\n回首紫金峰。\n雨润烟浓。\n一江春浪醉醒中。\n留得罗襟前日泪，弹与征鸿。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1225,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"浪淘沙令","author":"无名氏","text":"今日□筵中。\n酒侣相逢。\n大家满满泛金钟。\n自起自斟还自饮，一笑春风。\n传与主人翁。\n权且饶侬。\n侬今沈醉眼朦胧。\n此酒可怜无伴饮，付与诸公。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1226,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠春","author":"无名氏","text":"晓莺窗外啼春晓。\n睡未足、把人惊觉。\n翠被晓寒轻，宝篆沈烟袅。\n宿酲未解，双娥报道。\n别院笙歌宴早。\n试问海棠花，昨夜开多少。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1227,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烛影摇红","author":"无名氏","text":"乳燕穿帘，乱莺啼树清明近。\n隔帘时度柳花飞，犹觉寒成阵。\n长记眉峰偷隐。\n脸桃红、难藏酒晕。\n背人微笑，半亸鸾钗，轻笼蝉鬓。\n别久啼多，眼应不似当时俊。\n满园珠翠逞春娇，没个他风韵。\n若见宾鸿试问。\n待相将、彩笺寄恨。\n几时得见，斗草归来，双鸳微润。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1228,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"烛影摇红","author":"无名氏","text":"点点飞香，见梅知道春心透。\n怕寒不卷玉楼帘，羞与花同瘦。\n手捻青枝频嗅。\n诮冷落、蔷薇金斗。\n翻惊绿鬓，不似芳姿，年年依旧。\n才破凝酥，满园桃李看看又。\n江南幽梦了无痕，啼晕残襟袖。\n鸳被有谁温绣。\n怎敢更、十分殢酒。\n伴君独自，几个黄昏，月明时候。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1229,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"爱月夜眠迟慢","author":"无名氏","text":"禁鼓初敲，觉六街夜悄，车马人稀。\n暮天澄淡，云收雾卷，亭亭皎月如圭。\n冰轮碾出遥空，无私照临千里。\n最堪怜、有情风，送得丹桂香微。\n唯愿素魄长圆，把流霞对饮，满泛觥卮。\n醉凭栏处、赏玩不忍，辜却好景良时。\n清歌妙舞连宵，踟蹰懒入罗帏。\n任佳人、尽嗔我，爱月每夜眠迟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1230,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真珠帘","author":"无名氏","text":"病酒情怀犹困懒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1231,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真珠帘 庆游讷齐以梅为寿九月三十","author":"无名氏","text":"隔云一雁衔秋去。\n苏堤上、听得游人相语。\n疏影暗香中，谁与花为主。\n满目有山无限意。\n跨白鹤、云霄飞舞。\n飞舞。\n正断桥流水，苍苔生处。\n应羡地暖江南，近小春时节，南枝先吐。\n人似此花清，人比花尤苦。\n移向樽前须识取。\n只许与、松篁为侣。\n为侣。\n待金鼎调羹，百花红紫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1232,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真珠帘","author":"无名氏","text":"把酒祝东君，愿与花枝长为主。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1233,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"真珠髻 红梅","author":"无名氏","text":"重重山外，苒苒流光，又是残冬时节。\n小园幽径，池边楼畔，翠木嫩条春别。\n纤蕊轻苞，粉萼染、猩猩鲜血。\n乍几日，好景和风，次第一齐催发。\n天然香艳殊绝。\n比双成皎皎，倍增芳洁。\n去年因遇东归使，指远恨、意曾攀折。\n岂谓浮云，终不放、满枝明月。\n但叹息，时饮金钟，更绕丛丛繁雪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1234,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"破字令","author":"无名氏","text":"缥缈三山岛。\n十万岁、方分昏晓。\n春风开遍碧桃花，为东君一笑。\n祥飙暂引香尘到。\n祝高龄、后天难老。\n瑞烟散碧，归云弄暖，一声长啸。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1235,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秦楼月/忆秦娥 其二","author":"无名氏","text":"□□□。\n□□□□□□□。\n□□□。\n□□□□，□□□□。\n白鸥飞下屏山曲。\n行人点破秋郊绿。\n秋郊绿。\n细看重咏，怎生得足。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1236,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秦楼月/忆秦娥 其三","author":"无名氏","text":"秋漠漠。\n登临常羡东飞鹤。\n东飞鹤。\n一襟乡泪，为君双落。\n明年不负黄花约。\n故人须我归舟泊。\n归舟泊。\n荆溪亭下，晚秋寒薄。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1237,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秦楼月/忆秦娥 其四 待雪","author":"无名氏","text":"风淅淅。\n天容暗淡梅花白。\n梅花白。\n点酥凝粉，比君不得。\n清歌飞下龙沙雪。\n绮疏休印蟾宫月。\n蟾宫月。\n婵娟虽好，有时圆缺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1238,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"粉蝶儿","author":"无名氏","text":"共双双飞入，乱红深处。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1239,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"莫思归/抛球乐","author":"无名氏","text":"花满名园酒满觞。\n且开笑口对秾芳。\n秋千风暖鸾钗亸，绮陌春深翠袖香。\n莫惜黄金贵，日日须教贳酒尝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1240,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"调笑令","author":"无名氏","text":"花酒。\n满筵有。\n酒满金杯花在手。\n头上戴花方饮酒。\n饮罢了高叉手。\n琵琶拨尽相思调。\n更向当筵舞袖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1241,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"调笑集句 其三 洛浦","author":"无名氏","text":"非雾。\n花无语。\n还似朝云何处去。\n凌波不过横塘路。\n燕燕莺莺飞舞。\n风吹仙袂飘飘举。\n拟倩游丝惹住。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1242,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"调笑集句 其五 班女","author":"无名氏","text":"来见。\n蕊宫殿。\n记得随班迎凤辇。\n馀花落尽苍苔院。\n斜掩金铺一片。\n千金买笑无方便。\n和泪盈盈娇眼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1243,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"调笑集句 其八 琵琶","author":"无名氏","text":"衫湿。\n情何极。\n上下花间声转急。\n满船明月芦花白。\n秋水长天一色。\n芳年未老时难得。\n目断远空凝碧。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1244,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花","author":"无名氏","text":"春融酒困。\n一寸横波千里恨。\n著处芳菲。\n蝶与莺情醉自迷。\n敧云妥翠。\n冷落金屏山十二。\n低抱琵琶。\n月向黄昏日又斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1245,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其二 寿隐士","author":"无名氏","text":"一丘一壑。\n野鹤孤云随处乐。\n篆带纱巾。\n且与筠庄作主人。\n高山流水。\n指下风生千古意。\n寿庆年年。\n长在新秋六日前。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1246,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 十一月娶，后十一月生子","author":"无名氏","text":"向来梅发。\n雪袂仙裳回绛阙。\n今又梅开。\n已领熊罴好梦来。\n试将梅比。\n才著阳和争结子。\n梅子生成。\n早晚须调鼎鼐羹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1247,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其三","author":"无名氏","text":"山城驿近。\n又报寒梅传驿信。\n远水孤村。\n月下何人与断魂。\n幽芳在手。\n花木无情那得瘦。\n似此天真。\n好赠东阳姓沈人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1248,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其一","author":"无名氏","text":"庭梅初绽。\n风递幽香清更远。\n别有孤根。\n不待阳和一点恩。\n雪中风韵。\n皓质冰姿真莹静。\n月下精神。\n来到窗前疑是君。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1249,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花","author":"无名氏","text":"家门希差。\n养得一枚依样画。\n百事无能。\n只去篱边缠倒藤。\n几回水上。\n轧捺不翻真个强。\n无处容他。\n只好炎天㬠作巴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1250,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 其四","author":"无名氏","text":"香肌清瘦。\n泪湿轻红疏雨后。\n笑靥微开。\n宿雨微醺越女腮。\n多情无奈。\n玉管休吹帘影外。\n薄晚池台。\n惆怅繁华梦里来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1251,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"减字木兰花 寿外公","author":"无名氏","text":"祥呈香褓。\n尝记翁生当己卯。\n福禄俱添。\n绿鬓红颜七十三。\n芝兰满砌。\n争著彩衣堂下戏。\n祝寿无涯。\n王母襟期醉九霞。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":1252,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]