[{"title":"春归五首 其五","author":"朱淑真","text":"平畴交绿蔼成阴，梅豆初肥酒味新。\n门外好禽情分熟，不知春去尚啼春。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38899,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春色有怀","author":"朱淑真","text":"客里逢春想恨浓，故园花木梦魂同。\n连堤绿阴晴烟里，映水红摇薄雾中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38900,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春夜","author":"朱淑真","text":"半檐斜月人归后，一枕清风梦破时。\n无奈梨花春寂寂，杜鹃声里祇颦眉。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38901,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"雨中写怀","author":"朱淑真","text":"东风吹雨苦生寒，悭涩春光不放宽。\n万紫千红浑未见，闲愁先占许多般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38902,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春昼偶成","author":"朱淑真","text":"默默深闺掩昼关，简编盈案小窗寒。\n却嗟流水琴中意，难向人前取次弹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38903,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春宵","author":"朱淑真","text":"梦回酒醒春愁怯，宝鸭烟销香未歇。\n薄衾无奈五更寒，杜鹃叫落西楼月。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38904,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晓杂兴","author":"朱淑真","text":"挑尽残灯梦欲迷，子规催月小楼西。\n纱窗偷眼天将晓，无数宿禽花下啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38905,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春燕","author":"朱淑真","text":"帘前日暖翩翩过，帘外风轻对对斜。\n偏是社来还社去，年年不见蜡梅花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38906,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"杨柳枝","author":"朱淑真","text":"高缕千丝纤暖风，带烟笼雾市桥东。\n绾成幽恨斜阳里，折断离情细雨中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38907,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独坐感春","author":"朱淑真","text":"翠密藏鸦绿柳提，伤春懒矣步桃溪。\n梦回窗下日当午，鶗鴂一声林外啼。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38908,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜二首 其一","author":"朱淑真","text":"夜久无眠秋气清，烛花频剪欲三更。\n铺床凉满梧桐月，月在梧桐缺处明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38909,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜有感","author":"朱淑真","text":"哭损双眸断尽肠，怕黄昏后到昏黄。\n更堪细雨新秋夜，一点残灯伴夜长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38910,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又绝句","author":"朱淑真","text":"乳燕调雏出画檐，游蜂喧翅入珠帘。\n日长无事人慵困，金鸭香销懒更添。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38911,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"又绝句少年心","author":"朱淑真","text":"杨花扰乱少年心，怕雨愁风用意深。\n付与酒杯浑不管，从教天气作春阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38912,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春绝句二首 其一","author":"朱淑真","text":"自折梅花插鬓端，韭黄兰茁簇春盘。\n泼醅酒软浑无力，作恶东风特地寒。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38913,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"立春绝句二首 其二","author":"朱淑真","text":"喜胜春幡袅凤钗，新春不换旧情怀。\n草根隐绿冰痕满，柳眼藏娇雪影埋。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38914,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除日","author":"朱淑真","text":"爆竹声中腊已残，酴酥酒暖烛花寒。\n朦胧晓色笼春色，便觉春光不一般。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38915,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"圆子","author":"朱淑真","text":"轻圆绝胜鸡头肉，滑腻偏宜蟹眼汤。\n纵有风流无处说，已输汤饼试何郎。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38916,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"读史","author":"朱淑真","text":"笔头去取万千端，后世遭它恣意瞒。\n王霸谩分心与迹，到成功处一般难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38917,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄情","author":"朱淑真","text":"欲寄相思满纸愁，鱼沉雁杳又还休。\n分明此去无多地，如在天涯无尽头。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38918,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中秋闻笛","author":"朱淑真","text":"谁家横笛弄轻清，唤起离人枕上情。\n自是断肠听不得，非干吹出断肠声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38919,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"黄花","author":"朱淑真","text":"土花能白又能红，晚节由能爱此工。\n宁可抱香枝上老，不随黄叶舞秋风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38920,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寒食咏怀","author":"朱淑真","text":"淮南寒食更风流，丝管纷纷逐胜游。\n春色眼前无限好，思亲怀土自多愁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38921,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"窗西桃花盛开","author":"朱淑真","text":"尽是刘郎手自栽，刘郎去后几番开。\n东君有意能相顾，蛱蝶无情更不来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38922,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"答求谱","author":"朱淑真","text":"雨好解开花百结，风恬扶起柳三眠。\n春醲酽处多伤感，那得心情事管弦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38923,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"愁怀二首 其一","author":"朱淑真","text":"鸥鹭鸳鸯作一池，须知羽翼不相宜。\n东君不与花为主，何似休生连理枝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38924,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"愁怀二首 其二","author":"朱淑真","text":"满眼春光色色新，花红柳绿总关情。\n欲将郁结心头事，付与黄鹂叫几声。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38925,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"新秋","author":"朱淑真","text":"一夜凉风动扇愁，背时容易入新秋。\n桃花脸上汪汪泪，忍到更深枕上流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38926,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"端午","author":"朱淑真","text":"纵有灵符共綵丝，心情不似旧家时。\n榴花照眼能牵恨，强切菖蒲泛酒卮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38927,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"九日","author":"朱淑真","text":"去年年月愁何限，重上心来益断肠。\n秋色夕阳俱淡薄，泪痕离思共凄凉。\n征鸿有阵全无信，黄菊无情却有香。\n自觉近来清瘦了，懒将鸾镜照容光。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38928,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"中春书事","author":"朱淑真","text":"乍暖还寒二月天，酿红酝绿斗新鲜。\n日烘春色成和气，风弄花香作瑞烟。\n莺舌似簧初学语，柳条如线未飞绵。\n金杯满酌黄封酒，欲劝东君莫放权。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38929,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"元夜三首 其三","author":"朱淑真","text":"火独银花触目红，揭天鼓吹闹春风。\n欣欢入手愁忙里，旧事惊心忆梦中。\n但愿暂成人缱绻，不妨常任月朦胧。\n赏灯那得工夫醉，未必明年此会同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38930,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"代送人赴召司农","author":"朱淑真","text":"当年持节使，宽厚出诚心。\n郡国承风远，朝廷注意深。\n十行初下诏，四海望为霖。\n几夜台星转，光侵九棘林。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38931,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬日离咏","author":"朱淑真","text":"爱日温温正涤场，老农击壤庆时康。\n水催舂韵捣残雨，风急耞声带夕阳。\n霜瓦晓寒欺酒力，月栏夜冷动诗肠。\n厌厌对景无情绪，谩把梅花取次妆。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38932,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"冬至","author":"朱淑真","text":"黄钟应律好风吹，阴伏阳升淑气回。\n葵影便移日长至，梅花先趁小寒开。\n八神表日占和岁，六琯飞葭动细灰。\n已有岸旁迎腊柳，参差又欲领春来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38933,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伤别二首 其一","author":"朱淑真","text":"览镜惊容却自嫌，逢春长尽病恹恹。\n吹花弄粉新来懒，惹恨供愁旧日添。\n生怕子规声到耳，苦羞双燕影穿帘。\n眉头眼底无他事，须信离情一味严。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38934,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"伤春","author":"朱淑真","text":"阁泪抛诗卷，无聊酒独亲。\n客情方惜别，心事已伤春。\n柳暗轻笼日，花飞半掩尘。\n莺声惊蝶梦，唤起旧愁新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38935,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"次韵见赠兼简吴夫人","author":"朱淑真","text":"南北常嗟见未因，停舟今喜笑谈亲。\n张姬淑德同冰玉，李白高吟泣鬼神。\n和管幸听鸣凤侣，滥竽还愧赏音人。\n佳篇奖拂还过实，班卫声名岂易伦。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38936,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"灯花","author":"朱淑真","text":"兰釭和气散氤氲，忽作元珠吐穗新。\n膏脉破芽非藉手，敷芳成艳不关春。\n疑猜海角天涯事，搅乱衾寒枕冷人。\n我欲生怜心燄上，何妨好客致清贫。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38937,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初冬书怀","author":"朱淑真","text":"触目园池景，荷枯菊已荒。\n风寒侵夜枕，霜冻怯晨妆。\n江上枫翻赤，庭前橘带黄。\n题诗欲排闷，对景倍悲伤。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38938,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"初夏二首 其一","author":"朱淑真","text":"枝上浑无一点春，半随流水半随尘。\n柔桑欲椹吴蚕老，稚笋成竿綵凤驯。\n荷嫩爱风攲盖翠，榴花宜日皱裙殷。\n待封一?伤心泪，寄与南楼薄倖人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38939,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和前韵见寄 其一","author":"朱淑真","text":"忽得南来信，殷勤慰我心。\n新诗怜后逸，清论忆容音。\n目断乡程远，楼高客恨深。\n三年重会合，依旧见荆阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38940,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"和前韵见寄 其二","author":"朱淑真","text":"忆昔江头别，相看对古津。\n去来分橹棹，南北隔音尘。\n把酒何时共，论文几日亲。\n归宁知有约，綵服共争新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38941,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恨春五首 其二","author":"朱淑真","text":"一瞬芬菲尔许时，苦无佳句纪相思。\n春光正好须风雨，恩爱方深奈别离。\n泪眼谢他花缴抱，愁怀惟赖酒扶持。\n莺莺燕燕休相笑，试与单栖各自知。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38942,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恨春五首 其三","author":"朱淑真","text":"病酒厌厌日正高，一声啼鸟在花梢。\n惊回好梦方萌蕊，唤起新愁却破苞。\n暗把后期随处记，闲将清恨倩诗嘲。\n从今始信恩成怨，且与莺花作淡交。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38943,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恨春五首 其四","author":"朱淑真","text":"迟迟花日上帘钩，尽日无人独倚楼。\n蝶使蜂媒传客恨，莺梭柳线织春愁。\n碧云信断惟劳梦，红叶成诗想到秋。\n几许别离多少泪，不堪重省不堪流。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38944,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"恨春五首 其五","author":"朱淑真","text":"一篆烟消系臂香，闲看书册就牙床。\n莺声冉冉来深院，柳色阴阴暗画墙。\n眼底落红千万点，脸边新泪两三行。\n梨花细雨黄昏后，不是愁人也断肠。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38945,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日书怀","author":"朱淑真","text":"从宦东西不自由，亲帏千里泪长流。\n已无鸿雁传家信，更被杜鹃追客愁。\n日暖鸟歌空美景，花光柳影谩盈眸。\n高楼惆怅凭阑久，心逐白云南向浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38946,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日有作","author":"朱淑真","text":"景近清明节，垂杨翠缕长。\n塞鸿归朔漠，海燕度潇湘。\n花丽繁争锦，莺娇巧转簧。\n西园正明媚，收拾入吟乡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38947,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日杂兴","author":"朱淑真","text":"窈窕风光艳艳春，无言桃李一番新。\n青回野烧草初染，光泛幽香兰可纫。\n官柳欲眠多态度，海棠贪睡足精神。\n旧游似梦浑情懒，对景无聊愁杀人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38948,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日即事","author":"朱淑真","text":"轻寒噤㾕花期晚，皱绿差鳞接远波。\n跃藻白鱼翻玉尺，穿林黄鸟度金梭。\n闲将诗草临轩读，静听渔船隔岸歌。\n尽日倚窗情脉脉，眼前无事奈春何。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38949,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春日感怀","author":"朱淑真","text":"寂寂多愁客，伤春二月中。\n惜花嫌夜雨，多病怯东风。\n不奈莺声碎，那堪蝶梦空。\n海堂方睡足，帘影日融融。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38950,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春半","author":"朱淑真","text":"拭目凭阑久，柔风拂面吹。\n莺花争妩媚，诗酒斗清奇。\n已近清明节，初过上巳时。\n莫萦寻俗事，随意乐春熙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38951,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春阴古律二首 其一","author":"朱淑真","text":"薄云笼日弄轻阴，试与诗工略话春。\n蠢蠢绿杨初学线，茸茸碧草渐成茵。\n园林深寂撩私恨，山水昏明恼暗颦。\n芳意被他寒约住，天应知有惜花人。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38952,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春阴古律二首 其二","author":"朱淑真","text":"陡觉湘裙剩带围，情怀常是被春欺。\n半檐落日飞花后，一阵轻寒微雨时。\n幽谷想应莺出晚，旧巢应怪燕归迟。\n间关几许伤怀处，悒悒柔情不自持。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38953,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春园小宴","author":"朱淑真","text":"春园得对赏芳菲，步草黏鞋絮点衣。\n万木初阴莺百转，千花乍拆蝶双飞。\n牵情自觉诗毫健，痛饮惟优酒力微。\n穷日追欢欢不足，恨无为计锁斜晖。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38954,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词二首 其一","author":"朱淑真","text":"屋嗔柳叶噪春鸦，帘幕风轻燕翅斜。\n芳草池塘初梦断，海棠庭院正愁加。\n几声娇巧黄鹂舌，数朵柔纤小杏花。\n独倚庄窗梳洗倦，只惭辜负好年华。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38955,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春词二首 其二","author":"朱淑真","text":"屈指清明数日期，纷纷红紫竞芳菲。\n池塘水暖鹣鹣并，巷陌风轻燕燕飞。\n柳带万条笼淑景，游丝千尺网晴晖。\n人间何处无春色，祇是西楼人未归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38956,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春晴","author":"朱淑真","text":"日暖风和明媚天，最宜吟咏入诗篇。\n庭花吐蕊红如锦，岸柳飞丝白似锦。\n深院雕梁巢燕返，高林乔木谷莺迁。\n韶光正近清明节，花坞楼台酒旆悬。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38957,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春游西园","author":"朱淑真","text":"闲步西园里，春风明媚天。\n蝶疑庄叟梦，絮忆谢娘联。\n踏草青茵软，看花红锦鲜。\n徘徊月影下，欲去又依然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38958,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春睡","author":"朱淑真","text":"午窗春睡足，推枕起来时。\n瘦怯罗衣褪，慵妆鬓影垂。\n旧愁消不尽，新恨忽相随。\n有蝶传魂梦，无鸿寄别离。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38959,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"春霁","author":"朱淑真","text":"淡薄轻寒雨后天，柳丝无力带朝烟。\n弄晴莺舌于中巧，著雨花枝分外妍。\n消破旧愁冯酒盏，去除新恨赖诗篇。\n年年来到梨花月，瘦不胜衣怯杜鹃。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38960,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"独坐","author":"朱淑真","text":"捲帘待明月，拂槛对西风。\n夜气涵秋色，瑶河浸碧空。\n草根鸣蟋蟀，天外叫冥鸿。\n几许旧时事，今宵谁与同。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38961,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"秋夜牵情三首 其一","author":"朱淑真","text":"纤纤新月挂黄昏，人在幽闺欲断魂。\n笺素拆封还又改，酒杯慵举却重温。\n灯花占断烧心事，罗袖长供挹泪痕。\n益悔风流多不足，须知恩爱是愁根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38962,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"贺人移学东轩","author":"朱淑真","text":"一轩潇洒正东偏，屏弃嚣尘聚简编。\n美璞莫辞彫作器，涓流终见积成渊。\n谢班难继予惭甚，颜孟堪睎子勉旃。\n鸿鹄羽仪当养就，飞腾早晚看冲天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38963,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜","author":"朱淑真","text":"穷冬欲去尚徘徊，独坐频斟守岁杯。\n一夜腊寒随漏尽，十分春色破朝来。\n桃符自写新翻句，玉律谁吹定等灰。\n且是作诗人未老，换年添岁莫相催。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38964,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"除夜","author":"朱淑真","text":"休叹流光去，看看春欲回。\n椒盘卷红烛，柏酒溢金杯。\n残腊馀更尽，新年晓角催。\n争先何物早，唯有后园梅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38965,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"海棠","author":"朱淑真","text":"胭脂为脸玉为肌，未赴春风二月期。\n曾比温泉妃子睡，不吟西蜀杜陵诗。\n桃羞艳冶愁回首，柳妒妖娆祇皱眉。\n燕子欲归寒食近，黄昏庭院雨丝丝。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38966,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄大人二首 其一","author":"朱淑真","text":"去家千里外，飘泊若为心。\n诗诵南陔句，琴歌陟岵音。\n承颜故国远，举目白云深。\n欲识归宁意，三年数岁阴。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38967,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄大人二首 其二","author":"朱淑真","text":"极目思乡国，千山更万津。\n庭闱劳梦寐，道路厌埃尘。\n诗礼闻相远，琴樽谁是亲。\n愁看罗袖上，长揾泪痕新。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38968,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}},{"title":"寄恨","author":"朱淑真","text":"如毛细雨蔼遥空，偏与花枝著意红。\n人自多愁春自好，天应不语闷应同。\n吟笺谩有千篇苦，心事全无一点通。\n窗外数声新百舌，唤回杨柳正眠中。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_1.csv","pointer":38969,"sha256":"18413bf73b9d113baa963a97950b84db1032d48e773bb7501dd506c738b4292a","dynasty":"宋"}}]