[{"title":"送汉卿再判池州","author":"赵公豫","text":"阀阅清华自职方，长才重莅古池阳。\n刑曹借箸邀宸眷，秋浦分符定庙堂。\n熊辂声闻舒骥足，朱旗色映快龙光。\n公馀寄兴耽文字，彩笔仍流翰墨香。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24892,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"喜范茂明至","author":"赵公豫","text":"兰陵江下富春连，三色桃花色泽鲜。\n夜雨忽然添尺涨，晓寒犹可著重绵。\n轻囊括尽烟霞趣，逸兴吟成风月篇。\n太息尘氛京雒客，谁能潇洒得安禅。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24893,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"徐孺子祠墓","author":"赵公豫","text":"孺子遗踪何处寻，进贤门外树森森。\n登堂展拜情维系，过墓倾心敬自深。\n剩有黄鹂鸣院落，还来云影覆山阴。\n章江积雨增愁思，此日新晴爽客襟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24894,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"吕梁洪","author":"赵公豫","text":"吕梁篱落走鸡豚，小泊扁舟日已昏。\n极目黄流来汴泗，有情明月匝烟村。\n堤长柳密巢归鸟，水急风高浪打门。\n此去彭城知不远，凭今吊古我思存。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24895,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"戏马台","author":"赵公豫","text":"戏马台边风色寒，黄河昼夜水瀰漫。\n椎心每恨英雄尽，放眼还知天地宽。\n宴设鸿门王气在，烟销秦阙霸图残。\n知几亚父身先死，不见阴陵行路难。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24896,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"同鲍祗登醉翁亭看欧阳公手植梅花","author":"赵公豫","text":"欧亭犹在望，梅萼自芬芳。\n地以人为重，花为植者香。\n山峰皆拱列，石骨尽昂藏。\n文采风流事，参军独擅场。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24897,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"上巳","author":"赵公豫","text":"芜城逢上巳，散步答年光。\n北郭垂杨媚，西郊碧草芳。\n人皆趋靡丽，我独恋春阳。\n更爱双飞燕，翩翩语画梁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24898,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"浮梁舟行","author":"赵公豫","text":"一棹沿溪上，沙明水更清。\n迷濛细雨湿，起落片帆轻。\n磐石中流出，新篁远岸生。\n客心无所系，閒坐听春莺。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24899,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祁门驳","author":"赵公豫","text":"舟小名为驳，临河体实轻。\n扪滩鱼贯上，放溜雁行行。\n云气仙山静，风声远树鸣。\n时和春又暮，旷览可娱情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24900,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"黄冈","author":"赵公豫","text":"黄冈临古岸，依谷尽人家。\n老稚崇清俭，衣冠鄙俗华。\n花香幽径僻，鸟噪夕阳斜。\n俯仰情何寄，烟霞自足誇。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24901,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"滕王阁","author":"赵公豫","text":"佳名由帝子，千载尚馀芳。\n带水来章贡，群山拥豫章。\n楼台誇壮丽，鱼鸟焕清光。\n粉壁多词翰，风流孰擅长。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24902,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"望庐山","author":"赵公豫","text":"庐山何峻极，一望尽苍清。\n不辨松杉色，谁闻钟磬声。\n飞崖悬瀑布，幽谷语春莺。\n堪羡岩栖士，空馀人世情。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24903,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大孤山","author":"赵公豫","text":"客路将几月，舟行见大孤。\n时和花烂熳，景淑鸟飞呼。\n径有烟霞气，村无市井夫。\n旷观多乐趣，何事苦嗟吁。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24904,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"陪钱塘马先生游两峰僧寺","author":"赵公豫","text":"两峰舟少阻，精舍可桥通。\n竹映阶苔绿，桃侵佛幔红。\n心萦章贡外，情寄笑谈中。\n坐久愁烦渴，供茶爱远公。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24905,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冷泉亭","author":"赵公豫","text":"泉不因人热，渊源自古今。\n名流耽韵致，智士悦清音。\n径有烟霞趣，亭无鸟鼠侵。\n浮生徒碌碌，谁自涤凡心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24906,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"岑山","author":"赵公豫","text":"山踞浙流顶，波声耸独尊。\n帆樯移野浦，钟磬出烟村。\n脩竹凉风咽，巨鱼暑气吞。\n层巅一矫首，海面见云根。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24907,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"谒伍大夫庙","author":"赵公豫","text":"策马昭关道，投鞭吊昔贤。\n荒庭多鼠雀，古屋饱云烟。\n覆楚勋劳浅，强吴智略全。\n英雄精爽在，瞻拜一凄然。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24908,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"邗上闻莺","author":"赵公豫","text":"邗堤芳草软如绵，夭桃媚柳何娟娟。\n朱栏绣阁依山巅，万仞巍巍直接天。\n坐卧其中似画船，开帘俯视小百川。\n牙樯锦缆泊江边，红颜放棹来翩跹。\n歌音缭绕落花前，倾耳听之清且圆。\n仓庚飞翮羽毛鲜，娇啼婉转极清妍。\n高风盛德颂前贤，徘徊胜事堪流连。\n君不见吴歌楚舞变桑田，雄图霸业沉深渊，黄鹂睍睆迷村烟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24909,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桃花","author":"赵公豫","text":"亭亭一树灿窗前，气暖风和分外妍。\n何必桃源寻异处，此间谈笑亦神仙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24910,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哀吕东莱 其一","author":"徐安国","text":"师友曾亡几，南轩足旧闻。\n严陵忻请益，荆渚黯临分。\n恸哭情方切，招魂志愈勤。\n幡然均地下，应与共修文。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24911,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"哀吕东莱 其二","author":"徐安国","text":"感涕门阑旧，由来岂苟然。\n茶山参活法，婺女拾残编。\n记录书犹在，忘言意已传。\n续灯身后事，先是有同年。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24912,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题洪氏浴室院","author":"徐安国","text":"斗横宴坐一蒲团，丈室寥寥梦境寒。\n夜炷波涵烟易冷，秋檐冰浸露先漙。\n潭中寂境心灰见，镜里虚形面壁观。\n俛仰清光无尽藏，细分沙界万尘宽。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24913,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登古钵岭谒慈感祠下","author":"徐安国","text":"郡岭中推古钵尊，山川罗列掌中存。\n亭台突兀圣婆庙，邱垤逶迤山子村。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24914,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"宝华山","author":"徐安国","text":"秀出城南号宝华，翠微深处衲僧家。\n百年台殿归煨烬，一径苍苔落晚花。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24915,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"横州龙池","author":"徐安国","text":"为谷为陵事已非，灵源汇泽发光辉。\n有时风雨连村暗，夜半龙游古钵归。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24916,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"横浦","author":"徐安国","text":"暑风披拂瘴烟收，独倚危楼豁远眸。\n万叠山围城堞古，一湾江抱海槎浮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24917,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"妙庭观 其一","author":"徐安国","text":"玉笙声绝瑶池杳，桂殿风生几度寒。\n空使时人慕鸡犬，扫除槃鼎舐遗丹。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24918,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"妙庭观 其二","author":"徐安国","text":"云軿不许折铛追，太白遗诗人亦疑。\n千载何人为湔拂，谢家春草又生池。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24919,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"妙庭观 其三","author":"徐安国","text":"槐覆星坛惟旧迹，土埋丹鼎不知时。\n刻舟何处长生路，回音海山空赋诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24920,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"大涤洞","author":"徐安国","text":"大涤山藏碧玉函，神龙护穴虎驯岩。\n华阳邃道通仙处，始见元同骨不凡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24921,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石床","author":"徐安国","text":"枯藤老大似虬悬，一榻留云对洞门。\n无复高人眠醉石，空留芳草引王孙。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24922,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"登舟","author":"徐安国","text":"廛市尘埃苦没头，霜晴清兴动林丘。\n买舟迤逦穷观览，载酒从容作拍浮。\n山远眼随飞鸟入，溪清身与戏鱼游。\n遥观九曲山如锁，说与篙人缓放舟。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24923,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"道院","author":"徐安国","text":"斋馀深炷一炉香，宴坐怡神阅宝章。\n夜静沉沉天籁息，步虚声起月回廊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24924,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"天坛","author":"徐安国","text":"峨峨大涤拄天寒，白鹿来迎上界官。\n挹景太霄千载后，犹思冠佩上天坛。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24925,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"放水涧","author":"徐安国","text":"一涧无人测水源，闸开石面泻奔湍。\n建瓴已自惊凡目，机锦那铺涧底看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24926,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归云洞","author":"徐安国","text":"百里周回□盖天，回车尽指后门旋。\n悠然一片云飞晚，指点归来沙苑仙。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24927,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"云根","author":"徐安国","text":"出岫俄生一片阴，拄筇行到水穷寻。\n千年留得深根在，盘古埋藏古涧心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24928,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"药圃","author":"徐安国","text":"满山绿叶与红英，琼圃皆由种植荣。\n翻笑无人继真迹，灵芝惟望自天成。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24929,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"白茅洞","author":"徐安国","text":"凿石成壶不记年，洞门如井忽升仙。\n轩然笞凤鞭鸾客，翻作醯鸡舞瓮天。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24930,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"驯虎岩","author":"徐安国","text":"害物无如猛兽雄，惧心不起兽难从。\n能探虎口同儿戏，异类从兹不见踪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24931,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"龙洞","author":"徐安国","text":"泉脉潜深贯海湫，阴霾晴雹四时秋。\n凭谁为探骊龙睡，好把灵珠颔下求。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24932,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"凤洞","author":"徐安国","text":"帝遣持将紫诏来，山前九锁一时开。\n洞天绝境胜阿阁，览德飞翔日几回。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24933,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"无骨箬","author":"徐安国","text":"三足碧蝉岩下见，千年丹鼎地中开。\n故令绀箬生无骨，要表真仙蜕骨来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24934,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"祥光亭","author":"徐安国","text":"地藏金玉自通灵，草木英华发粹精。\n朮坞芝畦化琼圃，祥光终日满山明。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24935,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"翠微亭","author":"徐安国","text":"拄上风烟脚力顽，华亭深入翠微寒。\n千岩万壑争呈秀，独指中峰一柱看。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24936,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石室","author":"徐安国","text":"编茅结屋附琳宫，索价何高少室同。\n妙黑流传天上去，一山松竹独吟风。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24937,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"清音亭","author":"徐安国","text":"山川无古亦无今，只在游人得趣深。\n洗耳屏除筝与笛，来贤几个是知音。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24938,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"冷泉亭","author":"徐安国","text":"道人心迹已双清，更挹寒泉涤俗情。\n徙倚虚亭无一事，笑予尘土满冠缨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24939,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石门","author":"徐安国","text":"神刻鬼凿石为门，九锁回环隐帝阍。\n斸药采芝寻古路，清泉能漱乌能言。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24940,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"舞翠阁","author":"徐安国","text":"涧边蟠木岁时深，更著华亭倚翠阴。\n风下四山蛟起舞，洞中搅动蛰龙心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24941,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"归云庵","author":"徐安国","text":"忽舒忽卷岂无期，万状来呈变化姿。\n峰帽石衣罗眼底，苍然暮色欲来时。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24942,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题洪氏浴室院","author":"徐安国","text":"百念灰寒一性空，森然万象在其中。\n静观寂照衔沙界，翻笑空华翳化宫。\n金屑未除心境异，尼珠独耀古今同。\n个中有见非真见，未掩帘时妙无穷。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24943,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"徐安国","text":"古辣觞客醉，宝华镌句清。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24944,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"徐安国","text":"出郭扶筇上翠屏，却从云隙望莎城。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24945,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"次杨咸亨江郊亭新成二十三韵","author":"单夔","text":"瞿塘一门江水倾，群趋激射随奔鲸。\n舟车冠盖凑蜀道，孰问张丈联殷兄。\n相逢来往问地主，太守讵敢忘将迎。\n白崖候馆久茅蕝，近即野处披榛荆。\n屏修启剔作庐舍，夙戒里旅迟留行。\n有如绶馆及郊劳，举国定制谁先鸣。\n钱塘鄙人何所似，抵掌自视鸿毛轻。\n食焉抑畏堕偷懦，汎观彼己同虚盈。\n山溪水浒肆登赏，靡识杰阁誇峥嵘。\n朋从簪盍得众隽，麈谭冰释欣初晴。\n鼎新赞我筑斯馆，栋宇不贵朱连甍。\n入门便足庇风雨，揭榜却借江郊名。\n时哉莲幕有嘉客，落笔能令风雨惊。\n联篇累牍溢我目，粲花丽藻舒我情。\n人生悟合良快意，胡为四美嗟难并。\n日光天际发丰蔀，此去可并依离明。\n直排阊阖出滟滪，肃肃东首歌宵征。\n循崖履坦竟无阻，为君留取能诗声。\n此榜与诗傥不朽，此馆想同江水清。\n我来岁月愧销缩，整缨辑屦图归程。\n遗名肯复计身后，谨愿第虞槃水擎。\n始终感慨遇僚友，遂事且喜相须成。\n勉旃功业早期就，发轫自是天衢亨。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24946,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽崔舍人 其一","author":"陈苍舒","text":"早结渊衷眷，英名擅四方。\n献箴诚剀切，屡谏极忠良。\n劝讲黄金殿，修辞白玉堂。\n簪绅歆盛美，何事遽云亡。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24947,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"挽崔舍人 其二","author":"陈苍舒","text":"昔宰金渊日，获从二陆游。\n同朝深自喜，投袂意相稠。\n□□方惊殁，公乎遽若休。\n佳城知有日，老泪洒西州。","collection":"宋","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24948,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"题店壁","author":"董风子","text":"太乙元君遇虎龙，沉沉三洞锁青风。\n自从九九朋分了，白发黄金黑变红。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24949,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"石芥","author":"梁安世","text":"撷根山石贮瓶罂，柱后缄题见者赪。\n风味莫嫌无酝藉，杯柈亦解作聪明。\n愿言则嚏传心事，搔首踌蹰散宿酲。\n最是徂徕明道地，至今奸胆亦魂惊。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24950,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"张相公祠","author":"梁安世","text":"五湖烟浪渺难寻，有像区区欲铸金。\n试问铁胎身后事，何如羽扇用时心。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24951,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"桂林","author":"梁安世","text":"列城二十五，去国一百舍。\n西夷蚁穴通，南岛鲸波驾。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24952,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"赠王锡老","author":"梁安世","text":"审斋先生世稀有，曾是金陵一耆旧。\n万卷胸中星斗文，百篇笔下龙蛇走。\n渊源更擅麟史长，碑版肯居鳄文后。\n倚马常摧鏖战场，脱腕难供扫愁帚。\n中州文献儒一门，异县萍蓬家百口。\n恨极黄杨厄闰年，閒却玉堂挥翰手。\n夜光乾没世称屈，远枳卑栖价低售。\n漂摇何地著此翁，忘忧夜醉长沙酒。\n岂无厚禄故人来，为办草堂留野叟。\n嗟余亦是可怜人，惭愧阿戎惊白首。\n一灯续得审斋光，多少达人为裔胄。\n眷予憔悴五峰下，频寄篇来复相寿。\n年来事事淋过灰，尚有诗情閒情窦。\n有时信笔不自置，忆起居家吕窠臼。\n审斋乐府似花间，何必老夫疥篇右。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24953,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"双溪二首 其一","author":"梁安世","text":"春霖涨合两溪平，雪浪中浮桑柘青。\n南市唤船撑未到，一番蓑笠满津亭。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24954,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"双溪二首 其二","author":"梁安世","text":"岸高平步远汀沙，落木梢头点乱鸦。\n舞动双龙金锁甲，兰皋影外晚红斜。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24955,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"秦碑一纸并古诗呈王梅溪太守","author":"梁安世","text":"公生博物好奇古，劝我搜求秦望碑。\n我来稽阴且三载，梦寐绝顶云俱驰。\n事非近代问父老，鼻祖已来犹不知。\n或云其山多虎狼，渊湫罅井蟠蛟螭。\n魍魉木客忌人到，阴霾贼雾迷羊歧。\n樵夫悬磴惧失势，一落万丈谁能支。\n吾意此如钟乳穴，民昔畏扰相诪欺。\n曩时山东之罘石，磅砰入海无津涯。\n固知秦人游戏馀，非民之利宁一时。\n暇日登临云门寺，僧曰若耶溪上奇。\n山曰何山势最峻，丹鹤夜宿天孙枝。\n南望天台西钱唐，下视峰岫如群儿。\n李斯篆书真刻本，昔人避乱此见之。\n裹粮遂偕墨工往，扳崖贯木如鹿麋。\n举觞酹酒山之神，千古呵护烦神司。\n销铄仅存三尺许，龟趺就凿山石为。\n剜苔剔藓随手剥，面节背角摧霜皮。\n老龙脱甲蛇解蜕，铺纸拭墨漫披离。\n收藏入袖恍若失，遐想往昔还嗟咨。\n我闻太古功德盛，铺写不尽乾坤仪。\n诗书纸上自不朽，金石还有磨灭期。\n秦皇不慕仁义业，直谓尧舜犹瑕疵。\n焚书欲盖前代美，宁闻伏生传有颐。\n后生不废丞相书，歌颂虽在皆浮辞。\n惜哉此纸无一画，欲记存亡人应嗤。\n他年好事继追访，姑愿首尾观吾诗。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24956,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其一","author":"梁安世","text":"更说此州异特事，寇公归后二苏来。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24957,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其二","author":"梁安世","text":"岁次属金知稔熟，木头点土验滂沱。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24958,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其三","author":"梁安世","text":"蕃马步衔青苜蓿，羌儿卧唱白铜鞮。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24959,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}},{"title":"句 其四","author":"梁安世","text":"直令万乘高凡眼，不道人间例是贪。","collection":"宋","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"宋_4.csv","pointer":24960,"sha256":"1b045fa2dd3ab3468e9fdf6659b7a150090f60cf8115e7a4663c55b017b46066","dynasty":"宋"}}]