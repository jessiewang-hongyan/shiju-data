[{"title":"送李子庚之金陵","author":"刘基","text":"舍下微波涌碧鳞，湖边草色可怜人。\n也知使者徵书急，莫厌轻舟出郭频。\n春酒盈釭清似水，时鱼带子白于银。\n山桃野杏能红紫，醉眼相看意自真。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3693,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵追和音上人","author":"刘基","text":"绝顶浮云锁石关，曲途危磴阻跻攀。\n他年甲楯孤臣泣，此日斋钟老衲闲。\n夜永星河低半树，天清猿鹤响空山。\n干戈未定归无处，拟结茅庐积翠间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3694,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"二月二日登楼作","author":"刘基","text":"薄寒疏雨集春愁，愁极难禁独上楼。\n何处山中堪采药，几时湖上好乘舟。\n衔泥客燕聊相傍，泛水浮萍可自由。\n见说兰亭依旧在，于今王谢少风流。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3695,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"发绍兴至萧山","author":"刘基","text":"落日牛羊下绿坡，微风短楫拂晴莎。\n穷愁白发真相得，悲感青春最苦多。\n水暖菰蒲沙鸨集，月明洲渚榜人歌。\n此时忽漫思身世，柰尔桃花满眼何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3696,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宿蜡烛庵俊上人房","author":"刘基","text":"城外春江动客愁，江边细草绿悠悠。\n还将短发临岐路，畏向东风忆旧游。\n斜日远天归雁急，薄寒孤馆落花稠。\n青灯不放还乡梦，一夜肠回一万周。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3697,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"二月七日夜泊许村遇雨","author":"刘基","text":"漫喜晴天出北门，还愁急雨送黄昏。\n山风度水喧林麓，野树翻云动石根。\n宿麦巳随江草烂，新泉休共井泥浑。\n鱼龙浩漫沧溟阔，泽畔谁招楚客魂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3698,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感怀二首 其一","author":"刘基","text":"新晴杨柳散春丝，长路行人有所思。\n愁上容颜青镜识，寒生亭馆落花知。\n高云送雨来无定，独鸟惊风去自迟。\n闷对亭前紫荆树，同根那得却相离。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3699,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄台郎张质夫","author":"刘基","text":"春愁忽得故人书，喜极成悲泪满裾。\n冀野驽骀虚伯乐，鲁门钟鼓骇爰居。\n全家荡析饥寒切，病骨支离志虑疏。\n敢以浮名误知己，缄辞写意愧何如。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3700,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"水西寺东楼晓起闻莺","author":"刘基","text":"日上高城柳影齐，风轩临水看莺啼。\n初来木杪鸣相应，稍入花间听却迷。\n芳草自深句践国，行人犹隔禦儿溪。\n思家每恨无轻翼，可对莺华不憯悽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3701,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"茶园别朱伯言郭公葵","author":"刘基","text":"细水吹烟送客舟，离情恰似水东流。\n此时对酒难为乐，何处寻春可纵游。\n去雨来云天渺渺，轻蜂乱蝶日悠悠。\n绝怜短发无聊赖，一夜如丝白满头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3702,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚泊海宁州舟中作","author":"刘基","text":"春雾今宵气稍清，空江一舸客心惊。\n东流浊浪冲山动，西望长庚似月明。\n不有龚黄为郡县，徒令耒耜化戈兵。\n溥天何处非王土，无地安身愧此生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3703,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春兴七首 其二","author":"刘基","text":"勿听屋角闹晨鸠，起看园林绿渐稠。\n小雨霏霏涵日过，新泉细细入河流。\n残花断柳虚归计，远水他山聚客愁。\n鸿雁南飞限苍岭，伤心何处问松楸。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3704,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春兴七首 其六","author":"刘基","text":"深春积雨感年芳，暮馆轻寒透客裳。\n翠柳条柔先改色，紫兰花冷不飘香。\n山中虎豹人烟少，海上楼台蜃气长。\n燕子新来畏沾湿，一双相对立空梁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3705,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春兴七首 其七","author":"刘基","text":"忆昔江南未起兵，吴山越水共知名。\n蘋萍日暖游鱼出，桃李风和乳燕鸣。\n紫陌尘埃嘶步景，画船歌管列倾城。\n于今征戍诛求尽，翻对莺花百感生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3706,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"萧山山行","author":"刘基","text":"积雨今朝天气佳，山亭晓色上林花。\n未须汗漫思身世，且可逍遥玩物华。\n偶值断桥妨去路，却随脩竹到邻家。\n篱边野鸭惊人过，拨剌飞鸣落远沙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3707,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"普济寺遣怀","author":"刘基","text":"江上西风一叶黄，莎鸡络纬满丛篁。\n物华乘兴看都好，时序逢愁速不妨。\n露下星河光潋滟，月明岩谷气清凉。\n愿闻四海销兵甲，早种梧桐待凤凰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3708,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题水墨蓼花草虫","author":"刘基","text":"为爱江头红蓼花，秋来独作草虫家。\n寻香粉蝶应随梦，采蜜黄蜂不趁衙。\n络纬语残凉露滴，蜻蜓立困晚风斜。\n画图水墨惊初见，却似扁舟过赤沙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3709,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题山水图为宝林衍上人作","author":"刘基","text":"雨过秋山日欲暾，白云如雪拥山根。\n高松浥露和烟冷，迸水穿沙出谷浑。\n拟向萝阴缘石径，却寻花片入桃源。\n画图应有通神处，他日相从子细论。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3710,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再用韵荅严衍二上人","author":"刘基","text":"负郭无田生事疏，微官巳谢不须除。\n散愁漫入高僧舍，乘兴还过野老居。\n草冷虫声悲杼轴，霜馀蕉叶碎缄书。\n黄花素发相将暮，独立凄凉忆往初。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3711,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和新罗严上人秋日见寄二首 其二","author":"刘基","text":"爱汝精蓝抱翠微，青松绿竹共依依。\n龟台落日明霞绮，鳗井寒潮长石衣。\n银杏子成边雁到，木犀花发野莺飞。\n钟残永夜禅心定，一任秋虫促杼机。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3712,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重用韵荅严上人 其一","author":"刘基","text":"坐见风霜百草疏，却怜光景渐消除。\n萍蓬飘荡三年客，松菊荒凉五亩居。\n陋巷苍苔封蚁垤，空庭黄叶带虫书。\n江枫恰似知人意，强学芳菲二月初。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3713,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重用韵荅严上人 其二","author":"刘基","text":"江水东流西日微，闲身不系独何依。\n尘埃爽飒枯蓬鬓，霜露凄凉破衲衣。\n百粤雨馀山翠合，三韩云净海青飞。\n沧溟自古通天汉，梦绕黄姑织女机。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3714,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"仍用韵酬衍上人 其一","author":"刘基","text":"多愁秖觉世情疏，愁极凭谁与破除。\n江海烟尘羁客泪，云山桑梓别人居。\n高风断雁惟将恨，衰草残萤不照书。\n世乱弓刀方有用，休誇新句逼黄初。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3715,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"仍用韵酬衍上人 其二","author":"刘基","text":"岁莫天寒生意微，空林鸟雀自相依。\n有情霜叶欺花貌，无用风荷象客衣。\n西塞鼓鞞山岳震，东郊羽檄海波飞。\n传闻有诏颁南服，早晚阳和斡化机。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3716,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"又用前韵 其一","author":"刘基","text":"树头寒月影扶疏，天上清霜下玉除。\n紫塞风高鸿失路，碧梧枝冷鹊移居。\n虎头旷日糜仓粟，牛腹中霄诧帛书。\n见说抱关堪避世，稗官犹可学虞初。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3717,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"又用前韵 其二","author":"刘基","text":"西风吹面雨霏微，片片浮云水上依。\n鸿雁群翔营口实，凫鹥对立惜毛衣。\n关河惨烈时将晚，原野萧条叶自飞。\n惭愧江湖一萍梗，厌听咿轧响邻机。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3718,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题小景","author":"刘基","text":"江头日日起西风，江树惊寒叶变红。\n天澹云低何处雁，一行飞下荻花中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3719,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题梅花小禽图","author":"刘基","text":"三鸟翩翩海上来，一双飞去入瑶台。\n可怜铩羽空山里，独立寒枝怨野梅。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3720,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感兴三首 其一","author":"刘基","text":"病骨愁寒忆见春，及观春色却愁人。\n转添细草当门径，不惜秾华委路尘。\n去国杜鹃红泪尽，伤时庾信白头新。\n风波满地鸬鹚鸟，相趁衔鱼饱一身。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3721,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感兴三首 其二","author":"刘基","text":"二月江南雪片飞，吴山寒色动征衣。\n莫寻花径防泥滑，且掩衡门待日晞。\n弱柳先舒应自损，蛰虫巳出更安归。\n乾坤处处旌旗满，肉食何人问采薇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3722,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"有感","author":"刘基","text":"浪动江淮战血红，羽书应不达宸聪。\n紫薇门下逢宣使，新向湖州召画工。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3723,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感叹","author":"刘基","text":"闻说苏州破，仓皇问故人。\n死生俱可悼，吾道一何屯。\n北去应无路，南藩自此贫。\n凄凉转蓬客，泪尽浙江滨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3724,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画鱼二首 其一","author":"刘基","text":"为爱濠梁乐有馀，故拈兔颖写成图。\n秋风忽忆银丝鲙，肠断松江隔具区。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3725,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柯桥灵秘寺即景赠基上人","author":"刘基","text":"尽日阴阴风坠花，楼前沟水发芹芽。\n青春院宇僧房好，白昼豺狼客路赊。\n对坐虾须回舞燕，出门鸱尾立饥鸦。\n相期握手何时再，五月芙蓉隘若耶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3726,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末元帅见赠二首 其一","author":"刘基","text":"雨过前溪晓色新，山城草木静埃尘。\n殊方负固犹蜗角，此地偷安赖虎臣。\n高阁绿萝相对晚，画阑红药不胜春。\n谁怜衰病兼疏拙，标泊东西一旅人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3727,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末元帅见赠二首 其二","author":"刘基","text":"元戎玉帐拥旌麾，武略文韬并出奇。\n构厦可堪无大匠，安邦曾见活危棋。\n此时山斗归民望，他日龙螭简帝思。\n我辈迂狂垂世务，趍风执御更何疑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3728,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中寄季山甫二首 其一","author":"刘基","text":"山雨随风去复来，南明晚色动楼台。\n犹怜仗节中郎在，不见乘槎使者回。\n感兴诗成聊自遣，忘忧花好为谁开。\n偏嫌近水多蝼蝈，永夜喧呼聒梦回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3729,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中寄季山甫二首 其二","author":"刘基","text":"长夜雨多泥没车，白日闭门人迹疏。\n阶下水衣看上壁，庭前檐溜欲成渠。\n闲花自发无劳种，蔓草从生不遣锄。\n想见幽栖张仲蔚，蓬蒿如树塞园庐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3730,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"病足戏呈石末公","author":"刘基","text":"旻天容我作支离，病疟才除足就羸。\n跬步不妨犹似鳖，踔行那得更怜夔。\n抱珍献楚何堪再，斫树收庞亦未迟。\n塞叟于今知匪祸，周鸡从此免为犠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3731,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"遣闷柬石末公","author":"刘基","text":"绿杨落尽白杨枯，坐石徒令岁月徂。\n尚想藩臣知患盗，岂期驿使似投巫。\n当时粳稻通辽海，今日风涛隔具区。\n豺獭可堪专节钺，衣冠何以拔泥涂？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3732,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"惆怅二首 其一","author":"刘基","text":"紫薇花树小楼东，日炙霞蒸似锦红。\n过了春风到秋露，可堪零落碧苔中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3733,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"惆怅二首 其二","author":"刘基","text":"与君为别几清秋，鸿雁来时辄上楼。\n今日倚楼无雁过，断肠风水隔瀛洲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3734,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公闻海上使命之作因念西州怆然有感二首 其一","author":"刘基","text":"巫闾析木天空阔，桐柏终南水乱流。\n邑里萧条无吠狗，田畴芜秽少耕牛。\n萋萋蔓草随人远，淡淡残阳向客留。\n迟莫飘零偏感旧，几回垂泪睇神州。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3735,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再用前韵 其二","author":"刘基","text":"大阃寻常弃郑师，后人休望及瓜期。\n豺狼封豕咸登用，都邑人民委若遗。\n曾见羌夷皆内地，忍闻淮济是边陲。\n经纶事业君当念，闻道任嚣髻已椎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3736,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再用前韵 其一","author":"刘基","text":"常闻星宿能环拱，未见江河解逆流。\n无肉可供徐勉狗，有刍难啖景升牛。\n梧桐冷落鸾先逝，芦荻苍茫雁独留。\n苏息疲氓还有术，那无一斗博凉州。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3737,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公闻海上使命之作因念西州怆然有感二首 其二","author":"刘基","text":"弟子舆尸漫有师，圮桥谁共老人期。\n龙鱼并出应难识，樗栎无庸幸见遗。\n每上楼台瞻北极，愿闻波浪帖南陲。\n吴山越水元相接，莫更中流下铁椎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3738,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"驿传杭台消息石末公有诗见寄次韵奉和并寓悲感二首 其一","author":"刘基","text":"被谗去国终思楚，厚貌深情漫剧秦。\n禾识庞萌直老贼，妄期侯景作忠臣。\n池鱼幕燕依栖浅，轩鹤冠猴宠渥新。\n何处荃兰不萧艾，种蔬犹得养闲身。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3739,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"驿传杭台消息石末公有诗见寄次韵奉和并寓悲感二首 其二","author":"刘基","text":"丧乱如川未有涯，悲风满地是虫沙。\n衰迟两臂从生柳，疾病双眸但陨花。\n暗蛬寒蝉秋色老，丹枫紫菊夕阳斜。\n颇闻四国思郇伯，尚想诗人赋木瓜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3740,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再次韵二首 其一","author":"刘基","text":"南州昔日称三楚，西国今闻又一秦。\n有爵与縻亡命贼，无才深愧具官臣。\n青冥鸾凤风尘隔，画省貔貅服色新。\n怅望令人忆李郭，谁能匡济想捐身。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3741,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再次韵二首 其二","author":"刘基","text":"深秋蔓草接天涯，极目飞鸿没远沙。\n绿水青山长送目，汀兰岸蓼各生花。\n风来西塞云阴合，涛落东溟蜃气斜。\n叹息笙歌旧亭馆，坏垣丛棘老王瓜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3742,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公感兴见寄","author":"刘基","text":"使君学术似文翁，奕世流芳缉武功。\n赤芾青衿来燕喜，黄童白叟望车攻。\n笔端波浪翻三峡，旗尾龙蛇动八风。\n惭愧谫才多谬误，忧时独有此心同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3743,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公无题之作","author":"刘基","text":"秋风袅袅作商音，落叶枯荄日夜深。\n巳为抵乌投白璧，徒劳点铁冀黄金。\n轩辕未必迷襄野，夸父终当死邓林。\n笑撚东篱菊花蕊，天寒岁晚尔知心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3744,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"立冬日作","author":"刘基","text":"忽见桃花出小红，因惊十月起温风。\n岁功不得归颛顼，冬令何堪付祝融。\n未有星辰能好雨，转添云气漫成虹。\n虾蟆蛱蝶偏如意，旦夕蜚鸣白露丛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3745,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丙申岁十月还乡作七首 其二","author":"刘基","text":"风急霜飞天地寒，草黄木落水泉乾。\n千村乱后荒榛满，孤客归来抆泪看。\n野宿狐狸鸣户外，巢居烟火出云端。\n黍苗处处思阴雨，王粲诗成损肺肝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3746,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丙申岁十月还乡作七首 其三","author":"刘基","text":"故园梅蕊依时发，异县归人见却悲。\n花自别来难独立，人今老去复何之。\n未能荷锸除丛棘，且可随方著短篱。\n等待薰风暄暖后，枝间看取实离离。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3747,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丙申岁十月还乡作七首 其四","author":"刘基","text":"手种庭前安石榴，开花结子到深秋。\n可怜枝叶从人折，尚有根株为客留。\n枳枸悲风吹白日，苕华高影隔青丘。\n坏垣蟋蟀知离恨，长夜凄凉吊独愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3748,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丙申岁十月还乡作七首 其五","author":"刘基","text":"舍北草池寒巳枯，草中时复见菰蒲。\n滥泉觱沸无留鲋，弱藻蒙茸不系凫。\n绿叶红花空代谢，春蛙秋蚓任喧呼。\n窥临最忆琴高鲤，腾驾风雷定有无。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3749,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丙申岁十月还乡作七首 其六","author":"刘基","text":"小舟冲雨清溪上，雨密溪深宿雾昏。\n游子到家无旧物，故人留客叹空尊。\n荒畦蔓草缠蒿草，落日青猿叫白猿。\n语罢不须还秉烛，耳闻目见总销魂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3750,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"冬至日泊舟戈溪","author":"刘基","text":"日薄云阴雪在山，野寒溪静客舟还。\n乾坤簸荡逾三载，风俗乖张似百蛮。\n废井衰芜霜后白，空村乔木晓馀殷。\n独怜节序逢冬至，不得安栖学闭关。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3751,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公红树诗","author":"刘基","text":"红树漫山驻岁华，玄冬惊见眼生花。\n井陉旗帜军容盛，汴水帆樯御气赊。\n春草凄迷金谷障，夕阳照灼赤城霞。\n靡蓱丹木扶桑里，惆怅谁乘博望槎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3752,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公元夜之作","author":"刘基","text":"八表流云澄夜色，九霄华月动春城。\n条风细细吹旗影，香蔼微微引漏声。\n河汉虹桥应断绝，沧溟鳌足漫峥嵘。\n愁来更听渔阳操，独倚阑干坐到明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3753,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]