[{"title":"江村睡醒","author":"叶颙","text":"霜重五更钟，箫声半夜风。\n梅香方旖旎，松影正朦胧。\n睡醒吟肌爽，神清世虑空。\n孤洲烟艇冷，渔唱月波东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6202,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"玩月","author":"叶颙","text":"桂魄满晴穹，徘徊牛斗东。\n清光流海宇，寒彩散天风。\n兔跃青霄迥，蟾游翠浪空。\n吟翁肌骨爽，步入玉华宫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6203,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江楼","author":"叶颙","text":"华发鬓飕飕，吟筇作胜游。\n闲中三弄笛，饭后一登楼。\n对酒思王粲，凭阑话莫愁。\n澄江鸿雁影，声断夕阳洲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6204,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽人高兴","author":"叶颙","text":"潇洒寄岩邱，人间世外游。\n霞杯风月笛，云佩雪霜裘。\n调古无劳和，年高渐寡俦。\n丝纶三百尺，独钓五湖秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6205,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"溪翁","author":"叶颙","text":"渔唱杂樵讴，茶铛继酒瓯。\n醒吹云外笛，醉掉月中舟。\n潮驾千寻浪，风生两岸秋。\n古今多少事，睡醒蓼花洲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6206,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"月夜孤舟二首 其一","author":"叶颙","text":"风定翠涛平，芳洲孤棹轻。\n僧钟穿岭响，渔笛隔江声。\n云傍西岩宿，蟾登北屿明。\n烟波遗世叟，心似石潭清。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6207,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"月夜孤舟二首 其二","author":"叶颙","text":"云去越山青，江空霁月明。\n钟鸣峰顶寺，潮到石头城。\n牛女中流现，鱼龙半夜惊。\n停杯呼李白，吟咏倒瓶罂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6208,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"兴怀","author":"叶颙","text":"泉石兴方浓，功名梦已空。\n发缘吟苦白，颜惜饮酣红。\n酒建和愁策，茶成遣困功。\n自惭无妙术，唯解醉春风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6209,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题乌衣巷陌图","author":"叶颙","text":"千载乌衣巷，荒凉日易斜。\n昔年丞相宅，今代野人家。\n庭弛生枫树，阶芜长草花。\n春风无主燕，夜雨为官蛙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6210,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚窗","author":"叶颙","text":"睡醒两眉厖，残阳渐上窗。\n已欣诗满袖，复喜酒盈缸。\n放达齐庄叟，风流类老庞。\n襟怀清且静，凉月下秋江。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6211,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽情野趣二首 其一","author":"叶颙","text":"啸断碧云巅，吟归青嶂边。\n送蟾游海岳，唤鹤舞林泉。\n独钓西江水，躬耕北屿烟。\n踏穿三径屐，撑破五湖船。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6212,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽情野趣二首 其二","author":"叶颙","text":"月上小山坡，风吟高树柯。\n朗吟青树岭，高卧白云窝。\n天地烟尘静，关河感慨多。\n惭无经济术，空老旧岩阿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6213,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"喜李公度留题僧壁","author":"叶颙","text":"醉笔濡蟾彩，芳逾天女花。\n吟胸繁锦绣，僧壁舞龙蛇。\n句语香千古，辞华擅一家。\n已呼红袖拂，更遣碧纱遮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6214,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽居","author":"叶颙","text":"半掩夕阳扉，闲陪夜月归。\n渔歌随浪远，樵笛入云飞。\n野鹤曾相识，沙鸥久见机。\n潺湲东涧水，常护钓鱼矶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6215,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"野兴","author":"叶颙","text":"门径久荒芜，谋身计画无。\n酣歌声正远，清睡兴尤孤。\n简朴衣冠野，疏狂语笑粗。\n山游方自乐，世誉不须沽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6216,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春暮","author":"叶颙","text":"睡起近斜晖，庭花昼掩扉。\n人从忙里老，春向醉中归。\n宿雨香红径，闲云冷翠微。\n沙鸥西涧浴，野鹤北岩飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6217,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"野客清欢三首 其一","author":"叶颙","text":"神清肌骨爽，虑淡梦魂安。\n夜月横吟榻，秋风理钓竿。\n醉来长袖舞，兴动短琴弹。\n对客频呼酒，忘情各尽欢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6218,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"野客清欢三首 其二","author":"叶颙","text":"雨过晚峰青，无人门自扃。\n溪光浮竹几，岚影落松屏。\n云满煎茶灶，春生贳酒瓶。\n酣歌天地里，醉卧秋风亭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6219,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"野客清欢三首 其三","author":"叶颙","text":"石鼎煮春茶，瑶杯斟紫霞。\n豪歌声俊爽，欢舞影欹斜。\n酣醉眠芳草，颠狂藉落花。\n醉来新月上，人笑忘还家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6220,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"季冬梅花未放","author":"叶颙","text":"么凤迹难寻，寒蜂恐爽盟。\n暗香犹髣髴，疏影不分明。\n南国春仍浅，西湖雪屡晴。\n师雄空入梦，和靖最关情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6221,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"逸兴二首 其一","author":"叶颙","text":"清兴寄林泉，孤踪远市廛。\n扶筇芳草径，吹笛落花天。\n满载西江月，躬耕东野烟。\n机关俱不识，人笑葛洪仙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6222,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"逸兴二首 其二","author":"叶颙","text":"颇有烟霞癖，全无市井喧。\n神空游汗漫，性静乐丘园。\n饱玩松云鹤，频呼月树猿。\n溪光常入枕，山色远迎轩。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6223,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"野趣","author":"叶颙","text":"岚影上衣袂，溪光满竹闾。\n云峰明月径，烟树夕阳庐。\n柳下寻诗策，花边载酒车。\n南山经雨豆，草长正堪锄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6224,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽庭寄傲","author":"叶颙","text":"门掩晓风轻，庭环涧水深。\n醉吹风里笛，静鼓月中琴。\n黄卷知兴废，青山阅古今。\n久忘尘俗事，偃息夕阳林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6225,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚兴","author":"叶颙","text":"教鹤复盟鸥，看云独倚楼。\n笛声千嶂月，琴调一庭秋。\n木落山俱瘦，江空水自流。\n夕阳烟柳外，蓑笠钓鱼舟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6226,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日酒边","author":"叶颙","text":"予身无系缚，去住政如萍。\n泉石闲堪玩，功名老不惊。\n青山常入梦，紫绶不关情。\n酒到频欢饮，杯空逐旋营。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6227,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江村过雨","author":"叶颙","text":"雨趁断虹收，霞随孤鹜游。\n蟾光流断港，鸿影落芳洲。\n万叠云峰暮，一江烟水秋。\n溪声连野色，渔唱伴樵讴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6228,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春游晚归","author":"叶颙","text":"小雨杂烟霏，晴光弄夕晖。\n蔫红侵酒斝，空翠润琴徽。\n风袭吟翁帽，云香野客衣。\n殷勤花径月，寒彩照人归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6229,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"云峰雅兴","author":"叶颙","text":"高卧碧云岑，清谈翠竹林。\n疏狂交牧圉，勋业谢冠簪。\n江月清吟腑，松风醒醉心。\n焦桐弦久绝，三弄发奇音。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6230,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁巳秋暮","author":"叶颙","text":"吟啸倚奇峰，清游衣袂风。\n落霞孤鹜外，斜日断虹中。\n垣竹流寒翠，江枫舞晚红。\n芳州渔唱远，烟冷碧波空。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6231,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚兴","author":"叶颙","text":"蜗舍水云乡，巢栖蝶梦长。\n竹摇丹凤舞，松撼翠蛟翔。\n鹤影深秋瘦，蟾光半夜凉。\n自惭无汗马，牛背度斜阳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6232,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江路晚游","author":"叶颙","text":"吟袖舞天风，轻鞋策瘦筇。\n湿云辞怪石，凉月上奇峰。\n樵唱穿林曲，僧撞出岭钟。\n横江清夜鹤，归宿大夫松。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6233,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽居","author":"叶颙","text":"门对北山峰，窗迎越水东。\n松枯青嶂老，花落翠岩空。\n幽谷飘晴雨，虚堂含昼风。\n相羊烟柳外，吟啸夕阳中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6234,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古意","author":"叶颙","text":"江汉遨游女，吹箫伴月明。\n曲终人又去，声断意还惊。\n云尽湘潭暮，潮回浙水平。\n英雄今昔事，日落远峰青。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6235,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽栖","author":"叶颙","text":"若问幽栖地，吾庐住翠微。\n步随青草远，兴与白鸥飞。\n衲裹秋云去，囊挑夜月归。\n尘埃虽满世，难染芰荷衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6236,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"与钱提领","author":"叶颙","text":"钱镠千载下，何幸出斯郎。\n鼻祖声名盛，闻孙姓字香。\n吴山归梦远，越水宦情长。\n幕府诚淹滞，期君仕帝乡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6237,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵贾逢源见寄二首 其一","author":"叶颙","text":"不成惊世事，愧读古人书。\n老去功名懒，贫来故旧疏。\n白云生户牖，明月宿庭除。\n亦有无心者，携琴访逸居。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6238,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵贾逢源见寄二首 其二","author":"叶颙","text":"短发彫秋鬓，天风快晚晴。\n闲唯欣有味，老不叹无成。\n白石和云煮，青山带月耕。\n无心少年事，慷慨乐从征。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6239,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江村即事赠人","author":"叶颙","text":"长笛倚风吹，江村对夕晖。\n烟迷前岸柳，月照后园薇。\n发白何劳镊，山青正好归。\n尘埃方满世，慎勿染荷衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6240,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"午梦感邯郸旧事","author":"叶颙","text":"清睡午炊香，槐安仕路长。\n征辽辞激切，忧国志忠刚。\n赴召新承宠，遭谗复致殃。\n危疑忽惊悟，大笑海蟾凉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6241,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游赏清乐四首 其一","author":"叶颙","text":"乌帽翠云裘，行藏得自由。\n月宵尤醒藉，天路更风流。\n不作尘中梦，甘为世外游。\n林泉堪纵目，势利懒回头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6242,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游赏清乐四首 其二","author":"叶颙","text":"华发雪霜眉，频将羽扇挥。\n儿童呼矍铄，樵牧笑希夷。\n不识当今讳，宁谙薄俗机。\n清歌三四曲，猿啸鹤惊飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6243,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游赏清乐四首 其三","author":"叶颙","text":"竹杖芰荷衣，青鞋白接䍦。\n腹储徐邈酒，胸贮杜陵诗。\n白发搔风短，青山过雨奇。\n杯酣芳兴动，箫管倚云吹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6244,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游赏清乐四首 其四","author":"叶颙","text":"野服帽频欹，登临倚翠微。\n清烟衰柳外，孤鹜落霞飞。\n草露粘芒屦，松云上布衣。\n清吟山路晚，瘦策踏斜晖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6245,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠一教官游学者","author":"叶颙","text":"灯火老书窗，功名志未忘。\n青衫惊岁月，白发老风霜。\n累作东吴梦，频观上国光。\n十年犹未调，感慨忆冯唐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6246,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"城中一佳士赠所知","author":"叶颙","text":"城中一佳士，借问不言谁。\n解唱无声笛，能吟落韵诗。\n三杯随分酒，一局不争棋。\n到处无人识，唯应野老知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6247,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次密印精蓝光上人韵二首 其一","author":"叶颙","text":"蔬饭度春秋，何心向外求。\n但能存取舍，自足绝恩雠。\n岁月惊青鬓，风霜变白头。\n腾腾常任运，无果亦无脩。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6248,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次密印精蓝光上人韵二首 其二","author":"叶颙","text":"石边清睡醒，松下独吟馀。\n小径云收后，空林月上初。\n梅香凝几案，竹影扫阶除。\n湛湛长空净，纤埃半点无。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6249,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送萧君祐宪史升南台掾二首（建康人） 其一","author":"叶颙","text":"汉朝丞相裔，台阁惯惩膺。\n云海横孤鹗，天风快俊鹰。\n几年居宝婺，后夜发金陵。\n李白题诗地，阑干试一凭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6250,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送萧君祐宪史升南台掾二首（建康人） 其二","author":"叶颙","text":"霜台新聘客，家世出萧梁。\n况乃辞江浙，翩然往建康。\n六朝烟树老，千载暮云长。\n见说孙郎宅，青山带夕阳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6251,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送宪奏差丘鲁瞻还浙江二首 其一","author":"叶颙","text":"堂堂乌府士，声已播钱塘。\n投劾惊神鬼，摛词凛雪霜。\n潮回吴渚冷，月落越山长。\n西浙今非昔，期公正纪纲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6252,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送宪奏差丘鲁瞻还浙江二首 其二","author":"叶颙","text":"人才天下望，岂但鲁观瞻。\n清冷双溪水，高寒半夜蟾。\n时贤多自逸，吾子独能廉。\n去去西湖路，荷香漾酒帘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6253,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重九后菊（壬辰年小篱黄菊节后始华异香芳容不类馀者惜其开不应时如绝笔之麟又似吾性倔强好与世欲背驰岂其以予无酒酬酢故迟之抑将耻伍凡下不欲与之同出俟其衰谢然后独步西风否则赋性谦退不欲争先群品特殿于九日之后耳赋唐律一章见意云）","author":"叶颙","text":"痴蝶狂蜂未用疑，从来根性懒趋时。\n情知不少争先辈，故遣迟开殿后枝。\n斜日园林方冷淡，西风天地特清奇。\n芳苞小蕊秋香老，不是渊明断不知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6254,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题友琴堂","author":"叶颙","text":"畴昔知音托久要，同声相和更同条。\n嗟予无用头甘秃，顾子多材尾亦焦。\n七尺身长形固美，两翁调古腹空枵。\n何当共坐虚檐下，握手论心到月高。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6255,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山馆酒边即事和何仙翁韵","author":"叶颙","text":"但须独酌杯中酒，何用千秋身后名。\n才拙更无医国伎，家贫犹有读书声。\n岩花落树香云影，庭竹迎秋伴月明。\n醉坐石床横短笛，天风吹断世间情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6256,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登八咏楼","author":"叶颙","text":"我是东阳老布衣，沈腰销瘦胜当时。\n非常胸次能无酒，如许江山政要诗。\n今古可惊浑似梦，英雄未死恰如棋。\n齐梁耆旧俱尘土，落日荒城草木悲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6257,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题余仲杨松云斋手卷二首 其一","author":"叶颙","text":"白云来往青松顶，树老云寒岁月深。\n云去人间化甘泽，松留天地作清阴。\n孤标素有冲霄气，高躅曾无出岫心。\n已喜卷舒皆在我，何妨偃蹇卧丰林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6258,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题余仲杨松云斋手卷二首 其二","author":"叶颙","text":"幽人住在松云下，云白松青十里程。\n拣得好枝延鹤宿，扫开轻翳放蟾明。\n栖岩枕石衣裳冷，倚树吟诗格调清。\n早晚移家近君屋，饱看烟霭听涛声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6259,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次卫律本宪史红梅韵","author":"叶颙","text":"本是孤山雪里花，朱唇得酒改容华。\n贪匀南国佳人面，忘却西湖处士家。\n一种暗香凝夜月，十分娇韵醉时霞。\n邻墙艳杏诚非伍，须信南人语未差。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6260,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"复次前人绿萼梅韵","author":"叶颙","text":"老免舂香细捣霜，更添蓝淀越风光。\n唤回庾岭春风梦，染出罗浮月夜芳。\n日暮冰魂啼翠袖，雪残玄鬓舞霓裳。\n近来姑射梳妆别，说与林逋合断肠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6261,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送东阳吴县尹（东阳有玉山）","author":"叶颙","text":"东阳天下佳山水，君到其中地益灵。\n恩惠有如银浪阔，姓名高并玉峰清。\n桃香春暖游蜂喜，琴调秋高老鹤听。\n父老新镌去思石，白云来往护碑亭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6262,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题王寿卿烟云叠嶂图","author":"叶颙","text":"青峰尽处更青峰，烂墨淋漓惨澹容。\n云裹长松三百尺，烟迷荒峤十千重。\n层峦岌嶪如棋布，空翠清寒胜酒浓。\n添写诗翁岚影里，羽衣雾縠驾天风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6263,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题幽居","author":"叶颙","text":"隔溪春色两三花，近水楼台四五家。\n浊酒不妨留客醉，好山长是被云遮。\n松根净扫弹琴石，柳下常维钓月艖。\n路狭不容车马到，只骑黄犊访烟霞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6264,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"乙未八月二十二夜梦宿山寺与僧讲道论诗不觉夜分僧赋一联云鹤向白云栖处宿僧从青嶂影边归觉而微改其句足成一律云","author":"叶颙","text":"天风吹梦过招提，瘦策迢迢扣夕扉。\n鹤拣白云枝上宿，僧从青嶂月边归。\n杉松韵古调清乐，苔藓痕深染敝衣。\n多谢山灵能念旧，此心焉敢忘烟霏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6265,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"二月江城见梅二首 其一","author":"叶颙","text":"二月江城第一枝，怕寒故故著花迟。\n不嫌艳杏夭桃俗，甘受狂蜂妒蝶疑。\n月落西湖惊旧梦，雪消南国忆当时。\n楼头亦有霜天角，懒对春风暖日吹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6266,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]