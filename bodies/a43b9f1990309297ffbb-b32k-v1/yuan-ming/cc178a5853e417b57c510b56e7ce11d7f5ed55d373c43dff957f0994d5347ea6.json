[{"title":"癸卯腊月雷","author":"梁寅","text":"腊月频闻殷殷雷，荒村昼雨似浮埃。\n石潭骤起蛟龙蛰，松谷遥惊鹳鹤回。\n覆垄荠菘青更嫩，出墙梅李白争开。\n虽愁瘴疠乘时作，先喜春从天上来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12666,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶成","author":"梁寅","text":"山翁自爱缊袍宽，白发尤宜制鹖冠。\n蓬巷三年贫不病，竹书一箧老仍看。\n䲭鸦乱噪丹枫晚，鸾凤稀来翠柏寒。\n渺渺江湖交友绝，空闻渤海沸狂澜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12667,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"黄本立东游赠别","author":"梁寅","text":"楚邦才子燕台客，万里还山复出山。\n江汉总归沧海里，方蓬遥在白云间。\n将趋金马陈三策，却从楼船定八蛮。\n远道应能念林叟，年年秋草映柴关。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12668,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"观兰室禅老山阴道中之作次韵二首 其一","author":"梁寅","text":"吴山尽处越山多，尚想经行野景和。\n朝旭射岩晴卧鹿，春泉落沼响惊鹅。\n山人看竹敲门入，溪女如花荡桨过。\n千里东游何日再，镜湖明月醉中歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12669,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"观兰室禅老山阴道中之作次韵二首 其二","author":"梁寅","text":"诸峰翠拥兰亭胜，稧饮尝闻晋永和。\n羽客喜邀仙子鹤，野翁仍爱右军鹅。\n粉垣护竹家家似，棕轿穿云处处过。\n最好昼眠松下石，若耶溪上听渔歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12670,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"章孟忠和伍仲远韵见寄再和答之","author":"梁寅","text":"王谢风流异俗徒，清秋玉露映冰壶。\n鸿飞碧落期高举，鲸战沧溟叹不虞。\n松竹小堂兵后葺，桂兰香醑客来沽。\n寄诗能忆云中叟，大隐墙东志自殊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12671,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为李朝阳题松云图","author":"梁寅","text":"涧上小亭双石磐，古松四五云巑岏。\n横琴坐爱白日静，散发长疑朱夏寒。\n汎汎轻阴过峭壁，微微香粉落冰盘。\n我欲同君觅幽处，醉卧瑶席临风湍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12672,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠西山僧","author":"梁寅","text":"高僧自喜岩下住，长见白云飞复回。\n中天风动松子落，千岁石作莲花开。\n鸟下林堂待分食，龙游溪水遇浮杯。\n吴山楚山聊暂往，还把楞伽归去来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12673,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠白师禹省亲安庆因就试河南","author":"梁寅","text":"白郎楚楚关中豪，读书江南心独劳。\n露凉松寺写周易，日莫兰丛歌楚骚。\n家近千峰淮甸翠，舟乘三月大江涛。\n钟陵秋晚正相忆，好趁天风连巨鳌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12674,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丙子岁舟发豫章将往金陵","author":"梁寅","text":"常年九日归不得，今年九日重远行。\n秋水蒹葭自可爱，故园松菊非无情。\n月下飞鸿过别渚，天明孤鹤唳高城。\n相将一棹望湖去，即看匡庐岚翠生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12675,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题赤水霞栖图","author":"梁寅","text":"故人家居赤水上，二百八十峰嵯峨。\n明霞时混金碧气，老树尽变珊瑚柯。\n题诗石壁照松籁，读书茅亭悬女萝。\n道成不用金膏术，飞向九霄鸣玉珂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12676,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠安福州尹王义方归平阳","author":"梁寅","text":"安成使君廊庙器，六年琴鹤寄山城。\n草生斋閤少人迹，花映讼堂闻鸟鸣。\n劝农已报江南政，柱史当驰天上名。\n一舸秋风暂归去，太行千仞翠峥嵘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12677,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题湛溪黄氏引翠楼","author":"梁寅","text":"徵君结楼湛溪上，日日钩帘看翠微。\n长松云际蛟龙起，叠嶂天边鸾鹤飞。\n巫峡锦屏增秀色，仙人瑶瑟带清晖。\n把书更觉秋意早，冉冉浮岚飘夕霏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12678,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送江西省照磨王志刚考试湖广","author":"梁寅","text":"八月秋深江水清，月明朱舰趁宵征。\n郎官湖上风云合，黄鹤楼前洲渚生。\n持鉴棘闱方伯召，扬旌沙路郡侯迎。\n经通鲁史春秋奥，策问周官礼乐明。\n十八科名资化笔，三千才子服英声。\n玉生玄圃圭璋就，金出棠溪鼎鼐成。\n放榜总称唐陆贽，著书尤羡汉张衡。\n名区三载承知遇，聊采芙蓉寄远情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12679,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"朱尚质挽诗","author":"梁寅","text":"魏亭之北朱贤良，三十文章逼汉唐。\n矫矫云龙行碧落，飘飘天马脱丝缰。\n山罍牺象珠凡器，苍玉珠玑多异光。\n太史遗书窥石室，春秋大义揭王纲。\n方驰健步今文苑，未策奇勋古战场。\n才似贾生谁敢忌，名班黄宪遽先伤。\n严君痛失鹓鸾羽，令弟哀思鸿雁行。\n怅望斗牛铺紫气，呜呼兰桂陨秋霜。\n故人秉笔争称述，稚子应门待振扬。\n鸾草琅玕明月照，新坟夏屋白云长。\n临江孤客怀畴昔，今日生刍空自将。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12680,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"龙翔寺赠缝人 其一","author":"梁寅","text":"蜀绮吴绫惯揣量，并刀常带色丝香。\n自言多得豪家意，也解穿云到上方。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12681,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"龙翔寺赠缝人 其二","author":"梁寅","text":"山客麻衣岁月多，朔风吹裂奈愁何。\n若为访我清江上，倩子云中制芰荷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12682,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠采诗方道成","author":"梁寅","text":"乾坤清气治朝音，碧海明珠价万金。\n他日江南方氏集，流传应遣到鸡林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12683,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖歌五首 其一","author":"梁寅","text":"美人玉钗燕翩翩，白日照耀黄金蝉。\n柳丝绿让云鬟亸，荷花红妒茜裙鲜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12684,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖歌五首 其二","author":"梁寅","text":"鹅黄满壶载船头，酒能解愁人自愁。\n长堤车马如流水，朝来莫去几时休。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12685,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖歌五首 其三","author":"梁寅","text":"艳妆缓歌金缕衣，舞腰学得雁儿飞。\n湖西日落月东出，歌舞留人且莫归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12686,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖歌五首 其四","author":"梁寅","text":"青山入湖湖水青，菱花白白照船棂。\n山头急雨船须住，水面凉风酒易醒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12687,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖歌五首 其五","author":"梁寅","text":"钱塘城中十万家，碧瓦龙鳞户绮霞。\n楼头卖酒船中饮，不如湖上最繁华。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12688,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"儿子岷自维扬还至金陵得朱县尹仲文手书且云荷接引良厚二绝寄谢时仲文将调官京师假馆维扬 其一","author":"梁寅","text":"木犀香里设离筵，建业西风八月天。\n一骑仍留大江北，双凫何日五云边。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12689,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"儿子岷自维扬还至金陵得朱县尹仲文手书且云荷接引良厚二绝寄谢时仲文将调官京师假馆维扬 其二","author":"梁寅","text":"一札飞来云锦函，也知能共阿戎谈。\n几夜石头城上月，遥瞻二十四桥南。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12690,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钓台三首 其一","author":"梁寅","text":"台下澄江山影多，台上蟠木悬青萝。\n高人一去山寂寂，万古明月照江波。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12691,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钓台三首 其二","author":"梁寅","text":"独把渔竿烟雨中，身婴尘网与人同。\n祇缘竞慕终南捷，愈觉高名泰华雄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12692,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钓台三首 其三","author":"梁寅","text":"祠庭才拜先生像，舟子乘风发棹忙。\n欲荐蘋蘩惭草草，回瞻云水白苍苍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12693,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"观清江傅氏西园题咏怀旧二绝 其一","author":"梁寅","text":"忆昔西园曾见招，春风歌响入春霄。\n池上题诗花冉冉，林边归骑雨潇潇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12694,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"观清江傅氏西园题咏怀旧二绝 其二","author":"梁寅","text":"一别桃源迷故津，花随流水几回春。\n烟尘岂料逢今日，翰墨犹期似昔人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12695,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻笛","author":"梁寅","text":"风入梧桐山月明，卧听邻笛转凄清。\n未传黄鹤楼中曲，却得羌儿塞上声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12696,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"食笋","author":"梁寅","text":"楚山春笋楚江鱼，北野黄羊恐未如。\n老来更厌江鱼美，食笋山中乐有馀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12697,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"足疾作","author":"梁寅","text":"山上浮云坐卧看，茅衡十日步蹒跚。\n思仙不得飞腾术，愈觉人间行路难。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12698,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为王仲义题雪梅","author":"梁寅","text":"小桥东郭先生履，曲径西湖处士家。\n向暖早看花似雪，冒寒更爱雪如花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12699,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"清江道中 其一","author":"梁寅","text":"几夜江城厌鼓鼙，出关那得更迟迟。\n鸡豚晓日田家乐，榛莽秋风过客悲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12700,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"清江道中 其二","author":"梁寅","text":"桕叶生红霞映水，荍花连白雪盈畴。\n晴天绣画山溪景，却是春光不似秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12701,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄章齐高 其一","author":"梁寅","text":"葛岭云开青映天，潇洲月上夜无烟。\n太守爱居山水郡，名流尤羡幕官贤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12702,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄章齐高 其二","author":"梁寅","text":"去年相亲情恋恋，今年相望思依依。\n石潭遥想蛟龙稳，寒渚空怜鸿雁稀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12703,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄章齐高 其三","author":"梁寅","text":"令弟曾为五台客，经过湖上问平安。\n芙蓉道远何堪寄，杨柳秋来折更难。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12704,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄章齐高 其四","author":"梁寅","text":"山中岁月薜萝春，天上光华印绶新。\n白首惟思逢世泰，青云那得厌交贫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12705,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山舍偶成","author":"梁寅","text":"石峡瑽琤新涨水，柏林崷崒古时坟。\n黄茅小径无来客，一犬松边吠白云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12706,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"代赠李以洪归洪州 其一","author":"梁寅","text":"门外梧桐啼早鸦，行人策马踏江沙。\n归去却怜家是客，重来还念客为家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12707,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"代赠李以洪归洪州 其二","author":"梁寅","text":"冉冉花明金凤渚，青青柳映木兰船。\n遥望钟陵在何处，洪崖高出白云边。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12708,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"代赠李以洪归洪州 其三","author":"梁寅","text":"象牙潭里帆过后，石头渡口船到时。\n洲人洲上迎归楫，山客山中劳远思。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12709,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"代赠李以洪归洪州 其四","author":"梁寅","text":"黄峰岧峣凌紫虚，下有林堂宜读书。\n绿壑丹崖迟君至，松巢不减住匡庐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12710,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和何彦正春耕十一首 其一","author":"梁寅","text":"见说春耕溪水头，赋诗犹忆玉京游。\n莫誇塞北千蹄马，宁买江南十角牛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12711,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和何彦正春耕十一首 其二","author":"梁寅","text":"雨后逍遥南涧上，山田漠漠树重重。\n绿拖烟外无穷水，青插天边不尽峰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12712,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和何彦正春耕十一首 其三","author":"梁寅","text":"垂垂杨柳荫柴扃，远远岩峦列锦屏。\n江海归来更何事，朝亲农圃夕穷经。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12713,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和何彦正春耕十一首 其四","author":"梁寅","text":"石壁临流净可书，从教渔子怪癯儒。\n黄蜂日日粘红蕊，白鸟时时下绿芜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12714,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和何彦正春耕十一首 其五","author":"梁寅","text":"自著青蓑久离群，羞将龙剑远从军。\n雨苗已得邻人惜，烟草常令稚子耘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12715,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和何彦正春耕十一首 其六","author":"梁寅","text":"乱后江湖阻舟楫，衣冠强半寓山村。\n云山紫蕨那堪采，豺虎惊人翠谷昏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12716,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和何彦正春耕十一首 其七","author":"梁寅","text":"短笠登山自种茶，萦林石径树边邪。\n百金自可侔封邑，千骑何劳拥鼓笳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12717,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和何彦正春耕十一首 其八","author":"梁寅","text":"竹间樵径行应熟，花外渔舟望欲迷。\n处处稻畦分落照，荷锹人去水禽啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12718,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和何彦正春耕十一首 其九","author":"梁寅","text":"閒与山氓日共谈，往来溪北又溪南。\n今代劝农贤太守，他年何武定才堪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12719,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和何彦正春耕十一首 其十","author":"梁寅","text":"野夫卧对石门山，怀友其如道险艰。\n喜诵清诗凉雨后，唤回幽思白云间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12720,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和何彦正春耕十一首 其十一","author":"梁寅","text":"业桑树边绿草坐，刺桐花下碧瓷杯。\n醉和农歌乐农暇，吴盐如雪点杨梅。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12721,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寓兴 其一","author":"朱希晦","text":"乾坤一旅亭，大梦几时醒。\n白发无情极，春来不再青。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12722,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寓兴 其二","author":"朱希晦","text":"山中无别事，诗酒作生涯。\n鬓雪空催老，何由驻日车。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12723,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寓兴 其三","author":"朱希晦","text":"山寺钟声歇，夫寒睡起迟。\n敲冰添砚水，发兴写新诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12724,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寓兴 其四","author":"朱希晦","text":"风尘犹澒洞，江海转深沉。\n不作乘桴兴，徒怀击楫心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12725,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江村冬日清景","author":"朱希晦","text":"屋外梅花的皪，篱边涧水潺湲。\n竟夕诗翁睡著，不知雪满前山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12726,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寒江独钓","author":"朱希晦","text":"翠壁寒云淡薄，沧江老树萧疏。\n输与扁舟渔父，一生意钓忘鱼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12727,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"云山僧","author":"朱希晦","text":"树暝烟生绝壁，瀑流雨洒虚潭。\n他日来寻懒瓒，枯禅还许同参。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12728,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋日客怀 其一","author":"朱希晦","text":"百岁光阴石火，几番世事云萍。\n试问谁人有药，能医白发重青。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12729,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋日客怀 其二","author":"朱希晦","text":"梧叶声中夜雨，桂花香里秋风。\n巢幕偏惊客燕，寄书不见征鸿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12730,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋日客怀 其三","author":"朱希晦","text":"桑落谁家有酒，荷蓑客子无衣。\n斜日江楼北望，凉天鸿雁南归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12731,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖","author":"朱希晦","text":"丝丝细雨弄春晴，新水溪头杜若生。\n我欲与君携酒去，绿阴树底听啼莺。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12732,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客箫台书怀","author":"朱希晦","text":"有客寻幽蹈紫霞，杖藜入竹访仙家。\n相逢不道春光老，门外溪风落栋花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12733,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"云山僧舍","author":"朱希晦","text":"千山万水一枝筇，身在烟霞第几重。\n最好雁边秋色净，倚天空翠出芙蓉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12734,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]