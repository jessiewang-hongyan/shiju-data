[{"title":"游三洞金盆诸峰绝句二十首 其十","author":"叶颙","text":"徘徊三洞天，拚作十日留。\n何当约安期，共为千载游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5921,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游三洞金盆诸峰绝句二十首 其十一","author":"叶颙","text":"山灵见我来，抚掌一笑莞。\n喜我成此游，怪我来何晚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5922,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游三洞金盆诸峰绝句二十首 其十二","author":"叶颙","text":"不为世网萦，肯受儒冠误。\n兹游快平生，并了泉石痼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5923,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游三洞金盆诸峰绝句二十首 其十三","author":"叶颙","text":"大山严而尊，小山婉而秀。\n往来两山间，岩霏湿吟袖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5924,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游三洞金盆诸峰绝句二十首 其十四","author":"叶颙","text":"平生酷爱山，嗜好如猿狙。\n行将脱尘俗，上与浮云俱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5925,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游三洞金盆诸峰绝句二十首 其十五","author":"叶颙","text":"久从山中游，颇识山中趣。\n狂吟采松花，撼动云栖树。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5926,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游三洞金盆诸峰绝句二十首 其十六","author":"叶颙","text":"已无名利心，犹有烟霞疾。\n汲彼千尺清，洗此方寸癖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5927,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游三洞金盆诸峰绝句二十首 其十七","author":"叶颙","text":"犬吠人家近，鸟啼春昼晴。\n涧草有幽色，野花无定名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5928,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游三洞金盆诸峰绝句二十首 其十八","author":"叶颙","text":"怪藤摇苍烟，芳林滴晴雨。\n闲花逞娇姿，笑舞春风里。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5929,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游三洞金盆诸峰绝句二十首 其十九","author":"叶颙","text":"褰衣陟芙蓉，挨云拾瑶草。\n寘之怀袖中，食之颜色好。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5930,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游三洞金盆诸峰绝句二十首 其二十","author":"叶颙","text":"云边学仙子，貌古悬方曈。\n闲挥白玉麈，笑坐青石峰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5931,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晓窗禽语二首 其一","author":"叶颙","text":"纸帐梦初醒，山窗月上明。\n宿云离石去，幽鸟话新晴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5932,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晓窗禽语二首 其二","author":"叶颙","text":"残月满山阿，长松弄清影。\n幽禽啼数声，吟窗人睡醒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5933,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题丹井二首 其一","author":"叶颙","text":"闲云埋甃冷，皓月照前空。\n仙与丹俱化，苔花弄晓风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5934,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题丹井二首 其二","author":"叶颙","text":"浴丹仙已远，甃冷藓痕鲜。\n断绠无人汲，空遗浸月泉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5935,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题丹灶","author":"叶颙","text":"丹成仙去后，灶古白云边。\n灰冷空馀燐，林荒锁断烟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5936,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题石羊二首 其一","author":"叶颙","text":"二仙牧群羝，食尽丹田草。\n化石几何秋，牧羊人未老。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5937,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题石羊二首 其二","author":"叶颙","text":"山边牧羊者，谁得似初平。\n羊化人俱往，年年草自荣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5938,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"王粲江楼","author":"叶颙","text":"王粲登临客，云闲独倚楼。\n西风千里兴，落日半江秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5939,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"莫愁烟艇","author":"叶颙","text":"莫愁江上艇，月夜扣舷歌。\n甚欲寻遗迹，江空烟浪多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5940,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"范蠡云舟","author":"叶颙","text":"范蠡平吴后，秋风理钓船。\n情空青嶂下，梦落白鸥边。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5941,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"严江独钓","author":"叶颙","text":"光武中兴主，严光避世翁。\n云边一片石，江上几秋风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5942,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赤壁清游","author":"叶颙","text":"魏武吟诗夜，坡仙玩月秋。\n英声流后世，清兴动南州。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5943,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梦游金盆峰二首 其一","author":"叶颙","text":"爱山如猿猱，清啸卧云石。\n山云入梦来，相见如旧识。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5944,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梦游金盆峰二首 其二","author":"叶颙","text":"有怀金芙蓉，经年未能去。\n青山入梦魂，白云生杖屦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5945,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"看山","author":"叶颙","text":"薄俗易炎凉，浮云屡更变。\n耐久屋外山，相看无厌倦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5946,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题泉石高情图","author":"叶颙","text":"流水闲云外，青山落照中。\n诗翁扶瘦策，相与听松风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5947,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题西施蹙额捧心图","author":"叶颙","text":"憔悴两娥颦，春山锁恨深。\n东邻正尝胆，西子谩扪心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5948,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋日饮友代东二首 其一","author":"叶颙","text":"乌帽风前落，黄花雨后香。\n渊明三径里，明日共壶觞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5949,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋日饮友代东二首 其二","author":"叶颙","text":"诗骨秋来瘦，山花日暮香。\n殷勤一樽酒，相与慰荒凉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5950,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"草堂归来图二首 其一","author":"叶颙","text":"鹤发兮倚闾，山空兮夕晖。\n白云兮髣髴，游子兮其归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5951,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"草堂归来图二首 其二","author":"叶颙","text":"游子归心切，慈亲望眼空。\n白云千里意，瘦策倚秋风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5952,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"疏斋晚步","author":"叶颙","text":"荷老难擎露，水清偏见鱼。\n好磨青玉觜，一饱更何如。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5953,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"岩前夜坐","author":"叶颙","text":"修径白云幽，山空明月秋。\n长松高百尺，明月袭衣裘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5954,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋暮田园杂兴二首 其一","author":"叶颙","text":"浊酒满斟自适，柴门虽设常关。\n与老为期白发，相看无厌青山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5955,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋暮田园杂兴二首 其二","author":"叶颙","text":"峰顶云闲懒出，松边鹤去应还。\n独步秋风顶上，兴来聊尽吾欢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5956,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春郊即景","author":"叶颙","text":"微雨弄晴天气，轻寒酿暖时光。\n柳外凉飙满袖，花边香露沾裳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5957,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"沙溪清隐","author":"叶颙","text":"绕屋一湾水绿，迎轩数朵峰青。\n沙路鸥盟新定，云松鹤梦初醒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5958,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽居即事二首 其一","author":"叶颙","text":"吟座半窗残照，琴床一枕闲云。\n尘外兴怀有味，世间姓字无闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5959,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽居即事二首 其二","author":"叶颙","text":"骑牛过白云岭，放鹤出翠松关。\n樵唱偶歌一曲，清声直度千山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5960,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日寄兴三首（庚申岁） 其一","author":"叶颙","text":"故侣无心送酒，老翁有意留题。\n旧日龙山佳会，如今风雨凄凄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5961,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日寄兴三首（庚申岁） 其二","author":"叶颙","text":"白发凄凉旧里，黄花冷落东篱。\n西望夕阳归去，淡烟衰草堪悲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5962,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日寄兴三首（庚申岁） 其三","author":"叶颙","text":"黄菊香残夜雨，乌纱醉落秋风。\n回首十年旧事，乱云流水西东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5963,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"月夜梅边即事","author":"叶颙","text":"香裹寒云满溪，月明津渡人迷。\n梦入江南旧路，夕阳流水桥西。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5964,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送阮师真之宣城","author":"叶颙","text":"江东日暮云闲，敬亭千古高寒。\n若见谢公传语，沈郎依旧衣宽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5965,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送人侍父入吴","author":"叶颙","text":"生子如李亚子，不然如孙仲谋。\n景升诸郎豚犬，焉能侍父远游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5966,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"与故人叙别","author":"叶颙","text":"六尺形躯销瘦，十年故旧西东。\n试问市桥官柳，别来几度春风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5967,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游北山诸峰四首 其一","author":"叶颙","text":"水泠泠兮乐奏，风细细兮鸾吟。\n月随人而有意，云出岫以无心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5968,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游北山诸峰四首 其二","author":"叶颙","text":"山嶙峋兮北迈，水呜咽兮东流。\n欲寻源而远去，思绝世以无求。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5969,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游北山诸峰四首 其三","author":"叶颙","text":"约芝兰之环佩，葺薜荔之裳衣。\n蹑烟云而高蹈，世与我以相违。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5970,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游北山诸峰四首 其四","author":"叶颙","text":"折南涧之芳芷，采西山之嫩薇。\n赠佳人兮为好，与握手兮同归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5971,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"时苗留犊图","author":"叶颙","text":"杨子平生四畏，刘郎临别一钱。\n甚矣时君留犊，审观三老孰贤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5972,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题王寿卿烟云叠嶂图","author":"叶颙","text":"一百八盘山路，七十二峰晓寒。\n日暮烟横谷口，雨馀云宿松端。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5973,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题李克明翁媪起家图（一翁以指就醋瓮取醯吮之尝其味之美恶一媪持星火吹灯备诸穷态）","author":"叶颙","text":"乃叟宵衣制醋，厥妻忘寝治灯。\n办此难成家业，遗彼不识玄曾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5974,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题时苗留犊图二首 其一","author":"叶颙","text":"秩满言归父老忧，临岐分犊较蝇头。\n男儿利物忘天下，未必区区在一牛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5975,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题时苗留犊图二首 其二","author":"叶颙","text":"留犊归牛骇见闻，古今唯数一时君。\n设令买宠生贤嗣，未必邦人敢见分。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5976,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"示小儿阿真牡丹二首荼蘼春暮各一首 其一","author":"叶颙","text":"绛色罗裳绿色襦，沈香亭北理腰肢。\n含风笑日娇无力，恰似杨妃睡起时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5977,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"示小儿阿真牡丹二首荼蘼春暮各一首 其二","author":"叶颙","text":"浅红深紫间轻黄，天下无花敢比芳。\n素与东君同富贵，肯随凡品擅称王。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5978,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"示小儿阿真牡丹二首荼蘼春暮各一首 其三","author":"叶颙","text":"一点檀心气味长，向人无语舞霓裳。\n千红万紫消磨尽，犹有风吹不断香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5979,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"示小儿阿真牡丹二首荼蘼春暮各一首 其四","author":"叶颙","text":"老红新绿驻烟波，无奈青皇促驾何。\n又是一年春事了，杜鹃声里夕阳多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5980,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚步","author":"叶颙","text":"偶随芳草踏斜晖，石径云深翠滴衣。\n两袖天风明月上，杖头挑得树阴归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5981,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夜看月","author":"叶颙","text":"广寒宫阙桂香浮，万里无云独倚楼。\n明月满空天似水，西风吹断海门秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5982,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵周安道宪史仲春雨窗书怀十首 其一","author":"叶颙","text":"缲烟杨柳千丝绿，过雨蔷薇万点红。\n诗句满前唫未稳，好怀写在夕阳中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5983,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵周安道宪史仲春雨窗书怀十首 其二","author":"叶颙","text":"深院梨花呈腻粉，邻墙艳杏褪残脂。\n池塘雨后蛙声闹，半为官鸣半为私。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5984,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵周安道宪史仲春雨窗书怀十首 其三","author":"叶颙","text":"茶鼎松涛翻细浪，桃溪花雨涌香泉。\n旋寻笋蕨春山下，不枉江南二月天。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5985,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵周安道宪史仲春雨窗书怀十首 其四","author":"叶颙","text":"缓骑黄犊随芳草，闲倩苍头扫落花。\n醉后不知新过雨，岩前应湿旧烟霞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5986,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵周安道宪史仲春雨窗书怀十首 其五","author":"叶颙","text":"破除愁闷无过酒，消遣情怀正要诗。\n燕子未来春又半，一帘花雨海棠时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5987,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵周安道宪史仲春雨窗书怀十首 其六","author":"叶颙","text":"长笑陈搏争似睡，深非杜宇不如归。\n男儿正要成功业，拭目江山看落晖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5988,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵周安道宪史仲春雨窗书怀十首 其七","author":"叶颙","text":"愁来倍觉诗难和，醉后宁辞酒满斟。\n夜雨惊醒尘世梦，春风吹老少年心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5989,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵周安道宪史仲春雨窗书怀十首 其八","author":"叶颙","text":"一春憔悴未曾晴，况是檐声入枕鸣。\n却怪夜来诗梦好，草塘雨过月初明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5990,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵周安道宪史仲春雨窗书怀十首 其九","author":"叶颙","text":"凝烟芳草入疏帘，过雨闲花点涧泉。\n正是清明时节近，鹧鸪啼过夕阳天。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5991,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵周安道宪史仲春雨窗书怀十首 其十","author":"叶颙","text":"蝶懒莺慵燕语衰，红羞绿怨湿难开。\n晴窗误听山禽乐，又是鸣鸠唤雨来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5992,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"用前韵序山家幽寂之趣呈前人十首 其一","author":"叶颙","text":"夕阳香径逐东风，瘦策轻扶数落红。\n信步偶随流水去，不知身到白云中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5993,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"用前韵序山家幽寂之趣呈前人十首 其二","author":"叶颙","text":"棠梨睡起娇啼粉，桃杏香浓浅抹脂。\n自是从来肌骨好，春风宁为一花私。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5994,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"用前韵序山家幽寂之趣呈前人十首 其三","author":"叶颙","text":"满盛煮茗春波月，旋汲浇花石涧泉。\n客至不妨频劝酒，醉开白眼看青天。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5995,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]