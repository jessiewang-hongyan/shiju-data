[{"title":"蹋鞠篇和铁厓韵四首 其一","author":"郭翼","text":"簇花小银云作团，双尖绣袜星流丸，金蝉束腰燕盘盘。\n燕盘盘，綵门下。\n第一名，齐云社。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7271,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"蹋鞠篇和铁厓韵四首 其二","author":"郭翼","text":"倡园小奴花个个，蹋鞠朝朝花里过，钗坠蜻蜓髻倭堕。\n髻倭堕，玉珑璁。\n倚娇树，双脸红。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7272,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"蹋鞠篇和铁厓韵四首 其三","author":"郭翼","text":"绿云草色光如苔，綵楼红扇相当开，美人淩波蹴月来。\n蹴月来，不堕地。\n袖回风，动罗袂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7273,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"蹋鞠篇和铁厓韵四首 其四","author":"郭翼","text":"落花水流春满路，走红鞠鞠罗尘步，绣襦鸳鸯暖香雾。\n暖香雾，酒光狞。\n红映肉，太娇生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7274,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题仙山楼观图","author":"郭翼","text":"五云楼阁世间无，日月龙光出绮疏。\n王母众中金羽盖，双成扶下紫云舆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7275,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题美人图","author":"郭翼","text":"上清宫殿五云车，降下仙人萼绿华。\n怪得雪衣无个信，只将条脱寄羊家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7276,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题诗意图","author":"郭翼","text":"郁金堂上春浓否，薄薄罗襦杏子红。\n白日绣窗莺不语，都缘诗思落花中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7277,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题倪元镇画","author":"郭翼","text":"不见草堂桤树西，早来云气忽相迷。\n野老回船怕风雨，竹鸡栅里莫教啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7278,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题秋山图","author":"郭翼","text":"山上浮云天几重，秋高花散玉芙蓉。\n好携谢朓惊人语，醉里来登落雁峰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7279,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句六首 其一","author":"郭翼","text":"沙洲芦苇如城郭，水深门前百丈洪。\n老渔晒网卧日里，稚子捉船行水中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7280,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句六首 其二","author":"郭翼","text":"杨柳盖江花盖屋，就中二月觉春多。\n一双白鹄浮新舫，窣迹红云踏艳歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7281,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"昆山谣送友人","author":"郭翼","text":"吴东之州娄东江，民庐矗矗如蜂房。\n官车客马交驰横，红尘轧投康与庄。\n鸡鸣闹市森开张，珠犀翠象在道傍。\n吴艎越舰万首骧，大帆云落如山崩。\n舟工花股百夫雄，蛮音䝤语如吃羌。\n水仙祠前海茫茫，鱼鳖作道虹作梁。\n龙堂贝阙当中央，灵女媛歌吹笙簧。\n冯夷伐鼓相铿轰，或乘飞龙下沧浪。\n大樯小樯火流光，翠旓摩云互低昂。\n左驱勾陈右搀抢，天子锡命下南邦。\n重臣下拜灵慈宫，太平无象跻成康。\n吾州富庶文物昌，厥田下下赋下上。\n岁贡天府民职恭，君子訚訚讲虞唐，小人业业为工商。\n大夫从事举贤明，掌曹僚属登其良。\n王郎作掾材用长，理烦剸剧乃不蘉。\n自少轩轾有父风，穰穰学业盈囷仓。\n乃翁七十须眉苍，二三昆季故昂藏，中郎虎髯黠而彊。\n诚心恳恳爱其兄，愿汝忠謇为国祯，子孙昭孝百禄将。\n愿集中正以为裳，愿以仁义杂为珩。\n愿言揖子以为明，德音秩秩亦孔章。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7282,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"天台行送友人","author":"郭翼","text":"吾闻天台山，一万八千丈。\n赤霞壁立百雉城，阊阖天开势摩荡。\n琼台双阙云几重，群山俯伏华顶雄。\n灵仙玄圣所窟宅，紫气彷佛飞游龙。\n沧溟直下但如沼，青烟东望蓬莱小。\n火珠光动金银宫，日月跳丸几昏晓。\n丹厓气散如飞霜，草木冬夏涵天香。\n羽人霄盖拥旌节，雨衣云带双翱翔。\n石桥缥缈那可度，凭雷蹑云天所怒。\n不知方广今有无，如何绝却人间路。\n有客有客多好奇，方舟明日过灵溪。\n青山之谷事幽讨，手援芝草歌我诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7283,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠卜香印钱道人","author":"郭翼","text":"吾闻轩辕师广成，仙成骑龙鼎湖升。\n独遗弓剑在人世，白云冉冉连星辰。\n崆峒之天三十六，日月珠光照龙烛。\n何年赠汝枣木盘，玉字灵香勘神卜。\n道人十口家一船，瓦盘沽酒有酒钱。\n桃花洞洞红满烟，尘流一隔三千年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7284,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送道士游武当","author":"郭翼","text":"武当诸峰何壮哉，大朵小朵青莲开。\n玄圣中居天地户，赤日下照金银台。\n神龟六眼电光走，山鬼一足云头来。\n道人再拜望北极，应带满身星斗回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7285,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉同袁子英简呈杨廉夫先生","author":"郭翼","text":"杨子十年官不调，如此永州文力何？\n洞庭铁笛龙吹得，天上琼书鹤寄多。\n车子看花将一两，雪儿行酒艳双歌。\n时时对客鼓弦索，绣领单衫月色罗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7286,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和读李五峰集","author":"郭翼","text":"先生住娄八十日，金石遗音手自题。\n人物风流拟江左，文章典雅重淮西。\n凤来山郭时称瑞，鲸破沧溟势欲齐。\n著作新闻徵士诏，天光久待照青藜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7287,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桂花曲","author":"郭翼","text":"花开沓沓金为粟，叶密丛丛翠盖烟。\n不分月中惟一树，要将秋色种诸天。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7288,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"欸乃歌词 其一","author":"郭翼","text":"榻头船子小如车，卖卜狂游属当家。\n直到年头与年尾，不开看月即看花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7289,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"欸乃歌词 其二","author":"郭翼","text":"芙蓉秋里绕城开，溪月溪烟几番来。\n骆驼桥头有酒卖，鸥波亭下棹船回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7290,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"欸乃歌词 其三","author":"郭翼","text":"道场何山山最雄，弁中形胜闻吴中。\n七十二峰菡萏绿，四月五月杨梅红。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7291,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"欸乃歌词 其四","author":"郭翼","text":"上塘船行无断头，下塘船少好安流。\n两岸青山天上坐，看山吹笛上杭州。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7292,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"欸乃歌词 其五","author":"郭翼","text":"城东城西杨柳多，女郎不唱本乡歌。\n那个新传欸乃曲，落花风里奈春何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7293,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江南采莲曲","author":"郭翼","text":"涉烟采芙蓉，湖波秋影荡。\n天开明镜入，鸟下青菰蒋。\n佳人弭轻楫，绿水歌两两。\n江南有愁思，落日空苍莽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7294,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春愁曲","author":"郭翼","text":"春阳动宫沼，花色明阑薄。\n文莺穿柳过，黄蜂粘絮落。\n霓裳久不舞，丛簧愁未灼。\n宁知色易衰，秖念恩如昨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7295,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题和袁子英四首 其一","author":"郭翼","text":"云中锦队卫旌幢，帝子乘舟思满江。\n不惜凤弦閒宝瑟，却教龙女护瑶窗。\n泪花筠竹坡千顷，愁雨苍梧玉一双。\n万古湘南遗庙在，至今清怨未能降。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7296,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题和袁子英四首 其二","author":"郭翼","text":"琼宫花发满神皋，花下吹笙紫绣袍。\n不学凤台秦弄玉，也歌乐府郑樱桃。\n珊瑚旧梦留春枕，椒桂新香暖夜醪。\n辘辘羊车过别院，仰看星斗觉心劳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7297,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题和袁子英四首 其三","author":"郭翼","text":"绕帐犀珠星影移，铜华铺首齧双螭。\n守宫点臂斑斑血，结带同心寸寸丝。\n机上金梭回艳锦，箧中玉子卜灵棋。\n飞花解系相思否，莫倩韩家赋《柳枝》。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7298,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次陈敬初见寄二首兼怀张仲敏 其一","author":"郭翼","text":"至正天子明圣君，早闻羔雁聘陈群。\n河清地应千年瑞，星聚天回五色文。\n遂有青鸾鸣桂树，也怜黄鹄伴沙云。\n诗筒坐得苏台使，百过愁吟到落曛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7299,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次陈敬初见寄二首兼怀张仲敏 其二","author":"郭翼","text":"论交长叹白头新，倾盖相知定几人。\n照世岂无麟阁画，买田且卜草堂邻。\n南州人物皆零落，西汉文章尚雅驯。\n好竹每怀张仲敏，泠泠风骨水为神。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7300,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题娑罗室","author":"郭翼","text":"娑罗树下幽人室，山气因之与秋碧。\n古色犹栖竺国云，绝顶仰见扶桑日。\n太阴垂地风雨会，百尺撑空鬼神力。\n醉呼北海起九原，为尔重镌青石壁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7301,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送僧归江阴山寺","author":"郭翼","text":"孰知扬子江头寺，寺门高高树里开。\n仙翁巳乘白狼去，古佛或骑青象来。\n春动水流无底谷，天晴云覆散花台。\n山中邑子正忆汝，恰得飞空一锡回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7302,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄陆良贵","author":"郭翼","text":"堂馆绿阴皆面水，图书乌几喜无尘。\n棕榈交叶绕遮井，菡萏倾花故向人。\n世事从渠宁分拙，交游于尔觉情亲。\n澧兰沅芷秋风里，明日南云别更新。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7303,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送赵季文之湖州知事","author":"郭翼","text":"送子作官山水郡，掾曹日日簿书稀。\n放生池头看花去，浮玉山前载酒归。\n芙蓉入帘秋雨落，䆉稏满天寒雁飞。\n即闻善政歌贤德，还见清光照紫微。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7304,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"天马二首 其一","author":"郭翼","text":"佛郎献马真龙种，六尺之高脩倍之。\n图画当今属周朗，歌诗传昔敕奚斯。\n空闻市骨千金直，不羡穷荒八骏驰。\n有客新来闻此事，与君何惜滞明时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7305,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"天马","author":"郭翼","text":"四年远涉流沙道，筋骨权奇旧肉騣。\n晓秣龙堆寒蹙雪，晚经月窟怒追风。\n汉文千里知曾却，曹霸丹青貌不同。\n拂拭金鞍被来好，幸陪天厩玉花骢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7306,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"陆定之印为陆仲安赋","author":"郭翼","text":"陆家汉印吁亦绝，金窠籀文盘屈铁。\n斯文已矣世无传，千载得之名不灭。\n何用兵家虎作符，空闻泽国龙为节。\n勖哉玩物古有言，愿子文章照前烈。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7307,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"岁尽寄瞿慧夫","author":"郭翼","text":"瞿子作官无暇日，南园腊尽未还家。\n禁春微雪青青草，照眼疏枝细细花。\n五两即看飞落日，屠苏应待酌流霞。\n诗成无使能将意，凫雁寒云满白沙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7308,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"荅吕维清兼柬郑遂昌葛可久","author":"郭翼","text":"沧洲解缆不十日，相忆题诗寄阖闾。\n常怪接舆歌凤鸟，因怜尔雅注虫鱼。\n台州司户频相问，勾漏仙人好附书。\n况汝才华今亦盛，五云坊里看徵车。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7309,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟杜陵秋兴八首 其一","author":"郭翼","text":"露下大江江雁横，穷秋摇落唤愁生。\n波涛百里风连海，砧杵千家月满城。\n佩剑冲冲龙匣动，巢笙夜夜凤台清。\n还同使者将秋色，一到银河且濯缨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7310,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟杜陵秋兴八首 其二","author":"郭翼","text":"东过秦皇渡海矼，波声云影落漎漎。\n君平漫识支机石，帝子应愁鼓瑟窗。\n凤穴朝阳鸣好树，槎头秋水钓空江。\n坐来清漏荒城断，愁绝飞蓬老鬓双。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7311,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟杜陵秋兴八首 其五","author":"郭翼","text":"滦水秋风晓夜催，上京宫殿护蓬莱。\n扶桑日近龙波涌，阊阖天高象驾回。\n綵仗齐迎千骑发，翠旗遥接五云来。\n扬雄漫有河东赋，流落何人一荐才。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7312,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟杜陵秋兴八首 其七","author":"郭翼","text":"金陵佳丽帝王州，今古登临送客愁。\n玉树云连鳷鹊观，青山日落凤凰丘。\n荒城并与烟芜没，故国空馀汉水流。\n渺渺江湖频入梦，萧萧天地不胜秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7313,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春闺曲","author":"郭翼","text":"绿树莺歌遍，红檐燕语频。\n所思犹远道，何用慰芳春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7314,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄衣曲","author":"郭翼","text":"蚕岁既已毕，莺时俄复换。\n早制边上衣，秋来愁绪乱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7315,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送远曲二首 其一","author":"郭翼","text":"神京佳丽地，万户复千门。\n看花三月里，慎莫过倡园。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7316,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送远曲二首 其二","author":"郭翼","text":"七月发扬子，八月渡黄河。\n到京书便寄，北来鸿雁多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7317,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送林尊师","author":"郭翼","text":"共谒昆崙华盖君，芙蓉旌旆雨纷纷。\n烛龙衔火朝飞海，笙凤乘风夜入云。\n偷得玉桃如赤日，懒将琼笈校玄文。\n倘其归去容成洞，采拾金鹅幸见分。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7318,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次郑明斋柬俞彦庄韵","author":"郭翼","text":"萱草罗生已满院，筼筜初种欲遮邻。\n厨中双鱼好作鲙，阶下独鹤长比人。\n久钦陆贾为新语，况以荀卿得大醇。\n白首相逢在江海，紫薇终愿召丝纶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7319,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题沈君锡画木","author":"郭翼","text":"君不闻庄椿春秋八千岁，又不闻蟠桃一实三千龄。\n不知此木历年几百万，云气上下摩空青。\n羲和驭日海底出，白银宫阙搏桑暾。\n嗟哉沈君笔力能扛百斛鼎，旋转造化何其神。\n蛟螭走壁白日动，列缺御气流风霆。\n勇如陆地荡舟子，凛若汉廷折槛臣。\n车行下走九折坂，剑化跃入延平津。\n大枝轮囷小枝偃，千千百百子若孙。\n六月赤日天无云，珊瑚水屋尝阴阴。\n与君展席坐其下，听我醉读南华经。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7320,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀张心田","author":"郭翼","text":"若人清事也无涯，客去谈诗到日斜。\n爱画龙眠好头赤，凌霄不埽落来花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7321,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"馆娃曲","author":"郭翼","text":"馆娃催赐宴，西子犹酣酒。\n龙舆下云旗，凤乐迎王母。\n银桥星似烛，翠扇花连牖。\n歌乐殊未终，鸦噪城头柳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7322,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜起来","author":"郭翼","text":"秋生临水殿，月过望仙台。\n歌吹无聊赖，愁吟夜起来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7323,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖竹枝词 堤上行三首 其一","author":"郭翼","text":"碧水楼楼三月春，蛮儿个个唱歌新。\n通海坊中人作市，灵慈宫里乐迎神。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7324,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖竹枝词 堤上行三首 其二","author":"郭翼","text":"四月南风海岸深，青旗高高柳阴阴。\n三江潮发来如马，五两风摇密似林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7325,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖竹枝词 堤上行三首 其三","author":"郭翼","text":"高丽女儿珠腕绳，玉环穿耳坐船棚。\n丝为帆繂朝朝飏，铜作琵琶啧啧鸣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7326,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夜曲","author":"郭翼","text":"玉阶月下千愁色，秋水秋波振草凉。\n乌桕风高吹旆旆，红蕖露冷坠房房。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7327,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"棹歌行","author":"郭翼","text":"春江花柳月，水色碧草滋。\n婵媛竞游盘，棹歌乐芳时。\n宝珥薰麝兰，羽盖翔凫鹥。\n临流激遗响，窈窕飘莺辞。\n竟欲整轻桡，溯洄往从之。\n落日大江平，怆然生远思。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7328,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"白头吟","author":"郭翼","text":"皑皑山上雪，雪积还复灭。\n皎皎云间月，月圆有时缺。\n周公大圣当国时，流言况也谗间之。\n结交以面心乃尔，白头不若新相知。\n汉家宫阙长门道，花发年年怨春草。\n今朝宠固色未衰，明日怨多恩反少。\n今人轻薄怀古人，古人轗轲常苦辛。\n兰陵废死不归楚，呜呼此意吾谁陈。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7329,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"弃妾言","author":"郭翼","text":"弃妾不足惜，顾顾怀君深。\n奉妾合欢带，系君明日心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7330,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"连理树","author":"郭翼","text":"堂前好双树，枝合叶交遮。\n时有鸳鸯鸟，来衔并蒂花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7331,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"征妇怨","author":"郭翼","text":"君久戍远碛，妾愁在空帏。\n不得如青草，随春上君衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7332,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柳枝词","author":"郭翼","text":"濯濯金明柳，年年照妾容。\n飞花怨春尽，落日渡江风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7333,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"精卫辞","author":"郭翼","text":"海水水无底，百谷流瀰瀰。\n精卫衔木石，之死心不移。\n蓬莱几清浅，会有扬尘时。\n眼中恨与海水平，鸟飞不惜翅羽垂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7334,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]