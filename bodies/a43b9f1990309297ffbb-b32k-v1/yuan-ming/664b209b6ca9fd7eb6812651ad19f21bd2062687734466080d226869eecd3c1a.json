[{"title":"次韵自述","author":"陶宗仪","text":"飘零江海半生多，年少疏狂老益磨。\n柳拂檐牙儿手种，苔黏屐齿客来过。\n雨窗吟苦偿诗债，茗盌香清遣睡魔。\n亦欲躬耕南亩上，饭牛閒暇织农蓑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4370,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日次韵","author":"陶宗仪","text":"重阳佳节古今同，老我凄凉思不穷。\n两浙东西淹岁月，一身南北类萍蓬。\n登龙人在销沈外，戏马台荒感慨中。\n醉把茱萸怀弟妹，不知乌帽落西风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4371,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"平湖为山阴镜上人赋","author":"陶宗仪","text":"万顷平湖枕越城，短篷如在画图行。\n波浮霜鉴金辉瑩，山拥冰壶玉气清。\n翡翠兰苕酣净绿，天光云影照空明。\n知章一曲应分得，用作沙门字与名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4372,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次曹雪林见寄韵","author":"陶宗仪","text":"告老归来鬓已秋，山中庐墓境深幽。\n田园已遂陶彭泽，乡里争称马少游。\n戏彩庭前思远道，解缨风外濯清流。\n新诗题寄浑难和，笔力高于五凤楼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4373,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"干山访曹雪林刘深云周云坞看菊花云庄有诗次其韵","author":"陶宗仪","text":"干山盘曲带诸峰，与客寻幽向此中。\n溪色秋同天色净，篱花晓裛露花浓。\n云林泉石清深处，人物衣冠太古风。\n酌酒赋诗忘路远，放船归晚意无穷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4374,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"并头鹤顶红菊次云樵韵","author":"陶宗仪","text":"翩跹篱下合欢丛，骈首昂昂沁浅红。\n湘浦泪沾仙羽若，乔家醉嗅晚香同。\n秋宵并作繁华梦，春色匀光隐逸风。\n自昔栽培无此本，丹铅图写待良工。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4375,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"黄白二色菊","author":"陶宗仪","text":"一本花敷二样芳，试稽别谱异寻常。\n东篱夜结金银气，彭泽神游坤兑方。\n正色半随霜露改，晚香浑似蝶蜂忙。\n蜡葩月朵争辉洁，渔隐诗篇久播扬。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4376,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次林泉韵简云庄","author":"陶宗仪","text":"慈亲堂上笑开颜，画舫归来落照间。\n一劄分疏投柏府，诸郎迎候出林关。\n风尘涉世情当适，鸥鸟忘机意自閒。\n开岁元宵无几日，入城好约看灯山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4377,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁丑元日分韵得生字","author":"陶宗仪","text":"土牛饯腊三元正，玉烛调和四海清。\n老眼细看新岁历，白头偏动故乡情。\n人家竞写宜春帖，宰相宁无列火城。\n图轴高县钟进士，怪精也复可怜生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4378,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谒贞烈庙","author":"陶宗仪","text":"义兴县里长桥外，祠宇巍峨枕碧虚。\n华衮端居英义像，穹碑深刻右军书。\n斩蛟射虎传今昔，尽孝全忠耀里闾。\n一棹经过来致谒，石香炉畔整冠裾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4379,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过石臼湖","author":"陶宗仪","text":"四围涨塞中流浅，一日风帆百里程。\n势敌洞庭天所设，形侔石臼古来名。\n乌犍黑豕千群乱，碧草黄沙万顷平。\n几处空林皆可画，扣舷吟咏豁高情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4380,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"三月朔日入都门","author":"陶宗仪","text":"欣欣灌木卫圜丘，滚滚长江控上游。\n虎踞龙蟠真圣主，天开地设古神州。\n五云宫殿参差起，万国梯航远近柔。\n何幸布衣膺宠命，拟随仙仗觐前旒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4381,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"二日早朝","author":"陶宗仪","text":"鸡人三唱送残更，禁鼓鼕鼕日未升。\n白玉搆桥联五仗，黄金题榜耀觚棱。\n班传胪句朝仪肃，乐奏箫韶旦气澄。\n黼坐正中天咫尺，叩头丹陛益凌兢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4382,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"到家","author":"陶宗仪","text":"头白衰年一病身，轻装来往倏三旬。\n五城街市经行遍，数亩田园入望频。\n芳草落花吴苑夕，短帆轻桨淀湖春。\n到家菊茂秧田绿，老作皇明治世民。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4383,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过凤山锦溪桥","author":"陶宗仪","text":"锦溪桥下水平溪，杨柳条长拂岸齐。\n参政宝坊归幻劫，右丞先垄可悲悽。\n渔船桧楫双双短，酒店茅檐处处低。\n市井荒凉风景异，老鸦啼过乱云西。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4384,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"白醉楼为范文铉赋","author":"陶宗仪","text":"目眩金锣日出初，檐阑凛冽气全苏。\n心情酣乐非因酌，体骨融和似欲扶。\n西阁吟成唐杜老，寒时作息宋田夫。\n幕天席地从吾意，兀兀陶陶一念无。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4385,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送王思广还常德卫","author":"陶宗仪","text":"玉立长身意气多，相逢忽在凤山阿。\n晋朝人物王文度，汉代将军马伏波。\n铁甲枕戈曾报效，锦衣传檄谩婆娑。\n东风二月桃源路，归骑翩翩奈尔何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4386,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"莲月轩在华亭东林寺为矩庵方上人赋","author":"陶宗仪","text":"凿沼栽莲半亩强，开轩敷席坐端相。\n从来水月真灵境，化出匡庐古道场。\n兔影淡笼银橐净，冰轮清碾玉簪香。\n要知影色皆为妄，本性圆明意味长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4387,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寒碧轩为玉岩琏上人赋","author":"陶宗仪","text":"花惟薝卜树旃檀，地位清高眼界宽。\n云彩半分冰鉴碧，天光倒浸露壶寒。\n静凭曲槛湔凡趣，宴坐曾轩习止观。\n本性空明犹湛水，未教风外起波澜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4388,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"洪武三十一年闰五月初十日亥时大行皇帝崩十六日皇太孙即位十八日大赦天下改明年为建文感而恭赋","author":"陶宗仪","text":"先帝逍遥游碧落，神孙端拱坐明堂。\n九重统握乾坤大，万国恩沾雨露香。\n动植飞潜滋德色，都俞吁咈庆明良。\n老臣舞抃南村底，笑对儿孙两鬓苍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4389,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"阅耕","author":"陶宗仪","text":"小筑瑶溪水北庄，阅耕杖屦日徜徉。\n父菑子播知无逸，妻馌夫耘敬有常。\n好雨三时禾毓秀，凉风七月稻吹香。\n相逢田畯谈农事，西陌东阡几夕阳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4390,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"中秋夜对月","author":"陶宗仪","text":"八月平分秋正中，飘香桂子落长空。\n十分圆魄年年好，一道寒光处处同。\n清唳忽来蓬岛鹤，乱吟不断露莎虫。\n南村未酿南楼在，治世琴尊属老翁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4391,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"乙卯元日","author":"陶宗仪","text":"凤历新颁纪建文，初元正旦上晴暾。\n一人圣德敷皇极，万物光辉沐湛恩。\n家世传来书满案，宾朋致贺酒盈尊。\n太平如此诚难值，只愿年年子又孙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4392,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题唐涿州横云草堂","author":"陶宗仪","text":"三泖移居屋几楹，青山一带与云横。\n翠芬落几琴声润，玉气浮阶鹤梦清。\n剖竹专城施政教，县车故里养尊荣。\n杖藜莫厌相过数，好付儿郎管送迎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4393,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"城市山林为孙子华赋","author":"陶宗仪","text":"我家住近古城阴，随分生涯岂用心。\n佳菊移栽秋粲粲，修篁罗植昼森森。\n沟池环匝泉源活，门巷幽閒径术深。\n祗为长年耽野趣，旁人都道是山林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4394,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送上海知县司公守道赴召","author":"陶宗仪","text":"妙拣宪臣来作宰，文星天上照云间。\n荐贤名奏麒麟殿，恋阙心驰虎豹关。\n驻毂邑门留犊去，借船浦口载书还。\n东南赋税民罢病，荅问应知动圣颜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4395,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送人才何公远","author":"陶宗仪","text":"朝端奉旨举贤才，使者驰书海上来。\n琴册缄封荣组绂，衣冠饮饯列尊罍。\n五城楼阁云烟绕，万国山河锦绣开。\n圣主临轩求治切，奏陈利病莫迟回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4396,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题靖州卫陈指挥凌云堂","author":"陶宗仪","text":"指麾训练渠阳卫，奕奕名堂结搆全。\n五彩翚飞昭武烈，八窗洞启树机权。\n抛书草檄风生席，握槊谈兵月满天。\n他日论功须第一，凌云发轫上凌烟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4397,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次胡万山韵荅陈祠部","author":"陶宗仪","text":"坐树疏梅试一吟，纷纷霁雪落长林。\n?泉石鼎烹山茗，温火金凫爇水沈。\n幽意漫随寒日淡，故人遥住白云深。\n试看题寄新诗句，珠玉篇篇有赏音。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4398,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题沈宗文竹梧轩","author":"陶宗仪","text":"竹梧并植近轩墀，一榻清风日自怡。\n玉立娟娟冰雪操，翠融挺挺凤皇枝。\n昌黎喻勒王孙志，工部吟题省署诗。\n琴瑟斲成笙管截，明廷九奏致雍熙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4399,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送俞知县嘉言之鲁山","author":"陶宗仪","text":"皇朝进士声华重，藩邸清曹正列班。\n有旨召除分宰出，叩头请告送亲还。\n疏章切媲长沙傅，组绂行之古鲁山。\n百里涂谣称善治，传家定达五云间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4400,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送友之官","author":"陶宗仪","text":"握手河梁酒一卮，若为会合在何时。\n前旌剡剡催行迈，疏柳萧萧绾别离。\n明月圆亏千里共，尺书往复半年期。\n愿言清慎修吾职，早晚高迁侍玉墀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4401,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送李给事中行恕服阕之京师","author":"陶宗仪","text":"给事先皇内六曹，缉熙九法独称劳。\n块苫垩室终缞制，旌旆兰舟试锦袍。\n玉笋联班黄道直，宫花簇仗紫垣高。\n清朝事业光千古，黼黻铺张属俊髦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4402,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"五日次万山韵","author":"陶宗仪","text":"夺标竞渡快轻狂，忆昔游观力尚强。\n艾颗离离供巧制，榴花朵朵殿群芳。\n辟兵人佩灵符小，吊古江沈角黍香。\n晓起画梁双语燕，似知节序说兴亡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4403,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"景辰张先生校文福建归林公崇高画闽溪放棹图赋诗其上以饯因次韵就题","author":"陶宗仪","text":"一棹闽溪下濑船，千岩万壑路勾连。\n榕阴处处浮岚外，杜宇声声落照边。\n考试来临多士上，宦游向在十年前。\n故人分手难为别，写得云山上蜀笺。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4404,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"松斋为玉峰秀上人赋","author":"陶宗仪","text":"上人远自海东来，为爱青松到处栽。\n花落石床閒不扫，声和天籁定初回。\n折将席上为谈柄，留向山中具法材。\n几欲裹茶林下煮，高斋赋咏亦幽哉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4405,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"铁箫为张以道散人赋","author":"陶宗仪","text":"冶师百鍊昆吾刀，范出铮铮七窍箫。\n把弄岂侔龙跃琯，奏成好列凤仪韶。\n清风赤壁三千顷，明月扬州廿四桥。\n海上散人携作伴，较渠思致我犹饶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4406,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题许彦清松鹤轩","author":"陶宗仪","text":"奕奕高轩结搆成，种松养鹤遂閒情。\n翠涛翻处鸣逾远，金粉飞时步觉轻。\n衣湿长防清露滴，枝蟠不怕旧巢倾。\n葳蕤五粒真堪啖，相与长年已订盟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4407,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"腊月廿七日雪","author":"陶宗仪","text":"立春三日雪花稠，作阵随风卒未休。\n屋宇高低银盖覆，郊原远近玉雕锼。\n将军好问平吴策，高士谁乘访戴舟。\n九万车夫多冻馁，定应未到济宁州。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4408,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送教谕沙允恭赴礼部试易经","author":"陶宗仪","text":"袖行荐剡谒南宫，白鹤长鸣蕙帐空。\n花气春浓薰锦旆，柳丝风软拂青骢。\n世承雨露诗书泽，笔补阴阳造化功。\n应试归来须一月，离筵劝酒莫匆匆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4409,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送夏西畴还宁夏","author":"陶宗仪","text":"归来已是十年过，行李萧萧两鬓皤。\n紫塞冰霜还部曲，清秋风雨去关河。\n潮浮短棹征途远，酒尽离觞别恨多。\n从此音书应更少，断肠分手泪滂沱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4410,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送道士叶道心游武当","author":"陶宗仪","text":"均阳雄镇武当山，金阙宏开缥缈间。\n龙虎风云环紫极，龟蛇水火閟玄关。\n杖藜远道秋行役，幢节层坛晓缀班。\n此地逍遥酬夙愿，丹成九转未知还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4411,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送陈子章赴王家瀼馆所","author":"陶宗仪","text":"多士留连醉别觞，琴书一棹水花凉。\n郊原不异东西瀼，主客何分上下床。\n白发垂垂劳授业，青衿济济快升堂。\n弦歌声辍閒情好，定有新诗为我将。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4412,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送戴叔温赴京","author":"陶宗仪","text":"堂堂廷尉重详刑，幕下贤郎案牍清。\n奔讣宅忧丧有制，释衰还吉礼无倾。\n船从三泖湖头发，路向丹阳郭里行。\n此去功名浑好在，秋风买酒叙离情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4413,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送廷采还黄鹤山中三首 其一","author":"陶宗仪","text":"木叶萧萧小雨零，西风鼓棹晚潮生。\n江山形胜归图写，今古诗篇付品评。\n乘兴漫穷登眺乐，怀人不尽别离情。\n蕙帷黄鹤应无恙，此日归来思益清。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4414,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送廷采还黄鹤山中三首 其二","author":"陶宗仪","text":"黄鹤山中夙著声，丹青文学有师承。\n前身直是王摩诘，佳句还宗杜少陵。\n溪上晓来烟似幄，江南春尽雨如渑。\n扁舟催发轻离别，作恶情怀老不胜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4415,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送廷采还黄鹤山中三首 其三","author":"陶宗仪","text":"霜落松江水气清，风前一舸白鸥轻。\n十年已是三番别，两地都来几日程。\n鬓发萧萧怜我老，杯盘故故惜亲情。\n开春有约重携手，不在吴山定越城。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4416,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送邵升远应聘之京","author":"陶宗仪","text":"朝廷岁岁徵遗逸，奉诏蒐罗在有司。\n深巷穷经端可乐，诸侯劝驾不容辞。\n天威咫尺黄金阙，虎拜三千白玉墀。\n清问从容及民瘼，东南黎庶洽雍熙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4417,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送张有秩御史制阕如京师","author":"陶宗仪","text":"五采冲霄见羽仪，龙蛇研影快清时。\n报亲读礼三年毕，事主扬名四海知。\n獬廌班中曾抗疏，凤皇台上好题诗。\n沧江画鹢潮催发，不尽离愁酒一卮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4418,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送钱敬叔岁贡赴礼部","author":"陶宗仪","text":"陇头不待鹤书招，劝驾宾筵礼数饶。\n芹泮泳游才孔俊，鹏程鶱翥气弥高。\n九山霁色浮江渚，十日春风拂柳条。\n一曲骊驹频唤酒，离愁楚楚正难消。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4419,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送薛应翔人才之京名让","author":"陶宗仪","text":"持牒喜从乡老荐，画船搥鼓发江城。\n马空冀北标雄逸，凤起河东仰圣明。\n万国朝天黄道直，五云拥日泰阶平。\n旌旗研影三千字，朱绂银章被宠荣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4420,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送徐思勉应聘书诰策","author":"陶宗仪","text":"寒溪鼓棹赴弓招，雪点轻装锦作袍。\n日侍殿庭沾圣渥，职书纶綍簉清曹。\n鸾回凤舞金花轴，铁画银钩玉兔毫。\n九万鹏程从此始，登瀛视草步弥高。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4421,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送曹士望应聘书诰策","author":"陶宗仪","text":"丹诏徵贤上玉京，草堂动采乐文明。\n一经夙继春秋学，三事难忘仕宦情。\n佶曲聱牙周诰古，森严开朗晋书精。\n八銮临幸西清日，奏对铺张属俊英。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4422,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送贡士蒋时俊之京","author":"陶宗仪","text":"圣世崇文治教隆，岁徵多士赴南宫。\n贤关上舍高升日，泮水西斋静学功。\n夜雨寄怀三径竹，春风得意五花骢。\n临岐握手难为别，尊酒何时笑语同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4423,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送张宗武","author":"陶宗仪","text":"小舟冲雪向来曾，如此湖山喜快晴。\n万顷渊淳云浩渺，一峰危立玉峥嵘。\n寒生毳褐清尊益，色映乌纱白发明。\n只怕阊门明日到，春风恼乱别离情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4424,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠龟卜金谷祥","author":"陶宗仪","text":"周官太卜宝神龟，旦旦粱黄澡祓之。\n造灼钻研恭按式，谋为杌隉用稽疑。\n一人能了三人识，诸兆还从四兆推。\n独有谷祥金处士，传家术业邃于斯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4425,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"志喜","author":"陶宗仪","text":"翘首甘霖久不沾，火云赤日势如惔。\n桔槔声断川流竭，䆉稏苗枯暑气炎。\n迅电掣霆诛厉魃，苍龙饮海抉飞廉。\n四郊满慰三农意，从此丰年可预占。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4426,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次天渊韵二首 其一","author":"陶宗仪","text":"辞亲祝发已真休，孰肯将心忆故丘。\n禅榻熏炉从早夜，云筇雨笠几春秋。\n朝廷制下催归籍，罗刹江横去买舟。\n公案参馀千七百，明年试罢复来游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4427,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次天渊韵二首 其二","author":"陶宗仪","text":"风采飘飘若贯休，相逢犹忆在丹丘。\n多师妙阐三乘法，老我愁添两鬓秋。\n薝卜清芬浮雅制，凤皇空翠落归舟。\n到鄞应是无多月，又向金陵赋远游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4428,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"邵弘远用陈祠部韵赋诗见寄和以荅之 其一","author":"陶宗仪","text":"故乡遥隔一溪青，眼底湖山兴趣增。\n菊本剩栽多按谱，鱼秧新种未容罾。\n旧藏书富县签庋，重庆堂高衣采登。\n未卜何时能往访，怀人长望泖云层。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4429,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]