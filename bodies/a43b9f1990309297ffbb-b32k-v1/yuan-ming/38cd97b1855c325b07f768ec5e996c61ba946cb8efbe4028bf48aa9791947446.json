[{"title":"有题","author":"王冕","text":"红草流光锦绣衢，龙旗千乘拥金舆。\n指挥漫说丁都护，献赋可怜扬大夫。\n花压翠楼秋雨重，雪围毡屋夜灯孤。\n行人只说山川好，不信沙尘上鬓须。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":264,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂兴","author":"王冕","text":"萧萧白发满乌巾，不会趋时任客嗔。\n种菜每令除宿草，煮茶常自拾枯薪。\n屋头流水溅溅响，溪上梅花树树春。\n寄语儒林赵诗伯，好收风月作比邻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":265,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次王元之武平寺诗","author":"王冕","text":"官居正与僧居近，乘兴何妨日日来。\n因向林泉得幽致，竟忘尘世有炎埃。\n松云隐隐当窗户，花露漙漙下石苔。\n对景令人重怀古，海天秋尽鹤飞回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":266,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次古诗韵五首 其一","author":"王冕","text":"飞云添远思，淫雨滞行期。\n渐入老来景，都非少壮时。\n林昏归鸟疾，溪急上船迟。\n眼底元元弊，何人念在兹？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":267,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次古诗韵五首 其二","author":"王冕","text":"潇洒衡茅下，岁寒同此君。\n幸遗山水窟，得离虎狼群。\n有酒怀元亮，无才拟子云。\n寓形随分已，何用强求闻？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":268,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次古诗韵五首 其三","author":"王冕","text":"湖映江城白，山围故国青。\n感时花惨惨，余恨塔亭亭。\n只合从庞隐，何须学楚醒？\n归来诗景胜，苍翠满岩屏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":269,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次古诗韵五首 其四","author":"王冕","text":"蔽体可结叶，充肠难饭沙。\n风尘无日定，朋友各天涯。\n既有杯中物，那愁鬓上华。\n古今归一笑，放旷是无家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":270,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次古诗韵","author":"王冕","text":"屠沽惭壮士，文绣贵山郎。\n气习虫鱼族，风流雁鹜行。\n从时多俯仰，吊古独悲伤。\n无奈连宵雨，蜗牛上石床。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":271,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次申屠子迪韵","author":"王冕","text":"红尘车马事纷纷，高眼何曾有见闻？\n竹屋夜深时听雨，石床秋冷不生云。\n归来每爱陶彭泽，漂泊谁怜郑广文？\n门径年年芳草绿，拟将兹意问东君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":272,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次申屠子迪韵四首 其一","author":"王冕","text":"荒城余古堞，登眺喜新晴。\n日淡山容静，秋高海气清。\n孤鸢随鹤下，饥兕近人行。\n感物添惆怅，谁能会此情？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":273,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次申屠子迪韵四首 其二","author":"王冕","text":"东南岩壑窅，游子欲何之？\n野鸟惊飞疾，溪船逆上迟。\n放怀须醉酒，对景漫题诗。\n王谢经行处，萧条似旧时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":274,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次申屠子迪韵四首 其三","author":"王冕","text":"海国秋风劲，江城暮雨昏。\n浮云低月峡，戍鼓殷雷门。\n芳草何年歇？\n青山亘古存。\n光阴如过客，吾道底须论。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":275,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次申屠子迪韵四首 其四","author":"王冕","text":"白发干戈际，青山黯霭中。\n沙虫联五马，蹠卯袭三公。\n东海波涛黑，中原草树红。\n萧条岩谷底，谁信有春风？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":276,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次致和韵","author":"王冕","text":"方见云山出，忽然风雨来。\n暴生三尺水，推去一阶苔。\n古意何能解？\n新诗止自裁。\n天时与人事，历历不须猜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":277,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次答王敬助","author":"王冕","text":"束书归住水南村，且把犁锄教子孙。\n垒石旋成蒸药灶，插篱将就种瓜园。\n谈挥麈尾风生座，醉倒垆头月满轩。\n富贵功名只如此，何须多梦过侯门？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":278,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵","author":"王冕","text":"生民日日叹零丁，惟听中朝说太平。\n万里江山云莽荡，五更风雨剑悲鸣。\n桓温岂解知王猛，徐庶从来识孔明。\n箫管莫吹关塞曲，野花閒草不胜情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":279,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵","author":"王冕","text":"林宗出去满巾雨，苏老归来两屐泥。\n怀古令人时默默，感时于我独栖栖。\n春风水竹连公馆，落日烟华绕相堤。\n景物纷纷底须论，首阳高义只夷齐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":280,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵二首 其一","author":"王冕","text":"老吾濩落忘机久，江湖鸥鸟弗猜疑。\n黄花围宅如元亮，白雪满床无子期。\n身后虚名定何益，世间多事不须知。\n故人有约来招隐，莫待秋风老桂枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":281,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵二首 其二","author":"王冕","text":"野人住处无车马，门外蓬蒿抵树高。\n石脚云生三伏雨，屋头松撼五更涛。\n田园入画真堪笑，薪水供厨只自劳。\n匣底豪曹苔欲满，夜来忽作老龙号。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":282,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵全忠斋","author":"王冕","text":"十年孤影寄天涯，冷笑傍人论左车。\n白雪阳春应有价，清风明月不须赊。\n交游渐喜诗成垒，定省惟凭梦到家。\n休道焰光推不出，却愁烧杀杏园花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":283,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵答王敬助六首 其一","author":"王冕","text":"小隐水南村，喧哗不到门。\n无言及名利，适意在田园。\n春雨桑麻长，秋风果蔬繁。\n生涯有如此，何用觅桃源？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":284,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵答王敬助","author":"王冕","text":"西圃馀姜蔗，东皋足稻粱。\n今年诚有望，吾计未全荒。\n倚杖停吟久，看云引兴长。\n邻家新酿熟，同醉菊花旁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":285,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵答王敬助六首 其三","author":"王冕","text":"慷慨登高罢，风流入醉余。\n山田禾熟早，海国雁来初。\n对客无多论，耽眠或废书。\n东南岩壑美，时复命巾车。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":286,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵答王敬助六首 其四","author":"王冕","text":"野云依竹静，霜叶近窗明。\n对此清幽景，都忘喧杂声。\n看书庸有感，与世竟无情。\n但愿添松竹，期君结隐盟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":287,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵答王敬助六首 其五","author":"王冕","text":"丰年真可乐，那虑鬓边霜。\n新稻翻匙白，香韭出瓮黄。\n相逢宜脱略，不必论炎凉。\n多少清游梦，无能到帝乡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":288,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵答王敬助六首 其六","author":"王冕","text":"乡邻同社酒，亦足叙幽情。\n著作轻庄子，悲哀笑贾生。\n荒林孤鸟没，远浦夕阳明。\n休问东陵后，裁瓜即邵平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":289,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵答申屠子迪府推","author":"王冕","text":"今日风光好，梅花满屋春。\n年年长在客，事事不如人。\n道路貂裘敝，庭闱鹤发新。\n晓来看雨露，小草亦精神。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":290,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵答崔元初","author":"王冕","text":"楼居依约近蓬莱，每见天官簇仗来。\n星绕紫微双阙近，日临仙掌五云开。\n旌旗影动黄金表，龙马风生白玉台。\n遥望上林花隐隐，乾坤清气一时回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":291,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵答樊山四首 其一","author":"王冕","text":"余生百计拙，世事复何言？\n得句閒题石，忘机或灌园。\n每怜鱼涸辙，多见鹤乘轩。\n薄暮山风急，秋声处处繁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":292,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵答樊山四首 其二","author":"王冕","text":"功名多跋涉，贫贱得安閒。\n坐石听流水，开楼见远山。\n报衙蜂澒洞，悦景鸟绵蛮。\n更爱斜阳外，游云作阵还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":293,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵答樊山四首 其三","author":"王冕","text":"山川今古在，伯业已寥寥。\n野雾迷花径，秋烟隔市桥。\n溪深新涨雨，江浊暗生潮。\n自喜兹行好，翩翩远市嚣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":294,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵答樊山四首 其四","author":"王冕","text":"市廛余热恼，岩壑足清凉。\n水静鱼儿乐，风微桂子香。\n异邦人苦雨，故国雁啼霜。\n秋晚何多事？\n吟诗送客忙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":295,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江月楼","author":"王冕","text":"永嘉城郭如斗样，魁峰兰若倚青霄。\n江空月色上楼白，风挟海声连地摇。\n高僧居此兴不浅，閒客登临思亦饶。\n我欲与君飞舞去，更呼仙子共吹箫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":296,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"竹西轩","author":"王冕","text":"青山隐隐带江流，江上轩窗面面幽。\n来客不辞三径雨，乘凉常得四时秋。\n青天影动朝阳凤，落月光移隔水楼。\n夜半梦回环佩响，却疑歌吹在扬州。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":297,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"竹图","author":"王冕","text":"楚地秋风劲，湘江夜雨深。\n不看双凤舞，恰听老龙吟。\n正直崇高节，岁寒同我心。\n悠悠向京国，转转忆山阴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":298,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"竹冠","author":"王冕","text":"竹冠横五折，安用铁丝旒？\n斑积湘江雨，清衔嶰谷秋？\n自然坚节在，难与俗情侔。\n相见无疑怪，先生不姓刘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":299,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"纪梦","author":"王冕","text":"十有一月三十夜，清梦忽然归到家。\n对母徐徐言世事，呼儿故故问生涯。\n庭前修竹不改色，溪上老梅都是花。\n起坐山窗听茶鼎，又思风雨客三巴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":300,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自咏","author":"王冕","text":"清苦谁能共，孤高只自怜。\n为因知定分，不解问归田。\n对酒伤春思，看书减夜眠。\n信无朝贺表，留病过新年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":301,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟中杂纪十首 其一","author":"王冕","text":"水竹连平野，人家带夕阳。\n道途忘险阻，风景异寻常。\n借艇移行李，持杯看步光。\n英雄无所似，堪笑老夫狂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":302,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟中杂纪十首 其二","author":"王冕","text":"舟行知牵稳，恰得打头风。\n更喜青山出，宁辞白发穷？\n江枫缘岸赤，河蓼杂烟红。\n回首东南景，楼台杳霭中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":303,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟中杂纪十首 其三","author":"王冕","text":"杨柳青云合，芙蓉锦幛开。\n船从湖上过，人在画中来。\n莫问桓伊笛，且传袁绍杯。\n明朝归醉李，舒啸漫徘徊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":304,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟中杂纪十首 其四","author":"王冕","text":"泊舟枯柳下，狭港喜无风。\n水气团烟暝，岚光带雨浓。\n竹阴秋转冷，渔火夜深红。\n忆在山阳县，吟情与此同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":305,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟中杂纪十首 其五","author":"王冕","text":"芦花藏别浦，柳树隔柴扉。\n野鸟行行下，渔舟两两归。\n只愁风俗变，不虑世情违。\n旧日经行处，于今转觉非。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":306,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟中杂纪十首 其六","author":"王冕","text":"秋茂喜禾壮，官河带野桥。\n水光欺日白，寒气得风饶。\n觅火邻船并，沽醪市店遥。\n传闻征税急，不忍见渔樵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":307,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟中杂纪十首 其七","author":"王冕","text":"九日今朝是，凄凄多朔风。\n黄叶浑未落，乌柏最先红。\n对景情何已，怀人梦不通。\n稻粱今岁薄，无奈北征鸿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":308,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟中杂纪十首 其八","author":"王冕","text":"落日照船窗，残霞映碧江。\n树低苍翠湿，人杂语言哤。\n贳酒青衣独，归山白鸟双。\n驱驰吾未已，惭愧鹿门庞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":309,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟中杂纪十首 其九","author":"王冕","text":"野水连天碧，秋花夹路黄。\n顺风船过疾，落日鸟飞忙。\n感物独惆怅，逢时喜老苍。\n文章随气运，不必论班扬。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":310,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟中杂纪十首 其十","author":"王冕","text":"老树转斜晖，人家水竹围。\n露深花气冷，霜降蟹膏肥。\n沽酒心何壮，看山思欲飞。\n操舟有吴女，双桨唱新归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":311,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"访旧游","author":"王冕","text":"今日放轻舟，令人忆旧游。\n看花穿水竹，沽酒近江楼。\n故老论遗俗，相知已白头。\n晚来乡思切，孤雁楚天秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":312,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过水南","author":"王冕","text":"一到水南宅，喧嚣便不闻。\n窗梅晴破雪，庭树暖凌云。\n閒话经年别，忘眠过夜分。\n何时卜邻住？\n会老细论文。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":313,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过扬州","author":"王冕","text":"东南重镇是扬州，分野星辰近斗牛。\n人物渐分南北早，江淮不改古今流。\n琼花香委神仙佩，杨柳风閒帝子舟。\n十里朱帘晴不下，银罂翠管满红楼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":314,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过京口","author":"王冕","text":"瓜洲正对西津渡，金山焦山江水中。\n过客放船忌险阻，何人击楫问英雄？\n白云渺渺生秋树，黄叶萧萧落晚风。\n铁瓮城头一登眺，天南天北思无穷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":315,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过武塘","author":"王冕","text":"青衫闸转云间路，河水分流过武塘。\n客路惯经风雨恶，诗情不减少年狂。\n鱼盐市井三吴俗，番岛舟航十丈樯。\n杨柳之堤鹅鸭聚，家家茅屋似淮乡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":316,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过徐州洪至丰沛作","author":"王冕","text":"落月苍凉野色迷，过洪忽听五更鸡。\n河流东海奔腾去，天近中原渐觉低。\n败垒有基栖碧草，古台无石堕青泥。\n汉家住处人能识，只在丰南沛水西。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":317,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"白马湖","author":"王冕","text":"十八里河船不行，江头日日问潮生。\n未同待诏沈金马，却异看花在锦城。\n万里春风归思好，四更寒雨客灯明。\n故人湖海襟怀古，能话旧时鸥鹭盟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":318,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过?陵","author":"王冕","text":"泥马南飞王气消，大梁昌运委蓬蒿。\n两宫旒冕沈沙漠，三国旌旗接羽毛。\n卫下将军尚颇牧，关中丞相失萧曹。\n东南多有青松树，争奈春风种不牢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":319,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"别友","author":"王冕","text":"吴松江上听春雨，共说乡关动寂寥。\n满地落花增感慨，故家乔木已萧条。\n十年旧事浑疑梦，一别离情转觉饶。\n后夜钱塘望明月，鬓华无奈雪飘飘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":320,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"别金陵","author":"王冕","text":"六朝旧迹俱寻遍，千古英雄一笑休。\n黄叶乱随秋雨落，长江空带楚天流。\n樽前有客翻新调，白下无人说故侯。\n明日西风天色好，吹箫骑鹤上扬州。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":321,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"即事","author":"王冕","text":"五色云开见太平，九天风露一时清。\n燕雀飞飞自得乐，草木欣欣俱向荣。\n渭川何时起尚父，宣室安能召贾生？\n田间野老罢癃甚，忍死愿观风化成。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":322,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"即事二首 其一","author":"王冕","text":"滦水城头六月霜，东华门外草皆黄。\n旌旂影动千官惨，斧钺光沉万马忙。\n青象不将传国玺，紫驼只引旧毡房。\n诸郎不解风尘恶，争指红门入建章。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":323,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"即事二首 其一","author":"王冕","text":"云暗山如醉，风来树若颠。\n怀人多有梦，忧国少安眠。\n江海浮鸥鸟，山林叫杜鹃。\n老生头已白，见景忽凄然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":324,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"即事二首 其二","author":"王冕","text":"白草黄沙野色分，古今愁恨满乾坤。\n飞鸿点点来边塞，寒雪纷纷落蓟门。\n风景凄凉只如此，人情嚣薄复何论。\n知机可有桑乾水，未入沧溟早自浑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":325,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"即事二首 其二","author":"王冕","text":"草径无人到，柴门尽日关。\n脱巾垂白发，把酒对青山。\n世薄惊时异，身贫得梦閒。\n夜深明月下，吟待鹤飞还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":326,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"即景","author":"王冕","text":"江北春深野草芳，江南春浅柳枝黄。\n凫鸥得水竞出没，寒雀受风相颉颃。\n适意漫提如意舞，醒时不异醉时狂。\n昨朝孺子拦街笑，笑杀人间马子长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":327,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"听秋轩","author":"王冕","text":"人世红尘高没马，老禅方丈足清幽。\n入门便觉气侯别，历耳似知天地秋。\n不羡书生能作赋，却怜游子太多愁。\n夜来树影飘零尽，明月无端生屋头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":328,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]