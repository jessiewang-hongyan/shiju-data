[{"title":"破屋","author":"王翰","text":"大梁城内宋门前，借得卢仝屋数椽。\n一片危墙将倒地，四周破瓦好窥天。\n风穿每恨尘凝座，雨漏长忧湿满毡。\n欲向浣花新卜筑，无人为送草堂钱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13796,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送马文隆县令归临颍","author":"王翰","text":"醉把离杯汴水头，大梁风物又新秋。\n金门赐宴连朝醉，华馆题诗数日留。\n斛麦每承贤宰送，绨袍不待故人求。\n乞书傥许归桑梓，投老瑶台续旧游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13797,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丹山归隐","author":"王翰","text":"洞天深入结茅茨，陶令归来鬓未丝。\n筱簜拂檐巢翡翠，蒹葭近钓隐鸬鹚。\n细炊白石能成饭，净扫苍苔好看棋。\n纵有徵书何处觅，桃源去路少人知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13798,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"慈竹轩","author":"王翰","text":"何物风摽可悦神，数竿脩竹杂兰荪。\n开轩翠色连书幌，隐几清阴落酒樽。\n未睹朝阳鸣鸑鷟，方欣春雨长儿孙。\n羡君得此堪娱老，况复高堂更树萱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13799,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉教题夷山晚望图","author":"王翰","text":"朝朝鹤驾驻山头，极目天南是越州。\n洱海川原何日到，蜀江风浪几回留。\n鹡鸰每诵常联榻，花萼相辉共倚楼。\n友爱天伦情最切，别来几许鬓成秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13800,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古山道人诗卷","author":"王翰","text":"青山峨峨自太古，中有物外真仙人。\n一朝不随舜花昼，千载要见蟠桃春。\n初平入山羊作队，丁令还家鹤语神。\n自今好觅麻姑去，看到沧海飞黄尘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13801,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"临池清兴为张敬惟作二首 其一","author":"王翰","text":"夷山山下有行窝，池水经春绿似萝。\n佳客到门常载酒，道人求字不笼鹅。\n树连别院莺声滑，苔长閒庭鸟迹多。\n自是心传有家法，莫忘三折始成波。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13802,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"临池清兴为张敬惟作二首 其二","author":"王翰","text":"梁园杂沓市尘红，中有幽人趣不同。\n门掩绿苔行白鹤，窗开苍雪落青松。\n晴泥汨汨蟠蚯蚓，春水深深见活东。\n好似高情陶靖节，求工元不在丝桐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13803,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送陈惟一司训还鄢陵伯振教授写墨竹以送予就题于上","author":"王翰","text":"曾上陈家聚德亭，云孙典教继家声。\n许由祠下花连坞，彭祖岗边水绕城。\n纂史王门存藻鉴，横经庠序乐群英。\n广文特写寒梢碧，为表平生一节贞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13804,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"人日喜晴和体方伴读韵","author":"王翰","text":"年年此日不常晴，今日晴光品物生。\n地底昆虫将启蛰，世间草木尽回荣。\n璿玑运转天时正，玉烛调和气候平。\n且喜新正风景好，题诗不似剑南情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13805,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谷日喜晴和体方韵","author":"王翰","text":"谷旦占年喜得晴，春来无物不回生。\n日升旸谷冰初泮，星转苍龙木向荣。\n斗米三钱书岁稔，遗蝗千尺见时平。\n风流只有梁园客，特寄新诗为写情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13806,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送金伴读归汝宁省家","author":"王翰","text":"大梁门外分襟处，南望白云是蔡州。\n且喜承恩延讲席，又蒙荣赐上归舟。\n幽轩月上吴城闭，洄曲春生汝水流。\n及到家庭元夕近，满街灯火照欢游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13807,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送郭工副焕章之汝宁放粮","author":"王翰","text":"羡公本是汾阳后，致用还优经济才。\n千里黄尘承命去，万仓红粟被恩开。\n柳添新绿遮文旆，梅送残香入酒杯。\n莫待梁园春事已，公馀策马早归来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13808,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和体方游相国寺","author":"王翰","text":"夷山宝刹自唐家，石塔横空半欲斜。\n神鹿听经翻贝叶，毒龙喷水出昙华。\n咒师碧眼浑如鹄，老衲弓身曲似虾。\n知我登堂来问法，呼童先点赵州茶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13809,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题驺虞图","author":"王翰","text":"阳翟山前洛水滨，驺虞瑞世自惊人。\n珠玑落纸矜能赋，金碧争辉看写真。\n猛气折冲风淅沥，素毛抖擞雪精神。\n适来拜赐端门下，他日披观胜凤麟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13810,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"琴月轩诗卷","author":"王翰","text":"幽人独坐敞华亭，霁宇无尘河汉横。\n窗纸渐明知月上，琴丝微冷觉秋生。\n霜凝碧树乌三绕，露下苍苔鹤一鸣。\n更得梅花相慰藉，闻香三弄不胜清。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13811,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画竹为胡子澄作","author":"王翰","text":"伶伦截得碧琅玕，袅袅新梢露未乾。\n便与钧天裁凤管，不将江浦制鱼竿。\n苍梧帝子蛾眉老，空谷佳人翠袖寒。\n只有幽轩隐君子，时时写入画图看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13812,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽草堂李先生为李居恭","author":"王翰","text":"文江江上草堂宽，游宦归来鬓已皤。\n酒饮贤人秋社散，星亡处士夜台寒。\n诗成自挽应难和，琴在无弦不用弹。\n自是承家有新录，埋名千古便须刊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13813,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉教送汝阳王之国汝宁","author":"王翰","text":"宗藩百世镇夷门，列郡分封合礼文。\n仙李盘根随地盛，银潢泻?自天分。\n山川西去连秦晋，风教南来及汝坟。\n此去贤王思圣泽，千年职贡效殷勤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13814,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客中清明","author":"王翰","text":"梁园三月遇清明，旅况萧条百感生。\n故苑雨馀春草绿，高城日上晓烟轻。\n花间歌管欢娱动，月下鞦韆笑语声。\n老去更无儿女念，秪馀拜扫最关情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13815,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"环翠堂二首为王审理 其一","author":"王翰","text":"一曲清流上四围，世家种德有馀辉。\n亲藩开卷题金薤，令子趋庭着绣衣。\n风引晴岚来几席，鸟拖秋色入檐扉。\n江山孕秀门庭贵，夹路青槐四牡騑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13816,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"环翠堂二首为王审理 其二","author":"王翰","text":"华堂夙构玉为屏，故相当年识地灵。\n诸子凤毛成令器，双亲鹤发见遐龄。\n门前秋水千寻碧，窗外寒山四面青。\n珍重贤王挥彩笔，流传百代播芳馨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13817,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题瞿德皋奉亲读书处","author":"王翰","text":"日向华堂奉起居，夜归芸阁坐观书。\n养亲愿祝千龄寿，稽古须通万卷馀。\n汗简青青裁楚竹，厨羹白白馔江鱼。\n它时会作龙头客，忠孝传家定不虚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13818,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梁园言怀","author":"王翰","text":"秋入梁园木叶稀，可怜归计尚栖迟。\n形骸不为裁诗瘦，鬓发还因览镜悲。\n官路未通身已老，文章虽好数先奇。\n囊中清俸馀多少，又被穷人五鬼知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13819,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寒潭渔隐","author":"王翰","text":"浪迹江湖作散人，碧潭霜冷见潜鳞。\n芦华织被长眠雪，荷叶裁衣不涴尘。\n载酒几回寻贺老，画图何处访玄真。\n自今已是成嘉遁，莫向桃源别问津。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13820,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"慎独斋","author":"王翰","text":"危坐穷经得趣深，敬存直欲禁邪淫。\n道求实用惟王业，学到真知见圣心。\n方寸不欹天地位，气机才动鬼神临。\n先生犹恐多岐盛，用扁高斋要自箴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13821,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送赵炼师归白云庵","author":"王翰","text":"白云庵对白云岑，殿宇峥嵘云气深。\n袅袅青猿啼竹里，双双赤鲤见潭心。\n灵风䬃爽神君至，秋月空明木客吟。\n羡子早年归福地，愧予何日遂投簪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13822,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"暮秋梁园言怀呈体方伯振二诗伯 其一","author":"王翰","text":"一夕青霜木叶残，地炉无火客衣单。\n敢思潋滟葡萄酿，孰厌阑干苜蓿盘。\n交到忘形贫亦好，拙知学步老尤难。\n涓埃未报君恩重，不欲归田学挂冠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13823,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"暮秋梁园言怀呈体方伯振二诗伯 其二 送时志秀才赴礼闱","author":"王翰","text":"梁园自古文辞盛，解后怜公有俊才。\n大器不为三语掾，雄文夺得一经魁。\n凤凰台上诗情好，龙虎榜头春意回。\n想到京华方二月，须凭归雁寄音来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13824,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和赐瞿长史象牙笏韵","author":"王翰","text":"周旋庭陛已多年，名器新颁秩九迁。\n价重一双和氏璧，赐同十万水衡钱。\n摛辞每搢金坡下，对命高擎玉殿前。\n旧物青毡何足贵，好俱簪绶盛家传。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13825,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉教和王达善学士梅花四咏 其一 梅影","author":"王翰","text":"黄昏相对自清神，移上阑干似写真。\n窗外横斜因得月，水边凌乱正愁人。\n瘦宜苔径偏留迹，雅比花阴不染尘。\n何必临风香万斛，一枝摇弄自生春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13826,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉教和王达善学士梅花四咏 其二 梅香","author":"王翰","text":"雪为丰采月为神，檀蕊风传始辨真。\n高似广寒攀桂客，幽如湘水佩兰人。\n冰蕤吹破黄金粟，玉骨薰秾紫麝尘。\n世上群芳孰可比，可怜茉莉属残春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13827,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉教和王达善学士梅花四咏 其三 梅魂","author":"王翰","text":"秪疑姑射是花神，傲兀风霜可见真。\n庾岭有情能驻马，罗浮无梦更迷人。\n冰花借月方成魄，雪态生香自出尘。\n一段素灵招不得，谁家纸帐又添春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13828,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉教和王达善学士梅花四咏 其四 梅格","author":"王翰","text":"皓彩名香总入神，世间俗眼久迷真。\n靓妆可比惟西子，艳态相看是北人。\n篱菊也贪彭泽酒，海棠终污马嵬尘。\n古来知己林和靖，别作孤山一样春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13829,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"世府赐新荔枝","author":"王翰","text":"门山岁岁献时新，飞舸凌波不动尘。\n露颗摘来方盛夏，风花开处正芳春。\n浓含异味真堪贡，远带馀香足可珍。\n金殿翠盘方进罢，分尝何幸到愚臣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13830,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"对月和卞长史韵","author":"王翰","text":"沧溟东望色浮金，转上寒空秋已深。\n我欲登楼乘逸兴，谁能对影有新吟。\n悬知此夕三更月，曾照前人万古心。\n唤醒谪仙波底醉，一壶芳酒与同斟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13831,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉教和秋日四题 其一 秋意","author":"王翰","text":"黄昏帘幕雨纤纤，一段凄凉到枕边。\n冉冉光阴留不住，悽悽情思苦难传。\n潘安有兴因他遣，宋玉多愁为此牵。\n争似无心随化尽，数杯閒卧钓鱼船。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13832,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉教和秋日四题 其三 秋色","author":"王翰","text":"岚光淡淡复浓浓，多在园林夕照中。\n绿减一川烟际草，红添千树水边枫。\n落霞孤鹜吟难尽，折苇残荷画不工。\n只有谪仙情思苦，灞陵伤别意无穷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13833,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉教和秋日四题 其四 秋声","author":"王翰","text":"客窗欹枕梦难成，风入空檐爽籁生。\n穿过竹间金奏响，飘来松顶翠涛惊。\n一声长笛吹霜急，万户清砧捣月明。\n不识砌蛩缘底事，向人也作不平鸣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13834,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"陈如心家饮罢言怀","author":"王翰","text":"饮罢高斋借榻眠，卧听更漏意萧然。\n空床梦断雨方急，短烛吟残花倒悬。\n旧馆偶来还是客，明公相见即如仙。\n奔腾老骥浑无力，拟向亨途借一鞭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13835,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"驴死口号简孙知县","author":"王翰","text":"每向家山驼醉归，长鸣曾入浣花溪。\n寻诗不畏途冲雪，沽酒那忧路有泥。\n贫里市来浑似马，客中亡去弃如鸡。\n吴山不是多贤旧，便欲徒归尘土迷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13836,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻呼鹰","author":"王翰","text":"九月清霜杀草莱，谁人出猎傍山隈。\n一声高向林边起，大翮翻从云外来。\n秪为恋恩飞不去，岂因求食唤将回。\n当年亦有荆州牧，曾筑秋风百尺台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13837,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和成纪善许州怀古","author":"王翰","text":"汉季英雄总不如，开屯迁许造邦初。\n水生江口愁难渡，火烈矶头怨未除。\n月照禅台文甓断，风穿献庙玉床虚。\n寒烟衰草繁昌道，欲读残碑几字馀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13838,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"三省轩","author":"王翰","text":"一片灵台玉琢成，时时点检要惺惺。\n通开旧壁方窥月，澄净污池始见星。\n几树好梅连屋白，满庭芳草入帘青。\n功夫到此规模大，不为区区老一经。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13839,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和王道录韵其人尝住茅山 其二","author":"王翰","text":"勾曲仙山紫翠浓，茅君出入跨天风。\n高林卖杏曾教虎，大鼎烧丹乞与龙。\n瑶草种成连涧碧，蟠桃看得满林红。\n何时来问长生诀，还入群羊觅牧童。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13840,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪禁体","author":"王翰","text":"彤云垂地四茫茫，微霰初零集下堂。\n重压竹梢还欲折，密封梅蕊不能香。\n气凌杯酒浑无力，冻涩琴弦已不张。\n拟学欧公吟白战，挑灯痴坐恼诗肠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13841,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再用前韵","author":"王翰","text":"北风吹雪正微茫，无间茅茨与画堂。\n留得映书遍瑩洁，扫来煮茗更清香。\n冻坚玉漏应难滴，力劲雕弓不易张。\n只有灞桥驴背客，敲诗搜遍九回肠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13842,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和黄体方伴读雪中即事","author":"王翰","text":"凛凛阴风捲暮霞，朝看庭树总开花。\n渔舟一叶迷烟渚，猎骑千群踏晚沙。\n淡抹墙腰疑月色，旋添池面结冰华。\n乾坤万象俱清绝，何问陶家与党家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13843,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉教和怀友诗韵","author":"王翰","text":"南望停云思有馀，两经霜叶落庭除。\n故人一去长悬榻，驿使重来不寄书。\n终日倚栏吟伐木，何时对酒赋嘉鱼。\n转头又近重阳节，孰与登高共把萸。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13844,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和韵送陆员外","author":"王翰","text":"邂逅梁园始识君，喜瞻眉宇胜空闻。\n胸中泉石元无价，笔底珠玑迥不群。\n一曲离歌迷汴水，满襟归兴隔江云。\n何时共贳金陵酒，对景新题兴更分。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13845,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"扈从郑门迎驾","author":"王翰","text":"万里西来渡跋提，贤王亲迓筑沙堤。\n昙花水冷苍龙蛰，贝叶芸香白马嘶。\n郁郁彩云高捧日，纷纷花雨净无泥。\n归依大觉资王化，更演洪恩及庶黎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13846,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和刘菊庄先生韵 其一","author":"王翰","text":"中条西畔筑高亭，夜读林皋灯散星。\n雨足小园催种药，雪埋孤砚为穷经。\n疏梅得月连窗白，芳草和烟满径青。\n拟和小山招隐句，他时把酒与君听。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13847,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和刘菊庄先生韵 其二","author":"王翰","text":"家近王官旧有亭，十年为客鬓星星。\n心同陶令惟疏酒，宗继文中不续经。\n俗子每看双眼白，故人相对一灯青。\n挂冠欲买扁舟去，说与沙鸥亦不听。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13848,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和黄伴读雪意","author":"王翰","text":"彤云水墨写难工，四野苍茫一望中。\n三麦正欣沾臈雪，千林先与战东风。\n昏昏淡月惊枝鹊，漠漠飞沙失塞鸿。\n乘兴有时佳客过，莫教相对酒樽空。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13849,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谢士烈送柴","author":"王翰","text":"三年为客住梁园，两眼昏眵雪满颠。\n诗好每教高士许，家贫多得故人怜。\n驱寒但恨樽无酒，借煖今欣灶有烟。\n惭愧题书问馀用，欲求刍豆苦无钱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13850,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和体方立春日暄晴","author":"王翰","text":"春透帘栊已解寒，春盘相送拟追欢。\n轻冰向暖难成冻，残雪经销不作团。\n阶下草芽方展绿，枝头梅子已生酸。\n袁安今有伸眉意，莫作冬前故态看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13851,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送陈参政任满赴京","author":"王翰","text":"佳政曾闻儗岘山，名邦佐治笑谈间。\n官衔旧侍金銮殿，人物今联玉笋班。\n汴水放船冰已泮，隋堤送别柳初攀。\n百寮祖帐东门盛，冠盖朝天望早还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13852,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春雪","author":"王翰","text":"一冬天气喜温温，留作春寒故恼人。\n密洒纸窗疑是雨，旋铺芳径不生尘。\n舞同柳絮能争巧，飞入梅花竟乱真。\n赋罢兔园看霁景，梁台草色一番新。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13853,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题王审理山居幽趣图","author":"王翰","text":"买得青山似画屏，石田茅屋称幽情。\n晓分竹色连窗碧，夜送泉声到枕清。\n松下湿衣闻露滴，溪边倚杖看云生。\n他年报答君恩重，归去重寻鸥鹭盟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13854,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春雨亭","author":"王翰","text":"仪封教官亭子好，春雨题名意更深。\n云起远山凝望眼，雨鸣孤枕又惊心。\n纷纷草木生还足，忽忽光阴老易侵。\n不为东皋农事喜，一犁端直万黄金。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13855,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]