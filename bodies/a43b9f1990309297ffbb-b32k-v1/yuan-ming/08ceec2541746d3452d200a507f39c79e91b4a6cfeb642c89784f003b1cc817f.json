[{"title":"吴中柳枝七首 其四","author":"陈秀民","text":"棠梨花开郎出门，宜男草生妾思君。\n如何宜男草上露，不湿棠梨花底云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2804,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"岳阳楼夜宿","author":"陈秀民","text":"湘灵瑟鼓潇潇夜，龙女笙吹淡淡秋。\n楚曲吴歌互相答，岭猿巴鸟不胜愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2805,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"周玄初来鹤诗","author":"陈秀民","text":"天外谁呼众鹤来，坛前道士本仙才。\n月明辽海通三岛，能载飞琼数往回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2806,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"早春寄周致尧","author":"陈雷","text":"百年身世浑如寄，何处他乡是故乡。\n柳态正须春弄色，梅花自与雪生香。\n扬雄寂寞玄犹白，贺监风流醉亦狂。\n倘许胜缘同晚岁，梨林风致即柴桑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2807,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"戍妇吟 其一","author":"刘仁本","text":"夫君在边戍，妾身守孤帏。\n欲往备纫栉，不如频寄衣。\n衣到恐迟迟，不到妾不知。\n欲知衣到无，明年鸿雁归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2808,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"戍妇吟 其二","author":"刘仁本","text":"将军功未成，持牛劳军士。\n将军岂无家，为妾语夫主。\n勿为贱妾生，宁为将军死。\n贱妾欲从之，军中无女子。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2809,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"蕨萁行（闽清县饥，不报，民采蕨萁为食而多死者，作《蕨萁行》）","author":"刘仁本","text":"东山有蕨萁，南山有蕨萁。\n西山有蕨萁，北山有蕨萁。\n采采蕨萁，晨露未晞。\n荆棘离披，筐筥携持。\n长镵深入土，短褐寒风吹。\n采采蕨萁，可以疗饥。\n以簸以炊，为饧为饴。\n食少不下咽，食多伤人脾。\n去年岁歉食无糜，橡栗拾尽民流离。\n今年岁歉田无稗，蕨萁食尽将安之？\n美食大官馔，仁心宁汝悲？\n但见昨日奏麦两歧，今日进五色芝，呈祥献瑞无休时，载膏载脂，驿骑驱驰。\n蕨萁蕨萁，官独不汝知！\n已而已而，岁云莫矣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2810,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"述言 其一","author":"刘仁本","text":"黄河失故道，横流奔四驰。\n楮币更新法，世乱不可支。\n承平日既久，弛张教乃堕。\n变故始有作，虽多亦奚为。\n是用干戈起，民生未可期。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2811,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"述言 其二","author":"刘仁本","text":"胶柱难鼓瑟，甚者当解弦。\n造车不合辙，出门行莫前。\n弦更紊古调，车徒反旧辕。\n姚虞世既远，雅奏不复宣。\n姬公指南作，矩度谁能传。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2812,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"述言 其三","author":"刘仁本","text":"波颓四海沸，势危天下竞。\n大夫拥专城，陪臣干国政。\n布衣操刃梃，亦执生杀柄。\n边将总兵戎，朝廷孰号令。\n何日能底平，拯溺跻民命。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2813,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"述言 其四","author":"刘仁本","text":"桓桓杨将军，落落真英杰。\n亹亹却红巾，凛凛持金节。\n保障东南区，边疆靡蹉跌。\n大功曾未成，身名遽磨灭。\n谁令养虓虎，逾圈乃自啮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2814,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"述言 其五","author":"刘仁本","text":"东南有壮士，矫激如飞鸿。\n手持三尺铁，腰悬两石弓。\n去年曾射海，今年能杀红。\n归来在麾下，主将不论功。\n吁气为我言，世道何由隆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2815,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"述言 其六","author":"刘仁本","text":"吕秦御大柄，国富兵亦强。\n耽耽为虎视，黔首愚莫当。\n一夫忽作难，鹿走中原场。\n云胡万年业，乃止二世亡。\n王纲尽崩裂，狂羁乌能长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2816,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"述言 其七","author":"刘仁本","text":"经营百尺构，抡才须豫章。\n驱驰万里道，驾驭必乘黄。\n君看樗枥姿，壅肿诚匪良。\n驽骀但刍秣，不可以服箱。\n工师与从御，取舍当审将。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2817,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过枫亭驿和周草庭巡检韵就寄","author":"刘仁本","text":"馈粮千里又南征，笑犯弓刀拥将星。\n汗血沙尘前后骑，檄书烽火短长亭。\n天连闽海团团白，山绕彭湖点点青。\n遥想环峰三十六，将军晏坐对沧溟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2818,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再往三山","author":"刘仁本","text":"去岁才从上海还，今年又复戴南冠。\n榕阴巷陌春风老，荔子楼台宿雨乾。\n几处旧游重载酒，十年往事一凭阑。\n回头却羡天台道，有客吹箫跨玉鸾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2819,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"清丽曲","author":"方行","text":"江花绕琼阙，绿水带朱楼。\n开宴坐清夜，飞觞凌素秋。\n美人明月佩，仙客紫云裘。\n生世真飘忽，应当秉烛游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2820,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题吴彦嘉所藏张秋蟾龙图","author":"方行","text":"张公画龙人不识，笔法远自僧繇得。\n挂向高堂神鬼惊，恍忽电光来破壁。\n夜当渤澥开笔力，元气淋淫浸无极。\n吞吐日月天地昏，摩荡云雷太阴黑。\n江翻石转窅莫测，雪涛捲空铜柱侧。\n洞庭扶桑非尔谁，颠倒沧溟为窟宅。\n乃知前图只数尺，坐令万里起古色。\n何当置我君山湖上之高峰，听此老翁吹铁笛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2821,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"东归谣送贝仲琚回吴中","author":"方行","text":"天目青逾蓝，上有危峰横空插汉高巉岩。\n沧海深莫测，下有六鳌迭负蓬壶方丈于其侧。\n山峻极兮水波澜，千盘万折行路难。\n愁看混沌开凿处，尚有斧迹留人间。\n殳山仙翁发如雪，胸蟠太和吐日月。\n手中鍊石轻女娲，五色曾将补天裂。\n忆闻羽客从之游，青霞光乱云锦裘。\n金鸡叫海白日惨，桂树四落空山愁。\n昔年寒月照樽俎，明珠百斛轻于土。\n君山铁笛悲向人，羞杀堂前柳枝舞。\n君归东吴怀故庐，明星古宅非吾居。\n会稽泱漭浙江险，谁探千载太史禹穴之遗书。\n兴因东归发，遂作《东归谣》。\n他年相忆五情热，应知泪湿双龙绡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2822,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和马贯五松小龙女歌","author":"方行","text":"五松小姑龙帝女，绰绰飞珰夜行雨。\n天吴移海醉不归，江色千年作谁主。\n漂星辗月流翠滑，青霓曳裾玳窗八。\n同心镂结寄玉郎，复叠毾㲪制霞袜。\n玉罂转水月独漉，綷䌨香裾蹙兰屋。\n閒掷明珠赠宓妃，一片长眉写新绿。\n罦罳瑶殿罩何年？\n排空凤管冲九天。\n割鲜不食起鸣弦，水波帖玉无惊烟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2823,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"复和五松小龙女歌答卢轩","author":"方行","text":"东方龙君降灵女，腾飙曳烟轧腥雨。\n扑花扫海神为悲，玉帝封为九河主。\n贝宫铜龙刺云滑，彤台斗玉蛟柱八。\n琼丝络凤骑紫霞，金帖珑珑水晶袜。\n鳌头牵波月簌漉，翠幄银屏沓珠屋。\n倒窣天瓢浇火龙，九点齐州一时绿。\n挝钟欢饮邀万年，花宫盘盘象青天。\n湘妃献乐鼓冰弦，下窥四海销氛烟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2824,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠相虚中上人","author":"方行","text":"一室安禅久，三生结愿频。\n传经来帝子，送食下天神。\n水月虚空相，山云自在身。\n慈航如可渡，应许姓庞人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2825,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过太湖","author":"方行","text":"震泽留遗号，行人指太湖。\n封疆连旧垒，形势压全吴。\n水落鱼龙蛰，天寒雁鹜呼。\n扁舟思范蠡，吾亦老樵苏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2826,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登秦驻山","author":"方行","text":"此地曾经驻跸来，秦皇遗迹尚崔嵬。\n采穷沧海无灵药，归到骊山有劫灰。\n万里黑风迷鬼国，一杯弱水隔蓬莱。\n诗人吊古应多思，落日高丘首重回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2827,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登子胥庙因观钱塘江潮","author":"方行","text":"吴越中分两岸开，怒涛千古响奔雷。\n子胥不作忠臣死，勾践终非霸主材。\n岁月消磨人自老，江山壮丽我重来。\n鸱夷铁箭俱安在，目断洪波万里回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2828,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送殷文学之关中","author":"方行","text":"博士才名成老翁，又随声教向关中。\n百年礼乐今重见，万国车书喜会同。\n泰华云开仙掌出，昆明水冷劫灰空。\n他时太史瞻星地，应说奎光聚井东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2829,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杨柳词二首 其一","author":"方行","text":"韶华无限暗中消，摇荡春光几万条。\n却怪晚来风定后，雪花飞满赤栏桥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2830,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杨柳词二首 其二","author":"方行","text":"曲江南陌乱垂烟，勾引春风入管弦。\n惆怅几枝憔悴尽，与人长系别离船。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2831,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题美人图","author":"方行","text":"白玉帘开露气浮，芙蓉花近紫金钩。\n《阳春》一曲无人识，空拂银筝下翠楼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2832,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"閒居","author":"方行","text":"弦管春深绕画楼，微风吹动玉帘钩。\n倡条冶叶俱无恙，相伴丁香结暮愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2833,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江南词","author":"方行","text":"暖气晴娇杜若洲，沙头狂客系兰舟。\n采蘋多少江南女，摇荡春光不自由。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2834,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送赵将军","author":"陈有定","text":"纵横薄海内，不怆别离颜。\n几载飘零意，秋风一剑寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2835,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"被收作","author":"陈有定","text":"失势非人事，重围戟似林。\n乾坤今已老，不死旧臣心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2836,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南宋故内怀古","author":"刘仁本","text":"山抹微云锁凤腰，御沟流水海鲜桥。\n西番杖锡居中阙，南渡衣冠尽北朝。\n九庙山陵孤塔雨，千年城郭半江潮。\n向南古木何人墓，岳将忠魂黯未消。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2837,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"大慈寺史丞相墓","author":"刘仁本","text":"山行十里乱峰回，相国坟茔紫翠堆。\n石马秋风两翁仲，杜鹃春雨几亭台。\n慈云塔下苍苔满，旌德观前红杏开。\n为忆当年莼菜美，短篷蘋末过湖来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2838,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宫词","author":"刘仁本","text":"舞靴轻转玉阶前，忆昔承恩已十年。\n记得当时供奉曲，上皇新自月宫传。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2839,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送郑同夫归豫章分题 虎丘","author":"郯韶","text":"青山阖闾墓，荒草起秋风。\n古隧苍精化，阴房玉雁空。\n夕阳明野寺，远树落霜枫。\n送子难为别，无情楚水东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2840,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉谢玉山假僦屋","author":"杨维桢","text":"玉山长者有高义，乞与山人僦屋金。\n驷马一时皆上客，青娥三日有遗音。\n西山涌海当秋后，南斗流江入夜深。\n更报大茅张外史，兴来须抱小雷琴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2841,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀玉山一首书珠帘氏便面","author":"杨维桢","text":"五月江声入阁寒，故人西望倚阑干。\n珠帘新卷西山雨，第一峰前独自看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2842,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"玉山以诗见招用韵奉答二首 其一","author":"杨维桢","text":"君泛脂江我泛娄，沙棠小桨木兰舟。\n醉吹铁笛珠帘底，端为风流刺史留。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2843,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"玉山以诗见招用韵奉答二首 其二","author":"杨维桢","text":"沧楼诗招箫史凤，莲艇或踏琴高鱼。\n卷尽芙蓉秋万顷，瀛洲信有玉人居。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2844,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"戏答陆静远","author":"顾瑛","text":"秋水蓝桥一尺强，愁闻玉杵捣玄霜。\n东篱老子乌纱薄，西郭佳人翠袖长。\n古寺竹深禅榻静，晴窗花落砚池香。\n西风鹤背三更梦，笑看璚花作醉乡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2845,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"八月廿三日芙蓉花下留南宫岳山人饮明日岳山人过玉山南宫老矣不知复几聚首观花听琴情不能堪因赋长句并简玉山","author":"倪瓒","text":"芙蓉著花已烂熳，浊酒弹琴聊少停。\n数声别鹄隔江渚，一醉秋天空玉瓶。\n况当宾客欲行迈，忍使风雨即飘零。\n攀条掇英重惆怅，但愿花开长不醒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2846,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄玉山兼简匡庐外史","author":"陈基","text":"美人不见已三月，日日相思赋角弓。\n兴发颇疑诗有助，忧来翻讶酒无功。\n未须结客游樊上，却儗移家住瀼东。\n与报匡庐于外史，新醅宜压荔枝红。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2847,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"笠泽有怀","author":"陈基","text":"碧梧翠竹郁参差，艾纳流薰绣幕垂。\n璚管隔花闻度曲，画屏烧烛看围棋。\n坐延太乙青藜杖，倒著山公白接䍦。\n何日扁舟还荡桨，为判同醉习家池。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2848,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"别后闻入杭赋诗以寄","author":"陈基","text":"柳洲寺下丝竹繁，苏小墓边风日暄。\n天开十里水如镜，雨过六桥花欲言。\n画船夜听孤山鹤，铁苗晓惊天竺猿。\n归来相迟桃源上，为唱《竹枝》倾绿樽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2849,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"有怀梧竹主人山阴道士云台外史兼简龙门开士","author":"陈基","text":"碧梧翠竹日扶疏，长夏高堂可晏居。\n霅上故人时载酒，山阴道士近无书。\n苍头扫石安棋局，稚子穿花奉板舆。\n若见惠休烦问讯，碧云诗句定何如？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2850,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻夜来过春梦楼赠小芙蓉乐府恨不得从游戏呈二十八字代简玉山主人","author":"郯韶","text":"金鸭香销月上迟，玉人扶醉写新词。\n胜游不记归来夜，春梦楼前倚马时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2851,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夜独坐有怀玉山徵君","author":"郯韶","text":"庭树叶初落，鹊飞惊早秋。\n玉绳犹未转，星汉忽同流。\n杨柳离亭思，芙蓉别浦愁。\n美人隔烟渚，沧海信悠悠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2852,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次玉山分题韵四首 其一","author":"郯韶","text":"频年种豆绕幽居，深巷萧条意不如。\n日晏炊烟分井臼，春前草色上阶除。\n清时自分耽诗癖，白昼休嫌生事疏。\n祇忆桃源种桃者，秋江多致鲤鱼书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2853,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次玉山分题韵四首 其三","author":"郯韶","text":"玉山树色倚青冥，洒阁风微酒易醒。\n移席绝怜江柳碧，钩帘更爱竹书青。\n白云尽日春团盖，灵石何年夜陨星。\n却笑虎头痴绝甚，尽将诗句写秋屏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2854,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"律诗二首奉寄玉山徵君 其一","author":"郯韶","text":"仙人爱向桃源住，曲曲云林胜辋川。\n秋水到门船似屋，青山当槛树如烟。\n常时待月溪边立，最爱梳头竹里眠。\n我有好怀清梦远，题诗还到草堂前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2855,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"律诗二首奉寄玉山徵君 其二","author":"郯韶","text":"徵君一月不出屋，客来喜值清秋时。\n会稽录事应当别，笠泽高僧定赋诗。\n新月忽从溪上出，清尊还向竹间移。\n殷勤持寄于高士，切勿愁吟两鬓丝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2856,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虞山道中有怀玉山徵君","author":"郯韶","text":"言偃宅前湖水东，千门杨柳绿摇风。\n一篷山色斜阳外，半夜雨声春梦中。\n独客年年如旅燕，行人草草似惊鸿。\n芳洲杜若凭谁采？\n心逐寒潮处处同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2857,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过绰墩舟中奉寄玉山","author":"郭翼","text":"绰墩树色青如荠，荡里张帆晓镜开。\n乌目峰高云北下，白沙湖阔水西来。\n菰蒋打雨鸣还止，鸂鶒迎船舞却回。\n好入桃源张渥画，祇惭扬马是仙才。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2858,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日有怀二首 其二","author":"郭翼","text":"客里青春愁不禁，月头月尾雨阴阴。\n海棠结巢花匼匝，杨柳满门江浅深。\n竟日笙囊寒未解，临池盘盏晚才斟。\n诸郎怕有乘舟兴，怪杀喧喧鹊报音。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2859,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南湖有怀","author":"郭翼","text":"玉山之诗尚清省，草堂缃帙动星光。\n儿郎个个荀文若，宾客人人马季良。\n月里吹笙眠复阁，花间移艇过渔庄。\n酒酣侧近江头别，独坐南湖意不忘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2860,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴一首呈上玉山道丈","author":"郭翼","text":"前月海寇入郡郭，病里移家愁杀人。\n桃花野屋苦多雨，杨柳清江无好春。\n谁似庞公居陇亩？\n自惭杜老在风尘。\n草堂梦寐惊相见，把酒论诗月色新。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2861,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和羲仲韵柬玉山","author":"瞿智","text":"莫怪清狂似谪仙，乘凉远过玉山前。\n紫箫夜动黄姑渚，翠被风生越鄂船。\n云树亭台全却暑，芙蓉帘幕半浮烟。\n赋诗刻烛良宵饮，知是衣冠不乏贤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2862,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"至正九年四月二十日元璞舟过江郊枉劳衰疾承近怀多慰元璞言归赋七言近体一通问讯遥寄玉山主人","author":"吴克恭","text":"玉山长夏草堂幽，老爱从君十日留。\n醉语支离欢不记，归来烂熳忆相求。\n风回柳叶摇歌扇，月出荷花映綵舟。\n可念江湖搔白首，还将衰朽问汤休。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2863,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖酌别便欲过草堂因冗未果小诗二章奉寄稍凉当买舟相晤也 其一","author":"郯韶","text":"片玉山中结草堂，门前流水似沧浪。\n竹阴覆几琴书润，花气薰窗笔砚香。\n四海诗名唐李杜，一时文采汉班扬。\n近闻高士增新传，好纪淮南老更狂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2864,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]