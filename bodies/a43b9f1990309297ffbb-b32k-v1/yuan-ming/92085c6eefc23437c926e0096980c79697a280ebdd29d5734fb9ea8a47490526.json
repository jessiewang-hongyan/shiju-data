[{"title":"送姚子章之浙东帅掾","author":"郯韶","text":"海右桓桓大府开，胜中云气近蓬莱。\n借筹底用平蛮策，草檄须烦倚马才。\n玉节旌麾江上见，明珠翡翠日边来。\n遥知博望沙头月，为照乘槎万里回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11754,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄南屏精舍诸友","author":"郯韶","text":"山中遗老彫零尽，太息于今复数谁？\n东郭幽人频曳履，南冈诸子总能诗。\n夜窗灯影分书幌，午榻茶烟飏鬓丝。\n何处令人发深省，永明湖上立多时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11755,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"同报复元上人登南冈文笔峰兼简句曲外史","author":"郯韶","text":"橘林风细凉飔生，石磴雨滑褰衣行。\n双肩正如野鹤立，左耳忽若秋蝉鸣。\n孰云耽诗并齐己，我爱玩世惟弥明。\n对床著屐歌楚语，若个杖藜来细听。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11756,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题王仲弘县尹所藏高彦敬尚书巴陵山水图","author":"郯韶","text":"尚书爱画山，落笔生远色。\n微茫洞庭野，迥与湘渚隔。\n青山迤逦盘春空，江波欲落江树重。\n望中云梦开七泽，猿啼直与巴陵通。\n王郎家住巴陵道，按图只说巴陵好。\n巴陵女儿歌《竹枝》，微风落日行人少。\n山中春雨生石田，柴门流水声溅溅。\n钓竿长日倚沙树，扁舟中阁生晴烟。\n爱此只合山中住，十年作官不归去。\n高堂见画夜梦之，墓中离离湿秋露。\n白头官满思转多，江南酒美仍蹉跎。\n人生得意夜行乐，酒酣且和巴陵歌，王郎王郎奈尔何！","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11757,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和仲举张博士见寄","author":"郯韶","text":"金沟河上柳千条，濯濯轻阴覆画桥。\n华夹御城涵晓日，波回仙沼应春潮。\n曾闻献赋趋三殿，想见承云丽九霄。\n欲听钧天尘梦隔，苏台凉月夜寥寥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11758,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晓发商溪戏简玉山且要和","author":"郯韶","text":"商山西头花满烟，画船银烛理丝弦。\n翠屏何处惊残梦，卧看青天春月圆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11759,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄句曲外史","author":"郯韶","text":"掬溜室中清夜分，相过曾此说幽文。\n入池星斗当窗见，枕席波涛隔树闻。\n头上鹖冠朝老子，手中龙节候元君。\n欲从世外求玄赏，鸡犬岩头有白云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11760,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和报复元秋兴","author":"郯韶","text":"大星出海芒角稀，新月隔林光景微。\n空山无眠鸡犬静，独树忽惊乌鹊飞。\n已喜朝廷宽赋敛，侧闻南国尚戎衣。\n钓竿早晚落吾手，日日放船来水扉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11761,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登天平山","author":"郯韶","text":"西来山势森如戟，上与浮云石栈连。\n华盖九峰当绝壁，龙门一道落飞泉。\n幽穿石洞潜通穴，下俯天池冷积渊。\n更欲振衣千仞表，侧身东望洞庭烟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11762,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谷口","author":"郯韶","text":"谷口大星稀，苍茫夜景微。\n草惊知鹿过，潭响觉龙归。\n楚舞谁相狎，商歌自揽衣。\n鹿门应有待，莫遣壮心违。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11763,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送赵季文之湖州知事二首 其一","author":"郯韶","text":"□闻大郡元僚佐，江左文繁费剩裁。\n殷浩固称多士选，郗超元是济时才。\n题诗金井穿云洞，下马洼尊坐石台。\n兼有故人资□画，春风日日好怀开。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11764,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送赵季文之湖州知事二首 其二","author":"郯韶","text":"□家云溪溪上头，苔荒数亩石田幽。\n连天云树当书屋，归梦青山落钓舟。\n大邑久传才子盛，□□好逐王孙游。\n东林春酒白于蜜，未得相从对狎鸥。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11765,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"吴浦","author":"郯韶","text":"山势分吴楚，江流接混茫。\n昔年隔南北，此地即边疆。\n民近淮盐市，门通海客航。\n行人敬风土，云是子游乡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11766,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"伐桂辞","author":"郯韶","text":"莫斫桂树，莫斫桂树，上有慈乌反哺。\n桂树有华，慈乌有母。\n实伤汝心，匪伤汝斧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11767,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄倪元镇","author":"郯韶","text":"幻仙昔过梁溪上，之子清诗日见称。\n讵有低头拜东野，直须长啸答孙登。\n书来映雪池头落，睡起朝暾屋角升。\n欲酌山泉煮春茗，江干艇子几时乘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11768,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次张仲举谢左辖韩公韵","author":"郯韶","text":"高阁中天亘綵虹，坐看庭树起秋风。\n相臣载酒空山里，供奉题诗别馆中。\n肃肃远瞻鸿羽集，呦呦尚想鹿鸣同。\n纤云不动凉生席，一夜天瓢雨洗空。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11769,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过吴兴沈十二秀才","author":"郯韶","text":"游子经年别故乡，偶从春水泛沧浪。\n万行细柳迎归棹，几个黄鹂隔草堂。\n北里缫车如雨响，东家煮酒入林香。\n沈郎阿母能强健，见说新来白发长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11770,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题尹山寺","author":"郯韶","text":"王师昔度江南日，曾驻旌旗江上林。\n劫火不随人幻化，箭锋应与塔销沈。\n咸池几见天鸡出，蕙帐空闻夜鹤吟。\n白发老僧谈往事，青山依旧白云深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11771,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"述怀寄倪元镇","author":"郯韶","text":"隐吏重来学灌园，辍耕时与野人言。\n衡门谩有车马集，厨廪都无鸟雀喧。\n夜榻张灯钞籀史，饮瓢分水注陶尊。\n欲乘艇子梁溪去，稍待春潮系树根。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11772,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题仙山图","author":"郯韶","text":"华盖诸峰积翠遥，中天楼观涉岧峣。\n白云窈窕生晴谷，春渚微茫落暮潮。\n归鹤只栖玄圃树，幽人时过赤阑桥。\n相逢愿接飞霞佩，早晚飙车会见招。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11773,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为郇道士赋钟山","author":"郯韶","text":"每向钟山赋草堂，远林佳树色苍苍。\n石桥夜迥星河澹，仙井潮生雨气凉。\n坐见青松将子落，行看老鹤与人长。\n钓泉拟解尘缨濯，蹑屩还趋千仞冈。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11774,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄熊自得","author":"郯韶","text":"勘书台上听泉者，还忆匡庐入卧游。\n千尺云松平地起，九江春水拍天流。\n亦知阮籍多贪酒，自爱庾公不下楼。\n思尔箫声当静夜，时时吹凤碧山头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11775,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题赵氏所藏画","author":"郯韶","text":"绣岭宫前西日晖，忽惊岚气上人衣。\n人家隔岸留残照，楼阁经年掩翠微。\n游子不知秋已暮，蹇驴直与世相违。\n何当写我临流处，黄石桥头看钓矶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11776,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题庐山图","author":"郯韶","text":"群山东南横翠色，倒影芙蓉生石壁。\n青山直下九江流，吹落银河二千尺。\n安得浮云满春空，托身万里之长风。\n南游濯发洞庭水，卧看萝月行山中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11777,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送王生之江阴州吏","author":"郯韶","text":"不到澄江今五年，城居风物想依然。\n青山对雨云连屋，春水到门船在天。\n此地极知官事简，清时况乃郡公贤。\n题诗送子□相忆，又是秋风过雁前。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11778,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送僧归温州","author":"郯韶","text":"上人灵鹫峰头客，归去秋风雁宕南。\n山沃谢公行处屐，洞留觉祖去时龛。\n海汀潮白秋波乱，陇树天青夕照含。\n莫怪题诗重相忆，频年有约寄黄柑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11779,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游弁山黄龙洞简赵仲光","author":"郯韶","text":"石洞阴阴海气寒，绝厓千尺落奔湍。\n白翻飞燕空中见，黑入潜蛟地底蟠。\n陟险未穷双蜡屐，放形自笑一儒冠。\n十年来往青山路，依旧黄尘没马鞍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11780,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送张大使之湖湘监税","author":"郯韶","text":"学士诸孙不乏贤，司征犹得纪山川。\n行人西入湘江路，贾客南通下蜀船。\n倚竹哦诗春过雨，隔江听瑟暝浮烟。\n相思莫寄衡阳雁，待得新秋又一年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11781,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"苕溪草堂为范叔豹赋","author":"郯韶","text":"徵君家住白蘋溪，烟雾萧骚万竹迷。\n茅屋秋风辽海阔，锦城秋色傍人低。\n朝来把钓频维棹，雨过看山独杖藜。\n传得杜陵千古意，肯容投老遂幽栖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11782,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵杨子寿同浦太守游顾园四首 其一","author":"郯韶","text":"辟疆园里好花开，路隔仙源一水回。\n春暖凫鹥当槛浴，草青胡蝶上衣来。\n柘枝屡舞团团扇，竹叶深倾滟滟杯。\n何事绿波生浩荡，画桥风急綵舟回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11783,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵杨子寿同浦太守游顾园四首 其二","author":"郯韶","text":"厌厌行酒日西斜，太守风流两鬓华。\n箫引凤凰停夜月，杯传鹦鹉泛流霞。\n飞花半入长洲苑，归燕空思王谢家。\n剪尽绿杨三万树，暖风吹絮满天涯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11784,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵杨子寿同浦太守游顾园四首 其三","author":"郯韶","text":"望中烟雨赤阑桥，芳草行人去路遥。\n翠壁流泉通地底，青林虚阁转山腰。\n迟迟綵艇香风度，滟滟金塘柳色饶。\n何处隔楼闻笑语，玉人□按紫琼箫。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11785,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵杨子寿同浦太守游顾园四首 其四","author":"郯韶","text":"石洞阴阴雪乍融，溪虚弱柳不禁风。\n花飞草阁通归燕，舟泊晴江见断虹。\n甚欲题诗春竹里，不堪吹笛水烟中。\n归来坐对高城晚，门外乌啼月照空。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11786,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送卢益修鍊师所画水仙","author":"郯韶","text":"卢敖爱向山中住，长遣看云一舄飞。\n昨夜候神东海上，梦随环佩月中归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11787,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题秋林高士图","author":"郯韶","text":"山磴坡陀细路平，石桥流水雨初生。\n绝怜童子惊秋色，听得空林落叶声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11788,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题赵仲穆画送郑蒙泉之鄞","author":"郯韶","text":"海宁太守归来日，爱写新图入卧游。\n见说甬东风日好，春山如雾隔瀛洲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11789,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题米南宫画","author":"郯韶","text":"风流不见米南宫，依旧云林远树重。\n貌得匡庐旧游处，半江秋色洗芙蓉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11790,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题柯丹丘画","author":"郯韶","text":"溪上青山石径纡，暖云晴嶂锦模糊。\n行人如隔湘江岸，日暮青林啼鹧鸪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11791,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题溪村烟雨图","author":"郯韶","text":"山雨朝来不作泥，望中烟雨使人迷。\n依稀绝似羌村路，无数春船逆上溪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11792,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梨花","author":"郯韶","text":"渚宫花落雨霏霏，春尽江南客未归。\n多少东家胡蝶梦，相思并逐彩云飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11793,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题扇头","author":"郯韶","text":"洞庭木落山月低，出门秋色风凄凄。\n客行忆过黄陵庙，谷口青猿一个啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11794,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题谢仲和竹石","author":"郯韶","text":"江南谢老独风流，爱写晴云竹树幽。\n绝似玉堂残月夜，数枝晴雪映高秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11795,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题宋王孙雨竹","author":"郯韶","text":"閟阁春寒写素屏，两枝如玉立亭亭。\n分明自注银潢水，白日天阶洗凤翎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11796,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题魏明铉画","author":"郯韶","text":"老翁住在浣花村，日日哦诗醉瓦盆。\n怪底横江见船尾，不知春水到柴门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11797,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画","author":"郯韶","text":"重冈细草覆坡陀，风引松花落涧阿。\n草屋雨馀云气湿，开门不厌好山多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11798,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"村行","author":"郯韶","text":"江烟漠漠雨霏霏，野饭吹香落钓矶。\n三十六陂秋水阔，背人白鸟一双飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11799,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题赵仲穆画","author":"郯韶","text":"水晶宫里佳公子，拄笏看山逸兴多。\n昨夜溪南新水涨，钓丝晴拂白鸥波。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11800,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赵彦荣临画","author":"郯韶","text":"北苑南宫奈老何，青山依旧洛中多。\n相思一夜鸥波梦，稚子船头结绿蓑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11801,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"鸲鹆图","author":"郯韶","text":"东风吹柳日沈沈，阶下宜男绿正深。\n百尺游丝春院静，卧看鸲鹆步花阴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11802,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"许浦道中","author":"郯韶","text":"许浦经行三十里，狼山已见宿云霾。\n何人挽粟能通海，有客贩盐初过淮。\n马度冈峦何历历，鸡鸣风雨只喈喈。\n一春多病兼寒色，愁绝山颠与水涯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11803,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题唐子华山水末句用杨廉夫五字","author":"郯韶","text":"我爱会稽杨使君，洞庭秋月约平分。\n时时吹笛中流去，卧看苕山如画云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11804,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送人之轧溪兼简王十二秀才","author":"郯韶","text":"不见草堂枫树西，春云杂树晚相迷。\n白沙今夜柴门月，又逐青山过轧溪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11805,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为静嵓上人赋半间云房","author":"郯韶","text":"松下半间屋，绕檐生白云。\n山香石上起，华雨静中闻。\n扫榻看桐影，支筇对夕曛。\n悠悠百年意，世事任纷纭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11806,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送樊仲益省郎之解州","author":"郯韶","text":"六月句吴国，重逢樊省郎。\n题诗过山馆，惜别度河梁。\n淮树生秋早，汾阴去雁长。\n明年朱绂贵，遥忆奉华觞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11807,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梁溪倪元镇为余写湖山清晓图河东张仲举题诗于上友人郑君杰竟持去不还虽往欲观亦不出示郑真忍人也今观斯图触景会意宁不为之慨叹谩赋长句云","author":"郯韶","text":"韶也性颇癖，为爱名山游。\n及兹见图画，近远须购求。\n梁溪倪君与我好，看山作图非草草。\n春山烂熳走云涛，海树微茫隔烟岛。\n硕人之居在涧阿，天青石壁搴女萝。\n弹琴暝落松上雪，濯足影动窗前波。\n而我忆在西湖住，对画看山日忘暮。\n河东太史惊见之，为写新诗美无度。\n东家郑君何太痴，时复把玩称绝奇。\n一朝冲雨卷藏去，使我梦寐长思之。\n只今看画即欲死，永言思之嗟已矣！\n出门笑问沙上鸥，东流瀰瀰春江水。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11808,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"有怀玉山徵君次沈自诚韵","author":"郯韶","text":"翔燕屡云至，落花辞故枝。\n当轩盼流景，恻怆神亦疲。\n达士多旷志，所慕惟书诗。\n朝耕孰与俦，夕钓任所之。\n岂不念时好，沈沦与世违。\n取琴为之弹，曲绝令心悲。\n白云破高冈，夕月照水涯。\n徒令千载心，默默谁与期。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11809,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵倪元镇双燕吟","author":"郯韶","text":"双燕双燕复双燕，年去年来几相见。\n东风花落杏梁深，不比朝飞雉带箭。\n主人长年不知还，梦随胡蝶千万山。\n人生那似双飞燕，去去来来梁栋间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11810,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"石榴花辞","author":"郯韶","text":"石榴花，为谁好，一树垂垂向官道。\n年年花落复花开，不觉前年人易老。\n去年花开白日长，长官载酒来称觞。\n流莺蛱蝶共飞舞，不惜醉倒花树傍。\n今年花开秋可怜，累累结子满树颠。\n无人载酒花下饮，只说花开胜去年。\n去年今年两结子，雨露生成有如此。\n人老不似花再开，莫惜载酒花前来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11811,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题青山白云图","author":"郯韶","text":"山腰绿树雨初收，天际白云如水流。\n忆在九江船上望，杨花飞雪下轻鸥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11812,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题九龙图","author":"郯韶","text":"九龙起幽壑，百谷走春雷。\n峡坼苍厓断，天倾白浪回。\n朝行神禹穴，暮过楚王台。\n应有天瓢手，为霖遍九埃。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11813,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山水四景 其一","author":"郯韶","text":"西风木落晓猿惊，一水东流日夜声。\n两岸青山看不尽，扁舟又过楚王城。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11814,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山水四景 其二","author":"郯韶","text":"扁舟晚泊洞庭西，江草江花岸岸齐。\n却过白龙祠下去，两边枫树鹧鸪啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11815,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"芭蕉士女图","author":"郯韶","text":"玉阶风细漏迟迟，月冷笄珈鬓影垂。\n怪底新凉满团扇，红蕉花下立多时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11816,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]