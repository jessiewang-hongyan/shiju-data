[{"title":"宿郭子振雪洞","author":"张昱","text":"月光一色杳难分，不见丹青藻棁文。\n蝴蝶飞来疑是梦，梅花开后却思君。\n都忘长日将纨扇，犹恐馀寒到练裙。\n宿酒觉来看不厌，满床秋思白如云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5167,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答韩介石提举","author":"张昱","text":"偶持尊酒对花倾，有客能来道姓名。\n佳句才探出怀袖，故人知是不公卿。\n平生学剑心都懒，此日归田计可成。\n彼此头颅俱种种，题诗那得不关情？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5168,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"冬日白牡丹","author":"张昱","text":"律琯催春到牡丹，行云欲堕碧阑干。\n似嫌脂粉能相污，故逞肌肤独耐寒。\n雪艳最宜金缕盖，天香合是玉雕盘。\n赵昌花鸟新驰誉，画作屏风后面看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5169,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"老圃堂","author":"张昱","text":"不谓斯时有此翁，无能田亩累其穷。\n异蔬自灌欲百品，老圃官量无十弓。\n草阁晓梳秋发白，玉杯春醉夕阳红。\n馀生尽可忘荣辱，事与樊迟请学同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5170,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"邹将军挽诗","author":"张昱","text":"为臣岂欲国倾危，莫把天戈挽落晖。\n一死得埋元氏土，寸心无愧首阳薇。\n安居食禄当时贵，守节酬恩此日稀。\n老我尝从大夫后，题诗为尔泪沾衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5171,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"同贡有初观潮赋","author":"张昱","text":"旧时八月潮生日，士女倾城出看潮。\n秋唾似从天上落，晴欢宜向酒中消。\n气争鸟道为森爽，势合龙宫亦动摇。\n今度可怜成独往，海门斜日共萧条。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5172,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自赋","author":"张昱","text":"高阳酒徒今老生，早年击筑和秦声。\n许人不负一诺重，买笑惟恐千金轻。\n花间骏马铜铸出，枕上爱姬云化成。\n谁信青门种瓜者，自梳白发向秋晴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5173,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"僧惠炬有悼黄溍太史偈，次韵","author":"张昱","text":"日鼓西沉逝水东，他生还有此生同。\n莲花社岂知元亮，茅屋诗曾咏巳公。\n梦幻已空身外蝶，文章犹镂蠹间虫。\n闲情最是山前塔，日夜风铃语未穷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5174,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"写易轩，为方以愚赋","author":"张昱","text":"不于阙下写文星，天与冥鸿惜羽翎。\n人世谁为双鬓白，家山自是乱峰青。\n霞分晓色留书几，斗转寒光落研屏。\n观象玩辞从写遍，方干何忝旧明经？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5175,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挈家图，为尤仲斌赋","author":"张昱","text":"葛洪挈家赴勾漏，何异庞公归鹿门？\n担头何有琴书累，牛背未觉妻儿村。\n千古清名不易得，一斛丹砂何足论？\n大胜齐侯马千驷，令德曾无遗子孙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5176,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"悼王自牧","author":"张昱","text":"贵贱交游二十年，忍将老泪洒新阡。\n盖棺不必论身后，入室犹如在眼前。\n一首诗今为尔惜，数行志在得人编。\n钱塘吟士长相望，潘阆林逋孰后先？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5177,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"思橘轩，为悟空叟长老赋","author":"张昱","text":"侍书遗墨函封在，思橘名轩示不忘。\n往事百年同逝水，斯文一语有馀光。\n风流大抵输前辈，臭味还应是故乡。\n嘉树未知培植后，只今百果许谁尝？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5178,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"远翠楼，为殊无别上人赋","author":"张昱","text":"坐来未觉西山远，紫翠千峰隔画阑。\n此处岂容携酒到，任谁只得捲帘看？\n雪晴黛拂蛾眉绿，雨过螺堆佛髻寒。\n分得半棂闲拄笏，床头宁复更弹冠？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5179,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"早行","author":"张昱","text":"凉风满棹贺湖边，越上诸山尽可怜。\n远汉片云承落月，长林疋练曳轻烟。\n窗间织女灯犹在，井畔啼乌客正眠。\n何处闲愁随梦觉，一声菱唱发前川。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5180,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵周昉","author":"张昱","text":"大尊堂上几曾空，客有登门道未穷。\n吟鬓肯因愁里白，舞衫偏爱酒边红。\n百年喔喔鸡声月，万事悠悠马耳风。\n及此旧游情分在，尽将春付笑谈中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5181,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠寓客还瓜州","author":"张昱","text":"把酒临风听棹声，河边官柳绿相迎。\n几潮路到瓜州渡，隔岸山连铁瓮城。\n月色夜留江叟笛，花枝春覆寺楼筝。\n赠行不用歌杨柳，此日还家足太平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5182,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题","author":"张昱","text":"灼灼庭花露未收，乐然双燕语绸缪。\n新妆满面犹看镜，残梦关心懒下楼。\n春到自怜人似玉，困来谁问酒扶头？\n狂踪已作风丝断，敢怨流年似水流。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5183,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"与白范论诗","author":"张昱","text":"白家少傅诸孙在，坐语都忘日晷移。\n不用入吴求季札，有如过晋得钟仪。\n高情欲共游丝远，倦迹犹嫌过鸟迟。\n莫道古今风雅异，总于衰晚始相知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5184,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"冬至日，次张太守韵","author":"张昱","text":"喜色轻黄未上眉，且将心事付游丝。\n嵇康取醉非关酒，杜甫长吟不为诗。\n一线日长宫女觉，五方云应史官知。\n人间梅柳关春事，次第从教律琯吹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5185,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"对雨","author":"张昱","text":"好是西湖醉后听，打窗惊柳隔堂屏。\n莺花又送春光老，凫藻偏涵雨气腥。\n曲按银筝何太急，杯行玉手不须停。\n尊前便是巫山梦，莫道行云事未醒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5186,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赵松雪画苕溪清远图","author":"张昱","text":"吴兴元是水晶宫，楼阁溪山罨画中。\n酒舫载过寒食节，舞衫吹遍鲤鱼风。\n当时乐事谁能见，此日王孙自不同。\n亭下鸥波如有感，行云犹在玉尊空。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5187,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄胡侍御","author":"张昱","text":"后市街头相见稀，此翁真是早知机。\n浮沉里闬陶彭泽，轻易官资白紫薇。\n小妾画堂杨柳曲，高年白发薜萝衣。\n风流莫负持螯事，越上湖田蟹正肥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5188,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵张都事","author":"张昱","text":"老却樊川杜牧之，风流谁赋柳丝丝？\n不关请告来归早，惟恐寻春去较迟。\n画舫行时长载酒，粉墙到处即题诗。\n至今留得狂名在，唯有纤腰弟子知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5189,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谢僧惠蒲履","author":"张昱","text":"大夫此日可徒行，蒲履深烦寄远情。\n除是高僧求易得，自非巧手织难成。\n春来见客身差健，老去看花步觉轻。\n他日袈裟如过我，定须著此出门迎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5190,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄罗博士","author":"张昱","text":"莫说文星与酒星，已同伧父泣新亭。\n梦中此日头能白，海内何人眼更青？\n鹃化羽毛犹姓杜，鹤归华表尚名丁。\n纵然记得前朝事，弹向银筝只自听。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5191,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"荆溪渔者，为义兴道士赋","author":"张昱","text":"千尺荆溪彻底清，水中无复见蛟行。\n要同云鹤闲踪迹，自放烟波隐姓名。\n浊酒忘形浮世内，青山到眼绿蓑轻。\n醉来放棹回船去，抚掌风前咏濯缨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5192,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"留题徐子方客楼","author":"张昱","text":"倦游到处即淹留，虽是孤村境却幽。\n松下野云闲似鹤，门前溪水浅于舟。\n琅玕夏簟儿能设，琥珀春醅妇可谋。\n连日小楼忘客况，放翁凡事颇清修。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5193,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"周元亮、夏景安同过寿安堂提举乃翁墓上作","author":"张昱","text":"盖棺事了若堂封，起伏诸山接过龙。\n解剑会曾心自许，脱骖非恶涕无从。\n每分药饵扶吾老，窃诵文章笑道穷。\n朱绂在身忘宦况，前朝犹有古人风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5194,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题明心海上人别弟诗后","author":"张昱","text":"弟兄天性本同符，远涉能无一恸乎？\n浮世有身真大患，回车无日始穷途。\n秋巢不宿乌衣燕，夜屋偏怜白项乌。\n切莫临风挥老泪，血痕能染紫荆枯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5195,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵雪鹤生惠红米诗","author":"张昱","text":"相望只在片云中，自昔神交意已通。\n书枉鲤鱼烹后素，粒分鹦鹉啄残红。\n回车三径岂无日，放棹五湖须便风。\n知汝有期林处士，尚留残雪待春丛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5196,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中过萧山谊上人别院","author":"张昱","text":"雨棹茫然出镜湖，客行偏尔畏泥途。\n僧中果得奇男子，我辈真成贱丈夫。\n重席自能为我设，大尊不用问人沽。\n从容暖阁得佳睡，此意支郎世有无？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5197,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送上虞马训导赴昌化县学","author":"张昱","text":"远赴弓旌未阔迂，道行何惮路崎岖？\n横经不异郡博士，继粟岂无卿大夫？\n空使饭盘堆苜蓿，已将斋帐染芙蕖。\n马融家法风流在，女乐从今不用呼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5198,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄汤阴张丞","author":"张昱","text":"万古销沉入望中，悠悠往事付征鸿。\n汤阴风俗今何似，邺下文辞谁最工？\n争得不教双鬓白，别来屡见小桃红。\n贵游年少轻乡曲，不赋停云寄老翁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5199,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题四首 其一","author":"张昱","text":"几梦郎君引碧幢，微波难与寄沅湘。\n青春每念青丝骑，白日长闲白玉窗。\n菡萏结房虽有异，鸳鸯织锦不成双。\n潮来好似儿家恨，流过门前气未降。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5200,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题四首 其二","author":"张昱","text":"萋萋芳草被江皋，好是王孙去日袍。\n几许春魂迷蛱蝶，近来酒量减葡萄。\n音书已似题黄绢，踪迹何因梦大刀？\n可惜百花时节到，伯劳燕子不相遭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5201,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题四首 其三","author":"张昱","text":"咫尺香闺步懒移，搔头谁理玉蟠螭？\n不听小管吹银字，只数回文织锦诗。\n得伴有时惟斗草，遣怀无日不弹棋。\n鸣鸠乳燕青春晚，谢却繁花几万枝？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5202,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题四首 其四","author":"张昱","text":"水心亭馆迥无邻，好与郎君写洛神。\n不见鲤鱼烹后素，空怜蝴蝶梦中身。\n萋萋谁信南园草，渺渺予怀北渚春。\n云气长连峰十二，此中消息未能真。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5203,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪庭，为龙华阁康上人赋","author":"张昱","text":"请教雪庭谁是雪，雪消应始我初心。\n问知达摩来东土，唯有神光在少林。\n清净观空三昩见，吉祥风软六花深。\n半空挂在羚羊角，踪迹无因向下寻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5204,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"与金冕言诗","author":"张昱","text":"天然秋水出芙蓉，造物何言与用工？\n风雅遗音自鸣凤，齐梁馀习尽雕虫。\n性情敦厚思方到，句法雍容律始同。\n沈宋后来俱作者，几何人辨四声中？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5205,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桑梓图，为徐复初参政赋","author":"张昱","text":"望中烟树是黄州，城绕江波总旧游。\n桑梓能忘丘垄念，夔龙分属庙堂留。\n牛山云树依然在，鱼水家声尚可求。\n他日赐环当有报，题诗却寄凤池头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5206,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄陈允中佥事","author":"张昱","text":"得放还家休便休，更无褒贬到春秋。\n景公死日有千驷，晏子相齐惟一裘。\n朱绂既能从尔去，黄金不必为孙谋。\n何人得似归来鹤，见彼累累土几丘？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5207,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"樵云诗，为李文彬参政赋","author":"张昱","text":"赤手樵云直至今，此云已献九重深。\n万方允副从龙望，五色长怀捧日心。\n上接炉烟通御气，淡笼宫树合春阴。\n自调玉烛归玄造，非雾非烟何处寻？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5208,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题崔纯一处士遗像","author":"张昱","text":"处士于今旧勿论，通家三世见甥孙。\n钟情更为何人恸，出涕方惊老眼昏。\n南坞高坟深宿草，东床佳婿见清门。\n丹青有笔开生面，底用名香为返魂？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5209,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"耕乐诗，为许起宗大父高士赋","author":"张昱","text":"人生不仕即归田，夏屋渠渠艮渚边。\n僮指计佣将五百，墙桑成树过三千。\n食前甘旨惟孙子，门外轩车总俊贤。\n隐去更无城府迹，鹿门高致后千年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5210,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"采药径，为方德远医士赋","author":"张昱","text":"药径香风作阵来，日扶长钁为徘徊。\n绿怜地锦经春在，红觉山丹冒雨开。\n本草有名俱用识，仙岩可采不须栽。\n寻常踏破苍苔处，多是门生种杏回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5211,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送张经历之叙州","author":"张昱","text":"别酒无嫌醉似泥，叙州又过洞庭西。\n云涛浩渺连三峡，井邑凋残接五溪。\n雪岭侵天无雁到，枫林蔽日有猿啼。\n凭谁唤醒王褒梦，除是陈苍碧野鸡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5212,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题奎方舟讲师影堂","author":"张昱","text":"火风假合作天亲，垂老空门哭故人。\n四句偈留辞世法，一龛灯照坐禅身。\n收来舍利藏生玉，散到天花照烂银。\n铭塔祗应徐博士，备知僧行刻坚珉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5213,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"命酒徵歌送余婿，时伯庸酒间赋赠董景明、董彦祯诸亲还遂昌","author":"张昱","text":"高堂尽意乐今宵，未可樽前自寂寥。\n锦瑟年华青冉冉，银河秋思碧迢迢。\n红于灯下看偏好，黄向眉间喜未销。\n明日早潮随去棹，到家应及鹊成桥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5214,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵张郎过大明湖诗","author":"张昱","text":"湖上荷花五月凉，水心亭馆昼收香。\n狂来借手传鹦鹉，俊发教人唱凤凰。\n零落翠盘风雨后，凄凉歌扇水云傍。\n凋残雁下休惆怅，看取咸阳与洛阳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5215,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题莫景行茅道士棣华碑赋","author":"张昱","text":"茅家兄弟学仙迟，不见春风长紫芝。\n桃熟海山还有日，鹤归人世更无期。\n游魂渺渺知何在，荒冢垒垒尽可疑。\n惟有夕阳如旧日，照人来读棣华碑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5216,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄张来仪徵士（九江人）","author":"张昱","text":"湖州寓客张徵士，珍重风前咏落梅。\n锦瑟可容弹别调，白头只合付深杯。\n安期枣在神人去，曼倩桃空阿母回。\n看取汉家汾水上，年年惟有雁飞来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5217,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杏轩，为倪伯温赋","author":"张昱","text":"别屋轩窗绚綵霞，董仙曾以杏为家。\n邦人为种几多树，春雨每开千万花。\n门外清阴遗世泽，酒边丹实赏年华。\n烦君爱惜题诗壁，莫遣轻尘上碧纱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5218,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"琴鹤幽居图","author":"张昱","text":"幽居琴鹤以怡情，童子何知预我清？\n羽翼如传两阶舞，徽弦为和九皋鸣。\n山林在昔多迂士，画史何人有重名？\n好托丹青留后日，莫忘清献旧家声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5219,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"林泉读书图","author":"张昱","text":"高情自爱乐林泉，华屋藏修度岁年。\n书简韦编曾几绝，砚盘铁造亦磨穿。\n牙签插架封芸叶，银烛临窗散蜡烟。\n黄鹤山樵如得意，丹青为作画图传。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5220,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"大雪留饮沈晋卿家","author":"张昱","text":"有客相知感叹频，白头似与雪相亲。\n钟情好语既莫逆，快意深杯忘几巡？\n老至欲求餐玉法，病来不厌散花人。\n从他柳絮因风起，帘幕轻寒不似春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5221,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春梦轩，为江西按察司书吏张永年赠别","author":"张昱","text":"百年妄引几曾停，看取池塘草又生。\n蝶戏落花真自适，莺啼深院欲谁惊？\n卢郎此去应如愿，宋玉从来最有情。\n一枕好风吹酒觉，不愁春梦不分明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5222,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"戏赠杨维桢儒司","author":"张昱","text":"懒散情怀是索居，非关故草绝交书。\n空谋赤壁一斗酒，不寄云间双鲤鱼。\n近日西河疑子夏，几时汉武问相如？\n文章固是雕虫事，请教何人力有馀？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5223,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题端古堂，为陆敏赋","author":"张昱","text":"女娲鍊馀五色石，藏在端溪成紫霞。\n天遣六丁神琢砚，梦中一夜笔生花。\n品题犹是宣和刻，文具今归陆敏家。\n未觉曲江居士老，尚能记事墨涂鸦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5224,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题僧超然林石滩水图","author":"张昱","text":"公事赋诗纪行役，超然著笔良苦心。\n匡庐哀湍走大壑，洞庭橘叶辞空林。\n品题六印文章在，流落三朝岁月深。\n博雅不烦为鉴定，人间过目尽知音。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5225,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题海滨渌绕轩","author":"张昱","text":"绵邈人家海上村，潮头过处与开门。\n远山对面如小画，渌水绕轩清不浑。\n天阔烟云迷去鹤，时来风雨起游鲲。\n槎回定泊阑干外，坐挹雄风倒大尊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5226,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵吴子立湖州船中诗","author":"张昱","text":"一种湖州罨画船，碧波倒浸晚霞天。\n故人总是三生后，风景何如十载前？\n远树白云横暮岭，淡烟黄菊满秋田。\n吴郎似为才情恼，费却银钩几幅笺？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5227,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]