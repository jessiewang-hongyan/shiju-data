[{"title":"忆王孙十二首　 其十一 集句","author":"刘基","text":"郁金苏合及都梁。\n不是金炉旧日香。\n懒对菱花晕晓妆。\n细思量。\n欲话因绿恐断肠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8990,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"忆王孙十二首　 其十二 集句","author":"刘基","text":"满庭芳草易黄昏。\n摘索花枝料峭寒。\n坐见新池落旧痕。\n忆王孙。\n深院无人独倚门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8991,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浣溪沙　 集句","author":"刘基","text":"花压阑干春昼长，碧楼红树倚斜阳。\n入门惟觉一庭香。\n绝壁过云开锦绣，冰丝弹月梦清凉。\n鸾歌凤舞断人肠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8992,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浣溪沙　 集句","author":"刘基","text":"沙渚烟销翠羽空，楚歌重叠怨兰丛。\n树头树底觅残红。\n三百年间同晓梦，几家台榭凤城东。\n露桃犹自笑春风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8993,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"青玉案　 春思","author":"刘基","text":"昨朝出日今朝雨，望不见、愁来路。\n径滑泥深妨纵步，美人何处，花谢谁为主。\n离弦不系鸣筝柱，但满眼相思泪如缕。\n关塞迢迢音信阻，千重云水，万重烟树，心逐征鸿去。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8994,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"长相思","author":"刘基","text":"烟茫茫，草茫茫，人去人来来去忙，沧江空夕阳。\n凫飞翔，雁飞翔，天路冥冥川路长，月明芦苇凉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8995,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"生查子　 集句","author":"刘基","text":"他乡别故人，拭泪攀杨柳。\n此物最相思，皎皎当窗牗。\n留取作秋香，出入君怀袖。\n万里故园心，天地同长久。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8996,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"生查子　 集句","author":"刘基","text":"青山欲暮时，暝色生寒树。\n不那客愁多，复送王孙去。\n涧户寂无人，暗谷疑风雨。\n耿耿夜何长，月落闻津鼓。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8997,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"生查子　 集句","author":"刘基","text":"开帘满地花，风起春城暮。\n悲妾似花身，暂向花间语。\n落叶不归林，惊鸟从横去。\n独立傍银床，点点回塘雨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8998,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"生查子　 集句","author":"刘基","text":"春风能几时，柳色看犹浅。\n胡蝶梦中飞，迹与孤云远。\n明月照花枝，入夜愁难遣。\n形影自相怜，不及衔泥燕。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8999,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"生查子　 集句","author":"刘基","text":"新年旧燕归，似与羁魂语。\n不见帐中人，空见相思树。\n水上觅红县，片片随风去。\n薄暮欲如何，背泣西窗雨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9000,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"生查子　 集句","author":"刘基","text":"思君君未归，向夕千愁起。\n两泪忽成行，滴滴空阶里。\n垂柳覆金堤，蕙草生闲地。\n少壮莫轻年，白日如流水。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9001,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"生查子　 集句","author":"刘基","text":"愁多梦不成，坐对银釭晓。\n轻袖拂花妆，惊起双栖鸟。\n出户独彷徨，烟里看鸿小。\n日下四山阴，转转伤怀抱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9002,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浣溪沙　 即景","author":"刘基","text":"语燕鸣鸠白昼长，黄蜂紫蝶草花香。\n沧江依旧绕斜阳。\n泛水浮萍随处满，舞风轻絮霎时狂。\n清和院宇麦秋凉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9003,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"青门引　 晚春","author":"刘基","text":"数点松梢雨，还被晚风吹住。\n兔葵燕麦几家春，残花断柳，难记旧游处。\n斜阳满目空凝伫，鬓影三千缕。\n是他枝上，蜂蝶纷纷，带取韶华去。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9004,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"渔父词五首 其一","author":"刘基","text":"采石矶头煮酒香，长干桥畔柳阴凉。\n歌欸乃，濯沧浪，来往烟波送夕阳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9005,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"渔父词五首 其二","author":"刘基","text":"白鹭洲边好月明，赏心亭下暮潮平。\n红米饭，紫莼羹，自是无愁过一生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9006,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"渔父词五首 其三","author":"刘基","text":"江花江草雨悠悠，随意东西懒即休。\n黄犬恨，绿珠愁，定应不上钓鱼舟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9007,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"渔父词五首 其四","author":"刘基","text":"钓得鳊鱼不卖钱，瓷瓯引满看青天。\n芳树下，夕阳边，睡觉芦花雪满船。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9008,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"渔父词五首 其五","author":"刘基","text":"朝辞蓼渚暮芦江，自有沙鸥伴醉翁。\n尘世里，一浮萍，不著羊裘动客星。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9009,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"贺新郎　 愁思","author":"刘基","text":"碧秀天涯草。\n怨王孙、雕轮去远，王骢嘶老。\n风雨馀春无寻处，絮乱花飞梦杳。\n断魂与、行云萦绕。\n赤水珠沉迷象罔，暗尘深、不见长安道。\n今夜月，为谁好。\n他乡事事伤怀抱。\n更那堪、荒烟暝霭，晚虹斜照。\n千里关山劳回首，苔径残残红未扫。\n又恐怕、梧桐秋早。\n王母宫中青鸟使，想归来、巳近蓬莱岛。\n竹叶酒，且倾倒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9010,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"如梦令","author":"刘基","text":"莺啄垂圆黄透，蜂抱碎芳红皱。\n睡起北窗风，浓绿满庭如酒。\n回首，回首，想见那人消瘦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9011,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"眼儿媚","author":"刘基","text":"芳草帘栊夕阳红，莺语绿阴中。\n王孙何处，碧云千里，青鸟无踪。\n玉笙吹落天边月，离恨满西风。\n忍将清泪，化为零雨，滴在兰丛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9012,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虞美人","author":"刘基","text":"红榴花下宜男草，色与人俱好。\n佳人重色爱新花，只恐东风渐急、夕阳斜。\n岂知浮艳难长久，看见花枝瘦。\n琐窗晨启怨花空，不觉玉颜憔悴、减春红。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9013,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"玉漏迟　 初夏","author":"刘基","text":"海榴花似火，看看又见，麦秋时候。\n枝上鸣蜩，断续一庭金奏。\n翠沼风漪未定，看叶底、明珠圆溜。\n苔径黝，虾须挂处，有人消瘦。\n缅想那日欢娱，是鸿雁来初，芙蓉开后。\n蔓草青芜，但觉暗愁依旧。\n欲把相思寄与，雾烟惨、不堪回首。\n凝望久，寒鸦自啼疏柳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9014,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"踏莎行","author":"刘基","text":"破暖轻风，做寒细雨，冥冥飞过空江去。\n客中无物可消愁，绿阴满院黄莺语。\n琴断朱弦，香销翠缕，连天碧草人何处。\n欲乘斜日望长安，伤心烟浪迷南浦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9015,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"菩萨蛮七首　 其一 集句","author":"刘基","text":"洞房昨夜秋风起。\n江清露白芙蓉死。\n岂是远行时。\n与君生别离。\n千山鸟飞绝。\n隆想弥年月。\n思妇夜鸣砧。\n君听空外音。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9016,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"菩萨蛮七首　 其二 集句","author":"刘基","text":"东风吹绿瀛洲草。\n去年人到今年老。\n老去愿春迟。\n凋伤感所思。\n攀枝长太息。\n倚树疑无力。\n正是忆山时。\n愁容镜独知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9017,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"菩萨蛮七首　 其三 集句","author":"刘基","text":"文窗绣户垂罗幕。\n江南绿水通朱阁。\n花髻玉珑璁。\n单衫杏子红。\n高楼悲独守。\n日色浓于酒。\n不敢怨春风。\n屏帏向月空。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9018,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"菩萨蛮七首　 其四 集句","author":"刘基","text":"珠帘暮捲西山雨。\n离魂不散烟郊树。\n暝色赴春愁。\n行藏独倚楼。\n王绳回断绝。\n卧见云间月。\n悄悄夜寒生。\n月高风满城。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9019,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"菩萨蛮七首　 其五 集句","author":"刘基","text":"东城江水西飞燕。\n黄姑织女时相见。\n见少别离多。\n浮生能几何。\n梧桐相待老。\n常恐秋风早。\n万恨在蛾眉。\n傍人那得知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9020,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"菩萨蛮七首　 其六 集句","author":"刘基","text":"东边日出西边雨。\n孤帆夜发潇湘渚。\n雨浪细无声。\n烟斜月转明。\n清猿不可听。\n枫落吴江冷。\n更欲向芳洲。\n水深难急流。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9021,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"菩萨蛮七首　 其七 集句","author":"刘基","text":"孤云目断苍梧野。\n无边落木萧萧下。\n兹岁巳蹉跎。\n其如芳草何。\n玉阶生白露。\n病骨伤幽素。\n梦好更寻难。\n相思锦帐寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9022,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浣溪沙　 即景","author":"刘基","text":"云压斜晖照树黄，风生水榭绿阴凉。\n渴蛙得雨闹池塘。\n红焰射人榴火炫，青丝窣地柳条长。\n捲帘明月满回廊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9023,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"菩萨蛮　 集句","author":"刘基","text":"林中独酌邻家酒，门前学种先生柳。\n灌木自悲吟，风泉清道心。\n独行潭底影，蝉噪林逾静。\n渡口欲黄昏，残阳归掩门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9024,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浣溪沙","author":"刘基","text":"布谷催耕最可怜，声声只在绿杨边。\n夕阳江上雨馀天。\n满地蓬蒿无旧陌，几家桑柘有新烟。\n战场开尽是何年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9025,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"卜算子","author":"刘基","text":"春去蝶先知，花落蜂难缀。\n草绿庭空不见人，愁共天无际。\n凿沼种荷看，水浅荷钱细。\n惟有青苔最可怜，欲上人衣袂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9026,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"金钱子　 五月五日作","author":"刘基","text":"云淡风微，江雨欲来还去。\n倚阑干、鬓霜千缕。\n白水青芜，是征鸿归处。\n望尽天涯，夕阳犹在深深树。\n艾叶榴花，又上阿谁门户。\n悄空梁、燕雏自语。\n王谢亭台，杳不知何许。\n独立苍茫，乱鸦啼、满城钟鼓。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9027,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梁州令","author":"刘基","text":"雨过群山翠。\n杨柳含烟如醉。\n画檐双燕引雏飞，风动榴花，点点猩红碎。\n对花莫把阑干倚。\n心乱难为理。\n夕阳江上，满眼清波，总是愁人泪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9028,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"最高楼","author":"刘基","text":"今宵月，还照别离愁，愁上最高楼。\n九霄无路青冥阔，玉京风露冷于秋。\n宝刀裁不断，水东流。\n谁知道，黄粱炊未熟，早过了，洞天三十六。\n尘土事，几时休。\n广寒桂树清香好，圆光恰满又成钩。\n笑阶前，萱草浪，语忘忧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9029,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"花犯　 秋夜","author":"刘基","text":"夜何其，星移漏转，凉蟾照无睡。\n宝筝弦断，金雁与青釭，相对憔悴。\n塞鸿过尽人千里。\n馀香怨绣被。\n但满眼、碧云红树，阑干空自倚。\n阶前暗蛩最殷勤，悽悽似向我、说他情意。\n莎露冷，相将到、晓霜开蕊。\n惟应有、素娥未老，曾几见、桑田成海水。\n任浪语、愁来堪遣，君看明镜里。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9030,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西江月","author":"刘基","text":"红叶无风自落，黄花过雨犹香。\n床头尘瓮耻空觞，添了愁城万丈。\n阅世身如萍梗，怀人梦绕潇湘。\n应知此恨不寻常，岂在眉间目上。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9031,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"卜算子　 咏雨","author":"刘基","text":"搣搣度莲池，漠漠昏松陇。\n却过西园拂紫尘，柳媚花矜宠。\n泥润燕衣沾，粉腻蜂须重。\n极目沧江不见人，波浪兼天涌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9032,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"蝶恋花","author":"刘基","text":"春梦岑岑呼不起，草绿庭空，日抱娇莺睡。\n暖吹飘香三万里，残丝骨断天沉水。\n宝瑟弦僵谁复理，梅子青青，苦在心儿里。\n满径苍苔花糁地，杜鹃口血闺中泪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9033,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"摸鱼儿　 晚春","author":"刘基","text":"悄寒生、沉沉院宇，不知春在何处。\n逢春渐老能多少，惟有暗愁无数。\n春又暮，但碧草、和烟绿叶漫飞絮。\n画梁燕语，还是旧音声，乌衣巷陌，转盼几今古。\n天涯路，流水青山如故。\n离魂长在郊树。\n夜深月暗苍梧远，化作杜鹃归去。\n人不见、桃花自落空阶上。\n东风未许，吹梦过蓝桥，关河满目，波浪渺南浦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9034,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"玉楼春","author":"刘基","text":"春来触处花成绮，春去可怜花委地。\n催耕布谷彊知时，去国杜鹃空有泪。\n双鱼不见人千里，落絮牵愁和梦起。\n芭蕉多事惹东风，故作雨声惊客耳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9035,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"惜馀春慢　 咏子规","author":"刘基","text":"陇水沉沙，巴猿咽雨。\n泪尽潇湘竹死。\n多情怨魄，何处飞来，声在万重云里。\n肠断行吟放臣，去国佳人，地遥天迩。\n悄空山，月冷风清，惟见野棠如绮。\n记向日、琼户珠帘，樱唇簧舌，吹商呵徵。\n朱颜尚在，十二阑干，回首不堪重倚。\n沧海桑田有时，海若未枯，愁应无巳。\n到明朝、赢得浮花满树，锦毇霞碎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9036,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"金人捧露盘","author":"刘基","text":"水如蓝，山如黛，草如丝。\n正去年、双燕来时。\n衡门昼掩，日长惟有睡相宜。\n午风吹破，北窗梦、檐影参差。\n李花开，梅花谢，榴花放，杏花稀。\n枉教人、两鬓霜垂。\n凭阑伫立，空将愁眼盻斜晖。\n断云迢递，趁征雁、直到天涯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9037,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"水调歌头","author":"刘基","text":"雨过百花尽，绿叶自成帷。\n翛然惊破残梦，何许一黄鹂。\n独上高楼凝望，不见阳春去处，惟见草离离。\n且喜画梁燕，还傍旧巢归。\n理纨扇，清竹簟，试单衣。\n莫思身外闲事，有酒便须挥。\n蝼蚁王侯同尽，何用名标竹帛，留与后人疑。\n坐久暮天碧，月在绿杨枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9038,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"玉楼春","author":"刘基","text":"江城雨熟黄梅后，楼阁清高处永昼。\n阶前夕露宝珠呈，叶底夜蝉金石奏。\n苍苔不受残红覆，市径沿墙欺组绶。\n老来于物总忘情，漫为青山开北牗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9039,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"归朝欢","author":"刘基","text":"紫燕成雏辞旧宇，红日满庭鸡唱午。\n披襟起溯北窗风，绿杨叶底闻莺语。\n故人音信阻，白蘋吹尽沧江雨。\n倚阑干，悠然独笑，暝色下平楚。\n浮生百岁真羁旅，富贵繁华萍梗聚。\n重瞳隆准等丘墟，紫髯桑盖俱尘土。\n坐来天欲暮，乌鸦立遍城头树。\n看云头，金盘涌出，身在广寒府。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9040,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"传言玉女　 咏蝶","author":"刘基","text":"为问韩凭，何事化为胡蝶。\n妒风羞雨，一身轻似叶，园苑昼永，丽日晴烟相接。\n舞回柳眼，拍翻花颊。\n殢粉迷香，困酣犹自未惬。\n锦云深处，更愁浓露浥。\n何况素秋，枝上晓霜披鬣。\n秪应无柰，翠销红厌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9041,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"好事近","author":"刘基","text":"雨过却斜阳，虹外远山犹湿。\n独据槁梧高坐，符北窗风入。\n可人嘉树有清阴，蝉噪一何急。\n倦暑盼秋来，又恐芳时轻戢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9042,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虞美人","author":"刘基","text":"东风过了南风起，节去如流水。\n日长门掩燕交加，可惜红葵落尽、雨中花。\n人闲只愿花长好，花谢人催老。\n老来空有爱花心，无柰斜阳不为、驻光阴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9043,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"诉衷情","author":"刘基","text":"相思日日上高楼，还是去年秋。\n无情梁上双燕，弃我忽如雠。\n虫啧啧，叶飕飕，夜悠悠。\n阑干谩倚，塞北江南，何地无愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9044,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"御街行　 秋夕","author":"刘基","text":"梧桐滴露鸣金井，夜耿耿、如年永。\n月明栖鸟数移柯，有似佳期不定。\n华年迅速，碧霄迢递，别恨空心领。\n青鸾怕见单栖影，任网遍，盘龙镜。\n盈盈一水隔双星，肠断羽迷鳞暝。\n消愁凭酒，惟应无柰，酒与愁同醒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9045,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浣溪沙　 槿花","author":"刘基","text":"可怪西园木槿花，强将孤艳斗轻霞。\n不知门外夕阳斜。\n应有断魂随蛱蝶，岂无悠恨寄寒鸦。\n那堪横被绿苔遮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9046,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"玉漏迟　 咏雁","author":"刘基","text":"渺长空万里，西风动地，雁来无数。\n早发榆关，暮入楚江烟雨。\n逝水浮花去远，但满眼黄芦飞絮。\n肠断处，云深梦泽，月寒湘浦。\n楼上有个佳人，闷倚遍阑干，翠眉双聚。\n泪湿鸦鬟，化成素丝千缕。\n一望一回惆怅，又灯暗、网虫垂户。\n天路阻，谁知此情愁苦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9047,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"满庭芳　 重九","author":"刘基","text":"雨歇凉生，天高气爽，又是一岁重阳。\n雁声来处，云白草茫茫？\n黄菊知人无酒，也不惜、椷死幽芳。\n龙山上，西风暝霭，落日下牛羊。\n登楼，何限兴，一齐分付，络纬寒螀。\n把古今闲事，莫更思量。\n坐到银河案户，城角尽、月转空墙。\n凝眸久，惊乌蜚起，零露湿衣裳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9048,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"花心动","author":"刘基","text":"墙下红葵，向斜阳、犹开那时颜色。\n半捲绣帘，独倚雕阑，泪眼为谁长滴。\n九疑烟雾连蓬岛，蜚鱼去、浑无踪迹。\n旧游处、空馀满地，绿苔堆积。\n百岁真如过客，待落蕊重荣，不知何夕。\n镜掩素尘，香歇罗衣，此恨怎生消得。\n夜凉月转梧桐影，青灯共、疏萤寥寂。\n正憔悴、饥虫又啼暗壁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9049,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]