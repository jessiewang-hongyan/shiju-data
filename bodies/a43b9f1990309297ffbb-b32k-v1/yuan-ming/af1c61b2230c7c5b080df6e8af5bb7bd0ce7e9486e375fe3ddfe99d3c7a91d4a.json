[{"title":"演法师惠纸帐","author":"张昱","text":"银灯夜照白纷纷，四面光摇白縠文。\n隔枕不闻巫峡雨，绕床惟走剡溪云。\n风和柳絮何因到，月与梅花竟不分。\n塞北江南风景别，却思毡帐旧从军。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5288,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题天镜方丈，为能仁净秋江长老赋","author":"张昱","text":"大宗大派接秋江，砥柱中流露法幢。\n照世万缘俱是妄，行天一镜迥无双。\n当家谁道非临济，说法还须在老庞。\n蓦地绕床三振锡，更无言句两心降。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5289,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄东山寺长老宅区中，索画梅","author":"张昱","text":"同是多生无垢身，孤芳岁晏转精神。\n濡毫应觉香先到，写影无如月最真。\n庾岭近来还有信，花光以后更何人？\n情知此事难描画，驿使空回可不嗔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5290,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"冬青轩，为天印上人赋","author":"张昱","text":"冬青树老法王家，得与维摩共岁华。\n枝上蜡封经夏雪，阶前雨积过春花。\n词人有兴从题壁，童子何知但煮茶？\n不下禅床迎送拙，大千同是一袈裟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5291,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄题松风海月方丈，为普慈寺林清远赋","author":"张昱","text":"普慈寺主会当年，画雀双鸣赴法筵。\n风过忽闻松上雨，月行不离海中天。\n三生身性何曾改，一念声闻总是缘。\n先辈往还成故事，玉围曾解寺门前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5292,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"集云轩","author":"张昱","text":"妙严院主断声闻，密室圆光覆树云。\n床下虎心俱化善，阶前鸟迹自成文。\n池窥片月遗空相，树接诸天散异芬。\n传诵六时行道处，至今轩户集氤氲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5293,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西畴，为陈生赋","author":"张昱","text":"负郭有田何所忧，每年春事在西畴。\n耕回收犊系墙角，客至呼鸡下树头。\n织女机边祈杼柚，天田星下祝瓯窭。\n豳风七月诗歌罢，土鼓洼樽乐未休。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5294,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题宝林方丈，留别伯举法师","author":"张昱","text":"金相浮图千级开，杂花如雨在莓苔。\n要看弹指成楼阁，未许胡僧话劫灰。\n法器即如廊庙具，宝林自是栋梁材。\n虽然一片袈裟地，不是儿孙不可来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5295,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄报国寺东堂止庵祥尊师","author":"张昱","text":"觅船直欲横塘去，船去横塘为访谁？\n白首正惭玄度老，碧云曾与惠休期。\n山林此日多高士，风雨连床可论诗。\n入社既能容载酒，陶潜无复更攒眉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5296,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"玉岑旧隐，为林叔平赋","author":"张昱","text":"斋馆枵然题玉岑，老生时作越人吟。\n曰妻曰子留他土，维梓维桑念故林。\n岂谓青云天上远，漫怜白发镜中深。\n古来儒士多遗憾，为此文章竟陆沉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5297,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古村，为曹迪赋","author":"张昱","text":"魏国南来有子孙，至今人物古而村。\n松根曲处安琴枕，山石洼中注酒樽。\n汲冢文章遗竹简，秦人风俗尚桃源。\n海波不接天河水，要得仙槎径造门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5298,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"思云图，为罗从事赋","author":"张昱","text":"抽毫据尔赋思云，为感罗含以孝闻。\n职任紫垣亲不逮，粟支红腐禄无分。\n终身有慕谁非子，此日移忠正在君。\n郎署丹青称高步，须求名笔记斯文。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5299,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠写神朱大年","author":"张昱","text":"笔头何在觅人知，镜里相看不自疑。\n麟阁尽能图燕颔，龙沙谁复恨蛾眉？\n千年名姓毛延寿，一代丹青顾恺之。\n梦感九重终见召，艺精宁患不逢时？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5300,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送别唐克让还家","author":"张昱","text":"家山远在白云边，膝下相违又隔年。\n万里壮游司马氏，数函书画米家船。\n裁成綵服欢无已，遗却瑶华思惘然。\n海内故人零落尽，别离多付酒尊前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5301,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄表兄萧文索处士","author":"张昱","text":"七十馀年亲弟兄，书来堪喜复堪惊。\n杯中酩酊无虚日，枕上邯郸过此生。\n老至音书宜有数，别来骨肉若为情。\n遭逢洪武开新运，又十三年见太平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5302,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"克让许寄酒，诗以趣之","author":"张昱","text":"春至遣怀惟恃酒，莫教花发酒来迟。\n文章每与年俱进，世事还于老始知。\n海岳几时吟雪梦，涔阳有约采兰期。\n古音最爱朱弦曲，弹到高堂念别离。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5303,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"月轩，为张令赋","author":"张昱","text":"思亲对月清宵坐，了却公家事可知。\n白发已无重见日，清光还有再圆时。\n叶间零露皆成泪，窗外栖乌总是悲。\n大孝终身俱有慕，不辞为赋蓼莪诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5304,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄汤水严仲原处士","author":"张昱","text":"情忝姻家亦是缘，人来无不问汤泉。\n间常采菊东篱下，每望长安西日边。\n素业鱼盐沧海上，綵衣孙子画堂前。\n高车况是京畿内，受用高年五福全。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5305,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"孝友堂，为姚氏彦名、彦昌昆弟赋","author":"张昱","text":"两生孝友谁不知，左辖题堂固所宜。\n岂独声名从此大，要教风俗与之移。\n棣华煜煜照春日，乌鸟哑哑啼树枝。\n林植羽栖俱有感，过门宾客可无诗？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5306,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"瀼东耕者，为社友黄成章赋","author":"张昱","text":"鹿门不道似乌溪，榆柳连阴覆大堤。\n常日墟船潮上下，每年春事瀼东西。\n劝农随例拜车马，观稼依稀从杖藜。\n牛角挂书吾道在，古来力食尽男儿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5307,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄王元吉、杨东叟二处士","author":"张昱","text":"华亭犹有古人存，风景依稀似鹿门。\n一曲晴湖通画舫，万株古木出乌林。\n卜邻王翰俱文物，识字扬雄足酒樽。\n有约重来访东叟，徵歌同乐最闲园。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5308,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宝古斋","author":"张昱","text":"曹昭宝古以名斋，韫椟非时不一开。\n图画丹青半人物，尊彝文藻尽云雷。\n流传竟自何人得，玩赏知经几手来？\n世故浮云眼前事，题诗投笔为兴怀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5309,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"双桂堂，为俞子成赋","author":"张昱","text":"双桂团栾对两楹，碧云无数共生成。\n郤生片玉曾驰誉，窦氏五枝俱向荣。\n奕叶至今传世泽，灵根既老际文明。\n会须满袖天香里，载酒高堂说姓名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5310,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送廖思诚知安肃县","author":"张昱","text":"新恩领县之安肃，便道宁家孝使然。\n亲舍恋深云白白，官程期速马翩翩。\n人民社稷上所倚，期会簿书勤是先。\n政考有成俱大用，到官知尔又春前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5311,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"听泉轩，为龙井智法师赋","author":"张昱","text":"山僧听得泉声好，每夜坐忘清夜深。\n松上落来惊鹤梦，潭中泻下杂龙吟。\n观心已净平生垢，到耳能空见在心。\n此去涓流如不息，沛然谁禦海鲸音？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5312,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"听律令乡饮回，赠刘复斋、马弘道","author":"张昱","text":"晚步河桥念此身，馀生犹幸齿编民。\n府城无迹非为贱，松菊犹存未是贫。\n官府才听新降律，酒垆先问有钱人。\n衢歌仰咏唐虞化，乡饮俱前老缙绅。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5313,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅竹轩","author":"张昱","text":"古梅修竹两相亲，坐对高堂如大宾。\n空谷有人怜翠袖，雒阳无梦染缁尘。\n岁寒清白能同趣，日暮平安是此身。\n三友若能同此隐，门前杨柳任芳春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5314,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚步西湖畔，会叶舜臣自运司中出","author":"张昱","text":"武林耆旧似公稀，未觉文章与世违。\n节序去人惊逝水，柳阴当面转斜晖。\n群鸥晚戏呈天趣，孤鹤宵鸣自道机。\n早作馀寒宜晏出，为嫌多露湿荷衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5315,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"悼孔英夫提举","author":"张昱","text":"老泪何堪哭寝门，斯人况复是斯文。\n六经政尔传家集，曲阜苍然掩暮云。\n郁郁涧松看得地，昂昂野鹤又离群。\n贤郎无忝家声旧，能以文章继世芬。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5316,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"修净慈寺成，贺简以道长老","author":"张昱","text":"古佛毗耶愿海深，万间弹指变黄金。\n分明兜率诸天境，庆赞阎浮施主心。\n堂上鼓钟声大地，域中龙象尽知音。\n自应雪夜传衣处，不独神光在少林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5317,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送沈敬止赴胄监","author":"张昱","text":"老态颓然厌世氛，喜看贤者步青云。\n事君如得行其志，出对还当罄所闻。\n列宿九霄馀气象，灵芝五采绚人文。\n满朝侍从皆英俊，始是文章可策勋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5318,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"郑竹隐处士墓上作","author":"张昱","text":"何惭南渡旧名臣，奕世居然保缙绅。\n五福备身宜尔寿，一经教子异他人。\n蛟螭赑屃碑文古，松柏阴森墓道新。\n弹指浮云今古事，几家荒草卧麒麟？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5319,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宋高宗御题李唐画唐香山九老二律诗","author":"张昱","text":"两疏谁是见机还，终始君臣似此难。\n宸翰昭回云汉上，衣冠彷佛画图间。\n当时诸老琴尊会，尽是同朝鸳鹭班。\n风采拜辞云陛下，白云千载在香山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5320,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"中秋望月，甲辰年赋 其二","author":"张昱","text":"月里分明见九州，浮云西北是璚楼。\n歌钟未厌今宵酒，砧杵那禁此夜愁？\n若使有情须痛哭，不知何物是风流？\n霓裳不向当时罢，戎马中原未肯休。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5321,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"学舟为崔检校赋","author":"张昱","text":"髯崔家寓市河头，斋馆临河题学舟。\n不为乘桴浮大海，应期击楫誓中流。\n风波浮世何能济，驷马高车更有忧。\n何事外郎居骑省，却将魂梦记沧洲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5322,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题燕山万里图，为江左葛元毳编修子赋","author":"张昱","text":"翰林藁葬古幽州，万里游魂土一丘。\n父子有情终自苦，丹青得趣岂知愁？\n风沙日日黄龙塞，雨雪年年青海头。\n狐死首丘谁不念，莫将遗憾在遐陬。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5323,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送单尚书致仕还乡","author":"张昱","text":"风尘澒洞识龙颜，便解兵符拜谏间。\n天上已扶真主出，榻前尚乞故乡还。\n黄金优老车增重，紫禁朝天梦可闲。\n世受淮田知所赐，几人得似单家山？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5324,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题国清寺三隐堂","author":"张昱","text":"莫与闲人说旧游，这些风采尽风流。\n只因当日机曾露，直到而今笑未休。\n虎迹已无深院闭，藤花犹盖两岩幽。\n相逢总是知音者，莫叫苍天恼赵州。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5325,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"明岩寺","author":"张昱","text":"叠嶂重岩出半天，芙蓉幽洞下相连。\n浮云富贵二三子，放浪人天五百年。\n饭后风松为伴侣，春来花鸟作因缘。\n村堂野墅俱题遍，句句天机合自然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5326,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寒岩寺","author":"张昱","text":"一片浮云去不还，龙吟虎啸出人间。\n礼干往日成饶舌，太守当时亦厚颜。\n秋至候虫还唧唧，春来鸣鸟自关关。\n烟萝古洞依然在，要问寒山即此山？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5327,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送郭子程湖州收父骨还庐陵","author":"张昱","text":"事亲尽礼谁非孝，岂愿遭逢世道艰？\n千里风尘音问隔，十年父子梦魂间。\n首丘自负终天痛，函骨宁期此日还？\n地下老翁应自慰，免将遗憾在他山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5328,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"同谢别驾过淀山湖，登普光寺阁，次壁间马郎中诗韵","author":"张昱","text":"浮云终日作轻阴，寺下龙潭百丈深。\n古刻尚存邢女记，好诗今与谢公吟。\n风行淀水摇深碧，雨过松花落细金。\n怕见南湖春草色，每来高阁倦登临。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5329,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"陪月中丞访宝林寺别峰尊师，有诗，因次其韵","author":"张昱","text":"传呼载道不知遥，骢马乘秋气益骄。\n佛运已知当末劫，寺碑犹及见前朝。\n升堂钟鼓闻三界，听法鱼龙趁两潮。\n不有斯文为世重，东坡何以慕参寥？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5330,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客至","author":"张昱","text":"潦倒无能因不才，乐然笑口有时开。\n呼猿洞边采药到，浴鹄湾头载酒回。\n对客且容谈玉麈，题诗何必寄银台？\n瓮中听取春浆熟，便买鲈鱼煮四鳃。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5331,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题东皋隐居，为范思贤赋","author":"张昱","text":"海水桑田几变迁，桃花依旧郡城边。\n蔬园百亩充官税，药价一生供酒钱。\n诗句兴来题綵笔，道心悟后付朱弦。\n院曹谁信同僚后，谈笑交游十五年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5332,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"留题天台香积寺，为乡僧印秋海赋","author":"张昱","text":"花界追寻一榻凉，破除烦恼是禅房。\n慢挥大扇消长日，共倒深杯说故乡。\n万事到头成画虎，百年束手共亡羊。\n明朝马首劳瞻望，此别人间更渺茫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5333,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"归来堂诗，为云间青龙镇章吉甫太守题","author":"张昱","text":"使君致仕归来日，九十慈亲犹在堂。\n秋水鲈鱼朝入馔，薰风纨扇晚生凉。\n孝廉早已称高士，名德今宜重一乡。\n花底板舆喧笑语，白须风动綵衣裳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5334,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送隽侍者还永乐寺，寄阐大猷尊师","author":"张昱","text":"记乘官舫过明州，永乐寺中曾一游。\n绕径凉云修竹晓，满池香露小荷秋。\n松花酒贮山瓶送，雀舌茶烦蒻笼收。\n尔隽到家烦问询，旧题还刻在诗楼？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5335,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"黄冈寺，赠朱质夫","author":"张昱","text":"尚书宾客唯予在，门下诸生独尔存。\n终有黄钟求贾铎，肯于清庙少牺尊？\n茶瓜留客冈头寺，风雨题诗海上村。\n莫问几时回马首，也须迎候出衡门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5336,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"环隐，有序","author":"张昱","text":"大化循环不可穷，至哉枢始得环中。\n漆园化蝶有今日，柱史犹龙非此翁。\n斋馆前朝存旧制，丹青遗像仰高风。\n百年文献凋零尽，川上空嗟逝水东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5337,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梦梅花处","author":"张昱","text":"帐底梅花觉有香，不由铁石作肝肠。\n宫妆何处红绡女，春色谁家白玉堂？\n枕上翠禽栖正稳，梦中蝴蝶引初长。\n城楼画角复吹觉，任有文章恼宋郎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5338,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"看剑亭，为曹将军赋","author":"张昱","text":"此剑名家已数传，为曾与国净风烟。\n闻鸡起舞非今日，对酒闲看忆往年。\n三尺神光遗电影，一函宝气閟星躔。\n章江曰夜东流去，亭下题诗重惘然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5339,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"纸被","author":"张昱","text":"闲眠受用剡藤香，不比行云恼宋郎。\n月里杨花终夜落，云中蝴蝶过春狂。\n象床绣枕知难称，道馆僧房或可当。\n还是梦中风景别，东华尘土久相忘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5340,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠医士潘氏中和斋","author":"张昱","text":"心天一气贯中和，孺子膏肓若我何！\n内景金花今證道，上池玉液不生波。\n献方龙每乘云至，收杏人曾倩虎驮。\n十世医传方胍妙，门前无奈杏花多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5341,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄谢伯昭、伯理二昆仲","author":"张昱","text":"话别南堂二十年，江湖鱼雁两茫然。\n车书此日同天下，濠泗而今是日边。\n架上遗书宜教子，老来乐事是归田。\n谢家子侄应相念，每到池塘忆惠连。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5342,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过林和靖墓","author":"张昱","text":"西湖处士林和靖，两句梅诗直到今。\n此事岂容同末俗，当时还亦有知音。\n高车大旆知何往，剩水残山尚可吟。\n三尺孤坟埋宿莽，过君谁不愿抽簪？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5343,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"尚絅斋，为洞霄郎可道赋","author":"张昱","text":"衣锦能怀尚絅心，闇然师道重山林。\n玉因韫椟知无价，琴到希声是大音。\n蝶化梦魂高枕后，鹤鸣秋水万山深。\n青苔黄叶空岩畔，俗驾何由得一寻？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5344,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"琼花","author":"张昱","text":"几枝雪艳向风斜，未许吹香上鬓鸦。\n谁取根来广陵郡，却留春在后皇家。\n懿公灭卫虽云鹤，炀帝亡隋岂独花？\n自是锦帆迷故国，恨连芳草满天涯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5345,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄题清晖楼","author":"张昱","text":"谢公履迹遍岩扉，似觉高情与世违。\n昔日文章归丽句，至今山水发清晖。\n神仙灭迹虚金露，尘俗何缘别翠微？\n尚忆咏诗同水部，山林有待薜萝衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5346,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄梁太医","author":"张昱","text":"髯翁邂逅海西边，风采何曾异往年？\n谈客过门从取醉，贫家问疾不论钱。\n送方龙每乘云去，种杏人曾见虎眠。\n此等希奇何足怪，古来医术尽通仙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5347,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]