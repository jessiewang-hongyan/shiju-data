[{"title":"次韵和石末公中秋不见月诗","author":"刘基","text":"一年明月中秋好，万里长空此夜阴。\n雨晕青灯昏远思，虫鸣黄叶乱乡心。\n见愁盗贼氛犹恶，莫怪乾坤气尚淫。\n便欲扪萝上天柱，九霄风露恐难禁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8654,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公七夕诗","author":"刘基","text":"天上传闻会两星，清秋夜色湛玄冥。\n蚌胎隐见银蟾窟，鹊翼高低玉女軿。\n一水经年才邂逅，七襄终日岂神灵。\n劳生厌事惟思睡，独卧无心觐帝青。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8655,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再和倒用前韵","author":"刘基","text":"天官垂象焕空青，会合徒闻帝子灵。\n三武夜开千石簴，两旗晨轙七香軿。\n房帷瓜果纷祠祀，霄汉云霓隔晦冥。\n惆怅多忧江海客，登楼独自看台星。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8656,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"遣闷呈石末公","author":"刘基","text":"公庭春树秋重绿，但见鸤鸠日日鸣。\n不雨正当三伏热，看云无柰百忧生。\n草间群盗俱縻爵，天下何人尚力耕。\n汉法几时还再复，白头犹得咏升平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8657,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"庭前萱草花落巳久至秋复开感而作诗柬石末公","author":"刘基","text":"露下蛩鸣寒气催，蒹葭叶响雁归来。\n鬓毛巳为忧生白，萱草何须晚更开。\n袅袅悲风吹落木，炎炎赤日走黄埃。\n干戈未了仍饥馑，人事天时总可哀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8658,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公闵雨诗","author":"刘基","text":"腾云降雨指龙功，况复山川祭秩隆。\n岂意愆阳为沴气，忽过炎夏到秋风。\n祈年劳酒仪徒备，登谷尝新望巳空。\n享祀未应无报称，可堪不杀待时丰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8659,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再用韵","author":"刘基","text":"旱魃为妖殄岁功，田畴龟坼遍污隆。\n无多过雨才鸣叶，不定行云又逐风。\n蔓草荒烟秋社迥，黄沙白苇暮江空。\n愁来漫忆淳于祝，却愧灵祗享祀丰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8660,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"妙成观道士刘云心挽诗","author":"刘基","text":"少微星下葬神仙，白玉楼中迓翠軿。\n弟子焚香玄鹤逝，天官肃驾紫鸾翩。\n金丹缥缈空山月，铁笛凄凉远树烟。\n溪上故人如见问，碧桃花里过年年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8661,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公九日见寄","author":"刘基","text":"去年见雁思乡里，今岁还乡雁不来。\n此地凄凉逢九日，何时清切睹三台。\n莞茅夜冷蛩螀急，禾黍秋空鸟雀哀。\n辟难无劳效桓景，巢居随处压崔嵬。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8662,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"陈太初充兵应点作诗戏之","author":"刘基","text":"无仆无台一老儒，数间茅屋近通衢。\n忽闻巷长呼排甲，急换戎装出荷殳。\n就列敢辞长拱立，随群独作没阶趋。\n西风鼓角秋宵永，明日青髯是白须。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8663,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公开读有感","author":"刘基","text":"百年万国奉王正，相业台纲属老成。\n山海若时共职贡，郊原何处有戈兵。\n庙谟可使归权倖，祖训由来重变更。\n欲叫天关无羽翼，拊心长叹不胜情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8664,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夕有感柬石末公","author":"刘基","text":"独立西风闻莫蝉，起看时物怆流年。\n星临野树辉辉动，露出庭莎的的圆。\n无柰素丝侵绿鬓，却嫌黄菊似金钱。\n烟尘满眼难回首，惆怅高堂坐细毡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8665,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公自讼之作","author":"刘基","text":"绿駬骅骝不服骖，王良造父亦难堪。\n羡君名重中台上，勋业终光北斗南。\n露井凄风残绿少，霜林落日乱红酣。\n侯封职在同藩屏，班爵无劳阿化男。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8666,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丙申岁十月还乡作七首 其一","author":"刘基","text":"溪上寒山淡落晖，溪边风送客帆归。\n故家文物今何在，平世人民半巳非。\n华发老翁啼进酒，蓬头稚子笑牵衣。\n自嗟薄质行衰朽，未睹门廷赋采薇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8667,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丙申岁十月还乡作七首 其七","author":"刘基","text":"五载辞家未卜归，归来如客鬓成丝。\n亲知过眼还成梦，事势伤心不可思。\n且喜松楸仍旧日，莫嗟闾井异前时。\n修文偃武君王意，铸甲销戈会有期。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8668,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"石末公再赋元夕见寄用韵酬之","author":"刘基","text":"东方月出鱼龙窟，北极云开虎豹关。\n渤澥青丘金作水，昆崙赤岸玉为山。\n风光岂减常时好，灯火嗟逢此夜悭。\n听尽残钟成不寐，那无飞羽入玄间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8669,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁酉七月十四夜望月仍蚀且既而司天报亦不至因感去年作此寄石末公","author":"刘基","text":"山城望月中元夜，天运循环四序周。\n顾兔又从银汉灭，磔蟆空抱玉川忧。\n清台视梫当箕尾，仙使乘槎隔斗牛。\n安得寄书凭去燕，为言桂树不胜秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8670,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为王彦和赋槐堂","author":"刘基","text":"晋公庭上三槐树，千载流传是德符。\n今日耳孙思继述，昔年手泽叹荒芜。\n当窗欲看屯云叶，夹径先栽带雨株。\n会见枝头金粟蕊，秋风吹送上天衢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8671,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和余嘉宾御史见寄","author":"刘基","text":"二纪相思欲奋飞，百年心事苦相违。\n风尘跋涉容颜改，豺虎纵横信使稀。\n忽枉缄书如见面，不胜悲喜却沾衣。\n有怀欲语无由写，骢马天涯几日归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8672,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公月蚀见寄","author":"刘基","text":"凉气开秋桂未花，青天见月漫咨嗟。\n玉毫扑搠此中兔，金背荧煌何处蟆。\n百鍊精铜才照胆，连城白璧底生瑕。\n谁能鼓剑披氛祲，莫遣东郊马喷沙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8673,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"即事有感呈石末公","author":"刘基","text":"葵藿倾心向大明，参商琐琐只寻兵。\n蛾眉欲擅三千宠，鱼翼难通九万程。\n贝锦笙簧鸱鸟瑞，明珠瑑玉泰山轻。\n两阶干羽闻来格，分北犹劳圣主情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8674,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公感怀之作","author":"刘基","text":"凤去深林鹜在庭，西风回首故山青。\n杞人岌岌忧将殒，楚国茫茫醉不醒。\n自觉艰虞多错午，谁怜耗斁祝宁丁。\n金芝玉蕨甘如蜜，岁晚吾从董五经。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8675,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公中秋玩月","author":"刘基","text":"一年二六团圆月，此夜光辉独耐看。\n银汉波涛三岛接，玉京风露九霄寒。\n方欣酷暑随时去，只恐清商促岁阑。\n更上南楼瞻北极，那无鸿雁报平安。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8676,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和十六夜月","author":"刘基","text":"才圆又缺中天月，犹自寒光媚老蟾。\n承露仙人珠落掌，别风楼观雪生檐。\n玉阶桂影骎骎薄，金井苔花渐渐添。\n坐久城头闻夜柝，牢愁清兴苦相兼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8677,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再次韵","author":"刘基","text":"永夜凉风吹碧落，深秋白露洗明蟾。\n金波滟滟将流瓦，玉砾荧荧恰近檐。\n贝阙寒生鱼脑减，龙宫气肃蚌胎添。\n从军不废篇章事，倚赖元侯智勇兼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8678,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和刘宗保秋怀二首 其二","author":"刘基","text":"蛩螀啼露作悲愁，雕鸮抟风乐素秋。\n莫讶系匏长不食，亦知神剑解相求。\n翰林白发三千丈，吏部回肠一万周。\n借问何如青白眼，酣歌竟日为身谋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8679,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公九日无菊诗","author":"刘基","text":"篱菊无花冷夕阳，西风空送雁还乡。\n巳妨少昊颁时令，更阻渊明泛酒觞。\n生意循环深自识，年华逝水去谁伤。\n愁来最爱霜中叶，满眼殷红间浅黄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8680,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"野行偶见红树怅然有感呈石末公","author":"刘基","text":"红树伤心夕照前，漫山映水为谁妍。\n树当摇落人尤惜，人自忧愁树不怜。\n九译未通青鸟使，四郊犹涨绿林烟。\n野夫病足思休息，藉草栖橧拟晏眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8681,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公悲红树二首 其一","author":"刘基","text":"乾坤何处非王土，稂莠谁令满大田。\n未扫绿林千嶂里，还看红树九秋前。\n吴宫露冷蝉何在，汉苑风悲鹤自怜。\n却羡鲁阳功德盛，挥戈回日至今传。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8682,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠西岩道元和尚","author":"刘基","text":"西岩寺里云巢子，不到人间几十年。\n杖锡野猿迎路侧，谈经山鬼拜灯前。\n尘飞劫火青春梦，雪满长松白日眠。\n近得渊明入莲社，兴来时复有诗篇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8683,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题王伯衡县尹桑阴图","author":"刘基","text":"渔阳太守之官后，种得桑阴比召棠。\n麦陇风微云委甸，茅檐日暖雪盈筐。\n仓庚过去青枝动，戴胜飞来紫椹香。\n千载先生同此意，为君重赋两岐章。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8684,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"戏和石末公催太初画山水之作","author":"刘基","text":"春蚕吐丝作成茧，辛苦为人身上衣。\n画史等闲挥彩笔，女工憔悴倚空机。\n高堂素壁峰峦出，暮雨朝云梦寐归。\n可怪唐朝杜陵老，瘦妻短褐有光煇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8685,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和石末公见示有字韵","author":"刘基","text":"长想天涯皆内地，忍看阃外即他乡。\n扶生可惜医无缓，救死宁堪鬼在盲。\n郡县诛求应到骨，乾坤战伐遍成疮。\n辽东华表云间鹤，相见相思总断肠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8686,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"早春遣怀","author":"刘基","text":"正月馀寒未放春，漫空飞雪舞随人。\n新年对客情何限，浊酒于予意独亲。\n涧底流泉浑似玉，门前细草总成茵。\n鹤归自爱山能静，豹隐方知雾有神。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8687,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻猿有感","author":"刘基","text":"猿响秋山夜句阑，白云如雪拥林端。\n钟仪楚奏难成调，蔡琰胡笳欲罢弹。\n泽魁离骚馀怨恨，巴东涕泪想汎澜。\n唯应华表归来鹤，明月清风共岁寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8688,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感兴","author":"刘基","text":"百年强半巳无能，愁入膏盲病自增。\n千里江山双白鬓，五更风雨一青灯。\n繁弦急管谁家宅，废圃荒窑昔代陵。\n不寐坐听鸡唱尽，素光穿牖日华升。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8689,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜坐","author":"刘基","text":"残釭背壁翳还明，坐拥衾裯阅五更。\n云捲星河垂永夜，霜飞鼓角静严城。\n飘摇莫计馀生事，老病都非旧日情。\n想像故园凭梦到，愁来转使梦难成。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8690,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"蒋山寺十月桃花","author":"刘基","text":"王母桃花此地栽，风霜摇落为谁开。\n琳宫玉座同黄土，绛蕊丹跗自绿苔。\n度朔烟霞违梦想，武陵云水怨归来。\n残蜂剩蝶相逢浅，黄菊芙蓉莫浪猜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8691,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寒夜","author":"刘基","text":"月上前山夜寂寥，江城鼓角殷寒宵。\n鱼龙水落沧溟静，鸿雁声来紫塞遥。\n风物自应随律转，霜髯争得见春消。\n青釭冷暗愁眠怯，楼外频移北斗杓。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8692,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫成","author":"刘基","text":"愁将短发逢摇落，漫把残灯照寂寥。\n两地身心悲夜鹊，五更钟鼓梦春潮。\n惊寒柏叶垂垂静，向日霜华泫泫消。\n怅望烟尘满长路，紫芝空长故山苗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8693,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题墨竹","author":"刘基","text":"苍梧山下无穷竹，尽是湘妃泪种成。\n烟雨不销千古恨，佩环虚度九秋声。\n见愁牧竖乘时伐，可待伶伦学凤鸣。\n独立凄凉对图画，为君惆怅一沾缨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8694,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"冬至","author":"刘基","text":"冬至微阳斡化机，闭关独坐正相宜。\n白杨风扫经霜叶，翠柏冰凝泣露枝。\n日转天南林影觉，春生地底水泉知。\n物华过眼成今古，愁绝看云有所思。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8695,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"黄州团湖董氏镜心楼","author":"刘基","text":"团湖四面开明镜，中有高楼接泰清。\n绛气往来蟾影入，碧光浮动日华生。\n云间灭凤孤飞下，空里游鱼作队行。\n安得翠軿呼弄玉，金银台上卧吹笙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8696,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄黄仲美","author":"刘基","text":"二十年前别故人，乾坤何处不风尘。\n玉缸阻对檐花夕，素发羞同野草春。\n紫极星辰空有象，青冥波浪杳无津。\n欢华过眼成今昔，苦忆元方泪满巾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8697,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟中","author":"刘基","text":"雨翳青灯静客舟，轻寒只恋敞貂裘。\n漫山薄雾穿窗温，漱石鸣泉拍枕流。\n身在壶中天万里，梦惊华表鹤千秋。\n愁来滴泪都成血，直到沧溟水尽头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8698,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"至婺州闻官军自温处之江东所过皆空遂从间道还乡","author":"刘基","text":"闻道人家总避军，我亦独穿豺虎群。\n莫思身外路多棘，且喜雨晴山出云。\n林端石磴鹘自占，涧底风松猿共闻。\n他年想象或梦到，两鬓白雪应纷纷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8699,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"遣兴","author":"刘基","text":"白露如珠滴素秋，啼螀络纬寂然收。\n烟开碧水浮天远，月带银河入海流。\n艳艳霜林张绮缬，琤琤风叶落鸣球。\n此时旅客篝灯坐，无柰黄昏一饷愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8700,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感兴七首 其一","author":"刘基","text":"昭代仁声浃九夷，野无矛戟有镃基。\n谁言潢海操兵寡，却产宫庭制礼时。\n广路駪駪周四牡，阴风肃肃汉灵旗。\n吊民伐罪元戎事，旴食宵衣上圣思。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8701,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感兴七首 其三","author":"刘基","text":"衣冠共喜际雍熙，岂意豺狼负盛时。\n礼乐百年忘战久，风云八阵得才迟。\n神谋不是闾阎识，庙算谁闻黼扆思。\n惭愧鲰生懒无用，江湖愁望鬓成丝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8702,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寒夜忽然有怀周紫岩先生遂成口号奉寄且以酬黄柑之惠","author":"刘基","text":"柱下先生住紫岩，倚天愁岭气巉巉。\n客来每托青猿报，书寄还凭白凤衔。\n日上寒光生水石，月明晴翠落松杉。\n旅人珍重黄柑赠，愧乏琼瑶荅素缄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8703,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夏日杂兴七首 其一","author":"刘基","text":"眼见青苔上短垣，忽看碧草翳衡门。\n西来急雨寒声壮，东望挟乘晓气昏。\n征戍诛求三载外，诗书礼乐几家存。\n天涯地角风尘满，极目云霄漫断魂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8704,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夏日杂兴七首 其二","author":"刘基","text":"爱此南园僻有馀，依稀景物似郊居。\n风轩自舞苍筤竹，莲沼双游赤鲤鱼。\n酿酒剩收元亮秫，换鹅时写右军书。\n人生纵意惟疏懒，莫遣门多长者车。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8705,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夏日杂兴七首 其三","author":"刘基","text":"门道中原沸似糜，倚楹长啸不胜悲。\n百年城郭连烽火，千里乘麻委蒺藜。\n南国久纡方叔旆，东郊未返鲁侯旗。\n五湖何处堪垂钓，肠断松楸入梦思。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8706,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题江村风雨图","author":"刘基","text":"日落千山风雨来，野昏林赤鸟飞回。\n风吹烟雾连天起，雨送雷霆入地回。\n龙母鲛绡云半湿，巫娥贝阙夜深开。\n暮寒燕子归华屋，愁绝馀花委碧苔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8707,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和岳季坚见寄","author":"刘基","text":"尘埃不见望诸君，江海谁怜郑广文。\n雪里一筇穿虎出，竹间半榻与僧分。\n无人问字朝眠稳，有客论诗夜坐勤。\n豹褒羊裘等黄土，金章紫绶漫浮云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8708,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"灵峰寺松风阁","author":"刘基","text":"露峰寺阁倚松风，风细松高阁更空。\n何处流泉生石上，有人鸣玉下云中。\n花飘雾露春香满，影动龙蛇晓日融。\n安得身如列禦寇，翩翩高举出冥鸿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8709,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和谦上人秋兴七首 其三","author":"刘基","text":"霜飞大野气凄清，日落荒村少客行。\n投笔班超空食肉，登楼王粲独伤情。\n海壖雨翳旌旗影，淮甸云埋鼓角声。\n中夜起瞻天北极，鬓毛萧飒忆神京。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8710,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"法华山弘上人","author":"刘基","text":"可爱寒潭似镜清，清光寒气袭轩楹。\n草根流水泠泠出，石上潜鱼个个横。\n翠蔼惊风和露滴，白沙得雨照人明。\n故乡近报犹豺虎，愁对沧浪咏濯缨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8711,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自天衣还城赠伯言","author":"刘基","text":"城上馀寒晓气凝，湖边春树绿层层。\n一山独表秦王望，众水皆朝夏后陵。\n白眼嗣宗终嗜酒，青鞋子美谩寻僧。\n仙都石室烟霞里，早晚相携策瘦藤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8712,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为黄元徽题画松","author":"刘基","text":"黄子宅边松十寻，两株相倚自成林。\n半空鸾凤翻清影，长日笙竽奏好音。\n岂但茯苓能却老，更有琥珀可安心。\n风尘澒洞还相忆，写挂高轩恨最深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8713,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]