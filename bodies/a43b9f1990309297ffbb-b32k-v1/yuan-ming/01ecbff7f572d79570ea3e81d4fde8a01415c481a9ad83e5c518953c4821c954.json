[{"title":"答玑上人","author":"朱希晦","text":"岩扉昼静白云生，一枕松涛入梦清。\n华发故应知老态，淡交还复见真情。\n参玄已悟三乘法，汗简何须万古名。\n我住荡南君荡北，平生怀抱几时倾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12802,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"简彦明赵徵君","author":"朱希晦","text":"羲和鞭日竹苍冥，百年世事如云萍。\n自怜老去鬓俱改，谁道春来愁不醒。\n野岸风微柳花白，江津水暖蒲芽青。\n鲙雪红肥社醅熟，几时一到河山亭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12803,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次适庵李先生韵","author":"朱希晦","text":"悠悠身世更何如，布褐由来胜锦裾。\n今日岐阳无凤鸟，秋风笠泽有鲈鱼。\n功名底用传身后，道业还应继绪馀。\n更好买田深筑室，相期黄发老岩居。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12804,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春晚感怀寄李广文","author":"朱希晦","text":"玄发经年半已斑，避喧何计入深山。\n我无大药能医老，谁有真金肯买閒。\n三月花开反惹恨，几时酒醒一开颜。\n别来若有新诗句，好倩邮筒日往还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12805,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"酬申屠翰林","author":"朱希晦","text":"人中至宝识璠玙，词气飘飘遇子虚。\n五夜南宫曾赐被，十年东观饱看书。\n宾筵秩秩尊三老，祖帐纷纷饥二疏。\n吴越溪山信清美，杖藜随处胜安车。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12806,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日","author":"朱希晦","text":"秋晚林皋木叶飞，凉风袅袅雁南归。\n自惭席上著乌帽，不见门前来白衣。\n瓮满香云醅酒熟，盘飞红雪鲙鲈肥。\n兴来随处堪行乐，何必佩萸登翠微。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12807,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"呈丹霞老禅","author":"朱希晦","text":"一蓑风雨一渔竿，家近梅花涉水滩。\n投报已无青玉案，驻颜宁有紫金丹。\n庞公老去独耕岘，李愿从来久隐盘。\n自古山林有遗逸，敢将名字动天官。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12808,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵谢东白叶先生","author":"朱希晦","text":"三径归来细竹斑，山人本性爱丘山。\n紫扉半掩红尘满，诗句长哦白日閒。\n豪气固应嗤梓泽，幽栖不独羡商颜。\n旧传却老方应验，我欲相从问大还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12809,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"述怀寄刘休休居士","author":"朱希晦","text":"云绕青山水绕溪，隐居滋味只羹藜。\n春风底事生华发，暮景何须待紫泥。\n写罢素书无雁过，唤回清梦有猿啼。\n长安市上多年少，赐锦纷纷竞斗鸡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12810,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"营寿圹","author":"朱希晦","text":"在世徒怀身外忧，汉家陵墓已荒丘。\n乌鸢夺食终难忍，龙虎图形莫浪求。\n千载空遗两翁仲，百年同是一浮沤。\n何如早约柴桑老，结社得随惠远游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12811,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"依韵奉谢原礼先生","author":"朱希晦","text":"枕溪住处溪水深，竹树云屯青满林。\n摩诘诗为有声画，渊明趣在无弦琴。\n鹓鸾冲霄五彩翮，骐驎伏枥千里心。\n雄篇赠我细把玩，光价岂止双南金。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12812,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次潘北山郑叔允韵","author":"朱希晦","text":"閒来兴趣倍清新，自爱青山作主宾。\n天上几时停白日，世间何处避红尘。\n莺花满目娱佳景，鸡黍同盟忆故人。\n笑我年衰才较拙，敢将一曲和阳春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12813,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄天宁方丈","author":"朱希晦","text":"霜树萧萧万叶丹，谁怜倦客尚江干。\n性情每向诗中写，勋业何须镜里看。\n万里江山秋月老，一天星斗夜光寒。\n近来满目多荆棘，始信人间行路艰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12814,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"简士举陈教谕","author":"朱希晦","text":"忆昨天南独倚楼，德星烱烱夜悠悠。\n贾生名重醇儒列，韩愈才高博士流。\n老去囊中无长物，由来皮里有春秋。\n他年禁直皇居近，天禄书多待校雠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12815,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"呈浦云赵修撰","author":"朱希晦","text":"忆昔承恩入禁闱，儒林便觉有光辉。\n九重旭日开金殿，五色春云照锦衣。\n庠序人思三老去，都门祖饯二疏归。\n归耕幸喜身康健，雨足东皋陇麦肥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12816,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"刘休休病起","author":"朱希晦","text":"买得南山为卜居，青松绿竹荫吾庐。\n日长门外堪罗雀，水满溪头好钓鱼。\n脱粟饱时过禁脔，杖藜行处当安车。\n家僮忽报长须至，喜接平安一纸书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12817,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寓兴","author":"朱希晦","text":"白发园丁喜种园，谩将方法教儿孙。\n土膏有力须培本，镰铁无情莫刈根。\n葵藿不堪资鼎食，韭菘粗足媚盘餐。\n吞腥啄腐今何限，谁识芳鲜味独完。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12818,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄适庵李先生","author":"朱希晦","text":"九衢辙迹黄尘满，一隙驹阴白日过。\n俗事绊人清兴少，山尊留客好怀多。\n悬知李白偏能赋，却羡秦青最善歌。\n自古荣名身外事，耕云只合老岩阿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12819,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"书怀呈同志","author":"朱希晦","text":"今古浮荣不足论，一生旅寓任乾坤。\n轮囷谩长千年木，濩落还成五石樽。\n谁复挂冠辞汉阙，客多鼓瑟向齐门。\n野人自信无机事，年老何妨且灌园。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12820,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"用韵简叔向陈先生","author":"朱希晦","text":"门前车马纷如蚁，草径幽深肯暂过。\n老去冯唐饶发白，归来季子得金多。\n春江水阔鱼初上，晓树烟开鸟欲歌。\n赖有故人相慰籍，杖藜数数到岩阿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12821,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄李适庵陈叔向二先生","author":"朱希晦","text":"中年作恶不胜情，无复芳尊酒共倾。\n老我韶华如逝水，多君诗律似长城。\n江东千里暮云合，池上几回春草生。\n想见凭阑亦清绝，阴阴绿树有啼莺。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12822,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽居漫兴","author":"朱希晦","text":"地绝尘喧境自宽，溪南山色坐中看。\n竹吹绿雾沾书帙，花发红云映药栏。\n常养泰和知气壮，不求徵禄得心安。\n自从一笑忘鱼后，年老何曾把钓竿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12823,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"憎鹃","author":"朱希晦","text":"吾闻反哺乌，至孝有纯德。\n鸟中比曾参，传诵人皆识。\n又闻驯化雉，翔集在咫尺。\n陌上随行车，饮啄自朝夕。\n嗟尔蜀幸帝，愚暗亡其国。\n游魂化为鹃，物理固莫测。\n一身尚羁旅，羽毛亦虚饰。\n生雏百鸟巢，蝼蚁竟饱食。\n春风口流血，有恨啼不息。\n侯门拂笙竽，豪客纷弹射。\n岂不思南归，奋飞摧短翼。\n何如雉与乌，飞鸣随所适。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12824,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和渊上人爱松吟","author":"朱希晦","text":"众木与时谢，孤松自寒色。\n深根远莫移，老干益堪惜。\n溪南有馀地，尘外颇幽寂。\n手种一万枝，心期二千尺。\n风云歘交会，雨露浸生息。\n他日此盘桓，清阴覆泉石。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12825,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"比述 其一","author":"朱希晦","text":"轩辕初铸鼎，鼎成乃登仙。\n龙髯不可攀，白日飞上天。\n嗟予堕世网，安得穷山川。\n鼎湖渺何许，怅望秋风前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12826,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"比述 其四","author":"朱希晦","text":"东南有美箭，出自稽山竹。\n初发号哀猿，再发落飞鹄。\n忆射聊城书，功成一何速。\n贤哉鲁连子，千古仰高躅。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12827,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自述 其一","author":"朱希晦","text":"老鹤复老鹤，笼中稀饮啄。\n岂无万里心，高飞向寥廓。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12828,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自述 其二","author":"朱希晦","text":"君看堂上燕，差池自双飞。\n一朝秋风起，巢空何处归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12829,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自述 其三","author":"朱希晦","text":"驱车出城东，禾黍生故宫。\n君看两铜驼，卧此荆棘中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12830,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自述 其四","author":"朱希晦","text":"驱车经北邙，悲歌泪如水。\n君看冢累累，埋没蓬蒿里。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12831,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"所思 其一","author":"朱希晦","text":"鹦鹉本聪慧，不与凡鸟同。\n因以巧言语，何由脱樊笼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12832,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"所思 其二","author":"朱希晦","text":"百舌复百舌，间关弄春晴。\n谗臣在君侧，巧语谁为听。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12833,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"所思 其三","author":"朱希晦","text":"门前好杨柳，春风摇绿丝。\n花飞乱白雪，青春能几时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12834,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂咏 其一","author":"朱希晦","text":"户枢动不朽，源水流不浊。\n修身保天和，味道得真乐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12835,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂咏 其二","author":"朱希晦","text":"北叟塞上马，秦人宫中鹿。\n语默知是非，得失见祸福。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12836,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂咏 其三","author":"朱希晦","text":"嗟彼横江鲸，一朝著钓饵。\n何如五总龟，曳尾泥涂里。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12837,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"上陈员外","author":"朱希晦","text":"荆山郁嵯峨，屹立高摩空。\n光辉韫奇璞，瑞气成白虹。\n草木借馀润，飞雨青濛濛。\n悬知有至宝，追琢烦良工。\n连城未易酬，美价璠玙同。\n行将献天子，持入光明宫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12838,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和谢一源上人","author":"朱希晦","text":"道人来蜃江，移席秋夜深。\n天高明月出，清辉浴波心。\n道人来雁荡，悬锡青松岑。\n瀑布落晴雪，烟霏生夕阴。\n谢公去已远，遗迹谁能寻。\n讵那宴坐处，千古开禅林。\n莲宫耸突兀，布地皆黄金。\n何时一洗耳，试听颖师琴。\n平生屐几两，亦有山水淫。\n悬知群鸟中，有此孤凤音。\n行当谢世事，与子同浮沉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12839,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和简叔向陈先生仲谦倪公","author":"朱希晦","text":"我家雁荡南，啸傲云松下。\n平生伯牙弦，不恨知音寡。\n晚交倪与陈，荏苒几寒夏。\n骐驎日千里，鼓车岂合驾。\n缅思昌黎公，低头拜东野。\n文润三峡流，毫端恣挥洒。\n奋飞既胡越，有怀不可写。\n新诗来启予，沧江珠盈把。\n于时月露清，竹叶滟金斝。\n遗音锵钧韶，古意薄风雅。\n遥瞻德星聚，烱烱光照夜。\n汉廷方渴贤，平步登金马。\n譬如磥砢材，匠石岂云舍。\n宁为汲黯戆，无效齐王假。\n披肝见精诚，结舌类喑哑。\n古来英雄人，起自耕隐者。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12840,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次本之侯先生","author":"朱希晦","text":"忆昔抱长剑，去作东南游。\n缑山高刺天，翠绕藏书楼。\n修竹净三径，往来惟羊裘。\n苍龙未变化，紫凤曾栖不。\n上揽明月辉，下盼沧江流。\n酒酣发长啸，万籁生清秋。\n别来难再晤，奈此人事稠。\n每怀招隐处，桂老山更幽。\n隐士不可招，援桂聊淹留。\n赋诗且自乐，斗禄乌足谋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12841,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"除夕","author":"朱希晦","text":"麒麟在灵圃，瑞世为祯祥。\n五蹄而一角，形类非犬羊。\n西狩不得时，折足遭锄商。\n宣尼空悲叹，涕泪沾襟裳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12842,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"叹世","author":"朱希晦","text":"乾坤一开辟，日月常往来。\n朱颜不再好，白发专相催。\n旷视藐万古，荣名安在哉。\n遁世有馀乐，何必求蓬莱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12843,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答东白叶徵士","author":"朱希晦","text":"至宝惟人材，所宝非全璧。\n缅怀古圣贤，頫仰流汗赤。\n龙媒日千里，远道如所适。\n一鸣万马瘖，见之皆辟易。\n伯乐虽相知，不辨骊黄色。\n斯人去我久，千载犹旦夕。\n伟哉东白翁，平生数亲炙。\n南望吹箫台，矫首空叹息。\n何时一相见，斗酒浇胸臆。\n醉酒且勿言，中心期饱德。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12844,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"写怀 其一","author":"朱希晦","text":"人生有定分，胡为乱天常。\n尺土乃培塿，散樗非栋梁。\n观鱼慕庄子，御马思王良。\n丈夫贵知己，郁郁徒自伤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12845,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"写怀 其二","author":"朱希晦","text":"野老何愚庸，团形从大块。\n林居玩清景，悠然与心会。\n佳菊没榛丛，幽兰伍萧艾。\n岁晚冰霰交，见之徒感慨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12846,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂咏","author":"朱希晦","text":"威凤备五彩，羽毛一何奇。\n歘乘长风起，误落天南陲。\n朝食琅玕实，暮栖琼树枝。\n行当凌八极，斥鴳焉敢窥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12847,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自况拟古 其一","author":"朱希晦","text":"风波在平地，世路几瞿塘。\n怀哉贤哲人，千载能留芳。\n悬知萧艾多，不比猗兰香。\n老翁聊自笑，发短心甚长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12848,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自况拟古 其二","author":"朱希晦","text":"羲和鞭六龙，白日不我待。\n读书竟无成，坐惜朱颜改。\n长安誇斗鸡，豪华岂长在。\n何由得成仙，高飞向蓬海。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12849,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自况拟古 其三","author":"朱希晦","text":"人生天地间，倏若尘栖草。\n恨无大药资，容颜岂长好。\n白璧终销毁，青松亦枯槁。\n饮酒且放怀，毋为叹衰老。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12850,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自况拟古 其四","author":"朱希晦","text":"隐士居丘园，衡门守荒寂。\n啜菽甘有馀，饮水清无极。\n嗤彼夸毗儿，浮荣定何益。\n梓泽今已空，春风蔓茨棘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12851,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自述 其一","author":"朱希晦","text":"吾闻汉中郎，琴斲焦桐尾。\n縆以朱丝绳，遗音中宫徵。\n上弦操白雪，下弦弹绿水。\n世无赏音人，谁能一倾耳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12852,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自述 其二","author":"朱希晦","text":"狂世等浮云，变态何纷纷。\n龙媒行万里，耻与驽骀群。\n自从周道废，雅颂不复陈。\n愿言继先哲，千载垂清芬。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12853,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自述 其三","author":"朱希晦","text":"群书日夜读，往往皆陈编。\n何如穷物理，朗悟心中天。\n坐来万想灭，灵府何翛然。\n所思在良友，使我长悁悁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12854,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山居自况","author":"朱希晦","text":"嗟予任疏懒，落落负明时。\n玄发倏已改，素心终不移。\n焚香读周易，觞酒调朱丝。\n所乐在冲澹，浮名良可嗤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12855,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"齿疾","author":"朱希晦","text":"我今老将至，辅车邀病魔。\n一语不出口，终朝卧林阿。\n退之念脱落，幼舆能啸歌。\n蔬食滋味少，咽漱津液多。\n眼明幸读书，流年任蹉跎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12856,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答汪谦之先生","author":"朱希晦","text":"江城满楼台，月夜吹笙箫。\n神仙集华盖，鸾鹄来丹霄。\n中有羽衣客，举手欣相招。\n扶桑朝出日，溟海秋翻涛。\n一身藐八极，御气时游遨。\n悠然视天宇，万古同泬寥。\n却思卧玄圃，天鸡弄嘐嘐。\n饥餐金光草，渴饮玉卮醪。\n何当乘清风，蹑鲤随琴高。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12857,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自述寄友","author":"朱希晦","text":"十月天雨霜，木叶半凋悴。\n巨海增波澜，群峰献苍翠。\n身居一窝中，意出万象外。\n喜闻古人言，颇胜俗客对。\n设席罗酒浆，未饮已心醉。\n曜灵急西驰，盛年岂能再。\n送子才出门，天风舞兰佩。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12858,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"义鹘行","author":"朱希晦","text":"林深结暝色，苍翠摇烟霏。\n维时春夏交，众鸟巢高枝。\n于中有双鹳，卵育常及时。\n舂锄亦有托，旦夕欣相依。\n雄飞远求食，雌来哺其儿。\n啁啾聒人耳，坐厌腥风吹。\n群雏半黄口，翅短争习飞。\n间或遭弹射，滋味焉足奇。\n弱者强之食，感慨徒伤悲。\n海鹰何从来，鸷猛一何酷。\n骞腾复盘旋，意欲喂饥腹。\n老拳不空施，利嘴贪食肉。\n鹳兮善护巢，飞鸣急驱逐。\n鹰兮虽善扬，饕馋岂知足。\n鸟雏赖生全，脱祸免茶毒。\n扶弱在抑强，足以厉风俗。\n岂不见兄弟怒阋墙，夫妻雠反目。\n恤怜当救灾，敦姻须睦族。\n禽鸟尚急义，人情何反覆。\n吾言非箴规，履行宜自勖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12859,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"卧云卷为陈去题","author":"朱希晦","text":"吾闻神仙人，中有希夷子。\n冥栖华山颠，高卧白云里。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12860,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和友人韵","author":"朱希晦","text":"孤桐生高冈，幽兰出深谷。\n雨露含碧滋，烟霞媚幽独。\n佩惟楚客纫，琴待良工斲。\n嗟彼春风前，纷纷艳花木。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12861,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和彦远叶先生韵","author":"朱希晦","text":"姬周得天下，乱臣才十辈。\n王纲一解纽，政教何茫昧。\n宣尼抱麟泣，此意谁能会。\n从来六籍灰，文风委蒿艾。\n穷兵尚专征，岂识包桑计。\n故国悲黍离，日落寒云翳。\n吾闻昔盛时，蓂荚生尧砌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12862,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]