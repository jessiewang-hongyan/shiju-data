[{"title":"寄邹自春","author":"郭钰","text":"楼间美酒满银壶，楼外好山开画图。\n上学郎君书早读，丁宁汲水灌菖蒲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6892,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闰十一月朔日山路见梅","author":"郭钰","text":"蓓蕾微传春信真，几回梦想玉精神。\n不知月落参横处，犹有孤眠惆怅人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6893,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"乙巳年余避地彭老家还再过之倏尔十年而人改物换可感者多矣因赋","author":"郭钰","text":"旧题尘暗小楼间，花鸟庭空白日閒。\n鸟自不鸣花自落，客愁何得不相关。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6894,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠别","author":"郭钰","text":"醉挽征衫折柳枝，柳花飞处不胜悲。\n东风过后西风起，待得青条又几时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6895,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闺怨","author":"郭钰","text":"妆台尘暗锁愁眉，瘦倚东风似柳枝。\n又恐侍儿催问药，只言蚕早叶归迟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6896,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春夜饮","author":"郭钰","text":"蜡光红射酒杯霞，夜久窗虚月透纱。\n诗笔醉拈如有助，暖风吹动瑞香花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6897,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"道逢陈玉章","author":"郭钰","text":"山色川光作雨晴，花阴满地啭黄莺。\n去年酒伴今何在，邂逅陈郎笑独行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6898,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江望","author":"郭钰","text":"尽把离愁种驿亭，春风吹入草青青。\n伤心为问行舟客，东过清江停不停。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6899,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"三月初五日偶题","author":"郭钰","text":"娇鸟笼中晒绿衣，雄鸣高树不思归。\n去年寒食今年梦，曾向西楼共学飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6900,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山家少憩","author":"郭钰","text":"松下苍苔扫复生，笼中娇鸟寂无声。\n东风几度传花信，偏遇春阴不遇晴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6901,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题李次晦邹疡医诗卷","author":"郭钰","text":"飒飒秋风落叶深，辘轳寒甃带哀音。\n李侯疮癣君能疗，老我柴门独捧心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6902,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日忆萧韶","author":"郭钰","text":"云归长宿北山头，误逐东风过小楼。\n带得旧时蕉叶雨，数声敲碎客中愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6903,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日忆萧韶二首 其二","author":"郭钰","text":"飞飞燕子楚天涯，华屋春秾不似家。\n遥想日长吟思苦，独看红杏落残花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6904,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄远","author":"郭钰","text":"万点飞花风外过，红埋泥土白随波。\n閒愁散与伤春客，君在江南想独多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6905,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感事二首 其一","author":"郭钰","text":"雨过汀沙失旧痕，春寒鹦鹉闷无言。\n杨花春水成萍叶，踪迹犹难到故园。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6906,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感事二首 其二","author":"郭钰","text":"依稀旧馆绿杨舟，不见群鸥见水流。\n白发青灯孤负尽，至今犹自替人愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6907,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"上巳日与周公明经萧韶读书处","author":"郭钰","text":"四海交游老尽非，如君年少又相违。\n申明亭下烟花暝，惟有泉流送客归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6908,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日过山家题罗帕","author":"郭钰","text":"冰丝缕缕系深恩，青鸟飞来每断魂。\n留得蔷薇香易灭，只从灯下认啼痕。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6909,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题","author":"郭钰","text":"游丝风煖飐飞花，窈窕箫声隔彩霞。\n毕竟神仙难换骨，自分丹火煮胡麻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6910,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"有感寄宋五","author":"郭钰","text":"春夜情浓梦觉空，烂柯不省遇仙童。\n人间翻手恩成怨，无怪襄王忆梦中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6911,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"有感寄宋五二首 其二","author":"郭钰","text":"画楼烟暖杏花晴，罗绮春娇按玉笙。\n水调未成翻越调，枉劳书信问莺莺。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6912,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和萧伯章春夜倚楼","author":"郭钰","text":"云度松梢月半阴，悬崖倒挂白猿吟。\n倚楼数遍伤心事，风雨故园春草深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6913,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄欧阳文周","author":"郭钰","text":"芳草春烟锁故庐，泊舟南浦近何如。\n客囊共诉黄金尽，欲问平安但寄书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6914,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题石壁","author":"郭钰","text":"石壁题诗剜翠苔，感时伤别壮心摧。\n沈园记得前生到，酒散花阴月满台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6915,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题掀蓬图","author":"郭钰","text":"疏蕊淡笼斜月，横梢低照寒流。\n清意是谁领略，除非访戴王猷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6916,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"候吴植立不至","author":"郭钰","text":"捲帘春睡初足，上马午阴半斜。\n人别断烟疏柳，鸟啼残雨落花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6917,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"摸鱼儿 和彭中和双头菊","author":"郭钰","text":"压秋香、并肩如舞。\n情缘天似相许。\n结根自是孤高者，何乃含娇凝伫。\n似秦女。\n乘鸾仙袂凌风举。\n精神清楚。\n便带绾重金，环连叠胜，心事自相语。\n情深处。\n此事人间最苦。\n多少蝶来蜂去。\n蘋婆茎命同生死，尚恐翻云覆雨。\n休折与。\n算太液、芙蓉不到人间睹。\n伤今怀古。\n想墙里笑声，池西流水，红叶漫题句。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6918,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题平山堂次黄先生韵","author":"赵汸","text":"虚堂眄平冈，积翠淩天半。\n彷像识瑶台，熹微窥玉案。\n颇疑巨灵力，刬削非一旦。\n森森古树齐，奕奕朝霞烂。\n地近巘易陟，池清莲不蔓。\n莺啼午梦残，客至琴声断。\n胜境契中襟，雅怀知弗畔。\n翛然忘物我，讵肯存崖岸。\n马迹遍幽燕，华颠乐村闬。\n居夷非矫曲，悼猛得前算。\n巇崄世所趋，真淳日彫散。\n跬步视安危，片言几理乱。\n苟能领斯会，未觉身为患。\n嘉谋谅贻厥，岂曰誇殊观。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6919,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送汪子翼赴采石书院山长","author":"赵汸","text":"汪子富儒术，雄文惊有司。\n横经得专席，往主圣哲祠。\n昨者遇相别，清言不及私。\n惟念紫阳翁，周程以为师。\n云何陆子静，所学乃异兹。\n后生将焉从，此事宜精思。\n斯行凭在尔，宁复计班资。\n嗟余素寡陋，求道多困岐。\n离索亦云久，陆沈乃其宜。\n一闻君子论，反躬愧湮微。\n神心异象罔，谁能握其机。\n关洛有遗言，本根实在兹。\n及门多通明，经说乃见讥。\n朱子晚所造，卓绝知者希。\n象山如可作，岂复忧支离。\n使其或有异，在我已无疑。\n前修去已远，问辩将畴依。\n子有千里行，谁能纠予非。\n采石古重镇，精庐俯危矶。\n子登蛾眉亭，勿作雍门悲。\n应怀谪仙人，宫锦何淋漓。\n横绝宇宙间，飞黄不受鞿。\n君子慎修已，深潜厚自持。\n斯人固天放，跌宕将安归。\n适道必有途，积德必有基。\n所贵敦实行，无为尚虚辞。\n俗学昧本原，希微罕真知。\n侏儒笑俳优，长者岂吾欺。\n念子实命我，斯言非我宜。\n敬恭奉明德，白首以为期。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6920,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"吕景武哀诗（并序）","author":"赵汸","text":"山东有壮士，胄出古诸姜。\n起从楼船师，军败耻生降。\n挟俘投海死，终不愧鹰扬。\n有孙若郡校，刻意攻文章。\n师亡于我殡，丧具倒赀囊。\n大兄绾银符，慷慨百夫良。\n忍死脱锋镝，明神翼高堂。\n佐郡黟山下，慈母未敢将。\n甘旨弟所营，时亦来兄傍。\n一疾竟不起，呼天但茫茫。\n何以慰母怀，相看涕淋浪。\n世乱获考终，安知短与长。\n郊原多白骨，岂解归山冈。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6921,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"银峰述德诗（并序）","author":"赵汸","text":"戎马生淮甸，烟尘暗江湖。\n银峰万家邑，转目成丘墟。\n番君祠既燬，张相墓应芜。\n千年豪杰堀，但见豺与狐。\n四邻更问罪，毒螫焉能祛。\n牺牲待境上，玉帛既与俱。\n谁将庇吾民，跂踵待来苏。\n两属固非策，瓜分岂良图。\n干戈日相寻，山谷皆储胥。\n甘心仇彼壤，斩刈互相踰。\n衅同虞芮争，祸岂蛮触殊。\n相倾各恃援，肯复哀无辜。\n福星临婺渚，千骑专城居。\n威行征伐外，泽被凋瘵馀。\n招携自有道，不亟亦不徐。\n运步理必复，寒谷春阳嘘。\n湓浦覆巢穴，宫亭偃根株。\n永谢西江水，还同涸辙鱼。\n含垢廓洪度，推诚开戆愚。\n汝才吾与达，勉思致名誉。\n汝武吾爪牙，所当应时需。\n难若春冰释，冤似水涤除。\n父子再天日，妻孥欢室庐。\n向来锋镝地，画作瓜芋区。\n始羡生人乐，力耕供赋需。\n譬如涉渊水，公作济川桴。\n又如沟中瘠，忍死待公哺。\n况非遇公贤，此邑今何如。\n我欲留公像，英姿照里闾。\n穹碑铭伟绩，螭首而龟趺。\n所示只一乡，所传唯道途。\n作诗颂公德，纪实辞不诬。\n子孙又子孙，歌咏无时渝。\n方伯及连帅，视公为规模。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6922,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题黟令周君儒所藏清溪白云图","author":"赵汸","text":"结屋清溪上，白云与为邻。\n云影常在地，溪光净无尘。\n馀晖及山木，晻映忘冬春。\n逍遥窗户间，亦足娱心神。\n相望彭泽宰，仕止孰由人。\n忽忆桃花源，悠然思问津。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6923,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"悼子琯","author":"赵汸","text":"无子未尝忧，有子悲不育。\n妙赞世所稀，我穷焉得鞠。\n所嗟百日间，奔走无停躅。\n贺者犹在门，房中已闻哭。\n汝病吾不知，汝名人已录。\n我无高飞翼，安用烦羁束。\n奉身如拱璧，世乱遭指目。\n祸福来无端，每虞连骨肉。\n殇子古称寿，彼苍非汝毒。\n勿羡彭与?，贪生恒局促。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6924,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题米元晖江山小景","author":"赵汸","text":"沧波浩无津，挥手扬帆去。\n回顾江上山，苍苍但烟树。\n结茅傍洲渚，岂少垂纶处。\n终然尘迹近，未及扁舟趣。\n世运如风飙，朝新夕成故。\n白云何亭亭，倏尔天际住。\n寄谢山中人，奚为独多虑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6925,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"病士","author":"赵汸","text":"病鹰不忘击，病骥不忘骧。\n病鹤俛不啄，仰睇霄汉长。\n惟有病士心，死灰不复飏。\n居处终鲜欢，起行若痛亡。\n逢人目辄动，内惕外周章。\n口虽强诺唯，退省但茫茫。\n已疾且忘疗，焉知民未康。\n多谢游谈者，勉旃思自强。\n是弃果蓏哉，为称充圆方。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6926,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"峡源瀑布","author":"赵汸","text":"寒峡隐堂隍，寻源得飞瀑。\n悬空下千尺，飞鸟惊不度。\n雷激丹岳摧，电穿青山破。\n阴崖排积雪，霈雨恒时注。\n我来属时艰，对此忘百虑。\n尘襟欣一洗，徘徊不忍去。\n崇山限吴楚，避远谁能顾。\n应有避秦人，岩前觅微路。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6927,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题云林小隐","author":"赵汸","text":"杉松冥冥烟雾湿，青合两崖愁壁立。\n方池怪石小窗妍，家具图书劣容膝。\n十年官道暗黄尘，锦里萧条少四邻。\n峻岭截云天禦暴，樵歌一曲断行人。\n古林先生身种德，芝田兰畹无荆棘。\n心閒鸡犬亦清宁，虎伥狐妖俱屏迹。\n木叶归根虫闭关，雪深半夜失前山。\n儿童挟策莫言冷，信有阳和地底还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6928,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浮邱祠","author":"赵汸","text":"浮邱说诗秦汉间，庞眉鹤发映朱颜。\n适逢偶语几弃市，又见慢儒来溺冠。\n飘然长往不知处，遗迹宛在轩辕山。\n年谷常丰物无厉，石泉一盏荐甘寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6929,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"中秋雨分韵得秋字","author":"赵汸","text":"蓬莱别馆天香浮，仙家好景惟中秋。\n举杯邀月不知处，湿云满地寒螀愁。\n大地山河忽破碎，苍茫微影将焉求。\n盲风怪雨岂终夕，中轩坐见寒光流。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6930,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"故人","author":"赵汸","text":"故人别我秋江涘，几载重逢春梦里。\n忽观明月忆高情，愁绝长空三万里。\n荒山久病莫能兴，狂风暴雨何凭淩。\n麈鹿呦呦呼厥类，雉媒戛戛求其朋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6931,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"余村道中寄鲁斋","author":"赵汸","text":"青山并岸如苍虬，石门翠树如相樛。\n似与幽人护清境，玉梅翠竹萦寒流。\n溪行半日足生茧，水望千回山百转。\n请君处处种桃花，莫使重来迷近远。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6932,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读阮嗣宗诗","author":"赵汸","text":"明月照北林，孤鸿有哀音。\n揽衣起坐弹鸣琴，忧思徘徊独伤心。\n可怜堂上生荆杞，空自繁华粲桃李。\n种瓜寂寞青门外，采薇怅望西山址。\n芒砀云归大泽空，后五百岁无英雄。\n途穷恸哭谁知者，沈湎狂言元自公。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6933,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古津渡夜谈赠金元忠","author":"赵汸","text":"相逢岁晚诗更诵，燔尽枯槎谈愈纵。\n短茨低覆结冰花，寒压溪云不成梦。\n竹帛烟销黔首愚，紫芝一曲老商于。\n坑外竟逃真学士，浮邱雅颂济南书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6934,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄题郑天骏云山楼","author":"赵汸","text":"广文之孙材且武，身隐关梁谢行伍。\n作楼江浒号云山，坐睨江云谁敢侮。\n江中舟楫日经过，道上车马何其多。\n官纲私载一时集，主人迎客忘讥诃。\n掩藏白骨芟林莽，招辑流亡俱安堵。\n主人展席客长哦，但云信美休怀土。\n惜君不生宣和间，坐销鼠孽应无难。\n至今闻说方家洞，能令壮士发冲冠。\n请君试上萧王墓，青史无名谁守护。\n箫鼓丛祠春复秋，男儿何必生封侯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6935,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送皮典史归泉溪旧隐","author":"赵汸","text":"皮尹昔辞上高秩，隐居欲拟陶彭泽。\n石潭空洞九峰奇，潭底行云映朝日。\n云去山空今几秋，随风万里何悠悠。\n一朝飘落还故处，云本无心风亦休。\n芙蓉峰下西江路，父老送行君弗顾。\n著书况有鹿门期，回首人间但烟雾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6936,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题碧山图","author":"赵汸","text":"尝爱李太白，兴来栖碧山。\n山中别有一天地，惜无图画留人间。\n谁为碧澄翁，久向山中住。\n栽花种柳待春风，忽见新图识其趣。\n青山淡淡云离离，小桥流水涵清漪。\n抱琴择胜可终日，安得似汝图中时。\n韩侯好诗仍好画，嗜酒不忧官长怪。\n欲图李白碧山居，酒禁方严笔如借。\n知翁有子旧曾游，淡泊无营心日休。\n图成漫与翁为寿，愿翁长乐无虞忧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6937,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠上人丕大基","author":"赵汸","text":"阴山赤光如赫曦，金人快日中天飞。\n乾坤塞破佛力大，西来只履将安归。\n百年王气真垂电，千尺法轮竿顶转。\n刘郎梵相秘难窥，辛有妖言孰先见。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6938,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"观舆图有感（五首） 其一","author":"赵汸","text":"朝雨茅茨湿，披图羡禹功。\n山河一掌上，宇宙九畴中。\n水性惟趋下，民生本易穷。\n胼胝岂无事，大智与天通。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6939,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"观舆图有感（五首） 其二","author":"赵汸","text":"四载勤难继，八年绩竟成。\n功推城濮隽，泽想召陵深。\n问鼎犹怀恶，投龟肯易心。\n向无微管叹，孰忆到于今。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6940,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"观舆图有感（五首） 其三","author":"赵汸","text":"辙已环诸夏，居身忆九夷。\n难求伐木处，尚想馈豚时。\n夹谷真成谤，中牟不易知。\n惟存删述事，赫赫起周畿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6941,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"观舆图有感（五首） 其四","author":"赵汸","text":"皓首陈王道，时君孰可匡。\n艰难思稷契，容易托齐梁。\n越岂资冠冕，秦方用虎狼。\n空闻归大老，不复见鹰扬。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6942,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"观舆图有感（五首） 其五","author":"赵汸","text":"雒邑空南渡，东都亦北辕。\n已符前五闰，空忆后三元。\n分合巧相似，今昔难等伦。\n女真如拓拔，一统位中原。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6943,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江彦明来访 其一","author":"赵汸","text":"一自逃空谷，健忘见似人。\n月来为上客，松长是高邻。\n已信贫非病，慵将懒是真。\n喜君能脱略，杖屦莫辞频。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6944,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江彦明来访 其二","author":"赵汸","text":"敲门知有客，已谓是君来。\n乱后交游少，秋清怀抱开。\n剧谈无可讳，信笔不相猜。\n木落山容净，楼居且莫回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6945,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过闵川程义士祠遗址","author":"赵汸","text":"义士名犹在，方基祠不存。\n人心俱感惠，帝泽已推恩。\n古木烟霞杂，遗编姓字尊。\n信知开府后，奕世有云孙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6946,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题张中丞祠","author":"赵汸","text":"孤城经百战，忍死复挥戈。\n节义如日月，声名等山河。\n云深遗祠古，地远乞灵多。\n往往成功者，焉能保不磨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6947,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过斗山访程明远","author":"赵汸","text":"结屋斗山下，山深人自閒。\n有时歌白石，高兴在青山。\n大道无夷越，虚名自触蛮。\n悠然得真趣，异境是仙寰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6948,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答金元忠","author":"赵汸","text":"宾馆二贤后，宗家五柳门。\n莺鸣声出谷，鹏徙翼如云。\n学博年方妙，时艰志不分。\n一身轻宇宙，匡济赖多闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6949,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"病中和伯友绝粮韵","author":"赵汸","text":"貌比年加老，忧如病转深。\n风檐惊淅沥，竹径怯阴森。\n独立筹家难，朋来阻岁祲。\n远书思过雁，危坐自沈吟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6950,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]