[{"title":"谢张别驾惠雪笺","author":"张昱","text":"承惠薛涛三百幅，甚惭何以报琼瑶？\n开缄只恐为云去，入手生愁向日消。\n难用侯门裁刺帖，祇应仙洞写云谣。\n知君解绶初归隐，丛桂辞成未敢招。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5228,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"百丈泉，为及以中长老赋","author":"张昱","text":"道人手挽银河水，泻作空山百丈馀。\n当画大声喧醉枕，长年倒影浸禅居。\n玉虹挂石看不灭，红叶乘流画却如。\n陆羽茶经知此味，可能日给到吾庐？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5229,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题天龙寺丛桂楼","author":"张昱","text":"天龙楼阁迥无邻，玉斧修成月满轮。\n受质岂无如郤者，触机还有姓黄人。\n香通三昧惟心印，花散诸天尽法身。\n谁把碧云题树叶，惠休诗句本清新。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5230,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"芳林农舍，为朱孝先赋","author":"张昱","text":"投老归休只此心，浑家农事在芳林。\n蒲生曲渚鱼苗上，蛆泛洼樽酒力深。\n应候微虫窠作瓮，啼春幽鸟语如琴。\n眼前物色皆天趣，底用城居积万金。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5231,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"务勤堂，为俊宜之赋","author":"张昱","text":"民生在勤则不匮，尔以务勤为此堂。\n百亩田苗终岁望，一春蚕事举家忙。\n课儿雪夜温书册，会客花时列酒浆。\n黄绢下机仓廪实，任从懒卧北窗凉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5232,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"灌园生，为潘时雍赋","author":"张昱","text":"却恶喧嚣远市廛，自耕荒僻浙河边。\n时非苏子投书日，鬓是潘郎作赋年。\n饭客夜舂鹦鹉粒，灌园春引桔槔泉。\n塌然鼾睡茅茨下，荣辱何因到尔前？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5233,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送赵惟一贡京师会试","author":"张昱","text":"过却龙门总是云，凡鱼回首尽离群。\n风雷忽起三层浪，毛骨都成五色文。\n萤火几怜车胤聚，桂枝独许郤诜分。\n临轩策试当条对，毋以虚文负圣君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5234,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"请复朱娥庙诗","author":"张昱","text":"上虞朱回有孝女，十岁过于烈丈夫。\n义感皇天存祖母，身轻白刃禦强徒。\n朝廷既已载宋史，民德从之厚海隅。\n事上太常须有议，肯教无庙荐潢污。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5235,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉萱堂，为陈彦廉作","author":"张昱","text":"綦履鸣环左右间，佳儿佳妇及承欢。\n天回白日临瑶席，风约红萱压画栏。\n小管注春情婉婉，长裙曳翠佩珊珊。\n孺人贞俭存家训，不使屏帷绣孔鸾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5236,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"十二月，白牡丹为吕经历赋","author":"张昱","text":"濠泗蒙恩得放回，牡丹犹寄旧亭台。\n忽惊花向腊前发，却是春从天上来。\n欢动山城传好语，兆徵幕府得良才。\n灵根自是南方种，只合移归上苑栽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5237,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"与胡奎言诗","author":"张昱","text":"咏歌终日莫予违，可与言诗竟日稀。\n风雅不删真妙制，性情所得是天机。\n尽知金翠涂屏雀，未见丹青画衮衣。\n杜甫当年评众作，鲸鱼碧海敢云非？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5238,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题白云丈室","author":"张昱","text":"空门真足了吾生，一到翛然万虑轻。\n下榻偶然清话久，推窗唯见白云横。\n银煎瀹茗沙弥黠，宿火添香侍者清。\n甚愧主僧知我辈，碧纱窗染待题名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5239,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"留题天目尊师，并题苍古诗卷","author":"张昱","text":"苍古仰闻君一语，当时岩壑顿生春。\n承恩屡入九重殿，出对尝先十七人。\n中使饭传诸宝器，内庭坐赐杂花茵。\n自天沛泽诚稀遇，拜舞还山洗幻尘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5240,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"元日大雪","author":"张昱","text":"东风吹雪逐年新，洗尽街头万马尘。\n桃板谩题新得句，椒觞偏醉少年人。\n江山未觉非前日，老大犹怜有此身。\n稚子老妻能慰藉，辛盘聊复贺青春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5241,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"搜索旧稿有感","author":"张昱","text":"抖擞蓬尘纸一窠，束之高阁又何多！\n百年公论竟无定，千古文章将奈何？\n大雅未应终绝响，离骚可谓极颓波。\n仲尼删后诗三百，谁与升堂取瑟歌？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5242,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"癸亥立春，在壬戌十二月二十五日","author":"张昱","text":"一岁两春应是闰，自题春帖自相怜。\n苟全性命君之赐，痛念文章儿不传。\n随俗辛盘惟赤手，省思旧物只青毡。\n土牛虽送馀寒在，未可重裘换薄绵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5243,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"元旦试笔","author":"张昱","text":"鸣玉趋朝已不堪，白头早赐老江南。\n从心所欲过八十，屈指可谈无二三。\n献岁屠苏增甲子，发春萱草愿宜男。\n儿扶拜答乡人处，只诵犹龙惟老聃。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5244,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"金山寺","author":"张昱","text":"六鳌捧出法王宫，楼阁居然积浪中。\n门外鸥眠春水碧，堂前僧散夕阳红。\n扬州城郭高低树，瓜步帆樯上下风。\n人世几回江上梦，不堪垂老送飞鸿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5245,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过周昉草庭有感","author":"张昱","text":"深青浅碧自盈盈，一片光风共晚晴。\n意思不殊周茂叔，品题何藉郑康成？\n郎君东阁诗曾咏，蝴蝶南园梦又惊。\n辙迹到门怜草色，白头扶下小车行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5246,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"郭将军妻李氏挽诗","author":"张昱","text":"夫能以义徇孤忠，家国纲常事则同。\n中阃不踰贞妇节，大家何啻古人风？\n机丝已断尘灯在，木主新题穗帐空。\n博士已铭坟上石，九泉深慰若堂封。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5247,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送徐生还台州","author":"张昱","text":"徐氏楼船且莫催，当筵有酒更徘徊。\n山留倒景日未晚，雪满大江潮正来。\n黄叶尽时寻雁荡，丹霞起处望天台。\n楚人自觉多秋思，怀抱今因作赋开。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5248,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"安晚堂","author":"张昱","text":"有酒如渑不用谋，阿翁只合赋三休。\n乡闾可杖容称老，晚节能安自不忧。\n丝竹闲情信陶写，起居惟适是温柔。\n百年耆旧今谁在，且醉官窑大白瓯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5249,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"饮吴令家","author":"张昱","text":"胶漆相投古亦难，酒间何事惨无欢？\n苦愁海底量深浅，痛哭灯前出肺肝。\n白首既辞当世事，朱弦何必向人弹？\n醉来渴甚思吞海，无复天家小凤团。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5250,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟中寄谢别峰、南翁二尊师","author":"张昱","text":"为师倾倒尽双瓶，船过柯亭酒始醒。\n索笑始知高士去，题诗犹爱越山青。\n交情旧雨同新雨，世事长亭复短亭。\n恨是柳遮楼上笛，只教向秀隔烟听。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5251,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄马孝常","author":"张昱","text":"好是吴门马孝常，百年俱是梦中忙。\n谩凭青鸟往相问，说道白眉今更长。\n阳羡故人俱契阔，鲸湖归棹又相将。\n重来定及先春雨，要试陶家雪水香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5252,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"献岁旦日，同芳溪吴理问访许处士","author":"张昱","text":"月旦泛舟从许劭，莲湖溪水白生烟。\n到门好雨过云去，说剑雄风生酒边。\n闲话紫衣成昨梦，醉看乌帽惜馀年。\n懵腾不省临流别，想是行云扶上船。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5253,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"留别姻家吴子道理问","author":"张昱","text":"记得湖船醉夜深，交情何啻断黄金？\n通家叙旧犹前日，把臂迎欢共此心。\n秦女凤箫移别调，楚人芳草动微吟。\n明年不待梧桐雨，来听高堂鼓瑟琴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5254,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题韩处士墓铭、家谱后","author":"张昱","text":"处士连姻俱相门，学传庄节道弥尊。\n几编家集文章在，十世宗支谱系存。\n犹喜继韩能有子，尚怜承祭见诸孙。\n顷原瞑目知无憾，手录清规付后昆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5255,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽崔彦晖母赵夫人","author":"张昱","text":"赵文敏公之孙女，情忝通家见嫁时。\n环佩盛仪犹内院，波澜馀泽自天池。\n佳儿裕蛊承先志，淑女宜家副夙期。\n已托文章题琬琰，百年墓木照丰碑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5256,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"初至义兴芳溪","author":"张昱","text":"罨画溪头雪水浑，是谁酒舫过溪村？\n故人见我即握手，步雪看花直到门。\n仓卒倾银开内阁，从容移玉出诸孙。\n馀生愧忝通家旧，委曲文情可尽论？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5257,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"吴子道同兄辈尝子鹅","author":"张昱","text":"张旭何尝是酒徒，深烦为我作春酤。\n酒行天降盘中露，鹅割囊封塞上酥。\n迹远五湖身既隐，醉归三径子能扶。\n南山远对东篱菊，除却陶家别处无。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5258,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梓轩，为湖州曹生赋","author":"张昱","text":"当轩双梓碧沉沉，直干凌空过十寻。\n客到不妨为少憩，风来或可助长吟。\n百年大用充梁栋，一日希声中瑟琴。\n宜子毋忘角弓赋，将期奕世共清阴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5259,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"同韩介玉过月溪上人玉雪轩","author":"张昱","text":"高僧习静之所在，绕院竹梧生昼阴。\n此境应居玉堂侧，是谁移置雪山深？\n铜瓶薝卜不自供，碧椀醍醐为我斟。\n老得一闲君所赐，小车随处有山林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5260,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次雪鹤生诗韵二首 其一","author":"张昱","text":"北窗昼眠惊叩门，诗筒远寄愿所闻。\n太学郑虔固三绝，小字李潮仍八分。\n湖上好怀非往日，枕边残梦是行云。\n两年屡有清游约，几似空言以属文。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5261,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次雪鹤生诗韵二首 其二","author":"张昱","text":"雄鸠鸣雁即天涯，未觉蓝桥去路赊。\n夜枕不迷蝴蝶梦，春衫深染石榴花。\n千钟纵意伯伦酒，七椀清心谏议茶。\n错向墙头窥宋玉，风光元在鲁东家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5262,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠湖州杨均显制笔","author":"张昱","text":"当年冯陆擅吴兴，曾许杨生继盛名。\n三馆每蒙诸老重，万钧不博一毫轻。\n归来未觉江湖远，落拓宁知岁月更？\n颖也此时须自荐，国家用尔颂升平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5263,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柘轩诗，为教授凌彦翀赋","author":"张昱","text":"满轩桑柘共生成，坐爱春风向日荣。\n五亩宅思邹孟子，百年心慕李延平。\n叶供蚕事诚何损，衣被民生独用情。\n中有如纶五色线，愿从衮职补升平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5264,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"武林严子英家","author":"张昱","text":"严应始以笔治生，至今孙子大其名。\n用世虽云四宝具，传家贵在一艺精。\n东郭之兔即毛颖，南山有竹俱管城。\n器利天下功不有，慎守其业毋自轻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5265,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"昌化县学训导章琛，抄录武林郡志，还乡","author":"张昱","text":"唐相郇公尚有孙，不将家世忝斯文。\n高堂别席事抄录，小帐停灯校纠纷。\n脱稿近知将解局，疏麻拟折遗离群。\n武陵郡志多奇事，归对诸生诵所闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5266,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"示山中白雪牛","author":"张昱","text":"耕田世界绝纤尘，白玉毫光照烂银。\n芦叶膝边穿得过，天花背上落来匀。\n狂踪未定难明性，妄想俱空始见身。\n蓦直络头如不错，也须惭愧执鞭人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5267,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过上虞仙姑岩，观瀑布泉作","author":"张昱","text":"谁把高崖手劈开，钜灵还到此中来。\n青冥风露银河近，白日雷霆碣石摧。\n潭上龙漦溥绛雪，庙前马迹过苍苔。\n犹胜汉使经年别，载得河边片石回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5268,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"深雪斋，为金西白长老赋","author":"张昱","text":"道人宴坐维摩室，积得天花似雪深。\n明月有辉同大地，白莲无影到东林。\n抽毫司马应难赋，断臂神光或可寻。\n落絮游丝纷满眼，从教门外作春阴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5269,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"书药舟，为湖州沈玉泉架阁赋","author":"张昱","text":"溪上香吹白藕花，沈郎舟楫自为家。\n双鬟荡桨乘流去，小榼留人易日斜。\n采得绿荷成野服，博来红米是丹砂。\n綵鸾韵写松烟墨，不与青蛇道士赊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5270,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖晚春","author":"张昱","text":"忆昔东坡为写真，至今诗句在游人。\n朝云犹是当时梦，桃叶浑非旧日身。\n莺燕情怀千语少，鱼龙波浪几回新？\n伤心谁问林逋宅，零落残梅共晚春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5271,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"留峡石朱山人家","author":"张昱","text":"桃熟许同朱老吃，却先桃熟为开樽。\n白鱼入馔溪鳞足，紫茁堆盘野味存。\n诗和渊明为我诵，酒沽若下劝人温。\n迂疏且作须臾乐，从者何嫌久候门？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5272,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"海昌双庙，同张太守次壁上题韵","author":"张昱","text":"孤城请援待王师，保障真成累卵危。\n作厉誓将擒贼去，分羹何惜爱姬为？\n忠臣尽命以报主，信史大书无异辞。\n三十六人同日死，独呼南八作男儿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5273,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赵松雪墨兰","author":"张昱","text":"玉庐墨妙世无同，九畹高情更所工。\n捐佩昔曾过澧上，浩歌今望在云中。\n娟娟奕叶承家泽，淡淡幽香媚国风。\n莫把骚词烦宋玉，赋成还到楚王宫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5274,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"松隐轩","author":"张昱","text":"谁拜青松作大夫，苍然离立自迂疏。\n风声白日回幽梦，云气长年到隐居。\n剪叶浸泉春酿酒，截肪点火夜抄书。\n岁寒卉木俱零落，一杖人间不愿馀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5275,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"剪韭轩，为韩叔贤赋","author":"张昱","text":"故家不贵味能真，率尔蔬醪自可人。\n既向画堂题剪韭，更将玉斗出娱宾。\n青青叶绾指环小，白白头攒乳管匀。\n还是相门风致在，食前谁谓庾郎贫？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5276,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南坡书室图，为竺郎中题","author":"张昱","text":"南坡书室未能还，一夕情生梦寐间。\n职任握兰居紫禁，心随画笔到青山。\n一经教子今何忝，九世为儒古亦难。\n家集河汾来学盛，岂无房杜出朝班？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5277,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"天香室，为定水寺复见心长老赋","author":"张昱","text":"双峰桂树今无似，说道璘公有后身。\n金粟如来能作主，碧山学士愿为邻。\n天香入饷清可食，秋露染花黄未匀。\n何惜一题方丈室，与师同是豫章人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5278,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送星翁甘碧泉挈家归彭泽县","author":"张昱","text":"睽离心事正忡忡，执手何能别此翁？\n葭菼战秋江雨白，鹧鸪啼曙岭霞红。\n贪狼斗柄才加戊，织女云车又向东。\n我忆陶潜旧乡里，到家休负菊花丛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5279,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"蛟门春色图，为定海王宣使题","author":"张昱","text":"风景蛟门春更佳，晴来满海是云霞。\n鲲鲸已入任公钓，波浪长随汉使槎。\n天上星辰归画省，人间岁月属桃花。\n仙人自有双凫舄，弱水蓬莱路未赊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5280,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"旸谷轩，为王知事赋","author":"张昱","text":"地入青徐眺望赊，云中鸡犬有人家。\n金乌五夜出旸谷，玉烛万方瞻日华。\n李泌成仙还作相，刘安得道只餐霞。\n轩前尽种扶桑树，不比玄都观里花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5281,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄赞礼郎赵惟一","author":"张昱","text":"六年读礼足艰危，知尔朝天副所期。\n宗庙正需瑚琏器，羽仪今集凤凰池。\n见辞舍馆情俱恶，忆上河梁步自迟。\n能慰老人思望切，停云还有寄来诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5282,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"静庵，为陈令赋","author":"张昱","text":"潘岳贤能邑大夫，老成谙练实难如。\n治心有术惟清静，临政从公绝毁誉。\n情寄堂琴民自化，乐同时物雉随车。\n循良在昔多徵拜，信史班班不诳予。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5283,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪庭上人惠药资是经钱，赋此以谢","author":"张昱","text":"牝庐居然欲半年，甚于水火观中禅。\n死生有命固无惧，老病他乡始可怜。\n家食旧非邻院米，药资今受施僧钱。\n数间破屋丛书里，谁问洛城卢玉川？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5284,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"问牛轩，为海昌北寺讷无言书记赋","author":"张昱","text":"犀牛不逐扇俱破，奈有人来问此轩。\n资福无端添注脚，石霜何事未忘言？\n大千无迹身俱化，一点通明角尚存。\n拈起家风随手应，莫言无可付儿孙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5285,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春草堂，为陈生赋","author":"张昱","text":"可教游子不关心，白发高堂日已深。\n忧对宜男虽可忘，情同乌鸟若为禁。\n诗书养志勤三省，甘旨承颜抵万金。\n执答春晖怜寸草，孟郊诗句不堪吟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5286,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"蓬莱道院","author":"张昱","text":"云近蓬莱蜃气销，数峰晴照远相招。\n梁间燕子都归去，观里桃花自寂寥。\n盂饭化人忘恋恋，院墙篁竹谩萧萧。\n云中何处刘安宅，犹有鸡声报午朝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5287,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]