[{"title":"四时词（春夏秋冬四首） 其二","author":"郭钰","text":"日射嫣红安石榴，波涵空翠木兰舟。\n美人调笑渡江去，半榻柳风棋不收。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6817,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"四时词（春夏秋冬四首） 其三","author":"郭钰","text":"鹤认琪花欲下迟，蓬莱仙客遣催诗。\n情深写到相思处，秋露芙蓉开满池。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6818,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"四时词（春夏秋冬四首） 其四","author":"郭钰","text":"疏林晴旭散啼鸦，高阁朱帘窣地遮。\n为问王孙归也未，玉梅开到北枝花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6819,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"访龙长史不遇","author":"郭钰","text":"鹦鹉窗深锁翠寒，松花不扫紫苔乾。\n自将名姓题修竹，延桂楼前第五竿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6820,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"花前（次首无题） 其一","author":"郭钰","text":"花前曾共饮离尊，青鸟西归减旧恩。\n双陆细敲红日落，茶烟隔竹不开门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6821,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"花前（次首无题） 其二","author":"郭钰","text":"唾茸残碧枕屏低，香散银篝翠雾迷。\n只恐来宵春梦断，误他明月到窗西。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6822,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题安成戴观所藏崔徽图","author":"郭钰","text":"彩笔经营苦未工，胭脂洗尽泪痕红。\n镜中已少真颜色，何待他年认卷中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6823,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和王仪赠别","author":"郭钰","text":"一曲秦筝春酒浓，暖云轻扑翠鬟松。\n玉骢千里关门晓，鶗鴂数声烟树重。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6824,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"别阮士瞻","author":"郭钰","text":"豆蔻春梢著小花，玉人憔悴掩琵琶。\n阮郎病起心情减，半榻松风自煮茶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6825,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题纨扇赠马文学","author":"郭钰","text":"好风吹雨过横塘，百尺芙蓉水槛凉。\n封事草成秋满榻，坐停纨扇爱花香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6826,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"水东独行","author":"郭钰","text":"独行山径桐花落，忽渡板桥溪水浑。\n残日背人低远树，断云裹雨入前村。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6827,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和宋五见寄","author":"郭钰","text":"苦辞樽酒不同倾，流水浮萍复有情。\n今日江南望江北，绿阴如雨鹁鸠鸣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6828,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寻人不遇","author":"郭钰","text":"早望云林意欲倾，独回江路鸟空鸣。\n山童去后始知悔，追客桥西问姓名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6829,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题扇","author":"郭钰","text":"柳树晴虹隐画桥，藕花微雨过归桡。\n波光倒蘸红楼影，照见佳人弄玉箫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6830,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题扇二首 其二","author":"郭钰","text":"茅亭一个竹编篱，水鸟数声风满池。\n吹面荷花微醉醒，雪罗小扇坐题诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6831,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春夜","author":"郭钰","text":"香雾满帘风不到，花阴铺地月斜明。\n春寒策策春宵短，又听邻鸡第一声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6832,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题访戴图","author":"郭钰","text":"雪月尊前足笑歌，到门何事不相过。\n情知离合皆天意，只恐重来白发多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6833,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宜春赠别","author":"郭钰","text":"微茫烟浪浦帆开，一曲琵琶泪满腮。\n江水不如潮水好，送人东去复西来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6834,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辛卯闻徐州警报","author":"郭钰","text":"塞河诏下选丁男，明日彭城野战酣。\n愁杀翰林欧学士，白头骑马望江南。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6835,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题庐陵义士罗明远传后","author":"郭钰","text":"淮海风回战血腥，青原不改旧时青。\n中朝将士论功赏，让与江南一白丁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6836,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题分宜县楼二首 其一","author":"郭钰","text":"扑遫官曹论是非，不知把钓老渔矶。\n沔阳太守文章伯，卖卜城南竟不归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6837,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题分宜县楼二首 其二","author":"郭钰","text":"独宿江城梦故园，一襟尘土满啼痕。\n老亲不想痴儿在，剪纸应招客路魂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6838,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题梁使君太洲营","author":"郭钰","text":"画船挝鼓大江中，两岸旌旗猎晓风。\n一点鴐鹅云外落，将军初试赐来弓。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6839,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怨别","author":"郭钰","text":"病起银屏满药尘，夜窗愁绝月窥人。\n寒灯不作双花梦，罗帕啼痕点点匀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6840,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"独行山中","author":"郭钰","text":"七步潜行五步回，路通溪曲满蒿莱。\n青袍白马谁家子，又向松阴喝道来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6841,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宿桐江野人家","author":"郭钰","text":"松明火尽掩柴扃，月影疏疏透短棂。\n一枕秋风凉夜好，可怜独向客中听。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6842,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"城望","author":"郭钰","text":"鼓角城头落照悬，客愁愁似五年前。\n遥怜小弟携家远，一点飞云望眼穿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6843,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"发家信","author":"郭钰","text":"寒砚敲冰带泪磨，故园消息近如何？\n老妻不信愁深浅，归日应怜白发多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6844,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"二月十三日","author":"郭钰","text":"花阴转午鹊声喧，忽忆庭闱捧寿尊。\n乱后附书曾到否，也应赊酒共温存。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6845,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春夜","author":"郭钰","text":"路入故园知几程，小楼帘捲月斜明。\n梦中不记遭兵火，犹在海棠花下行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6846,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"青梅词","author":"郭钰","text":"青青梅子故园春，嚼破微酸带浅颦。\n谁信梢头如豆小，意中消息久怀仁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6847,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"章台怨","author":"郭钰","text":"柳绕章台万缕金，春风送别最伤心。\n如今莫问长条尽，并与章台无处寻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6848,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"清明日过罗伯刚别业","author":"郭钰","text":"梨花满院读书声，竹马儿童自送迎。\n共说东风吹雨散，山翁今日作清明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6849,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"访罗仁达不遇留题楼壁二首 其一","author":"郭钰","text":"一径松风导入山，老怀愿托白云閒。\n白云飞去他山宿，日暮雨来愁倚阑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6850,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"访罗仁达不遇留题楼壁二首 其二","author":"郭钰","text":"翠压山楼积雨馀，花间酒暖煮溪鱼。\n提壶劝酒且须饮，头白如今少著书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6851,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和宋五别后见寄","author":"郭钰","text":"误将鹦鹉教诗成，每到人来唤姓名。\n从此西园踪迹少，万丝烟柳锁春晴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6852,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄赠龙兴诸寓公四首 其一","author":"郭钰","text":"旧著群书费苦寻，云山回首负初心。\n归舟重到临江驿，玉笥山前芳草深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6853,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄赠龙兴诸寓公四首 其二","author":"郭钰","text":"抽毫史馆会鸣珂，老去光阴又几何。\n苏武不缘持节苦，胡姬啸子愧人多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6854,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄赠龙兴诸寓公四首 其三","author":"郭钰","text":"孺子祠前湖水东，几回清夜梦吴公。\n白云何事他山去，不管长封紫极宫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6855,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄赠龙兴诸寓公四首 其四","author":"郭钰","text":"落日凭楼满眼愁，征帆无数下江州。\n凭谁为访渊明宅，细采秋英荐李侯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6856,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"二月十七日有感","author":"郭钰","text":"花匝疏篁水绕门，几回扶月醉西园。\n青灯昨夜挑残雨，空认春衫旧补痕。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6857,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶兴","author":"郭钰","text":"高柳著花悬紫烟，归舟离恨满晴川。\n六年杜牧伤迟暮，况复如今二十年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6858,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"清昼","author":"郭钰","text":"雀翻翠筱接飞虫，雨定游丝褪落红。\n渐老心情添懒慢，题诗多在绿阴中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6859,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感春二绝时馆人在狱 其一","author":"郭钰","text":"萋萋芳草旧亭台，燕子衔愁逐处来。\n春酒瓮头今日熟，桃花一树雨中开。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6860,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感春二绝时馆人在狱 其二","author":"郭钰","text":"干谒伤怀去路穷，鲸飞蛟舞楚江风。\n家书写到平安字，始信吾师塞上翁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6861,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"凉夜","author":"郭钰","text":"竹外凉风留晚坐，惊断蛩声山叶堕。\n天河何处是双星，新月纤纤碧云破。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6862,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重题石洞","author":"郭钰","text":"不算归程算去程，茫茫世事自伤情。\n小楼昨夜不成寐，饱听松风与水声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6863,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"同周雪江题刘氏贞女诗卷","author":"郭钰","text":"百年节义仗贤豪，一死翻怜女子高。\n不敢长歌题卷上，转喉恐犯旧官曹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6864,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"洞口人家","author":"郭钰","text":"松树回环四五家，机梭长日响咿哑。\n西风裹得胭脂色，偏与篱东木槿花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6865,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和周子谅见寄二首 其一","author":"郭钰","text":"白露斜飞秋满堂，微寒先结鬓边霜。\n可怜枯折山园竹，犹自虚心待凤凰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6866,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和周子谅见寄二首 其二","author":"郭钰","text":"江上晴波动碧虚，柳汀花坞抱村居。\n男儿不佩黄金印，罢钓归来只读书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6867,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋浦晚归","author":"郭钰","text":"芙蓉开后涉波频，落日回舟独怆神。\n鸥鸟几回相见熟，故穿菱叶避归人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6868,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"对月寄友人","author":"郭钰","text":"相逢之处月婵娟，愿托襟期共百年。\n谙尽人间离别苦，始知月自不长圆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6869,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重经旅馆","author":"郭钰","text":"交情如漆总难凭，往事寻思白发增。\n门掩蟏蛸尘满壁，向来曾顿读书灯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6870,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"小楼","author":"郭钰","text":"梦飞不到越溪头，空想鸳鸯戏彩舟。\n昨夜小楼清似水，雨声添足十分愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6871,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春暮饮田家","author":"郭钰","text":"牡丹芍药委苍苔，风挟馀香去复来。\n二十四番都过尽，一樽独对菜花开。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6872,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"四月十五夜对月感旧","author":"郭钰","text":"早年踪迹水萍浮，垂老漂流未得休。\n今夕人情今夕酒，旧时月色旧时愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6873,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"妾薄命","author":"郭钰","text":"孤鸾窥镜剪情缘，泪血沾襟十五年。\n谁信旧时歌舞伴，相逢犹自妒婵娟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6874,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"四月十五日江上独行因思去两年忧患之日感恨次旧韵","author":"郭钰","text":"投石沧浪竟不浮，云林自合早归休。\n渔舟点点前江去，载尽斜阳不载愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6875,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"六月二十九日观雨","author":"郭钰","text":"青山山下是吾庐，六月丘园草尽枯。\n凭仗西风吹雨去，官田今岁又添租。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6876,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题墨菊","author":"郭钰","text":"老圃风霜许见亲，缘谁尽改旧精神。\n渊明不为陈玄在，怨杀元规扇外尘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6877,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"收边季德书","author":"郭钰","text":"门外蓬蒿一丈馀，病贫无怪故人疏。\n午窗独领松风坐，细读边郎寄远书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6878,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"醉后重题西云亭","author":"郭钰","text":"剪茅盖屋竹编篱，浅白深黄万菊枝。\n云气不烦将雨至，西云老子正题诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6879,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题卞与善梅花图","author":"郭钰","text":"骑驴灞桥乌帽侧，千里相思玉堂客。\n夜窗酒醒月窥人，一掬精神炯如雪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6880,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题王楚善梅二首 其一","author":"郭钰","text":"百年孤干长苔衣，数点寒花映竹扉。\n昨夜东风消息到，主人扶醉月中归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6881,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题王楚善梅二首 其二","author":"郭钰","text":"江云欲雪角声哀，冷蕊商量开未开。\n记得玉堂挥采笔，万花晴昊照深杯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6882,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题龙旗梅","author":"郭钰","text":"砚冰敲碎碧云残，蜂蝶无飞花意閒。\n记得共寻林处士，软寒清晓到孤山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6883,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桃花坞","author":"郭钰","text":"蝶飞蜂绕野桃花，香散墙西卖酒家。\n渔棹误随流水远，一庭红雨夕阳斜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6884,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题邹自春石屏巫山图","author":"郭钰","text":"一片屏开十二峰，阳台去路有无中。\n午窗香雾笼寒玉，犹似行云到楚宫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6885,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和金守正题墨蒲图","author":"郭钰","text":"马乳垂垂白露漙，瘦藤斜舞月光寒。\n凉州万斛寻常醉，回首西风纸上看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6886,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题钟馗","author":"郭钰","text":"老臣骨朽恋君王，白眼孤瞠虚耗忙。\n不惜锦绷儿睡暖，谁人更问绣香囊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6887,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚秋过丁勖","author":"郭钰","text":"竹外涓涓流水长，读书声歇闭山房。\n西园蜂蝶东园去，黄菊数枝高出墙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6888,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题罗秀宾瑞粟图","author":"郭钰","text":"粟分五穗效祯祥，不敢移根献庙堂。\n圣主得贤为上瑞，画图聊付子孙藏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6889,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"壬子正月雪中自从侄九畹家归","author":"郭钰","text":"担簦山路挟馀酲，急霰琮琤远送迎。\n绝胜泛舟湖上月，琵琶一曲杂秦筝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6890,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日","author":"郭钰","text":"花气熏晴春昼长，一池水影舞回廊。\n好风赚得松醪熟，开遍数枝山海棠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6891,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]