[{"title":"送通许张知县考满","author":"王翰","text":"繁台草绿水流澌，正是郎官考绩期。\n昔向斗牛占剑气，今骑斋马劝农时。\n雨馀梁苑花如锦，风煖隋堤柳拂丝。\n比到神京春正好，蓬莱宫殿碧参差。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13856,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题临清书台图","author":"王翰","text":"小溪春涨没沙汀，竹树连云荫草亭。\n轻染麦光临碧落，细研鹅绿写黄庭。\n芸香散帙秋熏蠹，松火明窗夜读经。\n好似瑶山西崦下，诸峰相对玉为屏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13857,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送河南王府判考绩","author":"王翰","text":"三年佐治住东周，又及南辕报政秋。\n千里暮云迷汴水，一帘疏雨别嵩丘。\n凤台晓上留新句，虎监春行访旧游。\n料得归期在初夏，杖藜携酒待仙舟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13858,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉教咏白象","author":"王翰","text":"驯象安南产雪毛，浮洋北贡压神鳌。\n行襄御辇随仙仗，入卫皇宫听舜韶。\n皓彩想从银渚浴，穹形端似玉山高。\n适来王会图中见，势比驺虞意更豪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13859,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送黄先生裳归嵩县","author":"王翰","text":"终军怀抱贾生才，深闭衡门久不开。\n鹗荐两从天外下，鹿车今许陇头回。\n陆浑山好明如画，伊水波澄绿似苔。\n西望白云亲舍近，满襟归兴不须哀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13860,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"别汴城诸友","author":"王翰","text":"三载王门老曳裾，文章鄙俚世情疏。\n病多傍肆常求药，视短停灯久废书。\n报主壮心空磊落，向人别意谩踌躇。\n他年相忆知何处，泪洒黄河溯汴渠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13861,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"思亲处为孟叙仓代作","author":"王翰","text":"夷山孝子思亲处，正是江南亲望时。\n碧岫万重连海徼，白云千里落天涯。\n慈闱久别宁无梦，客舍纾情只有诗。\n远道绝音心更苦，年来触目总成悲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13862,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"承颜堂为瞿述作","author":"王翰","text":"孝子愉亲供色养，承颜新写墨浮光。\n座间共喜双椿寿，庭下重瞻五桂芳。\n綵服舞嬉春正好，白华乐颂日偏长。\n武林千载清槐路，会见贤孙构肯堂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13863,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"简临颍大尹马文隆","author":"王翰","text":"三载王门老教官，授经日日近金銮。\n麝飘金墨诗情好，蚁泛宫壶酒兴宽。\n老去每生乡土念，归来端为故人欢。\n何时策杖瑶峰下，闲共云山赋考槃。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13864,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南行留别","author":"王翰","text":"五月南行道路长，黄埃满面汗流浆。\n入淮四望山如米，过颍三程水似汤。\n老去不堪鞍马倦，客行端为简书忙。\n回头却忆金门乐，白纻乌纱坐晚凉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13865,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"甘泉亭为徐仪宾作","author":"王翰","text":"开国名臣忠孝家，灵泉涌出漱云牙。\n香浮翠甃清涵玉，冷浸银床碧露沙。\n恩重王庭分德泽，祥开戚里永年华。\n自今百世同沾溉，福庆源源岂有涯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13866,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"龙江送别图","author":"王翰","text":"云霁天街生晚寒，贤王鹤驾从千官。\n珠玑争璨文章丽，花萼相辉兄弟欢。\n玉勒马回风日好，锦帆船放水云宽。\n化成一代天伦厚，传共周诗永不刊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13867,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"望云思亲图","author":"王翰","text":"白云天际闲舒卷，却似摇摇行子心。\n云气有时还变灭，子心无日不登临。\n高林度过含疏雨，远岫飞回落晚阴。\n不羡梁公为令子，但存忠孝古犹今。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13868,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送夏典仪丁艰回金陵","author":"王翰","text":"梁园岁晚仍奔赴，清血沾襟诵蓼莪。\n乡讣数行心已折，家庭千里梦先过。\n冶亭山暝苍烟合，采石江空落木多。\n此去蒙恩借才俊，促归南陌待鸣珂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13869,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪夜联诗图","author":"王翰","text":"三子清标骨已仙，要将大雅继唐贤。\n诗吟柳絮春风外，人在梅花夜月边。\n光夺兰膏微有晕，气凌茶灶湿无烟。\n想应一榻团栾处，绝胜山阴访戴船。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13870,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送孙克让赴京","author":"王翰","text":"梁王台下分携处，疋马行吟日暮时。\n囊橐半藏青李帖，简编重补白华诗。\n金壶赐酒浮香蚁，彩笔生花点玉螭。\n想到京华未残臈，好音莫遣寄来迟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13871,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"静熙轩为伯振教授赋","author":"王翰","text":"逸客林居更辟轩，开轩时复看云眠。\n偶来碧涧携明月，闲弄枯桐作响泉。\n松火夜窗摇绛影，木香晨榻散青烟。\n客来相对无尘抱，共说南华第二篇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13872,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"陵阳春晓图为审理赋","author":"王翰","text":"陵阳山下林亭好，更有高人为卜邻。\n几个修篁鸣翠雨，一溪流水隔红尘。\n灵尨过涧能迎客，幽鸟到窗如唤人。\n一住梁园惊岁月，春来顿觉梦归频。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13873,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赴任廉州教授别临颖教谕张朝宗司训丁宗岱","author":"王翰","text":"别馆伤心双泪连，畏途南去几扶颠。\n杳如萍水家何在，纵有鳞鸿信不传。\n七十归来如隔世，八千行到已经年。\n城南记取分襟处，他日相逢是偶然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13874,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南行赴合浦别临颍知县朱士容","author":"王翰","text":"南来六月别京畿，邑宰贤明更可依。\n仕路白头如我少，世途青眼似公稀。\n蛮江波浪何时到，岭海风烟甚日归。\n来岁中秋明月底，与谁把酒共清晖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13875,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送故人韩士林北上","author":"王翰","text":"少年鞍马事弓刀，关塞风尘变二毛。\n午夜谩弹豪士铗，一寒谁借故人袍。\n新丰遣兴惟沽酒，泽畔行吟秖命骚。\n此去周南莫留滞，金台重筑待英髦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13876,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟中望庐山","author":"王翰","text":"宫亭风静镜光平，回望匡庐翠霭凝。\n宝剑插天青玉立，香炉照日紫烟升。\n侵云鸟道还通谷，隔水僧房秖见灯。\n拟向中峰看瀑布，生憎高岫白云兴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13877,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登吴城山望湖亭","author":"王翰","text":"迁客登临暂舣船，吴山绝顶出风烟。\n豫章南去帆冲雨，彭蠡西来浪接天。\n高士置刍思孺子，华亭留句忆坡仙。\n当时石砮今何在，空向神祠一惘然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13878,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠陈仲宽刘嘉善二贤者","author":"王翰","text":"藉甚才名英妙年，江湖何幸得同船。\n清时未许公藏器，晚岁翻令我着鞭。\n人物一双真白璧，文章百选中青钱。\n他时邂逅逢知己，一荐云衢上九天。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13879,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送监税李公考绩","author":"王翰","text":"几年携杖看山心，回首离情满素襟。\n画蠲冲开江水绿，玄猿啼断越山深。\n长干沽酒临风酌，采石题诗对月吟。\n复职归来春欲半，梅关花尽已成阴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13880,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"郁林州道中","author":"王翰","text":"一生梦不到廉州，七十方知事远游。\n山接苍梧从北去，水通合浦向南流。\n鬼门关外人行少，海角亭边客过愁。\n只有鸧鹅似乡旧，数声叫断瘴云秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13881,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题郝陵川琼花赋后","author":"王翰","text":"后土祠前春未归，扬州城下塞鸿稀。\n仙人种玉云迷洞，使客挥毫露湿衣。\n共道肝肠如铁石，谁知咳唾有珠玑。\n茂陵属国诗虽好，空向羊群看雪飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13882,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"忆平陆旧游","author":"王翰","text":"金鸡山顶邓家园，乘兴来游坐水边。\n柿叶染霜围锦帐，菊花承露散金钱。\n溪头怪石如人立，洞口苍苔待我眠。\n何日再同三二友，一壶浊酒送残年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13883,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀东城旧游","author":"王翰","text":"水边台榭竹间亭，日日幽闲共客寻。\n妙曲唱阑欢再和，芳樽引满却重斟。\n筝弹夜月金莺语，笛弄春风綵凤吟。\n往事已同风雨去，衰残无复有初心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13884,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"双鹤","author":"王翰","text":"爱尔仙姿久出胎，如何困滞在尘埃。\n他山松顶足明月，何处水边无绿苔。\n引颈有时思远汉，恋恩终日立空街。\n自今便好仙山去，莫为群鸡生怒猜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13885,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读欧文","author":"王翰","text":"先生笔底有风雷，训练强兵自握机。\n埋狱龙泉须敛锷，蕴山荆璞不藏辉。\n经丘觅壑滁山乐，问舍求田颍水归。\n本论实宗原道说，眉山何事不传衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13886,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"借木绵衫","author":"王翰","text":"木绵如雪胜香罗，一借斯文不再过。\n近照翠奁知恰好，更加乌带问如何。\n涴馀但觉薰香减，书罢常愁醉墨多。\n友义自今诚可重，同袍诗句正堪哦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13887,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晋阳寒食","author":"王翰","text":"并州三月逢寒食，旅况萧条百感中。\n草吐嫩芽犹滞雪，柳含轻絮未随风。\n高原拜扫家家哭，小院鞦韆处处同。\n犹记去年张谷里，落红扑马画桥东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13888,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"韩教授取抄诗稿以是答之","author":"王翰","text":"白发刁骚六十翁，一生何事坐诗穷。\n雕天运海非为贵，流水行云始见工。\n市玉不容夸腐鼠，探珠直欲犯骊龙。\n当年束槁牛腰大，今日樽前一笑空。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13889,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"大雪偶成","author":"王翰","text":"北风吹雪散琼英，疑是云孙巧剪成。\n平地铺来偏洁白，漫天飞处总轻明。\n银河倾泻呈祥瑞，玉烛调和兆太平。\n来岁改元新治化，万邦无事乐春耕。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13890,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"斗鸡亭二首 其一","author":"王翰","text":"一丘独立势崔嵬，形迹还疑是古台。\n龙井效灵沾县邑，神祠肖像儗公台。\n谷云度水风牵过，野雾埋山雨洗开。\n如此风光良不恶，思乡何用赋归哉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13891,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"斗鸡亭二首 其二","author":"王翰","text":"亭上题诗记我来，我来望眼与君开。\n荒陂断垄依林麓，旷野孤村入草莱。\n胜概已为先辈赏，登临常使后人哀。\n行藏有命非吾必，何问云台与钓台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13892,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送孙太雅赴京","author":"王翰","text":"蓼莪诵罢泪沾巾，吉服初成值早春。\n昔入枌榆曾宰社，适来芹泮久为宾。\n雪消江上风涛壮，雨过淮西草树新。\n此去青云高蹑足，伫看雕鹗离风尘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13893,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"斗鸡亭秋望","author":"王翰","text":"扶筇独上斗鸡亭，俯瞰平郊望眼明。\n路入洧川寒晓断，山连新郑暮云横。\n烟生茅屋人家少，风起沙岗雁阵惊。\n况是老年多抱疾，岂堪登眺重伤情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13894,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花次韵","author":"王翰","text":"秖疑姑射是花神，素影横窗月写真。\n斜出短篱犹皓鹤，独居空谷似佳人。\n风前落去多沾石，水畔开时不染尘。\n总把百篇珠玉盛，端能换得十分春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13895,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"德星图","author":"王翰","text":"昔人亭子有遗堆，日日登临车马来。\n二老高风留故事，诸郎雅望尽奇材。\n衣冠会集星辰动，宾主相逢怀抱开。\n千古清芬人共仰，何须联步到公台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13896,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再咏","author":"王翰","text":"昔人久已为尘土，犹记仪形入画图。\n共挽小车兄弟乐，笑挥谈柄主宾娱。\n礼行樽俎贤人聚，光动云霄太史书。\n谁写富春严处士，满江明月钓台孤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13897,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送陈词训回京","author":"王翰","text":"几年踪迹困名场，一第栖迟又可伤。\n旅眼惯看秦树碧，征衣尚染洛尘黄。\n燕城北望云山断，京国南归道路长。\n我欲留君同是客，骊驹初唱劝离觞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13898,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"望云轩为白先生赋","author":"王翰","text":"大行高岫晚崔嵬，千里平郊霁景开。\n每为望云生远思，那堪爱日起深哀。\n老亲徙倚肠应断，游子登临首重回。\n岁久慈帏疏定省，小轩终日独徘徊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13899,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"简临颍令马文隆","author":"王翰","text":"三年我作鄢陵客，半载尔为临颍官。\n岁月无情空冉冉，风尘不定浩漫漫。\n愁来白发三千丈，醉倚画楼十二阑。\n老去功名已无意，任抛青镜不须看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13900,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"中秋和赵孟弘二首 其一","author":"王翰","text":"广寒深处有仙家，跨出秋空白玉蟆。\n颢气挟寒成露颗，轻风拂曙结霜华。\n冰盘出海无纤翳，宝鉴当空绝点瑕。\n拟向清虚瞻兔魄，不堪老眼欲生花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13901,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"中秋和赵孟弘二首 其二","author":"王翰","text":"银汉昭回势欲流，瑶台露下冷光浮。\n轻风捲雨作佳夕，皓彩射空生素秋。\n老子据床多逸兴，孀娥依桂不生愁。\n此宵常被阴霾误，来岁高堂得赏不。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13902,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"云林书舍为黄金华题","author":"王翰","text":"山中四序多佳趣，况住白云绿树间。\n绕舍流泉声㶁㶁，隔帘幽鸟语关关。\n晴窗阁笔抄书罢，春沼留香洗砚残。\n羡子妙年方膴仕，岂容归隐佩秋兰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13903,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寿王教谕","author":"王翰","text":"杨柳初青莺语娇，祝君五福若春涛。\n亭前众子皆兰玉，席下诸生列俊髦。\n九万鹏程天地阔，八千椿算海山高。\n花开满眼春无际，尽放诗豪与酒豪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13904,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过赵州石桥和杜缑山韵","author":"王翰","text":"隔断红尘竟不飞，客行石磴不粘泥。\n高连晓岸堆晴雪，斜跨青波卧彩霓。\n山势远连沧海阔，地维平见太行低。\n故园回首几千里，怅望碧山山更西。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13905,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过涉县","author":"王翰","text":"两岸青山几万里，中间一水走如龙。\n数家市肆无居货，百户厢民尽务农。\n兵燹罕经祠庙古，蝗灾不值岁时丰。\n前朝令尹多佳政，道侧苍碑记范公。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13906,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自涉至黎城山行即事","author":"王翰","text":"涉城城下渡衡漳，一道青林百里长。\n云表连峰驰健马，途中乱石卧群羊。\n溪头雨过莓苔滑，谷口风来药草香。\n鞍马倦人聊少憩，山蝉无数噪斜阳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13907,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过李靖祠","author":"王翰","text":"神头岭下卫公祠，楼观穹窿覆古碑。\n堪笑韩彭真竖子，指挥褒鄂似婴儿。\n金戈铁马兴王日，羽扇纶巾灭寇时。\n战策本期经国用，初心不与乱臣知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13908,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"王寨遇雨","author":"王翰","text":"西风吹雨晚潇潇，山馆无人夜寂寥。\n病后岂堪鞍马倦，老来偏怯路岐遥。\n孤灯耿耿梦初断，双棹悠悠魂欲消。\n自是奇穷多坎壈，非干王事独贤劳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13909,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过东吴岭","author":"王翰","text":"东峰西峰相对起，南人北人来经过。\n潭光清心漾天影，松声聒耳鸣云和。\n马蹄凌兢陟石磴，猿臂联引垂岩阿。\n举头西望见姑射，烟林远绕青嵯峨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13910,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和丁志善韵","author":"王翰","text":"君到吴山我夏城，山斋寂寞砚生冰。\n每逢夜雨成新恨，伫望停云寄远情。\n去馆旧书今暂束，閒门无客昼长扃。\n年来病废知何用，拟结江湖鸥鹭盟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13911,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过眉山二苏先生墓","author":"王翰","text":"玉堂得意少知几，岭海归来两鬓丝。\n此处青山好埋滑，何年赤壁重衔悲。\n应知双冢秋风日，正是连床夜雨时。\n千古英灵犹不死，烛天文焰照峨眉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13912,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"洪武戊寅予去官平陆有律诗二章曾录示宋广文至洪武辛巳告放归田里复赓前韵二首仍简宋广文 其一","author":"王翰","text":"一别吴山又四年，客途流落几扶颠。\n诸生专业无多子，同宦居官有几员。\n感旧听残秋夜雨，思乡吟断夕阳天。\n有时一付掀髯笑，得失原来是偶然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13913,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"洪武戊寅予去官平陆有律诗二章曾录示宋广文至洪武辛巳告放归田里复赓前韵二首仍简宋广文 其二","author":"王翰","text":"三年奔走听朝鸡，谁料归来觅旧题。\n尘暗粉垣诗尚在，雨生苔藓径都迷。\n天涯远见孤帆小，地底平铺万瓦低。\n何幸再同三二友，一樽聊为浣愁栖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13914,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"红叶","author":"王翰","text":"秋来万木着新黄，只有枫林醉晓霜。\n炬火乘风焚赤壁，锦帆迎日下维扬。\n乱飘村岛迷樵径，远泛宫沟出苑墙。\n最爱家园近重九，数枝篱外伴秋香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13915,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]