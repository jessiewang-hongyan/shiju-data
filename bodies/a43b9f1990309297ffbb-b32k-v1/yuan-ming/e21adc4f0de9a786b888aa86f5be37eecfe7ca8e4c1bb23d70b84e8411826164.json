[{"title":"绝句漫兴十一首 其二","author":"刘基","text":"兔葵燕麦旧人家，曾唱南朝玉树花。\n寒暑又随风日转，东陵谁种邵平瓜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8860,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句漫兴十一首 其四","author":"刘基","text":"新莺枝上语如丝，似与羁魂诂所思。\n不用登楼看草色，白蘋香散巳多时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8861,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句漫兴十一首 其五","author":"刘基","text":"相思举目万重云，燕去鸿来杳不闻。\n漫说黄金能得士，只今谁是望诸君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8862,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句漫兴十一首 其八","author":"刘基","text":"池面新荷贴小钱，荷心点点露珠圆。\n开花结子应堪待，乱荇空萍正可怜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8863,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句漫兴十一首 其九","author":"刘基","text":"袅袅江风转白蘋，轻花乱蕊看成尘。\n谁能爇取生犀角，采石矶头照水神。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8864,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句漫兴十一首 其十","author":"刘基","text":"日落群山返照馀，槐阴梦觉夕阳初。\n夜闲不畏更筹短，收取流萤映读书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8865,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句漫兴十一首 其十一","author":"刘基","text":"白鹭洲边白鹭鸶，一双相对立䙰褷。\n日斜隔水分明见，不分人间有别离。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8866,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫成三首 其二","author":"刘基","text":"瞿塘怒水激天风，回首童颜变老翁。\n落日长年鸣橹过，白鸥飞出浪花中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8867,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"不雨遣闷二首 其一","author":"刘基","text":"朝霞不作黄昏雨，暝霭徒为白昼风。\n日上高林啼布谷，声声只在短墙东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8868,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨馀","author":"刘基","text":"枯池得雨闹群蛙，蜿蟺含浆总有家。\n为爱微凉宜晓梦，不知晴日满庭沙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8869,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题绝句二首 其一","author":"刘基","text":"花自飘零水自流，无情有恨月如钩。\n十年一枕三更梦，嬴得风烟满地愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8870,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题绝句二首 其二","author":"刘基","text":"后夜蛾眉约浅黄，河边犹翳玉绳光。\n不知何处藤萝上，全见姮娥一面妆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8871,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚兴","author":"刘基","text":"腐草馀光灭又明，微风不起夕凉生。\n绝怜一饷池塘雨，只得青蛙半夜声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8872,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"睡起","author":"刘基","text":"浓绿当轩日上迟，病身只与睡相宜。\n觉来却怪庄周蝶，绕尽残枝过别枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8873,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"喜雨寄夏允中五绝 其一","author":"刘基","text":"好雨知时五月零，豆苗瓜蔓一时青。\n老夫亦起中庭立，两眼看一似醉醒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8874,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"喜雨寄夏允中五绝 其二","author":"刘基","text":"隐隐轻雷不起风，濛濛密雨遍长空。\n枯根发秀新茎长，小草那知造化功。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8875,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"喜雨寄夏允中五绝 其三","author":"刘基","text":"涣汗如蒸被体流，日高强起倦梳头。\n多情一夜千山雨，消尽人间万斛愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8876,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"喜雨寄夏允中五绝 其四","author":"刘基","text":"水鹳长嗥应九陵，山云处处上如蒸。\n定知谷鲋从今后，不向西江乞斗升。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8877,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"喜雨寄夏允中五绝 其五","author":"刘基","text":"江暗天低雨脚垂，屋鸣檐泻入枯池。\n却怜似镜新荷叶，不见鱼跳鹭浴时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8878,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题","author":"刘基","text":"槐映高楼柳映墀，风来唯有鹊先知。\n长应别殿黄昏后，记得金富妒宠时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8879,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"将晓","author":"刘基","text":"月落窗馀白练光，满天清露结为霜。\n东风可是无情思，吹出新杨一树黄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8880,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江行杂诗九首 其一","author":"刘基","text":"采石江头山插天，江泉激石鸣湘弦。\n十年战血污江水，水中鬼神应醉眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8881,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江行杂诗九首 其二","author":"刘基","text":"二生矶上星满滩，白烟如雪浮林端。\n水妃夜解玉佩去，清泪滴成红木难。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8882,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江行杂诗九首 其三","author":"刘基","text":"马当之山中江中，其下乃是冯夷宫。\n良宵月出江水底，行人喜甚天无风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8883,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江行杂诗九首 其四","author":"刘基","text":"九龙山西西日沉，江云压地生层阴。\n汀洲无人蕾叶响，咆虎一声风满林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8884,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江行杂诗九首 其五","author":"刘基","text":"皖口孤城江水傍，城上犹有愁云黄。\n豺狼魑魅相食尽，忠魂白日长垂光。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8885,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江行杂诗九首 其六","author":"刘基","text":"桑落洲边春草生，宜城九酝空传名。\n百年世事同醉梦，愁听野猿啼到明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8886,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江行杂诗九首 其七","author":"刘基","text":"江盘峡束当彭浪，孤山如聿江中央。\n坤灵不放厚地裂，应有潮汐通扶桑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8887,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江行杂诗九首 其八","author":"刘基","text":"长江水浊湖水清，石钟涛击鲸鱼鸣。\n山头出云山下雨，杨澜左蠡何时平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8888,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江行杂诗九首 其九","author":"刘基","text":"江州太守文儒宗，骂贼就死真从容。\n天翻地覆元气在，斯人万古其犹龙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8889,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钟山作十二首 其一","author":"刘基","text":"紫桂吹香媚小山，月华的皪满林间。\n坐来凉气生虚室，知是山云作雨还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8890,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钟山作十二首 其二","author":"刘基","text":"松露滴阶星在天，草虫相吊响如弦。\n宝公塔上西风急，半夜林鸦不得眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8891,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钟山作十二首 其三","author":"刘基","text":"九月江南叶未黄，空山松柏夜深凉。\n玄蝉且莫催徂景，留取幽兰作晚香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8892,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钟山作十二首 其四","author":"刘基","text":"玄武湖中草自秋，石头城下水长流。\n繁华过眼成今古，更与牛羊竞一丘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8893,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钟山作十二首 其五","author":"刘基","text":"春去秋来荣复衰，花残叶落总堪悲。\n谁能句曲山中去，乞取茅君一虎骑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8894,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钟山作十二首 其六","author":"刘基","text":"北斗阑干夜未央，钟残虚牖出天香。\n佛灯相对坐宵寂，坠露满林生白光。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8895,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钟山作十二首 其七","author":"刘基","text":"一炷清香一卷经，世间无事是山僧。\n何须更卓飞空钖，长使时人恨不能。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8896,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钟山作十二首 其八","author":"刘基","text":"月落山空雾未开，风生咆虎响如雷。\n树头惊鹊相呼起，欲下还飞一百回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8897,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钟山作十二首 其十","author":"刘基","text":"策杖登山信早凉，山花涧草总能香。\n扪萝抱水归来倦，不扫苍苔卧石床。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8898,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钟山作十二首 其十一","author":"刘基","text":"袅袅西风散白蘋，冥冥落日起黄尘。\n青娥不分秋容寂，故染枫林似老人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8899,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钟山作十二首 其十二","author":"刘基","text":"槁叶含风弹夜弦，蟪蛄凄唳荅寒蝉。\n鸡鸣埭上繁华子，莫向秋霜惜盛年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8900,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画鱼二首 其二","author":"刘基","text":"九罭无人咏鳟鲂，河坟有客叹牂羊。\n不知生意能多少，争得鲲鲕满尺长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8901,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题三首 其一","author":"刘基","text":"一片浮云万里心，海波无底未为深。\n虞渊险迫羲和疾，空使傍人诧邓林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8902,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题三首 其二","author":"刘基","text":"玉树沉沉结夜愁，金陵蔓草没荒丘。\n谁言锦缆江都去，不见金陵蔓草秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8903,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题三首 其三","author":"刘基","text":"黄鹄高飞云路遐，野凫谋食但泥沙。\n山中樗栎年年在，看尽西风木槿花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8904,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题墨菊","author":"刘基","text":"粲粲金英美可餐，九秋风露与清寒。\n墨君莫妒夫然色，终遣灵均怨子兰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8905,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过闽关九首 其二","author":"刘基","text":"峻岭如弓驿路赊，清溪一带抱山斜。\n高秋八月崇安道，时见棠梨三两花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8906,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过闽关九首 其四","author":"刘基","text":"驿路高低度岭关，兜离人语杂夷蛮。\n江花巧似驼茸白，山果浑如码碯般。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8907,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过闽关九首 其五","author":"刘基","text":"饭淅香琼酒潋霞，驿亭到处只如家。\n征夫但恐咨询阙，莫向天涯怨路赊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8908,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过闽关九首 其七","author":"刘基","text":"道上黄埃扑马鞍，汗流如水透中单。\n忽惊疏雨林梢过，急换罗衣更怯寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8909,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过闽关九首 其八","author":"刘基","text":"剑水悠悠南去深，黄茅苦竹自成林。\n日烘溪雾生秋瘴，风搅山霏作昼阴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8910,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过闽关九首 其九","author":"刘基","text":"岭上高秋生火云，往雷送雨忽纷纷。\n鹧鸪更叫空山里，纵是无愁亦厌闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8911,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画红梅","author":"刘基","text":"水晶宫里王真妃，宴罢瑶台步月归。\n行到赤城天未晓，冷霞飞上绿珠衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8912,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题扇面牡丹花","author":"刘基","text":"沉香亭畔月华流，掌上孤鸾镜里愁。\n舞罢春风却回首，六宫红粉总包羞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8913,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题扇面荷花","author":"刘基","text":"玉井芙蓉红粉腮，何人移向月中栽。\n高轩忽漫看图画，疑是昭阳晓镜开。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8914,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题水墨海棠鹦鹉","author":"刘基","text":"陇山鹦鹉白霓衣，欲语谁听只自知。\n漫漫东风吹不起，海棠花上立多时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8915,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拜曹娥庙","author":"刘基","text":"曹江源自舜江来，抱父悲同泣旻哀，纵使乾坤灰劫火，娥心一点不成埃。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8916,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"河传　 江上作","author":"刘基","text":"江上风过水生纹，烟里斜阳半曛。\n雨声不堪客耳闻，纷纷，梦魂迷断云。\n梦断天涯归路杳，天欲晓，残月窥窗小。\n木兰舟，芦苇秋，汀洲，藕花相伴愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8917,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"满庭芳　 咏荷花","author":"刘基","text":"杨柳烟销，梨花云散，瑶台别是风光。\n翠霞深处，谁舞白霓裳？\n三十六宫向晓，凤绡拥、红粉成行。\n珠帘外，风翻瑞葆，惊起紫鸳鸯。\n含情，空怅望，衾寒鄂渚，佩冷潇湘。\n怨凌波尘袜，不度银潢。\n只恐青娥娇妒，相将见、苇白芹黄。\n凄凉也，一天坠露，明月在池塘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8918,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"玲珑四犯　 台州作","author":"刘基","text":"白露点珠，明河生浪，秋光看又一半。\n翠衾知夜永，清梦冷孤馆。\n南楼数声过雁，西池桂花零乱。\n岁序如何，江山若此，赢得鬓霜满。\n伤心谩回愁眼，见蛩吟蔓草，萤度荒疃。\n泪随黄叶下，事逐浮云散。\n沧波滚滚东流去，问谁是、登楼王粲。\n菊绽篱边，赋归来恐晚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8919,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江神子","author":"刘基","text":"霏霏轻雨弄秋光，野烟苍，晚风扬。\n征雁将愁，分付与寒螀。\n窗外声声啼到晓，人不寐，夜何长。\n沧江波浪去茫茫，莫思量，使心伤。\n篱外黄花，只作旧时香。\n歌罢归来深对酒，今古事，总凄凉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8920,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浪淘沙 秋感","author":"刘基","text":"江上晚来风，烟蔼濛濛，白蘋吹尽到丹枫。\n流水落霞衰草外，离恨无穷。\n极目楚云东，愁见归鸿，拒霜相倚夕阳中。\n露重月寒芳意歇，知为谁红。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8921,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浪淘沙 感事","author":"刘基","text":"天际草离离，鸿雁南归，冷烟凝恨锁斜晖。\n胡蝶不知身是梦，飞上寒枝。\n惆怅倚阑时，总是伤悲，绝怜红叶似芳菲。\n清露自凋枫自落，没个人知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8922,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"淡黄柳　 台城秋夜","author":"刘基","text":"江城夜寂，何处吹羌笛。\n城上月高风淅淅，翻动林梢败叶，一片琅玕下空碧。\n倦游客，乡关暮云隔。\n谩回首，盼归翼，想柴门、流水依然在。\n白发参军，青衫司马，休向天涯泪滴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8923,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"调笑令四首 其一","author":"刘基","text":"秋雨，秋雨，窗外白杨自语。\n梦回月在空廊，灯影朦胧夜凉。\n凉夜，凉夜，露冷芙蓉花谢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8924,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"调笑令四首 其二","author":"刘基","text":"沙燕，沙燕，别去几时重见。\n汀洲芳草纤纤，细雨微风捲帘。\n帘捲，帘捲，人与碧梧俱晚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8925,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"调笑令四首 其三","author":"刘基","text":"白露，白露，点我庭前芳树。\n树中有个栖鸦，啼到银蟾影斜。\n斜影，斜影，照见罗帏梦冷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8926,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"调笑令四首 其四","author":"刘基","text":"红树，红树，妆点天涯秋暮。\n淡烟衰草黄昏，露冷啼螀断魂。\n魂断，魂断，明日玉台霜满。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8927,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"菩萨蛮　 越城晚眺","author":"刘基","text":"西风吹散云头雨，斜阳却照天边树。\n树色荡湖波，波光艳绮罗。\n征鸿何处起，点点残霞里。\n月上海门山，山河莽苍间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8928,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"渔家傲","author":"刘基","text":"江上秋来惟有雨，江城九月犹炎暑。\n泉涌中庭苔上柱。\n深闭户，莎鸡露泣寒螀语。\n征戌诛求空轴杼，千村万落无砧杵。\n玉帐悠悠闲白羽。\n愁正聚，乱鸦啼破楼头鼓。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8929,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"小重山","author":"刘基","text":"城上高楼接海霞，疏林藏不尽、欲栖鸦。\n回廊曲槛别人家，征鸿外，风冷夕阳斜。\n灯暗鼓三挝。\n望中烟隐树、月笼沙。\n白云如梦绕天涯。\n梧桐雨，和泪滴寒莎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8930,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]