[{"title":"巫山高","author":"徐贲","text":"巫山峰十二，一一向阳台。\n闻说君王梦，曾逢神女来。\n树色悽离恨，猿响抱馀哀。\n至今云雨里，徒使后人猜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7789,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"邯郸才人嫁为厮养卒妇","author":"徐贲","text":"妾本邯郸富家女，学得诗书绝歌舞。\n小时恩例选入宫，天颜一顾生春风。\n崇台往来十五载，玉容无复桃花红。\n君王宠新盛开宴，还同贱妾初时见。\n君边银烛照华筵，妾处秋萤闭湥院。\n当时自喜才名人，如今始信诗书贫。\n辞君去嫁厮养卒，不怨君王怨妾身。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7790,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"折杨柳","author":"徐贲","text":"人言折柳愁，我言折柳好。\n倘向柳边行，织君去时道。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7791,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"名都一何绮","author":"徐贲","text":"名都誇绮丽，千门争向开。\n射熊旧辟馆，迎凤新筑台。\n画毂金吾过，骏马玉珰来。\n纵横九衢里，日日逐尘埃。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7792,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"神弦别曲","author":"徐贲","text":"桂叶吹香楚花雨，十二离鸾梦中语。\n绿蛾绀发团作云，高軿夜降巫山女。\n金炉蕙气烈火浓，画帘罗幕春重重。\n翠樽进酒乐未终，众巫笑起鼓鼕鼕。\n烛光倒射椒花红。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7793,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"从军行","author":"徐贲","text":"装刀不用金，立身不在文。\n昨日破邯郸，归来论功勋。\n君王更部位，官属冯将军。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7794,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"别离曲","author":"徐贲","text":"山风吹霜榆叶老，城鸦传声天欲晓。\n征徒出门驾行装，斗杓倒悬月无光。\n我停露车客停马，荒烟萧萧暗平野。\n一杯浊酒且须须，九月垂杨不堪把。\n歌声感激弦声繁，坐上醉人争笑喧。\n相逢相别皆草草，心事如丝向谁道。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7795,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"新嫁娘效王建","author":"徐贲","text":"邻里争来贺，三朝礼数频。\n只是羞抬眼，识郎犹未真。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7796,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"五索效韩偓 其一","author":"徐贲","text":"为性好梳裹，料鬓更均腮。\n手把百神镜，千回自照来。\n可怜手无力，从郎索镜台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7797,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"五索效韩偓 其二","author":"徐贲","text":"昨日下河桥，多被行人见。\n花稀无处藏，见我新妆面。\n一向不禁羞，从郎索罗扇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7798,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"五索效韩偓 其三","author":"徐贲","text":"几回畏春寒，不向庭中走。\n杏花都落尽，雨长春苔厚。\n我欲扫落花，从郎索鸾帚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7799,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"五索效韩偓 其四","author":"徐贲","text":"琵琶性里好，曲调手中便。\n一朝弦断尽，欲接却无缘。\n待弹不可得，从郎索新弦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7800,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"五索效韩偓 其五","author":"徐贲","text":"閒将红色丝，结取承露囊。\n一面芙蓉花，一面双鸳鸯。\n不藏针与线，从郎索麝香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7801,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"新曲效温庭筠","author":"徐贲","text":"深宫漏永闭青春，象床玉枕绣为裀。\n虹梁日出照明锦，流苏风动堕香尘。\n鸳鸯帐里承恩重，睡起鬟斜绿云拥。\n艳舞浓歌女伴誇，芳容娇态君王宠。\n好风美景绮窗前，佳节良辰信可怜。\n点腮试拭花梢粉，画眉还用麝脐烟。\n宝钗压鬓犀梳映，几度调妆看不定。\n双凤雕成白玉台，四龙蟠作黄金镜。\n妆成只是自焚香，绛唇红靥间明珰。\n敛笑藏羞向窗坐，时理银筝更炙簧。\n内家花柳春风早，桃园杏圃闻黄鸟。\n花鸟撩人可解禁，多欢多乐年年好。\n一从少小擅风流，日来欢御凤凰楼。\n侍奉君王无所愿，上祝万岁又千秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7802,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"切切重切切赠普仲渊","author":"徐贲","text":"切切重切切，相逢复相别。\n君行车有轮，我车去无因。\n千里更万里，宛转车轮里。\n关山路崄巇，行速宁行迟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7803,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"塞上曲","author":"徐贲","text":"十五见天子，十八领边兵。\n曾将一羽箭，赢得射雕名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7804,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"新弦曲","author":"徐贲","text":"弦头响清人爱怜，曲多弹杂难为弦。\n一宽一紧调复乱，却把新弦一齐换。\n新弦换上等要听，旧弦换下谁来看。\n旧弦旧弦莫谩悲，新弦还当有旧时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7805,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"采莲曲","author":"徐贲","text":"采莲莫采多，采多茎伤手。\n手伤有时好，伤我池中藕。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7806,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"蚕妇词","author":"徐贲","text":"采桑复采桑，采桑未盈筐。\n今年小姑嫁，蚕多独自忙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7807,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"三妇词","author":"徐贲","text":"大妇能刺绣，中妇解藏钩。\n小妇知音乐，纤手弹箜篌。\n上客且安坐，风光无日休。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7808,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽兰曲","author":"徐贲","text":"幽兰不是寻常草，长叶丛丛紫花小。\n几见东风梦里来，绿艳烟浓红日晓。\n琐窗护春春意暖，宛转清香吹不断。\n美人昨夜度瑶琴，白雪新消楚江满。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7809,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"湘妃曲","author":"徐贲","text":"蛮娘唱怨鲛房黑，冰瑟嘈嘈机罢织。\n寒浓翠薄妒蝉衫，烟梧风竹斓斑色。\n凤声天远有谁闻，双蛾黛影愁不分。\n楚山九点秋未老，泪花染尽潇湘云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7810,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"青楼曲","author":"徐贲","text":"绮绣列中堂，罗扇映秾妆。\n钿花新样制，钗梁出意长。\n藏香诒荀令，笑指调周郎。\n不应妙歌舞，旧得事平阳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7811,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"洛阳陌","author":"徐贲","text":"君家天津南，我家孟津北。\n都因看花来，相逢不相识。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7812,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"道逢镏武威","author":"徐贲","text":"昨夜看灯归，道逢镏武威。\n将灯调人笑，连手挽罗衣。\n引上东城路，邀入他家去。\n都无女伴随，娇羞不成怒。\n郎心莫乱想，想着直须媒。\n兰衾胡敢御，一夜坐堆堆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7813,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"龙门有孤桐","author":"徐贲","text":"龙门有孤桐，斲为三尺琴。\n良材不易得，轸玉而徽金。\n泠泠七弦间，一弹清我心。\n要知在自适，奚必求知音。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7814,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"将军行","author":"徐贲","text":"朝出飞狐塞，暮返云中营。\n提携燕代卒，意气恣纵横。\n屡奉天子诏，万里得专征。\n霜风宝刀利，晓日炫朱明。\n弯弧白象斲，重铠文犀成。\n敌骑不敢向，三边尽知名。\n裨校拥纛前，都护随镳行。\n首功不足计，当为誇擒生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7815,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"猛虎行","author":"徐贲","text":"尔虎从何来，据住三叉口。\n昨日啖东家猪，今日噬西家狗。\n山中百兽不敢鸣，白杨黄竹阴风生。\n邻家少年凭意气，弯弓挂箭寻山行。\n夜深月黑候虎出，明朝荒草馀白骨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7816,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"击筑行和高季迪韵同张记室宪赋","author":"徐贲","text":"和君击筑吟，请君侧耳听。\n不是更容貌，谁能知姓名。\n主人莫称善，坐客何须惊。\n酒酣欲罢奏，壮心难自平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7817,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"短歌行赠杜君寅","author":"徐贲","text":"白日虽苦短，万里落复生。\n人生自有限，难极欢爱情。\n愚者谋在食，知者志在名。\n愚知各有求，谁能免经营。\n秋花容易老，秋叶难再荣。\n对酒心已醉，酌酒泪先倾。\n我非不能遣，柰此愁相萦。\n君亦失意人，请吟短歌行。\n歌短意自长，展转歌莫停。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7818,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游仙词","author":"徐贲","text":"浮游虚空界，潇洒飞云台。\n灵光照八景，真气凌三台。\n日出东皇降，月生西母来。\n绛玉装书笈，文螺制酒杯。\n长歌忽俛首，溟渤扬黄埃。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7819,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"贾客行","author":"徐贲","text":"贾客船中货如积，朝在江南暮江北。\n平生产业寄风波，姓名不入州司籍。\n船头赛神巫唱歌，举酒再拜酹江波。\n纸钱百垛不知数，黄金但愿如其多。\n须臾神去风亦息，全家散福欢无极。\n相期尽说莫种田，种田岁岁多徭役。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7820,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"青丝白马歌","author":"徐贲","text":"银鞍白马青丝缰，容颜花艳少年郎。\n有时系马垂杨树，逐翠寻香入花去。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7821,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"对镜词","author":"徐贲","text":"莲壶漏转铜龙泣，露压香尘玉阶湿。\n欲理残妆唤镜来，恰在石榴花下立。\n犀梳未整宝钗偏，绿鬟娇?芙蓉烟。\n孤鸾飞入月中去，离愁脉脉空婵娟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7822,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宫中夏夜词","author":"徐贲","text":"凉露下莲池，云廊夜步时。\n小鬟痴欲睡，频说斗杓移。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7823,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"扶南曲辞歌","author":"徐贲","text":"红日映高树，晴光入绮疏。\n钿屏开八字，银钥启双鱼。\n美人晓妆罢，流莺春语初。\n中使帘前立，直待上金舆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7824,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"长歌复短歌四章 其一","author":"徐贲","text":"长歌长，短歌短，百岁人生那得满。\n昔不乐，今何如，少年焉用多读书，桑枢瓮牖为穷儒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7825,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"长歌复短歌四章 其二","author":"徐贲","text":"短歌短，长歌长，男儿有足行四方。\n鞍在马，轮在车，请君莫言道路赊，安能局束长在家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7826,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"长歌复短歌四章 其三","author":"徐贲","text":"长歌停，短歌起，春风吹入行人耳。\n壮年少，老日多，人生有志莫蹉跎，致君尧舜当如何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7827,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"长歌复短歌四章 其四","author":"徐贲","text":"短歌歇，长歌续，百年碌碌复碌碌。\n交者多，知者少，取次论心皆草草，志士栖迟眼中老。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7828,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"田家行","author":"徐贲","text":"溪南种田溪北住，屋东栽桑屋西树。\n阿翁八十不出户，长男踏车妇织布。\n大女送饭小络纱，幼男放牛未还家。\n年年纳得官家足，箧有馀布甑有粟。\n田家古来多苦辛，饱煖各自全一身。\n我愿子孙亲?亩，终身不识离乡苦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7829,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"农父谣送顾明府由吴邑升常熟","author":"徐贲","text":"我家茆屋临官道，前种桑麻后梨枣。\n年年力作不违时，人有馀粮牛有草。\n官长下车今五年，老身不到州县前。\n乡无吏胥门户静，家家尽称官长贤。\n大男入郭买田具，始知官长移官去。\n来时忆向官道迎，今日去时须送行。\n攀辕欲留留不止，我民怆惶彼民喜。\n殷勤再拜官道傍，愿饮三江一杯水。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7830,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柳短短送陈舜道","author":"徐贲","text":"柳短短，春江满。\n兰渚雪融香，东风酿春暖。\n山长水更遥，浩荡木兰桡。\n兰桡向何处，送君行，南昌去，离愁落日烟中树。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7831,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"白蘋花送王汝器","author":"徐贲","text":"白蘋花，绿蘼草。\n南风吹碧波，五月湘江道。\n行人劝酒离绪多，棹女棹郎歌棹歌。\n黄鹂啼时风景好，大堤日落奈君何。\n君今去，不可留，山叠叠，水悠悠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7832,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"明月篇赠章子向","author":"徐贲","text":"商飙拂绛河，圆月溢金波。\n澄阴斜映桐池近，爽气遥连桂渚多。\n穿栊窥帐虚尘净，鉴帷照牖芳香冷。\n玩赏何人倚画栏，瑶华翠羽流空影。\n含情抱琴为调弦，弦中新曲重堪怜。\n不见嫦娥空岁岁，漫思湘女自年年。\n天上人间秋浩浩，此时此景谁家好。\n陈王园内咏初成，庾令楼中醉欲倒。\n松醪椒醑满金杯，嘉客良朋逐夜来。\n当筵光彩聊供览，不须催驾上瑶台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7833,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"听乌词为陈惟允赋","author":"徐贲","text":"乌乌乌，鸣相呼。\n朝饲雏，暮饲雏。\n昨日饲雏雏尚小，今日雏飞乌已老。\n老乌长日不出飞，众雏反饲衔食归。\n飞飞不离君家屋，夜后还来屋头宿。\n屋中主人千万情，见乌得饲不敢惊。\n愿归见亲学乌饲，轩不名乌人不愧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7834,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"爱日吟为孙希范赋","author":"徐贲","text":"读书从教寸晷移，照镜不怕朱颜衰。\n阿翁垂白年有限，只恐乌飞去难返。\n人生在世谁无亲，乱来各自逃一身。\n十家父子九离散，似君团圞能几人。\n白日可买金可得，使翁寿长应不惜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7835,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"望云词为贝公远赋","author":"徐贲","text":"朝望云悠悠，暮望云漠漠。\n望云云不尽，思亲双泪落。\n迢迢亲舍东海滨，但见白云不见亲。\n得亲身安年不老，还家虽迟心亦好。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7836,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"蓼莪吟为朱公路作","author":"徐贲","text":"昨日春雨好，莪叶青青小。\n今日秋霜飞，青青尽枯槁。\n秋霜春雨各有时，两丸东西宁少迟。\n儿今得官亲不在，满地寒蒿不堪采。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7837,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"岁晚行赠习尚镛驾部","author":"徐贲","text":"苦哉岁晚西风悲，美人不来寒雁啼。\n十年裘马走南北，秃发已白归无期。\n悠悠世事春前草，浅碧娇浓岂终好。\n长路峥嵘驽马劳，坐觉今晨色枯槁。\n海内英雄今几人，逢时吐气干青云。\n当前劝酒君莫逆，但硕四海生阳春。\n君不见昨夜天边孤凤鸣，老夫伏枕双涕零。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7838,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花清梦辞与贝廷琚博士同赋","author":"徐贲","text":"愁云淡淡摇碧空，琐窗虚掩闲微风。\n芳魂欲迷疏影乱，满庭细月香溟濛。\n夜景沉沉春漠漠，翠禽啼春春不觉。\n水涩铜龙漏转迟，霜华暗妒青绫薄。\n恼情横玉泣小鸾，画屏残照围素寒。\n起来重觅旧游处，晓烟十二空栏干。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7839,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"海雪词与唐处敬题","author":"徐贲","text":"搏桑亭亭尘帖帖，三山曲连屏样叠。\n冯夷窃得鲛人绡，巧裁六花不用刀。\n琼芳搅空夜迷影，神挟刚风去俄顷。\n马御骨战泣贝宫，咸池冻合乌愁冷。\n回首烟生九点青，冰车飞轮天上行。\n下看荒月斜照城，鼓角未醒鸡无声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7840,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雷雨护婴词","author":"徐贲","text":"少妇抱儿行且迟，雷雨路中忽遇之。\n儿惊欲啼手护儿，道傍逆旅固可依。\n君不见，王凝妻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7841,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂诗六首 其一","author":"徐贲","text":"雄京据咸阳，百二连山河。\n丹楼与翠馆，宫阙高峨峨。\n天中王气集，物象正熙和。\n清晨会轩盖，剑佩鸣相磨。\n侍中复道上，相国九逵过。\n侯王各建邸，甍栋如星罗。\n千金交赵客，双璧聘秦娥。\n荣贵伦许史，功业崇参何。\n勉彼蓬草士，壮志无蹉跎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7842,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂诗六首 其二","author":"徐贲","text":"崔嵬南国山，上有百尺松。\n挺然为良材，枝叶郁茏葱。\n附根一何高，雨露濯以蒙。\n岩峦互参错，危石当其冲。\n匠者徒觊觎，欲取无繇从。\n所以千载间，得免斧凿攻。\n孰云樗散木，天年独能终。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7843,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂诗六首 其三","author":"徐贲","text":"吉士笃古道，狡人饰虚情。\n撝谦信寡过，当任戒持盈。\n叔世俗多变，结交谅匪轻。\n圣主建广业，尚须多士成。\n矧兹下愚质，安可捐交盟。\n奇计固云昧，前筹愧无能。\n立身三十年，岂不志功名。\n屡闻走韩魏，亦欲接群英。\n反侧吾所虑，守已叹孤茕。\n谁能断金义，相与济危倾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7844,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂诗六首 其四","author":"徐贲","text":"木橘何累累，列生湘水湄。\n年多逾繁茂，土地之所宜。\n美人渡江去，分种淮山陲。\n一旦变为枳，遂令木性移。\n勉旃君子操，无为他人隳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7845,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂诗六首 其五","author":"徐贲","text":"飞鸿渡衡湘，游戏寒江浔。\n携群复挈侣，浩荡同浮沉。\n一鸿忽失意，矰缴乃见侵。\n众鸿不忍去，徘徊发哀音。\n悲风何所恶，积水而又深。\n欲渡那不得，徒存恤鸿心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7846,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂诗六首 其六","author":"徐贲","text":"扶桑靡由登，六龙信难挽。\n我何不量力，欲使白日返。\n短景苦相迫，岁节忽成晚。\n虫蛰念在春，木落命归本。\n循环理固然，天道岂云远。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7847,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读史 其一","author":"徐贲","text":"周衰麒麟出，汉末黄河清。\n见之非其时，徒有嘉瑞名。\n古道既缅邈，企慕惟空情。\n茫茫千祀上，此义圣所明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7848,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读史 其二","author":"徐贲","text":"堂坳不容杯，渤澥纳百川。\n大小何乃殊，其量使之然。\n鄙人器易盈，德士心广渊。\n美哉黄叔度，千古称其贤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7849,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]