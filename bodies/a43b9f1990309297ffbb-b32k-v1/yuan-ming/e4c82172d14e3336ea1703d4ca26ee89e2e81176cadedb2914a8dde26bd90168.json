[{"title":"西林八景 其五 流虹冈","author":"陈谟","text":"涌月散金波，流辉动神螺。\n海翁逐鸥戏，孺子濯缨歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13616,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西林八景 其六 喷珠泉","author":"陈谟","text":"满地碎珠玑，向日腾光彩。\n昨梦穷河源，天澄万星海。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13617,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西林八景 其七 藏蛟室","author":"陈谟","text":"福地穴难藏，真人剑拂霜。\n还归贾傅井，应作少年郎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13618,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西林八景 其八 伏鸽冢","author":"陈谟","text":"伏鸽守枯冢，黄金骨似沙。\n化为双白鹤，飞上太清家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13619,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋林","author":"陈谟","text":"秋林本自萎，朔风劳尔怒。\n客子赋无衣，哀鸿夜中度。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13620,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次郊行韵","author":"陈谟","text":"煮茗乐浓春，看山日日新。\n遥知独醒者，却是太平人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13621,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀泮池诸友","author":"陈谟","text":"幽怀落泮池，古柏守朱户。\n美人秀疏髯，望望隔烟雾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13622,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答送暖枕软履 其一","author":"陈谟","text":"暖枕便衰老，尤宜雪夜吟。\n邯郸官道上，谁识吕公心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13623,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答送暖枕软履 其二","author":"陈谟","text":"软履蒙佳贶，平原客未知。\n下邳圯上去，长有一编书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13624,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"快阁脩篁古木图 其一","author":"陈谟","text":"老去张骞两鬓华，乘风曾记到天家。\n回看粉壁千年树，还是银潢八月槎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13625,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"快阁脩篁古木图 其二","author":"陈谟","text":"风流贰令写苍筤，判簿题诗白雪香。\n太守公馀时倚槛，满天风雨起潇湘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13626,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"郦彦诚蕲州 其一","author":"陈谟","text":"青原山下客思家，喜有淮船载月华。\n湖口晴云收雪浪，蕲阳春雨长萱花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13627,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"郦彦诚蕲州 其二","author":"陈谟","text":"郦生风采故依然，奉母还乡鬓尚玄。\n升堂喜见高都护，对酒应怀葛稚川。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13628,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题吴推官江山览图 其一","author":"陈谟","text":"忆昨蓬壶鳌戏翻，卢敖入海澹忘言。\n祗今乱定看图画，几处楼台几曲村。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13629,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题吴推官江山览图 其二","author":"陈谟","text":"汾水秋风草木疏，龙门山色秀芙蕖。\n岩扃容有文中子，高卧白云閒著书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13630,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题吴推官江山览图 其三","author":"陈谟","text":"万竹沉沉山下屋，千波汎汎石根船。\n逢迎沙岸飘萧者，不是玄真定谪仙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13631,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题吴推官江山览图 其四","author":"陈谟","text":"江南秋色雁来归，林壑风烟草树微。\n公退展图频北望，太行山上白云飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13632,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"鄢大善胡琴归宜春求题 其一","author":"陈谟","text":"白下矶头绿树肥，宜春台上白衣归。\n山童把得琵琶在，惆怅开元旧谱稀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13633,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"鄢大善胡琴归宜春求题 其二","author":"陈谟","text":"上国春风马上郎，花间弦索断人肠。\n愿留一曲清平调，别有知音在太常。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13634,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"鄢大善胡琴归宜春求题 其三","author":"陈谟","text":"马尾蛇肤冰茧丝，能吟解语意迟迟。\n弹到天高云净处，秋江唯许白鸥知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13635,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题曲江春游图","author":"陈谟","text":"沙明竹软曲江桥，折水花枝挂酒瓢。\n指点杏园飞赤骥，恼人应是董娇娆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13636,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题渔乐图","author":"陈谟","text":"柳下渔舟小亦宽，两家十口共团栾。\n醉来唱彻渔家傲，千丈风波冷眼看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13637,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题孙竹图赠黄道士归山","author":"陈谟","text":"金华仙客此幽寻，为爱潇湘云气深。\n醉骑白石还山去，一个苍龙伴独吟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13638,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次十四夜望月值雨 其一","author":"陈谟","text":"云翳深深掩玉辉，故飘香雾洒蕉衣。\n竹林莫道蟾宫远，已报郎星入紫微。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13639,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次十四夜望月值雨 其二","author":"陈谟","text":"曾共仙人萼绿华，云中手弄金背䗫。\n嫦娥偏爱清尘雨，徐舞霓裳下汉槎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13640,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次荔支韵赋 其一","author":"陈谟","text":"猩红染就锦苞肥，解映金袍与绣衣。\n几度醉吟芳树下，浑疑夜燎续朝晖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13641,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次荔支韵赋 其二","author":"陈谟","text":"海山仙子玉肌肥，故著轻绡紫雾衣。\n犹记红尘飞骑去，昭阳宫里媚晴晖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13642,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次荔支韵赋 其三","author":"陈谟","text":"磊落华堂火齐肥，佳人争比茜红衣。\n琼枝笑把银瓶插，绝胜春红粲晓晖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13643,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次荔支韵赋 其四","author":"陈谟","text":"正赏端阳荔子肥，珊瑚清映雪罗衣。\n谁向樽前挥綵笔，只今容有谢玄晖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13644,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次参军偶赋韵 其一","author":"陈谟","text":"花底壶蜂报午衙，枕前庄蝶未知家。\n惊人忽听尚书履，唾玉长吟学士茶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13645,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次参军偶赋韵 其二","author":"陈谟","text":"燕莺好语傍南衙，樱笋谁人似故家。\n顿逊并无花上酒，南华还有贡馀茶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13646,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次参军偶赋韵 其三","author":"陈谟","text":"老我犹堪屈宋衙，才名苦忆建安家。\n枯肠文字搜都涩，恨杀松花雪乳茶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13647,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题","author":"陈谟","text":"只合长庚伴谪仙，清吟酷爱夜如年。\n五更钟动无人唤，飞步松梢看月圆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13648,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为知县谢实林题红梅 其一","author":"陈谟","text":"孤山傲雪压芳凉，换得东风到玉堂。\n更聘海棠为侍女，桃花马上少年郎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13649,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为知县谢实林题红梅 其二","author":"陈谟","text":"逃禅染白能为黑，争似王家一剪红。\n忆共扬州何水部，醉吟身入綵霞中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13650,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画龙","author":"陈谟","text":"长吟喷薄浪生花，碧海银潢处处家。\n有客抱琴天上去，回看鳞角似仙槎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13651,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画竹","author":"陈谟","text":"凤尾翛翛雨外分，武公风致少能群。\n七贤最有山王达，底事延平咏五君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13652,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题周知事双竹图","author":"陈谟","text":"一径清风两玉人，画图疑在渭川滨。\n石根细长濂溪草，寒翠满庭长是春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13653,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题青山白云","author":"陈谟","text":"来访仙人问白羊，小桥流水绕微茫。\n白云满谷青松暗，定是金华是括苍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13654,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"焦矶寺","author":"陈谟","text":"过尽三山见翠屏，金银?刹接青冥。\n江心磻石何年化，亦恐飞来是落星。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13655,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题赤壁扁舟图","author":"陈谟","text":"霜清水落不容刀，山石奔云作怒涛。\n海上仙人归玉局，又随孤鹤过临皋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13656,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题曾秋月提点寿竹图","author":"陈谟","text":"羽葆霓旌翳石根，蓬莱云气伴朝昏。\n仙人细酌长生酒，閒看苍龙子又孙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13657,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题周草亭枯木图","author":"陈谟","text":"雪裂悬崖堕一龙，槎牙长碍九霄风。\n若为借与张骞去，身到银潢咫尺中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13658,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题王子贤云樵山房 其一","author":"陈谟","text":"官閒日日逐樵苏，心寄浮云乐有馀。\n谷口归来身未倦，下帘细读买臣书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13659,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题王子贤云樵山房 其二","author":"陈谟","text":"王质当年底事痴，斧柯烂后觅归蹊。\n君歌一曲下山去，不向仙人局上迷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13660,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题竹赠石城主簿倪仲威","author":"陈谟","text":"越王台下送飞艎，折赠琅玕百尺长。\n归到石城官舍冷，月明四壁动龙光。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13661,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题墨龙赠化州经历徐子重","author":"陈谟","text":"徐福仙人海上家，苍龙相对卧烟霞。\n乘风欲向丹霄去，还是张骞八月槎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13662,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南康仙台观吕岩尝游焉观中人不识也死?其山后一道人来寻师启棺惟二白石化为双鹤飞去今所画岩像特异所见手持钱一文","author":"陈谟","text":"赏遍罗浮度庾关，仙台重访羽人閒。\n已收白鹤归天上，犹把金钱玩世间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13663,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"风树亭临江经历潘德全进士其父葬海宁之彭坡待制赵仲睦为书树亭赋二绝 其一","author":"陈谟","text":"得禄其如退养何，海宁墓木拱彭坡。\n清江碧嶂官居好，时听悲风响树柯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13664,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"风树亭临江经历潘德全进士其父葬海宁之彭坡待制赵仲睦为书树亭赋二绝 其二","author":"陈谟","text":"墨妙谁题枫树亭，翰林待制有仪型。\n九原含笑应无憾，更待焚黄换刻铭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13665,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题四皓图","author":"陈谟","text":"卧听松风行采芝，人间那记有秦时。\n安刘调笑高皇帝，何似山中一局棋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13666,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗五首 其一","author":"王翰","text":"空堂霜气肃，落木集已多。\n墙阴数丛菊，岁晏承阳和。\n寘卷下堂行，自爱颜色佳。\n掇英汎浊醪，为我驻年华。\n渊明已黄土，幽姿徒尔嘉。\n惆怅南山上，千载空烟霞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13667,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗五首 其二","author":"王翰","text":"清风汎栏楯，明月耿房帷。\n夜永草虫吊，天长鸿雁悲。\n容华渐销铄，阳景空中驰。\n宝剑光陆离，白马黄金鞿。\n丈夫贵循名，讵以别离为。\n含情掩瑶琴，涕泗空涟洏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13668,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗五首 其三","author":"王翰","text":"日暮洛阳道，北山正嶕峣。\n高坟望累累，岁久青松凋。\n为问葬者谁，云是汉唐朝。\n龟龙卧深草，文字半沉销。\n凄风扑霜叶，阴云惨寒郊。\n颓垣隐狐?，荒棘鸣鸱鸮。\n千载雍门琴，令人涕泪交。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13669,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗五首 其四","author":"王翰","text":"夷齐千载后，西山淡无姿。\n贤人千载生，空林老蕨薇。\n青青庙前柏，高高堂下碑。\n空山阅今古，同与天地摧。\n倜傥鲁连子，抱义不逢时。\n片言为解纷，尺素杀军师。\n耻秦誓蹈海，辞赵非金为。\n颓波无回流，砥柱高崔嵬。\n芳名在简策，壮士饮风仪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13670,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗五首 其五","author":"王翰","text":"今日天气佳，曳杖出衡门。\n凉露湿芒屦，清风感帨巾。\n幽鸟避人飞，游鱼畏钓沉。\n蛛丝映空张，饥隼号北林。\n恶彼机事深，安能降我心。\n归来遣世虑，浊酒聊自斟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13671,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"思山吟","author":"王翰","text":"南山有松树，托根白云岑。\n枝叶冒霜雪，不易太古心。\n我昔来结茅，相对岁月深。\n轻花酿春酒，寒声杂清琴。\n野马被羁鞅，沐猴强冠簪。\n华靡非其心，动践所不任。\n我罪非所得，脱身事幽寻。\n归来治田畴，损物犹蟊蟫。\n矫首望故山，白雨翳青林。\n首丘匪可忘，治任须及今。\n往从荷蓧徒，永与世幽沉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13672,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"牧羊","author":"王翰","text":"羔羊不受秣，呦呦索晨牧。\n稚子惧出门，动与虎狼触。\n垂鞭不敢前，常向风雨哭。\n我老轻其生，仗策入幽谷。\n原平散漫食，径狭相追逐。\n霜馀野草白，沙寒山水绿。\n荒磴随渔樵，深林杂麋鹿。\n读书坐磐石，摴蒱向皋陆。\n为感蒙庄言，归涂不可暮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13673,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"黄河曲","author":"王翰","text":"行吟散郁积，日暮黄河曲。\n黄河昆崙来，万里经平陆。\n西北限秦晋，东南走梁宋。\n龙门夜雨深，砥柱秋涛横。\n鼋鼍时出没，鲸鲵相簸弄。\n艰险自天设，万骑安所用。\n人事多乖迕，山河有变更。\n孝武宣房歌，千载有馀清。\n朱梁白马祸，草木动悲鸣。\n圣人总四溟，天地还清宁。\n河当一澄彻，因之作颂声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13674,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"示子砺","author":"王翰","text":"我家本燕云，皇考昔膴仕。\n门户早单弱，田园久废寘。\n中原丧乱频，骨肉不得恃。\n兄弟弃草野，松楸作平地。\n今我虽偶存，贫病苦交至。\n有尔且煖眼，嗣续得不坠。\n富贵人所愿，诗书须尔事。\n头角似稍长，难以杂童稚。\n玉琢终待磨，木揉后成器。\n寸阴必自惜，前脩可追跂。\n数数恐伤恩，斯言尔当志。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13675,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋蝉抱叶而吟叶脱而堕困于群蚁亟遣仆置高树且怜而作诗吊之","author":"王翰","text":"一气无停机，四时仍代用。\n万物生两间，潜植与蠢动。\n时至靡不荣，运往讵所恸。\n蝉生粪壤间，潜化自能羾。\n登木喜得时，鸣响甚恣纵。\n既免螳螂搏，幸脱痀瘘中。\n或学秦筝鸣，或作雅琴弄。\n或缓美人歌，或繁小子诵。\n或静而独鸣，或聚而相哄。\n不料瓮内鸡，遽儗竹上凤。\n凉飔一朝发，繁霜藉草重。\n强鸣声噎塞，处危心愡恫。\n所付既靡盬，脱落难持控。\n高蜚翅剪铩，不饮腹空洞。\n局促尘埃中，蚁困况集众。\n我行庭树间，见之心为痛。\n呼儿置深稳，聊尽尔馀哢。\n作诗予时哉，含悽不成讽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13676,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题管鲍论交图","author":"王翰","text":"黄金是何物，能摧壮士心。\n有金交契厚，有金交意深。\n一朝金用尽，相看同路人。\n古人重交道，敬至义自伸。\n我观管鲍徒，交厚情最亲。\n知心两无猜，巽让常欣欣。\n斯可愧薄俗，外物非所珍。\n子鱼能一掷，幼安同浮尘。\n弃之同一道，中有伪与真。\n高风鲁连子，千载名如新。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13677,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"初冬述怀","author":"王翰","text":"东风作雪意，竹窗寒策策。\n老鸱向晨鸣，饥鼠当昼嚇。\n不爨米瓶空，止饮酒樽侧。\n妻子色悽凉，吾心自安适。\n前途有风雪，行路黑如漆。\n貂裘重不煖，素颜惨无质。\n吾生抱大拙，默坐永朝日。\n鹤长与凫短，天性为至佚。\n化工谅均平，守玄保真白。\n诵诗晤童子，或当发蒙密。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13678,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"关山蚤行图","author":"王翰","text":"早起去山店，鸡鸣月在天。\n瘦马恋残刍，仆夫烦力牵。\n山外有畏途，石粗履几穿。\n行行二十里，彷佛闻炊烟。\n林间宿鸟散，摇荡露漙漙。\n迟明据鞍睡，梦里到长安。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13679,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读韩信传","author":"王翰","text":"有功当记录，有罪当准理。\n忘功治其罪，汉祖少恩耳。\n不忍一身诛，况及三族死。\n千载胡公言，为雪泉下耻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13680,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读仪秦传","author":"王翰","text":"强秦奋关中，六国环恣睢。\n西上望函谷，壮士不能踰。\n地开天府险，法仿申韩馀。\n治道既出下，民性皆异趍。\n彼哉苏张徒，挟诈从横书。\n捭阖中时议，三寸挠万夫。\n韩赵弗敢违，齐楚从其驱。\n车骑颇张皇，威焰烜赫如。\n最缓来踵迹，代衍还连茹。\n轲也论王道，妾妇明其狙。\n周纲既陵替，秦治非远图。\n土地何其贪，生民何其辜。\n兵甲日以縻，膏血日以涂。\n至今载简册，庄士长不愉。\n斯人在三代，谗口伏显诛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13681,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]