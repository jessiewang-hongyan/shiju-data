[{"title":"晓发松江","author":"陶宗仪","text":"客里东风促去程，沙棠舟小布帆轻。\n冲人鸥鸟双双起，近水桃花树树明。\n故喜吴淞堪寄食，不愁江汉尚屯兵。\n经纶事业成虚掷，一寸葵心向日倾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4310,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次邵冠军客中见寄韵","author":"陶宗仪","text":"重关列戟迟行舟，小雨吹烟凝不流。\n时迓檄书传帅命，数呼官酒破诗愁。\n江城已击扶摇上，海宇还期汗漫游。\n春树重重云莫合，怀人多在驿西楼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4311,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"皆梦轩为陈汝嘉赋","author":"陶宗仪","text":"北窗高卧羲皇上，不比南柯太守衙。\n尘世蕉阴方覆鹿，山童竹里自敲茶。\n黄粱旅邸空仙枕，春草池塘即谢家。\n万事转头同一幻，怪来筠管忽生花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4312,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶成简钱曲江","author":"陶宗仪","text":"坐看凉月上溪楼，桐叶晶荧露气浮。\n恋阙近瞻天北极，怀亲遥隔海东头。\n寓形宇内一身老，濯足沧浪万里流。\n安得神飙驾轻毂，白云直下即丹丘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4313,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄赠叶子澄","author":"陶宗仪","text":"平生不受官长骂，结屋乃在深郊居。\n田无二顷每种秫，日有百钱惟买书。\n养亲上堂具甘旨，留客煮饭挑嘉蔬。\n怜君行义有如此，名誉岂肯终阎闾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4314,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次谢士英韵","author":"陶宗仪","text":"郊原十里非凡境，屋宇无多似瀼西。\n新竹长来吟径小，绿杨缺处画桥低。\n茶浮石鼎儿新煮，诗满云笺手自题。\n乘兴看山出林麓，短筇一个影清溪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4315,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春雨初晴沈野亭见访","author":"陶宗仪","text":"九十日春浑有几，相将一半雨兼风。\n草堂晴旭生虚白，花径儿童扫落红。\n漫喜故人来泗北，更期后夜宿山中。\n青鞋布袜须吾辈，百遍相过意未穷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4316,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次夏士良户侯韵","author":"陶宗仪","text":"竹里茅茨白板扉，兴来随意卧牛衣。\n天笼平野前山远，水拍危桥过客稀。\n钓罢得鱼沽酒去，雨馀种豆荷锄归。\n故人却在城南住，日日清觞四坐飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4317,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋怀次夏停云韵","author":"陶宗仪","text":"妖氛澒洞逼京华，将略时无李左车。\n休唱贞元供奉曲，似闻商女后庭花。\n职方未复江南贡，使者空乘海上槎。\n自古和边真拙计，却令红粉泣琵琶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4318,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送陈平仲","author":"陶宗仪","text":"我居巷南子巷北，同是挈家来避兵。\n故园荆榛已能理，远道虎豺那可行。\n老怀作恶辄数日，寒溪送别伤离情。\n未知后会更谁好，斫鲈且醉双银罂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4319,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读史次谢元素韵","author":"陶宗仪","text":"长时读史白云西，往事评来手自题。\n亮也已亡谁相汉，单云多智国存齐。\n百川行地终归海，五纬经天未聚奎。\n堪叹洛阳宫外路，铜驼荆棘夜乌啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4320,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"乐静草堂为卫叔静赋","author":"陶宗仪","text":"屋绕芙蓉九叠屏，日长客去掩閒庭。\n岩花煖傍疏帘落，阶草晴分汗简青。\n温火试香删旧谱，汲泉煮茗续遗经。\n江南定有徵贤诏，太史方占处士星。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4321,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵荅杨廉夫先生","author":"陶宗仪","text":"移家正在小斜川，新买黄牛学种田。\n奏赋不骑沙苑马，怀归长梦浙江船。\n窗浮爽气青山近，书染凉阴绿树圆。\n乐岁未教瓶有粟，全资芋栗应宾筵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4322,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜坐","author":"陶宗仪","text":"披衣散发坐南荣，漏点迟迟欲二更。\n风约沼萍云影淡，月栖径竹露华明。\n石床凉意浮珍簟，宝鼎沈烟喷玉笙。\n世虑不关心似洗，此身只觉在蓬瀛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4323,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花坞","author":"陶宗仪","text":"溪北溪南十万枝，洞门深锁几人知。\n月香水影无多语，姑射罗浮自一奇。\n千里喜传春信早，孤筇偏爱夕阳迟。\n殷勤更入坡仙咏，共补辛夷别墅诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4324,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"守岁次谢高洁韵","author":"陶宗仪","text":"明日五更才是春，坐深不觉漏声频。\n风尘澒洞向今夕，灯火团栾能几人。\n老去清霜吹鬓发，愁来双泪落衣巾。\n乾坤扰扰皆兵甲，何处溪山著此身。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4325,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"机山怀古次赵廷采韵","author":"陶宗仪","text":"昭侯功业在人间，二俊文章若可攀。\n西洛竟从王囧辟，秋风不遂季鹰还。\n平原村迥家山静，华表云深鹤梦閒。\n有客舣舟来吊古，空林落叶雨潸潸。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4326,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"长至日林泉偕雪林踰凤冈访友联句次其韵","author":"陶宗仪","text":"凤皇飞舞结青山，九曲云林第一关。\n轻棹每从溪口去，短蓑长自岭头还。\n初阳消息升沈里，二老襟怀啸咏间。\n此地正堪颐莫景，采芝厎用蹑商颜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4327,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"催梅为雪林作","author":"陶宗仪","text":"的皪孤标隔水湄，我家庭馆见何迟。\n喜迎春信无多日，英负东风第一枝。\n湖曲老逋魂定返，罗浮仙子梦曾期。\n短筇立待黄昏月，嗅得寒香便赋诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4328,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"代梅荅","author":"陶宗仪","text":"向煖南枝趁早开，让渠独占百花魁。\n与时无竞缄春在，感子相思索笑来。\n吹笛且休明月厎，煮茶宜傍白云隈。\n老予不比桃和杏，直要鼕鼕羯鼓催。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4329,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次景讷庵韵送廷采","author":"陶宗仪","text":"传家留得旧青毡，旅食西州五十年。\n老去秪知怀故国，晓来生怕送归船。\n九山影落三江口，丹杏花开二月天。\n最是东风双语燕，留人飞过酒尊前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4330,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"先照楼为玉无瑕上人题","author":"陶宗仪","text":"若木枝头耀烛龙，寅宾先与最高峰。\n光明遍照三千界，楼阁宏开第一重。\n举目心徵香水海，至诚膜礼紫金容。\n五时说法如亲听，向上圆机不露锋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4331,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"听雪为孙以贞赋","author":"陶宗仪","text":"瑶池阿母教飞璚，细捣冰花拥佩旌。\n郭索行沙林竹偃，吴蚕食叶纸窗明。\n短编清夜谁家读，柔橹寒溪远处声。\n闭户先生俄侧耳，松涛沸起煮茶铛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4332,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"八月十五夜玩月次韵","author":"陶宗仪","text":"高捲湘帘看明月，一年今夜十分嘉。\n露华清洒玉毫兔，林影还浮金背蟆。\n太液池台当更好，广寒城府望非赊。\n据床老子婆娑在，啸咏欢娱孰有涯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4333,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次胡别驾韵寄李仪曹至刚","author":"陶宗仪","text":"皇帝徵除赞礼曹，御炉烟染越罗袍。\n太微垂象郎星近，仙步趋朝地位高。\n夙夜寅清宗秩祀，仪文开朗列英髦。\n嗟余白发怀思日，孤鹤长鸣在九皋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4334,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"小园即事次胡广文若思韵","author":"陶宗仪","text":"日长童仆理蔬畦，官舍如同隐者栖。\n新水方塘鱼在藻，落花小雨燕衔泥。\n杯盘留客儿能奉，琴册娱心手自携。\n满纸文章新洒翰，人人争道外孙齑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4335,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绯桃次韵同前","author":"陶宗仪","text":"凝脂近水骋芳姿，刘阮从来见事迟。\n血写妖猩衣灿烂，燄融烈火锦昌披。\n寿同西母还丹日，笑倚东风醉酒时。\n绝胜渡江颜色浅，英名久入彦谦诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4336,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"万竹林为鹤砂于廷立赋","author":"陶宗仪","text":"渭川壤地栽千亩，海上云林长万竿。\n晋室一时人旷达，尔家三径日平安。\n琅玕响激秋声早，翡翠阴团雨气寒。\n裹茗敲门容借看，清风吟啸对檀栾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4337,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日次韵","author":"陶宗仪","text":"今年九日还为客，朋旧壶觞兴趣同。\n雁影江头清浅处，龙山天际有无中。\n黄花细吐香堪采，白发高歌气不充。\n醉把茱萸怀弟妹，异乡飘泊已成翁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4338,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"张林泉九日寄诗次韵荅之","author":"陶宗仪","text":"耕田凿井水南郊，懒性从来谢拔茅。\n草檄未能行虎落，濡毫敢望立螭㘭。\n菊萸并进重阳节，萍水相亲远道交。\n岁岁兹辰动怀想，若为对饮共山肴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4339,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"新寒写怀次韵","author":"陶宗仪","text":"世故漫漫混渭泾，九山高枕卧云屏。\n摊书雾拂双眸瑩，揽镜霜欺两鬓青。\n归燕凄凉谁复顾，吟蛩哀怨不堪听。\n秋风落木茅茨破，坐右高县陋室铭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4340,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"壬申十二月廿九日林泉抱拙伯仲万山别驾同宿三味轩得何字","author":"陶宗仪","text":"岁晏高朋忽我过，诸生尊俎罄欢歌。\n老来短鬓因愁改，醉后衰颜为酒酡。\n灯影未随云影淡，漏声不似雨声多。\n明朝约共寻梅去，屐齿泥深可奈何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4341,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"立春次韵","author":"陶宗仪","text":"历降灵台一岁新，气调玉烛万方春。\n候灰浮动轻于雪，腊酒倾来白似银。\n花胜乱簪人斗巧，菜盘新簇齿生津。\n寻芳早晚如相约，便整肩舆继后尘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4342,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨窗会饮分韵得鸡字","author":"陶宗仪","text":"南亩躬耕水一犁，夜来风雨正凄迷。\n华筵盛集书相拉，白绢斜封手自题。\n宾客不分床上下，杯盘尽出玉东西。\n太平深野宜欢乐，还忆都门晓听鸡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4343,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和琴清万山五日雨窗酌酒赋诗韵","author":"陶宗仪","text":"睡馀閒把离骚读，白发星然一老身。\n五采谁缠长命缕，赤符不上小乌巾。\n兰汤滑凝芳华冽，丹臼香融药草新。\n帘卷琴清轩外雨，蒲觞酌客更情亲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4344,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夏原舟寄诗求撰其先子墓铭次韵荅之","author":"陶宗仪","text":"男儿不必叹流离，治世麒麟可系羁。\n好句自堪横槊赋，壮怀莫为听琴悲。\n迢迢远道江南梦，念念双亲垄上碑。\n此日勒铭当不愧，行藏颠末我曾知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4345,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠良介庵上人","author":"陶宗仪","text":"开士传来竺国灯，蓦然悟道在闻声。\n鲸音宝梵岩花落，垆篆蒲团海月生。\n静扫六尘无染著，要观一性本圆明。\n何时借我袈裟地，试把宗乘与细评。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4346,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"化城寺悟本心上人有轩修竹中今寺与轩幻为劫灰瓶锡游方自号竹轩志不忘也","author":"陶宗仪","text":"此君劲节保平安，坏衲幽居寄懒残。\n一榻清风敷具坐，四窗凉雨卷帘看。\n梵馀瑟瑟笙箫荅，定起沈沈翡翠寒。\n长作化城安隐想，眼前随处碧琅玕。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4347,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送潘贡士鲁玙","author":"陶宗仪","text":"东风拂曙泮林春，行李观光上国宾。\n岁贡成材虽有格，旦评雅望妙无伦。\n帆浮翠縠江波滟，马控青丝柳色新。\n此去辟雍天咫尺，早持钧轴见经纶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4348,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送人才殷惟中","author":"陶宗仪","text":"春水绿波春草碧，春风一棹发江城。\n到京便入人才选，荐剡连排父老名。\n朋旧称扬多义举，衣冠惜别重交情。\n此行喜遂平生志，簪绂荣身感圣明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4349,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"甲戌元日次韵","author":"陶宗仪","text":"守岁垆边烛尚明，家家箫鼓杂钟声。\n紫霄散彩晨光发，元日开祥淑气生。\n万丈赤城怀复眺，千丝白发喜还惊。\n老来但博身强健，诗酒朋游慰客情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4350,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送吕仲徵知县之官武平","author":"陶宗仪","text":"明经擢第下金銮，题赐宫罗墨未乾。\n早岁喜詶尊主学，长才先试牧民官。\n银章朱绂三千里，白舫青帘五百滩。\n一县花开琴调古，伫听趣召入朝端。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4351,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题颜近仁清风卷","author":"陶宗仪","text":"高栋曾轩頫涧阿，此君挺挺翠骈罗。\n写真缣素襟期合，相与冰霜节操多。\n鸾牡遄归周甫诵，蓬莱何处玉川歌。\n门前应用开三径，自有故人时一过。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4352,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题朱文仪松轩清赏卷","author":"陶宗仪","text":"五鬣离离翠作行，四檐奕奕住中央。\n签裁象齿尊经史，帖护芸晖宝晋唐。\n点易研朱朝滴露，题诗握管昼焚香。\n开庭亦有风来处，不及君家意味长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4353,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠乐安居士张彦载","author":"陶宗仪","text":"治世优游赋考槃，葛衣藜杖笋皮冠。\n清溪一曲居常乐，红日三竿睡正安。\n花外雨窗篘蚁酝，竹间风鼎瀹龙团。\n到头浑是清閒福，笑引儿孙种合欢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4354,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题王孟京先生采芝生卷","author":"陶宗仪","text":"高风千古仰商颜，自喜幽栖近九山。\n短锸每从层巘陟，顷筐长带乱云还。\n晴霞煖护金茎紫，晓露香融玉朵殷。\n辟谷延年端藉此，飘然行簉列仙班。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4355,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赏牡丹次萧古斋韵","author":"陶宗仪","text":"万卉千葩推第一，天然国色谢铅华。\n沈香亭对殊堪匹，金带围成未足誇。\n宿露煖风滋绛蜡，曲阑轻幄障晴霞。\n尊罍燕赏加题品，格调清新是作家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4356,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵送张处善归枫溪","author":"陶宗仪","text":"慨世浮名散若烟，喜君浩气直如弦。\n兵戈避地三江曲，湖海论交廿载前。\n夜雨漫怀扬子宅，早潮催发米家船。\n枫林渺渺晴云外，此去添予别绪牵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4357,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"代赋借鹤","author":"陶宗仪","text":"香霭瑶坛恭蒇事，帝真幢节控神飙。\n朱陵紫府传丹检，白鹤青鸾下碧霄。\n翅影乱随幡影飏，吭音浑与玉音调。\n众眸瞻睹同称赞，孰谓仙禽不可招。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4358,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"中秋对月有感","author":"陶宗仪","text":"我室曾烦月照帏，今年此夕认清辉。\n芳时一去无繇返，皓首同归与愿违。\n谯漏声传人寂历，胡床影矗露霏微。\n碧霄如水连银汉，好洗浮生万事非。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4359,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"又次冰雪翁韵","author":"陶宗仪","text":"碧空湛湛露华清，万籁沈沈一鉴明。\n节序俄惊今夕是，光阴只使老怀惊。\n杯盘小酌双瓶尽，宾主高谈四坐倾。\n童子煮茶来报说，莲花漏刻已三更。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4360,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送万用谦归豫章","author":"陶宗仪","text":"阿兄司臬莅松城，令弟辞家赋远行。\n吴楚相望萦别恨，埙篪迭奏蔼亲情。\n山头晓月长亭小，江上秋风一舸轻。\n杨柳条疏不堪折，频频劝酒待潮生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4361,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题翟景泉空空室","author":"陶宗仪","text":"都门此日寄高踪，僦屋通衢岂讳穷。\n四壁萧然无长物，八窗豁处有清风。\n居安养拙蘧庐若，绝念忘形幻泡同。\n方寸虚灵元不昧，漫从释部话空空。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4362,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪中偶成次书庄叟韵","author":"陶宗仪","text":"瑶池阿母试鸾刀，剪碎冯夷白战袍。\n琪树千林清可揽，玉厓万丈势弥高。\n越笺题句披蝉翼，建盏行茶沃兔毫。\n却笑堆成狮子样，街头便可怖儿曹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4363,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和山翁寒夜竹所宴集韵","author":"陶宗仪","text":"西湖雪里唤相宜，欲约重游未可期。\n岁月匆匆多契阔，杯盘草草足委蛇。\n金荷烧烛光逾粲，石鼎联诗句益奇。\n老子婆娑嗟莫预，买花载酒不为迟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4364,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"立春次韵","author":"陶宗仪","text":"迎春饯腊此辰兼，畅饮何愁酒价添。\n春菜青青敷甲拆，枯荄短短绽包尖。\n银幡斗巧应须赐，玉烛调和不用占。\n晴日煖风春信早，千红万紫竞秾纤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4365,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"除夜次韵","author":"陶宗仪","text":"岁律才圆已戒程，满家守饯历深更。\n驱傩队列籸盆艳，爆竹声扬玉漏清。\n粻糗车船穷鬼事，杯盘灯火异乡情。\n徘徊不觉东方白，箫鼓喧阗到处鸣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4366,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丙子元日次韵","author":"陶宗仪","text":"帝车揭柄夜司寅，凤历颁年气象新。\n元日舒长开正始，东风扇煖逗阳春。\n剡桃作版神如在，列炬为城迹已陈。\n笑把屠苏随后饮，南村我是老天民。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4367,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"莫春分韵得青字","author":"陶宗仪","text":"轻寒轻煖夜来晴，鴶鵴催耕语不停。\n清沼满浮春水碧，绿阴浓带远山青。\n无双美酝玻璃盌，第一名花翡翠屏。\n欲驻芳轮无上策，匆匆离思短长亭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4368,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"水西耕隐为林彦祥赋","author":"陶宗仪","text":"西畴膴膴水泠泠，小结茅茨也自清。\n白蠹简编风外读，乌犍蓑笠雨中耕。\n休官彭泽惟陶令，行义安丰有董生。\n九月筑场禾稼熟，献羔祭韭乐升平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4369,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]