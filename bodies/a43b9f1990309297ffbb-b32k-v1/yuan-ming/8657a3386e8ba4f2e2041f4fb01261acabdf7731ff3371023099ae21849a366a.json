[{"title":"送别沈德虔","author":"徐贲","text":"江声千里万里，客路长亭短亭。\n后夜相思何处，芦花明月沙汀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10525,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"墨梅 其一","author":"徐贲","text":"月落山空人静，梦断碧窗烟冷。\n幽香何处消沉，留得一梢寒影。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10526,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"墨梅 其二","author":"徐贲","text":"素质却嫌脂粉，蛾眉淡扫玄霜。\n翰墨玉堂曾侍，砚池犹染馀香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10527,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江边秋柳","author":"徐贲","text":"画船忆得渡江滨，柳色风光烂熳春。\n今日霜条看渐短，也知不是为行人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10528,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"陆云","author":"徐贲","text":"入洛徒闻擅美谈，诸王正尔恨相衔。\n独怜蔡克频垂泪，难洗当时孟玖谗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10529,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"婕妤怨","author":"徐贲","text":"释罪犹能得赐金，弃捐诚不是君心。\n重来莫负秋风扇，若在昭阳怨更深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10530,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春怀次韵杨署令 其一","author":"徐贲","text":"长把新诗花下吟，看花谁念少年心。\n今朝独到西园里，杏色桃花懊恼深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10531,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春怀次韵杨署令 其二","author":"徐贲","text":"柳条处处线毵毵，只在离亭便不堪。\n几度看花并送客，暖风晴雨到江南。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10532,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"有约看杏花答高季迪","author":"徐贲","text":"雨阻花期可便休，明朝也合为春游。\n閒行若待天晴去，只恐花飞人又愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10533,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九月八日菊同高季迪赋","author":"徐贲","text":"黄菊移来雨后新，含香敛色待芳晨。\n今朝相对谁怜我，明日来看剩有人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10534,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"瓶中插黄白红菊花","author":"徐贲","text":"浅白深红间淡黄，重阳已过尚联芳。\n莫因颜色分花品，同是秋风一样香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10535,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"咏芙蓉送朱仲垣归越","author":"徐贲","text":"雨晴送客柳塘西，野水芙蓉满大堤。\n一路看花何处好，楼船直到若耶溪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10536,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵答王七隅","author":"徐贲","text":"处处斜阳木叶飞，秋风偏在路人衣。\n相逢莫问离家日，燕子初来今又归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10537,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟中闻歌呈张文学","author":"徐贲","text":"水郭春寒雨渺茫，歌声何短意何长。\n邻舟多少南行客，若个听来不断肠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10538,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"閒行 其一","author":"徐贲","text":"草香樵径多晴蝶，桑老人家有夏蚕。\n信道绿阴时节好，閒从山北过山南。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10539,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"閒行 其二","author":"徐贲","text":"绿树黄鹂处处山，偶从溪上看云还。\n人生未许全无事，才得登临便是閒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10540,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜坐","author":"徐贲","text":"夜静讴声隔浦听，西岩孤绝障秋冥。\n扁舟独坐湖天阔，叠叠风漪淡淡星。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10541,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"咏三虫 其一 萤","author":"徐贲","text":"龙舟一去汴河东，空吐馀光表寸衷。\n此夜不堪秋寂寞，景阳宫阙又西风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10542,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"咏三虫 其二 蝶","author":"徐贲","text":"花开心事已蹉跎，每怨春多恨转多。\n赖有黄花相慰籍，不知风雨又如何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10543,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"咏三虫 其三 蝉","author":"徐贲","text":"愁断齐奴一寸心，谁知青女怨犹深。\n长吟莫恋宫前柳，黄叶秋风自不禁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10544,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"野亭读书图","author":"徐贲","text":"书声流水共泠泠，落木寒山路隔汀。\n不是秋来易伤感，夕阳风景似新亭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10545,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"水仙梅花","author":"徐贲","text":"每忆松林月下人，却随游女汉江滨。\n陈王若作罗浮梦，不独当时赋洛神。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10546,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"菊竹梅竹 其一","author":"徐贲","text":"绿竹黄花共一丛，楚江日照自西风。\n屈原放逐娥皇杳，千古离愁此日同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10547,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"菊竹梅竹 其二","author":"徐贲","text":"梅花澹澹自开残，水国春迟雪未乾。\n不有竹枝相倚并，如何禁得许多寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10548,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"画马 其一","author":"徐贲","text":"拳毛零落暗尘埃，何似春风立仗回。\n当日外番初进奉，不知传敕赐谁来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10549,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"画马 其二","author":"徐贲","text":"亲曾调马动天颜，看遍东风十二闲。\n今日写真图画里，一双龙骏在人间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10550,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"画马 其三","author":"徐贲","text":"立仗归来出御堤，圉官为解锦障泥。\n春流芳草无人渡，得向东风自在嘶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10551,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨馆有述","author":"徐贲","text":"满矶秋叶草堂閒，窅窅飞鸿淡淡山。\n风雨不堪空对酒，家僮偏喜得鱼还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10552,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠陈相士电岩","author":"徐贲","text":"驴背西风两鬓寒，老怀频藉酒杯宽。\n道傍亦有新丰客，醉里逢人莫易看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10553,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送客至东迁精舍次董著作韵","author":"徐贲","text":"竹边僧舍柳边池，谁道秋风此别离。\n今夕扁舟闻雁处，一灯应读卷中诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10554,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题亡友叶梓素所作山水","author":"徐贲","text":"任昉台前记别离，阖闾城外哭君时。\n今朝孤馆看图画，万水千山不尽思。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10555,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"石屏","author":"徐贲","text":"白鹤山中采石归，绮云翠雨满春衣。\n补天千古无遗法，我欲因君问女希。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10556,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"烟柳","author":"徐贲","text":"烟中柳色重还轻，髣髴时闻百转莺。\n看处不须重怅恨，若教含雨更伤情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10557,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"壶中绯碧桃花碧谢以梨花补之赋以慰绯桃","author":"徐贲","text":"准拟春深相并开，如何先自委苍苔。\n凭君不用多愁怨，又有梨花作伴来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10558,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚寻王隅隐居","author":"徐贲","text":"君住湖南水竹深，夕阳孤棹此相寻。\n子规啼散门前柳，漠漠春光淡淡阴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10559,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中","author":"徐贲","text":"看花长是恼离心，欲看无花思更深。\n惆怅西园桃杏树，花开多半在春阴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10560,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"午日西庵雨中对榴花","author":"徐贲","text":"麦寒已过又梅寒，此日端阳独倚栏。\n谁道榴花能照眼，斜风小雨不禁看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10561,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"折花背立二美人图 其一","author":"徐贲","text":"女伴今朝出较迟，独来园里候多时。\n对花可是无言说，懊恨春风许自知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10562,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和杨署令杂诗二首 其一 寝斋萤火","author":"徐贲","text":"微燄还凭腐草生，拂帏透隙似含情。\n竹风池上虽多见，不及房中照独明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10563,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和杨署令杂诗二首 其二 蜘蛛补网","author":"徐贲","text":"圆网才亏补又完，几回费力绕檐端。\n只愁明日风和雨，未信当空住得安。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10564,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"回文次孟载韵","author":"徐贲","text":"秋风晚静木花红，叶落閒阶满院空。\n楼映月低人寂寂，愁多怕见独飞鸿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10565,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"兵妇归七日夫卒乃抱骨赴水逸其姓名因为之赋","author":"徐贲","text":"托身未稳忽成空，恩爱都来七日中。\n不遣此身随骨去，人间水底更谁同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10566,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题张来仪怀友诗后 其一","author":"徐贲","text":"乱前草草别相知，乱后风光不尽思。\n惟我与君今日见，不堪来读卷中诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10567,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题张来仪怀友诗后 其二","author":"徐贲","text":"重读浔阳怀友诗，众中多是我相知。\n秋风落木乡园外，可有人能为我思。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10568,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答高季迪酒醒闻雨 其一","author":"徐贲","text":"高城月黑罢鸣笳，寝舍风多烛易斜。\n醉里归来忘夜半，雨中惊不似山家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10569,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答张来仪见慰丧子顺哥","author":"徐贲","text":"每忆当年梦臼炊，如今又赋杏伤诗。\n众中独有君相念，知得君曾有此悲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10570,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵偶感 其一","author":"徐贲","text":"新浴兰汤重理妆，佩声隐约碧罗裳。\n寻常不为春风妒，谁信相逢也断肠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10571,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵偶感 其二","author":"徐贲","text":"意中已解眼中怜，谁道从前不有缘。\n可惜花时正风雨，相逢只为在楼前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10572,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵偶感 其三","author":"徐贲","text":"翠袖寒禁梦里秋，玉容不解旧风流。\n谁知独客深无意，珍重萧娘莫浪愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10573,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"六月见榴花","author":"徐贲","text":"绛英绿叶斗炎光，艳色无多出女墙。\n欲借一枝来照眼，看时恨不在端阳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10574,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"弃瓢卧雪 其一","author":"徐贲","text":"曾谢人间轩冕荣，一瓢何足累高情。\n已知喧寂相忘久，弃掷元非为有声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10575,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"弃瓢卧雪 其二","author":"徐贲","text":"空林有雪人犹卧，破屋无烟门未开。\n多少洛阳城里客，如何县令独能来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10576,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"慰吴允坚丧妾","author":"徐贲","text":"肠断琵琶曲里声，绿云天远不胜情。\n归家玉板休轻触，鹦鹉能呼旧日名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10577,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登东皋亭答季迪","author":"徐贲","text":"夕阳亭上共题诗，却忆西行独咏时。\n不但寒云与寒水，楚天无物不成思。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10578,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"东丘兰若枇杷花","author":"徐贲","text":"梅未含英菊罢花，眼中无物属诗家。\n忽来僧舍闻香住，却见花开是枇杷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10579,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登白莲寺阁和彦正季迪见怀","author":"徐贲","text":"远烦二子念离深，江阁斜阳每对吟。\n岂料诗中千里客，也能来此共登临。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10580,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠杜彦正儿端端","author":"徐贲","text":"新诗诵得客听欢，体弱尊前学拜难。\n眉目清妍宛如画，佳名只合叫端端。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10581,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"见端端有感因呈彦正","author":"徐贲","text":"贫贱怜君总不知，膝前且得弄佳儿。\n我来一见偏伤感，千里还家看有谁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10582,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江上偶见","author":"徐贲","text":"潮满江沙起鹭鸶，雪花淡淡乍寒时。\n红衣女子摇船去，唱得新声似竹枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10583,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠高季迪幼女定儿","author":"徐贲","text":"红衣穿小与身宜，对镜娇痴学画眉。\n怜爱莫教看作女，慰人犹胜似无儿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10584,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"黄德让病后苦吟因赋诗以释之","author":"徐贲","text":"不废诗篇病后身，思花怀月亦劳神。\n凭君暂歇行吟兴，药具方书正可亲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10585,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过宁真道观","author":"徐贲","text":"处处园亭闭不开，残筠荒树总堪哀。\n閒时好作谁家坐，只向宁真观里来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10586,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"听歌","author":"徐贲","text":"才得听歌便泪垂，眼前不似旧听时。\n青春多半遭离乱，白发能消几度悲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10587,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西岩渔翁图","author":"徐贲","text":"云水平生一钓纶，扁舟来往楚江滨。\n自烧绿竹炊新饭，谁道烟消不见人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10588,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寒食前三日适桐里见梨花","author":"徐贲","text":"清江行尽有人家，汨汨春流涨暖沙。\n已自深忘寒食节，无因此地见梨花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10589,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻鸠","author":"徐贲","text":"看花几日喜春晴，布谷无端唤雨鸣。\n何处听来最伤感，荒村树里两三声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10590,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"东轩芍药盛开两日雨阻未得观及往零落因惋惜赋之","author":"徐贲","text":"看栽红药向东阑，及到开时未暇观。\n今日雨晴重过此，浅红深紫已凋残。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10591,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春暮见山茶有感","author":"徐贲","text":"宫粉凝脂竹外栽，繁华曾见雪中开。\n一枝自有相怜意，留向春深待我来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10592,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵看花四首 其一","author":"徐贲","text":"数点飞花覆短莎，风光初暖已胜罗。\n连朝不向东园去，红渐稀疏绿渐多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10593,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵看花四首 其二","author":"徐贲","text":"一枝香雪倚东阑，开过清明半已残。\n若到东风无几日，凋零也作盛时看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10594,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵看花四首 其三","author":"徐贲","text":"柳叶齐舒荻笋长，陌头无复踏春阳。\n强将花瓣都收拾，赢得罗衣几日香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10595,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵看花四首 其四","author":"徐贲","text":"花随风信应时开，珍重东君巧剪裁。\n今日看花人剩有，绿阴惟我独能来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10596,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"口号","author":"徐贲","text":"年丰今已见秋成，到处时闻打稻声。\n怪底田家秋社里，赛神犹自卜升平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10597,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"圆明寺会宿次韵别吴校书","author":"徐贲","text":"经榻多馀为我分，閒身且得伴孤云。\n此来已觉心无事，清夜论诗况有君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10598,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄方山人彝","author":"徐贲","text":"南圃灌园看晓汲，东湖开地课春耕。\n一从投刺归来后，赢得身閒处处行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10599,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]