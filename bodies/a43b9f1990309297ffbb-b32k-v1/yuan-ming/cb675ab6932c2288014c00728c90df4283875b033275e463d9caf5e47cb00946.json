[{"title":"骆郑二君子见访赋绝句 其三","author":"戴良","text":"白首相逢能几回，羡君仍作等閒来。\n明年此日知何处，且向空庭嗅落梅。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14328,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"旅怀 其一","author":"戴良","text":"春半家书预作期，长儿十月送寒衣。\n江空野旷无消息，踏遍苍苔人独归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14329,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"旅怀 其二","author":"戴良","text":"数口迢迢寄海边，乡心客计两茫然。\n老妻岂悉未归意，将谓飘蓬似往年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14330,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"旅怀 其三","author":"戴良","text":"独向荒村歌竹枝，寒烟暮雨不胜悲。\n平生一种凄凉态，岂料偏归老大时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14331,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"我梦骑赤龙","author":"张宪","text":"我梦骑赤龙，谒帝白玉庭。\n帝方奏大乐，钧天声冷泠。\n木公起献寿，金母持银瓶。\n麒麟伏座下，凤尾芙蓉青。\n蟠桃大如斗，一啖三千龄。\n太乙顾我笑，冷风吹面腥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14332,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"仲温画扇上作假山棕蕉梧竹","author":"张宪","text":"棕榈覆墙阴，芭蕉上窗绿。\n凉风起高梧，白露下丛竹。\n明月照假山，雁啼人未还。\n砧声不出户，心在玉门关。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14333,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感寓","author":"张宪","text":"秋风吹芳草，日车縳不住。\n素丝变青发，新人渐成故。\n莫嗟功名迟，政为读书误。\n昔贤虽达道，不免在丘墓。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14334,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"栖鹤峰","author":"张宪","text":"辽东失却丁令威，赤壁梦里横江飞。\n明河洲头槎已烂，千岁去家今始归。\n晴峰历历入云小，独立秋空望华表。\n华阳真逸上清来，铁笛一声山月晓。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14335,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"鞠潭为顾子顺赋","author":"张宪","text":"盘龙塘下潭如井，百尺甘泉冰雪冷。\n琼英一勺露生香，能黑华颠驻光景。\n九月十月天雨霜，七十二种分秋芳。\n粼粼晓碧卓倒景，白者白玉黄金黄。\n咀鞠之英饮潭绿，不数南阳旧甘谷。\n童子开门濯帽纱，报道新醅夜来熟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14336,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题云山楼","author":"张宪","text":"远山近山浓淡青，朝云暮云先后生。\n我楼虽小实空阔，云自往来山自横。\n山耶云耶两无碍，地久天长果谁在。\n渺茫蜃气等虚空，纵有轩窗宁足怪。\n为爱云山搆小楼，看山看云今白头。\n山形起伏只如旧，云湿云晴知几秋。\n门窗向山作长揖，长揖云山两俱入。\n推窗送山出楼去，山出云归楼自立。\n愚公好勤不奈閒，孙孙子子厌跻攀。\n眼空四海本无物，何事欲移门外山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14337,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题寿老人松年图","author":"张宪","text":"我昔湖上看眠松，蟠屈苍龙阴十亩。\n青天昼暝雷雨黑，白日犹疑鬼神守。\n却忆僧前如雨落，春雨新秧不盈握。\n如今合抱复蔽牛，偃蹇轮囷卧丘壑。\n松下老僧金骨仙，亲手种松忘岁年。\n倒持一尺白鸾尾，拄颊听风当昼眠。\n茯苓作粥粉作饼，千斛松醪供酩酊。\n不用飞丹驻玉颜，前身自是陶弘景。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14338,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桂林图","author":"张宪","text":"瑶阶夜泠莎鸡泣，老兔西飞天宇湿。\n万斛秋香捲海风，丹砂满地谁收拾。\n太湖仙子月中立，青琐画阑尘不入。\n玉鞭一尺跨白鸾，笑向霜娥作长揖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14339,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"荆卿叹","author":"张宪","text":"白虹贯赤日，易水生凄风。\n燕人尽悲愤，相送冀城中。\n筑声何惨戚，歌意哀无穷。\n岂不念即往，立堪嬴政胸。\n徘徊有所待，匪畏秦帝雄。\n自恨剑术疏，未易了君事。\n秣马膏吾车，我客久不至。\n奈何遽相促，苦未知人意。\n丈夫重然诺，断臂死不辞。\n但怜樊将军，九泉终见疑。\n咄彼死灰儿，曷足同等夷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14340,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"沧海君","author":"张宪","text":"渐离筑中铅作水，荆卿臂落图穷匕。\n鲍鱼风起鸾车腥，不待明年祖龙死。\n赤帝子，沧海君。\n剑三尺，椎百斤。\n千金胡为轻报秦。\n英雄不进圯桥履，亦作秦皇刀下鬼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14341,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"广川王愁莫愁曲","author":"张宪","text":"愁莫愁，死即休。\n铅灌口，刀灼眸。\n托灰煮尸剑击头。\n愁莫愁，永巷春深作系囚。\n愁只愁，老妪哭。\n使者来，穷诏狱。\n徙上庸，伏显戮。\n雪我无辜人十六。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14342,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"巫蛊使","author":"张宪","text":"襌襹步摇冠，曲裾纱縠衣。\n伟哉燕赵士，借问此为谁。\n谒帝登犬台，利口兴祸阶。\n能令亲父子，恩爱一朝乖。\n血溅长安城，尸横泉鸠里。\n虽族佞臣家，不益储君死。\n望思思不归，至今天下悲。\n请听三老议，儿罪只当笞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14343,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"诛宦官","author":"张宪","text":"太白入房天示儆，丞相三公俱有?。\n侍中已奏天官书，北寺狱词犹上请。\n五官令史发奏章，奸谋夜召共与张。\n尚书诏版出胁笔，一十七阉心计长。\n白头老翁短才术，援剑突门肆呼叱。\n门生官属务相随，谁解尽言箴八失。\n于乎！\n太傅死，将军诛，洛阳都亭枭血颅。\n宗亲宾党一日屠，朝廷大柄归阉奴。\n乃有何尚书，不肯鉴前车。\n又向嘉德殿前伏，属镂诛宦官良可乎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14344,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"天宝词","author":"张宪","text":"林甫官朝日，韩休罢相时。\n新台初纳妇，兴庆又生儿。\n玉栅笼鹦鹉，金盘进荔枝。\n内前车马棘，无地避诸姨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14345,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雉子斑曲","author":"张宪","text":"雉子斑，双双起，锦膺绣颈斑斓尾。\n十步一啄粟，百步一饮水。\n雌逐雄飞雄随雌，誓不愿拘挛生，宁求野斗死。\n野鹰昨夜下蒿藜，搦雄飞去雌独归。\n雉子斑，忍分离，辟邪伎作鼓吹悲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14346,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋怨","author":"张宪","text":"雨声绕山来，撼屋风猎猎。\n银床暑气消，金井下梧叶。\n胭脂堕微泪，鸾镜晓妆怯。\n香冷红象梳，髻薄钗燕帖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14347,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桃花梦","author":"张宪","text":"美人夜出胭脂井，骨醉香肌春不醒。\n去年阿护不重来，独倚晨光照芳影。\n彩云红雨两无心，觉来飞去三青禽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14348,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梁苑行","author":"张宪","text":"银鳞靡靡天光晚，画出梁王江上苑。\n脩眉凝睇秋波长，薄袖分香春麝煖。\n氤氲宝鼎腾水沉，寂历宫门闭金键。\n三十六竽吹紫云，露冷高台双凤远。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14349,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"采莲曲","author":"张宪","text":"明月满大堤，荡舟湖水西。\n桨牙鸣浪碎，船尾拂花低。\n绿鬟湿香雾，红袖罥芳泥。\n采莲不得藕，空妒鸳鸯栖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14350,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"薄命妾","author":"张宪","text":"少长深闺里，面不识风吹。\n自为薄情妇，懒涂红玉脂。\n花轩背春睡，月树恼秋思。\n不嫁张京兆，敢烦郎画眉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14351,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杨白花","author":"张宪","text":"杨白花，何轻薄。\n随风渡江去，飞向谁家落。\n江南风雨春先老，陌上悠扬为谁好。\n永巷春归梦不成，绿池一夜浮萍生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14352,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"昭君怨","author":"张宪","text":"四弦嘈嘈弹，北风边马嘶。\n回头望汉月，遥落长安西。\n白草没行路，万里春凄迷。\n谁谓秭归女，去作单于妻。\n抆泪入穹庐，颦眉向羊酪。\n敢恨君恩轻，惟怜妾命薄。\n安危托妇人，良为君王羞。\n谋臣自无策，画史不须尤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14353,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"神弦白石郎","author":"张宪","text":"石郎家住南山里，夜叱卧羊成队起。\n砑光罗帽舞香山，金矿银坑烂如纸。\n竹节短鞭鞭赤狐，山精木魅声呜呜。\n回风蹋水过溪曲，旋折山花聘小姑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14354,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"双燕离","author":"张宪","text":"双燕复双燕，双飞绣户中。\n梅梁立春雨，桂殿别秋风。\n火焚柏梁台，信断乌衣国。\n羁雌忆孤雄，双飞难再得。\n卵破巢既空，系丝徒尔红。\n曾如燕赤凤，能入汉皇宫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14355,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绿水谣","author":"张宪","text":"今宵何处月，南浦木兰船。\n半夜凉风起，荷花如锦鲜。\n莫剪茎上叶，水珠有时圆。\n且留泥下藕，要使根株连。\n鸳鸯不并翅，好事琉璃脆。\n解佩掷真珠，少酬交甫意。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14356,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"塘上行拟甄后","author":"张宪","text":"白露下塘蒲，芙蓉秋露湿。\n不忍生离别，时抱蒹葭泣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14357,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"伥魂啼血行二首 其一","author":"张宪","text":"孤城四面啼猛虎，怒豹咆哮饿彪舞。\n东海王公长猎儿，手有长刀腰有弩。\n黄公前日为虎吞，胆落猎儿深闭门。\n今晨冯妇复攘臂，虎视不动门前蹲。\n君不见妖狐假威不敢搏，而况真虎据岩壑。\n伥魂导虎已何时，血腥芳草愁离离。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14358,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春山行","author":"张宪","text":"须弥削出金芙蓉，青苍万古摩玄穹。\n丹砂空绿斗灵寿，七十二候常春风。\n金骨仙人秘灵宝，蟠桃花下金光草。\n不知寿与天齐倾，但见群真头白早。\n君不见十八公封五大夫，根盘琥珀枝珊瑚，与君绘作春山图。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14359,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"林塘幽十四韵","author":"张宪","text":"胜境惬幽寻，芳塘漾茂林。\n浸天惊滉漾，拔地见萧森。\n隔水时闻磬，穿花或听琴。\n青浮鳌弁小，黑直蜃宫深。\n跃藻跳珍鲤，争枝坠野禽。\n风回微作籁，云去尚留阴。\n鹤起如迎客，龙归若献琛。\n萝房依荫芘，宝筏渡迷沉。\n春雨移舟坐，秋霜倚杖吟。\n兴惟便枕簟，懒欲弃冠簪。\n住久将忘世，观来已悟心。\n埃尘犹不测，荣辱岂能侵。\n天乐朝朝下，神灯夜夜临。\n阎浮那有此，大士现潮音。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14360,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虎丘寺","author":"张宪","text":"四野天垂幔，孤峰地涌金。\n潮来讲台润，日午剑池深。\n曲径穿红树，长廊蔽绿阴。\n小吴轩子好，谁继老坡吟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14361,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"顾野王读书堆","author":"张宪","text":"昔闻野王宅，今上读书堆。\n篁竹最深处，菊花时自开。\n天风响钟磬，海气结楼台。\n回首梁陈事，悲歌付一杯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14362,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"二乔图","author":"张宪","text":"并倚两娇娆，人呼大小乔。\n腕松红玉钏，钗亸紫金翘。\n公瑾应同调，孙郎早见招。\n独怜铜雀瓦，风雨夜萧萧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14363,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柬卫处士","author":"张宪","text":"傍山依水作幽居，未减南阳诸葛庐。\n卓行自成高士传，浮荣不用辟书除。\n乌丝小楷春题画，青简长编夜著书。\n愧我红尘走官马，计偕空诣汉公车。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14364,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠轩辕道士","author":"张宪","text":"子是弥明几代孙，姓名方使世人闻。\n坐惊星斗生雷剑，动使烟霞绕练裙。\n月里白鸾招子晋，山前青虎借茅君。\n长春酒熟朝朝醉，高枕瑶琴卧碧云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14365,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵江鍊师","author":"张宪","text":"道人容貌似婴孩，手抉天罡步斗魁。\n拄杖神游却月观，乘风夜上鍊丹台。\n剑横秋水苍龙化，衣染春云玉女裁。\n闻道蓬莱隔东海，芙蓉三朵翠成堆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14366,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵虞阁老题柯丹丘画","author":"张宪","text":"夜雨幽篁密，晨霜落木多。\n月明商女恨，江冷越人歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14367,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"睦垣画","author":"张宪","text":"山果缀丹实，霜林开画屏。\n美人湘水上，谁与拾秋馨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14368,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"温日观葡萄","author":"张宪","text":"银瓮悬紫驼，驿骑晓来急。\n西风吹竹窗，一夜鲛人泣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14369,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"听松图","author":"张宪","text":"洪岩羽士氅衣轻，脚踏青鸾下玉京。\n直壁倒悬秋万尺，盘陀石上听秋声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14370,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"佘山道中","author":"张宪","text":"老树排云石径斜，炊烟起处有人家。\n一声啼鸟春成夏，新绿满汀浮柳花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14371,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"日峰歌为升居士赋","author":"无愠","text":"羲和鞭日升扶桑，残星晓月俱遁藏。\n出海高峰最先照，草木滉漾浮金光。\n兴来振衣凌绝顶，俯览人间同坎井。\n呼吸元气融心神，摆脱尘劳发深省。\n一真之境无异同，声闻醉酒如瘖聋。\n安得毗耶多病翁，与渠把手击节歌日峰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14372,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"特峰歌","author":"无愠","text":"一峰特立天地间，仰望不及徒跻攀。\n知有何人住绝顶，菜叶流出清溪湾。\n雾捲烟舒日千变，枯木岩前路回转。\n善财到此亦踌躇，何处亲承德云面。\n华开华落春复秋，太华未足为朋俦。\n石背萝阴卧麋鹿，风前日下啼栗留。\n千奇万怪状不尽，得趣忘言心自领。\n栽田博饭老杨岐，见说年来赋归隐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14373,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无言歌为真如本长老作","author":"无愠","text":"无言歌，无言之道言难传。\n机头领略犹钝汉，句后解会知徒然。\n我本有口且无舌，兴来不妨歌一阕。\n七金山外觅知音，引得虚空笑声咽。\n君不见空生寂寂岩头坐，匝地天华乱飘堕。\n又不见毗耶病夫施一默，潦倒文殊叹无及。\n两处牢关尽掣开，白日青天轰霹雳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14374,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"示惟寂","author":"无愠","text":"古人出家为生死，今人出家则否尔。\n生死由来既不明，况复所为同俗子。\n友不友兮师不师，浩浩成群习庸鄙。\n触事如今已面墙，何待他年始知耻。\n而汝既然为我徒，日用应须重操履。\n教旨禅宗力究参，圣像晨昏更勤礼。\n傥或一朝得入头，便有清声播人耳。\n慎勿悠悠过一生，没头浸在涛浪里。\n我今衰老百无能，随分山林且容与。\n汝来问讯我合掌，觌面何曾孤负汝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14375,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"箴仲规扁所居为清白居","author":"无愠","text":"道人晏坐清白居，身心不动长如如。\n月窟深藏雪狮子，冰壶静贮银蟾蜍。\n绝色纯真妙难测，中下焉能造其域。\n不修梵行事空王，岂守邪禅作家贼。\n纵横廓落含十虚，三尺丈六携手归。\n彻骨风流秪者是，六门日夜扬光辉。\n灵利师僧近来少，往往多从外边讨。\n本无阶级坦然平，到此定应先跶倒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14376,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次南堂韵送寿首座归扶桑","author":"无愠","text":"屋头铁马声丁东，明明历历扬真风。\n老夫梦熟蓬莱宫，钧天乐广盈耳中。\n觉来轩知与神遇，逸响遗音竞奔注。\n梦觉曾无起灭心，帖然一似沾泥絮。\n道人推门露未乾，相看一笑非颟顸。\n十世古今融当念，大千沙界归毫端。\n爱尔年来手脚老，出没神机电光扫。\n南堂室内早鹰扬，钵袋千钧已传了。\n翻忆当时侍禅榻，开口便受拦胸踏。\n罔象明珠离水泥，轩辕宝镜开尘匣。\n明朝送君鄞水边，博多远泛东归船。\n老夫闭门仍打眠，更无心力论单传。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14377,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"一笑轩为宗旨南作","author":"无愠","text":"一笑轩中行复坐，青山白云不可唾。\n六户虚凝绝点尘，经案铜瓶安一个。\n灵山对众拈花时，百万龙象徒蚩蚩。\n金色头陀独解事，冁然微笑扬双眉。\n笑边真旨凭谁委，木强杨歧未相许。\n客来不必更踌躇，便应识取轩中主。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14378,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送渭侍者省师叔印宗就问讯","author":"无愠","text":"徂徕之松渭川竹，劲节高标拔尘俗。\n衲僧行志亦如斯，甘分空山抱幽独。\n香严一击忘所知，鸟窠叠足忘危枝。\n只将松竹代说法，布毛何用拈来吹。\n道人东寺有师叔，慎莫抛家事驰逐。\n铁船打就已多时，归帆好趁东风熟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14379,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"白云山谷歌赠麟藏主","author":"无愠","text":"白云缥缈无住著，独与青山如有约。\n暮向青山头上飞，朝来又抹青山脚。\n道人业空寂，不喜世上名。\n既爱白云白，复嗜青山青。\n结此茅庐事深隐，笑指云山当户庭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14380,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠道士凌云峰","author":"无愠","text":"坐夏不出户，尘缘净于扫。\n羽客苕溪来，访我无生道。\n无生不可学，可学成缴扰。\n有物天地先，冥冥还杳杳。\n仙凡本一致，明悟当及早。\n蹠蹻岂永年，颜冉未曾夭。\n南薰破炎热，浓绿莺声老。\n与子两忘言，尘寰即蓬岛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14381,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"不归篇","author":"无愠","text":"昨日又不归，今日又不归。\n竟自无归日，劳我长歔欷。\n歔欷为何事，怜此忘家子。\n弃却祖翁业，向外图经纪。\n岁月苦无多，悠悠水上波。\n心源未照廓，奈此生死何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14382,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"归来篇","author":"无愠","text":"归来兮归来，归来免攀陪。\n山泉甘露味，草座黄金台。\n人生当自足，自足真天禄。\n宁为击壤歌，莫作穷途哭。\n一法不留情，青山四时青。\n折松拂石坐，白云林外行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14383,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"道初和尚悼偈","author":"无愠","text":"人谓真际死，我谓真际生。\n真际本非幻，幻生真际名。\n禅房夜月冷，石塔春雨鸣。\n宗纲正落纽，伫立徒含情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14384,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"热","author":"无愠","text":"大地烁金石，禅心只晏如。\n幽閒无浊虑，郁?自清虚。\n坐石频挥麈，临流看跃鱼。\n优游三界内，寒暑不关渠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14385,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]