[{"title":"月下笛 赋落梅","author":"陶宗仪","text":"东阁诗悭，西湖梦浅，好音难托。\n香消玉削。\n早孤标顿非昨。\n阿谁底事频横笛，不道是、江南摇落。\n向空阶閒砌，天寒日莫，病鹤轻啄。\n情薄。\n东风恶。\n试快觅飞璚，共翔寥廓。\n冰魂漠漠。\n谩怜金谷离索。\n有时巧缀双蛾绿，天做就、宫妆绰约。\n待一点，脆圆成，须信和羹问却。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4568,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题薛兰英、蕙英《苏台竹枝词》 其一","author":"杨维桢","text":"锦江只见薛涛笺，吴郡今传兰蕙篇。\n文采风流知有日，连珠合璧照华筵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4569,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古十首 河传 拟花间 其一 春日宫词","author":"邵亨贞","text":"春殿。\n帘卷。\n郁金香远。\n午漏沉沉柳阴。\n楼前怨红何处寻。\n沉吟。\n玉沟流水深。\n睡起长门催侍宴。\n情正倦强把镜奁展。\n露柔荑。\n添黛眉。\n步移。\n君王犹讶迟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4570,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古十首 蝶恋花 拟雪堂 其二 夜宿西掖","author":"邵亨贞","text":"莲烛烟销深院里。\n玉宇琼楼，夜色明如洗。\n月到紫薇花树底。\n阑干露重无人倚。\n金錀无声门不启。\n华发萧萧，尚拥青绫被。\n听尽楼头更漏水。\n一声唱晓鸡人起。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4571,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古十首 凤来朝 拟清真 其三 汴堤送别","author":"邵亨贞","text":"驻马隋堤路。\n怨凌波、背人唤渡。\n正琵琶拨到伤情处。\n又底事、便轻去。\n日照啼红无数。\n酒杯干、再三细语。\n转首又天涯暮。\n怎约得、画桡住。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4572,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古十首 临江仙 拟无住 其四 水槛过雨","author":"邵亨贞","text":"一滴天瓢蠲溽暑，夕阳微漏残红。\n竹阑乘兴倚薰风。\n笑惊双白鸟，飞过藕花丛。\n羽扇纶巾闲到我，百年世事匆匆。\n若耶溪上旧相逢。\n晚来回首处，山色有无中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4573,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古十首 卖花声 拟顺庵 其五 早朝应制","author":"邵亨贞","text":"烟树重重，春在景阳宫殿。\n翠柳深、笼寒尚浅。\n千官过处，有黄鹂百啭。\n五云中、渐移龙扇。\n钧天九奏，迤逦霞觞催献。\n笑声喧、霓裳舞遍。\n香烟满袖，更宫花迎面。\n喜新来、太平重见。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4574,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古十首 杏花天 拟白石 其六 垂虹夜泊","author":"邵亨贞","text":"月明消却娃宫酒。\n听吹笛、清寒满袖。\n向时双桨载离愁、去后。\n几春风待问柳。\n谩回首。\n三江渡口。\n念西子、如今在否。\n上方钟动客船开、别久。\n寄新诗、兴未有。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4575,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古十首 小重山 拟梅溪 其七 尊前赠妓","author":"邵亨贞","text":"绿鬓低低压翠钿。\n双眉弯似月、斗婵娟。\n夜凉和袖拂冰弦。\n娇无奈、何况酒尊前。\n歌罢意悠然。\n一声新雁过、暗愁牵。\n明朝江上水连天。\n凌波步、万一故人怜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4576,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古十首 鹊桥仙 拟稼轩 其八 中原怀古","author":"邵亨贞","text":"残阳陇树，寒烟塞草。\n戏马台前秋老。\n黄河日日水东流，断送却、英雄多少。\n西秦笳鼓，东山寄傲。\n万事付之一笑。\n闲来系马读残碑，又目断、江南飞鸟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4577,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古十首 浪淘沙 拟遗山 其九 浙江秋兴","author":"邵亨贞","text":"红叶满青山。\n掩映溪湾。\n柴门鸡犬白云间。\n江上草堂尘不到，老子心闲。\n霜后橘阑斑。\n篱菊香残。\n夕阳回首一凭阑。\n世事悠悠吾老矣，且放杯干。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4578,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古十首 唐多令 拟龙洲 其十 钱塘晓渡","author":"邵亨贞","text":"晨色动征衣。\n疏钟隔翠微。\n小蓬莱、烟树高低。\n潮去潮来吴越恨，江上月，故依依。\n人老昔游非。\n愁多春梦稀。\n旧相思、重见无期。\n苏小门前杨柳树，应折断，最高枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4579,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浪淘沙 其一 钱南金疾作，代简问讯","author":"邵亨贞","text":"秋意满平芜。\n梦绕莼鲈。\n一江烟水雁来初。\n昨夜西风吹杜若，渺渺愁予。\n人隔楚天隅。\n相望踌蹰。\n想应多病故人疏。\n门巷凄凉谁买赋，瘦也相如。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4580,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浪淘沙 其二 晚窗过雨","author":"邵亨贞","text":"杨柳弄黄昏。\n不掩重门。\n长条尽是旧愁痕。\n独自倚帘看晚色，无限消魂。\n风雨小溪浑。\n春过三分。\n明朝莺燕又纷纷。\n唯有天涯芳草怨，依旧王孙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4581,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浪淘沙 其三 感旧","author":"邵亨贞","text":"江外雨初收。\n江水悠悠。\n旧时桃叶去难留。\n几度春风杨柳暗，不系离舟。\n别久减风流。\n梦断西楼。\n年年二月踏青游。\n不是沙边无杜若，懒寄闲愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4582,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虞美人 其一 柳滨泛荷","author":"邵亨贞","text":"南风十里平湖外。\n夜舞凌波队。\n米家书画满船头。\n更著小怜歌舞障清愁。\n乌纱不共人间暑。\n别有谈玄尘。\n近来懒作断肠声。\n只怕花能解语又多情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4583,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虞美人 其二 谢张芳远惠杏花","author":"邵亨贞","text":"闭门日日听风雨。\n不道春如许。\n老来犹自爱看花。\n及至看花双眼被愁遮。\n杏花不改胭脂面。\n愁里惊相见。\n花枝犹可慰愁人。\n只是鬅鬙短鬓不禁春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4584,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虞美人 其三 水仙","author":"邵亨贞","text":"几年不见凌波步。\n只道乘风去。\n山寒岁晚碧云寒。\n惊见飘萧翠袖倚琅玕。\n玉盘承露金杯劝。\n几度和香咽。\n冰霜如许自精神。\n知是仙姿不污世间尘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4585,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虞美人 其四","author":"邵亨贞","text":"客窗深闭逢三五。\n不恨无歌舞。\n天时人事总凄然。\n只有隔窗明月似当年。\n老夫分外情怀恶。\n无意寻行乐。\n眼前触景是愁端。\n留得岁寒生计在蒲团。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4586,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虞美人 其五","author":"邵亨贞","text":"无情世事催人老。\n不觉风光好。\n江南无处不萧条。\n何处笙歌灯火做元宵。\n承平父老头颅改。\n就里襟怀在。\n相逢不忍更论心。\n只向路傍握手共沈吟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4587,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"河传 其一 戏效花间体","author":"邵亨贞","text":"春浅。\n重门深掩。\n寂寞东风。\n睡浓。\n起来绣窗花影重。\n娇慵。\n宿妆凝淡红。\n待把眉山临镜画。\n还又罢。\n却放翠帘下。\n画楼闲。\n楼外山。\n倚阑。\n只愁相见难。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4588,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"河传 其二 戏效花间体","author":"邵亨贞","text":"倦绣。\n轻揎罗袖。\n背倚秋千。\n杜鹃。\n年年恼人三月天。\n锦笺。\n空将心事传。\n小玉偷移筝上雁。\n弦索断。\n惊起睡鸳散。\n粉墙西。\n杨柳堤。\n马嘶。\n谁家游子归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4589,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"河传 其三 戊戌岁暮吴中客楼夜思","author":"邵亨贞","text":"人静。\n雨摇灯影。\n梦绕天涯。\n路赊。\n水边小梅开几花。\n人家。\n酒旗何处斜。\n客路冰霜惊岁晚。\n情绪懒。\n长是念疏散。\n小溪滨。\n犹有春。\n故人。\n几时相见频。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4590,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浣溪沙 其一 早春","author":"邵亨贞","text":"残雪楼台试晚晴。\n锁香帘幕酿微酲。\n浅寒灯市有人行。\n别院金刀裁白苎，谁家银烛度瑶筝。\n早春天气已关情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4591,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浣溪沙 其二 早春","author":"邵亨贞","text":"金碧围屏小博山。\n锦笼鹦鹉旧雕阑。\n黄金杨柳弄轻寒。\n翠帐半垂鸳结带，朱门双掩兽连环。\n东风犹锁黛眉弯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4592,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浣溪沙 其三 暮春杂兴","author":"邵亨贞","text":"竹槛云窗古画图。\n烟堤花岛小蓬壶。\n昼长人静鸟相呼。\n玄璧光浮铜雀研，紫绵香冷博山垆。\n半欹高枕当人扶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4593,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浣溪沙 其四 暮春杂兴","author":"邵亨贞","text":"雨过池塘绿水生。\n竹阴深处小桥横。\n鱼吹翠浪柳花行。\n独倚曲阑魂欲断，沉思倾国句难成。\n匆匆春晚更伤情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4594,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浣溪沙 其五 春感","author":"邵亨贞","text":"西子湖头三月天。\n半篙新涨柳如烟。\n十年不上断桥船。\n百媚燕姬红锦瑟，五花宛马紫丝鞭。\n年年春色暗相牵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4595,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浣溪沙 其六 丁酉早春试笔，柬钱南金","author":"邵亨贞","text":"乱后无诗做好春。\n春光却又恼诗人。\n溪头举目暗伤神。\n杨柳官桥人迹绝，杏花歌馆烧痕新。\n相期何处避兵尘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4596,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浣溪沙 其七 折花士女图","author":"邵亨贞","text":"折得幽花见似人。\n沈吟无语不胜春。\n采香径里袜生尘。\n浓绿正迷湘北渚，软红不入宋东邻。\n一春幽恨几回新。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4597,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"一落索 其一 新柳","author":"邵亨贞","text":"陌上东风初转。\n暗黄犹浅。\n金鞭拂雪记章台，是几度、朱门掩。\n千缕柔丝迎面。\n吹笙人远。\n妆楼妒冷绣帘垂，恐误了、双双燕。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4598,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"一落索 其二 新柳","author":"邵亨贞","text":"缕缕鹅黄拂晓。\n弄烟轻袅。\n宜春花外万丝金，记朝罢、惊啼早。\n学舞楚腰犹小。\n不禁寒悄。\n近来张绪减风流，又恐被、蛾眉恼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4599,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南柯子 次韵卫立礼春街蹋月","author":"邵亨贞","text":"门掩黄昏后，风销绛蜡时。\n行春小队夜参差。\n一曲仙音飞上广寒枝。\n不访金钗客，空歌白苎衣。\n画桥梅影散玻瓈。\n月底婆娑带得暗香归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4600,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"减字木兰花 其一 秋思","author":"邵亨贞","text":"锦屏香断。\n谁在朱楼吹玉管。\n唤起凄凄。\n不似河桥听得时。\n云阶月地。\n长忆青灯啼络纬。\n秋满闲门。\n断送潘郎瘦几分。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4601,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"减字木兰花 其二 崔女郎像","author":"邵亨贞","text":"红妆倾国。\n人在蒲东谁画得。\n玉骨成尘。\n往事流传恐未真。\n月明窗户。\n犹似隔墙花动处。\n夜冷西厢。\n一度魂归一断肠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4602,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"减字木兰花 其三 吴江夜泊","author":"邵亨贞","text":"江头日暮。\n客子移舟迷去路。\n望断天涯。\n灯火深村卖酒家。\n铜驼巷陌。\n荒草寒鸦烟树隔。\n往事无情。\n旧梦依然到五陵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4603,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"清平乐 其一 碧桃","author":"邵亨贞","text":"瑶笙吹罢。\n月满仙台下。\n歌扇半欹羞澹冶。\n一点芳尘不惹。\n临溪更洗残妆。\n低回玉洞舂光。\n换却当时脂脸，从教恼杀刘郎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4604,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"清平乐 其二 梨花","author":"邵亨贞","text":"绿房深窈。\n疏雨黄昏悄。\n门掩东风春又老。\n琪树生香缥缈。\n一枝晴雪初乾。\n几回惆怅东阑。\n料得和云入梦，翠衾夜夜生寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4605,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"恋绣衾 其一 初夏","author":"邵亨贞","text":"柳花零乱愁满天。\n又江城、啼老杜鹃。\n小庭院、雨初过，棹歌声、惊起昼眠。\n微风摇荡湘帘影，浪花斜、轻袅篆烟。\n问白苎、裁成未，剪金刀、犹忆去年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4606,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"恋绣衾 其二 辛丑元日","author":"邵亨贞","text":"门前爆竹儿女喧。\n野人家、时序尚然。\n尽说道、春来好，老来人、长怕换年。\n东风到底无崖岸，也殷勤、相过小园。\n第一是、朱颜改，纵花开、羞插鬓边。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4607,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"恋绣衾 其三","author":"邵亨贞","text":"重逢元夜心暗惊。\n忆当年、诸老放情。\n对芳景、张灯火，画堂深、箫鼓到明。\n乌衣巷口东风在，甚而今、春草乱生。\n试检点、繁华梦，有梅花、曾见太平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4608,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"后庭花 其一 拟古","author":"邵亨贞","text":"铜壶更漏残。\n红妆春梦阑。\n江上花舞语，天涯人未还。\n倚楼闲。\n月明千里，隔江何处山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4609,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"后庭花 其二 拟古","author":"邵亨贞","text":"剩船鹦鹉洲。\n题诗黄鹤楼。\n金谷铜驼梦，湘云楚水愁。\n少年游。\n好怀依旧，故人还在不。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4610,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"追和赵文敏公旧作十首 其一 点绛唇","author":"邵亨贞","text":"扰扰行藏，百年世事悲歌里。\n欢娱有几。\n不倦青鞋敝。\n昨夜东风，暖透鸳鸯被。\n春归未。\n故园山水。\n青眼何曾昧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4611,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"追和赵文敏公旧作十首 点绛唇 其二 着色苔梅","author":"邵亨贞","text":"萼绿仙人，孤山雪后相逢处。\n旧时村路。\n璨璨琅玕树。\n玉出蓝田，不受纤尘污。\n长怀古。\n罗浮风度。\n梦逐么禽去。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4612,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"追和赵文敏公旧作十首 感皇恩 其三 忆梅","author":"邵亨贞","text":"客里访南枝，几番愁恼。\n石径苍苔倩谁扫。\n江畔人家，篱外一枝开早。\n雪中回首处，春犹好。\n如此清香，寒蜂应饱。\n醉帽斜簪任欹倒。\n而今相见，那似向时怀抱。\n旧游长入梦，孤山道。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4613,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"追和赵文敏公旧作十首 江城子 其四 水仙","author":"邵亨贞","text":"凌风翠袖兴飘然。\n步跹跹。\n憺忘言。\n净洗明妆不与世争妍。\n玉质金相清韵绝，端可拟，月中仙。\n天寒日暮水云边。\n忍相捐。\n意难传。\n回首珠宫贝阙不胜寒。\n环佩珊珊香冉冉，谁敢与，斗婵娟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4614,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"追和赵文敏公旧作十首 其五 蝶恋花","author":"邵亨贞","text":"燕子楼边春意早。\n楼上红妆，何似当时好。\n一自画眉人去了。\n梦魂暗逐天涯草。\n蹋蹋马蹄江路杳。\n数尽归期，屈指东风老。\n惆怅一春欢事少。\n几回月落纱窗晓。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4615,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"追和赵文敏公旧作十首 其六 蝶恋花","author":"邵亨贞","text":"湖上双双新燕子。\n飞过垂杨，认得朱门里。\n回首向时歌舞地。\n几番惆怅寻邻里。\n触景愁多心似醉。\n倚遍阑干，目断春山翠。\n忽见呢喃华屋底。\n等闲牵动离人泪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4616,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"追和赵文敏公旧作十首 其七 虞美人","author":"邵亨贞","text":"天台洞口祧开了。\n无奈刘郎老。\n多情何苦叹途穷，人与花枝都在暗尘中。\n个人那日犹痴小。\n帘底秋波渺。\n别来几度见春风。\n应是门前花落水流东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4617,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"追和赵文敏公旧作十首 其八 虞美人","author":"邵亨贞","text":"天涯绿遍王孙草。\n魂梦长飞绕。\n长安无复丽人行。\n只有青山依旧向人明。\n平泉金谷俱陈迹。\n古路荒苔碧。\n金鞍去去不思归。\n不道绿窗深处故人非。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4618,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"追和赵文敏公旧作十首 其九 浪淘沙","author":"邵亨贞","text":"佳丽古神州。\n画出营丘。\n龙飞凤舞小瀛洲。\n一自水流东去后，多少离愁。\n湖上泛龙舟。\n歌吹悠悠。\n翠华黄屋旧曾游。\n王气消沈遗恨在，烟水空流。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4619,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"追和赵文敏公旧作十首 其十 太常引","author":"邵亨贞","text":"蓬壶阆苑景飘萧。\n青玉案、紫鸾箫。\n五彩凤皇毛。\n记曾览、彤廷奏韶。\n夕阳回首，汉家陵阙，霜露满岧峣。\n说著旧游遨。\n便想起、风流二乔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4620,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"风入松 其一 南金寓携李，予客海隅，寄此以叙闲阔","author":"邵亨贞","text":"十年心事暗相牵。\n收拾此灯前。\n向来行乐匆匆过，到如今、想象依然。\n踏月几番邻巷，看花长共吟船。\n故人一别阻斜川。\n曾记远游篇。\n新来我亦长为客，把故园、分付寒烟。\n纵使此回相见，好怀不似当年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4621,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"风入松 其二 与李仲与叙旧","author":"邵亨贞","text":"小溪溪上十年游。\n酌酒对花讴。\n竹西歌吹曾同赏，到如今、梦里扬州。\n绿发潘郎老大，近来懒说风流。\n故人握手话绸缪。\n重问旧盟鸥。\n五陵风度犹无恙，算闲身、底事沉浮。\n莫说乌衣巷口，夕阳都是新愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4622,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"风入松 其三","author":"邵亨贞","text":"当年曾过宋东邻。\n汗漫踏芳尘。\n如今记得欢游处，画桥横、绿水邻粼。\n借问酒家何处，牧童遥指华村。\n近来乐事底因循。\n春又过三分。\n百年能几开怀抱，绕天涯、芳草销魂。\n但愿有钱留客，也胜骑马入门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4623,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江月晃重山 其一 中秋客窗","author":"邵亨贞","text":"碧树天香带露，朱楼翠袖欹寒。\n夜深人醉碧阑干。\n珑玲影，长是隔帘看。\n又见庭前素魄，何堪镜里朱颜。\n十年一梦此身闲。\n西窗悄，诗兴颇相关。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4624,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江月晃重山 其二","author":"邵亨贞","text":"梅萼香融霁雪，檐牙暖溜悬冰。\n出林幽鸟动春声。\n元宵近，愁里梦还惊。\n村巷依然素月，寒窗祇是青灯。\n难寻遗老问承平。\n南朝事，千古独伤情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4625,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]