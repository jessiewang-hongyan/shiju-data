[{"title":"题李息斋墨竹","author":"刘基","text":"李侯貌出苍筤竹，叶上湘妃泪未乾。\n烟雨昼迷丹鸑鷟，霜风秋劲碧琅玕。\n脩茎拟截伶伦管，和气潜驱嶰谷寒。\n此意秪令谁赏识，高堂素壁静时看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8714,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"云门寺作","author":"刘基","text":"若耶溪头过新雨，云门寺前芳草长。\n好将薜荔纫衣带，更取辛荑结佩纕。\n绿鬓朱颜非昔日，茂林修竹是他乡。\n东风且莫吹花尽，远客伤春易断肠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8715,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和朱伯言自云门之天衣途中作","author":"刘基","text":"即看梅蕊发江南，渐见柔乘可浴蚕。\n日铸雨馀峰似髻，云门烟合树和蓝。\n青猿不避游人过，碧涧能消宿酒酣。\n况有山僧颇解事，何妨聊驻使君骖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8716,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送陈子晟省亲归连江","author":"刘基","text":"连江此去三千里，綵服趋庭及早春。\n闽岭白云迎马首，建溪碧水涣龙鳞。\n题桥兔颖留南徼，恋阙丹心照北辰。\n鹤发正须三釜养，凤城雨露四时新。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8717,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送黄生涖祀福建","author":"刘基","text":"九重发政怀川岳，使者承宣下紫宸。\n王瓒黄流敷帝泽，碧鸡金马出神珍。\n风清五岭烟霞肃，春到三山雨露匀。\n归路武夷溪九曲，棠梨花映绿杨津。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8718,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"乙卯岁首早朝奉天殿柬翰林大本堂诸友","author":"刘基","text":"枝上鸣嘤报早春，御沟波澹碧龙鳞。\n旂常影动千官肃，环佩声来万国宾。\n若乳露从霄汉落，非烟云抱翠华新。\n从臣才俊俱杨马，白首无能愧老身。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8719,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"元夜","author":"刘基","text":"玉漏迟迟出苑墙，星河疏淡月辉煌。\n送寒梅蕊清香细，报喜灯花紫燄光。\n金阙晓霞来若木，瑶池春色满长杨。\n君王注意防骄佚，万岁千秋乐未央。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8720,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"彭泽阻风","author":"刘基","text":"风急云飞江倒流，请君聊且驻兰舟。\n浪翻彭蠡蛟螭横，云压匡庐虎豹幽。\n怀古谩寻元亮菊，望乡空倚仲宣楼。\n五更归梦三千里，一日回肠九万周。\n啸侣山栖怜野鹿，伴人水宿感沙鸥。\n中元都府神官会，上界星辰积气浮。\n地轴西南连少昊，天关东北镇阳侯。\n两峰对拥青螺髻，孤月初生白玉钩。\n龙甲冷欺狞蜃市，蚌胎光夺睡龙眸。\n春撞急杵涛惊枕，滴沥真珠霰洒裯。\n枯树挂崖眠复起，老藤牵石坠还留。\n宫商调合灵钟夕，铓锷棱高峭壁秋。\n绣被焚香寒悄悄，金环扣瑟夜悠悠。\n竹枝写恨传巳女，木客长吟荅楚囚。\n不寐残缸犹闪灭，动情鸣橹数哑讴。\n苍梧凤逐重华去，赤水珠无罔象求。\n大宅高门荒町疃，颓垣败冢闹鸺鹠。\n尘埃漠漠城笳怨，芦荻萧萧戍鼓愁。\n鬼火碧穿灯火去，狼烟黄入烧烟遒。\n紫芝可茹林多蟒，红鲤堪罾泽有虬。\n万国锄犁俱剑戟，八陵松柏让戈矛。\n哀哀野哭乾坤傪，踽踽途行面目魗。\n永忆卢敖翔汗漫，愿随慧远学清修。\n瑶台青鸟归何处，玄圃琪华烂莫收。\n沧海未容精卫塞，蓬莱定许偓佺游。\n故园梅蕊相将发，倚赖春阳慰白头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8721,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题梅屏二绝 其二","author":"刘基","text":"独酌梅花下，怜花与鬓同。\n折花还插鬓，颠倒笑东风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8722,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题小画","author":"刘基","text":"庭前绿荷叶，香气浓于酒。\n疏雨忽飞来，的皪明珠走。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8723,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春晚","author":"刘基","text":"疏雨随风迥，轻寒薄暮归。\n犹怜数花朵，辛苦驻春辉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8724,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"遣兴","author":"刘基","text":"于越三年客，思家一百旬。\n如何今夜月，却忆镜湖春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8725,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"途中见去雁","author":"刘基","text":"昔与雁同归，今来雁北飞。\n殷勤祝过雁，来往莫相违。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8726,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫成 其一","author":"刘基","text":"春晓正堪睡，娂他窗上明。\n无端双楚雀，又向屋头鸣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8727,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫成 其二","author":"刘基","text":"明月圆复缺，春风去不来。\n泪随花雨落，点点在苍苔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8728,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫成 其三","author":"刘基","text":"昨夜三更里，还乡梦却成。\n朦胧半惊觉，连唤小儿名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8729,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫成 其四","author":"刘基","text":"日暮庭阴合，斜阳复照檐。\n不禁风絮乱，寂寞掩重帘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8730,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫成 其五","author":"刘基","text":"病身劳应接，长日掩荏扉。\n燕子来何晚，春归寒未归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8731,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫成 其六","author":"刘基","text":"炎赫迎新节，绨袍洗未乾。\n那知一夜雨，更作九秋寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8732,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫成 其八","author":"刘基","text":"泪为看花落，愁因对酒多。\n良辰不再得，衰莫欲如何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8733,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题墨竹","author":"刘基","text":"风梢舞空烟，露叶滴晴月。\n折取寄情人，感此岁寒节。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8734,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题山水小画二首 其一","author":"刘基","text":"鄂渚轻舟未发，潇湘倦客多愁。\n可恨一江春水，无情日夜东流。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8735,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题山水小画二首 其二","author":"刘基","text":"碧草桃源路断，紫芝商岭云深。\n高树月明啼鴂，一声一度伤心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8736,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画竹","author":"刘基","text":"叶间重露犹滴，林表寒烟未开。\n想见沅湘江上，月明环佩归来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8737,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画梅","author":"刘基","text":"夭桃能紫杏能红，满面尘埃怯晚风。\n争似罗浮山涧底，一枝清冷月明中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8738,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"分赃台","author":"刘基","text":"突兀高台参土成，人言暴客此分赢。\n饮泉清节令寥落，可但梁山独坛名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8739,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫成","author":"刘基","text":"阶下青苔砌上莎，春深烟雨自相和。\n幽兰生在空山里，纵有清香柰尔何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8740,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春雨三绝句 其一","author":"刘基","text":"春雨和风细细来，园林取次发枯荄。\n古墙芳草无生处，一滴还成一点苔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8741,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春雨三绝句 其二","author":"刘基","text":"翠麦黄花烂熳春，苍颜皓首别离人。\n相看一笑浑成梦，又见汀洲老白蘋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8742,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春雨三绝句 其三","author":"刘基","text":"一雨如膏五日泥，长烟不散草萋萋。\n殷勤分付墙边柳，为捣流莺自在啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8743,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋兴二首 其一","author":"刘基","text":"袅袅西风起白蘋，妖红媚绿看成尘。\n九衢车马如流水，尽是邯郸梦里人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8744,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋兴二首 其二","author":"刘基","text":"梁间燕子去悠悠，路侧寒螀管领秋。\n谁遣庄周化胡蝶，不胜憔悴为花愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8745,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题梧桐折枝翎毛图","author":"刘基","text":"琼柯碧叶两参差，又是西风白露时。\n凤鸟不来嘉实晚，小禽衔上最高枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8746,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题竹根小禽图","author":"刘基","text":"竹露无声坠碧柯，小禽相对啄秋莎。\n江湖雁鹜肥梁稻，矰缴连天雨雾多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8747,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画猫","author":"刘基","text":"碧眼乌图食有鱼，仰看胡蝶坐阶除。\n春风漾漾吹花影，一任东郊鼠化鴽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8748,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过闽关","author":"刘基","text":"天上丝纶启玉封，欢声雷动八州同。\n闽江渺渺通炎海，添作恩波到日东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8749,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题竹木石图 其一","author":"刘基","text":"凌霜傲雪无人问，拂水梢云意自闲。\n愿就姮娥借明月，卧看鸾凤舞空山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8750,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题竹木石图 其二","author":"刘基","text":"古木萧森傍水隈，凤凰飞去不飞回。\n披烟细看苍莨叶，知是湘君泪湿来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8751,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题蟹 其一","author":"刘基","text":"壳斗犀函手斗兵，沙堤潮落可横行。\n稻根香软芦根美，未觉江山酒兴生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8752,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题蟹 其二","author":"刘基","text":"拥剑横行气象豪，浑疑缣素昃波涛。\n能令吻角流馋沬，莫向窗前咤老饕。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8753,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题枯木图","author":"刘基","text":"干排风雨三千尺，根老冰泉八百年。\n不用江头唤元绪，何妨湖上识神仙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8754,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题陈太初画扇","author":"刘基","text":"炎天玉烁水银流，琴上薰风可解忧。\n不负吾皇麟趾意，只今谁是富民侯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8755,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"咏史","author":"刘基","text":"奸雄盗窃幸倾危，只道冥冥便可欺。\n想得民心思汉日，正当杨子剧秦时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8756,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"遣兴","author":"刘基","text":"一炷清香一卷书，此身安处是吾庐。\n绿槐翠柏宜长日，门外何须长者车。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8757,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题明皇幸蜀图 其一","author":"刘基","text":"斜阳惨淡照霓旗，石栈萦纡仆马羸。\n想得林间子规鸟，断崖青壁亦相随。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8758,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题明皇幸蜀图 其二","author":"刘基","text":"裂帛声中发祸机，白华歌断草菲菲。\n可怜蜀道三军恨，不记他年武惠妃。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8759,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题柯敬仲墨竹","author":"刘基","text":"苍龙倒挂不入地，回首却攀云上天。\n夜深云散明月出，化作脩篁舞翠烟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8760,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"移梅亭","author":"刘基","text":"贯石稍云一树梅，谁教移向画堂栽。\n月凉夜色清如水，其那楼头玉笛哀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8761,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题赵仲穆画眉图 其一","author":"刘基","text":"有美清扬婉且闲，横云吐月斗弯环。\n平生不识张京兆，却对妆台写远山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8762,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题赵仲穆画眉图 其二","author":"刘基","text":"含簧茹管细相和，语困春风意更多。\n惊起佳人应有恨，双蛾蹙损不成歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8763,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画山水","author":"刘基","text":"澹澹轻烟羃半林，涓涓飞瀑泻遥岑。\n偶然坐石观流水，不记还山路浅深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8764,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题石末元帅扇上有陈太初画松","author":"刘基","text":"老松根干如铁石，般匠不知空谷深。\n永夜高风吹万窍，商声满地作龙吟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8765,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题渭桥图","author":"刘基","text":"百战平城愤未销，武皇赫怒属天骄。\n可怜陵树秋风后，貂帽驼裘拜渭桥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8766,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"皆春亭","author":"刘基","text":"草色青青日色黄，暖烟烘露百花香。\n晚窗梦入桃园去，惊觉啼莺在绿杨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8767,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题湖山烟雨图 其一","author":"刘基","text":"湖上青山烟雨寒，湖中一棹欲归难。\n白蘋自老东风里，肠断黄昏独倚阑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8768,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题湖山烟雨图 其二","author":"刘基","text":"若耶溪上雨声来，秦望山前雾不开。\n欲渡镜湖寻禹完，苍藤翠木断猿哀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8769,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和王文明绝句漫兴十八首 其一","author":"刘基","text":"芙蓉湖上夕阳低，杨柳枝头一鸟栖。\n独倚阑干看山色，白云飞过若耶溪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8770,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和王文明绝句漫兴十八首 其二","author":"刘基","text":"年华如水去堂堂，何处无愁不断肠。\n天上群仙风雨外，人间明月夜凄凉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8771,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和王文明绝句漫兴十八首 其三","author":"刘基","text":"鲜印渊明柳映门，床头酒尽卧空尊。\n窗风吹破羲皇梦，闲看山云起石根。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8772,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和王文明绝句漫兴十八首 其四","author":"刘基","text":"竹根草叶垂书带，苔面蜗涎学篆文。\n坐到博山香烬歇，不知新月出微云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8773,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和王文明绝句漫兴十八首 其五","author":"刘基","text":"眼见繁花开满林，即看嫩叶绿成阴。\n杜鹃啼落西山月，一夜相思万里心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8774,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和王文明绝句漫兴十八首 其六","author":"刘基","text":"澹澹轻风冷透衣，冥冥细雨客思归。\n若为化得辽东鹤，远逐浮云汗漫飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8775,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和王文明绝句漫兴十八首 其七","author":"刘基","text":"天边云气来须女，湖上轻雷起少男。\n一阵微凉疏雨过，满池莲蕊绿如簪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8776,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和王文明绝句漫兴十八首 其八","author":"刘基","text":"风翻竹箨空林响，雨缒蛛丝落蕊悬。\n长日掩关无客到，一眉山水对婵娟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8777,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和王文明绝句漫兴十八首 其九","author":"刘基","text":"江北江南几驿亭，可怜彊半草青青。\n夜凉月白西湖水，坐看三台上将星。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8778,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和王文明绝句漫兴十八首 其十","author":"刘基","text":"旧游何处渺烟萝，几度相思梦玉珂。\n莫向天涯苦回首，野猿木客恣经过。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8779,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和王文明绝句漫兴十八首 其十一","author":"刘基","text":"东海鲸鲵倒百川，西江波浪阻征船。\n谁能散发空山里，学取希夷石上眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8780,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和王文明绝句漫兴十八首 其十二","author":"刘基","text":"梦里分明郅广寒，梦回月落斗阑干。\n碧桃吹尽无人觉，满袖西风涕泗漙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8781,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和王文明绝句漫兴十八首 其十三","author":"刘基","text":"晓晴何处一黄鹂，飞上花枝款款啼。\n独坐小窗歌伐木，偶然怀古忆祈奚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8782,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和王文明绝句漫兴十八首 其十四","author":"刘基","text":"钓得槎头缩颈鱼，隔墙有酒贯钱酤。\n近来酒价如珠玉，独饮千钱不要扶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8783,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和王文明绝句漫兴十八首 其十五","author":"刘基","text":"楼头新月斗弓弯，楼外青山对客闲。\n深夜忽然思往事，梦随孤鹤绕云间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8784,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]