[{"title":"幽窅","author":"王冕","text":"幽窅无人迹，虚空见远天。\n雪深山气伏，崖断树根悬。\n乌鸟翻身入，狐狸放胆眠。\n老夫多脚力，更欲上层巅。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":394,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日即事","author":"王冕","text":"二月三日雨不歇，桃花杏花吹作泥。\n积垒可怜飞燕苦，伤春无奈杜鹃啼。\n关河气转风云合，边塞烽多草树迷。\n老我疏狂思舞剑，兴来不待五更鸡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":395,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春晚客怀七首 其一","author":"王冕","text":"春事已过半，客怀何怅然？\n鸟啼云外树，花落雨余田。\n沽酒不成醉，解衣徒自怜。\n五湖烟水远，未得问归船。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":396,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春晚客怀","author":"王冕","text":"落落穷途客，年年不在家。\n寄眠听夜雨，借景看春花。\n空著三山帽，难防两鬓华。\n清晨览明镜，载笑复咨嗟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":397,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春晚客怀七首 其三","author":"王冕","text":"衣袖露两肘，难留侠客槌。\n对山长发啸，得酒忽忘诗。\n树湿吴云重，花残越鸟悲。\n酸辛甘自受，褴褛愧妻儿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":398,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春晚客怀七首 其四","author":"王冕","text":"花落春城暮，登临思倍清。\n买杯酬宿约，联句足余情。\n三峡星河动，九江风浪生。\n吾侪似无用，思与白鸥盟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":399,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春晚客怀七首 其五","author":"王冕","text":"雨暴溪流急，云低树势平。\n山边狐独啸，林外鸟皆惊。\n小草添生意，残花减俗情。\n明朝整巾舄，饱饭竹间行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":400,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春晚客怀七首 其六","author":"王冕","text":"诗酒从时适，功名委壮图。\n好山随处有，閒客近来无。\n冠盖骈三辅，烽尘暗四隅。\n余生营计拙，且僦好楼居。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":401,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春晚客怀七首 其七","author":"王冕","text":"贾谊治安策，虚劳渎圣明。\n人民正凋瘵，豺虎恣纵横。\n白水沈南国，青山没上京。\n吾儒无可奈，老泪向天倾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":402,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春寒","author":"王冕","text":"春寒多雨水，地僻少轮蹄。\n湿气连山暗，孤梅近竹低。\n林空饥鸟集，城冷野狐啼。\n回首关河道，风尘道路迷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":403,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"济川阻雪九月二十七日客况四首 其一","author":"王冕","text":"九月中原柳未枯，北风吹雪忽模糊。\n琼林玉树连天去，绿水青山望欲无。\n多喜夜光生锦帐，不传清响到金铺。\n老夫且作梅花梦，分付长年酒漫沽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":404,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"济川阻雪九月二十七日客况四首 其二","author":"王冕","text":"济州城南寒雪飞，济州城北冻成围。\n客情自古不称意，世事于今转觉非。\n白马少年频唤酒，黑纱老妇泣无衣。\n逢邮不寄江南信，却上高楼望雁归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":405,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"济川阻雪九月二十七日客况四首 其三","author":"王冕","text":"滕州济州山不多，平林大野少人家。\n解貂且问将军酒，对雪谁言学士茶？\n直北五更闻玉笛，江南十月老梅花。\n相逢休说凄凉事，湖海诸郎鬓未华。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":406,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"济川阻雪九月二十七日客况四首 其四","author":"王冕","text":"黄河西下水多生，滕州徐州田不耕。\n农民尽逐鱼鳖去，商贾只凭舟楫行。\n青山峨峨出鲁国，白云滚滚来任城。\n浪游欲尽燕云道，尚欠南风几日程。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":407,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"独坐","author":"王冕","text":"独坐高楼暮，凄凉何所闻？\n乱山流冻雨，荒树接孤云。\n关陕鸦成阵，幽并马不群。\n故人消息断，凋弊闵期文。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":408,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"独宿","author":"王冕","text":"独宿输吾惯，石床苔藓丰。\n气清神自固，梦不与人同。\n灯焰悬空壁，炉香袅细风。\n如何纨绮辈？\n服药取奇功。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":409,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"看山","author":"王冕","text":"昨朝问竹城西去，今日看山湖来来。\n酌醪数斗且尽醉，好景百年能几回？\n野草散光摇翠浪，风花移色闪苍苔。\n飞流最是东南急，乘兴无辞杖履陪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":410,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋兴二首 其一","author":"王冕","text":"万里山河一局棋，旷怀真感独伤悲。\n石麟夜雨生新恨，铜雀春风属旧时。\n雪捲流沙驮信远，天沈辽海鹤书迟。\n五陵年少俱零落，回首故园空梦思。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":411,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋吟二首 其一","author":"王冕","text":"夜雨滋蔬圃，秋风过草堂。\n长歌追李杜，高论入羲皇。\n戏水知鱼乐，寻膻看蚁忙。\n儿童建勋业，灯火得新凉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":412,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋吟二首 其二","author":"王冕","text":"菜叶绿满地，菊枝青过阑。\n有为遵古道，无论及时官。\n树影经秋减，湖光入座宽。\n门前旧矶石，閒却钓鱼竿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":413,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夜偶成六首 其一","author":"王冕","text":"风雷不改旧山河，华屋年深蔓绿萝。\n龙柱云消金气冷，凤台人去月明多。\n英雄空听生铜吼，感慨谁知白石歌。\n转首五湖秋水阔，且将閒兴寄渔蓑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":414,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夜偶成六首 其二","author":"王冕","text":"露华泥泥湿桐丝，渐觉新凉袭敝帏。\n肯羡轻生归马革，独怜清苦卧牛衣。\n种桃未必全忘世，采药终然会息机。\n欲问夷齐何处所？\n西风吹杀首阳薇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":415,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夜偶成六首 其三","author":"王冕","text":"生憎尘俗苦相侵，渐渐移家入远林。\n但得瓮中多白酒，何须囊里有黄金。\n关山夜静笳声惨，淮海秋高雁影沈。\n底事怀人作痴坐，短檠花冷石房深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":416,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夜偶成六首 其四","author":"王冕","text":"孤云杳杳雁声寒，黄叶萧萧诗思悭。\n坐对酒樽怀北海，啸歌白石向南山。\n菊花野雨家何处？\n莼老秋风客未还。\n梁甫不吟君莫问，卧龙寂寞草庐閒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":417,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夜偶成六首 其五","author":"王冕","text":"冉冉新霜上鬓毛，相逢何事论英豪？\n山城雨重钟声短，海国风清剑气高。\n且自草衣同牧竖，不须骢马列官曹。\n古来勋业真堪笑，三士杀身争二桃。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":418,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夜偶成六首 其六","author":"王冕","text":"潇潇寒雨满江楼，底事无端生百忧。\n铁砚磨穿灯火夜，貂裘敝尽风霜秋。\n五更空自听鸡舞，四海有谁持犗钩。\n可羡当时张许辈，蒲萄宫里烂羊头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":419,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夜燕山旅舍偶成寄林致和","author":"王冕","text":"花漏无声海月阴，小窗灯火夜沈沈。\n出师表动英雄志，征伐书移慷慨心。\n边塞雪深迷小草，关河秋老见乔林。\n不须更论江南事，击剑长歌且漫斟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":420,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋晚即事","author":"王冕","text":"十年湖海挟飞仙，今日凭高思窅然。\n关北又添三尺雪，江南别是一般天。\n紫髯老将悬清梦，白面儿郎减少年。\n说与南阳诸葛道，草庐虽好莫贪眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":421,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"种茄","author":"王冕","text":"种植便生地，还宜去草莱。\n所期羞膳具，毋吝日滋培。\n雨露恩时及，风霜气莫摧。\n且令根本固，看尔实恢恢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":422,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送人北上","author":"王冕","text":"早买北关门外船，载书应上九重天。\n风云步武君可羡，世事乖违吾独怜。\n黄阁大官归厚禄，红楼美酒不多钱。\n逢人可话江南景，春水流花满石田。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":423,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送大机上白云二首 其一","author":"王冕","text":"水月池头屋，曾同听雨来。\n故缘经岁别，又过几花开。\n且尔酬诗债，深惭乏茗杯。\n明朝出西郭，离思不堪裁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":424,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送大机上白云二首 其二","author":"王冕","text":"东郡雨不歇，西湖水亦高。\n上人今日去，行李不辞劳。\n传法灯无尽，悬崖屋更牢。\n交情如问讯，谓我只嚣嚣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":425,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送云屋僧","author":"王冕","text":"兰若边江次，羁栖喜得邻。\n论交留客夜，对酒独花春。\n风雨相过近，交情且是真。\n无端话离别，把酒忽伤神。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":426,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送五台长老","author":"王冕","text":"我有慈亲年老已，便欲送君难远行。\n道边持草或解意，天外见云无限情。\n九堰潮平船过稳，五台海近月多明。\n故人若见烦相问，头发于今白几茎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":427,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送太上人之四明","author":"王冕","text":"胜地称三佛，佳山指四明。\n雁飞江雨歇，龙蛰海潮平。\n见客无多论，看云或动情。\n有人问梅叟，为说似浮萍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":428,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送日侍者游两府兼柬丁仲容先生","author":"王冕","text":"知君汗漫饶清兴，东府西州路不多。\n牛斗正临吴分野，城池还带旧山河。\n春风扬子江头去，夜月茅山石畔过。\n若见金陵丁处士，问言归兴近如何？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":429,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送王克敏之安丰录事","author":"王冕","text":"丹墀对策三千字，金榜题名五色春。\n圣上喜迎新进士，民间应得好官人。\n江花绕屋厅事近，烟树连城野趣真。\n所愿堂堂尽忠孝，毋劳滚滚役风尘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":430,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送本中上人","author":"王冕","text":"上人飞锡何方去，笑指东南咫尺间。\n黄叶落时行细路，白云生处看青山。\n欲求古道殊难得，怅望高风或可攀。\n朋旧相逢还道我，梅花清苦鬓斑斑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":431,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送边伯京之闽","author":"王冕","text":"边郎辟掾南闽去，马首春光正十分。\n路夹海棠行锦障，江涵山翠拥罗文。\n简书可励风云会，韬略能夷虎豹群。\n若向武夷山下过，为余传语杜徵君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":432,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送圭玉冈","author":"王冕","text":"一真四法全吾道，教主云间喜作家。\n白气拥林龙绕树，紫霞纷日凤衔花。\n笑谈不释铁如意，斩斫岂由金莫耶？\n可是阿师门户别，相逢不吃赵州茶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":433,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送宇文子贞","author":"王冕","text":"郊居暂辍簿书劳，尚植忠良翊圣朝。\n风月一坛光滟滟，天人三策锦飘飘。\n清声足重江潮望，直笔宁辞馆阁招。\n洛下诸郎竞才俊，岂能无意说渔樵？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":434,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送杨义甫访云林子","author":"王冕","text":"公子翩翩孰与俦，云林清气逼高秋。\n牙签耀日书充屋，彩笔凌烟画满楼。\n既是有樽开北海，岂云无榻下南州？\n相逢一笑如知己，不必人间万户侯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":435,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送汪掾史","author":"王冕","text":"莫怪迟迟把酒杯，留君故尔强徘徊。\n市桥杨柳不堪折，江路梅花无数开。\n从此计程趋画省，更期拾级上乌台。\n底用怀思重回首，五云多处是蓬莱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":436,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送沙学正归松江","author":"王冕","text":"范蠡岩前云似锦，吴松江上水如天。\n送君去去青霄近，老我萧萧白发悬。\n杨柳风清千里梦，梅花雪落五更船。\n对人休说儒官冷，圣主于今正待贤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":437,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送客","author":"王冕","text":"骊驹歌载道，肯为簿书留？\n顾我衰迟质，不禁离别愁。\n江花缘客兴，春水便归舟。\n兹去青云远，音书可寄不？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":438,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送钦上人","author":"王冕","text":"石头城下五更秋，高挂云帆得顺流。\n铁瓮缘江即东府，璚花隔岸是扬州。\n作家相见本无语，在客别离殊有愁。\n后夜相思好明月，老夫乘兴独登楼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":439,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送颐上人归日本","author":"王冕","text":"上人住近扶桑国，我家亦在蓬莱丘。\n洪涛逼屋作山立，白云绕床如水流。\n问信不知谁是客？\n多情忘却故园秋。\n明朝相别思无限，万里海天飞白鸥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":440,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送僧归中竺","author":"王冕","text":"天香阁上风如水，千岁岩前云似苔。\n明月不期穿树出，老夫曾此听猿来。\n相逢五载无书寄，却忆三生有梦回。\n乡曲故人凭问信，孤山梅树几番开？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":441,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送僧归闽","author":"王冕","text":"九月三吴树叶红，闽中浑未觉秋风。\n上人忽动乡关念，对客莫辞途路穷。\n白发岂无诸老在？\n青山还与旧时同。\n到家检点经行处，应喜庭松雨露浓。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":442,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送僧归钱塘","author":"王冕","text":"故国荒凉草树迷，春风犹记旧沙堤。\n山连天目孤云下，潮上江头海日低。\n送客过溪惊虎啸，驱龙出洞听猿啼。\n何时与我同清赏？\n净取山泉煮木鸡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":443,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送僧游五台","author":"王冕","text":"南国看云故有愁，燕山那忍送君游。\n天风五月能生雪，野气四时浑似秋。\n适兴何须穷险绝，忘机不必论公侯。\n归来著我门前过，莫把羁杯对白鸥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":444,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送噩长老","author":"王冕","text":"张公洞口云翻海，扬子江头雪打球。\n君去兴怀殊不恶，我行风雨奈何愁。\n疏狂久负刘伶榼，飘薄空余季子裘。\n直待明年二三月，看花骑马过中州。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":445,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送薜府判之广东","author":"王冕","text":"酾酒临江亦壮哉，别离无奈故徘徊。\n喜聆乌府文章盛，又见尧天日月开。\n万里邮传清誉远，百蛮歌动好官来。\n吟边休说梅花老，不是山中宰相才。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":446,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重午次韵敬常叶公","author":"王冕","text":"故园一望海天长，京国相看叹老苍。\n太学故知韩子重，高阳应笑郦生狂。\n四更风雨客怀壮，五月幽燕地气凉。\n况是天家赐衣节，不妨谈笑引壶觞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":447,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重过戴氏居三首 其一","author":"王冕","text":"重过戴氏宅，交游情味长。\n乃翁敦德义，诸子好文章。\n济济衣冠伟，班班事业张。\n看他流俗下，不肯论炎凉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":448,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重过戴氏居三首 其二","author":"王冕","text":"矮篱编绿槿，小径入青桑。\n屋绕河流润，门开竹色凉。\n课儿书满架，留客酒盈觞。\n西沼芙蓉美，南薰䆉稏香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":449,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重过戴氏居三首 其三","author":"王冕","text":"琴书满屋壁，不下晋家声。\n湖海怀高义，交游阅古情。\n宰瓜缘暮景，看竹喜新晴。\n更约清高友，山林结隐名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":450,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重阳","author":"王冕","text":"重阳今日是，客邸忽凄怆。\n树叶惊风堕，稀衣袭雨凉。\n黄花衔古色，丹桂发天香。\n珍重东屯社，携尊过草堂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":451,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"徐竹隐","author":"王冕","text":"连江修竹静郊居，门外阴阴千亩馀。\n直节不移高士操，息交那与俗人书。\n卧听翠雨飞瓴甋，笑挹清风过绮疏。\n却扫红尘喧境寂，岁寒分席待樵渔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":452,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽吴孟思","author":"王冕","text":"云涛处士老儒林，书法精明古学深。\n百粤三吴称独步，八分一字直千金。\n桃花关外看红雨，杨柳堂前坐绿阴。\n今日窅然忘此景，断碑残碣尽伤心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":453,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"旅次","author":"王冕","text":"露下竹风清，孤楼恰二更。\n天垂沧海极，月转大江横。\n道味穷时熟，诗情旅次生。\n飘流何所拟？\n泰华一毛轻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":454,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"莫处士悼诗","author":"王冕","text":"乐閒处士老西河，花竹亭台野趣多。\n不为功名移志节，每因兴感费吟哦。\n义风孝行知谁拟，山色湖光奈尔何。\n转首栖霞清梦远，令人怀感动悲歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":455,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读史","author":"王冕","text":"耿耿青灯照青史，坐看兴废眼前来。\n亡秦未必非胡亥，灭赵终然是郭开。\n三国英雄由将相，六朝人物只婴孩。\n商之孙子宁无论，妲己端端是祸胎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":456,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]