[{"title":"移居寿安里二仙巷","author":"张昱","text":"移居所籍应官期，奈此黄梅五月时。\n墙竹翻风摇凤翥，堂萱卧雨带罗披。\n夏阴正盛衣还湿，日晷无移事可知。\n此景自怜张仲蔚，蓬蒿三径共栖迟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5348,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"王敬仲知府自临江回","author":"张昱","text":"九鼎勋劳一羽轻，几何岁月俟河清？\n卢生觉后惟空枕，丁令归来祇故城。\n宛马老怀沙苑阔，宾鸿春忆塞云平。\n天恩既许投闲后，莫向除书问姓名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5349,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵鄞孟文经历留别诗二首 其一","author":"张昱","text":"总是邯郸梦里身，区区鞍马九衢尘。\n贤才俱进惟新命，幕府从交旧日人。\n天上星辰光觉近，寒岩松柏色还新。\n从来气候关时事，鸿雁来宾已过春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5350,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵鄞孟文经历留别诗二首 其二","author":"张昱","text":"幕府深居得所亲，好看车马动行尘。\n身归绛县将遗老，诗忝河梁别故人。\n行李往来谁不旧，疏林折赠意能新。\n都城路有襄陵使，欲托微波寄洛神。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5351,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梦梅花处","author":"张昱","text":"丹青庭院欲黄昏，蝴蝶蘧蘧化梦魂。\n姑射肌肤如处子，儿家消息在重门。\n香薰绣被过残腊，影落画阑连大尊。\n可是玉川无觅处，窗前春色胜张琨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5352,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋水轩","author":"张昱","text":"镜水当轩景最新，翔鸥栖鹭总比邻。\n风惊帏箔萤流扇，露湿阑干月近人。\n深院暑收闻捣练，前溪波小见垂纶。\n莫言萧瑟秋光里，还见文章赋楚臣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5353,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵慈利县王孝廉过洞庭思亲之作","author":"张昱","text":"洞庭波浪接青天，渺渺帆樯上计船。\n万里客程何日尽，一宵江月向人圆。\n桥题驷马名先至，风遇鸿毛势沛然。\n之子澧兰歌最好，有人云梦泽南边。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5354,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉天门早朝次韵","author":"张昱","text":"千官趣谒武楼间，尽是洪钟帝铸颜。\n咫尺天威临御座，太平风景出朝班。\n握兰凤阁舍人贵，视草鸾坡学士闲。\n骑马共谈双阙下，期将万寿祝南山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5355,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵偶成二首 其一","author":"张昱","text":"杂然异味出宾盘，老觉樽前更有欢。\n清夜可人歌板倦，小楼细雨烛花寒。\n狂情肯为诸公吝，酒量方知到处宽。\n醉后玉山从倒却，试将时果掷潘安。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5356,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵偶成二首 其二","author":"张昱","text":"程家兄弟合情亲，霁月光风满座生。\n乐事笙箫相间发，酒怀江海欲同倾。\n自怜绿发朱颜改，尚觉千金一笑轻。\n夜半酒醒孤枕上，不将归思忆江城。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5357,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅鹤轩","author":"张昱","text":"梅福高轩得所亲，皎然洁白离风尘。\n九皋唳彻云间鹤，万玉香先天下春。\n门外自应回俗驾，尊前犹得伴吟身。\n绿阴窗户研朱者，莫是青溪点易人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5358,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读府教授徐大章为岐阳王客白以中赋西塘八景咏，夜卧，有怀不寐","author":"张昱","text":"若使蔡邕今日读，应题八字刻西塘。\n大音如奏古琴瑟，众羽不瞻孤凤凰。\n百世可传惟述作，一辞难措是文章。\n老夫为此喜无寐，卧诵不知秋夜长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5359,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"壬戌朔旦，试笔","author":"张昱","text":"斯文天与乐馀年，中有黄金取酒钱。\n绛老又添新甲子，王家惟守旧青毡。\n将春梅蕊茱萸小，透雪萱芽翡翠鲜。\n宾客到门无别话，履端相庆画堂前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5360,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题梧桐宫六逸堂","author":"张昱","text":"龙化青林水满溪，昔人曾此寄幽栖。\n高情不负杯中物，烂醉何妨日似泥？\n富贵到头蕉下鹿，光阴过眼瓮中鸡。\n当时不尽风流兴，付与山莺尽意啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5361,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题梦焦轩","author":"张昱","text":"道人内视已超然，一息薰香遍大千。\n骇鹿始知身似梦，覆蕉曾悟佛中禅。\n袈裟万朵天花里，世界千重梵网边。\n重见毗那峰顶上，手开楼阁说因缘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5362,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"戊申岁间中清赏十景 其四 修林策短筇","author":"叶颙","text":"修林策短筇，路入烟霞去。\n群峰喜逢迎，向人如妩媚。\n攀条览芙蓉，临流采荪蕊。\n幽花不知名，馨香杂芳树。\n天风吹敝袍，晓露沾行履。\n更无尘染衣，常有云生袂。\n山禽忽飞来，啼破幽绝处。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5363,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题诸葛孔明 其六","author":"张昱","text":"身为中山汉子孙，西南别立旧乾坤。\n君才十倍曹丕上，位列三台蜀相尊。\n布阵有图灵尚在，出师遗表恨犹存。\n休将巾帼羞司马，五丈原头日已昏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5364,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题严子陵","author":"张昱","text":"赤图神运复炎刘，白水真人忆旧游。\n一代位尊眠凤榻，千年名重著羊裘。\n山林孰谓无伊尹，廊庙何曾弃许由？\n惟有富春山下月，清光常绕石滩流。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5365,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题张天爵父通守公张侯之墓","author":"张昱","text":"平生好友念张侯，紫峡云深墓木稠。\n赤绂既能承世泽，黄金奚用为孙谋？\n衣冠南郡成前辈，风月西湖总旧游。\n过此岂胜存殁感，解鞍一奠古坟头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5366,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"水竹佳处，为壶金子赋","author":"张昱","text":"夏盖鱼龙旧两都，风涛千顷与之俱。\n凤毛终日在池上，云气有时生座隅。\n茶灶晚烟连翡翠，钓竿春雨拂珊瑚。\n岂同六逸清狂者，沈湎徂徕作酒徒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5367,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谢张彦恭","author":"张昱","text":"金注传来九世医，提携襁负满门楣。\n自来南渡称高手，党独咸阳爱小儿。\n汉史河源知共派，天家荆树是连枝。\n木桃犹望琼瑶报，谁谓酬医不费诗？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5368,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"朱家园海棠","author":"张昱","text":"天机人事每相催，谁到花前不举杯？\n车马园林春半后，丹青楼馆燕双回。\n锦帏睡足晨妆在，银烛烧残莫两来。\n昨夜綵云频入梦，朱家今见海棠开。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5369,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过王郎中草堂赋","author":"张昱","text":"药栏春暖牡丹香，蝴蝶双飞不过墙。\n万汇天机何处静，一年春事此时忙。\n篇诗未觉为时重，尊酒能留共日长。\n岂是辋川无作者，直邀裴迪赋山堂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5370,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"适轩，为致仕浙东宣慰使杨元诚赋","author":"张昱","text":"道义相忘乐有馀，贵施行与待何如？\n闲身已付蘧蘧蝶，暇日何妨小小车。\n蜂恋酒香留几席，花随日影到琴书。\n轩中定有何人到，弟子时常问起居。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5371,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"听莺轩","author":"张昱","text":"何处春来好听莺，谢家池馆越州城。\n绿杨垂地露烟重，红杏映帘风日清。\n醉把玉杯如有待，笑停锦瑟谩多情。\n却思旧过宫墙畔，著意马头啼数声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5372,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过鉴湖","author":"张昱","text":"风流数得贺家湖，观里黄冠是酒徒。\n笑出市垆留剑当，醉临秋水索花扶。\n当时未免呼狂客，后世犹堪励鄙夫。\n落日无从访陈迹，商声为我起菰蒲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5373,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"长安镇市，次赵文伯韵","author":"张昱","text":"淹遍衣衫酒未乾，何如李白醉长安？\n牡丹庭院漙新露，燕子帘栊过薄寒。\n春晚绝无情可托，日长惟有睡相干。\n旧题犹在轻罗扇，小字斜行不厌看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5374,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄王梧溪","author":"张昱","text":"仙舟曾记过南堂，鸣鸟高梧日正长。\n胡蝶重来春梦觉，牡丹欲尽燕泥忙。\n当时宾客知何往，此日音书或漫忘。\n犹有白头王粲在，独将词赋动江乡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5375,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题钟馗","author":"张昱","text":"梦以自见，正以辟邪。\n赐之袍笏，人耶鬼耶？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5376,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古辞","author":"张昱","text":"欢乐自欢乐，苦辛长苦辛。\n城中十万户，谁是种田人？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5377,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"风雨牧牛图","author":"张昱","text":"牧牛值风雨，牧具几脱手。\n不自风雨前，不自风雨后。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5378,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"石友","author":"张昱","text":"苍然柱石姿，风雨莓苔久。\n幸同贞固心，相看即吾友。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5379,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"竹居","author":"张昱","text":"百年驹过隙，万事成鞅掌。\n自顾非此君，谁与共清赏？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5380,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"花径","author":"张昱","text":"繁花作高树，狭径不数曲。\n醉来扶杖行，幽兴亦自足。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5381,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"蕉林","author":"张昱","text":"愁怀常把酒，爱此满林玉。\n风回舞袖翻，欲近纱窗绿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5382,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"芳屏","author":"张昱","text":"众芳结为屏，左右映红药。\n问讯园中人，何如金孔雀？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5383,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"蔬畦","author":"张昱","text":"学圃才两畦，佳蔬欲几品？\n露葵不厌烹，及我春酒醒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5384,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梨花折枝","author":"张昱","text":"已过清明节，犹依玉镜台。\n一枝如折得，几误蝶飞来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5385,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"水殿纳凉图","author":"张昱","text":"别殿红绡女，无风亦自凉。\n阑边是湖水，夜夜宿鸳鸯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5386,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"七夕","author":"张昱","text":"乞与人间巧，全凭此夜秋。\n如何针线月，容易下西楼？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5387,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"别刘博士","author":"张昱","text":"祇为情如雨，从教醉似泥。\n免看杨柳色，相送出城西。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5388,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"王昭君二首 其一","author":"张昱","text":"汉地非无雪，边城不见花。\n琵琶一万里，马上尽风沙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5389,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"王昭君二首 其二","author":"张昱","text":"巾帼犹知辱，裙钗可即戎。\n单于如有问，教妾若为容？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5390,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"铜雀台","author":"张昱","text":"自古谁无死，英雄岂不知？\n望陵歌舞歇，还有梦来时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5391,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"边思","author":"张昱","text":"万里尽风沙，征人念岁华。\n角声悲自语，谁见落梅花？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5392,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赤壁","author":"张昱","text":"赤壁不改色，汉江依旧流。\n二龙争战后，风月属扁舟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5393,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"峡川","author":"张昱","text":"石与青天近，浮云向客低。\n自然堪下泪，不是有猿啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5394,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题扬州史左丞画扇","author":"张昱","text":"后土祠前路，金鞍忆旧游。\n春风双燕子，浑似在扬州。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5395,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"塞上","author":"张昱","text":"朔风西北来，惊沙对面起。\n人马暗相失，咫尺已千里。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5396,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题商山观弈图","author":"张昱","text":"纵横十九路，一著一回新。\n如此深山许，旁观亦有人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5397,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题村庙","author":"张昱","text":"祸福凭谁降，鸡豚合有灾。\n年年当社日，箫鼓赛神来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5398,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"飞来峰","author":"张昱","text":"峰在西天竺，青莲千叶开。\n佛应无妄说，或恐是飞来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5399,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"呼猿洞","author":"张昱","text":"洞閟烟霞古，岩回藤蔓丛。\n谁能将剑术，往问白猿公。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5400,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题名石","author":"张昱","text":"东坡龙井回，题名塔砖上。\n岂期后百年，过者为瞻仰？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5401,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"合涧桥","author":"张昱","text":"两涧何年合，一桥终日闲。\n桃花逐流水，未觉是人间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5402,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"龙公洞","author":"张昱","text":"龙或藏其用，迹与蛇何异？\n惭愧耕稼人，犹来候云气。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5403,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"饭猿台","author":"张昱","text":"僧既非昔年，猿亦异往日。\n唯有饭猿台，犹是当时石。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5404,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"连岩栈","author":"张昱","text":"连岩有栈道，重叠架古木。\n勿轻纵步险，平地折车轴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5405,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客儿亭","author":"张昱","text":"客儿谢家子，明师梦相待。\n斯人骨亦朽，斯亭尚千载。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5406,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"坐禅石","author":"张昱","text":"法师禅定时，万象付冥漠。\n至今岩前石，每每天花落。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5407,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"邻墙梅花","author":"张昱","text":"腊后春才到，寒香袭素袍。\n梅花如有意，不在粉墙高。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5408,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻钟","author":"张昱","text":"朝撞亦悤悤，暮撞亦悤悤。\n销磨浮世事，都在数声中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5409,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"墨萱草","author":"张昱","text":"种得宜男草，忘忧度岁华。\n墨池怜照影，朵朵凤头花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5410,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"葛仙溪","author":"张昱","text":"葛仙浴丹溪，饮溪骨自蜕。\n试问归来鹤，何人寿千岁？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5411,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"济川图","author":"张昱","text":"平地有摧辀，慎者或不免。\n奈何千金躯，涉此风涛险。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5412,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"菊花","author":"张昱","text":"万夫起铜盘，拔地一千丈。\n宁知白露华，暗满菊花上。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5413,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"臧祥卿画竹枝白头禽扇面","author":"张昱","text":"片月出幽林，闲情欲不禁。\n天寒怜翠袖，为赋白头吟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5414,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西施洞","author":"张昱","text":"馆娃宫前洞，西施旧来往。\n自载扁舟后，岁岁春萝长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5415,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"履迹","author":"张昱","text":"西施往行处，好事作履迹。\n几寸莓苔深，见者为怜惜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5416,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"问梅","author":"张昱","text":"一种陇头树，东风都合吹。\n未应造物者，偏在向南枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5417,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"喜新晴","author":"张昱","text":"五色云间鹊，今朝忽放声。\n绕檐飞不去，亦是喜新晴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5418,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"泉月轩，为开元宫张道士赋","author":"张昱","text":"为贪真境好，每到即忘归。\n叩齿漱明月，清光生羽衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5419,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]