[{"title":"溪头晚归","author":"金涓","text":"野店春寒酒力微，溪云吹湿上人衣。\n山童不顾肩书重，犹折梅花带雪归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7205,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽兴","author":"金涓","text":"燕子飞来近画檐，暮春时节雨纤纤。\n杏花落尽无情绪，何处人家有酒帘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7206,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"范增","author":"金涓","text":"舞剑鸿门计不成，咸阳归路楚愁生。\n子房玉斗空撞碎，柰有陈平四万金。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7207,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"苏武","author":"金涓","text":"北海寒深雪满天，边云漠漠汉云连。\n将军不是麒麟种，争伴羝羊十九年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7208,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题蒲萄","author":"金涓","text":"汉使当年得种回，至今中国受栽培。\n秋风马乳颗颗熟，正可盈缸酿绿醅。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7209,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"精卫操","author":"郭翼","text":"东海水虽大，精卫心不移，衔石填海有满时。\n有满时，海有底，吁嗟人心不如海。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7210,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"花游曲和铁崖韵","author":"郭翼","text":"石池天地花溟濛，芙蓉暖红旗飐风。\n锦艚两帆出云里，玉滟摇溶养龙水。\n宝坊壁堂山入门，琼琚杂佩飘轻裙。\n馆娃愁绝行春步，青狐泣冷鸳鸯墓。\n铁蛟喷壑风雨来，花宫香送琼英杯。\n玉粒松膏粉云椀，小扇桃歌紫牙板。\n苧萝烟断东海西，双珰椷札近新题。\n青鸟不来无信使，玉雁衔丝啼十四。\n真珠字密愁满笺，为君重赋《花游》篇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7211,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和顾子达见寄二首 其二","author":"郭翼","text":"君住同丘似同谷，閒身应是笑官忙。\n梅花有兴吟东阁，萱草无忧树北堂。\n谩省观鱼庄叟乐，谁怜歌凤接舆狂。\n相看马困盐车日，何处悲鸣觅九方。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7212,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻吕敬夫移居五首 其一","author":"郭翼","text":"忆汝秋来信使稀，移家未睹是耶非。\n月星绕树乌三匝，风雨横江雁独飞。\n岂为故人居赤甲，还从野老款荆扉。\n东西扰扰皆为客，琴剑空惭坐不归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7213,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻吕敬夫移居五首 其二","author":"郭翼","text":"詹尹何劳更决疑，衡门之下可栖迟。\n竹从少傅韦家觅，树向果园坊里移。\n翡翠小堂巢窄窄，鸥鶄近渚槛垂垂。\n主人一任悬徐榻，更拟风流醉习池。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7214,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻吕敬夫移居五首 其三","author":"郭翼","text":"卜筑因同野老居，家贫犹有五车书。\n从人更买青田鹤，入馔频供丙穴鱼。\n谢朓能诗多警策，嵇康懒性且粗疏。\n江头树里晴云出，日日看山候小车。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7215,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻吕敬夫移居五首 其四","author":"郭翼","text":"馀暑醉人犹困酒，秋风秋雨下朝朝。\n颇闻蒋诩开三径，未识将军第五桥。\n月里芙蓉催放艇，天头鸾鹤待鸣箫。\n海乡应讶文星聚，莫以寻常折简招。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7216,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻吕敬夫移居五首 其五","author":"郭翼","text":"雨映清秋解郁陶，无端舒啸倚东皋。\n终怀楚国屠羊肆，已愧江州食犬牢。\n五夜新凉吹枕几，十年旧梦落波涛。\n老来亦慕归耕好，田屋芃芃黍豆高。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7217,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"巴城秋暮","author":"郭翼","text":"巴城湖头日欲曛，巴王殿下水如云。\n渔船归去打双桨，鸥鸟翻回飞一群。\n野旷天开秋历历，霜清木落雨纷纷。\n杜陵飘泊谁知己，搔首风尘正忆君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7218,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题景德寺樱桃","author":"郭翼","text":"上人醉卧樱桃发，客至不知山日斜。\n粲然五□庭下雪，开作小白岩前花。\n仙女吹笙□□密，背痒欲倩麻姑爬。\n□□□□□□□，□□□□□□□。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7219,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"书声斋","author":"郭翼","text":"幽人一室开风露，坐想瀛洲玉为署。\n把书夜诵秋满空，徘徊花影蟾蜍树。\n莲叶艇子风泠泠，太乙下照藜火青。\n笙簧万耳洗不醒，漻哉太音谁得听。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7220,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪后游华藏寺","author":"郭翼","text":"快雪时晴西日微，阴阴碧殿锁林扉。\n山中白云好留客，枝上野梅寒拂衣。\n经床无风花自落，琼田如海鹤争飞。\n诸郎授简皆能赋，况复东林此会稀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7221,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登文笔峰","author":"郭翼","text":"借得登山灵运屐，乾坤眺望倚巑岏。\n上方日落楼台碧，积雨春深草木寒。\n战马中原连万国，风樯巨海隔三韩。\n寥寥宇宙怀今古，堕泪之碑几度看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7222,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄于彦成兼柬玉山","author":"郭翼","text":"匡庐道士三尺强，手援北斗酌桂浆。\n露气朝开玛瑙瓮，丹光夜落芙蓉床。\n崆峒仙人广成子，鉴湖狂客贺知章。\n主人种梅已成屋，忆尔看云眠草堂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7223,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴","author":"郭翼","text":"三月既望出北郭，草堂樽俎特风流。\n戴花一任巾帻岸，酌酒且将车辖投。\n肮脏倚门徒自惜，慵疏与世岂无谋。\n青春正好莫嫌晚，取次习家池上游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7224,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日有怀二首 其一","author":"郭翼","text":"二月作客杨家巷，东望沧浪眼欲醒。\n云楼吐气蛟蜃紫，海户送色蓬莱青。\n也知奔走非我事，直以疏慵任性灵。\n别后忆君兼日夜，满江风雪况如馨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7225,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"玉山草堂","author":"郭翼","text":"玉山草堂谁比数，风流不减浣溪头。\n碧梧翠竹一个个，鹭鸶鸂鶒两悠悠。\n吹笙子晋寻常过，爱酒山公烂熳游。\n但道幽栖嫌早计，须君更上凤麟洲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7226,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再题","author":"郭翼","text":"玉山草堂趣绝殊，风烟白日路萦纡。\n寄诗未答高常侍，簇马或迎严大夫。\n花径埽晴当晚雪，桤林移雨接春湖。\n主人结搆知幽寂，还约看山傍酒壶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7227,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拜石坛","author":"郭翼","text":"伟兹秀石奇而雄，亿千万年寿作朋。\n何年天公召雷公，下驱六丁凿混沌，巨斧落手惊飞龙。\n初疑帝遣神鳌首戴海上之青峰，又疑星蕊堕地变化为芙蓉，神物之神固有冯。\n一朝当变迁，霹雳千丈崩。\n左股臂折卧棘蓬，虎头颠绝如南宫。\n作坛置之众不惊，如在培塿视华嵩。\n题识况重仇池翁，仇池雪浪空玲珑。\n丹丘白野拜下风，嗟哉天地生物功。\n一成一毁无终穷，人之显晦靡不同。\n吾尝视天唯梦梦，贵贱寿夭初无定。\n幽人采薇穷谷中，石也幸尔千载逢。\n能令人拜坛再登洛阳丘墟牛李死，甲乙零落平泉空。\n沟中之断爨下桐，荆山玉气吐长虹。\n贺尔遭也天所蒙，贺尔遭也天所蒙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7228,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"白云海","author":"郭翼","text":"青田生鹤子，随母青田飞。\n母飞向天去，玄裳缟其衣。\n千年归来华表鹤，鹤雏悲鸣西日落。\n好将商墓寺前云，飞还直过青山郭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7229,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄马敬常","author":"郭翼","text":"奈尔相如好赋何，老怀犹得慰蹉跎。\n五侯冠盖殊皆贵，百世文章自不磨。\n沙漠黄云龙去远，江湖秋水雁飞多。\n旌旄海上重开府，还拟扁舟雪夜过。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7230,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"荷亭晚坐寄悦堂长老","author":"郭翼","text":"海上无家来避寇，行吟何处可消忧。\n看荷偶到东林寺，落日浑如丈八沟。\n云叶层阴青过岸，草堂五月澹于秋。\n老子情深能爱客，更拟花开一醉留。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7231,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"昆山即事寄友人","author":"郭翼","text":"人家绕郭连凫雁，井落荒凉接野坰。\n湓渎雨来秋水暗，马鞍云尽暮峰青。\n宿草屡过刘君墓，紫藤长倚范公亭。\n结邻最晚还相并，海上长嗟处士星。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7232,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"同敬常泛娄江","author":"郭翼","text":"春江一番游春艇，澹沲青山东复东。\n杨柳孤村寒食雨，流莺百啭落花风。\n卷题宫锦驼泥紫，杯泛仙桃枸杞红。\n铁龙后夜来同听，拟借琴高赤鲤公。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7233,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"苍筤竹轩","author":"郭翼","text":"清风峡上苍筤竹，个个绕轩阴满庭。\n秋声夜觉烟波远，云气晓拂鉴湖清。\n亲题白野尚书额，好勒金华太史铭。\n老去几时探禹穴，与子同蹑凤凰翎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7234,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绿阴亭","author":"郭翼","text":"绿阴亭上夏五月，瀛洲上客与俱来。\n日出众鸟绕屋语，竹深好花当户开。\n镜里水涵萍似粟，席间云落酒如苔。\n更贪贺监清狂甚，艇子朝朝暮暮回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7235,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"放生池","author":"郭翼","text":"放生池馆信奇哉，面面芙蓉夹坐开。\n户外香烟浮翡翠，殿头云气接蓬莱。\n曾闻子晋吹笙过，或遇安期送枣来。\n羽客步虚明月夜，佩环锵玉下层台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7236,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"渔庄","author":"郭翼","text":"山色桃花里，渔庄信少双。\n鸥群回落日，鱼笱聚深矼。\n杨柳秋开屋，蒹葭雨满江。\n野翁归醉晚，水没系船桩。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7237,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春波曲","author":"郭翼","text":"妾家红蕖曲，绿水春满满。\n鸂鶒不肯飞，双栖落花暖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7238,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"箫史赵信卿谒玉山昆季且欲登碧梧翠竹之堂诗以道其行","author":"郭翼","text":"金粟池头花皓皓，绿阴亭下树冥冥。\n一曲重闻箫史过，月明忆上凤凰翎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7239,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游仙词八首 其一","author":"郭翼","text":"银流万里海云东，只泛灵槎上碧空。\n仙女踏歌星影里，老龙吹笛浪花中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7240,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游仙词八首 其二","author":"郭翼","text":"金粟天南碧殿云，镜中空影夜氤氲。\n白鸾树下三千女，一色龙绡玉雪裙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7241,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游仙词八首 其三","author":"郭翼","text":"令威化鹤已千春，华表归来是后身。\n城郭悲歌荒冢在，到头应愧学仙人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7242,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游仙词八首 其四","author":"郭翼","text":"白鹤下啄瑶草庭，道士夜读神农经。\n问之长生有宝诀，授以松根千岁苓。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7243,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游仙词八首 其五","author":"郭翼","text":"溪水流香饭熟麻，洞中千树玉桃花。\n金盘日日飞仙供，敕赐安期海上瓜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7244,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游仙词八首 其六","author":"郭翼","text":"郁萧台上会群仙，龙烛飞光晓夜燃。\n玉殿归来环佩冷，白云犹护古苔篇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7245,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游仙词八首 其七","author":"郭翼","text":"麟洲宫殿五云高，夜赴瑶池宴碧桃。\n借得仙人红尾凤，月中飞影拂波涛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7246,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游仙词八首 其八","author":"郭翼","text":"钧天按乐乐蓬瀛，手把芙蓉朝太清。\n一曲《霓裳羽衣舞》，仙家只数董双成。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7247,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题云间徐希哲竹庭卷","author":"郭翼","text":"轩外閒亭百步宽，不栽桃李尽琅玕。\n幽深自与尘氛远，潇洒偏禁雨雪寒。\n湘浦夜涛欹枕听，渭川晴色卷帘看。\n春来更爱儿孙长，玉立森森拟谢兰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7248,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"清真观","author":"郭翼","text":"放生池上应五月，烂熳花开坐夜长。\n月出金盘擎露影，天高玉井散秋香。\n云边小溆瀛洲近，镜里微波太液凉。\n准拟王乔借飞舄，仙游从此恣翱翔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7249,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题张戡画瘦马图","author":"郭翼","text":"瘦骨锋棱珠汗落，卧痕半杂古苔烟。\n未脱将军金匼匝，又驮儿女玉婵娟。\n苍黄日色龙沙外，惨澹秋声雁塞前。\n神骏只今谁貌得，开图老眼一醒然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7250,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"燕娄东园分韵得五字","author":"郭翼","text":"苕苕望瀛洲，流云下东渚。\n笛教仙人借，酒使文君取。\n筼筜写林绿，菡萏发江雨。\n煌煌金闺姿，天动星文聚。\n华辞播兰?，繁价登琼珇。\n龙锷秋涛净，凤羽云色五。\n燕敖亦云畅，驩集那得屡。\n骄骢蹋晚辔，阁门凉月举。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7251,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄郯九成怀铁崖且闻有挟璚花赴倪云林之约就柬","author":"郭翼","text":"府中从事近将书，只道清狂事事无。\n雪艇不来邀陆倩，云林直去看倪迂。\n醉时自舞铁如意，愁里休歌玉唾壶。\n扬子草堂频有约，速来满眼为君酤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7252,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江水辞二章 其一","author":"郭翼","text":"江水一百里，送君君去时。\n丁宁桃叶渡，莫唱渡江辞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7253,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江水辞二章 其二","author":"郭翼","text":"江水一百里，江流七十盘。\n初三弦上月，相忆照湾环。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7254,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题宋高宗诗便面","author":"郭翼","text":"康邸龙飞日，中原不可支。\n乘舆犹北狩，泪湿画中诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7255,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江南曲","author":"郭翼","text":"江南暄新花月天，美人盘游缓愁年，翠环娇春扶上船。\n扶上船，月如水。\n霞盖车，度花里。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7256,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游女曲","author":"郭翼","text":"麝衣宝珞花氤氲，芙蓉小衩金鹅裙，流目艳艳思若云。\n思若云，可怜娇。\n玉条脱，金步摇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7257,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"采莲曲","author":"郭翼","text":"青溪小姑双婵娟，蓬蓬荷叶金桨船，含情戏采并目莲。\n并目莲，为郎喜。\n刺满茎，伤玉指。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7258,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"采菱曲","author":"郭翼","text":"湖湾小妇歌采菱，荡舟曲曲花相迎，花开镜里摇明星。\n摇明星，妒华月。\n郎不归，怨花发。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7259,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"凤台曲","author":"郭翼","text":"闻道嬴家女，吹箫入紫云。\n如何凤台上，不栖祖龙君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7260,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"淮南王曲","author":"郭翼","text":"汉武好神仙，淮南去不还。\n徒令风雨客，感慨茂陵阡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7261,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"独漉篇","author":"郭翼","text":"求禄求禄，清白不浊。\n清白尚可，贪污杀我。\n明明日月，丽乎太清。\n明君当宁，明臣在廷。\n赏不虚功，刑必当罚。\n孰将溷溷，我宁察察。\n濯乎不洿，皭乎不缁。\n暮夜之金，弗替于怀。\n幸甚至哉，歌以言志。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7262,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自君之出矣 其一","author":"郭翼","text":"自君之出矣，花开又花谢。\n思君如日月，耿耿昼复夜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7263,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自君之出矣 其二","author":"郭翼","text":"自君之出矣，徒写零落耳。\n思君如车轮，辗转愁不已。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7264,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自君之出矣 其三","author":"郭翼","text":"自君之出矣，琴瑟何曾御。\n思君如落叶，萧瑟悲秋暮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7265,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"明镜篇","author":"郭翼","text":"开镜珠玑匣，盘龙百鍊金。\n使君持照妾，不解照君心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7266,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"采莲曲","author":"郭翼","text":"莲子复莲子，苦心郎不尝。\n为郎剥莲子，莲子忆空房。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7267,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题柯敬仲梅花竹石图","author":"郭翼","text":"夜寒起坐看龙影，金阁罘罳小殿东。\n梦觉香吹梅子树，玉文堂上月方中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7268,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题李遵道小寒林图","author":"郭翼","text":"溪泉溪树满春青，写入桃源翡翠屏。\n杨子风流那可得，为渠安个铁厓亭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7269,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题倪元镇画云林图","author":"郭翼","text":"郁郁倦时燠，云汉雨如洗。\n美人既云遘，胡宁不忻喜。\n微烟升夕树，鲜月度秋水。\n人生岂所适，所适正在尔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7270,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]