[{"title":"雨中怀李孟和","author":"蓝智","text":"热病数日不能起，凉天一蝉徒自悲。\n无衣但恐霜雪盛，有酒不忧筋力衰。\n绿苔晚雨荒书屋，黄叶秋风动鬓丝。\n颇讶故人音问绝，经句不见李陵诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10152,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟泊延平怀刘仲祥","author":"蓝智","text":"秋日泊船镡津口，城头高阁风泠泠。\n潜蛟在涧水常黑，疏雨隔溪山正青。\n何人望气求双剑，处士闭门谈六经。\n文公精舍倚南郭，一荐芳洲蘋藻馨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10153,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日怀萧抱灌","author":"蓝智","text":"牢落空悲北士心，凄凉犹忆草堂吟。\n西山夜雨怀人远，南浦春波战血深。\n紫燕青云多适意，朱弦白雪少知音。\n干戈满地风尘暗，抱瓮惟堪老汉阴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10154,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"暮春奉怀李葛二先生","author":"蓝智","text":"广文好客能赊酒，令尹休官尚转蓬。\n独鹤不归沧海上，双凫犹在白云中。\n仲舒经术传三策，杜甫文章跨数公。\n独立晴沙最相忆，落花飞絮满东风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10155,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄牛牧子","author":"蓝智","text":"闻向清溪隐太和，幔亭仙掌翠嵯峨。\n君臣药就黄芽熟，道德书成紫气多。\n屡许秋风分枸杞，长怀明月共渔歌。\n归来检点青囊秘，瑶草春深满涧阿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10156,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄李谨之","author":"蓝智","text":"露下梧桐爽气浮，天低河汉近高楼。\n西风鼓角凄凉夜，落日山川惨澹秋。\n尚忆鹿门堪避世，祇惭燕颔未封侯。\n海波东去三山远，剑气徒劳望斗牛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10157,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游井水原寄刘士元熊孟秉","author":"蓝智","text":"连山西来群马奔，下有流水如桃源。\n故家尚想衣冠盛，乔木徒悲丘垄存。\n天际断云横翠黛，沙头疏雨送黄昏。\n庐峰隐者相邻并，松菊萧萧对掩门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10158,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄陈朝玉","author":"蓝智","text":"经年不见陈文学，孤负茅檐浊酒杯。\n黄叶满窗风雨至，尺书千里雁鸿来。\n世乱固应为士贱，好怀那得为君开。\n正思春水扁舟好，拟看扶桑海上回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10159,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟次北津奉寄李复礼葛元哲二先辈","author":"蓝智","text":"清晨行李出西郭，日午泊船当北津。\n白沙翠竹自成径，紫燕黄莺时近人。\n五年戎马未休息，九曲樵渔甘隐沦。\n安得比邻如李葛，狂歌痛饮度青春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10160,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄张孟方","author":"蓝智","text":"屏山乔木翠参天，共爱风流长史贤。\n古篆龙蛇金作刻，遗经蝌蚪竹为编。\n慈亲鹤发垂霜柏，道士鹅群戏墨泉。\n今代法书称赵杜，他年重见笔如椽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10161,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"郑居贞别驾归閒未久又以明经赴召因敬题春江别意图为饯","author":"蓝智","text":"谷口归来未及耕，春风又送趣装行。\n应知经术怀匡济，不许山林避姓名。\n此日仙舟真惜别，何年诗社更寻盟。\n黄河泰华如重览，满路棠阴旧政声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10162,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送夏志衡检校赴省兼柬仲晦","author":"蓝智","text":"风尘一剑静边隅，松菊空山尚隐居。\n入幕共推毛义檄，专门自守夏侯书。\n秋高岛屿潮声壮，日落江湖雁影疏。\n若见吾宗贤检校，为言疏懒寄樵渔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10163,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄方壶高士","author":"蓝智","text":"方壶东望隔沧溟，白发犹传隐者名。\n五岳云霞开小景，三天符箓注长生。\n虎龙气合调金鼎，鸾鹤声多送玉笙。\n为问蓬莱清浅未，麻姑何处候方平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10164,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄泉峰纯一处士","author":"蓝智","text":"白发高居不出村，曾从师老探奇文。\n捲帘黄叶千峰雨，绕屋灵芝五色云。\n丹鼎夜寒添石火，牙签日暖换窗芸。\n幔亭时有仙人过，松下焚香望鹤群。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10165,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄欧阳雪舟高士","author":"蓝智","text":"夜戴星辰觐紫微，晓裁云雾作仙衣。\n共传函谷青牛去，独跨庐山白鹤归。\n洒笔梅香翻墨沼，捲帘松翠落金徽。\n隐山茅屋扁舟小，定有高人款竹扉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10166,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"武夷道中寄山中道友","author":"蓝智","text":"丹山碧水漾清晖，尽日经行径路微。\n野老筑场收稼早，溪翁举网得鱼肥。\n青天万里飞云尽，黄叶千峰独鸟归。\n为报西山彭道士，月明今夜叩柴扉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10167,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题茅山道士张伯雨诗卷","author":"蓝智","text":"江东道士张伯雨，灵书曾授大茅君。\n瑶台鹤梦三清露，玉洞龙文五色云。\n碧落空歌来幻眇，黄庭梵气结絪缊。\n武夷别有宾云奏，不共清猿月下闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10168,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日西山怀虚白先生","author":"蓝智","text":"羽人曾共住丹丘，风雨重来又暮秋。\n红叶闭门山寺静，白云留客野亭幽。\n千年海鹤无消息，九日山尊有献酬。\n日暮鹡鸰飞去急，玉笙何处恨悠悠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10169,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄程伯莱教授","author":"蓝智","text":"广文家在大江东，官冷时时叹转蓬。\n读易夜分松寺月，鸣琴春度杏坛风。\n久知杜甫诗徒苦，应笑扬雄赋未工。\n翰墨交游今绝少，一生襟抱几人同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10170,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寿南山邑长","author":"蓝智","text":"三年北阙登黄榜，一日南山卧白云。\n谁信陶潜贫嗜酒，自知贾谊少能文。\n山城闻雁惊春早，客舍囊萤坐夜分。\n九曲桃花今烂漫，扁舟好访武夷君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10171,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中喜刘俊民孔克逊相过","author":"蓝智","text":"茅檐高卧养微疴，远辱将军并辔过。\n山色更兼微雨好，莺声偏傍落花多。\n惭无鸡黍频供给，喜有渔梁共啸歌。\n孔氏诸孙尤好学，古书蝌蚪近如何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10172,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"鍊药斋中喜明远宪使相过","author":"蓝智","text":"日长鍊药坐空斋，远荷高情枉骑来。\n兔捣玄霜天上剂，蚁浮清露掌中杯。\n春云覆屋丹初熟，暮雨钩帘鹤自回。\n千岁崆峒未华发，喜瞻南极近三台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10173,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次张云松山行韵","author":"蓝智","text":"行上西峰眼界宽，白云红树久盘桓。\n纫兰自作幽人佩，拾橡还随野老餐。\n秋尽未苏南国瘴，日斜空觉北风寒。\n道人卖药归来晚，留宿松轩一榻安。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10174,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游天壶道院呈周叔亮佥宪","author":"蓝智","text":"偶向武夷寻道士，还如刘阮入天台。\n渔舟日暮桃花雨，仙馆春深竹叶杯。\n千岁丹砂龙虎伏，五云箫管凤凰来。\n酣歌更挹浮丘伯，并坐中天百尺台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10175,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"经郭先生平川旧居","author":"蓝智","text":"皓首明时秖布衣，孤坟宿草又斜晖。\n尘埃几杖遗书尽，风雨园林旧业非。\n九曲月明猿自吊，三山秋晚鹤空归。\n多情惟有门前水，春色年年上钓矶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10176,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"经杜徵君故居","author":"蓝智","text":"废宅重过忆隐君，閒门秋草漫纷纷。\n翰林一日承丹诏，文冢千年閟白云。\n坏壁尘埃封鸟篆，空山风雨失龙文。\n子孙零落遗书尽，何用清名后代闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10177,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽江惟志学佛坐解 其一","author":"蓝智","text":"儒者推宗墨者师，何论削发与披缁。\n词场星斗声名远，心印虚空慧定随。\n已见藜床安坐逝，长怀莲社失前期。\n生刍拟向门人哭，大笔谁书有道碑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10178,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽江惟志学佛坐解 其二","author":"蓝智","text":"适世谁知隐者庐，闭门自译化人书。\n勤修真观宗天竺，倦送才名入石渠。\n同郡每询为况好，昨朝传得讣音初。\n衰容未悟无生理，霜木晨星百感馀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10179,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"滁州赠詹齐之","author":"蓝智","text":"君趋京国凡三仕，我向山林滞一生。\n放逐共为千里客，艰危相倚十年兄。\n镜中白发年空老，囊里黄金日渐轻。\n南望乡关心已折，西风树树动秋声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10180,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题廖监河行轴","author":"蓝智","text":"王制昔闻书泽禁，圣朝今见设渔官。\n壮龄膴仕荣新授，鏖战成功带旧瘢。\n网罟既征田赋减，舟航兼算水程宽。\n瓜时正及秋风起，一鹗扶摇九万抟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10181,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送卢宪副持节海南","author":"蓝智","text":"三年独爱山居好，万里今传使节来。\n南极风霜清岭海，中天日月照蓬莱。\n州连铜柱山多瘴，水接朱崖地有雷。\n从此遐荒重裳衮，文星早晚近三台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10182,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"望三山庵雪舟高士","author":"蓝智","text":"落日维舟石鼓村，道傍茅屋几家存。\n云开玉女支机石，雨过金公种橘园。\n鸡大曾闻升碧落，豺狼欲出傍黄昏。\n山阴道士遥相忆，乘兴何由一叩门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10183,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄伯颖元帅","author":"蓝智","text":"细柳营新列战艘，刺桐花暖映征袍。\n风行瀚海鲸波静，云压秋城鸟阵高。\n泽国微霜催橘柚，管弦清夜送葡萄。\n风流太守如相问，为说山林已二毛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10184,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"书田舍壁","author":"蓝智","text":"桑麻晓色连南浦，松桂春阴覆北窗。\n翠石琅玕分个个，晴沙鸂鶒并双双。\n桃花浪暖收鱼罟，竹叶香浓倒蚁缸。\n况有老翁将稚子，居人疑是鹿门庞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10185,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"招黄慎之东林宴集","author":"蓝智","text":"松门石径扫苍苔，休日题书报客来。\n对雨特迂高士驾，看山先具野人杯。\n黄花酒熟从教醉，白发诗成不用催。\n人事寂寥同调少，百年今日笑颜开。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10186,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"七月二十八夜同巢翁石父燕集玄都道院中是日雷雨昼晦既夕星月烂然席上有作","author":"蓝智","text":"偶与高人宴武夷，天空山水漾晴辉。\n金盘晓露葡萄酒，玉女秋风薜荔衣。\n雷起石堂龙未蛰，月生沧海鹤初归。\n瑶台自有长生箓，莫叹尊前往事非。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10187,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"小轩得白石玉雪不足喻置之竹泉石间大可人意也因邀云松同赋","author":"蓝智","text":"拾得他山玉一团，光华偏映读书轩。\n乍惊残雪留花砌，久讶明星浸石盆。\n何处琢来秋水骨，半空吹落白云根。\n诗癯自拟连城价，不共歌牛月夜村。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10188,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽雪舟炼师 其一","author":"蓝智","text":"三年屡报枉柴门，一日俄传起土坟。\n棺举空衣无弟子，匣藏遗剑有诸孙。\n鉴湖一曲秋风兴，庾岭千枝夜月魂。\n化鹤纵归华表上，人民城郭更堪言。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10189,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽雪舟炼师 其二","author":"蓝智","text":"城西庵里托空衣，无复扁舟到武夷。\n壁上梅花空故物，水边茅屋认题诗。\n骑驴张果游何处，放鹤林逋几时。\n耆旧凋零交谊少，秋风吹老北山芝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10190,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山居书怀","author":"蓝智","text":"卜宅南村久未成，从来堂构在留情。\n也知燕贺争先集，应笑鸠居拙自营。\n环堵晚晴思傅筑，岩阿春暖候庞耕。\n临池更凿观书牖，时得摩挲老眼明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10191,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答陈道原见寄山居诗韵","author":"蓝智","text":"少年自许万人雄，肯念林居野兴同。\n饭颗诗成惭杜子，鹿门老去忆庞公。\n青山白水宜春月，紫燕黄鹂共晚风。\n兴发会随田父饮，放歌未觉酒尊空。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10192,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题刘正椿桂图","author":"蓝智","text":"灵椿丹桂人间少，又说君家报施深。\n三世传忠书满屋，一门积善杏成林。\n功名谁似幽人志，廿旨宁违孝子心。\n野老久无城府迹，披图还欲远相寻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10193,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日试笔","author":"蓝智","text":"隔水黄鹂时一鸣，近人蝴蝶亦多情。\n孤城暮雨丝丝细，高阁春云片片轻。\n杜甫自知诗作祟，陶潜深仗酒为名。\n未传江汉休兵甲，厌听东风鼓角声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10194,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"暮春雨中偶成","author":"蓝智","text":"干戈扰扰青春暮，云雾纷纷白日迷。\n千里江淮谁饮马，五更风雨独闻鸡。\n徒劳剑气冲牛斗，无复星文聚壁奎。\n九曲桃花春水绿，白鸥还许共清溪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10195,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"兵后窥小园","author":"蓝智","text":"已无篱落护莓苔，时有邻人共往来。\n桑柘总因斤斧废，菊花空对草堂开。\n云横关塞馀兵气，水落城池尽劫灰。\n况是荒郊多白骨，天阴鬼哭转堪哀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10196,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"破屋 其一","author":"蓝智","text":"坏屋颓垣藤蔓垂，书签药裹乱蛛丝。\n茅茨又费三年筑，风雨应烦一木支。\n野老许分林屋住，故人谁寄草堂赀。\n玄经自笑扬雄苦，门掩寒云有所思。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10197,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"破屋 其二","author":"蓝智","text":"破屋三间不自聊，西风篱落草萧萧。\n图书满座嗟撩乱，车马何人问寂寥。\n四壁秋声连蟋蟀，一枝寒雨共鹪鹩。\n欲知环堵家家乐，愿见兵戈处处销。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10198,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜雨","author":"蓝智","text":"稻粱漠漠秋风老，茅屋潇潇夜雨多。\n一点苏枯今不及，数重漏湿欲如何。\n百年又迫饥寒际，十口曾因丧乱过。\n欲往南山访黄绮，云深何处紫芝歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10199,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题秋山访隐图","author":"蓝智","text":"草堂忽有故人寻，野店山桥转石林。\n渺渺白云行径远，萧萧黄叶闭门深。\n脱巾自漉床头酒，卖药新修壁上琴。\n世事匆匆良会少，一宵论尽十年心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10200,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋宿南山别墅","author":"蓝智","text":"南山雨过未成泥，自起携锄种药畦。\n屏迹免教时论及，虚心真觉物情齐。\n鱼知涧藻须深入，鸟畏风枝不受栖。\n明月满窗谁共宿，白云红树老猿啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10201,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"喜南邻携酒","author":"蓝智","text":"柴门地僻长苍苔，惭愧比邻数往来。\n四壁蓬蒿贫士宅，孤村风雨故人杯。\n书签药裹应成癖，水鸟山花莫漫猜。\n万事形骸俱拨置，百年怀抱为君开。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10202,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日山居","author":"蓝智","text":"少日题诗自笑狂，老怀对酒便相忘。\n梨花落尽春将晚，燕子飞时日正长。\n西谷诛茅应更僻，南园种药未全荒。\n客来莫怪陶然醉，懒看浮云上下忙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10203,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"有感","author":"蓝智","text":"五十知非六十衰，怀才祇合奋当时。\n莫将贾谊几年少，自识冯唐值数奇。\n奔竞渐回廉耻俗，老成早作太平基。\n白头灭迹空山里，未用长歌觅紫芝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10204,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日病中","author":"蓝智","text":"茅屋黄花共寂寥，病容诗思总无聊。\n山童夜静分松火，道士天寒送药苗。\n落木荒陂秋澹澹，鸣鸡空馆雨潇潇。\n仙家瑶草年年长，弱水蓬莱路更遥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10205,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过巢云故亭","author":"蓝智","text":"门前豫章大十围，野桥流水相因依。\n天晴茅竹数峰出，春暖桃花双燕飞。\n风高隐几闻伐木，日暮杖藜歌采薇。\n杜陵旧业无处问，溪上草堂今是非。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10206,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"元日新春试笔","author":"蓝智","text":"西山积雪未全消，又送东风上柳条。\n凤历颁春元正日，鸡筹报晓大明朝。\n近闻泰畤仍遵汉，远忆华封祇颂尧。\n柏酒一杯谁共醉，弟兄相对老渔樵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10207,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"蓝原道中","author":"蓝智","text":"青山西上是蓝田，野草残花共怆然。\n春日园林非旧主，夕阳丘陇有新阡。\n百年乔木今犹在，先代遗书许共传。\n欲向空林荐蘋藻，断碑无字卧寒烟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10208,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日建安开元寺登高得微字韵","author":"蓝智","text":"古木寒溪入翠微，西风九日扣禅扉。\n金银宫阙生秋草，锦绣山河下夕晖。\n陆羽泉荒龙已去，吕蒙祠古鸟空归。\n诸公且尽登临兴，莫叹尊前往事非。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10209,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题道山亭","author":"蓝智","text":"江国凉风白雁初，道山秋色野亭虚。\n天连海水蓬莱近，霜落汀洲橘柚疏。\n北望每怀王粲赋，南游空上贾生书。\n四郊但愿休戎马，独客何妨老钓鱼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10210,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"同程芳远游东林寺","author":"蓝智","text":"东冈石上松林青，偶与白云来此行。\n老僧下榻雨花散，古寺闭门秋草生。\n八月风高万籁急，双溪日落千山明。\n归去桥西一回首，重林杳缈隔钟声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10211,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]