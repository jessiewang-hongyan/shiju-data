[{"title":"听袁子方弹琴","author":"倪瓒","text":"蕙帐凝夕清，高堂流月明。\n芳琴发绮席，列坐散繁缨。\n回翔别鹄意，缥缈孤鸾鸣。\n一写冰霜操，掩抑寄馀情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1304,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀归","author":"倪瓒","text":"久客怀归思惘然，松间茆屋女萝牵。\n三杯桃李春风酒，一榻菰蒲夜雨船。\n鸿迹偶曾留雪渚，鹤情原只在芝田。\n他乡未若还家乐，绿树年年叫杜鹃。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1305,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"垂虹亭","author":"倪瓒","text":"虚阁春城外，澄湖暮雨边。\n飞云忽入户，去鸟欲穷天。\n林屋青西映，吴松碧左连。\n登临感时物，快吸酒如川。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1306,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"荒村","author":"倪瓒","text":"踽踽荒村客，悠悠远道情。\n竹梧秋雨碧，荷芰晚波明。\n穴鼠能人拱，池鹅类鹤鸣。\n萧条阮遥集，几屐了馀生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1307,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桂花","author":"倪瓒","text":"桂花留晚色，帘影淡秋光。\n靡靡风还落，菲菲夜未央。\n玉绳低缺月，金鸭罢焚香。\n忽起故园想，泠然归梦长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1308,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄熙本明二首 其一","author":"倪瓒","text":"在山无事入城中，每问归樵得信通。\n松室夜灯禅影瘦，石潭秋水道心空。\n幽扉独掩林间雨，疏磬遥传谷口风。\n几度行吟欲相觅，乱流深涧隔西东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1309,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画赠王仲和","author":"倪瓒","text":"曾住南湖宅，于今已十年。\n丛筠还自翳，乔木故依然。\n雨杂鸣渠溜，云连煮朮烟。\n何时重相过，烂醉得佳眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1310,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"己卯正月十八日与申屠彦德游虎丘得客字","author":"倪瓒","text":"余适偶入城，本是山中客。\n舟经二王宅，吊古览陈迹。\n松阴始亭午，岚气忽敛夕。\n欲去仍徘徊，题诗满苔石。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1311,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丙子岁十月八日夜泊阊门将还溪上有怀友仁陆徵君","author":"倪瓒","text":"明发辞吴会，移舟夜淹泊。\n空宇垂繁星，微云暝前郭。\n沈沈抱冲素，悄悄伤离索。\n归扫松径苔，迟君践幽约。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1312,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"戊寅十二月丹丘柯博士过林下赋诗次韵酬答","author":"倪瓒","text":"积雪被长坂，卧痾守中林。\n山川虽云阻，舟楫肯见寻。\n倾盖何必旧，相知亦已深。\n惊风飘枯条，清池冒重阴。\n联翩双黄鹄，飞鸣绿水浔。\n顾望思郁纡，徘徊发悲吟。\n愿言齐羽?，金石固其心。\n欢乐何由替，黄发期满簪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1313,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"刘君元晖八月十四日邀余玩月快雪斋中命余诗因赋","author":"倪瓒","text":"卷帘见月形神清，疑是山阴夜雪明。\n长歌欲觅剡溪戴，怅然停杯远恨生。\n尔营茅斋名快雪，邀我吹笙弄明月。\n明星如银浮翳消，垂露成帷桂花发。\n酒波荡漾天河倾，笙声袅袅秋风咽。\n古人与我不并世，鹤思鸥情迥愁绝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1314,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"早春对雨寄怀张外史","author":"倪瓒","text":"林卧苦泥雨，忧来不可绝。\n掀帷望天际，春风吹木末。\n飞萝散成雾，细草绿如发。\n念子独高世，南山修隐诀。\n抚弄无弦琴，招邀青天月。\n神安形不彫，迹高行自洁。\n思之不可见，饥渴何由歇。\n愿为鸾鹄翔，南游拂松雪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1315,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"池莲咏","author":"倪瓒","text":"回翔波间风，的历叶上露。\n清池结素彩，华月映微步。\n云阴花房敛，雨歇芳气度。\n欲去拾明珰，踟蹰惜迟暮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1316,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"述怀","author":"倪瓒","text":"读书衡茅下，秋深黄叶多。\n原上见远山，被褐起行歌。\n依依墟里间，农叟荷蓧过。\n华林散清月，寒水澹无波。\n遐哉栖遁情，身外岂有他。\n人生行乐耳，富贵将如何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1317,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日云林斋居","author":"倪瓒","text":"池泉春涨深，径苔夕阴满。\n讽咏《紫霞篇》，驰情华阳馆。\n晴岚拂书幌，飞花浮茗碗。\n阶下松粉黄，窗间云气暖。\n石梁萝茑垂，翳翳行踪断。\n非与世相违，冥栖久忘返。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1318,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄李隐者","author":"倪瓒","text":"南汀新月色，照见水中蘋。\n便欲乘清影，缘源访隐沦。\n君住钿山湖，绿酒松花春。\n梦披寒雪去，疑是剡溪滨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1319,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"人月圆","author":"倪瓒","text":"伤心莫问前朝事，重上越王台。\n鹧鸪啼处，东风草绿，残照花开。\n怅然孤啸，青山故国，乔木苍苔。\n当时明月，依依素影，何处飞来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1320,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"人月圆","author":"倪瓒","text":"惊回一枕当年梦，渔唱起南津。\n画屏云嶂，池塘春草，无限消魂。\n旧家应在，梧桐覆井，杨柳藏门。\n闲身空老，孤篷听雨，灯火江村。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1321,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"太常引 伤逝","author":"倪瓒","text":"门前杨柳密藏鸦。\n春事到桐花。\n敲火试新茶。\n想月佩、云衣故家。\n苔生雨馆，尘凝锦瑟，寂寞听鸣蛙。\n芳草际天涯。\n蝶栩栩、春晖梦华。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1322,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"太常引 寿彝斋","author":"倪瓒","text":"柳阴濯足水侵矶。\n香度野蔷薇。\n芳草绿萋萋。\n问何事、王孙未归。\n一壶浊酒，一声清唱，帘幕燕双飞。\n风暖试轻衣。\n介眉寿、遥瞻翠微。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1323,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"忆秦娥","author":"倪瓒","text":"参差玉。\n笙声暮起瑶台曲。\n瑶台曲。\n轻风香浸，夜凉肌粟。\n黄云巧缀飞霞绿。\n清吟未断秋霖续。\n秋霖续。\n恐辜花意，倒尊中醁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1324,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"忆秦娥","author":"倪瓒","text":"扶疏玉。\n蟾宫树影阑干曲。\n阑干曲。\n一襟香露，几枝金粟。\n姮娥镜里秋云绿。\n无端风雨声相续。\n声相续。\n不须澄霁，为沽醽醁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1325,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"如梦令","author":"倪瓒","text":"削迹松陵华寓。\n藏密白云深处。\n造物已安排，万事何须先虑。\n归去。\n归去。\n海鹤山猿同住。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1326,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江城子","author":"倪瓒","text":"满城风雨近重阳。\n湿秋光。\n暗横塘。\n萧瑟汀蒲，岸柳送凄凉。\n亲旧登高前日梦，松菊径，也应荒。\n堪将何物比愁长。\n绿泱泱。\n绕秋江。\n流到天涯，盘屈九回肠。\n烟外青萍飞白鸟，归路阻，思微茫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1327,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江城子 感旧","author":"倪瓒","text":"窗前翠影湿芭蕉。\n雨潇潇。\n思无聊。\n梦入故园，山水碧迢迢。\n依旧当年行乐地，香径杳，绿苔饶。\n沉香火底坐吹箫。\n忆妖娆。\n想风标。\n同步芙蓉，花畔赤阑桥。\n渔唱一声惊梦觉，无觅处，不堪招。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1328,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南乡子 东林桥雨篷梦归","author":"倪瓒","text":"篷上雨潺潺。\n篷底幽人梦故山。\n涧户林扉元不闭，萧闲。\n只有飞云可往还。\n波冷玉珊珊。\n一壑松风引佩环。\n咏得池塘春草句，更阑。\n行尽千峰半霎间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1329,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柳梢青 赠妓小琼英","author":"倪瓒","text":"楼上玉笙吹彻。\n白露冷、飞琼佩玦。\n黛浅含颦，香残栖梦，子规啼月。\n扬州往事荒凉，有多少、愁萦思结。\n燕语空梁，鸥盟寒渚，画阑飘雪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1330,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"清平乐 在荆溪作","author":"倪瓒","text":"汀烟溪树。\n总是伤心处。\n望断溪流东北注。\n梦逐孤云归去。\n山花野鸟初春。\n渔郎樵叟南津。\n谁识摧颓老子，醉人推骂从嗔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1331,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"鹊桥仙","author":"倪瓒","text":"富豪休恃。\n英雄休使。\n一旦繁华如洗。\n鹊巢何事借鸠居，看数载、主三易矣。\n东家烟起。\n西家烟起。\n无复碧翚朱棨。\n我来重宿半间云，算旧制、唯余此耳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1332,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"蝶恋花","author":"倪瓒","text":"夜永愁人偏起早。\n客鬓萧萧，镜里看枯槁。\n雨叶铺庭风为扫。\n闭门寂寞生秋草。\n行路难行悲远道。\n说着客行，真个令人恼。\n久客还家贫亦好。\n无家漫自伤怀抱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1333,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"踏莎行","author":"倪瓒","text":"春渚芹蒲，秋郊梨枣。\n西风沃野收红稻。\n檐前炙背媚晴阳，天涯转瞬萋芳草。\n鲁望渔村，陶朱烟岛。\n高风峻节如今扫。\n黄鸡啄黍浊醪香，开门迎笑东邻老。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1334,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"鹧鸪天","author":"倪瓒","text":"笠泽沿回十五年。\n亲知情义日堪怜。\n偷见三顾吾何有，俗士群讥自省愆。\n聊复尔，岂其然。\n田翁轻慢牧童颠。\n乃知造物深相与，急使江湖棹去船。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1335,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"双调·新水令","author":"倪瓒","text":"草茫茫秦汉陵阙，世代兴亡，却便以月影圆缺。\n山人家堆案图书，当窗松桂，满地薇蕨，侯门深何须刺谒，白云自可悦怡。\n到如今世事难说，天地间不见一个英雄，不见一个豪杰！","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1336,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"凭栏人","author":"倪瓒","text":"客有吴郎吹洞箫，明月沉江春雾晓。\n湘灵不可招，水云中，环佩摇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1337,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"水调歌头 游武夷和罗庆","author":"唐桂芳","text":"武夷最佳处，晴气碧于蓝。\n远瞻崖壑溪曲，六六与三三。\n莫问尘生沧海，休叹鹤归华表，好景且容探。\n铁笛破龙睡，黑雨满深潭。\n笑神仙，留蜕骨，阅空岩。\n几人蹭蹬不遇，太史滞周南。\n最好擅场老子，笔底文章如许，何必事清谈。\n暂憩桃花下，白马税飞骖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1338,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南乡子 送李仲先迁集庆","author":"唐桂芳","text":"社雨燕交飞。\n不解行人有别离。\n明月凤凰台上酒，堪奇。\n天阔昏昏海树低。\n婉画妙年时。\n帘捲芙蓉花影移。\n去去霜台消息近，谁知。\n满眼江山太白诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1339,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"如梦令","author":"袁介","text":"今夜盛排筵宴。\n准拟寻芳一遍。\n春去已多时，问甚红深红浅。\n不见。\n不见。\n还你一方白绢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1340,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"同李主敬赋周炼师渔樵耕牧诗四章章十二句 其三","author":"郭钰","text":"子何为耕，瀛洲之曲。\n玉山分雨秧苗绿，苍龙为耘虎收谷。\n炊烟晨起蒸为云，银河昼洗尘沙昏。\n酿成九霞为君寿，何必休粮苦长瘦。\n树阴阴，草青青。\n人间作苦秋无成，吁嗟归来乎，吾与尔耕。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1341,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"同李主敬赋周炼师渔樵耕牧诗四章章十二句 其四","author":"郭钰","text":"子何为牧，蓬莱之麓。\n自驾青牛度函谷，鹤群鹿子还相逐。\n芝草松间长未齐，紫苔竹下行迹迷。\n南山群羊化为石，日斜归去空无携。\n水泠泠，山簇簇。\n人间岐路往还复，吁嗟归来乎，吾与尔牧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1342,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄彭中和","author":"郭钰","text":"君来桂树林，我辞桂林去。\n桂树我所种，高大已如许。\n六月浓阴绕茆屋，不待花开可娱目。\n驻屐从穿石上苔，题诗况有墙西竹。\n小弟爱客开素襟，两载于君情最深。\n短棘本非鸾凤栖，长琴每作蛟龙吟。\n君昔少壮抱奇节，荏苒风尘头欲白。\n道义交从久更真，风月笑谈常自得。\n江西词赋多才雄，知君己有中唐风。\n汗马功名属年少，且可草服山岩中。\n海棠牡丹都赏遍，磊落珠玑满诗卷。\n我独天涯鏖俗尘，白纻每愁颜色变。\n丁宁小弟毋我违，南阮虽贫颇自奇。\n桂树花开新酒熟，作书报我归如飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1343,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宋竹坡与余有延桂看菊之约竟不及赴赋乐府一章以寄之","author":"郭钰","text":"桂花开，菊花开。\n秪为花开自合来，何须问酒杯。\n扫苍苔，惜苍苔。\n风月应怜小宋才，佳期待早梅。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1344,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"同刘伯贞题袁氏寓轩","author":"郭钰","text":"穹窿携白日，百年几旦暮。\n变灭乘化机，万物孰非寓。\n鸿濛不可超，金石岂为固。\n况兹无根蒂，自当随所遇。\n闻君辟西轩，侨立延佳趣。\n种竹新作林，移花整当户。\n蛛丝闪晴辉，青松沐朝露。\n久客赊酒易，亲旧时相聚。\n临眺登崇冈，故山渺何许。\n月明金凤洲，梦魂自来去。\n少陵浣花溪，管宁辽东路。\n当其适意时，何必皆吾土。\n干戈尚未已，丘园安得住。\n雪泥留鸿迹，华表遗鹤语。\n茫茫宇宙间，蚁垤终谁据。\n我亦东西人，长年忍羁旅。\n相从岂云远，即此驰音素。\n须留酒一樽，剪烛听春雨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1345,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"芹寓为安成彭伯圻赋","author":"郭钰","text":"泮水过新雨，官墙度晴云。\n于焉沐膏泽，素心托芳芹。\n悦玩永朝夕，采撷奚足云。\n沦漪映寒翠，光风泛微薰。\n野人分有限，安敢献大君。\n圣化之所濡，生意何欣欣。\n上林满春色，欢乐非所闻。\n始知君子心，希圣良独勤。\n纷华念俱绝，渊源思不群。\n愿言美真味，盛德在斯文。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1346,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"心云诗为罗宗仲先生赋","author":"郭钰","text":"浮云南山起，还复归南山。\n腾腾驾轻风，悠悠度松关。\n仙翁坐盘石，心与云俱閒。\n冥观元化初，吹嘘肤寸间。\n苍龙变神化，为雨遍九寰。\n六丁封江湖，空捲骊珠还。\n无心乃无物，瑶琴相对弹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1347,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"阳春曲","author":"郭翼","text":"柳色青堪把，樱花雪未乾。\n宫中裁白苧，犹怯剪刀寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1348,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵陆友仁吴中览古一首","author":"郯韶","text":"赤阑桥下记停桡，细雨菰蒲响暮潮。\n说与行人莫回首，故宫烟柳正萧萧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1349,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"郑蒙泉鍊师子午谷图","author":"郯韶","text":"子真今住子午谷，乃在蛟门西复西。\n绕屋长松落晴雪，倚天绝壁立丹梯。\n春回大壑三芝秀，月满空山一鹤栖。\n归去看图望瀛海，定应沐发候天鸡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1350,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送僧归严陵","author":"郯韶","text":"春船上濑急，归路石溅溅。\n白石百花静，清江初月圆。\n偶逢林下叟，为话竹间禅。\n明发遥相忆，青山生暮烟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1351,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题宋氏绿野庄","author":"郯韶","text":"暮泊兰陵郡，朝过绿野庄。\n飞花度江阔，垂柳荫门长。\n扫地春阴合，梳头荷气凉。\n几时重著屐，来此话沧浪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1352,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题渔家壁","author":"郯韶","text":"漫郎家住黄泗浦，閒看飞花坐北窗。\n渡口青山高似屋，门前湖水直通江。\n垂杨系艇已千尺，春鲤上盘才一双。\n野老相过无一事，白头喜对酒盈缸。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1353,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"清平乐","author":"郯韶","text":"湘云微度。\n六曲朱阑暮。\n帘外香飘梅子树。\n知有王孙索句。\n谁将琼琯吹霞。\n柳花飞过东家。\n说与门前去马，断肠休为琵琶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1354,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"永思堂诗为董仲资作","author":"陶宗仪","text":"子之于亲，思无不至。\n生育恩深，与天地媲。\n一别千古，终养莫遂。\n永言孝思，思曷有既。\n爰陟我屺，爰陟我岵。\n瞻望莫及，心焉如燬。\n露雨降濡，秋春收履。\n悽怆怵惕，感时抚已。\n居处笑语，志意乐耆。\n书册杯棬，手口泽气。\n食而羹只，居而墙只。\n如将见之，爱悫并致。\n我身之存，亲为不死。\n岂敢一日，忘乃所自。\n思继其志，思述其事。\n思贻令名，作则锡类。\n奕奕高堂，奂乎百世。\n名堂者谁，繄仲资氏。\n子孙绳绳，衍休委祉。\n方来之思，有引勿替。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1355,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"铙歌鼓吹曲二章 其一 屡丰年上帝闵农也帝德好生易菑为祥焉","author":"陶宗仪","text":"屡丰年，群生熙。\n瘨我旱，宁怨咨。\n星火烈，螟螽滋。\n苗而不秀，岁且荐饥。\n精诚格天听，允惟念之。\n命幽灵，击妖魑，龙膺捷疾先后驰。\n金精流光淫虹糜，四溟叆叇甘雨时。\n积水弥九野，稔而可期。\n不殄禋祀，上帝是祈。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1356,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"铙歌鼓吹曲二章 其二 旱既甚张君阐化也君积功累行有祷而天应之","author":"陶宗仪","text":"旱既甚，金石流。\n苗恙槁，民烦忧。\n畴能祈天致天雨，曰惟张君验之屡。\n雩坛长跪恭进词，黑札泫文启雷祖。\n闭阳纵阴理则然，叱电鞭霆一何武。\n旸乌郁光祝融奔，渊龙起蛰商羊舞。\n甘泽及我私，里长驩娱击壤歌，至正厥功匪君谁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1357,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古用陆国隐韵三首 其一","author":"陶宗仪","text":"古人重节义，出处盖弗苟。\n而我何为者，南北事奔走。\n恻恻怀故里，去去成老丑。\n富贵不可期，聊以酌我酒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1358,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古用陆国隐韵三首 其二","author":"陶宗仪","text":"浮云蔽颓阳，凉飙谢繁绿。\n气化相寻绎，百岁一何速。\n达人意有在，岂复伤局促。\n且持杯中物，对此篱下菊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1359,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古用陆国隐韵三首 其三","author":"陶宗仪","text":"王风萎衰周，人纪坏狂秦。\n大朴变哇淫，雕虫蠹天真。\n迢迢百世下，礼乐就沈沦。\n尼父不复作，圣道讵能新。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1360,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]