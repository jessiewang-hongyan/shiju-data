[{"title":"荔枝画，为福建佥宪张惟远题四首 其四","author":"张昱","text":"六月南风荔子丹，皱红小碧满银盘。\n水晶细嚼甜于蜜，满口生香玉露漙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5787,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"剪花士女","author":"张昱","text":"咫尺芳丛艳色深，蜂情蝶思两难禁。\n看来莫用闲惆怅，剪下春风一寸心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5788,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题赵仲穆人马图","author":"张昱","text":"厩吏牵呈御苑回，开元求马尽龙媒。\n赵家富有曹韩样，摹出承平气象来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5789,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"刘曜卿画折花宫女","author":"张昱","text":"柳风草露欲沾衣，又是宫中上直时。\n好把桃花都折尽，免教吹作落红飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5790,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钱舜举画芙蓉","author":"张昱","text":"木末芙蓉最耐寒，等闲不许世人看。\n蛾眉淡扫朝天去，自采花头制道冠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5791,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花水月仙子画","author":"张昱","text":"游魂非鬼亦非仙，凭附梅花度岁年。\n欲向姮娥诉孤另，浪中亦自少团圆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5792,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"招周德新员外观菊","author":"张昱","text":"明朝莫问晴和雨，骑马能来看菊花。\n岂是省郎无酒对，不知此处似陶家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5793,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题扇士女","author":"张昱","text":"转深文字转多情，侍女常将笔砚行。\n思得玉台新样句，为题团扇赠卿卿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5794,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"湖中即事","author":"张昱","text":"湖柳湖波尽可怜，不知春在阿谁边？\n满头翡翠双鬟女，细雨吴歌湿画船。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5795,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挟弹游骑图","author":"张昱","text":"玉臂双楦据绮鞍，浑身俊气要人看。\n若知稼穑艰难事，肯把黄金铸弹丸？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5796,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"李白应制图","author":"张昱","text":"明主怜才赦酒狂，不知力士贱文章。\n当其醉草清平调，肯信长安是夜郎？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5797,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杜甫上谒图","author":"张昱","text":"出当天宝艰难日，归拜拾遗行在时。\n入蜀还秦底心性，一篇长拜杜鹃诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5798,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄远词","author":"张昱","text":"梦里关山觉后非，忧深别泪在罗衣。\n堂前种得宜男草，正及春香人未归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5799,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"临安访古十首 其一 石镜","author":"张昱","text":"临安山中古石镜，曾照钱王冕服来。\n天遣紫苔封裹后，等闲不许别人开。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5800,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"临安访古十首 其二 婆留井","author":"张昱","text":"旧日婆留井未堙，石栏苔藓上龙鳞。\n而今率土皆臣妾，莫愿皇天产异人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5801,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"临安访古十首 其三 功臣塔","author":"张昱","text":"峰头石塔表功臣，五百年前是佛身。\n莫问蓬莱水清浅，野藤犹蔓劫馀春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5802,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"临安访古十首 其四 锦溪","author":"张昱","text":"钱王功业与天齐，百里旌旗照此溪。\n彼此波中铺锦后，至今光景净无泥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5803,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"临安访古十首 其五 化城寺","author":"张昱","text":"王子能以身施佛，何异生居净梵宫？\n敝屣视他闲富贵，男儿到此是英雄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5804,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"临安访古十首 其六 衣锦山","author":"张昱","text":"还乡满山都覆锦，富贵应须白昼归。\n设宴九龙堂上日，沛中歌后似王稀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5805,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"临安访古十首 其七 将军树","author":"张昱","text":"将军官重执金吾，不比秦朝列大夫。\n王为锦衣归故里，遂令老树有称呼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5806,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"临安访古十首 其八 环翠阁","author":"张昱","text":"东山尚存环翠阁，谢傅来游经几年？\n可是旧时携妓到，粉香犹在画阑边。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5807,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"临安访古十首 其九 净土寺","author":"张昱","text":"祥符赐额海会寺，四百年来弹指过。\n试问竹林桥下路，往还曾见几东坡？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5808,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"临安访古十首 其十 九仙山","author":"张昱","text":"仙子何年化鹤群，至今名姓只空闻。\n我来欲访前朝事，怅望九仙惟白云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5809,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"鸿沟","author":"张昱","text":"天命何曾分楚汉，自将南北限鸿沟。\n当时应恨乌江水，不与君王照白头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5810,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"李白小像","author":"张昱","text":"承制摛毫玉殿头，清平乐府擅风流。\n名花倾国能相妒，得宠翻遗失宠忧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5811,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桃源图","author":"张昱","text":"几树桃花认未真，又何分晋与分秦？\n渔郎不悟避秦者，便把兴亡说与人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5812,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"苏小小坟上作","author":"张昱","text":"香骨尘埋县治前，西陵魂梦隔风烟。\n好花好月年年在，潮落潮生更可怜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5813,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宋赞善以筇竹一枝并诗赠玘太朴，次其韵","author":"张昱","text":"庸蜀之西一竹筇，年来蜕骨已如龙。\n扶登春殿谈经后，风雨时生掌握中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5814,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题臧祥卿画","author":"张昱","text":"露桃风柳两依依，画在丹青亦自奇。\n若在墙头并驿畔，过春都是折残枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5815,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"问蕳夷道索冬笋","author":"张昱","text":"僧家嗜笋如嗜肉，满腹生香贮寒玉。\n肯信湖州太守馋，饥来煮遍千林竹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5816,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"徐一夔以自己小影代送埙上人回龙门寺，为题其上","author":"张昱","text":"总是三生梦幻身，又何分别假和真？\n总饶送到龙门寺，也是丹青画里人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5817,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"邵庵虞先生为张伯雨赋四诗，开元宫道士章心远求追次其韵，伯雨画像","author":"张昱","text":"此画茅山第几真，翛然白氅鹤翎新。\n百年身世归歌咏，一代交游在缙绅。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5818,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀旧","author":"张昱","text":"忆诵清江空旧鱼，流光如赴隙中驹。\n云沈华盖星沈海，思绝狂张与老虞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5819,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丹井","author":"张昱","text":"张仙于此炼丹砂，夜夜丹光照井华。\n犹有石阑遗刻在，将军移置羽人家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5820,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"涧阿碑","author":"张昱","text":"邵庵文字在坚珉，摹刻中郎笔画真。\n在日得钱除买酒，馀资都付打碑人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5821,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠人游湖南","author":"张昱","text":"世途无处不通津，惟尔栖栖志未伸。\n莫过沅湘唾江水，此中曾有汨罗人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5822,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赵子昂画花鸟","author":"张昱","text":"绮纨旧习信难移，得意青春正好时。\n直下玉庐无所事，试临花鸟学徐熙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5823,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日","author":"张昱","text":"一阵东风一阵寒，芭蕉长过石阑干。\n只销几个瞢腾醉，看得春光到牡丹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5824,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为雪庭禅师题赵氏三马卷二首 其一","author":"张昱","text":"僧房曾见写骐驎，人已云亡纸墨新。\n寂漠九原无吊处，至今犹羡执鞭人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5825,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为雪庭禅师题赵氏三马卷二首 其二","author":"张昱","text":"骥子生来骨相奇，满沟汗血落胭脂。\n空门纵有驮经日，得似牵过白玉墀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5826,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠沈生还江州","author":"张昱","text":"乡心正尔怯高楼，况复楼中赋远游！\n客里登临俱是感，人间送别不宜秋。\n风前落叶随车满，日下浮云共水流。\n知汝琵琶亭畔去，白头司马忆江州。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5827,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"戊申岁间中清赏十景 其五 篱边餐落菊","author":"叶颙","text":"篱边餐落菊，采采黄金英。\n拾之不满掬，松露相和倾。\n三咽清肺腑，九窍皆芳馨。\n食之久住世，化为天地精。\n不饥复不老，颜貌如童婴。\n骖鸾访安期，跨鹤寻广成。\n回首谢人世，何用千秋名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5828,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"戊申岁间中清赏十景 其六 岭上抚孤松","author":"叶颙","text":"岭上抚孤松，松阴盖天地。\n霜皮四十围，傲晲人间世。\n老干带烟霞，虬枝撼风雨。\n玄鹤数往还，白云互来去。\n抚松一问之，坐阅几千岁。\n人寿能几何，松老良未易。\n与松语未终，落月寒生袂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5829,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"戊申岁间中清赏十景 其七 开径延驯鹤","author":"叶颙","text":"开径延驯鹤，爱此癯瘦形。\n不与凡鸟伍，戛然独长鸣。\n我性鹤相似，宠辱常不惊。\n平生寡交游，闭户鲜送迎。\n松关夜月孤，茅屋秋霜清。\n从今与鹤游，骑鹤朝玉京。\n鹤尔幸知此，慎勿轻渝盟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5830,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"戊申岁间中清赏十景 其八 登楼数去鸿","author":"叶颙","text":"登楼数去鸿，目断江山异。\n帛书望不来，愁杀深闺女。\n遗音堕寒空，疏影澄秋水。\n凄凉关陇云，惨澹潇湘雨。\n飞鸣万里馀，为此稻粱计。\n点点夕阳中，阵阵荒烟外。\n天际两三行，飞入芦花去。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5831,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"戊申岁间中清赏十景 其九 朗吟黄叶寺","author":"叶颙","text":"朗吟黄叶寺，落日长林密。\n天花拂衣香，露草沾屦湿。\n深烟销奇峰，闲云裹危石。\n金钟透太清，玉磬穿虚碧。\n境胜龙象游，夜静虎狼出。\n地远人踪稀，心定尘缘寂。\n仙凡迥不同，坐久三叹息。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5832,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"戊申岁间中清赏十景 其十 长啸白云峰","author":"叶颙","text":"长啸白云峰，声清方夜永。\n海月忽飞来，光照千岩静。\n松林奏瑶琴，山泉漱金井。\n下与人世违，上接星辰近。\n凉露洗心源，天风吹鬓影。\n使我凡陋躯，泠然发深省。\n愿言生羽翰，直上青云顶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5833,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"采莲歌","author":"叶颙","text":"画舫绿杨边，吴娃竞采莲。\n红妆映绿水，窈窕誇少年。\n只愁莲心苦，食之味不甜。\n只愁藕丝短，织之难成缣。\n相与唱歌去，撑破苍波烟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5834,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读书山月下","author":"叶颙","text":"读书山月下，月色流岩扉。\n松风吹毛发，草露沾裳衣。\n研精探玄奥，竭思穷幽微。\n兴亡空感慨，今古谁是非。\n孔孟几千载，斯文愈光辉。\n蚩蚩愚下士，去此将安归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5835,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"举酒春风前","author":"叶颙","text":"举酒春风前，勿讶衰颜红。\n藉兹曲糵媒，成彼酝酿功。\n顿使铁石肠，化为欢悦容。\n喜色浮须眉，和气填心胸。\n浩浩六合间，广扇淳厚风。\n儿女岂知此，唯醉芳花丛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5836,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"围棋白日静","author":"叶颙","text":"围棋白日静，举袖清风吹。\n神机众未识，妙著时出奇。\n我老天宇内，白雪凝须眉。\n坐阅几输赢，历观迭兴衰。\n古今豪杰辈，谋略正类棋。\n局终一大笑，惊起山云飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5837,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舞剑清夜阑","author":"叶颙","text":"舞剑清夜阑，孤灯耿中堂。\n一舞空奸邪，再舞摧豪强。\n频起为君舞，月出云飞扬。\n气冲牛斗暗，影动蛟龙翔。\n悲风转萧飒，壮志弥慨慷。\n时哉不我逢，石匣深韬藏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5838,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"吹箫明月底","author":"叶颙","text":"吹箫明月底，素魄流寒光。\n箫声更清婉，音调美且长。\n孤鸾舞天风，老凤鸣朝阳。\n仙人王子乔，往事空茫茫。\n丹成灶应冷，仙去台亦荒。\n千秋更万古，日夕遥相望。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5839,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"抚琴白云端","author":"叶颙","text":"抚琴白云端，声透岩谷里。\n山空夜未央，长天色如洗。\n喧啾百鸟吟，萧瑟孤舟雨。\n万壑鸣松风，千江泻流水。\n森严肃鬼神，恩怨诉儿女。\n人世不尔闻，唯入巢由耳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5840,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"渔父曲","author":"叶颙","text":"雨过暮云收，江空凉月出。\n轻蓑独钓翁，一曲秋风笛。\n宿鹭忽惊飞，点破烟波碧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5841,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"对弈青松边","author":"叶颙","text":"对弈青松边，松云湿荷裳。\n棋中有深机，浅识未易量。\n知进贵知退，能弱还能强。\n争先合顾后，得胜当虑亡。\n轻剽或易失，迟重终寡殃。\n将卒勿骄惰，士马须精良。\n能以此众战，柔者必至刚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5842,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"对酒舞长剑","author":"叶颙","text":"对酒舞长剑，剑舞影更长。\n始舞饮一斗，迭舞累百觞。\n舞之不能已，饮亦未易量。\n长舞影傞傞，长醉志扬扬。\n尚不论公孙，况复数项庄。\n年深剑文在，曾斩楼兰王。\n舞罢醉未醒，落月流寒光。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5843,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和万卷阁诗韵 倪希圣携石元吉题万卷阁诗见示且言其先大父枢密公南渡后尝读书游观于此南渡去今二百年遂成陈迹感古伤今不能忘怀何时一登楼纵观前人遗躅朗吟豪咏于天风百尺之上与王粲元龙相望于千载之下顾不伟欤因次韵二章 其一","author":"叶颙","text":"天风百尺楼，壮制凌霄汉。\n绕屋山四围，充栋书万卷。\n峰峦献奇观，宇宙钟神算。\n弦歌师鲁丘，政治资姬旦。\n冥搜竟忘疲，幽讨庸辞倦。\n唯知扇文风，未必图美宦。\n桂月与松云，时复供清玩。\n人去楼亦空，千秋发悲叹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5844,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和万卷阁诗韵 倪希圣携石元吉题万卷阁诗见示且言其先大父枢密公南渡后尝读书游观于此南渡去今二百年遂成陈迹感古伤今不能忘怀何时一登楼纵观前人遗躅朗吟豪咏于天风百尺之上与王粲元龙相望于千载之下顾不伟欤因次韵二章 其二","author":"叶颙","text":"画栋丽晴霞，飞甍接天汉。\n虚棂纳青山，巍轩贮黄卷。\n缅怀创楼人，胸襟蕴奇算。\n相去数百年，坐阅成一旦。\n想当读书日，研精固忘倦。\n浮云变盛时，短世惊薄宦。\n我欲登斯楼，烟云聊把玩。\n感慨三抚阑，临风寄长叹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5845,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中怀李本存十二韵","author":"叶颙","text":"久雨不出门，幽斋抱岑寂。\n点检屋外山，白云为雨湿。\n最苦溪水添，没却钓鱼石。\n平生虑事深，无故忧得失。\n因念倦游人，荒凉不温席。\n独抱瑰奇才，双瞳黑如漆。\n关山一万里，谁能共欣戚。\n故旧半彫零，亲戚隔存殁。\n乱后幸自强，感激弥叹息。\n蓑笠拟访之，浊酒聊共适。\n酒酣弹铗歌，忘情话畴昔。\n云深路不通，何处寻踪迹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5846,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽斋清兴","author":"叶颙","text":"窗迎青嶂远，门掩白云深。\n坐久风生席，年高雪满簪。\n访梅临水际，采药陟烟岑。\n月径桓伊笛，秋庭单父琴。\n惊醒尘土梦，涤尽利名心。\n衒世闲声誉，生平不用寻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5847,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"故圃梅花","author":"叶颙","text":"身世水云乡，冰肌玉色裳。\n灵均千载恨，和靖一生忙。\n南国遗高躅，东风递暗香。\n久同松柏操，肯学杏桃妆。\n冷淡孤山月，高寒半夜霜。\n鹤猿常款狎，蜂蝶任猖狂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5848,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"兴怀","author":"叶颙","text":"幽遁足嘉谟，崇勋授壮夫。\n杖藜登岭岫，蓑笠钓江湖。\n最喜烟霞古，从教姓字无。\n顿忘身外虑，宁受世间誉。\n尽日寻棋局，长年卧酒垆。\n饮酣吟啸远，睡醒兴怀孤。\n秋屿翔云鹤，春波浴海凫。\n四时花木美，野叟复何图。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5849,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"东篱丙辰季秋作","author":"叶颙","text":"曳杖东篱下，层峦列环岫。\n南山如有情，青翠俯相就。\n松桂二老苍，烟霏乍无有。\n孤云屡出奇，群峰竞呈秀。\n图彩写晴岚，琴音漱寒溜。\n采采黄金英，芳香满衣袖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5850,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]