[{"title":"遣怀 其四","author":"唐桂芳","text":"自爱山居玩化机，雨馀随处觉春归。\n满庭花气薰人醉，一个游蜂抱絮飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9394,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"十月二十又一日奉家君偕镏复叔留藤坑山中因憩涧石有作","author":"唐桂芳","text":"雨馀石髓漏云根，嫩碧粼粼漾浅春。\n不是天台石桥路，胡麻饭糁避秦人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9395,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题秋日溪居图","author":"唐桂芳","text":"江阁雨晴三尺水，野桥人渡数家村。\n眼前如此秋光好，自笑先生懒出门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9396,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和罗善先游武夷","author":"唐桂芳","text":"乘鸾远访洞庭君，瑞气凝成五色云。\n落尽碧桃春似水，紫箫声里立斜曛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9397,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题唐马图","author":"唐桂芳","text":"奋迅骄骢不受羁，四蹄躞蹀势如飞。\n浴川蹙浪寻常事，也待奚官汲水归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9398,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"槐里偶成","author":"唐桂芳","text":"春来长是病愁中，花信于今第几风。\n晓起忽闻疏雨过，隔窗晴鸟话言工。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9399,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"程国宝有诞孙之庆留饮欢洽醉中谩成一绝以谢","author":"唐桂芳","text":"老子婆娑笑脸开，扫除黄叶坐莓苔。\n美人醉后擘江蟹，香雾濛濛扑手来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9400,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"五月十六夜汲扬子江心泉煮武夷茶戏成一绝","author":"唐桂芳","text":"三更无寐坐官航，澹月朦胧色似霜。\n扬子江心泉第一，何妨为煮建茶香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9401,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谩兴七首 其一","author":"唐桂芳","text":"平生自许有志客，到老返无家可栖。\n多赖晓风相慰藉，乱抛云气过前溪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9402,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谩兴七首 其二","author":"唐桂芳","text":"青青荠菜和云瘦，白白梅花亚雪开。\n怪底江鸥野心性，窥鱼照影去还来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9403,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谩兴七首 其三","author":"唐桂芳","text":"山路阽危可数里，野桥横度恰三家。\n健如昨日有文卖，贫到今年无酒赊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9404,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谩兴七首 其四","author":"唐桂芳","text":"日上半阶犹有雪，风生老树却无云。\n多情不及双坑水，流到桥西未肯分。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9405,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谩兴七首 其五","author":"唐桂芳","text":"杜门十日坐风雨，声到松梢转竹梢。\n却似家居方广寺，一湾流水石为桥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9406,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谩兴七首 其六","author":"唐桂芳","text":"老子行年五十馀，面纹百摺发萧疏。\n黄金散尽无遗物，犹有胸中半卷书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9407,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谩兴七首 其七","author":"唐桂芳","text":"病来意态愈龙钟，历尽关河千万重。\n说与诸公休强起，容吾饱看雪山松。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9408,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题姚雪谷墨竹 其一","author":"唐桂芳","text":"道人胸次著琅玕，破墨淋漓作雨寒。\n万丈晓风吹欲暮，误疑翠佩响珊珊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9409,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题姚雪谷墨竹 其二","author":"唐桂芳","text":"每忆东坡道上归，女奴执烛立多时。\n毫端欲写无穷态，得似清风一两枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9410,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题姚雪谷墨竹 其三","author":"唐桂芳","text":"肯虑人间寒暑侵，风霜饱受碧沈沈。\n仙家描得枯梢影，曾听鸾凰月下吟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9411,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题姚雪谷墨竹 其四","author":"唐桂芳","text":"江南四月见新梢，嫩箨初抛粉未消。\n却要薰风相爱护，直教个个拂云霄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9412,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶成 其一","author":"唐桂芳","text":"春来十日九风雨，何事东君不放晴。\n门外两株好桃李，花开准拟作清明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9413,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶成 其二","author":"唐桂芳","text":"小小山家白竹扉，因君旋启客来稀。\n眼前拍塞皆生意，燕唼青虫故故飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9414,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶成 其三","author":"唐桂芳","text":"形骸土木百无知，须白葱根苦爱诗。\n赖有小儿才四岁，豪吟痛饮似吾痴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9415,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题邵益斋白云诗卷二绝 其一","author":"唐桂芳","text":"十年不返青山下，今日重来绕药栏。\n依旧白云满空谷，声名未许属方干。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9416,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题邵益斋白云诗卷二绝 其二","author":"唐桂芳","text":"黄山我号白云翁，云涨千山与画同。\n试问云山何所似，故人未老一丝风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9417,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题姚雪谷梅图","author":"唐桂芳","text":"天荒地老春长在，斗落参横夜未央。\n每忆臞仙姚雪谷，毫端自有返魂香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9418,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"溪行简汪彦通","author":"唐桂芳","text":"爱杀溪山画不真，梅花雪压小桥春。\n近闻诗思清如许，煎韨尘埃字字新。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9419,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游问政二首 其一","author":"唐桂芳","text":"树转云昏一径斜，洞门深锁老烟霞。\n聂仙已乘黄鹤去，春笋满山空落花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9420,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游问政二首 其二","author":"唐桂芳","text":"雨晴春鸟语叮咛，松外青山花外亭。\n昨夜仙瓢酒初熟，道人无暇读黄庭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9421,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题程敏斋东归图","author":"唐桂芳","text":"当年返棹西江上，不尽东归孝子心。\n投老凄凉空见画，白云散尽故山深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9422,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"凿池觅金鲫四首 其一","author":"唐桂芳","text":"浚底规圆作小池，生涯何异类儿嬉。\n春来剩种菰蒲叶，卧听潇骚山雨时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9423,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"凿池觅金鲫四首 其二","author":"唐桂芳","text":"得得频来照鬓腮，窗前何吝破苍苔。\n春风草长容蛙闹，夜雨泥融许燕来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9424,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"凿池觅金鲫四首 其三","author":"唐桂芳","text":"荒阶扫雪添新水，老砚呵冰浣墨花。\n更乞游鱼三十尾，?腮香暖唼芹芽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9425,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"凿池觅金鲫四首 其四","author":"唐桂芳","text":"方塘十亩碧波深，分减盘飧育物心。\n闻道近来将数子，日光摇碎一团金。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9426,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"耕读堂辞","author":"唐桂芳","text":"蹇予生此遐陬兮，块资质其窳惰。\n曰学道其未明兮，念躬耕而不可。\n以人情而为田兮，滋雨露而润之。\n薙稂莠以害苗兮，恐荒秽而不治。\n跂历山以叫虞舜兮，吊伊尹于莘野。\n苟舍己以芸人兮，宁长歌于牛下。\n朝驰骛于艺圃兮，夕翱翔于书林。\n羌岁月其川逝兮，孰有察予之初心。\n嗟鲁圣与邹贤兮，尚遑遑其求索。\n矧吾侪之玩愒兮宜分阴而爱惜。\n谓世代之既远兮，亦有睹其庶几。\n纷美人之肥遁兮，表耕读以自怡。\n树嘉谷之穰穰兮，俟丰稔吾将刈。\n沛仁义之充足兮，敢始勤而终弃。\n非其力不食兮，偭众理而肯为。\n指古人以为则兮，视今之人何其。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9427,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"玉楼春 送宣差","author":"唐桂芳","text":"春风桃李河阳县。\n讼简苔纹生印篆。\n昼长帘捲隔溪山，吟就新诗花点砚。\n三年政满真堪羡。\n一舸扁舟摇素练。\n柳梢莺转报乔迁，天上玉堂飞剡荐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9428,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"水调歌头 送李经历","author":"唐桂芳","text":"白头閒父老，都说幕中宾。\n杜门鹤立，风雨不遣客来频。\n果是清心苦节，能障狂澜砥柱，矻立势千钧。\n吹散浮云了，依旧月如轮。\n忆公馀，携印绶，出城闉。\n酒船醉舞，江月还似谪仙人。\n好理木天文字，便许玉堂标致，笔下信通神。\n离恨正无赖，杨柳不胜春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9429,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南乡子 代送罗季端","author":"唐桂芳","text":"诗酒谢宣城。\n官舍槐花夜雨晴。\n石壁烟岚，青入座谈经。\n浩浩源头活水生。\n休用叹云萍。\n三载同寅总弟兄。\n借问沧州，亭上月分明。\n不为行人照别情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9430,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"念奴娇","author":"唐桂芳","text":"阳关图里，小邮亭掩映，几株杨柳。\n翻忆横经重席处，文燄荡磨南斗。\n几格云香，砚池波暖，傲兀寒毡久。\n居然秩满，紫阳山色依旧。\n因念海水桑田，前朝甲第，还似名园否。\n开遍蔷薇春事老，榕树莺啼芳昼。\n好制青衫，未添华发，起舞先生寿。\n别离千里，一尊倒浣烟岫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9431,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"满江红","author":"唐桂芳","text":"薄宦驱驰，衣尚带、燕台飞雨。\n心自喜、谪仙人物，襟怀如水。\n潇洒笑谭霏玉屑，铿锵文韵谐钟吕。\n看红莲、开遍透帘香，薰风里。\n摇画鹢，烟波语。\n斟绿醑，莼鲈美。\n正月明秋好，抱琴归去。\n梅菊交承敦世好，江山迎送关情绪。\n愿绣衣、霄汉立青春，声名起。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9432,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"木兰花慢 送沈洞云","author":"唐桂芳","text":"芝山何处是，呼白鹤、与君骑。\n恁富贵功名，黄梁梦熟，也是儿嬉。\n休拘束且孟浪，向新丰沽酒浣诗脾。\n光彻胸中星斗，气腾笔下虹霓。\n相逢邂逅吐珠玑。\n声价簸南箕。\n恐素发慈亲，青灯儿子，应怪归迟。\n鄱阳半帆秋色，正芦花潇瑟鲙鱼肥。\n舒卷洞云无际，长江烟雨离离。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9433,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"念奴娇 送治中","author":"唐桂芳","text":"急流勇退，笑纷纷谁似，新安别驾。\n门掩青山无客到，昼卧桃花騣马。\n报国丹心，流年白发，洗尽功名想。\n道旁惆怅，贤哉又见疏广。\n况有九帙慈亲，琼花开处，日煖扶鸠杖。\n烨烨谢庭兰玉茁，都是清朝卿相。\n富贵归休，政如饮酒，不醉仍留量。\n扬州骑鹤，月明恍在天上。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9434,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画十三首 其三","author":"钱宰","text":"落日赤云西，青山照大溪。\n草堂松树下，坐听鹁鸠啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9435,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画十三首 其四","author":"钱宰","text":"一曲江南弄，山长楚水遥。\n江边杨柳树，谁系木兰桡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9436,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画十三首 其五","author":"钱宰","text":"云气晓苍茫，秋深草木黄。\n霓旌下南浦，云是楚襄王。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9437,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画十三首 其六","author":"钱宰","text":"江水去悠悠，籧篨抱莫愁。\n白头垂钓者，疑是渭滨叟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9438,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画十三首 其七","author":"钱宰","text":"塞北多冰雪，江南足稻粱。\n相求应同类，莫近艾如张。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9439,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画十三首 其八","author":"钱宰","text":"帝子下北渚，江寒愁不归。\n空遗一卷石，拂断六铢衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9440,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画十三首 其九","author":"钱宰","text":"百鸟共春风，相呼乐意同。\n不知缘底事，尔作白头翁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9441,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉萱堂为张朝宗赋","author":"钱宰","text":"阿母初哺儿，阶前种宜男。\n种之欲忘忧，恨恨不能堪。\n夫君竟长逝，花开为谁簪。\n儿饥须蚤耕，儿寒须蚤蚕。\n教儿读父书，经史长穷探。\n儿今八尺长，母发白毵毵。\n上堂问起居，下堂具旨甘。\n幽花遍堂北，旭日照堂南。\n何以报母慈，持此寸草心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9442,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"石泉山房","author":"钱宰","text":"白石何齿齿，幽泉复泠泠。\n十年来京邑，远此林壑情。\n取琴为我弹，弹作涧下声。\n涵云出细窦，悬响漱珑玲。\n奔流激浅濑，飞沬溅瑶琼。\n峻如倾崖急，怒若过峡惊。\n回渊阻云根，水涩不得行。\n冲破歘奔放，奋迅如建瓴。\n委蛇及水镜，扩然犹且清。\n雅操得真趣，馀音绎以成。\n挥手未终曲，怅望故山青。\n泉石无遐思，兴乐在广庭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9443,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题燕喜亭","author":"钱宰","text":"高堂白日迥，芳辰何熹微。\n渚风变林花，春草绿已滋。\n流光惜易迈，欢娱及良时。\n子奉堂上亲，翁引花下儿。\n大妇主中馈，小姑纳卮匜。\n升堂布绮席，嘉宾来何迟。\n华筵理妙曲，秦筝杂清吹。\n玉珧列海错，烹羊间熊胹。\n酒至辄尽觞，怡然乐天彝。\n尹父方靡盬，鲁侯亦奚为。\n嗟彼轩裳者，极宴忘戚悲。\n轩裳岂不乐，我醉不复知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9444,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题濯足图","author":"钱宰","text":"驱马西略地，行至雍丘南。\n歇鞍踞床洗，龙歆气何酣。\n傲岸濯秋水，两姬手掺掺。\n郦生门入，长揖不下拜。\n高视挫其锋，踞见吁可诧。\n幡然敬尔容，摄衣起言谢。\n顾惟雄武姿，慢骂空无人。\n于焉下狂士，屈若志不伸。\n高明藉柔克，四海归尧仁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9445,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题观渔图","author":"钱宰","text":"龟蒙荒大东，洙泗扬其流。\n金碧何峥嵘，台殿居上头。\n命驾出山泽，陈鱼乐观游。\n纵横列九罭，出没翔万艘。\n悬罾杂数罟，中有嫠妇罶。\n大鱼拍波起，小鱼不得休。\n尽利攘其民，安得视狝蒐。\n臧孙岂不贤，明珠惭暗投。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9446,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题曕云轩","author":"钱宰","text":"南山一何高，孤云何珊珊。\n朝看云出林，暮云复归山。\n云归已复出，游子何时还。\n迢迢云舍远，可望不可攀。\n持杯不能酌，怅然起凭阑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9447,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题徐子中积善堂 其一","author":"钱宰","text":"十月风露交，履霜变重阴。\n密霰日已集，坚冰日已侵。\n往者既有渐，来者方自今。\n君子契天道，晨夕返吾心。\n树德当务滋，卷勺能高深。\n文言美馀庆，保此以为箴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9448,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题徐子中积善堂 其二","author":"钱宰","text":"蔼蔼嘉树林，繁阴散华第。\n俯看雨露滋，仰见云烟翳。\n昔人手中植，岁月今莫计。\n寸根蟠地维，尺干起天际。\n物理庶可广，人心贵能继。\n勖哉贤子孙，积善期弗替。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9449,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题生意垣诗","author":"钱宰","text":"大钧运元化，生物蔽寰区。\n春阳播仁泽，靡不在有初。\n飞走咸鷇麛，勾萌日敷舒。\n良马信倜傥，宁不顾其驹。\n朔禽抟云霄，亦复哺尔雏。\n眷彼婴孺儿，慈煦亦已劬。\n世无咸阳医，何以宁其躯。\n张生守环堵，种药周四隅。\n郁郁生意滋，元气同扶舆。\n誓将扶幼孩，永与耆艾俱。\n安得摅尔怀，寿域跻黄虞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9450,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"己亥岁避兵","author":"钱宰","text":"中原丧乱起，群雄遍江河。\n我行江之南，亦复罹兵戈。\n亲戚相奔窜，闾里传惊讹。\n一朝闻寇至，攀腾上岩萝。\n路逢伟男子，负母匿山阿。\n弱妇行不前，缢死枯树柯。\n岂忍弃尔死，救尔如母何。\n听此欲援之，山下寇已多。\n行登寂高峰，天高郁嵯峨。\n怅然思匪风，吞声不成歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9451,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠夏道存","author":"钱宰","text":"日月行中天，会朔自有期。\n江海各一方，合流岂无时。\n慨彼君子交，良晤何暌违。\n子昔西江来，访我东海湄。\n载酒笑贺狂，探书慕迁奇。\n别来三十年，彼此更乱离。\n会合齐未卜，音问两俱稀。\n倏焉际文明，见面交相疑。\n君颜昔如玉，我发今若丝。\n感此缱绻怀，峨冠竟言归。\n毋为叹衰迈，少壮夫奚为。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9452,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠樵隐处士","author":"钱宰","text":"樵者本在山，隐者亦在山。\n虽言事不同，并依林泉间。\n晨兴持斧出，扪萝与跻攀。\n向夕负薪归，落日同掩关。\n流水石上至，白云山中还。\n老樵竟何之，我独忘朝餐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9453,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"昨日行","author":"钱宰","text":"昨日日没黄金盘，今日日出丹砂丸。\n丹砂可鍊，黄金可抟。\n仰看白日没复出，安得与尔遁还天地终无端。\n东望扶桑枝，西极若木柯。\n夸父渴死莫饮于河，鲁阳战酣手挥其戈。\n何曾凌倒影、走灭没，亦莫却飞光、扳羲和。\n青天万古旦复旦，北斗日夜如飞梭。\n温一中，可奈何，骨既不可解，鬓发飒已皤。\n那能学安期生，出入太清家。\n煮汞成白雪，采铅鍊黄芽。\n玉炉火温温，鼎上飞紫霞。\n饥餐日之精，渴饮明月华。\n玄关直探造化始，元气与之同迩遐。\n温一中，可奈何，不如猛饮酒、高唱歌。\n笑吹紫鸾笙，醉舞白玉珂。\n日日烂醉不愿醒，便似阿母西池上晓宴蟠桃花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9454,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]