[{"title":"寄郑明德","author":"顾瑛","text":"我爱廛居郑有道，屡辞徵币卧松云。\n年来短发笼纱帽，客至新诗写练裙。\n几上只留《招隐》赋，人前每读《送穷》文。\n清时已见文名盛，日日高车访隐君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11487,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游天平题文正公祠","author":"顾瑛","text":"魏公勋业垂前代，百世高风道并隆。\n立庙东吴见遗像，出师西夏有全功。\n山回鸟道千盘尽，天入龙门一罅通。\n赫赫皇元昭祀典，烝尝亦与武侯同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11488,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄杨铁崖","author":"顾瑛","text":"锦衣坊口扬雄宅，饮马□□□水波。\n风信东来春事早，湖光西去夕阳多。\n馆娃隔水啼莺燕，弟子填门列凤鹅。\n无那老狂狂更甚，剑箫犹倚小红歌。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11489,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虎丘十咏 其一 千顷云","author":"顾瑛","text":"触石起肤寸，悠然散千顷。\n我来坐东轩，妙趣心独领。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11490,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虎丘十咏 其二 小吴轩","author":"顾瑛","text":"雪没群山尽，天垂落日悬。\n冯虚俯城郭，隐见一丝烟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11491,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虎丘十咏 其三 剑池","author":"顾瑛","text":"地坼重渊积，人亡宝剑藏。\n千年断崖月，何处照龙光。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11492,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虎丘十咏 其四 试剑石","author":"顾瑛","text":"剑试一痕秋，崖倾水断流。\n如何百年后，不斩赵高头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11493,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虎丘十咏 其五 五台山","author":"顾瑛","text":"海涌如来室，清凉即五台。\n春风山顶雪，飞度雁门来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11494,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虎丘十咏 其六 生公台","author":"顾瑛","text":"生公聚白石，麈拂天花坠。\n可怜尘中人，不解点头意。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11495,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虎丘十咏 其七 塔影","author":"顾瑛","text":"塔倚高标立，楼深一窍虚。\n海风吹幻影，颠倒落方诸。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11496,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虎丘十咏 其八 致爽阁","author":"顾瑛","text":"高阁对西山，飞岚落几间。\n开襟致秋爽，心与白云閒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11497,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虎丘十咏 其九 真娘墓","author":"顾瑛","text":"何处真娘墓，云埋断石根。\n夜深风雨急，谁唤海棠魂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11498,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虎丘十咏 其十 陆羽井","author":"顾瑛","text":"雪霁春泉碧，苔侵石甃青。\n如何陆鸿渐，不入品《茶经》。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11499,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题吴性存所藏赵仲穆竹枝双蝶图","author":"顾瑛","text":"阁道春风度，湘帘夜月初。\n多情双蛱蝶，也解逐羊车。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11500,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赵仲穆临李伯时凤头骢","author":"顾瑛","text":"君王不爱碧衔霞，独爱真龙被紫花。\n珍重王孙亲貌得，锦巾袱送野人家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11501,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"房山画","author":"顾瑛","text":"渴龙饮海海水宽，铁网下截珊瑚寒。\n道人醉卧叫寒玉，金粉乱落松花坛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11502,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"补之竹卷","author":"顾瑛","text":"碧眼胡儿叫横玉，落日如盆照茅屋。\n美人清梦断梅花，却写相思在修竹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11503,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"张仲举待制以京口海上口号见寄瑛以吴下时事答之五首 其一","author":"顾瑛","text":"白昼惊风海上号，水军三万尽乘涛。\n书生不解参军事，也向船头著战袍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11504,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"张仲举待制以京口海上口号见寄瑛以吴下时事答之五首 其二","author":"顾瑛","text":"冉冉长蛇汉水东，嘘成黑雾满虚空。\n腥风怪雨重阴底，化作黄虬不是龙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11505,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"张仲举待制以京口海上口号见寄瑛以吴下时事答之五首 其三","author":"顾瑛","text":"莫辨黄钟瓦缶声，且携斗酒听春莺。\n河西金盏新翻谱，汉语夷音唱满城。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11506,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"张仲举待制以京口海上口号见寄瑛以吴下时事答之五首 其四","author":"顾瑛","text":"红绿油牌去复来，长身碧眼更䪹腮。\n口传催办军需事，一日能无一百回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11507,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"张仲举待制以京口海上口号见寄瑛以吴下时事答之五首 其五","author":"顾瑛","text":"和籴粮船去若飞，兼春带夏未曾归。\n用钱赠米该加七，纳户身悬百结衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11508,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"乙未和孟天炜都司见寄五首 其一","author":"顾瑛","text":"江头日日惜芳时，三月春光两鬓丝。\n拔剑自歌还自舞，邑人谁识虎头痴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11509,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"乙未和孟天炜都司见寄五首 其二","author":"顾瑛","text":"治安无策济时艰，始信金销壮士颜。\n怪底飓风翻涨海，浪头一直过狼山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11510,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"乙未和孟天炜都司见寄五首 其三","author":"顾瑛","text":"猎猎东风吹火旗，水军三万尽精肥。\n一春杀贼知多少，个个身穿溅血衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11511,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"乙未和孟天炜都司见寄五首 其四","author":"顾瑛","text":"娄上人家不识春，檐头蛛网亦生尘。\n朱门桃李皆零落，只有东风未嫁人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11512,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"乙未和孟天炜都司见寄五首 其五","author":"顾瑛","text":"闻道君王自早参，每虚前席问江南。\n何人医手如秦缓，有客能棋似李憨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11513,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题赵子昂画楚江春晓","author":"顾瑛","text":"东方旭日出曈昽，照见巴江曲似弓。\n莫遣猿声到巫峡，山头犹有楚王宫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11514,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题文湖州竹","author":"顾瑛","text":"湖州昔在湖州日，日日逢人写竹枝。\n一段枯梢作三折，分明雪后上窗时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11515,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖竹枝词二首 其一","author":"顾瑛","text":"素云缺月挂秋河，听得临风《白苧》歌。\n湖水西来流不断，海潮东去是风波。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11516,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖竹枝词二首 其二","author":"顾瑛","text":"陌上采桑桑叶稀，家中看蚕怕蚕饥。\n大姑要织回文锦，小姑要织嫁时衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11517,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"新安梅和张师夔","author":"顾瑛","text":"宝地生春玉气新，苔烟如雾翠光匀。\n山僧分得维摩供，三素云中别有春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11518,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谢静远惠纸","author":"顾瑛","text":"蜀郡金花新著样，剡溪玉板旧齐名。\n荷君寄我黟川雪，犹带涟漪泻月声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11519,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谢静远惠蜜梅","author":"顾瑛","text":"江南烟雨未全黄，谁使青酸堕蜜房。\n妩媚已能知魏證，典刑时复见中郎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11520,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"玉山佳处以爱汝玉山草堂静分韵得静字","author":"顾瑛","text":"兰风荡丛薄，高宇日色静。\n林迥泛春声，帘疏散清影。\n褰裳石萝古，濯缨水花冷。\n于焉奉华觞，聊以娱昼永。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11521,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵永嘉曹新民玉山席上作","author":"顾瑛","text":"诗人得句题茅屋，客子乘流泛小舠。\n老眼看花起春雾，醉眠听雨响秋涛。\n《弓盘》舞按银鹅队，《水调》声传金凤槽。\n与尔共倾千日酒，呼童换却五云袍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11522,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"以炯如流水涵青蘋分韵得流字","author":"顾瑛","text":"幽人雅爱玉山好，肯作清酣竟日留。\n梧竹一庭凉欲雨，池台五月气涵秋。\n月中独鹤如人立，花外疏萤入幔流。\n莫笑虎头痴绝甚，题诗直欲拟汤休。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11523,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"以冰衡玉壶悬清秋分韵得壶字","author":"顾瑛","text":"郑玄于鹄本清好，况有名僧似仲殊。\n濠上鱼肥应受钓，厨中酒熟莫教酤。\n雨花落座成金粟，秋露凝寒贮玉壶。\n更向飞楼赌棋槊，香囊留得未全输。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11524,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"以玉山亭馆分题得金粟影","author":"顾瑛","text":"飞轩下瞰芙蓉渚，槛外幽花月中吐。\n天风寂寂吹古香，清露泠泠湿秋圃。\n云梯万丈手可攀，居然梦落清虚府。\n庭中捣药玉兔愁，树下乘鸾素娥舞。\n琼楼玉殿千娉婷，中有瘿仙淡眉宇。\n问我西湖旧风月，何似东华软尘土。\n寒光倒落影娥池，的皪明珠承翠羽。\n但见山河影动摇，独有清辉照今古。\n觉来作诗思茫然，金粟霏霏下如雨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11525,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"以夜阑更秉烛相对如梦寐分韵得梦字","author":"顾瑛","text":"凉风振林木，恻恻初寒动。\n肃客桃花源，张筵鸣玉洞。\n落日照金樽，飞雪栖画栋。\n谈玄味妙理，谑笑杂微讽。\n取琴雪巢弹，共听金石弄。\n嘉会固难并，聚散恍春梦。\n明发大江舟，天阔孤鸿送。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11526,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钓月轩分题","author":"顾瑛","text":"秋暑困人如中酒，凉雨凄风忽相逗。\n阶下决明花正鲜，池上芙蕖香欲瘦。\n山人欲归不得归，西夏郎官却相候。\n当轩不复问寒温，群口誇诗如健斗。\n秋娘起拂红绡袖，素壁看题今已旧。\n旧雨不来今雨来，故交那在新交右。\n坐听飞溜落虚檐，似与冰弦声合奏。\n清欢聊欲纪文字，长席还当陈俎豆。\n人生有酒不为乐，何异飞蚊聚昏昼。\n玉山醉倒嵇叔夜，紫芝光浮元德秀。\n君今此行良不苟，请君一觞为君寿。\n风帘官烛暗秋屏，归期已在黄昏后。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11527,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"芝云堂以风林纤月落分韵得纤字","author":"顾瑛","text":"空堂清饮夜厌厌，坐久情深酒屡添。\n龙气当天河鼓湿，翠痕浮树月钩纤。\n梧桐叶落鸣金井，络纬声多近绣帘。\n我欲分题纪良集，诗成还慰老夫潜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11528,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"至正十年秋七月十有三日起文高先生自姑苏汎舟携酒殽过玉山会饮芝云堂上座客于匡山琦龙门相与谈诗亹亹不绝酒半龙门分蓝田日暖玉生烟为韵余探得蓝字坐无长幼能诗者咸赋焉","author":"顾瑛","text":"高堂政在玉山南，竹色梧阴积翠岚。\n秀结紫芝云作盖，光生珠树玉如蓝。\n每劳飞鸟花间使，时有翔鸾月下骖。\n客至酒尊聊剧饮，僧来麈尾听清谈。\n行杯长待纤歌发，分韵还将险字探。\n佛印固知元九九，文殊何必说三三。\n莫忘石上三生约，且尽山中十日酣。\n当槛荷开香屡度，隔床花落雨同毵。\n鹿门何处真成隐，鸡舌他年自可含。\n送别江亭折杨柳，西风应愧雪盈簪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11529,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"余与杨君铁崖别两年矣庚寅嘉平之朔君自淞泖过余溪上适永嘉曹新民自武林至相与饮酒芝云堂明日铁崖将赴任曹君亦有茂异之举同往武林信欢会之甚难而分携之独易安可不痛饮尽兴以洗此愦愦之怀因以对酒当歌为韵赋诗如左于匡庐属瑛序数语为识","author":"顾瑛","text":"江空暮云合，岁晚雪霰多。\n佳人美无度，严装径相过。\n夜宴芝云馆，明发玉山阿。\n繁声落虚溜，急袖翻回波。\n客有子曹子，调笑春风歌。\n歌终易离别，别去愁蹉跎。\n相思梅花发，不饮当如何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11530,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"可诗斋以客从远方来遗我双鲤鱼平声字分韵得方字","author":"顾瑛","text":"海上风帆似马狂，归来仍喜佩银章。\n三年报国存忠直，一旦见亲全义方。\n祖逖誓江期复晋，董徽仗节乐还乡。\n圣恩已见金鸡放，醉饮宁辞累十觞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11531,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"海虞山人缪叔正扁舟相过以慰别后之思余谓兵后朋旧星散得一顷相见旷如隔世遂邀汝阳袁子英天平范君本彭城钱好学荣城赵善长扶风马孟昭聚首可诗斋内诸公亦乐就饮或携肴或挈果共成真率之会由是皆尽欢饮酒酣各赋诗以纪走笔而就兴有未尽者复能酬倡以乐永夜余以诗先成叔正俾余叙数语于篇首缅思烽火隔江近在百里今夕之会诚不易得况后会无期乎吴宫花草娄江风月今皆走麋鹿于瓦砾场矣独吾草堂宛在溪上余虽祝发尚能与诸公觞咏其下共忘此身于干戈","author":"顾瑛","text":"木叶纷纷乱打窗，凄风凄雨暗空江。\n世间甲子今为晋，户里庚申不到庞。\n此膝岂因儿辈屈，壮心宁受酒杯降。\n与君相见头俱白，莫惜清谈对夜釭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11532,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和缪叔正韵","author":"顾瑛","text":"白云开处见山棱，我欲跻攀力未胜。\n岁晚不为干禄士，前身应是小乘僧。\n竹林载酒邀山简，草阁裁诗愧薛能。\n结习未除閒未尽，焚香且对佛前灯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11533,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和柑字韵","author":"顾瑛","text":"一饮宁辞十日酣，浊醪到手味偏甘。\n新诗谩赋宫槐陌，好事争传海岳庵。\n霜后两螯看紫蟹，樽前一味出黄柑。\n料应堂北梅花树，今岁开时只向南。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11534,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和马孟昭韵","author":"顾瑛","text":"凄风何处起，击柝报严更。\n共此可怜夜，相看太瘦生。\n灯挑檐雨落，茶煮石泉鸣。\n犹有弥明叟，联诗慰逸情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11535,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"呈缪叔正","author":"顾瑛","text":"百里扁舟能作客，入门款语似无依。\n阿翁九月新成服，老父三冬未见归。\n江上黑风兼雨至，树头红叶带霜飞。\n伤心我亦如君切，有子天涯未授衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11536,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"碧梧翠竹堂以暗水流花径春星带草堂分韵得星字","author":"顾瑛","text":"高堂梧与竹，叆叆排空青。\n凉飙忽飞来，落我生色屏。\n为君燕坐列绮席，吴歌赵舞双娉婷。\n莼香翠缕雪齿齿，蔗浆玉碗冰泠泠。\n人生良会不可遇，况复聚散如浮萍。\n分明感此眼前事，鬓边白发皆星星。\n华亭夜鹤怨明月，何如荷锸随刘伶。\n中山有酒十日醉，汨罗羁人千古醒。\n蒲萄酒，玻璃瓶，可以驻君之色延君龄。\n脱吾帽，忘吾形，美人听我重丁宁。\n更借白玉手，进酒且莫停。\n酒中之趣通仙灵，玉笙吹月声泠泠，与尔同蹑双凤翎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11537,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"以满城风雨近重阳分韵得满字","author":"顾瑛","text":"西风吹长江，舟楫几欲断。\n仙人远方来，羽服自萧散。\n颇言官军中，杀贼尽左袒。\n时艰会面难，取醉那容缓。\n菊开重阳华，对酒莫辞满。\n赓歌杂丝竹，言笑亦侃侃。\n月明梧竹间，夜色良可款。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11538,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"以危楼高百尺分韵得危字","author":"顾瑛","text":"楼上笙歌合奏时，湖山当席最相宜。\n风吹轻袂身疑举，人立飞桥意不危。\n蜃气欲浮河汉动，秋光已近女牛期。\n潘郎容易头如雪，且醉花前双玉卮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11539,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"以冻合玉楼寒起粟分韵得冻字","author":"顾瑛","text":"积雪未消春意动，千里登临游目纵。\n月明初度影娥池，曙色稍侵鸣玉洞。\n佳人象管怯初寒，银瓶梅萼犹含冻。\n白发休嫌舞袖长，张灯夜促飞觞送。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11540,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"以吴东山水分题得阳山","author":"顾瑛","text":"别起高楼临碧溪，绕楼青山云约齐。\n阳山独出众山上，却立阳湖西复西。\n天风吹山屼不起，倒落芙蓉明镜里。\n影娥池上曲阑干，遍倚秋光三百里。\n白云不化五彩虹，化为天矫之白龙。\n一朝挟子上天去，霈泽下土昭神功。\n土人结祠倚灵洞，雨气腥翻海波动。\n纸钱窣窣蜥蜴飞，女巫击鼓歌迎送。\n兹山本是秦馀杭，越兵昼获夫差王。\n不知谁是公孙圣？\n空谷答声吴乃亡。\n只今此地愁云黑，铁马将军金作勒。\n汉蛇曷识剑雌雄，秦鹿应迷路南北。\n山下花开一色红，花下千头鹿养茸。\n衔花日献黄面老，挟群时入青莲宫。\n闻道青霜落林谷，斤斧丁丁惊鸟宿。\n千年白鹤忽飞归，失却长松旧时绿。\n君今坐看楼上头，析韵赋诗浮玉舟。\n凭高一览青未了，底事仲宣生远愁。\n明朝更踏东山路，傀儡湖中观竞渡。\n酒花滟滟泛昌阳，醉归扶上楼头去。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11541,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"以柳塘春水漫分韵得柳字","author":"顾瑛","text":"剥啄谁扣门？\n乃是忘年友。\n远从商溪来，过我绳枢牖。\n入门无一言，但觉惊我丑。\n我丑我自知，削发事三有。\n学佛亦何补，用以脱尘垢。\n全我浊世身，荐我生身母。\n羡君颜色好，濯濯春月柳。\n不为时所趋，甘著儒冠守。\n即今一相见，意思两弥厚。\n春风吹杨花，落我杯中酒。\n愿持满满杯，再起为君寿。\n君其勿我辞，罄此扫愁帚。\n不闻乱军中，食人如食狗。\n苗獠虐已甚，横杀掠人妇。\n自古戎旅间，此事十八九。\n若以乐土言，无出平湖右。\n未知干戈世，能免饿莩否。\n忍君遽云别，更欲周旋久。\n横塘新水发，舟楫不肯后。\n君今必欲归，为语无隐叟。\n愿施七宝床，大作狮子吼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11542,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"渔庄以解钓鲈鱼有几人平声字分韵得人字","author":"顾瑛","text":"芙蓉始花秋水新，小庄落日酒相亲。\n渔童樵青解歌舞，茶灶笔床随主宾。\n龙门山人碧玉麈，会稽外史白纶巾。\n莼羹鲈鲙我所爱，吟对西风怀远人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11543,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"欸歌二首 其一","author":"顾瑛","text":"返照移晴入绮窗，芙蓉杨柳满秋江。\n渔童欸乃荡舟去，惊起锦凫飞一双。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11544,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]