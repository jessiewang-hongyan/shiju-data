[{"title":"自述","author":"金涓","text":"疆埸正多故，山林成久留。\n据鞍皆战马，扣角且歌牛。\n清德交游冷，光明诗思浮。\n从今脱尘浊，自可鄙公侯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7073,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春兴 其一","author":"金涓","text":"菜甲时堪摘，柴荆昼不开。\n凿渠通水道，度地觅花栽。\n旅食凭儒术，春愁仗酒杯。\n却憎尘世薄，徒尔暂徘徊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7074,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春兴 其二","author":"金涓","text":"落落相如志，悠悠王粲悲。\n乾坤犹甲胄，耕凿且年时。\n伐木开新径，引泉添小池。\n个中非所适，排闷且裁诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7075,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春兴 其三","author":"金涓","text":"草阁成迁次，春来景物新。\n杖藜时野外，把钓即溪滨。\n夜雨桑麻足，东风草木匀。\n关河阻南北，何处问通津。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7076,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夜","author":"金涓","text":"四望秋无际，凭栏夜未央。\n星榆晴舞叶，月桂冷飞香。\n人澹琴心苦，林幽鹤梦长。\n此情当此夕，谁肯赏凄凉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7077,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江村","author":"金涓","text":"寂寂江村路，轻烟晚自生。\n远峰晴有色，独树煖无声。\n渚鹭行看水，溪鱼卖入城。\n孤舟人不渡，两岸夕阳明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7078,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钱塘行在","author":"金涓","text":"凤舞龙飞处，寒烟半野蒿。\n地卑东海近，天远北辰高。\n来往春秋燕，盈虚日夜潮。\n老僧年八十，对客话前朝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7079,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"伍员庙","author":"金涓","text":"东出昭关日，仓皇去路遥。\n渔人怜赠剑，市吏识吹箫。\n楚郢鞭荒墓，吴江起怒潮。\n因思臣子节，千古一魂消。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7080,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟次渔浦","author":"金涓","text":"双溪东入浙，终日坐危舟。\n流水远明目，小篷低压头。\n烟村鸦入暮，江国雁宾秋。\n一片凄凉景，安排独客愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7081,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浙江晓渡","author":"金涓","text":"片帆风力饱，凉气碧飕飕。\n江阔欲沉雁，天空惟见秋。\n渔歌闻四起，人影在中流。\n隔望秦峰出，东南第一洲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7082,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨后书怀","author":"金涓","text":"畏俗久不出，其如此意何。\n鬓毛诗白尽，山色雨青多。\n曲偃行蛇草，圆生浴鸟波。\n与谁专一壑，同和采芝歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7083,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"康湖山居","author":"金涓","text":"康湖环十里，半世乐吟身。\n白屋居寒士，青山是故人。\n松多天不暑，瀑近地无尘。\n颇得渔樵趣，生涯日又新。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7084,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送人回剡","author":"金涓","text":"华川游未遍，又作剡中游。\n诗海珊瑚月，书田苜蓿秋。\n行山时借屐，访雪夜乘舟。\n别后怀人处，清风独倚楼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7085,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"别徐处士归严州","author":"金涓","text":"浙水连天白，轻帆带雨飞。\n榻悬高士去，钓在故人归。\n秋尽雁初过，江空鱼正肥。\n君如招伴隐，我正欲相依。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7086,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"别友人归衢","author":"金涓","text":"烂柯山下路，猿鸟待多时。\n今伴少微隐，何愁太史知。\n葛陂龙化早，辽海鹤归迟。\n为问山中叟，如今几局棋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7087,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送友晓发赴北","author":"金涓","text":"荒鸡三唱后，河汉正西流。\n太白孤星晓，中华大野秋。\n树低江郭远，风急草烟收。\n此去金台上，观光乐胜游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7088,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客中与友人言别","author":"金涓","text":"同是婺中人，情亲若弟兄。\n客边今识面，诗上已闻名。\n驿柳分春远，山花照晚明。\n相逢即相别，流水几多情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7089,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"旅怀","author":"金涓","text":"江湖为客久，归计与谁论。\n春色草无路，雨声人闭门。\n薄衣知酒煖，病眼觉灯昏。\n蜀水家边景，连宵役梦魂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7090,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江楼有见","author":"金涓","text":"睡起无忙事，寒多不下楼。\n橹声和雁去，江影照人愁。\n山碧云初晓，林红叶正秋。\n琴书无恙否，我欲问归舟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7091,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山园即事","author":"金涓","text":"暖日丽亭台，山屏四面开。\n与谁行乐去，有客伴吟来。\n凤舞摩挲竹，龙蟠屹崛梅。\n春风似相识，终日共徘徊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7092,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自述","author":"金涓","text":"索居三十载，一砚铁穿磨。\n学浅非时用，人生奈老何。\n竹房来暝早，花坞聚春多。\n静坐无馀事，门前水自波。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7093,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次杨仲齐韵 其一","author":"金涓","text":"端坐无时事，春秋读圣经。\n逐风惊退鹢，陨石看飞星。\n自谓心将愦，何期眼倍青。\n获麟应绝笔，三叹动虚灵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7094,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次杨仲齐韵 其二","author":"金涓","text":"空谷开云叶，清池曳水衣。\n阶苔扫不尽，山果摘还稀。\n长啸妨僧定，徐行看月辉。\n狝猴庭下过，扰乱静中机。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7095,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次杨仲齐韵 其三","author":"金涓","text":"书巢何所有，香缕散纷纭。\n明月将梅到，虚楼看夜分。\n僧归惊卧犬，锡落破层云。\n语及外间事，令人不敢闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7096,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"村居","author":"金涓","text":"荒草无行路，人家隔小溪。\n雨多岚气重，石少水声低。\n病鹤依松立，寒鸡傍砌啼。\n近来浑懒动，静处欲幽栖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7097,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"对客","author":"金涓","text":"对客谈清话，相忘酒一壶。\n吟肠倾大白，醉额岸轻乌。\n午饤新齑韭，秋厨活脍鲈。\n明朝重有约，一笑过康湖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7098,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"乱中自述 其一","author":"金涓","text":"汩汩兵犹竞，凄凄兴莫赊。\n娇儿将学语，稚子惯烹茶。\n乱后添新鬼，春归发旧花。\n十年湖海志，羁思满天涯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7099,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"乱中自述 其二","author":"金涓","text":"幽居邻水竹，避地独柴门。\n白日琴书净，春风燕雀喧。\n看山频矮屐，适兴任芳樽。\n天地军麾满，诗成自朗吟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7100,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"乱中自述 其三","author":"金涓","text":"园林春已半，茅屋日初长。\n水动鱼儿出，花飞燕子忙。\n看云閒坐石，把酒湿征裳。\n落落当年恨，高歌竟欲狂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7101,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"乱中自述 其四","author":"金涓","text":"春梦犹为客，题诗发兴清。\n风帘茅店酒，晴日柳桥莺。\n亲老频归觐，时危未息兵。\n况来招隐计，拟问鹿门行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7102,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夜有感","author":"金涓","text":"苦吟人不寐，中夜启幽扉。\n明月霜初下，西风叶正稀。\n家贫豚有子，天冷客无衣。\n感事忽如梦，孤萤入我帏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7103,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"暮秋怀归","author":"金涓","text":"西风三径菊，秋晚正花开。\n家远书难寄，天寒雁未来。\n青山如旧识，白眼妒奇才。\n遥忆浯溪路，年年长绿苔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7104,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"用仲敬先生折桂韵","author":"金涓","text":"金印悬腰不用黄，丹溪垂钓亦何伤。\n舟移鹭点青山破，笛弄梅飘白雪香。\n月里版图窥窄窄，望中鸿鹄去茫茫。\n萧曹不是逢隆准，未必姓名千载芳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7105,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜宿青陂","author":"金涓","text":"为爱青陂甚潇洒，二三杖屦乐徘徊。\n道人棹雪今何在，野老牵衣不放回。\n别坞犬声风送至，谁家梅影月偷来。\n卜邻若许成茅屋，日种芝兰千百栽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7106,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"用前韵复春谷道人","author":"金涓","text":"春谷无尘宜笑傲，蜀山有路可徘徊。\n蛟龙得雨翻犹卧，雕鹗横秋又早回。\n放艇几同渔父去，看棋时许野樵来。\n洞前更约东风转，仙李碧桃随意栽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7107,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"用杨仲章兵字庐字韵 其一","author":"金涓","text":"林森剑戟立天兵，不碍琴书嘉遁情。\n李愿钓鲜情自逸，谢安补屐兴何清。\n岩房罢磬销香篆，石壁题诗纪姓名。\n我欲相从无羽翼，秋风鸡黍约佳盟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7108,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"用杨仲章兵字庐字韵 其二","author":"金涓","text":"不向人间结草庐，任他城市务赢馀。\n饱餐薇蕨泉中水，过眼牙签架上书。\n岚气著窗云影过，钟声入梦曙光初。\n高居自与禅机会，何害门稀长者车。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7109,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山行","author":"金涓","text":"望望峰峦紫翠凝，杖藜补屐谩登登。\n樵歌谷静声相荅，雨霁林香气欲蒸。\n行乐可无诗似锦，从容那用酒如渑。\n何当摆脱尘中虑，许我移家共作朋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7110,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄许存仁存礼 其一","author":"金涓","text":"金华有客负材丰，搜抉神奇夺化工。\n爱酒何殊陶栗里，隐居真似陆龟蒙。\n欲知晴日莺花处，尽入新诗品藻中。\n江汉夕烽然未息，莫将心事较穷通。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7111,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄许存仁存礼 其二","author":"金涓","text":"年来无事学休粮，蜀墅溪头有草堂。\n几度瞻云思棣萼，清宵看月坐藤床。\n侵晨处士烟霞疾，惭愧才人锦绣肠。\n樗散声名甘寂寞，从教诗句只寻常。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7112,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄友人宋邦彦","author":"金涓","text":"故人别后见尤难，彼此诗盟尚未寒。\n宁暇对床论契阔，漫劳折简报平安。\n春山裂竹愁如海，流水落花红满滩。\n九十春光都过了，诸君何以罄交欢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7113,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄胡希颜","author":"金涓","text":"伐木有诗谁善赋，嘤嘤唤起远相求。\n白沙翠竹一村晓，锦树黄花满野秋。\n雪夜艰难呼桧楫，晴风容易下书楼。\n独怜浩浩多真乐，不似栖栖蕴积忧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7114,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重游光明寺","author":"金涓","text":"梵王宫阙倚崔嵬，积翠缤纷图画开。\n啼鸟避人穿树去，老僧迎客下山来。\n裁诗石径书青竹，散发云林卧绿苔。\n自识个中幽兴熟，杖藜何惜重徘徊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7115,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送李子威之金陵","author":"金涓","text":"金陵自古帝王州，策马飘然作胜游。\n一代衣冠新礼乐，六朝文物昔风流。\n此时送别诗盈轴，何处相思月满楼。\n若见潜溪宋夫子，勿云江汉有扁舟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7116,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋兴","author":"金涓","text":"摇落频惊节序催，乱离怀复向谁开。\n江山滚滚红尘暗，霜露凄凄白雁来。\n雄剑醉提时慷慨，矮衣屡舞起徘徊。\n近闻幕府徵豪杰，当代谁为济世才。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7117,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题杨伯容竹居","author":"金涓","text":"最爱君家竹居好，秋花锦石相新鲜。\n窗前读易无俗子，林下置酒多才贤。\n宝鸭昼焚香满室，铁笛夜吹声在天。\n安得卜邻近左右，与君日日谈诗篇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7118,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送杨仲齐之武川训导","author":"金涓","text":"闻道琴书行有日，临岐送别意何如。\n蒲萄酒美杯初泛，杨柳条新叶未舒。\n春入杏坛朝鼓瑟，雨馀芹泮水生鱼。\n定知别后遥相忆，毋惜频频远寄书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7119,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春暮客中述怀","author":"金涓","text":"幽窗寂寂问音疏，牢落干戈且读书。\n芳草王孙归未得，青春客子意何如。\n花残树底园收果，水落溪头人买鱼。\n为问纷纷当路者，飞腾还肯顾蟾蜍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7120,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"会胡原道冯原辅溪饮","author":"金涓","text":"溪流一曲石为城，中有回澜分外清。\n金盏萦纡天上泛，玉盘宛转镜中行。\n日高松影侵衣碎，风绽杨花落帽轻。\n我辈固知文字饮，凤笙龙管向谁鸣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7121,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"野步有感书寄城中黄上舍","author":"金涓","text":"新晴野步踏青晖，万绿枝头可染衣。\n流水小桥通野涧，斜风飞絮点苔矶。\n春归别驾凭谁管，儒负虚名与愿违。\n惆怅年华更迭易，达人何事不知机。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7122,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"喜雨寄杨伯容","author":"金涓","text":"江城晓夜雨浪浪，并作芳斋六月凉。\n倚杖出门田父乐，题诗呼酒野人狂。\n不愁战地多兵甲，遂喜丰年足稻粱。\n问讯草玄亭上客，竹林疏簟梦秋光。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7123,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋暮会杨仲章","author":"金涓","text":"矮褐凄凉淹别馆，故人一见话绸缪。\n溪头水落鱼龙夜，塞北云深鼓角秋。\n烂醉岂知犹是酒，相逢谁为不封侯。\n江湖明日重分手，满眼西风独倚楼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7124,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠术士吕公","author":"金涓","text":"短褐垂纶已十载，柴扉筚窦即湖边。\n年来出处常存道，身外功名懒问天。\n造次可无诗入圣，相逢还有酒为贤。\n虎头燕颔君休论，好向山阴买钓船。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7125,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自叹","author":"金涓","text":"雀声催我过湖西，日暮归来看药畦。\n耄老不思安乐土，问人何处托幽栖。\n白云出岫心何在，仙鹤离巢树欠低。\n携取琴书便归去，奚烦更待杜鹃啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7126,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠陈仲玉本学教谕致仕","author":"金涓","text":"听雨芹池二十年，如何一旦捲青毡。\n陡令猿鹤生秋怨，高枕琴书且昼眠。\n诗为懒题闲木笔，饭因不足羡苔钱。\n石田茅屋华川曲，从此挑灯绣佛前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7127,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"清德晚归","author":"金涓","text":"酒留诗恋意迟迟，回到中途已落晖。\n小蹇引秋行落叶，老渔隈冷坐危矶。\n山间明月随人出，松外閒云伴鹤归。\n试问夜深何处宿，欲从山下扣禅扉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7128,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"方学士招饮不赴","author":"金涓","text":"我在林间鹿与群，君为天上玉麒麟。\n莫将綵树灯前酒，来醉梅花月下人。\n白屋不生三阁梦，青山那识五陵春。\n行吟每到看松处，自有渔樵作主宾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7129,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"小斋","author":"金涓","text":"世道非时懒屈人，小斋容膝且安贫。\n河图不出空歌凤，鲁史将终遇获麟。\n云掩松窗低结暝，水行花径曲流春。\n近来颇得幽閒趣，几夜青山入梦频。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7130,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋江话别","author":"金涓","text":"别酒相倾别泪流，江流亦不为君留。\n片帆今夜人何处，明月满天谁共楼。\n一雁叫霜红入叶，十年为客白侵头。\n莫嫌归计多萧索，三径西风菊正秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7131,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送杨学谕还浦江","author":"金涓","text":"萍迹相逢又一年，小楼情味共凄然。\n半窗灯影看书坐，四壁秋声听雨眠。\n浦汭暮云迷去雁，樵溪春水忆归船。\n重游莫负华山约，须趁梅花早著鞭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7132,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠王隐君叔诚","author":"金涓","text":"投老江湖作隐君，凤来龙去绝无闻。\n孤山梅近閒吟月，九里松深稳卧云。\n书屋几番留鹤守，钓矶一半与鸥分。\n摛文染藻风流处，可似兰亭王右军。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7133,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送张学谕归三衢","author":"金涓","text":"稳泛灵槎访斗牛，未容归伴赤松游。\n莼鲈此去无千里，鸡黍相期在几秋。\n瀔水月寒梅入梦，绣湖烟澹柳分愁。\n春风莫问田园计，须趁功名在黑头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7134,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"金华史学录回永嘉雁荡","author":"金涓","text":"青衫洗尽泮宫尘，三载琴书又问津。\n海阔正怜鸿去远，山深须遣雁来频。\n沈郎风月诗俱瘦，谢老池塘草自春。\n莫笑广文官独冷，长安一日看花人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7135,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄王照磨季耕","author":"金涓","text":"底事乡心忆镜湖，一朝归去伴樵渔。\n传家尚喜贫存砚，教子尤勤老著书。\n静里有时观水坐，闲来何处买山居。\n门?桃李应如旧，添得春风柳五株。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7136,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]