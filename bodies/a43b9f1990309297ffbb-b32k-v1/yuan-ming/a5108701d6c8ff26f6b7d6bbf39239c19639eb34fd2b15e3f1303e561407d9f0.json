[{"title":"风雨驴上三首 其三","author":"蓝智","text":"山云故作今朝雨，湖水新添昨夜痕。\n细草幽花俱有意，青山相对已忘言。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10273,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中时景四首 其一","author":"蓝智","text":"层层金碧倚岩阿，花径春浓有客过。\n行到野桥观石瀑，始知人世挽天河。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10274,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中时景四首 其二","author":"蓝智","text":"野亭分坐纳微凉，绿树青阴昼景长。\n不有山林深更僻，人间无处避骄阳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10275,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中时景四首 其三","author":"蓝智","text":"强与登高行路难，溪桥危坐对秋山。\n白云红树添诗兴，月上长空忘却还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10276,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中时景四首 其四","author":"蓝智","text":"独钓寒江雪满蓑，数峰相映玉嵯峨。\n闭门谁念山中客，自比袁安懒更多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10277,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"姑苏河上作","author":"蓝智","text":"杨柳青青河水浑，野桥茅店水边村。\n官船三日姑苏道，处处青山似故园。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10278,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丹阳县道中","author":"蓝智","text":"丹阳郭外山无数，茅屋松林下夕阳。\n绝似武夷秋雨后，野桥流水稻花香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10279,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江上夜作","author":"蓝智","text":"晚风吹雪散晴云，移棹沧江入白蘋。\n梦觉不知天在水，却疑楂影上星辰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10280,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"溪上","author":"蓝智","text":"青裙妇女采茶苦，白发老人烧笋甘。\n松寺雨晴宜晚步，杏花风暖重春酣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10281,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"旅邸偶成","author":"蓝智","text":"今日雨晴双燕归，野桥茅屋又斜晖。\n便须买酒酹春色，莫放桃花树树飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10282,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"暮春怀李孟和","author":"蓝智","text":"春雨霏霏映茅屋，空庭无人芳草绿。\n相思何故不成眠，一夜南风笋成竹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10283,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日试笔四首 其一","author":"蓝智","text":"四海车书已混同，万年历数帝王功。\n山川草木知多少，总在风云雨露中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10284,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日试笔四首 其二","author":"蓝智","text":"曾瞻日月御阶明，岂有风霜岭徼清。\n只好南山对春雨，老农击壤颂升平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10285,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日试笔四首 其三","author":"蓝智","text":"偶从江海踏星楂，万里逢春正忆家。\n唯有君恩深似雨，东风草色满天涯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10286,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日试笔四首 其四","author":"蓝智","text":"又看庭草换年华，最忆痴儿未到家。\n白发倚门望春信，好风开遍杏桃花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10287,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"癸丑元夕柳州见梅忆泽儿","author":"蓝智","text":"忽见繁花乱客愁，东风寂寞古龙州。\n故园稚子无消息，坐对寒江月满楼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10288,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江上晚景","author":"蓝智","text":"疏雨残云共晚风，长髯乌帽独掀蓬。\n江山绝似元晖画，浦树沙禽惨澹中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10289,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中上龙门江","author":"蓝智","text":"沙头新水绿无痕，茆屋孤烟已近村。\n岭海三年心力倦，卧听春雨上龙门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10290,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"元日贺州公馆","author":"蓝智","text":"雪消公馆日迟迟，绿树微风动鬓丝。\n山鸟下庭人吏散，独看幽草立多时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10291,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"戏题临贺公馆双柏","author":"蓝智","text":"空庭老树并苍苍，密叶曾经使者霜。\n南国久无王化及，好留春色比甘棠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10292,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感旧","author":"蓝智","text":"荒林茅屋绝炊烟，秋草当门尽废田。\n野老无牛无子息，里胥犹索赡军钱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10293,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"忆故园丛竹","author":"蓝智","text":"旧栽丛竹荫衡门，想见春风长子孙。\n书阁无人裁蠹简，清池科斗共黄昏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10294,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"忆橘树","author":"蓝智","text":"橘树新移近草堂，开轩时爱午阴凉。\n春来应是花如雪，吹落苏耽井水香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10295,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江上看晚山忆方壶高士","author":"蓝智","text":"秋树连云日色残，晚风初定绿波閒。\n方壶老去空能画，不见长江雨后山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10296,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀山中","author":"蓝智","text":"久别山中鸾鹤群，清斋自礼武夷君。\n沧江明月扁舟后，浑似松窗卧白云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10297,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题李息斋墨竹","author":"蓝智","text":"萧萧晴影动秋风，春老湘江碧玉丛。\n夜半酒醒吹短笛，起看栖凤月明中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10298,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题温日观蒲萄 其一","author":"蓝智","text":"数藤马乳秋风晚，一架骊珠夜月明。\n忆作草堂看画日，惠连诗句独先成。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10299,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题温日观蒲萄 其二","author":"蓝智","text":"开士名流温日观，最能泼墨作蒲萄。\n君家此本何年物，仿佛前人笔格高。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10300,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"蜀江雨霁图","author":"蓝智","text":"瞿唐雨霁起春澜，空翠楼台杳蔼间。\n万里桥西花似锦，暮云依旧隔巫山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10301,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题湖山秋意图","author":"蓝智","text":"白水青山澹澹秋，晚凉同醉木兰舟。\n西风无限江南意，杨柳芙蓉不解秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10302,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题秋江云树图 其一","author":"蓝智","text":"草阁柴扉入翠微，碧云红树晚依依。\n美人何事秋江上，采得芙蓉未肯归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10303,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题秋江云树图 其二","author":"蓝智","text":"老树晴云半有无，雨馀秋色满江湖。\n扁舟也欲投簪去，何处青山似画图。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10304,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题郑御史竹木图","author":"蓝智","text":"郑公胸次贮冰壶，爱写疏篁古木图。\n携入洞天人不识，借看唯有列仙癯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10305,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题古木苍藤图","author":"蓝智","text":"风云气质雪霜踪，独立空山惨淡中。\n惭愧藤萝争附托，年年春色换青红。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10306,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题篁棘幽禽图","author":"蓝智","text":"春山啼鸟杂花香，丛棘修筠各自芳。\n何似梧桐西掖树，千年鸣凤向朝阳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10307,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桂林见梅 其一","author":"蓝智","text":"岭南两度见梅开，远客空惊白发催。\n忽忆繁花蓝涧曲，好山无数梦中来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10308,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桂林见梅 其二","author":"蓝智","text":"忽见罗浮万鹤群，水边林下玉缤纷。\n岭南自古无霜雪，喜有寒香压瘴云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10309,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桂林见梅 其三","author":"蓝智","text":"冷蕊疏花自不禁，长松脩竹共萧森。\n高标迥立风霜表，始见平生铁石心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10310,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桂林见梅 其四","author":"蓝智","text":"曾记寒窗为写真，东风綵笔自生春。\n江南万点花如雪，落月空梁梦古人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10311,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桂林见梅 其五","author":"蓝智","text":"清池老树落花稀，雪满仙岩独鹤归。\n十二楼台天似水，空香散作白云飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10312,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题魏宰扇面小景","author":"蓝智","text":"山上层层僧舍，树间短短茅檐。\n他日官閒无事，杖藜添个陶潜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10313,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠张尚书四十韵","author":"蓝智","text":"皇华天子使，文彩尚书郎。\n麟趾西河瑞，龙光北斗傍。\n二星占分野，十月报开洋。\n海雾清三岛，天威靖八荒。\n浮楂迎博望，决策用张良。\n必见金陵复，俱瞻玉节光。\n自天持凤诏，灵雨护龙骧。\n当宁劳宵旰，安边仗纪纲。\n江淮遗草莽，郡邑尚豺狼。\n汉代黄巾乱，公孙白马狂。\n朝廷徵李泌，将帅得汾阳。\n秦巩销烽燧，青徐入稻粱。\n江平天失堑，海阔地无疆。\n破竹声相应，投鞭势莫当。\n釜鱼犹假息，穴兔且深藏。\n尚肆凭陵恶，须期杀伐张。\n大军兼水陆，小丑负城隍。\n逆境多流血，凶徒尚裹疮。\n弄兵怜渤海，焚玉惜昆岗。\n自古称怀远，由来戒杀伤。\n帝心惟恻隐，兵势敢披猖。\n冠盖通南极，丝纶下朔方。\n投戈荣锡爵，捲甲付银章。\n舜德三苗服，周询六辔扬。\n七闽开道路，九曲引舟航。\n仙馆烟霞晚，精庐树木凉。\n腐儒叨泛爱，清论耿难忘。\n惨淡干戈地，萧条翰墨场。\n扬雄词赋苦，潘岳鬓毛苍。\n壮志甘沦落，幽怀倍激昂。\n中兴期汉武，小雅美宣王。\n图画云台峻，讴歌海宇康。\n黄金收騕袅，紫气识干将。\n畎亩身何用，江湖兴自长。\n避人从白帽，方士与青囊。\n葵藿终倾日，松筠久傲霜。\n谬蒙三握发，愁缓九回肠。\n不待除蜂蚁，唯应致凤凰。\n牛歌伤白石，渔父爱沧浪。\n我亦依耕钓，君还佐庙堂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10314,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题江山小影屏风","author":"蓝智","text":"幕府青春好，中郎画笔精。\n水疑沧海阔，山似武夷清。\n玉气通玄圃，霞标散赤城。\n桃源深处入，松籁静中生。\n浦绿思捐佩，江清拟濯缨。\n鸥边分野艇，鹤下辨柴荆。\n树色依屏浅，薇香点墨轻。\n忽看茆屋趣，好听采樵声。\n拄笏迎朝爽，钩帘对晚晴。\n径无豺虎迹，庭有凤凰鸣。\n回首蓝田隔，何时草阁成。\n江湖犹在眼，丘壑正含情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10315,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过巢云故亭","author":"蓝智","text":"故老投簪日，林园接武夷。\n贫甘诗酒乐，病耻国家危。\n惨淡群龙斗，苍茫九鼎移。\n新愁冲雨雪，旧梦隔茆茨。\n苔涩弹棋石，荷枮洗墨池。\n空堂宾客散，长路死生疑。\n竹冷题诗处，山空堕泪时。\n凄凉亭上月，徒起九原悲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10316,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"石镜","author":"蓝智","text":"明韫浯溪上，高悬洞府阴。\n润疑磨碧玉，坚想铸黄金。\n日月流光彩，山川入照临。\n龙精腾变化，虎穴露嵚崟。\n朗鉴天文丽，虚涵地脉深。\n须髯窥老狖，毛羽认栖禽。\n玉女曾遥对，湘君费远寻。\n菱开朝炯炯，凤去夜沉沉。\n苔藓那能蚀，尘埃莫漫侵。\n千秋如献录，万里烛丹心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10317,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"湘阴舜妃庙","author":"蓝智","text":"虞帝南巡日，英皇北望时。\n翠华春不返，碧草暮相思。\n万里重湖水，空山二女祠。\n沉珠真自惜，埋玉竟谁知。\n斑竹留双泪，苍梧隔九疑。\n天涯龙驭远，镜里凤情悲。\n巫雨凄残梦，湘云蔼暝姿。\n渚芳迎杂佩，波影动灵旗。\n惨淡思韶舞，凄凉咏楚辞。\n空馀清夜瑟，幽怨托哀丝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10318,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"湘江舟中赋红叶寄友人","author":"蓝智","text":"巫峡清霜下，湘潭落照中。\n秋容生野桕，寒色带江枫。\n摇落年华暮，萧疏野望同。\n帜疑张赵壁，绮类结隋宫。\n乱落浑如雨，微飘不待风。\n鹤惊仙顶化，鸡讶斗冠空。\n宫袂霞绡剪，天坛绛节通。\n渚莲晴堕片，阶药昼翻丛。\n畬树延残火，川波饮断虹。\n林疏分一二，浦极眩西东。\n朱鸟连星灿，赪虬驭日雄。\n锦机侵湿雾，荔颗耀晴烘。\n云白看偏好，厓青点更工。\n煌煌丹伏鼎，赫赫剑腾丰。\n寺冷堆僧砌，汀昏映钓篷。\n巢边惊宿鹊，塞外伴归鸿。\n颜赭宁怀愧，心丹欲效忠。\n飘零同泛梗，浩荡逐飞蓬。\n闭户书应遍，临阶扫未穷。\n美人秋水外，不用怨题红。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10319,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜坐次高季迪","author":"徐贲","text":"夜灯耿耿风帷低，雨叶似秋寒更凄。\n城远击柝惨难齐，抱中幼子悄悲啼。\n不知情思向谁是，独坐空房忆故妻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10320,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题镏生柳庄","author":"徐贲","text":"碧山绿水转逶迤，君家住处宛适宜。\n春风绕屋杨柳树，为君争发艳阳时。\n艳阳时节风光早，万叶千丝向人好。\n何如遗恨武昌门，难同送别长安道。\n拂烟照水更多情，枝间百啭有啼莺。\n娇倾赵女筵前舞，思入燕姬笛里声。\n白花撩乱波摇荡，密影芳阴自来往。\n坐邀钓侣把长竿，行倩菱童棹孤榜。\n记取前时亲手栽，丝丝叶叶费春裁。\n愿得傍人莫轻折，岁岁年年春自来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10321,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠巾工李澹斋","author":"徐贲","text":"十年奔走风尘里，短发翛翛被双耳。\n百回栉沐向朝阳，千度爬搔照秋水。\n岁华冉冉逼我来，相对虽悲亦还喜。\n翻思离乱眼中人，如此头颅能有几。\n乃知鬓丝增老丑，逢人自觉吾形滓。\n吾闻李翁解作巾，百钱买裹聊复尔。\n旧藏白氎不易得，古制平头差可拟。\n临风见影颇自整，只有羁人脱蓬累。\n李翁李翁遗世者，萧然一屋吴兴市。\n全家但食卖巾钱，能以此技代耘耔。\n我因作诗贻李翁，愿翁子孙守翁技。\n我今亦是织屦人，同与徜徉没馀齿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10322,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题葛仙翁移家图","author":"徐贲","text":"典午中衰乱人纪，诸藩搆隙兵戈里。\n江左名贤各有图，先生抱朴徵不起。\n先生好学得异书，九丹妙得玄中理。\n紫髯绿发丰姿秀，萧然自是烟霞士。\n当时入洛不论功，荣利弃之如敝屣。\n求丹愿作勾漏令，便挈全家度交趾。\n南行适逢邓广州，一留罗浮遂终此。\n坛上时看药灶光，井中犹是丹砂水。\n暂将劲翮戢鹪鴳，蹑景追风岂能已。\n先生丹成骨已仙，独见文章在青史。\n龙眠居士真好奇，貌作新图宛相似。\n先生自骑黄鹿行，僮仆提携子侄倚。\n药瓢茶磨家具足，前驱牛骡后厖豕。\n乃知粉墨幻人化，干淡点缀无不美。\n今日玉堂雪初霁，展卷令我心神喜。\n特为题诗继后尘，再拜高风仰千祀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10323,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题明皇夜游图","author":"徐贲","text":"花萼楼前烟漠漠，君王睡重无人觉。\n别宫漏点恋寒宵，閒却梨园太平乐。\n云龙十二秋扶摇，青藜化作黄金桥。\n翡翠门屏桂枝影，素娥羽带香风飘。\n优童共记霓裳舞，归来换尽人间谱。\n梧桐击碎教妖环，蜀山梦战渔阳鼓。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10324,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"月轩","author":"徐贲","text":"蟾蜍飞去老不死，清光夜涌沧波起。\n桂花露湿泣古香，广寒一色铺秋水。\n洞房深开云母屏，梦骑白凤游青冥。\n冰轮碾碎山河影，姮娥含羞舞不整。\n窃得灵丹玉兔愁，归卧芙蓉碧烟冷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10325,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"翠竹黄花二仕女图 其一","author":"徐贲","text":"萝屋绵烟敛微夕，锦瑟罢弹机罢织。\n寒浓翠薄妒蝉衫，竹色摇风竞疏碧。\n凤声天远谁能闻，绿蛾黛影愁不分。\n楚山九点昨宵梦，泪花染尽潇湘云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10326,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"翠竹黄花二仕女图 其二","author":"徐贲","text":"翠衫轻薄裁新蝉，琅玕献碧争秋妍。\n愁萦翠黛向谁是，望中九点芙蓉烟。\n泪簇霜痕紫云浅，晓色初凝寒意软。\n卖珠小婢未还家，倚风独看黄菊花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10327,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西山爽气楼","author":"徐贲","text":"钱塘西湖吾旧游，每游只为湖山留。\n欲将胜槩入登览，泉石琐琐何烦求。\n古来英雄远莫见，往事寂寞谁复收。\n知君平生好奇观，结楼却在西湖头。\n山南山北竞萧爽，四时佳气常如秋。\n平波直与天上下，众峰不共云沉浮。\n此邦富庶甲西浙，湖山宴赏无时休。\n纷纷尽日逐歌舞，安知中有万古愁。\n丈夫不作少年事，与君买醉登兹楼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10328,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"十二月廿一日寻梅到西坞留题山家","author":"徐贲","text":"昨日看泉到山北，石路巉岩苦攀陟。\n寻源未穷力已疲，百步无多几停息。\n今朝寻梅到西坞，野旷霜晴好风日。\n两株却傍山家开，柴门蓊菀连丛棘。\n老樵出迎颇解事，扫石坐我吟其侧。\n疏花冷蕊自逞妍，不放寒香洗胸臆。\n何郎久没杜陵老，好句独有林逋得。\n花虽无情弗与较，嗟我怀抱花宁识。\n明当携酒此问春，东风应念重来客。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10329,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"吕山人将来游蜀山因赋诗以要之","author":"徐贲","text":"草堂窈窕乱山空，流云啼鸟路西东。\n薜萝烟杳青林入，芰荷雨满碧溪通。\n秾花芳月时时有，花月金樽长汎酒。\n蜀山苕水近相连，南风荡漾木兰船。\n閒陪钩侣芦洲外，屡觅樵童松障前。\n樵童钓侣行相识，吴语蛮歌自朝夕。\n梦魂不解齐门竿，怀抱都随谢家屐。\n山中风景独君知，结邻谁肯作幽期。\n淮南桂树秋摇落，更为重吟招隐诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10330,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"鹊轩为王孝子作","author":"徐贲","text":"金华山人王孝子，自来生长金华里。\n阿母初生孝子时，鸣鹊飞来树头止。\n子生日长母日健，每听鹊声心辄喜。\n鹊声在树母在堂，孝子晨昏具甘旨。\n愿言阿母享遐龄，鹊声喳喳长在耳。\n阿母生子愿子贤，今子作官东海涘。\n一朝母逝鹊不来，回首家乡隔山水。\n鹊不来兮其奈何，母子恩情那得已。\n天高地深恨无托，作轩名鹊良有以。\n我亦飘零未归客，父母早殁失怙恃。\n十年空守骨肉函，有泪不入黄泉底。\n故山非无一抔土，长路风尘阻戎垒。\n闻君孝行未识君，为记诗章持送似。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10331,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]