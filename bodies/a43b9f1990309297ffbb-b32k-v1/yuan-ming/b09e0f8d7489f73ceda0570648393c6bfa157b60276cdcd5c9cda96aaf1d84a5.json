[{"title":"送思上人","author":"徐贲","text":"一瓶与一锡，游越复游吴。\n到寺长逢旧，看山每过湖。\n饭缘随处有，法意本来无。\n南地多猿鸟，还惊梵语殊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2153,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"咏妓","author":"徐贲","text":"出阁初含笑，临筵复理妆。\n兰膏分鬓绿，蕊粉间眉黄。\n掩扇羞嗔小，褰衣舞恨长。\n不知坐中客，若个是卢郎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2154,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠虚中上人","author":"徐贲","text":"归去东林寺，行寻曲涧流。\n馀灯因佛在，宿饭为猿留。\n竹屋烟迎夕，菱池雨送秋。\n还参众师旧，一一话曾游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2155,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赋得广文舍赠李文学","author":"徐贲","text":"地与齐宫接，门临泮水开。\n广文骑马到，司业送钱来。\n芹向春时采，槐多乱后栽。\n无毡不须叹，相遇且衔杯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2156,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送客","author":"徐贲","text":"津亭鸣鼓罢，行色柳先知。\n酒到听歌歇，诗因恋别迟。\n乱山投驿晚，疋马扣门时。\n草檄军中事，多应载笔随。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2157,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"戊申正月试笔","author":"徐贲","text":"佳气丽层城，龙河溢晓清。\n市桥缇骑集，巷陌宝车行。\n柳上春多思，兰心雪有情。\n风光看更好，底事客愁生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2158,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵杨孟载感故园池阁 其一","author":"徐贲","text":"草阁开清晓，钩帘爽气通。\n绿蒲藏药裹，文荇縳诗筒。\n盥手才临涧，梳头得面风。\n此时应得暇，行绕碧梧桐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2159,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵杨孟载感故园池阁 其二","author":"徐贲","text":"草阁开清昼，官閒过客多。\n枕材便涧石，酒具给池荷。\n蕉长宜听雨，萍交不见波。\n此时晴烂熳，歌咏复如何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2160,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵杨孟载感故园池阁 其三","author":"徐贲","text":"草阁开清晚，凉生自有期。\n菊因风始护，竹待雨方移。\n妓进调成瑟，童收弈罢棋。\n此时杯酒里，明月是相知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2161,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵杨孟载感故园池阁 其四","author":"徐贲","text":"草阁开清夜，垂垂星斗零。\n水蒲藏白小，露草宿蜻蜓。\n文梓裁凭几，生绡画卧屏。\n此时凉似水，看子拾流萤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2162,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"独坐怀乡中友人","author":"徐贲","text":"独坐荒山暮，相亲是酒杯。\n人从乡里别，秋在客中来。\n倦鸟须臾去，幽花次第开。\n离心自多感，不为岁时催。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2163,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送曾伯滋赴西河将幕","author":"徐贲","text":"上将初分阃，儒官解习兵。\n风旗春猎野，雪帐夜归营。\n洮水从岷下，祈山入垄平。\n知公能载笔，草檄报边声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2164,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送朱知事","author":"徐贲","text":"惆怅官亭酒，如何送客频。\n水烟鱼市晚，花气野桥春。\n小骑行沙健，轻衫映柳新。\n尊前莫催别，明日异乡人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2165,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送人之吴江","author":"徐贲","text":"垂虹桥下路，此地隔江湖。\n沙树应多橘，寒鱼半是鲈。\n风将菱唱远，舟带夕阳孤。\n离别琴三叠，悲欢酒一壶。\n不堪忆君处，烟雨满秋芜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2166,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赋得石井赠虎丘蟾书记","author":"徐贲","text":"来款生公室，因寻陆羽泉。\n虚泓云液静，阴甃土花圆。\n竹引归香积，瓶分供法筵。\n虎跑晴见迹，龙伏暖浮涎。\n锡影孤亭日，茶香小灶烟。\n师心如定水，应悟赵州禅。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2167,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送张明府","author":"徐贲","text":"每喜论文久，那堪又送行。\n壶深淹别酒，歌短促离程。\n水驿孤临渡，寒山半隐城。\n潮生知海近，木落见秋清。\n明旦车尘下，应看父老迎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2168,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次高二季迪留别韵","author":"徐贲","text":"柴门村径带溪桥，来往因君岂惮遥。\n浅水不波仍漾漾，疏林无雨自潇潇。\n樯留夕照人将别，江作新寒酒易消。\n明日秋风重怅望，还将离思托归潮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2169,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送张山人还天平","author":"徐贲","text":"几欲求田负旧盟，羡君西崦草堂成。\n每缘种橘多开地，独为修琴始到城。\n黄叶已先霜降落，白云长在雨馀生。\n龙门林屋无多远，此去寻幽莫计程。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2170,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁未六月廿八夜作","author":"徐贲","text":"西风作雨又仍休，卧起园斋夜更幽。\n天黑露华凉不下，云疏河影淡还流。\n阴虫齐响浑忘夏，落叶频飘预报秋。\n乱后俄惊时节异，却将何计为消忧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2171,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵金子肃卜居","author":"徐贲","text":"君家茅屋去村西，地接河渠水上畦。\n黄菊遍生风掩户，绿萱新长雪消泥。\n酒香门客船中送，诗好邻僧院里题。\n谁道乱离无乐土，此乡还自有安栖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2172,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游张林山","author":"徐贲","text":"偶为寻花到竹西，两山云气接高低。\n午烟僧舍林塘窅，春野人家草树齐。\n水鹤晴时行麦垄，园蜂暖处识兰畦。\n自怜远地归来后，才是登临便感悽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2173,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"园隐图送方以常","author":"徐贲","text":"曾闻学圃成高隐，今日携书是宦游。\n隔屋尚通分溜笕，傍溪空觅看花舟。\n菘葵尽作邻僧供，芋栗还凭野老收。\n后夜月明江上梦，应随归鹤到林丘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2174,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登广州城楼","author":"徐贲","text":"五岭南来瘴海深，秋风榕叶尚阴阴。\n安期一去家遗舄，陆贾重来橐有金。\n门限虎头潮上下，城开雁翅客登临。\n清时不用频兴感，万里惟存向阙心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2175,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"记梦","author":"徐贲","text":"梦里绿阴幽草，画中春水人家。\n昨夜纱窗细雨，银灯独照梨花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2176,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨后慰池上芙蓉","author":"徐贲","text":"池上新晴偶独过，芙蓉寂寞照寒波。\n相看莫厌秋情薄，若在春风怨更多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2177,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"折花背立二美人图 其二","author":"徐贲","text":"绣罢春衫出阁迟，辛夷花下立多时。\n内园且是无人到，不省含羞怕见谁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2178,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答杨署令送菜","author":"徐贲","text":"隙地知君手自栽，绀芽红甲雨中开。\n閒居我亦清斋久，肯折新葵为送来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2179,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答高季迪酒醒闻雨 其二","author":"徐贲","text":"江郭多阴暑到迟，夜凉孤枕怯疏帷。\n听风听雨寻常惯，不似今朝醉醒时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2180,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"访柱上人","author":"徐贲","text":"经院深深久护烟，雨中药草午凉天。\n古香室里人重到，恰似秋风五日前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2181,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"折莲子呈孟载","author":"徐贲","text":"落尽红衣见绿房，折来犹带水云香。\n柔丝零落芳心苦，未及秋风已断肠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2182,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜卧闻邻家酒声呈季迪","author":"徐贲","text":"雨响槽床滴夜长，重门虽闭四邻香。\n近来不是忘醒酒，也学东家吏部郎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2183,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"同季迪宿丁至刚南轩","author":"徐贲","text":"疏树寒蕉绿绕池，夜凉雨到便先知。\n我家路远君家近，能不开怀在此时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2184,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"月明听胡琴","author":"徐贲","text":"檀板朱弦出砑声，停杯齐听月当楹。\n分明自是《凉州曲》，不解何人最有情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2185,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题倪云林竹 其一","author":"徐贲","text":"忆君我有泪淋漓，正似湘江雨后枝。\n记得秋声夜同听，消閒馆里对床时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2186,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题倪云林竹 其五","author":"徐贲","text":"倚窗昼寂自焚香，十日春阴不下堂。\n几度吟成微醉后，兴来拈笔写修篁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2187,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送吕管勾","author":"徐贲","text":"客情沙柳共依依，隔浦遥山向夕微。\n送别偶当花落后，伤心元不为春归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2188,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过南垞赴黄德让招","author":"徐贲","text":"风暗沙村晚渐平，相邀应得遂閒情。\n南塘水满人来少，疏雨寒波一舸行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2189,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晓发秀州","author":"徐贲","text":"路出双湖烟树东，舟行长是雨兼风。\n梦回重有离家恨，惆怅春寒此夜中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2190,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"扬州僧舍见花有感","author":"徐贲","text":"风递浓香到水涯，几株桃李映门斜。\n侯家园圃多荒废，不是僧房不见花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2191,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"居龙河寺怀高季迪 其一","author":"徐贲","text":"与君常办酒家钱，共结山盟与水缘。\n今夜重思旧游处，一龛閒坐佛灯前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2192,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"居龙河寺怀高季迪 其二","author":"徐贲","text":"竹下幽泉细细流，寺间人去暮烟愁。\n独怜千里来京客，肠断龙河寺里秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2193,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九月十七日闻雁寄董庄","author":"徐贲","text":"晚意秋阴两不分，渚芦沙竹护寒云。\n雁声客里谁先听，愁绝惟应我共君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2194,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送叶知县","author":"徐贲","text":"黄苇丹枫叶落时，水云漠漠雁来迟。\n秋风长是身为客，已自伤心况别离。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2195,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"神弦曲","author":"徐贲","text":"灵风飐旗日光黑，灯影半明斜照壁。\n湘筠飒飒泣惨悽，翠裙香带兰叶齐。\n跳梁绛鼠舞碧鸡，神鸦飞出寒烟啼。\n纸钱啸火高悬树，千轮万骑登天去。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2196,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寻春","author":"张羽","text":"朝来微雨罢，何处可寻春。\n冰散池容动，烟销柳意新。\n穿林听莺远，度陌问花频。\n但觉相逢处，情亲似故人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2197,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寻梅","author":"张羽","text":"策杖度林塘，幽寻犯晓霜。\n临池疑掩映，傍竹畏遮藏。\n款曲敲僧舍，徘徊绕苑墙。\n好携三弄笛，树底为催妆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2198,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"早春旅怀","author":"张羽","text":"远客归未得，东风冷尚严。\n烧痕山顶秃，春色柳眉尖。\n病久医方熟，贫深酒债添。\n浮生欲何以，朝暮为齑盐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2199,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄王隐君止仲次高季迪韵","author":"张羽","text":"春江念久违，独掩雨中扉。\n新水添渔网，初晴税茧衣。\n馔余怜笋嫩，酒熟惜花稀。\n在客偏相忆，韶光去若飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2200,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游虎丘","author":"张羽","text":"春入翠微深，春风吹客襟。\n相携木上座，来礼石观音。\n老树积古色，薄云生昼阴。\n林僧修茗供，默坐契禅心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2201,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杜宇","author":"张羽","text":"国亡知几代，啼血转声频。\n尔自无归处，何须苦劝人。\n烟深青嶂晓，花落故城春。\n任是心如铁，闻时亦怆神。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2202,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夏夜舟中","author":"张羽","text":"画舫暮来过，风传《子夜歌》。\n簟纹凉更净，荷气夕偏多。\n落月斜筝柱，流萤拂扇罗。\n此中无限意，其奈曙钟何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2203,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"凉夜","author":"张羽","text":"金气已呈秋，新凉入梦幽。\n闺人砧欲动，侍女扇将收。\n玉露清瑶簟，银河绕画楼。\n更怜今夜月，隐隐树西头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2204,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江晚旅怀","author":"张羽","text":"短长亭下景，引睇入吟哦。\n疏树立寒色，短烟行夕波。\n山空秋气老，江远客愁多。\n忽动匡庐兴，白云生薜萝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2205,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夜旅怀","author":"张羽","text":"命与时相厄，劳生空瘦形。\n苦吟诗有债，久病药无灵。\n夜雨和愁落，乡山入梦青。\n归心逐孤雁，飞过浙江亭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2206,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"池上","author":"张羽","text":"秋水转庭柯，临池晚兴多。\n禽闲栖缺岸，鱼戏动凉波。\n露浥将衰柳，风欹欲败荷。\n虽无江海思，咫尺得频过。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2207,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"约徐隐君幼文同隐吴兴","author":"张羽","text":"吴兴好山水，子我盍迁居。\n绕郭群峰列，回波一镜如。\n蚕余即宜稼，樵罢亦堪渔。\n结屋云林下，残年共读书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2208,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"耕樵轩题寄徐良夫","author":"张羽","text":"之子住铜坑，人传好事名。\n如何同甲子，翻遣昧平生。\n野岸风中钓，湖田雨后耕。\n秋天渐凉冷，或可赴前盟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2209,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送吕道士","author":"张羽","text":"石室无人住，归心似鹤轻。\n山君驱虎去，童子报丹成。\n玉窦凭龙守，芝田借雨耕。\n怀君明月夜，遥听《步虚》声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2210,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄吴有本","author":"张羽","text":"相思不可见，梦里却逢君。\n两地共明月，一方空碧云。\n江秋鸿背侣，山夜鹤离群。\n记得湖边寺，诗题醉后分。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2211,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"孙景翔幽居","author":"张羽","text":"厌踏软红尘，闲居江上村。\n养鱼宽凿沼，爱竹别移门。\n月色侵书幌，山光入酒樽。\n我惭行役扰，犹未卜田园。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2212,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送刘仲鼎归杭州","author":"张羽","text":"欲别又牵衣，伤心故旧稀。\n自怜为客久，不忍送君归。\n远岫明残雪，空江淡落晖。\n东风重回首，一雁背人飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2213,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"越上别范景文","author":"张羽","text":"君家难弟兄，当世结诗盟。\n五字关风雅，千年说姓名。\n远烟拖柳色，薄月泻滩声。\n又作耶溪别，何时话此情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2214,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"隐者山房","author":"张羽","text":"家住白云深，好山青对门。\n树肥花结子，土暖竹生孙。\n猿挂枯松折，牛行浅水浑。\n自云归隐后，懒与俗人言。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2215,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山阴晓发寄暨阳旧友","author":"张羽","text":"水涨官河远，西风去棹轻。\n四山犹暝色，万木尽秋声。\n村近闻鸡犬，天寒忆弟兄。\n故园归未得，漂泊若为情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2216,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"诗穷","author":"张羽","text":"道在何妨拙，身安一任贫。\n已知如意事，不逐苦吟人。\n瀑布空山月，梅花破屋春。\n奚囊有佳句，未肯寄朝绅。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2217,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客夜怀王英甫","author":"张羽","text":"半生江海上，犹未卜菟裘。\n今夜雁初过，他乡人正愁。\n青灯孤枕梦，黄叶一庭秋。\n何日寻归棹，山阴访子猷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2218,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"席上闻歌妓","author":"张羽","text":"艳色倾前席，高歌度远楹。\n羞多时掩面，娇重未成声。\n浅按红牙拍，轻和宝钿筝。\n周郎知误处，众里最多情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2219,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中答高彦敬","author":"张羽","text":"矮屋两三间，无荣梦自安。\n好山看不厌，终日坐忘餐。\n书就松根读，琴来石上弹。\n浮生闲是宝，何必望为官。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2220,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]