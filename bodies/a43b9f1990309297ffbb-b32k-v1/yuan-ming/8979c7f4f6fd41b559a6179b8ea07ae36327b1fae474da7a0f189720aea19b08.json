[{"title":"绝句六首 其六","author":"郭翼","text":"雨多二月连正月，草没南园与北园。\n一向无情花片片，百般如怨鸟言言。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1581,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题和袁子英四首 其四","author":"郭翼","text":"紫殿长杨满路尘，骊山荒草没麒麟。\n伶玄作传追飞燕，李白歌辞忤太真。\n舞袖夜虚金掌月，香囊魂坠紫丝茵。\n可怜倾国倾城曲，一度秋风一怆神。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1582,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄青龙瞿惠夫博士","author":"郭翼","text":"醉眠亭上追游日，为惜高情对物华。\n草港斗飞花鸭雨，竹沙深映白鹇罝。\n丛丛山影侵云直，一一人家落路斜。\n近报风流多著作，门生若个是侯芭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1583,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送卢公武应召北上","author":"郭翼","text":"前朝图史已全收，诏起丘园重纂修。\n一道同风遵礼乐，大书特笔法《春秋》。\n金壶墨泻朝挥洒，银烛花消夜校雠。\n进卷内廷承顾问，鹄袍端立殿西头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1584,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"城南草堂与顾仲瑛夜话","author":"郭翼","text":"花发草堂风雨春，青灯剪韭话情亲。\n乱离隔世今何夕，生死论交更几人。\n城郭是非华表鹤，蓬莱清浅海中尘。\n三千宾客冯驩在，莫怪伤歌舞剑频。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1585,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和顾子达见寄","author":"郭翼","text":"江上去年来避寇，无家归路转凄迷。\n桃花柳絮当三月，瘴雨蛮烟似五溪。\n直见荒台麋鹿走，可怜无树凤凰栖。\n读书支子桥边宅，瓦砾伤心暗蒺藜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1586,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"水阁书事寄郑明斋","author":"郭翼","text":"方桥匼匝小如亭，山色倾江滃滃青。\n雨里芭蕉怜画扇，花间鹦鹉惜金屏。\n谁传鸿宝中篇术，自写《黄庭外景经》。\n练水东头三十里，何人识得伍乔星。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1587,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟杜陵秋兴八首 其三","author":"郭翼","text":"海门八月雨清霜，可怪残雷未肯藏。\n虹蜺断江将雨映，鴐鹅背日与风翔。\n罗含自老黄花宅，裴度重来绿野堂。\n衰暮闭门怀故旧，岂因吹笛满山阳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1588,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟杜陵秋兴八首 其四","author":"郭翼","text":"巍巍北斗夜阑干，盛世无忧行路难。\n转粟帆樯辽海阔，舞阶干羽䝤夷安。\n黄河正道流应复，白月空江卧独看。\n愿借双飞珠树鹤，清游一接凤池翰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1589,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟杜陵秋兴八首 其六","author":"郭翼","text":"江上青山接甬东，离离禾黍馆娃宫。\n芙蓉旧苑长洲里，麋鹿荒台落照中。\n银海雁飞沉夜月，金茎露冷濯秋空。\n可怜萧瑟江关暮，词客哀吟思不穷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1590,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟杜陵秋兴八首 其八","author":"郭翼","text":"落日江南发棹歌，楚王宫庙郁嵯峨。\n雨经巫峡朝云湿，木落洞庭秋水多。\n璧月银河空复在，玉箫金管奈愁何。\n只今文藻悲迁客，何处波涛吊汨罗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1591,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桓王墓","author":"郭翼","text":"客行古城下，下有桓王墓。\n古城多秋草，牛羊下来暮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1592,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"湘弦曲","author":"郭翼","text":"竹啼非染露，山暝乃疑云。\n灵瑟传神语，休令帝子闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1593,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴九首 其一","author":"郭翼","text":"瞿卢袁陆思清警，要我题诗来鹤亭。\n月下吹笙看舞影，竹中移栅护霜翎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1594,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴九首 其二","author":"郭翼","text":"广平梅词吐清婉，惠连《雪赋》映婵娟。\n况有文章兼二美，吕家亭子得无传。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1595,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴九首 其三","author":"郭翼","text":"白云满地如白石，明月窥江来近人。\n最忆荥阳好兄弟，著霜柿叶写诗新。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1596,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴九首 其四","author":"郭翼","text":"淮泗大水断禾黍，闻道居人巢树头。\n汉武曾闻歌《瓠子》，老翁更儗赋《黄楼》。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1597,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴九首 其五","author":"郭翼","text":"城南市中有楚客，醉卧高楼看月生。\n两儿共扶不肯下，紫箫吹度到天明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1598,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴九首 其六","author":"郭翼","text":"侧闻朝家置史馆，须得班马出群材。\n揭公已老欧阳死，近者何堪为总裁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1599,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴九首 其七","author":"郭翼","text":"北山一士禅宗秀，烂漫交情只忆渠。\n每与王郎传诅楚，不同怀素学狂书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1600,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴九首 其八","author":"郭翼","text":"永嘉为儒有陈子，更思文雅得曹髯。\n麟趾凤毛不复见，龙文虎脊有谁兼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1601,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴九首 其九","author":"郭翼","text":"江上十月风日好，小桃欲开春可怜。\n绝胜龙沙三尺雪，雕弓射雁拂庐前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1602,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"廉夫自沧江过顾仲瑛桃源作诗以寄并柬玉山","author":"瞿智","text":"老铁仙人海上来，海云长日护楼台。\n玉箫彩凤时时下，黄鹤珠帘面面开。\n不逐蟾娥归月府，却冯华使过蓬莱。\n见说武陵重有约，一溪流水似天台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1603,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"简熊松云","author":"瞿智","text":"西冈无奈景纯何，陶写新诗日渐多。\n宜似兰苕飞翡翠，每嗟荆棘长铜驼。\n日曛山崦收黄雾，秋入江风动白波。\n复忆松云老文学，醉乘箫凤肯相过。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1604,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"追和龙洲先生登多景楼诗就题其墓","author":"郭翼","text":"黄鹤矶头风雨秋，中原一望使人愁。\n东江风雨一斗酒，大地山河百尺楼。\n群臣谁决和戎议，九庙犹衔误国羞。\n慷慨鲁连宁入海，凄凉王粲重登楼。\n荒冈四尺先生墓，再拜酬之双玉舟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1605,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题倪元镇春林远岫图四首 其三","author":"郯韶","text":"十日春寒早闭门，风风雨雨怕黄昏。\n小斋坐对黄金鸭，寂寞沈香火自温。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1606,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题倪元镇春林远岫图四首 其四","author":"郯韶","text":"春寒时节病头风，惆怅年华逝水同。\n世事总如春梦里，雨声浑在杏花中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1607,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题赵魏公画","author":"郯韶","text":"汉家宫阙画蒿莱，烟雨苍茫护石苔。\n惟有金河旧时雁，年年秋色过江来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1608,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"龙门山中即事","author":"郯韶","text":"雷雨过厓惊落湍，空林白昼忽生寒。\n阴阴草阁开尊坐，细细山云卷幔看。\n落日樵声经木末，青天鸟道挂檐端。\n亦知吏隐非吾事，直欲从兹赋《考槃》。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1609,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送丁彦祥入京兼呈危太朴应奉","author":"郯韶","text":"画角城头乌乱啼，客行秋日思凄凄。\n黄河一水青天上，□岭诸山大漠西。\n饮马窟深沙草浅，射雕风急暮云低。\n经时不见危供奉，想候都门踏雪泥。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1610,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄范叔豹","author":"郯韶","text":"江上霜寒木叶彫，忆君何处思迢迢。\n长年旅食同秋雁，故里风烟隔暮潮。\n甚欲寄书酬远别，绝怜把烛待清宵。\n双溪月色凉如水，谁采琼芳慰寂寥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1611,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵聂茂宣见贻就简陆伯渊","author":"郯韶","text":"扬雄宅里曾相识，甫里祠前会面时。\n白日过门应问字，青春别墅只围棋。\n隔溪水涨桃花屋，深巷鸡鸣桑树枝。\n甚欲相从二三子，篝灯细雨共谈诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1612,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虎丘","author":"郯韶","text":"春草青青绕阖庐，山深石径转崎岖。\n空闻落日腾金虎，无复三泉閟玉凫。\n陆羽井深春雨歇，生公石在白云孤。\n伤心莫问鱼肠剑，怨逐秋声上辘轳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1613,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过女儿浦","author":"郯韶","text":"浦口寒烟生白波，蘋花风急棹舟过。\n人家一路青山下，只有秋田落雁多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1614,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"倪元镇画","author":"郯韶","text":"玄馆夏初度，青林暑气中。\n开轩对流水，坐石待薰风。\n花落葛巾侧，鸟鸣山几空。\n经锄者谁子？\n散发奏丝桐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1615,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题胡廷晖画","author":"郯韶","text":"仙馆空青里，春船罨画中。\n鸥波千丈雪，渔笛一丝风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1616,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题倪元镇画二首 其一","author":"郯韶","text":"断霭生春树，微茫隔远汀。\n梁溪新月上，照见惠山青。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1617,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题倪元镇画二首 其二","author":"郯韶","text":"高江新水生，微月流云度。\n美人胡不知，相思隔春树。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1618,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送地理刘汉章","author":"郯韶","text":"刘也东瓯士，能探郭璞书。\n曰阴曰阳处，某水某丘余。\n坏隧飞金雁，阴房葬玉鱼。\n荒唐千古事，吾欲问何如。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1619,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"衡门书事二首 其一","author":"郯韶","text":"风雨衡茅深复深，朝来隐几独长吟。\n正怜静里耽诗癖，忽喜门前有足音。\n爨下焦桐弹《别鹤》，箧中茧纸写来禽。\n南山千古悠然意，惆怅何人识此心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1620,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"衡门书事二首 其二","author":"郯韶","text":"门巷青苔积雨深，林花落尽一莺吟。\n高情不鼓《南薰》调，长日只闻流水音。\n涧底青丝牵弱荇，窗前碧色护来禽。\n莫嫌身外求名远，自是幽居惬素心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1621,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题女真猎骑图二首 其一","author":"郯韶","text":"白草原头闻雁声，黄沙碛里马蹄轻。\n举头忽见边城月，倒著丝鞭不肯行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1622,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题女真猎骑图二首 其二","author":"郯韶","text":"塞上秋雁白雪飞，溅溅生血洒毛衣。\n日斜却过轮台下，争看红妆猎骑归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1623,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梧桐士女图","author":"郯韶","text":"厌厌微步出深宫，露湿红绡怯晚风。\n争信长门今夜月，肯分清影照梧桐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1624,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"望潮曲","author":"郯韶","text":"夕风吹白波，江树摇绿烟。\n行人望潮水，心与沧溟连。\n榑桑东来三万里，晓看浴日重渊底。\n乃知碧海与天通，只隔银河一丝水。\n美人住在东海头，身轻嫁与千户侯。\n频年转粟直沽口，樯头夜夜望牵牛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1625,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"娄东述怀寄示龙门上人玉山居士","author":"邾经","text":"寂寞娄东寺，经过岁暮时。\n后凋霜柏古，乱点石苔滋。\n方外尊吾友，龙门得老琦。\n十年今几遇，早岁故相知。\n震泽三江入，虹桥五色垂。\n水西春酒熟，花下晚尊移。\n联句应题竹，留餐更折葵。\n那知俱是客，各以业为师。\n莲社招呼费，茅堂出处卑。\n也驰支遁马，而向习家池。\n何物讥臣朔，如人舞怪逵。\n遂令兄弟急，岂但友生疑。\n落落情偏好，悠悠事莫期。\n参商天上路，萍梗海之涯。\n向忆身犹白，前修道不缁。\n君攀狮子座，我把桂花枝。\n吴子非无学，周胥亦有为。\n龙泉终再合，豹管未容窥。\n泥滑双扶屐，灯明共弈棋。\n笑言方款合，交谊更坚持。\n好客囊羞涩，捐人佩陆离。\n初筵俄列豆，屡舞竟扬觯。\n醉揖都轻别，醒吟每重思。\n优哉聊复尔，舍此欲何之。\n伐木鸣幽鸟，椷筒寄阿谁。\n玉山投美璞，珠水照摩尼。\n为说饶清事，从游尽白眉。\n载观名胜集，多是故人诗。\n自笑如张翰，何烦识项斯。\n江帆风去逆，林馆雨留迟。\n紫研玄香润，纹窗棐几宜。\n翔鸾开粉纸，直发引乌丝。\n燕坐书成癖，穷探字识奇。\n雄文《毛颖传》，小隶《武梁祠》。\n韩柳文章在，云龙上下随。\n两家才并立，千喙语难追。\n小子真狂简，前贤讵点嗤。\n百金宁取直，三绝且闻痴。\n漫与非神品，居然奉令仪。\n异时倾孔盖，八字读曹碑。\n回首高飞隼，行歌倒接䍦。\n剡溪归尽兴，泌水乐忘饥。\n野阁延疏广，韦编拾散遗。\n儒冠傲轩冕，农耒力菑畬。\n明月怀人远，长林鼓瑟悲。\n平常要久契，翻覆讶群儿。\n愿把平生意，毋求小有疵。\n矢心同白水，披腹献丹墀。\n把袂寒潮上，还家夜雪吹。\n上人逢顾恺，冯谢拙言词。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1626,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为张藻仲题高文璧画抱琴图","author":"邾经","text":"听鹤亭前春澹沱，宿雨犹含百花妥。\n已愁三月酒船空，宣也抱琴能觅我。\n为言来自青衣洞，载得官醪满书舸。\n青衣仙人期远游，紫鸾将车尚虚左。\n老夫久矣厌刍豢，从之欲乞丹砂颗。\n孰云仙佩不可攀，洞天芒芒云久锁。\n只缘酤禁日以迫，尔尊我罍视犹夥。\n便须秉烛夜相继，过此将无生酒祸。\n老夫自适无何乡，故不饮醇今亦颇。\n阮宣杖头每独挂，陶令纱巾不曾裹。\n三泖平分碧玉壶，九峰半落芙蓉朵。\n从人拍手笑醉翁，写入新图无不可。\n胡为高璧忘吾形，只画张宣遗么么。\n宣也亦复颀而瘠，画作修髯知则那。\n想当下笔天机精，梦蝶轩中盘礴裸。\n不画邻瓮吏部縳，不图醉锸刘伶荷。\n为写抱琴山水间，意者于吾犹未果。\n璧也山林同此情，自惜老夫身懒惰。\n宣乎岂是王门伶，聊复尘中客裾拖。\n朱弦清庙尔当荐，金马朝登夕青琐。\n百年礼乐崩且坏，谁其兴诸悲皃轲。\n钟期伯牙宁后遭，余子眼中螟与蠃。\n高君宿昔号酒狂，过肆相牵倾白堕。\n自经丧乱赖酒活，今则禁之何□裸。\n便携张生入山去，石上弹琴松下坐。\n松肪酿熟中山醪，商颜采芝当蔬蓏。\n生不我留呼酒查，望入云汉星侈哆。\n莫过牵牛谈世事，但恐笑人如鳖跛。\n吾嗟高君真不凡，游戏丹青出兵火。\n后天有约醉寻真，可能同鼓蓬莱柁。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1627,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"营海轩诗","author":"邾经","text":"兵后澄江失敝庐，何曾奏策似隋初。\n丈人旧忆河间渚，营海新题泖上居。\n翏渎山横遗战垒，松江水近足羹鱼。\n惯闻地与潮声转，时见龙将雨气嘘。\n槎路不通星是客，桑田频改日愁予。\n螺舟莫厌过从数，我亦羁穷欲著书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1628,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题唐伯刚贯月轩","author":"邾经","text":"使君文采歘翩翩，投檄归来志浩然。\n新构凤麟洲上屋，恰如书画米家船。\n干将破壁龙俱化，脉望飞空蠹亦仙。\n更试囊中五色笔，桂花香露洒银笺。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1629,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题络纬图","author":"邾经","text":"牵牛风露满篱根，淡月疏星夜未分。\n灯下有人抛锦字，机丝零乱不成文。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1630,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"方寸铁赠朱伯盛","author":"邾经","text":"朱君手持方寸铁，模印能工汉篆文。\n并剪分江龙喷月，昆刀切玉凤窥云。\n他年金马须承诏，此日雕虫试策勋。\n老我八分方漫写，诗成亦足张吾军。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1631,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"周玄初祈晴诗","author":"申屠衡","text":"寥阳之阙天皇居，百灵拱卫群真趋。\n羽人神游尻为舆，招摇御气凌空虚。\n九关洞启光县珠，绿章封奏人间书。\n吴田潦淫三月余，吴淞决防连具区。\n春苗荡溺无遗株，吴民业业忧为鱼。\n上天好生哀冥愚，羽人稽首帝曰俞。\n廓除霾曀开天衢，蛟龙伏藏黑蜧诛。\n有秋芃芃还土腴，人无菜色国有储。\n羽人有道神明俱，手持玄纲旋斗枢。\n紫云为舄丹霞裾，蓬莱清都随所如。\n琳宫载敞虞山隅，为予分驻飙轮车。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1632,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句","author":"申屠衡","text":"青锁春閒漏点迟，博山香煖翠烟微。\n隔帘谁撼金铃响，知是花间燕子归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1633,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵陈敬初答虞清二子雨中见寄绝句六首 其一","author":"钱逵","text":"白箓裁笺带玉纹，乌丝题字寄衡门。\n风床展玩论书法，何似颜公屋漏痕。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1634,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵陈敬初答虞清二子雨中见寄绝句六首 其二","author":"钱逵","text":"积雨孤村水满堤，杏花零乱落春泥。\n草堂近在桥东路，只借丹丘处士栖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1635,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵陈敬初答虞清二子雨中见寄绝句六首 其三","author":"钱逵","text":"喧喧春鸟报新晴，不遣春愁眼底生。\n拟约芙蓉洲上坐，暂分私地听蛙鸣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1636,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵陈敬初答虞清二子雨中见寄绝句六首 其四","author":"钱逵","text":"独立春江古岸基，风帆沙鸟总忘机。\n今朝闻有巢湖信，南陌东阡迟子归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1637,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵陈敬初答虞清二子雨中见寄绝句六首 其五","author":"钱逵","text":"村坞深如华子冈，东风花落涧泉香。\n故山猿鹤相望久，莫遣濡须草树荒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1638,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵陈敬初答虞清二子雨中见寄绝句六首 其六","author":"钱逵","text":"关河犹未息风尘，孤负春来绿草茵。\n莫报淮南近消息，题诗且慰白头人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1639,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]