[{"title":"次韵和王文明绝句漫兴十八首 其十六","author":"刘基","text":"一自江淮作战场，城池无处不金汤。\n辕门须识黄公略，莫与萧娘竞粉妆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8785,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和王文明绝句漫兴十八首 其十七","author":"刘基","text":"草庐不枉达官车，长日惟消满架书。\n睡足北窗清似木，数声残角起城乌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8786,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和王文明绝句漫兴十八首 其十八","author":"刘基","text":"故乡蛇豕满柴荆，异域风尘叹此生。\n至竟迂狂成濩落，可怜天地一浮萍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8787,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题美人书红叶图","author":"刘基","text":"红叶随波岂自由，綵毫空复写绸缪。\n无人解识诗中意，天上尘间总是愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8788,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送鲍生之闽中","author":"刘基","text":"青青芳草夹长堤，漠漠轻烟送马蹄。\n他日相思建溪上，棠梨花发鹒鸪啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8789,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题米氏小景二首 其一","author":"刘基","text":"陌上春风紫翠重，烟含汀树淡还浓。\n夜来水涨溪桥断，应是雷霆起蛰龙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8790,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题米氏小景二首 其二","author":"刘基","text":"春雾昏昏雨散丝，溪流拍岸小桥危。\n猿啼鸟叫山鬼出，正是行人肠断时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8791,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题安石蒲葵图","author":"刘基","text":"东山导骑出岩阿，能使枯蒲贵绮罗。\n却恨卞和无禄位，中宵抱玉泪成河。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8792,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题沧江独钓图","author":"刘基","text":"山绕沧江一钓船，又随斜日下长川。\n小鱼不食大鱼去，风定远林生白烟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8793,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题二乔图","author":"刘基","text":"江上桃花红粉腮，偶然吹入玉堂来。\n东风日暮和烟雨，多少飘零委绿苔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8794,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题小画","author":"刘基","text":"夕阳山下水鳞鳞，一叶轻舟钓白蘋。\n谩道江湖堪浪迹，荻花风雨更愁人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8795,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画莱戏呈石末公","author":"刘基","text":"列鼎羔羊厌腯肥，园官菜把莫嫌微。\n年来骑士工隳突，此物人间亦见稀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8796,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"汉世祖","author":"刘基","text":"白水龙飞绍赤精，鸱枭尽入太官羹。\n三驱只贷樊崇死，侯印应惭不义名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8797,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"凉夜","author":"刘基","text":"潇潇凉雨泻檐泷，聒聒鸣蛙似吠庞。\n惟有露萤怜寂寞，却将光景到书窗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8798,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公二绝 其一","author":"刘基","text":"橐里金多嫂自迎，壳中珠满蚌能明。\n文犀亦有通灵角，天上龙螭尽可撄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8799,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公二绝 其二","author":"刘基","text":"徒闻弹铗怨无鱼，未见兼程贡蜡书。\n四海□池总完璧，只今谁是蔺相如。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8800,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"白塔寺","author":"刘基","text":"物换星移事巳迷，从来此地惑东西。\n可怜如镜中天月，独照城乌夜夜啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8801,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题风中水仙花图","author":"刘基","text":"痴妒封家十八姨，不争好恶故相欺。\n沅湘日暮波涛起，翠荡瑶翻欲渡迟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8802,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句漫兴七首 其一","author":"刘基","text":"一岁三春好景光，纷纷红紫竞芬芳。\n芙蓉亦有倾城色，不见东风却拒霜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8803,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句漫兴七首 其二","author":"刘基","text":"风散萤光夜未分，隔窗凉雨落纷纷。\n秋衾不与还乡梦，征雁南来独自闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8804,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句漫兴七首 其三","author":"刘基","text":"碧瓦凉生月欲流，露蛩枫叶共啼秋。\n城乌半夜惊飞起，只为离人白尽头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8805,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句漫兴七首 其四","author":"刘基","text":"多事池边促织儿，声声哀怨旅魂知。\n干戈满地无机杼，长夜辛勤说与谁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8806,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句漫兴七首 其五","author":"刘基","text":"伐木丁丁谷响传，楩楠朴樕共成烟。\n扶桑不是人间树，因见沧溟变稻田。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8807,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句漫兴七首 其六","author":"刘基","text":"愁极每将歌当哭，归来不觉笑成狂。\n蓬山缥缈鲸鲵外，一夕相思九断肠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8808,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"忆昔二首 其一","author":"刘基","text":"忆昔上林花发时，黄蜂撩乱蝶参差。\n如今花落枯枝在，付与秋虫挂网丝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8809,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"忆昔二首 其二","author":"刘基","text":"忆昔扬州看月华，满城弦管满人家。\n可怜今夜中秋月，独照寒蛩泣细沙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8810,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"呼灯","author":"刘基","text":"溽暑蒸人百体柔，中宵挥汗想清秋。\n西风一夜吹庭树，惊起呼灯问敝裘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8811,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"磨石冈作","author":"刘基","text":"磨石冈头云湿衣，谢公墩上雨霏霏。\n西风忽捲残阳出，临水登山忘却归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8812,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜坐二首 其二","author":"刘基","text":"虫响莓苔叶响廊，月光如雪露如霜。\n铜壶管领催华发，一夜应添百刻长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8813,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送别","author":"刘基","text":"送别江头日欲沉，落湳风急鸟归林。\n秋云恰似人情薄，秋水还同客恨深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8814,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"栖乌","author":"刘基","text":"归雁将秋入楚天，薄云开月伴愁眠。\n露寒叶动栖乌起，一叫千声落枕边。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8815,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"羲和","author":"刘基","text":"断梗枯茎付野蒿，冷风凉雨剥征袍。\n羲和只在嵎夷宿，自是金乌未发毛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8816,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"纨扇","author":"刘基","text":"树头风露咽玄蝉，锦褥新张竹簟捐。\n纨扇团团霜雪色，好藏箧笥待明年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8817,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫成二首 其一","author":"刘基","text":"沉水香销金博山，月满楼台深夜寒。\n瑶琴弦绝不可弹，叶落乌啼寻梦难。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8818,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫成二首 其二","author":"刘基","text":"江水如天月如水，落叶萧萧夜风起。\n一寸愁心千万里，不见行人应未已。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8819,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"咏史 其二","author":"刘基","text":"天与聪明作大君，应天在实岂虚文。\n重瞳若解行仁义，不枉芒砀五色云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8820,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送金华何生还乡觐省 其一","author":"刘基","text":"金华山色翠亭亭，曾驻仙人白玉軿。\n羡汝结庐松柏里，卧看鸾鹤下青冥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8821,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送金华何生还乡觐省 其二","author":"刘基","text":"尚想高人何北山，谈经论道此山间。\n故家文物依然在，似汝须归玉笋班。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8822,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送金华何生还乡觐省 其三","author":"刘基","text":"漫漫东风吹绿蘩，行人江上发归轩。\n想应今夜春山月，华发萧萧正倚门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8823,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送金华何生还乡觐省 其五","author":"刘基","text":"送儿出去望儿归，看尽雏鸦弄夕晖。\n清晓开门儿却到，蟏蛸飞上老莱衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8824,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日杂兴 其一","author":"刘基","text":"采石矶头春水平，长干桥下暮潮生。\n谁能载酒寻芳草，杨柳堤边信马行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8825,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日杂兴 其二","author":"刘基","text":"过雨柔桑綟绶新，涵风细麦碧波匀。\n鸣鸠语燕声相应，又是人间一度春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8826,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日杂兴 其五","author":"刘基","text":"花竞娇娆草竞芳，纵横只是为春忙。\n夭桃秾李先飘落，不及蔷薇与海棠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8827,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题陈太初画扇 其一","author":"刘基","text":"一道沧江隔战尘，白蘋风起浪鳞鳞。\n新亭满眼神州泪，未识中流击楫人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8828,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题陈太初画扇 其三","author":"刘基","text":"水净沙明一叶船，钓丝牵月过长川。\n五湖何地宜生理，我欲从之问计然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8829,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"七月七日","author":"刘基","text":"百年佳会几今宵，脉脉相看一水遥。\n漫道天孙解专巧，却教鸟鹊为成桥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8830,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"即景 其一","author":"刘基","text":"江城五月冷脩脩，细雨微风拂面愁。\n汀蓼不知犹是夏，竞开丹粟满枝头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8831,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"即景 其二","author":"刘基","text":"薄寒轻雨细如丝，风满长川棹去迟。\n漠漠野田将瞑色，纤纤汀草欲青时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8832,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"御柳 其一","author":"刘基","text":"御柳青青阴绿池，迎春擢秀不违时。\n皇恩天地同生育，雨露无私尔最知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8833,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"御柳 其二","author":"刘基","text":"漫漫春风入舜韶，绿杨舒叶乳莺调。\n君王不为娱声色，无用辛勤学舞腰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8834,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"苕溪皇甫秀才幽居 其一","author":"刘基","text":"玄晏先生一草庐，万竿脩竹五事书。\n日高无客来惊梦，自谓公侯总不如。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8835,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"苕溪皇甫秀才幽居 其二","author":"刘基","text":"天目山前苕水流，野华啼鸟自春秋。\n沧浪清浊吾何预，坐听松风笑许由。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8836,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"遣兴","author":"刘基","text":"萋萋芳草掩重门，几树斜阳照断魂。\n坐爱微风起蘋末，月明檐铎语黄昏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8837,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花七绝句 其一","author":"刘基","text":"风林凋尽碧琅玕，的皪梅花好自看。\n霜白月明残雪夜，一枝危拂斗杓寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8838,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花七绝句 其二","author":"刘基","text":"群山积雪惨晴曦，石裂玄冰万木披。\n不是孤芳贞不挠，阳和争得上枯枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8839,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花七绝句 其三","author":"刘基","text":"紫府仙人萼绿华，暂抛琼苑到天涯。\n断魂应化为蝴蝶，夜夜归来阿母家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8840,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花七绝句 其四","author":"刘基","text":"稀疏寒玉小楼东，骨冷魂清五夜风。\n惟有翠禽怜寂寞，一双相倚月明中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8841,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花七绝句 其五","author":"刘基","text":"蕊宫仙子愧云鬟，姑射神人薄鍊颜。\n借问高标谁得似，白头苏武在天山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8842,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花七绝句 其六","author":"刘基","text":"琼跗玉叶两依依，摇落空山物色微。\n青女不知幽独意，忍寒犹自妒芳菲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8843,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花七绝句 其七","author":"刘基","text":"微阳稚绿未能还，四海昆虫总闲关。\n只有梅花见天意，先将春色到人间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8844,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪中三首 其一","author":"刘基","text":"灶下孤烟郁晓炊，檐前寒鸟啄枯篱。\n琼瑶满地无行迹，正是袁安独卧时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8845,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪中三首 其二","author":"刘基","text":"一夜雪深一尺馀，平明鸟雀噪阶除。\n移床漫向明窗下，图得清光好照书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8846,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪中三首 其三","author":"刘基","text":"漠漠随风结远埃，轻轻糁地集枯荄。\n春前有意呈三白，知是阳和次第来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8847,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪后遣兴","author":"刘基","text":"朝寒布谷应时鸣，起向回廊独自行。\n残雪未消檐影寂，满庭幽草看春生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8848,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句二首立春夜闻蛙鸣作 其一","author":"刘基","text":"鬼门竹管动轻灰，春色先从地底来。\n月落江城闻画角，五更残梦一时回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8849,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句二首立春夜闻蛙鸣作 其二","author":"刘基","text":"轻轻细雪点枯池，袅袅东风拂树枝。\n春到草根人未觉，夜来先有蛰蛙知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8850,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句九首 其一","author":"刘基","text":"异乡风景不知春，满地苍苔一病身。\n睡起无人问幽独，杜鹃声在绿杨津。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8851,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句九首 其二","author":"刘基","text":"花自飘零草自荣，何须惆怅独关情。\n高轩日永成危坐，隔水风来闻锻声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8852,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句九首 其三","author":"刘基","text":"雨馀烟柳约青丝，风过芹塘澹碧漪。\n正是愁来无著处，绿阴庭馆暮寒时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8853,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句九首 其四","author":"刘基","text":"一树秾华半夜风，平明枝上十分空。\n黄蜂紫蝶纷纷去，留得苍苔藉碎红。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8854,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句九首 其六","author":"刘基","text":"淮水东边旧六朝，琼楼翠馆白云销。\n于今只有垂杨柳，犹似当时舞细腰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8855,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句九首 其九","author":"刘基","text":"暖风吹帐日光迟，恰似清和四月时。\n黄鸟不知人懒起，未明啼上绿杨枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8856,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"半山寺二首 其一","author":"刘基","text":"王家废寺旧闻名，荆棘花开鸟自鸣。\n深夜狐狸穿破冢，佛灯争似鬼灯明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8857,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"半山寺二首 其二","author":"刘基","text":"妍邪变法事多端，气燄兴妖胆自寒。\n漫道謟谀堪媚佛，竟将佛作么人看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8858,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句漫兴十一首 其一","author":"刘基","text":"风光何故恼闲人，我欲乘槎一问津。\n满地绿阴迷断梦，五更啼鸟不胜春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8859,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]