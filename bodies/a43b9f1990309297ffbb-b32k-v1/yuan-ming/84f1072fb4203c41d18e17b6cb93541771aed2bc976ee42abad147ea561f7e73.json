[{"title":"二月江城见梅二首 其二","author":"叶颙","text":"桃杏纷纷正得时，疏梅高洁合知几。\n如何万卉娇春日，犹有孤芳驻夕晖。\n未要板桥寻蜡屐，最宜沙路试罗衣。\n轻鞋小扇孤山下，绝胜逋仙踏雪归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6267,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋斋雨后月出即事","author":"叶颙","text":"雨后虚堂清梦长，不堪风露袭荷裳。\n湿云散去山容瘦，新月飞来海气凉。\n丹桂生香秋兔老，青松舞影莫蛟翔。\n骚翁不管茅斋冷，满挹蟾光入酒觞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6268,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送李本存归江西新喻州本存儒学教授历省掾为御史所论改温州海隅巡尉赋三律赠之 其一","author":"叶颙","text":"又携书剑过江西，长铗三弹一振衣。\n风景不殊人自老，江山有异鹤空归。\n闲云仍旧封吟榻，流水依前护钓矶。\n去去乡关莫回顾，春风吹老故园薇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6269,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送李本存归江西新喻州本存儒学教授历省掾为御史所论改温州海隅巡尉赋三律赠之 其二","author":"叶颙","text":"献赋论兵计已疏，扁舟归去意何如。\n岂无医国三年艾，空读传家万卷书。\n处世固当同凤鸟，还乡端不为鲈鱼。\n故园泉石应无恙，依旧青山带月锄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6270,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送李本存归江西新喻州本存儒学教授历省掾为御史所论改温州海隅巡尉赋三律赠之 其三","author":"叶颙","text":"去就轻于出岭僧，烟包挑月一枝藤。\n十年湖海孤篷雨，万里关山半夜灯。\n后进衣冠皆有用，先生才调独无能。\n送君归洗征尘净，高步云岑顶上层。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6271,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日双溪晚归","author":"叶颙","text":"万顷晴波蘸夕晖，泠泠寒碧浸渔矶。\n水流不尽随云去，潮落无声带月归。\n桃岸春深红作阵，蓉峰烟暖翠成围。\n江山风景能如许，可是休文解赋诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6272,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀湖山隐者（并序）","author":"叶颙","text":"湖海无求放逸人，不将清梦出邱林。\n喜吹异代秋风笛，解鼓空山夜月琴。\n惊叹时危如有意，贪眠云暖又无心。\n迩来踪迹难寻觅，高卧岑峦万叠深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6273,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和李本存见寄和周府判感时遣怀韵二律 其一","author":"叶颙","text":"家山无恙尚如新，忍著征衫染世尘。\n功业谩弹三尺剑，琴书空老百年身。\n黄金散尽频添恨，白发闲梳政惨神。\n斯道未亡公论在，老翁未必久沈沦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6274,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和李本存见寄和周府判感时遣怀韵二律 其二","author":"叶颙","text":"世态纷更几度新，笑看马首没黄尘。\n幸无宠辱惊清梦，喜有林泉慰老身。\n雨后溪光尤潋滟，云舒山色越精神。\n年来深得归耕计，甘学愚蒙但隐沦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6275,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"述怀三首用前韵寄本存 其一","author":"叶颙","text":"照眼奇峰朵朵新，荷衣虽破喜无尘。\n莫嫌瓮牖难容膝，也胜儒冠解误身。\n好饮点头呼酒侣，不贪拍手骂钱神。\n山中清赏无穷尽，忘却高翔与下沦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6276,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"述怀三首用前韵寄本存 其二","author":"叶颙","text":"貌古何妨语笑新，宁忧勋业镜生尘。\n芙蓉露下三更月，葡卜风前七尺身。\n偶尔忘怀非造理，或然闭目独凝神。\n老身疏懒无迎送，高卧从人话隐沦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6277,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"述怀三首用前韵寄本存 其三","author":"叶颙","text":"乾坤清气四时新，独倚天风绝点尘。\n白酒最能开笑口，青山尽好著闲身。\n松根对弈棋无敌，柿叶题诗笔有神。\n幸有世间真乐在，贪夫何苦叹湮沦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6278,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谢姜明德学录见医膏肓痼疾二首 其一","author":"叶颙","text":"少年曾读活人书，壮岁能为死马医。\n学究岐黄惟我许，术参卢扁少人知。\n鼎中九转丹垂就，肘后千金世莫窥。\n旧有烟霞泉石痼，饮君一七顿成诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6279,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谢姜明德学录见医膏肓痼疾二首 其二","author":"叶颙","text":"偶然奇疢在膏肓，谢子慇勤数送方。\n岂但独除前日苦，更能顿歇晚年狂。\n云边丹杏香方美，世上黄粱梦正长。\n时事转艰吾鲜乐，取餐芝术访仙乡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6280,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次李本存宦游困滞韵","author":"叶颙","text":"天风吹落海门槎，一片归心未到家。\n空羡青衫萦紫绶，长惊白发岸乌纱。\n当年鸣凤曾栖竹，近日飞蝇遽集瓜。\n时世轻浮君已识，不须多笑子阳蛙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6281,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再次前韵二律喜其寄傲僧庐深得幽寂之趣 其一","author":"叶颙","text":"健理烟波钓月槎，困眠云屋野僧家。\n清谈自足酬玄旨，佳句仍堪罩碧纱。\n萧寺借栽陶令菊，祗园分种邵平瓜。\n翻经石上琴弹罢，最喜良宵两部蛙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6282,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再次前韵二律喜其寄傲僧庐深得幽寂之趣 其二","author":"叶颙","text":"少日心存汉使槎，老年诗到晚唐家。\n床前古鼎烹茶灶，头上凉巾漉酒纱。\n绕屋锄云多种竹，凿池分溜广浇瓜。\n空庭草色休频剪，留护阶除鼓吹蛙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6283,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"复次前韵述怀寄前人二首 其一","author":"叶颙","text":"匕尺长躯卧老槎，白云飞处是吾家。\n虚窗竹影侵琴榻，石鼎茶香袭帽纱。\n北阙无书难献策，东门有地易栽瓜。\n秋风半世空山梦，惊醒池塘月夜蛙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6284,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"复次前韵述怀寄前人二首 其二","author":"叶颙","text":"身似江湖不系槎，青山是处尽堪家。\n手挥云翰千番纸，鬓里霜髦一幅纱。\n时事固然轻土苴，吾年哀矣叹匏瓜。\n何当脱屣人间世，不杂喧哗井底蛙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6285,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟挽唐思仁","author":"叶颙","text":"芹老香寒泮水流，生平琴剑两悠悠。\n读书不辨黄金印，作记空登白玉楼。\n吟骨已随霜月冷，诗魂长伴莫云秋。\n悦斋文墨传家业，分付孙郎地下脩。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6286,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再次槎字韵述怀","author":"叶颙","text":"形容枯似饱霜槎，身老空山处士家。\n一径梅香云满地，半窗花影月笼纱。\n常穿谢氏登山屐，惯设孙郎饷客瓜。\n离乱固非畴昔比，池塘难得为官蛙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6287,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读金中孚诗","author":"叶颙","text":"珠玉篇章语不凡，宋唐佳句晋清谈。\n云分霞彩流银汉，月借波光下石潭。\n老鹤唳霜栖未稳，孤鸾对镜舞初酣。\n直从瘦岛推敲后，今度诗人数二三。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6288,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再次前韵（予与其父旧识诗中故及之）","author":"叶颙","text":"乃父仙游竟隔凡，不图老共阿戎谭。\n千年白璧沈沧海，一颗骊珠耀碧潭。\n群彦进趋心正渴，独君高卧睡方酣。\n幽怀亦笑狙狂者，唯数朝三与暮三。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6289,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"喜余仲杨陪枢掾俞公芳催兵海道岁晚远归","author":"叶颙","text":"羽檄催军岁晚归，海南消息定何如。\n腰边虽少封侯印，囊底应多荡寇书。\n越水闽山牵旧梦，蛮烟瘴雨袭轻车。\n短衣匹马男儿事，莫恋丘园月下锄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6290,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"王弘道下访别去十年矣至正戊戌迁浙东宪史相见如梦寐论心话旧不觉怃然赋二律见意云 其一","author":"叶颙","text":"白发相逢两故人，共谈时事欲沾襟。\n老来喜有归耕乐，乱后惭无济世心。\n常说文章非事业，深知书剑误冠簪。\n如今得似终南叟，万叠青山一曲琴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6291,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"王弘道下访别去十年矣至正戊戌迁浙东宪史相见如梦寐论心话旧不觉怃然赋二律见意云 其二","author":"叶颙","text":"诗酒分违各一天，相逢鬓雪笑垂肩。\n自惭衰貌非前日，犹喜清谈胜昔年。\n阅世只堪三叹耳，论心几欲一潸然。\n何时吟骑重来访，夜雨清灯对榻眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6292,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"弘道见和复次前韵 其一","author":"叶颙","text":"羡君诗格类唐人，胸次冰霜月一襟。\n句律老成前辈语，衣冠新样昔贤心。\n岂无青眼观良璞，争奈黄尘袭敝簪。\n早晚南山坐云石，邀君来听绝弦琴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6293,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"弘道见和复次前韵 其二","author":"叶颙","text":"自许馀生不问天，樵夫渔叟得齐肩。\n岂期鼙鼓轰天日，犹有篇诗慰暮年。\n白发满头惊老矣，黄金掷地喜铿然。\n袜才敢共元龙并，何但高楼上下眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6294,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再次前韵凡三叠 其一","author":"叶颙","text":"觌面依然旧日人，祗添尘土上衣襟。\n联床夜雨思前话，十载春风老壮心。\n松径任教云满袖，宦途莫遣雪盈簪。\n山家活计还知否，诗卷茶瓶夜月琴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6295,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再次前韵凡三叠 其二","author":"叶颙","text":"车马重逢喜二天，诗翁仍旧耸吟肩。\n风尘有恨彫双鬓，岁月无情老十年。\n纸上虚名俱梦尔，杯中真乐出天然。\n别来学得安心法，净扫青山枕石眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6296,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再次前韵凡三叠 其三","author":"叶颙","text":"虑远忧深感慨人，出奇筹策满胸襟。\n抑强扶弱平生志，激浊扬清旧日心。\n思向明时呈利器，肯随漓俗著尘簪。\n秋风异国无人夜，独鼓空山月下琴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6297,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再次前韵凡三叠 其四","author":"叶颙","text":"林泉深处不朝天，野服裁云补两肩。\n闭户读书频谢客，入山采药动逾年。\n松根长啸心清甚，石上豪吟兴浩然。\n尽日更无身外事，困寻芳草落花眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6298,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再次前韵凡三叠 其五","author":"叶颙","text":"江左风流绝代人，云裳兰佩更风襟。\n政多感物伤时恨，常负忧君为国心。\n三献无功羞抱璞，十年不调欲投簪。\n酒酣拔剑空长舞，谁识中郎爨下琴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6299,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再次前韵凡三叠 其六","author":"叶颙","text":"醉吹长笛夕阳天，醒拍希夷魏野肩。\n岩下烟霞常满地，世间荣宠不多年。\n采山钓水常随分，赏月吟风得自然。\n松顶日高三十丈，老猿犹抱白云眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6300,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"用前韵寄李本存二首 其一","author":"叶颙","text":"浮云常是蔽青天，黎庶何由担弛肩。\n乡社音尘空入梦，干戈休息果何年。\n石边清坐真闲者，世上狂图不坦然。\n安得中山千日酒，与君长醉日高眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6301,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"用前韵寄李本存二首 其二","author":"叶颙","text":"独怜湖海倦游人，忍泣牛衣泪洒襟。\n经史沈酣千载志，功名辜负半生心。\n空惊系肘黄金印，徒羡峨冠碧玉簪。\n何似麻衣破纱帽，石床云屋理瑶琴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6302,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"至正己丑端午日感怀寄辉东阳一诗至戊戌重午又十年矣王弘道见而和之其语句俊爽清健复次韵美之","author":"叶颙","text":"奇如霄汉舞天吴，壮似英雄敌万夫。\n锦绣心肠人未识，林泉胸次世应无。\n久空蕙帐秋猿怨，近宿芹堂夜鹤孤。\n况是东南重午节，湘江烟暝楚云疏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6303,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次李本存端午见寄韵二首 其一","author":"叶颙","text":"功名惊世久无图，泉石膏肓癖在吾。\n满眼干戈方烂漫，绕园兰艾亦荒芜。\n蒲觞未饮心先醉，松径长吟兴不孤。\n赖有故人知我意，肯同阮籍哭穷途。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6304,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次李本存端午见寄韵二首 其二","author":"叶颙","text":"独醒孤坐与谁同，懒把哀颜换酒容。\n素负岁寒齐桧柏，不将春色误芙蓉。\n堂堂阵美谁能犯，整整师严孰敢冲。\n万里白云风捲尽，蟾光飞上楚烟峰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6305,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再和前韵 其一","author":"叶颙","text":"天下关山入战图，异乡为客倍愁吾。\n江淮远近连烽火，里巷高低长草芜。\n坚卧谩愁兵甲满，独醒宁怕梦魂孤。\n太平气象犹如旧，痛饮蒲觞醉道途。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6306,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再和前韵 其二","author":"叶颙","text":"今年端午去年同，老去闲身转不容。\n几欲入山穿薜荔，常思浮海采芙蓉。\n伤时倍觉愁肠结，骂贼徒添怒发冲。\n何日果能忘世事，楚云湘雨小孤峰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6307,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"至正戊戌九日感怀赋 其一","author":"叶颙","text":"吴枫初冷水痕收，塞雁南飞渡远洲。\n岁月无情天地老，江山不尽古今愁。\n黄华谩引杯中物，白发空惊镜里秋。\n却笑桓温清宴后，终然无梦到神州。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6308,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"至正戊戌九日感怀赋 其二","author":"叶颙","text":"谩多忧思绕东篱，举目江山异昔时。\n落日边城悲鼓角，西风天地动旌旗。\n荒村乱后愁无酒，野老胸中喜有诗。\n风景不同人事别，菊花何必上寒枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6309,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"至正戊戌九日感怀赋 其三","author":"叶颙","text":"门掩东篱处士家，每逢佳节惜年华。\n黄花有恨惊秋老，白发无情对日斜。\n杜牧仙游诗寡和，王弘人去酒须赊。\n乌纱醉裹西风冷，千古令人忆孟嘉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6310,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"至正戊戌九日感怀赋 其四","author":"叶颙","text":"谁复携壶上翠微，干戈烂漫酒尊稀。\n西风细雨黄花瘦，衰草荒烟白雁飞。\n落日有时怀故国，旧居无主锁空扉。\n龙山回首尤非昔，长使英雄泪满衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6311,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"至正戊戌九日感怀赋 其五","author":"叶颙","text":"晚对南山饮浊醪，少舒幽愤醉醄醄。\n云边黄菊纫芳佩，世上红尘袭敝袍。\n陶令官闲身尚健，孟嘉帽落趣殊高。\n登临我亦秋风客，虚负人呼一世豪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6312,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"至正戊戌九日感怀赋 其六","author":"叶颙","text":"云锁当年落帽台，满山黄菊为谁开。\n久无异士高人识，长有狂蜂妒蝶猜。\n斜日东篱增感慨，西风南国正尘埃。\n如何得似承平旧，与客携壶共酒杯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6313,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"至正戊戌九日感怀赋 其七","author":"叶颙","text":"慵整东篱贳酒瓶，白衣望断夕阳亭。\n征鸿北度烟尘冷，战马南嘶草木腥。\n嫩菊半开香未老，奇峰相对眼终青。\n何当得与渊明约，共醉秋风不愿醒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6314,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"至正戊戌九日感怀赋 其八","author":"叶颙","text":"风急登高野客伤，悲笳声里过重阳。\n正须击剑论《孤愤》，何暇携壶举一觞。\n白骨不埋新战恨，黄花空发旧枝香。\n寒烟冷日东篱下，西望柴桑路更长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6315,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"至正戊戌九日感怀赋 其九","author":"叶颙","text":"悠悠江影雁南飞，黄菊飘香蝶满枝。\n斜日西风彭泽酒，殊方异国杜陵诗。\n烟峦惨澹山林暮，霜叶潇疏草木悲。\n醉后不思时节异，半欹乌帽任风吹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6316,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"至正戊戌九日感怀赋 其十","author":"叶颙","text":"满城风雨晚凄凄，城北城南尽战车。\n无药可能医世乱，有钱常欲买山居。\n床头小瓮开新酿，屋底明窗读古书。\n园菊岂知吾辈意，清香唯解绕茆庐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6317,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"时论田亩输银赋二律俾主事者知之 其一","author":"叶颙","text":"固守金汤动万全，使君才调亦堪怜。\n活人阴德谁能见，济物奇功已得专。\n广铸精金酬健者，泛科寒士岂当然。\n犒师劳将吾民职，争奈饥无买米钱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6318,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"时论田亩输银赋二律俾主事者知之 其二","author":"叶颙","text":"剑不潜锋岁未丰，带牛佩犊走西东。\n谁怜耕垦三时力，不直干戈一扫空。\n破屋饥人啼夜雨，荒村冤鬼哭秋风。\n有司科敛仍如旧，愿霁霆威略见容。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6319,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"军中一彦士少好读书喜谈论文章工拙尤笃意诗学求指南于仆为赋一律以赠之","author":"叶颙","text":"知公雅志喜文章，光燄须观万丈长。\n太傅辞华宜鉴别，翰林豪放不寻常。\n笔端妙语诚须识，马上奇功慎勿忘。\n正是英雄驰骋日，策勋麟阁姓名香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6320,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"草堂寺有怀东阳辉老","author":"叶颙","text":"萧寺荒凉绕翠屏，高僧无复定诗盟。\n雨侵深径苔花冷，风度浮云柳絮轻。\n岩下古碑遗旧迹，亭前流水诉新声。\n昔年高座谭经地，夜夜虚堂贮月明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6321,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"莫春游赤松 其一","author":"叶颙","text":"桃源春晚落花深，仙子乘鸾去莫寻。\n地僻惟闻猿啸月，岩空无复鹤听琴。\n云遮不断青山色，风送还来翠竹阴。\n欲上丹山访遗迹，灶寒烟冷碧苔侵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6322,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"莫春游赤松 其二","author":"叶颙","text":"牧羊人去杳无踪，欲访仙乡路不通。\n楼殿势穿云影里，笙箫尽断月明中。\n岚光点点流空翠，春色重重驻老红。\n日莫桃源重回首，夕阳香径锁春风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6323,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"庚子端午次潘明举韵二律 其一","author":"叶颙","text":"世乱飘零席未温，香蒲何暇荐芳尊。\n伤时倍觉孤难立，访旧空惊半不存。\n灿灿火榴明照眼，离离烟草暗销魂。\n赐衣恩宠承平旧，今日干戈未暇论。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6324,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]