[{"title":"都城暮春","author":"王冕","text":"绣房香幄紫驼车，队马连云拥醉娥。\n天上柳花随处衮，人间春色已无多。\n风流谩听《黄金缕》，慷慨谁知《白石歌》？\n江北江南叹愁绝，落红如雨打渔蓑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":457,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶书","author":"王冕","text":"圣主临朝问好官，岂无公论在长安？\n野人不入麒麟画，御史都簪獬豸冠。\n直北五更霜气重，江南三月雨声寒。\n绣衣骢马金陵道，谁把梅花仔细看？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":458,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶书二首 其一","author":"王冕","text":"浮云生远树，落日动江波。\n坐对青山好，其如白发何？\n寄诗凭问讯，沽酒借颜酡。\n忽忆平时节，吴淞听棹歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":459,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶书二首 其二","author":"王冕","text":"闻鸡何用舞，对酒且高歌。\n湖海情如故，风霜老奈何。\n相交知己少，入梦好山多。\n玩世能成癖，纷纷事已讹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":460,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶成","author":"王冕","text":"四月八日风雨歇，放翁宅前湖水高。\n典衣沽酒亦足醉，骑马看花徒尔劳。\n海国尚闻歌蔓草，山陵谁与荐樱桃？\n元龙本是无能者，后世谩称湖海豪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":461,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶成","author":"王冕","text":"桑田沧海事沈沈，慨慷谁能论古今？\n刖足卞和因献玉，然脐董卓岂无金？\n虽求知己终难合，差立功名错用心。\n老子胸中颇明白，只怜华发不胜簪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":462,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶成七首 其一","author":"王冕","text":"人言栗里是吾家，问信东皋事已讹。\n残岁都闻呼盗贼，良宵谁复望星河？\n门迎野水垂杨柳，屋枕云山带荔萝。\n沽酒陶情作閒梦，岂知冰冻合滹沱？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":463,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶成","author":"王冕","text":"青山绿水从人爱，野鹤孤云与我同。\n所适不须论丑好，相逢漫尔说英雄。\n乐游花木萧萧雨，梓泽亭台澹澹风。\n兴废故无今昔异，几回搔首月明中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":464,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶成","author":"王冕","text":"二月江亭野色明，杨花飞散雪盈盈。\n盐烟半入海气白，风雨忽来溪树鸣。\n离思厌听孤燕语，客情无奈乱山青。\n明朝又上长安道，却望咸阳旧帝京。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":465,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶成七首 其二","author":"王冕","text":"万里长山走蓟门，崭然天险中路分。\n高风吹雨作飞雪，老树积烟成冻云。\n武帐驻兵谈亚父，毡城无语及昭君。\n夜深谁渡桑乾水？\n呜咽笳声不忍闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":466,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶成七首 其三","author":"王冕","text":"山郭方迎五日春，飞飞风雪欲愁人。\n老年作客殊无策，适兴吟诗似有神。\n溪上梅花谁可共？\n天涯鸥鸟漫相亲。\n酒阑细看柴桑论，始觉桃源不避秦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":467,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶成七首 其四","author":"王冕","text":"云消巫峡蜀波来，天近崆峒北斗回。\n人事故于今日别，梅花却胜去年开。\n好游不负青春约，得意那愁白发催。\n行旅居家无异致，开怀且覆掌中杯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":468,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶成七首 其五","author":"王冕","text":"去年今日雨潇潇，今日天晴雪尚消。\n杖履谁来看花柳，江湖何处得渔樵？\n徒叨食饮居安土，未有功劳补圣朝。\n入夜遥遥瞻北斗，紫云团盖上青霄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":469,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶成七首 其六","author":"王冕","text":"玉漏无声落草庐，荒村遥夜石灯孤。\n开门探雪三尺许，举眼看山一寸无。\n谁闵将军穷窟穴？\n空多公子梦氍毹。\n老吾不作功名想，只欲扁舟泛五湖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":470,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶成七首 其七","author":"王冕","text":"出门无侣杖藜轻，溪上梅花相笑迎。\n独鹤远从天际下，老夫如在画中行。\n千峰日出流云气，万壑松鸣杂水声。\n巾袂不知苍翠重，看山直过越王城。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":471,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"基址","author":"王冕","text":"基址经年定，新亭几日成。\n望开吴地尽，坐接楚天平。\n野色重重见，山光面面迎。\n可宜方处士，千古纪清名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":472,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄友","author":"王冕","text":"窗外疏篁脱故枝，屋头松树已添围。\n水流荒涧花无影，云落空山雨似飞。\n别去几时多有梦，归来一笑竟忘机。\n怀君欲寄江南信，沙漠风高雁影移。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":473,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄友","author":"王冕","text":"寄语蓬莱客，山寒松未花。\n只因好春雨，不得到君家。\n白石通宵煮，青萍忘岁华。\n近来聋两耳，那得听胡笳？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":474,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄天台丁仲容","author":"王冕","text":"去年脚底生茧瘤，今年巾中华发稠。\n读书不敢略字过，得酒岂徒成醉休？\n关山杳杳绝飞鸟，江海凄凄无钓舟。\n好风良夜那可已，思君时复一登楼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":475,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄王秋泉","author":"王冕","text":"尺书不寄海天遥，两见春风换柳条。\n台阁竞瞻官济济，山林谁问鬓萧萧？\n月明故国人情别，花落江城客思饶。\n记得旧时携手处，酒酣曾过饮虹桥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":476,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄东邻唐彦常","author":"王冕","text":"桐木散阴邻屋壁，子居巷东我巷西。\n绣衣耀日轻拂袂，白马蹑云新凿蹄。\n湖上笑歌多载酒，夜来归去醉如泥。\n春风又别四十日，安得看山同杖藜？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":477,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄申屠佥事","author":"王冕","text":"潇洒樊山老，年来亦可怜。\n墨庄沉寇垒，琴屋烬烽烟。\n诗好人能颂，官清子得传。\n閒身随所寓，不必问归田。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":478,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄存道崔隐君","author":"王冕","text":"有怀中默默，舒啸独登楼。\n月色不知夜，江声欲动秋。\n寄书空惹恨，看剑若为羞。\n何日乘清兴？\n山阴棹雪舟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":479,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄吴道子","author":"王冕","text":"三月不见吴道子，十日两渡钱塘江。\n诗书压架自足乐，风月满坛谁敢降？\n菖蒲青青绕石壁，薜荔密密缘山窗。\n归来不道簿书急，漫对阿戎言老庞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":480,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄张贞居","author":"王冕","text":"句曲山人毛发古，苍精龙佩羽衣轻。\n道高不授中黄秩，天下皆传外史名。\n石菌云融丹气拥，玉壶春艳紫霞生。\n楼居又近林和靖，约我寻梅取次行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":481,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄李子粲","author":"王冕","text":"白头自笑潜夫拙，却忆风流李谪仙。\n对客每言齐物论，移家只有广文毡。\n赤鸡白狗看儿戏，绿水青山作画传。\n慷慨不愁春色老，笑看花雨落平田。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":482,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄陆高士","author":"王冕","text":"山阴道士久不见，无奈秋天风雨何。\n畴昔烧丹曾化鹤，近来书字不因鹅。\n黄花开到东篱下，白日何妨拄杖过。\n更约登高成浩饮，得诗还胜去年多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":483,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄恢长老","author":"王冕","text":"眼底纷纷涸辙鱼，道人遇地即安居。\n瓦盂香软雕胡饭，松几晴翻贝叶书。\n老到世情深脱略，年来生计亦萧疏。\n相逢休论当时事，我亦西郊结草庐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":484,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄徐仲几","author":"王冕","text":"僦得城楼枕卧龙，储无甔石是英雄。\n吟诗不愧杜工部，乞米或如颜鲁公。\n兰省异于霄汉上，草堂却在画图中。\n故人相见无多论，笑指松花落晚风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":485,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄题梅","author":"王冕","text":"山中昨夜雪三尺，窗前梅花参差开。\n卧看枝上月初满，梦到江南春已回。\n可笑阿娇伫金屋，却怜姑射下瑶台。\n故人知我有清兴，携取双鱼斗酒来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":486,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"悼止斋王先生二首 其一","author":"王冕","text":"休致归来与世违，平生所有未全施。\n胸中经纬天人识，舌底风雷宰相知。\n论道端然见周召，得时元不下皋夔。\n南金东箭谁堪拟？\n绿水青山尽可悲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":487,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"悼止斋王先生二首 其二","author":"王冕","text":"文采风流今已矣，夫何能见紫芝眉？\n中天气黯星河惨，南国春寒草木悲。\n政事堂堂传两省，论谈娓娓动诸司。\n老成如此多关系，青琐诸公泪亦垂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":488,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"悼止斋王先生","author":"王冕","text":"三月燕山听子规，追思令我泪垂垂。\n虽然事业能经世，可惜衣冠在此时。\n霜惨晴窗琴独冷，月明秋水剑双悲。\n山河万里人情别，回首春风说向谁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":489,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"悼王济川处士","author":"王冕","text":"上卿方驾紫云车，便寄江南处士诗。\n白发忽辞明镜去，青山相对好楼居。\n床头筇竹生鳞甲，窗下残篇扑蠹鱼。\n莫向九原嗟寂寞，诸郎才俊马相如。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":490,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"悼白云","author":"王冕","text":"浊世儒名多浪得，先生高隐冠当今。\n注书已发程朱蕴，讲道重明孔孟心。\n白日山林增气象，清风江海振希音。\n少微一陨天为黑，望入东南泪满襟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":491,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"悼达兼善平章","author":"王冕","text":"出师未捷身先死，忠义如公更不多。\n岂直文章惊宇宙，尚馀威武振山河。\n中原正想刘安世，南海空思马伏波。\n老我未能操史笔，怀思时复动哀歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":492,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"掩关","author":"王冕","text":"竟日掩柴门，翛然无俗尘。\n幽花殊得意，老树不知春。\n风月临清夜，江湖忆故人。\n西房老禅伯，潇洒亦吾贫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":493,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚眺二首 其二","author":"王冕","text":"云腾山欲重，雨过树如新。\n细路多行虎，荒村不见人。\n游丝悬落日，小草乱青春。\n何处论知己？\n过从白鸟亲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":494,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅竹轩为杨君道赋","author":"王冕","text":"湖上轩窗面面幽，山居正是御书楼。\n一枝晴雪连云白，三径清风似水流。\n且喜往来无俗客，只兹潇洒胜封侯。\n题诗已有林和靖，乘兴岂无王子猷？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":495,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"清明后日","author":"王冕","text":"旅游忽过清明节，百感中来与愿违。\n杨柳亭台春寂寂，杏花村落雨霏霏。\n青山对面人何在？\n白发倚门身未归。\n薄暮登高重惆怅，岂因萧飒故山薇？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":496,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绿水","author":"王冕","text":"绿水流洙泗，青山出鲁邹。\n凭高殊有兴，吊古不胜愁。\n日落江花重，风生野树秋。\n掀髯一长笑，不负壮年游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":497,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"船上","author":"王冕","text":"迢递三河路，凄凉九月天。\n远山迷草木，平野少人烟。\n对景情如醉，浮居日似年。\n壮怀消不得，沽酒且陶然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":498,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"隐居偶成","author":"王冕","text":"几日不见青山面，今日青山树色多。\n风花落水似濯锦，野鸟隔帘如唱歌。\n年老无成真可笑，世情不合奈之何！\n柴门本自无车马，昏晓时闻响玉轲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":499,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪后","author":"王冕","text":"今日登高不见山，乾坤混混太清寒。\n旧时月色无人识，新岁梅花正好看。\n多苦将军居塞北，更怜羁客在长安。\n老夫欲语不忍语，倚遍危楼十二阑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":500,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪晴","author":"王冕","text":"起来敲石火，正是雪晴时。\n竹叶冰垂地，梅花玉满枝。\n风云随变灭，山水转清奇。\n怅望长安道，令人有所思。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":501,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"黄牛山","author":"王冕","text":"招提万山底，古屋蔽烟霞。\n密竹先秋意，长藤过夏花。\n繁阴沈雨脚，清响漱云牙。\n老衲眉如雪，相逢话作家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":502,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"喜白发","author":"王冕","text":"眉间黄色未为奇，好是梳头满面丝。\n从古其谁能脱略，于今得此可愉怡。\n绝怜雪色照明镜，更喜霜花衬接䍦。\n万事为他最公道，老来镊白是儿痴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":503,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"渭河道中四首 其一","author":"王冕","text":"平地连沧海，孤城带渭河。\n行人俱汉语，舟子半吴歌。\n野草惊秋短，鲂鱼出水多。\n只怜乡国远，处处有胡笳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":504,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"渭河道中四首 其二","author":"王冕","text":"披雾青天近，梳头白发明。\n山河千古恨，风雨五更情。\n塞北浮云惨，关中王气清。\n草庐诸葛在，未得话平生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":505,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"渭河道中四首 其三","author":"王冕","text":"月出东溟白，天垂北斗低。\n砺兵思秣马，舞剑忽闻鸡。\n诸葛犹存汉，田横不辱齐。\n英雄如有见，琐稍岂能迷？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":506,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"渭河道中四首 其四","author":"王冕","text":"海气团云白，江风吹浪寒。\n飞鸿离塞远，独鹤唳更阑。\n慷慨论时事，羁栖笑楚冠。\n萧萧黄叶下，回首望长安。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":507,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"临江寺","author":"王冕","text":"山灵本是爱山农，况是登临重复重。\n海水浮来多怪石，云霄上接有高松。\n忘情浅浅溪中鸟，不雨深深洞底龙。\n带甲如今满天地，烟霞合此寄高踪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":508,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"湖上书所见","author":"王冕","text":"东南富贵是神仙，日日西湖坐画船。\n绣帽拥云笼翠羽，紫牙宣响出红莲。\n香风宛转珠帘动，纤手亲传玉鲙鲜。\n最是好情消不得，醉挪花片撒金钱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":509,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"湖上閒步","author":"王冕","text":"断云零乱雨初晴，古客游行眼倍明。\n可喜一湖杨柳色，不禁三月杜鹃声。\n青山历历添新寺，白塔亭亭枕旧京。\n回首东南重凄感，岂因兴废独关情？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":510,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登竺峰","author":"王冕","text":"健步攀缘上碧峰，方知绝顶路岐通。\n一生如在九霄上，万景都归两目中。\n老鹤独翻珠草露，孤猿啸落桂花风。\n青箱家世君休问，江左于今事不同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":511,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答王聘君二首 其一","author":"王冕","text":"门径萧条勘，相知得往来。\n人方恋升斗，我独抚尊罍。\n故国秋风惨，荒城暮雨开。\n閒中多乐意，不在最深杯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":512,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答王聘君二首 其二","author":"王冕","text":"平无无饮量，难与醉乡期。\n老委青云志，空听白纻辞。\n寒烟昏塞口，残月淡娥眉。\n此际天涯客，凄凉只自知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":513,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中答客问","author":"王冕","text":"人间尘土苦歊烦，林下清风六月寒。\n夜半酒醒方脱屐，日高眠起不簪冠。\n坐看游蚁巡危磴，静听閒花落古坛。\n老我自无轩冕意，寻常岂是傲时官。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":514,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答贾太初","author":"王冕","text":"知己相逢贫亦好，去家未久梦来多。\n读书万卷今何有？\n美酒数杯颜已酡。\n越上山移新得信，江南秋老漫奔波。\n故人割俸情何厚，白粲赤松从我过。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":515,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舜江楼","author":"王冕","text":"舜江楼上一徘徊，四面云山锦障开。\n于古岂徒贤二相，只今睍可致三台。\n月明鼓角空中起，风静波涛地底回。\n别驾清名动乡国，金鞍五马望重来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":516,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"遇昭瑞宫次韵二首 其一","author":"王冕","text":"红花翠竹满江皋，依约仙山驾巨鳌。\n月下每听来鹤佩，云中时复见龙袍。\n西江日薄潮声小，北极天开王气高。\n咫尺山河移版籍，书生徒尔说英豪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":517,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过昭瑞宫次韵","author":"王冕","text":"金屋无人玉殿开，青蒲埋没遍莓苔。\n旧愁隐隐随烟浪，新恨绵绵入草莱。\n红叶已随流水去，黄门空忆看花来。\n东南富贵消磨尽，留得荒村古将台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":518,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"愁重","author":"王冕","text":"慷慨添余思，交游忆可人。\n时危还有虑，愁重不知春。\n海国迷归棹，关山拥战尘。\n黄公何所见？\n终不事嬴秦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":519,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]