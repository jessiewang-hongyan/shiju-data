[{"title":"题谪仙像","author":"徐贲","text":"鼙鼓声来已乱离，锦袍脱却恨归迟。\n秋风江上长吟里，不唱清平古调词。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10600,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"采药","author":"徐贲","text":"香术新参叶长齐，雨时来斸破春畦。\n归来閒向泉头坐，洗净山中两足泥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10601,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题吕山人所藏马孝常周履道荆南唱和集后","author":"徐贲","text":"故友空悲生死异，名州曾托乱离频。\n因君重读荆南集，已忆溪山又忆人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10602,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送王守敬还淮南","author":"徐贲","text":"长淮路远思君久，得见还归更不堪。\n未尽平生山水兴，到家应是忆江南。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10603,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"中秋夜对月有咏 其一","author":"徐贲","text":"拟将诗酒赏良时，久不吟诗思苦迟。\n无酒已辜今夜月，如何容得更无诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10604,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"中秋夜对月有咏 其二","author":"徐贲","text":"吟诗无伴自无情，满院凉风月正明。\n毕境无诗空懊恼，只将身绕桂花行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10605,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"中秋夜对月有咏 其三","author":"徐贲","text":"几欲高眠畏夜寒，又思月色起来看。\n及来看月翻多感，不似眠时意少安。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10606,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"中秋夜对月有咏 其四","author":"徐贲","text":"云汉微明夕雨馀，行吟独自绕阶除。\n今宵若与常年比，月色人心总不如。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10607,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过王伯时宅","author":"徐贲","text":"里巷新翻乱后移，喜君住处有轩池。\n重来已是三年后，竹树依然似旧时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10608,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄高偶仲","author":"徐贲","text":"见说海虞峰畔住，禅房钟磬隔林闻。\n遥知潭影山光里，能解题诗独有君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10609,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日过宁真道观","author":"徐贲","text":"数丛黄菊遍亭皋，不见南山首重搔。\n日暮忽来真观坐，却从画里寄登高。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10610,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为开元道士题倪云林画","author":"徐贲","text":"闻说仙人去采真，山中草木几回春。\n开元堂上重来客，犹是当年问道人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10611,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"十一月一日始见菊花","author":"徐贲","text":"草草重阳去不知，今朝始见菊花枝。\n莫言篱落秋风老，但得来看未是迟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10612,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题杨补之十梅 其一 水","author":"徐贲","text":"缥缈仙姝粉黛妍，静临寒碧照婵娟。\n冰肌亦是鲛房种，不独凌波有洛仙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10613,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题杨补之十梅 其二 影","author":"徐贲","text":"瘦木成阴颤晚风，几随寒月上帘栊。\n横斜何处看偏好，只在清溪浅水中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10614,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题杨补之十梅 其三 嫩","author":"徐贲","text":"新花的皪更玲珑，学弄芳妍小涧中。\n冻蝶寒蜂谩相妒，今年才得试春风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10615,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题杨补之十梅 其四 雪","author":"徐贲","text":"六出争如五出嘉，天孙姑射斗矜夸。\n总然玉质都相似，若论生香合让花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10616,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题杨补之十梅 其五 烟","author":"徐贲","text":"酒熟山家梦里逢，美人别去月明中。\n醉遗绿带无人拾，吹上花梢飏晓风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10617,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题杨补之十梅 其六 野","author":"徐贲","text":"小店荒篱任意开，乱依丛棘半苍苔。\n春时料有何人折，多是匆匆驿使来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10618,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题杨补之十梅 其七 竹","author":"徐贲","text":"分得湘江数叶秋，偶因翠羽寄罗浮。\n相看莫说当年梦，二女多情自解愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10619,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题杨补之十梅 其八 落","author":"徐贲","text":"或随流水或随风，一片西飞一片东。\n何似得沾香额上，艳妆犹说寿阳宫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10620,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题杨补之十梅 其九 实","author":"徐贲","text":"青丸颗颗叶间藏，雨绽微酸刺齿香。\n爱护莫教风摆落，墙头留取掷裴郎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10621,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题倪云林竹 其二","author":"徐贲","text":"江乡处处忆陪游，见写湘云数叶秋。\n今日仙魂乘鹤去，犹存遗墨动人愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10622,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题倪云林竹 其三","author":"徐贲","text":"春江谁唱竹枝歌，春雨潇潇傍竹多。\n欲借淇园一竿玉，桃花矶下钓寒波。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10623,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题倪云林竹 其四","author":"徐贲","text":"出海琅玕翠色新，娟娟春雨洗芳尘。\n梦回影落虚窗月，却怪毫端写未真。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10624,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题倪云林竹 其六","author":"徐贲","text":"不见高人倪幼霞，流传遗墨尚清华。\n凤毛零落湘江水，春雨新梢整复斜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10625,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"云林画","author":"徐贲","text":"久约樵翁共结邻，青山如待早归人。\n屋西有个茅亭子，饱听松风起涧滨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10626,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"霅翁海棠","author":"徐贲","text":"一枝写出玉容娇，桃李漫山恨未消。\n惆怅东阑明月夜，半酣西子貌难描。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10627,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"将往吴兴徐行正以诗见送奉酬 其一","author":"徐贲","text":"自喜吟身得自由，长寻酒伴与诗俦。\n閒云流水平生意，何处山中不可留。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10628,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"将往吴兴徐行正以诗见送奉酬 其二","author":"徐贲","text":"春前便作访君期，春后才来信是迟。\n又复别君湖上去，重来应是绿阴时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10629,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谢吕山人殊长老送别江南","author":"徐贲","text":"我自东行君自回，清江小艇逐风开。\n今宵雪屋悬灯坐，还复临樽待我来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10630,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵别王止仲 其一","author":"徐贲","text":"一度看花一度春，东风又过楚江津。\n如何绿水桥头酒，不醉阳关曲里人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10631,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵别王止仲 其二","author":"徐贲","text":"风风雨雨暗消春，杨柳官桥夜掩津。\n不是子规啼欲倦，扁舟知有未归人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10632,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次蜀山别韩文学同杜校书记李逸人庄","author":"徐贲","text":"夕阳野渡人归后，山馆南风客到初。\n可恨同来不同去，烦君为寄故乡书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10633,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵张文学见招","author":"徐贲","text":"落叶柴扉昼不开，小笺相寄手亲裁。\n遥知着屐空山里，萝径孤琴候我来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10634,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送吕山人","author":"徐贲","text":"湖天浩浩白云秋，鸥鹭飞边有去舟。\n行到湖东回首处，春山记取是同游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10635,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送张甘白还吴北郭","author":"徐贲","text":"桃花飞尽柳花飞，三月江南尚腊衣。\n为问东湖云共宿，春风此度送人归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10636,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山斋图","author":"徐贲","text":"秋水柴门竹外开，阶前片石是琴台。\n山中几夜风连雨，明日还应借屐来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10637,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西爽楼图赠王主簿","author":"徐贲","text":"几度登临托远思，楼中山色意中诗。\n西风又复来看画，却忆扁舟送别时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10638,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"双溪僧舍闻莺","author":"徐贲","text":"绿阴到处有黄鹂，僧院山深客听迟。\n独恨春风轻易老，听时不及在花时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10639,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"紫菊","author":"徐贲","text":"一枝开向小篱东，浅白深红尽敛容。\n只有魏家颜色似，春风秋露不相从。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10640,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日报吴城诸友","author":"徐贲","text":"小屋林深曲涧幽，鸟情花思两悠悠。\n风光满眼春如许，那得君来此地游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10641,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"始闻新蝉","author":"徐贲","text":"芳草斜阳步绕池，孤蝉忽叫发高枝。\n去年忆在南山驿，千树南风乱噪时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10642,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"四月一日梦孟载自荥阳归觉后因寄","author":"徐贲","text":"昨宵两度梦君归，相见匆匆语亦稀。\n闻说归来秣陵住，未知此信是还非。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10643,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"端午日折榴花与允升幼女鸾鸾","author":"徐贲","text":"猩血丛丛簇绛裙，一枝雨里手亲分。\n自知老眼无烦照，乞与鸾鸾插鬓云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10644,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"病后行乐至池上","author":"徐贲","text":"连朝卧病少閒情，乍到池边任意行。\n未信空山人寂寞，绿阴何处不闻莺。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10645,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过南山","author":"徐贲","text":"乱峰幽石绕周回，竹阁萧然对涧开。\n不与青山有缘者，谁能著屐此中来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10646,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"允中留宿山斋已而复往令弟允升宅明日赋诗谢之","author":"徐贲","text":"别来怀抱事多因，草草尊前未易陈。\n既拟相留又还去，也终不似弟兄亲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10647,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题会仙图","author":"徐贲","text":"春风十二燕瑶台，曾与群仙一见来。\n别后空山流水里，不知几度碧桃开。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10648,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"泛南湖有咏","author":"徐贲","text":"沙树汀蒲绿雨新，湖波摇荡白鸥春。\n不须更觅桃源去，已是人间避世人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10649,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自南坞还蜀山途中有作","author":"徐贲","text":"行尽千山更有山，此身几日在山间。\n桃花野水溶溶去，鸥鸟汀云冉冉还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10650,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"空木","author":"徐贲","text":"老树依依涧水隈，荒岩春少只苍苔。\n不知过往山中客，谁为伤心吊赋来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10651,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过吴氏宅观梅","author":"徐贲","text":"荒园火后遍蒿莱，赖有梅花一树开。\n祗恐明朝零落尽，春风无复此中来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10652,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠惠上人","author":"徐贲","text":"高树空林日下迟，归云冉冉鸟差差。\n知师看尽閒风景，瑶席山中独坐时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10653,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题山果幽禽","author":"徐贲","text":"秋果垂垂压树低，一枝斜出覆荒溪。\n幸无童竖来樵摘，容得山中野鸟栖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10654,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"暮春","author":"徐贲","text":"楝花零落晓溪津，节物无情不恋人。\n二十四风看已尽，等閒觞酒过青春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10655,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题林下烧笋","author":"徐贲","text":"石火初敲竹下来，长镵手自斲荒苔。\n为收残箨烧新笋，更荐春泉茗一杯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10656,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中闻黄鹂","author":"徐贲","text":"高树重重覆酒台，黄鹂飞绕不惊猜。\n暖风晴日寻常到，谁为多情雨亦来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10657,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宿水西客馆呈二陈助教","author":"徐贲","text":"野性从前与世违，那堪习懒又多时。\n忽来郭里闻钟鼓，始信山中卧起迟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10658,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠明月因长老","author":"徐贲","text":"少留髭发伴苍颜，烂熳高情诗酒间。\n自是诸天欢喜像，世缘不尽未还山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10659,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"上菁山寻王张二山人不值","author":"徐贲","text":"此日寻君竟不逢，閒行直到最高峰。\n归时已是斜阳后，惆怅荒山寺里钟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10660,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄佺讲师","author":"徐贲","text":"荒村古寺无人到，独爱轩窗水次开。\n池上风光看不尽，莲香才过桂香来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10661,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"陈允中以病不赴约独还因赠","author":"徐贲","text":"远路知君抱病还，高才虽屈喜身閒。\n相寻正值重阳日，烂醉秋风九里山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10662,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中留别张静居","author":"徐贲","text":"访水寻云几日閒，君仍留此我先还。\n到家已是斜阳后，身在东湖却望山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10663,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山行","author":"徐贲","text":"千嶂松风百嶂云，春山行遍此寻君。\n林园花尽逢人少，赖有莺声到处闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10664,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过山中废寺","author":"徐贲","text":"一榻高悬绿嶂前，窗扉掩映碧萝烟。\n登临未免伤怀抱，閒与山僧说世缘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10665,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送赵乡之杭州","author":"徐贲","text":"何处歌声怨别离，夕阳亭上送君时。\n南风似为行人惜，欲使扁舟逆上迟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10666,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送张景则归天台","author":"徐贲","text":"浙江东去有名山，路绕天台雁宕间。\n我未得游空惆望，是君乡里喜君还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10667,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻雁寄郡城诸公","author":"徐贲","text":"风馀残烛伴离思，几度怀归谩作期。\n寂寞雁声山馆夜，故人谁念独听时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10668,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"三月廿三日重到蜀山","author":"徐贲","text":"屋已荒芜花自妍，重寻邻旧说兵前。\n此山多少人曾住，泉石应同我有缘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10669,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟中闻笛与张文学同赋","author":"徐贲","text":"何处渔汀晚棹回，笛声似为水云哀。\n相逢莫怪频垂泪，曾向梁园听曲来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10670,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无锡道中","author":"徐贲","text":"深林晴叶下风迟，山色迎人似有期。\n十四年前曾住此，湛公宅里钓泉时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10671,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"与丘克庄晚立瓜洲望京口诸山","author":"徐贲","text":"津头船发暮潮酣，楚水吴山思不堪。\n历问青山是何处，却从江北望江南。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10672,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闰七月十五夜作","author":"徐贲","text":"河带疏星淡不流，露华蛩响逼新秋。\n柝声才罢砧声起，总是忘情也自愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10673,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]