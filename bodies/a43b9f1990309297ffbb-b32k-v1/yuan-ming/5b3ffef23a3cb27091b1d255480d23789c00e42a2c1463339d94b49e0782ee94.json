[{"title":"小游仙 其十八","author":"杨维桢","text":"若木西来赤岸东，白金城阙碧珠宫。\n天家令急不敢住，折得五花归饭龙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3046,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"海乡竹枝歌 其一","author":"杨维桢","text":"潮来潮退白洋沙，白洋女儿把锄耙。\n苦海熬乾是何日？\n免得侬来爬雪沙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3047,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"海乡竹枝歌 其二","author":"杨维桢","text":"门前海坍到竹篱，阶前腥臊蟛子肥。\n孲?三岁未识父，郎在海东何日归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3048,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"海乡竹枝歌 其三","author":"杨维桢","text":"海头风吹杨白花，海头女儿《杨白歌》。\n杨花满头作盐舞，不与斤两添铜铊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3049,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"海乡竹枝歌 其四","author":"杨维桢","text":"颜面似墨双脚赪，当官脱裤受黄荆。\n生女宁当嫁盘瓠，誓莫近嫁东家亭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3050,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其一","author":"杨维桢","text":"晋师纳天王，大义白日披。\n尹固附孽子，奉籍奔蛮夷。\n道逢秋郊妇，三岁尔大期。\n三年尹固死，妇言如蓍龟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3051,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其二","author":"杨维桢","text":"出姜哭过市，呼天天实闻。\n市人皆涕下，鲁贼当谁分。\n出姜不归鲁，麟笔诛其君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3052,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其十","author":"杨维桢","text":"任安与田仁，同仕将军门。\n厮养恶齿马，实坐贫失身。\n发愤骑奴席，拔刃徒自分。\n不会赵少府，何时别奴群。\n乃知圣贤仕，端不与贱贫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3053,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其二十一","author":"杨维桢","text":"汝南许文休，丧乱一驽士。\n敢当诸葛拜，合受玄德鄙。\n士论推指南，无乃失臧否。\n乃知郡公曹，排摈有公是。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3054,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其二十五","author":"杨维桢","text":"我爱王怀祖，面壁售人骂。\n不比少掾时，瞋目荅米价。\n褊中顿有容，坦之讵能过。\n桓桓大将军，汉业在出胯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3055,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其三十八","author":"杨维桢","text":"姚家有裨将，腰佩双青萍。\n青萍夜脱匣，忽杀程务盈。\n为书报杀状，伏剑随自刑。\n吁嗟古义士，岂复数荆卿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3056,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其四十二","author":"杨维桢","text":"要离爇妻子，大盗空古名。\n峨峨南文山，光?日月青。\n妇义终一醮，臣道无改更。\n宁戴一天死，不载二地生。\n尚怜广西弟，有愧颜家兄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3057,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游虎丘与句曲张贞居遂昌郑明德毗陵倪元镇各追和东坡留题石壁诗韵","author":"杨维桢","text":"漾舟海涌西，坡陁缘素岭。\n陟彼阖闾丘，俯瞰千尺井。\n至今井中龙，上应星耿耿。\n居然辟历飞，残腥洗蛙黾。\n已知湛卢精，古愤裂幽矿。\n肯随鱼肠逆，寒锋助残猛。\n后来入郢功，勇志亦驰骋。\n丹台纳㛹娟，金锤碎骨鲠。\n坐令金精气，龙虎散俄顷。\n花凝铁壁坚，木根山骨冷。\n何哉幽独魂，白日歌夜永。\n我从陶朱来，青山异风景。\n岂无西家儿，池头弄风影。\n五湖尚浮桴，烟波不须请。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3058,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"元夕与妇饮","author":"杨维桢","text":"问夜夜何其？\n眷兹灯火夕。\n月出屋东头，照见琴与册。\n老妇纪节序，清夜罗酒席。\n右蛮舞袅袅，左琼歌昔昔。\n妇起劝我酒，寿我岁千百。\n仰唾天上蜍，誓作酒中魄。\n劝君饮此酒，呼月为酒客。\n妇言自可听，为之浮大白。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3059,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"玉莲曲为金陵张氏妓赋","author":"杨维桢","text":"芙蓉出五沃，荡漾水中央。\n托根遍七泽，濯影照沧浪。\n亭亭立淤泥，静试岳井妆。\n使君青雀舫，夜夜宿花傍。\n为结明珰盖，覆此并头芳。\n洛妃解瑶佩，王母荐琼觞。\n饥餐玲珑玉，渴饮醍醐浆。\n白日忽成晚，粉面落秋霜。\n窟䆛不结子，柔丝断藕肠。\n波寒沈獭伞，愁杀野鸳鸯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3060,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"素云引为玄霜公子赋","author":"杨维桢","text":"清河美人姑射神，梦中认得梨花云。\n朝朝暮暮不肯雨，璚枝玉叶光轮囷。\n靘妆不染胭脂水，轻歌欲遏鸾笙起。\n五花细马驮春风，罗带飘飖白鹇尾。\n柔情易逐綵霞空，半掩春衣嘶玉龙。\n九点峰前指归路，家住松陵东复东。\n桃叶桃根春已暮，又逐飞花度江去。\n梨园昨夜春雨多，回首孤飞在何处？\n何处孤飞去复来，直是玄霜百尺台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3061,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"四景宫词 其一","author":"杨维桢","text":"漏痕新长莲花斗，龙池草色连沟柳。\n忆春还又怯春来，日日春情殢如酒。\n小床偷制锦回文，落地针声暗惊手。\n梦绕梁三白蝶飞，西园鼓子花开后。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3062,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"四景宫词 其二","author":"杨维桢","text":"金刀落雪瓜如斗，小殿风来水杨柳。\n凤窠长簟不成眠，窃饮君王千日酒。\n传宣今夜吹玉笙，十指红蚕捻轻手。\n三十六竿调未齐，小倚琉璃御屏后。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3063,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"四景宫词 其三","author":"杨维桢","text":"露下金盘湿星斗，池上乌啼千尺柳。\n秋题未写桐叶笺，春妆尚带桃花酒。\n十二帘开乞巧楼，小队金针穿好手。\n长生殿里记恩私，夜半牵衣挂楼后。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3064,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"四景宫词 其四","author":"杨维桢","text":"黛螺新赐量成斗，画眉日画青青柳。\n长得君王一笑看，眠文不敢朝欣酒。\n盘珠夜制衮龙衣，红冰笋软呵纤手。\n坐听灯人报晓筹，二十五声寒点后。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3065,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"城西美人歌","author":"杨维桢","text":"长城嬉春春半强，杏花满城散馀香。\n城西美人恋春阳，引客五马青丝缰。\n美人有似真珠浆，和气解消冰炭肠。\n前朝丞相灵山堂，双双石郎立道傍。\n当时门前走犬马，今日丘垄登牛羊。\n美人兮美人，舞燕燕，歌莺莺，蜻蜓蛱蝶争飞扬。\n城东老人为我开锦障，金盘荐我生槟榔。\n美人兮美人，吹玉笛，弹红桑，为我再进黄金觞。\n旧时美人已黄土，莫惜秉烛添红妆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3066,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"金谷步障歌","author":"杨维桢","text":"金谷水派银河流，金谷峙据三神丘。\n太仆卿君十二楼，花草不识人间秋。\n蜀江染丝云五色，紫凤衔丝中夜织。\n剪断鲸涛三万匹，天女江妃不敢惜。\n明珠量斛买娥眉，时时玉笛障中吹。\n红鸾翠鹊飞在地，香尘蹋蹋凝流脂。\n野鹰西来歌吹歇，踏锦未收风雨裂。\n楼前甲士屯如云，楼上佳人坠如雪。\n于乎董家郿坞金成泥，鬼灯一点然空脐。\n齐州奴，何用尔，只须豆粥与萍齑。\n不见祇今金谷底，野花作障山禽啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3067,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"长洲曲","author":"杨维桢","text":"长洲水引东江潮，潮生暮暮还朝朝。\n只见潮头起郎柂，不见潮尾回郎桡。\n昨夜西溪买双鲤，恐有郎椷寄连理。\n金刀剖腹不忍食，尺素无凭脍还委。\n西溪之水到长洲，明日啼红临上头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3068,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"精卫操","author":"杨维桢","text":"水在海，石在山，海水不缩石不刊。\n衔石向海安，口血离离海同乾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3069,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"嬉春体四绝 其一","author":"杨维桢","text":"燕子冲帘过，胡蜂采蜜归。\n折花香露湿，不惜绣罗衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3070,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"嬉春体四绝 其二","author":"杨维桢","text":"水暖鸳鸳渡，风寒燕燕楼。\n桃根与桃叶，都在曲江头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3071,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"嬉春体四绝 其三","author":"杨维桢","text":"月过蔷薇架，雕鞍未到家。\n小娃犹殢酒，拦路夺人花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3072,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"嬉春体四绝 其四","author":"杨维桢","text":"花气不成雨，莺声都是春。\n戎装飞上马，疑是汉宫人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3073,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"湖上感事漫成四绝奉寄玉山 其一","author":"杨维桢","text":"湖水碧于天，湖云薄似烟。\n鸳鸯不惊乱，飞过岳坟前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3074,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"湖上感事漫成四绝奉寄玉山 其三","author":"杨维桢","text":"海峤浮西日，关梁转北风。\n苏郎书未返，愁绝雁来红。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3075,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"湖上感事漫成四绝奉寄玉山 其四","author":"杨维桢","text":"将石星空堕，灵山凤不飞。\n惟馀灞头水，西去复东归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3076,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"与客登望海楼作录寄玉山主人 其一","author":"杨维桢","text":"蜑子雨开江上台，江头野老不胜哀。\n蜃将楼阁空中落，鳅引旌旗月下来。\n保障许谁为尹铎，事谐无复问文开。\n可怜歌舞旧城阙，又是昆明几劫灰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3077,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"与客登望海楼作录寄玉山主人 其二","author":"杨维桢","text":"袅袅秋风起洞庭，银州宫阙眇空青。\n客星石落江龙动，神马潮来海雨腥。\n弱水无时通汉使，赭峰何事受秦刑。\n远人新到三韩国，中土文明聚五星。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3078,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"席上赋","author":"杨维桢","text":"萝洞兰烟绕烛微，三更三点妓成围。\n鱼吹绿酒常双跃，雁列瑶筝不独飞。\n隔座送阄喧中射，当筵呼掺促更衣。\n鸡鸣乐极翻悽断，阙月纤纤照影归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3079,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"悼李忠襄王","author":"杨维桢","text":"罗山进士著戎衣，泪落神州事已非。\n百二山河惊易改，三千君子誓同归。\n天戈已付唐裴度，客匕那知蜀费祎。\n赖有佳儿功业在，东人重望捷淮淝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3080,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"老客妇谣","author":"杨维桢","text":"老客妇，老客妇，行年七十又一九。\n少年嫁夫甚分明，夫死犹存旧箕帚。\n南山阿妹北山姨，劝我再嫁我力辞。\n涉江采莲，上山采蘼。\n采莲采蘼，可以疗饥。\n夜来道过娼门首，娼门萧然惊老丑。\n老丑自有能养身，万两黄金在纤手。\n上天织得云锦章，绣成愿补舜衣裳。\n舜衣裳，为妾佩，古意扬清光，辨妾不是邯郸娼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3081,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"不赴召有述","author":"杨维桢","text":"皇帝书征老秀才，秀才懒下读书台。\n子房本为韩仇出，诸葛应知汉祚开。\n太守枉于堂下拜，使臣空向日边回。\n老夫一管春秋笔，留向胸中取次裁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3082,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钟山诗","author":"杨维桢","text":"钟山千仞楚天西，玉柱曾经御笔题。\n云护金陵龙虎壮，月明珠树凤凰栖。\n气吞江海三山小，势压乾坤五岳低。\n愿效华封陈敬祝，万年圣寿与天齐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3083,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄宋景濂","author":"杨维桢","text":"一代春秋付托颛，龙门太史笔如椽。\n山河大统三分国，正朔中华一百年。\n麒麟阁上登雄将，龙虎榜中收大贤。\n试问阮公高隐传，谁填四十满中篇？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3084,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"上左丞相","author":"杨维桢","text":"玉帐牙床坐运筹，雄师到处瘴烟收。\n名传冀北三千里，威振山东四百州。\n铁马屯云江渚晓，楼船泛月海天秋。\n殷勤整顿乾坤了，召入金銮侍冕旒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3085,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟次秦淮河","author":"杨维桢","text":"舟泊秦淮近晚晴，遥观瑞气在金陵。\n九天日月开洪武，万国山河属大明。\n礼乐再兴龙虎地，衣冠重整凤凰城。\n莺花三月春如锦，兆姓歌谣贺太平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3086,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"上张太尉","author":"杨维桢","text":"上公柱国开藩府，露布朝驰拜冕旒。\n八阵风云闻羽扇，百年江汉见轻裘。\n鲸吹海雨来京口，雁带边声下石头。\n珍重晋公经济手，中兴天子复神州。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3087,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"回上张太尉（一云\"谢赐玳瑁笔见征楚国公碑文\"）","author":"杨维桢","text":"昨夜文星照南极，今朝客省过东维。\n锦囊颖脱千年兔，斑管光摇九尾龟。\n墨卷风云随王气，恩分雨露出天池。\n老夫来草平蛮策，先写新封楚国碑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3088,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄淮南省参谋","author":"杨维桢","text":"皇帝万年天统在，人臣八柱地轮回。\n西戎虎旅初传箭，南粤蛮王又筑台。\n斗上龙光红似电，海中蜃气黑成堆。\n白衣上客参谋议，画尽炉中铁箸灰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3089,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"新省呈右相及藩参诸公","author":"杨维桢","text":"大省新开方岳重，人间第二紫微垣。\n丹池凤浴江湖浅，温室花开雨露繁。\n天柱星辰高北极，海门日月远东藩。\n相君大业凭谁赋？\n白发词臣诏立言。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3090,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠王左丞二首 其一","author":"杨维桢","text":"卧云道人今左辖，当时出岫本无心。\n隆中豪杰征初起，江左苍生望正深。\n星斗一天环北极，山河万里贡南金。\n已闻艮岳无遗胤，况复淮淝有捷音。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3091,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠王左丞二首 其二","author":"杨维桢","text":"共说淮南王左相，开门下士日忘餐。\n入幕许谁延铁笛，备员寻客奉铜盘。\n长绦掣去饥鹰饱，故道归来老马寒。\n若问东维上书者，五湖今把钓鱼竿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3092,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"至正廿三年四月淮南王左相微行淞江步谒草玄阁夜移酒船宴阁所","author":"杨维桢","text":"微行谁识王丞相，草履过门如野人。\n太史遥遥瞻紫气，老夫急急裹乌巾。\n子陵故友终辞汉，张禄先生又入秦。\n休说五湖天样阔，扁舟何处不容身。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3093,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄苏昌龄","author":"杨维桢","text":"东吴主者尊师相，师相匡君近若何。\n紫极正宜扶日月，鸿沟未许割山河。\n金台百丈媒燕隗，盖禄千钟客孟轲。\n亦有阳秋成铁史，姓名不必到銮坡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3094,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送玉笥生往吴大府之聘兼简国宝枢相宾卿客省","author":"杨维桢","text":"近报淮吴张柱国，楼船遣使聘嘉宾。\n汉家自有无双士，赵客何劳十九人。\n天上琼花回后土，江南杜宇到天津。\n若逢吕相烦相问，应有奇书痛绝秦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3095,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"王左辖席上夜宴","author":"杨维桢","text":"银烛光残午夜过，凤笙龙管杂鸣鼍。\n佩符新赐连珠虎，觞令严行卷白波。\n南国遗音誇壮士，西蛮小队舞《天魔》。\n醉归不怕金吾禁，门外一声吹簸罗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3096,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赋拱北楼呈相君（杭州作）","author":"杨维桢","text":"伍子山头宋旧宫，龙楼改观倍蜚声。\n天连高柱星辰北，地控穷荒岛{山叙}东。\n凤引短箫悲落日，鹤归华表语秋风。\n玉龙一曲千宫晓，江汉朝宗万国同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3097,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄苏昌龄","author":"杨维桢","text":"雄文曾读平徐颂，光射磨厓百尺长。\n秦府有时容魏徵，韩仇何日报张良。\n青草瘴深鸢跕海，碧梧春老凤鸣阳。\n扬雄识字知何用，只合终身白发郎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3098,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送吕左辖还越","author":"杨维桢","text":"保障南藩第一功，未容若木挂雕弓。\n露书誓剪金床兔，壮气平吞黑槊公。\n万里天威龙虎北，五云佳气凤皇东。\n麦城又报捷书至，江上将军是吕蒙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3099,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"投来使","author":"杨维桢","text":"读书不负万乘君，焉敢挟策干侯门。\n极目姑苏暮云暗，濯足洞庭秋水浑。\n千金不意市骏骨，一饭岂期哀王孙。\n我今拂袖且归去，高卧桐江烟水村。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3100,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杵歌七首 其一","author":"杨维桢","text":"亟亟城城城亟成，小儿齐唱杵歌声。\n杵歌传作睢阳曲，中有哭声能陷城。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3101,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杵歌七首 其二","author":"杨维桢","text":"自古众心能作城，五方取土不须蒸。\n蒸土作城城可破，众心作城城可凭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3102,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杵歌七首 其三","author":"杨维桢","text":"叠叠石石石㠂嶆，立竿作表齐竿旄。\n阿谁造得云梯子，刬地过城百丈高。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3103,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杵歌七首 其四","author":"杨维桢","text":"罗城一百廿里长，东藩恃此作金汤。\n旧基更展三十里，莫剩西门一树樟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3104,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杵歌七首 其五","author":"杨维桢","text":"苏州刺史新令好，不用西山取石劳。\n拆得凤山杨琏塔，南城不日似云高。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3105,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杵歌七首 其六","author":"杨维桢","text":"南城不日似云高，城脚愁侵八月涛。\n射得潮头向西去，钱王铁箭泰山牢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3106,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]