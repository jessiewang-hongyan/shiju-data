[{"title":"东方有一士","author":"叶颙","text":"东方有一士，不结尘世缘。\n朝卧空山云，暮汲石涧泉。\n行吟夜月中，醉舞春风前。\n问之竟不答，一笑三千年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6135,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"凿井","author":"叶颙","text":"高原凿深井，水流深淙淙。\n三咽清肺腑，凛然冰雪容。\n云埋石甃冷，月照山泉空。\n汲引君勿辞，是中有神龙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6136,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"蜡梅","author":"叶颙","text":"春满紫绡裳，淡黄宫样妆。\n蔷薇露下色，山麝晚来香。\n月下开金盏，风前换玉裳。\n尚馀风骨在，疏影卧寒塘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6137,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读致和改元诏","author":"叶颙","text":"圣德如天大，皇风四海清。\n乾坤新岁月，丘壑旧心情。\n诏旨宣金口，臣僚拜玉京。\n江南遗叟说，垂老愿升平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6138,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀湖山灵隐朋独孤书记","author":"叶颙","text":"每忆湖山下，烟岚半有无。\n西风肥芋栗，细雨老菰蒲。\n世事秋云散，禅心夜月孤。\n轻包连瘦策，吾亦梦江湖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6139,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵送帅府李从道考满赴都","author":"叶颙","text":"山中忘岁月，世上变炎凉。\n竹帛虚名盛，松关野兴长。\n赠诗无好句，话别欠离觞。\n道过济南府，光辉衣锦乡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6140,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送天台僧雪中入杭","author":"叶颙","text":"杖策路迢迢，经年别石桥。\n厌听方广磬，去看浙江潮。\n雪透麻鞋冷，云和布衲挑。\n旧时清隐地，月落故山遥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6141,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"忆三衢徐志允","author":"叶颙","text":"磊落三衢士，身今在翰林。\n满斟徐邈酒，高诵杜陵吟。\n燕北身名重，江南感慨深。\n金銮坡上月，应照故人心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6142,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春夜游西园","author":"叶颙","text":"春色晚来浓，良宵兴未穷。\n海棠呈腻雪，杨柳舞香风。\n蝶梦翻花冷，蟾光度酒空。\n西园人未散，饮罢满城钟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6143,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"访赤松道士不值","author":"叶颙","text":"仙翁何处去，殿古白云深。\n丹灶留残火，青烟锁近林。\n尚遗羊化石，应误鹤听琴。\n旧日同游处，山空住夕阴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6144,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游赤松宫二首 其一","author":"叶颙","text":"杖履策天风，桃源路万重。\n草藏羊化石，云护鹤巢松。\n药化留丹井，莲开老翠峰。\n初平与初起，吾亦愿相从。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6145,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游赤松宫二首 其二","author":"叶颙","text":"神仙遗旧宅，地迥绝纤尘。\n丹井云封古，青山雨洗新。\n桃香岩洞雨，芝老石田青。\n近日来游者，多非避俗人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6146,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠修真羽士","author":"叶颙","text":"道人容貌古，缥缈隔烟扉。\n采药穿云去，寻真跨鹤归。\n久尝芝术味，惯著芰荷衣。\n拍手蓉峰顶，相招上翠微。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6147,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题刘阮遇仙图","author":"叶颙","text":"山中风景美，刘阮此忘家。\n犬吠寻真客，泉香出洞花。\n衣冠犹汉代，饮馔入胡麻。\n莫恋人间世，人间日易斜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6148,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠渔父","author":"叶颙","text":"短笛逐秋风，孤舟钓月中。\n绿蓑烟浪远，白发世情空。\n不让严陵操，宁贪范蠡功。\n江山无限好，蘋白蓼花红。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6149,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠牧童","author":"叶颙","text":"牛背夕阳红，行行逐断虹。\n烟迷青嶂雨，云度小溪风。\n短笛江村晚，长吟宇宙空。\n几回芳草岸，高卧月明中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6150,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春雨","author":"叶颙","text":"云罩千山暗，恩沾万物春。\n溶溶添细浪，点点湿芳尘。\n红洗花容净，青滋柳色新。\n东郊农事动，渐快一犁人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6151,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春晴","author":"叶颙","text":"晓洞云归湿，春山草木新。\n夭桃含宿雨，嫩柳袅轻尘。\n蝶翅寒犹怯，蜂衙晚渐陈。\n香风簇罗绮，已有踏青人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6152,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"池塘春草","author":"叶颙","text":"春色满寒漪，萋萋欲染衣。\n晚烟迷浅碧，斜日映清辉。\n灵运名空在，王孙去不归。\n一春无好句，诗梦近来稀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6153,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅边索句","author":"叶颙","text":"茅舍白云扉，巡栏笑撚髭。\n暗香覃雅思，疏影入新诗。\n江路东风冷，溪山落月时。\n苦吟吟未稳，清兴绕寒枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6154,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"落梅","author":"叶颙","text":"一夜东风急，南枝数片残。\n何人吹玉笛，独自倚朱阑。\n落地鱼鳞薄，寻香蝶梦寒。\n醉眠花树下，偏得寿阳欢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6155,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题丹丘图送周元善台州直学","author":"叶颙","text":"去去丹邱客，云山万叠深。\n吟鞭驱瘦马，倦仆负孤琴。\n芹水乡关梦，蓉峰故旧心。\n杏花明月下，莫忘寄遗音。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6156,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和王存诚游洞天","author":"叶颙","text":"昔我游洞天，意马得休止。\n平生尘土梦，尽向沧浪洗。\n回首名利场，十年不挂齿。\n去去青云端，褰衣访平起。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6157,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宿智者草堂","author":"叶颙","text":"夜宿蓉峰下，烟岚锁翠鬟。\n钟鸣黄叶寺，月上碧云关。\n老虎蹲危石，吟猿啼乱山。\n明朝出城市，清梦落尘寰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6158,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"智者寺僧往金陵","author":"叶颙","text":"闻子携瓶锡，孤舟至建康。\n遽辞娄约寺，遥礼宝公坊。\n松子僧前落，梅花客里香。\n莫同胡达磨，无语达梁王。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6159,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠宦游张平叔","author":"叶颙","text":"乾坤英气客，湖海倦游人。\n看镜始知老，见人宁话贫。\n功名惊壮志，琴剑误闲身。\n何日秋江上，清波洗宦尘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6160,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过栖碧何羽士旧隐","author":"叶颙","text":"泉石浑无恙，仙翁去不回。\n云深香木老，涧冷碧莲开。\n剑挂松关月，丹遗药灶灰。\n昔年修炼地，长误鹤飞来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6161,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"代居官寄友","author":"叶颙","text":"不信宦游拙，功名未有成。\n半生燕北老，十载越南征。\n每叹黄金尽，空惊白发生。\n何时灯火夜，相与话归耕。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6162,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"久客寄邻叟","author":"叶颙","text":"久客秋仍晚，烟霞锁敝庐。\n晴江思共钓，云岭忆同锄。\n贫贱交情薄，飘零酒盏疏。\n何当风雨夜，归读旧时书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6163,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"霜晨二首 其一","author":"叶颙","text":"残月过楼台，霜钟惊梦回。\n画开煨芋火，拨尽满炉灰。\n旋整云边屐，闲寻雪里梅。\n春风深有意，频送暗香来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6164,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"霜晨二首 其二","author":"叶颙","text":"琴榻对山城，僧钟半夜鸣。\n玉箫音调远，纸帐梦魂清。\n霜重蟾光冷，山空鹤影惊。\n南枝芳信动，春色正关情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6165,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"霜夜","author":"叶颙","text":"霜冷月交辉，春风暗透肌。\n襟怀添酝藉，胸次发新奇。\n斟酌酬佳景，推敲话旧诗。\n暗香生薄袂，疏影写枯枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6166,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"与客话湖山佳胜予足不至者四十年因赋此以叙旧事","author":"叶颙","text":"不踏湖山路，惊心四十秋。\n六桥前日梦，孤棹昔年游。\n岁月浮云改，兴亡逝水流。\n西风吴峤寺，落日浙江楼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6167,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽斋秋晚","author":"叶颙","text":"木落远山佳，荆吴接两淮。\n秋深红树岭，人老白云斋。\n竹色频侵袂，苔痕欲上鞋。\n宵深明月色，清爽透吟怀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6168,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山居即事","author":"叶颙","text":"吟榻障松屏，岩扉护竹亭。\n临风梳白发，对月读黄庭。\n涧古千寻碧，峰奇万叠青。\n弹琴坐云石，频惹鹤来听。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6169,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"围棋","author":"叶颙","text":"黑白未分时，其中一著奇。\n已空生死见，宁堕战争危。\n持重机常速，争先计或迟。\n捐微存大勇，勍敌尽吾归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6170,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"日暮江村杂兴二首 其一","author":"叶颙","text":"杖屦陟崇邱，丝纶钓浅洲。\n冲烟游野寺，玩月上溪楼。\n屡访云林鹤，闲盟沙路鸥。\n渔歌音调美，声撼半江秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6171,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"日暮江村杂兴二首 其二","author":"叶颙","text":"钓艇已收缗，无人深闭门。\n云生沙上石，月出水南村。\n寂寞寒潮远，微茫烟浪昏。\n孤舟中夜笛，感慨动吟魂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6172,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江村晚景","author":"叶颙","text":"华发映清流，江山事晚游。\n云舒江影净，霜落水痕收。\n雁阵新横浦，蟾光欲上楼。\n钟鸣枫树岭，秋老荻花洲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6173,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"孤舟夜泊（舟一作洲）","author":"叶颙","text":"烟棹越波东，渔歌逐断虹。\n云粘青树冷，潮驾翠涛空。\n梦醒孤舟月，情舒短笛风。\n曲终秋渐老，江阔暮山重。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6174,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"渔舟晚泊","author":"叶颙","text":"钓艇近黄昏，孤篷载夕曛。\n烟潮归柳港，凉月出蒲根。\n短笛云端弄，清讴夜半闻。\n渔灯明复灭，寂寞度前村。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6175,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山庄即事二首 其一","author":"叶颙","text":"倚槛看云飞，开帘放燕归。\n草生烟翠冷，花落晚红稀。\n对酒歌金缕，弹琴弄玉徽。\n醉醒深院月，芳影上荷衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6176,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山庄即事二首 其二","author":"叶颙","text":"策杖步松关，衔杯看远山。\n青鞋陪月出，翠袖裹云还。\n芳草斜阳外，落花流水间。\n山林多乐意，无梦到尘寰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6177,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春晚","author":"叶颙","text":"春去欲何归，江南古路岐。\n日长莺燕懒，花谢蝶蜂疑。\n香径红应减，高峰翠益奇。\n薰风琴调远，众绿上芳枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6178,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚窗","author":"叶颙","text":"红日转岩扉，幽人清梦迷。\n远游黄叶径，横过白云溪。\n芳兴随流去，高情与岭齐。\n庄周身外蝶，栩栩柏庭西。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6179,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山庄小隐","author":"叶颙","text":"茅屋小柴门，前峰烟树昏。\n夕阳芳草径，霁雨落花村。\n竹下安茶灶，山边置酒尊。\n吟翁常款曲，佳句细评论。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6180,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辛丑年乱后归故园","author":"叶颙","text":"乱后须兼白，春来草复青。\n水环垂钓石，云护读书亭。\n与客论孤愤，从人笑独醒。\n艰难思避世，贫贱欲忘形。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6181,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游山夜宿僧寺","author":"叶颙","text":"翠袖倚天风，云封路万重。\n屡登猿啸岭，频抚鹤巢松。\n渔唱孤舟曲，僧撞半夜钟。\n山空禅榻冷，月上碍星峰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6182,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江村晚景","author":"叶颙","text":"野水溪桥外，荒村八九家。\n雨晴渔网晒，风定酒旗斜。\n红树霜江叶，黄芦月岸花。\n何当从此隐，重整钓云槎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6183,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题溪翁隐居","author":"叶颙","text":"小径入云斜，幽居魏野家。\n庭轩环竹石，窗牖纳烟霞。\n户外经霜树，阶前浥露花。\n童沽村店酒，妇煮石炉茶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6184,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客至","author":"叶颙","text":"有客过山家，停骖暂脱车。\n旋呼徐邈酒，新煮玉川茶。\n命子开东阁，呼童扫落花。\n殷勤话畴昔，握手入烟霞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6185,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"疏斋睡醒","author":"叶颙","text":"石枕翠松屏，吟翁清梦醒。\n风前搔白发，月下读黄庭。\n枣熟从猿摘，琴弹唤鹤听。\n南山新齐雨，秀色入虚棂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6186,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江楼晚眺","author":"叶颙","text":"人倚白云楼，蟾陪翠浪游。\n天高峰影净，潮落水痕收。\n枫叶孤洲冷，芦花两岸秋。\n渔舟清唱晓，声断玉溪头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6187,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋色","author":"叶颙","text":"弄雨玉芙蓉，经霜苍翠松。\n池莲销艳质，岸柳作衰容。\n菊圃香方溢，蘋洲态更浓。\n芦花迷夜月，枫叶舞霜风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6188,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚兴","author":"叶颙","text":"谈笑策藜筇，丘园兴正浓。\n点书研竹露，煮茗听松风。\n吟咏诗怀爽，疏狂世虑空。\n古今兴废迹，斜日落霞中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6189,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"立春日","author":"叶颙","text":"欲写宜春事，先书饯腊篇。\n词华辉璧月，文彩丽晴烟。\n金燕寒欹鬓，泥牛晓试鞭。\n香风匝罗绮，语笑竞秋千。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6190,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂兴","author":"叶颙","text":"吟咏宴芳庭，荆扉昼不扃。\n溪光流坐席，岚影透窗棂。\n砌藓青粘屦，岗松翠列屏。\n夕阳江上路，曳杖定鸥盟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6191,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"正月上晴雪中赋","author":"叶颙","text":"天女美丰容，乘鸾过海东。\n清标光夺月，素质影翻风。\n柳絮情应远，梨花梦未终。\n鹤栖璚树冷，龙跃玉波空。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6192,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋日怀故人","author":"叶颙","text":"十年湖海别，归兴晚嵯峨。\n人远黄花瘦，秋深白发多。\n乡关愁隔绝，岁月苦消磨。\n对酒频相忆，凉蟾宵渡河。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6193,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽人杂兴二首 其一","author":"叶颙","text":"行乐兴怀浓，欢游酒盏空。\n久谙尘外趣，殊乏世间功。\n径竹题新绿，庭花扫落红。\n短筇歌霁月，长袖挹天风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6194,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽人杂兴二首 其二","author":"叶颙","text":"欢笑乐常彝，何曾浪皱眉。\n忘怀频唤酒，得意数吟诗。\n径草含烟软，庭花过雨奇。\n歌酣天宇阔，睡足夕阳迟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6195,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵项叔道见访","author":"叶颙","text":"青山茅屋下，谁肯顾寒微。\n贫贱论交寡，功名入梦稀。\n致身虽有术，临事要知几。\n异日天风顶，偕君试一飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6196,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次张县尉韵","author":"叶颙","text":"烟霞深处客，猿鹤惯同栖。\n坐久云横谷，吟残月满溪。\n不成尘世梦，宁为利名羁。\n醉脱荷衣卧，幽琴懒更携。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6197,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闲情二首 其一","author":"叶颙","text":"潇散两眉厖，疏狂似老庞。\n惯游裁菊圃，长坐读书窗。\n渔笛闲中弄，僧钟醉里撞。\n兴来陪夜月，孤艇钓寒江。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6198,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闲情二首 其二","author":"叶颙","text":"岁月任消磨，间中得趣多。\n戏题红叶字，醉唱紫芝歌。\n雨笠耕云岭，烟蓑钓月波。\n数鸿临浅浦，骑犊下前坡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6199,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽斋清兴二首 其一","author":"叶颙","text":"清兴正悠悠，偏欣汗漫游。\n乘闲登翠巘，独步访丹邱。\n惯著穿云屐，频撑钓月舟。\n高情方浩荡，更上碍星楼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6200,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽斋清兴二首 其二","author":"叶颙","text":"岚光浮户牖，竹色上栏干。\n吹笛惊秋老，弹琴生夜寒。\n唤猿来月下，放鹤出云端。\n长负江湖兴，西风一钓竿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6201,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]