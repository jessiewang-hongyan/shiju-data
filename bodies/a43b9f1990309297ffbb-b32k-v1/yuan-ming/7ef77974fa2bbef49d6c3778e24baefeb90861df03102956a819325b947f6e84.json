[{"title":"题徐士振蜀路看梅卷","author":"蓝仁","text":"綵服曾游锦水滨，见梅如见故乡亲。\n当时鼓棹难为别，此日挥毫欲写真。\n万里蜀山频入梦，一枝春色远随人。\n欧阳翰墨名当代，赠尔寒梢数萼新。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9684,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠汪亦雪","author":"蓝仁","text":"三年无处问平安，一日相过异地还。\n自说暂离人鲊瓮，也知生出鬼门关。\n园林但有中宵梦，尘土都非壮士颜。\n祇恐龙泉埋古狱，夜深紫气斗牛间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9685,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠叶彦新","author":"蓝仁","text":"石林居士日相亲，温雅如君复几人。\n脱却时名栖寂寞，吟成诗句转清新。\n清溪九曲宜垂钓，茅屋三间可卜邻。\n我亦平生忧世者，近来双鬓白如银。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9686,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠吴彦敬","author":"蓝仁","text":"卜居何论买山钱，喜有南邻二仲贤。\n门径新开疏种竹，池塘分断半栽莲。\n客来酒缶墙头过，儿学书签架上悬。\n况是世交同继业，林间猿鹤倍欣然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9687,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠张兼善","author":"蓝仁","text":"赠人相识自平川，乂会松轩炙石泉。\n惆怅望云怀故旧，周流观世避英贤。\n河图拟究成书际，羲易应参未画前。\n颇讶华山陈处士，白云深处至今眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9688,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠欧阳亦雪","author":"蓝仁","text":"欧阳处士有行窝，束担琴书处处过。\n肘后药分丹火秘，雪中梅放墨花多。\n老来怀抱思倾写，病起筋骸费按摩。\n闻与赤松黄石伴，楼居此日意如何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9689,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠西山本淳","author":"蓝仁","text":"先代诛茆傍翠岑，他山猿鹤也投林。\n药苗散漫冬无雪，桂树团栾月有阴。\n高枕白云同静境，挥弦流水入清音。\n酒仙唯数张颠健，酿得流霞每共斟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9690,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠叶宗善兼复婴","author":"蓝仁","text":"武夷宫里叶高士，方外同游独老成。\n秘诀隐文参古学，清辞丽句负时名。\n餐霞直上阳崖远，采药归来夜月明。\n久别邻庵余复古，西风鹤背许相迎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9691,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再赠西山本淳","author":"蓝仁","text":"穴处巢居避市廛，南山构架白云巅。\n风高茆苇三重掩，涧险藤萝百尺牵。\n旦食有狙分芧地，春耕无犊废芝田。\n野人不但贫输力，甲首敲门横索钱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9692,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赓张宗翰舟过武夷述怀 其一","author":"蓝仁","text":"丹霞白鹤洞仙宫，绝顶当年避地同。\n春雨矶头忧巨浸，夕阳林下眩残虹。\n先几自合乘槎去，投老方惊堕甑空。\n九曲棹歌期再听，寄声鸥鹭少从容。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9693,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赓张宗翰舟过武夷述怀 其二","author":"蓝仁","text":"荒榛满目故儒宫，忆昔风雩乐趣同。\n年代已随川上水，文光无复斗间虹。\n黄埃赤日遮平地，高石层阴起半空。\n昨暮维舟西渡口，濯缨犹胜抗尘容。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9694,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"甲寅仲冬予摄官星渚本邑判簿李公以催租入山忽游武夷予命小舟追之不及是夕宿常庵溪风山月一时清兴王事靡盬明日即附舟逆流而上因忆曩时与石堂卢使君同游放怀山水一觞一咏其乐不可复也援笔书怀遂成唐律二首 其一","author":"蓝仁","text":"休日相期上翠微，出门颇觉事多违。\n小舟送酒来何及，独骑看山去又归。\n山月抱琴寻涧水，天风倚杖叩岩扉。\n烟霞一榻无人共，梦绕瑶台跨鹤飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9695,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"甲寅仲冬予摄官星渚本邑判簿李公以催租入山忽游武夷予命小舟追之不及是夕宿常庵溪风山月一时清兴王事靡盬明日即附舟逆流而上因忆曩时与石堂卢使君同游放怀山水一觞一咏其乐不可复也援笔书怀遂成唐律二首 其二","author":"蓝仁","text":"清溪九曲逐真游，已觉云山笑白头。\n缓辔未能随后骑，叩舷聊欲借前舟。\n先朝故老偏相忆，此日虚名不自由。\n从事独贤何足问，烟波惭愧旧盟鸥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9696,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次刘彦炳武夷见寄","author":"蓝仁","text":"故人十载别平川，清梦时时共钓船。\n采药重来俱白发，听猿有恨落苍烟。\n山头扫月还相待，水底看松似倒悬。\n竹洞云岩秋老尽，晚晴犹喜两峰连。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9697,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次丁郎中游武夷韵","author":"蓝仁","text":"九曲清游兴不穷，舟人指点看仙踪。\n云开钓艇横丹壑，月落鸣机在碧峰。\n道士金丹谁化鹤，仙人铁笛莫惊龙。\n明朝匹马寻征路，回首东南紫翠重。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9698,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赓冯老泉","author":"蓝仁","text":"山中久住岂无情，偶为寻诗出谷行。\n岁宴龙蛇当伏蛰，春和观鹤自翔鸣。\n眼空江海栖栖老，兴近烟霞往往清。\n林杰后来俱特达，侯门弹铗旧知名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9699,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题沿山王那海千户澄清亭","author":"蓝仁","text":"绮户朱疏面面遥，不知城郭有尘嚣。\n石岩云气何萧爽，池水天光共泬寥。\n杨柳梧桐分处处，鸳鸯滩鶒并朝朝。\n杜陵也有南塘兴，题向将军第五桥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9700,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送陈子敬归三山","author":"蓝仁","text":"石头城下住经年，乡路重寻谷口田。\n千里客愁淮水上，三山归兴海云边。\n故园松菊陶潜宅，旧日才名郑老毡。\n舟泊武夷思仰止，棹歌遗响堕空烟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9701,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"松菊轩杂咏后再赋假山一律","author":"蓝仁","text":"儿曹暂得应门閒，叠石分泉作小山。\n碧草只疑行处尽，白云如在望中还。\n四时花竹多生意，一日尘埃亦强颜。\n昨暮得书猿鹤侣，种来桂树已胜攀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9702,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题清源游仙图","author":"蓝仁","text":"海上神山只远闻，图中真景识清源。\n云开秋色连蓬岛，雨过春阴散石门。\n应有仙人骑出虎，定无逋客恨啼猿。\n人间岁月头空白，安得流霞共一尊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9703,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题方方壶风云高仙图","author":"蓝仁","text":"仙人来往驭飙车，岂料遗踪入画图。\n林下曾逢骑一虎，云间常想度双凫。\n千峰夜月箫声远，万里晴天剑影孤。\n未遂沧州瑶草愿，梦随飞佩过方壶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9704,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和云松过鹤田有感","author":"蓝仁","text":"清溪松竹故人居，门掩东风寂寞馀。\n一束生刍将老泪，数编残稿访遗书。\n丘坟已卜山林近，堂构仍闻岁月虚。\n回首平川应不远，棹歌微响复如初。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9705,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题海好问西湖霜月轩","author":"蓝仁","text":"华轩南敞对湖船，有客弦歌夜不眠。\n枫落吴江霜正肃，潮生沧海月初圆。\n自吟肺腑寒光入，欲赴襟期爽气连。\n门外梅花凡几树，杖藜蹋影访逋仙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9706,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题杜德基望云轩卷","author":"蓝仁","text":"平川上有望云轩，栋宇飘零旧扁存。\n遗墨犹能传异代，承家应喜得贤孙。\n春风回首思先垄，秋色关心隔故园。\n百世诗书馀泽远，草堂元在浣花村。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9707,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题听松轩","author":"蓝仁","text":"野老林居入万松，曲肱高卧听长风。\n龙吟水底寒初起，虎啸山前气更雄。\n天籁未收人境内，秋声又挟海涛东。\n客来剥啄惊幽梦，彷佛钧天曲未终。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9708,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重经平川有感","author":"蓝仁","text":"坏道颓垣蔓草区，眼中人世古今殊。\n朱门五马先朝贵，白屋三徵此日无。\n松竹不堪论旧事，山林何处托潜夫。\n月明谁唱沧浪曲，欲问渔舟不可呼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9709,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"荒园有感","author":"蓝仁","text":"一片荒园战伐馀，主人流落未安居。\n春来漫拟桑麻长，岁久谁将蔓草除。\n慨想农功难自弃，静看人事不如初。\n道旁时有栽瓜者，烟雨才分半亩锄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9710,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题黄仲文为孔方作松林樵者图 其一","author":"蓝仁","text":"伐木幽人入翠微，松间久坐澹忘机。\n百年霜雪高柯在，一曲天风古调稀。\n放笔拟将韦偃敌，携书懒逐买臣归。\n图成寄示宁无意，伴我山中老采薇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9711,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题黄仲文为孔方作松林樵者图 其二","author":"蓝仁","text":"松下幽人不受呼，低头屈膝对双株。\n半空翠色连苍蔼，片石清阴转白驹。\n兀坐似忘浮世事，乍逢应讶列仙癯。\n庐山五老峰前路，还有云巢似此无。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9712,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"花朝偶成","author":"蓝仁","text":"一声霹雳洗乾坤，满目青山带白云。\n地底龙蛇惊欲动，树头鸟鹊喜相闻。\n邻人买酒酬春社，野老携书就夕曛。\n閒拂尘埃开匣镜，白头微有黑丝分。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9713,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄刘仲祥索贡馀茶","author":"蓝仁","text":"春山一夜社前雷，万树旗枪渺渺开。\n使者林中徵贡入，野人日暮采芳回。\n翠流石乳千山迥，香簇金芽五马催。\n报道卢全酣昼寝，扣门军将几时来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9714,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谢卢石堂惠白露茶","author":"蓝仁","text":"武夷山里谪仙人，采得云岩第一春。\n丹灶烟轻香不变，石泉火活味逾新。\n春风树老旗枪尽，白露芽生粟粒匀。\n欲写微吟报佳惠，枯肠搜尽兴空频。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9715,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"求河泊刘昌期贡馀茶 其一","author":"蓝仁","text":"苍颜白发未投閒，祇讶名兼吏隐难。\n月校舟缗留渡口，春催茶贡住林间。\n何年天禄然藜杖，旧日霜台借铁冠。\n圣代于今偏敬老，几人半俸卧柴关。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9716,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"求河泊刘昌期贡馀茶 其二","author":"蓝仁","text":"河官暂托贡茶臣，行李山中住数旬。\n万指入云频采绿，千峰过雨自生春。\n封题上品输天府，收拾馀芳寄野人。\n老我空肠无一字，清风两腋愿轻身。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9717,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"云壑寄惠黄杨木簪并诗","author":"蓝仁","text":"黄杨为木至精坚，寸干三春长未全。\n偶乞馀材簪短发，兼烦佳句寄衰年。\n箨冠不用傍人整，槲笠还宜覆顶圆。\n惭愧病躯梳沐少，鬅松双鬓日高眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9718,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日席上呈兼善伯寿","author":"蓝仁","text":"九日欢游处处同，微躯僵坐似枯松。\n强开桑落招诗社，倦插茱萸到病翁。\n张子思归心漫苦，刘郎题咏意先慵。\n瓦盆到手俱?醉，天道无知伯道穷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9719,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"盆松乃慈谷手植","author":"蓝仁","text":"瓦盆乞得小松栽，谁拨霜根向断崖。\n盘屈岂能移本性，低回故欲困长材。\n吞声莫向秋风诉，抗节从教腊雪埋。\n更后千年枝已长，仙人应化鹤飞来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9720,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"盆梅乃林希玄寄惠 其一","author":"蓝仁","text":"罗浮唤醒雪霜魂，知是孤山几代孙。\n冷蕊疏枝低作干，苍苔翠藓近移根。\n未论大用调金鼎，已许平生老瓦盆。\n岁暮徜徉三友在，寒松瘦竹共柴门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9721,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"盆梅乃林希玄寄惠 其二","author":"蓝仁","text":"托根盆盎似藏身，五蕊三花小试春。\n水月影随灯火转，山林迹共市廛亲。\n陇头不为行人折，湖上空怀处士邻。\n最念平生清白操，偶抛霜雪傍光尘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9722,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"瑞香 其一","author":"蓝仁","text":"南园秋色尽凋零，别有幽芳出远林。\n叶布绿云晴霭霭，花攒红粟晓森森。\n雪中吐艳争春早，露里浮香坐夜深。\n不与梅花同素淡，时人少识岁寒心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9723,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"瑞香 其二","author":"蓝仁","text":"儿时长记侍重闱，频向花前戏綵衣。\n春树婆娑低几杖，夜香浮动袭屏帏。\n用心霜雪开时早，晦迹山林识者稀。\n四十年馀看物变，又扶衰病对芳菲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9724,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"瑞香 其三","author":"蓝仁","text":"瑞香当作百花宗，翠叶朱蕤碧玉丛。\n先得阳和开两月，也禁霜雪度三冬。\n江梅比节终藏白，仙杏同时合酿红。\n华石纲中招不去，山林岁晚强为容。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9725,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"尝梨","author":"蓝仁","text":"庭前梨熟闹儿重，踏树攀枝渐欲空。\n一团削玉并刀下，数片浮冰碧椀中。\n疗渴已能除痼疾，尝新何幸及衰翁。\n仙人只爱如瓜枣，安得移根种海东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9726,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送梨与刘镇抚","author":"蓝仁","text":"自得佳名百果宗，累累几度熟秋风。\n树根频扫林无蚁，竹叶重遮谷有蜂。\n挥刃即看冰片落，登盘唯恐雪花融。\n野人久念将军渴，远递双筐手自封。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9727,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送梨与云松","author":"蓝仁","text":"百果称宗品最奇，餐冰咽雪食如饴。\n十年雨露栽培力，八月秋风采摘时。\n登俎应知全味在，倾筐还动故人思。\n张公大谷犹多树，芜没中园久不治。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9728,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"阙雨","author":"蓝仁","text":"云霓踪迹未全消，数日山中草木焦。\n徒有世人祠土梗，自无神力倒天瓢。\n邻床并汲愁枯井，田舍相过叹槁苗。\n欲问天钧谁主宰，十年不听太平谣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9729,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"阙雨寄上官鍊师","author":"蓝仁","text":"七月三旬天不雨，两乡百里井无泉。\n连畦接畛枯将尽，铄石流金势可怜。\n江上雷云虚作意，山中草木欲生烟。\n仙人不管蓬莱浅，深琐苍龙洞里眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9730,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"阙雨寄程云壑","author":"蓝仁","text":"十处结淋九涸泉，几人奔走祇堪怜。\n自焚虚拟之推死，私祭难销孝妇愆。\n渐恐扬尘侵海水，久知垂象动星躔。\n梅峰隐者非忘世，也向云间礼孔仙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9731,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"本真法师祈雨有感兼美武宗理","author":"蓝仁","text":"高士西山有异书，流传况是壁中馀。\n蛟龙悉听仙官令，雷电能教旱魃除。\n岁稔便当期鼓腹，政成端欲赋随车。\n衰年病骨浑无赖，一夜清凉入草庐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9732,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"老泉索赋喜雨","author":"蓝仁","text":"苦热真嫌夏日长，片云今夕作秋凉。\n颠风未欲惊蒲柳，急雨还能养稻粱。\n病骨清泠唯稳睡，吟怀衰老减疏狂。\n冯唐过我谈新咏，扣户先愁债未偿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9733,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"巾秋","author":"蓝仁","text":"玉宇秋中月正明，好天良夕祇伤情。\n谁家庭院开樽俎，几处关山照甲兵。\n白发馀光聊自惜，黄河倒影几时清。\n胡床好尽南楼兴，莫向西风动笛声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9734,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浇花","author":"蓝仁","text":"稚子铜瓶汲井浑，一畦花木对幽轩。\n已看润色分枝叶，更惜清阴庇本根。\n溪涧龙移泉化土，田畴龟拆草连村。\n老夫亦有苏枯意，无力穿云浚水源。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9735,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"途中有感","author":"蓝仁","text":"泥途汨汨雨霏霏，白黑谁能别是非。\n何物功名真拾芥，逼人富贵是危机。\n刑章正密飞腾少，礼乐方新揖让稀。\n槁木死灰忘世者，杖藜回首立斜晖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9736,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"问流人","author":"蓝仁","text":"道旁辛苦问流人，非罪相看误此身。\n何用老成徒取辱，久知温饱不如贫。\n衣裳臭秽沾床汗，枷械拘挛满面尘。\n不自我先休叹恨，周馀靡有孑遗民。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9737,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梦归","author":"蓝仁","text":"独上江城倚夕晖，西风点点雁斜飞。\n百年已半犹为客，三径将芜苦忆归。\n老妇一秋常伏枕，痴雏几度候牵衣。\n月明忽作还家梦，九曲溪头一扣扉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9738,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柬张孟宽","author":"蓝仁","text":"医官督税想贤劳，盥漱忘餐到日高。\n倦执牙筹从会计，偶凭乌几欲推敲。\n舟车凑集须躬阅，药裹增除莫自抛。\n此日虚名求实效，研摩直恐数秋毫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9739,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柬薛君玉","author":"蓝仁","text":"人生自古少合并，邻并应烦数送迎。\n戎马艰危犹旅食，儒衣漂泊负才名。\n有钱可买归山隐，无酒难为待客情。\n伤心世事苦偪侧，可能白发对河清。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9740,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送薛君玉调江西宪椽","author":"蓝仁","text":"落花飞絮送残春，浊酒清歌别远人。\n宪府簿书淹岁月，宦途鞍马傍风尘。\n湖边有宅栖徐孺，城里无山隐子真。\n羡尔奋飞千里远，嗟余落魄二毛新。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9741,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜坐","author":"蓝仁","text":"萧萧风雨坐相侵，共守寒灯抱膝吟。\n扪虱倦谈当世事，闻鸡还起济时心。\n云连烽戍兵犹满，雁度关河雪正深。\n此际正当明出处，且将书剑傍山林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9742,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"纸被","author":"蓝仁","text":"采得仙岩不老藤，蒸云煮雪揭轻冰。\n光浮一片昆山玉，煖压三冬内府绫。\n衣被生灵真有道，卷舒明晦亦堪徵。\n衰年朽骨寒尤甚，自拥蒙头到日升。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9743,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]