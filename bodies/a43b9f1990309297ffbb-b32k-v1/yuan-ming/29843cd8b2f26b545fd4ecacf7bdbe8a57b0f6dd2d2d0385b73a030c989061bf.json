[{"title":"次韵和石末公见寄五绝 其一","author":"刘基","text":"楩楠割截为椽杙，岁暮搜材到柞薪。\n怅望无因见夏后，再平水土叙彝伦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3754,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公见寄五绝 其二","author":"刘基","text":"庙略能回十万夫，诗书郤縠近来无。\n何由入奏明光殿，指点山河一统图。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3755,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公见寄五绝 其三","author":"刘基","text":"春满郊原乐意融，野花庭草竞纤秾。\n惟馀陵上青青柏，不向东风改旧容。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3756,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公见寄五绝 其四","author":"刘基","text":"越溪清水淬干将，鬼魅惊啼畏夜光。\n不共铅刀争利钝，何妨玉匣且深藏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3757,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公见寄五绝 其五","author":"刘基","text":"汉殿千门锦绣开，不堪一夜柏梁灾。\n鲁般骨朽萧何死，肠断无人为取材。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3758,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"社日偶成奉呈石末公","author":"刘基","text":"昔闻同社燕鸡豚，今见操戈竞一飧。\n松柏空坛饥鼠出，枌榆落日乱鸦喧。\n地连吴会嗟何蹙，民是周馀不半存。\n疏懒浑愁闻世事，治聋有酒漫盈尊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3759,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和林彦文刘山驿作诗","author":"刘基","text":"青泥九折度危峰，翠木千章集远风。\n欲为流离安堡障，宁辞辛苦涉蒿蓬。\n梧桐叶落无栖凤，荆棘枝寒有怨鸿。\n旦夕升虚聊望楚，何时重赋定方中？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3760,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题陈太初画扇 其二","author":"刘基","text":"泛湖浮海两如何，满地悲风起白波。\n争似乘槎随博望，玉绳光里看山河。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3761,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题太公钓渭图","author":"刘基","text":"璇室群酣夜，璜溪独钓时。\n浮云看富贵，流水澹须眉。\n偶应非熊兆，尊为帝者师。\n轩裳如固有，千载起人思。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3762,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题烟波泛舟图","author":"刘基","text":"旧游忆鼓湘湖棹，自净风微江练平。\n小艇曲穿花底出，游鱼相伴镜中行。\n别来漫想心徒切，画里重看眼亦明。\n素石苍松是何处，愿从巢父濯冠缨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3763,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻盗过界首季君山甫亦蒙访及以诗唁之","author":"刘基","text":"妖星何故犯奎躔，鹤上云霄鲤入渊。\n寇退喜闻曾子反，书焚尚赖伏生传。\n齑酸并与青毡去，瓜苦空馀绿蔓牵。\n惭愧杜郊汤博士，白盐赤米数相怜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3764,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和刘宗保秋怀二首 其一","author":"刘基","text":"眼见宾鸿去复回，可堪云雾隔瑶台。\n黄花自在山中发，青鸟何由海上来。\n墙角虫号瓜蔓索，树头禽嚇栗房开。\n凉蟾照幕还清夜，惭愧千村野哭哀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3765,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公红树诗","author":"刘基","text":"岸柳江蒲总戚施，桕林辛苦擢金支。\n虞人诧见炎官伞，候骑讹传汉将旗。\n照水荧煌空衒貌，因风飘落竟从谁。\n应惭若木生旸谷，长驻踆乌烛崦嵫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3766,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公悲红树二首 其二","author":"刘基","text":"霜与秋林作锦帏，一朝霜重却全稀。\n坐看绝艳成尘土，应悟浮华是祸机。\n惊鹊月明难自定，穷猿岁暮欲何归。\n犹怜有客期欢赏，太息斯须志愿违。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3767,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"诏书到日喜雨呈石末公","author":"刘基","text":"将军铁马高秋出，使者楼船渤海来。\n甘雨恰随天诏下，冻云应与地图开。\n枯黄背日纷纷落，细绿迎春苒苒回。\n怅望山中多病客，坐看乌鹊绕庭梅。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3768,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感事呈石末公","author":"刘基","text":"前飞鵨鹄后鴐鹅，天阔风高柰汝何。\n不羡焦头居上客，空怜舐痔得车多。\n深山虎豹来城市，落日鼪鼯出薜萝。\n薇蕨可羹鱼可脍，白云长自在岩阿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3769,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公漫兴见寄二首 其一","author":"刘基","text":"王侯古有兴屠狗，郎吏今无善牧羊。\n青海风波腾罔象，紫霄氛祲翳摇光。\n江寒逝水东流急，天远冥鸿北去长。\n莫笑乌鸢恶毛羽，翻飞齐得簉鹓行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3770,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公漫兴见寄二首 其二","author":"刘基","text":"济世何人希管乐，隐居无处觅求羊。\n扶桑未换旸乌彩，腐草犹争爝火光。\n百载承平戎马佚，十年战伐艾菅长。\n长沙迁客能流涕，一日须垂一万行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3771,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻鸠鸣有感呈石末公","author":"刘基","text":"郊原过雨东作始，枝上鹁鸠鸣可怜。\n此地巢居犹葺垒，他乡去子望归田。\n匡时势异民思汉，忧国心随雁到燕。\n逝水自流人自老，倚楹长忆至元年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3772,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和石末公冬暖","author":"刘基","text":"世乱干戈日夜寻，可堪灾沴又相侵。\n烟霞出地皆成祲，雷电飞时肯作霖。\n祝蝪漫劳遵故事，问牛谁复轸忧心。\n小虫未寤年光晚，犹抱枯荄学苦吟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3773,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中呈石末公","author":"刘基","text":"去年三冬暖不雨，今年孟春寒有馀。\n大云垂垂压宇宙，密雪衮衮飘庭除。\n安排白水与泛舸，酝酿青泥容没车。\n辛苦陌头杨柳树，含颦等待太阳舒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3774,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次李子庚韵","author":"刘基","text":"风落馀花春事非，愁心烟雨共霏霏。\n溪云不作从龙起，山石何须学燕飞。\n篱下旧存彭泽菊，林间新长首阳薇。\n夜阑忽漫闻啼鸟，肠断天涯信使稀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3775,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中遣闷","author":"刘基","text":"雨渍愁云重不飞，山蒸冷雾袭人衣。\n亦知屏翳空多事，只恐羲和失所归。\n岁晏波涛东逝急，天寒鸿雁北来稀。\n残灯永夜清无焰，坐听饥猿响翠微。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3776,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"咏史 其一","author":"刘基","text":"六雄糜沸扰天纲，天下嗷嗷望禹汤。\n多事秦皇能一统，却教人忆楚怀王。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3777,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题秋江独钓图","author":"刘基","text":"秋风江上垂纶客，知是严陵是太公？\n细水浮岚天与碧，斜阳炙面脸生红。\n形容想像丹青在，岁月荒凉草泽空。\n日暮忽然闻欸乃，蓼花枫叶忘西东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3778,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送医士贾思诚还浙东二首 其一","author":"刘基","text":"西风袅袅水鳞鳞，一曲离歌泪满巾。\n残柳数株鸥数点，夕阳江上送归人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3779,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送医士贾思诚还浙东二首 其二","author":"刘基","text":"落木长亭独客回，蹇驴聊可当驽骀。\n还山须种千株杏，等待仙华道士来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3780,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句漫兴七首 其七","author":"刘基","text":"永夜西风袅袅来，露华如玉委苍苔。\n碧鸡啼落山头月，肠断槐根梦不回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3781,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜坐二首 其一","author":"刘基","text":"露泣寒螀唁断魂，风惊檐铎语黄昏。\n羁愁悄悄成危坐，看尽空墙上月痕。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3782,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无寐","author":"刘基","text":"夜长无寐待鸣鸡，及至鸡鸣梦却迷。\n惊起朝阳斜照屋，一眉残月在天西。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3783,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪中有怀章三益叶景渊","author":"刘基","text":"岁莫怀人雪满天，饥乌病客对凄然。\n地炉无火同谁坐，石砚生冰尽日眠。\n栗里何时归白发，茅檐几处起青烟。\n稻畦麦陇看春及，土膏泉滋谶有年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3784,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"白发","author":"刘基","text":"白发应同春草茎，风吹一夜满头生。\n欲收浮艳归根柢，故遣芳菲定老成。\n碧瓦晓霜怜变灭，纸窗宵月妒分明。\n据鞍上马非吾事，赖尔妆严意不轻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3785,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句九首 其五","author":"刘基","text":"槐叶阴阴覆短墙，微风细雨麦秋凉。\n如何一岁三春景，不及闲窗午梦长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3786,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句九首 其七","author":"刘基","text":"花落江皋宿雨晴，野烟消尽见芜城。\n凤箫一去无回日，不及年年绿草生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3787,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句九首 其八","author":"刘基","text":"天堑长江似海深，江头山鬼笑埋金。\n东家酿酒西家醉，世上英雄各有心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3788,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句漫兴十一首 其三","author":"刘基","text":"莫道花开便是春，莫言沙涨即成津。\n南风过了东风起，愁杀江头待渡人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3789,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句漫兴十一首 其六","author":"刘基","text":"五湖风雨夜垂纶，一叶扁舟一粟身。\n至竟云涛归大壑，烟波还属钓鱼人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3790,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句漫兴十一首 其七","author":"刘基","text":"病客无钱试药方，出门聊复信行藏。\n争知头上萧萧发，却与游丝较短长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3791,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫成三首 其一","author":"刘基","text":"八骏茫茫去不回，白云歌曲使人哀。\n鲮鱼风起鲸鲵涌，青鸟何由海上来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3792,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫成三首 其三","author":"刘基","text":"微凉生袂一登楼，落照归鸦点点愁。\n谁似孤云独无事，随风直到海西头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3793,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"不雨遣闷二首 其二","author":"刘基","text":"池上芹泥即渐乾，梁间燕子拾虫难。\n绿窗无限伤春意，看尽斜阳更倚阑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3794,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春蚕","author":"刘基","text":"可笑春蚕独苦辛，为谁成茧却焚身。\n不如无用蜘蛛网，网尽蜚虫不畏人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3795,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"愁感代哭","author":"刘基","text":"燕鸿北去又南来，断垄荒冈几劫灰。\n慈母矶寒风落木，望夫石老雨添苔。\n江流定与天河合，客泪还经地底回。\n未必春光便销歇，白华犹发烧残梅。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3796,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"望孤山作","author":"刘基","text":"晓日千山赤，寒烟一岛青。\n羁心霜下草，生态水中萍。\n黄屋迷襄野，苍梧隔洞庭。\n空将垂老泪，洒恨到沧溟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3797,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"青丝马","author":"刘基","text":"蹀躞青丝马，艰难赤伏符。\n穷阴岁欲暮，落日鬼相呼。\n见雁愁心裂，看天泪眼枯。\n殷勤夜深月，还照旅魂孤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3798,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"十二月一日","author":"刘基","text":"耿耿夜不寐，源源忧思来。\n岁馀三十日，肠定九千回。\n江响风初发，天昏月未开。\n白头真合得，非是楚猿哀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3799,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春城","author":"刘基","text":"春尽江城不见花，似知白发畏韶华。\n战争故习俱无赖，丧乱馀生未有涯。\n三岛虹蜺昏日月，二仪风雨化龙蛇。\n何年百谷归沧海，寻取河源泛客槎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3800,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钟山作十二首 其九","author":"刘基","text":"白雁萧萧柿叶红，野花开尽六王宫。\n空馀一道秦淮水，著意西流竟向东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3801,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"岁晏","author":"刘基","text":"岁晏悲风急，空江白昼阴。\n黄芦与红蓼，无处不伤心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3802,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"摇落","author":"刘基","text":"摇落江天气惨凄，野黄云白惑东西。\n可怜饥鼠当人立，无柰寒鸦向客啼。\n杳杳夕阳葭浦阔，茫茫秋水稻田低。\n销魂何地归衰疾，触处烟尘沸鼓鼙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3803,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夕","author":"刘基","text":"柏叶萧疏柳叶黄，露华如玉缀空廊。\n丹心欲共灯花结，白发偏随漏水长。\n月色故园同窈窕，虫声此夜独凄凉。\n寒鸦莫更啼金井，衰病能堪几断肠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3804,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"将晓","author":"刘基","text":"愁梦不更续，寒天将欲明。\n雪风吹海树，霜月凛江城。\n衰病丹心在，艰虞素发盈。\n殷勤东注水，渺渺若为情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3805,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题梅屏二绝 其一","author":"刘基","text":"树杪过流星，轻霜落半庭。\n疏花与孤客，相对一青灯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3806,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公秋日感怀见寄二首 其一","author":"刘基","text":"郊原如赭巳无秋，况复干戈未肯休。\n肉食不知田野事，布衣深为庙廊忧。\n典章沦落悲刍狗，馈饷倭迟想木牛。\n礼乐将军今郤縠，豺狼满地待虔刘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3807,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜坐有怀呈石末公","author":"刘基","text":"西风白露下清寥，岸柳江蒲取次凋。\n诸将旌麾非一统，大藩衣服变三苗。\n雄豪窃据皆屠狗，功业舆台总续貂。\n弃马独知怀故枥，天涯涕泪北辰遥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3808,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公春晴诗","author":"刘基","text":"幽禽啧啧语朝阳，细绿骎骎入女桑。\n天上深宫调玉烛，人间和气应勾芒。\n赤眉青犊终何在，白马黄巾莫漫狂。\n将帅如林须发踪，太平功业望萧张。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3809,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"望江亭","author":"刘基","text":"柳拂江亭旧画栏，望潮人去地应闲。\n寝园寂寞秋风里，行殿荒凉野草间。\n白塔尽销龙虎气，荒城空锁凤凰山。\n兴亡莫问前朝事，江水东流去不还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3810,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"至日遣兴","author":"刘基","text":"十九年前此日同，浙江西望粤城东。\n山川拥隔乖同轨，气朔分齐正八风。\n坐阅天时占道长，起征云物欲年丰。\n嬴粮儗问商颜路，好采灵芝伴四翁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3811,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"即事","author":"刘基","text":"千林摇落暮天寒，短景经檐岁序残。\n口舌得官齐虏易，膏肓致疾上医难。\n无根荒蔓风飘急，阅世松乔气厚蟠。\n鸿雁随阳经远道，帛书何日到长安？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3812,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂诗四十首 其二","author":"刘基","text":"小鱼头如针，大鱼须如松。\n小大各生育，孰私天地功。\n坤灵发淫怒，溟海簸惊风。\n大鱼食小鱼，陂池为之空。\n陂空水亦竭，小大相噞喁。\n但见灌莽间，颅骨成崆巃。\n残膏饫蝼蚁，孰辨鲸与鯼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3813,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂诗四十首 其三","author":"刘基","text":"儳妇厌贫夫，常怀相弃心。\n慨慕东家子，年少多黄金。\n轻身改西托，布被烂锦衾。\n宁忆秋风起，霜露凄繁林。\n叶落枝亦尽，愁闻蜻蛚吟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3814,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂诗四十首 其四","author":"刘基","text":"云月虽不明，精魄固长在。\n飞蛾亦何知，乘时妒光彩。\n天高多飘风，烟雾中叆叇。\n纷纷堕蒿棘，终竟为何罪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3815,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂诗四十首 其五","author":"刘基","text":"人生如浮云，飘摇无根蒂。\n昨暮青山阿，今朝沧海澨。\n风波无定时，沦踬难为计。\n是中苟不爽，曷问耿与翳。\n申胥存楚国，仲连却秦帝。\n此士虽则亡，英名千万世。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3816,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂诗四十首 其六","author":"刘基","text":"渴人常梦饮，饥人常梦餐。\n中宵羁旅梦，两臂生羽翰。\n腾身入紫青，吹面天风寒。\n惊觉凛毛发，感我涕汍澜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3817,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂诗四十首 其七","author":"刘基","text":"吾观神龙变，天地为晦冥。\n龙成宰元化，嘉泽浃四溟。\n出山不飘风，入水无震霆。\n枯萎仰沾溉，沃若生葱青。\n岂比蜧与蜦，裂石摧巘陉。\n俾民举疾首，抏神蹙眉听。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3818,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂诗四十首 其八","author":"刘基","text":"鹰本是鸷鸟，爪利翮劲疾。\n胡为化为鸠，钝拙无与匹。\n栖迟荆棘间，粒啄营口实。\n暮啼墙角雨，朝啼屋头日。\n昔为众鸟畏，今为众鸟咥。\n运命苦不常，孰为金石质。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3819,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]