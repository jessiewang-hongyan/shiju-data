[{"title":"题孙氏雪林小隐图","author":"倪瓒","text":"天地飘摇一短篷，小窗虚白地炉红。\n翛然忽起梨云梦，不定仍因柳絮风。\n鹤影䙰褷檐上下，鹿迒散漫屋西东。\n杜门我自无干请，閒写芭蕉入画中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2980,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送杭州谢总管","author":"倪瓒","text":"南省迢遥阻北京，张公开府任豪英。\n守臣视爵等侯伯，仆射亲民如父兄。\n钱庙有碑刓夜雨，岳坟无树著秋声。\n好将饮食濡饥渴，何待三年报政成。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2981,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"上巳日感怀","author":"倪瓒","text":"石梁破屋路敧斜，僻似华阳道士家。\n漠漠春云飞别鹤，潺潺夜雨杂鸣蛙。\n閒看稚子翻书叶，时有邻翁汲井花。\n日暮伤心江水绿，共舟人已蹑飞霞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2982,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠张玄度时方丧内","author":"倪瓒","text":"吴松江水似荆溪，九点烟岚落日西。\n寂寂郊园寒食过，萧萧风雨竹鸡啼。\n蕙花委砌心应折，芳草归途意转迷。\n曾得鲁连消息否？\n春潮随雨到长堤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2983,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄熙本明二首 其二","author":"倪瓒","text":"白首遥知得道馀，不闻诗思近何如。\n高斋夜雪同谁话？\n古木寒山独自居。\n梦里只寻行去路，愁时聊读寄来书。\n夕阳溪上多飞鸟，若个能看影是虚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2984,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄卢士行","author":"倪瓒","text":"阖闾浦口路依微，笠泽汀边白板扉。\n照夜风镫人独宿，打窗江雨鹤相依。\n畏途岂有新知乐，老境空思故里归。\n拟问桃花泛春水，船头浪暖鳜鱼肥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2985,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送徐子素","author":"倪瓒","text":"山馆留君才一月，梅花无数倚霜晴。\n垂帘幽阁团云影，贮火茶炉作雨声。\n深竹每容驯鹿卧，青山时与道人行。\n归舟载得梁溪雪，惆怅邻鸡月四更。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2986,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄养正","author":"倪瓒","text":"得君佳句清如玉，秋色惊人换物华。\n老境侵寻真有感，故园隔绝更兴嗟。\n女萝绿遍牵茅屋，乌桕红明映落霞。\n欲酌一尊浇磊块，几时邀子过田家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2987,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"喜谢仲野见过","author":"倪瓒","text":"阶下樱桃已著花，窗前野客独思家。\n故人携手蹋江路，拄杖敲门惊梦华。\n藉草悲歌声激烈，停杯写竹字敧斜。\n新蒲细柳依依绿，西北浮云望眼遮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2988,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送僧游天台次张外史韵","author":"倪瓒","text":"四明山水名天下，师去那知客路遥。\n雪霁惊麇腾宿莽，月明寒鹊集疏条。\n坐寻云顶千峰石，归趁江头八月潮。\n说与住山光老子，送宾也合过溪桥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2989,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过许生茅屋看竹","author":"倪瓒","text":"舟过山西已夕曛，许生茅屋远人群。\n凿池数尺通野水，开牖一规留白云。\n煮药烟轻冲灶出，碓茶声远隔溪闻。\n可怜也有王猷兴，阶下新移少此君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2990,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄顾仲瑛","author":"倪瓒","text":"江海秋风日夜凉，虫鸣络纬尚綀裳。\n民生惴惴疮痍甚，旅泛依依道路长。\n衰柳半敧湖水碧，浊醪犹趁菊花黄。\n知君习静观诸妄，林下清斋理药囊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2991,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"中秋","author":"倪瓒","text":"经旬卧病掩山扉，岩穴潜神似伏龟。\n身世浮云渡流水，生涯煮豆爨枯萁。\n红蠡捲碧应无分，白发悲秋不自支。\n莫负尊前今夜月，长吟桂影一伸眉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2992,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"竹枝词 其四","author":"倪瓒","text":"春愁如雪不能消，又见清明卖柳条。\n伤心玉照堂前月，空照钱唐夜夜潮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2993,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"竹枝词 其五","author":"倪瓒","text":"嗈嗈归雁度春江，明月清波雁影双。\n化作斜行筝上字，长弹幽恨隔纱窗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2994,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"三月廿日题所寓屋壁","author":"倪瓒","text":"梓树花开破屋东，邻墙花信几番风。\n闭门睡过兼旬雨，春事依依是梦中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2995,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻竹枝歌因效其声二首 其一","author":"倪瓒","text":"钿山湖影接松江，橘叶青青柿叶黄。\n要写新愁寄音信，西风断雁不成行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2996,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻竹枝歌因效其声二首 其二","author":"倪瓒","text":"江流不住楚山青，船到浔阳几日程。\n不忍寄将双泪去，门前潮落又潮生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2997,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画赠僧","author":"倪瓒","text":"笠泽依稀雪意寒，澄怀轩里酒杯乾。\n篝镫染笔二更后，远岫疏林亦耐看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2998,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自题小画","author":"倪瓒","text":"逸笔纵横意到成，烧香弄翰了馀生。\n窗前竹树依苔石，寒雨萧条待晚晴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2999,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"吴中","author":"倪瓒","text":"望中烟草古长洲，不见当时麋鹿游。\n满目越来溪上水，流将春梦过杭州。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3000,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画 其一","author":"倪瓒","text":"僦得城东三亩居，水光竹色照琴书。\n晨起开门惊宿鸟，诗成洗砚没游鱼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3001,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画","author":"倪瓒","text":"罨画溪头唤渡，铜官山下寻僧。\n水榭汀桥曲曲，风林云磴层层。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3002,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送宝南琛往住荆溪碧云寺兼简方厓","author":"倪瓒","text":"碧云林壑杳重重，此去风流似简公。\n舂药碓閒湍激下，吟秋蛩响月明中。\n结茅拟候芝三秀，眠鹿应遗地一弓。\n闻道重居开竹牖，待予艇子过溪东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3003,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵邵生","author":"倪瓒","text":"已从鸥鸟狎云深，老我无机似汉阴。\n采采菊花犹满地，萧萧霜发不胜簪。\n南游阻绝伤多垒，北望艰危折寸心。\n好在吴松江水上，青猿啼处有枫林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3004,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"烟雨中过石湖三绝 其一","author":"倪瓒","text":"烟雨山前度石湖，一奁秋影玉平铺。\n何须更剪松江水，好染空青作画图。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3005,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"烟雨中过石湖三绝 其二","author":"倪瓒","text":"姑苏城外短长桥，烟雨空濛又晚潮。\n载酒曾经此行乐，醉乘江月卧吹箫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3006,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"烟雨中过石湖三绝 其三","author":"倪瓒","text":"愁不能醒已白头，沧江波上狎轻鸥。\n鸥情与老初无染，一叶轻躯总是愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3007,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自题设色山水赠孟肤徵君","author":"倪瓒","text":"秋潮夜落空江渚，晓树离离含宿雨。\n伊轧中流间橹声，卧听渔人隔烟语。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3008,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梁父吟","author":"杨维桢","text":"步出齐城门，上陟独乐峰。\n梁父昂雉堞，荡阴夷鬣封。\n齐国杀三士，杵臼不能雄。\n所以《梁父吟》，感叹长笑翁。\n吁嗟长笑翁，相汉起伏龙。\n关张比疆冶，将相俱和同。\n上帝弃炎祚，将星堕营中。\n抱膝和《梁父》，《梁父》生悲风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3009,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"孔巢父","author":"杨维桢","text":"孔巢父，竹溪流。\n竹溪之水可饮牛，胡为去干肉食谋。\n孔巢父，盍归来？\n河北虎幸毙，河中虎方威。\n孔巢父，不归去。\n十年东海迷烟雾，钓竿空负珊瑚树。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3010,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"警枕词","author":"杨维桢","text":"不睡龙，醒复醒，珊瑚圆木摇金铃。\n五花宝簟芙蓉屏，铜盘雪粉香浅清。\n楼墙铜弹飞霹雳，夜半更奴起辟易。\n圆木功，无与敌。\n吴越封疆平地辟，四世三王安衽席。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3011,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"三阁图","author":"杨维桢","text":"金陵新阁空中起，虎踞龙蟠凤双掎。\n沈檀雕柱阚玉螭，丽华吹笙綵云里。\n水晶帘空滤明月，三十六宫白于水。\n红尘巴马四百秋，五城步障五花毬。\n綵缯山头盖宫殿，山前十二银潢流。\n健娥五百曳锦缆，金莲吐影上下金银州。\n二三狎客混歌舞，中有酒悲泪如雨。\n嘉州讽谏三阁图，秦川别幸千花株。\n回鹃队，鸦群呼，夜半卷土昌泸渝。\n黄茅缚髻口衔璧，草降表，王中书。\n呜呼，《玉树》声中作唐虏，门外崇韬是擒虎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3012,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"澶渊行","author":"杨维桢","text":"阳城淀，高阳关，边书告急夕五至，皇帝亲至岢岚山。\n殿前寇相一斗胆，楚蜀谋臣谋可斩。\n阳光抱珥已开光，床机一发中挞揽。\n雄谋独断众勿摇，孤注一掷先成枭。\n跋河不渡势不止，贾勇况有高嫖姚。\n千羊万犬锐若隼，望见龙光气俱尽。\n万岁声呼天可汗，擎天一柱惟付准。\n飞龙使，修载书，鬼母尚执关南图。\n君不见汉家玉帛赐单于，何尝割地分边隅。\n却怜艺祖岁帛二十万，不博黑子一万蕃枯颅。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3013,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"冬青冢篇","author":"杨维桢","text":"老羝夜射钱塘潮，天山两乳王气消。\n秃妖尚压龙虎怪，浮图千尺高岧峣。\n文山老客智且勇，夜舟拔山山不动。\n江南石马久不嘶，冢上冬青今已拱。\n百年父老愤填胸，不知巧手夺天工。\n冬青之木郁葱葱，六槚更树蒲门东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3014,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"李铁枪歌","author":"杨维桢","text":"古铁枪，五代烈。\n今铁枪，万人杰。\n红蛮昨夜斩关来，防关老将泣如孩。\n铁枪手持丈二材，铁马突出擒红魁。\n磔红头，凿红骨。\n誓红不同生，灭红倒红窟。\n君不见钱塘城中十万家，十万甲兵赭如血，一夜南风吹作雪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3015,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"李铁鎗歌","author":"杨维桢","text":"李铁鎗，人之杰，将之强，手持铁鎗丈二长。\n铁鎗入手乌龙骧，龙精射之落搀抢。\n皇帝十有二载秋七月，红凶西来寇西浙。\n防关健儿走惶惶，铁鎗一怒目眦裂。\n十万赭衣暗城阙，铁鎗乌龙去明灭。\n须臾化作风雨来，净洗铜城满城血。\n呜呼，殪猰貐，屠封狼，铁鎗之锋无与当。\n胡为将星昨夜坠昱关，铁鎗一折天无光。\n天无光，人伥伥，云台倚天云潜伤。\n天子赠忠良，祠以血食冬青乡。\n呜呼，归来乎铁鎗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3016,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"铁城谣","author":"杨维桢","text":"蒸土筑城城上铁，北风一夜吹作雪。\n君不见铜驼关外铁瓮堆，中填白骨外涂血，髑髅作声穿鬼穴。\n铜驼崩，铁瓮裂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3017,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南妇还","author":"杨维桢","text":"今日是何日，恸返南州岐。\n汩汩东逝水，一日有西归。\n长别二十年，休戚不相知。\n去时虿发青，归来面眉黧。\n昔人今则是，故家今则非。\n脱胎有父母，结发有夫妻。\n惊呼问邻里，共指冢累累。\n访死欲穿隧，泣血还复疑。\n白骨满丘山，我逝其从谁？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3018,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"采莲曲 其一","author":"杨维桢","text":"东湖采莲叶，西湖采莲花。\n一花与一叶，持寄阿侯家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3019,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自君之出矣 其一","author":"杨维桢","text":"自君之出矣，燕去复燕归。\n思君如荔带，日日抱君衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3020,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"吴子夜四时歌 其二","author":"杨维桢","text":"睡起珊瑚枕，微风度屧廊。\n芙蓉最高叶，翻水洗鸳鸯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3021,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宫词十二首 其一","author":"杨维桢","text":"鸡人报晓五门开，卤簿千官泊虎台。\n天上鴐鹅先有信，九重鸾驾上都回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3022,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宫词十二首 其二","author":"杨维桢","text":"开国遗音乐府传，《白翎》飞上十三弦。\n大金优谏关卿在，伊尹扶汤进剧编。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3023,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宫词十二首 其三","author":"杨维桢","text":"海内车书混一时，奎章御笔写乌丝。\n朝来中贵传宣急，南国宫娥拱凤池。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3024,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宫词十二首 其四","author":"杨维桢","text":"薰风殿阁日初长，南贡新来荔子香。\n西邸阿环方病齿，金笼分赐雪衣娘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3025,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宫词十二首 其五","author":"杨维桢","text":"宫锦裁衣锡圣恩，朝来金榜揭天门。\n老娥元是南州女，私喜南人擢殿元。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3026,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宫词十二首 其六","author":"杨维桢","text":"北幸和林幄殿宽，句丽女侍婕妤官。\n君王自赋昭君曲，敕赐琵琶马上弹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3027,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宫词十二首 其七","author":"杨维桢","text":"后土璚仙属内家，扬州从此绝名花。\n君王题品容谁并，萼绿宫中萼绿华。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3028,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宫词十二首 其八","author":"杨维桢","text":"十二璚楼浸月华，桐花移影上窗纱。\n檐前不插盐枝竹，卧听金羊引小车。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3029,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宫词十二首 其九","author":"杨维桢","text":"金屋秋深露气凉，宫监久不到西厢。\n丁宁莫窃宁哥笛，鹦姆无情说短长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3030,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宫词十二首 其十","author":"杨维桢","text":"露气夜生鳷鹊楼，井梧叶叶已知秋。\n君王只禁宫中蛊，不禁流红出御沟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3031,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宫词十二首 其十一","author":"杨维桢","text":"十三宫女善词章，长立君王玉几傍。\n阿婉有才还有累，宫中鹦鹉啄条桑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3032,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宫词十二首 其十二","author":"杨维桢","text":"蛾眉矉处不胜秋，长带芙蓉小苑愁。\n肯为君王通一笑，羽书烽火误诸侯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3033,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"女史咏十八首 其六 关盼盼","author":"杨维桢","text":"冢上白杨今十年，楼头燕子尚留连。\n铜台多少丁宁恨，谁向西陵望墓田。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3034,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖竹枝歌 其二","author":"杨维桢","text":"鹿头湖船唱赧郎，船头不宿野鸳鸯。\n为郎歌舞为郎死，不惜真珠成斗量。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3035,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖竹枝歌 其三","author":"杨维桢","text":"家住西湖新妇矶，劝君不唱缕金衣。\n琵琶元是韩朋木，弹得鸳鸯一处飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3036,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖竹枝歌 其四","author":"杨维桢","text":"劝郎莫上南高峰，劝侬莫上北高峰。\n南高峰云北高雨，云雨相催愁杀侬。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3037,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖竹枝歌 其五","author":"杨维桢","text":"湖口楼船湖日阴，湖中断桥湖水深。\n楼船无柁是郎意，断桥无柱是侬心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3038,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖竹枝歌 其六","author":"杨维桢","text":"病春日日可如何？\n起向西窗理琵琶。\n见说枯槽能卜命，柳州巷口问来婆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3039,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖竹枝歌 其七","author":"杨维桢","text":"小小渡船如缺瓜，船中少妇《竹枝歌》。\n歌声唱入空侯调，不遣狂夫横渡河。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3040,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖竹枝歌 其八","author":"杨维桢","text":"石新妇下水连空，飞来峰前山万重。\n不辞妾作望夫石，望来或似飞来峰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3041,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖竹枝歌 其九","author":"杨维桢","text":"望郎一朝又一朝，信郎信似浙江潮。\n浙江潮信有时失，臂上守宫无日消。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3042,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"羲仲以吴之柳枝词答为赋诗","author":"杨维桢","text":"吴中《柳枝》伤春瘦，湖中《竹枝》湘水愁。\n说与钱塘苏小小，《柳枝》愁是《竹枝》愁？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3043,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春侠杂词 其九","author":"杨维桢","text":"西江美人久不见，手把新题合欢扇。\n鲤鱼凭送相思书，霸王门前水如箭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3044,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"小游仙 其十七","author":"杨维桢","text":"青旄节卫翠云軿，按部东行过赤城。\n龙女遗珠鸡卵大，结为双佩赐方平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3045,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]