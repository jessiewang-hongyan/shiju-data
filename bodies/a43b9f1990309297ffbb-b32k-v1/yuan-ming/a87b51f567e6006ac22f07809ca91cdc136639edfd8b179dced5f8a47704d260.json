[{"title":"春日海村三首 其三","author":"丁鹤年","text":"每恨韶华晚，仍嗟老病催。\n闭门花落尽，隐几鸟飞回。\n引睡书千卷，消愁酒一杯。\n平生志士气，此日已成灰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3212,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄西湖林一贞先生","author":"丁鹤年","text":"锦绣湖山世绝稀，东风不放赏心违。\n芙蓉杨柳临清浅，佛刹仙宫绕翠微。\n画舫载春天上坐，紫骝驮醉月中归。\n高情独有林和靖，门掩晴空看鹤飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3213,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"海巢","author":"丁鹤年","text":"海上巢居海若降，三山眼底小如矼。\n已攀若木为华表，更立榑桑作翠幢。\n蛟室夜光晴烛户，蜃楼秋影冷涵窗。\n鹪鹩梦断无因到，唯有同栖鹤一双。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3214,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送人归故园","author":"丁鹤年","text":"故人休道已休兵，客里那堪送客行。\n老去别怀殊作恶，乱馀归计倍关情。\n孤村月落群鸡叫，绝塞天清一雁横。\n到日所亲如见问，浪游江海负平生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3215,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"异乡清明","author":"丁鹤年","text":"十年澒洞家何在，万里清明客未归。\n雨僽风僝花乱落，泥融水暖燕交飞。\n烟生榆柳推迁速，云锁松楸拜扫违。\n旅雁尽回音问断，侧身长望泪频挥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3216,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"长江万里图 其一","author":"丁鹤年","text":"长江千万里，何处是侬乡。\n忽见晴川树，依稀认汉阳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3217,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"长江万里图 其二","author":"丁鹤年","text":"长啸还江国，迟回别海乡。\n春潮如有意，相送过浔阳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3218,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题落花芳草白头翁","author":"丁鹤年","text":"草长连朝雨，花残一夜风。\n青春留不住，啼杀白头翁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3219,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题梅花扇面寄五十佥宪","author":"丁鹤年","text":"忆向西湖蹋早春，万花如玉月如银。\n一枝照影临清浅，满面冰霜似故人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3220,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题林泉野趣图","author":"丁鹤年","text":"清江白石带疏林，樊口幽居尚可寻。\n梦里草堂无恙在，秋风春雨总关心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3221,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"岁晏百忧集二首 其一","author":"丁鹤年","text":"岁晏百忧集，独坐弹鸣琴。\n琴声久不谐，何以怡我心。\n拂衣出门去，荆棘当道深。\n还归茅屋底，抱膝《梁父吟》。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3222,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"岁晏百忧集二首 其二","author":"丁鹤年","text":"岁晏百忧集，击节发商歌。\n商歌未终调，泪下如悬河。\n故乡渺何许，北斗高嵯峨。\n有家不可归，无家将奈何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3223,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"逃禅室述怀十六韵","author":"丁鹤年","text":"出处两茫然，低徊每自怜。\n本无经国术，仍乏买山钱。\n故邑三千里，他乡二十年。\n力微归计杳，身远客心悬。\n桃李谁家树？\n禾麻傍舍田。\n鹑衣秋屡结，蜗室岁频迁。\n逝水终难复，寒灰更不然。\n久要成龃龉，多病复沈绵。\n俯仰衷情倦，栖迟野性便。\n延徐谁下榻，访戴独回船。\n耻洒穷途泣，閒修净土缘。\n谈玄分上下，味道悉中边。\n有相皆虚妄，无才幸苟全。\n栖云同白鹿，饮露效玄蝉。\n高蹈惭真隐，狂歌愧昔贤。\n惟馀空念在，山寺日逃禅。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3224,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客怀","author":"丁鹤年","text":"此生何坎壈，终岁客他乡。\n病骨惊秋早，愁心识夜长。\n文章非豹隐，韬略岂鹰扬。\n磨灭馀方寸，还同百鍊刚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3225,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"病衰","author":"丁鹤年","text":"病骨秋增痛，衰容日减华。\n脸霞怜竹叶，鬓雪妒菱花。\n往事嗟何及，归程望转赊。\n少年歌舞地，此日属谁家？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3226,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自咏十律 其一","author":"丁鹤年","text":"长淮横溃祸非轻，坐见中流砥柱倾。\n太守九江先效死，诸公四海尚偷生。\n风云意气惭豪杰，雨露恩荣负圣明。\n一望神州一搔首，天南天北若为情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3227,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自咏十律 其二","author":"丁鹤年","text":"腐儒避地海东偏，凤历颁春下九天。\n再拜帝尧新正朔，永怀神禹旧山川。\n庙堂久托君臣契，藩阃兼操将相权。\n只在忠良勤翊戴，万方行睹至元年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3228,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自咏十律 其三","author":"丁鹤年","text":"一夜西风到海滨，楼船东出海扬尘。\n生惭黄歇三千客，死慕田横五百人。\n纪岁自应书甲子，朝元谁共守庚申。\n悲歌抚罢龙泉剑，独立苍茫望北辰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3229,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自咏十律 其四","author":"丁鹤年","text":"羲轩道德久荒唐，荡荡宏图起世皇。\n天入清都逾广大，日临化国倍舒长。\n渥洼万里来骐骥，阿阁千年下凤凰。\n圣子神孙承宝祚，长令亿兆乐时康。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3230,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自咏十律 其五","author":"丁鹤年","text":"堂堂至正最多才，万国同文寿域开。\n漠北诸生登第去，越南计吏进贤来。\n凤《韶》九奏黄金殿，鹤驾三朝白玉台。\n回首黄尘扬碧海，五云无处觅蓬莱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3231,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自咏十律 其六","author":"丁鹤年","text":"金银宫阙五云乡，曾见群仙奉玉皇。\n济济夔龙兴礼乐，桓桓方虎靖封疆。\n自沦碣石沧溟底，谁索玄珠赤水傍。\n独有遗民负悲愤，草间忍死待宣光。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3232,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自咏十律 其七","author":"丁鹤年","text":"千官何处扈宸游，回首风尘遍九州。\n黄竹雪深迷玉辇，苍梧云断见珠丘。\n令威不尽去家怨，精卫岂胜填海愁。\n大禹胼胝天所眷，肯教纶邑久淹留。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3233,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自咏十律 其八","author":"丁鹤年","text":"六军遥驻墨河濆，故国丘墟讵忍闻。\n露冷金铜应独泣，火炎玉石竟俱焚。\n虞渊日暮无还景，禹穴秋深有断云。\n草泽遗民今白发，凭高无奈思纷纷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3234,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自咏十律 其九","author":"丁鹤年","text":"皇天辅德本无亲，兴复宁论地与民。\n纶有一成终祀夏，楚虽三户竟亡秦。\n昆虫咸被生成德，草木犹怀化育仁。\n洪运未移神器在，周宣汉武果何人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3235,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自咏十律 其十","author":"丁鹤年","text":"九鼎神州竟陆沈，偷生江海复山林。\n频繁谁在隆中顾，憔悴惟馀泽畔吟。\n齧雪心危天日远，看云泪尽岁时深。\n百年家国无穷事，可得忘机老汉阴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3236,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"故宫人","author":"丁鹤年","text":"粉愁香怨不胜情，强整残妆对老兵。\n别殿金莲馀故步，《后庭玉树》变新声。\n眼穿雁字云连塞，梦断羊车月满城。\n天上桃开王母去，世人谁识许飞琼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3237,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"别帽","author":"丁鹤年","text":"云样飘萧月样团，百年雄丽压南冠。\n黄金缀顶攒文羽，白璧垂缨间木难。\n刺绣尚期平敌垒，簪花曾梦舞仙坛。\n一从吹堕西风里，谁念蒙尘白发寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3238,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"元夕","author":"丁鹤年","text":"灯火楼台锦绣筵，谁家箫鼓夜喧阗？\n光移星斗天逾近，影倒山河月正圆。\n金锁开关明似昼，铜壶传漏迥如年。\n五云不奏《霓裳曲》，空使扬州望眼穿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3239,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪后泛东湖","author":"丁鹤年","text":"雪后湖山玉作围，小舟乘兴弄清辉。\n贪看月里鸾回舞，不觉风前鹢退飞。\n云母屏空春阒寂，水晶宫冷晚霏微。\n仙家一笑乾坤老，谁驭瑶池八骏归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3240,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题凤浦方氏梧竹轩","author":"丁鹤年","text":"凤鸟曾闻此地过，至今梧竹满丘阿。\n政怀剪叶书周史，却恨翻枝入楚歌。\n金井月明秋影薄，石坛风细晚凉多。\n中郎去后知音少，共负奇才奈老何！","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3241,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉寄王宣慰兼呈九灵先生","author":"丁鹤年","text":"别馆新成足宴游，珊珊环佩总名流。\n独推南郭为高士，共识东陵是故侯。\n天上莺花三月梦，人间风雨五更愁。\n行藏尽付浮云外，烂醉丰年稌黍秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3242,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉寄九灵先生四首 其一","author":"丁鹤年","text":"挟海怀山谒紫宸，拟将忠孝报君亲。\n忽从华表闻辽鹤，却抱遗经泣鲁麟。\n丧乱行藏心似铁，蹉跎勋业鬓如银。\n万言椽笔今无用，閒向林泉纪逸民。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3243,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉寄九灵先生四首 其二","author":"丁鹤年","text":"花柳村村接海滨，携家随处避风尘。\n衣冠栗里犹存晋，鸡犬桃源久绝秦。\n坐对青山浑不厌，忘机白鸟自相亲。\n也知出处关时运，岂但逃名效隐沦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3244,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄定海故将军邵公辅","author":"丁鹤年","text":"往事浮云杳莫攀，壮怀未展鬓先斑。\n不闻奉使通银汉，空见将军老玉关。\n故垒荒凉千骑尽，沧溟浩荡一鸥閒。\n风尘随处严诃止，愁杀田间野猎还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3245,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"逃禅室与苏伊举话旧有感","author":"丁鹤年","text":"不学扬雄事草《玄》，且随苏晋暂逃禅。\n无锥可卓香岩地，有柱难擎杞国天。\n谩诧丹霞烧木佛，谁怜青露泣铜仙。\n茫茫东海皆鱼鳖，何处堪容鲁仲连。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3246,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄馀姚滑伯仁先生","author":"丁鹤年","text":"独木桥边薜荔门，全家移住水云村。\n猿声专夜丹山静，蜃气横秋碧海昏。\n诗卷自书新甲子，药壶别贮小乾坤。\n陶渔耕稼遗风在，差胜桃源长子孙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3247,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄馀姚宋无逸先生","author":"丁鹤年","text":"龙泉城外绝嚣喧，寄傲全胜在漆园。\n独对江山怀舜禹，每凭风月问刘樊。\n行窝酾酒花围席，野寺题诗竹满轩。\n回首昆冈空劫火，深期什袭保玙璠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3248,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中寄杨彦常先生","author":"丁鹤年","text":"山中长夏苦淫雨，暂尔出门还不能。\n九天驭日力已竭，两地看云愁倍增。\n怜君畏途久作客，笑我净舍常依僧。\n相思倚柱发清啸，旁人不解谷空应。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3249,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题太守兄遗稿后","author":"丁鹤年","text":"海国期年政化成，肩舆随处看春耕。\n正欣鸡犬无惊扰，讵意鲸鲵有斗争。\n遥岛月明虚燕寝，故山云冷失佳城。\n梦回诗句难重得，肠断池塘草又生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3250,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题昌国普陀寺二首 其一","author":"丁鹤年","text":"神鳌屹立戴崔嵬，俯瞰沧溟水一杯。\n积翠自天开罨画，布金随地起楼台。\n祈灵汉使乘槎到，传法胡僧折苇来。\n若使祖龙知胜概，岂应驱石访蓬莱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3251,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题昌国普陀寺二首 其二","author":"丁鹤年","text":"昆明劫火忽重然，宇内名山悉变迁。\n古刹独存龙伯国，丰碑犹记兔儿年。\n三更日浴咸池水，八月潮吞渤海天。\n云汉灵槎如可御，便应长往问群仙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3252,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题东湖青山寺古鼎铭长老钟秀阁","author":"丁鹤年","text":"手开楼阁贮群经，面对湖山卫百灵。\n玉镜夜寒通沆瀣，翠屏秋净倒空青。\n避烟鹤起檐间树，行雨龙归几上瓶。\n我亦逃禅云水客，便应萧散共松扃。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3253,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寓奉化寺寄菩提寺主","author":"丁鹤年","text":"菩提岭外空王寺，丹磴行穿虎豹群。\n万壑涛声岩下瀑，千峰雨气屋头云。\n海龙送水金瓶贮，天女怀香宝鼎焚。\n惭愧无缘尘土客，朝朝钟鼓下方闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3254,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉寄恕中韫禅师","author":"丁鹤年","text":"曾向名山识异人，心如木石气如春。\n坐禅霜叶秋埋膝，行道天花日绕身。\n有钵相传元是幻，无锥可著本非贫。\n惟馀潭底中秋月，对写龙峰面目真。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3255,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"悼湖心寺壁东文上人","author":"丁鹤年","text":"祗林一叶陨秋霜，回首沧洲泪两行。\n几上残经尘已暗，箧中遗稿墨犹香。\n云迷圆泽三生石，月冷维摩十笏房。\n想像清容何处记，寒梅的的竹苍苍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3256,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山居诗三首呈诸道侣 其二","author":"丁鹤年","text":"日日看山眼倍明，更无一事可关情。\n扫开积雪岩前走，领取閒云陇上行。\n不共羽人谈太易，懒从衲子话无生。\n划然时发苏门啸，遥答风声及水声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3257,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山居诗三首呈诸道侣 其三","author":"丁鹤年","text":"懒散形骸不自持，黄冠聊束鬓边丝。\n频来猿鹤浑相识，久混龙蛇竟不知。\n养拙最宜情澹泊，全生深藉德支离。\n看云本自忘饥渴，况有冰泉与石芝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3258,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"逃禅室解嘲","author":"丁鹤年","text":"久慕陶公卧北窗，还从马祖吸西江。\n扫愁那用千金帚，折幔惟瞻七宝幢。\n日晏捲帘延叠嶂，雨晴欹枕听流淙。\n周妻何肉俱无累，祗有诗魔老未降。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3259,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜宿染上人溪舍","author":"丁鹤年","text":"云去禅关户牖空，清溪碧树有无中。\n倒涵天影鱼吞月，逆战秋声犬吠风。\n见性本图先作佛，劳形翻愧早成翁。\n杜陵老去归无计，来往那辞恼赞公。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3260,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"兀兀","author":"丁鹤年","text":"数茎白发镜中新，兀兀穷年愧此身。\n万里云霄双倦翼，千寻江汉一穷鳞。\n望乡薄暮凭西日，去国中宵礼北辰。\n客路渐遥身渐老，此生何以报君亲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3261,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"劳劳","author":"丁鹤年","text":"阊阖排云事已休，劳劳犹耻为身谋。\n数茎白发未为老，一寸丹心都是愁。\n燕代地高山北峙，荆扬天阔水东流。\n英雄已去空形胜，剑气中宵射斗牛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3262,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"兵后还武昌二首 其一","author":"丁鹤年","text":"避乱移家大海隈，楚云湘月首频回。\n归期实误王孙草，远信虚凭驿使梅。\n天地无情时屡改，江山有待我重来。\n白头哀怨知多少，欲赋惭无庾信才。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3263,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"兵后还武昌二首 其二","author":"丁鹤年","text":"乱后还家两鬓苍，物情人事总堪伤。\n西风古冢游狐兔，落日荒郊卧虎狼。\n五柳久非陶令宅，百花今岂杜陵庄。\n旧游回首都成梦，独数残更坐夜长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3264,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过九江追悼李子威太守","author":"丁鹤年","text":"瓣香遥拜九江城，太守精神日月明。\n叔侄并归忠义传，江山不尽古今情。\n潮回湓浦声犹怒，云起炉峰气未平。\n生死总魁天下士，丈夫端不负科名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3265,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过安庆追悼余文贞公","author":"丁鹤年","text":"将军匹马入舒城，击贼频烦训义兵。\n孝以保家忠徇国，聚而出战散归耕。\n围侔月晕全无隙，捷振天威大有声。\n游说飞书徒间谍，输诚仗节愈坚贞。\n云梯屡却妖氛豁，露布交驰杀气平。\n千里荆扬凭保障，七年淮海赖澄清。\n山深猰貐歼还出，江阔鲸鲵斩更横。\n外援内储俱断绝，裹疮饮血独支撑。\n天昏苦雾埋营垒，日落阴风卷旆旌。\n甘与张巡为厉鬼，肯同王衍误苍生。\n三千将士皆从死，百二山河亦继倾。\n静对风霆思号令，遥从箕尾识精诚。\n颂碑不愧词臣色，哀诏偏伤圣主情。\n愿为执鞭生不遂，临风三酹重沾缨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3266,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"上明州太守荼子俊","author":"丁鹤年","text":"汉江东抱楚山流，先垄犹馀土一抔。\n庙冷桐乡耆旧逝，田荒栗里子孙愁。\n兵戈隔梦三千里，霜露伤心二十秋。\n荒隧天寒乌鸟下，空林日落白狐游。\n碑焚断石经时变，碗出遗金有夜偷。\n过客尚知来下马，仙人谁复指眠牛。\n拟从樊口迁京口，遥别沙头下石头。\n高士束刍思致奠，故人惠麦久维舟。\n已知多病垂垂老，敢为长贫故故留。\n为政幸逢宗正恕，申情当念子平忧。\n劬劳罔报生何益，存殁沾恩死必酬。\n愿及清明三月节，一盂麦饭洒松楸。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3267,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"敬书宸翰后","author":"丁鹤年","text":"神龙归卧北溟波，愁绝阴山《敕勒歌》。\n惟有遗珠光夺目，万年留得照山河。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3268,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题茀郎天马图","author":"丁鹤年","text":"春明立仗气如山，顾盼俄空十二闲。\n一去瑶池消息断，西风吹影落人间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3269,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"暮春","author":"丁鹤年","text":"杨花榆荚搅晴空，上界春归下界同。\n蜂蝶纷纷竟何在？\n独留杜宇怨残红。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3270,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"暮春二首 其二","author":"丁鹤年","text":"一夕春归遍九垓，千红万紫尽尘埃。\n韶光淑气逡巡退，暑雨炎风烂熳来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3271,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]