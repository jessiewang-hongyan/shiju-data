[{"title":"留别宝林同别峰讲主","author":"张昱","text":"酒船漫尔到山阴，赖有高僧在宝林。\n不信孤鸾临宝镜，更无流水入瑶琴。\n闲吟蝴蝶过邻近，醉击珊瑚坐竹深。\n此去浙江才百里，兴来命驾即相寻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5106,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"留题滴翠轩","author":"张昱","text":"城中买地论黄金，种得琅玕欲千尺。\n月临闲砌白烟生，雾入空林翠光滴。\n长房骑杖龙一枝，子晋吹笙凤双翼。\n曾过门外回酒船，洞庭水深楚山碧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5107,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠李学究","author":"张昱","text":"裒然缝掖更垂绅，见客何曾有怒嗔？\n讲道谁为木铎者，摛词真似玉堂人。\n旧书几帙俱先集，修竹千竿是比邻。\n每向百花时节到，长裾自醉小园春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5108,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重阳日，寄洞霄宫贾道士","author":"张昱","text":"天官侍郎曾寄音，因循秋晚始相寻。\n张良中岁颇好道，贾岛一生成苦吟。\n敢学游山随猛虎，要听捣药试微禽。\n丹泉况说红如酒，好与茱萸一处斟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5109,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"田园居","author":"张昱","text":"早岁归田古所稀，岂同蘧瑗晚知非？\n腊醅尽醉鸬鹚杓，春服仍如薜荔衣。\n一亩园居皆乐土，百年富贵尽危机。\n沙头几动鲈鱼兴，每到花时与愿违。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5110,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"明州倪师园观猿","author":"张昱","text":"捷于风雨过乔枝，乍锁名园亦自疑。\n几万里来都是恨，第三声后最堪悲。\n月沉夜涧魂先去，露滴春梢泪对垂。\n富贵岂能长汝役，绿珠还有堕楼时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5111,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚归","author":"张昱","text":"左掖归时日未斜，小园检校旧生涯。\n染裙萱草才抽叶，破雪樱桃又著花。\n玉斝试斟官给酒，银煎重瀹贡馀茶。\n西湖水色春来好，说道风光似谢家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5112,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪溪船，为李勋赋","author":"张昱","text":"玉山自倒雪溪船，何似长安酒肆眠？\n良夜竹声偏到耳，旧时月色不论钱。\n佳儿出见诗能诵，好客来频榻懒悬。\n更有落梅歌小妾，尽堪陶写尽馀年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5113,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"径山兴圣万岁禅寺之广福庵，乃昙芳忠公道场，其徒统上人居焉。庵前旧有海棠树，洪武三年，结实大如木瓜，五色有香","author":"张昱","text":"尝谓海棠春一梦，却成因果结天葩。\n有同仙客誇桃实，不待诗人赋木瓜。\n龙颔珠今归汝手，锦衣囊合在谁家？\n明年燕子来时候，更与维摩作散花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5114,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"邻园海棠","author":"张昱","text":"自家池馆久荒凉，却过邻园看海棠。\n日色未嫣红锦被，露华犹湿紫罗囊。\n掌中飞燕还能舞，梦里朝云自有香。\n银烛莫辞深夜照，几多佳丽负春光？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5115,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题王维贤东里草堂","author":"张昱","text":"周遭多是及肩墙，马过犹知旧草堂。\n苔径雨晴蝴蝶乱，药栏风暖牡丹香。\n篇诗未觉为时重，杯酒能留共日长。\n岂是辋川无作者，却同裴迪赋山庄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5116,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"慕云庵","author":"张昱","text":"此庵长与此云期，大孝终身有慕之。\n杯棬更无重饮日，板舆安有再乘时？\n行天雨绝皆为泪，落日乌啼总是悲。\n谁刻会稽山下石，悠悠千载白云词。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5117,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题秋江送别图","author":"张昱","text":"故人写出阳关意，都付丹青半幅中。\n霄汉正当鸣凤日，帆樯好趁大鹏风。\n酒斟鹦鹉偏能绿，花赠芙蓉可奈红？\n对此题诗无所属，百年补报是深衷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5118,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄戴山人","author":"张昱","text":"近水斋房自掩扉，若耶溪路客来稀。\n沉浮里闬时将隐，俯仰人生事已非。\n小妾谩歌杨柳曲，高年浑称薜萝衣。\n谁能富与封君等，千亩湖田紫芋肥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5119,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"醉题","author":"张昱","text":"二月莺声最好听，风光终日在湖亭。\n清宵酒压杨花梦，细雨灯深孔雀屏。\n情在绸缪歌白苧，心同慷慨赠青萍。\n方平自得麻姑信，从此人间见客星。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5120,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠朝元宫道士邢本初","author":"张昱","text":"朝元宫里邢道士，神采照人如玉山。\n壶中日月付谈笑，天上风云从往还。\n虎守杏林丹已熟，龙眠秋水剑长闲。\n共传紫气如车盖，往往相随出近关。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5121,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"观雪","author":"张昱","text":"银烛高烧锦瑟停，酒杯如对六花倾。\n清寒未觉貂裘重，小舞偏怜翠袖轻。\n金谷绿珠纷有态，鸿门玉斗碎无声。\n九天散漫随风处，莫是天人欬唾成？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5122,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"筠深轩","author":"张昱","text":"幽居只在平湖上，万竹冥冥不可寻。\n龙化每因风雨过，凤巢都在碧云深。\n人皆到此失炎暑，风忽过之如瑟琴。\n能有此君相晤对，故家何必积黄金？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5123,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晏居，有怀徐一夔教授","author":"张昱","text":"逝者如斯继者谁，遗经独抱可深悲。\n心忘爵禄身方逸，道载文章老始知。\n乳燕试飞华屋静，桐阴初合画帘垂。\n古音最爱朱弦瑟，弹向高堂念别离。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5124,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题孝义诗卷","author":"张昱","text":"可将言行以书绅，淮海维扬见若人。\n慷慨分金存乃叔，艰难返骨葬其亲。\n刺诗杕杜于今废，高冢麒麟自此新。\n俯仰即今无愧怍，平生张掾厚彝伦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5125,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"补赋征云南掾史凯还诗","author":"张昱","text":"大侯秉钺行天讨，戎幕论兵职匪轻。\n势若摧枯狂虏灭，文无加点捷书成。\n日随赤舄纡高步，身附青云致盛名。\n入奏定功应赐爵，班超元是鲁书生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5126,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"水竹居，为诸葛伯安赋","author":"张昱","text":"诸葛南阳有草庐，何如于越此幽居？\n门前修竹画不就，湖上好山清有馀。\n日暮碧云生怅望，天寒翠袖若愁予。\n鲤鱼遗我平安信，尽向琅玕节下书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5127,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"七夕","author":"张昱","text":"七夕佳期自古今，双星有烂夜沉沉。\n可怜乞巧楼前月，曾照长生殿里心。\n鹊引凡情瞻绣户，蝶随秋梦入罗衾。\n斜河已没东方白，露湿幽兰思不禁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5128,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题徐浦墓铭后","author":"张昱","text":"百年人事谩纷纭，觉却南柯梦自分。\n名节不亏惟独行，墓碑无愧是斯文。\n器中瑚琏非虚誉，天上麒麟竟失群。\n高义有谁如季札，愿同留剑挂徐坟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5129,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送都司邵德章之京师","author":"张昱","text":"还记樽前会往年，又看沿檄上朝天。\n青云自此而升矣，白首何堪为黯然？\n剑佩东华深雨露，文章西府盛才贤。\n凤凰池上应多暇，为赋停云慰老颠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5130,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题岳鄂王祠","author":"张昱","text":"落日西湖土一墟，黄泉赤血恨难除。\n开边众许侪韩信，举国浑怜丧子胥。\n廊庙锦文忘版籍，京师黔首望銮舆。\n即今五夜梅花角，吹作南来问信书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5131,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过湖山堂旧基，见杏花","author":"张昱","text":"饮赐黄封未几时，丹青池馆尽荒基。\n何人富贵可长在，自古衰荣更共之。\n乐事恰如春梦觉，狂情惟有杏花知。\n醉翁莫说当时醉，团扇题诗忘与谁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5132,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"紫薇楼感事","author":"张昱","text":"太尉当年宴此楼，长绳直欲系清秋。\n隔栏画舫是湖水，捲幔青山见越州。\n叠鼓夜催诸将舞，高灯春照美人愁。\n大夫司马今头白，不独登临感旧游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5133,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自贻","author":"张昱","text":"近年颇觉志倥侗，不复行云入梦中。\n听曲任教弦有误，赋诗何必句能工？\n岂惟走卒知司马，还有滁人识醉翁。\n樊素小蛮俱未遣，几曾虚度百花风？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5134,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"东林","author":"张昱","text":"之子青年独老成，布袍宽博称其名。\n李膺谩自知文举，杨意无能荐长卿。\n每到草堂成酩酊，偶过花径亦逢迎。\n卜邻自觉头加白，转信前贤畏后生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5135,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虎丘寺留题","author":"张昱","text":"莓苔欲遍盘陀石，知是梁朝古道场。\n陈迹谩惊成俯仰，空门元不预兴亡。\n白漫天上俱兵气，赤伏池中是剑光。\n如会生公重说法，劝教东海莫栽桑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5136,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送张丞之汤阴","author":"张昱","text":"试官知在两河间，此别车辕未可攀。\n万树秋风古台路，数峰晴雪太行山。\n瓮头黄酒封春色，叶底红梨染醉颜。\n尽解腰缠供一醉，扬州谁见鹤飞还？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5137,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中夏日","author":"张昱","text":"祸福无门祗自寻，始知明哲愿山林。\n谁能白首儒衣敝，吟对黄鹂夏木深。\n赖有故书堪寓目，已无官事可婴心。\n凉风满扇清樽在，只此人生直万金。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5138,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"录家人语","author":"张昱","text":"镜里霜毛已上颠，五千言以退为先。\n到家访旧俱为鬼，有地投闲即是仙。\n夜雨满樽仪狄酒，春风小幅薛涛笺。\n谢家诸婢犹前日，八翼无烦更梦天。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5139,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感事","author":"张昱","text":"忆昔银灯鼓瑟琴，屏开孔雀画堂深。\n头颅谩有新添雪，囊橐都无旧赐金。\n好梦未成春漏尽，残星犹在晓河沉。\n郎君自上斑骓从，露满铜盘泪不禁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5140,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题苏西坡编修自撰墓志后","author":"张昱","text":"笑傲中吴岂问津，风流自拟雪堂人。\n白头已了浮生事，黄土真埋不死身。\n江上鹤飞前日梦，门前花散去年春。\n汉家政尔论封禅，知有遗书献紫宸。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5141,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"笼鹤","author":"张昱","text":"轩然羽翼更何之，每见云霄忆旧时。\n鸣候露华生玉树，舞怜雪影散瑶池。\n垂头就食诚何报，侧目随人祗自悲。\n恩重主家看养别，不教鹅鸭混阶墀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5142,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"囊琴","author":"张昱","text":"钟期何在铸黄金，胶漆相投日以深。\n妙制偶经雷氏手，虚名已说蔡家琴。\n千年流水高山趣，一旦离鸾别鹤吟。\n尘满敝弦虽未试，不弹还自有知音。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5143,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"京城得家书，题示儿子同同","author":"张昱","text":"苏郎不是饮中仙，只好长斋绣佛前。\n蝶到枕边身是梦，花随春去日如年。\n芙蓉别馆还依旧，鹦鹉小窗殊可怜。\n纵得归来城郭在，铜驼露冷湿荒烟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5144,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄松江杨维桢儒司","author":"张昱","text":"画蛇饮酒合谁先，尘土东华四十年。\n海上岂无诗可和，云间还有事相牵。\n牡丹开后春无力，燕子归来事可怜。\n欲倩铁龙吹一曲，满湖风浪又回船。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5145,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梦梅花处，为董师程赋","author":"张昱","text":"江南枕上见梅花，一片寒光接素霞。\n蝶化梦魂云缥缈，香生肝肺雪槎枒。\n乃知姑射仙人宅，即是林逋处士家。\n白玉堂深帘幕静，画成疏影在窗纱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5146,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"中酒","author":"张昱","text":"连日醉头扶不起，记曾有说酒能医。\n知伤肺气终为患，不典春衣亦是痴。\n小阁留僧看斗茗，矮床对雨教弹棋。\n馀年有甚唐人癖，稍得闲情便赋诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5147,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄韶州知府金鉴","author":"张昱","text":"自君领郡韶州去，鸿雁天涯两送秋。\n盛气不题鹦鹉赋，高怀应倚仲宣楼。\n蹇予滞迹犹沧海，之子劳形欲白头。\n钟乳囊封能远寄，暮年此外更何求？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5148,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"碧筒饮，次胡丞韵二首 其一","author":"张昱","text":"小刺攒攒绿满茎，看揎罗袖护轻盈。\n分司御史心先醉，多病相如渴又生。\n银浦流云虽有态，铜盘清露寂无声。\n当年欲博千金笑，故作风荷带雨倾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5149,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"碧筒饮，次胡丞韵二首 其二","author":"张昱","text":"花外风来香满湖，折荷举酒笑相呼。\n自来四明有狂客，除却高阳非酒徒。\n饮处有情丝不断，折时多刺手难扶。\n豪家玉斗虽云贵，有此尊前风致无？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5150,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送丁道士还澧陵","author":"张昱","text":"丁令还家骨已仙，更无城郭有山川。\n未添白发三千丈，又见铜驼五百年。\n荒草茫茫连故国，孤云冉冉下寥天。\n澧兰歌送潺湲水，极望涔阳思惘然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5151,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题古禅上人房","author":"张昱","text":"一染昙花百念空，净香吹遍古禅风。\n钩帘燕雨时时过，洗钵鱼波处处通。\n鸡有佛缘曾听法，桧因宝界渐成龙。\n三生谁识苏居士，惟是盐官北寺钟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5152,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄孟昉郎中","author":"张昱","text":"孟子能文自老成，早于国语亦留情。\n省中醉墨题犹在，阙下新知谁与行？\n纨扇晚凉诗自写，翠鬟情重酒同倾。\n接舆莫更闲歌凤，只可佯狂了此生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5153,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄周昉处士","author":"张昱","text":"为尔停骖几叩门，每于清事得相论。\n山中载酒梅花过，湖上放船春水浑。\n闲到竹斋为解带，坐深苔径与开樽。\n当年醉墨留题处，风雨新添屋漏痕。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5154,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题福源编后","author":"张昱","text":"福缘山作魏家坟，知是唐朝宰相孙。\n石首令前官有考，咸通年内碣犹存。\n太湖渺渺连精舍，乔木阴阴拱墓门。\n千载凌烟勋业在，可无遗泽及诸昆？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5155,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谩游","author":"张昱","text":"甚矣吾衰百念慵，花间时一复支筇。\n邦人幸尔不予鄙，儿子乐然为我从。\n载酒有时寻古寺，看云终日对孤峰。\n林家湖上都能说，二十馀年老醉翁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5156,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"月桂堂，为集庆讲主","author":"张昱","text":"佛国山中古道场，月中桂子散天香。\n一枝得共人如郤，双井能来客姓黄。\n谁咏碧云题树叶，自收清露染衣裳。\n南峰不与清光碍，好放馀阴及四方。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5157,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日，过长安镇王山人","author":"张昱","text":"因过王生忘坐久，阶前花有白鸡冠。\n草堂出酒生新敬，雪壁题诗寄此观。\n肯谓陶潜逢九日，却如李白醉长安。\n老夫遍赏东篱菊，摇落群芳正耐看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5158,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"归隐图，为张别驾赋","author":"张昱","text":"难得归来赋考槃，高情都付画图看。\n可能白首更干禄，纵有黄金难买闲。\n酒舫载春携二客，巾车乘醉从双鬟。\n陶山地接东西眺，谢傅风流或可攀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5159,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宗阳宫，次杨仲弘老君台观月诗韵","author":"张昱","text":"当时诸老宗阳会，月与浮云几变更？\n丁令岂知为鹤事，道人犹作卖花声。\n天溥露色开蟾境，秋送商声入凤笙。\n谁信紫薇垣内客，今宵又复到蓬瀛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5160,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送康穆庵赴福州能仁寺席","author":"张昱","text":"佛运兴隆此一机，尊师何负七条衣？\n讲经春殿人天卫，咒钵夜堂风雨归。\n花为散来春冉冉，柳从攀后思依依。\n幽兰荔子南方物，笼护函封寄莫稀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5161,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"病起","author":"张昱","text":"花事能消几夜风，樱桃叶底又深红。\n岂无金缕湖波上，闲却玉杯春雨中。\n枕上楚云元是梦，镜中潘鬓惜成翁。\n莫言轻薄扬州事，著意题诗也未工。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5162,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题云林隐居图，为崔彦晖赋","author":"张昱","text":"崔郎志趣在云林，笔底遥岑自浅深。\n欹枕不忘图画事，开函又动隐居心。\n粉痕白白生云气，黛色沉沉覆树阴。\n幽思不教忘梦寐，耳边长似有猿吟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5163,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"留题费山人旧馆","author":"张昱","text":"旧馆经过不用期，扫门常恐鹤来迟。\n但知重客唯司马，不顾狂言有牧之。\n秋雨石枰看对弈，夜堂银烛照题诗。\n佳人底用千金产，只此高闲可不知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5164,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"经锄斋","author":"张昱","text":"谁似谈翁乐有馀，百年生计祇林庐。\n甫田种熟门前稻，暇日抄成架上书。\n睡起谩怜衰甚矣，客来唯问近何如？\n相过里社寻常事，只把柴车当酒车。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5165,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谢宝林寺别峰法师惠僧履","author":"张昱","text":"也知鳗井犹龙井，合有交游似二苏。\n起舞谩怜成短袖，徒行始觉是穷途。\n书从堂上出双鲤，舄向云中堕匹凫。\n无复旧时公府步，君门望绝没阶趋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5166,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]