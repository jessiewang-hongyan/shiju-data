[{"title":"题纸瓶，留别育王寺长老照大千","author":"张昱","text":"朝市山林自一家，要知逢掖即袈裟。\n青蘋波上凉风起，定到禅房看蕙花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5499,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题剡溪夜雪图","author":"张昱","text":"雪月相邀过剡川，芙蓉远近玉生烟。\n戴家亭馆多风致，只好到门回酒船。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5500,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题二马图二首 其一","author":"张昱","text":"卸却银鞍得自由，偶因鬉痒一回头。\n青丝几尺无拘束，曾控风云遍九州。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5501,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题二马图二首 其二","author":"张昱","text":"春明仰首一长嘶，莫说河冰迸玉蹄。\n曾与将军同患难，等闲平步到檀溪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5502,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江南曲二首 其一","author":"张昱","text":"阿姊却从何处来，芙蓉有露湿香腮。\n相呼相应棹船去，知是邻家斗鸭回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5503,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江南曲二首 其二","author":"张昱","text":"一束莲茎学细腰，涂金艇子木兰桡。\n东家姊妹西家去，更约明朝去看潮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5504,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠琴士","author":"张昱","text":"万树流莺御苑西，朝回骑马醉如泥。\n如今都向山堂宿，听得琴中乌夜啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5505,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"小游仙，次韵四首 其一","author":"张昱","text":"汉武求仙未绝情，枉将心力事金茎。\n灵王太子因无欲，吹得琅玕作凤鸣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5506,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"小游仙，次韵四首 其二","author":"张昱","text":"桂閤金银不甚高，仙山几许隔波涛？\n信回青鸟无寻处，一色春风是绛桃。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5507,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"小游仙，次韵四首 其三","author":"张昱","text":"小娃莫说脸如莲，自牧羊龙向葑田。\n笑指清泠桥下水，此中元是碧瑶天。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5508,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"小游仙，次韵四首 其四","author":"张昱","text":"青蛇昨夜付书回，只许麻姑自拆开。\n说道蓬莱山下路，莫因清浅不归来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5509,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题鹦鹉仕女图","author":"张昱","text":"美人应自惜年华，庭院沈沈锁暮霞。\n祇有旧时鹦鹉见，春衫曾似石榴花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5510,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题露荷风柳扇面二首 其一","author":"张昱","text":"犹恐丹砂染未匀，波中影是镜中身。\n长眉画向春风里，不许人间更效颦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5511,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题露荷风柳扇面二首 其二","author":"张昱","text":"此扇当年定赐谁，泪痕犹自旧胭脂。\n班姬莫用闲相咏，次第凉风到汝吹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5512,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夕","author":"张昱","text":"紫藤满架月华明，一片凉风络纬声。\n犹有西江未归客，倚船因尔动离情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5513,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过泖湖","author":"张昱","text":"泖湖有路接天津，万顷银花小浪匀。\n安得满船都是酒，船中更载浣纱人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5514,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过金粟寺看东坡竹","author":"张昱","text":"东坡仙去三百载，海上犹存丹凤巢。\n醉里自将衫袖下，拂开尘壁看烟梢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5515,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题凝思士女","author":"张昱","text":"萱草花开一两枝，薰风更是断肠时。\n自家团扇无心把，想得回文织锦诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5516,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题卢媪家二首 其一","author":"张昱","text":"谁似褚庄卢媪家，开门绕屋是荷花。\n收来麦把云成垛，缫动蚕丝雪满车。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5517,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题卢媪家二首 其二","author":"张昱","text":"船坊小小柳依依，田舍人家尽自肥。\n溪水受阴鱼出跃，薰风吹暑燕交飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5518,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过萧山县","author":"张昱","text":"原野萧条井邑虚，居人都是劫灰馀。\n桥边犹有江淹寺，不为题诗驻使车。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5519,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题吴綵鸾写韵图","author":"张昱","text":"小点红鸾欲下迟，远山浑似画来眉。\n如何一念人间事，上界仙曹便得知？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5520,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"同徐大章溪上看芙蓉","author":"张昱","text":"日暮归来雨湿衣，凉风千树綵云飞。\n渚宫只在秋江上，何事襄王梦到稀？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5521,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宫词，次周员外韵","author":"张昱","text":"时样宫眉不甚长，再三笑语问同房。\n内园有约看花去，称得春衫绣凤凰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5522,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题左司壁","author":"张昱","text":"省中莫说文书简，开遍杏花浑不知。\n今日树边骑马过，满衣春雨立多时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5523,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题毛女","author":"张昱","text":"一钁长随玉雪身，女中还有烂柯人。\n相逢好向麻姑说，东海千年又化尘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5524,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题东坡竹","author":"张昱","text":"三百馀年屈指过，犹于遗墨见东坡。\n虽然数尺黄州竹，写出参天直节多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5525,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题苏小小像","author":"张昱","text":"湖上行云逐步移，手携团扇欲何之？\n鬓边莫笑闲花草，也是当时第一枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5526,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题蜻蜓蛱蝶画扇","author":"张昱","text":"点水穿花不自疑，轻盈满扇欲何之？\n柳塘一觉风流梦，又是秋香欲老时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5527,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"观弈图，为杨左丞题","author":"张昱","text":"局中胜负几回新，画在丹青亦损神。\n莫把等闲消岁月，旁观都是下棋人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5528,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"求仙辞二首 其一","author":"张昱","text":"汉皇承露铸金茎，别道云间有玉京。\n万乘旌旗不随去，此身何用独长生？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5529,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"求仙辞二首 其二","author":"张昱","text":"不见王乔驭鹤还，祇应憔悴老空山。\n何如修取金仙法，灭尽空花出世间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5530,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"荷花词，次韵周伯温参政四首 其一","author":"张昱","text":"朝霞染得好衣裳，吹遍湖头风露香。\n身分可怜年纪小，纤腰一束郁金黄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5531,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"荷花词，次韵周伯温参政四首 其二","author":"张昱","text":"少年惯服白朱砂，养得容颜故似霞。\n生长六桥杨柳岸，不知湖水是侬家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5532,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"荷花词，次韵周伯温参政四首 其三","author":"张昱","text":"莫讶吴侬说靓妆，红绡贴体肉生香。\n夜来相伴绿荷叶，受用满湖风露凉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5533,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"荷花词，次韵周伯温参政四首 其四","author":"张昱","text":"一种西湖与若耶，鸳鸯宿处便为家。\n秋房结得新莲子，便是当时藕上花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5534,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"上元夫人词","author":"张昱","text":"阿母亲曾与制衣，手攀云锦下天机。\n自从宴罢茅君后，寂寞龟坛会更稀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5535,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"瘦马","author":"张昱","text":"少尽其力老弃之，此岂有意埋敝帷？\n不如汗血阵前死，以革就裹将军尸。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5536,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柳枝词二首 其一","author":"张昱","text":"尊前不弃小腰身，争欲搀先上舞茵。\n多谢东风好抬举，尽情分付画眉人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5537,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柳枝词二首 其二","author":"张昱","text":"春光领略不胜娇，摇荡东风千万条。\n悔尽江州白司马，一生空咏小蛮腰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5538,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"折柳枝","author":"张昱","text":"愁向尊前唱渭城，柳枝折尽赠人行。\n早知世路多离别，移在邮亭远处生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5539,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐天宝宫词十五首 其一","author":"张昱","text":"寿王妃子在青春，赐与黄冠号太真。\n不是白头高力士，翠华那得远蒙尘？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5540,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐天宝宫词十五首 其二","author":"张昱","text":"彻夜宫中按羽衣，明朝册拜太真妃。\n凤凰阁里承恩后，从此君王出内稀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5541,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐天宝宫词十五首 其三","author":"张昱","text":"兴庆池头芍药开，贵妃步辇看花来。\n可怜三首清平调，不博西凉酒一杯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5542,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐天宝宫词十五首 其四","author":"张昱","text":"清源小殿合凉州，羯鼓琵琶响未休。\n为是阿瞒供乐籍，八姨多费锦缠头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5543,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐天宝宫词十五首 其五","author":"张昱","text":"蓬莱前殿摘黄柑，一色金盘赐内官。\n拣得枝头合欢实，画图传与大家看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5544,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐天宝宫词十五首 其六","author":"张昱","text":"玉笛当年是赐谁，可教妃子得偷吹。\n还家剪下青丝发，持谢君王意可知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5545,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐天宝宫词十五首 其七","author":"张昱","text":"天子楼前百戏陈，大娘竿舞最惊人。\n贵妃独赏刘郎咏，牙笏罗袍色色新。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5546,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐天宝宫词十五首 其八","author":"张昱","text":"舁上儿绷满翠容，黄裙高髻一丛丛。\n君王入内闻欢笑，赐与金钱满六宫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5547,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐天宝宫词十五首 其九","author":"张昱","text":"四海承平倦万机，只将彩戏悦真妃。\n不平最是弹双陆，骰子公然得赐绯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5548,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐天宝宫词十五首 其十","author":"张昱","text":"小部梨园出教坊，曲名新赐荔枝香。\n霓裳按舞长生殿，击碎梧桐夜未央。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5549,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐天宝宫词十五首 其十一","author":"张昱","text":"共指双星出殿迟，并肩私语有谁知？\n君王未出长安日，肯信人间有别离？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5550,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐天宝宫词十五首 其十二","author":"张昱","text":"香囊遗下佛堂阶，不使君王不怆怀。\n想著当年雪衣女，羽衣犹得苑中埋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5551,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐天宝宫词十五首 其十三","author":"张昱","text":"勤政楼中夜正长，上皇西望转凄凉。\n侍儿惟有红桃在，一曲凉州泪万行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5552,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐天宝宫词十五首 其十四","author":"张昱","text":"龙女殷勤道姓名，淩波池上乞新声。\n周公不入君王梦，谁与苍生致太平？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5553,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐天宝宫词十五首 其十五","author":"张昱","text":"天宝年间宠贾昌，黄衫年少满鸡坊。\n绛冠斗罢罗缠项，又得君王笑一场。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5554,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"趋府","author":"张昱","text":"燕子梁间渐有声，碧油窗外未天明。\n长街官树留残月，满马好风吹宿酲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5555,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"小寒","author":"张昱","text":"花外东风作小寒，轻红淡白满阑干。\n春光不与人怜惜，留得清明伴牡丹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5556,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"凉思","author":"张昱","text":"朝来风雨怯轻罗，便觉凉秋意思多。\n一夜不眠联翠被，馀香消尽满池荷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5557,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"觉来","author":"张昱","text":"好风吹雨觉来迟，开遍荼蘼总不知。\n团扇晚凉人似玉，也须消瘦暮春时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5558,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春光","author":"张昱","text":"湖上偏多杨柳风，桃花吹尽雨前红。\n等闲却被东君笑，大半春光在醉中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5559,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柳花词五首 其一","author":"张昱","text":"望穷河水是隋家，风落长堤御柳斜。\n春尽花飞留不住，白头啼遍后栖鸦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5560,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柳花词五首 其二","author":"张昱","text":"栏马墙西欲暮春，花飞不复过中旬。\n倚天楼阁晴光里，争扑珠帘不避人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5561,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柳花词五首 其三","author":"张昱","text":"章华台下路西东，走马归来满袖风。\n吹起万条枝上雪，等闲迷却细腰宫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5562,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柳花词五首 其四","author":"张昱","text":"满院长条散绿阴，谁家门户碧沈沈？\n地衣不许重帘隔，雪白花铺一寸深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5563,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柳花词五首 其五","author":"张昱","text":"扬州寺前杨柳多，柳枝能舞更能歌。\n夜来吹入维摩室，化作天花可奈何！","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5564,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"孟院判宅辞饮","author":"张昱","text":"病来酒力未能加，易觉衰容染绛霞。\n团扇凉风吾欲睡，不劳频看石榴花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5565,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其一","author":"张昱","text":"黄金大殿万斯年，十二丹楹日月边。\n伞盖威蕤当御榻，珠光照耀九重天。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5566,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其二","author":"张昱","text":"五垓千陛立朝廷，槛首铜雕一丈翎。\n不待来仪威凤至，日闻韶濩在青冥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5567,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其三","author":"张昱","text":"州桥拜伏两珉龙，向下天潢一派通。\n四海仰瞻天子气，日行黄道贯当中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5568,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其四","author":"张昱","text":"方朝犹是未明天，玉戚轮竿已俨然。\n百兽蹲威绘幡下，万臣效职内门前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5569,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其五","author":"张昱","text":"东楼绯服唱鸡人，击到朱鼙第几声？\n楠寐奉常先告备，驾行三叩紫鞘鸣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5570,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其六","author":"张昱","text":"至元典礼当朝会，宗戚前将祖训开。\n圣子神孙千万世，俾知大业此中来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5571,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其七","author":"张昱","text":"二九行分正从班，尽将牙笏注名单。\n簟铺兽镇丹墀内，鹄立千官绕画阑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5572,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]