[{"title":"用前韵序山家幽寂之趣呈前人十首 其四","author":"叶颙","text":"春风绿尽江南草，夜雨红销树底花。\n独立斜阳多少恨，长空捲散暮天霞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5996,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"用前韵序山家幽寂之趣呈前人十首 其五","author":"叶颙","text":"兴来浩饮渊明酒，醉后豪吟太白诗。\n独坐独行芳草地，半晴半雨落花时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5997,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"用前韵序山家幽寂之趣呈前人十首 其六","author":"叶颙","text":"闲中采药云边去，倦后扶筇花下归。\n几度吹箫陪好月，数番横笛送斜晖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5998,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"用前韵序山家幽寂之趣呈前人十首 其七","author":"叶颙","text":"蜂蝶渐慵春渐老，诗辞频和酒频斟。\n年来深识山中趣，老去全无世上心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5999,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"用前韵序山家幽寂之趣呈前人十首 其八","author":"叶颙","text":"云舒山色千峰秀，雨过蛙声两部鸣。\n多谢知心峰顶月，夜深常到寝床明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6000,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"用前韵序山家幽寂之趣呈前人十首 其九","author":"叶颙","text":"抠衣稳坐栖云石，洗耳闲听漱竹泉。\n夜半有时长见月，人间无梦去朝天。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6001,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"用前韵序山家幽寂之趣呈前人十首 其十","author":"叶颙","text":"一任猿惊野鹤猜，老怀笑口要频开。\n高眠蕙帐春风暖，不怕雷声入枕来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6002,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"人或问予云?旧隐尚无恙者赋一绝答之","author":"叶颙","text":"瘦竹长松小径花，故园泉石锁烟霞。\n白云无恙青松老，依旧山中宰相家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6003,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠画史王玉峰","author":"叶颙","text":"百顷风烟生昼寒，万山重叠起豪端。\n前身莫是王摩诘，画出娥眉拥翠鬟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6004,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题王寿卿烟云叠嶂图","author":"叶颙","text":"断岫平山点画粗，岚光浓淡有如无。\n何时直到群峰顶，万叠云烟一老夫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6005,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠写真张小峰二首 其一","author":"叶颙","text":"饱历风霜骨格粗，老来渐觉发毛枯。\n形容妍丑从君画，画得平生执拗无。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6006,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠写真张小峰二首 其二","author":"叶颙","text":"古貌清如雪后松，吟肩瘦似雨馀峰。\n莫将山上耕云叟，错拟岩前板筑翁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6007,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登楼闻笛有感 其一","author":"叶颙","text":"笛声吹起白云秋，两袖天风独倚楼。\n北望中原何处是，落霞孤鹜古今愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6008,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登楼闻笛有感 其二","author":"叶颙","text":"一声长笛夕阳楼，总是关山旧日愁。\n杳杳山青云尽处，澹烟衰草不胜秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6009,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题赤壁图","author":"叶颙","text":"曹公智计世无双，席捲南来孰敢当。\n浊浪翻江迷赤壁，谁知犹有一周郎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6010,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读宋纪","author":"叶颙","text":"显德衰微国祚迁，儿孤母寡足堪怜。\n如何宋主迎□□，□□□□□□□。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6011,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和李本存孤字韵 其一","author":"叶颙","text":"夕阳山塞笛声孤，半醉辕门语笑粗。\n旧日读书萧寺月，夜深曾到帐前无。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6012,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和李本存孤字韵 其二","author":"叶颙","text":"瘦耸吟肩野鹤孤，衣冠山野礼容粗。\n政惭声誉非君比，却喜功名入梦无。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6013,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和李本存孤字韵 其三","author":"叶颙","text":"月冷霜寒老将孤，北风吹雪势还粗。\n方今四海皆元济，未信忠刚李愬无。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6014,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和李本存孤字韵 其四","author":"叶颙","text":"清比梅花带雪孤，吟腰瘦减十围粗。\n约君净扫南山石，共坐云边话有无。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6015,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和李本存孤字韵 其五","author":"叶颙","text":"老首频搔鬓影孤，惜无三尺斩顽粗。\n何当略借天风便，为扫妖氛半点无。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6016,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和李本存孤字韵 其六","author":"叶颙","text":"孙刘何苦各称孤，想是当年计画粗。\n若使尽忠扶汉祚，坐观曹魏眼中无。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6017,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春初即事","author":"叶颙","text":"怕寒犹自怯罗裳，嫩柳偷春浅试黄。\n青草已生诗未就，阿连无梦绕池塘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6018,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"李本存叠有和章再和孤字韵二首 其一","author":"叶颙","text":"撚须索句兴怀孤，信手围棋著数粗。\n病酒风情愁后减，惜花春梦老来无。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6019,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"李本存叠有和章再和孤字韵二首 其二","author":"叶颙","text":"新诗清侣玉蟾孤，意度安闲细不粗。\n岛瘦郊寒元白俗，开元之后晚唐无。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6020,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题李克明翁媪起家图二首（一翁以指就醋瓮内取醯吮之尝其味之美恶一媪持星火吹灯备诸穷态） 其一","author":"叶颙","text":"阿婆吹火燄光寒，老叟尝醯气味酸。\n后代儿孙宁识此，高烧银烛照杯盘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6021,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题李克明翁媪起家图二首（一翁以指就醋瓮内取醯吮之尝其味之美恶一媪持星火吹灯备诸穷态） 其二","author":"叶颙","text":"小瓮吮醯酸透骨，寒缸吹焰火烧眉。\n何时翁媪花灯下，珠翠成行捧玉卮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6022,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题静斋手卷","author":"叶颙","text":"云凝不动青山老，花落无声白昼闲。\n松影半窗清睡醒，卧看流水夕阳间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6023,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丙申大旱呈时官二首 其一","author":"叶颙","text":"雷久无声电敛光，老龙何地密韬藏。\n只愁遂失苍生望，何不留心济四方。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6024,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丙申大旱呈时官二首 其二","author":"叶颙","text":"自夏经秋百日晴，更兼无处不戈兵。\n千畴万亩乾枯尽，留得衰荷听雨声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6025,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"冬夜梅边即事","author":"叶颙","text":"罗浮山下白云深，一枕师雄梦未成。\n残雪初消明月上，东风吹彻玉箫声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6026,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"冬夜闻笛出入韵","author":"叶颙","text":"午夜谁将玉笛吹，白云满地湿难飞。\n惊回一枕春风梦，月上花梢最好枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6027,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"初夕暑退生凉","author":"叶颙","text":"溽暑初收生暮凉，风将秋信入虚堂。\n芙蓉峰顶夜来雨，溪水新添二尺强。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6028,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"霜天晓角","author":"叶颙","text":"耿耿星河曙欲流，角声悲壮起层楼。\n满江明月青霜重，人与梅花一样愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6029,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花分韵得诗字","author":"叶颙","text":"木萼霜葩带雪枝，月中香影最清奇。\n林逋去后东坡死，近日江南未有诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6030,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读宋徽宗北狩龙沙赋忍听羌笛吹落梅花乐府","author":"叶颙","text":"一声羌笛咽龙沙，万里燕云独梦家。\n吹入中原都是恨，如何只怕《落梅花》。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6031,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日午窗睡起","author":"叶颙","text":"日移花影转帘西，风撼松阴落研池。\n好鸟不鸣芳昼寂，午窗清梦醒来时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6032,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题石勒参佛图澄手卷六首 其一","author":"叶颙","text":"石勒亡宗怨季龙，虎于冉闵恨何穷。\n佛图果有仙人见，盍把深机悟二公。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6033,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题石勒参佛图澄手卷六首 其二","author":"叶颙","text":"刘曜成擒一语中，沤麻老秃亦英雄。\n可怜只办平常事，忘却中原逐鹿功。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6034,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题石勒参佛图澄手卷六首 其三","author":"叶颙","text":"何须倾意扣图澄，眼见狂刘一鼓擒。\n绝胜沤麻池水上，老拳毒手日相寻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6035,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题石勒参佛图澄手卷六首 其四","author":"叶颙","text":"推恩忘怨沤麻池，便是刘郎就缚时。\n成败当年人尽识，未应惟有一僧知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6036,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题石勒参佛图澄手卷六首 其五","author":"叶颙","text":"擒刘奇策算无遗，石氏存亡必已知。\n三十六孙同日死，佛图何不预言之。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6037,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题石勒参佛图澄手卷六首 其六","author":"叶颙","text":"东门倚啸声音远，西域参陪礼义专。\n折节李阳吾未论，并驱光武孰先鞭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6038,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春雨晚霁","author":"叶颙","text":"东风吹雨作丝轻，驾勒馀寒放晚晴。\n满地湿云收未尽，一帘花影不分明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6039,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽齐夜坐效山人体","author":"叶颙","text":"一邱一壑白云深，一笛秋风一曲琴。\n夜半一窗明月色，一杯松露洗予心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6040,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚酌山家即事","author":"叶颙","text":"浊醪初熟正鸡肥，野老冲烟跨犊归。\n漉酒烹鸡成小酌，醉眠忘却脱蓑衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6041,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠山翁二首 其一","author":"叶颙","text":"草庐深寄夕阳村，世路荣枯久不闻。\n二亩石田耕垦罢，又骑黄犊入云深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6042,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠山翁二首 其二","author":"叶颙","text":"古貌虬髯鹤发翁，醉吹长笛卧高峰。\n不知胸次藏何物，鼓舞春风宇宙中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6043,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西子捧心图","author":"叶颙","text":"员也捐躯死谏君，越王尝胆恨尤深。\n西施亦解忧人国，尽日攒眉痛捧心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6044,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读荆轲传","author":"叶颙","text":"壮士西游遂不还，英雄千古笑燕丹。\n至今幽蓟秋风道，依旧萧萧易水寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6045,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"磻溪钓图二首 其一","author":"叶颙","text":"渭水风生两鬓秋，平生意在钓吞舟。\n如何八百封侯国，也逐鲸鱼竞上钩。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6046,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"磻溪钓图二首 其二","author":"叶颙","text":"白发荒凉钓渭滨，宅心非是为金鳞。\n不知丝线长多少，牵掣江山八百春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6047,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题伍子胥传后","author":"叶颙","text":"子胥忠孝两难偕，破楚鞭君谢父奢。\n何事危言强谏日，死无贤嗣挞夫差。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6048,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题三杰四首 其一 萧何之一","author":"叶颙","text":"匹马追亡古道傍，便知韩信世无双。\n筑坛不用萧侯语，垓下焉能灭楚王。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6049,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题三杰四首 其二 萧何之二","author":"叶颙","text":"独收相府旧图书，形势高低尽得知。\n镇抚关中成帝业，沛公马上岂能为。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6050,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题三杰四首 其三 韩信","author":"叶颙","text":"刘项存亡指顾中，君臣未定各称雄。\n早知鸟尽弓无用，未必殷勤谢蒯通。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6051,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题三杰四首 其四 良","author":"叶颙","text":"一击秦车水逆流，当年锐志复韩雠。\n偶因天地风云合，扶立炎刘四百秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6052,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"冬景十绝（李从道丽泽诗社出题至治己未至己亥四十年矣） 其一 鹭立寒江","author":"叶颙","text":"青苔白石鱼鳞腥，尽日独拳寒雨汀。\n疑是晴江沙上雪，黄昏一点不分明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6053,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"冬景十绝（李从道丽泽诗社出题至治己未至己亥四十年矣） 其二 寒江独钓","author":"叶颙","text":"扁舟独钓烟茫茫，醉著蓑衣不耐霜。\n最是月明无伴侣，一声渔笛出沧浪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6054,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"冬景十绝（李从道丽泽诗社出题至治己未至己亥四十年矣） 其三 霜天晓角","author":"叶颙","text":"城上征人吹角声，月寒霜重声冥冥。\n孤舟万里南迁客，起著衣裳带梦听。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6055,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"冬景十绝（李从道丽泽诗社出题至治己未至己亥四十年矣） 其四 江路梅香","author":"叶颙","text":"漠漠江云路不分，小桥流水夕阳村。\n唫翁马上频回首，一阵东风暗断魂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6056,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"冬景十绝（李从道丽泽诗社出题至治己未至己亥四十年矣） 其五 板桥霜晓","author":"叶颙","text":"月中青女下瑶空，潋滟寒波跨玉龙。\n画角一声天未晓，前村梅下有吟翁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6057,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"冬景十绝（李从道丽泽诗社出题至治己未至己亥四十年矣） 其六 茅檐曝背","author":"叶颙","text":"门外三竿红日迟，向阳花木暂熙熙。\n老翁曝背亭前坐，自取经书教小儿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6058,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"冬景十绝（李从道丽泽诗社出题至治己未至己亥四十年矣） 其七 书舍寒灯","author":"叶颙","text":"青灯黄卷伴更长，花落银缸午夜香。\n异日长檠珠翠里，苦心寒燄莫相忘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6059,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"冬景十绝（李从道丽泽诗社出题至治己未至己亥四十年矣） 其八 梅下清吟","author":"叶颙","text":"吟肩瘦耸白云根，兴绕孤山水竹村。\n月上南枝诗未就，暗香疏影又黄昏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6060,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"冬景十绝（李从道丽泽诗社出题至治己未至己亥四十年矣） 其九 纸帐梅花","author":"叶颙","text":"销金帐暖酒盈觞，醒后依前世虑长。\n何似白云深处卧，春风一枕梦魂香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6061,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"冬景十绝（李从道丽泽诗社出题至治己未至己亥四十年矣） 其十 烟蓑钓雪","author":"叶颙","text":"万顷玻璃失钓矶，白云片片补蓑衣。\n鸟声断绝人踪灭，独向芦花月下归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6062,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐武则天传","author":"叶颙","text":"天人共愤世皆嫌，垂拱焉能二十年。\n谁信裙钗珠翠侣，反胜冠冕任英贤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6063,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"爆竹二首 其一","author":"叶颙","text":"一声爆竹透云端，惊醒苍生睡不安。\n若使江淮豪杰听，定应惭悚胆先寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6064,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"爆竹二首 其二","author":"叶颙","text":"非尝声响聒天来，鼓动阳春海上回。\n偶尔惊人还寂寂，情知不是武侯雷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6065,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁酉仲冬即景十六首 其一 雪水煎茶","author":"叶颙","text":"枯枝旋拾带冰烧，雪水茶香滚夜涛。\n党氏岂知风韵美，向人犹说饮羊羔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6066,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]