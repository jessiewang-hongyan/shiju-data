[{"title":"游东林寺","author":"蓝智","text":"隔溪兰若有云住，背郭草堂无酒赊。\n秋色琅玕亭外竹，天香薝卜坐中花。\n千年龙象当山殿，八月鲈鱼上钓槎。\n一二老僧皆旧识，松根敲火试春茶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10212,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送京学危提举奉旨代祀文公祠墓加封齐国公","author":"蓝智","text":"圣主崇文礼大贤，儒臣持节过林泉。\n太公旧履山河在，宣父遗经日月悬。\n玉瓒晓分仙掌露，石门晴散御炉烟。\n清朝盛典于今见，勒石名山颂万年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10213,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谢贾参政荐儒职","author":"蓝智","text":"内府黄金铸虎符，彤廷湛露锡宫壶。\n诗书礼乐三军帅，天地风云八阵图。\n盖世才名称耿贾，经邦事业佐唐虞。\n鹰扬更待驱群盗，鹗荐何烦记腐儒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10214,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"吴山怀古","author":"蓝智","text":"南渡山川王气消，西风松柏认前朝。\n紫宸无复千官宴，沧海空馀半夜潮。\n龙去蓬莱曾驻辇，凤归寥廓不闻箫。\n上方楼阁依稀在，暮雨疏钟送寂寥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10215,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"姑苏怀古","author":"蓝智","text":"故国城池岂阖庐，西风台榭尚姑苏。\n歌催越女酣春宴，兵散吴江失伯图。\n辇路草生空走鹿，女墙月落更啼乌。\n可怜犹自矜红粉，十里荷花绕太湖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10216,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"凤凰台","author":"蓝智","text":"金陵晓日望层台，双阙嵯峨宝殿开。\n六代江山龙虎踞，千年城郭凤凰来。\n瑶池夜月吹箫下，玉树秋风步辇回。\n白鹭三山何足赋，明时空想谪仙才。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10217,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"待诏奉天门下","author":"蓝智","text":"凤凰台枕御河流，阊阖风生禁树秋。\n日转东华临万国，星环北极会中洲。\n鹄袍并列趋金殿，雉扇齐开过玉楼。\n忝后儒臣陪顾问，愿陈谠议赞皇猷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10218,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"八月十三日早上御奉天门选注儒士是日膺广西之命","author":"蓝智","text":"金门诏下选英髦，侧席深知圣主劳。\n奎壁图书云汉近，蓬莱宫殿日华高。\n黄麻晓露濡宸翰，玉节秋风照海涛。\n自顾草茅承圣泽，愧无赋颂拟王褒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10219,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题舜庙","author":"蓝智","text":"虞帝传闻葬九疑，苍梧远在桂江湄。\n空山黼黻瞻龙御，落日箫韶想凤仪。\n墓木曾经巡狩地，风云谁见陟方时。\n空遗二女潇湘曲，明月沧波万里思。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10220,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"湘山寺飞来石","author":"蓝智","text":"片石罗浮裂断崖，飞空遥镇梵王台。\n千年虎豹疑星陨，五夜蛟龙共雨来。\n锡响空山云雾合，杯浮沧海浪波开。\n至今老衲翻经处，点点天花护碧苔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10221,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题老君洞","author":"蓝智","text":"老君洞前瑶草春，桃花吹雨红纷纷。\n千年白发化黄石，半夜玉箫来紫云。\n琼林鸾鹤朝梵气，丹井蛟龙护隐文。\n欲向峰头扫明月，流霞招得武夷君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10222,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜泊武昌城下","author":"蓝智","text":"苍山斜枕汉江流，自古东南重上游。\n巫峡秋声连戍角，洞庭月色在渔舟。\n白云黄鹤悠悠思，落木啼乌渺渺愁。\n独夜悲歌形胜地，灯前呼酒看吴钩。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10223,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄张茂叔","author":"蓝智","text":"黄冈处士旧知名，似尔文章老更成。\n芸简蠹鱼当夜永，兰苕翡翠共秋清。\n沧江有酒延渔父，白发无人荐马卿。\n春宴蓬莱消息近，斗南时有剑光横。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10224,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"昭泽雨中作寄同志","author":"蓝智","text":"天涯留滞孤舟日，云壑号呼万木风。\n江上雨声春作雪，斗间剑气夜成虹。\n乾坤浩荡看千古，岭海澄清倚数公。\n明日蓬莱望云气，朝阳鸣凤在梧桐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10225,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄张云松","author":"蓝智","text":"白发林居思不群，丹砂分得武夷君。\n梅边玩易千山雪，松下篝灯一榻云。\n红叶临池工鸟篆，青萍在匣秘龙文。\n草堂回首惭逋客，猿鹤秋声处处闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10226,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄衡山李仲卿","author":"蓝智","text":"谪仙归去卧松巢，江上飞花送锦袍。\n细写山川成史记，更吟兰杜入离骚。\n洞庭万里秋风落，衡岳千峰夜月高。\n欲托瑶琴寄相忆，海天清露鹤鸣皋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10227,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"八月九日巴河阻风答孟原佥宪","author":"蓝智","text":"江湖万里喜同游，漫向巴河滞客舟。\n茆屋谁家还白酒，菊花明日又黄州。\n故园风雨生秋梦，上国云山入暮愁。\n赖有故人相慰藉，灯前谈笑亦风流。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10228,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日黄州作并怀建上二友","author":"蓝智","text":"黄州九日系扁舟，何处登高散客愁。\n萸菊漫怀荆楚客，风烟犹阻洞庭秋。\n飘萧短发欺乌帽，烂漫清尊对白鸥。\n独念故人沧海上，去年今夕记同游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10229,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"倪仲岂编修陈景忠教授有约不至以诗寄之","author":"蓝智","text":"汉阳教授文章古，翰院编修诗句清。\n二公高卧同客况，一日不来孤我情。\n东风绕屋百草绿，细雨捲帘双燕鸣。\n如此风光宜一醉，典衣那得酒同倾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10230,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"入古县望群峰作","author":"蓝智","text":"群峰玉立并青霄，绝壑悬崖径路遥。\n金殿笋班趋晓仗，海门龙角涌春潮。\n赤城霞气中天起，仙掌晴岚近日飘。\n似有清风随宪节，蛮烟瘴雨一时消。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10231,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答仲祥见贻之作","author":"蓝智","text":"平生识君殊恨晚，老去才名谁复过。\n窗前柿叶书汉隶，江上竹枝闻楚歌。\n渔舟细雨白鸥静，药圃暖云瑶草多。\n尊酒相逢又相别，山青水碧奈愁何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10232,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"正月二日答诸公见赠之作","author":"蓝智","text":"雨馀草色映江沙，又见新年换物华。\n万里东风怀棣萼，一杯香露醉桃花。\n丹崖旧种神仙药，碧海虚随奉使槎。\n自愧题诗劳弱翰，故人相对在天涯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10233,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"岩居雨中答黄仲言","author":"蓝智","text":"茅斋喜与故人连，草泽愁闻羽檄传。\n五月烟尘迷道路，九天雷雨洗山川。\n思家梦绕西湖外，恋阙心驰北斗边。\n赖有清樽酬暇日，莫因黄发感流年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10234,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送野士弘状元扶侍还京","author":"蓝智","text":"曾叩中天虎豹关，遥瞻华盖觐天颜。\n春风綵笔金銮殿，晓日宫花玉笋班。\n兵甲十年为客久，楼船五月侍亲还。\n明年骢马来南国，肯访茆茨过此山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10235,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"金州上湘原作寄张观复李子上","author":"蓝智","text":"乔木苍苍覆古城，人家鸡犬似升平。\n清湘一水涵秋色，黄叶千峰送晚晴。\n地接东溟瞻日近，天空南斗觉星明。\n轺车奉诏观风俗，石壁题诗纪政成。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10236,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"麻原归隐图为程伯崇提学赋","author":"蓝智","text":"清名奕世荷君恩，白发他乡卧掩门。\n故国江山愁杜宇，孤村风雨忆麻原。\n红泉酿酒分松液，翠石题诗杂藓痕。\n归去茅斋第三谷，玉田清露长兰荪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10237,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"龚士显招饮云有归意偶成一律寄谢并呈庭实掾史","author":"蓝智","text":"满城明月灯火市，绕屋东风桃杏花。\n青眼故人同把酒，白云远路正思家。\n防身自倚双龙剑，渡海须乘八月槎。\n幕下如君年最少，岂容频问邵平瓜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10238,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"鹤田先生寿日客中有诗寄贺","author":"蓝智","text":"绿发朱颜七十身，飘飘海鹤出风尘。\n苍厓松柏冰霜晚，深谷芝兰雨露春。\n北斗文章韩愈老，西京儒术仲舒醇。\n晨星正为斯文寿，蚤晚非熊载渭滨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10239,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄刘仲祥山长","author":"蓝智","text":"南州谁识少微星，白发山中煮茯苓。\n春草闭门神助句，天花绕坐佛谈经。\n苍龙剑气时时黑，太乙藜光夜夜青。\n十载相思不相见，西风鸿鹄故冥冥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10240,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽卢宪副卒于海北","author":"蓝智","text":"绣衣万里按炎荒，白发中宵陨瘴乡。\n梦断玉楼江月冷，魂飞铜柱海天长。\n楼船岁晚迎归榇，松桂春阴闭野堂。\n欲向沧浪歌楚些，山空猿鹤易悲伤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10241,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻张志道学士旅榇自安南回","author":"蓝智","text":"两朝翰苑擅挥毫，白发萧萧撰述劳。\n使出海南金印重，文成天上玉楼高。\n孤舟恨别三春草，落月归魂万里涛。\n欲托漓江将絮酒，幽兰丛桂赋离骚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10242,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"到梧州知子启佥事已先上平乐寄此","author":"蓝智","text":"吹笙曾约共蓬壶，兴尽山阴返擢孤。\n夜月自怜乌绕树，朝阳空想凤鸣梧。\n虹光图画应难见，河汉星楂未易呼。\n迟日清江牵百丈，绿樽虽好不同酤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10243,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梧州归至龙门驿寄诸同志","author":"蓝智","text":"江转龙门一擢轻，归心不为杜鹃声。\n斜风细雨催离别，剩水残山管送迎。\n但使百蛮称镇静，久知四海望澄清。\n碧云日暮苍梧远，不尽怀人渺渺情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10244,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄贾枢密","author":"蓝智","text":"东南独立倚安危，十月山城战胜时。\n八阵龙蛇随部曲，四郊狐鼠避旌旗。\n关中父老留萧相，江左衣冠望汉仪。\n夜雪早陈平蔡策，天河重赋洗兵诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10245,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"封阳驿","author":"蓝智","text":"官船早发渡头沙，回首东风日又斜。\n千里云山横桂岭，一江春水涨桃花。\n荒村鸡犬临欹岸，细雨凫鹥傍钓楂。\n南望苍梧烟树晚，凤韶何处吊重华。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10246,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄赠毛包二山人","author":"蓝智","text":"仙踪久閟白云深，试考图经下马寻。\n开穴不知凡几代，买山犹自说千金。\n秋风筑垄增新土，春雨栽松接远林。\n惭愧比邻烦二老，长年培护绿成阴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10247,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"五夫新阡图","author":"蓝智","text":"画图山色远苍苍，中有先茔百世藏。\n一径白云留下马，数峰晴雪对眠羊。\n芝兰满地香初远，松柏参天节更长。\n自愧殊乡淹薄禄，新阡谁与表泷冈。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10248,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀川道中","author":"蓝智","text":"茆屋松林度野桥，看山不惜马蹄遥。\n暖风迟日新春好，青草黄茅旧瘴消。\n郡邑正须除吏弊，闾阎还待采民谣。\n纤埃岂足裨山岳，要使蛮荒识圣朝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10249,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江上怀二兄","author":"蓝智","text":"万里驰驱荷圣恩，草堂回首愧诸昆。\n松楸落日怀新垄，桑苧秋风隔故园。\n鸿宝漫传丹灶术，玄经空负子云言。\n岁寒倘遂归田兴，三径犹堪托子孙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10250,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"汉江晚望有怀蓝山伯兄","author":"蓝智","text":"扁舟九月溯沧波，漂泊其如感慨何。\n木落江淮秋色老，山连巴蜀暮云多。\n草堂猿鹤关乡梦，泽国鱼龙入棹歌。\n白发诸兄强健在，采薇空愧首阳阿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10251,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答蓝山兄","author":"蓝智","text":"寄来诗句清如水，思向山中拜老庞。\n总为玄经生白发，久知丹诀出清江。\n秋风茆屋芝三秀，春雨蓝田玉一双。\n也欲论文重载酒，何时剪烛共西窗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10252,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀西山草堂奉柬山中二兄","author":"蓝智","text":"昔年采药问长生，野鹤孤云入幔亭。\n夜雪梅花虚室白，秋风竹简古书青。\n祇今远道生华发，何处空山长茯苓。\n喜有蓝田双璧在，每从南极望春星。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10253,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"天河","author":"蓝智","text":"牛渚秋高木叶飘，西风不待鹊成桥。\n玉楼云雾千峰合，银汉星辰一水遥。\n绿竹人家团小市，黄茆村峒杂群猺。\n南游虚忝观风使，永夜乘楂溯寂寥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10254,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"中秋有怀","author":"蓝智","text":"十年不到天游上，五夜长歌月影中。\n玉宇有时餐沆瀣，金丹无术住崆峒。\n海波滉瀁三山日，鹤背飘萧万里风。\n忽忆旧游如梦寐，诗成题寄紫芝翁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10255,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"七夕乘月下怀远江作","author":"蓝智","text":"清风碧树转千峰，疏雨残云净晚空。\n银汉楂回乌鹊月，石门帆送鲤鱼风。\n一时诗兴来天外，半夜秋声起梦中。\n绝似黄州游赤壁，翩翩孤鹤渡辽东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10256,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄余员外从善","author":"蓝智","text":"袅袅秋风江水波，碧云千里奈愁何。\n空山落叶黄昏雨，深谷幽人白石歌。\n举目渐惊豪杰少，论心偏恨别离多。\n官船不得闽清便，采采金花满涧阿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10257,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"吕仙亭","author":"蓝智","text":"洞庭万里连沧海，石室千年隐翠微。\n华表月明笙鹤下，苍梧云湿剑龙归。\n南城老树名空在，枕上黄粱梦已非。\n倦客远寻勾漏洞，丹砂未就与心违。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10258,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题对海楼图","author":"蓝智","text":"万里沧溟万里天，高楼一望思茫然。\n秋风麟凤通三岛，春雨鱼龙混百川。\n每对苍茫初浴日，几看清浅又成田。\n飞鸿点点云帆小，犹似童儿采药船。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10259,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"余家草堂前手植丛竹已生二笋别来三载今想成林矣客中感物而作","author":"蓝智","text":"丛竹新移涧水西，喜添双笋迸阶泥。\n春云绕屋苍龙起，夜月临轩翠凤栖。\n石上琅玕当并长，壁间蝌蚪待重题。\n他年五柳归来好，三径清风独杖藜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10260,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桂林官舍奉寄云壑山人","author":"蓝智","text":"十年采药住林丘，一入京华觐冕旒。\n遂别山中猿鹤侣，漫看天上凤麟游。\n白云远望潇潇雨，黄叶空山澹澹秋。\n为觅方壶东海上，许图茆屋近沧洲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10261,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过云洞岭宿暮村田家","author":"蓝智","text":"马度危峰雪未乾，鸦鸣荒馆日初残。\n少陵自爱羌村好，太白空歌蜀道难。\n万里敢辞王事苦，一杯聊放客怀宽。\n梅花相伴天涯远，月色江声对倚栏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10262,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"暮春江上看白发","author":"蓝智","text":"啼鹃江上落花初，倦客春深白发疏。\n每叹乘桴怀凤鸟，独惭把钓掣鲸鱼。\n孤舟风雨三更梦，一羽云霄万里书。\n何日山阴寻贺老，清溪归觅旧田庐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10263,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"三月晦日江上作","author":"蓝智","text":"杜鹃声里瘴云低，江上轻寒透敝衣。\n九十春光今日过，三千客路几时归。\n桐花门巷空残雨，燕子楼台又落晖。\n海内交游俱白发，相思莫遣信音稀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10264,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"阳朔江上","author":"蓝智","text":"东出桂林三百里，江水江花总胜游。\n石崖倒影紫玛瑙，野鸟对鸣黄栗留。\n山中茆屋有谁住，松下茯苓应可求。\n勾漏洞南瑶草碧，欲凭老鹤问丹丘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10265,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"出南宁留别子启佥宪杨经历","author":"蓝智","text":"沙头远下拥鸣珂，雪尽沧江生绿波。\n碧桃细雨春寒重，黄鸟东风恨别多。\n万里驱驰心自赤，十年忧患鬓先皤。\n请看天际衔芦雁，犹解冥冥避网罗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10266,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桂林病中作","author":"蓝智","text":"卧病十日不出门，落叶萧索如荒村。\n僮倦昼眠芳树下，马饥时啮秋蔬根。\n每愁地偏药饵少，更畏雨多井水浑。\n桂林南洞有丹诀，杖策拟从方士论。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10267,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中","author":"蓝智","text":"舍南水落沙成堑，北笋山高鸟自鸣。\n幸有樽罍供晚酌，不愁风雨阻春晴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10268,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"风雨 其一","author":"蓝智","text":"骤雨连旬苦未休，飘风数日又何求。\n山中茅屋频摇撼，疑是浮家海上舟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10269,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"风雨 其二","author":"蓝智","text":"溪岸沙崩损药园，山田石裂涌泉源。\n平生数亩耕桑计，风雨无情欲并吞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10270,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"风雨驴上三首 其一","author":"蓝智","text":"风雨南山跨蹇驴，清溪走访野人居。\n林花未落须沽酒，春水初生好钓鱼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10271,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"风雨驴上三首 其二","author":"蓝智","text":"处处江湖行路难，东风鼓角满云端。\n蹇驴破帽青山下，翠木苍藤暮雨寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10272,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]