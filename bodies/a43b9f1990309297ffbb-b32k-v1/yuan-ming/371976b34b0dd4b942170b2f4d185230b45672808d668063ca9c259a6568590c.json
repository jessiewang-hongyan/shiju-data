[{"title":"云卧山房为了上人赋","author":"刘永之","text":"空山云卧杳难寻，惟许人间礼磬音。\n龙起钵中生片影，鹤归仙顶结轻阴。\n化为法雨沾衣湿，散作天花绕座深。\n去住了然无定著，祇应猛虎识禅心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11922,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"仙溪书院为何能举赋","author":"刘永之","text":"江海归来两鬓霜，仙源深处结茅堂。\n参差树映春山远，窈窕桥通碧涧长。\n金匮藏书遗鸟迹，石田种玉起虹光。\n只愁来往迷花屿，预拟藤阴问钓航。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11923,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"渊明入社图","author":"刘永之","text":"空山楼观远苍苍，路出深溪石磴长。\n近瀑飞云经树湿，穿花流水过桥香。\n高僧喜识桄桹杖，稚子欢迎薜荔裳。\n入社几时还出社，松阴十里到柴桑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11924,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠别傅商翁","author":"刘永之","text":"蔗园瓜地楚山春，野屋梅花照雪筠。\n邻瓮共开桑落酒，客衣犹带豫章尘。\n旧弹长铗冯谖老，新著衡书季子贫。\n梦绕西州归雁远，何时同采暮江蘋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11925,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"同声之宿蕙櫋斋临别赋简","author":"刘永之","text":"故人共宿幽斋小，扁竹花开映紫蒲。\n采阁冥传浮水箭，金城朝建相风乌。\n朱丝镂管书苔纸，银簟秋衾梦橘湖。\n明日棹船金水去，烦君临别赠文无。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11926,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为高安何思恭题方壶所画山水","author":"刘永之","text":"古象山中白昼閒，紫烟楼观凤笙寒。\n试分玉井三秋露，戏写方壶九叠山。\n老树模糊常带雨，茅茨潇洒镇临湍。\n知君隐处浑如此，持向荷峰锦水看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11927,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"北涧春日","author":"刘永之","text":"喔喔野鸡鸣远林，瑶琴挥罢思愔愔。\n寒陵山色难生态，春入溪云易合阴。\n畬陇夜烧谙土俗，州城昼掩识边心。\n芳皋杜若相将绿，偏觉骚人幽怨深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11928,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题巴丘龙母庙","author":"刘永之","text":"天开玉峡两厓丹，隔岸诸峰似翠鬟。\n神女不归龙已化，仙翁飞去鹤空还。\n碧坛芳草经年合，古殿苍松落日閒。\n万里长风起天末，如闻环佩白云间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11929,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄淦川友人","author":"刘永之","text":"废郭浮烟合绿芜，茅茨星散县楼孤。\n江连戈舫鸣春鹳，树对寒灯起夜乌。\n古研自磨铜雀瓦，坐毡还叠罽宾毹。\n市南美酒梨花白，最忆青丝系玉壶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11930,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送刘子坚之袁城","author":"刘永之","text":"雪色征袍拂曙飙，宜阳西去思飘飘。\n千峰静对芙蓉幕，三峡遥连螮蝀桥。\n棹得雀舟冲雨缓，借来骢马向春骄。\n青年书记相知久，共按秦筝和玉箫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11931,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读黄危二阁老送何彦正归省诗序追赋一首","author":"刘永之","text":"水满金沟柳著霜，行人驱马上河梁。\n公车未奏三京赋，祖道争持五色裳。\n班固文章传太史，钟繇书法继中郎。\n涧河夜雨烧银烛，坐听疏钟忆建章。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11932,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"用韵送梁徵君孟敬还石门","author":"刘永之","text":"渝曲经年不见君，偶同江郭看飞云。\n蚌还乍喜双珠合，龙跃终愁两剑分。\n踪迹每同樵客隐，姓名已被世人闻。\n暂随郡邑还归去，应念山中白鹿群。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11933,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和友人过象牙潭韵","author":"刘永之","text":"一曲寒山照水清，哀鸿惊鹊乱江声。\n浪翻白雪千寻险，天接浮云万里平。\n前辈总随烟雾尽，虚名真似羽毛轻。\n高怀欲弃人间事，同向天台访赤城。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11934,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次友人钟陵眺望有感之作","author":"刘永之","text":"万堞参差启四门，沧江一望客消魂。\n凤迷吴女琼轩月，蝶湿滕王画栋云。\n孤鸟飞空看渐灭，连樯依浅坐成醺。\n独愁交午归来鹤，谩有仙音忍重论。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11935,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄西峰李纬之","author":"刘永之","text":"汉家仙吏驾云螭，遗迹空存碧藓滋。\n井底龙飞山客见，峰头鹿过野人知。\n芝田旧长千年药，石室新题五字诗。\n寄语山中李道士，好将苦学慰深期。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11936,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟中望九华山","author":"刘永之","text":"春游秣陵涉夏还，船头初见九华山。\n乍起云烟碧窗外，忽生金彩夕阳间。\n玉幢字隐仙书古，石扇苔青洞府閒。\n安得山东李太白，共看山色弄潺湲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11937,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"到郡不入城寄彭声之雪印大虚","author":"刘永之","text":"凤洲秋水日渐渐，江水浑如博士衫。\n草屋结来人假宿，檄文书就手亲缄。\n裁诗久爱中丞丽，制酒难禁吏部馋。\n相见立谈还即别，寸心摇曳似风縿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11938,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游承天宫","author":"刘永之","text":"石桥流水隔飞尘，古木苍苍绕涧滨。\n灵壝旧栖逃汉史，白云曾识避秦人。\n冠裳千载遗琼笥，环佩三秋集羽轮。\n翠壁丹厓如夙契，欲持名姓纪嶙峋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11939,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西昌萧鹏举橐其师北平按察司副使刘君子高之诗千馀篇过潭溪山中欲余选择将归而刻之子高余友也负奇才硕学知名当时其诗今翰林侍讲学士宋公评之至矣余何足以知之徒感鹏举师友之谊重增故人之思次韵二章聊答盛意他日子高见之当发一笑也","author":"刘永之","text":"雨过山居竹色新，荜门松户面嶙峋。\n锦囊缃帙联佳客，玉节青骢忆远人。\n蓟北乌啼官舍晚，江南莺啭故园春。\n萧条万里俱华发，月落西窗入梦频。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11940,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题宋能敏青壁轩","author":"刘永之","text":"沓嶂层峦翠几重，神光动处有奇逢。\n雾生深谷藏玄豹，泉落阴厓化玉龙。\n丹篆晓书朱露湿，碧窗昼掩白云封。\n何时携我青藜杖，结屋来依五粒松。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11941,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"酬别宋赞善大夫景濂二首 其一","author":"刘永之","text":"西阁垂帘坐夕阴，每因朝退共论心。\n文章千载知音少，独立苍茫感慨深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11942,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"酬别宋赞善大夫景濂二首 其二","author":"刘永之","text":"大秀千峰菡萏开，玉梁高接九仙台。\n预从山顶结茅屋，待得先生跨鹿来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11943,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"四时词","author":"刘永之","text":"学士峰头雁正过，将军峡口柳无多。\n云屏露冷衣裳薄，欲棹觥船采芰荷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11944,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题竹","author":"刘永之","text":"溪藤润带空青色，湘竹寒生琬琰文。\n何处幽寻不可□，夜深山雨隔窗闻。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11945,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"听琴图为周易题","author":"刘永之","text":"韦带筠冠白氎衣，龙唇鹤足轸文犀。\n试看十指风泉绕，曲里时闻乌夜啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11946,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画鹰","author":"刘永之","text":"犹记鸣鞘出霸陵，新丰市北醉呼鹰。\n于今豪气都消尽，閒看新图剔雁灯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11947,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题郭熙春山","author":"刘永之","text":"紫雾春山绿树齐，水流花屿乱莺啼。\n蹇驴乌帽归来晚，恰似成都濯锦溪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11948,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题扇","author":"刘永之","text":"乌丝细写蚕头篆，白纻新裁燕尾衫。\n雨过西轩苔色净，涧中云影似江帆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11949,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋江晚钓图","author":"刘永之","text":"□渚环洲隐钓篷，寒藤古木落秋风。\n十年闭户空山□，忽忆江湖似梦中。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11950,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和曾郁文韵","author":"刘永之","text":"□戍鸣笳起画楼，满天凉月恨悠悠。\n离人一夜思亲梦，度尽巴江楚水秋。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11951,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题竹三首 其一","author":"刘永之","text":"□窗新霁绿阴稠，随意挥毫仿蓟丘。\n老鹤陊翎回舞□，洞箫吹遍石林秋。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11952,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题竹三首 其二","author":"刘永之","text":"洞里仙人白兔公，手持玉笛向秋风。\n彩云低度天如水，吹作龙吟山月中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11953,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题竹三首 其三","author":"刘永之","text":"读易茅斋夏日长，琅玕绕屋拟潇湘。\n山风一夜吹疏雨，共爱西窗五月凉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11954,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题扇","author":"刘永之","text":"金凤洲头倒玉壶，铜塘浦口送飞舻。\n他时若记分携处，花满春城闻鹧鸪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11955,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"飞仙图","author":"刘永之","text":"绿膺凤载琼箫，雾鬓烟鬟向月飘。\n阆苑独归仙路远，九天风露湿红绡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11956,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和何平子韵三首 其一","author":"刘永之","text":"碧池万柄青荷叶，相映茅斋水雾深。\n满酌君家琥珀酒，时时扶醉过花阴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11957,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和何平子韵三首 其二","author":"刘永之","text":"雪竹霜筠负所期，寒云飞雁影离离。\n悬知磐石苍苔上，犹有山阴道士诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11958,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和何平子韵三首 其三","author":"刘永之","text":"萧萧官柳著霜稀，水鸟沙禽弄夕晖。\n明日钟陵相祖别，金盘斫脍鲤鱼肥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11959,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重过何氏席上作二首 其一","author":"刘永之","text":"霜筠雪竹暮云寒，采笔题诗点石阑。\n银烛金尊重到日，老怀不似少年欢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11960,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重过何氏席上作二首 其二","author":"刘永之","text":"谢家群从最多贤，第宅新成绮户连。\n预喜酒阑宾客散，看传银烛散青烟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11961,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄彭声之","author":"刘永之","text":"素纨便面小行书，最爱风流半醉馀。\n芙蓉杨柳娟娟月，何处相逢解玉鱼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11962,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄西峰道士七首 其一","author":"刘永之","text":"栖碧山人两袂轻，玉蜍盛得露华清。\n新诗不记人间事，尽写瑶台阆苑情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11963,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄西峰道士七首 其二","author":"刘永之","text":"古墨轻磨紫麝脐，白云窗下小书帷。\n何时为写梅君传，换得鹅群映锦池。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11964,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄西峰道士七首 其三","author":"刘永之","text":"百尺飞楼接太清，万年枝上月华明。\n鹿车入谷无人见，应是仙人卫叔卿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11965,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄西峰道士七首 其四","author":"刘永之","text":"小凤双吹紫玉簧，雪毛丹顶唱云章。\n碧桃开遍灵芝长，万壑千峰露气凉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11966,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄西峰道士七首 其五","author":"刘永之","text":"夜礼珠衡佩玉锵，庆云低绕郁金章。\n空中鹤语神君至，睡鸭频添百和香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11967,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄西峰道士七首 其六","author":"刘永之","text":"瑶擅丹柰景阑干，不比人间荔子丹。\n明月娟娟清露湿，碧苞珠实满金盘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11968,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄西峰道士七首 其七","author":"刘永之","text":"石室虚明隔紫烟，灵文中閟白瑶镌。\n丹书隐字谁能识，岁月应题建武年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11969,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"北涧夏日二首 其一","author":"刘永之","text":"酒倾兰勺石泉香，水剪荷盘露气凉。\n谁料十年江海兴，闭门疏雨对横塘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11970,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"北涧夏日二首 其二","author":"刘永之","text":"白纻衣裳碧玉冠，绿波池上独盘桓。\n水禽飞下凉飔起，閒看冰荷侧露盘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11971,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜宴定侯宅醉中口号","author":"刘永之","text":"刻羽堂中画烛明，将军夜醉水西营。\n青楼小妇新承宠，弹得《凉州》第一声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11972,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"吹箫图为刘海阳赋吹箫图为刘海阳赋","author":"刘永之","text":"曾引双飞綵凤来，紫琼镂管上箫台。\n于今无复人间梦，一曲閒吹坐碧苔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11973,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题墨梅","author":"刘永之","text":"郭西茅屋经年别，嫩蕊疏枝入梦频。\n何处幽寻重相忆，寒云野水月如银。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11974,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为何彦脩题县厓古木图","author":"刘永之","text":"古木苍苍带女萝，峰阴斜蘸石潭波。\n十年不到屏风叠，夜雨茅檐幽梦多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11975,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"与何重容","author":"刘永之","text":"百尺长松不记年，石床敧帽午阴圆。\n何郎茅屋相怜住，为煮新茶汲涧泉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11976,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题扇","author":"刘永之","text":"扬州何逊多才藻，秋水金塘艳碧蕖。\n深院闭门芳草合，小帘低护杀青书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11977,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重过北涧和韵","author":"刘永之","text":"北涧苍苍古木长，南塘夜雨落花香。\n重来万事堪惆怅，剪烛西窗共一觞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11978,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"三友图","author":"刘永之","text":"冰髯玉节间苔枝，瘦影参差落墨池。\n最忆山阴残雪里，西窗相对鬓如丝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11979,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和贰守漫兴","author":"刘永之","text":"鄱阳春水渺连空，烟屿飞花远近红。\n石渚买鱼新斫脍，一时风致似吴中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11980,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宿西峰怀旧","author":"刘永之","text":"得失浮云聚散间，陆机先识愧张翰。\n无端一派西安水，故作愁声入梦寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11981,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题墨梅二首 其一","author":"刘永之","text":"茅屋苍苔野水滨，岁寒冰雪久相亲。\n江湖后夜扁舟梦，犹记尊前对玉人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11982,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题墨梅二首 其二","author":"刘永之","text":"仙馆曾逢玉带姿，梦中要作晓寒词。\n于今相对情如水，唯有清霜绕鬓丝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11983,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"写墨竹一枝","author":"刘永之","text":"为君粘笔写筼筜，数尺新捎绿粉香。\n持向西窗听夜雨，高情浑似对潇湘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11984,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为彭子弘题渔钓图","author":"刘永之","text":"彭郎矶畔小茅堂，露满秋林木叶黄。\n石渚水生鱼欲上，一江风雨夜鸣榔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11985,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题北涧精舍","author":"刘永之","text":"石田流水绕生苔，翠竹苍松傍舍栽。\n恰似辋川庄里住，荜门斜对芰荷开。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11986,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登金牛台","author":"谢应芳","text":"六龙城西吕城东，奔牛古堰卧两虹。\n谁筑高楼水中沚，野有蔓草牛无踪。\n河边青苔生白骨，刀创箭瘢犹未没。\n问知八十一年前，战死当时皆义卒。\n铁马遁去刘将军，大家牵羊走燕云。\n二百山河献明主，北驼南象今纷纷。\n登临且喜得佳客，鞠育青青已堪摘。\n浮云世事勿复论，一醉西风真上策。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11987,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"呈赵徵士","author":"谢应芳","text":"吴姬手执金叵罗，春风笑面生红涡。\n主人留客长夜饮，客拜主人持酒多。\n主人沈醉客亦醉，客散扶归主人睡。\n残杯冷炙厨头倾，邻家儿有啼饥声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11988,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]