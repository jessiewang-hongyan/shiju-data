[{"title":"素梅五十八首 其四十一","author":"王冕","text":"树阴如屋雾如潮，浅水流花落野桥。\n忽忆去年秋八月，玉霄峰顶夜吹箫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":127,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"素梅五十八首 其四十二","author":"王冕","text":"仙子归来夜未央，瑞香风动翠罗裳。\n月明无处韬清影，箫管迎春上玉堂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":128,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"素梅五十八首 其四十三","author":"王冕","text":"海云初破月团团，独鹤归来夜未阑。\n一片笙箫湖水上，玉妃无语倚阑干。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":129,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"素梅五十八首 其四十四","author":"王冕","text":"云间古寺陆机宅，草木萧森鹤不来。\n惟有溪头老梅树，霜花犹是旧时开。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":130,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"素梅五十八首 其四十五","author":"王冕","text":"三月东风吹雪消，湖南山色翠如浇。\n一声羌管无人见，无数梅花落野桥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":131,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"素梅五十八首 其四十六","author":"王冕","text":"閒花野草斗青红，一著冰霜扫地空。\n惟有老梅标致别，岁寒时节自春风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":132,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"素梅五十八首 其四十七","author":"王冕","text":"地老天荒尽可花，不同桃李竞繁华。\n要知鼎鼐调羹味，须问旧时丞相家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":133,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"素梅五十八首 其四十八","author":"王冕","text":"和靖门前雪作堆，多年积得满身苔。\n疏花个个团冰雪，羌笛吹他不下来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":134,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"素梅五十八首 其四十九","author":"王冕","text":"月明海底夜无烟，恰似西湖雪后天。\n清气逼人禁不得，玉箫吹上大楼船。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":135,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"素梅五十八首 其五十","author":"王冕","text":"西湖湖上水如天，狂客长吟夜不眠。\n骑鹤归来清兴好，梅花无影月娟娟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":136,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"素梅五十八首 其五十二","author":"王冕","text":"六月一日天大热，清风忽地过江来。\n湿云挟得梅梁起，半夜飞空作怒雷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":137,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"素梅五十八首 其五十三","author":"王冕","text":"江北江南寒气重，雪花如席蔽天来。\n五更野叟敲门报，屋外老梅连夜开。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":138,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"素梅五十八首 其五十四","author":"王冕","text":"独鹤高飞雪气浓，梅烟清浅月朦胧。\n一声箫管归何处？\n人在琼楼玉宇中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":139,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"素梅五十八首 其五十五","author":"王冕","text":"马迹山前万树梅，千花万花如雪开。\n满载扬州秋露白，玉箫吹过太湖来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":140,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"素梅五十八首 其五十六","author":"王冕","text":"冰雪林中著此身，不同桃李混芳尘。\n忽然一夜清香发，散作乾坤万里春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":141,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"素梅五十八首 其五十七","author":"王冕","text":"黄河十月冰如地，骑马何人说好官？\n老子门前三丈雪，梅花开尽不知寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":142,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"素梅五十八首 其五十八","author":"王冕","text":"春风无声海日起，梅花满树烟茫茫。\n西湖昨夜笙歌静，相见逋仙是林中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":143,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花十五首 其一","author":"王冕","text":"林下见清真，草衣如野人。\n开花冰雪里，岂是不知春？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":144,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花十五首 其二","author":"王冕","text":"清苦良自持，忘言养高洁。\n夜静月明多，开门满山雪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":145,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花十五首 其三","author":"王冕","text":"十月霜风寒，山木俱摧折。\n独此冰玉姿，照影清溪月。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":146,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花十五首 其四","author":"王冕","text":"故人江海去，相隔万重云。\n岁晚思无已，梅花可寄君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":147,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花十五首 其五","author":"王冕","text":"何处寻春信，江南路渺漫。\n夜深山月白，疏影隔窗看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":148,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花十五首 其六","author":"王冕","text":"老干渍清霜，寒梢挂新月。\n徐徐暗香来，可是春机泄？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":149,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花十五首 其七","author":"王冕","text":"疏枝照清浅，一见兴何饶？\n记得春风夜，题诗过断桥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":150,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花十五首 其八","author":"王冕","text":"仙子步轻盈，泠泠玉佩声。\n罗浮烟水远，诗梦不胜情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":151,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花十五首 其九","author":"王冕","text":"冷艳凝轻露，清香度晚风。\n如何冰玉质，却学小桃红？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":152,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"红梅","author":"王冕","text":"深院春无限，香风吹绿漪。\n玉妃清梦醒，花雨落胭脂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":153,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花十五首 其十一","author":"王冕","text":"湖上春何在，罗浮梦已空。\n清香入书屋，不是杏花风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":154,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花十五首 其十二","author":"王冕","text":"庭院春日迟，风回翠鸾舞。\n谁倚玉阑干？\n摇动燕脂雨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":155,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花十五首 其十三","author":"王冕","text":"不作桃李态，山林别是春。\n但令心似铁，何虑惹缁尘？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":156,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花十五首 其十四","author":"王冕","text":"面墨已无情，岂但心如铁？\n昨宵疏影横，空山半窗月。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":157,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅花十五首 其十五","author":"王冕","text":"明洁众所忌，难与群芳时，怀贞岁华晚，只有天地知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":158,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"墨梅四首 其一","author":"王冕","text":"老仙醉吸墨数斗，吐出梅花个个真。\n相见草嫌颜色异，山林别是一般春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":159,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"墨梅四首 其二","author":"王冕","text":"面皮如铁惯风霜，焉肯托根桃李场？\n转首江南春似海，一声箫管月苍苍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":160,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"墨梅","author":"王冕","text":"我家洗研池边树，朵朵花开澹墨痕。\n不要人誇好颜色，只留清气满乾坤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":161,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"墨梅四首 其四","author":"王冕","text":"莫厌缁尘染素衣，山间林下自相宜。\n玉堂多少閒风月，老子熟眠殊不知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":162,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题巨然画","author":"王冕","text":"溪山对雨起呼酒，一笑还披万里图。\n疏树远山秋淡薄，飘风流水尽模糊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":163,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题曹云西山水","author":"王冕","text":"旭日耀苍巘，翠岚生嫩寒。\n幽人诗梦醒，清响得松湍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":164,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠云峰上人墨梅图","author":"王冕","text":"粲粲疏花照水开，不知春意几时回。\n嫩云清晓孤山路，记得短筇寻句来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":165,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁酉岁元日九里山中","author":"王冕","text":"授时无历日，献岁喜天晴。\n道路何艰阻，山林似太平。\n梅香清海国，柳色上江城。\n且喜兰台近，疲民稍慰情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":166,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日书怀","author":"王冕","text":"玉露霏凉木渐酡，每逢佳节惜年华。\n青山叠叠多归梦，白发萧萧不在家。\n触景漫思千古事，无钱空对一篱花。\n相知相见情何已，石鼎山泉且煮茶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":167,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日有怀","author":"王冕","text":"拊髀怜佳节，多年不在家。\n有亲垂白发，无意对黄华。\n怀古余情旷，登高望眼赊。\n南山荒霭合，日暮乱归鸦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":168,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九里山中三首 其二","author":"王冕","text":"九里先生两鬓皤，今年贫胜去年多。\n敝衣无絮愁风劲，破屋牵萝奈雨何。\n数亩豆苗当夏死，一畦芦穧入秋瘥。\n相知相见无他论，笑看山前白鸟过。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":169,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九里山中三首 其三","author":"王冕","text":"九里溪头晚雨晴，松风瑟瑟水泠泠。\n绝无过客问奇字，只有閒云到野亭。\n每笑盛名传坎壈，岂陈虚语说零丁？\n老年恰喜精神爽，合得仙人相鹤经。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":170,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"八蟠岭","author":"王冕","text":"路绕危垣上，风高松桧鸣。\n花飞殊失意，草长不知名。\n游客咨遗俗，居民指旧京。\n浮图天末起，瞻望忽伤情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":171,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"三茅观","author":"王冕","text":"层峦开径隐空青，勃窣槃跚眼力生。\n萝蹬痴岚留宿雨，石林寒竹动秋声。\n城隍下瞰红尘海，楼阁高悬白玉京。\n夜静何人吹凤管？\n碧桃千树月华明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":172,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"下直沽","author":"王冕","text":"拍河健橹比长驱，百尺飞帆下直沽。\n浩浩碧天秋气肃，堂堂明月夜窗虚。\n旌旗两岸芦花影，鼙鼓三声海浪趋。\n转首狂歌望西北，淡烟荒草是幽都。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":173,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"与王德强","author":"王冕","text":"阿伯迁官之五羊，严尊习隐水南庄。\n人生出处故有分，世道如斯徒自忙。\n笑我漂流双鬓雪，羡君奔走满靴霜。\n功名固是男儿志，何日归来绿野堂？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":174,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中杂兴二十首 其一","author":"王冕","text":"去城悬九里，夹地出双溪。\n傍水编茅屋，移花近药畦。\n长年无客到，终日有猿啼。\n利路何须问，閒身尽可栖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":175,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中杂兴二十首 其二","author":"王冕","text":"因拜山农号，生涯日日新。\n带泥移瘦竹，和藓择枯薪。\n时酌山泉赏，都无世俗尘。\n乌鸢虽见忌，麋鹿自相亲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":176,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中杂兴二十首 其三","author":"王冕","text":"居山还有趣，斸地本无谋。\n相顾谁青眼？\n同盟尽白头。\n豺狼迷道路，猿鸟傍林丘。\n休问巢由乐，吾心自可求。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":177,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中杂兴二十首 其四","author":"王冕","text":"拄杖听鸣鸠，青山树色稠。\n雨寒云不起，沙乱水交流。\n对景堪垂涕，无为亦动愁。\n疲民正无奈，谁解为君筹？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":178,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中杂兴二十首 其五","author":"王冕","text":"散处身如寄，幽栖屋似船。\n江鸣风落雨，山暗树生烟。\n架有催诗简，囊无贳酒钱。\n东邻吴季子，潇洒亦堪怜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":179,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中杂兴二十首 其六","author":"王冕","text":"漂泊殊无定，归来得暂安。\n不嫌知己少，似觉傍人难。\n梅屋春风细，松窗夜月寒。\n交游成契阔，重检旧书看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":180,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中杂兴二十首 其七","author":"王冕","text":"短策閒寻句，长歌独倚楼。\n野云迷客思，花雨乱春愁。\n论事思王猛，看书忆马周。\n老吾吾道在，一一付沧洲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":181,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中杂兴二十首 其八","author":"王冕","text":"信是击中好，春来物物丰。\n石蚕生断砌，玉蕈出枯桐。\n暖雨蒸花气，晴烟扬柳风。\n眼前无限景，诗句可能穷？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":182,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中杂兴二十首 其九","author":"王冕","text":"趁暖行山径，寻幽过野亭。\n雨开云气白，风动烧痕青。\n桃树新生蕊，梅心小结形。\n倚阑閒纵目，物物得娉婷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":183,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中杂兴二十首 其十","author":"王冕","text":"小艇横河过，残阳隔岸舂。\n水声清绕屋，山气冷侵窗。\n卸屐行花径，携书坐石缸。\n可知耕种好，只拟鹿门庞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":184,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中杂兴二十首 其十一","author":"王冕","text":"细注归田录，重修种树书。\n自知身是客，不叹食无鱼。\n石屋春云重，紫床夜月虚。\n萧条空四壁，谁问马相如？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":185,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中杂兴二十首 其十二","author":"王冕","text":"眺望春光远，登临夕照微。\n野云平细垒，山鸟怪儒衣。\n触处无高下，何劳论是非？\n寄言彭泽宰，出仕不如归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":186,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中杂兴二十首 其十三","author":"王冕","text":"山园无定式，力作是生涯。\n近水多栽竹，依岩半种茶。\n春风低小草，夜雨出新沙。\n不必闻时事，城中减大家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":187,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中杂兴二十首 其十四","author":"王冕","text":"沟塍通谢墅，禹穴近龙宫。\n两水沿平地，诸山在下风。\n烟霞时出没，日月互西东。\n閒看桃源记，吾将此意同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":188,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中杂兴二十首 其十五","author":"王冕","text":"石楼含晓色，茅屋静春晖。\n野水中间落，云山西面围。\n长歌樵担起，短笛钓船归。\n景物随时至，诗成思欲飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":189,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中杂兴二十首 其十六","author":"王冕","text":"贫居得幽僻，世事不相关。\n诗思多因雨，閒情独爱山。\n落花随水去，孤鹤望人还。\n最喜神清健，年来酒量悭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":190,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中杂兴二十首 其十七","author":"王冕","text":"家贫便食淡，年老觉身臞。\n细字凭儿看，清樽待客沽。\n惜春嫌谢豹，顾兔忆韩卢。\n怅望青山曲，点头愧野夫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":191,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中杂兴二十首 其十八","author":"王冕","text":"卜宅近山阿，柴门障薜萝。\n风清闻鹤唳，日暖听樵歌。\n密树悬青岛，平田浸白波。\n树船乘暮景，来往急如梭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":192,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中杂兴二十首 其十九","author":"王冕","text":"草径如蛇绾，茅庐比斗宽。\n溪声归夜响，山气入春寒。\n且自师伊尹，毋劳说谢安。\n有时閒纵步，长啸白云端。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":193,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中杂兴二十首 其二十","author":"王冕","text":"寒雪满空山，出门行路难。\n家人愁累重，客子怯衣单。\n寇盗因时起，乾坤尚未安。\n吾农清苦甚，今日净朝餐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":194,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山水图","author":"王冕","text":"一望东南竟海涯，仙人何处饭胡麻？\n树阴霭霭欲生雨，山色重重似削瓜。\n玄哺紫苔封药草，白云流水隔桃花。\n天台司马君休问，绝胜终南处士家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":195,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山水图","author":"王冕","text":"云气笼阴隔荔萝，吾家曾住石南坡。\n秋风绕屋树声杂，夜雨落山溪水多。\n每有渔樵共谈笑，且无车马得经过。\n京师沙土眯人目，为尔传图情奈何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":196,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山水图","author":"王冕","text":"我生爱看真山水，眼底崎嵚每自谙。\n绝壑卧云留宿雨，高林浮翠出晴岚。\n青山近屋多于簇，白石攒沙小似蚶。\n展卷令人倍惆怅，杏花春雨隔江南。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":197,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]