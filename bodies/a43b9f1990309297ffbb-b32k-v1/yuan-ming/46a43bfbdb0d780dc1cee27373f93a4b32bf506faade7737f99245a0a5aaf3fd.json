[{"title":"题张师夔小景","author":"蓝仁","text":"空山秃木两株长，屈干樛枝半欲僵。\n下有敷荣三五树，自缘低处少风霜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9929,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题黄仲文小景四首 其一 春日观泉","author":"蓝仁","text":"雨过春山草木稠，悬崖千尺挂飞流。\n幽人倚杖遥观处，似在庐山五老游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9930,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题黄仲文小景四首 其二 清昼鼓琴","author":"蓝仁","text":"绿树垂帷石作台，龙唇拂拭自徘徊。\n黄埃赤石人间世，正想南风解愠来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9931,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题黄仲文小景四首 其三 凉宵对月","author":"蓝仁","text":"晴空万里片云收，山木萧萧虎豹秋。\n对酒愿留天上月，清光长照少年头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9932,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题黄仲文小景四首 其四 雪霁寻梅","author":"蓝仁","text":"旭日初升雪满山，水边林外觅花看。\n南枝先得阳和信，竹杖芒鞋不避寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9933,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题东郊归牧图 其一","author":"蓝仁","text":"牛背相驱下陇时，夕阳门巷景迟迟。\n欹眠倒立休相讶，造化从来似小儿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9934,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题东郊归牧图 其二","author":"蓝仁","text":"浅石幽柯草满川，吴牛背上稳于船。\n儿童颠倒争喧笑，绝似雍熙在目前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9935,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题烟波垂钓扇面","author":"蓝仁","text":"渔钓生涯不为贫，烟波鸥鸟日相亲。\n鉴湖一曲秋风兴，谁似知章早乞身。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9936,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题欧阳雪舟墨梅二首 其一","author":"蓝仁","text":"横梢倒干春偏好，冷蕊疏花晚自妍。\n我老正须诗兴助，欲移茅屋住湖边。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9937,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题欧阳雪舟墨梅二首 其二","author":"蓝仁","text":"最忆庐陵老炼师，酒酣挥笔写南枝。\n春风开尽江头树，不见扁舟载月时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9938,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题小幅雪景 其一","author":"蓝仁","text":"短棹中流往复还，神交元不在承颜。\n剡溪清兴何人会，月满长川雪满山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9939,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题小幅雪景 其三","author":"蓝仁","text":"玉堂空愧故人招，风雪归来渡野桥。\n留得平生诗兴在，蹇驴破帽鬓萧萧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9940,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题小幅雪景 其四","author":"蓝仁","text":"蓝关回首自凄凉，积雪层冰道路长。\n去国可无三宿恋，旁人休笑马蹄僵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9941,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题孤松怪石图","author":"蓝仁","text":"老枝枯干倚岩峦，纵有风云变化难。\n自是无心爱春色，千年留与石同看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9942,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题廉宣仲墨竹 其一","author":"蓝仁","text":"先朝文物佳公子，善写苍筤一两枝。\n不有百年真翰在，清风高节几人知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9943,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题廉宣仲墨竹 其二","author":"蓝仁","text":"城中无土种琅玕，苍翠时时画里看。\n最忆西山秋影静，满身凉月更凭阑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9944,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"黄仲文寄墨竹","author":"蓝仁","text":"一幅鹅溪写辋川，高情相许已三年。\n春风传得平安报，剪与淇园半亩烟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9945,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题宣和画鹅雏卷 其一","author":"蓝仁","text":"柳下金沟煖似汤，羽翎全短毳毛长。\n睿思不及鹰扬力，爱画舟前似酒黄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9946,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题宣和画鹅雏卷 其二","author":"蓝仁","text":"宴安花木应成癖，游戏翎毛思有馀。\n内苑养雏何所赐，右军能写道家书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9947,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题独骏图","author":"蓝仁","text":"圉人牵出柳风凉，十二天闲白昼长。\n老眼渐看兵革息，相逢期在华山阳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9948,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题王仲文临清阁卷","author":"蓝仁","text":"高阁留宾酒满杯，秋风千里雁初来。\n故园松竹平安在，天际归舟不用催。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9949,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题梅根读易图","author":"蓝仁","text":"疏花老干转春风，独坐观书夕照中。\n倘许苍苔分半席，也来林下论参同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9950,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题梅窗玩易图","author":"蓝仁","text":"月到书帷夜肃然，南枝微有暗香传。\n静中紬绎先天学，消长盈虚在目前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9951,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"又题梅窗玩易图","author":"蓝仁","text":"三绝韦编一洗心，碧窗风露静沉沉。\n寒灰自画周天卦，月上梅梢夜已深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9952,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题清源玩易图","author":"蓝仁","text":"一卷羲经足洗心，研朱滴露向秋林。\n仙人欲授参同论，白鹤飞来夜已深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9953,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"效冯老泉咏西山蚊虫 其一","author":"蓝仁","text":"林壑饥蚊响似雷，成群作队夜深来。\n道人传得希夷睡，烧尽葭烟一束灰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9954,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"效冯老泉咏西山蚊虫 其二","author":"蓝仁","text":"蚊虫只为口如针，火劫烟攻退又侵。\n风露尽多呼吸处，破窗残隙莫相寻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9955,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"效冯老泉咏西山蚊虫 其三","author":"蓝仁","text":"散漫飘萧豹脚长，小窗飞入闹昏黄。\n月明蕙帐今空在，借问为谁逐客忙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9956,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"效冯老泉咏西山蚊虫 其四","author":"蓝仁","text":"霜落俱看扫迹空，雨馀又听放声同。\n生民膏血能多少，尽在馋肠利觜中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9957,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"云松到西山有四绝句见贻依韵奉和兼柬云壑本淳一笑 其一","author":"蓝仁","text":"自与山灵有宿期，题诗屡报入山时。\n林间二客烦相待，拂拭苍苔看旧诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9958,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"云松到西山有四绝句见贻依韵奉和兼柬云壑本淳一笑 其二","author":"蓝仁","text":"路岐筋力久难堪，偶为山人过水南。\n明月轩中一斗酒，浮丘今夜共清谈。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9959,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"云松到西山有四绝句见贻依韵奉和兼柬云壑本淳一笑 其三","author":"蓝仁","text":"三年两夕会西山，寸晷分阴若自悭。\n白发相期来洗髓，又扶竹杖叩云关。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9960,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"云松到西山有四绝句见贻依韵奉和兼柬云壑本淳一笑 其四","author":"蓝仁","text":"平生痼疾在林泉，老去诗名亦漫然。\n故旧相逢聊一笑，蝉声过耳竟谁传。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9961,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"石村阻雪云松惠诗依韵奉答 其一","author":"蓝仁","text":"清湖晴雪对莲峰，下有弦歌一亩宫。\n题得新诗寄茆屋，长松修竹共清风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9962,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"石村阻雪云松惠诗依韵奉答 其二","author":"蓝仁","text":"携得长镵度雪峰，月明留宿洞仙宫。\n世人未识宾云曲，閒却林梢一笛风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9963,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山行雨中","author":"蓝仁","text":"疏林野水白鸥閒，细雨浓云杳蔼间。\n若得扁舟载春酒，画图都是米家山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9964,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送茶与朱孟舒","author":"蓝仁","text":"仙草灵芽出洞天，封题千里附归鞭。\n月明记得相寻处，曾试林间第一泉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9965,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"病起后园看花四首 其一","author":"蓝仁","text":"霜枝露叶长丛丛，铸就黄金讶许同。\n昨日不缘行药到，又成寂寞付秋风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9966,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"病起后园看花四首 其二","author":"蓝仁","text":"冷坐东篱句自敲，旁人错讶候香醪。\n餐英饮水寻真乐，久与王弘著绝交。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9967,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"病起后园看花四首 其三","author":"蓝仁","text":"露下碧丛珠滴滴，月明素萼雪团团。\n不知晚节全清白，更向东篱仔细看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9968,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"病起后园看花四首 其四","author":"蓝仁","text":"一枝数萼剪轻冰，应与渊明共素心。\n秋色满园题品遍，从来白玉贵黄金。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9969,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柬云松惠宿翁源","author":"蓝仁","text":"路入仙岩更向西，松林茅屋拟同栖。\n一尊风月谋今夕，邀得閒云晚度溪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9970,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"修渡船","author":"蓝仁","text":"渡口沉舟久欲修，百川东下正横流。\n艰难共济惭衰老，更唤前溪黄帽头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9971,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋日偶成 其一","author":"蓝仁","text":"荒苔落叶小轩秋，兀坐无聊疾始瘳。\n一缕篆烟飞不尽，又将诗卷阅从头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9972,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋日偶成 其二","author":"蓝仁","text":"秋雨生寒似早春，寥寥门巷绿苔新。\n社前酿熟松醪酒，留得仙瓢候故人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9973,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"石村阻水 其一","author":"蓝仁","text":"昨日今日雨不绝，武夷东西溪水高。\n驾壑仙船在岩顶，也愁孤棹动风涛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9974,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"石村阻水 其二","author":"蓝仁","text":"空山雨脚乱如麻，短杖冲泥草径斜。\n野老门前三尺浪，相逢真在水仙家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9975,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻小儿欲归","author":"蓝仁","text":"风雨泥途汨汨忙，新春残腊寄他乡。\n归期趁得天涯燕，社日飞来入草堂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9976,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"除夜忆小儿泊峡口","author":"蓝仁","text":"除夜孤灯对短篷，浮生原不定西东。\n断猿何处惊残梦，风雨萧萧宿峡中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9977,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"伤春 其一","author":"蓝仁","text":"山庄寂寞雨兼风，红紫园林数夕空。\n忆得往来三四十，青天白日万方同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9978,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"伤春 其二","author":"蓝仁","text":"落花飞絮满晴川，杜宇声声更可怜。\n不用伤心愁欲死，亦知春去有明年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9979,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"食鱼呈刘河泊 其一","author":"蓝仁","text":"清溪红鲤上雕盘，庖子挥刀鲙雪寒。\n遥想河官停夕箸，欲分山老助晨餐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9980,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"食鱼呈刘河泊 其二","author":"蓝仁","text":"琴高入海偶先还，掉尾扬鬐戏碧澜。\n野老久思羹一啜，病躯无力掣长竿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9981,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"食鱼呈刘河泊 其三","author":"蓝仁","text":"病来物物不入口，最想波鳞芼涧蔬。\n紫鲤上盘煮白雪，加餐愿看腹中书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9982,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"食鱼呈刘河泊 其四","author":"蓝仁","text":"河官顿顿食鱼羹，不待侯门有铗声。\n老子平生藜藿口，狂来犹欲脍长鲸。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9983,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄苏明远 其一","author":"蓝仁","text":"写得冰绡带晚霞，归来卷赠一枝斜。\n摩挲老眼看春色，却讶墙头出杏花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9984,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄苏明远 其二","author":"蓝仁","text":"笔下秋光最好看，相思千里寄来难。\n白头已入庐山社，犹忆东篱月影寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9985,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄苏明远 其三","author":"蓝仁","text":"稚子牵牛似挽车，微风落日笛呜呜。\n故人久识柴门处，为作蓝原野牧图。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9986,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄苏明远 其四","author":"蓝仁","text":"钓船移向夕阳边，春水桃花绿满川。\n一曲渔歌聊自乐，晚风休为世人传。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9987,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄复婴本淳","author":"蓝仁","text":"绝粒虚肠譬饿囚，无眠低户数更筹。\n仙家有说能飞解，不挟凡躯送十洲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9988,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桃花马 其一","author":"蓝仁","text":"君家骏骑自超群，毛色桃花个个文。\n安得腾骧三万匹，满川应似涨红云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9989,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桃花马 其二","author":"蓝仁","text":"生从渥水真奇骨，卧向华阳亦素心。\n何事落红飞满背，随风冲雨过桃林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9990,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"病中 其一","author":"蓝仁","text":"朽骨不禁风露冷，衰容更畏雪霜繁。\n呼儿欲问春深浅，柳絮梨花已满园。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9991,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"病中 其二","author":"蓝仁","text":"杖策儿扶村舍翁，一樽花下卧春风。\n社前雷动催茶笋，兴入千岩万壑中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9992,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"病中 其三","author":"蓝仁","text":"山城雨过草萋萋，无数残红逐马蹄。\n燕子不知春景异，傍人华屋又衔泥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9993,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄文明病中 其一","author":"蓝仁","text":"童冠论交五十春，巷南巷北日相亲。\n年来颇恨俱衰病，欲候平安却问人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9994,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄文明病中 其二","author":"蓝仁","text":"欲疗疮痍未有方，闭门扶枕换年光。\n从来祸福分淫善，天道如何转渺茫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9995,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠云壑","author":"蓝仁","text":"望山寻水不惮遥，白云红树喜相招。\n梦回茅屋潇潇雨，又得留君住一宵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9996,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"兼善携仲文竹至","author":"蓝仁","text":"青山久隔故人面，脩竹自同君子心。\n老可近来无一事，为添清影满东林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9997,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西山道人惠江南笋","author":"蓝仁","text":"江南苦竹生甘笋，春社雷惊出土长。\n扶病欲来参玉版，道人晓起赠双筐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9998,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄题五夫先垄","author":"蓝仁","text":"双亲远葬傍西岩，麦饭来迟每自惭。\n愿得太平徭役少，结茅此地守松杉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":9999,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"先垄有感","author":"蓝仁","text":"双亲已远弟兄稀，魂梦相逢似旧时。\n茅屋数椽田二顷，白头犹受一安遗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10000,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和云松雪中十绝 其一","author":"蓝仁","text":"夜寒敢叹卧如弓，起傍残炉榾柮红。\n童子偶看门外白，谁将琼玖赈诗穷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10001,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和云松雪中十绝 其二","author":"蓝仁","text":"夜雪茅檐积渐高，傍林时听折危梢。\n南山石上双松树，莫更动摇仙鹤巢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10002,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]