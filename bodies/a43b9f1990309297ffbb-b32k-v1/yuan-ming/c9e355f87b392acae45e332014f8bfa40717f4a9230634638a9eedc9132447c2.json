[{"title":"卢彦志自台州候官至维扬","author":"瞿智","text":"台州候吏扬州去，驿马回途一月期。\n官寺偶分银烛坐，客楼每怪玉杯迟。\n山中桃树仙人洞，天下琼花后土祠。\n卢彦此游元不浪，锦囊收得数篇诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12434,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵监郡鲁公二首 其一","author":"瞿智","text":"镜里湖光煖欲波，客情惆怅不能过。\n蓉花簇簇开岩岫，云片飞飞起鹳鹅。\n载酒小船轻若苇，穿城夹膝小如梭。\n每因公事归来晚，无奈重楼月色何！","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12435,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵监郡鲁公二首 其二","author":"瞿智","text":"祇合明时早挂弓，谩劳车马驻江东。\n烟开溟海清蛮蜑，水满平湖没雁鸿。\n□骑夜驰蓬阁下，云旗晴卷石城中。\n万方应喜平群寇，当与汾阳并大功。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12436,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次张句曲题杨铁崖新屋诗韵","author":"瞿智","text":"亭子高临洗马河，亭前夜月动微波。\n倚阑天上箫声发，卷幔岩前树色多。\n未许韩家修五凤，欲从房相赋群鹅。\n连城芳草遥相忆，谁解玲珑醉后歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12437,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄庄蒙泉","author":"瞿智","text":"楼殿高低瞰海边，潮生静看月流川。\n秘函夜诵天仙下，香积晨斋绣佛前。\n碧盖团云阴寂寂，珠旒分雪溜涓涓。\n支郎绝爱山中景，吟得篇诗与世传。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12438,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄张伯雨","author":"瞿智","text":"服食年深玉雪臞，半簪华发不成梳。\n入山早弃人间事，闭屋独修河上书。\n丹火夜明鸡犬宅，剑光寒避斗牛墟。\n儗将一匹鹅溪绢，写作玄洲旧隐居。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12439,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"碧梧翠竹堂","author":"瞿智","text":"高堂背郭对青山，尽日褰帷景界宽。\n碧树欲随鸾影瘦，绿筠长伴鹤翎寒。\n水晶帘动云成片，环佩声閒雪作团。\n久负故人诗酒约，不嫌径去倚阑干。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12440,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵元章先生简奉讷斋判府相公一笑","author":"瞿智","text":"倅车新赴云间幕，文采风流有誉髦。\n未许茝兰纫客佩，又承雨露染恩袍。\n浓薰酒渍红螺甲，清梦华生玉兔毫。\n退食郡斋无一事，诗成浑似柳仪曹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12441,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"小言问疾兼怀匡山人","author":"瞿智","text":"东江漾漾春流浊，西郭深深辙迹疏。\n放浪久无狂贺老，风流独有病相如。\n门前看竹不题凤，溪上赏花多钓鱼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12442,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"五府驿代杨左丞留题","author":"张昱","text":"西楼柳风吹晚香，石榴裙映黄金觞。\n纤歌不断白日速，微雨欲度行云凉。\n笑看席上赋鹦鹉，醉听门前嘶骕骦。\n早晚平吴王事毕，羽书飞捷入朝堂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12443,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"艺圃","author":"唐元","text":"小园仅百步，花竹艺两行。\n垂垂结夏实，萧萧吹昼凉。\n盆池晓更静，照我须鬓长。\n复有青青蒲，风至互低昂。\n人生百岁中，弱草栖萤光。\n亮无贞坚节，何以禦雪霜？\n达人岂求名，进善贵自强。\n用世苟不能，退居固其常。\n旧种竹数十，生笋已满园。\n今年笋更繁，??穿邻垣。\n山童斸烟雨，便欲供朝餐。\n独不忍馋口，保此青琅玕。\n物微志则远，当异今日观。\n平生迟暮心，与尔同岁寒。\n种苋甲已坼，苦菜行亦秀。\n耰锄不惮勤，常恐地力瘦。\n旦旦望其长，灌溉那敢后。\n墙头有蓬蒿，不种而自茂。\n此意定如何？\n为尔吟清昼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12444,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋千曲","author":"杨维桢","text":"齐云楼外红络索，是谁飞下云中仙？\n刚风吹起望不极，一对金莲倒插天。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12445,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"六客诗 其一","author":"杨维桢","text":"有客有客来洞庭，驾罔象兮骖奔鲸。\n千家含景双龙精，玲珑七窍罗天星。\n莫邪出匣铿有声，一鸣一止三千龄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12446,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"六客诗 其二","author":"杨维桢","text":"有客有客来西域，龙高昂兮颈雌霓。\n腹如巴蚺凤非翼，口牙夜光集月魄。\n奇声劈山椎霹雳，道人因之写胸臆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12447,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"六客诗 其三","author":"杨维桢","text":"有客有客来象山，渡青海，飞龙湾。\n陪道主，登玉坛；吐星宿，呈琅玕。\n出入爪甲冰雪寒。\n号鬼母，惊神肝，一声吹裂虎豹关。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12448,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"六客诗 其四","author":"杨维桢","text":"有客有客来文山，如金如铁坚非顽。\n文山颓，不可攀，留尔亦足消群奸。\n静以安，方以直；带苍玉，佩文石，文星灿然守玄默。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12449,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"六客诗 其五","author":"杨维桢","text":"有客有客来赤城，碧梧风裁光珑玲。\n音含太古文七星，直如赤丝清如冰。\n洗秋壑，鸣秋声，金舂玉应和以平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12450,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"六客诗 其六","author":"杨维桢","text":"有客有客来滈池，皤然其腹蠢以痴。\n曾太古，春风知，至今面肉凝如脂。\n祖龙朽腐不足奇，和风自活千年枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12451,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"佛顶菊","author":"杨维桢","text":"莲社渊明手自栽，头颅终不惹尘埃。\n东篱若为摩挲看，西域亲曾受记来。\n妙色尽从枝上发，慧香直奔脑门开。\n明年九月重阳节，再托摩耶圣母胎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12452,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"王烈妇诗","author":"杨维桢","text":"介马驮驮百里程，青枫一夜血诗成。\n祇应刘阮桃花水，不似巴陵汉水清。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12453,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"改作","author":"杨维桢","text":"天随地老妾随兵，天地无情妾有情。\n指血齧开云峤赤，苔痕化作雪江清。\n愿从湘瑟声中死，不逐胡笳拍里生。\n三月子规啼断血，秋风无泪写哀铭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12454,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题刘阮山","author":"杨维桢","text":"两婿原非薄倖郎，仙姬已识姓名香。\n问渠何事归来早，白首糟糠不下堂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12455,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"大暑宴朱氏玉井香赋诗","author":"杨维桢","text":"朱公神仙人，冰雪照肺腑。\n祖帑阅羽化，祖书在册府。\n门掩一亩宫，虹梁跨风渚。\n乔木八九株，梧桐杂槐榉。\n中有玉井香，银云洒零雨。\n俗士不必来，佳朋来不拒。\n煮茶不无童，谋酒自有妇。\n核破玉刃霜，筒卷金茎露。\n方响歌洞仙，自题舞魔女。\n梧溪斥琴操，海岳订画谱。\n棹歌发复留，冰花凉欲语。\n焉知人间世，大火虐如虎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12456,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠僧一初","author":"杨维桢","text":"一初阇黎诸法解，吹得道人双剑箫。\n大道不知宗北秀，看山直欲尽南条。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12457,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"句","author":"杨维桢","text":"小洞桃花落香雪，大堤杨柳舞晴烟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12458,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"句","author":"杨维桢","text":"安危岂料关天步，生死犹能系俗情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12459,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉题朱泽民先生画山水图","author":"李祁","text":"洞庭之南湘水东，青山奕奕蟠苍龙。\n云阳峰高七十一，欲与衡岳争为雄。\n我家近在云阳下，来往看山如看画。\n十年尘土走西风，每忆云阳动悲咤。\n吴中胜士朱隐君，笔精墨妙天下闻。\n画图画出湘江水，青山上有云阳云。\n云阳山高湘水绿，十年不见劳心目。\n只今看画似看山，万里归情寄鸿鹄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12460,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"归来轩","author":"李祁","text":"忙处爱山看不当，归来结屋长相向。\n就中编作归来轩，田园正欠陶元亮。\n竹篱茅舍村数家，藜杖芒鞋时一访。\n红尘不比晋宋间，清风自是羲皇上。\n梦回枕簟书有声，客来午篆微烟障。\n绿阴入户如有约，白云出谷遥相望。\n邈知今日始有归，始信从前心是放。\n更容老子二十年，从教白发三千丈。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12461,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宜山谣 其一 椎髻舞","author":"谢应芳","text":"椎髻舞，击铜鼓，浅蛮生蛮皆安堵。\n卖刀买锄犁，衔恩人鸟语。\n犷俗驯，恶俗去，岂弟君子吾父母。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12462,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宜山谣 其二 除虎窟","author":"谢应芳","text":"除虎窟，虎皆散亡龙睡穴。\n湖南海北广东西，千里如今无白骨。\n无白骨，人何忧？\n每每旧屯田，年年稻花秋。\n我所思兮，龙江水流。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12463,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宜山谣 其三 枯桑","author":"谢应芳","text":"枯桑枯桑，徒为我薪。\n煮石弗糜，曷以食人？\n廪发于官，我命乃续。\n谁其主之？\n伊人如玉。\n伊人如玉，孚及豚鱼。\n诏我妇子，偿粟勿渝。\n厥粟固偿，厥德靡忘。\n我怀伊人，于羹于墙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12464,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宜山谣 其四 霹雳斧","author":"谢应芳","text":"霹雳斧，行天诛，百灵奔走群丑除。\n磔枭獍，醢䝟貐，招徕角端舞驺虞。\n日月两山明，畏境成康衢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12465,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宜山谣 其五 坎井蛙","author":"谢应芳","text":"坎井蛙兮渤澥，偷生虾蚬门，怒腹气何在？\n长鱼跋浪欲吞舟，竟作任公雪花鲙。\n蛙乎幸偷生，有愧输芒蟹。\n前度放蛙人，今日恩如海。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12466,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宜山谣 其六 生子以尹名","author":"谢应芳","text":"生子以尹名，有田须力耕。\n昔忧公租重，今喜公租轻。\n穷阎杼轴具，当路钧衡平。\n焦冥覆盆下，睹此白日明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12467,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宜山谣 其七 鞍马劳","author":"谢应芳","text":"鞍马劳，肉消髀，广西一去二千里。\n借箸筹边丞相喜。\n两年单骑八往还，青草黄茅瘴烟里。\n鞍马劳，有如彼，不负公，不掠美。\n一寸忠丹报天子。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12468,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄王叔明二首 其一","author":"倪瓒","text":"能诗何水部，爱石米南宫。\n允矣英才最，居然外祖风。\n钓丝烟雾外，船影画图中。\n他日千金积，陶朱术偶同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12469,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄王叔明二首 其二","author":"倪瓒","text":"几梦山阴王右军，笔精墨妙最能文。\n每怜竹影摇秋月，更爱山居写白云。\n秘笈封题饶古趣，雅怀萧散逸人群。\n今年七夕闻多事，曝画翻书到夕曛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12470,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句三首 其一","author":"倪瓒","text":"松陵第四桥前水，风急犹须贮一瓢。\n敲火煮茶歌白苧，怒涛翻雪小停桡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12471,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句三首 其二","author":"倪瓒","text":"人家住近江城外，月色波光上下天。\n风景自佳时俗异，泊舟閒咏白云篇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12472,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句三首 其三","author":"倪瓒","text":"白鸥飞处夕阳明，山色隔江眉黛横。\n试看三高祠下水，悠悠中有别离情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12473,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题高房山尚书著色山水","author":"倪瓒","text":"白云孤鹤暮知还，晚泊钱唐看越山。\n珍重今朝重展卷，吟诗作赋北窗间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12474,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画","author":"倪瓒","text":"萧萧风雨麦秋寒，把笔临摹强自宽。\n赖有□君相慰藉，松肪笋脯劝加餐。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12475,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋林山色图","author":"倪瓒","text":"寓馆风雨秋，閒门草苔翳。\n怀人思奋飞，携书此留滞。\n玉琴和幽吟，竹牖聊静憩。\n西山日在望，白云淡生媚。\n寂寞栖德园，清虚捐世味。\n石灶有馀烟，未收煮茗器。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12476,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"八月十八日萧閒道馆听袁南宫弹琴是日风雨萧然有感而作","author":"倪瓒","text":"玉琴转清亮，风雨更飘飖。\n疏桐荫高馆，朱槿耀芳条。\n生物曷可遏，抚事发长谣。\n弱龄陪清宴，楢发想垂髫。\n相见日以老，离居梦且遥。\n秋江渺云水，去鹤影遥遥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12477,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"应教题梅卷六所记当作「制」。】","author":"王冕","text":"猎猎西风吹倒人，乾坤无处不生尘。\n胡儿冻死长城下，始信江南别有春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12478,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画飞白竹","author":"王冕","text":"潇洒三君子，是伊亲弟兄。\n所期持大节，莫负岁寒盟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12479,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"句","author":"王冕","text":"生前不系黄金带，身后空馀白玉簪。\n白石皆成佛，苍头半是僧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12480,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句 其二","author":"刘涣","text":"鬓薄云松绿雾凉，春风额点麝脐黄。\n背人扑得双胡蝶，满扇蔷薇露水香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12481,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"句","author":"顾观","text":"重经白下桥头路，颇忆玄都观里花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12482,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀铁崖先生","author":"郭翼","text":"杨子十年官不调，湖山不负谪仙才。\n洞庭铁笛龙吹出，后土琼花鹤寄来。\n车子看花将一辆，雪儿劝酒拗莲台。\n时时对客理弦索，月色罗衫小样裁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12483,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和西湖竹枝词 其一","author":"宋元禧","text":"十三女郎不出门，父娘墓在葛山根。\n同携女伴踏青去，不上道旁苏小坟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12484,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"句","author":"张昱","text":"西河伶人火倪赤，能以丝声代禽臆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12485,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"句","author":"丁鹤年","text":"行踪不异枭东徙，心事惟随雁北飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12486,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"张武略","author":"王逢","text":"张武略，马中骠，鸷中鹗。\n神清气完志落落，决眦万里空沙漠。\n红巾据有南兰陵，无人先执蝥弧登。\n角弓朝分云汉月，血刃暮洗官壕冰。\n黄金璅甲镇江徼，食箪浆壶骈父媪。\n刁斗严城令密传，菜果漫村迹如扫。\n睦州方腊绝饟道，素服威名罢侵扰。\n陋邦寇劫谁使然，令我诸君师尽老。\n孟劳宝刀龟甲文，翻然佩之星入氛。\n虎贲千百济虓猛，禽狝草薙收奇勋。\n浙东元帅亦不群，罗闉狗附联阵云。\n两军鼓行屋瓦坠，杀声直上苍天闻。\n牙张距趯开复合，左启右胠烟坌接。\n势如惊飙振槁叶，冒围蹂贼贼胆詟。\n贺兰阴拱仅自守，檀公上计无乃走。\n王琳遗爱寿阳间，袁崧殉名沪渎口。\n妖星党现秋日微，英雄命薄将安归！\n连营陷敌泯功业，别部抱愤无晶辉。\n残兵故吏望乡哭，偷生可诛死可录。\n我招其魂歌楚曲，高寒吹下双鸿鹄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12487,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"张孝子","author":"王逢","text":"三朝雪涕大明宫，咫尺威颜卒感通。\n百辆珠犀归宝藏，千区松柏倚青空。\n天妃罢烛沧溟火，野史追扬孝里风。\n谁谓奸臣终愧汉，石榴苜蓿也封功。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12488,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"句","author":"王逢","text":"地荒存菊本，人老发梅花。\n红芳飞血尽，黄蝶上衣来。\n犬眠牛斗地，鲲跃凤凰池。\n乾坤人鲊瓮，岁月鬼门关。\n雪落蘋花尽，青浮山影来。\n帘卷东风燕子还。\n天清月浸淡梨花。\n草霜鹰始击。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12489,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"插秧妇","author":"戴良","text":"青袱蒙头作野妆，轻移莲步水云乡。\n裙翻蛱蝶随风舞，手学蜻蜓点水忙。\n紧束暖烟青满地，细分春雨绿成行。\n村歌欲和声难调，羞杀扬鞭马上郎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12490,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"哭杨大章先生二首 其一","author":"戴良","text":"家绍文元学，身安原宪贫。\n世方推独行，天忽夺斯人。\n客路谁倾盖，湖堤几咏春。\n回看携手处，不语自伤神。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12491,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"哭杨大章先生二首 其二","author":"戴良","text":"近到扬雄宅，徘徊至夕晖。\n那知三宿别，竟作九原归。\n许剑嗟何及，悬床事已非。\n祇应重过日，独泣向空扉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12492,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自题小像","author":"顾瑛","text":"儒衣僧帽道人鞋，天下青山骨可埋。\n若说向时豪杰处，五陵鞍马洛阳街。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12493,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵刘季章治中邀夏仲信郎中游永安湖诗","author":"顾瑛","text":"金粟寺中公廨静，白昼事閒如治蒲。\n沙棠为舟稳可泛，郎官之湖今岂无？\n啄花莺坐水杨柳，雪藕人歌山鹧鸪。\n日西上马踏归路，小队大呼惊道吾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12494,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"玉山草堂晚酌以高秋爽气相鲜新分韵得鲜字","author":"顾瑛","text":"玉山草堂秋七月，露梢风叶正翛然。\n出林新月清辉发，当竹幽花夜色鲜。\n羽客时来苍水佩，山僧频寄白云泉。\n文章录事休轻别，正好深樽满眼传。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12495,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]