[{"title":"闻高邮纳款漫成口号","author":"刘基","text":"闻道高邮巳彻围，却愁淮甸未全归。\n圣朝雅重怀柔策，诸将当知虏掠非。\n尧帝封疆元荡荡，世皇功业甚巍巍。\n忠臣义士同休戚，纵欲偷安总祸机。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8594,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春兴","author":"刘基","text":"近闻丹诏出天闱，圣主鸣谦下土知。\n岂意豺狼犹桀黠，未随干羽格庭墀。\n四郊多垒忠臣耻，百战无前壮士规。\n寄语总戎熊虎耐，莫教长愧伐檀诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8595,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"又用韵荅严上人","author":"刘基","text":"中夜登楼望紫微，北辰不动众星依。\n由来赤日行黄道，多事玄云变白衣。\n雪下蓬莱三岛隔，涛翻沧海万鱼飞。\n圣君宵旰惟恭巳，早晚阳和斡化机。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8596,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和孟伯真感兴诗","author":"刘基","text":"避难移家适远乡，忧时一夜百回肠。\n徒闻铁甲连戎垒，未睹钩车跨贼隍。\n不共班超争食肉，欲寻木羽学休粮。\n磨崖可勒中兴颂，努力诸公佐有唐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8597,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"妙成观用何逸林通判韵","author":"刘基","text":"我访仙家溽暑前，青枫绿柳暗晴川。\n竹根露湿登山屐，沙际鸥迎渡水船。\n云气长留虚白室，丹光直上蔚蓝天。\n纯阳道士重来日，为问蓬莱是那边。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8598,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"得胡仲渊书欢喜成诗奉呈石末公兼简三益军咨","author":"刘基","text":"故人忽寄一封书，愁眼还明病亦无。\n风满高林归猛虎，月凉古冢散妖狐。\n大廷职贡当遄复，戎马资粮不再输。\n更喜元侯契天意，良苗得雨应时苏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8599,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公秋日感怀见寄二首 其二","author":"刘基","text":"秋阴竟日似黄昏，夏旱良苗不半存。\n敢望鱼鸡充醓醢，尚期菘韭作饔飧。\n烟尘惨澹黄公石，云气苍茫紫极垣。\n作楫济川须传说，九关虎豹向谁论。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8600,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重阳日使者持诏用韵柬石末公","author":"刘基","text":"中元悲断羲和报，九日欢迎诏使来。\n紫禁羽林分垒壁，清秋辰极照中台。\n愿从黄石明三略，莫使诗人赋七哀。\n蚁垤牛涔休沸荡，泰山乔岳甚崔嵬。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8601,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵荅石末公伤用三苗之作","author":"刘基","text":"周用羌髳功有赫，唐通回鹘祸无訾。\n豳歌郑曲非同调，楚服秦骖实背驰。\n安得著鞭先祖逖，趋陪前跸学姚期。\n扶持圣主中兴业，整顿乾坤去诡随。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8602,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"石末公家人自台州来以诗问之","author":"刘基","text":"委羽山前海水飞，赤城霞色乱斜晖。\n过庭且喜诸郎至，怀土休嗟旧业违。\n李晟孤军终独捷，杜曾百战竟安归。\n丈夫事主心如石，去杀胜残自有机。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8603,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵岁菊","author":"刘基","text":"风霜摇落愈伤神，黄菊于予意自亲。\n迟莫长存君子操，凄凉不厌主人贫。\n天虚沆瀣流清气，月过青冥动细沦。\n此夜空庭耿相对，春花夏叶总埃尘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8604,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公岁除送穷之作","author":"刘基","text":"五夜雪霜清沴气，三阳玉烛照芳春。\n愿闻驯象来林邑，复睹封牛至罽宾。\n川后山祗争效职，淮夷海獠悉归臣。\n君王垂拱明光殿，圣敬如汤日日新。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8605,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵石末公题桃源卷","author":"刘基","text":"桃花逐水萦纡入，不觉清溪路浅深。\n执手问名惊见面，论新话旧各伤心。\n壶浆馈饷飧加璧，馆谷温存赠有金。\n似此情怀良匪恶，何嗟岁月去骎寻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8606,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再次韵时闰九月九日菊","author":"刘基","text":"秋来有菊即重阳，曷问他乡与故乡。\n愁见飞蓬垂雪领，笑搴落蕊入霞觞。\n陶时莫讶逢馀闰，遣兴聊图不永伤。\n岁晚移根深记取，勿令红紫间中黄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8607,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再用前韵颂菊","author":"刘基","text":"天遣幽花驻独阳，移根应自白云乡。\n酿成甘谷千年液，满泛瑶台百宝觞。\n人老容颜犹可返，戚寒霜雪复何伤。\n得时无用空妖冶，愧死姚家宫样黄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8608,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和石末公闻有诏使不至","author":"刘基","text":"祈招旦夕动遐心，疾首西归望好音。\n凤下丹霄云杳杳，鱼飞碧海雾沉沉。\n徒言雨露无私润，谁谓阳和未溥临。\n何日六师能电扫，周原依旧载驰骎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8609,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和石末公冬暖","author":"刘基","text":"总谓浮云解作霖，岂期云气漫成阴。\n何人奠璧频瞻仰，有客悲歌叹毒淫。\n顼帝权移天曷定，神龙用亢海徒深。\n掩身未服先贤训，向日空怀寸草心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8610,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"嘉兴寄王昌言学正","author":"刘基","text":"去年相别雁来初，今日相思柳拂渠。\n对酒放歌难再得，登高作赋近何如。\n黄华烨烨轻烟里，碧草油油小雨馀。\n欲棹扁舟寻逸少，为愁妨写换鹅书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8611,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感怀二首 其二","author":"刘基","text":"不到西州又十年，青山白水独依然。\n徒闻鸡狗供输尽，无那干戈迤逦延。\n天上九霄空玉烛，人间万井共贪泉。\n草中攫取云中送，坐待连茹紫闼边。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8612,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"二月二十三日自黄冈还杭途中作","author":"刘基","text":"日照江边春树林，繁花乱叶感人心。\n花间蛱蝶漫多事，叶底杜鹃非好音。\n举目山川成皓首，侧身天地一沾襟。\n解忧惟有尊中酒，疾病年来巳厌斟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8613,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"忧怀","author":"刘基","text":"群盗纵横半九州，干戈满目几时休。\n官曹各有营身计，将帅何曾为国谋。\n猛虎封狼安荐食，农夫田父困诛求。\n抑强扶弱须天讨，可惭无人借箸筹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8614,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春兴七首 其一","author":"刘基","text":"柳暖花融草满汀，日酣烟淡麦青青。\n枝间好鸟鸣求友，水底寒鱼陟负萍。\n异县光阴空荏苒，故乡蛇豕尚膻腥。\n感时对景情何极，悼往悲来总涕零。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8615,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春兴七首 其三","author":"刘基","text":"于越山城控海壖，春风回首忽经年。\n忧时望月青宵迥，怀土登楼白发鲜。\n江上波涛来渺渺，云中鸿鹄去翩翩。\n暮寒细雨馀花落，梦绕天涯到日边。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8616,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春兴七首 其五","author":"刘基","text":"卧龙山奠越王都，群水南来入镜湖。\n苦怪桑田非旧迹，还惊雉堞是新图。\n白波翠霭浮天际，绿树青莎到海隅。\n便欲投身归钓艇，不知何处有莼鲈。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8617,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中遣怀","author":"刘基","text":"青春苦寒雨太多，野水极目似秋波。\n湖上芳草生巳遍，山中美人愁柰何。\n思家无计铲荆棘，避地只恐触蛟鼍。\n落花零乱晚风起，坐看城头乌尾讹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8618,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送岳季坚入计筹山","author":"刘基","text":"阳羡先生故将孤，拂衣高蹈入玄门。\n瓮盈五粒松花酒，食有千年枸杞根。\n自得诗篇留客诵，频来猿鸟识人言。\n浮云富贵非吾愿，此意陶公可与论。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8619,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为贾性之题山水图","author":"刘基","text":"不见唐朝王右丞，世间画史少知名。\n何人貌得烟雨意，静听如闻风水声。\n远岫带云才隐约，斜阳秋树却分明。\n清泉素石堪乘兴，欲买扁舟过此生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8620,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题雪竹图","author":"刘基","text":"雪压江边脩竹林，沅湘晚色起愁阴。\n川光荡漾空清阔，山气玲珑太白深。\n未得稍云邀凤宿，可能映水学龙吟。\n无人谷里吹春律，直节虚中恐不禁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8621,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题脩竹图","author":"刘基","text":"九疑山下湘江畔，多少筼筜覆碧湍。\n自有清阴堪解愠，也能结实待栖鸾。\n濛濛暖翠晨烟洽，颗颗明珠夕露漙。\n长日焚香对图画，青冥风雨共凄寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8622,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画蒲萄卷子","author":"刘基","text":"西域蒲萄也自奇，画图惊见墨淋漓。\n迎风翠羽憣憣动，带露玄珠纂纂垂。\n此日散愁思酿酒，几回病渴想如饴。\n春窗隐几成幽梦，应共张骞到郅支。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8623,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"萧山任氏山堂","author":"刘基","text":"新堂结构倚岩阿，地僻无哗乐事多。\n日上黄鹂鸣翠竹，雨馀红鲤跃清波。\n消除暑气凭松柏，舒卷烟岚任薜萝。\n珍重主人能爱客，衰颜聊复为君酡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8624,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"以纨扇赠奎上人并寄以诗","author":"刘基","text":"新裁纨扇如圆月，寄与灵峰奎上人。\n不共青蒲争巧拙，好将白氎伴清新。\n董心炎暑谁能敌，应手凉风自有神。\n莫怨秋来藏箧笥，明年朱夏更相亲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8625,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"灵峰寺栖云楼","author":"刘基","text":"灵峰之中楼倚山，山云日夕栖其间。\n九霄雨露随高下，六月风雷送往还。\n青嶂晓光浮藻棁，银河夜气湿松关。\n天台向上无多路，鹫岭烟霞此可攀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8626,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题瑞上人山水图","author":"刘基","text":"上人性僻耽山水，应是王维第二身。\n兰渚流觞新到越，蓝田别业旧通秦。\n驱驰翰墨回龙虎，簸美风雷感鬼神。\n羁旅相逢聊自慰，莫思天地有烟尘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8627,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"崇福寺俦上人看山楼","author":"刘基","text":"为爱山中世事疏，看山终日坐茅庐。\n林花涧草香无际，翠壁丹崖锦不如。\n禹穴风雷翻石鹞，耶溪波浪动金鱼。\n此时应悟幽栖乐，底用凌云献子虚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8628,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宗上人溪山亭","author":"刘基","text":"湖上清溪溪上山，山亭结构俯人寰。\n窗中树色宜晴雨，门外滩声自往还。\n鍊药井寒玄鹤逝，采莲舟去碧波闲。\n春兰秋桂年年好，憔悴风尘漫厚颜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8629,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和新罗严上人秋日见寄二首 其一","author":"刘基","text":"露吟风清木叶疏，蓼花莎草没阶除。\n子云词赋空投阁，仲蔚蓬蒿漫索居。\n群盗只今齐得意，故乡从此遂无书。\n镜中短发非松柏，岁晚看看不似初。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8630,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再用韵荅严衍二上人 其一","author":"刘基","text":"厚禄故人音问疏，天官不拟介推除。\n莫思浮世尘埃事，好共深山木石居。\n月满高楼留客饮，灯明寒榻课儿书。\n城头鼓角沉沉夜，肠断乡关人梦初。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8631,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再用韵荅严衍二上人 其二","author":"刘基","text":"蔓草萋迷野色微，嗷嗷鸣雁欲谁依。\n残花露淡胭脂靥，落木霜凋薜荔衣。\n万国旧闻车轨一，九州今见劫尘飞。\n总戎安得英雄将，不放龙蛇起杀机。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8632,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"复用韵荅严上人 其一","author":"刘基","text":"闭门无事往来疏，窗外从他草不除。\n食肉巳违三月味，谋身欲去九夷居。\n人情自古怀乡土，天下何时罢羽书。\n莫向西风苦惆怅，白云流水只如初。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8633,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"复用韵荅严上人 其二","author":"刘基","text":"西风吹树夕阳微，斥鴳鹪鹩各有依。\n幕府三年双短鬓，乡关千里一沾衣。\n江淮渺渺人烟少，梁楚茫茫鬼燐飞。\n诛暴保民黄石略，将军莫自失戌机。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8634,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题寒林图","author":"刘基","text":"摇落江边秋树林，凄凉久客二毛侵。\n藤萝岁晚龙蛇死，丛薄天寒虎豹深。\n流水斜阳人远近，青烟白草雁飞沉。\n桂花自在山中发，怅望西风起夕阴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8635,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题访隐图","author":"刘基","text":"忽忆山中陶隐居，杖藜冲晚谒茅庐。\n林花浥露红无比，涧草含烟绿有馀。\n金鼎丹光缠日月，银河流水到阶除。\n松间白鹤通人语，长向瑶台寄远书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8636,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宿贾性之市隐斋","author":"刘基","text":"今年冬雨不作雪，屋头鸟声浑似春。\n绝怜草色绿铺地，可爱梅花白照人。\n时物巳迎新岁换，交情空向异乡亲。\n忽思昨夜残灯里，错认还家梦是真。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8637,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题陆放翁湖上诗后","author":"刘基","text":"放浪江湖一老翁，若耶溪上几春风。\n门前流水斜还直，篱外闲花白复红。\n甚欲赋诗追杜子，也能纵酒学陶公。\n细看墨迹成怀古，叹息他乡类断蓬。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8638,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和孟伯真感兴四首 其一","author":"刘基","text":"五载江淮百战场，乾坤举目总堪伤。\n巳闻盗贼多于蚁，无柰官军暴似狼。\n绿水青山人寂寂，长烟蔓草日荒荒。\n弟兄零落音书绝，肠断春风一雁行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8639,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和孟伯真感兴四首 其二","author":"刘基","text":"无用文章岂疗饥，劳生筋骨巳支离。\n穷愁杜甫家何在，落魄陈平计未奇。\n草泽狐狸三窟固，江湖波浪一帆危。\n故园春色年年到，绿叶红花好为谁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8640,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和孟伯真感兴四首 其三","author":"刘基","text":"平时盗贼起成云，厚禄能忘愧庶民。\n樽俎自高廊庙策，经纶不用草茅人。\n思家远道风尘恶，争食空山虎豹嗔。\n莫怪洛阳年少客，持书痛哭向枫宸。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8641,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和孟伯真感兴四首 其四","author":"刘基","text":"多事繁花白映红，无愁细草绿浮空。\n春秋迭代人先老，天地生成意不穷。\n凤鸟长辞西岭树，鲸鱼自起北溟风。\n几时学得玄真子，箬笠蓑衣一短篷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8642,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵张德平见寄","author":"刘基","text":"漠漠长烟野色昏，霏霏细雨湿衡门。\n乾坤象纬寻常转，江海波涛日夜翻。\n贾谊奏书哀自哭，屈原心事苦谁论。\n近逢使者徵遗逸，说道岩廊纳谠言。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8643,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题承天观","author":"刘基","text":"吴山顶上承天观，玉牒金符镇地灵。\n百尺楼台依斗极，九霄风露出窗棂。\n江声汹涌蛟龙阙，云气虚无翡翠屏。\n见说蓬莱恰相对，仙凡只在隔沧溟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8644,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感兴三首 其三","author":"刘基","text":"春院微风柏叶垂，朝寒坐看雀争枝。\n娟娟坠雨抛苍藓，点点轻花赴绿池。\n景物关情悲自老，江山满目惜时危。\n长生应有真仙诀，漫把黄金驻黑髭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8645,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"可叹","author":"刘基","text":"风雨潇潇听晓鸡，忽思世事一悲悽。\n当时重禁藏矛戟，今日呼令学鼓鞞。\n未见争锋曾奏捷，徒闻却走不先迷。\n劫灰日夜飞相逐，随处空林有燕栖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8646,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"五月二十九日喜雨奉贺石末元帅","author":"刘基","text":"使君设醮天皇格，道士陈章玉女开。\n遂遣赤松来作雨，更教玄武下乘雷。\n凉飙细拂花间入，润色新从草际回。\n岂但农夫堪一饱，野人亦有酒盈杯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8647,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"用前喜雨韵寄呈石末元帅时戍卒有不轨谋蓄而未发公治之以意卒遂返正故发之以言且并志祈雨有应也","author":"刘基","text":"将军渡水流澌合，太守弯弧巨石开。\n但觉诚心通日月，不知生意在风雷。\n思莼未许归张翰，结草终当获杜回。\n可怪疏狂谪仙子，兼旬浪饮六千杯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8648,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题紫虚观用周伯温韵","author":"刘基","text":"少微山直太微宫，山下楼台起半空。\n丹井石床缠地络，琼窗翠户出天风。\n传闻仙子常时到，应是神霄有路通。\n会待九秋明月夜，高吹铁笛上青葱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8649,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题紫虚道士晚翠楼","author":"刘基","text":"晚翠楼子好溪南，溪山四围开蔚蓝。\n微阴草色尽平地，落日木杪生浮岚。\n岩畔竹柏密先暝，池中芰荷香欲酣。\n闻说仙人徐泰定，骑鸾到此每停骖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8650,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"叶叔安南溪草堂即事","author":"刘基","text":"溪上草堂盈十寻，疏杨密竹各成阴。\n绿烟绕舍桑畦静，白水当门稻遂深。\n过雨忽翻金碧影，凉蜩乱发管弦音。\n此时不省愁何在，坐到鸦喑月满林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8651,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"妙成观北亭用何逸林韵","author":"刘基","text":"最爱云山满目前，更怜亭榭俯清川。\n草深林蔼迷樵径，花落岩霏点客船。\n碧涧金芝新出地，丹崖石穴旧通天。\n神仙应在楼头上，翠羽霓旌下日边。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8652,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"以梨饷石末公侑之以诗","author":"刘基","text":"山人见饷含消实，青紫相排个个圆。\n共道解烦同绛雪，也知止渴胜甘泉。\n种从汉武樊川得，名并张公大谷传。\n珍重使君方闵雨，急须走送涤熬煎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":8653,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]