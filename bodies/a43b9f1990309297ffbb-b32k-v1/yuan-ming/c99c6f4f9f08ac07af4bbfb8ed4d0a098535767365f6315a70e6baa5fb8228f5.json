[{"title":"丁酉仲冬即景十六首 其二 地炉煨芋","author":"叶颙","text":"地炉煨芋足充饥，凉薄家声胜富儿。\n李密懒残风味在，寒灰冷火澹相知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6067,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁酉仲冬即景十六首 其三 云巢鹤睡","author":"叶颙","text":"烟梢深处稳栖翎，标格孤高迥出群。\n只恐听琴惊梦醒，踏翻松顶一巢云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6068,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁酉仲冬即景十六首 其四 月岭猿啼","author":"叶颙","text":"树头清啸两三声，纸帐梅花睡欲成。\n唤醒冷泉亭上梦，岭云飞动月初明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6069,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁酉仲冬即景十六首 其五 玉楼吹笛","author":"叶颙","text":"天风吹笛落天涯，万瓦霜清月影斜。\n惊醒羁人犹自可，江城只怕落梅花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6070,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁酉仲冬即景十六首 其六 梅屋弹琴","author":"叶颙","text":"琴张瓯茗伴炉薰，三弄梅花月下庭。\n香影孤高音调古，空阶谁许鹤来听。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6071,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁酉仲冬即景十六首 其七 冲寒贳酒","author":"叶颙","text":"拥被酸吟雪未晴，拾樵路断闭松扃。\n相如病渴谁来管，自整冲寒贳酒瓶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6072,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁酉仲冬即景十六首 其八 踏雪寻梅","author":"叶颙","text":"云碍前村路不通，暗香疏影杳无踪。\n琼琚踏碎知何处，月上孤山第一峰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6073,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁酉仲冬即景十六首 其九 梅梢月落","author":"叶颙","text":"斗转参横午漏迟，一轮寒魄堕南枝。\n玉箫吹彻青霜冷，正是诗人梦破时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6074,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁酉仲冬即景十六首 其十 松径云深","author":"叶颙","text":"数片和烟裹石苔，空林长惹鹤猿猜。\n天风吹度长松下，僮子殷勤扫不开。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6075,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁酉仲冬即景十六首 其十一 雪夜乘舟","author":"叶颙","text":"月色波光共一溪，水天上下漾玻璃。\n孤舟蓑笠清如许，何必山阴访戴逵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6076,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁酉仲冬即景十六首 其十二 霜晨觅句","author":"叶颙","text":"霜月凌凌独凭阑，推敲未定怯衣单。\n眼前佳句无人识，诗比梅花瘦一般。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6077,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁酉仲冬即景十六首 其十三 枯木寒鸦","author":"叶颙","text":"老树经霜带夕晖，十围横跨小桥西。\n群鸦不怕云巢冷，夜夜黄昏来上啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6078,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁酉仲冬即景十六首 其十四 孤松老鹤","author":"叶颙","text":"城郭依前岁月非，巢空云冷影相依。\n长松月落天风远，时向青山尽处飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6079,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁酉仲冬即景十六首 其十五 书窗梅影","author":"叶颙","text":"疏花冷蕊映书窗，勾引逋仙蝶梦狂。\n纵使春风吹散后，又随霜月上书囊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6080,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁酉仲冬即景十六首 其十六 石鼎茶声","author":"叶颙","text":"青山茅屋白云中，汲水煎茶火正红。\n十载不闻尘世事，饱听石鼎煮松风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6081,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寻梅二首 其一","author":"叶颙","text":"石根岩畔与山阴，瘦马羸僮到处寻。\n流水溪桥沙路远，何愁云密更林深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6082,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寻梅二首 其二","author":"叶颙","text":"落日孤村石径斜，挨云深入野人家。\n小溪流水春风暖，恐有枝头半吐花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6083,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"松径清游","author":"叶颙","text":"驴载新诗仆抱琴，白云幽径夕阳林。\n天风十里青松顶，满耳笙箫太古音。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6084,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅影二首 其一","author":"叶颙","text":"寒蜂冻蝶谩惊猜，积案春风拨不开。\n霜月满窗诗梦醒，更无一点暗香来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6085,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅影二首 其二","author":"叶颙","text":"夜深随月上纱窗，妆点西湖处士房。\n惊醒一床胡蝶梦，春风冷落淡无香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6086,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠相士二首 其一","author":"叶颙","text":"貌古如松卧壑秋，虬髯鹤发炯双眸。\n衰颜未用烦公相，自许书生老不侯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6087,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠相士二首 其二","author":"叶颙","text":"虎视阴阳胆气粗，平生事业遂雄图。\n不知侃侃怡怡辈，也入先生相法无。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6088,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋日南楼晚霁即景","author":"叶颙","text":"梦破虚堂生暮愁，晚云将雨过南楼。\n西风扫净长空翳，留得天边桂子秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6089,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读秦始皇纪","author":"叶颙","text":"衡石稽程了万几，日斜犹未下丹墀。\n巡南筑北关防尽，祸起萧墙却不知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6090,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春雪","author":"叶颙","text":"妆点琼英上玉梢，懑人春雪遍芳郊。\n情知不是丰年瑞，赢得长安酒价高。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6091,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"清明有感","author":"叶颙","text":"落花庭院晚风轻，芳草池塘夜雨晴。\n独步独吟消白日，闲愁闲闷过清明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6092,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"得耳聋疾戏呈无闻聪老","author":"叶颙","text":"晓枕不闻喧涧瀑，夜窗宁听响松风。\n虽然未遇马师喝，也胜前人三日聋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6093,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题卞和泣玉图手卷二首 其一","author":"叶颙","text":"一献无功便合休，殷勤三献欲何求。\n至今寒璞荆山下，月色苍苍万古秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6094,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题卞和泣玉图手卷二首 其二","author":"叶颙","text":"忍把连城价放低，临刑刖足未心灰。\n丈夫自古惭轻献，女子从来耻自媒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6095,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀赤松云?旧隐","author":"叶颙","text":"白云青巘是吾家，门外长松树树花。\n身在异乡归未得，梦中犹赏旧烟霞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6096,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"月夜","author":"叶颙","text":"万片白云归岫后，一轮明月到天时。\n乾坤清气无人识，借得樵夫短笛吹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6097,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题雪岩画倒兰（黄瑨卿题云袅袅春风一样吹托根高处欲何为从渠自作颠倒想终有悬崖撒手时瑨卿举进士历官至行省左丞乞身归私第幅巾布衣澹如也予喜赋一绝于其后）","author":"叶颙","text":"托根孤峻极尊崇，俯视群芳迥不同。\n到底谦恭隐君子，何曾仰面笑春风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6098,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梦故友清玉泉首座","author":"叶颙","text":"飘零湖海昔年僧，握手论心久未能。\n梦里匆匆忽相睹，解言云屋共青灯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6099,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"月中仙女骖鸾图","author":"叶颙","text":"云边仙女夜骖鸾，月下霓裳舞袖宽。\n吹彻紫箫风露下，玉容玄发不胜寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6100,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽居杂兴","author":"叶颙","text":"疏斋清夜醒，修径白云长。\n袖归南山影，心潜上国光。\n西风岩桂老，细雨野椒黄。\n地僻人踪少，烟扉开竹房。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6101,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和张仲达客苏州春暮览古韵","author":"叶颙","text":"异国逢春暮，惊心对日西。\n湖生吴水冷，云压楚山低。\n老树风霜古，荒城烟雨迷。\n夫差旧台馆，花落鹧鸪啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6102,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重阳感兴（甲午岁）","author":"叶颙","text":"佳节明朝是，同谁上翠微。\n西风人易老，南国雁初飞。\n黄菊清香晚，乌纱白发稀。\n牛山今昔异，感慨欲粘衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6103,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次李本存见寄韵（本存江西省掾寻调永喜巡检秩满寓婺之道林精舍）","author":"叶颙","text":"陶令归官后，琴书对酒杯。\n未闻丹诏起，长伴白云来。\n梦里乡关远，闲中岁月催。\n草庐春渐暖，应动武侯雷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6104,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"复次本存见寄韵","author":"叶颙","text":"写兴诗千首，论心酒一杯。\n初疑彭泽去，旋喜谪仙来。\n老叹青衫冷，愁惊白发催。\n从今便高卧，鼻息撼春雷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6105,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送应空谷上人游吴寻师仆于湖山泉石有畴昔之好末章故及之 其一","author":"叶颙","text":"远近西湖路，高低释氏宫。\n猿啼青嶂月，潮落碧江风。\n钟鼓残阳外，楼台烟雨中。\n挑包明日去，回首白云东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6106,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送应空谷上人游吴寻师仆于湖山泉石有畴昔之好末章故及之 其二","author":"叶颙","text":"落日南朝寺，吟筇几度登。\n欲寻前日路，去访昔年僧。\n浙水生新浪，吴云暗旧灯。\n阿师如到彼，为谢岭南能。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6107,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题应上人净深精舍","author":"叶颙","text":"一室绝纤尘，炉烟贝叶经。\n每呼明月至，常遣白云扃。\n竹色侵虚幌，荷香袭小亭。\n晚来开瓮牖，放入数峰青。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6108,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"代张匡敬送宪史武文献迁浙西","author":"叶颙","text":"儒衡家世旧，气节老弥刚。\n谁谓更千古，犹能出一郎。\n乌台知姓字，白简凛风霜。\n后夜吴江月，清光应更长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6109,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感怀","author":"叶颙","text":"天步艰难日，人情向背秋。\n惭无医世术，喜免抱官囚。\n发愤寻青史，消愁数白鸥。\n草庐诸葛辈，幸出为时谋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6110,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"午窗睡起偶吟閒花落砚池小儿汝廉率尔应声曰香絮粘棋局遂足成一律","author":"叶颙","text":"睡醒碧窗虚，无人松影移。\n庭空晴昼永，径静夕阳迟。\n香絮粘棋局，閒花落砚池。\n时看烟树鸟，飞过白云枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6111,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题扇面景物","author":"叶颙","text":"溪童双眼碧，照映绿波心。\n钓艇横烟水，渔歌起夕阴。\n峰巅凉月上，涧底白云深。\n傲睨天风顶，芳尊独自斟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6112,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"小儿士廉赋碧桃胡蝶二诗呈改为赋唐律示之 其一","author":"叶颙","text":"王母下瑶台，琼花溢路栽。\n似嫌红粉俗，长傍白云开。\n玉质风前舞，天香月下来。\n刘郎犹未识，蜂蝶莫惊猜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6113,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"小儿士廉赋碧桃胡蝶二诗呈改为赋唐律示之 其二","author":"叶颙","text":"粉翅舞风轻，双飞趁晚晴。\n联翩花日暖，来往柳烟清。\n穿径寻香絮，过墙逐落英。\n庄生千载梦，惊醒世间情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6114,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"纸帐","author":"叶颙","text":"琴榻生虚白，吟帷异马融。\n睡无红雾入，醒有白云封。\n月窟光千丈，尘寰路万重。\n梅窗香影瘦，清梦听松风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6115,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"己酉新正","author":"叶颙","text":"天地风霜尽，乾坤气象和。\n历添新岁月，春满旧山河。\n梅柳芳容稚，松篁老态多。\n屠苏成醉饮，欢笑白云窝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6116,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"七月望夕予曳杖步月直造峰顶高吟朗咏划然长啸兴尽而返明日山下居人咸言闻清啸惊醒尘梦者数十家予因赋诗以纪其事云","author":"叶颙","text":"藜杖策风轻，芒鞋步月明。\n鹤翻青径影，猿度翠岩声。\n草露沾衣冷，松泉漱石清。\n崇岗发长啸，尘世梦惊醒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6117,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日东篱晚兴","author":"叶颙","text":"杳杳柴桑路，东篱对夕阳。\n断虹初霁雨，新雁欲迎霜。\n黄菊秋香老，乌纱雪鬓凉。\n王弘人去远，目送楚峰长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6118,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闲居效陶体","author":"叶颙","text":"彭泽归官后，悠然对菊花。\n风云生杖履，雨露蔚桑麻。\n巷僻门常设，樽空酒屡赊。\n柴桑长在望，三径接晴霞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6119,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"忆先母","author":"叶颙","text":"忆别慈颜后，年华逝水流。\n萱堂犹一日，松墓竟千秋。\n诲育恩无尽，生成德靡酬。\n白云空入望，清泪湿衣裘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6120,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"己酉雪","author":"叶颙","text":"人世白雪封，光辉万境同。\n江山迷夜月，宇宙动春风。\n柳絮高情远，梨花旧梦空。\n蹇驴怀郑綮，清赏灞桥东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6121,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日","author":"叶颙","text":"霜重雁初飞，江空蟹正肥。\n黄花经雨瘦，乌帽任风欹。\n满饮王弘酒，豪吟杜牧诗。\n东篱多感兴，况近夕阳时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6122,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚回自赤松小桃源赋二首 其一","author":"叶颙","text":"仙子丹成后，乘鸾翠霭间。\n笙箫风细细，环佩夜珊珊。\n羊化云埋石，猿吟月满山。\n桃源春欲老，花落夕阳间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6123,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚回自赤松小桃源赋二首 其二","author":"叶颙","text":"径锁绿苔新，庭空市井尘。\n草青岩洞雨，松翠石林春。\n初起名空在，留侯迹已陈。\n玉箫声断久，片月下嶙峋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6124,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"观史有感","author":"叶颙","text":"闲中观史册，感慨泪潸然。\n幸喜平生拙，惊呼异代贤。\n张良知说驾，范蠡解乘船。\n馀子乘酣者，贪杯醉不眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6125,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪水煎茶","author":"叶颙","text":"雪水烹佳茗，寒江滚暮涛。\n春风和冻煮，霜叶带冰烧。\n陶谷声名旧，卢仝气味高。\n党家宁办此，羔酒醉清宵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6126,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"癸丑新正试笔二首 其一","author":"叶颙","text":"雪霁冰霜尽，泥牛喜著鞭。\n性情犹旧日，节序又新年。\n世态萦胸次，春光耀目前。\n屠苏今日酒，自笑不吾先。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6127,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"癸丑新正试笔二首 其二","author":"叶颙","text":"旧腊随宵尽，新阳向曙来。\n晴光浮竹叶，春色满椒杯。\n稚绿妆梅萼，娇红透杏腮。\n雪消江岸柳，便学舞章台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6128,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"诞日（前元己丑仲春予知命之年贤甥童中州赋诗寿予揆今二十五年矣甥亦五旬予曾赋五言唐律一首今书于此云）","author":"叶颙","text":"常忆垂弧日，俄惊学易年。\n高情轻富贵，雅志乐林泉。\n白发三千丈，清吟数百篇。\n行藏皆在我，消长系乎天。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6129,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梅亭负暄","author":"叶颙","text":"梅屋朝晖暖，融融体气舒。\n曲肱红日里，闭目黑甜馀。\n天地温和候，乾坤混沌初。\n盎然春透髓，尽晒腹中书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6130,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"小春探梅","author":"叶颙","text":"独步孤山下，来寻带藓枝。\n江村流水晚，沙路夕阳迟。\n僧屋闲云径，人家小竹篱。\n春风吹薄袂，细细袭诗脾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6131,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"采莲歌","author":"叶颙","text":"越女浙江头，烟波万顷愁。\n往来荷叶浦，荡漾木兰舟。\n岛阔香云冷，江空明月秋。\n清讴三四曲，声断白蘋洲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6132,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋日有怀帅府李从道二首 其一","author":"叶颙","text":"雨后复斜阳，天风两袖凉。\n黄花秋梦淡，红叶晚晴长。\n访旧心千里，浇愁酒一觞。\n诗翁定何许，西望白云乡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6133,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋日有怀帅府李从道二首 其二","author":"叶颙","text":"子别金盆后，烟岚野鹤愁。\n心应游北里，身尚寄南州。\n落月双溪梦，西风一剑秋。\n夕阳山下寺，时忆昔年游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6134,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]