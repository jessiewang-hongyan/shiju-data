[{"title":"览古四十二首 其十三","author":"杨维桢","text":"出关弃繻子，南征笑狂生。\n左右无黄发，淫夫抰之行。\n戮杀汉使者，君臣起大兵。\n尉他羁汉绶，何曾请长缨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1143,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其十四","author":"杨维桢","text":"成都卖卜士，大易先天心。\n弟子一区宅，桑榆有馀阴。\n何为天禄阁，忘身几陆沈。\n门前载酒者，奇字时相寻。\n为谢门前客，从今传酒箴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1144,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其十五","author":"杨维桢","text":"子陵江海客，本非沮溺伦。\n仁义立奇论，岂果忘吾民。\n狂奴作故态，飘然归富春。\n客星犯帝座，太史奏天文。\n故人信符谶，三公等浮云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1145,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其十六","author":"杨维桢","text":"武丁梦良弼，审象极冥搜。\n光武思故人，物色在羊裘。\n彭城有处士，君恩贲林丘。\n股肱不为用，颜色徒相求。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1146,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其十七","author":"杨维桢","text":"董卓劫慈明，次以及伯喈。\n子龙独何人，谈笑却啀啀。\n高视梁砀上，片云卷而怀。\n古来高世士，尘埃岂能埋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1147,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其十九","author":"杨维桢","text":"孔公荐一鹗，义烈争秋霜。\n矢心报知己，讨贼尊天王。\n渔阳掺英愤，夫岂病悖狂。\n营门三尺棁，杀气披搀抢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1148,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其二十","author":"杨维桢","text":"会稽嵇叔夜，才气浩不群。\n平生癖于锻，馀好在琴尊。\n不如一长啸，携琴学苏门。\n可怜广陵散，奇弄今无闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1149,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其二十二","author":"杨维桢","text":"知子石司徒，分材靳齐奴。\n诸仲财不如，财穷东市诛。\n吁嗟石司徒，知子良不愚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1150,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其二十三","author":"杨维桢","text":"洛阳轻薄子，挟弹走春嬉。\n结交金谷友，谄事贾午儿。\n蔑弃慈母训，乾没不知几。\n感已赋閒居，犹以拙自悲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1151,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其二十四","author":"杨维桢","text":"弹琴戴安道，焦桐破奇声。\n蔚宗与文季，俱以琴自鸣。\n天子不得屈，王公不能聆。\n独怜褚司徒，银柱老齐伶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1152,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其二十六","author":"杨维桢","text":"青青五柳宅，贫无三径资。\n去参建威幕，为贫良亦非。\n彭泽八十日，胡为遽来归。\n乃知决然逝，非为乡里儿。\n首恶王休元，酒亦无所辞。\n华轩欲载我，我心讵能违。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1153,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其二十七","author":"杨维桢","text":"王湛蓄深器，世人不能窥。\n大慧实若愚，人遂以为痴。\n可怜济父子，同门不识之。\n何况隔千里，而欲求人知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1154,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其二十八","author":"杨维桢","text":"羲之在东床，风操夙所称。\n蓝田誉转重，胡乃意不平。\n出吊曲在我，反恶固其情。\n以此悻悻死，无异匹妇轻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1155,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其二十九","author":"杨维桢","text":"韩信卜母地，旁置万人庐。\n郭公卜邻水，长洲偶成墟。\n千秋杨子窆，投弃同江鱼。\n裸发何为者，厌魅开籧篨。\n孰借神丁火，焚却青囊书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1156,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其三十","author":"杨维桢","text":"郭黁精术数，知晋必亡秦。\n逃秦远归晋，追兵杀亡臣。\n洛阳牛背叟，读书孝其亲。\n凉州未经破，先归忽如神。\n术人不灵已，哲士固全身。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1157,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其三十二","author":"杨维桢","text":"尝疑王孝子，素履朴且庄。\n门生服县役，径行想不扬。\n孝子躬馌具，磬折在道傍。\n门生役已脱，诡道由此行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1158,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其三十三","author":"杨维桢","text":"郑州跛男子，识者惟客师。\n深沈有客量，不为同列知。\n唾而戒其弟，俛世一何卑。\n君看白水涧，沫额宣驽资。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1159,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其三十四","author":"杨维桢","text":"世疑狄文惠，不知娄师德。\n娄公吾不贤，此意人未识。\n古来嫌忌间，吾道忧比迹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1160,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其三十五","author":"杨维桢","text":"开元刘神童，名字瑞一时。\n文学不济世，鞭算竞刀锥。\n招权啖士口，使不得有訾。\n任数不任道，兴利固如斯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1161,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其三十六","author":"杨维桢","text":"小儿贺季真，弃官亦弃宅。\n远谒王道者，去问术黄白。\n何物袖中藏，去道万里隔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1162,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其三十七","author":"杨维桢","text":"严家儿，八岁杀父姬，严家父称奇。\n养成虎豺恶，腐儒弄虎髭。\n嗟吁豺虎天早毙，七十慈亲免官婢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1163,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其三十九","author":"杨维桢","text":"厚施而薄望，郭解愧朱家。\n大唐郭氏子，手剑寒奸邪。\n赙金四十万，主名不知夸。\n结客豪侠场，此客实无加。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1164,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其四十","author":"杨维桢","text":"昨日满头花，堂上争春妍。\n今朝大风起，花落玉津园。\n旧地易淮陕，取馘谐戎门。\n可怜于期首，不谢永州魂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1165,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"览古四十二首 其四十一","author":"杨维桢","text":"东人送降款，西人纳降城。\n长沙李太守，誓死城不盟。\n高楼一举火，老稚同焦冥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1166,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"贸丝词","author":"杨维桢","text":"鸣鸠毋止棘，止棘为摧薪。\n女子毋贸丝，贸丝为弃人。\n相逢誓作同穴亲，大礼如一失，结发不终身。\n外为狂夫暴，内为兄弟哂。\n寄语贸丝女，卜语不可信，况乃卜非真。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1167,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赵公子舞剑歌","author":"杨维桢","text":"赵公子，千人英。\n读书万卷愁无成，负此长身九尺如长城。\n雪芙蓉，玉青骢，我将挟尔成大功。\n腰缠十万欲何往，直上北台观虎龙。\n道逢铁笛仙，把酒九峰前。\n酒酣为我拔剑起作浑脱伎，白虹绕地乌风旋。\n躩然指天天为穿，天狗堕地顽星坚。\n老铁酒酣为椎鼓，壮士冲冠发倒竖。\n老增撞斗何足为，鸿门突立卫真主。\n赵公子，千人英，为君酌酒肝胆倾。\n忍见东南吴楚坼，慎莫脱手踊跃逝去双龙精。\n君不见我家古铁三尺冰，粤砥荡磨新发硎。\n不学区区一人敌，上为天子匡前星。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1168,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送邓炼师祁雨歌","author":"杨维桢","text":"东海水，枯沃焦，神工无处寻天瓢。\n松陵太平守，闵民苦疾呼。\n邓师诛寇妖，诛跛妖，役丁甲，蚩尤鼓风旗倒搜，插龙龙走白龙潭，迅霆夜擘干将匣。\n于乎县令不积薪，将军不拜井。\n炉烟一穗达丹诚，三日甘霖云万顷。\n君不见漕家粮船星火急，瓜州渡头河水涩。\n苍天苍天不悔祸，海民尽作枯鱼泣。\n邓师鬼工烦叱诃，稻田粒粒真珠多。\n松陵太守报新政，和气化作击壤尧民歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1169,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送史才叟迁上饶吏代冯元赠","author":"杨维桢","text":"一门三相两封王。\n见说郎，美文章。\n收拾长才青眼是黄堂。\n柏府槐厅朝暮直披玉雪倚冰霜。\n灵山怀玉郁苍苍。\n古城隍，带仙房。\n瑶草紫芝随处发天香。\n尽道如今迁外好，只今朝风送玉琳琅。\n金缕唱，锦帆张。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1170,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送司农丞杭公还京诗","author":"杨维桢","text":"十年农星晦无光，太史昨夜占五潢。\n国家大本重谷禄，曰奎曰胃明天仓。\n中书垣次大司农，署秩列九卿，尊大府，春耕藉亩冬藏冰，六十五官八九扈。\n杭公均输少卿属，赋足国家民亦足。\n农田漕运一时了，文如锦绣人如玉。\n归来奏仪帝曰俞，诏书宽大赐民租。\n太平治象今日见，不用再讲贞元宰相均田图。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1171,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送杨明归越觐亲","author":"杨维桢","text":"天西白云天东飞，乌台春之乌依依。\n高堂游子归未归。\n堂前春草生春晖。\n行行舟发彭郎矶，勿遣霜霜露露沾人衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1172,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送客洞庭西","author":"杨维桢","text":"送客洞庭西，雷堆青两两。\n陈殿出空明，吴城连苍莽。\n春随湖色深，风将潮声长。\n杨柳读书堂，芙蓉采菱桨。\n怀人故未休，望望欲成往。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1173,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送赵季文都水书吏考满诗","author":"杨维桢","text":"勾吴水为国，桑田水相争。\n水大连陂湖，水小吞泖泾。\n高庐或凡垫，下土孰容耕。\n吴萌罹患久，都水置司平。\n治水亦多术，害去利始兴。\n侃侃赵公子，为吏有能声。\n弃流截高岸，芜塞开通塍。\n都府资治画，课最上农卿。\n迁官到州县，穑事话田更。\n推此泽物志，圣化相流行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1174,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送康司业诗","author":"杨维桢","text":"赫赫胄监，礼乐攸司。\n祭酒长之，师氏贰之。\n明天子作，我民□极。\n何以播教？\n师氏有职。\n惟明天子，惟烈祖是，因烈祖始。\n受命肇立成均，天子戾止。\n作尔多士，多士济济。\n惟天子使，曰若康公，穆穆雍雍。\n多士济济，惟言来从。\n天子问道，其言如钟。\n天子广化，其德如风。\n维桢作颂，配于乐工。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1175,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送薛推官诗","author":"杨维桢","text":"有渊有清，又静且平。\n有照斯应，有挠有澄。\n我有疑臬，伊谁质之。\n我有枉罚，伊谁出之。\n孰夺我美，心如失之。\n虽夺我美，其用则迩。\n何以用之，骢马御史。\n虽骢马史，群吏之师，四方之纪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1176,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重建海道都漕运万户府诗","author":"杨维桢","text":"朔方圣人启中天，天府之国宅幽燕。\n帝车回旋统幅员，南海北海无中边。\n海陵餫饷至领颛，龙骧万斛谁开先。\n神人手执鲸鲵鞭，朝发扶桑暮咸渊。\n清明风生五两悬，不周风起人南还。\n炮云不作飏不颠，神灯在天大珠圆。\n帝曰开府其区堧，出台入省居才贤。\n将军来自西子阗，高明大屋重翚骞。\n十风五雨熟大田，天仓如泉积陈身。\n武夫翼艘挟飞仙，天人交赞利万全。\n漕臣奏功帝曰然，囷星煌煌千万年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1177,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钟离春","author":"杨维桢","text":"钟离春，臼头深目凹鼻唇，皮肤若烟面如尘。\n手有五色之綵线，为君补衮成天文。\n渐台之君荒且忮，明朝夷台作平地。\n太子择日正储位，钟离在宫齐国治。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1178,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"食糠谣","author":"杨维桢","text":"朝食糠，暮食糠，食糠不如彘与厖。\n君王雁鹜令，以粟甘易粮。\n吁嗟今茫茫，吁嗟何遑遑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1179,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"香山篇","author":"杨维桢","text":"放舟脂塘曲，盘游湖上雷。\n雷鸣湖雨作，还作香山隈。\n美人斗香草，上有九畹栽。\n美人在何所，搴芳招归来。\n露下荆棘草，鹿上姑苏台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1180,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐刺史","author":"杨维桢","text":"冒天海国皆王土，万里明珠贡天府。\n一从官守失仁人，牛马驱除化豺虎。\n蛮衣有习黄巾帽，蛮旗无字题王号。\n九重天子矜蛮情，黄敕加官非赏盗。\n君不见溪蛮改过归大唐，世授刺史以为常。\n乌乎坐令白雉修职贡，可是于今无越裳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1181,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐姬饮酒歌","author":"杨维桢","text":"皇天倾，后土颓，王降世兮汉祚衰。\n王作黄泉兮誓相随，王死胡用吾身为。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1182,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夏驾石鼓辞","author":"杨维桢","text":"周家十圜鼓，散落陈仓野。\n犹有夏驾石，盘盘驾之下。\n秦鞭血山骨，吴猎焦野火。\n夏鼓建不拔，石鸣知者寡。\n父老惧谶言，山空石长哑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1183,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"家仕叹","author":"杨维桢","text":"小仕时为养，古有当会稽。\n岂能食其官，以官养旄倪。\n千金买作郡，万金收满车。\n三年递邮传，谁以民为家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1184,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"射罴行","author":"杨维桢","text":"草枯燎发原野赤，老罴愤起千军敌。\n将军名号巴而思，白羽惯数黄狼肋。\n老罴决石如怒猊，将军立马攒霜蹄。\n满弓一射正贯脾，马前突立人而啼。\n南山白额当道卧，东西之人不敢过。\n少年匹马随噪呼，从渠生拔白额须。\n刳白额，作饭器，坐令泰山之妇歌好世。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1185,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桂水五千里 其一","author":"杨维桢","text":"桂水五千里，春来波浪深。\n地消青草瘴，花发乳蕉林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1186,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桂轩辞二章 其一","author":"杨维桢","text":"桂树丛生兮轩之阳。\n沐雨露兮含风霜。\n王孙不归兮春草歇而不芳。\n轩中之人兮寿而康。\n折琼枝以为佩兮餐金粟以为粮。\n轩中之乐兮乐无央。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1187,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桓山鸟","author":"杨维桢","text":"桓山鸟，鸣声一何悲。\n严父戒二子，分财无嫡支。\n父死未葬命一遗，两枝荆华摧一枝。\n呜呼桓山鸟，鸣声实堪悲。\n死隔别，生流离，百鸟闻之为嗟嗞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1188,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"海客行","author":"杨维桢","text":"海客朱雀航，下有五凤房。\n三月发长干，六月下淮扬。\n青丝牵白日，罗幕西风凉。\n大姬劝金露，小姬弹空桑。\n中姬执药馔，调冰浣肝肠。\n海客睡不起，明晏赛神羊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1189,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"海峰亭诗","author":"杨维桢","text":"神峰在何处？\n云在东海虚。\n下负六鳌首，上托群仙居。\n世人寻地脉，弱水垫轻羽。\n高人坐燕上，天游以蜚车。\n挥斥九清表，飘然隘中区。\n笑呼一蓬粒，贮在壶公壶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1190,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"涂山篇","author":"杨维桢","text":"朝发一钱渡，暮宿三江潮。\n涂山有禅伯，饮我松间瓢。\n遂登福勋庙，还憩汪罔桥。\n涂翁不可诘，夜附山鬼妖。\n载吊漆姓人，负恶忍兜苗。\n既怀弯弓逆，可徒坐不朝。\n逆名不可训，姑以后至枭。\n涧硔洗遗骨，白日连山椒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1191,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"留肃子歌","author":"杨维桢","text":"留肃子，草衣儒，居无室屋出无驴。\n十年落魄走吴下，一日奋迅游天都。\n自言袖有黄帝书，淮荒海盗及吴租。\n大臣不讳省中木，法官交讥台上乌。\n草衣言事不畏死，请剑欲斩崔司徒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1192,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"盐车重","author":"杨维桢","text":"盐车重，盐车重，官骥牵不动。\n官铊私秤秤不平，秤秤束缚添畸令。\n盐车重，重奈何，畸令带多私转多。\n大商鬻不尽，私醝夹公引。\n乌乎江南转运涩如胶，漕吏议法方呶呶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1193,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"盐商行","author":"杨维桢","text":"人生不愿万户侯，但愿盐利淮西头。\n人生不愿万金宅，但愿盐商千料舶。\n大农课盐析秋毫，凡民不敢争锥刀。\n盐商本是贱家子，独与王家埒富豪。\n亭丁焦头烧海榷，盐商洗手筹运握。\n大席一囊三百斤，漕津牛马千蹄角。\n司纲改法开新河，盐商添力莫谁何。\n大艘钲鼓顺流下，检制孰敢悬官铊。\n吁嗟海王不爱宝，夷吾筴之成伯道。\n如何后世严立法，祗与盐商成富媪。\n鲁中绮，蜀中罗，以盐起家数不多。\n只今谁补货殖传，绮罗往往甲州县。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1194,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秦刑篇","author":"杨维桢","text":"秦刑悖圣教，其律毒如兵。\n大汉解倒悬，文网舒急绳。\n朝仪取杂用，千载骂鄙生。\n燕石觅玉质，郑调求韶声。\n如何良有司，尚欲复秦刑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1195,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"聂政篇","author":"杨维桢","text":"齐国壮士侪要离，念母与姊生慈悲。\n既而母死姊同尸。\n乌乎丈夫一死泰山重，胡为轻付市井儿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1196,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"胭脂井","author":"杨维桢","text":"井无水，荒龙椅。\n不得如，巴马子。\n仰天夜见黄姑星，水底喽喽话红鬼。\n井中之人不徇死，宫人斜在雷塘趾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1197,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"铁面郎，美赵御史也","author":"杨维桢","text":"铁面郎，不愿白玉堂，愿着锦衣裳。\n上明天耳目，下见人肝肠。\n江南使者欺天隐，黄金车驮实虚牝。\n忽焉青天近，天目峰前见秋隼。\n父老出郭门，焚香拜使君。\n使君天上斗，斟酌元气成冬春。\n成冬春，立皇纪，董狐已修三国史，柱下惠文须出理。\n江南骢，行且止，万一谗邪塞天耳。\n手持尧时屈轶枝，独立殿前言国是。\n铁面郎，真御史。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1198,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"骊山曲","author":"杨维桢","text":"骊山郁崔嵬，宫阙金银开。\n月生鳷鹊观，云绕凤凰台。\n宫中红妆子，调笑春风媒。\n青鸟衔巾去，乳鹿巡花来。\n天王太白次，仓皇金粟堆。\n石马动秋色，羌枝连暮哀。\n只今瑶池水，八骏渴生埃。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1199,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]