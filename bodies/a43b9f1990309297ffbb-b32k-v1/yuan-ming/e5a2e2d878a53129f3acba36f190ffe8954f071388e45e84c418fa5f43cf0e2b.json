[{"title":"天宝宫词十二首寓感 其七","author":"顾瑛","text":"近臣谐谑似枚皋，侍宴承恩得锦袍。\n扇赐方空描蛱蝶，局看双陆赌樱桃。\n翰林醉进《清平调》，光禄新呈玉色醪。\n密奏君王好将息，昨朝马上打围劳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2918,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"天宝宫词十二首寓感 其八","author":"顾瑛","text":"虢国来朝不动尘，障泥一色绣麒麟。\n朱衣小队高呵道，粉笔新图遍写真。\n宝雀玉蝉簪翠髻，银鹅金凤踏文茵。\n一从羯鼓催春后，不信司花别有神。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2919,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"天宝宫词十二首寓感 其十","author":"顾瑛","text":"五王马上打毬归，赢得宫花献贵妃。\n乐起閤门边奏少，祸因台寺谏书稀。\n侍儿随幸皆颁紫，骰子蒙恩亦赐绯。\n娣妹相从习歌舞，何人能制柘黄衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2920,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"天宝宫词十二首寓感 其十一","author":"顾瑛","text":"新制《霓裳》按舞腰，笑他飞燕怕风飘。\n玉蚕倒卧蟠条脱，金凤斜飞上步摇。\n云母屏开齐奏乐，沉香火底并吹箫。\n只因野鹿衔花去，从此君王罢早朝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2921,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"天宝宫词十二首寓感 其十二","author":"顾瑛","text":"宫衣窄窄小黄门，踯躅初开赐缥盆。\n夜月不窥鹦鹉冢，春风每忆凤皇园。\n爱收花露消心渴，怕解金珂见爪痕。\n只有椒房老宫监，白头一一话开元。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2922,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"天宝宫词十二首寓感 其二","author":"顾瑛","text":"五家第宅近天家，侍女都封系臂纱。\n池上桃开销恨树，閤中香进助情花。\n风回辇道鸾铃远，日射龙颜雉扇斜。\n韩虢并骑官厩马，醉搀丞相踏堤沙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2923,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"天宝宫词十二首寓感 其九","author":"顾瑛","text":"十三女子擘箜篌，选作梨园第一流。\n却道荷花真解语，岂知萱草本忘忧。\n红鸾不照深宫命，翠凤常看破镜羞。\n舞得太平并万岁，五年谁赐锦缠头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2924,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"尧文文学过访赋别兼简鹤斋薛真人二首 其一","author":"顾瑛","text":"草堂五月少人过，门巷春泥奈雨何。\n满树枇杷莺窃尽，一阶芳草蚁行多。\n因思诸葛吟《梁父》，却笑苏秦谩揣摩。\n老我衰年无白发，从今也合号涪皤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2925,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"尧文文学过访赋别兼简鹤斋薛真人二首 其二","author":"顾瑛","text":"忆昨相过寂寞滨，白头倾盖岂如新。\n惊回赤壁三更梦，开遍桃花一树春。\n顾我老为思枥马，怜君远作倚楼人。\n黄公垆畔三株树，留待来时醉挂巾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2926,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题宋徽宗仙山楼观图","author":"顾瑛","text":"宣和天子昔神游，凤驾行空过玉楼。\n此去有人言赤马，归来无处逐青牛。\n分明艮岳通玄圃，想像方壶接祖洲。\n莫把仙山作图画，琼花琪树不胜秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2927,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜宿三塔次陈元朗韵","author":"顾瑛","text":"水落南湖不露沙，又牵舫子到僧家。\n春浮大斗娟娟酒，寒隔虚棂薄薄纱。\n半夜塔铃传梵语，一林江月照梅花。\n坐来诗句生枯吻，指点银瓶索煮茶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2928,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵观帖之什","author":"顾瑛","text":"水如燕尾出湖分，合入长溪直到门。\n韦杜桑麻元两曲，朱陈鸡犬却通村。\n换羊卖马囊中帖，刳瘿悬匏竹里樽。\n昨日烦君来阅赏，扁舟短缆系篱根。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2929,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自赞","author":"顾瑛","text":"儒衣僧帽道人鞋，到处青山骨可埋。\n还忆少年豪侠兴，五陵裘马洛阳街。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2930,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"往凤阳次虎丘","author":"顾瑛","text":"柳条折尽尚东风，杼柚人家户户空。\n祇有虎丘山色好，不堪又在客愁中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2931,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"湖光山色楼口占四首 其一","author":"顾瑛","text":"天风吹雨过湖去，溪水流云出树间。\n楼上幽人不知暑，钩帘把酒看虞山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2932,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖竹枝词","author":"顾元臣","text":"牡丹开时花满阑，芍药开时春已残。\n等过三春今半夏，重楼日日倚阑干。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2933,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"玉山佳处分韵得堂字","author":"顾元臣","text":"玉山有佳趣，张筵竹梧堂。\n翠气动空碧，绿阴生暗芳。\n蔗浆银碗冻，莼缕翠丝凉。\n最爱纤歌罢，虚庭月似霜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2934,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"又得凰字","author":"顾元臣","text":"梧竹绕高堂，清阴满坐凉。\n春风人似玉，芳草句生香。\n绿酒倾鹦鹉，瑶笙引凤凰。\n诗成欢未撤，月色转回廊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2935,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖竹枝词","author":"顾晋","text":"杨白花开风满天，花开成絮不成绵。\n不如落向西湖水，化作浮萍个个圆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2936,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和铁厓竹枝词 其二","author":"顾晋","text":"郎子别时秋月明，说道归时春水生。\n晓起门前听过马，马嘶都是别人行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2937,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"芝云堂得生字","author":"顾晋","text":"石根云气暖，坐看紫芝生。\n诗酒共为乐，竹梧相与清。\n仙人同跨鹤，玉女对吹笙。\n过雨添凉思，停杯待月明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2938,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中寄孟集","author":"倪瓒","text":"英英西山云，翳翳终日雨。\n清池散圆文，空林绝行屦。\n野性夙所赋，好怀谁共语。\n烧香对长松，相与成宾主。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2939,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠天宁福上人","author":"倪瓒","text":"荆溪霜落后，铜官日出初。\n自栉头上发，更理箧中书。\n上人从定起，咏言方绕除。\n邂逅发微笑，幻身同太虚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2940,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"双寺精舍新秋追和戎昱长安秋夕","author":"倪瓒","text":"秋暑晚差凉，茗馀眠独早。\n清风振庭柯，寒蛩吟露草。\n晨兴面流水，西望吴门道。\n不知人事剧，但见青山好。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2941,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送高太守之秦邮","author":"倪瓒","text":"秦汉置牧守，犹古之侯伯。\n封建而郡县，仁政固不易。\n汉宣知所本，留意二千石。\n慎哉高侯车，愿循古辙迹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2942,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为方厓画山就题","author":"倪瓒","text":"摩诘画山时，见山不见画。\n松雪自缠络，飞鸟亦閒暇。\n我初学挥染，见物皆画似。\n郊行及城游，物物归画笥。\n为问方厓师，孰假孰为真。\n墨池挹涓滴，寓我无边春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2943,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉谢张天民先生","author":"倪瓒","text":"鸣雁将北归，徘徊旧栖处。\n江湖春水多，欲去仍回顾。\n稻粱岂余谋，矰缴非所虑。\n犹为气机使，暄冷逐来去。\n寥寥天宇宽，彼此同一寓。\n风萍无定踪，易散聊为聚。\n君看网中鱼，在疚犹相煦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2944,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜泊芙蓉洲走笔寄张鍊师","author":"倪瓒","text":"芙蓉犹满渚，疏桐已殒霜。\n泊舟菰蒲中，吴山隐微阳。\n因怀静默士，竹林閟玄房。\n煮茗汲寒涧，烧丹生夜光。\n忆与郑郯辈，閒咏步修廊。\n时子有所适，顾瞻重徜徉。\n庭下生苔藓，牖间翻诗章。\n弈势郑老胜，酒榼郯生将。\n雅歌杂诙谐，列坐飞羽觞。\n子归日已晚，枣栗亦倾筐。\n挥手辄谢别，暮宿荒城傍。\n迟明趋所期，待子郑公堂。\n晨往遂至昏，企望徒伥伥。\n乃嗟仙真驭，固非世所望。\n恻恻理归棹，泛泛秋浦长。\n还寻甫里陆，更醉山阴王。\n素冠斯驰赠，喜知终未忘。\n余兹将远适，旅泊犹彷徨。\n微风动虚碧，初月照石梁。\n旷望对清景，赋诗托陈郎。\n茯苓思同煮，夜雨共匡床。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2945,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"听袁员外弹琴","author":"倪瓒","text":"郎官调绿绮，谷雪赏初晴。\n两忘弦与手，流泉松吹声。\n问言踰八十，云尝见河清。\n挂帆望九华，神人歘相迎。\n啖以海上枣，欢爱若平生。\n玄遇宁复得，惜哉遗姓名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2946,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗一首奉送友仁贤良之京师","author":"倪瓒","text":"吴山朝霭外，阊门春雨余。\n超忽孤帆远，天末浮云舒。\n君今北阙游，我栖南山庐。\n荷锄事耕作，闭户咏诗书。\n高林鸣禽曙，青苔行迹疏。\n还期茅檐下，一枉故人车。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2947,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀寄强行之常州学官","author":"倪瓒","text":"君在西溪上，年年杨柳春。\n提壶坐柳下，邀我见情真。\n青叶已垂带，白花还覆蘋。\n别来今见柳，思尔采芳芹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2948,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠惟寅","author":"倪瓒","text":"隐几方熟睡，故人来扣扉。\n一笑无言说，清坐澹忘机。\n衣上松萝雨，袖中南涧薇。\n知尔山中来，山中无是非。\n三十不娶妻，四十不出仕。\n逍遥岩岫间，翳名以自肆。\n何曾问理乱，岂复陈美刺。\n高怀如汉阴，终老无机事。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2949,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"对春树","author":"倪瓒","text":"端忧对春树，影落身上衣。\n美人手所成，纫缝愿无违。\n步庭悲往躅，瞻景惜馀晖。\n芳襟沾露湿，兰佩委风微。\n凝思自的的，染泽尚依依。\n晨鸡催梦短，夜鹊逐魂飞。\n欢爱自兹毕，憔悴损容辉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2950,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送马生","author":"倪瓒","text":"送子淮南行，系舟江岸柳。\n翠影舞晴烟，落我杯中酒。\n举杯向落日，春水浮天碧。\n时见白鸥飞，雪光翻绮席。\n应笑披羊裘，独钓江边石。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2951,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄杨廉夫","author":"倪瓒","text":"吴松江水春，汀洲多绿蘋。\n弹琴吹铁笛，中有古衣巾。\n我欲载美酒，长歌东问津。\n渔舟狎鸥鸟，花下访秦人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2952,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵陈维允姑苏钱塘怀古四首 其一","author":"倪瓒","text":"酿酒剑池水，玉壶清若无。\n挥杯送落月，山鬼共歌呼。\n松间灯如漆，白骨漫寒芜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2953,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵陈维允姑苏钱塘怀古四首 其二","author":"倪瓒","text":"耕凿古隧穿，乃吴桓王墓。\n金雁随冷风，黄肠毕呈露。\n悲歌异今昔，踟蹰缓归步。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2954,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵陈维允姑苏钱塘怀古四首 其三","author":"倪瓒","text":"仙人悲世换，宴景在清都。\n寒暑自来往，英雄生钓屠。\n钱唐江畔柳，风雨夜啼乌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2955,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵陈维允姑苏钱塘怀古四首 其四","author":"倪瓒","text":"江山国破后，吊古一经行。\n辇路苔花碧，御沟菰叶生。\n古迹今宁有，新城江上横。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2956,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送吕养浩之绍兴","author":"倪瓒","text":"贺监宅前路，荷花今亦无。\n空馀湖上月，照见水中蒲。\n送尔作官幽绝处，钱塘江头飞柳絮。\n听事临堤满夕岚，时有沙鸥自来去。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2957,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"徐氏南园对雨","author":"倪瓒","text":"樱桃花欲落，风雨暮凄迷。\n忽忆郊园日，竹林通涧西。\n弱蔓滋野楥，兰叶长芳畦。\n念我当时友，蒿莱没旧溪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2958,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画赠九成","author":"倪瓒","text":"故人郯掾史，邀我宿溪船。\n把酒风雨至，论诗烟渚前。\n晨兴就清盥，思逸爱春天。\n复遇武陵守，共寻花满川。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2959,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送徐君玉","author":"倪瓒","text":"闽江之水清涟漪，隔江名园多荔枝。\n闽中女儿天下白，越波飞桨逐凫鹥。\n棹歌清绵洲渚阔，荡桨落日令人悲。\n蛮烟怪雨忽冥密，蒋芽蒲叶相参差。\n此中胜事不为少，徐郎远游牵我思。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2960,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"对梓树花","author":"倪瓒","text":"去年梓树花开时，美人明珰坐罗帏。\n今年梓树花如雪，美人死别已七月。\n梓花如雪不忍看，沈吟怀思泪阑干。\n鸣鸠乳燕共悲咽，柳绵风急烟漫漫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2961,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题元璞上人壁","author":"倪瓒","text":"萧条江上寺，迢递白云横。\n坐待高僧久，时闻落叶声。\n鸱夷怀往事，张翰有馀情。\n独棹扁舟去，门前潮未生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2962,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠沈文举","author":"倪瓒","text":"波光浮草阁，苔色上春衣。\n杨柳莺啼邃，樱桃鸟啄稀。\n荣名非所慕，登览竟忘归。\n泖水宜修禊，重来坐钓矶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2963,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赋德机徵君荆南精舍图","author":"倪瓒","text":"结庐溪水南，胜事足幽探。\n夏果落山雨，春衣染夕岚。\n石敧招鹤磴，门俯射蛟潭。\n日日萦归梦，萧条雪满簪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2964,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山园","author":"倪瓒","text":"春水凫鹥野外堂，山园细路橘花香。\n栖栖身世书盈箧，漠漠风烟酒一觞。\n岂谓任真无礼法，也须从俗著冠裳。\n不营产业人应笑，竹本桃栽已就行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2965,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"林下遣兴","author":"倪瓒","text":"眼见藤梢已过墙，手拈书卷复堆床。\n閒临水槛亲鱼鸟，欲出柴门畏虎狼。\n冠制不嫌龟壳小，衣裾新剪鹤翎长。\n从来任拙唯疏懒，一月秋阴不下堂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2966,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日","author":"倪瓒","text":"闭门积雨生幽草，叹息樱桃烂熳开。\n春浅不知寒食近，水深唯有白鸥来。\n即看垂柳侵矶石，已有飞花拂酒杯。\n今日新晴见山色，还须拄杖蹋青苔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2967,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"二月十日玄文馆听雨","author":"倪瓒","text":"卧听夜雨鸣高屋，忽忆陂塘春水生。\n何意远林饥独鹤，若为幽谷滞流莺。\n成丛枸杞还堪采，满树樱桃空复情。\n二月江头风浪急，无机鸥鸟亦频惊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2968,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪后过陈子贞隐居","author":"倪瓒","text":"陶公卜宅南村里，快雪初晴思一游。\n树辨微茫来独鹤，橹摇敧侧散轻鸥。\n墨池绕溜春冰满，尘榻翻书夕照收。\n相见惘然如有失，掉头吟咏出林丘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2969,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠别益以道书记","author":"倪瓒","text":"一笑相逢岂有期，因怀西崦话移时。\n李公祠畔空馀月，陆子泉头旧有诗。\n旅思悽悽非中酒，人情落落似残棋。\n云涛眼底三生梦，鸥影秋汀又远离。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2970,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄张贞居","author":"倪瓒","text":"不但入城踪迹少，南邻野老见犹稀。\n狂歌衰凤聊自慰，旧学屠龙良已非。\n苍藓浑封麋鹿径，白云新补薜萝衣。\n羊君笔札谁能继，欲读灵文一扣扉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2971,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日试笔","author":"倪瓒","text":"喜看新酒似鹅黄，已有春风拂草堂。\n二月江南初变柳，扁舟晚下独鸣榔。\n苔生不碍山人屐，花发应连野老墙。\n美酒已拚千日醉，莫将时事搅愁肠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2972,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄张天民先生","author":"倪瓒","text":"清溪演漾绿生蘋，溪上轩楹发兴新。\n只欠竹阴垂北牖，尽多山色近南津。\n湖鱼入馔长留客，沙鸟缘阶不畏人。\n愧我萍踪此淹泊，片云回首一伤神。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2973,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"居竹轩","author":"倪瓒","text":"翠竹如云江水春，结茅依竹住江滨。\n阶前迸笋从侵径，雨后垂阴欲覆邻。\n映叶黄鹂还自语，傍人白鹤亦能驯。\n遥知静者忘声色，满屋清风未觉贫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2974,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄张德常","author":"倪瓒","text":"身世萧萧一羽轻，白螺杯里酌沧瀛。\n逍遥自足忘鹏鴳，漫浪何须记姓名。\n石鼎煮云听夜雨，玉笙吹月和松声。\n凭君为问张公子？\n曾到良常梦亦清。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2975,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题张以中野亭","author":"倪瓒","text":"人境旷无车马杂，轩楹只在第三桥。\n开门草色侵书幌，隔水松声和玉箫。\n一榻云山供夏簟，满江烟雨看春潮。\n君能撷取飞霞佩，天际真人近可招。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2976,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵奉答德常别驾初夏见怀一首","author":"倪瓒","text":"隔浦鼍鸣似打衙，云涛城郭夕阳斜。\n汀前露冷鱼鳞屋，窗里烟轻蝉翼纱。\n沛泽风雷时绕几，谈空衣裓不沾花。\n欲分香饭能来否？\n菩萨如今只在家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2977,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送张鍊师游七闽","author":"倪瓒","text":"高士不羁如野鹤，忽思闽海重经过。\n舟前春水他乡远，雪后晴山何处多。\n觳觫卧云芳草细，钩辀啼树野烟和。\n武陵九曲最清绝，落日采蘋闻棹歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2978,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杭人有传余死者贞居闻之怆然因赋此以寄","author":"倪瓒","text":"果园橘熟谁分饷，茅屋诗成懒寄将。\n衰谢皆传余已死，迂疏真与世相忘。\n夜分风雨鸡鸣急，天阔江湖雁影长。\n寥落百年能几面，论文犹及重衔觞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2979,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]