[{"title":"四贤诗 其四","author":"张羽","text":"闻道苏湾里，苏公旧此游。\n湖天风物好，应胜在儋州。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10909,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄方以常 其一","author":"张羽","text":"水竹小窗西，新诗待我题。\n相过虽不厌，只怕踏春泥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10910,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄方以常 其二","author":"张羽","text":"清晨眺高阁，积雨春阳晦。\n望望君愈遥，青山愁独对。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10911,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"六一泉","author":"张羽","text":"醉翁去已久，废寺泉流圃。\n朝来春雨深，照见山鸡舞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10912,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"保公岩","author":"张羽","text":"青苔满石龛，隐隐砌趺迹。\n想见夜禅深，岩前雨花积。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10913,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寺所书所见 其一","author":"张羽","text":"荡子秋未还，双蛾敛寒翠。\n微步入莲宫，谁知此中意。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10914,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寺所书所见 其二","author":"张羽","text":"修廊行复怯，风吹合欢带。\n小立避游人，佯对香炉拜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10915,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"兰室五咏 其一 香","author":"张羽","text":"杂麝犹能别，兼风更不分。\n静时还自得，觅处却无闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10916,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"兰室五咏 其二 根","author":"张羽","text":"秋风凋绿艳，芳气生来歇。\n但使本根在，宁愁萧艾没。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10917,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"兰室五咏 其三 芽","author":"张羽","text":"冒土红初茁，缘池绿渐萦。\n道人偏爱惜，不敢下阶行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10918,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画 其一","author":"张羽","text":"孤村翳余景，秋风在空谷。\n落日淡烟芜，坐看千里绿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10919,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画 其二","author":"张羽","text":"谷口人未归，凉风满林樾。\n孤村云气深，千山雨初歇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10920,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"问徐道士病","author":"张羽","text":"修竹闭云房，细路穿乱石。\n如何尘中人，来问仙家疾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10921,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"月潭试茶","author":"张羽","text":"乞火从山妇，临流煮涧芳。\n怪来泉味好，并带落花香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10922,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"水边桃花","author":"张羽","text":"何处惜春华，芳桃水际花。\n明朝风雨后，流落傍谁家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10923,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"方园杂咏十二首 其一 憩瓮台","author":"张羽","text":"抱瓮汲晨井，灌余烟景微。\n独坐卷修绠，园芳犹满衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10924,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"方园杂咏十二首 其二 牛羊坂","author":"张羽","text":"小坂平如掌，春深绿草肥。\n牛羊识家近，日夕自能归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10925,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"方园杂咏十二首 其三 南隩","author":"张羽","text":"北亭望南隩，高林悬薜萝。\n日莫乌声急，时闻劳者歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10926,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"方园杂咏十二首 其四 芷径","author":"张羽","text":"坐爱蘼芜绿，王孙罢远游。\n不似湘江上，千里动离愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10927,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"方园杂咏十二首 其五 古沟","author":"张羽","text":"故苑金沟断，荒园碧草秋。\n南朝多帝泽，曾向此中流。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10928,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"方园杂咏十二首 其六 采蓝径","author":"张羽","text":"采采不盈襜，幽芳逐微步。\n欲为公子裳，敢谓行多露。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10929,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"方园杂咏十二首 其七 苍耳林","author":"张羽","text":"杖藜成独往，青林人迹稀。\n日晏迷归路，翠实罥秋衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10930,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"方园杂咏十二首 其八 见山坡","author":"张羽","text":"举头见南山，相去能几里。\n莫言不在山，看山如屋里。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10931,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"方园杂咏十二首 其九 道林","author":"张羽","text":"邻近列仙居，瑶林閟清境。\n夜深明月来，送过幡幢影。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10932,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"方园杂咏十二首 其十 月牖","author":"张羽","text":"结屋连碧筱，虚牖抱园开。\n如何天上月，移向壁间来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10933,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"方园杂咏十二首 其十一 茶宴室","author":"张羽","text":"园井汲寒绿，当窗煮金屑。\n应有山僧来，从君泛春雪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10934,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"方园杂咏十二首 其十二 东墺","author":"张羽","text":"一壶兼一杖，独行东墺里。\n稚子倚柴门，孤烟屋头起。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10935,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"戏呈金","author":"张羽","text":"性同韦刺史，坐处爱焚香。\n宝鼎并鸡舌，烦君早寄行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10936,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寝斋夜咏","author":"张羽","text":"沉沉寒夜里，寂寞有谁怜。\n赖得窗间月，犹能照独眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10937,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题横塘萱草用酒字韵","author":"张羽","text":"酒号忘忧物，花名乃相偶。\n忧来对花坐，何如饮美酒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10938,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画","author":"张羽","text":"九迭屏前水倒垂，古今唯有谪仙诗。\n道人杖策穷源去，写得峰头乍落时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10939,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绝句","author":"张羽","text":"青苔黄叶掩柴扉，远客无端夜忆归。\n林外月斜童子睡，独临残烛解寒衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10940,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夏雨新霁图","author":"张羽","text":"看图忆得住山阿，茅屋深深隐薜萝。\n风雨过来啼鸟静，白云更比绿云多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10941,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题倭翁 其一","author":"张羽","text":"小国贡来东海外，尚方分给午门前。\n终身永保君王赐，总遇秋风莫弃捐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10942,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题倭翁 其二","author":"张羽","text":"青宫甲观倚云开，侍从如云总俊才。\n昨暮传宣容握扇，丹墀清晓谢恩来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10943,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠五河驿丞孙本","author":"张羽","text":"驿楼郁郁古河滨，日日征帆送使臣。\n不共灯前一杯酒，谁知亭长是诗人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10944,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登韩信城望漂母墓","author":"张羽","text":"绕城春水绿含漪，遥忆沙头澼絖时。\n若爱当时一杯饭，千年孤冢有谁知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10945,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画二首 其一","author":"张羽","text":"千里生还不负期，入门成喜复成悲。\n忽看画里青山色，犹道长干雨后时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10946,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画二首 其二","author":"张羽","text":"孤舟五月发金陵，遥见家山喜不胜。\n却忆石头城上望，白云何处是吴兴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10947,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠卜者","author":"张羽","text":"老依卜市不论钱，习静年来白已玄。\n安得相逢王辅嗣，垂帘闲坐说先天。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10948,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画 其一","author":"张羽","text":"百道清泉石上流，白云初起乱峰秋。\n此中疑有陶弘景，高卧松风第一楼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10949,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画 其二","author":"张羽","text":"旧是云山自在身，误将书剑逐风尘。\n犊车何日移家去，还作条桑种杏人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10950,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"横云迭嶂图","author":"张羽","text":"丹崖碧嶂杳难攀，台殿高低积翠间。\n试遣北人来看着，多应说似洛阳山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10951,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画赠长兴杜典史浚","author":"张羽","text":"下若溪头山似戟，武昌门外柳如烟。\n何如肆射平其去，束带闲耕墓下田。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10952,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画赠税司吏","author":"张羽","text":"缗钱算罢无余事，日日溪头醒复醉。\n长安七相并五侯，何似吴兴折腰吏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10953,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梦中赋","author":"张羽","text":"西施江上采荷花，孔盖如云万扇遮。\n如今不敢人窥着，昔日人看隘若耶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10954,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重午回文","author":"张羽","text":"轻罗扇试新词好，玉臂双□彩缕长。\n清簟昼闲人斗草，午风微袅篆炉香。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10955,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄灵隐良泐二长老","author":"张羽","text":"两禅相对一灯悬，鹫岭龙宫地悄然。\n七百年来无好句，泉声空绕寺门前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10956,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"孟浩然雪竹图","author":"张羽","text":"雪满秦京欲去迟，故人当路谩相知。\n平生多少惊人句，却向君前诵怨诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10957,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"刘伶谢安陶潜王羲之像 其一","author":"张羽","text":"鹿车载酒竹间期，不记山妻泣谏时。\n已识形骸为外物，何须荷锸镇相随。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10958,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"刘伶谢安陶潜王羲之像 其二","author":"张羽","text":"典午风流数谢公，高标自许伯夷同。\n桓郎跋扈苻郎健，都在尚书雅量中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10959,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"刘伶谢安陶潜王羲之像 其三","author":"张羽","text":"五儿长大翟妻贤，解绶归来只醉眠。\n篱下黄花门外柳，秋光不似义熙前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10960,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"刘伶谢安陶潜王羲之像 其四","author":"张羽","text":"白葛为巾不裹头，兰亭会里最风流。\n老来忘却观鹅癖，只爱山人许远游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10961,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"林下烧笋","author":"张羽","text":"乱堆黄叶就林边，火力均时味已全。\n日暮栖禽疑未下，竹根犹自起残烟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10962,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画","author":"张羽","text":"玉洞仙桃万树花，楼台彷佛蔡经家。\n神丹炼就何曾服，乞与山童饲白鸦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10963,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题手画云山图赠王生泰","author":"张羽","text":"积善桥东旧宅间，独随阿母住青山。\n鹿车奉引行春去，多在云松九琐间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10964,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"云山图","author":"张羽","text":"薜荔花开僧舍闲，佛香时列竹窗间。\n朝来小试南唐墨，写得溪南数叠山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10965,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟次孤山","author":"张羽","text":"水绕荒山路半斜，墓园无主属官家。\n我来正是梅开日，满目蓬蒿不见家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10966,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"海会僧房","author":"张羽","text":"床头书卷绿牙签，病起名家手自拈。\n气息未回禅诵少，犹能弹舌讲楞严。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10967,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"哀宋君女阿归","author":"张羽","text":"客来唤出最钟情，暂别谁知便隔生。\n昨日闽州书信到，伤心犹有阿归名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10968,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晓发嘉兴","author":"张羽","text":"城乌啼散驿楼空，一舸苍茫曙色中。\n不是故人今夕共，定应愁绝雨兼风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10969,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟中闻歌","author":"张羽","text":"何处清歌短更长，渚风沙雨共凄凉。\n不须直向天涯听，一日辞家已断肠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10970,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中想东园杏花","author":"张羽","text":"斋居清昼四无邻，黄卷中间过半春。\n落尽杏花浑不看，少年人似老年人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10971,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"东园报杏花未开","author":"张羽","text":"芳葩未拆避春寒，日日烦君绕画阑。\n莫是主家曾见惯，含情欲待外人看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10972,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"孟浩然像","author":"张羽","text":"横门雪满放朝回，油壁金鞍覆地来。\n谁是蹇驴乌帽客，解吟花逼艳阳天。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10973,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"头陀庵聪道者房","author":"张羽","text":"苦行能便自小持，松龛寂寂到人稀。\n斋厨日晏孤烟起，童子新将施米归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10974,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题渊明白衣送酒图","author":"张羽","text":"几回笑把菊花枝，遥望南山自咏诗。\n不值白衣人送酒，岂堪怀抱独醒时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10975,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄题兰室柳湖归隐图","author":"张羽","text":"挂冠归去祗看山，心寄孤岚野鹤间。\n试数同时戎马客，几人投老似君闲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10976,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄兰室 其一","author":"张羽","text":"离思逢秋自不胜，忽看书札恨翻增。\n遥知雨绝林塘静，独坐高斋似定僧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10977,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄兰室 其二","author":"张羽","text":"行人共识孝廉家，流水当门略彴斜。\n日日高堂称寿罢，倚栏闲看紫荆花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10978,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题徐贲画南浦亭图","author":"张羽","text":"离离烟树接通津，南浦亭前碧草春。\n客里见图先泪落，只缘身是此乡人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10979,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"十二月三日对月","author":"王冕","text":"今夜初生月，客中仍独看。\n遥怜吾老幼，未解脱饥寒。\n破壁箪瓢垒，疏梅霜雪团。\n再思先子训，默默泪阑干。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10980,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"水仙子","author":"倪瓒","text":"东风花外小红楼。\n南浦山横翠黛愁。\n春寒不管花枝瘦。\n无情水自流。\n檐前燕语娇柔。\n惊回幽梦，难寻旧游。\n落日帘钩。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10981,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"联芳词三首 其一 品令","author":"王行","text":"飞琼环佩。\n立缥缈、香云影里。\n冰丝萦蹙霞绡帔。\n瑶阶玉砌，雪月看初霁。\n不待夭妍相妩媚。\n任天然丰致。\n绰约仙姿真绝世。\n众芳无地。\n先得春风意。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10982,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"折桂令","author":"倪瓒","text":"片轻帆、水远山长。\n鸿雁将来，菊蕊初黄。\n碧海鲸鲵，兰苕翡翠，风露鸳鸯。\n问音信、何人谛当。\n想情怀、旧日风光。\n杨柳池塘。\n随处彫零，无限思量。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10983,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]