[{"title":"送陈主簿归四明","author":"王翰","text":"祖帐近郊坰，花明烂漫春。\n十年三度岭，万里一吟身。\n东海老垂钓，西亭醉问津。\n谋身温饱外，诗酒见天真。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13727,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"贺三十生子","author":"王翰","text":"立年古有室，生子未为迟。\n汤饼皆佳客，弄璋多好诗。\n蓝田生拱璧，清水出摩尼。\n从此乔家宅，烟楼不可卑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13728,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"禹功岩","author":"王翰","text":"琬琰何时写，磨崖纪圣功。\n石红经火烈，字绿见苔封。\n疏决功能就，怀襄害亦穷。\n鱼虾民免化，至德与天同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13729,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挂鼓石","author":"王翰","text":"奇峰名挂鼓，今古竟相传。\n树密清阴合，烟消翠影圆。\n斑斓惊踞虎，骞举类飞鸢。\n月夜闻鼍吼，犹疑馀韵喧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13730,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"驺虞诗","author":"王翰","text":"驺虞神后出，佳气蔼山隅。\n瑞世千年出，从风百兽趋。\n质同金獬豸，性异白于菟。\n想见唐尧治，窗前展画图。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13731,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"风木轩为吴审理赋","author":"王翰","text":"庭际瞻嘉树，萧萧日有声。\n霜风仍见惨，岁月若为情。\n有幸荣三釜，无时捧一罂。\n空阶摇落处，相对泪纵横。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13732,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"存心堂诗为彭州判作","author":"王翰","text":"虚静元无迹，灵台本湛然。\n服膺还有得，逐物亦能迁。\n准定知高下，铜光见丑妍。\n祗应求大用，未是泥尘编。\n北阙辞华衮，南荒拜绣旃。\n听韶丹陛下，纳表五云边。\n走马来钟阜，持麾到颍川。\n自今霄汉上，争看德星悬。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13733,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"金陵送别图为体方黄先生作","author":"王翰","text":"圣代开文运，西江盛伟人。\n雅怀多蕴藉，大器负经纶。\n家世联簪笏，声光动缙绅。\n文雄才似水，诗俊笔如神。\n白雪难同调，青云好致身。\n应时鸣鸑鷟，当世得麒麟。\n入作王门客，来为上国宾。\n清操居侍从，博学待咨询。\n文府多裁制，经筵费讨论。\n晚山别馆盛，春水片帆新。\n祖席多才彦，囊诗尽袭珍。\n吹台追逸客，梁苑作词臣。\n契合应无间，交游会有因。\n夷山登览快，汴水往游频。\n行乐追攀屡，论文怀抱伸。\n相知惟管鲍，交契得雷陈。\n拟向高阳里，相依为卜邻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13734,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游上方寺和卞长史韵","author":"王翰","text":"寻幽来宝地，联辔尽佳朋。\n隔水微闻磬，窥林远见灯。\n未谈超世法，先见小乘僧。\n古殿生虚籁，阴廊挂断冰。\n幽轩聊借憩，高塔险难登。\n石钵青莲长，天香翠霭凝。\n风幡生夙悟，雷鼓报晨兴。\n延坐分奇茗，登临挂瘦藤。\n毒龙僧作伴，香象佛能乘。\n学道分真妄，参禅祖秀能。\n悟空魔女去，入定睡蛇腾。\n境界清凉胜，山林气象增。\n雅怀端可重，尘抱不须矜。\n暂结跏趺坐，心源返照澄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13735,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送柳思之武陟令","author":"王翰","text":"柳氏河东秀，何年去远遐。\n祗应寻玉斧，得以住金华。\n拱璧来垂棘，名驹产渥洼。\n居乡曾领荐，治县久栽花。\n浪毁金为矿，虚言玉有瑕。\n看山吟好句，见字识名家。\n重睹中天日，还乘贯月槎。\n承恩辞紫禁，沾命赐黄麻。\n未署移山判，先驱露冕车。\n儿童骑竹马，父老候闉阇。\n明日丽谯鼓，鼕鼕报早衙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13736,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山居即事五首 其一","author":"王翰","text":"群狙戏绝巘，一一联臂下。\n雨黑人蚤归，窃食岩下稼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13737,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山居即事五首 其二","author":"王翰","text":"每爱罗家老，殷勤久不穷。\n秋风新栗熟，先送满筠笼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13738,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山居即事五首 其三","author":"王翰","text":"清朝微雨歇，云气行丹崖。\n几家挑菜女，笑下青峰来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13739,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山居即事五首 其四","author":"王翰","text":"意閒禽鸟狎，同出更同栖。\n日高人尚眠，就向窗前啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13740,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山居即事五首 其五","author":"王翰","text":"饷田分野饭，社酒倒山樽。\n茅舍无人守，春风自闭门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13741,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"忆山居","author":"王翰","text":"一别南山后，于今已十年。\n相应东岭月，空照草堂前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13742,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题五首 其一","author":"王翰","text":"惆怅昨宵梦，千思与万思。\n黄河流入海，岂有上天时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13743,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题五首 其二","author":"王翰","text":"心绪浑无定，春空百尺丝。\n梦随蜀帝魄，啼血向花枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13744,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题五首 其三","author":"王翰","text":"愁来情绪恶，锦瑟只閒抛。\n一任朱弦绝，何劳凤嘴胶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13745,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题五首 其四","author":"王翰","text":"犹记城南别，歌残折柳枝。\n春深归未得，肠断落花时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13746,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题五首 其五","author":"王翰","text":"坐见三春去，无心作冶游。\n可怜明月夜，独自倚高楼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13747,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"閒居书事","author":"王翰","text":"功名场上早抽身，不蹋长安陌上尘。\n明月清风无尽识，天将真景付閒人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13748,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"村居感事三首 其一","author":"王翰","text":"共待优人是贵人，满村箫鼓沸秋云。\n夜来乡校追呼急，总道儿童不好文。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13749,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"村居感事三首 其二","author":"王翰","text":"早婚礼义已全乖，偷薄成风更可哀。\n几欲持毫濡沧海，不胜今日续新台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13750,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"村居感事三首 其三","author":"王翰","text":"亲丧未葬不成哀，笙笛悠悠笑语开。\n月落灯昏梵呗歇，就中扶出醉人来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13751,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题寒梅冻雀图","author":"王翰","text":"冰肌翠袖淡无痕，照影罗浮江上村。\n霜鸟寒蜂解清意，徘徊风月欲黄昏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13752,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题明皇吹箫图二首 其一","author":"王翰","text":"逆竖谁教解巧机，玉箫新进上方吹。\n进宫已自几千里，亡国何须数百枚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13753,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题明皇吹箫图二首 其二","author":"王翰","text":"朝退从容适且安，梁州新谱合清欢。\n玉箫取次闲拈处，便有霖铃蜀道难。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13754,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"咏史五首 其一 孔融","author":"王翰","text":"汉鼎恢图入笑谈，岂期失利向东山。\n召时已有忌才意，不待论封始犯颜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13755,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"咏史五首 其二 管宁","author":"王翰","text":"锄菜忘金志亦雄，眼高四海却如空。\n当时不识公孙度，必托中山大耳公。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13756,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"咏史五首 其三 邴原","author":"王翰","text":"刚愎从来蹈祸机，管生聪悟更知微。\n若非太守能容物，亦叹秋风鹦鹉飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13757,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"咏史五首 其四 祢衡","author":"王翰","text":"慢骂狂生捋虎须，比言雀鼠意何如。\n只缘要假刘郎手，兼道才名亦是虚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13758,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"咏史五首 其五 华歆","author":"王翰","text":"一掷难如不顾人，豫章一屈匪躬臣。\n葛巾野服非君物，合着当年夷皓身。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13759,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"昭君怨","author":"王翰","text":"回首长门泪暗流，毡城春似汉宫秋。\n琵琶强劝单于酒，酒正酣时妾正愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13760,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读汝南遗事三首 其一","author":"王翰","text":"城南惊见宋人旗，寄重承麟事已迟。\n愧似二陵从北狩，非干鞍马倦驱驰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13761,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读汝南遗事三首 其二","author":"王翰","text":"行院忠心匪石贞，乘舆北幸志难伸。\n谁知汝水深如海，能杀田横五百人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13762,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读汝南遗事三首 其三","author":"王翰","text":"火烈幽兰国祚终，绛山风节更高崇。\n九泉若见诸藩镇，羞杀恒山武相公。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13763,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南陌词 其二","author":"王翰","text":"南陌东边千树花，东家开罢落西家。\n无心却爱西窗竹，只向墙阴长笋芽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13764,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南陌词 其三","author":"王翰","text":"南陌东边草染裙，嫩青深翠一时新。\n王孙去后无消息，春雨春烟恼杀人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13765,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"墨桃华","author":"王翰","text":"武陵溪畔春风面，研绿调朱染得真。\n尤爱倪生能画意，只将淡墨写精神。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13766,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪夜杂诗 其一","author":"王翰","text":"闭门吟咏学饥鸢，孤兴高情自一天。\n清景惟诗收拾得，党家粗俗亦徒然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13767,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪夜杂诗 其二","author":"王翰","text":"不熏被煖知风定，未晓窗明觉雪深。\n一夜小斋清不寐，诗成旋教小童唫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13768,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪夜杂诗 其三","author":"王翰","text":"满天星斗晓来收，万丈瑶台梦里游。\n物到岁寒偏耐看，一轩松竹不胜幽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13769,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪夜杂诗 其四","author":"王翰","text":"明河清浅护溪沙，白鹤归来处士家。\n雪与寒梅有成约，夜来才放两三花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13770,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪夜杂诗 其五","author":"王翰","text":"诗翁老去不禁寒，日在柴门已返关。\n清晓家僮呼我起，墙头惊失夜来山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13771,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"双瓜图二首为瞿长史赋 其一","author":"王翰","text":"开图好似吴兴笔，爱与青斑为写生。\n中有周诗千古意，子孙蕃大更才名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13772,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"双瓜图二首为瞿长史赋 其二","author":"王翰","text":"碧丛抽穗为芣苢，青蔓悬瓜若旨苕。\n一段天机精妙处，便堪持此换琼瑶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13773,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"瞿长史黄瓜图","author":"王翰","text":"车前楚楚初抽穗，桂髓绵绵引嫩条。\n叶底翠罂真可摘，孰云不可报琼瑶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13774,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和王清源秋日漫兴五首 其一","author":"王翰","text":"苒苒沙汀展翠毡，行行苔径踏青钱。\n适来倚杖看云处，閒与白鸥相对眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13775,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和王清源秋日漫兴五首 其二","author":"王翰","text":"閒扶藜杖立沙头，水落空江露远洲。\n红日转山将市散，几多渔艇漾寒流。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13776,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和王清源秋日漫兴五首 其三","author":"王翰","text":"信我行藏自有天，任他岁月似奔川。\n狂歌痛饮閒消遣，不过人间一百年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13777,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和王清源秋日漫兴五首 其四","author":"王翰","text":"菊花霜后半凋残，壁下蛩吟不奈寒。\n多少朱门尽豪俊，十年掉臂不相干。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13778,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和王清源秋日漫兴五首 其五","author":"王翰","text":"白鸟飞飞绿柳长，雨收秋水满横塘。\n败荷折柄馀残翠，老藕着花留晚香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13779,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"望嵩山","author":"王翰","text":"猎猎西风卷暮阴，芙蓉古样映遥岑。\n物华呈瑞天然巧，横冠青霞作玉簪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13780,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和邮亭壁间赵氏韵","author":"王翰","text":"驷马高车亦可誇，箪瓢陋巷足生涯。\n自从任运无心后，楚越方知是一家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13781,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赚兰亭图","author":"王翰","text":"山阴乐事已尘埃，留落名书到辨才。\n殉葬昭陵何足贵，他年佳传更新裁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13782,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题白鹭图","author":"王翰","text":"垂柳含风绿线长，舂锄飞下玉双双。\n一溪春水无人渡，低掠蒹葭过石淙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13783,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"白云思亲图","author":"王翰","text":"暮山高处白云生，游子登临泪满缨。\n恨不此身生羽翼，随云飞去到亲庭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13784,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题子陵钓台图","author":"王翰","text":"浪迹江湖隐姓名，徵书何事下青冥。\n狂奴一语如真有，何用区区奏客星。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13785,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画竹三首为黄伴读作 其一 云望天风","author":"王翰","text":"翠壑风生万竹啼，清秋摇落怨凄凄。\n疏丛頫仰浑无定，鸣凤来时不得栖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13786,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画竹三首为黄伴读作 其二 金风玉露","author":"王翰","text":"玉宇风生秋满天，露华凉冷浸芝田。\n适来云表皋禽下，独立苍苔警不眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13787,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画竹三首为黄伴读作 其三 淇水晴晖","author":"王翰","text":"淇水悠悠绿似苔，卫侯文雅亦贤才。\n可怜培养千年后，尽塞宣房更可哀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13788,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"孟浩然","author":"王翰","text":"诗爱襄阳老布衣，玉堂字字总珠玑。\n秋风归兴输张翰，不道槎头鳊正肥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13789,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉教题龙江送别图","author":"王翰","text":"晓日曈昽帐殿开，五云光彩上蓬莱。\n鸾笺续卷题金薤，鹤驾临江送玉杯。\n上国旌旗分将相，从官词赋总邹枚。\n兰舟棹举歈歌发，回首青山绕凤台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13790,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和卞长史郊行","author":"王翰","text":"梦里寻春觉后迟，分明曾到武陵西。\n川光浴日骊珠动，石气蒸云翠盖齐。\n一曲柳塘初下雁，数家茅屋不闻鸡。\n世间万事庄周蝶，且共随花信马蹄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13791,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪后简伯纯县令","author":"王翰","text":"大地山河罄一湔，腊间三白见丰年。\n天人巧剪银河水，山岳新开玉井莲。\n我欲忍寒还罢钓，人谁乘兴未归船。\n闭门不作袁安卧，赖有夷山令尹贤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13792,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和黄体方郊行","author":"王翰","text":"长河水落露汀沙，隔水依稀似见花。\n旷野蒿莱千万亩，荒村篱落两三家。\n柳塘滟滟新堤固，麦陇青青小径斜。\n自是游人耽野趣，哦诗驴背不知赊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13793,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题望云思亲图","author":"王翰","text":"草铺平野树苍苍，游子登临倍感伤。\n鸿雁去边生客思，白云飞处望亲乡。\n山遮故国身难越，水接遥天恨共长。\n何日得归盱水上，一樽春酒寿高堂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13794,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送吴指挥扈从汝宁","author":"王翰","text":"曾属櫜鞬侍玉墀，分藩又从汝南驰。\n幽兰亭古连青琐，悬瓠城高驻綵旗。\n射艺远过猿臂巧，画名不减虎头痴。\n从容退食知多暇，好为裁诗寄所思。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13795,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]