[{"title":"送张文学","author":"徐贲","text":"芳筵趣新饯，商琯默秋声。\n淡淡川星没，遥遥海雁征。\n维舟延客景，看路计归程。\n以此迟留意，聊将畅别情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10396,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送江教谕","author":"徐贲","text":"湖海相知少，风尘送客初。\n归愁江雨积，别意柳条疏。\n枫落迎船叶，鲈香出水鱼。\n吴兴尚文物，吾道近何如。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10397,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送乌程冯明府","author":"徐贲","text":"夙负亲人术，初当出宰年。\n青山依县郭，春雨傍湖田。\n鸟下鸣琴后，花飞判笔前。\n民风非复古，重作谕蒙篇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10398,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"濯清轩","author":"徐贲","text":"春草绿芳洲，清江绕舍流。\n芹香低渚燕，波影媚沙鸥。\n风带初闻笛，花藏罢钓舟。\n沧浪千古意，何处问巢由。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10399,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"霅上逢董庄","author":"徐贲","text":"五月苕溪道，南风暑气新。\n偶当为客日，翻比在乡亲。\n醉酒桥边市，驱车陌上尘。\n行藏不须问，同是布衣人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10400,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"悼陆廷臣","author":"徐贲","text":"溪馆相逢日，荒山独吊时。\n文章传旧业，泉石负幽期。\n反陨慈亲泪，空遗幼女悲。\n交游今满眼，题墓欲烦谁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10401,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杨进士载酒亭卷","author":"徐贲","text":"亭基久芜没，湖上几斜曛。\n旧梦通鱼鸟，馀情付水云。\n客过曾问字，诗罢忆书裙。\n待得重归隐，春风此访君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10402,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋晚次高推官韵","author":"徐贲","text":"溪楼成晚眺，沙浦粲孤霞。\n值节长为客，逢人即话家。\n荒山惟去鸟，落木见栖鸦。\n莫谩嗟零落，吾生岂系瓜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10403,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"立秋夜同社书记李逸人寓宿分韵得霜字","author":"徐贲","text":"今夕秋风至，相逢酒一觞。\n身虽俱在客，情得是同乡。\n密竹先惊雨，轻梧不待霜。\n那知千里外，复此话连床。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10404,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秦淮客舍除夕呈大兄","author":"徐贲","text":"兄弟喜连床，灯前话故乡。\n年随窗雪尽，夜入酒杯长。\n暂得欢情合，都将客况忘。\n何如共归去，烂醉北城傍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10405,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"茅堂","author":"徐贲","text":"茅堂近曲冈，门巷草莱长。\n病力晨春怯，诗情午睡妨。\n相过皆故友，忘却在他乡。\n炎夏愁卑湿，时时理药囊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10406,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽郭秉心都事","author":"徐贲","text":"谪居欣与识，死别忽成悲。\n客馆存虚位，行囊只旧诗。\n乡人收骨葬，馆仆报家知。\n惆怅平生泪，因君更复垂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10407,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赵曹莫三助教留宿南斋","author":"徐贲","text":"南斋凉意足，夜景满柴关。\n邻友将茶送，山人酌酒还。\n星垂云影外，萤出桂阴间。\n相值艰难日，诸君岂易閒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10408,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵别方员外","author":"徐贲","text":"暂来因复去，不得久相同。\n身在匆匆里，年过衮衮中。\n吟斜寒寺日，望断暮天鸿。\n料我还山日，相思只向东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10409,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送潘士谦归庐州省亲","author":"徐贲","text":"微名虽不偶，且得奉慈亲。\n为客逢多难，还乡有几人。\n凫鹥江郭雨，桑枣楚郊春。\n此去寻闾里，俱非旧识邻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10410,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赋荷送陈进士启","author":"徐贲","text":"团团初贴水，苒苒渐盈塘。\n微动知鱼戏，斜披见鹭藏。\n幅裁巾学制，筒泛酒移香。\n折得同青盖，贻君障夕阳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10411,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赋陌上车送穆德敬","author":"徐贲","text":"徒旅候鸡鸣，驱车陌上行。\n盖当寒树影，铎应晓风清。\n轧轧趍前坂，遥遥计后程。\n双轮日千转，未足比离情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10412,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送王员外归太原省墓","author":"徐贲","text":"圣主颁恩宠，郎官赐诰还。\n人瞻新骑从，马识旧家山。\n古墓原花里，高坟陇树间。\n遥知心恋阙，夜夜梦朝班。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10413,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送澄上人南游","author":"徐贲","text":"云水三千里，江湖二十年。\n春风投海国，落日上吴船。\n木钵家家饭，蒲团处处禅。\n石桥元有路，只在暮钟边。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10414,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送王越","author":"徐贲","text":"客乡还送客，况是暮春时。\n雨湿花飞重，川长鸟度迟。\n酒尊歌后歇，帆影望中移。\n怅怅东风絮，飘零不受吹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10415,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"别杨三兄弟","author":"徐贲","text":"怜君好兄弟，留宿喜相亲。\n邻寺钟闻早，风窗烛剪频。\n共倾今夜酒，同是异乡人。\n莫谓相知少，交情久见真。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10416,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"荅山西杨孟载宪副","author":"徐贲","text":"小雨晚晴天，新凉欲早眠。\n缘悭杯酒里，愁入鬓丝边。\n北地先闻雁，西林已罢蝉。\n悬知相忆处，千里共婵娟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10417,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"岁晚","author":"徐贲","text":"客途逢岁晚，落日倦登临。\n阻绝山川恨，艰难父子心。\n江吞吴地尽，天入楚云深。\n近报王师捷，悲欢不自禁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10418,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题得飞云送刘提司胜","author":"徐贲","text":"天阔浮云远，因风捲白衣。\n流阴兼水净，寒影度江微。\n不受歌声遏，先将别思飞。\n飘扬随去马，今夕定何依。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10419,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"逢侠客","author":"徐贲","text":"由来燕赵士，意气负平生。\n买妓千金醉，平戎一剑行。\n君王曾锡宠，宾客尽知名。\n今日狭邪道，相逢重结盟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10420,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题田家","author":"徐贲","text":"田家无别业，朝夕理东菑。\n敢说农功苦，惟忧稼穑迟。\n牧归牛饱后，祭散犬迎时。\n更得轻徭役，丰年乐有期。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10421,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄金子肃","author":"徐贲","text":"春色边城暮，君如客况何。\n伤心离母久，失意傍人多。\n慰泛花时酒，悲因月夜歌。\n有家归未得，非是隔关河。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10422,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题杏林图赠陈子京","author":"徐贲","text":"茅山无四邻，红杏万株春。\n收谷还凭虎，栽花剩有人。\n学仙离世久，访病出山频。\n我独怀芳躅，君能继后尘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10423,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"同高记室访虎丘蟾苞二上人","author":"徐贲","text":"林下曾相见，重来记往年。\n笑谈俱是法，去住本无缘。\n山溜泉通脉，帘阴竹护烟。\n暂忘人世事，得此共栖禅。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10424,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"荅宋仲温见过不遇之作","author":"徐贲","text":"樵踪空枉问，值此掩重扉。\n馀雪寒犹在，初阳晓尚微。\n邻遥鸡独唱，厨静雀群飞。\n愧乏应门者，留君待我归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10425,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵高季迪期游云岩雨阻之作","author":"徐贲","text":"身势两无妨，閒情独未忘。\n相期移酒艇，同宿过僧房。\n节物宁长好，园花已罢芳。\n乱山烟雨外，欲望失苍苍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10426,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"喜高记室了上人见过","author":"徐贲","text":"晨起扫閒斋，凉风叶满阶。\n吟邀邻友和，坐喜野僧偕。\n雨意宜深竹，庭阴得古槐。\n清樽常自满，能不写幽怀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10427,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赋得收谷虎赠葛太医","author":"徐贲","text":"红杏子初熟，黄班性久驯。\n卧看收谷器，行识问医人。\n逐少非营利，藏多得赡贫。\n近闻勾漏县，花似董林春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10428,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠古心上人","author":"徐贲","text":"已断乡山念，聊随云水缘。\n时时惟礼佛，处处即安禅。\n半偈心曾契，三衣体自便。\n遥知明月夜，趺坐降诸天。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10429,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻高季迪病眼因寄","author":"徐贲","text":"芳时闻病目，几日卧斋房。\n有女能修药，多人为送方。\n昼吟还不废，夜诵定相妨。\n每到看花处，思君讵可忘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10430,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送李山人还越","author":"徐贲","text":"旧宅鉴湖阴，东归慰远心。\n风帆沙树杳，驿路水云深。\n袖有题诗卷，囊多卖卜金。\n翩然自来往，应不负山林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10431,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"吕山人客圆明精舍有赠","author":"徐贲","text":"远与家山别，来依佛殿居。\n寄斋频施米，作供剩藏蔬。\n禅处容分榻，经馀许看书。\n暂随僧结夏，出市也应疏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10432,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答余左司","author":"徐贲","text":"南城怅违别，北里念周旋。\n赌墅春同弈，听江雨对眠。\n诗情空日日，花事自年年。\n何处思君切，牙营鼓角边。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10433,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绿水园燕集","author":"徐贲","text":"客集金闺彦，筵张绿水园。\n池阴夏荷满，日正午葵繁。\n和曲均欢喜，摛词涉道言。\n欲还惜馀兴，更为坐前轩。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10434,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"同唐文学肃王校书行访衍略二上人留宿真庆精舍得闻字","author":"徐贲","text":"僧院城南僻，禅林夜见分。\n观心方有悟，演法似无闻。\n灯影欺微月，帘阴护宿云。\n偶因来问竹，况得此逢君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10435,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题王材东里草堂","author":"徐贲","text":"移家遂成隐，结屋涧东隈。\n野客分茶送，邻舟载鹤来。\n云埋琴荐冷，风捲壁衣开。\n晚饷矶头饭，秋吟竹下杯。\n余生慕幽赏，到此每迟回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10436,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送赵克常归楚","author":"徐贲","text":"避地吴门久，还乡楚郡遥。\n开田仍负耒，卖药每携瓢。\n梦逐归云度，心同去旆迢。\n到依鱼市住，饮赴里人招。\n海色霞生岛，江声雨送潮。\n不堪先陇上，松柏半萧条。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10437,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赋钵送僧道衍","author":"徐贲","text":"旧日天王献，初因佛祖传。\n藏龙元有法，乞米但随缘。\n不受萧郎击，宁求魏后怜。\n托归村口寺，洗傍石根泉。\n此去留香积，当参饱饭禅。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10438,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"访衍上人不值次壁间韵","author":"徐贲","text":"僧院深无地，清幽慰客心。\n众山同晚色，孤墅肃秋阴。\n托兴诗频赋，论情酒罢斟。\n开帘知树杪，过竹是溪浔。\n云静明遥望，猿哀续短吟。\n秋风空返棹，偶此记登临。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10439,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送王主簿","author":"徐贲","text":"路从苕水去，万壑更千岩。\n孤驿愁将别，离杯惜重衔。\n莺声赓妓曲，柳色学朝衫。\n烟淡缘汀草，风将向浦帆。\n明朝忆君处，江上雨??。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10440,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赋橡斗林韵得车字送朱别驾","author":"徐贲","text":"栩林前代植，第宅昔人居。\n高荫犹临野，幽丛独芘墟。\n花开当夏密，子熟过林疏。\n深处惟来鸟，收时得赋沮。\n云霄千尺近，雨露百年馀。\n偶为登临到，因怀别驾车。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10441,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"陪牛进士冯明府宿遂初庵得心字","author":"徐贲","text":"山中因访古，方外遂幽寻。\n曲径缘回涧，高标出乱岑。\n舍舟留北渚，借屐过东林。\n野色兼寒色，云阴助夕阴。\n烟波皆客意，猿鸟共閒心。\n风引虚林磬，泉流别院琴。\n褰帷萝蔓入，扫壁土苔侵。\n花韵空禅性，松声学梵音。\n翻经仍用贝，布地不须金。\n小舞阶前鹤，微鸣柳外禽。\n鸦昏争乱集，蛩冷罢孤吟。\n树影分邻屋，秋声急暮砧。\n平芜供远望，密雨值登临。\n景胜驱尘想，形忘浃素襟。\n几筵寒阁静，灯烛夜窗深。\n旨蓄僧开供，芳醪客自斟。\n黄柑来野市，紫蟹出溪浔。\n契合元非旧，情亲已独钦。\n知师甘寂静，愧我叹浮沉。\n明日天边去，何时重盍簪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10442,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄周记室履道","author":"徐贲","text":"湖波遥带夕阳低，想得君家住更西。\n隔岸众山晴稍出，当门幽鸟晚犹啼。\n酒缘客里偏能饮，诗到愁边只谩题。\n欲倩归云寄离思，如何却向望中迷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10443,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚过广福精舍访传上人","author":"徐贲","text":"水阴山色晚依微，松映禅房竹映扉。\n幽鸟不缘留客语，閒僧方自施经归。\n移来片石安茶器，分得孤云补衲衣。\n杖屦不嫌频过共，道心久与世相违。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10444,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠医士吕彦伦和王原吉韵","author":"徐贲","text":"橘花开处杏阴青，百草吹香觉地灵。\n贫士愿留赊药劵，故人思读卫生经。\n玄霜玉臼晴犹湿，华月丹房夜不扃。\n张绪苦吟仍病肺，乞和熊胆护修龄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10445,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送马敬常县丞","author":"徐贲","text":"楼倚层城拥翠岚，登高送别思那堪。\n双溪到郡同流北，千嶂连关尽向南。\n澹澹水阴云度渚，萧萧荷响雨鸣潭。\n寻常不醉临岐酒，今日因君饮易酣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10446,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"待董彦正文学次王守敬主簿韵","author":"徐贲","text":"旅馆江湖苦往来，那堪时节并相催。\n雪当腊尽寒才见，梅在春前冻未开。\n野客过期空具黍，山童不语讶停杯。\n相思独坐寒斋晚，禁得边城鼓角哀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10447,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"许将军墓","author":"徐贲","text":"乡人传有汉将军，南郭桥边是故坟。\n印出土中存旧字，碑残火后失全文。\n旗捲虎牙空落木，剑埋龙气只寒云。\n当时秘器多荣赐，功业于今恨不闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10448,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"病中寄北郭诸友","author":"徐贲","text":"病中长日惟思睡，家僻因怜寝舍幽。\n山暗园林多夏蝶，树荒城郭少晴鸠。\n药囊卧具聊重整，酒债诗缘得暂休。\n却忆故人居咫尺，可能相过慰深愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10449,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送金子肃","author":"徐贲","text":"客中相见客中怜，江海知名记十年。\n归路正当归雁后，送君却在送春前。\n迢迢烟水分行棹，浩浩莺花共别筵。\n自信平生足游赏，看山重约岂无缘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10450,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜坐次张士行太常韵","author":"徐贲","text":"练衣入夜更萧骚，草暗閒阶露渐凋。\n青鸟音书云外至，素娥环佩月中摇。\n醉来犹记题罗扇，梦去曾教听玉箫。\n独坐无端思往事，秋风客馆正寥寥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10451,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答高季迪期游云岩","author":"徐贲","text":"山中风景绿阴时，但得閒行莫恨迟。\n啼鸟犹能知劝酒，馀花应是待题诗。\n且将尽日酬登览，况值频年在乱离。\n晴雨明朝那可定，故人何用预相期。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10452,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"琼姬墓","author":"徐贲","text":"馆娃宫里已堪愁，况是泉台閟小丘。\n月冷宝奁无复晓，地空玉雁不知秋。\n萝间旧屋僧来往，竹下新亭客过游。\n不有佳名留郡志，谁能识此为停舟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10453,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"同高季迪过东丘兰若访吕志学","author":"徐贲","text":"路入斜塘始泊舟，喜同故友访东丘。\n知君暂寓当幽寺，念我才归自远州。\n水外高帆沙浦月，烟中馀稻墓田秋。\n临尊何用多悲感，今日相看尚黑头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10454,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送袁伯贞之湖广","author":"徐贲","text":"寻常送别自堪怜，君去那能不怅然。\n客路有兰知楚地，驿亭多雨忆吴天。\n离鸿一一风樯外，寒水程程雪嶂前。\n后夜相思千里隔，江乡梅柳是新年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10455,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过俞幻闇故居","author":"徐贲","text":"水南别业远无邻，我独重来是故人。\n经榻香灯非旧火，禅房花木自新春。\n传心曾嗣高僧法，画影空留居士身。\n寂灭不知何可乐，凡情未免为沾巾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10456,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过姚大临寓所","author":"徐贲","text":"客居龙井古庄前，兵后人家几变迁。\n乱世昔来求避地，故乡今想赋归田。\n曾邀霁月看花夜，忆别春风禁酒年。\n此日重过谁候我，寒烟衰草却留连。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10457,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南园废宅","author":"徐贲","text":"桂堂倾圮藕池枯，旧径新移路转迂。\n射圃春风谁走马，歌台夜月自啼乌。\n看花尚有閒人到，索酒今无醉客呼。\n多少侯家尽消废，如何来此独踟蹰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10458,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]