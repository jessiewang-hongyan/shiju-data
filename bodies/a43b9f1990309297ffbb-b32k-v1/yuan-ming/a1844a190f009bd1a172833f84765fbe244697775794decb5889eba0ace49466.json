[{"title":"题画赠崔子文","author":"倪瓒","text":"性癖居幽每起迟，一来溪口意凄迷。\n林亭晓色苍茫里，目送风帆过水西。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14213,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠曹德昭","author":"倪瓒","text":"谷口桐林落绛霞，仙帆初泊野人家。\n萧閒馆里青苔合，看到阶前芍药花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14214,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"清明后题","author":"倪瓒","text":"野棠花落又清明，杨柳青青人耦耕。\n春物阑珊成底事，半江疏雨暮潮平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14215,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"看花仕女图","author":"倪瓒","text":"画图常识春风面，云雾衣裳楚楚裁。\n为问人间春几许，石栏西畔牡丹开。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14216,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"烟雨","author":"倪瓒","text":"烟雨空濛远树齐，人家树底自成蹊。\n只因二月吴松尾，渚际维舟听竹鸡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14217,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"十月","author":"倪瓒","text":"十月江南未陨霜，青枫欲赤碧梧黄。\n停桡坐对西山晚，新雁题书已著行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14218,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春雨","author":"倪瓒","text":"春雨萧条独掩扉，庭柯径筱绿依依。\n莫思南渚停舟处，烟柳垂阴满钓矶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14219,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚照轩偶题","author":"倪瓒","text":"檐前幽鸟自相呼，池上红蕖映绿蒲。\n五月夜凉如八月，一窗风雨梦南湖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14220,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为潘仁仲写梧竹草亭","author":"倪瓒","text":"翠竹萧萧倚碧梧，一亭聊以赋閒居。\n浮杯乐饮思潘岳，藻思春江濯锦如。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14221,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋怀","author":"刘永之","text":"白日行西陆，气候惨以悽。\n沈沈夜未旦，皎皎明月辉。\n寒蛩响阴砌，羁鸟鸣高枝。\n耿耿不能寐，揽衣起徘徊。\n天道谅幽远，人理固多违。\n命彼西方人，喟然伤我怀。\n翩翩梁间燕，矫矫云中雁。\n南翔复北逝，时序倏已换。\n驾言出西郊，登高纵游观。\n原野何萧条，流潦方漫漫。\n苌楚有馀悲，下泉兴永叹。\n安得携美酒，聊以娱今旦。\n幽幽涧里兰，娟娟常自好。\n秋风厉严威，零落随百草。\n芬芳岂不美，衰荣顺天道。\n嗟我平生友，离居心懆懆。\n坐令鬓成素，为欢当及早。\n昼夜相代更，谁能置怀抱。\n凉飙振庭树，浮云结重阴。\n中情忽不乐，拂几弹鸣琴。\n泠泠多苦调，零泪沾衣衿。\n远怀东都士，登彼北邙岑。\n怅然望京洛，五噫发哀吟。\n悠悠千载下，谁识古人心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14222,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"翠屏山房为罗伯纲赋","author":"刘永之","text":"结构依茂林，开轩面青嶂。\n浮岚变朝采，宿雨经池上。\n春阳正和煦，生意日条畅。\n径草绿已繁，皋兰叶初放。\n脩翰摩烟霄，游鳞泳清涨。\n动息皆自然，至理妙无象。\n遗纷便静观，寂寞谐所尚。\n偃仰丘壑间，中情无得丧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14223,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟行胶浅晚泊小桥期至豫章而别则咫尺矣即事书怀简何平子","author":"刘永之","text":"偶遇乘槎侣，因辞下泽车。\n客程兼旦暮，川路滞风沙。\n石碎愁鹅子，汀长怯犬牙。\n急湍腾雪马，浅溜蹙霜花。\n聚舫时连鹢，攒篙若斗蛇。\n去留因地利，漂泊任天涯。\n洲指黄牛近，山瞻白鹤遐。\n潭烟迷浦溆，岸火识人家。\n系缆安桩栻，偎篷宿苇葭。\n中宵渔响歇，向晓雁声哗。\n忽忆别期促，还怜光景赊。\n剑愁分紫气，酒喜酌彤霞。\n坎壈身如寄，蹉跎鬓欲华。\n相期何处好，勾漏问丹砂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14224,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"方壶画轩岐论道图为道士何仲旭赋","author":"刘永之","text":"彩笔发神秘，仙山开画图。\n灵文隐玉笈，石扇启金枢。\n寤寐轩岐术，结交苏董徒。\n羽服系萝带，筇杖悬药壶。\n行当谢尘服，从子昆崙墟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14225,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绿锦池为定侯赋","author":"刘永之","text":"官沼湛芳泉，红栊照绮钱。\n藻丝翻玉鲤，柳叶曳金蝉。\n日护瑰文丽，云回碧甃圆。\n凌波乘洛佩，向月映湘弦。\n树影浮觞近，花阴列籍连。\n鉴湖宾客在，共赋绿荷篇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14226,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杨弘中药室","author":"刘永之","text":"秉志慕冲澹，息迹在丘园。\n閒庭遍芳草，高窗见远山。\n采苓陟松径，煮术散榆烟。\n董生垂往躅，嵇子有遗编。\n神宇谢氛浊，天倪谅斯全。\n惟当振尘服，与子共清言。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14227,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题烟云台","author":"刘永之","text":"祠宫俨肃穆，灵贶赫然敷。\n藻井垂珠实，素壁绘金图。\n涧长三花树，林栖九子乌。\n遥峰隐残照，丹霞晚渐舒。\n眇然登云驾，谁谓古今殊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14228,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山亭宴坐怀西峰诸友","author":"刘永之","text":"荒溪无来轨，山亭迥且深。\n清风左右至，夏木霭繁阴。\n飞飞双珍禽，喈喈流好音。\n怀君青霞佩，历乱朱弦琴。\n惟应西峰月，可以喻同心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14229,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"经采石望太白墓","author":"刘永之","text":"采石多名酒，苔矶水自香。\n昔年李太白，于此屡衔觞。\n失意长安道，狂歌入楚邦。\n云烟挥翰墨，宫锦制衣裳。\n醉骨埋青嶂，荒祠带夕阳。\n余亦忘机者，翩然辞帝乡。\n田园萧水上，井邑葛山旁。\n去去随鸥鸟，烟波正渺茫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14230,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪峰诗为蜀人赋","author":"刘永之","text":"岷峨镇坤维，上有太古雪。\n寒光万壑连，皓采千峰列。\n石窦玉泉生，琪树瑶华结。\n拄笏面嶙峋，中怀共高结。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14231,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题枯林兰","author":"刘永之","text":"猗兰生远壑，葳蕤粲玉芳。\n白露漙夕景，光风转朝阳。\n吹箫望澧浦，鼓枻向沅湘。\n何以贻远者，徘徊双鸣珰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14232,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寓潇洲田庄","author":"刘永之","text":"暄风变时节，春衣犹未换。\n城郭日驱驰，郊坰偶游观。\n新芜望中绿，飞花坐来满。\n浊酒聊自倾，醉即眠山馆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14233,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"同刘伯高分韵得羽字","author":"刘永之","text":"僧居谢烦燠，萧条对疏雨。\n碧甃跃金鳞，石梁散文羽。\n水气暗浮窗，林烟细萦树。\n忽忆掉觥船，牵荷弄秋渚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14234,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠友人之章贡","author":"刘永之","text":"秋雨正冥冥，秋风何淅淅。\n对酒送行人，忧思坐填积。\n黄鹄不可驯，飞蓬易相识。\n几日对崆峒，沧洲渺难极。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14235,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"黄士一为余作墨梅效阴何体","author":"刘永之","text":"朝阳耀白雪，微月照寒泉。\n玉环承佩结，明珠缀组连。\n不愁歌次阕，已向画图传。\n讵是扬州郭，偏蒙何逊怜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14236,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"王若水山水","author":"刘永之","text":"谷口寒潮上，厓阴宿雾开。\n石桥通窈窕，金栈寄崔嵬。\n树暗茅堂闭，波明桂楫回。\n山中花落尽，为报豫章台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14237,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和席焕章韵","author":"刘永之","text":"西窗山茶初作华，屋角枯杨啼早鸦。\n景物苍茫岁年暮，自笑经年犹别家。\n玉梁之山峡江上，金洞琼峰郁相向。\n却忆幽人住涧阴，寄我山中采薇唱。\n昔者登临访紫烟，石幢题字不知年。\n松杉老大堪围带，桥水新生胜榜船。\n仙人瘗剑青山麓，扪萝下窥翳修竹。\n服食争求五色芝，咽泉谁试千秋菊。\n于今局促少清閒，梦著只在仙厓间。\n世事撩人心懆懆，诵君新诗为解颜。\n相亲未厌相疏久，鸟鸣嘤嘤思我友。\n旷怀宁讶山阳鍜，任达长耽步兵酒。\n独愁无力济时纷，壮志销沈老一村。\n自昔艰难仗豪杰，令人长忆李长原。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14238,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山居图","author":"刘永之","text":"世传隐处祗空闻，草断行踪路不分。\n鬼谷树深衣湿翠，凤林芝暖石生云。\n寒泉叠响清琴调，白雪飞花逐剑文。\n已约八公携手去，青岑从此谢嚣氛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14239,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"北涧春日二首 其一","author":"刘永之","text":"青松绕舍间幽篁，白板扉高薜荔墙。\n窗晓禽声答人语，山春兰气杂梅香。\n家留渝曲幽居僻，草满临城旧业荒。\n坐忆交亲半沦没，不因鸣笛自沾裳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14240,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重过何氏北涧","author":"刘永之","text":"北堂宴罢倚微醺，竹几灯花坐夜分。\n再酌兰樽浮绿醑，重拈綵笔写清文。\n山寒岚气朝成雨，地湿松阴暮起云。\n休讶野人留恋久，十年江海厌离群。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14241,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和杨允恭金明桥晚眺韵","author":"刘永之","text":"杨烱多才爱碧流，金明桥上对汀洲。\n日沈水屋蒹葭晚，凉入山衣薜荔秋。\n草色浅深行处合，岚光明灭望中浮。\n鱼凫零乱扁舟集，浑似东湖钓石头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14242,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虞心山迁居隐仙寺奉柬一首","author":"刘永之","text":"山房借得就新泥，晏食随僧拾涧菲。\n邻瓮酒香朝可贳，佛幢灯火夜堪依。\n沙田紫蔗家家熟，野径丹枫处处飞。\n待约彭镛去相觅，哦诗写遍竹间扉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14243,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题雪林墨竹","author":"刘永之","text":"望霓旌兮云间，吹参差兮湘沚。\n灵雨兮朝飞，冲风兮夕起。\n忆素手兮同携，步捐瑶兮玉趾。\n解翠佩兮明珰，寄相思兮千里。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14244,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题赵子深山水 其一","author":"刘永之","text":"山苍苍兮嵚崟，谷窈窈兮阻深。\n木含滋兮竞秀，云欲雨兮昼阴。\n蹇行人兮中流，棹扁舟兮容与。\n渺余怀兮曷从，望岩扃兮延伫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14245,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题赵子深山水 其二","author":"刘永之","text":"白露零兮中洲，瑶草歇兮岁已遒。\n吹洞箫兮建翠旂，望佳人兮澹忘归。\n九疑兮嵯峨，冲风起兮水扬波。\n嗟白石兮昼晦，思千里兮奈何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14246,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"酬别宋赞善大夫景濂二首 其一","author":"刘永之","text":"诸老风流邈不闻，谁携健笔继清芬。\n南宫新赐郎官佩，东观长留太史文。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14247,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"四时词 其一","author":"刘永之","text":"兰风吹暖度书帏，桃雨烘晴映玉池。\n鬼谷树深衣湿翠，一帘花影碎琉璃。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14248,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"四时词 其二","author":"刘永之","text":"翠竹庭深枕簟凉，疏帘风度芰荷香。\n觉来摛藻心如水，茧纸新题急就章。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14249,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"豫章访旷达不偶题壁","author":"刘永之","text":"湖上青青万柳条，吹箫曾记醉相邀。\n重来相觅不相遇，却驾柴车过市桥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14250,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"庚戍正月仆有金陵之行而商翁将归高安同舟至湄湘留数日不能相违夜宿王氏甥西斋吹箫酌酒为别夫倾盖相逢犹有分携之感况平生故人耶书此以见眷恋之情耳","author":"刘永之","text":"鸾箫缓引酒重倾，夜久灯花陊玉罂。\n君向云山我朝市，江城风雨倍伤情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14251,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题扇与羽士","author":"刘永之","text":"缥缈楼居隔紫霞，华阳真逸过君家。\n金盘不荐宾筵实，自有玄洲五色瓜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14252,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题扇 其二","author":"刘永之","text":"五粒松交九节蒲，铜瓶分水浸珊瑚。\n小窗閒度游仙曲，吹遍参差白玉竽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14253,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西风古道图为寺僧赋","author":"刘永之","text":"古道西风疋马还，数家茅屋住秋山。\n只疑路近东林寺，遥听钟声暮霭间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14254,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题竹 其二","author":"刘永之","text":"楚人江上竹枝歌，风雨潇潇放棹过。\n翠黛含颦欲谁怨，九疑云暗奈愁何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14255,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题扇与何重容","author":"刘永之","text":"溪南溪北水云村，茅屋书灯对掩门。\n昨夜西风送微雨，荷花初落槿花繁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14256,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄洁斋主人","author":"刘永之","text":"高斋寂寞谁堪侣，陶器单衾与素琴。\n惟有空潭夜深月，一泓寒景照人心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14257,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"墨竹","author":"刘永之","text":"石荷长梢双凤尾，雷惊空谷九龙章。\n高秋坠露浓如乳，泻入金盘胜玉浆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14258,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜宴凝清轩","author":"刘永之","text":"夜久灯花落酒缸，綵笺题句更催觞。\n今宵独卧西窗月，惟有梅花入梦香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14259,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题青山白云图","author":"刘永之","text":"苍苔茅屋面春山，飞翠浮岚晻霭间。\n一别渔矶成十载，羞将华发对青湾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14260,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"墨竹 其一","author":"刘永之","text":"白石苍苔嶰谷秋，疏篁古木共清幽。\n折钗书法今谁继，惆怅令人忆蓟丘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14261,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"墨竹 其二","author":"刘永之","text":"春至黄陵江水生，明珰翠佩不胜情。\n微风淅淅闻鸾吹，疏雨潇潇湿雉旌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14262,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题兰石一幅赠萧伯舆宪史调闽中","author":"刘永之","text":"武夷山中石如玉，西涧无人瑶草青。\n悬厓搴芳思独往，香气袭衣秋露零。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14263,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山有杞","author":"戴良","text":"山有杞，于吴之里。\n君子至止，可以宴喜。\n水有鱼，于吴之墟。\n君子止居，可以宴胥。\n于山于水，有轩膴膴。\n何斯违斯，莫或遑处。\n于水于山，有亭闲闲。\n何斯违斯，莫或遑安。\n安其可怀，耄将至矣。\n今也不乐，岁月逝矣。\n爰作斯图，式歌且谣。\n愿言公退，惟以逍遥。\n其乐也哉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14264,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"巫山高","author":"戴良","text":"巫山望欲极，神女出何迟。\n朝暮自云雨，君王徒梦思。\n魂乘林树合，心著峡猿悲。\n婉娈阳台夜，不知今是非。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14265,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"鸿雁生塞北行","author":"戴良","text":"鸿雁何从来，千里度江湘。\n当春既北飞，涉秋复南翔。\n岂不念乡塞，所至逐炎凉。\n客子别家久，遥遥征路长。\n朝游齐鲁国，暮行吴越乡。\n何思拔泰茅，惟忧系否桑。\n壮心移岁华，徂貌委年霜。\n蓬飞绕本根，蕖落恋旧房。\n此邦虽乐土，故乡焉可忘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14266,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"朱鹭","author":"戴良","text":"朱鹭何从止，去啄金堤饮玉水。\n朝随赤雁暮碧鸡，荡漾惊波不得栖。\n有时挟子上林去，网丝纷纷复难避。\n不如敛翅江海湄，远却幽并游侠儿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14267,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"白头吟","author":"戴良","text":"莫把白头吟，来调绿绮琴。\n蜀客当年聘私室，两情总向琴中得。\n谁信黄金买赋时，已是青蛾辞宠日。\n兔丝春来托女萝，雪霜未至尚缠柯。\n若个人心如草木，不到白头妾遭逐。\n妾有嫁时绿玉簪，时时插髻悦君心。\n一朝坠地双股折，恰似君心中道绝。\n我簪纵折犹共藏，君心一绝去他乡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14268,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感怀 其三","author":"戴良","text":"玄圃有丹木，八干何亭亭。\n光同白玉润，液比碧瑶清。\n不知何年代，产此至阳精。\n仙经所尝言，服之可千龄。\n吾将具舟楫，涉海掇其英。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14269,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感怀 其四","author":"戴良","text":"良辰岂长遇，阴晦在须臾。\n今日弗为乐，明旦恐不如。\n都门多佳丽，清啭当座隅。\n促席道平素，况有高士俱。\n列俎过三鼎，倾酒尽百壶。\n挥金娱心意，慷慨不留储。\n达人每滔荡，俗士恒自拘。\n白头怀轗轲，抚己一长吁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14270,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感怀 其五","author":"戴良","text":"落叶响空山，羁鸟号穷林。\n此时单居妇，哀怨起瑶琴。\n清商逐风转，三叹有馀音。\n分明曲中意，感此离恨深。\n空床亦易守，时寒难独禁。\n凉飙一夕起，达曙怀重衾。\n君固执高节，讵知伤妾心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14271,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感怀 其六","author":"戴良","text":"家藏两宝剑，已合雌与雄。\n潜锋在金匣，谓当长相从。\n何言风雨夕，化作双蛟龙。\n一游吴水西，一落丰城东。\n相去邈千里，时时气上冲。\n神物终不隔，岁晏会当逢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14272,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感怀 其七","author":"戴良","text":"游鱼返于渊，飞鸟归于山。\n行子别乡国，既久何当还。\n日落长风起，棱棱气遂寒。\n居人息深帷，浮客未遑餐。\n忧虞销素质，风霜凋夙颜。\n惟馀一寸心，岁暮保贞坚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14273,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]