[{"title":"宿七里山","author":"郭钰","text":"寒松雾暗月西颓，人语无声鬼语哀。\n郡国忍闻侯景诏，朝廷初弃戴渊才。\n风传鼙鼓惊魂战，天入乡关望眼开。\n骨肉死生俱未卜，泪痕血点满苍苔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6573,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"癸巳元日","author":"郭钰","text":"屠苏酒暖破朝寒，旧写桃符忍再看。\n太史未颁周正朔，遗民思睹汉衣冠。\n天边星斗孤槎远，雪后江山万木残。\n再拜中庭宾旭日，共瞻霁色散云端。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6574,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"二月二十七日闻故乡寇退","author":"郭钰","text":"铜驼荆棘换东风，消息南州久不通。\n芳草得春烟涨绿，野棠无主雨飘红。\n雕戈元帅登坛暇，宝玦王孙哭路穷。\n满眼亲朋总悽恻，相逢但索语音同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6575,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄龙子雨","author":"郭钰","text":"书到山中收泪看，出门愁散楚天宽。\n落花春尽休文瘦，细雨更长范叔寒。\n金带宦情违俗久，绨袍交态见君难。\n欲为后会知何日，酒熟还家得尽欢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6576,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠刘明道","author":"郭钰","text":"义旗献凯满南州，君拥兵符控上流。\n隔岸人烟邻虎穴，中江雪浪送龙舟。\n剑鸣秋匣玄霜下，马浴晴波紫雾浮。\n白羽指挥能事集，底须万里始封侯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6577,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋日还山闻南省消息示从弟铨","author":"郭钰","text":"南国风高闻好音，邻翁酒熟晚相寻。\n雁飞汉苑书来往，竹暗湘江泪浅深。\n茅屋暂归秋四壁，柳营烦费日千金。\n疮痍早使能苏息，独抱长贫亦素心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6578,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重和荅周闻孙进士兼寄宗瑾","author":"郭钰","text":"飘零不改旧乡音，来往空山费独寻。\n楚地人烟三户在，汉家宫阙五云深。\n急风乱飐蒹葭雪，斜日残明橘柚金。\n公瑾雄姿最英发，还乡何日共论心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6579,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"分府同知瑶童相公大阅之日天使适至喜而赋诗奉寄刘宾旭参军 其一","author":"郭钰","text":"鼓角缘边永夜哀，使车忽自海南来。\n中朝旧法三章在，大将新图八阵开。\n玉帐分明传号令，金台杂遝贮贤才。\n早看送喜麒麟殿，五色云中进寿杯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6580,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"分府同知瑶童相公大阅之日天使适至喜而赋诗奉寄刘宾旭参军 其二","author":"郭钰","text":"金络银鞍翡翠裘，参军马上最风流。\n相逢把酒青油幕，每忆题诗黄鹤楼。\n采凤衔图尧殿晓，苍鹰整翮楚山秋。\n攀龙早及风云会，归换貂蝉尚黑头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6581,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"分府同知瑶童相公大阅之日天使适至喜而赋诗奉寄刘宾旭参军 其三","author":"郭钰","text":"韬钤兵卫立参差，军务初閒且赋诗。\n健笔有神倾后辈，美名如玉重当时。\n青云鹤引朝天路，白羽鹅翻洗墨池。\n近见元戎再乘胜，凭君多制凯歌词。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6582,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"分府同知瑶童相公大阅之日天使适至喜而赋诗奉寄刘宾旭参军 其四","author":"郭钰","text":"侯印军符塞紫衢，儒生白发混泥涂。\n儿骑竹马谈兵法，地尽桃源入战图。\n双剑舞閒歌激烈，一灯愁绝照清癯。\n山中薇蕨秋风老，心折孤村反哺乌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6583,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和杨绳彦正茂才","author":"郭钰","text":"仗剑三年去里闾，桃源仙客独安居。\n雨鸣脩竹凉欹枕，花落小窗晴曝书。\n谁与捲帘通燕子，自须入海掣鲸鱼。\n村园明日君能到，一径苍苔待剪除。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6584,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"甲午元夕","author":"郭钰","text":"已无钗钏典村醪，儿女炊羹荐野蒿。\n灯火独摇元夕梦，干戈浑减少年豪。\n云韬月色归天阙，雨压寒声欺布袍。\n却忆将军平寇处，昆崙夜度不辞劳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6585,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中过龙西雨","author":"郭钰","text":"云连茅屋树声寒，旧补貂裘带尽宽。\n萧瑟乡关愁庾信，清明风雨过苏端。\n苍龙波暖开鳞甲，黄鸟巢深护羽翰。\n侧想蓬莱云气上，群仙缥缈控飞鸾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6586,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感怀","author":"郭钰","text":"白发溪翁斸草根，晚炊儿女带啼痕。\n斜阳燕语兴亡事，阴雨鬼号新旧魂。\n战伐不闻烽火息，诛求惟见简书存。\n艰难负米归无日，夜雨青灯梦倚门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6587,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚过山庄","author":"郭钰","text":"草满畬田落照斜，溪行尽日少人家。\n自伤直性从干谒，谁在穷途不怨嗟。\n香火氤氲王子庙，旌旗明灭长官衙。\n主人问客知名姓，始肯开门唤煮茶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6588,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和杨彦正茂才","author":"郭钰","text":"故山叠叠是愁端，真宰何由刬翠峦。\n客馆雨声灯火共，皇都春色画图看。\n花飘金谷彩云散，木落洞庭归雁寒。\n见说携家近仙馆，红尘咫尺不相干。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6589,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南省战船至吉安喜见官历","author":"郭钰","text":"干戈阻绝岁时迁，几向空山卜月圆。\n仍睹帝尧颁玉历，兼闻杨仆将楼船。\n旌旗日月临西楚，带砺山河拱北燕。\n赖有忠良扶社稷，愿闻筹策早安边。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6590,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄宾旭刘参军","author":"郭钰","text":"经年避地百忧并，君独还乡少俗情。\n净洗木瓢分药晒，新裁纨扇写诗成。\n半蓬溪雨群鸥散，万壑松风独鹤鸣。\n只好闭门度长夏，巾车莫遣野人惊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6591,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送阮弘济赴梁使君幕","author":"郭钰","text":"诸生白发守章句，磊落长材自不群。\n河内已留贤太守，霸陵又起故将军。\n铁丝箭簇鸣秋月，银错旗竿竖晓云。\n文采久为当路重，更期马上立奇勋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6592,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠周原道兼柬安子静将军","author":"郭钰","text":"武节遥瞻汉署郎，威棱犹带柏台霜。\n江通吴楚波涛息，天入燕秦道路长。\n白羽昼挥谈虎略，黄旗暮捲护龙骧。\n宜春进士兼文武，好是青云共激昂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6593,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄罗履贞兼柬谢君绩","author":"郭钰","text":"烽火平安月正中，思君长倚翠楼东。\n儒生忧国灯前泪，壮士封侯马上功。\n半榻松风看草檄，一庭花雨坐调弓。\n谢庄文采江东少，青竹题诗想最工。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6594,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送朱鹏举照磨赴江西省掾","author":"郭钰","text":"花外银鞍鞴紫骝，省郎文采自风流。\n英雄旧总三千士，美誉新传十一州。\n山拥宜春深带甲，江通章贡小容舟。\n晨趋黄阁参筹画，愿审安危拓远谋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6595,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"白鹭洲晚泊呈天隐兄山长兼柬曹居贞","author":"郭钰","text":"白鹭洲前春水宽，素王宫殿压惊湍。\n风飘坠瓦鸳鸯冷，雨暗疏篁翡翠寒。\n维翰未能穿铁砚，叔孙先已改儒冠。\n凄凉讲席君仍在，晚岁冰霜独立难。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6596,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"大洲宴集","author":"郭钰","text":"杀贼归来心甚欢，酒美不辞春夜阑。\n俯江楼迥月色白，缘边鼓歇烽烟寒。\n玉骢谁送美人去，锦瑟更为将军弹。\n惭愧书生饮独少，自剪银烛题诗看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6597,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄杨和吉龙西雨","author":"郭钰","text":"江南徐庾知名久，文采风流伯仲间。\n彩笔题诗传上国，画船分雨过西山。\n管宁旧向辽东老，杜甫新从巴道还。\n扰攘战尘徒旅苦，故人应怪鬓毛斑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6598,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中","author":"郭钰","text":"柴门日落锁秋阴，白酒愁来只细斟。\n松下紫苔留虎迹，雨中苍桧作龙吟。\n汉宫金狄空垂泣，秦地桃源不可寻。\n咫尺山中愁出入，何时江上足登临。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6599,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"别萧伯章","author":"郭钰","text":"萧郎三十文采殊，锦霞暖矗青珊瑚。\n酒来独对公荣饮，诗成笑遣王奎书。\n黑风捲云惨饥虎，黄叶打头骑蹇驴。\n明日山中径归去，梅花夜月情何如。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6600,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"即事","author":"郭钰","text":"西上官船日报频，倚门收泪问行人。\n颍川太守终难借，细柳将军始是真。\n木落高秋悬杀气，律回寒谷见阳春。\n不辞斗粟输军府，但觅山岩著老身。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6601,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄刘宾旭","author":"郭钰","text":"旧日相逢玉雪姿，三年幕府鬓如丝。\n波涛入海屠龙苦，风雨还山买犊迟。\n客到定能频换酒，花开应不废题诗。\n只怜双剑床头吼，又是邻鸡报晓时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6602,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉和刘士贵","author":"郭钰","text":"路转春山昼启关，玉骢深系绿杨间。\n延平波浪双龙合，辽海风烟独鹤还。\n扇外红尘从战斗，尊前白酒且清闲。\n诸孙早岁多文采，憔悴青灯我厚颜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6603,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寒夜思亲","author":"郭钰","text":"老亲白发抱诸孙，寄食偏怀地主恩。\n故国山河空洒泪，残年风雪更消魂。\n绩麻谁与寒分火，待米长孤暮倚门。\n生子不才名位晚，愁来诗句共谁论。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6604,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉寄吴琳子茂镇抚二首 其一","author":"郭钰","text":"宜春台前记胜游，主人与客俱风流。\n春秾携酒骑小铁，夜深分烛归南楼。\n雁鸿几年断书信，豺虎是处森戈矛。\n闻君总戎下章贡，明日相候青门丘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6605,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉寄吴琳子茂镇抚二首 其二","author":"郭钰","text":"英雄之姿不易得，慷慨汗马收奇功。\n簸旗风高捲飞雨，舞剑日落摇晴虹。\n官酒春酣百杯绿，檄书夜草双烛红。\n伫看献凯报天子，锦衣五马蓬莱宫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6606,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"愁甚","author":"郭钰","text":"白璧黄金不疗饥，王孙携此独安归。\n四郊烽火山川窄，十月雨寒雷电飞。\n豪杰忧时常共济，功名报主不相违。\n临危进退如无据，青史他年有是非。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6607,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"残年","author":"郭钰","text":"久愁兵气涨秋林，不谓残年寇转深。\n四野天青烽火近，五更霜白鼓声沈。\n金张富贵皆非旧，管乐人材不到今。\n江上米船看渐少，捷书未报更关心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6608,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和周霁海吴镇抚诗三首就呈李伯传明府 其一","author":"郭钰","text":"老子悬车归旧隐，诸孙戏采泛晴晖。\n画图烟树松千尺，门径秋花菊四围。\n得句欲题青竹满，携琴每候白云归。\n残年颇觉头如雪，愁满江空羽檄飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6609,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和周霁海吴镇抚诗就呈李伯传明府","author":"郭钰","text":"牛斗秋高剑气横，几人马上取功名。\n扇挥白羽临风迥，甲锁黄金射日明。\n贾诩自期能料敌，山涛谁谓不知兵。\n官军蓄锐何时发，久厌城头鼓角声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6610,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和周霁海吴镇抚诗三首就呈李伯传明府 其三","author":"郭钰","text":"愁来倚剑立苍茫，谁在筹边策最良。\n捕贼五更唐李愬，挥戈万众汉云长。\n烽烟满接城楼近，鬼火寒穿石径荒。\n多少材官雕羽箭，不知何日殪天狼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6611,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁酉元日","author":"郭钰","text":"城北城南暗战尘，东风吹泪满衣巾。\n秦雠犹待楚三户，汉将徒封赵四人。\n此会屠苏浓味薄，谁家桃板旧题新。\n赛神江上情如海，且祝平安问老亲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6612,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"风雨舟中作","author":"郭钰","text":"憔悴江头路已穷，小舟隔岸复相通。\n归云乱拥青山树，飞雨斜穿白浪风。\n避地数年成老丑，累人一饭尚西东。\n凭谁为息鲸蛟怒，容我沧浪作钓翁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6613,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感事","author":"郭钰","text":"荆徐千里混干戈，日日君王候凯歌。\n上相出师三月罢，南人待援六年过。\n未休练卒诛求尽，暂脱归囚反侧多。\n独拜将坛须国士，抡材谁似汉萧何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6614,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"道逢八十翁","author":"郭钰","text":"八十老翁行步奔，存亡共诉断愁魂。\n千金歌舞随流水，六载干戈弃故园。\n晚灶燎衣篱竹尽，春牛换米草蓑存。\n情知青史无名姓，短策犹期报国恩。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6615,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柬王志元茂才","author":"郭钰","text":"亲朋乱后长相失，伯仲江边得数过。\n久客问邻赊酒易，知君随处赋诗多。\n鸟啼花树惊残雨，鸥散柳塘回细波。\n怀抱暂开欲相问，不知佳句近如何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6616,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晴晓","author":"郭钰","text":"最忆山中桂树林，早春无日不登临。\n衣冠并集吾庐盛，旗鼓俄分将垒沈。\n山色故乡青未了，鬓毛新岁白相侵。\n物情自觉伤怀抱，野鸟弄晴空好音。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6617,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和刘渊象贤晚眺","author":"郭钰","text":"日落孤城叠鼓鼙，谁家山北复山西。\n干戈满地愁相续，道路还乡望转迷。\n风度生香花远近，雨团湿翠竹高低。\n刘郎欲问桃源路，红叶流波好自题。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6618,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉同楚金和蒲掾","author":"郭钰","text":"健儿分队舞朱干，玉帐将军按剑看。\n笳鼓夜鸣边月迥，旌旗晓竖野云寒。\n皇图不假山河险，民俗终同社稷安。\n早晚虞廷有苗格，薰风披拂五弦端。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6619,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉和刘宾旭兼柬罗履贞","author":"郭钰","text":"时危南国久连兵，幕府才华得合并。\n蔡寇遂烦唐宰相，汉仪犹待鲁诸生。\n三边烽燧晨传箭，千骑弓刀昼绕营。\n主将策勋朝帝阙，从官应许任公卿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6620,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送杨和吉过龙兴","author":"郭钰","text":"十月北风蛟鳄伏，楼船安稳出官河。\n交游湖海知谁在，将帅朝廷近若何。\n一水才通南浦近，众星还拱北辰多。\n清和元帅烦相问，独钓寒江月满蓑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6621,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉赠江西省郎中颜希古","author":"郭钰","text":"江西羽檄日交驰，君佐中书策最奇。\n南极星垂天地正，北庭兵合鬼神知。\n君王旧赐冯唐节，父老新传李愬碑。\n尽刬贼壕归禹贡，更烦深意问疮痍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6622,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客鬓","author":"郭钰","text":"夕报将军奏凯歌，马前又见拥雕戈。\n民情共倚金汤固，客鬓惟添霜雪多。\n何日梧桐鸣彩凤，旧时荆棘卧铜驼。\n无衣无食岁年晚，妻子山中如苦何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6623,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"小除夕","author":"郭钰","text":"当年腊日还乡早，弟劝兄酬何怨嗟。\n肠断此时同避地，眼穿永夜倍思家。\n乡关去雁浑无信，风雨寒灯不作花。\n最是五更情调苦，城南吹角北吹笳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6624,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"与黄子益将军","author":"郭钰","text":"将军文采旧知名，幕府分曹按甲兵。\n雪壁画龙晴雾合，羽林飞鸟朔风轻。\n赵云对敌关张并，马援归朝陇蜀平。\n凭仗早除狐兔乱，吴山楚水共秋澄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6625,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"大洲晚发","author":"郭钰","text":"城南桴鼓转相惊，却忆渔舟问水程。\n千顷江波鸥出没，数家茅屋树枯荣。\n客行落日凝愁思，人隔疏烟闻笑声。\n惆怅竹篱沽酒处，夜深灯火不胜情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6626,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉柬陈君与掾吏","author":"郭钰","text":"汉室元勋曲逆侯，诸孙文采蔼南州。\n薇垣地切星河冷，幕府霜飞草木秋。\n采笔樽前赋鹦鹉，银鞍花外鞴骅骝。\n独怜江海干戈满，愿属安边第一筹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6627,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和酬友人","author":"郭钰","text":"百年谁肯长拘束，每到花时愁闷过。\n金石人间春梦短，玉堂天上月明多。\n归栖旧燕依林木，变化飞鱼借海波。\n逆旅马周豪气在，怜才深意待常何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6628,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉同顺则赠邹省掾","author":"郭钰","text":"中朝大将霍嫖姚，材杰如君早见招。\n入幕文书金印大，行营笳鼓玉骢骄。\n兵谋合变元多与，杀气凭陵未尽消。\n好待楚江鲸浪静，白云深处共归樵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6629,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"戊戌元日","author":"郭钰","text":"戎马七年犹带甲，客怀元日厌题诗。\n愁来刁斗声相续，老去屠苏酒到迟。\n野烧暖回云际碧，江梅寒护雪残枝。\n近闻拜相登耆旧，郡国朝正莫后期。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6630,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送李谦道入省叔父","author":"郭钰","text":"中郎不见十年过，千里趋陪意若何。\n骨肉共论青眼旧，形容应接白须多。\n三关虎豹传新捷，百粤莺花入醉歌。\n莫叹他乡为客久，故乡是处阻干戈。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6631,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉和龙西雨自洪见寄","author":"郭钰","text":"青楼风月故相干，慷慨樽前舞地宽。\n锦绣春明花富贵，琅玕昼静竹平安。\n杉关旗鼓元戎胜，闽海舟车去客欢。\n旧日交亲应有问，一蓑烟雨楚江寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6632,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]