[{"title":"送陈众仲","author":"吴克恭","text":"西阁梧桐安凤巢，羽仪五色异凡毛。\n往时学省文名重，今代词林王气高。\n春到御沟生绿水，地连宫柳间红桃。\n老去相如少词赋，颂声转拟属王褒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12373,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赋少尹乃元臣为东平郡王之诸孙求诗","author":"吴克恭","text":"圣历开文运，王章定武功。\n大人推部落，开府冠山东。\n日月旂常异，河山带砺同。\n诸孙传赤舄，小雅播彤弓。\n一命起居注，载趋长乐宫。\n掖庭官济济，淮浙赋中中。\n窃忌徵求急，方来福禄崇。\n翱翔鸾凤日，逆顺马牛风。\n帝力生成大，人心灌溉公。\n共图歌政理，多稼答年丰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12374,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送张中丞之官翰林","author":"吴克恭","text":"中丞献纳道如何，内相丝纶宠莫过。\n槐阁地联文石陛，杏园春满曲江波。\n阴阴雨露深青琐，个个星辰湿绛河。\n花蕊隔箫宫漏近，柳条当户晓莺多。\n中官送酒青丝络，上苑乘骢白玉珂。\n岂独寸心图补报，要须元首及赓歌。\n太常礼乐还相问，阁老才名迥不磨。\n通国此时同怅望，忆公何处最委蛇。\n鳌峰巨石森蓬岛，香殿微风拂御罗。\n延祐得贤俱第一，野人白首□林阿。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12375,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"横塘曲","author":"吴克恭","text":"妾家住横塘，绿水映垂杨。\n五月南风起，荷花似藕香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12376,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐宫咏","author":"吴克恭","text":"斗草赌珠襦，穿花提玉壶。\n东头老供奉，好似执金吾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12377,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"蝶","author":"吴克恭","text":"失意穿罗袖，缘情恋绣床。\n妒遗衣上粉，狂觅酒边香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12378,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"莲叶何田田","author":"吴克恭","text":"莲叶何田田，田田生绿波。\n明朝大如盖，风吹将奈何！","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12379,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"草生磐石上二首 其一","author":"吴克恭","text":"草生磐石上，根深石不露。\n水流磐石间，风吹下山去。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12380,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"草生磐石上二首 其二","author":"吴克恭","text":"草生磐石上，似许行人坐。\n水流磐石间，不许行人过。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12381,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日","author":"吴克恭","text":"映日含风白苧衣，香飘晴雪弄春晖。\n故人骑马不相识，蛱蝶自来衣上飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12382,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"偶成","author":"吴克恭","text":"船落黄泥与白沙，春光都在棠梨花。\n蜜蜂相喧作何语，日晚松阴报午衙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12383,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"陶巨川归养","author":"吴克恭","text":"雁过秋霜落满衣，数声相近白云飞。\n寄书莫送浔阳鲊，采石江头鱼最肥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12384,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄石民瞻","author":"吴克恭","text":"涧泉堂上白须翁，苦忆云山杖屦同。\n秋到黄花无几日，人生只合酒杯中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12385,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题元晖山水","author":"吴克恭","text":"江上江云漠漠寒，有时带雨过层峦。\n只愁海岳庵前路，水没黄沙鸭觜滩。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12386,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗五首 其一","author":"周棐","text":"应龙果何物？\n变化在斯须。\n嘘气云雾蒸，下雨泽九区。\n差差喉下鳞，婴之能杀躯。\n那因情欲牵，豢畜同渊鱼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12387,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗五首 其二","author":"周棐","text":"邯郸有猛虎，曾参能杀人。\n斯固不足凭，浮言乱其真。\n憸人舌下刀，数加君子身。\n何如冥冥羽，不为矰?亲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12388,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗五首 其三","author":"周棐","text":"团团青铜镜，昔从轩辕铸。\n面涵孤月光，背隐双龙跗。\n美貌欣自修，丑容羞见妒。\n人心自亲疏，镜明只如故。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12389,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗五首 其四","author":"周棐","text":"猗兰生中谷，不采恒自香。\n园丁亦何知，掇置近中堂。\n朝培根愈萎，暮沃叶已黄。\n将养虽以时，物性终见伤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12390,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗五首 其五","author":"周棐","text":"萧萧水中蒲，琐琐蒲上禽。\n托身自得所，不忘罾罥侵。\n天风断枯条，卵破巢亦沈。\n兹焉复何尤，慎之在初心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12391,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀古","author":"周棐","text":"我爱陶渊明，所居惟种柳。\n与世实寡谐，委怀在杯酒。\n不有千古心，谁识千载后。\n意欲从之游，斯人复何有。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12392,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"述怀","author":"周棐","text":"平生远尘事，畏触忧患端。\n矧兹值多故，而敢怀自安。\n寄身涂旅中，戚戚苦饥寒。\n为生耻无庸，缉遗守微官。\n虽云匪多秩，所职期可观。\n顾非周员器，轨事仍独难。\n蹇予亦何为？\n俯仰徒长叹！","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12393,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"至正辛丑秋七月十有三日憩龙渊景德禅院分韵得閒字","author":"周棐","text":"终岁局城府，长有戚戚颜。\n晨登郭西寺，逍遥任疏顽。\n林堂含馀清，爽垲非人间。\n况兹群彦集，秩秩文翰班。\n善谑等高咏，嘉言振幽孱。\n岂无觞酌欢，茗煎亦未悭。\n喧卑受物旷，志遹忘世患。\n耽留阳景驰，飞羽当树还。\n赏心颇逡巡，纷虑仍粗关。\n谐此尘外踪，再期永日閒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12394,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"至正甲辰九日同牛谅伊甫陈世昌彦博徐一夔大章高巽志士敏释良琦元璞守良□□登东塔以杜少陵玉山高并两峰寒之句分韵赋诗得并字","author":"周棐","text":"东住有高塔，名与福城并。\n九日陪诸贤，登临期绝顶。\n秋深木叶落，不觉天地迥。\n凉飙洒林霏，咫尺衣裳冷。\n玉田好开怀，何止供香茗。\n幽轩赏佳菊，竟夕忘酩酊。\n昔人昼游此，衣饰率尚褧。\n寥寥千载间，视若空华等。\n清境素情惬，尘心未全屏。\n感彼兴我怀，钩诗记深省。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12395,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"修禊日偕曹广文七人游南湖赋得裴休旧业休字公美舍宅为寺今真如寺是也","author":"周棐","text":"幽赏殊未穷，扬舲济南湖。\n载瞻裴公宇，萧条乃禅居。\n缅思太和年，秩班百寮初。\n晚怀超俗缘，息心究空虚。\n岁月既云迈，世事亦已徂。\n峨峨清辉堂，遗构委榛芜。\n斯人不可为，慨伤独在余。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12396,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"三月望日偕曹广文游南园得多字","author":"周棐","text":"暮春适休暇，步游散烦疴。\n复兹名园赏，为乐讵云多。\n依丛爱繁绿，缘冶弄轻波。\n景幽兴弥臻，虑澹神始和。\n谁思遽旋归，夕曛在城阿。\n永谐尘外踪，明晨复来过。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12397,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夏夜宿流虹寺有感","author":"周棐","text":"驰骛竟朝暮，似缘饥冻迫。\n如何百年间，区区为形役。\n世途寡相知，腼颜徒自饰。\n所获既非宝，所丧良可惜。\n生理固草草，进退量我力。\n岂乏希世荣，前车已当阨。\n流光急奔马，素业纷断织。\n圣道卒未闻，怛焉增内惕。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12398,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感兴","author":"周棐","text":"萧萧五花马，矫矫七尺身。\n饮马恒以时，剪刷谓有神。\n轻泥障文锦，新鞍鞁雕银。\n所期越千里，不辞厮养勤。\n过都未及试，一蹶不再伸。\n吁嗟世之人，求名不求真。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12399,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨夜感怀二首 其一","author":"周棐","text":"卧闻窗间雨，萧飒夜将深。\n转望壁上灯，依微照孤衾。\n抚兹凄绝候，感此迟暮心。\n平明视青镜，白发满华簪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12400,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夜不寐三首 其一","author":"周棐","text":"高馆夜无寐，孤衾转萧爽。\n惊风振庭柯，落叶走阶响。\n沈忧静中起，离怀益难广。\n寂寞谁晤言，残灯耿虚幌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12401,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夜不寐三首 其二","author":"周棐","text":"濩落颇已久，衰迟亦何甚。\n因念平生怀，悲悽不能寝。\n薄帷照明月，中宵益凄凛。\n展转殊未休，疏钟度高枕。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12402,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夜不寐三首 其三","author":"周棐","text":"昨日又今日，今朝又明朝。\n蹉跎竟何为，坐令颜鬓凋。\n代耕既非望，閒居亦无聊。\n孤怀共谁写，仰屋奏七谣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12403,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题俞仲刚山水","author":"周棐","text":"我昔四明寻隐者，著屐远过玉几山。\n岩扉苔径转森邃，结窠乃在云松间。\n松间回风荡空影，水流花开春日永。\n苧服凉深团扇开，好鸟飞来意俱静。\n为觅渔梁白沙步，因识樵人弈棋处。\n扁舟□泊碧溪阴，沿月长歌下山去。\n束带十年事朝谒，鹤怨猿惊总凄切。\n草堂晴昼玩新图，三叹令人欲愁绝。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12404,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"访鲍仲孚先生隐居","author":"周棐","text":"溪上斋居好，幽偏事不侵。\n桑麻存晚计，图史乐初心。\n岸帻幽窗晓，移床绿树阴。\n卜邻何代老，从此数相寻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12405,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次石监征韵","author":"周棐","text":"忆子临东海，征帆几日回。\n鼍鸣津鼓合，蜃起石楼开。\n官酒应深酌，春衣或未裁。\n题诗纪游历，时寄到蓬莱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12406,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次陈彦博编修雨中见怀","author":"周棐","text":"泽国仍多雨，溪流没两涯。\n墟烟迷小市，泥草乱空阶。\n蕴藉诗中意，苍茫病里怀。\n明朝晴色好，对话两情谐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12407,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送崇德州夏同知","author":"周棐","text":"慷慨持征节，雄谈息战尘。\n有生皆帝力，无地不王臣。\n为国丹心在，论功白发新。\n他年忠义传，端合继前人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12408,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送人归楚","author":"周棐","text":"楚甸荒凉旧镇微，春来渐觉思依依。\n故乡兵后今谁在？\n游子江南恨独归。\n长路关心闻过雁，孤城回首见斜晖。\n家人十载伤离别，芳草閒堂静掩扉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12409,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄沂阳刘廷镇员外","author":"周棐","text":"故人相与最从容，尚忆论诗向夜中。\n白首无家十年别，青山何处一樽同。\n梦回孤馆灯前雨，目断西风塞外鸿。\n谁识离怀愁绝处，野庭依旧穆陵东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12410,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"吴中","author":"周棐","text":"两岸春云暗柳条，满篷风雨过枫桥。\n空怜越绝溪山好，且听《吴趋》巷陌遥。\n官舍晚凉飞燕子，水乡人静卖鱼苗。\n谁家白皙佳公子，剩把黄金买阿娇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12411,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄子高都事","author":"周棐","text":"昔年相与最多情，尚忆联镳度锦城。\n御水满沟看洗马，宫墙隔树听流莺。\n别来故旧今谁在？\n老去艰虞只自惊。\n山色湖光总无赖，不堪幽独转愁生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12412,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登崇德城有感","author":"周棐","text":"溪上孤城百雉馀，城门犹自护储胥。\n霸陵空宿将军骑，范叔应随使者车。\n鸡犬萧条兵过后，渔樵散漫市休初。\n老年触事多成感，閒向芭蕉叶上书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12413,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄舍弟鼎","author":"周棐","text":"生计依人转寂寥，别来心事向谁消。\n镜中华发随年改，溪上青山入梦遥。\n对酒便思归白社，将书不敢寄洪乔。\n越情吴思浑无赖，独倚江楼送暮潮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12414,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"临平道中寄京师诸友","author":"周棐","text":"云外群山绾翠螺，马蹄长是客中过。\n关河树色秋光近，驿路蝉声晚更多。\n千古心期空皓首，百年人事等沧波。\n自惭薄劣频趋走，几度因风想玉珂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12415,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日雨中漫成次顾玉山韵兼简石监征","author":"周棐","text":"十日春泥懒入城，满湖风雨未开晴。\n草堂欲补宁忘破，沙鸟频来莫漫惊。\n桥外柳条随意绿，坐间苔色傍人生。\n缘知花事浑能几，好买芳樽对客倾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12416,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄刘孝章经历","author":"周棐","text":"意气倾人记昔年，东风飞盖日翩翩。\n花明古戍春停骑，月上清江夜放船。\n老去交游谁更健？\n乱来踪迹总堪怜。\n山光水色浑无赖，却数冥鸿野外天。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12417,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵送陈寿夫之湖州","author":"周棐","text":"识君虽早送君迟，却愧相看在乱离。\n十口一家无别业，此身何日是閒时。\n青山满路春船酒，白月空江客枕诗。\n我有好怀谁得共，鸥波千顷雨丝丝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12418,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄吴兴张别驾","author":"周棐","text":"鸳鸯飞去潦波平，曾听骊歌忆送行。\n南浦移舟官树绿，西亭酌酒晚风晴。\n异乡春近多新梦，远使书回足旧情。\n欲识怀君无限意，满城芳树乱啼莺。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12419,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵顾玉山见寄","author":"周棐","text":"白水青山杳眇边，每怀高节自茫然。\n不从猿鸟疏名姓，虚托鳞鸿问岁年。\n灯外檐花清夜雨，江头云树暮春天。\n须知无限沧洲意，渺渺东风一旆悬。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12420,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"渡钱塘江","author":"周棐","text":"日出长江烟雾开，越山吴树抱江回。\n霸图踪迹空今古，天堑东南有劫灰。\n山郭雨昏云似墨，海门潮急浪如雷。\n舟师省柁须看客，不数瞿塘滟滪堆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12421,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送南台察掾张志学赴都","author":"周棐","text":"蓬莱宫阙五云间，天上群仙集佩环。\n珥笔每同花下散，玉珂时听月中还。\n清秋幕府芙蓉静，白日门屏獬豸閒。\n浩荡天风吹鹤驭，春朝入觐紫宸班。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12422,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵顾玉山寄张子渊","author":"周棐","text":"险宦何殊阚九渊，且将萧散事馀年。\n风前白苧裁春服，花外青藜挂酒钱。\n圣世敢云轻绂冕，野人端合老林泉。\n养生况有封囊药，坐听流莺手自圆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12423,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日偕顾玉山汎舟平家湖访石仲德次韵","author":"周棐","text":"湖上春光生绿波，湖头柳色似新鹅。\n已知出郭尘諠少，更喜临流乐事多。\n稳坐兰舟胜上马，新裁苧服不须罗。\n茅堂只隔东西瀼，随意相从载酒过。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12424,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"琦元璞所藏赵子昂马图","author":"周棐","text":"进驭归来日未西，落花芳草满春泥。\n也知枥上无凡马，牵过天闲不肯嘶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12425,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"双松图","author":"周棐","text":"凿凿岷峨插彼苍，海波不动海天凉。\n双蛟化作神仙去，明月中宵剑影长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12426,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"苧村烟雨","author":"周棐","text":"凫雁人家秋水多，澹烟疏雨暗渔蓑。\n分明记得南塘路，何处行舟《白苧》歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12427,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"白云海歌次文学古韵","author":"瞿智","text":"白云深，白云深，白云深护山之心。\n有时随龙去沧海，倏焉天宇团秋阴。\n英英不来入我牗，直上璇霄掩箕斗。\n或贯日色流玉虹，或漏雷声堕天狗。\n山人学禅草庵里，静看白云朝暮起。\n此心欲与云俱閒，又逐溪风过溪水。\n纷纷武士尚挥戈，格斗东南未决何。\n安得此云化霖雨洗兵甲，散为玉烛四海皆阳和。\n云兮云兮如擘絮，奈此东流复如注。\n山人祇在玉山中，长绕山人草庵住。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12428,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虎丘燕集送□□□之秣陵分赋姑苏台","author":"瞿智","text":"高台崔巍插天起，势压雄城三百里。\n云窗雾阁迷烽烟，日日吴王醉西子。\n桂膏兰烬烧春云，锦丝瑶管空中闻。\n甲兵重来破歌舞，粲齿修眉散如雨。\n双钩带血不敢飞，城荒草碧春风吹。\n祇今惟有台前月，曾照吴宫花发时。\n慷慨悲歌叹陈迹，霜乌怨啼枫叶赤。\n明朝送客过钟陵，西望茫茫五湖白。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12429,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"从军行二首 其一","author":"瞿智","text":"年少去从军，妻儿生死分。\n弓开孤月影，剑动七星文。\n解识风云气，能穿虎豹群。\n不将身许国，何以树功勋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12430,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"从军行二首 其二","author":"瞿智","text":"破敌三营外，城头日欲低。\n举烽连碛远，战气接云齐。\n旌帜惊乌起，铙箫杂马嘶。\n祇愁千里月，少妇正悲啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12431,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵吕养浩","author":"瞿智","text":"客子频烦尺素修，江云变态故生愁。\n山回绝磴参差树，花隐重城缥缈楼。\n雨里未须秦望屐，雪馀拟汎越溪舟。\n蒙郎古道多归思，桃叶春情隔渡头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12432,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"十一月廿四日绍兴作","author":"瞿智","text":"秦望山头云气生，越王城下湖水平。\n梅花欲放不尽放，雨色待晴还未晴。\n铜驼金谷非故里，青衫白发徒虚名。\n可怜百年已过半，空嗟万古难为情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12433,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]