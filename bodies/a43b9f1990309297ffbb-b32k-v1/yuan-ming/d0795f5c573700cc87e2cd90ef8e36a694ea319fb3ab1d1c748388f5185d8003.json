[{"title":"学仙曲二首 其一","author":"张昱","text":"仙人好乘白鹿轓，更剪明霞作飞带。\n醉来濯发向银湾，龙剑直倚青天外。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5712,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"学仙曲二首 其二","author":"张昱","text":"徐卿有子抱才贤，天上麒麟正妙年。\n书案囊萤勤自勉，吟窗临草颇堪怜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5713,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题桐柏宫","author":"张昱","text":"吹笙太子慕餐霞，一鹤空山总是家。\n桐柏几回清露重，人间容易日西斜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5714,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画梅花","author":"张昱","text":"铅华学作内家妆，画出宫眉岁月长。\n不与东风共摇落，人间天上尽吹香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5715,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送春","author":"张昱","text":"送春何事典春衣，销得杨花几度飞。\n掌上玉杯成惯见，年年长是送春归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5716,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"巾子峰","author":"张昱","text":"青冥天界碧迢迢，仙客遗巾竟寂寥。\n犹有白云闲似鹤，与人相伴夜吹箫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5717,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题孔主奉宅画菊","author":"张昱","text":"朝阳下照东篱菊，影落前庭亦有香。\n好伴容安斋内客，玉盘承露对秋光。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5718,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题三香图","author":"张昱","text":"离骚比兴诸香草，不见三香入楚词。\n莫是岁寒将自异，众芳芜秽不同时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5719,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪夜寄史左丞","author":"张昱","text":"白雪相将一尺深，碧油窗合夜沈沈。\n党家更有人如玉，犹道春寒入绣衾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5720,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题渔村晚照","author":"张昱","text":"在在溪湾尽晒罾，暮天秋水碧澄澄。\n几家渔舍云深处，红树寒山路惯登。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5721,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丹溪别业图，为周昉赋","author":"张昱","text":"文光万丈照丹溪，爱尔慈乌夜夜啼。\n父有遗经能教子，草堂犹在此溪西。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5722,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题夏圭孤舟风雨图","author":"张昱","text":"此船载得许多愁，使我樽前感旧游。\n惆怅扬州十年梦，满江风雨泊瓜洲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5723,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题归钓图","author":"张昱","text":"雨笠风蓑日往回，桃花流水碧山隈。\n潭中渔钓何能尽，收却纶竿归去来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5724,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题溪居图","author":"张昱","text":"朝市尘埃若我何，幽栖好处是松萝。\n前溪若与天河接，夜夜水中星斗多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5725,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绍兴客中除夕","author":"张昱","text":"一岁今朝是岁除，旅人况复在离居。\n从来牛女成惆怅，乌鹊桥边莫寄书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5726,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"玩月图","author":"张昱","text":"天地有情俱是感，兔蟾应自念婵娟。\n分明照见山河影，一岁无如此月圆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5727,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"家人辈开螯侑杯即事","author":"张昱","text":"东床敧枕未成眠，玉手开螯自可怜。\n得似瓮头狂吏部，江头风味落樽前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5728,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题读碑图","author":"张昱","text":"未瞻鲁庙三缄口，且读曹娥八字碑。\n较智只争三十里，杨修谁说是男儿？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5729,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题枯木竹石二首 其一","author":"张昱","text":"风雪禁持百岁过，真成生铁铸枝柯。\n天寒翠袖能相倚，免得春来缠女萝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5730,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题枯木竹石二首 其二","author":"张昱","text":"一勺水中藏白蜃，一毫端上画青蛇。\n世人只道韩湘子，药术能开顷刻花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5731,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"热","author":"张昱","text":"南州大暑何可当，雪冰不解三伏凉。\n夜深明月在天上，白露满湖荷叶香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5732,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画雨竹","author":"张昱","text":"江上数声湘女瑟，烟中一曲竹枝歌。\n叶间有恨俱成泪，只为曾承雨露多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5733,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题桶底图","author":"张昱","text":"不向粟中藏世界，却来桶底画楼台。\n分明记得麻姑语，清浅蓬莱水一杯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5734,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题渔樵闲话图","author":"张昱","text":"渔樵本自不同科，何事停桡话更多？\n说与别人都不信，夜来风雨湿青蓑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5735,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题徽庙画鹌鹑","author":"张昱","text":"长白山前马似龙，相将风火入深宫。\n君王苦好丹青笔，犹恐鹌鹑画未工。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5736,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题茅堂雪景图","author":"张昱","text":"草堂有客何为者，应爱山川雪未消。\n床上一壶堪独酌，风流不减霸陵桥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5737,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闲居春尽","author":"张昱","text":"几日春残不在家，阶前开遍粉团花。\n再看又是明年事，酒滴东风惜岁华。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5738,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题渊明像","author":"张昱","text":"典午功名等羽毛，区区州县亦徒劳。\n折腰五斗无人识，只有归来最是高。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5739,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"升仙坛","author":"张昱","text":"坛上春风长紫苔，当时仙驾此徘徊。\n山中老尽千年树，化鹤何因一再来？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5740,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题王若水画翎毛二首 其一","author":"张昱","text":"喔喔雄鸡趁晓光，岂同雌雉在山梁？\n云中鹰隼无虚爪，羽翼低飞好自防。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5741,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题王若水画翎毛二首 其二","author":"张昱","text":"东风吹水碧漪漪，不放桃花自在飞。\n莫怪野凫惊不定，溪头弋者未忘机。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5742,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题道士王东甫图画","author":"张昱","text":"金银楼阁在三山，东甫何妨屡往还？\n信是神仙在平地，鹤飞元不离人间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5743,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄报国寺渭清远上人","author":"张昱","text":"谁设严关一两重，直教隔断白云踪。\n城中何限萧家寺，不把三间事远公。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5744,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桂花仙子图","author":"张昱","text":"秋云几片剪衣裳，吹尽西风骨更香。\n明月不应生洛浦，又添情思恼陈王。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5745,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"船过临平湖","author":"张昱","text":"船过临平欲住难，藕花红白水云间。\n只因一霎溟濛雨，不得分明看好山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5746,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄三塔寺宽虚海","author":"张昱","text":"望见寺前三塔近，老夫指拟驻行舟。\n无端一阵东风雨，吹过湖南不自由。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5747,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"淩霄花","author":"张昱","text":"天女天花一样娇，淩霄挽下最长条。\n生愁化作空山雨，满脸春红恨未销。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5748,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题新亭壁","author":"张昱","text":"为爱庭前金凤花，风吹满地散残霞。\n清尊团扇能相伴，饮到海天秋日斜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5749,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题修竹士女图","author":"张昱","text":"袖卷香罗日又曛，寸心都作锦回文。\n莫教吹动参差玉，惊断阳台一段云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5750,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题左司壁","author":"张昱","text":"春日团团日未斜，东风满地散青霞。\n晓莺啼过落花雨，独立淮南宰相家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5751,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题王若水画","author":"张昱","text":"萱草花开日又西，太湖石畔鹧鸪啼。\n竹枝不是江南曲，唱得樽前思欲迷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5752,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题唐十八学士图","author":"张昱","text":"尧舜之道载方策，人存政举又何疑？\n肃容敛手惭色者，知是当年封德彝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5753,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题赵子昂浴马图","author":"张昱","text":"真是房星夜降精，双瞳下照水波明。\n浴回有翼应飞去，万里风云是一程。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5754,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"风马","author":"张昱","text":"时清天地息烟尘，腾跃乘看自有神。\n游牝委龙求作种，任渠风合向天津。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5755,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"嘉禾湖上，为谢参军题扇","author":"张昱","text":"鹦鹉杯中红曲酒，鸳鸯湖上黑油船。\n南风吹入荷花荡，借与闲人一醉眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5756,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"明皇对弈图","author":"张昱","text":"漏尽宫壶日晷移，君王犹是恋残棋。\n马嵬一著无人算，只有杨妃自得知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5757,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题杨妃横玉图","author":"张昱","text":"天宝年间好太平，华清小殿称人情。\n如何玉笛才拈起，便作风吹别调声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5758,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日游湖","author":"张昱","text":"神仙不死今何在，富贵能全古亦难。\n剩买苏公堤上酒，莫教容易度春寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5759,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题白玉蟾像","author":"张昱","text":"白玉如蟾俱是妄，青天指月亦非真。\n武夷洞里曾相见，却是寻常劈篾人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5760,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"咏何立事","author":"张昱","text":"旧作衙官身姓何，阴司归后记仙魔。\n视身已是闲躯壳，一领蓑衣也是多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5761,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谢太傅","author":"张昱","text":"谢安德望重南朝，妓女东山未寂寥。\n若论汉家勋业事，何如笳鼓霍嫖姚？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5762,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"四果画，石榴","author":"张昱","text":"照眼红绡未十旬，西风又折锦苞新。\n石家金谷如长在，尽有明珠换美人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5763,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桃实","author":"张昱","text":"汉帝求仙不自知，祗凭青鸟使瑶池。\n矮人不见东方朔，肯信三偷是此儿？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5764,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"枇杷","author":"张昱","text":"叶底累累黄渐深，煖风四月熟幽林。\n记曾摘遍西园树，好似文君取酒金。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5765,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"樱桃","author":"张昱","text":"廊庙尝新出上阑，内厨酪粉赐金盘。\n白头见画成惆怅，满朵春红不厌看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5766,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"效唐僧无则咏物诗四首 其一 百舌禽","author":"张昱","text":"巧作春禽百样声，似矜觜舌有馀轻。\n若为剩有闲心性，何不云中学凤鸣？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5767,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"效唐僧无则咏物诗四首 其二 鸬鹚鸟","author":"张昱","text":"缡褷羽翼作群飞，残害溪鱼欲自肥。\n满嗉腥涎吞不下，为人长忍一生饥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5768,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"效唐僧无则咏物诗四首 其三 木笔花","author":"张昱","text":"木笔花含晓露浓，似将才思拟春风。\n若还开在江淹宅，夜夜题诗入梦中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5769,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"效唐僧无则咏物诗四首 其四 金钱花","author":"张昱","text":"小小红丝叠绛霞，钗头玉燕共年华。\n果然买得青春在，尽把名园种此花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5770,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"紫菊花","author":"张昱","text":"应为扬州旧使君，鸡冠颜色染歌裙。\n陶翁九日东篱下，谁肯花前问紫云？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5771,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐太宗遣御史萧翼赚禊帖图","author":"张昱","text":"君臣诡遇一呆僧，禊帖虽来事可惩。\n谁料万年归葬后，却将茧纸累昭陵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5772,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宫廊雪霁图","author":"张昱","text":"画在丹青事已非，碧山犹自绕朱旗。\n分明黄屋宸游处，千步宫廊雪霁时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5773,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"东坡笠屐图","author":"张昱","text":"从来泾渭不同波，得贬黎中幸已多。\n莫把丹青论笠屐，文章千载一东坡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5774,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杜宵画围棋图","author":"张昱","text":"何事今朝懒画眉，深宫又是日长时。\n闲愁不用量红线，看取新添几著棋？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5775,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨晴","author":"张昱","text":"蔷薇正开雨弄晴，狂风触处乱红英。\n韩朋莫作双飞蝶，泊在其中画不成。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5776,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晓起","author":"张昱","text":"杏子花开桃萼红，夜来疏雨过帘栊。\n风光虽是好时节，春在谁家弦管中？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5777,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"松瀑图","author":"张昱","text":"石间激浪雪无迹，松下瀑流雷有声。\n百折狂澜非是险，人心方寸最难平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5778,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寒食","author":"张昱","text":"钱塘江上逢寒食，远客今朝转念乡。\n几树落花春寂寂，数行回雁草茫茫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5779,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"孙钟设瓜图","author":"张昱","text":"三士凭空化鹤群，已将旗盖兆三分。\n刘家门外楼桑树，岂是荒唐谶所云？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5780,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"岳林寺题兜率内院，为玘石心上人赋","author":"张昱","text":"兜率天宫内院开，锦衣弥勒笑盈腮。\n因缘未了儿孙债，此是重来第几回？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5781,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻夜潮","author":"张昱","text":"潮到江楼月到迟，百年心事有谁知？\n床头寻得刘琨剑，舞向春风惜旧时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5782,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"张横塘画竹枝萱草","author":"张昱","text":"几宵明月竹枝好，一夜东风萱草长。\n怅望美人烟水阔，不胜清思绕横塘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5783,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"荔枝画，为福建佥宪张惟远题四首 其一","author":"张昱","text":"樽前人出玉芙蓉，纤手亲分荔子红。\n归得大明湖上宴，也应看画说闽中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5784,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"荔枝画，为福建佥宪张惟远题四首 其二","author":"张昱","text":"茜罗轻裹玉肌寒，吹尽南风露未乾。\n一寸丹心无与寄，为凭图画入长安。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5785,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"荔枝画，为福建佥宪张惟远题四首 其三","author":"张昱","text":"红尘一骑露华香，不管卢龙道路长。\n谁信御前供玉食，不呈妃子不先尝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5786,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]