[{"title":"观潮，次贝廷琚韵","author":"张昱","text":"世代销沉在此声，几回东下复西倾？\n翻腾日月迷朝夕，簸荡鱼龙定死生。\n衔石每怜精卫小，投醪未见浊河清。\n眼前波浪犹如此，莫说蓬山顶上行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4986,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题后堂壁","author":"张昱","text":"兵权去手志何伸，耻是随班入省频。\n京国蹉跎空在梦，蓬莱清浅已生尘。\n绕朝谩赠秦人策，孔子将书鲁国麟。\n散骑得辞丞相后，五湖安往不闲人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4987,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春闺词","author":"张昱","text":"白日高堂欲暮难，鸣鸠乳燕静相干。\n银瓶行酒双鬟绿，玉管调笙十指寒。\n蝴蝶每因飞处见，牡丹多是折来看。\n明朝为遣安西使，锦字红灯织夜阑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4988,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春怀","author":"张昱","text":"几涴先生漉酒巾，眼中犹是落花频。\n春来祗与醉为伴，睡起翻疑梦是真。\n翠羽栖香秦陇鸟，玉钗坠鬓洛阳人。\n风光已逐流年去，此事那容更问津？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4989,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"湖上漫兴四首 其一","author":"张昱","text":"百镒黄金一笑轻，少年买得是狂名。\n樽中酒酿湖波绿，席上人歌凤语清。\n蛱蝶画罗宫样扇，珊瑚小柱教坊筝。\n南朝旧俗怜轻薄，每到花时别有情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4990,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"湖上漫兴四首 其二","author":"张昱","text":"烂漫风光在酒家，狂蜂冶蝶趁繁华。\n人来人往如趋市，楼上楼前尽属花。\n波面画船双荡桨，堤边黄犊小游车。\n目成眉语知何限，消尽柔魂在狭斜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4991,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"湖上漫兴四首 其三","author":"张昱","text":"湖上新泥雪渐融，门前沟水暗相通。\n裙欺萱草轻盈绿，粉学樱桃浅淡红。\n暮雨欲来银烛上，春寒犹在酒樽空。\n青绫被薄不成梦，又是一番花信风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4992,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"湖上漫兴四首 其四","author":"张昱","text":"乐事杭州奈尔何，人间富贵易消磨。\n画船湖水年年在，红粉娼楼处处多。\n歌引行云来绮席，舞翻回雪下春波。\n东坡往日留诗后，更有何人载酒过？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4993,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"同赵郎竹园夜饮","author":"张昱","text":"尘土无由得见侵，粉墙高护碧云深。\n日行南陆暑不到，月度天河龙自吟。\n沉饮何妨同阮籍，幽情亦或过山阴。\n夜凉庭院罗衣薄，吹彻参差思不禁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4994,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游云门寺，同宝林别峰尊师赋","author":"张昱","text":"东游好是云门寺，况在若耶溪水边！\n茶会诗传唐旧刻，松坛名重晋诸贤。\n行云欲傍支郎马，垂柳能维贺老船。\n也当一场风月梦，为题名姓法堂前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4995,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"凝香阁听雪","author":"张昱","text":"陡然寒重紫貂轻，便觉高檐瓦有声。\n欹枕欲同蝉壳蜕，开门唯恐鹤巢倾。\n数杯酒力春容转，满盏茶香夜思清。\n小玉近床推不醒，袖笼檀板失天明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4996,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桐柏宫留题","author":"张昱","text":"甚慕天台马子微，后千年始到幽栖。\n江湖岁月怜新梦，泉石烟霞感旧题。\n阿母信传青鸟后，玉笙人远绛河低。\n当时不尽风流兴，付与山莺尽日啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4997,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"绣毬花，次兀颜廉使韵","author":"张昱","text":"绣毬春晚欲生寒，满树玲珑雪未乾。\n落遍杨花浑不觉，飞来蝴蝶忽成团。\n钗头懒戴应嫌重，手里闲抛却好看。\n天女夜凉乘月到，羽轮偷驻碧阑干。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4998,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"竹居，为张行中题","author":"张昱","text":"南渡循王之子孙，文采风流今独存。\n既有绿筠为别业，何须画戟在高门？\n小堂翡翠横钗影，曲径莓苔散屐痕。\n侍婢牵萝相补葺，几回风雨送黄昏？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4999,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"菊隐斋，为金子才赋","author":"张昱","text":"莳菊家园作隐沦，要于晚节伴闲身。\n从来东晋多名士，岂独南阳有老人？\n色绽黄华知应候，香浮绿酒可过旬。\n苏耽橘井桐君箓，从古良医尽逸民。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5000,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"初月","author":"张昱","text":"薄暮蛾眉临水出，照人犹自未分明。\n初升远岫如无意，欲下西楼却有情。\n离别几多长在望，团圆三五未能成。\n岂知少妇阶前拜，罗袖才揎恨已盈。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5001,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"湖楼","author":"张昱","text":"楼前芳树碧盈盈，付与幽禽自在鸣。\n堤上马驮红粉过，湖中人载画船行。\n日长燕子语偏好，风暖杨花体更轻。\n何限才情被花恼，独教书记得狂名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5002,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"碧梧轩，为贾彦仁、彦德二贡士赋","author":"张昱","text":"贾家种玉能成树，上有结巢双凤凰。\n阴连深井暮云碧，花落大樽春酒香。\n孔雀羽毛歌扇小，石榴颜色舞裙长。\n莫教击坠轩前绿，留与吹笙共晚凉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5003,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"东堂梨花","author":"张昱","text":"为尔东堂雪满株，花时长是忆吾庐。\n风前恐化庄周蝶，月下还迷卫玠车。\n老至逢春成感慨，兴来把酒为踌躇。\n寻常一样清明节，说似当年总不如。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5004,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"问月亭","author":"张昱","text":"何事流年逐逝波，试将此意问姮娥。\n到头白发几人在，爱此清光今夜多。\n直欲仰空援北斗，便须尽量酌天河。\n此怀此处不倾倒，禁得宋郎秋思何！","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5005,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题清心堂诗卷后，为相院判赋","author":"张昱","text":"曾把桐乡作故乡，衙回系马入斯堂。\n窦家五子荣丹桂，谢氏诸郎焚紫囊。\n乞得异花曾见种，酿成名酒许先尝。\n潜然掩卷垂残泪，不独题诗愧老苍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5006,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠谢肃东还","author":"张昱","text":"风尘如此送君行，莫惜离觞与再倾。\n执手且听杨柳曲，过江便是越州城。\n龙驹堕地即千里，凤鸟及时才一鸣。\n年少有才终大用，贾生曾擅洛阳名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5007,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春晖堂，为谢肃题","author":"张昱","text":"谢傅风流在越乡，至今文采见诸郎。\n百年乔木慈乌聚，几日东风萱草长？\n江上鲤鱼朝入馔，枕前纨扇晚生凉。\n诗成便欲烦青鸟，衔置君家白玉堂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5008,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次林叔大都事韵四首 其一","author":"张昱","text":"春来长是误佳期，鸩鸟雄鸠不可私。\n错认樱桃悬蟢子，悔将衫袖染鹅儿。\n烧残蜡烛浑成泪，折断莲茎却是丝。\n辜负绿窗闲岁月，只教杨柳妒腰肢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5009,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次林叔大都事韵四首 其二","author":"张昱","text":"何处银鞍白鼻騧，忘将锦瑟数年华。\n渡头水急怜桃叶，陌上春狂信柳花。\n那得芳心对鹦鹉，泣将残泪付琵琶。\n一身已自成惆怅，况是平阳十万家！","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5010,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次林叔大都事韵四首 其三","author":"张昱","text":"莫谩题情在粉墙，藕丝终日系柔肠。\n不知汉主黄金屋，何似卢家白玉堂？\n好梦自抛桃叶后，闲愁似过柳条长。\n无端收得番罗帕，彻夜蔷薇露水香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5011,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次林叔大都事韵四首 其四","author":"张昱","text":"陈王当日赋凌波，写得风流也太多。\n掌上玉鸾看教舞，云中青鸟使传歌。\n情缄尺素鱼中字，恨织回文锦上梭。\n休信双星是牛女，年年波浪隔天河。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5012,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"白菊","author":"张昱","text":"雪羽毵然欲满丛，秋香吹遍画阑东。\n今宵白露今宵月，昨夜清霜昨夜风。\n朝灌尚于青蕊见，夕餐将与素霞同。\n数茎白发闲相对，谁识柴桑畤苧翁？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5013,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"惊秋","author":"张昱","text":"城上高风散鼓鼙，楼头独客不胜悲。\n老婴世故嗟流落，病念乡关厌别离。\n仰面绛霄犹昨日，惊心黄叶又当时。\n所悲骑省空名累，不是潘郎爱赋诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5014,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"昔游","author":"张昱","text":"春到名园总是花，都城无处不繁华。\n冠翘鹖尾朱袍盛，马顿金羁玉面斜。\n骑吏去忙官索酒，侯门散晚妓留车。\n党家贱妾粗豪惯，轻易银瓶雪水茶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5015,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"小王孙","author":"张昱","text":"貂帽貂裘美少年，圆牌通籍内门前。\n新分草地缘游猎，旧赐彤弓未控弦。\n银瓮蒲萄春共载，玉鞍骄马日随牵。\n穹庐一夜迷深雪，忘却朝天是醉眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5016,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"汉未央宫榱题砚","author":"张昱","text":"雕墙峻宇几浮云，金石虽坚亦鲜存。\n秦宫三月已灰烬，汉瓦千年犹隶文。\n改用尚能为砚器，得名何异在君门？\n咸阳土尽英雄骨，谁是榱题记主恩？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5017,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"匏瓜道人，为徐子贞赋","author":"张昱","text":"吾岂匏瓜系此生，道人玩世以为名。\n百年雨露司荣悴，一日江湖见老成。\n濩落情怀庄子瓠，浮沉踪迹楚王萍。\n壶公借与龙为杖，抛著青鞋到处行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5018,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋声","author":"张昱","text":"自从大火西流后，渐觉凉风到竹林。\n李白已无当世志，宋郎又动少年心。\n群阴得势夜声合，万物将穷杀气沉。\n谩索雅琴弹一曲，徽弦绕指是商音。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5019,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"七夕","author":"张昱","text":"天上何因有别离，人间谩自指佳期。\n果如女嫁男婚事，何限风清月白时？\n银汉几曾横鹊影，花盘空复罥蛛丝。\n今朝少妇心中事，只有回文锦字知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5020,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄淮安夏掖斋","author":"张昱","text":"为感风花懒出门，每于时事鲜知闻。\n江湖信远春空雁，僚佐情深日暮云。\n诗句好于何水部，官资高过杜司勋。\n海波不隔淮扬路，遥指蓬莱忆使君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5021,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"有馀清堂","author":"张昱","text":"连云骑省与之邻，可是高堂履舄频。\n湖水过云天似玉，山风吹酒月留人。\n红绡贴肉扶歌板，翠羽妆头出舞茵。\n礼法岂为吾辈设，直须乐死百年身。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5022,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柬示二侄女","author":"张昱","text":"连宵骨肉梦相牵，二女洪都有信传。\n闻说长成浑屋喜，寄来针线得人怜。\n阿婆近日身差健，老婶经年病未痊。\n尔叔治兵淮水上，使回怀抱觉凄然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5023,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄内台侍御史韩克庄","author":"张昱","text":"杂花犹记雨诸天，共礼旃檀古佛前。\n塔院施僧犹昨日，斋房听雨忆当年。\n抄书不许支官纸，买酒从教用俸钱。\n老尽尚书旧宾客，至今惭愧杜樊川。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5024,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜泊牛渚矶，同韩克庄佥事、李五峰先辈登蛾眉亭","author":"张昱","text":"牛渚矶头青雀舫，蛾眉亭上紫鸾笙。\n月中只可赋秋兴，酒后不宜留步兵。\n万里长河何处尽，百年遗恨此中生。\n水波总是英雄泪，刬却青山气未平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5025,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浙省感恩荣，言怀述事","author":"张昱","text":"仰拜宣黄萃一门，更烦使者枉南辕。\n宠荣已过愚民分，存殁俱蒙圣主恩。\n列爵称男分五等，封君有县亦通尊。\n区区戎马驱驰后，日月馀光照覆盆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5026,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"明皇妃子击丸图","author":"张昱","text":"画柱相当驰道开，黄旗风里试龙媒。\n天回日驭戎衣起，电绕星枢綵棒催。\n供奉嫔嫱皆令色，近前便佞是于思。\n九龄犹是开元日，何事都无谏疏来？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5027,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重过育王寺明月堂，同照大千尊师赋","author":"张昱","text":"又携二客过斯堂，惭愧当年塔院香。\n染习未除尘土念，奔驰犹作马牛忙。\n渐添白发头颅上，转觉青云道路长。\n尽醉堂前旧时月，莫将闲话及齐梁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5028,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠士人军中售笔","author":"张昱","text":"古来文字用铅椠，笔至蒙恬始得名。\n每日诸军传檄到，何人横槊赋诗成？\n管裁鸣凤巢边节，毫运饥蚕叶上声。\n莫鄙毛锥无所用，要知韩范尽书生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5029,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"廉都事海道失风，自耽罗至浙右，还闽省","author":"张昱","text":"指南针下失风帆，雪浪连天不见山。\n惟尔不怀和氏璧，彼苍竟锡大夫环！\n皇天未厌生戎马，国步何能断阻难？\n此去驿程三百里，海棠花底度闽关。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5030,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"侍御周伯温以行台羁留姑苏，柬寄之","author":"张昱","text":"白头岁月付流波，何物虚名在谏坡？\n属国莫嫌持节久，子阳犹谓见天多。\n强梁不见图销印，跋扈如闻欲倒戈。\n一树红梨春事晚，宣文阁下欲如何？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5031,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"残牡丹","author":"张昱","text":"绕阑莫惜酒行频，开到姚黄已暮春。\n琼树今朝歌正好，彩云昨夜梦非真。\n园林虽不异前日，车马可怜非旧人。\n欲倩东风问蝴蝶，花前谁是百年身？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5032,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠吴世显宣使，代张氏捧谢表请命朝廷，寄仲举","author":"张昱","text":"此去风波万里长，使人指日觐清光。\n云开雉扇当霄汉，龙抱金函出表章。\n羌服从来尊正朔，包茅次第贡明堂。\n浯溪有石高千丈，谩叟重烦颂大唐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5033,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题御史孟昉野服画像","author":"张昱","text":"好似当年贺季真，乞身归老镜湖春。\n铜章不绾御史印，练布能裁处士巾。\n麟阁云台千载后，鸟啼花落几回新？\n浮云过眼寻常事，且作齐东一野人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5034,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"王自牧、冷起敬诸文士游西湖、南山，记题其后","author":"张昱","text":"近闻甚得湖山乐，惜不与之同一游。\n莫问石城来艇子，却思箫管在扬州。\n枕边蝴蝶高楼梦，扇底芙蓉小院秋。\n今觉司勋非往日，酒间无复旧风流。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5035,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"得朱桓编修海道之音","author":"张昱","text":"命酒徵歌记往年，玉堂遂有梦相牵。\n鱼缄尺素虽云密，事载空言始可怜。\n季世人材思管乐，盛时戎马说幽燕。\n张骞惯识天河路，俯仰乾坤一慨然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5036,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"高房山画庐山图，贡云林待制有诗在上，为其子户部尚书贡师泰赋，盖其家物也","author":"张昱","text":"万壑匡庐纸满张，好诗好画两相当。\n十年物色偶然得，二老风流何可忘？\n还见虹光生静夜，却惊云气湿高堂。\n尚书座上多游客，独有张翰忆故乡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5037,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谢左丞自军中至，同宴周德新员外别业","author":"张昱","text":"坐来清听满风前，顿觉烦襟为洒然。\n马上功名真是梦，杯中岁月莫非仙。\n浮云对岭张图画，鸣鸟藏花杂管弦。\n莫讶周郎宾客盛，雄资英发正当年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5038,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"两山亭留题","author":"张昱","text":"马头曾为使君回，北望新亭道路开。\n于越地形缘海尽，勾吴山色过江来。\n英雄有恨馀湖水，天地忘怀入酒杯。\n珍重谢家林下客，玉山何待倩人推？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5039,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"三月三日，湖上作二首 其一","author":"张昱","text":"此日谁人肯在家，倾城满意事繁华。\n时非上巳不为节，春到牡丹才是花。\n雾鬓风鬟湖上女，画轮绣毂道傍车。\n儿童尽唱铜鞮曲，未觉人间日易斜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5040,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"三月三日，湖上作二首 其二","author":"张昱","text":"此日西湖似曲江，湔裙流水碧淙淙。\n谁家妇女不红粉，是处水亭皆绿窗。\n白发看花春可数，画船扶醉玉成双。\n邦人何哂狂居士，老至关情尚未降。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5041,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"汴河怀古","author":"张昱","text":"家国承平厌万机，轻乘黄屋出京畿。\n三年巡狩前王有，千里看花亘古稀。\n河畔柳条春自长，苑中萤火夜还飞。\n当时九庙躬辞日，肯信龙舟更不归？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5042,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"涵虚阁","author":"张昱","text":"灵岩寺是馆娃宫，霸国风流梦已空。\n楚客智穷三谏后，越师戍合五湖中。\n佳人已化朝云白，高阁犹涵夕照红。\n谁料后千年过此，却凭阑槛数飞鸿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5043,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丛玉轩","author":"张昱","text":"河东使君竹成癖，落墨满林烟雨新。\n雪壁自期留后日，碧纱谁与护轻尘？\n百年聚散同残梦，一代风流不数人。\n赖是主僧知敬客，不辞骑马到来频。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5044,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游天台山回，别省院诸公","author":"张昱","text":"明时无日不从容，三月清游在醉中。\n晚岫远当云际碧，野花争近马前红。\n虽非奉使河源上，犹及题诗浙水东。\n甚觉淹留烦从者，腼颜何以答诸公？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5045,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]