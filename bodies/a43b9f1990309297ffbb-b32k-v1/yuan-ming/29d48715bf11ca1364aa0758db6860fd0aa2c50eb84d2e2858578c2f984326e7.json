[{"title":"感怀","author":"王冕","text":"客邸可言行路难，故园无便寄平安。\n梦回孤馆灯火寂，吟到五更风雨寒。\n南国山川频入梦，中原戎马独凭阑。\n田文一去豪华尽，长铗归来何所弹？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":520,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感怀","author":"王冕","text":"风花片片减芳春，转首关河气象新。\n有志谁能口避老，无忧何必去除贫。\n开楼且喜青山近，钓水多从白鸟亲。\n闻说长安金紫贵，不奔风雨即红尘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":521,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感慨四首 其一","author":"王冕","text":"大道已沦谢，世情那可论？\n所经新传舍，多是故侯门。\n路险豺狼恣，山空鸟雀喧。\n余生亦何幸，注目合忘言。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":522,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感慨四首 其二","author":"王冕","text":"东南多胜概，古迹渐难寻。\n诸老题诗处，繁阴蔽石林。\n云团溪雨重，水落野塘深。\n感慨添余思，孤猿入暮吟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":523,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感慨四首 其三","author":"王冕","text":"故国江都郡，繁华旧不同。\n衣冠移习气，鼓角动悲风。\n柳倚消光碧，花连野色红。\n放怀沽一碎，世事委狙翁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":524,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感慨四首 其四","author":"王冕","text":"昨访三生石，今登二老亭。\n痴烟含树黑，野草满山青。\n归鸟还知倦，悲笳不忍听。\n又闻龙臆马，趁逐豹文鼮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":525,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"新店道上","author":"王冕","text":"野水滔天去，阴云著地生。\n沽来新店酒，不洗异乡情。\n白发萧萧谢，黄花粲粲明。\n山川虽跋涉，道路却升平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":526,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"新店道中二首 其一","author":"王冕","text":"黄桑叶落雁声号，野鼠蹲沙北马骄。\n万里山河秋渺渺，一天风雨夜萧萧。\n客怀到此何由壮？\n酒兴于人自觉饶。\n早起梳头对明镜，不愁双鬓雪飘飘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":527,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"新店道中二首 其二","author":"王冕","text":"即看白雁向南飞，又见黄花落短篱。\n河道便风容易上，客程过匣信难期。\n新霜飒飒吹杨柳，野老离离和竹枝。\n欲饮一樽难强进，且留清兴漫题诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":528,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"楚汉两城","author":"王冕","text":"楚汉英雄今寂寞，两城相倚旧封疆。\n荒台落日酣红叶，古墓秋风老白杨。\n岂是有为增感慨？\n便令无事亦凄凉。\n徘徊望尽东南地，芦苇萧萧野水黄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":529,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"楼观","author":"王冕","text":"楼观重重锦绣扶，东湖风景即蓬壶。\n海云入树青山小，野水滔天白鸟孤。\n学士借来船似屋，书生归去画成图。\n老夫一见何潇洒，凉雨满堤生绿蒲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":530,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"满目青山轩","author":"王冕","text":"满目青山似画图，道人于此即安居。\n不知世上功名好，但觉门前车马疏。\n风月四时同笑傲，乾坤千古一蘧庐。\n我生亦有林泉癖，欲老衡茅愧不如。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":531,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"福胜山房","author":"王冕","text":"不作殊方去，每因兹地留。\n湖山全胜概，松竹秘清幽。\n下榻同听雨，开尊为解愁。\n得君多道义，从此无可求。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":532,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"解闷","author":"王冕","text":"家园嗟寂寞，客计转疏迂。\n事失非关酒，身贫不为儒。\n功名馀破楮，风雨漫长途。\n对景成何用，高谈却壮图。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":533,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"解闷四首 其二","author":"王冕","text":"荒城惊岁晚，风雨奈何人？\n野火殊无侣，江梅自得春。\n停杯吟思远，照镜鬓华新。\n底事堪愁绝？\n悲笳撼塞尘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":534,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"解闷四首 其三","author":"王冕","text":"风雨交残夜，郊关鸡乱鸣。\n青山频入梦，白发不禁情。\n舞剑令人笑，沽樽只自倾。\n忽思少年日，骑马汉江城。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":535,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"解闷四首 其四","author":"王冕","text":"寒气薄衣絮，斜风雪乱飘。\n山林俄失色，江海不行潮。\n塞北毡车重，江南甲骑骄。\n草堂亦幽致，冰冻满诗瓢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":536,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"遣兴四首 其一","author":"王冕","text":"破屋悬寒雨，空窗度晓云。\n家贫无外虑，身老厌多闻。\n草木随时长，虫鱼自作群。\n行吟聊遣兴，不必论功勋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":537,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"遣兴四首 其二","author":"王冕","text":"直北黄河走，江南白浪浮。\n人民正饥渴，官府急诛求。\n处处催兵器，城城建火楼。\n老吾头已白，忍死为君忧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":538,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"遣兴四首 其三","author":"王冕","text":"老来百病出，坐卧不能安。\n稍得春风暖，寻忧夜雨寒。\n中原人倥偬，南国步艰难。\n薇省分权重，匡时自选官。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":539,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"遣兴四首 其四","author":"王冕","text":"旌旗明紫塞，云雾暗潼关。\n尽说王师盛，应知伯道艰。\n东风吹白草，落日动青山。\n羽檄飞边报，将军信雅閒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":540,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"暝色","author":"王冕","text":"暝色沉孤屿，秋声入远林。\n飞鸿频顾影，独客易伤心。\n相识无知己，交游少信音。\n未能酬壮志，沽酒且长吟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":541,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴三首 其一","author":"王冕","text":"隐几看山与世违，当门种竹亦无机。\n五更骤雨随风过，满眼落花如雪飞。\n每为注书消夜烛，亦常沽酒典春衣。\n今朝急报任公子，昨日苍苔满钓矶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":542,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴十九首 其一","author":"王冕","text":"诏布河流复，其功说贾生。\n岂因疏凿费？\n恰重战争名。\n军士虽然散，农人尚未耕。\n九州多禹迹，何日与君评？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":543,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴四首 其一","author":"王冕","text":"流沙连竺国，大碛间和宁。\n云合阴山黑，天垂瀚海青。\n穹庐骈騕袅，葩盖建和铃。\n多少花门子，相逢过北庭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":544,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴十九首 其二","author":"王冕","text":"燕赵官输急，江淮羽檄忙。\n山崩云惨惨，河决水茫茫。\n野客愁无奈，山翁老更狂。\n途传军士盛，即日下襄阳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":545,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴四首 其二","author":"王冕","text":"屯聚皆羌属，苍茫路转西。\n草深车迹浅，霜重角声低。\n军马行无数，山林望欲迷。\n老兵通汉语，指点话征西。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":546,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴三首 其二","author":"王冕","text":"中天积翠郁层阴，雪瀑遥飞落远岑。\n白月夜分双鹤舞，清风时听万松吟。\n放怀尽可从诗酒，行乐何须论古今。\n我欲与君飞两舄，题诗刻竹满山林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":547,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴四首 其三","author":"王冕","text":"天时今亦异，地丑古来非。\n永夜惟消酒，严寒未授衣。\n一时风色变，万里雪花飞。\n小大持弓矢，相呼出打围。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":548,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴十九首 其三","author":"王冕","text":"草木何摇撼，工商已破家。\n饶州沈白器，勾漏伏丹砂。\n吴下难移粟，江西不运茶。\n朝廷政宽大，应笑井中蛙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":549,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴三首 其三","author":"王冕","text":"风花片片落瑶台，江北江南春未回。\n老子胸中自潇洒，故乡何处却徘徊。\n海云挟雨连天黑，江鹳如人近屋来。\n景物相看只如此，沽杯且放好怀开。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":550,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴三首 其三","author":"王冕","text":"青山隐隐带滦河，金碧光中望馺娑。\n五谷不生羊马盛，二仪殊候雪霜多。\n打围阵合穹庐转，警跸声传御驾过。\n漠漠黄沙天万里，壮心未解说风波。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":551,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴四首 其四","author":"王冕","text":"壮心殊未已，望望尽黄沙。\n韦帽笼鸦鹘，毡囊载骆驼。\n过关南客少，出塞北风多。\n田牧俱荒废，空怀马伏波。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":552,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴十九首 其四","author":"王冕","text":"四川听雨化，三辅受风清。\n但得公行道，何劳苦用兵？\n关山无阻碍，淮甸渐清平。\n闻说招民义，衔哀事远征。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":553,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴十九首 其五","author":"王冕","text":"一说妖氛起，生民欲断魂。\n村墟空壁落，市井变营屯。\n尽道无生计，谁为奉至尊？\n吾居更萧索，事业不须论。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":554,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴十九首 其六","author":"王冕","text":"壬辰天意别，春夏雨冥冥。\n云气何时敛，江声未得停。\n书生怜白发，壮士喜青萍。\n昨夜登西阁，悲笳不忍听。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":555,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴十九首 其七","author":"王冕","text":"处处言离乱，纷纷觅隐居。\n山林增气象，城郭转空虚。\n侠客思骑虎，溪翁只钓鱼。\n诸生已星散，那得论诗书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":556,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴十九首 其八","author":"王冕","text":"辟难人争出，居家我独痴。\n况兼亲已老，无奈病相欺。\n湖海迷舟楫，关山振鼓鼙。\n忘机閒看竹，得兴漫题诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":557,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴十九首 其九","author":"王冕","text":"密树连云湿，荒村入径斜。\n山童分紫笋，野老卖黄瓜。\n忽要千钧弩，寻求百姓家。\n予生为计拙，见景重咨嗟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":558,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴十九首 其十","author":"王冕","text":"撤幕愁归燕，颓垣警睡尨。\n鱼声飞玉署，花梦破璚窗。\n紫诏传三省，黄巾出两江。\n何时舞干羽？\n尽使有苗降。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":559,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴十九首 其十一","author":"王冕","text":"登高聊纵目，怀古忽伤心。\n北极星辰远，中原草木深。\n天寒群雁叫，夜静独猿吟。\n处处知音少，尘埃绿绮琴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":560,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴十九首 其十二","author":"王冕","text":"干戈犹未定，鼙鼓岂堪闻。\n忧国心如醉，还家梦似云。\n关山千里远，吴楚一江分。\n朋旧俱零落，空嗟白鸟群。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":561,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴十九首 其十三","author":"王冕","text":"湿云垂地重，孤雁入天鸣。\n到处干戈竞，何时海岱清。\n孤灯悬古壁，寒漏落空城。\n可羡商山老，优游待太平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":562,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴十九首 其十四","author":"王冕","text":"深秋天气好，且喜病魔消。\n对客论三史，令人愧六朝。\n山河空板荡，民物竞萧条。\n白首思无策，甘心学野樵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":563,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴十九首 其十五","author":"王冕","text":"秋风清瘴疠，明月照山河。\n绝国干戈少，空城鼓角多。\n脱巾怜短发，醉酒觉身和。\n漫对黄花坐，无劳白苧歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":564,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴十九首 其十六","author":"王冕","text":"自笑青云远，谁怜白发孤？\n艰难知道路，潇洒问江湖。\n事业留诗卷，田园入画图。\n清高过老杜，囊底一钱无。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":565,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴十九首 其十七","author":"王冕","text":"重阳今日是，风雨满空城。\n白发殊无赖，黄花似有情。\n山寒孤树老，江净众鸥明。\n且愿烽尘息，讴歌乐太平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":566,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴十九首 其十八","author":"王冕","text":"雨阻龙山会，云荒戏马台。\n且看黄菊放，休待白衣来。\n事业书千卷，功名水一杯。\n登临聊复尔，吟啸漫徘徊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":567,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴十九首 其十九","author":"王冕","text":"吟诗怀杜甫，持酒看吴钩。\n落叶千林晓，飞鸿万里秋。\n只嫌风俗变，不为别离愁。\n向晚闻征鼓，徘徊倚小楼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":568,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"潇洒","author":"王冕","text":"渐觉离乡远，宁知出处迂。\n风流看队马，潇洒入双鱼。\n谁解辞千乘，无人说二疏。\n老吾情不惬，漫读古人书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":569,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"槿花","author":"王冕","text":"不与百花期，多从桂子时。\n低昂如有序，红白自相宜。\n农为编篱识，蜂因课蜜知。\n想渠根本盛，未畏雪霜欺。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":570,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"醉贤图","author":"王冕","text":"浩饮浪吟何慷慨，衣冠尚在晋风流。\n七贤林下固不异，六逸溪头良可谋。\n既是甘为避世士，不妨且作醉乡侯。\n幕天席地无留滞，笑杀三闾空白头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":571,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题王有恒山房","author":"王冕","text":"人世红尘涨碧空，薜窗萝几自清风。\n朝来爽气归书润，夜静青云入梦浓。\n壁上枯桐忘岁月，床头老剑识英雄。\n丈夫要看好山色，不是关中即洛中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":572,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题米元晖画","author":"王冕","text":"我生正坐山水癖，展卷见山如蜜甜。\n古树含烟黑个个，远山落日见尖尖。\n险绝岂惟游子虑，清幽足慰老夫潜。\n行路望云情更切，不因小米故多添。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":573,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题金陵","author":"王冕","text":"赏心亭前春草花，赏心亭下柳生芽。\n收功漫说韩擒虎，亡国岂由张丽华。\n江山万古足登览，豪杰几人过叹嗟。\n野老相逢閒指点，六朝宫阙尽桑麻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":574,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题青田山房","author":"王冕","text":"青田刘处士，潇洒好山房。\n夜月移花磴，春云动石床。\n书声通远谷，琴响应清商。\n我欲相依住，临流筑草堂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":575,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题赵松雪关北小景图","author":"王冕","text":"小草丛丛出浅沙，坐歌无奈画图何。\n长藤挂树春风少，老石敛云秋色多。\n客子淡然忘岁月，王孙徒尔忆山河。\n荒烟落日居庸道，几见毡车白马驮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":576,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"龌龊","author":"王冕","text":"龌龊宁堪处，卑污奈此逢。\n看人骑白马，唤狗作乌龙。\n濯濯河边柳，青青涧底松。\n待看天气好，应得露华浓。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":577,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"卫生画山水","author":"王冕","text":"国朝画手不可数，神妙独数高尚书。\n尚书意匠悟三昧，笔力固与常人殊。\n林树无根云懵懵，昆崙泰华云中涌。\n山城野店不逢人，碧波翠嶂淋漓动。\n于今绝响三十年，尚书笔法谁能传？\n片藤尺青不易得，使我感慨心茫然。\n吴兴老赵蓟丘李，两地清风俱委靡。\n古人丹青亦消毁，后学纷纷无乃是。\n卫生卓荦志有馀，妙龄声誉驰江湖。\n泛观今昔意未足，直与造化论锱铢。\n呜呼，安得有绢请君画竹冠，置我长松下，坐看青山白云过。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":578,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"大醉歌","author":"王冕","text":"明月珠，不可襦。\n连城璧，不可餔。\n世间所有皆虚无，百年光景驹过隙，功名富贵将焉如？\n君不见北邙山，石羊石虎排无数。\n旧时多有帝王坟，今日累累蛰狐兔，残碑断碣为行路。\n又不见秦汉都，百二山河能险固。\n旧时宫阙亘云霄，今日原田但禾黍。\n古恨新愁迷草树，不如且买葡萄醅。\n携壶挈榼閒往来，日日大醉春风台，何用感慨生悲哀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":579,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中","author":"王冕","text":"雨过百溜鸣，云消众山出。\n鸟啼松径深，来往无车辙。\n幽居少人事，足以养吾拙。\n读书故无用，徒然较优劣。\n辟世岂云迂？\n自与桃源别。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":580,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中作寄城中诸友","author":"王冕","text":"山深无行踪，蹊路土华长。\n白云忽飞来，令人起遐想。\n松间微风奏，石罅幽泉响。\n坐久怀抱空，悠然会清赏。\n在山虽无荣，出山有何好？\n清流混潢污，远志成小草。\n松柏本贞固，蒲柳易枯槁。\n扰扰路旁儿，知止不如鸟。\n白云开林峦，黑雾漫城郭。\n出门道路违，蠢蠢都不觉。\n游蚁上枯槎，归鸟隐丛薄。\n寄语远行人，莫待风雨恶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":581,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪麓渔舟图","author":"王冕","text":"大山小山无寸青，长江万里如月明。\n楚天不尽鸟飞绝，老树欲动风无声。\n何人方舟顺流下，草衣箬笠俱潇洒。\n篷底有儿能读书，不是寻常钓鱼者。\n玄真子，陶朱翁，避世逃名俱已矣，后来空自谈高风。\n我视功名等尘垢，何似忘言付杯酒。\n武陵岂必皆神仙，桃花流水人间有。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":582,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]