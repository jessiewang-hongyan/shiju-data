[{"title":"望夫石","author":"郭翼","text":"亭亭望夫石，化石石作心。\n丈夫无死节，妇人那可轻。\n山花满头云作衣，日日望夫夫不归。\n夫不归，泪如水，至今水流流不止。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7335,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"系子词","author":"郭翼","text":"邓家儿，邓家儿，长绳谁系高树枝。\n父母各逃生，儿死亦孔悲。\n弟亡一息不可弃，儿虽当弃忍系之。\n邓家儿，哭奚为。\n天乎天乎岂无知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7336,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵寄野航","author":"郭翼","text":"十日不见华州掾，定是清迂在个边。\n青壁缘云题石阁，白沙留月系湖船。\n娟娟酒落杯香细，闇闇梅堆雪色鲜。\n归来且乐岁年暮，何问他侬识《太玄》。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7337,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宴吕敬夫水阁","author":"郭翼","text":"暮春三月之佳日，画里看花小阁杯。\n一双皓鹤巡池走，百叶绯桃映绶开。\n卷幔不知云乱入，题诗应怪雨相催。\n武陵何处能忘世，莫遣閒人取次来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7338,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题野航壁","author":"郭翼","text":"大树小树屋东西，瘿颈鹁鸪来上啼。\n明朝艓子坐天上，野水压江江日低。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7339,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和李长吉马诗十二首 其一","author":"郭翼","text":"騄骥连钱动，金鞍镂玉羁。\n无人寻穆满，借与阆风骑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7340,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和李长吉马诗十二首 其二","author":"郭翼","text":"肉礧锦缠综，流云汗似红。\n太平无战伐，骖驔走沙蓬。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7341,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和李长吉马诗十二首 其三","author":"郭翼","text":"龙性非凡质，腾波出紫云。\n檀溪飞过日，应识汉将军。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7342,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和李长吉马诗十二首 其四","author":"郭翼","text":"龙印留官字，霜花剥暗毛。\n长鸣愁过影，祇忆九方皋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7343,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和李长吉马诗十二首 其五","author":"郭翼","text":"霞口缕衢寒，霜蹄削玉寒。\n晓看经逻些，暮已蓦楼兰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7344,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和李长吉马诗十二首 其六","author":"郭翼","text":"瘦骨如山立，临流饮渴虹。\n谁怜中道弃，苜蓿老秋风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7345,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和李长吉马诗十二首 其十二","author":"郭翼","text":"骥子大宛种，房星夜降精。\n汉家求不得，兵压贰师城。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7346,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂诗三首 其一","author":"郭翼","text":"靡靡轻薄子，沓沓肩相摩。\n营营樊中蝇，扑扑火上蛾。\n趋利不顾生，是非搆谗邪。\n所得不既少，所丧良已多。\n凄风遍大野，不久当如何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7347,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂诗三首 其二","author":"郭翼","text":"滔滔夏孟月，桃李春已矣。\n庭前两支子，其叶互相倚。\n梧桐一高盖，碧气荫清美。\n昽昽屋东日，连阴密如齿。\n当昼无穿影，西枝覆流水。\n铺床终日坐，儿女且驩喜。\n有酒辄持饮，聊乐我云耳。\n贵者日以骄，富者日以侈。\n古人已云亡，谁下白屋士。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7348,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂诗三首 其三","author":"郭翼","text":"京畿连大宅，新赐公侯第。\n桂树夹道生，台观迎风起。\n歌麟玉阶侧，栖凤金窗里。\n秦娃当妙选，赵舞飘轻体。\n大儿尚书郎，小儿参国议。\n中儿权最隆，出入侍天子。\n七叶轻汉貂，八达哂周士。\n冯唐亦何命，白首贱如此。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7349,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"玉山佳处","author":"郭翼","text":"爱汝西庄给事家，绕屋山石何谽谺。\n截江秀色发林壑，平地玉气贯虹霞。\n佳处如居子午谷，望中开遍冬春华。\n夜深酒醒月在海，应有仙人来系槎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7350,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"采莲曲","author":"丁鹤年","text":"采莲复采莲，仍唱《采莲曲》。\n若欲知苦心，须食莲中肉。\n采莲复采莲，踟蹰一何久。\n不愁花妒容，惟恐刺伤手。\n采莲复采莲，藕亦不可弃。\n中有不断丝，似妾缠绵意。\n采莲复采莲，争如采荷好。\n花谢叶独存，团圆以终老。\n采莲复采莲，湖水清且深。\n徒能照妾面，不能照妾心。\n采莲复采莲，下有孤鸳鸯。\n秋花不结实，夜夜守空房。\n莲开花覆水，莲谢藕在泥。\n不学青萍叶，随波东复西。\n朝采并蒂莲，暮绾同心结。\n不学杨柳枝，含嚬送离别。\n莲舟何处来，同住西湖口。\n郎怜波上花，妾爱泥中藕。\n藕有青白节，花有艳冶容。\n郎心异妾心，三叹掩归篷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7351,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"画古木幽篁","author":"丁鹤年","text":"碧海珊瑚树，清湘翡翠毛。\n无因将寄远，日暮寸心劳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7352,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"画葡萄","author":"丁鹤年","text":"江海春雷动，群龙悉上天。\n秋来风露冷，个个抱珠眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7353,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题江亭柳色图","author":"丁鹤年","text":"昔年酾酒地，江汉一茅亭。\n同会人何在？\n东风柳又青。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7354,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次先兄太守题竹韵","author":"丁鹤年","text":"玉笋谢朝班，西风海国寒。\n无人知苦节，落日下长安。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7355,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题赤壁图","author":"丁鹤年","text":"横槊英声远，闻箫逸兴长。\n至今风月夜，鹤梦绕黄冈。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7356,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题谢安观山图","author":"丁鹤年","text":"欲为苍生起，神州未可还。\n筹思保江表，安若会稽山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7357,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题长溪独钓图","author":"丁鹤年","text":"溪上钓西风，心随溪水东。\n后车今已载，何待兆非熊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7358,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题郑高士画竹","author":"丁鹤年","text":"郑君高节士，潇洒绝人群。\n独把青鸾尾，山窗扫白云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7359,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画梅竹","author":"丁鹤年","text":"姑射下天坛，天空鬓影寒。\n雪深归路迥，独自跨青鸾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7360,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"画梅","author":"丁鹤年","text":"老向江南住，梅花共岁寒。\n故人清兴在，踏雪几回看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7361,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"画兰","author":"丁鹤年","text":"湘皋风日美，芳草不胜春。\n欲采纫为佩，惭非楚荩臣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7362,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"画菜","author":"丁鹤年","text":"蔬畦新雨过，小摘称君贫。\n若入君王梦，琼林第一人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7363,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"画竹","author":"丁鹤年","text":"拂素写晴窗，亭亭玉一双。\n苍龙雷唤醒，风雨遍湘江。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7364,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"画萝卜","author":"丁鹤年","text":"高氏贤兄弟，常将备夕餐。\n如何清列士，今作画图看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7365,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"画菘菜","author":"丁鹤年","text":"老圃青青甲，平生味饱谙。\n本无食肉相，岂是厌肥甘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7366,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"枯木竹石","author":"丁鹤年","text":"青天腾一蛟，白日卧双虎。\n何人歌竹枝，遥隔潇湘浦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7367,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"小画 其一","author":"丁鹤年","text":"远水吞天碧，危峰拔地青。\n何由云树底，挥麈坐茅亭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7368,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"小画 其二","author":"丁鹤年","text":"翠黛浮晴汉，虬枝立暝烟。\n回舟不用楫，江上水吞天。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7369,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"静乐轩","author":"丁鹤年","text":"清心如止水，一月印当中。\n谁道芭蕉雨，潇潇解恼公。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7370,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"临水梅","author":"丁鹤年","text":"疏花清有影，止水净无埃。\n好似菩提树，明明照镜台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7371,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"横窗梅","author":"丁鹤年","text":"禅窗夜虚明，照见臞仙影。\n上人对空花，悠然发深省。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7372,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"画竹","author":"丁鹤年","text":"夜诵蕊珠经，群真悉下听。\n仙坛晨自扫，拾得凤凰翎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7373,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"画梅 其一","author":"丁鹤年","text":"松筠淹雨雪，桃李逐风尘。\n不有梅花树，谁回天地春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7374,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"画梅 其二","author":"丁鹤年","text":"铁石挺孤标，冰霜抱贞素。\n一笑桃李空，嗟哉岁云暮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7375,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"咏蝉","author":"丁鹤年","text":"蝉性极清高，愁吟类楚骚。\n炎天风露薄，度日亦嗷嗷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7376,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"逃禅室卧病简诸禅侣","author":"丁鹤年","text":"高秋多病客，古寺寄黄昏。\n野迥常疑虎，天寒早闭门。\n离愁灯下影，乡泪枕边痕。\n赖有诸禅侣，情亲似弟昆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7377,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次乌继善先生见寄韵","author":"丁鹤年","text":"扶杖日行吟，悠然太古心。\n风云遗壮气，山水效清音。\n大雅消沉久，斯文感慨深。\n幸瞻乔梓在，奕叶尽成阴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7378,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽柴吏目","author":"丁鹤年","text":"奕世莲花幕，人称汉吏师。\n都缘参赞重，颇觉转迁迟。\n雅论非三语，清声是四知。\n犹馀前案牍，长作后箴规。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7379,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽章处士","author":"丁鹤年","text":"流年惊逝水，世事逐飘风。\n卜筑邻蓬岛，移家类葛洪。\n丹还金鼎伏，剑解玉棺空。\n惟有松坛月，通宵贯彩虹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7380,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽修竹处士","author":"丁鹤年","text":"种竹人何在，乡邻久未忘。\n冰霜馀节操，云锦见文章。\n散帙依朝爽，移樽坐夕凉。\n儿孙皆玉立，尤足继遗芳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7381,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄乡亲济阳公","author":"丁鹤年","text":"身远乡情重，途穷客病深。\n参苓频在眼，桑梓最关心。\n居简便夷俗，含凄效越吟。\n自从遭丧乱，辛苦到如今。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7382,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登北固山多景楼","author":"丁鹤年","text":"风月无边地，乾坤有此楼。\n城随山北固，潮蹴海西流。\n眼界宽三岛，胸襟隘九州。\n阶前遗狠石，谁复话安刘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7383,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽期","author":"丁鹤年","text":"何处赴幽期，青林白谷陲。\n谷虚秋气早，林茂曙光迟。\n谈罢风生麈，歌阑月在卮。\n谋身良自足，何补国安危。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7384,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次友人张孟善承赠以诗韵","author":"丁鹤年","text":"去去成长往，悠悠事远游。\n蹑云双短屐，载月一虚舟。\n江海鱼龙夜，山林鹤鹤秋。\n诵君佳丽句，慰我别离忧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7385,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寓慈湖僧舍次龙子高提举韵","author":"丁鹤年","text":"迢递过兰若，淹留为竹林。\n疏钟云峤迥，孤烛雨窗深。\n长啸非怀昔，狂歌岂避今。\n祇缘诸漏尽，不受一尘侵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7386,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"慈溪度夏报国寺寄甬东椿上人","author":"丁鹤年","text":"一径野云深，僧关閟绿阴。\n雨腥龙出涧，风劲虎过林。\n澹泊资禅味，清凉养道心。\n三生如不昧，石上一来寻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7387,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"涵清轩","author":"丁鹤年","text":"止水才盈掬，涵空有底宽。\n玉壶秋影净，金镜晓来寒。\n落月斜沈白，流霞浅浴丹。\n上人方宴坐，应向观中看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7388,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠李仙姑","author":"丁鹤年","text":"何年萼绿华，来降地仙家。\n花拥青鸾节，香随白鹿车。\n清辉回雪月，玄想结云霞。\n不赴瑶池宴，桃开几度花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7389,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠济古舟","author":"丁鹤年","text":"久留句践国，同寓给孤园。\n聊发溪头笑，何殊石上魂。\n卧云秋对榻，敲月夜过门。\n愿奉三乘法，常依两足尊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7390,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送二僧往浣花草堂度夏","author":"丁鹤年","text":"吟遍赤城霞，行行入浣花。\n为人无芥蒂，留客有瓜茶。\n寂寂先贤宅，堂堂古佛家。\n老怀因二妙，亦欲制袈裟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7391,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题宋贡士袁庸死节传后","author":"丁鹤年","text":"始获乡闱荐，俄惊国阼倾。\n丹心回日驭，赤手抗天兵。\n自可敦衰薄，何烦较死生。\n文山嘉传在，端合附高名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7392,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送定海许县丞","author":"丁鹤年","text":"蛟门佐邑满，南去候庭闱。\n雨露随花绶，云霞避綵衣。\n贤声今已著，色养旧无违。\n万里沧溟月，清秋作伴归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7393,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送鄞县鲍秀才","author":"丁鹤年","text":"贫病吾何有，深惭鲍叔知。\n可堪迟暮日，翻值别离时。\n霜月栖乌府，风云浴凤池。\n壮游如得意，音问莫教迟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7394,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题湖山独步图","author":"丁鹤年","text":"杖屦湖山外，悠然与世违。\n水边延月上，岩际待云归。\n随鹿过樵径，看鸥到钓矶。\n只今瞻画像，犹想挹清辉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7395,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"慈溪归隐","author":"丁鹤年","text":"旧隐慈溪上，归休足自怡。\n水翻琴上曲，山送画中诗。\n丛菊秋容淡，孤松昼景迟。\n依然对猿鹤，无愧北山移。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7396,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题四明倪仲权处士像","author":"丁鹤年","text":"松间新雨过，清览出亭皋。\n云逐青骢马，风生白苧袍。\n幽怀随地远，诗兴与秋高。\n囊锦归时重，应知从者劳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7397,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题介石斋","author":"丁鹤年","text":"介石存中正，能为逸豫防。\n砺金缘最劲，攻玉岂徒刚。\n贞德南山配，神机北斗当。\n补天应有待，五色烂文章。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7398,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题筠轩","author":"丁鹤年","text":"种竹绕前楹，年深劲节成。\n薄云通雨气，清夜动秋声。\n鱼豕空遗简，鸾凰合度笙。\n往来三径熟，不负岁寒盟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7399,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"渔村书隐","author":"丁鹤年","text":"彼美藏修者，为渔住海乡。\n傍沙观鸟迹，临水映萤光。\n舟楫须经济，丝纶拟对扬。\n得鱼供色养，綵服日升堂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7400,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"静乐斋","author":"丁鹤年","text":"寂寂幽栖地，无营足自怡。\n清泉流道脉，白月净诗脾。\n每到忘机处，翻为得意时。\n豁然成猛省，太极是吾师。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7401,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"勉济国诸郎","author":"丁鹤年","text":"济国诸公子，风标各擅场。\n青阳生玉气，白月隐珠光。\n阀阅家声重，诗书世泽长。\n直须同素志，早为继遗芳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7402,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽四明乐仲本先生 其一","author":"丁鹤年","text":"斯人嗟已矣，吾道转消沈。\n文物昭前古，功名困至今。\n空山方泣玉，同舍忽诬金。\n白首号天处，飞霜六月深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7403,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽四明乐仲本先生 其二","author":"丁鹤年","text":"昔访幽栖地，论文十日还。\n图书花竹里，窗户水云间。\n一别成千载，孤魂隔万山。\n裹鸡吾老矣，东望涕长潸。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7404,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]