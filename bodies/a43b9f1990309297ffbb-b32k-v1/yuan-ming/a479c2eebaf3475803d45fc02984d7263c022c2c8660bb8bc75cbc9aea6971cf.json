[{"title":"赠汪仲鲁","author":"赵汸","text":"短语长言总勿疑，相交动是隔年期。\n坐来竹雨初晴定，看到松云欲尽时。\n雪后孤芳谁复惜，空中灵响妙难思。\n山花满眼春将半，莫厌从容步履迟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7011,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"阆峰秋兴","author":"赵汸","text":"岭峭崖倾径往还，药囊书卷一窗间。\n神鸦喜日朝争树，山鬼依人夜撼阛。\n露重无霜林果熟，云凝不雨洞雷閒。\n莫嫌岩穴多殊异，天遣沈疴此闭关。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7012,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"除夕","author":"赵汸","text":"守岁虽名岁不留，停杯谩与数更筹。\n艰危作客岂今夕，隐约依人非昔游。\n乱后亲交难会合，春来书札莫沈浮。\n开怀预卜风光好，随处莺花得自由。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7013,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"省古逸汪先生墓","author":"赵汸","text":"百年高兴太平时，丧乱空馀死后悲。\n烟草已墟颜氏巷，云山犹写杜陵诗。\n饮冰食蘖老逾壮，锻铁椎金幼已奇。\n赖有诸孙营葬地，清风谁镌首阳碑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7014,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"病中谢伴友","author":"赵汸","text":"畏客山僧忽若惊，松门下马雨初晴。\n谩求衰病端何用，谁使迂疏浪得名。\n慷慨请行知雅意，从容排难见真情。\n风波况是同舟日，伐木宁教愧此生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7015,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谢王伯睿郡丞","author":"赵汸","text":"悠悠伏枕忽心惊，好是灵乌报晚晴。\n谢客奉书来隐逸，令人致死薄虚名。\n已知苦节能行义，敢惜浮华不及情。\n邂逅识君能恨晚，输君临难若平生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7016,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送程明远归","author":"赵汸","text":"一百五日客欲归，别君谁怜吾事非。\n泪随流水依山去，眼散落花作雪飞。\n溪谷春深惟草树，郊原日暖自烟霏。\n松楸在望身匏繫，青壁无缘一径微。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7017,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"节日卧病和元忠 其一","author":"赵汸","text":"一百五日谁与期，凄风苦雨不愆时。\n桃花乱飞流水急，鶗鴂忽鸣芳草萋。\n春尽可堪寒作恶，愁来偏与病相宜。\n已将梦幻观人世，莫向亲交怨别离。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7018,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"节日卧病和元忠 其二","author":"赵汸","text":"一百六日谁与游，残花满地意如秋。\n病意愔愔慵把卷，春寒漠漠怯登楼。\n鹃声似挟生前恨，蝶舞曾忘梦里愁。\n怪得羽人超世外，海中原有凤麟洲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7019,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋怀","author":"赵汸","text":"莫怪人呼作病翁，长年药裹愧无功。\n梦回左角鸿沟外，秋入南柯石火中。\n阳九适逢当日厄，大千会悟本来空。\n跰?凿井宁多事，安得相携一笑同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7020,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"庚子日南至愚得子枫林朱先生允升赐书并诗举资中黄先生书成得子为况且其令郎以寅年寅月夜半生而是子以子年子月日中生偶亦相类次韵谢之","author":"赵汸","text":"藏山竹简头堪白，海上桃生不记年。\n节日祯祥虽偶似，科名宦达总输先。\n成书谩付将来世，有后应观已定天。\n文字尧夫今不愧，敢辞端拜百王前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7021,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄朱先生允升","author":"赵汸","text":"先生诗教世所慕，闻道书成思服膺。\n将军枉驾可相见，庞老入城知不能。\n山林九鼎士轻重，宇宙六经时废兴。\n我欲登门行复止，新愁旧病巧相仍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7022,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"都谏汪公即席用朱先生韵赐诗依前韵和谢之","author":"赵汸","text":"皇华屡重轺车选，能赋况当英妙年。\n霜木晨星交有道，金芝玉树睹争先。\n已观淮海同归德，未必江湖别有天。\n此去山中应可隐，陈编重理获麟前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7023,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"省朱文公官坑祖墓","author":"赵汸","text":"攒簇千峰一嶂开，乾坤间气此胚胎。\n百灵受职环真宅，五纬回光拱夜台。\n鲁国共悲祠庙毁，闽关不见子孙来。\n干戈未息诸生老，独抱遗书咏七哀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7024,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵谢朱伯初惠橘 其一","author":"赵汸","text":"溪上山中两绝尘，惟应黄绮最相亲。\n治生每愧奴无木，行酒空闻脯有麟。\n丹实结容朝得句，锦囊驰赠座生春。\n年年移作朱门供，谩想山林色正匀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7025,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵谢朱伯初惠橘 其二","author":"赵汸","text":"病骨逢秋怯早凉，登高无分伴徜徉。\n忽惊风雨重阳近，自觉山林引兴长。\n嘉果年年劳远赠，新诗字字写幽香。\n何如四老无名姓，千古商山有耿光。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7026,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读宏斋遗藁","author":"赵汸","text":"村馆文场迹已陈，时妆不入白头新。\n梧翁去后情怀落，虚叟归来感慨频。\n故国神游身似客，荒村梦断孰为邻。\n已知消长从来事，安得机谋恐胁人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7027,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠德懋赴乡塾因怀尚文","author":"赵汸","text":"篮舆晓过悠然阁，杨柳依依士塞门。\n此日端居先业在，当时避地几人存。\n扁舟夜雪须乘兴，锦里烟尘正断魂。\n尊酒喜君文会近，莫轻一技好重论。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7028,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"汸始见黄先生问生何岁对曰己未先生曰吾六经补注以己未年刊或曰书已刻矣恨无读者吾应之曰恐读者未生尔岂知子之生年乃吾刊书之岁又获相交岂非偶然乎乃命春秋之学今年二十有七年矣值愚生朝次思敬韵以寓其感云","author":"赵汸","text":"昔闻黄子书成日，正值麟经托始年。\n皇览揆初悲后死，斯文未丧孰先传。\n春秋霜露如将见，歌舞衣裳忍自妍。\n诗句只增生日感，劬劳啄啐两凄然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7029,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次陈先生韵 其一","author":"赵汸","text":"十年寝瘵负遗经，羞见生朝客满庭。\n谩灼膏肓驱二竖，懒从磨蝎问三星。\n病逢竹叶疑无分，老插花枝亦暂馨。\n安得如翁耆且逸，尊前长对舞衣青。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7030,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次陈先生韵 其二","author":"赵汸","text":"学传东阜旧家声，稷下兰陵独老成。\n前辈仪刑观晚节，后生狂狷异中行。\n童颜肯信童心在，鹤发偏宜鹤梦清。\n吾郡斯文应不坠，藤溪溪上月常明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7031,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠程仲本游齐云岩","author":"赵汸","text":"君去齐云莫漫回，好依仙境结灵胎。\n山开宫观疑金阙，云捧香炉出玉台。\n羽化有缘天上去，神游还向世间来。\n臞儒自昔居山泽，坐老尘凡空自哀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7032,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"代赠郑士恒卜居灵山","author":"赵汸","text":"一榻高悬入翠微，故人情重不相违。\n烟霞烂熳新樵径，水石荒凉旧钓矶。\n灵草飘香林有主，金炉分焰座生辉。\n神仙自在人间世，曾约秋清款素扉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7033,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄寿王总制","author":"赵汸","text":"西征千骥筦秋云，父老壶浆昔迓迎。\n闻道山阴空返棹，恒应河内合留君。\n酒倾练带来称寿，碑压花屏待策勋。\n但愿福星长在郡，春生四野乐耕耘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7034,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次陈实卿韵","author":"赵汸","text":"麟出非时祗漫伤，书成世乱孰为祥。\n石盘穿透能辞钝，宝藏尘埋自发光。\n千载有人非晚遇，名山何处可深藏。\n流传未广惭推予，酱瓿谁家正倚墙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7035,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"筑室次陈实卿先生韵","author":"赵汸","text":"烟销甲第是豪奢，苟美蜗居岂尚华。\n扬子苦贫犹有宅，杜陵遭难久无家。\n续将貂尾元非旧，拆补天功岂有涯。\n追远敬宗惭未就，新诗合与广筵誇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7036,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送杨希武参政行省山西","author":"赵汸","text":"嘉谟硕策合居中，出入宣劳属望隆。\n才驾六轺归蓟北，还飞双旆去河东。\n晋侯旧赐提封远，汉相新瞻礼秩崇。\n廊庙待公归补衮，边陲暂遣播皇风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7037,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送汪朝宗参政行省陕西","author":"赵汸","text":"清忠自合侍宸旒，方面频看寄远猷。\n西迈新闻分陕重，东归共识相齐优。\n藩垣势合雄图遂，竹帛功成壮志酬。\n回首蓬莱云海上，金陵千古帝王州。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7038,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送蔡齐贤参政行省福建","author":"赵汸","text":"近臣持节镇闽中，藩府东南控制雄。\n率土已归新版籍，济时还属旧勋庸。\n天开百粤蛮烟晓，地接三山海日红。\n圣主宵衣勤政理，太平思与远人同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7039,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"息交亭","author":"赵汸","text":"久病形骸日觉非，杜门真与故交违。\n已无筋力供迎送，岂有文章更发挥。\n多难钟情宜绝物，残年顾影合知几。\n寄言返棹山阴客，鹏鴳逍遥共一机。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7040,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵戏答留题东山者","author":"赵汸","text":"诗翁扶醉上危巅，得意留题拂短垣。\n嗔喜未忘春梦后，是非犹记劫灰前。\n弓刀几处排坚阵，风月何人共小轩。\n失脚黄尘应有恨，元龙终不羡求田。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7041,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐伯庸以诗谢作读书林记次韵答之","author":"赵汸","text":"廛居原不见纷华，矮屋疏篱只一家。\n雪后松筠初换叶，春深桃李自开花。\n读残青竹无人到，览罢黄庭日已斜。\n此道近来成寂寞，似君端合向人誇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7042,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"邻翁","author":"赵汸","text":"世乱云浮薄，年荒虎迹多。\n邻翁近相戒，日暮少经过。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7043,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"咏蟋蟀","author":"赵汸","text":"赤翅晶荧何处归，秋来清响傍庭闱。\n莫言微物无情意，风虎云龙共一机。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7044,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"陪程仲本借馆杨居士宅雨后登芝山赋","author":"赵汸","text":"道人居处若云浮，枯木偃蹇忘春秋。\n西山雨后见红日，芳草长林自牧牛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7045,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山间杂题","author":"赵汸","text":"外合中函四顾平，大明东出月西生。\n莫言直上难回首，千仞峰头踏地行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7046,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游小溪浙源山中","author":"赵汸","text":"旧游何处觅苔矶，水涸山童事事非。\n忽到小溪深树侧，鸳鸯惊起逐群飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7047,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵鲁斋登高山见寄","author":"赵汸","text":"山上元来更有山，梯云拾级不辞艰。\n五车合着烟霞外，三尺潺流水石间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7048,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读唐人诗","author":"赵汸","text":"悲秋才罢又伤春，洛浦迷魂泽畔身。\n尘事转头都是梦，总将哀怨属何人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7049,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读宋人文","author":"赵汸","text":"六经明晦总关天，白首穷经续断编。\n石介不生王令死，荒郊古冢鬼谈玄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7050,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山居杂题 其一","author":"赵汸","text":"山高结茅不厌低，山下如今路已迷。\n新月夕阳都不管，晚来愁绝数峰西。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7051,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山居杂题 其二","author":"赵汸","text":"高枝密叶一时空，倚杖沉吟落木中。\n乱后山居无纪历，偶来林下见西风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7052,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送金元忠赴程鲁瞻家塾兼寄鲁瞻","author":"赵汸","text":"古阆山高剩蕨薇，与君同隐惜君归。\n桑榆逐煖空匏繫，百里层霄看鹤飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7053,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"刘敬思邀访南屏隐者莫景行同游南山","author":"赵汸","text":"閒思水乐访深幽，清浅还登泛月舟。\n欲与西湖添胜迹，南屏老子最风流。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7054,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题澄心亭","author":"赵汸","text":"亭中客去日西沈，云净天空月影临。\n万籁无声群动息，千山一色静高深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7055,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵答何判簿见寄 其一","author":"赵汸","text":"红光犹在斗牛间，未斸龙泉岂遽还。\n金马玉堂随世换，清风明月几人閒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7056,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵答何判簿见寄 其二","author":"赵汸","text":"少驻沙边载月舟，依依父老话平畴。\n霜清木落山容净，三十六峰浑是秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7057,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"松风慢 代送吴德夫衡阳巡检","author":"赵汸","text":"溪亭春晚共离觞。\n何许是衡阳。\n香罗初剪征衫好，东风里、快马轻装。\n市远擘张閒暇，年丰虎落相羊。\n苍梧云尽暮天长。\n山色似吾乡。\n莺啼绿树飞红雨，三千里、处处耕桑。\n说与年年归雁，重来应念潇湘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7058,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柳梢青","author":"赵汸","text":"回雁峰前。\n?弓下马，春满前川。\n云尽湘潭，深村无警。\n白昼安眠。\n殷勤祖道开筵，应记取、松萝暮烟。\n一曲离歌，柳梢青浅，花萼红嫣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7059,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋词","author":"王逢","text":"香散天街静玉珂，露台风殿夜如何？\n星从河汉淡中落，秋在梧桐疏处多。\n鸾影不曾离宝鉴，蛛丝先已缀金梭。\n君王茧馆询遗事，却拟鸾车共载过。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7060,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题薛兰英、蕙英《苏台竹枝词》 其二","author":"杨维桢","text":"难弟难兄并有名，英英端不让琼琼。\n好将笔底春风句，谱作瑶筝弦上声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7061,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪巢为张子玄道士赋","author":"王翰","text":"团团茅盖一巢轻，雪满千山虚白生。\n象外乾坤还太古，望中楼观尽通明。\n云藏宿鹤浑无迹，水落长松暗有声。\n人在空寒最高处，羽衣瑶佩不胜清。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7062,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"李徵君将还扬州因言沈郎官在吴下赋此以寄","author":"倪瓒","text":"二月桃始花，淮南客还家。\n阶前疏雨落，堂上春衣薄。\n为言沈约在吴中，玉壶青丝酒如空。\n春风相过蕙草绿，芳菲满堂乐未终。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7063,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和吴正传五台怀古韵 其一 姑苏台","author":"金涓","text":"阖闾城畔姑苏台，百花洲上千花开。\n笙歌半空晓未绝，一声落月啼乌来。\n蛾眉颦翠愁如簇，空捧春娇在心曲。\n沧江罗网纵鲸鲵，碧瓦丘墟走麋鹿。\n悽烟惨日潮生处，怨满鸱夷犹不悟。\n甬东东海不可栖，剑光夜冷吴山路。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7064,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和吴正传五台怀古韵 其二 章华台","author":"金涓","text":"楚台云栋连天宇，伯气凭陵横九土。\n方会诸侯求鼎时，天下无周而有楚。\n一朝吴蔡兵合谋，孤舟江路谁从游。\n宫花晓露细腰泣，空山落日饿鬼愁。\n春风过眼秋萧瑟，■人一饭那能得。\n道傍块土栖草烟，夜寒梦落空台前。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7065,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和吴正传五台怀古韵 其三 朝阳台","author":"金涓","text":"楚王昔日游台上，前望巫峰近相向。\n青枫锦石丛古祠，暮雨朝云依叠嶂。\n蔓花古木多春寒，翠帏仙佩非人间。\n神功治水佐禹迹，至今石刻巍如山。\n词臣错写高唐赋，刚道朝云梦中遇。\n千尺黄湍洗不清，水声犹望台前怒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7066,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和吴正传五台怀古韵 其四 黄金台","author":"金涓","text":"昭王有志兴宗社，厚币卑辞礼贤者。\n郭君一语捐千金，国士争趋骈驷马。\n燕台计议皆英豪，齐人蹴踏犹儿曹。\n三军旗帜白日动，半空剑气青云高。\n乐生既去士亦少，回首春风长芳草。\n火牛遂复七十城，恨满台荒天地老。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7067,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和吴正传五台怀古韵 其五 戏马台","author":"金涓","text":"将军逐马关中来，神威掠地风云摧。\n鸿门舞剑成敌国，彭城衣锦空登台。\n驰下汉军何披靡，垓下楚歌相应起。\n山河百二几诸侯，子弟八千无一骑。\n古来天下谁英雄，荒台老树悲秋风。\n符命合归赤帝子，项伯不忠范增死。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7068,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和杨仲齐韵 其一","author":"金涓","text":"光明清绝地，物色藉诗描。\n野鼠拱虚穴，山蜂归早朝。\n闲庭翻芍药，枯木引陵苕。\n鼻观香风入，移时独未消。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7069,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和杨仲齐韵 其二","author":"金涓","text":"云峤无荣辱，林泉得浸淫。\n瀑飞晴雨散，风奏晓龙吟。\n大叶长茎菋，枯枝老树林。\n吾行忽过此，殊喜得幽寻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7070,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和杨仲齐韵 其三","author":"金涓","text":"渴饮空中露，饥餐石上霞。\n夜茶烹玉液，春酒酿松花。\n自谓得仙术，不知老岁华。\n请看梳栉处，斑白照窗纱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7071,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和杨仲斋韵 其四","author":"金涓","text":"溪行欲假履，云坐不须冠。\n树密一天小，楼高六月寒。\n袈裟憎客至，魍魉喜人看。\n惟有松无意，风来即奏弹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7072,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]