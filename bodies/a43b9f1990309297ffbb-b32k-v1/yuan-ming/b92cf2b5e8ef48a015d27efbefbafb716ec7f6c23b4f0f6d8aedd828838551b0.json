[{"title":"经游小来泾简木仲毅","author":"王逢","text":"髯参归隐小郊坰，乱日曾闻险备经。\n风黑浪高罗刹海，月明天度使臣星。\n东都先见逢萌得，广武重游阮籍醒。\n最是故家春草暗，杜鹃啼杀忍同听。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11429,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"梦骑驴","author":"王逢","text":"蹇驴双耳卓东风，前导青衣一小童。\n石涧倒涵岚气白，海霞高贯日轮红。\n桃花芝草经行异，鹤发鸡皮语笑同。\n却待朝天惊梦失，春醒无奈雨帘栊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11430,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重游淀山","author":"王逢","text":"鳌戴小蓬莱，方诸宫影开。\n崖根龙洞辟，山脉虎丘来。\n疏磬重烟水，残碑半雨苔。\n因之怀故国，游雁落清哀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11431,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古宫怨二首 其一","author":"王逢","text":"万年枝上月团团，一色珠衣立露寒。\n独有君王遥认得，扇开双尾簇红鸾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11432,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古宫怨二首 其二","author":"王逢","text":"误报迎銮出禁宫，阶前草是雁来红。\n玉颜岂就秋枯落，万一和亲在选中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11433,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂题四首 其三","author":"王逢","text":"水凉风搅一池荷，睡眼醒来手自摩。\n数席云阴乱疏樾，髫孙惊报鹤群过。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11434,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂题四首 其四","author":"王逢","text":"藻池岸匝水仙开，满面香飘玉蝶梅。\n遗事罢书山馆寂，鼠狼行过雉鸡来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11435,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江边竹枝词八首 其三","author":"王逢","text":"社酒吹香新燕飞，游人裙幄占湾矶。\n如刀江鲚白盈尺，不独河鲀天下稀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11436,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重过望亭新城二堡","author":"王逢","text":"忆昔扁舟自西下，二堡相望无一舍。\n吴藩判枢翻覆儿，窄衫小弓矜骑射。\n归人重经但流水，豆陇弯弯低复起。\n长途遗庶数十家，三四酒旗风靡靡。\n君不见邠公迁岐山，卫人城楚丘。\n外患内修古所侔，成同败异嗟世□。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11437,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"会别马颍渔","author":"王逢","text":"别业归来千里馀，泰山倾盖喜无如。\n青衫不污新丰酒，白发终乘下泽车。\n地入东南空驿骑，雪消齐鲁足淮鱼。\n彼行此住情俱得，尚约鸡肥落木初。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11438,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"喜颜守仁教授留园馆信宿","author":"王逢","text":"前朝进士过林扃，信宿论心为竦听。\n云气夜蟠雄剑紫，天光寒入旧毡青。\n不同嘉树生南国，犹梦鲲鱼化北溟。\n老我归田有龙具，仅堪供卧读牛经。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11439,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"芮庠卿邀费孟霦同知陪酌背孰堂既同晚步口号","author":"王逢","text":"罢酒出前楹，霜寒著面轻。\n林腰烟帛束，天角火锋生。\n卧木桥通野，疏罾水隔城。\n宽袍曳筇竹，俱老愧宵征。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11440,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题泖塔时主僧贤如愚不在","author":"王逢","text":"何年窣堵耸奇观，势若蛟龙上纠盘。\n秦县赭衣沦鬼国，梵家宝藏压惊湍。\n野瞻雨黑重灯夜，天卧空青一镜寒。\n欲买扁舟占渔户，老缘无力候衡官。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11441,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"园馆杂书二首 其一","author":"王逢","text":"竹树藏山石作门，鱼矼水带洗花痕。\n莺声又在鸡声外，老不胜官只住村。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11442,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"园馆杂书二首 其二","author":"王逢","text":"殊乡春色不曾浓，才力新兼病思慵。\n一枕清风闻格磔，半瓶香雪浸苁蓉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11443,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"疏斋晚步","author":"叶颙","text":"睡足白云窝，行吟青草坡。\n夕辉流月屐，空翠湿烟蓑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11444,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送族侄扩之通州","author":"华幼武","text":"吾族最全盛，家声诗礼传。\n自遭丧乱后，谁能事陈编？\n犹子苦好学，乡闾称独贤。\n文采珊瑚枝，照映《棠棣》篇。\n时同竹林会，啸咏相周旋。\n一朝携酒至，别我荒城边。\n问渠欲何之，言将适通川。\n通川渺何许，远在沧海壖。\n府侯朱夫子，招我开讲筵。\n老怀极慰喜，汝去毋留连。\n吹墟千里外，感激故人怜。\n修程尽努力，慎勿中道捐。\n蛟龙起春雷，雕鹗抟秋天。\n物遇各有时，立功须盛年。\n此行非草草，著鞭宜尔先。\n要登青云路，忠义尚勉旃。\n舟发梁溪水，帆拂狼山烟。\n骨肉重相思，两地心悬悬。\n长江浩无波，击楫秋风前。\n行当赋清句，怀此山中泉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11445,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次元翚见寄韵","author":"华幼武","text":"通衢一倾盖，分首犹惜别。\n况是忘年交，离绪那可说。\n蝉鸣野外秋，雁叫沙头月。\n永保松柏姿，同盟岁寒节。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11446,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雁南飞","author":"华幼武","text":"雁南飞，飞不住。\n暮暮朝朝不稳栖，飞向水穷山尽处。\n水穷山尽天南头，年来有客离家愁。\n天空无云明月夜，千里万里清光流。\n家园零落秋风遍，人闻雁声泪如线。\n雁兮雁兮可奈何，稻粱多处多网罗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11447,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"编篱曲","author":"华幼武","text":"编竹篱，密密编。\n朝禦鸡犬入，暮防豺虎穿。\n交加编联互相倚，竹密藤缠坚莫比。\n春风披拂百花开，一片繁华如锦绮。\n君不见西家有篱编不密，夜夜惊呼防盗贼。\n愿言兄弟莫相疑，明日齐心编竹篱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11448,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"义兵行","author":"华幼武","text":"风萧萧，雨凄凄，义兵起程行路迷。\n腰刀手枪耀光辉，青衫白帽行队齐。\n问渠远行将何之，官司召募征江西。\n妻儿父母夹道啼，我今与汝生别离。\n生别离，不得已，在家出征同一死。\n麦禾满田穗将结，皇天淫雨无时歇。\n去年秋旱号饥寒，今年夏麦不得餐。\n幸逢此地无争战，供给军需民力乾。\n生为浙西农，死为江西卒。\n回首语妻儿，何处收吾骨。\n率土皆王民，安敢辞苦役。\n但愧扶犁手，畴能用矛戟。\n愿得将相俱贤才，扫除盗贼无纤埃。\n义兵归来旧田里，卖刀买牛复生理。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11449,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"养竹轩歌为周庄吴逵子道赋","author":"华幼武","text":"高轩公子良不俗，不种奇花种修竹。\n奇花照眼一时红，修竹虚心万年绿。\n春雷击地新笋生，龙角森森那忍触。\n自锄暖土厚栽培，手挈银瓶细浇沃。\n深根扫除蝼蚁窟，香叶终期凤凰宿。\n日使沾濡雨露恩，岁寒岂惮冰霜酷。\n猗猗绕户矗琅玕，含雾连烟比淇澳。\n招摇皓月金琐碎，勾引清风声戛玉。\n炎天展簟卧苍雪，春日听莺泛醽醁。\n可能一日暂相忘，坐对此君看不足。\n君不见白乐天，重言养竹比养贤。\n又不见东坡诗，无竹士俗不可医。\n君今有竹善培养，会看直拂青云上。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11450,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"荼蘼歌","author":"华幼武","text":"丹葩醉染猩猩血，素萼便娟比霜雪。\n呈妖逞艳岂足贵，含芳嗜洁誇清绝。\n荼蘼饱浥春雨膏，玲珑剪刻英琼瑶。\n千金脑麝和淑质，万个玉蝶萦柔条。\n坐看明月花梢上，便应题作清虚榜。\n醉眠花底不须归，狼藉苔茵空抚掌。\n先生爱花何太浓，对花一饮挥千钟。\n昔逢端伯称韵友，我欲结好渐衰容。\n莫教摇落西风后，贾岛留题传不朽。\n怜君为作《荼蘼歌》，多情又酿酴醾酒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11451,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"风棚","author":"华幼武","text":"百尺虚结构，松风起四檐。\n遂令秋满屋，何用昼垂帘。\n蔽日云常在，当窗雨不沾。\n翛然无限意，丛竹净相兼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11452,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"清坐","author":"华幼武","text":"驱驰欣暂息，清坐感馀春。\n细雨偏宜草，疏帘不隔尘。\n山禽时引子，庭鹤晚随人。\n几负林泉约，空嗟头上巾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11453,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客楼夜雨","author":"华幼武","text":"城郭易为热，江云起不难。\n电光生夜白，雨气入楼寒。\n书叶仍防润，灯花不耐看。\n祇缘听亦惯，竟夕睡偏安。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11454,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宿蠡口","author":"华幼武","text":"春风吹短棹，迤逦望归程。\n刁斗溪边戍，旌旗野外营。\n市桥人迹少，官路马蹄轻。\n欲向东湖去，边烽永夜明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11455,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"久雨","author":"华幼武","text":"江雨洒还稀，江云湿更低。\n不愁吴水阔，惟恨楚山迷。\n野鹤思高举，林乌慕稳栖。\n渐看晴景好，可得溷涂泥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11456,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游碧浪湖简同行沈高士","author":"华幼武","text":"浮玉山边晚系舟，菰蒋萧瑟似新秋。\n碧天万里写银汉，明月一轮当柁楼。\n每愧尘劳成白首，喜从仙御作清游。\n酒杯未落南风起，又挂归帆托顺流。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11457,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次杨文昭见寄韵","author":"华幼武","text":"一别故人知几时，相思每诵隔年题。\n兵戈满眼愁无那，风雨连床梦转迷。\n遥瞩层城坚铁石，俯怜荒野困涂泥。\n兴来每欲操舟去，伫待西村罢鼓鼙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11458,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"斑竹帘","author":"华幼武","text":"湘妃泪洒碧琅玕，剪织疏帘拭未乾。\n细缕引风宜隔暑，湿痕含雨欲生寒。\n灯前照耀琉璃洁，月下斓斑玳瑁看。\n直干尽输兵革用，高堂舒卷莫摧残。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11459,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题阳山顾碧溪诗卷","author":"华幼武","text":"闻说山中顾隐君，幽居不与俗人群。\n爱看舞鹤护苍藓，净扫落花留白云。\n李愿已刊《盘谷序》，稚圭休拟《北山文》。\n一溪春水连天碧，肯著孤舟载月分。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11460,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寒食感怀","author":"华幼武","text":"寒食维舟江上村，临风西望黯销魂。\n花将春色归流水，云系愁心入故园。\n丘垄不知谁洒扫，藤萝应复自滋蕃。\n衰年尚作无家客，只合当时住鹿门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11461,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵题画","author":"华幼武","text":"海石涵秋水，风篁生晚凉。\n孤篷初歇雨，和月度潇湘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11462,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江南曲","author":"华幼武","text":"郎上渡江船，妾倚江边树。\n空挽柳丝长，系郎船不住。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11463,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟比红儿赋解语花二首 其一","author":"华幼武","text":"绰约柔情不自胜，翠围红绕几层层。\n隔帘立尽阑干月，却讶真真唤即应。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11464,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟比红儿赋解语花二首 其二","author":"华幼武","text":"雾縠云绡淡淡妆，微风吹散郁金香。\n临风一片伤春意，欲向何人诉断肠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11465,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题桃花十二红图","author":"华幼武","text":"枝上栖禽五色毛，睡酣花气日初高。\n江南一觉繁华梦，满地荆榛叫百劳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11466,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日偶成二首 其一","author":"华幼武","text":"城头杨柳绿如云，城下官河水拍春。\n一片江山元不改，画船都是异乡人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11467,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日偶成二首 其二","author":"华幼武","text":"船头细雨湿渔蓑，船尾桃花漾碧波。\n借问东君知得否，江南春色已无多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11468,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桃源图","author":"华幼武","text":"流水桃花世外春，渔郎曾此得通津。\n当年只记秦犹在，不道山河又属人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11469,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"云林画山水竹石","author":"华幼武","text":"秋云无影树无声，湛湛长江镜面平。\n远岫烟销明月上，小亭危坐看潮生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11470,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵曲林春雪","author":"华幼武","text":"剩喜漫天飞玉蝶，不嫌幽谷阻黄莺。\n夜深错认催花雨，梦觉惊闻折竹声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11471,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"小游仙","author":"吴惟善","text":"河汉无声海月寒，长鲸吸浪洞庭乾。\n一声铁笛风云动，人在危楼第几阑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11472,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赵仲穆画看云图","author":"顾瑛","text":"青山与浮云，终日淡相守。\n山为云窟宅，云为山户牖。\n无心成白衣，有意变苍狗。\n人情亦如云，寄语看云叟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11473,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"巫峡云涛石屏志","author":"顾瑛","text":"谢家绿玉屏，不琢龟甲形。\n方若陟釐纸，粉缥带苔青。\n秀洁庚庚绝文理，十二巫峰横隐起。\n芙蓉照影立亭亭，远落巴江一江水。\n素湍汹涌翻绿涛，长风吹云白月高。\n三峡涛声满人耳，个中独欠孤猿号。\n胡僧谩有金壶汁，洒向素缣图不得。\n女娲鍊石作五彩，点染料应无此色。\n此石产景由天工，略假石人磨削功。\n石色欲尽玉色起，汎沉天碧涵清空。\n君不闻大食贡石瑩如玉，中有奇松四时绿。\n六月凉风卷翠涛，瑟瑟秋声战空屋。\n又不闻杨家古屏刻水精，中有为云之美人。\n海绡衣裳为烟雾，姓名自语非真真。\n二物化去固已久，价重隋珠难再有。\n君家玉屏独在世，勿落忍人豪夺手。\n我闻故人杨铁仙，束带拜之如米颠。\n起来发狂捉铁笔，醉墨写入青瑶镌。\n何日乘舟上鱼复，唤取巴童唱巴曲。\n更借丹丘粉墨屏，对案巫山真面目。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11474,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"玉鸾谣","author":"顾瑛","text":"七宝城中夜吹笛，舞按白鸾三十只。\n个中小玉号细腰，尾拂广陵秋月白。\n伐毛脱骨秋风里，素颈圆长尺有咫。\n中虚一窍混沌通，上有连珠七星子。\n羿妻久闭结璘台，弄玉求之遗箫史。\n调得仙家别鹄声，吹落虎头金粟耳。\n桂园仙伯杨铁翁，昔豢洞庭双铁龙。\n雌龙入海去不返，雄龙鳏处琼林宫。\n宫中夜夜泣寒雨，幽咽悲啼作人语。\n燃犀莫照玉镜台，买丝难系蓝桥杵。\n虎头怜之为媾婚，并刀剪纸招鸾魂。\n鸾之来兮洞房晓，恍然枕席生春温。\n铁仙翁，笑拍手，左琼琼，右柳柳。\n琼琼细舞柳柳歌，起劝虎头三进酒。\n画堂龟甲开屏风，翠烟凝暖春云浓。\n大瓶酒泻鹦鹉绿，满头花插鸳鸯红。\n鸾兮运居巢，龙兮弄横竹。\n君山月落大江秋，黄姑星殒昆冈玉。\n不须再奏合欢辞，且听和鸾太平曲。\n太平曲，断还续，一转一拍相节促。\n谐宫协徵宣八风，寒谷能令生五谷。\n鸾龙台上凤皇来，万岁八音调玉烛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11475,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"栖云轩","author":"顾瑛","text":"春云压帘飞不起，暖气茏葱百馀里。\n桃花亭亭笑酣春，溪边浣花染溪水。\n武陵才人碧窗底，青霓衣裳白霞里。\n翠烟默染猩猩毛，冰绡凝文露华洗。\n山光入眼青青迷，小鸟向人啼复啼。\n前村后村树如盖，柳花起舞回风低。\n云师雨师浩无据，驱云劳劳向何处。\n请君劝师一杯酒，更借白云檐下住。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11476,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪夜泊枫桥","author":"顾瑛","text":"江城残雪里，人发剡溪舟。\n花急风翻去，潮生水逆流。\n伤心怜去雁，幽兴托盟鸥。\n寄语东蒙叟，春山拟共游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11477,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"写柏子庭卷","author":"顾瑛","text":"虚舟元不系，湖海至今称。\n悟得庭前柏，方为物外僧。\n空空无我相，落落有谁应。\n肯向东山住，东山气倍增。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11478,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和韵二首 其一","author":"顾瑛","text":"喔喔鸡鸣桑树颠，江村风景只依然。\n人行红叶黄花里，雁过西风落日边。\n南市津头无酒旆，东湖渡口有鱼船。\n北山岩壑秋偏静，借看蒲团枕石眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11479,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和韵二首 其二","author":"顾瑛","text":"夏潮平没白鸥沙，舶䑲风生起浪花。\n为向船头置美酒，恰如天上汎浮槎。\n银盘雪落千丝鲙，玉手冰分五色瓜。\n明日山中看疏雨，共将诗句寄丹霞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11480,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵送吴国良","author":"顾瑛","text":"桐轩隐者重相访，草阁能留十日归。\n快雪半消春水阔，扁舟又逐白鸥飞。\n似闻迂叟耕梅里，每过山家款竹扉。\n期子几时来慰我，共披鹤氅坐渔矶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11481,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"海洲夜景","author":"顾瑛","text":"三沙宛在海当中，隐见珊瑚树色红。\n神岛由来连弱水，楼船欲去引刚风。\n东方日出鲛人国，半夜潮生织女宫。\n却忆题诗绣衣使，高秋会过玉山东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11482,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵刘季章治中邀夏仲信郎中游永安湖","author":"顾瑛","text":"湖上筵开张水戏，卷幔凉风吹短蒲。\n大鱼听乐浪头出，小艇卖花城内无。\n丙鼎庚庚识饕餮，甲煎斑斑炙鹧鸪。\n酒酣赋诗动海色，茧纸楷书能寄吾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11483,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵癸卯除夕","author":"顾瑛","text":"仰观北斗转遥天，春在寒炉爆竹边。\n夜列粉盘循旧俗，晓看罗帕贺新年。\n烧馀葶苈生当路，雪后梅花开满烟。\n不用鞭灰觅如愿，客囊剩有酒家钱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11484,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"武岛上梅花","author":"顾瑛","text":"□波荡漾镜中天，璚树春回玉□妍。\n苔雨青青空落月，□云漠漠不成烟。\n□□□□缑山侣，照影疑逢洛浦仙。\n王母欲来青鸟下，暗香如水夜如年。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11485,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赵子期尚书于省幕创轩曰小瀛洲题诗要余与明德同赋","author":"顾瑛","text":"凤皇池上神仙宅，五色卿云接帝家。\n金水暖通蓬岛浪，紫薇香度掖垣花。\n中天草木春沾泽，沧海星辰夜挂槎。\n闻道朝堂清议了，题诗好为护蝉纱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":11486,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]