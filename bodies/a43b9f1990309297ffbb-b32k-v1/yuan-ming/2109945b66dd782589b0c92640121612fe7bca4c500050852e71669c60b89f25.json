[{"title":"张叔芳南涧草堂","author":"徐贲","text":"浴鹄湾头旧隐居，五峰秀色在庭除。\n山田曾种仙家玉，石室犹藏外史书。\n雨足涧声春沥沥，风平柳影月疏疏。\n百年文物惟君在，结搆重来是乱馀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10459,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"郑静思少监山庄","author":"徐贲","text":"秘书解绶还山日，移得全家住白云。\n閒里樵渔教子习，老来药茗赖僧分。\n双岩树合千层绿，百嶂霞明五色文。\n此去石桥原不远，钟声只在座中闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10460,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄衍斯道上人","author":"徐贲","text":"已知出世万缘空，谁谓诗穷道亦穷。\n双履遍行黄叶雨，三衣独坐碧萝风。\n荒山泉石皆兵后，古室香烟自定中。\n愧我远归千里客，投閒未得与师同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10461,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵答陈文度","author":"徐贲","text":"乱馀得返故乡居，正谓光生腐草馀。\n闵已欲凭谁作赋，绝交宁许我为书。\n行看残菊知身老，坐对寒鸦愧鬓疏。\n准拟求田成隐计，天于此意可教如。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10462,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"病中寄高季迪","author":"徐贲","text":"一榻高眠薜荔间，闭门瘦减镜中颜。\n乱来难免心多虑，病久番令梦得閒。\n疏雨林花春落竞，斜风巢燕晚飞还。\n药炉应候呼儿煮，此外升沉总不关。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10463,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钱氏池园燕集得春字","author":"徐贲","text":"幸存万死一吟身，燕赏良时岂厌频。\n开到栋花风乍暖，啼残桑扈雨辞春。\n清樽偏解欹愁客，短发空惭对故人。\n经此乱离今得见，论情便觉转相亲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10464,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"陈允中乱后归故陇营居见寄奉答","author":"徐贲","text":"万事由来信有天，癯儒只合住林泉。\n藏书自搆山中屋，束带仍耕墓下田。\n但对老农谈亦好，何须漂母识为贤。\n壮年未断人间世，且尽平生嫁娶缘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10465,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"访冯信卿县令","author":"徐贲","text":"来觅幽踪野水边，荒村树里起新烟。\n梨花萧寺哦诗处，春水平湖把酒前。\n念我身经迁逐在，喜君家值乱离全。\n当时怅望天边外，今日翻思始惘然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10466,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵答冯信卿见寄","author":"徐贲","text":"自愧才疏老涧滨，此身非是避风尘。\n长贫为读蔬经熟，多病应同药裹亲。\n僧惠竹枝轻作杖，客分荷叶小裁巾。\n故人眼底惟君在，深喜书来问我频。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10467,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄郦尚德王汝器","author":"徐贲","text":"尘世閒身遂两违，扁舟应是入城稀。\n看花雨里宜高屐，穫稻霜馀或短衣。\n玄鸟年年依屋住，白鸥日日绕门飞。\n寻君不用重相问，梅子林西竹下扉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10468,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"哭韩景华教谕","author":"徐贲","text":"命终万事亦徒然，辛劳侥名五十年。\n头白尚嗟弹有铗，家贫信是坐无毡。\n梨花寒食新坟上，杨叶秋风旧宅前。\n两处经过皆草草，一杯未得酹重泉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10469,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送王守敬归淮南","author":"徐贲","text":"大江北望渺烟波，君及归时奈别何。\n诗卷自添新赋咏，客程还历旧经过。\n芰荷浦里人家少，渔米乡中估舶多。\n谩有一樽相对饮，秋风又起棹郎歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10470,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵高季迪喜予北归相访江渚之作","author":"徐贲","text":"客里频思大树村，归来还喜旧情存。\n十年梦寐凭诗寄，千里风霜藉酒论。\n江上衣裳冬倍冷，竹间窗户昼犹昏。\n从今会别非遐远，不学梅花易断魂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10471,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"双头菊为周孟瞻昆仲赋","author":"徐贲","text":"篱落花开并蒂黄，相依不是竞秋光。\n情亲共冒重阳雨，志傲同凌十月霜。\n莫道寒英为独秀，须知晚节有联芳。\n谱中异品谁能及，只合题名作棣棠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10472,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄渭僧清远","author":"徐贲","text":"自喜幽居接上方，风烟野墅共相望。\n禅边梅老知僧腊，经里莲芳悟性香。\n石为弹琴曾作荐，屋缘藏茗别开房。\n日长何处堪消暑，欲借山中竹下凉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10473,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山阁夜坐","author":"徐贲","text":"山阁岩岩俯下方，望来暝色向苍茫。\n冈峦暗失高低势，星斗平垂远近光。\n栖鸟鸣鸡经火乱，疏松修竹引流长。\n相期白日重登此，要及春时览众芳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10474,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"乐善庵访张山人不遇","author":"徐贲","text":"欲使馀生得远閒，重来林下扣禅关。\n惟闻涧鸟时鸣涧，却讶山人复出山。\n雨草渐荒幽径里，风泉仍响古松间。\n自将吟咏酬终日，?取扁舟载月还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10475,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浩师房别李伯章","author":"徐贲","text":"君今初到我将还，离合都从一夕间。\n草草欢情灯下酒，悠悠去梦月中山。\n秋堂钟静催禅定，寒榻香来伴客閒。\n莫怪相逢论行乐，壮年无几鬓成斑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10476,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送珣楚山还广济","author":"徐贲","text":"一来说法众皈依，云水无心又复归。\n处处逢僧留半偈，时时礼佛备三衣。\n斋筵赴遍人缘喜，净业修多世态违。\n鸡罩山前明月夜，家徒相候启禅扉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10477,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄蒋道士","author":"徐贲","text":"云鹤飘然去莫亲，还家犹似异乡贫。\n已知静乐轩中梦，无复玄都观里春。\n绿简尽编吟后稿，朱符长佩病馀身。\n近闻剑迹投岩壑，终作人间避世人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10478,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送重衲住武康杨庵","author":"徐贲","text":"和王功业太常书，额赐禅宫表墓墟。\n香炷四时同佛供，松风百嶂有僧居。\n鼓钟声隐高秋外，楼阁名存劫火馀。\n此去封禺山色远，伫看一锡度空虚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10479,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"昆山道中","author":"徐贲","text":"鸿雁天寒俦侣稀，秋风远客独思归。\n碧山尽处湘云续，白水明边鹭自飞。\n漠漠芦花迷望眼，萧萧荷叶惨征衣。\n此行赖共知心语，一棹夷犹竟落晖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10480,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登昆山次易九成诸友韵","author":"徐贲","text":"故旧相违西复东，登临偶得此时同。\n钟声响落松阴外，帆影来从海气中。\n山鬼洞寒销劫火，石僧龛古闭香风。\n可怜节届重阳近，斜日秋明万叶红。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10481,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵高翰林启喜予见过之作","author":"徐贲","text":"相逢已似恨来迟，况是秋风欲尽时。\n念我身便林下服，喜君家富箧中诗。\n清江杳杳曾行路，黄柳萧萧旧折枝。\n无限樽前云共鸟，应知此处感离思。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10482,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和杨仪曹基舟次邵白怀寄","author":"徐贲","text":"了无得失叹鸡虫，南北驱驰数载中。\n奉使子谙天远近，居閒我识壤西东。\n画船河渚高邮驿，茅屋江乡短褐风。\n何日归来让王里，云山谈笑一尊同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10483,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"道场山寺","author":"徐贲","text":"景物凄凉异昔年，佛宫草树暗荒烟。\n千盘日色峰头转，百道泉声石上悬。\n觉鸟有时酬客语，慈云何处伴僧禅。\n莫言楼阁成空想，地胜山灵亦变迁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10484,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重游道场","author":"徐贲","text":"路入千峰石磴危，经台香阁但馀基。\n僧从离乱居山少，客为登临出寺迟。\n伏虎已无岩下锡，放鱼空有竹边池。\n曾闻至治承平日，箫鼓春风过六时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10485,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送彭伯忻佥宪赴河南","author":"徐贲","text":"载笔同趋侍从班，曾将翰墨动龙颜。\n绣衣又向河南去，玉节新从海上还。\n千里舟航通洛水，中原文物入夷山。\n当时不得相追饯，谩寄离情画轴间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10486,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠隐者次毛伯让韵","author":"徐贲","text":"归隐柴桑计已成，行歌曳履作商声。\n朝廷有诏徵遗逸，刺史无人识姓名。\n山鸟下阶窥饮器，野猿移石置棋枰。\n西风茅屋年年捲，惟有黄花不世情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10487,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠赵安道","author":"徐贲","text":"偶为行春此访君，山围野墅宿晴云。\n药田鹤守耕相候，邻屋茶香饮见分。\n林下看花多是杏，溪浔拾草始知芸。\n每闻?醉消长日，谁复来题白练裙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10488,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春宫词","author":"徐贲","text":"沉沉别院语流莺，惊断春风梦里情。\n坐试舞衣因力倦，起临妆镜觉愁生。\n馀香细拂芙蓉帐，小燕频窥翡翠旌。\n不意中官传唤急，侍朝得与殿头行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10489,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"藏春轩","author":"徐贲","text":"溪上幽居小径斜，柳垣长日护春华。\n时时清燕无非酒，处处閒行总是花。\n自有轩窗留景物，肯教蜂蝶过邻家。\n桃情杏思浑忘却，回首东风不用嗟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10490,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题胡玄素画山居图","author":"徐贲","text":"几度寻幽到涧阿，荒溪峻岭入烟萝。\n白云九曲人家少，黄叶千林虎迹多。\n试茗就当泉上饮，看花须向酒边歌。\n相逢重忆山中客，独对新图奈别何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10491,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九月十六日陈逸人旭访余蜀山中明日将还武塘因赋此送别","author":"徐贲","text":"门掩荒山万木空，独怜远客此相同。\n黄花兴减重阳后，白发愁多暮雨中。\n双剑不缘悲异国，一杯未易醉西风。\n明朝离思知何处，秋水遥天有去鸿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10492,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄王校书止仲","author":"徐贲","text":"他乡每忆故乡云，此日还山又忆君。\n菊老岂堪秋后采，猿啼犹似客中闻。\n风帆渔艇行无次，野水寒烟去莫分。\n不是题诗不相寄，孤鸿也自念离群。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10493,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题宋参政记事状后","author":"徐贲","text":"江湖閒老七朝臣，圣主临轩属问频。\n殿陛屡曾听曳履，都门谁复继埋轮。\n拜官南省推功旧，被宠东宫赐翰新。\n岂料贤郎归第日，上尊空酹九原尘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10494,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送王架阁南归","author":"徐贲","text":"兰桡暂驻酒停斟，隔浦谁歌送别吟。\n归雁不随南去客，飞云犹载北来心。\n野梅官柳愁相映，暮雨春江思共深。\n想得慈亲倚门久，逢山逢水莫登临。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10495,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"白塔怀古","author":"徐贲","text":"荒山欲逐凤飞鶱，谁搆浮图压寝园。\n土厚尚封南渡骨，月明不照北归魂。\n海门有路双龙去，沙碛无潮万马屯。\n莫向风尘重怅望，梵王宫殿易黄昏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10496,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江西途中寄吴城北郭王李诸友","author":"徐贲","text":"雨晴沙渚片帆开，葭菼飞花雁叫哀。\n千里有情思北郭，半年无梦落南台。\n山遮故国层层出，云押长江片片来。\n可是宦途吟思恶，强凭尺牍浼清才。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10497,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题彭江","author":"徐贲","text":"远水残阳落钓舟，远村渐见野烟收。\n菱歌归浦家家夕，扬叶惊风树树秋。\n昨日梦非今日梦，他乡愁是故乡愁。\n自怜久负山中桂，每向江湖忆旧丘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10498,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送日本僧","author":"徐贲","text":"万里扶桑晓色微，海天空阔去人稀。\n木杯不用随潮渡，金策惟应向日飞。\n去路犹餐中土饭，到家重著故乡衣。\n国人应问如来法，带取西天贝叶归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10499,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答故人杨宪副孟载","author":"徐贲","text":"忆在并州喜合并，别来两见岁华更。\n自知诗里閒情少，顿觉尊前老态生。\n桑枣谁家非乐土，云沙何处是边城。\n怀君几度频登览，寒日千山雪正晴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10500,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题坦率子画","author":"徐贲","text":"林屋閟烟萝，归樵已罢歌。\n独吟斜日里，谁复此相过。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10501,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送吕庸南","author":"徐贲","text":"雪色上征衣，云沙雁自飞。\n去家千万里，只解送人归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10502,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"萱草","author":"徐贲","text":"翠叶春初解，香苞晓尚含。\n东风生百草，何尔独宜男。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10503,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次衍师韵","author":"徐贲","text":"偶因故人留，不遂林下期。\n遥知看月处，为我立多时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10504,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送王七隅入郭","author":"徐贲","text":"江云载客愁，江色未分曙。\n君若回首时，莫忘别离处。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10505,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀王介休","author":"徐贲","text":"花落又花开，思君酒一杯。\n故山千万点，长向夕阳来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10506,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画别董仲德","author":"徐贲","text":"鸟啼溪上雨，风碎竹间云。\n明日东湖上，看山又忆君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10507,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客夜 其一","author":"徐贲","text":"客舍卧常早，茶馀人各归。\n独有榻前烛，犹能照解衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10508,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客夜 其二","author":"徐贲","text":"新月出易没，残叶坠还鸣。\n客中自无寐，元不为秋声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10509,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"庚戌岁元日立春 其一","author":"徐贲","text":"首祚欣兹践，新年喜并回。\n簇丝分细菜，剪胜学蟠梅。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10510,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"庚戌岁元日立春 其二","author":"徐贲","text":"宜春新燕帖，正旦颂椒花。\n乐遇重熙日，东风改岁华。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10511,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"元宵遇雨","author":"徐贲","text":"万灯明不夜，鼓吹匝鳌山。\n一雨妒城郭，人回尽赧颜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10512,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画 其一","author":"徐贲","text":"屿鸟鸣孤影，汀蘋淡素香。\n晓来江上树，叶叶是新霜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10513,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画 其二","author":"徐贲","text":"隔浦秋鸿小，当江夕照空。\n扁舟不觉重，却载荻花风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10514,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画 其三","author":"徐贲","text":"路入桃源近，门藏竹户深。\n孤云同隐迹，老鹤识閒心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10515,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"徐山人耕渔轩","author":"徐贲","text":"荷锸陇头春雨，鸣榔浦口黄昏。\n谁道南阳渭水，不似桐江鹿门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10516,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画 其一","author":"徐贲","text":"樵林夜鸣枫叶，僧扉寒掩烟萝。\n梦里秋山十二，不知何处云多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10517,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画 其二","author":"徐贲","text":"竹外閒扉半掩，沙边小径斜通。\n流水连朝春雨，飞花昨夜东风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10518,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画 其三","author":"徐贲","text":"偶过邻家看竹，因来僧寺弹琴。\n寒日山川易晚，归时门掩松阴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10519,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画 其四","author":"徐贲","text":"雨后山青云白，林深路转溪回。\n野客舣舟相待，家僮沽酒方来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10520,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春江送别图送松江王尹 其一","author":"徐贲","text":"行李一琴一鹤，扁舟千水千山。\n空醉驿亭官酒，春风不解离颜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10521,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春江送别图送松江王尹 其二","author":"徐贲","text":"草色东西客路，江声早晚春潮。\n别后思君何处，鸣禽疏雨兰苕。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10522,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"写意","author":"徐贲","text":"看山看水独坐，听风听雨高眠。\n客去客来日日，花开花落年年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10523,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"咏情","author":"徐贲","text":"燕子楼头初月，桃花门外春风。\n肠断琵琶弦里，愁多懊恼歌中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":10524,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]