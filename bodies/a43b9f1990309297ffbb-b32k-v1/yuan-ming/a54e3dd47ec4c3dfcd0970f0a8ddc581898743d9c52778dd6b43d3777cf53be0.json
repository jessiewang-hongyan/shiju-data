[{"title":"与张文秀教谕","author":"王翰","text":"广文标致不可及，皎皎浑如出水莲。\n才器直为金马客，文章真是玉堂仙。\n年年士子登甲第，日日衣冠肃讲筵。\n官俸虽清能爱客，客来未便坐无毡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14036,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"白燕","author":"王翰","text":"王谢堂前寄此生，迩年毛骨变轻明。\n乌衣道远归来老，红线楼高飞出惊。\n华月照梁空有影，柳风吹雪只闻声。\n谁家宝匣新开处，应对青鸾恨不胜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14037,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"黑蝴蝶","author":"王翰","text":"一自南华梦里惊，守玄心悟更通灵。\n铁丝细剪双眉曲，墨纸新裁两翅轻。\n燕子帘前浑髣髴，梨花枝上最分明。\n天然不用施朱粉，容易滕王为写生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14038,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"红梨花","author":"王翰","text":"西郭墙头带雨枝，春风特与换芳姿。\n香同白雪莺难认，影落红云蝶欲痴。\n醽醁醺酣春未醒，胭脂匀浅晓偏宜。\n世间纵有徐熙笔，画出奇葩更可疑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14039,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"白桃花","author":"王翰","text":"武陵仙子厌红裳，欲与梨花斗靓芳。\n崔护再来难映面，刘郎归去不成妆。\n青条辨李无繁蕊，缥蒂疑梅欠异香。\n陌上看时偏被恼，难吟难认更难忘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14040,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"葡萄酒","author":"王翰","text":"揉碎含霜黑水晶，春波滟滟煖霞生。\n甘浆细挹红泉溜，浅沫轻浮绛雪明。\n金剪玉钩新制法，紫驼银瓮旧豪名。\n客愁万斛可消遣，一斗凉州换未平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14041,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"言怀简丁志善三首 其一","author":"王翰","text":"挥涕临岐作别难，岂期今日偶生还。\n早知刺舌惩多口，何事低眉致厚颜。\n诗寄碧云生晚戍，书来黄叶满秋山。\n一杯浊酒清灯夜，犹恐相逢是梦间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14042,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"言怀简丁志善三首 其二","author":"王翰","text":"白首如新固不虚，操戈机变更愁余。\n早年定约成婚嫁，岁晚相期共卜居。\n本为叔牙知管仲，岂期张耳害陈馀。\n自今取友须加慎，至圣犹言失宰予。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14043,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"言怀简丁志善三首 其三","author":"王翰","text":"百年能得几回过，耳热宁辞顿蹋歌。\n渌酒暂烘颧颊赤，玄霜难染鬓毛皤。\n闲中倒指同年少，老限惊心去日多。\n千里不辞鸡黍约，好将伐木苦吟哦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14044,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再游竹林寺","author":"王翰","text":"碑石千年记李唐，高僧神异更张皇。\n山间木润龙腾气，林际灯明佛放光。\n金舌有人传正印，石头无客问空王。\n我来暂借禅床坐，闲漱清泉净水香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14045,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"上刘道益知县","author":"王翰","text":"半世儒冠不负予，清时甘分作樵渔。\n买牛已卖腰间剑，换米从招架上书。\n美政共推贤守令，侨居浑胜旧乡闾。\n相从六七青衿子，时咏春风学舞雩。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14046,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"简畅真空上人","author":"王翰","text":"万顷澄波片月沉，观时似有却难寻。\n菩提作树元非相，玉镜生尘岂是心。\n三世愿香飘静界，诸天法雨洒檀林。\n何时尽弃人间事，为问无生对碧岑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14047,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"侯村寺遣怀二首 其一","author":"王翰","text":"径寸明珠忍暗投，浮云富贵不须求。\n东山有识方高枕，渭水无心下直钩。\n随柳偶从前浦去，看花闲到上方游。\n何时婚嫁尘缘毕，烂醉秋风上钓舟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14048,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"侯村寺遣怀二首 其二","author":"王翰","text":"我为劳形损性灵，时来野寺伴山僧。\n拂开素壁留新句，剔落苍苔读旧铭。\n花雨远从天外至，磬声多向月中听。\n幽窗一夜浑无寐，洗尽尘根两耳清。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14049,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游静林寺","author":"王翰","text":"寻幽偶到南山寺，绝境人间那得双。\n贝叶翻经神鹿听，昙华贮水毒龙降。\n法雷振座响磬铎，灵风入殿摇幡幢。\n题诗每向上方宿，雪峰倒影沉西窗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14050,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"得南信四首 其一","author":"王翰","text":"死别吞声事已难，何如生别彻心酸。\n青丝尚系残箴线，绛缕犹存旧带鞶。\n瘴海不收泉下骨，荒山谁葬木皮棺。\n只缘老病身犹在，哭得无声泪始乾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14051,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"得南信四首 其二","author":"王翰","text":"闻道乌蒙万里州，天南地北两悠悠。\n饥来口吃谁家饭，死去尸填何处沟。\n衣弊不堪逢岁暮，囊空兼恐值年忧。\n白头未白馀多少，消得秋风一夜愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14052,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"得南信四首 其三","author":"王翰","text":"传来消息未全真，生死应知子母分。\n蚤解胡笳悲蔡琰，不嫌荆布嫁陈云。\n长号夜雨垂青血，薄祭秋风乱白纷。\n南望云南在何处，雁行凄断不堪闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14053,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"得南信四首 其四","author":"王翰","text":"负汝逃生出四围，饥寒奔走入山隈。\n父从旧友干衣去，母向邻家借米回。\n早是幼时长处困，谁知嫁后又逢灾。\n佳人命薄诚如此，毁璧长歌心更哀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14054,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谒三皇庙","author":"王翰","text":"混沌凿来天地分，蚩蚩鹿豕尚同群。\n龟图已阐先天画，鸟迹初呈上古文。\n肇创礼仪犹罔象，未开风气自氤氲。\n谁还太古熙熙俗，卉服洼樽读典坟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14055,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日郊行","author":"王翰","text":"林外鸠鸣客梦残，起来随意岸青纶。\n春深池面生新水，晚霁云头露远山。\n野寺秾花飞蛱蝶，高岑乔木啭绵蛮。\n杖挑二百青钱在，拟买村醪一醉还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14056,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"侯村夏日即事","author":"王翰","text":"睡足西窗日尚留，起来推枕强梳头。\n一川麦浪荒村远，满院松阴野寺幽。\n徒见衣冠惊俗辈，空教文字迈时流。\n朱门欲谒谁青眼，拟向溪边买钓舟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14057,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"傅岩晓霁","author":"王翰","text":"云过西山宿雨收，霏霏空翠泼双眸。\n清流抱涧鸣沙碛，白鹭依林下蓼洲。\n野庙丹青从古写，空山版筑至今留。\n年年民庶思霖雨，犹向高岩祠下求。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14058,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"茅津晚渡","author":"王翰","text":"峡束春涛万丈深，唤船人立石岩阴。\n棹声欸乃连山应，旗影悠扬隔水深。\n宿雨乍收山积翠，夕阳倒射浪浮金。\n南来北去人空老，浩浩东流无古今。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14059,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"金鸡晓月","author":"王翰","text":"一山雄峙太阳津，绝顶翘翘迥出群。\n碧树九秋含月色，黄流千古抱云根。\n雨平故垒金函出，水打荒坟石椁倾。\n幸际太平无警急，高原时见老农耕。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14060,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"吴庙秋风","author":"王翰","text":"勾吴树业向荆南，至德曾闻固让三。\n永立武王元有道，受封虞仲更何惭。\n碑残野火文全灭，树响山风战欲酣。\n禽鸟亦知亡国恨，向人啼断入烟岚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14061,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"閒田春色","author":"王翰","text":"敛衽重寻瓜瓞诗，二君被化圣明时。\n人心似日云烟蔽，圣德如天草木知。\n风煖平原花发早，雨昏高树鸟归迟。\n如今犹有风流在，阡陌纵横不忍犁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14062,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"沙间桃林","author":"王翰","text":"十里芳桃蒸晚霞，一川红雨点溪沙。\n莎汀浪煖渔舟出，茅屋风轻酒旆斜。\n陌上筦弦多醉客，林间鸡犬有仙家。\n此中疑是秦人种，策杖寻源逐落花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14063,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虞城暮雨","author":"王翰","text":"冻雨森森万竹齐，独驱羸马踏青泥。\n颠軨涧险垣墉护，毕轸城荒蔓草迷。\n井伯不忠宜作虏，百奚先去更知机。\n徘徊欲问鄍门处，满目西风禾黍低。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14064,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"条山积雪","author":"王翰","text":"三日高眠闭小斋，西山一望失楼台。\n傍岩松竹璚林列，当户峰峦画帐开。\n青旆晓誇新酒出，玉蓑寒驾小舟来。\n披衣闲拓岩窗看，原上鸣弓猎骑排。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14065,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"箕山落照","author":"王翰","text":"行尽箕山第几重，乱峰高下夕阳红。\n泥涂轩冕夔龙上，土木形骸鹿豕中。\n洗耳溪头馀晚濑，弃瓢岩畔有寒松。\n自从避让归何处，一入霞烟更不逢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14066,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"底柱鸣澜","author":"王翰","text":"一柱亭亭似削成，峡深云冷古苔青。\n洄波浮沫双轮转，巨浪漂山万鼓鸣。\n鬼凿尚留神禹迹，龙图高拱帝虞灵。\n知今圣代当呈瑞，直待何年始见清。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14067,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谢李荣惠枣实","author":"王翰","text":"君园紫玉三百斛，分散贫家胜赤珠。\n晨食甘香宜豆粥，晚炊柔脆杂雕胡。\n作糕尤可供儿索，和药须知益老痡。\n准拟买田酬夙愿，耕馀亲手种千株。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14068,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"食苜蓿","author":"王翰","text":"东皋雨过土膏润，采撷登厨露未晞。\n生处碧条侪苋藋，糁时白粲埒珠玑。\n阑干敢效诗人讽，顑颔多惭战马肥。\n还胜红蓝遍中国，冶容争不济年饥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14069,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"中留道中","author":"王翰","text":"秋风烂漫熟禾黍，夹路垂垂枣尽红。\n长镰在腰来妇女，小篮负背走儿童。\n野菊开花清露湿，楼桑坠叶白烟笼。\n夕阳山下少人去，杖藜随意数飞鸿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14070,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄董仲伦四首 其一","author":"王翰","text":"天地清空一点尘，此身聚散梦难真。\n闭门咸谷花争发，策杖王官草自春。\n荣辱尽抛身世了，行藏都入笑谈新。\n堂堂正道行将去，更莫回头别问津。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14071,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄董仲伦四首 其二","author":"王翰","text":"不见能诗董召南，梦中时复接清谭。\n韬潜每爱龟藏六，贪得常嗔狙怒三。\n临晋河深鲂鲤出，首阳山近蕨薇甘。\n高堂戏綵娱亲暇，万卷图书灯一龛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14072,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄董仲伦四首 其三","author":"王翰","text":"同学连床听两眠，此情回首几经年。\n愁心多碎虫声里，归梦常悬雁影边。\n儿女渐多生计薄，文章虽拙道根全。\n兴来抱膝吟梁甫，惫卧西窗日满川。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14073,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄董仲伦四首 其四","author":"王翰","text":"自信肝肠是铁石，愁来寸寸即成灰。\n西飞白日谁能系，东注黄流可得回。\n造物戏人真窟垒，才名忌我太崔嵬。\n林泉处处埋名了，野鸟岩花劝一杯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14074,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"追和张外史游仙诗五首 其一","author":"余善","text":"鸾书趣燕五城东，下视星辰在半空。\n行过瑶台重回首，玉清更在有无中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14075,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"追和张外史游仙诗五首 其二","author":"余善","text":"城阙芙蓉晓未分，身骑金虎谒元君。\n青童不道天家近，笑指空中五色云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14076,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"追和张外史游仙诗五首 其三","author":"余善","text":"溪头流水泛胡麻，曾折琼林第一花。\n欲识道人藏密处，一壶天地小于瓜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14077,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"追和张外史游仙诗五首 其四","author":"余善","text":"不到麟洲五百年，归来风日尚依然。\n稚龙化作雪衣女，来问东华古玉篇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14078,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"追和张外史游仙诗五首 其五","author":"余善","text":"春宴瑶池日景高，乌纱巾上插仙桃。\n长桑树烂金鸡死，一笑黄尘变海涛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14079,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题顾玉山淡香亭","author":"余善","text":"玉女乘鸾下绛霄，梨云漠漠带香飘。\n帘开淡月香初发，雪满柔条暖未销。\n花下洗妆时载酒，亭前度曲夜吹箫。\n主人爱客情怀好，折简频烦远见招。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14080,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登岱","author":"宋濂","text":"岧峣泰岳拄苍穹，万壑千岩一径通。\n象纬平临青帝观，云光长绕碧霞宫。\n凌晨云漫天涯白，子夜晴摇海日红。\n玉露金茎应咫尺，举头霄汉思偏雄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14081,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"太华","author":"刘基","text":"石屏御道鸟飞回，汉帝亲封玉检来。\n灏气满空清似水，芙蓉直上九天开。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14082,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春江独钓图","author":"倪瓒","text":"春洲菰蒋绿，江水似空虚。\n望山以高咏，意钓不在鱼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14083,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谢笔","author":"倪瓒","text":"陶泓思渴待陈元，对楮先生意未宣。\n何似中书君并至，明窗脱帽一欣然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14084,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠墨生","author":"倪瓒","text":"岩谷春风起，桐花落涧红。\n隔水轻烟发，收煤入灶中。\n豹囊秘元玉，鹅池生白虹。\n汤生法潘谷，千载事同风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14085,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠陶得和制墨","author":"倪瓒","text":"麋胶万杵捣玄霜，螺制初成龙井庄。\n悟得廷圭张遇法，古松烟细色苍苍。\n桐花烟出潘衡后，依旧升龙柳枝瘦。\n请看陶法妙非常，一点浓云琼楮透。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14086,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠沈生卖墨","author":"倪瓒","text":"桐烟墨法后松烟，妙赏坡翁已久传。\n麋角胶清瑩玄玉，龙文刀利淬寒泉。\n山廨唯珍白鹅帖，云窗谁录古苔篇。\n爱尔治生吴市隐，收煤一室数灯然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14087,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠墨生吴善","author":"倪瓒","text":"铜官山下白云亭，涧底长松长茯苓。\n传得潘生烧墨法，墨成持赠写丹经。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14088,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"吴仲圭山水","author":"倪瓒","text":"道人家住梅花村，窗下松醪满石樽。\n醉后挥毫写山色，岚霏云气淡无痕。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14089,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"王叔明画","author":"倪瓒","text":"笔精墨妙王右军，澄怀卧游宗少文。\n王侯笔力能扛鼎，五百年来有此君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14090,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"李伯时画","author":"倪瓒","text":"飞仙游骑龙眠画，貌得形模也自奇。\n句曲真人亲鉴定，不须言下更题诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14091,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为吴溥泉画窠石平远并诗","author":"倪瓒","text":"地僻林深无过客，松门元自不曾关。\n展将一幅溪藤滑，写得溪阴数点山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14092,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"荆溪秋色图为卜震亨题","author":"倪瓒","text":"罨画溪头秋水明，上人逸笔思纵横。\n云山多少元晖句，不道毫端画得成。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14093,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"王都事家听周子奇吹笙","author":"倪瓒","text":"隔水吹笙引凤鸣，十三声外柳风清。\n风流自有王子晋，留取清樽吸月明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14094,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵曹都水","author":"倪瓒","text":"水品茶经手自笺，夜烧绿竹煮山泉。\n莫留樵客看棋局，持斧归来几岁年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14095,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题扇","author":"倪瓒","text":"听雨楼中也自凉，偶停笔砚静焚香。\n君来为煮嵇山茗，自洗冰瓯仔细尝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14096,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵曹都水","author":"倪瓒","text":"萧閒馆里挑灯宿，山罽重敷六尺床。\n隐几翛翛听夜雨，竹林烟羃煮茶香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14097,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵题高斋","author":"无愠","text":"高斋寂寂俯清池，瓦鼎香浮十二时。\n天晓定回松下石，藓痕青上布伽黎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14098,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"龙门茶屋图","author":"倪瓒","text":"龙门秋月影，茶屋白云泉。\n不与世人赏，瑶草自年年。\n上有天池水，松风舞沦涟。\n何当蹑飞凫，去采池中莲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14099,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"村居","author":"倪瓒","text":"疏疏梅雨橘花香，寂寂桐阴研席凉。\n怪底林间金弹子，枇杷都熟不知尝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":14100,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]