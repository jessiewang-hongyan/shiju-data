[{"title":"漫兴四首 其一","author":"王祎","text":"挂网山前秋气深，斜风细雨思难禁。\n清溪曲曲空如画，不状愁人此段心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13221,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴四首 其二","author":"王祎","text":"乾坤氛气日苍黄，南北干戈恣扰攘。\n安得强弓三万手，向空著矢射天狼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13222,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴四首 其三","author":"王祎","text":"常怪栖栖杜少陵，愁篇苦句每相仍。\n只今世故多离乱，欲写艰难愧未能。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13223,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴四首 其四","author":"王祎","text":"天边消息杳无期，独立苍茫有所思。\n总说梅花春意早，几时还到北边枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13224,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄赵子将二首 其一","author":"王祎","text":"又见东风绿柳丝，客怀长是怨春期。\n休文腰瘦成何事，未必风流只为诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13225,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄赵子将二首 其二","author":"王祎","text":"怜君落魄不堪羁，笑我如君不我痴。\n世事只今如戏剧，也甘晦迹向明时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13226,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题宗原常医卷","author":"王祎","text":"传家自有回銮疏，择术深攻素问篇。\n莫道史迁今日少，仓公同传待他年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13227,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题渊明醉像","author":"王祎","text":"彭泽归来纵此身，每从醉里见天真。\n白衣不至浑闲事，自有寻常漉酒巾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13228,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送绶东归十一首 其一","author":"王祎","text":"青岩山下万松青，雨露沾濡岁月经。\n莫遣樵夫来剪伐，严君体魄暂须宁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13229,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送绶东归十一首 其二","author":"王祎","text":"手种堂前宫样梅，燕脂染色瓣重台。\n梅边好献慈亲酒，暖日花容映醉腮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13230,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送绶东归十一首 其三","author":"王祎","text":"旧宅年深县治西，萧条门外带荒蹊。\n喜闻令尹存忠厚，留我梧桐待凤栖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13231,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送绶东归十一首 其四","author":"王祎","text":"文献流风百世师，华川东畔有新祠。\n殷勤为谢同门友，蘋藻时将荐一卮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13232,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送绶东归十一首 其五","author":"王祎","text":"一曲清江一畈田，闲居耕钓足长年。\n庞公城市何尝入，千古令人说隐贤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13233,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送绶东归十一首 其六","author":"王祎","text":"青村地僻稼轩幽，来往过从总白头。\n酒盏诗篇虽不废，已应非复少年游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13234,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送绶东归十一首 其七","author":"王祎","text":"螭陛趋朝星在户，銮坡出直日沉城。\n乡书欲写浑无暇，千里怀思独此情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13235,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送绶东归十一首 其八","author":"王祎","text":"客边别我觉惊心，遗汝囊无一寸金。\n归路迢迢吾颇熟，梦魂随汝到家林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13236,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送绶东归十一首 其九","author":"王祎","text":"吾家十世绍簪缨，愧我才疏似不胜。\n虽是文章无可用，诗书遗绪要相承。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13237,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送绶东归十一首 其十","author":"王祎","text":"多年为客倦驰奔，赖尔艰辛植户门。\n临别欲言无可说，但将甘旨给晨昏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13238,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送绶东归十一首 其十一","author":"王祎","text":"归路钱唐莫久留，西陵渡口趁官舟。\n到家已是将残臈，好会亲邻酒旋篘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13239,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九月八日灞桥戏题","author":"王祎","text":"驴背萧萧帽影偏，斜风落日灞桥边。\n玉堂仙客无人识，谩说当年孟浩然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13240,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客窗","author":"王祎","text":"客窗风雨夜沉沉，形影凄然独拥衾。\n只有青灯如骨肉，寂寥相伴到更深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13241,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宿宁远县道中题田家二首 其一","author":"王祎","text":"门前柳树绿云屯，院里梨花白雪新。\n满目春光谁占得，不应也复有来人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13242,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宿宁远县道中题田家二首 其二","author":"王祎","text":"携妻抱子白头翁，远出城西近坞东。\n却笑长安名利客，半生多在别离中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13243,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"黄河水","author":"王祎","text":"黄河水，西来一折一千里。\n四折东流归渤海，浑涛浊浪深无底。\n旧传一清三千年，圣人乃出天下安。\n河水之清一何少，吁嗟至治何由还。\n我愿河水年年清，圣人在上圣复生，千龄万代长太平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13244,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题九江秀色图","author":"王祎","text":"昔闻庐山谣，今见庐山高。\n庐山之高几万仞，九江秀色不可招。\n山南山北尽佳致，五百僧房密脾缀。\n香炉直削金芙蓉，瀑布长拖青翡翠。\n晴岚暖霭日夕浮，画图彷佛不得求。\n谪仙仙去三千秋，安得起尔从之游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13245,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"五禽言次王季野韵 其二","author":"王祎","text":"提胡芦，劝美酒。\n春风三月满花柳，持此一杯为君寿。\n人生寿命不满百，日过一日真可惜。\n身名倘不立，徒令后人哀。\n不如一饮三百杯，日日不管玉山颓。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13246,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"五禽言次王季野韵 其三","author":"王祎","text":"脱裤脱裤，人情怜新不怜故。\n故裤绵所妆，新裤但裁布。\n薰风四月天微炎，人人著布便脱绵。\n绵裤非不完，失时谁是怜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13247,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"五禽言次王季野韵 其四","author":"王祎","text":"泥滑滑，涂满泥。\n我身两足马四蹄，欲行向前不得驰。\n不得驰，心勿恼，跛鳖也行千里道。\n若教得意早成名，自有青云脚下生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13248,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"青潭山神祠乐歌三首 其一 迎神青潭山","author":"王祎","text":"青潭山，郁崔嵬。\n窟龙蛇，蓄云雷。\n繄灵君，此焉宅。\n欻威棱，霈福泽。\n灵之游，东以西。\n雨裔裔，风凄凄。\n灵之来，霾曀销。\n庆阴阴，烂昭昭。\n灵之旂，翠旄披。\n煜秀华，纷葳蕤。\n灵之车，朱两辀。\n靷文霓，驷苍虬。\n灵之至，形放怫。\n颜如荼，服如绘。\n灵殷殷，蔼缤纷。\n恍兮惚，俨若存。\n澹容与，晻常羊。\n盍其留，享我将。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13249,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"青潭山神祠乐歌三首 其二 享神灵临","author":"王祎","text":"灵既临矣，膋萧载馨。\n灵之格思，鉴我纯诚。\n我酒既酾，其旨百末。\n我牲既副，厥角茧栗。\n侑以音声，函宫吐羽。\n左祝右巫，秩秩咸序。\n备兹嘉荐，有肃其承。\n春祈秋报，熙事迄成。\n我诚孔昭，岂曰惟仪。\n假仪荐诚，灵用宴娭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13250,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"青潭山神祠乐歌三首 其三 送神穹厚","author":"王祎","text":"穹穹厚厚奠高卑。\n高莫可扣卑莫敀，我人中处其俦依。\n匪灵焉依将孰求，我之依灵岂无期。\n春秋祀事粤多仪，灵既享矣不我违。\n嗟我民人苦害灾，灾有扎瘥害旱饥。\n况有干戈横逆加，惟灵威力善拒排，荡涤妖沴臻蕃釐。\n丰年穰穰谷如丘，耄耋稚孩逸以嬉，灵之福我匪我私。\n好生之德体穹示，灵将逝兮不可稽。\n首下居高拜灵旗，千龄万祀灵之思。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13251,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赵将军歌","author":"王祎","text":"赵将军，须髯如画六尺身。\n年未四十勇且仁，不独好武兼好文。\n弓弯乌号满挟月，旗骞大赤高凌云。\n拳毛紫马白玉勒，双脊宝剑青萍纹。\n自从弱冠领戎伍，及此百战成功勋。\n有时闲散即缓带，席上济济延嘉宾。\n月夜投壶翠竹下，风晨垂钓红莲滨。\n谈诗论曲曾不厌，歌声更对蛾眉颦。\n皋兰山下大河上，严城屹立开重闉。\n近控西夏远西域，种杂蕃汉多居民。\n圣皇在御重边面，夷夏一视施威恩。\n将军承诏来坐镇，上体睿意绥远人。\n戎羌酋首咸慕义，奉贽纳款归如奔。\n设施布置未期月，轰轰绩誉遐荒闻。\n岂不见昔时汉家赵充国，金城既守田先屯。\n其策十二务持重，夷裔帖服称如神。\n古今边将推第一，竹帛所载光焞焞。\n将军将军重自爱，太史有笔吾将伸。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13252,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题积庆堂歌","author":"王祎","text":"武川之溪，浙水所发源。\n西流到金华，合为双溪波流益沄沄。\n当其发源处，粤有徐氏居其村。\n渠家奕世尚诗礼，种德植义素以积善闻。\n有弟与昆，有子及孙，一门之内，蔼然若春温。\n世业不陨，善之所积，是乃庆所存。\n试观在昔，或七叶珥貂，或三世列戟，悉由微贱高其门。\n积德所致讵谓无其因，彼有稔奸肆恶乃获尊。\n富安荣者天之未定非天实，薨薨我愿徐氏有引而勿替，百世虽远庆孟敦。\n谓予不信请看武川水，源深流长非可谖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13253,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟唐凯乐歌四首 其一 破阵乐","author":"王祎","text":"惟皇应宝历，受天命以兴。\n赫赫扬神武，隆隆震天声。\n秉黄钺白旄，四征讨不庭。\n蠢彼枭獍徒，屯蜂蚁营营。\n萧斧伐朝菌，一挥不留行。\n大憝既已夷，乾坤永清宁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13254,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟唐凯乐歌四首 其二 应圣期","author":"王祎","text":"千载开昌运，三灵恊睿谟。\n金轮神化衍，玉牒庆源储。\n砺带河山誓，幅员夷夏图。\n大明真普遍，万物尽昭苏。\n制作兴王夏，歌讴属帝虞。\n从此承平后，祯祥纪瑞符。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13255,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟唐凯乐歌四首 其三 贺圣欢","author":"王祎","text":"轩辕垂衣裳，虞庭舞干羽。\n至治一以臻，圣作物斯睹。\n阖辟侔乾坤，经纬用文武。\n濊泽均漏泉，仁风动率土。\n大君德犹龙，群臣拜如虎。\n万岁复千龄，大平亘来古。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13256,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟唐凯乐歌四首 其四 君臣同庆乐","author":"王祎","text":"天地既开泰，君臣咸应期。\n明良元一体，庆乐得同时。\n鱼水情真契，龙云势每随。\n周王资望奭，虞后赖皋夔。\n鼓舞千年运，经营百世基。\n赓歌一堂上，共咏角招诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13257,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"渑池县丞王侯驱虎歌","author":"王祎","text":"渑池之境最多虎，道路行人共愁苦。\n狂风吼怒振尘沙，落日惊魂惨烟雨。\n王侯承诏来作丞，民有创痍手摩抚。\n下车走谒城隍神，亲写文移对神语。\n为言幽显虽有分，我与尔神均守土。\n猛虎今兹实害人，责不在予还在汝。\n早遣恶类离境中，尔神无愧为民主。\n精诚一念既感孚，阴逐潜驱固其所。\n驿使邮夫中夜驰，耕农贾客凌晨聚。\n前时出户即畏涂，今日连村皆按堵。\n童谣籍籍相谓言，孰使吾人乐居处。\n我侯之德与神通，故令孽沴成销沮。\n岂不见古来循吏美迹多，虎有渡江及渡河。\n渑池之事同不磨，王侯王侯奈尔何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13258,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南城曲二首 其一","author":"王祎","text":"素罗束发双髻拖，大红衫子小红靴。\n并马早出南城路，问人杏花多未多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13259,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南城曲二首 其二","author":"王祎","text":"南城杏花如锦红，就花索酒醉春风。\n郎君入儤犹未满，为言归去莫匆匆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13260,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次友人离别曲","author":"王祎","text":"东风吹春满南陌，杨柳青青李花白。\n花柳年年好颜色，妾容已觉今非昔。\n自从结发为君妇，君往长安几寒暑。\n定知时去宿青楼，不似孤闺长夜苦。\n丈夫谩道功名好，不道别离人易老。\n令人却羡田家郎，白头夫妇得成双。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13261,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"荆树曲","author":"王祎","text":"紫荆树，当轩青，众枝只共一本生。\n去年风吹北枝损，憔悴南枝颜色陨。\n北枝今岁喜如前，南枝颜色皆鲜鲜。\n树木无知宁有意，同本故应休戚系。\n君不见桃生路井上，李树生桃旁。\n虫来齧桃根，李树代桃僵。\n桃李异树尚如是，况此一本相连理。\n人皆兄弟无则已，若有还须荆树比。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13262,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"荆门曲","author":"王祎","text":"任城北行三百里，官树如云夹河水。\n树深水浅船行迟，五日才到荆门西。\n荆门津吏不开闸，前船后船似鳞压。\n名驱利逼贪涂程，落月在地登车行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13263,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"东征诗","author":"胡翰","text":"天造草昧，笃生真主。\n暨厥良弼，大启土宇。\n自浙之东，郡邑棋布。\n阻山带川，树屏为固。\n与敌相制，邦之门户。\n匪亲与贤，畴克畀付。\n桓桓我公，两有文武。\n龙节虎符，来自王所。\n坐总省辖，出奠邦土。\n于宣于蕃，孰敢余侮。\n蠢尔张孽，窃活鼎釜。\n以其螳臂，抗我戎辂。\n岁直乙巳，中绳建斗。\n大裒厥凶，罙入我阻。\n偪我新城，摇我黎庶。\n势如累卵，岌其可怖。\n边吏惊告，公起驰赴。\n军于龙潭，栅其高阜。\n辕门方树，士食未饫。\n寇侦我劳，谓可拾取。\n猬兴蜂午，鼎来纵横。\n深绝其涧，高冯其陵。\n有轻我心，不知我劲。\n我用大奋，奋其忠贞。\n师直为壮，彼则何名。\n以少击众，在古可徵。\n爰令众旅，告厥神明。\n愿天保佑，尔众钦承。\n毋利虏获，不竭股肱。\n望其前锋，公则是膺。\n挺身跃马，其扬如鹰。\n如鹰如虎，其徒烝烝。\n如雷如霆，孰震弗崩。\n束戈就殒，投刃乞生。\n倏□纷纭，席卷而平。\n流血殷野，横尸一成。\n匪曰嗜杀，亦岂穷兵。\n寇来授首，惟恶是惩。\n既惩其恶，亦罔不矜。\n亦莫不宁，天开日明。\n衿甲旋旆，肃肃其征。\n椎牛飨士，献俘于廷。\n皇心允怿，是用大赉。\n公走入觐，稽首拜锡。\n明明我皇，制胜万里。\n师力臣武，悉任指使。\n沧海波平，金微道启。\n防风不朝，涂山用入。\n惠迪有庆，从逆自殪。\n公昔受钺，志在敌忾。\n继今以往，尚罔或怠。\n不怠不亟，公心抑抑。\n下民是依，庶士是式。\n为邦柱石，以殿皇国。\n皇国既平，四夷既率。\n公之孙子，与国罔极。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13264,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠郑生叔车","author":"胡翰","text":"游子不顾远，停桡江上春。\n冀方有来客，白发乃吾亲。\n十年阻南北，一见融心神。\n天道谅不慆，嗟嗟行路人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13265,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"狮子林十四首 其一 狮子峰","author":"王彝","text":"昔年清凉山，燄燄金毛赤。\n来此自何年，苍然化为石。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13266,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"狮子林十四首 其二 含晖峰","author":"王彝","text":"凿翠从阳谷，移来佛屋东。\n空嵌才一窦，夜与日华通。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13267,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"狮子林十四首 其三 吐月峰","author":"王彝","text":"势作金蟆立，呀然仰太清。\n每当三五夕，先放半规明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13268,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"狮子林十四首 其四 立玉峰","author":"王彝","text":"昆冈分半股，插地四无邻。\n为有怀中璧，虹光夜夜春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13269,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"狮子林十四首 其五 禅窝","author":"王彝","text":"古屋依青润，袈裟半是苔。\n壁间僧影在，一坐九年来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13270,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"狮子林十四首 其六 翻经台","author":"王彝","text":"云麓最高层，依依月乍升。\n聊因看贝叶，带露一来登。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13271,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"狮子林十四首 其七 小飞虹","author":"王彝","text":"龙影夕连蜷，不饮吴江渚。\n截断涧东天，飞来涧西雨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13272,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"狮子林十四首 其九 立雪堂","author":"王彝","text":"大地寒深处，参师不自知。\n青天还日出，一路见来时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13273,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"狮子林十四首 其十三 玉鉴池","author":"王彝","text":"水清不生萍，况复生鱼子。\n僧面此中看，分明佛光里。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13274,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"狮子林十四首 其十四 冰壶井","author":"王彝","text":"铜瓶百尺下，出甃带微霜。\n注入莲筒去，风吹满寺香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13275,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"癸丑岁十二月初四夜宿狮子林听雨有作","author":"王彝","text":"自是城中寺，却忘身在城。\n俄然万松子，吹作四檐声。\n我欲远尘世，僧多留客情。\n聊因佛灯下，听雨到天明。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13276,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为如海上人题顾定之竹","author":"王彝","text":"老僧出定心逾寂，坐觉谷中繁露滴。\n万响千声自去来，一时月照袈裟白。\n蜿蜒何物向窗飞，分明鼓鬣复扬鬐。\n人间只识仙翁杖，不识降龙出钵时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13277,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春草词","author":"王彝","text":"春草兮青青，罗生兮满庭。\n望王孙兮不归，纷百草兮愁人。\n结幽兰兮佩之，采莫采兮江蓠。\n东风发兮江渚，晞朝暾兮以雨。\n荪亦乐兮有母，日承颜兮堂下。\n把瑶华兮琼英，日方永兮岁未央。\n羌进拜兮羞余觞，春欣欣兮百草生。\n草生兮有心，春复春兮焉穷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13278,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春草堂诗","author":"王彝","text":"几见春风吹草青，一身偏自念初生。\n从今白发应重绿，岁岁春来母子情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13279,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]