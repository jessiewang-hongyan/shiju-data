[{"title":"秋暮会古心上人","author":"王翰","text":"远公与我云间别，几度西风海上秋。\n白发时来还自笑，青山归去与谁游。\n薜萝久负孤灯梦，猿鹤应同两地愁。\n相对空林今夜月，清光迟尔少淹留。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4782,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽子中刘别驾","author":"王翰","text":"刘君自是南州彦，嗜酒吟诗兴独狂。\n不以长鲸浮采石，却缘孤雁没蛮乡。\n经纶事业谁堪拟，金石交情我最伤。\n料尔贤郎多少恨，独收遗骨返衡湘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4783,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚宿杨隑舟中怀鲁客","author":"王翰","text":"萤度星依草，鸥来雪满汀。\n故人不可见，天际乱山青。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4784,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题边道人小景","author":"王翰","text":"扁舟湘浦外，茅屋辋川西。\n冉冉春将尽，沧洲杜若齐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4785,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题溪山风雨图","author":"王翰","text":"紫壑秋声满，沧洲野水深。\n孤篷何处客，相对共沈沈。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4786,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题风竹","author":"王翰","text":"月色不可埽，秋声何处闻。\n不应仙佩集，翠影乱纷纷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4787,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送颜子中使广州","author":"王翰","text":"使君捧檄度南关，远布天威广海间。\n为问故人孙内史，翩翩剑佩几时还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4788,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画葵花","author":"王翰","text":"上苑馀春辇路荒，芳菲落尽更堪伤。\n怜渠自是无情物，犹解倾心向太阳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4789,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄蔡司令 其一","author":"王翰","text":"十年海上旧郎官，白发相期岁欲阑。\n处处风尘犹在目，归来何日共纶竿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4790,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄蔡司令 其二","author":"王翰","text":"别后升沈事几多，故人心事竟如何。\n落花啼鸟春无赖，莫遣风光笑薜萝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4791,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"新春寄鲁客","author":"王翰","text":"雪后梅花几树开，故人忘却剡溪来。\n东风独倚孤舟兴，芳草青青送酒杯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4792,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题边道士小景二首 其一","author":"王翰","text":"碧松阴底大江边，两岸猿声更悄然。\n落日乱云迷远近，无心重理钓鱼船。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4793,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题边道士小景二首 其二","author":"王翰","text":"前山漠漠水迢迢，却倚朱弦思寂寥。\n凤鸟不来春已暮，望将一曲寄虞韶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4794,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题败荷","author":"王翰","text":"曾向西湖载酒归，香风十里弄晴晖。\n芳菲今日凋零尽，却送秋声到客衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4795,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和吴升甫见寄韵二首 其一","author":"王翰","text":"楚泽苍茫带夕晖，暂投簪佩上苔矶。\n孤云不解离情苦，犹自纷纷上客衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4796,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和吴升甫见寄韵二首 其二","author":"王翰","text":"短篱黄菊正苍苍，客路西风两鬓霜。\n谁信义熙年后笔，独能千古吊馀芳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4797,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送陈仲实还潮阳","author":"王翰","text":"十年海上赋离歌，今日临岐奈别何。\n归去故人如有问，春山从此蕨薇多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4798,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题云松野岸","author":"王翰","text":"远山积翠白云多，扬子幽居隐薜萝。\n一径松阴春寂寂，朝来载酒几人过。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4799,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日寄鲁客","author":"王翰","text":"黄花锦树碧江濆，笑把萸杯独忆君。\n日暮西风还落帽，风流那似孟参军。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4800,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄方中上人","author":"王翰","text":"竹径柴扉客过稀，落红满地绿依依。\n怀人独立沧江上，几度扁舟兴尽归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4801,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次居贞见寄韵","author":"王翰","text":"君去溪山趣亦稀，晚来空翠正霏霏。\n多情只有梅花树，满路清香送客归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4802,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画山水","author":"王翰","text":"野竹萧萧一径深，茅斋低结小山阴。\n枫林又逐秋风老，惟有孤云似客心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4803,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"戊申岁间中清赏十景 其三 丽圃横长笛","author":"叶颙","text":"丽圃横长笛，秋风感慨声。\n一吹山石裂，三弄波涛萦。\n江空翠蛟泣，夜静苍龙鸣。\n鹤怨云巢冷，猿啼月岭明。\n嫠妇悲秋泪，孤臣去国情。\n遗音尤激烈，高调转凄清。\n曲终情未尽，目送数峰青。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4804,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"饮马长城窟行","author":"张昱","text":"饮马长城窟，饮多泉脉枯。\n嘶咆不肯行，思若畏前途。\n驱之尚不忍，恻然驻征车。\n朔风当面吹，堕指裂肌肤。\n岂念衣裳单，顾已犹亡夫。\n功名登天然，何时执金吾？\n阴阳无停机，百年谅须臾。\n常恐随物化，奄忽委路隅。\n此怀当告谁，策马自长吁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4805,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古意","author":"张昱","text":"白露积瑶阶，明月生罗帏。\n流光剧奔电，窈窕闭空闺。\n黄金奉桑间，毋乃礼义亏。\n安得廉耻士，再咏关雎诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4806,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂诗二首 其一","author":"张昱","text":"高楼抗浮云，南尽洞庭野。\n凉风飒然至，槁叶凄以下。\n登临极四顾，莫我所思者。\n忧来欲奋飞，羽翼不予假。\n昭质匪金石，流年剧奔马。\n日暮湘水阴，幽兰谩盈把。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4807,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂诗二首 其二","author":"张昱","text":"日月交互行，四时亦云易。\n去时柳未黄，又见枫叶赤。\n人生范围内，生死难固必。\n别离将诉谁，诉之又何益？\n昨宵梦相见，嬿婉如平昔。\n觉来但虚幔，衾枕有馀忆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4808,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"行路难","author":"张昱","text":"鸿雁及秋来，玄鸟先社去。\n俱生亭毒内，羽翼乃不遇。\n翔者不知水，泳者不知山。\n世事每如此，人生行路难。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4809,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"少年行","author":"张昱","text":"看取木槿花，朝荣夕已萎。\n芳容有凋谢，腻泽何所施？\n寿命如可长，仙人今何之？\n高堂有歌舞，及此年少时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4810,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古别离","author":"张昱","text":"阳关古别离，对面折杨柳。\n旋踵委道傍，焉得长在手？\n丈夫四方志，竭力车马走。\n慷慨平生怀，不在然诺后。\n倾资铸宝剑，性命同所有。\n去去勿复陈，黄金印如斗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4811,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古瑟","author":"张昱","text":"锦瑟古之乐，造自轩辕间。\n朱丝五十弦，柱列鹓鹭班。\n中有洞庭水，白日兴波澜。\n人文际昌期，出应清庙弹。\n洋洋雅颂音，一唱而三叹。\n神人既以和，凤鸟翔其翰。\n圣明御天下，百灵咸仰攀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4812,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读离骚经","author":"张昱","text":"三闾楚同姓，怨生于所爱。\n谗人在君侧，绳墨日偭背。\n虞兹宗社陨，繁辞冀收采。\n反覆三致忠，九死犹未悔。\n灵修终不察，遂投汨罗水。\n斯文幸未丧，风雅接三代。\n岂惟南国士，汲汲仰沾溉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4813,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读秦记","author":"张昱","text":"登高望远海，中有三神山。\n秦皇惑方士，采药驻容颜。\n如求不死药，何必波涛间！\n玄牝气孔神，日夜相循环。\n若人善保之，入圣而超凡。\n所以广成子，度世安泥丸。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4814,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"言志","author":"张昱","text":"少小诵六经，中岁始闻道。\n乃知三百篇，不贵辞娟好。\n发言将自宣，犹若未深造。\n尝恐岁年晚，白露先芳草。\n覃恩时窜易，举笔如振槁。\n庶或谐雅音，咏歌以终老。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4815,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"相逢行","author":"张昱","text":"京师众大区，鞍马俱俊游。\n相逢念轻薄，解赠双吴钩。\n性命付然诺，妻子托绸缪。\n朝过狭斜道，暮宿娼家楼。\n五侯与之谈，七贵为之谋。\n心膂誓百年，羽翼期九州。\n当其势合时，喝倒黄河流。\n一朝资用尽，门户无鸣驺。\n乡关耻独归，京邑难久留。\n慨念平生怀，徘徊顾河丘。\n浮云讵终朝，失意将焉尤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4816,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗十四首 其一","author":"张昱","text":"壮哉沛中歌，命世之雄者。\n帝王有大度，不在论风雅。\n绵蕝礼乐修，采诗固无暇。\n苏李离别辞，亦自关教化。\n文章与政通，斯岂杂王霸？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4817,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗十四首 其二","author":"张昱","text":"汉诗十九首，不复辨名氏。\n苏李及枚乘，伯仲之间耳。\n当时尚词赋，六义谁作意？\n虽非大雅言，颇有风人致。\n篇章何在多，自足传于世。\n所嗟黄初后，作者莫与企。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4818,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗十四首 其三","author":"张昱","text":"曹公英雄姿，吐词自天成。\n横槊鞍马间，慷慨念平生。\n汝颍诸文学，敛衽奉明廷。\n对酒惜时迈，载歌伸鹿呜。\n风云入壮怀，河山助威灵。\n至今邺下唱，犹擅文章名。\n铜雀有遗憾，哀哉短歌行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4819,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗十四首 其四","author":"张昱","text":"邺中盛文词，七子相掎角。\n虽膺丞相辟，未免伤流落。\n世胄相友善，宴好以酬酢。\n出纳结腹心，庶僚仰殊渥。\n愿因云雨会，戢翼永栖托。\n贵贱俱黄土，徒存建安作。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4820,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗十四首 其五","author":"张昱","text":"魏文在世子，嗣领五官将。\n国事既有闲，经术尤所尚。\n宴游集文学，词藻咸宗仰。\n五星垂光彩，两曜分气象。\n风流积二世，况复人君量。\n快乐芙蓉池，乘辇一何壮！\n宁同汝颍士，戚戚冀所望。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4821,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗十四首 其六","author":"张昱","text":"东阿帝室亲，复乃贵介弟。\n降志词翰间，国事罔所冀。\n思深而文典，光彩照当世。\n切切陈自劾，捐躯以明志。\n淫情洛神赋，所愿以自弃。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4822,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗十四首 其七","author":"张昱","text":"祢衡轻狡人，况以才自负。\n将赴渔阳挝，侮人还自侮。\n曹公岂容物，嫁恶与黄祖。\n值兹劻勷际，焉用鹦鹉赋？\n所以贤达士，贵在识时务。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4823,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗十四首 其八","author":"张昱","text":"三谢国亲臣，世家金闺彦。\n玄谈虽时尚，好爵尤所羡。\n出各领名郡，而不拘履践。\n能忘永嘉乐，山水事游宴。\n摛章固自美，雅音从此变。\n馀波及齐梁，纤秾入哀怨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4824,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗十四首 其九","author":"张昱","text":"嗣宗绝臧否，善若处时晦。\n咏怀数十篇，卓尔追汉魏。\n驾车哭而返，此岂无所谓？\n啸登广武台，神气偶相会。\n从来倜傥心，土苴视富贵。\n惟有步兵厨，可用时一醉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4825,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗十四首 其十","author":"张昱","text":"渊明君子儒，心事甚夷旷。\n醉来得佳眠，自谓羲皇上。\n文章固可诵，节概尤所仰。\n且无州县拘，安得言不放？\n托志圣贤录，千载成绝响。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4826,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗十四首 其十一","author":"张昱","text":"高人王右丞，辋川亦有乐。\n位居尚书省，志不异丘壑。\n谁言肉食鄙，而不事淡泊。\n辞擅大雅名，集多应制作。\n唐音得所宗，夫子实先觉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4827,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗十四首 其十二","author":"张昱","text":"工部行在官，饥寒莫与比。\n奔走盗贼中，朝夕命如寄。\n一饭不忘君，危言以鸣世。\n亲蒙万乘知，不救妻子累。\n文章天地间，风雅可无愧。\n赋者谩接迹，此作竟谁继？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4828,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗十四首 其十三","author":"张昱","text":"襄阳孟浩然，五言擅时誉。\n迹放羁旅间，气藉江山助。\n感怀岘山作，托兴洞庭赋。\n九重获见知，一语乃上忤。\n敝庐南山归，亦足蔽风雨。\n篇章如可传，论何遇不遇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4829,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古诗十四首 其十四","author":"张昱","text":"苏州韦刺史，早事武皇帝。\n既蒙南宫录，复膺符竹寄。\n折节就绳墨，检身勤治理。\n赋诗长日静，铃閤馀香至。\n晚逢杨开府，感激道所以。\n宜尔金玉音，风雅存遗制。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4830,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"鸳鸯篇","author":"张昱","text":"鸳鸯水中禽，居常有定偶。\n行则共洲渚，栖不异渊薮。\n交颈情所私，和鸣气相友。\n白头不自嫌，彩翼戢左右。\n雄雌或失配，霜霰甘独守。\n嗟哉羽毛类，赋性乃何厚！\n愿献金闺女，绣作君子绶。\n人或违天常，翻为此禽丑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4831,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽兰篇","author":"张昱","text":"幽兰不自媚，丛杂生溪涧。\n寂寞空林色，过者谁复玩？\n及时或见收，不与众芳乱。\n梦协天使与，握勤郎官盼。\n顾兹馨香德，庶以同岁晏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4832,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闺思篇","author":"张昱","text":"连日洲渚上，香风吹杜若。\n闺人念离别，远思生帷薄。\n去年执手时，记省采兰约。\n如何雁鸿迹，遽尔成绵邈。\n将凭梦中见，反侧睡难著。\n起视东西厢，众星已寥落。\n晨鸡方再鸣，曙色已东作。\n安得携手人，归来共春酌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4833,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丹华篇","author":"张昱","text":"修茎冒丹华，碧叶相掩映。\n晨露发其枝，举世莫与并。\n微风波上来，绰约有馀韵。\n相看咫尺地，人远河汉近。\n绿房多苦心，伫立秋塘暝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4834,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"美女篇","author":"张昱","text":"燕赵有美女，红莲映绿荷。\n佩环彫夜玉，团扇画春罗。\n流盼星光动，曳裾云气多。\n回车南陌上，谁不驻鸣珂？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4835,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"松涛轩","author":"张昱","text":"松声学海涛，汹汹不可息。\n如驱万山泉，迸落千丈石。\n浩然入清听，心与境为一。\n焉知咸阳道，车马走赤日。\n大哉利名事，静者梦不及。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4836,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"三良诗","author":"张昱","text":"百岁谁免死，贵足留其名。\n三良殉秦穆，慷慨平生情。\n一诺奉明主，千秋共哀荣。\n从容就长夜，斯人岂偏生？\n所以黄鸟诗，至今颂遗声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4837,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"班婕妤","author":"张昱","text":"婕妤辞辇时，风谊动宫阙。\n后来纨扇咏，词气何凄屑！\n妇人何所恃，所恃惟姿色。\n过时而色衰，枕席成弃物。\n不见长信宫，苔生玉阶侧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4838,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"一脉泉铭，为中一元禅师作","author":"张昱","text":"天地不自私，至宝发山川。\n谁于黄金岩，得此一脉泉？\n涓涓成不息，曹溪宁后先？\n造化亦有待，于师亦前缘。\n既供香积厨，复灌富阳田。\n譬彼释氏法，一灯遍三千。\n泉流愿无竭，灯光永相传。\n日居而月诸，于亿万斯年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4839,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送薛山人归富春","author":"张昱","text":"旧识谈天叟，挑囊又赋归。\n性谐麋鹿友，身老薜萝衣。\n高步云同举，潜形鹤自飞。\n清醪香泼瓮，黄绢织成机。\n生事有绳准，清言无是非。\n勿矜弦上操，若听古人稀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4840,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠孙雷师祈雨有应","author":"张昱","text":"天人本无二，万物备吾身。\n一诚苟无妄，呼吸皆鬼神。\n南邦五六月，熯阳如火燉。\n法师念民食，升坛肆怒嗔。\n符召五雷伏，龙起三江滨。\n风云随指顾，沛泽来逡巡。\n岂惟盈沟浍，更且溢河津。\n道路接歌颂，田家具仓囷。\n茫茫大钧内，造化岂不仁？\n安得法师辈，飞行遍八垠。\n以兹云霓心，慰彼大旱民。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4841,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拙逸诗","author":"张昱","text":"守拙中乃逸，用智机或生。\n所以抱真士，泯焉黜聪明。\n卖药不二价，悬壶无姓名。\n逍遥城市间，心与造物并。\n鹤长断则悲，凫短续则惊。\n万物有常性，巧伪非人情。\n乘黄一剪拂，千里无留行。\n贤哉拙逸翁，可以为世程。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4842,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"从军行","author":"张昱","text":"一身既从军，宁复顾家室？\n日食官仓粮，惟知事行役。\n昨朝号令下，负弩趋大碛。\n驱车出城去，旌麾耀白日。\n男儿重横行，万乘假羽翼。\n意气从中来，性命何所惜？\n雕鸣沙塞雨，四面无马迹。\n不有封侯贵，班超肯投笔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4843,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]