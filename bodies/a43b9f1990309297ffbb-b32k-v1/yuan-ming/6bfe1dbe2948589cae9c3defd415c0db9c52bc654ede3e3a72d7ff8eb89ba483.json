[{"title":"二月初晴题淦西居人楼壁","author":"郭钰","text":"老去才名久退潜，楼前晴景逐人添。\n云连野树深藏径，风捲溪花乱入帘。\n远信忽传闽徼外，閒愁尽挂楚山尖。\n春光流转曾相识，独怪经年雪满髯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6693,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"三月十三日夜宿淦西山绝顶","author":"郭钰","text":"夜登绝顶几千尺，临晓始知归路遥。\n水满大江舟窅窅，尘飞客路马萧萧。\n山河势窄如悬网，云汉光低不作桥。\n十二年间多少恨，春来不共冻痕消。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6694,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀罗达则","author":"郭钰","text":"溪山杖屦每相违，况复经年去不归。\n移席花间春雨至，倚楼江上暮云飞。\n乡书到手兼悲喜，世事关心有是非。\n池上祇今新绿满，待君同制芰荷衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6695,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄刘伯贞","author":"郭钰","text":"山中长日倦题诗，偶望乡关有所思。\n飞雨忽随龙去远，閒云独伴鹤归迟。\n度溪风剪松花落，绕径篱分野蔓垂。\n遥想西楼今夜月，玉人正是醉吟时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6696,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"六月初十日客馆披凉寄伯刚文学盖伤于处者也","author":"郭钰","text":"君王无复问南州，贱子何能恋敝裘。\n菡萏风清长日度，梧桐雨冷晚秋愁。\n一穷到骨更何有，万事伤心不自由。\n避地惟应蓬岛去，羽轮人世向谁投。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6697,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄胡湜伯清兼柬周子谅","author":"郭钰","text":"积雨初晴绿涨溪，溪花飞舞屋东西。\n鸟衔朱果珊瑚碎，竹放青梢翡翠迷。\n池上酒杯无俗客，壁间诗句有新题。\n结庐不用云深处，门闭惟闻过马嘶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6698,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠卖卜雁明信","author":"郭钰","text":"忆自成都失老严，一年心事向谁占。\n谋身每信黄裳吉，涉世空嗟白发添。\n太古图书含变化，后来象数极窥觇。\n闻君讲易长无倦，客散中庭月满帘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6699,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九月兵至桐江馆人死李攴麟以诗相吊故复和之二首 其一","author":"郭钰","text":"江水滔滔流恨长，交亲十载顿云亡。\n空村烟雨豺狼满，老圃风霜松菊荒。\n漉酒陶巾犹在手，招魂楚些恶成章。\n论交不使逢知己，敝帚千金祗自伤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6700,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九月兵至桐江馆人死李攴麟以诗相吊故复和之二首 其二","author":"郭钰","text":"白发山翁最好文，昨朝杯酒死生分。\n可怜耆旧多新鬼，未必臣民负圣君。\n鹤语谩传辽海树，龙文长想砀山云。\n扶危实藉英雄士，马上相期早策勋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6701,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"对雪怀郭顺则","author":"郭钰","text":"寒压貂裘曙色微，水村山郭远涵晖。\n琼田万鹤凌风舞，玉女千花绕座飞。\n勋业平淮碑石在，风流访戴酒船归。\n想君怀古偏多感，肯使缁尘涴素衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6702,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"旅馆怀旧","author":"郭钰","text":"天涯剪纸赋招魂，寂寞空斋昼掩门。\n春燕同来人事改，夜灯相对语音存。\n松花满地閒棋局，薜叶经年上石墩。\n岂是老怀多感激，百年交谊共谁论。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6703,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题边少府权诗集","author":"郭钰","text":"君才浩荡涨溟波，燕赵论文俊杰多。\n枕上闻鸡先起舞，花前把酒独长哦。\n汉皇不识神仙尉，苏子偶逢春梦婆。\n志士百年名节重，一蓑且复卧烟萝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6704,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"暮春顺则宅宴集和罗国芳韵","author":"郭钰","text":"千尺苍松锁翠岩，两竿初日射晴岚。\n山人结屋深相对，词客过门得共谈。\n酒送馀春杯满百，月明归路影成三。\n暂时相赏摅怀抱，莫诉边城野战酣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6705,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋日","author":"郭钰","text":"江上秋风吹布袍，满林败叶暮萧骚。\n云沈雁信人千里，雨荅蛩声客二毛。\n汗马功名知命薄，蠹鱼文字漫心劳。\n十年辛苦成何事，赢得一贫声价高。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6706,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"哭边权少府（新淦边权尉六合兵乱弃官归去年始与余缔交甚相亲未几避地渝上适与馆人难死焉）","author":"郭钰","text":"往年把酒楚山秋，叹息相逢总白头。\n梅福吴门闻久去，祢衡江夏为谁留。\n血凝塞壁精灵在，气贯晴虹魑魅愁。\n乡国衣冠转憔悴，招魂何处泪空流。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6707,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"曹居贞先生求挽诗","author":"郭钰","text":"老子悬车尚黑头，中堂进士晋风流。\n延年好待桃千树，观化深知貉一丘。\n墓碣自题成早计，儒冠不改配前修。\n郎君爱日情如海，春满觥船任拍浮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6708,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"简罗伯英","author":"郭钰","text":"大药霜髭竟不玄，白鱼无计满千仙。\n别离岁月落花雨，歌舞楼台芳草烟。\n世事荣枯分一日，人生感慨萃中年。\n刘郎恨满玄都观，重到题诗共几篇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6709,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"乙巳夏五月茶陵永新兵奄至遂走淦西暑雨涉旬米薪俱乏旅途苦甚因赋诗示诸同行","author":"郭钰","text":"白发遗民真可哀，途穷犹望北兵来。\n关河割据将成谶，将相经纶岂乏材。\n足茧荒山走风雨，腹饥深夜吼春雷。\n主翁清晓催人发，又报烽烟逼楚台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6710,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重题禅寂院","author":"郭钰","text":"诗苦穷人人苦吟，偶随名胜到丛林。\n画龙点眼先飞去，咏凤求毛不用寻。\n豪客尚能知李涉，奸雄终不弃陈琳。\n文章得意无今古，让与笼纱照碧岑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6711,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丙午元旦晴而复雨忆诸弟俱留于外情见乎辞","author":"郭钰","text":"父老新年卜晓晴，桃花春色照岩扃。\n洗兵不厌东风雨，恋阙长瞻北极星。\n棠棣有诗空讽咏，屠苏无酒自清醒。\n挥毫对客书桃板，白发添多眼独青。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6712,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄张九成（不饮酒而多符卫）","author":"郭钰","text":"山馆闻君足自娱，赋诗近日与谁俱。\n树侵钓石斜倾盖，雨定游丝小贯珠。\n客主长年存醴酒，鬼神清夜捧阴符。\n溪边旧约何时到，愁绝天涯一字无。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6713,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄宋竹坡","author":"郭钰","text":"久欲从君借竹看，东风又长碧琅玕。\n午阴坐久晴云落，夜漏眠迟白露漙。\n韭叶连畦从料理，菊花分径共平安。\n洞箫一曲裁新管，石上双吹翠袖寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6714,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻郭怡有诗未及见因赋此以寄恨","author":"郭钰","text":"一襟老泪点苍苔，谁信愁肠日九回。\n豪杰虚名多自误，弟兄急难竟谁来。\n桥分溪路桃花落，门闭山房燕语哀。\n祸福情知相倚伏，浮云蔽日几时开。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6715,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和宋竹坡见寄","author":"郭钰","text":"闻君近住崆峒下，俗客不来长闭关。\n得句遍题青竹上，寄书曾到白云间。\n微风欹枕茶烟散，晴日捲帘花意閒。\n旧约许寻须候我，月明骑鹤过南山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6716,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和杨茂才閒居","author":"郭钰","text":"板桥通径薜萝深，浓翠浮衣竹十寻。\n啼鸟渐驯时近客，归云不动似知心。\n剪苔盘石移棋局，添火香篝续水沈。\n赋笔惟应潘岳好，恨无樽酒与同斟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6717,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丁未人日","author":"郭钰","text":"误喜新年七日晴，黑光荡日更分明。\n阴阳元自相消长，夷夏何能息战争。\n高视山河分王气，不知金石载虚名。\n曲生废痼交情绝，看遍梅花晚独行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6718,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和杨和吉二首 其一","author":"郭钰","text":"读书头白苦无多，自判才名易灭磨。\n耆旧凋零霜后木，世情翻覆雨中荷。\n数家烟火惟闻哭，三月莺花谁复歌。\n薜荔绕垣茅屋小，缘君开径日相过。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6719,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和杨和吉二首 其二","author":"郭钰","text":"海棠雨外半含啼，病起吟情懒更题。\n匹马看花空老大，还山采药自幽栖。\n欲寻仙馆窥丹鼎，曾借渔舟度碧溪。\n门巷总非初到日，渚蒲汀柳望都迷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6720,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"三月十六日访宋竹坡不遇","author":"郭钰","text":"门巷春阴绿树遮，重来不省是君家。\n云封山馆半帘雨，水泛溪流万片花。\n王戴风流成故事，吴张图画动中华。\n小童报主须留客，汤沸铜瓶旋煮茶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6721,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和周恺并忆元达诗（元达名浩余同宗又尝同砚席丙午卒于溧水）","author":"郭钰","text":"一望吴山一断魂，眼枯双泪出还吞。\n青云事业终何补，白首交游不忍言。\n旧馆空怀风雨夕，新阡遥隔水云村。\n谢池春草山阳笛，未卜他生得共论。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6722,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠戴医","author":"郭钰","text":"旧约寻真海上山，相逢长有好容颜。\n一池伏火烧丹熟，两袖晴云采药还。\n坐遣呻吟成笑语，久?名利换清閒。\n顶门欲试金针妙，白发青灯我最顽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6723,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和周子恺中秋感怀见寄","author":"郭钰","text":"樽前旧事逐飘风，赢得衰年两鬓蓬。\n病骨五更秋气入，佳期千里月光同。\n乡关高兴鲈堪鲙，江海脩程燕避鸿。\n昨夜桂林重对酒，看花双眼雾濛濛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6724,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"云屋为龙叔起赋","author":"郭钰","text":"挂冠归去云为屋，又似鸿濛未判初。\n竹送清阴随杖屦，窗涵微润入图书。\n闻鸡疑与仙家近，放雁多令旧客疏。\n何事划开天宇净，醉攀明月抱清虚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6725,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客馆书怀","author":"郭钰","text":"晓镜形容暮不同，控抟人事更匆匆。\n端相旧垒去年燕，断送残花昨夜风。\n易播共怜交谊重，依刘宁为旅途穷。\n世情近日皆非旧，始悟相逢是梦中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6726,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春望（戊申年间作）","author":"郭钰","text":"饥乌磔磔伴啼鸦，倦倚东风两鬓华。\n避地每如巢幕燕，论交谁辨酒杯蛇。\n云遮望眼迷芳草，雨动离愁怨落花。\n怀抱一时何处写，瓮头春酒不须赊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6727,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答杨和吉韵","author":"郭钰","text":"白发侵寻暮景来，扫除无策覆空杯。\n江山每与愁俱到，风雨不知花尽开。\n往事漫存元祐迹，少年何羡洛阳才。\n惟君于我过从近，稚子朝朝扫绿苔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6728,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"郭尊师至安堂","author":"郭钰","text":"道人极目立苍茫，叹息红尘去路长。\n车折秦关投虎口，马窥蜀栈战羊肠。\n海天鹤送仙书到，石洞花分春酒香。\n寄语往来名利客，不如学道至安堂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6729,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"代赠峡江王巡检","author":"郭钰","text":"将军仗节镇巴邱，虎豹深藏山水幽。\n草露洲长朝试马，柳风波细晚回舟。\n岳飞曾作千夫长，李广终期万户侯。\n且访南邻读书客，论诗说剑自风流。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6730,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"访友人别墅","author":"郭钰","text":"阴森万木晓苍茫，路转山腰问草堂。\n池涌慢波萍叶散，窗涵细雨橘花香。\n读书程度输年少，中酒心情厌日长。\n公子飘飘才思阔，何妨高咏伴沧浪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6731,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"刘润芳驯雉助祭图","author":"郭钰","text":"扫叶秋风宰树寒，顿令驯雉识衣冠。\n孝心冥感飞相近，礼数今存留独看。\n人散应同翁仲语，地灵长羡子孙安。\n红翎翠羽开图画，我亦缘君激肺肝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6732,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"代赠","author":"郭钰","text":"诏颁大邑县符新，君领除书第一人。\n圣代祗今更治化，大贤于此展经纶。\n信臣宽厚恩如父，黄霸严明政有神。\n气转洪钧生意早，棠梨花发满城春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6733,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送李子高游金陵","author":"郭钰","text":"吴中八绝冠群材，楚楚芳年君又来。\n得酒醉飞鹦鹉盏，题诗先到凤凰台。\n天回北斗星辰近，地尽南郊道路开。\n信是皇州春色早，好将红杏倚云栽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6734,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送刘叔亮兵后归清江","author":"郭钰","text":"风尘荏苒鬓毛斑，乡梦无时到故山。\n去国每怜王粲老，携家今见管宁还。\n松深先陇寒烟外，草满荒庭夕照间。\n不用人间多感慨，梅花春色破愁颜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6735,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送费吉水","author":"郭钰","text":"五马遥临白鹭洲，光荣全胜古诸侯。\n满城秋雨闻弦诵，夹道春风露冕旒。\n东观天高鳷鹊并，中台地回凤凰游。\n归朝明日承恩早，玉笋催班第一流。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6736,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"己酉元日","author":"郭钰","text":"往事悠悠不足论，细看桃板旧题存。\n青山树绕千年屋，白发人看五世孙。\n侧注晓容惊破帽，屠苏春色醉深尊。\n归云更是无心者，借我长封谷口门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6737,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送孔贯道应贤良徵辟就谒孔林","author":"郭钰","text":"诏下江南选俊良，君行千里似还乡。\n淮河天近鱼龙会，阙里春回草树香。\n一代又论新礼乐，千年仍睹旧宫墙。\n仲舒三策陈王道，文献承家好激昂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6738,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和胡济见寄","author":"郭钰","text":"雨后溪云冉冉生，夕阳蛛网一丝晴。\n山环老屋杉松合，水满平田鹅鸭鸣。\n老去客程凭酒力，愁边春色减诗情。\n文章伯仲真吾友，莫怪儿童不识名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6739,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和李士周韵","author":"郭钰","text":"春云乘雨午桥阴，病眼看花负夙心。\n汉水尽堪添绿酒，燕台何得筑黄金。\n手攀杨柳曾亲种，路出桃源不易寻。\n毕竟知音眼前少，尘埃三尺暗桐琴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6740,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄李亨衢","author":"郭钰","text":"君住仙坛归路遥，人间尘虑尽冰消。\n微风半脱乌纱帽，明月閒吹紫玉箫。\n出水芙蓉鸣翡翠，绕墙薜荔护芭蕉。\n日长应共罗浮客，时复松花酒一瓢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6741,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠驿吏","author":"郭钰","text":"筮仕何论占甲科，独君于此阅人多。\n海舟夜泊藩臣至，官马晨嘶天使过。\n微禄暂能淹岁月，好音原不阻关河。\n时来得遇怜才者，早振朝衣上禁坡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6742,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题安乐何心淳草堂旧隐","author":"郭钰","text":"草亭亭上旧曾邀，窗户凭高结构牢。\n浓翠入帘春雨竹，乱红飘席晓风桃。\n功名前辈遗鸿爪，文采诸孙有凤毛。\n万事目前无所与，惟应对客醉挥毫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6743,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠金守正","author":"郭钰","text":"六月松阴坐紫苔，得书顿使好怀开。\n离愁百斛如云散，凉意一襟随雨来。\n玉笥天清长在望，金洲春尽每思回。\n高怀又作秋风约，不限金钱问酒杯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6744,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"荅张九成韵","author":"郭钰","text":"自信功名骨相寒，西风长笑倚阑干。\n醉刘不用携长锸，盲夏惟应著小冠。\n远寄高吟谐律吕，何由并驾接和鸾。\n楚山归鸟怜毛羽，栖息一枝何处安。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6745,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠别宋仲观","author":"郭钰","text":"梅花江上雪意残，独行远道何当还。\n大江风微五两静，虚馆日高双陆閒。\n十载论交倾意气，一朝送别凋容颜。\n坐歌激烈我何有，明日射虎归南山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6746,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和酬宋竹坡韵","author":"郭钰","text":"寄诗问我山中事，性懒家贫一事无。\n春瓮酒香梅未落，午窗梦起鸟相呼。\n旧来叔夜交游绝，老去文通笔砚枯。\n鸥社共盟君未弃，何须驰志向伊吾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6747,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和酬李潜","author":"郭钰","text":"世路邅回暮景移，老怀无托废题诗。\n朱颜弃我辞杯满，青眼看书下笔奇。\n雨暝茶烟侵竹润，春寒香雾出帘迟。\n地偏每恨交游少，何日能来慰所思。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6748,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和酬黄用泰","author":"郭钰","text":"思君不见待君吟，何许蓬莱闻妙音。\n孙绰遂初先作赋，苏秦未遇晚多金。\n閒看归鸟暮云合，欲渡沧江春水深。\n惟向层楼穷望眼，可能无策刬西岑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6749,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和袁寅亮进士见寄","author":"郭钰","text":"白发禁春愁奈何，当年只合卧烟萝。\n山中老屋归来早，扇外飞尘感慨多。\n意薄功名随梦散，交游道谊自心和。\n两君文采真连璧，枯槁长怀挹楚波。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6750,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"得月楼为陈与京赋（陈赘刘）","author":"郭钰","text":"得月楼前春水宽，玻璃万顷接阑干。\n光涵银汉虹桥迥，影动金波贝阙寒。\n绿酒千钟人上鹤，紫箫一曲女乘鸾。\n遥知贰馆还相近，玉臂清辉好共看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6751,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和彭允迪见寄","author":"郭钰","text":"佳句闻君胜旧时，珊瑚出海玉交枝。\n十年客路迷陈迹，千里云山系所思。\n囊罄黄金难得酒，窗添青竹倦题诗。\n近年转向世情薄，晴日沧江理钓丝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6752,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]