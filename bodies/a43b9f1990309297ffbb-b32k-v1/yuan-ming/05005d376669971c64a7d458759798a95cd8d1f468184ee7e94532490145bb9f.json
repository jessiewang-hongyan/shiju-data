[{"title":"秋日和韵","author":"朱希晦","text":"溪上危峰乱插空，雨晴苍翠尚濛濛。\n不堪昨夜西风急，吹落半庭霜叶红。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12735,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次御史端公游箫台韵","author":"朱希晦","text":"烟锁千峰紫翠层，隔溪幽鸟语相应。\n碧桃花谢玉芝老，不见神仙只见僧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12736,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄友","author":"朱希晦","text":"不道愁中生白发，也知客里对黄花。\n凄凉正是陶元亮，有酒无钱何处赊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12737,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"戏简叔向陈先生朋南阮君","author":"朱希晦","text":"名动竹林惟阮籍，气吞湖海有元龙。\n相逢一醉思茗饮，细故不留云梦胸。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12738,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"酬李适庵","author":"朱希晦","text":"谩笑人生有底忙，读书坚坐白云房。\n孙阳未遇骐麟老，空厄盐车太上行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12739,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"酬间上人","author":"朱希晦","text":"潮退沧江露石矶，生缘千古一天衣。\n葛藤牙蘖依前长，影落长空寒雁归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12740,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和槐堂李先生韵 其一","author":"朱希晦","text":"人生离别将奈何，沧江渺渺山峨峨。\n山花乱红江水碧，水流花谢春愁多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12741,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和槐堂李先生韵 其二","author":"朱希晦","text":"江山有待故人来，好向春风酌绿醅。\n啼鸟声中春烂漫，雨香昨夜碧桃开。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12742,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"喜雨","author":"朱希晦","text":"稻田渴水十日晴，水车踏转如雷鸣。\n老夫中夜喜不极，睡觉枕前闻雨声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12743,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和赵翰林韵","author":"朱希晦","text":"脱却春衫换酒来，深杯劝客壮怀开。\n生前万事不如醉，落日乌啼金粟堆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12744,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和谢玉堂归老赵修撰","author":"朱希晦","text":"佳客乘閒访隐居，旋沽村酒鲙溪鱼。\n灯前忽忆十年事，留宿壶山夜读书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12745,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"用赵修撰先生韵","author":"朱希晦","text":"结屋山中远市嚣，雨馀荒径长蓬蒿。\n平生身外无他事，劝客尊前有浊醪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12746,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夏日山居","author":"朱希晦","text":"九衢赫赫涨尘埃，车马憧憧自往来。\n争似山人忘世念，枕书高卧竹扉开。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12747,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄天则上人","author":"朱希晦","text":"老年衰病药相扶，岂有神仙碧玉壶。\n睡起不知春雨过，半畦佳菊没榛芜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12748,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次回峰西堂韵","author":"朱希晦","text":"孤云无住亦无依，长向空中自在飞。\n情素本来无一物，何须惜别更留衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12749,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日有怀","author":"朱希晦","text":"无边花柳竞芳春，醉眼看来几度新。\n今日曲江风景别，落红飞絮正愁人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12750,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次回峰韵","author":"朱希晦","text":"煖日浮烟翠欲消，四山空寂境萧条。\n饱参禅老庭前柏，不问刘郎观里桃。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12751,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"净名寺","author":"朱希晦","text":"才入清凉境，凭高意豁然。\n山横烟簇簇，溜滴雨涓涓。\n静坐维摩室，微参达磨禅。\n秦名人已远，遗像阅千年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12752,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄无际老禅","author":"朱希晦","text":"万事不挂服，把茅还盖头。\n林深从鹿卧，海阔任鸥浮。\n圆泽三生契，曹溪一宿留。\n我牵尘业在，衰白总成休。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12753,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"失雁","author":"朱希晦","text":"畜尔经年久，悬知羽翮长。\n别来应念侣，秋至忽南翔。\n遽欲摩云汉，能无恋稻粱。\n更防机事密，罗网不虚张。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12754,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋日咏怀 其一","author":"朱希晦","text":"老作衡门士，长思栗里翁。\n鬓添今日白，颜减向时红。\n满地蒺藜雨，一天鸿雁风。\n伤心看江水，日夜只流东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12755,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋日咏怀 其二","author":"朱希晦","text":"天地一今古，江山几别离。\n浮云苍狗变，急景白驹驰。\n老去犹诗律，忧来更酒卮。\n自从弦绝后，无复觅钟期。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12756,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感秋","author":"朱希晦","text":"时光随过鸟，身世寄蜉蝣。\n漠漠江云晚，萧萧塞雨秋。\n杜陵长恋阙，王粲独登楼。\n故国今戎马，南征尚未休。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12757,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"轩居","author":"朱希晦","text":"何处净芳襟，晴轩俯碧岑。\n钩帘赊月色，隐几快人心。\n世道有荣辱，云山无古今。\n吾生何太晚，侧耳听虞琴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12758,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"伤时","author":"朱希晦","text":"叹息王纲废，由来战伐频。\n周墟半禾黍，秦籍总灰尘。\n凤去云霄暮，鸡鸣风雨晨。\n至今流渭水，空忆钓鱼人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12759,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日自况","author":"朱希晦","text":"江边雨初过，正是踏青时。\n载酒兴不浅，杖藜行较迟。\n日阴团碧树，风煖韵黄鹂。\n与客恣游赏，醉来还赋诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12760,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"期倪从事不至用韵以寄","author":"朱希晦","text":"天地双蓬鬓，江湖一酒杯。\n不因佳客至，争得好怀开。\n拄颊看山坐，登楼待月来。\n黎明还送别，歌罢重徘徊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12761,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵答李适庵","author":"朱希晦","text":"泛渚轻鸥并，啼霜旅雁孤。\n池幽心自佚，路险意何须。\n兰茝香堪佩，茅茨细可诛。\n荣名安足羡，耕钓乃吾徒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12762,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答李广文","author":"朱希晦","text":"不有封侯相，安能食肉飞。\n溪山犹发兴，鱼鸟自忘机。\n曳杖看云去，褰衣步月归。\n骊珠忽在手，怪底吐光辉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12763,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵答友","author":"朱希晦","text":"天地等逆旅，利名俱恼人。\n蓬莱三万里，庄木八千春。\n白积巾中雪，红飞陌上尘。\n人生行乐耳，杖履素相亲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12764,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵答叔向陈君","author":"朱希晦","text":"之子当时杰，人中见不多。\n豫章蟠厚地，砥柱障狂波。\n富贵须行乐，栖迟足啸歌。\n相逢尊有酒，莫惜饮如何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12765,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵怀友","author":"朱希晦","text":"江山供远眺，万景倍凄清。\n烟树连秋色，霜钟报晓晴。\n忧时双鬓改，恋阙寸心明。\n谁识杜陵老，长吟涕泗倾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12766,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫兴偶成","author":"朱希晦","text":"扰扰贪名者，驱驰易白头。\n江山长不改，岁月急如流。\n且尽一尊酒，共消千古愁。\n可怜金谷废，人去月当楼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12767,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"写怀","author":"朱希晦","text":"试拂青萍剑，频衔白玉杯。\n容颜不再好，笑口几时开。\n水满鱼儿出，泥香燕子来。\n江山千古意，临眺重徘徊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12768,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"约友","author":"朱希晦","text":"川岳自今古，阴阳相主宾。\n红尘纷野马，白日少间人。\n忽忽身将老，欣欣物自春。\n相知有朋旧，簪盍莫辞频。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12769,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"简雪心安上人","author":"朱希晦","text":"意行无远近，得得扣柴扉。\n鼎出金芽细，盘堆紫蕨肥。\n看云忘世虑，指日悟禅机。\n错比陶元亮，重来尽醉归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12770,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"简叔恭蔡先生","author":"朱希晦","text":"举世纷谗舌，锋芒不可干。\n驱车嗤阮籍，学易慕丁宽。\n试问黄河险，何如蜀道难。\n太平无补报，只有寸心丹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12771,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日访友人","author":"朱希晦","text":"行寻春草径，坐敞白云扉。\n展席面流水，抱琴看翠微。\n纷纷浮世改，落落故人稀。\n尚意陶徵士，柴车日暮归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12772,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"写怀","author":"朱希晦","text":"急景催人老，能令鬓有霜。\n清时思俊杰，拔萃愧材良。\n鹏鴳自高下，鹤凫终短长。\n山窗读书罢，静坐一炉香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12773,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日","author":"朱希晦","text":"春来锄药圃，客去掩柴扃。\n衰鬓不重绿，好山依旧青。\n微名空自绊，大梦几时醒。\n已悟身如寄，乾坤一旅亭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12774,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵谢箫台叶成翁","author":"朱希晦","text":"市上一区足，人间万事非。\n把杯邀月上，隐几看云归。\n宇宙身将老，山林兴不违。\n几时来雁荡，长啸豁岩扉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12775,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"上杨指挥将军","author":"朱希晦","text":"圣主登宸极，奎躔烂远天。\n新开丹凤诏，瑞纪赤乌年。\n山野搜遗逸，朝廷集俊贤。\n老农还喜剧，买犊事春田。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12776,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次郑成翁韵","author":"朱希晦","text":"郑老欣相遇，杯浮竹叶清。\n江关秋已半，山雨夜初晴。\n河映疏星淡，窗悬片月明。\n悠然纵谈笑，怀抱为君倾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12777,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和李子光韵","author":"朱希晦","text":"门外客初到，坐闻流水声。\n看书芸叶乱，醉酒烛花明。\n夜静河汉白，秋高霜露清。\n玄心开一笑，诗思忽然生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12778,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"能仁方丈","author":"朱希晦","text":"山中松桂老，浓翠郁纷纷。\n水壮蛟龙气，风高鸿雁群。\n浮岚晴后见，疏罄夜深闻。\n却忆庞居士，衰年屏俗氛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12779,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"大龙湫","author":"朱希晦","text":"入眼千峰翠作堆，喜寻龙雁窟中来。\n半崖有日飞晴雪，一壑无云吼怒雷。\n驻锡已知尊者意，挥毫空想谪仙才。\n忘归亭下忘归客，手弄潺湲坐碧苔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12780,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送王田著作归赤城","author":"朱希晦","text":"江海飘飘万里身，醉游随处乐天真。\n地无王气非佳地，人有方瞳是异人。\n可恨龙盘遗建业，谁怜鱼腹葬灵均。\n明朝杯酒还相别，愁送骊驹又送春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12781,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夏日书怀","author":"朱希晦","text":"沧江无处不风波，欲理扁舟可奈何。\n白发生涯人已老，绿阴时节雨偏多。\n杯倾鹦鹉同谁醉，剑拂蛟龙强自歌。\n盖世功名非我事，终期结屋卧云萝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12782,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和习之郑先生韵","author":"朱希晦","text":"愧我才疏齿俊髦，也知文物胜弓刀。\n松边展卷白日静，柳下系舟春水高。\n自昔襟期同郑老，当今藻鉴失山涛。\n凭谁说与观风使，要活疲民去吏饕。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12783,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"排闷简王同善渊上人","author":"朱希晦","text":"流光过眼已侵寻，富贵何须满坞金。\n人世自生今日事，朋交不改向时心。\n管宁老去常乌帽，元亮归来只素琴。\n记取岁寒同雅操，长松青映柏森森。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12784,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"有感","author":"朱希晦","text":"城东向晚进风凉，思酒无由入醉乡。\n人寿不同天地老，客愁应共水云长。\n沧江风转芦花起，旧圃秋深草蔓长。\n安得归来遂幽意，呼童净扫读书床。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12785,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"时危","author":"朱希晦","text":"初闻群盗起河北，胡乃流毒江东西。\n落日空城见烟树，秋风满地喧霜鼙。\n人忍贪残作蛇豕，畴能愤切诛鲸鲵。\n中兴自古须将相，济时有策安黔黎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12786,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"悼时","author":"朱希晦","text":"北风猎猎吹沙尘，天阴雨雪愁杀人。\n江湖万顷舞蛟蜃，山薮千年藏凤麟。\n苏卿使节未归汉，商皓采芝先避秦。\n重华世远不复见，嗟哉风俗何由淳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12787,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"忧时","author":"朱希晦","text":"总怜黄鹄久离群，只影孤飞日暮云。\n淮海十年流战血，楚天万里接妖氛。\n凄凉王粲登楼赋，感慨相如谕蜀文。\n自古英雄亦何限，几人戡乱树功勋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12788,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和友人韵","author":"朱希晦","text":"谁能餐玉驻颜光，两鬓都消镜里霜。\n岂有雄文驱海鳄，恨无长矢射天狼。\n十年南国风尘满，千古东陵草蔓荒。\n兴发会应寻范蠡，扁舟散发弄沧浪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12789,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"别云山老禅","author":"朱希晦","text":"风流老禅思不羁，悠然邂逅川水湄。\n谩笑支郎爱神骏，素闻玄度能工诗。\n天关九重守虎豹，江海万倾生蛟螭。\n枣大如瓜信可食，何时径往寻安期。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12790,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"别渊上人","author":"朱希晦","text":"鼎食何如饱蕨薇，由来富贵履危机。\n鹤凫依旧自长短，鹿马至今谁是非。\n每好问奇兼醉酒，那堪惜别更留衣。\n人生聚散知何处，风送秋云一片飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12791,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"简李二丈","author":"朱希晦","text":"满地兵尘暗夕烽，可怜憔悴更衰容。\n故人消息沉双鲤，白日光辉转六龙。\n适意久?拈浊酒，发音谁解奏黄钟。\n管宁已向辽东去，欲买扁舟恨莫从。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12792,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"与夏彦伯","author":"朱希晦","text":"白首相闻非一日，青春倾盖动兼旬。\n艰难总为泛舟役，羁旅乃得连床亲。\n凤凰叫月箫台夜，蛟蜃翻云玉溜春。\n此别何时重会面，不堪回首隔风尘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12793,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答沙都事","author":"朱希晦","text":"尚忆当年羽葆乘，河流如带绕山冈。\n男儿堕地四方志，竹帛垂名千古香。\n越石枕戈终破敌，苏卿持节未归乡。\n慨予疏懒成何事，祇合藏身老墨庄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12794,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵简仲谦倪公叔向陈先生","author":"朱希晦","text":"老夫头白犹眼青，喜瞻北斗联文星。\n陈生饭客甑忘簟，倪子业儒锄带经。\n矫矫龙蛇出大泽，翩翩鸾凤摩青冥。\n方今徵贤急如渴，会见戋帛辉林坰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12795,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"予伤时不古知老将至叹息成诗呈诸同志","author":"朱希晦","text":"泾水何曾混渭流，心忘宠辱自无忧。\n底须老执扬雄戟，且复閒寻范蠡舟。\n不见越裳来白雉，徒闻蜀岭过金牛。\n由来感慨关人事，回首春风忆旧游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12796,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送天衢首座还故山","author":"朱希晦","text":"凤凰山上瞻华盖，师住白云知几重。\n海日楼台金翡翠，天风亭榭玉芙容。\n已经大顶骑驯虎，更向灵源觅卧龙。\n昨日远公曾有约，禅馀看雪最高峰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12797,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄习之郑先生","author":"朱希晦","text":"人生异路分云泥，山尊酒绿思同携。\n雪色上头老冉冉，风声落叶凉凄凄。\n南阳深处尚龙卧，北荡空山惟雁啼。\n何日相期游汗漫，手弄白日凌丹梯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12798,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠倪仲谦","author":"朱希晦","text":"江海鸥盟幸未寒，曾将尺素问平安。\n每怀徐孺空悬榻，却忆逢萌早挂冠。\n半夜明星连宝剑，九秋清露溢铜盘。\n谁能授我长生诀，白日丹成生羽翰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12799,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次竹隐二弟韵","author":"朱希晦","text":"侨居村僻面江郊，又见兰阶玉树高。\n两袖秋风停野骑，半篙秋水漾渔舠。\n别来每忆歌棠棣，老去犹闻爱绛桃。\n惆怅对床空有约，几回风雨夜萧骚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12800,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀古寄友","author":"朱希晦","text":"昆崙峰顶何巍哉，五城楼阙天中开。\n坐招洪崖驻羽盖，笑把西母倾霞杯。\n古今人世一大梦，英雄霸业仍堪哀。\n铜仙泪潸承露掌，野鸟歌上琅琊台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12801,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]