[{"title":"辇下曲一百二首，有序 其八","author":"张昱","text":"国戚来朝总盛容，左班翘鹖右王封。\n功臣带砺河山誓，万岁千秋乐未终。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5573,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其九","author":"张昱","text":"静瓜约闹殿西东，颁宴宗王礼数隆。\n酋长巡觞宣上旨，尽教满饮大金钟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5574,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其十","author":"张昱","text":"万方表马贺生辰，班首师臣与相臣。\n喝赞礼行天乐动，九重宫阙一时新。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5575,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其十一","author":"张昱","text":"三司侍宴皇情洽，对御吹螺大礼终。\n宝扇合鞘催放仗，马蹄哄散万花中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5576,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其十二","author":"张昱","text":"授时历进当冬至，太史舁官近御前。\n御用粉笺题国字，帕黄封上榻西边。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5577,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其十三","author":"张昱","text":"泥金沥水顺飘扬，掌扇香吹殿角凉。\n不是内官亲执御，太平无用镇非常。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5578,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其十四","author":"张昱","text":"只孙官样青红锦，裹肚圆文宝相珠。\n羽仗执金班控鹤，千人鱼贯振嵩呼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5579,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其十五","author":"张昱","text":"全装节仗冒金钱，振竦高擎玉陛前。\n亸袖行交太平字，回銮犹是步蹁跹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5580,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其十六","author":"张昱","text":"黄金酒海赢千石，龙杓梯声给大筵。\n殿上千官多取醉，君臣胥乐太平年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5581,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其十七","author":"张昱","text":"西天法曲曼声长，璎珞垂衣称艳妆。\n大宴殿中歌舞上，华严海会庆君王。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5582,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其十八","author":"张昱","text":"职贡蛮夷通海徼，筦衣毳帽步逡巡。\n翠华阁下颁缯币，圣主留恩柔远人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5583,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其十九","author":"张昱","text":"竹扛金铸百寻馀，顶版高镌万国书。\n禁得下方雷与电，声光不敢近皇居。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5584,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其二十","author":"张昱","text":"崇天门下听宣赦，万姓欢呼万岁声。\n岂独罪人蒙大宥，普天率土尽关情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5585,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其二十一","author":"张昱","text":"户外班齐大礼行，小臣鸣赞立朝廷。\n八风不动丹墀静，听得宫袍舞蹈声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5586,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其二十二","author":"张昱","text":"墀左朱阑草满丛，世皇封植意尤浓。\n艰难大业从兹起，莫忘龙沙汗血功。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5587,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其二十三","author":"张昱","text":"国初海运自朱张，百万楼船渡大洋。\n有训不教忘险阻，御厨先饭进黄粱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5588,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其二十四","author":"张昱","text":"旂常万乘缀旒旓，玉瓘升坛藉白茅。\n前月太常班卤簿，安排法驾事南郊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5589,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其二十五","author":"张昱","text":"清庙上尊元不罩，爵呈三献礼当终。\n巫臣马湩望空洒，国语辞神妥法宫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5590,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其二十六","author":"张昱","text":"辽东羞贡入神厨，祭鲔专车一丈馀。\n寝庙岁行春荐礼，有加铏豆杂鲜腒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5591,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其二十七","author":"张昱","text":"国俗祠神主中霤，毡车毡俑挂宫灯。\n神来鼓盏自飞动，妖自人兴如有凭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5592,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其二十八","author":"张昱","text":"狼髋且抛何且咒，女巫凭此卜妖祥。\n手持朴樕挥三祀，蠲洁祈神受命长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5593,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其二十九","author":"张昱","text":"当年大驾幸滦京，象背前驮幄殿行。\n国老手炉先引导，白头联骑出都城。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5594,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其三十","author":"张昱","text":"皇舆清暑出滦京，三日当番见大臣。\n夜半暗中偷摸箭，阴教右姓主朋巡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5595,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其三十一","author":"张昱","text":"请号关牌趋鼓阁，弓刀千骑领兵符。\n例差右姓巡仓库，哄唱穹庐赐大酺。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5596,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其三十二","author":"张昱","text":"祖宗诈马宴滦都，挏酒啍啍载憨车。\n向晚大安高阁上，红竿雉帚扫珍珠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5597,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其三十三","author":"张昱","text":"驾起京官聚草棚，诸司谁敢不从公？\n官钱例与供堂食，马上风吹酒面红。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5598,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其三十四","author":"张昱","text":"千门万户严扃钥，留守司官莫自闲。\n仰候秋风驼被等，郊迎大驾向南还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5599,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其三十五","author":"张昱","text":"驼装序入日精门，铜鼓牙旗作队喧。\n一听巡阶铃钹振，满宫俱喜出迎恩。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5600,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其三十六","author":"张昱","text":"月华门里西角屋，六纛幽藏神所居。\n大驾起行先戒路，鼓钲次第出储胥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5601,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其三十七","author":"张昱","text":"华缨孔帽诸番队，前导伶官戏竹高。\n白伞葳蕤避驰道，帝师辇下进葡萄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5602,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其三十八","author":"张昱","text":"守内番僧日念吽，御厨酒肉按时供。\n组铃扇鼓诸天乐，知在龙宫第几重？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5603,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其三十九","author":"张昱","text":"皇舆行在辟人门，群牧分屯散綵云。\n习驭每朝供进马，近移毳幕尽宗勋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5604,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其四十","author":"张昱","text":"御前亲拜中书令，恩赐东宫设内筵。\n手署敕黄唯一道，任谁祗受付双迁？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5605,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其四十一","author":"张昱","text":"鸡人唱罢内门开，千骑前头丞相来。\n卫士金瓜双引导，百司拥醉早朝回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5606,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其四十二","author":"张昱","text":"端本堂深绣榻高，满前学士尽风骚。\n星河骑士知唯马，惯识金笺玉兔毫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5607,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其四十三","author":"张昱","text":"旌旗千骑从储皇，诈柳行春出震方。\n祖宗马上得天下，弓矢斯张何可忘？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5608,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其四十四","author":"张昱","text":"和宁沙中朴樕笔，史臣以代铅椠事。\n百司译写高昌书，龙蛇复见古文字。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5609,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其四十五","author":"张昱","text":"仪台铁表冠龙尺，上刻横文晷度真。\n中国失传求远裔，犹于回纥见斯文。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5610,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其四十六","author":"张昱","text":"儒臣奉诏修三史，丞相衔兼领总裁。\n学士院官传赐宴，黄羊湩酒满车来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5611,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其四十七","author":"张昱","text":"经筵进讲天人喜，宣索金缯赐讲臣。\n已觉圣躬忘所倦，教将古训更前陈。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5612,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其四十八","author":"张昱","text":"文明天子念孤寒，科举人材两榜宽。\n别殿下帘亲策试，唱名才了便除官。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5613,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其四十九","author":"张昱","text":"冑监诸生盛国容，大官羊膳两厨供。\n六经尽是君臣事，卿相才多在辟雍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5614,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其五十","author":"张昱","text":"炉香夹道涌祥风，梵辇游城女乐从。\n望拜綵楼呼万岁，柘黄袍在半天中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5615,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其五十一","author":"张昱","text":"放教贵赤一齐行，平地风生有翅身。\n未解刻期争拜下，御前成个赏金银。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5616,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其五十二","author":"张昱","text":"国子题名金仆姑，树篱比射尽腰符。\n分明百步中侯的，踊跃宗王舞袖呼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5617,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其五十三","author":"张昱","text":"对朋角饮目相招，黄鼠生烧入地椒。\n马湩饮轮金铎刺，顶宁割发不相饶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5618,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其五十四","author":"张昱","text":"柳林密遣弄臣回，封印黄金盒一枚。\n天语直将西内去，便教知是草芽来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5619,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其五十五","author":"张昱","text":"直从海子望蓬莱，青雀传言日几回？\n为造龙舟载天姆，院家催造画图来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5620,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其五十六","author":"张昱","text":"西方舞女即天人，玉手昙花满把青。\n舞唱天魔供奉曲，君王常在月宫听。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5621,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其五十七","author":"张昱","text":"鸭绿江波胜鸭头，鱼龙变化满中州。\n分来一派天潢水，到得乌桓便不流。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5622,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其五十八","author":"张昱","text":"昭君遗下汉琵琶，拗轸谁弹狈获沙？\n春色不关青冢上，只今芳草满天涯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5623,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其五十九","author":"张昱","text":"玉窦桥边日月明，金棋界脉直如绳。\n世皇存此为殷鉴，上刻宣和示废兴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5624,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其六十","author":"张昱","text":"金计倾辽至可哀，为车为马枉豗隤。\n岂知万岁山中土，载得龙沙王气来？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5625,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其六十一","author":"张昱","text":"大都周遭十一门，草苫土筑那吒城。\n谶言若以砖石裹，长似天王衣甲兵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5626,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其六十二","author":"张昱","text":"八思巴师释之雄，字出天人惭妙工。\n龙沙彷佛鬼夜哭，蒙古尽归文法中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5627,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其六十三","author":"张昱","text":"学贯天人刘太保，卜年卜世际昌期。\n帝王真命自神武，鱼水君臣今见之。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5628,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其六十四","author":"张昱","text":"许衡天遣至军前，未丧斯文赖此传。\n大学一编尧舜事，致君中统至元年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5629,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其六十五","author":"张昱","text":"运际昌期不偶然，外臣豪杰得神仙。\n一言不杀感天听，教主长春亿万年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5630,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其六十六","author":"张昱","text":"宋亡死节文丞相，不受宣封信国公。\n祠庙至今松柏在，世皇盛德及孤忠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5631,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其六十七","author":"张昱","text":"太祖雄姿自圣神，一时睿断出天真。\n要将儒释同尊奉，宣谕黄金铸圣人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5632,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其六十八","author":"张昱","text":"龙虎山中有道家，上清剑履绚晴霞。\n依时进谒棕毛殿，坐赐金瓶数十茶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5633,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其六十九","author":"张昱","text":"相官马湩盛浑脱，骑士题封抱送来。\n传与内厨供上用，有时直到御前开。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5634,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其七十","author":"张昱","text":"西番僧果依时供，小笼黄旗带露装。\n满马尘沙兼日夜，平坡红艳露犹香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5635,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其七十一","author":"张昱","text":"黄公垆榜大金书，门外长停右姓车。\n请教宫缯来换酒，悲歌始是醉之馀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5636,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其七十二","author":"张昱","text":"圜殿仪天十六楹，向前黄道不教行。\n帐房左右悬弓角，尽是君王宿卫兵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5637,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其七十三","author":"张昱","text":"玉德殿当清灏西，蹲龙碧瓦接榱题。\n卫兵学得高丽语，连臂低歌井即梨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5638,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其七十四","author":"张昱","text":"棕毛四面拥龙床，殿角凉生紫雾香。\n上位励精求治切，不曾朝退不抬汤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5639,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其七十五","author":"张昱","text":"斜街木局尽闲房，御史微行自不妨。\n从立宪台曾有旨，代天耳目付贤良。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5640,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其七十六","author":"张昱","text":"上都半道次榆林，是处鸳鸯野泺深。\n不比使君桑下问，自媒年少觅黄金。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5641,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其七十七","author":"张昱","text":"少年马后抱熊罴，便佞相倾结所知。\n一日搭名帮草料，好官多属跨驴儿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5642,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辇下曲一百二首，有序 其七十八","author":"张昱","text":"闲家日逐小公侯，蓝棒相随觅打毬。\n向晚醉嫌归路远，金鞭梢过御街头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5643,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]