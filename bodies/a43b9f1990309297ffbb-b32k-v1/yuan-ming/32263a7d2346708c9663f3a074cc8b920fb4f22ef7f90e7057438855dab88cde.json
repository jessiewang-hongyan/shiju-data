[{"title":"题夏士良修篁芙蓉","author":"陶宗仪","text":"故人一别两年过，写寄相思恨转多。\n欲采芙蓉隔秋水，只闻江上竹枝歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4498,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画菜二首 其一","author":"陶宗仪","text":"芦菔生儿菜有孙，露芽雨甲媚盘飧。\n自知肉食非吾相，抱瓮何辞日灌园。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4499,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画菜二首 其二","author":"陶宗仪","text":"绕屋蔬畦称食贫，雨馀齐茁翠苗新。\n山庖顿顿殊风致，天上酥酡未足珍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4500,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题梅鹤高士图","author":"陶宗仪","text":"月明孤鹤唳前汀，一树寒梅护石屏。\n香篆已消童子倦，道人犹对蕊珠经。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4501,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客窗听雨四绝句次南山韵 其一","author":"陶宗仪","text":"十年归梦剡溪船，眼底江山若个边。\n春事寂寥人意懒，一天风雨共愁眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4502,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客窗听雨四绝句次南山韵 其二","author":"陶宗仪","text":"萧然一室小于船，那得心情到酒边。\n只怕今年无菜麦，闷来抛卷曲肱眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4503,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客窗听雨四绝句次南山韵 其三","author":"陶宗仪","text":"处世真犹上濑船，纷纷人事浩无边。\n就中亦有清閒者，醉即高歌倦即眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4504,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客窗听雨四绝句次南山韵 其四","author":"陶宗仪","text":"新种垂杨可系船，寻盟日日到鸥边。\n当年曾向巴江泊，政似如今听雨眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4505,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题诗意图","author":"陶宗仪","text":"杖藜访友趁萧閒，采药山深待未还。\n流水石桥松影合，溪童指点乱云间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4506,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题倪云林枯木竹石小景","author":"陶宗仪","text":"苍玉庚庚翠袖扶，墨池洗出碧珊瑚。\n倪颠老去风流尽，只有云林小画图。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4507,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题墨梅","author":"陶宗仪","text":"花光三昧幻冰魂，满纸春风带墨痕。\n好似孤山亭子上，一枝斜映月黄昏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4508,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"开泖口号四首 其一","author":"陶宗仪","text":"县民应役开长泖，两岸高低菜麦空。\n程限不严功力怠，监官酣酒舞裙红。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4509,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"开泖口号四首 其二","author":"陶宗仪","text":"四十里长横泖路，会工都用六千人。\n开挑两月无成绩，主典污慵欠拊循。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4510,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"开泖口号四首 其三","author":"陶宗仪","text":"沟渠堰塞为开河，河未开通雨转多。\n水浸麦根浑烂却，今年生理竟如何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4511,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"开泖口号四首 其四","author":"陶宗仪","text":"万农蹙额吁苍旻，莫把春霖困下民。\n种得稻禾供馈饷，全资二麦济饥贫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4512,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题鹧鸪","author":"陶宗仪","text":"湘江岸口黄陵庙，苦竹丛低雨气昏。\n相唤相呼泥滑滑，长途多少客销魂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4513,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题金华赵彦如所藏画轴","author":"陶宗仪","text":"婺女光芒地脉灵，天潢倒影湛清泠。\n眼前不尽登临意，都在溪山一草亭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4514,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题和靖拥炉觅句图","author":"陶宗仪","text":"一童一鹤住西湖，千古高风识画图。\n水影月香成绝唱，苦吟犹自拥寒炉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4515,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题黄葵","author":"陶宗仪","text":"西蜀孤芳分外清，嫩黄新染越罗轻。\n自从承却金茎露，向日檀心一寸倾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4516,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题雪景山水","author":"陶宗仪","text":"碎剪银河片片零，芙蓉开遍玉崚嶒。\n八窗洞启虚生白，好似蓬婆最上层。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4517,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题葵花雉鸡","author":"陶宗仪","text":"向日倾心矫不移，援琴閒操雉朝飞。\n仙人掌上金茎露，滴著娟娟五彩衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4518,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题人物山水","author":"陶宗仪","text":"古赋裁成学遂初，山童研墨且徐徐。\n石头几上溪藤滑，旋拂松花对客书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4519,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为许玄伯题画二首 其一 黄菊","author":"陶宗仪","text":"道人小葺柳边庄，三径西风逗晚香。\n按谱秋葩班异品，堂堂正色御袍黄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4520,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"为许玄伯题画二首 其二 绯桃","author":"陶宗仪","text":"学会徐熙笔法奇，浓磨翠屑衬胭脂。\n武陵溪上神游熟，写得春风小折枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4521,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题黄葵聚蝶图","author":"陶宗仪","text":"亭亭花萼媚秋光，露满金杯蝶翅凉。\n二月好春浑忘却，乱飞争恋御罗黄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4522,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题清暑观瀑图","author":"陶宗仪","text":"隔岸林泉照眼清，玉虹千尺挂空青。\n松风谡谡凉如洗，一段匡庐九叠屏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4523,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题倪元镇云岫溪亭图","author":"陶宗仪","text":"扁舟昔日惠山前，裹茗来烹第二泉。\n清閟老仙呼鹤处，冈头亭子尚依然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4524,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题林子山画次韵","author":"陶宗仪","text":"一个青松覆小亭，香浮菡萏远逾清。\n日长无事抛书坐，静听文楸落子声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4525,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题荔枝","author":"陶宗仪","text":"大唐置驿贡遐方，火齐虬珠裹蔗浆。\n博得玉环才一笑，教坊曲奏荔枝香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4526,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题曹云西双松图","author":"陶宗仪","text":"泖云西畔一诗翁，画法营丘理趣融。\n四十年前经此地，双松无恙草堂空。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4527,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题万玉图","author":"陶宗仪","text":"踏雪寻梅访老逋，西泠桥外小山孤。\n疏疏密密花争发，好似传来万玉图。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4528,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题王若水戴胜 其一","author":"陶宗仪","text":"桑树柔条叶已空，晚来独立语东风。\n织纴自是闺房事，喜得频催早献功。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4529,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题王若水戴胜 其二","author":"陶宗仪","text":"片片疏翎列顶旗，娟娟文羽揽春辉。\n边庭大将能知汝，献捷封侯戴胜归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4530,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"慈云十咏 其一 灵峰古刹","author":"陶宗仪","text":"众山罗立小为尊，一朵灵峰启法门。\n气聚风藏龙脉远，元符宝殿尚孤存。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4531,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"慈云十咏 其二 庆云禅关","author":"陶宗仪","text":"庆云五色照清溪，郁郁纷纷望远迷。\n第一禅关从此入，西头即是古招提。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4532,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"慈云十咏 其三 ?师全身塔","author":"陶宗仪","text":"一定千年与世忘，当时起塔谨安藏。\n如今试启云龛钥，爪发还应几许长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4533,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"慈云十咏 其四 竺师觉花堂","author":"陶宗仪","text":"缤纷天雨宝优昙，听法升堂总戒严。\n顿悟此心成一笑，阿师不待觉尊拈。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4534,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"慈云十咏 其五 运师芥子室","author":"陶宗仪","text":"维摩方丈未为奇，我室呼如芥颗宜。\n三万二千师子坐，著来尚可踢须弥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4535,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"慈云十咏 其六 薝卜林","author":"陶宗仪","text":"薝卜花开玉朵攒，清香满室似旃檀。\n五千馀卷都披却，四十二章宁浪看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4536,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"慈云十咏 其七 松阁看云","author":"陶宗仪","text":"长松落落远尘寰，重阁阴阴奠碧山。\n尽日跏趺自怡悦，禅心已共白云閒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4537,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"慈云十咏 其八 莲池玩月","author":"陶宗仪","text":"沼中净植芬陀利，天上高县白玉盘。\n香远光清宵更寂，梵馀徙倚石阑干。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4538,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"慈云十咏 其九 层峦拱翠","author":"陶宗仪","text":"云屏九叠自天开，龙象森严震法雷。\n莫怪山灵无供养，六时朝礼送青来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4539,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"慈云十咏 其十 双溪环碧","author":"陶宗仪","text":"流水萦纡远接天，一支分入寺门前。\n且教听讲苍龙蛰，菩萨来乘大愿船。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4540,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"庚午十二月十八日雪","author":"陶宗仪","text":"满载寒花玉气浮，野航一个小于瓯。\n晓来试上城头望，碧海金山两白鸥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4541,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辛未八月廿三日大风雨口号","author":"陶宗仪","text":"大风怒吼雨如麻，入得更深势转加。\n晓起忽闻墙外语，今年只损木绵花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4542,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辛未子月廿三日","author":"陶宗仪","text":"朔风颠号树木枯，层冰积雪冻模糊。\n三冬酷冷无今日，兽炭频烧醉玉壶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4543,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"癸酉五日六日阴七日雨","author":"陶宗仪","text":"两日寒阴人日雨，不堪吼地北方痴。\n马牛耕战人供亿，百谷丰凶未可知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4544,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谷日雨","author":"陶宗仪","text":"寒风剪剪雨冥冥，水白云黄菜麦青。\n听得老农墙外语，今年不得看参星。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4545,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日雨","author":"陶宗仪","text":"终日霖霪不肯晴，晚来片片雪花零。\n竹炉炽火驱寒气，缸面分醅入夜瓶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4546,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赤脚雪","author":"陶宗仪","text":"雪停五日未全消，云净天清气泬寥。\n故老相传名赤脚，来年山岳要枯焦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4547,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"十二月初一初六两日闻雷","author":"陶宗仪","text":"今年腊月两闻雷，虩虩声从何处来。\n阳不闭藏先出地，下民修省可禳菑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4548,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丙子五日甲子雨","author":"陶宗仪","text":"正月上旬逢甲子，试稽农历定丰年。\n奈何终日风兼雨，又恐乘船入市廛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4549,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"三日率诸生赴礼部考试","author":"陶宗仪","text":"应试南宫听考研，诸生背读泻鸣泉。\n清曹仪制耑分领，次第编名奏奉天。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4550,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"十日给赏","author":"陶宗仪","text":"讲明三诰阐王言，亿万师生沐湛恩。\n晓起内廷催给赏，谨持宝楮出端门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4551,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"十一日谢恩","author":"陶宗仪","text":"四更来簉紫宸班，恭谢皇恩仰圣颜。\n五拜礼严三叩首，春风两袖趣东还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4552,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"八月六日白露","author":"陶宗仪","text":"今朝白露亥时交，小雨霏微向日捎。\n野老为言无过虑，岁丰天意已先教。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4553,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"廿三日","author":"陶宗仪","text":"打窗风霰五更头，寒冱重阴昼不收。\n积水淼漫天一色，望穷只益老农忧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4554,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"二月六日日出二竿许松江府城为黑气蒙蔽若重雾然人对面莫辨谁某一饭顷乃散附城五七里间亦如是较之城中则稍轻耳此时处处乡村风日妍丽","author":"陶宗仪","text":"黑气冥濛压府城，路人交臂只闻声。\n须臾消散清如埽，未卜将来作么生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4555,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"腊月五日早霜","author":"陶宗仪","text":"鸳鸯万瓦玉参差，青女横陈肆腊威。\n晓起推窗疑是雪，棱棱还向太阳晞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4556,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"月九日","author":"陶宗仪","text":"谷日宜晴翻作雨，明朝西北大风狂。\n圣人在御民安乐，未必天心降不祥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4557,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"廿八日雪","author":"陶宗仪","text":"杏蕊娇红柳眼青，东风阵阵雪花明。\n春光已是三之一，厎是严寒砭骨清。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4558,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"十一月朔大雪节早见雪","author":"陶宗仪","text":"狂风昨夜吼棱棱，寒压重衾若覆冰。\n节气今朝逢大雪，清晨瓦上雪微凝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4559,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"腊月乙卯日已卯时雷从西北方起","author":"陶宗仪","text":"连朝气候若春温，晓日曈昽忽惨昏。\n一道金光飞闪电，雷声虩虩震天门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4560,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"正月十七日","author":"陶宗仪","text":"上元次夕月华明，雪霰缤纷欲二更。\n晓起作花飞向日，苦寒砭骨势峥嵘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4561,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"正月廿二日夜三更雷始鸣","author":"陶宗仪","text":"风狂雨急夜三更，隐隐春雷已作声。\n节候数来先十日，多应群蛰未全惊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4562,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南浦","author":"陶宗仪","text":"如此好溪山，羡云屏，九叠波影涵素。\n暖翠隔红尘，空明里、著我扁舟容与。\n高歌鼓枻，鸥边长是寻盟去。\n头白江南，看不了何况，几番风雨。\n画图依约天开，荡清晖、别有越中真趣。\n孤啸柘篷窗，幽情远、都在酒瓢茶具。\n水荭摇晚，月明一笛潮生浦。\n欲问渔郎无恙否，回首武陵何许。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4563,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"一萼红 赋红梅次郭南湖韵","author":"陶宗仪","text":"水云乡，又南枝逗煖，绰约汉宫妆。\n春艳秾分，朱铅浅试，翠袖独倚修篁。\n想应道、东风料峭，剪霞彩、零乱补绡裳。\n勾漏寻真，丹丘授诀，傲睨冰霜。\n毕竟孤标还在，纵夭桃繁杏，难侣寒香。\n玛瑙坡头，珊瑚树底，江南别是风光。\n且莫倚、高楼玉管，怕轻盈、飞处误刘郎。\n依旧小窗，疏影淡月昏黄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4564,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"露华 赋碧桃用南湖韵","author":"陶宗仪","text":"武陵夜寂。\n记露影璇空，一笑曾识。\n素脸晕铅，巧把黛螺轻羃。\n莫是歌渡烟江，浣却旧家颜色。\n还又讶，深宫绀袖，唾花犹湿。\n问他阿母消息。\n甚落莫梨云，青鸟难觅。\n不比锦红，轻薄容易狼藉。\n嫩绿护出溪头，谁顾采香仙客。\n春晚也、频温玉笙是得。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4565,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"念奴娇 九日有感次友人韵","author":"陶宗仪","text":"黄花白发，又匆匆佳节，感今怀昔。\n雨覆云翻无限态，故国寒烟榛棘。\n杜老漂零，沈郎瘦损，此意天应识。\n划然长啸，不知身是孤客。\n呼酒漫祓清愁，玉奴频劝，两脸添春色。\n眼底平生空四海，倦拂红尘风帻。\n戏马台荒，登龙人老，往事休追惜。\n山林无恙，也须容我高屐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4566,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"木兰花慢 次胡笔峰迁居韵","author":"陶宗仪","text":"占中山一隩，云晻霭、水萦纡。\n便小理蔬畦，深锄菊圃，细甃花衢。\n平生几番卜隐，到而今、方称列仙臞。\n问字溪翁载酒，执经弟子将车。\n猗欤。\n心迹混樵渔。\n安用绝交书。\n向石上围棋，松阴捣药，乐意偏殊。\n当年辋川图画，有林泉、如此更何如。\n旋买良田种秫，只知吾爱吾庐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4567,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]