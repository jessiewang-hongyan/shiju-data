[{"title":"听雪轩","author":"王冕","text":"飞来便与雨声别，坐久甚忧天下寒。\n清极自然梅有韵，夜阑却喜竹平安。\n洛阳处士门深闭，剡曲先生琴不弹。\n想在此时情思好，煮茶可笑老陶酸。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":329,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宋郊台","author":"王冕","text":"荡荡南郊路，金舆不复行。\n古台余草色，新树自风声。\n寂寞荒村景，凄凉故国情。\n遗民能道旧，曾是御营兵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":330,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀人","author":"王冕","text":"怀人有多梦，忧国竟忘眠。\n野草皆成药，江云半是烟。\n悲鸿联阵下，老鹤唳孤骞。\n孰信残阳外？\n疲民问井田。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":331,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀乡","author":"王冕","text":"关西吾故里，八代不能归。\n坟墓今何在？\n门闾故已非。\n清秋愁燕去，残日望云飞。\n岂是桃源客？\n虚无与世违。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":332,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀古","author":"王冕","text":"会稽岩壑今犹古，王谢经行何所之？\n感慨传人有馀思，风流异代不同时。\n春来野水生蒲柳，雨过空山长蒺藜。\n异代无人知禹穴，游人来往到今疑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":333,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀古","author":"王冕","text":"浮云漠漠云摇天，乳燕翻飞落野田。\n轩冕尽知为上客，衣冠谁解说前贤？\n闭门种菜殊无策，坐石看松不记年。\n世事东风吹马耳，锦帆金谷已茫然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":334,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"村居","author":"王冕","text":"避世忘时势，茅庐傍小溪。\n灌畦晴抱瓮，接树湿封泥。\n乳鹿依花卧，幽禽过竹啼。\n新诗随处得，不用别求题。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":335,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"村居四首 其一","author":"王冕","text":"断桥分野色，曲径入柴门。\n五柳低藏屋，三家自作村。\n人情同下里，风俗异东屯。\n我老无生计，耕耘教子孙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":336,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"村居四首 其二","author":"王冕","text":"茅屋人看小，我居殊觉宽。\n云开山满座，雨过草平阑。\n古意琴三叠，清风竹万竿。\n养生无别具，壁上破瓢箪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":337,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"村居四首 其二","author":"王冕","text":"绿槿作篱笆，茅檐挂薜萝。\n马车浑不到，樵牧自相过。\n卧看归田录，行听击壤歌。\n优游只如此，刀锯奈吾何？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":338,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"村居四首 其三","author":"王冕","text":"人言村落僻，我处颇清幽。\n竹色侵衣冷，江声绕屋流。\n欢呼同社酒，出入趁鱼舟。\n不用闻时事，桑阴且饮牛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":339,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"村居四首 其三","author":"王冕","text":"欲识吾居处，屋前溪水流。\n门交青薜荔，篱蔓黑牵牛。\n有竹编书简，无花引钓舟。\n生涯随分已，何用卜菟裘？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":340,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"村居四首 其四","author":"王冕","text":"英雄在何处，气概属山家。\n蚁布出入阵，蜂排早晚衙。\n野花团部伍，溪树拥旗牙。\n抱膝长吟罢，天边日又斜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":341,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"村居四首 其四","author":"王冕","text":"局厌廛中隐，宽从野外居。\n人情方密熟，礼数觉生疏。\n悬榼空浮蚁，陈编扑蠹鱼。\n客来纵谈笑，不必问吾庐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":342,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"汶上二首 其一","author":"王冕","text":"汶水连洙泗，源源有所归。\n圣贤诚可仰，风俗自相违。\n落叶随风舞，孤鸿破雪飞。\n纷纷名利客，到此肯忘机。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":343,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"汶上二首 其二","author":"王冕","text":"破梦闻金鼓，关心望玉绳。\n只知时候别，不觉夜寒增。\n冻雨成飞雪，长河走大陵。\n客情无可奈，却借驿楼登。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":344,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"汶上舟行","author":"王冕","text":"贤圣久不作，我行真可怜。\n望归黄柳外，坐到碧山前。\n老马知官道，饥鹰集野田。\n晚风吹急雪，回首一茫然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":345,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"纸衾","author":"王冕","text":"楮衾能洁白，孤卧得平安。\n作客心如水，缠身雪作团。\n吴绫烂花草，蜀锦动螭鸾。\n未必清如此，那堪慰考盘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":346,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"乙未春访仲远宿寄傲轩观李著作遂赋长句","author":"王冕","text":"花竹参差荫石苔，幽居却似小蓬莱。\n山光入座青云动，水色摇天白雨开。\n得兴不妨閒觅句，忘机尽自可衔杯。\n主人爱客能潇洒，许我携琴日日来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":347,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闰七月二十三夜记梦诗二首 其一","author":"王冕","text":"历历青山出，翩翩白雁来。\n感时徒愤郁，吊古独悲哀。\n夜雨凄庭草，秋花老石苔。\n客怀消不得，怅望一徘徊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":348,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闰七月二十三夜记梦诗二首 其二","author":"王冕","text":"对镜多新白，怀人入远思。\n山河犹汉魏，风俗想轩羲。\n小草铜驼恨，荒陵玉雁悲。\n平生伊吕志，耕钓岂无为？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":349,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"閒题前元旧事","author":"王冕","text":"楼台矗矗带山河，金玉重重是帝家。\n云合紫驼开虎帐，天连青草入龙沙。\n春风小殿看飞燕，夜雨重城散落花。\n甲乙流苏仙梦好，莫教方士问丹砂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":350,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜坐","author":"王冕","text":"夜深山馆冷，风雨满江城。\n老客不成寐，感怀无限情。\n蛮烟迷五岭，王气属三京。\n休问泥涂事，荆榛处处生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":351,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"季札墓","author":"王冕","text":"识君因读春秋传，今日坟前见断碑。\n大义可令吴俗变，高风不独鲁人知。\n剑光注壑生灵草，树影悬空动羽旗。\n休问姑苏旧风景，白烟青雨黍离离。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":352,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"庚辰元旦","author":"王冕","text":"试题春帖纪新年，霭霭青云起砚田。\n展卷不知山是画，举头恰喜屋如船。\n梅花雪后开无数，杨柳风前困欲眠。\n怅望关河无限恨，呼儿沽酒且陶然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":353,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"庚寅春二月三日甲子大雨雪","author":"王冕","text":"二月甲子雪，霏花冷作围。\n乾坤移气象，草木转光辉。\n野鸟浑无语，边尘湿不飞。\n长安未归客，应是动心机。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":354,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"建康层楼","author":"王冕","text":"层楼危构出层霄，把酒登临客恨饶。\n草色不羞吴地短，雁声空落楚天遥。\n江山如画知豪杰，风月无私慰寂寥。\n六代繁华在何处？\n败红残绿野萧萧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":355,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"招隐卷","author":"王冕","text":"寄尔太冲招隐篇，归来不用买山钱。\n青云绕屋树如盖，红雾隔堤花满川。\n既有向时潜子兴，不妨今日米家船。\n老夫湖海亦觉倦，也欲枕书林下眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":356,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"松风阁次韵","author":"王冕","text":"金鸡峰下松风阁，记得前年五月登。\n得兴不辞行曲折，乘凉直上最高层。\n石林过雨水争出，溪谷转风云乱腾。\n休问当时有王谢，风流何似竹间僧？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":357,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"林壑亭","author":"王冕","text":"会稽林壑东南胜，结构新亭亦壮哉。\n树密不知云出没，山深常听水喧豗。\n清幽可许渔樵隐，游赏岂无王谢来？\n我欲题诗追李杜，风流不是出群才。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":358,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"沽亭道中二首 其一","author":"王冕","text":"野亭依柳树，水路出桑林。\n问俗谁能解？\n怀思自不禁。\n远山归眼小，孤雁入云深。\n可笑西京客，持杯学楚吟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":359,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"沽亭道中二首 其二","author":"王冕","text":"方离三柳树，又出下沽亭。\n客路从兹去，人情转不宁。\n关河孤雁没，齐鲁众山青。\n处处黄河道，吾将补水经。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":360,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"泊瓜洲二首 其一","author":"王冕","text":"晚泊瓜洲渡，秋风九月时。\n野烟晴漠漠，江树绿离离。\n客思无人会，乡情有雁知。\n斐才惭李杜，对景亦题诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":361,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"泊瓜洲","author":"王冕","text":"落日大江秋，凄凉觉底愁。\n逆潮攻败垒，荒树入沙洲。\n险固空馀迹，清平且壮游。\n不须腰十万，明日上扬州。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":362,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"泊聊城","author":"王冕","text":"水宿聊城外，忘眠听漏声。\n浮烟连野白，孤月近船明。\n世变山河在，时移草木惊。\n绝怜知己少，感慨独伤情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":363,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"泗上","author":"王冕","text":"吊古心何壮，凭高气更雄。\n大风秋野阔，明月故乡同。\n潇洒繁霜鬓，凄凉独老翁。\n夜深沽斗酒，不异在新丰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":364,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"金水河","author":"王冕","text":"金水河从金口来，龙光清澈净无埃。\n流归天上不多路，肯许人间用一杯？\n杨柳春融青雾拥，芙蓉秋霁锦帆开。\n老夫白发少年志，适兴时来看一回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":365,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"金水河春兴二首 其一","author":"王冕","text":"神州何处见繁华，尽好当时富贵家。\n慷慨唤来黄字酒，丁宁将出紫帘车。\n春风袅袅穿杨柳，小雨冥冥度杏花。\n沉醉归来不知夜，又传清响按琵琶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":366,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"金水河春兴二首 其二","author":"王冕","text":"金水河边柳色新，玉山馆外少沙尘。\n琵琶未必能愁客，鹦鹉如何错唤人。\n翠袖锦襜驮白马，落花飞絮鬨朱轮。\n人间天上无多路，只隔红门别是春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":367,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"金陵怀避乱作","author":"王冕","text":"坏墙幽径草青青，何处园林是旧京。\n海气或生山背雨，江潮不到石头城。\n英雄消歇无人语，形势周遭夕照明。\n回首长干思无限，水风杨柳作秋声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":368,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闸上二首 其一","author":"王冕","text":"舒啸孤怀壮，天风荡杳冥。\n草枯秦地白，云尽鲁山青。\n闻道尊庄子，沽杯候野亭。\n平生辛苦事，须信此行经。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":369,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闸上二首 其二","author":"王冕","text":"白雾都收尽，青天无片云。\n候船车衮衮，辞树月纷纷。\n纱帽当垆妇，兜鍪出塞军。\n不愁书寄少，鸿雁动成群。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":370,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中","author":"王冕","text":"江南江北水滔天，羁客相逢亦可怜。\n坐觉青山沉席底，行惊白浪上窗前。\n鹁鸠衔草栖危塔，鸂?翻飞浴败船。\n转首百蛮寥落甚，绝无茅屋起炊烟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":371,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中遣兴二首 其一","author":"王冕","text":"黯黯阴阴没大荒，髑髅无语剑生芒。\n青山有梦客千里，明月故人天一方。\n鹿走平原沙莽莽，龙飞沧海雨浪浪。\n相望多少相思意，倚遍危楼尚慨慷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":372,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中遣兴二首 其二","author":"王冕","text":"故人何日是归年，又听刚风洗瘴烟。\n骄马北驰沙似雪，冥鸿南去水如天。\n莫愁弦绝蒲萄馆，且喜歌生䆉稏田。\n好在岳阳楼上望，洞庭明月正婵娟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":373,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨后","author":"王冕","text":"雨后千山净，炊烟处处新。\n世情殊不足，风俗岂能淳？\n老棘余生意，槁花空悟春。\n相逢非古意，在我著乌巾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":374,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨过二首 其一","author":"王冕","text":"雨过山光润，烟浮野色昏。\n清泉流近砌，黄叶拥衡门。\n世事凭谁论？\n高情只自存。\n忽思浣花老，又欲向东屯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":375,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨过二首 其二","author":"王冕","text":"归来访田里，转首忆关河。\n黄叶阶前满，白云山上多。\n人情空烂漫，世事尽差讹。\n亲爱子孙辈，愁予两鬓皤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":376,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"临清阻雪二首 其一","author":"王冕","text":"海气排空云塞山，北来飞雪苦多寒。\n柳条捶雪枝枝重，衣带缘愁故故宽。\n客路何时无跋涉？\n世情随处有艰难。\n濮州城外临清县，今夜留船得梦安。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":377,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"临清阻雪二首 其二","author":"王冕","text":"一片雪飞寒较多，即看漫地却如何？\n竞传暖体须燕玉，谁肯停杯慰楚娥？\n直北大风山欲倒，江南无冻水生罗。\n临清不是长安道，时听凌空响王轲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":378,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南归","author":"王冕","text":"去岁离南去，今年自北归。\n过淮浑酒贱，出水白鱼肥。\n落拓同谁语？\n孤高与世违。\n最怜谯国子，潦倒说兵机。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":379,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南阳闸下","author":"王冕","text":"十月黄河道，舟行浊水泥。\n今晨见清浅，不觉散凄迷。\n云转山腰断，天连野色低。\n可知茅屋近，忽听一声鸡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":380,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南城怀古二首 其一","author":"王冕","text":"日上高城望大荒，西山东海气茫茫。\n铜驼踪迹埋荒草，元菟风尘识战场。\n礼乐可知新制度，山河谁问旧封疆？\n书生慷慨何多感，转忆轮台汉武皇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":381,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南城怀古二首 其二","author":"王冕","text":"青山连壁是居庸，古北渔阳一线通。\n人物尽随风土变，川原须是古今同。\n淡烟著柳金沟暗，小雨飞花玉殿空。\n昨夜角声吹不起，老乌啼过建章宫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":382,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客边五首 其一","author":"王冕","text":"微雨久不歇，浸成留客天。\n衔杯聊复尔，弹铗已萧然。\n落叶饶秋恨，鸣蛩减夜眠。\n故园归未得，日日数行船。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":383,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客边五首 其二","author":"王冕","text":"泽国秋云重，淮山夜雨深。\n感时多得句，怀古独沾襟。\n照镜怜新发，持螯息壮心。\n知音无处问，冷落七弦琴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":384,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客边五首 其三","author":"王冕","text":"飘荡将何倚，凄凉不自禁。\n江湖千里梦，风雨五更心。\n游子黄金印，幽人绿绮琴。\n渠方汩朝市，吾合老山林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":385,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客边五首 其四","author":"王冕","text":"不学养生术，且为归隐谋。\n青山犹昨日，白发不禁秋。\n适兴须村酿，忘机狎海鸥。\n夜来何所事？\n欲上仲宣楼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":386,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客边五首 其五","author":"王冕","text":"世事朝朝异，炎凉处处同。\n江山千古在，风月几时穷。\n采菊思陶令，登楼忆庾公。\n客情消不得，又听北征鸿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":387,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客兴","author":"王冕","text":"鹤鸣猿啸近如何，客里枯衣结薜萝。\n峡石卧云山气重，江风翻雨树声多。\n狂夫对酒评秦法，野老敲檀和楚歌。\n谁似酸斋弄奇崛？\n好诗和梦写渔蓑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":388,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客况","author":"王冕","text":"为客少安睡，终宵听雨声。\n每因年岁晚，不称路途情。\n贫贱交游少，疏豪去就轻。\n萧萧须发改，殊觉负平生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":389,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客思","author":"王冕","text":"破衣悬软毳，短发被秋风。\n汶水长鱼白，滕州小米红。\n人情今日异，客路去年同。\n万里关山外，孤鸿缥渺中。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":390,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客情","author":"王冕","text":"几日不启户，庭前青草多。\n故缘诗思涩，不奈客情何。\n贫贱家无定，英雄剑懒磨。\n江山千万里，回首一长歌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":391,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"屋隅樱桃伐去老干而生新枝能实可爱","author":"王冕","text":"樱桃元旧本，根柢近西篱。\n只为除枯干，翻令长嫩枝。\n红娇殊鹤顶，甘美过蜂脾。\n羞荐归宗庙，于今正及时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":392,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"幽居次韵","author":"王冕","text":"城市居何僻，山林境颇同。\n竹窗风细细，花榭日融融。\n叠石留云卧，开渠许溜通。\n儿童虽解事，不识五花骢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":393,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]