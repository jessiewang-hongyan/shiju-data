[{"title":"中秋感旧","author":"王翰","text":"老到形骸病日侵，追思往事倍伤心。\n故人别我如云散，浊酒同谁对月斟。\n佳节每从愁里过，旧游多向梦中寻。\n当年半醉题诗处，犹在瑶台第一岑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13916,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过周尚谦故居","author":"王翰","text":"十年行役事多艰，一宦才通两鬓斑。\n白社尽容陶令醉，长沙不放贾生还。\n草深药径经年塞，柳映柴门尽日关。\n未遇遗孤閒话旧，不堪相对泪潺湲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13917,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"久雨述怀","author":"王翰","text":"秋来连日雨涔涔，入夜閒愁苦不禁。\n冉冉绿苔沿砌长，潇潇黄叶拥门深。\n匡时疏拙无奇策，忧国衰残负此心。\n长夜不眠空倚枕，挑灯时复一长吟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13918,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题都门送别","author":"王翰","text":"鹗章一荐入青云，送别都门酒半樽。\n江口山晴横紫翠，石头树暝欲黄昏。\n郎官本应星辰贵，民物均沾雨露恩。\n伫看功庸书上考，纶音重下紫薇宸。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13919,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日登瑶台山","author":"王翰","text":"几年踪迹漫栖迟，今日登临逸兴飞。\n绿酒喜随藜杖到，白头须插菊花归。\n苍山日暮林烟合，潦水霜清雁影稀。\n愿祝加餐强健在，年来此会莫相违。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13920,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"清明有感","author":"王翰","text":"春水初生芹吐芽，柳绵飞雪满澄沙。\n竹鸡乱语桑蹊暗，野雉低飞麦陇斜。\n风散纸钱人上冢，雨昏乔木客还家。\n太平有象真堪咏，一幅青帘傍杏花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13921,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"清明登瑶台","author":"王翰","text":"百丈仙台与客游，和风吹面正轻柔。\n谁家修竹偏临水，何处垂杨不映楼。\n缓步偶逢佳处歇，放怀莫厌醉时讴。\n君看巫谷桥中水，断送年光日夜流。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13922,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"简茅津渡梁巡检二首 其一","author":"王翰","text":"游宦天涯二十年，归来双鬓已皤然。\n逢人写帖常求米，送客裁诗不当钱。\n画虎不成惭我拙，登龙有幸喜君贤。\n金龟不惜知音费，也向长安学醉眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13923,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"简茅津渡梁巡检二首 其二","author":"王翰","text":"曾向吴山训子衿，岂期贫病苦相侵。\n一身卒岁无衣褐，十口逢灾罄橐金。\n载酒久无来问字，绝弦今已少知音。\n贤侯与我虽非旧，倾盖相知意更深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13924,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"讲堂雨中看新竹","author":"王翰","text":"潇潇疏雨落庭除，数尺新篁解箨馀。\n粉节乍开蛇蜕滑，翠翎初长凤毛疏。\n不贪异味供佳客，须待长竿钓巨鱼。\n若保岁寒心不改，閒斋长伴子猷居。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13925,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"千叶石榴花","author":"王翰","text":"牡丹开罢到群芳，一种仙葩更异常。\n雨浥繁英鸡帻碎，风梳密叶翠翎长。\n舞裙偏爱分腥血，笑靥应知姑射香。\n庭院开时多爱惜，莫教秋信到银床。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13926,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送外孙苏敬","author":"王翰","text":"流落风尘会合难，相逢老泪湿征衫。\n兵馀亲旧凭谁问，道远音书久不缄。\n函内仪容须默记，墓头断碣欲重劖。\n他年榜首青云客，拟向南宫问阿咸。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13927,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送胡叔雅从军","author":"王翰","text":"中条山下分携处，跃马南行道路长。\n插月雕弓秋有力，倚风宝剑夜生光。\n龙韬策略前贤敌，麟阁功名后代扬。\n奏凯归来当赐节，忠肝义胆永难忘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13928,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"初冬述怀","author":"王翰","text":"带起儒冠五十年，误身方觉为儒冠。\n家贫那得连朝醉，岁歉难逢一日欢。\n藜杖缚床宜足矮，木绵裁被称身宽。\n功名百念如灰冷，只有诗狂不可镌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13929,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"予去岁九日与史文英张仲礼会饮瑶台山皆有诗题于观壁予末句曰但愿加餐强健在来年此会莫相违今年在平陆追和其韵以寄云","author":"王翰","text":"秋来为客独依依，厌见天边朔雁飞。\n在路既歌王式去，荒村偏喜杜陵归。\n别来诗酒欢应少，老去亲朋见亦稀。\n九日瑶台有前约，也应相忆怨相违。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13930,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和冯大尹九日见寄二首 其一","author":"王翰","text":"昔住吴山岁月深，归来聊复别儒林。\n喜逢佳节陪高宴，未向明时叹陆沉。\n官俸请教供色养，芳樽沽得称閒吟。\n太平无事双亲健，为表当年忠孝心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13931,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和冯大尹九日见寄二首 其二","author":"王翰","text":"青山绿树拥残阳，携客登高过野堂。\n千里归心劳望眼，九秋吟兴恼诗肠。\n鸥眠曲水荷应尽，蝶绕疏篱菊正芳。\n岁月无情弹指过，不堪衰鬓又添霜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13932,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和徐知县重兴学校","author":"王翰","text":"开基圣主振宏纲，继统皇王正典常。\n万道红光增日彩，千行彩篆粲龙章。\n史官秉笔书鸿业，髦士横经集鳣堂。\n深感熙朝遵祖训，复令吾道蔼辉光。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13933,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"戊寅大赦","author":"王翰","text":"杂遝欢声遍九垓，金鸡衔赦下天街。\n鼎湖已堕乘云去，宝座初登禁网开。\n万姓共朝龙虎地，五云常绕凤凰台。\n小臣何幸沾恩泽，作颂应惭是菲才。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13934,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和合浦庾司训读书韵","author":"王翰","text":"道统相传只一心，圣心日月本来明。\n舞仪灵凤箫韶奏，告锡玄圭水土平。\n礼乐夔龙千古盛，勋庸周召万人英。\n自从尼父删修后，不识河汾续得成。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13935,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"中秋小酌录呈诸贤友二首 其一","author":"王翰","text":"浮云四敛见膧胧，蟾泣秋霄海雾空。\n万里素虹生碧落，九天丹桂堕金风。\n玉光浮动舞衣上，银汉横斜醉眼中。\n入手酒杯须强饮，不知来岁与谁同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13936,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"中秋小酌录呈诸贤友二首 其二","author":"王翰","text":"待月空庭得月迟，月临山顶发清辉。\n初离沧海寒光湿，才转瑶台列宿稀。\n清助婆娑看处兴，影随零乱舞时衣。\n相逢尽是他乡客，休唱惊乌绕树飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13937,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送曹李二秀才南上","author":"王翰","text":"鹗章一荐入青云，耻作求田问舍人。\n铜雀赋成还可贵，锦囊诗在未为贫。\n幸逢圣治隆千古，不信儒冠误一身。\n二子才奇真倚玉，来年占断杏园春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13938,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"吊刘敬可","author":"王翰","text":"平生时与道相违，一宦才通两鬓丝。\n身后尚存鹦鹉赋，生前空叹鹡鸰诗。\n苍天有意应难测，黄壤无情更可悲。\n江上梅花谩开彻，一壶村酒与谁携。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13939,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"环翠轩","author":"王翰","text":"兹轩新创古城隈，地僻幽寻客到稀。\n风引浮岚来几席，鸟拖空翠入檐扉。\n长杨拔地青千尺，叠嶂当轩玉四围。\n单父政平民讼息，时来徙倚弄金徽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13940,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日登瑶台和李俨夫韵","author":"王翰","text":"九日携朋上峻台，拟将笑口酒边开。\n天长落日摇林麓，野旷孤烟起草莱。\n身世飘零容易老，江山如此不常来。\n今朝幸忝龙山会，醉卧黄花绣作堆。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13941,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"再题玩梅轩","author":"王翰","text":"含章殿下春归去，聊挽东风入砚池。\n对影莫辞金谷酒，披香空费锦囊诗。\n不妨月底成三友，何必江南寄一枝。\n绝胜孤山山下客，空林风雪扑头时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13942,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中望条山","author":"王翰","text":"树色昏昏惨不开，静林何处是楼台。\n峦光隔户乍无有，云影过帘常往来。\n虞坂泥深愁困骥，傅岩碑湿自生苔。\n翠屏何日重相对，欲倩南风扫宿霾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13943,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"盐池晓望","author":"王翰","text":"涿鹿城头曙色分，素池如练迥无尘。\n翠屏倒浸山光静，银汉平铺月色新。\n五月南风凝雪甸，四时飞鸟避云津。\n想应须待调羹手，拟共江梅入八珍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13944,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"虞城送别","author":"王翰","text":"寒云漠漠树苍苍，瘦马频驱古坂长。\n版籍初归周德化，山川终属晋封疆。\n地连虢国风烟合，路入閒田草木荒。\n送客重嗟兴废事，清笳吹恨满离肠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13945,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"王官谷","author":"王翰","text":"西风策马问王官，松径萦纡上百盘。\n泉响夜潭穿石窦，峰高天柱矗云端。\n一鸣共许才华旧，三诏方知节操寒。\n花落鸟啼人不见，休休亭上倚栏干。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13946,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秦楼夕照 其一","author":"王翰","text":"檐前归鸟去纷纷，十二栏干带夕曛。\n风飏绣旌红窈窕，光流绮席碧氤氲。\n珠帘捲雨抬秋水，玉笛吟霜遏綵云。\n君到神京多壮观，建章鳷鹊隐祥氛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13947,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秦楼夕照 其二 瑶台夜月","author":"王翰","text":"月满珠宫露满阶，鞭鸾羽客上瑶台。\n香浮明水仙坛静，云散秋空桂殿开。\n灵鹤有声通碧嶂，蟠桃留影印苍苔。\n想君他日蓬莱上，应对清辉寄远怀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13948,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题苏庄洞神观楼","author":"王翰","text":"万叠青山百尺楼，倚栏空翠泼双眸。\n波澄碧簟铺沙际，霜重红绡剪树头。\n玉洞月明丹火冷，宝坛风细剑光流。\n平生作客多秋兴，便拟登临赋远游。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13949,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杨村至张郭店道中","author":"王翰","text":"牛羊相唤下高原，鸡犬柴桑半掩门。\n野水满陂摇渌静，疏钟一扣破黄昏。\n离鸿的的沉沙碛，瘦马时时衔草根。\n景物令人自悽切，不须为客亦消䰟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13950,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"望中条山怀道卿王先生","author":"王翰","text":"雨洗烟岚千万岑，卜居真得古人心。\n黄金挥尽诗书富，白发从生道义深。\n出处须因时显晦，声名不逐世浮沉。\n几时听雨蓬窗底，樽酒论文细细斟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13951,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过阳城祠","author":"王翰","text":"荆棘丛深隐坏垣，半庭残甓草芊芊。\n馀生本拟成孤愤，直谏虽伸已五年。\n岭徼风烟惊鵩鸟，条山花木怨啼鹃。\n当初只合终佳遁，谩费昌黎论一篇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13952,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重游柏塔寺有感","author":"王翰","text":"曾伴衰翁宿上房，海榴树下挂诗囊。\n白云隔洞迷鸡犬，翠竹摧梢失凤凰。\n灵籁声回惊殿铎，雨花香散满禅床。\n远公化去谁同话，月落空庭塔影长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13953,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"瑶台顶 其一","author":"王翰","text":"十二仙鬟接紫青，玉田日暖晓烟轻。\n风回鹤驾鸾声远，月湿鲸波兔影清。\n古殿秋阴雷雨黑，苍崖返照瀑泉明。\n恨无画手王摩诘，写作新图送客行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13954,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"瑶台顶 其二 秦楼","author":"王翰","text":"潇潇栋宇自明昌，城郭人民半杳茫。\n帘捲太行秋气壮，窗摇汾水素波光。\n目穷白鸟天边树，诗落青山云外庄。\n于此登临送君去，阑干留我倚斜阳。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13955,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"瑶台顶 其三 涑水","author":"王翰","text":"一派灵源滚滚来，风摇锦浪岸花开。\n桥分野色行人去，雨没沙痕钓客回。\n秋净霜澄明似练，春深烟染碧如苔。\n羡君自有朝宗志，莫怪矶头鸥鹭猜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13956,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"瑶台顶 其四 碧流桥","author":"王翰","text":"山下寒泉胜醴甘，板桥倒影静波涵。\n阑干春晓看鱼乐，踪迹霜晨见客贪。\n洗耳欣闻清漱玉，染衣偏爱翠揉蓝。\n劝君莫怆河梁别，拟泛星槎到斗南。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13957,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"瑶台顶 其五 巫咸谷桥","author":"王翰","text":"陵谷谁知几变迁，市桥犹号古商贤。\n红尘閒看送车马，绿水静闻流管弦。\n万古山川能尚质，一时花柳自争妍。\n王家平乂君当勉，莫作临岐一怆然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13958,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"瑶台顶 其六 司马断碑","author":"王翰","text":"事业堂堂三代前，可怜碑石几多传。\n眉山手墨已无半，哲庙宸书仅得全。\n荒冢雨馀生直棘，杏园春晚少啼鹃。\n江南君到逢司马，为问渠孙若个贤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13959,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"瑶台顶 其七 巫咸谷","author":"王翰","text":"深谷逶迤策马过，松门行尽入烟萝。\n凤声出树大音作，鸟迹留沙古篆多。\n草树昔年沾帝泽，泉流今日是恩波。\n知君要上经纶策，未许烟霞理钓蓑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13960,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"瑶台顶 其八 禹城","author":"王翰","text":"空城隐隐枕鸣条，大禹卑宫万国朝。\n九数契中非出洛，八年在外独乘橇。\n雨收残垒苔痕绿，烧过高台草色焦。\n君去明州经会稽，神祠走奠莫辞遥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13961,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柏塔寺 其一","author":"王翰","text":"嵓隈寺古极幽寻，石径人稀苔藓深。\n宝铎有声生晚籁，柏林无雨结秋阴。\n山猿抱子眠青竹，野鹿生麑下碧岑。\n君正妙年方树立，未甘习静便投簪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13962,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柏塔寺 其二 正心堂","author":"王翰","text":"昔人经制有规箴，名扁公堂作正心。\n方寸不欹天地位，气机才动鬼神临。\n无私自觉琴书乐，有止何劳簿领寻。\n分手属君崇此志，他年阶下有棠阴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13963,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柏塔寺 其三 巫咸顶","author":"王翰","text":"孤峰削出冠群山，古洞阴风振画栏。\n翠竹尚敲环佩冷，白云犹点鬓毛斑。\n两朝勋耀壁经在，千古斜阳草树闲。\n于此送君还有拟，商家相业尚能攀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13964,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柏塔寺 其四 孤石岭","author":"王翰","text":"鸟道萦纡入太虚，云根百丈峙山隅。\n锦苔春滑支机后，玉骨秋寒塞海馀。\n苍怪合教狂米拜，秀灵端似美人居。\n南归送过石城下，好倩西风雁寄书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13965,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柏塔寺 其五 杨公祠","author":"王翰","text":"中条山下古祠荒，祠下疏槐叶半黄。\n五载醉乡心兀兀，一封谏疏语琅琅。\n朝廷独立寸心赤，岭徼思归两鬓霜。\n此去却当书上考，五云飞出紫泥香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13966,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柏塔寺 其六 玉溪","author":"王翰","text":"树阴回合四围山，一道飞泉转玉环。\n嫩竹扫花风外亚，新苔封字雨中斑。\n韦编三绝谁能赞，麟笔千年独可攀。\n更羡君才长史学，会看执政纪朝班。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13967,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柏塔寺 其七 中条山","author":"王翰","text":"首尾相蟠千里来，中分关陜势崔嵬。\n凿开地脉黄流出，劈破云根翠壁开。\n古雪埋峰明剑戟，苍烟锁树失楼台。\n金陵自古多佳丽，诗到钟山不易裁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13968,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柏塔寺 其八 李绰堰","author":"王翰","text":"长堤西去势蜿蜒，经理相传大定贤。\n秋蚓行泥身确确，苍龙照水影翩翩。\n绿杨三月飞春雪，碧草千年起暮烟。\n君到汴河南去路，拟将诗句咏当年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13969,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柏塔寺 其九 原上寺","author":"王翰","text":"高原古刹四无邻，水石清幽洗毒尘。\n林下诵经翻贝叶，篱边扫雪折霜筠。\n风回峻岭猿声响，雨过沿溪虎迹新。\n护国招提有真印，参禅应现宰官身。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13970,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柏塔寺 其十 谯楼秋望","author":"王翰","text":"楼下九衢千丈尘，楼头爽气豁烦襟。\n秋高姑射林烟薄，霜落长汾雁影沉。\n万物生成君相力，二仪清静圣贤心。\n掀髯大笑无人识，徙倚阑干独自吟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13971,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读冯瀛王长乐叙","author":"王翰","text":"五朝荣宠正堪羞，忍更为文耀士流。\n节义却交王妇立，安危徒羡聂生忧。\n兔园文鄙谁堪读，乡国台高谩久留。\n闭口安身窃师保，不知谁起告嘉猷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13972,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送丁大尹之稷山","author":"王翰","text":"百里歌谣化已深，改辕何以慰民心。\n情高未减蓝田记，道重宜横单父琴。\n姑射月高秋寂寂，素汾霜落晚沉沉。\n福星今夜西南望，一片闲云思不任。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13973,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宿介休","author":"王翰","text":"吟断西风首重搔，一肩行李不胜劳。\n云移天影霁光淡，雨洗山容秋气高。\n末路艰危心易感，少年凌轹意偏豪。\n月明孤馆不成梦，起坐挑灯读楚骚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13974,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"上张思广助教","author":"王翰","text":"岁月多因酒破除，自惭弹铗为歌鱼。\n万夫胆气双蓬鬓，四海声名一草庐。\n霍岳雨晴神惠溥，尧祠风煖圣心虚。\n年来顿有江湖梦，且莫频修光范书。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":13975,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]