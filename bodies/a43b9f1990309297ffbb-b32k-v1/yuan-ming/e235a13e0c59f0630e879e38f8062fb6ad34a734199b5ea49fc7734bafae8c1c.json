[{"title":"和戍妇陈闻雁有感 其三","author":"王逢","text":"两地何知死与生，雁来愁听月边声。\n多应万里孤飞影，只抵长门一片情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3632,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和戍妇陈闻雁有感 其四","author":"王逢","text":"江南江北荻花生，妾处君边第一声。\n何似春风湖上宅，银筝玉柱白头情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3633,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送于子实辟淮阃掾","author":"王逢","text":"淮海风高急鼓鼙，颍州烽火照淮西。\n糇粻几道通流马，楼橹重城望火鸡。\n星入夜寒芒角动，地连秋暝瘴氛低。\n君今掉鞅元戎幕，肯慰流亡父老啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3634,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄题琐宪臣万户星湖钓隐图","author":"王逢","text":"笳鼓归来理钓丝，星连文石漾沦漪。\n征袍渐喜团花暗，小艇还从细柳维。\n边地雪霜怜马革，五湖烟雨梦鸱夷。\n野人不待传双鲤，出钓珊瑚寄一枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3635,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送葛玄素住持普福宫","author":"王逢","text":"海虞山色秀屏开，紫气丹光涌玉台。\n父老旧瞻双凤下，神仙今跨五羊来。\n绿林烽火沉虚璧，蔓草春风转上台。\n闻有子规栖未稳，长松宜傍井边栽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3636,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"简林叔大都事","author":"王逢","text":"省闱无事日盘桓，犹是中朝供奉官。\n半臂缥绫披月下，三神珠阙望云端。\n庄蓠草变鲸波落，苜蓿花开雁塞寒。\n因话朔南声教在，一回相对客怀宽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3637,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"简张光弼员外","author":"王逢","text":"瘦马羸童退食迟，倒衣相见即相知。\n风流不减张京兆，心迹无惭柳士师。\n枕上燕莺鸣曙日，道旁花絮罥游丝。\n天机人事观都遍，笑约西山剩采芝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3638,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和沈掾中秋月","author":"王逢","text":"月入高天更漏迟，天香消尽桂花枝。\n金晶气爽飘风露，银汉波翻动鼓旗。\n蟋蟀满林罗袖湿，骆驼千帐笛声悲。\n柴门此夜光如练，喜与休文一咏诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3639,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"简任伯温检校二首 其一","author":"王逢","text":"旌旗交影凤池边，退食微闻午漏传。\n犹比至元无事日，印文铜绿长苔钱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3640,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"简任伯温检校二首 其二","author":"王逢","text":"官厨日送蒲萄酒，画省春看芍药阑。\n不忘旧为丞相掾，手图天马献金銮。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3641,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"淀湖舟中怀谢府倅履庵","author":"王逢","text":"月破山河影，天垂雾露阴。\n西风寒不竞，东井夜空临。\n独棹沧波阔，疏灯落木深。\n无官恤民隐，思尔细论心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3642,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"近故二首 其一","author":"王逢","text":"近故儒林老，于予起叹嗟。\n清秋书柿叶，落日赋桃花。\n碑碣留吴满，云山向越赊。\n多情楚宫月，来照未栖鸦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3643,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"近故二首 其二","author":"王逢","text":"近故维扬老，威仪本汉官。\n才高《三礼赋》，心折一泥丸。\n露气金盘湿，箫声碧落寒。\n空馀茂苑树，鹃血几时乾？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3644,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"邻饮","author":"王逢","text":"蜡炬绕红鸾，盆花玉露漙。\n无家憎月色，多难薄春寒。\n毛颖时旌鬼，黄金少铸官。\n西邻浊酒熟，得罄一回欢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3645,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄契正字","author":"王逢","text":"君迁正字职，秩视校书郎。\n太乙藜分焰，铜仙露湛光。\n鹓班清漏里，鹤驾霱云傍。\n署转宫花密，沟迂御柳长。\n芸窗填竹素，蓬观启银铛。\n鱼豕知讹舛，铅黄属订详。\n圣王经贯道，家世桂名坊。\n一气根幽朔，群英萃豫章。\n比蒙青眼待，益见白眉良。\n传癖称元凯，文宗得子昂。\n冠将峨獬廌，豺已避康庄。\n大器遭斯运，凡材信彼苍。\n哭亲岚瘴邑，怀友月萝房。\n病谢台臣荐，书烦驿使将。\n暖馀牛背日，寒远马蹄霜。\n野褐方山帽，畦蔬德操桑。\n策陈怜贾谊，裾曳耻邹阳。\n任性何孤僻，伤时或慨慷。\n圜丘虚墠壝，太庙摄烝尝。\n珥笔谁丹扆，纡金尽玉堂。\n海涵恩靡极，衮补责宜偿。\n十样笺霞粲，双壶酒雪香。\n珠玑新杰作，龙虎古雄疆。\n好约重觞咏，秦淮夜对床。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3646,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"简夏嘉定","author":"王逢","text":"百里绕吴烟，重过喜地偏。\n深城迟闭户，细港倒回船。\n暮汐蛏开甲，秋原木放绵。\n民风返淳厚，正赖使君贤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3647,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"扁舟","author":"王逢","text":"扁舟何所好，日夜不相离。\n风雨情难测，山河影暗移。\n采蘋游女惯，载鹤去官宜。\n一任无依著，黄头莫漫维。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3648,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠穷独叟","author":"王逢","text":"穷阴结长寒，木介河生澌。\n旷野独兽号，异乡孤臣悲。\n薜衣带胡绳，三年限朝仪。\n岂徒无炊火，顾有麻斩齐。\n身幸免污辱，言之泪交颐。\n脱急藉朱家，吊古怀要离。\n溯风酒三酹，老气吞畎夷。\n誓刳枭獍肉，用塞乌鸟饥。\n汉酬张良志，吴乞伍员师。\n行歌《独漉篇》，以继《从军诗》。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3649,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂题四首 其一","author":"王逢","text":"洄塘昨夜绿波增，偶策交州鬼面藤。\n一雨百花香洗尽，流春矼上立鱼鹰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3650,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂题三首 其二","author":"王逢","text":"紫桐生乳竹含胎，草细花幽石径回。\n独自去来人不觉，茶烟风扬过池台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3651,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"杂题四首 其二","author":"王逢","text":"几杖琴尊共一丘，燕归巢近午香篝。\n游丝不挂山人眼，直趁东风入别楼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3652,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄完哲清卿参政其婿某近卒","author":"王逢","text":"大参久别况何如，萼绿花开雁又过。\n卖剑买牛时可得，据鞍上马老无多。\n鱼随春信登先豆，鸷匿寒形在旧罗。\n孰料周郎美甥馆，一床鸳绣拆孀娥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3653,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江边竹枝词八首 其一","author":"王逢","text":"游鲤客山高刺云，天门山小旧称君。\n插江鹅鼻移沙脉，愁杀浪撞黄歇坟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3654,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江边竹枝词八首 其二","author":"王逢","text":"乱石呀声大小湾，石中无玉作连环。\n楚江风浪吴烟雨，翠锁修眉八字山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3655,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江边竹枝词八首 其四","author":"王逢","text":"南北两江朝暮潮，郎心不动妾心摇。\n马驼少个天灯塔，暗雨乌风看作标。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3656,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江边竹枝词八首 其五","author":"王逢","text":"北望大江南望城，席帽马鞍屏障横。\n侬是小山渔泊户，水口风门过一生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3657,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江边竹枝词八首 其六","author":"王逢","text":"石筏横津蛟莫窥，近山张弩或眠旗。\n侬作神衫与神女，祈水祈风郎不知。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3658,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江边竹枝词八首 其七","author":"王逢","text":"巫子惊湍天下闻，商人望拜小龙君。\n茹藘草染榴红纸，好剪凌波十幅裙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3659,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江边竹枝词八首 其八","author":"王逢","text":"潮落蟆山连狗沙，黄泥鞋浦趁江斜。\n阿侬十指年娇小，曾比个中春荻芽。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3660,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丙戌岁将赴京师途中送徐明德归镇江","author":"刘基","text":"疲马怀空枥，征衣怯路尘。\n那堪远游子，复送欲归人。\n月满西津夜，花明北固春。\n论文应有日，话别莫悲辛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3661,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过南望时守闸不得行","author":"刘基","text":"客路三千里，舟行二月馀。\n壮颜随日臧，衰鬓受风疏。\n蔓草须句国，浮云少吴墟。\n愁心如汶水，荡漾绕青徐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3662,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"发景州","author":"刘基","text":"澹澹夕风作，萧萧芦叶鸣。\n林间众鸟息，河上一舟行。\n海近云常湿，天虚月更清。\n神京看渐近，且缓望乡情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3663,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过闽关九首 其三","author":"刘基","text":"建溪激箭向南流，石齿如锋斗客舟。\n篙子踏歌浑不畏，行人遥望替生愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3664,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过闽关九首 其六","author":"刘基","text":"漠漠轻云结晚阴，依依斜日挂遥岑。\n炊烟忽起桑榆上，散作鲛绡抹半林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3665,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"钱塘怀古得吴字","author":"刘基","text":"泽国繁华地，前朝旧此都。\n青山弥百粤，白水入三吴。\n艮岳销王气，坤灵肇帝图。\n两宫千里恨，九子一身孤。\n设险冯天堑，偷安负海隅。\n云霞行殿起，荆棘寝园芜。\n币帛敦和议，弓刀抑武夫。\n但闻当守奏，不见立庭呼。\n鬼蜮昭华衮，忠良赐属镂。\n何劳问社稷，且自作欢娱。\n粳稻来吴会，鱼鼋出具区。\n至尊巍北阙，多士乐西湖。\n鹢首驰文舫，龙鳞舞绣襦。\n暖波摇襞积，凉月浸氍毹。\n紫桂秋风老，红莲晓露濡。\n巨螯擎拥剑，香饭漉雕胡。\n蜗角乾坤大，鳌头气势殊。\n秦庭迷指鹿，周室叹瞻乌。\n玉马违京辇，铜驼掷路衢。\n含容天地广，养育羽毛俱。\n橘柚驰包贡，涂泥赋上腴。\n断犀埋越棘，照乘走隋珠。\n吊古江山在，怀今岁月逾。\n鲸鲵空渤澥，歌咏巳唐虞。\n鸱革愁何极，羊裘钓不迂。\n征鸿暮南去，回首忆莼鲈。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3666,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"读史有感","author":"刘基","text":"千古怀沙恨逐臣，章台遗事最酸辛。\n可怜日暮高唐梦，绕尽行云不到秦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3667,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感兴七首 其二","author":"刘基","text":"清时不乐道干戈，鼯鼠其如虎豹何。\n淮海风云连鼓角，湖山花木怨笙歌。\n紫微画省青烟入，细柳空营白骨多。\n惆怅无人奏丹扆，侧身长望涕滂沱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3668,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感兴七首 其四","author":"刘基","text":"将军意气薄丹霄，欲把孤航截海潮。\n苏武节来无忌死，岑彭营恶子阳骄。\n鸱鸮诗奏忠谁白，松柏歌成恨岂销。\n怅望天涯一洒泪，鲸鲵罔象杂三苗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3669,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感兴七首 其五","author":"刘基","text":"落日悲风云满川，家家闭户少炊烟。\n也知渤海无龚遂，漫忆邯郸有鲁连。\n三尺青萍思出匣，数茎白发望归田。\n请看如镜南楼月，此夜清光最可怜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3670,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感兴七首 其六","author":"刘基","text":"天弧不解射封狼，战骨纵横满路傍。\n古戍有狐鸣夜月，高冈无凤集朝阳。\n雕戈画戟空文物，废井颓垣自雪霜。\n漫说汉庭思李牧，未闻郎署遣冯唐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3671,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感兴七首 其七","author":"刘基","text":"天上九关森虎豹，人间七泽起龙蛇。\n尘埃不辨风云色，雨露全归枳棘花。\n秦国有人迷鹿马，周郊无土载虫沙。\n淮濆何日歌常武，肠断严城戍鼓挝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3672,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"越山亭晚望","author":"刘基","text":"越绝孤城枕海湄，越王亭下景迟迟。\n云埋夏后藏书穴，草没秦皇颂德碑。\n凿齿未驯虞礼乐，戈船犹驻汉旌旗。\n春风淡荡吹杨柳，笑看吴钩有所思。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3673,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谒夏王庙有感","author":"刘基","text":"一片宫垣粉雘新，前王陵庙在松筠。\n玉书金简归天地，贝叶昙花诧鬼神。\n沧海波涛纡职贡，山川草木望时巡。\n苗顽未狎虞阶舞，空使忠良泪满巾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3674,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"冬暖","author":"刘基","text":"今年南国天气暖，十月赤城桃有花。\n江枫未肯换故色，汀草强欲抽新芽。\n野畦落日舞残蝶，小池过雨喧鸣蛙。\n城上几时罢击柝，愁见海云蒸晚霞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3675,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"不寐","author":"刘基","text":"不寐月当户，起行风满天。\n山河青霭里，刁斗白云边。\n避世惭商绮，匡时愧鲁连。\n徘徊怀往事，恻怆感衰年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3676,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"漫成","author":"刘基","text":"春雨日日送愁来，雨中百花浑未开。\n青山不见神禹穴，碧草巳满越王台。\n鱼儿弄水浮还没，燕子寻巢去却回。\n头白扬雄懒献赋，衡门从此掩蒿莱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3677,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夏日杂兴七首 其四","author":"刘基","text":"故里无书问远游，他乡萍梗漫淹留。\n盲风怪雨蛟龙喜，荒楚寒芜燕雀愁。\n天上古今星北拱，人间日夜水东流。\n谁能走报西王母，乞与还丹驻黑头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3678,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夏日杂兴七首 其五","author":"刘基","text":"层楼迢递俯清郊，天际群山槛外交。\n日暖水禽鸣哺子，风轻沙燕语寻巢。\n绿荷雨洗藏龟叶，翠竹烟寒集凤梢。\n可叹仲宣归未得，苦吟终日倚衡茅。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3679,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夏日杂兴七首 其六","author":"刘基","text":"夏至阴生景渐催，百年巳半亦堪哀。\n葺鳞不入龙螭梦，铩羽何劳燕雀猜。\n雨砌蝉花粘碧草，风檐萤火出苍苔。\n细观景物宜消遣，寥落兼无浊酒杯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3680,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夏日杂兴七首 其七","author":"刘基","text":"菱叶荷花渐满池，红榴绿筱正相宜。\n天边日出园葵觉，地底云生柱础知。\n长夏未应炎暑过，薄寒恰似晚秋时。\n朝来苦怪双青鬓，辄向风前学素丝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3681,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夏日访王友文留饮赠诗","author":"刘基","text":"长夏园林白昼闲，高轩留客雨漫山。\n倾壶竹叶沉沉绿，落树杨梅颗颗殷。\n槛外新荷摇水佩，檐前弱柳舞风鬟。\n醉来带月浮舟去，忘却尘埃世路艰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3682,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵高则诚雨中三首 其一","author":"刘基","text":"短棹孤篷访昔游，冷风凄雨不胜愁。\n江湖满地蛟螭浪，粳稻连天鼠雀秋。\n莫怪贾生偏善哭，从来杞国最多忧。\n绝怜窗外如圭月，只为离人照白头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3683,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵高则诚雨中三首 其二","author":"刘基","text":"霖雨萧萧泥客途，岁华冉冉隙中徂。\n不知燕赵车千乘，何似嵩邙饭一盂。\n露冷芙蓉捐玉佩，天寒薏苡结明珠。\n东邻艇子如堪借，去钓松江巨口鱼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3684,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵高则诚雨中三首 其三","author":"刘基","text":"吴苑西风禾黍黄，越乡倦客葛衣凉。\n楸梧夜冷鸟惊树，霜露秋清蜂闭房。\n天上出车无召虎，人间卖卜有王郎。\n干戈满目难回首，梦到空山月满堂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3685,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和谦上人秋兴七首 其一","author":"刘基","text":"一自中原万马奔，江淮今有几州存。\n龙韬豹略痴儿戏，秾李夭桃猛士门。\n废垒秋风销战骨，荒郊夜雨泣冤魂。\n江湖愁绝无家客，伫立看天泪眼昏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3686,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和谦上人秋兴七首 其二","author":"刘基","text":"东海波涛激迅飙，西风氛雾虎狼骄。\n高牙画戟尊方伯，绣段黄封出内朝。\n无客金戈桩凿齿，有人玉帐舞弓腰。\n武陵日暮桃花尽，何处林泉可采樵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3687,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和谦上人秋兴七首 其四","author":"刘基","text":"浙江流水绕东吴，佳丽犹传故国都。\n红锦漫山春雨后，黄云压树晓霜馀。\n娇莺逐暖归牙帐，征雁冲寒送羽书。\n惆怅南园钓舟子，蒺藜满地不胜锄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3688,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和谦上人秋兴七首 其五","author":"刘基","text":"绣幕香帏隐日华，金鞍玉辔巧矜誇。\n深山雾雨貙生虎，大海波涛虺作蛇。\n朴樕有枝寒集鹊，梧桐无叶夜啼鸦。\n凉风袅袅吹游子，何处松楸是汝家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3689,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和谦上人秋兴七首 其六","author":"刘基","text":"故乡知己不曾逢，满目云山恨万重。\n斥堠霜清寒夜柝，谯楼风急晓城钟。\n此时绕树怜乌鹊，异县携家想駏蛩。\n独向晴檐问梅蕊，数枝和雪为谁容。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3690,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和谦上人秋兴七首 其七","author":"刘基","text":"江上悲风起白波，山中芳草柰愁何。\n紫菱青荇鲛人舞，翠藟苍藤木客歌。\n旷野烟尘迷虎兕，长亭泥泞没骊騧。\n浊河日夜东流去，肠断霓旌影馺娑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3691,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵和天童良上人见寄","author":"刘基","text":"不辞尘匣掩青萍，愿见天边陨盗星。\n白日有时容黑子，紫微终古照玄冥。\n轻风瀹雪归兰汜，细雨涵春入草亭。\n但得此身强健在，江山相见眼长青。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":3692,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]