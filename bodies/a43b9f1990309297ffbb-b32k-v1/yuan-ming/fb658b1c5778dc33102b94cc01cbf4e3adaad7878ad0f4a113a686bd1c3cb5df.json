[{"title":"王志元邀度岁不及赴敬答以诗","author":"郭钰","text":"东门问来使，晚岁许相迎。\n野树悬云气，江波挟雨声。\n虎饥寒更出，驴瘦滑难行。\n好是城南酒，灯前只自倾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6509,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"除夕","author":"郭钰","text":"短日如年度，宁知岁又残。\n乡关一水隔，风雪五更寒。\n寄食囊垂罄，更衣带尽宽。\n主人供帐好，独作太平看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6510,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江路","author":"郭钰","text":"江路雪棱层，囊空仗友朋。\n炊烟晨减米，乞火夜分灯。\n白鸟踰青嶂，苍松舞翠藤。\n乡关长在望，归梦久无凭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6511,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"忆弟","author":"郭钰","text":"时危思共济，谋拙阻相闻。\n念母谁无子，持家尔不群。\n江烟寒织雨，山鸟暝穿云。\n怅望归无计，悲啼向夜分。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6512,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"元夕","author":"郭钰","text":"圣主初临御，舟车万里通。\n上元开夜禁，乐事与民同。\n灯引飞星动，帘栖香雾濛。\n谁知今夜月，照我坐书空。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6513,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和王志元雨晴","author":"郭钰","text":"客枕愁春雨，渔歌答晚晴。\n残云栖树湿，新水与桥平。\n稚子买鱼至，主人窥笋生。\n酒来即倾倒，何问阻归程。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6514,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"愁边","author":"郭钰","text":"白发逼人甚，愁边寇未平。\n江山含杀气，草树作秋声。\n谁复思何武，人多厌祢衡。\n功名汗马得，儒素足相轻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6515,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"舟次峡江","author":"郭钰","text":"江上晚晴好，临行复舣舟。\n雨龙归大秀，水鸟度巴邱。\n公瑾人中杰，子贞方外游。\n时危论出处，吾道莽悠悠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6516,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题周瑜庙","author":"郭钰","text":"雄姿不可见，遗庙俯江干。\n箫鼓龙祠近，旌麾虎落残。\n树勋先葛亮，定伯走曹瞒。\n独恨三分后，无人忆汉官。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6517,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"早春江行寄周子谅","author":"郭钰","text":"茅舍一尊酒，独行江上归。\n风高去鸟疾，野迥炊烟微。\n青青麦苗长，娟娟蕨芽肥。\n寄语山中客，无为空苦饥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6518,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨夜宿竖坼","author":"郭钰","text":"倚江茅屋小，白发困淹留。\n灯影摇乡梦，雨声添客愁。\n二仪无定位，万国总深仇。\n谁省骊山事，终同草一邱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6519,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和郭顺则见寄","author":"郭钰","text":"振衣楚山晓，扇外暗飞尘。\n苏武终还汉，扬雄独美新。\n栖乌头欲白，来雁信非真。\n怀抱向谁诉，江鸥或可亲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6520,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江上","author":"郭钰","text":"江云捲飞雨，凉意静书帷。\n两岸鸟归尽，孤舟客渡迟。\n物情皆自适，人事每无悲。\n不惜买山早，黄金何可期。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6521,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄欧阳奎文周","author":"郭钰","text":"长笑对南山，浮名不似閒。\n布衣经岁月，茅屋寄乡关。\n山晓捲帘坐，雨凉看竹还。\n今辰是好日，把酒桂花间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6522,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"壬寅正月十三日客退后书","author":"郭钰","text":"酒从前日尽，客又几人来。\n扫石俯流水，煮茶看落梅。\n为儒生事拙，会友好怀开。\n但得情无愧，妻孥不用猜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6523,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"用前韵酬曹彦明","author":"郭钰","text":"江上一杯酒，春风今再来。\n将心托芳树，回首见青梅。\n沈醉有时醒，閒愁何日开。\n海翁机未息，鸥鸟故相猜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6524,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"同李主敬赠李将军修陇西公墓","author":"郭钰","text":"李侯将家子，重拜陇西坟。\n宰树回元气，丰碑补旧文。\n子孙长振耀，翁仲亦欢忻。\n侧想神灵语，嗟君用意勤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6525,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春雨","author":"郭钰","text":"日夜雨悬悬，问春春可怜。\n好花俱薄命，似我负芳年。\n云气低帘外，江声到枕前。\n何时是寒食，早已禁厨烟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6526,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"桂林对雪","author":"郭钰","text":"高阁延飞雪，浮浮天际来。\n乱飘随地阔，急舞逐风回。\n寒压晨烟湿，光摇暖气开。\n四山势欲合，双桂立崔嵬。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6527,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登楼","author":"郭钰","text":"茅屋厌卑湿，登楼思不群。\n天边春色早，窗外暮寒分。\n把酒邀归鸟，捲帘惊宿云。\n直须借一榻，高卧避尘纷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6528,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"哭吴林镇抚","author":"郭钰","text":"幕府十年别，烟尘暗楚关。\n全家归浙右，匹马老兵间。\n剑术终难试，铭旌复不还。\n故人谁在侧，魂断万重山。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6529,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"经周进士闻孙墓二首（次首重到一本另起） 其一","author":"郭钰","text":"白日下幽谷，孤坟宿草荒。\n文章唐进士，儿女汉中郎。\n知己长难遇，怜才久不忘。\n浦云归树暝，相顾色凄凉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6530,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"经周进士闻孙墓二首（次首重到一本另起） 其二","author":"郭钰","text":"青山山下屋，重到最伤神。\n门掩桐阴日，池分草色春。\n雨云翻覆手，石火去来身。\n误杀空梁燕，归寻旧主人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6531,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中有怀","author":"郭钰","text":"山中十日雨，满眼绿阴成。\n园减蜜蜂课，树藏莺鸟声。\n旧游多扫迹，久别每关情。\n肝胆竟谁是，凄凉白发生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6532,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"游山观佛堂和李尚文少府题","author":"郭钰","text":"细雨凉生树，归云暝入楼。\n灯悬金粟并，香蓊翠烟流。\n秀老诗多好，川明醉肯留。\n濯缨吾欲往，春浦水如油。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6533,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"十一月二十四日彦充弟忌日因叹成诗","author":"郭钰","text":"瘗骨荒山道，凄凉十六年。\n老兄今白发，慈母久黄泉。\n世事不如意，修途无息肩。\n梦回孤客枕，犹自泪涓涓。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6534,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋晚","author":"郭钰","text":"独坐不知晚，捲帘云正归。\n门因无客闭，事久与心违。\n墟曲苍烟合，林梢黄叶飞。\n老怀付萧散，行到钓鱼矶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6535,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九月朔日发家书","author":"郭钰","text":"黄菊尽开未，主翁明日回。\n红飞霜径叶，翠长雨阶苔。\n病眼隔重雾，狂心著冷灰。\n但须压新酒，兼有故人来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6536,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄李子晦","author":"郭钰","text":"怀刺将安往，闭门空自勤。\n山岩宜置我，风月每思君。\n挥翰唾成玉，飞觞气吐云。\n春来林木变，鹤唳不曾闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6537,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山馆","author":"郭钰","text":"偪侧不敢怨，飞腾殊未能。\n野猿时送果，山鬼夜吹灯。\n口腹久为累，语言难尽凭。\n白头方检束，饱肉愧饥鹰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6538,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山馆二首 其二","author":"郭钰","text":"贴石支松榻，闭门收蠹编。\n故人久不至，病客得高眠。\n松搐晚风怒，帘分夜雨悬。\n老禅应可学，世故苦相牵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6539,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"己巳元日次从侄澜韵","author":"郭钰","text":"太平应有象，王国早生申。\n云捧虞渊日，天开寿域春。\n千年周鼎重，百战汉兵神。\n侧想朝元殿，征南献凯频。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6540,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和萧伯章见寄","author":"郭钰","text":"王孙文采盛，千里入神交。\n贫极锦囊在，愁来金盏抛。\n雨迎龙出峡，云护鹤归巢。\n欲寄相思意，梅花霜后梢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6541,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"黄州有警闻从弟銈已过兴国度早晚可抵家","author":"郭钰","text":"戎马压黄州，君先理去舟。\n艰难千里远，贫贱一身浮。\n宿将今谁在，亲王只自谋。\n长江如失险，乡国足深忧。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6542,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"忆从弟铎","author":"郭钰","text":"忆昨王师捷，还乡近五年。\n艰危惟我共，俯仰得谁怜。\n茅屋秋风里，烽烟夕照边。\n乱离今转甚，思尔只高眠。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6543,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"野宿","author":"郭钰","text":"谁谓归田好，荒烟暗棘丛。\n边愁攒战马，野宿逐征鸿。\n捆屦山涵雨，煎茶竹送风。\n读书成濩落，拟学六钧弓。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6544,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄吴杜徵君","author":"郭钰","text":"武夷空翠接秋阴，古木萧森石径深。\n中使又传丹诏至，山人长对白云吟。\n松花未扫风过席，芝草初耘雨满林。\n九曲画图归内府，君王应许遂初心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6545,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送龙光庭赴都","author":"郭钰","text":"帝城此去人千里，马上题诗记旧游。\n官酒满传鹦鹉盏，宫花飞点鹔鹴裘。\n星回东壁文光动，日丽中天王气浮。\n礼乐百年多述作，才贤深足应旁求。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6546,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登宜春卫公岩","author":"郭钰","text":"卫公旧日读书处，濩落孤亭紫翠中。\n野迥虹光分暮雨，天晴木叶响秋风。\n武皇国势资雄略，牛党私仇累至公。\n论定是非谁复在，晨钟空托梵王宫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6547,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送胡元礼归合淝省亲","author":"郭钰","text":"秋风林薄暮萧骚，千里庭闱属望劳。\n天入秦关开去棹，霜飞楚峡拥征袍。\n每看潘岳閒居好，始信张翰归去高。\n我亦天涯漂泊久，因君愁思满江皋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6548,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和虞学士春兴八首 其一","author":"郭钰","text":"官河春水涌轻涛，来往千艘不用篙。\n江浦女游遗玉佩，瑶池仙降献金桃。\n鞦韆拔地烟花暝，阊阖中天日月高。\n早岁功名看得意，扶摇风力送鸿毛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6549,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和虞学士春兴八首 其二","author":"郭钰","text":"鸣佩天阶委碧莎，雪消太液涨晴波。\n玉盘露浥仙人掌，宫锦花添织女梭。\n王子问安回辇近，儒臣进讲赐金多。\n明朝引见狒狼使，乐府新传《天马歌》。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6550,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和虞学士春兴八首 其三","author":"郭钰","text":"沙苑烟晴苜蓿肥，朝回天马锦为鞿。\n词臣会送归青琐，进士传呼换白衣。\n云气晓依宫树近，春阴昼护苑花飞。\n君王又进长生药，万里楼船海上归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6551,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和虞学士春兴八首 其四","author":"郭钰","text":"城上觚棱雾霭迷，角声吹彻鼓声齐。\n云生水殿龙常现，月满官松鹤并栖。\n风俗元存中国旧，天文并拱北辰低。\n倚楼欲问通霄路，谁借青云百尺梯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6552,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和虞学士春兴八首 其五","author":"郭钰","text":"万里驱车入帝关，十年栖息一枝安。\n承恩数对麒麟殿，却老何资龙虎丹。\n金水涨波融雪尽，碧桃分蕊到春阑。\n江南却忆看红药，纨扇罗衣不识寒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6553,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和虞学士春兴八首 其六","author":"郭钰","text":"清明烟散柳枝斜，宫树沈沈点白鸦。\n煖雾扑帘成细雨，朔风吹面射飞沙。\n江南最忆王孙草，天上催宣宰相麻。\n十载沧洲孤旧约，鹿车何日共还家？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6554,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和虞学士春兴八首 其七","author":"郭钰","text":"柳林笳鼓晓晴饶，王子春蒐出近郊。\n云锦宫袍攒万马，铁丝箭镞落双雕。\n蒲萄压酒开银瓮，野鹿充庖藉白茅。\n共说从官文采盛，不闻旧尹赋《祈招》。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6555,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和虞学士春兴八首 其八","author":"郭钰","text":"浩荡天风驾海航，忍从儿女问耕桑。\n珠联鱼目知谁识，剑吐龙光不自藏。\n司马倦游曾建节，买臣归去密怀章。\n只今岂是无词赋，材俊中朝少荐扬。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6556,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送王国琛使君赴福州","author":"郭钰","text":"闽峤来迎新太守，旌麾遥飏海云低。\n天书夜下群龙会，露冕春行五马齐。\n荔子已无中使敕，绣纹犹作白衣题。\n伫看到日传嘉政，棠树春阴满建溪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6557,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赋得越王台送万载敖司令之官","author":"郭钰","text":"层台高与越山齐，南斗诸星入地低。\n海气秋澄鸿雁到，野烟春合鹧鸪啼。\n官船北走输珠翠，幕府南开振鼓鼙。\n侧想到官多暇日，登临长听玉骢嘶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6558,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送萍乡袁茂才归县试吏","author":"郭钰","text":"玉关门外班司马，抗疏归来白发愁。\n绝域功名空老大，少年乡国自风流。\n花飞细雨朝回马，月满前川夜放舟。\n始信封侯驰万里，不如吏隐近沧洲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6559,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄孙仲植文学","author":"郭钰","text":"秋来最忆孙文学，无数黄鸡啄黍肥。\n得酒定邀诸弟饮，看萸应少一人归。\n苍龙出峡雨先至，白马渡江云共飞。\n季子敝裘今更少，还乡信使故应稀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6560,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄阮弘济兼简杨亨衢少府","author":"郭钰","text":"旧时文物数江东，谁似风流阮嗣宗。\n红袖醉歌《金缕曲》，牙旂归导玉花骢。\n神仙元与尘埃隔，宾客多应气概同。\n寄语龙泉杨少府，园花不减旧时红。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6561,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柬王奎伯仲","author":"郭钰","text":"我爱王家之二难，越罗裁剪春衫宽。\n折花满簪紫茸帽，写诗自作乌丝阑。\n玉壶载酒留客醉，竹竿把钓携儿看。\n明朝更约溪南去，一树锦桃花未残。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6562,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄刘渊茂才（字象贤）","author":"郭钰","text":"山馆前宵忽梦君，纻衣如雪照晴云。\n门前种菊开三径，壁上题诗写八分。\n酒浪红深倾琥珀，剑台翠涩绣龙纹。\n多情指画秦台近，一曲鸾笙月下闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6563,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和虞学士登宜春台","author":"郭钰","text":"万家平地拥高台，窗户层层近日开。\n鹤致琼花迎帝子，龙持贝叶礼如来。\n云依老树秋如画，峡束飞涛雪作堆。\n惆怅当年歌舞地，碧桃开落几千回。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6564,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题兴冈王祠","author":"郭钰","text":"万山浓翠涌飞涛，缥缈王宫结搆牢。\n兵卫焜煌连锁甲，香烟浮动郁金袍。\n晨飞脉岭云初散，夜舞胎山月正高。\n仙苑碧桃春自醉，岂容野客荐溪毛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6565,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"澄虚亭","author":"郭钰","text":"匹马江上行且停，苍松夹道风泠泠。\n波光倒吞落日白，云气下接炊烟青。\n山僧独行扫残叶，水鸟双飞回远汀。\n主人邀客领奇胜，赋诗把酒澄虚亭。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6566,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赋鹤骨笛","author":"郭钰","text":"云沈碧海葬飞仙，乐府新裁紫玉员。\n律吕相和依象管，雌雄犹似唳芝田。\n老蛟夜舞君山月，采凤春游嶰谷烟。\n想是好奇心独苦，琵琶昨日购鹍弦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6567,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赋文山砚","author":"郭钰","text":"碧玉秋涵晓露滋，相君十载共襟期。\n承恩久在文章府，借润终无软媚词。\n旗舞龙蛇廷对早，诗成珠玉载归迟。\n可怜月落空坑夜，无复追随到凤池。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6568,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"早秋有怀欧阳文周","author":"郭钰","text":"日暮独回江上舟，江波不尽思悠悠。\n虹垂青涧分残雨，风满碧梧鸣早秋。\n用世有材须汲引，思君为客久淹留。\n綵楼七夕凉如水，知共何人望斗牛。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6569,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄杨和吉","author":"郭钰","text":"不见故人愁我心，江山信美倦登临。\n附书白鹤几时到，结屋翠微何处寻。\n风撼竹楼凭雨势，云归溪树作秋阴。\n琅玕细簟凉如水，应扫桂花弹素琴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6570,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和李茂才牡丹","author":"郭钰","text":"旧来声价洛阳高，歌舞千金费酒醪。\n霞拥暖红围采槛，日描晴影绣宫袍。\n百年富贵花神醉，一曲清平笔力豪。\n近说开筵追胜事，诗成压倒旧官曹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6571,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"哭宜春义士彭维凯","author":"郭钰","text":"风折旗竿卧落晖，残兵挥泪脱戎衣。\n徒闻即墨田单在，不见成都邓艾归。\n献凯何时承宠渥，争名自古抱危机。\n宜春元帅还相问，近报洪州未解围。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":6572,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]