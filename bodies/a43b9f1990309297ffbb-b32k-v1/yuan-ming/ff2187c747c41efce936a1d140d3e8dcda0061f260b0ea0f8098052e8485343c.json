[{"title":"送马编修还明州","author":"张昱","text":"当年文采动京城，尽说江南马长卿。\n青史可怜成绝笔，白头相见重关情。\n内湖柳色春仍好，小院斜阳晚更明。\n门外画船堪载酒，玉杯尽向故人倾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5046,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题张叔芳参谋南涧草堂","author":"张昱","text":"狂客构堂南涧滨，涧中濯足任鱼嗔。\n日容二仲共三径，家与万松为四邻。\n石角钩衣归骑晚，花枝妨帽小园春。\n此来不敢歌丛桂，知是淮王座上人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5047,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"岁除日，同廖如川至太尉丞相府，留坐说周易，因赐酒并官历，赋此上谢","author":"张昱","text":"岁晚谬为趋府客，深惭款接异他人。\n说经每笑匡衡老，赐酒何容毕卓真？\n明日千官瞻魏阙，几时万国共阳春？\n家乡似觉无归处，难拟酬恩致此身。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5048,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠太史子玄还闽中，子玄侍其师贡秘卿由海道遂赴京师，至浙西，秘卿死","author":"张昱","text":"险阻蛟龙又则那，只缘有路接天河。\n少年谩动乘桴兴，中道俄闻曳杖歌。\n司马壮游空岁月，杜陵归梦隔山河。\n凭君莫下穷途泪，何处深山无薜萝？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5049,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"右丞周伯温出示前为宣文阁授经郎代祀孔子庙，次韵","author":"张昱","text":"万世斯文有耿光，端然龙衮閟宫墙。\n春秋不独尊周室，金石如闻奏庙堂。\n碑树丹楹皇帝诏，盒封黄帕内庭香。\n至今仰赖遗经在，师表前王惠后王。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5050,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送徐大章建宁路学教授","author":"张昱","text":"经籍传家二百年，河汾今在路西偏。\n文雄虎豹岂徒作，名动京师非偶然。\n教领七闽胜作郡，受知八座合称贤。\n伫看召入承明署，礼乐遗书在简编。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5051,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄我轩，为唐主敬贡士赋","author":"张昱","text":"人世有生皆我寄，看来造物亦儿戏。\n身为蝴蝶何关梦，饭熟黄粱自有时。\n形影不烦相赠答，死生同是一希夷。\n浊醪到手能成醉，此趣陶潜或可知？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5052,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送贡师泰尚书入闽，发盐粮供北军","author":"张昱","text":"尚书奉诏趋闽省，天子深为饷运忧。\n使者频来大明殿，亲军犹驻武安州。\n浮烟压地朝添灶，明月笼沙夜唱筹。\n驿路海棠迎马首，春光难为使君留。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5053,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送杜时中副使","author":"张昱","text":"南方风土要相宜，小盒槟榔好自随。\n蜑户负鱼朝入市，囝娘把烛夜题诗。\n三年旧俗犹前日，八郡良家异昔时。\n若问苍生苏息否，使车除是一驱驰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5054,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜潮","author":"张昱","text":"禁得钱塘江上潮，恼人偏在可怜宵。\n头颅如许更能白，魂魄几何仍欲消？\n浊浪渐高河影没，雄风未尽雪山遥。\n西流力尽还东下，月满空江共寂寥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5055,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自遣","author":"张昱","text":"每每樽前惜岁华，牡丹开后似无花。\n山中谩说秦为晋，海上难逢枣似瓜。\n妄想既空无得梦，神仙所至即为家。\n不须更问升沉事，看取西楼月又斜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5056,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋闺词","author":"张昱","text":"一曲哀筝感素秋，梧桐落尽碧溪头。\n御沟叶上谁题怨，锦字机中自织愁。\n纨扇恩情空望望，鲤鱼书信更悠悠。\n双星不到银河近，风浪遥于隔十洲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5057,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"无题","author":"张昱","text":"及时无物不伥伥，燕语莺啼总断肠。\n洛浦轻尘怜故步，扬州旧梦惜馀香。\n玉和獭髓宁无药，弦续鸾胶信有方。\n便把汉江都作酒，饮时犹恐负春光。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5058,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辨谤诗","author":"张昱","text":"司议因乘海上槎，河源归路未应赊。\n市中徒尔疑成虎，杯内何曾影似蛇？\n官事吉凶占鹊语，闺房消息卜灯花。\n南风乞得楼船便，六月中旬便到家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5059,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"纵饮","author":"张昱","text":"外湖里湖花正开，风情满意看花来。\n白银大瓮贮名酒，翠羽小车歌《落梅》。\n身外功名真土苴，古来贤圣尽尘埃。\n韶光如此不一醉，百岁好怀能几回？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5060,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"松筠轩，为湖州沈叔方赋","author":"张昱","text":"轩居好在松筠里，门外清溪绕屋庐。\n文物曾陪诸老后，故家似是百年馀。\n客来与酌茯苓酒，月出共看科斗书。\n若见渔郎烦借问，桃花清思近何如？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5061,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谢吴起宗写神","author":"张昱","text":"紫绶空惭老病身，每于时事与经纶。\n不呼贺监为狂客，却谓张良如妇人。\n潦倒形容何用似，荒唐言语半非真。\n凌烟画像今谁在，更与丹青写此神。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5062,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送刘庸道侍老父入闽就养","author":"张昱","text":"此别为生一怆然，福州远在海南边。\n白头病叟年八十，红树寒山路几千？\n负米既供为子职，赁车不仰故人钱。\n起居莫与槟榔远，风土他乡气候偏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5063,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"栖霞岭访姚子章","author":"张昱","text":"买得湖船为访君，望中都是北山云。\n风前杨柳惊秋晚，波面芰荷愁日曛。\n青史纵能传后世，白头休更说从军。\n栖霞有酒能留客，纵饮何妨到夜分？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5064,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送张伯雅架阁入闽省","author":"张昱","text":"闻道连年瘴气收，城中风景称清游。\n参天榕树快人意，似雪梅花当马头。\n海客朝盘送珧柱，囝娘春咏写银钩。\n毋嫌习俗闽中利，尽胜吴船唱莫愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5065,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题贯酸斋芦花被诗后","author":"张昱","text":"学士才名半滑稽，沧浪歌里得新知。\n静思金马门前直，那似芦花被底时？\n梦与朝云行处近，醉从江月到来迟。\n风流满纸龙蛇字，传遍梁山是此诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5066,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"刘生侍贡尚书入闽，卒业","author":"张昱","text":"藉甚刘生尚古文，师资贡禹卒前闻。\n从公未觉山程远，到日须知土俗分。\n红嚼槟榔霞满口，白飞鹦鹉雪成群。\n七闽自昔称文物，莫说三山尽瘴云。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5067,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感事二首 其一","author":"张昱","text":"雨过湖楼作晚寒，此心时暂酒边宽。\n杞人惟恐青天坠，精卫难期碧海乾。\n鸿雁信从天上过，山河影在月中看。\n洛阳桥上闻鹃处，谁识当时独倚阑？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5068,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感事二首 其二","author":"张昱","text":"老至翻遭世虑牵，何曾一觉得安眠？\n家乡尚远浔阳郡，世事犹如天宝年。\n朝报唯瞻辽海上，羽书不断省门前。\n长星正在天西北，白水寒沙尽可怜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5069,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨香堂，为晦冈李介夫赋","author":"张昱","text":"雷电冥冥起晦冈，百年灵气会斯堂。\n友人李愿在盘谷，高士严陵是故乡。\n薄有资囊供一老，尽将文采付诸郎。\n酒坊新斫松杉架，每日风来雨气香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5070,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题桃源州知州李尚志母暨阳县君蒋氏墓志后","author":"张昱","text":"小龙冈上有高坟，石表新题蒋院君。\n五品官荣清代爵，一封诰织紫鸾文。\n生儿何愧孙征虏，作志可无扬子云。\n归去帛焚人事毕，大夫原是旧将军。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5071,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题原善张府史具庆堂","author":"张昱","text":"张子构堂题具庆，此生捧檄为荣亲。\n府中年少固可数，幕下英才惟此人。\n尚褧锦衣加吉服，忘忧萱草共阳春。\n移忠锡类从兹起，何患风云不要津？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5072,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题推官赠行卷","author":"张昱","text":"圣主搜贤及海隅，王褒歘起应时须。\n澧兰处处歌公子，楚国人人颂大夫。\n藉甚姓名登制命，沛然霖雨下云衢。\n力田孝悌兴岩穴，何异福王遗画图？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5073,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖漫兴","author":"张昱","text":"玉局当年为写真，西施宜笑复宜颦。\n朝云暮雨空前梦，桃叶柳枝如故人。\n露电光阴千劫外，鱼龙波浪一番新。\n伤心最是林逋宅，半亩残梅共晚春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5074,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"清槩隐居","author":"张昱","text":"门向东吴好处开，柳花风里白鸥来。\n青山对榻容欹枕，黄鸟啼春索举杯。\n宾客偶携红袖至，庖厨新得素鳞回。\n满前清槩谁能领，消得曹公八斗才。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5075,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠仙都生","author":"张昱","text":"括苍仙都十二城，中有异人毛骨清。\n淩风振佩片霞举，乘月吹笙双凤鸣。\n山上羊眠知石化，洞中桃熟验丹成。\n长镵采药或能见，不识此生真姓名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5076,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"听雪轩","author":"张昱","text":"化机潜运本无声，学士情多睡未成。\n隐几欲同蝉壳蜕，开门惟恐鹤巢倾。\n花飞翠袖寒光动，茶煮银瓶夜气清。\n小阁下帘人似玉，舞衣制得五铢轻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5077,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"慧具庵，自滦京回","author":"张昱","text":"慧师新自上京回，坏色袈裟染劫灰。\n河汉路遥难载石，蓬莱水浅不胜杯。\n已知道骨鹤同瘦，无复机心鸥可猜。\n去把西江都吸尽，却从马祖问如来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5078,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"仙姑泉，次刘郎中韵","author":"张昱","text":"谁把丹崖手擘开，钜灵还向此中来。\n青冥风露银河近，白日雷霆碣石摧。\n神女有时成暮雨，胡麻何处是天台？\n刘郎旧不通仙籍，能得题诗在紫苔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5079,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江浙省理问朱文选为冀院君求挽诗","author":"张昱","text":"镜鸾莫更惜孤鶱，白玉台前已抱孙。\n冀院君今题凤诰，妇人贵已载鱼轩。\n何须出涕悲同穴，政可长歌为鼓盆。\n夫婿白头无所憾，只求文采赋招魂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5080,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"湖山堂观牡丹","author":"张昱","text":"秾香偏惹宦游人，银瓮连车载酒频。\n乍雨乍晴三月节，倾城倾国一年春。\n却胜飞燕为皇后，谩把惊鸿比洛神。\n若问风流谁可赋，只应宋玉是东邻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5081,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和三脚鸡士壁上韵","author":"张昱","text":"河上仙翁有洞房，几篷虽小胜舟航。\n径花妨帽青霞近，槛竹侵衣白露香。\n盘内钓鱼供过客，床头剪月照抄方。\n平生养得鸡三脚，几向人间唱晓光？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5082,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"素居诗，为山阴王思敬赋","author":"张昱","text":"养素衡门岁已深，坐看乔木几成阴？\n青云不到幽人梦，白发能知阅世心。\n负郭无田遗稚子，传家有集是黄金。\n绛霞盈颊先生醉，咏遍尧夫击壤吟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5083,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送宋倬还南康","author":"张昱","text":"及此青春还故乡，顺风几日到南康？\n峰连五老出空阔，水接二孤来渺茫。\n徐福楼船能共载，刘安鸡犬亦相将。\n山桃子落都成树，花里应迷旧草堂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5084,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答仁一初禅师次韵","author":"张昱","text":"富春江头风浪稀，富春山里薜萝垂。\n满前明月为谁好，中有高僧劳我思。\n意适定同鱼跃处，神清都在鹤鸣时。\n仰承山偈难酬答，不是张衡懒赋诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5085,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过峡石山张同知墓上作","author":"张昱","text":"平生好友说张侯，紫峡云深暮木稠。\n朱绂尚能光世泽，黄金元不为孙谋。\n衣冠南郡成前辈，风月西湖总旧游。\n过此岂胜存殁感，恨无孤剑挂山头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5086,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题若水临周昉画，用虞先生韵","author":"张昱","text":"一片行云出画檐，东风吹恨满眉尖。\n凌波鹄峙尘生步，舞镜鸾回月照奁。\n杨柳绿肥羞袅娜，樱桃红熟妒香甜。\n风流更有惊人处，呼下丹青语未淹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5087,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠王法师祈雨感应","author":"张昱","text":"名衔知久达天关，可是风雷指顾间？\n禹步祝香才一息，雷声送雨已千山。\n公私尽有仓箱望，垄亩都忘稼穑艰。\n下土不知蒙帝力，满城箫鼓送龙还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5088,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"兰窗图，为戴掾赋","author":"张昱","text":"旧家文献石屏翁，楚国高情世所工。\n捐佩忆曾过澧上，浩歌今望在云中。\n色欺翡翠滋清露，香澹蔷薇送好风。\n可是郎君玉窗里，肯将幽兴出兰丛？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5089,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"谩兴","author":"张昱","text":"浮世浮名一羽轻，百年何用较衰荣？\n满壶好酒供春酌，几尺游丝共晚晴？\n明月半遮卢女扇，飞鸿斜引谢家筝。\n扬州杜牧无拘束，每到花时最有情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5090,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送戴检校入闽","author":"张昱","text":"叨忝明时已自分，往还惟是旧斯文。\n西窗夜雨同听处，左掖官曹独有君。\n茉莉御香腾玉气，荔芰颜色染罗纹。\n风流东阁应多咏，肯与幽兰寄暮云？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5091,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"双清馆（蔡参政立名）","author":"张昱","text":"庐陵两生来作掾，齑瓮长年冰雪寒。\n中书八座共相许，华衮一字诚为难。\n风神左右映白璧，文彩上下翔青鸾。\n况闻客馆更清爽，秋色南山相对看。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5092,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送汤佥书还京","author":"张昱","text":"天上城开白玉京，仙曹列职侍金庭。\n行人半是从龙气，载笔都凭蹑凤翎。\n鳷鹊西飞云渺渺，蓬莱东望海冥冥。\n道家自古无离别，唯诵空歌送使星。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5093,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"园隐，为方员外赋","author":"张昱","text":"省郎别业苕溪上，抱瓮日游溪水边。\n花径春晴蝴蝶到，菜畦雨过桔槔悬。\n儿童惯识题诗客，鸥鸟常随载酒船。\n更说陈琳工笔札，独将文采从戎旃。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5094,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"估客","author":"张昱","text":"不用誇雄盖世勋，不须考證六经文。\n孰为诗史杜工部，谁是玄经扬子云。\n马上牛头高一尺，酒边豪气压三军。\n盐钱买得娼楼宿，鸦鹊鸳鸯醉莫分。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5095,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题前赤壁赋图","author":"张昱","text":"黄州故事今何在，汉水东流尚未穷。\n一世英雄争赤壁，百年风月属坡翁。\n吹箫俊发龙吟后，作赋才豪鹤梦中。\n二客从游雪堂夜，丹青犹与昔时同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5096,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题曹伯起云门山房","author":"张昱","text":"相国传来几世孙，山堂随处见云门。\n侯家画戟固无有，旧物青毡俱尚存。\n清誉在人瑚琏器，高情终日凤凰群。\n芝兰玉树阶庭秀，已是新承雨露恩。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5097,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送布政司周照磨赴京听除","author":"张昱","text":"沿檄回京喜可知，青云毋谓著鞭迟。\n供为臣职乃常事，简在帝心惟所司。\n宗庙岂遗瑚琏器，羽仪当会凤凰池。\n仙郎恋阙情应切，不为河梁住少时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5098,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"忠养堂，为张府掾赋","author":"张昱","text":"张氏构堂情已著，毛生捧檄事方新。\n府中才俊固多士，幕下孝廉惟此人。\n返哺老乌怜白首，宜男芳草擅青春。\n莫论日用三牲养，一面欢颜足奉亲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5099,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"筠窗图（豫章徐文珍画），为荆南曹以章赋","author":"张昱","text":"此君何可一日无，徐君为绘筠窗图。\n深居碧云怜日暮，展卷清风生座隅。\n漆简旧来销翡翠，渔竿钓罢拂珊瑚。\n荆南不近周王猎，晚节犹能宿凤雏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5100,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋水轩，为陈惟真赋","author":"张昱","text":"镜湖一曲越城边，溢岸秋波若可怜。\n雪点荷塘看鹭下，烟销沙渚见鸥眠。\n赋成骑省从斑鬓，酒在稽山信画船。\n何在望洋奔海若，轩中自足管流年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5101,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题大隐庵开士殊无别远翠楼","author":"张昱","text":"坐来未觉西山远，紫翠千重隔画阑。\n此地岂容携酒到，任谁只许捲帘看。\n佛炉香共朝云散，客椀茶分雪乳寒。\n一自得陪清论后，此心不用倩师安。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5102,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"醉渔，为钱思复赋","author":"张昱","text":"江湖犹自有狂夫，白发萧然负壮图。\n睡著任船随月走，醉归临水索花扶。\n要知吕望真渔者，可惜郦生非酒徒。\n泽畔独醒诚可咏，春风能到雪肌肤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5103,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵处士和埙上人诗","author":"张昱","text":"每到炉头忆懒残，十年戎马雪窗寒。\n乱来亦谓功名易，老去才知世路难。\n醉把茱萸应自感，狂题鹦鹉欲谁看？\n相逢白发秋风里，何惜银灯照夜阑？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5104,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"司马温公九世孙碏，持公自书独乐园记并东坡诗刻，今将二百馀年，纸不盈尺，手泽犹存。感而赋诗","author":"张昱","text":"浮云聚散岂堪论，富贵何如道德尊？\n几见蓬莱成浅水，可堪风雨换高门？\n纸图价匪千金重，手泽传能九世存。\n眼见寝园成茂草，却知司马有儿孙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":5105,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]