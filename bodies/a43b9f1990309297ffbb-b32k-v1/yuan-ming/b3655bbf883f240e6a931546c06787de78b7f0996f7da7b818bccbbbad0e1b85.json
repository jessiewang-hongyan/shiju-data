[{"title":"文心之访予山中","author":"张羽","text":"远访孤峰顶，凉荒见道情。\n别来多少事，话到二三更。\n灯影摇空壁，茶香出破铛。\n山中无一物，何以赠君行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2221,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"写怀","author":"张羽","text":"心上无俗事，禅余只好吟。\n命穷甘白屋，身健直黄金。\n世路剑关险，侯门沧海深。\n虚名何必尚，吾志在山林。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2222,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"尘事","author":"张羽","text":"春来秋又去，尘事转茫茫。\n天下若无死，人间应更忙。\n燕衔泥葺垒，蜂酿蜜为房。\n独有幽栖者，眼高空八荒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2223,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"玉泉山中怀李景山田师孟二公","author":"张羽","text":"雁落苍烟外，蝉吟夕照中。\n与谁论古道，独自立秋风。\n远岫青无数，晴波碧四空。\n故人成久别，不见寄诗筒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2224,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送同行省亲","author":"张羽","text":"送子绿杨堤，杨花如雪飞。\n相看忍相别，同出不同归。\n雁背夕阳远，马嘶春草肥。\n北堂慰孤寂，喜色动斑衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2225,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"旅怀","author":"张羽","text":"寥落无人问，青尊独自斟。\n思亲两行泪，倦客十年心。\n贫久难禁病，愁多欲废吟。\n岁寒谁可语，莫逆有孤琴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2226,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"永康道中","author":"张羽","text":"石路多盘折，秋阳向郁蒸。\n矮墙低贴水，老树倒悬藤。\n白发腰镰叟，缁衣顶笠僧。\n村醪何处问，更入乱云层。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2227,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过瓜州","author":"张羽","text":"落日瓜州渡，余寒透薄衣。\n客囊空薏苡，春色自蔷薇。\n江远水东去，天晴雁北飞。\n故山千里外，昨夜梦先归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2228,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"隐者山房","author":"张羽","text":"一龛俱绝顶，门外众山横。\n池小鱼能活，庭荒草乱生。\n窗虚延月色，林远隔钟声。\n俗客不得到，主人无送迎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2229,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠唐师善父","author":"张羽","text":"唐君天目住，诗律有唐声。\n父子同机轴，江湖识姓名。\n秋风吹破屋，夜雪洒寒檠。\n自说贫如许，儒官误一生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2230,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次李景山韵","author":"张羽","text":"道人无可爱，所嗜特清吟。\n墨痕沁春雪，灯影摇秋霖。\n试将不龟手，用鼓无弦琴。\n此意许谁会，思君沧海深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2231,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送客还山","author":"张羽","text":"乍见即言还，望云归远山。\n舟行白鸟外，路出绿阴间。\n邻父开松径，家童扫竹关。\n世途方扰扰，谁复似君闲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2232,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"访道衍上人时寓海云","author":"张羽","text":"寻僧自补屐，古寺夏云中。\n听鸟明闻性，看花悟色空。\n风传烟磬远，竹引野泉通。\n便欲捐尘累，香灯事远公。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2233,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送僧之华亭行化","author":"张羽","text":"华亭多胜概，此去几时还。\n古寺寒林外，荒城野水间。\n地灵偏有鹤，海近绝无山。\n庞老知音者，相看必破颜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2234,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠僧还日本","author":"张羽","text":"杖锡去随缘，乡山在日边。\n遍参东土法，顿悟上乘禅。\n咒水龙归钵，翻经浪避船。\n本来无去住，相别与潸然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2235,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"早春游望","author":"张羽","text":"烧灯城郭嫩寒天，早觉春光满眼前。\n山翠全轻犹带雪，柳丝才长便宜烟。\n佳人挑菜宁辞远，公子寻芳各斗先。\n从此陌头车马动，谁能闲坐负华年。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2236,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"仲春游望","author":"张羽","text":"春来结伴共闲行，此日山川色更明。\n望里楼台多见柳，静中阡陌但闻莺。\n江泬色带王孙恨，蜀魄吟伤帝子情。\n莫道韶华镇长在，落花看已满东城。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2237,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"首夏闲居","author":"张羽","text":"门巷开临曲水滨，绿阴悄悄四无邻。\n雨余高笋初迎夏，风逗残花尚驻春。\n倚杖多因闻好鸟，开樽每为爱幽人。\n疏帘清簟终朝静，只有琴书自可亲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2238,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"川上暮归","author":"张羽","text":"此地频经画舫过，暮归原不畏风波。\n烟中渔网悬杨柳，浦口船灯照芰荷。\n归鸟去边行客少，夕阳尽处乱山多。\n此时诗思浑无赖，听得前溪《子夜歌》。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2239,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋日郊居","author":"张羽","text":"萧萧晴日户庭幽，无数青山枕碧流。\n白露雨余砧欲动，黄花风冷扇初收。\n云迷征雁牵秋梦，烟引寒蝉急暮愁。\n此际不堪摇落恨，蒹葭如雪满汀洲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2240,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夜宿僧院","author":"张羽","text":"古寺昏钟日已沉，禅房花木自成阴。\n流萤远度还依草，宿鸟惊飞不出林。\n僧磬和泉清客虑，佛香入院净人心。\n夜深共讲楞伽字，始识空门义趣深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2241,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋斋早起","author":"张羽","text":"高斋独宿寝衣轻，覆簟余香似有情。\n门掩青苔秋淡泊，心同白露晓澄清。\n新诗夜得思贻友，灵药朝餐学养生。\n但乞闲身长似此，已将云雾等浮名。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2242,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋日登戴山佛阁","author":"张羽","text":"风物澄明宿霭收，登山欲尽更登楼。\n一行白雁投南下，百道清溪向北流。\n野嶂云归初歇雨，湖田稼熟始知秋。\n空门寂寂无尘事，骋望端能散客愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2243,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"岁暮山居","author":"张羽","text":"寂寂闲居隐翠微，萧萧寒日映柴扉。\n叶声乱响莓苔屐，云气时生薜荔衣。\n雪满石床门闭早，草侵棋局客来稀。\n岁寒正好看书卷，不用登高怨落晖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2244,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"行乐过西崦","author":"张羽","text":"白日都消笔砚间，偶因行乐到松关。\n秋声不尽萧萧叶，夕景无多淡淡山。\n蛩响寒斋僧自定，苔荒深院客常闲。\n已知身世俱成幻，莫叹西风鬓易斑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2245,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"僧斋寒夜二首 其二","author":"张羽","text":"山馆萧条寝复兴，经声遥出最高层。\n客愁无伴依童子，禅学多难忆古僧。\n阶下鸣蛩沿定石，竹间栖鸽避悬灯。\n远游亦有幽栖志，拟绝尘缘老未能。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2246,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄王止仲高季迪","author":"张羽","text":"祗恨孤城未解围，围开翻遣别相知。\n夕阳江上匆匆酒，细雨灯前草草诗。\n有梦直从花落后，无书空过雁来时。\n郭西古寺题名处，今日重游却共谁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2247,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"吴兴南门怀古","author":"张羽","text":"郭门南面似襄州，野树寒山对倚楼。\n公子城空无食客，霸王宅坏有荒丘。\n夕阳冉冉仍西下，秋水茫茫共北流。\n只是今时已惆怅，不应更为昔人愁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2248,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"唐叔良溪居","author":"张羽","text":"高斋每到思无穷，门巷玲珑野望通。\n片雨隔村犹夕照，疏林映水已秋风。\n药囊诗卷闲行后，香灺灯光静坐中。\n为问只今江海上，如君无事几人同？","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2249,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄梅雪","author":"张羽","text":"闻说公亭傍水开，黄茅为瓦不须裁。\n商船无数青山绕，书案寻常白鸟来。\n已信漆园非俗吏，谁知关令是仙才。\n烦君莫抱穷途恨，万事都将付酒杯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2250,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次高静学韵","author":"张羽","text":"缊袍无里食无余，每被傍人笑著书。\n郭泰徒劳夸叔度，扬雄何敢拟相如。\n玉堂天上非吾梦，紫极宫前有弊庐。\n安得故人邻壤住，溪头来往赋闲居。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2251,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"陈氏先垄图","author":"张羽","text":"云山漠漠冢嵬嵬，马鬣封前踯躅开。\n宗子只缘怀牒去，路人时为看碑来。\n松间刍狗埋秋草，地底渔灯彻夜台。\n惆怅年年寒食近，白杨风起为兴哀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2252,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送胡宗禹之播州驿丞","author":"张羽","text":"便路之官暂到家，九溪穷处是天涯。\n夜郎沙暖多龙迹，盘瓠山回似犬牙。\n浦口劳歌催画鹢，门前使节咏《皇华》。\n途中定有江行藁，好寄东风万里槎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2253,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送张宪史之江西","author":"张羽","text":"燕子归时却离家，洪州迢递隔天涯。\n风帆落浦朝投驿，江火明堤夜探沙。\n客里寄书逢驿使，幕中提笔待霜衙。\n来春我亦寻归棹，约尔南湖看杏花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2254,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"同安阻雨","author":"张羽","text":"出旬方到同安郭，水驿春寒懒放船。\n白浪翻江风愈壮，黑云粘树雨长悬。\n峰头僧磬惟闻响，沙口渔罾已罢牵。\n寄语群鸥莫相狎，只今无暇与攀缘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2255,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春园漫兴","author":"张羽","text":"水漫芳塘生暖波，松林兰若散鸣珂。\n题诗故欲愁花鸟，避酒还能忆薜萝。\n烟柳万条供妙舞，风莺百转当娇歌。\n醉斜乌帽归来晚，一路花飞扑面多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2256,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晓过淮阴","author":"张羽","text":"军城铁锁晓开关，使节星驰未敢闲。\n淮水东流应到海，瓜洲北去少逢山。\n行人欲断寒烟外，远烧时明乱苇间。\n却忆帝城风物盛，礼成须及上春还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2257,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"凤阳使还","author":"张羽","text":"拜陵初罢雪云晴，使者南还荷圣灵。\n马上顿更新旧历，风前重数短长亭。\n逢人问俗谙伧语，到处寻源验水经。\n却忆长干桥畔柳，归时应待眼青青。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2258,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送僧还天台省亲","author":"张羽","text":"载经东去路迢迢，应为宁亲到石桥。\n江上中斋寻午墅，沙边夜梵杂寒潮。\n宰官问法留三宿，慈母焚香制七条。\n岁晚定知归本寺，待予听雪坐终宵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2259,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄南屏渭长老","author":"张羽","text":"蒲室传心第一宗，老寻古刹寄行踪。\n贯花偈就人争写，坏色衣穿自懒缝。\n案上梵经皆贝叶，手中谈麈是青松。\n何年惠远重开社，来听东林寺里钟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2260,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠景山中道立（寺在菁山东北高山上，今废）","author":"张羽","text":"古寺残僧乱后稀，独来林下掩柴扉。\n化人每转千声偈，辟地惟将一衲衣。\n池上莲芳辞伴去，山中松偃识师归。\n非关愿薄难行道，自是群生与道违。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2261,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"重过蜀山徐幼文隐居","author":"张羽","text":"怜君旧隐此林间，一去神京未得还。\n独客重来多白发，故人不见只青山。\n岸前古树曾维艇，雪后高斋几扣关。\n何日能除簪绂系，莫年相约共投闲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2262,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"访许文学不遇","author":"张羽","text":"杖策思寻半日闲，偶随流水过前山。\n林中不见童迎客，竹外惟闻犬护关。\n道服自悬虚牖下，茶巾空挂夕阳间。\n到门不遇君携手，惆怅荒村暮独还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2263,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠弹筝人","author":"张羽","text":"先辈曾将旧曲传，纤纤银甲更堪怜。\n清和未数湘灵瑟，哀怨浑同蜀国弦。\n莺弄晚风啼复歇，雁飞秋水断还连。\n坐中北客听来少，暗想当时一惘然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2264,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠郑邴文","author":"张羽","text":"两鬓星星小幅巾，苍松气节鹤精神。\n居常倒屣迎佳客，贫不将诗谒贵人。\n踏雪抱琴梅屿晓，典衣沽酒柳桥春。\n若非道眼高明者，谁肯甘心寂寞滨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2265,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送萧县丞朝京","author":"张羽","text":"天官妙选待才贤，茂宰清明众所传。\n漠漠去帆冲暮雨，萧萧行李似当年。\n逶迤客路朝京口，迢递王城在日边。\n为说乌程民吏待，金陵酒美莫留连。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2266,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"金华道中送郑邴文东归","author":"张羽","text":"柳絮飞飞共语离，尊前会面定何时。\n交情冷淡孤衷在，世味辛酸两鬓知。\n春水乱滩船下疾，晓风残月酒醒迟。\n湖边鸥鹭休相笑，破箧无钱只有诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2267,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"金陵道中","author":"张羽","text":"孤舟晓出古关西，江树萧疏绕坏堤。\n七里冈前寒雪霁，三茅峰顶暮云齐。\n酒家寂寞人稀醉，车马纵横客易迷。\n迢递渐看宫阙近，月鸣时听夜乌啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2268,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"扬州道中","author":"张羽","text":"马头津口足风波，岁晏遥乘一传过。\n南渡客来多汉语，下江船去半吴歌。\n芜城总入新编户，瓜步斜连古漕河。\n何处吹箫明月夜，野田茅屋晓烟多。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2269,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"燕山客中","author":"张羽","text":"只合山中度岁时，欲求闻达岂相宜。\n命轻似絮人争笑，心直如弦鬼亦知。\n怕见是非休看史，未忘习业尚耽诗。\n春风归去江南路，芳草满汀花满枝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2270,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闽中春暮","author":"张羽","text":"吴山入梦驿程赊，身逐孤帆客海涯。\n九十日春多是雨，三千里路未归家。\n桄榔土润蛮烟合，杨柳江深瘴雾遮。\n倚遍阑干愁似海，杜鹃啼过木兰花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2271,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"灯花次韵","author":"张羽","text":"画堂银烛映歌钟，醉眼俄惊火树红。\n白玉屏深留晚艳，绛纱笼暖护春丛。\n阑干清泪非因雨，狼藉残煤总为风。\n更忆禁垣归路静，金莲随马散文虹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2272,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登姑苏台怀古","author":"张羽","text":"荒台独上故城西，辇路凄凉草树迷。\n废冢已无金虎踞，坏墙时有夜乌啼。\n采香径断来麋鹿，响屟廊空变蒺藜。\n欲吊伍员何处是，淡烟斜日不堪题。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2273,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送越上人住蒋山","author":"张羽","text":"落落晨星耆旧稀，奋然一出拯危机。\n石头路滑有时到，山顶云深无梦归。\n帆叶饱风冲白浪，雪花和露湿缁衣。\n八功德水谈空处，应有江禽入座飞。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2274,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送莲社陆道师归镜湖别业","author":"张羽","text":"一锡横飞下镜湖，头颅老去世缘疏。\n庭栽竹少堪容鹤，池种莲多不碍鱼。\n满室香云经尽后，半窗明月定回初。\n陶潜懒入东林社，在在青山可结庐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2275,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答山西杨宪副故旧见寄","author":"张羽","text":"晋鄙遥山接太霞，十年从仕鬓空华。\n秋来有雁偏催客，腊尽无梅更忆家。\n私属羊毛皆入税，边风马乳代烹茶。\n番思共隐江南日，每为论诗到晚鸦。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2276,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"苏小坟","author":"张羽","text":"冷落百花朝，无人上画桥。\n东风吹绿草，依旧似裙腰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2277,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"兰室五咏 其四 叶","author":"张羽","text":"泛露光偏乱，含风影自斜。\n俗人那解此，看叶胜看花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2278,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"兰室五咏 其五 花","author":"张羽","text":"能白更兼黄，无人尔自芳。\n寸心无不大，容得许多香。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2279,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"怀黄野得","author":"张羽","text":"疏散元非用世才，日高林户尚慵开。\n为怜湖上青山好，行到冬青树底来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2280,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"暮过西崦","author":"张羽","text":"白水泱泱绕坏堤，隔林遥听夕阳鸡。\n闲行每到东边少，为有青山在屋西。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2281,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"悼高青丘季迪三首 其一","author":"张羽","text":"灯前把卷泪双垂，妻子惊看那得知。\n江上故人身已没，箧中寻得寄来诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2282,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"悼高青丘季迪三首 其二","author":"张羽","text":"消息初传信又疑，君亡谁复可言诗。\n中郎幼女今痴小，遗稿千篇付与谁。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2283,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"悼高青丘季迪三首 其三","author":"张羽","text":"生平意气竟何为，无禄无田最可悲。\n赖有声名消不得，汉家乐府盛唐诗。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":2284,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]