[{"title":"赵子固兰蕙卷","author":"钱逵","text":"王孙书画出天姿，痛忆承平鬓欲丝。\n长借墨花寄幽兴，至今叶叶向南吹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1640,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪霁顾仲瑛偕余与陈惟允坐剑池上惟允为写图因赋诗云","author":"郯韶","text":"残雪落林度西岭，古涧寒泉凝素绠。\n孤僧倚树听微吟，一鹤临池照清影。\n松间旭日映山椒，白云英英如雨飘。\n何当为置王摩诘，更添几叶红芭蕉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1641,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪霁与郯九成陈惟允坐剑池上惟允为写图因次九成韵","author":"顾瑛","text":"饮涧长虹挂深岭，千尺辘轳断修绠。\n夜寒月黑鬼赋诗，白日清风人写影。\n藤萝阴阴蔓山椒，长松落雪如花飘。\n烦君画我掩书卧，窗前更著青芭蕉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1642,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"奉陪吕志学曾彦鲁刘仲原同登虎丘赋呈居中长老","author":"邾经","text":"虎丘山前新筑城，虎丘寺里断人行。\n胡僧自识灰千劫，蜀魄时飘泪一声。\n渐少松杉围窣堵，无多桃李过清明。\n向来游事誇全盛，曾对春风咏太平。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1643,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"卧云室（师子林十二咏）","author":"申屠衡","text":"童子爱白云，闭置密室内。\n不如放令出，去住得自在。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1644,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"问梅阁","author":"申屠衡","text":"石阑护苔枝，相对黄昏月。\n问答本无言，翠禽强饶舌。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1645,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"指柏轩","author":"申屠衡","text":"冰霜二百年，老骨耐撑拄。\n欲知僧腊高，即是阶前树。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1646,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"竹谷","author":"申屠衡","text":"阴森生昼寒，仰不睹天日。\n时从绿云中，窥见一星出。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1647,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"暮宿田家作","author":"蓝仁","text":"木落天正寒，山空日将暮。\n荒村倦鸟归，乱水行人渡。\n穷年滞草莽，短褐被霜露。\n晚宿依田家，主人情亦故。\n汲井泉满涧，烧竹烟在户。\n钟残溪上村，月照阶前树。\n浊酒初泼醅，嘉蔬亦时具。\n且慰饥渴怀，况谙村野趣。\n老翁八十馀，有子役征戍。\n粳稻岁暮收，官司日加赋。\n我愿息兵戈，海宇重农务。\n愧乏经济材，徒然守章句。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1648,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"风雨不已川流渺漫感事叙怀柬我同志","author":"蓝智","text":"云雷中夜兴，风雨达清旦。\n开门山木昏，隐几波澜乱。\n鹳鹤下空庭，蛟螭上高岸。\n舟航远树杪，石壁中流半。\n黍豆或漂流，蓬蒿乃滋蔓。\n北风不扫除，南海尽弥漫。\n乃知兵戈气，郁结久不散。\n坤轴恐欹倾，阳乌失光灿。\n伤时转凄凉，涉世正忧患。\n微躬愧鸟雀，何由塞天汉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1649,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中柬王幼度","author":"蓝智","text":"客子清晨卧江阁，老树闭门风雨恶。\n渔舟满眼乱波涛，杀气冥冥塞寥廓。\n地炉火冷席无毡，短衣百结双履穿。\n寒食清明不归去，故山松柏空云烟。\n先生适自江东至，行李兼旬共留滞。\n登楼王粲漫多才，献策刘蕡甘下第。\n三鳣聊尔拥皋比，一鹗未负风云期。\n青春白日麟凤远，长林丰草豺狼饥。\n十年烽火暗南极，戎马纷纷未休息。\n朝廷耆旧困草莱，乡里儿童誇膂力。\n我今旅食向孤城，君亦胡为念远行。\n人生只在意气合，世上未觉文章轻。\n野人岂知天下事，杜宇夜啼花满地。\n狂如贾谊惟痛哭，贫似扬雄空识字。\n昨夜封书与雁归，妻孥应怪苦回迟。\n丈夫磊落志千载，一日穷途何足悲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1650,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赤壁","author":"蓝智","text":"长江西来雨如雾，赤壁苍苍风雨暮。\n草木犹疑横槊时，尘沙尚忆焚舟处。\n乌林渡口下舳舻，曹瞒已料无全吴。\n阵前部曲奔先主，眼中谈笑轻周瑜。\n君臣谋合士贾勇，玉帐旌旗亦飞动。\n楼橹晴空烟焰高，鱼龙白日波涛涌。\n荆门牢落驻残兵，野旷不闻鼙鼓声。\n战骨秋埋湖外草，捷书夜报石头城。\n雄图霸气两消歇，地老天荒秋一叶。\n石上残碑过客题，沙中古剑渔人得。\n汉王祠枕碧山隅，诸葛台荒野鸟呼。\n千年忠义出师表，万里江山八阵图。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1651,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宿橘山田家怀蒋先生","author":"蓝智","text":"苍峰落日微，白鹤秋风远。\n客路入疏钟，田家背山坂。\n孤烟桑柘寒，归鸟茆茨晚。\n欲觅紫芝翁，山深白云满。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1652,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"暮归山中","author":"蓝仁","text":"暮归山色昏，濯足月在涧。\n衡门栖鹊定，暗树流萤乱。\n妻孥候我至，明灯供蔬饭。\n伫立松桂凉，疏星隔河汉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1653,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋日游石堂奉呈卢佥宪","author":"蓝智","text":"荒郊通径僻，野竹闭门深。\n白日羲皇世，青山绮皓心。\n潜蛟多在壑，宿鸟独归林。\n知尔荷锄倦，时为《梁甫吟》。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1654,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夕怀张山人","author":"蓝智","text":"鼓角边声壮，林塘夜色幽。\n凉风动疏竹，明月在高楼。\n久客形容老，孤城战伐愁。\n不眠怀魏阙，长啸拂吴钩。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1655,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中同孟原佥宪登嘉鱼亭","author":"蓝智","text":"高阁流莺外，荒城驻马前。\n江寒三月雨，春老百蛮天。\n折柳悲横笛，飞花落钓船。\n乾坤总羁旅，把酒意茫然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1656,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"时事 其三","author":"蓝智","text":"大府城隍废，疲民井邑空。\n舞干非舜日，斩木有秦风。\n烽火苍茫外，江山感慨中。\n悲歌看古剑，激烈想英雄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1657,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宿严滩作","author":"蓝智","text":"水宿傍严滩，风灯语夜阑。\n鼍鸣潮信急，龙过雨声寒。\n病喜江山好，贫嗟道路难。\n故园三四口，书札报平安。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1658,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"徐雪舟为画蓝涧草堂图","author":"蓝智","text":"碧草连书屋，苍山对画图。\n鹤巢秋树小，渔艇夕阳孤。\n野色晴初远，溪云淡欲无。\n浮楂倚盘石，把钓任潜夫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1659,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"经石堂追怀卢使君","author":"蓝智","text":"旧隐仙人馆，曾陪使者车。\n那知沧海别，不返白云居。\n山雨荒樵径，窗尘污道书。\n伤心庭外竹，清影漫扶疏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1660,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"兵后归西山","author":"蓝智","text":"乱后归茅屋，晨兴步石田。\n客愁空日日，春色自年年。\n风雨啼莺外，江湖去鸟前。\n艰难思故旧，回首意茫然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1661,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"蓝涧草堂","author":"蓝智","text":"橘井云山北，茅斋涧水西。\n听猿秋树近，扪虱夕阳低。\n樵子知愚谷，田翁伴醉泥。\n兴来时得句，自向竹间题。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1662,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻蓝山兄寓滁州","author":"蓝智","text":"番水初传信，滁山想定居。\n秋吟兼蟋蟀，晚饭得鲈鱼。\n落月沧江阔，凉风白发疏。\n兵戈关塞隔，不敢问何如。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1663,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登凤林寺钟楼作","author":"蓝智","text":"楼凭青嶂迥，人到上方稀。\n古寺愁春雨，疏钟送落晖。\n云林孤迹远，法界一尘微。\n坐久松风动，飞花落客衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1664,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中漫题 其三","author":"蓝仁","text":"读书期有用，闭户耻无能。\n落叶空山雨，疏钟独夜灯。\n人称樗里子，住近石门僧。\n静坐观诗妙，须参最上乘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1665,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"顺昌道中","author":"蓝智","text":"蓐食鸣鸡晓，空山啼鸟春。\n远钟何处寺，残月独行人。\n书剑嗟黄发，江湖起战尘。\n南游未得意，北望正凝神。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1666,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雪中送舒文质归广信","author":"蓝智","text":"积雪千峰迥，空林一鸟归。\n客愁南浦树，乡梦北山薇。\n风雨荒茅屋，兵戈老布衣。\n饥寒兼盗贼，出处寸心违。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1667,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄云松先生隐居五首 其一","author":"蓝仁","text":"风雨论交旧，林塘卜筑新。\n幽栖兼令弟，高卧愧时人。\n竹日明书帙，溪云覆钓缗。\n林居无俗客，麋鹿自相亲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1668,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柳城道中","author":"蓝智","text":"霜气晚凄凄，荒冈恐路迷。\n孤云桂岭北，落日柳城西。\n地暖蛇虫出，林昏鸟雀栖。\n蛮乡经战伐，问俗愧遗黎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1669,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"采石舟中寄子正佥宪","author":"蓝智","text":"共醉黄垆酒，还登采石舟。\n澄江晴吐月，独树晓生秋。\n去国一身远，怀乡半夜愁。\n明朝陪使节，一上岳阳楼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1670,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"恭城县 其一","author":"蓝智","text":"十室黄茅屋，千峰红叶村。\n喧厖蛮俗异，质朴古风存。\n鸡犬连猺洞，牛羊到县门。\n残年历荒徼，遥布圣明恩。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1671,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晚立怀友","author":"蓝智","text":"野旷行人绝，林空坠叶闻。\n客愁当落日，诗思入寒云。\n草暗防蛇毒，山昏过虎群。\n梅花万里道，岁晚正思君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1672,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过云洞岭","author":"蓝智","text":"路出千林迥，山连五岭遥。\n石崖悬度栈，野树卧通桥。\n涧饮犹防蛊，畬耕尽属徭。\n夕阳驱瘦马，鬓影漫潇潇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1673,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"溪桥晚立","author":"蓝智","text":"天阔浮云尽，山昏落日微。\n鸟栖当野树，人语共柴扉。\n岁月且云暮，乡关何处归。\n邻家响机杼，远客叹无衣。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1674,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"夜雨","author":"蓝智","text":"多病西风客，空堂独夜愁。\n灯残江上雨，木落岭南秋。\n黄卷知何用，丹砂不易求。\n君恩无补报，怅望惜淹留。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1675,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠隐者","author":"蓝智","text":"风云蛇阵将，山水鹿门居。\n报国曾留剑，归田始读书。\n雁秋湖水落，蝉露柳条疏。\n别梦关山远，松窗夜月虚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1676,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨中","author":"蓝智","text":"黯黯云垂野，潇潇雨满林。\n晚山归鸟尽，秋草闭门深。\n落叶萧条树，空城断续砧。\n烦忧兼独立，谁识此时心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1677,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"晓发江上","author":"蓝智","text":"官船催晓发，浦鸟暗惊飞。\n残月低清渚，疏钟隔翠微。\n晨光初辨树，秋色已生衣。\n万里惭张翰，鲈鱼未得归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1678,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"柳城县","author":"蓝智","text":"青山入县庭，小邑但荒城。\n竹覆茅茨冷，江涵石壁清。\n草虫当户堕，水鸟上阶行。\n问俗知无事，松风一舸轻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1679,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"出云藤驿","author":"蓝智","text":"又出云藤驿，扁舟更向东。\n地蒸秋有瘴，江阔夜多风。\n旅梦惊啼狖，乡心托断鸿。\n天涯看月色，不与故园同。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1680,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宿阳朔山寺","author":"蓝智","text":"晚景孤村僻，松门试一登。\n秋山黄叶雨，古寺白头僧。\n坏壁穿新竹，空床覆旧藤。\n宦情与禅意，寂寞共寒灯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1681,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"来宾县晓发","author":"蓝智","text":"宦游同逆旅，侵晓逐征途。\n空馆残灯小，长江落月孤。\n邻鸡催去马，城拆起栖乌。\n物色兼人事，匆匆岁欲徂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1682,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"江上别故人","author":"蓝智","text":"天涯芳草色，对酒惜馀春。\n此日沧江别，东风白发新。\n落花晴傍马，野鸟冷窥人。\n共勉持风纪，驱驰莫厌频。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1683,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"宿开建江上怀闽中故人","author":"蓝智","text":"东风袅袅泛鸥波，倚棹汀洲近薜萝。\n江上流莺疏雨歇，天涯芳草落花多。\n暮云尚隔苍梧野，秋兴空怀《白苎歌》。\n离别不堪频怅望，美人南国意如何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1684,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋夕怀王长文","author":"蓝智","text":"月落秋山夜正中，飞云寥落海天空。\n揽衣谁念闻鸡舞，拔剑终期汗马功。\n河汉星辰连北斗，蒹葭霜露满西风。\n忧时王粲头如雪，却忆《登楼赋》最工。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1685,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"答萧子仁","author":"蓝智","text":"每忆诗篇共讨论，更烦书札寄殷勤。\n西风一叶潇潇雨，落日三山渺渺云。\n碧海鱼龙秋正蛰，空江鸿雁夜多闻。\n茆檐寂寞黄花晚，欲采寒香远寄君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1686,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻吴维新写正览已毕作诗迎之","author":"唐桂芳","text":"吴郎久不见，怅望隔江村。\n辛苦头将白，编摩眼易昏。\n蕉心含雨润，柿叶缬霜繁。\n智永瞠诸后，羲之本一门。\n未应梁上得，偏向枕中存。\n点磔临池黑，戈波漏屋痕。\n萦萦蛛结网，袅袅茧缫盆。\n白练书裙好，黄麻草诏尊。\n首濡无醉魄，笔谏有忠魂。\n安得三千幅，烦君恣意翻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1687,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"遣怀 其二","author":"唐桂芳","text":"繁昌县前白杨树，随处柴门逐水开。\n可是夜深风露冷，流萤一个度江来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1688,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和程仲庸游京口留别","author":"唐桂芳","text":"我正无心懒似云，那堪奔走污缁尘。\n飞花岸柳偏愁客，吹浪江豚忽拜人。\n玉带暂抛烦转语，楞伽曾写悟前身。\n异时好说金山寺，小小渔舟唤渡频。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1689,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赋秋胡子","author":"唐桂芳","text":"依依陌上桑，婉婉桑间妇。\n嫣然红罗襦，采桑湿香雾。\n相逢马上郎，停鞭偶回顾。\n重遗买一笑，脉脉此情露。\n谁知妇人身，托生胶漆固。\n本期骨肉亲，反被颜色误。\n忆当送郎初，徙倚门前树。\n箧笥满征裳，一一裁缯素。\n绣为双鸳鸯，犹惧观者妒。\n愿郎早归来，恨不与俱去。\n尘埃扑床帷，蟏蛸网窗户。\n惟有白发姑，未忍衷情诉。\n可怜不相识，春心挑中路。\n苍皇下马时，忽忽意未悟。\n洞房扫春蚕，一见应愧负。\n汝妾固可弃，汝亲宁弗慕。\n黄金无亏盈，白璧有点污。\n嫁夫恩义乖，何如江水赴。\n贞姿擅古今，朽骨忘朝暮。\n悠悠惩怆心，于焉发长喟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1690,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古 其一 行行重行行","author":"钱宰","text":"出门万里别，行行远防边。\n相望各天末，北斗日夜躔。\n四运秋复春，不见君子还。\n燕车北其辙，越马南其辕。\n目远心愈近，怅望徒悬悬。\n黄云暗关塞，路险不见天。\n式微夫如何，日月忽已迁。\n愿言崇明德，无为终弃捐。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1691,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古 其二 西北有高楼","author":"钱宰","text":"高台何巍巍，参差与云平。\n玉绳临双阙，长河流无声。\n上有羽衣人，逍遥吹玉笙。\n清响明月，飞佩何泠泠。\n借问弄者谁，疑是董双成。\n逸思随风发，无人识其声。\n曲终再三叹，感慨有余情。\n所悲同门友，局促趋世荣。\n愿将秋水剑，为之解尘缨。\n笑呼双黄鹄，与子俱远征。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1692,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古 其三 涉江采芙蓉","author":"钱宰","text":"涉海采琅玕，红者珊瑚枝。\n明珠盈怀袖，将以遗所思。\n海阔不得返，所宝莫致之。\n烂其纳我室，抱璞将何为。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1693,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古 其四 明月皎夜光","author":"钱宰","text":"皎皎明月光，照我屋东头。\n寒螀鸣树间，招摇指孟秋。\n白露下高梧，落叶声飕飕。\n寒温更变迁，河汉东南流。\n怀哉里中儿，奋志起远游。\n飘然溯长风，乘槎犯斗牛。\n支机织女石，为问今在不。\n水深波涛阔，浮名将焉求。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1694,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古 其五 冉冉孤生竹","author":"钱宰","text":"青青梧桐树，托根在高冈。\n与子新合欢，翕如凤与皇。\n凤皇鸣锵锵，合欢期世昌。\n欢情一何短，离思一何长。\n嗟彼篱下菊，含英扬其芳。\n晨霜秉贞节，宁随秋草黄。\n终当采而佩，岁晏夫何伤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1695,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古 其六 庭中有奇树","author":"钱宰","text":"中林多幽兰，江篱杂芳荪。\n采之酌春酒，将以清心魂。\n持杯未及饮，怅然念王孙。\n王孙不归来，置酒在芳尊。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1696,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古 其七 迢迢牵牛星","author":"钱宰","text":"河东有织女，皎皎云为章。\n手弄机上丝，日夕更七襄。\n织成五色文，欲制君子裳。\n莫言隔秋水，可以驾飞梁。\n睆彼牵牛星，终日不服箱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1697,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古 其八 客从远方来","author":"钱宰","text":"故人万里别，海水日夜深。\n南风海上来，遗我双南金。\n不见故人面，乃见故人心。\n铸作黄金徽，置之白玉琴。\n弹为《别鹤操》，闲以怀湘吟。\n曲终听者稀，矫首望知音。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1698,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟古 其一","author":"钱宰","text":"庭树日已黄，白发日已短。\n候虫鸣前除，秋霜蕙花晚。\n岁月如奔驹，六辔不可挽。\n泛舟涉方瀛，方瀛水清浅。\n安期邈难求，吾棹亦已返。\n花开醉复斟，黍熟饥自饭。\n逌然乐悟生，瑶岛谅不远。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":1699,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]