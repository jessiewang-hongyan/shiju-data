[{"title":"纸","author":"李延兴","text":"吴茧裁成秋水寒，炯然光彩动柴关。\n香分梅蕊飘金润，色夺梨花衬玉环。\n石几净堆春雪冷，璚窗轻拂晓云闲。\n东林白社多年别，好与题诗寄鹤还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7727,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"高生规当岁贡遇生日","author":"李延兴","text":"天风环佩响珊珊，瑶海秋高王母还。\n好著莱衣娱鹤发，要将董策觐龙颜。\n霞翻锦帜金鸾殿，日射丹墀玉笋班。\n待得瓦桥春雪霁，马嘶官路彩云间。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7728,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和睦公九日韵","author":"李延兴","text":"国祚绵延类岱嵩，奎光炯炯照南宫。\n帝王道统归精一，台阁文章入混融。\n射策直须追贾谊，草玄何必数扬雄。\n张仪更是豪谈者，吐出晴天万丈虹。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7729,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和宣文刘仲德咏雪","author":"李延兴","text":"虚轩看雪晓光微，却忆淮西破贼围。\n春瓮旋开千日酒，海尘不染六铢衣。\n天寒紫塞黄云合，风急苍江白雁飞。\n高卧忽闻佳客至，衣裳颠倒出荆扉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7730,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"儿岭","author":"李延兴","text":"月落荒村白雾收，晓行霜气袭貂裘。\n星连紫极龙光动，海入青天蜃气浮。\n风壤渐通辽霫部，云山直接契丹州。\n皇皇北镇神灵在，好驭飙车到上头。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7731,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"沙河","author":"李延兴","text":"沙河市头黄叶飞，沙河道上行人稀。\n天阴古冢狐狸出，雪满霜田雁鹜肥。\n百钱鲁酒足供醉，十岁奚儿能打围。\n别家三月不得信，关塞萧条何日归。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7732,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送张都事赴浙省","author":"李延兴","text":"朔方豪杰气如虹，往佐名藩好立功。\n泰岳阴风吹雨黑，淮营夜火照云红。\n江南亲旧多年别，海上音书几日通。\n投笔封侯亦奇事，草玄应是笑扬雄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7733,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山北佥宪黑思仲义以宗正郎中召还予时在会州以诗送之甲辰岁暮云","author":"李延兴","text":"千里关河积雪深，星轺西发马骎骎。\n黑山雾雨连穷海，紫塞风云接上林。\n到阙应持御史节，上堂先慰老亲心。\n边城日晚多豺虎，送别那堪泪满襟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7734,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"登隗台用希颜韵","author":"李延兴","text":"好风吹袂上金台，旋脱貂裘换酒来。\n春日郊扉光黯澹，夕阳樵路水萦回。\n都人犹记燕昭事，朝士争誇郭隗才。\n千古兴衰总陈迹，断碑剥落卧苍苔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7735,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送翼主归相州","author":"李延兴","text":"千营兵气黑沉沉，关塞萧条草木深。\n蛇伏黄蒿嘘毒雾，鬼吹青火出空林。\n儿童老大不相识，墟墓荒寒只自寻。\n亲在远游烦爱惜，书来应抵万南金。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7736,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"雨","author":"李延兴","text":"熟睡昏昏白昼长，翻盆急雨洗炎光。\n天连远塞霓旌湿，风渡虚楼燕幕凉。\n竹里疏花红灼灼，窗前流水碧浪浪。\n山中米麦多应好，抱膝长歌喜欲狂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7737,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"别易水诸公","author":"李延兴","text":"一家远隔万重山，古道人稀独自还。\n夜月屡倾燕市酒，春风不度雁门关。\n晴天雨散千峰外，野屋云生半席间。\n兄弟何时重会面，灯前相对话时难。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7738,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"忆王氏兄弟","author":"李延兴","text":"大野荒寒起夕阴，残蝉幽咽乱清砧。\n虚庭宿露苍苔滑，远道秋风黄叶深。\n烽火未收三月信，田园空负百年心。\n多情好是西城月，时向愁边照苦吟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7739,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"忆安常","author":"李延兴","text":"钟残水国夜初分，雪屋灯前梦见君。\n阮籍途穷随处哭，杜陵诗好几回闻。\n青山故国迷烟月，白首间情寄水云。\n苦恨东风不相识，吹人愁思转纷纷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7740,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送燕倅","author":"李延兴","text":"祖席衣冠尽士林，秋风古驿马骎骎。\n考功不愧循良传，遮道还怜父老心。\n日毂影高三殿晓，霓旌光动五云深。\n归时正及梅花放，一路吹香雪满襟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7741,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽许璘","author":"李延兴","text":"碧海珠沉失夜明，青云器业竟无成。\n空歌周颂有高廪，不见宣尼畏后生。\n古墓云低飘陇树，白杨风急捲铭旌。\n伤心忍过西城路，易水东流送哭声。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7742,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题吕仙翁庙","author":"李延兴","text":"策名文彩动蟾宫，飞上丹梯笑葛洪。\n剑影冷涵云气湿，笛声清绕月轮空。\n黑翻诗壁研磨外，神现松精候谒中。\n几拟细询仙岁月，芙蓉溪上又秋风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7743,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题金山寺赓陆先生韵","author":"李延兴","text":"天连泗水水连天，烟锁孤村村锁烟。\n寺绕薜萝萝绕寺，川通巫峡峡通川。\n酒迷醉客客迷酒，船送行人人送船。\n此会应难难会此，传今胜古古今传。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7744,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"往郎山","author":"李延兴","text":"郎山宛在瓦桥西，烟树苍茫望欲迷。\n把酒花飞愁处满，送行诗好别时题。\n泠泠古调南薰细，奕奕高名北斗齐。\n此去心旌好相照，素书几日寄幽栖。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7745,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日杂兴和前韵 其一","author":"李延兴","text":"隔溪茅屋曙光分，簌簌红桃映此君。\n烟圃药苗晴后种，风窗香霭静中闻。\n秦人无复歌黄鸟，华岳犹堪卧白云。\n怪杀杨花轻薄甚，满衣吹作雪纷纷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7746,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日杂兴和前韵 其二","author":"李延兴","text":"水村几曲路斜分，烟寺西边访隐君。\n白昼暄风吹酒醒，青林啼鸟隔溪闻。\n一竿好钓矶头雨，双㹀谁耕洞口云。\n碧柳红桃满春色，那堪归思转纷纷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7747,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送知县 其一","author":"李延兴","text":"县斋寂寂远尘氛，草满圜扉翠欲熏。\n日转棠阴侵席过，风回琴响隔花闻。\n水分九派通苍海，地拥三关压紫云。\n河朔近来为令者，路人争道不知君。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7748,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送知县 其二","author":"李延兴","text":"长亭云树拥征鞍，意欲留君计转难。\n竹骑岂惟迎郭伋，蒲鞭直欲继刘宽。\n班联晓陆承殊宠，绩考春曹陟最官。\n此别信知应未远，杨花香衬马蹄还。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7749,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"东林图","author":"李延兴","text":"匡庐遗想定如何，文物风流也自多。\n月满空山号虎豹，日穿林樾涨藤萝。\n青莲结社朝乘犊，白水渔竿晚浴鹅。\n多半蟠根是仙李，向阳枝叶更婆娑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7750,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"灯夕","author":"李延兴","text":"灯簇上元夕，花明仙苑春。\n星毬悬碧落，云幄护朱闉。\n岁律时当午，斗杓昏建寅。\n六龙御丹极，万象入洪钧。\n淑气东浮野，群星北拱辰。\n楼头霞散绮，墙角雪销银。\n已弛金吾禁，应无丞相嗔。\n鳌山攒火树，兽锦叠文茵。\n玉漏传疏点，香飙逐暗尘。\n篆烟吹绣幕，檐雾湿纱巾。\n紫陌鸡鸣缓，红桥马过频。\n珠围貂帽窄，梅放粉容新。\n诗就题千帙，筵开直万缗。\n酒光摇潋滟，舞影起纷纶。\n序齿先耆艾，忘形略主宾。\n联翩仙子佩，窈窕女儿身。\n叠唱凌天籁，争归步月轮。\n闾阎喧小子，箫鼓沸苍旻。\n童稚扶翁媪，优伶学搢绅。\n青云文雅士，白发太平民。\n世喜消锋燹，巫羞祀鬼神。\n欢呼占岁稔，倾倒见天真。\n留滞无羁旅，欹斜有醉人。\n宴游逢霁景，款曲会良姻。\n是物恩波洽，诸方化雨均。\n腐儒犹放浪，令尹独清贫。\n屡辱情过厚，从知道欲伸。\n得人类言偃，爱客即陈遵。\n闻望腾中外，公忠出等伦。\n威仪严可畏，襟度阔无垠。\n公署钞琴谱，黉堂礼席珍。\n河头虎争渡，桑下雉相驯。\n五裤歌方振，三农业已勤。\n官清文字简，乡饮德风淳。\n我已成迂朽，行将赋隐沦。\n弟兄皆鬼物，田亩半荆榛。\n周急烦贤友，持家养老亲。\n奇才推葛亮，曲学陋平津。\n松径荒烟里，茅堂野水滨。\n读书逾懒慢，抚事几悲辛。\n碧藓侵棋局，红蕖没钓纶。\n发蓬苦扪虱，衣破叹悬鹑。\n出处惭先哲，间关类逐臣。\n多情依木石，无分画麒麟。\n城市聊从俗，山林拟卜邻。\n业唯归竹素，书莫上枫宸。\n性入禅家学，歌随樵客斤。\n生涯甘寂寞，宰物实陶甄。\n高尚尊严子，贤良笑郤诜。\n天涯正愁绝，回首遇雷陈。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7751,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"卢龙 其一","author":"李延兴","text":"迢递卢龙塞，苍茫滦水波。\n青林云气重，白涧雨声多。\n四皓终归隐，三良谩有歌。\n秋风关海上，回首泪滂沱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7752,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"卢龙 其二","author":"李延兴","text":"疋马空山路，孤烟老树村。\n松阴连草屋，涧水绕柴门。\n秋晚蜂成蜜，年深鹤有孙。\n行藏吾道在，白首信乾坤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7753,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"拟上太傅丞相","author":"李延兴","text":"燕在蟠空积雪晴，煌煌虎旅控幽并。\n太公制敌分奇正，方叔行兵属老成。\n霜压貂裘寒气重，星涵龙剑夜光明。\n日华冷射鱼鳞甲，霞彩朝迎鸟羽旌。\n宇内勋庸扶帝业，帐前金鼓震天声。\n三槐晓雨青浮砌，万柳春风绿满营。\n猎火烧云烟四合，辕门传令月三更。\n屯田有策年方稔，刁斗无声夜不惊。\n仗绕中坚排队出，弩驱前马着班行。\n家藏书史传贤子，国有旂常播令名。\n炳烈精忠通紫极，涵濡德泽到苍生。\n两封穹爵承殊渥，百战河山定太平。\n门下衣冠多俊拔，胸中湖海愈泓澄。\n腐儒漂泊身如寄，破屋荒寒病转婴。\n七帙慈亲伤老朽，一丝微命转伶俜。\n田园芜没忧生养，骨肉分离忆弟兄。\n水满钓滩閒桂楫，烟迷乡树隔柴荆。\n相君下顾千金价，士类同倾万古情。\n生意从兹在蔀屋，谫材何用请长缨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7754,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和睦公九日韵","author":"李延兴","text":"绛车晓发万人看，春入燕台雪半乾。\n圣代人材徵梓杞，宪庭风彩接鹓鸾。\n蟾宫露冷三花湿，象简霜飞六月寒。\n北阙焜煌承帝綍，东林萧瑟闭诗坛。\n绣衣劝讲临芹沼，蔀屋怀贤赋考槃。\n定有奇勋登汗竹，岂无宏策上金銮。\n天边紫气涵龙剑，江上青山近马鞍。\n玉笋班联三殿外，琼林光动五云端。\n煌煌嘉瑞钟神秀，皛皛沧溟得木难。\n朝著人争传姓字，慈闱书喜报平安。\n永怀黄阁千金重，自保臣心一寸丹。\n走也向来成老朽，短蓑烟雨梦渔竿。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7755,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"立春日试笔","author":"李延兴","text":"霞坞光相炫，冰池冻半开。\n影随瑶色起，香逐綵旗来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7756,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"壮士","author":"李延兴","text":"走马过营门，金甲吐光焰。\n笑我读兵书，何如去学剑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7757,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"灯花词","author":"李延兴","text":"彩发虚明间，性涵膏火里。\n彪外而弸中，花岂知报喜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7758,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"卖花","author":"李延兴","text":"风送卖花声，花香扑珠酒。\n买尽担头春，半是青楼妇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7759,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山中见王■","author":"李延兴","text":"笛弄林间月，蓑披陇上云。\n朱门半消歇，人笑不如君。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7760,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"闻雁","author":"李延兴","text":"流响迷湘浦，馀哀隔陇云。\n角残灯外听，钟定枕边闻。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7761,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"东波洗砚池","author":"李延兴","text":"毫分赤壁雨，墨染蜀山云。\n旗照龙蛇影，波涵星斗文。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7762,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠隐者","author":"李延兴","text":"听钟寻野寺，隔树扣云关。\n鹤卧琴窗静，樵归棋局闲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7763,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"菊蹊","author":"李延兴","text":"荒径雨苔未扫，疏篱霜蕊先开。\n绿酒从人放饮，白衣为我携来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7764,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山行","author":"李延兴","text":"村村寺寺竹好，水水山山路遥。\n林鸟催人唤酒，野色随车过桥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7765,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题逸士图","author":"李延兴","text":"秋思枕边疏雨，年光叶上惊飙。\n从渠得马失马，笑我操瓢弃瓢。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7766,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春日即事","author":"李延兴","text":"蝶弄花心初日，莺啼门口残春。\n半岭半岩古寺，一觞一咏高人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7767,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题画","author":"李延兴","text":"虹彩明涵疏雨，蝉声暝咽残阳。\n人境不殊仙境，醉乡真是吾乡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7768,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"初二晚凉登东楼","author":"李延兴","text":"瑟瑟青枫水郭秋，买鸡携酒上东楼。\n一瓢欲赠山中客，掷上青溪傲许由。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7769,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"经梦笔桥","author":"李延兴","text":"风起湘波断绿津，长歌别恨写悲辛。\n挥毫几拟题桥过，翻愧当时卖赋人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7770,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"越王台 其一","author":"李延兴","text":"越王台前江水深，越王台畔草森森。\n五湖明月青天上，照见鸱夷万古心。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7771,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"越王台 其二","author":"李延兴","text":"陆生赋冠六朝文，掷地金声一座闻。\n莫听吴歌过江去，洲前花月夜纷纷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7772,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"客中喜金震见访","author":"李延兴","text":"翻翻霜叶飞还坠，寂寂风扉掩忽开。\n莫向尊前问僧腊，海门秋色逐潮来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7773,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"赠弹筝人","author":"李延兴","text":"秋恨斜飞啼恨深，示将燕调杂吴音。\n人人竟听抛红锦，悔杀当时苦学琴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7774,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送白杨长老 其一","author":"李延兴","text":"龙天拥护大江西，江上分襟绿草齐。\n一路藤萝秋色里，山山树树白猿啼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7775,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"立秋夜听秋声","author":"李延兴","text":"漠漠微云生晓阴，满庭虚籁薄霜林。\n有声元在无声里，听到无声思转深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7776,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"春申君","author":"李延兴","text":"歇也慆淫忍复论，指胎画策市君恩。\n区区篡立成何事，翻与皇家辟祸门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7777,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"隗台","author":"李延兴","text":"野老留人不肯住，半醉扶筇入山去。\n天风吹上黄金台，放笔纵横写长句。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7778,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"山行","author":"李延兴","text":"山压金台万万重，寻幽尽日少人逢。\n况闻水北田庐好，白首躬耕学卧龙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7779,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"沙岗晓发","author":"李延兴","text":"白波滉荡摇青天，隔江打鼓是官船。\n天涯渐与故人远，客怀寥落秋风前。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7780,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"对月同文祯宗兄赋","author":"李延兴","text":"窗里娟娟纳月光，床头顾影转凄凉。\n束书几日还山去，露坐弹琴秋树傍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7781,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送知县","author":"李延兴","text":"朝廷考绩推循吏，暮夜辞金谢故人。\n愿借寇恂怜父老，早归重看瓦桥春。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7782,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽蒋济川梦妻","author":"李延兴","text":"土蚀瑶钗催白雁，霜沉锦瑟断朱弦。\n灵帏灯暗阴风起，忍见孤儿挂纸钱。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7783,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"古别离","author":"徐贲","text":"清晨戒严装，送别河之干。\n北风塞上起，黄沙浩漫漫。\n冰雪日以繁，徒旅日以寒。\n不悲道路远，所愁衣裳单。\n从行义不可，徒使摧心肝。\n流光信奔驰，君归有时待。\n但惜少年去，坐令颜色改。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7784,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"上留田","author":"徐贲","text":"羽翼偏，不能飞。\n上留田。\n车轮单，安可驰。\n上留田。\n有弟有弟寒且饥。\n上留田。\n为其兄者知不知。\n上留田。\n父母既没鞠者为谁。\n上留田。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7785,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"五杂组 其一","author":"徐贲","text":"五杂组，机上丝。\n往复还盘中棋，不获已人别离。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7786,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"五杂组 其二","author":"徐贲","text":"五杂组，园中花。\n往复还陌上车，不获已人无家。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7787,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"行路难","author":"徐贲","text":"桃李不冬发，宁识霜雪威。\n丈夫不出门，安知道路危。\n渡河恐倾覆，登山苦崄巇。\n假问何乃尔，言有名利羁。\n名利孰不志，命系造化为。\n请君勿躁进，藏器且待时。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":7788,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]