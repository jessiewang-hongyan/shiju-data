[{"title":"简顾秀才","author":"陶宗仪","text":"地偏春自胜，市远客尤稀。\n草阁开清昼，溪航载落晖。\n杂花晴簌簌，轻燕晚飞飞。\n问讯东邻老，还容觅钓矶。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4188,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"西湖纪兴","author":"陶宗仪","text":"浩浩春波阔，冥冥夜雨县。\n笙歌传别馆，灯火隔疏烟。\n作客频迁次，伤时更可怜。\n明朝晴未卜，还是醉湖船。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4189,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"五里塘","author":"陶宗仪","text":"破屋三家市，扁舟五里塘。\n乱波浮落照，饥雀聚枯桑。\n氛祲乾坤戚，兵戈道路长。\n漂流无倚著，何日定归乡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4190,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"南村对雨","author":"陶宗仪","text":"雨气连村白，溪流触岸浑。\n馀寒欺鸟雀，清润湿琴尊。\n修竹明如洗，长杨翠作屯。\n草堂初睡起，曳履掩柴门。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4191,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和郑南荣韵","author":"陶宗仪","text":"煮茶烧落叶，扫径动閒云。\n水涸溪痕见，林疏岫色分。\n斋居长自掩，麋鹿动成群。\n短屐相过数，惟应郑广文。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4192,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"癸亥元日","author":"陶宗仪","text":"通夕零寒雨，开晨吼朔风。\n人惟忧乐异，节自古今同。\n故国丹丘外，浮生白发中。\n力田忧水旱，端策问凶丰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4193,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"元夕","author":"陶宗仪","text":"珂里传柑日，金吾放仗时。\n楼台灯火淡，风雨管弦悲。\n术眩明皇幸，仪尊太乙祠。\n千年成古迹，兀坐漫赍咨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4194,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过顾城湖","author":"陶宗仪","text":"昨行三塔崦，今过顾城湖。\n帆正风犹顺，程遥日渐晡。\n碍船防断渚，收港认浮图。\n同往皆良友，羁情喜不孤。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4195,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"己卯中秋","author":"陶宗仪","text":"移榻近前荣，良时引兴清。\n雨从晡后散，月向夜深明。\n灵兔曾无恙，孀娥若有情。\n举杯邀对酌，隔岁好寻盟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4196,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"中秋","author":"陶宗仪","text":"今夕知何夕，南轩景趣幽。\n露漙蟾影耀，风静桂氛浮。\n移榻催铺席，褰帘快上钩。\n年年催老去，又见一中秋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4197,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"辛已中秋","author":"陶宗仪","text":"海㝢乐升平，中秋景象清。\n秪缘人意好，转觉月华明。\n今岁佥愚戆，比邻异死生。\n听来惟是哭，孰更不伤情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4198,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九月朔日庭前白菊开花","author":"陶宗仪","text":"寻常重九日，难得菊花开。\n今岁困添闰，孤芳亦借魁。\n翠裘云掩冉，鹤羽雪毰毸。\n三嗅秋香立，吟哦待酒来。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4199,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"丙寅中秋","author":"陶宗仪","text":"云开天宇洁，玉露滴琪林。\n静对中秋月，偏伤故国心。\n半生常作客，此夕一沾襟。\n弟妹书难得，穷愁老转深。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4200,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"十二月望后一日输粟金山卫","author":"陶宗仪","text":"渤海金山小，坡陀草路危。\n城池连斥卤，部伍杂华夷。\n比屋屠牛肆，高竿卖酒旗。\n一旬愁里过，雨雪滞归期。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4201,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"十月十一日夜梦中赋诗一首既觉忘前四句枕上足成之","author":"陶宗仪","text":"柳风轻娜娜，竹雨净娟娟。\n有只书千帙，无多屋数椽。\n村深居自好，心远老相便。\n载酒溪翁羡，桃源小洞天。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4202,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"十月廿六日喜雪分韵得同字","author":"陶宗仪","text":"今年方见雪，欢喜万人同。\n觥巨醅浮绿，窗明烛耀红。\n煎茶移石鼎，理棹命溪童。\n黄竹何须赋，休祥兆岁丰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4203,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"庚辰元日","author":"陶宗仪","text":"授历纪庚辰，开元值丙寅。\n五更微见雪，两日便迎春。\n头戴银幡巧，门题彩帖新。\n屠苏循故事，殿饮老年人。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4204,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九月四日遣愁","author":"陶宗仪","text":"尘锁断弦琴，悠悠岁月深。\n遗言仍在耳，恶日倍伤心。\n路隔重泉窅，坟封宰木阴。\n临风耿无语，老泪一沾襟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4205,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"哭王黄鹤","author":"陶宗仪","text":"人物三珠树，才华五凤楼。\n世称唐北苑，我谓汉南州。\n大梦麒麟化，惊魂狴犴愁。\n平生衰老泪，端为故人流。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4206,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"乙丑十月廿八日得乡人林序班公辅寄声报舍弟梦臣没于道未知月日地所二首 其一","author":"陶宗仪","text":"白下相逢日，于今十二年。\n江湖俱老矣，风雨独凄然。\n哀讣从人得，残躯为国捐。\n生儿多不育，身后竟谁传。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4207,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"乙丑十月廿八日得乡人林序班公辅寄声报舍弟梦臣没于道未知月日地所二首 其二","author":"陶宗仪","text":"弟兄惟我在，骨肉永睽离。\n王事勤劳日，关河梦断时。\n水深风浪恶，夜静鼓笳悲。\n号恸嗟何及，伤心老益衰。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4208,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"哭马平主簿夏原威","author":"陶宗仪","text":"诗书承善庆，簪组沐恩荣。\n赋命分修短，详刑服重轻。\n平生师友义，终古别离情。\n尽掬寒淞水，难前泪眼清。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4209,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽陆北岩教谕","author":"陶宗仪","text":"北岩今已矣，命也复何仇。\n形影长相吊，文章不自谋。\n梦残萧寺夕，魂返故山秋。\n多少伤心事，哀猿哭未休。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4210,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽赵云居先生二首 其一","author":"陶宗仪","text":"故国王孙后，先生德望隆。\n相将年九十，出处浙西东。\n学本趋庭教，医存济世功。\n俄然弃荣养，哀恸起秋风。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4211,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽赵云居先生二首 其二","author":"陶宗仪","text":"吴淞今共客，台婺远相连。\n去国二千里，论心四十年。\n故人将尽矣，老泪重潸然。\n修得遗贤传，储输太史编。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4212,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送何伯温还凤阳","author":"陶宗仪","text":"索居濠水曲，岁月共悠悠。\n会面忽今日，怜君已白头。\n关山来去路，风雨别离愁。\n溪上船催发，寒潮没远洲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4213,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"开垆日有感是日始见霜","author":"陶宗仪","text":"阳月日云初，新霜万瓦铺。\n具羞供墓祀，炽炭煖寒炉。\n望望乡关远，栖栖旅思孤。\n形骸看渐老，节序不停徂。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4214,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽张云庄宗礼三首 其一","author":"陶宗仪","text":"客邸病萦纡，惊忧郁未舒。\n紫桫函蜕骨，白下返灵舆。\n故里千年别，浮生一梦如。\n莫云庄上些，山雨竹楼虚。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4215,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽张云庄宗礼三首 其二","author":"陶宗仪","text":"嫁殃遭太守，簿录降将军。\n短景灯馀燄，繁华水上云。\n贤愚谁复辨，玉石竟俱焚。\n次第修言行，他时表墓文。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4216,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"挽张云庄宗礼三首 其三","author":"陶宗仪","text":"呜呼吾友汲，相望去程遥。\n遗恨孤慈侍，清魂入大招。\n诸儿铜鼓卫，一穴凤山椒。\n泪洒西风里，交情永寂寥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4217,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"洪武癸酉正旦雨明日雨中夜雷电又明日雨四日阴曀严寒西北风大作口号","author":"陶宗仪","text":"迎春半月先，寂历过新年。\n鸡狗羊猪忌，风雷电雨全。\n玄冥虽代谢，阳德未昭宣。\n有待阴霾散，乾坤始泰然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4218,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九日雨","author":"陶宗仪","text":"三年元日雨，今雨欲经旬。\n洋海开涂者，金山馈粟人。\n体寒衣绽裂，腹馁食艰辛。\n上帝垂慈悯，晴暄振困贫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4219,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"二月六日雪","author":"陶宗仪","text":"春半三番雪，田更诵里谣。\n一年防暴水，九月定盲飙。\n色妒梅枝瑩，花黏蝶翅消。\n暂时成凛冽，玉烛自能调。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4220,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"庚午七月三日大风雨视丁卯岁为尤甚独松江若此他郡无有也","author":"陶宗仪","text":"雨从朝起骤，风到夜深狂。\n仆屋摇坤轴，漫江遍海乡。\n喜无秋旱暵，未卜岁丰荒。\n较彼前三载，而今势益强。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4221,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"六月廿九日喜雨","author":"陶宗仪","text":"六月三旬旱，炎威酷吏犹。\n廿年无此热，一雨近初秋。\n田亩尘随伏，禾苗病向瘳。\n丰登还可望，生计尚堪谋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4222,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"二月朔夜中雷始发声三日寒载严雪大作","author":"陶宗仪","text":"前夜起雷声，寒威刃发硎。\n积阴春黯惨，密雪昼飘零。\n香褪梅腮白，愁缄柳眼青。\n拥垆频炽火，不似肉为屏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4223,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"七月三十日雨","author":"陶宗仪","text":"半月值秋晴，凉生枕簟清。\n嘉禾方孕秀，甘雨又滋荣。\n造物功难报，斯民乐有生。\n输租庚责了，仓庾定充盈。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4224,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"洪武丁卯腊月癸亥雪","author":"陶宗仪","text":"六花凝瑞白，已见腊前三。\n寒色清逾烈，羁怀老不堪。\n穷阴连漠朔，丰稔在江南。\n驴背溪桥客，煎茶恐未谙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4225,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"腊月初二夜雪","author":"陶宗仪","text":"吼树朔风雄，寒欺绣被重。\n地浮银渤澥，山吐玉芙蓉。\n瑞象标初腊，欢怀慰老农。\n岁登端可卜，百谷遍提封。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4226,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"十二月十三夜雪","author":"陶宗仪","text":"滕六夜停骖，乾坤玉气涵。\n树肤寒拥肿，松发白{矜}鬖。\n驴背吟何苦，垆头饮正酣。\n隔墙农父语，喜见腊前三。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4227,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"正月十二日雪","author":"陶宗仪","text":"立春才二日，撩乱雪花飞。\n阴晦云同色，严凝晓肆威。\n拥炉频炽火，对酒趣添衣。\n德泽终当布，斯民莫叹欷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4228,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"至日听雨","author":"陶宗仪","text":"至日听寒雨，今宵忆向曾。\n漏催铜史箭，花灺木奴镫。\n愁垒坚难破，骚坛峻可登。\n苦吟无好语，白发已鬅鬙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4229,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"甲子又晴","author":"陶宗仪","text":"田家春甲子，分外要清明。\n水旱因从卜，休祥亦可旌。\n明年期大稔，今日喜长晴。\n为报西畴老，知时好力耕。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4230,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"元宵雨","author":"陶宗仪","text":"三五元宵节，连年气候同。\n漫天来暮雨，吼地起南风。\n灯火楼台寂，笙歌巷陌空。\n金吾徒弛禁，清坐惬深衷。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4231,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"连日积雪酿寒晓起见雪腊月十一日也","author":"陶宗仪","text":"四野话丰年，三番见腊前。\n意从多日厚，色瑩六葩妍。\n溪艇因思汎，铛茶趁埽煎。\n老翁无此兴，拥火醉陶然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4232,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"九月廿七日","author":"陶宗仪","text":"九月三旬里，浑无几日晴。\n轩墀檐雀浴，农室灶蛙鸣。\n点滴疑天漏，汪洋觉地平。\n烟蓑樵水稻，此去若为生。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4233,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和董良史宪佥西郊草堂杂兴八首 其一","author":"陶宗仪","text":"杏花春雨映溪堂，不异当年碎锦坊。\n重碧破除千万事，硬黄临写十三行。\n枌榆夹道阴连屋，鱼鸟亲人水满塘。\n觅句有时成久立，草茵藉坐槿篱傍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4234,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和董良史宪佥西郊草堂杂兴八首 其二","author":"陶宗仪","text":"西郊辟地搆名堂，绝胜南村小柳庄。\n得意四时从啸咏，读书万卷保行藏。\n雕胡米滑甘于粟，莴苣苗肥绿似秧。\n野饭菜羹皆适口，一真滋味静中长。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4235,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和董良史宪佥西郊草堂杂兴八首 其三","author":"陶宗仪","text":"清溪脉脉抱虚堂，新竹娟娟过短墙。\n问柳寻花春事晚，投壶散帙午阴凉。\n时将芳糗充鱼饵，岁会香粳备鹤粮。\n如此閒情真自适，可无幽梦入鹓行。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4236,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和董良史宪佥西郊草堂杂兴八首 其四","author":"陶宗仪","text":"老来岁月去堂堂，夙佩君恩不敢忘。\n炎汉辞官容广受，圣朝立极过轩唐。\n秫田春雨租牛种，茗盌凉风对鹤尝。\n清兴有时吟不了，天边罗立九山苍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4237,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和董良史宪佥西郊草堂杂兴八首 其五","author":"陶宗仪","text":"日长双燕语深堂，树木参天枕簟凉。\n龙德光明今宇宙，犬牙相制古封疆。\n人庞俗厚宜栖止，岁泰时康匪禬禳。\n我亦有家归未得，浙江东去路微茫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4238,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和董良史宪佥西郊草堂杂兴八首 其六","author":"陶宗仪","text":"吟成池草坐西堂，胸次悠然隘八荒。\n静悟游鱼投饵急，閒看飞燕葺巢忙。\n采山钓水唐人愿，长子生孙汉吏仓。\n高尚循良同一致，要令身世保平康。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4239,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和董良史宪佥西郊草堂杂兴八首 其七","author":"陶宗仪","text":"萧萧落木护秋堂，白版为扉掩夕阳。\n尘垢不沾频洒埽，稻粱巳熟渐收藏。\n摄生未用芝和术，具膳能无芥与姜。\n一榻清风渺千古，看他奔走为人忙。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4240,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和董良史宪佥西郊草堂杂兴八首 其八","author":"陶宗仪","text":"执经弟子早升堂，客至何妨卧下床。\n家世泽流遗牒在，御炉烟染赐衣香。\n锦囊缥帙新增集，玉轴牙签旧补亡。\n邻舍相邀长是醉，此身终老白云乡。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4241,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵宁熙中上人姑苏纪游十首 其一 华山阻雨","author":"陶宗仪","text":"东南风急布帆轻，长泖西来第一程。\n此日忽逢春莫雨，何人不望客中晴。\n烟峦朵朵鬟凝碧，石溜溅溅玉奏声。\n且向华山溪口泊，推篷涤研写幽情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4242,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵宁熙中上人姑苏纪游十首 其二 喜晴","author":"陶宗仪","text":"澹雾冥濛日晏升，揽衣遥见阖闾城。\n十分天气依然好，一色波光远近明。\n紫燕将雏花上语，锦鸠呼妇树头鸣。\n道傍农父交相庆，菜麦青青喜快晴。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4243,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵宁熙中上人姑苏纪游十首 其三 山行偶兴","author":"陶宗仪","text":"鬼护神呵两怪松，晚晴长阪绿阴浓。\n泉声喷壑溪东走，岚气涵空日下舂。\n毫楮出奁题好句，杖藜到处发奇踪。\n近来蜡得登山屐，拟约重游意未慵。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4244,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵宁熙中上人姑苏纪游十首 其四 游天池","author":"陶宗仪","text":"雨馀弭棹钓矶头，一锡翩翩纵远眸。\n翠壁石蹲形似虎，龙渊云堕气如牛。\n人间幻出三千界，天上移来十二楼。\n更陟层颠穷睇盼，只疑咫尺是瀛洲。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4245,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵宁熙中上人姑苏纪游十首 其五 游灵岩","author":"陶宗仪","text":"灵岩拔起拱诸峰，林壑深幽与昔同。\n谁念夫差罢敝后，莫逃范蠡计谋中。\n弹琴石老菭花紫，响屧廊空夕照红。\n里叟不谙亡国恨，至今犹说馆娃宫。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4246,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵宁熙中上人姑苏纪游十首 其六 游天平","author":"陶宗仪","text":"树木沈沈翠作堆，瘦筇缓步首频回。\n天平山水真佳矣，文正祠堂亦壮哉。\n碧落高寒超下界，白云清煖隔浮埃。\n长怀往事成悽断，为读残碑剔藓苔。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4247,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵宁熙中上人姑苏纪游十首 其七 游南峰寺","author":"陶宗仪","text":"昔游曾记与诸贤，藉草高谈雪满颠。\n白鹤青骢开士逝，丹厓碧岫野花然。\n虎丘东去无多地，龙脉西通第二泉。\n长欲携书此中住，自随春雨种山田。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4248,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵宁熙中上人姑苏纪游十首 其八 沈一庵山居","author":"陶宗仪","text":"懒性生憎世累萦，功名从此不相能。\n堂成自可同兰若，客至何妨话葛藤。\n仪宇如如瑶圃月，心怀炯炯玉壶冰。\n扁舟早晚相寻去，湖上群峰取次登。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4249,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵宁熙中上人姑苏纪游十首 其九 宿观音寺","author":"陶宗仪","text":"锡杖寻幽四月交，山中地位总清高。\n一庭萝月县金鉴，万壑松风响翠涛。\n云卧已知随处好，浪游无愧此生豪。\n上方梦觉清如洗，况是鹤鸣从九皋。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":4250,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]