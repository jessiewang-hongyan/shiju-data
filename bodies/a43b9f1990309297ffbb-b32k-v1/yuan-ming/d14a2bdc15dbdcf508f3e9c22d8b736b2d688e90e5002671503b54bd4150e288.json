[{"title":"次王苍雪韵五首 其三","author":"郑洪","text":"驱驰不觉青春过，离别只应白发生。\n且就东山携月色，不禁南国动秋声。\n天瞻析木低双阙，星拱勾陈转二更。\n庾信平生好词赋，年来哀怨不胜情。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12156,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次王苍雪韵五首 其四","author":"郑洪","text":"百年王业在《豳风》，九鼎犹存涧水东。\n共喜干戈指淮甸，兼闻仗节下崆峒。\n青袍白马飘零外，羽扇纶巾指顾中。\n昨夜天公洗兵甲，一江雷雨似飞洪。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12157,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次王苍雪韵五首 其五","author":"郑洪","text":"东阁诸郎总好文，南州多士望龙门。\n共传江左风流远，且喜河汾礼乐存。\n白咏青丝归赋咏，黄花翠竹共匏樽。\n刘蕡一卷匡时策，更待青灯细讨论。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12158,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"遣闷","author":"郑洪","text":"柳叶参差杏叶团，桃花零落荠花圆。\n那知人事有今日，却忆风光似去年。\n客路青春谁作伴，庭闱白发梦相牵。\n浓愁深似三江水，都在沧洲白马边。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12159,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秀上人饮绿轩","author":"郑洪","text":"半勺沧浪歌濯缨，一瓢天乳酌灵星。\n绀云满涨蒲萄瓮，青雨长悬玛瑙瓶。\n不向苏耽寻橘酒，却从陆羽校《茶经》。\n西江吸尽无穷味，浊世浮沈几醉醒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12160,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"过仪亭","author":"郑洪","text":"扁舟落日过沙湖，十月清霜野水枯。\n稚子刺船争打鸭，小娃倚市夜当垆。\n红红枸杞珊瑚出，白白芦花组练铺。\n有约草堂陈孺子，夜篘浑酒煮江鲈。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12161,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题春江送别图","author":"郑洪","text":"西陵渡口山日出，芦芽青青柳枝碧。\n龛山赭山潮东来，黄郎刺船水如席。\n劝君劝君迟渡江，柳条贯鱼赪尾双。\n治鱼沽酒待明月，人生莫作轻离别。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12162,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题黄子久画","author":"郑洪","text":"二十年前识大痴，棕鞋桐帽薜萝衣。\n星霜老发三千丈，梁栋遗材四十围。\n图画浑如诗句好，丹砂终与道心违。\n筲箕永上青松树，犹覆当年白版扉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12163,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题宋元凯都市寺为中正堂画溪山晚钓图","author":"郑洪","text":"百亩青山二顷田，金溪南畔竹庵前。\n绀园薝葡花香澹，宝地桫椤树影圆。\n日日钓丝牵葑雨，年年禅榻对茶烟。\n郎星昨夜明如月，偏照君家书画船。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12164,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄宁子坚","author":"郑洪","text":"淀山湖头鸥鸟飞，谢家泖口鳜鱼肥。\n菱花正熟胡儿米，荷叶新裁楚客衣。\n鹤立瑶阶毛羽整，雁来沧海简书稀。\n诗囊织得天孙锦，应寄南城白版扉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12165,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄毛府判","author":"郑洪","text":"南湖水长没蒹葭，西浦横桥对白沙。\n鸿雁来时菰有米，凤凰飞处竹无花。\n石田赋写张平子，云阁书通蔡少霞。\n零落江陵千树橘，青门犹恋故侯瓜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12166,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄宋国瑞二首 其一","author":"郑洪","text":"虎豹重关锡命来，麒麟高阁画图开。\n七书总是平时略，三策应非济世才。\n玉树无花江令老，青袍似草庾郎哀。\n风尘满地江湖迥，都把心情付酒杯。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12167,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄宋国瑞二首 其二","author":"郑洪","text":"析木天清泰运开，五陵佳气郁崔嵬。\n楼船尽向东溟去，天马新从西极来。\n一统王春行四岳，六符星象正三台。\n会同馆客多如雨，说道黄金又筑台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12168,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"凤凰山报国寺","author":"郑洪","text":"当时此地肃朝班，阊阖深沉虎豹关。\n大将偃旗奔鲁壁，降王衔璧下吴山。\n空中万马浮金碧，梦里千官拥佩环。\n极目长江如练带，百年谁似白鸥閒。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12169,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"和谢雪坡太守咏新城","author":"郑洪","text":"十二城楼面面开，登高送远兴悠哉。\n玉虹万丈横银海，白雁千行下弩台。\n漂泊自怜能赋客，艰难谁识济川才。\n长江不作东南限，拱北楼头画角哀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12170,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题冯叔才芭蕉仕女","author":"郑洪","text":"杨花梦觉春阴阴，凤钗绾髻双黄金。\n守宫血冷臂如削，豆蔻茧红愁正深。\n罗衣熨帖沉烟缕，恨身不作双飞羽。\n芭蕉心折郎未归，蔍葱花开泪如雨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12171,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浙江亭留题二首 其一","author":"郑洪","text":"海门潮水贯长虹，天际山形隐伏龙。\n南省官曹终日醉，西陵烽火隔江红。\n黄金不铸岳武貌，青史直书刘巨容。\n潇洒江南哀不尽，庾郎才赋若为工。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12172,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"浙江亭留题二首 其二","author":"郑洪","text":"江头日暮虎成群，城北城南路不分。\n魏阙共瞻天际日，越乡遥见浙东云。\n湖山翠黛颦西子，江渚旌旗望北军。\n闻说汉廷将喻蜀，茂陵司马尽能文。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12173,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"萧山秋兴二首 其一","author":"郑洪","text":"阑干曲曲倚西风，桂树悬秋月正中。\n千里功名怜枥马，百年身世愧冥鸿。\n天垂南斗星犹北，江绕西陵水自东。\n抚罢吴钩双泪落，饭牛扪虱尽英雄。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12174,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"萧山秋兴二首 其二","author":"郑洪","text":"双杵孤砧捣客心，野云江树障秋阴。\n越王台上青山小，贺监湖头绿水深。\n负郭已无田二顷，传家那有橘千寻。\n卧龙只合南阳老，梁甫愁来莫浪吟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12175,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"送楚良之杭州","author":"郑洪","text":"七月仙舟溯大江，满江花雨送飞幢。\n琳琅金■笔五色，天宝龙光剑一双。\n春透桃花青海浪，秋涵桂树白云窗。\n别离最苦东曹掾，醉倒沙头玉两缸。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12176,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄张景叔□钦若","author":"郑洪","text":"衡门草深鞍马稀，泖湖水多菱芡肥。\n贱买黄鱼供蓐食，宽裁白苧制深衣。\n七州聚铁不成错，六鹢过都甘退飞。\n寄谢淮南两文学，相思新减玉腰围。","collection":"元末明初","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12177,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄祇园师煦东白","author":"郑洪","text":"一别东林远法师，十年沧海梦相思。\n黑貂已弊犹存舌，白社虽贫尚有诗。\n菰米云深鸿雁饱，梧桐月冷凤凰饥。\n台州若问狂司户，张翰湖头两鬓丝。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12178,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄静庵","author":"郑洪","text":"钱唐三百六十寺，南北两峰图画开。\n三秋桂子月中落，万里潮头天上来。\n金汤故国旌旗暗，锦绣新城鼓角哀。\n大法一丝悬九鼎，雨花飞绕讲经台。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12179,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄楚良","author":"郑洪","text":"八月西山爽气多，两峰如髻绿嗟峨。\n苏公堤上无杨柳，岳武坟前多薜萝。\n关口烽烟苗子寨，江头风浪越郎歌。\n远游不似归来好，菱芡满湖生白波。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12180,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题张士厚四时仕女四首 其一","author":"郑洪","text":"绣帘压地花阴阴，凤钗绾髻双黄金。\n飞丝千尺不堕地，绝似江南游子心。\n宝奁百刻烟如缕，暗掷金钱卜神女。\n樱桃子熟人未归，蔍葱花开泪如雨。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12181,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题张士厚四时仕女四首 其二","author":"郑洪","text":"金盆沐晓蟠双鸦，绿红粉汗沾蝉纱。\n金刀取玉薄于纸，渴心欲死东陵瓜。\n木兰艇子沙棠楫，采莲得花弃荷叶。\n荷叶轻如薄倖儿，莲花酷似多情妾。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12182,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题张士厚四时仕女四首 其三","author":"郑洪","text":"梧桐月小蟾蜍蛰，芙蓉露冷铜山泣。\n金粟香悬十二阑，袜罗尘沁莓苔涵。\n画屏绛烛烟未销，夜深恨杀双鸾箫。\n唤回金屋鸳鸯梦，不到银河乌鹊桥。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12183,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题张士厚四时仕女四首 其四","author":"郑洪","text":"霜蟾弄影窥金屋，么凤吹香绚银烛。\n绣罗小袜蹙双莲，翠袖垂肩倚孤竹。\n红锦冻折水如车，寒衣递到长风沙。\n莫遣朝云妒桃叶，寄将春信与梅花。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12184,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题梅花道人偃松","author":"郑洪","text":"墨池帽脱管城子，璧府罄折徂徕公。\n玉关金锁掣玄豹，铜台瑶柱蟠苍龙。\n星霜鬓眉遽如许，铁石肝胆将谁同。\n丈夫受命当伛偻，天子法驾行东封。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12185,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"八月三日夜宿张景叔听雨联句忆张思廉","author":"郑洪","text":"黑云如浪没金鸦，白雨连山卷雪车。\n观海仙人骑赤鲤，驱雷使者蹑黄蛇。\n千茎雪溜悬银竹，一穗秋灯垂宝花。\n门外波涛接河汉，客星光彩动灵槎。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12186,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄周茂卿兼简蔡彦文叶德新","author":"郑洪","text":"客里无书问起居，云间有客报新除。\n郎官星彩联台辅，宝剑虹光贯斗墟。\n莼菜江湖秋渺渺，芙蓉帘幕雨疏疏。\n东曹二妙真连璧，不寄钱唐双鲤鱼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12187,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感兴二首 其一","author":"郑洪","text":"巍巍华岳镇黄河，漫说东南王气多。\n天堑波光千尺练，海门山色一青螺。\n中台已应张华谶，明月空闻斛律歌。\n白马青袍最萧瑟，故乡何处是铜驼！","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12188,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感兴二首 其二","author":"郑洪","text":"关陕雄藩未歃盟，江淮豪杰已鏖兵。\n金盘泣下铜仙泪，璧月歌残玉树声。\n斗柄西横文曲暗，天枢北转太阶明。\n小臣解著中兴颂，怅望黄河几日清。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12189,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"映雪斋","author":"郑洪","text":"八窗阑槛倚冰梁，四座图书贝月光。\n眼眩欲迷《黄竹赋》，神游疑在白云乡。\n琼台花满潇潇下，石鼎茶烟细细香。\n想得哦诗清镜里，霜娥一夜泣潇湘。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12190,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"悼圣福林","author":"郑洪","text":"掀龙舞象下西天，傲睨烟霞八十年。\n忍见琼林凋玉树，俄闻火井迸红莲。\n草堂居士非凡客，兰若渊明是夙缘。\n不及生刍浇奠酒，且将秋菊荐寒泉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12191,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题梅道人平林野水图","author":"郑洪","text":"浣花溪头车骑发，镜湖影里画图开。\n有客相寻草堂去，何人却棹酒船回。\n是处山林有真隐，如此风尘无好怀。\n青袍不似黄冠乐，二老风流安在哉。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12192,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"题盛叔章画","author":"郑洪","text":"记得天台雁宕归，满山松露湿人衣。\n十年眼底无林壑，今日画图看翠微。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12193,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"大姑谣","author":"郑洪","text":"大姑嫁将军，小姑未有夫。\n小姑两脚泥，大姑满头珠。\n前月小姑去，嫁作庄家妇。\n钗削爨下荆，衣裁机上布。\n大姑嗔小姑，生憎儿女痴。\n多少马上郎，偏爱牧羊儿。\n八月点军卒，将军五门出。\n大姑诧夫婿，上马快如鹘。\n昨日边报归，大姑泪如挥。\n郎君马上死，无处寄征衣。\n连理与枯枝，双飞成戢翅。\n都无百夜恩，浪作千岁计。\n小姑庄上来，瓦盆双鲤鲐。\n上堂拜父母，夫妇恣欢谐。\n大姑见小姑，珠翠无颜色。\n低头怨怅天，仰天呼不得。\n人生百年良所无，白头相送真良图。\n东家女郎欲嫁夫，切莫猖狂学大姑。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12194,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"城上乌为李佥宪赋","author":"郑洪","text":"城上乌，飞毕逋，雄飞哑哑雌者呼。\n下饮九曲之清池，上集百尺之高梧。\n乌乌一巢生九雏，去年筑城兴万夫。\n家家力役到妻孥，使君勖我我力痡。\n蒸豚满筐酒满壶，作劳耳热歌呜呜。\n今年城坚如铁石，弩台侵弓土花碧。\n白云为藩树为戟，朱旗星流落日赤。\n马鸣萧萧人寂寂，六门虎贲晨晏食。\n城头高高如屋极，乌朝出飞暮来息，雌雄哺雏乳而翼。\n城上乌，毕逋尾。\n九雏羽翼成，飞去青云里。\n江南无好树，处处烽烟起。\n危枝绕遍不堪栖，昨日归来旧巢底。\n使君青骢马，系在垂杨下。\n手中金仆姑，不惊城上乌。\n恩情双飞鸟，遗爱在中吴。\n使君去，几时回？\n新城高百雉，仰德并崔嵬。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12195,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋怀","author":"朱希晦","text":"怪底浮云翳碧空，千山秋色入溟濛。\n何当一扫群阴尽，坐看东方片日红。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12196,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次李二丈韵","author":"朱希晦","text":"看花醉眼不须扶，花下长歌击唾壶。\n回首荒城春较晚，淡烟疏雨绿平芜。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12197,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感时二首 其一","author":"朱希晦","text":"阴霾昏日月，妖气塞乾坤。\n战血流淮水，音尘隔蓟门。\n浮荣槐蚁集，丛谤棘蝇喧。\n欲效东陵隐，终身老种园。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12198,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"感时二首 其二","author":"朱希晦","text":"触目伤时事，干戈郁未开。\n百年驰白日，万里涨黄埃。\n废苑犹花柳，荒城但草莱。\n登楼作赋罢，不独仲宣哀。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12199,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"时事","author":"朱希晦","text":"贫病知交态，驱驰愧老身。\n蓟门深雨雪，淮海暗风尘。\n虽有楼船将，能无柱石臣。\n会须安反侧，早晚画麒麟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12200,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"秋兴","author":"朱希晦","text":"月明何处乱啼乌，坐久徒怜永夜徂。\n千里关山双雪鬓，百年城郭半烟芜。\n穆生谢病先辞楚，张翰知机远忆吴。\n衰晚不如归隐好，故山随处且樵苏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12201,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"寄周廷石","author":"朱希晦","text":"门外曾无长者车，一身奔走岂安居。\n谁怜杜老常为客，我怪洪乔不寄书。\n烟色春归杨柳底，雨香红入杏花初。\n溪山咫尺风尘隔，却忆情人会面疏。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12202,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"有所思","author":"朱希晦","text":"虚闻将帅拥彤戈，勇锐谁如马伏波。\n几处烽烟连夜急，四郊风雨向秋多。\n最怜绝汉歌《黄鹄》，却怪长安餍紫驼。\n俯仰乾坤增感慨，悠悠身世定如何。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12203,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"伤时","author":"朱希晦","text":"流年华发两相催，眼底烟尘郁不开。\n太息有人趋玉食，可怜无地筑金台。\n城边向晚黄狐立，海外何年白雉来。\n万事何如一醉好，且须洗盏酌春醅。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12204,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"次韵简缑山侯德询徽之二徵士","author":"朱希晦","text":"幽寻杖策绕林泉，随处遨游兴洒然。\n曾向山中招隐士，欲来海上候神仙。\n云深丹灶长瑶草，水满石池生碧莲。\n薄暮凭阑时送目，白鸥飞雪点江烟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12205,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"访双溪上人不遇","author":"朱希晦","text":"双涧萦回石径微，烟岚分翠湿人衣。\n松林夜静鹤初睡，花院日长僧未归。\n万里云霄飞锡远，半江风浪渡杯迟。\n无缘相见空相忆，自叹心期与愿违。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12206,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"腊日偕叶东白蔡伯恭登西岑","author":"朱希晦","text":"绝顶云深一径通，寒生短发怯天风。\n千年物色阑干外，万井人家图画中。\n宿雨乱滋岚树碧，朝暾深浴海波红。\n我来欲访香山社，醉酒长吟忆远公。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12207,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"比述二首 其一","author":"朱希晦","text":"宝镜何团团，光辉瑩冰雪。\n疑是造化炉，神工初铸出。\n又疑广寒宫，飞堕一片月。\n照人不照心，红颜易衰歇。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12208,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"比述二首 其二","author":"朱希晦","text":"彤弓如半月，力挽二石强。\n戡乱乃见用，櫜鞬宁久藏。\n应弦不虚发，狐兔焉敢当。\n畴能挟长矢，为我殪天狼。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12209,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"纳凉","author":"朱希晦","text":"无事解衣坐，超然心境空。\n深林翳炎日，万壑来天风。\n间停白羽扇，试拂朱丝桐。\n醉罢不知夕，月生沧海东。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12210,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"自述","author":"朱希晦","text":"槿花不终朝，幽兰有馀香。\n朝游诗书圃，夕憩翰墨场。\n饱食待秋实，过眼捐春芳。\n畴能事形役，奔走白日忙。\n男儿生堕地，壮志在四方。\n胡为守一室，郁郁徒悲伤。\n何由写胸臆，酣酒竭罍觞。\n高飞羡黄鹄，矫翮凌云苍。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12211,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"写怀","author":"朱希晦","text":"巢居不厌客，况乃佳客至。\n撷蔬荐浊醪，谈经得真趣。\n归云度遥岑，斜日在高树。\n对饮须尽欢，何时复相遇。\n人生能几何，行乐贵适意。\n不见萍与蓬，飘飘无定处。\n搔首仍踟蹰，临风发长喟。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12212,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}},{"title":"冬雨叹","author":"朱希晦","text":"癸卯冬十月，海陬气候偏。\n风南忽风北，寒燠非常年。\n缊袍御还脱，长箑挥不捐。\n胡为黄落时，花卉纷争妍。\n虫鸣应蛰户，虹见饮长川。\n兼旬苦雾密，暝与痴云连。\n深泥污后土，行潦凌高原。\n农夫辍耒耜，劳叹心悁悁。\n二麦不得种，饥坑讵能填。\n格斗况未息，中原拥戈鋋。\n天家重租税，疮痏谁能怜？\n安得倚天剑，一扫开青天。\n金乌任腾翥，出自扶桑颠。\n阳光照六合，此屋俱欢然。","collection":"元末明初","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"元末明初.csv","pointer":12213,"sha256":"e2e411b7b708d994056dbe022a77862f13e3bfddbb441220249443ddf0319215","dynasty":"元末明初"}}]