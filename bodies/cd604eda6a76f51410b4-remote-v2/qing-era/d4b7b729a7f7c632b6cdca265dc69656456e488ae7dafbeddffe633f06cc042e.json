[{"title":"踏莎行 玉颊啼痕","author":"张令仪","text":"汉帝恩衰，萧郎情薄。\n酿成种种情怀恶。\n两行玉箸界残妆，翠鬟低处珍珠落。\n雨打梨花，烟笼芍药。\n啼多只恐秋波涸。\n时时偷揾绣罗巾，背人佯整秋千索。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24216,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 黛眉颦色","author":"张令仪","text":"几笔轻匀，双峰碧聚。\n幽情都向其间露。\n吴宫多病捧心时，清歌听到销魂处。\n芳草凝烟，远山含雾。\n珠帘独卷娇无语。\n春尖偷蹙湿啼痕，一腔心事凭谁诉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24217,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 芳尘春迹","author":"张令仪","text":"斗草闲阶，秋千芳径。\n落红软处依稀认。\n雨馀沙浅露微痕，苍苔翠滑偷尖印。\n檀屑铺匀，金莲娇衬。\n晚风欲起扶初定。\n马嵬人去尚留香，屐廊枉作千秋恨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24218,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 云窗秋梦","author":"张令仪","text":"雾阙参差，云楼飘渺。\n芳魂游遍蓬莱岛。\n乌衣鸾佩奏清商，红尘不羡邯郸道。\n城列芙蓉，阶环瑶草。\n蕊珠宫里秋光好。\n惊回一枕小游仙，晓风残月鸡声早。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24219,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 绣床凝思","author":"张令仪","text":"闲里金针，早完朝课。\n无端惹起闲愁大。\n怪它有鸟唤鸳鸯，双双戏处清萍破。\n半响神驰，心情无奈。\n不知帘外花阴过。\n娇波凝睇九回肠，红绒嚼向何人唾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24220,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 金钱卜欢","author":"张令仪","text":"鹊语无灵，灯花难卜。\n心期暗向青蚨祝。\n龙文掷罢费端详，依稀似许归期速。\n黛减螺痕，臂消红玉。\n寒衾一束和香宿。\n高楼独上更销魂，陌头杨柳参差绿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24221,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 薄暮偶成","author":"张令仪","text":"暝色高楼花柳迷。\n扑帘归燕傍人低。\n一钩新月挂窗西。\n寒入单衣残雨歇，影摇疏竹暮鸦栖。\n可怜小胆怯空闺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24222,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 华曾兄以减字木兰花词见赠，既步原韵","author":"张令仪","text":"残篇断帙。\n蠹鱼独许予同席。\n偷谱伤心。\n敢拟风前柳絮吟。\n薄衾单褥。\n数粒而炊支鹤骨。\n作赋悲秋。\n远逊骚人善语愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24223,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙 咏美人放风筝","author":"张令仪","text":"节近清明天气困，佳人消遣春慵。\n纸鸢擎出小庭中。\n悠然轻扬去，漂泊似郎踪。\n玉腕难牵丝万丈，笑移莲步匆匆。\n身轻先自欲随风。\n倩人扶不定，微晕脸潮红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24224,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"两心同 秋夜听虫声","author":"张令仪","text":"小院黄昏，晚凉时节。\n盼一轮兔魂将升，听几树蝉嘶乍歇。\n早又换络纬，吟风终宵呜咽。\n更被草虫饶舌，韵尤凄切。\n秋来况只有侬知，胸次恶欲和伊说。\n也亏它絮语相依，不烦深责。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24225,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人 元夕","author":"张令仪","text":"耳根聒破笙歌竞。\n灯月无心问。\n梅横疏影小窗中。\n恰与幽人况味略相同。\n银灯火树非吾羡。\n独爱清光遍。\n半生心事付沉沦。\n终是如今对月益伤神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24226,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子 春暮","author":"张令仪","text":"又是绿阴遮。\n柳絮多情点碧沙。\n谢却海棠春老去，愁些。\n寂寞秋千影自斜。\n冷淡作生涯。\n架底荼蘼梦尚赊。\n魏紫姚黄开也未，堪嗟。\n深锁朱门富贵花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24227,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 春夜","author":"张令仪","text":"鹃啼斜月。\n竹影摇窗心暗怯。\n倦倚阑干。\n花信风添半臂寒。\n香薰翠被。\n不如觅个瞢腾睡。\n似有关情。\n梦不容人独夜成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24228,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉楼春 春阴","author":"张令仪","text":"阴云锁合闲庭院。\n花信风寒帘不卷。\n杏花微破粉痕新，芳草才如眉黛浅。\n旧巢未返红襟燕。\n寂寂深闺春梦远。\n痴魂宛转泥香衾，腰围困比烟丝软。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24229,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 不寐","author":"张令仪","text":"绣被五更寒压住。\n一点昏灯，细度清明雨。\n欲觅天涯芳草路。\n梦魂不肯抛人去。\n乱愁多似江南树。\n密密层层，遮断春来路。\n昨日柳丝今日絮。\n韶光也被流年误。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24230,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉楼春 雪夜","author":"张令仪","text":"空阶连夜风兼雪。\n罗纬低掩灯明灭。\n欲凭魂梦访天涯，茫茫一片伤心白。\n正自愁人眠不得。\n芭蕉偏向风前折。\n明朝些事颇相宜，泥深或少催逋客。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24231,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 元夕","author":"张令仪","text":"梅萼微舒，兰芽初破。\n绿窗幽静人闲坐。\n依依素月冷相窥，一帘花影和愁锁。\n九陌游人，千门灯火。\n如何著得寒酸我。\n不如一枕小游仙，瞢腾且掩香衾卧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24232,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙 春晚","author":"张令仪","text":"一枕荼蘼香梦破，绿窗欲起寒微。\n晓风犹怯试单衣。\n留愁消日永，和病送春归。\n又是匆匆花事了，何时满领芳菲。\n天公用意似全非。\n偏从花减色，惯与草添肥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24233,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"念奴娇 中秋夜，五亩园步月，有怀两大人","author":"张令仪","text":"酒阑闲步，向池头、惊起栖鸦阵阵。\n烟净波光澄似练，冰镜双悬蟾影。\n疏树停云，老鱼掷浪，望处轩窗窈冥。\n玉宇琼楼，应不数神仙境。\n好我骚首悲怀，无边夜色，独许游人领。\n白发天涯乡思剧，梦绕雕梁藻井。\n睡鹤鸣霜，寒虫泣露，闲煞秋宵永。\n何时箫管，一棹中流小艇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24234,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 元夕 三首 其一","author":"张令仪","text":"看灯节，忆煞去年中。\n仲虎蹒跚行未稳，季龙娇小语初工。\n也解戏鱼龙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24235,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 元夕 三首 其二","author":"张令仪","text":"看灯节，惨绝是今年。\n何处青磷黏暮草，多时白骨冷荒烟。\n灯火自依然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24236,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 元夕 三首 其三","author":"张令仪","text":"看灯节，比舍好儿郎。\n宝勒红缨骢马戏，金章紫绶宰官妆。\n独使我心伤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24237,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渔父 夏夜 四首 其一","author":"张令仪","text":"柳锁轻烟似远山。\n雾中楼阁杳冥间。\n新雨过，片云还。\n洗出遥天玉一弯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24238,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渔父 夏夜 四首 其二","author":"张令仪","text":"茉莉香浮茗碗清。\n芭蕉雨过晚凉生。\n新浴罢，葛衣轻。\n隐隐雷车天外鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24239,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渔父 夏夜 四首 其三","author":"张令仪","text":"闲阶植过海棠丛。\n小草尤怜霜叶红。\n瓜蔓底，豆花中。\n安排络纬织秋风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24240,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 湘门别后，大雨不止，因成二阕 其一","author":"张令仪","text":"桃杏匆匆都过却。\n海棠帘外，又破胭脂萼。\n整日风欺和雨掠。\n无情最是天公虐。\n况复绿窗人作恶。\n客去天涯，何处堪栖托。\n野店残灯村酿薄。\n征衫湿透难温著。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24241,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 湘门别后，大雨不止，因成二阕 其二","author":"张令仪","text":"别离已惯何曾悔。\n短蹇冲泥，那更貂裘敝。\n自是饥驱宁得已。\n凄风苦雨偏相戏。\n晴光何日方开霁。\n默坐支颐，压煞重云腻。\n怪底小鬟能相忆。\n扫晴娘向檐前系。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24242,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 春梦","author":"张令仪","text":"兰缸半隐薰篝灭。\n一束单衾，凤尾香罗叠。\n人共荼蘼香梦结。\n遽然身世谁为蝶。\n柳花飞作关山雪。\n露冷烟浓，何处分吴越。\n欲倩离魂随去客。\n杜鹃休沥三更血。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24243,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"山花子 梅开，悼两大人","author":"张令仪","text":"云中鸾鹤杳难攀。\n亭树凄凉昼掩关。\n屋角老梅开遍也，倩谁看。\n春色年年标玉骨，幅巾何处觅苍颜。\n暮上小楼还一望，泪痕斑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24244,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤栖梧 新秋月夜坐柳阴小艇","author":"张令仪","text":"碧天渺渺波同色。\n□透花阴，满地玲珑月。\n短葛凉轻纨扇歇。\n晚风细细荷香涩。\n小葺幽窗烟柳接。\n稳载琴书，不怕风波劣。\n藻荇横铺水光湿。\n相看但少中流楫。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24245,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"朝中措 答光侄女","author":"张令仪","text":"黄昏密雪卷银沙。\n寒较夜来些。\n几树黄梅初放，幽香暗透窗纱。\n三尺焦桐，一床湘帙，冷淡生涯。\n若问主人活计，朝来典到菱花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24246,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"庭院深深 登楼望五亩园","author":"张令仪","text":"夜雨池塘新涨满，翠痕如沐遥山。\n园林萧寂不开关。\n输它鱼翠，来往占花湾。\n旧事已随飞絮散，海榴红泪斑斑。\n楼台高寄绿波间。\n柳阴垂钓，羡煞那人闲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24247,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"生查子 月夜口占","author":"张令仪","text":"银海碧沉沉，绣户金波泻。\n树影落闲阶，一幅倪迂画。\n丛桂露华溥，香雨飘幽榭。\n我欲叩琼楼，相邀趁清夜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24248,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙 虫声","author":"张令仪","text":"小院新凉风细细，草根虫语吟秋。\n萧萧络纬织成愁。\n寒衣未办，蟋蟀替人忧。\n亦有好怀当胜境，笛声何处高楼。\n沙厨冰簟绿窗幽。\n香浓丛桂，傍堕玉搔头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24249,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杏花天 本意","author":"张令仪","text":"鸦啼金井纱窗晓。\n掩重门、梦回人悄。\n杏花一夜齐开了。\n付与斜阳芳草。\n曲江宴、轮啼久杳。\n玉楼人、眠多起少。\n枝上红香看渐耗。\n那更卖花声到。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24250,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人 雪夜","author":"张令仪","text":"难成幽梦衾如铁。\n断送残年雪。\n银沙渐沥响空阶。\n多半随风吹入、纸窗来。\n早梅几树香先透。\n愁煞冰魂瘦。\n化工殊失养花心。\n玉骨能禁几度、苦寒侵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24251,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤凰台上忆吹箫 新岁作","author":"张令仪","text":"青帝更新，朱颜非故，韶光老去难回。\n正花灯照夜，箫鼓如雷。\n巷陌人人欢畅，酬佳节、舞榭歌台。\n寒炉拥，谁其知我，心死如灰。\n摧颓。\n行年五十，叹过头又二，眉未曾开。\n但一生胸次，块垒成堆。\n大似空山老衲，恹恹守、土木形骸。\n惟相称，层冰积雪，僵卧寒梅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24252,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一剪梅 春雪","author":"张令仪","text":"积雪凝阴万里赊。\n雪锁乾坤，冻合天涯。\n阶前无处觅兰芽。\n柳眼慵开，玉箸痕斜。\n僵卧危巢鸟不哗。\n节到春分，未启窗纱。\n东皇好尚近来差。\n贪看冰花，误却梅花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24253,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"庭院深深 己亥清明","author":"张令仪","text":"前岁清明游兴畅，扁舟西子湖头。\n六桥烟景望中收。\n天涯歌吹，金粉簇层楼。\n今岁石门酬令节，山光树色清幽。\n暖风轻扬钓丝柔。\n桃花流水，别自有丹丘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24254,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卖花声 桃花","author":"张令仪","text":"临水枝枝，妆点春光如许。\n晓妆解、犹含宿雨。\n粉腮红晕，似楚妃无语。\n乍离魂、亭亭倩女。\n此中须著，西塞山前渔父。\n放扁舟、水云深处。\n绿蓑青笠，长作溪山主。\n方消得、明霞千树。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24255,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"天仙子 南郭看桃花","author":"张令仪","text":"南亩烟消啼布谷。\n雨洗夭桃朝睡足。\n粉霞千树艳明妆，红映肉。\n酣丝竹。\n陌上香尘驰钿毂。\n短短疏篱依古木。\n茅屋数间殊不俗。\n小桥流水带垂杨，清溪曲。\n春波绿。\n风动落花红簌簌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24256,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"庭院深深 寒夜","author":"张令仪","text":"霜剪芙蓉寒刺骨，纸窗破处风严。\n萧萧落叶打疏帘。\n药炉灰冷，贫与病相兼。\n陋巷簟瓢今已矣，一生常乏斋盐。\n哀鸿和露堕穷檐。\n明朝双鬓，白发几丝添。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24257,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆萝月 夜坐忆儿","author":"张令仪","text":"寒风瑟瑟。\n正是愁时节。\n灯昏残花红泪滴。\n旅雁数声凄切。\n可怜游子天涯。\n短衣匹马胡沙。\n异国依人远去，须眉料结冰花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24258,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 清明悼夫子","author":"张令仪","text":"陌上饧箫，又送到、清明时节。\n空回首、故人何处，音容难接。\n误认天涯犹未返，惊看素旐灵风曳。\n滴寒灰、和泪奠香醪，空悲切。\n任杜宇，千行血。\n唤不醒，长眠客。\n岂天南地北，关山阻隔。\n露冷灯残天入梦，月斜风细花如雪。\n愿此时、魂魄一来归，从头说。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24259,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"意难忘 春夜","author":"张令仪","text":"宿雨初晴。\n正海棠红湿，杨柳烟轻。\n谁家银烛宴，何处玉箫声。\n花自好、月空明。\n叹深院凄清。\n独自把、回廊绕遍，少个人行。\n芙蓉隔断层楼。\n岂仙凡路杳，幻梦忘情。\n鹃啼催泪落，树影乍心惊。\n思往事、恨难平。\n但尘锁铭旌。\n问何日、鹤归华表，重话三生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24260,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤栖梧 薄暮","author":"张令仪","text":"归燕双双栖画阁。\n风卷湘帘，几点残红落。\n独坐小窗滋味恶。\n黄昏细雨春寒薄。\n倚遍阑干尤寂寞。\n一枕瞢腾，欲访槐安国。\n旧恨新愁牢束缚。\n未眠先自愁难著。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24261,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"惜馀春慢 秋日远峰亭感旧","author":"张令仪","text":"丛桂香妍，海棠睡足，亭院秋光如水。\n双亲昼锦，棠棣敷荣，雏燕成行花底。\n也学刻烛分题，翠管牙签，硬黄摩字。\n但妆成画阁，炉爇芸烟，衫裁杏子。\n回首处、墓木云封，沙堤月冷，隔四十年前事。\n池塘梦远，雁序风高，天外鱼书难寄。\n独我泥途輱轲，病鹤摧颓，孤鸾憔悴。\n步苍茫景物，依然往事，江河邈矣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24262,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人 有感，用李后主原韵","author":"张令仪","text":"匆匆霜雪蒙头了。\n细数欢场少。\n落花无语对东风。\n可惜光阴都付、泪痕中。\n乌衣门巷今何在。\n回首斜阳改。\n羡它欧鸟不知愁。\n偷食水荭花底、逐波流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24263,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹧鸪天 壬寅新作","author":"张令仪","text":"尖恻东风送峭寒。\n飞花乱点雪漫漫。\n柳丝难展青青眼，春色穷如我一般。\n刚献岁，少追欢。\n梅花几日不曾看。\n也应怕上西楼望，满目云山客路难。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24264,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉楼春 元夕感怀","author":"张令仪","text":"良宵已自伤怀抱。\n帘外春寒偏料峭。\n银灯光暗展书慵，纸帐香温寻睡早。\n蔗将啖尽无些好。\n五十馀年空过了。\n愁魔缚定不离人，梦魂颠倒添烦恼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24265,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一丛花 楼头望五亩园梨花","author":"张令仪","text":"堤边柳色但藏鸦。\n载酒向谁家。\n红桥断板斜阳外，清池涸、草长鸣蛙。\n雨泣烟笼，何人曾见，一树冷梨花。\n当时犹记旧繁华。\n回首思无涯。\n瑶岛仙人归去也，荒台榭、空锁烟霞。\n寂寞亭轩，流莺独啭，燕剪一双斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24266,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆秦娥 春暮","author":"张令仪","text":"愁无著。\n画眉人去伤离索。\n伤离索。\n芳尘凝榭，绿苔生阁。\n黄昏细雨春寒薄。\n风翻燕尾残红落。\n残红落。\n三分春色，等闲抛却。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24267,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"庭院深深 梦醒","author":"张令仪","text":"一枕新凉残梦破，虫声四壁啾啾。\n芭蕉微雨动人愁。\n寒衣犹未赎，落叶早惊秋。\n弱息天涯为索米，养亲累尔羁留。\n山田岁歉又难收。\n穷愁别恨，齐集寸心头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24268,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南歌子 慰闺人病起","author":"薛琼","text":"雀舌难消渴，虾须不闭寒。\n落花风起更尖酸。\n薄薄罗杉休傍、小阑干。\n煮药忘寒食，薰香犯禁烟。\n乍晴门巷卖饧天。\n检点精神同步、看秋千。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24269,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"小重山 晓过山塘","author":"薛琼","text":"晓风吹我过山塘。\n山藏烟霭里、影微茫。\n红阑翠幕白堤长。\n轻舟动、人在画中行。\n满路斗芬芳。\n携筐争早市、卖花忙。\n家家楼阁试新妆。\n拈鲜朵、点缀鬓云香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24270,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春光好","author":"薛琼","text":"抛菱镜，罢晨妆。\n倚南窗。\n风洒桐花点笔床。\n彩毫香。\n梦里曾拈佳句，醒来更费思量。\n一半模糊思不起，系人肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24271,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 二首 其一","author":"薛琼","text":"消溽暑，修竹荫轩槛。\n梅雨水烹茶嫩白，破砻米煮粥香清。\n调养避荤腥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24272,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 二首 其二","author":"薛琼","text":"无个事，随意遣闲情。\n细织麦柴裁画扇，巧镂鹅卵制萤灯。\n稚子戏相争。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24273,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"薛琼","text":"拂晓花枝宿露凝。\n摘来朵朵滴红冰。\n参差浓淡称瓷瓶。\n照影流霞浸研水，倚风馀麝散溪藤。\n助人吟思十分清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24274,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹧鸪天","author":"薛琼","text":"五月家园花未疏。\n葵榴烂漫闲菖蒲。\n齿拈酸味尝青杏，甲染清香摘紫苏。\n耽午梦，懒照梳。\n挨延长日饭工夫。\n嗔予无过痴儿女，争系新与续命符。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24275,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江城子 乙酉同婶氏游吴门诸山，忆旧昔志慨","author":"薛琼","text":"昔年握别记匆匆。\n柳阴中。\n一帆风。\n两岸青山、相映淡眉峰。\n往返难忘芳草路，归去也，夕阳红。\n哪堪今日倚楼东。\n与谁同。\n暮云空。\n怊怅姮娥、独赴广寒宫。\n梦到家山山更远，寻不出，旧游踪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24276,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"添字浣溪沙","author":"薛琼","text":"绿遍荼蘼水拍天。\n销魂桥畔拂轻烟。\n点点杨花点点泪，思绵绵。\n画舫载将离恨去，指寒呜咽弄冰弦。\n待得月斜云渐冷，未成眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":24277,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]