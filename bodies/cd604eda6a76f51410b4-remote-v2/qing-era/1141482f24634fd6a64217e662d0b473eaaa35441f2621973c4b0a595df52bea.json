[{"title":"哭罗瘿公三首 其二","author":"曾习经","text":"结客遍湖海，逢人只胆肝。\n后时何所措，晚况益艰难。\n丝竹存微尚，沧桑付达观。\n裹头馀尺布，事有至辛酸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43311,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"哭罗瘿公三首 其三","author":"曾习经","text":"寂灭方为乐，难禁一恸情。\n缘空能澹定，度胜是平生。\n骨髓诚何病，琴弦欲废声。\n唱衣犹待瞑，霜露下严更。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43312,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"酒渴引荈听雨达旦","author":"曾习经","text":"已过花时节，宁论酒圣贤。\n解酲烦日注，听雨损宵眠。\n岁事麦苗秀，朝饥菜甲鲜。\n子桑甘闭户，懒与上琴弦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43313,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题谭玉先生《烟雨归耕图》","author":"曾习经","text":"蓑笠携锄事宛然，敢将踪迹比前贤。\n此中风趣吾差识，惭愧宁河过十年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43314,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"韬庵太傅重宴鹿鸣","author":"曾习经","text":"往事休论甲子前，登科恰值中兴年。\n千松磊砢终梁栋，一录流传重简编。\n又被时人写名姓，本来忠孝是神仙。\n簪花正好凌霜菊，玉殿衔杯意自便。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43315,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"郭春榆宫太保七十寿","author":"曾习经","text":"一世才流馀砥柱，故家乔木阅风烟。\n春官桃李看成荫，碧落星辰宛旧躔。\n臣节天心原不负，令名寿考竟兼全。\n谢庭正欲森兰玉，况值齐眉祝引年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43316,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"依韵题王葵园先生与陈诒重郎唱和试卷","author":"曾习经","text":"敢云自靖答君亲，兀兀沧桑劫后身。\n不信前车阵覆辙，未应先觉损天民。\n海内依怙王文祖，五经纷纶井大春。\n正待中流同击楫，相看未分过江人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43317,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨漕书堂书运京寓","author":"曾习经","text":"失喜书船至，相违五岁除。\n拨尘防蠹毁，烧烛费工夫。\n把握欣吾旧，撑肠傥尔须。\n酸儒城拙计，那便置空虚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43318,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"依韵袁觉生丙寅元旦感赋","author":"曾习经","text":"政尔沉沉百念新，涧松谁复禁樵薪。\n孤根自分空盘结，旧馆何缘接燕申。\n默向东风参造化，梦从碧落整星辰。\n十年涕泪兵尘里，满眼看春不当春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43319,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题钟秋岩《涧上草堂图》","author":"曾习经","text":"暮年丝竹资陶写，一壑能专亦大难。\n又恐閒名除未得，山图留与试开看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43320,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梅母之殡","author":"李绛青","text":"路出正阳桥，四衢声鼎沸。\n车马塞道涂，男女满街市。\n询彼何以故？\n梅氏有凶事。\n梅氏何许人？\n客言我告尔。\n不是强军阀，亦非新官吏。\n鼎鼎梅兰芳，花衫最绝技。\n今为祖母丧，殡宫过此地。\n彩仗已森列，輀舆还未至。\n客导使向前，百戏目为翳。\n铭旌一丈长，细读无几字。\n阔扁先总统，彷佛急公义。\n有类黄金榜，宝琦姓孙氏。\n其馀诸哀挽，略可类分四。\n前列为阁部，其次即义士。\n又次为文人，最后属伶界。\n一时狂风来，疾捲同旗靡。\n俄而灵车到，鹄立执绋俟。\n后随多伶官，前引皆卿贰。\n箫笳哀动魄，铙饶暄震耳。\n梅伶挽柩行，梨花微带泪。\n行人惊未见，如睹真仙子。\n拍掌怪叫好，似在舞台底。\n警察为清道，大施鞭与箠。\n观者叹啧啧，谓是福所致。\n余乃告客言，此即是遭际。\n王纲不解纽，岂容此纵恣。\n军政不贪暴，谁助此奢侈。\n玄黄已错行，颠倒难思拟。\n客言壬戌春，两军战易水。\n死者千万人，膏血草为萎。\n京观填一坑，何曾有棺瘗。\n此是何功德，彼又何罪戾。\n余言更勿论，此尤属儿戏。\n一语为客告，人趋势与利。\n兰芳倘不禄，哀荣岂只此。\n必有李天下，观赐九坛祭。\n必有大将军，为请国葬体。\n人妖泊五行，怪状兴乱世。\n莽莽十年间，逆知必至是。\n闻罢叹而笑，略为记一二。\n惜无蒲留仙，大笔重叙次。\n并入金和尚，后先同志异。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43321,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浪淘沙","author":"王时翔","text":"寒入小楼昏。\n月色三分。\n枣花帘子水沉熏。\n一样绣针金剪地，位置偏文。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43322,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"豆叶黄","author":"王时翔","text":"朱楼西畔夕阳黄。\n乳燕飞飞宿画梁。\n茉莉花开小簟凉。\n好思量。\n一个闲庭六扇窗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43323,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其一","author":"王时翔","text":"消减惟应鹊镜知。\n压肩浓绿鬓鬟欹。\n病容扶起淡黄时。\n碧院无人春寂寂，画楼有燕雨丝丝。\n药烟影里过相思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43324,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其二","author":"王时翔","text":"小蕊猩红启瓠犀。\n绿阴门巷有莺啼。\n半障罗扇眼波低。\n影似风前荷泻露，情如雨后絮黏泥。\n恹恹斜日度花西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43325,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其三","author":"王时翔","text":"晓起贪凉梦未圆。\n轻车细马各争前。\n满塍禾黍淡香传。\n斜月犹明初魄夜，远山已瘦乍秋天。\n一襟离思散疏烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43326,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其四","author":"王时翔","text":"初旭铜钲挂影圆。\n笋舆斜驻柳庄前。\n邮亭卯酒一杯传。\n清露凝珠芳草陌，碧云铺縠嫩晴天。\n人家茅屋未炊烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43327,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其五","author":"王时翔","text":"老未成名岁月空。\n依刘赖与素心同。\n高谈清啸意何穷。\n愧我挟书成腐竖，爱他屠狗是英雄。\n闲搔短发向秋风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43328,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其六","author":"王时翔","text":"感叹驱车古道旁。\n周都汉室已沦亡。\n千年一闪堕残阳。\n清洛冰声流碎白，古原柳色带深黄。\n早冬天更做荒凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43329,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其七","author":"王时翔","text":"客里愁深与病兼。\n成皋晓发渡巉岩。\n北来九月气先严。\n初日翳沙如月淡，薄霜侵面似刀铦。\n篮舆空护一重帘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43330,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其八","author":"王时翔","text":"彩扇轻遮画烛红。\n卷帘微步玉丁东。\n眼波低剪篆丝风。\n梅额有香人澹澹，梨云无梦月胧胧。\n暗惊雕刻费春工。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43331,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其九","author":"王时翔","text":"半是含娇半是佣。\n宝钗欲堕翠鬟松。\n锦窝情态为谁浓。\n春浅花新招蛱蝶，夜寒香烬绣芙蓉。\n一弯愁思驻螺峰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43332,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其十","author":"王时翔","text":"觅藕寻莲好涉江。\n明星虽烂有惊庞。\n炉烟消尽拨银釭。\n梦嚅吹兰闻绣枕，月边和影并红窗。\n不应犹道未双双。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43333,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其十一","author":"王时翔","text":"小阁芳兰供一枝。\n黄昏烧烛看幽姿。\n素屏纤影对移时。\n巫峡休猜成楚梦，湘皋惟借入骚辞。\n国香长系美人思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43334,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其十二","author":"王时翔","text":"秀色由来可疗饥。\n忘餐相对复相依。\n无端杜宇唤春归。\n圆怕珠光多不定，轻愁花片易教飞。\n赤阑干畔凭斜晖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43335,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其十三","author":"王时翔","text":"一寸柔肠万里纡。\n好天良夜怅离居。\n独揩清泪五更余。\n情重何妨添病重，形疏祗恐是心疏。\n西楼斜月竟何如。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43336,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其十四","author":"王时翔","text":"绣帐轻褰起欲扶。\n翠尖如揭晓山图。\n绮窗花笑一尘无。\n路近蓝田多美玉，梦经沧海尽明珠。\n人间犹有阮郎孤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43337,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其十五","author":"王时翔","text":"杨柳梧桐翠色齐。\n小鸳么凤镇双栖。\n梦中仙路有丹梯。\n玉簟分明花气重，琐窗萧淡月痕低。\n惺忪那易到如泥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43338,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其十六","author":"王时翔","text":"小院秋光似画佳。\n海棠红映绿莎阶。\n几番闲立写风怀。\n锦瑟怨时知意忤，玉琴调处识心谐。\n可能亲递凤皇钗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43339,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其十七","author":"王时翔","text":"绣榻凝尘画烛灰。\n四垂帘幕映苍苔。\n怯春人卧燕飞回。\n花信不随风信发，愁丝偏接雨丝来。\n冷清清地自惊猜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43340,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其十八","author":"王时翔","text":"流水桃花一段春。\n移舟洞口祗逡巡。\n路迷惆怅在风尘。\n俗客自伤难换骨，仙源谁许易通津。\n始知薄福是渔人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43341,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其十九","author":"王时翔","text":"谁把雕笼翡翠分。\n相思两地不相闻。\n绣帘遮断郁金裙。\n新恨多于春后草，幽期变似夏来云。\n杨花时节倚西曛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43342,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其二十","author":"王时翔","text":"细雨尖风欲断魂。\n落红庭院又黄昏。\n麝烟金鸭被微温。\n无计可令春睡稳，空言亦是玉人恩。\n分明曾许拭啼痕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43343,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其二十一","author":"王时翔","text":"香玉初消不耐看。\n谁怜弱骨更珊珊。\n一声归也泪偷弹。\n迹似燕来逢雁去，心同莲苦带梅酸。\n枕头欹侧五更寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43344,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其二十二","author":"王时翔","text":"短阁清灯照影闲。\n碧云香霭隔银湾。\n萧萧暮雨洒花关。\n燕语呢喃飘枕角，蝶魂离合向屏山。\n依稀记捧玉纤弯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43345,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其二十三","author":"王时翔","text":"十二红楼锁碧烟。\n飞琼萼绿自婵娟。\n骖鸾驾鹤戏芝田。\n隔箔异香霏作雾，堕怀明月远于天。\n玉箫声歇夜如年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43346,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其二十四","author":"王时翔","text":"鬓发轻垂压紫绡。\n蔷薇露浣玉葱娇。\n倦容初起勾魂销。\n日射粉梨光似颊，风搓丝柳细于腰。\n小阑斜倚恁苗条。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43347,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其二十五","author":"王时翔","text":"画阁深沉烛影交。\n镜台拈韵互推敲。\n夜阑斜月在花梢。\n皓齿半含窥浅笑，红霞微涨被轻嘲。\n鸳鸯何事不同巢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43348,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其二十六","author":"王时翔","text":"拨翠山光浸碧涛。\n琳宫移步凤尖劳。\n暮归红烛照吟毫。\n画舫春游人更懒，绣帏浓睡日常高。\n隔帘休把绮琴操。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43349,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其二十七","author":"王时翔","text":"玉藕丝长未上梭。\n文鸳欲织又蹉跎。\n最无聊处看横波。\n人到淡黄方艳极，天交新绿得春多。\n薄衾凉簟奈愁何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43350,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其二十八","author":"王时翔","text":"一剪轻风一片霞。\n玉钩新月画帘斜。\n柳条纤软不胜鸦。\n暧褪锦衾微见雪，香霏绡幔欲笼花。\n可怜春梦落天涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43351,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其二十九","author":"王时翔","text":"标格寒梅韵海棠。\n全身当得翠红乡。\n更饶一种是纤长。\n画槛风丝飘瘦影，绣裙烟缕立斜阳。\n珠帘八尺限萧郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43352,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其三十","author":"王时翔","text":"珍重疏梅一树明。\n晚烟漠漠月枝横。\n对花吟更绕花行。\n清影似嫌银烛烂，断魂应逐素云轻。\n嗅香敲句过今生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43353,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其三十一","author":"王时翔","text":"半倚雕阑半倚庭。\n五更斜月五更星。\n几多沉醉几多醒。\n若有思兮云冉冉，最绡魂处影亭亭。\n枉抛心力向银屏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43354,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其三十二","author":"王时翔","text":"缥缈飞楼第一层。\n蕊珠仙子梦同登。\n琅函玉笈紫霞绫。\n烛暗红蕤容半倚，月明朱槛避双凭。\n似生怜又似生憎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43355,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其三十三","author":"王时翔","text":"玉艳凌风飒飒秋。\n彩云飞去怅难留。\n暮烟新月下帘钩。\n繁氏定情空有梦，江郎赋别只牵愁。\n绿波春草在心头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43356,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其三十四","author":"王时翔","text":"阆苑清虚碧海深。\n玉柯琼干树愔愔。\n风裳云帔称人心。\n新月半墙仙凤杳，朝阳一角彩霞沉。\n去来长是费思寻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43357,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其三十五","author":"王时翔","text":"一镜香云绾玉簪。\n两湾秋水带秋岚。\n海中明月梦中探。\n修竹多依花焰焰，古梅偏傍柳毵毵。\n牵丝千尺老春蚕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43358,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其三十六","author":"王时翔","text":"海燕双归宿画檐。\n玉楼人远暮寒添。\n夕阳红尽暗疏帘。\n悄悄心期辜眼底，沉沉消息压眉尖。\n锦衾空有泪珠淹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43359,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其三十七","author":"王时翔","text":"离思纷纭那可芟。\n消魂桥畔挂轻帆。\n柳花憎杀点征衫。\n远树重重还隐隐，乱山矗聂更巉巉。\n痴心犹是望泥缄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43360,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙三十八首 其三十八","author":"王时翔","text":"意外逢欢把玉纤。\n夕阳罗袖傍疏帘。\n黄花紫蟹正相兼。\n飘荡风尘歌更怨，玲珑心地语犹尖。\n夜深银蜡醉教添。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43361,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮四首 其一","author":"王时翔","text":"银塘演漾飞鸂鶒。\n矮红阑畔绡裙立。\n一路藕丝风。\n水亭残雨中。\n照溪妆里淡。\n色妒芙蓉艳。\n新霁嫩凉天。\n月和团扇圆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43362,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮四首 其二","author":"王时翔","text":"晓妆才罢呵纤手。\n熏炉半拥芙蓉袖。\n压髻蜡梅香。\n红绵映淡黄。\n拂笺羞咏絮。\n别欲题新句。\n砚冻墨花干。\n人怜玉指寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43363,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮四首 其三","author":"王时翔","text":"翠翘偏侧瑶钗溜。\n春葱低剔袜尖瘦。\n扶影下苍苔。\n闲愁何处来。\n画眉元小鸟。\n却爱名儿好。\n欲比住雕笼。\n锁郎香阁中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43364,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮四首 其四","author":"王时翔","text":"神僧不受萧梁佞。\n折芦自渡江波莹。\n九载坐嵩山。\n西飞葱岭间。\n兴亡经百代。\n古洞依然在。\n风急摆浮云。\n驱车入暮尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43365,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"采桑子三首 其一","author":"王时翔","text":"梨花小院东风谢，无主残春。\n燕子专人。\n巷口斜阳记不真。\n个侬背面罗窗下，粉泪偷匀。\n立到黄昏。\n淡月微风上绣裙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43366,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"采桑子三首 其二","author":"王时翔","text":"凉波倒浸层楼影，疏柳寒塘。\n帘里重阳。\n一朵秋花点鬓黄。\n无端惹起离人恨，不住回肠。\n约略新妆。\n曾把茱萸酒数行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43367,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"采桑子三首 其三","author":"王时翔","text":"连朝梅雨端阳近，阿措花开。\n深院闲阶。\n鸟啄猩红下翠苔。\n绿窗记得倾蒲酒，曾有人陪。\n斜点金钗。\n衬出香符彩胜来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43368,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"眉峰碧","author":"王时翔","text":"盎菊残还未。\n月影摇窗碎。\n戏学藏钩赌酒杯，得胜处、矜明慧。\n秀靥红潮起。\n曼睩生微泪。\n一笺陪郎十笺干，算来不合侬先醉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43369,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卜算子","author":"王时翔","text":"病入薄游中，人落西风际。\n一鬓秋兰记昔年，小阁偎侬醉。\n今夜客窗清，月照蛩音细。\n也不思量把酒杯，况有心情睡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43370,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐二首 其一","author":"王时翔","text":"盈头花草。\n又见双文了。\n说道今朝天气好。\n斜倚画阑浓笑。\n多情谁似东风。\n飘然直度帘栊。\n吹出几重衫影，淡黄轻绿殷红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43371,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐二首 其二","author":"王时翔","text":"水阑斜靠。\n细看描花巧。\n墨点朱唇含浅笑。\n并向绿波低照。\n金丸忽散鸳鸯。\n可怜未尽柔肠。\n半日清茶相对，不知几许猜详。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43372,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梁州令","author":"王时翔","text":"红树青山曲，一带野花风飐。\n拗归供作镜台秋，有人细与评浓淡。\n纸窗入夜银灯闪。\n写影明于染。\n借成幽赏，拼坐深更，村酒香而酽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43373,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南柯子十三首 其一","author":"王时翔","text":"雁宿芦丛冷，鱼牵荇带长。\n西风送我过横塘。\n六幅银帆飞破、石湖光。\n山脚轻烟碧，波心夕照黄。\n行春桥上画衣香。\n独树桃花八月、断人肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43374,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南柯子十三首 其二","author":"王时翔","text":"叠巘云光接，浓阴树色连。\n木兰艇子绿波湾。\n风影轻翻红袖、拂低阑。\n照水愁蛾敛，看山笑靥圆。\n沉吟半刻亸香肩。\n应有春游诗句、写吴笺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43375,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]