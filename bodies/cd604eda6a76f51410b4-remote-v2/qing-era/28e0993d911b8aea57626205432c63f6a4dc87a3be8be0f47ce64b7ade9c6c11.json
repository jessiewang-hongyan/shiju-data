[{"title":"己亥杂诗 其一○○","author":"龚自珍","text":"坐我三熏三沐之，悬崖撒手别卿时。\n不留后约将人误，笑指河阳镜里丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1908,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一○一","author":"龚自珍","text":"美人才调信纵横，我亦当筳拜盛名。\n一笑劝君输一著，非将此骨媚公卿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1909,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一○三","author":"龚自珍","text":"梨园爨本募谁修，亦是风花一代愁。\n我替尊前深惋惜，文人珠玉女儿喉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1910,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一○四","author":"龚自珍","text":"河汾房杜有人疑，名位千秋处士卑。\n一事平生无齮龁，但开风气不为师。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1911,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一○五","author":"龚自珍","text":"生还重喜酹金焦，江上骚魂亦可招。\n隔岸故人如未死，清樽读曲是明朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1912,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一○六","author":"龚自珍","text":"西来白浪打旌旗，万舶安危总未知。\n寄语瞿塘江上贾，收帆好趁顺风时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1913,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一○七","author":"龚自珍","text":"少年揽辔澄清意，倦矣应怜缩手时。\n今日不挥闲涕泪，渡江只怨别蛾眉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1914,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一○八","author":"龚自珍","text":"六月十五别甘泉，是夕丹徒风打船。\n风定月出半江白，江上女郎眠未眠？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1915,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一○九","author":"龚自珍","text":"四海流传百轴刊，皤皤国老尚神完。\n谈经忘却三公贵，只作先秦伏胜看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1916,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一一○","author":"龚自珍","text":"蜀冈一老抱哀弦，阅尽词场意惘然。\n绝似琵琶天宝后，江南重遇李龟年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1917,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一一一","author":"龚自珍","text":"家公旧治我曾游，只晓梅村与凤洲。\n收拾遗文浩无涘，东南一部小阳秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1918,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一一二","author":"龚自珍","text":"七里虹桥腐草腥，歌钟词赋两飘零。\n不随天市为消长，文字光芒聚德星。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1919,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一一四","author":"龚自珍","text":"诗人瓶水与谟觞，郁怒清深两擅场。\n如此高才胜高第，头衔追赠薄三唐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1920,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一一五","author":"龚自珍","text":"荷衣说艺斗心兵，前辈须眉照座清。\n收拾遗闻归一派，百年终恃小门生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1921,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一一六","author":"龚自珍","text":"中年才子耽丝竹，俭岁高人厌薜萝。\n两种情怀皆可谅，阳秋贬笔未宜多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1922,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一一八","author":"龚自珍","text":"麟趾袅蹄式可寻，何须番舶献其琛？\n汉家平淮书难续，且仿齐梁铸饼金。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1923,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一一九","author":"龚自珍","text":"作赋曾闻纸贵夸，谁令此纸遍京华？\n不行官钞行私钞，名目何人饷史家？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1924,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一二一","author":"龚自珍","text":"荒青无缝种交加，月费牛溲定几车？\n只是场师消遣法，不求秋实不看花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1925,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一二二","author":"龚自珍","text":"六朝古黛梦中衡，无福秦淮放棹行。\n想见钟山两才子，词锋落月互纵横。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1926,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一二四","author":"龚自珍","text":"残客津梁握手欷，多君郑重问乌衣。\n故家自怨风流歇，肯骂无情燕子飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1927,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一二六","author":"龚自珍","text":"不容儿辈妄谈兵，镇物何妨一矫情。\n别有狂言谢时望，东山妓即是苍生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1928,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一二七","author":"龚自珍","text":"汉代神仙玉作堂，六朝文苑李男香。\n过江子弟倾风采，放学归来祀卫郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1929,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一二九","author":"龚自珍","text":"陶潜诗喜说荆轲，想见停云发浩歌。\n吟到恩雠心事涌，江湖侠骨恐无多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1930,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一三一","author":"龚自珍","text":"陶潜磊落性情温，冥报因他一饭恩。\n颇觉少陵诗吻薄，但言朝叩富儿门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1931,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一三二","author":"龚自珍","text":"将左晨星一炬存，鱼龙光怪百千吞。\n迢迢望气中原夜，又有湛卢剑倚门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1932,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一三三","author":"龚自珍","text":"过江籍甚颜光禄，又作山中老树看。\n赖是元龙楼百尺，雄谈夜半斗牛寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1933,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一三五","author":"龚自珍","text":"偶赋凌云偶倦飞，偶然闲慕遂初衣。\n偶逢锦瑟家人问，便说寻春为汝归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1934,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一三六","author":"龚自珍","text":"万卷书生飒爽来，梦中喜极故人回。\n湖山旷劫三吴地，何日重生此霸才？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1935,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一三八","author":"龚自珍","text":"今日闲愁为洞庭，茶花凝想吐芳馨。\n山人生死无消息，梦断查湾一角青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1936,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一三九","author":"龚自珍","text":"玉立长身宋广文，常州重到忽思君。\n遥怜屈贾英灵地，朴学奇才张一军。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1937,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一四○","author":"龚自珍","text":"太湖七十溇为墟，三泖圆斜各有初。\n耻与蛟龙竟升斗，一编聊献郏侨书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1938,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一四二","author":"龚自珍","text":"少年哀艳杂雄奇，暮气颓唐不自知。\n哭过支硎山下路，重钞梅冶一奁诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1939,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一四三","author":"龚自珍","text":"温良阿者泪涟涟，能说吾家六十年。\n见面恍疑悲母在，报恩祝乳后昆贤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1940,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一四四","author":"龚自珍","text":"天教梼杌降家门，骨肉荆榛不可论。\n赖是本支调护力，若敖不馁怙深恩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1941,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一四五","author":"龚自珍","text":"径山一疏吼寰中，野烧苍凉悼达公。\n何处复求龙象力，金光明照浙西东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1942,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一四七","author":"龚自珍","text":"道场馣馤雨花天，长水宗风在目前。\n一任拣机参活句，莫将文字换狂禅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1943,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一四八","author":"龚自珍","text":"一脉灵长四叶貂，谈经门祚郁岧峣。\n儒林几见传苗裔？\n此伏高邮冠本朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1944,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一五○","author":"龚自珍","text":"里门风俗尚敦庞，年少争为齿德降。\n桑梓温恭名教始，天涯何处不家江？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1945,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一五一","author":"龚自珍","text":"小别湖山劫外天，生还如證第三禅。\n台宗晤后无来去，人道苍茫十四年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1946,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一五三","author":"龚自珍","text":"亲朋岁月个萧闲，情话缠绵礼数删。\n喜尽东华尘土否？\n一秋十日九湖山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1947,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一五四","author":"龚自珍","text":"高秋那得吴虹生，成轺西子湖边行。\n一丘一壑我前导，重话东华送我情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1948,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一五六","author":"龚自珍","text":"家住钱塘四百春，匪将门阀傲江滨。\n一州典故闲徵遍，撰杖观涛得几人？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1949,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一五七","author":"龚自珍","text":"问我清游何日最，木樨风外等秋潮。\n忽有故人心上过，乃是虹生与子潇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1950,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一五八","author":"龚自珍","text":"灵鹫高华夜吐云，山凹指点旧家坟。\n千秋名教吾谁愧？\n愧读羲之誓墓文。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1951,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一五九","author":"龚自珍","text":"乡国论文集古欢，幽人三五薜萝看。\n从知阆苑桃花色，不及溪松耐岁寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1952,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一六○","author":"龚自珍","text":"眼前石屋著书象，三世十方齐现身。\n各搦著书一枝笔，各有洞天石屋春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1953,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一六二","author":"龚自珍","text":"振绮堂中万轴书，乾嘉九野有谁如？\n季方玉粹元方死，握手城东问蠹鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1954,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一六三","author":"龚自珍","text":"与吾同祖砚北者，仁愿如兄壮岁亡。\n从此与谁谈古处？\n马婆巷外立斜阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1955,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一六四","author":"龚自珍","text":"醰醰诸老惬瞻衣，父齿随行亦未稀。\n各有清名闻海内，春来各自典朝衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1956,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一六六","author":"龚自珍","text":"震旦狂禅沸不支，一灯慧命续如丝。\n灵山未歇宗风歇，已过庞家日眚时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1957,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一七三","author":"龚自珍","text":"碧涧重来荐一毛，杉楠喜比往时高。\n故人地下仍相护，驱逐狐狸赖尔曹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1958,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一七四","author":"龚自珍","text":"志乘英灵琐屑求，岂其落笔定阳秋？\n百年子姓殷勤意，忍说挑灯为应酬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1959,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一七六","author":"龚自珍","text":"俎脍飞沉竹肉喧，侍郎十日敞清尊。\n东南不可无斯乐，濡笔亲题第四园。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1960,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一七八","author":"龚自珍","text":"儿谈梵夹婢谈兵，消息都防老父惊。\n赖是摇鞭吟好句，流传乡里只诗名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1961,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一七九","author":"龚自珍","text":"吴郎与我不相识，我识吴郎拂画看。\n此外若容添一语，含元殿里觅长安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1962,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一八○","author":"龚自珍","text":"科名掌故百年知，海岛畴人奉大师。\n如此奇才终一令，蠹鱼零落我归时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1963,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一八二","author":"龚自珍","text":"秋风张翰计蹉跎，红豆年年掷逝波。\n误我归期知几许？\n蟾圆十一度无多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1964,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一八三","author":"龚自珍","text":"拊心消息过江淮，红泪淋浪避客揩。\n千古知言汉武帝，人难再得始为佳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1965,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一八四","author":"龚自珍","text":"小楼青对凤凰山，山影低徊黛影间。\n今日当窗一奁镜，空王来證鬓丝班。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1966,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一八五","author":"龚自珍","text":"娇小温柔播六亲，兰姨琼姊各沾巾。\n九泉肯受狂生誉？\n艺是针神貌洛神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1967,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一八六","author":"龚自珍","text":"阿娘重见话遗徽，病骨前秋盼我归。\n欲寄无因今补赠，汗巾钞袋枕头衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1968,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一八七","author":"龚自珍","text":"云英未嫁损华年，心绪曾凭阿母传。\n偿得三生幽怨否？\n许侬亲对玉棺眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1969,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一八八","author":"龚自珍","text":"杭州风俗闹兰盆，绿蜡金炉梵唱繁。\n我说天台三字偈，胜娘膜拜礼沙门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1970,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一八九","author":"龚自珍","text":"残绒堆积绣窗间，慧婢商量赠指环。\n但乞崔徽遗像去，重摹一帧供秋山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1971,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一九○","author":"龚自珍","text":"昔年诗卷驻精魂，强续狂游拭涕痕。\n拉得藕花衫子婢，篮舆仍出涌金门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1972,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一九二","author":"龚自珍","text":"花神祠与水仙祠，欲订源流愧未知。\n但向西泠添石刻，骈文撰出女郎碑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1973,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一九九","author":"龚自珍","text":"野冬修竹欲连天，苦费西邻买笋钱。\n此是商鞅垦土令，不同凿空误开边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1974,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二○○","author":"龚自珍","text":"灵箫合贮此灵山，意思精微窈窕间。\n区壑无双人地称，我无拙笔到眉弯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1975,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二○二","author":"龚自珍","text":"料理空山颇费才，文心兼似画家来。\n矮茶密致高松独，记取先生亲手栽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1976,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二○四","author":"龚自珍","text":"可惜天南无此花，腰身略似海塘斜。\n难忘槐市街南宅，小疏群芳稿一车。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1977,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二○五","author":"龚自珍","text":"可惜天南无此花，丽情还比牡丹奢。\n难忘西掖归来早，赠与妆台满镜霞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1978,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二○六","author":"龚自珍","text":"不是南天无此花，北肥南瘦二分差。\n愿移北地胭脂社，来问南朝油壁车。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1979,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二○七","author":"龚自珍","text":"弱冠寻方数岁华，玲珑万玉嫭交加。\n难忘细雨红泥寺，湿透春裘倚此花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1980,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二○八","author":"龚自珍","text":"女墙百雉乱红酣，遗爱真同召伯甘。\n记得花阴文宴屡，十年春梦寺门南。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1981,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二○九","author":"龚自珍","text":"空山徙倚倦游身，梦见城西阆苑春。\n一骑传笺朱邸晚，临风递与缟衣人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1982,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二一○","author":"龚自珍","text":"缱绻依人慧有馀，长安俊物最推渠。\n故侯门第歌钟歇，犹办晨餐二寸鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1983,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二一四","author":"龚自珍","text":"男儿解读韩愈诗，女儿好读姜夔词。\n一家倘许圆鸥梦，昼课男儿夜女儿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1984,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二一五","author":"龚自珍","text":"倘容我老半锄边，不要公卿寄奉钱。\n一事避君君匿笑，刘郎才气亦求田。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1985,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]