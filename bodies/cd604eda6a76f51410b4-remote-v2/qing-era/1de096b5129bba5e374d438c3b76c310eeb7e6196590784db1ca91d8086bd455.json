[{"title":"次韵和友人除夕自寿","author":"丘逢甲","text":"笑数雌雄几甲辰，梅花预报来年春。\n祭诗岛佛才如故，守岁坡仙语更新。\n自把屠苏开寿宴，兼持吟稿馈交亲。\n东风更送明朝喜，戴胜何妨属老人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32654,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过三河，吊翁襄敏墓","author":"丘逢甲","text":"落日青山虎气沉，河流还啮故城阴。\n地埋一代名臣骨，天鉴三边守将心。\n人物岭东前史在，关山直北战尘深。\n英灵异代应相感，一片寒云绕墓林。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32655,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画 其一","author":"丘逢甲","text":"玉带犹留此结缘，金山楼殿耸云烟。\n何当自碾龙团饼，来试江心第一泉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32656,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画 其二","author":"丘逢甲","text":"何处瓜牛旧结庐，六时宫殿震钟鱼。\n大江东去月西上，自闭山门读道书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32657,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画 其三","author":"丘逢甲","text":"金山看罢看银山，宫殿崔巍紫翠间。\n领略江南好风景，散花人去老僧閒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32658,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画 其四","author":"丘逢甲","text":"虎踞龙蹯迹未消，尚留古刹话前朝。\n老僧不省英雄恨，夜夜寒江咽暮潮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32659,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题菊花诗卷 其一","author":"丘逢甲","text":"北痛逆胡南篡贼，渊明心事菊花知。\n看花不尽千秋感，残照西风又一时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32660,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题菊花诗卷 其二","author":"丘逢甲","text":"谁吟金甲战秋风，黄败朱成事不同。\n傥有閒情来吊古，合编花史记英雄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32661,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题菊花诗卷 其三","author":"丘逢甲","text":"宁向枝头死抱香，不曾吹坠北风凉。\n如何海上新花样，化作东夷大宝章。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32662,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题菊花诗卷 其四","author":"丘逢甲","text":"也知晚节留香好，独惜军中少一韩。\n任是黄花比人瘦，西风还拟卷帘看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32663,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题菊花诗卷 其五","author":"丘逢甲","text":"百尺澄台对落晖，旧吟花处地都非。\n重寻十七年前梦，飘尽黄金泪满衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32664,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠谢生","author":"丘逢甲","text":"人言谢生颠，吾未敢从众。\n与言世界事，谈言动微中。\n即令能颠亦复奇，终胜老生了无用。\n神州大陆殊可哀，纷纷老朽无人才。\n眼中突兀少年在，令我郁郁心颜开。\n即今时事须放手，安得人尽颠如雷。\n谢生言论自由耳，已令世人骇欲死。\n丈夫何止用口舌，治世界事从今始。\n时哉时哉不可失，东南风吹大海水。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32665,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题兰史香海填词图 其一","author":"丘逢甲","text":"南宋国衰词自盛，各抛心力斗清新。\n零丁洋畔行吟地，又见江山坐付人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32666,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题兰史香海填词图 其二","author":"丘逢甲","text":"此是本朝初割地，年来见惯已相忘。\n重吟整顿乾坤句，谁更雄心似鄂王？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32667,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题黄生印谱 其一","author":"丘逢甲","text":"铭雀砚斋新印谱，七年前见景韩楼。\n萧萧风雨鮀江上，夜半题诗四壁秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32668,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题黄生印谱 其二","author":"丘逢甲","text":"五洲莽莽起风云，待扫亡秦旧篆文。\n留与他年添印谱，九头狮纽大将军。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32669,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题刘铭伯制科策后二首 其一","author":"丘逢甲","text":"米雨欧风捲地来，有人策马上金台。\n空弹贾谊忧时泪，共惜刘蕡下第才。\n书剑南归沧海阔，河山北望战云颓。\n太平策在终须用，且抱乡心付岭梅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32670,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题刘铭伯制科策后二首 其二","author":"丘逢甲","text":"早闻声价重龙门，一疏轰传叩九阍。\n吾辈当为天下计，此才岂藉特科尊！\n愁边在陆龙蛇起，梦里当关虎豹蹲。\n诵罢高文鸡喔喔，何时对舞共刘琨！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32671,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"君山","author":"丘逢甲","text":"君山自是众山君，卓立中峰上插云。\n曾上君山最高顶，东南一气荡氤氲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32672,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"百字令 次廖伯鲁韵","author":"丘逢甲","text":"峤南人物，问当今谁是曲江风度？\n万劫不磨雄直气，空剩屈陈词赋。\n秦戍哀云、越台吊月，愁听秋虫诉。\n南宗未坠，菩提何碍无树？\n历历弹指光阴，论橙品荔，乡味将人误。\n潦倒英雄成末路，饱领凉情热趣。\n倒海浇天、剖云行日，梦里留奇句。\n功名尘土，浩歌还谱朱鹭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32673,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"满江红 越王台，次伯鲁韵","author":"丘逢甲","text":"逐鹿中原，问何故闭关自域？\n思旧事，登高吊古，五羊城北。\n椎结雄称南武帝，抱孙左纛朝仪赫。\n笑此台高瞰百蛮天，何因设？\n甘心受，新王职；弹指顷，千年隔。\n访霸图一片，夕阳无极。\n残缺不完南越国，老夫心事何人识？\n祗江山雄绕古台基，今犹昔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32674,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题马生美人宝剑图","author":"丘逢甲","text":"万方仪态天风生，素女始教轩皇兵。\n长兵戈矛短兵剑，剑花夜发芙蓉燄。\n越王铸剑光满池，天遣素女为之师。\n亡吴霸越赖有此，世人但道有西子。\n南风烈烈扬胡尘，雌雄剑化延平津。\n可怜歌舞太平日，卧薪尝胆今无人。\n我来吊古越台下，眼中突兀扶风马。\n苦将古事作今图，宝剑非真美人假。\n下穷九地上九天，转劫将逢龙汉年。\n且寻南岳夫人去，唤起千秋女剑仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32675,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与高啸桐同客广州","author":"丘逢甲","text":"平生我愧杜工部，喜见高三十五才。\n四海风尘双鬓白，斜阳同上越王台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32676,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠秦人毛生","author":"丘逢甲","text":"直从南北两戒首，走遍胡门到越门。\n一发青山残照里，尉陀台上望中原。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32677,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"对月，同王户部","author":"丘逢甲","text":"一片长安月，随人万里寒。\n独怜沧海客，同向越台看。\n肝胆光能照，河山影未残。\n浮云自西北，惆怅倚阑干。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32678,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"龙门之桐行，赠刘铭伯","author":"丘逢甲","text":"龙门之桐斲为琴，冰丝玉徽音古音。\n琴师携奏九天上，繁弦急管声为瘖。\n百神觞帝宜有此，不信天乐翻崇今。\n五尺之囊裁古锦，韬以南下江湖深。\n明堂清庙非不用，且用邦国坊民淫。\n鸱鸮在泮鹙在林，凤皇不来愁人心。\n谁扶孤阳抑群阴，嗟哉琴德何愔愔！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32679,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送朱古薇学使乞病旋里二首 其一","author":"丘逢甲","text":"三年持节远朝班，要乞君恩更赐閒。\n人既读书同博塞，天将盛业付名山。\n右军誓墓心谁白？\n永叔归田鬓未斑。\n惆怅閒鸥沧海上，也随桃李惜春还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32680,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送朱古薇学使乞病旋里二首 其二","author":"丘逢甲","text":"参苓药笼富收藏，只有当归切病方。\n卿贰中朝虚位望，科名末造贱文章。\n千金行橐馀仙茧，五月徵轺照佛桑。\n至竟汉廷思汲黯，未容移疾老江乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32681,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉歌示徐生","author":"丘逢甲","text":"天下汹汹党人死，神师一呼群盗起。\n此时理乱都不闻，心醉君家老孺子。\n欲为孺子吾不能，短衣匹马呼秋鹰。\n袖中一卷英雄传，落日来登汉帝陵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32682,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"放歌与陈伯贞","author":"丘逢甲","text":"南飞乌鹊栖无枝，老骥伏枥悲鸣时。\n明明如月不可掇，江头横槊来赋诗。\n大江东去流战血，明月依然作古色。\n可怜暮年烈士心，夜半高歌唾壶缺。\n文王周公安在哉！\n古人已去今人来。\n三分未定天下局，一将正少当时才。\n我爱陈琳工草檄，居然解愈头风疾。\n世间力足生杀人，武士之刀文士笔。\n且须饮酒休谈兵，英雄儿女同多情。\n二乔已向吴宫老，铜雀年年空月明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32683,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送长乐学生入陆军学校二首 其一","author":"丘逢甲","text":"蛮夷大长作尉地，犹有当时武士风。\n今日推翻古人局，要看时势造英雄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32684,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送长乐学生入陆军学校二首 其二","author":"丘逢甲","text":"若从中国论古学，文武由来本不分。\n终使西人遘黄祸，吁天早出学生军。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32685,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"越台书感","author":"丘逢甲","text":"漠漠南云倦眼开，十年三度此登台。\n地随落日天边尽，人共秋潮海上来。\n木石尚留仙佛气，江山不称霸王才。\n倚阑欲遣茫茫感，更向何人借酒杯！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32686,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南园","author":"丘逢甲","text":"玉带河边万柳丝，跨河楼阁郁参差。\n重来祗恐风光异，再为南园住少时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32687,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄刘铭伯","author":"丘逢甲","text":"昨梦君从海上归，十峰轩畔解征衣。\n觉来江浦潮初上，夜半开门月满扉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32688,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题王寿山先生人心尽如此图","author":"丘逢甲","text":"人心不和平，天下乱未已。\n谁言治天下，不自人心始。\n图中之人盖知此，偶出鸣琴作宰官。\n作诗作画皆琴理，诗臻清品画逸品。\n琴韵泠泠满山水，山虚水深吏归矣。\n我居君山西，君居君山东；相去百里近，相隔百年中。\n百年未满万事变，人心非复君时同。\n此时张弦论天下，自非更改难为功。\n奈何古乐付俗手，一任繁急乖商宫。\n题君此图心忡忡，安得瑶琴一曲鸣熏风？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32689,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠伯澜","author":"丘逢甲","text":"乘兴曾游大海东，樱花开处唱秦风。\n归来小试经纶手，一卷周官补考工。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32690,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"珠江夜送啸桐之梧州 其一","author":"丘逢甲","text":"年年代作嫁衣裳，涂抹今为新妇妆。\n莫道女儿羞未学，教儿忙比养儿忙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32691,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"珠江夜送啸桐之梧州 其二","author":"丘逢甲","text":"送人作郡鬼揶揄，同是当时旧酒徒。\n能唱尊前渭城曲，故应心计未全粗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32692,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"珠江夜送啸桐之梧州 其三","author":"丘逢甲","text":"江山风月好亭台，觞咏应须老守才。\n一语叮咛君记取，莫因官贵少书来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32693,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"珠江夜送啸桐之梧州 其四","author":"丘逢甲","text":"后夜相思益渺然，苍梧遥隔夕阳边。\n他年傥忆今宵会，此是当时载鹤船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32694,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄张坚白桂林","author":"丘逢甲","text":"一别一年久，相思日几回。\n桂林多胜境，藩伯况雄才！\n未敢论时局，惟应借酒杯。\n寄书无别语，千里索诗来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32695,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长句与晴皋索普洱茶","author":"丘逢甲","text":"滇南古佛国，草木有佛气。\n就中普洱茶，森冷可爱畏。\n迩来入世多尘心，瘦权病可空苦吟。\n乞君分惠茶数饼，活火煎之檐卜林。\n饮之纵未作诗佛，定应一洗世俗筝琶音。\n不然不立文字亦一乐，千秋自抚无弦琴。\n海山自高海水深，与君弹指一话去来今。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32696,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"陈伯潜学士以路事来粤，相晤感赋二首 其一","author":"丘逢甲","text":"三十年来万事非，天涯沦落识公迟。\n横流沧海无安处，故国青山有梦思。\n铸铁屡闻成错字，造车此是出门时。\n他乡同纵登高目，斜日黄龙上大旗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32697,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"陈伯潜学士以路事来粤，相晤感赋二首 其二","author":"丘逢甲","text":"台岭岧峣海气昏，贞元朝士几人存！\n秋江漠漠鱼龙夜，上界沉沉虎豹尊。\n分野直疑连鬼宿，买山何处觅公墩。\n乾坤整顿关吾辈，先遣南车走越门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32698,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"沈爱苍于皋署新作小亭","author":"丘逢甲","text":"涛园佳话吾能说，还合题名作沈亭。\n海上月华连夜白，天涯草色为谁青？\n偶收弃地成奇境，尽借群山作画屏。\n他日五羊图故事，也应添写少微星。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32699,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵南园小山遇雨","author":"丘逢甲","text":"横看成岭侧成峰，怪石参差地足容。\n正喜园林饶气象，忽惊雷雨起蛟龙。\n半池新水花初落，旧壁残题藓未封。\n归去更欣逢夕霁，东南回首海云浓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32700,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梦中","author":"丘逢甲","text":"绣旗犹飐落花风，不信楼台是梦中。\n十二阑干摇海绿，八千子弟化春红。\n奔驰日月无停轨，组织河山未就功。\n车下懒龙呼不起，钧天罢奏太匆匆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32701,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南园对月","author":"丘逢甲","text":"南园一片娟娟月，曾照诗人更美人。\n穷海未应人物尽，中天还见月华新。\n百年耆旧谁高咏？\n万劫光明此法轮。\n应有珊珊环佩影，夜归来吊柳梢春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32702,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题沧海遗民台阳诗话","author":"丘逢甲","text":"如此江山竟付人，干戈留得苦吟身。\n乱云残岛开诗境，落日荒原泣鬼燐。\n埋碧可怜黄帝裔，杀青谁作素王臣？\n请将风雅传忠义，斑管重回故国春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32703,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送夏同甫还浙，兼讯汤蛰仙","author":"丘逢甲","text":"玉带河边折柳条，送君归看浙江潮。\n九秋雕鹗诗心健，万变鱼龙海气骄。\n吾辈尚谋文字乐，何人解向国魂招？\n归舟倘见山阴客，为道雄心郁未消。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32704,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄和崔兰西七夕感怀","author":"丘逢甲","text":"玉合金针故事遥，离人自写可怜宵。\n沉沉旧院收鱼钥，隐隐星河梦鹊桥。\n天上双星窥分野，人间万感溢思潮。\n柳州屡乞仍难巧，聊报瑶章作解嘲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32705,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宿西校书堂","author":"丘逢甲","text":"迢迢银汉自横天，隐几西堂客未眠。\n潮信入城知夜半，橹声摇月过帘前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32706,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题王寿山先生钓月图","author":"丘逢甲","text":"得水月光活，能诗画意深。\n直将垂钓意，自證妙明心。\n残魄支天地，扁舟阅古今。\n秋江妙无际，何处访拿音？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32707,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"中秋白云山能仁寺看月有怀覃孝方、周立之二首 其一","author":"丘逢甲","text":"袖君诗入白云去，吟向白云山上头。\n潭底睡龙惊起听，万峰明月一轮秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32708,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"中秋白云山能仁寺看月有怀覃孝方、周立之二首 其二","author":"丘逢甲","text":"苦口人间度有情，一微尘里万魔生。\n于今铲却机锋语，宴坐空山看月明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32709,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题平远凌生自作壮游图 其一","author":"丘逢甲","text":"自从蒸气走车舟，万里都成庭户游。\n安得壮行兼绝技，遍将名胜写全球。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32710,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题平远凌生自作壮游图 其二","author":"丘逢甲","text":"未能游屐遍人寰，归隐何妨且闭关。\n奇绝南台五指石，不妨图写好家山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32711,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"法政学堂宴日本法学博士梅谦次郎，同行结城琢，即席有诗，因次其韵","author":"丘逢甲","text":"沉沉大陆宝华饶，南岭秋迎国士轺。\n海上钓鳌三岛近，人间相马九方遥。\n烟云过眼资探讨，珠玉挥毫破寂寥。\n自笑捉刀閒处立，西风长啸越江朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32712,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送王铁珊 其一","author":"丘逢甲","text":"定交倾盖立谈时，此意难教世俗知。\n同抱奈何天地感，五年前已远相思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32713,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送王铁珊 其二","author":"丘逢甲","text":"秋风落日五羊城，一舸西南客送行。\n别后苍梧劳远梦，青山万叠暮云横。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32714,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题潘鸿轩百花卷","author":"丘逢甲","text":"即教论画亦名家，墨气蒸成五色霞。\n展卷如逢仙世界，令人长见四时花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32715,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵答友人","author":"丘逢甲","text":"横槊当歌万虑空，复闻吐哺有周公。\n挥金径欲求奇士，好色何曾讳国风？\n百万逢场仍纵博，十千沽酒更新丰。\n平生整顿乾坤手，要见神州日再中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32716,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重阳日傍晚登粤秀山","author":"丘逢甲","text":"萧瑟秋心付五羊，尉佗台上作重阳。\n西风吹帽林容老，落日平栏海气凉。\n城郭晚来烟雾合，江山前代战争忙。\n野僧不解登高意，自杵寒钟礼梵王。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32717,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵答周立之","author":"丘逢甲","text":"地老天荒不爱才，呱呱哭后已留哀。\n千年狗曲亡生气，一夜龙雷起死灰。\n乱世诗书儒发冢，中原旗鼓将登台。\n茫茫四海无安处，且醉新亭浊酒杯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32718,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送岑云阶移督滇黔 其一","author":"丘逢甲","text":"诏领兼圻即故乡，一时家国并荣光。\n古来百粤文身地，再见千秋昼锦堂。\n郭令门庭多节钺，晋公勋业有文章。\n谁知中外声华满，裘带雍容四十强。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32719,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]