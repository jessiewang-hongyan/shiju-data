[{"title":"苏幕遮 重阳","author":"许淑慧","text":"画屏空，香阁静。\n菊酒盈樽，愁怯新来病。\n一霎西风吹又暝。\n细雨星星，做出重阳景。\n竹梢声，桐叶影。\n淡月穿云，云破秋空冷。\n寂寞阑干还独凭。\n无限销魂，却把花钿整。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22130,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"昭君怨","author":"许淑慧","text":"日暮天寒翠袖。\n秋思年年依旧。\n桐叶舞西风。\n乱烟中。\n十二阑干凭遍。\n底事离怀难遣。\n愁绪上眉峰。\n忆无穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22131,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一剪梅 送别江蕊珊妹","author":"许淑慧","text":"细雨寒林洒驿尘。\n秋思纷纷。\n离思纷纷。\n送君归去更谁亲。\n行也销魂。\n坐也销魂。\n回首鸡窗笑语频。\n昨日黄昏。\n今日黄昏。\n阑干月影写愁痕。\n隔断重云。\n望断重云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22132,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一剪梅 忆叶竹君姊","author":"许淑慧","text":"淡月玲珑映竹林。\n欲共幽寻。\n谁共幽寻。\n曲阑干外薄寒侵。\n虫也闲吟。\n人也闲吟。\n芳景当前恨转深。\n不是秋心。\n却是秋心。\n焚香独自理瑶琴。\n待觅知音。\n难觅知音。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22133,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令 画竹","author":"许淑慧","text":"石罅新篁半吐。\n帘底绿云微度。\n昨夜小窗纱，添得嫩凉如许。\n听取。\n听取。\n可似潇湘夜雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22134,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卜算子 画菊","author":"许淑慧","text":"松下短篱边，开谢都无主。\n画出凌霜一点心，不怕风和雨。\n著意染生绡，秋影深深处。\n试问罗含宅里花，还似当年否。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22135,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令 题慈鬘夫人梅花山茶画轴","author":"许淑慧","text":"昨夜江乡梦醒。\n纸帐一枝香冷。\n更有曼陀罗，低伴绮窗春影。\n闲省。\n闲省。\n人日画堂烟景。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22136,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令","author":"许淑慧","text":"闻道南园春昼。\n凤子飞来还又。\n孤梦绕天涯，谁念绿阴消瘦。\n依旧。\n依旧。\n肠断落花时候。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22137,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 寄竹君姊","author":"许淑慧","text":"江北蓼花秋。\n天自悠悠。\n一生离恨几时休。\n听到夜深更漏转，点点生愁。\n云影向东流。\n月上邗篝。\n何时同泛菊花舟。\n说尽相思千万语，才下心头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22138,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 题照","author":"许淑慧","text":"衰柳江南感旧游。\n谢家池馆正新秋。\n不堪回首向西州。\n往日风光犹自好，少年心事未全休。\n绿阴如水恨悠悠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22139,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐 咏西瓜","author":"许淑慧","text":"绿橘圆洁。\n秋水红冰结。\n饱食且须除内热。\n莫问幽风几月。\n当年玉碗金刀。\n分甘曾趁良宵。\n又是秋期近也，不堪归路迢迢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22140,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 残菊","author":"许淑慧","text":"冷香独抱烟痕湿。\n落英满地空陈迹。\n帘卷正西风。\n小窗秋露浓。\n怜它消瘦影。\n也似深闺病。\n晚节耐霜寒。\n无言空倚栏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22141,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卜算子 画山水","author":"许淑慧","text":"落日晚山秋，枫叶稍稍响。\n行过溪桥不见人，白鸟冲烟上。\n凉翠扑轻衫，独自闲来往。\n听到疏钟薄暮时，寂寞生遐想。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22142,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"疏影 咏菊影","author":"许淑慧","text":"繁花似雪。\n正晚风悄悄，吹上檐铁。\n开遍东篱，斜月初明，枝枝瘦影幽绝。\n流云千点琼英碎，看细叶、和花一抹。\n任教它、玉女春葱，镜里总难攀折。\n怊怅星河欲曙，露寒翠袖薄，幽恨空切。\n短笛凄凉，不管生愁，旧恨又还重叠。\n依依莫把银墙度，怕转眼、韶光催别。\n待夜来、携酒花间，重醉昔年风月。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22143,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇","author":"许淑慧","text":"独卷湘帘，垂杨绿遍天涯道。\n杜鹃声悄，耳畔添烦恼。\n闲处愁多，静处知多少。\n春将老。\n落花休扫。\n犹有芳情绕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22144,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 壬辰闰月九日，复同师氏二妹登禹王台看菊","author":"许淑慧","text":"层台高耸清宵碧。\n冷云低护花光湿。\n携手共徘徊。\n寻秋两度来。\n秋深深几许。\n木叶霏如雨。\n佳节又重阳。\n风生落帽狂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22145,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"风蝶令 郑萍香大姊以词见寄，即和原调奉酬","author":"许淑慧","text":"虫语苍苔冷，斜阳雨过天。\n秋光到此最堪怜。\n正叹无聊喜奉、小蛮笺。\n多感缠绵思，含情寄短篇。\n又添愁绪到吟边。\n却是海棠零落、满阶前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22146,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 题画","author":"钱孟钿","text":"秋色落柴关。\n心与云还。\n断桥流水碧潺潺。\n回望千峰峦翠合，策杖溪湾。\n地僻鸟声闲。\n白石横滩。\n林泉容与看飞鹇。\n何事镜湖赊月色，为浣风颜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22147,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"百字令 早春即事，寄怀弟妇循之","author":"钱孟钿","text":"薄寒料峭，正梅花索笑，离怀如织。\n一夜打窗风雨恶，不忿乳燕饶舌。\n青锁眉峰，春归芳草，辜负西园蝶。\n阑干十二，晓来还挂新月。\n遥想京国繁华，艳阳风景，望里云千叠。\n可耐相思牵远梦，又被绿杨低曳。\n旧事嬉游，它时吟赏，胜地俱陈迹。\n探巢旅燕，呢喃似向人说。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22148,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"淡黄柳","author":"钱孟钿","text":"晴光艳漪。\n吹上修眉碧。\n亸倚东风困无力。\n三叠阳关唱遍。\n休折尽河桥春色。\n正岑寂。\n絮花飘似雪。\n问前度、章台陌。\n但麦尘、暖飏游丝拂。\n金缕抛残，鹅黄微褪，别是闲消息。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22149,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杨柳枝 送计从母","author":"钱孟钿","text":"为倩疏枝系落晖。\n黯愁眉。\n津亭攀折思依依。\n惜衔卮。\n回首白云千万叠。\n魂欲绝。\n含情江水碧参差。\n两心知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22150,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"眉峰碧 送计表妹","author":"钱孟钿","text":"何事归帆急，蹙损眉峰碧。\n执手相看意欲迷，争忍向、河桥折。\n暮柳催行色，离思愁如织。\n想见时难别更难，从今好梦分吴越。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22151,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令","author":"钱孟钿","text":"曛。\n几曲屏山掩暮云。\n银河悄，新月暗窥人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22152,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹊桥仙 七夕","author":"钱孟钿","text":"冰蟾初吐，银河如洗，闲却机丝多少。\n金风玉露不多时，生怕是、晓星上早。\n油花试卜，针楼暗度，儿女芳筵竞祷。\n盈盈隔岁一相逢，更那得、工夫赐巧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22153,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"月华清 中秋","author":"钱孟钿","text":"碧海流辉，琼楼倒影，珠帘一片初卷。\n河汉迢遥，冷浸虚皇宫殿。\n遥天迥、云静无声，金镜满、月明谁看。\n闲盼。\n想南楼旧事，风光何限。\n回首天涯梦断。\n正塞雁行归，玉箫声远。\n病怯秋风，霜信早催纨扇。\n问昔日、几曲阑干。\n可还记、倚栏人面。\n缱绻。\n只天边娥月，多情长伴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22154,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"传言玉女 题玉女采芝图","author":"钱孟钿","text":"弄影丹崖，笑把玉芝容与。\n五铢衣薄，倚回风如许。\n蓬山何处，一片彩云旋吐。\n摇溶出水，轻盈曳雾。\n回首瑶宫，记霓裳、曾按谱。\n大罗往事，问吹箫伴侣。\n娥眉萧飒，只有月华常驻。\n情多无奈，珊珊归去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22155,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"两同心 自题纫秋小照","author":"钱孟钿","text":"露满高梧，秋光容与。\n伫阑干、谁逞腰肢，展芭蕉、欲分眉妩。\n谢姮娥，早付天香，婆娑深护。\n别有幽馨盈掬。\n系情湘浦。\n掩映处、几叠屏山，消受得、芳华如许。\n君看取，风叶含丹，月波流素。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22156,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满庭芳 水仙花","author":"钱孟钿","text":"绰约云环，轻云翠带，凌霜见此风流。\n铅华洗尽，春到水晶楼。\n遗我琼珠堪佩，凌波步、拟托仙舟。\n空怅望、江南月夜，含睇翠蛾愁。\n晓风寒素影，沾泥凡卉，对此应羞。\n怕玉钗低堕，清镜波流。\n梦冷瑶台何处，仙踪杳、也只难留。\n潇湘浦，淡烟晴雪，我与尔为俦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22157,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇","author":"钱孟钿","text":"细雨廉纤，晓来燕子衔春去。\n残红飘砌。\n滴尽珍珠泪。\n几曲阑干，蹙损眉峰翠。\n浑无绪。\n天涯凝睇。\n有个人愁倚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22158,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"百字令 题张中翰夫人采芝养鹤遗照","author":"钱孟钿","text":"珊珊何处，向图中犹见，铢衣烟雾。\n十二瑶台清梦好，漫把玉芝容与。\n闲看梳翎，相将弄影，雅称神仙侣。\n软红尘外，东风吹上眉妩。\n不道花落花开，绾春无计，过眼流光度。\n环佩江皋空寄恨，剩有月明如素。\n锦瑟尘埋，瑶编蠹食，化鹤归来误。\n天香偕问，冷烟一片凝伫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22159,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙 其一 凤台仙偶","author":"钱孟钿","text":"云笈早镌双籍，玉箫远度深宫。\n钿蝉零乱倚回风。\n赤霄双跨凤，留梦翠梧中。\n回首钧天何处，三山万里浮空。\n佩环声杳暮云封。\n碧鸡虚作畤，青鸟若为通。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22160,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙 其二 越溪艳色","author":"钱孟钿","text":"一片若耶溪水，春风洗净铅华。\n苧萝西去那人家。\n淡烟笼薄雾，新绿衬啼鸦。\n惆怅苏台麋鹿，凄凉吴苑莺花。\n浪传曾泛五湖槎。\n青台明月夜，冷落旧云霞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22161,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙 其三 紫塞春风","author":"钱孟钿","text":"毳帐凄凉青冢，画图空误朱颜。\n蛾眉自惜镜中弯。\n黄金能作赋，玉佩几时还。\n落日牛羊影下，月明故国家山。\n雁飞难道玉门关。\n拨残浑不似，梦断大刀环。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22162,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙 其四 纨扇秋怀","author":"钱孟钿","text":"长信空中秋草，履綦旧梦初成。\n当时辞辇动声名。\n君恩常似水，眉黛怯逢春。\n别院笙歌按彻，夜凉银汉空横。\n西风箧笥不胜情。\n团圞金殿月，迢递玉阶明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22163,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙 其五 唾壶红玉","author":"钱孟钿","text":"宝辂迎来天上，清风暗送香尘。\n绛纱初试臂痕新。\n双啼红玉箸，轻剪碧云春。\n花压六宫梦晓，芳菲谱入针神。\n嫣然一笑沐君恩。\n敢矜补衮力，聊备卷衣人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22164,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙 其六 金谷香尘","author":"钱孟钿","text":"金谷繁华春满，香迷锦障尘浮。\n珍珠十斛换温柔。\n舞馀红避影，曲罢月如钩。\n一树浓花委地，千秋名为君留。\n季伦原自解风流。\n蛾眉争绝代，红粉几高楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22165,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙 其七 失题","author":"钱孟钿","text":"劝尔回波旨酒，九重春色争开。\n楼头但赏夜珠来。\n衙官驱屈宋，不及内家才。\n玉尺平衡文苑，毫端光散琼瑰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22166,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令","author":"黄琬璚","text":"醒。\n听得檐前溜雨声。\n才惊梦，欲记不能真。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22167,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"闲中好","author":"黄琬璚","text":"闲中好，深夜对银釭。\n琴语松风细，罗衣生嫩凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22168,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南歌子 夜雨二首 其一","author":"黄琬璚","text":"琴润音初涩，香寒篆易消。\n凉夜雨潇潇。\n窗前清可听，没芭蕉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22169,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南歌子 夜雨二首 其二","author":"黄琬璚","text":"小雨穿澄练，轻风蹙浅涟。\n寒似早春天。\n单衫依旧怯，换吴棉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22170,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梦江南","author":"黄琬璚","text":"闲阶悄，更转漏声阑。\n瑞脑香销金鸭冷，阑干倚遍静无言。\n同倚玉阑干。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22171,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"捣练子 落叶二首 其二","author":"黄琬璚","text":"依岸积，逐溪流。\n故枝无计暂相留。\n若比春花还后落，算渠耐久到深秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22172,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"捣练子","author":"黄琬璚","text":"银蜡烬，宝香凝。\n梦转纱窗坐晓晴。\n门掩梨花深院静，流莺时送两三声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22173,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 元日","author":"黄琬璚","text":"天渐晓，帘外听啼鹃。\n红溅梅花楼外雨，碧笼杨柳陌头烟。\n春色又今年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22174,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 咏梳","author":"黄琬璚","text":"修琢巧，犀象并檀槽。\n掠遍香丝珂响细，飏凭纤手月痕高。\n红浸半规潮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22175,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"调笑令","author":"黄琬璚","text":"啼鸟。\n啼鸟。\n催得碧窗侵晓。\n枕边香汗微红。\n噩梦惊来起慵。\n慵起。\n慵起。\n又是暮春天气。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22176,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"甘州子","author":"黄琬璚","text":"乍寒乍暖暮春天。\n梅豆小，麦花妍。\n风梳碧柳一村连。\n远岫抹晴烟。\n残照外、啼鸟和流泉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22177,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令","author":"黄琬璚","text":"一带晴山如沐。\n十里浓花似簇。\n鸡犬静无声，幽绝水通茅屋。\n摇绿。\n摇绿。\n门外数竿修竹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22178,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令","author":"黄琬璚","text":"晓向高楼凝望。\n远树枝枝红酿。\n睡起眼朦胧，道是芙蓉初放。\n霜降。\n霜降。\n那是丹枫江上。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22179,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江城子 秋花","author":"黄琬璚","text":"秋花锦簇画堂空。\n露浓浓。\n影重重。\n阑干九曲、红袖倚人慵。\n轻暖轻寒帘不卷，云淡淡，月濛濛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22180,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"添声杨柳枝","author":"黄琬璚","text":"寂寞闲阶夜悄时。\n漏迟迟。\n传秋一叶井梧知。\n雨如丝。\n残梦阑珊人倚醉。\n钗斜缀。\n香销瑞脑冷金猊。\n画帘垂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22181,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"好事近 长春花","author":"黄琬璚","text":"移傍玉阑栽，几簇花开秋晓。\n雨润胭脂匀染，点枝头红小。\n嫣然锦烂镜中妆，朱颜四时好。\n不断繁英如许，算春光难老。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22182,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙","author":"黄琬璚","text":"节序忽惊心。\n重九将临。\n四时悲乐总由人。\n若使椿萱今健在，佳节堪欣。\n椿树又凋零。\n一载悲生。\n黄花开处最伤神。\n从此莫将佳节唤，唤作萧辰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22183,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"锦堂春","author":"黄琬璚","text":"柳外斜阳门掩，花间曲水桥通。\n小亭西畔疏篱短，步屣尽从容。\n鸭唼浮萍声细，蜂黏落蕊香浓。\n池边小立微凉透，一阵藕丝风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22184,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西江月","author":"黄琬璚","text":"良夜风来小院，遥天月到疏棂。\n相携姊妹且同行。\n踏碎一庭花影。\n细葛衫黏宿汗，轻罗扇扑流萤。\n人间暑气霎时清。\n身在广寒仙境。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22185,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉花阴 茉莉花","author":"黄琬璚","text":"翠袖冰肌摇淡月。\n万蕊艳晴雪。\n沆瀣滴花梢，点入茶瓶，绿乳浇铜叶。\n凉熏暝箔香清绝。\n正倦梳妆发。\n偎枕梦醒时，玉颤葳蕤，丝纽珠毬缬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22186,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 中秋","author":"黄琬璚","text":"一■长天，影涵秋水。\n月磨明镜冰壶里。\n金波潋滟碎光流，嫦娥妆就新梳洗。\n秋色中分，秋心万里。\n关城望断秋风起。\n香飘丹桂入频黎，良宵拼得帘边醉。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22187,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 玉簪花","author":"黄琬璚","text":"分植窗阴，森森立玉。\n天然澹伫幽栏曲。\n香匀麝粉沁冰筒，长须细罥黄金粟。\n露冷烟凉，丰神幽独。\n风姨月姊贪妆束。\n枝枝琢就白瑶簪，髻边斜缀搔头绿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22188,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤栖梧 重九","author":"黄琬璚","text":"落木萧萧愁永昼。\n秋雨秋风，佳节逢重九。\n糕字寻常难赋就。\n风流帽落何人又。\n帘卷清香盈两袖。\n黄压疏篱，菊短秋容瘦。\n几度花前开笑口。\n一杯酣醉茱萸酒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22189,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤栖梧 秋暮","author":"黄琬璚","text":"霭薄烟昏添暝色。\n叫断归鸿，何处传书帛。\n庭院荒闲秋寂寂。\n离愁无限砧声急。\n亚字回栏人伫立。\n短须寒生，几阵西风逼。\n碎响空阶疏雨滴。\n暮山一带凝愁碧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22190,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渔家傲","author":"黄琬璚","text":"著意留春春又去。\n海棠落尽红如许。\n睡起纱窗天正午。\n愁无主。\n销闲只共鹦哥语。\n小院游丝飞缕缕。\n凄凉又听芭蕉雨。\n忆得家庭春栩栩。\n今索处。\n恼人更有騃儿女。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22191,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"行香子 寄表妹唐慧仪","author":"黄琬璚","text":"相别多时，想见无期。\n记从前、围坐深闺。\n藏钩砚北，刺绣楼西。\n正月初明，云初敛，雁初飞。\n亚字栏回，丁字帘垂。\n夜将残、寒透罗衣。\n欲谱瑶琴，难寄离思。\n怅岳云遥，湘水隔，锦鳞稀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22192,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤凰台上忆吹箫 听润仪弹琴","author":"黄琬璚","text":"如水新秋，称心良夜，无端诗思盈囊。\n正碧天云褪，月朗东厢。\n听得松风竹籁，一声声、飞堕琴床。\n移情甚、虚中嚼徵，空际敲商。\n馀音入耳琅琅。\n只冰丝几缕，手语都香。\n念千秋尘网，顷刻沧桑。\n赖有寒泉瘦玉，尽忘却、华屋黄梁。\n聊共汝、尘襟顿爽，消受清凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22193,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]