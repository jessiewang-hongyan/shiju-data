[{"title":"如梦令 其一 即景","author":"熊琏","text":"晓起湘帘半揭。\n那有天香堪折。\n文采付风流，惊见双飞蝴蝶。\n凄切。\n凄切。\n飘落满阶黄叶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38565,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"如梦令 其二 即景","author":"熊琏","text":"炉袅香烟人静。\n隔院葵花摇影。\n新雁过遥天，一枕睡情初醒。\n风紧。\n风紧。\n窗外萧萧日冷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38566,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"如梦令 其三 即景","author":"熊琏","text":"望断碧云天远。\n门掩黄昏深院。\n风雨压颓垣，几朵秋棠红颤。\n谁念。\n谁念。\n虫语疏砧一片。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38567,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"如梦令 其四 即景","author":"熊琏","text":"孤馆深垂空帐。\n一盏灯儿相傍。\n清夜未成眠，檐马风来敲响。\n思想。\n思想。\n月在豆花棚上。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38568,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"捣练子 夜雨","author":"徐元瑞","text":"人寂寂，夜萧萧。\n斗帐寒侵香印消。\n枕上谁惊春梦短，数声疏雨近芭蕉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38569,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇 沐发","author":"徐元瑞","text":"鹤唳晴空，月明不著朦胧睡。\n绿窗惊起，小立苍苔砌。\n自解香云，俛首临风蓖。\n花阴碎。\n枝枝斜坠。\n薄露侵罗袂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38570,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 赠美人","author":"徐元瑞","text":"袅娜风前翠袖偏。\n宫鞋三寸绣双莲。\n朱唇新点内家圆。\n紫燕偷睛窥粉靥，绿杨留意挽香肩。\n无情花鸟亦相怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38571,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重叠金 春恨","author":"徐元瑞","text":"昼长睡起垂帘坐。\n新诗题遍无人和。\n稽首怨天公。\n生成薄命侬。\n问天天不应。\n眉锁千重恨。\n和泪理瑶筝。\n曲终空叹声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38572,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重叠金 睡鹦鹉","author":"徐元瑞","text":"雪衣巧舌花棚外。\n修翎立向斜阳晒。\n半晌不闻言。\n惊寻到翠轩。\n笑声嗔小婢。\n不要惊他睡。\n风响绿窗纱。\n醒来抖落花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38573,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卜算子 闺情","author":"徐元瑞","text":"花信几番催，桃李争秾艳。\n不敢频来倚画栏，怕与春相见。\n才把绣针拈，又觉心儿倦。\n试唤青鬟捲翠帘，撚出双双燕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38574,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐 春归","author":"徐元瑞","text":"绣窗无那。\n自卷帘儿坐。\n羞睹黄莺枝上卧。\n抛去青梅数颗。\n东风阵阵相催。\n胭脂满地苍苔。\n春色依然归去，为谁留下愁来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38575,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐 腊梅","author":"徐元瑞","text":"冰清玉映。\n耐得骄寒性。\n日暮阑干犹独凭。\n多少诗情酒兴。\n天然厌学浓妆。\n几点瘦影横窗。\n著意不须颜色，寻它一段幽香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38576,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐 忆别","author":"徐元瑞","text":"珠帘轻揭。\n憔悴怜黄叶。\n忽忆小亭人与别。\n正是重阳时节。\n当初一段清秋。\n平分两下离愁。\n试向西风寄问，知他还似侬不。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38577,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"画堂春 春懒","author":"徐元瑞","text":"东风又作困人天。\n玉阶满榆钱。\n翠罗衫皱髻云偏。\n整日欹眠。\n泪妒三春宿雨，愁兼午夜题鹃。\n绣绷闲阁绿窗前。\n羞刺双鸳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38578,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"朝中措 春情","author":"徐元瑞","text":"镜中蹙损小双蛾。\n憔悴却因何。\n新作伤春一曲，绿窗教取鹦哥。\n潇潇风雨，恹恹愁绪，九十都过。\n试问落花流泪，一春谁少谁多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38579,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉花阴 卜归","author":"徐元瑞","text":"小步闲庭香馥馥。\n柳眼新垂绿。\n游赏共谁欢，寂寞今春，只是调莺熟。\n银筝错乱难成曲。\n纤手临池浴。\n昨夜梦中归，自向花前，暗掷金钱卜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38580,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南柯子 画扇美人","author":"徐元瑞","text":"拂砌垂新柳，临窗醮绿蕉。\n含情脉脉自无聊。\n立向花阴深处、怕人瞧。\n缺月双娥浅，春风笑脸娇。\n朱唇一点夺樱桃。\n不待向人私语、句魂消。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38581,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卖花声 春愁","author":"徐元瑞","text":"春色满庭芳。\n蝶乱蜂狂。\n玉梅风细袭人香。\n才过花朝寒食近，催断侬肠。\n夜夜小纱窗。\n多少思量。\n待君归诉怕相忘。\n试写卖花声一首，记取凄凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38582,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卖花声 春暮","author":"徐元瑞","text":"屈指怕春归。\n不展双眉。\n柳丝无计系斜晖。\n又是黄昏时候也，烟霭如迷。\n绣户闭帘衣。\n兀坐窗西。\n无情灯惯把人欺。\n夜夜虚开花一穗，赚我归期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38583,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天 暮春日即事","author":"徐元瑞","text":"宿雨才收暖气侵。\n清明过了觉春深。\n斜推玉枕抛残梦，轻阁犀梳听鸟声。\n邀女伴，到芳林。\n碧苔净扫坐花阴。\n闲寻斗草消长日，输却搔头小玉簪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38584,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人 冬闺","author":"徐元瑞","text":"起来慵向妆台倚。\n乱绾凌云髻。\n归期曾说柳青时。\n整日恹恹只是、恼春迟。\n小园昨夜西风劣。\n吹落漫天雪。\n侍儿佯笑卷帘纱。\n却道玉梅已放、满枝花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38585,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉楼春 秋闺","author":"徐元瑞","text":"西风习习生秋扇。\n黄菊东篱开欲遍。\n画楼近日懒妆梳，闲却钗头双紫燕。\n朦胧昼卧湘纹簟。\n欲起沉吟心力倦。\n依稀梦冷不多时，疑在芙蓉深小院。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38586,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 乡望","author":"徐元瑞","text":"才值暮春天。\n暖气侵入懒著棉。\n闲倚妆楼无个事，移肩。\n卷幔青青草色鲜。\n隔岸酒旗偏。\n半枕垂杨半枕烟。\n遥望夕阳红处也，桥边。\n一对黛黄小犊眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38587,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 闻笛","author":"徐元瑞","text":"残月下回廊。\n阵阵飞来叶打窗。\n小婢背灯疑睡稳，凄凉。\n欲睡还欹绣枕旁。\n何处笛声长。\n那管深闺听者伤。\n央及西风吹去也，它乡。\n不信无情不断肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38588,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 其三 春情","author":"徐元瑞","text":"独坐数归期。\n花影重重月影低。\n无计徘徊思好句，支颐。\n除却春愁没个题。\n闲倚画楼西。\n芳草青青失旧堤。\n犹记当年人去处，依依。\n红杏花边卓酒旗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38589,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行 秋夜","author":"徐元瑞","text":"绣幕低垂，银钩双控。\n栏杆十二花阴重。\n空馀今夜月华明，画楼寂寞无人共。\n髻乱惊鸦，钗欹金凤。\n避愁无计惟寻梦。\n几番辗转不成眠，谁家玉笛声三弄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38590,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临江仙 送春，和陈简斋韵","author":"徐元瑞","text":"携酒一尊池上饮，春归满地红英。\n遥闻林外杜鹃声。\n不如归去也，欲听未分明。\n独抱琵琶弹一曲，曲中水冷鱼惊。\n风前泪眼几时晴。\n月高星数点，人倦夜三更。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38591,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花 惜花","author":"徐元瑞","text":"睡觉兰房人静悄。\n伴我清清，一点灯儿小。\n风雨五更寒料峭。\n不知剩得春多少。\n帘捲妆楼天色晓。\n未整云鬟，满地寻芳草。\n枝上海棠都谢了。\n倩谁临作凄凉稿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38592,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"苏幕遮 春晓","author":"徐元瑞","text":"锦衾寒，初睡觉。\n帘幕重重，瞒却珠楼晓。\n忽听檐前乾鹊噪。\n起向妆台，怕对菱花照。\n小园深，人不到。\n昨夜东风，撚去春多少。\n独倚雕栏寻句好。\n半晌无言，自把花枝拗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38593,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉春风 秋闺","author":"徐元瑞","text":"池上残荷尽。\n篱下黄花嫩。\n重阳还有几多时，近近近。\n曾记当年，有人同和，花笺新韵。\n不似今来困。\n憔悴谁相问。\n珠帘摇曳晚风来，阵阵阵。\n翠袖生寒，银灯明灭，玉炉香烬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38594,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"行香子 春暮","author":"徐元瑞","text":"不贴花钿，不画涵烟。\n在愁中、昼永如年。\n自春归去，未到亭园。\n怕燕儿啼，花儿谢，柳儿眠。\n纤纤素指，宝墨轻研。\n自书成、一幅霞笺。\n拈来帘下，试告苍天。\n问有谁评，有谁和，有谁怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38595,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"凤凰阁 秋晚苦雨","author":"徐元瑞","text":"看西风吹起，满庭碎叶。\n闭朱户独坐还怯。\n窗外芭蕉点点，做尽凄切。\n禁不住、芳心欲折。\n残灯挑尽，隐隐半明半灭。\n罗裳只借香温热。\n今夜里、这愁肠，胜似离别。\n宽褪了、裙儿几褶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38596,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"凤凰台上忆吹箫 梦中送别","author":"徐元瑞","text":"柳外烟迷，花梢日暮，画堂酒意阑珊。\n听一声去也，瘦损朱颜。\n寸寸柔肠千断，携素手、密赠双环。\n离情苦，几番欲诉，先揾罗衫。\n羞看。\n水边白鹭，一对对闲游，红蓼花滩。\n恨西风吹急，远送征帆。\n望断天涯不见，难回首、背倚雕栏。\n从今后，相逢何处，依旧巫山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38597,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"如梦令 渔景","author":"王贞仪","text":"月下一溪烟淡。\n溪里渔叉夜响。\n知有小渔舟，叉得寒鱼初返。\n同伴。\n同伴。\n掉向白萍花港。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38598,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆秦娥 春暮，钱塘舟中作","author":"王贞仪","text":"春雨歇。\n杨花两岸飞晴雪。\n飞晴雪。\n江途渺渺，扬舲三浙。\n潮来胥口声悲咽。\n烟波一棹真浮叶。\n真浮叶。\n蓬窗闲坐，书翻越绝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38599,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长相思 偶作","author":"王贞仪","text":"雁南归。\n客难归。\n一纸家书寄每迟。\n愁心没尽期。\n晓风嘶。\n晓星稀。\n梦到家园觉后疑。\n邻鸡喔喔啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38600,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"生查子 闺怨","author":"王贞仪","text":"宵来风雨多，应妒花娇姹。\n秾艳一时空，忍煞芳华谢。\n无语倚阑干，闷对花枝下。\n红泪落双眸，簌簌如花洒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38601,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 病起","author":"王贞仪","text":"日长深院垂帘幕。\n夕阳芳草愁心搁。\n才换夹衣裳。\n轻红杏子衫。\n匆匆春去候。\n人病偏消瘦。\n不敢敛双蛾。\n含颦对镜多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38602,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 惜花，次季容女士韵","author":"王贞仪","text":"嫣红姹紫开偏早。\n看来颜色同人好。\n花貌媚于人。\n春光正十分。\n雨风难作主。\n浮艳归尘土。\n洒泪怨残丛。\n无端减玉容。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38603,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 过贞娘墓","author":"王贞仪","text":"春来绕墓飞胡蝶。\n芳草青青浑未歇。\n此地葬倾城。\n偏萦过客心。\n香魂愁断绝。\n鹃叫泉台月。\n玉貌冠三吴。\n风流晓梦孤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38604,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卜算子 夏晚","author":"王贞仪","text":"雨后晚凉多，衫葛含风细。\n小摘庭前茉莉花，弱缕穿连蒂。\n团扇叶芭蕉，闲坐荷花砌。\n剥取池荷带湿看，莲子生还未。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38605,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南柯子 咏霞","author":"王贞仪","text":"水气烘晴霭，何殊吐蜺腥。\n赤城曾道烂奇形。\n最好落随孤骛、下烟汀。\n日脚成丹紫，天衣叠绮青。\n微风吹碎断云停。\n记否曼卿传饮、自天廷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38606,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"解语花 咏梅","author":"王贞仪","text":"暗香乍袭，冷艳亭亭，丰韵真无比。\n十分旖旎。\n羞并语、东园桃李。\n香含雪霁。\n别自有、一般妩媚。\n只须看、空色凝妆，在黄昏影里。\n长想烟霞湖上，听啁啾翠羽，清梦初起。\n佳人绝世。\n凌缟袂，却胜朱纨绿绮。\n此情难拟。\n且相伴、云阶月地。\n对仙姿、玉骨两神清，作闺中知己。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38607,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"眼儿媚 舟泊江浦道中","author":"王贞仪","text":"小泊行艖路偏赊。\n云影雁行斜。\n数株疏柳，一痕残照，几点归鸦。\n芦花两岸如飞雪，潮汐下寒沙。\n水国西风，竹蓬夜月，人在天涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38608,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"明月棹孤舟 悲秋","author":"王贞仪","text":"到得秋来愁便阔。\n悲风又剪桐枝落。\n天际哀鸿，林间病叶，断送秋光寂寞。\n剩对黄花怜瘦索。\n淡容冷艳枝枝弱。\n一盏香醪，半帘残月，强把诗情咀嚼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38609,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秦楼月 自泰州至张夏镇作","author":"王贞仪","text":"东风峭。\n一车轧轧长安道。\n长安道。\n瓦天青翠，云封岳峤。\n软红扑面飞沙罩。\n客途空惹梅花笑。\n梅花笑。\n家园回忆，玉窗冰照。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38610,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"满江红 过平原县东门，谒颜鲁公祠","author":"王贞仪","text":"残照城东，风急处、暮笳声咽。\n正卸毂、平原祠外，前行瞻谒。\n作郡回思天宝日，九重乐极金瓯缺。\n蓦然闻鼙鼓，起渔阳，霓裳歇。\n卫弹邑，千秋节。\n争坐位，千金贴。\n只拒降斩使，是何忠烈。\n犹有祠堂传俎豆，更存心迹书碑碣。\n羡双双姓字，弟兄香，常山舌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38611,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"满江红 甲寅冬至日雪","author":"王贞仪","text":"至日阳回，刚好趁、歌调白雪。\n侵寒起、玉堆阶下，无声骚屑。\n斮桂未妨才女咏，披兰欲动先春色。\n较当年、靧面熏衣，风怀越。\n三径外，琅玕折。\n一室里，珠帘揭。\n喜六出纷霏，梅开时节。\n香馥金炉烟篆漾，茶烹石鼎诗情澈。\n只工闲、组绣线新添，轻寒绝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38612,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"调笑令 闺情","author":"王贞仪","text":"白露。\n白露。\n结作清霜彫树。\n树头愁杀乌栖。\n隔个窗儿乱啼。\n啼乱。\n啼乱。\n惊醒罗帷梦断。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38613,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江城子 夜雨","author":"王贞仪","text":"无端寒雨促秋光。\n晚风凉。\n野云苍。\n才有梧桐，助响落银床。\n窗外声声浑不住，愁绝处，夜偏长。\n况添低砌又啼螀。\n乱回肠。\n更心伤。\n炉内寒烟，销尽水沉香。\n欹枕难堪听到晓，心滴碎，怯空房。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38614,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浪淘沙 吉林秋感，次鹤仙夫人韵","author":"王贞仪","text":"关塞冷秋风。\n沙雾迷濛。\n可怜秋去又匆匆。\n凝望乱烟衰草外，离恨无穷。\n最好故园中。\n黄鞠丹枫。\n蟹螯双擘酒盈钟。\n此景那堪回首忆，愁见归鸿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38615,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 梅魂。次吴小莲女士韵","author":"王贞仪","text":"庾岭烟迷夜寂寥。\n罗浮月冷路迢遥。\n可堪空色不相遭。\n风笛吹残浑欲断，霜笳听罢惯能销。\n依依脉脉迥难招。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38616,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"风流子 春草。次陈姊宛玉韵","author":"王贞仪","text":"日色暖平津，乡梦杳、寻屐忒愁人。\n想金勒騧嘶，夕阳烟淡，玉楼人望，广陌痕新。\n碧影萋萋三春暮，南浦犹伤神。\n蜀魄叫残，楚魂招罢，瘦馀中妇，眉黛空颦。\n凄凉青冢上，香环埋、艳骨偏自成茵。\n更有长门，参差辇路徒亲。\n却几多萦得，新愁旧怨，天涯故国，泣雨迷尘。\n肠断芳晨，绣帏日掩青春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38617,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 感作","author":"王贞仪","text":"构思下笔。\n汉魏齐梁求并立。\n底事心忙。\n才学韩苏又柳王。\n拘牵潦草，面目何曾收拾好。\n纵效西颦。\n没奈生成嫫母形。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38618,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行 松花江望雨","author":"王贞仪","text":"黑水惊流，黄云隐雾。\n晓峰新翠薶千树。\n片帆刚渡半烟江，不知何处吹来雨。\n喷雪涛飞，搏沙风驻。\n翻盆挂瀑横空布。\n风波如此掉回船，星红一线雷车舞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38619,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行 题梅花水仙芝草合景小幅","author":"王贞仪","text":"庾岭春迟，洛川波迥。\n一般幽思谁能领。\n个侬同住水云乡，黄裳绛服欣联影。\n世外芳姿，寰中仙品。\n灵根堪结芝林隐。\n好将三秀拟三香，襟期冰雪偏宜冷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38620,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"满庭芳 冬夜吉林作","author":"王贞仪","text":"杨柳枝疏，枇杷花落，天涯别有时光。\n朔吹如箭，草白与沙黄。\n九九寒凝回忆，转眼处、飞雪铺霜。\n重檐下、冰钗堪数，随溜挂帘旁。\n含情成小立，戍楼更冷，野柝声扬。\n看庭中、残月已上东墙。\n此际感萦怀抱，空打叠、百结回肠。\n凄凉煞，江南塞北，万里■家乡。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38621,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉楼春 夜雨有怀兰畹姊","author":"王贞仪","text":"春来开得花成绮。\n遥忆美人睽万里。\n天涯同是客中身，好梦何曾空度拟。\n双鱼未寄雄州水。\n欲整瑶琴愁待理。\n夜来吹雨散芭蕉，故作寒声惊客耳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38622,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小重山 灯花","author":"王贞仪","text":"玉楼传声月白时。\n青缸光隐约、发新蕤。\n金葩璀璨细开迟。\n飞丹凤、摇曳故留姿。\n雨露不须滋。\n蕊生火树花、映银池。\n朝来先报好音知。\n轻霞晕、应是吉祥枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38623,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐 由平原过东方曼倩故里","author":"王贞仪","text":"卫河西去。\n斜指沙洲路。\n此是岁星名里处。\n大梦金门堪慕。\n悬珠编贝空游。\n书生叹息封侯。\n归念细君分赐，诙谐竟尔风流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38624,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"桃源忆故人 再入都中，留别淝上许燕珍夫人","author":"王贞仪","text":"浮波又泛扁舟去。\n来日故人何处。\n后会苕苕愁数。\n梦也难凭据。\n美酒高怀还小住。\n拼醉盈樽红玉。\n北地风严日暮。\n肠断幽燕路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38625,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"桃源忆故人 游姑苏台","author":"王贞仪","text":"馆娃旧日沉歌舞。\n开闾城边鼙鼓。\n月冷宫梧几许。\n夜夜啼乌苦。\n麋鹿可怜群走去。\n霸业消磨何处。\n响屧空存旧语。\n草色侵廊庑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":38626,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]