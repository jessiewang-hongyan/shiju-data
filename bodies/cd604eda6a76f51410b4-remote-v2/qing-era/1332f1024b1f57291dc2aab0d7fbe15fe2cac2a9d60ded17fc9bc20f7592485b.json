[{"title":"家瑞陔进士寄诗问近况次韵奉答","author":"陈锡金","text":"瀛壖宿梦醒春婆，风雨空山一啸歌。\n老蠹生涯书少味，閒鸥世界水犹波。\n敢嫌蜗室三间小，幸免鹑衣百结多。\n莫问辋川近消息，半龛灯火病维摩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1910,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"偶成","author":"陈锡金","text":"转瞬乾坤老，惊心岁月奔。\n有歌弹短铗，无赋卖长门。\n调胃蛾眉豆，遮身犊鼻裈。\n祇怜贫又病，遑计饱兼温。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1911,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"庚子1900秋怀","author":"陈锡金","text":"鲤风雁雨四山秋，蜃雾蛟烟万古愁。\n入世已如萍在水，藏身祇合芥为舟。\n人从江北争分鹿，我隐墙东等侩牛。\n有债至今呼负负，无亭何处署休休。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1912,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"看花","author":"陈锡金","text":"看花有兴且随缘，辟谷无方莫学仙。\n三折肱难肉白骨，一弹指易过青年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1913,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"哭林良庭","author":"陈锡金","text":"分手河梁数载中，屡劳千里惠书筒。\n故人已化辽东鹤，遗事谁传塞北鸿。\n剪烛紫云岩畔雨，挂帆乌日渡边风。\n旧游回首都如梦，泪洒枫亭万树枫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1914,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过大肚溪","author":"陈锡金","text":"剑匣琴囊东复西，出门怕听鹧鸪啼。\n四肢未老先麻木，一饭随缘饱藿藜。\n祢正平凭嗤碌碌，微生亩任笑栖栖。\n残衫破帽无人识，斜日呼船大肚溪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1915,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"员林道中","author":"陈锡金","text":"骚坛待斗新旗鼓，驿路相随旧剑琴。\n汽笛一声天欲暝，菊花香里下员林。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1916,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄怀蔡披金秀才仿白乐天体作六句律","author":"陈锡金","text":"萤窗寂寞留残简，蠹迹纵横侮旧芸。\n岛上更无台避债，人间剩有冢埋文。\n此生已坐儒冠误，合买青山卧白云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1917,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄怀许蕴白明府","author":"陈锡金","text":"催诗击钵竹城春，翘首江云暗怆神。\n万里浮沉双鲤信，十年沦没七鲲身。\n别君昔洒哀时泪，老我今犹彻骨贫。\n惭谢知交期望切，金鳌顶上属何人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1918,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"漫题","author":"陈锡金","text":"偃蹇空山里，新亭泪眼开。\n黄鸡催日去，苍狗幻云来。\n身世鸾栖棘，功名蚁梦槐。\n閒愁无处遣，黑劫正飞灰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1919,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"漫题","author":"陈锡金","text":"种菜门常闭，诛茅屋未成。\n野无粱与稻，路有棘兼荆。\n苦赋哀鸿什，悲歌猛虎行。\n侧身天地窄，何处寄馀生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1920,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"大安秋望","author":"陈锡金","text":"摇落江山客恨添，寓斋寂寂坐恹恹。\n蓼花红雨芦花雪，一样秋痕入眼帘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1921,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"节妇郑氏诗","author":"陆登选","text":"琴风凄断泣孤鸾，霜月惊看花魄残。\n劲节不磨天地老，幽怀有恨水云乾。\n帷空祗是存冰檗，镜破还同折镆干。\n含笑九原双比翼，贞心长彻海波寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1922,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菊花","author":"陆广霖","text":"群芳萎绝剩凄凉，独向东篱吐暗香。\n数朵黄英秋浥露，一枝紫艳晚凌霜。\n名成彭泽悬车后，色重龙山落帽傍。\n赖尔挺然生傲骨，不教肃杀肆锋铓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1923,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桃花","author":"陆广霖","text":"黄蜂紫蝶日纷纷，蹊上清芬隔水闻。\n朱脸和风初带酒，芳姿含雨乍行云。\n文君垆畔飘红袖，宋玉墙头露绛裙。\n莫道元都诗句好，几回迁客叹离群。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1924,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"盂兰竹枝词 其二","author":"彭廷选","text":"七宝灯明结綵花，金身丈六曳袈裟。\n相传孝子方成佛，底事当年早出家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1925,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾 其一","author":"彭夏琴","text":"台湾绝域贡降笺，举族归朝尽内迁。\n历授尧封千载后，地开禹贡九州前。\n人民半与鱼龙杂，郡县全依岛屿偏。\n四十年来空倔强，至今始得罢楼船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1926,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾 其二","author":"彭夏琴","text":"当年犀甲下扶馀，衔璧谁怜轵道车。\n西市赭衣魂已渺，南朝紫盖事终虚。\n帆来日本通商近，邑改天兴置吏初。\n一自孙恩分战舰，烽烟边海几丘墟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1927,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾 其三","author":"彭夏琴","text":"高华遗屿自隋朝，营垒依然识旧标。\n淡水鸡笼谁竟渡，飓风蜃市几全消。\n乘桴何意真浮海，叱石无能远驾桥。\n抽调可怜诸将士，不教辛苦说征辽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1928,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾 其四","author":"彭夏琴","text":"穷岛军需飞檄催，蔗霜兼买鹿皮来。\n生番禳社三冬集，互市洋船六月开。\n浪峤山形随地尽，厦门风信逐潮回。\n荷兰故土非瓯脱，窥伺将毋隐祸胎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1929,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹿港飞帆","author":"曾秀","text":"一声欸乃碧天空，彩鹢飞飞挂锦蓬。\n千里春波千里月，满帆秋雨满帆风。\n潮生潮落微茫际，舟吐舟藏杳蔼中。\n笑看舳舻争利涉，开船齐唱大江东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1930,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"草虫","author":"汤尚鹏","text":"青草黄泥孰与争，吆吆偏喜弄秋声。\n人家儿女能窥伺，莫向西风特地鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1931,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"暮春东郊","author":"黄仁","text":"未改东风欲自南，细推寒暑此时酣。\n芍兰从古传溱洧，童冠于今可二三。\n燕语莺啼何所恨，桃秾李郁为谁贪。\n暮春佳气年年胜，无数晴光动翠岚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1932,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"安平晚渡","author":"黄元弼","text":"落日海天红，孤城一苇通。\n潮平轻荡桨，浪急半推篷。\n不尽栖飞鹜，无边断续虹。\n几回思共济，举首待长风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1933,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏水沙连图 其一","author":"黄吴祚","text":"二十馀社尽边湖，南北沿崖仄经纡。\n斗六门来通一线，诸番形胜岛中无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1934,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏水沙连图 其二","author":"黄吴祚","text":"五色尨毛杂树皮，织成罽毯世稀奇。\n蛮娘妍好珠垂项，不见做田歌舞时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1935,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏上澹水八社 其一","author":"黄吴祚","text":"初冬出草入山深，先向林间听鸟音。\n荜雀飞来音较亮，诸番竞奋逐前禽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1936,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏上澹水八社 其二","author":"黄吴祚","text":"社中留客劝衔杯，诸妇相将送酒来。\n误进一杯须尽饮，漫分辞受起嫌猜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1937,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"花朝游弥陀寺","author":"黄廷光","text":"联步禅林眼欲迷，枝头簇簇绕东西。\n游人队里探花信，社燕飞来蹴絮泥。\n到处中和饶好景，谁家红紫不成蹊。\n弥陀散出天香满，唤醒流莺百啭啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1938,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"读寄挽新竹阿美女史诗有感赋似沄舫蔚村毓臣琢其敦让诸词客","author":"黄茂清","text":"难藉娲皇补恨天，水流花谢鸟空怜。\n知卿了却三生债，惜我曾无一面缘。\n香草美人今幻梦，青山白骨旧婵娟。\n悔教名字留金谷，石氏繁华已寂然。\n不须红粉感飘零，豪士交游日未停。\n一段姻缘桃叶渡，十年心事牡丹亭。\n枉追琴韵寻司马，剩得湖山葬小青。\n任是多情陈后主，歌残玉树有谁听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1939,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渔人聚饮","author":"黄茂清","text":"卖鱼沽酒来，相知有三五。\n酣饮绿榕阴，拇战猛如虎。\n醉倒夕阳西，不辨今与古。\n莫道囊无钱，明朝举网取。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1940,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水沙浮屿","author":"黄清泰","text":"云根不坠地，牢落东山头。\n天风与海水，争激怒生疣。\n断鳌足簸扬，支祈任沉浮。\n状若银河翻，回星漂斗牛。\n又若乘杯渡，一粒乱中流。\n山水有常性，动静安足求。\n呼龙与之语，掀髯嗔我尤。\n静极而动生，天地一浮鸥。\n大笑挥龙去，浮沙云未收。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1941,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望玉山","author":"黄清泰","text":"浮岚高捲日初生，一片晴光照眼明。\n积雪不消三伏后，层冰常讶四时成。\n疑他匹练非吴市，遮莫胥涛向越城。\n大璞已教天地凿，山灵稳卧不须惊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1942,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"珠潭浮屿","author":"黄骧云","text":"潭心突兀屿如珠，一片青红两色殊。\n并剪倩谁来割截，鸿沟分界不模糊。\n奇生温峤燃犀想，趣悟濂溪太极图。\n笑尔番民忘帝力，浮田自种免输租。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1943,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清水春光","author":"黄骧云","text":"到处寻春未见春，原来春在此藏身。\n山都献笑齐描黛，溪但范花不著尘。\n竹响又喧归浣女，桃开惯引捕鱼人。\n仙岩清水传名字，果有香泉白似银。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1944,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"碧山曙色","author":"黄骧云","text":"碧山碧色重复重，九十九尖峰閒峰。\n天鸡唤醒金乌鸟，玉女擎出青芙蓉。\n混沌初开早世界，盘古四顾无人踪。\n我来扶杖入烟翠，口嚼飞霞如酒浓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1945,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"丰亭坐月","author":"黄骧云","text":"亭高百尺插晴空，小住浑疑坐月宫。\n镜转一轮移左右，窗开四面挂玲珑。\n了无渣滓沿心境，觉有清光在眼中。\n花落庭閒人影静，关情总是望年丰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1946,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晚年偶吟 其一","author":"杨士芳","text":"十载寒窗半读耕，倖登科甲立功名。\n门前五柳吾曾学，只愿融融过此生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1947,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晚年偶吟 其二","author":"杨士芳","text":"年几八十复何求，寡过无能暗自羞。\n亲友邀吾行善事，前愆可补免生愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1948,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过宁靖王故宫","author":"杨宗城","text":"浮云仰视亦须臾，长啸从容合院徂。\n臣节不磨天地老，世风虽远纪纲扶。\n西山叩马两高士，东海悬梁一丈夫。\n自是求仁无怨悔，奚烦遗叟重嗟吁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1949,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"泥路行","author":"杨桂森","text":"舆丁搓泥揉浆走，呼左呼右声声吼。\n重任全凭老肩负，森严一步不可苟。\n后者慌问泥深否，前者忙应下愈陡。\n石梯矗上高陵阜，骨力精神兼抖擞。\n漫来惯呼我好友，过此当沽溪熬酒。\n尔一石，我五斗，天公淫雨何太久。\n行人咨怨十八九，剧怜晚稻困菑亩。\n既耕而不穫兮，太息空仓尘釜之农叟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1950,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋海棠","author":"杨桂森","text":"睡足媸妖草，清姿独耐秋。\n自馀真蕴藉，不尚假风流。\n红淡日华浅，绿深云叶稠。\n灵根仙海茁，旧宅忆瀛洲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1951,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋海棠","author":"杨桂森","text":"地辟人来少，花閒境亦忘。\n热肠众皆是，冷意此偏尝。\n未假春风力，先分湛露光。\n今时谁召伯，羡却说甘棠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1952,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"红潮登颊醉槟榔","author":"杨桂森","text":"仁频号美上林中，品藻曾誇庾信同。\n紫凤卵含金露满，赪虬乳抱翠云空。\n心知雅爱昌盘供，牙慧閒将玉液融。\n陡觉温颜流汗雨，真教铁面亦春风。\n颊端浑认餐霞赤，潮势凭看吐沬红。\n渴斛未容茶社解，醉乡不藉酒兵攻。\n自因正气培千实，博得清香擅四功。\n欲倩锦郎作芹献，丹忱依旧恋宸枫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1953,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题方司马独钓图","author":"褚禄","text":"为政委蛇不计功，却图幽致石岩中。\n半生心事期秋水，千尺丝纶飏晚风。\n折狱名驰双阙北，伐棠人诵大瀛东。\n行看烦补山龙衮，未必鲈鱼属钓翁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1954,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹿耳春潮","author":"褚禄","text":"天然形胜待潮生，鼙鼓逢逢望欲惊。\n正是桃花春破浪，俨然瀛岛雨翻城。\n当时窃国悲浮瘴，此日长年认荡缨。\n竞说王师平寇日，海门如雪势峥嵘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1955,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"永诀","author":"赵元安","text":"盖棺成永诀，容貌尚如花。\n襟袖腰仍细，裙钗鬓未华。\n可怜金屈戍，长恨玉钩斜。\n云雨巫山梦，魂归楚岫赊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1956,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"读梁成楠钓龙台古风即用原韵赋七律呈政","author":"赵元安","text":"杰士胸襟郁勃哉，狂歌啸起钓龙台。\n君王已遂骑鲸去，神鬼群惊破壁来。\n旧事兴亡麋鹿感，长篇歌泣凤凰才。\n登临无限云雷愿，横恣翁山笔阵开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1957,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赠芝兰女校书阿英","author":"赵元安","text":"一双俊眼一弯眉，一点灵犀一种痴。\n秋水精神冰作骨，玉山温润雪侵肌。\n金樽绿酒春生颊，红袖青灯夜诵诗。\n最好曲终琴罢后，芙蓉烟里话相思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1958,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆阿英","author":"赵元安","text":"芝兰女史唤阿英，皓齿明眸最有情。\n吹竹弹丝饶妩媚，携云握雨大宁馨。\n怜他痴绝颠鸾凤，顾我缘悭隔死生。\n底事音容尚如昨，奈何回溯不分明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1959,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"辛亥1911年履端闻雷","author":"赵元安","text":"夙有云雷愿，今传第一声。\n为霖元旦始，造物及时鸣。\n鼓动乾坤力，经纶化育情。\n震聋兼发聩，馀泽荫苍生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1960,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡","author":"赵元安","text":"搁住汪汪泪，人前不敢啼。\n百年魂已断，一死梦终迷。\n入室谁含笑，言归孰问期。\n莺莺兼燕燕，凄绝已成泥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1961,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾八景","author":"齐体物","text":"十里平铺练，孤城落照边。\n帆争云里鸟，人坐画中船。\n浪撼鱼龙宅，盂悬上下天。\n远沙渔火起，点点聚寒烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1962,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾八景","author":"齐体物","text":"渺渺烟波外，渔灯出远沙。\n如何天海畔，亦自有人家。\n落影常骇鳄，当门不聚鸦。\n望中疏更密，知是屋参差。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1963,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾八景","author":"齐体物","text":"鹿耳雄天堑，寒潮拍拍来。\n激涛翻白马，匝岸走春雷。\n候月知宵涨，看波感后催。\n谁能慕宗悫，万里驾风回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1964,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾八景","author":"齐体物","text":"高岛看朝旭，天鸡未发声。\n却将身万里，常起自三更。\n宇宙尚曚昧，扶桑已极明。\n得为沧海客，先见日华生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1965,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾八景","author":"齐体物","text":"明霞散天末，灼灼浓于绮。\n试吟谢朓诗，分明拟得似。\n远看孤屿间，疑自赤城起。\n何当遇刘郎，与之同徙倚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1966,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾八景","author":"齐体物","text":"宪府亭临海，风涛秋有声。\n当杯须百斛，危坐亦三更。\n动地疑何决，掀天似岳倾。\n夜吟共宾客，不浅武昌情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1967,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾八景","author":"齐体物","text":"台因观海搆，远水绿于萝。\n浩渺心俱阔，澄清志若何。\n只疑天是小，更觉地无多。\n白雉梯航路，于今尚不波。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1968,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾杂咏 其九","author":"齐体物","text":"傀儡番居傀儡深，岂知尧舜在当今。\n含哺鼓腹松篁下，盛治无由格野心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1969,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"瘗鹤铭有序","author":"刘伯琛","text":"伟兹胎禽，禀质清绝。\n顶孕丹砂，羽洁白雪。\n翱翔紫盖，长养青田。\n梦寻坡老，影伴逋仙。\n海天泬寥，偏来尘壤。\n饮啄戕性，委形何往。\n华亭断唳，缑岭增哀。\n风林月夜，鹤兮归来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1970,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"秋斋卧病谢朋徒，攲枕狂吟且自娱。\n绝窟西来声不断，可知歌答有天吴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1971,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"一方擘画括全台，叙述何徒擅史才。\n添邑添兵关至计，他年筹海此胚胎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1972,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"发凡起例倍精严，谢郑同心两美兼。\n谁敢挥毫相点窜，画蛇应笑足轻添。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1973,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"韩赵吴杨并隽才，一时职志让文开。\n鹭洲草罢瀛堧咏，已恨无人继福台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1974,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"旧迹空馀大井头，败篷断缆可曾留。\n沧桑变幻真弹指，徒步同登赤嵌楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1975,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"故宫萧瑟土花斑，海外当年转徙艰。\n宝玦珊瑚无觅处，天人眉宇落民间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1976,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"魁斗山头吊五妃，郑娘芳冢是耶非。\n年年琅峤清明节，无数东来白雁飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":1977,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]