[{"title":"潇湘楼杂忆 其七","author":"孙原湘","text":"楼上闻声楼下行，楼前妒眼已成城。\n隔帘微露云鬟影，料是王昌眼最明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40127,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潇湘楼杂忆 其八","author":"孙原湘","text":"下楼风恰绣裙掀，偷见弓弯窄更纤。\n乞与重台莲一瓣，朝朝枕上看红尖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40128,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潇湘楼杂忆 其九","author":"孙原湘","text":"郎来红日已衔山，采伴兜留苦不閒。\n终日相思能几见，累他一度又空还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40129,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潇湘楼杂忆 其十","author":"孙原湘","text":"略掀帘子露微颦，却恐消魂看未真。\n侬有小鬟郎有伴，一般惧碍作閒人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40130,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潇湘楼杂忆 其十一","author":"孙原湘","text":"鹦鹉能呼燕子猜，中楼那得久徘徊。\n胡麻饭罢当窗绣，郎若来时过午来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40131,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潇湘楼杂忆 其十二","author":"孙原湘","text":"楼窗蛱蝶绣将成，楼下鹦哥唤客声。\n半日盼郎郎不到，教侬错认几人行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40132,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潇湘楼杂忆 其十三","author":"孙原湘","text":"两情相敬久如宾，却隔重楼迹未亲。\n望见佯佯先立起，旁人只道避生人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40133,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潇湘楼杂忆 其十四","author":"孙原湘","text":"倒身我欲拜慈航，却恐卿嗤阮籍狂。\n暗向神光微点首，心头自爇妙莲香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40134,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潇湘楼杂忆 其十五","author":"孙原湘","text":"无计留行且送行，画阑特地倚新晴。\n难将此意教郎会，兜语双鬟送笑声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40135,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潇湘楼杂忆 其十六","author":"孙原湘","text":"茉莉香迎出浴迟，欢来是妾晚妆时。\n一番走马看花去，添得消魂几首诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40136,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"指爪","author":"孙原湘","text":"粉印脂痕尚宛然，温柔如捧手兜绵。\n调兰雪藕曾消受，握雨携云未结缘。\n聊当搯肤成密誓，尽堪搔背遗清眠。\n麻姑鸟爪亲声寄，不怕方平浪下鞭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40137,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"委曲辞 其一","author":"孙原湘","text":"方胜红笺达粉奁，公然妄想学鹣鹣。\n梅花肯嫁林君复，唤作卿卿傥不嫌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40138,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"委曲辞 其二","author":"孙原湘","text":"忍把旁妻唤小乔，封还两字笔新标。\n罗敷已有鬑鬑婿，辜负琴心着意挑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40139,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"委曲辞 其三","author":"孙原湘","text":"锦字收回自悔粗，甘心鞭背谢麻姑。\n愿天罚受维摩病，消得闺中薄怒无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40140,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"委曲辞 其四","author":"孙原湘","text":"郎病根由细揣量，料应未解妾柔肠。\n重题数字缄封去，抵得卢医肘后方。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40141,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"委曲辞 其五","author":"孙原湘","text":"封就鸾书少雁传，托题纨扇送君边。\n如何枉负聪明煞，自把机关错眼前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40142,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"委曲辞 其六","author":"孙原湘","text":"互斗聪明似弈棋，同心消息少参差。\n昨宵为怯旁人看，算到卿心一着迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40143,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"委曲辞 其七","author":"孙原湘","text":"晨窗翠鸟忽衔将，小叠花笺扇角藏。\n只有万千珍重字，青丝一绺裹中央。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40144,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"委曲辞 其八","author":"孙原湘","text":"人世婚姻定自天，争如才色自相怜。\n劝郎莫认夫妻好，认作夫妻转嚼然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40145,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"委曲辞 其九","author":"孙原湘","text":"手捧云笺病已差，欲脩报札转迟迟。\n连朝心事从头写，当取家书莫当诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40146,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"委曲辞 其十","author":"孙原湘","text":"郎书隐语自分明，妾自关心记得清。\n无限深情难下笔，只描兰蕊并头生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40147,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"兰舫纪游 其一","author":"孙原湘","text":"才傍仙舟语未交，星眸早已隔帘招。\n有人先我停兰桨，半晌何曾见阿翘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40148,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"兰舫纪游 其二","author":"孙原湘","text":"一春玉恙闭罘罳，声息何曾外院知。\n今日花前扶病出，教郎知道减轻时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40149,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"兰舫纪游 其三","author":"孙原湘","text":"标格矜严渐觉宽，水天閒话倚阑干。\n笑容也怕人猜料，无奈逢欢意自欢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40150,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"兰舫纪游 其四","author":"孙原湘","text":"画舫潜移傍曲池，烟波何处觅西施。\n玉清纵使重追著，错过良缘已片时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40151,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"兰舫纪游 其五","author":"孙原湘","text":"綵云重见蓼花湾，可奈斜阳送客还。\n兰棹渐移人渐远，碧纱犹自度春山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40152,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"兰舫纪游 其六","author":"孙原湘","text":"春游归去病兼愁，又是经旬不下楼。\n特为消魂人强起，绿窗风月控帘钩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40153,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋词 其一","author":"孙原湘","text":"相如病骨怕秋寒，那更临风惨不欢。\n千万为侬休自苦，君身安始妾心安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40154,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋词 其二","author":"孙原湘","text":"风清露白已凉天，楼上灯红尚未眠。\n如此夜深罗袖薄，为谁犹立绣窗边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40155,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋词 其三","author":"孙原湘","text":"仙人生就骨清癯，谁识丰容是病馀。\n那得纤腰真入抱，玉肌亲切看何如。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40156,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"纪缘尽日","author":"孙原湘","text":"未通眉语已通情，只隔湘帘不隔声。\n临别回眸重一顾，累人惆怅过今生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40157,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"悼词 其一","author":"孙原湘","text":"惊传神女已生天，兽鼎盟香息穗烟。\n妄冀因缘酬再世，难追魂魄到重泉。\n封题密札三千字，担受虚名十五年。\n剩有潇湘图画影，一回展礼一潸然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40158,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"悼词 其二","author":"孙原湘","text":"自怜身世太凄凉，幸遇知音玉尺量。\n直道此才无敌手，每称难得有情郎。\n遗文序早求张说，诔笔词还属谢庄。\n痴欲凭棺成一恸，深思岂是泪能偿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40159,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"悼词 其三","author":"孙原湘","text":"霜里幽兰雪里筠，可怜摧折不成春。\n七情雕就颜如玉，百病磨来性出尘。\n仙树逍遥无结子，慈云缥渺是前身。\n弯弓欲射银蟾落，追转姮娥作世人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40160,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"悼词 其四","author":"孙原湘","text":"影堂重过不胜情，无语低头一径行。\n只当个人远病在，若闻来客恐心惊。\n诗篇狼籍收难尽，画稿丛残半未成。\n检点巾箱旧钿盒，玉环知否有来生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40161,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拜梅","author":"孙原湘","text":"青莲才思九州横，独对梅花傲不成。\n七贵五侯供一笑，满身风雪拜卿卿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40162,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"元日","author":"孙原湘","text":"莺啼燕语报新年，亲拜红妆玉镜前。\n绝艳人如初透日，乍中年似嫩春天。\n芳心密取明琼卜，茗汁迟催小玉煎。\n手剥梅仁传吉语，愿郎瓜瓞更绵绵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40163,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"兰房 其一","author":"孙原湘","text":"当初握手寻常事，谁道如天不可攀。\n齧颈尚留纤齿印，搯肤同验炙香瘢。\n持裙偷搦莲双瓣，伏枕劳舒藕一弯。\n今日隔窗窥午绣，一层云纸万重山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40164,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"兰房 其二","author":"孙原湘","text":"兰房寂静卧乌龙，翻促郎行坐不容。\n非是热肠偏小胆，祇缘妒眼惯潜踪。\n言当要处尤宜少，情果真时岂在浓。\n留得清名相见好，并头曾已学芙蓉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40165,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"横霞仙馆杂事 其一","author":"孙原湘","text":"佛容光艳世无寻，供养端宜紫竹林。\n我愿将身化童子，朝朝合掌拜观音。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40166,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"横霞仙馆杂事 其二","author":"孙原湘","text":"只道粗才定品差，幽兰偏比别人家。\n回瞋一笑思量著，原是梅花第一花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40167,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"横霞仙馆杂事 其三","author":"孙原湘","text":"为恐狂奴思不禁，朱樱宛转避春禽。\n星妃微露莲花舌，未许沾唇已许心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40168,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"横霞仙馆杂事 其四","author":"孙原湘","text":"画堂相见倍矜严，眼角眉梢尽避嫌。\n六幅湘裙风不动，暗传心事与鞋尖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40169,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"横霞仙馆杂事 其五","author":"孙原湘","text":"郎来深坐绿窗纱，看我梳成两鬓鸦。\n当着小姑留不得，待伊临去唤煎茶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40170,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"横霞仙馆杂事 其六","author":"孙原湘","text":"含情低首不轻抬，还恐当窗女伴猜。\n趁着金针重度候，看郎偷眼看侬来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40171,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"横霞仙馆杂事 其七","author":"孙原湘","text":"相邀姊妹出花前，人自徐行我转先。\n闪过小屏山一角，任郎偷搦指尖妍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40172,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"横霞仙馆杂事 其八","author":"孙原湘","text":"春社如云紫陌过，重帘窣地注娇波。\n谁知帘外萧郎立，促膝温存半晌多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40173,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"横霞仙馆杂事 其九","author":"孙原湘","text":"戏取茶瓯当酒杯，手拈红豆教郎猜。\n怪人料事偏奇中，手握双钩不肯开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40174,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"横霞仙馆杂事 其十","author":"孙原湘","text":"欲度樱桃味与郎，背人离坐走佯佯。\n玉瓯一点波罗蜜，分付消魂自去尝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40175,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"横霞仙馆杂事 其十一","author":"孙原湘","text":"问郎底事病双眸，可恨银灯可闷愁。\n好避绿窗风日煖，如何还写字蝇头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40176,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"横霞仙馆杂事 其十二","author":"孙原湘","text":"仙骨姗删响佩琚，径来檀几泥相如。\n玉纤替按云蓝纸，只道贪看倒薤书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40177,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"情钟","author":"孙原湘","text":"伊人双颊秀芙蓉，自识相如带病容。\n频蹑幽踪忘露冷，互穿衵服漏香浓。\n思深不记无心过，语密亲除有用封。\n薄倖自惭兼薄福，如何消受此情钟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40178,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"锦袜","author":"孙原湘","text":"宝袜亲裁翠锦鲜，关心脱赠早凉天。\n重绵托里情深厚，密线缝围手巧妍。\n但许贴胸如妾抱，无由输意伴君眠。\n他时认取斑斑迹，莫弃香笼绣箧边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40179,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"娇瞋 其一","author":"孙原湘","text":"热肠冷面两难猜，越是依依越飏开。\n却忆乍成欢爱日，满身香雾近人来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40180,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"娇瞋 其二","author":"孙原湘","text":"错认真情是杂情，难将心迹剖分明。\n只消自看淩波影，更有何人比得卿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40181,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"奏记妆楼 其一","author":"孙原湘","text":"自迁楼阁可清宁，可怕高寒可睡醒。\n可想玉郎声息到，推窗悄倚画屏听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40182,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"奏记妆楼 其二","author":"孙原湘","text":"平时行近绣帘前，一笑双眸语早传。\n今日怕掀帘子看，隔层楼似隔层天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40183,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"奏记妆楼 其三","author":"孙原湘","text":"听得鹦哥唤客不，屧声已到玉梯头。\n心嫌女伴私猜料，只说看花偶下楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40184,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"初夏","author":"孙原湘","text":"绿阴浓染合欢床，花里潜踪入洞房。\n幽怨襟情难细语，转疑滋味胜初尝。\n不知金钿何时落，谁识罗裙别有香。\n道是分明原是梦，风光瞥去耐思量。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40185,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"牡丹下宴集 其一","author":"孙原湘","text":"锦幛围云五色齐，入窗都展绿玻瓈。\n名花一种春无赛，却见倾城首亦低。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40186,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"牡丹下宴集 其二","author":"孙原湘","text":"斜背花枝坐绿纱，恐花羞见面如霞。\n反教夺尽花颜色，人对花来不看花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40187,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"牡丹下宴集 其三","author":"孙原湘","text":"女伴藏钩赌玉杯，聪明十度九赢回。\n就中偏是郎心湣，却费沉吟半晌猜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40188,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"牡丹下宴集 其四","author":"孙原湘","text":"郎拈梅子出花阴，剥赠梅仁示意深。\n故把玉纤摩弄久，教伊知道会伊心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40189,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"牡丹下宴集 其五","author":"孙原湘","text":"席罢香舆散画阑，感卿花下独来看。\n比肩立尽斜阳影，相见非难别总难。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40190,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"记忆即书 其一","author":"孙原湘","text":"社鼓喧喧殷六街，东风摇荡画帘斜。\n万花丛里偷眸看，始信梅花第一花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40191,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"记忆即书 其二","author":"孙原湘","text":"一闪横波抵万金，乍掀帘已见芳心。\n瓜犀赠自掺掺手，情比当年掷果深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40192,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"记忆即书 其三","author":"孙原湘","text":"闻郎声息翠帘开，连日潜踪著意猜。\n知道袖中藏数字，百方图便近身来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40193,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"记忆即书 其四","author":"孙原湘","text":"待来何事却来迟，已近花阴月上时。\n口自怨郎心自喜，暗中情味没人知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40194,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"记忆即书 其五","author":"孙原湘","text":"病中消息恣窥觇，悄揭罗帏按玉纤。\n平日未容亲近处，今朝不道尽无嫌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40195,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"记忆即书 其六","author":"孙原湘","text":"投琼斗叶两无猜，众里横波不肯抬。\n挨到上灯移坐近，一钩新月暗钩来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40196,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"记忆即书 其七","author":"孙原湘","text":"盈盈绿水出芙蕖，娇韵才如二十馀。\n昨日女儿相并立，风情翻较阿娘输。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40197,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"记忆即书 其八","author":"孙原湘","text":"临别贪看月下姿，黄昏风露下阶迟。\n知郎尚有流连意，特向明蟾立片时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40198,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"记忆即书 其九","author":"孙原湘","text":"心性年来倍耐愁，沉潜声影坐楼头。\n轻风任墼帘钩响，不是郎来不下楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40199,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"记忆即书 其十","author":"孙原湘","text":"此生百念已灰寒，薄倖休疑会合难。\n剩有丹诚心一点，可怜无计剖君看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40200,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"曲房","author":"孙原湘","text":"青桐一树瘦摇凉，最密帘栊最后房。\n细雨暗催眉黛绿，晚风微度鬓花香。\n悄闻步屧推屏起，略近妆台触瑟忙。\n一种乍尝惊颤味，清宵归卧细思量。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40201,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"释炻","author":"孙原湘","text":"寒暄数语出金堂，一字无由漏隐肠。\n越是空来情越好，当时容易转寻常。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40202,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]