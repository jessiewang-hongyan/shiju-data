n":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25298,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐 其一","author":"赵我佩","text":"鱼沉雁杳。\n没个平安报。\n门外落花愁不扫。\n春恨知它多少。\n高楼才捲帘栊。\n远山如画眉峰。\n目断暮云千里，谁传锦字缄封。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25299,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐 其二","author":"赵我佩","text":"一声柔橹。\n人去垂杨渡。\n苦雨连绵听不住。\n做出凄迷情绪。\n故园梅子黄时。\n天涯远梦谁知。\n寄语画梁双燕，为侬衔去相思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25300,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 其一 寄外","author":"赵我佩","text":"人去也，人去短长亭。\n却向君前佯忍泪，不因别后始关情。\n无计阻征程。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25301,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 其二 寄外","author":"赵我佩","text":"人去也，人去费叮咛。\n推枕梦回茅店月，束装风急酒旗亭。\n珍重晓寒生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25302,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 其三 寄外","author":"赵我佩","text":"人去也，人去驿迢遥。\n曲曲琴心弦上语，斑斑情泪镜中潮。\n谁寄与红绡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25303,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 其四 寄外","author":"赵我佩","text":"人去也，人去梦难成。\n绣被春寒常倚枕，画屏香冷懒调笙。\n镇日数行程。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25304,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 其五 寄外","author":"赵我佩","text":"人去也，人去怯凭栏。\n淡墨名题期蕊榜，软红尘涴卸雕鞍。\n梦直到长安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25305,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 其六 寄外","author":"赵我佩","text":"人去也，人去忒无聊。\n夜月怕窥罗幌冷，晓妆愁煞远山遥。\n心事两眉梢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25306,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 其七 寄外","author":"赵我佩","text":"人去也，人去掩重门。\n红蜡泪乾因惜别，玉台尘暗最销魂。\n新月又黄昏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25307,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 其八 寄外","author":"赵我佩","text":"人去也，人去几时归。\n容易风霜吹木叶，只愁清瘦减腰围。\n谁与授寒衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25308,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉太平 其一 西湖泛月","author":"赵我佩","text":"莲房露倾。\n花窗月明。\n棹歌声起渔汀。\n唤鸳鸯梦醒。\n乌篷画舲。\n帘钩水晶。\n隔船初见云英。\n听轻弹玉筝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25309,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉太平 其二 西湖泛月","author":"赵我佩","text":"山光黛浮。\n帘波月流。\n画桡惊起沙鸥。\n笑先侬白头。\n哀蝉咽秋。\n吟蛩絮愁。\n旧游如梦难留。\n冷花滩钓舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25310,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 其一 题陆芝仙女士《倩影楼稿》","author":"赵我佩","text":"鬓影感华年。\n香冷蝉钿。\n旧游如梦梦如烟。\n可惜咏花人不见，泪洒情天。\n怨海恨难填。\n絮果谁怜。\n春蚕抵死尚缠绵。\n安得吴刚修月斧，月再团圆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25311,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 其二 题陆芝仙女士《倩影楼稿》","author":"赵我佩","text":"春雨抱愁眠。\n瘦削吟肩。\n回文载入衍波笺。\n羡煞扫眉才子笔，妙句金荃。\n断梦落谁边。\n倩影楼前。\n我来刚是熟梅天。\n怪底碧城云样远，飞去词仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25312,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 其一","author":"赵我佩","text":"乍试征帆二月天。\n故乡回首梦如烟。\n蓬窗人倦倚愁眠。\n蘸眼轻波迷鸭绿，举头新月欠蟾圆。\n诗筒欲寄倩谁传。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25313,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 其二","author":"赵我佩","text":"芳草无言绕画桥。\n年年绿遍旧裙腰。\n有斜阳处最魂销。\n玉笛倦吹金缕曲，春风愁送木兰桡。\n西湖别后恐无聊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25314,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉红妆 其一","author":"赵我佩","text":"帘波如水篆烟浮。\n挂垂杨，月一钩。\n东风吹梦过红楼。\n空冷落，旧香篝。\n别来情绪似伤秋。\n恨无计，解眉头。\n心太玲珑人太瘦。\n禁不起，许多愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25315,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉红妆 其二","author":"赵我佩","text":"近来憔悴不胜怜。\n薄罗裳，瘦削肩。\n撩人春色困人天。\n娇睡醒，尚思眠。\n晚妆无力整花钿。\n凤钗溜，髻云偏。\n弓样眉儿眉样月。\n知何日，是团圆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25316,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 其一","author":"赵我佩","text":"翠掩螺屏别梦残。\n罗衣香褪怯新寒。\n倚栏无语泪偷弹。\n鬓样春云眉样月，神如秋水气如兰。\n教人那不忆珊珊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25317,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 其二","author":"赵我佩","text":"斗草归来拾翠钿。\n日长深院罢秋千。\n绣床斜倚只思眠。\n流水光阴春似梦，落花时节雨如烟。\n十分无赖困人天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25318,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减兰 其一 题《梦云楼词》","author":"赵我佩","text":"花生梦笔。\n麝墨纵横新玉册。\n名士才华。\n百幅琳琅写韵纱。\n西泠感旧。\n第一魂销桥畔柳。\n谱入乌丝。\n春水当年绝妙词。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25319,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减兰 其二 题《梦云楼词》","author":"赵我佩","text":"酒边弹剑。\n青粉旗亭红粉店。\n檀板新腔，十五盈盈唱谢娘。\n梦云千叠。\n纸帐罗浮飞倦蝶。\n玉照词人，淡到梅花韵绝尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25320,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐 其一","author":"赵我佩","text":"愔愔院宇。\n愁听红鹦语。\n解事东风吹梦去。\n飞入谢庭深处。\n玉人娇睡银屏。\n侍儿密下帘旌。\n忘却香添翠被，醒来半臂凉生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25321,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]