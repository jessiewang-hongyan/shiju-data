[{"title":"鹧鸪天","author":"袁绶","text":"三载京华误守株。\n冯暖依旧食无鱼。\n貂裘已敞黄金尽，风雪迎人返故庐。\n才息影，又饥驱。\n归迟别速怨征车。\n欲将眠食殷勤嘱，生恐啼痕染客裾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25252,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"袁绶","text":"翠禽啼破相思梦。\n红蕤一角鲛珠冻。\n好梦耐寻思。\n生怜入梦时。\n梨云容易散。\n不管柔肠断。\n强起试妆迟，眉愁怕镜知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25253,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水龙吟 题联司马夫人遗诏","author":"袁绶","text":"兰因絮果茫茫，丹青留得昙花影。\n低鬟凝睇，弄珠无语，内家妆靓。\n见说当时，天孙下嫁，璇宫春永。\n羡比肩灵匹，画眉佳偶，期白首、双栖稳。\n惆怅彩云易散。\n證香盟、神伤荀令。\n天人标格，春游曾见，披图重认。\n钗凤分飞，镜鸾孤舞，情天难问。\n料红楼碧落，云魂月梦，盼青禽信。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25254,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 题蛱蝶图","author":"袁绶","text":"凤子低飞芳草径。\n一碧阴阴，软衬苔痕润。\n露浥风翻香梦冷。\n六朝馀韵黏金粉。\n点笔吟窗添画景。\n绿僽红僝，花事成销凝。\n不管春酲慵未醒。\n向人舞倦翩跹影。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25255,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"步蟾宫 秋夜不寐，有怀黛华姊","author":"袁绶","text":"珠帘绣闼人声悄。\n任落叶、满阶慵扫。\n西风飒飒雨潇潇，更添起、离愁多少。\n屏山倚遍闲情绕。\n问谁识、此时怀抱。\n梦中刚是话分携，却又被、花冠催觉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25256,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"金缕曲 送外","author":"袁绶","text":"垂老何堪别。\n况迢迢、闽南冀北，山川重叠。\n十万腰缠同转饷，又值炎威酷裂。\n早梦绕、玉京瑶阙。\n输与闲鸥眠浪稳，叹劳生、销尽轮蹄铁。\n漫青镜、添华发。\n催归莫负鹃啼切。\n更谁怜、伤贫念远，寸肠千结。\n看碧成朱还自笑，常恐福因才折。\n容易过、好春时节。\n说与旁人浑未省，待宵来、细诉多情月。\n凝望处，碧天阔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25257,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 暮春","author":"袁绶","text":"蝶粉犹酣，莺声渐老。\n碧云望断鱼书杳。\n连宵有梦踏莎行，柔魂绿遍池塘草。\n伫月林深，题钩石巧。\n堕红糁径无人扫。\n归来倦倚茜纱窗，博山香炉馀烟袅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25258,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"相见欢","author":"袁绶","text":"隔花清漏沉沉。\n又三更。\n只恐夜寒指冷、罢调笙。\n庭月满。\n帘慵卷。\n雁声声。\n知否有人欹枕、梦难成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25259,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南好","author":"袁绶","text":"人别后，又是探梅时。\n风送归鸦栖不定，阿谁花底掩双扉。\n惊起翠禽啼。\n深院静，帘卷辟寒犀。\n羌笛数声吹梦断，屏山一角玉蟾低。\n冷露湿苔衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25260,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 其二","author":"关锳","text":"长相忆，正月十三时。\n记得去年今日事，半窗灯影两人儿。\n一个画乌丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25261,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 其三","author":"关锳","text":"长相忆，欲写锦书迟。\n几个伤心眠又减，一春无病瘦难医。\n欲说又瞒伊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25262,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 其四","author":"关锳","text":"长相忆，心上数归鞍。\n一角荒城三点塔，半帆秋水四围山。\n划满碧阑干。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25263,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 其五","author":"关锳","text":"长相忆，对影自徘徊。\n安镜从无台不用，行船那见水分开。\n不信问瑶钗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25264,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 其六","author":"关锳","text":"长相忆，相忆在河干。\n过尽归舟人不见，晚潮初落柳毵毵。\n何处望江南。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25265,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其一","author":"关锳","text":"晚烟漠漠帆如织。\n隔林几点疏灯出。\n一乌下蘋洲。\n乱山相对愁。\n孤蓬团野色。\n到此归心极。\n烟水望中宽。\n替伊鸥鹭寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25266,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 其二","author":"关锳","text":"白蘋多处人争渡。\n一痕青见西陵树。\n随意夕阳明。\n渡江闻雁声。\n凄凉人散后。\n几点鸦争柳。\n浅水画桥横。\n可怜潮自生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25267,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 其三 春日寄怀纫兰妹许庭珠林风","author":"李佩金","text":"怜君憔悴天涯远，努力加餐。\n且自寻欢。\n无恙湖山待尔还。\n昨闻青鸟传来信，总在秋闲。\n准拟归船。\n望得盈盈眼欲穿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25268,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 其四 春日寄怀纫兰妹许庭珠林风","author":"李佩金","text":"天涯消息经春断，知否于归。\n还是家居。\n细数邮签紨远书。\n自从俗事关心后，诗思粗疏。\n心血都枯。\n婉转轮肠一字无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25269,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令 其一 分题作","author":"翁瑞恩","text":"星。\n银汉西斜点点明。\n流莺过，一样照空庭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25270,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令 其二 分题作","author":"翁瑞恩","text":"云。\n薄似轻罗剪水纹。\n微皴处，新月露眉痕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25271,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令 其三 分题作","author":"翁瑞恩","text":"溪。\n欸乃声声泛绿漪。\n桃源路，前度可曾迷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25272,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令 其四 分题作","author":"翁瑞恩","text":"山。\n晓起开门雪里看。\n苍松影，装点翠云鬟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25273,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令 其五 分题作","author":"翁瑞恩","text":"欢。\n久别方知会面难。\n今宵饮，倾盏径须乾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25274,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令 其六 分题作","author":"翁瑞恩","text":"愁。\n细雨黄昏独倚楼。\n无情绪，随又上眉头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25275,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令 其七 分题作","author":"翁瑞恩","text":"鱼。\n织水梭痕约略如。\n从流上，传得故人书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25276,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令 其八 分题作","author":"翁瑞恩","text":"虫。\n露冷阶前泣晓风。\n凄凄语，商略过残冬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25277,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 其一 题刘彦清农部“古红梅阁图”","author":"翁瑞恩","text":"红梅阁，殿直昔幽栖。\n逋老却输仙眷挈，侍儿曾记小名题。\n曲巷在桥西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25278,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 其二 题刘彦清农部“古红梅阁图”","author":"翁瑞恩","text":"红梅阁，小住惬平生。\n词客彩毫工觅句，美人黄土尚多情。\n梦也忒分明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25279,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 其三 题刘彦清农部“古红梅阁图”","author":"翁瑞恩","text":"红梅阁，画里唤真真。\n棐几添香清有韵，雕阑倚袖净无尘。\n古艳此传神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25280,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 其四 题刘彦清农部“古红梅阁图”","author":"翁瑞恩","text":"红梅阁，往事与谁谈。\n响屐不堪寻旧径，桃花并恐失空庵。\n何处望江南。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25281,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"眼儿媚 其一 雨窗即事","author":"张令仪","text":"料峭轻寒不卷帘。\n细雨压重檐。\n莺慵燕弱，花欹柳软，特煞堪怜。\n替花愁绝花知否，空自锁眉尖。\n天应入梦，人如中酒，常则恹恹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25282,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"眼儿媚 其二 雨窗即事","author":"张令仪","text":"一片重阴锁画楼。\n凤冷杏花愁。\n啼妆不整，残魂欲谢，断送春休。\n断肠人怕多情久，只合闭双眸。\n散去还来，浑如有物，横在心头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25283,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 其一 冬夜偶成","author":"张令仪","text":"炉烟茗碗。\n小坐摊书烧烛短。\n秋老无声。\n树影清癯月转明。\n啼蛩几许。\n絮语床头和弱女。\n独拥寒衾。\n倦影难支夜气侵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25284,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令 其一 步梅村先生韵","author":"张令仪","text":"斗草看花兴懒。\n幽思聊凭湘管。\n检点一春闲，付与吟笺茗碗。\n风卷。\n风卷。\n愁煞绿欹红软。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":25285,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令 其二 步梅村先生韵","author":"张令仪","text":"客路远如天上。\n空倚层楼凝望。\n柳色绿阴阴，浓抵春江晴浪。\n小恙。\n小恙。\n瘦尽春前模样。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","