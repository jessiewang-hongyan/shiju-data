[{"title":"点绛唇 春暮","author":"徐应坤","text":"绿渐成阴，春光九十都虚度。\n落红如雨。\n阵阵随风去。\n蝶少蜂稀，紫燕频频语。\n春何处。\n恼人情绪。\n青草斜阳路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23167,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇","author":"徐应坤","text":"妾命如斯，妾心如醉愁如寄。\n问愁不语。\n愁到何时去。\n十载惊魂，愁也知何许。\n心碎矣。\n可怜梦里。\n清泪浑如雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23168,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 闺怨","author":"徐应坤","text":"螺髻慵梳，双眉镇日为谁扫。\n离怀未了。\n羞听莺声小。\n谱就新词，又合阳关调。\n春光少。\n愁肠暗抱。\n辜负红颜老。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23169,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 咏杨花","author":"徐应坤","text":"何处飘来，窗前帘外深深舞。\n凭风无语。\n又入邻家去。\n曲径长堤，曾号风流树。\n春无主。\n行云卓午。\n下阵黄梅雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23170,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梦江南","author":"徐应坤","text":"深夜雨，做作已凉天。\n有雁冲寒云影外，个人剪烛雨窗前。\n长夜不成眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23171,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梦江南","author":"徐应坤","text":"深夜雨，滴滴更潇潇。\n绣阁灯残人影瘦，罗帏香冷梦魂消。\n寒结一庭蕉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23172,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 元宵夜雨","author":"徐应坤","text":"门外又黄昏。\n望断前村。\n愁云不放月华明。\n火树银花光暗淡，雨打风倾。\n结伴踏红灯。\n没甚心情。\n凤楼何处奏瑶笙。\n试数罗衣无限泪，半是思亲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23173,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沁园春 题夫子小照","author":"徐应坤","text":"烟柳低迷，鹤唳猿啼，怪矣先生。\n笑衣冠不整，扁舟欲渡，俯观鲛室，仰啸苍冥。\n日月纵横，乾坤浩荡，谁更昏昏谁更醒。\n长江里，纵波涛拍岸，稳坐休惊。\n翛然把酒孤斟。\n且莫怨、青袍误此身。\n有山川秀色，时堪娱目，性灵佳句，尽可陶情。\n莫问东吴，何分西楚，斜挂征帆缓缓行。\n前途邈，待风云万里，任意寻春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23174,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"捣练子 春日即事","author":"李淑照","text":"桃似锦，柳如绵。\n莺语初停蝶翅闲。\n妨却绣窗多少事，频抛针黹到花前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23175,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"捣练子 次大姊秋日即景韵","author":"李淑慧","text":"秋日短，绣帘垂。\n减线光阴着意催。\n春色未来秋色老，菊花莫绣绣寒梅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23176,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 寄雨船兄","author":"高荣","text":"闺思切，空使梦魂劳。\n可是地荒偏少雁，其如河广不容刀。\n想念到今朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23177,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 同嫂氏过绿雪山房感赋","author":"高縏","text":"山房里，往事足追寻。\n晓阁校书同问字，午窗斗茗罢拈针。\n一局向花阴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23178,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南","author":"高縏","text":"山房里，此日总伤神。\n门闭秋千空挂月，香埋金粉遍生尘。\n憔悴昔年人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23179,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"二郎神 次答嫂氏寄怀原韵","author":"高縏","text":"一声杜宇，早叫破、绿窗人静。\n度永日如年，残春如梦。\n归尽江村雁影，独有离怀难消遣，便说煞、有谁能省。\n将兔颖蘸酣，云笺书破，怎传幽恨。\n■凝。\n何期忽到，天涯芳信。\n把往事闲吟，离情细数，知我年来瘦损。\n玉露啼花，海棠困雨，多少泪珠红沁。\n最苦是、两地思量，间阻不教愁醒。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23180,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 题叶小庚本事词后   见谢章铤《赌棋山庄词话》","author":"姚雪初","text":"天籁韵珊珊。\n顾曲馀闲。\n乌丝小字写香奁。\n千古风流千古恨，留在人间。\n空自说辛酸。\n无限情缘。\n痴儿娇女忒缠绵。\n天下有情天上月，那得常圆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23181,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"珍珠帘","author":"黄藻修","text":"二分明月琼花映。\n听啼乌、宵枕唤将梦醒。\n谁拨玉炉灰，烟袅钗头冷。\n钗冷愁生新白发，卅九年、伴残妆镜。\n谁信。\n似逝水无情，残花风引。\n回首绣幕金奁，救飞蛾、剔落灯花红烬。\n梁燕绕无踪，怅冻云寒凝。\n试问玉埋何处也，寄愁吟、古台秋井。\n寂静。\n忆一曲游仙，数声清磐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23182,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙 变调，送何撷云女史北上   见孙兆溎《花笺录》","author":"吴芳珍","text":"只恨订交晚。\n蕙兰气质，鸾凤神情。\n更堪羡、名姝国士相并。\n心钦。\n是前缘定，苔岑合，第一知音。\n贻新句，愧玉温花馥，褒锡平生。\n销魂。\n分离太易，骊唱愁听声声。\n况秾花如寝，春水方盈。\n丁宁。\n记同心约，鳞鸿便，问讯须频。\n江南好，正绮窗梅放，偕我思君。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23183,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"金缕曲 寄素乡姊","author":"程端颖","text":"欲见无由计。\n忆归来、一旬话旧，许多情意。\n细数离愁千万缕，语语相怜到底。\n有几个、如君知己。\n怪煞流光容易过，又无端、判袂销魂地。\n写不尽，别离味。\n顿教枨触愁无际。\n料今番、吟馀绣倦，一般幽思。\n最是不堪风雨夜，倚枕乍凉天气。\n隔咫尺、天涯千里。\n剩有诗魂飞不定，梦迢迢、暗把情丝系。\n算只有，恨无已。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23184,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一点春 藕丝   见况周颐《词钞》","author":"冒俊","text":"一弯西子臂，七窍比干心。\n美人烈士情无限，馀绪缠绵自古今。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23185,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"张素秋","text":"风前别泪淹红袖。\n秋来人比黄花瘦。\n几日过重阳，离人易断肠。\n暮云空漾碧。\n征雁飞鸣急。\n何处寄相思，长亭柳万丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23186,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"惜余春慢 芍药开时忆丰台女子曼殊   见陈作霖《国朝金陵词钞》","author":"戴恭人","text":"焚尾花繁，曼殊仙迹，丰台春色如许。\n红遮香径，碧绕阑干，当日娇柔堪拟。\n想一代词人，千秋佳丽。\n消受最怜伊，吟肩试倚。\n翠巾新拭，绣窗闲语，悄鬟低、犹堪追忆。\n天与艳才如此。\n姗姗月下徘徊，露冷苔黏，钗横佩坠。\n任从他、满目风光，总被杜鹃催去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23187,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 集句","author":"戴恭人","text":"隔得卢家白玉堂。\n好风吹树杏花香。\n共怜时世减梳妆。\n燕子不来春寂寂，残灯无焰影幢幢。\n五更钟后更回肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23188,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"谢秋娘 夜坐","author":"盛氏（盛进士女","text":"清夜坐，独与月相亲。\n听彻梅花人不见，烧残瑞脑漏初沉。\n何事惹愁深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23189,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"天仙子","author":"盛氏（盛进士女","text":"昨夜琼筵频劝酒。\n强起罗帏薰翠袖。\n晓窗斜日照梳头。\n花影瘦，人影瘦，瘦得腰儿难似旧。\n满树绯桃沾碧甃。\n几个黄鹂啼绿柳。\n一春芳信颇匆匆。\n卿莫负，侬莫负，好把双箫花下奏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23190,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤凰台上忆吹箫 闺怨集药名","author":"盛氏（盛进士女","text":"菱鉴空青，蟾酥半缺，绮疏深掩葳蕤。\n喜朱砂印臂，青黛匀眉。\n慵续断肠诗句。\n检旧奁、败扇频题。\n相思甚、抛残梳篦，蹙损诃梨。\n遥想云母帐前，珍珠帘畔，琥珀床西。\n剩牡丹雨浸，豆蔻香披。\n怕踏落红花径，琼阶滑、石齿痕欹。\n铅泪滴、春愁五倍，嘱咐辛夷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23191,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"金雀鬟 闺情","author":"吉珠","text":"庭院春深好。\n牡丹开遍了。\n不分是双鬟偷拗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23192,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春宵曲 送别","author":"吉珠","text":"鸭绿春波暖，莺黄柳色新。\n别路醉芳樽。\n送君南浦去、欲消魂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23193,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"劈瑶钗","author":"吉珠","text":"懒画眉。\n自颦眉。\n一晌相思一晌悲。\n昨夜梦郎郎似旧，携手醒来，无计挽郎衣。\n晓莺啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23194,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 寄远","author":"吉珠","text":"南天一雁飞无迹。\n美人斜背栏杆立。\n眉黛为君攒。\n暗将珠泪弹。\n佳期今是否。\n又绿楼头柳。\n待月拨银筝。\n谁人知我情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23195,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 闰六月初七","author":"吉珠","text":"遥情两两。\n盼到而今犹怅望。\n如此良宵。\n乌鹊南飞不架桥。\n金风玉露。\n辜负盈盈河汉女。\n迢递佳期。\n恐是仙家好别离。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23196,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"小桃红 题横波夫人画兰扇","author":"厉鹗","text":"秦淮不见翠双颦。\n摺扇香痕润。\n往事眉楼有谁问。\n墨花春。\n灵均旧怨都销尽。\n南朝艳粉，才人风韵，题咏到湘裙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23197,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题顾眉生画兰册","author":"彭孙遹","text":"无复当年弄墨辰，断纨影里认前尘。\n青溪画阁秋如水，写出芳兰竟体人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23198,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题夫人画兰","author":"朱彝尊","text":"眉楼人去笔床空，往事西州说谢公。\n犹有秦淮芳草色，轻纨匀染夕阳红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23199,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"荷叶杯 有所思","author":"陈沅","text":"自笑愁多欢少。\n痴了。\n底事倩传杯。\n酒一巡时肠九回。\n推不开。\n推不开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23200,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"转应曲 送人南还","author":"陈沅","text":"堤柳。\n堤柳。\n不系东行马首。\n空馀千缕秋霜。\n凝泪思君断肠。\n肠断。\n肠断。\n又听催归声唤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23201,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"丑奴儿令 梅花","author":"陈沅","text":"满溪绿涨春将去，马踏星沙。\n雨打梨花。\n又有香风透碧纱。\n声声羌笛吹杨柳，月映官衙。\n懒赋梅花。\n帘里人儿学唤茶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23202,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花","author":"寇湄","text":"眉淡衫轻春思乱。\n不怪无情，翻受多情绊。\n怕上层楼凝望眼。\n落花飞絮终朝见。\n钗凤暗敲双股断。\n划损雕栏，一一相思遍。\n香袅兽炉空作篆，荼縻开谢闲庭院。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23203,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"齐天乐 夏日","author":"寇湄","text":"画楼高处蝉嘶柳，几曲危栏同倚。\n映日冰心，迎风雪态，清彻香肌无暑。\n南窗雨洗。\n乍云隐轻雷，晚凉如水。\n扇引合欢，斜侵明月枕初欹。\n闲庭起来携手，渐黄昏院落，明河低坠。\n浴罢妆残，钗偏髻堕，雨点春山馀翠。\n轻绡卸体。\n怕一搦烟轻，不禁清吹。\n簟展湘纹，别有一腔秋思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23204,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满庭芳 留别无瑕词史   见汤漱玉《玉台画史》","author":"柳是","text":"紫燕翻风，青梅带雨，共寻芳草啼痕。\n明知此会，不得久殷勤。\n约略别离时候，绿杨外、多少销魂。\n重提起、泪盈红袖，未说两三分。\n纷纷。\n从去后，瘦憎玉镜，宽损罗裙。\n念飘零何处，烟水相闻。\n欲梦故人憔悴，依稀只隔楚山云。\n无非是、怨花伤柳，一样怕黄昏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23205,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 寄姊","author":"张阿钱","text":"离怀谁诉。\n手摘莲花心自苦。\n别恨还多。\n长日无心画翠蛾。\n绮窗自省。\n蝴蝶蹁跹交扑影。\n寄语闺妆。\n不独薰风断我肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23206,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 冬闺","author":"张阿钱","text":"酸风冷坑催人起。\n六花乱撒香闺里。\n阵阵打房檐。\n愁心不敢嫌。\n临妆呵素手。\n梅蕊还依旧。\n插向鬓边斜。\n丰姿争似他。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23207,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇","author":"顾信芳","text":"天淡云闲，雨馀芳草平如剪。\n柳腰低软。\n春色和烟远。\n斜日西楼，人倚东风倦。\n莺声懒。\n一庭花片。\n绿满香痕浅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23208,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇","author":"顾信芳","text":"雨过晴窗，参差花影和帘捲。\n袖罗寒浅。\n独立闲庭晚。\n新雁横空，天写秋云怨。\n斜阳岸。\n乱愁千点。\n落叶西风满。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23209,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"顾信芳","text":"一树清阴倚粉墙。\n雨馀小院淡斜阳。\n笛声掩抑似回肠。\n蟾影穿帘千点雪，玉魂和梦一丝香。\n残灯欲灺更凄凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23210,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"顾信芳","text":"凤髻梳成整翠钿。\n珊珊玉骨自生怜。\n未灰心事鹊炉烟。\n粉蝶带香迷晓雾，冰蚕萦茧怯春寒。\n惜花人老落花天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23211,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"顾信芳","text":"嫩绿新红映碧池。\n纤纤弱柳斗腰肢。\n一枝和恨寄相思。\n微雨燕归春寂寂，暖香花睡日迟迟。\n小楼人懒似游丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23212,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"顾信芳","text":"一雁横飞万里秋。\n西风人倚木兰舟。\n萧萧南浦碧云稠。\n肠是有情牵别恨，心因无蒂殢离愁。\n夕阳影里凭危楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23213,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"顾信芳","text":"春云剪剪春烟薄。\n春归无计留春著。\n独立小桥风。\n飞花满袖红。\n鳞鸿乡信断。\n离梦天涯远。\n芳草绿罗裙。\n雨痕和泪痕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23214,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"顾信芳","text":"秋声飒飒惊秋睡。\n凄凉玉骨空憔悴。\n金鸭暖沉烟。\n晚妆匀翠钿。\n隔篱黄菊绽。\n花与人俱淡。\n风雨又重阳。\n画楼愁断肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23215,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐 九日忆汉求弟","author":"顾信芳","text":"一天秋瞑。\n人倚西风冷。\n愁折茱萸欹鬓影。\n数遍鳞鸿归信。\n是谁点缀秋光。\n陶篱菊吐新黄。\n料是登高游子，魂销客里重阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23216,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"念奴娇 题逸仙宋夫人瑶台宴杂剧","author":"顾信芳","text":"书空咄咄，向吟窗谱就，霓裳新阕。\n一点雄心消不尽，化作彩云千叠。\n滴粉搓酥，描香绘影，长吉心头血。\n步虚声里，泠泠似有仙骨。\n应是秋颖花生，墨池香润，照彻瑶台雪。\n放眼乾坤供一醉，醉把唾壶敲缺。\n鬼也揶揄，天乎懵懂，此意凭谁说。\n倚歌而和，欲将长笛吹裂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23217,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水龙吟 怀雪香季妹","author":"顾信芳","text":"瘦红庭院销魂，离心恰比梅心苦。\n无穷山色，无情杜宇，催人归去。\n前度分携，今番别恨。\n鬓霜千缕。\n更那堪、一抹裙腰芳草，又还认，来时路。\n依稀雁行联袂，忆曾向，啸台同步。\n篱外吹香，帘边伴影，素蟾初吐。\n何事多情，和天也妒，竟成睽阻。\n这相思、何日重来花底，对伊家诉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23218,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"捣练子","author":"顾信芳","text":"云漠漠，水溅溅。\n短棹夷犹破晓烟。\n疏柳断桥迷翠霭，一川风雨暮秋天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23219,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"顾信芳","text":"柳色销魂草带烟。\n点溪荷叶小如钱。\n画梁双燕舞翩翩。\n梦里好花空自惜，愁中春色若为怜。\n病馀无奈困人天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23220,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长相思","author":"彭孙婧","text":"闷悠悠。\n恨悠悠。\n何日花间共笑游。\n携手不胜愁。\n那堪忧。\n最堪忧。\n多情无计问扁舟。\n空逐水东流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23221,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长相思","author":"彭孙婧","text":"漏沉沉。\n睡沉沉。\n相思欲寄断肠吟。\n寂寞暗伤心。\n卧松阴。\n伴花阴。\n扫石焚香理素琴。\n花间月满林。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23222,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉蓬莱 苦雨，用叶少蕴上巳韵","author":"彭孙婧","text":"问天公何故，皎皎清光，将云遮去。\n风鹤频传，奈魂惊逆旅。\n种种愁怀，重重离恨，况连宵风雨。\n檐滴难休，馀寒犹峭，拥衾无语。\n回忆当年，乡关乍别，世态炎凉，人情如絮。\n今日重来，叹故居何处。\n临流怅望，水泛平堤，更烟迷前浦。\n虚负春光，因循误却，赏梅新句。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23223,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春从天上来 春绣","author":"鲍芳茜","text":"银管方休。\n见几点轻阴，飘漾帘头。\n炉香未息，花粉初浮。\n好个莺儿声溜。\n惜春光一线，任金线吊也难留。\n且抛愁，把窗纱笼上，翠影偏幽。\n困人是今天气，因懒向书翻，聊取针抽。\n芳渚一泓，锦鸯双睡，天工妙处难求。\n喜蕉滴碎心，这多时、不到南楼。\n俏鹦哥。\n竹枝弄月，叫挂金钩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23224,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"琼林第一枝 妆阁慰愁","author":"鲍芳茜","text":"蕉卷迎风，桐荫饰月，金炉一袅冉冉。\n画眉香黛初凝，握管锦毫浅染。\n春山何丽，同去把、镜儿细览。\n指纤纤、佳处轻描，那笔问卿无忝。\n才少匹、银河夜犯，运偏乖、灞亭秋惨。\n谁知柳汁衣侵，自尔宫花冠罨。\n英华叫绝，直推倒、王卢班范。\n妾笑撚、月窟香枝，先代嫦娥无毯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23225,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"绿头鸭 用司成流香阁韵同梅庄西湖春泛","author":"鲍芳茜","text":"挂红箫，荡波绿绉兰桡。\n起鸳鸯、睡乡初醒，勾留香渚银桥。\n看无尽、夭桃艳粉，描不出、脆柳宫腰。\n七字分题，一轮添韵，锦湖风月共逍遥。\n珠帘捲、拈花微笑，露出镜中娇。\n那怪得，风魔少伯，我也魂消。\n两峰高。\n青天外落，半空云起千条。\n山如黛、眉横浅印，裙似水、纹掬轻招。\n渔曲声流，禅灯影泻，晴晴雨雨尽良宵。\n馀更有、晓烟暮树，触处慰无聊。\n钱塘景，从今领取，去听江潮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23226,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梦江南 寄五妹刘何减","author":"李长宜","text":"家园好，花事说东皋。\n国色有人欺芍药，乡心昨夜寄樱桃。\n镜阁梦迢迢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23227,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 春闺","author":"李长宜","text":"叫彻黄鹂，难留住韶华片刻。\n垂杨如织。\n万缕伤心碧。\n春到愁生，春去愁无敌。\n人儿只。\n相思泪滴。\n点点啼鹃血。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23228,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]