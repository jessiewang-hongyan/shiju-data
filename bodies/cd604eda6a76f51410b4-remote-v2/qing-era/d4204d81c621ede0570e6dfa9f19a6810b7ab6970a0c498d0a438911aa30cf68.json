[{"title":"望江南 其十八 红桥春游词","author":"董元恺","text":"虹桥好，听曲和鸾箫。\n舞榭丝牵傀儡动，兰舟风送管弦遥。\n翠袖暗相招。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35303,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其十九 红桥春游词","author":"董元恺","text":"虹桥好，绕径印苍苔。\n纨扇慢摇遮鬓影，玉纤小摘落青梅。\n伫立共徘徊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35304,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其二十 红桥春游词","author":"董元恺","text":"虹桥好，懊恼是言归。\n好鸟啼春相唤住，浓花对酒欲争飞。\n客思正依依。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35305,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其二十一 青墩初夏词","author":"董元恺","text":"青墩好，别业号苍梧。\n万树浓荫含雾雨，满园空翠映菰蒲。\n一幅辋川图。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35306,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其二十二 青墩初夏词","author":"董元恺","text":"青墩好，四面一溪遥。\n丝缕风垂青捲幔，玻瓈水涨绿平桥。\n楼阁晕春潮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35307,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其二十三 青墩初夏词","author":"董元恺","text":"青墩好，一苇放中流。\n星渚频移天上坐，岸花飞送镜中游。\n诗酒任沉浮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35308,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其二十四 青墩初夏词","author":"董元恺","text":"青墩好，乐事胜花朝。\n旁舍煆泥载茉莉，小鬟敲竹护樱桃。\n长日尽逍遥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35309,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其二十五 青墩初夏词","author":"董元恺","text":"青墩好，曲院扇和风。\n玫瑰斜簪云鬓紫，蔷薇高架锦屏红。\n裁剪夺天工。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35310,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其二十六 青墩初夏词","author":"董元恺","text":"青墩好，绝胜浣花溪。\n绕砌翅翻蝴蝶舞，映山血染杜鹃啼。\n烟景忽凄迷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35311,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其二十七 青墩初夏词","author":"董元恺","text":"青墩好，趺坐荫休篁。\n种擅乌椑收柿叶，丝牵青蔓种菱塘。\n拂袖满幽香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35312,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其二十八 青墩初夏词","author":"董元恺","text":"青墩好，杖履入平芜。\n旧雨一枝鸠唤妇，新巢千尺鹤将雏。\n相劝倒琼苏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35313,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其二十九 青墩初夏词","author":"董元恺","text":"青墩好，对景且衔杯。\n粉节新涂抽紫箨，红盐初下摘青梅。\n怀抱一时开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35314,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其三十 青墩初夏词","author":"董元恺","text":"青墩好，荇藻积空明。\n跃入锦鳞堪上箸，网来文雉足调羹。\n肠断一声莺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35315,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潇湘神 其一 四女祠","author":"董元恺","text":"四女祠。\n四女祠。\n白发红颜未嫁时。\n但使宁亲成孝子，不愁天下少男儿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35316,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潇湘神 其二 四女祠","author":"董元恺","text":"杨柳枝。\n杨柳枝。\n碧瓦飘风散雨丝。\n一树棠梨春社后，千年留得几行诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35317,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"捣练子 其一 和内寄原韵","author":"董元恺","text":"愁脉脉，水盈盈。\n握手临歧无限情。\n揾着啼痕双袖泪，笑从花里送郎行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35318,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"捣练子 其二 和内寄原韵","author":"董元恺","text":"江树隔，岭云开。\n历尽东风未遣回。\n惆怅五更孤枕上，与卿刚在梦中来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35319,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"捣练子 其三 和内寄原韵","author":"董元恺","text":"消永夜，剔残缸。\n暖语分明向绮窗。\n留得别时千点泪，罗衣犹未浣春江。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35320,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"字字双 欢情","author":"董元恺","text":"一枝容膝安复安。\n金风玉露寒复寒。\n连呼侬字欢复欢。\n欢情如月看复看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35321,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆王孙 其一 江上","author":"董元恺","text":"一江江水阅兴亡。\n花月春江事渺茫。\n江上风吹雁两行。\n泪沾裳。\n江北江南总断肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35322,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆王孙 其二 小鬟捧茶","author":"董元恺","text":"二泉初汲碾旗枪。\n火沸松声路沁香。\n郑重双鬟手自将。\n敢先尝。\n春风滋味怯萧郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35323,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一叶落 秋忆","author":"董元恺","text":"一叶落。\n伤漂泊。\n寸心万里阑干角。\n天边望断鸿，枝头问灵鹊。\n问灵鹊。\n几度浑如昨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35324,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"转应曲 其一 送别","author":"董元恺","text":"相送。\n相送。\n门外远钟残梦。\n千山万水郎程。\n一夜五更月明。\n明月。\n明月。\n偏是照人离别。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35325,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"转应曲 其二 春闺","author":"董元恺","text":"双燕。\n双燕。\n春色衔来一片。\n爱伊画阁多情。\n打散枝头晓莺。\n莺晓。\n莺晓。\n又听子规啼早。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35326,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"如梦令 其一 梦后","author":"董元恺","text":"枝上啼鹃如诉。\n唤起离愁无数。\n曲径古云深，隔岸梦中来路。\n回顾。\n回顾。\n月约花阴西度。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35327,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"如梦令 其二 闺情，和李易安韵","author":"董元恺","text":"忽地披衣起坐。\n梦也分明真个。\n梦后更凄凉，生怕梦来难躲。\n无那。\n无那。\n守着影儿伴我。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35328,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"如梦令 其三 闺别，和王修微韵","author":"董元恺","text":"半枕别时残梦。\n一纸离愁新咏。\n昨夜月明中，几处小桥霜冻。\n相送。\n相送。\n泪湿轻衫寒重。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35329,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"归自谣 归梦","author":"董元恺","text":"东风急。\n携手罗帏情脉脉。\n分明悄语莺花夕。\n梦回依旧关山隔。\n空相忆。\n春云遮断春归迹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35330,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江怨 闺怨","author":"董元恺","text":"春云晚。\n妾泪朝朝长在眼。\n影动湘裙展。\n平湖绿水明如剪。\n难消遣。\n一夜正愁深，东风忽吹浅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35331,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"定西番 春暮，集唐词","author":"董元恺","text":"隐映画屏开处，莺对语，蝶飞狂。\n惜韶光。\n罗袂从风轻举，波影满池塘。\n高捲水晶帘额，衬斜阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35332,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长相思 其一 闺忆","author":"董元恺","text":"梅花风。\n楝花风。\n二十四番花信风。\n花开花落中。\n吴江东。\n楚江东。\n潮落春江东复东。\n春魂一点通。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35333,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长相思 其二 闺忆","author":"董元恺","text":"晓云峰。\n暮云峰。\n郎处云深第几峰。\n愁来簇两峰。\n水连空。\n月横空。\n刚得相逢总是空。\n相逢怕梦中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35334,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"相见欢 鸳鸯","author":"董元恺","text":"珍禽两两回翔。\n狎芳塘。\n惹得多情儿女，绣罗裳。\n嗔伊并，惊伊散，忽分行。\n刚到荷花深处，又双双。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35335,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望梅花 岭南至日，梅花盛开","author":"董元恺","text":"何事粤东无雪。\n万树垂垂先白。\n一线初添疏影夕。\n零乱冷烟残月。\n瘐岭经年驿使隔。\n谁寄江南消息。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35336,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉太平 其一 旧游","author":"董元恺","text":"红楼卧游。\n青楼梦游。\n旧游重倚楼头。\n捲东风上钩。\n春山欲浮。\n秋波欲流。\n妆成春影横秋。\n对花枝坐愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35337,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉太平 其二 花间","author":"董元恺","text":"花奴雁奴。\n花姑鼠姑。\n花间鸟唤提壶。\n倩花间酒沽。\n龙刍鹿庐。\n麟符象弧。\n酣来斫地歌呼。\n识人间故吾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35338,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉太平 其三 钱歌","author":"董元恺","text":"榆钱绿钱。\n苔钱碧钱。\n圆如锦石青钱。\n弄芙蕖小钱。\n流钱雨钱。\n连钱影钱。\n小斋夜落金钱。\n值东风几钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35339,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉太平 其四 钱歌","author":"董元恺","text":"郑钱沈钱。\n缗钱侧钱。\n诗书争似囊钱。\n看空囊一钱。\n床头百钱。\n杖头百钱。\n张公万选青钱。\n选刘公大钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35340,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"薄命女 其一 有约","author":"董元恺","text":"花阴悄。\n罗袜潜移芳径小。\n惊起枝头鸟。\n几遍画栏闲倚，无数心烟空袅。\n只恐星光天欲晓。\n旋把灯吹了。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35341,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"薄命女 其二 夜听捣衣声","author":"董元恺","text":"声凄切。\n一派清砧愁欲绝。\n万户秋光滴。\n远如繁筝响急，近似寒蛩低咽。\n梦断玉关无信息。\n思妇心偏结。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35342,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"生查子 其一 闺怨","author":"董元恺","text":"送郎上车轮，车远郎亦远。\n愿作车后尘，处处随郎转。\n郎行辙不归，妾泪不离眼。\n看取眼泪痕，与辙谁深浅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35343,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"生查子 其二 闺情，集唐诗","author":"董元恺","text":"欲试一寸心，试妾与君泪。\n寄向故园流，空望去时水。\n不消出门行，想君发扬子。\n错认几人船，日暮情何已。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35344,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"生查子 其三 闺情，集唐诗","author":"董元恺","text":"应为别离多，愁眠罗帐晓。\n是妾断肠时，谁知妾怀抱。\n娇郎痴若云，夜夜梦中到。\n春意罢帘栊，暗飞萤自照。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35345,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"生查子 其四 闺情，集唐诗","author":"董元恺","text":"悲妾似花身，能得几时好。\n空将泪见花，花落知多少。\n不复理残机，织锦心草草。\n频放剪刀声，双眉灯下扫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35346,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉公子 其一 闺情，集唐诗","author":"董元恺","text":"独坐裁新锦。\n天寒剪刀冷。\n方觉泪难裁。\n丹心一寸灰。\n晓卧半床月。\n月落子规歇。\n归在落花前。\n春风正可怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35347,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉公子 其二 闺情，集唐诗","author":"董元恺","text":"破得东风恨。\n畏人相借问。\n还恐是愁中。\n银床一半空。\n倘随明月去。\n月满门前路。\n犹有万重思。\n归心梦独知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35348,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉公子 其三 闺情，集唐诗","author":"董元恺","text":"落花相与恨。\n即是春风尽。\n不敢怨春风。\n细看枝上红。\n遥将一点泪。\n两处滴池水。\n池水晓来深。\n长悬零落心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35349,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉公子 其四 闺情，集唐诗","author":"董元恺","text":"袅袅城边柳。\n骀荡郎知否。\n争取最长条。\n相思一水遥。\n相思杳如梦。\n莫引西风动。\n剪蜡泪争流。\n残灯照卧幽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35350,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春光好 过沉香亭址","author":"董元恺","text":"荒亭北，夕阳空。\n晚烟笼。\n倾国名花何处，只春风。\n自是羽衣尘土，采蘋休怨楼东。\n一样梨花寒食夜，翠微中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35351,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝴蝶儿 本意，和唐人张泌韵","author":"董元恺","text":"蝴蝶儿。\n绣窗时。\n怪他轻薄上郎衣。\n停针试觑伊。\n且把罗巾扑，休教捉对飞。\n褪残香粉画胭脂。\n依然双翅垂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35352,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"昭君怨 昭君塞外命重制琵琶，曰浑不似","author":"董元恺","text":"莫谓汉宫人巧。\n便有琵琶难肖。\n毳帐草萧萧。\n梦魂遥。\n薄命玉容如此。\n值得一声情死。\n边月下祈连。\n影堪怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35353,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"太平时 闺怨","author":"董元恺","text":"宝瑟凄凉怨岁华。\n倚窗纱。\n个侬生性似杨花。\n逐风斜。\n忽听一声啼杜宇，自嗟呀。\n年年啼罢不还家。\n只天涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35354,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"抛球乐 美人蹴鞠","author":"董元恺","text":"香阁妆成约伴来。\n斜穿鞠域映楼台。\n红巾吹向红帮乱，波影轻摇鬓影开。\n猛被檀奴觑，潜匿花阴去不回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35355,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"女冠子 其一 登穹窿山，赠施鍊师","author":"董元恺","text":"穹窿飘渺。\n碧海三山瑶草。\n剑光寒。\n玉斧滋晴露，琼花护醮坛。\n灵随龙竹引，香逐凤箫残。\n隐现金天掌，是毫端。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35356,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"女冠子 其二 闺人礼佛","author":"董元恺","text":"宝莲幢畔。\n清晓纤纤频盥。\n到香台。\n唵叭随烟结，菩提带树开。\n粉痕侵贝叶，心字印炉灰。\n更把鹦哥教，念如来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35357,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉花间 其一 即事，拟毛文锡体","author":"董元恺","text":"休相近。\n还相近。\n相近低声问。\n昨夜梦中人，暗送横波认。\n情多不讳痴，爱极翻成恨。\n来朝怕别离，又把啼痕揾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35358,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉花间 其二 密怨","author":"董元恺","text":"莫相怨。\n频相见。\n相见何曾怨。\n一见一回眸，羞眤旁人面。\n波澜任枕衾，猜妒真欢恋。\n懊恼是春风，郎处春风便。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35359,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇 其一 春归","author":"董元恺","text":"杜宇年年，声声只唤春归去。\n春归何处。\n且把帘垂住。\n帘捲东风，春竟穿帘去。\n留难住。\n放春归去。\n来岁春来处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35360,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇 其二 闺人语燕，和李清照韵","author":"董元恺","text":"燕子双双，阿谁系得红丝缕。\n妆台衔去。\n落尽香泥雨。\n好向郎边，细语相思绪。\n归来处。\n潇湘烟水，珍重江南路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35361,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湿罗衣 雨中度茗岭","author":"董元恺","text":"盘盘石磴插天高。\n茫茫嶂海波涛。\n雾合芒鞋，云生缊袍。\n奔流飞涧千条。\n响层霄。\n光摇绿筱，香清紫笋，翠影迢遥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35362,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其一 春闺","author":"董元恺","text":"莺语听残春院晴。\n屏云倚其晚寒凝。\n黛痕愁入远峰青。\n庭满落花香寂寂，声和玉漏夜清清。\n轻红拂萝晓来醒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35363,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其二 回前调","author":"董元恺","text":"醒来晓梦拂红轻。\n清清夜漏玉和声。\n寂寂香花落满庭。\n青峰远入愁痕黛，凝寒晚共倚云屏。\n晴院春残听语莺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35364,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其三 春闺，集唐词","author":"董元恺","text":"绮陌春深翠袖香。\n水纹簟冷画屏凉。\n月窗花径梦悠飏。\n将见客时微掩敛，几回拼却又思量。\n此情谁会倚斜阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35365,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 闺情，集唐诗","author":"董元恺","text":"闲倚绣帘吹柳絮。\n已成残梦随君去。\n明月为谁圆。\n情教细语传。\n春风别有意。\n凭添两行泪。\n怅望此何时。\n只应君自知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35366,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卜算子 秋闺，集唐诗","author":"董元恺","text":"花点石榴裙，虫响灯光薄。\n心怯空房不忍归，风动秋千索。\n望月想蛾眉，菊露凄罗幕。\n几度金刀试剪裁，红泪双双落。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35367,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其一 浴温泉","author":"董元恺","text":"九龙汤沸。\n范阳水设鱼龙戏。\n洗罢奚儿。\n翻作奚儿洗马池。\n仓皇西幸。\n马嵬坡下长生竟。\n河水汤汤。\n南内无人有寿王。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35368,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其二 浴温泉","author":"董元恺","text":"夜深清影。\n芳草不生泉欲冷。\n绣岭花开。\n尽逐东流去不回。\n梨园按曲。\n羯鼓声中鼙鼓蹙。\n红粉成灰。\n村笛还吹阿滥堆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35369,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"巫山一段云 悼友","author":"董元恺","text":"雨洒空床笛，风号败壁琴。\n泉台一别信沉沉。\n肠断到而今。\n把酒魂应绝，题诗涕不禁。\n孤灯悄向梦中寻。\n路隔小窗阴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35370,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"诉衷情 金陵春望","author":"董元恺","text":"孝陵衰草下牛羊。\n春风绕建康。\n一片降帆过眼，短笛倚斜阳。\n君莫问，石头冈。\n寝园荒。\n铁锁沉沉，金凫寂寂，玉树茫茫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35371,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丑奴儿令 其一 别情","author":"董元恺","text":"匆匆帘影惊分处，蓦别萧郎。\n自别萧郎。\n风雨忧愁一半妨。\n从今谙禁愁滋味，总不思量。\n却又思量。\n日日车轮更转肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35372,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丑奴儿令 其二 美人对镜","author":"董元恺","text":"我似个人伊似我，伊自知愁。\n我更多愁。\n两颊啼痕一处留。\n春来总与伊同瘦，伊在眉头。\n我在心头。\n一点横波两处流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35373,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]