[{"title":"菩萨蛮  为友人题像","author":"陈维崧","text":"万山槲叶西风起，黛痕滴入衫痕里。\n砚匣净无尘，依稀陆子春。\n他时须献赋，细马朝天去。\n相映柳毵毵，宫娥报捲帘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34322,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 燕市赠相者","author":"陈维崧","text":"虎坊桥畔逢唐举，西风酌酒为君语。\n齃鼻与魋肩，何尝直一钱。\n浮云卿眼见，富贵非吾愿。\n酒尽拨三弦，狂歌菩萨蛮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34323,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮  为阎牛叟新纳姬人催妆二首 其一","author":"陈维崧","text":"悼亡才写菖蒲幅，定情又索消魂曲。\n淮估附书来，红椷和笑开。\n鹊桥填已久，侬是催妆手。\n老去漫情多，颠狂奈尔何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34324,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮  为阎牛叟新纳姬人催妆二首 其二","author":"陈维崧","text":"雕香刻翠飞琼像，多时供在妆楼上。\n拣个女如花，纤腰同拜他。\n白家蛮柳在，浅漾东风外。\n情绪惯瞒伊，欺他尚小时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34325,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 赠梁陶侣 棠村夫子小阮","author":"陈维崧","text":"邯郸年少春衫绿，鸣筝竞唱棠村曲。\n檀板鹧鸪天，丛台月正圆。\n谢公犹子在，才调空群辈。\n谁爱紫罗囊，书签玳瑁装。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34326,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子  送李云田之吴门迎侍儿扫镜二首 其一","author":"陈维崧","text":"一群荡子扬州住，帘底红牙。\n门畔金车，邀笛藏钩乐事赊。\n如何短李先辞我，云有吴娃。\n生小如花，日上江楼候客楂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34327,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子  送李云田之吴门迎侍儿扫镜二首 其二","author":"陈维崧","text":"我言息国夫人好，何不归哉。\n早到妆台，湘水今秋绿胜苔。\n君言聊复为欢耳，谜语应猜。\n庄语非诙，神物须知是手推。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34328,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 题画兰小册 其一 兰为横波夫人所绘","author":"陈维崧","text":"回思吮粉调铅日，紫菂缃芽。\n露蕊烟葩，压倒南唐落墨花。\n杜兰香去多时了，碎绵零纱。\n飘泊谁家，剩有眉楼小篆斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34329,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 题画兰小册 其二 兰为横波夫人所绘","author":"陈维崧","text":"后堂丝管亲曾醉，衮遍筝琶。\n舞煞蛮靴，百幅红兰出内家。\n左徒弟子今谁在。\n只有章华。\n沦落天涯，忍看灵均九畹华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34330,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子  题潘晓庵斗酒百篇小像","author":"陈维崧","text":"画师貌出高人态，梧竹澄鲜。\n庭户萧然，道是诗颠并酒颠。\n玉山百罚颓唐甚，醉汉琼筵。\n纱帽微偏，击唾壶歌宝剑篇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34331,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 正月二十日从吴天石处获读纬云弟京邸春词因和其韵声情拉杂百感风生一夕遂得十首不自知其所云也 其二","author":"陈维崧","text":"轻轻过了元宵也，春雪才融。\n零雨还濛，雨细如愁糁碧空。\n孤灯炙罢和衣睡，莫打晨钟。\n绣毂银骢，准拟今宵梦里逢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34332,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 正月二十日从吴天石处获读纬云弟京邸春词因和其韵声情拉杂百感风生一夕遂得十首不自知其所云也 其六","author":"陈维崧","text":"添丁屈指今三岁，未识而翁。\n睡去朦胧，耳畔呼耶语句工。\n关河梗绝书难达，何日相逢。\n绣褓亲缝，颠倒天吴短褐中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34333,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 正月二十日从吴天石处获读纬云弟京邸春词因和其韵声情拉杂百感风生一夕遂得十首不自知其所云也 其七","author":"陈维崧","text":"有人来自尚书墓，燕子楼中。\n红粉成空，树树衰杨夜起风。\n非公人尽嫌余懒，絮酒难从。\n疏散谁容，头白羊昙路已穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34334,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 正月二十日从吴天石处获读纬云弟京邸春词因和其韵声情拉杂百感风生一夕遂得十首不自知其所云也 其八","author":"陈维崧","text":"昨冬并说西樵死，送尽英雄。\n祇剩衰翁，寒日西颓贯白虹。\n从兹东海无奇气，鱼眼波红。\n鳌背霜浓，瑶岛琼台何处峰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34335,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 正月二十日从吴天石处获读纬云弟京邸春词因和其韵声情拉杂百感风生一夕遂得十首不自知其所云也 其九","author":"陈维崧","text":"年来怕作伤心句，双袖龙钟。\n左耳新聋，莫把箜篌唱懊侬。\n不如且作消愁计，卖药无终。\n鬻畚山东，自署人间亡是公。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34336,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 正月二十日从吴天石处获读纬云弟京邸春词因和其韵声情拉杂百感风生一夕遂得十首不自知其所云也 其十","author":"陈维崧","text":"今朝吾弟悬弧日，四十匆匆。\n谁荐扬雄，谒者监门孰与通。\n耦耕毕竟家山好，山黛初浓。\n杏靥才烘，迟汝风光一笑同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34337,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 吴门遇徐松之问我新词赋此以答","author":"陈维崧","text":"当时惯做销魂曲，南院花卿。\n北里杨琼，争谱香词上玉笙。\n如今纵有疏狂兴，花月前生。\n诗酒浮名，丈八琵琶拨不成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34338,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 其一 为汪蛟门舍人题画册十二帧","author":"陈维崧","text":"郁金堂后相思树，花月珑璁。\n庭院迷濛，凤胫兰膏潋滟红。\n双心一气沈香火，娇小乌龙。\n斜压薰笼，笑尔葡萄宝幔空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34339,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 其二 为汪蛟门舍人题画册十二帧","author":"陈维崧","text":"是何年少朝天客，火满东华。\n漏歇南衙，蝶梦才归尚恋花。\n麝衾兽炭团花褥，休数其他。\n一例豪奢，不是田家即窦家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34340,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 其三 为汪蛟门舍人题画册十二帧","author":"陈维崧","text":"八盘腻手香蝉委，红粉轻调。\n画的轻描，直得春魂为尔销。\n道书偏怪郎耽读，百幅霞绡。\n十斛龙膏，何必蓬山访碧桃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34341,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 其四 为汪蛟门舍人题画册十二帧","author":"陈维崧","text":"李皇周后年双小，玉树宫墙。\n金缕鞋帮，胆怯潜提出洞房。\n秣陵往事千年矣，如此疏狂。\n莫管兴亡，便破家山也不妨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34342,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 其五 为汪蛟门舍人题画册十二帧","author":"陈维崧","text":"金笼鹦鹉新来哑，柳样腰身。\n月样精神，小小房栊少四邻。\n只愁绕院千竿碧，戛触疏筠。\n断续停匀，几阵琤琮似有人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34343,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 其六 为汪蛟门舍人题画册十二帧","author":"陈维崧","text":"浪花槅子冰纹槛，绿沁肌肤。\n凉浸眉须，还有炎威半点无。\n水明楼上人梳裹，旁立鸦雏。\n秀鬋清矑，爱看荷盘泻露珠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34344,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 其七 为汪蛟门舍人题画册十二帧","author":"陈维崧","text":"苍松陡作金虬舞，似此云山。\n不像人间，嵓畔相逢吴綵鸾。\n情缘未了前尘在，扇子团圞。\n暗惜韶颜，饭罢胡麻趁早还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34345,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 其八 为汪蛟门舍人题画册十二帧","author":"陈维崧","text":"鹧鸪斑晕鸬鹚杓，玉润犀香。\n酒圣诗狂，浓淡屏山墨几行。\n牙签叠架粗于笋，蕃锦珠囊。\n宋榻唐装，也抵豪门笏满床。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34346,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 其九 为汪蛟门舍人题画册十二帧","author":"陈维崧","text":"红樱斗帐空如水，烟月罗罗。\n人到南柯，一片松涛枕畔过。\n雀翘蝉鬓端然坐，裙带微挼。\n纤指频呵，甚处巫云入梦多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34347,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 其十 为汪蛟门舍人题画册十二帧","author":"陈维崧","text":"簟纹绿暖玻璃皱，极望芙蕖。\n来往谁欤。\n风幔烟桡满太湖。\n琐儿不忿双栖鸭，波溅红襦。\n潮晕春酥，阿姊身边竟有夫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34348,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 其十一 为汪蛟门舍人题画册十二帧","author":"陈维崧","text":"搓酥滴粉瑶台侣，要使微赪。\n戏问幽情，眉黛全低恚旋成。\n红丝蝇拂拈来打，何事干卿。\n口语偏轻，薄怒徐回媚转生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34349,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 其十二 为汪蛟门舍人题画册十二帧","author":"陈维崧","text":"盈盈对坐翻经史，琳笈琼函。\n粉印脂钤，夜冷春葱下几签。\n在旁蜡烛能知状，茗苦香甜。\n月小风纤，咏絮才高笑撒盐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34350,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 上巳后一日途次洧川","author":"陈维崧","text":"花红草绿，昨日浓春经阮曲。\n碎雨零烟，今日愁人过洧川。\n三春去半，半付邮亭和驿馆。\n溱洧潺湲，上巳无人出采兰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34351,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 过惠山九华庵 系某氏废园","author":"陈维崧","text":"石蹲奇兽，兀奡玲珑真险秀。\n涧束春罗，窈窕空明足淡沲。\n閒庭谁到，只许碧空悬冷瀑。\n些事消魂，剩有秋千断板存。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34352,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花  酷暑马上口占","author":"陈维崧","text":"阳乌酣战，身似吴牛偏易喘。\n缓辔彷徨，我有田园万斛凉。\n桐廊茗汁，此事如今那可得。\n黄鸟多情，小店风潭啭一声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34353,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 题彭爰琴小像","author":"陈维崧","text":"隋宫丝管，曾醉倡家红玉椀。\n瘦马芦沟，又上燕姬卖酒楼。\n十年一别，往事濛濛那可说。\n画里逢君，同把扬州月色分。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34354,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花  题山阴何奕美小像","author":"陈维崧","text":"多年枯树，屈铁拗铜阴翠冱。\n野涧萧林，闲坐幽人抱膝吟。\n传家碧血，怕听子规啼夜月。\n莫便还乡，霸国山川冷夕阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34355,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 佐家为阎牛叟赋","author":"陈维崧","text":"鱼租雁税，健妇持门心力瘁。\n黾勉钱刀，助得男儿意气豪。\n家缘中落，轧轧机床拚织作。\n国士桥边，剩有萧萧冷砚田。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34356,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花  题恽南田为潘原白所画绛帻横秋图二首 其一","author":"陈维崧","text":"花冠粉距，昂首晴秋羞哙伍。\n恼杀诗翁，得失偏呶鸡与虫。\n乾坤夜黑，何日一鸣天下白。\n角角堪惊，总是秦关过客声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34357,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花  题恽南田为潘原白所画绛帻横秋图二首 其二","author":"陈维崧","text":"陈仓祠古，当日霸王全繫汝。\n丛桂天空，舐药还闻伴八公。\n而今老大，笑尔会稽鸡太哑。\n莫管昏晨，斯世谁为起舞人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34358,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"散馀霞 十六夜即景","author":"陈维崧","text":"昨宵皓月凉于粉，浸万家蝉鬓。\n花下几两车儿，翠盈盈偏稳。\n今夜红灯成阵，被雨丝淹尽。\n一只银鸭床头，镇厌厌春困。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34359,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"好事近 隔院听琵琶","author":"陈维崧","text":"拍遍小阑干，何限塞鸿明灭。\n老去怕逢节候，正落红时节。\n沙场病卒搯檀槽，隔著邻垣说。\n似诉少年陈事，有玉楼金埒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34360,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"好事近 丙辰早春得云间张洮侯寅冬所寄书","author":"陈维崧","text":"春水锦鳞通，忽把故人墨迹。\n一纸三年才到，讶红笺无色。\n当初高宴五茸城，尽江东裙屐。\n记得傀俄酒态，有琼筵醉客。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34361,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"好事近  食蟹忆南耕 时南耕以礼斗斋宿道院","author":"陈维崧","text":"溪友馈霜螯，细捣蛮姜慢吃。\n更听糟床细注，赏半窗晴碧。\n游仙今夜忆曹唐，正锁旌阳宅。\n料在醀坛深处，倚石床吹笛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34362,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渔父家风 赠梁溪赵叟","author":"陈维崧","text":"十年小阁自埋名，不爱卖丹青。\n随身并少林逋鹤，人比惠泉清。\n花一树，酒三升，了浮生。\n朝来微醉，拍手凭阑，雨后新晴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34363,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"琴调相思引  元夕后二日夜雨即事","author":"陈维崧","text":"绮陌将收五夜灯，后堂锁到第三层。\n画檐残烛，细雨恐难胜。\n歌板敲愁飞火凤，枕函贮梦结红冰。\n觉来还记，踏月六街曾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34364,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"误佳期 偶作","author":"陈维崧","text":"枕上春酲犹害，楼上东风偏大。\n金笼鹦鹉唤人来，忙出花阴外。\n不肯把箫吹，那便将花戴。\n脸波底事十分红，莫误将人怪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34365,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐  长至前五日适吴门诸子有填词社初集之举同集余澹心秋雪斋是夜风雨","author":"陈维崧","text":"关山如许，不醉卿何苦。\n酒泼鹅黄娇似乳，领受高斋夜雨。\n莫愁湿透芒鞋，道傍醉倒须埋。\n不见长洲苑里，年年落尽宫槐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34366,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐 友人以哭女诗见示作此以代写哀","author":"陈维崧","text":"红珠辞掌，絮果因风飏。\n跌碎菱花楼上响，人与舞鸾同往。\n昨宵粉壁金闺，今宵孤冢棠梨。\n思子台前月落，女坟湖畔鸦啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34367,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐  夜饮友人别馆听年少弹三弦限韵三首 其一","author":"陈维崧","text":"夜香烧罢，桦烛通宵话。\n曲项檀槽声不哑，银甲凭伊搯打。\n只图慢撚轻笼，谁怜双袖龙钟。\n少日红筝北里，年来白发西风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34368,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐  夜饮友人别馆听年少弹三弦限韵三首 其三","author":"陈维崧","text":"欢场才罢，去对孤檠话。\n欲击唾壶声尽哑，可惜孤城浪打。\n一宵柳簇花笼，何时万户千钟。\n尘世风波似海，狂奴谈笑生风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34369,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆少年 秋日登保安寺佛阁","author":"陈维崧","text":"半村红蓼，半村乌桕，半村黄叶。\n寺楼偏作势，欲斜穿山胁。\n槛外霜枫眠正贴，被西风陡添鳞鬣。\n阁中僧夜语，有猿吟相接。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34370,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"画堂春  小春","author":"陈维崧","text":"不寒不暖好年光，依然人在江乡。\n春人偷嫁与冬郎，便小何妨。\n记得年时岭外，梅妃犹未胜妆。\n如今花满纸糊房，红紫成行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34371,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鬲溪梅令  小寺","author":"陈维崧","text":"花前小寺背春城，不知名。\n淼淼夕阳金刹、著波平。\n风光难画成。\n阿师洗钵趁新晴，隔溪行。\n闲锁阶前梅萼、一枝横。\n僧雏学弄笙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34372,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海棠春 闺词再和阮亭韵四首 其一","author":"陈维崧","text":"依稀听得菱花响，三竿日、红完蛛网。\n半晌注横波，无数鬘云漾。\n妆成谁见灵蛇样，分付与、百花闲赏。\n一座丽春楼，尽把轩屏敞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34373,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海棠春 闺词再和阮亭韵四首 其二","author":"陈维崧","text":"昼长嫌煞乌三足，谁耐唱、摩诃池曲。\n好梦远如天，落絮平于褥。\n彤墀火迸红榴肉，簪不稳、一枝寒玉。\n怯暑那成眠，走觅银塘竹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34374,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海棠春 闺词再和阮亭韵四首 其三","author":"陈维崧","text":"夜堂月上无人影，小鹦鹉、困酣难醒。\n正好试金盆，一斛红泉冷。\n浴馀借得蟾为镜，谁爱取、冠儿重整。\n低髻卸偏荷，茉莉圈成饼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34375,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海棠春 闺词再和阮亭韵四首 其四","author":"陈维崧","text":"丝丝烛泪多如雨，捣尽了、月中孀杵。\n镜听拟来朝，私卜帘前语。\n坐深裙子红都去，早又是、三通谯鼓。\n谈解小郎围，权拔钗为麈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34376,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桃源忆故人 秋日晒扇见故人王湛斯画柳赋此志感","author":"陈维崧","text":"天涯乍遇宣城叟，御苑听砧时候。\n曾写几行疏柳，劝我青门酒。\n别来往事消沈久，只有齐纨在手。\n露叶烟条依旧，解与愁眉斗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34377,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桃源忆故人  重游惠山寄畅园怀秦对岩检讨","author":"陈维崧","text":"松湍百道喧晴雪，冷瀑何年才歇。\n水上瘦梅如铁，眠补红桥缺。\n从军年少巴陵客，三载金笳画戟。\n莫听楚天百舌，千里同明月。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34378,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"山花子 送姜学在由吴门之宛陵清明扫墓","author":"陈维崧","text":"鲁国男儿是孔融，如今流落号吴侬。\n燕子柳条能酿恨，旧江东。\n谢朓楼边栾布社，琴高潭上石尤风。\n送尔片帆春上冢，雨濛濛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34379,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"眼儿媚  冬夜听梧轩举填词第二集","author":"陈维崧","text":"风剪兰煤夜渐深，泉响答清音。\n官斋此夜，鲈腮斫玉，梅蕊含金。\n茂苑酒醒刚几日，浮拍又如今。\n十年红豆，五湖黄叶，费尽行吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34380,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"朝中措 客中杂忆十首 其一","author":"陈维崧","text":"层层帘幕静焚香，萦篆袅缥缃。\n翠鸭娇擎磁鼎，红狮满贮铜釭。\n如今寂寞，孤灯黯淡，细雨淋浪。\n料尔春纤拨火，为侬也费思量。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34381,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"朝中措 客中杂忆十首 其二","author":"陈维崧","text":"家乡绿雪蓊南山，采摘不曾难。\n三径风垆瓦铫，半廊竹濑松湍。\n昨朝悔未，携将茶董，同上长干。\n却忆苏门四友，曾经日给龙团。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34382,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"朝中措 客中杂忆十首 其三","author":"陈维崧","text":"看花常傍隔村篱，携取折枝归。\n沙绿胆瓶磬口，矮红棐几乌皮。\n端相侧正，屏当疏密，用尽幽思。\n记得临行嘱汝，香绵裹好军持。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34383,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"朝中措 客中杂忆十首 其四","author":"陈维崧","text":"灯昏酒尽不胜情，倚幌听三更。\n恶草邻墙马龁，乱莎别馆虫鸣。\n家园此际，小楼半掩，纤月初生。\n多少幽坊冷市，绿窗一片枨枨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34384,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]