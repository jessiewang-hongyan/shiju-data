[{"title":"驻跸碧云寺","author":"玄烨","text":"山寺通幽境，莺啼绿树枝。\n幡虹迎玉辇，刹凤驻云旗。\n翠麓三乘辟，佳辰万骑宜。\n松阴辉落景，游豫近臣知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36652,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"碧云寺临泉望月","author":"玄烨","text":"碧云夜望月初圆，星斗辉煌照九天。\n滴溜涓涓无止息，此心长使若清泉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36653,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"碧云晓起","author":"玄烨","text":"山中晓起听蝉鸣，遥对峰岑霁色清。\n洞壑有年奇树老，梦回疑是在蓬瀛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36654,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"再赋碧云晓景","author":"玄烨","text":"夏早日方长，南风草木香。\n清凉飘御扇，荒刹得恩光。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36655,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"洪光寺盘道","author":"玄烨","text":"白云飞夏日，斜径尽崎岖。\n仙阜崇高异，神州览眺殊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36656,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"来青轩临眺二首 其一","author":"玄烨","text":"摇拂烟云动翠旗，登临翰墨每相随。\n山河景象无穷意，俯瞰人情因物知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36657,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"来青轩临眺二首 其二","author":"玄烨","text":"来青高敞眺神京，斜倚名山涧水清。\n此日君臣同览赏，村村鸡犬静无声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36658,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"法海寺瞻皇考御书敬佛二字","author":"玄烨","text":"重来瞻御笔，怀感动心神。\n丕烈迈前代，鸿休启后人。\n兴文盛礼乐，偃武息兵民。\n法则光华远，千年照佛轮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36659,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"坐法海寺偶吟","author":"玄烨","text":"纵目西山宜永日，开襟五月似高秋。\n万几偶暇因游豫，期与黎民药未休。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36660,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赐圣感寺僧海岫","author":"玄烨","text":"翛然老衲净尘缘，台殿参差起瑞烟。\n驯鸽檐前应受戒，游鳞花下亦参禅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36661,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"驻跸石景山","author":"玄烨","text":"驻跸荒亭日欲斜，潺湲石溜滴云霞。\n鸾旗飘动连香草，龙骑骖驔映野花。\n岩洞幽深无鸟迹，峰崖高处有人家。\n青山绿水谁能识，怀古登临玩物华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36662,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"石景山东望","author":"玄烨","text":"车书混一业无穷，井邑山川今古同。\n地镇崚嶒标异秀，凤城遥在白云中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36663,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"登戒坛","author":"玄烨","text":"楼阁高低树浅深，山光水色日沉沉。\n碧墀静照寒松影，清昼蝉声响绿阴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36664,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"下戒坛将至潭柘马上同士奇联句二首 其一","author":"玄烨","text":"岭腹层层小径斜，穿云陟尽石㟏岈。\n涧中草屋流泉绕，万匹龙骧拥翠华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36665,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"下戒坛将至潭柘马上同士奇联句二首 其二","author":"玄烨","text":"蝉鸣草木动薰风，蛱蝶双来引御骢。\n潭柘幽深聊驻辇，省方不与豫游同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36666,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"潭柘寺偶作","author":"玄烨","text":"怡神水树清襟洽，满目奇峰入夏云。\n微起凉风响万籁，山中莺啭奏纷纭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36667,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏潭柘寺竹","author":"玄烨","text":"翠叶才抽碧玉枝，经旬清影上阶墀。\n凌霜抱节无人见，终日虚心与凤期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36668,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"石景山望浑河","author":"玄烨","text":"石景遥连汉，浑河似带流。\n沧波日滚滚，浩淼接皇州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36669,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"驻跸南苑遣使恭进太皇太后鲜果","author":"玄烨","text":"日永离宫节候新，薰风早已献嘉珍。\n赤瑛盘内甘鲜果，奉进瑶池第一人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36670,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南苑元灵宫是世祖皇考建","author":"玄烨","text":"杰阁横霄峻，清都与汉翔。\n规模开壮丽，星宿灿辉光。\n碧瓦浮空翠，金铺映日黄。\n门当啼鸟静，户有异花香。\n细草沿阶发，新槐拂槛凉。\n纡回疏辇路，藻彩绘雕梁。\n警跸临仙境，瞻依问谷王。\n敬钦崇太昊，继述忆先皇。\n岁月碑文古，乾坤事业昌。\n茫茫扶大造，暤暤体穹苍。\n恭己身无倦，斋心念不忘。\n时巡非逸豫，几暇岂游荒。\n卫骑骖驔列，华旄宛转飏。\n南薰披万物，北斗起千祥。\n瑞气庭前见，佳辰昼正长。\n休歌白云曲，吾道在惟康。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36671,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南苑行围","author":"玄烨","text":"苑中閒教阵，无事静论边。\n不废时苗典，思周天下先。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36672,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"德寿寺","author":"玄烨","text":"持身崇孝理，清净契真如。\n岁久开金寺，时来降玉舆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36673,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南苑晚景","author":"玄烨","text":"薰风南苑翠斿回，处处连云暮色催。\n夜火辉煌盈帐幕，离宫长待万几来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36674,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"瀛台偶作","author":"玄烨","text":"蝉鸣槐叶绿，鱼跃芰荷风。\n太液临斜景，参差更不同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36675,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏水禽","author":"玄烨","text":"水禽遥泛雪，池卉迥披红。\n桐叶翩翩舞，迎薰景未穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36676,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雨","author":"玄烨","text":"稼穑忧勤在建章，油云洒落满岩廊。\n凭窗喜雨雨方足，五谷秋成乐万方。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36677,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日有怀","author":"玄烨","text":"木槿花开夏日长，时摇清扇倚方床。\n三庚不辍临朝政，盛暑常思守战场。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36678,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"内苑","author":"玄烨","text":"晚凉内苑看槐花，依槛临池日欲斜。\n龙戏清潭娱夏景，片云生处足桑麻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36679,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临池观鱼有怀","author":"玄烨","text":"临池鱼跃白云连，太液东边问小船。\n一色水天明似镜，风波销灭在何年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36680,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夜至三鼓坐待议政大臣奏事有感而作","author":"玄烨","text":"午夜迢迢刻漏长，每思战士几回肠。\n海东波浪何年靖，日望军书奏凯章。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36681,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"七夕","author":"玄烨","text":"爽气三秋早，仙期此夕经。\n针楼连万户，机石动双星。\n玉露交珠缀，金风度绮軿。\n天文在云汉，流影照彤庭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36682,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沙河途中作","author":"玄烨","text":"煇煌明辇道，将晓漏声残。\n秋月西山落，金风北野寒。\n望陵悲树色，就景盼云端。\n每念芳华日，漙漙露未乾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36683,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清河荒亭","author":"玄烨","text":"楸叶晚蝉鸣，荒亭蟋蟀声。\n露凝新树色，日出满林明。\n蛱蝶从枝舞，蜻蜓点水轻。\n欲看秋景好，归路且徐行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36684,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"初秋景山","author":"玄烨","text":"新凉树色向金天，御辇遥停蔓草边。\n盛暑已过销夏日，清风才到有秋年。\n高临三殿九重阔，下看千家万户连。\n薄暮山亭观射毕，回宫复道起苍烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36685,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题日精门古砚","author":"玄烨","text":"古砚何年斲，云笺写御章。\n宫门秋雨湿，内殿晚风凉。\n夕景炉烟动，晴光烛影长。\n文房友笔墨，洒翰起龙翔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36686,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"待晓","author":"玄烨","text":"阊阖馀残暑，夕籁鸣高秋。\n暧暧月始出，泠泠露初浮。\n远色淡河汉，新凉洒裀帱。\n夜气倍澄寂，庭宇弥清幽。\n眷言希古则，羲轩讵可俦。\n不寐定天保，昧爽思旁求。\n往轸虽缅邈，来途非阻修。\n低徊待申旦，治理今何由。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36687,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赐奉命大将军杰淑二首 其一","author":"玄烨","text":"卷旆生风壮气扬，早持龙节定炎方。\n秋毫无犯民心悦，尽扫欃枪奏凯章。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36688,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赐奉命大将军杰淑二首 其二","author":"玄烨","text":"旄钺才临父老迎，楼船一举海波清。\n金瓯已定千年业，铜柱须标万古名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36689,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋日咏刀","author":"玄烨","text":"七宝刀光耀斗牛，建章佩带向初秋。\n清流越砥方知力，截兕剸鲸断不愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36690,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海子北红门秋雨后行围戏作","author":"玄烨","text":"昼漏稀闻紫陌长，霏霏细雨过南庄。\n云飞御苑秋花湿，风到红门野草香。\n玉辇遥临平甸阔，羽旗近傍远林扬。\n初晴少顷布围猎，好趁清凉跃骕骦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36691,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晾鹰台","author":"玄烨","text":"清晨漫上晾鹰台，八骏齐登万马催。\n遥望九重云雾里，群臣就景献诗来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36692,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南苑阅马","author":"玄烨","text":"渥洼龙种雪霜同，毛骨天生气格雄。\n八骏齐观南苑里，岂誇当日玉花骢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36693,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"中秋望月","author":"玄烨","text":"坐望中秋月正圆，玲珑丹桂植当天。\n无私普照八荒外，皎洁清光云汉边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36694,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赐辅国将军俄启诗","author":"玄烨","text":"观德由来上古风，手持满月绿沉弓。\n鹰扬虎视流星远，中鹄穿杨为世雄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36695,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋日晚景有怀","author":"玄烨","text":"寒鸦秋景集南林，遥倚屏山绮树阴。\n丹阙远砧鸣午夜，玉壶清漏起遐心。\n衷情静里无人识，外象閒中有物寻。\n忆想千般闻落叶，且须持笔漫微吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36696,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"大将军报吴逆暴死其下贼众溃散无馀大兵指日进取恢复封疆","author":"玄烨","text":"遥天今日捷书来，万里欢声动地开。\n从此黎民皆乐业，军威应振凯歌回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36697,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"康熙十七年九月初十日奉太皇太后临御温泉恭纪五言排律八韵","author":"玄烨","text":"慈宁方晓日，掖辇幸温泉。\n羽骑清尘道，华旗卫御前。\n九重双阙迥，三辅万家连。\n葱郁东皋树，苍茫北岭烟。\n问安频色喜，侍膳每心悬。\n孝养尊亲重，时巡法祖虔。\n村村施化溥，处处得恩先。\n更虑民情隐，深惭抚八埏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36698,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"驻跸平家滩","author":"玄烨","text":"銮舆驻跸近沧浪，行殿崔嵬对夕阳。\n郊外村庄时极目，秋成处处有风光。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36699,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"潞河晓起至太皇太后行殿问安","author":"玄烨","text":"晓色方明在潞河，孤山远影郁嵯峨。\n寝门恭问慈颜喜，还愧无能作赋歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36700,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"见雁南飞","author":"玄烨","text":"归雁南飞有数行，南飞度岭向衡阳。\n欲将信息传军士，早报成功返故乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36701,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"驻跸蓟州城南远眺山村","author":"玄烨","text":"万骑骖驔拥蓟城，风行雷出远天清。\n微霜细草野狐惧，寒露荒烟山鸟鸣。\n捲幔浮凉侵帐殿，倚床明月似都京。\n欣随圣母游情旷，深夜还思勉愫诚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36702,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"山中获野禽恭进太皇太后","author":"玄烨","text":"吹笳清辇道，大地杂旌旂。\n万壑来秋色，千岩散落晖。\n鹰随山雉远，箭带野禽归。\n遣使呈鲜味，须令马迅飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36703,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晓起山路口号","author":"玄烨","text":"荒屋山中月色阑，秋高边塞正风寒。\n羊肠石道临泉水，已静人声足旷观。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36704,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"恭谒孝陵","author":"玄烨","text":"玉殿寒松秘，秋霜落树枝。\n缅怀文武业，创立太平基。\n晓色星辰动，晴光日月垂。\n望陵愁不断，孝思起深悲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36705,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"太皇太后驾到温泉","author":"玄烨","text":"温谷神丹力不穷，五云暖溜绕行宫。\n圣躬喜得今康豫，宇宙欢忻旧日同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36706,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雨后经明总兵戚继光所作八角石亭","author":"玄烨","text":"华清雨后问安回，徐步山椒到水隈。\n秋木荒池今白草，寒花故垒旧青苔。\n精灵销散人何处，功业留传志未灰。\n为将当年堪拊髀，亭开八角尚崔嵬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36707,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清晨入盘山二首 其一","author":"玄烨","text":"日出入盘山，宸游草木閒。\n村庄人尽望，处处水潺潺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36708,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清晨入盘山二首 其二","author":"玄烨","text":"当年乘辇到，今日复来游。\n山水不同色，泉声还细流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36709,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古中盘望莲花峰","author":"玄烨","text":"中盘遥望莲花峰，日映山林气色重。\n老衲吟诗浑半偈，翠舆临发又从容。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36710,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"盘山绝顶三首 其一","author":"玄烨","text":"上盘绝顶俯神京，九月登山积翠晴。\n荒寺日高人少至，野林烟静鸟无声。\n道中勒马观风景，涧下留銮爱水清。\n纵目徘徊犹不尽，氤氲缥缈海云轻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36711,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"盘山绝顶三首 其二","author":"玄烨","text":"四顾清标高逼天，风云塞上敛寒烟。\n遥观沙漠宣威远，近控州城作镇悬。\n紫盖山中独奇秀，双峰岭外更绵联。\n九秋朗耀几千里，落叶萧条满目前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36712,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"盘山绝顶三首 其三","author":"玄烨","text":"薄暮东峰来返照，游心怡旷动挥毫。\n题诗数句林光晚，作赋初联雁阵高。\n盘道崚嶒难步蹑，危岩巀嵲恐身劳。\n欲归帐殿还传语，引路山僧度远皋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36713,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晚过李靖庵二首 其一","author":"玄烨","text":"两崖石壁出秋云，野草寒林有鹿群。\n古刹斜阳人寂寂，香烟飘处杂纷纭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36714,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晚过李靖庵二首 其二","author":"玄烨","text":"苍茫绝顶树参差，落日还营过竹篱。\n念及凌烟留姓字，独于古壁一题诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36715,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"星出归营","author":"玄烨","text":"皎皎星河路向西，将归玉帐渡山溪。\n羽林扈从皆雄将，扫靖烟尘万马齐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36716,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"奉侍太皇太后临御温泉因孟冬享庙暂回京","author":"玄烨","text":"金风肃郊甸，秋光瀰颢穹。\n晓钟出长乐，羽卫临新丰。\n重闱庆康悦，游豫温泉宫。\n鸣镳玉舆侧，侍跸清尘中。\n晨夕奉慈颜，婉愉承欢衷。\n原野陪登览，瑞霭光熊熊。\n应钟忽届节，霜露霏空濛。\n夙兴感时序，庙祀宜钦崇。\n飨献荐圭璧，对越必微躬。\n暂辞琼岛月，还御瑶池骢。\n殿阙欣在望，斋祓明禋通。\n眷言整星驾，依恋心靡穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36717,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夜半览本","author":"玄烨","text":"初冬夜静正三更，宵旰清心勉励精。\n自愧事繁机不敏，细披章奏察民情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36718,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"山中晓色","author":"玄烨","text":"星汉参差晓色开，高峰初日射莓苔。\n閒来驻跸山村静，坐爱明霞入酒杯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36719,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"由鲇鱼池出关咏瀑布水","author":"玄烨","text":"巉岩瀑布挂前川，树冷烟寒羃碧天。\n关外黎民风俗厚，涵濡威德已多年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36720,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"滦河","author":"玄烨","text":"寒边远绕至滦河，彻底清明不见波。\n驻辇徘徊千万里，石鲸两岸影嵯峨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36721,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冬至回京斋戒夜坐","author":"玄烨","text":"一阳初发便知天，暂别慈颜日日悬。\n午夜斋明湛心志，梦中犹自侍温泉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36722,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"登边城作","author":"玄烨","text":"冬月荒山落日斜，岧峣野景几千家。\n边城戍色云烟静，绿水清河走白沙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36723,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]