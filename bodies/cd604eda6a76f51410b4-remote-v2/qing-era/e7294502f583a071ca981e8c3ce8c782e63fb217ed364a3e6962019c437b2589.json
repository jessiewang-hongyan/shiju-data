[{"title":"文字","author":"萧雄","text":"行行从右认横题，鸟篆纡回不整齐。\n二十九形兼转韵，音从喉舌辩高低。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31700,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"屋宇","author":"萧雄","text":"黄土为墙四面齐，数椽如砥覆新泥。\n却教满地铺成锦，相率家人一室栖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31701,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"幼稚","author":"萧雄","text":"小儿空是说髫年，小女衣襟横在肩。\n躐等居然袍裤好，赤趺行旁额娘边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31702,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"妇女二首 其一","author":"萧雄","text":"翠袜凌波红绣鞋，青丝编发称身材。\n迷离扑朔浑难辨，襟影双飘拖地来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31703,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"妇女二首 其二","author":"萧雄","text":"少妇轻笼彩色裳，劳嫠翻学绿衣郎。\n肩披锦帔垂腰短，正是胡姬马上妆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31704,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"衣服二首 其一","author":"萧雄","text":"章身多爱锦衣鲜，窄袖长裾领自圆。\n袍裤暑天齐尚白，腰间犹系一条棉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31705,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"衣服二首 其二","author":"萧雄","text":"高冠似瓮覆还空，小帽如觚绣并工。\n应是平生嫌发短，不交露顶见王公。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31706,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"宿红土窝茅店","author":"国梁","text":"夜来星宿一胸罗，风虎吟号掠鬓过。\n虚室但能容斗帐，此生于物不求多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31707,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"嬉乐","author":"萧雄","text":"嬉乐无非较艺时，输金相约马争驰。\n更看环抱交相跌，身手推谁好健儿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31708,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乐器","author":"萧雄","text":"龟兹乐部起纷纷，调急弦粗响遏云。\n忽听名呼胡拨四，不禁低首忆昭君。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31709,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"歌舞","author":"萧雄","text":"一片氍毹选舞场，娉婷儿女上双双。\n铜琶独怪关西汉，能和娇娃白玉腔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31710,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"艺术","author":"萧雄","text":"风惟庞古器惟粗，巧匠心思毕竟无。\n听说山南多敏慧，近来依样善描摹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31711,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"牧养","author":"萧雄","text":"队队牛羊下夕晖，春风海上草初肥。\n贰师最有关心事，却笑而今已不稀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31712,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"纺织","author":"萧雄","text":"木棉花下女郎多，摘得新花细马驮。\n手转轴轳丝乙乙，不将粗布换轻罗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31713,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"耕种","author":"萧雄","text":"四月东风已解冰，麦苗初长稻苗青。\n双驱骏马勤耕陇，不待天明早唤醒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31714,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"廿九日发古城巡抚伊江阿大令阮曙并马送至水磨合茶话乃别","author":"洪亮吉","text":"出城闻泉声，到合复数里。\n逶迤冈四面，云向水中起。\n蒙蒙萍藻绿，水鸟浴未已。\n曲处响始奔，惊流出潭底。\n人栽沙果好，都入北窗里。\n板屋止两层，高瞻忽迢递。\n殷勤相送客，门外尚余几。\n挥马去不停，林长久延企。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31715,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"除夕巴里坤客帐祀先","author":"洪亮吉","text":"昔日公孙瓒，临岐祀北邙。\n潸然感先德，忘却在殊乡。\n烛借穹庐火，牲求牧泽羊。\n荒寒一瓯雪，聊抵奠椒浆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31716,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"哈密三首 其一","author":"李銮宣","text":"高山连关勒，古郡控伊吾。\n地远天难尽，沙明海不枯。\n举头飞鸟没，回首片云孤。\n牵马入城市，言寻卖酒垆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31717,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"哈密三首 其二","author":"李銮宣","text":"东接敦煌郡，南连吐鲁番。\n咽喉通月窟，衣带俯河源。\n日影春城黯，风声戍角喧。\n太平无绝檄，中外一屏藩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31718,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"哈密三首 其三","author":"李銮宣","text":"村落如棋布，炊烟屋上斜。\n耕田多服马，戽水不悬车。\n错壤平宜稌，衡门半种瓜。\n停骖揖老叟，暂与话桑麻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31719,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐","author":"褚廷璋","text":"额鲁公孙此建瓴，天戈万里下风霆。\n山围蒲类分西谷，云护沙陀拱北庭。\n不断角声横月白，无边草色入天青。\n辑怀城上舒雄眺，尽把耕畴换牧坰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31720,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"苦水","author":"祁韵士","text":"渴际谁甘饮盗泉，生憎滴水苦茶煎。\n葫芦车上朝朝挂，昏暮求人便值钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31721,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古尔图道中","author":"宋伯鲁","text":"逻骑容刀锐，旃舆小户通。\n片云时带雨，老树总吟风。\n野戍荒烟外，穹庐落照中。\n犹闻旧藩子，出学大瀛东。\n大漠黄云黯，千岩白雪高。\n虎留沙上迹，驼落草间毛。\n墨守儒生拙，戎装武士豪。\n至今于货者，犹佩越人刀。\n此地盛刍牧，沃皋千里平。\n牛羊下落日，草树隐荒城。\n倚剑孤云晚，停轺片月清。\n堠亭寥寂甚，空外一鸡鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31722,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"托多克道中戏作胡桐行","author":"宋伯鲁","text":"君不见额琳之北古道旁。\n胡桐万树连天长。\n交柯接叶万灵藏。\n掀天踔地纷低昂。\n矫如龙蛇欻变化。\n蹲如熊虎踞高岗。\n嬉如神狐掉九尾。\n狞如药叉牙爪张。\n或为诸生肃。\n揖让何矜庄。\n或为勇士怒。\n奋髯森戟芒。\n或为幽闺女。\n婉昵凝新妆。\n或为玉清客。\n羽服来帝乡。\n或若沈沙戟。\n断折怆周郎。\n或若通天柱。\n摧坏悲武皇。\n或若仇池石。\n袍笏拜元章。\n或若伯通臼。\n舂杵偕孟光。\n妍媸肥瘦各有态。\n风撑雪拒千星霜。\n枯杈频经野火燎。\n翠叶不碍寻斧伤。\n我闻蒲昌海。\n大者如舟航。\n张侯乘之探星宿。\n牵牛织女遥相望。\n山经既不载。\n班史亦未详。\n瞀儒不解事。\n鸣凤讹朝阳。\n吁嗟造物信狡狯。\n画工虽巧安能方。\n我今作诗告来者。\n此言虽夸勿笑狂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31723,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"哈密二首 其一","author":"裴景福","text":"天山积雪冻初融，哈密双城夕照红。\n十里桃花万杨柳，中原无此好春风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31724,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"哈密二首 其二","author":"裴景福","text":"踏残白刺过黄芦，麦秀宜禾绿似铺。\n更与偎郎弹一曲，不辞烂醉住伊吾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31725,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夜抵木垒河","author":"洪亮吉","text":"到得山村夜已迷，窗棂全不辨东西。\n狼驯似马凭鞭策，鹊大于鸡共树栖。\n穴鼠岸然欺客睡，蛮猿时复杂儿啼。\n峰峰塞路谁能究，只觉檐前北斗低。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31726,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"三台夜宿","author":"洪亮吉","text":"峰峦南北途千曲，天半乱霞烘马足。\n山程九十到未迟，觅得山村最西屋。\n绿莎窗开波影摇，酒渴我尚餐山桃。\n夜阑残月仅一线，紫燕白鸽争归巢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31727,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"宿沙枣泉","author":"洪亮吉","text":"伊犁三月三，哈密六月六。\n风日固自佳，其奈客幽独。\n今宵宿沙枣，马病扰心曲。\n挥扇急出门，临流看飞瀑。\n林长久延伫，石喜可容足。\n鸦巢厌人影，月出景相逐。\n双燕更有情，更残导归宿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31728,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"四十里井汛","author":"洪亮吉","text":"四十里井间，只有十家住。\n十家汲井过，并向麦畦注。\n麦肥如野菽，饱食耐征戍。\n耕余了无事，间或插桑苎。\n遂令半里间，夹屋无杂树。\n南山团作障，三里塞去路。\n时有归墟人，穿云如白鹭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31729,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"伊黎","author":"褚廷璋","text":"人驱风雪兽驱烟，犹见乌孙立国年。\n海气万重吞丽水，山容三面负祁连。\n盘雕红寺朝鸣角，散马青原夜控弦。\n纪绩穹碑衔落日，英灵班鄂想回旋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31730,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雅尔","author":"褚廷璋","text":"多逻川外夜吹芦，雉堞新城接上腴。\n塞月已寒三叶护，边风犹动五单于。\n名藩甲卷烟消漠，健将弓开血洒芜。\n不是皇威宣北徼，春光谁遣遍坟炉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31731,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"哈喇沙尔","author":"褚廷璋","text":"风雨犹疑铁骑屯，至今沙戟有遗痕。\n焉耆镇启龙游远，都护城悬乌垒尊。\n弓挂轮台飞皎月，韧磨蒲海射晴暾。\n戍楼高处分襟带，山水遗经费讨论。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31732,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"初八日乘月行四十里至三个泉宿","author":"洪亮吉","text":"人烟百里何渺茫，疲裸独行古战场。\n高天下地总一色，明月白雪分清光。\n拂眉时有山禽过，清献声高野禽和。\n三泉屈指尚半程，我倦欲从云外卧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31733,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"丁未林出君慕胜壮游大宛乌孙诸地乌垣小憩将返故都于其别也成四十字歌赠之","author":"王树楠","text":"天上葡萄种，新从大宛来。\n春风万余里，夜月一衔杯。\n毒海探骊手，长城倚马才。\n明朝看日出，故国有蓬莱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31734,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"库车四首 其二","author":"易寿崧","text":"旧乐争传斋篥声，翻来新曲太凄清。\n殊方尽可尊官长，蛮性终难识舅甥。\n安得纲常归雅化，谁将礼义及时明。\n我来又起流年感，渐觉霜华两鬓生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31735,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"库车四首 其三","author":"易寿崧","text":"山头炎日化冰坚，塞外风光四月天。\n半角荒畦锄吉贝，一渠活水种麻烟。\n乘槎有路凌霄汉，分野无星识度躔。\n我欲销愁谋一醉，行囊只有数红钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31736,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"库车四首 其四","author":"易寿崧","text":"戍楼几处挂斜阳，萧飒风生夏月凉。\n数点牛羊归欲暮，两三户口即成庄。\n远山忽起边云黑，中夜愁看塞月黄。\n倦客犹然兴不浅，残书细读倚胡床。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31737,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"阿尔苏","author":"褚廷璋","text":"天边冰雪郁嵯峨，木素峰高朔气多。\n壕上射生城落雁，军前飨士帐鸣鼍。\n东萦姑墨千年碛，南走于阗一线河。\n待把方言垂竹笔，阿苏温宿浸承讹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31738,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"阿克苏","author":"王曾翼","text":"锁钥两城连，佳哉望郁然。\n岩疆望乌什，间道走和田。\n地扼襟喉要，人夸贸易便。\n商多三晋客，货溢百间廛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31739,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉柳园","author":"麟魁","text":"园中醉柳几何年，小有亭台亦洒然。\n一道清泉寒漱石，百围高树绿参天。\n地临化日龙亭畔，窗列晴岚雉堞前。\n遥忆春归无限好，数枝青到酒旗边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31740,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌什城远眺","author":"晋昌","text":"百战经营漫负隅，尉头几换古名区。\n泉开杨柳枝头水，城抱骊龙颔下珠。\n绝国牛羊今受敌，降王鸡犬昔全屠。\n叮咛旌节花开处，长使春辉入画图。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31741,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌什","author":"曹麟开","text":"戍士无劳夜枕戈，永宁城外散鸣驼。\n东回姑墨千峰雪，南下于阗九折河。\n五翕侯仍招旧部，二昆弥已靖沙陀。\n吹鞭争唱天鹅曲，不数摩诃兜勒歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31742,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"阿克苏桑椹因成八韵咏事","author":"弘历","text":"嫩条阿克苏初移，结实仍当五月时。\n食椹殊方迁献椹，曰栀尔雅讵为栀。\n只传乌白原恒有，讶见丹红实出奇。\n诡异宁同尺以计，硕魁真比寸犹欺。\n迎眸磊落诚轩意，可口甘芳孰朵颐。\n鲜进凤围欣远奠，熟颁鹭序沐恩滋。\n衔残漫拟樱桃诮，解热奚劳甘蔗随。\n分赐莫将容易看，洸洸曾用济王师。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31743,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雷雨","author":"肖雄","text":"终年无雨湿荒郊，气脉难腾地太高。\n偏是新苗经未惯，农夫原不望春膏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31744,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蚕桑","author":"肖雄","text":"彩帕蒙头手挈筐，河源两岸采柔桑。\n此中应有支机石，织出天孙云锦裳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31745,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"瓜果四首 其一","author":"肖雄","text":"镇心齐剖绿沉瓜，翡翠冰融月一牙。\n更有甘芳黄玉软，囊驼筐篚贡天家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31746,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"瓜果四首 其二","author":"肖雄","text":"苍藤蔓架覆檐前，满缀明珠络索圆。\n赛过荔支三百颗，大宛风味汉家烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31747,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"瓜果四首 其三","author":"肖雄","text":"果树成林万颗垂，瑶池分种最相宜。\n焉耆城外犁千树，不让哀家独擅奇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31748,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"瓜果四首 其四","author":"肖雄","text":"山北山南杏子多，更夸仙果好频婆。\n枣花落后樱桃熟，一段风光莫忽过。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31749,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"园蔬","author":"肖雄","text":"几畦蔬菜不成行，白韭青葱着意尝。\n萝菔儿怜秋色老，蔓菁瓮贮隔年香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31750,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"回王园中花卉","author":"萧雄","text":"花从内地强移栽，半畏寒多不肯开。\n独有玫瑰成土著，异香清远袭人来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31751,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"花卉二首 其二","author":"肖雄","text":"看花还是果林边，十里花光远接天。\n桃杏自娇梨爱素，斗他安石旧鲜妍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31752,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"气候六首 其一","author":"肖雄","text":"西土高寒气候殊，伊州犹是一东隅。\n地分咫尺时争刻，翻乱征衣件件俱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31753,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"气候六首 其二","author":"肖雄","text":"山北孤城寒更多，海城蒲类雪成窠。\n笑他五月披裘客，不识人间有葛罗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31754,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"气候六首 其三","author":"肖雄","text":"高昌炎热绝无俦，赢得元时号火州。\n毕竟庚藏阳气伏，凄凄风雨又边秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31755,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"气候六首 其四","author":"肖雄","text":"八城蹦度渐臻南，尚有温和一气涵。\n物产不殊乡国美，精华多在此中探。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31756,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"气候六首 其五","author":"肖雄","text":"阴山北望五单于，地与南疆迥自殊。\n八月西风吹雪到，无端一夜失枌榆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31757,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"气候六首 其六","author":"肖雄","text":"波翻丽水已西倾，地势旋低气转平。\n碧草烟深三月雨，黄花寒浅一天晴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31758,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"辟展","author":"褚廷璋","text":"人间乍识龙泉碗，塞上新犁回鹘疆。\n旧垒烽烟留古勇，断碑榛莽没侯姜。\n黄驱魅碛驼鸣月，白拥天山马立霜。\n指点耕屯余沃壤，前庭门户重堤防。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31759,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题长流水壁 其一","author":"秦承恩","text":"在昔伊吾郡，遗踪说汉唐。\n当年戎马地，今日黍禾乡。\n雪拥天山秀，源分柳谷长。\n老饕堪慰籍，瓜剖水晶瓤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31760,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题长流水壁 其二","author":"秦承恩","text":"忽见扶疏绿满枝，阴森匝地晓风吹。\n十年多少栽培力，路上行人知未知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31761,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞上竹枝词叙","author":"曹麟阁","text":"合罗川里冰蚕浴，碎叶城边桑叶肥。\n织女自夸花蕊巧，亲从河上得支机。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31762,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"温泉夜雨","author":"曹麟阁","text":"曾试华清第二泉，温汤复此弄漪连。\n沸珠洞底歊朱火，皎镜潭心喷紫烟。\n黍谷气蒸飞作雨，渠黎波暖溉为田。\n依稀共话巴山夜，剪烛西窗忆往年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31763,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"至阜康","author":"史善长","text":"庭州多乐土，此县独清贫。\n水少空余地，村荒尚赛神。\n尊严山气象，络绎客风尘。\n廿里东关外，桑麻别有春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31764,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"三台道上","author":"史善长","text":"稻草高于屋，泥垣白板扉。\n鸡豚过社少，牛马入秋肥。\n漠漠田千顷，阴阴木四围。\n此乡风景异，不见塞尘飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31765,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"吐鲁番产瓜不亚哈密而名不著慨叹及之","author":"张荫桓","text":"回疆物产吐蕃盛，五谷布帛兼蚕桑。\n即令甘瓜亦清美，足与哈密相颉颃。\n都人但夸哈密好，瓜干只许王公尝。\n岂知佳种别有此，车师道远不得将。\n知希遂令物自贵，讵假腴颂虚声扬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31766,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晚宿格子烟墩","author":"祁韵士","text":"百余里外未逢村，沙路迟迟问远墩。\n日暮途遥频驻马，更深店闭懒开门。\n浊沽漫觅三杯醉，残梦为寻一席温。\n喜得新泉非苦水，茶余客话且同论。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31767,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"与同人由格子烟墩夜行，晓达苦水和壁间韵","author":"颜检","text":"挥鞭催去马，联骑共宵征。\n旷碛堆沙白，孤星入曙明。\n地荒村树断，天阔晓风清。\n戍客生还矣，凄迷塞外情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31768,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]