[{"title":"童谣","author":"王苍璧","text":"赈饥民，吏胥饱，饥民泣，吏胥恼。\n吏胥勿恼尔当喜，官府明朝粜官米。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29239,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"京师九日城南黑窑厂登高","author":"周远","text":"愁思天涯九日晴，凭高闲望夕阳明。\n天清万丈秋潭影，风急三关落木声。\n双阙参差连御苑，乱山合沓入边城。\n悬军绝幕思飞将，闻道河西已厌兵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29240,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渝州重逢芮文彬赋诗道别","author":"高炳","text":"君家濑水湾，我住钱溪侧。\n两家南北对洮湖，朝夕往来不相识。\n今年四月朔，我正在荆州。\n融窗忽听故乡语，招手同上江陵楼。\n江陵成边酒如乳，笑脱青衫典春酤。\n为君一饮尽百觞，挂帆西去适渺茫。\n此去亦何期，风波梦里思。\n恨我何早发，思君行太迟。\n昨到渝州屡回首，一见行人君在口。\n闻君尚住巴江东，不意君来我翻后。\n相逢一笑酒重倾，樽前且听风雨声。\n何时归去复携手，明日拂衣还独行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29241,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"读昌谷集","author":"高炳","text":"帝阙飘飖邈何许，庞眉书客天人语。\n兴来倒吸海底干，八荒并入秋毫端。\n瑶姬仙史不能读，留向人间问空谷。\n风吟雨怨几多年，南山石烂真可怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29242,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"拜方正学祠","author":"朱厚章","text":"秋气凛毛发，祠门吊落晖。\n何人加白帽，大节在麻衣。\n草乱疑瓜蔓，庭空绝燕飞。\n景公遗庙近，化鹤并来归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29243,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄答王千里","author":"朱厚章","text":"留滞通侯邸，真成客里家。\n高门贺燕雀，华发吐烟霞。\n逸士方三拜，才人温八叉。\n知君怀故里，丘陇有梨花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29244,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题青溪集","author":"朱厚章","text":"黄柳花飞扑醉巾，六朝滚滚马头尘。\n也知李峤真才子，可但江淹是恨人。\n淡粉轻烟疑在眼，珠帘甲帐最伤神。\n倩谁谱入参差玉，诉与无情古月轮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29245,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"九日登东城寄南华","author":"朱厚章","text":"苍烟影里独凭高，瑟瑟寒生薜荔袍。\n我愿满头常插菊，天生左手为持螯。\n云随暮鸟归村树，风卷秋钟撼海涛。\n佳节一杯桑落酒，故人何处斗诗豪？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29246,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"岁暮杂诗","author":"朱厚章","text":"吴氓殚力办租庸，霖潦深秋骇老农。\n信有橧巢师鸟雀，尽抛䆉稏豢鱼龙。\n漫空水气难为雪，照野阳威未化淞。\n闻道中丞能入告，便令寒谷转春容。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29247,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秦淮绝句","author":"朱厚章","text":"风花无力扑帘波，佳节偏从客里过。\n听说儿童挑荠菜，青青只有故宫多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29248,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"观柳河东初访半野堂小像","author":"朱厚章","text":"蘼芜脉脉柳疏疏，想见文君放诞初。\n谁识秋风摇落后，独将一死报尚书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29249,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹁鸠啼","author":"蒋梦兰","text":"晚来鹁鸠鸣不己，鸠妇含愁农妇喜。\n馌饷才归又出门，仰望乌云何处起。\n鹁鸠鹁鸠愿尔鸣，明朝可免车河水。\n儿夫肌肉日炙焦，鸠妇休伤雨濡尾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29250,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"平陵公子歌","author":"方贞观","text":"家世平陵东曲住，生长轻肥耻纨裤。\n夷门曾访鼓刀人，赵州一拜平原墓。\n杀身不惜为知己，乡闾但道酒人耳。\n北上边城望大荒，南寻禹穴西衡湘。\n万里阴相天下士，眼中彼彼止如是。\n一笑归来更读书，十年折节为名儒。\n当时心慕要离勇，今笑荆轲徒匹夫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29251,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"敝袍","author":"方贞观","text":"故友绨袍意，今经几岁寒。\n补多微觉重，老瘦渐嫌宽。\n色已随年尽，棉因屡洗残。\n更新吾岂敢，还作赠时看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29252,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送渤海公回吴门","author":"方贞观","text":"倾盖即成故，因之离恨生。\n谈空不得力，此别若为情。\n渚白烟无际，江流月有声。\n遥知松偃处，童子下山迎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29253,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"出宗阳","author":"方贞观","text":"回首故山尽，前途直北长。\n萍蓬自兹去，乡国永相望。\n短草寒烟白，孤村落日黄。\n生逢击壤世，不得守耕桑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29254,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"抵家","author":"方贞观","text":"行衣乍脱喜还悲，仍似桑乾入梦时。\n亲老幸邀天与健，家倾翻痛妇能持。\n山田白露登新谷，篱落黄花发故枝。\n欢捧一尊为母寿，阿奴不道有归期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29255,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题侯家鹧鸪","author":"方贞观","text":"谁将越鸟到京华，一入侯门闭笼笯。\n道是珍奇翻累汝，可能流浪便为家？\n魂依苦竹岭头月，梦落黄陵庙里花。\n未免输他秦吉了，却安饮啄在天涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29256,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"月夜汲中泠泉","author":"谢芳连","text":"新月泉上出，江华照衣冷。\n扁舟荡秋桨，汲取波中影。\n昨与山僧期，煮月翻瓦鼎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29257,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"密雪望行人","author":"谢芳连","text":"人行犬雪吠，密雪迷村影。\n欲扣酒家扉，山桥一蓑冷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29258,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题李百药三十六湖草堂","author":"谢芳连","text":"钓罢归来解钓筒，题诗灯火夜深红。\n湖村犬吠人眠尽，商女棹歌烟月中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29259,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"登州蓬莱阁","author":"吴诩","text":"山连汉武候神处，阁在田横旧砦东。\n五岛乱浮云气里，双城浑住水声中。\n遥滩夕涨生空绿，古庙残阳曳断虹。\n便欲刺舟从此去，七条弦上响天风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29260,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过倪云林祠","author":"孙宏","text":"玉山池馆已荒烟，清閟祠堂尚俨然。\n破产放情多难日，无家投老太平年。\n碧梧修竹骚人节，远岫平林水墨仙。\n应与所南同俎豆，遗民心事画中传。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29261,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"黄侍中祠","author":"孙宏","text":"金川万骑蹴烟尘，叩马难将大义陈。\n妻女一时同殉节，君臣千古有完人。\n魂归罗刹江声壮，碑照秦淮血影新。\n咫尺孝陵松柏路，夜深风雨走青磷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29262,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渡泖","author":"叶锦","text":"孤舟迎夕照，入望总苍茫。\n月上潮三尺，天空雁一行。\n暮山随意远，客思与波长。\n指点茸城近，村烟满野塘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29263,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晓渡","author":"叶锦","text":"隔岸疏钟动，平林宿鸟飞。\n夜潮随月落，小艇带烟归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29264,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"客邸思归","author":"熊良巩","text":"静听木叶下西风，灯影昏昏照病容。\n滴碎愁心秋夜雨，敲残客梦寺楼钟。\n衡阳雁断三千里，巫峡猿啼十二峰。\n我久欲归归未得，云山叠叠水重重。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29265,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"拟将进酒","author":"康瑄","text":"娇丝脆竹陈高堂，明灯煌煌出洞房。\n美人罗袖怨清商，一曲哀歌君断肠。\n博山香炉金络索，上有仙人驾鸾鹤。\n同心欢乐寿万年，不用三山觅仙药。\n何如小槽滴沥琥珀浓，浇胸顿使金罍空。\n醉乡乃在太古世，后辈尧禹轻羲农。\n酒中之乐人不省，劝君饮酒君自领。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29266,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"登塔","author":"孙阳顾","text":"半空身忽住，飞鸟共经过。\n江海掌中揽，烟云足下多。\n四围丛苑树，一气接银河。\n欲向高天问，无言对我何？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29267,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"达梅耦长令浙东","author":"吴学濂","text":"廿年卧对敬亭云，名士如君始是真。\n太白乐章惊贺监，微之辞句诵宫人。\n素衣不受缁尘化，墨绶偏膺白发新。\n山水永嘉堪眺览，谢公遗迹未湮沦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29268,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杨椒山公祠","author":"吴学濂","text":"祠宇重新古驿旁，姓名犹觉满城香。\n五奸已褫权臣魄，一疏堪争烈日光。\n谢却蚺蛇真有胆，撑将铁骨不随杨。\n阶前请铸分宜像，斫地行人共激昂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29269,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浮山","author":"程烈","text":"缥缈接瀛洲，孤筇海上游。\n山从波底出，人在镜中浮。\n古树风疑雨，阴岩夏亦秋。\n茫茫杳无际，隐约指丹丘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29270,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"张中丞祠","author":"朱国汉","text":"绣帐烟沉铁面灰，中丞生气尚峨巍。\n孤城百战鼠雀尽，长笛一声天地哀。\n当日江淮资保障，至今号令肃风雷。\n贺兰未灭英雄死，滚滚波流恨不回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29271,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"文丞相祠","author":"朱国汉","text":"丞相荒祠白日寒，直教一死寸心安。\n崖山激烈原非易，柴市从容更较难。\n穷海有人埋碧血，普天无地著黄冠。\n西台恸哭悲风起，剩水残山忍再看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29272,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"岳武穆墓","author":"朱国汉","text":"森森宰木战英风，葛岭高坟夕照中。\n白马怒涛人共恨，黄龙痛饮事皆空。\n风波诏狱成三字，朔漠羁魂哭两宫。\n从此君王无远略，杭州可与汴州同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29273,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自笑","author":"刘正谊","text":"自笑情何僻，谋生竟未能。\n鬻田买古砚，贷米给诗僧。\n花月耽成癖，禽鱼狎似朋。\n室人交谪我，妇语不须应。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29274,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"访毛西河太史留赠","author":"刘正谊","text":"充栋书成自不刊，频年握椠暑兼寒。\n鲁鱼舛后多釐正，秦火焚来尽补残。\n画舫两湖明月共，篮舆十里好山看。\n感施馀论沾荒帙，白苇黄茅足改观。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29275,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水仙花","author":"曹煜曾","text":"江湍漱云牙，夜濯宓妃魄。\n一洗罗袜尘，踏霜晓无迹。\n冰肌归药房，清芬袭巾舄。\n脉脉契素心，疏梅影横壁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29276,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"九日送人北归","author":"曹炳曾","text":"折取茱萸当柳条，送君明日上兰桡。\n望乡惜别分南北，并作离魂一夕销。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29277,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"病中雨夜","author":"曹煐曾","text":"炉烟浓欲篆，夜色淡生阴。\n病骨秋花瘦，愁怀暮雨深。\n疏灯孤榻影，衰草乱虫吟。\n无限关心事，朦胧梦里寻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29278,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"花下独酌","author":"陈履平","text":"花枝娅姹摇春风，纷纷蜂蝶争繁丛。\n我来提壶饮花下，闲愁如雪皆消融。\n枝头黄鸟声更好，似惜春光怨春老。\n少年乐事那复得，只今空忆长安道。\n救人无术廿载中，归来两鬓已成翁。\n故交如花渐凋落，欲话衷曲谁人同？\n且拚烂醉花阴卧，明日呼童扫落红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29279,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"方竹","author":"秦时昌","text":"举世尚圆通，尔形独合矩。\n不同睢园种，亦殊嶰谷侣。\n直方坤之德，钟秀天特与。\n虽惊世人眼，实为君子许。\n棱棱霜气凝，矫矫峻节举。\n宿土移数竿，岁久森圃墅。\n坚竹竖为杖，登临借撑拄。\n毋令柔媚人，一朝削圆女。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29280,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寒夜读书","author":"朱肇璜","text":"朔风号纸窗，霜气肃檐瓦。\n耿耿一灯明，虚室意潇洒。\n简编随意读，寻味我心写。\n淡泊得膏腴，肤浮付土苴。\n上下观古今，一一归炉冶。\n此时天气寒，瀹茗代杯斝。\n披帏盼高空，星河淡欲泻。\n邻鸡冻不鸣，应知和者寡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29281,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"书屋新成示儿子琪瑛犹子珏璠","author":"朱霞","text":"矫矫松林下，山斋喜落成。\n积书须善读，隙土可深耕。\n习礼束筋骨，安弦养性情。\n更期三益友，开径每相迎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29282,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"谢皋羽西台","author":"汪沅","text":"何事西台上，空山恸哭声。\n风云皆变色，天地竟无情。\n竹石敲新裂，江流恨不平。\n客星祠咫尺，万古共澄清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29283,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"读南渡野史作 其一","author":"汪沅","text":"过江名士竞从龙，佐命先邀五等封。\n阃外新开都护府，师中群噪大司农。\n文章江令娴歌谱，游宴长星劝酒钟。\n忽讶双眉愁不展，佳伶稀选未央供。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29284,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"读南渡野史作 其二","author":"汪沅","text":"龙盘虎踞石头城，跋扈亲挥汉水兵。\n相国临戎防北伐，将军卷甲急南征。\n华林但问虾蟆语，莫岭惟闻蟋蟀声。\n《燕子》《春灯》韬略在，不须司马更连营。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29285,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"柳絮曲","author":"周瓒","text":"点点觉春深，飞飞恨不禁。\n露沾疑妾泪，风散比郎心。\n晓月隋堤畔，残阳灞水阴。\n年年飘荡处，肠断白头吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29286,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送友人屯田塞上","author":"沈廷扬","text":"经国千年计，凭君此日行。\n官非汉司马，人是赵营平。\n时雨兼兵洗，边春带雪耕。\n伫看成沃壤，胜筑受降城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29287,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"看菜花","author":"刘宗霈","text":"乍逢红雨点回塘，又见平畦千顷黄。\n色比散金无异种，香连绣壤不分疆。\n已娱老眼消春昼，旋引归心立夕阳。\n燕麦兔葵无感触，不须佳句忆刘郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29288,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过仙霞岭","author":"王道","text":"昔闻仙霞名，今上仙霞岭。\n攀陟人力穷，贲育敢言猛。\n危峰插高空，奇壑俯深井。\n险绝猿鸟踪，阴障羲娥影。\n历尽廿八盘，始蹑最高顶。\n史浩昔开凿，闽越通两境。\n而胡跋扈藩，恃险抗朝请？\n妖氛应远寇，中原颇传警。\n妄意蟠蛟龙，终类跳蛙黾。\n天兵一以加，鈇钺膏首领。\n岩疆讵可恃，天道宜深省。\n承平今百年，岭畔烽烟静。\n商旅日登陟，往来道无梗。\n盛德渐要荒，谁敢作不靖。\n为语守土臣，设险谨藩屏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29289,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"闻柝","author":"沈源","text":"击柝严城凄复清，听来一一触离情。\n天街夜静霜初落，绣阁灯寒梦未成。\n宵恨短长随晓箭，韵移高下逐风声。\n座中有客支孤枕，归思惊催白发生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29290,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏雪","author":"赵关晓","text":"踏雪访山樵，山樵踏雪去。\n一路草鞋痕，寻入松深处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29291,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赠友","author":"赵关晓","text":"不向人间留姓名，草衣木食气峥嵘。\n山深虎出伥声急，夜半长歌空手行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29292,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晚甘园芍药盛开莼江招饮","author":"周振采","text":"君留燕，吾适鲁，去年花时各羁旅。\n鞭梢两地恰归来，一时花下同宾主。\n殿春朵朵翻琼英，白头相对千花明。\n有酒但作长鲸饮，有句肯学寒螀鸣。\n物情共艳三公爵，魏国声名兆花萼。\n我与君家共息机，无须离别怅分飞。\n朱朱白白皆堪赏，不羡扬州金带围。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29293,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"老将","author":"周振采","text":"百战沙场功未酬，偏裨年少早封侯。\n敌人俯首惊无恙，法吏吹毛对若仇。\n老马蹑云偏伏枥，苍鹰羁旋欲腾韝。\n请看猿臂终强健，射虎南山气尚遒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29294,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江干月夜","author":"孙璜","text":"雪夜江干月倍清，推篷遥望正三更。\n天连玉峤千山白，水漾金波万里明。\n旅况每依甘露寺，名心遥系石头城。\n沙寒洲冷渔灯灭，倦听邻舟摘阮声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29295,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"箬包船纪事","author":"王应奎","text":"有船锐其首，以箬包裹之。\n名为箬包船，聚泊疑茅茨。\n浮家无定所，忽湖忽江湄。\n居货挟土产，擅技兼卜医。\n中有无良者，行乞同残黎。\n讵料豺狼心，所志窃童儿。\n神咒与饼饵，给儿儿辄迷。\n牵引至船中，毒手恣所为。\n或为矐其目，或为攦其肢。\n或屈曲其体，如籧篨戚施。\n形骸几变尽，父母居然疑。\n清晨负之出，索钱号九逵。\n夕仍负以入，倾倒囊中资。\n数倘有不充，攒刺加鞭笞。\n苟延此残喘，性命危如丝。\n有时更肆恶，视彼躯干肥。\n入之人鲊瓮，饱啖若餔糜。\n吸儿脑与髓，嚼儿肝与脾。\n从此筋骨强，便堪耐刀锥。\n更闻藏秘器，卖以疗尪羸。\n一七为神膏，索值恒不訾。\n淫人祈长生，食之甘如饴。\n又闻湖海滨，茫洋有神祠。\n神曰抽筋姆，此辈所皈依。\n重午暨中秋，庙门搴灵旗。\n群船竞祭赛，以儿为牲牺。\n祭罢饮福酒，狼籍骼与骴。\n年来迭败露，官长胥周知。\n勿问所从来，立毙陈其尸。\n谓足抵儿命，此外无穷治。\n不穷其本根，徒然剪旁枝。\n官长法深刻，胡独偏仁慈。\n其毒仍滋蔓，其故难寻窥。\n谁为采风者，听我歌此诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29296,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"岁暮得家书","author":"汤懋统","text":"冉冉逢残岁，迢迢隔故庐。\n一灯游子梦，双泪老亲书。\n敢怨功名薄，深惭菽水疏。\n却思诸弟妹，绕膝意何如。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29297,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"除夕","author":"汤懋统","text":"残臈辞人逐漏频，寒毡堪笑独吟身。\n仅支鹤俸能供岁，轻掷鱼竿自取贫。\n柏酒竟疏婪尾宴，梅花虚拟故园春。\n遥思伯氏京华久，一样灯前忆老亲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29298,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"故衣","author":"汤懋统","text":"检点衣衫敝箧存，十年相与历寒温。\n香尘惯惹春风陌，寒杵多敲落月村。\n赠友未堪酬缟带，思亲每为染啼痕。\n贫居赖酒消岑寂，曾典青钱向市门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29299,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自律","author":"金衡","text":"托迹从嘉遁，居心合守谦。\n畋渔凭典籍，餍饫仗齑盐。\n蛮触毋相斗，熊鱼未可兼。\n古人吾尚友，高枕到羲炎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29300,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过友人别馆","author":"金衡","text":"竹静江喧称隐居，席门久矣断轩车。\n寒香入座花开半，清影穿窗月上馀。\n倚枕相忘人化蝶，临流安见我非鱼。\n耦耕夙约行当践，有伴巢由合荷锄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29301,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]