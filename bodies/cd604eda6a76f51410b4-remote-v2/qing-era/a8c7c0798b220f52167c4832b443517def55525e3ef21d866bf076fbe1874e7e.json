[{"title":"满江红 述怀","author":"吴绡","text":"陵谷纷纭，鱼龙混、一江春涨。\n回首处、平生孤介，弱躯多恙。\n盼望云霄凡骨重，寸心常锁双尖上。\n闭深闺、栖处似鹪鹩，齐眉饷。\n行乐事，全抛漾。\n琴书好，休题唱。\n但梦吟残罢，闲愁酝酿。\n痴想蓬莱弱水隔，难求缩地壶公杖。\n叹风风雨雨度馀年，凄凉状。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21897,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 四首 其一","author":"吴绡","text":"江南忆，风暖换春衣。\n如画楼台花夹路，香街人醉玉骢肥。\n年少踏青归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21898,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 四首 其二","author":"吴绡","text":"江南忆，女伴采莲期。\n水似玻璃人似玉，薄妆偏趁晚凉时。\n兰桨日迟迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21899,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 四首 其三","author":"吴绡","text":"江南忆，秋气夜方清。\n鲈鲙鲜肥莼菜滑，千人石上月亭亭。\n到处按歌声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21900,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 四首 其四","author":"吴绡","text":"江南忆，地暖早梅香。\n长夜不禁朝起早，一枝如玉鬓云旁。\n呵手试试妆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21901,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅花引","author":"吴绡","text":"晚风寒。\n晚妆难。\n玉破帘前冬又残。\n倚阑干。\n倚阑干。\n闲把一枝，无人惟自看。\n年年愁过芳菲节。\n今朝又见花如雪。\n泪珠弹。\n泪珠弹。\n抛却粉奁，不教开镜鸾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21902,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"东坡引 听弦","author":"吴绡","text":"冰弦何处曲。\n弦畔纤纤玉。\n珍珠乱泻声声续。\n断肠销尽烛。\n断肠销尽烛。\n愁多怕听，春山暗蹙。\n恨往事，心头触。\n廿年噩梦将人促。\n残棋刚半局。\n残棋刚半局。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21903,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"瑞鹧鸪 出歌姬","author":"吴绡","text":"筵前檀板试新声。\n娇喉啭处听春莺。\n短发齐肩，似束腰肢小，更喜双眸片月清。\n杨花本是无情物，等闲化作浮萍。\n当年费尽黄金。\n辛苦缘歌舞，教初成。\n雨散云飞一梦醒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21904,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"千秋岁引 画梅花扇赠尼","author":"吴绡","text":"半夜窗前，一枝墙角。\n甚处风光到廖廊。\n东君已许阳和放，笛声何故翻教落。\n不禁风，偏宜月，休抛却。\n笑我半生真命薄。\n没事被它闲事缚。\n暗把梅花自评度。\n清香此际无多日，明朝再到还萧索。\n驾三车，皈三宝，心相约。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21905,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"汉宫春 夏景","author":"吴绡","text":"午梦初回，见满庭花影，烟罩香阶。\n一架浅红深绿，蜀缬云排。\n纤钩长带，乱纷纭、掩映楼台。\n畅好似、邻墙上，笑隐双腮。\n多是天公有意，怕春光归去，羯鼓相催。\n倩它暖风浓露，剩染繁开。\n阑干那畔，无聊长月，几遍徘徊。\n记得我、因贪艳朵，半空抓住金钗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21906,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杏花天","author":"吴绡","text":"今年一倍春光早。\n燕子话，杏园消耗。\n马啼踏遍青青草。\n惹袖东风偏好。\n贺太厦、羡伊飞绕。\n对美景、欢情多少。\n宵来惊蛰雷声报。\n满眼曲江花笑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21907,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"画堂春 萱花","author":"吴绡","text":"一枝花发北堂幽。\n无聊长日悠悠。\n轻风浓日画阑头。\n绿嫩红柔。\n粉蝶不知人意，纷纷来往绸缪。\n双眉常自曲如钩。\n莫说忘忧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21908,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"吴绡","text":"曾见西施出浣纱。\n一钩香迹印弓鞋。\n绿波红映脸边花。\n重到没人山寂寂，满滩银砾净无瑕。\n夜来春雨水痕加。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21909,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渔家傲 春晓","author":"吴绡","text":"春日春光何处好。\n窗前数朵梅花早。\n残梦乍回云缥缈。\n魂去杳。\n香风阵阵吹来巧。\n枝上青禽声缭悄。\n分明问我情多少。\n万斛闲愁浑不了。\n无聊自把寒衾搅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21910,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春光好","author":"吴绡","text":"风力软，弄晴天。\n柳如烟。\n水满平湖看画船。\n簇神仙。\n百舌黄鹂交语，一声一啭堪怜。\n好花多在鬓云边。\n晓妆鲜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21911,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆王孙","author":"吴绡","text":"方诸影转欲黄昏。\n消息沉沉暗断魂。\n拜月无心心自焚。\n忆王孙。\n深院凄凉独掩门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21912,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 病怀","author":"吴绡","text":"早潮扬子舟难舣。\n一曲湘江，送断危弦指。\n风雨落花明月底。\n芭蕉寸寸衔心里。\n粉融湿透风前泪。\n花饭谁餐，伏枕知何计。\n王孙不来侬自去。\n游魂千刻追千里。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21913,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"疏帘淡月 咏怀","author":"吴绡","text":"云收烟霁。\n见澹月疏帘，芳心欲碎。\n声断玉箫凤远，秦楼如水。\n凄凄画角残更迟，香篝冷、熏消鸳被。\n孤灯昏照，三星惨烈，阑干徒倚。\n叹寂寞、长门深闭。\n红于泪染，黄花憔悴。\n展掩西风寒悄，归期垂切。\n花笺难缀离情味。\n记行云、驰神千里。\n鸾音盼断，阳台梦隔，踌躇无寐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21914,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 送举","author":"吴绡","text":"陌上槐花人欲去。\n万种思量，无计教伊住。\n枕畔星星和泪语。\n伤心此夜天将曙。\n旅舍风尘留客处。\n仆马纷纭，千里京华路。\n月里一枝君自许。\n看花好与花为主。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21915,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 问第","author":"吴绡","text":"正是红闺三月暮。\n喜鹊双双，莫道无凭据。\n拭尽啼痕千点雨。\n泥金两字传佳语。\n莫问离情愁几许。\n壁上屏间，题遍怀人句。\n得意马蹄狂似絮。\n不知今夜眠何处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21916,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"贺新郎","author":"吴绡","text":"花满蓝桥路。\n画眉郎，春情似海，屏开金雀。\n锦绣香车珠翠拥，一派银筝画鼓。\n看鸾凤、绕身飞舞。\n椽烛花红光似画，彩繵铺、旋旋移莲步。\n烟篆起，博山雾。\n人间天上相逢处。\n隐罗帷、千回万转，未容轻许。\n漏点不禁良夜短，月落嫦娥厮妒。\n回玉枕、鸳鸯交语。\n两两同心双结取。\n笑楚台，当日巫山雨。\n常比翼，白头誓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21917,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹊桥仙 七夕","author":"吴绡","text":"鹊桥高挂，银河水浅，看一搦、纤身轻度。\n离多会少不堪言，漫道是、欢娱有数。\n斗回珠影，月分半镜，愁对客槎来路。\n相思相守似伊时，险羞煞、巫山朝暮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21918,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卜算子 咏莲","author":"吴绡","text":"谁种白莲花，秋到花开处。\n陶令腾腾醉欲归，香满庐山路。\n莫笑出青泥，心净还如许。\n一片琉璃照影空，常向波中住。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21919,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉楼春","author":"吴绡","text":"九十风光愁里度。\n莺声燕影春将暮。\n玉楼一望柳如烟，门外可怜千里路。\n梦中何事频频语。\n梦觉莫知云去处。\n旁人虚自妒蛾眉，对镜不禁愁黛聚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21920,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆秦娥","author":"吴绡","text":"春萧索。\n愁红满眼风吹落。\n风吹落。\n柳丝烟雨，朦胧楼阁。\n美人妆罢开朱箔。\n才过寒食罗衫薄。\n罗衫薄。\n正思闲事，举头闻鹊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21921,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花","author":"吴绡","text":"梦残莺溜，渡头桃叶春波皱。\n何处香风，掷果轻车蓦地逢。\n珠喉戛玉，红豆抛来眉黛蹙。\n画栋飞尘，犹共馀香恋锦茵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21922,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 题画梨花白燕","author":"吴绡","text":"绮窗春浅，香熟梨云深小院。\n斜亸东风，零乱残妆粉半融。\n差池并语，剪剪飞来双玉羽。\n青掩重门，人与花枝总断魂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21923,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆秦娥 春景","author":"吴绡","text":"花如雪。\n匆匆又过清明节。\n清明节。\n清寒渐退，好风和月。\n蝶儿粉翅莺儿舌。\n曲阑香径多周摺。\n多周摺。\n踏青人散，一年离别。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21924,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆秦娥 夏景","author":"吴绡","text":"争笑语。\n澹妆出避朝来暑。\n朝来暑。\n水溅双桡，翠萍开处。\n生凉一阵疏疏雨。\n芰荷香里人归去。\n人归去。\n湘覃纱厨，那时何许。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21925,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆秦娥 秋景","author":"吴绡","text":"虫声咽。\n星星萤影飞不迭。\n飞不迭。\n碧梧风细，夜声凄切。\n长空云静音鸿绝。\n天公谁解修明月。\n修明月。\n嫦娥薄命，不胜圆缺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21926,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆秦娥 冬景","author":"吴绡","text":"兰膏竭。\n长宵最苦灯儿灭。\n灯儿灭。\n梦回无语，纸窗风裂。\n迢迢玉漏声悲咽。\n霜飙搅动檐边铁。\n檐边铁。\n频敲枕上，拥衾听雪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21927,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青玉案","author":"吴绡","text":"姑苏曾是繁华处。\n叹寂寞、闲来住。\n转眼年光三月暮。\n几朝晴暖，几番风雨。\n容易春来去。\n帘前隐隐门前路。\n肠断梁边燕飞去。\n但是情来惟独语。\n花间诗酒，塘边箫鼓。\n烟景漫空絮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21928,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一丛花","author":"吴绡","text":"天空露爽火西流。\n篱下一丛秋。\n翠绡香澹黄花早，听络帏啾啾。\n陇水悲凉，衡鸿凄侧，种种助人忧。\n风清月冷旅窗幽。\n何处弄箜篌。\n如思似怨声忉怛，却难怪、宋玉多愁。\n肠断王孙，魂消蝶梦，百憾在心头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21929,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令","author":"吴绡","text":"灯与前宵一样，月与前宵一样。\n斗帐绣罗衾，也与前宵一样。\n两样。\n两样。\n不见五更天亮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21930,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇","author":"吴绡","text":"春雨春风，睡起花飞散。\n无心匀面。\n闷倚栏杆遍。\n自卷珠帘，放出双双燕。\n垂杨院。\n深下葳蕤，光景深如电。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21931,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"绣带子","author":"吴绡","text":"秋到海棠红。\n珠露滴芳丛。\n此际禅心如水，阶下数声蛩。\n色色更空空。\n多少事、暮鼓晨钟。\n须教领取，一庭花影，别是宗风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21932,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长相思","author":"吴绡","text":"风也秋。\n月也秋。\n数声促织夜悠悠。\n石畔画阑头。\n花也愁。\n蝶也愁。\n色空空色梦难留。\n人事水东流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21933,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"斗百花","author":"吴绡","text":"一片韶光明媚。\n当日吴王醉处。\n园林万点胭脂，人面纷纷相觑。\n满眼繁华，共看阆苑千年，莫有武陵人住。\n蝶蜂争来去。\n香径花洲，闻道讴歌盈路。\n行春五马，悠悠隼旗沾絮。\n戟户森严，几枝乍折红芳，最喜连朝甘雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21934,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"黄莺儿 画苹果花","author":"吴绡","text":"别样不胜娇。\n软丝丝、缀碧条。\n海棠姿态些儿较。\n嫩红酥欲消。\n淡胭脂带潮。\n香生玉魇轻含笑。\n最难描。\n风情无限，半晌却停毫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21935,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"黄莺儿 樱桃花","author":"吴绡","text":"小朵及春开。\n怪秦源、未解栽。\n成蹊无语君休爱。\n微红粉腮。\n宜妆笑来。\n花飞樊素朱唇在。\n闲根荄。\n珍禽偏惜，含到莫疑猜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21936,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"黄莺儿 虞美人草","author":"吴绡","text":"纤影弄轻风。\n记闲歌、楚帐中。\n盈盈欲舞轻身动。\n英雄路穷。\n佳人泪红。\n莲花恨血胭脂重。\n别重朣。\n千年艳魄，争忍过江东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21937,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"黄莺儿 洛阳花","author":"吴绡","text":"几点守宫砂。\n茜红生、剪彩斜。\n一丛嫩绿纤枝亚。\n轻轻碎霞。\n茸茸细芽。\n胭脂拂绰徐熙画。\n莫言夸。\n洛阳名好，休羡牡丹花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21938,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"黄莺儿 淡竹叶","author":"吴绡","text":"嫩碧长阶前。\n似新篁、叶叶烟。\n黛痕细折天生茜。\n铜花也欠鲜。\n石花也未妍。\n青螺一点枝头颤。\n翠为钿。\n玉台妆罢，宜贴两眉边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21939,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"黄莺儿 蝴蝶花","author":"吴绡","text":"日暖草花芳。\n满丛开，粉拍光。\n分明栩栩韩凭样。\n似临风探香。\n怕轻飞过墙。\n垂须展翅青枝上。\n石阑边。\n几回欲画。\n点笔笑滕王。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21940,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"黄莺儿 夹竹桃","author":"吴绡","text":"疏影碧云斜。\n倘嫣生，茜色加。\n丹葩嫩节春无价。\n秦人种它。\n王猷爱它。\n纤纤桃竹勾栏下。\n不争差。\n香筠苒弱，细碎贴朝霞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21941,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"黄莺儿 寿李花","author":"吴绡","text":"叶叶自相当。\n爱翩翩、一树芳。\n交辉花萼欢无恙。\n怀思正长。\n同根莫妨。\n绿情体物多名状。\n细斟量。\n田荆比并，犹恨雁分行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21942,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"闲中好二首 其一","author":"左锡璇","text":"闲中好，月色穿窗冷。\n幸有合欢花，低徊伴孤影。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21943,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令 其一 蝴蝶","author":"左锡嘉","text":"春漾游丝庭院。\n薄翼香黏花片。\n瘦影乞谁怜，帘底女郎窥见。\n窥见。\n窥见。\n飞上画罗团扇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21944,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"烛影摇红 元宵灯宴","author":"阮恩滦","text":"明月随人，碧空一色烟峦照。\n凤城火树璨银花，争向云阶耀。\n疑似红梅放了。\n只须臾、暖烘林表。\n霞觞泛艳，冰盏烧脂，楼台低峭。\n彩射千层，此时倍觉春容好。\n南油西漆爱辉煌，罗绮纷环绕。\n最是妆成闹扫。\n说虬签、休来报晓。\n今宵不禁，更买来宵，金钱多少。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21945,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"汉宫春","author":"阮恩滦","text":"曹氏开先。\n更诸儒继后，选学遥传。\n回思旧时堂构，都付榛烟。\n幸存故阯，记吾家、卜筑林泉。\n愿自此、萍蘩永祀，馨香俎豆年年。\n莫道风流云散，念门墙桃李，多士班联。\n寻来雪泥鸿爪，馀韵留连。\n依依斜照，喜高楼、百尺参天。\n任罗贮。\n名书万卷，未教媲美前贤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21946,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"高山流水 选楼理琴","author":"阮恩滦","text":"选楼修竹峭寒侵。\n按冰丝、指冷瑶琴。\n弹到月明时，蟾辉朗彻遥岑。\n试回首、落雁沉沉。\n声停处，别有悠扬逸韵，暗度疏林。\n只钟期难觅，山水意何深。\n披襟。\n清风入怀抱，爱涔然、古调愔愔。\n出土忆号钟，廿字独矢丹忱。\n感沧桑、触物惊心。\n念今日、但问移宫换羽，谁是知音。\n况无弦、真趣三味，费研寻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21947,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"琐窗寒 消寒","author":"阮恩滦","text":"冻雪拳鸦，深松隐鹤，绮窗风紧。\n貂茸护暖，减了弄妆清兴。\n问园梅、开将未开，小阑浅压苔枝冷。\n忆六朝山色，愁娥难画，峭寒同警。\n云影。\n西楼暝。\n正酒熟枫根，笛飘竹径。\n灯帘自倚，销得玉釭兰烬。\n怕窥檐、霜月半棱，夜阶渐觉遥漏静。\n且围炉、小试龙团，也胜椒花饮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21948,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"庆清朝慢 除夕听爆竹声","author":"阮恩滦","text":"蛇壑年华，凤城灯火，东风催动春声。\n神弦乍歌迎送，上烛霄明。\n听向南邻北舍，流光电挚总心惊。\n才一瞥，蝶衣碎迸，翻讶飞霙。\n岁已尽，漏正永，试问夜何许，夜转三更。\n最是铜街叠鼓，依约雷鸣。\n犹记椒筵散后，千门歌吹杂箫笙。\n银台畔，腊花送喜，还缀琼英。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21949,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"迎春乐","author":"阮恩滦","text":"四时美景知多少。\n算惟有、春光好。\n园梅争报齐开了。\n只几日、东风峭。\n问何处、玉箫声绕。\n倚亭畔、暗香飘渺。\n那得瑶台月夜，醉索巡檐笑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21950,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏初临 平山堂看龙舟","author":"阮恩滦","text":"高阁凌霄，长坂掣练，正逢竞渡芳游。\n遥指旌旗，回旋三两龙舟。\n满湖烟景齐收。\n沸笙歌、乱逐中流。\n锦波荡桨，春雷叠鼓，作势昂头。\n当年阑槛，种柳依依，醉翁陈迹，鸿雪空留。\n青山无恙，哀弦豪竹都休。\n罗绮云稠，笑无端、极目凭楼。\n惹闲愁。\n几多鳞爪，惊起沙鸥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21951,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"扬州慢","author":"阮恩滦","text":"万点疑星，四围如画，往来半是灯舟。\n正繁弦急管，响彻大江流。\n忆邗上、湖亭逭暑，清歌檀板，鼓吹都休。\n怎人移星换，旬馀疑隔三秋。\n一轮皓月，喜此时、同照山丘。\n更烛影摇红，波光耀彩，几费凝眸。\n生怕汝南鸡唱，知慈云、返棹难留。\n这馀辉长夜，顿添无限新愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21952,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 吴江舟次","author":"阮恩滦","text":"江北江南暮霭平。\n濛濛烟树雨初晴。\n万家灯火隔湖明。\n风送归云栖断岭，星连寒月带孤城。\n轻帆一刻过松陵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21953,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令","author":"阮恩滦","text":"愁。\n羽檄纷驰又一秋。\n频回首，惆怅水西流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21954,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"剔银灯 砚屏","author":"阮恩滦","text":"悄坐夜窗孤暝。\n不减临池清兴。\n试启银屏，照来瓦砚，隐约墨痕深映。\n凝眸细认。\n注潋滟、笔花流影。\n格写眠虫秀整。\n光冻讶螺清冷。\n玳几灯疏，金星奁小，比似晕妆窥镜。\n兰笺书尽。\n觉恍惚、有人遥领。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21955,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"碧桃春","author":"阮恩滦","text":"钱江山水秀灵钟。\n茫茫天地空。\n避■聊借作游踪。\n风光堪慰侬。\n云漠漠，雨濛濛。\n青松罗数峰。\n依稀身入画图中。\n何期逆旅逢。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21956,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"碧桃春","author":"阮恩滦","text":"数椽茅屋接松杉。\n晴风明翠岚。\n碧林深处夕阳衔。\n依依春色酣。\n城市远，水云涵。\n终朝送客帆。\n只怜病骨似眠蚕。\n轻寒怯茜衫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21957,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]