[{"title":"梅 其一","author":"黄文仪","text":"栖烟压雪横篱落，蘸水笼沙带月开。\n数点春心花里现，香清韵细绝纤埃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3732,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅 其二","author":"黄文仪","text":"玉骨冰魂雪后姿，黄昏月色暮钟时。\n板桥流水香初度，竹外横斜见一枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3733,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅 其三","author":"黄文仪","text":"幽姿何必傍瑶台，笑傲冰霜寂历开。\n流水空山尘不到，孤芳解占百花魁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3734,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅 其四","author":"黄文仪","text":"玉立佳人窈窕姿，园林掩映几多时。\n横斜影里萧萧竹，冷月疏烟伴最宜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3735,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅 其五","author":"黄文仪","text":"寒风吹下月棱棱，浅抹疏烟薄霭蒸。\n瘦影一篱霜满地，罗浮梦醒冷于冰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3736,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅 其六","author":"黄文仪","text":"天女维摩本绝尘，香魂同化此花身。\n雪中特为开生面，看取枝头数点春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3737,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅 其七","author":"黄文仪","text":"木落山枯霜雪清，江头千树淡烟横。\n水流香动黄昏月，戒夜钟敲第一声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3738,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅 其八","author":"黄文仪","text":"江村霜冷寂无哗，吟屋萧疏几树斜。\n瘦到骨时香到骨，严寒始放一枝花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3739,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅 其九","author":"黄文仪","text":"书声澈夜月泠泠，斜影当窗雪满亭。\n幽气袭人香冉冉，霜高瘦却玉肌青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3740,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅 其十","author":"黄文仪","text":"雪冷前村流水香，溪桥千树月痕凉。\n冰肌耐却寒威瘦，缟素魂交睹靓妆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3741,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅 其十一","author":"黄文仪","text":"雪花封处是瑶台，冷对清樽雪夜开。\n酒醒梦回风细捲，琼英飞落满苍苔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3742,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅 其十二","author":"黄文仪","text":"霜风吹下雪漫漫，香处梅花破笑颜。\n云冷月明清有韵，高枝攀摘细加餐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3743,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅 其十三","author":"黄文仪","text":"寒风裂石破天垠，万本梅花著色新。\n雪里幽姿开半面，空山明月见精神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3744,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅 其十四","author":"黄文仪","text":"枫落溪湾弃叶红，孤山千树月明中。\n自从逋客微吟后，寂寞枝头笑冷风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3745,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅 其十五","author":"黄文仪","text":"烟锁云埋玉冰隈，香从何处贵疑猜。\n行过寂寞江村路，始见琼瑶几树开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3746,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅 其十六","author":"黄文仪","text":"青灯影里萧疏树，雪后风微气吐氛。\n醉倚玉楼频赏望，横吹铁笛叫寒云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3747,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅 其十七","author":"黄文仪","text":"冰姿铁干水云隈，日日寻芳探几回。\n踏遍双鞋香迹冷，风霜历尽始春来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3748,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅 其十八","author":"黄文仪","text":"冲寒傲雪本来身，老干横开数点春。\n洁白最宜松竹伴，幽馨应不染风尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3749,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅 其十九","author":"黄文仪","text":"嚼蕊和花带雪餐，清香气味沁脾肝。\n藐姑不食人间火，饱受风霜炼玉颜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3750,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅 其二十","author":"黄文仪","text":"竹堂开处掩柴门，嚼蕊含香树树芬。\n会得花前三弄意，笛声吹破陇头云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3751,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清閒","author":"黄文仪","text":"吸取清华露，如斟绿玉琼。\n心空秋月白，兴阔海潮生。\n欲与梅为友，常随鹤作朋。\n偶来松树下，侧耳听莺声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3752,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"瓶花","author":"黄文仪","text":"胆瓶斜插一枝香，雨意风情贴处详。\n好与如兰共芬馥，长帘不捲静留芳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3753,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其一","author":"黄文仪","text":"山耸千重绿，堂开一镜明。\n读来书几卷，坐到月三更。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3754,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其二","author":"黄文仪","text":"滴滴三更雨，萧萧五夜风。\n衾寒惊梦觉，煤烬落残红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3755,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其三","author":"黄文仪","text":"月落江含白，更残雾捲风。\n烟消天气赤，海日一轮红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3756,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其四","author":"黄文仪","text":"好鸟时时过，柴门日日关。\n苔青从雨长，花闹任莺喧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3757,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其五","author":"黄文仪","text":"雨后添诗兴，花前破笑颜。\n知音千古少，得趣一心欢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3758,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其六","author":"黄文仪","text":"适意诗千首，忘情酒几杯。\n酣歌邀落日，索笑对窗梅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3759,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其七","author":"黄文仪","text":"意可香初爇，多情月照人。\n梦游非有待，随意上牛津。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3760,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其八","author":"黄文仪","text":"吐尽英雄气，牢骚语不平。\n此心长炯炯，剑气九秋横。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3761,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其九","author":"黄文仪","text":"月过山移影，风来韵有香。\n曲栏花正吐，一院露华凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3762,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其十","author":"黄文仪","text":"迸下湘帘影，烧香坐月明。\n剑光腾匣白，寒气与秋清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3763,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其十一","author":"黄文仪","text":"桂雾沉沉碧，茶烟缓缓腾。\n诗情江海阔，心事玉壶冰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3764,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其十二","author":"黄文仪","text":"妙得鹅群趣，横斜任意挥。\n绿笺书去后，草法几人窥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3765,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其十三","author":"黄文仪","text":"香雾风斜捲，茶烟水碧烹。\n梦中应化蝶，晓起爱流莺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3766,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其十四","author":"黄文仪","text":"明月窥窗照，清风入户来。\n篆云抽缕缕，帘雾煖如煨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3767,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其十五","author":"黄文仪","text":"日落沉西屿，风微入暮云。\n断霞千里碧，散作九霄文。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3768,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其十六","author":"黄文仪","text":"霜寒黄叶地，日暮碧云天。\n坐爱斜阳景，晴岩起夕烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3769,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其十七","author":"黄文仪","text":"秋水连天碧，红云接地阴。\n凭栏时一望，岛屿共浮沉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3770,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其十八","author":"黄文仪","text":"波影摇江树，朝阳出海门。\n归舟何处客，款乃一声闻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3771,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其十九","author":"黄文仪","text":"蟹眼声初咽，跳珠雪乱翻。\n清神与涤兴，玉水洒灵源。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3772,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其二十","author":"黄文仪","text":"铜漏随风永，青灯照夜长。\n恍然如有悟，星斗尽文章。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3773,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其二十一","author":"黄文仪","text":"梦中游八极，悟景到三天。\n始探蓬壶事，翻惊日似年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3774,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其二十二","author":"黄文仪","text":"奥室门谁启，沉思妙入神。\n潜心生慧业，妙悟见天真。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3775,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其二十三","author":"黄文仪","text":"理绪重重折，文思缕缕开。\n清机相引处，悟景豁然来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3776,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒居杂咏 其二十四","author":"黄文仪","text":"若有神阴告，都缘思虑深。\n欲穷三圣业，须尽一生心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3777,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"溪泉","author":"黄文仪","text":"行到前溪乱石间，流泉漱玉韵潺潺。\n一声飞鸟松林外，云坠波心月在山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3778,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"学道","author":"黄文仪","text":"学道须参窍妙禅，要凭慧业了机缘。\n情尘不断高于岳，心镜长明光在天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3779,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晓日","author":"黄文仪","text":"晓日未升云气重，轻雺薄霭醉芙蓉。\n山因寒瘦犹如睡，花为烟迷看似慵。\n飞鸟鸣时欹叶坠，幽猿啼处密林封。\n棱棱霜彻衣衾冷，梦醒神清午夜钟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3780,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醒来","author":"黄文仪","text":"竹外风泠韵似钟，醒来夜色月明中。\n空山尚有叶乾落，老干都经雾暗封。\n炉火细添香欲袅，兰煤剔尽蕊开浓。\n半床经卷无穷业，坐对银缸气肃恭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3781,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醒来 其一","author":"黄文仪","text":"屋角云堆墨，江阴日坠红。\n天低垂岸阔，树暗觉烟笼。\n炎地寒无雪，疏林籁有风。\n月高惊梦起，两鬓乱如蓬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3782,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醒来 其二","author":"黄文仪","text":"月隐江天树，风吹海国云。\n断霞成散绮，归雁带斜曛。\n枫落千山瘦，潮平两岸痕。\n氤氲香满座，雅爱爇思闻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3783,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醒来 其三","author":"黄文仪","text":"暮色苍然来，前山雾气埋。\n冷风侵煖榻，淡月照高台。\n独鹤云边至，孤鸿海上回。\n岁寒珠树好，留汝共徘徊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3784,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醒来 其四","author":"黄文仪","text":"睡觉思懵懵，空山响夜蛩。\n湘帘筛淡月，竹树战悲风。\n鹤岂离矰缴，鸿应脱网罿。\n乘桴如有意，一叶任西东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3785,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"禅关","author":"黄文仪","text":"物趣由来妙入禅，当空一印印千川。\n夜钟冷击山头月，万壑松萝起暮烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3786,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"斋中閒居 其一","author":"黄文仪","text":"茅屋萧然静不哗，幽居何物作生涯。\n数枝黄菊閒时酒，一炷清香醒后茶。\n妙理细观如有悟，狂吟无意学名家。\n寻诗写兴供吾乐，入夜梅梢桂月斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3787,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"斋中閒居 其二","author":"黄文仪","text":"绿树侵檐竹绕庐，萧然还似野人居。\n霜棱梅吐千条白，露冷枫飞几叶疏。\n雁阵冲寒过极浦，雪花带雨落前除。\n地炉松火钟敲夜，斗酒孤灯读汉书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3788,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"罗浮梦 其一","author":"黄文仪","text":"江头千树月黄昏，香满梅花欲断魂。\n缟素仙人来入梦，瑞烟笼罩枕娇云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3789,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"罗浮梦 其二","author":"黄文仪","text":"娇云坠砌玉姗姗，缟袂相将梦里间。\n忽觉霜华飞满地，寺钟远听韵閒閒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3790,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤邑四咏","author":"黄家鼎","text":"青阳时节雨潇潇，春到平冈景色饶。\n一抹轻烟迷凤鼻，几行新翠挂山腰。\n楼头灯火听偏寂，树里人家望转遥。\n正好栽桃兼植李，恩承膏泽发新苗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3791,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤邑四咏","author":"黄家鼎","text":"鲲南天设小琉球，一屿千家水上浮。\n灿烂晴霞明海市，迷离晓日现蜃楼。\n绮横平旦飞还驻，名类藩封禁又收。\n散锦焕文开盛运，孤悬片土亦瀛洲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3792,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤邑四咏","author":"黄家鼎","text":"猪毛山瀑注成溪，淡淡流泉细细泥。\n为爱风光浮竹筏，最宜月色映沙堤。\n石矶鱼影秋波浅，茅店鸡声客路迷。\n君子交情堪鉴此，更深吟过板桥西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3793,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤邑四咏","author":"黄家鼎","text":"劫灰已折旧时城，此地仍留赤嵌名。\n秋夏潮生晴亦涌，西南风定夜无声。\n残砖遍野疑霞落，新涨平堤带雨鸣。\n莫道奔腾犹贯耳，引看海宇正澄清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3794,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾吟 其一","author":"黄学明","text":"四溟中断此孤悬，日月轮高见影偏。\n泣泪鲛人朝入市，凝寒金气夜干天。\n马鞍矗起青全岛，鹿耳雄开障百川。\n盛气消沉无觅处，牛羊来下翠岩烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3795,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"七里香限芳字","author":"熊学鹏","text":"雪魄冰姿淡淡妆，送春时节弄芬芳。\n著花何止三回笑，惹袖犹馀半日香。\n竟使青蝇垂翅避，不教昏瘴逐风狂。\n灵均莫漫悲兰茝，正色宜令幽谷藏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3796,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"方司马惠九头柑柬谢限三字","author":"熊学鹏","text":"海壖残腊试霜柑，才挹清香兴已酣。\n采自千头金颗重，携来九瓣玉浆甘。\n种传瓯粤原无匹，宴饮华林旧赐三。\n不是乘槎远行役，殊方佳味那能谙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3797,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赪桐花限龙字","author":"熊学鹏","text":"枝柔叶厚碧痕浓，色艳还看花发重。\n朱萼临风迷紫蝶，丹须和露抱黄蜂。\n剪残红锦枝头见，敲碎珊瑚月下逢。\n好是年年誇竞渡，鲜妍如火映鱼龙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3798,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"球屿晓霞","author":"蔡江琳","text":"海外生奇巘，球峦映晓霞。\n吐光争绣轴，悬彩斗红纱。\n片片流丹染，层层紫色遮。\n佛头青未了，仙岛翠交加。\n糁树辉连绮，蘸峰映郁华。\n方知霄壤阔，浮岛望中赊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3799,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西瓜","author":"郑际魁","text":"莫将萍实异兹看，老邵当年学种难。\n青蔓依微缘力弱，含香独抱此心丹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3800,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤山竹枝词 其一","author":"卢德嘉","text":"巧制蛟螭灯夕逢，盘旋屈曲肖形容。\n家家竞放连珠炮，多少儿童呼弄龙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3801,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤山竹枝词 其二","author":"卢德嘉","text":"士女纷纷到八庄，元宵三日正迎王。\n乞糖乞米求多福，一倍还须两倍偿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3802,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤山竹枝词 其三","author":"卢德嘉","text":"乡人有子娶新娘，待到三朝始拜堂。\n若问何仪为执贽，荷包个个绣鸳鸯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3803,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤山竹枝词 其四","author":"卢德嘉","text":"堪笑乡愚寡见闻，些些曲直竟难分。\n欲教省事凭何法，罚个槟榔便解纷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3804,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤山竹枝词 其五","author":"卢德嘉","text":"凤梨山下是侬家，郎若閒时来吃茶。\n采叶为丝成几两，寄郎城内换绵花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3805,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤山竹枝词 其六","author":"卢德嘉","text":"郎来视妾纺绵花，妾纺绵花郎卖纱。\n花价怕昂纱怕贱，莫教容易看摇车。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3806,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤山竹枝词 其七","author":"卢德嘉","text":"一带渔家住海边，乌鱼捕得庆盈船。\n正头肥美回头劣，入市人人问价钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3807,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"泮水荷香","author":"钱元扬","text":"方池十亩尽荷花，胜赏应怜此地奢。\n岸影涨红疑烈火，水光回映想流霞。\n清能拔俗因风远，色不因人带日斜。\n解道禅心无住著，轻芳送入野人家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3808,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]