[{"title":"青县","author":"鲍桂生","text":"滑滑清州道，驱车趁夕晖。\n春风吹驿柳，残雪上征衣。\n水浅鸥争拍，城低鸟碍飞。\n荒唐盘古墓，化鹤几时归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31030,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青县道中","author":"王增年","text":"残日荒荒照大河，敝车羸马此经过。\n晚来无限苍凉意，偏入行人望里多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31031,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"兴济道中","author":"张庆恩","text":"黏天草色碧萋萋，人影斜阳杂马蹄。\n去日曾经花满树，归来但见絮沾泥。\n情知熟路无庸问，事有伤心每怕提。\n漫道离家百余里，在途一日亦羁栖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31032,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和张树筠先生咏怀二首 其一","author":"陈增源","text":"岐黄垂训几多年，惟有先生得奥玄。\n诊脉神超三九候，调方义贯万千篇。\n活人妙诀时时用，济世真言代代传。\n更喜萱帏康健在，莱衣绚彩药陶然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31033,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和张树筠先生咏怀二首 其二","author":"陈增源","text":"轻财重义似疏狂，苦读医书目渐伤。\n伊圣汤醪原自作，炎皇药饵亦亲尝。\n人情在在期长寿，天德生生不尽藏。\n衣钵克承为哲嗣，从今德泽更无量。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31034,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"兴济口占题壁","author":"刘传任","text":"历碌邮程簿笨车，秋风萧瑟日西斜。\n故园小住浑如客，旅舍重经便似家。\n怕遇亲朋谈仕宦，且听父老话桑麻。\n回头百里高城路，已隔徒骇水一涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31035,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"舟过青县书所见","author":"潘乃光","text":"小邑尚弦歌，维舟偶见过。\n浪游偏我惯，赛会到春多。\n日暖风仍细，沙平路不颇。\n牛车载村女，乘兴复如何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31036,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"兴济镇邸壁","author":"王佑曾","text":"日暮途长马足忙，孤村高树隐苍茫。\n河声直共秋声吼，酒气难浇夜气凉。\n星汉依依低野店，旌旗黯黯动沙场。\n明朝早起呼童仆，料理征衫向故乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31037,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和青县张树筠先生咏怀二首 其一","author":"李奉璋","text":"先生质朴率天真，济众情殷在活人。\n学邃无惭三世业，功深可普万家春。\n不营重利惟由义，广布良方只好仁。\n信是君心多宿慧，秦医和缓属前身。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31038,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和青县张树筠先生咏怀二首 其二","author":"李奉璋","text":"三津施诊著良名，针灸兼优术倍精。\n声色望闻无俗见，阴阳虚实得详情。\n卅年却病皆神效，半世编书重卫生。\n久仰萱堂登上寿，一门孝悌振家声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31039,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和青县张树筠先生咏怀五首 其一","author":"庞履廷","text":"医罢归来卧草堂，生涯窃自效韩康。\n参苓术草药笼备，采向天台岁月长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31040,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和青县张树筠先生咏怀五首 其二","author":"庞履廷","text":"游历南洋十数年，医人尝自问心田。\n我公即得岐黄术，还幸传家子象贤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31041,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和青县张树筠先生咏怀五首 其三","author":"庞履廷","text":"好读医书莫笑痴，存心须怀有天知。\n眼伤何损孙思邈，衣钵相传自有儿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31042,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和青县张树筠先生咏怀五首 其四","author":"庞履廷","text":"药书涉猎记从前，济世平生不爱钱。\n敢谓清廉夸品节，养生窃幸有良田。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31043,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和青县张树筠先生咏怀五首 其五","author":"庞履廷","text":"长兄能友弟能恭，廉让家风比孔融。\n寿永萱堂多幸福，孙谋燕翼乐无穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31044,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"与青县陈甥矩亭话旧","author":"苏守庆","text":"忧患余生梦后天，搬荆重话乱离前。\n裕之身世悲何极，元亮归来事可怜。\n衰惫羞言甥似舅，沧桑真见海成田。\n中原烽燧何时靖，愿尔能挥祖逖鞭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31045,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"兴济早发","author":"隋恩湛","text":"裘敝不支晓，寒威仗酒攻。\n村荒鸡唱月，野旷马嘶风。\n客梦摇征铎，行踪笑转蓬。\n谁家酣睡里，炉火尚埋红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31046,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杨莲甫督部阅师马厂有诗索和不得已依韵赋呈","author":"王振尧","text":"良平不武勃无文，名世当朝作庆云。\n词苑旧传羽猎赋，国威重见背嵬军。\n苍凉战史寻龙血，熠爚兵符切玉纹。\n薄海归心元老在，从容巾扇靖纷纭。\n上兵应自伐谋先，笑睨邻王左右贤。\n真见老罴横卧道，肯教虏马近窥边。\n北门管钥防秋地，西汉楼船肄武年。\n但使执戈同卫国，不须计亩策屯田。\n临流立马晓尘清，玉帐无声画角鸣。\n八阵风云随手变，九霄日月照心明。\n禁中有语询颇牧，天上何时洗甲兵。\n橐笔从军老王粲，辕门尚听鼓茄声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31047,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"马厂","author":"言敦源","text":"蘋波初汛木兰艭，春水船儿打桨双。\n最好日斜风力足，女墙帆影落晴窗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31048,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题阙 其一","author":"杨文敬","text":"八载谈兵事大难，词臣今日始登坛。\n金针琐碎牛毛细，莫作长枪大戟看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31049,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题阙 其二","author":"杨文敬","text":"金鞍柳叶天方马，宝鞘莲花日本刀。\n赵北健儿三万骑，一时齐拜将台高。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31050,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"重过西湖","author":"邹式金","text":"二十八年湖畔柳，春风不定常垂手。\n杜鹃啼断青山弦，玉兔衔残白堕酒。\n堤上芳心冷雨云，祠边杀气冲牛斗。\n红楼人去悄然空，燕子还寻旧巢守。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31051,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"周元亮奉赦南还龚孝升有诗赠别旋起青州道次韵和寄 其一","author":"邹式金","text":"昔日栖梧凤，曾为尧树乌。\n世方尊狱吏，望自属公孤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31052,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"周元亮奉赦南还龚孝升有诗赠别旋起青州道次韵和寄 其二","author":"邹式金","text":"岂意开圜室，谁曾赐鉴湖。\n万花含笑日，喜气到菰庐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31053,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"周元亮奉赦南还龚孝升有诗赠别旋起青州道次韵和寄 其三","author":"邹式金","text":"灯花明若镜，秉烛竟归人。\n垒块分中散，纷纶得大春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31054,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"周元亮奉赦南还龚孝升有诗赠别旋起青州道次韵和寄 其四","author":"邹式金","text":"琴书千里梦，金粉六朝身。\n路鬼揶揄好，人谁信汝贫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31055,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"周元亮奉赦南还龚孝升有诗赠别旋起青州道次韵和寄 其五","author":"邹式金","text":"祖帐应无及，春明键始开。\n江淮双带接，风雪片帆回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31056,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"周元亮奉赦南还龚孝升有诗赠别旋起青州道次韵和寄 其六","author":"邹式金","text":"高厚真邀福，神明宝爱才。\n凤凰飞去后，权作望京台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31057,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"周元亮奉赦南还龚孝升有诗赠别旋起青州道次韵和寄 其七","author":"邹式金","text":"忆昔曾游处，名山九曲斜。\n绿榕仁作叶，丹荔智为花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31058,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"周元亮奉赦南还龚孝升有诗赠别旋起青州道次韵和寄 其八","author":"邹式金","text":"庭静朝鸣鹤，衙清晚聚鸦。\n八闽诸父老，犹说雨随车。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31059,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"周元亮奉赦南还龚孝升有诗赠别旋起青州道次韵和寄 其九","author":"邹式金","text":"萍水当年事，云泥隔世情。\n君为周二老，身是鲁诸生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31060,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"周元亮奉赦南还龚孝升有诗赠别旋起青州道次韵和寄 其十","author":"邹式金","text":"龙剑风方壮，渔舟浪欲平。\n未能齐宠辱，端为得鳞惊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31061,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日同人集惠山分韵二首 其一","author":"邹象雍","text":"九龙增气色，千里集名贤。\n剑履纷台榭，松风沸管弦。\n唱酬齐雒下，凭吊惜平泉。\n惆怅愚公谷，繁华记往年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31062,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日同人集惠山分韵二首 其二","author":"邹象雍","text":"曲涧丛阴薄，晴岚藉草薰。\n故园星却聚，高会韵初分。\n人倚岩前树，风来岭上云。\n后期还共约，莫使惜离群。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31063,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"昔游","author":"邹治","text":"梦里山川笔底天，壮游应自倦加鞭。\n先生休矣羞弹铗，学者从之耻问仙。\n一笠苍茫空四海，三秋寂寞恨千年。\n逢人便欲埋名姓，何事重题白马篇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31064,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雨后鲍让侯招从春申涧饮泉即事","author":"邹溶","text":"返照逼林麓，闲门应息机。\n却逢新雨后，独向暮泉归。\n采药留红叶，寻源入翠微。\n经过殊不厌，相对狎鸥飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31065,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过东林精舍","author":"邹溶","text":"愁卧夕阳尽，长风吹四野。\n嗟予抱沉疴，迟此岁方夏。\n杖策来东林，钟远识兰若。\n石壁生夜凉，目极自潇洒。\n采芝寻仙人，把酒慕隐者。\n开襟屡回顾，长啸松林下。\n纷吾意念多，淡尔悟虚假。\n遥望白云中，日暮空潭泻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31066,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"百字令 闻蝉","author":"邹溶","text":"关心恁处，奈恼人、依旧夕阳一片。\n不是诉愁偏响急，高唱入云声远。\n岸柳枝头，官槐叶底，已觉金凤换。\n怜他薄鬓，玉台空冷钗燕。\n谁念独客单衣，向江南渭北，惯听凄婉。\n况值潘郎秋易老，休忆旧家庭院。\n不受风尘，恰宜疏放，何事常拘管。\n草虫唧唧，浅深月下相伴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31067,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"貂裘换酒 自题小象","author":"邹溶","text":"君貌平平尔。\n胡为乎、牢骚满腹，揶揄一世。\n多恐功名无福相，耽误半生狐矢。\n论天意，原非如此。\n昨日偶然翻邸报，坐苞苴，毕竟千金子。\n聊伴食，今之士。\n为农为贾良非是。\n莫因他，饥驱势泊，变生别计。\n如许二辞能了愿，赢得人呼狂士。\n便富贵、干卿何事。\n屠狗卖浆称密友，十余年，挈阔成生死。\n常北望，愁云起。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31068,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望海潮 题来青阁","author":"邹显吉","text":"暖风迟日，五侯池馆，帽檐欹侧频游。\n金雀翠鬟，文犀斜领，一行齐上帘钩。\n著处总温柔。\n记乌丝醉染，嘱咐亲收。\n屈指重来，今生不拟负风流。\n十年空敞貂裘。\n早高梧叶落，只索归休。\n蛛网罥檐，燕泥涴座，更谁同倚妆楼。\n暝色不胜愁。\n叹篆香心字，灰冷难留。\n试觅题笺，泪痕还染佩囊不。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31069,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"倪高士祠梅花","author":"邹显吉","text":"俎豆于今且复然，几经沧海变桑田。\n世间那识云林笔，当日还书至正年。\n曲涧低围连圃后，小池新凿在门前。\n梦中蝴蝶梅花下，清閟高人长夜眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31070,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"宿田家","author":"邹卿森","text":"小桡风渡日西时，士室相邀敢后期。\n亦自有家容我宿，岂缘无米寄人炊。\n秀眉稚子知难字，折臂村翁爱夜棋。\n同是农桑劳悴客，一宵判与醉中嬉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31071,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"初夏乡居","author":"邹卿森","text":"四月阴成已送梅，野人相见喜深杯。\n莲塘水煖收鱼子，兰径泥开避笋胎。\n梦断高城听夜柝，吟余小阁散空雷。\n楚山巫峡无消息，帘卷西窗雨正来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31072,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"惠山麓观枫林二首 其一","author":"邹卿森","text":"杖策披枫林，杳然秋山长。\n丘陵芥纡互，松柏滋烟霜。\n幽响出丛木，回飙亦已凉。\n目纵情更延，清泉闻空香。\n兹游复不易，恻恻情内伤。\n遐思结遗音，日夕劳相望。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31073,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"惠山麓观枫林二首 其二","author":"邹卿森","text":"美人薜荔衣，霜林好颜色。\n虽无餐霞姿，结侣自相得。\n岁寒知后凋，托根本质直。\n促景悲桑榆，履道苦荆棘。\n白日忽西驰，尘埃失南北。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31074,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江阴晓行","author":"邹本荃","text":"百里澄江路，衣侵晓雾轻。\n潮乘风势涌，露共日华明。\n岸隔荒村犬，声移绿树莺。\n归期拟此际，问寝待鸡鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31075,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"访友别业","author":"邹本荃","text":"结庐尘境外，短棹独差池。\n野旷天垂远，花深月到迟。\n青山堪入画，翠竹可题诗。\n一径幽栖处，时人总不知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31076,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自题画兰","author":"邹显文","text":"蓬窗秋欲暮，窄径正开时。\n纫佩香应满，援琴调更悲。\n风吹还馥郁，露重只低垂。\n独卧深山里，幽芳空自知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31077,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"闻雁忆三兄","author":"邹显臣","text":"芦花风动日光微，孤雁高翔带雨飞。\n淡月寒霜莎草畔，听君嘹唳欲沾衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31078,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"扫祖父母墓同兄黎眉衡湘弟衣言","author":"邹显臣","text":"魂兮招未得，想象下云端。\n落日松阴黑，高风木叶丹。\n墙垣苔藓没，华表薜萝盘。\n幽室千年在，先灵幸自安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31079,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"潜山道中","author":"邹奕凤","text":"古驿深山里，驱驰列嶂边。\n更无尘拂面，惟有翠连天。\n绕洞田皆玉，翔波鸟亦仙。\n輶轩逢此胜，敢诵采风篇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31080,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"贺新凉","author":"邹奕凤","text":"何处迎秋月。\n落霞低、名香漫爇，絪缊引月。\n净扫药栏和竹径，检点今宵坐月。\n陈瓜果、窗前伺月。\n品竹弹丝还按板，倩歌喉、应节频吹月。\n云幕卷，初开月。\n翩跹鹤舞婵娟月。\n擘琼笺、百篇挥洒，分题赋月。\n一缕铛烟茶已沸，倾向清瓯劳月。\n看花气、缤纷拥月。\n羁旅正金陵，虎踞龙争，历尽千秋月。\n且痛饮，秦淮月。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31081,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雨后池上读谢诗","author":"邹宫","text":"霁色涵空碧，流霞恋虚阁。\n芳池涨青萍，幽篁挺新箨。\n众卉斗苍翠，始悟熙春乐。\n疏泉青石磴，暝烟敛丘壑。\n鹤唳时一声，余音散林薄。\n披赏自忘疲，取酒聊斟酌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31082,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋晚南堤口占","author":"邹宫","text":"嚣尘那可道，爱此地殊偏。\n疏柳媚深渚，寒鸦薄野田。\n钟鸣原外寺，人唤渡头船。\n藉草聊相慰，悠然悟静缘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31083,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"仲山祠探梅","author":"邹士夔","text":"怪石重岩下，梅花一树横。\n风流已消歇，日暮听松声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31084,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寓华藏寺","author":"邹士夔","text":"石室松龛下，沿阶草色侵。\n自能消俗虑，何必问禅心。\n帘影度空翠，湖光澄碧林。\n法堂临涧水，终夕听鸣琴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31085,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"九月望日燕集蓉湖舟中因登惠山得洞字","author":"邹士夔","text":"龙山接胜游，群贤蔚鸾凤。\n高歌素侣多，小桨轻帆送。\n秋色草际浮，月华湖上动。\n乘醉复扪萝，同过若冰洞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31086,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"淮阴杂诗六首 其一","author":"邹祖符","text":"才渡黄河复运河，人家终日傍颓波。\n西风一夜潮头恶，何处宜防得力多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31087,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"淮阴杂诗六首 其二","author":"邹祖符","text":"狂飙吹浪汩金泥，侉子歌残极惨凄。\n几队红颜应官募，至今犹号女儿堤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31088,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"淮阴杂诗六首 其三","author":"邹祖符","text":"高垄湖田万顷平，今年新涨可怜生。\n晚来几阵蘋风起，个个渔航屋上行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31089,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"淮阴杂诗六首 其四","author":"邹祖符","text":"红妆结伴出香闺，扳得金鞍上马齐。\n羞与路旁年少并，扬鞭先过月堤西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31090,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"淮阴杂诗六首 其五","author":"邹祖符","text":"天花菌子色如银，青玉红樱缀满林。\n几日濯枝新雨过，鹧鸪声里采林檎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31091,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"淮阴杂诗六首 其六","author":"邹祖符","text":"年年晚涨税鱼租，红豆成时结网罛。\n齐向得鱼多处去，渔沟西北水晶湖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31092,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"荷花","author":"邹士荀","text":"曲阑青十二，独对此清涟。\n绿鬓对红颊，金环约翠钿。\n心多还自苦，丝弱为谁牵。\n惆怅黄昏后，鸳鸯咽露眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31093,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人","author":"邹嘉升","text":"一剑酬恩万古悲，杜鹃飞上最柔枝。\n风前欲语娇如许，相见当年夜宴时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31094,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"舟泊村西野步","author":"邹嘉升","text":"钱塘风掠水潺湲，杨柳桥西又北湾。\n红映数重村口树，青浮一点陇头山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31095,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春申涧","author":"邹嘉升","text":"吟社抛荒遍草莱，常留瀑布怒涛豗。\n探源直上层峦去，寻径遥看曲水来。\n草尽云根飞野马，山空地底走晴雷。\n游人载酒临流赏，应酹黄公一巨罍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31096,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]