[{"title":"谒金门 湖舫同内泛雨","author":"董元恺","text":"烟舫织。\n荡破满湖轻碧。\n一片楼台空翠滴。\n两峰连树失。\n帘外荷香堪裛。\n槛底鱼游争识。\n钗漾菱花鬟影湿。\n镜里随风入。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35374,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"好事近 薰笼","author":"董元恺","text":"数缕气氤氲，微透玲珑湘竹。\n小玉频添鹊脑，比衔花箫局。\n半薰绣幔半笼裙，尽放馀烟续。\n一任帘前被底，长共香奁宿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35375,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳含烟 至日韶阳见柳","author":"董元恺","text":"韶阳柳，季冬时。\n摇曳青青如许，添来宫线织成丝。\n舞腰肢。\n寒塘绿映春波晓。\n镇日黛眉颦笑。\n不吹风雪却吹烟。\n曲江边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35376,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"好时光 杨妃山茶","author":"董元恺","text":"一捻指痕轻染，千片汗色微销。\n乍醒沉香亭上梦，芳魂带叶飘。\n照耀临池处，恍上马映多娇。\n疑向三郎语，时作舞纤腰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35377,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一落索 咏风鸢","author":"董元恺","text":"鸷鸟凭空而起。\n云霄堪致。\n青春一线上青天，禁得无声堕地。\n怪底轻狂可喜。\n欲飞还止。\n十年前事忆儿童，此日依然故纸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35378,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆秦娥 其一 湖楼和内","author":"董元恺","text":"妆楼悄。\n锦塘风送闻啼鸟。\n闻啼鸟。\n湖光如梦，乱云缭绕。\n六桥裙带飘芳草。\n两峰高画春山小。\n春山小。\n珠帘初捲，画船多少。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35379,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆秦娥 其二 不归","author":"董元恺","text":"伤心极。\n年年惯作天涯客。\n天涯客。\n留他不住，送他不得。\n不如归去啼声咽。\n不归休记归时节。\n归时节。\n未容言语，又成离别。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35380,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏子 其一 寄忆","author":"董元恺","text":"旧愁人，新愁月。\n同是黄昏时节。\n人不见，月偏明。\n除非倩梦寻。\n寒衾拥。\n愁难送。\n不到四更无梦。\n莲漏滴，乳鸦啼。\n梦儿能几时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35381,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏子 其二 闺情，集唐词","author":"董元恺","text":"雨初晴，帘半捲。\n叠损罗衣金线。\n绡幌碧，粉屏空。\n灯花结碎红。\n思无穷，情未了。\n一炷后庭香袅。\n春如剪，雨如丝。\n风摇夜合枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35382,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏子 其三 闺情，集唐词","author":"董元恺","text":"绣帘垂，幽沼渌。\n倚遍阑干几曲。\n蘋叶软，草烟低。\n绿窗残梦迷。\n玉纤轻，凤箫歇。\n梦觉半床残月。\n兰烛灺，柳条空。\n此情千万重。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35383,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏子 其四 闺情，集唐词","author":"董元恺","text":"晚妆残，春态浅。\n远岫参差迷眼。\n千万恨，在心头。\n秋波横欲流。\n燕双双，人悄悄。\n残月光沉树杪。\n烟雾冷，画屏幽。\n吴山点点愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35384,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐 端午闺中词  其一 健人","author":"董元恺","text":"缕丝裁绢。\n小小人名健。\n但得一心常缱绻。\n两好时时对面。\n临风故作娉婷。\n看花想像仪形。\n任取钗横鬓乱，年年祝向芳龄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35385,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐 其二 茧虎","author":"董元恺","text":"冰蚕细茧。\n纤手亲裁剪。\n刻画爪牙眉与眼。\n一笑从风细转。\n有时綵笔描真。\n何须插艾为人。\n飘向玉钗头上，儿童竞取相亲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35386,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐 其三 长命缕","author":"董元恺","text":"谁能续命。\n五色交相映。\n浪说辟兵还压胜。\n茧馆珠囊堪赠。\n不须绕户高悬。\n料应妆臂同缠。\n愿取一丝一岁，与郎情绪绵绵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35387,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐 其四 辟兵符","author":"董元恺","text":"心前笑抚。\n神印穿金缕。\n销得五兵刚二五。\n好共钗头艾虎。\n依依插鬓宜春。\n翩翩佩带宜人。\n全仗赤符厮守，不教胆怯空庭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35388,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐 其五 绫包角黍","author":"董元恺","text":"萦丝楚粽。\n巧借针神缝。\n杂俎轻镂花影动。\n却比菰蒲郑重。\n陋他九子殊名。\n随他百索殊形。\n好是餐他秀色，鬓边袅袅婷婷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35389,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐 其六 菖蒲葫芦","author":"董元恺","text":"花阴午直。\n旋把菖蒲刻。\n依样雕锼纤指劈。\n细认灵根九节。\n五丝撷向霓裳。\n一樽醉泛瑶觞。\n共喜兰汤浴罢，携来倍觉芬芳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35390,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"误佳期 湖楼月夜，和龚芝麓先生韵","author":"董元恺","text":"月色初穿帘幕。\n掩映玉人绰约。\n满身花影倩扶持，几处清砧作。\n香销玉臂寒，雾冷金钗落。\n醉擘银筝信手弹，一曲秋云薄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35391,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"相思引 烧香曲","author":"董元恺","text":"暖语红窗体自芬，笑添沉水更氤氲。\n语香花气，常共夜深闻。\n一缕轻烟遮不住，剪来银叶衬还薰。\n炙成心字，双守鹊炉温。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35392,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆少年 春闺","author":"董元恺","text":"春尘如雨，春风如醉，春光如梦。\n春花独对也，只春波微动。\n剪破春阴春色好，更春情落红催送。\n萋萋春草碧，恰补春愁空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35393,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"荆州亭 登望湖亭","author":"董元恺","text":"咫尺烟云万状。\n摇曳帆樯百丈。\n放眼是江南，隔断一湖波浪。\n碧浸芙蓉春涨。\n白映楚天空漾。\n愿借马当风，安稳行人无恙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35394,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"眉峰碧 画眉","author":"董元恺","text":"早展菱花待。\n昨试轻螺在。\n盈盈斜印两春山，恰与秋波厮对。\n深浅还应配。\n浓淡都堪爱。\n不知何处送愁来，蛾弯两笔愁难载。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35395,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"阮郎归 窗前","author":"董元恺","text":"簸钱年纪只些些。\n垂鬟鬓未鸦。\n别来几度海桐花。\n窗前细认他。\n奁镜畔，绣帘遮。\n妆成覆额纱。\n一枝春色落谁家。\n眉边散晓霞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35396,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"画堂春 其一 蝴蝶花","author":"董元恺","text":"春烟春雨染浓芳。\n丝丝绣出春光。\n映阶碧草学轻狂。\n舞遍东墙。\n栩栩欲迷庄子，翩翩胜拓滕王。\n穿花潜入此花藏。\n细认钗梁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35397,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"画堂春 其二 十姊妹","author":"董元恺","text":"天然一色绮罗丛。\n妆成并倚东风。\n秦姨总与虢姨同。\n玉质烟笼。\n馥馥幽香密蕊，姗姗淡白轻红。\n相携竞入翠薇宫。\n不妒芳容。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35398,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"画堂春 其三 荷花蔷薇","author":"董元恺","text":"东风无力锦屏遮。\n依稀露软烟斜。\n繁华满径拂窗纱。\n翠剪明霞。\n高处牵衣欲语，低边弄影交加。\n一帘月色浸荷花。\n绿水人家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35399,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉连环 夜落金钱","author":"董元恺","text":"银屏碧锁空云叆。\n金绯绚彩。\n豫州赌胜掷红幺，试比青蚨几倍。\n纤手折来相对。\n五铢堪爱。\n秋光也自到贫家，一线斜阳难卖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35400,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海棠春 闺词，和王阮亭先生韵 其一 晓妆","author":"董元恺","text":"枕棱斜溜金钗响。\n人倦起、日高朱网。\n揽镜怯梳头，一点情波漾。\n牡丹新髻翻时样。\n怪陌上、游郎争赏。\n鬌试残妆，日暖云鬟敞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35401,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海棠春 其二 午睡","author":"董元恺","text":"海棠花下春风足。\n停针线、忽萦心曲。\n晓梦未分明，还向鸳鸯褥。\n簟纹碧映红生肉。\n瞤睡眼、醉花柔玉。\n惊认是朝晖，影落湘妃竹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35402,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海棠春 其三 晚浴","author":"董元恺","text":"玉盘水浸金钿影。\n清波映、红潮微醒。\n娇艳体生香，露湿梨花冷。\n起来唤婢移奁镜。\n忙掩敛、罗裙先整。\n风袅水沉烟，更爇龙涎饼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35403,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海棠春 其四 夜坐","author":"董元恺","text":"空阶碎滴芭蕉雨。\n听叶叶、愁和砧杵。\n剪泪问灯花，泪落花无语。\n夜寒还倩飞鸿去。\n空望断、天边河鼓。\n暗忆碧窗南，玉柄同挥麈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35404,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"桃源忆故人 寄忆","author":"董元恺","text":"春寒泪滴罗衾暖。\n料峭湘帘初捲。\n昨夜玉人窗畔。\n悄悄闻低唤。\n寻思却是天涯远。\n此际柔肠千转。\n便有南归鱼雁。\n极目关河断。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35405,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"锦堂春 饮史子蒙晚香亭","author":"董元恺","text":"盆种珊瑚作串，篱编茉莉成丛。\n穷冬桃李争春色，花影漾帘栊。\n椰子杯浓泛绿，荔枝蜜渍生红。\n别来莫问家园事，细说岭南风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35406,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三字令 其一 贞娘墓","author":"董元恺","text":"云悄悄，灯荧荧。\n雨泠泠。\n凭吊处，惜娉婷。\n烟为鬟，雾为鬓，归无形。\n幽篁碧，晚枫青。\n恨千龄。\n玉箫歇，寒蛩鸣。\n辛夷襦，芙蓉席，飞残萤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35407,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三字令 其二 闺怨，集唐词","author":"董元恺","text":"香阁掩，泣残红。\n绿阴浓。\n花淡薄，月朦胧。\n人去去，云杳杳，恨忡忡。\n空相忆，画楼东。\n此时逢。\n消息远，锦书通。\n万般心，千点泪，一时封。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35408,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"朝中措 题张真人鹤归亭，用欧公韵","author":"董元恺","text":"当年虚靖已凌空。\n胜迹古亭中。\n萝洞昼栖云雾，石坛时响松风。\n每闻猿啸，惊飞鹤驾，暮鼓晨钟。\n便有药炉丹井，尘湖几见仙翁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35409,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"眼儿媚 秋海棠","author":"董元恺","text":"一帘花色写秋容。\n低映碧窗红。\n胭脂冷落，似颦无语，欲笑还慵。\n断肠心事谁承问，旖旎不禁风。\n泪痕染遍，亭亭倩影，点点芳丛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35410,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"摊破浣溪沙 其一 闺情","author":"董元恺","text":"荡漾馀花落镜奁。\n终朝唤婢镇垂帘。\n私幸向来凄闷惯，只恹恹。\n手划阑干私自语，髻拖针线总慵拈。\n别有关心人不觉，到眉尖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35411,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"摊破浣溪沙 其二 春恨","author":"董元恺","text":"处处风波暗未休。\n晓来听雨替花忧。\n想到碧窗携手地，忽凝眸。\n半吐樱桃开靥晕，欲眠杨柳放眉愁。\n懊恨一春憔悴甚，只如秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35412,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜团圆 将到家作","author":"董元恺","text":"依稀又见，兰陵城郭，远火垂杨。\n忽逢野老偏相识，惊问鬓毛苍。\n遥知窗外，柳开新眼，梅送余香。\n牵衣大妇，挽须小女，争拂风霜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35413,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"河渎神 题二妃庙壁","author":"董元恺","text":"落叶满鸣条。\n柏宫方冢岧峣。\n二妃遗像枕寒潮。\n珠衣玉佩飘摇。\n河流不向湘流绕。\n泪痕此地多少。\n恨与苍梧俱杳。\n平阳亦有香草。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35414,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉乡春 其一 断桥月夜，同内饮荷花深处，和秦少游韵","author":"董元恺","text":"内外湖边人悄。\n南北峰顶天晓。\n摇翠盖，拥红妆，一夜幽香多少。\n镜里迎风如笑。\n篙底清阴堪沓。\n金樽满，玉绳低，一杯共我浇苏小。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35415,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉乡春 其二 复步十锦塘，再和前韵","author":"董元恺","text":"波动一轮声悄。\n水浸一天秋晓。\n台榭冷，佩环寒，此际知心原少。\n欲折柳丝低笑。\n频向荷风轻舀。\n香雾湿，淡烟笼，扶疏影乱痕小。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35416,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"阳台梦 纪梦","author":"董元恺","text":"个人悄倚银屏立。\n唾花衣袖朦胧碧。\n眼波才动已知心，笑向纱幮侧。\n隔帘声暗认，低唤枕函亲切。\n睡情欲上忽三更，听姊规凄咽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35417,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳梢青 其一 杨花","author":"董元恺","text":"午院春深。\n玉楼微度，画阁低侵。\n乱捲愁来，轻沾恨去，一片伤心。\n飘零幽梦难寻。\n偏冷落、珠帘绣衾。\n燕子争衔，罗衣暗惹，消息沉沉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35418,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳梢青 其二 舟中偶见有感，和罗弘载韵","author":"董元恺","text":"无限凭栏。\n一泓秋水，两点春山。\n照影轻盈，盘龙新髻，青雀丫鬟。\n柔枝煞是堪攀。\n憨笑处、琵琶暗弹。\n白草黄沙，昏鸦冷雁，曾否开颜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35419,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"贺圣朝 西江送富云麓学士入都","author":"董元恺","text":"柳遮铃索西江路。\n花唱骊驹暮。\n鸾坡不借，片帆悬向，马当飞度。\n连空水远举头日，近傍玉清风露。\n故人天上讯狂生，只疏慵如故。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35420,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"茶瓶儿 王半焽江楼留饮岕线","author":"董元恺","text":"新制凌家岕线。\n碾玉尘、月团千片。\n倾琼蕊色香兼擅。\n映入幽兰葱茜。\n寒泉溅、乳花泫。\n冰瓷春满。\n松风小啜过阳羡。\n月冷空、江声断。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35421,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"少年游 江楼秋怀，和柳屯田韵","author":"董元恺","text":"十年旧事上心头。\n残月下江楼。\n玉露初零，金风乍起，吹动一天愁。\n衣香手粉曾留处，仿佛忆同游。\n眼泪如潮，枕痕似水，终夜尽情流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35422,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偷声木兰花 其一 崧台岁暮，题家书尾，寄闺人","author":"董元恺","text":"碧桃花发人离别。\n匆匆又见花时节。\n细数花前。\n恰值花开未一年。\n惊心蜡尽逢春暮。\n朔雪严风春里度。\n屈指春光。\n轻暖轻寒到艳阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35423,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偷声木兰花 其二 崧台岁暮，题家书尾，寄闺人","author":"董元恺","text":"去年笠泽浮家去。\n缥缈莫釐卿共住。\n杨柳丝丝。\n满箧登楼唱和诗。\n而今零落荆钗伴。\n憔悴罗襟红泪满。\n地阔天长。\n蛮雨蛮烟总断肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35424,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偷声木兰花 其三 崧台岁暮，题家书尾，寄闺人","author":"董元恺","text":"长江渺渺芙蓉渡。\n横浦重重梅岭路。\n万水千山。\n唱尽新词行路难。\n海南霜雪从无信。\n点点偏催游子鬓。\n玉臂云鬟。\n懊恼三秋人未还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35425,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偷声木兰花 其四 崧台岁暮，题家书尾，寄闺人","author":"董元恺","text":"男儿意气差无苦。\n累汝兼持门与户。\n典尽空箱。\n泪裹珍珠仔细藏。\n遥闻薄产丰年熟。\n来岁官逋先赋足。\n事事关心。\n别有关心愁更深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35426,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偷声木兰花 其五 崧台岁暮，题家书尾，寄闺人","author":"董元恺","text":"迢迢客路谁为主，纵是在家如逆旅。\n飘泊天涯。\n谁道天涯胜似家。\n一年暂别休悲涕。\n暂别百年能有几。\n此后归来。\n老我柔乡傍镜台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35427,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西江月 其一 过苏秦故里","author":"董元恺","text":"不是秦邦金尽，那能赵印功高。\n揣摩欲过洛阳桥，富贵徒欺妻嫂。\n箧里阴符羞看，夜深刺股徒劳。\n青溪休说寿松乔，笑尔车中难保。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35428,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西江月 其二 携家宿南涧山房","author":"董元恺","text":"照处石泉晓镜，捲时山月帘钩。\n隔窗小婢侍梳头。\n不语暗垂红袖。\n细听枝间唤妇，相随竹里登楼。\n布帆影漾绿杨舟。\n昨夜溪边泛酒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35429,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"满宫花 其一 酴醾","author":"董元恺","text":"绿阴垂，鲛帕展。\n满架浓香开遍。\n凭栏索笑倩人扶，斗帐流苏初捲。\n玉容娇，檀晕浅。\n睡起日高犹倦。\n不禁酒力不禁风，消得一枝春软。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35430,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"满宫花 其二 送春，集唐词","author":"董元恺","text":"春欲暮，遥相顾。\n花暗柳浓何处。\n西风回首不胜悲，帘捲晚天疏雨。\n春已去，颦不语。\n双鬓翠霞金缕。\n旧欢新梦觉来时，泪滴枕檀无数。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35431,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"应天长 其一 秋闺，集唐词","author":"董元恺","text":"玉京人去秋萧索。\n愁眉敛翠春烟薄。\n倚兰桡，捲珠箔。\n前事岂堪重想着。\n酒醒情怀恶。\n灯背小窗高阁。\n离魂何处飘泊。\n柳阴烟漠漠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35432,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"应天长 其二 闺人刺绣，和王阮亭先生韵","author":"董元恺","text":"水精帘捲东风院。\n枝上流莺声百啭。\n绿窗轻，香梦软。\n清泪朝朝曾洗面。\n砌痕深，花样浅。\n出水芙蕖波溅。\n绣到鸳鸯偏倦。\n恼乱针和线。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35433,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 胆瓶中梅菊","author":"董元恺","text":"冬尽平芜芳草绿。\n开到春梅秋菊。\n黄白新妆束。\n亭亭一样人如玉。\n淡月横斜疑影独。\n却伴晚霜高躅。\n风味看俱足。\n林逋合傍陶潜宿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35434,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆汉月 岭南芭蕉","author":"董元恺","text":"终岁青青如许。\n结就累累堪数。\n绿阴满地绿天田，种熟万千丝缕。\n细把愁心展，费几夜、春情机杼。\n故乡风动北窗时，更著蕉衣销暑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35435,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"月中行 春情，和周清真韵","author":"董元恺","text":"葡萄斟满晕流红。\n初卸蜡光融。\n游丝轻惹罥雕栊。\n冷露湿金虫。\n褪残花事春归去，消几度残月疏钟。\n罗裙微动骂东风。\n小立画屏中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35436,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"滴滴金 咏腊梅花","author":"董元恺","text":"玉人栀貌天然别。\n换冰肌，涂娇额。\n磬口檀心两奇绝。\n映东篱颜色。\n移来真蜡霜姿洁。\n点酡酥，酿蜂蜜。\n暖癸幽香擅冬日，逗春工消息。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35437,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]