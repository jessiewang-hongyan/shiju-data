[{"title":"题石涛山水册","author":"赵清瑞","text":"一片荒寒见真意，巨然僧后有遗音。\n秋镌秃管山成骨，鬼避枯禅月印心。\n天分如公高石谷，人间何世怆云林。\n袈娑磅礴神酣候，澹墨萧疏缀苦吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18596,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"落花七首 其一","author":"赵清瑞","text":"群芳齐泣奈何天，零落苍苔欲化烟。\n吹到罡风过百五，流将弱水隔三千。\n茫茫茵溷知谁择，寂寂琴尊未了缘。\n拾得琼葩肠欲断，馀香犹在枕函边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18597,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"落花七首 其二","author":"赵清瑞","text":"忆梦梨云抱满怀，东风狼籍委苔阶。\n芭蕉雨打芳心碎，芍药春残泪眼揩。\n灯灺闻歌伤子野，色空补恨窘灵娲。\n维摩榻外难收拾，愁绝香泥印笋鞋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18598,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"落花七首 其三","author":"赵清瑞","text":"花落纷纷随泪落，閒庭片片鸟空衔。\n香消坠粉侵珠箔，色夺残红启印函。\n倩女离魂惊失佩，情人兜怨已盈衫。\n直同剪綵隋宫戏，一瞬繁华逐锦帆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18599,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"落花七首 其四","author":"赵清瑞","text":"一场春梦有无间，雨湿胭支夕照殷。\n绮障猛教虚白悟，仙缘难觅大丹还。\n到门寂寞伤崔护，委地零星怆玉环。\n魂堕花神招楚些，空庭怕听鸟绵蛮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18600,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"落花七首 其五","author":"赵清瑞","text":"坠芬閒与仙人扫，瘗罢群芳制艳铭。\n大块文章风里絮，美人身世水中萍。\n馀晖冉冉留高阁，别梦依依到短亭。\n缕缕游丝花片惹，愁闻檐马响东丁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18601,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"落花七首 其六","author":"赵清瑞","text":"自古花零同月缺，东郊相送泪盈眸。\n莺衔绮思惺惺惜，风定残英故故留。\n红雨打窗刚十日，绿阴缄怨甚三秋。\n醴陵笔梦无消息，鶗鴂声中吊玉钩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18602,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"落花七首 其七","author":"赵清瑞","text":"一年花事太匆匆，金粉飘零短梦中。\n游屐懒携多病日，画栏易惹薄情风。\n空庭一雨添新绿，流水三生有倖红。\n瞥睹枝头来瘦蝶，离魂冉冉过墙东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18603,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒情四咏 其一 别","author":"赵清瑞","text":"隔夕尊前子夜歌，双珠玳瑁剔灯蛾。\n莺啼绮梦偏愁短，花落空庭正怨多。\n忍使鹣盟随逝水，漫将鲤信阻微波。\n情丝百丈空牢缚，回首离亭唤奈何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18604,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒情四咏 其二 梦","author":"赵清瑞","text":"化蝶南华成底事，蓝田空忆玉生烟。\n相逢恍类银河夜，已分虚抛锦瑟年。\n孤枕推时殊惘惘，晓钟催后尚悬悬。\n惺忪未觉梨云散，犹在薰炉茗椀边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18605,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒情四咏 其三 愁","author":"赵清瑞","text":"夜深惊觉在空床，牵挂情怀到晓妆。\n酒尽三杯难更扫，潭深千尺不成量。\n雨昏鹃血皆凝紫，春入莺衣妒浅黄。\n倚遍栏杆斜景逝，心头滋味苦莲房。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18606,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒情四咏 其四 病","author":"赵清瑞","text":"红稀棠院药炉存，弱卉知时怅合昏。\n凉沁玉鱼支瘦骨，窗临朱鸟易惊魂。\n润来石发平行迹，抽到蕉心怯慧根。\n孤负莺花空绮丽，小园春尽未开门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18607,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其一","author":"赵清瑞","text":"玄珠遁太虚，云龙起相逐。\n钩入珊网时，怡然媚幽独。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18608,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其二","author":"赵清瑞","text":"学诗如学禅，大力运龙象。\n专取沧浪言，所见域寻丈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18609,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其三","author":"赵清瑞","text":"予怀方杼轴，如何击钵催。\n悄然一阳动，律琯飞葭灰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18610,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其四","author":"赵清瑞","text":"东坡赞罗汉，曰水流花开。\n静中现天倪，端由面壁来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18611,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其五","author":"赵清瑞","text":"鬼神来告语，叩寂以求音。\n一线单微透，华严印寸心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18612,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其六","author":"赵清瑞","text":"斥鴳笑图南，但识枪榆枋。\n风月便摭拾，不入古锦囊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18613,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其七","author":"赵清瑞","text":"近春贵能乐，近秋贵能哀。\n所感自不同，执一真庸才。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18614,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其八","author":"赵清瑞","text":"融洽陶公性，乃有陶公诗。\n储王与韦柳，时合还时离。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18615,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其九","author":"赵清瑞","text":"玉树谱新声，绮弱而无骨。\n诗词判刚柔，何用咎狎客。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18616,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其十","author":"赵清瑞","text":"六代竞华腴，中尚含古意。\n秋水濯芙蓉，我爱天然丽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18617,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其十一","author":"赵清瑞","text":"旗亭遇小鬟，解诗胜老妪。\n馀音真绕梁，听唱黄河句。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18618,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其十二","author":"赵清瑞","text":"初学少陵诗，先当识疵累。\n疏略而平浅，便滋两宋弊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18619,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其十三","author":"赵清瑞","text":"荦确昌黎翁，盘空多硬语。\n风雅之正宗，吾独秋怀取。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18620,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其十四","author":"赵清瑞","text":"鄙哉王次回，强颜冒温李。\n艳词有寄托，岂类负涂豕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18621,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其十五","author":"赵清瑞","text":"摩诘老画师，诗亦同画妙。\n鹿柴辛坞间，寓目都诗料。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18622,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其十六","author":"赵清瑞","text":"香山耽禅悦，万斛洗情尘。\n如何说花鸟，转在木石人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18623,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其十七","author":"赵清瑞","text":"宋体唐巳开，郊岛尚寒瘦。\n诗派图西江，同异须冥叩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18624,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其十八","author":"赵清瑞","text":"六一庐山篇，脱胎陇西白。\n灵气注笔端，各将真面识。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18625,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其十九","author":"赵清瑞","text":"潇洒陆剑南，取境最閒适。\n及念九世雠，雄词戛金铁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18626,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其二十","author":"赵清瑞","text":"风雨方满城，悲哉秋之气。\n此句千古传，深感催租吏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18627,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其二十一","author":"赵清瑞","text":"飘泊零丁洋，危坐幽燕狱。\n重广武穆词，高击渐离筑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18628,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其二十二","author":"赵清瑞","text":"青田两鬼诗，卢仝应却走。\n譬如图怪石，只在得奇丑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18629,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其二十三","author":"赵清瑞","text":"渔洋秋柳诗，笺解纷聚讼。\n叶下洞庭波，其妙在神韵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18630,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其二十四","author":"赵清瑞","text":"一掬灵均泪，悽然洒五羊。\n铜驼已荆棘，何处叫天阊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18631,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其二十五","author":"赵清瑞","text":"笠翁曼倩俦，俶傥亦可喜。\n仙才鬼才外，未能成一体。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18632,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其二十六","author":"赵清瑞","text":"随园主性灵，其实工涂泽。\n刻划韩冬郎，乃有天真阁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18633,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其二十七","author":"赵清瑞","text":"诗魔贵廓清，二樵挺奇逸。\n岷江接湘流，骚些遗音翕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18634,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其二十八","author":"赵清瑞","text":"湘乡绍桐城，一代推巨手。\n韵语殊蹶张，誓摩古人垒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18635,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其二十九","author":"赵清瑞","text":"杰然海藏楼，清削有馀味。\n空山苦头陀，微带蔬笋气。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18636,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句三十首 其三十","author":"赵清瑞","text":"恻恻冢高低，催人速行乐。\n七字真足传，传遍江南北。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18637,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"观澄路炮台诗三首，用吴邑尊韵 其一","author":"祝书根","text":"人文结合轻千里，多少耆英乃来此。\n相看君黄如案几，上有江楼下江水。\n江北青山瞭可指，呜呼江防奚自始。\n外侮不戢内讧起，阋墙燃萁靡有底，而今炮闩亦仅矣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18638,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"观澄路炮台诗三首，用吴邑尊韵 其二","author":"祝书根","text":"蓦然烽火摇天空，殷雷隐隐蚩尤风。\n朝曦沈没东海东，雪花艳吐层霄红。\n蛟龙乍走冯夷宫，七日七夜围城中。\n畴逆畴顺畴吉凶，祥风回转凭高穹，坐看西北纷群雄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18639,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"观澄路炮台诗三首，用吴邑尊韵 其三","author":"祝书根","text":"时局如斯漫涕涟，且评诗酒罗芳鲜。\n莲社今开玳瑁筵，新醅绿蚁浮轻圆。\n回看珠玉欣在前，不为蝇营争附膻。\n不事饕餮空馋涎，欢焉知足时餐眠，陶然共醉义皇天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18640,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和王云裳大令奉调赴省即次留别原韵","author":"祝书根","text":"昔闻使君来，今见使君去。\n来曾何暮歌，去还增逸趣。\n一诗一酒厄，纵论百废举。\n南国需召公，东山比谢傅。\n牛刀割小鲜，徬徨恸歧路。\n嗟余皓发新，劳君青眼顾。\n世道有隆污，叔季谁毁誉。\n捷径笑终南，逃名陋卞务。\n乐地广性天，我还行我素。\n辽豕异白头，绿此恍然悟。\n名园涤尘襟，胜友绝烦虑。\n相期师古人，高风靖节著。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18641,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"谨依怡园主人原韵，藉纪陶社成立为他日念","author":"祝书根","text":"我生几见当头月，但论性情不论迹。\n当筵忽惊主人诗，累世频沾君子泽。\n我欲穷途哭嗣宗，相知岂分南北宅。\n兴来诗酒且追陪，莫问焦头与烂额。\n今年太岁值丙寅，生气虎虎寻诗伯。\n银花齐放上元红，寸铁不持鏖战白。\n天生贤宰作主盟，保护风雅同保赤。\n回视濂溪清复清，仙才飙举奋六翮。\n陈思八斗旧知名，绛县甲子尊前席。\n文如燕许笔如椽，座有纪群声有力。\n其他盟侣俱觥觥，绣凤描鸾侈雕刻。\n愧我庄荒骥尾随，爨馀未解唐音格。\n一诗一酒气相投，三沐三薰心则获。\n转眼春光二月天，主盟贤宰徵嘉客。\n寸怀得失古今同，斗醑催将篇什百。\n闻有东山继起英，想望夷犹不忍释。\n世间安得素心俦，到此聊以数晨夕。\n昨夜桃花开满林，春来江水增千尺。\n此时此地小勾留，匹夫自有兴亡责。\n纷纷我笑热中人，底事以心作形役。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18642,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"再依原韵和怡园主人","author":"祝书根","text":"义熙甲子编岁月，千百年来已陈迹。\n惊看陵谷生风云，又见龙蛇起山泽。\n超世何如入醉乡，承家要自求安宅。\n纷纷十丈软红尘，不遇热肠齐蹙额。\n吾宗彦圣首怡园，踵武乡贤称主伯。\n壮岁科名火尚青，频年市隐尊浮白。\n清才八斗迈陈思，七步吟成豆箕赤。\n造次难忘报国心，翱翔待举冲霄翮。\n一诗一句證鸥盟，莲社高张班马席。\n名宿耆英二十人，春风管领谁之力。\n传来缣纸洛阳多，寿以枣梨安氏刻。\n况有神君旷世才，铮铮仙尉标风格。\n嗟予老病素无闻，际此纷呶乌有获。\n拜读新诗喜且惊，当年想见青云客。\n尽教珠履进三千，未肯金缄露什百。\n倡和年年成古今，推敲字字增音释。\n襟怀潇洒出尘埃，此境此情匪朝夕。\n江表风仪应制科，汝南月旦量才尺。\n讫今牛耳掌骚坛，垂老未忘先觉责。\n下里讴吟勉续貂，无能自笑难为役。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18643,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"三叠前韵和怡园主人Ignore","author":"祝书根","text":"颐春阁里春岁月，但有天伦罕尘迹。\n缅怀孝子与乡贤，昆季绳绳绵世泽。\n爽垲遥觇几度更，园林犹傍晏婴宅。\n偶闻乐事纪新正，南极光明齐手额。\n有酒无诗座不欢，遂开莲社尊诗伯。\n千秋俯仰一渊明，合座倾尊三大白。\n倡始高吟属主人，笔花五彩间苍赤。\n一时和者若而人，淩厉清风奋六翮。\n我似老饕属餍来，嘉殽旨酒充筵席。\n将军负腹可奈何，搜遍枯肠空著力。\n晏罢归来发愤多，儗偿诗债烛先刻。\n初经哦咏苦支离，词谈不吐乃格格。\n君才再接仍不衰，三战辟易期有获。\n我谓同室且鸣金，请以旗鼓当嘉客。\n若论才思君适仙，斗酒奚止篇盈百。\n况是诗魔愈病魔，耽吟能使忧消释。\n惭予尘事苦悤悤，辜负心期数晨夕。\n但冀名园社早开，苏黄元白诗盈尺。\n斯文绝绩起将衰，扢雅扬风此天责。\n可怜几辈走终南，犹是热中甘役役。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18644,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和金伯豫先生赠陶社诗步原韵","author":"祝书根","text":"名园歌舞地，又见出群才。\n丝竹欣瞻澳，黄金肯筑台。\n不期流俗赏，自有故人来。\n我亦投竿者，陶然共举杯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18645,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寿陈唯生表弟五十 其一","author":"祝书根","text":"凭阶鞠?敞华筵，虎瑟龙笙福禄骈。\n比算桑增株八百，曳珠客进履三千。\n充闾瑞气惊臣朔，累代清芬媲孟坚。\n人世期颐刚有半，难兄难弟此称贤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18646,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寿陈唯生表弟五十 其二","author":"祝书根","text":"天生孝友属斯人，鼓吹笙簧见性真。\n报国未忘儒者事，出山遂现宰官身。\n万家春献跻堂酒，五色云开揽揆辰。\n室有儿曹麟骥似，便当一顾傲风尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18647,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寿陈唯生表弟五十 其三","author":"祝书根","text":"文场战后旧知名，此日新醅介寿情。\n三党星觇奎井朗，千秋风挹蕨薇青。\n称诗未必输高适，了愿终须学向平。\n五十悬车前约在，故园杖履伫偕行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18648,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寿陈唯生表弟五十 其四","author":"祝书根","text":"黄绵到处日初长，远道传呼益算觞。\n惠爱君能追召杜，密亲我幸附潘杨。\n寿人汉曲谐宫吕，扬子吴波挹酒浆。\n一笑台莱新颂美，临风缄寄锦衣乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18649,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"贺陈毓瑞周年花甲四首 其一","author":"祝书根","text":"橐笔当年共苦辛，又更拳乱廿馀春。\n我缘衣食贫兼病，君有文章屈亦伸。\n且喜善人绵后泽，不虞妒妇阻前津。\n从知守道唯精一，未学陈思赋感甄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18650,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"贺陈毓瑞周年花甲四首 其二","author":"祝书根","text":"百六韶光廿四风，春游觞酒画图中。\n多文为富神俱畅，美意延年气自冲。\n天上德星千里耀，江头旧雨两间雄。\n闲来老子婆娑甚，遭遇穷时兴不穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18651,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"贺陈毓瑞周年花甲四首 其三","author":"祝书根","text":"纷传风气尚桓桓，蛮触争衡放眼看。\n罗雀已同廷尉翟，登龙谁识使君韩。\n殷怀一本思能永，著手频烦意未安。\n为介兕觥无量寿，阳春有脚不嫌寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18652,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"贺陈毓瑞周年花甲四首 其四","author":"祝书根","text":"宾朋跄济主能贤，南国棠阴又北燕。\n半世征尘聊解组，满阶明月不需钱。\n金罍酌彼欢无艺，玉树迎人种有田。\n遥想朔方桃荫遍，年年争诵去思篇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18653,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和却扇词用原韵八首 其一","author":"李家璿","text":"辞家来作名门妇，举止终惭阙礼箴。\n幸赖翁姑垂鉴宥，重闱更冀得欢心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18654,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和却扇词用原韵八首 其二","author":"李家璿","text":"严父朝归退木天，授书犹记及笄年。\n更劳阿母慇勤训，亲教中闺德象篇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18655,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和却扇词用原韵八首 其三","author":"李家璿","text":"水木清华诗境开，芸居昼静似蓬莱。\n菲材何幸亲风雅，愧少新吟继玉台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18656,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和却扇词用原韵八首 其四","author":"李家璿","text":"妆阁依山忆佛桑，坐看岩际瀑飞梁。\n鼓琴斗奕翻书史，懒把金针绣紫鸯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18657,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和却扇词用原韵八首 其五","author":"李家璿","text":"蜚声绮岁比黄香，卓荦观书莫抗行。\n天鉴日华曾献赋，羡君才调冠三唐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18658,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和却扇词用原韵八首 其六","author":"李家璿","text":"天尔殊文复远波，词林万叶略研摩。\n狄香君禀趋庭训，别国方言受益多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18659,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和却扇词用原韵八首 其七","author":"李家璿","text":"金石图书抉奥难，多君甄综更蒐残。\n斠雠愿学梁王派，自署庐江内史官。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18660,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和却扇词用原韵八首 其八","author":"李家璿","text":"神山十笏迓仙槎，双御飙车看晚霞。\n好向芝山开夜宴，一林红叶艳于花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":18661,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]