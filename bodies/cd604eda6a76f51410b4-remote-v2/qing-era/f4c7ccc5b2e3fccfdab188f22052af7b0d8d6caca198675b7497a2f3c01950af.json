[{"title":"田间杂诗十四首 其十四","author":"曾习经","text":"白发填词吴祭酒，天涯耕稼顾圭年。\n吾生顽薄诚知趣，回首风尘一惘然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43174,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自题蕉桐凉月画扇","author":"曾习经","text":"蕉桐得雨色逾净，云月通宵气已秋。\n欹枕乍闻初雁过，拂帘低见一萤流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43175,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"十一月七日德宗皇帝孝定皇后奉安崇陵泣纪","author":"曾习经","text":"落落周民叹孑遗，春秋书葬已逾时。\n未终惕历忧勤事，谁补神功圣德碑。\n七恨至今无可说，重泉相待有馀悲。\n奉安泣告诸陵日，凄绝灵禽树上枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43176,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"大雪临陶隐居仙人旧馆坛碑","author":"曾习经","text":"隐居遗迹故幽奇，骨体漫诧吴兴儿。\n偶与欧虞求触处，雪窗来写馆坛碑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43177,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜晴有月","author":"曾习经","text":"飘风骤雨遂终日，星月娟娟夜复晴。\n出户偶然成履迹，隔河隐约有歌声。\n注汤煮饼供宵养，兀坐挑灯宛故情。\n真妄世间谁与辨，明朝叱犊事深耕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43178,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渠上新结湜亭","author":"曾习经","text":"把茅盖顶事非常，禅寂童心两不伤。\n欲与莲花同坐夏，一亭新置水中央。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43179,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"即事呈葵霜阁","author":"曾习经","text":"长镵木柄傍畦町，自斸閒花种湜亭。\n愧尔西台晞发叟，年年寒食哭冬青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43180,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题陈后山妾薄命诗后","author":"曾习经","text":"瓣香不忍更他师，压卷今传薄命辞。\n一死实难天地窄，世间方笑后山痴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43181,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湜亭六绝句 其一","author":"曾习经","text":"青铜磨镜舒荷叶，碧玉抽簪长嫩蒲。\n剩看黄莺梢过蝶，时有白鹭窥游鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43182,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湜亭六绝句 其二","author":"曾习经","text":"河流转处片帆出，倏忽来过湜亭前。\n想见都官狂兴发，整巾直走沧海边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43183,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湜亭六绝句 其三","author":"曾习经","text":"东风吹雨水亭阴，怜尔天涯独种参。\n书后欲题青李字，函封不发只沉吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43184,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湜亭六绝句 其四","author":"曾习经","text":"明渠浸玉绝氛埃，一日应须到百回。\n说似抔湖吾亦背，无人来对漫郎杯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43185,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湜亭六绝句 其五","author":"曾习经","text":"荒荒广野四天低，碧浸红亭别一蹊。\n来与杨漕添掌故，八分亭匾手亲题。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43186,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湜亭六绝句 其六","author":"曾习经","text":"前俯长河后枕渠，天光云影总模糊。\n不闻澄澈与流浪，自在亭中读道书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43187,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书横渠西铭挂田舍","author":"曾习经","text":"圣其合德贤其秀，存吾顺事殁吾宁。\n半年始学西铭看，只今此意常惺惺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43188,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书明道定性书后","author":"曾习经","text":"舍止修观非自性，舍观修止异真如。\n马鸣旧有双修论，未及程门定性书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43189,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"葛沽苏庄道上麦苗茸茸桃杏交花","author":"曾习经","text":"麦苗作罽花交光，不信行人不断肠。\n艳福一生忘不得，某年月日过苏庄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43190,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"葛沽苏庄道中携马兰归种湜亭","author":"曾习经","text":"连阴十日绿芜芜，添置牛槽道葛沽。\n一路马兰勤请客，湜亭南迤正相须。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43191,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题法源寺饯春图","author":"曾习经","text":"一岁田居罕入城，顷来差喜渐忘名。\n已成经雨孤花泪，持谢呼春百鸟声。\n闭眼未应迷去住，此心端已废将迎。\n道师所写新诗句，为问堂头作么生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43192,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"端午泛舟溯河数里","author":"曾习经","text":"杨花燕子争轻俊，五月村庄似晚春。\n过雨断云时作瞑，缘源尽日不逢人。\n劳生有暇天应直，佳节无聊酒觉醇。\n摇兀小舟忘远近，拨蒲归路月弦新。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43193,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病起趋田诗九首 其一","author":"曾习经","text":"旱草还伤水，秋风正起予。\n孙休艰遇岁，郑缓误攻儒。\n芜秽从删治，新诗拟建除。\n白茅柔结好，留与护鸡雏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43194,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病起趋田诗九首 其二","author":"曾习经","text":"晓月看曾惯，秋潮意略平。\n呼僮洗桐树，通留灌芜菁。\n点点金英小，飞飞粉翅轻。\n岁芳摇落尽，所得是凄清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43195,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病起趋田诗九首 其三","author":"曾习经","text":"蔬菜饶寒绿，瓜葫极老成。\n庾郎贫已惯，退谷晚还耕。\n云雨将秋瞑，星河不世情。\n百年看鬓影，一雁接边声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43196,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病起趋田诗九首 其四","author":"曾习经","text":"事贱偏多趣，除閒不算顽。\n烧塔临兔穴，折苇当鱼竿。\n转物升元阁，称书旧馆坛。\n将身供万劫，悄立待孤欢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43197,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病起趋田诗九首 其五","author":"曾习经","text":"宿雾弥平野，初阳散曲池。\n不殊南荡兴，待补辋川诗。\n得所知鱼乐，偷生慰尔私。\n偶然栖隐迹，还魁鹿门期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43198,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病起趋田诗九首 其六","author":"曾习经","text":"露草光犹泫，霜蒹气已苍。\n退潮明蟹窟，过雨理鱼防。\n黄落知秋晚，孤行惜志荒。\n故人今好在，旧学待商量。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43199,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病起趋田诗九首 其七","author":"曾习经","text":"一病遂成懒，霜寒种麦迟。\n植援聊屈竹，煮豆信燃萁。\n著袜酬吾足，敦筇蹙客颐。\n逃名还自幸，无事草堂赀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43200,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病起趋田诗九首 其八","author":"曾习经","text":"久知耕也馁，谁信病非贫。\n去日殊可惜，临风始欠伸。\n因循成漫叟，栖泊分流人。\n斸得卷施草，持将寄所亲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43201,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病起趋田诗九首 其九","author":"曾习经","text":"北斗虚何用，牵牛蠢不灵。\n盎粮支闰岁，杯酒酹长星。\n结念自无始，沉吟极窃冥。\n披衣临象纬，并入铁函经。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43202,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自孥小舟过河与梁次侯閒话","author":"曾习经","text":"迷时师渡我，悟时我自渡。\n投竿忽失笑，截断曹溪句。\n次侯吾故人，隔河斜对宇。\n耕作有偃息，还往无迎拒。\n沿河东西岸，汲汲事斥卤。\n耦耕诚何心，遗民略可数。\n往者无可说，来者难亿语。\n田家本色话，商略到瓜芋。\n未足尽悠久，亦颇极谐噱。\n閒晷未易得，炊烟淡容与。\n解维及潮流，平视月正吐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43203,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题耆寿民见山楼图","author":"曾习经","text":"紫阳晚岁求超悟，临济宗风只活埋。\n莫向乱书堆里老，楼扉时为故山开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43204,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题力轩举医隐图","author":"曾习经","text":"逃名择术计无馀，花柱斜街旧隐庐。\n闻到伯休坚白晦，年来踪迹又田居。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43205,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题亨才姻翁大人尊像赞","author":"曾习经","text":"恍兮惚兮，式玉式金。\n东来紫气，南极星临。\n仰之弥高，测之弥深。\n恪恭尔仪，敦履璞沉。\n婆娑鸠杖，屏脱华簪。\n一廛招隐，不假长林。\n一篇货殖，不碍素襟。\n松乔郁茂，桑柘留阴。\n振振之志，兰竹萧森。\n于戏，迈德自身，化于佥壬。\n为猷孔臧，出话可箴。\n仪型于乡，帝曰往钦。\n积善馀庆，天命口忱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43206,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"挽麦孺博","author":"曾习经","text":"志士不得老，夭枉又斯人。\n直是肝肠断，休言文字亲。\n道穷徒反袂，泪短亦沾巾。\n海雨江风地，经过只怆神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43207,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"云石岩","author":"曾习经","text":"俏茜青葱竹柏间，郊游首数六乡山。\n乾隆旧刹重经眼，康乐新诗故恧颜。\n社后川原风物美，雨馀岩溜水声潺。\n疏钟遥度须弥顶，一树海棠半掩关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43208,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鲤鱼沟谒先大夫墓三首 其一","author":"曾习经","text":"疏疏涧底松，兀兀山头石。\n含凄陟连冈，暖焉先子宅。\n微生足忧患，有愿守蓬荜。\n廿载饥驱去，一蹶遂埽迹。\n久知日月晚，真见邱墟场。\n尺壁幸自完，孤根复何植。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43209,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鲤鱼沟谒先大夫墓三首 其二","author":"曾习经","text":"有田杨漕湾，躬耕代徵禄。\n万里资负米，连岁又不熟。\n飘然我来归，有泪不敢哭。\n及春事畴垄，行复念牛犊。\n眼看枌社地，有同桑下宿。\n天地本自宽，生年今蹙蹙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43210,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鲤鱼沟谒先大夫墓三首 其三","author":"曾习经","text":"去山二十里，往还资仆夫。\n哀敬不自申，筋力知何如。\n晨出暮还归，迎门嬉众雏。\n天慈荷老母，亟命暖意壶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43211,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"还京留别","author":"曾习经","text":"哀乐百年百感并，一帘寒雨近残春。\n最怜明月江头别，从此天涯忆故人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43212,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题郭餐雪小照片四绝句 其一","author":"曾习经","text":"夜色沉沉隐书幌，秋空历历动星辰。\n王郎斫地杜陵老，青眼高歌信有神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43213,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题郭餐雪小照片四绝句 其二","author":"曾习经","text":"读书万卷空复尔，怅望千秋亦惘然。\n似有才人吊黄祖，不妨重赋鹦鹉篇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43214,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题郭餐雪小照片四绝句 其三","author":"曾习经","text":"遥夜月痕窥隐隐，空山竹露滴涓篇。\n琴丝帖妥炉烟定，猛省红尘二十年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43215,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题郭餐雪小照片四绝句 其四","author":"曾习经","text":"桃叶桃根总不如，江山清怨却踌躇。\n碧云无际风潮晚，独倚船舷读道书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43216,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西湖旅寓","author":"曾习经","text":"准拟湖船度半宵，昆山弦子玉屏箫。\n旅怀已自难消遣，春月昏黄过断桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43217,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自提汉残砖拓本","author":"曾习经","text":"一角残转五凤嬉，纪元恰合汉宣时。\n贫儿骤诧收藏富，自拓殷勤寄所私。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43218,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题陈简栖遗劄","author":"曾习经","text":"剩与孝标酬堕旨，已成子敬怆人琴。\n此是卢仝玉碑子，百回摩抚百伤心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43219,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题丁叔雅遗墨","author":"曾习经","text":"旧日交亲原不薄，他生怨悱便何如。\n人间夭枉兼常痛，肠断丁三数纸书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43220,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过汪吏部故宅","author":"曾习经","text":"平生汪吏部，寂寞见心期。\n剩对陶公宅，谁营孺子祠。\n疏松犹磊落，秋菊少华滋。\n寥落贞亢士，同谁共此悲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43221,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"为贡郡王题伯羲祭酒遗墨","author":"曾习经","text":"寻常车马经过处，叹息抽琴轸不存。\n一代风流沿溉尽，郁华阁下故王孙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43222,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"遣童杨漕种树","author":"曾习经","text":"每逢春到遣栽花，准备尧夫小小车。\n未许外人知此意，客来与吃赵州茶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43223,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偶述","author":"曾习经","text":"九十慈亲免杖扶，六旬兄弟一灯俱。\n夜閒小婢教和药，日起诸孙与上书。\n后院雨馀抽竹箭，南塘水满放凫雏。\n较量前哲经千品，惭愧新名署特夫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43224,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湖楼坐夏","author":"曾习经","text":"乱后未曾盐酱缺，病馀方觉水云亲。\n坐收山翠临飞鸟，俯借湖光数过人。\n止酒心情还澹薄，爱閒踪迹只因循。\n杨漕乘有新畬地，一夏虚过是幸民。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43225,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题自画南塘西南一角图","author":"曾习经","text":"一树垂垂午荫凉，楼扉开处俯南塘。\n不夸万里昆仑水，清艳沧浪是故乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43226,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"姚君悫秋园","author":"曾习经","text":"一舸乘流暂得坻，南园北第起参差。\n久传子美沧浪记，待补东坡草木诗。\n地僻正宜常闭户，心閒无碍近弹棋。\n倚栏别有沉吟处，不是温公独乐时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43227,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄湘潭齐草衣","author":"曾习经","text":"踪迹天随似较亲，声名白石拟差伦。\n菰蒲地远饶严净，风雨秋淫但隐沦。\n独念灵修终楚服，颇闻高卧比皇人。\n扫除一室吾何有，待欲江头岸角巾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43228,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"冷红簃填词图","author":"曾习经","text":"西风久下藤州泪，社作今无竹屋词。\n解训二窗微妙旨，樵风一卷亦吾师。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43229,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"静中偶述","author":"曾习经","text":"何物能令公喜怒，此中更与我相忘。\n久供盆石饶云气，略整瓶花近日光。\n万化入机先自定，尺箠取寸亦殊长。\n膏肓有病应名懒，海上无劳寄药方。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43230,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"瘿公寓斋与艳秋同饭戏赠二首 其一","author":"曾习经","text":"万花敷地久成尘，露颖烟蕤的的新。\n末世文章工峭茜，要知薄媚足精神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43231,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"瘿公寓斋与艳秋同饭戏赠二首 其二","author":"曾习经","text":"敢望清歌佐酒尊，偶观哺馔亦承恩。\n从今到处逢人说，一饭真成费讨论。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43232,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"消寒诗有跋","author":"曾习经","text":"惜哉其人美且才，断肠漱玉例堪哀。\n太平湖畔丁香树，轻薄为文莫浪猜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43233,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寿节庵师","author":"曾习经","text":"品目寒松天语忧，遂良须鬓照千秋。\n手栽陵树成新荫，想对薰弦散郁忧。\n绝世明姿韬未得，中朝儒效仅能收。\n七旬太保方承赐，同向耆阴社里游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43234,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄题朱九江先生祠堂","author":"曾习经","text":"陶潜归去来，凝凝清静退。\n一世风流照映人，不须更惋文章碎。\n大道多歧语不欺，河汾讲席至今疑。\n瓣香别有沉吟处，欲榜荒山孺子祠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43235,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"挽黄孝觉","author":"曾习经","text":"潘麦悠悠江水东，从兰欲茂又秋风。\n正衾逆旅天胡酷，反袂辛园道始穷。\n此恨有灵哀柏实，何人揾泪与英雄。\n并时未或知君志，况向他年断简中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43236,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"李汉珍同年六十寿","author":"曾习经","text":"商量晚岁先心许，邂逅秋光俱眼明。\n诗鬓久怜花县宰，词源近溯玉田生。\n独居深念殊萧瑟，少日同游今老成。\n忆否清佳堂下雪，耳边犹有读书声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43237,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"挽梁文忠师三首 其一","author":"曾习经","text":"圣敬方跻日，还需启沃人。\n慭遗艰一老，可赎惮千身。\n精爽须眉在，忧危事迹陈。\n独弦先十载，敢复诧吟呻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43238,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"挽梁文忠师三首 其二","author":"曾习经","text":"十兆真陪葬，君臣祭祀同。\n青松苍柏树，断续鼓箫风。\n只有天难问，曾无日再中。\n堂堂今遽尔，莽莽此何穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43239,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"挽梁文忠师三首 其三","author":"曾习经","text":"朱鸟伤焉食，曾携谢印来。\n俄闻经被赐，终见铁函开。\n读易深忧患，称诗愧无才。\n天泉声泪彻，未尽后山哀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43240,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题凉格庄会莽图余越园画葬梁文忠公","author":"曾习经","text":"寒鸡再三号，引炬何煌煌。\n堂堂种树人，归骨崇陵傍。\n负土礼敢隳，凄痛激中肠。\n路人不能歌，来者各沾裳。\n忠义诚所安，兹图宁遽张。\n卷还勿复陈，私心多慨慷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43241,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题御画写字图帝立书文忠师在后","author":"曾习经","text":"一代君臣礼数殊，飘摇风雨有深居。\n汉家画意谁知得，隐见明堂负扆图。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43242,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"庐太孺人七秩徵诗","author":"曾习经","text":"补篇戒养白华诗，岁岁中天婺影垂。\n乔家故木人共仰，陶门宾客我来迟。\n崇陔采舞欢无算，百福香奁事总宜。\n愿得龙头长泻酒，森庭兰玉一枝枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43243,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]