[{"title":"赵忠简公故里","author":"常纪","text":"气作河山久自盟，青鞋布袜俨如生。\n可怜箕尾骑天上，祇勒吉阳殁后旌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8446,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"华阴庙和壁间韵","author":"常纪","text":"梦想西华路到难，尔来金碧看流丹。\n参天古柏森森翠，拔地危楼曲曲栏。\n树爱青牛苍老甚，碑怜唐碣火烧残。\n更知天外三峰上，十丈莲开玉井寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8447,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"登万寿阁","author":"常纪","text":"放眼关中万里秋，河声岳色满高楼。\n白云去尽青天回，真拟游仙到十洲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8448,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临潼七夕怀古","author":"常纪","text":"堂年今夕笑牵牛，记否长生殿里秋。\n回首浓华叹销歇，马嵬西望月如钩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8449,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"兴平和壁间韵","author":"常纪","text":"三年留滞客京华，又向西南天一涯。\n回首乡关千里隔，销魂桥上日初斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8450,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"马嵬坡","author":"常纪","text":"渔阳鼙鼓几曾停，长恨歌成不忍听。\n一种香魂埋宿草，巴山尚谱雨淋铃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8451,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"益门镇","author":"常纪","text":"单车浩荡别中原，试险今来过益门。\n马入乱峰疑路绝，人穿密箐怯风喧。\n栈云低拂西征旆，蜀道初惊北客魂。\n陇树重重乡国隔，艰难满目与谁论。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8452,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"煎茶坪","author":"常纪","text":"振衣千仞破尘容，天险初过第一重。\n俯瞰白云沈大壑，平临红日上高舂。\n雍梁横界标群望，陇蜀中分据要冲。\n见说汉王还定日，煎茶曾此驻苍龙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8453,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"黄牛铺至凤县","author":"常纪","text":"旧说蚕丛险，今知蜀道难。\n盘云危栈滑，障日秘崖寒。\n叱驭挥征辔，惊心怯急滩。\n计程宿凤县，莫放酒杯乾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8454,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"登凤岭","author":"常纪","text":"凤岭高何极，岧峣欲到天。\n人行飞鸟上，路绕白云边。\n放眼观尘界，搴裳俯大千。\n临风思列子，高处一泠然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8455,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"宿南星镇书壁","author":"常纪","text":"凤岭南来村阁中，怒流深箐吼秋风。\n惊心折坂石头滑，瞥眼危栏雁齿空。\n一线崎岖缘鸟道，千峰回合认蚕丛。\n斜阳好贳南星酒，痛饮高歌慰转蓬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8456,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"度柴关岭","author":"常纪","text":"驱马柴关道，遥遥畏著鞭。\n两行交灌木，一线上青天。\n胆落青羊水，眼明紫柏烟。\n赤松如可访，亦欲揖群仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8457,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"柴关道中口号 其一","author":"常纪","text":"千岩万壑惬招寻，碧涧明流尽赏心。\n应接于今真不暇，胜游可但是山阴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8458,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"柴关道中口号 其二","author":"常纪","text":"山重水复石磷磷，岩壑幽深隔世尘。\n经过柴关多少曲，山风尽日恐行人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8459,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过马鞍岭 其一","author":"常纪","text":"险绝马鞍道，坡陀一径通。\n峰高连紫柏，溜急走乌栊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8460,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过马鞍岭 其二","author":"常纪","text":"石压蛟龙宅，林生虎豹风。\n行行瞻马首，何日复旋东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8461,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"观音碥","author":"常纪","text":"羊肠一径倚云开，古木阴阴遍绿崖。\n石色偪人蹲虎豹，水声殷地走风雷。\n题诗小宋今何在，辟道中丞去不回。\n尚有行人思往烈，残碑拂拭剥苍苔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8462,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"马道至青桥驿","author":"常纪","text":"石栈天梯欲度难，又驱羸马上层峦。\n惯经险阻能无惧，饱阅烟霞可待餐。\n两壁土花张锦绣，一江鸭绿急波澜。\n行人到此须留眼，莫便匆匆负壮观。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8463,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鸡头关","author":"常纪","text":"入险益门镇，出险鸡头关。\n几日褒斜中，鬓毛亦已斑。\n复此万仞梯，抑接苍浪天。\n天风吹行人，嗟予视听艰。\n彳亍不敢行，欲度心悬悬。\n自非壮士怀，能不凋朱颜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8464,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鸡头关望褒城","author":"常纪","text":"意豁神开眼倍明，鸡头关下见褒城。\n望中沃野真千里，行处坡陀喜乍平。\n压地黄云秋渐老，宜人绿树雨初晴。\n故园风景依稀似，立马斜阳无限情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8465,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"褒城口占以李义山有未免被他褒姒笑之句因戏为之","author":"常纪","text":"烽火颜开事特新，宗周从此入咸秦。\n当年祇爱些儿戏，褒女何曾解笑人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8466,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沔县早发","author":"常纪","text":"月吐众峰头，流光照戍楼。\n行旌指剑阁，残梦忆刀州。\n露冷衣添重，风清暑渐收。\n草虫殊造次，吟动满林秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8467,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"武侯祠","author":"常纪","text":"桧柏森森丞相祠，清高遗庙肃人思。\n我来欲藉溪毛荐，正值秋风拂面时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8468,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望定军山有作","author":"常纪","text":"讨贼兴师大义明，可堪星陨志无成。\n定军山色秋风里，杜宇声声恨未平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8469,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"五丁峡","author":"常纪","text":"峡石色如铁，苍苍遍绿苔。\n古痕留斧凿，传是五丁开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8470,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"龙洞背大风雨","author":"常纪","text":"龙洞昏昏云务生，怒雷挟雨走江声。\n风翻山木动鳞甲，身在苍龙背上行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8471,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"朝天关","author":"常纪","text":"拔地双峰峻，盘云一径通。\n苍藤牵怪石，老木吼秋风。\n跋涉惊天险，劳生叹转蓬。\n垂堂知有戒，对此意何穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8472,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"嘉陵江舟中二首 其一","author":"常纪","text":"潮平风正小舟轻，一叶中流破浪行。\n九十九峰何处是，峭帆已过利州城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8473,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"嘉陵江舟中二首 其二","author":"常纪","text":"鞍马长征日不閒，抽帆今始得开颜。\n扁舟稳坐如天上，饱看嘉陵两岸山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8474,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过昭化县","author":"常纪","text":"益昌城内烟树苍，益昌城外稻花黄。\n牵舟令去风流在，名共嘉陵江水长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8475,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"舟泊阆中","author":"常纪","text":"孤舟初泊阆州城，水碧山青似有情。\n江抱玉台云漠漠，花明阆苑鸟嘤嘤。\n亭荒宿草旌旄去，兴寄巴山感慨生。\n坐对锦屏怀往迹，西风鼓角报严更。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8476,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"顺庆口占","author":"常纪","text":"城下贾客船，次第泊江渚。\n说著襄阳乐，时时作楚语。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8477,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"顺庆旅次","author":"常纪","text":"走马西来万里遥，旅怀无处不魂销。\n对床风雨怜予季，形影相随慰寂寥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8478,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"初至西充","author":"常纪","text":"邑小如村落，城荒草木秋。\n人烟看寂寂，山鸟听啾啾。\n稍喜民风朴，敢言吏治优。\n还将休息意，蚤夜共咨诹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8479,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"放衙","author":"常纪","text":"人稀吏散放衙时，饭罢高斋日上迟。\n鸟语蜂声满庭院，竹风清处玩毛诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8480,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"行县 其一","author":"常纪","text":"一片孤城山四围，女墙崩久积苔衣。\n居人寥落荒凉甚，剩有茅檐映槿篱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8481,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"行县 其二","author":"常纪","text":"负郭人家野竹围，水田当户似僧衣。\n惯来鸥鹭饶閒意，浴罢梳翎傍短篱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8482,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"到官后书以自警","author":"常纪","text":"此日宰官身，当年寒家子。\n一旦致青云，切莫忘饮水。\n堂下伊何人，蚩蚩皆赤子。\n何由得其情，明镜与止水。\n但学古循吏，莫效轻薄子。\n循吏有芳名，轻薄逐流水。\n偪仄复偪仄，馀地争些子。\n不见老柁师，操舟大江水。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8483,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"观田家刈稻稻在水田中男妇俱赤足刈之慨然有作 其一","author":"常纪","text":"秋至村村䆉稏红，田家稻熟野塘风。\n腰镰男妇贪晴日，泥泞何辞立水中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8484,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"观田家刈稻稻在水田中男妇俱赤足刈之慨然有作 其二","author":"常纪","text":"赤脚挥镰绿水滨，泥深露冷正萧晨。\n红颜小妇生来惯，直与夫君共苦辛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8485,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"观农人犁水田","author":"常纪","text":"一犁秋雨北风寒，蓑笠萦烟湿不乾。\n但愿三冬田水足，敢将筋力暂求安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8486,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"汉纪将军庙","author":"常纪","text":"荥阳城下烈将军，奇计真能靖楚氛。\n忠义千秋九鼎重，灵祠风雨至今闻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8487,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冬月自府回途中偶成","author":"常纪","text":"菜子花黄带雨新，青青豆麦碧如茵。\n田家好语分明记，今岁村村茂小春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8488,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤凰山张献忠伏诛处","author":"常纪","text":"滔天恶焰肄凶顽，血渍金川草木殷。\n一箭殪贼洵快事，至今人说凤凰山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8489,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"即目","author":"常纪","text":"已是嘉平月，霜轻草未摧。\n岩花开自好，可但放疏梅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8490,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"书感","author":"常纪","text":"宦情役我走风尘，万里辞家别老亲。\n说到倚闾穿望眼，云山迢递暗伤神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8491,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"示弟纯","author":"常纪","text":"吾弟少年时，吾亲笃爱汝。\n一自远别离，共谁团圞语。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8492,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"不寐","author":"常纪","text":"隔窗蕉叶声，几点夜来雨。\n梦破不成眠，慨然念终古。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8493,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和幕友吴鲁臣见赠韵","author":"常纪","text":"民社初膺已半年，防民真觉甚防川。\n文章风月知何用，循吏深惭诵马迁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8494,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"除夕示舍弟纯舍甥怀信","author":"常纪","text":"一官累汝远随予，天末相依值岁除。\n痛饮莫辞今夜酒，醉酣刚可慰离居。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8495,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"元旦率同官朝贺","author":"常纪","text":"瞻拜威仪肃，衣冠列雁行。\n俨同金凤阙，真惹御炉香。\n北极卿云丽，东皇旭日长。\n愿将葵向意，千岁祝春王。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8496,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"观村民舞灯 其一","author":"常纪","text":"山城初送试灯风，箫鼓喧喧是处同。\n照眼火龙如意舞，共传底事兆年丰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8497,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"观村民舞灯 其二","author":"常纪","text":"巴童竹马唱巴歌，到处逢迎倩一过。\n毕竟习俗缘好事，丰登原在粪田多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8498,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南岷山祈雨","author":"常纪","text":"骑鹤仙人去，烧丹胜地存。\n好峰云澹澹，荒井水源源。\n闻道神灵雨，常沾绿树村。\n还将椒与桂，一为叩山门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8499,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"喜雨","author":"常纪","text":"刺水秧针出，毛空细雨来。\n烟深迷远岫，云密走轻雷。\n草色浮新翠，山容洗旧埃。\n芳田时节好，布谷莫停催。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8500,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"县试示诸童","author":"常纪","text":"珊瑚宝树生海底，光射洪涛千丈水。\n铁网高张护亚枝，搜罗作贡天家里。\n即今人海亦茫茫，降才原不间殊方。\n还从有司上大吏，取士有制周且详。\n国家由来重科目，拔置石渠与天禄。\n豫章翻风异凡才，自有工师识大木。\n此日诸生文阵开，万骑腾骧骋逸才。\n敢道知马如伯乐，神骏自古超驽骀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8501,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"署中有池友人垂钓得鱼喜甚书此调之","author":"常纪","text":"一池新水碧潆洄，傍柳垂纶坐绿苔。\n阳鱎曾闻最贪饵，纷纷莫遣近钩来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8502,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"竹林避暑","author":"常纪","text":"暑气肆郁蒸，炎炎畏长昼。\n科跣衣不船，宁为礼法囿。\n维彼青琅玕，檀栾蔚深秀。\n坐卧于其中，清风满怀袖。\n常愿对此君，免俗不辞瘦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8503,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"阅旧日所读书不觉忘暑偶成","author":"常纪","text":"筐中冰雪文，藏弆岁云久。\n际此长夏日，搜之逢故友。\n一卷常自携，爱玩不释手。\n凉雨夜洒蕉，清风朝散柳。\n相对瑩心神，祝融复何有。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8504,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"新秋","author":"常纪","text":"井梧报新秋，一叶飘庭院。\n坐望河汉色，忽惊时节变。\n淅沥夜雨疏，清凉晚风善。\n博得簿书閒，差可亲笔砚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8505,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"奉调入闱捧檄而喜诗以志之","author":"常纪","text":"一麾深恐窃名邦，守拙山城志已降。\n差喜讼庭花绕砌，敢矜龙鼎笔能扛。\n月卿衔命来天阙，玉尺衡才到锦江。\n未学幸叨光盛典，孤灯风雨忆寒窗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8506,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"山中早发","author":"常纪","text":"雾重晓风轻，山高残月午。\n笋舆不逢人，时时落林雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8507,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"大庾渡","author":"常纪","text":"涪江绿净不可唾，烟深荡桨溪光破。\n云树苍茫两岸山，风帆一霎乘潮过。\n去春问渡此渡头，今来风景又新秋。\n岁月如驰不肯住，滔滔空叹大江流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8508,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"新都县吊杨升庵先生","author":"常纪","text":"谪后疏狂祗自怜，淋漓醉墨染蛮烟。\n胸中血泪犹千斛，风景谁云裂老颠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8509,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"驷马桥","author":"常纪","text":"未沽临邛酒，先过驷马桥。\n如何卖赋后，忍听白头谣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8510,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蜀中试院乃故蜀宫殿也感而有作","author":"常纪","text":"茫茫人代叹何穷，碧瓦参差落照中。\n往日豪华销歇尽，空馀秋草泣秋虫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8511,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"初入试院柬酆都江安两王公","author":"常纪","text":"昔年惭附骥，今日喜联镳。\n金屑沙难拣，鸡群鹤自超。\n何人工赝鼎，几辈奏云韶。\n识别维真赏，相期在不骄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8512,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"试院对月口占","author":"常纪","text":"凉月高高夜漏深，竟成坐对久沈吟。\n剧怜烛尽三条后，几许良工苦用心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8513,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"洗墨池","author":"常纪","text":"覆瓿雄文字字奇，美新人正草元时。\n可邻户外无车辙，故国空留洗墨池。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8514,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"子云亭","author":"常纪","text":"寂寞终投阁，何如草亭下。\n门径自萧然，时来问字者。\n千秋符命本冥冥，元理深探此未醒。\n往日风流馀宿草，浮云烟树映空亭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8515,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杜工部草堂","author":"常纪","text":"平生稷契志，漂泊几曾酬。\n溪水犹前日，草堂空自秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8516,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"九月十三日同友人高于仲自省回涂中遇雨 其一","author":"常纪","text":"寒砧散响入遥空，捣练深闺是处同。\n黄叶西风鞍马客，那堪秋雨更濛濛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8517,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"九月十三日同友人高于仲自省回涂中遇雨 其二","author":"常纪","text":"一天寒色隐秋山，风雨勾留道路艰。\n赖有好峰相慰藉，时时雾外露烟鬟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8518,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南充守岁仍用去年除夕韵","author":"常纪","text":"杯传梦尾共推予，客里风光岁又除。\n岂但故园千里隔，眼前人已怅离居。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":8519,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]