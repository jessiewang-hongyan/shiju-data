[{"title":"热河三十六景诗 其二十 泉源石壁","author":"玄烨","text":"水源依石壁，杂踏至河隈。\n清镜分霄汉，层波溅碧苔。\n日长定九数，发白考三才。\n天贶名犹鄙，居心思道该。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37276,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"热河三十六景诗 其二十一 青枫绿屿","author":"玄烨","text":"石磴高盘处，青枫引物华。\n闻声知树密，见景绝纷哗。\n绿屿临窗牖，晴云趁绮霞。\n忘言清静意，频望群生嘉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37277,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"热河三十六景诗 其二十二 莺啭乔木","author":"玄烨","text":"昨日闻莺鸣柳树，今朝阅马至崇杠。\n朱英紫脱平原绿，月驷云?错落駹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37278,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"热河三十六景诗 其二十三 香远益清","author":"玄烨","text":"出水涟漪。\n香清益远，不染偏奇。\n沙漠龙堆，青湖芳草，疑是谁知。\n移根各地参差。\n归何处、那分公私。\n楼起千层，荷占数顷，炎景相宜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37279,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"热河三十六景诗 其二十四 金莲映日","author":"玄烨","text":"正色山川秀，金莲出五台。\n塞北无梅竹，炎天映日开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37280,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"热河三十六景诗 其二十五 远近泉声","author":"玄烨","text":"引泉开瀑布，迸水起飞珠。\n锵玉云岩应，色空有若无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37281,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"热河三十六景诗 其二十六 云帆月舫","author":"玄烨","text":"阁影凌波不，动涛接灵鳌。\n蓬莱别殿挂，云霄粲挥毫。\n四季风光总，无竭卧闻箫。\n后乐先忧薰，弦意蕴羲爻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37282,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"热河三十六景诗 其二十七 芳渚临流","author":"玄烨","text":"堤柳汀沙翡翠茵，清溪芳渚跃凡鳞。\n数丛夹岸山花放，独坐临流惜谷神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37283,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"热河三十六景诗 其二十八 云容水态","author":"玄烨","text":"雨过云容易散，波流水态长存。\n悠然世俗惟念，必得经书考原。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37284,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"热河三十六景诗 其二十九 澄泉绕石","author":"玄烨","text":"每存高静意，至此结衡茅。\n树密开行路，山长疑近郊。\n水泉绕旧石，雉雀乐新巢。\n晴夜荷珠滴，露凝众木梢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37285,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"热河三十六景诗 其三十 澄波叠翠","author":"玄烨","text":"叠翠耸千仞，澄波属紫文。\n鉴开倒影列，反照共氤氲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37286,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"热河三十六景诗 其三十一 石矶观鱼","author":"玄烨","text":"唱晚渔歌傍石矶，空中任鸟带云飞。\n羡鱼结网何须计，备有长竿坠钓肥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37287,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"热河三十六景诗 其三十二 镜水云岑","author":"玄烨","text":"层崖千尺危嶂，涵绿几重碧潭。\n狮径盘旋道北，松枝宛转山南。\n沉吟力尽难得，悬象俯察仰参。\n至理莫求别伎，经书自有包函。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37288,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"热河三十六景诗 其三十三 双湖夹镜","author":"玄烨","text":"连山隔水百泉齐，夹镜平流花雨堤。\n非是天然石岸起，何能人力作雕题。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37289,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"热河三十六景诗 其三十四 长虹饮练","author":"玄烨","text":"长虹清径罗层崖，岸柳溪声月照阶。\n淑景千林晴日出，禽鸣处处入音谐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37290,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"热河三十六景诗 其三十五 甫田丛樾","author":"玄烨","text":"留憩田间乐，旷观恤闾阎。\n丛林欣赏处，遍地豫丰占。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37291,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"热河三十六景诗 其三十六 水流云在","author":"玄烨","text":"雨后云峰澄，水流远自凝。\n岸花催短鬓，高年寸寸增。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37292,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"岁除前二日立春","author":"玄烨","text":"岁尽星回朔气消，迎新慵听奏笙箫。\n梅花欲报春先到，犹怯凝寒瑞雪飘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37293,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"嘉平月初雪后晚坐偶有所见书怀","author":"玄烨","text":"尺雪同云晴亦佳，心参运水及搬柴。\n群乌将宿频迁树，半壁馀光反照阶。\n慷慨行年周甲子，徘徊抚景对宫槐。\n岂辞栉沐编氓志，疾苦先知天下怀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37294,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏鸟鎗","author":"玄烨","text":"由来火具三皇始，后世方兴欲广威。\n未尽响声先雁落，已腾烟处带禽归。\n海洋扫却鲸鱼浪，漠北清尘解铁衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37295,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"朕亲统六师至宁夏驻跸二十日遍观地势游览山形城之东南有巽湖水最清偶尔得野鸭一只羽毛滋润黄头紫背胸白翅短与他处所有回然不同业已忘矣今经十五载忽于画中又见此禽因而有感故援笔以记","author":"玄烨","text":"七边曾历贺兰山，塞北咽喉最险关。\n叠翠崖峦人迹灭，堆沙道路柏林攀。\n汉渠遥转唐渠会，浊水先流清水湾。\n野鸟閒栖犹得静，吾今自睹二毛斑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37296,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏自鸣钟","author":"玄烨","text":"法自西洋始，巧心授受知。\n轮行随刻转，表指按分移。\n绛帻休催晓，金钟预报时。\n清晨勤政务，数问奏章迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37297,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赋得禁城春色晓苍苍","author":"玄烨","text":"淑色曈昽射早光，御园梅柳怯寒霜。\n三宫紫气通瑶殿，九陌和风到建章。\n春社先农开布种，初辛祈谷望书祥。\n莺声燕语添诗思，欲去浮文夙夜忙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37298,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赵北口水淀作","author":"玄烨","text":"风微见水绿，日暖弄窗妍。\n树老依根壮，心平任物迁。\n维舟临草岸，挥翰借壶天。\n非是禽鱼乐，人稠万户烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37299,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赋得时人不识予心乐","author":"玄烨","text":"恩波遍布首邦畿，爱此佳时绿尚微。\n血耗养衰心益壮，神烦物扰体无违。\n暮年筋骨犹能强，半世忧劳幸免非。\n老惯豫游山水处，傍人那得识天机。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37300,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"樯灯","author":"玄烨","text":"泊舟浅水意如何，为惜春光怡兴多。\n倚槛晚晴吟皓月，推窗夜静悦清波。\n冰消浪㓗鱼吹沫，风转云开雁踏莎。\n更有樯灯分掩映，辉煌岂亚扣船歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37301,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 樯灯","author":"玄烨","text":"夜静更深，船窗临淀见波影。\n出看何景。\n灯映牙樯炯。\n自笑无文，难得佳词整。\n挥毛颖。\n水平天永。\n淡露春风冷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37302,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"阅河长歌","author":"玄烨","text":"春风春社艳阳天，雪尽尘清遍路阡。\n曾记当时泊舟处，今成沃土及膏田。\n十年之前汎黄水，民生困苦少人烟。\n历历实情亲目睹，老转少徙益难抚。\n挟男抱女至马前，皆云此河不可堵。\n桑乾马邑虽发源，山中诸流数难数。\n吾想畿内不能防，何况远虑治淮黄。\n数巡高下南北岸，方知浑流为民伤。\n春末无水沙自涨，雨多散漫遍汪洋。\n若非动众劳人力，黎庶无田渐乏食。\n庙谟不惜费帑金，救民每岁受饥溺。\n开河端在辨高低，堤岸远近有准则。\n未终二年永定成，泥沙黄溜直南倾。\n万姓方苏愁心解，从此乡村祝太平。\n昔日宵旰尝萦虑，将来善后勿纷更。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37303,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆咏苏州风俗","author":"玄烨","text":"邓尉梅梢月，虎邱浪里峰。\n人争天地秀，物杂理文宗。\n俗尚非交让，官箴乏恊恭。\n舆情常若此，何日奏时雍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37304,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"偶观演剧作","author":"玄烨","text":"雅颂不能传，诗词降作调。\n唐人歌舞精，元曲选声妙。\n若曰得仙音，究未探其要。\n暂为遣见闻，寄此发长啸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37305,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"三月初十日恭请皇太后雅玩斋进膳看梅花","author":"玄烨","text":"当年梅雪伴，今岁暮春迟。\n银杏舒新叶，木兰盖绿枝。\n花当亭畔发，香逐雨中移。\n别殿陈鲜蜜，尚方献瑞芝。\n老莱舞膝下，珠草列仙墀。\n敬上乔松祝，欣瞻王母仪。\n捧觞称寿句，进酒问安词。\n地润铺红萼，波澄敛玉池。\n高峰多爽气，绮树得丰姿。\n漏转催辰半，表行近画奇。\n承欢同永日，孝思莫违时。\n会庆思经义，千秋古训垂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37306,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"畅春园西新园观花","author":"玄烨","text":"春光尽季月，花信露群芳。\n细草沿阶绿，奇葩扑户香。\n寸阴惜鬓短，尺影逐时长。\n心向诗书奥，精研莫可荒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37307,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西苑试士","author":"玄烨","text":"霁日东风暖，平川宇宙宽。\n文章随世转，经史得人安。\n讲学前贤奥，观光后进欢。\n有生宵旰虑，独望和羹难。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37308,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"大学士陈廷敬挽诗","author":"玄烨","text":"世传诗赋重，名在独遗荣。\n去岁伤元辅，连年痛钜卿。\n朝恩葵志励，国典玉衡平。\n儒雅空兴叹，含毫感倍生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37309,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"汤泉应候","author":"玄烨","text":"一为消疾驻灵泉，步辇平明观插田。\n喜见蕣华方遍野，更看修竹远笼烟。\n虽无玩赏因偕乐，屡庆丰登共息肩。\n窗外雨声滴草舍，密林莺语亦欣然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37310,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"将军潘育龙久任封疆故存问赐诗","author":"玄烨","text":"少年勇战启元戎，久任三秦铁石衷。\n守土防边资壮略，披坚敌阵表彤弓。\n升平当惜老臣在，竹帛还酬旧日功。\n白首怡神存硕果，愿期添算荷恩隆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37311,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赐将军吴英","author":"玄烨","text":"水陆封疆六十年，曾经百战驾轻船。\n蓬台远涉鲸鲵浪，岛屿全消烽火烟。\n将老偏宜立志壮，宸襟每注施恩延。\n波涛有作须先靖，黾勉防微计未然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37312,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冬至读易","author":"玄烨","text":"复自纯坤起，阴阳由静生。\n飞灰识地气，吹律考中声。\n六甲周天运，九畴味道精。\n非图穷理誉，本末近分明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37313,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"黄腊梅","author":"玄烨","text":"腊后江南得早梅，春迟北地见花开。\n不随岸柳初眠候，祇伴寒松破冻回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37314,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赋得冬日可爱","author":"玄烨","text":"复卦初生处，景随玉管回。\n前旗分鸟道，后仗向龙堆。\n爱日冬偏暖，临桥冰未开。\n宽城行幸地，越岭少尘埃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37315,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏雪","author":"玄烨","text":"季秋封地雨，寒月减同云。\n忽见峰头白，那看树杪雰。\n众方矜藻缋，我独念耕耘。\n未卜来朝庆，田畴积几分。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37316,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赋得月照冰池","author":"玄烨","text":"半璧映河隈，光瑩鉴溯洄。\n源清同皎洁，溜静自徘徊。\n远照移松岭，寒辉展镜台。\n羊肠分岔路，飘渺碧云堆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37317,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"吏部尚书引年致仕宋荦因朕六旬寿庆祝来京事毕五月内回本乡朕念旧臣特书七言律一首以纪其事云","author":"玄烨","text":"受祉林泉颐养年，世家耆德自天全。\n少时剑佩登三殿，久任吴淞抚九阡。\n行俭铨衡有令誉，广平才藻入清篇。\n修龄喜得人间寿，雪作须眉兴欲仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37318,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赐大学士温达","author":"玄烨","text":"自少存心敦孝友，中年芳誉畹兰清。\n枢垣华省看封事，储粟经邦著政声。\n三殿丝纶资作楫，九霄雨露启和羹。\n君臣须发苍然矣，时念虞廷进善旌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37319,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"几暇随笔书怀","author":"玄烨","text":"云窗欲视远，启户北凭观。\n岂若登山望，徒劳谱石看。\n禅徒空世界，仙每误炉丹。\n何似诗书蕴，常图根本安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37320,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"五月上旬避暑热河涂中喜麦秋盈野雨旸得时赋七言一律","author":"玄烨","text":"畏暑乘舆出凤城，麦秋预卜望庚晴。\n千村共饱连年稔，万井同欢比屋盈。\n谷有灵泉山脉壮，道无峻岭马蹄轻。\n移风易俗先忠孝，蕃息编氓在厚生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37321,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日山庄 其一","author":"玄烨","text":"日永炎风盛，纯阴在内含。\n扶阳求物理，避暑岂幽探。\n山静清歊热，泉潆照碧岚。\n随时驻步辇，无著亦无贪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37322,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日山庄 其二","author":"玄烨","text":"畏景消烦虑，吟诗续古风。\n野花罗槛外，山鸟满林中。\n云气氤氲合，莺鸣飒爽同。\n无能寻丽句，赋物愧难工。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37323,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"金莲盛放 其一","author":"玄烨","text":"曾观贝叶志金莲，再见清凉遍地鲜。\n近日山房栽植茂，参差高下共争妍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37324,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"金莲盛放 其二","author":"玄烨","text":"数亩金莲万朵黄，凌晨浥露色辉煌。\n薰风拂槛清波映，并作芙蕖满院香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37325,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赋得山林引兴长","author":"玄烨","text":"曾读杜诗解，纷纷议论多。\n遇时非泰运，行道至蹉跎。\n托迹山林趣，披怀水石歌。\n千年赋比兴，后世岂能过。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37326,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏夏 其一","author":"玄烨","text":"甘泉日永秩南讹，清气重云入句多。\n性理精研过盛夏，岂因白首废编摩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37327,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏夏 其二","author":"玄烨","text":"信风已尽接朱明，长养舂容草木亨。\n漱露调冰消暑气，何如心静则神清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37328,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏新竹","author":"玄烨","text":"丛阴半亩润新篁，花气缤纷伴竹香。\n可爱霏微昨夜雨，檐前风响趁苍筤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37329,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"热河产人参虽不及辽左枝叶皆同命翰林蒋廷锡画图因戏作七言截句记之","author":"玄烨","text":"旧传补气为神草，近日庸医误地精。\n五叶五枝成洛数，顺时当用在权衡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37330,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"兰菊图","author":"玄烨","text":"尺楮绘秋容，搜寻墨淡浓。\n丹青偏绰约，锦绣杂䒠茸。\n意运含毫手，神生应矩胸。\n自分枝向背，形影入芳踪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37331,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"莲花岩松牡丹","author":"玄烨","text":"离宫初雨后，花气满天街。\n石壁流泉响，松坪古干佳。\n香凝金掌露，名重玉盘钗。\n静里经声息，方知道有涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37332,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"嘉禾双颖","author":"玄烨","text":"夜雨初晴日，素商驱暑天。\n林红变绿叶，谷熟卜丰年。\n勿讶嘉禾瑞，须知贵粟先。\n秋成各地异，大有再书篇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37333,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"涌翠岩观瀑赏白莲","author":"玄烨","text":"毕竟天然造化功，方能巧设古今同。\n喷云百尺穿岩石，瀑水千层点药丛。\n波涌白莲承晓露，溪浮绿盖动香风。\n经声似脱红尘外，泡影依稀宇宙中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37334,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梨树峪道中步辇口占 其一","author":"玄烨","text":"入峪桥分三岔路，傍崖步辇景何深。\n山中独见松林影，时有清流助鼓琴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37335,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梨树峪道中步辇口占 其二","author":"玄烨","text":"一溪展转见山花，步步石苔杨柳斜。\n试看目前将熟果，青榛郁李并堪誇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37336,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"云岩","author":"玄烨","text":"三庚不用碧筒酒，九井何贪消暑珠。\n自有云峰来澍雨，巉岩风飒到茅庐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37337,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"山居即事","author":"玄烨","text":"清商方至催蝉急，林叶吟风暑渐遥。\n三伏炎蒸才过半，山居遍地喜禾苗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37338,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"览孝经衍义有感而作","author":"玄烨","text":"孝友乾坤蕴，彝伦宇宙开。\n无违遵制礼，色养勉循陔。\n风木追前事，春秋思表哀。\n欢心从博爱，锡类育英才。\n恶慢须防过，骄危诫取灾。\n教原由匪懈，德本足兼该。\n不敬有何别，存诚自可推。\n始终劝兴行，经义日昭回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37339,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"用梌木杯器","author":"玄烨","text":"素轻珠玉器，专制及时杯。\n错节分花影，盘根别利才。\n茂林成木瘿，深谷染莓苔。\n澹泊明吾志，天然见体裁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37340,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春行","author":"玄烨","text":"千红艳，万紫鲜，频催须鬓方寸悬。\n桃火柳烟恐荡志，吟风弄月禁狂颠。\n案牍惟勤被景牵，逢春又恶斗芳妍。\n礼乐诗书海岳编，进德修业须钻研。\n昙云寂灭沦王道，老氏无为徒苟延。\n致知端赖格物先，次第由来性理篇。\n性理无私天地宣，太极乾坤未画前。\n敬承执中授受远，勿替心传思永年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37341,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"去岁八九月雨最多民间俗说封地雨故一冬少雪犹可支持自交立春复不见云所以望雨甚殷昨晚密云四起夜深甘霖即霈田间老幼无不举手加额欢声载道朕以民食为天喜均一体故赋七言近体以示群臣","author":"玄烨","text":"吟咏由来喜雨多，久晴喜雨更如何。\n天心即是民心感，海甸应同畿甸歌。\n立政刚柔符造化，体仁宽裕得人和。\n两间物理原难尽，勿入浮诗曲士科。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37342,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]