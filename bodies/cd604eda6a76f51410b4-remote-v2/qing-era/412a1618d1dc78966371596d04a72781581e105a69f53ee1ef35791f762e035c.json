[{"title":"菩萨蛮 其八 秘戏","author":"邹祗谟","text":"兰缸照出梭儿玉。\n流苏闲挂笙囊绿。\n斗帐卸钩垂。\n浅怜深惜时。\n螺铺交屈戍。\n尽著郎详觑。\n扇扇镜屏中。\n莺啼花雨红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36480,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其一 寄书","author":"邹祗谟","text":"画桥分手。\n鹊脑双倾婪尾酒。\n泪洒鲛珠。\n斟酌来朝欲寄书。\n雪炉焚怨。\n粉魂不觉当风倦。\n凤懒龙娇。\n闲却床头紫玉箫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36481,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其二 夏闺","author":"邹祗谟","text":"桃笙如水。\n莲叶飘香浮细蕊。\n红玉如脂。\n汗点轻罗带泪丝。\n轻纨微扇。\n素手慵拈纤影颤。\n闲数流萤。\n却下空阶到小庭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36482,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"罗敷媚 代赠","author":"邹祗谟","text":"枇杷花里樱桃树，待扫双眉。\n罢扫双眉。\n那许春风仔细知。\n花朝才过教人懒，欲度腰肢。\n莫度腰肢。\n最怕新欢倚镜时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36483,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳含烟 本意","author":"邹祗谟","text":"长堤外，水生烟。\n染就淡黄细雨，风流张绪正当年。\n画楼间。\n高低衬得春山碧。\n一道红衫明减。\n濛濛中酒草黏天。\n好题笺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36484,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"华清引 晏起","author":"邹祗谟","text":"重重珠幕护窗纱。\n春思方佳。\n一种娇慵如梦，微闻莺语哗。\n丁香轻掩扣微差。\n绿云半侧堆鸦。\n枕痕红晕重，不敢见菱花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36485,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐 答索琴","author":"邹祗谟","text":"琮琤寒玉。\n清调随秋竹。\n旧时惯弄求凤曲。\n莫把朝飞轻续。\n一弹明月轻纱。\n再弹夜雨梨花。\n莫使高山流水，三分搀入琵琶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36486,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一落索 挑灯坐","author":"邹祗谟","text":"可怪灯花不省。\n却把兰膏光凝。\n重新剔去旧灯花，照出双单影。\n绛蜡已心灰，独向银缸等。\n待翻针帖认红丝，泪落鸳鸯冷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36487,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏子 答索香","author":"邹祗谟","text":"博山寒，沉水歇。\n香在梅冰树隙。\n薰豆蔻，解罗襦。\n亲承芗泽馀。\n绿纱深，银叶剪。\n莫漏檀心一点。\n藏犀合，贮红箱。\n须留待粉郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36488,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"荆州亭 醉美人","author":"邹祗谟","text":"娇重偏憎小婢。\n发亸故梳时髻。\n倒晕镜流红，重上桃花粉腻。\n蟹眼珠泉响细。\n鸾帐玉山人起。\n一啜便骄郎，可解樱桃至味。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36489,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海棠春 闺词，和阮亭韵  其一 晓妆","author":"邹祗谟","text":"兰凤惝恍飘清响。\n绿池畔、茱萸金网。\n翠滑宝簪松，影落湘波漾。\n灵蛇髻绾随新样。\n恼娇慵、不寻情赏。\n绡帐起来寒，又怕云屏敞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36490,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海棠春 其二 午睡","author":"邹祗谟","text":"闲阶踏遍怜华足。\n偏懊恼、春愁成曲。\n簇簌敛桃笙，展向?毫褥。\n隔墙唱彻丝和肉。\n残梦断、琮琤寒玉。\n漫捲绣帘听，孤闷吹豪竹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36491,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海棠春 其三 晚浴","author":"邹祗谟","text":"银床月起回孤影。\n撇团扇、宿酲初醒。\n珠露浴蔷薇，光烛流萤冷。\n晚妆怯向菱花镜。\n欹鬌、金钗慵整。\n残粉较何郎，香汗消汤饼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36492,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海棠春 其四 夜坐","author":"邹祗谟","text":"药栏镇日抛红雨。\n清耿耿、翠梭鸳杵。\n蓦忆两凭肩，夜夜传私语。\n待寻好梦郎边去。\n转玉绳、星低河鼓。\n爇罢水沉香，冷落松枝麈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36493,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山花子 春愁","author":"邹祗谟","text":"澹日春烟花信宜。\n红云到处罥游丝。\n自是凄凉浑不管，总难支。\n小雨三更归梦湿，轻烟十里乱愁迷。\n幸有秭归能解事，未曾啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36494,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"极相思 赋得有约不来过夜半","author":"邹祗谟","text":"小楼独对云屏。\n凤胫自青青。\n待伊来也，温存锦瑟，排待银笙。\n暗笑薄情真个懵，全不听、城上三更。\n偏教看尽，绣窗月上，花影分明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36495,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"月宫春 绿窗","author":"邹祗谟","text":"灯宵才过又花朝。\n风景恶相撩。\n绿窗何事送无聊。\n闲看金步摇。\n红鸭桥头人寂寂，皇姑庙后水遥遥。\n荏苒佳期不定，恼杀木兰桡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36496,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其一 本意，庚寅夏作","author":"邹祗谟","text":"人去珠帘花影动。\n依旧南楼月涌。\n人日春寒重。\n氍毹曾向猊炉拥。\n翻被鲍娘春信哄。\n望蜀何如得陇。\n没分香篝宠。\n两边锄断鸳鸯冢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36497,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其二 本意，庚寅夏作","author":"邹祗谟","text":"紫玉化烟千万缕。\n变作寒窗旧雨。\n铃阁经相聚。\n数年叨做居停主。\n却怪净持原老妪。\n生得霍王小女。\n一点心相许。\n子姑乩畔偷眉语。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36498,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其三 本意，庚寅夏作","author":"邹祗谟","text":"云母屏前红泪洒。\n绣帕银环自解。\n缔约经三载。\n紫鹅桥畔曾相待。\n花草他乡应有在。\n权嘱何郎莫采。\n一晌春风罢。\n落红满地深如海。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36499,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其四 本意，庚寅夏作","author":"邹祗谟","text":"忆昔卿来于我馆。\n议作吹箫佳伴。\n重订香帏款。\n数行约法拈银管。\n传语谓郎姑且缓。\n十五盈盈未满。\n谁料朱绳短。\n相如卤莽原无算。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36500,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其五 本意，庚寅夏作","author":"邹祗谟","text":"竹叶同倾飞鹊盏。\n低觑玉儿青眼。\n细辫为侬绾。\n剩将寸发调伊懒。\n荡子天涯归未晚。\n轻把同心解散。\n长恨疑荒诞。\n自编小传邹郎撰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36501,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其六 本意，庚寅夏作","author":"邹祗谟","text":"再浴女蚕难作茧。\n旧日鸳鸯结卷。\n春风莺暗啭。\n画楼此夜晶帘捲。\n半面相逢重腼腆。\n辜负芳心缱绻。\n恨被黄蜂践。\n情丝应付并州剪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36502,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其七 本意，庚寅夏作","author":"邹祗谟","text":"翠幰流苏声细悄。\n义甲冰弦袅袅。\n门外萧郎扰。\n鹤簪惊向犀奁掉。\n金鸭炉中香篆袅。\n翠盎文鱼长绕。\n听说相思鸟。\n红潮两点檀痕小。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36503,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其八 本意，庚寅夏作","author":"邹祗谟","text":"画梅写字都闲雅。\n更善弹棋打马。\n忆去年初夏。\n妮他细语荼蘼下。\n浪卜瓣香双凤瓦。\n谁信金钱尽假。\n风云偏潇洒。\n林逋不遇梅花寡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36504,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其九 本意，庚寅夏作","author":"邹祗谟","text":"河满数声催阿沈。\n拚向蝉窗痛饮。\n分别思香寝。\n并头闲看红蕤枕。\n低诉几番声尚噤。\n郎欲归时寒甚。\n门外珠霜凛。\n衣郎半臂葡萄锦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36505,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其十 本意，庚寅夏作","author":"邹祗谟","text":"执手榴屏权雪涕。\n此后更休相弃。\n鸿便须频寄。\n延平再合君牢记。\n短后征衫驱北蓟。\n指望珀盂春第。\n不道庐江吏。\n伯劳飞燕卿夫婿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36506,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其十一 本意，庚寅夏作","author":"邹祗谟","text":"蝴蝶帐边曾作伴。\n不料朱绳折断。\n斜靠屏风畔。\n唏嘘执手重相看。\n荆钗自执樵青爨。\n时向伯鸾相唤。\n留下风情半。\n剩与做后来公案。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36507,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其十二 本意，庚寅夏作","author":"邹祗谟","text":"叠得蓉笺书几瓣。\n唤住人人去雁。\n聊慰伊家盼。\n花髫乱挽闻长叹。\n细语蝉帘今不办。\n笼里雪衣分散。\n莫慰加餐饭。\n半生愁里逍遥惯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36508,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其十三 本意，庚寅夏作","author":"邹祗谟","text":"分手柴扉陈数愿。\n一愿郎心不变。\n二愿娘身健。\n今生为妾图方便。\n三愿双环常裹绢。\n四愿重投凤钏。\n五愿频相见。\n香车再到回心院。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36509,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其十四 本意，庚寅夏作","author":"邹祗谟","text":"芍药仍开花步障。\n小阁春愁一晌。\n潜入葡萄帐。\n床头私致声无恙。\n岁岁青陵台畔望。\n人在蘼芜曲巷。\n再到添惆怅。\n夕阳芳草闲相向。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36510,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其十五 本意，庚寅夏作","author":"邹祗谟","text":"毕竟书生真薄命。\n还是佳人薄倖。\n待把山盟订。\n海棠单受梅花聘。\n辛苦相携酬玉镜。\n漫把双环投赠。\n芳讯亲教证。\n近来小玉闻多病。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36511,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其十六 本意，庚寅夏作","author":"邹祗谟","text":"紫雪脂香光滟滟。\n名绣红丝作验。\n银箸垂垂酽。\n不堪回首将伊念。\n杨柳章台愁作堑。\n心比兰膏更焰。\n应是前生欠。\n不平莫按神于剑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36512,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆汉月 答索历","author":"邹祗谟","text":"纵使百年胶漆。\n三万六千时日。\n红箫翠帐几多欢，又被闲愁搀越。\n休把春秋记，着无数、等闲风月。\n今年寒食又来过，应恨莺花恍惚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36513,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"茶瓶儿 小鬟茶话","author":"邹祗谟","text":"水味中泠第一。\n唤双鬟、点来新叶。\n正蟹眼鱼针初歇。\n搀入兰花清色。\n小鬟怯、擎杯涩。\n银瓶作汲。\n阿郎到底相如渴。\n应罚做、王朗水厄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36514,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"瑶池燕 开帘引燕","author":"邹祗谟","text":"花丝清艳。\n榆钱贱。\n燕燕近来双羽差健。\n玉人见。\n旧年红线。\n犀帘掩。\n写蓉笺、提起重念。\n无多件。\n烦伊作个鸿便。\n郎如面。\n回音若欠。\n郎心变。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36515,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"思远人 本意，和宋晏小山韵","author":"邹祗谟","text":"雁字鱼函浑未寄，肠断辽西客。\n金鞭微响，玉骝空闹，听马蹄得得。\n雨声偏向芭蕉滴。\n把泪珠和墨。\n学寄画崔徽，添些红晕，怕黛朱无色。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36516,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"河传 小阁留春","author":"邹祗谟","text":"一杯酹汝。\n春色何痴，药栏深处。\n海棠沉睡，紫烟红雨。\n和梦将伊去。\n鸟啼偏搅香衾侣。\n无情绪。\n魂共春丝语。\n柳馆莺来作寓。\n唤双鬟莫与。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36517,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉花阴 重九","author":"邹祗谟","text":"西风侧侧催衣袖。\n凉日犹长昼。\n把酒剩茱萸，休说重阳，瞒过愁时候。\n年年愁到还依旧。\n人落登高后。\n情愿一年中，分半清明，一样平消瘦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36518,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆余杭 听新声垂泪","author":"邹祗谟","text":"待把愁推愁未舍。\n惯听阳关浑不解。\n摇摇薇帐梦春风。\n一晌画屏东。\n绮魂飞度梁州里。\n何处凄凉忽提起。\n鸳尖怕记陇西腔。\n珠袖界残妆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36519,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨中花 答索花","author":"邹祗谟","text":"二月春光未老。\n枝上红颜犹好。\n薄命桃花，断肠棠蕊，欲寄疑卿恼。\n窗外落红闲不扫。\n留伴胆瓶人悄。\n好向绿云边，簪残置案，香气犹缭绕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36520,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"上林春令 晏起","author":"邹祗谟","text":"轻暖轻寒春仲。\n熨香风、红楼惹梦。\n泥人绣被多情，遮翠幕、不教留空。\n金衣向午争花鬨。\n晕斜红、腻云绿重。\n风过日影那移，问双鬟、晓寒何重。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36521,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"河传 其一 春闺","author":"邹祗谟","text":"绣帏。\n深处。\n夜深私语。\n衬月银云。\n洗花玉雨，雨馀遥指青虹。\n美人虹。\n沉沉春梦和烟绕。\n相思草。\n留饲相思鸟。\n重帘垂下，博山自爇香鱼。\n美人鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36522,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"河传 其二 宫辞","author":"邹祗谟","text":"新衔花史。\n药栏烟重，花枝娇倚。\n戏抛红豆打莺儿。\n笑指。\n犀奁占喜子。\n影入青铜红窈窕。\n炉烟绕。\n望断羊车悄。\n玉鱼凉绣鸳藏。\n宫装。\n尘生金缕箱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36523,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"红窗睡 护花灯","author":"邹祗谟","text":"检点红缸，缭绕香凫，翡翠里、不教花睡。\n非云非月非霞处，花与灯俱醉。\n莫教东风容易崇。\n只数点、金枝绛萼，夜光相配。\n银泥双袖，障兰膏一会。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36524,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南 病述","author":"邹祗谟","text":"闲中恼。\n花事恨寥寥。\n狎客群登青雀舫，妖姬家住紫鹅桥。\n萧寺独无聊。\n闲中好。\n蓬跣任逍遥。\n识字屡呼君子鹤，佐觞犹伴美人蕉。\n一醉任天高。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36525,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"芳草渡 偶见","author":"邹祗谟","text":"朱靺鞨，翠箜篌。\n轻艳处，十三楼。\n徘徊雁柱自微搊。\n香阁内，绣帐里，不曾愁。\n春如线。\n人似燕。\n恨煞东君作践。\n薰宝鸭，倚秦篝。\n绿鬟腻，红潮浅，越风流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36526,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天 游西曲","author":"邹祗谟","text":"彩云随处任风飘。\n蓬山不与海南遥。\n红蕤授枕皆双粲，紫电投壶每百娇。\n弹月磬，奏云韶。\n天孙帝子尽来朝。\n袖中碧玉新封事，愿筑银河乌鹊桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36527,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人 答索扇","author":"邹祗谟","text":"玉奴立向风前倦。\n自把新团扇。\n上图蛱蝶下鸳鸯。\n但愿从今怀袖镇双双。\n宵来莫把流萤扑。\n长罗纨轻薄。\n权教收拾避秦篝。\n不道许多冷暖到红楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36528,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹊桥仙 客怀","author":"邹祗谟","text":"轻暖轻寒，不晴不雨，辜负韶光九十。\n落花飞絮两无情，仗千尺、游丝作合。\n涂抹东西，飘零南北。\n从此扁舟一叶。\n梦回始觉未归人，恨一点、窥人明月。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36529,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"河传 其一 调粉饵喂金鱼","author":"邹祗谟","text":"初霁。\n梅雨。\n紫苔绿荇，小山曲渚。\n丹鱼饥矣。\n搓得粉香半黍。\n向清波付与。\n防他翠鸟轻沾羽。\n双鬟语。\n种个芭蕉树。\n细数红鳞小燕，争泥坠处。\n惹双双遁去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36530,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"河传 其二 夜听捣衣声","author":"邹祗谟","text":"溶溶白月。\n环环紫蜺，纷纷翠雪。\n万斛胭脂，泻拚一色银河，捣清砧，声续绝。\n金鱼锁断，一似繁筝急。\n又似愁螀噎。\n戍管梅花，痴龙渴凤孤飞。\n怨凉蟾，星欲滴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36531,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"七娘子 寄讯","author":"邹祗谟","text":"海棠娇影垂杨线。\n杜鹃啼怨流莺啭。\n情语题笺，芳容题扇。\n春风吹损芙蓉面。\n唇珠懒上红笙宴。\n眉烟淡扫青琴钿。\n楚楚堪怜，仙仙堪怨。\n迎风手执花枝颤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36532,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花 书相如传后","author":"邹祗谟","text":"相如不过书生耳。\n争似文君，赢透奇男子。\n却自琴心通绿绮。\n飘飘赋就凌云气。\n不是题桥雄蜀水。\n财守王孙，埋没文人矣。\n薄倖茂陵生两意。\n白头吟罢相如死。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36533,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"摊破采桑子 小语脂香袭","author":"邹祗谟","text":"幽欢久待兰缸敛，懒绣鸳鸯。\n懒说鸳鸯。\n舌唾酣红淡海棠。\n知么，微怒也、问檀郎。\n含娇半晌才私语，轻度丁香。\n轻啮丁香。\n秘密风情在画厢。\n知么，微笑也、问檀郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36534,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"苏幕遮 其一 丙戌过南曲作","author":"邹祗谟","text":"沈真真，苏小小。\n旧日知名，今日馀多少。\n花史新编谁氏了。\n为问青衣，可有迦陵鸟。\n闭门羹，护门草。\n碧锁红桥，未许何郎到。\n流水无声长自绕。\n几朵芙蓉，独耐秋霜老。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36535,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"苏幕遮 其二 答索春","author":"邹祗谟","text":"鹊炉温，龙饼热。\n小盒缄来，中有双银叶。\n慢火应将心字炙。\n化作鸳鸯，烟里随风结。\n向花阴，灯影灭。\n再解罗巾，犹剩沉檀屑。\n荀令薰香香未彻。\n寄语红楼，莫放馀烟歇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36536,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"青杏儿 咏绣","author":"邹祗谟","text":"小阁飏微飔。\n绣床畔、涤爪来迟。\n砑绫光照蔷薇架，才翻旧谱，重临新样，又劈鲜丝。\n无语正凝思。\n双菡萏、何事连枝。\n关情曲曲盘金缕，偷窥半面，慵抬纤手，斜露双綦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36537,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"青玉案 答索镜","author":"邹祗谟","text":"紫珍随月清波满。\n应与嫦娥为伴。\n乐昌何事常分半。\n红潮一派，黛山两点，人在潇湘畔。\n翻看底下鸳鸯款。\n双鹊铸戗将金满。\n珍重绣囊丝纽短。\n萧郎照后，韦娘藏起，长贮香奁暖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36538,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三奠子 偶忆","author":"邹祗谟","text":"忆玉兰花下，初见芳踪。\n眉欲语，意才通。\n衣香清更馥，肤彩瘦偏丰。\n人悄悄，雨濛濛，正相逢。\n莹莹面的，窈窈趺弓。\n蛾黛蹙，脸朱融。\n柔乡多懊恼，佳会易怔忪。\n长记取，裙上泪，石榴红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36539,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"千秋岁 其一 和初子逐妾词","author":"邹祗谟","text":"花檀方拍。\n花泪频频滴。\n紫钗卖，乌丝裂。\n玉环悲蜀道，铜雀欺孙策。\n东风逆，二乔应作漳台客。\n三秋如一日，九曲回肠结。\n空自把，韶华掷。\n本非司马窃，难对虞侯说。\n凄凉夜，举杯自忏当头月。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36540,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"千秋岁 其二 和初子逐妾词","author":"邹祗谟","text":"唏嘘无计。\n权且相回避。\n只一念，应牢记。\n柳眉休更蹙，荑手应还腻。\n堪悲是，金樽难下平原醴。\n忆昔多惊悸。\n欢会非容易。\n难忘却，当初意。\n原惭金谷主，空学庐江吏。\n伊去后，泪痕又把红绡寄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":36541,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]