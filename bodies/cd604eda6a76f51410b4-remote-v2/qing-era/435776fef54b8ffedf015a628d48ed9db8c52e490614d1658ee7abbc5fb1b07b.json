[{"title":"己亥杂诗 其一","author":"龚自珍","text":"著书何似观心贤，不奈卮言夜涌泉。\n百卷书成南渡后，先生续集再编年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1830,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二","author":"龚自珍","text":"我马玄黄盼日曛，关河不窘故将军。\n百年心事归平淡，删尽蛾眉惜誓文。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1831,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三","author":"龚自珍","text":"罡风力大簸春魂，虎豹沈沈卧九阍。\n终是落花心绪好，平生默感玉皇恩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1832,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其四","author":"龚自珍","text":"此去东山又北山，镜中强半尚红颜。\n白云出处从无例，独往人间竟独还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1833,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其六","author":"龚自珍","text":"亦曾橐笔侍銮坡，午夜天风伴玉珂。\n欲浣春衣仍护惜，乾清门外露痕多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1834,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其七","author":"龚自珍","text":"廉锷非关上帝才，百年淬厉电光开。\n先生宦后雄谈减，悄向龙泉祝一回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1835,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其八","author":"龚自珍","text":"太行一脉走蝹蜿，莽莽畿西虎气蹲。\n送我摇鞭竟东去，此山不语看中原。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1836,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其十","author":"龚自珍","text":"进退雍容史上难，忽收古泪出长安。\n百年綦辙低徊遍，忍作空桑三宿看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1837,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其十一","author":"龚自珍","text":"祖父头衔旧颎光，祠曹我亦试为郎。\n君恩够向渔樵说，篆墓何须百字长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1838,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其十二","author":"龚自珍","text":"掌故罗胸是国恩，小胥脱腕万言存。\n他年金匮如收采，来叩空山夜雨门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1839,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其十三","author":"龚自珍","text":"出事公卿溯戊寅，云烟万态马蹄湮。\n当年筮仕还嫌晚，已哭同朝三百人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1840,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其十四","author":"龚自珍","text":"颓波难挽挽颓心，壮岁曾为九牧箴。\n钟簴苍凉行色晚，狂言重起廿年瘖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1841,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其十五","author":"龚自珍","text":"许身何必定夔皋，简要清通已足豪。\n读到嬴刘伤骨事，误渠毕竟是锥刀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1842,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其十七","author":"龚自珍","text":"金门缥缈廿年身，悔向云中露一鳞。\n终古汉家狂执戟，谁疑臣朔是星辰？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1843,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其十八","author":"龚自珍","text":"词家从不觅知音，累汝千回带泪吟。\n惹得尔翁怀抱恶，小桥独立惨归心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1844,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其十九","author":"龚自珍","text":"卿筹烂熟我筹之，我有忠言质幻师。\n观理自难观势易，弹丸垒到十枚时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1845,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二十","author":"龚自珍","text":"消息闲凭曲艺看，考工文字太丛残。\n五都黍尺无人校，抢攘廛间一饱难。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1846,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二十一","author":"龚自珍","text":"满拟新桑遍冀州，重来不见绿云稠。\n书生挟策成何济？\n付与维南织女愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1847,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二十四","author":"龚自珍","text":"谁肯栽培木一章，黄泥亭子白茅堂。\n新蒲新柳三年大，便与儿孙作屋梁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1848,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二十五","author":"龚自珍","text":"椎埋三辅饱于鹰，薛下人家六万增。\n半与城门充校尉，谁将斜谷械阳陵？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1849,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二十六","author":"龚自珍","text":"逝矣斑骓罥落花，前村茅店即吾家。\n小桥报有人痴立，泪泼春帘一饼茶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1850,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二十七","author":"龚自珍","text":"秀出天南笔一支，为官风骨称其诗。\n野棠花落城隅晚，各记春骢恋絷时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1851,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三十","author":"龚自珍","text":"事事相同古所难，如鹣如鲽在长安。\n从今两戒河山外，各逮而孙盟不寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1852,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三十一","author":"龚自珍","text":"本朝闽学自有派，文字醰醰多古情。\n新识晋江陈户部，谈经颇似李文贞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1853,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三十二","author":"龚自珍","text":"何郎才调本孪生，不据文家为弟兄。\n嗜好毕同星命异，大郎尤贵二郎清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1854,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三十三","author":"龚自珍","text":"少慕颜曾管乐非，胸中海岳梦中飞。\n近来不信长安隘，城曲深藏此布衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1855,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三十四","author":"龚自珍","text":"猛龙当年入海初，婆娑曾否有仓祛？\n祇今旷劫重生后，尚识人间七体书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1856,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三十五","author":"龚自珍","text":"丱角春明入塾年，丈人摩我道崭然。\n恍从魏晋纷纭后，为溯黄农浩渺前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1857,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三十六","author":"龚自珍","text":"多君媕雅数论心，文字缘同骨肉深。\n别有樽前挥涕语，英雄迟暮感黄金。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1858,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三十七","author":"龚自珍","text":"三十年华四牡腓，每谈宦辙壮怀飞。\n樽前第一倾心听，兕甲楼船海外归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1859,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其四十","author":"龚自珍","text":"北方学者君第一，江左所闻君毕闻。\n土厚水深词气重，烦君他日定吾文。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1860,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其四十一","author":"龚自珍","text":"子云识字似相如，记得前年隔巷居。\n忙杀奚童传拓本，一行翠墨一封书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1861,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其四十二","author":"龚自珍","text":"夹袋搜罗海内空，人才毕竟恃宗工。\n笥河寂寂覃溪死，此席今时定属公。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1862,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其四十三","author":"龚自珍","text":"联步朝天笑语馨，佩声耳畔尚泠泠。\n遥知下界觇乾象，此夕银潢少客星。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1863,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其四十五","author":"龚自珍","text":"眼前二万里风雷，飞出胸中不费才。\n枉破期门佽飞胆，至今骇道遇仙回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1864,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其四十六","author":"龚自珍","text":"彤墀小立缀鹓鸾，金碧初阳当画看。\n一队佽飞争识我，健儿身手此文官。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1865,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其四十七","author":"龚自珍","text":"终贾华年气不平，官书许读兴纵横。\n荷衣便识西华路，至竟虫鱼了一生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1866,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其四十八","author":"龚自珍","text":"万事源头必正名，非同综核汉公卿。\n时流不沮狂生议，侧立东华儜佩声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1867,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其四十九","author":"龚自珍","text":"东华飞辩少年时，伐鼓撞钟海内知。\n牍尾但书臣向校，头衔不称杀其词。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1868,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其五十一","author":"龚自珍","text":"客星烂烂照天潢，许署头衔著作郎。\n翠墨未乾仙字蚀，云烟半榻掖门旁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1869,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其五十二","author":"龚自珍","text":"齿如编贝汉东方，不学咿嚘况对扬。\n屋瓦自惊天自笑，丹毫圆折露华瀼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1870,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其五十三","author":"龚自珍","text":"半生中外小回翔，樗丑翻成恋太阳。\n挥手唐朝八司马，头衔老署退锋郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1871,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其五十四","author":"龚自珍","text":"科以人重科益重，人以科传人可知。\n本朝四十九科矣，搜集科名意在斯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1872,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其五十五","author":"龚自珍","text":"手校斜方百叶图，官书似此古今无。\n只今绝学真成绝，册府苍凉六幕孤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1873,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其五十六","author":"龚自珍","text":"孔壁微茫坠绪穷，笙歌绛帐启宗风。\n至今守定东京本，两庑如何阙马融？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1874,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其五十七","author":"龚自珍","text":"姬周史统太销沈，况复炎刘古学瘖。\n崛起有人扶左氏，千秋功罪总刘歆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1875,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其五十八","author":"龚自珍","text":"张杜西京说外家，斯文吾述段金沙。\n导河积石归东海，一字源流奠万哗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1876,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其六十","author":"龚自珍","text":"华年心力九分殚，泪渍蟫鱼死不乾。\n此事千秋无我席，毅然一炬为归安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1877,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其六十一","author":"龚自珍","text":"轩后孤虚纵莫寻，汉官戊己两言深。\n著书不为丹铅误，中有风雷老将心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1878,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其六十四","author":"龚自珍","text":"熙朝仕版快茹征，五倍金元十倍明。\n扬扢千秋儒者事，汉官仪后一书成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1879,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其六十五","author":"龚自珍","text":"文侯官冕听高歌，少作精严故不磨。\n诗渐凡庸人可想，侧身天地我蹉跎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1880,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其六十六","author":"龚自珍","text":"西京别火位非高，薄有遗闻琐且劳。\n只算初识镜背字，敢陈法物诂球刀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1881,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其六十七","author":"龚自珍","text":"十仞书仓郁且深，为夸目录散黄金。\n吴回一怒知天意，无复龙威禹穴心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1882,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其六十九","author":"龚自珍","text":"吾祖平生好孟坚，丹黄郑重万珠圆。\n不才窃比刘公是，请肄班香再十年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1883,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其七十","author":"龚自珍","text":"麟经断烂炎刘始，幸有兰台聚秘文。\n解道何休逊班固，眼前同志只朱云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1884,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其七十二","author":"龚自珍","text":"少年薄录睨千秋，过目云烟浩不收。\n一任汤汤沦泗水，九金万祀属成周。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1885,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其七十五","author":"龚自珍","text":"不能古雅不幽灵，气体难跻作者庭。\n毁杀流传遗下女，自障纨扇过旗亭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1886,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其七十六","author":"龚自珍","text":"文章合有老波澜，莫作鄱阳夹漈看。\n五十年中言定验，苍茫六合此微官。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1887,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其七十七","author":"龚自珍","text":"厚重虚怀见古风，车裀五度照门东。\n我焚文字公焚疏，补纪交情为纪公。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1888,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其七十八","author":"龚自珍","text":"狂禅辟尽礼天台，棹臂琉璃屏上回。\n不是瓶笙花影夕，鸠摩枉译此经来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1889,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其七十九","author":"龚自珍","text":"手扪千轴古琅玕，笃信男儿识字难。\n悔向侯王作宾客，廿篇鸿烈赠刘安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1890,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其八十","author":"龚自珍","text":"夜思师友泪滂沱，光影犹存急网罗。\n言行较详官阀略，报恩如此疚心多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1891,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其八十一","author":"龚自珍","text":"历劫如何报佛恩，尘尘文字以为门。\n遥知法会灵山在，八部天龙礼我言。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1892,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其八十二","author":"龚自珍","text":"龙树灵根派别三，家家楖栗不能担。\n我书唤作三桠记，六祖天台共一龛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1893,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其八十三","author":"龚自珍","text":"只筹一缆十夫多，细算千艘渡此河。\n我亦曾穈太仓粟，夜闻邪许泪滂沱！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1894,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其八十四","author":"龚自珍","text":"白面儒冠已问津，生涯只羡五侯宾。\n萧萧黄叶空村畔，可有拥书闭户人？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1895,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其八十五","author":"龚自珍","text":"津梁条约遍南东，谁遣藏春深坞逢？\n不枉人呼莲幕客，碧纱幮护阿芙蓉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1896,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其八十六","author":"龚自珍","text":"鬼灯对对散秋萤，落魄参军泪眼荧。\n何不专城花县去？\n春眠寒食未曾醒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1897,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其八十八","author":"龚自珍","text":"河干劳问又江干，恩怨他时邸报看。\n怪道乌台牙放早，几人怒马出长安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1898,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其八十九","author":"龚自珍","text":"学羿居然有羿风，千秋何可议逢蒙？\n绝怜羿道无消息，第一亲弯射羿功。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1899,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其九十","author":"龚自珍","text":"过百由旬烟水长，释迦老子怨津梁。\n声闻闭眼三千劫，悔慕人天大法王。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1900,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其九十一","author":"龚自珍","text":"北俊南孊气不同，少能炙毂老能聪。\n可知销尽劳生骨，即在方言两卷中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1901,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其九十二","author":"龚自珍","text":"不容水部赋清愁，新拥牙旗拜列侯。\n我替梅花深颂祷，明年何逊守扬州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1902,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其九十三","author":"龚自珍","text":"金銮并砚走龙蛇，无分同探阆苑花。\n十一年来春梦冷，南游且吃玉川茶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1903,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其九十四","author":"龚自珍","text":"黄金脱手赠椎埋，屠狗无悰百计乖。\n侥幸故人仍满眼，猖狂乞食过江淮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1904,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其九十五","author":"龚自珍","text":"大宇东南久寂寥，甄陀罗出一枝箫。\n箫声容与渡淮去，怀上魂须七日招。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1905,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其九十七","author":"龚自珍","text":"天花拂袂著难销，始愧声闻力未超。\n青史他年烦点染，定功四纪遇灵箫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1906,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其九十八","author":"龚自珍","text":"一言恩重降云霄，魔劫成尘感不销。\n未免初禅怯花影，梦回持偈谢灵箫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1907,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]