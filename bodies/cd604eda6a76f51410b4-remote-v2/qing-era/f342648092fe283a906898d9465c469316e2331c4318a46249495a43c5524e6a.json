[{"title":"沪城花事绝句十二首 其七","author":"孙原湘","text":"老我清狂杜牧之，紫云吹散海棠丝。\n东风牵惹閒枝叶，又值伤春病酒时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40339,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"沪城花事绝句十二首 其八","author":"孙原湘","text":"酒龙意气颠如雷，一饮直须三百杯。\n孤山处士果痴绝，醉插金英当玉梅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40340,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"沪城花事绝句十二首 其九","author":"孙原湘","text":"香海花天酒满池，铁公绕指化柔丝。\n玉皇敕赐双飞寺，醉杀偎红倚翠师。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40341,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"沪城花事绝句十二首 其十","author":"孙原湘","text":"凤尾红云海上开，连宵清梦宴瑶台。\n黑风吹堕生罗刹，也有消魂李赤来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40342,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"沪城花事绝句十二首 其十一","author":"孙原湘","text":"小队羊车窄袖身，银灯照耀玉精神。\n张家世有莲花貌，也入花丛斗早春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40343,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"沪城花事绝句十二首 其十二","author":"孙原湘","text":"小部霓裳舞柘枝，春灯斜映断红姿。\n替他小史然眉急，偏是英雄李药师。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40344,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重来 其一","author":"孙原湘","text":"重来碧玉旧情人，认取灯前窈窕身。\n百媚生成无若秀，七情流露莫如真。\n眼波能剪魂摇水，肌雪全消酒入春。\n应笑桃花未开日，何曾洞口见刘晨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40345,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重来 其二","author":"孙原湘","text":"湘帘高揭字如丁，认得秦楼小凤翎。\n十索歌成嫌夜促，四弦弹彻当秋听。\n偶提往事颜微赤，偏遇才人眼最青。\n珍重海棠休易落，杨花犹得化浮萍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40346,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"为子和姬人题团扇 其一","author":"孙原湘","text":"皎洁齐纨妙剪裁，画眉窗下影徘徊。\n分明一个天边月，偏落嫦娥素手来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40347,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"为子和姬人题团扇 其二","author":"孙原湘","text":"洞房秋暖不知寒，莫取班姬古传看。\n自制合欢新样子，更无一日不团圞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40348,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"为子和姬人题团扇 其三","author":"孙原湘","text":"石阑点笔称题诗，树底轻凉拂面时。\n谁唱画屏团扇曲，侍儿犹是谢芳姿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40349,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"歌女","author":"孙原湘","text":"一曲檀槽语若丝，十三年纪太娇痴。\n分明不解人情思，也有千拦百就时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40350,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"戏赠罗仙 其一","author":"孙原湘","text":"人前绝不避嫌猜，身似采花堕我怀。\n底事昨宵灯暗后，隔筵伸过凤头鞋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40351,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"戏赠罗仙 其二","author":"孙原湘","text":"春浮香雨洒曼陀，一寸横波抵爱河。\n不是散花天女使，如何能起病维摩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40352,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"戏赠罗仙 其三","author":"孙原湘","text":"砚匣浓香拂翠裾，泥金扇索瘦金书。\n回身又掣宣毫去，忆着相如病未除。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40353,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"戏赠罗仙 其四","author":"孙原湘","text":"推去偏来近又离，摘花擒蝶戏难支。\n无端误触欢娘恼，翻得温存尔许时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40354,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"懊侬","author":"孙原湘","text":"懊恼传呼老画师，生绡苦要写芳姿。\n低头巳怕窗光逼，对面偏逢笔性迟。\n何惜天人留本相，恐劳尘世惹相思。\n切休刻画西家貌，暗属当筵顾凯之。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40355,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"罗浮","author":"孙原湘","text":"罗浮山顶有飞仙，不就梅花不肯眠。\n双眼防教禅欲破，一生喜与俗无缘。\n沈机翻觉情怀澹，薄怒偏增意态妍。\n閒对春风成一笑，尽人评泊恣人怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40356,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送菘畴归","author":"孙原湘","text":"一丸冷月片帆开，无计留君且送回。\n明日紫荆花树下，有人还望折花来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40357,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠别罗仙 其一","author":"孙原湘","text":"安榴花映泪斑红，别绪都含不语中。\n佛愿纵悭成并蒂，仙踪何苦类顠蓬。\n搯眉凄切盟沉水，捉臂矜持护守宫。\n金锁暂笼么凤去，此生心已挂梧桐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40358,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠别罗仙 其二","author":"孙原湘","text":"嘱郎珍重要郎安，收拾啼颜强作欢。\n新月尽留圆后想，好花尤耐别时看。\n伤心且说相逢易，行迹终愁自定难。\n玉手亲除金缠臂，愿天重与铸团圞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40359,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠别罗仙 其三","author":"孙原湘","text":"暂时小别尚萦牵，况是分飞各一天。\n流水倘然终不返，浮云何似竟无缘。\n香浓自古留难久，梦好从来续未全。\n赠我青丝才一绺，如何穿尽泪珠圆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40360,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠别罗仙 其四","author":"孙原湘","text":"同心稳抱此情芽，缘到春深会发葩。\n大海有时逢断梗，小星甘自守匏瓜。\n果营金屋先量地，若到银河定有楂。\n手写红笺教记取，碧桃花坞第三家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40361,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"别有所赠 其一","author":"孙原湘","text":"四条弦索酒双尊，记得离筵月一痕。\n今夜绿纱窗外雨，又因桃叶念桃根。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40362,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"别有所赠 其二","author":"孙原湘","text":"枇杷花里小门关，金鸭香消玉柱间。\n才是卸头鸳枕畔，无聊拥背话虞山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40363,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠徐雪园女史","author":"孙原湘","text":"虹桥西去谢娘家，旧有才名出绛纱。\n频典荆钗酬药物，自关茅屋种梅花。\n綵毫得意能消福，玉佩当心最辟邪。\n寄语江东徐小淑，清琴好好伴秦嘉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40364,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨中同菘畴小霞泛舟至罗仙家送春","author":"孙原湘","text":"湖山如梦雨如尘，道是寻春却送春。\n画桨双枝天上水，红楼一角意中人。\n难遮去路唯青草，不定来踪是绿蘋。\n究竟为谁惆怅煞，閒愁才洗又重新。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40365,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"立秋日得罗仙问","author":"孙原湘","text":"青鸟殷勤下碧城，蓝桥重许见云英。\n书随梧叶先秋至，人比荷花隔水迎。\n百恨尽抛云外释，双眸豫喜月边明。\n却愁好事临期阻，抱柱依然作尾生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40366,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜罗仙至","author":"孙原湘","text":"桃根持楫渡江来，奁具亲携玉镜台。\n小别丰容看较瘦，浪传情事见先猜。\n微闻密坐芝兰息，细验重襟豆蔻胎。\n整掠云鬟照秋水，莲花羞对妙鬘开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40367,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"供兰图 其一","author":"孙原湘","text":"三生公案證幽兰，珍重珠香白玉阑。\n除却此花无当意，春风笑折一枝看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40368,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"供兰图 其二","author":"孙原湘","text":"胆瓶欲插费商量，爱好天生事审详。\n位置一花非草草，才人文笔佛心肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40369,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"水轩纪事 其一","author":"孙原湘","text":"银塘急雨响飕飕，水溅荷衣万叶愁。\n一朵玉莲波上立，天风吹杀不低头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40370,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"水轩纪事 其二","author":"孙原湘","text":"怜卿消瘦惜卿贫，肺腑深谭字字真。\n却被芳心成一笑，始知洗耳有高人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40371,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"悔恨词 其一","author":"孙原湘","text":"无端打鸭误惊鸳，竟作孤飞綵凤骞。\n西子难追乘月艇，东君空竖护花幡。\n情缘过爱翻成悔，事为沉几易受冤。\n此夕秋灯风露里，谁怜憔悴病文园。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40372,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"悔恨词 其二","author":"孙原湘","text":"一纸相思两鬓丝，渡江桃叶竟无期。\n薄言纵使逢卿怒，消息终应寄我知。\n犹恐再圆仍易缺，果然重到不嫌迟。\n崔微图画分明在，痴把银釭照几时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40373,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重九即事","author":"孙原湘","text":"相逢巾帔喜飘扬，双鬓寒花满屋香。\n细雨幽窗低语处，人生能得几重阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40374,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"归舟","author":"孙原湘","text":"橹枝摇出荻花湾，隐约船头露翠鬟。\n料得个人鸳枕上，梦魂先我到虞山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40375,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"金凤曲为周生菘畴作 其一","author":"孙原湘","text":"迷香小洞曲珑玲，衣染幽兰叶叶馨。\n脩到今生兼福慧，亲题诗上照春屏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40376,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"金凤曲为周生菘畴作 其二","author":"孙原湘","text":"乍抛媚眼整云翘，顾曲心魂已暗消。\n不索泉邱帷幕聘，只图夫婿会吹箫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40377,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"金凤曲为周生菘畴作 其三","author":"孙原湘","text":"手拈红豆记琵琶，的的亲封捉臂纱。\n侬自愿栖金井树，不知郎可是桐花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40378,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"金凤曲为周生菘畴作 其四","author":"孙原湘","text":"双飞心事比鸳鸯，谁改婴兰小字香。\n怕听跃龙宫里曲，九华深帐贮归郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40379,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"金凤曲为周生菘畴作 其五","author":"孙原湘","text":"果然公瑾似醇醪，情比秋江八月涛。\n学赋梅花篇未了，又弹清泪赋离骚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40380,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"戏集唐句","author":"孙原湘","text":"抱膝灯前影伴身，少年会遇洛川神。\n相逢相失还如梦，倾国倾城不在人。\n更被东风劝惆怅，静留迟日学因循。\n须知此恨消难得，豆蔻花红十二春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40381,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"温梦","author":"孙原湘","text":"高唐原是梦生涯，绿水红楼第四家。\n北地胭脂中妇艳，南朝玉树后庭花。\n渔郎潜混秦人服，织女偷邀汉使查。\n惊觉风流真一霎，恼他鹦鹉唤煎茶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40382,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重次前韵","author":"孙原湘","text":"洞门回首即天涯，碧树深藏碧玉家。\n三度事成三夜梦，一番寒减一分花。\n频来得似穿帘燕，欲近难如上水查。\n剩有顾侬心迹在，玉纤亲赐凤团茶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40383,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"黄花比瘦图友人属题亡姬照 其一","author":"孙原湘","text":"栴檀风里散云英，薄命黄花悟此生。\n愿作鸳鸯难比翼，怕闻鹦鹉尚呼名。\n玉箫旧谱盟犹在，锦瑟华年续未成。\n借取断肠诗一句，红儿小照雪儿情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40384,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"黄花比瘦图友人属题亡姬照 其二","author":"孙原湘","text":"帘卷西风蝶梦孤，瘦秋人已化曼殊。\n难求梁革回生药，祇剩崔徽卧病图。\n蠹帙纵横签罢整，象床零落簟空铺。\n髯翁手制朝云偈，一字分明一泪珠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40385,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谢雪卿挽辞钱子霞姬人 其一","author":"孙原湘","text":"逝水年华悼总笄，雪堂前梦太凄迷。\n生憎点点因风絮，才上梅花便堕泥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40386,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谢雪卿挽辞钱子霞姬人 其二","author":"孙原湘","text":"芳姿格韵本如仙，了却春痕玉化烟。\n手把定情团扇子，九原辛苦尚流连。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40387,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谢雪卿挽辞钱子霞姬人 其三","author":"孙原湘","text":"晴雪难留短命身，秋风诀别太酸辛。\n要郎记得营斋日，每到生辰是忌辰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40388,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谢雪卿挽辞钱子霞姬人 其四","author":"孙原湘","text":"我有伤心不可言，年年肠断木犀天。\n借他湿翠啼红恨，自證幽兰院里禅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40389,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"纪遇","author":"孙原湘","text":"绿梅花下记调笙，有个人人酷似卿。\n天分不关仪彷佛，风神都在思聪明。\n回眸宛尔偷成笑，熟视几乎错唤名。\n愧我閒情如薙草，春风才到又重生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40390,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉赠","author":"孙原湘","text":"皋桥西去美人家，绝世聪明沈婺华。\n清瘦身材宜倚竹，玲珑指爪擅簪花。\n双声叫出雌雄凤，两颊烘成早莫霞。\n我醉欲归归未得，任他急雨洒窗纱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40391,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"捣练子  其一 春情","author":"丁澎","text":"情脉脉，泪汘汘。\n半臂春寒晚更添。\n燕子自来春自去，梨花飞尽不开帘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40392,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"捣练子  其二 春情","author":"丁澎","text":"瑶瑟冷，玉钗横。\n悄立灯窗倚袖红。\n不敢熏衣燃麝脑？\n恐妨花气入帘笼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40393,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其一 白门漫兴","author":"丁澎","text":"停桡处，桐树石桥湾。\n淡淡鸦藏烟柳外，田田鱼戏露荷间。\n一抹蒋陵山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40394,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其二 白门漫兴","author":"丁澎","text":"闲游冶，最是艳阳时。\n乌巷诸郎兰桨筏，青溪小妹竹灯祠。\n队队使人疑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40395,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其三 白门漫兴","author":"丁澎","text":"秦淮夜，到处画船灯。\n鹦鹉十千浮碧叶，蟾蜍三五挂红筝。\n人影在银屏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40396,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其四 白门漫兴","author":"丁澎","text":"白杨渡，枝上有提壶。\n宋苑梧桐梁苑雨，冶城秋月石城乌。\n往事且模糊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40397,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其五 白门漫兴","author":"丁澎","text":"寻兰院，幽草玉阶生。\n燕子多情窥屈戌，梨花无梦逐长庚。\n空怀落钗声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40398,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其六 白门漫兴","author":"丁澎","text":"奈何许，生小在长干。\n竹筱巷边同妾住，蚵蚾矶上送郎船。\n无计可留欢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40399,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其七 白门漫兴","author":"丁澎","text":"横塘去，红杏驿边亭。\n估客长须牵马渡，吴侬细语隔船听。\n那不动郎情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40400,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其八 白门漫兴","author":"丁澎","text":"南朝树，小雨望中疏。\n长笛如闻桓子野。\n青山不见谢夷吾。\n随意酒家胡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40401,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其九 白门漫兴","author":"丁澎","text":"狭斜路，薄幸莫留名。\n官妓数来今寇白，伊州唱出小秦青。\n老去尚多情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40402,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望江南 其十 白门漫兴","author":"丁澎","text":"尽去也，风送下江潮。\n月挂青林开士苑，乌啼皂荚内人桥。\n何处更吹箫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40403,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆王孙    送春","author":"丁澎","text":"送春归去杏花残。\n妆镜慵开半亸鬟。\n斜月朦胧骨玉栏。\n被儿单。\n只耐东风一夜寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40404,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"遐方怨 本意","author":"丁澎","text":"红酥减，粉云残。\n试揣裙襕。\n镜听无凭相见难。\n朝朝空抱紫珍看。\n梦魂何处住，在萧关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40405,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"甘州子  其一 溪边","author":"丁澎","text":"金沙滩上落枫初。\n芦叶岸，一床书。\n轻帆林外夕阳疏。\n烟水半含糊。\n垂钓久、端只为鲈鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40406,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"甘州子   其二 春睡","author":"丁澎","text":"昼长人梦小红楼。\n横剃枕，压春愁。\n绿窗花影袅烟柔。\n乳燕坠香篝。\n贪睡稳、忘却下帘钩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40407,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"如梦令   其一 闺词","author":"丁澎","text":"悄过碧栏干外。\n风动花间裙带。\n绣手被郎牵，不管燕窥莺睬。\n无奈。\n无奈。\n尽着教他怜爱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40408,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"如梦令   其二 闺词","author":"丁澎","text":"指冷玉猊香细。\n枕上半抛残髻。\n密约已多时，人立小屏空翠。\n牢记。\n牢记。\n只待梧桐月坠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40409,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天仙子  为许师六题像","author":"丁澎","text":"子房状貌如好女。\n玉骨玲玲欲仙去。\n他年应傍赤松游，香一炷。\n丹一黍。\n长与白云同处住。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40410,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"归自谣    咏枕","author":"丁澎","text":"横角枕。\n鸳绣并头交濯锦。\n剃脂和泪香云浸。\n分开莲叶成孤寝。\n今宵怎。\n合欢好梦须凭您。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40411,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]