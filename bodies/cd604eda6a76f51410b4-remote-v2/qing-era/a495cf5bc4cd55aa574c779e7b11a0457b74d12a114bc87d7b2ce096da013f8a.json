[{"title":"论诗绝句四十首 其十八 荆公","author":"李希圣","text":"字字冥搜苦未安，废眠忘食称心难。\n可怜粗俗扬州守，留作他年画虎看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16979,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其十九 东坡","author":"李希圣","text":"涂抹坡诗百态新，南毛北纪是忠臣。\n莆田处士金陵客，艺苑雌黄别有人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16980,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其二十 山谷","author":"李希圣","text":"漫笑当年吕本中，陈黄诗派本来同。\n后山高出涪翁上，终觉陈谟论未公。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16981,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其二十一 温公","author":"李希圣","text":"明妃曲未逊欧王，司马才如蜀郡杨。\n更喜酒醒人散后，月明深院对新妆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16982,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其二十二 贺铸","author":"李希圣","text":"鬼头万卷自淹该，俊逸青葱信异才。\n除却断肠词句好，无人知有贺方回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16983,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其二十三 晦翁","author":"李希圣","text":"秘监谈诗有盛名，渊源殊不负平生。\n屏山老去风情在，灯火樊楼写汴京。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16984,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其二十四 白石","author":"李希圣","text":"弹章并案到陶潜，径畈花翁尽改弦。\n南宋词人诗笔好，压他杨万与萧千。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16985,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其二十五 后村","author":"李希圣","text":"杨柳东门逼岁寒，刘郎桃树怕重看。\n谁知辇下张光弼，不惹风波到牡丹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16986,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其二十六 松雪","author":"李希圣","text":"水浅蓬莱鬓有丝，永和书法盛唐诗。\n国香零落冬青死，要为王孙废楚辞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16987,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其二十七 道园","author":"李希圣","text":"京国才名四十年，玉堂彩笔拟神仙。\n梦中一角江南路，惯著孤篷听雨眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16988,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其二十八 圭斋","author":"李希圣","text":"流传大定接明昌，文物风流未渠央。\n范揭同声推汉吏，岂知当世有欧阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16989,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其二十九 天锡","author":"李希圣","text":"清丽居然逼李温，首传吴体过中原。\n琵琶省识江南怨，绝代销魂萨雁门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16990,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其三十 铁崖","author":"李希圣","text":"客妇文妖更鬼才，春花秋月斗清哀。\n玉溪刻意摹昌谷，都乞夔州剩馥来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16991,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其三十一 季迪","author":"李希圣","text":"青邱中道折芝英，不许文章老更成。\n还有信阳何大复，可怜才地两倾城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16992,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其三十二 青田","author":"李希圣","text":"乐府迷离仿九章，鼎钟帷幄暗悲伤。\n孤臣泪似苔痕绿，春雨年年上苑墙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16993,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其三十三 茶陵","author":"李希圣","text":"进士山东李中麓，子规江上陆沧浪。\n诗名相业供描画，始信多才本不祥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16994,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其三十四 弇州","author":"李希圣","text":"晚服西涯及震川，卮言憍气已全湔。\n奇情剩作昙阳犬，比似温陵拜澹然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16995,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其三十五 沧溟","author":"李希圣","text":"北极风烟郡国开，中原日月自楼台。\n诗人反覆无多字，谁许西京作赋才。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16996,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其三十六 阳明","author":"李希圣","text":"击壤颓波未寂寥，枫山浅俗定山佻。\n新诗自作温岐语，细雨寒鸡梦早朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16997,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其三十七 牧斋","author":"李希圣","text":"浪子燕青气未平，秋风圃扇擅才情。\n三朝白发江湖梦，夜夜渔灯当火城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16998,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其三十八 梅村","author":"李希圣","text":"半夜挑灯不奈何，梅村才调本无多。\n东家未要施朱粉，浪费南都十斛螺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":16999,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其三十九 渔洋","author":"李希圣","text":"青主论文重北风，江南愁独与君同。\n鹊山寒食明湖柳，写入乌痕燕影中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17000,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"论诗绝句四十首 其四十 竹垞","author":"李希圣","text":"晚岁颓唐力已殚，论诗序爵未欺谩。\n尚书爱好真无益，祗配贪多七品官。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17001,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题郑苏堪海藏楼诗集","author":"李希圣","text":"清晨陇首羌无故，春草池塘若有神。\n万卷祗知供獭祭，义山真卖杜陵人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17002,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"元遗山论诗有贵贱之见作此正之","author":"李希圣","text":"面目都随贵贱迁，陶公枯淡谢公妍。\n暮云春酒词清丽，却在柴烟粪火边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17003,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"遗山论诗又有南北之见复作此正之","author":"李希圣","text":"邺下曹刘气不驯，江东诸谢擅清新。\n风云变后兼儿女，温李原来是北人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17004,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"河决","author":"李希圣","text":"黄河决瓠子，浩如坤轴翻。\n万家正甘寝，夜半为鱼鼋。\n天子临塞河，冠盖如云屯。\n畚锸不得施，议论空叫喧。\n或云下流壅，建言疏海门。\n穷年无效验，九州增垫昏。\n我谓君大谬，当往治河源。\n充耳不见省，哀此戢戢魂。\n闻君疑且怒，欲语声复吞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17005,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古诗一首","author":"李希圣","text":"客从北海来，中有数橡屋。\n劝我居海滨，闭门寄幽独。\n上漏旁复穿，伸东虑西缩。\n补苴术已穷，举家待倾覆。\n客曰曷焚之，改营出新筑。\n主人谢不能，踌躇额嚬蹙。\n吉凶未可知，客言徒取辱。\n诸公谋自工，谀辞颂歌哭。\n吾将说燕书，请君举明烛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17006,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"闻警","author":"李希圣","text":"覆盎门边乌鹊栖，建章烽火辽水西。\n九攻九守会亡宋，三沐三薰能霸齐。\n云雨手中有翻覆，瑀璜腰下无解携。\n羊灯兔月照歌舞，五夜军书来刺闺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17007,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"两马行","author":"李希圣","text":"君马玄黄我马白，我往日南君漠北。\n颜色不同心事殊，况有山川能间隔。\n鸡鸣钟动灯荧荧，闻君被洒仍未醒。\n明珠为泪金作心，持以赠君君不应。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17008,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"壁上见故人旧题有作","author":"李希圣","text":"驿亭萧索不逢春，绕柱巡墙尚有人。\n一别到今无意绪，三年怜汝在风尘。\n东门已欲悲芜灭，北郭相期访隐沦。\n想见江南花发后，醉题歌扇咏汀蘋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17009,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送刘幼云编修南还省亲","author":"李希圣","text":"草长花生莺乱飞，禁城寒尽送君归。\n故山芝朮春应熟，今日朝廷计已非。\n蠢蠢辈流殊可惜，茫茫前路欲何依。\n浔阳郭下江如练，留取京尘上綵衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17010,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"遇旧居有感","author":"李希圣","text":"疏桐乳燕对沈沈，寂寞庭轩春色深。\n回复杂花还照眼，秤量诸药总经心。\n筐中零藿想馀热，苔上履綦无可寻。\n送乐推哀真不易，更临丝竹恐难禁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17011,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送胡味笙编修鼎彝改官大梁","author":"李希圣","text":"新扫巢痕出上台，一章乞郡堕尘埃。\n英雄失路都如此，块儡登场大可哀。\n幕府昔闻天下计，艰危今要济时才。\n酒酣我亦能怀古，便拟从君上吹台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17012,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄怀陈伯严三立","author":"李希圣","text":"谢公埭前春始深，江水江花无古今。\n左股蓬莱遭破碎，南皮瓜李罢浮沈。\n新诗渐欲作蛮语，卧疾安知非越吟。\n坐阅池台成草莽，华颠愁对雍门琴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17013,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春阴","author":"李希圣","text":"拨触春愁尔许同，游丝落絮斗空濛。\n似寒非寒暖非暖，欲雨不雨风不风。\n一角高楼树如荠，孤舟江上花打篷。\n松陵老矣虽能赋，犊战蚕僵语未工。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17014,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"刘幼云编修以诗索和再作赠别","author":"李希圣","text":"尘外远公相啸歌，扁舟安稳渡江波。\n归家正及桃花发，暂别真如乌翼过。\n客里春华白日晚，画中故国青山多。\n鱼羹饱吃柁楼饭，胜向长安骑瘦骡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17015,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日暮独居","author":"李希圣","text":"榾柮燔春火尚红，暮寒才觉卷帘通。\n炉灰画尽诗初就，蜡炬烧残酒未中。\n闷爱拾遗吟语燕，閒同中散送飞鸿。\n蹇驴不敢朝天去，十日何曾过巷东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17016,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春寒","author":"李希圣","text":"二月春寒仍未消，寒梅始花江雁遥。\n轻红重碧不禁怯，雨细风粗相倚骄。\n寂寂楼台帘半掩，深深院落烛初烧。\n十年谙尽关山路，记踏霜痕过板桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17017,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"即事有感","author":"李希圣","text":"坐对庭花春事微，参差渐与世相违。\n四三三四有喜怒，哀乐乐哀无是非。\n贾谊伤鵩未知命，张华赋鹪能息机。\n都门祖帐试相待，神武挂冠吾欲归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17018,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏闰枝编修孙桐方持妇服作此慰之","author":"李希圣","text":"故香落尘经雨滋，荀令断肠君岂支。\n冉冉佳期成梦寐，潭潭旧事费寻思。\n年时已不怡中夜，气味犹疑作远离。\n莫似二毛潘骑省，帱茵弹泪写哀辞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17019,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅花","author":"李希圣","text":"月落霜繁短景催，年年玉笛唤愁回。\n江边日夕垂垂发，雪后园林细细开。\n香与蕙难争百亩，白如榆不上三台。\n春风词笔流传遍，悔向扬州倚阁来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17020,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桃花","author":"李希圣","text":"一代才名数柳刘，庙堂人物尽风流。\n相公剩识桃花字，题壁诗成换播州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17021,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海棠","author":"李希圣","text":"昏如枣膏羊玄保，湿似詹唐沈演之。\n恨到无香非厚谤，人言还有刻深时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17022,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"续春寒一首","author":"李希圣","text":"厅马晚嘶春雨微，杝枝欲开蝴蝶飞。\n诗成试笔写纨扇，酒醒呼灯调玉徽。\n塞草荒凉供雁叫，江花历乱对鸥饥。\n素衣化尽宾朋散，愁坐空庭送落晖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17023,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"广春寒一首","author":"李希圣","text":"花事今年概可知，柳青桃碧有兴衰。\n短萧横笛夜相向，紫殿红楼春正悲。\n旧燕去还留后约，新鸿来欲负前期。\n单衣试酒心情减，怕说鸾镮拾翠时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17024,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"后春寒一首","author":"李希圣","text":"迟暮伤春怀百忧，隔年消息苦淹留。\n东劳西燕空相见，万草千花尽欲愁。\n何日箧中求故扇，有人天际望归舟。\n乱离王粲今头白，懒上层楼赋远游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17025,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"补春寒一首","author":"李希圣","text":"桃李漫山不敢开，阴晴无定本难猜。\n春来春去祗如此，花谢花荣能几回。\n欹枕未妨延短漏，点灯还欲对深杯。\n连年畏听黄昏雨，惯触新词到阿灰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17026,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"独居有感","author":"李希圣","text":"疾病兼旬但闭门，已成失计厌重论。\n江山事事皆陈迹，花鸟年年祗泪痕。\n弦上杜鹃新有托，笼中鹦鹉旧能言。\n巡檐欲草归田赋，误共寒梅说故园。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17027,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"刘幼云编修自天津诗来为别作此寄之","author":"李希圣","text":"九派浔阳江有沱，江上绿柳如绿莎。\n横江大艑高峨峨，卸帆到门蚕未蛾。\n春水渐深生碧波，闻道今年春雨多。\n为君略说江南好，燕子飞时闻棹歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17028,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"祖制","author":"李希圣","text":"乾隆旧额尚能寻，祖制平时有九箴。\n祗道诸侯春不贡，岂闻四裔暗相侵。\n坐谈都尉思搜粟，骤贵中郎解摸金。\n碎首青蒲争耗羡，百年谁识老成心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17029,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送人往沈阳","author":"李希圣","text":"插柳边关当女墙，承平父老见耕桑。\n早通靺鞨求神鹘，曾向丁零案盗羊。\n始祸至今成孟浪，寻盟当日费周防。\n区区卧榻何劳问，已割昭陵作战场。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17030,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"惜花","author":"李希圣","text":"窈窕馀香满眼时，往年独对惜分携。\n桃明柳媚不能奈，燕舞莺啼相与期。\n铁骑勒春真造次，金钗催暮太支离。\n小楼昨夜有风雨，君在梦中应未知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17031,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"辛夷","author":"李希圣","text":"墙角辛夷一尺高，花开如雪复如毛。\n红衰绿减自兹始，忌雨嫌风毋乃劳。\n既以阴多长虫蚁，更兼地僻杂蓬蒿。\n同时僵李能相待，侥倖偏输露井桃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17032,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉兰","author":"李希圣","text":"长安二月三月交，玉兰试花初解苞。\n谁令喝道杀风景，并欲煎酥充夜庖。\n芜没暂当随澧芷，太平仍拟致淮茅。\n植根得所非难事，咫尺梧桐有凤巢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17033,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"酴醾","author":"李希圣","text":"笃耨丛中未忍芟，岁寒曾遣伴松杉。\n半开已似蛇探穴，全放真如马脱衔。\n沈水未宜来刻画，殿春原不畏讥谗。\n承恩药树解为态，独锡嘉名出殿岩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17034,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题章价人铜官感旧圆补","author":"李希圣","text":"旌旗照水如火红，鼓声直挟江流东。\n督师矫矫人中龙，马蹄欲踏吴门空。\n三年坐待桑田变，试手韬钤万人羡。\n纶巾儒服本风流，岂意虚摇憔荣扇。\n兵家形势太无凭，咫尺江湖一掷轻。\n国士恩深惭报称，天高不肯照精诚。\n猩猩啼烟鬼啸雨，千载冤魂相唤语。\n回首苍梧云正愁，孤臣欲作湘累死。\n文藻江山已不存，何人偏解续招魂。\n高唐置酒论畴昔，一蛇在野龙在门。\n半壁功名何草草，健儿散尽遗民老。\n岂知成败本由天，书生苦说封侯好。\n月落潮平又一时，至今乌鹊尚南飞。\n行人莫问当年事，乱后青山有是非。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17035,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梦江南西湖春游曲六首 其一","author":"张景祁","text":"春游好，最好段桥傍。\n上冢船回油壁闹，踏青人过画裙香。\n何处有红墙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17036,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梦江南西湖春游曲六首 其二","author":"张景祁","text":"春游好，最好里湖堤。\n山市茶香鸲鹆老，水村芹脆鲫鱼肥。\n画榼不须提。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17037,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梦江南西湖春游曲六首 其三","author":"张景祁","text":"春游好，最好马塍东。\n十亩荠花团紫蝶，一鞭榆荚送青骢。\n不定晚来风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17038,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梦江南西湖春游曲六首 其四","author":"张景祁","text":"春游好，最好白堤边。\n浅草泥松靴凤涴，落梅风急纸鸢颠。\n裙带一丝牵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17039,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梦江南西湖春游曲六首 其五","author":"张景祁","text":"春游好，最好妙莲台。\n莎径七盘缘塔上，松门八寺进香来。\n乡里被人猜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17040,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梦江南西湖春游曲六首 其六","author":"张景祁","text":"春游好，最好傍湖行。\n八字画船齐拢岸，一群蕃马自归营。\n镫火满高城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17041,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"张景祁","text":"日日兰桡绊客程。\n隔江不见越山青。\n卧听箫管到三更。\n罗帐镫昏寒渐峭，柁楼人语梦初醒。\n不知是雨是潮声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17042,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"换巢鸾凤  用梅溪韵同魏丈滋伯作","author":"张景祁","text":"无限新娇。\n在蘅芜巷陌，柳色河桥。\n水窗窥倚扇，月榭教吹箫。\n风前一捻可怜腰。\n病馀黯然，柔魂易销。\n屏山冷，有替泪、腊花红照。\n愁悄。\n人眇眇。\n心事问谁，明镜当怀抱。\n小苑栖萤，画楼啼鴂，换了斜阳芳草。\n争柰灵修故来迟，黛眉蝉鬓青蛾老。\n无情天，闷恹恹、一任昏晓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17043,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子","author":"张景祁","text":"登楼何限关心事，树也藏鸦。\n门也飞花。\n可得青春驻鬓华。\n人间别会知多少，锦帐琵琶。\n毡帐风沙。\n月子弯弯照那家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17044,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"埽花游 甲寅初夏，戴鹿床侍郎方云泉司马魏滋伯广文招同章丈次白胡丈琅圃高丈伯荪古民金君杏楼杨君晚岚集朱氏湖庄，即席成咏","author":"张景祁","text":"晚春梦蝶，俯坠粉池台，半成秋苑。\n翠阴渐满。\n衬松涛四壁，画堂寒卷。\n镜里湖光，暗把衣尘净浣。\n蕙风暖。\n送幽绿细香，吹上绡扇。\n开径人意远。\n待静理冰弦，醉拈湘管。\n鬓丝易短。\n笑簪芳帽影，旧红犹染。\n潋滟金尊，要与啼莺共款。\n绕花转。\n祝南屏、暮钟敲缓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":17045,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]