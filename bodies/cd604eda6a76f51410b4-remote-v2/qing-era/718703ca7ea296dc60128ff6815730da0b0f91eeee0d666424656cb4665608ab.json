[{"title":"和阗吟","author":"鄂忻","text":"却喜桑麻地，经年无客过。\n大都春雨少，惟有夏云多。\n秋日光偏洁，冬时气亦和。\n葫芦争取水，来往汲清波。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13476,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"燕中秋感","author":"陈树蓍","text":"幽州秋意早，客望独登台。\n斜日连云去，凉风逐雁来。\n当归非郑重，久立亦迟回。\n已自逢萧瑟，砧声莫漫催。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13477,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"金华题砌下小松","author":"陈树蓍","text":"何年离涧底，傍砌亦成阴。\n未有栋梁具，空含霜雪心。\n墙花低欲压，檐溜暗相侵。\n不作虬龙隐，华嵩山自深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13478,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湘江晓发","author":"李秉礼","text":"轧轧鸣柔橹，行行感暮秋。\n晓鸡催短梦，残月在孤舟。\n炎岳云中出，碧湖天外流。\n一声南去雁，惆怅故园愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13479,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜雨","author":"李秉礼","text":"凉风吹落叶，秋气正萧森。\n一夜孤篷雨，怀人湘水深。\n遥天征雁断，野寺晓钟沈。\n料得重云外，苍苍入桂林。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13480,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"早发襄阳","author":"李秉礼","text":"云树渺无际，江流日夜长。\n猿声初到枕，客梦未离乡。\n古戍吹残角，孤城接大荒。\n鹿门何处是，回首但茫茫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13481,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏夜池上纳凉","author":"李秉礼","text":"披襟坐池上，日夕澹忘归。\n明月忽在水，荷香生我衣。\n夜凉群动息，风定远钟微。\n因念尘中客，翛然似此稀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13482,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送人还乡","author":"李秉礼","text":"送客归南浦，关山满别愁。\n愁心似春水，处处逐君舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13483,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南楼","author":"李秉礼","text":"南楼雨初歇，风溜响潺潺。\n一水到门静，两山终日閒。\n云连村树暝，鸟带夕阳还。\n顿觉烦襟涤，萧然濠濮间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13484,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雪霁登楼","author":"李秉礼","text":"兹晨雪初霁，虚室有余閒。\n登楼一以眺，万象皆澄鲜。\n白日照荒野，豁然开远山。\n历历辨林麓，稍稍鸣幽泉。\n斟酌情弥殷，俯仰神屡迁。\n惊风自北来，孤鸟没寒烟。\n归云将暝色，消散惟空天。\n长歌伫明月，人境两萧然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13485,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"同子乔栖霞寺待月作","author":"李秉礼","text":"钟鱼寂无响，凉秋在高树。\n濛濛烟未收，稍稍月初吐。\n林峦互明晦，阶除已流素。\n既惬平生欢，复兹清景遇。\n幽赏殊未已，芒履沾微露。\n谁为后来者，还当识此趣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13486,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玩珠洞燕集送别子乔之镇安","author":"李秉礼","text":"下瞰无底潭，上压千寻壁。\n石柱忽倒垂，一洞破青碧。\n山空人语响，径古苔痕积。\n既瞻米老像，还求范公迹。\n旷怀耿至今，风流缅似昔。\n浊醪共斟酌，杂坐云根石。\n回瞻隔浦帆，隐隐没沙碛。\n水风时吹衣，斜阳澹将夕。\n偶涉已浩浩，欲去仍恻恻。\n良会不可常，况值远行客。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13487,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晓行","author":"李秉礼","text":"鸡鸣呼仆起，征铎驿门前。\n宿露方沾草，数星犹在天。\n渐分山下路，时听寺旁泉。\n却羡经过处，村村掩户眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13488,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过吴木虚寓斋","author":"李秉礼","text":"怜君栖息处，地僻少人寻。\n野水带茅屋，远风生竹林。\n鸟声临涧响，花气隔帘深。\n好是关情甚，无时却废吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13489,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游铁佛寺华景洞","author":"李秉礼","text":"雨霁山色佳，延眺孤兴发。\n招提倚云根，境寂悟禅悦。\n不逢岩居僧，惟见铁铸佛。\n空翠扑衣衿，灵异秘石窟。\n乳窦极深黝，仄径盘曲折。\n苔滑不留趾，蹙蹜屡防蹶。\n一线漏天光，峭壁忽中裂。\n竦身出峰脊，下视何斗绝。\n恍疑魂梦醒，顿觉心目豁。\n摩挲苍石棱，中有唐宋碣。\n曾经几劫火，古字半磨灭。\n暝色苍然来，去鸟望中没。\n伫立更夷犹，长歌怀往哲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13490,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"季寿无咎复园连日游桂林诸胜复园作图季寿无咎各系以诗装成卷轴示余为作是诗","author":"李秉礼","text":"老眼揩摩眩青碧，湿翠浮岚生几席。\n闭门却扫已逾旬，忽对此图神奕奕。\n诸君夙有烟霞癖，策杖欲穷猿鸟迹。\n蹑云穿洞不知险，岭外奇峰恣探历。\n归来逸兴犹遄飞，千岩万壑填胸臆。\n槎牙奇诡郁不得，吐得云烟挂斋壁。\n我今读画兼读诗，疑有山灵暗中觌。\n卧游便可学宗生，不须更著谢公屐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13491,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重游叠彩山风洞坐秀野亭眺望","author":"李秉礼","text":"好山如好友，怅焉风雨隔。\n朝来喜新晴，还复理轻策。\n苍翠森到眼，一笑获良觌。\n攀萝蹑危磴，扪壁搜古迹。\n有洞忽中穿，巨灵何代擘。\n凛然毛发竦，天风吹不息。\n虚亭纳万象，旷览浩无极。\n日堕林莽间，村墟明历历。\n閒云已归岫，倦鸟亦敛翼。\n延伫未能去，孤吟坐成夕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13492,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"白龙洞","author":"李秉礼","text":"白龙已飞去，千载洞长阴。\n题壁人何在，岩花开至今。\n我来访前迹，祇觉气萧森。\n泉响不知处，泠泠清到心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13493,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"月夜池上","author":"李秉礼","text":"商飙入梧桐，凉月侵虚幌。\n西斋掩书坐，落叶时一响。\n揽衣出前楹，信步成独往。\n圆水涵空净，孤烟逗丛莽。\n梵钟何处来，悠然淡尘想。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13494,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄春槁","author":"汪棣","text":"风露迎阶欲二更，剪镫独客总关情。\n西山爽气曾经眼，东国儒生偶识名。\n中夜忽思笺蝎赋，隔邻偏觉僻驴鸣。\n枣林桑泊多秋色，输与归程缓辔行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13495,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"桐江晓发","author":"汪启淑","text":"篙师蓐食兴，捩舵天犹昧。\n横空白雨来，潇潇响篷背。\n遥指桐君庐，云深迷所在。\n石尤挟银涛，怒激孤舟退。\n起看山作围，坐爱鸥成队。\n江柳袅繁丝，岸草拖轻黛。\n眼餐困客途，林泉发胜概。\n朗诵谢客诗，清游傥能逮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13496,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南亭","author":"汪启淑","text":"雨余景物幽，俯仰得清旷。\n南亭一登临，顿觉吟怀畅。\n澄江作带环，翠岫开屏障。\n于时届朱明，平畴翻碧浪。\n候鸟有佳音，流云幻奇状。\n好风递渔歌，落日闻樵唱。\n平生厌浮华，山林秉微尚。\n何当释尘累，高步追禽向。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13497,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"响铃坟","author":"金德舆","text":"南渡诸陵草木空，一抔犹得瘗蒿蓬。\n荒丘白骨魂休怨，去国青衣恨未穷。\n泪尽铜仙非汉阙，歌残《玉树》恺陈宫。\n夜乌啼歇秋虫死，剩有铃声咽晓风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13498,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"大通桥即景","author":"卓奇图","text":"夹岸垂杨带雨青，踏歌人访濯缨亭。\n几行睡鸭随波注，流到桥边梦未醒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13499,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"八里桥赠别","author":"卓奇图","text":"旗亭重叙别，情逼古河梁。\n远水连秋色，孤帆背夕阳。\n含凄辞故侣，带醉入他乡。\n不尽浮云意，先教寄短章。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13500,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"客过","author":"卓奇图","text":"客过山窗索煮茶，焚香坐石话桑麻。\n闲云飞出岚光瘦，倦鹤归来树影斜。\n老我半生因楮叶，留君十日对桃花。\n量晴较雨饶佳兴，何事劳劳问酒家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13501,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"水西烟雨亭","author":"傅泽洪","text":"雨霁日复佳，乘兴出东郭。\n漫舣桃源舟，曲折上高阁。\n豁然俯苍茫，一叶任飘泊。\n山城烟霭中，远峰翠欲落。\n惊鼠窜古松，清言向修箨。\n缅彼诗中仙，九原其可作。\n返照挂丹枫，秋风入寥廓。\n远公期再来，不言心已诺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13502,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"唐颓山雨后晚眺","author":"张浤","text":"倚眺唐颓阁，晴光四野生。\n残云留树湿，斜日射山明。\n江色连天色，歌声杂橹声。\n徘徊鱼磬里，新月向人清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13503,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山居赠张石帆处士","author":"张浤","text":"数椽空谷里，地迥绝尘氛。\n采药迷归路，看山踏乱云。\n杯倾松上露，饭煮水中芹。\n不识人间事，悠游麋鹿群。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13504,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"姑苏怀古","author":"张浤","text":"金阊系舫独探奇，虎阜登临落照时。\n天外有湖归范蠡，山中无客拜要离。\n杜鹃红染贞娘墓，杨柳愁深伍相祠。\n响屟廊中人化土，尚留新月认蛾眉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13505,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"泊表诚寺","author":"张浤","text":"茑萝寺外草萧萧，流水门前昼夜号。\n苔蚀残碑封瓦砾，烟埋古殿剩松涛。\n一杯麦饭同光武，三尺铜花类汉高。\n莫叹此间荆棘满，钟山陵上亦蓬蒿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13506,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蒋叔程过访余以病未面复见寄一律次韵答之","author":"胡期颐","text":"自信嵇康七不堪，残年决计返江南。\n屋梁落月添离思，天际飞鸿渺去函。\n羡子才如千里马，笑予身似再眠蚕。\n携来佳句浑忘病，更拟寻山看晓岚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13507,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日蒹葭庄漫赋","author":"张符升","text":"九月霜初飞，清光下寒叶。\n天迥蠲俗氛，秋山青见骨。\n微风吹林端，蒲苇声猎猎。\n迢迢远水明，隐隐虚舟涉。\n自分尘缘疏，渺与外人接。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13508,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"桐西","author":"张符升","text":"十年不记桐西路，瘦马间吟入莽苍。\n几叶破帆随短岸，数株残柳曳新霜。\n田园芜尽门犹设，骨肉情多语易长。\n尘坌劳人来又去，竹窗尊酒两茫茫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13509,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平山堂","author":"潘尚仁","text":"栋梁虚敞丽高台，纵目秋光四望开。\n平楚冷烟依槛过，远山晴影入窗来。\n风流阅世成千古，景物兴怀更一回。\n佳句自应推往昔，含毫不觉愧非才。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13510,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怡云别业杂咏 其一","author":"潘尚仁","text":"榆柳团团接翠微，野人心事莫相违。\n白云从此间舒卷，不许澶漫出岫飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13511,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怡云别业杂咏 其二","author":"潘尚仁","text":"茅屋萧疏八九间，双扉终日向溪间。\n何须更上清晖阁，自有高楼看好山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13512,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怡云别业杂咏 其三","author":"潘尚仁","text":"低筑垣墙小界邻，野蜂间蝶往来频。\n最怜山月当头起，比校城中早近人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13513,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怡云别业杂咏 其四","author":"潘尚仁","text":"密竹参差欲涨天，秋来洗得最堪怜。\n自家取足渔竿用，更与溪翁备织筌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13514,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怡云别业杂咏 其五","author":"潘尚仁","text":"一派潺湲梦寐余，百门泉水护幽居。\n耳中俗物应流尽，管取襟怀并太虚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13515,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋雨","author":"郑王臣","text":"泽国多秋雨，湖岚结夕阴。\n湿萤黏坏壁，饥鸟落疏林。\n淅沥蕉声碎，空濛树影沈。\n移书防屋漏，萧索动微吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13516,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过江妃村 其一","author":"郑王臣","text":"南国佳人住水村，春潮寒碧浸篱根。\n蘼芜犹作裙腰色，一道青青直到门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13517,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过江妃村 其二","author":"郑王臣","text":"金枣银蚕葬故乡，梅花犹绕墓门香。\n马嵬原上生秋草，红粉成灰剩锦囊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13518,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒柳公祠 其一","author":"张邦柱","text":"窜迹湘滨十载逾，天将华藻辟灵区。\n从教后世更称圣，不及先生旧号愚。\n八记风流泉石润，四家文字鬼神扶。\n尘颜未敢修长跪，古座衣冠冷笑吾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13519,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒柳公祠 其二","author":"张邦柱","text":"白日悲歌荔子丹，愚溪桥下水漫漫。\n柳公岩古长留姓，司马塘今尚纪官。\n遗庙两州尸祝在，穹碑一片墨痕残。\n清时无复徵蛇乳，闾左恬熙赋役宽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13520,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"人日","author":"张邦柱","text":"残雪初消古市傍，一鞭款款去来忙。\n春交水上三分暖，风落梅边几瓣香。\n颠倒酒人欹皂帽，浅深油壁簇红妆。\n天公解为佳辰霁，不放微云碧宇藏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13521,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"还家偶述","author":"邱中玉","text":"仆仆征途马上身，廿年乡梦系风尘。\n归来偶值登高节，喜极还为太古民。\n泉石留题多老辈，园林历劫忆先人。\n儿童父老团栾会，话到更深不厌贫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13522,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山僧吟赠青眉道人","author":"白衣保","text":"夕阳落幽涧，风泉鸣疏林。\n泉声泻涧影，不乱山僧心。\n山僧久面壁，坐处寒云深。\n哀猿与孤鹤，相伴山僧吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13523,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春愁","author":"白衣保","text":"不解因何事，当春倍黯然。\n野棠孤冢月，芳草暮村烟。\n许国心犹壮，怀人梦可怜。\n无聊频唤酒，费尽买花钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13524,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渡黄河","author":"白衣保","text":"击楫金堤下，中流望眼开。\n水从天上落，人自日边来。\n废垒寒烟白，荒墩画角哀。\n夷门知不远，吊古独徘徊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13525,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日晚归","author":"白衣保","text":"林外红霞拂女墙，征衫初换爱新凉。\n板桥柳色经残雨，山店鸦声报夕阳。\n久客不妨甘寂寞，微官何必卜行藏。\n萧萧鞍马秋风里，又见梧桐几叶黄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13526,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山海关","author":"汪松","text":"关势横吞海，波光直接天。\n帆飞孤屿外，城锁乱山颠。\n俯瞰鱼龙戏，平临日月悬。\n高楼据形胜，千里控幽燕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13527,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜","author":"汪松","text":"牢落深秋候，匡床坐复眠。\n一声远归雁，万里欲寒天。\n隔院砧何急，虚窗月自圆。\n不堪思往事，欹枕夜如年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13528,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"观猎","author":"汪松","text":"鸟道盘盘入碧隈，羊肠河曲水潆洄。\n蕃王似雁随秋至，塞马如云压地来。\n万乘旌旗驱虎豹，六军戈戟拥风雷。\n微臣得睹天王狩，愧乏《长杨》献赋才。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13529,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨中望金山","author":"高玥","text":"钟梵彻云霄，南风度清响。\n客梦忽惊回，清兴共潮长。\n披裘犯晓寒，掀篷畅奇赏。\n烟雨洒空江，迷濛合霄壤。\n中有玉嶙峋，银涛正摇荡。\n金碧晃千层，浮图兀百丈。\n恍如三神峰，缥缈绝来往。\n酬酒祝冯夷，请放江天朗。\n风姨回鸾车，雨师撒云仗。\n碧波细于鳞，晴烟送乌榜。\n振衣北固楼，俾我襟怀爽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13530,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题转庵上人小照 其一","author":"高玥","text":"少小亲戎马，征衣血溅红。\n心灰百战后，身老万山中。\n诗思满幽壑，灵光彻晓钟。\n十年禅榻畔，前事悟真空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13531,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题转庵上人小照 其二","author":"高玥","text":"七尺枯藤杖，间身挂白云。\n自称老禅客，谁识故将军。\n世外渔樵侣，山中麋鹿群。\n劳生惭俗吏，展卷挹清芬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13532,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"霍家桥道中","author":"陆钟辉","text":"江村梅有信，趁暖喜追寻。\n沙软小车疾，草枯黄犊侵。\n断桥横野水，微日淡荒林。\n我是曾来客，廊腰记浅深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13533,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"罗浮","author":"佟钺","text":"十载罗浮梦，新秋问海门。\n云从双涧合，翠拥一峰尊。\n大药留丹灶，长生剩水源。\n妻梅林处士，归老定何村。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13534,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寓夜","author":"陈长钧","text":"沅水三千路已赊，贾胡留滞漫兴嗟。\n半间瓜舍残书满，八尺筠床布被斜。\n月似伴人窥酒盏，虫如对客语窗纱。\n槛云已散斋钟寂，惆怅乡思未有涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13535,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西氿夜行","author":"程梦湘","text":"日夕湖水清，苍茫月明里。\n水清不受月，月出见湖底。\n遥山隐鳞鳞，微波空瀰瀰。\n星星渔火生，杳杳拿音起。\n开帘向空绿，一碧见千里。\n空明溯流光，沿缘撷兰芷。\n盈盈杳难即，临风怀彼美。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13536,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西溪水宿","author":"程梦湘","text":"残月下柁楼，鸣禽破幽寐。\n露稀天益澄，水远星初坠。\n迟明启篷窗，峭寒袭布被。\n时有微风来，芦苇响清吹。\n水花不知名，轻盈送香气。\n渺矣孤客怀，于焉发遐思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13537,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南楼对月","author":"程梦湘","text":"孤鸿声可数，黄叶落无多。\n复此南楼月，离思渺若何。\n烟开溧阳树，山接贡湖波。\n明发归帆远，乘风好放歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13538,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送王梦楼之扬州","author":"程梦湘","text":"金简纷披会百灵，鱼龙曾识使臣星。\n天回沧海千重碧，梦破齐州九点青。\n未许游仙求大药，依然浪迹等飘萍。\n孤篷小作芜城别，卧称江潮带月听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13539,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"解嘲","author":"王道","text":"飘飘如漆转辉光，将老曾无却老方。\n执艺直须龟手药，保身莫倚麝脐香。\n强寻佳句吟常撚，每发狂言怒益张。\n谩说《太玄》原可拟，镌铭泼墨总师扬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":13540,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]