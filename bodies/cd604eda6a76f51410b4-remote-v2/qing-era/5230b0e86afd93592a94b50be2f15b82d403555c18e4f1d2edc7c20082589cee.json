[{"title":"续梅花百咏 其三 官梅","author":"陶德勋","text":"官路迢遥达上京，花开夹道护人行。\n芳名从此传千里，好共梅香一味清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44013,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其四 江梅","author":"陶德勋","text":"几株梅树在江皋，飞絮飘萍偶尔遭。\n自信根深欣有托，耻同浮薄语牢骚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44014,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其五 溪梅","author":"陶德勋","text":"谁识清标傍水滨，一枝映出两枝春。\n天生美质颜如玉，不向西施窃效颦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44015,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其六 岭梅","author":"陶德勋","text":"独占花魁出众芳，岭头数点露春光。\n牧童樵子交相问，道是南枝早向阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44016,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其七 野梅","author":"陶德勋","text":"玉作寒花铁作条，任霜雪压任风摇。\n耻同桃李芳菲斗，独立清标在野桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44017,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其八 忆梅","author":"陶德勋","text":"春光漏泄不如期，犯雪冲寒信转迟。\n仙梦莫回情莫已，栏干十二遍依时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44018,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其九 梦梅","author":"陶德勋","text":"白云深处月明乡，玉骨珊珊引梦长。\n莫谓芳魂米是幻，清香一段绕银床。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44019,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其十 寻梅","author":"陶德勋","text":"东阁寻来又霸桥，江城走遍路遥遥。\n随溪曲达山深处，始见高枝竹外飘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44020,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其十一 问梅","author":"陶德勋","text":"寒天冷节几经过，清气年年袭薜萝。\n借问江南来驿使，芳容肥瘦近如何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44021,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其十二 索梅","author":"陶德勋","text":"不料芳心素守贞，竹篱茅舍久娱情。\n巡檐索得私相笑，静处安身胜禁城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44022,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其十三 观梅","author":"陶德勋","text":"冷艳开来自耐寒，枝间长有鹤盘桓。\n冰姿不比娇姿贱，寄语诗人奠误看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44023,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其十四 赏梅","author":"陶德勋","text":"平生抱负少知音，惟有高人惬素心。\n自是操持能耐冷，名流几辈动清吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44024,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其十五 友梅","author":"陶德勋","text":"终结同松竹般荣，友结寒天喜笑迎。\n莫道交情甘冷淡，平生知己素心盟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44025,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其十六 评梅","author":"陶德勋","text":"梅花雪里见春回，春至梅花向雪开。\n莫道白梅输雪白，梅开向雪占春魁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44026,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其十七 歌梅","author":"陶德勋","text":"瑶台仙质貌如何，风致飘飘喜笑歌。\n一片冰肌赓白雪，天宫特降此姮娥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44027,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其十八 惜梅","author":"陶德勋","text":"终□早起暗伤神，似雪花飞尽染尘。\n洁白亦遭红雨妒，千金难买艳阳春。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44028,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其十九 折梅","author":"陶德勋","text":"水村山郭送香风，开到梅花景不同。\n游玩竞夸春色好，新枝折得插瓶中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44029,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其二十 剪梅","author":"陶德勋","text":"抚树盘桓兴最豪，繁枝宜剪用并刀。\n天寒半出纤纤手，终日攀登不畏高。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44030,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其二十一 浴梅","author":"陶德勋","text":"露洗铅华雨滴腮，晓妆新浴喜春回。\n香流遍本娇无力，疑是仙姬洛水来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44031,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其二十二 簪梅","author":"陶德勋","text":"美人谁不爱簪花，簪得梅花兴更赊。\n螺髻梳成春色拥，一枝香影鬓边斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44032,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其二十三 妆梅","author":"陶德勋","text":"春来克色满含章，额点梅花学寿阳。\n莫谓新妆偏爱淡，暗香浮动月昏黄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44033,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其二十四 蟠梅","author":"陶德勋","text":"树曲枝环久植根，冰霜历炼几晨昏。\n丫杈古干形多怪，仿佛蟠龙绕故园。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44034,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其二十五 接梅","author":"陶德勋","text":"短干长枝任剪裁，春成手底发根荄。\n何人传得长生术，造化功奇善接胎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44035,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其二十六 补梅","author":"陶德勋","text":"四序名花次第开，闲阶尚少玉梅裁。\n年来几费弥缝力，始得浓阴布满台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44036,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其二十七 苔梅","author":"陶德勋","text":"瑶花满放影重堆，谁使纷飞点绿苔。\n知是春风深有意，翠阶衬出玉阶来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44037,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其二十八 杏梅","author":"陶德勋","text":"杏厕梅枝罩曲栏，清香欲吐敢冲寒。\n从知花发人多咏，春雨江南句好看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44038,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其二十九 竹梅","author":"陶德勋","text":"曾见梅斜竹外枝，竹枝竟尔向梅垂。\n庭前种得添双喜，五福三多独自知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44039,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其三十 雪梅","author":"陶德勋","text":"梅飞雪舞岁将残，雪片梅花斗晚寒。\n振作精神增骨力，江头白战钓翁看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44040,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其三十一 月梅","author":"陶德勋","text":"夜入梅林望月华，月华光里数枝斜。\n清香一段从衣出，疑是嫦娥降我家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44041,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其三十二 风梅","author":"陶德勋","text":"花瓣迎风景异常，恍如仙子舞霓裳。\n飘飘飞入昭阳殿，巧为宫人助晓妆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44042,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其三十三 烟梅","author":"陶德勋","text":"古干疏枝远望迷，山村不辨树高低。\n花开庾岭寒香袭，日暮惟闻喜鹊啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44043,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其三十四 孤梅","author":"陶德勋","text":"一树孤高出俗尘，岁寒谁与结芳邻。\n平生风骨何人及，绝世仙姿本绝伦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44044,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其三十五 移梅","author":"陶德勋","text":"春日移栽白玉条，江城已出过溪桥。\n山行历尽羊肠路，知有余香满处飘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44045,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其三十六 疏梅","author":"陶德勋","text":"梅惟数点动清思，落落疏疏放石涯。\n岂似春风桃李树，繁花密蕊咏新诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44046,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其三十七 新梅","author":"陶德勋","text":"韶光初启物华新，先吐寒梅色更匀。\n自笑花魁今早占，岭头高放一枝春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44047,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其三十八 矮梅","author":"陶德勋","text":"不及苍松树几寻，花开数点见天心。\n俯身伏处茅檐下，未许红尘十丈侵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44048,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其三十九 远梅","author":"陶德勋","text":"杳杳长枝又短枝，莫通消息动遐思。\n时来风送香千里，月到窗前进酒卮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44049,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其四十 瘦梅","author":"陶德勋","text":"容颜清瘦异痴肥，玉骨珊珊月下归。\n莫道严寒姿渐减，终存老干小腰围。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44050,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其四十一 宫梅","author":"陶德勋","text":"未经霜雪学宫妆，雨露恩承体自香。\n自笑清姿尘不染，冰肌玉骨侍昭阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44051,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其四十二 檐梅","author":"陶德勋","text":"疏影斜枝近屋檐，时来雨露色何淹。\n窗中睡起无情思，欲看香姿唤卷廉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44052,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其四十三 咀梅","author":"陶德勋","text":"质具和羹品自华，闲中咀嚼味堪嘉。\n涵濡厌饫吞还吐，总有清香在齿牙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44053,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其四十四 寒梅","author":"陶德勋","text":"不同桃李斗芬芳，耿耿精神独傲霜。\n知是一生风骨健，天寒时节愈生香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44054,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其四十五 盆梅","author":"陶德勋","text":"盆内根蟠小洞天，形同陶甓一般圆。\n不争雨露沾窗外，常伴琴书置几前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44055,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其四十六 粉梅","author":"陶德勋","text":"点缀霜华与雪华，浑如宫样著银花。\n不须脂黛添颜色，妆淡偏宜处士家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44056,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其四十七 黄梅","author":"陶德勋","text":"雨到家家景物奇，黄梅酿熟子离离。\n枝头恰似垂金弹，众鸟惊飞不敢窥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44057,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其四十八 盐梅","author":"陶德勋","text":"遇合由来贵雨匀，阴阳燮理羡名臣。\n知君久蓄和羹意，鼎鼐相调助一人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44058,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其四十九 早梅","author":"陶德勋","text":"葭灰已动菊将残，序入初冬雪意寒。\n不待柳条光漏泄，梅将春信报人看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44059,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其五十 红梅","author":"陶德勋","text":"朱唇洁净避尘侵，不藉东皇点缀心。\n艳色天然增笑靥，翻从雪里见情深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44060,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其五十一 蜡梅","author":"陶德勋","text":"标标骨格服黄裳，不比春花异样妆。\n藉同名园谁得似，独留金瓣散寒香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44061,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其五十二 落梅","author":"陶德勋","text":"玉笛声声出水滨，缤纷小片点芳尘。\n不知花落春仍在，踏尽江城亦可人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44062,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其五十三 探梅","author":"陶德勋","text":"霜中花著好沉吟，曾否高枝放故林。\n几日天寒偏踏雪，江边篱落寄遐心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44063,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其五十四 枯梅","author":"陶德勋","text":"短干疏枝露爪牙，春来再发旧时花。\n任他冷雨兼风雪，犹带苍苔竹外斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44064,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其五十五 瓶梅","author":"陶德勋","text":"终朝调水几番忙，雨露无沾且自芳。\n正是安身凭净几，聊随隐者并徜徉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44065,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其五十六 寄梅","author":"陶德勋","text":"报道江南已早春，城中景色一时新。\n风光旋转无他物，聊寄寒枝慰远人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44066,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其五十七 千叶梅","author":"陶德勋","text":"瑶台叠叠又重重，叶瓣玲珑月影中。\n寄语主人须护惜，名经喜兆乐无穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44067,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其五十八 鸳鸯梅","author":"陶德勋","text":"灯花并蒂出银缸，梅实枝头结一双。\n试向阶前观月影，离离成对上纱窗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44068,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其五十九 钓矶梅","author":"陶德勋","text":"几树寒梅傍钓矶，渔翁相对竞忘机。\n得鱼沽酒杯盘设，月上梢头尚未归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44069,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其六十 樵径梅","author":"陶德勋","text":"峻岭深山一径微，参差老干影依稀。\n樵夫也爱幽香好，满路狂歌对落晖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44070,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其六十一 僧舍梅","author":"陶德勋","text":"僧家院落月溶溶，吐出清香透几重。\n一笑拈来供宝座，优昙钵里现真容。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44071,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其六十二 道院梅","author":"陶德勋","text":"枝枝瓣瓣醉丹霞，坛护先天自一家。\n鹤助精神松作友，漫云不及竹篱赊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44072,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其六十三 柳营梅","author":"陶德勋","text":"老干春回自各荣，参差杂出柳林营。\n望来能止三军渴，善助兵家出大名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44073,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其六十四 茅舍梅","author":"陶德勋","text":"几树扶疏绕草堂，春来一路吐幽香。\n从兹玩赏敦乡俗，野老村翁并举觞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44074,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其六十五 蔬圃梅","author":"陶德勋","text":"几番灌溉破春畦，花发疏篱朵朵齐。\n一段清香流菜甲，许多滋味透黄齑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44075,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其六十六 药畦梅","author":"陶德勋","text":"杏林芝圃各成家，夹道栽梅又发花。\n结实普同称道地，辛酸有味动人夸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44076,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其六十七 前村梅","author":"陶德勋","text":"瑶花开遍满前村，风引清香忽入门。\n识得程途休畏远，好邀名友去开樽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44077,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其六十八 照水梅","author":"陶德勋","text":"玉条倒映似琉璃，攀折何人及水涯。\n试问几生修得到，往寻踯躅似临歧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44078,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其六十九 山中梅","author":"陶德勋","text":"骨瘦姿清未有尘，身依岩谷也知春。\n一生幽静谁为侣，鹊噪枝头听晓频。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44079,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其七十 胭脂梅","author":"陶德勋","text":"槛拂春风起莫迟，娇姿迎笑晓霜时。\n寿阳恩渥新承宠，浓点朱唇喜兆眉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44080,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其七十一 西湖梅","author":"陶德勋","text":"精神耿耿骨标标，共道芳容胜灞桥。\n湖里寒香清且远，孤山鹤翅雪同飘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44081,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其七十二 东阁梅","author":"陶德勋","text":"仙姿玉质立亭亭，子美吟诗半醉醒。\n淑气扇来春几许，骚人何事赋飘零。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44082,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其七十三 清江梅","author":"陶德勋","text":"梅绕江边水照枝，玲珑倒影漾琉璃。\n一番好景谁能画，香送清风妙助诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44083,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其七十四 孤山梅","author":"陶德勋","text":"图经何事志山孤，伴结梅花几百株。\n枝上香风飘雪月，勾留处士有林逋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44084,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其七十五 罗浮梅","author":"陶德勋","text":"罗浮仙女遇昏黄，共醉梅林夜气凉。\n玉骨冰肌真解语，酒醒人杳恨偏长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44085,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其七十六 汉宫梅","author":"陶德勋","text":"满树开来白玉同，何人移置未央宫。\n纵然雨露恩多沐，不及西湖月与风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44086,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其七十七 廨舍梅","author":"陶德勋","text":"横窗疏影锁轻寒，粉署生香意自宽。\n酌酒闲看方退食，枝头月上夜漫漫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44087,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续梅花百咏 其七十八 书窗梅","author":"陶德勋","text":"阵阵清香入董帷，窗前花影月中枝。\n天心数点微风骨，只爱诗书不媚时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":44088,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]