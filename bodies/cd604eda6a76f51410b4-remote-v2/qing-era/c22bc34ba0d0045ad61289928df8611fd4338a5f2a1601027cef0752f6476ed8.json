[{"title":"台湾纪巡诗 其九","author":"夏之芳","text":"不须挑逗苦劳心，竹片沿丝巧作琴。\n远韵低微传齿颊，依稀私语夜来深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3035,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其十","author":"夏之芳","text":"男拔髭须女绣颐，乍逢鉴貌尽多疑。\n雕题凿齿徒矜尚，未解双蛾夜画眉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3036,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其十一","author":"夏之芳","text":"杵臼轻敲似远砧，小鬟三五夜深深。\n可怜时办晨炊米，云磬霜钟咽竹林。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3037,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其十四","author":"夏之芳","text":"南山中断北山连，逗漏云间半线天。\n道是孤城还少郭，竹环廛市起炊烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3038,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其十五","author":"夏之芳","text":"献芹再拜语呢喃，款步芳阶舞绣衫。\n具道殷勤猫女意，粉餈亲制手掺掺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3039,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其十六","author":"夏之芳","text":"花冠银钏锦为衣，妙舞清歌笑合围。\n低唱一声金一扣，独留太上古音希。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3040,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其十八","author":"夏之芳","text":"莽葛轻便破碧沙，弄潮如戏语喧哗。\n依稀佛子乘杯渡，彷佛仙翁泛海槎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3041,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其十九","author":"夏之芳","text":"倦来高枕树为巢，藤蔓连牵枝格交。\n栩栩梦回非是蝶，一身幻化类蟏蛸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3042,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其二十","author":"夏之芳","text":"临溪问渡少舽艭，石涧分流远击撞。\n腰上葫芦头上羽，只身飞过水淙淙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3043,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其二十一","author":"夏之芳","text":"抄阴尺布不堪缝，无褐无衣可耐风。\n北地乍寒偷射猎，人人尽是鹿皮翁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3044,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其二十二","author":"夏之芳","text":"北辙初回又指南，迢迢原隰未停骖。\n看山几遍还遵海，阅尽边方烟与岚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3045,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其二十三","author":"夏之芳","text":"成帷成幕逐飞尘，纨裤多缠舆隶身。\n惯习淫奢无善俗，少年思怕老来贫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3046,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其二十四","author":"夏之芳","text":"二林迤逦接三林，淡水溁洄咸水深。\n极目沧波浮海市，一拳真欲笑蹄涔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3047,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其二十五","author":"夏之芳","text":"晓霞散彩覆阴厓，海曲人家逐岸排。\n烟水几湾帆几幅，顿教风景忆江淮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3048,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其二十六","author":"夏之芳","text":"木冈东峙晓云凝，咫尺阪陀未即登。\n指点万山分脉处，一峰独秀镇平陵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3049,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其二十七","author":"夏之芳","text":"观音山径几湾环，罗汉门边虎豹关。\n笑指当年空守戍，但知深谷有乌蛮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3050,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其二十八","author":"夏之芳","text":"陂卧晴沙号七鲲，如环如抱复如蹲。\n惊涛夜拍殷雷起，远势平吞鹿耳门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3051,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其三十一","author":"夏之芳","text":"矫首南荒欲尽头，影浮拳石小琉球。\n天回地转渺无际，万水朝宗亘古流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3052,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其三十三","author":"夏之芳","text":"赤山葱翠漾春烟，沙暖云晴别有天。\n日午崖边人语沸，村童队队浴汤泉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3053,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其三十四","author":"夏之芳","text":"生成野性气如枭，出没无端血染刀。\n剥得头颅当户挂，归来轰饮共称豪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3054,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其三十五","author":"夏之芳","text":"内山遥夹外山高，复岭重冈叠翠涛。\n一带阿猴林下路，须防薮泽有逋逃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3055,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其三十六","author":"夏之芳","text":"八社丁徭力渐纾，番娘饷税早捐除。\n只今宵昼辛勤处，谨护官家十万储。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3056,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其三十七","author":"夏之芳","text":"生熟番情百种馀，半生半熟亦山居。\n当年户口可知数，尽向鱼鳞册上书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3057,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其三十八","author":"夏之芳","text":"问俗殊方竟未厌，忽教放索转丹襜。\n天南水起山穷处，琅峤云从马首瞻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3058,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾纪巡诗 其三十九","author":"夏之芳","text":"星轺回处转旌霓，人海无声马不嘶。\n敢道霜威堪镇俗，长思涛静木城西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3059,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"喜雨","author":"书山","text":"天作及时雨，民番乐有年。\n景风初布种，解泽已盈田。\n海壤珍唯谷，神庥瑞应虔。\n欢情看长养，南北共熙然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3060,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"劝农归路经海会寺与诸同人分赋 其二","author":"书山","text":"问讯词坛客，山僧逸兴同。\n地高晴翠合，林静妙香通。\n登眺消尘虑，安閒步梵宫。\n寸心持半偈，顿觉海天空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3061,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"彰化八景","author":"秦士望","text":"草昧谁开大海东，高烧烈火有神功。\n赤霞晓映扶桑日，丹嶂晴驱擘柳风。\n焰射鸡笼遥可接，光衔鹭岛远为烘。\n凌晨景物欣何似，万丈芙蓉照眼红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3062,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"彰化八景","author":"秦士望","text":"海滨世界洗洪荒，瓦缝参差映夕阳。\n羁客远投冠盖里，落霞低衬水云乡。\n渔舟鼓浪醒诗眼，牧笛眠风破酒肠。\n返照山城烟树晚，画图指认色苍茫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3063,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"彰化八景","author":"秦士望","text":"如眉似月水波平，傍水逢秋月色明。\n影坠澄潭蟾不老，香飘仙桂兔长生。\n地偏良夜多鸥宿，天远长空少雁鸣。\n扑面红尘聊借鉴，双眸万里一心清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3064,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"彰化八景","author":"秦士望","text":"牛触高峰两壁攒，虎溪中出水流寒。\n每逢三月添霪雨，定遣重山走汎湍。\n怒撼奔雷声浩浩，猛归沧海势漫漫。\n行人过此常惊胆，黯淡如何又一滩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3065,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"彰化八景","author":"秦士望","text":"不比寻常水一隈，柴门爱逐海波开。\n船撑白昼几行去，灯闹黄昏乱点来。\n遥吐珠光浮岛屿，久腾星火照莓苔。\n两般佳趣疑相似，共卧渔蓑弄酒杯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3066,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"彰化八景","author":"秦士望","text":"山高树老与云齐，一径斜穿步欲迷。\n人迹贪随岩鹿隐，歌声喜和野禽啼。\n悠扬入谷音偏远，缭绕因风韵不低。\n刈得荆薪偿酒债，归来半在日沉西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3067,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"彰化八景","author":"秦士望","text":"缥缈孤亭荡碧天，游人得到俨登仙。\n举头万里晴光彻，笑指千岩秀色悬。\n云去云来风片片，鸟飞鸟落水田田。\n纵观沧海尘寰远，一点征帆一点烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3068,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"彰化八景","author":"秦士望","text":"山城竹郭雨霏霏，郭外青山湿翠微。\n冷雾埋林藏半线，浓烟扑地锁重扉。\n燕穿深巷频频语，鹭下寒塘缓缓飞。\n白发番黎寻乐计，披蓑学坐钓鱼矶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3069,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"东宁十咏","author":"高拱乾","text":"晓来吹角彻苍茫，鹿耳门边几战场。\n流毒犹传日本国，偏安空比夜郎王。\n楼船将帅悬金印，郡县官僚辟草堂。\n使者莫嫌风土恶，番儿到处绕车旁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3070,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"东宁十咏","author":"高拱乾","text":"州县功名宁复论，承家世受国深恩。\n拂须自昔轻参政，强项从来动至尊。\n客去留诗鱼挂壁，吏閒无牍雀罗门。\n韶光抛掷真堪惜，野杏春深落满村。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3071,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"惠献贝子功德诗八章寄呈德济齐制府并序 其一","author":"张湄","text":"宗臣庙算定岩疆，奕世盟勋带砺长。\n黄石书精馀枕秘，青油幕远即戎行。\n天家枝干标英早，阃外韬钤决策良。\n受命专征谁得似，东山零雨古锜斨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3072,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"惠献贝子功德诗八章寄呈德济齐制府并序 其二","author":"张湄","text":"横海将军下濑船，轻飞迅度讶从天。\n鲸鲵尽扫波方静，蔓草难图势更延。\n直许奋身先士卒，可堪带甲满山川。\n闻声便慰云霓望，况复王师出万全。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3073,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"惠献贝子功德诗八章寄呈德济齐制府并序 其三","author":"张湄","text":"惠泽仁风却战氛，恩怀挟纩遍三军。\n梯云冷辟荆榛路，渡水宵乘鹅鹜群。\n疾苦再三亲慰问，箪醪取次爱平分。\n丈人正协师中吉，马首讴歌到处闻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3074,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"惠献贝子功德诗八章寄呈德济齐制府并序 其四","author":"张湄","text":"劳瘁年年短后衣，营门柳色几依微。\n婴城屹立邱山重，传箭齐惊霹雳飞。\n七省藩篱争海口，三家苞檗陨霜威。\n南天夜报平安火，大将功成鬓欲稀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3075,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"惠献贝子功德诗八章寄呈德济齐制府并序 其五","author":"张湄","text":"计日班师颂止戈，乘箕忽地白云窝。\n大星落处光芒在，群马悲馀涕泗多。\n但有图书遗败橐，空烦士女致虞歌。\n江山不改民完聚，忍见萧然丹旐过。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3076,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"惠献贝子功德诗八章寄呈德济齐制府并序 其六","author":"张湄","text":"餐风沐雨竭绸缪，掩骼埋胔德意周。\n半壁已成磐石固，一言不及子孙谋。\n帝深震悼思元佐，礼备荣哀答壮猷。\n曾为羊公同罢市，丰碑积泪岘山头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3077,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"惠献贝子功德诗八章寄呈德济齐制府并序 其七","author":"张湄","text":"巍峨庙貌耸高旻，鸟革翚飞藻采陈。\n漠漠云烟凝肸蚃，丸丸松柏历冬春。\n维新竞铸黄金像，感旧犹存白发民。\n往日指麾旄钺处，山巅水涘肃迎神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3078,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"惠献贝子功德诗八章寄呈德济齐制府并序 其八","author":"张湄","text":"紫泥书札凤鸾驰，诏予贤良再立祠。\n海国瞻依同怙冒，瑶林郁积发孙枝。\n香升俎豆烝尝远，节制东南棨戟移。\n我亦州民叨厦庇，咏恩聊继瓠蒲诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3079,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"游海会寺次楸村韵 其一","author":"张湄","text":"山郭雨初霁，招提忽入来。\n寒云流梵韵，湿翠上莲台。\n钵为投诗满，扉缘憩客开。\n催耕馀好鸟，人静语林隈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3080,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"游海会寺次楸村韵 其二","author":"张湄","text":"野趣自清旷，丰年情不同。\n泉新茶碗碧，火宿石垆红。\n眺海三层阁，栽花半亩宫。\n息心尘外赏，远屿夕烟空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3081,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾杂咏 其二","author":"陈兆蕃","text":"天空海阔任婆娑，极目冈陵髻似螺。\n草地桑苗迟作赋，鸿濛笔墨渐开科。\n狰狞番女披衣少，劳苦车牛涉水多。\n五十年前兵甲事，犹馀父老为谈么。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3082,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"恭纪惠献贝子王平定浙闽功迹颂言 其一","author":"舒辂","text":"简膺虎竹出天潢，重倚长城奠楚疆。\n越海移幢游釜纵，闽封提旅丑蛮张。\n肤功巳奏题铜柱，圣虑无烦宠凤章。\n南国祇今遗泰泽，金环千载映辉煌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3083,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"恭纪惠献贝子王平定浙闽功迹颂言 其二","author":"舒辂","text":"功仁积累后昌宜，莲幕重开制两师。\n浙水闽山隆旧祀，彝樽龙勺仰新祠。\n香飘汉末浮龙黼，璧耀牛墟引凤旗。\n槎使同疆逢盛典，未兴趋事共讴诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3084,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"喜雨纪事复张道长","author":"舒辂","text":"夏木森森鸣播谷，村农拥耜待耕作。\n膏田未泽莫乘时，举首云霓心如灼。\n蠲济飞章方入告，难堪旱魃重为虐。\n重膺宠命在封疆，感召未能责岂薄。\n行祷省躬虔对神，龙潭祝水步初却。\n油然倏尔幔长空，殷殷雷声飞电烁。\n甘霖日夜续倾盘，四野田畴苍漠漠。\n处处蓑锄忙陇亩，新苗秀发欢奚若。\n幸叨天鉴降鸿庥，协气和声通寥廓。\n海甸清平民业安，与君正好欢杯酌。\n凛然感应勉忠诚，报国唯期切民瘼。\n从此及时雨泽绵，一封大有奏天阁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3085,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"荒地欲松园更腴，诛茅覆草令秋枯。\n种时禾秸惊风雨，杂植还教薏苡扶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3086,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"小楼贮粟号禾间，剉竹编茅盖自閒。\n应识名禾知本计，可专饮血事搜山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3087,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"蛮娘织作亦殊勤，圆木中空槽口分。\n尺布可堪持北去，但令知有达戈纹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3088,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"霜钟云磬韵双清，何处村庄旋旋鸣。\n北客初来听不厌，那知此是夜舂声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3089,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"未负耕犁未服辀，谁教驯狎入栏收。\n番儿自惯无鞍马，大武山头捉野牛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3090,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"仰沫巨鱼才跃波，矢无虚发巧如何。\n于今苦学汉人法，驾筏施罛事转多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3091,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"地辟年来少鹿场，焚林设阱两堪伤。\n擒生剪耳如黄犊，相逐平原互斗强。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3092,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"盛植槟榔覆四檐，浓阴夏月失曦炎。\n猱升取子飞腾过，不用如钩长柄镰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3093,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"出草秋深尽夏初，刖蹄剖腹外无馀。\n当官已报社商革，五谷鸡豚一一书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3094,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"兽皮时出内山深，互市传来直至今。\n莫道汉人曾未到，熟番有路敢探寻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3095,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"不为穴处不巢巅，布毯牢将两树缠。\n此味睡乡人不识，不须化蝶自翩翩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3096,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"社中各自置楼高，猫踏更番未觉劳。\n击柝宵严镖箭利，尽教鼠窃远潜逃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3097,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"未经牵手尚腰围，习惯身轻走若飞。\n凉夜月明齐展足，羡他猫女愿同归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3098,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"制琴四寸截琅玕，薄片青铜窍可弹。\n一种幽音承齿隙，如闻私语到更阑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3099,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"配他弦索亦相宜，小孔横将按鼻吹。\n引得凤来交唱后，何殊秦女欲仙时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3100,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"赘婿为儿妇是家，还怜凿齿擦蕉花。\n何如高架迎归去，偕老相期礼自嘉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3101,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"生儿出浴向河滨，仙气长留冷逼人。\n三保当年曾到处，南洋诸国尽称神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3102,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"殊风虽陋尚堪论，恤老收穷古意存。\n长者途逢皆却步，朋侪相见亦寒温。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3103,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"外沿大海内深溪，浮水葫芦每自携。\n惟有土官乘筏过，众擎如蚁两行齐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3104,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"番社杂咏二十四首","author":"黄叔璥","text":"历书不识岁时增，月几回圆稻一登。\n邻社招邀同报赛，竹杯席地俗相仍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":3105,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]