[{"title":"题织图二十三首 其九 第九图","author":"玄烨","text":"蚕性由来苦畏寒，深垂帘幕夜将阑。\n炉头更爇松明火，老媪殷勤日探看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36574,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题织图二十三首 其十 第十图","author":"玄烨","text":"自昔蚕缫重妇功，曾闻献茧在深宫。\n披图喜见累累满，茅屋清光积雪同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36575,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题织图二十三首 其十一 第十一图","author":"玄烨","text":"冰茧方堪作素纨，重绵亦藉禦深寒。\n就中自有因材法，拣取筐间次第观。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36576,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题织图二十三首 其十二 第十二图","author":"玄烨","text":"一年蚕事已成功，历数从前属女红。\n闻说及时还窖茧，荷锄又向绿阴中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36577,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题织图二十三首 其十三 第十三图","author":"玄烨","text":"炊烟处处绕柴篱，翠釜香生煮茧时。\n无限经纶从此出，盆头喜色动双眉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36578,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题织图二十三首 其十四 第十四图","author":"玄烨","text":"蛾儿布子如金粟，水际分飞任所之。\n莫令茧丝遗利尽，来年留作授衣资。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36579,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题织图二十三首 其十五 第十五图","author":"玄烨","text":"劳劳拜簇祭神桑，喜得丝成愿已偿。\n自是西陵功德盛，万年衣被泽无疆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36580,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题织图二十三首 其十六 第十六图","author":"玄烨","text":"绿阴掩映野人家，每到蚕时静不哗。\n一自夏初成茧后，篱边新听响缫车。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36581,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题织图二十三首 其十七 第十七图","author":"玄烨","text":"从来蚕绩女功多，当念勤劳惜绮罗。\n织妇丝丝经手作，夜寒犹自未停梭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36582,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题织图二十三首 其十八 第十八图","author":"玄烨","text":"无衣卒岁早关情，寒气催人蟋蟀声。\n茅屋疏篱秋夜永，短檠相对络丝成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36583,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题织图二十三首 其十九 第十九图","author":"玄烨","text":"织纴精勤有季兰，牵丝分理制罗纨。\n鸣机来往桑阴里，已作吴绡匹练看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36584,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题织图二十三首 其二十 第二十图","author":"玄烨","text":"凝膏比洁络新丝，传得仙方色陆离。\n一代文明资贲饰，须教五采备彰施。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36585,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题织图二十三首 其二十一 第二十一图","author":"玄烨","text":"巧样争传濯锦纹，堪怜织女最殷勤。\n云章霞綵娱人意，自著寻常缟布裙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36586,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题织图二十三首 其二十二 第二十二图","author":"玄烨","text":"手把齐纨冰雪清，秋衣欲制重含情。\n逡巡莫谩施刀尺，万缕千丝织得成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36587,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题织图二十三首 其二十三 第二十三图","author":"玄烨","text":"已成束帛又缝纫，始得衣裳可庇身。\n自昔宫庭多浣濯，总怜蚕织重劳人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36588,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"天花","author":"玄烨","text":"灵山过雨万松青，朵朵缃云摘翠屏。\n玉笈重缄敕飞骑，先调六膳进慈宁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36589,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"邓尉山","author":"玄烨","text":"邓尉知名久，看梅及早春。\n岂因耽胜赏，本是重时巡。\n野霭朝来散，山容雨后新。\n缤纷开万树，相对惬佳辰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36590,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏盆中松竹梅各一首 其三 梅","author":"玄烨","text":"琼林遗玉骨，粉蕊趁冰姿。\n香透芙蓉帐，诗成度玉墀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36591,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"懋勤殿古干梅","author":"玄烨","text":"宫梅先发上林枝，淡白含芳窈窕姿。\n若待春风吹律暖，影随朝日乐雍熙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36592,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和唐太宗咏桃花即用原韵","author":"玄烨","text":"苑里韶华满，春工试绮装。\n霞轻笼树影，日暖散林光。\n倚槛千丛锦，开帘百合香。\n东风自骀宕，长护万年芳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36593,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雨后见梅花","author":"玄烨","text":"新雨濛濛宜五沃，蒸霞始放见钱江。\n初春锦绣铺千树，落日微吟坐北窗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36594,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 前过江浙桃花已放今回銮至津门复见桃花盛开","author":"玄烨","text":"再见桃花，津门红映依然好。\n回銮才到。\n疑似两春报。\n锦䌫仙舟，星夜盼辰晓。\n情飘渺。\n艳阳时袅。\n不是垂杨老。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36595,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏画梨花","author":"玄烨","text":"最爱梨花白，又惜同春老。\n惟此画图中，冬夏长美好。\n不令风雨摧，且无蜂蝶娆。\n靓妆伴月容，尽在纸间造。\n恶紫嫌夺朱，素体物难搅。\n三品运胸中，六法生卉草。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36596,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"榴花","author":"玄烨","text":"未结千房实，先开五月花。\n红绡帘户下，疑似汉时槎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36597,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"榴花","author":"玄烨","text":"丹诚映白日，艳色喜清幽。\n嫩绿疏棂外，开时傍翠楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36598,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"盆景榴花高有数寸开花一朵","author":"玄烨","text":"小树枝头一点红，嫣然六月杂荷风。\n攒青叶里珊瑚朵，疑是移根金碧丛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36599,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"初秋幸西苑观荷命小船采莲","author":"玄烨","text":"命驾来西苑，初秋向晚天。\n芰荷池沼满，鸥鹭夕阳边。\n频使移轻舫，时来献采莲。\n离宫阑槛外，风动碧翩翩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36600,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"千叶莲池夜闻雨滴之声","author":"玄烨","text":"田田荷盖雨声齐，楼蕊缤纷向晚迷。\n树叶不愁点翠幄，秧针岂忆灌青畦。\n密林有意通宵响，茂草无知遍地萋。\n偶尔喜吟今岁好，漫将诗句入新题。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36601,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"千叶莲","author":"玄烨","text":"禁苑初秋玉殿凉，绿荷经濑递清商。\n千英水面重重艳，几度风前柄柄香。\n宫女移船摇绀叶，近臣载笔咏红芳。\n定心坐对西山静，不管秾纤映夕阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36602,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日讲毕同翰林张英高士奇励杜讷看荷","author":"玄烨","text":"千队芙蓉太液池，迎薰初散讲筵时。\n螭头绝胜金莲烛，自有清香送晓飔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36603,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏燕新莲 其一","author":"玄烨","text":"紫燕双双到案前，天教霖雨足禾田。\n临窗斜掠莲花影，云与波光皆渺然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36604,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"七夕观千叶莲","author":"玄烨","text":"玉露初分水殿凉，满地红白杂芬芳。\n香飘随座皆秋色，细月胧胧挂未央。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36605,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏各种牡丹","author":"玄烨","text":"晨葩吐禁苑，花莳就新晴。\n玉版参仙蕊，金丝杂绿英。\n色含泼墨发，气逐彩云生。\n莫讶清平调，天香自有情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36606,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆畅春园牡丹","author":"玄烨","text":"晓雨疏疏薄洒，午风习习轻吹。\n忽念畅春花事，正当万朵开时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36607,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"畅春园众花盛开最为可观惟绿牡丹清雅迥常世所罕有赋七言绝以记之","author":"玄烨","text":"碧蕊青霞压众芳，檀心逐朵韫真香。\n花残又是一年事，莫遣春光放日长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36608,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉兰","author":"玄烨","text":"琼姿本自江南种，移向春光上苑栽。\n试比群芳真皎洁，冰心一片晓风开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36609,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏杜鹃花赐高士奇","author":"玄烨","text":"石岩如火本天台，秀质丹心日月催。\n移根禁苑清诗句，朱夏山林惜茂才。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36610,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋兰","author":"玄烨","text":"猗猗秋兰色，布叶何葱青。\n爱此王者香，著花秀中庭。\n幽芬散缃帙，静影依疏棂。\n岂必九畹多，侈彼离骚经。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36611,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"云栖竹树甚茂幽兰满山","author":"玄烨","text":"山径纡徐合，溪声到处闻。\n竹深阴戛日，木古势干云。\n倚槛听啼鸟，攀崖采异芬。\n韶华春已半，万物各欣欣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36612,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏幽兰","author":"玄烨","text":"婀娜花姿碧叶长，风来难隐谷中香。\n不因纫取堪为佩，纵使无人亦自芳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36613,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"九日对菊","author":"玄烨","text":"不与繁花竞，寒苞晚更香。\n数茎偏挺秀，嘉尔傲风霜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36614,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"见案头水仙花偶作二首 其一","author":"玄烨","text":"翠帔缃冠白玉珈，清姿终不污泥沙。\n骚人空自吟芳芷，未识凌波第一花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36615,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"见案头水仙花偶作二首 其二","author":"玄烨","text":"冰雪为肌玉鍊颜，亭亭如立藐姑山。\n群花只在轩窗外，那得移来几案间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36616,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"柳梢青 咏岭外金莲盛放可爱","author":"玄烨","text":"万顷金莲。\n平临难尽，高眺千般。\n珠蹙移花，翠翻带月，无暑神仙。\n俗人莫道轻寒。\n悠雅处、馀香满山。\n岭外磊落，远方隐者，谁似清闲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36617,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"山菊蓝雀花","author":"玄烨","text":"雨过初凉至，山花遍野馨。\n虽无红紫艳，能使属车停。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36618,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"樱桃","author":"玄烨","text":"禁籞朱樱晓露匀，不须驿骑拂红尘。\n芙蓉未赐千官会，寝庙春残早荐新。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36619,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"樱桃","author":"玄烨","text":"初夏含桃味早全，西山结实弱枝连。\n赤瑛充荐休言过，丹色浓浓众果先。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36620,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏林檎","author":"玄烨","text":"野果初来上苑东，紫红鲜品进离宫。\n虽然不及群珍味，也有微诚在此中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36621,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"元旦","author":"玄烨","text":"广廷扬九奏，玉帛丽朝光。\n恭已临四表，垂衣驭八荒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36622,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"上元","author":"玄烨","text":"月华连昼色，灯火杂星辰。\n彩仗移双阙，琼筵会大臣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36623,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"慈宁宫问太皇太后安","author":"玄烨","text":"定省深宫曙气催，承恩献寿捧霞杯。\n晨昏敬睹慈颜豫，不尽欢欣踊跃回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36624,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"月","author":"玄烨","text":"影送楼台照水明，金波荡漾远含清。\n西山色净云初散，南苑风和令正行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36625,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"昭仁殿","author":"玄烨","text":"雕梁双凤舞，画栋六龙飞。\n崇高惟在德，壮丽岂为威。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36626,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赐旧时讲学","author":"玄烨","text":"几前烛下长谈论，今日忽为垂老人。\n怜尔林泉安淡薄，因思畴昔侍枫宸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36627,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赐抚远大将军图海二首 其一","author":"玄烨","text":"两朝密勿重元臣，秉钺登坛西定秦。\n钟鼎功名悬日月，丹青事业画麒麟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36628,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赐抚远大将军图海二首 其二","author":"玄烨","text":"威名万里作长城，壁垒旌旗壮远征。\n绥靖边陲驰露布，凯旋立奏泰阶平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36629,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夜半","author":"玄烨","text":"览书银蜡短，观象玉衡长。\n夜半无穷意，心为念万方。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36630,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"琴","author":"玄烨","text":"峄阳桐百尺，斲为凤凰琴。\n调丝坐石上，宛若松风吟。\n希音合太古，贵以鍊予心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36631,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晚春游幸感怀","author":"玄烨","text":"岸花芳且落，树木含春光。\n思赏肠应断，长怀万古伤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36632,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"河","author":"玄烨","text":"春风野水秾花发，一道帆樯带柳烟。\n影动长桥横螮蝀，岸铺芳草近南川。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36633,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"白洋湖","author":"玄烨","text":"遥看白洋水，帆开远树丛。\n流平波不动，翠色满湖中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36634,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"