[{"title":"望江南 寄东皋冒巢民先生并一二旧游十首 其五","author":"陈维崧","text":"如皋忆，犹忆看春人。\n夹巷帘栊空胜水，后街香粉碾成尘。\n看煞不曾嗔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34254,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 寄东皋冒巢民先生并一二旧游十首 其六","author":"陈维崧","text":"如皋忆，曾记卧湘中。\n万点水花笼夜碧，半岩火树落春红。\n飏起妓衣风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34255,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 寄东皋冒巢民先生并一二旧游十首 其七","author":"陈维崧","text":"如皋忆，忆看小桃花。\n水绘园门通小寺，春堤一道不曾斜。\n千树烂晴霞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34256,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 寄东皋冒巢民先生并一二旧游十首 其八","author":"陈维崧","text":"如皋忆，往事倍盈盈。\n水郭题名新怅望，板桥话别旧心情。\n双鬓可怜生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34257,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 寄东皋冒巢民先生并一二旧游十首 其九","author":"陈维崧","text":"如皋忆，数子总疏狂。\n刚中酒时思许掾，恰伤春处念曹王。\n香茗记张郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34258,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 寄东皋冒巢民先生并一二旧游十首 其十","author":"陈维崧","text":"如皋忆，按谱砌香词。\n传语东君须婉转，此情莫遣外人知。\n除说与杨枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34259,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"潇湘神 盱眙舟中作","author":"陈维崧","text":"淮水流，淮水流，蛮弦铜鼓不胜愁。\n骊山金盌无消息，六月园陵冷胜秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34260,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桂殿秋 淮河夜泊","author":"陈维崧","text":"波淼淼，月胧胧，神巫争赛禹王宫。\n船头水笛吹晴碧，樯尾风灯飐夜红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34261,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桂殿秋 偶记","author":"陈维崧","text":"春漠漠，雨疏疏，绮窗偷访薛涛居。\n凝情低咏年时句，人在东风二月初。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34262,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子 江南杂咏六首 其一","author":"陈维崧","text":"天水沦涟。\n穿篱一只撅头船。\n万灶炊烟都不起。\n芒履。\n落日捞虾水田里。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34263,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子 江南杂咏六首 其二","author":"陈维崧","text":"夔魍喧豗。\n枫根渍酒纸成灰。\n泽国不知山国苦。\n铜鼓。\n醉觋夜深作蛮语。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34264,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子 江南杂咏六首 其六","author":"陈维崧","text":"笳盖从风。\n旌竿十丈压桯红。\n卜式相如争匿笑。\n惊告。\n同辈屠沽并佣保。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34265,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子 清明后一日吴阊道中作二首 其一","author":"陈维崧","text":"才过清明，东风怯舞不胜情。\n红袖楼头遥徙倚，垂杨里，阵阵纸鸢扶不起。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34266,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子 清明后一日吴阊道中作二首 其二","author":"陈维崧","text":"捲絮搓绵，雪满山头是纸钱。\n门外桃花墙内女，寻春路，昨日子规啼血处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34267,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"杨柳枝  本意","author":"陈维崧","text":"袅娜丝杨水面生，波光柳态两盈盈。\n搅来风色昏于梦，不许春江绿不成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34268,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"法驾导引 饥乌","author":"陈维崧","text":"饥乌噪，饥乌噪，毛羽忒摧颓。\n故国稔经霜雪满，他乡错料稻粱肥。\n曛黑只飞飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34269,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"法驾导引 曹南耕表弟礼斗甚虔词以纪之四首 其一","author":"陈维崧","text":"铜芝盖，铜芝盖，缥缈结祥烟。\n碧柰□开忉利市，紫阳宫近夜摩天。\n一枕小游仙。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34270,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"法驾导引 曹南耕表弟礼斗甚虔词以纪之四首 其二","author":"陈维崧","text":"西风动，西风动，阆苑一愁无。\n毛女弄琴红捍拨，井公戏博紫樗蒱。\n閒话鲍家姑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34271,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"法驾导引 曹南耕表弟礼斗甚虔词以纪之四首 其三","author":"陈维崧","text":"元始殿，元始殿，瑶陛一层层。\n丹灶几声仙院笛，碧池千盏醮坛灯。\n人静露华凝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34272,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"法驾导引 曹南耕表弟礼斗甚虔词以纪之四首 其四","author":"陈维崧","text":"梅庐闭，梅庐闭，长日不曾闲。\n绛帔黄絁晨控鹤，绿章赤篆夜扶鸾。\n来往总仙官。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34273,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"甘州子  新霁同南耕散步潘原白园亭主人不在题壁而去二首 其一","author":"陈维崧","text":"沁园春在画桥西，花月价，贱如泥。\n碧城高与粉墙齐，拟把数行题。\n题未了，斜日乱莺啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34274,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"甘州子  新霁同南耕散步潘原白园亭主人不在题壁而去二首 其二","author":"陈维崧","text":"铜环半面涩虾蟆，鹦鹉睡，懒呼茶。\n胭脂新湿小窗纱，柳线渐胜鸦。\n无人到，开遍一园花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34275,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"思帝乡  夏夜","author":"陈维崧","text":"花底萤，高低穿绣扃。\n惯照人间閒事，一星星。\n待展轻纨小扑，怯还停。\n又向墙边竹，去冥冥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34276,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长相思 月夜看花作","author":"陈维崧","text":"掩柴门，步篱门。\n夜色茫茫碧一痕。\n微酣过别村。\n梨花繁，李花繁。\n错道溪昏月又昏。\n风吹银浪浑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34277,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉太平 戏咏钱效宋人独木桥体四首 其一","author":"陈维崧","text":"红闺簸钱，绿窗意钱。\n姬人小字钱钱，佩男钱女钱。\n花骢铁钱，兰橑绮钱。\n癖同和峤惟钱，问直他几钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34278,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉太平 戏咏钱效宋人独木桥体四首 其二","author":"陈维崧","text":"青苔印钱，朱荷贴钱。\n空囊谁笑无钱，更漫空荚钱。\n文臣爱钱，娼家数钱。\n世间万事由钱，向天公贳钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34279,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉太平 戏咏钱效宋人独木桥体四首 其三","author":"陈维崧","text":"吹箫乞钱，贩脂鬻钱。\n西风江岸摊钱，负茶商进钱。\n西邻醵钱，东邻打钱。\n明朝去索碑钱，付黄公酒钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34280,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉太平 戏咏钱效宋人独木桥体四首 其四","author":"陈维崧","text":"篯兮古钱，镠兮后钱。\n箧中剩五铢钱，是秦钱汉钱。\n可儿使钱，阿奴惜钱。\n逢花休愬无钱，看风吹纸钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34281,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉太平 题孙无言半瓢居","author":"陈维崧","text":"颜渊一瓢，先生半瓢。\n傍人笑问团瓢，是吟瓢酒瓢。\n巢由饮瓢，先生住瓢。\n行窝何处非瓢，任肩挑坏瓢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34282,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"昭君怨 咏柳","author":"陈维崧","text":"谁把软黄金缕，袅在最临风处。\n低蘸绿波中，太濛濛。\n愁杀花花絮絮，半是风风雨雨。\n一树倍堪怜，寺门前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34283,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春光好 桐川道中作","author":"陈维崧","text":"鴶鵴叫，戍楼平，漆灯明。\n一路春田四月、少人耕。\n恶木丛中古驿，乱山缺处孤城。\n安得短衣看射虎、过残生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34284,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"柳枝 人日过畹仙校书家三首 其一","author":"陈维崧","text":"几阵帘风漾雪肤，正春初。\n小姑年小理清歈，怯氍毹。\n浅道胜常钗胜转，红幡软。\n笼中鹦鹉为谁呼，似留予。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34285,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"柳枝 人日过畹仙校书家三首 其二","author":"陈维崧","text":"兰焰平明一缕微，弄馀辉。\n含娇和梦换春衣，傍床帏。\n手拈红绶通眉语，凭郎主。\n郎看筝雁会翻飞，便须归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34286,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"柳枝 人日过畹仙校书家三首 其三","author":"陈维崧","text":"雪净春瓷隐绿光，发茶香。\n手擎江橘颤钗梁，玉纤凉。\n放夜传闻今岁早，银灯好。\n再来须尽十分狂，省萦肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34287,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇  江楼醉后与程千一","author":"陈维崧","text":"绝忆生平，蹉跎祇为清狂耳。\n酒酣直视，奴价何如婢。\n断壁崩崖，多少齐梁史。\n掀髯喜，笛声夜起，灯火瓜洲市。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34288,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇  题延令张燕孙秋词  燕孙园次婿","author":"陈维崧","text":"吴苑初晴，阳山大好朝来髻。\n相逢却是，山抹微云婿。\n一幅词儿，满纸悲哉气。\n冬深矣，重添秋意，秋在君词里。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34289,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇  舟行秋望","author":"陈维崧","text":"历乱烟村，推篷爱煞晴秋爽。\n柴门栗橡，风定谁敲响。\n野鸭濛濛，懒漫勤依桨。\n鱼蛮莽，惊飞两两，触损玻璃样。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34290,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇  和成容若韵","author":"陈维崧","text":"并坐燕姬，琵琶膝上圆冰薄。\n轻拢浅抹，巧把羁愁豁。\n竟去摇鞭，点草霜鬉渴。\n西风恶，数声城角，冷雁濛濛落。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34291,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"中兴乐 秋夜","author":"陈维崧","text":"水边小弄靠烟廊，秋宵正掩书窗。\n忽有人声，飘来画墙。\n不辨衣香水香，太微茫。\n分明有个，玉簪花底，暗舀新凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34292,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"纱窗恨  蝴蝶和毛文锡韵","author":"陈维崧","text":"闹红咂翠何时了，漾春心。\n一生轻薄谁拘管，粉墙阴。\n花架底潜防纨扇，画梁前巧斗红襟。\n袖上鸳裙摺，费泥金。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34293,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 癸丑东溪雨中修禊","author":"陈维崧","text":"春水挼蓝接远汀，晚山愁黛矗银屏。\n绿杨城外画船停。\n燕剪轻阴拖水榭，莺翻嫩雨湿兰亭。\n半溪灯火酒微醒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34294,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 春日同史云臣远公买舟山游小泊祝陵纪事","author":"陈维崧","text":"春水平如簟一般，茶铛棋局委潺湲。\n好风吹去不须还。\n二月新晴锄绿笋，半村微雨卖青山。\n垂杨低处隐禅关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34295,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 偶憩清和庵即事","author":"陈维崧","text":"垒石缘流一径斜，寺门幽似野人家。\n西风黄叶响篱笆。\n紫入鹦哥名是菊，红归鸦舅色如花。\n僧雏竹下自煎茶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34296,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 咏橘四首 其一","author":"陈维崧","text":"秋染包山树树苍，高低斜缀绛纱囊。\n西风飘过满湖香。\n未免为奴供饮啖，微闻有叟话沧桑。\n霜红露白尽徜徉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34297,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 咏橘四首 其二","author":"陈维崧","text":"髣髴轻躯十八娘，生憎柑子道家妆。\n石榴裂齿也寻常。\n擘罢春纤丹液冷，传来罗帕玉肌凉。\n昨宵酒恶倍思量。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34298,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 咏橘四首 其三","author":"陈维崧","text":"船入荆溪思豁然，曾传此语自坡仙。\n拟将种树遣萧闲。\n今日亭台无楚颂，旧时橘柚满吴天。\n风流人去一千年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34299,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 咏橘四首 其四","author":"陈维崧","text":"藻耀霜林八月中，累累赪卵石湖东。\n篾包箬裹满筠笼。\n天上渴乌偷样好，铸成一点橘般红。\n蓬莱夜半已曈昽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34300,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 山塘即事","author":"陈维崧","text":"窈窕山塘半酒家，浣衣归去笑吴娃。\n东风吹得绣裙斜。\n琴几砑光麋绿竹，楸枰敲落水仙花。\n碧纱窗影浸山茶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34301,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 蚌埠即事","author":"陈维崧","text":"漭漭淮河杳似年，森森蚌岭远攒天。\n风来吹作鲎帆圆。\n柰熟叟擎千颗雨，柳浓儿浴一溪烟。\n黄瓜凉粉趁墟船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34302,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 雨中由枫桥至齐门","author":"陈维崧","text":"料峭春寒恰未消，鹁鸪啼急水迢迢。\n半船微雨过枫桥。\n荠菜绿平齐女墓，梨花雪压伍胥潮。\n柳枝和恨一条条。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34303,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 月夜虎邱纪所见","author":"陈维崧","text":"小立山塘玩暝烟，市楼灯火未阑珊。\n暗中依约遇婵娟。\n风里绣裙吹浪皱，雨馀红屐印泥圆。\n一钩春月寺门前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34304,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 陆上慎移居东郊二首 其一","author":"陈维崧","text":"背郭沿溪路不遥，杏花村里菜花桥。\n故人和燕定新巢。\n药裹暖分花影晒，渔蓑闲受柳绵飘。\n小楼长听雨潇潇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34305,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 陆上慎移居东郊二首 其二","author":"陈维崧","text":"水驿家家看打鱼，晴檐日日唤提壶。\n知君高卧一愁无。\n乍可小词填幼妇，不妨新论著潜夫。\n明年花下引鹓雏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34306,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 逮下为阎牛叟赋","author":"陈维崧","text":"频笑王家九锡文，犊车麈尾事纷纭。\n蔡充儿语最传闻。\n每遣白公留阿素，却教坡老买朝云。\n红闺若个不输君。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34307,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"酒泉子 咏画上香橼为祖仁渊赋","author":"陈维崧","text":"拌蜡匀檀，搓得软罗圆皱。\n西风抛打赭黄毬，堕高楼。\n翠瓷红架贮清幽，分外宜秋。\n凭皓腕，劈春绒，和麝粉，络床头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34308,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"天门谣  汲县道中作","author":"陈维崧","text":"已过秋千节，看汲冢、苔钱铺缬。\n淇流咽，说古今兴灭。\n比干庙、年年啼百舌，月与铜盘都缺。\n愁恨织。\n花落处，棠梨成血。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34309,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"添字昭君怨  竹逸约过城南僧舍看梅以雨不果词以柬之","author":"陈维崧","text":"梅压板桥玉皱，人隔寺墙香透。\n昨朝花下约同游，散春愁。\n准趁平芜携手，还傍粉帘赊酒。\n今朝细雨太绵绵，且高眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34310,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"添字昭君怨 夜泊銮江","author":"陈维崧","text":"今夜月明江上，绿染吴天新样。\n万家帘幕火微明，佛狸城。\n一点瓜洲玉糅，半笏金山雪透。\n乱帆飒飒响秋江，泻银泷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34311,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮  和龚伯通寄于生用原韵","author":"陈维崧","text":"撩人最是眉烟皱，勾人不在春弓瘦。\n红烛奈他何，相看泪孰多。\n别来浑不寐，梦里人谁至。\n拚倚钿筝眠，娇音落枕边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34312,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 代于生答伯通仍用前韵","author":"陈维崧","text":"舞馀叠得衫儿皱，酒阑趱得人儿瘦。\n郎口似隋何，相思谎最多。\n昨宵刚小寐，书与砧同至。\n砧响伴人眠，寄书人那边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34313,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮  春日忆西湖次陆荩思徐竹逸倡和原韵","author":"陈维崧","text":"划波曾到西泠去，掠入绿痕难睡处。\n疏簟杂眠鸥，真成自在游。\n如今佳兴歇，闷过春三月。\n刚见摘兰芽，山村又焙茶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34314,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 柬云臣讯牡丹消息","author":"陈维崧","text":"银铃油幕安排巧，刚刚只等花期早。\n闻说药栏东，娇香将晕红。\n连朝天欲雨，苦勒春寒住。\n何日一枝开，侬应侧帽来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34315,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮  云臣招看牡丹以雨未赴小词奉柬并柬是日赏花诸子","author":"陈维崧","text":"堂前劝酒清尊急，阑前著雨红妆湿。\n多分酒醒时，娇香和泪辞。\n留花花不可，索性将花躲。\n拚做薄情人，恹恹睡一春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34316,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 遥题广陵吴元式棣友堂","author":"陈维崧","text":"驱车昨过田真里，千年想像荆花紫。\n今日广陵城，惟君继令名。\n休歌一斗粟，羡汝东西屋。\n准拟到华堂，来眠大被旁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34317,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮  过云臣宅看牡丹归有作","author":"陈维崧","text":"满城争放花千朵，狂夫那肯家中坐。\n才得过西邻，东家唤又频。\n径须冲酒去，那怯廉纤雨。\n日日为花颠，何曾让少年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34318,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 吴门将归为姜学在题岁寒图","author":"陈维崧","text":"濒行不折阊门柳，殷勤只劝皋桥酒。\n笑指岁寒图，交情如不如。\n领君珍重意，树乃犹如此。\n题罢上归船，孤帆入暝烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34319,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮  为竹逸题徐渭文画紫牡丹","author":"陈维崧","text":"年时斗酒红栏下，一丛姹紫真如画。\n今日画花王，依稀洛下妆。\n徐熙真逸品，浅晕葡萄锦。\n挂在赏花天，狂蜂两处喧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34320,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 将发吴门时庭际海棠盛开用香严词韵","author":"陈维崧","text":"年年惯作他乡客，今年怕与花离别。\n花也替侬愁，春江无尽头。\n不如双粉蝶，镇日团花侧。\n花发唱骊歌，人归花若何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":34321,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]