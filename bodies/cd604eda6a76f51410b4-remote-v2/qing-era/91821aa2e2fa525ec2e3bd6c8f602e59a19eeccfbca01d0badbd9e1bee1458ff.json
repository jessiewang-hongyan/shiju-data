[{"title":"澳门杂诗 其二","author":"丘逢甲","text":"遮天妙手蹙舆图，误尽苍生一字租。\n前代名臣先铸错，莫将割地怨庸奴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32397,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"澳门杂诗 其三","author":"丘逢甲","text":"不是花门也自留，中朝全盛有人忧。\n当时但笑书生见，非策方今信鹿洲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32398,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"澳门杂诗 其四","author":"丘逢甲","text":"大西洋国竞惊奇，前代文人易受欺。\n一笑于今不相称，可怜穷已似波斯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32399,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"澳门杂诗 其五","author":"丘逢甲","text":"冶叶倡条编茁芽，双瞳剪水髻堆鸦。\n春风吹化华夷界，真见葡萄属汉家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32400,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"澳门杂诗 其六","author":"丘逢甲","text":"两园新旧傍山开，花下轻车走若雷。\n逢著人天安息日，亚当亲挟夏娃来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32401,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"澳门杂诗 其七","author":"丘逢甲","text":"天主堂高十字支，筑从新教未行时。\n嵌空万石玲珑甚，独少流传景教碑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32402,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"澳门杂诗 其八","author":"丘逢甲","text":"谁从异代纪倭氛，曾比欧西早驻军。\n犹有蜻蛉洲上客，残坊剔藓读和文。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32403,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"澳门杂诗 其九","author":"丘逢甲","text":"白鸽巢高万木苍，沙梨兜拥水云凉。\n炎天倾尽麻姑酒，选石来谈海种桑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32404,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"澳门杂诗 其十","author":"丘逢甲","text":"四山高拱炮台尊，海气空濛晚角喧。\n落落老兵扶醉去，斜阳一抹望霞村。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32405,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"澳门杂诗 其十一","author":"丘逢甲","text":"覆路榕阴接海堤，望洋东转望洋西。\n马蛟石上看潮立，十万军声战水犀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32406,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"澳门杂诗 其十二","author":"丘逢甲","text":"谁报凶酋发冢冤，宝刀饮血月黄昏。\n要携十斛葡萄酒，来酹秋原壮士魂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32407,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"澳门杂诗 其十三","author":"丘逢甲","text":"楼台金碧拥南环，灯火千门夜不关。\n满地烟花春似海，三更人立磨盘山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32408,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"澳门杂诗 其十四","author":"丘逢甲","text":"银牌高署市门东，百万居然一掷中。\n谁向风尘劳物色？\n博徒从古有英雄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32409,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"澳门杂诗 其十五","author":"丘逢甲","text":"仙洞云封万竹深，隔江胜地负登临。\n倚楼幻作蓬瀛想，一角青洲出海心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32410,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"叠韵答潘兰史送别 其一","author":"丘逢甲","text":"潮气濛濛岛屿青，客心南去极沧溟。\n人逢裸国章缝贱，山入蛮荒草木腥。\n兵火未消天狗劫，风雷犹奉野狐灵。\n无穷万里乘槎意，不为来看海上星。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32411,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"叠韵答潘兰史送别 其二","author":"丘逢甲","text":"刀光寒闪鸊鹈膏，侠胆消沉客路劳。\n禁卫全军归吕禄，中原重镇付朱滔。\n金牛假道愁归蜀，石马传文诧共槽。\n海外且寻徐福去，蓬莱极目五云高。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32412,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"叠韵答陆敬南","author":"丘逢甲","text":"亚雨欧风郁不开，闻鸡人正渡江来。\n箧留表饵平戎策，梦绕旌旗拜将台。\n地尽中原逢大海，天当乱世出奇才。\n填胸垒块浇难化，百尺楼高借酒杯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32413,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答敬南见赠，次原韵 其一","author":"丘逢甲","text":"一石天下才，敢云独八斗。\n郁郁信陵君，平生付醇酒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32414,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答敬南见赠，次原韵 其二","author":"丘逢甲","text":"名士刘景升，世家袁公路。\n把酒论英雄，彼哉何足数！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32415,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答敬南见赠，次原韵 其三","author":"丘逢甲","text":"世无仓海君，谁发诛秦意？\n一击天下惊，奋起龙虎气。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32416,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答敬南见赠，次原韵 其四","author":"丘逢甲","text":"尉佗昔帝粤，独为陆生折。\n宝剑千金装，南来景前哲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32417,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题兰史望罗浮图，次原韵","author":"丘逢甲","text":"奇峰四百三十二，别后相思不计年。\n寻梦客迷蝴蝶洞，看山秋上老龙船。\n前身葛令仙为耦，左股蓬莱海化田。\n风雨迷离图未得，诗魂寒渡瀑云边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32418,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题兰史西樵揽胜图","author":"丘逢甲","text":"山气化云云化水，玉龙飞挂空山里。\n七十二峰云水中，仙人夜半呼龙起。\n空山有客晨搜奇，濛濛龙气寒须眉。\n消遥台上吸云水，散作人间无数诗。\n我来寻山看龙挂，犹幸读诗如读画。\n朅来复见揽胜图，置身忽入清凉界。\n此山自合巢古仙，谁教凿险通人烟？\n世人奔走仙人笑，山中讲学声琅然。\n奇峰尽矗青莲朵，何意人间飞劫火。\n神仙楼变豪客居，古洞碑流党人祸。\n山中流水长潺潺，山云一出何时还。\n我披画图望云水，七十二峰相对閒。\n安得将山还大古，谢绝时人作山主。\n餐云饮水吟仙诗，呼龙耕烟垦瑶圃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32419,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"欧冶子歌","author":"丘逢甲","text":"噫嘻乎嗟哉！\n魔风夜扇大海水，妖鸟西飞金两翅，飞啄群龙龙半死。\n神龙不死何时起，金仙铅泪流不止。\n此劫茫茫古无似，不数汉家燕啄矢。\n谁为铸剑歼厥妖？\n当代吾思欧冶子。\n于时日蚀团黄月华紫，乃采天精抉地髓。\n天帝下观万灵侍，雷公、电母、风伯、雨师听驱使。\n祥金跃出洪炉里，铸成双剑神无比。\n昆崙为砺沃礁砥，陆斩虎狮水剧兕。\n妖鸟哀号张大嘴，群魔乞命等羊豕。\n一挥再挥试神技，乃使五洋沉军舰、六洲平战垒。\n于是天地乃清宁，璧合二仪珠五纬。\n告太平者有太史，一统之朝古无此。\n神剑依然发刃始，老我不才称剑士，布衣长揖归田里。\n噫嘻乎嗟哉！\n当代吾思欧冶子。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32420,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题骆宾王集 其一","author":"丘逢甲","text":"义师散后遁僧寮，老抱雄心托浙潮。\n此笔江河流万古，多因曾檄伪临朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32421,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题骆宾王集 其二","author":"丘逢甲","text":"凤阁鸾台宰相忙，此才竟令落蛮荒。\n若将文字论知己，惟有当时武媚娘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32422,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九龙有感","author":"丘逢甲","text":"群峰叠翠倚楼间，一角颓云夕照殷。\n忽忆去年春色里，九龙还是汉家山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32423,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"纪事 其一","author":"丘逢甲","text":"阊阖沉沉路不通，封章空自效愚忠。\n人间漫诧朝阳凤，已落罗钳吉网中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32424,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"纪事 其二","author":"丘逢甲","text":"何止诛求在市租，上供祗道急军需。\n相公南下纡筹策，报国居然仗博徒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32425,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"七洲洋看月放歌","author":"丘逢甲","text":"一舟之外天连水，万里空明月轮起。\n七洲洋里看月行，数遍春宵古无此。\n舟行双轮月只轮，青天碧海无纤尘。\n茫茫海水镕作银，著我飞楼缥缈独立之吟身。\n少陵太白看月不到处，今宵都付渡海寻诗人。\n月轮天有居人在，中间亦有光明海。\n不知今宵可有南去乘舟人，遥望地球发光彩。\n地球绕日日一周，日光出地月所收。\n此时月光照不到，尚有大地西半球。\n此时月光随我来南游，大千界中有此舟。\n更著此月来当头，舟中吴讴答越讴。\n月光夜照花枝幽，中有蛮姬十队并作天魔舞。\n东音西音四起声咿嚘，嫦娥应自怨幽独，不及人间儿女同无愁。\n安知人海群龙方血战，蜗国蚊巢纷告变。\n月光遍照六大洲，万怪千奇机械见。\n剩此同舟胡越犹一家，各抱月华共欢宴。\n自从中朝海禁开，年年月月泛月有人来。\n忽然今月属吾有，此时此地此景真奇哉！\n吸月屡罄葡萄杯。\n独惜南溟岛国尽隶他人属，坐叹热带之下无雄才。\n人间万事纷变灭，方见月圆旋月缺。\n四万八千修月仙，玉斧长劳竟何说。\n固知盈亏之理原循环，大地山河终古不改色。\n即今圆相虽未全，一出已令天下悦。\n天上之月海底明，上下两月齐晶瑩。\n两月中间一舟走，飞轮碾海脆作玻璃声。\n月兮西落而东生，北舟莽莽方南行。\n天经自纵地纬横，此时吐吞八极诗方成，天鸡喔喔呼潮鸣。\n自是诗中海权大，万里南天开海界。\n月华夜夜供豪吟，月神不怪海神怪。\n明朝待看海上无数之奇峰，明宵舟泊宾童龙。\n澜沧江头看月去，江花江柳春溶溶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32426,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"昆崙","author":"丘逢甲","text":"茫茫天水气相吞，大海中浮独岛尊。\n不见神龙见神鸟，七洲洋外望昆崙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32427,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"二月十五日抵西贡作","author":"丘逢甲","text":"楼台金碧国旗飘，吹角江头虏气骄。\n地极南交逢热带，人来西贡作花朝。\n椰林草屋蛮跳月，绿舫红灯客守潮。\n走遍香车堤岸路，不曾辜负好春宵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32428,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西贡杂诗 其一","author":"丘逢甲","text":"七洲洋外海程遥，竟夕扬轮趁晓潮。\n九十九湾春水曲，澜沧江上作花朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32429,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西贡杂诗 其二","author":"丘逢甲","text":"岂独开疆自汉秦，南车久已载皇仁。\n谁知富贵誇真腊，竟属黄须碧眼人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32430,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西贡杂诗 其三","author":"丘逢甲","text":"力遣孱王摄虎威，残疆何止割南圻。\n云山北向空挥泪，孤负遗民望黑旗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32431,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西贡杂诗 其四","author":"丘逢甲","text":"未肯洋装换越装，金环椎髻素衣裳。\n传经但读祛卢字，遗教无人说士王。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32432,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西贡杂诗 其五","author":"丘逢甲","text":"水程几日达高棉，山势南趋尽越边。\n一夜黄花江水长，满堤金塔卖鱼船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32433,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西贡杂诗 其六","author":"丘逢甲","text":"绿树双堤护走车，隔帘鹦鹉听呼茶。\n独怜呜咽琵琶语，半是珠江落后花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32434,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西贡杂诗 其七","author":"丘逢甲","text":"槟榔红嚼蛎灰腥，粲露瓠犀醉半醒。\n交趾不逢逢黑齿，大荒重记百虫经。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32435,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西贡杂诗 其八","author":"丘逢甲","text":"吾乡大令昔生还，风土蛮荒记最娴。\n江上愁吟香祖句，不堪回首念家山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32436,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西贡杂诗 其九","author":"丘逢甲","text":"多少蛮姬理夜香，当门红烛荡花光。\n可怜膜拜西天佛，管领真归大法王。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32437,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西贡杂诗 其十","author":"丘逢甲","text":"金碧楼台眼界新，竞将工巧诧西人。\n竹篱茅舍清江上，几树幽花本色春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32438,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟中望茶盘山","author":"丘逢甲","text":"沧波无际夕阳红，孤屿苍茫大海中。\n水墨痕浓云脚矮，茶盘山外雨濛濛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32439,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"饮新嘉坡觞咏楼，次菽园韵 其一","author":"丘逢甲","text":"春风海上客徵歌，消受群花眼福多。\n我比石斋尤豁达，不妨坐抱顾横波。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32440,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"饮新嘉坡觞咏楼，次菽园韵 其二","author":"丘逢甲","text":"风云万里郁神州，人醉天南第一楼。\n唱遍南朝新乐府，最难天子是无愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32441,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天南第一楼放歌","author":"丘逢甲","text":"亚洲一片云头恶，群花摧折雌风虐。\n护花幡立海东南，裼裘公子方行乐。\n千红万紫开春中，团圆月照何王宫。\n粗豪莫笑虬髯客，妩媚全胜羊鼻公。\n第一楼头人第一，天女散花香满室。\n中宵醉卧海云红，梦遣黄人捧朝日。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32442,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"星洲喜晤容纯甫副使，即送西行 其一","author":"丘逢甲","text":"吾国有爹亚，将为欧美游。\n艰危天下局，慷慨老成谋。\n新运开三世，雄心遍五洲。\n南华楼上话，一夕定千秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32443,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"星洲喜晤容纯甫副使，即送西行 其二","author":"丘逢甲","text":"七十尚如此，吾徒愧壮年！\n排云叩阊阖，救日出虞渊。\n异域扶公义，神州复主权。\n柬之原未老，终仗力回天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32444,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"星洲喜晤容纯甫副使，即送西行 其三","author":"丘逢甲","text":"廿载知名久，相逢瘴海春。\n亚洲数先达，岭表有奇人。\n南出终张楚，西行更哭秦。\n风云看勃郁，万里送飞轮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32445,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答叶季允见赠 其一","author":"丘逢甲","text":"平生风义柳堂门，雄直依然粤派存。\n谁料南荒柔佛国，听松庐更有诗孙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32446,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答叶季允见赠 其二","author":"丘逢甲","text":"万里飞腾志未乖，海山苍莽遣吟怀。\n他年岛国传流寓，诗屋人寻豆腐街。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32447,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答叶季允见赠 其三","author":"丘逢甲","text":"廿载风尘粤客装，?公山远郁苍苍。\n自来海外称诗老，更望佗城作故乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32448,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答叶季允见赠 其四","author":"丘逢甲","text":"劳赠才人绝妙词，天涯有客遍搜奇。\n独怜荒峤来相语，绝少韩陵一片碑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32449,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟过马六甲 其一","author":"丘逢甲","text":"南风吹雨片帆斜，万叠山青满剌加。\n欲问前朝封贡事，更无人说故王家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32450,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟过马六甲 其二","author":"丘逢甲","text":"碧眼胡儿拜武皇，贡书犹托岛中王。\n直陈藩国流离状，曾有吾家侍禦章。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32451,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟过马六甲 其三","author":"丘逢甲","text":"荒山中尚有遗民，一死居然与古邻。\n赢得盖棺遮短发，四方平定铁崖巾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32452,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"由星嘉坡抵槟榔屿舟中口号","author":"丘逢甲","text":"柔佛国中逢上巳，槟榔屿里作清明。\n匆匆雾鬓风鬟影，饱看春山两日程。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32453,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游阿易意淡观音阁，次壁间韵","author":"丘逢甲","text":"不使南荒劫火燃，流沙黑水且安禅。\n六时梵呗潮音静，千眼灵光宝相圆。\n出洞猿携山果献，归巢鹤抱海云眠。\n诸天也藉黄金力，变现西方九品莲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32454,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"槟榔屿杂诗 其一","author":"丘逢甲","text":"谷绣林香万树花，青崖飞瀑落谽谺。\n谁知地下潜流出，散作春泉十万家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32455,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"槟榔屿杂诗 其二","author":"丘逢甲","text":"海外居然谱学通，衣冠休笑少唐风。\n黄金遍铸门楣字，不数崔卢郡望崇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32456,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"槟榔屿杂诗 其三","author":"丘逢甲","text":"一轮月照万花娇，歌管声中长夜潮。\n宝马香车春似海，打球场外看元宵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32457,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"槟榔屿杂诗 其四","author":"丘逢甲","text":"走马交衢碾白沙，椰阴十里绿云遮。\n晓风吹出山蜂语，开遍春园豆蔻花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32458,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"槟榔屿杂诗 其五","author":"丘逢甲","text":"雾阁云窗启道场，不须极乐数西方。\n山僧指引频誇客，顶礼曾来白象王。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32459,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"道君岩","author":"丘逢甲","text":"论治人方咎祸胎，化胡更向海天来。\n青牛西域流沙远，朱鸟南荒古洞开。\n聚窟乳泉飞法雨，空岩蛮语答春雷。\n独怜混沌年年凿，谈道难教劫运回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32460,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南道院 其一","author":"丘逢甲","text":"宝气搜残剩石头，石玲珑化洞天幽。\n三分得水知鱼乐，九曲看人作蚁游。\n荒外有山容道侣，海中无地不瀛洲。\n他年补入神仙传，曾费骖鸾半日留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32461,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南道院 其二","author":"丘逢甲","text":"林外方塘塘外山，洞门高下锁烟鬟。\n藤阴满院闻蝉语，云气当轩待鹤还。\n绝妙文心惟曲折，最难仙福是清閒。\n海天归去犹留梦，他日相思浩渺间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32462,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自题南洋行教图 其一","author":"丘逢甲","text":"莽莽群山海气青，华风远被到南溟。\n万人围坐齐倾耳，椰子林中说圣经。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32463,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自题南洋行教图 其二","author":"丘逢甲","text":"二千五百馀年后，浮海居然道可行。\n独倚斗南楼上望，春风回处紫澜生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32464,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]