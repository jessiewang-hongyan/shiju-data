[{"title":"闲居","author":"邵潜","text":"城市亦堪隐，春风独掩扉。\n狂怜生计拙，贫使故交稀。\n日月摧蓬鬓，烟霞老薜衣。\n不须论塞马，得失总忘机。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7057,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"同人集准提寺晚过渔家","author":"刘以化","text":"城中春较迟，湖上草先绿。\n素友相招邀，净地联芳躅。\n岁月苦奔驰，昏嫁怜拘束。\n觞咏惬幽情，风物寓遐瞩。\n纵论杂古今，遗形失荣辱。\n月出挂城头，照我松间屋。\n疏雨滴花琴，微风动林烛。\n烟际下渔舟，家在青溪曲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7058,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"新霁","author":"单嘉猷","text":"积雨林薄昏，湿云漫岩屋。\n出门望阴晴，快睹开初旭。\n高峰耸螺鬟，润泽比膏沐。\n池塘潋滟波，半没新生竹。\n草深蛙黾喜，繁响出丛绿。\n落花淡无言，点点洒春服。\n老农急磨镰，陇上来麰熟。\n往矣适予情，正可骑黄犊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7059,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"压气培歌","author":"吴孟坚","text":"压气培前奔万石，阴云莽莽黑雾塞。\n水号风怒激沙飞，仿佛旌旗雷电掣。\n我父军声堕此间，星日无光天欲折。\n我母颈罹刃痕七，身投层崖脑迸裂。\n我妹三龄弃路死，百口家人一无得。\n前山溪下血犹腥，将士同时皆义烈。\n烟飙玉碎三十秋，天地迄今为惨恻。\n肠断纡回忍追忆，千载空坑堪并说。\n呜呼千载空坑堪并说！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7060,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雁字和彭禹峰先生韵 其一","author":"吴孟坚","text":"飞来阵阵满天逋，一幅江山似墨涂。\n戢翼隐藏河洺数，冲天画破卦爻图。\n惯逢风雨惊三峡，素逞烟云驾五湖。\n不是龙蛇行纸上，乾坤何事为泥污。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7061,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雁字和彭禹峰先生韵 其二","author":"吴孟坚","text":"天空嘹唳鹤鸣皋，回雁峰前峰更高。\n既同江子花生梦，又忆毛生颖脱毫。\n片羽影随编画幅，断肠声到振江涛。\n从来怕舞《霓裳曲》，冷落河山洒凤毛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7062,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雁字和彭禹峰先生韵 其三","author":"吴孟坚","text":"翩翩锦字向谁搓，斜抱云和月已过。\n身伴天娥垂玉袖，音惊越地起吴歌。\n珊瑚枕上传幽梦，翡翠楼中点绛罗。\n不逐黄鹂啼绿柳，故来人世断肠多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7063,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雁字和彭禹峰先生韵 其四","author":"吴孟坚","text":"去年零落被弓侵，泪湿红笺无处寻。\n欲绽似含无数怨，暂停疑有一声音。\n断霞转影曾天际，浓雾分烟满艺林。\n自是淡描人不识，玲珑格调隐沈沈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7064,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄里门诸兄弟","author":"马日思","text":"人言兄弟好，在家常不知。\n出门东西去，形影独相随。\n梦中犹晤语，醒后忽天涯。\n脊令虽小鸟，比翼向高枝。\n男儿四方志，安得无别离。\n忆昔聚里巷，六人共一师。\n对酒青镫夜，听歌《白苎词》。\n少小不及乐，老大徒相思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7065,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜坐示内","author":"马日思","text":"痛读《离骚》不放怀，鹿门携手隐堪偕。\n刘伶卧病犹贪醉，周泽逃禅独好斋。\n身冷履霜嗟葛屦，家贫沽酒借荆钗。\n人生随遇须安处，方信卿言亦复佳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7066,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怀齐稷下","author":"马日思","text":"葭菼苍苍水一涯，近知消息在京华。\n我听夜雨吟衰柳，君似春风妒落花。\n燕市酒徒歌当哭，并州游子客为家。\n何时得返东吴棹，相对清尊到日斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7067,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日江洲有感 其一","author":"孙中凤","text":"独眺层台上，天空起雁群。\n孤城淡黄叶，落日傍秋云。\n砧杵千家合，风烟万里分。\n还山悲短发，笳笛夜深闻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7068,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日江洲有感 其二","author":"孙中凤","text":"荧惑连宵灿，光芒射斗明。\n关河郁乡思，鼓角乱秋声。\n客梦三更断，羁愁千里生。\n一尊对江月，无限古今情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7069,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山居怀王明我","author":"姚文勋","text":"与君数载游，同作天涯客。\n山色异乡青，归情江水白。\n今予独处时，念子寒风夕。\n秋尽犹未还，愁见庭枫赤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7070,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日饮王润甫夫子山庄","author":"姚文勋","text":"聚坐松林下，遥听远浦歌。\n夕阳明古树，微露引疏荷。\n鸟噪暮山静，风生秋水波。\n扬亭容问字，呼酒兴偏多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7071,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夕眺","author":"姚文炱","text":"望中野色变衰颜，雨后风光天水闲。\n一片青苔封古石，几行疏树点空山。\n僧归柳径初传磬，秋入绵衣欲掩关。\n暂借草亭因待月，肯教夕照负人还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7072,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送九兄羹湖之蓼","author":"姚文鳌","text":"干戈满目未休兵，负笈劳劳独远行。\n驿路草深官柳细，板桥露白客装轻。\n已怜鸿雁三秋别，莫动鲈鱼千里情。\n君到蓼城应念我，屋梁有梦月华明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7073,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"同蒋仲一汪河发郊行见杏花初放期再赏之","author":"李㦂","text":"圃外见红杏，高林气若霞。\n朝来一片雨，开到几枝花。\n惜此好春色，多于野老家。\n偶然看不足，记取路痕斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7074,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天门山","author":"李㦂","text":"双峰如凿断，绝壁对崔嵬。\n楚蜀千重远，东南一气开。\n潮声归海去，帆影出天来。\n渺渺烟波际，徒深庾信哀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7075,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"新秋","author":"赵崇礼","text":"去郭曾无远，今人不易寻。\n高林初叶坠，秋雨一帘深。\n老态惭香稻，孤怀傍素琴。\n杜鹃声未歇，何可听层阴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7076,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"泸水","author":"张客卿","text":"一水通蛮络，沉沉不计深。\n蛟涎连积雨，蜃气结层阴。\n毒草迷苍渚，繁花映黑浔。\n武侯炎渡后，烟瘴只今澄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7077,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清明","author":"张客卿","text":"落落逢佳节，闲愁病里深。\n片云来客梦，芳草乱乡心。\n不尽风花泪，何堪水竹吟。\n家山遗故陇，松柏意森森。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7078,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"久不得曾庭闻消息怅然有怀","author":"吴錂","text":"路向西南尽，江连汉沔深。\n旌旗秦栈晓，橘柚楚祠阴。\n落日孤村戍，秋风万里砧。\n黑貂应已敝，谁识曳裾心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7079,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟次邗江感怀","author":"戴研","text":"寒云萧瑟片帆收，江草江花动客愁。\n瓜步涛声常带雨，广陵山色易为秋。\n已拚湖海供多病，漫逐风尘故倦游。\n寂寞仲宣怀故里，不胜摇落赋《登楼》。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7080,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游水岩","author":"张云鹗","text":"数笔云林几叶丹，敢言抱卷向名山。\n舟从虎圈秋尘外，梦在罗浮素月间。\n潭静影能将槛远，钟残韵亦比人闲。\n通仙幸有云情在，指点苍颜数往还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7081,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"兵远","author":"张云鹗","text":"绝壑谁堪此旦昏，可怜垂老负儿孙。\n兵遥已被烽烟苦，家在宁忘耕凿恩。\n惊鸟宿林啼夜雨，荒村留月觅余魂。\n天狼未殒时多难，收得郊原老泪痕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7082,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"听竹庵","author":"涂斯皇","text":"修篁摇翠影，小筑迥清幽。\n虫语团庭绿，蝉声带水秋。\n寒云依石涧，独树表荒丘。\n坐卧欲忘返，萧然何所求。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7083,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"徐仲光先生至或见之日者肆过访不值","author":"涂斯皇","text":"我思李邺侯，衡峰寄高躅。\n复羡贺季真，归老鉴湖曲。\n仙骨被霞裳，迈年粲紫玉。\n二公处中朝，不为名利束。\n卓荦徐先生，天衢骋骥足。\n茂龄脱尘网，傀儡视世局。\n宁谓宦情淡，良由忠怀笃。\n姑山何神秀，高隐终南续。\n夜起星参横，少微正炯烛。\n我欲从之游，邈然绝攀躅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7084,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"石头城","author":"丁裔沆","text":"君不见龙骧将军意气豪，连帆战舰明珠袍。\n雄师八万挂席进，角声吹断黄云高。\n鸾旗半卷青山里，鱼龙悲咽秋江水。\n自将玉篆付官家，不遣将军折一矢。\n赤乌事业不崇朝，尽逐东风散怒涛。\n横江振旅铙歌发，白发将军看宝刀。\n寄语横行且复休，孙郎战骨随蒿丘。\n当年割据山河壮，谁道降帆下石头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7085,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湘灵怨","author":"丁裔沆","text":"楚山青，楚江永，幽弦出水寒波动。\n青丝短，别恨长，碧潭浸月照微茫。\n声清切，惊落叶，夜半啼猿愁不歇。\n听悠悠，湘水流，苍梧缥缈黛云秋。\n猿声急，丝声咽，吹入《竹枝》转凄绝。\n竹烟浮，泪未收，寥天清怨泣渔舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7086,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"中秋虎丘对月","author":"曹伟谟","text":"虎丘今夜月，极目思悠哉。\n白露中宵降，清光万里开。\n笙歌沈鼓角，镫火出楼台。\n少小经游地，曾陪杖履来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7087,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秦淮竹枝词 其一","author":"曹伟谟","text":"秦淮春水绿迢迢，杨柳千条更万条。\n每过珠帘停打桨，惹他帘内罢吹箫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7088,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秦淮竹枝词 其二","author":"曹伟谟","text":"戏演鱼龙夜不眠，梨园牌号阮家编。\n轻轻断送南朝事，一曲《春镫》《燕子笺》。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7089,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秦淮竹枝词 其三","author":"曹伟谟","text":"藩邸初来乐府奢，中官四出选良家。\n一朝马上琵琶去，井底曾无张丽华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7090,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"得魏子存舅氏蜀中书","author":"曹鉴徵","text":"西蜀东吴万里余，那堪薄宦久离居。\n舅甥忽忆三年别，乡国初逢一纸书。\n明月啼猿巫峡迥，秋风落木锦江虚。\n何缘得贳郫筒酒，将问云安丙穴鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7091,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九日顾迂客雷阮徒招集吴山登高用昌黎人日城南登高韵","author":"毛正学","text":"昨夜横山堂，柔翰频自弄。\n诸君各健举，独如蝇被冻。\n诗本吾家学，才尽迄无用。\n今朝吴山道，篮舆托后从。\n俄停陶岘舟，金尊呼客共。\n目瞩远近峰，一一迎而送。\n渔艇棹歌回，钓车卷断葑。\n落日浴平湖，水势兼天纵。\n急管杂繁弦，终宵亦倥偬。\n传语谢山灵，兹游不辞重。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7092,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"叶已畦招集二弃草堂用昌黎醉赠张秘书韵","author":"毛正学","text":"叶生我密戚，才名宿有闻。\n为儒号漫士，作吏称神君。\n十年卧丘壑，雅意在斯文。\n结庐横山畔，屋角饶烟云。\n芙蓉围清池，篱菊初舒芬。\n我来草堂上，邂逅沮溺群。\n促坐共传杯，丝竹鸣宵分。\n高踪媲猿鹤，正尔成一军。\n四筵歌既醉，起视各半醺。\n斜月在木末，清影微氤氲。\n聚会此时节，诸贤意何云。\n窃叹风雅途，俗学方纠纷。\n但知逐淫哇，不解谢膻荤。\n相将飏华袿，无复曳缟裙。\n笔端出细响，有若蝇与蚊。\n忍令芸薤臭，竟等兰茝薰。\n用是怀百忧，徘徊升大坟。\n诗教苦荒落，久矣待勤耘。\n谁者起任之，艺林当铭勋。\n吾党尚努力，乘兹日未曛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7093,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"同万年少黄心甫晚集湖上","author":"怀应骋","text":"山色入高楼，寒云隔树流。\n雨来松榻黯，风动薜衣浮。\n瓦缶传秋醴，铜壶急夜筹。\n蛩声杂垆响，偏共到床头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7094,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过五人墓有感 其一","author":"钱煐","text":"一死寻常事，千秋浩气垂。\n须眉人有数，闾里节堪师。\n古树苍烟里，原田落照时。\n半塘来往客，相与吊丰碑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7095,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过五人墓有感 其二","author":"钱煐","text":"舣舟堤上立，未得荐溪蘋。\n柳绿丝成障，畦黄锦作茵。\n当涂多逆党，直道在斯民。\n谁话兴亡事，盘觞次第陈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7096,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闻梁蘧玉已寓京口","author":"濮淙","text":"容易相逢尚未逢，老年亲故喜相从。\n已辞野店中山酒，望断烟江北固峰。\n一夜梦游千里月，五更霜落万家钟。\n莫言人远天涯近，书到楼头第几封？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7097,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"乙巳春发吴门留别","author":"翁白","text":"归来暂共此登临，又拥莺花过武林。\n马首春风正月路，板桥夜雨十年心。\n愁删白发还为客，悔别青山欲放吟。\n记得王门投笔后，五湖飘荡到而今。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7098,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"中秋客萧山","author":"翁白","text":"小楼歌管月明时，帘卷中秋病不宜。\n摇落一杯还作客，艰危万里独吟诗。\n心知老去终多累，计欲闲来未有期。\n却羡向平婚嫁毕，青山赢得好生涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7099,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送纪伯紫之金陵","author":"陈騄","text":"逢君倾盖好，言别大江流。\n意气怜杯酒，山川换驿楼。\n裁诗旧国梦，读史白闻秋。\n独有闽南客，频看雨后舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7100,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"别周载俅孝廉之崇安","author":"陈騄","text":"秋到柴门静，倦镫寻梦余。\n山空云度鸟，浦白月归渔。\n抱影应同汝，劳生慨独余。\n畏看河汉浅，良夜复何如。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7101,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寻春","author":"陈騄","text":"野外寻春三月时，偶然昨夜与僧期。\n山多树老行人断，流水柴门午磬迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7102,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九日杂咏","author":"赵与楩","text":"寒食吊之推，端阳悲郢客。\n如何重九日，不祀陶彭泽？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7103,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"资江酬友","author":"蒋大年","text":"敢将风雨怨途泥，山色遥怜望里迷。\n放艇烟花同泛泛，怀人池草但萋萋。\n怪从北地来鸿翮，肯为东风逐马蹄。\n楚泽由来悲滞客，浮云不散万峰西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7104,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹦鹉洲","author":"萧广昭","text":"公子登楼叹未归，晴川极目掩芳菲。\n飘零楚客同烟树，寂寞诗魂绕鹄矶。\n杨孔文章应共寿，曹刘竖子未堪依。\n辽东惟有孤栖凤，不向人间炫绿衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7105,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"襄江道中","author":"潘国祚","text":"画舸摇摇逐晓寒，江云飞尽乱峰攒。\n垂杨故作千行绿，枫树谁知一夜丹。\n万古《风》《骚》存泽国，五湖烟景问渔竿。\n好山过去休回首，留取归时对面看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7106,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"经岳阳战场","author":"潘永祚","text":"系艇巴陵日已斜，洞庭秋色老苍葭。\n城经百战增新垒，路转千村少旧家。\n旷野碧磷吹冻火，中宵白骨语寒沙。\n精魂枉入春闺梦，酹酒谁来水一涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7107,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日游灵山山在县治东三里许其上有诸精舍 其一","author":"刘醇骥","text":"幽意谷泉落，相将任往回。\n谁持星浪石，移近雨花台。\n人坐翠微笑，鸟邀春色来。\n山僧有新约，曾许寺门开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7108,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日游灵山山在县治东三里许其上有诸精舍 其二","author":"刘醇骥","text":"数转烟萝入，微茫山气中。\n阴晴半壑树，钟磬午天风。\n饭供行厨白，香分宝座红。\n无能随远社，猿鹤偶然通。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7109,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登晴川阁","author":"程封","text":"帆影高低过石头，看云合上几层楼。\n空江易作三春雨，古岸微同六代秋。\n大别山于窗牖入，武昌城向画图收。\n登临不用伤怀抱，矶下何人著钓钩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7110,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暮相思","author":"程封","text":"行行燕子矶，风潮夜将发。\n天寒四野迷，独坐舟中月。\n缄情不得寄，残钟听来歇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7111,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"再游三游洞","author":"罗宏备","text":"蕙服芒鞋早办装，重来携酒兴犹狂。\n临风野啸随溪响，出谷春衣带草香。\n洞口土花封古字，山腰人影动斜阳。\n扪岩姓氏谁堪语，一片寒碑白侍郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7112,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秦淮竹枝词 其一","author":"杜绍凯","text":"垂柳庄前夕照寒，早潮落尽暮潮宽。\n春宫小说红毡上，侬爱钟山雨后看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7113,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秦淮竹枝词 其二","author":"杜绍凯","text":"征蛮夫婿贵通侯，珠翠笼镫夜不休。\n为看鳌山如白画，瓦盆争照牡丹头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7114,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秦淮柬鲁峰","author":"彭旋龄","text":"何处寻羁思，河亭春水生。\n柳垂三月雨，莺送六朝声。\n无句怜桃叶，回船过冶城。\n《竹枝》歌未罢，今古一关情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7115,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"入东冲","author":"舒峻极","text":"屐齿平苔藓，钟声出上方。\n高松啼鹳鹤，百草瘦牛羊。\n泉泻千溪雨，枫凋一夜霜。\n五峰峰顶月，清冷照衣裳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7116,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"客路","author":"舒峻极","text":"客路饶风雨，中心几郁陶。\n天连黄海阔，门闭湿云高。\n群盗东南剧，凶年赋税劳。\n故园归去梦，何日涉江涛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7117,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜坐亭边","author":"陈士规","text":"幽栖耽静僻，息影隐疏林。\n寒塘隔野寺，镫远烟际沉。\n露白秋草间，百虫感何深。\n潸然数行下，徒怀壮士心。\n烦忧结不散，流响寄鸣琴。\n天高银汉迥，落月欲横参。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7118,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"述怀","author":"黄进陛","text":"长年故纸老生涯，自此清江买钓槎。\n鸥鹭若非逢圣世，秋汀未许占芦花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7119,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟过清远峡望飞来寺","author":"廖燕","text":"山寺隔烟水，舟人指古碑。\n入云松影密，出峡磬声迟。\n台阁峰能遍，神仙事可疑。\n当年来去迹，岩下老僧知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":7120,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]