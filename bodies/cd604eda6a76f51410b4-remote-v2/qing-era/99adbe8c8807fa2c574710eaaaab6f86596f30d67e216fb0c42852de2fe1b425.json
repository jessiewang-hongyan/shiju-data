[{"title":"感赋八首 其三 山秋","author":"缪焕章","text":"记得秋高太华过，振衣绝顶瞰黄河。\n金沙风疾青盘鹗，玉女烟销翠拥螺。\n久客方知歧路险，閒情毕竟故园多。\n何年学种陵巅黍，长柄重携扫绿萝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19060,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"感赋八首 其四 水秋","author":"缪焕章","text":"遥空漠漠淡浮烟，衰柳长堤瘦可怜。\n蠡勺泉枯愁北陌，鲛宫波静忆南天。\n月明珊树谁悬网，露冷蓉江好繫船。\n我已尘缘参一色，南华毕竟费言诠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19061,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"感赋八首 其五 花秋","author":"缪焕章","text":"已有秋心感酒炉，剧怜花径未全芜。\n游仙玉赠双环在，买笑珠量一斛无。\n锦上愁痕红泪洒，帘前瘦影碧阑扶。\n何堪更忆黄陵庙，苦雨凄风听鹧鸪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19062,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"感赋八首 其六 草秋","author":"缪焕章","text":"韶华无复绿成茵，一径依然著色匀。\n鶗鴂先鸣逢此日，蓬蒿偕隐问何人。\n凉秋紫塞三千里，旧怨青芜九十春。\n欲向西堂吟谢句，永嘉消息隔江滨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19063,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"感赋八首 其七 蝶秋","author":"缪焕章","text":"重看仙蜕试轻盈，露井桐飘片叶声。\n一桁楼台迷旧径，六朝金粉梦前生。\n帘开却妒将归燕，花落空怜老去莺。\n墙角零星香几簇，双飞莫更负秋英。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19064,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"感赋八首 其八 蟀秋","author":"缪焕章","text":"芳草庭前绿未删，声声啼近琐窗间。\n万金游戏誇三捷，一代平章误半閒。\n写入琴丝商调苦，催成锦字泪痕斑。\n笑他儿女偏多事，篱角呼灯屡往还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19065,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"左泉先生赐读伴云仙馆，即事诗八首，赋此奉酬 其一","author":"缪焕章","text":"宝钏金尊斗狭斜，阿侬生小艳情赊。\n芳辰偶放琴川棹，得遇瑶台第一花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19066,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"左泉先生赐读伴云仙馆，即事诗八首，赋此奉酬 其二","author":"缪焕章","text":"绮楼曾占十分春，雾鬓云鬟画里身。\n一事难忘惆怅处，徐娘半老尚风尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19067,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"左泉先生赐读伴云仙馆，即事诗八首，赋此奉酬 其三","author":"缪焕章","text":"蛾眉曾许汝南王，同炷瞿昙座下香。\n底事归云仍出岫，兰因絮果两茫茫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19068,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"左泉先生赐读伴云仙馆，即事诗八首，赋此奉酬 其四","author":"缪焕章","text":"我亦龙华会上人，十年春恨细于尘。\n风流最是张京兆，打叠閒情赋感甄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19069,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"左泉先生赐读伴云仙馆，即事诗八首，赋此奉酬 其五","author":"缪焕章","text":"才子传神笔一枝，吟来恍睹旧丰姿。\n旗亭他日翻新谱，绝妙人歌绝妙诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19070,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"宿新安不寐作","author":"缪焕章","text":"晓风催送一程程，听彻铃声与铎声。\n空有壮怀增感慨，愧无奇策奋功名。\n云山万叠家何处，烽火连年恨未平。\n残焰欲消眠不得，纯钩拂拭到三更。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19071,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"入函谷关和壁间韵","author":"缪焕章","text":"行李萧条风露寒，无端西笑上长安。\n入关翻讶闻鸡早，下阪方知勒马难。\n尘世寄身同历劫，河山放眼且凭栏。\n前途傥遇骑牛叟，尚有名经要借看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19072,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冉石云丈赐和旧作，仍步原韵二首 其一","author":"缪焕章","text":"吟鞭曾历万邮程，怕听天涯杜宇声。\n人过中年怀远志，山探二酉早知名。\n每因月旦期良晤，敢向风胡诉不平。\n从此高轩同抵掌，良宵莫问短长更。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19073,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冉石云丈赐和旧作，仍步原韵二首 其二","author":"缪焕章","text":"书生骨相本清寒，底用金门策治安。\n觅句转嫌秋夜促，欢悰预想别时难。\n桂华杳蔼香侵袂，月影玲珑魄覆阑。\n犹幸龙门今咫尺，举头不向白云看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19074,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"石丈又用原韵成述怀二律再步韵 其一","author":"缪焕章","text":"支榻衙斋谢旅程，堪誇同气又同声。\n门墙许列新桃李，刺字难磨旧姓名。\n屡向秦关探柱史，偶来蜀市访君平。\n朱颜镜里浑难驻，祇觉堂堂岁月更。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19075,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"石丈又用原韵成述怀二律再步韵 其二","author":"缪焕章","text":"策策西风送薄寒，木樨香里忆长安。\n敢云京洛驰名早，翻恐风尘作吏难。\n赵璧得完仍奋翮，谢池觅句偶依阑。\n何当蹑屩从君后，玉柱金庭取次看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19076,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冉右之明经叠韵惠赠，依韵和答四首 其一","author":"缪焕章","text":"杖策重探蜀国程，巴渝惯听竹枝声。\n衙斋幸接高贤踵，讲舍尤钦小阮名。\n佳句如珠劳慰藉，深情似海契生平。\n剧怜老境催人甚，华发无端只自更。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19077,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冉右之明经叠韵惠赠，依韵和答四首 其二","author":"缪焕章","text":"扰扰红巾剑影寒，江干未许卧袁安。\n烽烟数载惊心久，兄弟中年聚首难。\n调协埙篪频按曲，花开锦绣每巡阑。\n丰城宝气知何在？\n惭愧司空刮目看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19078,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冉右之明经叠韵惠赠，依韵和答四首 其三","author":"缪焕章","text":"忆别江南第一程，二分月色玉箫声。\n水乡浩荡迷前梦，山径崎岖懒问名。\n我幸对床联骨肉，君将簪笔颂升平。\n惠思傥遂褰裳愿，剪烛西窗话五更。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19079,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冉右之明经叠韵惠赠，依韵和答四首 其四","author":"缪焕章","text":"夙闻生计一毡寒，枳棘栖鸾恐未安。\n声气应求知己少，文章遇合解人难。\n新诗字字堪酬锦，步障层层稳护阑。\n从此神交通寤寐，过江洗马例争看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19080,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"右之复叠韵见贻，再和二章 其一","author":"缪焕章","text":"踪迹相违百里程，只凭诗句附同声。\n十年中垒谈经席，一代司空博物名。\n诗为苦吟饶蕴藉，境缘多累愈和平。\n因君尽涤疏狂态，不独邯郸故步更。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19081,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"右之复叠韵见贻，再和二章 其二","author":"缪焕章","text":"几日清风已戒寒，衙斋支榻幸相安。\n性偏嗜酒逃名易，生判多情作佛难。\n梦绕兰陵时倚枕，香盈菊圃偶凭栏。\n秋英多少悲零落，幸有高人破格看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19082,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和朱鹿岩游大酉洞 二首 其一","author":"缪焕章","text":"胜侣偕游兴倍耽，仙源指点路初谙。\n四围金碧沉斜照，一带清苍起夕岚。\n坐处人疑星聚五，序来我忝齿居三。\n不须更觅蓬莱顶，奥壤神皋已共探。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19083,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和朱鹿岩游大酉洞 二首 其二","author":"缪焕章","text":"到处飞鸿印雪泥，吟鞭忽指夜郎西。\n撩人花月思吴苑，入画山川忆会稽。\n万古真灵通指顾，半生踪迹付轮蹄。\n幻游旧什偏零落，手浣蛮笺刻意题。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19084,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题问月图三首 其一","author":"缪焕章","text":"楚客问天天不理，君今问月又何辞。\n缺多圆少无穷恨，万古千秋一任之。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19085,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题问月图三首 其二","author":"缪焕章","text":"冰轮不减旧时圆，锦瑟凄凉五十弦。\n挑尽玉缸眠不得，秋声如雨夜如年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19086,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题问月图三首 其三","author":"缪焕章","text":"瑶台绛阙恨如何，元九悲怀枨触多。\n脉脉柔情深似水，悄无人处诉嫦娥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19087,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题许春海纪行诗","author":"缪焕章","text":"客里相逢累举杯，得吟佳句倍低徊。\n身经百战干戈地，胸擅千秋著作才。\n蜀国山川馀旧迹，楚天云雨只荒台。\n满怀郁积凭君扫，展卷频浮大白来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19088,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和沈菁士夜话有感韵三首 其一","author":"缪焕章","text":"黔南烽火彻江明，四见天涯岁月更。\n千里萧条馀赤土，万家转徙痛苍生。\n包胥有泪声俱碎，郑侠描图意未平。\n我欲通天台上表，莫教天鼓静中鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19089,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和沈菁士夜话有感韵三首 其二","author":"缪焕章","text":"少年诗境悟空明，中岁邯郸步渐更。\n薄命文章艰一第，多情风月误三生。\n蒪鲈有愿追张翰，婚嫁无多傲向平。\n且自守雌兼养拙，顺时饮啄与飞鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19090,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和沈菁士夜话有感韵三首 其三","author":"缪焕章","text":"半轮秋月照窗明，卧听谯楼欲二更。\n万事到头难逆料，五旬弹指怅浮生。\n空嗟榛莽连江表，欲筑茅庵署太平。\n似水凉宵无个事，喓喓草畔效虫鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19091,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和口子英韵","author":"缪焕章","text":"凭陵漫诩布三悬，鸡肋难当石勒拳。\n故垒荒芜嗟覆辙，殊方重晤亦前缘。\n四年浪迹抛驹隙，万里乡书倩雁传。\n独有客怀犹跌宕，秋心不减杜樊川。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19092,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"唐镜歌","author":"缪焕章","text":"开奁一视大异事，此镜逼真为我制。\n不知是我是古人，二千年前有此字。\n八分之书刻画精，其右曰仲左曰英。\n寻绎唐隶适吻合，轮郭如故朝代更。\n友人沈君得此物，反覆审睇勤披拂。\n纵然宝重如连城，睹字谓为予所独。\n当作琼瑶赠故人，菱花秋水露精神。\n将邪岂是尘中物，琬琰从来席上珍。\n只我自疑还自笑，金环小劫纷难道。\n虽信阳休匪古人，何知乾德同年号。\n昔之仲英果若何，毋亦与我同蹉跎。\n麟阁功名男子事，如何名与氏俱磨。\n幸哉形制犹完好，小于楪子偏明了。\n不用蟠螭与纽龟，已知隶古来天宝。\n因思唐政昔不纲，金镜晦彩韬光芒。\n上东门外胡儿啸，长信宫中帝业荒。\n钗擘钿分俱莫保，况如此镜尤微渺。\n照影无能共帨鞶，坠奁止合埋蓬葆。\n物生显晦真有期，因因果果漫狐疑。\n镜存当日伊非我，镜在今时我即伊。\n惠鱼庄蝶谁先觉，色相虚空浑不著。\n混沌休令窍窍通，灵源只觉头头活。\n本来面目知不知，睇观转复笑詅痴。\n君去我来墩属我，荆公曾为谢公嗤。\n我亦于兹增一解，从来世事皆桑海。\n一镜存留付后人，要知自有李程在。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19093,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和许晓东宴杜陵草堂及游小天竺诗韵二首 其一","author":"缪焕章","text":"江左风流继玉台，草堂祠畔又衔杯。\n欣逢寿老悬弧日，共迓元戎小队来。\n川合东西凭想像，酒争滕薛互迟回。\n粲花妙舌生花笔，公本登高作赋才。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19094,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和许晓东宴杜陵草堂及游小天竺诗韵二首 其二","author":"缪焕章","text":"芒鞋曾蹈浙西山，廿载西湖梦想间。\n一自崎岖来蜀国，那堪烽火遍乡关。\n楞华小證三生业，桑柘聊同十亩閒。\n虾菜鲈羹浑不羡，愿凭佛力驻丹颜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19095,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"和许晓东韵","author":"缪焕章","text":"少陵诗一编，光燄腾万丈。\n草堂有遗祠，花时恣探赏。\n良朋联胜会，马齿惭虚长。\n篮舆穿林入，野竹淩霄上。\n百花媚古潭，千载勤遐想。\n许子今词伯，高吟共繁响。\n琼瑶昨见报，清激绝摹仿。\n只愧坳堂水，难为沧海仰。\n小池一篑盈，杜厦万间广。\n临渊深浅殊，问君焉结网。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19096,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"答徐运生二首 其一","author":"缪焕章","text":"忆昔宏开选佛场，已钦文字固金汤。\n卜邻差拟东西舍，获售仍联伯仲行。\n薄宦苴兰来旧雨，赁春蜀国阅新霜。\n衍波笺写清诗在，回首黔灵感喟长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19097,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"答徐运生二首 其二","author":"缪焕章","text":"茫茫人海叹重来，庞统原非百里材。\n卌载朋侪馀我在，一时襟抱向君开。\n追思往事低徊久，幸接清光笑语陪。\n难得相逢遽相别，关心又盼陇头梅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19098,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题琢如中表同年遗照四首 其一","author":"缪焕章","text":"曾记丁年共缔交，我沉沧海尔云霄。\n低徊五十年前事，陵谷沧桑阅四朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19099,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题琢如中表同年遗照四首 其二","author":"缪焕章","text":"当君中禁挥毫日，值我黔阳佐幕时。\n家业飘零生计拙，累君辗转费筹思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19100,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题琢如中表同年遗照四首 其三","author":"缪焕章","text":"十年紫闼任翱翔，排比天章日万行。\n底事银河才洗甲，除书倏又下巫阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19101,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题琢如中表同年遗照四首 其四","author":"缪焕章","text":"几度青陵梦故人，谛观遗照倍酸辛。\n盈庭兰玉皆英隽，閒酌玻璃话夙因。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19102,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"灯下书怀","author":"张玉墀","text":"寂寞书斋对短檠，无聊还自说平生。\n茶虽多饮诗仍俗，酒可消愁器易盈。\n痛到齿牙经岁月，疾成疯癣验阴晴。\n不堪回首惟衰老，怕听堂前哭泣声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19103,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"癸丑春，吴子冠英为予写照，并问何图，予漫应之曰：随意，遂名随意图。率成短句为诸吟坛引玉","author":"张玉墀","text":"快意百不一，拂意什八九。\n人生忧劳中，坐是搔白首。\n委心学陶公，齐物师庄叟。\n揆之于圣贤，曰唯唯否否。\n绝在必固先，诚于格致后。\n白云生远峰，野泉流谷口。\n愿学非曰能，此理质良友。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19104,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"书斋自遣","author":"张玉墀","text":"我生孤僻俗缘悭，竟日阑珊闭故关。\n儿女债多遗业减，功名心淡此身閒。\n炉中馀篆萦蝌蚪，槛外浮云幻髻鬟。\n惟有诗篇足吟咏，渊明责子未曾删。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19105,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咸丰庚申四月十三日，江邑失守，东乡民团未散，虽连获胜仗，然早知势不可支，祸临旦夕矣。端午日，犹率族人诣祠祭献，悲号永别。至六月十一日，果掠华墅。自后贼踪不绝，居民东奔西窜，十室九空。忽忽经年，又值端午矣。时暂栖陶氏延野堂，有感而作","author":"张玉墀","text":"去岁值今辰，挥泪别先祖。\n今岁更流离，客舍逢端午。\n蘋藻不克荐，魂梦谒祠宇。\n有家不得归，避敌如避虎。\n一年复一年，春风又夏雨。\n令节徒徘徊，聊以酌村酤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19106,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"许凤山焚香静坐图","author":"张玉墀","text":"天地一劳区，人世苦鹿鹿。\n角利复角名，终岁疲奔逐。\n劳故不能静，能静即是福。\n境静心不静，寸衷尘万斛。\n心静身不静，何处避凡俗。\n君家有仙灯，华阳得道足。\n观君静坐图，令我意枨触。\n安得出红尘，把臂入深谷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19107,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"挽胡皋飏","author":"陶育","text":"簪缨几辈误封圻，甘把千秋让布衣。\n马革一朝皮骨裹，龙山六月雪霜飞。\n一腔热溅平生血，只手坚持死后旂。\n寄语高堂休怅悒，生儿如此是全归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19108,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"野步","author":"陶育","text":"昨宵梦里旧江东，信步行来迥不同。\n饱寇所留都是馂，薙山满眼尽成童。\n断桥隐约寒烟外，破屋攲斜夕照中。\n一路芦花风瑟瑟，穷通想到古英雄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19109,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"舟中偶阅六朝文归","author":"陶育","text":"有花可傍便停桡，摊卷蓬窗破寂寥。\n六代才华转眼过，声声流水送南朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19110,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"昆山道中偶见乡村有未被蹂躏者","author":"陶育","text":"桑柘影重重，人烽往日同。\n饧箫欢稚子，社酒醉村翁。\n牧笛斜阳外，书声流水中。\n三年前屈指，此景遍江东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19111,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渡淀山湖","author":"陶育","text":"尘沙莽莽鼓声哀，满眼烽烟一棹开。\n三泖云低沉塔影，一江风急送潮来。\n何时极浦销兵气，在昔东湖出将才。\n万众云霓翘首望，清人河上莫徘徊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19112,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏物四首 其一 秋蝇","author":"陶育","text":"疑他天地竟无秋，鼓翅营营闹不休。\n一霎炎威何处去，谗人今日也低头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19113,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏物四首 其二 秋蚊","author":"陶育","text":"负山无力枉张戈，团扇功微奈尔何。\n莫再成雷喧暮夜，穷黎膏血已无多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19114,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏物四首 其三 秋萤","author":"陶育","text":"纷萤营夜苦奔驰，腐草前身不自知。\n瑟瑟金风霜露下，可知光耀几多时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19115,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏物四首 其四 秋蝉","author":"陶育","text":"偶然脱却螳螂口，又是临风响遏云。\n休认而今栖处稳，枝头黄叶已纷纷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19116,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海上杂诗 其一","author":"陶育","text":"狂澜汹涌欲心寒，到此茫茫绪百端。\n廿载中原膏血尽，换来富庶此弹丸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19117,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海上杂诗 其二","author":"陶育","text":"中原地产富茶桑，横海楼船载出洋。\n岂是外夷真懵懂，甘将珍异换寻常。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19118,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海上杂诗 其三","author":"陶育","text":"广开马路接毬场，高飏红旂号富强。\n此地已成罗刹国，尚言高阁是天堂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19119,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海上杂诗 其四","author":"陶育","text":"防微绝少远人来，柔远何年海禁开。\n屈指开玄全盛日，无穷祸已此中胎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19120,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"征途","author":"陶育","text":"昨日过山腰，今日涉水浒。\n看山复看山，跋涉不知苦。\n云际见东风，先愁明日雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19121,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"拜薛畏斋先生祠","author":"陶育","text":"睹此荒郊象，先生亦怆然。\n当年乾净地，此日奈何天。\n勋业垂江上，沧桑又变迁。\n谁为后死者，泪洒墓门烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":19122,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]