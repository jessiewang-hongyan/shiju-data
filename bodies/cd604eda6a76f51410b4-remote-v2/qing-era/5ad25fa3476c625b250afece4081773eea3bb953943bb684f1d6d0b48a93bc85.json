[{"title":"望江怨  清明","author":"丁澎","text":"羲轮促。\n山鬼秋坟泣修竹。\n新烟移古木。\n鸱夷长伴刘伶宿。\n反乎复。\n昨岁冶游人，北邙春夜独。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40412,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西溪子 本意","author":"丁澎","text":"茅屋溪头霜早。\n占得清光多少。\n小桥边，枫一树。\n鸥一渚。\n与汝平分秋雨。\n黄叶可前村。\n问渔人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40413,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长相思  其一 本意","author":"丁澎","text":"花阴阴。\n月阴阴。\n花月无情似有心。\n此心何处寻。\n朝云深。\n暮云深。\n暮暮朝朝直到今。\n于今却怎禁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40414,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长相思  其二 采花","author":"丁澎","text":"郎采花。\n妾采花。\n郎指阶前姊妹花。\n道侬强是他。\n红薇花。\n白薇花。\n一树开来两样花。\n劝郎莫似他。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40415,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"乌夜啼    怀旧","author":"丁澎","text":"画栏曾系兰桡。\n正春宵。\n公子朱门何处芰荷桥。\n瑶瑟断，银烛冷，暗魂消。\n记得屏前红袖一相招。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40416,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉太平  为严补阙题古秋堂","author":"丁澎","text":"芙蓉作楼。\n鸬鹚作洲。\n主人有酒宜秋。\n插黄花满头。\n莼湖一舟。\n桐江一裘。\n山中猿鹤相留。\n道先生且休。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40417,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字鹧鸪天  妆阁梅","author":"丁澎","text":"妆阁梅。\n随风吹送入君怀。\n玉肌香腻，傍人莫暗猜。\n卜重谐。\n轻梢小朵压横钗。\n数来颠倒成双，笑同回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40418,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长命女   春闺","author":"丁澎","text":"春如海。\n衰桃斜映西窗外。\n弄影人无奈。\n剃袅金虫暗坠，衫锁珠蕤未解。\n绿遍宜男愁不采。\n蝶绕湘裙带。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40419,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"生查子 其一 秋夕","author":"丁澎","text":"山客殊未眠，静倚秋亭暮。\n蟋蟀入床头，池照移庭树。\n卷幔驻逍遥，石鼎烟初炷。\n玉露剪桐花，化作空阶雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40420,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"生查子   其二 江上","author":"丁澎","text":"系艇白杨桥，门对春江渌。\n江雁解人怜，队队沙头浴。\n妾住在萧滩，郎渡浔江曲。\n愿作江上云，来去同欢宿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40421,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"生查子    其三 写情","author":"丁澎","text":"几日别君时，一夜添消瘦。\n无日不思君，试问君曾否。\n昨日得君书，今日开缄又。\n明日几回寻，何日能抛手。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40422,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"昭君怨  本意","author":"丁澎","text":"玉辇春云梦断。\n翠幕红酥香暖。\n莫更弄琵琶。\n有胡笳。\n薄鬓紫貂斜亸。\n眉染冰绡愁锁。\n何物似宫中。\n一声鸿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40423,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"酒泉子   风情","author":"丁澎","text":"暮阁帘垂。\n生憎郎如明月，透罗帏，穿花径，少人知。\n妾身还似绿杨枝。\n不禁梁上燕，赚王孙，因风转，怕归迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40424,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉公子","author":"秦昙","text":"香囊垂绣凤。\n是妾儿时弄。\n微物何足珍。\n怜他伴妾身。\n红绵著在里。\n扣上同心缕。\n一缕一相思。\n数来千万丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40425,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇 冬词","author":"丁澎","text":"未是春来，枕屏不耐梅花瘦。\n早妆才就。\n日影移鸳甃。\n眉际螺芬，脸际檀霞透。\n开双袖。\n问郎寒否。\n试纳郎纤手。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40426,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙  其一 春词","author":"丁澎","text":"十五纤腰学柳轻。\n东风无那惹流莺。\n渡江兰楫自相迎。\n红豆不将投薄幸，青鸾原只寄多情。\n碧桃花下坐调笙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40427,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙  其二 春词","author":"丁澎","text":"买断春风榆荚钱。\n抛残红日柳丝鞭。\n王系归去剧堪怜。\n鹦鹉窥翻双陆局，珊瑚擘乱十三弦。\n昼长无事不教眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40428,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙  其三 春词","author":"丁澎","text":"叠叠巫山不是高。\n茫茫鄂渚未云遥。\n难挨惟有可怜宵。\n两意半含如豆蔻，寸心千转是芭蕉。\n东风不管倩魂消。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40429,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙  其四 春词","author":"丁澎","text":"紫陌珠軿挽碧丝。\n鹧鸪啼上海棠枝。\n香勾争踏艳阳时。\n楼上红筝翻鹞子，鬓边金胜闹鹅儿。\n恼人忙处掷相思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40430,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"中兴乐  山中简陆景宣","author":"丁澎","text":"昏鸦小雨落枫时。\n山中岑寂如斯。\n惟迟君来，晤言消之。\n茅檐月出横溪。\n雅相宜。\n床头斗酒，兼之鹿乳，蕨菜初肥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40431,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"眉萼   忆旧   新谱翻曲，[中兴乐]用仄韵","author":"丁澎","text":"绿窗人静榴花瘦。\n眉萼翠香依旧。\n记得堂前，簸钱羞走。\n不合当时迤逗。\n愁时候。\n心头念着，小字千回，忍将伊咒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40432,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"诉衷情 春游，和仲殊韵","author":"丁澎","text":"谁家绮阁傍芳洲。\n渌水绕门流。\n罗衣暗香微度，归到小红楼。\n金钿落，翠鬟浮。\n折花游。\n一回含笑。\n半晌沉吟，几步回头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40433,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"采桑子   本意","author":"丁澎","text":"提笼陌上逢游冶，郎佩香蓝。\n妾带宜男。\n两种芳心各自谙。\n佯羞却步娇无语，心似春蚕。\n泪在青衫。\n欲说相思一半含。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40434,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卜算子  春恨和淮海韵","author":"丁澎","text":"晓起乍开帘，满眼梨花瘦。\n恼却流莺不住啼，明日还来否。\n啼罢莫频来，楼上双垂手。\n颊衬桃花不耐红，晕薄非关酒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40435,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花　  其一 旅兴","author":"丁澎","text":"百花洲里。\n盈盈小阁春如许。\n何必烟霞。\n风弄庭前枳壳花。\n梦来无绪。\n料应多是清时雨。\n莫道天涯。\n门对当垆第二家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40436,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花　  其二 镜里","author":"丁澎","text":"蝉松未折。\n轻弹红絮飘香雪。\n妒杀真真。\n画上添他双玉人。\n眼波斜送。\n颠倒眉心粘翠凤。\n笑唤卿卿。\n一笔描来两处情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40437,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮　    其一 回文","author":"丁澎","text":"锦鸳文印檀霞枕。\n枕霞檀印文鸳锦。\n蛾黛蹙愁多。\n多愁蹙黛蛾。\n院深喧语燕。\n燕语喧深院。\n长若杜兰香。\n香兰杜若长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40438,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮　    其二 回文","author":"丁澎","text":"绿鬓烟挽斜勾玉。\n玉勾斜挽烟鬓绿。\n郎赠口脂香。\n香脂口赠郎。\n影鸾交彩映。\n映彩交鸾影。\n傍镜笑成双。\n双成笑镜傍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40439,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮　    其三 回文","author":"丁澎","text":"渌波春罨横塘曲。\n曲塘横罨春波渌。\n眉似柳家儿。\n儿家柳似眉。\n小星花榭绕。\n绕榭花星小。\n弹指玉灯残。\n残灯玉指弹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40440,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮　    其四 回文","author":"丁澎","text":"草芳闲院春啼鸟。\n鸟啼春院闲芳草。\n情薄怨来生。\n生来怨薄情。\n蝶间花笑妾。\n妾笑花间蝶。\n遮莫妾如花。\n花如妾莫遮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40441,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮　    其五 回文","author":"丁澎","text":"数重花幔穿金缕。\n缕金穿幔花重数。\n愁处是高楼。\n楼高是处愁。\n凤钗横压梦。\n梦压横钗凤。\n通梦两心同。\n同心两梦通。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40442,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮　    其六 回文","author":"丁澎","text":"旧如相识当垆酒。\n酒垆当识相如旧。\n卿是可人情。\n情人可是卿。\n扇低翻见面。\n面见翻低扇。\n人觑却回身。\n身回却觑人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40443,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮　    其七 回文","author":"丁澎","text":"下帘低唤郎知也。\n也知郎唤低帘下。\n来到莫疑猜。\n猜疑莫到来。\n道侬随处好。\n好处随侬道。\n书寄待何如。\n如何待寄书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40444,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮　    其八 回文","author":"丁澎","text":"女墙东映红兰渚。\n渚兰红映东墙女。\n迷路小窗西。\n西窗小路迷。\n错来行又却。\n却又行来错。\n真个恁情亲。\n亲情恁个真。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40445,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏促红窗 本意","author":"丁澎","text":"雁声频，霜华坠。\n悄过画屏愁倚。\n梧桐滴画虬壶水。\n添枕函清泪。\n初松髻，方成寐。\n谁把梦儿惊起。\n芭蕉送雨，到暗灯窗里。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40446,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怨桃花　　 春闺","author":"丁澎","text":"雕梁彩燕睆窗纱。\n人似卢家。\n眉拭翠，脸匀霞。\n时样不争差。\n起看帘日初斜。\n睡未足、痕生鬓鸦。\n刘郎归梦殢天涯，怨桃花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40447,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐　 放艇","author":"丁澎","text":"青山似沐。\n深柳含茅屋。\n帆影樽前随处绿。\n爱傍鸥群同宿。\n蒲菰还映平沙。\n烟青何处人家。\n天外几行归鸟，村前一带桃花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40448,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆秦娥　　    其一 　中秋，和太白韵","author":"丁澎","text":"冰弦咽。\n翠蛾人倚瑶台月。\n瑶台月。\n嫦娥应，个侬无别。\n疏帘永夜中秋节。\n碧云如海青鸾绝。\n青鸾绝。\n人间自有，玉楼琼阙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40449,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆秦娥　　 其二 秋夜","author":"丁澎","text":"人如昨。\n黄昏望断西楼约。\n西楼约。\n如何把梦，也教闲却。\n梧桐月浸罗幛薄。\n飞虫又提灯花落。\n灯花落。\n恁般清冷。\n怎生挨着。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40450,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜迁莺     春游","author":"丁澎","text":"杨花落，换春衣。\n挟弹洛阳堤。\n王孙锦坠香泥。\n倡楼不忆归。\n月钩斜，芳茵软。\n醉枕红笋风暖。\n满天花雨送鸱夷。\n愁杀鹧鸪啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40451,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"画堂春 答程端伯侍郎","author":"丁澎","text":"藏名何地可栖。\n鹿门耆旧人稀。\n空山古木秃啼。\n天外樵归。\n卧雪先生方起。\n停云老子相期。\n黄花满地酒千杯。\n无限鸿飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40452,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"金门归去  怀张补阙螺浮病假归禾中","author":"丁澎","text":"辞金阙。\n何似茂陵归切。\n东山丝竹西山笏。\n海天还弄明月。\n曾记柳条初折。\n又是马蹄霜结。\n延秋门外花如雪。\n今年恁时节。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40453,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋蕊香 当场，和晏叔原韵","author":"丁澎","text":"小阁绿阴遮就。\n每到踏青时候。\n游人共约烧香偶。\n萧九娘家沽酒。\n当垆未老人依旧。\n双纤手。\n银瓶浅汲红珠久。\n低说侬家只有。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40454,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"武陵春   其一 冬景","author":"丁澎","text":"老树压云檐溜折，烂叶满山溪。\n鸟断空林昼掩扉。\n风雪一椎归。\n沽酒前村梅正落，香雾扑人衣。\n日暮绿溪独杖藜。\n一任野鸥随。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40455,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"武陵春 其二 闺思，和李清照韵","author":"丁澎","text":"郎去萧滩十八折，折折在心头。\n泪卷西风无了休。\n吹送楚江流。\n竹格渡前风日好，早晚问归舟。\n认得艄娘郎去舟。\n人不是、几回愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40456,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"桃源忆故人 春闺","author":"丁澎","text":"红薇紫燕团成队。\n正是困人天气。\n抛却绣床闲戏。\n须趁鹦哥睡。\n脸霞双衬轻红腻。\n早被东风吹醉。\n池上鸳鸯作对。\n忙过秋千背。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40457,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"眼儿媚  开缄","author":"丁澎","text":"银钩和泪折琼枝。\n又寄断肠词。\n开缄何物，几颗红豆，一袅乌丝。\n鸳鸯倒押宜春字。\n此意费寻思。\n分明说与，海棠开后，燕子来时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40458,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"滩破浣溪沙  其一 娇小","author":"丁澎","text":"一剪鸦翎半亸肩。\n生憎娇小向人前。\n曾解东风多少恨，自今年。\n爱唱新翻歌尚怯，学梳时样髻长偏。\n捉得蜻蜓双叠翅，背人看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40459,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"滩破浣溪沙     其二 渤海道中","author":"丁澎","text":"独向柤梾采石芝。\n灞陵妻子讶归迟。\n沧海一裘风雪里，少人知。\n懒到虱嫌嵇叔拙，贫来鬼笑伯龙痴。\n短鬓怕将愁思织，已成丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40460,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"滩破浣溪沙   其三 野祠","author":"丁澎","text":"鸳瓦霜凋野蔓疏。\n澹烟黄叶女郎祠。\n玉貌花钿秋雨洗，半模糊。\n古案神灯翻堕鼠，短墙瘿树惯栖乌。\n客去钟残山月白，一僧孤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40461,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三字令  闺怨","author":"丁澎","text":"风雨里，送残春。\n暗消魂。\n琼笺杳，宝钗分。\n燕来时，花落处，怕思君。\n愁如絮，梦如云。\n正黄昏。\n金猊炙，玉蟾新。\n恁良宵，谁更惜，可怜人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40462,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"锦堂春  题秦氏书屋","author":"丁澎","text":"疏雨半窗花影，秋风一枕松声。\n焚香独会参同契，手自训黄庭。\n鹆眼冷依湘竹，乌皮静罨蓉屏。\n阮公酒瓮陶公菊，偏此最关情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40463,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"两相思    歌席调刘晋度","author":"丁澎","text":"翠袖练裙香菀，花底送愁蛾。\n锦瑟樱桃相和歌。\n争看无奈何。\n素手娇映红螺。\n画屏深、细炙银鹅。\n爱盻周郎曲误多。\n教侬却怎么。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40464,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"番女八拍  本意","author":"丁澎","text":"黄榆风急海鹙啼。\n马频嘶。\n蓬婆城外千山雪，锦伞蛮靴夜打围。\n梧桐树下轧鸣机。\n念征衣。\n孤鸿一去无消息，使尽西风唤不归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40465,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳梢青 寄怨","author":"丁澎","text":"红杏依然。\n小楼空倚，月断晴川。\n不采靡芜，打开鹦鹉，有恨休传。\n恼人偏是云笺。\n更说恁灯前枕边。\n不信他家，秾香艳粉，若个堪怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40466,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"河渎神  山旅舍逢何蕤音侍御兼讯曹顾庵学土","author":"丁澎","text":"风雪桥迟。\n山家共倒鸆瓷。\n袁安高卧已多时。\n为子折简招之。\n何如旧日岷阳宅。\n马蹄早趁霜热。\n满地昏鸦树白。\n烦君敬谢逋客。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40467,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"滴滴金    春暮","author":"丁澎","text":"子规不厌啼朝雨。\n帐绡寒、人如醉。\n游系偏惹墙头絮。\n恼得东风住。\n凭栏立尽残红暮。\n问春归向何处。\n胡蝶花丛斑燕乳。\n可是相思做。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40468,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偷声木兰花  怨情","author":"丁澎","text":"五花麡角青奴冷。\n星透铜乌莲羽净。\n此际难支。\n红泪抛残十二时。\n秦王宫里青铜镜。\n能照妾胸方寸影。\n安得神针。\n绣出思君一片心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40469,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"扶醉待郎归 本意","author":"丁澎","text":"敛眉檀晕薄寒侵。\n红酥透，力难禁。\n迷离春思几沉吟。\n含羞错弄琴。\n流萤点点过花阴。\n吹不度，是郎心。\n玉人真个到温衾。\n巫山梦未深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40470,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"少年游 豆娘子","author":"丁澎","text":"绿绡香卷粉痕轻。\n花底未分明。\n薄翠三分，纤腰一缕，占得许多情。\n怯向东风寻旧恨，梨雨梦难成。\n巧上花须，玉人头上，添取钿云青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40471,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"燕归梁  仙姝和柳耆卿韵","author":"丁澎","text":"石叶烟鬟惹翠深。\n钗燕凝金。\n吹箫偷作彩鸾吟。\n碧桃下，整罗襟。\n琼楼碧海千年恨，空行雨、到如今。\n人间多少会知音。\n偏解得、是琴心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40472,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一痕眉碧  湖上行春","author":"丁澎","text":"风送画桥春渌。\n戏水紫鸳争逐。\n柳花落画短长亭，偏乱惹低鬓绿。\n人倚翠楼如玉。\n忍使妩眉长蹙。\n鹧鸪飞上竹枝啼，停樽且尽吴娘曲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40473,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆醉乡 磅系无言归黄山","author":"丁澎","text":"鹿门未老，蹉跎双鬓，归寻旧里。\n探囊中，酒瓢存，足了一生惟醉。\n蜗角浮名如戏耳。\n笑裘马、无如芒履。\n君行矣，莫停杯，醉乡即在桃源里。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40474,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"燕衔花   闺情 新谱自度曲","author":"丁澎","text":"吹落燕衔花絮。\n着意留他住。\n帘栊斜入复飞来，凝眸乍，已随春暗去。\n欹枕小眠惊起，没个安排处。\n剔匀残穗又灯花，郎归也，正萧萧暮雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40475,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寻芳草  本意","author":"丁澎","text":"嫩碧微烟笼。\n踏青时、芳菲谁共。\n绣鞋儿、却被香尘拥。\n挽不住、王孙梦。\n拾翠几寻思，笑然着、合欢闲弄。\n茜裙飘、撩得蔷薇动。\n零乱了、钗头凤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40476,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉花阴   其一 春暮，和清照韵","author":"丁澎","text":"帘影沉沉移午昼。\n迷迭消红兽。\n弹泪上花梢，一霎风吹，片片胭脂透。\n困人天气黄梅候。\n粉汗沾罗袖。\n鸾镜掩重开，试揣红绵，却是何时瘦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40477,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]