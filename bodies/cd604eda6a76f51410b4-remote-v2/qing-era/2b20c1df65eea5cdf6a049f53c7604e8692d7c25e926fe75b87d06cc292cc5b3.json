[{"title":"月华清  壬寅中秋","author":"王鹏运","text":"金粟浮香，冰轮碾玉，閒庭风物如画。\n弄影婆娑，一笑尘襟都洒。\n倩西风、丁属姮娥，休更遣、罗云萦惹。\n愁话。\n忆年时断梦，醒来还怕。\n难忘瑶台清暇。\n是佳约延秋，朋笺催砑。\n把盏怀人，自酹孤光遥夜。\n试说与、镜里悲欢，尽销得、吟边陶写。\n慵借。\n问游仙枕畔，彩鸾谁跨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42139,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"念奴娇  叠韵酬渔公","author":"王鹏运","text":"津梁疲矣，且相从一饱、茆檐不托。\n输与閒閒云意懒，不似客游轻作。\n残霸关河，悲秋时节，对酒浑忘酌。\n绮怀微倦，满前新句慵索。\n何必憔悴兰成，江潭赋就，始解伤摇落。\n官柳垂垂低飐影，能值几絇丝络。\n白发閒搔，青山长往，万事风鸣铎。\n故人书报，菊花期就前约。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42140,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蓦山溪  午发桃源，明日抵清河矣","author":"王鹏运","text":"东来十驿，渐报邮签彀。\n鹭堠懒于人，定怜客、往还何骤。\n老怀萧散，随分傲霜风，算心事，白鸥知，迟我江湖久。\n襟尘历历，香凝长安酒。\n大道直如绳，倚南辕、黯然回首。\n不夷不惠，料理著閒身，吴波阔，楚天长，好试扁舟手。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42141,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"水调歌头  淮安舟中","author":"王鹏运","text":"唱我远游曲，唤起大鱼听。\n百年知几行乐，莫视酒杯轻。\n记取明朝重九，访古文游台畔，黄菊重寻盟。\n吟啸霜风里，破帽恰多情。\n吊王孙，淮水曲，酒还倾。\n丛芦风过瑟瑟，似作不平鸣。\n身计正须温饱，底用登坛开国，一掷徇浮名。\n试看沧波冷，瓯梦不能惊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42142,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"声声慢  辛园小憩同旭庄","author":"王鹏运","text":"杂花铺绣，浅草裁茵，凭栏野色浮空。\n败柳枯荷，商声递入金风。\n悤悤载花载酒，对閒园、才识秋容。\n悄相向，借吴波涨绿，与洗尘红。\n谁唱白铜鞮曲，趁如云娇马，流水西东。\n桥下龟鱼，也应惊到吟筇。\n风光自延倦客，倚残曛、閒数疏钟。\n海天回，寄愁心、塞外断鸿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42143,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"霜叶飞  海上喜唔沤尹，用梦窗韵赋赠。时沤尹持节岭南，予适有吴趋之行，悤悤聚别，离绪黯然矣","author":"王鹏运","text":"酒边孤绪。\n游情倦、閒云自恋江树。\n槎风欣送故人来，香汎梅根雨。\n叹冉冉、流光迅羽。\n残灰愁忆昆池古。\n好寄似南枝，岭上早春回，莫负玉娥幽素。\n回首秋鬓惊尘，觚棱北望，黯然肠断愁赋。\n白头不拟此重逢，喜入镫唇语。\n看驿柳、烟丝飐缕。\n吴篷先载閒鸥去。\n剩梦君、沧江上，霓节干云，使星明处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42144,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天  登玄墓还元阁用叔问重泊光福里韵","author":"王鹏运","text":"云意阴晴覆寺桥，秋声瑟瑟径萧萧。\n五湖新约尊前订，十月轻寒画里销。\n凭翠槛，数烟桡。\n一楼人外万峰高。\n青山阅尽兴亡感，付与松风话市朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42145,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"齐天乐  泊舟光福，故友许鹤巢郎中乡里也，感赋此解","author":"王鹏运","text":"峭帆乍转横塘路，湖山顿惊愁眼。\n双崦茶烟，四桥松雨，曾记吟边深绻。\n梅林弄晚。\n访醉墨题香，紫箫声断。\n唤起秋魂，荒荆何处旧池馆。\n沧波相对欲绝，乱云携酒处，愁系孤缆。\n临顿前盟，东华旧侣，谁识尘衫游倦。\n斜阳泪满。\n听啼鸟花閒，故情轻换。\n怨笛难招，虎山孤鹤远。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42146,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"水龙吟  惠山酌泉","author":"王鹏运","text":"黛眉不点吴娃，淩波独秀空烟际。\n疏林霜染，深蹊苔涩，虚堂澜绮。\n溅沫跳珠，清声泻玉，石鳞荒翠。\n自凭阑照影，古人不见，閒愁逐，轻鸥起。\n一桁竹炉烟细。\n卧听松、筝琶净洗。\n孤怀谁识，临风把盏，低徊问水。\n斜日游船，古阴秋苑，笙歌催醉。\n唤铜瓶载取，归来重试，在山泉味。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42147,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"洞仙歌  吴江枫老，以杂树閒之，尤鲜丽可玩，舟中读玉泉咏叶诸词，即用其韵以志幽赏","author":"王鹏运","text":"疏黄败绿，爱寒林江步。\n掩映吴枫冷红舞。\n炫秋容、最是径转帆回，鸦背闪、点点夕阳明处。\n暮山岚翠敛，持底明妆，认取笼烟几行树。\n老去绮情删，沟水东西，愁更忆、题琼残句。\n尽艳入、诗心比春花，叹谁识鏖霜，岁寒良苦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42148,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"念奴娇  逭暑焦山自然庵，为庵主六公题如此江山图，用东坡赤壁韵","author":"王鹏运","text":"云埋浪打，想髯翁、当日吟边风物。\n问讯江山无恙否，目断岩岩苍壁。\n断续惊涛，联翩游屐，好句留冰雪。\n焦仙醒未，为予唤起英杰。\n最是枨触愁心，禅天梵放，云外清笳发。\n扑地苍烟飞不起，海气浮空明灭。\n秋色西来，中原北望，天远青如发。\n孤光不改，多情祇有圆月。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42149,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"木兰花慢  归德访西陂故址","author":"王鹏运","text":"纬萧图画里，记亲见、草堂幽。\n甚浴鸭池荒，栖莺柳老，春淡成秋。\n汀洲。\n钓人居处，有平泉、树石记中收。\n剩得残山一角，冷烟低罥閒愁。\n悠悠。\n往事问沙鸥。\n文采宋黄州。\n是少日兵戈，承平觞咏，投老菟裘。\n扁舟。\n待盟旧隐，怅暮天、无际乱云流。\n怕有夷歌夜起，惊心慵听渔讴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42150,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙","author":"王鹏运","text":"老去耽游藉息机，四年三度此停騑。\n巫山仍隔楚云西。\n野驿风高尘漠漠，首春寒重雾霏霏。\n醉呼浊酒自添衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42151,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙  其一 叠韵答次珊","author":"王鹏运","text":"许事人閒未要知，杜鹃声里日迟迟。\n低头臣甫更无诗。\n身世相看原虮虱，文章何处不骈枝。\n楚兰肠断独醒时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42152,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙  其二 叠韵答次珊","author":"王鹏运","text":"万里长风万里沙，晚晴消息散馀霞。\n百年趢趗是生涯。\n短锸未妨行处荷，戒香不放定中斜。\n且拈新句酹新花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42153,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝  其一 拟花閒","author":"王鹏运","text":"赋里长杨旧有名，即看眉样亦倾城。\n春风软入朝元阁，莫更思量作雨声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42154,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝  其二 拟花閒","author":"王鹏运","text":"飞絮空濛锁画楼，年年寒食听离留。\n争信龙池三二月，片风丝雨欲惊秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42155,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉楼春  其一 和小山韵","author":"王鹏运","text":"落花风紧红成阵，睡重不知春远近。\n筝弦声涩镇慵调，燕语情多羞借问。\n屏山苦隔天涯信，咫尺关河千万恨。\n楼前芳草远连天，望眼不随芳草尽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42156,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉楼春  其二 和小山韵","author":"王鹏运","text":"閒云何止催春晚，遮断望京楼上眼。\n犀帘有隙漏香多，鲛帕无情盛泪满。\n柔肠已逐鹍弦断，风外阑干凭不煖。\n归来十九醉如泥，禁得良宵更漏短。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42157,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉楼春  其三 和小山韵","author":"王鹏运","text":"不辞沈醉东风里，笑解金鱼能值几。\n四条弦语软于烟，一桁帘痕清似水。\n醉调银甲寒浸指，只有翠尊知客意。\n酒云红晕衬微涡，解向歌尘凝处起。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42158,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·清明六首 其一","author":"陆震","text":"清明节，天意晓来和。\n正喜乍晴晴不久，愁他欲雨雨偏多。\n佳节惜虚过。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42159,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·清明六首 其二","author":"陆震","text":"清明节，春色满江城。\n卖酒楼边红杏放，游人头上柳枝青。\n都道过清明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42160,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·清明六首 其三","author":"陆震","text":"清明节，记得在虹桥。\n随意柳边看戏马，有时花底听吹箫。\n那得不魂销。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42161,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·清明六首 其四","author":"陆震","text":"清明节，记得在西园。\n都是桃花都是柳，半含朝雨半含烟。\n人在画图边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42162,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·清明六首 其五","author":"陆震","text":"清明节，何用皱眉头。\n今日有花还有酒，此身无事便无愁。\n兀坐最高楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42163,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·清明六首 其六","author":"陆震","text":"清明节，有客在天涯。\n没个信音缘底事，可怜风雨宿谁家。\n远望一长嗟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42164,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·初夏九咏，和刘蔚园 其一","author":"陆震","text":"高田麦，四月未全黄。\n实绽已堪盈把捋，味香且任满盘尝。\n渐入好年光。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42165,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·初夏九咏，和刘蔚园 其二","author":"陆震","text":"崖蜜熟，应是十分甜。\n寝庙及新宜早荐，林莺当令莫轻衔。\n留与绛唇含。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42166,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·初夏九咏，和刘蔚园 其三","author":"陆震","text":"蚕忙日，豆熟已离离。\n摘入蟹筐全类茧，缫于女手本无丝。\n笑杀采桑儿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42167,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·初夏九咏，和刘蔚园 其四","author":"陆震","text":"携镵去，不异到淇园。\n出土便能藏雉子，疗饥馋想嚼龙孙。\n拚少竹千根。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42168,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·初夏九咏，和刘蔚园 其五","author":"陆震","text":"梅黄早，叶底缀金丸。\n功逊酒香教渴解，味如愁重惹眉攒。\n花放记曾看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42169,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·初夏九咏，和刘蔚园 其六","author":"陆震","text":"京江口，下网得鲥鱼。\n敢望乘潮归渤海，且随走马到燕都。\n谁令味偏腴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42170,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·初夏九咏，和刘蔚园 其七","author":"陆震","text":"闺中女，最爱是玫瑰。\n红杏街头前月尽，素馨江外几时来。\n独尔一枝开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42171,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·初夏九咏，和刘蔚园 其八","author":"陆震","text":"牛虽贱，人号女儿红。\n桃靥初酣春昼睡，杏腮刚晕酒时容。\n还恐不如侬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42172,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·初夏九咏，和刘蔚园 其九","author":"陆震","text":"商船到，争卖雨前茶。\n宁著酒魔耽雪酿，不遭水厄试冰芽。\n亟唤取流霞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42173,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·咏玫瑰","author":"陆震","text":"春来卉。\n堪爱独玫瑰。\n簪鬓放娇怜紫艳，伴糖津咽胜红蕤。\n枯润总香飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42174,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·辛巳清明 其一","author":"陆震","text":"清明节，回首望先茔。\n合抱树皆经水拔，一抔土欲与田平。\n念此最伤神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42175,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·辛巳清明 其二","author":"陆震","text":"清明节，犹是峭寒时。\n燕子来从前日早，梨花开较去年迟。\n门闭雨丝丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42176,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·辛巳清明 其三","author":"陆震","text":"清明节，僻县也人忙。\n十里红裙山子庙，一船春酒郭家庄。\n处处菜花香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42177,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·辛巳清明 其四","author":"陆震","text":"清明节，布谷已先鸣。\n小县人饥思乐岁，平畴雨足好春耕。\n水旱莫相惊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42178,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·端阳词 其一","author":"陆震","text":"端阳节，风物与常殊。\n屋角乱红开蜀季，街头新绿买菖蒲。\n都挂辟邪符。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42179,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·端阳词 其二","author":"陆震","text":"端阳节，照眼石榴红。\n艾虎朱符儿女意，香蒲角黍岁时风。\n小扇午窗中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42180,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·端阳词 其三","author":"陆震","text":"端阳节，记得在瓜洲。\n郭璞墓前风定处，江天寺里塔高头。\n好看汎龙舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42181,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·端阳词 其四","author":"陆震","text":"端阳节，记在小西湖。\n酒胜桑郎浓似乳，蔌惟新笋嫩于蒲。\n笑看醉人扶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42182,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·端阳词 其五","author":"陆震","text":"端阳节，记得在江乡。\n入网鲥鱼浑似雪，压枝梅子未全黄。\n何日更重尝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42183,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·端阳词 其六","author":"陆震","text":"端阳节，记得在邗沟。\n沽酒竞誇金谷馆，汎湖争买木兰舟。\n歌吹几曾休。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42184,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆江南·端阳词 其七","author":"陆震","text":"端阳节，还忆素梅娘。\n几度魂销红豆曲，数声吹彻玉箫长。\n好事最思量。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42185,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒金门·闺怨","author":"陆震","text":"芳草碧。\n又是一番春色。\n独倚阑干珠泪滴。\n不知罗袖湿。\n·欲寄天涯消息。\n为问归鸿可的。\n只恐天涯流落客。\n归鸿他不识。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42186,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"眉峰碧·夜泊许家堡","author":"陆震","text":"杯酒虽欢聚。\n不惯他乡住。\n荒村寂寂水漫漫，又重盼、来时路。\n·向夕停舟处。\n风雨声偏楚。\n何似当初径不来，而今也不还家去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42187,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇·雨中戏作","author":"陆震","text":"雨雨风风，天公已做新秋势。\n驱愁无计。\n且买今宵醉。\n·索取床头，早拂山妻意。\n君休矣。\n青钱无几。\n留籴晨炊米。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42188,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"唐多令·邗江喜遇友人酒间赠此","author":"陆震","text":"下马解貂裘。\n相携上酒楼。\n问年来、何地飘流。\n北踏幽燕南闽粤，憔悴了，十多秋。\n身世等蜉蝣。\n功名雪满头。\n且高歌、一曲凉州。\n君若问余心上事，说不尽，半生愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42189,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"黄金缕·寒夜口占","author":"陆震","text":"寒夜空堂人一个。\n心上愁多，不寐摊书坐。\n将近三更犹未卧。\n乍惊骤雨天边过。\n洒向小窗声更大。\n纸薄难禁，容易风吹破。\n衾枕安排浑未妥。\n床前扑杀银釭火。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42190,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南柯子·落花","author":"陆震","text":"庭树风吹后，苍苔雨过初。\n眼前犹有落花铺。\n只恐明朝，还并落花无。\n藤密全低户。\n桐高已出闾。\n新条嫩叶又将舒。\n染就窗间，浑是绿琴书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42191,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"少年游·闲庭","author":"陆震","text":"閒庭风雨晚来狂。\n沽酒正相当。\n花气清芬，空阶寂静，归去不须忙。\n从来富贵原无定，行乐有何妨。\n十万尊罍，三千曲调，豪爽少年场。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42192,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人·今宵","author":"陆震","text":"今宵明月当窗大。\n独有愁人坐。\n一般白昼也销魂。\n何必凄凉怕过是黄昏。\n多情原与多情忆。\n不为君颜色。\n若因颜色始相思。\n难道世间真个似君稀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42193,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人·郑克柔述梦","author":"陆震","text":"寻思百二河山壮。\n更蹠莲峰上。\n那能牖下死勾留。\n恨煞尘缘欲脱苦无由。\n故人一觉荒唐甚。\n娓娓殊堪听。\n君还有梦到秦中。\n我并灞桥驴背梦俱空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42194,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一剪梅·和胡修来","author":"陆震","text":"三年音信隔关河。\n鱼也传讹。\n鸟也传讹。\n春残一棹远相过。\n江上风波。\n湖上烟波。\n可叹天涯鬓总皤。\n尔奈愁何。\n我奈愁何。\n绝无他物可消磨。\n诗是君多。\n酒是臣多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42195,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一剪梅·初度日作","author":"陆震","text":"少日飞腾愿颇赊。\n富也无加。\n贵也无加。\n鬓毛转眼不成鸦。\n霜点些些。\n雪点些些。\n事无一可向人誇。\n名也输他。\n利也输他。\n只馀清福让贫家。\n窗外梅花。\n窗里兰花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42196,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一剪梅·八月十四夜同刘叔裔玉带桥看月","author":"陆震","text":"酒酣真想策金鳌。\n欲上仙桥。\n且上河桥。\n何当更上玉楼高。\n万井烟消。\n万里云消。\n烂烂银盘挂碧霄。\n明见秋毫。\n圆欠分毫。\n阴晴天意最难料。\n料想来宵。\n胜似今宵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42197,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一剪梅·小窗","author":"陆震","text":"小窗雨歇绿全侵。\n半是桐阴。\n半是蕉阴。\n微风斜日坐孤吟。\n半是閒心。\n半是愁心。\n酒徒三五是知音。\n不是东寻。\n便是西寻。\n散时往往月都沉。\n不是杯深。\n便是谭深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42198,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天·题友人游黄山图","author":"陆震","text":"怪异幽深莫可穷。\n何年于此策孤筇。\n缘梯直蹑莲花顶，扪壁还登信始峰。\n眠醉石，抚龙松。\n一观云海荡心胸。\n今生未遂来生补，也到黄山白岳中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42199,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天·无题","author":"陆震","text":"多病多愁剩此身。\n眼前不觉又逢春。\n旧游乐事浑如昨，何处吹箫觅玉人。\n空有泪，暗沾巾。\n可怜月夕与花晨。\n别来细算无多日，一半娇容记不真。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42200,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天·客中春暮","author":"陆震","text":"花未开时客早归。\n花开惜又与春违。\n而今归去花虽好，已是飘零一半飞。\n风细细，雨霏霏。\n深悔劳人作事非。\n明年准拟花开日，多对花枝过几时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42201,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花·咏缠枝牡丹","author":"陆震","text":"弱蔓牵丝随处倚。\n晨起花开，婀娜东风里。\n未夕摧残还委地。\n笑伊琐琐朝菌耳。\n怪问芳名何太美。\n国色天香，嗟尔何堪比。\n花语主人无我忌。\n盗名世上原如是。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42202,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]