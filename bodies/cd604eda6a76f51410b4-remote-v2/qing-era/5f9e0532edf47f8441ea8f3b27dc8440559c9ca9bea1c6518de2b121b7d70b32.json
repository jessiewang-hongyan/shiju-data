[{"title":"双调风蝶令/南歌子 戏有赠","author":"阚寿坤","text":"躲袖笼鸳钏，拖裙掩凤鞋。\n盘云半臂趁身裁，日换时新银鍊、与金钗。\n额发中年画，妍媸背面猜。\n等闲结伴步香街，傲说苏州两字、笑人呆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23869,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"双调忆王孙","author":"阚寿坤","text":"满地红飞成画景。\n馀别院、短柯风冷。\n化工不肯弃零缣，也抹上、胭脂粉。\n春来酣处归期紧。\n听一夜、小楼雨阵。\n子规生怕看花迟，特唤起、春眠醒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23870,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卜算子 联句","author":"阚寿坤","text":"作也如何爱。\n读也如何爱。\n读也忙忙作也忙，忙里闲工在。\n在也由人会。\n会也由人再。\n再添会处会逾多，多亦忙何碍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23871,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一叶落","author":"阚寿坤","text":"一叶落。\n桐荫薄。\n女牛不语挂檐角。\n鹊桥几日成，银河添波阔。\n添波阔。\n不巧云何乐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23872,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沁园春 悯鹤，恭呈家大人","author":"阚寿坤","text":"鸣亦依人，食亦依人，舞更态妍。\n溯来从沧海，青霄梦隔；调经仙吏，碧眼绿牵。\n此日供粮，他年作骥，君亦何嫌琴棹间。\n三年矣，忽营巢育子，惹病魔缠。\n林泉莫可供眠。\n便迫致、肝肠馀憾添。\n叹朅来归去，迹离华表，数同尸解，羽化吴天。\n六友名山，华阳真逸，瘗鹤风流相后先。\n痴儿女，拟葬经图说，聊附铭镌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23873,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"摸鱼儿 秋夜","author":"阚寿坤","text":"问西风、甚时吹紧，催将鸿雁声悄。\n菊花拌坼重阳蕊，凉夜月圆天小。\n炉篆袅。\n晕一缕仙云，不碍飞琼笑。\n莺烦燕恼。\n道辜却韶光，传来冷信，逐渐岭梅早。\n谁家院。\n箫韵凄眠度晓。\n声声心事缠搅。\n丹凝禅悟寻常耳，还是文园幽妙。\n闲自料。\n烟云幻繁华，转眼成秋草。\n朱颜未老。\n正力避吴霜，冬馀强饭，竹素浣尘抱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23874,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"吴兰畹","text":"杜鹃啼遍枝头血。\n伊人惆怅关山别。\n不信见时难。\n深宵灯影寒。\n欲归归不得。\n耿耿还相忆。\n相忆转相怜。\n离愁年复年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23875,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"吴兰畹","text":"丁香双绾同心缕。\n绿窗燕子呢喃语。\n萱草满庭芳。\n难将忧暂忘。\n绣帘垂永昼。\n篆缕销金兽。\n残梦记难真。\n匆匆日又曛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23876,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长亭怨慢 柳线","author":"吴兰畹","text":"是一段、天涯愁绪。\n绿遍东风，未飘香絮。\n倩影毵毵，陌头摇碎几丝雨。\n送人多矣，休软逐、红尘舞。\n愿绾住春光，奈惹得、花飞无主。\n莫误。\n怕柔痕剪断，错认玉关歧路。\n高楼日暮。\n算蓉镜、翠眉生妒。\n忍看那、尽意缠绵，把无数、闲愁牵住。\n听几处、笛声如怨，寸肠千缕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23877,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"壶中天慢 送春","author":"吴兰畹","text":"深深庭院，正绿肥红瘦，几番梅雨。\n九十韶光都过了，引起离思千缕。\n燕语添愁，莺声做暖，无计留春住。\n依稀梦醒，谁将心事低诉。\n回首芳草天涯，王孙去也，消息知何处。\n难道东风真有脚，踏碎落红无数。\n豆蔻歌残，蔷薇香冷，寂寞扃朱户。\n匆匆一别，添人多少情绪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23878,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"贺新郎","author":"吴兰畹","text":"已是伤离别。\n更那堪、风风雨雨，助人凄切。\n宝鼎香寒银烛暗，远梦迷离难觅。\n听破晓、流莺声滑，似说金门人待漏，负香衾、一样工愁绝。\n身千里，寸心折。\n天涯驿使迟消息。\n倚栏杆、腰肢盈握，祗应自惜。\n三五良宵团圞影，相对可怜遥夕。\n算只有、啼痕凝碧。\n目极苍茫云树外，料鞭丝、空袅斜阳陌。\n魂消处，共谁说。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23879,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤凰台上忆吹箫 秋夕","author":"吴兰畹","text":"凉魄孤悬，暗虫低诉，纱笼篆缕空凝。\n正鹤寥琴寂，絮语馀温。\n又是商飙做冷。\n声声雁，凄断湘滨。\n阑干倚，新愁旧梦，付与诗魂。\n青青。\n镜中鬓影，瘦损一丝丝，晕上秋痕。\n只药炉茶鼎，静伴寒灯。\n多少腻红剩绿，恁耐得、风雨朝昏。\n晶帘悄，微吟浅醉，莫道酸辛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23880,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 即景","author":"王梦兰","text":"剪剪春寒，绿杨如梦花如笑。\n数声啼鸟。\n帘幕东风峭。\n九十韶光，一半空过了。\n闲吟啸。\n夕阳芳草。\n到眼添诗料。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23881,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 送春","author":"王梦兰","text":"满地榆钱，笑伊难买春光住。\n落花飞絮。\n脉脉添愁绪。\n春去春来，试问归何处。\n垂杨树。\n几番烟雨。\n绿遍江南路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23882,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 水仙花","author":"王梦兰","text":"倩影疏香，二妃微步潇湘渚。\n凌波容与。\n缟袂迎风举。\n仙骨珊珊，耐得风霜妒。\n邀花语。\n留花小住。\n结个消寒侣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23883,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 桂花","author":"王梦兰","text":"清露洗晨妆。\n金粟初黄。\n广寒分种向雕廊。\n携手试来花下立，袖惹天香。\n翠叶拂银床。\n占断秋光。\n一枝亲折赠檀郎。\n他日宫花探上苑，一样芬芳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23884,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卜算子 秋夜即事","author":"王梦兰","text":"长昼苦无聊，又是黄昏后。\n沐罢兰汤试晚妆，难展眉峰皱。\n深院掩重门，人比黄花瘦。\n新月娟娟上画栏，故照人怀袖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23885,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卜算子 志感","author":"王梦兰","text":"生小弄聪明，反被聪明误。\n一寸蕉心束万重，惯惹闲愁绪。\n休咏白头吟，不喜伤心句。\n愿化金炉一缕烟，宛转成灰炷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23886,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 春晚口占","author":"王梦兰","text":"一声百舌啼金井。\n海棠枝上燕支冷。\n小院燕双飞。\n湘帘镇日垂。\n薄寒轻似水。\n慵把阑干倚。\n墙角杏花残。\n临风翠袖单。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23887,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令","author":"钱启缯","text":"风。\n燕子归来绣幕中。\n清香送，习习小楼东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23888,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉花阴 夜坐","author":"钱启缯","text":"庭院沉沉春欲暮。\n点滴芭蕉雨。\n宝篆已香销，默对孤灯，总是无情绪。\n海棠红褪花无语。\n又春深如许。\n燕子未归来，悄立黄昏，帘幕低垂处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23889,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"画堂春 纳凉","author":"钱启缯","text":"好风冉冉藕花香。\n流萤飞去还藏。\n花边月影水边光。\n行到池塘。\n一曲瑶琴人倦，三更玉漏宵长。\n梧桐露滴趁秋凉，检点诗囊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23890,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"豆叶黄 夜雨","author":"钱启缯","text":"丁冬玉漏又三更。\n雨滴檐铃不耐听。\n小坐无人掩画屏。\n听声声。\n点滴空阶直到明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23891,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人影 夜坐","author":"钱启缯","text":"纱囊闲把流萤弄。\n风过微微齐拢。\n蓦地一声箫送。\n惊破清宵梦。\n夜凉天气轻云笼。\n犹见冰轮徐捧。\n帘外落花微动。\n但觉蚊雷拥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23892,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渔家傲 夏日","author":"钱启缯","text":"六月荷花香十里。\n三秋桂子醉难倚。\n风过新蝉声细细。\n听归雁，呼环莫把纱窗闭。\n帘捲落花疑蝶视。\n阶前络纬初鸣际。\n凭栏笑把轻纨启。\n看青天，■香一缕随风至。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23893,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 避暑","author":"钱启缯","text":"薰风至，夏日正无聊。\n帘押不开消酷暑，窗前绿影美人蕉，对此碧天遥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23894,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 寒食偶题","author":"钱启缯","text":"花怯雨，绿漾柳含烟。\n杜宇声声啼晓月，黄鹂对对带春妍，爱此养花天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23895,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 暮春","author":"钱启缯","text":"春柳拂，遥见小桃红。\n隔岸杨花看白糁，中庭鸟语觉春融，闲倚画墙东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23896,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 春雨","author":"钱启缯","text":"深夜静，闲坐小窗前。\n雨滴芭蕉人不觉，风吹翠竹各芬妍，正值养花天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23897,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南","author":"钱启缯","text":"春烂漫，夜景夕阳斜。\n小立苔前遥望远，花枝芳拂柳枝遮，对此兴偏赊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23898,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一斛珠 七夕","author":"钱启缯","text":"绮筵瓜果。\n今宵乞巧中庭坐。\n画屏秋冷云深锁。\n小扇轻罗，点点飞萤火。\n亚字栏低斜月过，露花浓滴花枝亸。\n鹊桥度处轻云破。\n离别经年，泪洒珍珠颗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23899,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令","author":"袁毓卿","text":"梦压鸾衾初醒。\n睡起玉钗慵整。\n门掩篆香残，斜日画堂人静。\n风紧。\n风紧。\n吹皱一帘花影。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23900,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"朝中措","author":"袁毓卿","text":"落红庭院晚妆残。\n微雨酿轻寒。\n柳色黄拖金缕，苔痕绿上雕栏。\n韶华荏苒，音书迢递，情绪阑珊。\n却怪东风无力，不将花信催还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23901,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人 残菊","author":"袁毓卿","text":"几番采撷东篱畔。\n秋老无人院。\n祡桑酒醒月昏黄。\n剩有清标偏耐、晓来霜。\n明年秋色知何许。\n岁月如驰去。\n西风萧瑟太无情。\n吹得空阶瘦影、不分明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23902,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 闻张总统国梁阵亡丹阳，寻即常州被困，感愤赋此","author":"袁毓卿","text":"烽火惊心，忽传遍、大江南北。\n叹上将、身经百战，烟尘未熄。\n按剑频挥忧国泪，仗韬痛咯椎心血。\n问江东，半壁更谁扶，空悲咽。\n乡关路，愁云积。\n军帅府，朋簪集。\n正莺喉竞巧，狼氛已逼。\n大树任从京口折，扁舟竟向吴门逸。\n痛孤城，一角囷重围，何堪说。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23903,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 题杨柳便面","author":"袁毓卿","text":"娇红稚绿天然丽。\n一般沉醉东风里。\n莫漫倚新妆。\n纤腰尔许长。\n眉痕青琐琐。\n睡起情无那。\n留得几多春。\n湘毫染未匀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23904,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南歌子","author":"袁毓卿","text":"秋老蛩吟急，天寒夜气清。\n一庭凤露静无声。\n不道月痕斜转、已三更。\n宝鼎香将烬，檐花影渐横。\n罗衾如水悄寒生。\n闲把迢迢莲漏、数分明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23905,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"高阳台","author":"袁毓卿","text":"细雨催花，嫩寒锁梦，醒来还带馀酲。\n倦试单衣，那堪又近清明。\n云屏寂寞秋千冷，早啼残、窗外流莺。\n怕梁间，燕子归来，蹴损红英。\n愔愔天气昏昏过，正枌榆社散，烽火心惊。\n赋到江南，谁怜萧瑟兰成。\n柳绵不管华生换，尚依然、扑向帘旌。\n更消魂，画遍阑干，添倍凄清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23906,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 自感","author":"胡凯似","text":"最是伤情，催人去、马蹄车辙。\n触目处、纷来愁绪，云山万叠。\n石咽泉呜幽涧底，树枯干卧斜阳侧。\n问此行，何日赋归来，难预决。\n计往事，浮云灭。\n满怀恨，凭谁说。\n听杜鹃枝上，声声啼血。\n顾我堪嗟如去雁，思家不敢看明月。\n把闲愁，勾却发狂歌，随圆缺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23907,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 感怀","author":"胡凯似","text":"娇养膝前身。\n远嫁辞亲。\n不堪重忆昔时情。\n忽见帘栊新月色，触动乡心。\n此际暗伤神。\n别恨纡萦。\n金炉香烬漏沉沉。\n底事愁怀消未得，欲诉谁听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23908,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梦江南 初夏有怀","author":"胡凯似","text":"还记否，剪烛夜深时。\n倚槛闲吟添对月，联床话雨杂敲棋。\n回首漫相思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23909,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梦江南","author":"胡凯似","text":"还记否，烹茗晚凉天。\n倩影已和花太瘦，离愁犹抱梦孤悬。\n江北又经年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23910,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇","author":"张逸藻","text":"枝上俱空，堆阶重叠花无数。\n榆钱满树。\n难买春光住。\n杜宇频啼，乱舞长空絮。\n风和雨。\n送春归去。\n毕竟归何处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23911,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令","author":"张逸藻","text":"愁比乱丝常绊。\n心共芭蕉不展。\n屈指几分秋，落叶又惊秋晚。\n休算。\n休算。\n秋不抵愁一半。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23912,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙","author":"张逸藻","text":"倦眼慵开半未醒。\n云鬟低压玉钗横。\n朦胧扶枕不分明。\n破梦有声风着力，惜花留影月多情。\n夜深无语立银屏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23913,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一半儿令","author":"陈作芝","text":"昨宵急雪逐风斜。\n玉树堆成顷刻花。\n晓起侍儿声忽哗。\n日烘他。\n一半儿存留，一半儿化。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23914,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令","author":"陈作芝","text":"镇日莺娇燕懒。\n春色二分谁管。\n晓起倚栏杆，一树碧桃香满。\n消遣。\n消遣。\n花气将人薰软。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23915,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令","author":"况桂珊","text":"静对书灯如豆。\n一晌跳珠雨骤。\n雨过嫩凉生，云破月来还又。\n生受。\n生受。\n照得纸窗清透。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23916,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"金缕曲","author":"黄馥","text":"花事探幽坞。\n出城闉、江流清浅，暗香微渡。\n官阁宾僚诗兴动，爱比甘棠万树。\n恰雪蕊、霜葩初吐。\n空际月明频对影，伴癯仙、别有闲风度。\n有同调，广平赋。\n去年此际寻春去。\n算花期相思，隔岁卿应记取。\n纸帐重寻罗浮梦，梦醒惟闻翠羽。\n望迢递、江南归路。\n却笑漫山桃李俗。\n岁寒盟、祗许松筠侣。\n愿偕隐，吾与汝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23917,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙","author":"曲茝纕","text":"明月渐西沉。\n墙转花阴。\n一天秋思起愁心。\n十二阑干闲倚遍，脉脉思寻。\n怪底怕调琴。\n夜色愔愔。\n却怜尘世少知音。\n回首几多惆怅事，雨旧云今。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23918,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减兰 和黍芗词韵","author":"曲茝纕","text":"茫茫烟水。\n江上芙蓉偏易萎。\n月暗灯昏。\n叶落西风响到门。\n无端惹恨。\n塞雁惊秋传远讯。\n镜影明明。\n愁锁双蛾画不成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23919,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行","author":"冒文蘅","text":"浣月亭高，映江楼古。\n湖山蕴籍供裁句。\n欲寻陈迹认南朝，新词吟到西泠路。\n香润兰丛，影留桐絮。\n联吟更有神仙侣。\n玉窗想得静拈毫，浓青不捲疏帘雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23920,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子 春归","author":"叶静宜","text":"啼鹃唤了春归去，风也凄凄。\n雨也凄凄。\n一任残花落又飞。\n韶华在眼轻消遣，莺也依依。\n燕也依依。\n几度留春春竟归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23921,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南歌子 暮春","author":"叶静宜","text":"青帝留难住，金铃护不胜。\n落花飞絮怨飘零。\n试听燕莺都作断肠声。\n风雨年年恨，闲愁日日萦。\n绿章无路乞通明。\n辜负养花天气惜花情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23922,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 绿蝴蝶","author":"叶静宜","text":"省识园蔬叶二分。\n仙踪幻出碧罗裙。\n小青莫不是前身。\n扑向花丛浑似叶，倦栖芳草梦无痕。\n绿天深处认难明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23923,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西江月 秋夜","author":"叶静宜","text":"何处吹箫庭榭，谁家读曲帘栊。\n画楼西畔桂堂东。\n深夜露浓香重。\n绕砌虫声唧唧，映阶月色融融。\n一年容易又秋风。\n可惜流光似梦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23924,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"重叠金 和筠友大姊韵","author":"叶静宜","text":"晓莺啼破辽西梦。\n重帘不卷钩幺凤。\n满院落花红。\n深宵一夜风。\n风风还雨雨。\n陌上垂杨舞。\n小病怯轻寒。\n生憎罗袖单。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23925,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋夜月 本意","author":"叶静宜","text":"玉钩初上帘旌。\n夜云轻。\n寂寞梧桐深院、月华明。\n团圞影。\n清辉冷。\n恁无情。\n底事年年圆缺、更阴晴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23926,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江城子 春暮偶成","author":"叶淡宜","text":"雨丝风片做春寒。\n怕春残。\n竟春残。\n飞絮飞花，飘泊太无端。\n伤了司勋心一片，无限恨，倚栏杆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23927,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"百字令 题一奁吟","author":"叶淡宜","text":"镜台无恙，忽一霎尘生，音容顿绝。\n今古伤心遗例在，自是解人难得。\n恨海空填，情天莫补，辜负如椽笔。\n红笺吟遍，返生香总乏术。\n未知底事干侬，读君诗罢，宛转愁无极。\n一往情深谁遣此，岂独销魂醉骨。\n词述黄门，神伤奉倩，哀思应绵结。\n斯文斯恨，天长地久不灭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23928,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 春晓","author":"叶淡宜","text":"卖花声早惊残梦。\n妆台闲理衔珠凤。\n窗透曙光红。\n吹来杨柳风。\n隔帘鸠唤雨。\n紫燕穿帘舞。\n春去尚馀寒。\n春衫白袷单。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23929,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 初夏饯别张表婶母","author":"叶淡宜","text":"风动帘旌响玉珂。\n青衫初换曲尘罗。\n日长天气乍清和。\n昨夜饯春梅子雨，今朝送客柳枝歌。\n一生赢得别愁多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23930,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"小庭花 月夜","author":"叶淡宜","text":"十二疏栊卷绮寮。\n青天碧海望迢迢。\n金荷银烛漫高烧。\n独对寒光清不寐，倚栏闲谱一枝箫。\n夜深凉露湿冰绡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23931,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"柳梢青 寒食","author":"叶翰仙","text":"风捲帘旌。\n人凭曲槛，燕语雕楹。\n扑蝶时过，踏青期近，何日新晴。\n雨馀花满春城。\n望几处、朱门柳萦。\n最好韶华，今朝寒食，明日清明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23932,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]