[{"title":"一叶落 秋闺","author":"吴绮","text":"一叶落，黏珠箔。\n青蛾夜半伤离索。\n叶离春更生，人离尽虚约。\n尽虚约，前事思量错。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35675,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸳鸯绮 早春","author":"吴绮","text":"小栏杆。\n倚近百花寒。\n只被东风觉。\n吹人衣袖单。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35676,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梧桐影 人未归","author":"吴绮","text":"人未归，春将半。\n小玉娇憨妒燕儿，押帘早放黄金蒜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35677,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西楼梦 其一 妆懒","author":"吴绮","text":"妆懒，妆懒，拥髻慵开镜。\n楼前花发双枕闲，玉儿只为春寒病。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35678,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西楼梦 其二 明月","author":"吴绮","text":"明月，明月，直入秦楼里。\n蛾眉夜半不能眠，开窗坐把银筝倚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35679,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西楼梦 其三 斜照","author":"吴绮","text":"斜照，斜照，一半红珠幌。\n归来双燕语黄昏，离愁又在江楼上。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35680,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西楼梦 其四 明月","author":"吴绮","text":"明月，明月，一片多情影。\n当楼照入碧纱厨，美人微醉才微醒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35681,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"凭栏人 其一 陌上","author":"吴绮","text":"陌上花开烟景稠，折得花枝红在手。\n将花却自羞。\n惹东风，吹不休。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35682,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"凭栏人 其二 本意","author":"吴绮","text":"何处江帆载夕阳，十幅蒲帆一半黄。\n高楼倚暮妆。\n望天涯，云水长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35683,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"碧窗梦 杨柳","author":"吴绮","text":"杨柳将烟细，梨花着月明。\n玉人忍泪按银筝，低语没人听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35684,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"十六字令 其一 春","author":"吴绮","text":"春。\n才到深闺便泥人。\n花知道，一点要温存。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35685,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"十六字令 其二 情","author":"吴绮","text":"情。\n不识他从何处生。\n相逢处，但觉惹人疼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35686,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"花非花 离情","author":"吴绮","text":"月方沉，天将曙。\n梦不成，留莫住。\n楼中无数可怜人，江南尽种相思树。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35687,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"解红儿 忆别","author":"吴绮","text":"白头鸦，花冠鸡。\n未明都向枕边啼。\n为报东风太狼籍。\n花落尽，玉窗西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35688,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜春来 有见","author":"吴绮","text":"一湾绿水花遮路，朱栏人倚楼。\n娇憨不肯下帘钩。\n莫转头，新月半天愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35689,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"归自谣 其一 归忆","author":"吴绮","text":"深院静。\n风飐落花红不定。\n墙东月下秋千映。\n玉骢一去成孤零。\n愁谁证。\n说来但与鹦哥听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35690,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"归自谣 其二 寒食","author":"吴绮","text":"一百五。\n多少龙蛇原上土。\n棠梨风急红无主。\n朝来寂寞轻烟缕。\n垂杨舞。\n秋千挂在莺啼处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35691,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"相见欢 其一 春闺","author":"吴绮","text":"垂杨绿到阑干，又春残。\n看尽一庭花雨小红悭。\n凭画槛，抛绣帖。\n梦无闲。\n检取近来双袖泪痕斑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35692,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"相见欢 其二 吴兴感事","author":"吴绮","text":"西风落日登台，眼重开。\n无数绕城山色送青来。\n古今事，吴越地，几雄才。\n一片项王马埒乱云堆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35693,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"相见欢 其三 去来","author":"吴绮","text":"去来来去匆匆，可怜侬。\n惆怅谢家明月小亭中。\n何处见，谁为辨，梦无踪。\n那得燕儿衔出一春红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35694,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"相见欢 其四 别梦","author":"吴绮","text":"半窗残月朦胧，画桥东。\n梦里那人愁坐小屏风。\n空惹恨，难觅信，恨匆匆。\n待把别情珍重托归鸿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35695,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长相思 其一 夜坐","author":"吴绮","text":"花一窗，月一窗。\n酒醒西斋闻暗香。\n黄梅初破霜。\n琴声长，漏声长。\n绿浅庭莎鹤梦惊。\n怀人字半囊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35696,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长相思 其二 舟夜","author":"吴绮","text":"盼行程，数行程。\n秋满江湖客自惊。\n滩声杂雨声。\n话难凭，梦难凭。\n水驿人稀错报更。\n荒鸡不肯鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35697,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉太平 其一 悠然阁偶题","author":"吴绮","text":"波光半城，花阴一庭。\n秋山万朵青青，作南窗画屏。\n癫狂酒兵，萧疏墨卿。\n吾师只爱渊明，采东篱菊英。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35698,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉太平 其二 吴兴","author":"吴绮","text":"空亭鹤雏，空床蠹鱼。\n诗瓢酒盏茶炉，是湖中薄书。\n郎真漫乎，翁真醉欤。\n樊川逸少眉苏，结烟波钓徒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35699,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉太平 其三 题醉仙图为念因寿","author":"吴绮","text":"颠耶其仙。\n圣耶贤人。\n人间龌龊堪怜，向醉乡且眠。\n歌乎有弦，吟乎有笺。\n糟邱长据千年，其谁曰不然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35700,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉太平 其四 放歌","author":"吴绮","text":"灯前翠蛾，花前绿螺。\n人间明月无多，任先生去波。\n翟家雀罗，张家凤窠。\n生平得失如何，和香山放歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35701,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉太平 其五 偶作","author":"吴绮","text":"相思可怜，离情漫传。\n断肠准拟今年，在云边水边。\n青帘画船，红灯翠弦。\n半生潦倒依然，为花颠酒颠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35702,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉太平 其六 题抱膝看云图","author":"吴绮","text":"河山眼前，云霞足边。\n故乡一望依然，彼黄冠者仙。\n匆匆两丸，苍苍九烟。\n白衣变幻堪怜，向南阳且眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35703,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感恩多 看美人卧","author":"吴绮","text":"霞敛红窗晓，屈戌黄金小。\n鹦鹉莫惊猜，报人来。\n偷觑屏山深处，有人眠有人眠。\n倦眼惺忪，压衾花半边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35704,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春光好 其一 苕川偶题","author":"吴绮","text":"随柳絮，拂榆钱。\n冶游天。\n欲问水嬉何处，五湖边。\n醉里题将罗扇，归来恰得金钿。\n走马碧鸡人莫笑，海棠颠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35705,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春光好 其二 迎春","author":"吴绮","text":"春来也，是何时，没人知。\n先到玉儿头上，袅花枝。\n十二画楼帘捲，红妆笑语参差。\n争向彩幡成队，看朱衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35706,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春光好 其三 立春","author":"吴绮","text":"朱阁丽，彩幡轻。\n好风生。\n万树梅花一夜明，晓来晴。\n锦爆抛残寒色，瑶笙吹出新声。\n画屧印将琼屑碎，满江城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35707,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"生查子 同顾庵次淡心韵","author":"吴绮","text":"淼淼白苹洲，认得吴兴路。\n不见水嬉人，密叶青如雨。\n行春复几时，紫马寻花去。\n谁有惜春心，寒食随侬住。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35708,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一痕沙/昭君怨·元宵感事 其一","author":"吴绮","text":"记得去年时节，烂醉红灯白雪。\n今日又离家，见梅花。\n无限西州旧事，独剩江山如是。\n老却眼中人，奈何春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35709,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一痕沙/昭君怨·元宵感事 其二 记事","author":"吴绮","text":"记得鹊桥时候，小饮绿窗红瘦。\n旧约忽蹉跎，泪痕多。\n三十六陂秋色，何处问他消息。\n两地好相思，没人知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35710,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一痕沙/昭君怨·元宵感事 其三 广陵怀古","author":"吴绮","text":"满地西风黄叶，冷却二分明月。\n可惜好雷塘，任牛羊。\n飞尽隋堤柳絮，歌吹不知何处。\n闲煞古扬州，梦青楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35711,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一痕沙/昭君怨·元宵感事 其四 惠山有见","author":"吴绮","text":"可是天台伴侣，家住碧云深处。\n一笑出鸾纱，认桃花。\n怕被罡风吹着，仙帔香笼红药。\n郎是几时来，绣帘开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35712,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"太平时 其一 无题","author":"吴绮","text":"罗衾横裹一床，枕痕知。\n些些情事费寻思，暖香时。\n五鼓衣裳三鼓月，去来迟。\n伤心休唱竹枝词，比红儿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35713,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"太平时 其二 题前山欲雨图","author":"吴绮","text":"春到江南柳花多，曲尘波。\n刘郎浦口唱渔歌，好婆娑。\n一片前山刚泼墨，晚云拖。\n呼儿料理旧青蓑，看如何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35714,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇 其一 春情","author":"吴绮","text":"几度莺啼，垂杨绿了千千缕。\n玉骢人去，滴尽西窗雨。\n扑损菱花，金粉都无绪。\n相思处，无情山色，遮却多情路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35715,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇 其二 烟雨楼次史邦卿过西泠桥头","author":"吴绮","text":"烟水无情，当年曾照朱楼影。\n鸳鸯飞尽，有梦如天回。\n红藕花残，桃叶歌声冷。\n萍无定，萧萧短鬓，白发羞明镜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35716,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇 其三 咏蝶次宏载韵","author":"吴绮","text":"柳雨桃烟，英台尚记生前景。\n去来相并，艳杀罗裙影。\n絮粉茸金，眉眼从来靓。\n红珠冷，花房睡醒，相逐过金井。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35717,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇 其四 咏蝉","author":"吴绮","text":"素緌高嘶，半生赢得风和露。\n槐朝柳暮，占断青青树。\n抱叶吟条，似向行人诉。\n愁无数，不堪听处，六代斜阳路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35718,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇 其五 咏蟋蟀","author":"吴绮","text":"秋到庭除，不知何事须频说。\n做成悲切，诉向凄凉月。\n断础颓垣，似为愁铺路。\n声无歇，苔花如雪，点点秋棠血。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35719,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇 其六 南昌寓楼见周屺公题壁依韵和之","author":"吴绮","text":"一派波声，片帆吹过鄱阳雨。\n晚霞收暑，是我登楼处。\n浪迹天涯，事事浑无绪。\n何时去，往年西浦，酹酒同怀古。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35720,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇 其七 老梅根","author":"吴绮","text":"诘屈虬根，暗香疏影何年得。\n广平铁石，先有春消息。\n几点寒英，用尽东风力。\n谁曾识，冶传南国，雪老莓苔碧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35721,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇 其八 咏素馨花灯","author":"吴绮","text":"春散蛮天，珠江处处都如雪。\n彩丝谁缬，砌作团圆月。\n风蜡高悬，薰得浓香彻。\n罗帏揭，芳心犹热，情在香难歇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35722,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉花间 其一 春闺","author":"吴绮","text":"思时候，忆时候。\n时与春相凑。\n把酒嘱东风，种出双红豆。\n鸦啼门外柳，逐渐教人瘦。\n花影暗窗纱，最怕黄昏又。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35723,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉花间 其二 望家信不至","author":"吴绮","text":"扬州水，赣州水。\n雪浪千千里。\n鱼不解衔书，空跃黄金尾。\n灵氛虚报喜，许我平安纸。\n寒灯亦见欺，花鹯鹦哥嘴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35724,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其一 有感","author":"吴绮","text":"吴苑青苔销画廊，汉宫垂柳映红墙。\n教人愁杀是斜阳。\n天上无端催晓暮，人间何事有兴亡。\n可怜燕子只寻常。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35725,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其二 春情","author":"吴绮","text":"南浦轻烟蘸碧波，西泠油壁少经过。\n锁窗独自画青蛾。\n泪点渐同花片落，情丝长似柳条多。\n镜中金翠奈春何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35726,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其三 客怀","author":"吴绮","text":"摇落关河懒问津，扁舟万里送孤身。\n乱山秋色又斜曛。\n江上怕逢吹笛客，月中难作倚楼人。\n可怜愁杀鲍参军。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35727,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其四 无题次友人韵","author":"吴绮","text":"欲起偏生恰坠钗，临行那得更兜鞋。\n教人怜处且徘徊。\n江水无情桃叶去，春风有约柳枝来。\n漫抛红泪被人猜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35728,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"霜天晓角 雪后夜登爱山台","author":"吴绮","text":"孤台雪霁，雪月光相泥。\n把似大罗天阙，天上全无地。\n此时双鹤泪，弄花梅吐气。\n明日头衔须换，直写水晶宫吏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35729,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"酒泉子 春夜","author":"吴绮","text":"花影夭邪，晴月照人今夜。\n罗窗半展泪痕斜，有些些。\n巫山欲梦楚云遮，绣被香寒宫麝。\n隔墙闻响七香车，是谁耶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35730,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其一 忆远","author":"吴绮","text":"天涯何处，芳草砌成肠断路。\n欲寄离愁，怕听征鸿不倚楼。\n琴慵酒懒，柳絮榆钱春渐晚。\n拼是凄凉，夜夜灯花瘦影长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35731,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其二 湖光","author":"吴绮","text":"湖光夜彻，飞上小楼都化月。\n人似梅花，烂醉孤山处士家。\n梦云飘渺，起傍玉兰花影悄。\n燕子多情，偷得纱橱细语声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35732,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其三 饮家伯成署中","author":"吴绮","text":"官斋清暇，容我疏狂倾翠斝。\n晴月如霜，晒破檀梅一萼黄。\n烧残画烛，把酒清谈人似玉。\n来日扬舲，回首龙山眼共青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35733,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其四 赠鼓爰琴","author":"吴绮","text":"燕山匹马，携手河梁人去也。\n此地相逢，隋苑秋声百尺桐。\n绿幺红豆，一曲新词花影瘦。\n自是彭宣，曾向扶风听管弦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35734,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其五 题何奕美小照","author":"吴绮","text":"传神阿堵，此是何郎须认取。\n莫浣征衫，嵇绍当年血尚斑。\n树犹如此，百尺亭亭谁可拟。\n赋就新诗，东阁梅花又一枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35735,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其六 题尤悔庵清平调杂剧","author":"吴绮","text":"仙才供奉，岂籍寻常科第重。\n失却珊瑚，只笑唐家结网疏。\n知君寄托，扫尽里儿容做作。\n烂醉沉香，此后谁堪七宝床。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35736,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其七 凤条清露","author":"吴绮","text":"凤条清露，满地绿云苍藓护。\n若有人兮，冰雪文章手自携。\n玉山如照，此日洛阳人正少。\n夜梦凌风，好入天门第八重。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35737,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其八 树兰","author":"吴绮","text":"家原幽谷，自别湘沅非旧族。\n叶叶枝枝，婀娜江城玉露时。\n灵均漫采，根蒂虽殊香未改。\n金粟前身，那用朝衣侍女薰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35738,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其九 鹧鸪","author":"吴绮","text":"元黄绣羽，未到炎荒先见汝。\n与汝何干，闻道飞时尽向南。\n軥辀不息，人自欲行空费力。\n叫断江风，细雨寒烟苦竹丛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35739,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"添字昭君怨 其一 感事","author":"吴绮","text":"闻道青溪歌院，只剩兔葵一片。\n五更还响落花，景阳钟。\n寂寞白门杨柳，春思浑如中酒。\n鸳鸯飞尽莫愁湖，可怜无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35740,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"添字昭君怨 其二 春寒","author":"吴绮","text":"落尽梨花时候，寒到将残更陡。\n添衣偏觉画罗单，是今番。\n几夜睡来难稳，却恨东皇心狠。\n明欺绣被半床空，是东风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35741,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其一 离心","author":"吴绮","text":"离心夜共灯花碎，罗衾倒盖何曾睡。\n不肯过西窗，空楼月影黄。\n分明曾梦见，犹是相隈恋。\n猛地被风惊，吹来雁一声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35742,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其二 和悔庵","author":"吴绮","text":"江都不似开皇好，牛羊横卧雷塘草。\n伍员但吹箫，霜痕断板桥。\n田家无幸舍，踟躇秋捧下。\n服食学淮南，水精何用盐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35743,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其三 离心","author":"吴绮","text":"西风吹醒春婆梦，无端又作参军弄。\n朱户倚云高，藜羹似七牢。\n占蓍同得履，北道谁为主。\n买骏用金时，宁须谢眺诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35744,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"巫山一段云 其一 忆旧次宏载韵","author":"吴绮","text":"密意珊瑚带，深情翡翠卮。\n人前隐笑动蛾眉，娇多语故迟。\n为有愁中态，都成梦里思。\n当初错处也相宜，何况总宜时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35745,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]