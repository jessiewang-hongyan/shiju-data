[{"title":"减字木兰花•重过鸳水客楼","author":"彭孙遹","text":"鸳鸯湖畔。\n曾醉娇歌听翠管。\n湖雨湖烟。\n不见于今又几年。\n重来帆影。\n兰叶蘋花秋色净。\n题句空留。\n行里尘生水面楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42345,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•京口遣信南归，因题书尾 其一","author":"彭孙遹","text":"绣衾孤拥春寒峭。\n窗前小玉迎人笑。\n报道远人回。\n郎君有信来。\n循环都读遍。\n腹内车轮转。\n何日却归家。\n恹恹瘦损花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42346,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•京口遣信南归，因题书尾 其二","author":"彭孙遹","text":"中秋月落催兰棹。\n清明寒食逡巡到。\n青鸟纵传书。\n不归仍是虚。\n旧欢真似梦。\n毕竟功名重。\n含泪待归期。\n从头细问伊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42347,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•京口遣信南归，因题书尾 其三","author":"彭孙遹","text":"去年除夕兰缸下。\n熏香被酒更深罢。\n鸣指又嘉平。\n迢遥蓟北行。\n门庭清似水。\n泪滴鸳鸯被。\n夜夜捧心眠。\n何人著意怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42348,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•京口遣信南归，因题书尾 其四","author":"彭孙遹","text":"断红小颊芙蓉浅。\n檀痕新渍香襟暖。\n雁字下平芜。\n还胜雁也无。\n情知归不得。\n不是轻抛掷。\n寄语好加餐。\n春来风雨寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42349,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•除夕，阮亭广陵署中守岁","author":"彭孙遹","text":"节序惊心残腊尽。\n同云襞雨寒犹紧。\n小暖逼炉烟。\n江春入旧年。\n芳柑传绮席。\n好事过除夕。\n香雪动园梅。\n春回人未回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42350,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•闺情","author":"彭孙遹","text":"画檠朱烬花如雨。\n当窗手弄春莺语。\n半面最宜人。\n屏山一线痕。\n十重缃绮被。\n赤翡交青翠。\n生小怯孤眠。\n郎衣手自牵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42351,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•春愁","author":"彭孙遹","text":"平芜南浦萋萋碧。\n殷勤别泪红巾湿。\n花信半摧残。\n高楼箫管闲。\n金猊空自爇。\n不解鸳鸯结。\n何物似相思。\n相思无尽时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42352,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•春寒","author":"彭孙遹","text":"夜寒酒薄眠初觉。\n一钩残月悬楼角。\n小篆冷香筒。\n香煤半粟红。\n垂帘还涉想。\n髣髴金钗响。\n数尽短长更。\n东方不肯明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42353,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•暮秋闺思","author":"彭孙遹","text":"层波不转眉山蹙。\n有人倚遍阑干曲。\n云洗碧天空。\n残阳雁背红。\n寒林烟冥冥。\n不见归帆影。\n望断又今朝。\n离魂脉脉销。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42354,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•楼眺","author":"彭孙遹","text":"一抹烟鬟青不了。\n遥天几点寒鸦小。\n落日挂帘钩。\n捲帘人倚楼。\n云帆何处度。\n目尽江南路。\n窈窕月华生。\n断肠今夜明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42355,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•题青溪遗事画册和阮亭韵 其一 乍遇","author":"彭孙遹","text":"南园粉絮漫天起。\n玉阑干外花阴里。\n初试薄罗衣。\n金蝉颤欲飞。\n无端郎蓦见。\n划袜轻风扇。\n惊起宿鸳鸯。\n裙拖绣一双。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42356,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•题青溪遗事画册和阮亭韵 其二 夜饮","author":"彭孙遹","text":"春檠双吐绯罗烛。\n文犀酒泛葡萄绿。\n袅袅洞箫声。\n牙娘按字清。\n投琼聊作戏。\n莫赚萧郎醉。\n今夜好秋光。\n月明衾枕凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42357,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•题青溪遗事画册和阮亭韵 其三 私语","author":"彭孙遹","text":"棠梨落尽花如雪。\n双双照影昏黄月。\n泓黛秀联娟。\n云鬟亚玉肩。\n凭阑罗袜倦。\n坐损春衫茜。\n小语怯听闻。\n娇波横觑人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42358,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•题青溪遗事画册和阮亭韵 其四 围棋","author":"彭孙遹","text":"湘兰九畹垂垂吐。\n雕笼巧唤红鹦鹉。\n长日试敲棋。\n娇慵落子迟。\n侬家誇好手。\n赌胜朱樱口。\n却敛细蛾儿。\n含羞欲悔时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42359,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•题青溪遗事画册和阮亭韵 其五 迷藏","author":"彭孙遹","text":"海棠开遍清和近。\n轻蝉低掠双文鬓。\n玉体藉花藏。\n花深珠露凉。\n青衣能暗逻。\n莫使窥人躲。\n人影堕高枝。\n玲珑月一丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42360,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•题青溪遗事画册和阮亭韵 其六 弹琴","author":"彭孙遹","text":"梧桐深院鸣秋叶。\n狄香小炷氤氲爇。\n玉指弄哀弹。\n琴心云水寒。\n园丝珠作串。\n字字含清怨。\n清怨寄三湘。\n眉峰九曲长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42361,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•题青溪遗事画册和阮亭韵 其七 窃听","author":"彭孙遹","text":"朱丝宛转垂银蒜。\n今宵底事抛针线。\n怪杀太风流。\n频频撼玉钩。\n千般轻簿个。\n可也羞灯火。\n渐觉麝兰微。\n画屏人欲迷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42362,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•题青溪遗事画册和阮亭韵 其八 读书","author":"彭孙遹","text":"小窗鲜碧凝修竹。\n窗前试展珠函读。\n日永静无人。\n风来散帙频。\n新妆娇半面。\n莫使悲团扇。\n纤月挂檐头。\n牙签索罢休。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42363,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•题青溪遗事画册和阮亭韵 其九 潜窥","author":"彭孙遹","text":"玄霜捣罢明于雪。\n褰帷人似婵娟月。\n何必怨羁雌。\n有人帘外窥。\n娇羞生不惯。\n惊避檀郎看。\n香汗玉肤潮。\n无声落凤翘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42364,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•题青溪遗事画册和阮亭韵 其十 叶子","author":"彭孙遹","text":"竹窗昼永清无事。\n南朝旧谱翻新思。\n奇正巧能兼。\n犀筹手自拈。\n郎休嗔叶子。\n叶叶郎相似。\n尽日掌中擎。\n欢情一纸轻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42365,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•题青溪遗事画册和阮亭韵 其十一 情外","author":"彭孙遹","text":"花梢豆蔻含春色。\n风狂雨骤相狼藉。\n懊恼锦屏空。\n胭脂满地红。\n诸姨偷觑着。\n调笑多轻薄。\n一曲后庭花。\n前身张丽华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42366,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮•题青溪遗事画册和阮亭韵 其十二 秘戏","author":"彭孙遹","text":"枕函腻脸明双玉。\n纤蛾接黛攒新绿。\n欢泪粉香垂。\n为郎忍片时。\n金铺横屈戍。\n皓腕频频觑。\n觑向蜡灯中。\n臂妆深浅红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42367,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"巫山一段云•雨窗与程村夜话","author":"彭孙遹","text":"岁月闲中老，容华暗里消。\n清槐好为系征舠。\n浓绿染长桥。\n听雨僧庐静，寻诗竹院遥。\n烛花落尽又频挑。\n不寝费兰膏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42368,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"巫山一段云•南谯道上","author":"彭孙遹","text":"暮火投山郭，朝寒过驿桥。\n江云一色秣陵潮。\n抹断蒋山腰。\n秋色低鸿雁，清霜急皂雕。\n汀芦沙苇冷萧萧。\n风雨入南谯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42369,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"巫山一段云•为侯大年赋催妆","author":"彭孙遹","text":"侯第珠为帐，金闺钿作车。\n水沉香炷博山炉。\n今夜极欢娱。\n顾影双龙镜，更衣百宝襦。\n画眉深浅入时无。\n笑指月生初。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42370,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳含烟•本意","author":"彭孙遹","text":"水驿下，戍楼前。\n寒食清明过也，淡烟疏雨落花天。\n恨绵绵。\n风起坝桥如雪。\n短叶长条堪折。\n一春只觉别离多。\n奈愁何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42371,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒金门•春梦","author":"彭孙遹","text":"春愁积。\n一片角声清急。\n天上佳期无信息。\n行云何处觅。\n静掩流苏帐额。\n还似见伊颜色。\n梦破五更风瑟瑟。\n纸窗凉月白。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42372,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"好事近•落叶","author":"彭孙遹","text":"一叶为谁飘，染就十分秋色。\n欲借江郎青管，赋闺中新什。\n小鬟石畔掬清泉，捧砚洗残墨。\n好向断红纹里，认玉人书迹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42373,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"金蕉叶•新月","author":"彭孙遹","text":"新蟾恰恰。\n转花梢、照人半霎。\n谁将明镜弹破，纤纤小指甲。\n又似人儿瘦怯。\n染轻云、犀梳倒插。\n朝来铅粉洗净，蛾黄露一掐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42374,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐•吴中柬寄百旃","author":"彭孙遹","text":"少年情绪。\n分付东流去。\n水上浮沤花上露。\n一霎蜉蝣旦暮。\n故人休问弹冠。\n心随云水同寒。\n觅得新来活计，笔床茶灶蒲团。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42375,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆秦娥•黄蔷薇","author":"彭孙遹","text":"清明近。\n好风初占蔷薇信。\n蔷薇信。\n脂轻粉薄，天然檀晕。\n夜来已觉春寒困。\n晓妆约略黄儿褪。\n黄儿褪。\n幽香一滴，露珠新揾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42376,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆少年•忆远","author":"彭孙遹","text":"闲来极目，朦胧不辨，江天云树。\n怀中数行泪，向何人弹与。\n日日潮回乌角渡。\n赶不上、萧郎行处。\n仙裙且休系，仗东风吹去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42377,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏子•五日","author":"彭孙遹","text":"展罗衣，宽宝缬。\n团就一窝香雪。\n珠箔下，画屏中。\n重施绣抹胸。\n梅雨溅，荷风扇。\n钗上翠符频颤。\n多少事，费沉吟。\n日长倦不禁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42378,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏子•午饮","author":"彭孙遹","text":"额妆轻，眉影细。\n发际瑩瑩光腻。\n收宝镜，炷沉烟。\n低头急绣缠。\n菖蒲碧，榴房赤。\n午酒中人无力。\n罗袂薄，晚风凉。\n幽兰被体香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42379,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"荆州亭•晚眺","author":"彭孙遹","text":"小阁愁来独倚。\n四合彤云垂地。\n若要不思乡，夜夜除非沉醉。\n酒后寒生半臂。\n著处牵萦人意。\n珍重旧罗巾，曾揾美人香泪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42380,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"甘草子•今夕","author":"彭孙遹","text":"春恨。\n耽过年时，今夕消除尽。\n花月也羞明，两两生娇晕。\n阶下绿茵青稳。\n合眼处、兰缣初褪，一啮文犀为伊忍。\n狂杀人风韵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42381,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"阮郎归•旅思","author":"彭孙遹","text":"院门花影锁重重。\n行云天外峰。\n梦魂吹去杳无踪。\n此时愁杀侬。\n风剪剪，月胧胧。\n春霜压被浓。\n万千心事霎时中。\n狂儿撼晓钟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42382,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"阮郎归•春晓","author":"彭孙遹","text":"灵扉谁焉捲仙旌。\n霞光透月棂。\n几回欲去又消停。\n朝寒不自胜。\n明镜启，晓篝轻。\n宫香分外清。\n依微花气满云屏。\n春禽无数声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42383,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"阮郎归•归思","author":"彭孙遹","text":"玉河官酒送行时。\n轻黄遍柳丝。\n仙桥认取再来期。\n花骢骄欲飞。\n人事换，岁华非。\n江云望眼迷。\n年年风雪满征衣。\n思归又怕归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42384,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"眉峰碧•春闺","author":"彭孙遹","text":"漫把重帘约。\n已觉朝寒略。\n春色原来一夜深，看桃李、参差发。\n红泪垂银蜡。\n烟缕青于发。\n午幕人声悄不闻，隔花细雨流莺滑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42385,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"眼儿媚•秋思","author":"彭孙遹","text":"空阶夜雨滴心头。\n凉雁过西楼。\n一行秋色，十分归思，万点离愁。\n自被浮名羁绊后，长似断蓬流。\n凄凄双杵，朦朦残月，渺渺孤舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42386,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"锦堂春•柬既庭","author":"彭孙遹","text":"涂辙正妨我辈，溪山合老狂夫。\n为报故人休复尔，钟鼓骇爰居。\n心已絮泥灰木，身拚月媵花奴。\n须知富贵非吾愿，遮莫执金吾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42387,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"桃源忆故人•社日","author":"彭孙遹","text":"平皋翠縠浓于染。\n一幅晴芜青茜。\n旧社酒徒零乱。\n添得红襟燕。\n扮榆往事还重见。\n窃炙归来春宴。\n人在樱桃庭院。\n今夜停针线。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42388,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"摊破浣溪沙•读高季迪缶鸣集","author":"彭孙遹","text":"何处登临忆侍郎。\n无边草树路微茫。\n依旧青丘湖下水，接东江。\n旧宅已随烟里没，遗编曾向箧中藏。\n叹息当时同辈少，压徐杨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42389,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"武陵春•和漱玉词，同阮亭作","author":"彭孙遹","text":"柳亸莺娇蜂蝶闹，春色满枝头。\n暮雨朝云不肯休。\n遮莫太风流。\n花满湘江波正绿，莫上木兰舟。\n若向湘江共舣舟。\n又添得、一般愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42390,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"武陵春•将游吴门。先寄家兄云客","author":"彭孙遹","text":"三月韶光应已暮，花事委行尘。\n画帆拟泛石湖滨。\n修禊及佳辰。\n寄语流杯亭下客，沽酒莫辞贫。\n风吹船玉皱红鳞。\n一呕木兰春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42391,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"太常引•留别","author":"彭孙遹","text":"脆红娇白媵残春。\n香梦细于尘。\n画阁又斜曛。\n空羡杀、乌龙锦茵。\n无边风浪，无凭书札，从此隔重闉。\n一掬小江津。\n浣不去、相思泪痕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42392,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳梢青•感事","author":"彭孙遹","text":"何事沉吟。\n小窗斜日，立遍春阴。\n翠袖天寒，青衫人老，一样伤心。\n十年旧事重寻。\n回首处、山高水深。\n两点眉峰，半分腰带，憔悴而今。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42393,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"月中行•别意","author":"彭孙遹","text":"越丝新襞小裙腰。\n翠带逐风飘。\n水葱仙席索春饶。\n脉脉暗肌销。\n银筝玉管无心弄，人静后、几点清谯。\n相怜端的只今宵。\n不睡也难消。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42394,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"满宫花•南园","author":"彭孙遹","text":"试青鞋，褰翠袖。\n春色南园堆绣。\n白头犹说广陵王，能使行人回首。\n锦衣城，今在否。\n见说当时宫囿。\n陌上谁歌缓缓归，只有花开如旧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42395,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"少年游•席上有赠","author":"彭孙遹","text":"花底新声，尊前旧侣，一醉尽生平。\n司马无家，文鸯未嫁，赢得是虚名。\n当时顾曲朱楼上，烟月十年更。\n老我青袍，误人红粉，相对不胜情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42396,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"思越人•题余氏女子绣西子浣纱图，同程村、阮亭作","author":"彭孙遹","text":"擘仙丝，写美矉，依然南国娉婷。\n石畔浣纱今在否，溪流犹为人清。\n兴亡吴越眉颦上。\n鸱夷枉铸遗像。\n日暮百花洲下路，珊珊步屧馀响。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42397,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉花阴•和漱玉词，同阮亭作","author":"彭孙遹","text":"花影枝枝摇午昼。\n桂炷销狮兽。\n愁病怯登高，几阵西风，吹得罗裳透。\n阑干星月三更后。\n玉露沾香袖。\n心事寄谁行，约略腰身，转觉秋来瘦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42398,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怨王孙•春暮和李易安同阮亭 其一","author":"彭孙遹","text":"春阴晼晚。\n蔷薇庭院。\n谢女楼空，秦娥梦断。\n倩柳色把情传。\n结缠绵。\n当初小喜将人惹。\n还抛舍。\n煞是无赖也。\n别来又过寒食，几树横斜。\n断肠花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42399,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怨王孙•春暮和李易安同阮亭 其二","author":"彭孙遹","text":"银箭声悄。\n金屏思恼。\n香梦和云，流莺弄晓。\n一树树海棠红。\n不禁风。\n风狂雨骤伤心处。\n花落去。\n秾艳空辜负。\n登楼一望天际，目尽南云。\n镇思君。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42400,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双调望江南•初见","author":"彭孙遹","text":"初见处，记得在东皋。\n曾与酒人司白堕，便从仙籍识青腰。\n颜色为谁娇。\n行酒罢，灭烛更相邀。\n并体花间刚恰好，凌波一捻已魂销。\n何况是今宵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42401,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浪淘沙•戏赠闺人","author":"彭孙遹","text":"生计漫匆匆。\n卖赋临邛。\n黄金先为贳新丰。\n伊唱吴趋侬起舞，激楚回风。\n此处不留侬。\n甚处留侬。\n小朱慵粉若为容。\n一事与卿权领取，酒诰花封。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42402,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浪淘沙•代答","author":"彭孙遹","text":"晓起弄妆慵。\n笑指吴佣。\n白衣夫婿白头侬。\n今日海裳花下饮，端与谁同。\n云雨楚天重。\n谁系郎踪。\n任伊梦遍十三峰。\n解识近来勤入道，懒向花丛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42403,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浪淘沙•怀归","author":"彭孙遹","text":"漏永夜如年。\n拨尽炉烟。\n乍晴又雨晚秋天。\n切切暗虫窗外语，欲断还连。\n寒色透重绵。\n若个周旋。\n自家将息自家怜。\n何日归来相诉也，月下星前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42404,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浪淘沙•客窗夜雨","author":"彭孙遹","text":"寒雨太连绵。\n一抹江天。\n广陵钟断夜无眠。\n何事秋声吹不了，长打窗前。\n酒后转凄然。\n著处堪怜。\n故乡只在睡乡边。\n好嘱梦儿归去也，片刻团圆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42405,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杏花天•美人题红叶","author":"彭孙遹","text":"安排秀句描秋思。\n正沉吟、湘毫欲试。\n风前红叶轻于纸。\n薄命生憎似此。\n堪惆怅、美人独自。\n碧云杳、佳期未至。\n有情尽解相思死。\n消得银钩几字。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42406,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"摘红英•客中闻卖花声","author":"彭孙遹","text":"东风景。\n吹芳信。\n卖花声隔墙头粉。\n耽人恨。\n教人困。\n赊得春光，为谁簪鬓。\n青儿嫩。\n红儿褪。\n梦回蝴蝶难重认。\n情儿闷。\n心儿忖。\n别来几日，玫瑰开尽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42407,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"红窗睡•舟泊庐山下寄吴尔世","author":"彭孙遹","text":"薄暮江滨，晓竹寻烟见水面、渔灯三两。\n香炉五老青冥上。\n正峰峰相向。\n犹记此中君独往。\n料此后、云岩松瀑，依依梦想。\n因风传语，道庐山无恙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42408,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]