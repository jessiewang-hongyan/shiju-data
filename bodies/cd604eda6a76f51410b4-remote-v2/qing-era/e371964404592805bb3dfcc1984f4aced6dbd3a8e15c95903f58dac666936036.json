[{"title":"南浦 春水，和母   见《昭代词选》、《词雅》","author":"曹鉴冰","text":"书屋正临溪，喜春回，浅碧粼粼晴晓。\n一片縠纹轻，红襟燕，掠处翠萍如扫。\n仙源难觅，浮来千点桃英小。\n十里银塘，迷望眼，色映离披芳草。\n溶溶漾漾桥边，岂离人、愁泪流将不了。\n杨柳绿阴浓，风生处，时有白鸥飞到。\n烟云渺渺。\n钓船归矣渔歌悄。\n试问者番新雨后，添得浪花多少。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22671,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"步蟾宫 却燕","author":"曹鉴冰","text":"任伊绕径翻双剪。\n纱槅子、齐关红扇。\n去年不听故人留，又何用、故人重见。\n旧巢泥污休依恋。\n请栖托、邻家深院。\n算侬非是忒无情，怕牵惹、秋来肠断。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22672,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"疏影 蝶影","author":"曹鉴冰","text":"阶前两两。\n总回旋高舞，不离书幌。\n素袖空黏，彩扇虚兜，作出一番轻浪。\n绿钱匀处依稀见，似栩栩、梦魂飘荡。\n稳栖香、冷月光中，仍与花枝相傍。\n倩入滕王笔底，怕蛾粉鸦黄，总难偷样。\n疑假犹真，是也非耶，偏漏雕檐蛛网。\n无端逗起闲吟味，添几许、惜春情况。\n待寻芳、倦绣人来，闪在罗裙褶上。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22673,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沁园春 发","author":"曹鉴冰","text":"握向菱花，光泽谁如，羞他麝煤。\n恁长侵眉翠，一窝云薄，低笼耳玉，几叶兰齐。\n堕马妆新，蟠龙式旧，巧绾穿心时样宜。\n增妍处，有金虫深亸，琼燕斜飞。\n垂垂惯贴蝤蛴。\n爱花露油沾香袭衣。\n记舞偏灯底，牙梳再掠，睡松枕角，彩线重维。\n烟拂鸦翎，露凝蝉翼，总使轻盈也让伊。\n寻芳去，怕兜归密刺，休近荼蘼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22674,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沁园春 口","author":"曹鉴冰","text":"小颗含春，那许盘中，樱桃斗鲜。\n为粉香匀靥，微粘花露，彩毫描黛，淡吮松烟。\n凤管调来，鹅笙炙去，一曲清歌莺溜圆。\n评茶味，任瓷磁深浅，尝尽甘泉。\n休随梁燕呢喃。\n且教语鹦哥铁马前。\n爱瓜犀难见，茜凝羞郑，丁香半露，猩滴惊樊。\n懒嚼红茸，愁沾绿蚁，惯使纤纤剔未闲。\n移情处，在轻轻一笑，百媚嫣然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22675,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沁园春 目","author":"曹鉴冰","text":"烁烁清光，低映眉山，桃花是名。\n惯深遮团扇，背灯角睐，潜回落月，对影斜凝。\n欢定含娇，醉还送悄，懊恨难禁玉筋零。\n无人处，把鸳巾轻拭，装出多情。\n日长何事瞢腾。\n凭案叠残编展未曾。\n喜才临碧涧，盈盈秋水，乍开青镜。\n闪闪春星。\n吟倦窗前，绣慵楼上，瞥见归舟带笑迎。\n风流样，怕端溪鸲鹆，输与精莹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22676,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沁园春 腰","author":"曹鉴冰","text":"软款围来，尺六无多，纤柔绝伦。\n向灯前欹侧，惊回柳影；花边宛转，羞睹蜂魂。\n染恨千丝，萦愁几缕，半幅曾窥湘水裙。\n临风去，怕娉娉袅袅，化作行云。\n晓寒料峭难温。\n好缓束吴绫茜色新。\n为妆成有意，凭栏倦舞，醉馀无力，凭几慵伸。\n剥枣应怜，偎琴更惜，透体沉檀一捻春。\n谁堪拟，似盈盈佩玉，洛浦仙人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22677,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台城路 蟋蟀","author":"曹鉴冰","text":"井梧飘后愁堪赋，俄闻这番凄语。\n接砌花根，连阴树底，那不消人魂处。\n高吟低诉。\n恰经断回文，指寒停杼。\n灯影清莹，夜深怪尔撩愁绪。\n苔茵露浓过雨，似休还又杂，月下鸣杵。\n唧唧荒村，喓喓静馆，作出秋声无数。\n何当递与，惹鹤步挨来，呆儿痴女。\n盆盒携归，逞馀音更苦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22678,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"月中行 题陈素素像","author":"商景徽","text":"轻盈燕子掌中身。\n对景舞还停。\n见君佳句更相亲。\n笔底动人情。\n三春杨柳腰间细，二分明月鬓边横。\n芙蓉初放碧池新。\n知是画图人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22679,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"商景徽","text":"篆烟吹过花深处。\n■■叶底垂甘露。\n何处见如来。\n青莲笔下开。\n朝朝研墨碗。\n不画春山远。\n但写妙莲华，香风遍若耶。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22680,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"谒金门 寄汉槎兄塞外   见《今词初集》、《瑶华集》、《词综》、《词雅》","author":"吴文柔","text":"情恻恻。\n谁遣雁行南北。\n惨淡云迷关塞黑。\n那知春草色。\n细雨花飞绣陌。\n又是去年寒食。\n啼断子规无气力。\n欲归归未得。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22681,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长相思","author":"吴文柔","text":"关山秋。\n故山秋。\n叶落宫槐起暮愁。\n新凉作意收。\n蓼花洲。\n荻花洲。\n分付蛩吟且暂休。\n断肠人倚楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22682,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"谒金门","author":"周琼","text":"风屑屑。\n吹冷一帘新月。\n深院蔷薇和影折。\n兜裙红刺审。\n昨夜露浓苔滑。\n早又残花浓叶。\n闲倚红窗寻绿蝶。\n掀帘银蒜揭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22683,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"昭君怨 咏镜","author":"周琼","text":"一片青铜如月。\n照出妾颜如雪。\n雪月两堪夸。\n胜如花。\n背地檀郎情顾。\n恰似鸳鸯两个。\n含笑倚郎肩。\n月中仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22684,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 纤手","author":"周琼","text":"嫩玉纤纤整素弦。\n惯弹别鹄最堪怜。\n几回私语把衣牵。\n爱插鲜花时掠鬓。\n怕沾飞絮故掀帘。\n漫笼双袖倚阑干。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22685,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"感恩多 送漱雪夫子","author":"张粲","text":"捧卮河畔立。\n草软斑骓急。\n问郎几日归。\n月圆时。\n堤上轻绵吹屑，拂征衣。\n拂征衣。\n须信侬心，绊郎如柳丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22686,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"小梅花 怀范雒仙","author":"张粲","text":"秦淮曲。\n香丛宿。\n华笙吹彻莲筹促。\n小軿车。\n玉钩斜。\n乳莺雏燕，啼上合欢花。\n仙姝一向蓬山谪。\n兰梦依稀烟雁隔。\n守空房。\n思茫茫。\n韶州方褥，冷叠象牙床。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22687,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人 悼范雒仙","author":"张粲","text":"凄凉旧恨知多少。\n极目烟云渺。\n小楼无事理残编。\n恰得伤心情句、使人怜。\n霞笺锦字犹如昔。\n泪洒芭蕉湿。\n问君何故早游仙。\n想是玉楼有召、咏香奁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22688,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寻芳草","author":"李朓","text":"赢得千愁逼。\n闲抛却、许多月色。\n寒烟窗外碧。\n正梦到旧家园、谁吹笛。\n腰瘦不关秋，天河似我啼痕积。\n又哀哀、孤雁鸣沙碛。\n魂去也、江山黑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22689,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"捣练子 同仲嫂夜坐","author":"汪婤","text":"庭悄悄，月沉沉。\n唧唧寒蛩断续吟。\n独有孤鸿听不得，欲眠犹自理瑶琴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22690,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"金缕曲 题西子思乡图，即代西子自叹","author":"堵霞","text":"容易韶华度。\n最难堪，秋容惨淡，秋声凄楚。\n江畔芙蓉刚半吐。\n多少月笼烟护。\n那似我，随风飘堕。\n遥望乡园何处是，怎苍苍、独把红颜妒。\n全不管，捧心苦。\n屧廊深邃宫闱暮。\n甚来由，娇丝脆竹，朝歌夜舞。\n听说沼吴须籍妾，武将谋臣几许。\n偏用着，温柔戈斧。\n他日身随荒草没，更何从、认取耶溪路。\n无限恨，向谁诉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22691,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"十六字令 春望","author":"堵霞","text":"愁。\n几片飞花过小楼。\n春归否，尚在柳梢头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22692,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"唐多令","author":"严淑珍","text":"九十半过春。\n名山绕梦魂。\n喜芳游、伴结红裙。\n蜿蜒九龙峰秀绝，真妒煞、黛眉痕。\n穿磴拂松云。\n清吟坐夕曛。\n看香闺、多少才人。\n惟我倚声惭击节，须满酌、慧泉吞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22693,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"东风第一枝 咏梅","author":"严淑珍","text":"岭上愁苏，溪边睡醒，一枝早逗春意。\n暗香微送霜中，瘦影小横雪里。\n凄迷冻蝶，似不许、绕丛游戏。\n想此时、做梦群花，那晓玉妃先起。\n遥傍水、芳心孤寄。\n低映月、粉姿斜倚。\n观来东阁逡巡，折向西洲迢递。\n幽芳冷艳，索笑处、开非容易。\n看李桃、乱嫁东风，怎得比伊林婿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22694,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 美人午睡","author":"许冰玉","text":"绿云撩乱堆红袖。\n粉香零落胭脂瘦。\n鹦鹉一声声。\n回头错应人。\n近前情脉脉。\n试把香肩拍。\n双手约金钗。\n朦胧眼不开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22695,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"少年游 咏金凤花","author":"宋瑊","text":"凤仙花本自仙宫。\n最喜雨濛濛。\n摘来簪髻，捣成染甲，妆点许多容。\n不幸经秋霜打败，无复露华浓。\n西风一夜，纷纷红紫，多半萎墙东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22696,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆王孙 本意","author":"季娴","text":"花光月色影霏微。\n阵阵香风拂绣帏。\n闲倚画屏兰麝郁。\n夜阑时。\n塞外双鸿归不归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22697,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"前题","author":"季娴","text":"青梅如豆压枝低。\n淡绿轻红映钓矶。\n柳花如雪漫天飞。\n笋初肥。\n莲叶如钱浮小池。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22698,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋波媚 忆维章夫子","author":"季娴","text":"晴日疏帘暖气浮。\n春满画堂幽。\n嫩黄搓柳，淡红含杏，夕照高楼。\n忆君临发贻佳句，日懒未曾酬。\n嗔他黄鸟，偏来枝上，陡唤人愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22699,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"月中行 晚步树园","author":"季娴","text":"园林好景夕阳西。\n花压画桥低。\n争泥双燕受风欹。\n点缀暮春时。\n寂寂长廊无客到，楼台倒影漾方池。\n无端小婢促归迟。\n细细点游丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22700,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"白苧 咏鲛绡","author":"季娴","text":"蛟宫里，波纹静，几多姌袅。\n蕊珠璀璨，六月凉生殿阁。\n好安排、金针玉户裁云幕。\n约略渭川漪，琼山碧，是甚纬络。\n眯眯看去，宛尔晶光错落。\n记昔年、建章曾荷仙娥托。\n如昨。\n就锦霞帔，即今重见，依旧冰蚕乱缚。\n问线线丝丝，为谁缝却。\n多情阔别，怕涓涓泪滴，刺残巾角。\n拂拭殷勤，汗漫红见，数点斑驳。\n待出深潭，羡奇花软绰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22701,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"采桑子  见《昭代词选》、《词综补》","author":"宋凌云","text":"从来不识悲秋意，爱月登楼。\n爱月登楼。\n玉笛横吹天际浮。\n而今识尽悲秋意，独倚香篝。\n独倚香篝。\n两点春山只驻愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22702,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 杨花","author":"顾树芬","text":"昨夜东风透露台。\n无端柳絮遍苍苔。\n一春心事又成灰。\n无力自随流水去，有情还伴落花来。\n天涯游子几时回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22703,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水调歌头 南村","author":"顾树芬","text":"三万六千日，人世几完全。\n一年记取佳日，领略在春前。\n纵有风风雨雨，须忆莺莺燕燕，香糁百花鲜。\n常笑乾坤窄，荆布觉宽然。\n山之角，水之尾，尽幽妍。\n野塘村坞，往来飞鸟白云边。\n偶见青蓑绿笠，较量种麻插稻，此际即神仙。\n今日又明日，富贵总由天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22704,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦令","author":"陆幽光","text":"几欲把愁推去。\n却被双眉锁住。\n细软语情郎，何事千情万绪。\n无味。\n无味。\n牵惹柔肠如许。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22705,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"重叠金 秋恨","author":"陆幽光","text":"爽气西山来画栋。\n檐马叮当惊午梦。\n高揭起湘帘。\n晚霞拥玉蟾。\n蛩声鸣断续。\n雁字排长幅。\n欲诉可怜秋。\n秋深日日愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22706,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 对月怀表妹","author":"万淑修","text":"月落乌啼，今宵提起心先碎。\n无凭鳞羽。\n逾觉人憔悴。\n目极烟迷，望断家门路。\n携琴处。\n海棠花底，共赋伤春句。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22707,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南柯子 病中怀亲","author":"万淑修","text":"不必愁生死，关山隔故乡。\n楼头吴橘又初黄。\n正是暮秋时候、过重阳。\n日落迷芳草，庭深怯晓霜。\n病怀无计苦参商。\n又见一行征雁、断人肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22708,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹧鸪天 同表妹游董夫人西园","author":"万淑修","text":"花径斜开浅水滨。\n疏篁深处绝纤尘。\n漫从洛浦邀神女，试到天台访玉真。\n携绿绮，伴佳宾。\n绕篱小草好相亲。\n却忧赋就胶东去，日暮还听鸟弄春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22709,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉楼春 元宵后一日忆母","author":"万淑修","text":"东风依旧来庭院。\n极目家山云隔断。\n辛盘空对九枝花，千里月明人更远。\n黄河涛转亲无患。\n窗外梅花开已半。\n未逢驿使托青鸾，寄去高堂如觐面。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22710,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"邵笠","text":"乱莺啼破流苏梦。\n樱桃露湿花梢重。\n小婢促梳头。\n开奁满镜愁。\n画眉人不在。\n蹙损双螺黛。\n淡日上红纱。\n轻蝉鬓影斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22711,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人","author":"邵笠","text":"金铃密缀桐龙凤。\n粉淡檀痕重。\n半遮团扇眼波斜。\n多恐养娘偷检、守宫砂。\n翠眉一霎愁峰锁。\n挼碎芙蓉朵。\n问伊底事忽娇嗔。\n道是采花掠乱、鬓梢云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22712,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"步蟾宫 中秋","author":"邵笠","text":"风尖云嫩山容瘦。\n数飞鸟、鸦前鹊后。\n夜阑带醉听箫声，恍瞥见、谁家红袖。\n蟾钩穿过疏林骤。\n桂子落、满山金镂。\n桥边错认玉人来，惹裙带、暗香偷嗅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22713,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤凰台上忆吹箫 秋夜怀姊","author":"邵笠","text":"桂院香残，松窗月冷，孤鸿呖乱楼头。\n见梧桐摇落，叶叶惊秋。\n几阵轻风暗度，窗儿外、细戛帘钩。\n听砧声，随风断续，惹起闲愁。\n悠悠。\n玉人别后，又三秋去也，谁与绸缪。\n对孤灯兀坐，冷落香篝。\n画阁深沉独自，镇日里、挨尽清幽。\n无聊赖，且凭绿绮，一曲凉州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22714,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"捣练子 新燕","author":"束蘅","text":"掀帘看，乱红飘。\n新燕衔泥补旧巢。\n私语侍儿还记得，去年曾否立花梢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22715,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南唐浣溪沙 西园春游同唐静因夫人","author":"束蘅","text":"伤春春半始寻春。\n时样衣衫藕色新。\n团扇擎来明月满、好遮身。\n细数落花临曲涧，缓寻芳草步香尘。\n怪煞东风吹欲暮、促归轮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22716,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"苏幕遮 秋闺","author":"束蘅","text":"绿窗闲，人已静。\n玉兔初升，银烛光摇冷。\n倦倚画楼栏自凭。\n庭院深深，墙角花枝映。\n小池新水明如镜，霜打残荷，几点无多剩。\n瘦减腰肢力不胜。\n无奈伤秋，愁绝鸳鸯病。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22717,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 寄洛珍","author":"束蘅","text":"暖透窗纱，云迷院树。\n停针时有熏风度。\n闲看稚子捉杨花，小鸟无心来又去。\n翡翠生色，芭蕉垂露。\n落红返照家门路。\n不知何事苦萦怀，怕听杜鹃啼不住。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22718,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 西山即景","author":"郁大山","text":"西山晴翠苍茫里。\n杏花枝上莺飞起。\n飞起带春愁。\n送来楼上头。\n栏杆十二曲。\n曲曲穿修竹。\n愿把屋边霞。\n倩人拿到家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22719,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"柳梢青 秋夜   见《众香词》、《词综》","author":"郁大山","text":"何处钟声。\n谁家笛韵，最是多情。\n独步芳阶，芭蕉月上，影落疏棂。\n连朝腐草无萤。\n窗儿外、风清月明。\n宝篆抛烟，银灯无焰，倍觉凄清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22720,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花","author":"邵斯贞","text":"春雨三更喧碧沼。\n愁病交侵，有梦何曾好。\n枝上莺啼天欲晓。\n空庭一夜生芳草。\n何处天涯音信杳。\n紫燕双飞，偏把幽情恼。\n捲起湘帘风尚悄。\n临妆懒把蛾眉扫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22721,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南春 春草","author":"陆敏","text":"风欲偃，路愁遥。\n枝头莺语滑，柳下马嘶骄。\n堤边嫩绿年年长，几换游人过画桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22722,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长相思 题月下抱琴美人图","author":"陆敏","text":"风正凉。\n桂正香。\n月照当头树影墙。\n良宵暗断肠。\n灯闪墙。\n月移廊。\n欲抚丝桐情自伤。\n声中求凤凰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22723,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 春尽","author":"陆敏","text":"莺唤纱窗惊晓梦。\n日上三竿，乱把花枝弄。\n杨柳池塘烟水重。\n荼蘼香暖时相送。\n懊恼游蜂闲打閧。\n自捲湘帘，玉笛轻声弄。\n暗卜金钱何处用。\n六幺倒挂窗前凤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22724,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青玉案 题赵夫人文淑画","author":"陆敏","text":"寒山闺秀神清彻。\n映千尺，流泉雪。\n忽见花开来舞蝶。\n缣缃乍展，丹铅漫染，点缀香痕湿。\n玉人天授生花笔。\n非雾非烟空翠滴。\n好鸟和鸣呼欲出。\n红蕉白萼，柔枝嫩叶，生意毫端集。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22725,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"捣练子 春闺","author":"顾之琼","text":"雷殷殷，雨潺潺。\n帘捲春风拂面寒。\n开遍梨花归梦杳，和衣睡起月阑珊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22726,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江南春 忆远","author":"顾之琼","text":"星炯炯，思依依。\n关山幽梦绕，风雨暗魂飞。\n江南春好浑闲却，何事游人滞不归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22727,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"薄命女","author":"顾之琼","text":"深夜悄。\n女使催眠还恨早，遣情浑不了。\n问君几许春愁，遥忆当年娇小。\n绣到鸳鸯思缭绕。\n钟声惊曙晓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22728,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 春游","author":"顾之琼","text":"腰肢瘦损不胜罗。\n无那春来病染多。\n含情未语照晴波。\n金约腕垂纤笋丽，玉搔头亸醉颜酡。\n小桥归艇起渔歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22729,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 闺思","author":"顾之琼","text":"一缕乌云散篆香。\n雨丝红泪破残妆。\n沉吟长自送斜阳。\n烟袅袅升迟宝鼎，雨濛濛过冻银床。\n不堪人去日添长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22730,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉连环 月夜论诗迟潘夫人不至","author":"顾之琼","text":"露寒曲槛红衣润，笑扶蝉鬓。\n徘徊临水照红妆，人比嫦娥差近。\n倩得鳞鸿通问，对花消恨。\n把文何事不同论，论有尽、思无尽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22731,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]