[{"title":"卜算子 其一 留友人","author":"王士禛","text":"天气近清明，汝定成行否。\n雨雨风风不暂停，作意催花柳。\n柳色染征衣，花气熏残酒。\n纵使无情也断肠，争似同携手。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39270,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卜算子 其二 纪梦","author":"王士禛","text":"风水望西陵，烟树迷南浦。\n千里相思又暮春，梦里江南绿。\n记下水晶帘，帘外红蕉吐。\n残篆初萦斗帐垂，好是侬归处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39271,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丑奴儿令 隋堤","author":"王士禛","text":"隋皇昔幸东都日，锦缆迢遥。\n凤艒龙艘。\n剪采宫中暮复朝。\n琵琶忽唱安公子，红炬烟销。\n故国寒潮。\n一曲清江柳万条。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39272,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其一 为长沙女广王素音作用稼轩过长沙道中见妇人题字用其意作韵","author":"王士禛","text":"离愁满眼。\n日落长沙秋色远。\n湘竹湘花。\n肠断南云是妾家。\n掩啼空驿。\n魂化杜鹃无气力。\n乡思难裁。\n楚女楼空楚雁来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39273,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其二 杨花步弇州韵","author":"王士禛","text":"纱窗梦起。\n极目玉关人万里。\n斜绾千条。\n自古销魂是灞桥。\n春阴不尽。\n除却残莺谁借问。\n陌上楼前。\n销得香闺几日怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39274,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其三 杨妃","author":"王士禛","text":"木兰殿里。\n回雪流风人莫比。\n万里桥头。\n水绿山青不尽愁。\n连昌春竹。\n空映落花红簌簌。\n莫问当年。\n锦袜犹能直许钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39275,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其四 梅妃","author":"王士禛","text":"天然姿媚。\n比向梅花应不异。\n一斛珍珠。\n得似鲛人泪点无。\n文园老去。\n恨煞无人能解赋。\n我见应怜。\n不索长门买赋钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39276,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其五 秦淮归棹","author":"王士禛","text":"隔溪桃叶。\n照影秋波双画楫。\n旧日琅邪。\n红板桥南第几家。\n趁潮归去。\n一缕柔情无著处。\n但有垂杨。\n叶叶枝枝解断肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39277,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"好事近 二月竹亭雪后观梅忆邓尉旧游和蒋子云韵","author":"王士禛","text":"社日过花朝，寒峭琼瑶还落。\n狼籍梅花千片，洒何郎东阀。\n惜花拥鼻正无憀，往事浑如昨。\n记得蟠螭花下，有扁舟孤泊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39278,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳含烟 本意","author":"王士禛","text":"销魂树，曲江边。\n移自永丰坊里，东风吹雪又吹绵。\n艳阳天。\n何处行人歌水调。\n极目黏天芳草。\n锦帆曾此向天涯。\n落谁家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39279,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆秦娥 忆秦淮","author":"王士禛","text":"秦淮水。\n红楼一带波如绮。\n波如绮。\n琉璃窗下，水晶帘底。\n梅花点额夫容髻。\n妆成照影春波里。\n春波里。\n一方明镜，朝朝孤倚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39280,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏子 与秦淮友人夜话旧院遗事","author":"王士禛","text":"燕莺时，风景地。\n往日青溪佳丽。\n珠户里，画屏中，花枝相映红。\n烛花残，更漏咽。\n旧事不堪重说。\n波潋潋，雨潇潇。\n西风长板桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39281,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"阮郎归 清明","author":"王士禛","text":"平山堂外又清明。\n春芜初蘸青。\n梨花燕子满江城。\n人家闻卖饧。\n邀伴去，踏莎行。\n竹西歌吹声。\n酒旗一片飏前汀。\n青丝何处停。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39282,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉连环 个侬","author":"王士禛","text":"枇把门巷樱桃树。\n个侬曾遇。\n画衣缥缈水沉熏，不辨香、来何处。\n忽似惊鸿翔去。\n凌波微步。\n洛川伊水向东流，八斗才、情空赋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39283,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"画堂春 咏折枝桃花","author":"王士禛","text":"十分春信到梨花。\n丝丝弱柳栖雅。\n谢娘小阁映窗纱。\n一片红霞。\n开处流莺初唤，雨中薄雾犹遮。\n水晶枕畔一枝斜。\n春在谁家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39284,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海棠春 闺词同程村羡门 其一 晓妆","author":"王士禛","text":"鹦哥初唤闻方响。\n幽梦起、日浮交网。\n花影?流苏，一片红潮漾。\n新梳小髻翻荷样。\n初縆额、邀郎相赏。\n慵画小山眉，黛粟留张敞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39285,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海棠春午睡 其二","author":"王士禛","text":"绿杨庭院东风足。\n透梵宇、回廊千曲。\n蕃骑簇金屏，簟拂寒蛩褥。\n云鬟掩映夫容肉。\n新睡起、一痕红玉。\n小胆怯空房，风动萧萧竹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39286,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海棠春午睡晚浴 其三","author":"王士禛","text":"星光碎月摇花影。\n神麦响、梦回人醒。\n小婢煮兰汤，玉沁冰壶冷。\n沉香卷发盘龙镜。\n迟半晌、鲛绡重整。\n不管绣帘前，费尽黄金饼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39287,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海棠春午睡晚浴夜坐 其四","author":"王士禛","text":"鸳鸯楼角黄昏雨。\n听断续、细腰香杵。\n鸳枕冷冰蚕，檐外风铃语。\n萧郎今夜兰台去。\n偏无赖、三通谯鼓。\n红泪点罗衣，销黦难寻麈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39288,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"武陵春 和漱玉词","author":"王士禛","text":"昨日相逢歌扇底，偷赠玉搔头。\n画阁香浓郎且休。\n秋水簟纹流。\n送别殷勤杨柳岸，花雪满行舟。\n双桨凌风兰叶舟。\n又卷起一江愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39289,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山花子 其一 秋闺","author":"王士禛","text":"斗帐初垂懒卸头。\n任他紫笺减秦篝。\n帘外银河天似水，数更筹。\n梧叶催虫凉到枕，花枝和月午当楼。\n还似残春寒食后，一般愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39290,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山花子 其二 寄程昆崙京口","author":"王士禛","text":"黄鹤山前黄鹤鸣。\n杜鹃楼外杜鹃声。\n记得戴颙招隐地，共经行。\n北固云烟春望远，南徐风雨暮潮生。\n一片澄江如练影，接芜城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39291,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"眼儿媚 其一 感旧","author":"王士禛","text":"少年无赖好寻游。\n何处著閒愁。\n罗敷陌上，窈娘堤畔，到处淹留。\n艳情绮思销磨尽，往事似尘沤。\n楞伽堆案，离骚系肘。\n别样风流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39292,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"眼儿媚 其二 堂堂","author":"王士禛","text":"相逢曾记在秦楼。\n软语倚空侯。\n最难忘处，人称窈窕，乡是温柔。\n别来光景堂堂去，已事莫回头。\n不堪重说，韦郎非少，阿杜经秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39293,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"朝中措 平山堂和欧公原韵","author":"王士禛","text":"平山堂外又东风。\n寒食柳濛濛。\n欲访欧公行处，寒烟暮霭连空。\n仙翁已远，髯公复去，文笔谁工。\n南望金焦两点，江天依旧飞鸿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39294,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"桃源忆故人 金钗涧上在秦邮","author":"王士禛","text":"金钗涧上人如玉。\n解唱春波新曲。\n画扇蝉纱十幅。\n春水平帆绿。\n三三五五鸳鸯浴。\n触忤閒愁春目。\n戏掷菱花相逐。\n又向花房宿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39295,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"太常引 别思","author":"王士禛","text":"交飞玉剪羽差池。\n王孙烟草萋。\n门外即天涯，正水碧、山青去时。\n香销金斗，奁孤玉镜，慵自写愁眉。\n莫遣个人知。\n怕减却、休文带围。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39296,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"应天长 闺人刺绣","author":"王士禛","text":"饯春时节深深院。\n睡起金衣花外啭。\n绣床轻素丝软。\n一幅吴绫秋水面。\n麝烟微，螺黛浅。\n衣上唾绒红溅。\n花落日长人倦。\n偏髻拖残线。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39297,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 程村感事作惜分飞词五十阕为殿一章","author":"王士禛","text":"生小卢家堂里住。\n解诵班姬捣素。\n花底曾相遇。\n两情脉脉银湾渡。\n九十春光花满树。\n狼籍宵绵雨。\n欲问相思路。\n伯劳飞燕东西去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39298,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西江月 其一 怀黄山东园","author":"王士禛","text":"梦想天都黄海，吾庐亦枕黄山。\n半天高柳水潺潺。\n门跨飞梁绝涧。\n林下棋逢橘叟，矶头钓共鱼蛮。\n烟销月出鹤飞还。\n人在画溪东岸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39299,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西江月 其二 咏史","author":"王士禛","text":"汉武史称大略，陇西家世名流。\n次公已作岸头侯。\n飞将数奇不偶。\n昔日人奴笞骂，长安甲第云浮。\n龙鳞鹤尾铁兜鍪。\n笑谓钳徒有口。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39300,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西江月 其三 鲁仲连陂怀古题壁","author":"王士禛","text":"少慕鲁连高节，居然仿傥权奇。\n邯郸指顾解秦围。\n一笑千金脱屣。\n千古清风兰雪，一竿烟水荒陂，我来髣髴见云旗。\n独立长留天地。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39301,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西江月 其四 吴中怀古本意","author":"王士禛","text":"一片西江云月，千年常照梧宫。\n越来溪畔酒城东。\n往事凄凉如梦。\n转盼五湖代长，当年三策偏工。\n怒潮白马哭英雄。\n穿胁犹持文种。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39302,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"燕归梁 吴水部园亭观演燕子笺剧，时玉兰盛开","author":"王士禛","text":"海燕红襟语画梁。\n似惜韶光。\n红牙一曲舞山香。\n辛夷花，落银床。\n良媒却借乌衣燕，曲江往事堪伤。\n人间何限郁金堂。\n凭远恨，与衔将。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39303,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偷声木兰花 春情寄白下故人","author":"王士禛","text":"绿杨阴里秋千索。\n乳燕学飞池上阁。\n水涨银塘。\n落絮浮萍又夕阳。\n方山亭下江南路。\n画桨凌波从此去。\n十四楼空。\n万叶千花泪眼中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39304,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"满宫花 戏题吴蕊仙花卉便面","author":"王士禛","text":"汉宫春，湘竹扇。\n写出一痕清怨。\n轻纨半幅不禁秋，几点墨花轻茜。\n忆然脂，思捧砚。\n馀响犹闻金钏。\n武陵傥许问津来，可似渔郎花片。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39305,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉花阴 和漱玉词","author":"王士禛","text":"香闺小院閒清昼。\n屈戌交铜兽。\n几日怯轻寒，箫局香浓，不觉春先透。\n韶光转眼梅花后。\n又催裁罗袖。\n最怕日初长，生受莺花，打叠人消瘦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39306,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怨王孙 其一 和漱玉词","author":"王士禛","text":"碧天云晚。\n绿梧小院。\n帘额花轻，烟眉柳断。\n珠泪裹寄谁传。\n渍红绵。\n愁多自觉春相惹。\n怕相舍。\n则索厮守也。\n红窗刀尺初罢。\n银汉西斜卜灯花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39307,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怨王孙 其二 和漱玉词","author":"王士禛","text":"画阁清悄。\n情思懊恼。\n旅雁生秋，哀蛩饯晓。\n叶底渐减蕉红。\n怯西风。\n莺花步步郎行处，将梦去。\n欢侬忍相负。\n楼头望断，千里思化春云。\n远随君。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39308,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨中花 风情","author":"王士禛","text":"料峭东风吹细雨。\n作使得、春愁无主。\n昨日清明。\n今朝百五，渐渐春光去。\n巨胜花前曾记遇。\n难忘却、碧桃千树。\n拥髻灯前，偷香被底，一一销魂语。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39309,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浪淘沙 和漱玉词","author":"王士禛","text":"砚匣日随身。\n检点残春。\n横云斜月斗鲜新。\n昨夜相思曾入梦，香雨香云。\n记得齧丹唇。\n似喜还嗔。\n醒来惆怅隔仙津。\n欲识回肠千万转，日日车轮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39310,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人 其一 和李后主","author":"王士禛","text":"杜鹃声里春将老。\n断送花多少。\n几层杨柳几层风。\n总付银屏金屋梦魂中。\n合欢枕上香犹在。\n好梦依稀改。\n回环锦字写离愁。\n恰似潇波不断入湘流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39311,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人 其二 本意","author":"王士禛","text":"拔山盖世重瞳目。\n眼底无秦鹿。\n阴陵一夜楚歌声。\n独有美人骏马伴平生。\n感王意气为王死。\n名字留青史。\n笑他亭长太英雄。\n解令辟阳左相监宫中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39312,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子 闺晓","author":"王士禛","text":"小婢弄香奁。\n宫饼笼中几个添。\n细雨如尘人乍醒，纤纤。\n榆荚缒墙水半淹。\n晓漏报琼签。\n鹦鹉惊寒促下帘。\n愁锁眉峰慵对镜，厌厌。\n空说吴娘笑是盐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39313,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉落魄 读天宝遗事","author":"王士禛","text":"风流堪惜。\n沉香亭下双鸂鶒。\n长生殿里如胶漆。\n别院梨花，偷试宁王笛。\n渔阳战鼓惊相偪。\n马嵬古驿罗衫湿。\n秋槐落尽空凝碧。\n残月华清，何处人行迹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39314,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行 其一 寄曾道扶魏子存","author":"王士禛","text":"芳树秦城，春流蜀栈。\n蚕丛西望愁无限。\n铜梁阁外杜鹃啼，嘉陵江上行人饭。\n远道萦纡，春光婉娩。\n锦江鱼杳淮南雁。\n去时杨柳不胜雅，青青又满随河岸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39315,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行 其二 秦淮清明","author":"王士禛","text":"烟雨清明，烟花上巳。\n楼台四百南朝寺。\n水边多少丽人行，秦淮帘幕长干市。\n蓦地愁来，干卿何事。\n梁陈故迹销魂死。\n禁烟时节落花朝，东风芳草含情思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39316,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行 其三 醉后作","author":"王士禛","text":"屈子离骚，史公货殖。\n直须一石懵腾醉。\n胸中五岳不能平，何人解识狂奴意。\n修竹弹文，绿章封事。\n聊将笔墨供游戏。\n茂陵若问马卿才，飘飘大有凌云气。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39317,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行 其四 和云间诸公春闺","author":"王士禛","text":"芍药红酣，蘼芜碧聚。\n罗帏难把春寒护。\n知他何处送愁来，春来却是愁来路。\n莺燕多情，芳菲易度。\n才销几度黄昏雨。\n朝来不忍卷帘看，落花片片辞人去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39318,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行 其五 和云间诸公春闺","author":"王士禛","text":"燕补新巢，花开旧树。\n经时不到南园路。\n水晶帘额又斜阳，风前阵阵飘香絮。\n已怕春来，又愁春去。\n锦屏绣幞留春住。\n为谁僝僽为谁怜，红颜半是青春误。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39319,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行 其六 咏镜","author":"王士禛","text":"香压彤奁，光迎罗幌。\n圆冰背结盘螭样。\n一泓秋水碧如烟，谁教移向妆台上。\n脉脉相看，盈盈难傍。\n影娥池畔凭阑望。\n妆成双镜照明帘，扶渠并蒂波间漾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39320,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小重山 其一 和湘真词","author":"王士禛","text":"行云如梦梦如尘。\n秣陵惆怅事、最伤心。\n当年琼树照临春。\n燕支井，犹带落花痕。\n芳草碧氤氲。\n旧时朱雀桁、几回新。\n青溪休赛蒋侯神。\n风景换，红泪上罗巾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39321,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小重山 其二 和湘真词","author":"王士禛","text":"梦里秦淮清夜游。\n银罂檀板地、几经秋。\n青溪如带掌中流。\n三十曲，曲曲木兰舟。\n锦瑟伴空侯。\n春江花月里、不曾愁。\n折梅何日下西洲。\n音信断，愁上阅江楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39322,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临江仙 梦起","author":"王士禛","text":"宝帐垂垂春梦足，铜壶漏尽金鸾。\n梦中消息去漫漫。\n心情无那，比似越梅酸。\n春事料量归欲去，閒愁酒病多般。\n碧城十二曲阑干。\n游仙枕上，枉自写齐统。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39323,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花 其一 和漱玉词","author":"王士禛","text":"凉夜沉沉花漏冻。\n欹枕无眠，渐听荒鸡动。\n此际閒愁郎不共。\n月移窗罅春寒重。\n忆共锦裯无半缝。\n郎似桐花，妾似桐花凤。\n往事迢迢徒入梦。\n银筝断续连珠弄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39324,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花 其二 和少游","author":"王士禛","text":"啼碎春光莺燕语。\n一片花飞，又是天将暮。\n欲乞放晴春不许。\n黄昏更下廉纤雨。\n春去应知郎去处。\n好属春光，共向郎边去。\n毕竟春归人独住。\n澹烟芳草千重路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39325,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一剪梅 和漱玉词","author":"王士禛","text":"雁语金塘水渐秋。\n遥听菱歌，不见菱舟。\n望君何处最销魂，旧日青山，恰对朱楼。\n九曲长江天际流。\n似写相思，难寄新愁。\n梦魂几夜可曾閒，鹤子山头。\n燕子矶头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39326,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渔家傲 其一 本意和漱玉词","author":"王士禛","text":"南湖西塞花如雾。\n我歌铜斗樵青舞。\n醉后放舟忘处所。\n凫鸥语。\n觉来已是烟深处。\n蒲叶藕花相映暮。\n援琴更鼓潇湘句。\n曲罢月明风叶举。\n谁同住。\n琴高约我蓬瀛去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39327,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渔家傲 其二 出水西门暮抵下关","author":"王士禛","text":"醉向石城呼小艇。\n总持宅畔花将暝。\n绿柳朱阑相掩映。\n波光冷。\n捲帘处处珊瑚镜。\n三日秦淮扶酒病。\n魂销不到燕支井。\n归舸凌风飞鸟竞。\n人初醒。\n清凉山外红霞影。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39328,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉春风 吴陵送春","author":"王士禛","text":"一霎潇潇雨。\n忽报春将暮。\n谢家飞絮沈郎钱，去。\n去。\n去。\n万点红中，五更风里，春归何处。\n画舫桃花渡。\n宝马游丝路。\n眼前还是未残春，住。\n住。\n住。\n明岁今朝，今年明日，此情休负。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39329,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"解佩令 赋余氏女子绣洛神图","author":"王士禛","text":"芝田蘅薄，明珠翠羽。\n想当年、洛水淩波步。\n尚忆君王，留怨种、枕遗金缕。\n为多情、迟君东路。\n神人閒阻。\n神光离合，空怊怅、斜阳烟树。\n今日东阿，也邺下、风流终古。\n最伤心、感甄遗赋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39330,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"婆罗门引 寄袁箨庵用稼轩韵","author":"王士禛","text":"问平安否，金陵南去楚云西。\n望中烟草迷离。\n回首红桥分赋，笔掣翠虹蜺。\n叹青门一别，白社人稀。\n诗狂酒悲。\n老大去、几人知。\n往日荆州作牧，吊古题诗。\n周郎已矣，忆风流、顾曲似当时。\n归来也、两鬓千丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":39331,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]