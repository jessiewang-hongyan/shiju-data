[{"title":"减字木兰花 夏日","author":"周兰秀","text":"晨妆草草。\n绾髻慵梳新样巧。\n捲起帘栊。\n远见荷开满沼红。\n轻摇团扇。\n熏风阵阵轻吹面。\n堤柳条条。\n带雨拖烟拂板桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23043,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 秋怀","author":"周兰秀","text":"叶落平沙，云迷远树。\n山色模糊人唤渡。\n芙蓉笑摘上兰桡，轻鸥惊入波心去。\n衰柳含烟，凉蝉咽露。\n年年重觅王孙路。\n可怜人静玉楼空，满庭芳草家何处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23044,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南歌子第二体 夏景","author":"屠茝佩","text":"待月调莺槛，乘风斗鸭栏。\n妆成茉莉与珠兰。\n簪向鬓边香发、扑冰纨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23045,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子 秋思","author":"屠茝佩","text":"独上楼西。\n绿鬟鸾镜晓妆低。\n半暖乍寒花影静，重思省。\n听得砧声着意整。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23046,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"七娘子 喜晴","author":"屠茝佩","text":"湿云销尽朝阳皎。\n庭前绿遍忘忧草。\n玫瑰香浓，紫霞凌晓。\n重帘不锁炉烟袅。\n树头梅子青多少。\n熏风吹透荷钱小。\n愁在眉山，欣看林表。\n芳菲又恐莺啼早。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23047,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花","author":"胡莲","text":"忆昔相逢银烛底。\n细语难传，弹入瑶琴里。\n隔坐相邀欢未几。\n登楼相望情何已。\n肠断当时书一纸。\n两字鸳鸯，抹却除非死。\n瘦减罗衣都为此。\n秋风吹落梧桐子。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23048,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"风入松 述怀","author":"周慧贞","text":"几回惆怅厌临鸾。\n扶病倚阑干。\n逢人懒整云鬟乱。\n眉儿淡。\n留待郎看。\n消瘦不禁摇扇，遣情聊把琴弹。\n冰弦理罢展琅玕。\n描写恨千端。\n双双飞落檐前燕。\n衔泥转。\n故故成欢。\n何事比来轻去，夜深不得团圞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23049,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"小秦王 柳浪闻莺","author":"吴湘（婉罗","text":"香雾濛濛不肯收。\n丝丝垂柳绾春愁。\n玉骢也解游人意，却听莺声便欲留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23050,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 回文","author":"吴湘（婉罗","text":"好花闻遍啼莺老。\n老莺啼遍闻花好。\n香暖透轻■，■轻透暖香。\n燕来春■■。\n■■春来燕。\n流■■■■，■■■■流。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23051,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 咏菊","author":"吴湘（婉罗","text":"寂寂空庭寒料峭。\n黄花开遍秋光老。\n朔雁正南飞。\n东篱剩数枝。\n玉人妆未竟。\n漫摘簪云鬓。\n菊已瘦霜痕。\n人还瘦几分。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23052,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"吴湘（婉罗","text":"谁家玉笛声呜咽。\n小亭夜月增凄切。\n月又不分明。\n教人怎么听。\n更深人已尽。\n悄有灯和影。\n灯尽欲抛奴。\n谁怜影也无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23053,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"阮郎归 湖上送春","author":"孙瑶英","text":"西陵歌舞送春愁。\n杨花飞满楼。\n杜鹃啼血恨无休。\n闺人欲白头。\n桥六转，荡轻舟。\n湖山非旧游。\n乱红摇落淡烟稠，好句锦囊收。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23054,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"小重山 秋夜","author":"孙瑶英","text":"独坐闲窗午漏敲。\n落花间覆地，语莺娇。\n屏山图画自轻描。\n风阵阵，蟋蟀响庭寥。\n月影上芭蕉。\n离怀无可遣，费推敲。\n囊琴长挂为谁调。\n人瘦也，寂寞是凉宵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23055,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉楼春 闺情","author":"孙瑶英","text":"氤氲绿篆浮香鸭。\n睡起午窗开镜匣。\n纤纤素手整云鬟，银粉淡消红映颊。\n双峰锁翠眉愁压。\n拈得金针还倒捻。\n东风肠断少人知，慵看花间飞蛱蝶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23056,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 咏雪","author":"孙瑶英","text":"仙女天花，忽散遍、满城春色。\n极目处、峰峦银砌，楼台粉饰。\n皓鹤乍离珠阙舞，琼枝忽向瑶阶植。\n看纷纷，应斗早梅芳，成林白。\n沾绣幄，明书室。\n严风紧，迟还急。\n似澄江铺练，蓝田生璧。\n片片飞来疑柳絮，轻轻舞去穿窗隙。\n望川原，万顷月华寒，无尘迹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23057,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南 四时词","author":"吴娟","text":"江南好，柳色绿如烟。\n处处芳菲都是锦，村村红紫漫争妍。\n春暖艳阳天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23058,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南","author":"吴娟","text":"江南好，十里芰荷风。\n雪藕冰桃凉彻骨，珠兰茉莉沁酥胸。\n竹簟睡朦胧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23059,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南","author":"吴娟","text":"江南好，丛桂小山多。\n香气袭人题锦字，清光良夜照银河。\n乞巧待如何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23060,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"望江南","author":"吴娟","text":"江南好，酿雪映梳妆。\n小阁衣寒煨野栗，重帏被冷爇沉香。\n兽炭暖牙床。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23061,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙 春闺","author":"吴贞闺","text":"晓窗怯怯罗衣薄。\n痴打鹦哥豆落。\n呼鬟欲剪雨中花，为甚泪含来，花人情自各。\n睡起青丝关不住。\n织在眉峰一处。\n非愁非病为谁来，痴倚玉楼前，忘却收针刺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23062,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"谒金门 春思","author":"吴静闺","text":"春心老。\n懒向花衙去考。\n功夫一半愁中了。\n睡情殊草草。\n鸟泣春归咽早。\n春去如何去讨。\n啼音说与镜中人，打起相思稿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23063,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人 兰","author":"吴静闺","text":"湘帘水簟秋初捲。\n人在西风宛。\n暗香何处拂衣来，行过画栏深处、蝶徘徊。\n竹溪寒玉曾同倚。\n雪坞清无暑。\n一枝和露碧垂垂，恰似楚江寒雨、夜来时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23064,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐","author":"郝湘娥","text":"帘钩双控。\n时有熏风送。\n恼杀禽声宛转弄。\n惊破午窗残梦。\n分明薄幸回家。\n醒来依旧天涯。\n且莫轻抛珊枕，再从梦里寻他。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23065,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"清平乐","author":"郝湘娥","text":"鹅黄柳色。\n一抹烟如织。\n倚遍南楼莺语寂，又是暮山凝碧。\n忽闻女伴相邀。\n踏青准拟明朝。\n单少绣花鞋子，呼鬟连夜双挑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23066,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"阮郎归","author":"吴芳华","text":"钱塘门外是西湖。\n峰峦天下无。\n断桥一望水平铺。\n楼台入画图。\n歌金缕，醉提壶。\n花鸟破功夫。\n兰桡日日泛清波，载归明月多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23067,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 春日侍祖母母氏，偕诸姊妹游虞山","author":"席瑶林","text":"翠耸虞山春景丽。\n游侍慈闻，更喜联同气。\n柳磴花堤芳草地。\n东风只荡湘裙底。\n仲雍当时曾此寄。\n千古高踪，巾帼犹仰止。\n拂水山庄何处是。\n羞他输与青楼妓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23068,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 家大人病殁贵州黎平府别驾署中，讣至哭奠有作","author":"席瑶林","text":"拜倒筵前，痛椿树、春秋偏促。\n想当日、辞家之任，画纶朱毂。\n绩报循良钦士庶，书传康健欢童仆。\n怎讣音，万里忽飞来，天何酷。\n堂上老，谁寒燠。\n闺中少，谁瞻嘱。\n况左家娇小，更谁卵育。\n易箦魂飞宁目瞑，捧觞肠断难身赎。\n望灵輀，安稳早归来，凭之哭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23069,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 思亲","author":"胡玉莺","text":"无言凝咽。\n难解柔肠千万结。\n倦倚妆台。\n惟愿慈亲入梦来。\n白云望断。\n泪染罗襟红欲遍。\n愁压眉尖。\n怕见春光不捲帘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23070,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 赋得“愿在发而为泽”，和潇湘居士","author":"胡玉莺","text":"春风料峭孤帏冷。\n郁金油腻鸳鸯枕。\n慵整绿鬟偏。\n鹦哥唤槛前。\n朝来新沐溜。\n懒学宫妆斗。\n随意插花枝。\n芬芳只自知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23071,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 吊邻姬","author":"吴湘（若耶","text":"枕冷衾单如未嫁。\n虚度春宵，减却千金价。\n薄命桃花将绽也。\n一朝风雨檐前谢。\n挨尽凄凉多少夜。\n凤去楼空，寂寞应堪怕。\n环佩珊珊何日下。\n妆台闲剩菱花架。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23072,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人 新秋","author":"欧阳珑","text":"井梧簌簌飘黄叶。\n露湿寒螀泣。\n炎熇日日盼秋风。\n怎到秋来萧瑟、更愁侬。\n凭高几度空怀远。\n摇落情何限。\n断蓬心事不谁知。\n除是天孙相诉、有怜时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23073,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"烛影摇红 丰台看芍药","author":"任淑仪","text":"流转韶光，早红药翻阶时节。\n名花盛处说丰台，竟游人如织。\n因见和风丽日。\n也乘闲、兴寻芳陌。\n看来铺锦，望去蒸云，花光欲滴。\n羡杀轻盈，嫣红嫩紫同娇白。\n梭巡小步绕雕栏，衣袂幽香袭。\n随宦喜依亲膝。\n得□高、赏春城色。\n故园此际，绮阁纷披，还堪遥忆。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23074,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"金菊对芙蓉 送茹廷弟就婚广陵","author":"任淑仪","text":"膝下承欢，闺中咏絮，廿年朝夕相依。\n忽骊歌早唱，雁序分飞。\n喜心翻与离情并。\n送尔去、诗赋关雎。\n玉镜台前，好濡彩笔，学画蛾眉。\n遥念博议成时。\n更闲情逸兴，斑管频挥。\n把竹西佳丽，尽入新词。\n偕归官舍应非远，双亲爱、佳妇佳儿。\n深闺阿姊，顿添良友，分韵传卮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23075,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 暮景","author":"吴琪","text":"深院静，漠漠晚云青。\n远树星低萤火乱，画帘风淡燕飞轻。\n楼外坐调筝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23076,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 咏怀","author":"吴琪","text":"不愿为莺，何须似燕。\n也休派作鸳鸯伴。\n空山松雪半生宜，蒲团梦影随云便。\n鹤舞闲庭，香飞画卷。\n楞严读罢桐阴转。\n莲冠未解道人妆，羽衣新样梨花片。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23077,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉楼春 山楼","author":"吴琪","text":"山影入楼刚尺许。\n堤柳阴浓吹作雨。\n帘低不碍野云飞，窗小只容憨燕舞。\n又看明月松梢住。\n渔梦江边无觅处。\n白鸥期我且休归，故园自有莺花主。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23078,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"生查子 子夜体","author":"吴九思","text":"水底月团圞，一似芙蓉镜。\n人向碧溪行，如把菱花映。\n断藕两分开，惟有丝难尽。\n豆蔻已开残，无复同心并。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23079,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渔家傲","author":"吴九思","text":"恼杀风姨不做美。\n名园剪乱胭脂碎。\n窗外残红飞满地。\n都憔悴。\n纷纷尽向风前坠。\n蜂狂蝶翅相从队。\n莺声燕语偏娇媚。\n二十四番花信至。\n君须记。\n吹开吹谢真无谓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23080,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 八月十六夜月","author":"王芳舆","text":"嫦娥岂是无情种。\n昨宵偶被云遮拥。\n今夜好晴天。\n蟾光端正圆。\n欣然重庆赏。\n人月同盈望。\n多少个中情。\n三更坐到明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23081,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"临江仙 月下看绣毬","author":"王芳舆","text":"不分蔫红茜紫色，金波偏照香浮。\n天工巧琢在枝头。\n拥来江上月，抛去素蛾毬。\n最是黄昏人静后，霓裳一曲清幽。\n莫题团扇恐悲秋。\n梨花空怨冷，柳絮总飘愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23082,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 戏六姑春睡","author":"黄蓼鸿","text":"绣帐风开，见牙床有人如雪。\n鲛绡半覆，纤手持蕉叶。\n碧玉花簪，斜坠珊瑚侧。\n春光溢。\n睡情方热。\n梦入巫山月。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23083,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉团儿 春日","author":"黄蓼鸿","text":"满眼繁华莺语巧。\n柳丝垂、春光正好。\n蝶妒妖花，蜂钻劲竹，东风含笑。\n幽香百种枝头缀，更堪怜、舞红堆翠。\n芳草池边，晚霞楼上，令人心醉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23084,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆江南 咏雪","author":"钱慧贞","text":"帘外雪，密洒似银沙。\n飞去隋堤疑柳絮，飘来庾岭认梅花。\n春思落谁家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23085,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 秋日有怀王佩霞世妹","author":"钱慧贞","text":"握别未轻旬。\n回首销魂。\n知君绮阁懒香焚。\n赋得瑶篇来慰我，转触愁新。\n梧叶落纷纷。\n风雨衡门。\n悲秋况是惜离群。\n今夜夜长应有梦，再话殷勤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23086,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蝶恋花 饯春日值雨","author":"钱慧贞","text":"风捲残红春已暮。\n垂柳丝长，暂绾东君住。\n天意哪知人恨处。\n廉纤几阵纱窗雨。\n把酒饯春春不语。\n春既无情，一任匆匆去。\n湿尽金衣莺诉苦。\n凭栏又触愁如许。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23087,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"洞仙歌 敬题张荫嘉母舅《乐圃词钞》后","author":"钱慧贞","text":"铜琶牙板，数词家名手。\n柳腻苏豪孰兼有。\n豁双眸、舅氏乐圃词钞，真莫怪、脍炙骚坛人口。\n慈亲题语在，记得年时，曾向妆台课停绣。\n篇什富珠玑，击节人亡，低唱罢、泪沾红袖。\n愿本意、早填谒金门，使屈姊、舒开夜台眉皱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23088,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水调歌头 送外之金陵应试","author":"钱慧贞","text":"夫子富才调，宝剑岂长埋。\n晚成当此时矣，去去莫疑猜。\n但向蓬窗茅店，珍重风餐露宿，漫念米和柴。\n弱质纵非健，门户学持来。\n桃叶渡，伤心窟，古休怀。\n三场为我，鏖战努力步云阶。\n好趁桂花香里，玩罢板桥明月，归棹理秦淮。\n端正拂尘酒，何惜拔金钗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23089,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"唐多令","author":"钱慧珠","text":"闺阁少清游。\n今朝破积愁。\n九龙遥、风送兰舟。\n听罢松涛茶斗品，如画景、小亭收。\n字减与声偷。\n蛮笺韵各搜。\n羡前贤、石壁题留。\n难道山名分慧好，偏巾帼、柳苏羞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23090,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水龙吟 忆家慈客武林","author":"钱慧珠","text":"男儿尚怕饥驱，奈何吾母传经远。\n平安虽报，主贤弟慧，老怀可遣。\n犹恐慈亲，或怜幼女，慰辞宛转。\n只六桥花柳，三春赏遍，添吟兴、眉应展。\n但是宵来梦见，怎愁容、数声长叹。\n痛椿早萎，伤萱遥隔，冷闺肠断。\n欲诉离情，吴山越水，寡鱼稀雁。\n待何时，再得绕娘膝下满，将雏愿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23091,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"画堂春","author":"蓉湖女子","text":"冷莎铺月树穿星。\n秋棠褪尽红英。\n鹭鸶两两浴兰汀。\n湿浪吹萍。\n雾气捲开山色，云光流出溪声。\n湘帘斜捲绿烟凝，人倚银屏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23092,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 仿王修微回文","author":"蓉湖女子","text":"镜开羞学新妆靓。\n靓妆新学羞开镜。\n离别怕迟归。\n归迟怕别离。\n绿痕螺黛促。\n促黛螺痕绿。\n千万约来年。\n年来约万千。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23093,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卜算子","author":"蓉湖女子","text":"刬袜坠金菱，髻溜琼妆亸。\n为爱鹦哥红豆抛，莫认车边果。\n曲槛小屏山，月淡花如雾。\n倦倚檀肩数乱星，数到牵牛住。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23094,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"少年游","author":"蓉湖女子","text":"斜风捲水，平芜吹侧，波面细于丝。\n杨柳烟中，蓼花影里，密树度云迟。\n藤床八尺龙须席，卧听晚蟾嘶。\n携却楸枰，沉吟应劫，抛局数残棋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23095,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 冬日写梅作","author":"丁一揆","text":"素梅点点铺香雪。\n疏篁渐长凌云节。\n同结岁寒盟。\n冰霜不易心。\n罗浮当日种。\n翠羽双栖共。\n看取绿盈枝。\n和羹结子时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23096,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤栖梧 观庭梅","author":"丁一揆","text":"半折琼蕤香暗吐。\n相对盈盈，似欲将愁诉。\n傲骨天生谁与护，可怜零落埋荒圃。\n忆昔广平曾作赋。\n千载寥寥，若个知音和。\n受尽几多霜雪妒，算来总是东皇误。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23097,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 溪花","author":"董如兰（畹仙","text":"小立崖前支晓风。\n宜人偏在露华浓。\n盈盈临水自矜容。\n翠鸟啄馀青茎子，游鳞疑狎粉香丛。\n蓬窗撩乱画图中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23098,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"大江东去 燕台归思","author":"董如兰（畹仙","text":"羁人情绪，似禽鱼、误入绦笼难出。\n极目乡关何处是，云树苍烟遥隔。\n不敢哀号，恐惊肠断，默默空凄恻。\n自家儿女，怎叫他个怜惜。\n应叹两字功名，半生劳顿，堪笑还堪咄。\n离别伤心梦中相，聚后醒来悲泣。\n误我归期，欺他归约，各度如年日。\n君平频问，故国何日归得。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23099,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"大江东去 前题","author":"董如兰（畹仙","text":"忧深如病，万千愁、欲说伤心还歇。\n是岁三春挨过了，怎使重挨夏月。\n将近初秋，归鞭未整，酷日同心热。\n啼痕新旧，积来犹胜鹃血。\n千里有限关河，无穷荆棘，鱼雁难飞越。\n异日相逢须记取，今后再休轻别。\n魂梦堪怜，朝朝暮暮，不解辞登涉。\n他时归去，定教真个欢悦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23100,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"大江东去 午日和韵","author":"董如兰（畹仙","text":"端阳重遇，可应是、辗转天高难越。\n炫日葵榴疑是泪，触景偏增呜咽。\n三载离乡，两经兵火，孤负芳时节。\n五丝续命，寸肠应被千结。\n休问鼓吹谁家，龙标何处，风鹤成警怯。\n魂梦飞扬旁人须，讶道鬓斑形劣。\n渔父忘言，汨罗留恨，醉醒凭人说。\n伶仃儿女，有谁为我疼热。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23101,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"捣练子 其一 春","author":"董如兰（畹仙","text":"花寂寂，昼阴阴。\n枕是朦胧听晓禽。\n病里不知春又半，连天草色雨中深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23102,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"捣练子 其二 冬","author":"董如兰（畹仙","text":"初肥兔，照寒窗。\n窥探离愁眉锁双。\n灯火连宵金穗重，从今不信谎银缸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23103,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忆王孙","author":"董如兰（畹仙","text":"庭前新水色如蓝。\n谷雨初旬共浴蚕。\n山家少妇指纤纤。\n各携篮。\n日照柔桑露叶含。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":23104,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]