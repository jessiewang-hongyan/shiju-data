[{"title":"澄江旅舍尤展成见贻近刻","author":"曹重","text":"逢君郭璞宅，云影入江寒。\n绿柳遥侵袂，青山早挂冠。\n一镫家是梦，千里月同看。\n持赠阳春曲，高歌玉漏残。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9495,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送董苍水游粤","author":"曹重","text":"桃榔山下月，旅舍白云间。\n此地堪凭吊，怜君独往还。\n文章惊怪鳄，书信断乌蛮。\n陆贾归囊满，风流复可攀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9496,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"北上于袁浦发家书","author":"黄九河","text":"丈夫志四方，不受儿女羁。\n苟怀万里志，劳勚何足辞。\n昨发海陵城，今宿淮水湄。\n附书于送徒，援笔中心悲。\n亲亡两弟弱，支户惟中闺。\n水旱岁频仍，全家常苦饥。\n官租宜早办，西畴勤耘耔。\n幼弟学易荒，肃恭承明师。\n回首望螺山，先垄草离离。\n远行恋所生，贫贱无归期。\n苟能行直道，何惧路险巇。\n长安多亲旧，音驿日夜驰。\n纸短苦意长，挑灯重封题。\n欠伸启篷窗，月落村鸡啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9497,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"疏池","author":"安璿","text":"濠濮平生志，疏池且自今。\n双峰来瀑远，一壑倚云深。\n亦有烟波色，堪怡澹荡心。\n聊迟十年梦，终向五湖寻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9498,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"淮南拈唐人韵顾梁汾同赋","author":"安璿","text":"极目淮南水，苍茫接远天。\n暂辞胶鬲里，同泛米家船。\n疏懒难为客，衰迟莫问年。\n长途凄绝处，雁字点秋烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9499,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"访严髻珠先生于湖田不遇","author":"安璿","text":"渡入蒹葭即草庐，云深三径俗尘疏。\n青苔昼掩维摩室，红叶秋生水竹居。\n谢客湖田常挂榻，送僧山寺漫停车。\n已知杖履归来晚，独逞天风唱步虚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9500,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"旧江口","author":"安璿","text":"望里真州路尚遥，人烟沙市接江潮。\n虚亭飒爽晚来坐，一带秋山隔岸招。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9501,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"依韵答仝青崖","author":"袁养","text":"麟阁谁将姓字标，驱驰髀骨已全销。\n谈禅说剑足今古，浊酒清歌伴寂寥。\n非为仙缘寻玉杵，偶逢国士解金貂。\n流莺不放春归去，犹逐薰风啼画桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9502,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"刘文水建牙粤东赋此寄怀","author":"袁养","text":"黄河此日见澄清，不负当年独请缨。\n虎豹一囊资大略，东南半壁倚长城。\n无缘莲幕亲弓剑，深感鱼书念友生。\n伫看边防驰露布，将军海外斩妖鲸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9503,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过樱桃岩闻箫","author":"杨还吉","text":"一溪春水绿迢迢，二月溪旁雪未消。\n行尽空山人不见，樱桃岩外听吹箫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9504,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋雨中忆范文庄出塞","author":"杨还吉","text":"燕山八月迥深秋，匹马何因作壮游。\n碛里行人逢暮雨，思君遥过小兴州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9505,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"中秋访王维宪不遇","author":"徐田","text":"雨过沧浪秋水生，季孙城外故人情。\n柴门碧草蟏蛸网，古巷黄蒿蟋蟀声。\n何处狂奴贪说剑，恒来娇女亦知名。\n篱边劳尔乌尨吠，隔市斜阳乱杵鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9506,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自楚归寄同社诸友","author":"徐田","text":"逆旅长歌动客星，杨花化作楚江萍。\n仙人玉笛横江夏，贾客云帆出洞庭。\n说剑荆台花匼匝，吹箫吴市雨淋铃。\n亲知莫讶头毛白，一杖全收五岳青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9507,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"吊衡州","author":"于式敷","text":"牝鸡戎晨鸣，光皇昵悍妇。\n历岁不过宫，天寒且饮酒。\n丞相去江亭，谏官空碎首。\n弥留饭不食，丧幄谁执卣。\n多言良可畏，百僚弃笏走。\n嗟哉此何时，宗臣忍袖手。\n大叫朝天门，割死差无疚。\n天启忠良心，定变机非偶。\n宛转达太皇，嘉王可为后。\n御笔好从权，磐石安九有。\n授鼎负白龙，祥符兆已久。\n赫赫社稷功，万古兹难朽。\n经筵半老儒，新政初无丑。\n失策忤权奸，酿祸大而厚。\n閤门功炀灶，台谏甘为狗。\n簧鼓乌白头，假梦言真否。\n伪学锢诸贤，以公为祸薮。\n迁谪投穷荒，弃掷同敝帚。\n何物韩平原，逢恶衡州守。\n一死诚所欠，身后公何有。\n是非不可没，啧啧碑在口。\n麟笔建阳翁，注《骚》求快友。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9508,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"处子吟","author":"李生光","text":"东邻有处子，夙明烈女篇。\n字人尚未嫁，而乃失所天。\n痛兹生命薄，守贞期自全。\n毁容绝膏沐，矢志壹且坚。\n爱人贵以德，姑姊莫相怜。\n侃辞谢媒妁，何用口諓諓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9509,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晚渡金山","author":"周以忠","text":"一柱虚空插，奔流荡夕晖。\n云迷两岸合，月剩一僧归。\n面面波涛涌，层层殿阁围。\n有山看不见，塔影人江飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9510,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"冬日怀石孟坚","author":"卫京","text":"数日不一见，便生离别心。\n况兼寥阔久，更值暮寒深。\n剡雪徒相忆，江春不可寻。\n所怀成落落，言念苦长吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9511,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"真州江上逢故人","author":"刘梁桢","text":"片帆乘夜发，凉月渡头昏。\n渔火明沙岸，江流绕郭门。\n蹉跎皆鬓短，耆旧几人存。\n山色依然绿，相携倒玉樽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9512,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"沁水道中","author":"王衡","text":"石径绕寒山，秋风在溪水。\n前村几处烟，没入朝云里。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9513,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西湖杂诗","author":"路一麟","text":"华岳高寒石磴斜，飞流倒树乱槎丫。\n玉荷十丈惊人眼，何用包庄满路花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9514,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宿莲花山寺","author":"樊必遴","text":"山头留古刹，客到且羁栖。\n回望高天近，平分落日低。\n钟声风上下，塔影月东西。\n间共僧拈句，何妨壁上题。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9515,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠吴宾贤","author":"张谦","text":"朝暮多悲风，吹君海上屋。\n君当未衰时，早已谢荣辱。\n吟诗二十年，空斋苔藓绿。\n戎马遍乾坤，贫老甘林麓。\n贱子苦风尘，古道蒙相属。\n誓当归旧林，饥饿栖穷谷。\n君钓槎头鱼，我侣涧边鹿。\n万里岁寒心，相望慰幽独。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9516,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平山春望","author":"张谦","text":"迥立高原上，凭虚望远天。\n对江山敛雾，近郭水生烟。\n钟磬闻村寺，笙歌过酒船。\n隋家遗柳树，长使后人怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9517,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潮阳道中","author":"蓝涟","text":"潮水初平绿半湾，人家门口举罾还。\n烟墩东去潮阳路，三面沧波一面山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9518,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南台桥","author":"蓝涟","text":"四十年前白石桥，大旗风紧马萧萧。\n行人不管双溪水，流出桥东作海潮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9519,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏史 其一","author":"蔡衍鎤","text":"燕丹得荆卿，名声惊六国。\n已感燕丹恩，思报燕丹德。\n悠悠易水寒，飒飒风萧瑟。\n壮士从此去，飘然入秦域。\n气凌帝王尊，图穷无变色。\n剑术虽云疏，谁不谓勇力。\n壮哉匹夫志，之死矢靡慝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9520,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏史 其二","author":"蔡衍鎤","text":"汉文亦有道，贤相亦盈庭。\n求言何其切，当时得贾生。\n抗陈无所讳，少年而老成。\n惜哉遇合难，上书竟不听。\n去去勿复顾，坐看湘水清。\n湘水自悠悠，哀哀痛哭声。\n吊之竟何戚，千古一同情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9521,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丹山","author":"蔡衍鎤","text":"日色背层峦，轻霜午未乾。\n人言抱朴子，隐此白云间。\n凿石堪为鼎，烹砂便作丹。\n名山虽尚在，古灶已生寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9522,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸡鸣曲","author":"钱奕","text":"银湾迢递明星烂，寒夜鸡鸣夜方半。\n闺人宵起发哀叹，辗转虚楹旦复旦。\n玉漏声寒闻捣衣，霜清露白孤鸿飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9523,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游侠篇","author":"钱奕","text":"区罗春酒琥珀光，腰横宝锷驰新装。\n尊前唤舞出翠蛾，长啸为歌君马黄。\n遍历间关学走马，春风拂面颜如赭。\n雄名落落不轻许，相逢剧孟论心寡。\n借交报怨来长林，摴蒱一掷千黄金。\n高谭四座皆辟易，押衙专诸有同音。\n君不见易水汤汤吹变徵，又不见渐离击筑咸阳市。\n士怜知己不顾身，古来节侠多如此。\n仆本壮夫为尔歌，阳乌欲坠暮山紫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9524,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"恭和魏总宪望孤竹感怀","author":"赵端","text":"驱车右北平，孤竹遗风古。\n缅怀采薇人，高义长虹吐。\n逃名非所知，祇不愧仰俯。\n孔孟许成仁，黄农歌自苦。\n只今千载下，祠庙荒烟雨。\n后贤景余芳，努力勤救补。\n宪府肃双旌，神君凛铜虎。\n卓哉希圣心，清风满三辅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9525,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重九后一日游黄崖山顶","author":"赵端","text":"黄崖绝顶雁行低，历险移樽万仞梯。\n风定白云生几席，日斜沧海见虹霓。\n翻怜下界花盈眼，却爱层峦鸟自啼。\n薄醉遄归龙眼冷，笳声遥起塞桓西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9526,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜坐有感","author":"曹三才","text":"纤月如钩挂碧空，秋声无数扑镫虫。\n明知是火争投隙，多少趋炎世路中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9527,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜同人小集用醧舫夫子韵","author":"王浤","text":"鱼买罾船酒买坊，故人倒醉竹间床。\n蛩吟败草声逾咽，露下高梧夜转凉。\n三寸霜柑初入馔，头番黄爵未黏糖。\n不嫌山野盘飧薄，更煮秋菘杂紫姜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9528,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"约友香塘看梅","author":"张琳","text":"近说香塘路，丛梅照眼新。\n我思携酒伴，去觅咏花人。\n冷淡全胜雪，孤高不受尘。\n悬知今夕梦，不到故山春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9529,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"王正四日饮莼客西枝草堂","author":"张琳","text":"柴门虽设未尝关，要看江中远近山。\n相见便成终日醉，商量莫放一春间。\n新花似绮初经眼，芳草撩人笑解颜。\n闻道将游东鲁地，离声先入鹧鸪斑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9530,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"初晴喜赵何二君过访小酌爽斋次莼客韵","author":"张琳","text":"苔痕水涨屐声稀，客爱新晴叩短扉。\n三径树明初日嫩，半窗花静午风微。\n提壶稚子穿林到，得食幽禽傍砌飞。\n略有山家清意味，劝君不醉且无归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9531,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次日再集西枝草堂","author":"张琳","text":"绿树连村客到稀，坐闻流水撼松扉。\n湿云乍敛山容瘦，小病初廖酒力微。\n含蕊一花当槛放，引雏双燕出帘飞。\n桥门新涨难通楫，漫整棕鞋踏月归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9532,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"越王城","author":"杨琅树","text":"寂寂越王城，日落荒云起。\n城中贮暮寒，人立秋声里。\n衰草封颓基，残烟连断垝。\n石门汉时出，珠江越国水。\n山水而有灵，亦忆越王否？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9533,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"孤雁","author":"杨琅树","text":"孤雁悲明月，凄声惊我帏。\n恰如逃亡民，哀哀无所归。\n开窗语孤雁，前途慎知机。\n莫因山谷冷，转从城市飞。\n健儿聚无事，挟弹有余威。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9534,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"王明君","author":"杨琅树","text":"明妃嫁单子，非关画图误。\n自是汉孱弱，无人阵黄雾。\n君王重黎民，岂惜一佳人。\n琵琶方出塞，已罢玉关军。\n虎臣飞将乃如此，万里长城在女子。\n汉宫寂寞是谁羞，毡帐风光非妾喜。\n薄命自羞还自歌，寄语君王慎干戈。\n后宫莫选颜色女，单于无厌当奈何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9535,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赋得隋宫燕","author":"杨琅树","text":"空梁故垒渐成尘，宛转犹寻旧日春。\n几度自来还自去，宫中不见卷帘人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9536,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"悔人先生移居","author":"刘逴后","text":"短栅疏篱罥绿萝，蒹葭深护水云阿。\n槎丫社树霜中秀，上下风帆屋后多。\n驱犊几家来牧笛，采莲十里发清歌。\n元龙豪气全销尽，匣里青萍不用磨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9537,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宿翠微堂分赋","author":"蒋鲁传","text":"秋山木叶下，云净晚天开。\n月色寒冰簟，江声落酒杯。\n共谭《高士传》，间卧楚王台。\n不尽三更话，幽钟枕上来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9538,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"留别李茶田昆季","author":"李爔","text":"鸿南雁北意如何，一揖还家愧伏波。\n海上风烟君未定，天边悲愤我犹多。\n已无寸舌随张禄，空请长缨对尉陀。\n为属他时车笠下，莫将金印狎渔蓑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9539,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暮经金正希先生故宅","author":"谢天墀","text":"秋水绕六溪，秋云黯澹白。\n鸺鹠趁暮啼，疏萤映南陌。\n草市阒无声，蓬蒿隐荒宅。\n镫火漏余熠，微月澹魂魄。\n乾坤厄阳九，节义刊金石。\n龙去髯难攀，鹃啼血化碧。\n风骚嗣三闾，哀怨留南国。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9540,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"访茶村先生不值","author":"彭心锦","text":"十庙门西野草新，客来何处有风尘。\n青山正好当斜照，白发无从觅此人。\n家远不闻江上鹤，书成徒泣梦中麟。\n陶公乞食将安往，应指鸡笼堕泪频。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9541,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄怀故园诸同学","author":"彭心锦","text":"赋罢《登楼》感仲宣，吴头楚尾望茫然。\n人留淮海书难得，雁过衡阳信未传。\n千里梦魂天似水，一窗镫火夜如年。\n可怜茅屋深山里，几树寒梅抱雪眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9542,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟发丹阳","author":"邓士琎","text":"一声柔橹破空濛，叉手间吟倚短篷。\n山色送青新雨后，水光摇翠早春中。\n伯图从古夸荆国，花事于今忆渚宫。\n却怪石尤多作恶，乡情应是两人同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9543,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"龙门滩闻鹧鸪","author":"彭一楷","text":"世路曲如此，中流石复多。\n鸟言行不得，人在险中过。\n树色笼深雾，山根沸乱波。\n扁舟归兴切，未许问烟萝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9544,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宿车补旃木石居","author":"王元复","text":"久从少壮号通儒，自愧明经我不如。\n木石有缘堪共老，胸襟无碍任安居。\n磻溪石上钩难曲，茂叔庭前草不除。\n眼底风光今老矣，青山冉冉爱吾庐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9545,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"侍家大人宿灵乌道院","author":"车无咎","text":"一镫悬斗室，父子宿余明。\n古壁沈沈夜，高堂寂寂情。\n何来风雨急，兼送竹梧声。\n远愧温衾士，能无忝所生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9546,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寓中元旦和元叔韵","author":"陶烜","text":"来日春风又打头，江干重理旧羊裘。\n时闻北阙方求骏，家在南山且饭牛。\n年例竞趋如鹜走，人情大抵习韦柔。\n柴桑幸不成蹊径，松影常依杜若洲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9547,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"兵后入故里","author":"刘祖启","text":"不到家乡久，今来事却非。\n苍茫三径在，耆旧几人归。\n乱草侵残雨，荒池带落晖。\n秋风吹短鬓，愁绝倚柴扉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9548,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"吴江道中","author":"刘祖启","text":"朝辞虎丘去，道出太湖旁。\n比屋皆临水，平田半种桑。\n秋声生落木，雨色隐斜阳。\n向晚吴歌起，中流意渺茫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9549,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西山望海","author":"何霟","text":"木脱山高眼了然，更当晴午不生烟。\n明明海色遥含日，白白霜痕竫贴天。\n无那崖门思往事，若为蓬岛挟飞仙。\n平生几许乘桴意，尽在临风引领前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9550,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江村夜泊","author":"梁素","text":"酒醒镫冷梦频惊，吟傍芦花客思清。\n木落晴林秋几树，潮平寒浦月三更。\n荒村有影江烟澹，古岸无人石气横。\n东望海门天际远，乱峰稠叠白云生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9551,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过大觉庵","author":"王灿","text":"高刹踞峰头，登临俯一州。\n斗城当寺立，弓水抱村流。\n云白禅机静，霜青古木秋。\n尘劳何日息，常向此间游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9552,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"古意 其一","author":"张坦","text":"孟尝广致客，鸣吠亦不辞。\n士为知己用，何者不可为。\n遂谓鸡狗辈，生平尽于斯。\n尺蠖与虬龙，屈伸在一时。\n丈夫以身许，逃义奚所之。\n所以鲁仲连，高蹈东海湄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9553,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"古意 其二","author":"张坦","text":"我登黄金台，郭隗今何往。\n礼士在推心，千金等土壤。\n士也为利趋，襟怀亦可想。\n躄者夺所爱，高风群钦仰。\n台以黄金名，宜乎委草莽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9554,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"古意 其三","author":"张坦","text":"昨日逢寒士，酒暖肝胆揭。\n今日游朱门，更见五情热。\n织素与织缣，新旧各异辙。\n共羡桃李花，谁看松柏雪。\n郁郁抱孤怀，炎凉浑无别。\n宁为世所嫌，毋为世所悦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9555,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"古意 其四","author":"张坦","text":"楚汉征战处，英雄时已备。\n龙准与重瞳，驾驭无绊骥。\n狂哉阮嗣宗，睥睨竖子视。\n身当割据时，昏酣遗世事。\n清谈生春风，坐看中原坠。\n废事犹可为，误事难引缒。\n千古褫权奸，清流即其次。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9556,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"古意 其五","author":"张坦","text":"小园种花时，不得郭橐驼。\n其手补造化，其心备天和。\n全活在人为，生机物云多。\n此身有精气，白驹牛马过。\n抚心长叹息，风尘易消磨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9557,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小鸟","author":"张坦","text":"小鸟名难辨，低飞转不穷。\n常虚鹰隼逐，纵入网罗空。\n暗叶寻虫细，柔条啄果红。\n笑他九万里，终待北溟风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9558,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]