[{"title":"乌鲁木齐杂诗之风土 其一","author":"纪昀","text":"山围芳草翠烟平，迢递新城接旧城。\n行到丛祠歌舞榭，绿氍毹上看棋枰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31242,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其二","author":"纪昀","text":"万家烟火暖云蒸，销尽天山太古冰。\n腊雪清晨题牍背，红丝砚水不曾凝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31243,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其三","author":"纪昀","text":"乱山倒影碧沉沉，十里龙湫万丈深。\n一自沉牛答云雨，飞流不断到如今。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31244,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其四","author":"纪昀","text":"云满西山雨便来，田家占候不须猜。\n向来只怪东峰顶，晓日名霞一片开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31245,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其五","author":"纪昀","text":"廛肆鳞鳞两面分，门前官柳绿如云。\n夜深灯火人归后，几处琵琶月下闻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31246,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其六","author":"纪昀","text":"雪地冰天水自流，溶溶直泻苇湖头。\n残冬曾到唐时垒，两派清波绿似油。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31247,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其七","author":"纪昀","text":"山田龙口引泉浇，泉水惟凭积雪消。\n头白蕃王年八十，不知春雨长禾苗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31248,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其八","author":"纪昀","text":"界破山光一片青，温暾流水碧泠泠。\n游人倘有风沂兴，只向将军借幔亭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31249,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其九","author":"纪昀","text":"古迹微茫半莫求，龙沙舆记定难收。\n如何千尺青崖上，残字分明认火州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31250,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其十","author":"纪昀","text":"南山口对紫泥泉，回鹘荒滕尚宛然。\n只恨秋风吹雪早，至今蔓草幂寒烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31251,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其十一","author":"纪昀","text":"城南风穴近山坳，一片涛声万木梢。\n相约春来牢盖屋，夜深时卷数重茅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31252,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其十二","author":"纪昀","text":"良田易得水难求，水到深秋却漫流。\n我欲开渠建官闸，人言沙堰不能收。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31253,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其十三","author":"纪昀","text":"银瓶随意汲寒浆，凿井家家近户旁。\n只恨青春二三月，却携素绠上河梁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31254,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其十四","author":"纪昀","text":"秋禾春麦陇相连，绿到晶河路几千。\n三十四屯如绣错，何劳转粟上青天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31255,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其十五","author":"纪昀","text":"白道飞流似建瓴，陡陀不碍浪花鸣。\n游人未到萧关外，谁信山泉解倒行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31256,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其十六","author":"纪昀","text":"半城高阜半城低，城内清泉尽向西。\n金井银床无用处，随心引取到花畦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31257,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其十七","author":"纪昀","text":"长波一泻细涓涓，截断春山百尺泉。\n二道河旁亲驻马，方知世有漏沙田。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31258,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其十八","author":"纪昀","text":"南北封疆画界匀，云根两面翠嶙峋。\n中间岩壑无人迹，合付山灵作守臣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31259,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其十九","author":"纪昀","text":"双城夹峙万山围，旧号虽存旧址非。\n孤木地旁秋草没，降蕃指点尚依稀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31260,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其二十","author":"纪昀","text":"峻坂连连迭七层，层层山骨翠崚嶒。\n行人只作蚕丛看，却是西番下马陵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31261,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其二十一","author":"纪昀","text":"断壁苔花十里长，何年雄镇控西羌。\n金瓶舍利行人息，筑塔当从阿育王。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31262,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其二十二","author":"纪昀","text":"惊飙相戒避三泉，人马轻如一叶旋。\n记得移营千戍卒，阻风港汊似江船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31263,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之风土 其二十三","author":"纪昀","text":"开畦不问种花辰，早晚参差各自新。\n还忆年前木司马，手栽小盎四时春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31264,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之游览 其一","author":"纪昀","text":"秀野亭西绿树窝，杖藜携酒晚春多。\n谯楼鼓动栖鸦睡，尚有游人踏月歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31265,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之游览 其二","author":"纪昀","text":"斜临流水对山青，疏野终怜旧射厅。\n颇喜风流丰别驾，迩来拟葺醉翁亭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31266,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之游览 其三","author":"纪昀","text":"绛蜡荧荧野未残，游人踏月绕阑干。\n迷离不解春灯谜，一笑中朝旧讲官。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31267,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之游览 其四","author":"纪昀","text":"犊车辘轣满长街，火树银花对对排。\n无数红裙乱招手，游人拾得凤凰鞋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31268,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之游览 其五","author":"纪昀","text":"摇曳兰桡唱采莲，春风明月放灯天。\n秦人只识连钱马，谁教歌儿荡画船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31269,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之游览 其六","author":"纪昀","text":"地近山南估客多，偷来番曲演鸯歌。\n谁将红豆传新拍，记取摩诃兜勒歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31270,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之游览 其七","author":"纪昀","text":"箫鼓分曹社火齐，登场相赛舞狻猊。\n一声唱道西屯胜，飞舞红笺锦字题。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31271,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之游览 其八","author":"纪昀","text":"竹马如迎郭细侯，山童丫角啭清讴。\n琵琶弹彻明妃曲，一片红灯过彩楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31272,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之游览 其九","author":"纪昀","text":"玉笛银筝夜不休，城南城北酒家楼。\n春明门外梨园部，风景依稀忆旧游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31273,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之游览 其十","author":"纪昀","text":"越曲吴歈出塞多，红牙旧拍未全讹。\n诗情难似龙标尉，好赋流人水调歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31274,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之游览 其十一","author":"纪昀","text":"樊楼月满四弦高，小部交弹凤尾槽。\n白草黄沙行万里，红颜未损郑樱桃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31275,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之游览 其十二","author":"纪昀","text":"乌巾垫角短衫红，度曲谁如鳖相公。\n赠与桃花时颒面，筵前何处不春风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31276,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之游览 其十三","author":"纪昀","text":"半面真能各笑啼，四筵绝倒碎玻璃。\n摇头优孟谁描写，拟付龙门作品题。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31277,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之游览 其十四","author":"纪昀","text":"逢场作戏又何妨，红粉青娥闹扫妆。\n仿佛徐娘风韵在，庐陵莫笑老刘郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31278,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之游览 其十五","author":"纪昀","text":"老去何戡出玉门，一声楚调最消魂。\n低徊唱煞红绫裤，四座衣裳宛酒痕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31279,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之游览 其十六","author":"纪昀","text":"稗史荒唐半不经，渔樵闲话野人听。\n地炉松火消长夜，且唤诙谐柳敬亭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31280,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之游览 其十七","author":"纪昀","text":"桃花马上舞惊鸾，赵女身轻万目看。\n不惜黄金抛作埒，风流且喜见邯郸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31281,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题疏勒望云图","author":"左宗棠","text":"男儿有志在四方，欲求亲显须名扬。\n自来尽忠难尽孝，征人有母不遑将。\n提戎自少贫且贱，学书不成去学剑。\n膂力刚强原过人，手挽乌号长独擅。\n适值潢池盗弄兵，东南半壁烽烟横。\n我时陈师扫群丑，三千貔虎屯长营。\n提戎牵裾别慈母，誓志从戎来江右。\n隶我军籍随我征，勇气百倍无与偶。\n浙闽东粤及秦中，转战所向皆有功。\n戎马驰驱度西陇，勋名懋著何英雄。\n嗣后回酋肆猖獗，我复出关持节钺。\n提戎敌忾效前驱，马蹄蹴破天山雪。\n万里遄征久未归，远羁疏勒隔庭闱。\n登亭南望一翘首，多情时逐白云飞。\n云弥高兮不可步，亲舍迢遥渺何处？\n边塞秋风匝地寒，吹起心旌无定住。\n迩年捧檄来闽疆，絮养犹然憾未遑。\n同是异乡空陟屺，此怀绵邈长更长。\n嗟呼举世趋薄俗，每以途人视骨肉。\n提戎雅有至性存，尚有一言为尔勖。\n我今解组老归田，不忘魏阙心犹悬。\n海防善后事孔急，将士还须猛着鞭。\n提戎素来禀慈训，身受君恩逾感奋。\n终当移孝作忠臣，为我国家扶厄运。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31282,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"侯桂龄《疏勒望云图》","author":"郭嵩焘","text":"安西万里道重开，翊运先收颇牧才。\n狼燧烟从沙际出，龙堆云自地中来。\n望穷葱岭心常恋，衣寄蒲犁手自裁。\n今日三山风景丽，板舆新度钓龙台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31283,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"侯桂舲军门以《疏勒望云图》属题，赋五言四章 其一","author":"杨昌浚","text":"莽莽万重云，天低日易曛。\n楚江杳何许，葱岭黯难分。\n良马因时出，慈乌返哺闻。\n高台真独立，谁写李将军。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31284,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"侯桂舲军门以《疏勒望云图》属题，赋五言四章 其二","author":"杨昌浚","text":"誓扫龙庭日，男儿万里征。\n短衣随汉将，长剑出秦城。\n红柳迷乡邑，黄沙决死生。\n楼兰方未斩，敢恤倚闾情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31285,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"侯桂舲军门以《疏勒望云图》属题，赋五言四章 其三","author":"杨昌浚","text":"快睹旄头落，中兴建武功。\n栖身千里外，锡类八荒同。\n弓挂天山雪，笳吹瀚海风。\n归来将母念，犹认去时容。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31286,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"侯桂舲军门以《疏勒望云图》属题，赋五言四章 其四","author":"杨昌浚","text":"专阃开南服，斑衣慰北堂。\n承欢陔草茂，回首阵云凉。\n忠孝一生事，艰难百战场。\n披图期努力，爱日报正长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31287,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"《疏勒望云图》题咏四首 其一","author":"彭玉麟","text":"百战犹闻出塞吟，黄沙白草阵云深。\n穷边万里思亲泪，苦恨霜华两鬓侵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31288,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"《疏勒望云图》题咏四首 其二","author":"彭玉麟","text":"赵信城边万马骄，望云台上月轮高。\n西征壮士听笳夜，秋雁南飞认斗杓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31289,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"《疏勒望云图》题咏四首 其三","author":"彭玉麟","text":"虎头燕项封侯骨，捷奏红旌报建章。\n痛饮黄龙真快意，帐前生缚谷蠡王。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31290,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"《疏勒望云图》题咏四首 其四","author":"彭玉麟","text":"圣武中兴日月开，汉家版宇过轮台。\n玉门关外梅花发，入我春风笔底来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31291,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"游蓝渚庵","author":"周良翰","text":"空山开古刹，载酒到泉林。\n涧阔松涛静，钟间梵宇深。\n猿声和笛啸，鸟语杂樵吟。\n悬崖同僧话，白云一片心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31292,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"次定侯隣石游蓝渚庵韵","author":"谢家驹","text":"古迹蓝渚寺，今为翰墨林。\n清心碧水澹，雅志白云深。\n东井奎星气，南阳梁父吟。\n调美端有待，蚤起慰皇心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31293,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"华清宫","author":"李兆龄","text":"华清宫殿久埃尘，秪此温泉浴太真。\n白玉莲花何处去，空留一水艳行人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31294,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"骊山温泉","author":"任端书","text":"今古骊山路，仍流礜石汤。\n溶溶轻泛玉，冉冉细含香。\n春色华清老，閒愁白日长。\n莲花空绕砌，不见浴鸳鸯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31295,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"华清池大雨","author":"张祥河","text":"东来小驻雨中车，苑径宫墙故故斜。\n疑取玉峰洗头水，倾盆浇上玉莲花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31296,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"骊山怀古","author":"周煌","text":"十月骊山驾未回，龙鬐凫翼倚莲开。\n五王帐冷无同梦，三国车填有近陪。\n动地渔阳喧鼓角，造天汤殿锁莓苔。\n凄清阁道闻铃雨，可忆山泉喷薄来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31297,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"圭峰山","author":"洪亮吉","text":"太华三峰外，兹峰亦削成。\n空青无雾障，奇秀与云争。\n直柏当胸出，初阳贴掌生。\n此江清到底，照影亦分明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31298,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长安杂兴十首 其七","author":"张祥河","text":"圭峰尊太白，禹迹夜珠辉。\n琼草谁为覆，釜凫亦解飞。\n栾侯除旱魃，郑客扣灵扉。\n左洞胡麻饭，神仙不可几。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31299,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日同石九鼎游文塔寺浮图时缘公赍大藏至","author":"王涛","text":"徙倚层霄敞，危栏俯野坰。\n河流潆树断，峰势插天青。\n人嗣黄梅法，龛藏白马经。\n远公容结杜，长此叩禅扃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31300,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"登文塔","author":"刘三才","text":"缥缈风烟万里开，招提乘兴漫登台。\n终南紫气来三辅，极北浮云净九垓。\n雁外晴丝飞浩荡，尊前塔影落崔嵬。\n瀛洲遗址仍相望，共看文芒射斗台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31301,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋日同韩景圭游文塔","author":"杨国柱","text":"雨后秋光洁，携朋到上方。\n世情无点染，吾道自清凉。\n非为谈经乐，多因寄傲狂。\n泾流还咫尺，欲共泛沧浪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31302,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"同咸阳张天任明府登文塔","author":"刘璜","text":"浮图杳霭入青云，渭水泾流远近分。\n背日丹梯风可御，藏烟翠柏鸟希闻。\n使君欲寄登高赋，衲子争贪佞佛文。\n收拾碧纱笼好句，九龄风度自超群。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31303,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"游文塔","author":"王廷佐","text":"久裂不周柱，谁复东南造。\n削顶剌碧空，迷离云作帽。\n呼吸风两声，环曲独龙道。\n长安十里城，缩来只一隩。\n下视苍苍色，可畏亦可悼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31304,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"文塔","author":"谭一豫","text":"泾水东流去，文峰挽欲旋。\n凭兹锋颖上，直逼斗牛边。\n近挹瀛台秀，遥分雁塔烟。\n相期后来者，品望续前贤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31305,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鸡峰山","author":"杨甲木","text":"凌空矗立势干霄，截嶪数峰望外标。\n碧落无踪疑可近，青云有路应非遥。\n宝藏自昔平探取，财木于今任采樵。\n一切登时皆俯视，几回彳亍步崇椒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31306,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鸡峰山","author":"吴曰南","text":"鼎柱益门姜水东。\n峰峰不与众峰同。\n十千烟火浮云外，百二河山望眼中。\n南顿何年留胜迹，西雍此日话雄风。\n钟声遥度山椒里，犹似雊音满太空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31307,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鸡峰山 其一","author":"强振志","text":"太乙西南万笏环。\n白云深处是鸡山。\n飞来碧嶂昂头立，踏破苍烟点羽斑。\n五色祥光圆顶上，千层瑞彩荡胸间。\n问他雌伏缘何事，怕得惊人暗度关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31308,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鸡峰山 其二","author":"强振志","text":"云锁终南不见山。\n鸡峰峭出白云间。\n峨冠低映天孙锦，翠黛遥连玉女鬟。\n骨透鱼鳞惊荡动，顶含虹影任回环。\n雄飞一去知何处，空使霞光绕石颜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31309,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鸡峰山","author":"徐冲霄","text":"仙鸡不愿秦皇封。\n愿作终南第一峰。\n天外昂头如鹤立，云罗翀破几千重。\n祥光五色常拥护。\n冠领峨峨笼不住。\n飞来陈宝似画图，俯视众山皆烟雾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31310,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"上鸡峰","author":"高元重","text":"每到孤峰绝顶攀。\n攀来和恐宿峰间。\n无端扰梦风翻雨，心逐流云度险山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31311,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]