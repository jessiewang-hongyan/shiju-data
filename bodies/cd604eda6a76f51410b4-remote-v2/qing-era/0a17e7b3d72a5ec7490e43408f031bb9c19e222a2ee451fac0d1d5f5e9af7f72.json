[{"title":"关陇平 其六","author":"叶方霭","text":"勇自河西，衔枚疾指。\n来从酒泉，转战天水。\n矫矫虎臣，一乃心力。\n摧坚挫锋，荡彼蟊贼。\n兵车百万，汹汹雷震。\n横会方州，为行为阵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6565,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"关陇平 其七","author":"叶方霭","text":"东西合围，贼在釜底。\n其智斯竭，其魄斯夺。\n勇率其麾，崖诛谷讨。\n曰臣思克，曰臣进宝。\n赳赳奋武，为王干城。\n勇实帅之，桓桓于征。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6566,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"关陇平 其八","author":"叶方霭","text":"于征何所，于巩于临。\n道阻且长，蔽亏岑崟。\n深入其阻，禽狝草薙。\n申用三驱，根株断刈。\n余贼窜蜀，游魂犹悸。\n西夏以绥，贺兰其乂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6567,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"关陇平 其九","author":"叶方霭","text":"胁从蚩蚩，亦孔之哀。\n宽其诛锄，予以惠来。\n维海维勇，刚克柔克。\n勇也帅师，为辟为祓。\n海也敉民，为揉为活。\n北地上郡，稽颡归命。\n如旱望霓，海实绥之。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6568,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"关陇平 其十","author":"叶方霭","text":"义威戢武，奠我西陲。\n剖蜩斮猬，人畏以怀。\n秦民嘘呵。\n化为讴吟。\n殄熄暴悖，克广德心。\n经战伐区，蠲除租赋。\n问孤吊死，起乃沈痼。\n廓我皇恩，义声先路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6569,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"关陇平 其十一","author":"叶方霭","text":"帝德振振，陇山既平。\n陇流既清，维天子之祯。\n陇山既伏，次黔粤滇。\n蜀敢不詟伏，如翰如飞，万福来威。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6570,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"关陇平 其十二","author":"叶方霭","text":"维臣之力，维师之武。\n絷缚巨憝。\n争刌脍脯，塞神人之怒。\n黔首喁喁，式歌且舞。\n亿万斯年，笃我皇景祜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6571,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海氛清 其一","author":"叶方霭","text":"巨浸稽天，滔滔如何。\n天吴蝄像，倚以为家。\n有鲸有鳄，有鲛有鼍。\n摧橦决帆，血人于牙。\n中国有圣人，尔独扬其波。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6572,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海氛清 其二","author":"叶方霭","text":"蠢兹蛙黾，亦杂此处。\n曰予胜国，从诞敢继其绪。\n藉瑕蹈衅，伺窥肘腋。\n结连蜂螫，载逞凶慝。\n离间我臣仆，盗据我疆场。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6573,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海氛清 其三","author":"叶方霭","text":"于兴于泉，于汀于漳。\n乃扬沸汤，乃噪蜩螗。\n我有城郭，倏为沮汝。\n我有民人，倏为鱊鮬。\n忍死须臾，后来其苏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6574,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海氛清 其四","author":"叶方霭","text":"王承帝命，大将军旗鼓。\n我冠带之国，忍鳞介是伍。\n据我上游，张我罿罦。\n与子偕作，与子同仇。\n悉率左右，歼此群丑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6575,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海氛清 其五","author":"叶方霭","text":"暨暨藩臣，一心一德。\n讨贼自赎，不邛已恤。\n堑山堙谷，马腾舟驶。\n亲董其旅，以临濛汜。\n陛下曲赦臣，臣敢不效死。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6576,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海氛清 其六","author":"叶方霭","text":"将士和睦，有凫在藻。\n既获贼师，如饥斯饱。\n或拔其角，或脱其距。\n或斧其吭，或截其膂。\n贼穷见窘，无地自处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6577,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海氛清 其七","author":"叶方霭","text":"彼强者跳，我攘我逐。\n彼黠者穷，我殄我戮。\n神惎之毒，鬼速其覆。\n如探鷇鸟，如振槁木。\n非我黩武，取彼残已足。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6578,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海氛清 其八","author":"叶方霭","text":"前徒既莽，凶渠束手。\n计无复之，狼奔鼠走。\n茫茫烟岛，为逋逃薮。\n仁无必取，义不尽杀。\n屏诸穷发，无污我王钺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6579,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海氛清 其九","author":"叶方霭","text":"四州士女，来迎王旅。\n君子维何，元黄在篚。\n小人维何，饔殄在筥。\n复为王臣，以耕以仕。\n歌帝之德，诵王之武。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6580,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海氛清 其十","author":"叶方霭","text":"帝德溥将，涵负吐纳。\n百谷来王，天与地沓。\n何人不绥，何物不怀。\n何戾不蠲，何善不嘉。\n皇仁熙熙，云何不来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6581,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海氛清 其十一","author":"叶方霭","text":"皇帝在位，受天之箓。\n东西朔南，无思不服。\n其有不服，自婴显戮，献馘于泮，献俘于庙。\n武功既昭，文德用绍。\n史臣奏雅，来哲是诏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6582,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"吊铁崖墓","author":"叶方霭","text":"先生不可见，遗冢自斜晖。\n无复携红袖，还闻葬白衣。\n才销明主忌，老幸故人依。\n铁笛吹云起，犹疑踏月归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6583,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"授职翰林学士感恩述怀","author":"叶方霭","text":"麻衣席帽满尘埃，亲荷先皇衅沐来。\n敢道齐贤留异日，屡称苏轼是奇才。\n身离牛口惊还在，梦挽龙髯恨不回。\n今遇吾君重拂拭，孤桐果否爨馀材。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6584,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜柬王少参舟中","author":"姚缔虞","text":"薇省辞黄鹤，兰桡伴白鸥。\n岸回江月抱，天迥夕云流。\n银汉乘霄上，金陵逼岁遒。\n田租闻复减，侧识汉皇忧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6585,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感怀","author":"翟廉","text":"兵戈纷在眼，骨肉远关心。\n半载音书滞，孤城草木深。\n黄昏磷火出，白日阵云阴。\n何处猿啼急，凄凉游子吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6586,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"高营夜坐感怀","author":"翟廉","text":"红衣新熟橘，白首老书生。\n解渴闲呼酒，思家厌说兵。\n海天风鼓浪，平野月临营。\n遥忆黄河北，霜寒古赵城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6587,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送别北山都谏","author":"于觉世","text":"竹西亭下放舟行，一曲骊歌送客情。\n去尽游人山色暮，昆仑冈畔又潮生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6588,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感怀和家兄回狂韵","author":"于觉世","text":"十年作赋客心违，独倚危楼啸落晖。\n《天问》有词愁莫对，奚囊得句满方归。\n画中诗意云生岫，醉里良朋月傍扉。\n何日乘风当破浪，监州不设蟹初肥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6589,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送甥杜湘民南旋","author":"王追骐","text":"汝归仍是客，故国似无情。\n凉月才今夕，秋风已半生。\n相期他日梦，共爱盛时名。\n别意难持赠，江流不断声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6590,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"孟秋客中","author":"王追骐","text":"秋飞一叶后，人在万山中。\n远笛荒村月，孤衾野店风。\n树衰容自老，虫细语偏雄。\n知我今宵梦，萧萧北地鸿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6591,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怀王来硕","author":"卢乾元","text":"碧湾成卧隐，岁晚事诛茅。\n月白寻渔桁，风危护鸟巢。\n文章归老宿，魂梦恋深交。\n自达穷通理，无烦作《解嘲》。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6592,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"瀑布","author":"王大作","text":"曾闻拟海立，今信有泉飞。\n绝壁风霆斗，青霄烟雨霏。\n光寒秋客袂，雪濑宕渔矶。\n晚渡石桥去，真同雁荡归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6593,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山游纪胜","author":"崔㟆","text":"冲襟蹑秋岑，日落千崖耸。\n孤啸临远风，势与江波动。\n轻策冠飞鸟，万象接幽踵。\n寒姿结霜标，阴泉澹云孔。\n横揽空濛表，不知烟霭重。\n拂石憩古苔，抚松托修竦。\n江色在衣带，寒涛坐来涌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6594,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"师子岩","author":"崔㟆","text":"崇岩吐青冥，光响限林谷。\n栖神迹未化，践幽境转肃。\n缘流乱木区，遵石入云族。\n忽与烟雾并，稍知日月伏。\n目恬天岭交，心霁风霄穆。\n江海有端倪，乾坤不盈掬。\n翛然叩虚抱，松风媚幽独。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6595,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"合掌峰","author":"崔㟆","text":"奇峰閟天经，合沓神化积。\n密石涓细流，阴霞荡虚壁。\n息心响空音，万象俱践夕。\n流景媚林姿，归禽度云隙。\n平挹遥海苍，俯眷双湖白。\n空水倒群峰，恍惚天地易。\n洪幽撰耳目，眺听理勿隔。\n永观元化初，于焉振霄翮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6596,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"越西行","author":"崔㟆","text":"越西之疆古姑蔑，南走滇黔右两浙。\n万山回合抱孤城，一道金溪沸奔雪。\n狂氛一夜吹黑云，闽关以北无坚屯。\n国家承平三十载，卒见烽火皆崩奔。\n弹丸小邑千岩底，踣之直用靴尖耳。\n城存与存亡与亡，不死犹图报天子。\n奔走风尘万岭间，齧指血溅蟠桃山。\n浮图一矢贺兰志，誓不与贼生同天。\n仰天叩心天鉴此，收城岂雪生民耻。\n百里提封谢主恩，孤臣待罪甘心矣。\n十年长吏愧苍黎，乱后还惊有孑遗。\n君不见月波亭上清秋魄，依旧含情照越西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6597,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"竹西亭","author":"崔㟆","text":"歌吹扬州路，西亭旧足夸。\n香风散罗绮，夜月写琵琶。\n画鹢停深柳，春城覆落花。\n追思全盛日，肠断玉钩斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6598,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"毗陵道中","author":"崔㟆","text":"挂席当春杪，毗陵古岸舟。\n柳攀江雨细，亭没戍云浮。\n岁祲花空发，城荒麦未秋。\n东南财赋地，谁慰一人忧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6599,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"吴门道院弥罗阁","author":"崔㟆","text":"飞阁层霄迥独攀，凌虚凭眺俯人寰。\n金铺昼暝栖云雾，碧落风轻礼佩环。\n槛外天低吴苑树，窗中人倚洞庭山。\n花洲锦缆知何处，千里毗陵一夜还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6600,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小隐岩","author":"郑日奎","text":"竟日穷搜讨，幽意犹未足。\n更过小隐岩，随步姿清瞩。\n两壁势相拒，一径往如复。\n石跨涧为梁，僧缘崖作屋。\n檐飞四时溜，窗倚千竿竹。\n山花不辨名，溪草随意绿。\n风尘接混茫，声光相为触。\n主人意殊快，张宴岩之曲。\n高歌翻宿鸟，清吹振林木。\n促席尽绸缪，开襟谢拘束。\n安知高峰外，夕阳下平陆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6601,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一线","author":"郑日奎","text":"登高复临深，所欲尽奇态。\n侧身苍翠中，试足鱼龙背。\n两峰势欲合，万象全幽昧。\n仅透一线光，顿失天地大。\n日月无多照，欻忽异明晦。\n纵横罗怪石，踯躅有余碍。\n淙淙半空溜，直下曳潜濑。\n湿云凝不流，鸟声云内外。\n静觉雷雨蓄，幽疑鬼神会。\n因想开劈初，五丁力稍懈。\n一罅不及补，千古诧奇怪。\n坐啸窈冥中，无言但称快。\n异境岂恒遇，兹游矢以再。\n长揖告山灵，呵护请相待。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6602,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游嵩山寺","author":"郑日奎","text":"十里溪声五里山，数椽梵刹万松间。\n老僧扫地不为客，待有白云时往还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6603,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"石照山","author":"曹鼎望","text":"晓出玉鄣门，渡溪复越岭。\n茂树欲参天，盛夏翻清冷。\n幽壑隐禅关，隔断尘千顷。\n侧见古亭边，石照传奇景。\n翠峰危以特，壁光闇而炳。\n讵止鉴须眉，罗列山河影。\n惟空故生明，惟静乃能永。\n昏昏行役者，胡不发深省。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6604,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小塔寺","author":"曹鼎望","text":"楚天黄叶暮，禅院白云封。\n径僻宜乘兴，亭留为劝农。\n乱篁迷小塔，斜石倚孤松。\n久坐从僧话，林端送晚钟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6605,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"汉口别舍弟","author":"曹鼎望","text":"汝从燕马去，我向楚州来。\n归梦随江水，离愁入酒杯。\n暂分鸿雁序，先到凤凰台。\n有约迟冬杪，斋头看腊梅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6606,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江月","author":"曹鼎望","text":"雪尽群峰出，江空一月浮。\n清光流不去，偏照异乡愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6607,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"黄州雨泊","author":"曹鼎望","text":"涛涌千层雪，江飞万缕烟。\n雨余山欲暗，赤壁夜停船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6608,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"阿迷州","author":"姚文燮","text":"磴曲盘难尽，边诈州著阿迷。\n一丸天罅小，连笮瀑痕低。\n客榻依琴室，斋钟彻鹤栖。\n松滋旧图画，感触故山蹊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6609,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"千秋台","author":"李伸","text":"千秋事业祖孙同，小邑还堪歌《大风》。\n赵北山河终不改，洛阳城阙已成空。\n映台芳草萋萋碧，隔树明霞霅霅红。\n无限游人增感慨，一杯为酹夕阳中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6610,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟陶饮酒 其一","author":"井在","text":"栖迟衡与泌，家无担石储。\n种秫理酒床，相对数卷书。\n兴至过白石，挥觞讯太虚。\n启期何自宽，庄周终蘧蘧。\n吾乐自有真，八达何足誉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6611,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟陶饮酒 其二","author":"井在","text":"荒宅惭杨子，而有架上书。\n遗悲念手泽，世盛感皇初。\n我忧何以解，独酌情亦舒。\n岂不思共适，醉醒殊乃疏。\n所以楚灵均，萧然赋《卜居》。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6612,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"灞上轻薄行","author":"井在","text":"风急长安道，日暮长安行。\n纷纷灞浐尘，向人衣上生。\n促轮乱马蹄，鞭影控悬旌。\n岂无素相识，有盖莫我倾。\n相逢游侠儿，足捷身致荣。\n去去不相顾，谁怜羁旅情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6613,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送洪区邱先生教谕长清","author":"王钺","text":"白发焉能逐队行，一官独冷称长清。\n遗民自识康成草，博士家传伏氏经。\n瘦马骨高疲远道，古槐根出枕荒城。\n应怜到日多幽赏，松桂高风苜蓿羹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6614,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岭南秋色","author":"王钺","text":"秋来不复见黄叶，但见野云漠漠生。\n花气中人如二月，鸟声依树欲三更。\n新禾瘴发微寒起，广莫风轻潦水平。\n若向山城高处望，羁人何事不关情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6615,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"池上作","author":"马骕","text":"板桥南去湿烟空，春水平池宛镜中。\n新柳深含何限绿，小桃斜坼一枝红。\n种鱼有术寻渔父，断酒无心学醉翁。\n鸥鹭闲情湖海兴，年来宦迹付征篷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6616,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日过衡阳与王文振登大观楼言别","author":"李如汸","text":"依依不忍道，携手上高楼。\n北极燕云远，西山落日愁。\n蝉鸣枫叶冷，猿啸大江秋。\n楚地知音少，因君且系舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6617,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日自遣","author":"李如汸","text":"寥落江城暮，秋风处处同。\n一官三峡外，数口万山中。\n贫贱差时辈，飘零任转蓬。\n故园归未得，目断信陵东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6618,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"同友人过华藏庵","author":"高恒懋","text":"长夏萧疏倦倚楼，相将兰若慰沈浮。\n午钟敲醒十年梦，溪水流残半世愁。\n塔影斜侵竹院冷，茶烟不断白云流。\n徘徊竟日风尘外，话到无生意未休。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6619,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"日哭三君子行","author":"彭鹏","text":"嗟乎天地黯淡白日黩，为鸱为鼠何反覆！\n三月有客过江言，月望榕城人集木。\n出者仰天皆屏息，入者和尘保走肉。\n传闻男子得三人，伏尸流血耻臣仆。\n泣曰三人者为谁？\n客云以耳不以目。\n将疑将信听客云，迟之七日果来复。\n督臣不挠被幽囚，生死存亡握粟卜。\n屈指三山王邦伯，骂贼睢阳身为戮。\n碧水丹山司马公，含笑就刃无颦蹙。\n忠烈同时孰后先，刚锋交下血喷漉。\n上有猛兽正负嵎，下有豺狼心久蓄。\n张牙开齿狞人前，耽耽视之欲逐逐。\n堂堂尽见七尺躯，下风稽颡惟俯伏。\n悬河谈天舌槁然，肝胆冰寒形神觫。\n三公浩气归山河，杀身成仁彼所独。\n如是我闻闭紫桑，虚空掩口吞声哭。\n吁嗟乎！\n佌佌彼有屋，蔌蔌方有谷，哀今之人谁非食君禄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6620,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"从征行","author":"彭鹏","text":"大东小东空杼柚，征徭不辨其盈缩。\n自从排户应兵兴，官差打门暮与夙。\n少妇露面呜咽陈，妾家良人无伯叔。\n昨夜行役点数千，良人在内尚枵腹。\n计程此去十二时，只身何能两驰逐。\n妇陈官差亦咆哮，两邻老妪闻之哭。\n我翁六十昨同去，儿家重派翁必复。\n东西两妇声惨恻，老者气乏少者伏。\n两妇几几欲断绝，官差暂舍过北屋。\n中有跛者不能行，絷之维之大颦蹙。\n跛者含泪向妇泣，莫怨官差苦自鞠。\n废疾似我出雇钱，谁云跛受手足福。\n妇向跛者微欷吁，太平盍日向天祝。\n今兹一一重申饬，不奉羽书毋给副。\n匪不念彼征夫苦，祁寒暑雨赴杀戮。\n奈此役夫无休息，遗黎久难支鞭扑。\n谁将此示怀好音，趑趄渐次寻邦族。\n百尔君子惟所司，努力奉行体并育。\n但愿清宴无烦苦，职思其居车脱辐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6621,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望洋台","author":"成克大","text":"峻岭有高台，突兀南溟岸。\n长风万里来，天际帆影乱。\n极目荒徼外，一气疑未判。\n蛟室邈难即，蜃楼聚复散。\n天吴时出没，骊龙珠光灿。\n四海无扬波，重译来浩翰。\n百货走如鹜，有无相易换。\n澳贾罔市利，此地立龙断。\n攘夺衅窦开，掩袭肆狡悍。\n横山起军垒，张威护里闬。\n外御异己者，会使诸彝惮。\n我来一登临，狙獝信难捍。\n嗟彼番鬼谋，贸迁操胜算。\n但恐姿骄纵，与世成冰炭。\n滥觞不在多，积微固有渐。\n勿令登台人，徒作望洋叹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6622,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"仲冬赴澳 其一","author":"成克大","text":"岭外朔风起，飒飒吹我裳。\n仰天见浮云，将无来故乡。\n故乡隔万里，北雁无南翔。\n乡书阻逾时，伫立心徬徨。\n久客复行役，云水渺相望。\n前路何须问，风波感慨长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6623,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"仲冬赴澳 其二","author":"成克大","text":"炎方霜雪少，海气夜寒生。\n飘摇舟一叶，游子衣裳轻。\n饥渴莫我问，骨肉万里情。\n泠泠晚潮水，凄清欸乃声。\n独怜宵征客，憔悴百愁并。\n顾影无俦匹，仰盼悲参横。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6624,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过南赣","author":"成克大","text":"双江清见底，还绕古虔州。\n水势奔滩险，风烟接瘴愁。\n菜花开野岸，梅片落汀洲。\n岁暮嗟行役，征帆去不留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":6625,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]