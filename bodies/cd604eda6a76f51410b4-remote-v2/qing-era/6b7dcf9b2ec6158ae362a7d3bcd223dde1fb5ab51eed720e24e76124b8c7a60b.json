[{"title":"乌鲁木齐杂诗之物产 其十七","author":"纪昀","text":"昌吉新鱼贯柳条，笭箵入市乱相招。\n芦芽细点银丝脍，人到松陵十四桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31166,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其十八","author":"纪昀","text":"斑斓五色遍身花，深树多藏断尾蛇。\n最是山南烽戍地，率然阵里住人家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31167,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其一","author":"纪昀","text":"蒲桃法酒奠重陈，小勺鹅黄一色匀。\n携得江南风味到，夏家新酿洞庭春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31168,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其二","author":"纪昀","text":"茹家法醋沁牙酸，滴滴清香泻玉盘。\n琥珀浓光梅子味，论功真合祀元坛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31169,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其三","author":"纪昀","text":"不重山肴重海鲜，北商一到早相传。\n蟹黄虾汁银鱼鲞，行箧新开不计钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31170,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其四","author":"纪昀","text":"旋绕黄芽叶叶齐，登盘春菜脆玻璃。\n北人自只夸安肃，不见三台绿满畦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31171,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其五","author":"纪昀","text":"雪压空山老树枯，一番新雨长春菇。\n天花绝品何须说，持较兴州尚作奴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31172,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其六","author":"纪昀","text":"朱桔黄柑荐翠盘，关山万里到来难。\n官曹春宴分珍果，谁怯轻冰沁齿寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31173,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其七","author":"纪昀","text":"依稀谏果两头纤，松子来从雪岭南。\n岭上苍官千万树，只能五鬣绿鬖鬖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31174,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其八","author":"纪昀","text":"汉唐旧史记青稞，西域从来此种多。\n轻注蹲鸱成一笑，如今始悔着书讹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31175,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其九","author":"纪昀","text":"新稻翻匙香雪流，田家入市趁凉秋。\n北郊十里高台户，水满陂塘岁岁收。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31176,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其十","author":"纪昀","text":"配盐幽菽偶登厨，隔岭携来贵似珠。\n只有山家豌豆好，不劳苜蓿秣宛驹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31177,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其十一","author":"纪昀","text":"菽乳芳腴细细研，截肪切玉满街前。\n只怜常逐春归去，不到榴红蓼紫天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31178,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其十二","author":"纪昀","text":"新榨胡麻潋滟光，可怜北客不能尝。\n初时误认天台女，曾对桃花饭阮郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31179,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其十三","author":"纪昀","text":"漉白荒城不见日，采硝人在古阳关。\n颓垣败堞浑堆遍，错认深冬雪满山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31180,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其十四","author":"纪昀","text":"谁能五月更披裘，尺布都从市上求。\n懊恼前官国司马，木棉试种不曾收。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31181,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其十五","author":"纪昀","text":"榆槐处处绿参天，行尽青山未到边。\n只有垂杨太娇稚，纤腰长似小婵娟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31182,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其十六","author":"纪昀","text":"梭梭滩上望亭亭，铁干铜柯一片青。\n至竟难将松柏友，无根多半似浮萍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31183,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其十七","author":"纪昀","text":"罂粟花团六寸围，雪泥渍出胜浇肥。\n阶除开遍无人惜，小吏时时插帽归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31184,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其十八","author":"纪昀","text":"姹紫嫣红廿四畦，香魂仿佛认虞兮。\n刘郎倘是修花谱，芍药丛中定误题。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31185,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其十九","author":"纪昀","text":"千瓣玲珑绿叶疏，花头无力倩人扶。\n因循错唤江西蜡，持较东篱恐未输。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31186,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其二十","author":"纪昀","text":"红药丛生满钓矶，无人珍重自芳菲。\n倘教全向雕阑种，肯减扬州金带围。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31187,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其二十一","author":"纪昀","text":"八寸葵花色似金，短垣老屋几丛深。\n此间颇去长安远，珍重时看向日心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31188,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其二十二","author":"纪昀","text":"土屋茅檐几树斜，移来多自野人家。\n微风处处吹如雪，开遍深春皂荚花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31189,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其二十三","author":"纪昀","text":"河桥新柳绿蒙濛，只欠春园杏子红。\n珍重城南孤戍下，刚流一树袅东风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31190,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其二十四","author":"纪昀","text":"前度刘郎手自栽，夭桃移得过山来。\n阜康城内园池好，尚有妖红几树开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31191,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其二十五","author":"纪昀","text":"息鸡草长绿离离，织荐裁帘事事宜。\n騕袅经过浑不顾，可怜班固未全知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31192,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其二十六","author":"纪昀","text":"芦荻飕飕绿渺茫，氤氲芳草隐陂塘。\n行营不解西番法，秋老谁寻玛努香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31193,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其二十七","author":"纪昀","text":"芳草丛丛各作窠，无名大抵药苗多。\n山亭宴罢扶残醉，记看官奴采薄荷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31194,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其二十八","author":"纪昀","text":"长镵木柄斸寒云，阿魏滩中药气熏。\n至竟无从知性味，山家何处问桐君。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31195,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其二十九","author":"纪昀","text":"照眼猩猩茜草红，无人染色付良工。\n年年驿使驰飞骑，只疗秋塍八蜡虫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31196,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其三十","author":"纪昀","text":"绿到天边不计程，苇塘从古断人行。\n年来苦问驱蝗法，野老流传竟未明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31197,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其三十一","author":"纪昀","text":"鸭绿鹅黄满市中，霜刀供馔缕轻红。\n加餐便忆坤司马，不比无端主簿虫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31198,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其三十二","author":"纪昀","text":"彻耳金铃个个圆，檐牙屋角影翩翩。\n春云澹宕春风软，正是城中放鸽天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31199,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其三十三","author":"纪昀","text":"绣羽黄襟画里看，鸳鸯海上水云寒。\n如何夜夜双栖梦，多在人间斗鸭栏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31200,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其三十四","author":"纪昀","text":"白草初枯野雉肥，年年珍重进彤闱。\n传声贡罢分携去，五彩斑斓满路归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31201,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其三十五","author":"纪昀","text":"春鸿秋燕候无差，寒暖分明纪岁华。\n何处飞来何处去，难将踪迹问天涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31202,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其三十六","author":"纪昀","text":"山禽满树不知名，五色毛衣百种声。\n前度西郊春宴罢，穿帘瞥见是莺莺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31203,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其三十七","author":"纪昀","text":"飞飞干鹊似多情，晚到深林晓入城。\n也解巡檐频送喜，听来只恨是秦声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31204,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其三十八","author":"纪昀","text":"荒屯那得汝南鸡，春梦迷离睡似泥。\n山鸟一声天半落，却来相唤把锄犁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31205,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其三十九","author":"纪昀","text":"一声骹叫唳长风，早有饥鸢到半空。\n惊破红闺春昼梦，齐呼儿女看鸡笼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31206,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其四十","author":"纪昀","text":"谁言天马海西头，八骏从来不易求。\n六印三花都阅遍，何曾放眼看骅骝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31207,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其四十一","author":"纪昀","text":"白狼苍豹绛毛熊，雪岭时时射猎逢。\n五个山头新雨后，春泥才见虎蹄踪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31208,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其四十二","author":"纪昀","text":"牧场芳草绿萋萋，养得骅骝十万蹄。\n只有明驼千里足，水销山径卧长嘶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31209,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其四十三","author":"纪昀","text":"茸茸红柳欲飞花，歌舞深林看柳娃。\n双角吴童真可念，谁知至竟不辞家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31210,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其四十四","author":"纪昀","text":"拔刺银刀似脍残，有人相戒莫登盘。\n鱼苗多是秋虫化，倚仗曾经仔细看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31211,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其四十五","author":"纪昀","text":"蛱蝶花边又柳边，晚春篱落早秋天。\n只怜翔粉无多少，叶叶黄衣小似钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31212,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其四十六","author":"纪昀","text":"亦有新蝉噪晚风，小桥流水绿阴中。\n人言多是遗蝗化，果觉依稀似草虫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31213,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其四十七","author":"纪昀","text":"剪剪西风院落深，夜凉是处有蛩音。\n秦人不解金笼戏，一任篱根彻晓吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31214,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其四十八","author":"纪昀","text":"小煮何曾似鳆鱼，恼人幽梦夜深余。\n贫家敢恨无眠处，燕寝清香尚不除。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31215,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之物产 其四十九","author":"纪昀","text":"五月花蚊利似锥，村村拟筑露筋祠。\n城中相去无三里，夜卷疏帘不下帷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31216,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之典制 其一","author":"纪昀","text":"金碧觚棱映翠岚，崔嵬紫殿望东南。\n时时一曲升平乐，膜拜闻呼万岁三。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31217,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之典制 其二","author":"纪昀","text":"炉烟袅袅众香焚，春草青袍两面分。\n行到幔亭张乐地，虹桥错认武夷君。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31218,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之典制 其三","author":"纪昀","text":"烟岚遥对翠芙蓉，鄂博犹存旧日踪。\n缥缈灵山行不到，年年只拜虎头峰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31219,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之典制 其四","author":"纪昀","text":"绿塍田鼠紫茸毛，搜粟真堪赋老饕。\n八蜡祠成踪迹绝，始知周礼重迎猫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31220,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之典制 其五","author":"纪昀","text":"初开两郡版图新，百礼都依故事陈。\n只有东郊青鸟到，无人箫鼓赛芒神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31221,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之典制 其六","author":"纪昀","text":"藁砧不拟赋刀环，岁岁携家出玉关。\n海燕双栖春梦稳，何人重唱望夫山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31222,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之典制 其七","author":"纪昀","text":"戍楼四面列高峰，半扼荒途半扼冲。\n惟有山南风雪后，许教移帐度残冬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31223,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之典制 其八","author":"纪昀","text":"户籍题名五种分，虽然同住不同群。\n就中多赖乡三老，雀鼠时时与解纷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31224,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之典制 其九","author":"纪昀","text":"烽燧全消大漠清，弓刀闲挂只春耕。\n瓜期五载如弹指，谁怯轮台万里行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31225,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之典制 其十","author":"纪昀","text":"绿野青筹界限明，农夫有畔不须争。\n江都留得均田法，只有如今塞外行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31226,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之神异 其一","author":"纪昀","text":"灵光肸蚃到西陲，齐拜城南壮穆祠。\n神马骁腾曾眼见，人间衔勒果难施。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31227,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之神异 其二","author":"纪昀","text":"破寇红山八月天，髑髅春草满沙田。\n当时未死神先泣，半夜离魂欲化烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31228,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之神异 其三","author":"纪昀","text":"白草飕飕接冷云，关山疆界是谁分。\n幽魂来往随官牒，原鬼昌黎竟未闻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31229,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之神异 其四","author":"纪昀","text":"筑城掘土土深深，邪许相呼万杵音。\n怪事一声齐注目，半钩新月藓花侵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31230,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之神异 其五","author":"纪昀","text":"深深玉屑几时藏，出土犹闻饼饵香。\n弱水西流宁到此，荒滩那得禹余粮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31231,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之民俗 其一","author":"纪昀","text":"界画棋枰绿几层，一年一度换新塍。\n风流都似林和靖，担粪从来谢不能。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31232,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之民俗 其二","author":"纪昀","text":"割尽黄云五月初，喧阗满市拥柴车。\n谁知十斛新收麦，才换青蚨两贯余。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31233,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之民俗 其三","author":"纪昀","text":"到处歌楼到处花，塞垣此地擅繁华。\n军邮岁岁飞官牒，只为游人不忆家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31234,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之民俗 其四","author":"纪昀","text":"戍屯处处聚流人，百艺争妍各自陈。\n携得洋钟才似粟，也能检点九层轮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31235,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之民俗 其五","author":"纪昀","text":"巴亚翻翻数寸零，桔槔到手不曾停。\n论园仿佛如朱荔，三月商家已买青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31236,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之民俗 其六","author":"纪昀","text":"万里携家出塞行，男婚女嫁总边城。\n多年无复还乡梦，官府犹题旧里名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31237,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之民俗 其七","author":"纪昀","text":"十里春筹雪化泥，不须分垄不须畦。\n珠玑信手纷纷落，一样新秧出水齐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31238,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之民俗 其八","author":"纪昀","text":"山城是处有弦歌，锦帙牙签市上多。\n为报当年郑渔仲，儒书今过斡难河。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31239,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之民俗 其九","author":"纪昀","text":"闽海迢迢道路难，西人谁识小龙团。\n向来只说官茶暖，消得山泉沁骨寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31240,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"乌鲁木齐杂诗之民俗 其十","author":"纪昀","text":"吐蕃部落久相亲，卖果时时到市闉。\n恰似春深梁上燕，自来自去不关人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":31241,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]