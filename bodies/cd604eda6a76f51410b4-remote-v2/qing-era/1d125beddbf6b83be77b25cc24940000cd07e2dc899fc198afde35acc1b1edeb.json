[{"title":"西湖竹枝词 其二","author":"元璟","text":"鄂王祠上夕阳西，于公墓下杜鹃啼。\n莫话南征与北守，云消雨歇两峰齐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29071,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西湖竹枝词 其三","author":"元璟","text":"红桥曲曲放生池，春水初肥春日迟。\n何事系人情最好，金钱买饼饲鱼儿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29072,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西湖竹枝词 其四","author":"元璟","text":"烟紫莎青风力微，红镫水面酒船归。\n阿谁好唱伊凉曲，惊起鸳鸯相背飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29073,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜黄梨洲徵君过鹿峰","author":"元璟","text":"诸生方扫讲台花，更舁篮舆到若耶。\n正是可怜寒食后，乌巾白发倚风斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29074,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"华亭杂感 其一","author":"元璟","text":"木落霜清白苎城，暮砧才动旅魂惊。\n揽衣力尽秋星影，访旧听残邻笛声。\n画手有神同鹤瘗，诗坛无主散鸥盟。\n青溪一曲红桥路，今日何人肯好名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29075,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"华亭杂感 其二","author":"元璟","text":"不见风流柯九思，周郎词曲惯传奇。\n人情未必皆如此，吾道纷然孰可为。\n蹋月偶寻黄犬冢，临波难辨赤乌碑。\n菊花亦似多愁物，一夕催人上鬓丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29076,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"华亭杂感 其三","author":"元璟","text":"莼丝菰米及时鲜，便拟吴淞买钓船。\n唳鹤滩声来枕畔，横云山翠落檐前。\n谈谐名理青松尘，钞借奇书白玉笺。\n閒到四贤祠下坐，竹风青冷月孤圆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29077,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"华亭杂感 其四","author":"元璟","text":"一片孤云何所依，梦魂只向越山归。\n千盘涧道雪浮屐，十里松门翠扑衣。\n霜栗遥知猿采熟，肉芝怕被鹿衔稀。\n自嗟踯躅风尘久，不耐登高送雁飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29078,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"华亭杂感 其五","author":"元璟","text":"买山计左愧支郎，一笠重来二陆乡。\n秋后云林多瘦碧，愁边烟月易昏黄。\n催诗叶落梧桐井，搅梦虫依薜荔墙。\n圆泖沧波真浩荡，归心轻逐白鸥翔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29079,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画酬朱雪田","author":"元璟","text":"松云杳霭水潺湲，绝似云门深处山。\n从此把茅吾丧我，懒骑白额到人间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29080,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"得山同门五十","author":"元璟","text":"阿兄苦行如迦叶，重整青莲古道场。\n说法肘悬三要印，卷帘风散四花香。\n曾原好梦称鹙子，多分前身作雁主。\n夏腊数来刚半百，未妨小弟学韬光。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29081,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"漂母祠","author":"元璟","text":"漂母祠堂古尚存，萋萋衰草带城根。\n汉家斗大黄金印，争及当时一饭恩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29082,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"邓尉探梅舟中同惠仲儒程筠轩作 其一","author":"元璟","text":"婀娜轻帆日载阳，灵岩山翠接横塘。\n与君约束红藤杖，饱领梅花廿里香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29083,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"邓尉探梅舟中同惠仲儒程筠轩作 其二","author":"元璟","text":"撰取良时作胜游，三人同载木兰舟。\n东君作意加装点，柳色鹅儿水鸭头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29084,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"邓尉探梅舟中同惠仲儒程筠轩作 其三","author":"元璟","text":"横塘西接采香泾，三面都围苍玉屏。\n要与松枝了公案，先吟诗句报山灵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29085,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"邓尉探梅舟中同惠仲儒程筠轩作 其四","author":"元璟","text":"夕阳明灭乱山椒，水畔寒香阵阵飘。\n何必更寻花处看，销魂只在虎山桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29086,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登天封塔","author":"元璟","text":"雄镇东南一柱存，凌虚日月手堪扪。\n天开地扼山形壮，风吼潮来海气昏。\n舄下神龙无数绕，钟前怖鸽几双翻。\n鲎帆珠舶苍茫外，认取青尖入此门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29087,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"磐陀石","author":"元璟","text":"击出波心手掌平，我来趺坐证三生。\n善财参后无人到，閒杀峰头雪浪声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29088,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南渟画扇三桥索题","author":"元璟","text":"病里心情尽自闲，碧云红树掩双关。\n瘦腰一把凭乌几，只写元人没骨山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29089,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄松云庵主","author":"元璟","text":"无端鹤梦隔松风，黯黯孤镫缀玉虫。\n万种愁丝人在北，一腔情事水流东。\n花前顾曲何曾误，月底连吟每许同。\n安得碧天云卷尽，药船倒泻落霞红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29090,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"英德道中","author":"元璟","text":"倚舟应接不能闲，变化新奇在两间。\n说与画家多不信，英州山胜米家山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29091,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宿东山","author":"晓青","text":"东山何幽深，草木抱奇秀。\n古柏动蛟螭，奔湍两崖吼。\n敛履入茅丛，石崄步难骤。\n盘曲上青空，冷风满怀袖。\n柴门望中开，篱疏犬忽逗。\n斯须逢一僧，貌古鹤怜瘦。\n蓬檐就地形，刳竹通泉溜。\n落英走庭隅，池沫鱼吹绉。\n磁盂饮菰糜，齿向冰潭漱。\n客欢主益恭，无乃过予厚。\n主曰岂其然，予心如在疚。\n苟不恚粗疏，庶可寡其谬。\n玄言互酬咨，妙理绝肤受。\n中夜溪鸟飞，天空月当牖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29092,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟寒山子一首寄姚芬若","author":"晓青","text":"别君未月馀，情思一何渺。\n两夕频梦君，宛在松门道。\n花雨昼濛濛，深绿莺啼小。\n于时见君来，坐石漫倾倒。\n赠我以加餐，劝我归必早。\n予即前致辞，为言山水好。\n感君促归期，常恐及秋老。\n有身难奋飞，却羡空中鸟。\n遗书慰高堂，镫前复草草。\n枕落忽惊翻，千峰月初晓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29093,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟孟东野","author":"晓青","text":"露寒月色苦，夜静秋声急。\n客子隐不眠，中心万端集。\n饥乌亦知啼，枯鱼亦知泣。\n今古无真情，黄金铸颜色。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29094,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山舫吟","author":"晓青","text":"狭路忽相逢，欲让如何得。\n彼此各争先，必至同倾侧。\n于中有一人，退步行几尺。\n不惟他跃然，己亦成让德。\n苟能持此心，远足行蛮貊。\n是以读书人，理胜则明白。\n愚贱好用专，悻悻不能释。\n格斗起微嫌，诤论级胶执。\n天下互纷纭，周道何曾直。\n翻思古之人，感慨今之日。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29095,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"狼山观海","author":"晓青","text":"一片濛濛太古色，翠凤青鸾开羽翼。\n扪萝蹑屐步步奇，天地文章入胸臆。\n松桧森凉鸟道悬，凌空素手挥云烟。\n僧伽塔中悄无语，缥缈风铃时一喧。\n楼台炜煌逼天阙，近海犹疑蜃气结。\n洄混灏溃穷秘区，此中洲岛难分别。\n天水微茫古至今，飓风涛滚当昼阴。\n却瞻向望两失据，骇慄胆魄神骎骎。\n蓬莱仙山渺何许，我欲从之学轻举。\n长揖尘氛谢世人，眼前龌龊将辞汝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29096,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨后漫兴","author":"晓青","text":"云山一段画，秋雨来夺之。\n模糊米家村，墨汁方淋漓。\n老颠瞥然见，狂叫叹绝奇。\n使我有意为，必不得如斯。\n跃然攫之入怀袖，黄金白璧不肯售。\n造化小儿真幻师，换人双眼当晴昼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29097,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"古店晓发留赠主人","author":"晓青","text":"晓行残月在，杨柳数家村。\n远客怀乡邑，孤舟漾梦魂。\n曰归仍泛梗，所适定谁门。\n不厌频来过，知君雅道存。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29098,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山行即事","author":"晓青","text":"意欲穷幽趣，聊为野外行。\n远烟难辨树，斜日易催耕。\n倚杖观泉脉，穿林得鸟声。\n断堤回首处，一带暮山横。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29099,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过落木山人荒冢有感","author":"晓青","text":"芒鞋湿寒翠，拄杖下层巅。\n所至亦随意，相逢皆暮年。\n冢存三尺土，松作万家烟。\n道殣仍相望，踟蹰欲问天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29100,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"庚申元旦","author":"晓青","text":"又是从头起，无端笑一新。\n盛衰何预汝，冷暖亦随人。\n有面将迎壁，忘言莫问津。\n祇宜梅与石，同伴寂寥身。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29101,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过尹山访王咸中","author":"晓青","text":"咫尺东皋在，怀人正夕阳。\n微茫山色远，咿哑橹声长。\n短鬓惭鸥白，圆沙聚鸭黄。\n年来漂泊惯，客路似家乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29102,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟中晓起望洞庭山翠","author":"晓青","text":"月出五更初解缆，起看苍翠满船头。\n漫嗟白发随年长，更觉青山似客浮。\n橘柚有香清接路，烟霞无迹冷涵秋。\n近来我亦思归隐，欲访毛公结伴游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29103,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南峰石门","author":"晓青","text":"寒翠撑空劈一门，细藤丛竹互生根。\n虚亭吐纳云霞气，古篆销磨风雨痕。\n照影野堂垂废井，无情芳草上孤坟。\n于今谁复怜神骏，惭愧支公迹尚存。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29104,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送陆企苏入都","author":"晓青","text":"雄谈满座尽倾听，独拔词锋近发硎。\n漫请丸泥实函谷，争看联璧重华亭。\n几丛烟树天边绿，一簇云山雨后青。\n此去层霄宜自奋，直教鹏翼化南溟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29105,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟泊汉阳凭栏眺望问鹦鹉洲所在乡人云久已不可问矣愁对烟波漫成近体","author":"晓青","text":"芳草仍留鹦鹉名，千秋遗恨实难平。\n江摇隔岸红镫影，舟集通宵白浪声。\n冷暖自知孤客意，阴晴叵测上天情。\n无聊咄咄书空坐，怪事浮云污太清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29106,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过水绘园留赠冒辟疆 其一","author":"晓青","text":"澹荡园林水绘成，天光溪影弄新晴。\n主人领得春风意，小艓沿花趁晓莺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29107,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过水绘园留赠冒辟疆 其二","author":"晓青","text":"出水芙蕖映绿波，清凉台榭晚香多。\n胸中自信无烦热，门外何妨有雀罗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29108,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过水绘园留赠冒辟疆 其三","author":"晓青","text":"平居至性爱孤骞，几拟为文吊屈原。\n欲采芙蓉秋水阔，搴裳仿佛到湘沅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29109,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过水绘园留赠冒辟疆 其四","author":"晓青","text":"何须别置小山幽，身世俱成不系舟。\n花似美人怜月色，引人清梦到罗浮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29110,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题沈别山园居","author":"德元","text":"种树绕溪头，为园就山足。\n夜静月上扉，春深花履屋。\n幽情既满抱，采香自盈掬。\n主人乐偃眠，床头酒新漉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29111,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"月","author":"德元","text":"月色浸虚窗，梧风乱湘帙。\n果落岭猿争，草深水萤入。\n爱此一轮好，相看如旧识。\n披衣下庭除，独傍松根立。\n顾影还自怜，人苦不努力。\n览此盈复亏，方之得与失。\n况我岩栖者，于中本无得。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29112,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送杰上人归四明","author":"德元","text":"天台最奇峭，不与人閒通。\n崖断涧千尺，石梁架虚空。\n群峰发云表，如涌莲花丛。\n鹤巢古松顶，龙吟阴涧中。\n招提结微翠，钟梵随溪风。\n花木四时变，岩谷千秋同。\n君将归草庐，乃在赤城东。\n相送出林麓，晓日初曈矇。\n矫首吴江头，越岭青无穷。\n傥或遇寒、拾，为余谢二公。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29113,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寓秦对岩先生园","author":"德元","text":"江接伍胥水，山围泰伯城。\n芳园丛木暗，细路野花明。\n客到溪云合，吟成春水生。\n名泉携汲便，日日听茶声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29114,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送王次令入都","author":"德元","text":"青嶂一回别，黄河千里程。\n念君临远道，何日到神京。\n暮霭群鸦集，西风只雁鸣。\n天涯离索恨，吹入晚潮声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29115,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送白上人还越","author":"德元","text":"君将归旧隐，相送出东林。\n一锡几时到，千峰何处寻。\n云门溪路远，天竺冷泉深。\n若渡钱塘水，双鱼慰好音。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29116,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送介上人别","author":"德元","text":"几人称避世，羡尔独弥天。\n漫拟青莲作，还参黄檗禅。\n鹤迎过岭锡，龙护渡江船。\n他日蜚声在，新诗次第传。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29117,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送孟德懋","author":"德元","text":"四海无家者，惟吾与使君。\n已怜成浪迹，岂忍复离群。\n驿路兼秋雨，关河隔暮云。\n前途逢九日，最忆孟参军。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29118,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过旧游有感","author":"德元","text":"奇石尽良友，好山皆故乡。\n见时应下拜，去后总难忘。\n残日染寒翠，秋风吹古香。\n昔游空剩迹，尘佛闭虚堂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29119,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送朱有枚之金陵","author":"德元","text":"玉勒萧萧践绿芜，王孙游骑出姑苏。\n黯然欲别看长剑，行矣当歌击唾壶。\n禅室自开欢喜地，画船争渡莫愁湖。\n江南处处花如绮，一路春风听鹧鸪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29120,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"胥江春暮","author":"德元","text":"萧萧乡路往来频，一度看花一度新。\n病里无端过好景，客中又复送残春。\n苏台歌舞销魂梦，茂苑芳华付劫尘。\n只有堤边杨柳树，年年长拂渡江人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29121,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平山堂看荷","author":"元度","text":"云水无消歇，平堤尚芰荷。\n棹歌随意住，鸟语不能多。\n山远迷秦望，天低近汨罗。\n老僧如旧燕，补屋又来过。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29122,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"八岩关","author":"元度","text":"天险因时设，居然百二同。\n六师才出牧，一旅漫言功。\n草木愁烟里，车徒楚雨中。\n茫茫孤戍意，不敢泣途穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29123,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怨歌 其一","author":"髡残","text":"春风吹绿草，草绿伤人心。\n残花落便落，琐碎沾衣襟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29124,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怨歌 其二","author":"髡残","text":"寒食清明前，开门不敢觑。\n虽非桃李花，正是伤心处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29125,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重寓松涛庵","author":"髡残","text":"荻花袅袅隔村烟，秋水柴门半暮天。\n何意我来重话旧，叶舟横渡雁声前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29126,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"古意","author":"髡残","text":"瘗琴峨嵋巅，知音何寥寥！\n埋骨易水旁，侠士魂难招。\n物性不可违，岂必漆与胶。\n常恨士不遇，白首空萧骚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29127,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟至八闸为友人作画","author":"道济","text":"舟行将八闸，湖水荡无涯。\n渔艇千家岸，芦花一色沙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29128,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临清过闸口号","author":"道济","text":"地倾水泻须凭闸，千里雷车信怒嗥。\n卷浪抛开珠散彩，崩空舞碎雪分涛。\n七十二门向北牢，东归此去渐凭高。\n锦云旋绕织秋袍，仙障中分虎势绦。\n鸣锣击鼓壮滔滔，行人驻看跃渊艚。\n飞帆拥簇驾图旄，推窗卷幔得挥毫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29129,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"故城河口号","author":"道济","text":"千回百折故城河，东倾西长分嵯峨。\n白杨灌木参天柯，处处成行古道么。\n古冢荒碑庙逶迤，水流浪打雪狼窝。\n行路之人嗟叹多，峥嵘斧削飞岩坡。\n楼船画鼓快如梭，锦缆人来寸寸呵。\n归空粮艘争天摩，歌声歌彻青云和。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29130,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与友人夜饮","author":"道济","text":"忆昔相逢在黄檗，座中有尔谈天舌。\n即今头白两成翁，四顾无人冷似铁。\n携手大笑菊花丛，纵观书画江海空。\n镫光晃夜如白昼，酒气直透兜率宫。\n主人本是再来人，每于醉里见天真。\n客亦三千堂上客，英风竦飒多精神。\n拈秃笔，向君笑，忽起舞，发大叫。\n大叫一声天宇宽，团团明月空中小。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29131,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"为友人写春江图","author":"道济","text":"书画非小道，世人形似耳。\n出笔混沌开，入拙聪明死。\n理尽法无尽，法尽理生矣。\n理法本无传，古人不得已。\n吾写此纸时，心入春江水。\n江花随我开，江月随我起。\n把卷坐江楼，高呼曰子美。\n一啸水云低，图开幻神髓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29132,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"横塘夜泊","author":"宗渭","text":"偶为看山出，孤舟向晚停。\n野梅含水白，渔火逗烟青。\n寒屿融残雪，春潭浴乱星。\n何人吹铁笛，清响破空冥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29133,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵酬九来","author":"宗渭","text":"风急树萧萧，思君梦易销。\n鸟啼黄叶寺，僧语夕阳桥。\n得句霜钟度，安禅佛火烧。\n十年诗律苦，珍重贮山瓢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29134,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重过海印庵","author":"宗渭","text":"三年重向虎溪游，石路依然碧水流。\n鸟背斜阳微带雨，寺门衰柳渐迎秋。\n弟兄谊重难为别，师友情深竟莫酬。\n叹息此身闲未得，天涯明日又孤舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29135,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柬魏惟度","author":"宗元","text":"小雨山楼不断飞，问君何事掩双扉。\n少焉雨歇钟初起，送得书声过翠微。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29136,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]