[{"title":"巫山一段云 其二 大孤山","author":"吴绮","text":"万顷明波碧，千寻夕照红。\n灵旗隐约在云中，凌波翠一弓。\n莫把彭郎倚，谁将宓女通。\n大乔何事不从容，容易嫁江东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35746,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"采桑子 其一 秋闺","author":"吴绮","text":"西风不管梧桐叶，乱落秋光。\n跌碎斜阳，犹剩纱窗一半黄。\n新寒陡入罗衣薄，睡尽残缸。\n销却余香，昨夜南来雁带霜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35747,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"采桑子 其二 题悔庵读离骚杂剧","author":"吴绮","text":"潇湘千古伤心地，歌也谁闻，怨也谁闻，我亦江边憔悴人。\n青山剪纸归来晚，几度招魂，几度销魂，不及高唐一片云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35748,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉树后庭花 画寄亭作","author":"吴绮","text":"槐根幻出南柯郡，梦凭谁问。\n蜂巢燕垒劳安顿，暂排春闷。\n幽栏曲径花传信，柳疏梧嫩。\n仙鹤一双苔迹印，落些风韵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35749,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"好事近 其一 戏答","author":"吴绮","text":"把酒问东风，何事便都春去。\n莫遣鹦哥知道，劝桃花且住。\n年年强半为花疼，花有疼人处。\n难道东风不晓，把啼莺分付。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35750,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"好事近 其二 闺情和正持松涛词韵","author":"吴绮","text":"金斗爇沉香，难熨离肠愁结。\n强向人前欢喜，恨眉痕暗泄。\n今年心事更重重，较与去年别。\n昨夜空床孤影，睡蟾光清彻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35751,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"好事近 其三 归思","author":"吴绮","text":"一片故乡心，猛被角声吹破。\n酒薄不如愁酽，怕今宵难过。\n谩将离恨诉青天，天有许多大。\n泪湿枕痕难热，共梅花清坐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35752,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳含烟 咏柳","author":"吴绮","text":"江南路，柳丝垂。\n都少齐梁旧事，玉蛾金茧只霏霏。\n挂斜晖。\n眼眼眉眉都是恨。\n人去灵和莫问，谁堪眠起对红闺。\n晚风吹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35753,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渔父家风 过西塞山访张志和旧隐不得","author":"吴绮","text":"鳜鱼春水旧迢迢，有客泛兰舠。\n而今事往无人问，花落大夫桥。\n新月小，暮山高。\n古风遥。\n樵青何处，欸乃声声，如意频敲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35754,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒金门 其一 雨后","author":"吴绮","text":"朝雨沐，小阁翠阴如幄。\n阁外白云飞去速。\n乱峰添意绿。\n灵鹊喜声相续，新笋看看成竹。\n满径落红无管束，燕儿衔补屋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35755,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒金门 其二 秋夜","author":"吴绮","text":"真堪忆，江上乱峰堆碧。\n高处乘风横铁笛，笑人间不直。\n千古斗奇角，不了砌蛩啾唧。\n天上神仙何寂寂，桂花闻叹息。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35756,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒金门 其三 春情","author":"吴绮","text":"春欲老，雨雨风风昏晓。\n枝上残红阶下草，扫应还更扫。\n何事最伤怀抱，芍药开迟谢早。\n独倚阑干添懊恼，钗鸾欹鬓小。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35757,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒金门 其四 留春","author":"吴绮","text":"春将去，燕子留春不住。\n分付落花飞满路，隔将春去处。\n毕竟春光难诉，转怨乱红催取。\n我问落花谁误汝，莫嗔风共雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35758,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒金门 其五 送春","author":"吴绮","text":"春归决，半夜起和春别。\n窗外落花堆似雪，送春惟有月。\n怪煞杜鹃啼彻。\n月也和春休歇。\n窃药嫦娥空有诀，春魂难再接。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35759,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏子 其一 和阮亭与友人话秦淮旧事","author":"吴绮","text":"柳遮楼，花拂地。\n金粉六朝争丽。\n歌槛里，舞阑中。\n鸾笙醉软红。\n燕飞忙，莺语咽。\n天宝何堪再说。\n愁黯黯，泪洒洒。\n孤灯白下桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35760,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏子 其二 夜情","author":"吴绮","text":"被慵薰，钗懒卸。\n愁到天涯今夜。\n欹绣枕，对银缸。\n相思月半床。\n有谁知，无处问。\n燕子不传芳信。\n花点点，柳丝丝。\n无聊是此时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35761,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏子 其三 离情","author":"吴绮","text":"岭头花，桥上月。\n记得个时离别。\n孺子榻，仲宣楼。\n无端又一秋。\n五更心，千里梦。\n只把鬓丝搬弄。\n空寂寞，好思量。\n篱边菊蕊黄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35762,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏子 其四 和阮亭与友人话秦淮旧事","author":"吴绮","text":"梦扬州，题霅馆。\n杜牧寻春较晚。\n忧莫解，病谁知，愁多变作痴。\n一江波，千里路。\n只办梦儿来去。\n怜薄幸，恨多情，斜阳隔岸筝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35763,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆秦娥 客中生日戏示陶姬","author":"吴绮","text":"今何夕，年年苦被霜华逼。\n十三楼上，几番吹笛。\n山河满目斜阳急，阑干醉倚蛾眉碧。\n蛾眉碧，英雄老矣，壮心犹昔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35764,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉连环 夏景","author":"吴绮","text":"梧桐密处清阴重。\n碧纱风弄，落花帘外舞轻红。\n又与苍苔补空。\n雪藕调冰，佳兴有谁堪共。\n日长纵得绣功夫，不够将愁将梦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35765,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"画堂春 西湖偶作次辰六韵","author":"吴绮","text":"小楼一望暮山横，山光飞上层楼。\n西湖深夏绿波平，荷叶风清。\n芳渚半生花气，画船时送歌声。\n鄂王祠树白公亭，今古关情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35766,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"眉峰碧 其一 立春","author":"吴绮","text":"镜里韶光早，彩胜钗梁袅。\n卷帘都是惜春人，争道是来年好。\n生怕东风小，殃及庭前草。\n玉阶先自送青来，莫教惹得芳心恼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35767,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"眉峰碧 其二 旅夜次上若韵","author":"吴绮","text":"烛灺啼无歇，漏断声还咽。\n一缕春蚕丝不了，都打做心头结。\n泪点红冰叠，罗袖熏难热。\n仙鸾虽自有灵胶，离肠已断何堪接。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35768,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"眉峰碧 其三 有忆","author":"吴绮","text":"一点灯花静，归梦浑难定。\n一夜相思一夜愁，更忍说黄花病。\n酒薄孤衾冷，其奈双眸醒。\n殃及寒鸡不肯啼，分明要把愁支领。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35769,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"眉峰碧 其四 旅思","author":"吴绮","text":"霜皎银蟾烂，风急灯花颤。\n夜夜寒更独自听，怎奈得人长叹。\n忆了千千万，苦把梅花绊。\n试验青衫尽泪痕，也应不是归心慢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35770,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海棠春 晓妆","author":"吴绮","text":"卖花声入红楼响，看檐角、霞销珠网。\n扶倦启香奁，一镜柔情漾。\n郁金梳掠同心样，拼一只、金鸾给赏。\n好极转生疑，更把帘旌敞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35771,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"诉衷情 其一 用刘随州句","author":"吴绮","text":"菊花能醉去官人，出岫笑闲云。\n从来世上豪杰，颠倒信乾坤。\n成往事，付前因。\n总休论。\n五湖虾菜，三泖莼鲈，随地君恩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35772,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"诉衷情 其二 寒夜","author":"吴绮","text":"无端剡雪阻回舟，香梦隔秦篝。\n今宵玉楼寒重，鹦鹉可知愁。\n思作客，话封侯。\n总须休。\n鸳鸯度曲，鹔鹴买酒，且种忘忧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35773,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋波媚 其一 雨中新柳","author":"吴绮","text":"搓就鹅儿绿尚迟，都未使莺知。\n东风无赖，教他细雨，一样丝丝。\n和烟搭在阑干上，约略浅黄时。\n断人肠处，才成眉眼，泪软腰肢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35774,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋波媚 其二 旅怀","author":"吴绮","text":"南浦轻风落藕花，秋色老京华。\n一窗凉月，三更细雨，倦客思家。\n陡来心事香残后，清泪滴琵琶。\n凭谁问取，秦楼过雁，汉关归鸦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35775,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋波媚 其三 秋夜","author":"吴绮","text":"阁外啼乌月晓天，人上鸭头船。\n几番回顾，一声珍重，杨柳门前。\n绣床安在东风里，离别自年年。\n今春何事，嵌将心事，陡地情牵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35776,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"阳台梦 春晓","author":"吴绮","text":"绿鬟风动烟丝袅，碧纱如雾窗开早。\n杨花蓦地扑人来，舞东风不了。\n伤心无限事，渐觉蛾眉翠少。\n十分消瘦百分慵，只镜中人老。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35777,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"太常引 其一 春半","author":"吴绮","text":"小楼丝雨碧桃松，黄入柳条风。\n拾得半春慵，生小惯、纱窗个侬。\n羞弹绿绮，懒裁白苎，无奈是惺忪。\n拼不画眉峰，便有恨、能藏几重。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35778,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"太常引 其二 霜溪鹤问汲山过集寓楼","author":"吴绮","text":"隐囊闲侧帽檐纱，春色遍天涯。\n小阁夕阳，梦只在、临邛酒家。\n当年嵇阮，依然重聚。\n颠倒醉流霞。\n寄语报莺花，肯说道、潘郎鬓华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35779,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"太常引 其三 曾波阁玩月同雁水诸君用稼轩韵","author":"吴绮","text":"桂华清影漾曾波，月借水光磨。\n孤宿笑霜娥，算耐得、长宵几何。\n今年作客，中秋人过，不见旧银河。\n金碗共摩娑，三百盏、倾将未多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35780,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"太常引 其四 隋宫吊古","author":"吴绮","text":"斗鸡台下草如丝，吹断玉参差。\n春到野田迟，有大业、垂杨几枝。\n同来载酒，伤情词客，惆怅落花时。\n苔藓绿遗碑，访遍了、雷塘未知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35781,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其一 寒夜","author":"吴绮","text":"昨晚西窗风斜峭，又把黄梅瘦了。\n人被花香恼，起看天共青山老。\n鹤叫空庭霜月小，夜来冻云如晓。\n谁信多情道，相思渐觉诗狂少。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35782,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其二 望夫矶","author":"吴绮","text":"岁岁江干愁伫立，看遍古今秋色。\n多少归帆疾，如何不见当年客。\n莓苔改尽罗衫碧，莫道重逢不识。\n但说归来得，石头曾有能言日。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35783,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其三 寒夜闻雁","author":"吴绮","text":"霜逼寒衾孤梦断，梦里归期难算。\n夜夜无人管，醒来只有灯相伴。\n山枕斜欹浑欲倦，何处飞来只雁。\n叫得霜雪乱，声声多是江南怨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35784,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"惜分飞 其四 意中","author":"吴绮","text":"酒散西苑卧翠茵，灯已昏昏。\n一轮晴月破凉云，窗眼里照愁身。\n双眸欲睡翻成醒，无奈得自家嗔。\n十年衣惹洛阳尘，空负了意中人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35785,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"朝中措 其一 北园偶作","author":"吴绮","text":"小园一雨便成幽，独自倚西楼。\n六六陂边水满，三三径里花稠。\n清狂似旧，春来放眼，尽日闲游。\n白袷长因酒染，画船偏为诗留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35786,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"朝中措 其二 用刘随州句","author":"吴绮","text":"菊花能醉去官人，金粟记前身。\n半世难忘酒德，一年长祭诗神。\n奚为惆怅，聊将旷达，且养嶙峋。\n稳住半峰山茨，饱餐千里湖莼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35787,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"朝中措 其三 平山堂和欧阳公","author":"吴绮","text":"画楼秋色映遥空，人在白云中。\n一片青山斜日，几株黄叶西风。\n生平得意，耳因酒热，情为诗钟。\n试问看花帝子，何如种柳仙翁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35788,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西江月 其一 咏别次梅村","author":"吴绮","text":"桃叶流将旧怨，柳丝不绾闲愁。\n无端春水泛螺舟，记得画帘招手。\n帐里绡封红泪，灯前扇掩青眸。\n一帆别恨倩谁收，心事浑如中酒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35789,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西江月 其二 广陵记忆同芝麓先生","author":"吴绮","text":"醉后猧翻棋局，醒来鹊语檐牙。\n盈盈十五掩团纱，最忆鸾钗初下。\n几日离情离恨，一江春水春花。\n芙蓉欲采梦无涯，怨煞鸳鸯今夜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35790,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西江月 其三 有见","author":"吴绮","text":"小玉梳成闹扫，善师教就琵琶。\n恼人春着杏儿纱，绣带临风一把。\n红阁画桨萱草，青墙映出梨花。\n斗鸡坊下认儿家，拣取垂杨系马。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35791,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"月中行 用刘随州句","author":"吴绮","text":"菊花能醉去官人，鱼鸟足情亲。\n吴江烟雨绿生鳞，风起暂收纶。\n闻鸡夜舞非吾事，心长在、古柏寒筠。\n刘伶山简共朝昏，休更诵移文。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35792,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"少年游 其一 丁未三月苕中送春","author":"吴绮","text":"草香叶嫩乍晴天，箫鼓放归船。\n翠眉山黛，绿罗波縠，春去不留连。\n情多欲劝春还住，春也道、闰今年。\n人散旗亭，嫩红无恙，犹是待樊川。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35793,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"少年游 其二 醉后赠歌者","author":"吴绮","text":"春来燕市解金貂，取酒听红箫。\n银烛残时，玉山颓也，一曲转无聊。\n刚到销魂魂已断，人似柳条条。\n鲛袖裁香，鸾鎞卧月，休说郑樱桃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35794,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"金凤钩 独见鞋","author":"吴绮","text":"真堪在掌儿上，又只合玉肩斜傍。\n这般些小，怎将偷换，犹自暗垂绣帐。\n行行唯恐纤尘漾，长只向枕边安放。\n笑他邻女，藕花池畔，先已巧偷新样。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35795,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南歌子 其一 闺情","author":"吴绮","text":"银甲调新火，珠帘捲晓霞。\n辟寒初着杏儿纱，正是恼人时节、不归家。\n莺坐浑身柳，蜂归两股花。\n一弦春怨语琵琶，昨夜鸳鸯买卦、又须差。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35796,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南歌子 其二 别怨","author":"吴绮","text":"欲笑宁能笑，想看懒更看。\n背人哀怨有般般，不道大家、一样枕儿寒。\n花底情无限，灯前影乍单。\n休言别后泪长弹，何似当初未别、尽侬欢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35797,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南歌子 其三 最忆","author":"吴绮","text":"最忆愁时面，难为别后心。\n梦牵红袖玉楼阴，却是醒来、原自挽罗衿。\n香冷鸳鸯带，寒轻翡翠衾。\n一生难负是知音，何况蛾眉、相望到而今。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35798,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南歌子 其四 初秋闺怨","author":"吴绮","text":"凫藻才宜火，桃笙不耐香。\n朝来无语暗思量，只恐莲壶银箭、夜须长。\n梦断惟含笑，啼残懒更妆。\n龙须六尺锦匡床，怎奈好天、辜负是新凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35799,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉红妆 其一 咏萤次辕文","author":"吴绮","text":"个侬何事学疏星，向纱窗，暗处生。\n玉儿相见眼偏明，花影下，扇罗衾。\n避人还故傍人行，一些子，最关情。\n飞绕银床休更扑，残月白，露华清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35800,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉红妆 其二 劝酒","author":"吴绮","text":"绣帘初下曲廊西，照垂杨，月影齐。\n有人年少好蛾眉，歌金缕，劝玻璃。\n就中掷眼怕人疑，佯低面，整红衣。\n悄语玉郎须尽醉，郎不饮，又花飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35801,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉红妆 其三 用刘随州句","author":"吴绮","text":"菊花能醉去官人，对鸿妻，引鹤孙。\n癫狂不怕大官嗔，吾眠矣，任诸君。\n前山过雨黛初匀，晚犹带，断霞痕。\n金管玉箫堪载酒，明日访，莫愁村。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35802,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉红妆 其四 凉月","author":"吴绮","text":"一天凉月弄晴晖，带清霜，白雁飞。\n故人煮酒送将归，红烛下，有蛾眉。\n白梅花底雪垂垂，歌金缕，劝酴醾。\n笑问青楼曾薄倖，如杜牧，是为谁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35803,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉花阴 其一 与诗堂纳凉次宏载","author":"吴绮","text":"月照红墙银汉皎，云去青山小。\n别院晚追凉，弄彻瑶笙，越觉花阴悄。\n琼浆满酌开怀抱，醉里乾坤好。\n暗麝夜香清，宝髻逢迎，暑向冰纨少。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35804,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉花阴 其二 初夏集程山尊寓斋","author":"吴绮","text":"杨柳花残隋苑树，明月无寻处。\n此夜集幽人，煮酒西园，酒送江声去。\n平生意气浑难据，踏碎邯郸路。\n拔剑且高歌，醉语诸君，莫似狂夫误。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35805,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉花阴 其三 答人","author":"吴绮","text":"客里风光难到夜，夜更如何也。\n难道不相思，酒熟香温，一个灯花下。\n秋棠红点苍苔罅，惹得寒蛩骂。\n莫说少年狂，老去休文，较为情多怕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35806,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉花阴 其四 虎丘看梅","author":"吴绮","text":"千里莺花山压翠，容易留人醉。\n今古不多时，几度笙歌，浪把东风费。\n画船载酒文章会，替却繁华累。\n一树一倾杯，花落杯中，细嚼春冰味。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35807,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉花阴 其五 书云招饮看花时庭前芍药罂粟荼蘼争艳即席漫赋","author":"吴绮","text":"万朵千阴同一艳，色色层层见。\n白首入名园，雾里看花，雾里红成片。\n枝枝欲把琼浆劝，醉也应难辨。\n花欲实人娇，三种名葩，三个蛾眉伴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35808,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉花阴 其六 甓园分赋","author":"吴绮","text":"章贡江边舟一叶，怒浪喷银雪。\n留客有平原，入座清风，解尽人间热。\n移床共就南楼月，谈笑都全别。\n莫道是寻常，邺苑才华，寥落谁重接。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35809,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"醉花阴 其七 咏翡翠","author":"吴绮","text":"细羽翩跹生岭外，珠树巢南海。\n来去自双双，绀袂青裳，总把轻盈赛。\n奇毛一片多情在，惯得红儿爱。\n何处惹相思，钗股衾窝，点点留光彩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":35810,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]