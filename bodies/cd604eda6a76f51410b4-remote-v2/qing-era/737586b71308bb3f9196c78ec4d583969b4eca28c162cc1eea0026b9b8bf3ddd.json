[{"title":"立秋","author":"惠远谟","text":"草木欲摇落，翛然天地清。\n林塘消暑气，砧杵动秋声。\n叶不因风堕，虫知应节鸣。\n晚凉庭院静，新月傍檐明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28876,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"邓尉观梅用商丘宋抚军韵 其一","author":"惠远谟","text":"千树浑如雪，无花可并香。\n低回松下径，斜掩竹间房。\n蕊密春寒劲，枝空夜月光。\n还元高阁望，胜绝是渔洋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28877,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"邓尉观梅用商丘宋抚军韵 其二","author":"惠远谟","text":"问讯昙山路，言寻石壁花。\n数枝寒寂历，万木冻槎丫。\n砌下湖波汹，岩前野雀哗。\n精蓝芜废尽，犹自发奇葩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28878,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"邓尉观梅用商丘宋抚军韵 其三","author":"惠远谟","text":"最爱紫藤坞，苍松翠柏閒。\n人家倚{石荦}确，鸟语送绵蛮。\n清兴为花发，馀香拂袖还。\n一枝斜插鬓，应笑傍衰颜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28879,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"龙虎山归次答周晚香楼字韵","author":"惠远谟","text":"千里云山一棹收，西风拂面早知秋。\n望回彭蠡烟初合，路入严滩境转幽。\n世味可能成腐鼠，海槎终拟问牵牛。\n松窗落月微明夜，梦绕神山十二楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28880,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重到山中怅然感旧次壁间韵","author":"惠远谟","text":"故人松竹问初盟，流水行云笑此生。\n解语老猿曾识面，试飞雏鹤未知名。\n银笺剩有牢愁句，玉笛偏多感旧声。\n振翮凌风吾已倦，漫劳九万说鹏程。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28881,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜占 其一","author":"惠远谟","text":"明月入小窗，竹影画几席。\n谁家人未眠，声声送长笛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28882,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜占 其二","author":"惠远谟","text":"镫花落夜阑，寒影动虚壁。\n谡谡松间风，鸣涛伴幽寂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28883,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画 其一","author":"惠远谟","text":"抱瓮城南学灌畦，绿蓑黄犊草萋萋。\n一鞭残照柴门底，又见前村月满溪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28884,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画 其二","author":"惠远谟","text":"身是田间稼穑民，数家茅屋自成邻。\n但知牛背一犁雨，不识马蹄十丈尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28885,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋兴","author":"施远恩","text":"愁破方知酒有功，酒杯尽日不教空。\n飘萧败叶千山雨，零乱寒花一径风。\n小摘晚菘含露碧，试尝新橘带霜红。\n閒中自有消閒趣，底事矶边理钓筒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28886,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"龙虎山早秋","author":"施远恩","text":"上清苑木记深幽，老桂婆娑报早秋。\n露冷草虫鸣四壁，月明桐叶坠层楼。\n雷坛树色当窗出，丹井泉香绕石流。\n林壑寂寥龙虎伏，岩前惟见紫云浮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28887,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"老桂行","author":"施远恩","text":"阶前双桂高百尺，势凌霄汉根盘石。\n露染鹅黄一片秋，枝头簇簇团香雪。\n不随桃李斗春工，玉缀玲珑荫瑶席。\n花时供我日日吟，剥啄寻香有来客。\n一从访道西江游，梦绕吴山怅暌隔。\n忽忽烟霞十六更，树影健在人非昔。\n去秋赋归来，喜见旧标格。\n花繁料料金，叶展重重碧。\n一樽浓醁酹花神，与尔周旋仍日夕。\n桂兮桂兮誓将相守不相离，老向山中甘遁迹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28888,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"老朴行","author":"施远恩","text":"环山百年树，其名曰沙朴。\n婆娑烟雨姿，分荫到邻屋。\n具兹千霄材，应入工师目。\n托根不得地，远弃在南服。\n绳尺恐难施，拥肿更蜷曲。\n鸱鸮巢其巅，蝼蚁穴其腹。\n生意良已尽，雨露非不渥。\n未充梁栋选，颇避斧斤斸。\n安知终天年，非以不材福。\n至哉庄生言，宁甘老荒谷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28889,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山居即事","author":"施远恩","text":"秋声动岩壑，爽气满柴关。\n红叶高低树，白云远近山。\n肩因长病耸，发为苦吟斑。\n宠辱浑閒事，浮名似可删。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28890,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"大光明殿步虚词 其一","author":"施远恩","text":"巍巍金阙耸瑶天，羽盖朱轮满大千。\n惭愧野人樗散甚，侍香亲到至尊前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28891,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"大光明殿步虚词 其二","author":"施远恩","text":"诵彻琅函玉笈文，月华如水夜初分。\n琉璃世界通明殿，香气蒸成五色云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28892,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"大光明殿步虚词 其三","author":"施远恩","text":"五铢衣覆九霞裙，上界颁来十赍文。\n何处飞翔双白鹤，夜深还拜玉晨君。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28893,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"大光明殿步虚词 其四","author":"施远恩","text":"洞阙玲珑网户开，金虬导我玉京回。\n道人报国无他愿，只祝风调雨顺来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28894,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晚眺","author":"张云龙","text":"霁烟稍尽见斜曛，极目长空似锦文。\n绀碧缥黄看不尽，一重天间一重云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28895,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"画兰","author":"张云龙","text":"此是幽贞第一花，不侪桃李只云霞。\n采香或可通来径，更写春山一片遮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28896,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晓登钟吾绝顶","author":"陆自逸","text":"石径扪萝葛，来登千仞巅。\n钟声催海日，帆影破湖烟。\n远岫云端列，残星树杪悬。\n长歌归院客，鸡犬下方传。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28897,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"苍坞晚眺","author":"陆自逸","text":"古藤垂峭壁，坐久烟岚滴。\n野寺隔林钟，夕阳牛背笛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28898,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"访褚敏元不遇","author":"贺炳","text":"不见神化象，翻怜浪子游。\n山光衔晓月，云影罨江楼。\n殿角钟鸣午，林边叶报秋。\n孤帆天际出，或恐是归舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28899,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"陆宣公故宅","author":"贺炳","text":"松竹繁阴处，萧条野老家。\n蜂房悬夜月，蛛网吸朝霞。\n苔滑云根乱，檐疏燕子斜。\n人传内相府，风雨泣黄麻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28900,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登金陵报恩塔","author":"贺炳","text":"去国山河在，登高入望新。\n只今烟树色，无复旧时春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28901,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"云岫山漫兴","author":"贺炳","text":"翠岫排云出，支筇绝顶看。\n树深山寺还，泉咽石林寒。\n草近秋逾碧，枫兼霜更丹，不生摇落感，但觉此心宽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28902,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送春","author":"王蘅","text":"丽日红霞烂锦茵，浓和花气欲熏人。\n声声鶗鴂催归急，止剩今朝一日春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28903,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日幽居书事","author":"王蘅","text":"野岸横桥是我家，疏枝墙角老梅遮。\n贫时过午方炊饭，倦到抛书且灌花。\n水长菰蒲藏睡鸭，草深阶砌出鸣蛙。\n身閒自喜浑无事，一枕羲皇日未斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28904,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄友人","author":"黄宽","text":"早春同一别，尽日掩柴门。\n好句有时得，穷愁无复言。\n晓迟江上棹，夜宿月明村。\n未必不相忆，往来劳梦魂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28905,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鸣谦堂雅集听友人弹琴","author":"黄宽","text":"我心寄山水，何处忆高人。\n不觉虚堂上，玄音倍入神。\n泽龙吟正歇，巢鹤倦方伸。\n物理通幽意，相期若比邻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28906,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"上元日集草屩庵望大通寺柬镜波上人","author":"黄宽","text":"不争绮陌逐飞尘，云水偏留此日身。\n只履何年遗故迹，一镫彼岸忆传人。\n青消烟雨蘋非远，绿泛溪桥柳渐匀。\n顾我倦吟归尚早，欲将片舸问前因。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28907,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏日集五松堂观邻寺菩提树影","author":"黄宽","text":"灵根千载忆传镫，片影移来暑化冰。\n说有还无终不著，似空无色亦何凭。\n墙东席地分吟客，树下蒲团入定僧。\n留得浓阴长落此，青松白石即良朋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28908,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟筑别业先柬陈元孝先生","author":"黄宽","text":"花满名山渐渐阴，久拌生计任浮沈。\n一樽美酒供清夜，几度疏风寄短吟。\n身隐已忘天子贵，交疏总得故人心。\n谁云兴尽山阴道，共纪桃源岁月深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28909,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赏菊和查心谷韵","author":"董白","text":"一弓书屋十分秋，闻道群贤逸兴悠。\n共赋新诗花假宠，更斟佳酝客消愁。\n幽姿带露重阳近，爽气浮香几日留。\n笑我九还丹未就，金英满地若为酬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28910,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日久雨寄沈桐溪","author":"李芳","text":"东风料峭镇关心，霪雨连朝思更深。\n乳燕怯飞巢冷院，流莺无语坐空林。\n不因翠减三分色，却恐春过一片阴。\n且恨山行苔藓滑，背关寂寞自长吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28911,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"招桐溪游天竺诸兰若","author":"李芳","text":"入山深不厌，胜日快同游。\n梵放僧归院，歌欢客倚楼。\n回风撩铎语，曲水咽溪流。\n莫谓春将老，春浓桑更稠。\n忆昔东皋侣，频嗟会面稀。\n怀人悲远道，论事觉前非。\n我未徇尘辙，君能脱世鞿。\n浮生真幻梦，行乐莫相违。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28912,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"早发西塘","author":"刘敏","text":"空江无月北风凉，万里吹秋上野航。\n夜半橹声听不断，早潮随雨到西塘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28913,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"静岑梦到山与余同宿俄闻风雨得句云斜风细雨不须归醒而作诗见赠和答","author":"刘敏","text":"岂更劳清念，悠然款我扉。\n迹疏翻得梦，吟健却投机。\n草榻留云宿，蓬窗听雨飞。\n无端双剑合，临觉转依依。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28914,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁寒和紫田居士韵","author":"张士达","text":"阅尽芳菲岁已终，闭门如在万山中。\n居心自比青松劲，题句难赓白雪工。\n远岫云回南至日，长江风送北来鸿。\n梅花驿使传春讯，莫负消寒绿酒筒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28915,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜偶成","author":"吉潮","text":"开轩坐清夜，河汉影濛濛。\n凉气镫前雨，秋声叶上风。\n观心参物我，守拙任穷通。\n何限乘除事，都消一醉中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28916,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登文星阁怀二林居士","author":"吉潮","text":"竹径松门积翠攒，岧峣飞阁耸云端。\n一声清磬随云度，数点遥山卷幔看。\n问字客来虚讲席，悟禅人去冷蒲团。\n苍茫诗思凭阑处，落日归鸦暮色寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28917,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"除夕","author":"缪鹤鸣","text":"年华荏苒又残冬，云水为家事事慵。\n酒债虽无诗债逼，俗情渐淡道情浓。\n霜天一字还乡雁，烟寺三声报晓钟。\n问我金丹真口诀，庵前笑指岁寒松。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28918,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"十月见桃花","author":"李柱","text":"刘郎去后无消息，暖信先从岭上回。\n蹊下惜无仙李伴，一枝寂寞带霜开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28919,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游天台山还里","author":"严克真","text":"山灵笑我寸心违，未结茅蓬在翠微。\n双阙思寻丹药去，一肩挑得白云归。\n天台道出抛游屐，海国人还坐钓矶。\n回忆嫏嬛多福地，尘缘终觉世情非。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28920,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"徐稼翁移居","author":"周望","text":"羡君新卜鹿门居，岸帻高吟处士庐。\n留得春风花下酒，课存秋雨案头书。\n轩窗岑寂心无竞，竹石经营意有馀。\n惟惜旧朋相隔远，幽怀渺渺独伤余。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28921,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送慎言弟还武陵并寄子靖南宫昆季","author":"周望","text":"弱冠相逢志激昂，即今重晤鬓俱苍。\n侧身天地容鸠杖，弹指光阴老雁行。\n数日言旋期太短，一尊道故话偏长。\n西还寄语诸昆弟，诗酒情耽较昔狂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28922,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋燕和曹春浦韵","author":"钱凝烟","text":"清秋燕子故飞飞，惨淡离情语落晖。\n我亦故山归未得，不禁残泪欲沾衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28923,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄赵壶石","author":"隋鹏","text":"见说高阳侣，潜居一亩宫。\n春残杨柳月，秋老蓼花风。\n习懒因常健，佯狂故自雄。\n不知燕市里，买醉许谁同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28924,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登黄鹤楼","author":"曹志道","text":"不见仙人黄鹤归，白云江上弄斜晖。\n谁吹玉笛阑干外，恐有梅花五月飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28925,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自题山水画册","author":"张远","text":"烟岚浓冷雨初晴，人在翠微深处行。\n云气湿衣风透骨，隔林犹听乱泉声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28926,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"观泉","author":"钟正修","text":"扶筇雨后过前川，石磴声喧泻涧泉。\n流出小桥江上去，桃花浪里一渔船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28927,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送伯兄之江南","author":"俞中楷","text":"不多聚首别思长，把臂谈心对夕阳。\n此去吴江好风景，山花踏破马蹄香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28928,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"洞霄宫怀古 其一","author":"钱一清","text":"落日照松竹，山中风气寒。\n我来凭吊古，谁与共还丹。\n抚掌泉心涩，舞蛟亭翠残。\n可怜为圃客，当日尽仙官。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28929,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"洞霄宫怀古 其二","author":"钱一清","text":"邓志喜时出，陈君锓板勤。\n地灵原首望，天柱更三分。\n没骨难寻箬，无心且看云。\n大丹如易与，妙道不传文。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28930,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登积金峰","author":"张学景","text":"石磴半空上，松涛万壑吟。\n偶因寻药至，不觉入云深。\n树密藏丹室，泉飞挂碧岑。\n始知仙境静，终古涤凡心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28931,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晚吟","author":"王至淳","text":"散步平湖岸，烟波浩渺中。\n月明天在水，云断树浮空。\n吹笛惊山鹿，弹琴送渚鸿。\n时来坐幽阁，孤寂与谁同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28932,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书兴","author":"王至淳","text":"重重云树四围遮，心喜年来远世华。\n饮酒须寻陶令宅，读书思向邺侯家。\n雨馀破屋生秋菌，风过閒塘落野花。\n信是幽人清兴好，又随农父话桑麻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28933,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"八月十六日自怀","author":"刘虚静","text":"夜静虚堂寂，林深鹤自閒。\n风声喧远水，月色冷空山。\n独坐长松下，悠然修竹间。\n红尘心不恋，瑶岛尚容攀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28934,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题自写山水箑寄怀胡古泉","author":"朱福田","text":"有客迢迢隔剑关，相思无计慰离颜。\n却从鸟道干盘外，写寄江南平远山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28935,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秦淮吊古","author":"朱福田","text":"淮水遥通江上潮，金陵王气此中消。\n祖龙一凿关何事，直遣繁华送六朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28936,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"板桥豆花庄晤马菊村","author":"朱福田","text":"言寻板桥路，喜过豆花村。\n老屋恰临水，故人方倚门。\n欣然具鸡黍，相与论田园。\n何日南山下，同君避市喧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28937,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜晤栖碧上人","author":"朱福田","text":"与师一别三年久，忽地相逢贺监家。\n我自夜深扶病骨，忍寒同对白桃花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28938,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宿钟山白云庵","author":"朱福田","text":"晴看日向海中出，雨觉云从足底生。\n唤起江城六朝梦，天风吹下木鱼声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28939,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"早春山斋即事","author":"朱福田","text":"山斋兀坐久忘机，镇日閒吟客到稀。\n花气一林初过雨，春寒二月转添衣。\n浴波水鸟破烟立，断线风鸢掠地飞。\n目极平原芳草色，东风绿遍钓鱼矶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28940,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游雨花台过武南冈处士别业留赠","author":"朱福田","text":"空台寂寞久，日日满残阳。\n不见雨花迹，时闻丛桂香。\n冈头望深竹，幽处有茅堂。\n长揖就处士，别来颜鬓苍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28941,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"松寥阁海峰上人招饮同韬庵","author":"朱福田","text":"斜阳虚阁敞松寥，阁下寒江万里潮。\n山木叶稀苍鼠窜，海门声起大鱼骄。\n百年几度双丸速，一盏閒愁万古消。\n安得此间容我隐，沧洲无事狎渔樵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28942,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"十一月十五日夜鸠江桃唐堤上独步","author":"朱福田","text":"桃唐烟水正迷离，几处亭台入画时。\n岸上谁家夜吹笛，一轮明月照鸠兹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28943,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题杨体之明府担稻图","author":"朱福田","text":"寸田可治生，一粒固为宝。\n苟能悟其微，仙圣域皆造。\n先生旧宰官，现身自担稻。\n治民如治田，借稻以喻道。\n一发圣经蕴，閒复穷释老。\n使有二顷田，退耕固为好。\n顾抱经纬才，催科甘下考。\n苍生待作霖，日望卸肩早。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28944,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]