[{"title":"感遇","author":"李寄","text":"今日天雨露，独荣荆棘枝。\n荆棘窃雨露，自矜桃李姿。\n桃李志阳春，狂飙日夜吹。\n狂飙过荆棘，不损其毫釐。\n荆棘笑桃李，何为独不时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21425,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"涂次绮山","author":"李寄","text":"溪路荣藤木，行来憩石閒。\n风声长在树，云影不离山。\n弃世何妨懒，趋人那得閒。\n老僧真自在，茅屋不曾关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21426,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"野步","author":"李寄","text":"旅窗真闷极，晚斋望秋来。\n溪水拖烟尾，山峦曝雨腮。\n独行歌兴逸，一笑客愁开。\n今夜中秋月，谁人送酒杯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21427,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"从军行二首 其一","author":"李寄","text":"誓将七尺净胡尘，今日天山又勒铭。\n一战尽收回鹘马，长驱直捣老龙庭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21428,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"从军行二首 其二","author":"李寄","text":"马上雕弓日夜鸣，生擒冒顿馘中行。\n男儿不为封侯印，要为中华扫不平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21429,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"塞下曲","author":"李寄","text":"榆关黄叶堕，边士日持竿。\n百战惟闻鼓，长驱不解鞍。\n风飘笳韵急，霜拂剑光寒。\n万里沙场月，闺中夜夜看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21430,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"书怀","author":"李寄","text":"浮云世事断蓬身，那得山居作隐沦。\n好语幽人松下卧，莫将白眼看他人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21431,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"七夕戏占","author":"李寄","text":"谁家姊妹拜天孙，絮絮通陈乞巧文。\n织女只因无巧算，年年直待此黄昏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21432,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题虎丘","author":"李寄","text":"烟霞留过客，日月促乾坤。\n今古山如此，登临几换人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21433,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"登君山","author":"李寄","text":"乾坤晴日大，千里不曾迷。\n白练分江静，青烟剪树齐。\n独游全是兴，偶影自无诋。\n世路容余窄，山中与鸟栖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21434,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"野步黄山隅","author":"李寄","text":"萋萋径草绿新齐，怕损春光屐缓提。\n潮没小桥何处渡，花开野店有人携。\n犬惊怪客争来吠，鸟识幽人自在啼。\n两岸垂杨藏钓艇，却疑身入武陵溪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21435,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"早入绮山","author":"李寄","text":"遥看岚霭连松柏，行口山峦面面开。\n曝日鼠缘松树顶，啄冰鸟立涧泉隈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21436,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过酒家","author":"李寄","text":"犹见桥边旧酒垆，十年兴不似当初。\n纵拌数斗王公酒，肯换师官经丈书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21437,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"无题","author":"李寄","text":"竹里能仁寺，光邀屐过溪。\n晚风松中霁，春树鸟新啼。\n茶践三年约，诗开旧日题。\n桃源身误入，归路暮云迷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21438,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"顾山山茶和昆山顾潜","author":"李寄","text":"闻说昭明植甚真，孙枝犹见昔时春。\n废兴一物非无数，呵护千年定有神。\n狂客醉呼汤般若，恶奴狠踏瓦乌鳞。\n激成斫伐由吾辈，莫怪山僧太俗人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21439,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自号昆崙山樵戏题二绝 其一","author":"李寄","text":"拂衣罢试卧柴门，燕赵悲歌气尚存。\n闻说昆崙压太白，今昆崙压旧昆崙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21440,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自号昆崙山樵戏题二绝 其二","author":"李寄","text":"醉卧当垆不肯回，相公促数使人催。\n杖头经岁无钱挂，一石输君笑口开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21441,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"三和池阳咏雪次东坡韵 其一","author":"李寄","text":"风前随与自秾纤，三爵醺然便解严。\n吕叟自誇诗有蝶，东坡不叹食无盐。\n平铺山径全埋路，冻断钟声不出檐。\n塞上昭君应从猎，马头花簇锦靴尖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21442,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"三和池阳咏雪次东坡韵 其二","author":"李寄","text":"雪中树黑生乌鸦，占麦农人祝满车。\n万里连山疑入画，一朝见晛悟空花。\n满江芦映渔人艇，绕屋梅开处士家。\n闭户先生三日卧，壁閒闲杀小钱叉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21443,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"四和池阳咏雪次东坡韵 其一","author":"李寄","text":"随风摇漾态何纤，此日寒威分外严。\n行客借来形柳絮，酒人引去比吴盐。\n苦吟不觉衫穿袖，烂醉何妨帽挺檐。\n莫笑浩然无逸兴，病驱不敌北风尖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21444,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"四和池阳咏雪次东坡韵 其二","author":"李寄","text":"纷纷一望白天涯，自笑经年滞客车。\n秦月晓来真不夜，山桃寒重亦能花。\n烹羔不羡将军帐，煮茗还输学士家。\n乘兴策驴诗思好，灞桥定有酒帘叉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21445,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"五和池阳咏雪次东坡韵 其一","author":"李寄","text":"风前密密复纤纤，威发枝头夜更严。\n始信梁园多白燕，应知北地少红盐。\n充肠旧种长腰芋，煖脑新兴厚帽檐。\n怪杀天公能戏谑，梅花开满万松尖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21446,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"五和池阳咏雪次东坡韵 其二","author":"李寄","text":"谁爱琼林数点鸦，灞桥驴背洛阳车。\n泠泠行触风前絮，缓缓归看陌上花。\n玉佩金鱼将换酒，绿蓑青笠正浮家。\n分笺客斗新诗句，七步应输手八叉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21447,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"六和池阳咏雪次东坡韵 其一","author":"李寄","text":"一夜西风雪满岩，棱棱天地气森严。\n黄河冰定连清济，赤甲山应混白盐。\n露指不堪寻败屦，山头无奈碍低檐。\n明朝拟上丰年颂，大剑长鎗避笔尖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21448,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"六和池阳咏雪次东坡韵 其二","author":"李寄","text":"好手天公应自誇，长空万里禦虬车。\n敲残宝月光成片，关倒银河浪作花。\n贾岛吟肩徒有骨，袁安僵卧并无家。\n近来诗律精严甚，莫怪人呼王夜叉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21449,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"七和池阳咏雪次东坡韵 其一","author":"李寄","text":"瑞叶纷飞太不纤，卜晴须问蜀城严。\n已倾旧酿屠苏酒，谁奏新声刮骨盐。\n招隐门应开小径，寻梅车定驾长檐。\n少陵诗更添佳兴，万点山如玉笋尖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21450,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"七和池阳咏雪次东坡韵 其二","author":"李寄","text":"玉树风摇缩项鸦，与来缓步以当车。\n沾衣似咤单袍冷，扑面如嘲两鬓花。\n红手戏团看稚子，素萼传赏羡僧家。\n千人自笑非吾事，十笏因君礼药叉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21451,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"八和池阳咏雪次东坡韵 其一","author":"李寄","text":"东风出地草纤纤，冬令重行咤转严。\n青帝新翻名玉戏，仙家旧酿有金盐。\n画中蛱蝶飞盈座，笛里冰花落满檐。\n梓泽莫誇鲜韭美，篱边笋巳透春尖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21452,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"八和池阳咏雪次东坡韵 其二","author":"李寄","text":"枝头声已变春鸦，却闭行窝驻小车。\n惨淡山呈荆浩画，缤纷天雨曼陀花。\n赋成授简谁为客，酒熟当炉即是家。\n徙倚南荣看北皦，老樵径滑倚柴叉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21453,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"次杜工部秋兴八首 其一","author":"李寄","text":"漠漠轻烟带远林，霜高气肃自萧森。\n千崖月上开清景，万里风来扫积阴。\n比德巢由先有志，共图王霸庶无心。\n江湖袖手行歌曼，閒数秋城户户砧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21454,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"次杜工部秋兴八首 其二","author":"李寄","text":"閒倚枫林看日斜，空山留得旧□华。\n欲剸龙耳探灵洞，思合莲丹坐古槎。\n可奈弥天皆毒雾，不堪遍地是胡笳。\n秋风老却陶潜菊，雪里还开强项花。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21455,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"次杜工部秋兴八首 其三","author":"李寄","text":"金风淅淅送斜晖，便觉衰颜酒力微。\n海运鹍鹏看怒徙，塞寒鸿雁听哀飞。\n远寻道侣因缘误，遍踏名山筋力违。\n黄鹄冲天男子事，肯甘燕雀稻粱肥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21456,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"次杜工部秋兴八首 其四","author":"李寄","text":"莫看仙人一局棋，斧柯终烂亦堪悲。\n岂知争却千年日，孰若抽身八极时。\n云护池中龙卧稳，月明江上鹤归迟。\n抚髀自叹吾衰矣，事事伤心不可思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21457,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"次杜工部秋兴八首 其五","author":"李寄","text":"廿载栖迟故国山，避人尚恨在人閒。\n五湖烟景笼鱼艇，双木松风护死关。\n蓝玉那能充煖腹，金丹定肯驻衰颜。\n真仙似以轻狂谪，敢跻瑶池许碏班。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21458,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"次杜工部秋兴八首 其六","author":"李寄","text":"父老阳春望转头，金陵王气索然秋。\n宫廷薪胆人皆讳，荆棘铜驼客已愁。\n厮养时来成翼虎，英雄运去逐眠鸥。\n中原尺寸当□□，区脱如何视豫州。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21459,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"次杜工部秋兴八首 其七","author":"李寄","text":"忆昔高皇创业功，白山黑水版图中。\n四□荫庇扶桑日，万国薰蒸闾阖风。\n武教治兼文教盛，一年粟有两年红。\n三韩自是神京臂，遗事犹堪问老翁。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21460,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"次杜工部秋兴八首 其八","author":"李寄","text":"卜年八百数逶迤，反覆终当类复陂。\n旧日龙髯犹在地，荒陵鹃血好殷枝。\n诛奸史笔千年在，梅祸天心一旦移。\n白水金刀闻汉谶，云台愿附姓名垂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21461,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"大雪再次东坡韵","author":"李寄","text":"丰年呈瑞看秾纤，举手寒威入袖严。\n不独铺云能作海，果然扫土便成盐。\n凤池学士冰山倚，貂帽郎官狗尾檐。\n乘与东坡舒望眼，惊看马耳没双尖。\n开口谁怜望哺鸦，出门我叹鹧鸪车。\n折腰已瘁陶潜柳，强项空开董令花。\n行客扮成琼岛客，贫家装就玉堂家。\n乾坤一变谁支拄，垂老看予瘦骨叉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21462,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"补窗","author":"金锷","text":"峭寒连日逼疏棂，补出层层衬画屏。\n望去诗书都雪亮，坐来帏帐讶风停。\n冻蝇从此钻难破，宝鸭能教爇倍馨。\n傥得处宗难解语，未妨竟夕隔窗听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21463,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"扫地","author":"金锷","text":"陈蕃扫室每辞慵，我爱倪迂执帚从。\n岂比向时尘拂面，顿教立地镜开容。\n端严研几才无俗，整理琴书不厌重。\n尚逊当年清閟阁，竹梧洗到绿痕浓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21464,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"焚香","author":"金锷","text":"鹧斑初试麝才薰，尽日垂帘看篆文。\n掠地清风吹不散，告天心事密难闻。\n搏山垆煖春如海，沈水烟浓晓结云。\n何处可容参一瓣，笔床砚匣总氤氲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21465,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"灌花","author":"金锷","text":"群芳人谱各争妍，自灌根荄忍息肩。\n一日看花千日养，三分人事七分天。\n还祈宿雨沾枝上，好趁朝暾隔树颠。\n消受繁华如锦绣，须知调护在春先。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21466,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"武林旅夜即事","author":"金锷","text":"离江三十里，独坐忽闻潮。\n夜半月初上，秋来木未彫。\n鱼龙吹浪近，风雨入城遥。\n壮士知何限，茫茫共此宵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21467,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赠朱心垣","author":"金锷","text":"才人逸气肯消磨，老去名山襆被过。\n千里江湖供啸傲，两閒诗卷任搜罗。\n王融杂组年来满，张嵊清谈客邸多。\n我正匆匆归放棹，钱塘门外奈愁何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21468,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"岁暮旋里","author":"金锷","text":"游子念高堂，游云返故乡。\n长风送归棹，细雨湿轻装。\n放眼程途远，惊心节序忙。\n匆匆岁云暮，又见早梅芳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21469,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"立春日吴江道中","author":"金锷","text":"飞霰朝朝羁此身，晓看物候一番新。\n太湖雪霁天连水，小艇风来气已春。\n细草欲苏怜过客，梅花已放解迎人。\n计程渐近兰陵路，竹树吾卢望眼频。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21470,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"柘湖即事","author":"金锷","text":"九峰才过一帆斜，二月烟村放杏花。\n隔海人家有鸡犬，满城春色是桑麻。\n鲈鱼入馔惊新味，莼菜沿溪发嫩芽。\n同此江南好时节，云山何用怅天涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21471,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"幽居四首 其一","author":"金锷","text":"飒飒西风落叶新，槐根小筑傍何滨。\n功名岂便称人杰，遇合从来有夙因。\n五亩未谋归隐地，一编依旧苦吟身。\n燕云万里无消息，夕雁晨鸿枉自频。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21472,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"幽居四首 其二","author":"金锷","text":"韶华回首去如驰，红树青山又一时。\n夜雨联床新得句，秋风吹帽旧题词。\n隍中蕉鹿原非梦，江上莼鲈别有思。\n暇日聊为无事饮，未妨酩酊任倾卮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21473,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"幽居四首 其三","author":"金锷","text":"海天万里路茫茫，却忆卢鸿旧草堂。\n辟蠹无方空隐几，截蛟有字或黏墙。\n小园几处栽榆柳，旧圃何时足稻粱。\n人事十年成往迹，可容长楫恕清狂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21474,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"幽居四首 其四","author":"金锷","text":"寂寞寒缸拥百城，圆曦倏又照窗明。\n少陵词赋工无益，开府文章老更成。\n要看黄花持晚节，怕听翠竹起秋声。\n几时真遂田园乐，头白还堪负耒耕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21475,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日郊游二首 其一","author":"金锷","text":"客里春光过禁烟，春游好趁雨馀天。\n大彭馆外青青柳，不唱阳关也可怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21476,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日郊游二首 其二","author":"金锷","text":"燕子楼边草径荒，尚书旧第最凄凉。\n珠歌翠舞人何在，一树桃花淡夕阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21477,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"独酌","author":"金锷","text":"窗前几日绿成阴，小饮还宜潋滟斟。\n独乐略知迁叟意，息机久识丈人心。\n须防抵鹊休持玉，始信呼卢莫注金。\n暂与瞢腾君莫笑，茫茫世事古犹今。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21478,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"偶成","author":"金锷","text":"忽辞枝去送残春，零落飞花最怆神。\n寄语东风好护惜，不放堕溷只飘茵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21479,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题陈小屏春明饯别图三首 其一","author":"金锷","text":"都门送别柳如烟，裙屐风流忆昔年。\n恨煞尊前飞絮急，玉萧金管正缠绵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21480,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题陈小屏春明饯别图三首 其二","author":"金锷","text":"匆匆两度送归骖，枚马仙班又酒酣。\n莫怪抟沙容易散，歌喉谁是旧何戡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21481,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题陈小屏春明饯别图三首 其三","author":"金锷","text":"廿载轮蹄别眼深，花间我亦记题襟。\n近来久绝春明梦，今夕无端感不禁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21482,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"中秋下邳舟次二首 其一","author":"金锷","text":"海月团团上，河涛滚滚流。\n遥山见西楚，佳节又中秋。\n酒易瞢腾醉，豪誇汗漫游。\n梁园有人盼，椓杙莫淹留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21483,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"中秋下邳舟次二首 其二","author":"金锷","text":"遥忆高堂上，蟾光定一般。\n却怜今夜月，难得故乡看。\n久客心情减，深宵风露寒。\n舵楼聊遣兴，小饮具杯盘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21484,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"重九日虞城道中","author":"金锷","text":"虞城道上正车驰，何处登高可赋诗。\n却忆去年同看菊，雨螯斫雪劝餐时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21485,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"上年九日姚子芗招饮犬河月夜舟行六首 其一","author":"金锷","text":"上下天光入望宽，秋宵明月正高寒。\n尽教九曲波无际，化作琉璃一色看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21486,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"上年九日姚子芗招饮犬河月夜舟行六首 其二","author":"金锷","text":"挂帆今夜好风多，莫问云涛几曲过。\n鸡犬不闻烟树远，却疑船已近银河。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21487,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"上年九日姚子芗招饮犬河月夜舟行六首 其三","author":"金锷","text":"玉宇真无纤翳蒙，芙蓉一朵掷晴空。\n珠宫贝阙知何处，都在蟾光照耀中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21488,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"上年九日姚子芗招饮犬河月夜舟行六首 其四","author":"金锷","text":"几尺云罗映水遥，金枝闪处翠旗飘。\n若非月殿开青锁，定是星軿下降霄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21489,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"上年九日姚子芗招饮犬河月夜舟行六首 其五","author":"金锷","text":"两岸高峰忽送青，风涛喧耳几曾停。\n大罗天上霓裳曲，知有仙人记共听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21490,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"上年九日姚子芗招饮犬河月夜舟行六首 其六","author":"金锷","text":"上界分明见斗台，中流隐约过渐台。\n不妨便作乘槎看，此水原从天上来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21491,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"道经彭城有感二首 其一","author":"金锷","text":"彭门旧游地，重过转凄然。\n绿树非前度，青山似往年。\n宾僚感今昔，客旅怕株连。\n慎勿探东阁，荒凉蔓草边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":21492,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]