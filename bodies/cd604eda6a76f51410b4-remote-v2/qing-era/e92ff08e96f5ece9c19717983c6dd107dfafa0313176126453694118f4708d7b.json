[{"title":"己亥杂诗 其四十一","author":"黄遵宪","text":"五十年前事未忘，白头诸母说家常。\n指渠坠地呱呱处，老屋西头第四房。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13451,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其四十二","author":"黄遵宪","text":"一路春鸠啼落花，十龄学步语牙牙。\n锦袍曾赋小时月，月照恒河鬓已华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13452,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其四十三","author":"黄遵宪","text":"忽想尻轮到五洲，海泓烟点小齐州。\n丁年破浪乘风兴。\n画壁留图作卧游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13453,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其四十四","author":"黄遵宪","text":"几星十二遍周天，绕尽圆球剩半环。\n法界楼台米家画，总输三岛小神山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13454,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其四十五","author":"黄遵宪","text":"长恨古人吾不见，又疑诸史半欺谩。\n女王铜镜委奴印，亲手摩挲对面看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13455,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其四十六","author":"黄遵宪","text":"乌呼碑下吊忠臣，蹈海人人耻帝秦。\n震地哭声涂地血，大东扶起一红轮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13456,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其四十七","author":"黄遵宪","text":"滔滔海水日趋东，万法从新要大同。\n后二十年言定譣，手书《心史》井函中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13457,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其四十八","author":"黄遵宪","text":"一夫奋臂万人呼，欲废称臣等废奴。\n民贵遂忘皇帝贵，莫将让国比唐虞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13458,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其四十九","author":"黄遵宪","text":"当时传檄开荒令，今日关门逐客书。\n浪诩皇华夸汉大，请看黄种受人锄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13459,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其五十","author":"黄遵宪","text":"赫赫红轮上大空，摇天海绿化为虹。\n从今要约黄人捧，此是扶桑东海东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13460,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其五十一","author":"黄遵宪","text":"四百由旬道路长，忽逢此老怨津梁。\n沈沈睡过三千岁，可识西天有教皇？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13461,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其五十二","author":"黄遵宪","text":"上烛光芒曜日星，东西并峙两天擎。\n象形文字鸿荒祖，石鼓文同石柱铭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13462,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其五十三","author":"黄遵宪","text":"一刀截断大河横，省却图南六月程。\n海客欢呼土民怨，债台高筑与天平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13463,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其五十四","author":"黄遵宪","text":"琼阙丹房曜彩霞，烂红玫瑰雨天华。\n外孙鲁酒皇娥瑟，同醉西方阿母家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13464,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其五十五","author":"黄遵宪","text":"生是天骄死鬼雄，全欧震荡气犹龙。\n世间一切人平等，若算人皇只乃公。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13465,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其五十六","author":"黄遵宪","text":"万灯悬耀夜光珠，照出诸天夜燕图。\n缨络纲云花散雨，居然欲界有仙都。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13466,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其五十七","author":"黄遵宪","text":"长夜漫漫日不光，黑风吹我坠何方？\n苍天已死黄天立，惟见团团鸡子黄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13467,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其五十八","author":"黄遵宪","text":"眼底尘惊世界微，天风浩浩吹人衣。\n便当御气乘球去，饱看环瀛跨海归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13468,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其五十九","author":"黄遵宪","text":"浮沈飘泊年年事，偶寄闲鸥安乐窝。\n急雨打窗浪摇壁，无端平地又风波。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13469,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其六十","author":"黄遵宪","text":"云为四壁水为家，分付名山改姓佘。\n瘦菊清莲艳桃李，一瓶同供四时花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13470,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其六十一","author":"黄遵宪","text":"上山如画重累人，结屋绝无东西邻。\n襟间海上一丸月，屐底人间万斛尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13471,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其六十二","author":"黄遵宪","text":"甑蒸汗雨郁如珠，雨腋清风习习俱。\n浴过凉波三百斛，才知灌顶妙醍醐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13472,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其六十三","author":"黄遵宪","text":"三年团扇在怀袖，六月重裘仍带围。\n万里归槎北风急，经旬却换五时衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13473,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其六十四","author":"黄遵宪","text":"蟹行草字画祛庐，蜡印红鹰两翼舒。\n君主花名民主押，箧中留得两除书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13474,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其六十五","author":"黄遵宪","text":"梦里似曾迁海外，醉中不觉到江南。\n茫茫人海浮沈处，添得闲鸥又二三。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13475,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其六十六","author":"黄遵宪","text":"我行偏历三天下，松寥一阁天下奇。\n两鼎蟠螭碑《瘗鹤》，还有椒山手写诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13476,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其六十七","author":"黄遵宪","text":"黄鹤高楼又挞碎，我来无壁可题诗。\n擎天铁柱终虚语，空累尚书两鬓丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13477,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其六十八","author":"黄遵宪","text":"御屏丹笔记名新，天语殷殷到小臣。\n九牧盛名吾岂敢，知非牛李党中人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13478,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其六十九","author":"黄遵宪","text":"丹楼彩日画中看，初上鸾坡举步难。\n劳动九重前席问，绣衣门外立天官。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13479,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其七十","author":"黄遵宪","text":"尧天到此日方中，万国强由法变通。\n惊喜天颜微一笑，百年前亦与华同。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13480,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其七十一","author":"黄遵宪","text":"奉使虚闻结德车，却回无袖到长沙。\n青鸾传到东皇信，又泛蓬莱八月槎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13481,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其七十二","author":"黄遵宪","text":"三诏严催倍道驰，《霸朝》一集感恩知。\n病中泣读维新诏，深恨锋车就召迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13482,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其七十三","author":"黄遵宪","text":"冷月严霜照一灯，柝铃风送响腾腾。\n案头英簜门前戟，岂有籧篨覆瘐冰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13483,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其七十四","author":"黄遵宪","text":"七十尚书出负戈，三闾憔悴怨湘波。\n抚琴欲鼓《拘幽操》，軏唱臣难唤奈何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13484,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其七十五","author":"黄遵宪","text":"竟写梅边生祭祠，亦歌塞外送行诗。\n候人鹄立门如海，浪语风闻百不知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13485,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其七十六","author":"黄遵宪","text":"怜君胆小累君惊，抄蔓何曾到友生。\n终识绝交非恶意，为曾代押党碑名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13486,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其七十七","author":"黄遵宪","text":"环门松竹喜相迎，倚树安楼鸽不惊。\n对镜头颅顾妻笑，几乎此事却干卿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13487,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其七十八","author":"黄遵宪","text":"莱佣酒保笑言欢，偶数江湖几谪官。\n反蔓环门兰在室，呼儿重检《汉书》看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13488,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其七十九","author":"黄遵宪","text":"花落庭空对紫薇，画帘重处漾斜晖。\n衔雏燕子浑无赖，眼见人瞋故故飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13489,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其八十","author":"黄遵宪","text":"寒灯说鬼鬼啾啾，夜雨言愁我欲愁。\n只有蓬山万重隔，未容海客说瀛洲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13490,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其八十一","author":"黄遵宪","text":"左列牛宫右豕圈，冬烘开学闹残年。\n篱边兀坐村夫子，极口娲皇会补天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13491,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其八十二","author":"黄遵宪","text":"寒垆爆栗死灰然，酒冷灯昏倦欲眠。\n惊喜读书声到耳，细听仍是《八铭篇》。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13492,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其八十三","author":"黄遵宪","text":"风雨鸡鸣守一庐，两年未得故人书。\n鸿离鱼网惊相避，无信凭谁寄与渠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13493,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其八十四","author":"黄遵宪","text":"颈血模糊似未乾，中藏耿耿寸心丹。\n琅函锦箧深韬袭，留付松阴后辈看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13494,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其八十五","author":"黄遵宪","text":"古佛孤灯共一龛，无人时与影成三。\n何方化得身千百？\n日换新吾对我谭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13495,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其八十六","author":"黄遵宪","text":"地球捧问海中央，多少红毛国几方？\n听说龙飞周甲宴，挽须要去问英皇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13496,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其八十七","author":"黄遵宪","text":"相约儿童放学时，小孙拍手看翁嬉。\n平生两事轰轰乐，爆竹声腾鹞子飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13497,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其八十八","author":"黄遵宪","text":"镜中几几换容仪，讳老无妨略镊髭。\n今日发旟悬不起，星星知剩几茎丝？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13498,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥杂诗 其八十九","author":"黄遵宪","text":"蜡余忽梦大同时，酒醒衾寒自叹衰。\n与我周旋最亲我，关门带读自家诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13499,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其一","author":"黄遵宪","text":"白发沧江泪洒衣，别来商榷更寻谁？\n闲云野鹤今无事，可要篮舆共护持？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13500,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其二","author":"黄遵宪","text":"纷纭国是定维新，一疏惊人泣鬼神。\n寻遍东林南北部，一家钩党古无人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13501,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其三","author":"黄遵宪","text":"荐贤略似孔文举，下狱还因吕步舒。\n一编选佛科名录，便是司空城旦书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13502,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其四","author":"黄遵宪","text":"金华讲殿共论思，圣祖文宗旧典贻。\n指问鸡楼庭下树，可容别筑凤凰池？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13503,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其五","author":"黄遵宪","text":"优孟衣冠笑沐猴，武灵胡服众人咻。\n问君薙发新王令，换却顽民多少头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13504,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其六","author":"黄遵宪","text":"龙泉知我剑随身，三斗撑胸热血新。\n是我眼中神后物，熊罴男子凤凰人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13505,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其七","author":"黄遵宪","text":"南狱云开筚路初，归来秋雨卧相知。\n零星几卷灵鹣阁，只算江郎制锦余。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13506,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其八","author":"黄遵宪","text":"我歌乐府《寿人》曲，君作师儒绍圣篇。\n烂熳众雏环我拜，登堂公瑾是同年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13507,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其九","author":"黄遵宪","text":"文如腹中所欲语，诗是别后相思资。\n三载心头不曾去，有人白皙好须眉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13508,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其十","author":"黄遵宪","text":"念我平生同队鱼，又念丈人屋上乌。\n翩翩公孙才似舅，因君问讯今何如。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13509,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其十一","author":"黄遵宪","text":"臣罪当诛父罪微，呼天呼父血沾衣。\n白头玄鬓《哀蝉曲》，减尽维摩旧带围。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13510,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其十二","author":"黄遵宪","text":"一卷生花《天演论》，因缘巧作续弦寥。\n绛纱坐帐谈名理，胜似麻姑背䖹搔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13511,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其十三","author":"黄遵宪","text":"兼综九流能说佛，旁通四部善谈天。\n红灯夜雨围炉话，累我明朝似失眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13512,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其十四","author":"黄遵宪","text":"平生著述老经师，绝妙文章幼妇词。\n今日皋皮谈改制，《黄书》以外录《明夷》。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13513,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其十五","author":"黄遵宪","text":"闪电双眸略似嗔，知君龙性未能驯。\n同游莫学梁园客，自负山膏好骂人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13514,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其十六","author":"黄遵宪","text":"自家家法自家妆，乡里传夸马粪王。\n花样时文笋尖脚，可容儿女再商量。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13515,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其十七","author":"黄遵宪","text":"船山大隐师承远，东海褰冥学派新。\n编到《沅湘耆旧录》，难为君称作龙身。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13516,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其十八","author":"黄遵宪","text":"屈指中兴六七公，论才考德首南丰。\n笼人意气谈天口，转似区区隘乃翁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13517,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其十九","author":"黄遵宪","text":"少年罪状在《金荃》，中岁骖鸾便学仙。\n《魂北》、《魂南》今哭遍，再倾泪海哭桑田。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13518,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其二十","author":"黄遵宪","text":"四壁青山乱叠书，蓬蒿波径闭门居。\n记曾元子坊边遇，手絜筠篮贯柳鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13519,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其二十一","author":"黄遵宪","text":"相约乘槎万里遥，天风吹散各蓬飘。\n屋梁月黑思君梦，忽梦平生吴铁乔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13520,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其二十二","author":"黄遵宪","text":"头颅碎掷哭浏阳，一凤而今剩楚狂。\n龟手正需洴澼药，语君珍重百金方。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13521,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其二十三","author":"黄遵宪","text":"背负灵囊欲大包，东西游说日譊譊。\n冶佣酒保相携去，幸免门生瓜蔓抄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13522,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"己亥续怀人诗 其二十四","author":"黄遵宪","text":"谬种千年《兔园册》，此中埋没几英豪。\n国方年少吾将老，青眼高歌望尔曹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13523,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"腊月二十四日诏立皇嗣感赋 其一","author":"黄遵宪","text":"汉家累叶子孙千，朱果祥占瓜瓞绵。\n十世忽遭阳九厄，再传失纪仲壬年。\n《千秋金舰》惩储贰，九降纶音慎择贤。\n今日小宗承大统，典书岂忘帝尧篇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13524,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"腊月二十四日诏立皇嗣感赋 其二","author":"黄遵宪","text":"先皇遗恨鼎湖弓，世及家传总大公。\n谁误礼经争继统，妄拚尸谏效孤忠。\n弟兄共托施生茑，男子偏迟吉梦熊。\n片纸病中哀痛诏，前星翘首又移宫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13525,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"腊月二十四日诏立皇嗣感赋 其三","author":"黄遵宪","text":"齐东野语仅荒唐，读诏人人泣数行。\n怪事闻呼奈何帝，佹诗敢唱厉怜王。\n袖中禅代谁经见？\n管外窥天妄测量。\n钩尽甘陵南北部，庶人横议亦刊章。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13526,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"腊月二十四日诏立皇嗣感赋 其四","author":"黄遵宪","text":"家居撞坏虑纤儿，天下膏粱百不知。\n朝贵预尊天子父，王骄甘作贼人魁。\n亢龙守蛰存身日，瘈狗相牙掷骨时。\n玉匣缄名黄带盛，承平重忆说雍、熙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13527,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]