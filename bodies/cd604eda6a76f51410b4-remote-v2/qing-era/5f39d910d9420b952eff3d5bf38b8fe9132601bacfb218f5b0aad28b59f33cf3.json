[{"title":"重阳","author":"汪渊","text":"帘卷西风鬓欲霜，消魂时节正重阳。\n愁如绿水吹仍绉，人比黄花瘦亦香。\n五夜悲秋蛩语急，一镫摇梦雨声凉。\n年年携酒登高会，谁寄茱萸作佩囊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25625,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书秦少游遣妾边朝华诗后","author":"汪渊","text":"小红纵幸生前嫁，樊素方深别后愁。\n一样情天恨难补，西风寂寞古藤州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25626,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"武昌怀古 其一","author":"黄瑞莲","text":"大别山头望九嶷，武昌城下柳垂丝。\n因风玉笛来何处，跨鹤仙人去几时。\n狂到祢衡偏爱死，才如崔颢例称诗。\n偶来凭眺添惆怅，独立沧江总系思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25627,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"武昌怀古 其二","author":"黄瑞莲","text":"上游形胜控蛮荆，一线河流接岳衡。\n水上不闻湘女泣，月中犹有夜乌声。\n千秋名士皆尘土，一代兴亡枉战争。\n借问滔滔江汉水，可能淘尽古今情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25628,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"閒吟","author":"黄瑞莲","text":"草色连天没烧痕，数声啼鸟出渔村。\n山容过雨青连岸，柳色笼烟绿到门。\n远水独归彭蠡阔，群峰都让小孤尊。\n江干閒步微吟久，自写新诗侑酒樽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25629,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"石梁","author":"徐步瀛","text":"无计消烦虑，閒行步石梁。\n云端见新月，水际尚斜阳。\n客鬓滋秋色，征衣怯夜凉。\n隔林有归鸟，绕舍自回翔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25630,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜雨","author":"徐步瀛","text":"作客本无梦，况经雨意深。\n空阶一万滴，滴滴是秋心。\n落叶他乡树，孤镫旅夜吟。\n披衣不成寐，夜半起鸣琴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25631,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题赵集贤桃源图","author":"万方煦","text":"桃花开落一千年，落英墨泪红斑斑。\n白雁飞来天地改，人间那复有桃源。\n云树苍苍烟水暮，花开远近渺何处。\n地坼天分了不知，一片赵家乾净土。\n哀哉王孙泣迷途，渊明记载亦模糊，武陵仙境今则无。\n莫谓仙境今世无，青溪红树在此图。\n陇湟兵气秦人吁，傥可往者吾其徂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25632,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄谢枚如潼关","author":"万方煦","text":"才得相逢又别游，雨丝烟柳送春愁。\n侬心不及黄河水，抱定潼关日夜流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25633,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登望河楼","author":"万方煦","text":"楼势凌城郭，清秋发浩歌。\n西风吹太华，斜日渡黄河。\n陕树临关断，秦云入晋多。\n生平怀利济，凭槛向沧波。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25634,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"村居即事","author":"商宝慈","text":"村居风味不嫌贫，白板双扉绝点尘。\n天为洗除华贵气，疏花小石著诗人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25635,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟储光羲田家杂兴次韵","author":"胡睦琴","text":"烟村八九家，结屋十馀亩。\n同井勤春耕，出入恒相友。\n客至当具餐，朋来辄命酒。\n日夕牛羊来，閒散鸡豚走。\n园种青陵瓜，门垂陶潜柳。\n远岫列窗棂，白云生户牖。\n仓庾粟常充，那复虑升斗。\n借问宦游人，曾知此乐否。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25636,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"从柯桥夜归郡城","author":"李麟吉","text":"天影堕湖水，群星拥棹飞。\n夜深船过少，市远柝传稀。\n破浪鸥惊梦，随风萤落衣。\n谁家人不寐，镫火出柴扉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25637,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怀亡友朱次庄杨子訚寄鲍拙中","author":"刘绍宽","text":"少年头角记崚嶒，王后卢前世并称。\n长阪霜蹄千里骏，层霄风翮九秋鹰。\n江湖垂老悲寥落，樽酒平生几友朋。\n岁暮相依吾与汝，苍苍古木附寒藤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25638,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鲸山观瀑","author":"刘绍宽","text":"清晨上鲸山，言访凰仙寺。\n山行未及半，泉声淙然至。\n仰见瀑流悬，十丈乃及地。\n入寺寻水源，岩嵁倚幽邃。\n下注百尺潭，上出层峦翠。\n荡漾忽随风，虬姿生百媚。\n羁勒脱悬崖，决骤如奔骥。\n如组复如琴，孰驭六龙辔。\n雾雨尽濛濛，殷雷魄为悸。\n不谓耳目间，觏此发皇异。\n忆昔乐城游，悬流近城治。\n日夕出衙斋，清游极恣肆。\n选胜到龙湫，空奇绝思议。\n诡谲罗万状，下笔不能记。\n梅雨访深潭，曾亦豪情寄。\n石门扁舟过，登临失交臂。\n平生未始游，庐山空梦寐。\n今兹尘外逢，那复意中事。\n自叹拘墟人，苦为尘俗累。\n咫尺不相知，能无山灵愧。\n书此志吾过，感喟未能置。\n峭壁列森森，待补摩崖字。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25639,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"酬朱味温","author":"刘绍宽","text":"衰年病体今粗健，揽镜深悲发半斑。\n世事惯看易桑海，故人相忆隔云山。\n著书各为风尘误，闭户无多岁月閒。\n何日论文重载酒，徜徉百二十峰间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25640,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"戊午重阳寄鲍中敷","author":"刘绍宽","text":"七度重阳七寄诗，年年撚断几吟髭。\n侧身沧海横流地，极目江山摇落时。\n秋色渐于枫叶觉，霜风欲逼菊花知。\n吾侪抚节原多感，料尔登临无限思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25641,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送族弟鸣冈少尉之瑞昌","author":"蔡燮昌","text":"马脊山何处，苕峣隔万重。\n地偏人鲜到，天远雁难逢。\n春草他年梦，浮云此后踪。\n弟兄有龙骥，所望亢吾宗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25642,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"奉新道中","author":"蔡燮昌","text":"衰草长松一径斜，隔溪云水罨山家。\n西风影里夕阳白，开遍野田荞麦花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25643,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书梦华先生诗集后","author":"陆惟灿","text":"桐城去后无诗史，差喜龚君起故关。\n何意狌鼯喧世日，再闻鸾凤啸云间。\n清微绝俗陶彭泽，哀艳惊人庾子山。\n此事千秋公夺席，咿唔小子愿追攀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25644,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送鹤舲之菉港","author":"褚成烈","text":"客中愁寂寞，大雪送君行。\n去路云山乱，扁舟琴剑轻。\n寒风吹别酒，旧雨感离情。\n惆怅江干望，林烟两岸平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25645,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"上巳日与八兄偕同社诸君集面城园","author":"吴孚恩","text":"池馆何人扫劫灰，春阴又见长莓苔。\n水杨柳绿风初过，山鹧鸪啼雨欲来。\n草色拖蓝迷竹径，花枝缀锦照金杯。\n纵教不是兰亭会，也欲寻诗日往回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25646,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海蛳","author":"吴孚恩","text":"螖䗰搜螺属，??出海涯。\n惟蛳形较瘦，佐馔味殊佳。\n髻细青回黛，纹纤紫旋緺。\n嘘涎差异蛞，负壳略同螷。\n?漯滋生易，零星蠕动皆。\n尾原难自断，头岂忍常埋。\n雨歇齐缘岛，潮平密瓣?。\n掬应来浣女，拾更有邻娃。\n披砾筛鱼箵，淘沙湿凤鞋。\n浮屠层仿佛，湘簟粒分排。\n姜豉祛腥称，椒香点厣谐。\n漉羹微下酒，拨火迅投䕸。\n轑想铜鎗滑，盛先玳碗揩。\n蘸盐疑雪渗，绽縠想风?。\n盎簇江?共，盘堆石?偕。\n来尖初试剪，剜肉欲携钗。\n珠曲针穿蚁，钳交角透蜗。\n澈牙喷玉屑，触趾响瑶阶。\n珍笑蜊充错，羞嗤卵作膎。\n荐新从甓社，唤卖踏花街。\n村酿凭增价，禅镫可破斋。\n肥输三泖鳜，鲜夺五湖鲑。\n击钵催吟兴，分笺惬素怀。\n深惭拈险韵，挦扯扯入诗牌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25647,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春暮忆别","author":"王朝清","text":"鬓丝禅榻事全非，瘦尽深红绿又肥。\n人去新愁随草长，春归残梦和花飞。\n流莺院落东风冷，啼鴂天涯暮雨霏。\n盼望锦鳞消息断，祇将心事托金徽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25648,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋兴","author":"王西溥","text":"蒹葭露白蓼花红，市散溪桥立晚风。\n蝙蝠堕檐疑病鸟，蜘蛛补网待秋虫。\n古人骸骨千年至，造化炉锤万物铜。\n佛笈仙经披览遍，两閒何地著虚空。\n桑下分甘遍子孙，老翁性不耐愁烦。\n高撑瘦骨巡檐鹤，牢锁秋心入笠豚。\n箧笥之中纨扇弃，君亲而外布衣尊。\n遥知边塞风尘静，天马西来贡大宛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25649,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"上黄冈胡稚香先生","author":"朱克柔","text":"冬山奇翠剥不落，再拜今见胡先生。\n天下承平杰士老，鹰雕翻多乡里名。\n兄亡弟废分产渰，八口并合一而三。\n有母有母耄更甘，入门一笑风澈骭。\n万金委托常在腕，袖中萧萧卖田判。\n咸同上下嬉天狼，出没黄麻百战场。\n先生时作绿鬓郎，落日横殳每跳踉。\n欲走从军亲在堂，矧今慈竹严高霜。\n酒酣纵谈胡益阳，中兴大业网挈纲。\n呜呼皇天哀民命，三十鳏鱼自贞劲。\n行年半百未为衰，益阳中丞傥见之。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25650,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"麻城卧疾","author":"朱克柔","text":"一病方知客，思家意陡归。\n昏明每计杪，潦燠自斟衣。\n倚枕梦痕碎，侵人药影肥。\n数行游子泪，未敢寄庭闱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25651,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"辛卯春余与松生于狮麓作别业数椽颜曰宾庐盖取去住无常之意","author":"张陶","text":"同来徐孺子，小憩此宾庐。\n非止避尘市，亦堪供道书。\n云霞随去住，山水任樵渔。\n此外一无有，清风吹太虚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25652,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书怡亭铭拓本后","author":"甘树椿","text":"观音岩畔波初起，银涛直泻天万里。\n怡亭寂寞山月高，空馀断碣沈江底。\n大书深刻永泰年，铭者裴虬笔如椽。\n李莒八分阳冰篆，卿云采绚星珠联。\n吁嗟乎！\n世事白衣幻苍狗，陇西词客今何有。\n武昌江上片石存，遂使姓名长不朽。\n君不见，嘉祐七年上泉书，苔纹剥蠹沦瓦缶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25653,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"马沧湖感旧","author":"甘树椿","text":"白鹤楼前水满陂，沿堤杨柳碧如丝。\n中流笳鼓都销歇，祇有荷花似旧时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25654,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江村晚眺","author":"甘树椿","text":"遥天一色郁青苍，数点寒鸦趁夕阳。\n流水无声莽萧瑟，满林黄叶落秋霜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25655,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宿青山林精舍","author":"胡醇","text":"夕阳暝前山，迢递出深谷。\n引领望青林，纡径凡百曲。\n石尽泉声小，秋高山气肃。\n行行得古寺，历历见乔木。\n月出僧未归，林深鸟先宿。\n山门不见人，凉露下修竹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25656,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨后渡江","author":"胡醇","text":"雨歇风转生，孤舟疾如鹜。\n濛濛烟霭中，望见汉阳树。\n霁景汇中流，人声沸古渡。\n不见晴川楼，疏钟飒何处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25657,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"独夜","author":"胡醇","text":"独宿不成寐，萧萧天北风。\n孤村萤影外，荒岁犬声中。\n笔砚生涯拙，兵戈世路穷。\n镫花破愁绝，一夜伴人红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25658,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登鲍明远读书台怀古","author":"胡醇","text":"木落寒崖鹳雀哀，夕阳愁入鲍家台。\n流空日月堂堂去，拍座烟云故故来。\n骨肉至情工作别，帝王大度不容才。\n古今何限穷途泪，万里江山一酒杯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25659,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"东湖竹枝词 其一","author":"杨毓秀","text":"隔岸西洲画不如，桃花照彻野人居。\n洲边春涨浓于酒，醉煞花魂化作鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25660,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"迟子润不至","author":"杨毓秀","text":"岁除寄我病中书，相约寻春过敝庐。\n迟尔不来春欲暮，可曾病与岁俱除。\n雨寒邃谷莺声寂，花落清江水涨初。\n几日侯芭能载酒，元亭惆怅子云居。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25661,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题吴称三广文石笋山房图","author":"朱应庚","text":"粼粼石笋辟天关，时见空林放白鹇。\n寂寞幽人三亩宅，玲珑晓日一房山。\n披图百里成孤往，为客经年尚未还。\n亦拟入山寻洞壑，秋江风雨暮云间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25662,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望金华山","author":"朱应庚","text":"双龙洞前青斑斓，夜半空林招白鹇。\n赤松一去不复还，涧中怪石横榛菅。\n山云堕地秋如水，落日苍茫几千里。\n浩浩山中高卧人，悠悠道上远游子。\n破衣赤足一顽仙，门前老桧三千年。\n白羊倏忽不知处，菖蒲花发月婵娟。\n荒岩日落秋风早，游情历历东阳道。\n紫芝如掌尚可餐，何用沧波访三岛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25663,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"早秋","author":"傅寿萱","text":"自负元龙气，频登百尺楼。\n万山悬暮雨，一夜报新秋。\n诗思题襟集，归心杜若洲。\n那堪遵渚雁，泛泛逐沙鸥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25664,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟黄鲁直谢黄从善司业寄惠山泉","author":"李光炳","text":"惠山寒泉冰雪俱，故人惠泉兼惠书。\n调水符仿坡公法，不愁鱼目混明珠。\n呼儿烹鼎试云腴，两腋清风生穆如。\n愿携诗筒兼茗碗，一蓑一笠老江湖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25665,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"端午舟中暴雨","author":"曾纪元","text":"风吹十万柳丝摇，断锁蛟龙卷怒涛。\n山色入船人尽绿，水光穿电雨翻瓢。\n浪中豪气随云上，醉后诗魂倩月招。\n此去应连天不远，群仙歌吹正清寥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25666,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过永兴","author":"廖寿清","text":"试凭高阁上，頫看乱溪流。\n日落孤帆接，天空楚岫幽。\n兽形盘石怪，雁影入边愁。\n下界谁吹笛，临风一倚楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25667,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山中杂句","author":"宋士冕","text":"霜痕深染一林殷，岁暮人家各自閒。\n酒盏熏炉收拾了，邻翁约看雪中山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25668,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暮春东郊晚眺","author":"黎宗练","text":"云气空濛落照迟，鸣鸠谷谷雨如丝。\n重来被酒东门路，又是风花扑面时。\n溪山曲曲掩云岩，溪水粼粼落照衔。\n好是湘江船未泊，绿杨影里见风帆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25669,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"曾主政丙戌九月还湘丁亥三月复抵京诗约上巳同游","author":"李光汉","text":"黄华丛里饯行旃，独系燕台思悄然。\n秋月衡云归梦绕，春风沂水故人旋。\n他乡共著游山屐，上巳同乘载酒船。\n身世百年几閒日，莫辞沈醉杏花天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25670,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜宿山响楼","author":"邓方","text":"危楼据绝顶，雨歇烟空濛。\n檐际缩馀溜，林杪悬长虹。\n入门僧罢参，袅袅西堂钟。\n洗药供白佛，㸐蔬饭青童。\n谭久溅花雨，坐深吹竹风。\n时闻百泉响，远出西涧中。\n群喧转成寂，众象皆为空。\n夜明山鸟惊，月挂前溪松。\n澹澹香霭没，微微殿角东。\n孤吟烛隐绿，短睡镫留红。\n愿言谢尘鞅，常此对支公。\n今宵石床梦，梦过东西峰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25671,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨后湖亭待月","author":"邓方","text":"湖光荡片云，上下照空碧。\n澹然清波间，一雨洗秋色。\n空江送残钟，馀霞映石壁。\n亭亭孤月开，天水如不隔。\n丛树忽掩映，烟中鸟语夕。\n招要登古亭，列坐据危石。\n草根滋露光，满林泫深白。\n夜半清籁鸣，境喧意弥寂。\n倚柱思重裘，凭栏岸轻帻。\n梦醒单床寒，微闻松露滴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25672,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"永绥胡十二客九江感寄","author":"邓方","text":"一天凉影雁南还，人在匡庐杳霭间。\n帆外晚云三楚树，马前秋雨六朝山。\n风波远客眠餐损，兵火荒江战守閒。\n近得故乡消息否，下游牙纛海门关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25673,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"荒村","author":"邓方","text":"独树营边芦雁啼，荒村一月水东西。\n云中不见乌冈影，衰柳秋风十里堤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25674,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜过李咏南村居","author":"林毓麟","text":"柴门深掩静无哗，路入丛阴村径斜。\n架拥图书高士业，香分蔬酒故人家。\n檐前蜡炬三更月，水底笙歌两部蛙。\n坐久不知行路倦，挑镫还与话桑麻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25675,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登惠山作 其一","author":"赵崧","text":"双阙暮云间，登临意自閒。\n孤舟晋陵水，落日太湖山。\n泉响磬声答，天空飞鸟还。\n梅花已开遍，煮茗对禅关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25676,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登惠山作 其二","author":"赵崧","text":"九曲亭边水，游鳞荇藻齐。\n品题传陆羽，呜咽出梁溪。\n钟梵云中合，神仙洞府迷。\n游人乐忘返，塔影下山西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25677,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和郑斋同年落叶诗 其一","author":"周绍昌","text":"高柯交戛万年枝，无榭荒凉九曲池。\n满地月痕人去后，一天秋色雁来时。\n辞根蓬转真无奈，候管葭吹会有期。\n惆怅御沟流不尽，题残凤纸费才思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25678,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和郑斋同年落叶诗 其二","author":"周绍昌","text":"构难群阴惨不舒，起元贞下定何如。\n天心晦昧成丰蔀，人意推排到剥庐。\n班马萧萧声始尔，征鸿渺渺目愁余。\n瑶阶鶗鴂鸣何急，可似长杨奏赋初。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25679,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和郑斋同年落叶诗 其三","author":"周绍昌","text":"宝玦珊瑚委路隅，延秋门上白头乌。\n已无刻楮传神削，空有题诗击唾壶。\n宛转尽歌桃李子，飘飖难著凤凰雏。\n归巢倦羽栖初定，币树惊飞历乱呼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25680,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和郑斋同年落叶诗 其四","author":"周绍昌","text":"飘茵堕溷复沾泥，比似寒花命亦齐。\n踪迹偶同风聚散，音声莫辨省东西。\n鸱张远势凌鸦背，狼籍馀痕衬马蹄。\n百六运穷元会改，病株仍望及春荑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25681,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和郑斋同年落叶诗 其五","author":"周绍昌","text":"一角红墙锁绿春，沈沈铃索悄无人。\n良时容易流年换，斜日徘徊顾景频。\n曾逐游丝横碍路，生怜弱草上栖尘。\n恒河沙数量金粟，持向如来问夙因。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25682,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和郑斋同年落叶诗 其六","author":"周绍昌","text":"谈笑麾戈驻夕曛，朱旗猎猎闪重云。\n不知团雪凭谁主，先遣凌霜到此君。\n落实取材供剪刈，析薪佐爨许支分。\n淡浓半抹胭脂色，雕饰全输锦绣纹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25683,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和郑斋同年落叶诗 其七","author":"周绍昌","text":"篆香烟袅鸭炉温，伏枕黄昏深闭门。\n归去王孙应有怨，思来公子又何言。\n差池燕羽空中影，解脱虫丝吐后痕。\n莫读兰成枯树赋，江潭凄怆那堪论。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25684,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和郑斋同年落叶诗 其八","author":"周绍昌","text":"蓬瀛久辍列仙班，时见乌朝数往还。\n销寂潜虬敖嫩水，䙰褷冻雀纥千山。\n流黄度曲填金缕，捣素缄愁寄玉关。\n不是甘泉烽火近，有人心折大刀环。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":25685,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]