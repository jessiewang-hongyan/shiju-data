[{"title":"秋杪归觐建隆本师晤臞庵先生","author":"超普","text":"山空本落雁横天，渡水穿林到法筵。\n废寺清钟风外杳，疏篱丛菊雨中鲜。\n漫将意气夸元度，自有才华并皎然。\n安得寿宁秋色永，时来酬倡月明前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29207,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山居","author":"超睿","text":"五十年来出此山，那知又逐丛风还。\n雷轰电转浑如梦，销尽尘缘顷刻閒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29208,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"迷楼怀古","author":"超凡","text":"君王台榭结层阴，竹树迷离伤客心。\n只有寒鸦啼废冢，绝无萤火照空林。\n二分明月留天地，一派烟波自古今。\n六代繁华空极目，杖藜从此罢登临。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29209,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宿山寺步壁间韵","author":"广彻","text":"独宿云堂一磬深，空山莲漏滴沈沈。\n月临绀殿浮松气，风动金铃落梵音。\n永夜禅镫悬客梦，高秋旅雁动乡心。\n虚窗渐觉晨光满，惆怅行歌别旧林。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29210,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"对月怀陶景成茂才","author":"宗智","text":"夜月澄寒辉，居然入深院。\n修竹相参差，浮云忽隐见。\n十里澹秋烟，匝地开匹练。\n独坐谢纠纷，灵禽下荒甸。\n渺然等予怀，孤飞无眷恋。\n西邻有老人，隐居足欢宴。\n况兼南窗南，明月照渠面。\n放却掌中杯，焚却案头砚。\n安得乘仙槎，共造清虚殿。\n玄关君独窥，词源谁敢擅。\n予性懒是真，行吟颇忘倦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29211,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偕夏靖九过夏元长炼室同次殷雨苍韵","author":"宗智","text":"秋爽借虚度，寻君聊遣閒。\n舌端穷易理，身外得玄关。\n众木脱霜叶，高窗见远山。\n宁随天地老，莫谩说人间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29212,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"除夕同盛子嘉限除字","author":"宗智","text":"风雨催残腊，高眠任岁除。\n寻梅双屐静，留客一樽虚。\n检箧焚诗草，挑镫阅道书。\n飘蓬同十载，赢得鬓毛疏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29213,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"问水庵次锡山华凝修韵","author":"宗智","text":"帆樯指故里，信宿藕花村。\n境静秋先冷，情空花欲言。\n裁诗消野兴，问水得真源。\n明月知人懒，依然下竹轩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29214,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"严勉斯徐楚涛殷雨苍夏靖九周天池见过共用闻字","author":"宗智","text":"嘉客偶相集，秋山满白云。\n弹棋松有韵，论道佛无文。\n机息同鸥侣，身閒与鹿群。\n无端促归棹，疏雨隔溪闻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29215,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怀郑蕃修","author":"宗智","text":"云流三更月，天馀几夕秋。\n呼童煎石髓，放眼上蓬楼。\n况有黄花对，安知白发羞。\n所嗟人异水，不向故园流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29216,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过建隆寺访友","author":"显应","text":"鹿苑凋残久，登临法界宽。\n孤云穿竹细，宿鸟出林寒。\n井废泉何在，花深露未乾。\n断碑横蔓草，剥落有谁看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29217,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和惠山华凝修先生宿问水庵韵 其一","author":"秉正","text":"扣舷歌复罢，散步入效原。\n树暝林疑雨，山空鸟不言。\n几人探竹屋，一水隔桃源。\n归路饶清兴，新蝉在北轩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29218,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和惠山华凝修先生宿问水庵韵 其二","author":"秉正","text":"隔水寻开士，还应鼓枻来。\n那知秋未到，已觉暑全回。\n花竹有馀色，山林良可哀。\n四方兵甲后，吟眺一徘徊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29219,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九日过慧照庵","author":"秉正","text":"精蓝在城市，幽趣入林泉。\n草白知秋晚，苔青是雨前。\n云生窗外树，霞污水中天。\n纵目有如此，还应放钓船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29220,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"看瀑","author":"性本","text":"山桥独立竟忘归，贪看悬厓瀑布飞。\n苍翠重重得刹隐，轻风送出磬声微。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29221,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠别客愚兄","author":"圆显","text":"已驻湖干棹，知君未可留。\n乡心明月夜，归梦白云秋。\n挈钵投江郭，携筇向石头。\n半生行脚惯，不解说离愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29222,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登圌山绝顶","author":"上思","text":"极目微茫接远天，山光水色两悠然。\n风尘不到烟萝里，云月时来梵座前。\n僧影独依幽涧树，钟声疑上夕阳船。\n相看举世同蕉鹿，三叹孤峰仰昔贤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29223,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次牧园潘先生晤阒堂和尚韵","author":"上慧","text":"柴门寥寂甚，徙倚望遥天。\n却喜香山老，论诗妙入禅。\n席移花外月，帘动柳梢烟。\n幸有牛头月，光华得洞然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29224,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"野望","author":"上映","text":"垂脚岭边震泽西，暮烟销尽风凄凄。\n孤村隔水苇花冷，群雁横天落月低。\n客子棹舟黄叶岸，渔师夜宿白蘋溪。\n生涯似我幽居志，瓢笠轻装任所栖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29225,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读黄仙裳秋槎唱和诗","author":"上崇","text":"建功何似建言奇，老将殊勋有了期。\n不及先生拈好韵，乱离直到太平时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29226,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"震居山访姚氏隐居喜晤苍碧陈山人","author":"本照","text":"商阁层轩尽日开，秋风秋雨入帘来。\n仙家自有胡麻饭，公子何须竹叶杯。\n对局无心闻鼓吹，看花随意破莓苔。\n共知良会诚难得，更上吴山第几回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29227,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"涵师峨嵋游归因赠","author":"天定","text":"峨嵋西去似登天，见说亲行到顶边。\n古木千年都化石，衲衣六月总装棉。\n阴风昼洒岩端雪，急雨宵闻洞口泉。\n袖得图归夸示我，芒鞋踏破意忻然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29228,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"铁锁桥","author":"超远","text":"万山谁划断，一水界东西。\n地旷风逾急，天低云易迷。\n半空横铁索，千尺跨虹霓。\n我欲桥边宿，江猿休夜啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29229,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山居秋夕","author":"寂琇","text":"不学骚人意思深，閒情祇许寄知音。\n枕边忽得新奇句，又被秋虫夺去吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29230,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日过一梅亭访乃奇师","author":"处洪","text":"道人庐舍白云封，日日携琴过听松。\n香雪一窝明月夜，吟声遥度九龙峰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29231,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蜀山花神庙","author":"悟开","text":"小小园林倚碧山，万花攒簇翠微间。\n世人只解求神祐，也要花枝耐驻颜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29232,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九月八日送友之越","author":"元奭","text":"江边杨柳正萧条，游子秋深放小舠。\n故国明晨空对菊，他乡何处独题糕。\n寒潮带雨催兰桨，霜叶随风恋布袍。\n此去不须寻往迹，越王宫殿总蓬蒿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29233,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"剑阁","author":"溥畹","text":"险绝惟双剑，迢遥一线通。\n水分巴字峡，山接汉王宫。\n梯石来天上，穿云入地中。\n无知怜李特，漫欲守蚕丛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29234,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋胡行","author":"元龙","text":"养蚕胜养儿，养蚕犹吐丝。\n养儿防亲老，而乃离庭闱。\n君怜采桑妇，不念桑榆人。\n桑榆景苦短，桑妇时悲辛。\n还君相赠金，请君断诸妄。\n君意在桑间，妾情非濮上。\n攀条谢郎君，倚门人久望。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29235,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"乞食","author":"元龙","text":"林间才定起，洗钵出门行。\n童子亦知善，设斋非爱名。\n说经酬饭价，回施合凡情。\n果腹便归去，寒山万木平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29236,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杂韵","author":"大宁","text":"峰顶屋三间，松边石一片。\n早晚云飞来，只有樵夫见。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29237,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柏堂对月和周升逸","author":"岑霁","text":"柏堂今夜月，云物不能侵。\n对此碧空净，闻君《白雪》吟。\n入帘明鹤发，绕树见禽心。\n坐觉清言久，疏钟报隔林。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29238,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自龙泉关过岭宿白云寺","author":"岑霁","text":"万丈雄关到始谙，空中斗插五浮岚。\n白云僧下山头寺，黑雨龙飞石上潭。\n冰雪百层寒代北，波光一线认江南。\n闲身随处堪投宿，直上诸天是蔚蓝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29239,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"露筋祠","author":"岑霁","text":"沙草凄迷烟树昏，荒祠寂寞托贞魂。\n灵旗高卷秋风晚，惟有清淮照墓门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29240,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蘋花","author":"岑霁","text":"翠叶金花杂杜蘅，湘湖千里最知名。\n秋风飒飒过南浦，乡思无端一夕生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29241,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"孤花","author":"德亮","text":"一点出尘绿，春情仍自深。\n香微怜土薄，开晚少人寻。\n雨渍犹堪赏，风吹略不禁。\n翛然苔石畔，谁为表孤心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29242,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题方坦庵太史?山语石","author":"智豁","text":"撑云吸露貌奇峰，声借流泉色借松。\n昔日点头今日语，生公应让海门龙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29243,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"归后","author":"智潮","text":"拂袖青山后，锄茅绿水前。\n草深三月雨，柳暗一溪烟。\n形迹从今世，情怀只昔年。\n故人心不负，期泛五湖船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29244,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闻思庵纪事呈莲社诸君","author":"一斑","text":"雨港烟村容散人，菱池蔬圃少风尘。\n过桥一径见城郭，沿水数家成比邻。\n性懒便教栖易稳，慎真反讶句难新。\n破除陈迹君知否，影动碧潭杨柳春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29245,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"名山纪游","author":"昭吉","text":"杖锡清凉道，五峰净如沐。\n飞翠入青霄，云霞起平陆。\n地菜产灵岩，天花满空谷。\n伊彼长松子，纷纷落山曲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29246,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江上送客","author":"野楫","text":"隐隐孤城暮，茫茫寒角闻。\n异乡重见面，落日又离群。\n是我还家路，如何复送君。\n斯须帆影没，祇见隔江云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29247,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"建隆寺题壁","author":"佛旸","text":"建隆何代寺，彰武旧招提。\n一径秦松里，孤云蜀岭西。\n台荒花落去，客至鸟空啼。\n落日江峰远，微吟过小溪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29248,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宿陈氏庄园","author":"佛旸","text":"去郭息尘事，支筇原上村。\n言寻太丘长，得过辟疆园。\n竹影半塘水，秋声午夜猿。\n凌朝登小阁，山色在前轩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29249,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"月夜过雷塘道中","author":"佛旸","text":"谁唱吴歌古渡头，一声清怨过迷楼。\n凄凉满地芦花月，撩乱连天鸿雁秋。\n寒树著霜犹是绮，废塘埋玉尚名钩。\n道人不为繁华感，午夜行吟别有愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29250,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"两鹤","author":"妙复","text":"昔年两白鹤，巢我青松林。\n夜寒时警露，众壑流清音。\n一鹤恋故栖，孑焉守云岑。\n一鹤忽遐举，天路探幽深。\n神山境恍惚，浩浩谁能寻。\n惊飙吹未息，素羽愁难任。\n故林遥待汝，贞此岩阿心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29251,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"落梅","author":"律然","text":"和风和雨点苔纹，漠漠残香静里闻。\n林下积来全似雪，岭头飞去半为云。\n不须横管吹江郭，最惜空枝冷夕曛。\n回首孤山山下路，霜禽粉蝶任纷纷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29252,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"悼鹤次蒋迪甫太史韵","author":"律然","text":"病久胎禽剩瘦形，朝来羽化竟冥冥。\n孤情望断林间影，秃笔书残石上铭。\n苔径忽空新印迹，松巢忍见旧遗翎。\n高人从此添离索，哀怨还如失一丁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29253,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"口占与西涧佥宪","author":"律然","text":"汀南庵北往来频，臭味何如支许亲。\n相对莫教分主客，何人不是客中身。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29254,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日游邓尉山","author":"炳宗","text":"万峰深处有流泉，松径藤萝杖策穿。\n十里梅开香到寺，洞庭犹隔太湖烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29255,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"留别","author":"梵音","text":"一一横担任所之，秋风秋雨是行期。\n去时莫定来时约，山水留人未可知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29256,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"五老峰坐夏","author":"戒显","text":"五峰绝顶缚枯禅，静夏何人叩榻前。\n忽地雾来山尽缟，半空泉落屋如船。\n朱曦气散松杉国，白日寒生洞壑天。\n缥缈万层尘望断，那知僧定万松颠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29257,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"金陵怀古","author":"戒显","text":"石头城下水淙淙，西望江关合抱龙。\n六代萧条黄叶寺，五更风雨白云钟。\n凤凰已去台边树，燕子仍飞矶上峰。\n抔土当年谁敢盗，一朝伐尽孝陵松。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29258,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登清凉台","author":"印耀","text":"不尽登临兴，登临欲二更。\n塔镫红到寺，江月白连城。\n我独邀幽赏，人多限俗情。\n迟迟未忍下，数遍夜钟声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29259,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九日酬诸子","author":"妙信","text":"不负东篱约，携尊过草堂。\n远天连树杪，高月薄衣裳。\n握手经年别，惊心九日霜。\n诸君才绝世，独步许谁强。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29260,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨窗","author":"妙信","text":"云暝虚窗静，新篁别有情。\n烟云清古壁，风雨壮江声。\n有癖酬山水，偷闲断送迎。\n萧疏且高卧，无意问阴晴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29261,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寒食雨窗偶书","author":"广閒","text":"去冬犹作省亲诗，讵料今朝只有儿。\n记得桑条如此绿，年年阿母浴蚕时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29262,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登穿山","author":"方璿","text":"颓然石磴草萋萋，客里重登旧迹迷。\n海气暗吞山顶寺，钟声高落洞门溪。\n秋来有月台堪倚，春到无花鸟自啼。\n欲谒桑公不可见，苍苔断碣暮云低。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29263,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清明后一日诸友社集","author":"明际","text":"一径寒烟锁，幽人曳杖寻。\n临流开白社，听雨坐香林。\n共惜残花落，独怜芳草深。\n故山归未得，虚负白云心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29264,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄高澹游","author":"元祚","text":"卖尽青山说买山，高年正好学偷闲。\n洞庭尽有梅花屋，何不携家住此间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29265,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜看云见访","author":"达瑛","text":"渺渺秋江阔，劳君破浪寻。\n双峰今夜月，一片故人心。\n云淡天河迥，窗虚海气深。\n只缘明欲别，剪烛动长吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29266,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"同王梦楼太守高旻寺看菊","author":"达瑛","text":"何必东篱采，山房菊已开。\n无端诗思发，有约故人来。\n冷艳依黄叶，幽香上绿苔。\n白头怜晚节，勤护晓霜催。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29267,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次安心见寄韵","author":"达瑛","text":"托足双峰猿鹤亲，水晶宫殿净无尘。\n日将好景归诗卷，天许名山作散人。\n岩草碧销三径雪，寺梅香破半江春。\n西风记得萸湾别，夜夜相思入梦频。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29268,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登海云楼怀萸湾清凉主人","author":"达瑛","text":"退院僧同岭上云，凌江小阁一炉薰。\n窥人鸥鹭当窗立，出寺钟鱼隔水闻。\n仍有青山常我伴，纵无明月也思君。\n临风欲跨扬州鹤，海气微茫望不分。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29269,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次古岩见过河亭韵并寄借庵","author":"达瑛","text":"小院临池无路通，道心常与竹心空。\n幽扉半掩林间雨，清磬遥传渡口风。\n折苇客来青嶂外，隔江人卧白云中。\n莫言世外甘岑寂，杀贼论兵烛影红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29270,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"同洪稚存太史王柳村秀才暨令嗣小村借庵主人登月波台看潮同赋","author":"达瑛","text":"为逐丹崖客，层台试一登。\n山随诗思转，风挟海潮腾。\n树抱花閒路，门开竹里镫。\n笑余多懒散，米熟愧南能。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29271,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"新柳","author":"达瑛","text":"东风青旆亭中酒，小雨红阑桥外人。\n无限销魂看不得，鹅儿黄样可怜春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29272,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梅山","author":"与宏","text":"汉吏逃名姓，而今地尚传。\n泉疑流夜雨，山欲锁春烟。\n脱屐离尘网，裁云补水田。\n老僧消受得，梅子熟多年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29273,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次洪稚存太史见赠韵","author":"与宏","text":"八千里外归来客，不为探奇也打门。\n愿见已经过半世，相逢何幸在荒村。\n只身湖海飘零久，百卷文章慷慨存。\n煨芋分尝坚后约，更须米汁沃灵根。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":29274,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]