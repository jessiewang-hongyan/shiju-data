[{"title":"女冠子 其六","author":"毛奇龄","text":"碧箫初弄。\n暗想秦楼双凤。\n几多情。\n玉锲分芦节，金箱贮枣饧。\n蕉花含秘阁，松影落层城。\n谁捣玄霜尽，见云英。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37044,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"女冠子 其七","author":"毛奇龄","text":"短花长叶。\n到处翠軿相接。\n洞中春。\n衣炷熬丹锡，唇脂瀹水银。\n盘囊闲系虎，麈尾笑遗人。\n总隔蓬莱路，也生尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37045,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"女冠子 其八","author":"毛奇龄","text":"金巾姣好。\n长佩玉砂瑶草。\n受清虚。\n妆镜歼山鬼，香奁检道书。\n缃眉遮羽盖。\n素手涤仙厨。\n每当三五夜，望蟾蜍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37046,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"女冠子 其九","author":"毛奇龄","text":"赤城紫府。\n闲贮玄珑妃女。\n小仙才。\n节拥蓝丝葆，冠抽绿玉钗。\n蜂房融日粉，蝶梦绕天涯。\n何事刘郎去，不归来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37047,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山花子 其一","author":"毛奇龄","text":"蝉翅宫绡傅体寒。\n琵琶掩面夜歌阑。\n插得钿头新拨子，是红蛮。\n隔舍紫姑星会浅。\n开门乌桕雨啼残。\n曾卜金钱今始验，拆和单。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37048,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山花子 其二","author":"毛奇龄","text":"小院风摇九子铃。\n临河长对牸牛星。\n欲上玉机愁杼短，织难成。\n掷缕烛翻娇凤出，萦丝泪尽湿花生。\n谁道锦文无样子，看回程。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37049,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春晓曲 回文","author":"毛奇龄","text":"小屏山上西江曲。\n深处落梅寒簌簌。\n晓鉴菱开赭粉红，残灯穗卷香脂绿。\n草头阶刬袜钗金，花里碧钩幡胜玉。\n绕凤双簧蜡炙新，早春惊破霜溪竹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37050,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"木兰花令 回前","author":"毛奇龄","text":"竹溪霜破惊春早。\n新炙蜡簧双凤绕。\n玉胜幡钩壁里花，金钗袜刬阶头草。\n绿脂香卷穗灯残，红粉赭开菱鉴晓。\n簌簌寒梅落处深，曲江西上山屏小。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37051,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其一","author":"毛奇龄","text":"含桃着雨花如雪。\n井边吹落春云叶。\n鹦鹉结钗楼，新娘半上头。\n裁衣翻样子。\n压线盘金篚。\n十五小裙腰。\n能留线几条。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37052,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其二","author":"毛奇龄","text":"山鸡栖罢乌啼树。\n迎人烧尽柑红炬。\n复钥下铜鱼。\n车前一幰除。\n褥花尝对缝。\n羞见双鸳控。\n渐减玉炉烟。\n人眠故未眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37053,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其三","author":"毛奇龄","text":"宜城二月莺啼早。\n罗敷十五双鬟小。\n锦带约桑钩。\n使君南陌头。\n连钱嘶日暮。\n共返宜城渡。\n莫是看罗敷。\n罗敷自有夫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37054,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其四","author":"毛奇龄","text":"轻雷鹿鹿宫车转。\n晚凉偷弄邠王管。\n双甲小蠀蛦。\n黄鹂处处啼。\n春风吹欲遍。\n尽作西清怨。\n暗里换歌头。\n伊州似石州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37055,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其五","author":"毛奇龄","text":"一株柳树千条叶。\n桃根巧向梅根接。\n花坞暗相通。\n新花隔几重。\n宝函春信杳。\n水漫红鱼小。\n半格轴头丝。\n环环无尽时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37056,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其六","author":"毛奇龄","text":"日黄不上妆山面，露圆难缀珠帘线。\n种得郁金花，将来浸木瓜。\n枕屏山六扇，上有江南岸。\n岸尽是吴关，关前人未还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37057,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"河渎神 其一","author":"毛奇龄","text":"楚雨歇残阳。\n满庭新月潇湘。\n松花湿影坠山黄。\n帝女花竿庙旁。\n瑶瑟洞箫来极浦，风吹桂酒椒浆。\n夜半烟寒翠敛，几人能上高唐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37058,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"河渎神 其二","author":"毛奇龄","text":"丹殿俯嵯峨。\n洞庭秋水湘娥。\n深房鬼火暗青萝。\n呜咽神弦自歌。\n文木漆光丝缠腹，蕉花影里婆娑。\n只为相思美子，灯前一敛双蛾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37059,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏子 其一","author":"毛奇龄","text":"枣屏深，桦烛冷。\n复壁照人双影。\n鱼坠管，兽衔环。\n一床衾枕单。\n更漏咽。\n楼头月。\n偏射小窗明蛤。\n红幕掩，鹊桥低。\n银河又向西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37060,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏子 其二","author":"毛奇龄","text":"小檀槽，新捍拨。\n弹就夜堂秋月。\n银箭断，玉钗凉。\n烛槃红泪长。\n寒角动。\n霜风送。\n惊起金微残梦。\n关戍柝，女郎砧。\n城南秋渐深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37061,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏子 其三","author":"毛奇龄","text":"幔钩绳，复斗穗。\n寒夜美人半睡。\n云掩絮，月胧明。\n枕函亭钏声。\n蚕烛耀。\n飞蛾绕。\n门外乌啼难晓。\n燔蕙烬，隐纱笼。\n罘罳划碎红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37062,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏子 其四","author":"毛奇龄","text":"剪鲛丝，量兽锦。\n宽窄灯前自审。\n钿尺短，错刀残。\n晚来多少寒。\n园雾薄。\n林花落。\n水面星摇池阁。\n山犬吠，草虫鸣。\n曲房魂暗惊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37063,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"更漏子 其五","author":"毛奇龄","text":"井梧阴，庭树暝。\n寂寂画栏人静。\n蜡子焰，蟹衣筐。\n邻家夜绩凉。\n芭蕉露。\n零如雨。\n记得暗中欢去。\n宵漏尽，晓钟催。\n碧窗殊未来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37064,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"木兰花令","author":"毛奇龄","text":"晓莺娓娓流妆阁。\n日上烛吹红绣幕。\n束将方带玉芙蕖，裹就半韝银芍药。\n寻花露冷胭脂薄。\n花底暗翻钗子落。\n谁开鸳锦抱轻云，误使丁娘枕前索。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37065,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小重山 其一","author":"毛奇龄","text":"春殿香销锁碧空。\n夜凉宫漏悄、咽铜龙。\n银河泻地水漴漴。\n妆初洗，残粉腻沟红。\n双凤宿梧桐。\n小桃金井上、露华浓。\n长门枉自闭重重。\n珠闼迥，时拂玉阶虫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37066,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小重山 其二","author":"毛奇龄","text":"芳草茸茸翠辇迟。\n昭阳初日影、散彤墀。\n银幡綵胜戴双纚。\n金错小，剪出万年枝。\n御苑落花时。\n祠前祈百子、汉家池。\n承恩唯有臂红知。\n中宵梦，频起视胭脂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37067,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小重山 其三","author":"毛奇龄","text":"黄帕衔鳌结象床。\n捲衣长拂面、侍君王。\n衫襟深惹御篝香。\n绡幛影，隐隐见鸳鸯。\n别院罢霓裳。\n众中新赐着、殿头黄。\n年来独系绛纱囊。\n江南路，四十杜秋娘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37068,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小重山 其四","author":"毛奇龄","text":"鳷鹊高翾负日温。\n春冰融太液、细流浑。\n懒调黄子渍香荪。\n羊车近，竹叶满金盆。\n十载见承恩。\n踏青随例出、望春门。\n却收银钥暗销魂。\n梨花落，深殿又黄昏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37069,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜迁莺 其一","author":"毛奇龄","text":"榆叶里，楝花前。\n烧尽白矾烟。\n娇龙自走不须鞭。\n最喜是莺迁。\n歌羽歌，舞羽舞。\n人在掌中飞去。\n雾丝裙子本蹁跹。\n何处更留仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37070,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜迁莺 其二","author":"毛奇龄","text":"杏苑北，曲江西。\n残雪尚依依。\n轻轮辗絮着人衣。\n拊马夜归迟。\n蓬宴遥，莲漏浅。\n红烛万条深院。\n晓来唯听乳莺啼。\n移上绿杨枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37071,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临江仙 其一","author":"毛奇龄","text":"澧浦红兰开日暮，美人倚徙空亭。\n幽岩春竹雨冥冥。\n长思公子，愁绝翠云屏。\n碧水尚传瑶瑟怨，枨枨夜鼓湘灵。\n苍梧南去晚山青。\n楚江迁客，憔悴不堪听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37072,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临江仙 其二","author":"毛奇龄","text":"秋藕丝裙春树面，龙安寺里为家。\n时来空馆倚栏斜。\n栏前新水，日日浸桃花。\n素手自撩金索动，腕绳轻约红纱。\n东风相见各天涯。\n道傍愁思，散作日边霞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37073,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临江仙 其三","author":"毛奇龄","text":"高阁近花红影合，绕床还种青梧。\n西施娇小似无夫。\n黄金梯滑，不见有人扶。\n茭叶菱根遮浦暗，含情但采菖蒲。\n金阊门外夜啼乌。\n女坟前去，寒烛照东湖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37074,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临江仙 其四","author":"毛奇龄","text":"晚渡潮生野火静，丛祠深对江波。\n垂鬟接黛一青娥。\n宝冠珠络，花帔贴银鹅。\n估客往来争祷赛，隔船吹凤鸣鼍。\n山低如带水如罗。\n螭头黄绢，隐隐画双螺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37075,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临江仙 其五","author":"毛奇龄","text":"睡架荼蘼红刺软，雾中桄蔽轻纨。\n几番觅钏坐花间。\n香山未暖，石炭捣烟寒。\n薄絮装衣萦背胛，空悬辟冻金环。\n武溪雪净尚征蛮。\n杜鹃声杳，莫是未教还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37076,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双带子 其一","author":"毛奇龄","text":"红藕香销暑殿凉。\n玉梭横枕堕钗长。\n东楼赋得新来怨，中夜看沉龟甲黄。\n黄甲龟沉看夜中。\n怨来新得赋楼东。\n长钗堕枕横梭玉，凉殿暑销香藕红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37077,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双带子 其二","author":"毛奇龄","text":"君在教头歌昔昔，妓看垂手落掺掺。\n裙裥半将遮屐点，柘竿长是拄腰纤。\n纤腰拄是长竿柘，点屐遮将半涧裙。\n掺掺落手垂看妓，昔昔歌头教在君。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37078,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双带子 其三","author":"毛奇龄","text":"楼高是处尽乌啼。\n柳外烟同翠眼迷。\n流水落花春寂寂，浮家一槛近前溪。\n溪前近槛一家浮。\n寂寂春花落水流。\n迷眼翠同烟外柳，啼乌尽处是高楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37079,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双带子 其四","author":"毛奇龄","text":"春缸玉酒细鳞红。\n怨鸟啼花隔数重。\n银子蒜垂帘押静，新开背面两鸾栊。\n栊鸾两面背开新。\n静押帘垂蒜子银。\n重数隔花啼鸟怨，红鳞细酒玉缸春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37080,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双带子 其五","author":"毛奇龄","text":"谁向妆亭亭后别，望中烟雨带帆开。\n丝回漫水蓝如袄，黛绕横山青似媒。\n媒似青山横绕黛，袄如蓝水漫回丝。\n开帆带雨烟中望，别后亭亭妆向谁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37081,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双带子 其六","author":"毛奇龄","text":"红荷短间白荷长。\n细细风来细细香。\n浓露滑篙联艇侧，同来到处问家乡。\n乡家问处到来同。\n侧艇联篙滑露浓。\n香细细来风细细，长荷白间短荷红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37082,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双带子 其七","author":"毛奇龄","text":"寒雨江汀隔断桥。\n去时当似不来潮。\n兰浦忆人愁渺目，漫漫夜梦合花梢。\n梢花合梦夜漫漫。\n目渺愁人忆浦兰。\n潮来不似当时去，桥断隔汀江雨寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37083,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"双带子 其八","author":"毛奇龄","text":"鸠浮白水踏歌虚。\n鬓捋虫珠雀画裙。\n楼上捲裳龙女侍，沟前御宿卸妆初。\n初妆卸宿御前沟。\n侍女龙裳捲上楼。\n裾画雀珠虫捋鬓，虚歌踏水白浮鸠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37084,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"甘州遍 其一","author":"毛奇龄","text":"青槐路，迤逦返长杨。\n暮云翔。\n银鱼立胛，金鹅仗带，曾骑黄马射黄羊。\n歌肆侧，酒垆旁。\n调鹰牵犬归去，愁杀羽林郎。\n花刬帽，往往赌毬场。\n暗风扬。\n薰衣透缕，隔巷细生香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37085,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"甘州遍 其二","author":"毛奇龄","text":"金槌去，长策枣红骝。\n五陵游。\n纯钩蒯绕，缦胡缨曲，冰梢猎猎似星流。\n兄执戟，弟长秋。\n射飞逐没尝见，便殿赐衣裘。\n年正少，花发醉娼楼。\n锦缠头。\n几行歌舞，一曲遍甘州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37086,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"甘州遍 其三","author":"毛奇龄","text":"甘州遍，羌笛又将残。\n听声寒。\n黄花碎叶，雕戈铁马，茫茫飞雪满燕山。\n边角静，戍衣单。\n红闺万里梦断，都护请生还。\n雁帛远，风急堕旌竿。\n望长安。\n甘泉铙吹，何日达萧关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37087,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"甘州遍 其四","author":"毛奇龄","text":"秋风起，展转事长征。\n出边城。\n弯弧鹊角，佩刀犀首，趫趫斥突愿擒生。\n收敕勒，捲镵枪。\n夜凉频击刁斗，空碛答遥声。\n转战苦，车骑未成名。\n塞魂惊。\n琵琶孤冢，春草日青青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37088,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"十六字令","author":"毛奇龄","text":"花下影，跟人上玉墀。\n谁推倒，横着半毡儿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37089,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"捣练子 其一","author":"毛奇龄","text":"青草软，绿波长。\n日暮乡关思渺茫。\n吴苑隋堤何处是，满江垂柳又垂杨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37090,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"捣练子 其二 泊山塘作","author":"毛奇龄","text":"云淡淡，雨丝丝。\n旧日真娘何处祠。\n横笛短箫声渐远，藕花塘子夜来时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37091,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梦江南 其一 当缓缓归曲","author":"毛奇龄","text":"临安去，陌上已开花。\n扇影似翻江上羽，车帘刚拂草头沙。\n缓缓好归家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37092,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梦江南 其二 当缓缓归曲","author":"毛奇龄","text":"临安去，陌上已开花。\n绕路烟丝笼暖去，清江日影带潮回。\n缓缓好归来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37093,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"法驾导引 送一苓和尚还罗浮","author":"毛奇龄","text":"江帆暮，江帆暮。\n六月水西头。\n竹子牵来黄蛤履，荷花泛去白螺舟。\n送汝返罗浮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37094,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆王孙 其一","author":"毛奇龄","text":"东风吹柳覆金堤。\n夹岸红楼望去迷。\n日映游丝捲幔低。\n画桥西。\n一树娇花鸟自啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37095,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆王孙 其二 游西施山","author":"毛奇龄","text":"西施歌馆旧城东。\n画栋朱栏映碧空。\n花絮阴阴趁晚风。\n翠重重。\n石上胭脂堕雨红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37096,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一剪梅 其一 剪半","author":"毛奇龄","text":"光宅坊前十字街。\n桃子花开。\n杏子花开。\n钿头栎子有人猜。\n恐是铜钗。\n不是金钗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37097,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一剪梅 其二 剪半","author":"毛奇龄","text":"缚竹纤纤似女腰。\n欲上溪桥。\n怕上溪桥。\n黑云遮住北山坳。\n昨日风潮。\n今日风潮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37098,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"一剪梅 其三 剪半","author":"毛奇龄","text":"木槲花间乳鹊栖。\n鹊也能飞。\n花也能飞。\n临行空记草花期。\n二月当归。\n三月当归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37099,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长相思 其一 泛舟西江即事","author":"毛奇龄","text":"一桥低。\n两桥低。\n枣树湾头西复西。\n江深雨欲迷。\n早乌啼。\n晚乌啼。\n两桨归来乌未栖。\n相逢半路溪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37100,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长相思 其二 泛舟西江即事","author":"毛奇龄","text":"双头钗。\n独头钗。\n一样金鹅两样排。\n钗梁起四台。\n乌帽来。\n白帽来。\n湖就矶头望几回。\n菖蒲花未开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37101,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇 其一 送春","author":"毛奇龄","text":"恼杀啼鹃，逢人还道春归去。\n留人不住。\n谁要留春住。\n花絮茫茫，万点愁人绪。\n归何处，春归无路。\n莫是人归路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37102,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇 其二 姜亦舆汝长庚庚邀听琵琶","author":"毛奇龄","text":"抱出檀槽，金丝拨子轻轻落。\n浅围罗幕。\n月上栏杆角。\n夜半嘈嘈，繁手惊相错。\n敲银索。\n梦回妆阁。\n花底飞乌鹊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37103,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇 其三 采莲曲","author":"毛奇龄","text":"南浦风微，画桡已到深深处。\n藕花遮不住。\n不许穿花去。\n隔藕丛丛，似有人言语。\n难寻溯。\n乱红无主。\n一望斜阳暮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37104,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"相见欢 其一","author":"毛奇龄","text":"倚床还绣芙蓉。\n对花丛。\n牵得丝丝柳线翠烟笼。\n愁思远，抛金剪。\n唾残绒。\n羞煞鸳鸯衔去一丝红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37105,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"相见欢 其二","author":"毛奇龄","text":"花前顾影粼粼。\n水中人。\n水面残花片片绕人身。\n私自整。\n红斜领。\n茜儿巾。\n却讶领间巾里刺花新。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37106,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"相见欢 其三 怀人","author":"毛奇龄","text":"秋风袅袅登台。\n强徘徊。\n两两鸳鸯飞去几时回。\n钱塘路。\n西陵渡。\n总天涯。\n不是早潮又是晚潮来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37107,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"霜天晓角 其一 同丁大声、史宪臣、徐徽之、蔡大敬、来成夫登望京门楼","author":"毛奇龄","text":"平沙十里。\n滚滚江潮水。\n横下秋鹰如削，短草岸，朔风起。\n栏杆人共倚。\n旧关何处是。\n记得西施，去路残阳外，碧烟里。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37108,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"霜天晓角 其二 晓起","author":"毛奇龄","text":"柳烟如织。\n病起逢寒食。\n昨夜东风吹紧，花梢上，雨来急。\n晓开铜镜立。\n镜光涵晓色。\n惊见浓云堆下，梨花月，一轮白。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37109,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]