[{"title":"己亥杂诗 其二一七","author":"龚自珍","text":"回肠荡气感精灵，座客苍凉半酒醒。\n自别吴郎高咏减，珊瑚击碎有谁听？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1986,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二一八","author":"龚自珍","text":"随身百轴字平安，身世无如屠钓宽。\n耻学赵家臣宰例，归来香火乞祠官。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1987,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二一九","author":"龚自珍","text":"何肉周妻业并深，台宗古辙幸窥寻。\n偷闲颇异凡夫法，流水池塘一观心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1988,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二二一","author":"龚自珍","text":"西墙枯树态纵横，奇古全凭一臂撑。\n烈士暮年宜学道，江关词赋笑兰成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1989,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二二二","author":"龚自珍","text":"秋光明媚似春光，重九尊前草树香。\n可记前年宝藏寺，西山暮雨怨吴郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1990,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二二四","author":"龚自珍","text":"莱菔生儿荠有孙，离批秋霰委黄昏。\n青松心事成无赖，只阅前山野烧痕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1991,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二二五","author":"龚自珍","text":"银烛秋堂独听心，隔帘谁报雨沉沉？\n明朝不许沿溪赏，已没溪桥一尺深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1992,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二二七","author":"龚自珍","text":"剩水残山意度深，平生几緉屐难寻。\n栽花郑重看花约，此是刘郎迟暮心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1993,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二二八","author":"龚自珍","text":"复墅拓墅祈墅了，吾将北矣乃图南。\n无妻怕学林逋独，有子肯为王霸惭？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1994,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二二九","author":"龚自珍","text":"从今誓学六朝书，不肄山阴肄隐居。\n万古焦山一痕石，飞升有数此权舆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1995,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二三○","author":"龚自珍","text":"二王只合为奴仆，何况唐碑八百通。\n欲与此铭分浩逸，北朝差许郑文公。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1996,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二三一","author":"龚自珍","text":"九流触手意纵横，极动当筵炳烛情。\n若使鲁戈真在手，斜阳只乞照书城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1997,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二三二","author":"龚自珍","text":"诗谶吾生信有之，预怜夜雨闭门时。\n三更忽轸哀鸿思，九月无襦淮水湄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1998,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二三三","author":"龚自珍","text":"燕兰识字尚聪明，难遣当筵迟暮情。\n且莫空山听雨去，有人花底祝长生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1999,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二三四","author":"龚自珍","text":"连宵灯火宴秋堂，绝色秋花各断肠。\n又被北山猿鹤笑，五更浓挂一帆霜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2000,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二三五","author":"龚自珍","text":"美人信有错刀投，不负张衡咏四愁。\n爇罢心香屡回顾，古时明月照杭州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2001,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二三六","author":"龚自珍","text":"阻风无酒倍消魂，况是残秋岸柳髡。\n赖有阿咸情话好，一帆冷雨过娄门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2002,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二三八","author":"龚自珍","text":"拟策孤筇避冶游，上方一塔俯清秋。\n太湖夜照山灵影，顽福甘心让虎丘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2003,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二四○","author":"龚自珍","text":"濯罢鲛绡镜槛凉，无端重试午时妆。\n新诗急记销魂事，分与胭脂一掬汤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2004,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二四一","author":"龚自珍","text":"少年尊隐有高文，猿鹤真堪张一军。\n难向史家搜比例，商量出处到红裙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2005,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二四三","author":"龚自珍","text":"怕听花间惜别词，伪留片语定来期。\n秦邮驿近江潮远，是剔银灯诅我时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2006,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二四四","author":"龚自珍","text":"停帆预卜酒杯深，十日无须逆旅金。\n莫怨津梁为客久，天涯有弟话秋心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2007,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二四五","author":"龚自珍","text":"豆蔻芳温启瓠犀，伤心前度语重提。\n牡丹绝色三春暖，岂是梅花处士妻？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2008,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二四六","author":"龚自珍","text":"对人才调若飞仙，词令聪华四座传。\n撑住东南金粉气，未须料理五湖船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2009,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二四七","author":"龚自珍","text":"鹤背天风堕片言，能苏万古落花魂。\n征衫不渍寻常泪，此是平生未报恩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2010,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二四九","author":"龚自珍","text":"何须宴罢始留髡，绛蜡床前款一尊。\n姊妹隔花催送客，尚拈罗带不开门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2011,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二五○","author":"龚自珍","text":"去时栀子压犀簪，次第寒花掐到今。\n谁分江湖摇落后，小屏红烛话冬心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2012,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二五一","author":"龚自珍","text":"盘堆霜实擘庭榴，红似相思绿似愁。\n今夕灵飞何甲子？\n上清斋设记心头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2013,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二五二","author":"龚自珍","text":"风云才略已消磨，甘隶妆台伺眼波。\n为恐刘郎英气尽，卷帘梳洗望黄河。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2014,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二五三","author":"龚自珍","text":"玉树坚牢不病身，耻为娇喘与轻颦。\n天花岂用铃幡护，活色生香五百春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2015,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二五四","author":"龚自珍","text":"眉痕英绝语谡谡，指挥小婢带韬略。\n幸汝生逢清晏时，不然剑底桃花落。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2016,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二五五","author":"龚自珍","text":"凤泊鸾飘别有愁，三生花草梦苏州。\n儿家门巷斜阳改，输与船娘住虎丘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2017,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二五六","author":"龚自珍","text":"一自天钟第一流，年来花草冷苏州。\n儿家心绪无人见，他日埋香要虎丘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2018,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二五七","author":"龚自珍","text":"难凭肉眼识天人，恐是优昙偶现身。\n故遣相逢当五浊，不然谁信上仙沦？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2019,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二五九","author":"龚自珍","text":"酾江作醅亦不醉，倾河解渴亦不醒。\n我侬醉醒自有例，肯向渠侬侧耳听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2020,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二六○","author":"龚自珍","text":"收拾风花倜荡诗，凌晨端坐一凝思。\n勉求玉体长生诀，留报金闺国士知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2021,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二六一","author":"龚自珍","text":"绝色呼他心未安，品题天女本来难。\n梅魂菊影商量遍，忍作人间花草看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2022,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二六二","author":"龚自珍","text":"臣朔家原有细君，司香燕姞略知文。\n无须问我山中事，肯向花间领右君？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2023,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二六三","author":"龚自珍","text":"道蕴谈锋不落诠，耳根何福受清圆？\n自知语乏烟霞气，枉负才名三十年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2024,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二六四","author":"龚自珍","text":"喜汝文无一笔平，坠侬五里雾中行。\n悲欢离合本如此，错怨蛾眉解用兵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2025,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二六五","author":"龚自珍","text":"美人才地太玲珑，我亦阴符满腹中。\n今日帘旌秋缥缈，长天飞去一秋鸿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2026,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二六六","author":"龚自珍","text":"青鸟衔来双鲤鱼，自缄红泪请回车。\n六朝文体闲徵遍，那有萧娘谢罪书？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2027,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二六七","author":"龚自珍","text":"电笑何妨再一回，忽逢玉女谏书来。\n东王万八千骁尽，为报投壶乏箭才。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2028,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二七○","author":"龚自珍","text":"身世闲商酒半醺，美人胸有北山文。\n平交百口悠悠辈，揖罢还期将相勋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2029,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二七一","author":"龚自珍","text":"金釭花炉月如烟，空损秋闺一夜眠。\n报道妆成来送我，避卿先上木兰船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2030,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二七三","author":"龚自珍","text":"欲求缥缈反幽深，悔杀前翻拂袖心。\n难学冥鸿不回首，长天飞过又遗音。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2031,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二七四","author":"龚自珍","text":"明知此浦定重过，其奈尊前百感何？\n亦是今生未曾有，满襟清泪渡黄河。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2032,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二七五","author":"龚自珍","text":"绝业名山幸早成，更何方法遣今生？\n从兹礼佛烧香罢，整顿全神注定卿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2033,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二七八","author":"龚自珍","text":"阅历天花悟后身，为谁出定亦前因。\n一灯古店斋心坐，不似云屏梦里人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2034,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二七九","author":"龚自珍","text":"此身已坐在山泉，涓滴无由补大川。\n急报东方两星使，灵山吐溜为粮船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2035,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二八○","author":"龚自珍","text":"昭代恩光日月高，丞彝十器比球刀。\n吉金打本千行在，敬拓斯文冠所遭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2036,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二八三","author":"龚自珍","text":"曩将奄宅證淹中，肃肃微言謦欬逢。\n肯拓同文门畔石，古心突过汉朝松。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2037,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二八四","author":"龚自珍","text":"江左吟坛百辈狂，谁知阙里是词场？\n我从宅壁低徊听，丝竹千秋尚绕梁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2038,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二八五","author":"龚自珍","text":"嘉庆文风在目前，记同京兆鹿鸣筵。\n白头相见冬山路，谁惜荷衣两少年？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2039,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二八七","author":"龚自珍","text":"子云壮岁雕虫感，掷向洪流付太虚。\n从此不挥闲翰墨，男儿当注壁中书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2040,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二八八","author":"龚自珍","text":"倘作家书寄哲儿，淮阴重话七年情。\n门前报有关山客，来听西斋夜雨声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2041,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二八九","author":"龚自珍","text":"家有凌云百尺条，风烟陪护渐岧峣。\n生儿只识秦碑字，脆弱芝兰笑六朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2042,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二九○","author":"龚自珍","text":"盗诗补诗还祭诗，子梅诗史何恢奇。\n鄙人劝君割荣者，努力删诗壮盛时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2043,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二九一","author":"龚自珍","text":"诗格摹唐字有棱，梅花官阁夜锼冰。\n一门鼎盛亲风雅，不似苍茫杜少陵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2044,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二九二","author":"龚自珍","text":"八岁梦到矍相国，今日五君来做主。\n我欲射侯陈礼容，可惜行装无白羽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2045,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二九三","author":"龚自珍","text":"忽向东山感岁华，恍如庾岭对横斜。\n敢参黄面瞿昙句？\n此是森森阙里花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2046,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二九七","author":"龚自珍","text":"苍生气类古犹今，安用冥鸿物外吟。\n不是九州同急难，尼山谁识怃然心？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2047,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二九八","author":"龚自珍","text":"九边烂熟等雕虫，远志真看小草同。\n枉说健儿身手在，青灯夜雪阻山东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2048,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三○一","author":"龚自珍","text":"艰危门户要人持，孝出贫家谚有之。\n葆汝心光淳闷在，皇天竺胙总无私。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2049,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三○三","author":"龚自珍","text":"俭腹高谈我用忧，肯肩朴学胜封侯。\n五经熟烂家常饭，莫似而翁歠九流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2050,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三○四","author":"龚自珍","text":"图籍移徙肺腑家，而翁本学段金沙。\n丹黄字字皆珍重，为裹青毡载一车。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2051,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三○六","author":"龚自珍","text":"家园黄熟半林柑，抛向筠笼载两三。\n风雪迎裾好持赠，预教诗婢识江南。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2052,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三○七","author":"龚自珍","text":"从此青山共露车，断无只梦堕天涯。\n黄梅淡冶山矾靓，犹及双清好到家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2053,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三○八","author":"龚自珍","text":"六义亲闻鲤对时，及身删定答亲慈。\n刬除风雪关山句，归到高堂好背诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2054,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三○九","author":"龚自珍","text":"论诗论画复论禅，三绝门风海内传。\n可惜语儿溪畔路，白头无分棹归舷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2055,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三一○","author":"龚自珍","text":"使君谈艺笔通神，斗大高阳酒国春。\n消我关山风雪怨，天涯握手尽文人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2056,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三一五","author":"龚自珍","text":"吟罢江山气不灵，万千种话一灯青。\n忽然搁笔无言说，重礼天台七卷经。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2057,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其八十七","author":"龚自珍","text":"故人横海拜将军，侧立南天未蒇勋。\n我有阴符三百字，蜡丸难寄惜雄文。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2058,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其四十四","author":"龚自珍","text":"霜毫掷罢倚天寒，任作淋漓淡墨看。\n何敢自矜医国手，药方只贩古时丹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2059,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一二五","author":"龚自珍","text":"九州生气恃风雷，万马齐喑究可哀。\n我劝天公重抖擞，不拘一格降人才。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2060,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一二三","author":"龚自珍","text":"不论盐铁不筹河，独倚东南涕泪多。\n国赋三升民一斗，屠牛那不胜栽禾？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2061,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其二十八","author":"龚自珍","text":"不是逢人苦誉君，亦狂亦侠亦温文。\n照人胆似秦时月，送我情如岭上云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2062,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"吴山人文徵、沈书记锡东饯之虎邱","author":"龚自珍","text":"一天幽怨欲谁谙，词客如云气正酣。\n我有箫心吹不得，落花风里别江南。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2063,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]