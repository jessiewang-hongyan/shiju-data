[{"title":"题吟红阁诗钞","author":"徐熙珍","text":"泪洒优昙一现来，夜阑开卷几低徊。\n愧他裙屐诸年少，谁似西泠咏絮才。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28443,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"归自鸿印轩","author":"徐熙珍","text":"春暮池塘夕照时，峰环路转步迟迟。\n绿油晴泻三篙水，红杏香凝万斛脂。\n趁暖燕泥黏柳絮，怜芳蛛网罩花枝。\n兴阑归去篮舆速，刻烛联吟七字诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28444,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感怀","author":"徐熙珍","text":"平安淡泊足娱情，学问还从阅历生。\n暗卜鱼仙参仰覆，共猜瓜战判输赢。\n当车量力螳撑臂，未雨知机蚁罢兵。\n欲步性灵诗不易，摹唐仿宋两无成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28445,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"初冬晚眺","author":"郑业娽","text":"黯黯荒郊欲暮时，朔风摇飏酒家旗。\n数声村犬吠行客，几处归鸦争晚枝。\n楼小先迎新月上，林高独下夕阳迟。\n霜馀木落群峰出，松柏凌寒独未知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28446,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"思亲不寐口占一绝","author":"郑业娽","text":"思亲眠不得，起坐夜三更。\n月照一庭白，慈乌故故鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28447,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山居遣兴","author":"易蘩","text":"嚣境何如静境栖，长吟人坐小窗西。\n地偏时有閒车马，客至犹能具黍鸡。\n四面松疏蟾送影，半沟水浅燕衔泥。\n谁知领取幽居趣，合计诗坛细品题。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28448,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"哭二弟信臣华臣","author":"易蘩","text":"吾家近事不堪闻，雁序伤心两失群。\n白发孤镫悲寸草，青枫落日哭双坟。\n萱花冷淡怜亲老，菽水艰辛赖子勤。\n识破彭殇同一例，拭乾泪眼看龙文。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28449,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梦中得四绝句醒后祇记其一","author":"易蘩","text":"庭花倚月落无声，澹澹秋云夜气清。\n一点诗心无管束，随风化作万松鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28450,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岢岚州署","author":"易蘩","text":"山为屏嶂石为台，活水都从云际来。\n万壑松涛清夏雨，一帘岚气暗春雷。\n寒鸦古树围官舍，澹月中庭老鹤胎。\n车马不喧城郭静，天教吏降占蓬莱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28451,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次夫子罢归原韵","author":"易蘩","text":"大好怡情地，天然小隐居。\n山围陶令宅，树拥子云庐。\n薄醉孙扶杖，论交友寄书。\n归来梅鹤吏，相守复何如。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28452,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读放翁集","author":"包兰瑛","text":"秋镫耿遥夜，下帘听疏雨。\n一卷《放翁集》，古秀照眉宇。\n平易似香山，忠爱匹老杜。\n石湖帅两川，先生居幕府。\n雪中草军书，下笔龙蛇舞。\n宝鸡达长安，旦暮可立取。\n奈何小朝廷，甘作湖山主。\n坐令龟堂诗，苦语泣肺腑。\n晚境封渭南，渭南渺何处。\n九州几时同，寸心千载许。\n馀情狎花草，亦与《离骚》伍。\n大雅逝不作，遗编亘今古。\n久读忘睡眠，远寺动残鼓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28453,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"纳凉","author":"包兰瑛","text":"夜凉挥麈谈风月，清兴真教俗虑删。\n银汉不流星斗转，一天秋思满人间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28454,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登狼山支云塔","author":"包兰瑛","text":"支云高塔走嶙峋，肯为裙钗渺此身。\n但觉天光俯银海，不知人世有红尘。\n二分垂足疑仙境，万事扪胸仗佛因。\n笑语同来诸女伴，此行奇绝胜飙轮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28455,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏史 其一","author":"包兰瑛","text":"千古牛衣肯死忠，直臣折槛亦奇功。\n诸儒杜谷真无赖，谏表区区说后宫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28456,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏史 其二","author":"包兰瑛","text":"此公佞佛久无灵，妖梦迷茫死未醒。\n谁为练儿编本纪，年年祇载老人星。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28457,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏史 其三","author":"包兰瑛","text":"虬髯十万拥戈船，一见龙颜意悯然。\n海外真王君莫笑，胜他褒鄂上凌烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28458,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏史 其四","author":"包兰瑛","text":"衣白披裘总出尘，一眈泉石一经纶。\n官家同学知何限，千古流传祇两人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28459,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏史 其五","author":"包兰瑛","text":"老泉潦倒布衣终，方叔台卿感遇同。\n却怪季奴署函面，一枝铁槊便称公。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28460,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏史 其六","author":"包兰瑛","text":"一幅《流民》郑侠摹，方田保甲罢追呼。\n讵知护法沙门在，又进《朝端莫助图》。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28461,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏史 其七","author":"包兰瑛","text":"江河万古盛文章，历圣相承宝箓长。\n我爱金家小尧舜，不烧书籍学秦皇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28462,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏史 其八","author":"包兰瑛","text":"廷杖初收谴诏来，国家元气久摧颓。\n不须苦说茄花酷，璁萼当年是祸胎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28463,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夕照","author":"包兰瑛","text":"参差茅屋晚烟微，麦陇风清乳燕飞。\n夕照邮亭渔唱远，绿杨桥畔一僧归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28464,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送咏春弟赓僖之皖江","author":"包兰瑛","text":"亲老不谋学，将如仕进何。\n趋时新法捷，得路故交多。\n红叶数行雁，黄山几点螺。\n瞻云知不远，暇日眺松萝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28465,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋意","author":"包兰瑛","text":"惨澹诗人笔，秋清诗益清。\n月扶花影起，风定竹阴生。\n砧杵谁家怨，关山万里情。\n梧桐疏叶落，河汉寂无声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28466,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"除夕寄外","author":"包兰瑛","text":"光阴同是异乡过，两地怀人意若何。\n万里音书中道阻，一年情绪此宵多。\n梅侵腊雪香犹敛，诗得春风韵更和。\n守岁不妨吟到晓，锦笺椒颂共谁哦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28467,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"侍大母小饮作","author":"包兰瑛","text":"春日暖桑榆，重闱晋一觚。\n鸳针閒处握，鸠杖醉时扶。\n梨枣孙牵袂，盘飧母戒厨。\n花前叙家庆，此乐即蓬壶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28468,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"毗陵游天宁寺舟中偶成","author":"包兰瑛","text":"溪添新涨碧流清，春泛兰桡趁晚晴。\n日薄片帆移淡影，雨馀修竹滴残声。\n林边寺近红墙露，天际云连白塔横。\n梵阁疏钟传逸韵，柳莺犹对夕阳鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28469,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渡江","author":"包兰瑛","text":"长空雨过彩虹明，艗艏迎潮自在行。\n烟树数峰团画稿，风帆十幅破云程。\n沙边鸥鹭盟秋水，江底鱼龙睡晚晴。\n且喜舟轻人意健，开窗时复对楸枰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28470,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望焦山","author":"包兰瑛","text":"昨为金山游，岩壑称奇遍。\n虽然足壮观，终嫌金碧炫。\n意欲陟焦山，幽秀觌层巘。\n无奈波澜险，惊涛驶如箭。\n今晨渡江归，舟发心仍恋。\n放眼眺佳处，遥青如匹练。\n颇似香炉峰，停帆几回见。\n坡公薄江潭，舶䑲风云变。\n我独挝回帆，奇境悭一面。\n准拟今宵梦，篮舆入葱茜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28471,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"睡起得句 其一","author":"包兰瑛","text":"杨柳阴阴日未西，落花如雨溅春泥。\n春风一枕潇湘梦，时有流莺窗外啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28472,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"睡起得句 其二","author":"包兰瑛","text":"昨日微薰今日寒，铜蠡漏静篆烟残。\n隔花鹦鹉声声唤，料峭东风莫倚栏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28473,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"辛丑迁居杭城珍珠巷留题旧宅小米峰","author":"包兰瑛","text":"峰峦小米巷真珠，同此杭州宅一区。\n机杼乍分鲛客慧，烟云犹忆虎儿母。\n敢偕白傅夸新第，未免青山恋故吾。\n惜别不须深感慨，总相宜处是西湖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28474,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"喜外书至","author":"包兰瑛","text":"风尘惯适旅怀宽，去住知君随遇安。\n临镜读来花共笑，背镫展处月同看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28475,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"移竹","author":"包兰瑛","text":"园地三弓馀，梅柳栽无数。\n有竹二百竿，梗塞清风路。\n呼僮移植小池东，祇要成行不要丛。\n笔端疏散气乃古，此竹亦与文心同。\n果然解箨春雷快，新绿森森换世界。\n君子从来挺拔姿，看渠玉立青天外。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28476,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自题锦霞阁","author":"包兰瑛","text":"落落幽人志，云霞自卷舒。\n敢云真福地，到此即仙居。\n商定名山业，珍藏异代书。\n玉台今韵事，惭愧女相如。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28477,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题京江鲍氏三女史诗合稿","author":"包兰瑛","text":"璇闺三秀冠当时，赋茗才华并擅奇。\n韵洽埙篪成合璧，光辉花萼缀连枝。\n清娱楼阁开诗境，绿饮山堂醉酒卮。\n更有烟波同泛乐，雁行鸥侣总相宜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28478,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自湘阴归省","author":"钱淑生","text":"初四发湘阴，初五泊新康。\n初六到长沙，初七下西乡。\n百数十里间，行李殊周章。\n逶迤入家门，再拜上北堂。\n老父出慰劳，老母问家常。\n弱妹供盥洗，嫂氏备茶浆。\n弟侄各欣喜，喧笑绕匡床。\n饼饵堆盘匜，枣栗盈篚筐。\n屋后枫叶丹，阶前菊花黄。\n至哉天伦乐，慰我长相望。\n所嗟时地异，抚己暗悲伤。\n昔时千金子，今成人未亡。\n不敢自流露，恐伤老人肠。\n黾勉膝下欢，鸠杖双扶将。\n幸此春日晖，椿萱正康强。\n相从北堂下，载奉称寿觞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28479,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"悲怀","author":"钱淑生","text":"苍苍岩际松，青青岭头柏。\n青苍互相映，不为岁寒厄。\n哀哉泉下人，此间卜幽宅。\n人生野马浮，光阴过驹隙。\n一杯酹荒芜，祝君且安适。\n毋为儿女悲，毋任狐狸迫。\n相从会有时，遗君寸心赤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28480,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梦感","author":"钱淑生","text":"昨晚梦亡夫，飘飘步烟雾。\n握手不得语，凄然忽惊寤。\n膝下鲜儿女，祭扫阙供具。\n哀哉未亡人，欲往无由赴。\n且复遣傒僮，奠汝荒丘墓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28481,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三兄归自新疆过湘感赋","author":"钱淑生","text":"人生苦远离，况复经岁年。\n悠悠日复日，时事多变迁。\n自从阿兄出，亲戚俱完全。\n前年妹夫死，幼子旋弃捐。\n嗣后祖翁姑，高年不复延。\n未几二伯翁，复表《泷冈阡》。\n我家伯父死，长兄自陇还。\n二嫂忽遽逝，家书言惨然。\n今年三伯母，又复归黄泉。\n老父悲亲戚，小病长纠缠。\n老母稍旷释，右臂病未痊。\n归省此其时，高堂望已穿。\n勿复滞归期，勉撑湘上船。\n再拜北堂人，四女未寄笺。\n为言人世事，修短自有天。\n悲吊苦无益，且自宽食眠。\n飞鸿傥有便，遗我书一篇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28482,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"堂上","author":"钱淑生","text":"堂上奉盘匜，堂下执箕帚。\n且复手纺绩，且复躬井臼。\n妇职有当然，非以悦人口。\n所嗟命不犹，齐眉失白首。\n念彼泉下人，身死骨未朽。\n恻恻摧心肝，孤镫十年久。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28483,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"归舍","author":"钱淑生","text":"柴门故依然，老槐覆溪水。\n乱石砌作堤，苔藓成纹理。\n经年不归来，归觉心可喜。\n入门见閒花，枝叶相依倚。\n翩翩梁上燕，呢喃初引子。\n好景在故园，非关自夸美。\n怡怡菽水欢，敬慎将杖履。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28484,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"回湘阴晓发舆中口占","author":"钱淑生","text":"东岭延朝晖，西峰挂残月。\n牧牛亦已出，鸣鸡犹未歇。\n凄清重凄清，此心独兀兀。\n回首望门闾，迢迢隔林樾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28485,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"归燕曲","author":"钱淑生","text":"玉露零零金风冷，梁燕归飞已无影。\n回首乌衣春梦长，伤怀红缕秋心警。\n今年已过又明年，啄草衔泥亦可怜。\n谁识楼中建封妇，死心还在落花前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28486,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"慈乌曲","author":"钱淑生","text":"慈乌哑哑枝上啼，乳乌拍拍高复低。\n乳乌飞起慈乌喜，乳乌堕地慈乌止。\n乌飞乌止各有心，团团且绕栖巢林。\n一乌远出衔虫豸，一乌守巢护乌子。\n何时乳乌毛羽成，反哺酬恩见物情，人生抚儿亦如此，抚儿望儿良有以。\n哀哀惟我独虚生，累亲无计徒吞声。\n感此慈乌坐无语，心酸骨折泪如雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28487,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"阶下梧桐忽然半枯感而有作","author":"钱淑生","text":"百尺高何用，枯枝不识春。\n汝为半死树，我亦未亡人。\n无复阶前荫，惟堪爨下薪。\n《南华》齐物我，相对独伤神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28488,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江天晚眺","author":"钱淑生","text":"泽国苍茫里，风平水不波。\n江空来雁少，山远夕阳多。\n渔艇数行集，征帆几阵过。\n白云亲舍在，归信待如何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28489,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和三兄游桃花灵云寺元韵","author":"钱淑生","text":"数声钟动下遥岑，知是桃花古寺林。\n溪水消馀半篙浅，春云浓起一峰深。\n茶烹雀舌留新味，树拥龙鳞接晚阴。\n为问游人诗思好，清吟可有出尘心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28490,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜坐","author":"钱淑生","text":"雨细愁难洗，风寒夜未眠。\n坐听更数转，烧烬博山烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28491,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆母","author":"钱淑生","text":"频将思母泪，早暮洒湘阴。\n极目江天远，白云何处深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28492,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"即景","author":"钱淑生","text":"东风犹自作春寒，日暮何人翠袖单。\n一树梅花数行行，清吟能得几凭栏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28493,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晓起","author":"钱淑生","text":"一半山岚一半烟，晓星寥落破霜天。\n忽闻古寺晨钟发，回首西山月尚圆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28494,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与姚氏三妹谈吴门名胜口号纪游 其一","author":"周桂清","text":"绿水桥西泊画船，垂杨倒影入沦涟。\n人人都上生公石，几辈曾参不语禅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28495,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与姚氏三妹谈吴门名胜口号纪游 其二","author":"周桂清","text":"古桧清奇邓尉寻，石楼探遍早梅林。\n还元阁下湖如镜，洗涤尘凡一片心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28496,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与姚氏三妹谈吴门名胜口号纪游 其三","author":"周桂清","text":"清钟夜半寒山寺，不到枫桥估客船。\n安得檀施金布地，精蓝重睹大康年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28497,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与姚氏三妹谈吴门名胜口号纪游 其四","author":"周桂清","text":"灵岩山色香溪水，日日横塘渡口迎。\n若向震湖重把棹，莫釐峰下一帆轻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28498,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与姚氏三妹谈吴门名胜口号纪游 其五","author":"周桂清","text":"朝天万笏山容古，一线攀登饮钵盂。\n似燕身材舆妇喜，每因肥瘠哭啼殊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28499,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与姚氏三妹谈吴门名胜口号纪游 其六","author":"周桂清","text":"维舟昧爽等花开，花气因风四面来。\n谁谓无声方入画，亲闻甲坼隐春雷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28500,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与姚氏三妹谈吴门名胜口号纪游 其七","author":"周桂清","text":"行春桥外秋光满，满汊菱窠信手牵。\n摇舻不知镫火上，城中又见月华圆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28501,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"光绪乙亥铎儿始生时寓盘门开窗正对瑞光寺塔诗以勖之","author":"周桂清","text":"浮图涌现如文笔，界破青天任尔书。\n屋外高林通古寺，座中修竹认吾庐。\n清池日涤端溪砚，陋巷时来长者车。\n姑藕之无正蒙养，鲤庭方盛祖庭馀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28502,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虎丘","author":"阚寿坤","text":"剑池风冷石陂陀，断塔荒凉一再过。\n闻道开元全盛日，夕阳箫鼓画桡多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28503,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"关山月","author":"冯畹","text":"关山月，关山月，山月高高漏未歇。\n城头一夜戍角鸣，大帅平明大纛行，寒沙万里晓光白，斥堠千山烽火青。\n昨从都尉下三山，复逐轻车出汉关。\n三边积雪埋头白，五夜胡风彻甲寒。\n月色营前凝望久，重窥记自葱岭首。\n多情不舍出塞骑，犹为离人照刁斗。\n关山月，愿分一半清皎光，为照闺中望月常如此。\n塞上征人行未已，醒时惆怅月照席，梦里空迷塞烟紫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28504,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄大兄","author":"冯畹","text":"离怀渺渺一缄书，寄向春风且任渠。\n何限洮河东去水，此中无处著双鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28505,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日离咏寄夫子 其一","author":"冯畹","text":"宵柝声声夜未央，博山红烬玉烟凉。\n麝煤兰篆休重炷，不是君来便不芳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28506,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日离咏寄夫子 其二","author":"冯畹","text":"银烛斜临倦眼明，坐来转觉不胜情。\n忽然忆著相思句，正是销魂第一程。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28507,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日离咏寄夫子 其三","author":"冯畹","text":"吟怀无那觉肠乾，为乞松萝助洒翰。\n扶得几分诗力起，好将新句寄君看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28508,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日离咏寄夫子 其四","author":"冯畹","text":"相思只隔两三程，写尽吴笺寄不成。\n却忆小窗前夕雨，为侬搀梦到金城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":28509,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]