[{"title":"丑奴儿令 其一 妓席送酒","author":"毛奇龄","text":"玉瓶春暖酴醾浅，艳杀青哥。\n窄袖摩挲。\n早把空杯弄钿螺。\n擎来误湿双条脱，重泻金波。\n斜对银河。\n唱罢甘州奈若何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37110,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丑奴儿令 其二","author":"毛奇龄","text":"珠绳初挂银河泻，花满中庭。\n露满中庭。\n懒向庭前看月明。\n山屏几褶孤眠久，梦也难凭。\n醒也难凭。\n翻愿今宵梦不成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37111,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其一 桑妇词","author":"毛奇龄","text":"城南暮雨。\n尚有采桑秦氏女。\n低系桑笼。\n独倚桃花一树红。\n青骢西去。\n口里衔丝衔不住。\n归到灯前。\n一任三眠与四眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37112,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"减字木兰花 其二 同姜八孝廉有访","author":"毛奇龄","text":"陆公祠畔。\n十里横塘行未半。\n花港深深。\n王四娘家何处寻。\n醁醅初注。\n又是孝廉船欲去。\n怕照菱花。\n对面分明又一家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37113,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卜算子 其一","author":"毛奇龄","text":"小鸟踏花枝，花落如红霰。\n花树朦胧一径迷，中有佳人面。\n愁见落花多，欲去还留恋。\n扇子盛来仔细看，点点桃花片。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37114,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卜算子 其二","author":"毛奇龄","text":"门外绿杨堤，门里红妆女。\n何处金羁美少年，故绾垂杨缕。\n风起搅杨花，飞作廉纤雨。\n眼底迷迷不见人，且听黄鹂语。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37115,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"阮郎归 其一 春暮","author":"毛奇龄","text":"樱桃子熟竹初肥。\n南园昼启迟。\n蜂房滤粉暗成脾。\n画垣生绿衣。\n蒲雨涨，柳桥低。\n秋千深院迷。\n杜鹃啼歇最高枝。\n有人还未归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37116,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"阮郎归 其二 秋暮见晓妆者","author":"毛奇龄","text":"拒霜花发傍妆楼。\n楼前细水流。\n隔花初日上帘钩。\n美人楼上头。\n开碧箧，泻红油。\n镜边长坐愁。\n鸳鸯瓦热露华浮。\n玉钗寒未抽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37117,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 和任二王辅回环韵","author":"毛奇龄","text":"阴柳垂庭山枕斜。\n禽鸣自上槛边花。\n深屏午梦隔窗纱。\n瓮启冰牙蛆泻酒，襟披雪眼蟹潆茶。\n临妆晚扫淡黄鸦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37118,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"回前","author":"毛奇龄","text":"斜枕山庭垂柳阴。\n花边槛上自鸣禽。\n纱窗隔梦午屏深。\n酒泻蛆牙冰启瓮，茶潆蟹眼雪披襟。\n鸦黄淡扫晚妆临。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37119,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"武陵春 登仙桃山","author":"毛奇龄","text":"溪口桃花红欲暮，浅水泛胡麻。\n行尽空林散紫霞。\n来到上清家。\n缥缈香坛松饭熟，石鼎醉丹砂。\n归路残阳噪晚鸦。\n回首乱云遮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37120,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其一 即事","author":"毛奇龄","text":"花前鼓瑟花间听，红灯低照新妆靓。\n侍婢唤行云。\n高唐曾见君。\n玉笼香雾绕，怕见青铜晓。\n井上辘轳声，翻教睡画屏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37121,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其二 咏枕和友","author":"毛奇龄","text":"珊瑚镂枕珠阗细。\n盘云散泽香衣腻。\n枯压鬓边花，花红印一些。\n与谁同转侧，绣出双鸂鶒。\n将枕付陈思。\n陈思思不思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37122,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其三 咏枕和友","author":"毛奇龄","text":"嘉文小裹双丝纽。\n单窝认得孤眠久。\n泪浥口脂融，相逢一梦中。\n花函遮短帔，中有相思字。\n银烛夜来新，深怜抱枕人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37123,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其四 商霖臣纳姬","author":"毛奇龄","text":"沟头流水山头雪。\n春江几度迎桃叶。\n桃叶渡江来，江花两岸开。\n珍珠量几斛，买得双蛾绿。\n衫子绿于蛾，双蛾奈绿何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37124,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其五 为杨生催妆者，多见纸落，椽上官知书也。最后弟子周风远，索甡和词","author":"毛奇龄","text":"丹枫叶叶迎春小，锦茵开处香鸾绕。\n银扇隔雕栊，灯花百子红。\n檐前乌鹊曙，休遣催妆去。\n赋得夜来珠，昭容揽镜馀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37125,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其六 为杨生催妆者，多见纸落，椽上官知书也。最后弟子周风远，索甡和词","author":"毛奇龄","text":"雕篮细压花毬小。\n金箱叠锁珠丝绕。\n花烛满帘栊，双樽琥珀红。\n芙蓉清漏曙，晓凤衔烟去。\n慢撒帐头珠，香奁贮有馀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37126,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其七 颠倒韵伯兄大千侄阿莲同作","author":"毛奇龄","text":"药栏勾堕衔钗雀。\n雀钗衔堕勾栏药。\n花落画屏纱。\n纱屏画落花。\n晓山关雁绕。\n绕雁关山晓。\n人远惜残春。\n春残惜远人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37127,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其八 颠倒韵伯兄大千侄阿莲同作","author":"毛奇龄","text":"软铺铜甃飞红浅。\n浅红飞甃铜铺软。\n深巷柳摇金。\n金摇柳巷深。\n爚篝香雾薄。\n薄雾香篝爚。\n门掩半黄昏。\n昏黄半掩门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37128,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其九 颠倒韵伯兄大千侄阿莲同作","author":"毛奇龄","text":"去春三鸟栖来曙。\n曙来栖鸟三春去。\n边塞绝秋千。\n千秋绝塞边。\n错弹哀抵角。\n角抵哀弹错。\n楼倚谢娘秋。\n秋娘谢倚楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37129,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其十 颠倒韵伯兄大千侄阿莲同作","author":"毛奇龄","text":"井干双断金丝绠。\n绠丝金断双干井。\n城上响啼莺。\n莺啼响上城。\n绮园南去骑。\n骑去南园绮。\n迟日坠鸣机。\n机鸣坠日迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37130,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其十一 颠倒韵伯兄大千侄阿莲同作","author":"毛奇龄","text":"簸钱金压花裙唾。\n唾裙花压金钱簸。\n斜日斗钿车。\n车钿斗日斜。\n酒胡雕列缶。\n缶列雕胡酒。\n孤独醉当垆。\n垆当醉烛孤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37131,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其十二 颠倒韵伯兄大千侄阿莲同作","author":"毛奇龄","text":"熨香沉斗珠绳屈。\n屈绳珠斗沉香熨。\n花鸭睡笼纱。\n纱笼睡鸭花。\n减丝荷漏浅。\n浅漏荷丝减。\n长夜好难量。\n量难好夜长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37132,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其十三 颠倒韵伯兄大千侄阿莲同作","author":"毛奇龄","text":"烛槃深影春围曲。\n曲围春影深槃烛。\n迷路入花溪。\n溪花入路迷。\n枕函空覆锦。\n锦覆空函枕。\n遮莫苦栖鸦。\n鸦栖苦莫遮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37133,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其十四 颠倒韵伯兄大千侄阿莲同作","author":"毛奇龄","text":"刺桐花满高桥寺。\n寺桥高满花桐刺。\n魂断几家村。\n村家几断魂。\n去騧嘶落絮。\n絮落嘶騧去。\n娘度夜中霜。\n霜中夜度娘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37134,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其十五 颠倒韵伯兄大千侄阿莲同作","author":"毛奇龄","text":"小姑村映青溪晓。\n晓溪青映村姑小。\n家是就矶斜。\n斜矶就是家。\n返舟莲棹远。\n远棹莲舟返。\n侬识旧娃宫。\n宫娃旧识侬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37135,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其十六 寄友","author":"毛奇龄","text":"上潮春涨西陵望。\n望陵西涨春潮上。\n寒雨渡来难。\n难来渡雨寒。\n燕泥衔断槛。\n槛断衔泥燕。\n时苦作蚕丝。\n丝蚕作苦时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37136,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其十七 访所欢作","author":"毛奇龄","text":"路旁厢板乌椑树。\n树椑乌板厢旁路。\n寻处甚阴阴。\n阴阴甚处寻。\n缕丝千点雨。\n雨点千丝缕。\n何若别情多。\n多情别若何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37137,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮 其十八 落帆亭送女士黄皆令远行","author":"毛奇龄","text":"窄帆轻落亭前驿。\n驿前亭落轻帆窄。\n红露浥花栊。\n栊花浥露红。\n渡淮临雨暮。\n暮雨临淮渡。\n长过莫愁乡。\n乡愁莫过长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37138,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"摊破浣溪沙 怀张七雏隐粤东未归","author":"毛奇龄","text":"黄木湾前芦雁稀。\n琵琶洲畔竹花飞。\n南去陆郎烟瘴里，几时归。\n翠鸟羽长临镜远，章鱼海阔跳波微。\n看到木棉红又白，好装衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37139,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"少年游 过陵下感旧","author":"毛奇龄","text":"当时邂逅，凌家山下，桃树满前津。\n今来又值，桃花开后，不见那时人。\n香轮翠幕陵前路，日影动飞尘。\n流水横斜，鸟啼哀怨，愁对武陵春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37140,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南柯子 其一 斗草词","author":"毛奇龄","text":"喜摘唯红豆，难攀是白榆。\n百花亭外展氍毹。\n藏得宜男、临赛又踟蹰。\n绡帕牵藤刺，缃襕裹露珠。\n朦胧却把翠钿输。\n暗拣花枝、插补鬓边虚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37141,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南柯子 其二 和杨王客赋得玲珑隔窗语","author":"毛奇龄","text":"青漆垂银钥，丹纱映玉栊。\n隔窗娇立小芙蓉。\n两地分明、细语一灯红。\n好鸟音初剪，幽兰气转浓。\n相看枉自唤玲珑。\n一寸明螺、槅子万重峰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37142,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南柯子 其三 落花","author":"毛奇龄","text":"粉蕊飘来薄，红英落处稀。\n一团并作屐头泥。\n却是桃花飞过、李花飞。\n残粉留青蒂，零红断碧枝。\n落花那辨早和迟。\n空自晓风吹了、晚风吹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37143,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南柯子 其四 饮龚氏","author":"毛奇龄","text":"梧子丛台敞，荷香小幕开。\n冰浆雪瀣满樽罍。\n时见梁间双燕、自飞回。\n覆草传螺碗，藏钩觅坠钗。\n闺中柳絮谢家才。\n妒煞王郎、私遣隔帘猜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37144,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天 其一","author":"毛奇龄","text":"绛帐迢迢结作云。\n东风吹皱石榴纹。\n芙蓉弄色调金粉，蛱蝶寻双认绣裙。\n花羃历，思纷纭。\n游车归去日斜讯。\n不知唱得难忘曲，十二钗边若个闻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37145,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天 其二 过女教场有感","author":"毛奇龄","text":"银甲雕戈小队工。\n内家宣敕教从戎。\n山萝覆镞萦金细，野火烧旗闪幔红。\n宫月静，阵云空。\n凤凰山下抱龙弓。\n珠兜玉靸团营路，小雨寒花何处逢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37146,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天 其三 赋得鸳鸯沙路远","author":"毛奇龄","text":"翠鬣红翘金蹠低。\n藕花多处一汀迷。\n谁怜比翼琴台瓦，枉织双丝锦字机。\n银埒远，玉塘稀。\n天长海阔几时归。\n相离只解相思死，那解相思未死时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37147,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天 其四 赋得鸳鸯沙路远","author":"毛奇龄","text":"蓼浦兰江隔远涔。\n彩毛飞去信音沉。\n十三弦上锼金柱，二八丫头琢玉簪。\n无处觅，好难寻。\n空留双影绣罗衾。\n几回欲向沙头路，到得沙头路转深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37148,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉楼春 其一 姜汝高公子迎婚武林","author":"毛奇龄","text":"梅花开满清江路。\n北府夜凉新幰度。\n谁开扇上五明罗，只挂灯前九子璐。\n西陵水削回潮暮。\n双盏乍传天欲曙。\n开元新赐小金钱，撒在帐中无觅处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37149,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉楼春 其二 八月宿姜真源宪使后院夜饮同小农汝旦作","author":"毛奇龄","text":"红蕖小幕开深槛。\n微雨乍收凉漏浅。\n酒淹垆火带霜吹，风搅浊油和烟剪。\n银船交泛明河转，玉树当轩共婉娈。\n夜深空忆广陵涛，水绕曲江知近远。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37150,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉楼春 其三 题诗纬","author":"毛奇龄","text":"吴山晓阁妆螺子。\n山木倒开蛮镜里。\n笔床闲写竹衣红，书带自垂藤菜紫。\n机头小轴穿花绮。\n纂就散丝盈络纬。\n秋波千顷照芙蓉，无数彩云江畔起。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37151,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人 其一 九日蠡城遇雨","author":"毛奇龄","text":"龙山秋曙官亭冷。\n烟锁茱萸井。\n西风吹雨雁南来。\n何处还登戏马宋公台。\n美人垆下桑郎熟。\n细把金钱菊。\n辽东皂帽堕堪伤。\n不道满城风雨又重阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37152,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人 其二 广陵李宗伯寓观女举作","author":"毛奇龄","text":"芜城新曲勾栏浅。\n覆地氍毹软。\n小蛮金管雪儿筝。\n二十四桥明月照人醒。\n三朝不作衔书凤。\n但舞江南弄。\n晓风散去彩云愁。\n可是竹西歌吹久扬州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37153,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人 其三 喜来、我平归自江右，寄诗并讯徐大文、张祖望、吴云章消息","author":"毛奇龄","text":"布帆婀娜江州至。\n贻我相思字。\n怀中一日九开看。\n记得旧时风雨夜阑干。\n潮平若泛西陵渡。\n须把滕王赋。\n南州榻冷剑城凉。\n借问延陵何日下南昌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37154,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人 其四 寄怀邹吁士","author":"毛奇龄","text":"宫莺细啭皇州路。\n花暖金盘露。\n春风扈从赋长杨。\n策马归来重醉酒垆傍。\n钱塘五月冰壶晓。\n别馆新荷小。\n瑶辞百幅重南金。\n思煞梁园客子到如今。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37155,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"青玉案 其一 渡江有感","author":"毛奇龄","text":"夕阳江上丹枫暮。\n看车马、纷无数。\n当日西施从此去。\n城山出海，楼船近岸，中有更衣处。\n平沙十里长亭路。\n空留得、花如雾。\n最恨江流流不住。\n暮潮初下，午潮还上，今古西陵渡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37156,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"青玉案 其二 渡江有感","author":"毛奇龄","text":"片帆絓处芦花白。\n痛年少、经兵革。\n庾信江陵归未得。\n教兵城下，高迁屯畔，一夜寒涛坼。\n东来西往看如织。\n问谁是、当时客。\n睹此芒芒百思集。\n素车何在，乌鸢散尽，犹有人沾臆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37157,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"瑞鹧鸪 其一 合虞美人调和侄阿莲","author":"毛奇龄","text":"梨花亸鹊惊春雪，柳曲迎车怯晓风。\n篮外蝶衣笼画粉，楼头凤蜡泻珠红。\n熏迷银叶怜妆坼，露压金槽滴睡浓。\n无奈景阳钟隐隐，数声和月到帘栊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37158,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"瑞鹧鸪 其二 合虞美人调和侄阿莲","author":"毛奇龄","text":"春还绣陌桃初落，日映璚绡幕半遮。\n黄点额头花胜结，红抽靴子蒯绳芽。\n妒蛾筝合矜秦赵，细犊车香绕狭斜。\n空有侍中夸易识，难忘一笑在东家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37159,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"瑞鹧鸪 其三 合虞美人调和侄阿莲","author":"毛奇龄","text":"吴娃窈窕裁芳纻，楚竹参差聚列星。\n歌扇影回屏半褶，舞裙丝挂箔头钉。\n觞迎水曲翻龙㔶，车转花梢动鸽铃。\n天上旧曾听鼓瑟，归来几度暮山青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37160,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"瑞鹧鸪 其四 合虞美人调和侄阿莲","author":"毛奇龄","text":"董贤馆外骄騧骋，班氏门前冷鸟啼。\n湘浦芰裳迷蔡北，秦台苏合出乌西。\n针萦鸾缕愁丹缠，灯满蚕塸怨赤蹄。\n难与故夫携束素，重逢但唱杞梁妻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37161,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行 题梅市香奁集后","author":"毛奇龄","text":"宝扇横时，玉堂深处。\n开奁齐唱金针句。\n汉阳少妇解璇玑，孝标令妹工词赋。\n郁草名金，柳花成絮。\n满阑种就珍珠树。\n欲听缑氏海西谣，须寻仙尉江南路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37162,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小重山 其一","author":"毛奇龄","text":"麦垄青青菜垄黄。\n野棠花满路、日初长。\n谁家女伴斗新妆。\n蜂来往，刺得口脂香。\n三五映垂杨。\n见人还却步、背方塘。\n小姑不解断人肠。\n看花落，又看浴鸳鸯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37163,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小重山 其二 秋千词","author":"毛奇龄","text":"绣柱红绳曳彩云。\n双双悬画板、对斜曛。\n风吹袜子小鸦分。\n重扶下，低系水罗裙。\n天际映虹纹。\n抛来香带薄、绕氤氲。\n空园人散欲黄昏。\n惊鸿堕，花落自纷纷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37164,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小重山 其三","author":"毛奇龄","text":"花里重寻赵璧弹。\n流黄朝日映、织初残。\n停机暗下理双鬟。\n调弦请，莫是喜幽兰。\n弦涩苦难安。\n机丝曾裂指、沁心寒。\n思繁错记写离鸾。\n弹多误，频脱指环看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37165,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小重山 其四 得友书","author":"毛奇龄","text":"青鸟衔来双锦鳞。\n背人佯撇下、小重茵。\n口脂红浅浥香津。\n缄题处，印得指螺新。\n素字小泥银。\n簪花新样巧、卫夫人。\n鸳鸯格子剪江蘋。\n波纹细，恍见泪粼粼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37166,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小重山 其五","author":"毛奇龄","text":"一过东湖深又深。\n石桥啼不断、午时禽。\n柳黄曾压绞儿金。\n双朱户，流水昼沉沉。\n有女暗相寻。\n红衣羞泪湿、洗前襟。\n东风吹放小桃心。\n吹难住，吹落满庭阴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37167,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"调笑令 其一 冯二","author":"毛奇龄","text":"怨怨。\n柳如线。\n清漆鸦头红脰燕。\n背人偷弄金条钏。\n一曲桃枝相恋。\n落花飞满春江面。\n飞过春江何限。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37168,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"调笑令 其二 胥苓弟","author":"毛奇龄","text":"梦梦。\n晚花冻。\n小妹闺房原解诵。\n窥帘偏爱求凤弄。\n恰是琴心难动。\n琴心袅袅春风送。\n岂是琴心难动。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37169,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"调笑令 其三 王琴","author":"毛奇龄","text":"处处。\n绕飞絮。\n纱帽郎今何处去。\n章台折尽长条树。\n樗子街头重遇。\n玉瓶金盏灯前注。\n愁煞夜乌啼曙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37170,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临江仙 其一 沈康臣生日，席上作","author":"毛奇龄","text":"五月海榴红照眼，美人初佩丹砂。\n金堂绮席启朝霞。\n暑衣裁葛叶，冰碗浸菖花。\n赋就子虚将入奏，汉庭狗监先誇。\n秋风锦石动星槎。\n但悬金似斗，那羡枣如瓜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37171,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临江仙 其二 沈康臣生日，席上作","author":"毛奇龄","text":"细结五丝仙胜缕，屏间艾虎交悬。\n愿郎如虎复如仙。\n山公曾典薄，四十正当年。\n男子生难跨万乘，也应日数官钱。\n他时花拂锦连乾。\n欲看三岛雪，更泛五湖船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37172,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]