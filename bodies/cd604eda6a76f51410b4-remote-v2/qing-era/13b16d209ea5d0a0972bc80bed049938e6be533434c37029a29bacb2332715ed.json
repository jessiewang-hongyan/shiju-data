[{"title":"悼亡百绝句 其十五","author":"许传霈","text":"月逢十课不知忙，风雨难联兄弟床。\n心恻愚夫卖文字，寒天残漏作羹汤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15349,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其十六","author":"许传霈","text":"牛衣从不泣王章，世味无如道味长。\n大好家声书画舫，惟携端砚寿儿郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15350,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其十七","author":"许传霈","text":"母病当年独惯扶，宵来衣带解全无。\n果然天性生成厚，移孝双亲孝阿姑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15351,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其十八","author":"许传霈","text":"亲心钟爱不矜张，裙布荆钗非俭装。\n纵使豪家间往复，酬金末见入私囊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15352,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其十九","author":"许传霈","text":"见说家书抵万金，平安二字及佳音。\n怀经十稔封如古，留取当时两地心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15353,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其二十","author":"许传霈","text":"针线裁缝日日须，非徒裘葛衣其夫。\n偶馀尺布同零绢，犹到身边补旧无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15354,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其二十一","author":"许传霈","text":"相逢无不道人贤，斗起乡邻处泰然。\n只为是非明不得，谗言到耳化云烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15355,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其二十二","author":"许传霈","text":"累病东城薄暖天，多卿汤药上楼煎。\n背人含泪申祈祷，几见愁容到我前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15356,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其二十三","author":"许传霈","text":"衢湖历尽转苏州，哭望慈云在上头。\n赢得昆山仙眷属，结邻閒话六春秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15357,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其二十四","author":"许传霈","text":"治园新筑竹篱斜，不看桃花看菜花。\n岁暮归来贫亦乐，玉峰云里读书家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15358,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其二十五","author":"许传霈","text":"客来斗酒不须谋，剪韭治蔬尽适喉。\n雅喜金鳞烹宋嫂，家家艳说是鱼球。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15359,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其二十六","author":"许传霈","text":"每逢周急恻衷怀，终被人欺百事乖。\n学到吃亏常不计，非徒宴客质金钗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15360,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其二十七","author":"许传霈","text":"间关远道省亲身，八十年华纪大椿。\n一束蒸豚一瓶水，归宁不道婿家贫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15361,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其二十八","author":"许传霈","text":"十二胎生自哺劬，艰辛每岁听呱呱。\n最难穷巷分无乳，走乞炎天舌本枯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15362,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其二十九","author":"许传霈","text":"清明荐席撤昆园，中馈劳伤不自言。\n廿五月胎成半产，讳他僵病寄桑根。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15363,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其三十","author":"许传霈","text":"苏台屡过辄迷津，拙政园迎夏景新。\n彷佛西湖游侍母，荷花香里话前因。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15364,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其三十一","author":"许传霈","text":"惠麓烹茶践约无，弇山灯事又模糊。\n明知老去须行乐，偏值年年多病躯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15365,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其三十二","author":"许传霈","text":"告诫篷窗知不知，双双儿女未童时。\n偶闻一语伤心处，爣病将成爷力衰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15366,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其三十三","author":"许传霈","text":"予生九战浙秋闱，供应烦卿想入非。\n前度忽萌偕隐愿，慰情无复到慈帏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15367,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其三十四","author":"许传霈","text":"长夏奔丧暑压船，况当背疽发才痊。\n咸疑亏损根犹伏，索解无从此一年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15368,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其三十五","author":"许传霈","text":"重阳同放海昌船，新涨初通郭店前。\n劳尽心神方息足，望归游子眼犹穿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15369,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其三十六","author":"许传霈","text":"椿庭痛不侍弥留，送窆归从色相求。\n袖出前年西法照，为摅孺慕瞩题头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15370,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其三十七","author":"许传霈","text":"不喜绮罗时世装，春来偏学看蚕忙。\n天然好事难如愿，墙外竞多植女桑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15371,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其三十八","author":"许传霈","text":"要结今生不解缘，相寻踪迹若盘旋。\n谁知到海仍须别，莫繫明朝对渡船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15372,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其三十九","author":"许传霈","text":"朝朝千里望予归，枕上应多泪暗挥。\n江海卸帆馀八日，从无身后说依稀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15373,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其四十","author":"许传霈","text":"果知说到伤心事，远客初归伤尽心。\n除去脾虚兼腹热，堪期早晚免呻吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15374,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其四十一","author":"许传霈","text":"仙露连番惠罄瓶，常从长史谢零星。\n终颁百合同山药，苦乏和中伴茯苓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15375,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其四十二","author":"许传霈","text":"深体儿曹夜勿陪，扶床强起几多回。\n灯前慰我分栖稳，犹觅饧糖手送来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15376,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其四十三","author":"许传霈","text":"平时药裹失量裁，恨晚难将元气培。\n浸晓勉为开口问，舌尖新起雪花胎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15377,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其四十四","author":"许传霈","text":"顾覆深情莫可描，怜他少子护长宵。\n不言身热言儿热。\n分宿谁知无别朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15378,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其四十五","author":"许传霈","text":"苦尽常思回蔗甘，此时此理不须谈。\n隔帏呼我声无力，犹讶无闻至再三。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15379,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其四十六","author":"许传霈","text":"不讳怎知深讳难，终朝自汗叹无端。\n低声但说钱刀匮，此意分明托和盘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15380,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其四十七","author":"许传霈","text":"习俗难移邻里家，畴凭正气压群邪。\n何图词祝方宣后，唤不回头两眼斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15381,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其四十八","author":"许传霈","text":"环床恸哭九人齐，老仆情真亦夜啼。\n哭过五更仍不起，浑疑一睡入沈迷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15382,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其四十九","author":"许传霈","text":"来朝商略荐盘新，七度哀逢母忌辰。\n奚不相随供馔饭？\n岂真地下独依亲？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15383,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其五十","author":"许传霈","text":"暝目未能复口开，视含苍玉莫心灰。\n支肩尚有衰年婿，为抹眉头日几回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15384,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其五十一","author":"许传霈","text":"久谢铅华世俗装，洁身有物却初偿。\n今朝薰沐朝天去。\n应带江南皂荚香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15385,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其五十二","author":"许传霈","text":"苏绢装成侍女工，携归争欲闹儿童。\n讵知从葬齐称俑，玉立双双儿席中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15386,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其五十三","author":"许传霈","text":"两鬓休言对未皤，柔丝争比泪丝多。\n可怜儿媳分梳后，床下怎教著地拖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15387,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其五十四","author":"许传霈","text":"吾母怜儿汝敬夫，丝棉制被入冬铺。\n要留遗泽温泉壤，权作衣衾别样呼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15388,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其五十五","author":"许传霈","text":"竟到阴阳各一天，草心堆里独长眠。\n凭棺称谓声声咽，再与儿孙半面缘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15389,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其五十六","author":"许传霈","text":"帆送桐棺一夕中，武林幸得涨流通。\n阿兄购取姊随至，聊慰弥留无尽衷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15390,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其五十七","author":"许传霈","text":"邻居女伴哭哀哀，交浅情深亦异哉。\n莫解此生缘会在，人言无间溯由来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15391,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其五十八","author":"许传霈","text":"耳熟高堂属望殷，后来福量驾诸兄。\n何图日坐长生命？\n赚得贤声长久名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15392,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其五十九","author":"许传霈","text":"院落沈沈花影新，犹馀丹桂忆前陈。\n窗中一样玲珑月，不照当时并坐人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15393,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其六十","author":"许传霈","text":"底是匆忙梦里逢，漫云死别去无踪。\n暗流香汗关行倦，消瘦浑忘病后容。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15394,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其六十一","author":"许传霈","text":"疏慵非坐亦非眠，絮语明明在耳边。\n怕说向平家室愿，依然慰藉似生前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15395,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其六十二","author":"许传霈","text":"难得归来归即留，妆台无恙傍床头。\n我今夜夜将名唤，不碍灵魂飞上楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15396,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其六十三","author":"许传霈","text":"惊醒幻境费疑猜，罗帐低垂寂不开。\n又恐常常枯老泪，期卿五夜一归来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15397,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其六十四","author":"许传霈","text":"非独关心死后期，结缡岁序也无疑。\n朝来亥月刚逢四，三十年前花烛时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15398,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其六十五","author":"许传霈","text":"城外潮惊同梦醒，东来西去数曾经。\n今时若不分生死，依旧联床夜夜听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15399,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其六十六","author":"许传霈","text":"浣濯衣衫初不知，从今检点要亲持。\n纵令一领兼旬著，无复帘前说换迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15400,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其六十七","author":"许传霈","text":"连宵窗破朔风寒，谁把棉衣制就看？\n堪笑阿爷兼阿母，孝围影里护儿单。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15401,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其六十八","author":"许传霈","text":"望断床前香稻汤，晓来无计润枯肠。\n盘匜特遣群儿奠，聊报生平举按庄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15402,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其六十九","author":"许传霈","text":"偶向江塘豁远瞳，谁家眷属出花丛？\n疑卿两度看潮后，识否家山遥指中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15403,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其七十","author":"许传霈","text":"是真是假认前身，描就遗容不染尘。\n归到头来都是假，何妨假者奉为真。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15404,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其七十一","author":"许传霈","text":"有亭有石有池塘，到此如归子女狂。\n谁料含杯朋满座，岁周齐为尔治丧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15405,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其七十二","author":"许传霈","text":"从俗营斋是也非，无多焚楮作钱飞。\n冥官若问夫何吝，道是虞江老布衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15406,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其七十三","author":"许传霈","text":"启灵发纼告从容，宏毅斋前烛泪浓。\n默默非真无验兆，如卿到底是温恭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15407,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其七十四","author":"许传霈","text":"何物儒生动众知，盛筵祖饯北门时。\n犹虞越礼干阴谴，功布铭旌分别持。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15408,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其七十五","author":"许传霈","text":"船窗人静鼾声稠，莫见桥过呼舵头。\n卓立身边新木主，同听夜雨到杭州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15409,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其七十六","author":"许传霈","text":"忆艮山门夜泊船，客秋凉透校书天。\n今朝枯对无聊赖，为遣儿童剪纸钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15410,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其七十七","author":"许传霈","text":"湖山西望暮云封，雁序孤沈六越冬。\n相约明朝东渡去，晓烟定破两高峰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15411,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其七十八","author":"许传霈","text":"低声时唤好随馀，魂帛灵幡共一舆。\n莫讶大江飞渡否，乌蓬到越梦非虚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15412,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其七十九","author":"许传霈","text":"船头船尾两灵牌，先后拈香理亦谐。\n枕里不堪回首处，此身同梦与同怀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15413,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其八十","author":"许传霈","text":"回望钱清故里赊，梅山东去夕阳斜。\n为谈蛏浦避兵事，不见当时仲姊家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15414,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其八十一","author":"许传霈","text":"称山晓渡浪翻银，风雨随潮危更频。\n莫挽灵舆帆尽侧，惊心生死满船人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15415,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其八十二","author":"许传霈","text":"羽士招魂返故乡，素帏分列费裁量。\n酸心片语宣邻媪，竟把新房作孝堂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15416,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其八十三","author":"许传霈","text":"望母遗阡岭隔低，灵光来去路无迷。\n泉台团聚惟迟我，寄语诸兄护弟妻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15417,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其八十四","author":"许传霈","text":"栗主重携怀袖堪，犹虞复道与层岚。\n休嫌寂寞留宗佑，待我他年共一龛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15418,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其八十五","author":"许传霈","text":"生前离散最销魂，今日依然别墓门。\n江上晓风分送处，不知北辙或南辕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15419,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其八十六","author":"许传霈","text":"此行也算是生离，转讶缄书无复时。\n痴愿一端今胜昔，果能梦里远相随。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15420,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其八十七","author":"许传霈","text":"偶闻虞俗捣年糕，冬至阳生屈指遭。\n犹忆前时谆瞩付，饷宾荐祖为谁劳？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15421,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其八十八","author":"许传霈","text":"无形奇火起回廊，孤仆龙钟伴女郎。\n不是魂归先呵护，奚能阻得北风狂？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15422,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其八十九","author":"许传霈","text":"漫愁雨雪湿衣襟，兄墓新成穴乍临。\n道左为卿通慰藉，携锄添掘水沟深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15423,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其九十","author":"许传霈","text":"忽忽离尘百日间，姚江幸我近勾留。\n诸儿遥荐东塘里，可有飞魂北渡不？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15424,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其九十一","author":"许传霈","text":"长安西棹即盐官，偕往偕来行不难。\n讵料入宫真莫见，无非梦裹说团栾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15425,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"悼亡百绝句 其九十二","author":"许传霈","text":"且课儿曹夜作书，机声不复冷催馀。\n何堪月上黄昏后，独向池边听跃鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":15426,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]