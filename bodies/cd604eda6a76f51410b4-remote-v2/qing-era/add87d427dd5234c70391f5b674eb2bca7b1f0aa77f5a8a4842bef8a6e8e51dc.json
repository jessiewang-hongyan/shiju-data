[{"title":"牡丹诗二十首 其十三","author":"丘逢甲","text":"锦绣天街盆景新，十分红闹帝京尘。\n人间富贵终嫌骤，便作堂花不耐春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32148,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"牡丹诗二十首 其十四","author":"丘逢甲","text":"看到奇花眼欲迷，不须惊走笑山妻。\n天津桥上闻鹃客，忍断残香付马蹄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32149,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"牡丹诗二十首 其十五","author":"丘逢甲","text":"五云捧出缕金黄，欲遣陈州胜洛阳。\n自辟花中新世界，可怜人枉说妖祥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32150,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"牡丹诗二十首 其十六","author":"丘逢甲","text":"绝代才人集影园，宫袍黄染墨香温。\n扬州风月群花笑，争捧金罍上状元。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32151,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"牡丹诗二十首 其十七","author":"丘逢甲","text":"爱教花里筑妆楼，霞彩云芳艳影留。\n传与姑苏新样好，春风扶上美人头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32152,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"牡丹诗二十首 其十八","author":"丘逢甲","text":"花落花开怨别离，锦屏人更惜芳时。\n珊珊亭畔寻香梦，重唱风流玉茗词。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32153,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"牡丹诗二十首 其十九","author":"丘逢甲","text":"东来花种满西园，谁与乘槎客细论。\n从此全球作香国，五洲花拜一王尊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32154,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"牡丹诗二十首 其二十","author":"丘逢甲","text":"漫说中人赋十家，春风争买走香车。\n梦中彩笔新传得，要代欧阳更品花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32155,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画","author":"丘逢甲","text":"两山眉黛送春娇，十里平湖晓长潮。\n红入桃花青入柳，东风人立赤阑桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32156,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西园重见诗畸刻本，为之黯然","author":"丘逢甲","text":"斐亭钟断阵云阴，杳杳相思八桂林。\n一卷琳琅才子语，十年锁钥老臣心。\n传人妄计先灾木，割地谁知竟赂金。\n重检残编春院夕，五更红烛泪痕深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32157,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拜大忠祠回咏木棉花 其一","author":"丘逢甲","text":"枯木寒鸦吊大忠，力回阳九气熊熊。\n化身待挽芙蓉劫，洒血疑开杜宇宫。\n铜鼓哀歌春庙古，铁椎奸魄满庵红。\n扫除冰雪持炎运，合率群花拜祝融。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32158,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拜大忠祠回咏木棉花 其二","author":"丘逢甲","text":"阳枢星化木森森，撑拄南天夜不阴。\n赤制待除花九锡，紫琼分琢玉千林。\n五云拥护朝天面，万烛光明坠地心。\n锦绣江山春一统，西台朱鸟莫哀吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32159,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游白牛岩二首 其一","author":"丘逢甲","text":"有客婆娑大海南，白牛岩畔访禅庵。\n颠僧老死文公去，细雨松花扑石龛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32160,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游白牛岩二首 其二","author":"丘逢甲","text":"海色山光文起楼，才人遗墨壁间留。\n春林石气漾寒碧，落日倚栏云满头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32161,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"乡间人有误以予为武进士者，戏纪以诗","author":"丘逢甲","text":"书生面目太槎牙，太息封侯念已差。\n漫说旧衔同武爵，颇闻外论比文虾。\n老兵欲唤桓元子，故将谁知李左车。\n刁斗能铭矛解用，丈夫何事愧刘巴！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32162,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"废园","author":"丘逢甲","text":"林泉萧瑟是谁家，人去庭空感物华。\n病树有枝巢贱鸟，荒池无水俸私蛙。\n黄枯秋圃公孙橘，红瘦春篱姊妹花。\n头白园丁更惆怅，残畦种菜老生涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32163,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄怀林生葵阳","author":"丘逢甲","text":"东风吹客送吟鞭，桃李满城花正妍。\n晕碧楼台沧海气，踏青裙屐丽人天。\n梦回京国八千里，唤起神童五百年。\n欲托春心惟望帝，不须重问月公禅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32164,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"乞萧生作东山丝竹图 其一","author":"丘逢甲","text":"但无丝竹有东山，要乞丹青补黛鬟。\n莫被比邻文信国，满前姬侍笑儒酸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32165,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"乞萧生作东山丝竹图 其二","author":"丘逢甲","text":"中年哀乐宜丝竹，此意惟应逸少知。\n恰好流觞逢曲水，管弦添写在山时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32166,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游西岩作 其一","author":"丘逢甲","text":"路曲林幽别有天，出城岩翠接春田。\n孤云出树疑残塔，大海回潮应伏泉。\n扫墓人来东晋族，开山僧说盛唐年。\n宝通药地传灯冷，零落南宗六祖禅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32167,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游西岩作 其二","author":"丘逢甲","text":"沧洲东望昼冥冥，一角荒山仗佛灵。\n夹径花霏连理树，断碑苔没读书亭。\n六时钟磬林光碧，万里帆樯海气青。\n坐对石头无法说，将诗吟与蛰龙听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32168,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"得伯质太守书，知乞归未得，赋寄","author":"丘逢甲","text":"一载仍容借寇恂，双旌山畔粤江春。\n封章郑重循良绩，归计迟留畎亩身。\n海舶利成旁落势，陆梁风起近边民。\n艰难正仗匡时手，未许扁舟理钓纶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32169,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答潘兰史、丘菽园用王晓沧韵","author":"丘逢甲","text":"龙血玄黄战正酣，海山何处筑诗龛？\n权书枉著苏明允，心史空留郑所南。\n斫地有歌哀骥老，攀天无路阻鸾骖。\n蛮云黯黯愁思阔，聊写新词当麈谈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32170,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丘园八咏为顺德龙山家仲迟驾部作八首 其一 紫藤花馆","author":"丘逢甲","text":"名园高馆最玲珑，藤影花光护绮栊。\n璎珞四垂珠万串，一春长住紫云中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32171,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丘园八咏为顺德龙山家仲迟驾部作八首 其二 碧漪池","author":"丘逢甲","text":"海色天容共一池，群花寒浸碧涟漪。\n临流化尽春衫影，绝似唐宫浣露时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32172,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丘园八咏为顺德龙山家仲迟驾部作八首 其三 流春桥","author":"丘逢甲","text":"垂虹影落碧波寒，流尽春花春欲阑。\n独有春愁流不去，中原一发倚阑看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32173,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丘园八咏为顺德龙山家仲迟驾部作八首 其四 涵碧亭","author":"丘逢甲","text":"收尽云光夜见星，临波面面敞珠棂。\n眼中碧海无风浪，人卧乾坤一草亭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32174,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丘园八咏为顺德龙山家仲迟驾部作八首 其五 淡白径","author":"丘逢甲","text":"漠漠梨云出梦迟，春风花径独行时。\n别开冷艳幽香境，来写吾家左掖诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32175,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丘园八咏为顺德龙山家仲迟驾部作八首 其六 壁花轩","author":"丘逢甲","text":"琴酒名园载月过，开轩花气漾文波。\n不妨四立相如壁，消受芙蓉艳福多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32176,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丘园八咏为顺德龙山家仲迟驾部作八首 其七 浣风台","author":"丘逢甲","text":"雄风赋罢气飞腾，还似兰台快共登。\n沧海不尘天若洗，观星人立最高层。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32177,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丘园八咏为顺德龙山家仲迟驾部作八首 其八 绛雪楼","author":"丘逢甲","text":"天半寒光幻绮霞，倚楼人正赋尖叉。\n屏风写出赚山景，万树燕支六出花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32178,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"东山春思 其一","author":"丘逢甲","text":"春泉流涧晓潺潺，古院无人尽日閒。\n落尽碧桃归未得，望仙桥畔望家山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32179,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"东山春思 其二","author":"丘逢甲","text":"云壑风泉入画图，水帘亭畔客怀孤。\n海桐花发山桑熟，细雨春林叫鹁鸪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32180,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春暮游揭阳作 其一","author":"丘逢甲","text":"三月春江放棹行，水田漠漠万车声。\n空山废堠秦人戍，落日平芜汉代城。\n印铸彻侯封粤令，帆回海道阻闽兵。\n古怀赢纵东风目，散尽閒愁看野耕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32181,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春暮游揭阳作 其二","author":"丘逢甲","text":"玉滘潮生打桨忙，绿阴夹道水松凉。\n北来岭势连山越，南徼民风故陆梁。\n乔木村居名将冷，落花坟上美人香。\n江城如画吴中景，愁入昏昏海气黄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32182,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鮀浦喜晤萧伯瑶夜话","author":"丘逢甲","text":"惊风倒吹瘦蛟舞，海底鲛人泣珠雨。\n客楼一夕千秋语，憧憧灯影须眉古。\n天涯等是沦落人，笔花黯淡愁不春。\n不堪更诉虫沙劫，九州举目皆鲲身。\n长剑倚天悲未遇，流布人间剩诗句。\n乾颠坤摇卧不稳，睡龙夜瞰风云气。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32183,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"得伯瑶和章叠前韵","author":"丘逢甲","text":"华灯夜照柘枝舞，满地香云散花雨。\n豪竹哀丝送眉语，红氍毹捧宫妆古。\n安知座有伤心人，东风吹律声不春。\n满堂花作可怜色，浩劫欲化无边身。\n归倚客窗愁目遇，震魄惊魂吟大句。\n舍兵无法向人说，大九州方沉战气。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32184,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠夏季平殿撰二首 其一","author":"丘逢甲","text":"周南留滞得归迟，三策天人圣主知。\n四海喜闻新政日，六街争看状元时。\n小臣下土纵横涕，世事长安反覆棋。\n回首觚棱俱远梦，天涯相对怅秋期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32185,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠夏季平殿撰二首 其二","author":"丘逢甲","text":"海天龙雨走惊雷，黯黯蛮云瘴不开。\n万里梦回庄蹻国，千金装问赵佗台。\n本无温饱平生志，待济艰难旷代才。\n约吊文山酹尊酒，世忠亭畔看潮来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32186,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"风雨中与季平游东山，谒双忠、大忠祠，兼寻水帘亭、紫云岩诸胜，叠与伯瑶夜话韵","author":"丘逢甲","text":"万石捧云郁飞舞，神龙出布状元雨。\n寒鸦无语杜鹃语，心悯大忠来吊古。\n等是金鳌背上人，悲歌重写沁园春。\n河山一统初破碎，繄余更属浮萍身。\n零丁洋边与君遇，灵威庙前诵遗句。\n同揩远目青山间，一发中原夕阳气。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32187,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"叠韵答夏季平见赠","author":"丘逢甲","text":"群胡竞作天魔舞，㣼利天宫下兵雨。\n空山月黑翁仲语，欲灭皇风扫三古。\n满目女娲抟土人，濛濛梦入蟪蛄春。\n直甘大地作布施，何惜恒河沙等身？\n是何世界今顿遇，一切法消偈四句。\n相期出挽阳九厄，日轮天转黄人气。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32188,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳汀赠诗述及台事，叠韵答之","author":"丘逢甲","text":"东海饿蛟作人舞，万里炮云挟枪雨。\n相公款关奉盟语，玉斧一挥恨终古。\n天南流落忠义人，披发呼天天不春。\n臣军请缨云请剑，疏草劫烬馀吟身。\n伤心岂独士不遇，涕泪花前吟赠句。\n妇人醇酒足此生，老天不喜英雄气。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32189,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游东岩叠韵答柳汀","author":"丘逢甲","text":"留衣废亭石云舞，卓锡古泉冷飞雨。\n持赠山僧有才语，畀与大颠共千古。\n渡海来为南粤人，五年伤别兼伤春。\n生似昌黎厄磨蝎，终日坎壈缠其身。\n名山幸与名贤遇，留镇山门藉诗句。\n千年重出起衰手，睒睒中天北斗气。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32190,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"叠韵赠林生","author":"丘逢甲","text":"庭院无人燕交舞，手订别风證淮雨。\n渊渊如闻金石语，皋比兀坐形容古。\n君是羲皇以上人，胸中碑板蕴古春。\n侍儿亦作古妆束，翩翩玉立何长身？\n练浦秋风始君遇，一春屡诵惊人句。\n手书直迫瘗鹤铭，上皇山樵饶道气。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32191,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"祝文信国公生日日，得伯瑶风雨中见怀诗答寄，叠前韵 其一","author":"丘逢甲","text":"七忠祠前陈羽舞，闪闪云旗降风雨。\n荒山夜出英灵语，如闻此会足千古。\n谁其尸者狮山人，万里来话琼林春。\n会者齐吴楚闽粤，来祝带血啼鹃身。\n此会惜君未得遇，五日江风阻诗句。\n西台莫唱朱鸟吟，东山尚蟠冷龙气。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32192,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"祝文信国公生日日，得伯瑶风雨中见怀诗答寄，叠前韵 其二","author":"丘逢甲","text":"痴龙兀挟云阵舞，海天十日九风雨。\n脉脉隔江不得语，冒雨寻僧禅趣古。\n何期海上听潮人，心花怒发天地春。\n豪吟杜陵洗兵马，天涯慰我哀时身。\n开缄喜若与君遇，顿释愁怀诵佳句。\n云阴蔽天无斗牛，漫倚楼阑看剑气。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32193,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游白牛岩用前游韵 其一","author":"丘逢甲","text":"云气溟蒙大海南，看山人再访禅庵。\n泉声冷尽高僧锡，满地花香雨一龛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32194,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游白牛岩用前游韵 其二","author":"丘逢甲","text":"万方多难此登楼，眼底云山翠欲流。\n欲吊红棉旧吟客，落花飞絮满江头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32195,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"白牛岩次季平韵","author":"丘逢甲","text":"寺楼悬踞最高层，路转松阴百级升。\n山为出云常作雨，人虽辟佛不嫌僧。\n散花丈室泉声古，落日空江练色澄。\n我自擎天拜柱石，爱他风骨独崚嶒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32196,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"金顶寺赠僧能意二首 其一","author":"丘逢甲","text":"但有名僧山便灵，宝通禅派未凋零。\n诸天花雨蒲团坐，大海潮音贝叶经。\n古寺寻碑金顶冷，空岩说法石头听。\n重来看卓泉边锡，云掩寒关佛火青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32197,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"金顶寺赠僧能意二首 其二","author":"丘逢甲","text":"浴佛才过客此游，禅花开落剧清幽。\n西来劫火遮灵鹫，南下宗风衍白牛。\n文字前因僧有幸，沧桑满眼佛无愁。\n乾坤何处藏吾拙，戎马书生句又留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32198,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游西山海潮岩用前游韵二首 其一","author":"丘逢甲","text":"梅雨初过浴佛天，寺门香拥稻花田。\n七层金碧消砖塔，万里风潮长石泉。\n楼观总含沧海气，江山还属太平年。\n劫尘屡换名僧尽，唤起閒云与话禅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32199,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游西山海潮岩用前游韵二首 其二","author":"丘逢甲","text":"一片斜阳入渺冥，迩来人更访山灵。\n江帆叶叶收前浦，野鸟时时下古亭。\n满院吉祥花气紫，半林连理树阴青。\n归筇如带西来意，风送钟声下界听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32200,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"叠韵答夏季平二首 其一","author":"丘逢甲","text":"旧恨新愁满海天，封侯休说面如田。\n凤饥何计翔千仞，龙蛰真忧到九泉。\n白马潮来悲往事，红羊劫换感流年。\n西山薇蕨无人问，且话莲花六叶禅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32201,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"叠韵答夏季平二首 其二","author":"丘逢甲","text":"寥空双鹤破苍冥，睥睨千秋佛乞灵。\n霸国山川吟粤峤，翰林风月忆柯亭。\n身经忧患先头白，名著文章愧汗青。\n十万军声来夜半，问潮泉畔且同听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32202,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与季平访柳汀，用季平赠僧能意韵","author":"丘逢甲","text":"入室古芳满，庭花连理枝。\n乡音脆吴语，风格拗唐诗。\n远算就时见，深尊劝客持。\n千金载西子，少伯是吾师。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32203,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"叠前韵歔赠柳汀","author":"丘逢甲","text":"冷抱香云卧，骄人花一枝。\n才名高顾怪，音节变吴诗。\n客至家姬出，宵征阃律持。\n城南树精老，唐突化人师。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32204,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与季平、柳汀饮东山酒楼 其一","author":"丘逢甲","text":"岩翠潮光共一楼，江山今日顿风流。\n诸天洗出云雷气，供养群仙坐上头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32205,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与季平、柳汀饮东山酒楼 其二","author":"丘逢甲","text":"六百年中电掣回，东山又见状元来。\n平生心醉文丞相，莫问他人借酒杯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32206,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与季平、柳汀饮东山酒楼 其三","author":"丘逢甲","text":"花气濛濛酒半醺，掀髯休笑故将军。\n谈兵杜牧狂言甚，只向尊前念紫云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32207,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与季平、柳汀饮东山酒楼 其四","author":"丘逢甲","text":"浣花天气雨初晴，也当鳌头宴锦城。\n一片千秋七星石，水帘亭畔看题名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32208,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"东山酒楼次柳汀韵","author":"丘逢甲","text":"第一仙人数宋郊，羊裘更说子陵高。\n天公速客先风雨，山寺开门受海潮。\n游迹待传文上石，边愁无计锈生刀。\n狂吟且共楼头醉，酒虎诗龙各自豪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32209,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"季平为书“澹定村”三大字、并书赠“马来西极、龙卧南阳”二语为楹帖赋谢 其一","author":"丘逢甲","text":"三字千秋澹定村，大书留处万灵尊。\n他年乞与和平里，同證名贤雪爪痕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32210,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"季平为书“澹定村”三大字、并书赠“马来西极、龙卧南阳”二语为楹帖赋谢 其二","author":"丘逢甲","text":"下笔真成千丈强，更将龙卧许南阳。\n何当窥井重炎火，天马西来汉道昌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32211,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨中与季平待柳汀不至，戏寄 其一","author":"丘逢甲","text":"暮雨潇潇客未行，吴娘别后最关情。\n玉关杨柳无消息，惆怅高楼夜笛声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32212,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨中与季平待柳汀不至，戏寄 其二","author":"丘逢甲","text":"东风吹絮点前汀，绿满龙津旧酒亭。\n恼乱儿童无处促，柳花飞去作浮萍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32213,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]