[{"title":"遗园四首 其三","author":"吴敬梓","text":"秋声何日到，残暑去天涯。\n鸦影梭烟树，松阴绘月阶。\n病魔皆故物，诗境落孤怀。\n独倚危楼望，清光聚此斋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":51,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"遗园四首 其四","author":"吴敬梓","text":"风雨漂摇久，柴门挂薜萝。\n青云悲往事，白雪按新歌。\n每念授书志，其如罔极何。\n可怜贫贱日，秪是畏人多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":52,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杂诗","author":"吴敬梓","text":"鸿雁鸣雍雍，白露凄以队。\n大夫用为贽，德与长者配。\n或谓之鴚鹅，南游青春背。\n况乃上虞县，民力遂可废。\n春衔拔草根，秋啄除其秽。\n怅焉忽单飞，孤鸣中肠碎。\n伤彼水中鸠，关关和其喙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":53,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"初夏村居罗锦宣携樽过访赋谢","author":"吴敬梓","text":"风雨弥旬久，晴天一启扉。\n客携樽酒至，惊乱林乌飞。\n刺水秧针瘦，沾人柳汁肥。\n江东老罗隐，明月送将归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":54,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病夜见新月","author":"吴敬梓","text":"一痕蟾光白昼残，空庭有人病未安。\n暮禽辞树疑曙色，影落文窗移琅玕。\n无聊尽日秋声聚，露重罗衣玉骨寒。\n欲攀仙桂问月姊，老兔深藏不死丹。\n仰天长啸夜气发，丝丝鬼雨逼雕阑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":55,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"小桥旅夜","author":"吴敬梓","text":"客路今宵始，茅檐梦不成。\n蟾光云外落，萤火水边明。\n早岁艰危集，穷途涕泪横。\n苍茫去乡国，无事不伤情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":56,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"风雨渡杨子江","author":"吴敬梓","text":"几日秣陵住，扁舟东复东。\n浓云千树合，骤雨一江空。\n往事随流水，吾生类转蓬。\n相逢湖海客，乡语尽难通。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":57,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"残春僧舍","author":"吴敬梓","text":"花落回廊静，钟声丈室过。\n三春青鬓改，一院绿阴多。\n客久无乡梦，愁深有病魔。\n独怜良夜永，明月在藤萝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":58,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"笙","author":"吴敬梓","text":"数声鹅管绛唇乾，拨火金炉夜向阑。\n孺子独生伊洛想，仙娥曾共幔亭看。\n几时天上来青鸟，何处风前听紫鸾。\n最忆澄心堂里曲，小楼细雨十分寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":59,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"琵琶","author":"吴敬梓","text":"凤尾龙香世莫传，半湾逤逻系冰弦。\n雪深六月明妃冢，泪满三更商妇船。\n坐啸竹林差共拟，重登花萼亦堪怜。\n郁轮袍曲非难制，祗是无因上舞筵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":60,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"早春过冶山园亭追悼周羽士","author":"吴敬梓","text":"晴光冉冉过楼台，仄径扪萝破藓苔。\n仙客已归蓬岛去，名园仍向冶城开。\n独怜残雪埋芳草，又见春风绽野梅。\n十载知交存此地，袛今寥落不胜哀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":61,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"绮罗香·湖上闻歌","author":"过春山","text":"旧恨消香，新愁倦酒，寂寞又惊春晚。\n小立斜阳，何处暗飞银管。\n有几许、离绪吟秋，怎知我、天涯肠断。\n莫随风、吹入西泠，为渠唤起故宫怨。\n霓裳遗曲曾谱，怅望青鸾已杳，彩云消散。\n剩粉零红，忍向尊前重见。\n消几度、月淡窗寒，更那堪、梦回人远。\n指青袍、今夜愁痕，倩谁江上浣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":62,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"霓裳中序第一·西泠步月闻琵琶声","author":"过春山","text":"苏堤古月色。\n又照天涯沦落客。\n试逐柳阴暗觅，乍听得、凄凉琵琶声急。\n分明似说。\n问塞鸿、天外消息。\n关山梦、繁华一瞬，忽地送岑寂。\n愁绝。\n青衫曾湿。\n记画舫亭亭，待发江潮，避又呜咽。\n莫唱阳关，伤心三叠。\n荻花风瑟瑟。\n听遍了、啼鹃夜泣。\n空凝伫、曲终人悄，隔岸敷峰碧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":63,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳曲送别沈五遂初","author":"吴敬梓","text":"江南二月春风吹，江边杨柳千万枝。\n行人欲折不忍折，笼烟蘸雨垂绿丝。\n王恭张绪不可见，困酣娇眼如欲啼。\n攀条流涕桓宣武，何不移栽玄武陂。\n昔日幽燕轻薄儿，斫取柔条系斑骓。\n越溪春半如花女，祓褉牵裳怜爱谁。\n羌管声中伤别离，声声寄我长相思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":64,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄怀章裕宗二首 其一","author":"吴敬梓","text":"柳烟花雨记春初，梦断江南半载馀。\n直到东篱黄菊放，故人才寄数行书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":65,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄怀章裕宗二首 其二","author":"吴敬梓","text":"香散荃无梦觉迟，灯花影缀玉虫移。\n分明携手秦淮岸，共唱方回肠断词。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":66,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄李啸村四首 其一","author":"吴敬梓","text":"带雨征鸿过晚天，怀人中酒夜无眠。\n小山丛桂今安在，欲赋淮南招隐篇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":67,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄李啸村四首 其二","author":"吴敬梓","text":"邺侯风骨谪仙狂，白下空台咏凤凰。\n好佩茱萸食蓬饵，菊英满泛九霞觞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":68,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"倦寻芳·过废园见牡丹盛开有感","author":"过春山","text":"絮迷蝶径，苔上莺帘，庭院愁满。\n寂寞春光，还到玉阑干畔。\n怨绿空馀清露泣，倦红欲倩东风涴。\n听枝头、有哀音凄楚，旧巢双燕。\n漫伫立、瑶台路杳，月佩云裳，已成消散。\n独客天涯，心共粉香零乱。\n且尽花前今夕酒，洛阳春色匆匆换。\n待重来，怕只有、断魂千片。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":69,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄李啸村四首 其三","author":"吴敬梓","text":"飘零身世同秋雁，寂莫郊坰狎野宾。\n浪说吴刚能斫桂，无由得见月中人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":70,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄李啸村四首 其四","author":"吴敬梓","text":"修竹千竿酒百樽，华林江左旧名园。\n共君相约年年醉，世上升沈安足论。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":71,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"伤周羽士","author":"吴敬梓","text":"岂是黄金不铸颜，刚风浩劫又吹还。\n月明笙鹤缑山顶，归向蓬莱第几班。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":72,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登周处台同王溯山作","author":"吴敬梓","text":"高台多春风，旭日照彼岨。\n揽袂试登临，怀古遥踟蹰。\n昔者周孝侯，奋身三恶除。\n家本罨画溪，折节此读书。\n古今同一辙，与君皆侨居。\n工愁吴季重，深情王伯舆。\n抗志慕贤达，悠悠千载馀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":73,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春兴八首 其一","author":"吴敬梓","text":"秦淮三月水，芳草绿回汀。\n楼外莺梭啭，窗前渔榜停。\n午烟随处满，卯酒未曾醒。\n花事知何许，柴门竟日扃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":74,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春兴八首 其二","author":"吴敬梓","text":"移居星岁易，为爱白门山。\n遽步连花港，兰舟系柳湾。\n窥檐宾雀去，绕树暮鸦还。\n长昼茶铛沸，耽吟亦解颜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":75,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春兴八首 其三","author":"吴敬梓","text":"失计辞乡土，论文乐友朋。\n为应蓬自直，聊比木从绳。\n挥麈清风聚，开樽皎月澄。\n回思年少日，流浪太无凭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":76,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春兴八首 其四","author":"吴敬梓","text":"但觉黄金贱，其如白璧玼。\n缠头当日价，乞食近年诗。\n顾曲周公瑾，呼卢刘穆之。\n欢场无限事，犹自系相思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":77,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春兴八首 其五","author":"吴敬梓","text":"兴来凭水槛，岂是好楼居。\n耆酒稽中散，窥园董仲舒。\n间情时有作，消渴病难除。\n一事差堪喜，侯门未曳裾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":78,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春兴八首 其六","author":"吴敬梓","text":"小闸通潮信，春风羕碧流。\n玉箫声断续，银蒜影夷犹。\n北里寻商女，南朝问故侯。\n衔泥双燕过，落日水明楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":79,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春兴八首 其七","author":"吴敬梓","text":"近市居原误，无由学灌园。\n诛茅江令宅，蜡屐谢公墩。\n漫画终何益，寒号亦自存。\n每将偕隐意，三复昔人言。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":80,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春兴八首 其八","author":"吴敬梓","text":"积雨朝来霁，垣衣上板桥。\n春光自明媚，客思转萧条。\n柱按鹍弦剧，杯倾鹊脑消。\n残灯高枕夜，梦里故山遥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":81,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"古意","author":"吴敬梓","text":"妾年十四五，自矜颜如花。\n靡容翳鲛绡，腻理覆蝉纱。\n耳珰垂明月，脸晕凝朝霞。\n黄金饰钗纛，碧珠缀鬓鸦。\n褰帷当户坐，皎皎灿天葩。\n麝火博山然，云母屏风遮。\n女师勤针薾，侍婢理筝琶。\n母兄命良媒，交口称柔嘉。\n自缘根本好，那复委泥沙。\n岂知盛年去，空闺自长嗟。\n五陵轻薄儿，纷纷斗骄奢。\n遂言邻女美，弃妾不复誇。\n含羞临晓镜，恐似鸠盘茶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":82,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"冶城春望","author":"吴敬梓","text":"铸剑池临古道旁，忠贞祠墓枕平冈。\n雨馀圆藓生虚壁，风过长松倚坏墙。\n建业三春花事好，句吴千载霸图荒。\n衣冠晋代浑难问，独凭高原空夕阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":83,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过金舅氏五柳园旧居","author":"吴敬梓","text":"红土山前柳色深，几年悽怆在江浔。\n养花天气春寒浅，易主亭台往事沈。\n瘴雨蛮烟悲宦况，蛛丝蜗篆尚庭阴。\n回思赌墅围棋日，寂莫羊昙泪满襟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":84,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"永庆寺","author":"吴敬梓","text":"桃花红映上方时，蜡屐登临有所思。\n昔日主家罗绮盛，祇今佛地绣翻垂。\n拓提夜雨寒茶灶，店舍春烟飏酒旗。\n尽日小楼贪习静，浮屠倒影壁间移。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":85,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过丛霄道院","author":"吴敬梓","text":"铃铎风微静不闻，客来芳径正斜曛。\n烟昏树杪鸦千点，水长陂塘鹭一群。\n幽草绿遥寻古刹，疏窗碧暗哭遗文。\n白头道士重相访，极目满山飞乱云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":86,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"滁州旅思","author":"吴敬梓","text":"晓望诸峰翠色新，雨馀芳草碧如茵。\n春光已过湔裙节，胜地浑无蜡屐人。\n旅病那堪花入梦，暮寒不厌酒沾唇。\n遥思二月秦淮柳，蘸露拖烟委曲尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":87,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九日约同从兄青然登高不至四首 其一","author":"吴敬梓","text":"尽日凭阑有所思，夕阳不见野艇移。\n窗前绿水纹如縠，一夜清霜减旧时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":88,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九日约同从兄青然登高不至四首 其二","author":"吴敬梓","text":"绿橙手擘味清嘉，黄菊枝头渐著花。\n独坐河亭人不到，一帘秋水读南华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":89,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九日约同从兄青然登高不至四首 其三","author":"吴敬梓","text":"吾家才子推灵运，也向秦淮僦舍居。\n故国茱萸从插遍，登高作赋已全虚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":90,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九日约同从兄青然登高不至四首 其四","author":"吴敬梓","text":"寒烟羃历暗长桥，几点渔灯趁晚潮。\n酤得邻家新酿美，半炉麸炭火亲烧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":91,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋病四首 其一","author":"吴敬梓","text":"女兰香细掩窗纱，白袷单衣病里加。\n一缕药烟当水槛，寒蝉声断夕阳斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":92,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋病四首 其二","author":"吴敬梓","text":"素领应随秋气深，却缘消渴罢弹琴。\n美人一赋堪千古，何用子虚与上林。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":93,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋病四首 其三","author":"吴敬梓","text":"当风怕看来宾雁，苦雨愁闻逐妇鸠。\n不是邻家遗潘沐，那能临镜强梳头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":94,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋病四首 其四","author":"吴敬梓","text":"屯贱谁怜虞仲翔，那堪多病卧匡床。\n黄金市骏年来贵，换骨都无海上方。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":95,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"石城晚泊","author":"吴敬梓","text":"落日寒江上，吴舟挂短篷。\n荻花连岸白，烛影傍人红。\n大泽眠鸥鹭，晴天响雁鸿。\n焚香祝奇相，愿借一帆风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":96,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渡江","author":"吴敬梓","text":"呼妇鸠声水一涯，鱼噞犹恐尚风霾。\n痴儿不识波涛险，笑指船如水靸鞋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":97,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望真州","author":"吴敬梓","text":"波光骀荡绿杨湾，渔市人家晒网还。\n日暮危樯依曲港，寒云遮断小帆山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":98,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"访杨东木敷五","author":"吴敬梓","text":"相看铩翮漫歌呼，羡尔龙文与凤雏。\n买棹寒江冰欲合，连床细雨酒频酤。\n回廊自署汤提点，长夜唯消木野狐。\n不是故人施榻待，扁舟风雪又菰芦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":99,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"不寐","author":"吴敬梓","text":"客中眠未稳，漏鼓听愈真。\n月落乌辞树，灯昏鼠近人。\n酒痕渰病肺，诗卷伴间身。\n侧耳棋枰响，因思王积薪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":100,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将往平山堂风雪不果二首 其一","author":"吴敬梓","text":"平山堂畔白云平，文藻偏能系客情。\n不似迷楼罗绮尽，祇今惟有暮鸦声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":101,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将往平山堂风雪不果二首 其二","author":"吴敬梓","text":"空怀迁客擅才华，不见雕阑共绛纱。\n却忆故山风雪里，摧残手植老梅花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":102,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"月","author":"吴敬梓","text":"二分明月好，深夜自光辉。\n玉兔臼常满，金猊香渐微。\n车放寒荐酒，橘柚晚侵衣。\n遥念青溪口，凭阑盼我归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":103,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赋得秘殿崔嵬拂綵霓督院取博学鸿词试帖","author":"吴敬梓","text":"长乐钟声启，天门羽仗齐。\n深宫开户牖，秘殿俨榱题。\n瑞霭螭头丽，香烟鸱吻迷。\n芝房含旭日，藻并映晴霓。\n枫陛多鸣玉，彤廷半执圭。\n银青来复道，金紫向沙堤。\n但觉层霄近，还疑弱木低。\n红梁才语燕，绛帻又鸣鸡。\n采色辉珠箔，华光映锦绨。\n喈喈娇鸟唤，恰恰晓莺啼。\n率舞兽咸拜，联班马正嘶。\n几多词赋客，通籍在金闺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":104,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赋得云近蓬莱常五色抚院取博学鸿词试帖","author":"吴敬梓","text":"龙楼朝日丽，凤阁瑞云翔。\n肤寸看初合，觚棱倏已光。\n氤氲含綵仗，叆叇映旂常。\n白鹤春风满，轻鳞淑景长。\n纪官宜殿陛，为雨润农桑。\n五色兼三色，千秋捧圣皇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":105,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赋得敦俗劝农桑学院取博学鸿词试帖","author":"吴敬梓","text":"淑景尧封丽，仁恩禹甸长。\n辛勤看士女，劝祼重农桑。\n绿野春如绣，青郊草正芳。\n畻边挥黛耜，陌上执懿筐。\n兰泽高低遍，蘋花远近香。\n和风来密树，甘雨溢方塘。\n戴胜飞何急，仓庚语转忙。\n定将收茧税，纻待莠苞稂。\n喜见趋耕织，欣瞻裕盖藏。\n豳诗堪入咏，朋酒祝无疆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":106,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题王溯山左茅右蒋图","author":"吴敬梓","text":"平生我爱王摩诘，辋川图画妙入神。\n箧藏此图三十载，晴窗拂拭无纤尘。\n有时酌酒与裴迪，花枝草色眼中新。\n浮云富贵非所好，爱山成癖乐其真。\n披图沈吟仍怏怏，辋川野色平于掌。\n那似江南烟水区，丹青紫翠多骀荡。\n嵚崟埼礒仍硱磳，崔嵬历陵人观仰。\n白门佳丽古所称，谁其峙者茅与蒋。\n几年卜筑板桥住，秦淮水色钟山树。\n木兰舟内急觞飞，杨柳楼边歌板度。\n著书仰屋差自娱，无端拟献金门赋。\n授简曾传幕府招，蜡言栀貌还枝梧。\n秋风襆被返白门，窗外寒潮退旧痕。\n咄嗟独凭阑干立，长者叩户笑言温。\n手持绝妙倪迂画，画出逍遥庄叟园。\n短松少鹤相随久，修竹啼莺古意存。\n两山翠色烟云绕，中有草堂深窈窕。\n书卷应堪比邺侯，樵苏时复思庄蹻。\n几棱欣看远近田，一条寒玉溪光晓。\n春秋佳日快登临，高怀那许尘容扰。\n雅志高怀见此贤，何须服食求神仙。\n兰台家世千秋重，艺苑文章四海传。\n祗此蓬瀛共瑶岛，休言绿野与平泉。\n便拟将身入图画，不羡王维居辋川。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":107,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寒夜坐月示草衣二首 其一","author":"吴敬梓","text":"今夜霜中月，依然照独吟。\n短檐窥野马，曲木碍归禽。\n但觉情怀减，其如岁序侵。\n邻家歌舞宴，彻晓恼人心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":108,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寒夜坐月示草衣二首 其二","author":"吴敬梓","text":"忽念朱居士，耽吟夜撚髭。\n篆烟萦画障，漏水咽铜蠡。\n蠹木虫何苦，钻窗蜂太痴。\n何当一樽酒，斟酌月明时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":109,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雪夜怀王溯山山居二十韵","author":"吴敬梓","text":"十日不相见，相思契转深。\n端忧多雪霰，怅望好园林。\n钟阜浓于染，茅山翠欲沈。\n垂缯看凛烈，磐石积顽阴。\n马猬严威集，鸦翎宿雾侵。\n湿苔封薜户，空穴送霜砧。\n织楚门将塞，诛茅路可寻。\n田家新酿酒，土室且孤斟。\n肘后堆青简，床头枕素琴。\n定须摛寸管，讵肯恋重衾。\n红树酣荒店，黄花辞故岑。\n玉虫寒闪闪，金虎夜愔愔。\n凤尾松堪宝，龙丝竹似针。\n天怀原澹泊，风物任萧森。\n不独常披翰，还宜爱盍簪。\n扁舟良友聚，施榻故人心。\n絮语同挥麈，摊书共识蟫。\n欢娱良不易，离别感难禁。\n皲瘃撚髭苦，凌兢拥鼻吟。\n言归在何日，乞我辟寒金。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":110,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丙辰除夕述怀","author":"吴敬梓","text":"岁序倏云暮，群动日以迫。\n青帝将乘权，玄冥又如客。\n寄居秦淮上，五载星霜易。\n令节空坐愁，北风吹窗隙。\n霸子俱跳荡，莱妻只羸瘠。\n商陆火添红，屠苏酒浮碧。\n唯有虎宜画，那无鸡可磔。\n指囷复何人，助予呼将伯。\n堪笑谢仁祖，转向修龄索。\n入夜醉司命，陈辞多自责。\n回思一年事，栖栖为形役。\n相如封禅书，仲舒天人策。\n夫何采薪忧，遽为连茹阨。\n人生不得意，万事皆愬愬。\n有如在网罗，无由振羽翮。\n严霜覆我檐，木介声槭槭。\n短歌与长叹，搔首以终夕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":111,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"元夕雪","author":"吴敬梓","text":"元夕三更后，雪花飞满天。\n全无明月影，空有夜灯悬。\n词赋梁园客，肌肤姑射仙。\n何人金殿侧，簪笔祝丰年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":112,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]