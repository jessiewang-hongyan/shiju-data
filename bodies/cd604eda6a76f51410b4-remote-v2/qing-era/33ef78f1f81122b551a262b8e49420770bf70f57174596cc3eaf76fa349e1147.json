[{"title":"楚云","author":"孙原湘","text":"楚云飞破洞庭秋，应是神娥夜出游。\n乐府定誇三妇艳，仙家犹带一生愁。\n眉如翠羽天难学，手解明珠水共流。\n肠自九回湘九曲，通辞何处托横眸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40057,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题周防背面美人图 其一","author":"孙原湘","text":"惊鸿瞥见又逡巡，珠压腰裾稳称身。\n绝似簸钱堂上事，忍羞和笑避生人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40058,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题周防背面美人图 其二","author":"孙原湘","text":"小朵樱桃折得不，无人窥见绿蛾愁。\n玉阶唤杀红鹦鹉，不是欢来不转头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40059,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题周防背面美人图 其三","author":"孙原湘","text":"脸波藏却媚霞痕，只露双肩削玉温。\n心自向君身自背，省他一见一消魂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40060,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题周防背面美人图 其四","author":"孙原湘","text":"只量钿尺认腰支，那有春风见面时。\n会得李夫人意态，背人翻是耐人思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40061,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题周防背面美人图 其五","author":"孙原湘","text":"妙句青邱最有情，倾城虽见画难成。\n诗人设想还痴绝，要看回头百媚生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40062,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题周防背面美人图 其六","author":"孙原湘","text":"不用传神阿堵中，画师妙手只空空。\n累他多少旁观眼，相背人人学蒯通。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40063,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题周防背面美人图 其七","author":"孙原湘","text":"几时回首眼波横，枉费千呼万唤声。\n画里未容人省识，如何妄想作刘桢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40064,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"新年纪别","author":"孙原湘","text":"梅花如雪冻檐阴，阁住斜阳不肯沉。\n颜为避人温似玉，语因惜别重于金。\n莫云未定缘离合，春水难知分浅深。\n坐久翻催君速去，带香和笑已沾襟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40065,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"有寄","author":"孙原湘","text":"苦被东风柳色催，红窗辜负玉梅开。\n相思寄与清淮水，流到长江莫打回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40066,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"生辰日 其一","author":"孙原湘","text":"卖冰声唤小窗眠，梦想江南远似天。\n记得年年今日事，并头花下拜双仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40067,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"生辰日 其二","author":"孙原湘","text":"鸥波仙馆即莲台，绣佛炉香煖不灰。\n应有兜罗绵样手，笑持荷叶捧觞来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40068,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"生辰日 其三","author":"孙原湘","text":"小阮风情记我家，与君同日好年华。\n而今憔悴相如病，辜负芙蓉脸际花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40069,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"生辰日 其四","author":"孙原湘","text":"更有参军小妹清，藕花生日一齐生。\n无端吹折同心蒂，零落红衣画不成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40070,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"写梅寄个人 其一","author":"孙原湘","text":"画梅多画影姗姗，一动萧疏耐远看。\n我道至情须领会，疏时容易密时难。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40071,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"写梅寄个人 其二","author":"孙原湘","text":"澹著胭脂澹扫螺，亭亭瘦影照横波。\n由来绝色人难画，只画梅花便当他。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40072,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"写梅寄个人 其三","author":"孙原湘","text":"也知眼孔小于纱，守定西溪当若耶。\n天上纵然花绝代，老逋只解爱梅花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40073,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"写梅寄个人 其四","author":"孙原湘","text":"平生空说爱南枝，一岁相逢得几时。\n自拂银笺写来看，胜如閒坐苦相思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40074,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读史","author":"孙原湘","text":"心头眼底一真真，料得人间定绝伦。\n读尽史书佳丽传，何人如我意中人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40075,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自题横霞仙馆 其一","author":"孙原湘","text":"万树梅花水一村，春山如梦月如魂。\n只消一角横波翠，阑住诗人不出门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40076,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自题横霞仙馆 其二","author":"孙原湘","text":"四禅天上住人家，手札青鸾扫落花。\n收拾红香到仙枕，一去同梦是朝霞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40077,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"深恩四首 其一","author":"孙原湘","text":"一绺轻云落剪香，缄题和泪报王昌。\n并头私愿知难遂，束发深情誓莫忘。\n绾住同心须不乱，祝将恩分愈加长。\n从今添入潘郎鬓，胜捧仙鬟嗅枕旁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40078,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"深恩四首 其二","author":"孙原湘","text":"画帘鹦鹉语呼茶，天女亲擎一朵霞。\n味美那滑添茗叶，香清浑似带梅花。\n早知郎性凉须忌，不避人嫌爱越加。\n我却贪痴还未足，比卿芳乳略差些。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40079,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"深恩四首 其三","author":"孙原湘","text":"玉壶春色比花妍，纤手亲斟与谪仙。\n情到十分如酒满，缘徵百岁似杯圆。\n为卿拚死何辞醉，知我沉酣屡劝眠。\n馀沥互搀莲子盏，分明合卺绣床前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40080,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"深恩四首 其四","author":"孙原湘","text":"百花谁似玉梅妍，动是飞仙静益仙。\n绝色惊看天不老，同心痴望月常圆。\n三年尽受回眸爱，一夕曾邀恣意怜。\n素女若容缘再续，今宵双拜桂花前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40081,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"仲冬十一日纪事","author":"孙原湘","text":"红入双腮四体酥，绣帏沉醉不胜扶。\n玉郎悄地潜踪到，细看杨妃美睡图。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40082,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"绝世 其一","author":"孙原湘","text":"意态浓纤世所稀，梅花嫌瘦海棠肥。\n媚生一笑能苏病，秀出双眸可疗饥。\n发美尽人分作剃，肌香从小罢熏衣。\n卫风借作卿图影，才得形相欠入微。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40083,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"绝世 其二","author":"孙原湘","text":"闲房左右寂无人，偷齧樱桃一点春。\n事后思量犹错过，忙中惊颤已逡巡。\n防闲暗许鞋尖觉，偎傍遥贪袖角亲。\n十五年前常意态，消魂此日胜尝新。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40084,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"密字 其一","author":"孙原湘","text":"密字珍珠侧理裁，问郎何处恣徘徊。\n终年细数无多见，隔日幽期不定来。\n凤响误猜搴绣箔，花阴闲看过妆台。\n芳心一寸芸香瓣，炉篆成灰未肯灰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40085,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"密字 其二","author":"孙原湘","text":"日来憔悴瘦腰身，兰语当窗嘱付谆。\n随意清游聊遣闷，韬精沉饮恐伤神。\n蔗梢细嚼终无味，桃核双欢别有仁。\n每到花丛须记忆，东风岑寂倚楼人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40086,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"个人 其一","author":"孙原湘","text":"个人第一是青丝，委地春云挽髻迟。\n记得刺桐花下等，水晶帘外日斜时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40087,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"个人 其二","author":"孙原湘","text":"个人第一是双蛾，澹扫春山不费螺。\n自识玉郎心事重，展时偏少蹙时多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40088,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"个人 其三","author":"孙原湘","text":"个人第一是星眸，载得聪明又载愁。\n只许消魂人自觉，暗传心事不抬头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40089,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"个人 其四","author":"孙原湘","text":"个人第一是双腮，酒晕微涡笑靥堆。\n一缕睡情支不住，红云飞上限梢来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40090,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"个人 其五","author":"孙原湘","text":"个人第一是朱樱，匿笑搴帷皓齿呈。\n翻道诗人莲舌好，愿通花气过聪明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40091,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"个人 其六","author":"孙原湘","text":"个人第一是兰胸，菽发凝脂隐约中。\n一抹红褂严结束，却逢郎手自通融。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40092,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"个人 其七","author":"孙原湘","text":"个人第一是春纤，亲替檀奴熨指尖。\n丁嘱避嫌心事切，人前卮酒莫同拈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40093,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"个人 其八","author":"孙原湘","text":"个人第一是双莲，风韵行来步步妍。\n可记暗中金钿落，绣鞋香气泊人肩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40094,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"灯夕即事","author":"孙原湘","text":"千枝灯火一枝花，十二瑶台耸翠霞。\n仙去偏愁郎有伴，月来如梦姊为家。\n微闻人语疑清瑟，近隔天河只片纱。\n应被市中吹笛者，遥占珠斗贯浮槎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40095,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蓄兰一本数年始得花","author":"孙原湘","text":"几年珍重护春寒，一箭才逢白玉阑。\n静色能消粗气味，异香不是古旃檀。\n半生心力全抛与，万事艰难倍可欢。\n真到眼前偏认作，画中看又梦中看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40096,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"娇女","author":"孙原湘","text":"左思娇女似娇禽，来道胜常送好音。\n书是宣文亲口授，花令小玉上头簪。\n学分绣线宜纤手，解辨琴弦有慧心。\n一点樱唇留墨在，曹娥碑字甫抚临。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40097,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"品花","author":"孙原湘","text":"花里三倾国，梅兰及海棠。\n可餐皆秀色，不断是生香。\n春思依依梦，秋阴寸寸肠。\n何时满人意，都植在潇湘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40098,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"花朝","author":"孙原湘","text":"碧云特地破新晴，小阁玲珑即玉京。\n花影尽如人窈窕，语香多将佛聪明。\n思量过此春非浅，欢喜来时病亦轻。\n脩到群芳缘恰好，不同开日却同生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40099,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寒宵纪梦仿会真体","author":"孙原湘","text":"青粉墙高接半天，黄昏风紧月娟娟。\n斜门寂静推敲细，曲巷阴沉伺守坚。\n乍听钟声空外动，忽惊人语暗中传。\n朱唇微嗽来屏角，纤指轻弹近阁边。\n预启间窗教侧足，偷开秘钥许容肩。\n中途几被监奴觉，内院才闻采伴眠。\n入户衣裳防綷縩，牵帏步屧屡蹁跹。\n卸颐别绾珑松髻，熏被犹馀叆叇烟。\n展侧冰肌如水滑，偎依粉颊比花妍。\n一弯雪臂玲珑藕，三寸红帮窄小莲。\n脂熟樱桃鹦饱啄，香披豆蔻蝶深穿。\n流苏悄击银钩宕，密炷潜吹宝鼎然。\n眼媚横流微腼觍，唤声低彻恣缠绵。\n当胸袜绣堆茵软，衔耳环铛堕枕偏。\n惊颤芙蓉承露重，狂飞柳絮逞风颠。\n幽欢放胆终虚怯，浓笑回身忽涕涟。\n长恨赤绳愆夙分，自嫌锦瑟过华年。\n鸳囚难卜重逢日，鱼媵甘图再世缘。\n可奈晨鸡先促迫，尚贪宿鲽暂流连。\n钗分紫玉酬深爱，裯拥青绫耐细怜。\n剪发早申偕老愿，抽毫索记定情篇。\n前游历历明于镜，回忆茫茫坠似钿。\n姑射神妃原幻梦，维摩天女本空禅。\n觉来襟袖沾霞气，赢得人呼是谪仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40100,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"深恩","author":"孙原湘","text":"手缄瑶札报知音，昨夜云窝昨夜衾。\n蝶梦正酣香万顷，鸡声偏断刻千金。\n花缘露重翻含泪，烛为风流尽吐心。\n自把深恩酬至爱，如何转说受恩深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40101,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续美人诗二首前首续上二句后首续下二句凫胫接鹤狗尾续貂两美同心并蒙印可 其一","author":"孙原湘","text":"浴罢轻衫出洞房，寻寻觅觅费思量。\n梧桐月色炎如昼，忆著郎来便觉凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40102,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"续美人诗二首前首续上二句后首续下二句凫胫接鹤狗尾续貂两美同心并蒙印可 其二","author":"孙原湘","text":"手搴芍药坐凝思，地久天长在后时。\n只写灵飞经数字，无人知道定情诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40103,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"瑶窗","author":"孙原湘","text":"羊灯未上月如丝，偷出中门步屧迟。\n拂槛衣声疑竹韵，窥窗鬓影误花枝。\n乍尝险味情逾怯，强定惊魂力不支。\n踪迹怕人猜料著，暗中归去朗吟诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40104,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"把酒祝东风辞","author":"孙原湘","text":"龙盘镜子凤头鞋，屡卜幽期总不谐。\n七泽三湘途易阻，六张五角事多乖。\n花如可折难抬手，月岂能探却堕怀。\n只种相思无结实，东风相祝酒如淮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40105,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"淑意","author":"孙原湘","text":"人前苦嘱莫留情，无奈情深态越轻。\n踪影已离君座远，眼光偏注妾边明。\n廋辞纵许同心会，羞晕难防两颊呈。\n非是恩浓情转淡，可知妒眼绕如城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40106,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"满愿","author":"孙原湘","text":"双峰雪映日华妍，八尺龙须乍起眠。\n甘后有心呈煖玉，杨妃无力出温泉。\n低容不作娇羞避，缓语翻教恣意怜。\n若使小家拘束态，定因匆遽失天然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40107,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病暗","author":"孙原湘","text":"扶定寒香冉冉来，轻云纤月共徘徊。\n罢妆风韵全关慧，郁性温柔别是才。\n微露隐肠知我解，频支倦态厌人猜。\n相看一种悲愁味，画尽宣炉寸寸灰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40108,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天水","author":"孙原湘","text":"如天仪度水年华，天水由来是外家。\n百病尽捐霜后箨，三生自忏雨中花。\n琼楼写韵人谁到，玉尺量才事可誇。\n笑我会稽王内史，十年弟子隔屏纱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40109,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书梅寄情人 其一","author":"孙原湘","text":"人间难画是相思，只画瑶台绝世姿。\n脩到他生须记得，谢娘庭院雪来时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40110,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书梅寄情人 其二","author":"孙原湘","text":"玉姿清瘦不禁风，缟袂依稀薄雾笼。\n记得小红阑角事，满身香雪月明中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40111,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书梅寄情人 其三","author":"孙原湘","text":"青粉墙高欲度难，暂将绿萼当珊珊。\n灯前写幅横斜影，贴上屏风恣意看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40112,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书梅寄情人 其四","author":"孙原湘","text":"毕竟天姿画不成，拈毫心事更纵横。\n明知卿貌花难替，只要卿知我画卿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40113,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"紫云楼话月 其一","author":"孙原湘","text":"三生石碎四禅空，情梦重温雪上鸿。\n贪傍一株红豆树，不知清露湿怀中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40114,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"紫云楼话月 其二","author":"孙原湘","text":"樱桃小火鸭炉温，帘影条条落水痕。\n楼下月明楼上语，人生能得几黄昏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40115,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"紫云楼话月 其三","author":"孙原湘","text":"灯昏月瘦已三更，听尽潇湘雁过声。\n修作他生真姊弟，相怜未必似今生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40116,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠别辞","author":"孙原湘","text":"寄语琼楼仙子知，寒潮已放舻双枝。\n重看正恐添惆怅，径去翻教省别离。\n纵忆娇儿须强饭，便逢佳客少题诗。\n留将不坏娑椤果，会有华严再见时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40117,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闲情","author":"孙原湘","text":"走马寻春得得忙，嫣红姹紫尽芬芳。\n归来静对寒梅嗅，始觉閒花带草香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40118,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"口佗生 其一","author":"孙原湘","text":"一寸相思一寸笺，真珠密字泪珠穿。\n侯门空守黄昏约，仙洞难期碧落缘。\n锦帨尚愁厖欲吠，银桥那有鹊能填。\n留将玉洁冰清体，好作来生并蒂莲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40119,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"口佗生 其二","author":"孙原湘","text":"一纸情书订夙因，妙莲香里證明神。\n姻缘注定他生簿，才貌脩如见在身。\n说到死期心转快，记来前世事须真。\n风轮小劫随飘堕，佳耦先逢绝代人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40120,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潇湘楼杂忆 其一","author":"孙原湘","text":"湘帘跨出尚逡巡，要使郎看要避人。\n立近小红窗一角，半容娇眼半遮身。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40121,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潇湘楼杂忆 其二","author":"孙原湘","text":"闻郎声息画楼过，偷露梨花半面多。\n莫恨全身看未足，情辞都已在微波。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40122,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潇湘楼杂忆 其三","author":"孙原湘","text":"扇囊宠赐九天霞，上绣莲兰两种葩。\n不独爱他高品格，花中此是并头花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40123,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潇湘楼杂忆 其四","author":"孙原湘","text":"碧瓯亲自捣云浆，暗度华池玉液香。\n口口愿郎都吸尽，莫留点滴与人尝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40124,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潇湘楼杂忆 其五","author":"孙原湘","text":"银湾渺渺隔云端，谁道恩波天样宽。\n膏露暗施花叶上，不留痕迹教人看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40125,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潇湘楼杂忆 其六","author":"孙原湘","text":"公然青鸟下蓬瀛，瞒过双鬟与长卿。\n才算聪明真绝世，别无一字自分明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":40126,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]