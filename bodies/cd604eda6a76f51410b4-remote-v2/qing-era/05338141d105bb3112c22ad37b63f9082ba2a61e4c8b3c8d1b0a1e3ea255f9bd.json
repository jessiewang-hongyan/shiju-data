[{"title":"七夕妙高台坐月","author":"余京","text":"今夕天风爽，吹余到十洲。\n瑶台孤岛夜，银汉半轮秋。\n潮响龙移窟，江明鹊起楼。\n凭栏星斗近，指点说牵牛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":28997,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"白沙王翁百岁","author":"余京","text":"住世凭何术，遥遥到百年。\n数君强仕日，还在乱离前。\n地老千头橘，囊存万历钱。\n儿孙满阡陌，都种白沙田。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":28998,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"中秋月蚀","author":"余京","text":"秋半蟾光彻底清，妖蟆残夜蓦然生。\n匣开尘土蒙金镜，盘弄泥丸污水晶。\n自满定知多外侮，处高原忌太分明。\n广寒宫阙愁昏黑，斟酌姮娥秉烛行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":28999,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"八月十三","author":"余京","text":"月出双峰敛暮岚，临流久坐借僧庵。\n澄清银汉露涓滴，浩荡碧波帆两三。\n龙戏夜珠藏海底，雁随秋气落江南。\n惠休有句通禅味，金粟香中好共参。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29000,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"暮春同吴门沈归愚登蒜山憩清宁道院三首 其一","author":"余京","text":"老去攀跻兴尚存，蹒跚陪客蹑云根。\n天晴烟树分瓜步，春涨波涛拓海门。\n野马絪缦频过眼，沙虫变灭几招魂。\n乱藤荒草山前路，铁骑曾经十万屯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29001,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"暮春同吴门沈归愚登蒜山憩清宁道院三首 其二","author":"余京","text":"藉草峰巅片刻留，旷观身世叹蜉蝣。\n残年岁月双筇杖，吾党乾坤一钓舟。\n夜雨苔痕山径滑，夕阳松影石坛幽。\n劳生多病惟谋药，丹鼎犹存五料不？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29002,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"暮春同吴门沈归愚登蒜山憩清宁道院三首 其三","author":"余京","text":"云房杯酒坐闲身，白首相知感慨新。\n庑下梁鸿谁共语，楼头王粲尚依人。\n青山有梦常为客，黄鸟无言自送春。\n归舫吴门樱笋熟，柳花风起石湖滨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29003,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"焦山山门外坐月","author":"余京","text":"临江席地坐黄昏，入夜微吟冷客魂。\n皓月出云旋堕水，青山隔岸正当门。\n金蛇搅浪光难定，巨象乘潮势欲奔。\n万里碧天沧海阔，何人骑鹤上昆仑？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29004,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"飞蛾","author":"秦应阳","text":"飞蛾性趋炎，见火不见我。\n愤然自投掷，以我畀炎火。\n动静自有常，躁急适贾祸。\n明发天宇空，飞跃无不可。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29005,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"普安道中","author":"徐翔鹍","text":"暮色萧条岁欲阑，长途犹自赴征鞍。\n横穿峻岭几千丈，直下危峰数十盘。\n古树夕阳鸦影瘦，乱山残雪马蹄寒。\n风尘满眼愁无奈，始叹当年蜀道难。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29006,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"横江词","author":"叶肇梓","text":"人道横江恶，侬道横江好。\n不是浪如山，郎船去已早。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29007,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"牧牛词","author":"叶肇梓","text":"黑牯力衰行每迟，白犊奔突饮清池。\n东冈西陇随力去，牛饥只向草多处。\n深山牧牛岁月长，系牛小树今枯桑。\n牛食牛眠适牛意，闲来敲石作儿戏。\n太平牧牛有馀乐，不用将书挂牛角。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29008,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"集归去来辞字为诗追次坡公韵三首 其一","author":"叶肇梓","text":"涉世知无策，还乡路可寻。\n孤行聊自善，万感复何心。\n云岫遥扶杖，风泉远入琴。\n东皋清绝径，容易得登临。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29009,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"集归去来辞字为诗追次坡公韵三首 其二","author":"叶肇梓","text":"富贵求焉得，耘耔乐有期。\n归与无不可，行矣欲何之？\n独酌向庭菊，孤怀寄赋诗。\n息交聊自远，畴复是心知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29010,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"集归去来辞字为诗追次坡公韵三首 其三","author":"叶肇梓","text":"不悟今时是，安知昨日非。\n泉飞还入壑，云化复成衣。\n引酒寄情远，抚琴得趣微。\n晨窗观去鸟，日尽自归飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29011,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"项王","author":"汪绍焻","text":"骓马虞兮可奈何，汉军四面楚人歌。\n乌江耻学鸿门遁，亭长无劳劝渡河。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29012,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"刘伯伦","author":"汪绍焻","text":"生死穷通付醁醽，妇言虽好不须听。\n利名役役真成醉，只有先生是独醒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29013,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"舞剑篇与陆方义","author":"邵锡荣","text":"我尝高咏古人《古剑篇》，我欲起舞追飞仙。\n古来剑解七十二，惜哉后世无人传。\n陆生陆生尔且前，我今试舞双龙泉。\n长兵短接须精练，雌雄闪烁落银霰。\n万人力敌莫可当，顷刻风云看百变。\n忽徐忽疾疑旋蛟，忽连忽断惊飞雁。\n耸跃星流身不见。\n雨打梨花团雪片。\n陆生此时睹之惊绝神，且愿执鞭追后尘。\n慎勿轻携此剑渡江海，只恐双飞出匣归延津。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29014,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"席上咏物分得橘","author":"钱锦城","text":"丹实离离间碧林，千头声价重南金。\n逾淮若改平生质，孤负当年作颂心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29015,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"松陵道中","author":"许心扆","text":"寒雨洒孤城，秋声满丛薄。\n乌啼枫树间，江空闻叶落。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29016,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"孙若望谢珙县归过访话旧有感","author":"戴鉴","text":"剑阁连云入梦劳，十年重见意萧骚。\n破巢似我空三匝，愁鬓看君有二毛。\n不负家风存旧笏，得归宦海息惊涛。\n通门老友无多在，往事闲追首漫搔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29017,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"岁晚入都途中杂咏","author":"戴鉴","text":"迢迢古道客栖栖，风卷黄沙落日低。\n岂是此身同代马，年年只向北风嘶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29018,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"丹阳月夜","author":"王肇","text":"辞家未云迈，愁思如春长。\n谁能见明月，而不念故乡？\n舟子掩篷卧，露下凝清霜。\n出我瓮中酒，斟酌此清光。\n忽闻高楼笛，一曲何悠扬！\n飞音过水来，缭绕清川旁。\n仿佛《折柳曲》，使我中情伤。\n明发又移棹，回首天苍茫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29019,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"闲居","author":"王琛","text":"佳兴在春日，暄风吹敝庐。\n山妻具粗饭，稚子撷野蔬。\n欢然适口腹，俭岁如积储。\n淡泊气乃充，无求养我愚。\n小庭何所有，花竹交扶疏。\n闲中送余目，归云与鸟俱。\n此生苟自适，焉知岁月徂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29020,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"桂之树","author":"萧赵琰","text":"桂之树，托根君之墀。\n大火当昏，郁郁离离。\n桂之树，结叶叶，交枝枝，中有丹心君不知。\n君不知，含情直待秋风吹。\n秋风吹，君知之。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29021,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"溪桥候月","author":"萧赵琰","text":"候月荆溪口，初凉桥上生。\n星辰秋在水，河汉夜无声。\n农火归残巷，渔家话浅更。\n兴来忘所待，人影欲同行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29022,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过净梵寺吊周瑜城","author":"萧赵琰","text":"松涛听不尽，铁马去何之？\n只有僧归寺，更无人守陴。\n乱莺公瑾曲，远岫小乔眉。\n多少徘徊意，春风解缆时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29023,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题雪庄和尚小照","author":"汪天与","text":"雪庄开士居云舫，三十馀年不下山。\n何事尘缘消未尽，尚留面目在人间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29024,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过虎村上芙蓉岭","author":"吴瞻泰","text":"山深异气候，四月正流澌。\n冰有夏虫识，花无春鸟知。\n村寒烟不起，径险杖难支。\n一线开天窦，芙蓉更擅奇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29025,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"宿松谷庵听瀑","author":"吴瞻泰","text":"向晚投松谷，青苍夹洞门。\n沙流侵客屐，笋迸出云根。\n冻雀千林静，飞涛万壑奔。\n一宵疑聚雨，起坐见朝暾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29026,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自题莲花峰顶试泉图","author":"吴瞻泰","text":"万仞青莲上，梯云为试泉。\n谁将一勺水，引上九层天。\n气带流霞色，香无下界烟。\n《茶经》曾品未，兴发自吾先。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29027,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送洪去芜入黄山度岁","author":"吴瞻泰","text":"怪尔冲寒入杳冥，一筇万里破空青。\n雷奔石底晴看雨，人在空中夜摘星。\n喜就湿泉除宿垢，懒将仙荚问山灵。\n鼎湖龙去留丹灶，元日朝参紫玉屏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29028,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"七夕","author":"汪衡","text":"明河漾金波，令节双星渡。\n那堪一岁愁，尽向经宵诉。\n东方色荧荧，离情复如故。\n犹胜远游人，空闺泣朝暮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29029,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渔灯","author":"汪衡","text":"月落空江露气浮，芦花深处宿渔舟。\n寒灯映水繁星乱，夜半潮回带影流。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29030,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"励志诗 其一","author":"计元坊","text":"青青园中林，并望成嘉树。\n或者干云霄，或者苦颠仆。\n岂真托根殊，亦异灌溉故。\n人力不滋培，栋梁安得具。\n而何蚩蚩氓，荣落委天数！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29031,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"励志诗 其二","author":"计元坊","text":"士人乏奇才，动辄咎贫贱。\n岂处贫贱中，抱负遂难见？\n曲逆方宰肉，一乡已称善。\n诸葛当躬耕，三分定佐汉。\n内反无足凭，气馁徒炫乱。\n不见玉韫山，与石自有辨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29032,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"励志诗 其三","author":"计元坊","text":"鸩毒惟晏安，古人戒自适。\n所以陶士行，运甓日累百。\n破贼石头下，精勤由素积。\n奈何卑栖士，嗜懒如有癖。\n志为气之帅，志锐气自役。\n原师闻鸡入，无蹈嵇阮迹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29033,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"述兴","author":"计元坊","text":"人方危苦时，薄施辄感德。\n自昔奸雄辈，持此罗上客。\n蔡邕依董卓，有才而无识。\n受恩旋杀身，士贵能挺特。\n所以孟夫子，餔醊戒乐克。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29034,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"诸子会课","author":"徐志岩","text":"刘协论《文心》，陆机作《文赋》。\n何如对圣贤，孔乐颜可铸。\n谁云制义作，苟且敷章句。\n精理抉天人，宋儒可沿溯。\n春风吹衡门，草堂开艺圃。\n橐笔集生徒，齐侍先生屦。\n授简复拈题，一一申毫素。\n周情与孔思，静中许良悟。\n或疾如涌泉，或迟若窘步。\n中正期徐臻，狙诈愿屏除。\n述古有馀欢，偭规良足惧。\n伫闻正始音，云山有韶頀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29035,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蒙浬","author":"徐志岩","text":"滩卷千堆雪，山藏一线天。\n当秋茅瘴合，亭午旭光偏。\n怪鸟啼深树，孤猿啸冷烟。\n平生仗忠信，不怯下泷船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29036,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"谒张文献祠","author":"徐志岩","text":"曲江风度远流徽，姚宋同心日并晖。\n《金鉴》果能陈黼座，玉环何事系罗衣。\n贬官荆楚缘持正，遣祭丘坟为见机。\n古庙肃瞻松柏下，蔼然遗象见依俙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29037,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"闻鹧鸪","author":"徐志岩","text":"游子天涯生计非，遥山如黛日相依。\n忽听格磔钩辀语，触拨归心泪满衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29038,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秦淮秋柳二首 其一","author":"汪煚","text":"内桥南去水平芜，处处秋烟似画图。\n惆怅千丝残照里，不堪重问旧栖乌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29039,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秦淮秋柳二首 其二","author":"汪煚","text":"拂地西风起白门，几枝寒碧衬烟痕。\n不知何处吹横笛，漠漠江抽乌夜村。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29040,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"静夜吟","author":"许玑","text":"霜林月逾白，满径横藻荇。\n万籁总无声，大地此时静。\n心迹两寂寞，尘杂不须屏。\n檐前星已稀，池畔鹤初警。\n独往亦独回，自顾形神影。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29041,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"答友问","author":"许玑","text":"友人问我山居乐，第一读书松竹林。\n世上万缘都不到，时时证入圣贤心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29042,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赠友园居 其一","author":"钱嵩期","text":"风物翛然在竹林，颠毛未许晓霜侵。\n已忘胜负还看弈，为薄才华欲废吟。\n说剑碎琴年少气，种松爱菊岁寒心。\n公孙荐达非吾事，肯使红尘点素襟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29043,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赠友园居 其二","author":"钱嵩期","text":"徙宅还同鸟易柯，闲园望里足烟萝。\n青藤白袷时还往，张丈殷兄共啸歌。\n野狖窥人来渐熟，山云湿径扫偏多。\n期君采药铜官路，曳杖携筐入涧阿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29044,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"因树亭观唐明皇磨崖碑","author":"金志章","text":"明皇昔日侈东封，千乘万骑纷云从。\n超然意象小秦汉，七十二代思兼容。\n金泥玉检著符瑞，江茅鄗黍昭虔供。\n礼成大祀颂声作，鸿文典诰铿钟镛。\n天章神笔纵挥洒，鸾飘凤泊翔游龙。\n磨崖深刻纪岁月，万古照耀天门东。\n是时国家正全盛，地大物阜民和丰。\n庙堂宴安渐鸠毒，玉鱼绣褓酣深宫。\n侈心一开蠹随入，九庙俄顷飞灰红。\n淋铃蜀道驰万里，百神不救尘埃蒙。\n徒存兹碑峙巀嶪，雨蚀藓剥云烟中。\n牧儿野火烧不得，至今椎拓传遗踪。\n吴郎嗜古得此本，世守什袭装池工。\n高斋招我共销夏，披襟展玩清宵同。\n规连珠树矩折玉，墨彩腾上光熊熊。\n手摹口诵极赞赏，忽忆往事心神忡。\n《中兴》反正颂神武，亦有巨刻磨巃嵷。\n盛衰治乱互倚伏，鉴戒实可垂无穷。\n殷忧启运满致覆，此理自古关昭聋。\n开天已远代几易，犹留宝刻珍书丛。\n摩挲掩卷三叹息，人君莫漫夸丰功。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29045,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"钤山行","author":"金志章","text":"钤山四绕青谽谺，袁江一线盘修蛇。\n东西峡口两洪束，县城中裹如莲花。\n此邦何人昔最著，豪贵屈指推严家。\n早年登第竞名誉，追逐何李矜浮华。\n归来筑室此山顶，图史枕胙旁人夸。\n青词晚岁博金铉，万事横决如抟沙。\n文章不掩孔雀毒，膝下豺虎兼娄豭。\n读书不识忠孝字，廿年辛苦何为耶？\n立身一败愧乡里，至今齿冷千秋哗。\n清江六月烧晚霞，长桥终古缘城斜。\n熏天之势竟安在？\n徒令吊古兴咨嗟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29046,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"岔道射虎行为李守戎作","author":"金志章","text":"北风卷地尘沙黄，杲杲塞日无晶光。\n山城荦确少行迹，猛虎昼出蹲南冈。\n双晴睒睒射惊电，耸尻竖尾如竿枪。\n咆哮踞地地欲裂，百兽走匿山魈藏。\n血人于口爪牙利，家家闭户群苍黄。\n陇西飞将勇莫当，家世猿臂能挽强。\n须髯猬磔气勃发，直视斑子如跛羊。\n长弓大箭走相博，瞋目叱咤声雷踉。\n洞胸贯胁猛竟殪，气焰安在傫然僵。\n樵苏从此少患害，行李来往仍穰穰。\n我时驱车出北口，逢君迎谒趋道傍。\n为余津津淡且喜，英风爽飒神飞扬。\n须臾健儿舁虎至，馀威尚觉生风霜。\n羡君除暴真健者，当路岂复忧豺狼。\n呜呼！\n当路岂复忧豺狼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29047,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"白沟河吊三忠祠","author":"金志章","text":"白沟河上夕阳时，下马荒原吊古祠。\n北渡中宵悲扼吭，南冠孤愤漫题诗。\n鬼谋曹社家同破，龙去崖山事不支。\n太息残碑焚野火，六陵荒草共凄其。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29048,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"黑峪","author":"金志章","text":"盘盘鸟道上青云，峻坂危坡路不平。\n入险横穿豺虎窟，凌虚俯瞰鹗雕群。\n三关形胜凭高尽，二水波涛出塞闻。\n极目长城回望处，河边饮马汉家军。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29049,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"二十四矶","author":"金志章","text":"惊涛如雪溅长空，峭石崚嶒讶鬼工。\n二十四矶帆侧过，不知身坐浪花中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29050,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹧鸪塘","author":"金志章","text":"客情乡思总凄迷，睡起篷窗日欲西。\n忽听一声行不得，鹧鸪塘外鹧鸪啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29051,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"郭林宗墓","author":"姚湘","text":"知人荐士缅遗踪，此日经过马鬣封。\n一木势难支大厦，六《屯》祸不及潜龙。\n登仙只合同元礼，表墓宁须藉蔡邕。\n更有申屠共标格，高风树屋独名佣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29052,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"梅","author":"姚湘","text":"任尔冰条湿粉痕，何须纸帐护春温。\n红亭远隔人千里，翠羽初飞月一村。\n留得寒香清到骨，莫听羌笛暗销魂。\n几年孤负西园约，冻合孤山独掩门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29053,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"荆州道中","author":"姚湘","text":"女媭砧响杳冥冥，楚些吟成不忍听。\n行过渚宫神黯淡，猿啼夜半在空舲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29054,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"钱博士登俊赠西域地图","author":"沈青崖","text":"客从军中来，遗我盈丈纸。\n展卷列丹青，大荒靡涯涘。\n嵯峨于阗山，蜿蟺伊丽水。\n轮台及阳关，如在掌上指。\n汉唐殊名称，回夷互迁徙。\n服畔靡有常，古来多战垒。\n白骨沉沙窝，金刀折涧底。\n寒暄异中华，幅员空万里。\n有壤不可耕，得民不可使。\n唐虞声教讫，西被流沙止。\n聚米虽良谋，形势何足恃。\n素壁张斯图，聊识大亥趾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29055,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"蒹葭","author":"邵锦潮","text":"秋色浮江上，烟波共渺然。\n苍茫迷远渚，寥落向遥天。\n折叶惊寒雁，飞花点钓船。\n伊人不可即，怅望水云边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29056,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"喜晚香辞幕府归出示新诗留饮","author":"邵锦潮","text":"千尺流泉百尺松，白云丹嶂自从容。\n偶同麋鹿游城市，终觉鶢鶋厌鼓钟。\n句就烟霞频出手，醉馀磈垒肆填胸。\n明朝便蜡寻山屐，到处随君蹑旧踪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29057,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"闺人赠远","author":"邵锦潮","text":"日夕上高楼，云山一望秋。\n悠悠渡头水，空送往来舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":29058,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]