[{"title":"寄怀黄公度二首 其二","author":"丘逢甲","text":"万木萧森夜有霜，登高怀古客心伤。\n斜阳澹作黄昏色，残月遥分大白光。\n卧病梦持明主节，起居缄费远人珰。\n著书閒对秋灯影，独乐园中漏点长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32330,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄马介堂高州 其一","author":"丘逢甲","text":"莽莽罗浮别旧封，将台移筑武坛峰。\n乡心万里怀金马，军令三秋肃石龙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32331,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄马介堂高州 其二","author":"丘逢甲","text":"洗太营边锦伞收，潘仙亭畔石船留。\n一条丁水铜鱼寨，照见将军仗钺游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32332,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄马介堂高州 其三","author":"丘逢甲","text":"翠水西流铁舰通，?州极目海云红。\n弓刀小驻元戎队，满地秋芜宋故宫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32333,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄马介堂高州 其四","author":"丘逢甲","text":"金城秋柳碧毵毵，久罢军中扪虱谈。\n何日伏波酬大志，更携铜柱表交南。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32334,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题禾梅农白云修禊图","author":"丘逢甲","text":"鹤舒台边蹑紫烟，龙泉寺畔斟碧泉。\n千峰云气酿秋色，踏云访客安期仙。\n湖菊流黄涧蒲翠，花簇秋觞修禊事。\n斜阳一角明玉虹，满目白云下山去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32335,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"朱梅农归羊城，三叠前韵为送","author":"丘逢甲","text":"十幅蒲帆鳄渚开，行装捆载好诗来。\n人归国子先生庙，秋在蛮夷大长台。\n珠海群花供客笑，金山明月照论才。\n平生我最思张翰，跌宕千秋一酒杯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32336,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"沈艾孙为刻石章三，赋此为谢二首 其一","author":"丘逢甲","text":"奏刀劳琢寿山云，古色斑斓缪篆文。\n留与后贤珍印谱，便应传是汉将军。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32337,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"沈艾孙为刻石章三，赋此为谢二首 其二","author":"丘逢甲","text":"西风万里客登台，如斗黄金愧此才。\n睥睨千秋仗神笔，狼居胥石勒名来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32338,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"东柳汀","author":"丘逢甲","text":"板桥斜日柳毵毵，秋入蛮乡客兴酣。\n休唱前溪后溪曲，六朝金粉忆江南。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32339,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"访柳汀","author":"丘逢甲","text":"远水空江静，斜阳小市迟。\n我来寻范蠡，久未见西施。\n旧事翻诗卷，新愁集酒卮。\n东山少丝竹，羡尔有花枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32340,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游双髻山 其一","author":"丘逢甲","text":"绝代双鬟影，曾从海上看。\n入山群石怪，倚树一庵寒。\n岭瘴消文贝，岩香孕素兰。\n飞鸦如喜客，啼出古林端。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32341,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游双髻山 其二","author":"丘逢甲","text":"古刹何年建，苔荒磴道斜。\n双峰出霄汉，一室贮烟霞。\n石气瘦崖树，泉香流涧花。\n山僧忘梵诵，云卧冷袈裟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32342,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游灵山护国禅院作 其一","author":"丘逢甲","text":"十月虹桥买棹行，临昆山色眼中横。\n更无东晋残碑在，一抹寒芜故县城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32343,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游灵山护国禅院作 其二","author":"丘逢甲","text":"漠漠荒山仗佛开，千年古木半摧颓。\n惟应一勺灵泉水，曾照元和太守来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32344,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游灵山护国禅院作 其三","author":"丘逢甲","text":"便访山僧亦偶然，何曾同證石头禅？\n三书难定儒林案，笑看中天北斗悬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32345,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游灵山护国禅院作 其四","author":"丘逢甲","text":"铜壶水竭荔无阴，镜塔荒凉古藓深。\n妙法莲华随劫尽，萧萧落叶写经心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32346,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游灵山护国禅院作 其五","author":"丘逢甲","text":"唐颠宋蹶电中过，佛法其如世运何？\n一例称师更称祖，可怜人拜大峰多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32347,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游灵山护国禅院作 其六","author":"丘逢甲","text":"难振宗风似昔年，两山狮象卧寒烟。\n佛门各斗无边法，僧讼传家袖影田。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32348,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游灵山护国禅院作 其七","author":"丘逢甲","text":"无复山神护法时，萧条赐额冷云楣。\n重扶一片空山石，来读先朝运使碑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32349,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游灵山护国禅院作 其八","author":"丘逢甲","text":"山钟飞作郡楼声，访古人来百感生。\n叶叶莲花开怪石，留衣亭畔独题名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32350,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游灵山护国禅院作 其九","author":"丘逢甲","text":"閒向山僧理旧闻，佛楼携客话秋云。\n谁知八部天龙力，曾护昌黎谏佛文。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32351,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游灵山护国禅院作 其十","author":"丘逢甲","text":"寒钟声送暮云飞，铜绣桥边客棹归。\n极目隔江烟树里，峡山孤塔上斜晖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32352,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"客窗夜话，同王晓沧作","author":"丘逢甲","text":"通国正酣睡，忧时人独醒。\n月怜今夕黑，天失古来青。\n闭塞穷冬运，光明海上星。\n荒鸡声满野，倚剑此同听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32353,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"有感书赠义军旧书记四首 其一","author":"丘逢甲","text":"拜将坛高卓义旗，五洲睽目属雄师。\n当时力保危台意，只有军前壮士知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32354,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"有感书赠义军旧书记四首 其二","author":"丘逢甲","text":"宰相有权能割地，孤臣无力可回天。\n啼鹃唤起东都梦，沈郁风云已五年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32355,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"有感书赠义军旧书记四首 其三","author":"丘逢甲","text":"凤凰台上望乡关，地老天荒故将閒。\n自写鄂王词在壁，从头整顿旧河山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32356,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"有感书赠义军旧书记四首 其四","author":"丘逢甲","text":"谁能赤手斩长鲸，不愧英雄传里名。\n撑起东南天半壁，人间还有郑延平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32357,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画竹","author":"丘逢甲","text":"冉冉古琅玕，结根广莫野。\n取之作律筒，持用觉天下。\n当世无伦伶，谁是知音者？\n空教二帝女，攀枝泪如泻。\n竹枝有叶叶有阴，云封嶰谷无凤吟。\n九嶷山高湘水深，题君此图伤我心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32358,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥除夕","author":"丘逢甲","text":"君国无穷感，乾坤此夕心。\n纷纭新旧事，慷慨短长吟。\n家宴喧儿女，门符阅古今。\n围炉閒守岁，莫负酒杯深！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32359,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送李伯质太守归里","author":"丘逢甲","text":"船头伐鼓升船旗，潮州老守今南归。\n天公予閒兼予健，人生七十古所稀。\n方今中朝重耆硕，衮衮公卿头毕白。\n但非策免皆固留，夜望三台自深惜。\n如公此行今所难，文书十上辞一官。\n即论知止亦高绝，况复远识时能观？\n大海茫茫正龙战，老眼饱看犹健饭。\n布帆无恙归去来，且喜春江鱼价贱。\n公家旧住蕲黄间，结庐更向霍太山。\n儿孙教识忠孝字，馀事广种山中田。\n公归自得山中乐，累我中年别怀恶。\n何时寄我山居图，相思远慰南飞鹤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32360,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵答兰史香江见赠","author":"丘逢甲","text":"乾坤何地许扬眉，海上逢君泪满衣。\n泥饮已虚蝴蝶会，寄愁惟咏杜鹃诗。\n平陵松柏人谁问？\n京雒风尘客自知。\n拟约子猷重过访，扁舟春雪预相期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32361,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"早春有怀兰史，用高常侍人日寄杜拾遗韵","author":"丘逢甲","text":"东风夜入说剑堂，引杯自醉梅花乡。\n韩江有客远相忆，江声正搅愁人肠。\n闻鸡欲舞谁相与，神州陆沈剧堪虑。\n祗今海上无仙山，缥缈飞楼寄何处？\n蟠桃花发天为春，安知沧海方扬尘？\n与君行觅咏诗地，我亦苍茫独立人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32362,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"林氅云郎中寄题蚝墩忠迹诗册，追忆旧事，次韵遥答 其一","author":"丘逢甲","text":"故人天末缄诗至，格似龙标供奉多。\n不愧南中称十子，一时人望属西河。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32363,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"林氅云郎中寄题蚝墩忠迹诗册，追忆旧事，次韵遥答 其二","author":"丘逢甲","text":"笔端浩气满乾坤，桑海归来义愤存。\n碎破河山同感慨，更将忠迹表蚝墩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32364,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"林氅云郎中寄题蚝墩忠迹诗册，追忆旧事，次韵遥答 其三","author":"丘逢甲","text":"当时痛哭割台湾，未肯金牌奉诏还。\n仓葛哀呼竟何补，全军难保武峦山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32365,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"林氅云郎中寄题蚝墩忠迹诗册，追忆旧事，次韵遥答 其四","author":"丘逢甲","text":"英雄愧说郑延平，目断残山一角青。\n何日天戈竟东指，誓师海上更留铭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32366,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"林氅云郎中寄题蚝墩忠迹诗册，追忆旧事，次韵遥答 其五","author":"丘逢甲","text":"黯黯归云拥海槎，浪纾筹策事量沙。\n岛中义士依然在，伏腊年年奉汉家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32367,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"林氅云郎中寄题蚝墩忠迹诗册，追忆旧事，次韵遥答 其六","author":"丘逢甲","text":"经史无功世贱儒，空山披褐感潜夫。\n斩新花样愁经眼，颠倒天吴紫凤图。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32368,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"林氅云郎中寄题蚝墩忠迹诗册，追忆旧事，次韵遥答 其七","author":"丘逢甲","text":"尊酒东山拜大忠，浩歌人尚气如虹。\n残篇重检王炎午，来祭庐陵信国公。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32369,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"林氅云郎中寄题蚝墩忠迹诗册，追忆旧事，次韵遥答 其八","author":"丘逢甲","text":"徙尽虹桥桥畔蚝，北风吹客冷萧骚。\n沁园一阕君须记，落木斜阳句更豪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32370,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蓝溪烈妇篇为上杭族人德祥妻廖氏作","author":"丘逢甲","text":"蓝溪水，清而蓄，中有双鸳鸯，旁有连理木。\n上多贤者居，吾丘世聚族。\n岁在蛇，贤人嗟，秋风吹折连理花。\n文鸳一夜死，鸯殉其雄死自矢。\n于时九月天雨霜，月魄将死未死尚有光如珥，流照人间烈妇里。\n妇年三八缺未完，千古完名付彤史。\n夫有烈妇夫不死，妇死先令夫有子，去夫之死三日耳！\n蓝溪水，清且长，滨溪行建烈妇坊；上书天语为褒扬，下书妇氏廖夫曰丘德祥。\n海可枯，石不烂，巍坊永永蓝溪岸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32371,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"崧里烈妇篇为门下士大埔何寿慈妻萧氏作","author":"丘逢甲","text":"吾门有何生，其才清且美。\n弱冠赫有声，不愧名家子。\n火色法宜贵，祗忧不寿尔。\n奈何衿未青，一鸣竟长已。\n有妇氏曰萧，从容殉之死。\n吁嗟乎！\n造物忌才尤忌名，何生惟有才，不幸与之撄。\n烈哉妇！\n乃以一死婉婉上与造物争。\n才虽可死名不死，岂非赖此闺中英？\n君不见崧里之山高嶪嶪，崧里之水扬益洁。\n中有峨峨双绰楔，天荒地老名不灭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32372,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和晓沧岁暮感怀次元韵 其一","author":"丘逢甲","text":"万里边声倚枕听，盗羊何止有丁零！\n将军妄托天公号，术士虚谈地母经。\n剩有封章说初月，可无杯酒劝长星。\n空山汉腊依然守，目断中原一发青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32373,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和晓沧岁暮感怀次元韵 其二","author":"丘逢甲","text":"轮转谁知地四游，踆乌冷入北门幽。\n秘书无效嗟刘向，秽史能传笑魏收。\n消歇国谣王共马，支离党局李仇牛。\n枝枝向背分寒暖，且看梅花为小留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32374,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将之南洋，留别亲友 其一","author":"丘逢甲","text":"一水茫茫络五洲，此行心已遍全球。\n衣冠异代图王会，书剑平生快壮游。\n花幔俗探柔佛国，锦袍人上谪仙舟。\n要知吾道其南意，鲁叟先言海可浮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32375,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将之南洋，留别亲友 其二","author":"丘逢甲","text":"书生三十旧登坛，落拓防身剑气寒。\n异国谈瀛誇海客，中天列宿愧朝官。\n千年鹤爪书何苦？\n一卷虬髯传未残。\n独上柁楼看象纬，东南风急送青翰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32376,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将之南洋，留别亲友 其三","author":"丘逢甲","text":"五载金城客闭门，拍天海气昼昏昏。\n九边田牧思班壹，二帝遨游笑马援。\n地陷东南浮大岛，天留豪杰救中原。\n抚髀漫下英雄泪，新野应容一旅屯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32377,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将之南洋，留别亲友 其四","author":"丘逢甲","text":"破荒文字走风雷，草昧思从海外开。\n挟策九夷嬉凤去，携竿三岛钓鳌来。\n天回博望乘槎路，人陋相如谕蜀才。\n无限抱孙椎结辈，待教绝徼筑朝台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32378,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将之南洋，留别亲友 其五","author":"丘逢甲","text":"万里南车过越裳，春风原不阻炎荒。\n虚无龙鼎讹黄帝，郑重麟书拜素王。\n骠国乐来天酒醉，鲛人市罢海珠光。\n蛮花万树开如雪，难遣填胸热血凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32379,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将之南洋，留别亲友 其六","author":"丘逢甲","text":"极外占星计水程，天门残梦搅涛声。\n青牛道远流沙阻，白马经荒劫火生。\n看日果逢人北向，行云如送客南征。\n亶洲洲上瞻尼父，海燕春风正满城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32380,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将之南洋，留别亲友 其七","author":"丘逢甲","text":"骊歌声里即天涯，胡越何妨竟一家！\n大海从新开世界，群山依旧拱中华。\n贡金待铸先朝史，碾玉教图异域花。\n岛国王侯看下拜，书生此念太豪奢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32381,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将之南洋，留别亲友 其八","author":"丘逢甲","text":"南溟从古是天池，笑看鲲鹏变化时。\n已遣少师先入海，可容箕子独明夷。\n人来上国仍冠冕，诗出中原更鼓旗。\n箧有中朝新乐府，遍传骑象戴花儿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32382,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄答陈梦石明经即题其东溪吟章 其一","author":"丘逢甲","text":"床头莸草参诗草，门外松声答水声。\n坐对溪山安砚席，方田如罫赋春耕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32383,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄答陈梦石明经即题其东溪吟章 其二","author":"丘逢甲","text":"身原博士非关{具}，天遣穷人最是诗。\n消受时名但馀技，空山谁识老经师？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32384,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"初发韩江","author":"丘逢甲","text":"韩山云气拥双旌，江上扁舟第一程。\n四海客怀鸿鹄志，三春人别凤凰城。\n九州有九徵吾说，南斗以南快此行。\n无限雄心消不得，倚篷閒看暮潮生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32385,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次鮀浦，叠前韵","author":"丘逢甲","text":"一夜东风送客旌，海门人暂驻征程。\n山回阁石青连岸，江绕篷洲绿到城。\n看雨市楼呼酒醉，冶春官舫载花行。\n同舟共济艰难日，未免茫茫百感生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32386,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"东山重修景贤楼大忠祠，次第落成，喜而有作","author":"丘逢甲","text":"东山曾过昌黎伯，信国勤王更驻师。\n呼石与谈前代事，铸金重拜昔贤祠。\n春风游女飘遗帨，落日行人读断碑。\n忠节文章坊宛在，千秋来话此心期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32387,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏史四绝句和晓沧四首 其一 鲁仲连","author":"丘逢甲","text":"六国不帝秦，赖有布衣在。\n怀古独登台，斜阳满东海。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32388,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏史四绝句和晓沧四首 其二 田横","author":"丘逢甲","text":"有士五百人，岛中犹可国。\n何事奉头来？\n秋风洛阳陌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32389,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏史四绝句和晓沧四首 其三 赵佗","author":"丘逢甲","text":"终筑朝汉台，未预诛秦会。\n吕雉不能臣，伟哉南武帝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32390,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏史四绝句和晓沧四首 其四 钱镠","author":"丘逢甲","text":"十四方州富，三千战弩强。\n平生愧昭谏，独未讨朱梁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32391,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鮀浦将发，寄许韫伯","author":"丘逢甲","text":"别怀难共海云开，更向何人借酒杯？\n本领依然心计拙，可怜还唱渭城来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32392,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"哭李芷汀","author":"丘逢甲","text":"布衣牢落病兼贫，南徼惊闻噩耗真。\n四海名流同哭寝，千秋文苑此传人。\n谈兵慷慨曾前席，钩党纷纭竟洁身。\n地下鬼雄应问讯，中原如沸未维新。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32393,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"酒楼题句","author":"丘逢甲","text":"红云四照酒光浓，开宴蓬莱顶上峰。\n手拨劫尘看世界，茫茫人海战群龙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32394,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"澳门有赠","author":"丘逢甲","text":"海上我来寻大侠，如君何让古朱家。\n北胡南越英雄在，落日萧萧广柳车。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32395,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"澳门杂诗 其一","author":"丘逢甲","text":"五百年中局屡新，两朝柔远畅皇仁。\n自颁一纸蠲租诏，坐看江山换主人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":32396,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]