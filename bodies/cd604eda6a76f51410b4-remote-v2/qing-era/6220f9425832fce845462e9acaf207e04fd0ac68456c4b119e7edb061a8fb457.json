[{"title":"烛影摇红","author":"贺洁","text":"绿鬓慵梳，昼长不放香帘锁。\n罗衫香褪兽烟消，脉脉愁无那。\n谁摆花枝袅娜。\n悄窥人、黄鹂一个。\n玉阶苔遍，寂寂花茵，愁人独坐。\n燕子多情，衔泥故向帘前过。\n年年多病似伤春，料亦春怜我。\n兰梦因风搅破。\n盼枝头、累累熟果。\n鹊饥偷啄，戏拽金铃，含桃惊堕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22794,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"捣练子 梅花","author":"张传","text":"皎似雪，洁如霜。\n分外清幽一种香。\n可爱冰心甘冷淡，几枝疏影照斜阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22795,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 秋夜","author":"张传","text":"霜薄未曾严。\n金粟初添。\n暮山晴碧淡冰蟾。\n月姊怜香思照影，尽揭云帘。\n寒到尚迟淹。\n趁暖裁缣。\n闲愁端不上眉尖。\n挑起银灯消永漏，彩线重拈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22796,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人 春晴","author":"张传","text":"荼縻架上莺声细。\n也道春光丽。\n轻寒轻暖养花天。\n早有牡丹几种、色鲜妍。\n晴丝抱逗残红片。\n兜住垂杨线。\n游人半为踏青归。\n恐怕妒花风雨、两相催。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22797,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 雨窗对菊","author":"冯挹芳","text":"绣衣风透馀香织。\n玲珑嫩叶凝眸碧。\n花影半帘秋。\n箫声起画楼。\n夜深人独立。\n风雨萧萧急。\n烛灺闪虚棂。\n疏枝映素屏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22798,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 偕嫂游湖浦","author":"喻撚","text":"画阁妆馀，东风正早。\n且闲刀尺听啼鸟。\n湖乡十里趁花开，凌波莫惜鞋头小。\n树里人家，堤边芳草。\n远山无数横天表。\n频年苦忆故园春，今年始觉江南好。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22799,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"捣练子 春日偶占","author":"喻撚","text":"香欲冷，雨初残。\n春事无多怕绕阑。\n侍女不知愁绝处，却持花片向人看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22800,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 示莲女","author":"喻撚","text":"晓日当窗理绣丝。\n莫调金粉莫拈诗。\n倦馀聊倚碧梧枝。\n道蕴才华妨静女，少君风范是良师。\n耽书休似阿娘痴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22801,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长相思 秋夜","author":"张道介","text":"灯影残。\n月影残。\n烟树微茫夜已阑。\n个人犹未闲。\n思恹恹。\n病恹恹。\n一段心情何处牵。\n长天秋水边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22802,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"武陵春 春暮","author":"张道介","text":"杨白花飞飞几许，点点落帘钩。\n萍踪切莫逐波流。\n端为那人愁。\n鸠妇呼晴还唤雨，晴雨总无由。\n好携樱笋上兰舟。\n绿阴天际游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22803,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 夏闰","author":"张道介","text":"开遍荼縻一院香。\n困人天气日初长。\n池塘深浅浴鸳鸯。\n禊帖午临欹枕倦，玉琴晚奏短襟凉。\n登楼惆怅又斜阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22804,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满庭芳 题画拳石","author":"张道介","text":"泼墨濡毫，缀成小石，宛然霞浸云烘。\n幽窗舒卷，几席列奇峰。\n点点莓苔如滴，清闲供、可入诗筒。\n消昼永、评花品茗，日日坐春风。\n何殊游胜地，连山拱壁，软土推红。\n见岚光岫色，倒映帘栊。\n休羡南宫怀袖，玲珑样、晴雨空濛。\n珍藏好，莫教轻掷，文锦细加封。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22805,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"锦堂春","author":"彭琬","text":"莫云别未三秋，见月几番圆缺。\n自思量有限柔肠，惹闷怀千叠。\n灯花夜夜灰心，喜鹊朝朝饶舌。\n惟有杜鹃知我意，向枝头啼血。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22806,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一寸金 十姊妹花，呈玉映女兄作","author":"彭琰","text":"绣屋银屏，生小连枝开取。\n笑昭阳、合德空传，双绝二乔，倾国输他未字。\n林下标风致，论才貌、谁甘第二。\n闺中费、几许平章，连普添枝上花史。\n只数排行，难分娣姒，红颜总相似。\n便成都眉样，装成一色，回心词艳，香分何处。\n恼乱探花史，原只合、花间序齿。\n殊非是，十八封姨，花信知同乳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22807,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"成岫","text":"绿杨深处黄鹂坐。\n苍苔门巷无人过。\n帘卷接湖光。\n六桥车马忙。\n锦塘花历乱。\n云拥雷峰暗。\n触绪抚瑶琴。\n澄怀一寄心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22808,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉花阴 题画","author":"成岫","text":"风送琅玕声簌簌。\n四月林齐绿。\n纵目寄湖山，惆怅今春，只是莺声熟。\n自嗟锦瑟年华促。\n日对生绡彀。\n点染似迂痴，幽涧寒藤，疏树黄茅屋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22809,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人 春闺雨中","author":"成岫","text":"一春花事多催挫。\n怪杀连连雨。\n梅羞杏泣海棠愁。\n愁绝桃花含怨、放楼头。\n嗔他鸠妇相呼闹。\n睍睆莺声巧。\n听他溜滴滴阑干。\n滴破阶心只是、怯春寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22810,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 秋夜独坐","author":"倪小","text":"兰闺幽静纤尘绝。\n博山香炷挑灯爇。\n何处弄哀筝。\n凄凉独自听。\n银河清似水。\n人坐秋声里。\n窗外月华生。\n粉墙花影明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22811,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长相思","author":"倪小","text":"花也新。\n柳也新。\n昨夜南楼梦踏青。\n朝来记不真。\n歌几巡。\n笑几巡。\n日日寻芳泗水滨。\n由他姊妹嗔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22812,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 春半","author":"周蕉","text":"燕尾翻风双剪轻。\n柳眠惊觉乱啼莺。\n四旬有五半分春。\n窗外三更寒食雨，梦中一个惜花人。\n此时不怕不消魂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22813,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卜算子 春病","author":"周蕉","text":"心是惜花疼，足是寻春乏。\n花残春老病根由，病也风流煞。\n欲补恨难消，欲泻情还弱。\n春来花放是良医，此外曾无药。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22814,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"虞美人 怀外","author":"周蕉","text":"别后音书无片纸。\n一只鸳鸯愁欲死。\n莫将行迹比萍踪。\n便是浮萍还有、日相逢。\n枝头豆大青梅小。\n拟似芳心酸意少。\n寻山问水竟忘归。\n辜负山明水秀、眼和眉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22815,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇","author":"陈契","text":"春色撩人，闷来闲步苍苔径。\n花阴踏尽。\n倦向阑干凭。\n试看雕梁，紫燕时相并。\n教人恨。\n飞花成阵。\n又惹芳心困。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22816,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"陈契","text":"兰膏收拾芙蓉匣。\n杏腮红雨春纤雪。\n羞绾合欢裳。\n偎郎抱玉匡。\n香微烟穗灭。\n漏促琼签彻。\n残梦正迷离。\n寒鸡背月啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22817,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"陈契","text":"今生浪拟来生约。\n从今悔却从前错。\n腰带细如丝。\n思君知不知。\n五更风又雨。\n两地侬和汝。\n着意待新欢。\n莫如侬一般。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22818,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 山居。回文","author":"陈契","text":"乱流溪树烟横岸。\n岸横烟树溪流乱。\n桥断接遥峰。\n峰遥接断桥。\n焙茶山雨细。\n细雨山茶焙。\n秋到等闲鸥。\n鸥闲等到秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22819,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"思帝乡 独夜闻箫","author":"王昙影","text":"睡初醒，起来天未明。\n独拥寒衾。\n偏自梦难成。\n帘外冷风斜月透银屏。\n何处箫呜咽，不堪听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22820,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渔歌子","author":"王昙影","text":"柳垂青，花带艳。\n妆台独坐添悲感。\n泪容销，双蛾淡，索把镜儿呵暗。\n意潜潜，魂黯黯。\n纤腰渐觉春来减。\n燕声愁，莺啼惨，那得病儿不染。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22821,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"烛影摇红 楚中寄外","author":"赵氏（廷标女","text":"瑶瑟声悲，洞庭落木秋风急。\n兰旌桂棹水中央，渺渺烟波隔。\n独倚危楼百尺。\n正黄昏、长天一色。\n汀沙月淡，野戍峰高，寒山凝碧。\n双鲤沉浮，锦书三载无消息。\n江南江北折垂杨，历乱愁如织。\n岁暮虚传画鹢。\n浪花残、莲歌声寂。\n云迷翠羽，露冷琼枝，流光暗掷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22822,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"捣练子 春晓","author":"沈佩","text":"花露重，莫凭栏。\n楼上新妆怯晓寒。\n啼鸟数声惊梦破，却教愁思上眉端。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22823,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 寒食","author":"沈佩","text":"柳外莺啼，帘垂满地梨花碎。\n东风无赖，吹得人憔悴。\n村舍烟稀，草色青青路。\n寻芳去。\n子规声沸。\n却被愁牵住。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22824,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 萤火","author":"沈佩","text":"素影翩翩，池塘雨过明如霁。\n乱飘香砌。\n几点星光细。\n露冷风轻，寂寂重门闭。\n更深矣。\n照人无寐。\n独伴寒蛩语。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22825,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浣溪沙 春去","author":"沈佩","text":"杨柳丝丝系玉骢。\n杜鹃啼处晚烟浓。\n春光遍逐水流东。\n满院落花愁寂寂，一帘飞絮恨匆匆。\n无聊最是月明中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22826,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卜算子 元夜","author":"沈佩","text":"台馆遍笙歌，又是黄昏后。\n寂寂梅花小院开，报道春依旧。\n梦断月初斜，素影清如昼。\n光景年年一样新，且放眉间皱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22827,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 晓妆","author":"沈佩","text":"迟迟日影穿窗罅。\n晓寒人在重帘下。\n临镜独徘徊。\n低头学画眉。\n钗横双燕小。\n蝉鬓云缥缈。\n妆罢步闲阶。\n海棠开未开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22828,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"巫山一段云 春闺","author":"沈佩","text":"烟柳迷深院，春风袅翠鬟。\n锁窗人静意阑珊。\n飞絮满雕栏。\n几点昏黄雨，吹残烛影寒。\n停针无语又更阑。\n独自倚楼看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22829,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南柯子 新秋","author":"沈佩","text":"枕簟清无暑，波纹静欲流。\n微云过尽雨初收，正是晚凉时候、似新秋。\n香烬金猊冷，风轻翠影柔。\n谁家砧杵度南楼，又是一湾斜月、挂银钩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22830,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉春风 春睡","author":"沈佩","text":"弱柳遮芳径。\n帘垂深院静。\n倚栏无语日长时，病。\n病。\n病。\n燕子来时，莺儿啼处，绿柔红嫩。\n小阁炉烟烬。\n睡起人犹困。\n隔墙何处卖花声，恨。\n恨。\n恨。\n午梦未舒，轻风乍起，落花成阵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22831,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江城子 月夜闻笛","author":"沈佩","text":"银河黯淡碧于流。\n数更筹。\n晚烟收。\n倚遍栏杆，无语思悠悠。\n何处画楼吹玉笛，惊客梦，动离愁。\n鬓云斜亸玉搔头。\n月光浮。\n上帘钩。\n丹桂凝寒，素影弄轻柔。\n试问闺人知也未，风乍度，便悲秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22832,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子 雪夜独坐得飘字","author":"沈佩","text":"帘外雪初飘。\n翠幌香凝火未消。\n独坐夜寒人欲倦，迢迢。\n梦断更残倍寂寥。\n楼阁遍琼瑶。\n庭树纷纷玉作条。\n林外梅花应放也，萧萧。\n香过寒溪第几桥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22833,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 回文，咏月","author":"吴山","text":"薄云冰净光帘幕。\n幕帘光净冰云薄。\n清逼梦乌惊。\n惊乌梦逼清。\n静阶流素影。\n影素流阶静。\n时露濯花移。\n移花濯露时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22834,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮 回文，闲咏","author":"吴山","text":"鹤鸥闲共人游乐。\n乐游人共闲鸥鹤。\n松落露高峰。\n峰高露落松。\n隔溪烟水白。\n白水烟溪隔。\n非是远忘机。\n机忘远是非。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22835,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 题画屏梅妃","author":"吴山","text":"宫闱落叶。\n金风团扇悲时节。\n玉漏迟迟。\n翠辇遥传太液池。\n君恩浩荡。\n瘦影寒香如妾样。\n明月丹墀。\n谁奏新声一斛珠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22836,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"减字木兰花 思母","author":"吴山","text":"连宵风雨。\n黄叶林间秋几许。\n大地清凉。\n游子惊心忆故乡。\n人生如寄。\n对景频弹思母泪。\n何日归期。\n回首青霜黯鬓丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22837,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"画堂春 题画屏雪儿","author":"吴山","text":"昨宵解佩梦江滨。\n朝来翠掩歌屏。\n黄鹂花底语星星。\n风度重扃。\n蝉翼云鬟新碧，绮纨沉水馀馨。\n漫歌金缕荐佳醽。\n遥忆峰青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22838,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"罗敷令 夏日西湖雨霁","author":"吴山","text":"雨馀虚阁凉阴满，风细窗南。\n梦破邯郸。\n一枕清芬未可贪。\n遥山壁立高云汉，不许云函。\n此境谁谙。\n羡他飞鸟远能探。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22839,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"罗敷令 夏夜湖中访荷","author":"吴山","text":"湖莲十里清人魄，香泛衣罗。\n棹破烟波。\n碧汉迢迢淡玉河。\n清凉人在双峰底，翠景婆娑。\n风月如何。\n夜色平分月较多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22840,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹧鸪天 题钓鳌图，用黄鲁直韵","author":"吴山","text":"风细澄江浪不飞。\n一竿应不羡鲈肥。\n青山久对成良友，白鸟频来送好诗。\n琼作骨，芰为衣。\n柳底矶边立几时。\n静待一圆秋兔满，丝伦收拾载鳌归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22841,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"玉楼春 晚眺，怀闺秀王辰若","author":"吴山","text":"暮云碧际知何处。\n四山之外疑天住。\n一片丹霞断竹来，两行白鸟分烟去。\n极目寸心萦万缕。\n凭楼默诵蒹葭句。\n有怀常引梦天涯，犹然不识天涯路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22842,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹊桥仙 丁亥七夕","author":"吴山","text":"将秋尚夏，月娟云巧。\n更湛碧、星河清渺。\n女牛相别动经年，弟未识、离踪多少。\n凭栏拟听，鸾笙韵杳。\n想又为、明朝秋早。\n他时有分到瑶池，记问取、桥边乌鸟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22843,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"青玉案 西湖七夕，用贺方回韵","author":"吴山","text":"彩霞不续长河路。\n一水渺然流去。\n睆彼清光何以度。\n隔年离恨，千秋情绪，都在云深处。\n龙舆倏转蓝桥暮。\n惜别应留秋月句。\n试语人间愁几许。\n两行情泪，满天秋露，疑是巫山雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22844,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"法曲献仙音 梁溪雨中七夕","author":"吴山","text":"情以秋兼，事因时会，古说双星今度。\n淡月含烟，轻云披汉，河际贝宫琼户。\n怅浅碧摇空处，凄风又吹雨。\n悄无语。\n叹红尘、妒人青鬓，幽赏事、多被风惊雨阻。\n疏落是襟怀，最难消、月明花妩。\n倚遍危栏，望天河、渺渺飞素。\n漫赓歌达曙。\n莫放此宵潜去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22845,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满庭芳 秋遣","author":"吴山","text":"归鸟休枝，夜虫鸣彻，小轩风过吹凉。\n雨晴天朗，诗思入潇湘。\n秋染重林瑟瑟，更何处、疏远清香。\n曲池畔，绿红层叠，依约瘦莲房。\n携撙闲吊月，支离病骨，潦倒贫乡。\n叹人生有几，况遇沧桑。\n且把双眉解放，领略些，水色山光。\n衷肠事，思亲忧世，别作一囊装。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22846,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"百字令 戊子春暮，寓西湖，坐雨有感","author":"吴山","text":"绿肥红瘦，正东风欲转，燕莺声碎。\n烟锁长堤芳草醉，无那两峰如髻。\n湿翠粘天，断云贴巘，此际多新态。\n倚栏凭眺，三径故园荒未。\n堪怜美景良辰，没来由、只与愁相对。\n何事天涯蝴蝶梦，流连客舍难退。\n啼鸟多情，落红不管，领略无滋味。\n暮春也动，闺思来诗内。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22847,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 题三泖渔庄图","author":"胡慎仪","text":"古渡扁舟，横系在、柳荫深处。\n视西风、泖湖秋早，挂帆归去。\n一片斜阳萦岸曲，半湾流水沿门住。\n把鱼竿，独坐自忘机，盟鸥鹭。\n频领略，烟霞趣。\n寒复暖，朝还暮。\n趁箕踞长啸，逍遥寰宇。\n茅屋春深鹤梦老，金炉香袅琴心古。\n劝垂纶，莫漫向衡门，栖迟误。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22848,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"菩萨蛮","author":"胡慎容","text":"人言我瘦形同鹤。\n朝朝揽镜浑难觉。\n但见指尖长。\n罗衣褪粉香。\n若能吟有异。\n不管腰肢细。\n清减果如梅。\n凋零亦是魁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22849,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"凤栖梧 寄姊   见汪启淑《水曹清暇录》","author":"胡慎容","text":"罗袂香微风暗度。\n佳节重逢，越自生愁绪。\n镜影懒窥消几许，一枝愁压榴花雨。\n岁月催人容易故。\n不是无情，故惹相思句。\n往事徒悲肠断处，双双燕子来还去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22850,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渔家傲 本意","author":"杨澈","text":"一叶扁舟秋信早。\n舻声曳乱沙汀草。\n鸥鹭溪边争浴闹。\n芙蓉老。\n绿蓑披雨穿红蓼。\n江上鱼鲜新酒好。\n摩娑醉眼乾坤小。\n欹枕睡酣风满棹。\n烟波悄。\n醒来漫唱渔家傲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22851,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"点绛唇 送女","author":"杨澈","text":"绕藤依依，晨昏举止相携伴。\n欢容笑眼。\n解我愁怀半。\n一旦轻分，握手难留恋。\n何时见。\n灯昏月暗。\n谁识离肠断。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22852,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"阮郎归 忆女","author":"杨澈","text":"灯前梳裹带娇啼。\n牵衣难别离。\n犹闻兰麝在深闺。\n几回错唤伊。\n风日淡，暮云微。\n凄凉泪湿衣。\n梦中惊喜汝来归。\n觉回依旧非。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22853,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 除夜","author":"杨澈","text":"残腊一宵除。\n香发瓶梅。\n樽前欢笑报春归。\n争奈一身情作恶，事事皆非。\n病骨强支离。\n无限凄其。\n明朝椒酒捧觞时。\n还忆去年香阁里，有女相携。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22854,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 秋景","author":"杨澈","text":"短巷寒砧，孤城画角。\n嘹嘹征雁沙头落。\n断桥秋思不堪闻，被风吹入深深阁。\n细雨梦回，绿罗衾薄。\n夜阑灯晕寒生幕。\n重门寂寂掩黄昏，梧桐叶上偏萧索。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22855,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"满江红 秋闺","author":"杨澈","text":"秋入银屏，金钩冷、湘帘高轴。\n叹秋光、芙蓉粉褪，桂枝香触。\n月殿冰轮光乍冷，玉楼鸳瓦寒生栗。\n倚栏杆，庭院悄无人，风敲竹。\n池塘里，鸳鸯浴。\n帘栊下，鹦哥宿。\n听何处箫声，吹残红玉。\n月转西廊花影乱，漏沉东阁砧鸣促。\n又依稀，铜箭已将残，疏钟续。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":22856,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]