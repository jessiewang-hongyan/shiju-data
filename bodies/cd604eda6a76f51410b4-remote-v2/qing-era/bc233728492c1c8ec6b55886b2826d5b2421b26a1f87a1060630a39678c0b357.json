[{"title":"虎跑泉","author":"玄烨","text":"松林带馀雪，空山啼百舌。\n石溜响涓涓，寒泉自清洁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":36999,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"灵隐寺","author":"玄烨","text":"灵山结幽秀，鹫岭起嵯峨。\n梵宇盘空出，香云绕地多。\n开襟对层碧，下马抚烟萝。\n羽卫閒来往，非同问法过。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37000,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"飞来峰","author":"玄烨","text":"岩岫崚增洞壑奇，悬藤古木半迷离。\n冷泉亭子清溪上，谁识源头混混时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37001,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"谕浙省将吏军民","author":"玄烨","text":"省方浙西东，山川极遐瞩。\n兹晨当回銮，谆谆一相勖。\n军民贵安和，文武须联属。\n息忿可无争，守分在忍辱。\n日使讼庭閒，愚民免械梏。\n奢侈尤当惩，繁华莫恣欲。\n俭乃保其富，素履各敦笃。\n惟令教化兴，益见闾阎足。\n诸吏宜勉之，期归淳朴俗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37002,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"舟中书怀","author":"玄烨","text":"澹澹春山暮霭清，和风拂柳入帘轻。\n留情远寄悬千里，抚景兴怀历几程。\n寒尽梅中初霁雨，诗成洲上忽闻莺。\n船窗睡起疑宫阙，月满江湖听棹声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37003,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"将游华山以欲雨未往","author":"玄烨","text":"欲向青山涧壑行，春云又变晓阴轻。\n勾陈不遣惊禅定，恐碍林间碧草生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37004,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雨中幸锡山园林","author":"玄烨","text":"澹冶青山色，幽探傍晓来。\n烟笼岩下竹，雨洗石边苔。\n断续听啼鸟，飘摇惜落梅。\n胸襟原浩荡，随意坐亭台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37005,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"惠泉","author":"玄烨","text":"寒云覆树昔年经，再品山泉到此亭。\n春水一犁农事足，喜看膏雨遍郊坰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37006,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"句容雨望","author":"玄烨","text":"山行逐高低，四望多松树。\n雨里万人家，遥看隔云雾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37007,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"巡幸江宁","author":"玄烨","text":"南省封疆惟此区，江流环绕壮规模。\n华旗芝盖重临幸，二水三山半画图。\n吏事莫先田野治，民情但愿闾阎孚。\n不知比岁恩波洽，止听黄童白叟呼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37008,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赐江宁文武将士宴于教场","author":"玄烨","text":"瑞云捧日晓初晴，丽景天开羽仗明。\n扈跸赳桓多绛灌，分行俊誉尽璁珩。\n三浆满浥沾须遍，五载南巡泽再倾。\n文穆武恬惭化理，万方无事宴升平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37009,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"再过明故宫","author":"玄烨","text":"楼台金粉已沈销，不独诗人说六朝。\n月落宫垣春寂寂，经过惟叹草萧萧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37010,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"江宁驻跸","author":"玄烨","text":"心勤民隐独咨诹，不为江山作胜游。\n白下回銮期已近，黔黎拥道欲何求。\n多怜野老堆盘献，勉就舆情两日留。\n二十八年宵旰意，岂图远迩慕怀柔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37011,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"后湖","author":"玄烨","text":"淼淼长湖水，春来发绿波。\n飞鸣下凫雁，朝暮集渔蓑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37012,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"登报恩寺浮图","author":"玄烨","text":"涌地千寻起，摩霄九级悬。\n琉璃垂法相，翡翠结香烟。\n缔造人功巧，流传世代迁。\n旷然弥远望，万象拱诸天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37013,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"上巳日再登金山","author":"玄烨","text":"晴和逢上巳，况在大江滨。\n正是回銮日，挥毫记此辰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37014,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"长江夜月","author":"玄烨","text":"万顷沦涟映，平沙一望收。\n天光起水色，云影共波流。\n隔岸姑苏远，临轩夜月浮。\n民情咸自得，何必泛龙舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37015,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晓发维扬顺风扬帆午馀已过秦邮","author":"玄烨","text":"傍晓发芜城，风帆疾如驶。\n晚照半平湖，舟行百馀里。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37016,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"自宿迁解缆一日夜达山东境","author":"玄烨","text":"千里南程几日回，轻舟直下溯潆洄。\n天风更假帆樯便，一夕山东境上来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37017,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"途次书怀","author":"玄烨","text":"长乐慈颜两月违，白云迢递恋春晖。\n轻舟不系兼程进，应话民风坐漏稀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37018,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"忧旱忆民事作","author":"玄烨","text":"仲夏炎曛盛，德凉时未和。\n骄阳因六事，亢旱最三河。\n民以食为重，天将风更多。\n忧勤难暇顾，惟诵悯农歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37019,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"挽大行皇后诗四首 其一","author":"玄烨","text":"月掩椒宫叹别离，伤怀始觉夜虫悲。\n泪添雨点千行下，情割秋光百虑随。\n雁断衡阳声已绝，鱼沈沧海信难期。\n繁忧莫解衷肠梦，惆怅销魂忆昔时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37020,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"挽大行皇后诗四首 其二","author":"玄烨","text":"交颐泪洒夕阳红，徒把愁眉向镜中。\n露冷瑶阶增寂寞，烟寒碧树恨西东。\n旧诗咏尽难回首，新月生来枉照空。\n鸾影天涯无信息，断弦声在未央宫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37021,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"挽大行皇后诗四首 其三","author":"玄烨","text":"音容悲渐远，涕泪为谁流。\n女德光千祀，坤贞应九州。\n凉风销夜烛，人影散琼楼。\n叹此平生苦，频经无限愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37022,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"挽大行皇后诗四首 其四","author":"玄烨","text":"淅沥动秋声，中心郁不平。\n离愁逢叶落，别恨怨蛩鸣。\n寂寂瑶斋隔，沈沈碧海横。\n玉琴哀响辍，宵殿痛残更。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37023,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"中秋书怀","author":"玄烨","text":"多病多悲感百端，暂来此地驻琼銮。\n岩间雨歇衣还湿，岭外云开露未乾。\n风激清潭三汲浪，秋催堕叶五更寒。\n惊看圆月峰头出，似照愁肠劝夕餐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37024,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"守陵太监崔邦琪侍慈宁宫年久诗以赐之","author":"玄烨","text":"返照寒松影，心悬泣露霜。\n一生常感悼，数载几悲凉。\n恨接云峰近，思连沧海长。\n问安劳梦想，绝矣九回肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37025,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"康熙二十八年岁旱冬又无雪朕焦心劳思寝食俱废二月初间谒陵路遇大雨田野欢声方少抒朕怀故赋五言律以记之","author":"玄烨","text":"念愆思云汉，望岁意真纯。\n稼穑三时重，祈丰六事频。\n风恬咸自乐，雨洒易为春。\n高下皆沾足，方知天至仁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37026,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏花瓶","author":"玄烨","text":"撷取群芳置案头，天香一段贮清幽。\n人生常有悲欢事，惟尔閒情不晓愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37027,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雨后初晴戏作二首 其一","author":"玄烨","text":"山腹重云锁晚烟，水光逐浪共天连。\n长桥疑作虹蜺似，落照扁舟湖上眠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37028,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雨后初晴戏作二首 其二","author":"玄烨","text":"新晴雨后映斜阳，草茂花繁处处香。\n石色苍苔随岸绿，桥边垂柳挂丝长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37029,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"命裕亲王福全皇长子允禔帅师征厄鲁特锡之以诗","author":"玄烨","text":"万国勤怀保，三阶愿治平。\n寰中皆赤子，域外尽苍生。\n小蠢忘帡冒，天心解斗争。\n执迷思梗化，伐罪事专征。\n武略期无敌，王师出有名。\n亲藩分鈇钺，长子拥麾旌。\n貙虎资郎将，貔貅壮禁营。\n玉戈凝晓色，金甲耀秋晴。\n获丑宁遗类，筹边重此行。\n据鞍军令肃，横槊凯书成。\n烟火疆隅堠，牛羊塞上耕。\n遐荒安一体，归奏慰予情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37030,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"养病塞北","author":"玄烨","text":"寒蝉鸣野树，旅雁过秋蓬。\n岭外皆红叶，城边有绿桐。\n身虚苦夏热，多病爱清风。\n山色犹然在，人颜渐不同。\n幸无烽火事，喜有智神功。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37031,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"古北塞上望月","author":"玄烨","text":"桂树清光挂碧天，云开万里塞无烟。\n远人向背由敷政，惟在筹边与任贤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37032,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"康熙三十二年六月赐总督佛伦","author":"玄烨","text":"东表闻风化，西秦作雨霖。\n扬清知疾苦，激浊勉官箴。\n旷世孤芳节，超伦千古心。\n封疆资大吏，抚育代忧深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37033,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏燕新莲 其二","author":"玄烨","text":"丹桥绿柳啭黄鹂，碧涧深林对小池。\n睡起閒情题画箑，薰风动处乐雍熙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37034,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"初秋晚雨后观仪器","author":"玄烨","text":"从容更觉静悠悠，片片荷香送小舟。\n日落开窗云外景，风清拂户雨中秋。\n宽怀自有数行字，乐志须操一算筹。\n万物无穷最易晓，其间诸象列天球。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37035,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"初秋咏竹","author":"玄烨","text":"森萃青青绕碧塘，霜姿霭霭动幽香。\n寒风不变终身节，绿叶纷然映晚凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37036,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"閒坐咏竹","author":"玄烨","text":"门外千竿细竹，窗前万朵鲜花。\n秋寒众色皆变，惟尔霜姿可嘉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37037,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"咏金莲花","author":"玄烨","text":"迢递从沙漠，孤根待品题。\n清香拂槛入，正色与心齐。\n磊落安山北，参差鹫岭西。\n炎风曾避暑，高洁少人跻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37038,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"祝巴林淑慧大长公主诗","author":"玄烨","text":"长祝南山寿，愿言北斗诗。\n祥开应帝女，釐降自金枝。\n沙漠黎心服，坤贞天下知。\n年年庆人瑞，岁岁赏瑶池。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37039,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"戏题自鸣钟","author":"玄烨","text":"昼夜循环胜刻漏，绸缪宛转报时全。\n阴晴不改衷肠性，万里遥来二百年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37040,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日舟行","author":"玄烨","text":"灵液开仙仗，清晖映碧波。\n黄鹂鸣茂树，归雁戏青莎。\n水曲蒲帆转，岸回锦缆过。\n三春曾布德，月下听讴歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37041,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日幸潞河杂诗三首 其一","author":"玄烨","text":"水色连天四望收，轻舠桂楫放中流。\n东南惟有长江胜，一片云帆万里游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37042,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日幸潞河杂诗三首 其二","author":"玄烨","text":"曾记当年幸潞河，翠旌熠爚映微波。\n临流士女争瞻望，不禁扁舟唱棹歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37043,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日幸潞河杂诗三首 其三","author":"玄烨","text":"野云渐起罩斜阳，暮泊平沙觉水凉。\n初更未寝吟诗句，静见炉中焚异香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37044,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"亲阅运河堤","author":"玄烨","text":"旧岁阴霖胜，忧勤亿兆难。\n析津通鹊渚，形势接桑乾。\n物理常求治，朝堂亦自安。\n运堤久未整，岸堰最宜完。\n夹道黎民悦，沿河老幼欢。\n云容随豹尾，暑气拥仙銮。\n九酝贤人酒，三浆龙凤团。\n匡床搜典诰，流水奏幽兰。\n棹响逼前驾，渔歌进小滩。\n去回四百里，舟次五云端。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37045,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"舟泊潞河","author":"玄烨","text":"万里帆樯宛转来，炎天系缆泊河隈。\n长江曾著操舟说，短梦频思作楫才。\n隔水翛翛秋麦起，绕林处处野花开。\n从容披阅依书幌，静尔忘言忆九垓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37046,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"二月三十日亲统六军徂征漠北","author":"玄烨","text":"惟天尽所覆，眷命畀我清。\n自予莅鸿祚，恒愿销甲兵。\n狡焉窥北疆，属国横相撄。\n夙昔张挞伐，凶丑皆颠倾。\n赦之释不诛，开网全其生。\n怙终恣跳梁，边鄙摇群情。\n皇皇仁义师，声讨必有名。\n春雪洒贝胄，朔风捲龙旌。\n眷兹貙虎士，金革劳远征。\n于铄振我武，赫赫扬天声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37047,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"出居庸关","author":"玄烨","text":"群峰倚天半，直北峙雄关。\n古塞烟云合，清时壁垒閒。\n军锋趋朔漠，马迹度重山。\n渐向边城路，旌旗叠翠间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37048,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赤城","author":"玄烨","text":"慈宫曾驻此温泉，展转依稀廿五年。\n今日征途冰未解，当时冻岭雪还全。\n渐近边关风土别，长驱旌旆岳山连。\n孤城寒重深宵静，敢卜龙沙奏凯旋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37049,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"龙门","author":"玄烨","text":"绝巘何时凿五丁，双崖万仞辟门屏。\n潺湲塞水嵯峨石，振旅归来定勒铭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37050,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过独石口","author":"玄烨","text":"关名独石插遥天，路绕青冥绝嶂悬。\n翠壁千寻标九塞，黄云万叠护三边。\n霓旌晓度长城月，毳帐春回大漠烟。\n总为民生勤战伐，不辞筹画在中权。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37051,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"出塞训厉军士","author":"玄烨","text":"铁马金戈整六师，鼓行出塞暮春时。\n边尘尽埽从今始，莫让天山建绩奇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37052,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"北藩诸部君长来迎","author":"玄烨","text":"关山直北尽王臣，属国侵陵煽乱频。\n为靖边方勤士马，欲令藩落辑民人。\n声灵有赫群知肃，抃舞来同意倍亲。\n共睹此行清朔漠，保疆绥土俗还淳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37053,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沙漠二首 其一","author":"玄烨","text":"高下龙堆万马趋，直将漠外作疆隅。\n汉家只守飞狐岭，坐使中原失远图。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37054,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"沙漠二首 其二","author":"玄烨","text":"沙碛荒榆细柳多，步行不用蹀鸣珂。\n连朝登顿浑无倦，甘苦身先士荷戈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37055,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"风雪致祷遂尔晴霁","author":"玄烨","text":"塞外春深雨雪频，寒风犹自拂征尘。\n昨朝遣祀咨宗伯，已见遥天霁色新。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37056,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赐皇子允祉","author":"玄烨","text":"玉弩金戈壮此行，期门环卫在连营。\n深居莫忘勤劳意，须识间关出塞情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37057,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赐皇子允祐","author":"玄烨","text":"逆我颜行讨必加，六军严肃静无哗。\n分营此日如棋布，奋武群看捲塞沙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37058,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春寒轸念将士","author":"玄烨","text":"大漠春残雪尚飞，从征车马正騑騑。\n风回沙路迷金勒，寒送冰花上铁衣。\n每念折冲凭士气，况从绝徼奉天威。\n六军同奋赳桓志，伫见睛曛满翠旂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37059,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"途中新夏","author":"玄烨","text":"边草才青节序更，征裘未换入朱明。\n遥思南陌东阡候，正是居人急耦耕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37060,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"赐皇子允祀","author":"玄烨","text":"戎行亲莅制机宜，栉沐风霜总不辞。\n随侍晨昏依帐殿，焦劳情事尔应知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37061,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"帐殿对雨念畿辅四方农事","author":"玄烨","text":"气和时雨降，驻跸对荒陬。\n点点侵油幕，霏霏湿翠斿。\n未知同甸服，果足渥田畴。\n轸念民依切，驰书付置邮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37062,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"违皇太后定省言怀","author":"玄烨","text":"帐殿风高日影移，庭闱常忆问安时。\n寸心每自依清禁，慈念遥应系北陲。\n柔远肯教罹疾苦，除残焉敢惜胼胝。\n预期露布飞章入，早报瑶阶母后知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37063,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"行殿示诸皇子","author":"玄烨","text":"师行日已远，边马风萧萧。\n眷言靖疆宇，宁惮道路遥。\n彼寇邻北藩，谲谋声动摇。\n除恶必拔本，稂莠隳良苗。\n外攘内斯安，务令金甲销。\n吾民息转输，丁男无敝彫。\n一劳方永逸，所戒怠与骄。\n天心鉴此诚，雨旸时以调。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37064,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"营夜南望北斗","author":"玄烨","text":"碧琉璃界四垂边，渐觉云低欲到天。\n为问北来行近远，果然北斗挂南川。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37065,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雁栖沙碛","author":"玄烨","text":"为靖风尘夜不眠，平沙四顾断人烟。\n征夫欲度阴山外，北雁偏栖瀚海边。\n黩武诗书天子戒，惟仁经史帝王先。\n须看战垒生灵骨，吊古文章信可传。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37066,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"时乏水于山坡得泉志喜","author":"玄烨","text":"麾兵深入贼巢边，斯地从来乏水泉。\n报道六军齐饮马，清流山畔忽涓涓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37067,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"克鲁伦河上流雨后草生","author":"玄烨","text":"晚从岸曲驻前旌，雨歇行营草怒生。\n一望青青河上色，平芜共听马嘶声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":37068,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]