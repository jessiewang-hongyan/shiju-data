[{"title":"题湖山亭","author":"释敬安","text":"几树梅花遮矮屋，四围山色入空亭。\n深春有客乘舟至，冲破平湖一线青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2498,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"安贫吟 代南溪山人作","author":"释敬安","text":"平生甘淡泊，守拙安林泉。\n寒岩灶常冷，穷井雪难填。\n绳床不盈尺，茅屋才数掾。\n衣食虽不足，幸无尘事牵。\n贫贱可行乐，风月不论钱。\n有时游兴至，一身轻如烟。\n拄杖追白鹤，箬笠补青天。\n或坐古松边，自抚伯牙弦。\n或卧梅花下，高咏秋水篇。\n胸中随所适，孤云与之然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2499,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日漫兴与师老人作","author":"释敬安","text":"独处罕俦侣，草堂冬复春。\n涧花飞献佛，林鸟语亲人。\n白发吟情淡，青山道味真。\n寥寥尘境外，木石自为邻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2500,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"泊空岩上杜公亭","author":"释敬安","text":"杜老留题处，征帆又此停。\n水痕侵岸白，岳色向人青。\n樯燕飞何处，江猿不可听。\n劫来一凭眺，落叶满空亭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2501,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"访育王心长老作","author":"释敬安","text":"行行不觉远，入谷已残曛。\n松翠近可掬，泉声咽更闻。\n水清鱼嚼月，山静鸟眠云。\n寂寞双林下，烟霞长属君。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2502,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与长沙袁俊良总戎过育王岭","author":"释敬安","text":"日暮烟钟鸣，归路西风紧。\n夕阳在寒山，马蹄踏人影。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2503,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"别杨灵荃社友","author":"释敬安","text":"唱罢骊歌思悄然，山含落日水含烟。\n却愁今夜江头月，独照离人上客船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2504,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答吴燮堂","author":"释敬安","text":"我与青山有宿缘，住山不要买山钱。\n山中岁月如流水，才看梅花有一年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2505,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"正月二十五日过白云竹院","author":"释敬安","text":"暮逐闲云入竹房，梅花夹道澹生香。\n笑看孤塔离奇甚，瓦上松枝挂夕阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2506,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重过江畬","author":"释敬安","text":"莺啼花落故园春，一样风光独怆神。\n多少故交零落尽，归来翻似异乡人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2507,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"碧湖亭晚眺","author":"释敬安","text":"官春园里乱栖鸦，佳宴堂前日影斜。\n洗尽繁华一湖水，野风吹放白莲花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2508,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"麓山寺题瑰公房","author":"释敬安","text":"一室超诸有，禅扉夜不扃。\n山光四围碧，松色六朝青。\n鸟啄齐馀钵，猿窥请罢经。\n夜深人语寂，冥翠落空亭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2509,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"招徐叔鸿郎中李公孙伯强吕仙楼看雪","author":"释敬安","text":"积雪浩无际，登楼望眼宽。\n饥禽争树坠，远岫倚天寒。\n何忍独为乐，还期人共欢。\n寄言高卧者，来向画中看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2510,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜怀云崖禅友","author":"释敬安","text":"云外佳期才一晤，人间小别又三秋。\n谁知夜静溪声里，明月怀君独倚楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2511,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登空泠岩和杜工部次谢灵运七里濑韵","author":"释敬安","text":"舍舟运神游，登栈眩奇眺。\n洲渚屡旋复，岩石吒危峭。\n云窦滴馀润，洞隙纳微曜。\n凿险若神工，履阴疑鬼啸。\n遗物奏元功，观空得要妙。\n既惬青霞心，岂顾白衣诮。\n黄屋罗英灵，沧洲隐渔钓。\n取舍各有宜，殊首自同调。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2512,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"访瞿芷桓不遇","author":"释敬安","text":"每过问童子，长云不在家。\n寒花空映户，高柳自呜鸦。\n欲去意还驻，行吟日已斜。\n所思人不见，咫尺即天涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2513,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日得郭菊荪司马书","author":"释敬安","text":"黄云苍莽雁来疏，忽得秦中一纸书。\n提剑十年为客久，论交廿载识公初。\n荒烟古戍啼山鬼，落日边城策蹇驴。\n闻道秋来归思切，故山风雨梦樵渔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2514,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"论道","author":"释敬安","text":"石烂松枯懒问年，龙眠虎卧各安然。\n固知静者心多妙，莫怪山僧语太颠。\n大地平沈犹是妄，虚空粉碎未为禅。\n欲参最上真乘法，百尺竿头进步前。\n林间小住已年年，扫石为床枕木圆。\n闲剪溪云将衲补，淡收山翠当茶煎。\n半钩白堕岩前月，一线青来树里天。\n无事岩中时宴坐，浑忘十圣与三贤。\n身似孤云无定踪，南来三度听霜钟。\n人方见雁思乡讯，山亦悲秋见病容。\n佳句每从愁里得，故人多向客中逢。\n自爱未了头陀愿，辜负云峰几万重。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2515,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"白梅诗 其一","author":"释敬安","text":"了与人境绝，寒山也自荣。\n孤烟淡将夕，微月照还明。\n空际若无影，香中如有情。\n素心正宜此，聊用慰平生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2516,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暮秋偕诸子登衡阳紫云峰","author":"释敬安","text":"紫云最高处，飞锡共登临。\n秋老山容瘦，天寒木叶深。\n西风孤鸿唳，流水道人心。\n坐久林塘晚，寥寥钟梵音。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2517,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答尹和白","author":"释敬安","text":"镇日焚香礼翠微，松花落满水田衣。\n柴门寂历生幽草，除却孤云客到稀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2518,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将之南海赋别","author":"释敬安","text":"旧院安禅处，经年锡一临。\n欲辞溪涧水，去听海潮音。\n白发怜师老，青山怅别深。\n空门本无我，那有去来心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2519,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玛瑙寺怀古","author":"释敬安","text":"地僻云深少客来，梵王宫殿尽尘埃。\n凄凉一片西湖月，犹照生公旧讲台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2520,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"与与了上人话旧","author":"释敬安","text":"当时楚水岳云间，持钵从游鬓未斑。\n一十二年如电拂，白头相对话岐山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2521,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送元松上人还日本","author":"释敬安","text":"沧海渺无极，乡关何处边。\n归帆遥向日，岛树远含烟。\n洗钵鲸吞水，窥斋鸟入船。\n此行应不负，了悟大乘禅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2522,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒黄庭观","author":"释敬安","text":"偶乘独往意，来谒魏元君。\n谷黯松杉合，天清鸾鹤闻。\n灵芝含秀色，仙石绣苔纹。\n坐久诸缘息，晴空生片云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2523,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梦登岳阳楼观湖中大雨作","author":"释敬安","text":"天地忽异色，元阴合一湖。\n迅雷翻地轴，高浪蹴天衢。\n风雨作远止，鱼龙喘未苏。\n但令膏泽遍，何敢怨泥涂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2524,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雷池晚眺","author":"释敬安","text":"层峦忽已暝，稚子语烟深。\n欲问入山路，惟闻流水音。\n闲云不出岫，倦鸟自投林。\n万古雷池月，泠然鉴我心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2525,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠漱石和尚","author":"释敬安","text":"漱公法门旧，头白卧青岑。\n借问看云意，能无出岫心。\n烟萝身外满，岁月定中深。\n不动广长舌，松杉演妙音。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2526,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"高台寺观念庵松","author":"释敬安","text":"高台寒雪晓相过，爱看松枝挂碧萝。\n珍重枯禅勤护惜，念庵手植已无多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2527,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏怀诗十首 其一","author":"释敬安","text":"昔余慕灵异，南游经九疑。\n复泛蓬山舟，远游浮丘期。\n隆冬草木茂，朱华何葳蕤。\n湘灵拊瑶瑟，海若扬桂旗。\n仙人隔烟语，贻我琼树枝。\n云此最吉祥，佩之忘忧思。\n长跪谢仙人，此物非我宜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2528,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏怀诗十首 其二","author":"释敬安","text":"我本自在仙，一念落人间。\n人羊既更易，识性亦推迁。\n舍身复受身，来去如轮旋。\n白骨何峨峨，高于毗富山。\n已忍多生恸，乐土何由还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2529,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏怀诗十首 其三","author":"释敬安","text":"疾风扬波涛，起灭无端倪。\n波波相续流，宁复住斯须。\n嗟余久沉沦，泊然无止依。\n真源失湛寂，谁能鉴渊微。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2530,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏怀诗十首 其四","author":"释敬安","text":"步出城西门，高坟何累累。\n年深坟土裂，白骨委蒿莱。\n坟傍哭者谁，云是白骨儿。\n生既为死泣，死亦待生悲。\n哀哉亿千劫，无有泪绝时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2531,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏怀诗十首 其五","author":"释敬安","text":"弱龄逢丧乱，田园逐萧条。\n坐为衣食故，豪门屈见招。\n顾无五斗禄，宁折壮士腰。\n拂衣谢城阙，高步淩风霄。\n金仙虽云远，灵鹫尚岧峣。\n超然方外游，永用泯尘劳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2532,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏怀诗十首 其六","author":"释敬安","text":"去岁展先茔，路栖桑树边。\n村老向我言，此桑齐汝年。\n汝父昔在时，耕此桑下田。\n人牛今无迹，兹意复谁怜。\n感此不能语，涕下如流泉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2533,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏怀诗十首 其七","author":"释敬安","text":"余生秉微尚，块独甘云栖。\n幽涂盛荆棘，兰蕙何离披。\n鸱鸮相叫啸，猿狖复鸣悲。\n真如既不变，万有徒纷驰。\n将舍有漏身，一饱豺虎饥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2534,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏怀诗十首 其八","author":"释敬安","text":"吾钦忍辱仙，运心仁且慈。\n手持如意珠，百劫行檀施。\n宏法亦已勤，六师谬见疑。\n冤亲普平等，焦芽同时滋。\n智果既圆成，永为天人师。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2535,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏怀诗十首 其九","author":"释敬安","text":"少读高僧传，抗志希远公。\n澄神五峰表，灭影二林中。\n迟回虎溪月，缅想刘雷踪。\n斯人邈千载，莲漏犹未终。\n涔涔浔阳潮，汩汩恨何穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2536,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏怀诗十首 其十","author":"释敬安","text":"我闻安养国，贤圣俱栖迟。\n讲堂极壮丽，行树相因依。\n湛湛七宝池，矫矫珍禽飞。\n金绳界道明，天乐随风移。\n衣食应念至，不假人力为。\n文殊既戾止，慈氏亦来仪。\n长揖三界苦，永绝四流悲。\n逝辞五浊世，金手引同归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2537,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟《谢康乐维摩经十譬赞》八首 其一","author":"释敬安","text":"觉海性元澄，云何泡沫聚。\n境界风所吹，虚壑自相鼓。\n认沤岂全潮，识流匪异体。\n谁为达观者，真源亦无取。\n水性本无泡，激流遂聚沫。\n即异成貌状，消散归虚豁。\n君子识根本，安事劳与夺。\n愚俗骇变化，横复生欣怛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2538,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟《谢康乐维摩经十譬赞》八首 其二","author":"释敬安","text":"晴虚本无翳，阳焰何由生。\n扰扰宁暂住，渴鹿徒驰情。\n真空任起灭，明性无减增。\n智者鉴其微，元同一见精。\n性内相表状，非焰安知火。\n新新相推移，荧荧非问我。\n如何滞著人，终岁迷因果。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2539,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟《谢康乐维摩经十譬赞》八首 其三","author":"释敬安","text":"芭蕉本佳卉，绿叶方丛生。\n内心匪坚实，外观亦清英。\n未霜已零落，谁忆昔时荣。\n生分本多端，芭蕉知不一。\n合萼不结核，敷花何由实。\n至人善取譬，无宰谁能律。\n莫昵缘合时，当视分散日。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2540,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟《谢康乐维摩经十譬赞》八首 其四","author":"释敬安","text":"幻聚眩流目，众巧归我神。\n能为城郭状，亦现男女身。\n愚夫昧取舍，横复生爱瞋。\n逝者复如斯，谁言此非真。\n幻工作同异，谁复谓非真。\n一从逝物过，既往亦何陈。\n谬者疑久近，达者皆自宾。\n勿起离合情，会无百代人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2541,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟《谢康乐维摩经十譬赞》八首 其五","author":"释敬安","text":"孰谓识性同，同寝各异见。\n妄境故无恒，真如了不变。\n梦觉俱强名，好恶谁与辨。\n哂彼执著人，尚为浮物恋。\n觉谓寝无知，寐中非无见。\n意状盈明前，好思迭万变。\n既悟眇已往，惜为淳物恋。\n孰视娑婆尽，宁当非赤县。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2542,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟《谢康乐维摩经十譬赞》八首 其六","author":"释敬安","text":"大道寓影响，谁复知此理。\n是中无实性，群有妄相拟。\n本自绝名言，云何立彼此。\n运心平等观，一任空华起。\n影响顺形声，资物故生理。\n一旦挥霍去，何因得像似。\n群有靡不然，昧漠呼自己。\n四色尚无本，八微欲安恃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2543,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟《谢康乐维摩经十譬赞》八首 其七","author":"释敬安","text":"浮云匪定质，变幻谁能测。\n氤氲翳太虚，飞散穷顷刻。\n含润若有施，观空了无得。\n前尘虽云妄，转用资神识。\n泛滥明月阴，荟蔚南山雨。\n能为变动用，在我竟无取。\n俄已就飞散，岂复得攒聚。\n诸法既无我，何由有我所。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2544,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟《谢康乐维摩经十譬赞》八首 其八","author":"释敬安","text":"寥寥天宇廓，流电时一惊。\n奄忽不可见，神迅谁与伦。\n狂心倘可歇，智眼自圆明。\n勿用世间想，貌彼虚空情。\n倏烁惊电过，可见不可逐。\n恒物生灭后，谁复核迟速。\n慎勿空留念，横使神理恧。\n发巳道易孚，忘情长之福。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2545,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宴坐有得","author":"释敬安","text":"兰若凝禅寂，柴门镇日关。\n定中惟见水，身外忽忘山。\n神理虽自悟，太虚宁可颜。\n了然清净义，不在语言间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2546,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠易与凡","author":"释敬安","text":"拔剑高歌对酒卮，酒酣为说戍边时。\n梦随关月还家远，马踏河冰出塞迟。\n青冢至今馀汉碣，黄沙终古陷秦师。\n怜君万里封侯愿，赢得西风两鬓丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2547,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"赠周生","author":"释敬安","text":"满眼风尘色，怜君独此过。\n浮生同旅泊，失路未蹉跎。\n谁道朱门贵，其如白发何。\n幽栖吾所愿，还与觅烟萝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2548,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"边将","author":"释敬安","text":"白首尚谈兵，恩深任死生。\n大旗翻乱雪，归马怯空城。\n汉将日寥落，匈奴扫未平。\n黄云连朔漠，辛苦且长征。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2549,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宿西来禅院","author":"释敬安","text":"万树丹枫色，亭亭映夕阳。\n远山晴更翠，寒菊晚犹芳。\n竹户云侵榻，松林鹤语霜。\n禅心爱秋月，久坐为清光。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2550,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暮秋书怀","author":"释敬安","text":"渺渺身何往，萧萧鬓已斑。\n乱云生树密，秋雨闭门闲。\n有爱都妨道，无心更买山。\n只愁孤笠影，乞食到人间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2551,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"辞明州太守宗公湘文请住仗锡山寺","author":"释敬安","text":"万壑千岩深复深，此山真是四明心。\n诛茅欲就云间住，恐有樵人远见寻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2552,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"太守得偈坚请不已复此示意","author":"释敬安","text":"多年枯木已无枝，那得犹蒙大匠知。\n只合寒岩煨芋用，法门梁栋总非宜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2553,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒岳武穆祠有感","author":"释敬安","text":"南渡偏安国已亡，宫祠墓木尚苍苍。\n士无奇节名难著，地有忠魂草也香。\n风雨湖山犹感恨，往来樵牧亦凄凉。\n若教二帝生时返，血泪人谁洒夕阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2554,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"佛迹","author":"释敬安","text":"佛身无去亦无留，那有行踪在石头。\n想是山神嫌寂静，妆成圣迹引人游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2555,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"色空无碍颂","author":"释敬安","text":"树枯自回春，心空岂滞境。\n灵溪虽湛然，不拒花枝影。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2556,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暑月访龙潭寄禅上人","author":"释敬安","text":"一瓶一钵一诗囊，十里荷花两袖香。\n只为多情寻故旧，禅心本不在炎凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2557,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题王专农观察台警夜渡图二首 其一","author":"释敬安","text":"神州论险要，台峤信孤悬。\n海阔鱼龙夜，心伤战伐年。\n曾闻木罂渡，竟过水雷前。\n虎穴身能入，英风尚凛然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2558,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题王专农观察台警夜渡图二首 其二","author":"释敬安","text":"小丑宁难灭，王师岂在多。\n初传横海捷，仍许郅支和。\n太息援边诏，空挥返日戈。\n披图话陈迹，凄恻汉山河。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2559,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湖口吊高伯足","author":"释敬安","text":"高生才调冠三吴，为问人间尚有无。\n今日却过湖口县，乱山无语夕阳孤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2560,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江亭","author":"释敬安","text":"江亭聊远眺，暝色郁苍苍。\n孤屿吐寒翠，万山争夕阳。\n旋看秋月朗，空使野云忙。\n万古潇湘水，东流接海长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2561,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"效龚定庵体两首 其一","author":"释敬安","text":"坐破千潭水月痕，寒灰一寸偶然温。\n空观假观中道观，待与台宗学者论。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2562,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"效龚定庵体两首 其二","author":"释敬安","text":"念佛三昧世少信，惟有无为子亲證。\n乐邦消息近云何，为我莲台一问讯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2563,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]