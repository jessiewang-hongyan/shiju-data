[{"title":"日本杂事诗 其八","author":"黄遵宪","text":"狐篝牛柩善愚民，百济新罗悉主臣。\n腰石手弓亲入阵，浪传女国出神人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13629,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其九","author":"黄遵宪","text":"女王制册封亲魏，天使威仪拜大唐。\n一自覆舟平户后，有人裂诏毁冠裳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13630,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其十","author":"黄遵宪","text":"载书新付大司藏，银汉星槎夜有光。\n五色天章云灿烂，争夸皇帝问倭皇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13631,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其十一","author":"黄遵宪","text":"鳄吼鲸呿海夜鸣，捧书执耳急联盟。\n群公衮衮攘夷策，独幸尊王藉手成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13632,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其十二","author":"黄遵宪","text":"玉墙旧国纪维新，万法随风倏转轮。\n杼轴虽空衣服粲，东人赢得似西人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13633,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其十三","author":"黄遵宪","text":"羲和有国在空桑，手握灵枢八极张。\n今世日官翻失御，如何数典祖先忘？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13634,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其十四","author":"黄遵宪","text":"纪年史创春王月，改朔书焚《夏小正》。\n四十余周传甲子，竟占龟兆得横庚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13635,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其十五","author":"黄遵宪","text":"神仙楼阁立虚空，海飓狂吹压屋风。\n四面涛声聋两耳，终年如住浪华中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13636,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其十六","author":"黄遵宪","text":"巨海茫茫浸四围，三山风引是耶非？\n蓬莱清浅经多少？\n依旧蜻蜓点水飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13637,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其十七","author":"黄遵宪","text":"翠华驰道草萧萧，深院无人锁寂寥。\n多少荣花留物语，白头宫女说先朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13638,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其十八","author":"黄遵宪","text":"前朝霸主识龙蟠，富岳荒川极大观。\n留与东迁新定鼎，万家春树锦城宽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13639,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其十九","author":"黄遵宪","text":"九州地脉阻昆仑，裨海环瀛水作门。\n圆峤方壶虽妄语，分明世外此桃源。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13640,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其二十","author":"黄遵宪","text":"萨摩材武名天下，水户文章世不如。\n几辈磨刀上马去，一家修史闭门居。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13641,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其二十一","author":"黄遵宪","text":"舟鲛衡鹿富良材，椎结夷风草昧开。\n昨夕屠鲸今射虎，明朝跣足读书来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13642,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其二十二","author":"黄遵宪","text":"一洲桦太半狉榛，瓯脱中居两国邻。\n罗刹黑风忽吹去，北门管钥付何人？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13643,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其二十三","author":"黄遵宪","text":"拔地摩天独立高，莲峰涌出海东涛。\n二千五百年前雪，一白茫茫积未消。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13644,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其二十四","author":"黄遵宪","text":"濯足扶桑海上行，眼中不见大河横。\n只应拄杖寻云去，手挈卢敖上太清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13645,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其二十五","author":"黄遵宪","text":"一震雷惊众籁号，沉沉地底涌波涛。\n累人日夜忧天坠，颇怨灵鳌戴末牢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13646,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其二十六","author":"黄遵宪","text":"倚天铜佛古于树，挂月玉镜寒生苔。\n对人露立总不语，曾见源平战斗来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13647,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其二十七","author":"黄遵宪","text":"石塔光明照夜灯，武尊宫阙郁觚棱。\n至今洒涕吾孀语，携酒相寻白鸟陵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13648,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其二十八","author":"黄遵宪","text":"南朝往事久灰尘，岁岁樱花树树春。\n手挈铜铃拜遗像，呜呼碑下吊忠臣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13649,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其二十九","author":"黄遵宪","text":"芝山宫殿剩丰碑，摇动春风见菟葵。\n二百余藩齐洒涕，不堪哀诵《式微》诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13650,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其三十","author":"黄遵宪","text":"臣连伴造称官氏，藤橘源平数世家。\n将相王侯真有种，至今寥落族犹华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13651,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其三十一","author":"黄遵宪","text":"国造分司旧典刊，百僚亦废位阶冠。\n紫泥钤印青头押，指令惟恁太政官。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13652,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其三十二","author":"黄遵宪","text":"议员初撰欣登席，元老相从偶踌闾。\n岂是诸公甘仗马？\n朝廷无阙谏无书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13653,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其三十三","author":"黄遵宪","text":"堂堂黼座设朝仪，神武初元立国时。\n一百一声闻祝炮，满城红日早悬旗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13654,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其三十四","author":"黄遵宪","text":"肘挟毡冠插锦貂，肩盘金缕系红绡。\n前趋客座争携手，俯拜君前小折腰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13655,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其三十五","author":"黄遵宪","text":"金菊花浓罽幕张，鸡冠剑佩立成行。\n司书载笔司勋赏，拜手重光旭日章。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13656,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其三十六","author":"黄遵宪","text":"减租恩诏普醲膏，硕鼠疲民敢告劳。\n归语老农吾土乐，宽仁长戴帝天高。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13657,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其三十七","author":"黄遵宪","text":"剪纸频将花样翻，司农用印不辞烦。\n法同手实名头会，绝少催租吏到门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13658,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其三十八","author":"黄遵宪","text":"左券都凭官契来，鼠牙雀角不疑猜。\n若非一纸文书在，无地能容避债台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13659,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其三十九","author":"黄遵宪","text":"六干五均官尽备，踦零都数法俱严。\n禁烟禁酒工言利，独握牢盆不道盐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13660,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其四十","author":"黄遵宪","text":"闻说和铜始纪年，孔方渐变椭成圆。\n通神使鬼真能事，土价如金纸作钱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13661,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其四十一","author":"黄遵宪","text":"铸山难得矿常开，永乐钱荒不再来。\n海外有商争利薮，国中何地筑謻台？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13662,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其四十二","author":"黄遵宪","text":"中将登坛妙指挥，宫妃鹄立亦戎衣。\n连环拐马连珠炮，更请君王看一围。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13663,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其四十三","author":"黄遵宪","text":"拜手中臣罪祓除，探汤剪爪仗神巫。\n竟将老子箧中物，看作司空城旦书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13664,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其四十四","author":"黄遵宪","text":"《棠阴比事》费参稽，新律初颁法未齐。\n多少判官共吟味，按情难准佛兰西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13665,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其四十五","author":"黄遵宪","text":"春风吹锁脱琅珰，夕餔朝糜更酒浆。\n莫问泥犁诸狱苦，杀身亦引到天堂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13666,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其四十六","author":"黄遵宪","text":"时检楼罗日历看，沈沈官屋署街弹。\n市头白鹭巡环立，最善鸠民是鸟官。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13667,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其四十七","author":"黄遵宪","text":"照海红光烛四围，弥天白雨挟龙飞。\n才惊警枕钟声到，已报驰车救火归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13668,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其四十八","author":"黄遵宪","text":"火齐珠悬照夜光，粉墙碧瓦第相望。\n白桑板记公卿姓，紫逻途联左右坊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13669,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其四十九","author":"黄遵宪","text":"新绿在树残红稀，荒园菜花春既归。\n堂前燕子亦飞去，金屋主人多半非。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13670,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其五十","author":"黄遵宪","text":"维摩丈室洁无尘，药鼎茶瓯布置匀。\n导脉竹筳窥脏镜，终输扁鹊见垣人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13671,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其五十一","author":"黄遵宪","text":"博物千间广厦开，纵观如到宝山回。\n摩挲铜狄惊奇事，亲见委奴汉印来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13672,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其五十二","author":"黄遵宪","text":"握要钩元算不差，网罗细碎比量沙。\n旁行斜上同周法，治谱谁知出史家？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13673,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其五十三","author":"黄遵宪","text":"欲知古事读旧史，欲知今事看新闻。\n九流百家无不有，六合之内同此文。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13674,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其五十四","author":"黄遵宪","text":"削木能飞诩鹊灵，备梯坚守习羊坽。\n不知尽是东来法，欲废儒书读墨经。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13675,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其五十五","author":"黄遵宪","text":"《化书》《奇器》问新编，航海遥寻鬼谷贤。\n学得黎鞬归善眩，逢人鼓掌快谈天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13676,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其五十六","author":"黄遵宪","text":"五经高阁竟如删，太学诸生守《兔园》。\n犹有穷儒衣逢掖，著书扫叶老名山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13677,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其五十七","author":"黄遵宪","text":"欲争齐楚连横势，要读孙吴未著书。\n缩地补天皆有术，火轮舟外又飞车。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13678,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其五十八","author":"黄遵宪","text":"深院梧桐养凤凰，牙签锦悦浴恩光。\n绣衣照路鸾舆降，早有雏姬扫玉床。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13679,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其五十九","author":"黄遵宪","text":"捧书长跪藉红毹，吟罢拈针弄绣襦。\n归向爷娘索花果，偷闲钩出地球图。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13680,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其六十","author":"黄遵宪","text":"联袂游鱼逐队嬉，捧书挟策雁行随。\n打头栗凿惊呼謈，怅忆儿童逃学时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13681,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其六十一","author":"黄遵宪","text":"国学空传卜部名，三轮寺额未分明。\n天然丨刂横纵画，万国翻同堕地声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13682,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其六十二","author":"黄遵宪","text":"东方乐久忘夷靺，上古文难辨隶蝌。\n欲藉舌人通寄象，只须五字熟摩多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13683,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其六十三","author":"黄遵宪","text":"航海书来道遂东，虚辞助语惜难通。\n至今再变祛卢字，终恨王仁教未工。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13684,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其六十四","author":"黄遵宪","text":"《论语》初来文尚古，《华严私记》字无讹。\n老僧多事工饶舌，假字流传伊吕波。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13685,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其六十五","author":"黄遵宪","text":"不难三岁识之无，学语牙牙便学书。\n春蚓秋蛇纷满纸，问娘眠食近何如？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13686,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其六十六","author":"黄遵宪","text":"难得华同是语言，几经重译几分门？\n字须丁尾行间满，世世仍凭洛诵孙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13687,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其六十七","author":"黄遵宪","text":"博士来从继体初，《五经》亦自劫灰余。\n航头古典欺人语，何处琅环觅异书？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13688,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其六十八","author":"黄遵宪","text":"《论语》皇疏久代薪，海神呵护尚如新。\n《孝经》亦有康成注，合付编摩《郑志》人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13689,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其六十九","author":"黄遵宪","text":"西条书记考文篇，曾入琳琅甲乙编。\n道学儒林寻列传，东方君子国多贤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13690,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其七十","author":"黄遵宪","text":"斯文一脉记传灯，四百年来付老僧。\n始变儒冠除法服，林家孙祖号中兴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13691,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其七十一","author":"黄遵宪","text":"海外遗民竟不归，老来东望泪频挥。\n终身耻食兴朝粟，更胜西山赋《采薇》。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13692,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其七十二","author":"黄遵宪","text":"昌平庙貌尚崔巍，列郡胶庠半劫灰。\n几辈龂断守残缺，捧经抱器拜门来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13693,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其七十三","author":"黄遵宪","text":"叩阍哀告九天神，几个孤忠草莽臣？\n断尽臣头臣笔在，尊王终赖读书人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13694,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其七十四","author":"黄遵宪","text":"纪事编年体各存，黄门自立一家言。\n《兵》《刑》志外征文献，深恨人无褚少孙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13695,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其七十五","author":"黄遵宪","text":"《徂徕》而外有《山阳》，余子文章亦擅场。\n南驾越裳北高丽，六鳌晓策耀扶桑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13696,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其七十六","author":"黄遵宪","text":"观风若采《扶桑集》，压卷先编《侍宴诗》。\n读尽《凌云》兼《丽藻》，终推帝子独工辞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13697,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其七十七","author":"黄遵宪","text":"岂独斯文有盛衰，旁行字正力横驰。\n不知近日鸡林贾，谁费黄金更购诗？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13698,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其七十八","author":"黄遵宪","text":"一千五百年前纸，在在神灵为护持。\n如见古人如见佛，焚香百拜展经时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13699,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其七十九","author":"黄遵宪","text":"铁壁能逃劫火烧，金绳几缚锦囊苞。\n彩鸾《诗韵》《公羊传》，颇有唐人手笔钞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13700,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其八十","author":"黄遵宪","text":"竭民膏血造浮屠，佞佛甘称三宝奴。\n匹马出宫偷祝发，上皇尊号半僧徒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13701,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其八十一","author":"黄遵宪","text":"佛阁沉沉覆黑天，黄标百万数堆钱。\n大师自主鸳鸯寺，梵嫂同参鹦鹉禅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13702,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其八十二","author":"黄遵宪","text":"不须偏袒覆袈裟，唤作山僧未出家。\n却变神山称佛国，只须一语妙莲华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13703,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其八十三","author":"黄遵宪","text":"乘槎浮海寄深叹，象法东来遍佛坛。\n独有青牛出关去，流沙遥隔路漫漫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13704,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"日本杂事诗 其八十四","author":"黄遵宪","text":"万头骈刃血模糊，脚踏升天说教图。\n今日铸金悬十字，几人宝塔礼耶稣？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":13705,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]