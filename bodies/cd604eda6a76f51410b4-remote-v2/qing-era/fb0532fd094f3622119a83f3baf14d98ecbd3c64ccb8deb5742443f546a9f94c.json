[{"title":"海音诗","author":"刘家谋","text":"五虎长牙舞爪来，秋风避债竟无台。\n惊心昨夜西邻哭，掌上明珠去不回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2771,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"九抽敢把禁条违，飞去青蚨忽自归。\n寄语杜陵头白叟，可堪日日典春衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2772,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"锻矛砺刃卫边垠，恰有三郊比鲁人。\n水债不收公饷亟，头家近日亦愁贫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2773,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"千金送女亦寻常，翠绕珠围各斗强。\n底事一经思教子，翻愁破费束修羊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2774,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"劳身犹足博饔餐，岁暮无衣意亦宽。\n不怕饥寒宁怕死，自家断送入三棺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2775,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"怀中刺灭少遭逢，回首家山路万重。\n典尽征衫归未得，几人渌水傍芙蓉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2776,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"一死都缘抚字劳，不徒冰雪励清操。\n鸡笼山下舆人在，歌罢前曹复后曹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2777,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"迎年饯腊事休论，爆竹声中欲断魂。\n争得城西黄太学，一囊夜半忽敲门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2778,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"纷纷番割总殃民，谁似吴郎泽及人。\n拚却头颅飞不返，社寮俎豆自千春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2779,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"海音诗","author":"刘家谋","text":"辛苦耕渔朝暮偕，饥来薯米爨牛柴。\n煌煌六十年中纪，贞节如林聚一涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2780,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台阳竹枝词 其一","author":"蔡碧吟","text":"宜晴宜雨好时光，草粿糖浆制备忙。\n招得东邻诸姊妹，踏青齐拜五妃娘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2781,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台阳竹枝词 其二","author":"蔡碧吟","text":"谷雨携筐摘嫩芽，大棚顶畔是侬家。\n一瓯茗试清泉好，郎有閒时来吃茶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2782,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日村居杂感 其一","author":"蔡碧吟","text":"榕阴叠叠竹萧萧，出水秧针绿意饶。\n几簇人声喧渡口，半江夕照卖鱼苗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2783,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日村居杂感 其二","author":"蔡碧吟","text":"几天积雨沾新泥，苔径深林鹑鸟啼。\n野水石梁初涨满，半江萍影绿东西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2784,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"移家","author":"郑应球","text":"淡泊无营意自宽，移家东郭近林峦。\n鸟吟白日春前树，人整青山竹外冠。\n张老已知成室美，渊明但取敝庐完。\n由来物理难齐论，聊借鹪鹩信所安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2785,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"丁酉1897仲秋感怀","author":"郑鹏云","text":"踏遍槐黄迹已陈，磨穿铁砚暗伤神。\n功名有分三生定，时事如棋一局新。\n五度秋风曾老我，二分明月正怀人。\n瀛东多少观光客，桂籍留题话宿因。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2786,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"吊郑成功","author":"郑鹏云","text":"已从金厦据双门，还要骑鲸到七鲲。\n能使红毛归故物，敢将赤手抗中原。\n英风飒爽飞鸾岛，旧雨凄凉梦蝶园。\n三百年来明养士，如君才算报君恩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2787,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"太平岩在鹭门之东相传为先世延平郡王读书处外镌有石笑两字书此志感","author":"郑鹏云","text":"石不能言笑口开，读书深处有莓苔。\n草鸡莫问当年事，鲲海骑鲸去不回。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2788,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋雁用王渔洋秋柳原韵","author":"郑鹏云","text":"江干红树不禁霜，秋满长空水满塘。\n似尔寒声来荻渚，有人乡思起车箱。\n关临塞漠屯刘沔，池筑睢阳忆孝王。\n孤馆酒醒天欲暮，斜阳衰草度閒坊。\n平沙秋雨冷毛衣，粒食依人早识非。\n缥缈晴空排字起，迢遥绝塞寄书稀。\n孤城戍角临风泪，落木寒江背雪飞。\n枨触弟兄分别后，天涯只影永睽违。\n沙眠水宿总相怜，极目平芜下乱烟。\n衡浦声沉云漠漠，潇湘愁入雨绵绵。\n雪痕印后成千里，霜信衔来又一年。\n多少江楼征妇泪，西风落日盼穷边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2789,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"一洞天","author":"卢九围","text":"独有溪南一洞天，碧沙红树隐高贤。\n客来欲觅桃源路，借问刘郎前度年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2790,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"落花","author":"卢九围","text":"何处韶光不可怜，底须花落惜花妍。\n文章虽假知天意，色相皆空悟夙缘。\n香爱扑衣沾露好，舞宜送酒趁风前。\n残枝无计留春住，蜂蝶纷纷一惘然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2791,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"游冈山 其一","author":"卢九围","text":"翠巘青岚日影迟，行吟正好及春时。\n看花人向层峦立，绝似王维画里诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2792,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"游冈山 其二","author":"卢九围","text":"突兀寒岩翠作梯，暂从开士共幽栖。\n夜夜落月疑天外，笑指银湾接海低。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2793,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台阳山川风物迥异中土因就游览所及志之以诗","author":"卢观源","text":"瀛海汪洋环四面，突起层岚开平衍。\n红毛近峙赤嵌城，澎湖外口相制牵。\n鹿耳鲲身沙浅淤，海艘出入凭一线。\n南北悠悠二千里，天府雄城控四县。\n东南一派枕高山，屴崱云端不可攀。\n山外海天知何处，舟楫从无此往还。\n地势蜿蜒俨屏翰，拥护全台曲且湾。\n面挹波涛临广岸，一望平原烟雾间。\n平原土壤美而肥，海港交横草菲菲。\n更有山溪资灌溉，桑麻万顷映晴晖。\n涓涓细流皆汇海，万水朝宗并西归。\n此在川流真罕见，南东其亩尽皆非。\n洪炉鼓涛果属奇，有山如玉照玻璃。\n显晦无常殊众岫，皎光恒见冬春时。\n玉案山腰水出火，源泉百沸燄如炊。\n并系中原稀有事，异见异闻孰不疑。\n一区迥分南与北，鸡笼山头雪未蚀。\n凤邑寒冬早放犁，三月陇间收种植。\n果蔬花卉发先期，锄耰随地可觅食。\n岁丰足抵三年耕，不知含鼓歌谁德。\n忆昔伪郑据台阳，居人番族走欲僵。\n干戈组练填海岸，荡平原野罢耕桑。\n横征贾舶充军饷，洎索富民及酒浆。\n幸蒙圣朝诛反侧，一朝清明景运昌。\n洎令休养届百年，邦称庶富泽绵绵。\n胶庠文物遍郡县，修竹围中起诵弦。\n仕宦科名侔上国，拖青泥紫或占先。\n声教覃敷及异类，雕题黑齿解耕田。\n雕黑本自夷人俗，旧与生番同族属。\n于今部落入编氓，火食安居植谷粟。\n夫唱妇随勤操作，租税公旬受约束。\n粗习经书暂有人，弹冠振衣宁局蹐。\n复睹生番半归诚，甲螺丁壮并隶名。\n射猎啖腥窜山谷，岁输皮贡当薄徵。\n赤身无分寒与暑，聊蔽下体披棘荆。\n时隆不矜长驾术，要使羁縻乐太平。\n洪惟盛世防范周，文臣武将竞宣猷。\n水师船摆虬龙势，柳营玉帐驿路稠。\n牧民选用廉能吏，辑宁海国运良筹。\n即今生众日繁衍，皞熙有象德行流。\n鲰生才拙典閒曹，旷览瀛壖兴倍豪。\n未闻竹箭镖鎗悍，祇见浑噩气象高。\n海氛不染长天碧，潮汐晏如乏怒涛。\n敉宁是处歌乐土，发箧何须讲六韬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2794,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寒食日诸罗署中偶作 其一","author":"谢本量","text":"百花开放出墙头，隔岁榴红子未收。\n细雨东风作寒食，故山西望海云稠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2795,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寒食日诸罗署中偶作 其二","author":"谢本量","text":"草房密密下重帘，三月春寒较腊严。\n万井春烟谁禁火，卖饧时节雨廉纤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2796,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寒食日诸罗署中偶作 其三","author":"谢本量","text":"檨花如雪饲金鱼，小院阴浓绿不除。\n春色尚留三分一，盘中已荐夏秋蔬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2797,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寒食日诸罗署中偶作 其四","author":"谢本量","text":"春愁如醉篆烟寒，昼倦抛书午梦残。\n刚到故园云忽断，角声吹破倚栏杆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2798,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日按部北路即事 其一","author":"觉罗四明","text":"行行朱盖漾青阳，岸柳墙花满路香。\n更喜西畴时雨足，葱茏弥望长苗秧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2799,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日按部北路即事 其二","author":"觉罗四明","text":"溪山处处罩云烟，密箐深林响百泉。\n隐隐竹围声远近，无腔短笛乐尧天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2800,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日按部北路即事 其三","author":"觉罗四明","text":"拈香负弩致殷勤，童叟喧传旧使君。\n番社久安耕耨业，糍盘竞献倍含欣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2801,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日按部北路即事 其四","author":"觉罗四明","text":"蛮娘襁负小番娃，拥立低檐语笑哗。\n遮莫蓬头并跣足，春来满插鬓边花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2802,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日按部北路即事 其五","author":"觉罗四明","text":"大甲溪深未易过，尤憎虎尾聚奸多。\n年来设戍勤持护，一道长光映绿莎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2803,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"春日按部北路即事 其六","author":"觉罗四明","text":"玉嶂鸡峰两度行，难驯凿齿最关情。\n而今揽辔重循历，须鬓霜侵又几茎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2804,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送余刺史宝冈秩满入觐即次留别元韵 其一","author":"觉罗四明","text":"惟君才卓荦，事业表堂皇。\n闽峤拊循遍，路岐姓字香。\n昨予衔新命，仍复到海疆。\n旧雨欢同地，藉商济时方。\n伟哉贤刺史，僚属共瞻望。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2805,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送余刺史宝冈秩满入觐即次留别元韵 其二","author":"觉罗四明","text":"偻指永朝夕，三过夏日暄。\n正拟资规画，言将返鹭门。\n君殷榆柳思，谓可谢笼樊。\n鲲身与鹿耳，依依雨露恩。\n相戒息波涛，鸣橹送朱轓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2806,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送余刺史宝冈秩满入觐即次留别元韵 其三","author":"觉罗四明","text":"计日趋彤庭，天颜应有喜。\n嘉乃守东宁，下车走狂兕。\n果断锄稂莠，仁和护荪芷。\n番民勤力穑，菽粟如水火。\n东南千里地，宸听歌乐只。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2807,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送余刺史宝冈秩满入觐即次留别元韵 其四","author":"觉罗四明","text":"尝读月令记，孟秋缮囹圄。\n三年一空之，仁政群嘉予。\n汪汪千顷波，湛恩殆如许。\n达尊遍海陬，津津数德齿。\n况予托素心，能无感独处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2808,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送余刺史宝冈秩满入觐即次留别元韵 其五","author":"觉罗四明","text":"独处追曩昔，会垣曾小住。\n君自长溪来，每每亲丰度。\n君旋移三山，士民望风附。\n继握清漳符，四野溥甘露。\n迟君向东来，今复看西渡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2809,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送余刺史宝冈秩满入觐即次留别元韵 其六","author":"觉罗四明","text":"予虽筮仕久，治术未全谙。\n惟君早练达，馀绪更深湛。\n剖陈壮词色，倾听似饴甘。\n月白风清夜，咨诹至再三。\n自此易分手，擿埴每怀惭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2810,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送余刺史宝冈秩满入觐即次留别元韵 其七","author":"觉罗四明","text":"重洋我两度，宣发半盈颠。\n天恩未一报，忽届无闻年。\n黾勉修职业，此方稍静便。\n望君持节来，再布泽绵绵。\n明春二三月，遮道迓名贤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2811,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"六巡使见示长句却寄 其一","author":"觉罗雅尔哈善","text":"愧非磊落青云士，快读缠绵白雪歌。\n遥想登楼吟眺处，乡心应较月明多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2812,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"六巡使见示长句却寄 其二","author":"觉罗雅尔哈善","text":"千首诗酬酒一瓶，海波不动远峰青。\n三台座待归帆速，夜夜开帘望使星。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2813,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"六巡使见示长句却寄 其三","author":"觉罗雅尔哈善","text":"自昔相看气味真，紫薇花放玉堂春。\n我今飘泊沧江外，风雨联床忆故人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2814,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"再答六司谏","author":"觉罗雅尔哈善","text":"思君正咏池塘句，忽接鱼笺笑口开。\n狂态于今犹未减，素心依旧不须猜。\n采风已有诗千首，遣兴何妨酒百杯。\n同在天涯怀凤阙，几时联辔入燕台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2815,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题黄玉圃巡使台阳花果图","author":"吴王坦","text":"尔雅自姬公，蒐讨穷大块。\n后有山海经，所言同志怪。\n荒略何从稽，于说亦荑稗。\n乃知天地间，赋形各万派。\n若非域外游，直犹等聋聩。\n巡方绣衣行，几及扶桑界。\n东溟凌沧波，惊涛历澎湃。\n既至振纪纲，问民轸病瘵。\n闻见往往殊，耳目为一快。\n其中植物繁，罗列登市卖。\n五色烂然陈，厥状难尽话。\n细文如锦章，粗文如方罫。\n枝叶非寻常，异味皆可嘬。\n召工写此图，摹仿在公廨。\n碧绿与丹朱，肖真事挥洒。\n称名复辨种，按之悉能解。\n我生里闬间，未得广行迈。\n多识惭古人，拘墟徒自絓。\n晴窗试展看，意旷若脱械。\n虚名玷使星，愿无远弗届。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2816,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题同年黄玉圃番社图","author":"吕谦恒","text":"九重涣汗使臣知，万都蛮荒跂踵时。\n耳目全开天海外，土风尽入竹枝词。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2817,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"大甲妇","author":"阮蔡文","text":"大甲妇，一何苦。\n为夫馌饷为夫锄，为夫日日绩麻缕。\n绩缕须净亦须长，撚匀合线紧双股。\n斲木虚中三尺围，凿开一道两头堵。\n轻圆漫捲不支机，一任玄黄杂成组。\n间彩颇似虹霓生，绽花疑落仙姬舞。\n吾闻利用前民有圣人，一器一名皆上古。\n况兹抒轴事机丝，制度周详供黻黼。\n土番蠢尔本无知，制器伊谁远近取。\n日计苦无多，月计有馀缕。\n但得稍閒馀，轧轧事伛偻。\n番丁横肩胜绮罗，番妇周身短布裋。\n大甲妇，一何苦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2818,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"后垄","author":"阮蔡文","text":"去县日以远，风俗日以变。\n顾此后垄番，北至中港限。\n音语止一方，他处不能辨。\n头发顶上垂，当额前后剪。\n发厚压光头，其形类覆盌。\n亦有一二人，公然戴高冕。\n黑丝及红绒，缠之百千转。\n大有古人风，所惜双足跣。\n男女八九岁，牙前两齿刬。\n长大手自牵，另居无拘管。\n父固免肯堂，翁亦无甥馆。\n是处两三间，村庄何萧散。\n高廪置平原，黍稷有馀挽。\n所虑湿气蒸，驾木如连栈。\n巨匏老而坚，行汲络藤瓣。\n溪水涨连旬，利涉身焉绾。\n丰年百礼偕，疾病颠危罕。\n饮酒即高歌，其乐何衎衎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2819,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"昙花图 其一","author":"柏谦","text":"西域谁携仙种回，昙花喜杂瘴烟开。\n分明遗赠皇华使，不令空王独占来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2820,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"昙花图 其二","author":"柏谦","text":"一帆飘渺驾长川，留取奇花入画妍。\n却笑君房浮海去，不传芝草长琼田。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2821,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾竹枝词 其一","author":"郁永河","text":"铁板沙连到七鲲，鲲身激浪海天昏。\n任教巨舶难轻犯，天险生成鹿耳门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2822,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾竹枝词 其二","author":"郁永河","text":"雪浪排空小艇横，红毛城势独峥嵘。\n渡头更上牛车坐，日暮还过赤嵌城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2823,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾竹枝词 其三","author":"郁永河","text":"编竹为垣取次增，衙斋清暇冷如冰。\n风声撼醒三更梦，帐底斜穿远浦灯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2824,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾竹枝词 其四","author":"郁永河","text":"耳畔时闻轧轧声，牛车乘月夜中行。\n梦回几度疑吹角，更有床头蝘蜓鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2825,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾竹枝词 其五","author":"郁永河","text":"蔗田万顷碧萋萋，一望茏葱路欲迷。\n裍载都来糖廍里，只留蔗叶饷群犀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2826,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾竹枝词 其六","author":"郁永河","text":"青葱大叶似枇杷，臃肿枝头著白花。\n看到花心黄欲滴，家家一树倚篱笆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2827,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾竹枝词 其七","author":"郁永河","text":"芭蕉几树植墙阴，蕉子累累冷沁心。\n不为临池堪代纸，因贪结子种成林。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2828,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾竹枝词 其八","author":"郁永河","text":"独干凌霄不作枝，垂垂青子任纷披。\n摘来还共蒌根嚼，赢得唇间尽染脂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2829,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾竹枝词 其九","author":"郁永河","text":"恶竹参差透碧霄，丛生如棘任风摇。\n那堪节节都生刺，把臂林间血已漂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2830,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾竹枝词 其十","author":"郁永河","text":"不是哀梨不是楂，酸香滋味似甜瓜。\n枇杷不见黄金果，番檨何劳向客誇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2831,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾竹枝词 其十一","author":"郁永河","text":"肩披鬓发耳垂珰，粉面红唇似女郎。\n马祖宫前锣鼓闹，侏离唱出下南腔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2832,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"台湾竹枝词 其十二","author":"郁永河","text":"台湾西向俯汪洋，东望层峦千里长。\n一片平沙皆沃土，谁为长虑教耕桑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2833,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"鹿耳门即事 其一","author":"陈梦林","text":"征帆摇曳海无波，回首沧桑一掷梭。\n前后三从此地入，安危几度险中过。\n顽民革面干戈戢，诸将承恩节钺多。\n独有书生仍故我，白头杖策待如何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":2834,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]