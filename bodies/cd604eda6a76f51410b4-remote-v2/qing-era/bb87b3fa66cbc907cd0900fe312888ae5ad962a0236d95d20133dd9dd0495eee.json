[{"title":"七夕大雨 其一","author":"龚静照","text":"天也怜人负此辰，雨沈河影浸云茵。\n双星两地分南北，乌鹊填桥恐未真。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26295,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"七夕大雨 其二","author":"龚静照","text":"匝岁离多泪已盈，化为甘雨溢花茵。\n纵生天上犹天忌，始信人间事有因。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26296,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谴鹊","author":"浦映绿","text":"片片花飞点绣帏，强拈裙带试腰围。\n欺人最是檐前鹊，说道当归又不归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26297,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"呼婢","author":"浦映绿","text":"银瓶斜插海棠花，春色朦胧护绛纱。\n烟袅兽炉香欲烬，隔帘鹦鹉唤琵琶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26298,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"牡丹亭","author":"浦映绿","text":"情生情死亦寻常，最是无端杜丽娘。\n亏杀临川点缀好，阿翁古怪婿荒唐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26299,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送外北上","author":"谢瑛","text":"握手临行话别时，叮咛肠断泪如丝。\n从今凭仗三更梦，飞绕君前不暂离。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26300,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄子诗","author":"徐氏","text":"家内平安报尔知，田园岁入有馀资。\n丝毫不用南中物，好作清官答圣时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26301,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"课农人种桑示诸妇","author":"彭氏","text":"种桑令欲稀，晨夕风露透。\n抽条叶以繁，筠笼日相就。\n茧成得收丝，织纴不敢后。\n辛苦分所甘，寄语诸少妇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26302,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拜姑墓","author":"彭氏","text":"携有诸孙在，嬉声想共闻。\n未能承妇道，徒尔拜姑坟。\n俎豆心先洁，蘋蘩手自薰。\n凄然松柏下，洒泪满寒云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26303,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谢张夫人寄兰花香","author":"彭氏","text":"博山晴结穗云黄，一榻春风入蕙乡。\n蝶翅初回幽谷梦，只闻花气不闻香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26304,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"课儿辈夜读","author":"彭氏","text":"午过凉生暑气回，半擎镫火竹帘开。\n窗前莫厌参丸苦，日后甘从此处来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26305,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谢张夫人寄芽茶","author":"彭氏","text":"半炉松火汲清泉，净洗砂铛手自煎。\n度得银瓶香欲透，一瓯先供绣幢前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26306,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送外","author":"徐元象","text":"送君入楚江，悠悠归路长。\n一去隔千里，魂梦伴潇湘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26307,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画","author":"姜桂","text":"暖风晴日值良辰，窗外梅花数点新。\n更想林泉清淑致，山光树色写初春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26308,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山村夜坐","author":"梁颀","text":"俯仰空庭四宇清，浮云扫尽晚烟轻。\n梨花皓月原同色，风竹流泉不辨声。\n深谷人閒春亦寂，短墙水近冷先生。\n却思城市喧阗处，箫鼓楼头听二更。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26309,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答何徵室","author":"梁颀","text":"晚羞明月晓羞花，弱质萍飘泛海涯。\n万叠云中千里树，不知何处是吾家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26310,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨夜 其一","author":"张柔嘉","text":"支离病榻苦无眠，夜雨镫昏倍惨然。\n虽有遗书生计薄，泪痕湿尽枕函边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26311,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨夜 其二","author":"张柔嘉","text":"远漏风回报四更，寒秋闷拥对孤檠。\n思量家事方愁绝，檐溜何堪递楚声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26312,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题彭祖张苍像","author":"程琼","text":"苦惜年光恋幻身，白头私擅梦边春。\n儿家酬酒凄然问，可有齐眉耦齿人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26313,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"集古今宫闺德容兼备者若干人题其上","author":"程琼","text":"艳淑如斯例作尘，相逢可即昔时人。\n愿将彼骨吹成土，持葬儿今屡转身。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26314,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"释牡丹亭传奇色情难坏意","author":"程琼","text":"何自有情因色有，何缘造色为情生。\n如环情色成千古，艳艳荧荧画不成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26315,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"有疾豫别玉勾词客","author":"程琼","text":"风流嘉庆古难均，共命同心异别亲。\n应恨块泥将打破，谁能再塑管夫人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26316,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卧病坐乐轩","author":"程琼","text":"日日薰香礼觉王，不任操作不缝裳。\n谁知鹿苑无生诀，未及龙宫不死方。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26317,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"疾作梦母氏孙淑人挈儿来兹不复梦矣","author":"程琼","text":"为痛宁馨转自伤，相随却恨我无娘。\n更谁看等千金重，只我佳人断绣肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26318,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"属玉勾生椁外题小眠斋三字","author":"程琼","text":"千春万载此沈埋，坐乐轩中只暂挨。\n岂可便无题额处，相烦亲署小眠斋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26319,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜泊曲江不寐鼓琴","author":"李文慧","text":"舟泊曲江口，孤屿澹欲失。\n遥岸渔火明，烟中棹歌息。\n当此万籁静，心境两幽寂。\n焚香拭焦尾，调轸横陈膝。\n琳琅太古音，旨趣复谁识。\n欲写我心期，聊以寄所适。\n一弹江水清，再鼓秋月白。\n月白与风清，惊起鱼龙出。\n曲终独徘徊，篷窗风露湿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26320,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"即景","author":"李文慧","text":"昼长帘乍卷，飞絮满妆楼。\n燕垒红轻缀，莺梭绿半浮。\n烟云千里梦，风雨一春愁。\n独倚阑干曲，时时忆旧游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26321,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋兴","author":"陈静渊","text":"近日閒心少，都缘愁病多。\n案头疏笔砚，窗下废吟哦。\n露滴阶苔润，风吹塞雁过。\n悠然清兴远，散步向庭阿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26322,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"远游曲","author":"张贞","text":"远游那可了，坐惜红颜老。\n花开隔岸林，目断江南草。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26323,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柬外","author":"李氏","text":"凭几修书寄便鸿，词笺恨短意无穷。\n离怀正值深秋月，红叶青镫烟雨中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26324,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暮春","author":"霍双","text":"东山下林影，西阁日光残。\n脉脉春风里，幽花生暮寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26325,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寒食","author":"霍双","text":"人倚雕阑竹倚衣，女桑遥听子规啼。\n陌头杨柳休攀折，系住春光不许归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26326,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"兰塘曲","author":"范贞仪","text":"放棹向兰塘，共爱芳心浅。\n折断藕中丝，虽长不及茧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26327,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日经理绿雪山房","author":"范贞仪","text":"荒馆经时未启扉，眼前烟景与心违。\n频逢风雨花应瘦，久废删锄草渐肥。\n小阁香泥巢乳燕，短墙蛛网挂春晖。\n伯劳底事东飞去，春昼年年未见归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26328,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"对镜","author":"范贞仪","text":"匣里青铜久闭藏，暂时相对转心伤。\n飞蓬欲化三秋草，瘦骨真成百炼钢。\n香阁梦回山月冷，玉台人去鹤书荒。\n薛媛欲写丹青寄，天上人间恨渺茫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26329,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自翠微山望金精","author":"谢秀孙","text":"薄暮秋初风，木叶下庭圃。\n夫君招我游，盘姗出坡树。\n山菊垂好花，阴影随行步。\n几折临高厓，敛足不敢顾。\n夫君指金精，谓此汝所慕。\n吴王洞口来，仙女云中举。\n至今千百年，烟霞生其处。\n自怜长闺房，荏苒秋草暮。\n结庐十五载，不识金精路。\n夜月明空山，时闻钟声度。\n忆我七八岁，曾一随诸妇。\n巾车到洞门，嘿然生疑惧。\n洞中忽有光，云殿凌丹雘。\n翠竹摇空寒，白日蒙雨雾。\n仿佛记曲水，海棠缘石户。\n草色映罗裙，逐伴踏花去。\n涧水湿弓鞋，逡巡避母怒。\n忽忽三十年，仍向峰头住。\n世事几兴衰，家门亦多故。\n徵兰不可期，弄瓦杳无与。\n出户泪如丝，入户泪如雨。\n人生能几何，年光如驰骛。\n安得辞人间，洒扫侍仙驭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26330,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"池上秋海棠","author":"谢秀孙","text":"芳草依碧池，佳花点秋石。\n绿叶与紫茎，何数秋兰色。\n主人策仗行，三径偶相值。\n采之置瓶中，颜色照几席。\n有如浣纱女，斜立石潭侧。\n幽芳独自怜，忽遇五湖客。\n沼吴果何人，撚花长太息。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26331,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"霜竹","author":"林氏","text":"孤挺三冬日，枝枝映楚湘。\n萧疏持健节，苍翠带寒霜。\n月色笼阴薄，风声引韵长。\n林中还有实，留得凤毛香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26332,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩提树","author":"林氏","text":"智药曾培植，携来西域船。\n高枝成宝盖，清影散诸天。\n虞苑流阴远，唐朝得法先。\n自从卢祖悟，色相总非禅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26333,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"大通寺","author":"林氏","text":"海暖风和放小舟，满天烟景好追游。\n青山叠叠浑无影，绿水漫漫静不流。\n佛祖昔年留妙偈，头陀今日继灵修。\n菩提自是西来种，今古禅参尚未休。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26334,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜独坐","author":"林氏","text":"日来秋气满林塘，独坐閒庭过夕阳。\n飒飒西风鸣晚树，萧萧残叶落东墙。\n闭门自喜红尘远，顾影偏宜白发长。\n谁有凌霜真节操，岁寒不使后凋伤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26335,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闺辞","author":"陈瑞麟","text":"春闺三月养吴蚕，南陌柔桑满竹篮。\n为避行人回步急，不知髻上堕牙簪。\n一自檀郎赴玉京，残镫挑尽泪盈盈。\n黄昏又值芭蕉雨，不管人愁滴到明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26336,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏月","author":"黄幼蘩","text":"清切空阶月，相依欲二更。\n寂喧非一致，千秋同此明。\n萧萧庭中女，俯仰触中情。\n对此令人远，况乃兼秋声。\n浅深各有感，今昔宁无惊。\n秋在孤吟外，愁从何处生。\n人生有代谢，万物有衰荣。\n茫茫乾坤里，相积为愁城。\n欲挽西江水，一洗万古情。\n虚窗来素影，清泪落寒檠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26337,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"季冬淇邑感怀","author":"李氏","text":"寥寥书馆客中居，况值穷冬百事疏。\n薄枕忆家千里外，寒窗兀坐五更初。\n飘零木叶侵幽径，落寞霜华满敝庐。\n时系寸心归未得，残镫挑尽独踌躇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26338,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜闻二子读书","author":"李氏","text":"节届清和夜气凉，蟾光皎皎映书堂。\n吾儿颇奋萤窗志，惜少熊丸教子方。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26339,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"思亲","author":"李氏","text":"秋风拂槛气萧森，兀坐红窗思转深。\n乌鸟尚然知反哺，吾生却愧不如禽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26340,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闻鸦喧忆亲述怀","author":"杨淑贞","text":"一乌树头集，群乌共喧呼。\n老者似爱怜，雏者如持扶。\n老雏同依依，孝哉至性俱。\n物情尚如此，嗟我何其殊。\n忆我将字日，亲悲泪欲枯。\n一旦远分离，千里阻程途。\n荒城鱼雁杳，生我却如无。\n恨我不为男，背亲来事姑。\n十五年瞬耳，亲容今何如。\n亲容日益衰，亲年日加诸。\n亲容与亲年，追思忽嗟吁。\n感此物争鸣，诚哉不如乌。\n三复《蓼莪》诗，叹息欲废书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26341,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病起柬井桐汪大姊","author":"杨淑贞","text":"翠冷黄添逐病容，修眉怯扫黛螺封。\n簟痕轻拭流波腻，幔影閒垂曲槛重。\n五夜烧镫挑豆蔻，三秋览镜减芙蓉。\n披衣小展裁桐叶，撩乱吟情四壁蛩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26342,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜","author":"杨淑贞","text":"纱窗月透影朦胧，丹桂香飘曲院风。\n满耳蛩声秋唧唧，玉阶寒露冷梧桐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26343,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日","author":"杨淑贞","text":"轻寒款款逼窗纱，日影穿帘燕子斜。\n底事小园春未减，一枝晴放碧桃花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26344,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题爱莲亭","author":"曹炯","text":"面水一亭在，临风绕芰荷。\n香消长日暑，色借醉颜酡。\n隔浦栖文鸟，方桥引素波。\n徘徊何限意，伫听采莲歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26345,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游仙","author":"曹炯","text":"九天天路路迢迢，阆苑奇葩尽吐苞。\n忆得看时忘日暮，归来新月挂松梢。\n朝来洞口饭青精，晚侍金仙宴玉京。\n忆得昨宵松下坐，月明星朗听吹笙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26346,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暮春","author":"龙氏","text":"却凭何物饯春归，泪洒风前送夕晖。\n莺舌唤将芳草暮，蜂须撩引落花飞。\n池塘梦浅随风绕，庭院愁加带雨霏。\n已觉困人肠欲断，不堪还封柳依依。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26347,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏鹤","author":"韩韫玉","text":"丹顶玄裳白羽轻，芝田旧日得仙名。\n生来云水原天性，望里蓬壶是去程。\n代远每过千岁寿，露寒常向九皋鸣。\n不随卫国乘轩队，稳卧松巅梦太清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26348,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"度梨关","author":"钱纫蕙","text":"迢递逾梨岭，肩舆胜驽骖。\n雄关限闽越，幽境极东南。\n地暖常多雨，云开忽作岚。\n乡闾望不极，聊复上岩龛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26349,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"野望","author":"钱纫蕙","text":"偶向东郊望，萧条物候非。\n云连山一色，木落雁同飞。\n岁月愁中促，音书天末稀。\n感时情不极，惆怅返柴扉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26350,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"新安江行","author":"钱纫蕙","text":"乘潮渡渔浦，沓嶂夹江濆。\n下瞰绿波影，能令纤芥分。\n筏移疑入镜，碓落自舂云。\n听尽潺湲水，滩高易夕曛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26351,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"征怨","author":"钱纫蕙","text":"万里胡天断鸟飞，年年策马未言归。\n西风吹急笳声咽，历乱黄沙满铁衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26352,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋柳","author":"钱纫蕙","text":"江潭憔悴几枝横，秋雨秋风怆别情。\n犹拟攀条贻远道，可怜玉笛不成声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26353,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菊影","author":"陈秀贞","text":"分身老圃绘秋容，真相依稀色是空。\n落日移从霜径里，疏镫送入锦屏中。\n终将不老随宵月，直以无香傲晚风。\n悟却浮生归去也，白云挥手谢陶公。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26354,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雪集即事 其一","author":"陈秀贞","text":"小鬟轻曳锦帏偏，报说平明雪满天。\n起掷绣鞋床下卜，远人身上合添绵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26355,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雪集即事 其二","author":"陈秀贞","text":"香奁移傍碧窗纱，小鼎焚香自煮茶。\n高卷疏帘看不足，犯寒亲手掬梨花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26356,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雪集即事 其三","author":"陈秀贞","text":"红炉高宴列中堂，子侄传阄共举觞。\n无奈阿姑教强饮，清樽微试郁金香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26357,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雪集即事 其四","author":"陈秀贞","text":"万花飞舞锦成团，晚上红楼作大观。\n直被天公迷望眼，不知何处是长安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26358,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"论诗法","author":"杨素书","text":"人生学渊源，各各有所自。\n沆瀣非一气，成功总难企。\n我幼本憃愚，况无明师启。\n义母爱拳拳，略举诗书旨。\n及长学讴今，里言抑何鄙。\n两汉与三唐，梦亦不到此。\n我后归会稽，主人风雅士。\n亲炙获师承，渐解参奥理。\n吟红主爱女，夕秀翩翩起。\n五载共切磋，我当畏友亲。\n昙华萎一朝，慧业竟中止。\n闺阁嗟睘睘，独吟殊无俚。\n幸荷主恩深，诱掖频予跂。\n例将爱女心，教我亦如是。\n且我受薰陶，较女尤倍蓰。\n小阁上镫初，寒衾梦回里。\n有意无意间，剖析微难纪。\n真乐两融融，函丈胡能拟。\n许我诗学成，为我任劂剞。\n我纵钝根钝，识此还遗彼。\n辱承训委宛，顽铁亦柔靡。\n才知传不传，即定学诗始。\n才媛不乏人，著作存有几。\n方其侍膝下，尘情澹于水。\n红闺趁清閒，倡和偕姊弟。\n迨至赋宜家，琑屑筹盐米。\n师范日渐疏，旧学日益弛。\n即使能自立，初终志永矢。\n夫子或拘挛，家门或颠否。\n何暇计千秋，飘风扫萚似。\n庋阁冷絮吟，湮没伤比比。\n谁似我主人，终身遂依倚。\n拙著曷足论，附骥腼颜耳。\n邈想同心人，情根总不死。\n人合固天定，天合亦人俟。\n缘生因即生，寸心坚由尔。\n我愿广陶镕，问字各欢喜。\n安得有情眷，团栾联砚几。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26359,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书怀寄夫子","author":"潘孟齐","text":"惭愧兰芝女，还家恨解携。\n如何伯鸾妇，翻作仲卿妻。\n星月原同影，鸳鸯不独栖。\n烛花随泪尽，愁听夜乌啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26360,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偶吟","author":"陈克毅","text":"衰年光景若为欢，划尽烦忧强自宽。\n鬓已渐凋飘作雪，心经九转炼成丹。\n原无妄想参风雅，剩有高怀寄岁寒。\n领略绣窗清净味，课经礼佛且加餐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26361,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄北","author":"徐珠渊","text":"风紧牵离别，镫残人未眠。\n此身无羽翼，安得到君边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26362,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]