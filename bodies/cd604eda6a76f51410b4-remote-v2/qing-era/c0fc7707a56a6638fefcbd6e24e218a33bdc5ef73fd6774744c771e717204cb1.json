[{"title":"山馆夜作","author":"黄景仁","text":"长夜山窗面面开，江湖前后思悠哉。\n当窗试与然高烛，要看鱼龙啖影来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1766,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"少年行","author":"黄景仁","text":"男儿作健向沙场，自爱登台不望乡。\n太白高高天尺五，宝刀明月共辉光。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1767,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"幼女","author":"黄景仁","text":"汝父年来实鲜欢，牵衣故作别离难。\n此行不是长安客，莫向浮云直北看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1768,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"安庆客舍","author":"黄景仁","text":"月斜东壁影虚龛，枕簟清秋梦正酣。\n一样梦醒听络纬，今宵江北昨江南。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1769,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"江村","author":"黄景仁","text":"江水绕孤村，芳菲在何处？\n春从啼鸟来，啼是春归去。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1770,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"别老母","author":"黄景仁","text":"搴帏拜母河梁去，白发愁看泪眼枯。\n惨惨柴门风雪夜，此时有子不如无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1771,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春兴","author":"黄景仁","text":"夜来风雨梦难成，是处溪头听卖饧。\n怪底桃花半零落，江村明日是清明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1772,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"癸巳除夕偶成","author":"黄景仁","text":"年年此夕费吟呻，儿女灯前窃笑频。\n汝辈何知吾自悔，枉抛心力作诗人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1773,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"癸巳除夕偶成","author":"黄景仁","text":"千家笑语漏迟迟，忧患潜从物外知。\n悄立市桥人不识，一星如月看多时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1774,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"新安滩","author":"黄景仁","text":"一滩复一滩，一滩高十丈。\n三百六十滩，新安在天上。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1775,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将之京师杂别","author":"黄景仁","text":"翩与归鸿共北征，登山临水黯愁生。\n江南草长莺飞日，游子离邦去里情。\n五夜壮心悲伏枥，百年左计负躬耕。\n自嫌诗少幽燕气，故作冰天跃马行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1776,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"都门秋思","author":"黄景仁","text":"五剧车声隐若雷，北邙惟见冢千堆。\n夕阳劝客登楼去，山色将秋绕郭来。\n寒甚更无修竹倚，愁多思买白杨栽。\n全家都在风声里，九月衣裳未剪裁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1777,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"都门秋思","author":"黄景仁","text":"侧身人海叹栖迟，浪说文章擅色丝。\n倦客马卿谁买赋，诸生何武漫称诗。\n一梳霜冷慈亲发，半甑尘凝病妇炊。\n寄语绕枝乌鹊道：天寒休傍最高枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1778,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"绮怀","author":"黄景仁","text":"几回花下坐吹箫，银汉红墙入望遥。\n似此星辰非昨夜，为谁风露立中宵？\n缠绵思尽抽残茧，宛转心伤剥后蕉。\n三五年时三五月，可怜杯酒不曾消。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1779,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"绮怀","author":"黄景仁","text":"露槛星房各悄然，江湖秋枕当游仙。\n有情皓月怜孤影，无赖闲花照独眠。\n结束铅华归少作，屏除丝竹入中年。\n茫茫来日愁如海，寄语羲和快著鞭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1780,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感旧 其一","author":"黄景仁","text":"大道青楼望不遮，年时系马醉流霞。\n风前带是同心结，杯底人如解语花。\n下杜城边南北路，上阑门外去来车。\n匆匆觉得扬州梦，检点闲愁在鬓华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1781,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感旧 其二","author":"黄景仁","text":"唤起窗前尚宿酲，啼鹃催去又声声。\n丹青旧誓相如札，禅榻经时杜牧情。\n别后相思空一水，重来回首已三生。\n云阶月地依然在，细逐空香百遍行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1782,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感旧 其三","author":"黄景仁","text":"遮莫临行念我频，竹枝留涴泪痕新。\n多缘刺史无坚约，岂视萧郎作路人。\n望里彩云疑冉冉，愁边春水故粼粼。\n珊瑚百尺珠千斛，难换罗敷未嫁身。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1783,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感旧 其四","author":"黄景仁","text":"从此音尘各悄然，春山如黛草如烟。\n泪添吴苑三更雨，恨惹邮亭一夜眠。\n讵有青乌缄别句，聊将锦瑟记流年。\n他时脱便微之过，百转千回只自怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1784,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丑奴儿慢·春日","author":"黄景仁","text":"日日登楼，一日换一番春色，者似卷如流春日，谁道迟迟？\n一片野风吹草，草背白烟飞。\n颓墙左侧，小桃放了，没个人知。\n徘徊花下，分明记得，三五年时。\n是何人，挑将竹泪，黏上空枝。\n请试低头，影儿憔悴浸春池。\n此间深处，是伊归路，莫惹相思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1785,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杂感","author":"黄景仁","text":"仙佛茫茫两未成，只知独夜不平鸣；风蓬飘尽悲歌气，泥絮沾来薄幸名。\n十有九人堪白眼，百无一用是书生；莫因诗卷愁成谶，春鸟秋虫自作声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1786,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卖花声·立春","author":"黄景仁","text":"独饮对辛盘，愁上眉弯。\n楼窗今夜且休关。\n前度落红流到海，燕子衔还。\n书贴更簪欢，旧例都删。\n到时风雪满千山。\n年去年来常不老，春比人顽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1787,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"圈虎行","author":"黄景仁","text":"都门岁首陈百技，鱼龙怪兽罕不备；何物市上游手儿，役使山君作儿戏。\n初舁虎圈来广场，倾城观者如堵墙；四周立栅牵虎出，毛拳耳戢气不扬。\n先撩虎须虎犹帖，以棓卓地虎人立；人呼虎吼声如雷，牙爪丛中奋身入。\n虎口呀开大如牛，人转从容探以手；更脱头颅抵虎口，以头饲虎虎不受，虎舌舐人如舐毂。\n忽按虎脊叱使行，虎便逡巡绕阑走。\n翻身踞地蹴冻尘，挥身抖开花锦茵；盘回舞势学胡旋，似张虎威实媚人；少焉仰卧若佯死，投之以肉霍然起；观者一笑争醵钱，人既得钱虎摇尾。\n仍驱入圈负以趋，此间乐亦忘山居。\n依人虎任人颐使，伴虎人皆虎唾余。\n我观此状气消沮：嗟尔斑奴亦何苦！\n不能决蹯尔不智，不能破槛尔不武。\n此曹一生衣食汝，彼岂有力如中黄，复似梁鸯能喜怒。\n汝得残餐究奚补？\n伥鬼羞颜亦更主；旧山同伴倘相逢，笑尔行藏不如鼠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1788,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"贺新郎 太白墓，和稚存韵","author":"黄景仁","text":"何事催人老？\n是几处、残山剩水，闲凭闲吊。\n此是青莲埋骨地，宅近谢家之朓。\n总一样，文人宿草。\n只为先生名在上，问青天，有句何能好？\n打一幅，思君稿。\n梦中昨来逢君笑。\n把千年、蓬莱清浅，旧游相告。\n更问后来谁似我，我道：才如君少。\n有亦是，寒郊瘦岛。\n语罢看君长揖去，顿身轻、一叶如飞鸟。\n残梦醒，鸡鸣了。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1789,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"集杭州俗语诗","author":"黄增","text":"色不迷人人自迷，情人眼里出西施。\n有缘千里来相会，三笑徒然当一痴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1790,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜饮","author":"黄遵宪","text":"长风吹月过江来，照我华堂在手杯。\n莫管阴晴圆缺事，尽欢三万六千回。\n胸中五狱撑空起，眼底浮云一扫开。\n玉管铜弦兼铁板，与君扶醉上高台。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1791,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"海行杂感 其六","author":"黄遵宪","text":"星星世界遍诸天，不计三千与大千。\n倘亦乘槎中有客，回头望我地球圆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1792,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题梁任父同年","author":"黄遵宪","text":"寸寸山河寸寸金，瓜离分裂力谁任。\n杜鹃再拜忧天泪，精卫无穷填海心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1793,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"羊城感赋六首 其一","author":"黄遵宪","text":"早潮晚汐打城门，玉漏声催铜鼓喧。\n百货均输成剧邑，五方风气异中原。\n舵舟舆轿山川险，帕首靴刀府帅尊。\n今古茫茫共谁语，越王台下正黄昏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1794,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"羊城感赋六首 其二","author":"黄遵宪","text":"手挽三江尽北流，寇氛难洗越人羞。\n黄巢毒竟流天下，陶侃军难进石头。\n铤鹿偶然完首尾，烂羊多赖得公侯。\n欃枪扫尽红羊换，从此当朝息内忧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1795,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"羊城感赋六首 其三","author":"黄遵宪","text":"际海边疆万里开，臣佗大长信奇才。\n平蛮看竖擎天柱，朝汉同登浴日台。\n南极星辰原北拱，东流海水竟西回。\n喁喁鹣鲽波涛阻，独有联翩天马来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1796,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"羊城感赋六首 其四","author":"黄遵宪","text":"慷慨争挥壮士戈，洗兵竟欲挽天河。\n苦烦父老通邛笮，难禁奸民教尉佗。\n袄庙火焚氛更恶，鲛人珠尽泪犹多。\n纷纷和战都非策，聚铁虽坚奈错何！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1797,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"羊城感赋六首 其五","author":"黄遵宪","text":"战台祠庙岿然存，双阙嵯峨耸虎门。\n谁似伏波饶将略？\n犹闻蹈海报君恩。\n要荒又议珠崖弃，霸业弥思纛屋尊。\n最是凋零苏武节，无人海外赋《招魂》。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1798,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"羊城感赋六首 其六","author":"黄遵宪","text":"木棉花落絮飞初，歌舞冈前夜雨馀。\n阁道鸾声都寂莫，市楼蜃气亦空虚。\n骑羊漫诩仙人鹤，驱鳄难除海大鱼。\n独有十三行外柳，重重深护画楼居。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1799,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和钟西耘庶常德祥津门感怀诗 其三","author":"黄遵宪","text":"六月中兴赋《出车》，金陵王气复充闾。\n华夷共主皆思服，尧舜如天尚病诸。\n荡寇重编归汉里，和戎难下绝秦书。\n只应文物开王会，珥笔曾夸太史鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1800,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和钟西耘庶常德祥津门感怀诗 其一","author":"黄遵宪","text":"雷动星驰入贡车，舌人环列护爻闾。\n但占风雨都来享，偶断苞茅便问诸。\n宅北曾分羲仲命，绥南远赐赵佗书。\n盟津八百争朝会，犹记徵祥纪白鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1801,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和钟西耘庶常德祥津门感怀诗 其五","author":"黄遵宪","text":"执梃降王走传车，先擒月爱后东闾。\n难言赤狄初何种，终痛庭坚祀忽诸。\n两帝东西争战国，九州大小混方书。\n喁喁鹣鲽来无路，久已纵横海大鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1802,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和钟西耘庶常德祥津门感怀诗 其二","author":"黄遵宪","text":"八荒无事息兵车，七叶讴吟洽里闾。\n岂谓浮云变苍狗，竟教明月蚀詹诸。\n骊山烽火成焦土，牛耳牲盘捧载书。\n秋草木兰驰道静，白龙微服记为鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1803,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和钟西耘庶常德祥津门感怀诗 其七","author":"黄遵宪","text":"鸾声阁道碾安车，元老相从话踦闾。\n未雨绸缪彻桑土，御冬旨蓄备桃诸。\n借筹幸辟同文馆，警鼓惊传奔命书。\n相戒鲂鱮休出入，吞声私泣过河鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1804,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和钟西耘庶常德祥津门感怀诗 其八","author":"黄遵宪","text":"东西南北走舟车，虎穴惊看插邑闾。\n七万里戎来集此，五千年史未闻诸。\n考工述物搜奇字，鬼谷尊师发秘书。\n教训十年民力盛，倘排犀手射鲸鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1805,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和钟西耘庶常德祥津门感怀诗 其四","author":"黄遵宪","text":"狼㬻遗种等高车，万族相从到尾闾。\n魑魅入林逢不若，虾蟆吞月鉴方诸。\n昔闻靺鞨歌西乐，今见祛庐制左书。\n始受一廛濠镜地，有明师早漏多鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1806,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"和钟西耘庶常德祥津门感怀诗 其六","author":"黄遵宪","text":"电掣重轮走水车，风行千里献比闾。\n移山未要嗤愚叟，捧土真能塞孟诸。\n黑齿雕题徵鬼箓，赤文绿字诩天书。\n寻常弓矢疑堪用，闻道潮人驱鳄鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1807,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜起","author":"黄遵宪","text":"千声檐铁百淋铃，雨横风狂暂一停。\n正望鸡鸣天下白，又惊鹅击海东青。\n沈阴曀曀何多日！\n残月晖晖尚几星。\n斗室苍茫吾独立，万家酣梦几人醒？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1808,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"香港感怀十首 其一","author":"黄遵宪","text":"弹指楼台现，飞来何处峰？\n为谁刈藜藋？\n遍地出芙蓉。\n方丈三神地，诸侯百里封。\n居然成重镇，高垒矗狼烽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1809,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"香港感怀十首 其二","author":"黄遵宪","text":"岂欲珠崖弃，其如城下盟！\n帆樯通万国，壁垒逼三城。\n虎穴人雄据，鸿沟界未明。\n传闻哀痛诏，犹洒泪纵横。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1810,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"香港感怀十首 其三","author":"黄遵宪","text":"酋长虬髯客，豪商碧眼胡。\n金轮铭武后，宝塔礼耶稣。\n火树银花耀，毡衣绣缕铺。\n五丁开凿后，欲界亦仙都。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1811,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"香港感怀十首 其四","author":"黄遵宪","text":"盗喜逋逃薮，兵夸曳落河。\n官尊大呼药，客聚众娄罗。\n王面镌金宝，蛮腰跨革靴。\n斑阑衣服异，关吏莫谁何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1812,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"香港感怀十首 其五","author":"黄遵宪","text":"沸地笙歌海，排山酒肉林。\n连环屯万室，尺土过千金。\n民气多膻行，夷言学鸟音。\n黄标千万积，翻讶屋沈沈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1813,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"香港感怀十首 其六","author":"黄遵宪","text":"便积金如斗，能从聚窟消。\n蛮云迷宝髻，脂夜荡花妖。\n龙女争盘镜，鲛人斗织绡。\n珠帘春十里，难遣可怜宵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1814,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"香港感怀十首 其七","author":"黄遵宪","text":"《博物》张华志，千间广厦开。\n摩挲铜狄在，怅望宝山回。\n大鸟如人立，长鲸跋浪来。\n官山还府海，人力信雄哉！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1815,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"香港感怀十首 其八","author":"黄遵宪","text":"流水游龙外，平波又画桡。\n佛犹夸国乐，奴亦挟天骄。\n御气球千尺，驰风马百骁。\n街弹巡赤棒，独少市声嚣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1816,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"香港感怀十首 其九","author":"黄遵宪","text":"指北黄龙饮，从西天马来。\n飞轮齐鼓浪，祝炮日鸣雷。\n中外通喉舌，纵横积货财。\n登高遥望海，大地故恢恢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1817,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"香港感怀十首 其十","author":"黄遵宪","text":"遣使初求地，高皇全盛时。\n六州谁铸错？\n一恸失燕脂。\n凿空蚕丛辟，嘘云蜃气奇。\n山头风猎猎，犹自误龙旗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1818,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"酬曾重伯编修 其二","author":"黄遵宪","text":"废君一月官书力，读我连篇新派诗。\n《风》《雅》不亡由善作，光丰之后益矜奇。\n文章巨蟹横行日，世变群龙见首时。\n手撷芙蓉策虬驷，出门惘惘更寻谁？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1819,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山歌 其三","author":"黄遵宪","text":"买梨莫买蜂咬梨，心中有病没人知。\n因为分梨故亲切，谁知亲切转伤离。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1820,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"今别离 其一","author":"黄遵宪","text":"别肠转如轮，一刻既万周。\n眼见双轮驰，益增中心忧。\n古亦有山川，古亦有车舟。\n车舟载离别，行止犹自由。\n今日舟与车，并力生离愁。\n明知须臾景，不许稍绸缪。\n钟声一及时，顷刻不少留。\n虽有万钧柁，动如绕指柔。\n岂无打头风，亦不畏石尤。\n送者未及返，君在天尽头。\n望影倏不见，烟波杳悠悠。\n去矣一何速，归定留滞不？\n所愿君归时，快乘轻气球。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1821,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杂感 其二","author":"黄遵宪","text":"大块凿混沌，浑浑旋大圜。\n隶首不能算，知有几万年？\n羲轩造书契，今始岁五千。\n以我视后人，若居三代先。\n俗儒好尊古，日日故纸研。\n六经字所无，不敢入诗篇。\n古人弃糟粕，见之口流涎。\n沿习甘剽盗，妄造丛罪愆。\n黄土同抟人，今古何愚贤？\n即今忽已古，断自何代前？\n明窗敞流离，高炉热香烟。\n左陈端溪砚，右列薛涛笺。\n我手写我口，古岂能拘牵。\n即今流俗语，我若登简编。\n五千年后人，惊为古斓斑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1822,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"纪事 其六","author":"黄遵宪","text":"众人耳目外，重以甘言诱。\n浓绿茁芽茶，浅碧酿花酒。\n斜纹黑普罗，杂俎红?毭。\n琐屑到钗钏，取足供媚妇。\n上谒士雕龙，下访市屠狗。\n墨杘与侏张，相见辄握手。\n指此区区物，是某托转授。\n怀中花名册，出请纪谁某。\n“知君有姻族，知君有甥舅。\n赖君提挈力，吾党定举首。\n”丁宁复丁宁，“幸勿杂然否。\n”","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1823,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长水竹枝词","author":"黄燮清","text":"蚕种须教觅四眠，买桑须买枝头鲜。\n蚕眠桑老红闺静，灯火三更作茧圆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1824,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"黄天荡怀古","author":"黄燮清","text":"八千劲旅走熊罴，曾断金人十万师。\n骢马宣威临阵日，羯胡丧胆渡江时。\n风鸣环佩军中鼓，谷暗云霞战士旗。\n从古庸臣好和议，寒潮呜咽使人悲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1825,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其五","author":"龚自珍","text":"浩荡离愁白日斜，吟鞭东指即天涯。\n落红不是无情物，化作春泥更护花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1826,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其九十六","author":"龚自珍","text":"少年击剑更吹箫，剑气箫心一例消。\n谁分苍凉归棹后，万千哀乐聚今朝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1827,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一七○","author":"龚自珍","text":"少年哀乐过于人，歌泣无端字字真。\n既壮周旋杂痴黠，童心来复梦中身。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1828,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其一九五","author":"龚自珍","text":"天将何福予蛾眉，生死湖山全盛时。\n冰雪无痕灵气杳，女仙不赋降坛诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":1829,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]