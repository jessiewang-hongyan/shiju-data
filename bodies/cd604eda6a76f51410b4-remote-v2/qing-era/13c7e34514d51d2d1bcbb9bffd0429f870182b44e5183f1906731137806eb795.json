[{"title":"定风波·寻春","author":"曾廉","text":"玉勒寻春日欲斜。\n山围江郭水平沙。\n好著丹青图画取。\n去去。\n绿杨深处是苏家。\n行到垂杨逢绣阁。\n寂寞。\n美人东渡掩窗纱。\n帘下侍儿新打扮。\n试看。\n越中生女尽如花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26030,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"定风波·寄何五","author":"曾廉","text":"绮席金盘脍鲤鱼。\n绣帘朱槛玉人居。\n满院繁花红又紫。\n只是。\n风光不称白髭须。\n却笑元龙豪气在。\n狂态。\n每来花下得踟蹰。\n与子更横江海去。\n佳处。\n月明楼阁在空虚。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26031,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"定风波·寄谢五","author":"曾廉","text":"丛石孤桥屋似艭。\n蔗园风物亚邗江。\n夹路青青书带草。\n刚好。\n诗人终日倚书窗。\n四十六年同作赋。\n人诩。\n六朝体格韵琤瑽。\n岂料如今俱白首。\n惟有。\n春来幽兴在兰茳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26032,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"定风波·寄乔一乔二","author":"曾廉","text":"当日人呼大小乔。\n只今鬓发日飘萧。\n我亦石桥年少者。\n奔马。\n不知平地与云霄。\n相去东西才百里。\n何事。\n天涯涕泪一身遥。\n老病人扶难再拜。\n何害。\n如今一醉万愁消。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26033,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"定风波·小鬟","author":"曾廉","text":"不待闻歌唤奈何。\n水精帘子是银河。\n帘子打开垂首立。\n情急。\n今朝无黛点双蛾。\n碧玉小家能大雅。\n窗下。\n不加脂粉媚情多。\n袅袅花枝禅意在。\n须戴。\n何妨一笑见维摩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26034,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"定风波·秋集莫愁湖","author":"曾廉","text":"湖上桃枝带柳条。\n春来客子尽魂销。\n箫管画船明月夜。\n上下。\n清虚天里打兰桡。\n又是题糕重九节。\n清绝。\n钟山倒影倚青霄。\n更与佳人携手看。\n无限。\n雨荷风叶共萧萧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26035,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"定风波·问柳轩小饮","author":"曾廉","text":"朱雀桥边野草花。\n秦淮浊水不关沙。\n问柳轩前寻美酒。\n翘首。\n窗棂四面尽红纱。\n本是六朝金粉地。\n何意。\n垂鞭不见五云车。\n洞口桃花含笑处。\n无语。\n绿杨过去两三家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26036,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"定风波·即席","author":"曾廉","text":"阶下泉声逼酒寒。\n杨梅红透水精盘。\n传杯三五纤纤手。\n虽久。\n月明犹在搭衣竿。\n钟鼓楼前量刻漏。\n挥袖。\n人生何处不邯郸。\n莫待黄粱春梦醒。\n佳境。\n离离花影满阑干。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26037,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"定风波·宴李氏宅","author":"曾廉","text":"卷石为山斗水池。\n俨然湖上绿沦漪。\n昨夜吹箫声满院。\n相见。\n生绡如雪照花枝。\n荷叶苞羞持劝客。\n殽核。\n半红频果酒盈卮。\n雅会乘今宜笑乐。\n惊咢。\n西风又是授衣时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26038,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"定风波·青溪小饮","author":"曾廉","text":"玉槛银屏曲径通。\n芳春收得入帘栊。\n云在妆台山在镜。\n探听。\n杏花消息雨声中。\n九十韶光疑是梦。\n春冻。\n街头已见卖花红。\n拚与插花人一醉。\n留意。\n到头无计奈春风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26039,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"定风波·忆章曼仙","author":"曾廉","text":"夜宴秦淮酒易酣。\n翰林清致似刘惔。\n自从别后无消息。\n长忆。\n执杯人比杏花憨。\n二十三年何足数。\n居处。\n乌衣巷口柳毵毵。\n庾信小园河渭上。\n惆怅。\n挥毫总是说江南。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26040,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"定风波·小集十刹海酒楼","author":"曾廉","text":"十刹层楼俯镜奁。\n座中宾客朔南兼。\n莲花四月开何早。\n刚好。\n香风冉冉透湘帘。\n劝酒人来年二八。\n怜杀。\n揭帘如玉手纤纤。\n共道市坊烧鸭美。\n松齿。\n一盘葱本医微甜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26041,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"调笑令 有寄","author":"曾廉","text":"胡蝶。\n胡蝶。\n飞上美人画箑。\n彩衣才得情亲。\n江北江南暮春。\n春暮。\n春暮。\n人影衣香遮路。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26042,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"调笑令·喜子","author":"曾廉","text":"喜子。\n喜子。\n展得美人皓齿。\n昨宵裁就春衣。\n寄语今岁早归。\n归早。\n归早。\n几日妆楼尘扫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26043,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"调笑令·早蝉","author":"曾廉","text":"春月。\n春月。\n照见花枝清绝。\n玉人小立花边。\n独听枝头早蝉。\n蝉早。\n蝉早。\n莫又韶龄易老。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26044,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"调笑令·孔雀","author":"曾廉","text":"孔雀。\n孔雀。\n金翠斗人强弱。\n若将孔雀夸侬。\n侬是桃花嫩红。\n红嫩。\n红嫩。\n日炙怕消风韵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26045,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"调笑令·缓归","author":"曾廉","text":"么凤。\n么凤。\n飞上金钗微动。\n侍儿制就罗衣。\n陌上花开缓归。\n归缓。\n归缓。\n犹趁琼楼月满。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26046,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"调笑令·人立","author":"曾廉","text":"双燕。\n双燕。\n飞入桃花深院。\n水晶帘子初开。\n人立阶前碧苔。\n苔碧。\n苔碧。\n何处遥闻玉笛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26047,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"调笑令·银屏","author":"曾廉","text":"春雨。\n春雨。\n沾润花丛如许。\n丽人方倚银屏。\n一见花开动情。\n情动。\n情动。\n不记胡麻好种。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26048,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"调笑令·兰桡","author":"曾廉","text":"纤月。\n纤月。\n照彻凌波罗袜。\n兰桡閒了三年。\n只待人来荡船。\n船荡。\n船荡。\n春在鸳鸯湖上。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26049,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"八声甘州 寄女儿","author":"曾廉","text":"烧香人、拜烂了蒲团，不如问心田。\n看医方万卷，融然一喜，百病都捐。\n不用思量旧事，东惹又西牵。\n若果消心火，自少魔缠。\n你父亲年虽老，新病瘳酒饭，都胜从前。\n你母亲头腹，也好过当年。\n我是神仙无思虑，你也应、学我作神仙。\n从兹后，应知道，有个苍天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26050,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子 剪荷","author":"曾廉","text":"烟水满池塘。\n宛有佳人晒翠裳。\n姣少衰迟俄顷事，思量。\n难得花香叶又香。\n白露剪残黄。\n百子池边向靓妆。\n却恨秋风团扇冷，郎当。\n每替扬雄覆酱堈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26051,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子·春寒","author":"曾廉","text":"花影漾重重。\n锦被春寒未觉松。\n更漏犹长人不寐，丁东。\n檐马声嘶一夜风。\n胡蝶入帘栊。\n梦醒知在画帏中。\n枕上诗成时自诵，玲珑。\n日射纱窗四面红。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26052,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子·玉漏","author":"曾廉","text":"独酌亦何妨。\n五夜秋来玉漏长。\n月上纱窗人未寝，丁当。\n环佩微闻响画廊。\n握手怪冰凉。\n瘦损蛮腰减晚妆。\n十锦屏风兰麝透，仓皇。\n人影依稀过粉墙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26053,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南乡子·醉态","author":"曾廉","text":"何处见烟螺。\n十顷花香尽芰荷。\n罗袜无尘纤步到，凌波。\n正是云绡出绛河。\n妙处在梨涡。\n醉后宫商信口哦。\n娇惰倩人扶不住，婆娑。\n不待清歌唤奈何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26054,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"殢人娇 有寄","author":"曾廉","text":"十二楼头，一眼将那望尽。\n看谁是、星眸云■。\n天然风致，不施朱傅粉。\n怎不道、亲来瀛洲阆苑。\n鹦梦初回，燕栖未稳。\n这些地、休张空吻。\n团团纨扇，看才能半隐。\n隔珠箔、徘徊更加亲近。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26055,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"殢人娇·俗语","author":"曾廉","text":"群道懒蛇，我比懒蛇还懒。\n睡觉起、来呼张饭。\n多心忙煞，只恐天霉烂。\n更没个、长人为天挺干。\n五夜无端，吵人缭乱。\n抱鸡婆、窠中造反。\n便呼老妈，将灯儿照看。\n依旧是、红黄原来寡蛋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26056,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西江月 我佛","author":"曾廉","text":"才见罢参下座，又传说戒升堂。\n便将佛祖作魔王。\n仍听群魔莽荡。\n我佛自然依旧，群魔会复争强。\n问谁护法是金刚。\n只算元坛现相。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26057,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西江月·岁荒","author":"曾廉","text":"一粥还添一饭。\n算来何福能消。\n饮河满腹便终朝。\n省向人前问粜。\n斥鴳篱边鸣跃，大鹏天外逍遥。\n牛山色对首阳骄。\n只付沧波一笑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26058,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西江月·啸庐小照","author":"曾廉","text":"五十年来旧事，同吟池上梅花。\n而今清泪落悲笳。\n谁说词林风雅。\n盈颔虽飘白雪，养神不用丹砂。\n苍颜稍瘦目光加。\n却老奇方无价。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26059,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西江月·笑咏","author":"曾廉","text":"槛外青苍山在，门前清浅溪流。\n仙人相与晚同舟。\n佳梦从来难又。\n碧水今名方顺，白云兼复温柔。\n更从何处觅菟裘。\n莫待生涯粗就。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26060,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西江月·社日","author":"曾廉","text":"今日喜停针线，斜阳閒弄鞦韆。\n困人正是杏花天。\n借问如何消遣。\n堪笑小姑居处，剧怜明月栾圆。\n闭门花影自娟娟。\n良夜迢迢深院。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26061,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西江月·苏院","author":"曾廉","text":"粉蝶粘将衣桁，黄莺飞上花枝。\n可人正是晚春时。\n一幅花笺初试。\n希逸儿名风月，韦郎宅枕山池。\n神仙福地本无疑。\n况有沈檀罗绮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26062,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"归国谣 嫦娥","author":"曾廉","text":"真失措。\n月宫巧把嫦娥锢。\n行人不见眼前路。\n嫦娥常在广寒府。\n清光吐。\n只消收得吴刚斧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26063,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"归国谣","author":"曾廉","text":"嫦娥苦。\n只因失却吴刚斧。\n昔年仙桂今丛楚。\n要得嫦娥消云雾。\n天狗舞。\n待看明月当三五。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26064,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"归国谣","author":"曾廉","text":"閒延伫。\n天狗猖狂来复去。\n嫦娥终古长天宇。\n天家自有天家度。\n起沈锢。\n只要嫦娥传尺素。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26065,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"河传","author":"曾廉","text":"明镜。\n朝映。\n俏梨涡。\n拈得桃花手挼。\n最怜玉纤寒不呵。\n由他。\n春山轻点螺。\n趁著春风花未谢。\n诗赋罢。\n攀绿秋千架。\n乍新晴。\n衣影明。\n且停。\n隔墙人语声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26066,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"河传","author":"曾廉","text":"何处。\n延伫。\n绿蕉阴。\n蒙得纱窗绿深。\n隔窗玉人閒弄琴。\n仙音。\n梳头犹未簪。\n一桁珠帘花影眩。\n呼放燕。\n才露芙蓉面。\n海棠开。\n休放杯。\n有雷。\n已看风雨来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26067,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙 蛾眉豆","author":"曾廉","text":"苍翠正离披。\n一架秋迟。\n隔帘人影漫相疑。\n晓日妆台初画处，未上胭支。\n日夕劲风吹。\n萧索疏篱。\n殢人天气晚凉时。\n连日沈沈阴不雨，愁绝蛾眉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26068,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙·有忆","author":"曾廉","text":"休道硕人薖。\n日暮残疴。\n穷年寂寂守烟萝。\n惟有蔚蓝天上月，依旧无他。\n罗绮隔银河。\n蹙蹙鳞波。\n行宫门闭落花多。\n杨柳灞桥人折尽，最忆秦娥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26069,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙","author":"曾廉","text":"伯约计成空。\n烟雾朦胧。\n朝暾只在碧霄中。\n滴下征衫无限泪，不是胡桐。\n莫便惜龙钟。\n原有天公。\n芙蓉花待九秋红。\n宝殿大樽千斛酒，良会重逢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26070,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙·不见","author":"曾廉","text":"湖上问苏家。\n门巷枇杷。\n水晶窗下彩幡遮。\n鹦鹉唤将帘打起，人面桃花。\n小立自咨嗟。\n冉冉年华。\n绮筵散罢日西斜。\n惆怅去年人不见，世事如麻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26071,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"浪淘沙·晴空","author":"曾廉","text":"春夜颇冲融。\n醉眼朦朣。\n先生高卧杜楼中。\n鸟语花开人睡醒，日上窗红。\n倚槛仰晴空。\n万里青铜。\n飞鸿南北信难通。\n举目何山犹是旧，郁郁葱葱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26072,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦里·有见","author":"曾廉","text":"几度閒凭丹楯。\n庭院东风忒紧。\n回首正依依，忽又一时小忿。\n瘦损。\n瘦损。\n愁见纤纤玉笋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26073,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦里","author":"曾廉","text":"向晚巡檐閒步。\n檐下梨花满树。\n正是爱清阴，明月窥人不去。\n匆遽。\n匆遽。\n花事一年春暮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26074,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦里","author":"曾廉","text":"忽见一番整理。\n不是寻常眉黛。\n才出画堂来，转盼珠帘垂地。\n切记。\n切记。\n鹦鹉窗前未睡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26075,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦里·请佛","author":"曾廉","text":"几个鼠儿消乏。\n打东打西杂遝。\n才熄了神灯，又复啮残僧衲。\n无法。\n无法。\n拜佛且安宝塔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26076,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"如梦里","author":"曾廉","text":"宝塔登来一望。\n眼见四方雪亮。\n凭护法何人，我佛只言三藏。\n无恙。\n无恙。\n默默消除魔障。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26077,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行 初秋","author":"曾廉","text":"月上窗棂，风生庭树。\n初秋便觉天难曙。\n今年多雨已深寒，草虫一夜床头语。\n才见蓼花，未飞芦絮。\n江湖寥阔空延伫。\n几行锦字自何来，只应鸿雁知他处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26078,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行·湖上","author":"曾廉","text":"岸曲花飞，湖心鱼掉。\n羊欣当日原年少。\n苍茫五渚去人稀，孤篷休惹桃花笑。\n万顷烟波，几回凭吊。\n青山无数当斜照。\n耳边多少鹧鸪啼，鹧鸪只在黄陵庙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26079,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行·枉渚","author":"曾廉","text":"一带篱笆，羝羊角痒。\n才穿寸许便成丈。\n茅山山上放悲声，恰闻沧海春潮声。\n百尺石帆，凌风何往。\n有人柳外敲孤桨。\n张公吃酒李公颠，江头枉渚真成枉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26080,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"踏莎行·湖心亭","author":"曾廉","text":"已老垂杨，初成野菼。\n荷花荷叶高于槛。\n便从槛上摘荷花，江亭即作沙棠舰。\n天末风凉，湖心月澹。\n一声渔唱开诗胆。\n隔花似有可人来，新疴谁道狂情减。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26081,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水龙吟 书怀","author":"曾廉","text":"阿婆三五华年，你那曾东涂西抹。\n今朝只是，作腔装势，向谁喧聒。\n明认鹓雏，犹将腐鼠，公然么喝。\n又谁知有了，秃笔破砚，许大的，穷家活。\n一自閒堕落。\n便几年、雪侵华发。\n丝萝风致，夜邀山鬼，烛余空跋。\n明月长江，清阴名岳，记曾簪笔。\n思从兹更弃，老妻弱息，问吴门卒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26082,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水龙吟·有忆","author":"曾廉","text":"已过寒食清明，也复连日濛濛雨。\n池塘绿涨，阑干红褪，独吟无语。\n猛忆楼头，玉人那日，曾携手处。\n把罗巾重展，泪痕几点，犹疑是，桃花露。\n便欲凌空飞去。\n尽徘徊、怕还无据。\n绿阴满地，绣帘珠箔，重门何许。\n莫又年来，青青双鬓，多萦离绪。\n凭清宵梦寐，寻消问息，到清虚处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26083,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水龙吟·真州废园","author":"曾廉","text":"真州城里荒园，藤花犹挂无枝树。\n挐空紫爪，承烟秃干，飘零无主。\n几度徘徊，满庭烟草，一天风絮。\n看堆瓴累石，颓垣三尺，都不见，开门处。\n曾记昔年歌舞。\n更安详、食经茶谱。\n绣帘促膝，玉阑携手，尽应仙侣。\n谁料如今，假山遮断，桥头鹓鹭。\n只斜阳一片，暮鸦万点，约将秋住。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26084,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"水龙吟·残花","author":"曾廉","text":"锦官城外红稀，锦江犹作无情绿。\n矶透借问，画船前过，衣边裙幅。\n窈窕谁家，若教回首，见来应熟。\n叹颓垣断井，飘零何许，怕道昔时金屋。\n梦里铜镮青琐，有人供、明珠千斛。\n碧阑干外，明蟾初满，芳心一掬。\n玉镜台昏，纱窗隙处，剩膏残馥。\n只无言付与，后来妆抹，冰纨云縠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26085,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉落魄 本意","author":"曾廉","text":"嫣红姹紫。\n朅来年少诸裙屐。\n醉乡广莫赢千里。\n花草缤纷别有天和地。\n原知落魄云泥异。\n儒巾不溺也须弃。\n从渠娇脸欺憔悴。\n自昔羊公那及铜台妓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26086,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"醉落魄·胡蝶","author":"曾廉","text":"重金错绣。\n双双胜似鸳鸯偶。\n生来便自亲琼玖。\n不信轻身艳福能消受。\n罗浮仙种非常有。\n牡丹万树藏春薮。\n中庭玉馔金尊酒。\n酒罢人归犹自黏衫袖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26087,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"千秋岁 访旧","author":"曾廉","text":"画堂丹楯。\n斜日依鸱吻。\n帘影断，衣香尽。\n窗遮春草暗，径绕游丝紧。\n花落去，消残彩蝶通身粉。\n旧院空余恨。\n碧水春痕褪。\n桥槛上，生芝菌。\n几重罗幔隔，一幅晶屏近。\n人在否，城南杜牧休重问。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26088,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"千秋岁·小金山","author":"曾廉","text":"縠纹几顷。\n合付渔蓑领。\n屋水贴，阑波打。\n地惊洲渚壮，汊认江湖迥。\n盘柳转，高高亭子金山顶。\n镇日湘帘静。\n冷兴无任省。\n山水窟，神仙境。\n谁溅莲羽扇，风逐瓜皮艇。\n人过处，凝眸只道荷花影。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26089,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"千秋岁·笑赠","author":"曾廉","text":"天然婀娜。\n正鼓潇湘舵。\n一笑孽，三生果。\n不须文锦幰，自启银屏锁。\n疑幻梦，空中一朵仙云堕。\n傲兀从前左。\n放诞如今可。\n对镜看，横琴坐。\n娇容莲步涩，醉态梨涡媠。\n如意事，西施载上鸱夷舸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26090,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"摊破江神子·春意","author":"曾廉","text":"江头弱柳晓烟笼。\n怨东风。\n想东风。\n纤手一枝，玉笛画楼中。\n天又忒寒人又远，雁声起，望来书，只碧空。\n一年一年闭房栊。\n双泪浓。\n一心冲。\n死也死也，若死去、何处相逢。\n纵使蓬头，犹是旧时容。\n盼断天涯还地角，山影外，更蓬山，几万重。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":26091,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]