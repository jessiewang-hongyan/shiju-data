[{"title":"己亥杂诗 其二九九","author":"龚自珍","text":"任丘马首有筝琶，偶落吟鞭便驻车。\n北望觚棱南望雁，七行狂草达京师。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2141,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三○○","author":"龚自珍","text":"房山一角露崚嶒，十二连桥夜有冰。\n渐进城南天五尺，回灯不敢梦觚棱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2142,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三○二","author":"龚自珍","text":"虽然大器晚年成，卓荦全凭弱冠争。\n多识前言蓄其德，莫抛心力贸才名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2143,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三○五","author":"龚自珍","text":"欲从太史窥春秋，勿向有字句虚求。\n抱微言者太史氏，大义显显则予休。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2144,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三一一","author":"龚自珍","text":"画禅有女定清真，合配琳琅万轴身。\n百里畿南风雪路，我来著手竟成春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2145,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三一二","author":"龚自珍","text":"古愁莽莽不可说，化作飞仙忽奇阔。\n江天如墨我飞还，折梅不畏蛟龙夺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2146,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三一三","author":"龚自珍","text":"惠山秀气迎客舟，七十里外心先投。\n惠山妆成要妆镜，惠泉那许东北流？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2147,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"己亥杂诗 其三一四","author":"龚自珍","text":"丹宝琼花海岸旁，羽陵山似峚之阳。\n一家可惜仍烟火，未问仙人辟谷方。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2148,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西郊落花歌","author":"龚自珍","text":"西郊落花天下奇，古来但赋伤春诗，西郊车马一朝尽，定庵先生沽酒来赏之。\n先生探春人不觉，先生送春人又嗤，呼朋亦得三四子，出城失色人皆痴。\n如钱塘潮夜澎湃，如昆阳战晨披靡，如八万四千天女洗脸罢，齐向此地倾胭脂。\n奇龙怪凤爱漂泊，琴高之鲤何反欲上天为？\n玉皇宫中空若洗，三百六十界无一青蛾眉。\n又如先生平生之忧患，恍惚怪诞百出难穷期。\n先生读书尽三藏，最喜维摩卷里多清词，又闻净土落花深四寸，冥目观想犹神驰。\n西方净国未可到，下笔绮语何漓漓，安得树有不尽之花更雨新好者，三百六十日常是落花时！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2149,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"辛巳除夕与彭同年同宿道观中，彭出平生诗，","author":"龚自珍","text":"读之竟夜，遂书卷尾亦是三生影，同听一杵钟。\n挑灯人海外，拔剑梦魂中。\n雪色惮恩怨，诗声破苦空。\n明朝客盈座，谁言去年踪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2150,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹊踏枝 过人家废园作","author":"龚自珍","text":"漠漠春芜春不住。\n藤刺牵衣，碍却行人路。\n偏是无情偏解舞。\n濛濛扑面皆飞絮。\n绣院深沈谁是主。\n一朵孤花，墙角明如许。\n莫怨无人来折取。\n花开不合阳春暮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2151,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇 十月二日马上作","author":"龚自珍","text":"一帽红尘，行来韦杜人家北。\n满城风色，漠漠楼台隔。\n目送飞鸿，景入长天灭。\n关山绝，乱云千叠，江北江南雪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2152,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湘月","author":"龚自珍","text":"天风吹我，堕湖山一角，果然清丽。\n曾是东华生小客，回首苍茫无际。\n屠狗功名，雕龙文卷，岂是平生意。\n乡亲苏小，定应笑我非计。\n才见一抹斜阳，半堤芳草，顿惹清愁起。\n罗袜音尘何处觅，渺渺予怀孤寄。\n怨去吹箫，狂来说剑，两样消魂味。\n两般春梦，舻声荡入云水。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2153,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游匡庐晓行太阳山白鹤峰道中，次李少荃韵","author":"彭玉麟","text":"月破松梢晓，诗吟马上秋。\n凉风侵帽角，曙色淡鞭头。\n树影连村合，泉声咽石流。\n山花红夹道，揽辔任勾留。\n遥峰飞白鹤，野趣逼天真。\n境僻风尘壑，山高月近人。\n炊烟横鸟道，晓雾暗车尘。\n莫动悲秋感，丹枫别有春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2154,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日登滕王阁","author":"彭孙遹","text":"客路逢秋思易伤，江天烟景正苍凉。\n依然极浦生秋水，终古寒潮送夕阳。\n高士几回亭草绿，梅仙一去岭云荒。\n临风不见南来雁，书札何由达豫章？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2155,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"生查子•旅夜","author":"彭孙遹","text":"薄醉不成乡，转觉春寒重。\n枕席有谁同，夜夜和愁共。\n梦好恰如真，事往翻如梦。\n起立悄无言，残月生西弄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2156,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳梢青","author":"彭骏孙","text":"何事沉吟？\n小窗斜日，立遍春阴。\n翠袖天寒，青衫人老，一样伤心。\n十年旧事重寻，回首处，山高水深。\n两点眉峰，半分腰带，憔悴而今。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2157,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"桂湖五首","author":"曾国藩","text":"颇忆家山好，去乡兹六年。\n此间行乐地，小有洞庭天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2158,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"桂湖五首","author":"曾国藩","text":"点缀须人力，招寻信妙缘。\n使君殊不俗，把酒竟茫然。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2159,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题公牍","author":"曾国藩","text":"官儿尽大有何荣，字数太多看不清。\n减去数行重刻过，留教他日作铭旌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2160,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丁未六月七日考试汉教习试院作二首","author":"曾国藩","text":"虞廷胄子肄声律，汉室小侯齿辟雍。\n银汉支流原博大，壁门追琢要从容。\n师儒落落渺千载，针齐时时还一逢。\n明日邓林厅斧入，可能洞底拔长松。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2161,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三十二初度次日书怀","author":"曾国藩","text":"男儿三十殊非少，今我过之讵足欢！\n龌龊挚瓶嗟器小，酣歌鼓缶已春阑。\n眼中云物知何兆，镜里心情只独看。\n饱食甘眠无用处，多惭名字侣鹓鸾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2162,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书边袖石诗集后二首 其一","author":"曾国藩","text":"镌章琢句寻常事，激烈心情约可怜。\n今日词臣须颇牧，古来蒙士出幽燕。\n杨家忠义存三疏，孙相威名在九边。\n莫借文章追往哲，要凭肝胆报皇天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2163,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"书边袖石诗集后二首 其二","author":"曾国藩","text":"囗囗苦忆王仲宣，投簪浩荡卧江天。\n三年促膝从予坐，四海低头道子贤。\n北李南何各坛坫，枫青塞黑与缠绵。\n因君更逐停云想，望断襄阳落照边。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2164,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆弟二首 其一","author":"曾国藩","text":"无端绕室思茫茫，明月当天万瓦霜。\n可惜良宵空兀坐，遥怜诸弟在何方。\n纷纷书帙谁能展，艳艳灯花有底忙？\n出户独吟聊妄想，孤云断处是家乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2165,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆弟二首 其二","author":"曾国藩","text":"忽忆他时襄水上，恶风半夜撼春雷。\n舟人捩舵声同泣，客子扶床面已灰。\n仰荷皇天全薄命，信知浮世等轻埃。\n汝今归去复何似？\n回首世途诚险哉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2166,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"失题四首 其一","author":"曾国藩","text":"抽得闲身鹤不如，高秋酒熟鞠黄初。\n便驱天驷识途马，归钓江乡缩项鱼。\n往比已清随毂转，今来身世似舟虚。\n不须更说知此早，且喜尘缘尽划除。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2167,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"失题四首 其二","author":"曾国藩","text":"蜒雨蛮烟日日催，侧身周望重低徊。\n海滨膏血深无极，帐下笠歌自莫哀。\n安得贾生时痛哭，可怜杨仆本庸才。\n投章欲问茫茫意，何处通天尚有台？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2168,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"失题四首 其三","author":"曾国藩","text":"金堤旧溃高家堰，复道今年盛昔年。\n自古尘沙同浩劫，斯民涂炭岂前缘？\n沉江欲祷王尊壁，击揖谁挥祖逖鞭？\n大厦正须梁栋拄，先生何事赋归田？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2169,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"失题四首 其四","author":"曾国藩","text":"两度归帆溯上流，萧萧落木洞庭秋。\n送君此去风前酒，忆我当时月夜舟。\n弘景旧居勾曲洞，杜陵新卜烷溪头。\n好栽修竹一千亩，更抵人间万户侯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2170,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁暮杂感十首 其一","author":"曾国藩","text":"芒鞋镇日踏春还，残腊将更却等闲。\n三百六旬同逝水，四平涂里说家山。\n缁尘已自沾京雒，羌笛何须怨玉关。\n为报南来新雁到，故乡消息在云间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2171,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁暮杂感十首 其二","author":"曾国藩","text":"高嵋山下是侬家，岁岁年年斗物华。\n老柏有情还忆我，天桃无语自开花。\n几回南国思红豆，曾记西风院碧纱。\n最是故园难忘处，待等亭畔路三叉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2172,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁暮杂感十首 其三","author":"曾国藩","text":"莽莽寒山匝四围，眼穿望不到庭闱。\n絮漂江浦无人管，草绿湖南有梦归。\n乡思怕听残漏转，逸情欲逐乱云飞。\n敬从九烈神君诉，游子于今要换衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2173,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁暮杂感十首 其四","author":"曾国藩","text":"去年此际赋长征，豪气思屠大海鲸。\n湖上三更邀月饮，天边万岭挟舟行。\n竟将云梦吞如芥，求信君山刬不平。\n偏是东皇来去易，又吹草绿满蓬瀛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2174,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁暮杂感十首 其五","author":"曾国藩","text":"纷纷节候尽平常，西舍东家底事忙？\n十二万年都小劫，七千馀岁亦中殇。\n蜉蝣身世知何极，胡蝶梦魂又一场。\n少昊笑依情太寡，故堆锦绣富春光。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2175,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁暮杂感十首 其六","author":"曾国藩","text":"韶华弹指总悠悠，我到人间首五秋。\n自愧望洋迷学海，更无清福住糟邱。\n尊前瓦注曾于局，脚底红尘即九州。\n自笑此身何处著，笙歌丛里合闲游。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2176,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁暮杂感十首 其七","author":"曾国藩","text":"为臧为否两蹉跎，搔首乾坤踏踏歌。\n万事拼同骈拇视，浮生无奈茧丝多。\n频年踪迹随波活，大半光阴被墨磨。\n匣里龙泉吟不住，问予何日斫蛟鼍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2177,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁暮杂感十首 其八","author":"曾国藩","text":"旧雨曾遗尺鲤鱼，经年不报意何如？\n自从三益睽违久，学得五君世态疏。\n碧树那知离别憾，青灯偏照故人书。\n殷勤护惜金炉鸭，香火因缘付与渠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2178,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁暮杂感十首 其九","author":"曾国藩","text":"拟学坡公馈岁诗，花笺何处寄相思？\n阳和未老貂先敝，暖气初回鸟竟知。\n游子情怀随地远，天家雨露及时施。\n小儒莫献升平颂，幸傍龙楼睹上仪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2179,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岁暮杂感十首 其十","author":"曾国藩","text":"鼕鼕岁鼓走轻雷，竹马儿童彩戏才。\n仙仗九重围雾住，宫花一万锁烟开。\n迷离佳气从空绕，不断狂香拂面来。\n我比春风尤放荡，长安日日聘龙媒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2180,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"早发沔县遇雨","author":"曾国藩","text":"此身病起百无忧，敢为艰难一怨尤。\n晓雾忽飞千嶂雨，西风已作十分秋。\n近知地利其堪恃，早信人谋不自由。\n昨日定军山下过，苍天一望故悠悠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2181,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵何廉昉太守感怀述事十六首","author":"曾国藩","text":"薇阁藤厅淡淡红，多君翔步五云中。\n良缘彩凤双飞翼，慧业灵犀一点通。\n典郡四旬书上考，阖门八口祀昭忠。\n灾祥谁识天公意，休向西风泣路穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2182,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵何廉昉太守感怀述事十六首","author":"曾国藩","text":"江雪湖波路几千，壶头归葬事堪怜。\n铸金叩叩终何益？\n理玉深深不计年。\n夜月一钩凉蕙帐，春风十万散榆钱。\n神灵甲马如相助，莫造愁人叹逝川。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2183,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵何廉昉太守感怀述事十六首","author":"曾国藩","text":"浔阳江水接天长，良将新词皎雪霜。\n半壁东南支柱石，数州立女荐馨香。\n竟无音寿追克国，犹有嘉名配武乡。\n匹马寸金都谢绝，三明何必数西凉！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2184,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵何廉昉太守感怀述事十六首","author":"曾国藩","text":"山县寒儒守一经，出山姓字各芳馨。\n要令天下销兵气，争说湘中聚德星。\n旧雨三年精化碧，孤灯五夜眼常青。\n书生自有平成量，地脉何曾独效灵！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2185,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵何廉昉太守感怀述事十六首","author":"曾国藩","text":"鹤原横霣第三人，鹤唳华亭不复春。\n先轸归元何日是？\n虞翻相骨本来贫。\n科名久滞青云路，身手难扶赤日轮。\n十二万年香不灭，从渠捣麝作灰尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2186,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵何廉昉太守感怀述事 其一","author":"曾国藩","text":"沧海横流泽有鸿，微生独出一当熊。\n千艘梭织怒涛上，万幕笳吹明月中。\n屠罢长鲸波尚赤，战归骄马汗犹红。\n谁知春晚周郎老，更与东皇乞好风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2187,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵何廉昉太守感怀述事十六首","author":"曾国藩","text":"钟山祠庙岿然存，凭吊湖湘烈士魂。\n马革裹尸男子志，鸾刀祭膟圣明恩。\n弓旌夜动神依户，萧鼓春祈福满门。\n万世游人应指点，血殷篙眼古时痕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2188,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"次韵何廉昉太守感怀述事十六首","author":"曾国藩","text":"溢觞初引一泓泉，流出蛟龙万丈渊。\n从古精诚能破石，薰天事业不贪钱。\n腐儒封拜称诗伯，上策屯耕在现田。\n巨海茫茫终得岸，谁言精卫憾难填？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2189,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"至日二首 其一","author":"曾国藩","text":"久行忘节序，夙莫但奔忙。\n兹旦即长至，我征仍未央。\n寒云低树白，边日际山黄。\n时睹南来雁，飘零不作行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2190,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"至日二首 其二","author":"曾国藩","text":"海市三年舶，河源八月槎。\n水衡劳硕画，漆室足咨嗟。\n天步方长健，民饥亦有涯。\n燔柴崇大礼，灵贶正来赊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2191,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"初入四川境喜晴","author":"曾国藩","text":"万里关山睡梦中，今朝始洗眼朦胧。\n云头齐拥剑门上，峰势欲随江水东。\n楚客初来询物俗，蜀人从古足英雄。\n卧龙跃马今安在？\n极目天边意未穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2192,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送孙芝房使贵州二首 其一","author":"曾国藩","text":"妙年作赋动明光，又策星轺赴夜郎。\n文采边陬瞻泰斗，仪容寸步中宫商。\n沈湘过访三闾庙，宛叶行经百战场。\n定有新诗传万口，归来吾与解奚囊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2193,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送孙芝房使贵州二首 其二","author":"曾国藩","text":"六年陈迹君能记，病骨秋风入剑关。\n曾洗人天清净眼，饱看巴蜀怪奇山。\n君今岩壑搜群玉，自有光芒照百蛮。\n不似老夫徒碌碌，昆冈一网手空还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2194,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送金竺虔之官闽中","author":"曾国藩","text":"朋好翩翩去，君今伤此行。\n春风一杯酒，旧雨十年情。\n循吏平生志，神仙薄幸名。\n海隅氛正恶，看法斫长鲸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2195,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闻客话里中近事","author":"曾国藩","text":"蓬莱清浅信推迁，回首乡关事可怜。\n今日朝簪陪末秩，早时社鼓舞华筵。\n陈平宰国无消息，质倍辞家有岁年。\n蹙蹙生涯非我里，滔滔四望极敷天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2196,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"桂湖五首","author":"曾国藩","text":"十里荷花海，我来吁已迟。\n小桥通野港，坏艇卧西陂。\n曲岸能藏鹭，盘涡尚戏龟。\n倾城游女盛，好是采莲时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2197,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"桂湖五首","author":"曾国藩","text":"短城三面绕，浅水半篙寒。\n鸟过穿残日；自行起寸澜。\n秋来楼阁静，幽处地天宽。\n平昔江湖性，真思老钓竿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2198,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"桂湖五首","author":"曾国藩","text":"矮桂枝钩袖，丛空叶打头。\n堤行皆反径，路断得高楼。\n栏槛干回锦，琉璃五色秋。\n落霞沉水底，绮散不能收。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2199,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"桂湖五首","author":"曾国藩","text":"遂刘华阳国，归程始此赊。\n翻然名境访，来及夕阳斜。\n翠竹偎寒蝶，丹枫噪幕鸦。\n词人云异代，临水一咨嗟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2200,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄郭筠仙浙江四首 其一","author":"曾国藩","text":"一病多劳勤护措，嗟君此别太匆匆。\n二三知己天涯隔，强半光阴道路中。\n免走会须营窟穴，鸿飞原不计西东。\n读书识字知何益？\n赢得行踪似转蓬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2201,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄郭筠仙浙江四首 其二","author":"曾国藩","text":"碣石造这起阵云，楼船羽檄日纷纷。\n螳螂竟欲当车撤，髋髀安能抗斧斤？\n但解终童陈策略，已闻王歙立功勋。\n如今旅梦应安稳，早绝天骄荡海氛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2202,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄郭筠仙浙江四首 其三","author":"曾国藩","text":"无穷志愿付因循，弹指人间三十春。\n一局楸枰虞变幻，百围梁栋藉轮囷。\n苍茫独立时怀古，艰苦新尝识保身。\n自愧太仓縻好爵，故交数辈尚清贫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2203,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄郭筠仙浙江四首 其四","author":"曾国藩","text":"向晚严需破屋寒，娟娟纤月倚檐端。\n自给行箧殷勤觅，苦索家书展转看。\n宦海情怀蝉翼薄，离人心绪茧丝团。\n更怜吴会飘零客，纸帐孤灯坐夜阑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2204,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]