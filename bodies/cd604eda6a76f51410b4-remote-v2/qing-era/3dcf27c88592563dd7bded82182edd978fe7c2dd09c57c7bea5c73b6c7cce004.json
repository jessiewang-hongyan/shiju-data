ha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读《五代史》杂咏三十九首 其三十一","author":"张晋","text":"微服闲游任所之，尖巾裹首状如锥。\n□□狎客工嘲戏，独有嘉王是酒悲。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37944,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读《五代史》杂咏三十九首 其三十二","author":"张晋","text":"一曲甘州妙入神，龙船画舸耀江津。\n看他轻薄成何事，那不终为入草人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37945,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读《五代史》杂咏三十九首 其三十三","author":"张晋","text":"兵出无名倩蜡丸，汴州赐第压河千。\n国亡已兆长春节，回首桃符不忍看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37946,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读《五代史》杂咏三十九首 其三十四","author":"张晋","text":"指挥如意逞风流，股栗何曾展一筹。\n更笑世修降表者，成都不独有谯周。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37947,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读《五代史》杂咏三十九首 其三十五","author":"张晋","text":"歌词慷慨记依稀，三节还乡挂锦衣。\n喜煞座中诸父老，看他草木亦光辉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37948,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读《五代史》杂咏三十九首 其三十六","author":"张晋","text":"大罗仙境杳何方，受册还须拜宝皇。\n眼底已无春燕影，帐中惟贮一归郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37949,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读《五代史》杂咏三十九首 其三十七","author":"张晋","text":"万里降王执梃来，素衣白马有谁哀。\n朝廷自是恩如海，肯赐刘郎酖一杯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37950,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读《五代史》杂咏三十九首 其三十八","author":"张晋","text":"衣遏手迹绣如新，道上□□劫四邻。\n一事合呼高赖子，逢人称帝便称臣。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37951,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读《五代史》杂咏三十九首 其三十九","author":"张晋","text":"河东兵甲势全摧，尚抗王师不肯来。\n怜尔区区非叛者，不妨生路暂时开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37952,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梦中得梦到故山闲五字因足成之","author":"张晋","text":"客子意不适，风尘无好颜。\n愁随秋月老，梦到故山闲。\n何日赋招隐，逍遥丛桂间。\n长歌抛俗虑，高卧掩柴关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37953,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九月二十日醉后作四章 其一","author":"张晋","text":"秋风凄以肃，能令百草死。\n奈何摇落中，独解吹愁起。\n登高眺川原，据案屏书史。\n出愁入亦愁，郁郁忽如此。\n未知愁所生，安识愁所止。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37954,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九月二十日醉后作四章 其二","author":"张晋","text":"惊飙摧败叶，寒雨零残英。\n穷士受众侮，哀哉同此情。\n怀中字漫灭，歧路空屏营。\n好竽而鼓瑟，谁能赏其声。\n受侮乃自招，无为不平鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37955,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九月二十日醉后作四章 其三","author":"张晋","text":"读书破万卷，不救饥与寒。\n出门行万里，不觉世途宽。\n骐骥负盐车，驽骀饰雕鞍。\n岂真才不及，时运实使然。\n自古类如此，思之摧肺肝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37956,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九月二十日醉后作四章 其四","author":"张晋","text":"夙昔工词章，欲以垂不朽。\n九原我为谁，徒快众人口。\n众誉我不知，此情亦何有。\n会须断结习，弃置等刍狗。\n使有身后名，何如一杯酒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37957,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将抵清丰载园刺史约纡道游一味庵 看海棠得绝句二首 其一","author":"张晋","text":"植棠院里看年年，又结风尘邂逅缘。\n底事多情抛不得，也应唤作海棠颠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37958,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将抵清丰载园刺史约纡道游一味庵 看海棠得绝句二首 其二","author":"张晋","text":"征车小住日初斜，几度流连兴尚赊。\n我逊野人是清福，一年饱看一春花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37959,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题杨梦莲诗集后","author":"张晋","text":"壮怀落落叹浮沉，激楚凄凉寄托深。\n百折难回名士志，半生工写美人心。\n绿波春水江郎赋，香草幽兰楚客吟。\n莫怪新诗同敝帚，天涯能得几知音。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37960,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"癸亥春夜与李二莪璋香小饮醉后有赠 其一","author":"张晋","text":"我有七弦琴，挥弦觅赏音。\n谁知弹别调，亦复有同心。\n之子美丰骨，高怀超古今。\n西窗剪官烛，慰藉意何深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37961,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"癸亥春夜与李二莪璋香小饮醉后有赠 其二","author":"张晋","text":"扰扰笑时辈，悠悠岂丈夫。\n平生甘淡泊，富贵亦须臾。\n敝帚仍高价，长镵任腐儒。\n驾车怜阮籍，只解哭穷途。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37962,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"癸亥春夜与李二莪璋香小饮醉后有赠 其三","author":"张晋","text":"实时一杯酒，身后复谁知。\n非有名心在，安能为此辞。\n吾徒羞作达，逝者已如斯。\n各勉千秋业，无增老大悲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37963,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日载园刺史约同人游瑕邱作","author":"张晋","text":"行乐无古今，陵谷有变迁。\n风流不歇绝，赖此文字传。\n斯邱载《檀弓》，遗迹幸未湮。\n主人约嘉客，选胜追昔贤。\n登顿忽忘疲，周览开心颜。\n是时雨初霁，林木含朝烟。\n微风荡空翠，扑我襟袖间。\n千里纵远目，平楚何苍然。\n恨不起往哲，执手同周旋。\n主人发高唱，实从挥锦笺。\n修禊咏《兰亭》，雅集记《西园》。\n以今而视昔，夫复何让焉。\n斜阳欲西匿，去去还流连。\n谁是后来者，一笑摇归鞭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37964,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题范楷亭参戎指画图解时楷亭已因事罢官","author":"张晋","text":"将军善画古莫比，平生不用毛锥子。\n以心使臂臂使指，顷刻烟云落满纸。\n浓皴澹抹各有法，细入微芒巨千里。\n怪兽奇禽俨若生，山是真山水真水。\n西风飒飒草木秋，将军跨马来澶州。\n袜材挥尽气磅礴，猛虎据地鹰脱鞲。\n我时在侧袖两手，看君十指龙蛇走。\n伏几揎袖神意闲，作势已到秋毫颠。\n有时或用巨灵掌，有时亦复挥老拳。\n将军善画盖有神，欲将此法传后人。\n手着一编出示我，以指喻指通精灵。\n作歌为君拔抑塞，歌罢掷笔双眉伸。\n人生坎坷终须忍，富贵浮云供一哂。\n如君何亚曹将军，愧余难学丹青引。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37965,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"移家澶渊呈载园刺史","author":"张晋","text":"岂不怀乡里，翻为尽室行。\n一贫累妻子，百事费经营。\n地僻春堪赁，心闲梦自清。\n南州劳设榻，今我亦苍生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37966,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"丙子四十初度","author":"张晋","text":"我生叹不辰，风尘惯奔走。\n饥来驱我去，波累及嘉偶。\n去年寓澶渊，牛衣幸相守。\n客中慰我愁，操作到箕帚。\n家计苦逼仄，君已尝之久。\n甘作庑下人，颇称闺中友。\n流光等飞电，春光媚杨柳。\n首正逢甲子，设帨值下九。\n平头四十年，幸未惊老丑。\n双雏绕膝戏，亦解祝君寿。\n我欲进一觞，乃与君谋酒。\n瓦釜蒸黄粱，家筵剪春韭。\n欢笑过良时，富贵亦何有。\n有生真如寄，最苦谋升斗。\n羁怀念乡国，钓游记某某。\n仰首看浮云，白衣变苍狗。\n鹿车如共挽，群仙定抗手。\n山中岁月长，此意君知否。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37967,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"行抵涿州见西山作","author":"张晋","text":"红尘滚滚车马喧，车中兀坐如枯禅。\n偶然开眸一笑粲，万迭西山当我前。\n有如苦闹避热客，忽逢静友相周旋。\n浮岚积翠宕心目，不必策杖穷其颠。\n我生三度到京国，严寒酷暑嗟难言。\n问余何事苦仆仆，自反不觉心茫然。\n小山丛桂屡招隐，负郭惜少二顷田。\n朝来驱车看山色，山灵对我空好颜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37968,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"涿州谒桓侯庙","author":"张晋","text":"矛马千秋意气粗，遗铭刁斗认模糊。\n断头能释将军缚，兵子何妨下士呼。\n地接楼桑村尚在，勇同壮缪命皆无。\n灵旗影里瞻遗像，敢把英雄拟狗屠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37969,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"挽陈明轩炳炜舅氏时殁于黄河工次","author":"张晋","text":"豪情侠气两无俦，忽堕元龙百尺楼。\n黄阁青山归路杳，惊沙急浪一棺愁。\n半生长物惟诗卷，何处栖魂不首邱。\n此日羊昙悲更甚，独携马策哭西州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37970,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读张船山问陶太史诗集题后","author":"张晋","text":"手携飞帜上骚坛，诗笔文心两屈盘。\n才并长卿工赋易，人同平子遣愁难。\n岂徒饮酒称名士，只合高歌配冷官。\n我亦千金珍敝帚，几回拂拭待君看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37971,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"只耳儿歌戏为延子劼汝寿作","author":"张晋","text":"堕地初试啼声罢，家人走报各惊诧。\n吉梦非熊亦非罴，蜿蜒亲见乖龙下。\n重瞳骈胁古有之，貌异毕竟非凡儿。\n岂真造物故簸弄，要留缺陷夸神奇。\n闻尘半塞闻根在，蚁动牛斗不瞆瞆。\n君不见，后夔一足行即僵，典乐公然来凤凰。\n君不见，师旷当年两目瞽，暗中还能辨石语。\n只耳儿，庸何伤，两耳苟不聪，不如一耳良。\n五官之中耳司听，只耳何曾不用命。\n但教声入即心通，两耳翻嫌一耳剩。\n延生抱子来我前，索我为儿歌长篇。\n雪肤玉貌果英物，人皆贵耳吾不然。\n他日抗宗望此子，额痒定应出三耳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":37972,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]