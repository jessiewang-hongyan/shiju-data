[{"title":"梦回","author":"曾习经","text":"坠露零烟半有无，梦回金井但啼乌。\n愿携冰雪亲姑射，密写云谣礼曼殊。\n废苑荒来馀橡栗，下山拾得只蘼芜。\n孤根自信今漂泊，未必秋兰怨女媭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42975,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"瑶华琵琶词","author":"曾习经","text":"铜盘腻蜡红阑珊，屏风匼闸银交关。\n四更缺月未欲落，门外马嘶何处郎。\n问郎微行夜何昏，出帘逢迎欢相闻。\n轻衫薄袖欲成梦，星波回荡痴如云。\n促坐微寒亲手奉，香熏罗荐春无缝。\n擘石研丹不算情，一夜雏龙忆幺凤。\n屈戌铜钩鹦鹉啼，繁声暗恨须臾期。\n可怜月落郎又去，被酒出门闻马嘶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42976,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹦鹉词","author":"曾习经","text":"画罗轻明前后阁，云屏梦破山断续。\n琼钩一夜怯春霜，恨锁千年葳蕤绿。\n隔帘委坠见春丝，频频呼唤酒消迟。\n绡轻佩重不胜起，烟痕影态相参差。\n紫蝶黄蜂俱游倦，樱桃花落垂杨巷。\n瘦尽东杨白袷衣，寄与南云慰凄惋。\n登天抱云云如轻，虚堂耿耿秋荷明。\n五更烛骑蹄呜去，银弯流水东西倾。\n断烬遗香掩薄愁，玉珰不到瑶华楼。\n夜夜娇郎眠何处，雨落月明鹦自语。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42977,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"露夕","author":"曾习经","text":"孔雀西飞月满楼，露丛烟草是今秋。\n严城清角呜呜咽，独夜幺弦瑟瑟愁。\n不信端居劳梦想，未应暂动又还休。\n银河浅浅流云媚，猛省星期过女牛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42978,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湖广司白杏花","author":"曾习经","text":"乌帽欹斜晚放衙，亚墙风动玉交加。\n春阴十日无多雨，清绝曹司白杏花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42979,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送常熟翁师傅归里六首 其一","author":"曾习经","text":"天问殊难答，臣心久郁陶。\n遥怜贾生策，不分屈平骚。\n江海沉名易，湖山歌舞劳。\n向来忧国意，馀愿老蓬蒿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42980,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送常熟翁师傅归里六首 其二","author":"曾习经","text":"从此遂摇落，于今真远游。\n浮云低被渚，孤月过南洲。\n文藻秋兰气，客心沧海流。\n凉风起天末，凄断殿西头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42981,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送常熟翁师傅归里六首 其三","author":"曾习经","text":"五月南风发，江涛送远人。\n时穷仍适意，隐乱若栖真。\n太息吾安放，凄其天所亲。\n最怜双阙月，流涕念霜晨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42982,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送常熟翁师傅归里六首 其四","author":"曾习经","text":"历历明星下，其如北斗孤。\n残钟沉百杵，过客问三闾。\n寥落得秋意，栖迟耽道书。\n百年从此远，相忆到今无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42983,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送常熟翁师傅归里六首 其五","author":"曾习经","text":"誓墓今头白，还山闵世纷。\n徘徊终自信，哀怨有深文。\n怅望期前哲，忧危感至尊。\n行行重回首，漂泊奉明恩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42984,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送常熟翁师傅归里六首 其六","author":"曾习经","text":"旧梦承恩诏，遥年党禁文。\n回风伤往日，之子念夫君。\n故苑蘼芜意，荒陂凫雁群。\n何时陪杖履，拭涕极南云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42985,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"落叶四首 其一","author":"曾习经","text":"月过庭阴鹊踏枝，空阶凉漏报签迟。\n十年走马荒山道，一曲哀蝉乐府词。\n关塞秋心和梦碎，淮南新恨长年悲。\n飞花飞絮都含恨，犹及春风烂漫时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42986,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"落叶四首 其二","author":"曾习经","text":"落日三家乌桕村，度阡越陌枉相存。\n旧时歌舞飞鸾影，晚上帘栊蛱蝶魂。\n祠宇拂云凉似水，空山吹火不成温。\n新霜最是无情思，山鬼牵罗夜打门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42987,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"落叶四首 其三","author":"曾习经","text":"摇落年年自寂寥，白头书客坐深宵。\n寒灯隔雨秋成梦，白板支风月似潮。\n圣女祠荒鸳瓦坠，洞庭波落锦书遥。\n沉鳞羁羽都萧瑟，历历星明堕竹梢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42988,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"落叶四首 其四","author":"曾习经","text":"回头飘荡复东西，不分天云与井泥。\n汉寝旧馀青玉案，晋宫新舞白铜鞮。\n凄凄芳草闻啼鴂，兀兀丛祠似碧鸡。\n西北高楼临大道，断烟残照总凄迷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42989,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杂忆三首 其一","author":"曾习经","text":"新凉渐到郁金堂，轻影惭花梦恼香。\n忆得王孙最矜贵，自持银烛照明妆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42990,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杂忆三首 其二","author":"曾习经","text":"夜明帘下数秋星，月地云阶又一层。\n忆得王孙祠中酒，玉纤亲手坐调冰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42991,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杂忆三首 其三","author":"曾习经","text":"但无言语镇相看，自起更衣怯嫩寒。\n忆得王孙归较晚，笼花薄月夜阑珊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42992,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题朝鲜闵妃像二首 其一","author":"曾习经","text":"紫泥烧作鸳鸯瓦，红泪滴成玫瑰花。\n一样含情复含恨，弯弯眉月玉钩斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42993,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题朝鲜闵妃像二首 其二","author":"曾习经","text":"亡国曾逢赵大夫，落花台殿说啼乌。\n春来遍是红心草，曾见宫人瘗玉鱼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42994,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"听雨","author":"曾习经","text":"听雨帘栊漏板沉，残春小梦便关心。\n只愁泥滑妨骄马，却恨轻寒殢晚禽。\n水阁人归灯悄悄，露桃花落思愔愔。\n流年暗逐东风远，后夜相思那可寻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42995,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"废陌","author":"曾习经","text":"度陌临流意已凄，一年芳物不堪题。\n回塘水落鸳鸯冷，废井秋荒络纬啼。\n四角回文还向里，东南初日渐坐西。\n条桑百结罗敷怨，自捲绡衣爱整齐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42996,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷杂诗十八首 其一","author":"曾习经","text":"霜烛裁衣剪，见帘扑枣竿。\n比邻槽黍酒，留客饤蔬盘。\n宛宛家人意，凄凄故国欢。\n遥怜秋社燕，随处觅檀栾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42997,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷杂诗十八首 其二","author":"曾习经","text":"南郭陂陀小，东阡黍稷垂。\n铜驼无近信，金雁有哀词。\n离乱仍相失，苍茫只自悲。\n蟪蛄吾与尔，还共故山期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42998,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷杂诗十八首 其三","author":"曾习经","text":"秋气已如此，归期竟寂寥。\n国觞何处酹，乡泪暗中消。\n觅食艰梁稻，看人揠豆苗。\n荒山愁足茧，农圃坐相邀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":42999,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷杂诗十八首 其四","author":"曾习经","text":"露下星初晚，香消夜若何。\n小姑怜月姐，老妪拜风婆。\n瓜果唐年旧，餦餭汉制多。\n殊乡风土记，他日说经过。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43000,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷杂诗十八首 其五","author":"曾习经","text":"斗俊五陵侠，防秋三辅豪。\n明童珠络索，姹女紫丝绦。\n相许曾无吝，同仇肯念劳。\n幽闺亦清绝，临夜绣弓韬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43001,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷杂诗十八首 其六","author":"曾习经","text":"秋色美无度，相携过石桥。\n水花明岸脚，霜叶下亭椒。\n幽览殊未已，佳人不可招。\n空庭还独步，何以慰迢遥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43002,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷杂诗十八首 其七","author":"曾习经","text":"七十盘山寺，伽蓝半忘名。\n行宫摇落后，羁客去来情。\n玉辇埋荒草，金轮迫上清。\n乾隆朝士尽，空望月华明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43003,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷杂诗十八首 其八","author":"曾习经","text":"搓手胡桃核，熏笼栗子花。\n居人閒织罽，官长冷排衙。\n荒集惟挑菜，山池见沤麻。\n此乡原可隐，叹息待移家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43004,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷杂诗十八首 其九","author":"曾习经","text":"野鹿衔花去，苍茫望寝陵。\n边城秋牧马，猎户晚调鹰。\n药笼逢行估，黄差走驿承。\n年时秋露感，流涕话山僧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43005,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷杂诗十八首 其十","author":"曾习经","text":"五亩公田秫，千条陌上桑。\n秋迟逢岁闰，酒熟始宵长。\n蜀黍霜匙滑，巴菰露叶香。\n天涯流浪处，閒坐得思量。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43006,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷杂诗十八首 其十一","author":"曾习经","text":"理易发残箧，前贤忧患书。\n沉吟还自信，窃比意何如。\n卖卜辞桥市，称医惜隐居。\n自怜拙生计，秋雨采蘼芜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43007,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷杂诗十八首 其十二","author":"曾习经","text":"未倦穷途意，新凉正养疴。\n故家辞领海，残梦落交河。\n夜雨淋铃曲，秋风敕勒歌。\n杜陵原野老，流泪满江沱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43008,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷杂诗十八首 其十三","author":"曾习经","text":"旧垒旌旗尽，荒城太白高。\n鲁连迟蹈海，伍相故乘涛。\n覆辙伤钩党，中原半绎骚。\n蘋浮望南北，馀愿老蓬蒿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43009,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷杂诗十八首 其十四","author":"曾习经","text":"沟水正渐车，田盘绕屋庐。\n行人时饮马，邻叟偶叉鱼。\n榾柮看炉火，支离耽道书。\n偷生忘岁月，归梦亦踌躇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43010,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷杂诗十八首 其十五","author":"曾习经","text":"不迕秋风意，溪头岸角巾。\n似闻阿谷女，相讶武陵人。\n避地爱林壑，寻歌浃隐沦。\n向来江海梦，流落见天真。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43011,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷杂诗十八首 其十六","author":"曾习经","text":"空谷幽人怨，山城戍卒呼。\n残兵抛断镞，过客卖明珠。\n晚市鱼虾贱，荒阡草树芜。\n灵风祠圣女，凄绝夜啼乌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43012,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷杂诗十八首 其十七","author":"曾习经","text":"乱势今无已，客行殊未央。\n长谣仍独酌，小枕当还乡。\n梨枣家家熟，星辰夜夜望。\n十年忧国意，拭泪到沧桑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43013,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷杂诗十八首 其十八","author":"曾习经","text":"楚泽哀时命，田园归去来。\n室庐无定处，风雨犹深怀。\n短策支颐久，单衣至骭裁。\n比邻逢李叟，还讯菊花开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43014,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷秋兴六首 其一","author":"曾习经","text":"苌楚阿娜枝自摇，荒山无树著凌霄。\n惊风尽日吹骡铎，积雨连旬覆燕巢。\n此地旧馀边塞月，归心遥望海东潮。\n江南信美哀吾土，虚为羁旅赋大招。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43015,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷秋兴六首 其二","author":"曾习经","text":"画角呜咽闭禁城，不堪垂泪更分明。\n未成报国惭儒术，宛是还乡听鼓声。\n一月照人愁欲绝，百年多难若为情。\n未知忧患犹多少，羡尔厨头老步兵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43016,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷秋兴六首 其三","author":"曾习经","text":"零落栖迟不自由，山城风雨晚登楼。\n邻墙枣熟儿童喜，陌上桑姑少妇愁。\n月魄阴沉鱼脑减，星河迢递雁声遒。\n閒闺病起空搓手，三月朝簪不上头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43017,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷秋兴六首 其四","author":"曾习经","text":"风物殊乡见亦稀，残荷疏柳水深围。\n王官行李愁弹铗，阿谷闺人故浣衣。\n荒戍草深秋渐老，故侯瓜熟客忘归。\n侧身南望还零涕，晏岁从谁赋采薇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43018,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷秋兴六首 其五","author":"曾习经","text":"忧郁无聊暂息机，吾庐栗里是耶非。\n环溪村舍栽乌桕，落日牛羊下翠微。\n薄月依云天若梦，百虫啼雨叶低飞。\n上陵满目茫茫感，惆怅王孙何处归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43019,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平谷秋兴六首 其六","author":"曾习经","text":"雾阁云楼黯几层，炊粱梦起思腾腾。\n愁肠酒汤茶三碗，晞发风微月半棱。\n厌乱人方思故业，藏山书拟约良棚。\n一瓢随分谋栖息，凫鸟荒陂共夜灯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43020,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"庚子年慨时","author":"曾习经","text":"玉帐牙旗尽将才，潞河军散事堪哀。\n荒城晚雨呜胡角，遥野晨星落上台。\n井路牵衣宁惜别，重围卸剑正疑猜。\n传闻西幸龙鸾队，密遣延秋夜半来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43021,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春心 六首 其一","author":"曾习经","text":"十日层楼九风雨，三年故国百思量。\n逢人只信春憔悴，不道闻欢觉小伤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43022,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春心 六首 其二","author":"曾习经","text":"片片清霜叶叶云，梨花嫌冷絮嫌温。\n何人策马来相过，双燕归时尽掩门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43023,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春心 六首 其三","author":"曾习经","text":"别梦依稀过谢桥，心中风雨暗潇潇。\n自从拾得杨花片，不见章台见柳条。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43024,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春心 六首 其四","author":"曾习经","text":"板阁微寒酒半消，露桃花底漏迢迢。\n凭谁说与春晓短，试向银屏坐寂寥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43025,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春心 六首 其五","author":"曾习经","text":"不教王令迎桃叶，空见宫人送水云。\n自信飘零文字海，年年清泪照金尊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43026,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春心 六首 其六","author":"曾习经","text":"罗带春馀特地垂，南唐新恨恶禁持。\n可怜繁杏阴阴地，几日墙东不再窥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43027,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病起读党锢传","author":"曾习经","text":"秋玉何妨折，明灯竟自煎。\n不才逢世难，将泪寄遥年。\n此意无人识，孤情不厌偏。\n惟怜新病后，残月曳虚弦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43028,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"别梦五首 其一","author":"曾习经","text":"别来细雨闻孤馆，归去花灯烂九枝。\n怅望青溪神女曲，去年今日蒋王祠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43029,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"别梦五首 其二","author":"曾习经","text":"宫扇葳蕤半褪金，一篇哀丽旧伤心。\n他时满灭无文字，犹得情人宛转吟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43030,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"别梦五首 其三","author":"曾习经","text":"秋河别夜太凄凉，一曲伊州泪万行。\n记得五陵年少事，金鞭玉勒送王昌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43031,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"别梦五首 其四","author":"曾习经","text":"微波终日不通辞，相见曾如不见时。\n正是思君寒未寝，银灯留焰照罗衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43032,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"别梦五首 其五","author":"曾习经","text":"燕燕归期泪满巾，相逢何必便相亲。\n重来亦有歌桃叶，只是烟波不解颦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43033,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"观剧","author":"曾习经","text":"凤啄红灯照绮床，佩珠钗玉总生光。\n可怜前夜华山剧，肠断班骓送陆郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43034,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"有感","author":"曾习经","text":"故径蘼芜不可寻，小楼烟霭暮愔愔。\n东风几日飞幺凤，零落桐花一寸深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43035,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闻歌","author":"曾习经","text":"怅望游龙不再吟，修髯朔客思愔愔。\n寻常蹋地能生忆，到处飞花故作阴。\n春去稍怜残梦在，酒醒长是雨声淫。\n旅魂正恨经南馆，未抵闻歌一夜心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43036,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"寄题陈简持角山亭","author":"曾习经","text":"万山表海烟尘静，九月微霜塞草青。\n閒却行边旧持节，百金新筑角山亭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43037,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南归初发都留别寓居草树五首 其一 老槐","author":"曾习经","text":"十年槐树下，劳劳役尘梦。\n起视西南枝，亦有微风动。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43038,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南归初发都留别寓居草树五首 其二 海棠","author":"曾习经","text":"去年无一花，今年花特盛。\n已矣别离心，惭谢殷勤敬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43039,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南归初发都留别寓居草树五首 其三 柳","author":"曾习经","text":"手种垂杨树，春来堪揽结。\n临夜正东风，会有淡黄月。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43040,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南归初发都留别寓居草树五首 其四 紫藤","author":"曾习经","text":"特将万璎珞，回施呻吟地。\n但来当春时，犹堪作饼饵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43041,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南归初发都留别寓居草树五首 其五 葡萄","author":"曾习经","text":"零落半床阴，结实酢如李。\n怜尔行人心，风味略相似。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43042,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题姻亲郭信发实颐夫妻像赞 诰授昭武都尉郭君像赞","author":"曾习经","text":"抗心希古，养素全真。\n体之以质，彪之以文。\n婆娑丘园，从容道德。\n隐之弥曜，渊乎莫测。\n觥觥清节，悠悠我思。\n有道之碑，唯无愧辞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":43043,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]