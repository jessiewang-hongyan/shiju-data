[{"title":"端阳相州道中题魏家营壁 其二","author":"张问陶","text":"杏子樱桃次第圆，炎凉无定麦秋天。\n马蹄步步来时路，照眼榴花又一年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41854,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宜沟晓发覆车","author":"张问陶","text":"旋辕一蹶夜模糊，覆辙徒劳戒仆夫。\n自恃神全能不死，莫誇马老尽知途。\n回车陇坂空怀古，折臂公卿那到吾。\n记得家山携蜡屐，醉归从未倩人扶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41855,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"英豪","author":"张问陶","text":"山云陇树远苍苍，铃语鸡声趁早凉。\n熊耳数峰青似黛，马头初日白于霜。\n途长屡觉人音换，食俭全凭骨力强。\n笑煞当年苏季子，《阴符》一卷速秦亡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41856,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"硖石驿题壁","author":"张问陶","text":"秦关高迥暮云齐，回首中原万壑低。\n自往自来三辅北，无风无雨二陵西。\n店门柳色思前度，驿路槐花觅旧题。\n谁道崤函天下险，时平不用一丸泥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41857,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"灵宝","author":"张问陶","text":"风尘常恨别离轻，又向桃林塞上行。\n古戍隔河微见影，乱山迎客不知名。\n帷车闭置如新妇，茅店酣呼杂老兵。\n明日入关须痛饮，卧看残月堕鸡声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41858,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"函谷关","author":"张问陶","text":"战地生机尽，时和草不蕃。\n干戈贻实祸，《道德》寄空言。\n穴处民风鸷，沙飞日气烦。\n秦人从古拙，那解住桃源。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41859,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"泉鸠","author":"张问陶","text":"赤日黄云打麦天，一湾柔绿自娟娟。\n风沙孤负泉鸠水，移向江南定可怜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41860,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"盘豆驿","author":"张问陶","text":"驿路风尘暗，重关说未归。\n汉原多暮色，秦月有寒威。\n碧树围山馆，黄沙点客衣。\n樊南馀韵在，遥岸荻芦肥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41861,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"潼关","author":"张问陶","text":"时平容易度雄关，拍马河潼自往还。\n一曲纁黄瓜蔓水，数峰苍翠华阴山。\n登陴筑版丁男壮，呼酒烹羊守吏閒。\n最是绿杨斜掩处，红衫青笠画图间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41862,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"苻秦王武侯墓下作","author":"张问陶","text":"扪虱雄谈举世无，英雄毕竟耻为儒。\n人如诸葛真名士，天屈夷吾佐霸图。\n垂死尚闻三叹息，过江宁免一征诛。\n独怜王谢持衡日，惟让桓温物色殊。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41863,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登华阴庙万寿阁望岳同亥白兄作","author":"张问陶","text":"车马年年太华西，几时结屋傍云梯。\n人宜玉女峰头老，天近莲花顶上低。\n地擘雍梁山自好，诗留李杜我何题。\n归将阅历誇邻叟，指点图经定不迷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41864,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"华州","author":"张问陶","text":"城郭垂杨里，村墟少华前。\n年丰民气健，山近土膏坚。\n麦酒难疗渴，驼羹不取钱。\n可怜西去客，枵腹过秦川。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41865,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"华州西溪","author":"张问陶","text":"功曹游宴处，风景亦无双。\n鱼鸟犹天宝，烟波小曲江。\n丛祠环水木，少华满轩窗。\n更访松谈阁，新苔绣石矼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41866,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渭南遇雨","author":"张问陶","text":"买得征车日日晴，炎风酷暑送行旌。\n朝来一雨清人肺，卧看垂杨过渭城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41867,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"骊山杂咏 其一","author":"张问陶","text":"宝炬金莲照地光，山云犹自想衣裳。\n念奴憔悴龟年老，谁与诗人吊夜郎？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41868,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"骊山杂咏 其二","author":"张问陶","text":"赐酒争怜塞上酥，销魂一斛旧明珠。\n不知清艳楼东赋，敌得《霓裳》小序无？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41869,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西安客夜","author":"张问陶","text":"紫阁蓝田取次过，倦驱老马向山阿。\n貂裘易敝真愁绝，髀肉难生可奈何。\n诗入阙中风雅健，人从灞上别离多。\n城南甲第誇韦杜，谁拨荒烟吊薜萝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41870,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"发西安","author":"张问陶","text":"终南云物送征鞍，回首西京渐渺漫。\n驴背小诗吟杜曲，酒边短烛话长安。\n百年上策还乡好，万里浮名行路难。\n此际故园应忆我，荒鸡残月五更寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41871,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咸阳怀古","author":"张问陶","text":"鄠杜莺花负好春，武皇遗迹已成陈。\n通天台观连云起，莫指阿房独过秦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41872,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"岐山","author":"张问陶","text":"地脉连丰镐，岐阳草木灵。\n溪璜荣渭水，石鼓剥周铭。\n细柳凝官绿，遥山簇帝青。\n栈云西望合，愁问短长亭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41873,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望太白山","author":"张问陶","text":"形势抗西岳，尊严朝百灵。\n雪留秦漠白，山界雍梁青。\n鸟道欺三峡，神功怯五丁。\n峨眉可横绝，归梦记曾经。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41874,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望栈道作","author":"张问陶","text":"返照明汧渭，苍苍见益门。\n乱峰迎客舞，一水抱沙昏。\n峡仄牛羊细，林高虎豹尊。\n陈仓须尽醉，今日尚平原。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41875,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"宝鸡","author":"张问陶","text":"卖酒楼何处，荒台尚祀鸡。\n人烟汧水北，乡梦益门西。\n山入回中乱，天临剑外低。\n子规如识我，犹为尽情啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41876,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"益门镇石上小憩","author":"张问陶","text":"烟柳护寒溪，长桥覆湿苇。\n风尘不能到，云日自清美。\n黄石知我心，无言坐沙尾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41877,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"二里关","author":"张问陶","text":"还山不厌山，回首谢平旷。\n峦壑喜我归，参差出林望。\n征衣湿寒雾，忽度浮云上。\n啼鸟识乡音，急流清俗状。\n梯磴疑鬼凿，岩花笑相向。\n平生物外心，悔与风尘抗。\n旧游如梦寐，指点多昏忘。\n触眼乱青红，翻欲惊奇创。\n才荒避险韵，秀语冀天贶。\n莫叹太瘦生，枯吟转神王。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41878,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"煎茶坪题壁 其一","author":"张问陶","text":"子规不作去年声，猿鸟都萦故国情。\n清浊泉流如有意，高低山色总无名。\n人从虎豹丛中健，天在峰峦缺处明。\n一笑云林归便得，向来烟景又谁争。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41879,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"煎茶坪题壁 其二","author":"张问陶","text":"棕榈高下一重重，百尺天梯仗短筇。\n急瀑飞声争大壑，断云作势补奇峰。\n红毡隐约骡纲细，黑箐深沉豹雾浓。\n何处钟鱼响林未，欲从灵界问仙踪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41880,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登煎茶岭绝顶云中遇雨 其一","author":"张问陶","text":"云外疑无雨，肩舆出万山。\n那知披叆叇，犹自听潺湲。\n衣冷龙腥逼，梯危石骨顽。\n风雷不惊客，浩荡起眉间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41881,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登煎茶岭绝顶云中遇雨 其二","author":"张问陶","text":"客路绕鸿濛，真疑帝座通。\n乱云皆足下，急雨自空中。\n古戍龙烟黑，蛮花傍岭红。\n黄牛何处驿，翻恨不途穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41882,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"河桥","author":"张问陶","text":"林壑簇天半，鸟路青濛濛。\n冒雨望绝顶，开翼愁飞鸿。\n一峰入云去，灵怪安可穷。\n缘梯追俊鹄，岈然如出笼。\n不惊奇险失，忽讶桃源通。\n山桥隔浓柳，雁齿参差红。\n人牛卧大石，高树为之宫。\n桑麻乐世外，鸡犬鸣空中。\n烟霞随地足，胡为随转篷。\n以骨誓青山，不隐非英雄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41883,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"五月二十七日入栈值余生日戏作二律邀亥白兄及吕湘帆和 其一","author":"张问陶","text":"久客频惊岁月驰，身宫磨蝎独难移。\n那堪马齿加增日，刚及蚕丛试险时。\n举酒翻疑三岛近，读书未恨十年迟。\n从今细蜡游山屐，五岳全登不告疲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41884,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"五月二十七日入栈值余生日戏作二律邀亥白兄及吕湘帆和 其二","author":"张问陶","text":"万壑千岩照眼新，崎岖难尽百年身。\n亲朋一意还家早，殽核他乡入馔贫。\n陟险亦能添甲子，卫生何用守庚申。\n世间只有名山寿，苦论彭殇可笑人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41885,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨后发黄牛堡","author":"张问陶","text":"夜雨汇众壑，溪涧吞江淮。\n怒涛奔西南，绕足争喧豗。\n喷沫漱奇石，宛然艳滪堆。\n山腰俯危栈，白日腾风雷。\n彷佛瞿塘游，孤舟落大洄。\n年时饱艰险，蛟螭狼与豺。\n片帆峡底出，一骑云中来。\n所遇无坦途，那得心颜开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41886,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"长桥至草凉驿即目","author":"张问陶","text":"万木支危栏，参差出山腹。\n闯然怪石横，覆额俨如屋。\n林高谷鸟欢，草暗山魈伏。\n毡笠点微红，鬓丝湿寒绿。\n人生入图画，绝险亦奇福。\n胸膈来清虚，何须餍粱肉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41887,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"柳树湾西去一带山田","author":"张问陶","text":"新耕入乱峰，豺虎留不得。\n菽麦未全收，山田纷五色。\n老农贪地利，垂死竭筋力。\n登高呼亚旅，裹粮若游食。\n剪辟穷其巅，近天犹未息。\n朝来雨膏足，播种任滋殖。\n阡陌小区分，居然成典则。\n倦归卧茅屋，仰视开胸臆。\n旧日眼中山，相看那复识。\n冈陵自嘲笑，怀宝招残贼。\n面目全失真，徒劳金翠饰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41888,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"凤县豆积山崖上有张果祠","author":"张问陶","text":"山骨累层阶，破碎各盈尺。\n界断众峰青，丹赭纷然积。\n巍峨敞画屏，俯瞰嘉陵白。\n半崖簇楼观，知是仙灵宅。\n孤根戴短亭，杰阁逗危石。\n窗棂粲可数，照眼乱金碧。\n时有飞云来，亭亭如远客。\n美人爱淡妆，岂必弃芳泽。\n何年李将军，留此小斧劈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41889,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"凤县得妇书","author":"张问陶","text":"十样鸾笺百斛愁，拈毫涴泪写蝇头。\n销魂犹怨春明柳，那识归人已凤州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41890,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登凤岭绝顶俯看云气同亥白兄作","author":"张问陶","text":"朝发凤州郭，浓阴蔽千里。\n陟岭攀危梯，渐入层云里。\n隔手瀰漫不辨人，肩舆飘渺凌虚起。\n炎炎五月惊隆冬，苦将俗骨追仙踪。\n拟从世外招黄鹄，只恐眉间过白龙。\n披云突出如披絮，碧空影净开清曙。\n高低转眼变隐晴，回首尘寰渺何处。\n人境迷离太不经，来时鸟路愁冥冥。\n剑铓争割柔难分，吁嗟束手穷五丁。\n林壑无根欲浮动，蓊然侧耳闻风霆。\n却似金焦南望海波涌，岛屿错杂微露尖山青。\n遥峰环拥满岩缺，欲覆神鳌气蓬勃。\n仄映晨晖四照清，一堆晴雪真明瑟。\n翻怜下界雷雨黑，妄指精灵疑出没。\n闭门犹耸电光圆，那识征人在天阙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41891,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"心红峡","author":"张问陶","text":"万绿拥孤峡，春归花自妍。\n日斜苔壁冷，云重石桥偏。\n一水净无暑，敷峰青可怜。\n蛮烟飞不到，合是此山川。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41892,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"紫柏山","author":"张问陶","text":"云笼紫柏山，烟树何濛濛。\n岩洞七十二，传是精灵宫。\n道人揖我前，指示誇神功。\n差堪悦狂瞽，那得聪者聋。\n造物无弃物，人事安可穷。\n谁谓龙鸾姿，甘为蟠蛰虫。\n世人畏速化，悲恋攒心胸。\n昧然去实境，苦向虚无攻。\n术尽身亦灭，一散随东风。\n焉知不死药，近植尘寰中。\n灵异或时有，庸鄙非所崇。\n淮南古叛王，鸡犬皆升空。\n岂兹冲妙名，蠢动胥能蒙。\n遥怜山谷民，世外留孤踪。\n足未入城府，老瘦方双瞳。\n修短纵少异，沈痼将无同。\n伟哉张子房，仙骨真英雄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41893,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"道院题壁","author":"张问陶","text":"春去花时误，天长客路迟。\n云山携不借，风雨叹将离。\n斋散钟鱼寂，林寒洞壑奇。\n结茅真可托，谁寄草堂资。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41894,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"留坝","author":"张问陶","text":"涧底黄茅屋，云间白版扉。\n田高冬水足，树冷夏虫稀。\n防虎弓当挽，惊人鸟乍飞。\n几时真辟谷，长与赤松归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41895,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"武关驿","author":"张问陶","text":"世治抉丸泥，苍苍陇树齐。\n阴崖迟见日，高岭乍闻鸡。\n鸟乱青羊水，山危白马氐。\n中原渺何处，梦落武关西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41896,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"焦岩","author":"张问陶","text":"大斧何年劈，山腰一径微。\n曲栏关命脉，片石逗危机。\n瘿俗霜髯丑，蛮江雪浪飞。\n堆盘汤饼热，旅食苦难肥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41897,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"武曲看褒水新涨","author":"张问陶","text":"一水排山勇，双崖束浪高。\n欲倾巴峡泪，如看广陵涛。\n笮马盘空瘦，神乌负日豪。\n云坳见孤艇，直想驾鲸鳌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41898,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将军石","author":"张问陶","text":"奔湍自豪放，绝壁苦羁束。\n盘涡出奇峰，岌岌苍龙角。\n世治氐羌平，西戎久臣伏。\n天河洗甲兵，兜鍪弃崖谷。\n锋铓纵呈露，灵秀居然独。\n无语立中流，他山不能学。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41899,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"七盘岭","author":"张问陶","text":"褒谷高于天，两崖互相啮。\n褒水犹飞龙，随山亦千折。\n攀藤遵蜿蜒，蛟螭出深窟。\n曲栏如层阶，羊肠上盘结。\n忽讶前旌迥，穿林旋隐没。\n人行蚁垤间，纤瘦动毛发。\n望之摇心魂，自顾气益夺。\n削壁孤根危，太古立积铁。\n累栈若附赘，欲踏疑溃决。\n侧首俯万仞，高林下蓊郁。\n惊涛自雷奔，但见涌微雪。\n时闻发樵响，缥缈在仙阙。\n效笑起云中，或是峰头鹘。\n雄关刺眼明，异境争狡黠。\n鸡帻昂然来，谁断神鳌骨。\n毫芒判生死，奇境真天设。\n矜慎乃全身，人谋胡可拙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41900,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"出褒谷","author":"张问陶","text":"七日陈仓路，真如秉烛行。\n连峰乍羁勒，一径忽通明。\n鸟下氐羌阔，山开陇汉平。\n回头云树合，天半杜鹃声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41901,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"褒城阻雨","author":"张问陶","text":"出谷宜长驱，轩然豁眉宇。\n卧闻檐溜鸣，忽作萧萧雨。\n草泥拥山郭，凄寂断行旅。\n知自沓中来，同云尽何许。\n羁栖念乡井，静默对俦侣。\n邻叟夜初归，隔墙闻笑语。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41902,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"褒沔道中 其一","author":"张问陶","text":"客路明初霁，风烟入望平。\n人居新铎水，天幻小蓉城。\n眠食他乡事，桑麻故国情。\n伞山如可买，叱犊便归耕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41903,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"褒沔道中 其二","author":"张问陶","text":"舟下襄樊北，山围汉沔东。\n依依双岸柳，漠漠一帆风。\n小市林檎碧，新渠水稻红。\n旧游如昨梦，彷佛近湘中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41904,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"沔县谒武侯祠","author":"张问陶","text":"莫援残局叹三分，正朔居然补帝勋。\n一笑西陵荒草合，墓门谁写汉将军。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41905,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"武侯石琴同亥白作","author":"张问陶","text":"石骨含宫商，椅桐不能仿。\n名士真英雄，人琴尽无两。\n凉风生殿阁，千载留孤赏。\n弦外知音难，渊然众山响。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41906,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"百牢关至青羊驿杂咏 其一","author":"张问陶","text":"征马踏黄泥，力尽不能努。\n闲云畏出山，止作此山雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41907,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"百牢关至青羊驿杂咏 其二","author":"张问陶","text":"一水自潺湲，众山争合沓。\n孤艇破烟来，天然小巫峡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41908,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"百牢关至青羊驿杂咏 其三","author":"张问陶","text":"豺虎穿林乐，蛟龙带雨豪。\n树腾寒雾去，云拟断山高。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41909,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"百牢关至青羊驿杂咏 其四","author":"张问陶","text":"云气失四山，空明如积水。\n亦知峰万重，且作平原喜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41910,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"大安驿","author":"张问陶","text":"地敞三泉县，群峰绕画屏。\n烟浮樵爨白，雨止稻畦青。\n树色笼潭毒，溪声走鳖灵。\n壮怀谁可说，举酒酹山庭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41911,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"大安阻雨","author":"张问陶","text":"雨气千山黑，溪流一夕黄。\n关河人慄慄，灯火昼茫茫。\n淫潦成风俗，蛟鼍不遁藏。\n生涯真濩落，愁对武都羌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41912,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送吕湘帆之龙安","author":"张问陶","text":"僰道巉岩来壑颓，龙门西望乱云堆。\n太平久撤松桃戍，惟让书生跨马来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41913,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"栈中怀王椒畦学浩","author":"张问陶","text":"王郎袖得神仙笔，幻出云山风雨疾。\n雄奇淡远无不宜，肯学倪黄拘一律。\n春前相遇汝南第，为我殷勤为墨戏。\n仰家扇子小湘纹，歘见冈峦叠苍翠。\n图成下笔添菰芦，翛然令我思江湖。\n秦关乍启见归客，燕市重寻失酒徒。\n峨峨蜀道青天上，凿来鬼斧何横放。\n人马蟠空返照浓，世间无此好屏幛。\n鸟路萦纡通杳冥，红毡裹背笠子青。\n垂岩破碎嵌云气，长峰排宕磨天星。\n子规叫雨猿昼吟，侧身西望开烦襟。\n陈仓剑阁环抱一千里，一树一石皆足荣园林。\n安能缩归尺幅挂蓬荜，使得解衣高卧如登临。\n醉倚征骖屡回顾，马蹄笃速留难住。\n金碧鲜明赭墨残，看山尽是思君处。\n书剑飘摇绝可怜，层峦过眼随风烟。\n拈豪空忆李思训，并骑难邀吴道玄。\n何时两袖携云栈，请君重为开生面。\n颟顸莫仿大同殿，要留曲磴微通线，依稀著我丹崖畔。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":41914,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]