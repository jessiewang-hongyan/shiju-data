[{"title":"醉花阴  吴淞道中重九","author":"文廷式","text":"雨入寒潮愁思悄。\n客里重阳早。\n消息误黄花，采采江篱，终不盈襟抱。\n空濛草树吴江道。\n也觉秋阴好。\n去路忽沈吟，一舸飘然，可信鸱夷老。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2431,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇  戊戌重九，是日霜降","author":"文廷式","text":"青女司霜，无风无雨过重九。\n无人送酒。\n看月呼田叟。\n临水登山，此恨年年有。\n君知否。\n羲皇去久。\n更在陶潜后。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2432,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行  为人题照","author":"文廷式","text":"淡淡修眉，盈盈润脸。\n无言恰似筵前见。\n花房肯酿蜜脾浓，春衫尚惜檀痕染。\n月幌休灯，风廊却扇。\n画屏十幅鲛绡展。\n雁声孤馆醉醒时，一场愁绪思量遍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2433,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"菩萨蛮","author":"文廷式","text":"帘波轻漾屏山悄。\n锦衾梦断闻啼鸟。\n此际觉春寒。\n绣罗衣恁单。\n幽兰凝露重。\n江远蘋花共。\n愁极夜如年。\n静看炉上烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2434,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"齐天乐","author":"文廷式","text":"芳塘水暖凫翁浴，初桐嫩遮窗窈。\n碧瓦云骞，香车露拂，人意不禁春娆。\n垂杨自袅。\n映千顷霞光，乱翻晴昊。\n可似前番，淡妆临水数枝袅。\n层阑倚空缥缈。\n凭高望不极，飞燕能到。\n屧径遗钿，旗亭解佩，何处荒烟残照。\n萧郎渐老。\n记不起当时，冷香怀抱。\n苦恨鹃声，劝侬归去好。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2435,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渔家傲  古意赠今人","author":"文廷式","text":"妾愿苧萝村下住。\n浣纱不共东家女。\n十顷荷花三里雾。\n迷归路。\n盈盈隔水谁能渡。\n不愿吴王宫里去。\n阳春一曲青春暮。\n人世繁华卿信否。\n浑无据。\n金床月落乌啼树。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2436,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行  为人题照","author":"文廷式","text":"舞蝶娇春，啼莺促曙。\n玉溪曾赋销魂句。\n嫦娥衣薄不禁寒，宓妃腰细才胜露。\n香印成灰，云緺剩缕。\n红笺好共盈盈语。\n落花难伴绮罗春，劝君休向阳台住。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2437,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"忆旧游  秋雁，庚子八月作","author":"文廷式","text":"恨霜飞榆塞，月冷枫江，万里凄清。\n无限凭高意，便数声长笛，难写深情。\n望极云罗缥渺，孤影几回惊。\n见龙虎台荒，凤凰楼迥，还感飘零。\n梳翎。\n自来去，叹市朝易改，风雨多经。\n天远无消息，问谁裁尺帛，寄与青冥。\n遥想横汾箫鼓，兰菊尚芳馨。\n又日落天寒，平沙列幕边马鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2438,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"临江仙  金陵忆别","author":"文廷式","text":"檀板声停箫吹咽，玉骢门外频嘶。\n背人无语敛双眉。\n别离情绪，撩乱万千丝。\n不道天河能间阻，此心桃叶应知。\n临明一阵雨霏霏。\n泪沾红袖，江上早寒时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2439,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虞美人","author":"文廷式","text":"鹭冠敧侧蛮腰袅。\n偎就郎怀抱。\n阿侬衣薄晓寒欺。\n凭仗些儿酒力、自禁持。\n馀香染袖人何在。\n梦隔珊瑚海。\n琵琶湖畔水涵空。\n祇有寒梅敛恨、向东风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2440,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"满江红","author":"文廷式","text":"雨挹轻尘，山槛外、春痕初绿。\n频怅望、方空一抹，弄箫人独。\n花影任教如意舞，莺声已是将离曲。\n算只有、落絮与游丝，飞相逐。\n簪素柰，歌黄竹。\n年渐老，欢难足。\n试开箱捡取，石榴裙幅。\n归梦不知天近远，清愁乍满江南北。\n问此际、僝僽为何人，眉峰蹙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2441,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"清平乐  巴陵有二乔墓，殆不足据，喜其亭槛轩朗，草树幽秀，聊为题之","author":"文廷式","text":"佩环声杳。\n日暮巴陵道。\n眉样君山青未了。\n一例湘娥缥缈。\n当年夫婿英雄。\n而今荒草吴宫。\n休问香魂在否，年年点缀春风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2442,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"卜算子  新柳","author":"文廷式","text":"雪意化春云，池水生新皱。\n一样眉痕两样描，月影初三瘦。\n莫到短长亭，未是愁时候。\n惆怅黄莺抵死催，春思浓如酒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2443,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒金门","author":"文廷式","text":"秋未老。\n树树斜阳都好。\n霞锦云罗黏远草。\n碧天开画稿。\n别后许多怀抱。\n又是黄花开了。\n落叶西风人悄悄。\n雁回书不到。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2444,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"念奴娇  旅思","author":"文廷式","text":"杜鹃啼后，问江花江草，有情何极。\n曾是灯前通一笑，浅鬓轻笼蝉翼。\n掩抑持觞，轻盈试剪，此意难忘得。\n如丝如絮，东风吹去无力。\n因念久客天涯，端居多感，萧瑟青芜国。\n怀抱向人何处尽，卧听林风悽寂。\n经卷楞严，琴声贺若，静玩炉烟直。\n微寒陨蕊，瑶华追溯堪惜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2445,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"摊破浣溪沙","author":"文廷式","text":"竹粉黏青露点衣。\n柳绵吹白水平池。\n为报游人休草草，惜芳时。\n临镜祇应江月照，搴帷莫使楚云疑。\n不道平生惆怅意，有人知。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2446,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"念奴娇","author":"文廷式","text":"江湖岁晚，正少陵忧思，两鬓斑白。\n谁向水晶帘子下，买笑千金轻掷。\n悽诉鹍弦，豪斟玉斝，黛掩伤心色。\n更持红烛，赏花聊永今夕。\n闻说太液波翻，旧时驰道，一片青青麦。\n翠羽明珰漂泊尽，何况落红狼籍。\n传写师师，诗题好好，付与情人惜。\n老夫无语，卧看月下寒碧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2447,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"点绛唇","author":"文廷式","text":"水际春回，曲阑环合庭阴翠。\n縠纹波细。\n石罅看鱼戏。\n宛宛韶光，著处偎人腻。\n春知未。\n青芜满地。\n易惹天涯思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2448,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉漏迟  辛丑七夕","author":"文廷式","text":"懒寻天上巧，夜阑愁对，碧窗秋悄。\n细数更筹，重忆旧时怀抱。\n多少人间别恨，浑不解、金风来早。\n灵约杳。\n一痕淡月，笼云凄照。\n羡他碧汉无波，便万岁千秋，后期难了。\n自轸琴心，漫托綵鸾同调。\n一晌梦游处，恰又似、浮槎仙岛。\n人易老。\n南楼几番清啸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2449,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"思佳客  古意","author":"文廷式","text":"十幅湘帘窣地垂。\n千株杨柳曲尘丝。\n玉人手把菱花照，绝代红颜欲赠谁。\n花子薄，翠颦低。\n轻纱吉了称身宜。\n苧萝女伴如相问，莫道侬家旧住西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2450,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"感皇恩  中秋","author":"文廷式","text":"梧叶碎秋光，小窗眠醒。\n自理琴书碧天静。\n文园病减，尚怯西风清劲。\n秘瓷聊试水、煎春茗。\n故人何在，曲阑空凭。\n料损多情旧心性。\n冰奁愁展，今夜月明如镜。\n断肠枫落也、吴江冷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2451,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"疏影  秦淮有所赠","author":"文廷式","text":"凉蝉陨叶。\n正碧波渺渺，秋在城堞。\n酒所凄凉，相唤移船，华灯掩映佳侠。\n宜城放客多愁思，写不尽、琴心三叠。\n数合欢、制就齐纨，谁料未秋先箧。\n坐对江湖兴沓。\n便当自此去，同理舟楫。\n却恨青铜，华发星星，那称绛唇丹靥。\n从渠自向空王忏，恰难忘、散花香裛。\n甚四弦、解诉飘零，歌畔泪珠盈睫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2452,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南乡子  病中戏笔","author":"文廷式","text":"一室病维摩。\n且喜閒庭掩雀罗。\n煮药翻书深有味，呵呵。\n老子无愁世则那。\n莽莽旧山河。\n谁向新亭泪点多。\n惟有鹧鸪声解道，哥哥。\n行不得时可奈何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2453,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日","author":"金至元","text":"午窗寂历听啼莺，淡沱春光画不成。\n坐拥熏炉寒尚峭，旋移花垡雨初晴。\n钩帘乳燕多寻垒，隔巷吹箫已卖饧。\n忽见侍儿来插柳，始知节物近清明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2454,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"朝来","author":"金至元","text":"朝来几点雨催花，饯取微香入谢家。\n未到荼蘼春尚在，却闻杜宇意先嗟。\n闲临禊贴红丝砚，暂试名瓷绿雪芽。\n天气渐长人渐困，琐窗梦转树阴斜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2455,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"古意","author":"金至元","text":"倚薰笼子倦绣，日迟迟子春昼。\n步庭阴子延伫，折花枝子独嗅。\n莺百啭兮将阑，柳飞花子欲残。\n恨流光子难绾，掩罗袖子汍澜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2456,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过草亭作","author":"金至元","text":"屈曲草亭入，萧疏远市哗。\n画栏斜抱石，翠幌薄笼纱。\n境僻蜗黏壁，林香蜂报衙。\n此间尘事少，一卷诵楞伽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2457,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春尽日","author":"金至元","text":"九十春光剧可怜，难追羲辔夕阳边。\n桃花不识东风换，犹弄妖红几朵妍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2458,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"重过郊外园林","author":"金至元","text":"一番雨过酿轻寒，七月南塘水半竿。\n最是重来好风景，秋光如染隔林看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2459,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"弹琴","author":"金至元","text":"拟将幽意寄金嶶，拂干无言送落晖。\n我有千愁弹未尽，一声新雁碧天归。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2460,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜坐","author":"金至元","text":"夜阑人独坐，帘外露潺潺。\n静爱鸣蛩细，凉宜摊卷看。\n水沉留篆久，兰烬受风残。\n虬箭城头转，罗衣怯薄寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2461,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨中感怀","author":"金至元","text":"门外凉飙猎雨声，凄凄摵摵梦难成。\n遥思北寺青灯里，词夕何堪泪独倾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2462,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"问雁","author":"金至元","text":"借问天边雁，关程千里馀。\n来时经帝里，可有寄侬书。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2463,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"庭花","author":"金至元","text":"满径苔痕清昼长，枝枝叶叶斗幽芳。\n嫣红姹紫知何限，争似疏梅浅淡妆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2464,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闻燕语有作","author":"金至元","text":"十眉图懒试新妆，画阁无人黯自伤。\n不卷重帘留燕子，呢呢学语听雕梁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2465,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"初夏","author":"金至元","text":"柳叶毵毵覆屋低，绿阴初满小轩西。\n沿阶碧草茸茸长，坐树黄鹂恰恰啼。\n须识人生皆有定，自来物理本难齐。\n红闺久诵班姬赋，未敢拈毫著意题。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2466,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"礼斗","author":"金至元","text":"玉台拂拭理残妆，忍照菱花翠黛长。\n夜静星坛私祝罢，一炉香引泪千行。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2467,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"催妆诗次韵","author":"金至元","text":"句好如仙绝点尘，青莲原是谪来身。\n诗传彩扇歌偕老，籍记丹台署侍晨。\n四照花开融瑞色，九徵灯飐缔良因。\n牵萝补屋休嫌陋，浔贮珠玑敢道贫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2468,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜话和莲坡主人韵","author":"金至元","text":"人生大抵游仙枕，已出邯郸君莫疑。\n世事浮云无定著，流光劫火漫寻思。\n试香午院宜煎茗，斗墨晴窗好赋诗。\n终卧牛衣吾不悔，只凭清课惬心期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2469,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题花影庵诗集","author":"金至元","text":"清词丽句难为比，愁似秋猿巴峡啼。\n多谢十年相忆苦，口衔石阙寄无题。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2470,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自述","author":"金至元","text":"方期椎髻共林泉，鹤闭鸾拘痛九年。\n刘氏酒逾千日醉，姮神光负百回圆。\n今朝写翠欣开镜，往事愁红记拂弦。\n从此幽栖差可慰，不须缄恨再笺天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2471,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偶成","author":"金至元","text":"愔愔庭馆不飞花，如幕垂杨一桁遮。\n自是今年春较晚，红阑才茁牡丹芽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2472,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"中秋坐月","author":"金至元","text":"人间天上分盈缺，每负冰轮著意明。\n此夕团圆人共月，只愁云影掩三更。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2473,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜坐寄莲坡主人，时客都下","author":"金至元","text":"潇潇细雨暗阶除，坐倚屏山慵检书。\n如豆一灯明欲灭，最伤怀是别离初。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2474,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"水仙花","author":"金至元","text":"凌波微步当风立，似向芝田馆里来。\n堪与梅花竞标格，冲寒也向雪中开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2475,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登岳麓山呈笠云长老","author":"释敬安","text":"欲觅三乘法，来参一指禅。\n人天开觉路，衣钵得真传。\n水到源头活，山从雨后妍。\n拈花曾示我，微笑證前缘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2476,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题笠公禅房","author":"释敬安","text":"阶下绿痕绿，庭前草色青。\n禅心自清静，世事付苍冥。\n入定猿知护，谈经鹤解听。\n蒲团人坐久，问法欲忘形。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2477,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"偶作","author":"释敬安","text":"长啸返林壑，息心了无求。\n盈虚有真宰，得失忘喜忧。\n怀此得真趣，因之绝世游。\n烟霞最深处，麋鹿皆吾俦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2478,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"途中述怀","author":"释敬安","text":"一瓶一钵暮山过，戴月孤身入薜萝。\n觉路未开归路近，芒鞋空踏白云多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2479,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送海风上人行脚","author":"释敬安","text":"南询从此始，烟水浩漫漫。\n一钵飘然去，千山次弟看。\n江云春树碧，海月夜钟寒。\n处处随缘住，无求梦亦安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2480,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暮春偶感","author":"释敬安","text":"细雨孤窗冷，闲吟感暮春。\n落花飞献佛，野鸟欲亲人。\n世外诗情淡，山中道味真。\n此心如暮石，何处著些尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2481,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游金山江天寺","author":"释敬安","text":"久慕江天寺，今朝锡此临。\n山常浮镜面，翠欲滴波心。\n龙窟依禅窟，潮音杂梵音。\n高僧行道处，不受一尘侵。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2482,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"出定吟","author":"释敬安","text":"禅宫寂寂白云封，枯坐蒲团万虑空。\n定起不知天已暮，忽惊身在月明中。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2483,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"元妙上人从南岳来以雪樵禅有题福严丈室之作示馀因次韵","author":"释敬安","text":"明月清风一杖担，现成公案不须参。\n目前万法惟心法，何用逢人觅指南。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2484,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山居二首 其一","author":"释敬安","text":"古洞云深别有天，偶携僧侣此安禅。\n数椽茅屋牵萝补，一枕寒松伴鹤眠。\n习定每从岩腹内，生涯尽在钁头边。\n山居寂寞无烦恼，火种刀耕效昔贤。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2485,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山居二首 其二","author":"释敬安","text":"一住深山便学呆，通身有口也难开。\n著衣吃饭成多事，啸月吟风自少才。\n扫地每嫌黄叶落，闭门常怕白云来。\n惟将小境勤磨拭，不肯轻轻受点埃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2486,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答柳溪居士","author":"释敬安","text":"何必山巅与水涯，安心随处便为家。\n有人问我西来意，笑指长天落晚霞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2487,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题天台十甲子老僧坐禅处","author":"释敬安","text":"万木森寒入翠微，飘然鹤发久忘机。\n溪声毕竟无今古，山色何曾有是非。\n涧草自迷游客屐，岩花时落坐禅衣。\n问师何代天台住，手种青松已十围。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2488,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答鲁封居士问天台次韵","author":"释敬安","text":"山家日日饭胡麻，此事寻常不欲誇。\n惟有道人风味别，每从峰顶嚼红霞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2489,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"住山吟 为与了上人作","author":"释敬安","text":"结庐人境外，终日掩柴关。\n法侣檐前树，禅心雨后山。\n种松期鹤宿，扫石待云还。\n寂寞幽栖子，忘机与物闲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2490,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"薄暮偕瘦松龙山散步","author":"释敬安","text":"兴来驱我去，薄暮入云深。\n流水半江月，松风万壑琴。\n归渔喧渡口，晚磬出疏林。\n与子一为乐，弥生清净心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2491,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山中漫兴","author":"释敬安","text":"酷爱翠微间，风光分外闲。\n红泥肥紫芋，白石瘦青山。\n流水落花去，夕阳飞鸟还。\n终年无客到，寂寞掩柴关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2492,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游岳阳楼","author":"释敬安","text":"危楼百尺临江渚，多少游人去不回。\n今日扁舟谁更上，洞庭波送一僧来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2493,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送春","author":"释敬安","text":"一枕烟霞睡味赊，不知春去野人家。\n数声啼鸟幽窗外，惊起山僧扫落花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2494,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登湘阴神鼎山","author":"释敬安","text":"层峦叠嶂碧摩空，引我登临思不穷。\n三径黄花疏雨外，一林红叶淡烟中。\n云封古洞无僧住，翠锁寒松有路通。\n踏破芒鞋游未遍，夕阳西下听鸣鸿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2495,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"山中绝粮","author":"释敬安","text":"十日山居九绝粮，拾些橼粒点饥肠。\n可怜清味无人识，分与牧童樵客尝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2496,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暮游玉泉寺","author":"释敬安","text":"夕阳林谷暝，众鸟亦知还。\n凉月一渠水，残云数点山。\n偶随寒磬入，欲共老僧闲。\n夜久群动息，轻烟澹碧鬟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":2497,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]