[{"title":"中宿峡","author":"高銮","text":"短艇惊涛里，阴森怆客魂。\n悬崖疑欲坠，逆溜势如奔。\n峡暝天无色，云深日易昏。\n从来多险地，何止说龙门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11712,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"陪禊亭夫子登镇海楼即事次支亭韵","author":"高銮","text":"黯黯离愁已数秋，相逢岭表复陪游。\n时当美景思豪饮，人在他乡爱倚楼。\n海燕来时天正好，沙鸥飞处雨初收。\n黄橙紫蟹聊堪醉，作赋应题最上头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11713,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送贡三弟北还","author":"高銮","text":"草绿珠江上，青青柳万枝。\n那堪愁病日，又值别离时。\n雨气生遥浦，花香入酒卮。\n赠君乏长物，珍重数篇诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11714,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜起","author":"高銮","text":"客榻生寒梦屡惊，披衣起坐度残更。\n朦朦星月僧窗下，听尽天街走马声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11715,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"河间晚宿","author":"高銮","text":"客子停车已二更，照愁孤月迥临城。\n漫言此夜凄情甚，才是离家第一程。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11716,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梦","author":"富宁","text":"短梦无伦次，更长几度生。\n觉来成阅历，记去偶分明。\n自审何时是，人言此日情。\n破愁兼断酒，心地或澄清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11717,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"移居盘山 其一","author":"永宁","text":"卜宅依山麓，从容亦苟完。\n编篱三径曲，凿牖一天宽。\n鼓腹煨鸱芋，章身制鹖冠。\n举家清且健，随在可盘桓。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11718,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"移居盘山 其二","author":"永宁","text":"安卧惭高士，恒饥泣小儿。\n牵衣嗔宴起，索食问朝炊。\n语涩翻成笑，情閒且赋诗。\n南山一顷豆，悔不及耕时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11719,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"病中怀常月上人","author":"明德","text":"路隔城南烟树苍，满天风雪隐斜阳。\n年衰自叹匏长系，病久翻疑药不良。\n安得逢人忘我相，每因看月觉云忙。\n虎溪别后东林远，清梦时教到上方。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11720,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晚出西郭口号","author":"何贯曾","text":"风尘冉冉策青骊，草际凉风感鬓丝。\n绿水数湾通獬豸，碧城一带守熊罴。\n傍河野艇分沙嘴，落日寒蝉抱柳枝。\n司马赋成尊酒尽，凌云缥渺是何时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11721,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"九日重过八宝山感旧","author":"额勒洪","text":"昔年红叶里，扶病放歌回。\n今日黄花下，支筇载酒来。\n诗仍留败壁，人已去丹台。\n惆怅疏林晚，秋空一雁哀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11722,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登万寿阁望华岳","author":"额勒洪","text":"华岳临高阁，凭栏翠霭重。\n千峰团落雁，一瀑锁苍龙。\n隐约希夷峡，有无毛女松。\n未能登绝顶，惆怅此游踪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11723,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"五里关","author":"张彦琦","text":"路随流水自东西，乱踏寒沙入翠微。\n回首已登入境外，天风萧瑟薄征衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11724,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游云龙山","author":"张彦珍","text":"鹤去亭空在，何人赋小山。\n断碑秋藓没，古寺乱峰环。\n樵唱穿云过，渔镫背月还。\n萧萧木叶下，身坐画图间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11725,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"甘露寺","author":"冒椿","text":"古寺危城外，高冈大海滨。\n塔攒千叠翠，楼纳一江春。\n钟磬声犹昔，孙刘迹已陈。\n废兴怀往事，闲话共樵人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11726,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"客归","author":"冒国柱","text":"柴门侵晓噪林鸦，行李萧萧正到家。\n娇女不知须鬓改，误将衫袖拂霜华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11727,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"支公禅院","author":"谢淞洲","text":"鸟道洑鸣雷，古寺转高木。\n白云淡无人，清风在修竹。\n爱此山翠光，欲滴幽人屋。\n野客闻鹤鸣，山僧报茶熟。\n愿逐支公侣，常傍泉声宿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11728,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"田家杂兴二首 其一","author":"谢淞洲","text":"深村犬迎吠，曙色行者稀。\n归人自城市，负荷返柴扉。\n耒耜颇整理，蓑笠亦庶几。\n朝来拨春陇，泉脉流微微。\n菖蒲亦已生，屋角梨花飞。\n物候有如此，东作慎无违。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11729,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"田家杂兴二首 其二","author":"谢淞洲","text":"晓色起陇亩，荷耜还西林。\n悠悠清溪水，自识沮溺心。\n林际半新月，村静闻远音。\n何人柴门下，慷慨隆中吟。\n未知千载事，好风开我襟。\n忽持一尊酒，苍然白云深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11730,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过惠山寺","author":"谢淞洲","text":"路转弓河三里赊，好风犹趁半帆斜。\n莺声满店二泉酒，春雨维舟一树花。\n白发来游嗟已晚，青山如画欲移家。\n几时来傍禅镫宿，惠麓云中汲井华。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11731,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天生桥","author":"高炳","text":"两崖临绝涧，微径垂一缕。\n中间横巨石，足可容百堵。\n凿空非人力，枝撑自太古。\n奔泉喷雪下，轰若雷霆怒。\n长天惨白日，六月失炎暑。\n平生轻波涛，三峡未足数。\n中流挥羽扇，啸咏狎飞?。\n迨兹翻凛然，顿觉毛发竖。\n勇怯亦何常，择地自可贾。\n因思昆阳捷，千载称光武。\n却笑李将军，徒夸射猛虎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11732,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"巴河登览","author":"高炳","text":"绿云去已缅，憩石复孤往。\n忽逢坡路转，始见墟烟上。\n一犬吠花阴，数翁灌蔬壤。\n问途俱未答，松下自偃仰。\n落日起离思，飞泉送秋响。\n踟蹰西涧断，隔水听归桨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11733,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"维扬送汪东在之汉上","author":"高炳","text":"海门回首白云封，飘瞥烟峦几万重。\n山到小孤都划断，江当大别更相逢。\n珠宫北上倾三岛，铜鼓南来震九峰。\n却笑乘槎推博望，祇携身毒一枝筇。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11734,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望庐山","author":"高炳","text":"庐山出青天，众山揖平地。\n风吹香炉烟，散作九江翠。\n我行到江口，遥指山外湖。\n江水忽如线，青天半日无。\n飞帆掣流流不极，千里犹将见山色。\n此中宜有谪仙人，欲往从之不可得。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11735,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"七月之望游皇藏峪露坐林间","author":"张志勤","text":"昔年曾过此，蹊径尚依然。\n久住应忘世，重来别见天。\n卧游思枕簟，洗耳爱山泉。\n夜月凉如水，清光独自閒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11736,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雪夜留巨上人宿时甫里李允恭亦在草堂分赋得春字","author":"盛钰","text":"严风动林外，微雪洒溪滨。\n值此清夜水，幸与群贤亲。\n焚香留释子，开尊洽故人。\n饥鸟度残腊，冻梅含早春。\n破扉寒更掩，镫光淡如银。\n幽寂同所归，忽忽忘世尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11737,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨花 其一","author":"盛钰","text":"清明才过翠眉低，竟日悠扬路不迷。\n舞蝶偶同游绮陌，飞花常伴葬香泥。\n风回水槛飘难定，雨压山桥落更齐。\n羌笛倦吹春已老，离人愁听子规啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11738,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨花 其二","author":"盛钰","text":"陶令门前寄此生，乱飘时节任纵横。\n略经微雨全无影，才著春波便定情。\n远岸草青同漠漠，隔林花艳自盈盈。\n《阳关》唱罢凭谁引，好倩东风到渭城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11739,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"抵京口","author":"杨磊","text":"欲去难言去，来归未得归。\n暂停江上棹，一采故山薇。\n霜露高堂冷，松楸墓木非。\n临行叹游子，梦里想春晖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11740,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春游口号 其一","author":"杨磊","text":"支硎山头云欲平，桃花李花相间明。\n放舟出郭本无意，带雨看山亦有情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11741,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春游口号 其二","author":"杨磊","text":"千叠远山春未足，一堤新柳绿含烟。\n渔歌隐约沧浪里，转过桃花不见船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11742,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"依韵和朱性之忆南山亭旧游","author":"方浩","text":"扪葛清游日，联吟暂喜同。\n山亭云护白，枫径屐黏红。\n度涧微泉响，窥岩暗穴通。\n听钟思往事，林壑几秋风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11743,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题花山玉泉寺","author":"邢芝","text":"山罅偏宜古刹填，重阴堂翳日行天。\n路从白鹤巢边下，径傍苍獒吠处穿。\n百折泉来经阁后，一泓池辟寺门前。\n乱云每向高崖合，不放钟声出树巅。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11744,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"月","author":"熊文泰","text":"云尽野烟灭，青空悬玉盘。\n影涵千丈静，光入五湖宽。\n远棹渔镫澹，高枝鸟梦寒。\n夜深秋更好，我与月同看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11745,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"焦山","author":"熊文泰","text":"江到海门尽，樵岩江上浮。\n苍松包古寺，清磬响中流。\n星月双峰冷，烟波四面秋。\n凌晨望初日，更上最高楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11746,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游山谷寺","author":"熊文泰","text":"志公停锡处，纵屐遍攀寻。\n白鹤有禅意，苍松无杂音。\n泉流山腹暗，云影井中深。\n閒憩石牛洞，泠泠弹素琴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11747,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"天门","author":"马一鸣","text":"金陵形胜地，端赖此天门。\n山势排云表，江流动石根。\n就崖因作寺，分水自成村。\n来往风帆泊，年年觅旧痕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11748,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湖州东郊晚眺","author":"马一鸣","text":"菰城宛在水中央，四面风烟淡夕阳。\n轧轧几家当户织，盈盈十亩拂溪桑。\n名高祠尚传苏子，事往人犹说项王。\n底事峰峦看不厌，白云深处似吾乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11749,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"舟夜","author":"马一鸣","text":"客枕寒难寐，愁来可奈何。\n全家隔云树，竟日泛烟波。\n人面霜风改，江头雪浪多。\n拥衾閒得句，聊尔自吟哦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11750,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过三静庵","author":"马蕃","text":"穷山别有径，开凿自何年。\n四面松云岭，一村烟水田。\n品茶尝谷雨，烹笋挹溪泉。\n到处苔茵绿，趺跏听杜鹃。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11751,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"暮归","author":"马蕃","text":"山云沈晚照，半醉别田家。\n度岭逢微雨，沿溪落野花。\n鸟声林际噪，烟影屋边斜。\n渐有丰年望，新秧处处蛙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11752,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"除夕前一日竹叶亭探梅","author":"马蕃","text":"抽身来胜地，索笑得闲行。\n岁晚日无几，花迟风有情。\n深杯宜腊酝，小雨送春声。\n未识西庄意，犹依五凤城。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11753,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怀家兄伯逢","author":"马蕃","text":"残梦初回后，孤镫未尽时。\n斯人不可见，中夜起相思。\n落木秋云暮，寒风客自知。\n离情谁共语，寂寞独吟诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11754,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自辽东回过鼍矶岛","author":"辛宜岷","text":"玲珑岩上石，幽隐岛中村。\n云起常遮屋，潮来直到门。\n凉蝉愕新响，野寺饱馀飧。\n回首辽天杳，衣沾血泪痕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11755,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蚕竖","author":"辛宜岷","text":"贫竖牵微利，身佣万绿间。\n移蚕晨剪叶，守茧夜号山。\n风雨宁辞倦，饥寒不自闲。\n辛勤两月后，分箔始开颜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11756,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"广陵送客","author":"辛宜岷","text":"蒲帆柔橹送君归，十月江南寒尚微。\n最是临风一杯酒，游人北去雁南飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11757,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过太公堂山麓","author":"曹曾衍","text":"衰草丛丛衬马蹄，崎岖一径接寒溪。\n秋从黄叶声中老，天向浮云尽处低。\n野水波明闲浴鹭，荒村日午静闻鸡。\n行人指点非熊庙，红树苍山乌鸣啼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11758,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题郭南浦田舍","author":"黄之芠","text":"幽人高卧稳，长日掩荆扉。\n一径开空阔，全家住翠微。\n须眉秋色老，禾黍晚香肥。\n为我藏尊酒，还来对夕晖。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11759,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜坐有感寄排山大兄","author":"朱棆","text":"思君晨夕浑难释，梦里欢娱觉后空。\n独饮小窗镫烬后，不眠终夜雨声中。\n青炊云壑堂前豆，碧洗柑园阁下桐。\n少壮依依形与影，残生回首乐何穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11760,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日偶成","author":"潘晓","text":"秋色清无际，山中引兴深。\n绿苔侵古径，红叶落疏林。\n有造得幽境，忘机生道心。\n天游还共适，野老暇追寻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11761,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"石桥村访王书存玉斧兄弟","author":"徐天祥","text":"细雨微飔沙路凉，伊人秋水宛中央。\n清溪带树围茅屋，野径披云到草堂。\n苔静每怜花自落，客来恰喜酒初尝。\n人间别有乌衣巷，风景依然太古乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11762,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"聂王墓","author":"王尽心","text":"墓门尽日锁烟萝，三尺残碑字半磨。\n帝子不来云欲暝，古槐风里乱蝉多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11763,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏怀 其一","author":"吕法曾","text":"南山有文豹，霖雨不下来。\n天马体容与，而终不自谋。\n女贞慕松柏，乃与岁寒期。\n高楼齐浮云，上有女伤悲。\n过时讵不字，淇梁非所宜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11764,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"咏怀 其二","author":"吕法曾","text":"梁鸿草野人，枯隐亦为拙。\n韩信一匹夫，富贵念何热。\n南阳有高士，可以称人杰。\n自比于管乐，实伊吕之埒。\n少小慕文儒，剑术破其迂。\n敢希成功后，辞爵返田庐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11765,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨夜怀友","author":"吕仰曾","text":"不断檐前雨，无聊酒自斟。\n故人千里隔，秋思一镫深。\n山果经风落，阶蛩入夜吟。\n天涯同独寐，凄绝此时心。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11766,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨阻风秀轩欲访堇浦不得却寄","author":"王豫","text":"汉上忆题襟，停桡欲过寻。\n江乡三日雨，孤客一年心。\n路暗无来梦，茶香耐苦吟。\n思君情似水，翻比在家深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11767,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登石佛山","author":"梁浚","text":"偶来初地倚危楼，风景萧条望里收。\n寒雁下时秋草没，晚钟开处岭云稠。\n千章古柏依山矗，一带汾河尽日流。\n到此已能空色相，不须更上最高头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11768,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游绵山途中作","author":"梁浚","text":"策蹇寻名山，翘首望空翠。\n峰峦势嵯峨，迢迢远难致。\n迤逦缘溪行，逼仄常恐坠。\n众鸟多幽声，群木饶古意。\n午鸡鸣荒村，远磬闻山寺。\n旷野景既殊，境幽人亦异。\n未及事登临，吾心亦已遂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11769,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"黄田驿","author":"张轼","text":"早起黄田驿，家乡路尚遥。\n客船穿石眼，秋露湿山腰。\n滩险波平岸，村深柳隔桥。\n不知高阁上，清管为谁调。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11770,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"早发兰溪经石塘横宿东馆 其一","author":"蔡维熊","text":"山城挝鼓绝，曙光犹朦胧。\n明河淡遥影，稀星耿晨风。\n榜人催早发，解缆何匆匆。\n我亦披衣起，爽籁生群峰。\n相对悄无言，冥冥羡飞鸿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11771,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"早发兰溪经石塘横宿东馆 其二","author":"蔡维熊","text":"清声发鸟哢，澄影散林樾。\n烟鬟对镜开，渔艇依村歇。\n安得百尺竿，俯钓鳌龙窟。\n石塘石更奇，森森如执笏。\n横绝波涛中，起伏留凹凸。\n扼要势益险，舟行俨冲突。\n审视仗篙师，幸勿中途蹶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11772,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"御赐砥石砚歌赠石庭上人","author":"沈堡","text":"道人昔岁游京邸，天子召见离宫里。\n赋就《初春瑞雪词》，侍臣奏上龙颜喜。\n拂衣归卧高云中，仍向空山食松饵。\n万乘南巡明圣湖，遂朝行在登丹戺。\n临轩玉音何琅琅，赐来砥石砚一方。\n绿质无玼浮玉色，翠纹结秀生瑶光。\n我闻此石出辽水，水碧为胎金作髓。\n温润无殊歙穴青，坚良且迈端溪紫。\n只今圣主重文章，珍物通灵皆异常。\n已见马肝贡殊域，尤多凤味罗岩廓。\n皇情祇眷此砚美，掞藻时时凭玉几。\n拜爵应封即墨侯，锡名且号虚中子。\n石公捧砚辞京师，好磨松节临清池。\n奈园秘笈日勤写，颂扬帝德高巍巍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11773,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋闺怨","author":"沈堡","text":"夜夜劳刀尺，年年寄雪霜。\n云沈蒲类海，月落郁金堂。\n汉将思开国，秦皇重辟疆。\n何知儿女恨，掩镜泣空房。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11774,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"化成庵","author":"徐维城","text":"放舟渺入水云乡，曲径通幽草木香。\n古树摩空凝暮霭，奇花舞景媚初阳。\n目无嚣俗来禅境，应有烟霞贮客囊。\n瓶钵随缘聊可托，不辞信宿此山房。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11775,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"峨嵋庵","author":"徐维城","text":"乍识峨嵋径，小桥溪半横。\n捎云千竹冷，供佛一镫清。\n菊圃荒春草，僧房起梵声。\n顿令心地静，我亦学无生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11776,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"城南泛舟归西园寓","author":"陈唐","text":"拂拂垂杨绿尚轻，溶溶新涨碧初平。\n雨从少伯祠前断，天在真如塔外晴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11777,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"初秋过问心庵访文澜大师","author":"陈唐","text":"闲寻尘外侣，共坐小亭幽。\n残暑金犹伏，高风木已秋。\n禅心清晚磬，远意极平畴。\n归路斜阳尽，娟娟月似钩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":11778,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]