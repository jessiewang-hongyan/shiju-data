[{"title":"秋蛩","author":"李学温","text":"晚风淅沥雁流初，促织微吟在壁隅。\n碎剪秋声无觅处，淡烟横草露如珠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26542,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题十美图 其一","author":"李学慎","text":"雕弓金羽学男儿，十载从戎百战归。\n错认昭阳陪幸者，辇前一笑堕双飞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26543,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题十美图 其二","author":"李学慎","text":"蕉簟清凉珊枕明，凉侵玉骨醉初醒。\n绿云一朵西风里，低衬仙裙上画屏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26544,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题十美图 其三","author":"李学慎","text":"绝世天姿出自然，碧苔阶畔晓风前。\n相看似欲盈盈下，石上三生证夙缘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26545,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题十美图 其四","author":"李学慎","text":"将飞未举态婵娟，谁识瑶台自在仙。\n见说汉皋虚解佩，流风回首怅长川。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26546,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题十美图 其五","author":"李学慎","text":"金屋群推绝代名，淡妆临镜转亭亭。\n化身却入丹青里，莫讶蛾眉斗尹邢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26547,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题十美图 其六","author":"李学慎","text":"自从辞辇掩长门，旧事凄凉不可论。\n团扇曾牵怀袖影，几回相对忆君恩。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26548,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题十美图 其七","author":"李学慎","text":"汉宫明月照边关，马上啼红去不还。\n非是琵琶解愁思，玉颜容易到天山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26549,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题十美图 其八","author":"李学慎","text":"东观书成帝用嘉，能将事业洗铅华。\n闺中韵事从头数，几个名姝号大家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26550,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题十美图 其九","author":"李学慎","text":"轻盈无迹踏青尘，十二金钗一可人。\n玉笛声中金谷晚，谁将小幅为传神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26551,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题十美图 其十","author":"李学慎","text":"霓裳妙舞对花丛，一曲山香扇底风。\n可是羊家张静婉，小垂手态似惊鸿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26552,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"西楼野望","author":"刘氏","text":"一片清秋色，西村八九家。\n渔人归去晚，沽酒入芦花。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26553,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜有怀姊氏","author":"金顺","text":"空闺闻落叶，天地入秋深。\n况乃中宵雨，因之远别心。\n漏长孤梦杳，江阔短书沈。\n忽听南征雁，离群感自今。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26554,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送南州姑氏回清溪","author":"金顺","text":"亦知非远别，转觉送君难。\n把盏心先醉，留题墨未乾。\n梦应劳寤寐，书望报平安。\n直为怜多病，临歧苦劝餐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26555,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题管夫人画竹","author":"金顺","text":"墨妙由来数仲姬，闺房静对写风枝。\n王孙若解凌霜节，合署鸥波老画师。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26556,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"缴奁","author":"杭温如","text":"纨绮营身物，簪珥饬容具。\n儿身无所托，纨绮安所附。\n儿容不复修，簪珥何所顾。\n空馀此妆奁，衣笥间藏注。\n饮泣奉高堂，留充嫁与娶。\n姑闻亦心伤，涕泣零如雨。\n含泪劝姑前，儿命安所遇。\n从今不出闼，钗荆与裙布。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26557,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"自伤","author":"杭温如","text":"木凋花易谢，凋谢各有时。\n胡为凋与谢，非时独当之。\n十三学刺纫，十五学吟诗。\n十七长成身，深闺人未知。\n忽闻父母命，许字他家儿。\n十九出绣阁，掩泣父母辞。\n登堂拜姑舅，妇道始从兹。\n妾本无所能，妾又何所奇。\n姑舅同欢悦，明珠掌上持。\n殷情劝阿郎，读书勿自欺。\n怀安名实败，奋志凤凰池。\n那知天夺算，一蹶不可医。\n十九廿一二，劳燕各分离。\n舅亦寻年殁，赖姑岁月迟。\n妾无奉姑孝，姑常为妾慈。\n一朝姑不顾，乘此茕独姿。\n吁嗟乎，妾死姑可在，姑死妾何资。\n不然相继死，姑妇常相随。\n窃比木与花，凋谢此其期。\n一何留妾身，受此无穷悲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26558,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梅花 其一","author":"周映清","text":"古梅生疏香，幽致邈难写。\n临风濯寒秀，相对足閒雅。\n琼姿妙天然，未许粉黛假。\n譬如歌阳春，曲高和者寡。\n开轩涵明月，顾影自潇洒。\n惟应翠袖人，亭亭伴林下。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26559,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梅花 其二","author":"周映清","text":"爱梅入骨随，思作梅花吟。\n横斜疏影句，谬许孤山林。\n拟议误唐突，粉蝶兼霜禽。\n竹外一枝好，坡老诚赏音。\n何如妙无言，淡然惬素心。\n不见江贯道，抚琴不弹琴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26560,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"梅花 其三","author":"周映清","text":"谓梅如宰相，调羹待异日。\n谓梅如高人，迥与枯槁别。\n谓梅如美女，不炫倾城色。\n谓梅如神仙，空羡罗浮蝶。\n鉴怀天地初，相像太始雪。\n此意明月知，可悟不可说。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26561,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登岘山","author":"周映清","text":"湖光山翠绕城来，白塔红亭罨画开。\n松竹径深僧院敞，菰蒲水浅酒船回。\n残碑谁访题襟集，断石难呼乐圣杯。\n亦有登临无限意，何如太傅远兴哀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26562,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"王石谷山水","author":"周映清","text":"清泉百丈飞幽壑，茅屋人家隔丛薄。\n白云在水树在空，漠漠晴烟下寥廓。\n断鸿几点去无迹，黄叶一林寒欲落。\n斜阳何处认前村，隐见危桥傍山郭。\n先生画笔冠当代，八尺生绡气磅礴。\n不须平远袭倪黄，能以清空见镵削。\n秋窗对此足清胜，瑟瑟轻寒生绣箔。\n掩图不敢挂虚堂，恐有红尘一分著。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26563,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"琴诗 其一","author":"周映清","text":"少小慕古韵，耽此丝桐清。\n经年事擽捋，指涩不成声。\n一朝得微悟，触手清风生。\n泠泠判雅俗，一一为分明。\n贺若不可学，益我思古情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26564,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"琴诗 其二","author":"周映清","text":"审弦别其音，审调别其字。\n字清音益和，累累珠不坠。\n当其按节初，微芒辨同异。\n音字两不关，所贵得其意。\n贞静淡素心，心至声亦至。\n不然筝与琵，宫商岂殊器。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26565,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"琴诗 其三","author":"周映清","text":"宫亦有时激，羽亦有时沈。\n苟能识其意，变化皆从心。\n不见思归乐，商调可犯角。\n不见如意娘，角调可犯商。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26566,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"琴诗 其四","author":"周映清","text":"对月谱梅花，幽香发素腕。\n实声与散声，缓急可静按。\n缅思制谱初，猱绰不容乱。\n后人务新声，往往越其畔。\n新声日以靡，抚琴起三叹。\n古法多不传，何止《广陵散》。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26567,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋暮南楼偶赋","author":"周映清","text":"商飙吹入万人家，窗外轻寒透碧纱。\n极浦每惊归雁落，高楼况复夕阳斜。\n破蕉淅沥风如雨，瘦菊离披叶胜花。\n极目晴云何处望，马蹄荒草隔天涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26568,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游望湖亭","author":"周映清","text":"危亭千尺俯溟濛，绝顶苍茫望不穷。\n山势远连林屋窦，湖声直撼洞庭风。\n香台草树依云外，笠泽烟波入镜中。\n七十二峰何处所，长天墨点落青空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26569,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"过前尚书潘公季驯宅","author":"周映清","text":"桑椹春熟乳鸠鸣，无复尚书旧履声。\n蛟断河壖遗迹在，鹤归华表故基倾。\n每嗟兴废逾三癸，空忆声名说二丁。\n惟有石麟未辞去，溪边卧看月初生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26570,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"古意 其一","author":"周映清","text":"美玉产昆冈，千载埋幽壑。\n一朝出尘氛，光气耀重薄。\n剖璞得良匠，拂拭事砻错。\n晶莹无纤瑕，素质秉磅礴。\n急投非其意，韫椟甘淡泊。\n忽逢席上聘，观者尽错愕。\n璠玙遇有时，珍重葆坚确。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26571,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"古意 其二","author":"周映清","text":"东山有佳木，上栖白项乌。\n晨昏恋旧巢，岁暮犹将雏。\n雏成刷毛羽，振翮游上都。\n朝饮蓬池水，夕宿琼苑株。\n亟归思反哺，岂谓身已孤。\n绕树三百匝，空使尾毕逋。\n哀鸣白云端，苍昊不可呼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26572,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将入都门别南楼感赋 其一","author":"周映清","text":"飞花下浅渚，岸柳催行舟。\n再拜别高堂，雪涕辞南楼。\n兹楼廿年住，纵目娱清幽。\n一旦舍之去，揽裾事远游。\n青天见黄鹄，振羽翔高秋。\n岂不恋旧巢，恋亦不能留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26573,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将入都门别南楼感赋 其二","author":"周映清","text":"高堂有阿母，日夕层楼间。\n抚我不离膝，慈训日以娴。\n齐肩得予弟，嬉戏承欢颜。\n生女亦如儿，同此顾复艰。\n儿生能反哺，尚有莱衣斑。\n女生终辞家，去去何时还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26574,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将入都门别南楼感赋 其三","author":"周映清","text":"辞家竟何之，驾言赴京国。\n道路阻且长，渺渺异南北。\n我家沿长溪，菰城近咫尺。\n朝往夕可还，尚虑烟水隔。\n何为远行迈，千里动尘迹。\n北斗挂层霄，望望不可即。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26575,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"将入都门别南楼感赋 其四","author":"周映清","text":"深闺有令范，皎皎扬贞仪。\n授我四德箴，教我五字诗。\n深宵侍篝火，譬若形影随。\n一朝遽言别，相视涕涟洏。\n楼阴下白日，戚戚晨风吹。\n既去复回顾，离愁无尽时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26576,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渡扬子江望金山","author":"周映清","text":"江天淡荡朝霞红，澄波万顷流瀜瀜。\n舟人解缆渡江去，渐觉帆脚生微风。\n苍茫远树失京口，举头忽现青芙蓉。\n奔流直下走东海，金山突兀当其中。\n楼台明灭晃金碧，有如蜃海浮琳宫。\n晴烟缥缈飞鸟绝，但见古塔撑青空。\n我闻此水贯楚蜀，北江下注连南东。\n天留片石作屏障，直与底柱争穹窿。\n坐揽奇景豁胸臆，敢燃犀角窥蛟龙。\n收帆瓜步一回首，江南千里青濛濛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26577,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"扬州","author":"周映清","text":"日暮江流呜咽声，停桡怅望近芜城。\n三千殿脚如云散，廿四桥头自月明。\n萤苑夜游犹有恨，鸡台晓梦太无情。\n惟馀渡口垂杨树，愁损眉峰画不成。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26578,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"得家书有感","author":"周映清","text":"昨夜银镫喜缀花，平安两字到天涯。\n细看墨沈痕皆淡，祇恐彤闱鬓有华。\n北墅旧游芜径暗，南楼归梦月光斜。\n愁来羡尔中庭树，日暮霜风集子鸦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26579,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"独坐书感","author":"周映清","text":"明镜双眉皱不收，天涯旅思尚悠悠。\n帘垂清昼阴疑暮，雨送残春冷似秋。\n一别骆驼桥下水，三年鸿雁影边愁。\n羡他短棹江南路，缓缓花开唱陌头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26580,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜读东坡集","author":"周映清","text":"笠屐风流迈永和，瓣香只合拜东坡。\n文章远过漆园吏，富贵徒嗟春梦婆。\n万古峨嵋名不没，一身江海命如何。\n谈空莫更夸仙佛，心迹曾传水调歌。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26581,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"令阿缃入学 其一","author":"周映清","text":"从来娇绕膝，今已略知闻。\n恩义难相掩，贤愚自此分。\n枣梨余自具，经传汝宜勤。\n未暮休归舍，童心惧放纷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26582,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"令阿缃入学 其二","author":"周映清","text":"低鬟怜阿姊，与汝亦齐肩。\n且令抛金线，相随理旧编。\n双行知宛转，坐咏爱清圆。\n试看俱成诵，今朝若个先。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26583,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"壬午七夕焚香静对心境清澈飘飘有凌云之想","author":"周映清","text":"云际神光果合离，仙家自古此佳期。\n试从跨鹤缑山日，历数骖鸾汉殿时。\n恍忆前身同缥缈，偶来下界暂栖迟。\n何时相逐三山去，重揽灵裙织藕丝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26584,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"娇女诗","author":"周映清","text":"我家娇女齐蕙芬，媚如春月回微光。\n终朝据案弄卷轴，清吟婉转调莺簧。\n今年十二解声韵，七字五字吟琅琅。\n亦知弱腕乏警策，颇有慧语馀清锵。\n闺门尚德不尚艺，四诫初不夸词章。\n岂知陶冶有妙用，能使冰炭消中肠。\n温柔敦厚本诗教，幽閒贞静传闺房。\n但令至性得浚发，勿务浮艳鸣荒唐。\n我昔南楼强解事，力穷汉魏兼齐梁。\n即今所得尚无几，颇觉辛苦难为偿。\n怜汝娇憨亦不恶，岂必刘鲍争低昂。\n作诗因汝感畴昔，祇恐明镜生秋霜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26585,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜露坐","author":"李含章","text":"火云秋未收，商气夕乃至。\n凉飙动木末，梧叶萧萧坠。\n广庭延伫久，月影半在地。\n银河淡无波，疏林皎初霁。\n轩南最幽旷，竹露酒寒翠。\n清阴下藤萝，馀香冷荷芰。\n披襟爱晚凉，枯坐竟忘睡。\n夜久钟漏沈，流萤在衣袂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26586,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"即景","author":"李含章","text":"斜月映疏帘，夜色起寒暝。\n行过曲廓西，衣上梨花影。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26587,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"万固寺","author":"李含章","text":"山寺不知路，忽闻流水声。\n溪随岩石转，塔与白云平。\n古木上无际，幽禽时一鸣。\n松根堪小憩，试汲碧泉清。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26588,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"读王孟诗偶赋","author":"李含章","text":"中允文章健笔扛，出关无计敢从降。\n新愁应继庾开府，老泪曾悲张曲江。\n阙下新词谁第一，河中名士古无双。\n平生别有伤心处，几按岐王乐府腔。\n彭泽高风许独攀，清姿落落绝人寰。\n月中杨柳词人去，雪后梅花野客閒。\n归梦应栖桐柏观，羁魂终绕鹿门山。\n若教明主非相弃，床下何因复放还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26589,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秦始皇","author":"李含章","text":"金虎宫邻事可怜，漫疑鹑首赐钧天。\n终令六国还三户，空使诸生笑九泉。\n车载韫辌山有鬼，舟行缥缈海无仙。\n伤心万里长城在，依旧扶苏伏剑年。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26590,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"望岱","author":"李含章","text":"岧峣屼峍峙神州，万壑风云在下头。\n海外天光明野马，寰中人影动蜉蝣。\n金银气涌楼台壮，琴筑声寒草木秋。\n欲拂穹碑问秦汉，苔封恐自有熊留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26591,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟古 其一","author":"李含章","text":"崇桂茂山椒，幽兰媚涧阿。\n扬华吐芬馨，寂寞无人过。\n时至亦零落，荣悴皆天和。\n灼灼桃李花，当春扬婀那。\n容华非不好，攀折常苦多。\n荣名以为宝，勿复辞轗轲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26592,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟古 其二","author":"李含章","text":"炎洲多珍禽，自呼孔与鸾。\n朝栖珊瑚枝，夕宿芙蓉田。\n文采颇自矜，矫矫振华翰。\n汉使重珍奇，罗网来重峦。\n饮以琼池水，翼以白玉栏。\n禁林任止宿，所食皆琅玕。\n饮啄岂不时，引吭常悲酸。\n遗雏在故山，欲往道里艰。\n君莫笑鹪鹩，一枝乃自安。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26593,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟古 其三","author":"李含章","text":"芳葩熙春阳，零叶凛秋辰。\n商飙歘以来，绿叶成枯薪。\n芬华既云逝，淡泊全其真。\n直干凌严霜，根荄肇先春。\n敷愉安足恃，葆璞完吾淳。\n孤生各有志，岂惟松柏贞。\n莫嗟风霜惨，中有大造仁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26594,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"拟古 其四","author":"李含章","text":"我有照乘珠，生长薄海曲。\n孕月含清辉，光照鲛人屋。\n一朝逢越贾，采摘出幽壑。\n献入明光宫，藉以文梓椟。\n金缸同不夜，符采烂华幄。\n实至名必归，何必虑鱼目。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26595,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋夜读韦诗","author":"李含章","text":"山城足秋阴，凉意入深屋。\n黄昏疏雨过，檐溜断复续。\n霁色开遥岑，帘际映寒绿。\n微云淡落月，馀光入修竹。\n深更人未寝，青镫照幽独。\n爱此五字诗，静对黄花读。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26596,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三女令昭于归都门","author":"李含章","text":"在家为客莫言勤，此去方知是主人。\n百岁毁誉关阿母，一时贤否定诸亲。\n金萱昼永储甘旨，玉笋官清课米薪。\n傥辍馀閒吟谢絮，锦囊应寄济川滨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26597,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"霍山道中","author":"李含章","text":"莽莽晴沙野草枯，朔风汾水记征途。\n山头麦垄千层出，溪畔松阴一径纡。\n高阁残阳飞鹁鸽，乱峰积雪走于菟。\n千秋唐魏遗风在，认取平阳古帝都。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26598,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"平定州道中","author":"李含章","text":"高岭鸟飞绝，崎岖路一湾。\n悲风生远树，晓雾失前山。\n麦气荒原下，车声乱石间。\n千秋燕赵地，兀兀见重关。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26599,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"论诗","author":"李含章","text":"好诗如佳人，嫣然媚幽独。\n铅华屏不御，葆此无瑕玉。\n巧笑流瑳那，蛾眉腾曼绿。\n一顾失倾城，何必炫奇服。\n又如闻好鸟，应节喧百族。\n引吭扬天和，喁于叶弦乐。\n春花仓庚歌，夜月杜鹃哭。\n微物讵有知，听者感衷曲。\n始知心之声，不在斗繁缛。\n笑啼根至性，风萧任枨触。\n勿使天籁乖，要令老妪觉。\n神充貌自腴，至味乃蕴蓄。\n自从齐梁来，藻缋眩凡目。\n土木饰金貂，珷玞荐文椟。\n旁观岂不好，所苦真意斫。\n兰苕集翡翠，无由起遐瞩。\n嗟余少耽吟，月露困雕琢。\n牢笼及光景，镂刻到草木。\n迩来喜平淡，绮语久阁束。\n悲欢不自禁，涉笔或累辐。\n色黜剪彩艳，声异叩缶俗。\n妇人职中馈，岂事勤著录。\n讵知风人志，性灵藉陶淑。\n发情止礼义，本自三百牍。\n至音谐宫商，六义有正鹄。\n吾言或非迂，试取反覆读。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26600,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"武昌舟次","author":"李含章","text":"樊山秋月旧登楼，又泊兰桡访昔游。\n南去山趋平麓断，北来水入大江流。\n三更画角鱼龙夜，十里平沙雁鹜洲。\n却望衡湘劳远忆，使星明处是潭州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26601,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湘江道中","author":"李含章","text":"打桨湘南路，疏帆挂雨轻。\n青山如旧识，华发是新生。\n苦竹深藏寺，春潮半入城。\n行人正愁绝，怕听鹧鸪声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":26602,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]