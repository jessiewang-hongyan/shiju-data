[{"title":"题画册八首 其六 佳人倚竹","author":"戴亨","text":"剑铓山色割愁难，风紧秋林玉臂寒。\n閒却空庭金鸭火，为谁长袖倚琅玕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11048,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题画册八首 其七 栈道骑驴","author":"戴亨","text":"峻岭危峰斧劈痕，崖悬古木倒生根。\n诗人爱说蚕丛路，秋雨骑驴过剑门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11049,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题画册八首 其八 草坡牧羊","author":"戴亨","text":"濈濈来思亦写真，平坡如簟草如茵。\n眼中臧谷都儿戏，不见山前叱石人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11050,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题陈生小照","author":"戴亨","text":"忙中岁月静中看，醉里浮生醒自寒。\n富贵功名皆是幻，一齐收拾上蒲团。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11051,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"戏赠友人纳妾","author":"戴亨","text":"绣帏春色夜来多，啼鸟声催晓梦过。\n倦起妆成还对镜，扶郎肩臂问如何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11052,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"九日 其一","author":"戴亨","text":"几度重阳客里过，一身长病奈秋何。\n少年壮志蹉跎尽，回首烟云塞上多。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11053,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"九日 其二","author":"戴亨","text":"久客难登客里台，况当多病菊花开。\n乡心已逐秋风急，鸿雁偏从漠北来。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11054,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"瓶花","author":"戴亨","text":"花是名园树上枝，折来袅袅媚春姿。\n如何瓶水求生活，不为深根忆别离。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11055,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"渡溵溜望别山","author":"戴亨","text":"淡沲秋光鸟去还，风蒲烟柳水潺湲。\n林梢一抹鳞鳞碧，共指前山是别山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11056,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"立秋后一日玉田听雨","author":"戴亨","text":"昨日高梧减片青，乱山高下雨冥冥。\n秋来已觉增愁绪，况复寒声旅夜听。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11057,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题线渠茶棚庵","author":"戴亨","text":"卸却征衫敞葛襟，素磁僧舍浥清芬。\n高槐风动层层影，满地莓苔荡绿云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11058,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"胡家窝铺听雨","author":"戴亨","text":"龙荒东指路迢遥，鸿雁声高度泬㵳。\n旅舍孤灯愁不寐，坐听寒雨夜萧萧。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11059,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"过石山站怀林大搢","author":"戴亨","text":"石山古驿众山前，沽酒邮亭握别年。\n几日归来重驻马，断蓬衰柳锁寒烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11060,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夜泊箫声","author":"戴亨","text":"小艇银塘夜泊迟，木樨风细夜衔卮。\n箫声隐隐渔家外，正是前峰月上时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11061,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"潇湘泛棹图","author":"戴亨","text":"雨过潇湘近午钟，芰荷风暖水溶溶。\n帆樯曲折随流转，看尽衡山九面峰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11062,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"扁舟万里图","author":"戴亨","text":"草蓑箬笠一扁舟，万里长江任去留。\n直破雄风到沧海，白云深处是瀛洲。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11063,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"西湖泛月图","author":"戴亨","text":"鸿雁声高夜露浓，一湖清冷浸芙蓉。\n碧天深处舟初泊，月在孤山第一峰。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11064,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋江泛棹图","author":"戴亨","text":"科头人在木兰舟，红藕香中觅胜游。\n昨夜雨过新水涨，沿江添得蓼花秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11065,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"溪桥饮牛图","author":"戴亨","text":"饮牛朝夕颍川阴，真羡巢由出世心。\n踪迹不通朝市路，过桥东去海云深。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11066,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"牛背横笛图","author":"戴亨","text":"前山饲罢日斜曛，横笛声声断续闻。\n野老扶筇閒出望，心知牧子下寒云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11067,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"散牛啮荻图","author":"戴亨","text":"一犁耕老脱危缰，从此逍遥下石冈。\n野食不须愁自觅，道旁秋浦荻芦黄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11068,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"闻雁","author":"戴亨","text":"竹影横阶月色凉，秋风淅淅洒衣裳。\n惊心忽听南归雁，回首云山万里长。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11069,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"冰鉴","author":"戴亨","text":"谩誇水镜别妍媸，一夕严风异昔时。\n我自不嫌寒彻骨，独留冰鉴照须眉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11070,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋夜","author":"戴亨","text":"天涯久客厌秋频，蟋蟀声悲泣露筠。\n孤馆深宵愁不寐，入帘残月静依人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11071,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"枯树寒雅图","author":"戴亨","text":"阴云如墨树苍黄，空谷无人雪满冈。\n野雀集枯甘寂寞，不随春燕入雕梁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11072,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"雪竹","author":"戴亨","text":"惨惨寒声一夜雪，千章乔木经摧折。\n劲节排风能力持，后凋不独称松柏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11073,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"墨蟹戏题","author":"戴亨","text":"草泥郭索遍江干，匡满玄黄菊未残。\n把酒持螯秋正好，不应空作画图看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11074,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"寄答毛秋岑","author":"戴亨","text":"河梁怨别酒方酣，凛凛清霜拂剑镡。\n几日莺花春事尽，空教离思满江南。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11075,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"荷溪口号","author":"戴亨","text":"菱塘荇渚受凉风，渔唱鸥吟夕照中。\n举目骇看天水外，云峰千笏插晴空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11076,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"闻雁","author":"戴亨","text":"百年踪迹感飘蓬，兀坐萧斋听早鸿。\n纸帐梅花孤客梦，月明几度换秋风。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11077,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"口占一绝送松乔陪祀","author":"戴亨","text":"冈回水抱陟还涉，紫气氤氲射眉睫。\n悄悄无声一夜霜，归途马上看红叶。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11078,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"仙缘","author":"戴亨","text":"海外三山接玉京，谁知灵黍秘云英。\n裴郎不遇蓝桥渡，捣药空闻玉杵声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11079,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"游仙二首 其一","author":"戴亨","text":"缥缈仙姝下凤楼，桃源渡口木兰舟。\n亭桡顾我搴珠箔，笑与华池露一瓯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11080,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"游仙二首 其二","author":"戴亨","text":"羽驾蹁跹驭紫烟，霓裳仙乐奏钧天。\n蕊珠宫里陪春宴，麟凤洲前月正圆。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11081,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"示从游诸生","author":"戴亨","text":"换骨玄霜日夜舂，问谁服食驻芳容。\n他时我欲寻仙侣，鸾鹤空怀去后踪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11082,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋怀","author":"戴亨","text":"坐破寒毡不解愁，西风猎猎又□秋。\n丈夫别有千年业，莫但争誇定远侯。","collection":"清","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11083,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留示从学诸生 其一","author":"戴亨","text":"茫茫尘海问仙山，亦解神丹遇者艰。\n行到桃源最深处，几人坚信不思还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11084,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"留示从学诸生 其二","author":"戴亨","text":"上乘高谈误众贤，非关顽骨不成仙。\n尘根涤荡灵根露，剩粒残砂亦厚缘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11085,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"胥江吊古","author":"戴亨","text":"两岸芦花对客愁，雁行南下楚云秋。\n临江忽洒英雄泪，明月箫声古渡头。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11086,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送缪公子公俨之江浦兼简孙大渊如三首 其一","author":"洪亮吉","text":"相别翻怜相见迟，坐中人影壁间诗。\n魂摇青草东风路，梦立黄河远岸时。\n病马去来应有恨，秋禽踪迹本难知。\n寥寥门闭红尘里，残腊都将浊酒支。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11087,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送缪公子公俨之江浦兼简孙大渊如三首 其二","author":"洪亮吉","text":"去去遥山一桁青，愁程先已梦中经。\n江南迢递伤情思，公子知交有性灵。\n久据灶觚看读易，暂探石阙纪搜铭。\n来朝风色东南便，我亦商归大海萍。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11088,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送缪公子公俨之江浦兼简孙大渊如三首 其三","author":"洪亮吉","text":"好因鲂鲤答枯鱼，总觉蛩蛩念巨虚。\n白日怀人当槛坐，红云羡尔对江居。\n身名莫笑中条叟，乡里须乘下泽车。\n丙舍一椽松数尺，未妨他日访吾庐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11089,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送缪公子公俨出都","author":"洪亮吉","text":"五岳未陟一，欲归难戒涂。\n抚剑送子行，浮云亦南徂。\n子有东顾心，恋此巢上乌。\n予怀欲南驰，念彼浊水泸。\n两地忽易居，一心安得无。\n子行过岱宗，为我谨献书。\n已办十两屐，愿届神所都。\n俯仰六合间，灵气藉发舒。\n神乎幸勿哂，东海贱丈夫。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11090,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"奉酬缪公子白沙河见怀诗","author":"洪亮吉","text":"尔如华亭鹤，不欲识二陆。\n解后得识张季鹰，雅志不复矜飞腾。\n我如昭邱狐，读书名博物。\n茂先可语不识机，亦欲辞归住蓬荜。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11091,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"五日小雨登永宁城远眺","author":"金科豫","text":"细雨经旬湿野蒲，双桥低壁水平铺。\n云连山色迷铜鼓，风送滩声下铁炉。\n照眼丹榴红似火，垂堤绿树润如酥。\n夜郎咫尺峰峦峻，苍翠遥看淡欲无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11092,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"舟次","author":"金科豫","text":"放棹中流任所之，晚风吹散雨丝丝。\n西南一带山如画，贪看青苍对酒时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11093,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卜居觉林寺漫兴二首 其一","author":"金科豫","text":"王事遄征六月间，风尘假此暂停骖。\n卜居正喜禅关静，览胜亲从禹穴探。\n绕槛烟光清人座，当楼山色远拖岚。\n晨昏多少林峦趣，拟共高人促膝谈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11094,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"卜居觉林寺漫兴二首 其二","author":"金科豫","text":"绿树阴森荫佛庐，尘襟涤尽旅怀舒。\n临风梵韵朝宣课，隔院梆声昼饲鱼。\n曲径云深花放后，小亭舟上客来初。\n就中赢得閒无数，未许凭栏赋索居。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11095,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"登浮图绝顶纵目","author":"金科豫","text":"突兀孤撑碧落中，攀登一一想神工。\n当檐日出长安远，搔首人来帝座通。\n八面轩棂尘世外，万家烟火大江东。\n临风且漫舒长啸，空惹高飞鹤唳空。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11096,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"晓渡渝江","author":"金科豫","text":"万顷奔涛一叶舟，日光初逗晓凉收。\n远江水落横孤石，极浦风轻下野鸥。\n城市人烟依绝壁，江天云影漾中流。\n巴渝咫尺饶清景，双桨频来韵亦悠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11097,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"登真武山览胜二首 其一","author":"金科豫","text":"参差楼阁倚层云，取次登临谢俗纷。\n古刹人来僧未返，上方钟动日将曛。\n巴渝水认双流合，黔楚山看万壑分。\n八扇平开舒望眼，昙花香里净尘氛。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11098,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"登真武山览胜二首 其二","author":"金科豫","text":"放空眼界翠微巅，遐迩同收碧牖间。\n朱户万家巴子国，丹霞千缕缙云山。\n风清竹屿松花落，日永莎阶鹤梦閒。\n指点涂村多胜境，令人追忆杳难攀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11099,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日小雨同人宴集觉林寺之闻犀堂分韵得七绝二首限十二文 其一","author":"金科豫","text":"廉纤细雨湿苔文，古寺幽深锁碧云。\n镇日欢呼情未已，隔窗谁遣暮钟闻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11100,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"夏日小雨同人宴集觉林寺之闻犀堂分韵得七绝二首限十二文 其二","author":"金科豫","text":"凉飘曲院酒初醺，满眼林峦积翠分。\n领取清光尘境外，催诗雨过一溪云。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11101,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"新秋遣怀戏赠刘玉斋并柬秦思斋明府 其一","author":"金科豫","text":"天宇清明入早秋，碧梧凉吹雨初收。\n楸枰一局频频换，嬴得涂山月满楼。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11102,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"新秋遣怀戏赠刘玉斋并柬秦思斋明府 其二","author":"金科豫","text":"下榻禅关百虑清，相逢随意酒频倾。\n秋光已过巴江水，莫为乡园系我情。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11103,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"新秋遣怀戏赠刘玉斋并柬秦思斋明府 其三","author":"金科豫","text":"第里久传江右盛，琴书偶作锦城游。\n谁怜杜子贫如洗，老向三川客未休。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11104,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"新秋遣怀戏赠刘玉斋并柬秦思斋明府 其四","author":"金科豫","text":"一枕羲皇午梦閒，醒来偏讶夕阳殷。\n凭栏几度舒双眼，贪看王维画里山。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11105,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"新秋遣怀戏赠刘玉斋并柬秦思斋明府 其五","author":"金科豫","text":"臭味芝兰邂逅中，异乡离合几秋风。\n闻犀堂畔天香里，记取联吟曲槛东。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11106,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"新秋遣怀戏赠刘玉斋并柬秦思斋明府 其六","author":"金科豫","text":"棋酒相逢乐不孤，伯龄前此意何如。\n自怜雅概齐江左，漫问当门折齿无。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11107,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"觉林八景 其一 晓钟唤渡","author":"金科豫","text":"晓月没云霄，疏钟传水曲。\n隔岸唤舟人，立久明朝旭。\n一叶入中流，棹破江烟绿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11108,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"觉林八景 其二 莲峰垂露","author":"金科豫","text":"莲峰向晚开，馥郁凝香雾。\n夜半月华明，隐约垂仙露。\n滴滴慧珠圆，飘落应无数。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11109,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"觉林八景 其三 龙桥夜月","author":"金科豫","text":"一水驾长虹，依稀通月穴。\n三五桂轮圆，照耀波纹缬。\n水月自年年，清光流不绝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11110,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"觉林八景 其四 铁笔凌霄","author":"金科豫","text":"孤厦倚云开，修椽如笔立。\n何年铁铸成，挽运凌层级。\n髣髴欲书空，濡染烟霞汁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11111,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"觉林八景 其五 远泉流香","author":"金科豫","text":"花落自缤纷，泉流足悠远。\n幽香逐水来，九折缘莎阪。\n汲取日烹茶，甘冽倾兰畹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11112,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"觉林八景 其六 屏山积翠","author":"金科豫","text":"远山列画屏，翠积青如淀。\n晴开万壑烟，林木浮葱茜。\n悠然见鸟飞，坐对几忘倦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11113,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"觉林八景 其七 紫崖瀑布","author":"金科豫","text":"丹崖似削成，瀑布千寻落。\n明如素练悬，寒漾水晶箔。\n纷纷溅沫馀，无数珠交错。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11114,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"觉林八景 其八 古涧连枝","author":"金科豫","text":"依依连理枝，涧底饱霜雪。\n不畏岁寒侵，永作同心结。\n清阴自足珍，何必花如缀。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11115,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"秋晓即事","author":"金科豫","text":"秋光媚朝旭，薄霭横空濛。\n林木郁以秀，萧爽凌金风。\n中有小山桂，蕊放香潜通。\n簇簇黄金粟，掩映东复东。\n依槛发遥瞩，翠重轻烟笼。\n幽芬日飘拂，坐对思无穷。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11116,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送别秦明府 其一","author":"金科豫","text":"问效驰驱事，君行我未行。\n暂留非得已，相送倍关情。\n落日秋声壮，空江月色明。\n萧森三峡里，休听夜猿鸣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11117,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送别秦明府 其二","author":"金科豫","text":"触物兴怀抱，殷勤发浩歌。\n水清鱼迹少，秋老雁声多。\n山雨寒应峭，风霜志不磨。\n勉将诗酒意，随处寄吟哦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11118,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送别秦明府 其三","author":"金科豫","text":"迢递三川水，应嗟行路难。\n丹山牛肺峡，白浪虎须滩。\n怪石兼天涌，阴云匝地寒。\n吟髭霜几许，休对镜中看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11119,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"送别秦明府 其四","author":"金科豫","text":"鹦鹉洲前路，何时一系船。\n浮踪依汉水，归梦绕秦川。\n地远楼重倚，山高月再弦。\n相思羁两处，凝望隔寒烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11120,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"折尾滩祀张桓侯庙有作 其一","author":"金科豫","text":"千古威灵共水长，江滨俎豆日馨香。\n暗中回得狂澜转，不使奔涛滞客航。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11121,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]