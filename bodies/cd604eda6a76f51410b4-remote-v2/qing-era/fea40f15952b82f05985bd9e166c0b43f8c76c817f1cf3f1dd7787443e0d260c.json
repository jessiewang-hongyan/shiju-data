mit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11041,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"南陂","author":"戴亨","text":"南陂高下接烟洲，峰顶千秋水自流。\n十亩桑田耕夜月，清光端为白云留。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11042,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题画册八首 其一 梅花书屋","author":"戴亨","text":"生来未到梅花坞，此日西溪画里看。\n羡杀竹林携屐过，一门晴雪照人寒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11043,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题画册八首 其二 倚槛看荷","author":"戴亨","text":"风清水阁芰荷香，卓午鸣蝉日正长。\n何处兰桡喧笑语，飞来七十二鸳鸯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11044,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题画册八首 其三 仙山楼阁","author":"戴亨","text":"参差楼阁玉为梁，来往仙姝蹑凤凰。\n百尺丹梯容我上，吹笙亲乞杜兰香。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11045,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题画册八首 其四 虹桥玩月","author":"戴亨","text":"混迹尘寰说饼师，江南人物系相思。\n柳湖松岛三更月，丁卯桥头许浑诗。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11046,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}},{"title":"题画册八首 其五 芦岸渔舟","author":"戴亨","text":"霜林彷佛似苕川，水漾空明映碧天。\n隔岸炊烟生一缕，荻芦深处泊渔船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_2.csv","pointer":11047,"sha256":"a1fbd8db5f1605565e4bb98e0e76a1c272c3eb132126b08b18d8cae883b36fd4","dynasty":"清"}}]