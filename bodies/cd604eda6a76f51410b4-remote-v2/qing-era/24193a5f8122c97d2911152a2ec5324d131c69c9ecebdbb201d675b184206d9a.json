[{"title":"玉楼春 其四","author":"郑文焯","text":"晓莺帘外啼红处。\n明月不留花影住。\n起来弄篴过西桥，宿粉狂香吹满路。\n路人不惜春心苦。\n贪逐韶光过百五。\n杏墙残萼待归簪，深雨闭门花乱舞。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33695,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪纱 其一 清明载酒山塘重记所见","author":"郑文焯","text":"花气温温趁橹柔。\n禁烟晴昼水如油。\n酒边残梦十三楼。\n暂见不如成久别，旧欢无计破新愁。\n来时春草去时秋。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33696,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪纱 其二 清明载酒山塘重记所见","author":"郑文焯","text":"斜日朱楼对捲帘。\n篴中人意柳纤纤。\n乱丝著地被愁黏。\n花影蹋歌红步障，水香试酒白凉衫。\n一春费泪与江南。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33697,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪纱 其三 清明载酒山塘重记所见","author":"郑文焯","text":"池馆新晴语细禽。\n堕钗曾傍药阑阴。\n经年同梦不同心。\n近水吹香春澹薄，移花步影夜清沉。\n月圆时节到而今。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33698,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪纱 其四 清明载酒山塘重记所见","author":"郑文焯","text":"拂水东风剧有情。\n柳花当面化流萍。\n天涯吟鬓几时青。\n残烛已销无用泪，清歌犹作奈何声。\n西楼人去恨长醒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33699,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"采桑子 其一","author":"郑文焯","text":"凭高满面东风泪，独立江亭。\n流水歌声。\n销尽年涯不暂停。\n归来自掩香屏卧，残月新莺。\n梦好须惊。\n知是伤春第几生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33700,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"采桑子 其二","author":"郑文焯","text":"销魂最是皋桥水，花雨冥冥。\n歌泪盈盈。\n不解西流总费声。\n画船烟泊经游地，灯火高城。\n弦管残更。\n无奈明朝酒易醒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33701,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三台令 其一","author":"郑文焯","text":"春雨。\n春雨。\n滴到无声更苦。\n红楼酒醒天涯。\n相送舟前落花。\n花落。\n花落。\n还较去年轻薄。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33702,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"三台令 其二","author":"郑文焯","text":"春水。\n春水。\n流尽一年花泪。\n绿阴明日池塘。\n可待重来断肠。\n肠断。\n肠断。\n重来茜窗人澹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33703,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪纱 其一","author":"郑文焯","text":"著酒芳心不自持。\n小云双枕带花移。\n今年春早梦先知。\n梅萼有情红到骨，柳条无恨翠舒眉。\n水堂新月旧相期。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33704,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪纱 其二","author":"郑文焯","text":"无事伤心独费情。\n落梅风里掩重扃。\n春衣一桁细香零。\n词谱当歌和泪教，镫窗无睡枕肩听。\n水边花外雨冥冥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33705,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒金门 其一","author":"郑文焯","text":"烟浪恶。\n花满海山楼阁。\n辽鹤无书云漠漠。\n故宫春梦薄。\n莫惜舞人零落。\n长袖为君重著。\n堕地鸾钗成密约。\n捧觞千日乐。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33706,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒金门 其二","author":"郑文焯","text":"花窣地。\n红玉枕山云腻。\n良夜好天浓睡里。\n蜡盘空转泪。\n妾似杨花飘坠，郎是一江春水。\n容易东风无好计。\n少年须著意。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33707,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒金门 其三","author":"郑文焯","text":"钗凤坠。\n人意不如初会。\n圆月后逢歌舞地。\n断肠明镜里。\n早是君心难恃，恨不玉颜先悴。\n恩重娇多情易费。\n枕函花有泪。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33708,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪纱  其一 乙未山塘寒食","author":"郑文焯","text":"春半馀寒未减衣。\n绿莎汀溆燕来稀，梦期何事镇相违。\n一簇帘花残月地，数行门柳宿烟枝，画船灯火夜归迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33709,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪纱  其二 乙未山塘寒食","author":"郑文焯","text":"斗草阑干晚棹移，好风香出画罗衣，隔花临水见腰肢。\n病枕久虚胡蝶梦，歌楼犹唱鹧鸪词，疏狂多误少年时。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33710,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天 中秋后二日越来溪夜汎","author":"郑文焯","text":"露脚斜波月上迟。\n镜中曾见越来时。\n湖光一片伤心碧，却与吴儿作水嬉。\n飞画鹢，引金蠡。\n罗旂香干烛龙随。\n歌尘只是黄昏散，愁满风萝野粉吹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33711,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天","author":"郑文焯","text":"岩桂秋香晚尚花。\n顺阳旧墅问残霞。\n五湖自送鸱夷去，风月依然属范家。\n浮白劝，比红誇。\n有人低唱倚蒹葭。\n曲中解得销魂句，不羡溪头越女纱。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33712,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行 其一 送子苾入陕","author":"郑文焯","text":"连棹湖山，对床风雨。\n吟坛十载更相主。\n已怜憔悴尽中年，那堪离乱成孤旅。\n鸥外吴云，马头秦树。\n大江东去人西去。\n严关百二旧经行，不愁梦失寻君处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33713,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行 其二 送子苾入陕","author":"郑文焯","text":"压酒春灯，掩歌秋扇。\n江南已是无肠断。\n曲中莫作水风听，尊前便有关山怨。\n经醉池亭，临分笺管。\n西园芳草随人远。\n黄金纵得赎蛾眉，胡沙应换春风面。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33714,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行 其三 送子苾入陕","author":"郑文焯","text":"蜀锦裁篇，吴皋飘寓。\n佳游顿失城南侣。\n桥边乌鹊纵分飞，陇头鹦鹉能言语。\n柳雪官程，图书傢俱。\n扁舟明日长安路。\n多君一县好青山，支颐手板供愁句。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33715,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"踏莎行 其四 送子苾入陕","author":"郑文焯","text":"南浦兰情，西崦梅讯。\n好春良月离天近。\n十年空负过江名，一官直抵飞花溷。\n山县愁鬟，雪关衰鬓。\n才人自断漂零分。\n它时好载郁林归，只应片石销残恨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33716,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天  其一 余往来邓尉山中十馀年矣，独爱青芝一坞，林嶂秀岨，人迹罕至交，有终焉之志，未逮也。还泊西崦因赋是解","author":"郑文焯","text":"树隐湖光望转明。\n岩深晚桂尚飘馨。\n十年秋鬓输山绿，依旧看山梦里行。\n烟澹宕，月空冥。\n下崦蒙雨上崦晴。\n眠去无地青芝老，虚被樵渔识姓名。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33717,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天  其二 余往来邓尉山中十馀年矣，独爱青芝一坞，林嶂秀岨，人迹罕至交，有终焉之志，未逮也。还泊西崦因赋是解","author":"郑文焯","text":"结梦疏云泛渚蘋。\n霜林秋色艳于春。\n山中种树书堪读，世上繁华迹总陈。\n惊岁晚，负閒身。\n石芝鹤语旧知津。\n红桑海畔花争发，一掬微波见绿尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33718,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其二","author":"郑文焯","text":"永丰坊半翠双枝。\n和泪移来近玉墀。\n不是伤春词客在，故宫谁解妒腰肢。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33719,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝","author":"郑文焯","text":"才作风花又水萍，一生好计只飘零。\n可怜憔悴章台路，送尽离人眼尚青。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33720,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒金门","author":"郑文焯","text":"行不得！\n黦地衰杨愁折。\n霜裂马声寒特特，雁飞关月黑。\n目断浮云西北，不忍思君颜色。\n昨日主人今日客，青山非故国。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33721,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒金门","author":"郑文焯","text":"留不得！\n肠断故宫秋色。\n瑶殿璚楼波影直，夕阳人独立。\n见说长安如弈，不忍问君踪迹。\n水驿山邮都未识，梦回何处觅？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33722,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"谒金门","author":"郑文焯","text":"归不得！\n一夜林鸟头白。\n落月关山何处笛？\n马嘶还向北。\n鱼雁沈沈江国，不忍闻君消息。\n恨不奋飞生六翼，乱云愁似幕。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33723,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝","author":"郑文焯","text":"数行烟柳蓟门春，离袂经年惹曲尘。\n莫为西风摇落早，灞陵犹有未归人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33724,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝","author":"郑文焯","text":"长条如带水萦环，难繫离愁百二关。\n羡尔巢林双燕子，秋来暂客尚知还。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33725,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其三","author":"郑文焯","text":"暂理愁眉试半妆，舞衣叠泪损宫黄。\n晴丝绕遍天涯路，不为离人续断肠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33726,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其四","author":"郑文焯","text":"回雪吹花唱大堤，弓腰斗罢梦长啼。\n身轻不及枝头絮，犹逐东风舞向西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33727,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其五","author":"郑文焯","text":"乱丝歧路苦愁萦，剪剪轻风别有情。\n一夜雪绵吹满帐，教人春梦不分明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33728,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其六","author":"郑文焯","text":"夹道分堤翠浪生，湖山歌舞总堪惊。\n只今一片斜阳树，剩有宫鸦啼数声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33729,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其七","author":"郑文焯","text":"烟洗风梳碧可怜，秋深犹咽五更蝉。\n谁家残月沧波苑，时见渔舟网碎钿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33730,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其八","author":"郑文焯","text":"故国年芳换绿尘，楼台多是别家春。\n狂花一阵过无影，乱入宫城不避人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33731,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其九","author":"郑文焯","text":"水明帐殿月如烟，翠楼连云挂玉泉。\n香辇不回秋又晚，栖乌头白近霜天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33732,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其十","author":"郑文焯","text":"破晓残莺出禁林，飞花寒食雨沈沈。\n章台自台牵行色，莫为离多减路阴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33733,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其十一","author":"郑文焯","text":"楼阁春深雪不寒，关山秋早笛初残。\n一般画出伤心色，漫作隋堤落照看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33734,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其十二","author":"郑文焯","text":"纤纤新翠带愁颦，零落弓弯旧舞人。\n底事临风眠未起，灵和不是汉时春。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33735,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其十三","author":"郑文焯","text":"拂遍京尘窣地惊，风条雨叶不胜情。\n西园已自无多树，一夜伤秋转费声。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33736,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其十四","author":"郑文焯","text":"平居谁分解伤春，竞赌长楸走马身。\n寂寞空城飞絮尽，羌笳吹起六街尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33737,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其十五","author":"郑文焯","text":"高秋萧瑟思何堪，昔树空悲忆汉南。\n任是婆娑生意尽，不辞风雪老江潭。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33738,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天 其一 馀与半塘老人有西崦卜邻之约，人事好乖，高言在昔，款然良对，感述前游，时复悽绝。","author":"郑文焯","text":"据榻连吟数往年，夜窗枥马警秋眠。\n可怜燕市尊前月，又共吴云梦里天。\n回首处，一潸然。\n小山招隐有新篇。\n淮南几树留人桂，纵得攀援不得仙。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33739,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天 其二 馀与半塘老人有西崦卜邻之约，人事好乖，高言在昔，款然良对，感述前游，时复悽绝。","author":"郑文焯","text":"秋老山桥虎气沈，霜风呼酒旧登临。\n梵钟出树岩扉回，渔火通波雨坞深。\n连棹路，五湖心。\n别来三见冷枫吟。\n白云定识非生客，莫枉芝崦鹤梦寻。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33740,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"鹧鸪天 其三 馀与半塘老人有西崦卜邻之约，人事好乖，高言在昔，款然良对，感述前游，时复悽绝。","author":"郑文焯","text":"谏草焚馀老更狂，西台痛哭恨茫茫。\n秋江波冷容鸥迹，故国天空到雁行。\n诗梦短，酒悲长。\n青山白发又殊乡。\n江南自古伤心地，未信多才累庾郎。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33741,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其一 甲辰中秋后二日晚晴放舟石湖，观越城桥下☆月，明日将从胥口探桂山中，不预此游盖五年矣。","author":"郑文焯","text":"溪上曾闻渡越兵，乱流犹似怒蛙鸣，蒲风杉雨战秋声。\n梧梦只今空故苑，菱歌依旧绕离城，长桥人散月孤明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33742,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其二 甲辰中秋后二日晚晴放舟石湖，观越城桥下☆月，明日将从胥口探桂山中，不预此游盖五年矣。","author":"郑文焯","text":"花艳连桡度镜光，满湖丝管水飞香，月明何恨预兴亡。\n莫揽清歌悲小海，更催秋梦落横塘，波空塔影自凄凉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33743,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其三 甲辰中秋后二日晚晴放舟石湖，观越城桥下☆月，明日将从胥口探桂山中，不预此游盖五年矣。","author":"郑文焯","text":"烟夕凉波起白蘋，蔫红落粉尽歌尘，依稀山黛可怜颦。\n一舸谁寻虾菜路，千丝空羡鲙残鳞，无多秋事属閒人。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33744,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其四 甲辰中秋后二日晚晴放舟石湖，观越城桥下☆月，明日将从胥口探桂山中，不预此游盖五年矣。","author":"郑文焯","text":"夜午看山旧寺楼，别来岩桂五经秋，好花凉月醉扶头。\n一水又平桥畔路，几人曾预镜中游，山阳残笛更吹愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33745,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其五 甲辰中秋后二日晚晴放舟石湖，观越城桥下☆月，明日将从胥口探桂山中，不预此游盖五年矣。","author":"郑文焯","text":"听水听歌醉梦间，秋衣零露夜忘还，拍浮人与白鸥閒。\n馀兴好探花里市，旧情不断枕边山，半篷风色过梅湾。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33746,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"浣溪沙 其六 甲辰中秋后二日晚晴放舟石湖，观越城桥下☆月，明日将从胥口探桂山中，不预此游盖五年矣。","author":"郑文焯","text":"旧泊横桥花覆船，酒灯人语隔湖烟，红箫肠断十年前。\n经醉溪山如此夜，后逢花月奈何天，漫吟秋扇黯悽涟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33747,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花 其一","author":"郑文焯","text":"春雨晚来过一阵，送了清明，有限花番信。\n又是伤春天气近，阴晴半日都难定。\n见说好春新值闰，如梦如酲，依旧年时病。\n人事音书谁与问，游丝舞絮空添恨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33748,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花 其二","author":"郑文焯","text":"几日层城春漏泄，小槛调莺，宛转新柔舌。\n好梦不堪春后说，空林犹有啼鹃血。\n兰麝罢熏山枕热，酒醒阑干，满面杨花雪。\n羌管有情吹不彻，乱云过影中庭月。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33749,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花 其三","author":"郑文焯","text":"花月一春供几醉，染柳熏梅，费尽铅华水。\n帘幕尘尘如梦里，为谁断送伤心地。\n不信东风能换世，过半韶光，怊怅无多事。\n题泪花枝难远寄，燕莺空诉留春计。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33750,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花 其四","author":"郑文焯","text":"落尽江梅春已半，浪蕊狂花，不到伤春眼。\n一夜金铃消息断，只供蜂蝶喧尘乱。\n陌上马蹄梁上燕，解惜香泥，已是韶红变。\n斜日帘栊人不见，蘼芜雪老谁家苑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33751,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"采桑子","author":"郑文焯","text":"竹声到枕凉如许，翠湿纱幮，香断灯孤，冰簟银床一夜疏。\n晓来独步穿花去，罗袂沾濡，满把明珠，始觉前溪过雨初。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33752,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"采桑子","author":"郑文焯","text":"雨帘不捲初疑夜，梦地模糊，竹醉花扶，过枕茶声午睡馀。\n故人久断江干信，借问庭梧，秋意何如，一日西风一日疏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33753,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花 其一 己酉中秋夜雨","author":"郑文焯","text":"好月一年能几见，待得圆时，抵死云遮遍。\n可惜良宵天不管，酒灯暗雨深深院。\n梧叶洒阶愁万点，不听清歌，已是无肠断。\n旧节惟酬双泪眼，西阑一夜秋声满。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33754,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"蝶恋花 其二 己酉中秋夜雨","author":"郑文焯","text":"长忆红楼离夜语，月满芳尊，赏月人遍去。\n自见月圆无此苦，年年情恨天难补。\n欲唤姮娥凭说与，泪湿花枝，故作黄昏雨。\n后夜相看肠断处，一弯又被愁眉妒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33755,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其一 赋小城梅枝","author":"郑文焯","text":"谁家笛里返生香？\n倾国风流解断肠。\n头白伤春无限思，不应此树管兴亡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33756,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其二 赋小城梅枝","author":"郑文焯","text":"到地春风不肯閒。\n南枝吹尽北枝残。\n吴宫多少伤心色，占得墙东几尺山！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33757,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其三 赋小城梅枝","author":"郑文焯","text":"采香径里晚烟空，濯粉池边晓露丛。\n一样故宫春寂寞，可怜无地看东风！","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33758,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其四 赋小城梅枝","author":"郑文焯","text":"缟衣月下见前身，隔世惊逢绝世人。\n怊怅溪南数枝雪，为谁开落与江春？","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33759,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其五 赋小城梅枝","author":"郑文焯","text":"轻朱薄粉试妆新，漫比西施镜里春。\n可惜君王残霸业，只教换得两蛾颦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33760,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"杨柳枝 其六 赋小城梅枝","author":"郑文焯","text":"江树犹伤旧国春，肯因冷澹与时新。\n风来谁撼千林雪，一洗人閒桃李尘。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":33761,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]