[{"title":"题画 其二","author":"罗牧","text":"临池不解著思为，此幅居然类大痴。\n望去千山秋色好，间窗风雨慰相思。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9310,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画 其三","author":"罗牧","text":"青峰两岸画天然，中许沙鸥自在眠。\n爱杀湖光明似鉴，欲支清俸买鱼船。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9311,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"春日田家","author":"刘瞻榕","text":"草庐负高阜，柴扉面清池。\n村居本自好，况有春风吹。\n春风果何心，如与丘园私。\n一夕声䬀浏，千顷新绿滋。\n朝来荷锄出，对此情自怡。\n时运无或愆，力田复何疑。\n仓庚先已觉，飞鸣桑树枝。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9312,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"虎牢","author":"刘瞻榕","text":"山险形如削，河奔势若翻。\n中原龙战后，岩邑虎牢存。\n游骑盘飞磴，清笳隐坏垣。\n东西任行客，天限只空言。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9313,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送须觐予还晋陵","author":"刘瞻榕","text":"啄粟野田黄口雀，尽日挥之苦难却。\n翛然老鹤迥出群，连轩矫翼谁能驯。\n春风楼前梅花白，看花君作西洲客。\n细雨冥冥梅子肥，鹧鸪声里送将归。\n何须咎君言别早，客舍虽佳归更好。\n一帆明日向东去，正是鄙夫心忆处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9314,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"禹陵","author":"蒋平阶","text":"撬辇逢尧祀，垂裳拜舜年。\n剖圭开日月，瘗玉镇山川。\n南幸游方豫，东巡驾不还。\n衣冠辞岳牧，剑舄步神仙。\n寝庙春常闭，宫车夜自悬。\n千秋明德远，万众寸心虔。\n海阔沧江外，星临斗柄前。\n金茎留晓露，碧殿锁青烟。\n魍魉犹留鼎，蛟龙想负船。\n秦碑荒草合，汉畤白云连。\n苍水书难得，玄狐箓可传。\n按图通百粤，泪尽九疑天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9315,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送李分虎之滇黔","author":"蒋平阶","text":"万里南中路，春风入五溪。\n地分铜柱北，山险桂林西。\n树酒尊堪泛，箄船棹自携。\n关梁庄蹻设，碑字武乡题。\n水出滇池倒，天临瘴岭低。\n鸟言通八部，绣面接诸黎。\n圣武初经略，征南振鼓鼙。\n三军持毕节，一战下和泥。\n荒服开州郡，穷边走寄鞮。\n阑干红罽入，歌舞白狼齐。\n汉使难重问，磨崖不可梯。\n乌蛮新幕府，属国旧朱提。\n君听南征曲，能令乡思迷。\n山深鹦鹉语，花老杜鹃啼。\n河外青蛉县，关前白马氐。\n还将《碧鸡赋》，迟尔到金闺。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9316,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"查湾步吴梅村先生韵","author":"范缵","text":"涧石画多雾，戎戎揽石根。\n落花停水簖，深竹护沙门。\n鹿过疑无路，鸡鸣忽有村。\n徘徊山吐月，清梵报黄昏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9317,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"湖上","author":"范缵","text":"闽越干戈息，寒鸦还旧林。\n夕阳依草薄，霜信入湖深。\n废苑何人到，空山独客心。\n不堪频驻马，归路接秋阴。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9318,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"京口石松庵晓望大江","author":"范缵","text":"岩窗旅枕每晨兴，残月余光树几层。\n露鸟乍惊邻院鼓，晓船犹带过江镫。\n天留一水陪行客，秋借青山住老僧。\n遥望海门初日起，微微波面白云蒸。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9319,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"即事","author":"范缵","text":"雨后鸦声撼寒树，荧荧渔火随潮去。\n山前烟雾一时昏，隔溪人问停船处。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9320,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"下华顶复至断桥观瀑","author":"许尚质","text":"凌晨陟危磴，山势莽回互。\n攀萝坠岩石，触趾还局步。\n侧身烟霭间，却立屡惊顾。\n前行踵已没，循迹如蚁附。\n缘崖忽复暝，孤悬一线路。\n下瞰老蛟窟，白日雷霆怒。\n神物有隐见，洪波无寒冱。\n匿景就盘曲，蹒跚生恐怖。\n倏同飞鸟翻，云向恶溪渡。\n巨石恣偃蹇，奔流疾相赴。\n褰裳涉逾午，晞发聊延驻。\n不闻人语声，但觉雨如注。\n遥空垂赤虹，中断不得度。\n知是古仙人，戏游博幽趣。\n俄看万里云，六月生寒雾。\n倒挂枯松枝，喷薄失朝暮。\n直下几千仞，石窦巧嵌护。\n圆壶束细腰，明珠落无数。\n疑有鲛人泣，似向真宰诉。\n造幽荡魂魄，发兴抒情愫。\n愿结丹崖盟，庶脱尘网误。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9321,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"齐河道中","author":"许尚质","text":"辟尘风镜隔轻罗，赢得征衣岳色多。\n七十二峰都阅遍，又乘疲马渡齐河。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9322,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题导山庵壁","author":"许尚质","text":"四月山中笋蕨肥，松寮白画雨霏霏。\n浮生似记重来处，树老无枝僧挂衣。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9323,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画雁 其一","author":"边维祺","text":"三三两两傍芦花，风动长江月净沙。\n多少孤舟未归客，十分秋思在天涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9324,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画雁 其二","author":"边维祺","text":"板桥一曲水通村，岸阔沙平丝有痕。\n我画雁鸿求粉本，苇间老屋日开门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9325,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题画雁 其三","author":"边维祺","text":"老夫家住水云乡，画雁撑芦是所长。\n粤客持将南海去，从今边雁过衡阳。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9326,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"渔梁道中","author":"沈湛","text":"山势迂回梯磴劳，渔梁寂寂写秋涛。\n尽多断雁衔芦出，不住哀猿抱树号。\n一曲清溪通石涧，数棱茅屋露东皋。\n分明世外桃源路，莫遣云封阻客舠。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9327,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雨发榆城","author":"倪蜕","text":"罗刹愚鬼夜努脚，血盆之口眼矐矐。\n掀起阴崖万斛云，不许苍山露林薄。\n苍山有神神瑟缩，洱海烟埋难索摸。\n邪龙肉翅横空飞，天半银沙雪花落。\n秋风萧萧鸡腷膊，金叶霜蹄会腾攫。\n珊鞭九节捶盲烟，直指昆仑破寥廓。\n罗刹对此不敢侮，狰面狞牙颜色阻。\n趻踔空山独自归，手扶髑髅泣风雨。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9328,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"兰州杂诗","author":"倪蜕","text":"振袖上皋兰，烟生闾井寒。\n山深连大漠，河急折回滩。\n人苦风沙老，魂惊行路难。\n陇头呜咽水，恻恻泪双弹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9329,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晚归","author":"倪蜕","text":"超忽平原路，萧萧向晚归。\n一星霞外出，双雉陇间飞。\n树乱村镫暗，风恬野烧微。\n钟声何处动，山霭远霏霏。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9330,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"戴宾有意山书屋谈次偶成时宾有举子","author":"马凤翥","text":"意山书屋我曾过，无句堪题邵子窝。\n卖赋近闻车辙满，乞钱常致酒材多。\n檐前绿竹添新笋，石上盘根长旧柯。\n莫笑客为汤饼至，携尊高唱待如何。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9331,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题张羲阳道院","author":"马凤翥","text":"道人爱饮灵泉水，清晓提壶露湿衣。\n黄叶不离松下火，白云常护竹间扉。\n厨香斋钵和钟动，塔响檐铃识鸟归。\n何日丹炉容我伴，荷锄还问药苗肥。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9332,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"落叶次江观察韵 其一","author":"马凤翥","text":"摧枯真觉可怜生，绕地漫天太怆情。\n红似林花辞故蒂，黄随边草杂寒声。\n旧承雨露春何蚤，尽脱风霜野乍清。\n莫向江城高处望，许多溪壑扫难平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9333,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"落叶次江观察韵 其二","author":"马凤翥","text":"舞幕穿帘乱眼多，不堪裁剪奈愁何。\n轻随野鸟孤云去，响蹋空林夜月过。\n题怨汉宫翻旧曲，含凄越女罢新罗。\n祇因一雁萧萧下，引遍城头乌尾讹。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9334,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"答史陶亭","author":"马凤翥","text":"高楼闻枕大湖边，湖上青山山下田。\n共羡子真居谷口，方知彩泽爱斜川。\n扁舟拟棹剡溪雪，蓬阁思登阆苑天。\n忽睹新吟如问渡，渔歌樵唱落尊前。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9335,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送姚象山之粤西","author":"马凤翥","text":"挟策桐江每借筹，又携铅椠向梧州。\n元龙意气宁高卧，司马文章本壮游。\n官舫定期南浦驿，宾筵合醉大云楼。\n欲寻谢传庭前咏，燕寝凝香好唱酬。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9336,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夏日睡翁招过方丈即事偶成","author":"马凤翥","text":"趺坐绳床万虑澄，寒山一片结同心。\n诗虽压药原无病，竹偶吟风可代琴。\n动静总输间处觉，去来休向定中寻。\n请看蜀魄离群久，未必思归直到今。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9337,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"送千仞弟之西江","author":"马昶","text":"征鞍才卸自青齐，又买扁舟听晓鸡。\n孺子亭荒秋水白，滕王阁峙暮云低。\n四山红树孤帆远，千里清霜一剑携。\n送尔更教怀蜀道，鸿飞指爪各东西。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9338,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"游观音庵","author":"马霳","text":"特为寻幽蹋布鞋，上方高处历重阶。\n洞空若蚌含澄水，峰峭如锥立乱崖。\n相国金鱼随土落，仙人黄鹤著尘埋。\n烧铅往事多年冷，怪底穷愁未有涯。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9339,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登黄华山和姚敏仲","author":"马霳","text":"城中独耸高山胜，到此方闻鸟雀喧。\n一片绿云铺雉堞，双流白练绕江村。\n亭临小市初通路，屋对深林未有门。\n险阻听君谈铁岭，未曾攀陟已消魂。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9340,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"玉屏精舍夜坐","author":"马庶","text":"入夏惮炎燠，招凉爱幽境。\n僧房夜未阑，竹榻卧已冷。\n遂揽葛衣起，独倚柴关静。\n乱泉喷云根，清露滴松顶。\n万籁寂无声，半规逗微影。\n溪山取奚尽，风月怀自骋。\n借问城市忙，何由钟磬警。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9341,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"黄竹岭","author":"曾畹","text":"高峰日欲颓，二月入闽来。\n石突交飞瀑，山空易动雷。\n无风人急渡，欲雨鸟先回。\n处处烧田栈，春荒尚未开。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9342,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"北口峪望蔚州","author":"曾畹","text":"匹马桑乾道，孤城沙漠阴。\n风高谷口断，石迸水痕深。\n野雉衔酸果，神狐啸暮林。\n匣中三尺剑，不试夜沈沈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9343,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"有所思寄雨苍季平兄弟","author":"刘青莲","text":"问予何所思，渺在千里友。\n复问思何切，少交今白首。\n古交淡如水，今交浓如酒。\n酒浓祇能暂，水淡乃可久。\n久要百年心，暂好一朝口。\n敦古君锐先，薄今我怯后。\n贞坚霜后松，摇落风前柳。\n两地各努力，千载期不朽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9344,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登劳山绝顶望海","author":"刘源渌","text":"小驻人间七十秋，沧桑几度不关愁。\n到来咫尺蓬瀛路，万里沧波一叶舟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9345,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"闲居","author":"钱廉","text":"闭门静息此禅关，误写斜分郭外山。\n车马不喧燕市里，松花一枕梦初间。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9346,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"怀董缶堂","author":"钱廉","text":"爱尔篇章好，临风见古人。\n讵无千载目，日益故乡贫。\n白发惭滫厚，青镫拭蠹频。\n嗟余亦寥落，执手倍伤神。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9347,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"饮宋受谷云深草堂","author":"钱廉","text":"何事劳劳苦问津，能安此日是高人。\n短屏题遍江枫句，小阁呼回好鸟春。\n率尔到村披素鞸，便为把臂入林身。\n今朝我亦渔郎矣，岂必桃源是避秦。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9348,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"雪中旅怀","author":"钱廉","text":"飞花点点落轻裾，一树寒梅伴影孤。\n夜与老僧依佛火，午随清磬入山厨。\n乡关迢递思黄犬，须发摧颓感白驹。\n自分不材甘世弃，蒲轮曾诏汉家儒。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9349,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋日游岘山","author":"魏晰嗣","text":"岘山突兀凌群峰，直上疑与风云通。\n相将共寻曲径去，屐齿踏破苍苔封。\n天高正值秋深候，霅溪练影摇晴昼。\n隔浦时闻断雁哀，傍崖忽见惊猿骤。\n洼尊亭迥长自间，踌躇四顾围烟鬟。\n我来此际空好事，犹幸二客同跻攀。\n木叶飞残声策策，参差只剩霜枫赤。\n欲转疏林叩上方，晚烟微茫日西匿。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9350,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"汉皋咏古 其一","author":"魏晰嗣","text":"沧浪东注水滔滔，雄郡何年启汉皋。\n秋兴亭孤衔岭月，春风楼迥瞰江涛。\n烟波长使怀乡切，云雨空令入梦劳。\n此日纷纭看世态，忘机深忆丈人高。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9351,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"汉皋咏古 其二","author":"魏晰嗣","text":"郢中自古号名州，地压襄河拥上游。\n月冷乌啼梅福宅，春深花发仲宣楼。\n一时绝调谁能继，千载雄风尚可求。\n莫怨显陵松柏暮，钟山零落更堪愁。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9352,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"塞下曲","author":"陈谋道","text":"征人三十万，一夕度龙沙。\n北望天山迥，南临斗柄斜。\n雕弓含月影，宝剑拂霜华。\n会见烽烟静，铙歌入汉家。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9353,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"幽兰禅院柬西莲禅师","author":"陈谋道","text":"连云高阁郁峥嵘，俯接澄潭百尺盈。\n竹映帘前分晓色，泉流石畔起秋声。\n初闻仙梵空堂细，却听疏钟下界清。\n为爱当年飞锡地，中宵长对月华明。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9354,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登南屏","author":"陈谋道","text":"携屐南屏四望宽，凌空高阁俯清湍。\n风生古渡千帆急，雨湿秋林万壑寒。\n碧海波涛当槛出，沧江烟雾隔城看。\n百盘树杪飞流挂，有客登临兴未阑。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9355,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"田家杂诗 其一","author":"曹鉴仁","text":"谚云四月天，阴晴最难作。\n蚕桑及豆麦，其性有好恶。\n濒海无桑麻，豆麦乃本务。\n收之须及时，莫为阴晴误。\n晨出硕中田，抱归日已暮。\n广场恣堆积，不妨越宿露。\n掼床与连耞，筛把诸农具。\n家人分执事，留精粗使去。\n所防风扬沙，更畏雨成澍。\n金气未坚甲，生芽一似怒。\n水壮陵土母，为食致泄吐。\n勤惰争一刻，此苦欲何诉。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9356,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"田家杂诗 其二","author":"曹鉴仁","text":"八月露华白，早禾渐可登。\n晚稻亦欲秀，寒暖贵相应。\n气热浆易涸，过冷浆难凝。\n不凝实乃细，涸则秕相仍。\n两者禾之病，其耗匪斗升。\n更虑暴风雨，阻势恣凭陵。\n花开不得缩，谷脱如骞崩。\n安得日和煦，颖栗垂青塍。\n风雨符五十，万宝效其能。\n坐候腰镰出，负任如勿胜。\n比屋黄庐满，劳苦安足矜。\n农富恒有余，农贫恒不足。\n七八月之间，青黄不相续。\n屈指望秋分，新禾未尽熟。\n捋摔向清晨，妇子趁日暴。\n气湿安即坚，微火逼其族。\n舂之及簸之，为饭仅得粥。\n所以忍食者，聊以救枵腹。\n吁嗟光宗好，粒粒满车簏。\n非时急取之，十不存五六。\n穷黎无奈何，食之恨不速。\n自怜一年劳，且免儿女哭。\n人言田家乐，我言田家苦。\n苦乐本无定，材力有良窳。\n赢者得其三，绌者失其五。\n此外正平等，仅足持门户。\n嗟彼贫穷者，日日食如伛。\n操券领工本，一釜归一庾。\n经年犬马劳，不足偿田主。\n肉去创益痛，此苦不胜数。\n借债种荒田，老死安能补。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9357,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"边词 其一","author":"曹鉴微","text":"春入中原花满枝，边庭春尽柳无丝。\n交河三月方开冻，流到家乡恐亦迟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9358,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"边词 其二","author":"曹鉴微","text":"黄云万里雁横秋，紫塞千山拥戍楼。\n碛里月明人尽望，笛声吹彻古凉州。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9359,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"月夜书怀","author":"任鹏","text":"月色如湖水，幽光冷竹床。\n怀人双泪湿，作客五更长。\n烛影摇空壁，砧声碎晓霜。\n不须怨飘泊，今夕始他乡。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9360,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"师次辰阳道中","author":"任鹏","text":"春涨初添后，溪流溅杜蘅。\n盘山怜马力，占雨辨禽声。\n万里伏波地，三军挟纩情。\n桃源去渐远，回首暮烟平。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9361,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"登金城山","author":"许国焕","text":"古木长云里，盘回出几重。\n夕阳连众壑，空翠滴诸峰。\n石倚苍藤立，泉从碧藓封。\n谁携惊世句，天阙问春容。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9362,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"行溪上偶至野人家","author":"许国焕","text":"春风随坦步，晓日绿溪边。\n藻动鱼冲岸，山明鸟破烟。\n贫家稀馈问，野老忽周旋。\n已觉和光里，迟迟近午天。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9363,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"南楼怀古","author":"许国焕","text":"城郭遥临北斗悬，苍凉长慨暮云天。\n只今老竖樵薪日，正想从官引仗年。\n亡国社存秋色外，《登楼》赋就夕阳前。\n金舆石马赓陈迹，满目悲风散紫烟。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9364,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"白云洞","author":"李尝之","text":"古洞悬岩上，烟萝十里阴。\n迷云无鸟度，绝壑有龙吟。\n津阻南阳问，台经许令寻。\n此中亲旧绝，书信久浮沈。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9365,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"楼山道中","author":"杨谊远","text":"浩叹终何极，悲歌未得休。\n长星欺短剑，暮雨送清秋。\n寥远残村落，欹斜古戍楼。\n生涯迷定在，应共野云浮。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9366,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"题王中孚写意","author":"彭印古","text":"千峰秋色寒，冷翠生枯树。\n疏林挂夕阳，黄叶吹满路。\n悠然多古意，我欲此中住。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9367,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"夜泊","author":"彭印古","text":"云散雨初晴，渔镫数点明。\n远钟敲旅梦，落叶带秋声。\n幔卷星皆动，波恬月不惊。\n有怀空击楫，感慨壮心生。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9368,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋兴 其一","author":"彭印古","text":"林密秋阴远，寒风落井梧。\n烽烟四望起，天地一身孤。\n白石牛堪饭，黄金骏不图。\n长歌归去晚，明月待人沽。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9369,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"秋兴 其二","author":"彭印古","text":"将晚多秋色，枫林醉叶丹。\n天随云变幻，人共月孤寒。\n笔砚生涯拙，诗书气味酸。\n愁怀无可遣，独把剑来看。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9370,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}},{"title":"晚归松溪","author":"彭印古","text":"隔桥松影淡，冷翠点云根。\n树色飞岚气，山容带雨痕。\n雾深多失路，叶落不藏村。\n迢递归来晚，刚同月到门。","collection":"清","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"清_1.csv","pointer":9371,"sha256":"5fb98e6c1f019fdac176e7c42c73bfc5154cf881dab9da8d2e50ad0603fbca1d","dynasty":"清"}}]